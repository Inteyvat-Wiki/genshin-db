			"dialogs": [
				{
					"id": 741430501,
					"content": "莉諾爾！莉諾爾！妳沒事吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430502
					],
					"speakerTitle": "恩肖"
				},
				{
					"id": 741430502,
					"content": "外公！我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430503
					],
					"speakerTitle": "莉諾爾"
				},
				{
					"id": 741430503,
					"content": "啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741430504,
					"content": "#啊啊，太好了…謝謝{F#妳}{M#你}們，{NICKNAME}、派蒙，多虧有{F#妳}{M#你}們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430505,
						741430506
					],
					"speakerTitle": "恩肖"
				},
				{
					"id": 741430505,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741430507
					]
				},
				{
					"id": 741430507,
					"content": "但是…不過，其實剛剛是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741430508,
					"content": "派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741430509
					]
				},
				{
					"id": 741430509,
					"content": "…嗯，但是…唔…我知道了啦！哎呀——還好莉諾爾沒事，真是太好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430510
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741430510,
					"content": "#…謝謝外公。還有謝謝{NICKNAME}{M#哥哥}{F#姐姐}和派蒙姐姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430511
					],
					"speakerTitle": "莉諾爾"
				},
				{
					"id": 741430511,
					"content": "以後不要再這樣亂跑了！哎喲，擔心死我了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430512
					],
					"speakerTitle": "恩肖"
				},
				{
					"id": 741430512,
					"content": "真不好意思、真不好意思，還勞煩您特地跟我跑一趟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430513
					],
					"speakerTitle": "恩肖"
				},
				{
					"id": 741430513,
					"content": "應該的應該的，您客氣了，孩子沒事就好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430514
					],
					"speakerTitle": "夏琳"
				},
				{
					"id": 741430514,
					"content": "（莉諾爾，妳還好嗎…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430515
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741430515,
					"content": "#（我明白了，卡特哥哥說的那些話，還有{NICKNAME}{M#哥哥}{F#姐姐}對外公什麼也不說是什麼意思。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430516
					],
					"speakerTitle": "莉諾爾"
				},
				{
					"id": 741430516,
					"content": "（所以…所以我也不會跟外公說，不會讓外公擔心。因為我是個乖孩子。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430517
					],
					"speakerTitle": "莉諾爾"
				},
				{
					"id": 741430517,
					"content": "（莉諾爾很聰明呢！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430518
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741430518,
					"content": "（……）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430519
					],
					"speakerTitle": "莉諾爾"
				},
				{
					"id": 741430519,
					"content": "（不是的，我一點也不聰明。我不知道卡特哥哥最後說的話是什麼意思，也不知道為什麼卡特哥哥要謝謝我…明明一直都是他在幫我。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430520
					],
					"speakerTitle": "莉諾爾"
				},
				{
					"id": 741430520,
					"content": "（等我長大一點，我就要去找卡特哥哥問清楚。到時候，我要跟他說好多好多話，還要給他吃蛋糕！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430521
					],
					"speakerTitle": "莉諾爾"
				},
				{
					"id": 741430521,
					"content": "#（{NICKNAME}{M#哥哥}{F#姐姐}、派蒙姐姐，等我長大了，我們一起去找卡特哥哥好嗎？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430522,
						741430523
					],
					"speakerTitle": "莉諾爾"
				},
				{
					"id": 741430522,
					"content": "等妳長大再說吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741430524
					]
				},
				{
					"id": 741430524,
					"content": "嗯，那就說定了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430525
					],
					"speakerTitle": "莉諾爾"
				},
				{
					"id": 741430525,
					"content": "他們離開了。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 741430523,
					"content": "好…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741430524
					]
				},
				{
					"id": 741430506,
					"content": "不用謝我們。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741430507
					]
				}
			]
		}
	]
}