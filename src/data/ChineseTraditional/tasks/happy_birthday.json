					},
					{
						"sceneId": 3,
						"position": [
							4211.379,
							517.961,
							4863
						],
						"pointId": 6522
					},
					{
						"sceneId": 3,
						"position": [
							4210.927,
							518.389,
							4864.287
						],
						"pointId": 6841
					}
				]
			},
			"dialogs": [
				{
					"id": 741430401,
					"content": "#是{F#妳}{M#你}們啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430402
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741430402,
					"content": "什麼嘛！原來是卡特皮拉啊！真是的，害我擔心死了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741430403,
					"content": "#哇！是{NICKNAME}{M#哥哥}{F#姐姐}還有派蒙姐姐！今天好開心，我最喜歡的人都來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430404
					],
					"speakerTitle": "莉諾爾"
				},
				{
					"id": 741430404,
					"content": "外公還幫我做了又大又甜的「生日蛋糕」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430405
					],
					"speakerTitle": "莉諾爾"
				},
				{
					"id": 741430405,
					"content": "哦哦！今天是莉諾爾的生日呀！生日快樂！那個…蛋糕還有嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741430406,
					"content": "嗯——我們已經吃完了耶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430407
					],
					"speakerTitle": "莉諾爾"
				},
				{
					"id": 741430407,
					"content": "什麼嘛，小氣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741430408,
					"content": "卡特皮拉…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741430409
					]
				},
				{
					"id": 741430409,
					"content": "你還好嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741430410
					]
				},
				{
					"id": 741430410,
					"content": "不用擔心我。今天是開心的日子，掃興的話就不必聊了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430411
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741430411,
					"content": "#無論如何，謝了，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430412
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741430412,
					"content": "你們在說什麼呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741430413,
					"content": "哈哈，沒什麼。只是覺得「小朋友隊」的夥伴們上次聚在一起…已經是很久，很久以前的事情了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430414
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741430414,
					"content": "不過，卡特哥哥為什麼要把我帶到這裡來啊？好奇怪哦！而且恩肖爺爺看到卡特哥哥也很害怕，連勇士、王子和公主都很害怕！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430415
					],
					"speakerTitle": "莉諾爾"
				},
				{
					"id": 741430415,
					"content": "明明每次外公聽我說卡特哥哥的事情，他都說一定要請卡特哥哥到家裡來做客。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430416
					],
					"speakerTitle": "莉諾爾"
				},
				{
					"id": 741430416,
					"content": "唔…畢竟卡特皮拉的樣子…卡特皮拉，你為什麼不願意像之前那樣變成人的樣子呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430417
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741430417,
					"content": "不是不願意，只是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430418
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741430418,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430419
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741430419,
					"content": "卡特哥哥這樣也很好！剛剛我坐在卡特哥哥的肩膀上，一下就摘到了泡泡桔，卡特哥哥跑得和風一樣快，好厲害！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430420
					],
					"speakerTitle": "莉諾爾"
				},
				{
					"id": 741430420,
					"content": "莉諾爾，妳一定要記得——如果妳見到了長得像我的「人」，絕對不要靠近，要趕快跑開。這樣的人，都是很危險的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430421
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741430421,
					"content": "真的嗎？但是…卡特哥哥一點也不壞呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430422
					],
					"speakerTitle": "莉諾爾"
				},
				{
					"id": 741430422,
					"content": "莉諾爾，答應我，向我保證。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430423
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741430423,
					"content": "原本以為卡特皮拉要用他的「小把戲」，向莉諾爾施加影響。\\n但他始終沒有這麼做，只是嚴肅地等待著莉諾爾的回應。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741430424
					]
				},
				{
					"id": 741430424,
					"content": "不過…嗯，好吧！我答應你，卡特哥哥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430425
					],
					"speakerTitle": "莉諾爾"
				},
				{
					"id": 741430425,
					"content": "但是…但是這樣的話，以後我要怎樣才能認出卡特哥哥啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430426
					],
					"speakerTitle": "莉諾爾"
				},
				{
					"id": 741430426,
					"content": "對了！卡特哥哥，我離開梅洛彼得堡以後才知道，原來外面有這麼大！我每天都往不同的方向走，但到現在還沒有見到牆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430427
					],
					"speakerTitle": "莉諾爾"
				},
				{
					"id": 741430427,
					"content": "有太陽的時候很熱，晚上沒有太陽很涼。對了！到了晚上還會有風吹向湖邊，涼颼颼的！和風扇不一樣，這是為什麼啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430428
					],
					"speakerTitle": "莉諾爾"
				},
				{
					"id": 741430428,
					"content": "還有，勇士趴在我和外公旁邊的時候，眼睛經常會往上看著我們。王子睡覺的時候，有時候後腿會踢東西，超好玩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430429
					],
					"speakerTitle": "莉諾爾"
				},
				{
					"id": 741430429,
					"content": "然後…然後我發現不穿鞋子在草地上走的時候，小草會伸到腳趾之間，感覺有點刺痛。看書上寫的，我還以為小草很柔軟呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430430
					],
					"speakerTitle": "莉諾爾"
				},
				{
					"id": 741430430,
					"content": "還有啊！艾蒂安叔叔送給我的花，原來外面有那麼多，而且這些花原來還有根，會牢牢伸進土地裡——這又是為什麼啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430431
					],
					"speakerTitle": "莉諾爾"
				},
				{
					"id": 741430431,
					"content": "這個世界真的好大、好奇怪，又有好多好多不同的顏色的光。我有好多好多的事情想說給卡特哥哥聽，想要卡特哥哥說給我聽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430432
					],
					"speakerTitle": "莉諾爾"
				},
				{
					"id": 741430432,
					"content": "但是我要怎麼找到卡特哥哥呢？就像是魔法師的學徒，他一直、一直想要找到小魚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430433
					],
					"speakerTitle": "莉諾爾"
				},
				{
					"id": 741430433,
					"content": "妳還記得那個故事啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430434
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741430434,
					"content": "我當然不會忘記！我一直在等卡特哥哥回來把這個故事講完，所以最後學徒找到小魚了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430435
					],
					"speakerTitle": "莉諾爾"
				},
				{
					"id": 741430435,
					"content": "這個嘛…在很久很久以後…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430436
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741430436,
					"content": "愚笨的魔法師學徒鼓起勇氣辭別了大魔法師之後，離開了工坊踏上尋找小魚的旅途。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430437
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741430437,
					"content": "可是他從未見過廣袤的大海，自然也不瞭解小魚所說的故鄉是怎樣的地方。於是他只好一路詢問…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430438
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741430438,
					"content": "他問河邊的蘆葦，蘆葦聽了他的故事，笑得彎了腰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430439
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741430439,
					"content": "蘆葦說：「你要找的是大海，是比河流寬廣百倍、千倍的地方，是河流奔向的地方。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430440
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741430440,
					"content": "他追著河水奔流的方向找到了大海，可是大海茫茫，而他卻毫無方向。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430441
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741430441,
					"content": "於是他問在碼頭稍作休息的紫金漁鷗。紫金漁鷗聽了他的故事，吃驚得把嘴大張，原本銜著的薯條也掉在地上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430442
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741430442,
					"content": "「老兄，這是不可能的事。」漁鷗說：「在大海裡找一尾普通的小魚…從來沒有人做過這樣的事。再說了，牠說不定早就…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430443
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741430443,
					"content": "魔法師學徒用麵包堵住了漁鷗的嘴，不再理會牠和牠聒噪的同伴，繼續沿著海岸線邊問邊找。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430444
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741430444,
					"content": "因為他是愚笨的學徒，只懂得用最愚笨的辦法搜尋。他花了很多時間學會潛水，一次又一次地游向大海更遠、更深的地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430445
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741430445,
					"content": "我猜他最後一定找到了！只要願望夠強烈，而且不放棄努力的話，就一定可以實現心願！外公就是這樣告訴我的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430446
					],
					"speakerTitle": "莉諾爾"
				},
				{
					"id": 741430446,
					"content": "妳喜歡的是有好結局的故事…好吧，恩肖爺爺說得對，學徒雖然愚笨，但最終還是靠著最愚笨的辦法找到了那尾小魚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430447
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741430447,
					"content": "找到牠時，牠和牠的親族一同在水中暢游，魚群自如地變換著形狀。但學徒從許許多多的魚兒之中，一眼就認出了牠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430448
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741430448,
					"content": "「終於找到你了…」學徒實現了心願，心情卻並沒有想像中心願實現時該有的那般雀躍，反倒有些不知所措。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430449
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741430449,
					"content": "魚群好奇地將他圍住，催促他講述事情的前因後果。他笨拙地解釋了此前發生的一切，最後如釋重負般地在水中吐出一長串氣泡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430450
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741430450,
					"content": "學徒說：「我需要道歉兩次，一次是為了過去你向我求助時我沒能擠出些許的勇氣，一次則是為了現在的唐突到訪…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430451
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741430451,
					"content": "「終於又見到你之後，我才意識到我是一個多麼自私的人…我只想著如果能夠當面向你道歉，我就能原諒過去的自己。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430452
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741430452,
					"content": "「這有什麼關係呢？」小魚的回答出乎學徒的預料。「你看，過去你沒能幫上我，但現在我也回到了家鄉，回到了親人的身邊。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430453
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741430453,
					"content": "「我沒有因此受到傷害，所以你也不必祈求誰的原諒。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430454
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741430454,
					"content": "「為了這點小事花費這麼多時間和精力，真不知道該說你耿直還是愚笨才好。但就算是愚笨，我們也不介意和愚笨的人類做朋友…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430455
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741430455,
					"content": "哇！這麼說，他們最後總算成為朋友了嗎？那在這之後的故事呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430456
					],
					"speakerTitle": "莉諾爾"
				},
				{
					"id": 741430456,
					"content": "後面的故事？他們啊，成了最最要好的朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430457
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741430457,
					"content": "咦？沒了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430458
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741430458,
					"content": "所以故事就這樣結束了嗎？卡特哥哥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430459
					],
					"speakerTitle": "莉諾爾"
				},
				{
					"id": 741430459,
					"content": "嗯，我的故事已經結束了。如果到了適合的地方故事還不結束，那就太不識趣了。英雄會變成惡龍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430460
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741430460,
					"content": "我也曾經聽過那種遲遲不願意結束的故事，最後收場會很難看。故事裡的人都很傷心，是個壞故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430461
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741430461,
					"content": "但是親愛的莉諾爾，妳的名為「人生」的冒險故事還在繼續。生日快樂，有朝一日妳要把妳的故事說給我聽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430462
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741430462,
					"content": "嗯，嗯…我答應你，卡特哥哥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430463
					],
					"speakerTitle": "莉諾爾"
				},
				{
					"id": 741430463,
					"content": "我一定會找到你，然後跟你講好多好多故事！然後我還要做又大又甜的生日蛋糕給你吃！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430464
					],
					"speakerTitle": "莉諾爾"
				},
				{
					"id": 741430464,
					"content": "哈哈哈，生日蛋糕就不用了，我都不知道自己的生日呢！我只知道自己醒來的日子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430465
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741430465,
					"content": "…謝謝妳，莉諾爾。正因為——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡特皮拉"
				}
			]
		},
