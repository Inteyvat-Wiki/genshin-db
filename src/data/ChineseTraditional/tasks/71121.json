			},
			"dialogs": [
				{
					"id": 711210201,
					"content": "#萬分感謝！嗨呀，要不是有{F#妳}{M#你}們搭救，我的貨物險些就全完了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711210202
					],
					"speakerTitle": "奇怪的商人"
				},
				{
					"id": 711210202,
					"content": "請別客氣，我身上也沒多少錢，就請收下這些做報酬吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711210203
					],
					"speakerTitle": "奇怪的商人"
				},
				{
					"id": 711210203,
					"content": "哇，你也太客氣啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711210204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711210204,
					"content": "哈哈，我們就此別過，希望下次還有機會相見！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奇怪的商人"
				}
			]
		},
