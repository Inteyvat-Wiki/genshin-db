			},
			"dialogs": [
				{
					"id": 711210301,
					"content": "#大、大俠饒命…欸，是{F#妳}{M#你}們？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711210302
					],
					"speakerTitle": "奇怪的商人"
				},
				{
					"id": 711210302,
					"content": "是你？！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711210303
					]
				},
				{
					"id": 711210303,
					"content": "#嘿嘿，無巧不成書嘛這不是…哈哈，{F#妳}{M#你}們先忙著，我先走了喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711210304
					],
					"speakerTitle": "奇怪的商人"
				},
				{
					"id": 711210304,
					"content": "#我建議{F#妳}{M#你}看看他們留下了什麼寶貝，唔…別擔心我，我把它們都登記備案了…該歸還的東西由我歸還就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711210305
					],
					"speakerTitle": "奇怪的商人"
				},
				{
					"id": 711210305,
					"content": "等等…！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711210306
					]
				},
				{
					"id": 711210306,
					"content": "沒關係，反正之後我們還有機會再見！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奇怪的商人"
				}
			]
