					"nextDialogs": [
						230040907
					],
					"speakerTitle": "古拉布吉爾"
				},
				{
					"id": 230040907,
					"content": "哈哈哈，現在我搭營地的手藝都已經很生疏了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040908
					],
					"speakerTitle": "古拉布吉爾"
				},
				{
					"id": 230040908,
					"content": "之前我佈置好的那些營地，現在大部分也都荒廢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040909
					],
					"speakerTitle": "古拉布吉爾"
				},
				{
					"id": 230040909,
					"content": "如果我現在還待在雨林裡，又會過著什麼樣的生活呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040910
					],
					"speakerTitle": "古拉布吉爾"
				},
				{
					"id": 230040910,
