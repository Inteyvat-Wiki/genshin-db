			"dialogs": [
				{
					"id": 230042201,
					"content": "咦？這些帽子…哈哈哈，是我之前幫小蛇們做的帽子啊。我怎麼把它們也丟下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042202
					],
					"speakerTitle": "古拉布吉爾"
				},
				{
					"id": 230042202,
					"content": "之前為了讓一些孩子們來看，我就幫牠們每條蛇都做了一頂睡帽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042203
					],
					"speakerTitle": "古拉布吉爾"
				},
				{
					"id": 230042203,
					"content": "阿耶的是紅色的，阿夢的是綠色的，小加的是黃色的，阿德的是藍色的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042204
					],
					"speakerTitle": "古拉布吉爾"
				},
				{
					"id": 230042204,
					"content": "聽起來就很可愛，演出效果一定不錯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230042205,
					"content": "最開始是不錯，但只要小蛇們張開嘴，孩子們一定會哇哇大哭…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042206
					],
					"speakerTitle": "古拉布吉爾"
				},
				{
					"id": 230042206,
					"content": "唉，不說這些了，請收下這些報酬吧，也算是我的一點心意。",
