				]
			},
			"dialogs": [
				{
					"id": 746730101,
					"content": "小傢伙，我真的不會潛水，你看，我連潛水服都沒有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730102
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 746730102,
					"content": "哎喲…就算你這樣跳來跳去，我也沒辦法和你一起下去啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730103,
						746730104
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 746730103,
					"content": "烏爾曼！你也來楓丹了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746730105
					]
				},
				{
					"id": 746730105,
					"content": "#{NICKNAME}，還有派蒙！居然可以在這遇見{F#妳}{M#你}們，真是太巧了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730106
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 746730106,
					"content": "你還是和之前一樣，好受仙靈歡迎喔！而且…和仙靈交流得越來越熟練了呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746730107,
					"content": "幫我翻譯一下仙靈在說什麼。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746730108
					]
				},
				{
					"id": 746730108,
					"content": "#唉…{F#妳}{M#你}們不要笑我了，我怎麼會懂它想說什麼啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730109
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 746730109,
					"content": "我就只是來楓丹做生意，然後來水邊閒逛，突然又被一個小仙靈纏上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730110
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 746730110,
					"content": "我早就習慣這種事了，所以就跟著它走，跟著它翻過山、越過嶺，還划了一下船。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730111
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 746730111,
					"content": "一般來說，它馬上就會跳來跳去，告訴我這裡埋了什麼東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730112
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 746730112,
					"content": "但是…它一頭游進了水裡，越游越深…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730113
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 746730113,
					"content": "我不會潛水啊！而且我聽人家說，水裡不僅有洋流，還有各種危險的東西…我只好待在船上等它回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730114
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 746730114,
					"content": "但是那個小傢伙還是鍥而不捨地要帶我去各種地方…真希望它可以知道我真的不會潛水…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730115,
						746730117
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 746730115,
					"content": "感受到楓丹的特色了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746730116
					]
				},
				{
					"id": 746730116,
					"content": "完全感受到了。真是一個友好、熱情、善良，讓人流連忘返的國度啊…哈、哈、哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730119
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 746730119,
					"content": "那這樣說，你鐵定又要拜託我們出馬了，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746730120,
					"content": "#沒錯！謝天謝地，{F#妳}{M#你}們沒有被這幫楓丹人影響太深，說話還是這麼乾淨俐落。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730121
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 746730121,
					"content": "我真是受不了某些親愛的楓丹人說話時的那個風格了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730122
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 746730122,
					"content": "平均每二十個詞裡有兩個敬稱、三個比喻、六個形容詞…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730123,
						746730124
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 746730123,
					"content": "我一向是個俐落的人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746730125
					]
				},
				{
					"id": 746730125,
					"content": "見鬼…我覺得自己也被影響了…來！拿著這本筆記，我把那個小傢伙帶我去的地方都標好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730126
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 746730126,
					"content": "還是和之前一樣，找到古鐵錢的話，就拿回來給我，我高價收購。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730127
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 746730127,
					"content": "#祝我們合作愉快，{NICKNAME}，還有派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 746730124,
					"content": "我在修辭上的造詣的確不深。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746730125
					]
				},
				{
					"id": 746730117,
					"content": "我還以為你早就習慣遇到魔物了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746730118
					]
				},
				{
					"id": 746730118,
					"content": "我的確習慣了，只是在陸地上遇見魔物的話，我可以轉身就跑，但在水下遇見魔物…我根本游不動啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730119
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 746730104,
					"content": "你的「仙靈緣」還是很好呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746730105
					]
				}
			]
		}
	]
}