					"朝倉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220290201,
					"content": "您剛才是留手了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290202
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220290202,
					"content": "不用顧忌我的面子，閣下，請使出全力吧，我…必須要變強才行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "朝倉"
				}
			]
		},
		{
			"id": 2202903,
			"completionStepIds": [
				2202903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
