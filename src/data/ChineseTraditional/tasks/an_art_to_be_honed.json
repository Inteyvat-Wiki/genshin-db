	"talks": [
		{
			"id": 2202901,
			"completionStepIds": [
				2202901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
