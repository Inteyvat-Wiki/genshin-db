			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"朝倉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220290301,
					"content": "呼…呼…閣下的武藝，果然高強…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290302
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220290302,
					"content": "在下…在下領教了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290303,
						220290304
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220290303,
					"content": "你…你沒事吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290305
					]
				},
				{
					"id": 220290305,
					"content": "沒…沒事，只是需要調整一下氣息…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290306
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220290306,
					"content": "但您強大到這種程度，就算是您說您打倒過巨龍我也信…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290307
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220290307,
					"content": "其實我真的打倒過巨龍…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290308
					]
				},
				{
					"id": 220290308,
					"content": "哈哈哈…在下當然是相信的。謝謝您和我對練，這場比試，在下銘記在心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290309
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220290309,
					"content": "如果閣下願意的話，請以後常來和我對練，有您這樣的強者磨礪…我一定能完成那件事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290310
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220290310,
					"content": "那件事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290311
					]
				},
				{
					"id": 220290311,
					"content": "咳…只是我的一點小心願而已，這次謝謝您了，這些報酬請收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290312
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220290312,
					"content": "我還要回去休息一下，您…您的那些招數，力道可真是太足了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220290304,
					"content": "抱歉、剛才沒收住力…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290305
					]
				}
			]
		},
