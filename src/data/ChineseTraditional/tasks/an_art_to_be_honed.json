			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"朝倉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220290101,
					"content": "我一定！我一定要…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290102
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220290102,
					"content": "#嗯？{F#妳}{M#你}是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290103
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220290103,
					"content": "我接到了你的委託。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290104
					]
				},
				{
					"id": 220290104,
					"content": "#噢，{F#妳}{M#你}說那個陪練委託啊，沒錯，是我發佈的，我想找個人來和我對練武藝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290105
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220290105,
					"content": "#{F#妳}{M#你}把我的委託給接下了嗎？但我之前好像沒有在城裡見過{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290106
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220290106,
					"content": "#抱歉，我不是質疑{F#妳}{M#你}的實力。但我確實不知道{F#妳}{M#你}的武藝如何…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290107,
						220290109
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220290107,
					"content": "我擊倒過巨龍。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290108
					]
				},
				{
					"id": 220290108,
					"content": "哈哈哈…真的嗎？其實我更好奇你是在哪裡找到巨龍的，我也只是聽說過而已…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290112
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220290112,
					"content": "我還是很能打的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290113
					]
				},
				{
					"id": 220290113,
					"content": "哈哈，無論如何，武藝這種事情都是口說無憑，我們還是手上見真章吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290114,
						220290115
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220290114,
					"content": "正有此意。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220290115,
					"content": "等等，為什麼要匿名發佈委託？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290116
					]
				},
				{
					"id": 220290116,
					"content": "這、這其實是因為一個不那麼…不那麼光彩的原因…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290117
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220290117,
					"content": "#咳，不過既然{F#妳}{M#你}接下了委託，我就直說了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290118
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220290118,
					"content": "就在前段時間，我和幾位同心外出執行任務，回程的時候，突然發現了一隊準備襲掠商隊的海亂鬼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290119
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220290119,
					"content": "我和其餘幾位同心馬上趕過去救援那支商隊。起初，我們略占上風，他們也很快退去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290120
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220290120,
					"content": "但是，就在我們剛準備喘口氣的時候，從旁邊突然又出現了一支海亂鬼，還有一個頭領模樣的人在率領著他們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290121
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220290121,
					"content": "我和其餘同僚還沒反應過來，就被他們打了個措手不及…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290122
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220290122,
					"content": "我們沒有勝算，只能一邊抵擋著海亂鬼的攻勢，一邊護著商人往城裡撤退。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290123
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220290123,
					"content": "而我在和那個海亂鬼頭領交手的時候…居然被他奪走了武器。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290124
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220290124,
					"content": "而且那傢伙在奪走我武器之後，還舉著我的武器，朝我哈哈大笑，真是奇恥大辱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290125
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220290125,
					"content": "那隊商人怎麼樣了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290126
					]
				},
				{
					"id": 220290126,
					"content": "在我們往後撤退的時候，又遇見了出門巡邏的其他同心，那些海亂鬼看見了之後，也全都撤退了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290127
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220290127,
					"content": "那些商人也被我們護送進了城，但他們的貨物都…唉，都怪我武藝不精…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290128
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220290128,
					"content": "回去之後，我雖然拿到了新配發的武器。但我還是沒法對這件事釋懷…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290129
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220290129,
					"content": "所以我才發了那道委託。想要以此來磨礪武藝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290130
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220290130,
					"content": "直到我足夠強大，再去親手打倒那個海亂鬼，拿回我的武器，徹底洗刷這道恥辱！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220290109,
					"content": "我見證過神殞。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290110
					]
				},
				{
					"id": 220290110,
					"content": "#欸，{F#妳}{M#你}看{F#妳}{M#你}說的，{F#妳}{M#你}一定是在璃月那邊參與過「請仙典儀」吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290111
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220290111,
					"content": "哈哈哈，照你這麼說，璃月那邊有很多人都「見證過神殞」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290112
					],
					"speakerTitle": "朝倉"
				}
			]
		},
		{
			"id": 2202902,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
