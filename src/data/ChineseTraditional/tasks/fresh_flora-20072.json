			"dialogs": [
				{
					"id": 200720101,
					"content": "之前存在雪山上的花怎麼樣啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720102
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 200720102,
					"content": "只拿到一份…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200720103
					]
				},
				{
					"id": 200720103,
					"content": "其他的花是沒能取回來嗎？唔…好吧，畢竟雪山裡的情況，確實很難預料呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720104
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 200720104,
					"content": "但只有這一份的話，就沒法對比著看了，只能以後再找機會看看了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720105
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 200720105,
					"content": "#這次辛苦{F#妳}{M#你}幫忙，這是準備給{F#妳}{M#你}的報酬哦，以後說不定還要麻煩{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芙蘿拉"
				}
			]
		},
