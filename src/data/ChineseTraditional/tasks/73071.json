	"talks": [
		{
			"id": 7307101,
			"completionStepIds": [
				7307101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7307101",
							"2"
						],
						"stepId": 7307101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"法莎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730710101,
					"content": "奇怪，怎麼會有小孩子在這種地方？妳一個人在這裡做什麼呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730710102,
					"content": "咿！怪人，還有會飛的小怪人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710103
					],
					"speakerTitle": "法莎"
				},
				{
					"id": 730710103,
					"content": "好沒禮貌！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730710104,
					"content": "對呀，我就是這麼沒教養，誰叫我連能教我禮節的父母都沒有呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710105
					],
					"speakerTitle": "法莎"
				},
				{
					"id": 730710105,
					"content": "（看來有故事…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710106
					]
				},
				{
					"id": 730710106,
					"content": "唔…該怎麼說呢…總之，我們不是怪人啦，也不是壞人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710107,
						730710109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730710107,
					"content": "只是熱心的旅行者。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710108
					]
				},
				{
					"id": 730710108,
					"content": "沒錯，所以不能對遇到困難的人置之不理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730710111,
					"content": "#對了，我是派蒙，這傢伙是{NICKNAME}，可以問一下妳的名字嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730710112,
					"content": "…我是法莎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710113
					],
					"speakerTitle": "法莎"
				},
				{
					"id": 730710113,
					"content": "那，法莎小妹妹怎麼一個人在這種地方？如果是迷路了，我們可以送妳回去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730710114,
					"content": "過去的事情就讓它過去吧，我已經決定了，不再糾結過去，要向前看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710115
					],
					"speakerTitle": "法莎"
				},
				{
					"id": 730710115,
					"content": "喔？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730710116,
					"content": "不要再依靠大人的力量，我要靠自己…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710117
					],
					"speakerTitle": "法莎"
				},
				{
					"id": 730710117,
					"content": "明明是個小孩子，為什麼會說這麼老成的話…而且，森林裡也有很多危險，有些危險可不是像妳這樣的小孩子能應付得來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730710118,
					"content": "雖然之前差點被壞人帶走…但是沒關係，有了之前的教訓，現在我更加小心了，會小心避開危險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710119
					],
					"speakerTitle": "法莎"
				},
				{
					"id": 730710119,
					"content": "那個人，以前見過，是維摩莊的大哥哥。表面親切的樣子…原來和過去遇到的大人也沒什麼分別…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710120
					],
					"speakerTitle": "法莎"
				},
				{
					"id": 730710120,
					"content": "差點被壞人帶走？！妳這不是完全沒吸取教訓嗎！等等，法莎上次是怎麼脫身的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730710121,
					"content": "是動作很快的小東西把我帶到這裡。在化城郭從來沒見過這樣的生物，我想那應該是森林的精靈吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710122
					],
					"speakerTitle": "法莎"
				},
				{
					"id": 730710122,
					"content": "（說的應該是蘭那羅吧。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710123
					]
				},
				{
					"id": 730710123,
					"content": "（不過，維摩莊的大哥哥，該不會是…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730710124,
					"content": "不管怎麼說，小孩子一個人在森林還是太不安全了，可能會遇到各種各樣的情況，像是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730710125,
					"content": "遭遇危險的蕈獸。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710126
					]
				},
				{
					"id": 730710126,
					"content": "對呀對呀，還可能碰到壞人，比如那菈無留陀…啊，不對，唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730710127,
					"content": "就像想要拐走妳的壞人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710128
					]
				},
				{
					"id": 730710128,
					"content": "#{NICKNAME}說得對！而且…而且還可能會餓肚子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730710129,
					"content": "森林裡到處都是自然的饋贈，怎麼可能會餓肚子。星蕈…還有甜甜花和薄荷，到處都是，我的胃口很小，吃一點就飽啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710130
					],
					"speakerTitle": "法莎"
				},
				{
					"id": 730710130,
					"content": "而且我以前就很擅長照顧花草，找一塊安全的地方，種上甜甜花或者薄荷什麼的，餵飽自己根本不是問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710131
					],
					"speakerTitle": "法莎"
				},
				{
					"id": 730710131,
					"content": "不過，如果有長滿甜甜花的苗圃…那可真是和樂園一樣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710132
					],
					"speakerTitle": "法莎"
				},
				{
					"id": 730710132,
					"content": "呃…這孩子怎麼會這麼異想天開…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730710133,
					"content": "#反正我現在過得比在化城郭時開心多啦，也不會挨打…我知道{F#妳}{M#你}們是為我好，但是現在，不要管我才是對我最好的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710134
					],
					"speakerTitle": "法莎"
				},
				{
					"id": 730710134,
					"content": "唔…雖然不知道她到底經歷了什麼，但是看來很難說服她回化城郭了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730710135,
					"content": "這附近倒也沒那麼危險…之後如果有機會回來的話再來看看她吧，說不定到那時她就改變心意了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730710109,
					"content": "#在找失散的{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTER]}…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710110
					]
				},
				{
					"id": 730710110,
					"content": "嗯，所以看到妳這樣落單的小女孩，就會很擔心啦。想到妳可能需要幫助，絕不能置之不理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710111
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7307102,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7307102",
							"2"
						],
						"stepId": 7307102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"法莎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730710201,
					"content": "只要有甜甜花的種子就能種出更多甜甜花，但是麵包不一樣，吃完了就沒有了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710202
					],
					"speakerTitle": "法莎"
				},
				{
					"id": 730710202,
					"content": "要是麵包能夠掰掉一半又長出一半，那就再也不會有人挨餓啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "法莎"
				}
			]
		},
		{
			"id": 7307103,
			"completionStepIds": [
				7307103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7307103",
							"2"
						],
						"stepId": 7307103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"法莎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730710301,
					"content": "妳好，法莎，妳還在這裡呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730710302,
					"content": "#派蒙，還有{NICKNAME}，{F#妳}{M#你}們好。對呀，我在這裡過得挺好的，沒什麼需要{F#妳}{M#你}們擔心的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710303
					],
					"speakerTitle": "法莎"
				},
				{
					"id": 730710303,
					"content": "沒想到居然真的堅持下來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730710304,
					"content": "#{F#妳}{M#你}們還想勸我回去嗎？我可不會跟你們走…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710305
					],
					"speakerTitle": "法莎"
				},
				{
					"id": 730710305,
					"content": "這個嘛…妳實在不願意，我們當然也不會強迫妳。不過，還記得妳之前說過的「長滿甜甜花的苗圃」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730710306,
					"content": "喔，那個呀，那只是我一廂情願的想法，我也知道，根本不可能有這樣的地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710307
					],
					"speakerTitle": "法莎"
				},
				{
					"id": 730710307,
					"content": "唔…還是跟之前一樣偶爾會表現出和年齡不符的老成呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730710308,
					"content": "不過別管那個了，我們這次來是有好消息要告訴妳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730710309,
					"content": "真的有長滿甜甜花的苗圃。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710310
					]
				},
				{
					"id": 730710310,
					"content": "對！說來妳可能不相信，之前救過妳的「森林的精靈」，他們叫蘭那羅喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730710311,
					"content": "#因為我和{NICKNAME}幫蘭那羅種下了很多毗波耶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730710312,
					"content": "是讓大地重新記起。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710313
					]
				},
				{
					"id": 730710313,
					"content": "對喔，蘭那庫拉說過，因為桓那記得一切，所以只要大地重新記起，苗圃就會生出毗波耶啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730710314,
					"content": "這樣的故事，我以前也聽過很多，只有小孩子才會把故事當真，不過我知道派蒙是好心，所以還是謝謝妳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710315
					],
					"speakerTitle": "法莎"
				},
				{
					"id": 730710315,
					"content": "妳不也是小孩子嗎！等等，不對！我不是在講故事，我說的都是真的啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730710316,
					"content": "嗯嗯，給小孩子講故事的人都會加這麼一句呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710317
					],
					"speakerTitle": "法莎"
				},
				{
					"id": 730710317,
					"content": "說什麼妳都不肯相信的話，那就…那就「眼見為實」！跟我們一起去親眼看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730710318,
					"content": "居然真的為了講故事而準備了這樣的地方嗎？那我倒真的想要去見識一下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710319
					],
					"speakerTitle": "法莎"
				},
				{
					"id": 730710319,
					"content": "唔…都說了我說的都是真的啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730710320,
					"content": "#{NICKNAME}，我們帶法莎去蘭那羅的苗圃吧，只要她親眼見到了，一定就沒話說啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
