				"objectNames": [
					"甜甜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708140301,
					"content": "是，是冒險家嗎？您是來接受委託的嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140302
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 708140302,
					"content": "嗚…您，您稍等一下，我找找，我這裡的委託有…「風之翼競速」、「野外生存體驗嚮導」，還有「自由攀岩教練」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140303
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 708140303,
					"content": "完全不像冒險家協會…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140304
					]
				},
				{
					"id": 708140304,
					"content": "我知道啦！嵐姐也這麼說，可是我看書裡的那些「冒險」不都是這些的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140305
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 708140305,
					"content": "不發佈這些委託，還能發佈什麼啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140306
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 708140306,
					"content": "像是，掃清魔物之類的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140307
					]
				},
				{
					"id": 708140307,
					"content": "那，那也太危險了吧，雖然璃沙郊那邊確實有很多魔物，也對行人很有威脅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140308
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 708140308,
					"content": "但是，一般人肯定沒辦法對付他們的，說不定還會受傷…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140309,
						708140311
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 708140309,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140310
					]
				},
				{
					"id": 708140310,
					"content": "#可以嗎，那…就拜託{F#妳}{M#你}了，我待會回去會和嵐姐商量，給{F#妳}{M#你}一個合適的報酬的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "甜甜"
				},
				{
					"id": 708140311,
					"content": "冒險家可不是一般人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140312
					]
				},
				{
					"id": 708140312,
					"content": "#是這樣嗎…那，那就拜託{F#妳}{M#你}了，我待會回去會和嵐姐商量，給{F#妳}{M#你}一個合適的報酬的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "甜甜"
				}
			]
		},
