			},
			"dialogs": [
				{
					"id": 708140501,
					"content": "#咦？{F#妳}{M#你}已經回來了，委託完成了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140502
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 708140502,
					"content": "已經完成了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140503
					]
				},
				{
					"id": 708140503,
					"content": "#{F#妳}{M#你}可真厲害…我剛才按照那個委託的標準，回去冒險家協會整理了一下委託。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140504
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 708140504,
					"content": "類似清掃魔物的委託有一大堆，原來冒險家們平時都在做這個嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140505
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 708140505,
					"content": "但是除了掃清魔物之外，還有報告說，有很多盜寶團在道路上盤踞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140506
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 708140506,
					"content": "這個歸冒險家管嗎？感覺更像是千岩軍的職責範圍…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140507,
						708140509
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 708140507,
					"content": "冒險家也管。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140508
					]
				},
				{
					"id": 708140508,
					"content": "這樣啊，冒險家簡直像是無所不能呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140511
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 708140511,
					"content": "#那麼，我會為{F#妳}{M#你}準備好合適的報酬，這個委託也拜託{F#妳}{M#你}了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140512
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 708140512,
					"content": "怎麼還有臨時追加的委託呀！我們之前完全沒有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140513
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 708140513,
					"content": "#會有更多的報酬的！我已經和嵐姐說過了，只要{F#妳}{M#你}們再完成委託，就會有更多的報酬！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140514
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 708140514,
					"content": "這還差不多。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140515
					]
				},
				{
					"id": 708140515,
					"content": "#那麼，就拜託{F#妳}{M#你}啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140516
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 708140516,
					"content": "這下子，一次就發出了兩個委託了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140517
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 708140517,
					"content": "嵐姐和我說的「讓冒險家乖乖接受委託的秘訣」果然有用…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "甜甜"
				},
				{
					"id": 708140509,
					"content": "只要報酬足夠…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140510
					]
				},
				{
					"id": 708140510,
					"content": "冒險家可真厲害…簡直像是無所不能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140511
					],
					"speakerTitle": "甜甜"
				}
			]
