			"dialogs": [
				{
					"id": 708140701,
					"content": "您完成委託了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140702
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 708140702,
					"content": "完成了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140703
					]
				},
				{
					"id": 708140703,
					"content": "好厲害…這就是冒險家的實力嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140704
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 708140704,
					"content": "那個，要是您不介意的話，能回答我幾個關於冒險家和委託的問題嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140705
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 708140705,
					"content": "嗯…對冒險家來說，除了清掃怪物之外，他們還會接受什麼委託？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140706,
						708140707,
						708140708
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 708140706,
					"content": "會幫人修理車輛和房屋。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140709
					]
				},
				{
					"id": 708140709,
					"content": "哇，這不是什麼都會做嗎，原來冒險家要這麼全能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140710
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 708140710,
					"content": "謝謝您！我先記下來…對了，這是您的報酬，請您收好，很豐厚的哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140711
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 708140711,
					"content": "下次您來我這裡接受委託的時候，我一定會給您準備最好的委託的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "甜甜"
				},
				{
					"id": 708140707,
					"content": "還會幫人採花和抓魚。",
					"roleType": "TALK_ROLE_PLAYER",
