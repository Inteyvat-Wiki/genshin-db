			"dialogs": [
				{
					"id": 708140201,
					"content": "怎麼，還有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140202
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 708140202,
					"content": "妳找到那把劍了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140203
					]
				},
				{
					"id": 708140203,
					"content": "#…虧{F#妳}{M#你}還記得，很遺憾，還是沒有任何線索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140204
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 708140204,
					"content": "看來，我還處在「踏破鐵鞋無覓處」的階段。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140205
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 708140205,
					"content": "#如果有什麼相關的委託，我說不定也會找{F#妳}{M#你}的，到那時候，可就要拜託{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140206
					],
					"speakerTitle": "嵐姐"
				}
			]
		},
		{
			"id": 7081403,
			"completionStepIds": [
				7081401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
