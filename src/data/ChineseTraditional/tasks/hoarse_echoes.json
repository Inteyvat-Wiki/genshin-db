			"dialogs": [
				{
					"id": 150170201,
					"content": "就是這裡了。這間屋子看起來還滿氣派的吧？稍等，我過去敲門。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170202
					],
					"speakerTitle": "夏溫"
				},
				{
					"id": 150170202,
					"content": "特拉佐莉，開門吧，我把那兩位帶來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170203
					],
					"speakerTitle": "夏溫"
				},
				{
					"id": 150170203,
					"content": "…特拉佐莉？妳在嗎？開開門啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170204
					],
					"speakerTitle": "夏溫"
				},
				{
					"id": 150170204,
					"content": "怪了，這個門…呃…怎麼是鎖死的？這個時間她應該不會出去啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170205
					],
					"speakerTitle": "夏溫"
				},
				{
					"id": 150170205,
					"content": "妮赫佳，妮赫佳？我是夏溫姐姐，幫我們開開門吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170206,
						150170207
					],
					"speakerTitle": "夏溫"
				},
				{
					"id": 150170206,
					"content": "一點反應也沒有…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170210
					]
				},
				{
					"id": 150170210,
					"content": "真奇怪，我都和特拉佐莉說好了…難道是她臨時帶著小妮赫佳出去拿藥了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170211
					],
					"speakerTitle": "夏溫"
				},
				{
					"id": 150170211,
					"content": "咦？這旁邊是什麼地方？看起來…像是小嵴鋒龍的窩？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150170212,
					"content": "沒錯，特拉佐莉有一隻嵴鋒龍夥伴，我記得名字好像是叫…「延古」的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170213
					],
					"speakerTitle": "夏溫"
				},
				{
					"id": 150170213,
					"content": "之前她還在做鍛造工作時，經常會讓延古幫忙做一些挖掘工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170214
					],
					"speakerTitle": "夏溫"
				},
				{
					"id": 150170214,
					"content": "但自從妮赫佳生病之後，特拉佐莉就再也沒有讓延古挖掘過什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170215
					],
					"speakerTitle": "夏溫"
				},
				{
					"id": 150170215,
					"content": "等等，這周圍怎麼亂七八糟的？延古也不見了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170216
					],
					"speakerTitle": "夏溫"
				},
				{
					"id": 150170216,
					"content": "嗚哇！還有好多箱子碎掉了，不會是遇到什麼壞事了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170217,
						150170218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150170217,
					"content": "靠近一點看看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 150170218,
					"content": "夏溫小姐先待在這裡。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170219
					]
				},
				{
					"id": 150170219,
					"content": "喔…喔！好的，我…我我我這就找個地方藏起來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170220
					],
					"speakerTitle": "夏溫"
				},
				{
					"id": 150170220,
					"content": "伊蜜這孩子的嘴難道是被大靈祝福過…怎麼每次說我不要去危險的地方，我就會遇到危險…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夏溫"
				},
				{
					"id": 150170207,
					"content": "要把門撞開嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170208
					]
				},
				{
					"id": 150170208,
					"content": "難道特拉佐莉女士和妮赫佳又出事了？還是妮赫佳的病情又…嗚…我不敢想了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150170209,
					"content": "妳不要瞎想，昨天我來的時候她們母女倆的情況很好，妮赫佳在自己的屋裡睡得很安穩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170210
					],
					"speakerTitle": "夏溫"
				}
			]
		},
