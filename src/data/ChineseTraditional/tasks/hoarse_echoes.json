			"dialogs": [
				{
					"id": 150170101,
					"content": "#喔！{F#妳}{M#你}們來得滿早的，看來很期待那份禮物嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170102,
						150170105
					],
					"speakerTitle": "夏溫"
				},
				{
					"id": 150170102,
					"content": "想探望特拉佐莉和妮赫佳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170103
					]
				},
				{
					"id": 150170103,
					"content": "對啊，妮赫佳生了那樣一場大病，特拉佐莉女士還失去了那麼重要的工作…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150170104,
					"content": "雖然情況好轉了，但不知道她們能不能打起精神來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150170109,
					"content": "哈哈哈，我已經託人去和特拉佐莉打過招呼了，她應該已經做好了所有準備。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170110
					],
					"speakerTitle": "夏溫"
				},
				{
					"id": 150170110,
					"content": "我們趕緊出發吧。伊蜜，麻煩妳照顧好店裡，等一下我就回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夏溫"
				},
				{
					"id": 150170105,
					"content": "所以那份禮物到底是什麼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170106
					]
				},
				{
					"id": 150170106,
					"content": "我也很在意…不過，我們也是想去看看妮赫佳的情況啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150170107,
					"content": "她生了那麼重的病，不知道恢復得怎麼樣了，還有特拉佐莉女士…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150170108,
					"content": "失去了那麼重要的工作，也不知道她能不能重新打起精神來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170109
					],
					"speakerTitle": "派蒙"
				}
			]
		},
