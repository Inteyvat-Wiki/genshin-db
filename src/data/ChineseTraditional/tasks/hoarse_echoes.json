			"dialogs": [
				{
					"id": 150170401,
					"content": "真的有一隻嵴鋒龍在上面，不知道是不是特拉佐莉女士養的那一隻…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170402,
						150170403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150170402,
					"content": "看起來…不像是遇到危險。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170404
					]
				},
				{
					"id": 150170404,
					"content": "唔…不對不對，我們是來找特拉佐莉女士的，這周圍也沒看見她啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150170405,
					"content": "#喂——{NICKNAME}——派蒙——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170406
					],
					"speakerTitle": "夏溫"
				},
				{
					"id": 150170406,
					"content": "夏溫小姐在喊什麼呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150170407,
					"content": "旁邊多了一個人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170408
					]
				},
				{
					"id": 150170408,
					"content": "快下來吧——特拉佐莉在這裡——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170409
					],
					"speakerTitle": "夏溫"
				},
				{
					"id": 150170409,
					"content": "欸？我們剛上來，特拉佐莉女士就回來了？這是怎麼回事啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170410,
						150170411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150170410,
					"content": "總之先下去吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170413
					]
				},
				{
					"id": 150170413,
					"content": "這隻嵴鋒龍怎麼跟上來了？嗚啊，不要突然衝過來呀，要撞到啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150170414,
					"content": "和嵴鋒龍一起到了山底下…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150170415
					]
				},
				{
					"id": 150170415,
					"content": "延古，過來，你怎麼又調皮了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170416
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150170416,
					"content": "嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170417
					],
					"speakerTitle": "延古"
				},
				{
					"id": 150170417,
					"content": "好孩子。是不是餓了？抱歉…等一下就幫你做好吃的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170418
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150170418,
					"content": "去吧，先去玩吧，等一下我再來陪你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170419
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150170419,
					"content": "嗚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170420
					],
					"speakerTitle": "延古"
				},
				{
					"id": 150170420,
					"content": "#抱歉兩位，我本來是在家裡等{F#妳}{M#你}們，但沒想到妮赫佳卻一個人偷偷跑了出去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170421
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150170421,
					"content": "我找到妮赫佳的時候，這孩子說想要為客人做一份禮物，所以就想去採幾束漂亮的花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170422
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150170422,
					"content": "她一邊採花一邊走，到最後居然迷了路…呼，幸好我及時找到她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170423
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150170423,
					"content": "妮赫佳的身體沒問題嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170424
					]
				},
				{
					"id": 150170424,
					"content": "我們聽夏溫小姐說她的病才剛剛好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170425
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150170425,
					"content": "那孩子身體還是太虛弱了，先是受了驚，又吹了涼風，現在有些低燒，剛剛吃過藥後就回去睡著了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170426
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150170426,
					"content": "不是什麼大問題，只要休息一個晚上應該就能好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170427
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150170427,
					"content": "#可是…她今天應該沒辦法和兩位見面了，實在抱歉，讓{F#妳}{M#你}們白跑了一趟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170428
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150170428,
					"content": "沒有沒有，不用道歉啦。我們之前聽夏溫小姐說妮赫佳生了好嚴重的病，好不容易才痊癒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170429
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150170429,
					"content": "所以我們今天想來看看妮赫佳的情況…無論如何，還是養好身體最重要啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170430,
						150170433
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150170430,
					"content": "她之前的病已經痊癒了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170431
					]
				},
				{
					"id": 150170431,
					"content": "至少…現在這孩子能和我說話，也能正常生活了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170432
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150170432,
					"content": "我已經滿足了，再別無他求…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170437
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150170437,
					"content": "#好了好了，{F#妳}{M#你}們怎麼把氣氛聊得這麼低落。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170438
					],
					"speakerTitle": "夏溫"
				},
				{
					"id": 150170438,
					"content": "小妮赫佳的心意我們已經感受到了，但是特拉佐莉，我之前和妳說的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170439,
						150170440
					],
					"speakerTitle": "夏溫"
				},
				{
					"id": 150170439,
					"content": "是禮物！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170441
					]
				},
				{
					"id": 150170441,
					"content": "喔！到底是什麼禮物啊？現在能夠告訴我們了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170442
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150170442,
					"content": "這份禮物就是我製作的「燃晶名刻」，用最純淨的礦石打造，幾乎不會被磨損。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170443
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150170443,
					"content": "製作它的技術也全都源自於打造「古名」的技藝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170444
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150170444,
					"content": "那、那這不就是「簡易古名」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170445
					]
				},
				{
					"id": 150170445,
					"content": "噗…不能這麼說，大靈也許會怪罪我的。我只是採用了打造古名的技藝，以礦石為原料，製作出這樣的結晶體。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170446
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150170446,
					"content": "剛做出這樣的結晶體時，我還覺得它除了「好看」和「永不磨損」之外，也沒什麼實際用途…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170447
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150170447,
					"content": "還是夏溫給我出了個主意，她建議我把這個結晶體做成一種特殊的「首飾」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170448
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150170448,
					"content": "「由『古名工匠』所打造的『燃晶名刻』，在上面鐫刻下永不磨損的字句。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170449
					],
					"speakerTitle": "夏溫"
				},
				{
					"id": 150170449,
					"content": "怎麼樣，聽起來是不是還滿有購買欲望的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170450
					],
					"speakerTitle": "夏溫"
				},
				{
					"id": 150170450,
					"content": "加上這麼多描述之後，突然覺得這個「燃晶名刻」好厲害…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170451,
						150170452
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150170451,
					"content": "妳滿會做生意的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170453
					]
				},
				{
					"id": 150170453,
					"content": "哈哈哈，但特拉佐莉製作的「燃晶名刻」的確很有意義啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170454
					],
					"speakerTitle": "夏溫"
				},
				{
					"id": 150170454,
					"content": "口耳相傳的話語總是不牢靠的。在轉述的過程中，它會變得殘缺、逐漸被遺忘，甚至被訛傳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170455
					],
					"speakerTitle": "夏溫"
				},
				{
					"id": 150170455,
					"content": "但如果將話語刻在這枚「燃晶名刻」上，就可以讓它恆久存在，而且意義明確，絕無半點扭曲的可能！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170456
					],
					"speakerTitle": "夏溫"
				},
				{
					"id": 150170456,
					"content": "無論是送給自己重要的朋友、心上的戀人，或是家裡的後輩，都再適合不過了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170457,
						150170460
					],
					"speakerTitle": "夏溫"
				},
				{
					"id": 150170457,
					"content": "妳是不是開始推銷了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170458
					]
				},
				{
					"id": 150170458,
					"content": "#說得我都快要心動了。唔…{NICKNAME}，不然我們也買一個吧？把我們的名字都刻上去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170459
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150170459,
					"content": "#等我們找到{F#妳}{M#你}的{M#妹妹}{F#哥哥}之後，再叫{M#她}{F#他}親手把名字也刻上去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170462
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150170462,
					"content": "這樣子，我們的名字就可以永遠黏在一起了，嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170463,
						150170495
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150170463,
					"content": "派蒙已經被吸引住了啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170464
					]
				},
				{
					"id": 150170464,
					"content": "#{F#妳}{M#你}們不要推辭哦，{F#妳}{M#你}們救了我，也救了小妮赫佳的生日禮物。這筆錢我還是願意出的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170465
					],
					"speakerTitle": "夏溫"
				},
				{
					"id": 150170465,
					"content": "夏溫，我之前和妳說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170466
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150170466,
					"content": "妳也不許推辭，特拉佐莉。我知道做一枚「燃晶名刻」要費多少工夫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170467
					],
					"speakerTitle": "夏溫"
				},
				{
					"id": 150170467,
					"content": "#謝謝妳，夏溫，還有{NICKNAME}。我會盡快做出來的，到時候，再請{F#妳}{M#你}們來親自刻寫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170468
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150170468,
					"content": "#那個時候小妮赫佳應該也恢復好了，有{F#妳}{M#你}們來探望，她一定會很高興的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170469,
						150170496
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150170469,
					"content": "好東西獨享也不太好…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170470
					]
				},
				{
					"id": 150170470,
					"content": "#喂！{F#妳}{M#你}想得也太遠了，這東西搞不好會很貴的喔，我們的旅費真的還夠嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170471
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150170471,
					"content": "等一下，難道這份禮物其實是夏溫小姐的計畫，想把我們拖進一個超大的花錢陷阱裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170472
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150170472,
					"content": "#說不定喔？畢竟…{F#妳}{M#你}們看起來也有不少積蓄…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170473
					],
					"speakerTitle": "夏溫"
				},
				{
					"id": 150170473,
					"content": "#嗚哇！不行不行，{NICKNAME}，{F#妳}{M#你}千萬不能亂花錢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170474
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150170474,
					"content": "#哈哈哈，那{F#妳}{M#你}們就自己商量吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170475
					],
					"speakerTitle": "夏溫"
				},
				{
					"id": 150170475,
					"content": "嗚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170476
					],
					"speakerTitle": "延古"
				},
				{
					"id": 150170476,
					"content": "#咦？！牠怎麼又出來了？{NICKNAME}快攔住牠！我不想再被撞了啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170477
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150170477,
					"content": "乖乖的喔！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170478
					]
				},
				{
					"id": 150170478,
					"content": "嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170479
					],
					"speakerTitle": "延古"
				},
				{
					"id": 150170479,
					"content": "特拉佐莉，我還要麻煩妳幫忙修一下我這枚「燃晶名刻」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170480
					],
					"speakerTitle": "夏溫"
				},
				{
					"id": 150170480,
					"content": "之前被襲擊的時候我把它掉在地上，繫繩和接口全都壞掉了，沒辦法一直隨身戴著。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170481
					],
					"speakerTitle": "夏溫"
				},
				{
					"id": 150170481,
					"content": "我自己也有試著修過，但怎麼修都不牢固，只能拜託妳了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170482
					],
					"speakerTitle": "夏溫"
				},
				{
					"id": 150170482,
					"content": "沒問題。交給我吧！保證修得和原來一模一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170483
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150170483,
					"content": "…謝謝妳，夏溫。謝謝妳願意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170484
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150170484,
					"content": "沒關係，特拉佐莉，只要小妮赫佳健康就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170485
					],
					"speakerTitle": "夏溫"
				},
				{
					"id": 150170485,
					"content": "嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170486
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150170486,
					"content": "延古！乖乖的，稍後我就來餵你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170487
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150170487,
					"content": "#{NICKNAME}，等「燃晶名刻」做好後，我會請夏溫告訴{F#妳}{M#你}的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170488
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150170488,
					"content": "說不定還能趕上妮赫佳的生日，到時候我們就好好辦個聚會吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170489
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150170489,
					"content": "嘿嘿，肯定有很多好吃的，到時候我們一定要留一點肚子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170490
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150170490,
					"content": "那就之後再見啦，特拉佐莉女士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170491,
						150170492
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150170491,
					"content": "到時候再見。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170493
					]
				},
				{
					"id": 150170493,
					"content": "#再見，也祝{F#妳}{M#你}們健康。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170494
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150170494,
					"content": "妮赫佳…會很高興的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150170492,
					"content": "祝妮赫佳健康。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170493
					]
				},
				{
					"id": 150170496,
					"content": "乾脆多買幾個送人好了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170470
					]
				},
				{
					"id": 150170495,
					"content": "聽起來有點太珍貴了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170464
					]
				},
				{
					"id": 150170460,
					"content": "我都快被說動了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170461
					]
				},
				{
					"id": 150170461,
					"content": "#買一個也不錯呀。把我們的名字都刻上去，等我們找到{F#妳}{M#你}{M#妹妹}{F#哥哥}之後，再叫{M#她}{F#他}把名字也親手刻上去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170462
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150170452,
					"content": "不愧是開店的老闆…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170453
					]
				},
				{
					"id": 150170440,
					"content": "期待期待，禮物禮物。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170441
					]
				},
				{
					"id": 150170433,
					"content": "她都可以亂跑了，看來狀況不錯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170434
					]
				},
				{
					"id": 150170434,
					"content": "是啊，特別是我叫她吃蔬菜的時候，她跑得多快啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170435
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150170435,
					"content": "跳過椅子、躲在桌子下面…在屋裡繞啊繞，我怎麼都追不上她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170436
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150170436,
					"content": "看著妮赫佳如今的樣子，我已經滿足了，再別無他求…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170437
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150170411,
					"content": "事情還真是巧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170412
					]
				},
				{
					"id": 150170412,
					"content": "總而言之，我們還是先下去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150170403,
					"content": "牠好像是自己跑上來的…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170404
					]
				}
			]
		},
