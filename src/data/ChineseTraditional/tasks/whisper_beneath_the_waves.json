						],
						"pointId": 13688
					}
				]
			},
			"dialogs": [
				{
					"id": 760200701,
					"content": "真是怪事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200702
					],
					"speakerTitle": "伊爾瑪里"
				},
				{
					"id": 760200702,
					"content": "#{F#妳}{M#你}們看到了嗎？剛才這棵樹唰啦一下就亮起來了，還有這些小東西…可惜不是魚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200703
					],
					"speakerTitle": "伊爾瑪里"
				},
				{
					"id": 760200703,
					"content": "這麼說來，中間那個東西就是它的根嗎？雖然不知道是什麼原理，但它現在看起來亮晶晶的，比之前黯淡的樣子好看多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200704
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760200704,
					"content": "講述了此前的經歷…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760200705
					]
				},
				{
					"id": 760200705,
					"content": "#難以置信…但{F#妳}{M#你}們也沒必要編些胡話來誆騙我，看來我那只有一半是霜月之子的釣友說的都是真的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200706
					],
					"speakerTitle": "伊爾瑪里"
				},
				{
					"id": 760200706,
					"content": "不過那又怎樣，只是些過去的殘影罷了。管他們唱什麼歌、說什麼話，也不妨礙我們活人釣活魚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200707
					],
					"speakerTitle": "伊爾瑪里"
				},
				{
					"id": 760200707,
					"content": "#話說回來，{F#妳}{M#你}們也是寶藏獵人吧。{F#妳}{M#你}們剛才撿到的東西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200708
					],
					"speakerTitle": "伊爾瑪里"
				},
				{
					"id": 760200708,
					"content": "這個就是<color=#00E1FFFF>「識者之證」</color>了吧？看起來只是普通的鳥羽…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200709
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760200709,
					"content": "聽相熟的遊商說，集齊五個<color=#00E1FFFF>「識者之證」</color>，就能找到埋藏在月之東，日之西的什麼「偉大財寶」，也不知道是真是假。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200710
					],
					"speakerTitle": "伊爾瑪里"
				},
				{
					"id": 760200710,
					"content": "反正不少寶藏獵人是真的信了，每個都趨之若鶩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200711
					],
					"speakerTitle": "伊爾瑪里"
				},
				{
					"id": 760200711,
					"content": "畢、畢竟是寶藏嘛！要說的話，我也是很感興趣的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200712
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760200712,
					"content": "要是我再年輕個二十歲…不，就算年輕個二十歲，也還是釣魚最重要。不過話說回來，今天也是空手而歸啊…",
					"roleType": "TALK_ROLE_NPC",
