			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"伊爾瑪里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760200101,
					"content": "今天也是空手而歸啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200102,
						760200105,
						760200112,
						760200117
					],
					"speakerTitle": "伊爾瑪里"
				},
				{
					"id": 760200102,
					"content": "你在這裡幹什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760200103
					]
				},
				{
					"id": 760200103,
					"content": "釣魚。不過到目前為止只釣到些不是魚的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200104
					],
					"speakerTitle": "伊爾瑪里"
				},
				{
					"id": 760200104,
					"content": "要是沉船裡的小物品之類的倒好，遊商會收。之前釣起過靴子上還連著半截…唉，不說了，說多了魚都給嚇跑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊爾瑪里"
				},
				{
					"id": 760200105,
					"content": "附近有什麼值得注意的嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760200106
					]
				},
				{
					"id": 760200106,
					"content": "#{F#妳}{M#你}也是來尋寶的？什麼只有在月之東，日之西才能找到的「偉大財寶」之類的…聽也知道不會是這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200107
					],
					"speakerTitle": "伊爾瑪里"
				},
				{
					"id": 760200107,
					"content": "哦，說起來過去這裡的確發生過不少船難，沉船裡或許的確有值錢的東西，不過那可不容易找啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200108
					],
					"speakerTitle": "伊爾瑪里"
				},
				{
					"id": 760200108,
					"content": "在酒館也聽倖存的水手說起過，那天晚上沒有月亮，在滔天的巨浪中卻能看到發光的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200109
					],
					"speakerTitle": "伊爾瑪里"
				},
				{
					"id": 760200109,
					"content": "他們說那一定就是獨眼的刻拉蒂了，是連月亮都能吞食的怪獸在和海中的巨蛇爭奪地盤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200110
					],
					"speakerTitle": "伊爾瑪里"
				},
				{
					"id": 760200110,
					"content": "那之後很長一段時間，這一塊都像帳房的墨水瓶似的黑壓壓一片，沒有船敢冒險從這裡經過，都怕被水下的亡魂纏上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200111
					],
					"speakerTitle": "伊爾瑪里"
				},
				{
					"id": 760200111,
					"content": "聽說那些亡魂現在還在附近徘徊，不過這些說法也就能哄哄孩子吧。我是不相信這類無稽之談的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊爾瑪里"
				},
				{
					"id": 760200112,
					"content": "關於這棵樹…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760200113
					]
				},
				{
					"id": 760200113,
					"content": "這玩意是真的有點邪門。這裡原本有個漩渦，水手們都叫它「刻拉蒂之眼」，但突然有那麼一天這棵樹就這樣長出來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200114
					],
					"speakerTitle": "伊爾瑪里"
				},
				{
					"id": 760200114,
					"content": "不過那陣子發生的怪事也不只這麼一件，想想看，都是在那些石頭從天上掉下來之後…搞不好這樹也跟石頭一樣來自天外。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200115
					],
					"speakerTitle": "伊爾瑪里"
				},
				{
					"id": 760200115,
					"content": "還有那些偶爾能見到的亮晶晶的小東西，稀罕得很。想著說不定也會有新品種的魚吧，我就是為了這個才來碰碰運氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200116
					],
					"speakerTitle": "伊爾瑪里"
				},
				{
					"id": 760200116,
					"content": "原本有個釣友和我一起，但他老說聽到奇怪的歌聲，嚇得不敢再來了。哼，雖然他只算半個霜月之子，但臭毛病是一點也不少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊爾瑪里"
				},
				{
					"id": 760200117,
					"content": "打擾了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760200118
					]
				},
				{
					"id": 760200118,
					"content": "沒關係。現在是一點魚的影子都看不到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊爾瑪里"
				}
			]
		},
