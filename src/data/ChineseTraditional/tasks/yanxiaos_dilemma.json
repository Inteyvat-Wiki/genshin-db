			},
			"dialogs": [
				{
					"id": 220030201,
					"content": "#{F#妳}{M#你}找好菜了沒有？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030202,
						220030203
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030202,
					"content": "找好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220030203,
					"content": "沒有。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030204
					]
				},
				{
					"id": 220030204,
					"content": "#{F#妳}{M#你}…{F#妳}{M#你}盡量快點，不然那個吃白食又得餓出個好歹來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "言笑"
				}
			]
		},
		{
			"id": 2200303,
			"completionStepIds": [
				2200303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
