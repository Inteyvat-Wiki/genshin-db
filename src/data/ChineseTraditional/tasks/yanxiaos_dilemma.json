			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"言笑"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220030301,
					"content": "#{F#妳}{M#你}在這等等，我把菜做好{F#妳}{M#你}順便送過去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030302
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030302,
					"content": "#{F#妳}{M#你}這是什麼表情，我不會讓{F#妳}{M#你}白打工，該給多少我就給{F#妳}{M#你}多少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030303
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030303,
					"content": "#行了，{F#妳}{M#你}把飯給那個吃白食的送過去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030304
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030304,
					"content": "那傢伙叫<color=#00E1FFFF>江雪</color>，一直在水邊釣魚，一眼就能看見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030305
					],
					"speakerTitle": "言笑"
				}
			]
		},
		{
			"id": 2200304,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2200304",
							"2"
