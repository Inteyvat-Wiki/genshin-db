			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"言笑"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220030401,
					"content": "快點去吧，免得那個吃白食的餓出個好歹來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030402
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030402,
					"content": "你為什麼要送飯給他？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030403
					]
				},
				{
					"id": 220030403,
					"content": "問這個做什麼，他個孤家寡人，整個璃月港只認識我一個人，也只敢到我這來蹭吃蹭喝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030404
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030404,
					"content": "#原因？{F#妳}{M#你}還要什麼原因，我樂意管他飯，行了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030405
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030405,
					"content": "再說，要是我不管他的飯，他再去荻花洲發一次瘋怎麼辦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030406
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030406,
					"content": "#{F#妳}{M#你}怎麼還在這！快去快去！磨蹭什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "言笑"
				}
			]
		},
		{
			"id": 2200305,
			"completionStepIds": [
				2200304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
