			"trigger": {
				"objectNames": [
					"言笑"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220030101,
					"content": "哼，也虧得他臉皮這麼厚，白吃白喝這麼久…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030102
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030102,
					"content": "你在做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030103
					]
				},
				{
					"id": 220030103,
					"content": "我？我正在替某個吃白食的傢伙做飯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030104
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030104,
					"content": "成天一副遊手好閒的樣子，來客棧幫個工都不肯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030105
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030105,
					"content": "天天釣魚，也沒看釣出個多大的魚來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030106
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030106,
					"content": "要是沒我，早晚得餓死在客棧旁邊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030107
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030107,
					"content": "算了，不說了，反正說了他也聽不到，聽到了也裝作聽不到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030108
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030108,
					"content": "#{F#妳}{M#你}有空的話，去幫我找點菜來吧，我這的菜有點不夠用了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030109
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030109,
					"content": "也不用多，就找一個<color=#00E1FFFF>絕雲椒椒</color>，和一個<color=#00E1FFFF>蓮蓬</color>來就行了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030110,
						220030112
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030110,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030111
					]
				},
				{
					"id": 220030111,
					"content": "#行，{F#妳}{M#你}找了就回來，我趕緊把菜給做了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030112,
					"content": "客棧裡有很多菜…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030113
					]
				},
				{
					"id": 220030113,
					"content": "那是老闆花的錢，他個吃白食的給錢了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030114
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030114,
					"content": "這些菜都是我自己出的錢…哼，我真是欠了他的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030115
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030115,
					"content": "#行了，{F#妳}{M#你}快去快回吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "言笑"
				}
			]
		},
		{
