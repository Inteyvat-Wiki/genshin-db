			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"江雪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220030501,
					"content": "#咦？{F#妳}{M#你}來找我有事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030502
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 220030502,
					"content": "這是言笑給你的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030503
					]
				},
				{
					"id": 220030503,
					"content": "我說這股香味是從哪來，這廚子的手藝果然不錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030504
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 220030504,
					"content": "#謝謝{F#妳}{M#你}，回去的時候，也記得幫我謝謝他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "江雪"
				}
			]
		},
		{
			"id": 2200306,
			"completionStepIds": [
				2200305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2200305",
