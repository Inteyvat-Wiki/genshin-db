				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"言笑"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220030601,
					"content": "飯送到了沒有？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030602
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030602,
					"content": "送到了，他說…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030603
					]
				},
				{
					"id": 220030603,
					"content": "#哼，{F#妳}{M#你}別說了，那個吃白食的肯定又要說謝謝之類的窮酸話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030604
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030604,
					"content": "這些年聽著我耳朵都起了繭了，謝什麼謝，有什麼好謝的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030605
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030605,
					"content": "有空說謝謝，有空去釣魚，不如來客棧打工賺錢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030606
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030606,
					"content": "#嘖，我和{F#妳}{M#你}說這個做什麼，這是給{F#妳}{M#你}的報酬，拿好了，忙{F#妳}{M#你}的去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "言笑"
				}
			]
		},
		{
			"id": 2200307,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2200305",
							"2"
						],
						"stepId": 2200305,
						"stateName": "QUEST_STATE_UNFINISHED"
