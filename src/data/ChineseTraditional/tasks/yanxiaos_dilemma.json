				"objectNames": [
					"江雪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220030701,
					"content": "唔？快點回去吧，那廚子等急了，說不定又要發飆了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030702
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 220030702,
					"content": "他為什麼要送飯給你？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030703
					]
				},
				{
					"id": 220030703,
					"content": "我們是…認識了很久的朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030704
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 220030704,
					"content": "嗯…我之前去了荻花洲一趟，做了件我必須做的錯事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030705
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 220030705,
					"content": "整座璃月港，只有這家客棧讓我住，那個廚子管我的飯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030706
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 220030706,
					"content": "#再往下講就沒完了，而且{F#妳}{M#你}也沒那麼多時間聽我講故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030707
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 220030707,
					"content": "好了，快回去吧，那廚子一向是沒什麼耐心的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "江雪"
				}
			]
		}
	]
