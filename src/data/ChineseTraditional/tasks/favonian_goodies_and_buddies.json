	"talks": [
		{
			"id": 7052001,
			"completionStepIds": [
				7052001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7052001",
							"2"
						],
						"stepId": 7052001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"伯恩哈德",
					"馬茨",
					"保琳",
					"阿貝多"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705200101,
					"content": "#榮譽騎士、派蒙！有個好消息要告訴{F#妳}{M#你}們！我們有新的幫手了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200102
					],
					"speakerTitle": "伯恩哈德"
				},
				{
					"id": 705200102,
					"content": "這兩位店主聽說了義賣的事後，想要加入我們，將收益捐獻出來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200103
					],
					"speakerTitle": "伯恩哈德"
				},
				{
					"id": 705200103,
					"content": "欸？捐獻？真的沒關係嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705200104,
					"content": "沒事沒事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200105
					],
					"speakerTitle": "馬茨"
				},
				{
					"id": 705200105,
					"content": "多一份資金，就多一位受益人，我和保琳小姐都覺得比我們埋頭賺錢更重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200106
					],
					"speakerTitle": "馬茨"
				},
				{
					"id": 705200106,
					"content": "這次佳釀節的客人比往年更多，我們提前完成了經營計畫，早就心滿意足了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200107
					],
					"speakerTitle": "保琳"
				},
				{
					"id": 705200107,
					"content": "#不能只讓{F#妳}{M#你}們為老人和孩子們忙前忙後，我們也想盡可能幫上忙，請不要有心理負擔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200108
					],
					"speakerTitle": "保琳"
				},
				{
					"id": 705200108,
					"content": "由衷感謝你們。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705200109
					]
				},
				{
					"id": 705200109,
					"content": "嗯，感覺心裡暖暖的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705200110,
					"content": "不過這下就得換個名字了吧！那就改叫…「西風嘩嘩義賣聯盟」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200111,
						705200112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705200111,
					"content": "這風還變大了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705200113
					]
				},
				{
					"id": 705200113,
					"content": "讓我們一起拿出全力，辦好這次義賣活動吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705200114,
					"content": "兩位店主加入了隊伍，義賣活動的規模擴大了…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705200115
					]
				},
				{
					"id": 705200115,
					"content": "來這邊看看吧，「西風嘩嘩義賣聯盟」的特色小吃、日用百貨和鮮花喔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705200116,
					"content": "欸？快看快看，阿貝多來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705200117,
					"content": "#{NICKNAME}和派蒙，{F#妳}{M#你}們好啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200118,
						705200119
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 705200118,
					"content": "歡迎光臨。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705200120
					]
				},
				{
					"id": 705200120,
					"content": "阿貝多是要採購什麼東西嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705200121,
					"content": "#我沒有什麼特別需要的。只是聽說，騎士團的店鋪由{F#妳}{M#你}們管理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200122
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 705200122,
					"content": "#正好我和蒂瑪烏斯的研究有了進展，就帶了一批成品過來給{F#妳}{M#你}們，算是對這次義賣活動的贊助吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200123
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 705200123,
					"content": "居然是專程來贊助我們的嗎！好感動！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705200124,
					"content": "讓我看看…瓶子裡裝著什麼好東西？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705200125,
					"content": "是特效醒酒湯劑。能讓喝醉的人恢復清醒，有效緩解頭痛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200126
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 705200126,
					"content": "#請將它們免費提供給有需要的人吧。這些贈品應該也會為{F#妳}{M#你}們吸引更多的顧客。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200127
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 705200127,
					"content": "這麼有用的東西，是花了不少心力才做出來的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705200128,
					"content": "喔？是我太久沒露一手了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200129
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 705200129,
					"content": "過去的我，可能不會太在意這類研究吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200130
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 705200130,
					"content": "但能以煉金術的產物為人們的生活帶來便捷，的確是一件好事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200131
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 705200131,
					"content": "嗯！雖然我是沒有醉酒的經歷啦，但我也能想像得出來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705200132,
					"content": "要是剛剛享受完了美酒，就一個腳滑掉進湖裡去，或者是被石頭絆倒，好心情也會溜走的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705200133,
					"content": "我們也不能白收好處。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705200134
					]
				},
				{
					"id": 705200134,
					"content": "嗯，阿貝多就帶一些吃的回去吧，還能和小可莉一起分享，算我們請你的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705200135,
					"content": "好，那我也就不推辭了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200136
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 705200136,
					"content": "#想不到，{F#妳}{M#你}們有那麼出色的商業頭腦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200137
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 705200137,
					"content": "#小吃店的定位很精妙，不僅契合節日的氣氛，分工上也很適合{F#妳}{M#你}們兩位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200138
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 705200138,
					"content": "如果是由其他騎士團成員負責的話，通常都只會售賣雜貨吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200139
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 705200139,
					"content": "哇，被阿貝多誇了誇，我簡直就像喝了醒酒湯一樣神清氣爽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200140
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705200140,
					"content": "欸，不過這樣一說，阿貝多對義賣瞭解得很清楚呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200141
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705200141,
					"content": "嗯，以往騎士團向大家徵集雜物用於義賣的時候，我提供過十幾張風景畫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200142
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 705200142,
					"content": "阿貝多的畫，應該很值錢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200143
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705200143,
					"content": "派蒙的想法倒是和那些商人一致。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200144
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 705200144,
					"content": "確實有人覺得我的畫法少見，有投資價值，就花大價錢買下了它們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200145
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 705200145,
					"content": "再加上之前一些寫生畫的拍賣收益不錯…艾莉絲女士似乎察覺了什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200146
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 705200146,
					"content": "她用她獨特的管道為我的作品申請了認證…記得是叫「專利」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200147
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 705200147,
					"content": "後來，有不少畫家模仿我的風景畫，它們也成了蒙德城裡相當常見的掛飾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200148,
						705200149
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 705200148,
					"content": "有點印象…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705200150
					]
				},
				{
					"id": 705200150,
					"content": "根據艾莉絲女士的「專利」規則，畫家們每次出售這種風景畫，都需要向我支付一定比例的費用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200151
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 705200151,
					"content": "財富向來不是我的目標，我不關心它的去處，就全權委託給騎士團管理了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200152
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 705200152,
					"content": "要我來出主意的話…嗯，拿去修繕艾莉絲女士造成的破壞也滿適合的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200153
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 705200153,
					"content": "但聽說，他們最終還是把它用在慈善事業上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200154,
						705200155
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 705200154,
					"content": "明明沒有參加過義賣…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705200156
					]
				},
				{
					"id": 705200156,
					"content": "該說不愧是你嗎，阿貝多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200157
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705200157,
					"content": "雖然我的本意並非如此，但既然有意外的收穫，我也慢慢學會接受它了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200158,
						705200160
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 705200158,
					"content": "為你高興。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705200159
					]
				},
				{
					"id": 705200159,
					"content": "#謝謝{F#妳}{M#你}，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200162
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 705200162,
					"content": "#那今天我先回工坊了，預祝{F#妳}{M#你}們經營順利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200163
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 705200163,
					"content": "也謝謝你的贊助，阿貝多，研究也要順利呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200164
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705200164,
					"content": "花時間親手製作了小吃，交給了阿貝多…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705200165
					]
				},
				{
					"id": 705200165,
					"content": "有空再來玩喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705200160,
					"content": "想學畫畫。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705200161
					]
				},
				{
					"id": 705200161,
					"content": "當然，我樂於分享經驗。不過…唔，還是要多練習。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200162
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 705200155,
					"content": "卻達成了相同的目標…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705200156
					]
				},
				{
					"id": 705200149,
					"content": "原來是你的手筆…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705200150
					]
				},
				{
					"id": 705200119,
					"content": "好久不見。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705200120
					]
				},
				{
