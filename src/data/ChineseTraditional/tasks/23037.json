			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"馬魯夫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230370101,
					"content": "唉，這種病不太好治啊，看來還是要請扎卡里亞醫生幫幫忙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370102
					],
					"speakerTitle": "馬魯夫"
				},
				{
					"id": 230370102,
					"content": "遇到什麼重病患者了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230370103
					]
				},
				{
					"id": 230370103,
					"content": "欸？是旅行者啊…倒也不是什麼重病患者，就是有個病人頭痛得有點嚴重。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370104
					],
					"speakerTitle": "馬魯夫"
				},
				{
					"id": 230370104,
					"content": "雖然我也幫他開過藥了，但藥效卻不怎麼明顯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370105
					],
					"speakerTitle": "馬魯夫"
				},
				{
					"id": 230370105,
					"content": "不能開其他的藥嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230370106
					]
				},
				{
					"id": 230370106,
					"content": "咳…我哪會啊。現在我手上的藥方，基本上都是我自己摸索出來的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370107
					],
					"speakerTitle": "馬魯夫"
				},
				{
					"id": 230370107,
					"content": "這些藥方治療一些小病小痛還可以，一遇見症狀稍微重點的病症就很難起效了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370108
					],
					"speakerTitle": "馬魯夫"
				},
				{
					"id": 230370108,
					"content": "還好城裡「健康之家」的扎卡里亞醫生答應過我，可以幫我準備藥方和藥物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370109
					],
					"speakerTitle": "馬魯夫"
				},
				{
					"id": 230370109,
					"content": "#旅行者，{F#妳}{M#你}能幫我個忙嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370110
					],
					"speakerTitle": "馬魯夫"
				},
				{
					"id": 230370110,
					"content": "#我現在還有一些患者要治療，實在是走不開，{F#妳}{M#你}能幫我去城裡找一下扎卡里亞醫生，請他幫我開一個藥方嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370111,
						230370113
					],
					"speakerTitle": "馬魯夫"
				},
				{
					"id": 230370111,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230370112
					]
				},
				{
					"id": 230370112,
					"content": "#那就拜託{F#妳}{M#你}了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "馬魯夫"
				},
				{
					"id": 230370113,
					"content": "扎卡里亞會來村裡嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230370114
					]
				},
				{
					"id": 230370114,
					"content": "扎卡里亞醫生偶爾會託人送點藥過來，但他太忙了，實在是沒什麼空來村裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370115
					],
					"speakerTitle": "馬魯夫"
				},
				{
					"id": 230370115,
					"content": "#總之藥方的事就拜託{F#妳}{M#你}了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "馬魯夫"
				}
			]
		},
