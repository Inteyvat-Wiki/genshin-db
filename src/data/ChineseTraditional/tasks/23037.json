			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"扎卡里亞"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230370501,
					"content": "最近的病人怎麼越來越多了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370502
					],
					"speakerTitle": "扎卡里亞"
				},
				{
					"id": 230370502,
					"content": "關於馬魯夫的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230370503
					]
				},
				{
					"id": 230370503,
					"content": "馬魯夫？他又遇見什麼疑難雜症了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370504
					],
					"speakerTitle": "扎卡里亞"
				},
				{
					"id": 230370504,
					"content": "敘述了馬魯夫所面對的病症…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230370505
					]
				},
				{
					"id": 230370505,
					"content": "唉，我說了多少次了，這種小病以他的水準完全可以一個人治療，沒必要來找我啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370506
					],
					"speakerTitle": "扎卡里亞"
				},
				{
					"id": 230370506,
					"content": "大概又是那些病患覺得自己的病很重，不相信他這位「赤腳醫生」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370507
					],
					"speakerTitle": "扎卡里亞"
				},
				{
					"id": 230370507,
					"content": "為了讓病患安心，才來請我幫他開個藥方吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370508
					],
					"speakerTitle": "扎卡里亞"
				},
				{
					"id": 230370508,
					"content": "#這麼多年一直待在那裡治病，也是辛苦他了…我這就幫他寫個藥方，請{F#妳}{M#你}記錄一下吧，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370509
					],
					"speakerTitle": "扎卡里亞"
				},
				{
					"id": 230370509,
					"content": "唔，我記得馬魯夫這次要治的病是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370510
					],
					"speakerTitle": "扎卡里亞"
				},
				{
					"id": 230370510,
					"content": "是個頭痛的病患。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230370511
					]
				},
				{
					"id": 230370511,
					"content": "嗯，治療頭痛…就用我之前幫他開的那種藥方就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370512
					],
					"speakerTitle": "扎卡里亞"
				},
				{
					"id": 230370512,
					"content": "把那個藥方裡的藥物煮成藥湯，然後再加入三株<color=#00E1FFFF>薄荷</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370513
					],
					"speakerTitle": "扎卡里亞"
				},
				{
					"id": 230370513,
					"content": "最後把加入了薄荷的藥湯用<color=#00E1FFFF>大火</color>繼續煮，煮大概…算了…<color=#00E1FFFF>煮到藥材都浮起來</color>就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370514
					],
					"speakerTitle": "扎卡里亞"
				},
				{
					"id": 230370514,
					"content": "#唔…我還是寫下來給{F#妳}{M#你}吧，以免{F#妳}{M#你}忘了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370520
					],
					"speakerTitle": "扎卡里亞"
				},
				{
					"id": 230370520,
					"content": "扎卡里亞將藥方寫在了紙上…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230370515
					]
				},
				{
					"id": 230370515,
					"content": "#那就麻煩{F#妳}{M#你}把這藥方送回去給馬魯夫了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370516
					],
					"speakerTitle": "扎卡里亞"
				},
				{
					"id": 230370516,
					"content": "說實話，這藥方名義上說是「藥」，其實更接近一種…呃，怎麼形容呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370517
					],
					"speakerTitle": "扎卡里亞"
				},
				{
					"id": 230370517,
					"content": "一種…藥效不怎麼猛烈，以補充營養為主的補充劑吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370518
					],
					"speakerTitle": "扎卡里亞"
				},
				{
					"id": 230370518,
					"content": "就算製作時沒完全按照藥方上來，也不會有什麼嚴重後果，頂多就是喝下去沒效果罷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370519
					],
					"speakerTitle": "扎卡里亞"
				},
				{
					"id": 230370519,
					"content": "唉，所以說，馬魯夫自己調整一下藥方就可以了，他就不能自信一點嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "扎卡里亞"
				}
			]
		},
