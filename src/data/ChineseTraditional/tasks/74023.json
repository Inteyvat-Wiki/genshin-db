			"dialogs": [
				{
					"id": 740230301,
					"content": "#{NICKNAME}{M#哥哥}{F#姐姐}和派蒙妹妹，{F#妳}{M#你}們好呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230302,
