			"completionStepIds": [
				7402303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7402303",
							"2"
						],
						"stepId": 7402303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"薩莎",
					"烏布"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740230101,
					"content": "呼，這樣就順眼多了。就算是薩莎看到，也會為我們驕傲的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740230102,
					"content": "強盜！有強盜啊——光天化日之下，居然有強盜啊——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230103
					],
					"speakerTitle": "烏布"
				},
				{
					"id": 740230103,
					"content": "什麼？！哪裡有強盜？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740230104,
					"content": "#我是說{F#妳}{M#你}們這對強盜搭檔！不僅破壞我的大作，還拿走寶箱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230105,
						740230107
					],
					"speakerTitle": "烏布"
				},
				{
					"id": 740230105,
					"content": "原來真的是協會的人做的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230106
					]
				},
				{
					"id": 740230106,
					"content": "#我做了什麼？不如問問{F#妳}{M#你}們做了什麼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230109
					],
					"speakerTitle": "烏布"
				},
				{
					"id": 740230109,
					"content": "所以說，這些醜東西就是你的「大作」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740230110,
					"content": "#真失禮，什麼叫醜東西？{F#妳}{M#你}們完全看不懂裝置藝術嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230111
					],
					"speakerTitle": "烏布"
				},
				{
					"id": 740230111,
					"content": "#看來楓丹的審美教育還任重道遠呀…哦，不過{F#妳}{M#你}們看起來不像是楓丹人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230112
					],
					"speakerTitle": "烏布"
				},
				{
					"id": 740230112,
					"content": "#我們的確不是楓丹人，我是派蒙，{M#他}{F#她}是{NICKNAME}，也是冒險家協會的成員。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230113,
						740230115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740230113,
					"content": "嗚嗚，是邪惡組織的成員。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230114
					]
				},
				{
					"id": 740230114,
					"content": "是啊，不過不用穿制服，所以不是邪惡綠衣人，真是太好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740230117,
					"content": "#我是冒險家，兼裝置藝術家烏布。看到{F#妳}{M#你}們胡言亂語的樣子，看來平常也是這樣行事瘋癲…這次的事就先不計較了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230118
					],
					"speakerTitle": "烏布"
				},
				{
					"id": 740230118,
					"content": "啊？其實…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740230119,
					"content": "怎麼？如果有什麼感謝的話要說就趁現在，我還得把作品復原。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230120
					],
					"speakerTitle": "烏布"
				},
				{
					"id": 740230120,
					"content": "感謝是一句也沒有，生氣的話我已經裝滿一箱子了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230121
					],
					"speakerTitle": "薩莎"
				},
				{
					"id": 740230121,
					"content": "薩莎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740230122,
					"content": "有我在，派蒙妹妹就不用害怕了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230123
					],
					"speakerTitle": "薩莎"
				},
				{
					"id": 740230123,
					"content": "邪惡綠衣人，你設下的陷阱已經全部被我們破壞掉了！快點放棄用邪惡陷阱毀滅美麗楓丹的企圖吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230124
					],
					"speakerTitle": "薩莎"
				},
				{
					"id": 740230124,
					"content": "#什麼企圖？等等，妳說全部破壞掉了…{F#妳}{M#你}們把我的藝術作品全都毀掉了？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230125
					],
					"speakerTitle": "烏布"
				},
				{
					"id": 740230125,
					"content": "這、這也不算是毀掉啦，只是重新擺放了一下，讓它們看起來跟周圍的景色更和諧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740230126,
					"content": "#{F#妳}{M#你}們…{F#妳}{M#你}們這些小鬼、俗人懂什麼藝術！我的裝置藝術、我的作品…居然全都變成這樣平庸的東西了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230127
					],
					"speakerTitle": "烏布"
				},
				{
					"id": 740230127,
					"content": "可是那真的能叫藝術嗎？雖然我不是太懂啦，但是會讓人看了只覺得彆扭的東西也能算藝術嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740230128,
					"content": "那當然了，藝術的邊界是由藝術家決定的。藝術家創作的作品，自然會被稱作是藝術。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230129
					],
					"speakerTitle": "烏布"
				},
				{
					"id": 740230129,
					"content": "誰是藝術家？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230130
					],
					"speakerTitle": "薩莎"
				},
				{
					"id": 740230130,
					"content": "那當然是我了，偉大的裝置藝術家，烏布。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230131
					],
					"speakerTitle": "烏布"
				},
				{
					"id": 740230131,
					"content": "如果是這樣，作為打倒邪惡組織守護楓丹未來藝術家聯盟的創始人，我否認那是藝術。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230132
					],
					"speakerTitle": "薩莎"
				},
				{
					"id": 740230132,
					"content": "打…打倒什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230133,
						740230135
					],
					"speakerTitle": "烏布"
				},
				{
					"id": 740230133,
					"content": "打倒邪惡組織。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230134
					]
				},
				{
					"id": 740230134,
					"content": "通常是指會用，呃，裝置藝術？破壞風景的冒險家協會…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230136
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740230136,
					"content": "開什麼玩笑，我都沒聽說過這什麼打倒什麼的聯盟，妳這個小妹妹憑什麼說我的作品不是藝術。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230137
					],
					"speakerTitle": "烏布"
				},
				{
					"id": 740230137,
					"content": "因為我是畫家，所以也算是藝術家，我當然有資格了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230138
					],
					"speakerTitle": "薩莎"
				},
				{
					"id": 740230138,
					"content": "啊？小妹妹，藝術家才不是扮家家酒，不是妳想當就能當的，得有作品，還得受人認可…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230139
					],
					"speakerTitle": "烏布"
				},
				{
					"id": 740230139,
					"content": "那你的資格又是從哪裡來的啊？你的作品，就是那些裝置藝術…那些邪惡陷阱嗎？有人為它們拍手嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230140
					],
					"speakerTitle": "薩莎"
				},
				{
					"id": 740230140,
					"content": "那是因為俗人太多了，完全無法理解其中的精妙之處，真正的藝術總是曲高和寡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230141,
						740230143
					],
					"speakerTitle": "烏布"
				},
				{
					"id": 740230141,
					"content": "還是先從大家能看懂的藝術做起吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230142
					]
				},
				{
					"id": 740230142,
					"content": "是啊，如果完全沒有人能看懂，該說是太過前衛呢，還是根本就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230145
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740230145,
					"content": "#不…怎麼會？我的作品是完美的，是不可能有問題的，只是{F#妳}{M#你}們不懂、只是其他人也都不懂而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230146
					],
					"speakerTitle": "烏布"
				},
				{
					"id": 740230146,
					"content": "可惡，我是不會放棄的，我們走著瞧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230147
					],
					"speakerTitle": "烏布"
				},
				{
					"id": 740230147,
					"content": "烏布踉踉蹌蹌地離開了…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740230148
					]
				},
				{
					"id": 740230148,
					"content": "真是頑固的敵人，不過我也不會輕易放棄，畢竟楓丹藝術的未來就靠我了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230149
					],
					"speakerTitle": "薩莎"
				},
				{
					"id": 740230149,
					"content": "大家都有可以為之奮鬥的事情了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230150
					]
				},
				{
					"id": 740230150,
					"content": "這算是好事嗎？應該算吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740230143,
					"content": "也就是說完全沒有人能看懂。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230144
					]
				},
				{
					"id": 740230144,
					"content": "怎麼聽都像是失敗作…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230145
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740230135,
					"content": "目前看樣子是要打倒你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230136
					]
				},
				{
					"id": 740230115,
					"content": "你好啊，夥伴。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230116
					]
				},
				{
					"id": 740230116,
					"content": "連名字都不知道的人應該不能說是夥伴吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740230107,
					"content": "啊，是邪惡綠衣人！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230108
					]
				},
				{
					"id": 740230108,
					"content": "哎喲，還是會說怪話的強盜，今天這是什麼日子啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230109
					],
					"speakerTitle": "烏布"
				}
			]
		},
		{
