	"talks": [
		{
			"id": 1202001,
			"completionStepIds": [
				1202003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
