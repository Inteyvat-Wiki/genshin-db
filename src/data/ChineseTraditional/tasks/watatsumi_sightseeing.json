			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"五郎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120200101,
					"content": "#幸虧{F#妳}{M#你}在這裡，不然還真讓他們給逃掉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200102
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 120200102,
					"content": "你手裡的就是心海的錦囊嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120200103,
					"content": "讓我看看…哇！好厚！這麼厚一本都是嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120200104,
					"content": "其實…這只是一部分，我身上還有五本。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200105
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 120200105,
					"content": "這麼多！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120200106,
					"content": "珊瑚宮大人向來算無遺策。這些又是「常備錦囊」，難免數量會多一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200107
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 120200107,
					"content": "不過也多虧了這些錦囊，我們才能夠應對各種各樣複雜的情況。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200108
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 120200108,
					"content": "這麼多錦囊，心海要寫多久啊。每一種情況都要考慮，想想就讓人頭疼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120200109,
					"content": "#隊長！{F#妳}{M#你}這次回海祇島，會重新接手劍魚二番隊嗎？我們大家都很想{F#妳}{M#你}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200110,
						120200111
					],
					"speakerTitle": "幸德"
				},
				{
					"id": 120200110,
					"content": "劍魚二番隊還在嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120200112
					]
				},
				{
					"id": 120200112,
					"content": "珊瑚宮大人說，現在已經是和平時期，軍隊的數量需要適當減少，幫助民眾恢復生產。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200113
					],
					"speakerTitle": "幸德"
				},
				{
					"id": 120200113,
					"content": "一半左右的士兵還維持著「別動隊」的編制，支援各個小隊。還有一半改為從事巡邏、建造、農耕之類的工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200114
					],
					"speakerTitle": "幸德"
				},
				{
					"id": 120200114,
					"content": "前兩天還聽以前的同伴抱怨說，自己不想被分去造房子，想留在前線繼續戰鬥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200115
					],
					"speakerTitle": "幸德"
				},
				{
					"id": 120200115,
					"content": "反抗軍的大家還是老樣子呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120200116,
					"content": "對了！說起來，是心海叫我們來參加慶功會的。五郎，你知道心海在哪裡嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120200117,
					"content": "珊瑚宮大人的話，現在應該是在望瀧村。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200118
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 120200118,
					"content": "聽說那邊出了點事情，珊瑚宮大人應該會親自過去處理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200119
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 120200119,
					"content": "#我們也該離開了…另外，{NICKNAME}，{F#妳}{M#你}可以關注一下路上的士兵們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200120
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 120200120,
					"content": "最近我感覺不少士兵都有些浮躁，不過我也不知道為什麼，他們不想跟我說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200121
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 120200121,
					"content": "以前大家有什麼煩惱都會告訴我，現在卻躲躲藏藏的…我很擔心他們會不會是遇到了什麼麻煩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200122,
						120200123
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 120200122,
					"content": "我來試試。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120200124
					]
				},
				{
					"id": 120200124,
					"content": "是呀，我們也想和反抗軍的士兵們聊聊呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120200125,
					"content": "#我們出發吧，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120200123,
					"content": "正好去見一見以前的同伴。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120200124
					]
				},
				{
					"id": 120200111,
					"content": "現在大家怎麼樣了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120200112
					]
				}
			]
		},
		{
			"id": 1202002,
			"completionStepIds": [
				1202004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1202004",
							"2"
						],
						"stepId": 1202004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"傳次郎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120200201,
					"content": "#{F#妳}{M#你}是…劍魚二番隊的隊長？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200202
					],
					"speakerTitle": "傳次郎"
				},
				{
					"id": 120200202,
					"content": "#我認得{F#妳}{M#你}！多虧了{F#妳}{M#你}，海祇島才有現在的和平。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200203
					],
					"speakerTitle": "傳次郎"
				},
				{
					"id": 120200203,
					"content": "#我雖然不是劍魚二番隊的成員，但當初在踏鞴砂的時候，我就見過{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200204
					],
					"speakerTitle": "傳次郎"
				},
				{
					"id": 120200204,
					"content": "#當時兩軍對壘，{F#妳}{M#你}在陣前比武中單挑好幾個幕府武士，帥得不行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200205
					],
					"speakerTitle": "傳次郎"
				},
				{
					"id": 120200205,
					"content": "有什麼需要幫忙的嗎？我在所不辭！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200206
					],
					"speakerTitle": "傳次郎"
				},
				{
					"id": 120200206,
					"content": "關於最近發生的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120200207
					]
				},
				{
					"id": 120200207,
					"content": "大家很浮躁啊…確實，我也感覺到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200208
					],
					"speakerTitle": "傳次郎"
				},
				{
					"id": 120200208,
					"content": "可能是大家還沒有從戰爭中走出來吧。那時候在戰場上，隨時都可能犧牲，每個人都很緊張。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200209
					],
					"speakerTitle": "傳次郎"
				},
				{
					"id": 120200209,
					"content": "突然戰爭結束了，才發現不知道要怎麼回歸正常的生活…哈哈，我覺得沒關係，過段時間說不定就好啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200210
					],
					"speakerTitle": "傳次郎"
				},
				{
					"id": 120200210,
					"content": "別的我也不知道了。不過，有珊瑚宮大人在，海祇島就不會有事，我們都深信這一點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200211
					],
					"speakerTitle": "傳次郎"
				},
				{
					"id": 120200211,
					"content": "#現在{F#妳}{M#你}也回來了，這裡就更安全了！如果有什麼需要，可以隨時來找我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200212
					],
					"speakerTitle": "傳次郎"
				},
				{
					"id": 120200212,
					"content": "感覺他很熱情呢…我們再去問問下一個人吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 1202003,
			"completionStepIds": [
				1202005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1202005",
							"2"
						],
						"stepId": 1202005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"有澤"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120200301,
					"content": "呼啊…和平…最棒了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200302
					],
					"speakerTitle": "有澤"
				},
				{
					"id": 120200302,
					"content": "#嗯？{F#妳}{M#你}看起來有點眼熟…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200303
					],
					"speakerTitle": "有澤"
				},
				{
					"id": 120200303,
					"content": "#我好像在哪見過{F#妳}{M#你}呀…想不起來了。但{F#妳}{M#你}應該不是敵人，有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200304
					],
					"speakerTitle": "有澤"
				},
				{
					"id": 120200304,
					"content": "關於最近發生的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120200305
					]
				},
				{
					"id": 120200305,
					"content": "#{F#妳}{M#你}說大家有些浮躁？有嗎，我沒感覺到啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200306
					],
					"speakerTitle": "有澤"
				},
				{
					"id": 120200306,
					"content": "可能是因為我平時不喜歡跟別人聊天吧，在我眼裡他們一直都很喧鬧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200307
					],
					"speakerTitle": "有澤"
				},
				{
					"id": 120200307,
					"content": "來之不易的和平，必須要好好享受才行…在這裡曬曬太陽，吹吹海風，就是我生命的全部了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200308
					],
					"speakerTitle": "有澤"
				},
				{
					"id": 120200308,
					"content": "#抱歉啊，我也沒辦法回答{F#妳}{M#你}的問題。不過你可以問珊瑚宮大人，珊瑚宮大人什麼都懂的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200309
					],
					"speakerTitle": "有澤"
				},
				{
					"id": 120200309,
					"content": "嗚哇…他快要睡著了。我們還是不要打擾他了，去問問下一個人吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
