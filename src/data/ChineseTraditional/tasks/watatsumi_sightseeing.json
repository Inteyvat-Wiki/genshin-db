				"points": []
			},
			"dialogs": [
				{
					"id": 120200501,
					"content": "說！你是不是偷偷把從海祇島採購的貨物，運送給天領奉行了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200502
					],
					"speakerTitle": "松田"
				},
				{
					"id": 120200502,
					"content": "我早就覺得你一個天領奉行的商人，來海祇島做生意不正常。這一次你總沒話說了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200503
					],
					"speakerTitle": "松田"
				},
				{
					"id": 120200503,
					"content": "冤，冤枉啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200504
					],
					"speakerTitle": "成瀨"
				},
				{
					"id": 120200504,
					"content": "還說冤枉？當時我們就不應該同意你來海祇島做生意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200505
					],
					"speakerTitle": "內村"
				},
				{
					"id": 120200505,
					"content": "帶走帶走！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200506
					],
					"speakerTitle": "內村"
				},
				{
					"id": 120200506,
					"content": "等等…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120200507
					]
				},
				{
					"id": 120200507,
					"content": "請等一下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200508
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120200508,
					"content": "心海！妳來啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200509
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120200509,
					"content": "這裡好像發生了什麼事情，妳快來看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200510
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120200510,
					"content": "報告珊瑚宮大人，這個商人形跡可疑，被我們抓到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200511
					],
					"speakerTitle": "松田"
				},
				{
					"id": 120200511,
					"content": "據我們觀察，他長期只買不賣，身邊卻一點貨物都沒有，很可能是偷偷運到天領奉行去了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200512
					],
					"speakerTitle": "松田"
				},
				{
					"id": 120200512,
					"content": "我没有…我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200513
					],
					"speakerTitle": "成瀨"
				},
				{
					"id": 120200513,
					"content": "好了。各位不要激動，放鬆放鬆。跟我一起做個深呼吸…呼…有好一點嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200514
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120200514,
					"content": "松田、內村，我知道你們很擔心海祇島的安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200515
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120200515,
					"content": "但是，先不管這位商人先生有沒有犯錯，我們至少要給他解釋的權利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200516
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120200516,
					"content": "有錯自然應該接受懲罰，無錯也不應該被隨意冤枉。海祇島上，辦事靠的是事實，而非主觀判斷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200517
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120200517,
					"content": "商人先生，既然我的部下提出了貨物的問題，不妨請你解釋一下，由我來做個評斷如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200518
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120200518,
					"content": "可以，當然可以！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200519
					],
					"speakerTitle": "成瀨"
				},
				{
					"id": 120200519,
					"content": "我在海祇島經商，當然也積累下來了一批貨物。本來想囤久一點，等下次漲價的時候賣出…咳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200520
					],
					"speakerTitle": "成瀨"
				},
				{
					"id": 120200520,
					"content": "卻沒想到，被愚人眾打劫了！我也很為難啊。風裡來雨裡去的，貨被搶了還要被你們盤問…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200521
					],
					"speakerTitle": "成瀨"
				},
				{
					"id": 120200521,
					"content": "哼，誰知道你說的是不是真的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200522,
						120200523
					],
					"speakerTitle": "內村"
				},
				{
					"id": 120200522,
					"content": "我們來的路上…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120200524
					]
				},
				{
					"id": 120200524,
					"content": "那也不能證明他的貨就是被愚人眾拿走的啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200525
					],
					"speakerTitle": "內村"
				},
				{
					"id": 120200525,
					"content": "再說了，天領奉行和愚人眾還有勾結呢！你的貨給愚人眾，和給天領奉行有什麼區別？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200526
					],
					"speakerTitle": "內村"
				},
				{
					"id": 120200526,
					"content": "啊？天領奉行勾結愚人眾？這是哪來的消息，我完全不知道！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200527
					],
					"speakerTitle": "成瀨"
				},
				{
					"id": 120200527,
					"content": "再說，就算他們有勾結，也不關我的事吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200528
					],
					"speakerTitle": "成瀨"
				},
				{
					"id": 120200528,
					"content": "戰爭都已經結束了，天領奉行還會繼續勾結愚人眾嗎？嗯…我覺得不像呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200529
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120200529,
					"content": "不久之前我們還見了九條家的名代，現在的他應該不會做這種事吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200530
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120200530,
					"content": "不過剛剛來的路上，那些士兵好像也在討論這件事…心海，妳知道什麼嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200531
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120200531,
					"content": "確實聽到了這樣的彙報。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200532
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120200532,
					"content": "再過不久，就是我們與天領奉行之間的和談了。這次和談是神里家組織的，選在一處中立地點舉辦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200533
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120200533,
					"content": "我和九條裟羅會各帶一些侍衛，好好商討一下關於未來的計畫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200534
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120200534,
					"content": "但是在這樣一個重要的時刻，我卻聽到一些傳聞，九條家與愚人眾很可能還有勾結，他們想徹底覆滅海祇島。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200535
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120200535,
					"content": "如果是這樣的話，和談就可能是陷阱，甚至連神里家都可能參與其中…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200536
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120200536,
					"content": "這位商人先生，你確定你的貨物，是被愚人眾劫走的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200537
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120200537,
					"content": "是真的，我沒有騙你們！愚人眾搶了我的貨物就往那邊跑了，他們很可能在那邊有秘密基地！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200538
					],
					"speakerTitle": "成瀨"
				},
				{
					"id": 120200538,
					"content": "那好，事關重大，不如我們幫你把貨物找回來。如果一切順利，自然可以還你清白。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200539
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120200539,
					"content": "但如果真的有什麼情況，證明愚人眾和天領奉行有所勾結的話，還希望你配合我們調查，這樣如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200540
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120200540,
					"content": "我沒意見，多謝珊瑚宮大人出手相助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200541
					],
					"speakerTitle": "成瀨"
				},
				{
					"id": 120200541,
					"content": "松田、內村，你們呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200542
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120200542,
					"content": "全聽珊瑚宮大人吩咐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200543
					],
					"speakerTitle": "松田"
				},
				{
					"id": 120200543,
					"content": "#那就好。{NICKNAME}…不，劍魚小隊二番隊隊長，能請{F#妳}{M#你}和我一起調查此事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200544,
						120200547
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120200544,
					"content": "當然可以。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120200545
					]
				},
				{
					"id": 120200545,
					"content": "#呵呵…那就讓我看看，這段時間{F#妳}{M#你}有沒有新的成長。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200546
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120200546,
					"content": "#我也會教{F#妳}{M#你}一些我擅長的東西…跟我來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120200547,
					"content": "遵命！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120200548
					]
				},
				{
					"id": 120200548,
					"content": "呵呵…不用這麼嚴肅啦。不管以後如何，現在是和平時期。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200549
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120200549,
					"content": "#而且{F#妳}{M#你}也不會一直留在海祇島…雖然還維持著這樣的稱呼，但我們像朋友一樣就好啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120200523,
					"content": "剛剛確實遇到了愚人眾…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120200524
					]
				}
			]
		},
		{
			"id": 1202006,
			"completionStepIds": [
				1202009
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1202009",
							"2"
						],
						"stepId": 1202009,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"五郎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120200601,
					"content": "這裡應該就是我們和心海相約見面的地方了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120200602,
					"content": "#旅行者，{F#妳}{M#你}還記得這裡嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200603
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120200603,
					"content": "上次來海祇島的時候，我們好像路過這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120200604,
					"content": "#當時，{F#妳}{M#你}還當上了「劍魚二番隊」的隊長。不知道過了這麼久，反抗軍的士兵們還記不記得{F#妳}{M#你}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120200605,
					"content": "海祇島上應該也有很多變化吧！不如我們先去附近晃晃如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200627
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120200627,
					"content": "欸，那不是五郎嗎？我們過去看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120200606,
					"content": "「敵眾我寡，尋求突破；敵寡我眾，務求全勝…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200607
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 120200607,
					"content": "「臨海之盜，必有運船；焚船而戰，可得全功…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200608
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 120200608,
					"content": "五郎大人，有結論了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200609
					],
					"speakerTitle": "利彥"
				},
				{
					"id": 120200609,
					"content": "嗯。根據珊瑚宮大人留下的錦囊，可以推斷出愚人眾必定有船停泊在附近，所以才如此囂張。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200610
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 120200610,
					"content": "我們可以分成兩隊，一隊吸引他們的注意，另一隊繞到後方燒掉他們的船，這樣他們就逃不掉了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200611
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 120200611,
					"content": "但珊瑚宮大人也說，兵力不足的情況下，盡量不要分兵。否則很容易被各個擊破，導致全線崩潰…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200612
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 120200612,
					"content": "要不然，我回去求援？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200613
					],
					"speakerTitle": "幸德"
				},
				{
					"id": 120200613,
					"content": "恐怕來不及。看他們的動向，應該是準備離開了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200614
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 120200614,
					"content": "珊瑚宮大人的錦囊裡還寫了，「設伏於野，不可妄動」。既然這次兵力不夠，就只能暫時放棄了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200615
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 120200615,
					"content": "難道要眼睜睜地看著這些傢伙離開嗎？我不甘心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200616
					],
					"speakerTitle": "利彥"
				},
				{
					"id": 120200616,
					"content": "其實，珊瑚宮大人的錦囊裡還有一句「山窮水盡，或有援軍」。不過我沒懂，援軍指的是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200617
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 120200617,
					"content": "五郎，你們怎麼在這裡呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200618
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120200618,
					"content": "#隊長！{F#妳}{M#你}回海祇島了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200619
					],
					"speakerTitle": "幸德"
				},
				{
					"id": 120200619,
					"content": "來助你們一臂之力。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120200620
					]
				},
				{
					"id": 120200620,
					"content": "#太好了！珊瑚宮大人的錦囊果然沒錯…{NICKNAME}，{F#妳}{M#你}來得正好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200621
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 120200621,
					"content": "最近愚人眾殘黨異常活躍，這次我們察覺到了他們的動向，提前埋伏在這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200622
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 120200622,
					"content": "#可惜我們人數不夠，無法兵分兩路…能拜託{F#妳}{M#你}幫忙牽制嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200623
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 120200623,
					"content": "好吧。說不定愚人眾又要幹什麼壞事，我們也不能放任不管。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200624
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120200624,
					"content": "#好！事不宜遲，我帶人繞到後方燒毀他們的船，之後回來與{F#妳}{M#你}會合。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200625
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 120200625,
					"content": "務必小心，我們很快就回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200626
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 120200626,
					"content": "看來反抗軍的大家都還記得我們呢！我們也幫他們好好解決一下眼前的麻煩吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
