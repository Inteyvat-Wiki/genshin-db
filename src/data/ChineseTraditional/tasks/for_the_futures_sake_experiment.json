				"objectNames": [
					"弗雷瑞斯",
					"謝妮"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 745120101,
					"content": "從實驗資料來看，這次的發明也圓滿完成了。謝謝兩位幫忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120102
					],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 745120102,
					"content": "多謝啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120103
					],
					"speakerTitle": "謝妮"
				},
				{
					"id": 745120103,
					"content": "#{F#妳}{M#你}看，我就說會順利吧。畢竟弗雷瑞斯前輩是這方面的天才，區區一個遠距離操控炮臺，做起來鐵定是輕輕鬆鬆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120104
					],
					"speakerTitle": "謝妮"
				},
				{
					"id": 745120104,
					"content": "是、是啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120105
					],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 745120105,
					"content": "那抓緊時間，開始做下一個發明吧！正好我有個很有興趣的東西！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120106
					],
					"speakerTitle": "謝妮"
				},
				{
					"id": 745120106,
					"content": "什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120107
					],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 745120107,
					"content": "可以探索天空的浮空艇怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120108
					],
					"speakerTitle": "謝妮"
				},
				{
					"id": 745120108,
					"content": "呃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120109
					],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 745120109,
					"content": "或者能挖掘地底深處的超級鑽頭？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120110
					],
					"speakerTitle": "謝妮"
				},
				{
					"id": 745120110,
					"content": "哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120111
					],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 745120111,
					"content": "感覺她在刁難弗雷瑞斯呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745120112,
					"content": "很難做到吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745120113
					]
				},
				{
					"id": 745120113,
					"content": "拒絕了楓丹科學院三次的弗雷瑞斯前輩，肯定有辦法做出這些科學院做不出來的東西吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120114
					],
					"speakerTitle": "謝妮"
				},
				{
					"id": 745120114,
					"content": "那當然了。只能說…稍微有點棘手，不過沒什麼大問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120115
					],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 745120115,
					"content": "唉，不過我突然又不想要這些了。飛到天上或者鑽到地裡，想一想也很無聊——天上很冷、地下很悶，沒什麼好玩的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120116
					],
					"speakerTitle": "謝妮"
				},
				{
					"id": 745120116,
					"content": "嗯，我也同意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120117
					],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 745120117,
					"content": "那弗雷瑞斯前輩可以做一個平常用得到的發明嗎？對了，我早上喜歡睡懶覺，可以請前輩幫我做個早餐自動烘焙機嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120118
					],
					"speakerTitle": "謝妮"
				},
				{
					"id": 745120118,
					"content": "這個聽起來倒是做得到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745120119,
					"content": "她之前是故意的吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745120120
					]
				},
				{
					"id": 745120120,
					"content": "好，我先想想怎麼設計。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120121
					],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 745120121,
					"content": "好耶，那我就當你答應了喔。做不到的話，以後我的早餐就由弗雷瑞斯前輩本人來做好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120122
					],
					"speakerTitle": "謝妮"
				},
				{
					"id": 745120122,
					"content": "這是什麼要求…總之放心吧，這種小發明我一定做得出來。我可是這方面的「天才」啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "弗雷瑞斯"
				}
			]
		},
