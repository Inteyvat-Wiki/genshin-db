			"dialogs": [
				{
					"id": 401440201,
					"content": "這裡就是我們要開店的地方了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440202
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 401440202,
					"content": "哇，這麼多的準備，都是麗莎一個人做完的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401440203,
					"content": "這是騎士團的大家一起努力的成果哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440204
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 401440204,
					"content": "開店所需的啟動資金，是琴特意籌備的。煉製藥劑所需的藥材和裝置，得到了阿貝多和砂糖的支援。",
