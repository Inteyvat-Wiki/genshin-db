							14.928
						],
						"pointId": 238
					}
				]
			},
			"dialogs": [
				{
					"id": 401440101,
					"content": "#是{F#妳}{M#你}呀小可愛。今天怎麼有空過來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440102
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 401440102,
					"content": "是想看看書，還是看看姐姐我呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440103,
						401440105
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 401440103,
					"content": "來看看麗莎。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440104
					]
				},
				{
					"id": 401440104,
					"content": "#呵呵，{F#妳}{M#你}還是這麼貼心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440107
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 401440107,
					"content": "#不過今天有些不巧，我正好在處理一項工作，暫時沒法招待{F#妳}{M#你}們喝下午茶了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440108
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 401440108,
					"content": "哇，麗莎居然在認真工作，也太少見了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401440109,
					"content": "的確是呢，上次像這樣埋頭研究，好像還是在教令院的時候吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440110
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 401440110,
					"content": "久違地認真思考，還滿累人的呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440111,
						401440112
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 401440111,
					"content": "難道是在寫論文…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440113
					]
				},
				{
					"id": 401440113,
					"content": "#呵呵，看{F#妳}{M#你}這麼有興趣，要考慮加入進來嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440114
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 401440114,
					"content": "陪姐姐一起重溫學生時代如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440115
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 401440115,
					"content": "不要突然把工作塞給別人啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401440116,
					"content": "#{NICKNAME}不願意嗎？這可是難得的，跟姐姐一起攜手攻克難關的機會呀。順帶一提，報酬也會相當豐厚哦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440117,
						401440118
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 401440117,
					"content": "願聞其詳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440119
					]
				},
				{
					"id": 401440119,
					"content": "#{F#妳}{M#你}應該知道，騎士團一直在進行煉金術的相關研究。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440120
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 401440120,
					"content": "但是大多數的課題都在實驗室裡進行，民眾對煉金術的瞭解程度不是很高。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440121
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 401440121,
					"content": "這樣的結果就是，花了許多資金投入的研究課題，卻沒能產生更廣泛的作用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440122
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 401440122,
					"content": "於是，琴打算在普通民眾間推廣煉金術的成果…現階段來說，就是煉金藥劑哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440123
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 401440123,
					"content": "平時除了圖書館的事情，我也會幫忙管理騎士團的藥劑供應。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440124
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 401440124,
					"content": "再加上藥劑學是我以前的研究方向之一，在琴看來，我就成了這份工作最適合的人選。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440125
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 401440125,
					"content": "但要兼顧民眾的日常需求，就得對煉製的材料做一些調整，煉製的方式也要做適當簡化…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440126
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 401440126,
					"content": "一來二去，原以為簡單的課題，逐漸變得越來越複雜呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440127
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 401440127,
					"content": "難道說，是要我們幫忙研究嗎？可是煉金術的理論，我們瞭解得也不是很多呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401440128,
					"content": "#呵呵，不是的，姐姐已經想好了更適合{F#妳}{M#你}們的工作哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440129
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 401440129,
					"content": "雖然煉製技術的研究正在穩步推進，但如果不實際收集民眾的使用意見回饋，就沒辦法知道能不能滿足大家的需要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440130
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 401440130,
					"content": "可如果要一邊研發藥劑，一邊收集意見回饋，就需要效率更高的方式了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440131
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 401440131,
					"content": "我想到的辦法是，直接開一家售賣煉金藥劑的商店。這樣就能一邊煉製藥劑，一邊瞭解大家的日常需求了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440132
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 401440132,
					"content": "哦！把兩項工作合併成一項…不愧是麗莎能想出來的方法呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401440133,
					"content": "#是呀，而最適合這份工作的，當然就是我們騎士團的精銳——{NICKNAME}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440134
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 401440134,
					"content": "在教令院的時候，同學之間也會互相給對方的課題幫忙呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440135
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 401440135,
					"content": "小可愛難道不想體會一下這種青春洋溢的生活嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440136
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 401440136,
					"content": "說的好聽，其實還是想偷懶吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440137,
						401440139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401440137,
					"content": "就當是為了麗莎吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440138
					]
				},
				{
					"id": 401440138,
					"content": "#呵呵，我就知道{F#妳}{M#你}最可靠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440141
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 401440141,
					"content": "等工作告一段落，姐姐會親自準備報酬的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440142
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 401440142,
					"content": "店鋪的前期準備已經完成了，接下來的事情，我們直接到那邊再聊吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "麗莎"
				},
				{
					"id": 401440139,
					"content": "就當是挑戰一下自己。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440140
					]
				},
				{
					"id": 401440140,
					"content": "#嗯，{F#妳}{M#你}果然很有幹勁呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440141
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 401440118,
					"content": "要先看看是什麼事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440119
					]
				},
				{
					"id": 401440112,
					"content": "難道是在做課題…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440113
					]
				},
				{
					"id": 401440105,
					"content": "正好路過…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440106
					]
				},
				{
					"id": 401440106,
					"content": "順便來找我聊聊天嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440107
					],
					"speakerTitle": "麗莎"
				}
			]
		},
