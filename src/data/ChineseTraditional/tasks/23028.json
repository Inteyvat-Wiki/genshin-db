			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"雅絲敏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230280101,
					"content": "#旅行者，{F#妳}{M#你}們來得正好，我正在找人幫忙呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280102
					],
					"speakerTitle": "雅絲敏"
				},
				{
					"id": 230280102,
					"content": "是聖樹根系出問題了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230280103
					]
				},
				{
					"id": 230280103,
					"content": "聖樹現在的情況一切正常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280104
					],
					"speakerTitle": "雅絲敏"
				},
				{
					"id": 230280104,
					"content": "而我所要做的工作，就是讓它繼續正常下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280105
					],
					"speakerTitle": "雅絲敏"
				},
				{
					"id": 230280105,
					"content": "具體來說，我所要做的就是把這些藥水播撒到聖樹根系的周圍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280106
					],
					"speakerTitle": "雅絲敏"
				},
				{
					"id": 230280106,
					"content": "但這麼多藥水，我一個人搬不動，拉德普和法爾希也被工作纏住不能來幫忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280107
					],
					"speakerTitle": "雅絲敏"
				},
				{
					"id": 230280107,
					"content": "#所以，我就想要請{F#妳}{M#你}幫我搬運一下這些藥水。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280108,
						230280112
					],
					"speakerTitle": "雅絲敏"
				},
				{
					"id": 230280108,
					"content": "拉德普和法爾希是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230280109
					]
				},
				{
					"id": 230280109,
					"content": "他們和我一樣是學生，不過拉德普屬於悉般多摩學院，而法爾希屬於刹訶伐羅學院。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280110
					],
					"speakerTitle": "雅絲敏"
				},
				{
					"id": 230280110,
					"content": "我們有一個共同的課題，雖然我們之間的理念不同，但目前正在合作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280111
					],
					"speakerTitle": "雅絲敏"
				},
				{
					"id": 230280111,
					"content": "這些藥水，就是我們合作的成果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280113
					],
					"speakerTitle": "雅絲敏"
				},
				{
					"id": 230280113,
					"content": "#嗯，我搬著這一罐，其餘的就拜託{F#妳}{M#你}幫忙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280114
					],
					"speakerTitle": "雅絲敏"
				},
				{
					"id": 230280114,
					"content": "搬運的時候可要小心了，拉德普說，為了防止人誤食這種藥水，他特意把藥水做得很難聞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280115
					],
					"speakerTitle": "雅絲敏"
				},
				{
					"id": 230280115,
					"content": "要是讓藥水沾在衣服上，那個難聞的氣味可是很久都洗不掉的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雅絲敏"
				},
				{
					"id": 230280112,
					"content": "那我們就出發吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230280113
					]
				}
			]
		},
		{
			"id": 2302804,
			"completionStepIds": [
				2302804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2302804",
							"2"
						],
						"stepId": 2302804,
						"stateName": "QUEST_STATE_UNFINISHED"
