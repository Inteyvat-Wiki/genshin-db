			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿萬",
					"雅絲敏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230280401,
					"content": "雅絲敏？妳怎麼在這，呃…妳是不是又要來撒妳那個藥水了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280402
					],
					"speakerTitle": "阿萬"
				},
				{
					"id": 230280402,
					"content": "那段根系看起來一切正常，沒有什麼問題啊，不需要再撒那種藥水了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280403
					],
					"speakerTitle": "阿萬"
				},
				{
					"id": 230280403,
					"content": "就算是這樣，也應該細心照料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280404
					],
					"speakerTitle": "雅絲敏"
				},
				{
					"id": 230280404,
					"content": "如果等到問題出現後才想辦法，那就像是做魚卷時，明明卷好了餅，卻發現魚肉沒有煮熟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280405
					],
					"speakerTitle": "雅絲敏"
				},
				{
					"id": 230280405,
					"content": "無論是重新做，還是拆開捲好的餅，都是一件很麻煩的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280406
					],
					"speakerTitle": "雅絲敏"
				},
				{
					"id": 230280406,
					"content": "我真是說不過妳…但我上次也和妳提到過那個藥水的味道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280407
					],
					"speakerTitle": "阿萬"
				},
				{
					"id": 230280407,
					"content": "我就住在這附近，可不想聞著那股怪味入睡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280408
					],
					"speakerTitle": "阿萬"
				},
				{
					"id": 230280408,
					"content": "放心吧，我已經讓拉德普修改過藥水的配方了，味道不會很刺激的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280409
					],
					"speakerTitle": "雅絲敏"
				},
				{
					"id": 230280409,
					"content": "唉，好吧。我先走了啊，妳可別來我家院子裡撒那種藥水，我可受不了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280410
					],
					"speakerTitle": "阿萬"
				},
				{
					"id": 230280410,
					"content": "好啦，我知道了。旅行者，把那個箱子裡的藥水遞給我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280411
					],
					"speakerTitle": "雅絲敏"
				},
				{
					"id": 230280411,
					"content": "和雅絲敏一起播撒了藥水…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230280412
					]
				},
				{
					"id": 230280412,
					"content": "這藥水的味道可真是難聞…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230280413,
					"content": "妳好像沒什麼感覺？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230280414
					]
				},
				{
					"id": 230280414,
					"content": "#如果{F#妳}{M#你}說的是氣味方面的話…我接觸過很多比這藥水還難聞的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280415
					],
					"speakerTitle": "雅絲敏"
				},
				{
					"id": 230280415,
					"content": "這樣就可以了，我也記錄了很多資料，法爾希一定會很高興的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280416
					],
					"speakerTitle": "雅絲敏"
				},
				{
					"id": 230280416,
					"content": "#這些報酬給{F#妳}{M#你}，旅行者，謝謝{F#妳}{M#你}一路幫忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280417
					],
					"speakerTitle": "雅絲敏"
				},
				{
					"id": 230280417,
					"content": "也不知道拉德普和法爾希工作得怎麼樣了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雅絲敏"
				}
			]
		},
