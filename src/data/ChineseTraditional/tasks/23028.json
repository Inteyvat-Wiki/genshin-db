			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"雅絲敏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230280501,
					"content": "雅絲敏姐姐！嗚哇！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280502
					]
				},
				{
					"id": 230280502,
					"content": "我，我要呼吸不過來了，我們快離開這裡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280503
					]
				},
				{
					"id": 230280503,
					"content": "這是什麼…咳，咳咳！什麼氣味…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230280504,
					"content": "看來拉德普的工作做得不錯嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280505
					],
					"speakerTitle": "雅絲敏"
				},
				{
					"id": 230280505,
					"content": "這裡已經播撒完了，我們去下一個地方吧。就在附近，不用走多遠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雅絲敏"
				}
			]
		}
	]
