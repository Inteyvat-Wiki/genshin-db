				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"志瓊"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710440901,
					"content": "我們回來啦！三處「磐鍵」全都破壞掉了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440902
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710440902,
					"content": "噓…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440903
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710440903,
					"content": "……？突然怎麼了…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440904,
						710440905
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710440904,
					"content": "發生什麼事了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710440907
					]
				},
				{
					"id": 710440907,
					"content": "#不要大驚小怪的…！沒什麼…只是大地在震動。或許是因為封印鬆動，附近的山岩也開始變得不穩定了…{F#妳}{M#你}有感覺到嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440908
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710440908,
					"content": "完全沒有欸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440909,
						710440911
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710440909,
					"content": "妳一直飛著，當然感覺不到。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710440910
					]
				},
				{
					"id": 710440910,
					"content": "#{F#妳}{M#你}說得很有道理…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440912
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710440912,
					"content": "#礦工的直覺而已…如果{F#妳}{M#你}從小在礦上長大，也會對山石的語言略通一二的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440913
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710440913,
					"content": "等等…小心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440914
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710440914,
					"content": "哇呀！地面震動得好厲害！站都站不穩了！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440915,
						710440916
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710440915,
					"content": "妳本來也沒有在站著！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710440917
					]
				},
				{
					"id": 710440917,
					"content": "嗚哇…！欸…地震…停下來了…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440918
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710440918,
					"content": "呼…應該是結束了。幸好我們都在地面上，如果是在礦道裡遇到這樣的地震可就慘了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440919
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710440919,
					"content": "希望沐寧他們別把地震怪到我們頭上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440920
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710440920,
					"content": "現在封印陣法的力量已經大大減弱，只剩最後一處「磐鍵」需要解決了。我們一起去吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710440916,
					"content": "怎會如此！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710440917
					]
				},
				{
					"id": 710440911,
					"content": "我也沒有。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710440912
					]
				},
				{
					"id": 710440905,
					"content": "附近有敵人嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710440906
					]
				},
				{
					"id": 710440906,
					"content": "欸？敵人？！在哪裡呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440907
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7104413,
			"completionStepIds": [],
