						710440807
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710440807,
					"content": "#等{F#妳}{M#你}解除其餘三處，再回來找我吧，最後一處我們再一起想想辦法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440808
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710440808,
					"content": "妳不一起來嗎?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710440809
					]
				},
				{
					"id": 710440809,
					"content": "這次還是不了…本來被委託了看守倉庫的工作，結果一時疏忽，差點讓盜寶團趁虛而入…我已經要感謝前輩不上報之恩了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440810
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710440810,
					"content": "萬一再被沐寧那傢伙抓住摸魚的話可就不得了啦，至少這段時間我得回去看守倉庫才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440811
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710440811,
					"content": "不過我相信，這點問題即使靠兩位前輩也是能解決的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710440803,
					"content": "「七星」不會追究嗎…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710440804
					]
				}
			]
		},
		{
			"id": 7104409,
			"completionStepIds": [
				7104421
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7104421",
							"2"
						],
						"stepId": 7104421,
						"stateName": "QUEST_STATE_UNFINISHED"
