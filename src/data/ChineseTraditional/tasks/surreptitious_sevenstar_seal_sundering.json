			},
			"dialogs": [
				{
					"id": 710442001,
					"content": "要是真明白了我的話，就請不要在這裡晃來晃去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710442002
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710442002,
					"content": "否則…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710442003
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710442003,
					"content": "否則…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710442004
					]
				},
				{
					"id": 710442004,
					"content": "唉，沒什麼否則的。我能做的，最多就是寫寫週報罷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710442005
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710442005,
					"content": "週報？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710442006
					]
				},
				{
					"id": 710442006,
					"content": "一些麻煩、沒什麼意義，但是又不得不寫的文書。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710442007
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710442007,
					"content": "那就不寫？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710442008
					]
				},
				{
					"id": 710442008,
					"content": "#那可不行，至少像是{F#妳}{M#你}出現在這裡的消息，總是要寫進去的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710442009
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710442009,
					"content": "#上次提交報告是昨天，也就是說，再過不了幾天，總務司的人就會知道{F#妳}{M#你}在這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710442010
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710442010,
					"content": "#到時候，說不定就會有人過來，強行把{F#妳}{M#你}帶出去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710442011
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710442011,
					"content": "#所以呢，在那之前，{F#妳}{M#你}還可以自由行動，明白了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710442012
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710442012,
					"content": "明白了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710442013
					]
				},
				{
					"id": 710442013,
					"content": "#明白了就好…哼，如果不是看在{F#妳}{M#你}為璃月立過大功的面子上…算了算了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "沐寧"
				}
			]
		}
	]
