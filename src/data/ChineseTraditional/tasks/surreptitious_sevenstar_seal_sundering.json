				"points": []
			},
			"dialogs": [
				{
					"id": 710441301,
					"content": "#欸，是{F#妳}{M#你}呀！{F#妳}{M#你}好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710441302
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710441302,
					"content": "是沐寧介紹我來的，這裡是他的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710441303
					]
				},
				{
					"id": 710441303,
					"content": "#哈哈，別管那紙條啦！我早認出{F#妳}{M#你}來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710441304
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710441304,
					"content": "他呀，天天就喜歡給人擺架子，開單據，什麼小事都要跑流程…顯得自己是個什麼大人物一樣。我可不管那個…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710441305
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710441305,
					"content": "#畢竟{NICKNAME}的大名早就傳遍冒險家協會了；更不用提{F#妳}{M#你}為璃月做的一切，我們都看在眼裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710441306,
						710441307
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710441306,
					"content": "我有這麼出名嗎…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710441309
					]
				},
				{
					"id": 710441309,
					"content": "#那是當然，協會的許多新人冒險家都聽霞姐講過{F#妳}{M#你}在龍脊雪山的探險故事——嘿嘿，也包括我在內啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710441310
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710441310,
					"content": "穿越雪暴在寒冬極境之中開闢通路，在冰霜之下發掘被遺忘的古王國，登上險峻峰頂，以肉體凡軀直面宏偉無情的異變…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710441311
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710441311,
					"content": "#真的，{NICKNAME}前輩經歷的事件也好，克服的障礙也好，發掘的真相也好，終歸一句話…這才叫冒險！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710441312,
						710441314
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710441312,
					"content": "我喜歡！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710441313
					]
				},
				{
					"id": 710441313,
					"content": "哇…我都有點暈頭轉向了…我們真的有那麼厲害？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710441316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710441316,
					"content": "哈哈，更不用說兩位在群玉閣上大戰海魔的事蹟…雖然我沒有現場目睹，但評書我可一場都沒落下過！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710441314,
					"content": "請給我指北針。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710441315
					]
				},
				{
					"id": 710441315,
					"content": "#喂，{F#妳}{M#你}也太不經誇了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710441316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710441307,
					"content": "不愧是我。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710441308
					]
				},
				{
					"id": 710441308,
					"content": "#不愧是傳說中的{NICKNAME}和派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710441309
					],
					"speakerTitle": "派蒙"
				}
			]
		},
