	"talks": [
		{
			"id": 7104406,
			"completionStepIds": [
				7104406
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7104406",
							"2"
						],
						"stepId": 7104406,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"志瓊"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710440601,
					"content": "原來還有講我們的評書呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710440602,
					"content": "那是當然，在城裡很流行呢！我吧，覺得茶博士和田鐵嘴他們各有各的特點，只是我更喜歡田…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440603,
						710440604
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710440603,
					"content": "咳咳…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710440605
					]
				},
				{
					"id": 710440605,
					"content": "哈哈，我明白的，我明白的，不是每個人都能接受田鐵嘴的風格，我有時候也覺得他說書的用詞造句有點太俗俚了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440606
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710440606,
					"content": "#但是茶博士說書呢，他慢熱，{F#妳}{M#你}明白吧？有時候一個故事捂上兩個時辰才覺出味道來，有人喜歡這個，我是覺得沒意思…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440607
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710440607,
					"content": "#{F#妳}{M#你}說這幸好是故事，不怕會變質對吧？這要是什麼吃的喝的，裹個包袱捂半天不給抖開，那不是早就臭了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440608,
						710440611
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710440608,
					"content": "咳咳…！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710440609
					]
				},
				{
					"id": 710440609,
					"content": "#{F#妳}{M#你}沒事吧，嗓子不舒服嗎…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440610
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710440610,
					"content": "唔，也沒有啦…就是突然接受了太多資訊，腦子有點不舒服…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440613
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710440613,
					"content": "#啊…這樣啊，不好意思。實在有點太興奮了，自顧自說了好多，也沒有顧及{F#妳}{M#你}們的感受，嘿嘿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440614
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710440614,
					"content": "#不過{NICKNAME}這次來到這裡，是受七星的委託嗎？沐寧有沒有向{F#妳}{M#你}們透露別的什麼資訊？嗯，比如說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440615
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710440615,
					"content": "#「千萬不要接近『磐鍵』！」、「層岩巨淵下面什麼也沒有！」、「志瓊這個人不會幫{F#妳}{M#你}們的！」這種話？而且反覆強調？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440616
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710440616,
					"content": "沐寧確實有這樣說過。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710440617
					]
				},
				{
					"id": 710440617,
					"content": "哼哼，他可嚇不住我們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440618
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710440618,
					"content": "#嘿嘿，他沒有在嚇唬{F#妳}{M#你}們啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440619
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710440619,
					"content": "欸——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440620,
						710440621
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710440620,
					"content": "所以他說的都是真的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710440622
					]
				},
				{
					"id": 710440622,
					"content": "咳咳，是這樣的。沐寧畢竟是總務司的專員，即使想要請求幫助，也是有很多事情不方便在公開場合透露。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440623
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710440623,
					"content": "#所以呢，就只能用「警告」這種方法，變相地把進入層岩巨淵的方式告訴{F#妳}{M#你}。他說的「{F#妳}{M#你}不應該」，理解成「{F#妳}{M#你}可以」就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440624
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710440624,
					"content": "哼…真是個彆扭的傢伙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440625
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710440625,
					"content": "#況且{F#妳}{M#你}也提到，他給{F#妳}{M#你}開了許可字條，讓{F#妳}{M#你}來找我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440626
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710440626,
					"content": "#{F#妳}{M#你}手上的字條，就意味著在層岩巨淵暢通無阻的權利。當然啦，前提是七星不會親自干涉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440627
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710440627,
					"content": "#而他建議{F#妳}{M#你}來找我呢，就意味著讓我告訴{F#妳}{M#你}進入層岩巨淵深處的方法！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440628
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710440628,
					"content": "欸——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440629,
						710440630
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710440629,
					"content": "沐寧這傢伙…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710440631
					]
				},
				{
					"id": 710440631,
					"content": "哈哈，事先如此遮遮掩掩真是不好意思，不過我們是有充分理由的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440632
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710440632,
					"content": "層岩巨淵下面挖到的那個「東西」實在非比尋常，調查活動不可大操大辦，否則會令群眾恐慌…這是七星的指令。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440633
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710440633,
					"content": "所以我們就只能在禁入令的掩護下，秘密招募探險家和學者進入層岩巨淵進行調查了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440634
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710440634,
					"content": "如有必要的話，或許可以做點什麼，緩解地下蠢蠢欲動的危機。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440635
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710440635,
					"content": "所以營地裡那些人都是…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710440636
					]
				},
				{
					"id": 710440636,
					"content": "沒錯，他們都是來輔助勘探隊工作的。都是些可靠的前輩…大部分吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440637
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710440637,
					"content": "#{F#妳}{M#你}之所以來到這裡也絕非偶然，七星裡不止一位大人物已經指名推薦{F#妳}{M#你}前來幫忙了，我們沒有不從命的道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440638
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710440638,
					"content": "況且，兩位前輩比較容易以利誘之…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440639
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710440639,
					"content": "欸…那不就是說我們好騙嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440640,
						710440642
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710440640,
					"content": "派蒙，我們走！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710440641
					]
				},
				{
					"id": 710440641,
					"content": "哼，別想把我們當笨蛋耍！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440644
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710440644,
					"content": "請留步呀！我只是轉述大人的話而已！是她這樣說的，不是我！我這就收回那句話！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440645,
						710440646
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710440645,
					"content": "告辭！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710440647
					]
				},
				{
					"id": 710440647,
					"content": "請兩位想想七星的酬謝，一定不會少的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440648,
						710440650
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710440648,
					"content": "我又不缺摩拉。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710440649
					]
				},
				{
					"id": 710440649,
					"content": "我也…！唔…我倒是不嫌摩拉多啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440652
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710440652,
					"content": "咳咳…如果能夠以任何措施緩解層岩巨淵的安全風險，在地下尋到的財物與寶藏便可全歸發現者所有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440653
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710440653,
					"content": "這是七星的大人們議定的特別許可權，只限此時，只限此地，只限兩位前輩享有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440654
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710440654,
					"content": "哇！真的嗎！妳可不要騙我們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440655,
						710440657
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710440655,
					"content": "既然如此…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710440656
					]
				},
				{
					"id": 710440656,
					"content": "有寶藏喔，有寶藏喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440659
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710440659,
					"content": "哈哈，好啦好啦…所以說，前輩會接受這個委託嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440660,
						710440663
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710440660,
					"content": "好吧…看在寶藏的面子上。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710440661
					]
				},
				{
					"id": 710440661,
					"content": "好耶！新的寶藏！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440662
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710440662,
					"content": "好耶！新的冒險！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440665
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710440665,
					"content": "實在不好意思，耽擱了兩位前輩這麼多時間，閒扯了些沒用的東西…我們這就開始張羅正事吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440666
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710440666,
					"content": "如果想要進入層岩巨淵，我們首先需要找到「流明石」製成的觸媒，有這個東西才能在下面的黑暗中行動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440667
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710440667,
					"content": "只有「神之眼」持有者才能妥善利用觸媒，不過前輩即使沒有神之眼也能夠將元素力驅動自如，使用觸媒大概也沒什麼問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440668
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710440668,
					"content": "我們要去哪裡尋找觸媒？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710440669
					]
				},
				{
					"id": 710440669,
					"content": "就放在南邊的倉庫裡，倉庫看守完備，很安全的。取回來以後找我就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710440663,
					"content": "好吧…看在派蒙的面子上。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710440664
					]
				},
				{
					"id": 710440664,
					"content": "哼哼，我的面子還挺大的嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440665
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710440657,
					"content": "又是派蒙的「哇寶藏！」時間…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710440658
					]
				},
				{
					"id": 710440658,
					"content": "#{F#妳}{M#你}看嘛…畢竟層岩巨淵這麼大…有多少寶藏給我們隨便拿呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440659
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710440650,
					"content": "沒有再貼一次尋人啟事的必要了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710440651
					]
				},
				{
					"id": 710440651,
					"content": "#那{F#妳}{M#你}要求些別的不就好啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440652
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710440646,
					"content": "哼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710440647
					]
				},
				{
					"id": 710440642,
					"content": "這樣啊，再見。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710440643
					]
				},
				{
					"id": 710440643,
					"content": "欸…？不問問他們會拿什麼利來誘我們嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440644
					],
					"speakerTitle": "派蒙"
				},
