				"points": []
			},
			"dialogs": [
				{
					"id": 200250101,
					"content": "#旅行者，{F#妳}{M#你}，{F#妳}{M#你}來得正好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200250102
					],
					"speakerTitle": "懷爾德"
				},
				{
					"id": 200250102,
					"content": "我本來是要把這車貨送去蒙德城。昨天晚上走到這裡的時候，看見了幾團亮亮的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200250103
					],
					"speakerTitle": "懷爾德"
				},
				{
					"id": 200250103,
					"content": "因為喝得太多，我…我突然很想去看看那是什麼，過去了之後，卻發現是一大堆史萊姆，我還被狠狠撞了幾下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200250104
					],
					"speakerTitle": "懷爾德"
				},
				{
					"id": 200250104,
					"content": "我很害怕，但是又找不到方向，跑了半天才回到了車旁邊。今天早上，我發現我的<color=#00E1FFFF>鑰匙</color>不見了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200250105
					],
					"speakerTitle": "懷爾德"
				},
				{
					"id": 200250105,
					"content": "#{F#妳}{M#你}能幫我找找嗎？肯定就在這周圍，我覺得…肯定就在旁邊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200250106,
						200250108
					],
					"speakerTitle": "懷爾德"
				},
				{
					"id": 200250106,
					"content": "好的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200250107
					]
				},
				{
					"id": 200250107,
					"content": "太好了，這麼大片地方，我都不知道從何下手了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "懷爾德"
				},
				{
					"id": 200250108,
					"content": "還有別的急事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200250109
					]
				},
				{
					"id": 200250109,
					"content": "#這麼大片地方，我該從哪裡下手啊，這件事只有{F#妳}{M#你}能辦到，拜託了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "懷爾德"
				}
			]
		},
