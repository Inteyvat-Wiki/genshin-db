			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"菲利斯·尤格",
					"斯萬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705140101,
					"content": "蒙德的熱情真是超乎我想像…真是名不虛傳，就連那些丘丘人也這麼有活力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140102
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140102,
					"content": "無論如何…尤格先生，請您千萬不要再自己外出了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140103
					],
					"speakerTitle": "斯萬"
				},
				{
					"id": 705140103,
					"content": "什麼？那我的機關怎麼辦，還差…呃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140104
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140104,
					"content": "一、二、三…十八個…十九個部件啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140105
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140105,
					"content": "已經有冒險家在幫您找了，您就安安心心在城裡等著吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140106
					],
					"speakerTitle": "斯萬"
				},
				{
					"id": 705140106,
					"content": "但沒有那些機關，我的…我的靈感，你知道嗎？我的靈感來了怎麼辦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140107
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140107,
					"content": "靈感稍縱即逝啊，就像…就像喝完酒打出的嗝一樣，稍縱即逝啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140108
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140108,
					"content": "喔，這個比喻不錯，我得記下來，澤維爾一定會喜歡的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140109
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140109,
					"content": "我…您…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140110
					],
					"speakerTitle": "斯萬"
				},
				{
					"id": 705140110,
					"content": "咦？榮譽騎士…太好了，榮譽騎士！請您快些過來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140111,
						705140112
					],
					"speakerTitle": "斯萬"
				},
				{
					"id": 705140111,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140113
					]
				},
				{
					"id": 705140113,
					"content": "我介紹一下，這位是來自楓丹廷的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140114
					],
					"speakerTitle": "斯萬"
				},
				{
					"id": 705140114,
					"content": "空想家！我們這麼稱呼自己！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140115
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140115,
					"content": "…尤格先生，這位是我們蒙德城的榮譽騎士…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140116
					],
					"speakerTitle": "斯萬"
				},
				{
					"id": 705140116,
					"content": "啊哈！尤格，菲利斯·尤格！向您致敬，榮譽騎士！我早就聽聞過您的諸多事蹟了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140117
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140117,
					"content": "你認識我？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140118
					]
				},
				{
					"id": 705140118,
					"content": "當然，當然！我當然認識您了，誰能不認識您呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140119
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140119,
					"content": "您之前在蒙德和風龍戰鬥的那段事蹟，可是在《蒸汽鳥日報》的頭條上占了足足三週啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140120
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140120,
					"content": "哈哈哈，那幫記者如果知道我正在和您談話，一定會嫉妒到睡不著的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140121,
						705140124
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140121,
					"content": "《蒸汽鳥日報》是什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140122
					]
				},
				{
					"id": 705140122,
					"content": "您不知道嗎？《蒸汽鳥日報》是楓丹廷的一家…嗯…知名度頗高的報紙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140123
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140123,
					"content": "而您，曾經幫他們攀上了銷量最高點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140125
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140125,
					"content": "頭、頭條？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140126
					]
				},
				{
					"id": 705140126,
					"content": "那當然，您可是曾經幫他們攀上了銷量最高點啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140127
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140127,
					"content": "頭版頭條、整刊篇幅、專家訪談，還搭配最好的手繪插圖，哈！他們都賺瘋了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140128
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140128,
					"content": "那…旅行者，菲利斯·尤格先生，你們先聊，我…呃…我先去處理點別的事，先失陪了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140129
					],
					"speakerTitle": "斯萬"
				},
				{
					"id": 705140129,
					"content": "斯萬飛快地離開了…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705140130
					]
				},
				{
					"id": 705140130,
					"content": "好吧，看來西風騎士團和我聽說的一樣，有著處理不完的事務…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140131
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140131,
					"content": "所以，你為什麼會來蒙德？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140132
					]
				},
				{
					"id": 705140132,
					"content": "我？事實上，我正計劃著遊歷提瓦特。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140133
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140133,
					"content": "而我遊歷的目的，則是要推銷我製造的這種「動械核心」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140134
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140134,
					"content": "簡單來說，它是一種發條式機關，只要隔段時間扭一扭發條，這種核心就能提供很長時間的動能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140135
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140135,
					"content": "為了展示這種機關，我還專門製作了一種以「動械核心」驅動的恆動型機關玩具，我將它命名為「恆動械畫」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140136
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140136,
					"content": "呃…不過很遺憾，雖然我很想向您展示這種機關…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140137
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140137,
					"content": "但這種機關實在是太出色，就連那些魔物也難抵它的魅力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140138
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140138,
					"content": "目前…我的機關正被魔物們不那麼友好地分成了無數塊，拿在手裡細細把玩呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140139
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140139,
					"content": "雖然我已經拜託了冒險家協會幫忙，但冒險家們也一直也沒給我點消息…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140140
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140140,
					"content": "榮譽騎士，如果您有興趣的話，能不能幫我這個忙？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140141
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140141,
					"content": "相信我，我的機關…和報酬，絕不會讓您失望的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140142
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140142,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140143
					]
				},
				{
					"id": 705140143,
					"content": "太棒了，您果然和報紙上寫的一樣，既是個實力強大的冒險家，又富有同情心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140144
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140144,
					"content": "可惜現在我們在蒙德，如果在楓丹廷，我一定要把《蒸汽鳥日報》的記者領到您這來，為您做個專訪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140145
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140145,
					"content": "他們一定會再次被您的魅力折服，心甘情願地把接下來三週的頭版和稿酬都留給您！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140124,
					"content": "頭版頭條、整刊篇幅、專家訪談，還搭配最好的手繪插圖，哈！他們都賺瘋了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140125
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140112,
					"content": "發生什麼事了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140113
					]
				}
			]
		},
		{
			"id": 7051403,
