			"dialogs": [
				{
					"id": 705140301,
					"content": "榮譽騎士！您回來了，零件的事怎麼樣了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140302
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140302,
					"content": "是這些嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7051404,
			"completionStepIds": [
				7051404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7051404",
							"2"
						],
						"stepId": 7051404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"菲利斯·尤格"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705140401,
					"content": "就是這些！就是這些！太棒了，我的零件，天呐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140402
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140402,
					"content": "既然零件已經找齊了，那接下來只要把這些零件組合起來就好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140403
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140403,
					"content": "唔…榮譽騎士，如果您有興趣的話，也可以來試試拼接這幅「恆動械畫」部件。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140404
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140404,
					"content": "相信我，這一定會很有趣的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菲利斯·尤格"
				}
			]
		},
