					"阿瑠"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722260301,
					"content": "#謝謝{F#妳}{M#你}們，{NICKNAME}{F#姐姐}{M#哥哥}、派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260302
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722260302,
					"content": "棲木的狀態很好，這回的祭典一定會很順利的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260303,
						722260304
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722260303,
					"content": "輕輕鬆鬆。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722260305
					]
				},
				{
					"id": 722260304,
					"content": "非常可怕。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722260305
					]
				},
				{
					"id": 722260305,
					"content": "#哼哼。再怎麼說，我和{NICKNAME}也是見識過很多東西的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722260306,
					"content": "#這麼說來，{NICKNAME}{F#姐姐}{M#哥哥}，{F#妳}{M#你}們是從哪裡來的呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260307
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722260307,
					"content": "#之前也有聽來的人說過「稻妻」、「鳴神島」之類的地方，{F#妳}{M#你}們也是稻妻人嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260308,
						722260312
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722260308,
					"content": "相對而言的話…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722260309
					]
				},
				{
					"id": 722260309,
					"content": "我們確實是從鳴神島來的呢…啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722260310,
					"content": "我都快忘了我們是來找木簧笛的了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722260311,
					"content": "我們是從很遠很遠的地方來的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722260312
					]
				},
				{
					"id": 722260312,
					"content": "的確呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722260313,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260314
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722260314,
					"content": "好厲害！還可以爬到龍的頭上！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260315,
						722260316
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722260315,
					"content": "雖然爬起來一點也不舒服就是了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722260317
					]
				},
				{
					"id": 722260316,
					"content": "還好啦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722260317
					]
				},
				{
					"id": 722260317,
					"content": "好厲害呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260318
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722260318,
					"content": "世界很大的哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722260319,
					"content": "沒想到「霧海」外面還有這麼多地方、這麼多人。如果有一天能出去，去看看這些地方就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260320
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722260320,
					"content": "別人總說，只要離開霧氣，靈魂就會迷失。因為有霧氣，所以外面的黑暗才不會侵入鶴觀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260321
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722260321,
					"content": "不過，我認識了很多外面來的人哦。所以我知道，寂海裡其實也是有人住的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260322
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722260322,
					"content": "有機會一起去看看吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722260323
					]
				},
				{
					"id": 722260323,
					"content": "嗯。那就說好了喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260324
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722260324,
					"content": "#{NICKNAME}{F#姐姐}{M#哥哥}，{F#妳}{M#你}們先走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260325
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722260325,
					"content": "等祭典結束以後，我們就一起到鶴觀以外的地方看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260326
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722260326,
					"content": "嗯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿瑠"
				}
			]
		},
