			"dialogs": [
				{
					"id": 706930101,
					"content": "所以說啊，我們都看出來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706930102
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 706930102,
					"content": "優菈最討厭的應該是那種…死板和迂腐寫在眉毛之間，一股勁鑽牛角尖，只知道在流程和細節上卡人的傢伙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706930103
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 706930103,
					"content": "說不定臉上還戴著單片眼鏡，手裡時常拿著一本書，但自己並沒有完全讀透，只是把它當成了裝飾品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706930104
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 706930104,
					"content": "如此一來，就顯得自己有股「老學派」的氣質，好像對話剛開始，就能在氣勢上壓人一頭！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706930105
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 706930105,
					"content": "啊，實在太精準了，我的腦袋裡都有畫面了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706930106
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 706930106,
					"content": "煙緋和…安柏？是之前完全沒見過的組合！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706930107,
						706930108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706930107,
					"content": "大家在聊什麼呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706930109
					]
				},
				{
					"id": 706930109,
					"content": "#啊呀，榮譽騎士和派蒙，{F#妳}{M#你}們來了啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706930110
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 706930110,
					"content": "我正在和煙緋商量方案呢——要不要替我們的遊藝加幾個「壞傢伙雪人」當成彩蛋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706930111
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 706930111,
					"content": "就像是魔物的靶子嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706930112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706930112,
					"content": "除了反派專業戶魔物，也可以有些不那麼傳統的形象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706930113
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 706930113,
					"content": "在選角的方向上，我和煙緋不謀而合的點子太多了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706930114,
						706930115
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 706930114,
					"content": "在這裡看到煙緋，有些驚喜。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706930116
					]
				},
				{
					"id": 706930116,
					"content": "說起來也滿神奇的，妳們真的站在一起的時候，我才發現，妳們一看就很合得來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706930117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706930117,
					"content": "#的確，能在蒙德遇見{NICKNAME}和派蒙，我也非常意外！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706930118
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 706930118,
					"content": "其實哦，我也不是第一次來蒙德了，之前在這邊幫忙處理過不少民事訴訟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706930119
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 706930119,
					"content": "這回，我剛和瑤瑤忙完，就碰上了「龍脊雪山國際越野賽」開幕，正好來看點新鮮的場面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706930120
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 706930120,
					"content": "結果，到會場問路時，我遇見了安柏，和安柏聊得很投緣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706930121
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 706930121,
					"content": "於是就來體驗一下安柏管理的遊戲，也幫忙出出主意！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706930122
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 706930122,
					"content": "嘿嘿，優菈的朋友，也是我的朋友，有趣的遊戲當然要一起享受啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706930123
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 706930123,
					"content": "榮譽騎士和派蒙也來試試看吧？為各國客人放鬆心情、釋放壓力的小遊戲「飛玉趣擲」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706930124
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 706930124,
					"content": "嗯！練習一下打雪仗的本領，說不定以後可以派上用場！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706930125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706930125,
					"content": "#而且，我和{NICKNAME}無聊的時候也可以玩，比一比誰比較厲害，輸的負責做飯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706930126,
						706930127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706930126,
					"content": "那我絕對不能錯過。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706930128
					]
				},
				{
					"id": 706930128,
					"content": "丟雪球和扔火球…乃至於各種元素的拋射物，都有共通之處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706930129
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 706930129,
					"content": "#對於{F#妳}{M#你}這位武藝天才來說，肯定不在話下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "煙緋"
				},
				{
					"id": 706930127,
					"content": "我丟雪球還滿準的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706930128
					]
				},
				{
					"id": 706930115,
					"content": "以前沒想過妳們碰面的場景。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706930116
					]
				},
				{
					"id": 706930108,
					"content": "優菈討厭的傢伙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706930109
					]
				}
			]
		}
	]
}