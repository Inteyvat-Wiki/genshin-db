				"objectNames": [
					"提米"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200480101,
					"content": "#哇啊！又是{F#妳}{M#你}！鴿子又全都飛走了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480102
					],
					"speakerTitle": "提米"
				},
				{
					"id": 200480102,
					"content": "#我還在餵牠們呢，{F#妳}{M#你}做什麼啊？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480103
					],
					"speakerTitle": "提米"
				},
				{
					"id": 200480103,
					"content": "抱歉。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200480104
					]
				},
				{
					"id": 200480104,
					"content": "媽媽說，歉意要用實際行動來表示。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480105
					],
					"speakerTitle": "提米"
				},
				{
					"id": 200480105,
					"content": "橋上的鴿子是我的好朋友，我一直在餵牠們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480106
					],
					"speakerTitle": "提米"
				},
				{
					"id": 200480106,
					"content": "但最近附近的鴨子們經常來搶食物吃，搞得牠們誰也吃不飽…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480107
					],
					"speakerTitle": "提米"
				},
				{
					"id": 200480107,
					"content": "#我想請{F#妳}{M#你}幫我找三份小麥來，幫我餵一下鴨子們，我也會在橋上把鴿子們也餵飽的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480108
					],
					"speakerTitle": "提米"
				},
				{
					"id": 200480108,
					"content": "都吃飽了之後，牠們一定會友好相處吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480109,
						200480110
					],
					"speakerTitle": "提米"
				},
				{
					"id": 200480109,
					"content": "沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200480111
					]
				},
				{
					"id": 200480111,
					"content": "#那就拜託{F#妳}{M#你}啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480112
					],
					"speakerTitle": "提米"
				},
				{
					"id": 200480112,
					"content": "#好好對待動物的話，{F#妳}{M#你}也可以和牠們做朋友的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "提米"
				},
				{
					"id": 200480110,
					"content": "我不太想和鴿子做朋友…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200480113
					]
				},
				{
					"id": 200480113,
					"content": "#無論想不想做朋友…{F#妳}{M#你}都要先向牠們道歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480114
					],
					"speakerTitle": "提米"
				},
				{
					"id": 200480114,
					"content": "所以——快點去找小麥啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "提米"
				}
			]
		},
