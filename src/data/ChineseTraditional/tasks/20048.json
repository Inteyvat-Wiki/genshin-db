					"nextDialogs": [
						200480302
					],
					"speakerTitle": "提米"
				},
				{
					"id": 200480302,
					"content": "下次走過的時候，記得不要再嚇到鴿子了，牠們好不容易才願意回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480303
					],
					"speakerTitle": "提米"
				},
				{
					"id": 200480303,
					"content": "知道了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200480304
					]
				},
				{
					"id": 200480304,
					"content": "#好啦，我原諒{F#妳}{M#你}了。這個給{F#妳}{M#你}，我最喜歡吃的蒙德薯餅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480305
					],
					"speakerTitle": "提米"
				},
				{
					"id": 200480305,
					"content": "要對世界保持善意啊…這是媽媽教我的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "提米"
				}
