					"nextDialogs": [
						200480204
					],
					"speakerTitle": "提米"
				},
				{
					"id": 200480204,
					"content": "把這些帶到湖邊，餵給鴨子們吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "提米"
