			"dialogs": [
				{
					"id": 700890101,
					"content": "咦，這裡怎麼有個人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700890102,
					"content": "也不是這個風神像…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890103
					],
					"speakerTitle": "「莫基」"
				},
				{
					"id": 700890103,
					"content": "喂，你在幹什麼啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700890104,
					"content": "我在找回去的路，我只記得要找風神像。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890105
					],
					"speakerTitle": "「莫基」"
				},
				{
					"id": 700890105,
					"content": "其他的我也什麼都不記得了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890106
					],
					"speakerTitle": "「莫基」"
				},
				{
					"id": 700890106,
					"content": "回去的路？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700890107,
					"content": "隱隱約約的一種鄉愁，但是我什麼都不記得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890108
					],
					"speakerTitle": "「莫基」"
				},
				{
					"id": 700890108,
					"content": "我醒來的時候，手裡只有一張寫了「你是『莫基』」的紙條。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890109
					],
					"speakerTitle": "「莫基」"
				},
				{
					"id": 700890109,
					"content": "所以我想我名字應該就是「莫基」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890110
					],
					"speakerTitle": "「莫基」"
				},
				{
					"id": 700890110,
					"content": "#不打擾{F#妳}{M#你}們了，再見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890111
					],
					"speakerTitle": "「莫基」"
				},
				{
					"id": 700890111,
					"content": "好奇怪的人，不過應該不是壞人吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700890112,
					"content": "#{F#妳}{M#你}怎麼了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700890113,
					"content": "看到了奇怪的景象。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700890114
					]
				},
				{
					"id": 700890114,
					"content": "奇怪的景象？難道是因為剛才那個人碰了神像嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		}
