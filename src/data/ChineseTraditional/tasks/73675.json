{
	"id": 73675,
	"type": "WQ",
	"name": "未來星墜落的地方",
	"description": "女孩芭努獨自一人在野外搜尋著什麼…",
	"unlockDescription": "",
	"chapter": "",
	"showType": "QUEST_SHOW",
	"activityId": 5096,
	"mainQuestTag": "MAINQUEST_TAG_GUIDE",
	"suggestTrackMainQuestList": [],
	"prevMainQuestList": [],
	"steps": [
		{
			"id": 7367501,
			"order": 1,
			"listShowType": "QUEST_SHOW",
			"description": "與芭努對話",
			"finishConditions": [
				{
					"type": "QUEST_CONTENT_COMPLETE_TALK",
					"rawParams": [
						7367501,
						0
					],
