				}
			]
		}
	],
	"talks": [
		{
			"id": 7367501,
			"completionStepIds": [
				7367501
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7367501",
							"2"
						],
						"stepId": 7367501,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"芭努",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736750101,
					"content": "哇，太好了！不是鍍金旅團不是盜寶團，是衣著正經的陌生人，要趕快抓住機會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750102
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736750102,
					"content": "#嗯，那個…「這位行路的朋友，請停下{F#妳}{M#你}的腳步！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750103,
						736750104
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736750103,
					"content": "妳好？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736750105
					]
				},
				{
					"id": 736750105,
					"content": "「您好！括弧，根據對方性別選擇稱呼先生或者女士，括弧。唐突打擾非常抱歉，煩請您在百忙之際抽空…嗯…聽取我的請求。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750106
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736750106,
					"content": "括、括弧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736750107,
					"content": "不行不行，不能打斷，要不然我就記不得下一句了。下一句是——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750108
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736750108,
					"content": "「括弧，用簡要的語言描述妳遇到的困難…並禮貌地請求對方協助，然後鄭重向對方表示感謝，括弧。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750109
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736750109,
					"content": "最後一句是——「括弧，範例，括弧。感謝您的慷慨大度，我將永遠把它記在心上。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750110
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736750110,
					"content": "「同時，我願意為您的不辭辛苦支付可觀的報酬，因此我懇請您稍微考慮這一個請求。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750111
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736750111,
					"content": "#呼，這遍每一個字都背出來了，肯定沒問題。那麼，找未來星的事就靠{F#妳}{M#你}幫忙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750112
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736750112,
					"content": "#聽起來像是有事要委託我們，但我怎麼聽不懂{F#妳}{M#你}說的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736750113,
					"content": "哪裡有問題呢？《遊學者不可不知的五十件事》上說，要找人幫忙的話就這麼說，不應該有問題啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750114,
						736750116
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736750114,
					"content": "哪裡都有問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736750115
					]
				},
				{
					"id": 736750115,
					"content": "這樣嗎？等、等一下，我找一找「哪裡都有問題」的時候該背哪一段。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750118
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736750118,
					"content": "女孩從口袋裡掏出了一本叫作《遊學者不可不知的五十件事》的書，焦急地翻了起來。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						736750119
					]
				},
				{
					"id": 736750119,
					"content": "唉，這上面沒說。但是沙爾瑪明明說遇到問題的時候，只要翻這本書就好了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750120
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736750120,
					"content": "雖然很混亂，但是看樣子，小朋友妳是遇到了困難需要幫助對嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736750121,
					"content": "既然書本派不上用場，不如用妳自己的話說說妳碰到的問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736750122,
					"content": "我想想，事情是這樣的：我叫芭努，是跟著地圖來這裡找未來星的，未來星一共有六顆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750123
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736750123,
					"content": "只要找到全部六顆未來星，就能召喚出大未來星，大未來星超級厲害的，我的目標就是召喚出大未來星。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750124
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736750124,
					"content": "哦，之前妳說的「找未來星」指的就是這件事啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736750125,
					"content": "嗯，未來星的設定差不多就是這些了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750126,
						736750128
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736750126,
					"content": "設定？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736750127
					]
				},
				{
					"id": 736750127,
					"content": "對呀，我覺得比起我平常看的那些，這個設定還挺好懂的，不過就是太簡單了，不好玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750130
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736750130,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736750131
					]
				},
				{
					"id": 736750131,
					"content": "然後，嗯…這個設定我覺得太模糊了，沒有解釋該怎麼找到未來星。為了解決這個問題，我又想了一個補充設定：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750132
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736750132,
					"content": "女孩從身後的草叢裡翻出了一個奇怪的物體。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						736750133
					]
				},
				{
					"id": 736750133,
					"content": "就是這個重要道具，它叫…嗯就叫「芭努的智慧」吧。它可以指引出未來星的位置，很厲害吧，嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750134
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736750134,
					"content": "我覺得這個名字超級酷！不過它太高了，而且又很重，我搬不動，就變得不酷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750135
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736750135,
					"content": "#我想找{F#妳}{M#你}們幫忙的就是這件事，{F#妳}{M#你}們應該能搬得動吧，能幫我用它找到未來星嗎？召喚出大未來星之後我可以付很多很多報酬給{F#妳}{M#你}們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750136,
						736750137
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736750136,
					"content": "這就是妳的委託嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736750138
					]
				},
				{
					"id": 736750138,
					"content": "#遇到{M#大哥哥}{F#大姐姐}{F#妳}{M#你}們之前，我還試過找別人幫忙。但他們聽到未來星的時候表情都變得很怪，都不想聽我說下去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750139
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736750139,
					"content": "他們還讓我不要胡鬧，乖乖回家找爸爸媽媽去，真氣人。我又不是瞞著家人溜出來的玩的幼稚鬼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750140
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736750140,
					"content": "大人們總是這樣，就因為我是小孩子，就覺得我在亂說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750141
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736750141,
					"content": "#但未來星是真實存在的！我才沒有在幻想，只要{F#妳}{M#你}們帶著…嗯…「芭努的智慧」找一找就會知道我有沒有撒謊了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750142
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736750142,
					"content": "#要是{F#妳}{M#你}們也不願意幫忙，唉，我再等等看，遇到的下一個人會不會願意聽我說話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750143
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736750143,
					"content": "好吧，我可以去看看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736750144
					]
				},
				{
					"id": 736750144,
					"content": "#{F#妳}{M#你}相信我！太好了，{M#大哥哥}{F#大姐姐}{F#妳}{M#你}拿著這個「芭努的智慧」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750145
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736750145,
					"content": "#{F#妳}{M#你}要記得哦，「芭努的智慧」運行一段時間之後要休息一陣子才能再指出未來星的位置。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750146
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736750146,
					"content": "#還有這本《遊學者不可不知的五十件事》{F#妳}{M#你}也拿著，我在這本書的地圖插畫裡標了未來星的位置，{F#妳}{M#你}們可以跟著地圖走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750147
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736750147,
					"content": "#{F#妳}{M#你}們找到全部六顆未來星就來找我吧，我帶{F#妳}{M#你}們一起去看大未來星！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芭努"
				},
				{
					"id": 736750137,
					"content": "我考慮一下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736750138
					]
				},
				{
					"id": 736750128,
					"content": "這又是哪本書裡的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736750129
					]
				},
				{
					"id": 736750129,
					"content": "哦，這個設定的話，我覺得應該是現編的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750130
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736750116,
					"content": "妳沒說遇到的困難是什麼。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736750117
					]
				},
				{
					"id": 736750117,
					"content": "是這樣嗎？等、等一下，我找一找「沒說遇到的困難是什麼」的時候該背哪一段。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750118
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736750104,
					"content": "什麼事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736750105
					]
				}
			]
		}
	]
}