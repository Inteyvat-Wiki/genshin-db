			"dialogs": [
				{
					"id": 150480101,
					"content": "…我們不能讓您承擔這種風險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480102
					],
					"speakerTitle": "高恩"
				},
				{
					"id": 150480102,
					"content": "但您剛才還不是這麼說的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480103
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150480103,
					"content": "實在抱歉，雖然時間很緊張，但我們更需要考慮遊客的人身安全，請您諒解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480104
					],
					"speakerTitle": "高恩"
				},
				{
					"id": 150480104,
					"content": "#{NICKNAME}，{F#妳}{M#你}來得正好，請幫我說服這位先生吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480105
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150480105,
					"content": "他們急著等人測試，我好不容易向對方證明了我的冒險經驗，也表明我願意承擔測試後果，本來很順利…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480106
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150480106,
					"content": "但一聽到我的「過往危機經歷」，這位先生就說什麼都不肯了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480107
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150480107,
					"content": "這位遊客，我理解您的熱心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480108
					],
					"speakerTitle": "高恩"
				},
				{
					"id": 150480108,
					"content": "但如果您過橋的時候都會失足掉進水裡，最好還是去參與比較溫和一點的設施…那邊的沙灘躺椅怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480109
					],
					"speakerTitle": "高恩"
				},
				{
					"id": 150480109,
					"content": "唉，可是、可是我的確是符合測試條件的冒險家！那只是因為…運氣不好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480110
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150480110,
					"content": "我是真的很想幫上忙，請您相信我的實力是值得信任的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480111,
						150480112
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150480111,
					"content": "我可以證明。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150480113
					]
				},
				{
					"id": 150480113,
					"content": "既然拯救納塔的大英雄都這麼說了…這樣吧，可否先讓這位阿夏搭檔完成第一輪測試呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480114
					],
					"speakerTitle": "高恩"
				},
				{
					"id": 150480114,
					"content": "您可以在一旁觀看，提前熟悉整體路線。一切順利無誤的話，再來請您參與第二輪測試。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480115
					],
					"speakerTitle": "高恩"
				},
				{
					"id": 150480115,
					"content": "阿夏，你願意嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480116
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150480116,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480117
					],
					"speakerTitle": "阿夏"
				},
				{
					"id": 150480117,
					"content": "好，那就交給你了哦，我的好搭檔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150480112,
					"content": "我為他擔保。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150480113
					]
				}
			]
		},
