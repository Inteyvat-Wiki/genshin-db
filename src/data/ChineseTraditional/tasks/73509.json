{
	"id": 73509,
	"type": "WQ",
	"name": "爆震沸騰！",
	"description": "#在雨林西南的防沙壁一帶，{F#妳}{M#你}和派蒙遇見了某位奇怪的學生，她似乎對{F#妳}{M#你}們印象深刻…",
	"unlockDescription": "",
	"chapter": "",
	"showType": "QUEST_SHOW",
	"activityId": 5129,
	"mainQuestTag": "MAINQUEST_TAG_GUIDE",
	"suggestTrackMainQuestList": [],
