	],
	"talks": [
		{
			"id": 7350901,
			"completionStepIds": [
				7350901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7350901",
							"2"
						],
						"stepId": 7350901,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"哈賈娜德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735090101,
					"content": "嘿嘿…呵呵…啊哈哈哈哈哈…大功告成了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090102
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 735090102,
					"content": "接下來只需要僱一群傭兵，進行試點部署，盡量在十天內達成初始作戰能力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090103
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 735090103,
					"content": "一旦取得了前線人員的報告，就能徹底說服導師，要到更多預算，然後向教令院證明，這就是煉金藥劑的最強形態！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090104
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 735090104,
					"content": "怎麼回事？這個人為什麼孤零零地站在這裡，對著沙漠的方向傻笑？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735090105,
					"content": "還說著什麼傭兵和作戰，聽起來像是戰鬥狂人才會說的話！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735090106,
					"content": "#{NICKNAME}，我們怎麼辦？要不要…先離她遠一點？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090107,
						735090124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735090107,
					"content": "滿有趣的，先看看情況。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735090108
					]
				},
				{
					"id": 735090108,
					"content": "#咿！差點忘了，{F#妳}{M#你}也是個打架大師…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735090109,
					"content": "#說起來，以前也有差不多的情況呢——如果{F#妳}{M#你}和對方聊得投緣，對方大概會直接僱我們幫忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735090110,
					"content": "要是這個人不打算做壞事，給的摩拉也夠多，我們倒是可以考慮一下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735090111,
					"content": "嗯？有人在背後議論我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090112
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 735090112,
					"content": "#居…居然是{F#妳}{M#你}們！金髮異鄉人和「白色高智慧浮游助手單元」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090113
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 735090113,
					"content": "咦，妳認識我們嗎？我不記得我有過這種綽號啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735090114,
					"content": "介紹一下自己？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735090115
					]
				},
				{
					"id": 735090115,
					"content": "#看樣子{F#妳}{M#你}們忘掉我了…可以理解。畢竟我只是個普通人，而{F#妳}{M#你}們都是活生生的傳奇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090116
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 735090116,
					"content": "#很久以前，{F#妳}{M#你}們幫我試驗了我的得意之作「重熔片劑」——一種為戰鬥提供助力的新式煉金藥劑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090117
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 735090117,
					"content": "#那次的研究很順利，{F#妳}{M#你}們享受了酣暢淋漓的戰鬥，為我提供了許多資料和啟發。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090118
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 735090118,
					"content": "#可以說，{F#妳}{M#你}們改變了我的人生，我一直很感謝{F#妳}{M#你}們！我的研究成果也幫到了一些「三十人團」的成員，有助於須彌的治安…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090119
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 735090119,
					"content": "有、有這麼誇張嗎？那我們之後要好好回憶一下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735090120,
					"content": "話說回來，剛才妳好像在自言自語什麼戰鬥和藥劑的事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735090121,
					"content": "這一次也需要我們幫忙嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735090122,
					"content": "#好啊！有{F#妳}{M#你}們兩位在，我也不用去和那些傭兵打交道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090123
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 735090123,
					"content": "說實在的，我還擔心被他們漫天要價，或者直接搶劫呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090139
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 735090139,
					"content": "#要是{F#妳}{M#你}們能幫我完成「震沸合劑」的驗證工作，之前規劃的預算全都付給{F#妳}{M#你}們，也算是對{F#妳}{M#你}們的進一步感謝了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090140
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 735090140,
					"content": "總計五十人份薪水的摩拉，這報酬還算豐厚吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090141
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 735090141,
					"content": "五十人份的摩拉？那不就相當於…完成了一天的工作，就好久好久都不用再忙了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090142
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735090142,
					"content": "#我覺得很划算，{NICKNAME}，這種好事可不多喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090143,
						735090144
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735090143,
					"content": "機會不錯，開始工作吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735090145
					]
				},
				{
					"id": 735090145,
					"content": "#好，{F#妳}{M#你}們還是那麼爽快！我也直接進入正題吧——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090146
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 735090146,
					"content": "之前我在大赤沙海測試「重熔片劑」時，發現它有「藥溫」的缺陷：在炎熱的環境下，片劑起爆時的效果完全不合格。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090147
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 735090147,
					"content": "所以我將一些藥劑溶解在穩定的液體介質中，與熔點較高的片劑分開儲存，使用時再將兩者混合，對容器內部增壓。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090148
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 735090148,
					"content": "片劑在沸騰的液體介質中爆炸後，產生了效率更高，還更穩定的「爆震沸騰效應」，新的裝置也就改名為「震沸裝置」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090149
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 735090149,
					"content": "如此一來，哪怕是在烈焰花旁坐了一整天，也能正常使用煉金藥劑輔助戰鬥了，整套裝置的可靠性獲得了飛躍性的提升！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090150
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 735090150,
					"content": "我還為裝置追加了定時啟動和記錄功能：進入戰鬥後，「震沸裝置」就會自動觸發反應，並記錄戰鬥資訊，操作更簡便了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090151
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 735090151,
					"content": "總…總之就是既方便又很厲害的輔助裝置，只需要我們帶著它去打扁一些魔物就行了，沒錯吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090152
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735090152,
					"content": "當然了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090153
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 735090153,
					"content": "哈賈娜德很認真呢，和我們這些外行都解釋得這麼仔細，連我都快聽懂了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090154
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735090154,
					"content": "換成脾氣不好的學者，應該只會用…「修復了一些已知問題」這樣的說法來搪塞過去吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090155,
						735090156
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735090155,
					"content": "反正可以自動啟動和記錄…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735090157
					]
				},
				{
					"id": 735090157,
					"content": "好，那我們就按照以前的習慣，幫哈賈娜德試試這個裝置的效果吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090158
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735090158,
					"content": "這是我們熟悉的領域，輕輕鬆鬆戰鬥就能拿到一大筆摩拉，又能幫到哈賈娜德，大家都大贏特贏！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090159
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735090159,
					"content": "#真是高效的溝通！果然，比起那些傭兵，和{F#妳}{M#你}們合作更痛快！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090160
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 735090160,
					"content": "#我已經找好了試驗的場地，不遠外就有個秘境，請{F#妳}{M#你}們這就去試試看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090161
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 735090161,
					"content": "#我隨時在這裡等著{F#妳}{M#你}們的回饋！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 735090156,
					"content": "詳細原理不用弄得太清楚…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735090157
					]
				},
				{
					"id": 735090144,
					"content": "快快瞭解一下「震沸合劑」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735090145
					]
				},
				{
					"id": 735090124,
					"content": "等等，有種似曾相識的感覺？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735090125
					]
				},
				{
					"id": 735090125,
					"content": "這麼一說，她好像確實有點眼熟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735090126,
					"content": "我想起來了，很久以前，我們在雨林裡的懸崖邊遇見過這個人！她叫什麼來著…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090127,
						735090129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735090127,
					"content": "煉金釜煮茶大師。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735090128
					]
				},
				{
					"id": 735090128,
					"content": "唔…我記得她是個很認真的煉金術士，好像沒有用煉金釜做過研究之外的事吧…想起來了，她叫哈賈娜德！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735090131,
					"content": "嗯？有人在背後議論我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090132
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 735090132,
					"content": "#居…居然是{F#妳}{M#你}們？金髮異鄉人和「白色高智慧浮游助手單元」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090133
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 735090133,
					"content": "沒想到在這裡見面啦！哈賈娜德，這段時間妳還好嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735090134,
					"content": "當然很好，不能再好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090135
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 735090135,
					"content": "#託{F#妳}{M#你}們的福，我用「重熔片劑」的研究成果發表了一篇論文，證明了它的優越性，還得到了「三十人團」的一定關注。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090136
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 735090136,
