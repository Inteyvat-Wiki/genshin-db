				"points": []
			},
			"dialogs": [
				{
					"id": 705330101,
					"content": "沒想到，我的發明居然還有這種用處…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330102
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705330102,
					"content": "#喔！{F#妳}{M#你}好，旅行者，沒想到我們又見面了…咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330103,
						705330105
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705330103,
					"content": "我還以為你離開蒙德了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705330104
					]
				},
				{
					"id": 705330104,
					"content": "我是有這個計畫，不過嘛…萬事萬物總是變化無窮啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330108
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705330108,
					"content": "咳，這些暫時不談了，我們講正事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330109
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705330109,
					"content": "這次，我是接受了蒙德城冒險家協會的邀請，專門以一種卡牌的牌面為原型，用齒輪和機關創作了好幾幅可以拆解再拼接的「械畫」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330110
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705330110,
					"content": "那個卡牌叫什麼…對！「七聖召喚」，沒錯，就是這個名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330111
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705330111,
					"content": "據他們說，這幾幅「械畫」會分別送去這次「召喚王大獎賽」的舉辦區域，再辦個什麼小活動，讓大獎賽的氣氛更熱鬧一點…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330112
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705330112,
					"content": "唉，這些事對我來說實在是太複雜了。我還是專注於我的發明吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330113
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705330113,
					"content": "對了，蒙德的「械畫」就在我身邊，如果您想要試試看拼接它的話，就請來體驗一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705330105,
					"content": "你的發明又有問題了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705330106
					]
				},
				{
					"id": 705330106,
					"content": "沒有！這次沒有，呃…不如說一開始就沒有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330107
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705330107,
					"content": "之前我請您幫忙那次，純粹是因為魔物的問題，和我的發明沒有關係嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330108
					],
					"speakerTitle": "菲利斯·尤格"
				}
			]
		}
	]
}