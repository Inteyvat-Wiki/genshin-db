			"dialogs": [
				{
					"id": 130380301,
					"content": "今日，當著眾賢之至賢，赫曼努比斯大人權柄與威能的見證，我等將再次舉行決鬥之儀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380302
					],
					"speakerTitle": "杜安雷"
				},
				{
					"id": 130380302,
					"content": "此為至聖的儀式，觀禮者將不可打擾，百般恭敬，莊嚴地觀看全過程。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380303
					],
					"speakerTitle": "杜安雷"
				},
				{
					"id": 130380303,
					"content": "緘默之殿的代表。防守方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380304
					],
					"speakerTitle": "杜安雷"
				},
				{
					"id": 130380304,
					"content": "爺爺，你來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380305
					],
					"speakerTitle": "賽索斯"
				},
				{
					"id": 130380305,
					"content": "…咳…多少年了，你竟然舉辦這個儀式，賽索斯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380306
					],
					"speakerTitle": "巴穆恩"
				},
				{
					"id": 130380306,
					"content": "我知道我在做什麼，爺爺，放心看著吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380307
					],
					"speakerTitle": "賽索斯"
				},
				{
					"id": 130380307,
					"content": "教令院的代表。進攻方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380308
					],
					"speakerTitle": "杜安雷"
				},
				{
					"id": 130380308,
					"content": "準備好了。今天我們會用實力贏下話語權。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380309
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 130380309,
					"content": "那麼，請雙方就位，決定出戰順序。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380310
					],
					"speakerTitle": "杜安雷"
				},
				{
					"id": 130380310,
					"content": "在這裡，我等將不問來者何來，去者何去，賭上赫曼努比斯的力量，戰鬥直到決出勝負！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380311
					],
					"speakerTitle": "杜安雷"
				},
				{
					"id": 130380311,
					"content": "我打頭陣吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380312
					]
				},
				{
					"id": 130380312,
					"content": "哎？真的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130380313,
					"content": "真的，士氣很重要。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380314
					]
				},
				{
					"id": 130380314,
					"content": "#我同意，{NICKNAME}很強，率先出戰能震懾對手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380315
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130380315,
					"content": "那你第二個。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380316
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 130380316,
					"content": "嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380317
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130380317,
					"content": "決定好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380318
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 130380318,
					"content": "我們也決定好了，開始吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "賽索斯"
				}
			]
