			},
			"dialogs": [
				{
					"id": 130380201,
					"content": "賽索斯，我們談談吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380202
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 130380202,
					"content": "你想清楚了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380203
					],
					"speakerTitle": "賽索斯"
				},
				{
					"id": 130380203,
					"content": "在那之前，我稍微懂一點醫學，能不能讓我看看巴穆恩的情況？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380204
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130380204,
					"content": "沒問題，不過我們的人裡也有醫生，你想看出什麼新花樣怕是不可能了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380205
					],
					"speakerTitle": "賽索斯"
				},
				{
					"id": 130380205,
					"content": "我只是需要一個答案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380206
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130380206,
					"content": "跟我來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380207
					],
					"speakerTitle": "賽索斯"
				},
				{
					"id": 130380207,
					"content": "輕一點，別吵到他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380208
					],
					"speakerTitle": "賽索斯"
				},
				{
					"id": 130380208,
					"content": "提納里掏出這次隨身帶著的一些檢查用具，為巴穆恩做了基本檢查。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130380209
					]
				},
				{
					"id": 130380209,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380210
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130380210,
					"content": "我們到外面說吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380211
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130380211,
					"content": "巴穆恩深度昏迷了，情況很不樂觀。你們的醫生肯定也診斷出了同樣的結果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380212
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130380212,
					"content": "年輕時受過重傷，後來又積勞成疾，年邁體衰…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380213
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130380213,
					"content": "我必須遺憾地通知你……他的狀況對我來說還算眼熟，普通這樣的人最多只能再堅持幾天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380214
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130380214,
					"content": "…這些我早就知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380215
					],
					"speakerTitle": "賽索斯"
				},
				{
					"id": 130380215,
					"content": "你是他的繼承人吧？看得出你尊重他，但你們想法不完全一樣，你顧慮的方面更多、更現實。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380216
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 130380216,
					"content": "開個條件吧，在巴穆恩還看得見的時間裡給這件事一個結果，我知道你在乎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380217
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 130380217,
					"content": "對啊，很多事不能拖，你應該明白的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130380218,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380219
					],
					"speakerTitle": "賽索斯"
				},
				{
					"id": 130380219,
					"content": "其實，你們兩位現在的處境非常相似，都跟養育自己的人想法不同。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380220
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130380220,
					"content": "而且明明是另一代人的矛盾，做決定的卻是你們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130380221,
					"content": "妳說得沒錯，這件事裡雙方立場都已經變化轉移了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380222
					],
					"speakerTitle": "賽索斯"
				},
				{
					"id": 130380222,
					"content": "我同意，賽諾。一切皆因赫曼努比斯而起，不妨也用他的儀式來做了斷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380223
					],
					"speakerTitle": "賽索斯"
				},
				{
					"id": 130380223,
					"content": "傳說赫曼努比斯剛到圖萊杜拉城時曾與人比武，他和他的兩位同伴連日戰鬥、收服人心，招攬了大批有志之士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380224
					],
					"speakerTitle": "賽索斯"
				},
				{
					"id": 130380224,
					"content": "那些人後來都成為了緘默之殿的一份子。這是我們的開始，也是我們的儀式——「決鬥之儀」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380225
					],
					"speakerTitle": "賽索斯"
				},
				{
					"id": 130380225,
					"content": "很有意義，就用這個辦法吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380226
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 130380226,
					"content": "你也擁有赫曼努比斯之力，與緘默之殿有很大關係。我同意你帶同伴參加這場比試。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380227
					],
					"speakerTitle": "賽索斯"
				},
				{
					"id": 130380227,
					"content": "三對三，可以。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380228
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130380228,
					"content": "但我有要求。你們作為攻擂方，必須連勝三局，而且賽諾，你我都要賭上自己持有的跋靈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380229
					],
					"speakerTitle": "賽索斯"
				},
				{
					"id": 130380229,
					"content": "放任居勒什帶走跋靈是爺爺從前因憐憫犯下的錯誤，也是緘默之殿必須跨過的議題，這一點上我不能退讓。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380230
					],
					"speakerTitle": "賽索斯"
				},
				{
					"id": 130380230,
					"content": "正合我意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380231
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 130380231,
					"content": "如果我贏了，緘默之殿必須釋放居勒什，並將過去的事一筆勾銷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380232
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 130380232,
					"content": "如果你贏了，我會歸還這份力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380233
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 130380233,
					"content": "一言為定。那麼明天晚上八點，到儀式之廳見面吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "賽索斯"
				}
			]
		},
