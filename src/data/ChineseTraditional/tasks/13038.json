			"dialogs": [
				{
					"id": 130380601,
					"content": "都談到這個份上，可沒有回頭路了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380602
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130380602,
					"content": "也不是才開始的。從老師偷偷溜走那一刻起，我就已經沒有回頭路了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380603
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 130380603,
					"content": "你得贏。不論是作為大風紀官還是作為你自己，都需要這份力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380604
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130380604,
					"content": "對呀。而且這股力量跟了你這麼久，它一定也認可你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130380605,
					"content": "…不論是作為風紀官，還是作為我自己…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380606
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 130380606,
					"content": "是啊，這麼想想，我也是好不容易才克服困難制伏了這股力量的。又不是誰都能做到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380607
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 130380607,
					"content": "就是就是！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380608,
						130380609
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130380608,
					"content": "不要多想，拿下勝利吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380610
					]
				},
				{
					"id": 130380610,
					"content": "#嗯，我和{NICKNAME}絕對不會輸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380611
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130380611,
					"content": "我也一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380612
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 130380612,
					"content": "沙漠文明非常古老，又因為種種原因一度和雨林產生間隙。就像迪希雅說的，偏見阻隔著人們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380613
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 130380613,
					"content": "心病更是一切的源頭。我總覺得巴穆恩在乎的東西似乎遠不只這些，賽索斯也不是惡人，他有他的打算。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380614
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 130380614,
					"content": "…一切就看明天了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "賽諾"
				},
				{
					"id": 130380609,
					"content": "我們也會幫忙的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380610
					]
				}
			]
