			"dialogs": [
				{
					"id": 761360301,
					"content": "（或許<color=#FFCC33FF>雅珂達</color>想看看箱子的情況…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761360302
					]
				},
				{
					"id": 761360302,
					"content": "嘿嘿…讓我看看最近賺了多少錢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360303
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761360303,
					"content": "上次老闆說要幫我加獎金，不如我現在就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360304
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761360304,
					"content": "裡面怎麼沒錢啊？只有一張紙條…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360305
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761360305,
					"content": "「親愛的雅珂達，把盒子關好。妳的獎金不從這裡面出。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360306
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761360306,
					"content": "呿，老闆又在嚇人了，是不是有夾層…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360307
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761360307,
					"content": "沒有夾層，妳的獎金在這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360308
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 761360308,
					"content": "喔，謝謝老闆，我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360309
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761360309,
					"content": "嗚啊啊啊啊啊啊啊——老老老老闆，我就是清點一下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360310
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761360310,
					"content": "我這就去工作，馬上去——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360311
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761360311,
					"content": "站住。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360312
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 761360312,
					"content": "是！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360313
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761360313,
					"content": "鎖好盒子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360314
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 761360314,
					"content": "是！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360315
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761360315,
					"content": "去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360316
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 761360316,
					"content": "是！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雅珂達"
				}
			]
		},
