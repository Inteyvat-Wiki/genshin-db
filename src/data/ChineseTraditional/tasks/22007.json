					"nextDialogs": [
						220070203
					]
				},
				{
					"id": 220070203,
					"content": "#喂，{F#妳}{M#你}仔細看看啊，我可是用衣服在裡面墊了好幾層的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070204
					],
					"speakerTitle": "寶兒"
				},
				{
					"id": 220070204,
					"content": "我可是專業的學者，怎麼可能犯低級錯誤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070205
					],
					"speakerTitle": "寶兒"
				},
				{
					"id": 220070205,
					"content": "#好了，文物就拜託{F#妳}{M#你}了，我可拿那些怪物沒辦法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "寶兒"
				}
			]
