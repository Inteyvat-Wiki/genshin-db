			"dialogs": [
				{
					"id": 220070101,
					"content": "到底掉哪去了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070102
					],
					"speakerTitle": "寶兒"
				},
				{
					"id": 220070102,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220070103
					]
				},
				{
					"id": 220070103,
					"content": "哎呀，是這樣…我在一處遺蹟考察的時候，突然被怪物襲擊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070104
					],
					"speakerTitle": "寶兒"
				},
				{
					"id": 220070104,
					"content": "我慌裡慌張地逃跑，結果，把剛剛挖出來的文物忘在了原地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070105
					],
					"speakerTitle": "寶兒"
				},
				{
					"id": 220070105,
					"content": "那群怪物離開之後，我又折返回去，但是文物已經不見了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070106
					],
					"speakerTitle": "寶兒"
				},
				{
					"id": 220070106,
					"content": "我在周圍找了半天也沒找到，不知道是不是被怪物拿走了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070107
					],
					"speakerTitle": "寶兒"
				},
				{
					"id": 220070107,
					"content": "#{F#妳}{M#你}能幫我去找找嗎？如果找到文物的話，就用這個盒子裝好吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "寶兒"
				}
			]
		},
