				]
			},
			"dialogs": [
				{
					"id": 150290201,
					"content": "我等皆是在時光中漫遊的飛鳥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290203
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290203,
					"content": "（播片）",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150290204
					]
				},
				{
					"id": 150290204,
					"content": "#{F#妳}{M#你}果然懂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290205
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290205,
					"content": "這…這該不會就是我們需要製作的那種織物吧？茜特菈莉怎麼知道它的製作方法的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150290206,
					"content": "派蒙，想想那位「神明」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290207
					]
				},
				{
					"id": 150290207,
					"content": "茜特菈莉活了兩百多年…茜特菈莉知道製作這種織物的方法…難道茜特菈莉就是饋贈織物的那位神明？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150290208,
					"content": "我可不想接觸那些被諭示選中的人，所以每次都是使用幻術迷惑他們之後再把織物留下來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290209
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290209,
					"content": "這些人能把這當成是「神明的饋贈」，只能說能力太差，看不穿我的法術。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290210
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290210,
					"content": "為什麼要瞞著大家？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290211
					]
				},
				{
					"id": 150290211,
					"content": "對啊，茜特菈莉為什麼要獨自把這份使命背負兩百年呢？就算不喜歡和其他人接觸，也可以把這種方法傳授給別人吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150290212,
					"content": "#…{NICKNAME}，{F#妳}{M#你}能看到那種「色彩」吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290213
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290213,
					"content": "可以。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290214
					]
				},
				{
					"id": 150290214,
					"content": "那種「色彩」的本質是「記憶」，為這種織物上色的過程其實就是從記憶裡尋找色彩的過程。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290215
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290215,
					"content": "如果要把這種秘術傳承下去，首先要和另一個人分享記憶，在彼此的記憶中留下自己的顏色。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290216
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290216,
					"content": "雖然直到今天才完全明白這一點，但我之前已經或多或少地意識到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290217
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290217,
					"content": "而維奇琳離開以後，我一直都抗拒和別人產生這樣的交集。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290218
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290218,
					"content": "是這樣啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150290219,
					"content": "但這畢竟是她生前最後的委託，所以我的確想過既然我的人生如此漫長，不如就讓我一個人永久地背負這項使命吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290220
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290220,
					"content": "！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290221
					],
					"speakerTitle": "特拉波"
				},
				{
					"id": 150290221,
					"content": "可是小爪這傢伙明明知道這一點，卻還是在不停地指定新的人選。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290222
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290222,
					"content": "牠是在推薦妳新的朋友吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290223
					]
				},
				{
					"id": 150290223,
					"content": "我一開始就猜到了。讓我願意分享記憶的人自然也能成為我的朋友，可是我一直拒絕牠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290224
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290224,
					"content": "不過，這一次就算你成功了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290225
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290225,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290226
					],
					"speakerTitle": "特拉波"
				},
				{
					"id": 150290226,
					"content": "#收下這個，這也算是我給{F#妳}{M#你}的回覆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290227
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290227,
					"content": "這是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290228
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150290228,
					"content": "如果非要選一種顏色作為「我的顏色」，那它肯定是這個手帕的顏色。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290229
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290229,
					"content": "這幾百年來一直是別人活在我的記憶裡，但總有一天，我也會活在別人的記憶裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290230
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290230,
					"content": "#{F#妳}{M#你}說{F#妳}{M#你}的壽命也很長，那{F#妳}{M#你}作為承載這份記憶的人選肯定很適合…我希望{F#妳}{M#你}的記憶裡也會有我的顏色。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290231
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290231,
					"content": "看來我正式成為妳的朋友了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290232
					]
				},
				{
					"id": 150290232,
					"content": "…收好它，到時候千萬不要把顏色搞錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290233
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290233,
					"content": "才剛剛成為朋友，就要規劃到生命結束的時候嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290234
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150290234,
					"content": "朋友不就是這樣的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290235
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290235,
					"content": "#真是好嚴肅的約定啊…不過話說回來，要是{NICKNAME}想要在茜特菈莉的記憶裡留下顏色，那肯定是金色吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290236
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150290236,
					"content": "已經留下了哦——記得那個還沒有被處理掉的副作用嗎？我現在總算找到原因了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290237
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290237,
					"content": "分享感官的秘術其實是一種意識層面上的交流，自然也會牽扯到「記憶」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290238
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290238,
					"content": "#我沒想到{F#妳}{M#你}和我一樣都能看到那種「記憶的色彩」。和{F#妳}{M#你}分享感官的時候，它就在我們的記憶裡留下了連結。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290239
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290239,
					"content": "這種連結反過來作用到分享感官使用的秘術上，結果就變成了現在的樣子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290240
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290240,
					"content": "#哦，所以是因為{NICKNAME}的確在茜特菈莉的記憶裡留下了顏色，茜特菈莉才能聽到{NICKNAME}的心聲？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290241
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150290241,
					"content": "#那反過來也一樣吧？所以之前{NICKNAME}也能聽到茜特菈莉的心聲！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290242
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150290242,
					"content": "腦袋動很快。要做到這一點，首先得保證自己有很高的秘術造詣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290243
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290243,
					"content": "#所以{NICKNAME}身上的副作用也就持續了那麼一段時間，而我身上的卻持續到現在…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290244
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290244,
					"content": "不過不用擔心了。現在我搞懂了它背後的原理，很快就能把它處理掉的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290245
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290245,
					"content": "哦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290246
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150290246,
					"content": "（其實我是騙派蒙的。決定能不能聽到對方心聲的關鍵，應該是自己在對方記憶裡留下的印象有多深刻。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290247
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290247,
					"content": "#（經歷了這一切，{F#妳}{M#你}恐怕又能聽到我的心聲了。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290248
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290248,
					"content": "（！）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290249
					]
				},
				{
					"id": 150290249,
					"content": "（果然已經能聽到了啊…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290250
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290250,
					"content": "（那有什麼解決辦法嗎？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290251
					]
				},
				{
					"id": 150290251,
					"content": "#（在記憶層面建立了這種連結之後，我唯一能想到的解決辦法——就是{F#妳}{M#你}忘了我，或者我忘了{F#妳}{M#你}。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290252
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290252,
					"content": "（……）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290253
					]
				},
				{
					"id": 150290253,
					"content": "#（嚇唬{F#妳}{M#你}的啦。奶奶我可是煙謎主的傳奇大薩滿，現在我搞清楚了這種副作用的成因，有的是辦法處理它。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290254
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290254,
					"content": "（只是大概要花費一段時間…最近的話，暫且先忍受一下這種副作用吧。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290255
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290255,
					"content": "#（放心，奶奶我內心坦蕩，也不怕被{F#妳}{M#你}聽到什麼…對了，喝酒之後的不算。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290256,
						150290259
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290256,
					"content": "（有辦法處理掉？有點遺憾啊…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290257
					]
				},
				{
					"id": 150290257,
					"content": "#（遺憾？{F#妳}{M#你}要是還想玩這種心電感應，再找我使用一次共感的秘術就可以。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290258
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290258,
					"content": "#（先說好了，我可不是在承諾什麼喔。有些想法還是藏在{F#妳}{M#你}的心裡更好。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290261
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290261,
					"content": "呃…嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150290259,
					"content": "（有辦法處理掉？那就好。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290260
					]
				},
				{
					"id": 150290260,
					"content": "（我知道，有些想法還是藏在自己心裡更好。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290261
					],
					"speakerTitle": "茜特菈莉"
				}
			]
		},
