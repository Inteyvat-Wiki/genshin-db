					}
				]
			},
			"dialogs": [
				{
					"id": 150290101,
					"content": "#製作那種織物本來不需要{F#妳}{M#你}動手，但是，要是為了傳承那種秘術，就非{F#妳}{M#你}不可了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290102
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290102,
					"content": "妳在說什麼啊，茜特菈莉？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150290103,
					"content": "先跟我來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290104
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290104,
					"content": "這個房間…茜特菈莉平時也製作織物嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150290105,
					"content": "織物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290106
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290106,
					"content": "織物？妳不是說要給我看妳此生最得意的作品？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290107
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290107,
					"content": "我沒有說謊哦，老友，這種秘術就與織物有關。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290108
					],
					"speakerTitle": "維奇琳"
				},
				{
					"id": 150290108,
					"content": "唉…妳說吧，到底是什麼秘術？它是能逆轉一場戰爭，還是能阻止一場災難？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290109
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290109,
					"content": "現在的妳，再想跟我打架也沒辦法從床上爬起來，我允許妳在口頭上贏過我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290110
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290110,
					"content": "咳咳…老友，我能感覺到我就要離開，已經沒有時間再和妳決出勝負了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290111
					],
					"speakerTitle": "維奇琳"
				},
				{
					"id": 150290111,
					"content": "喂…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290112
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290112,
					"content": "不要擔心，我們煙謎主不是有個說法嗎？這片大陸上的人類並不會真的死去，而是前往了夜神之國——那個由記憶構成的世界。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290113
					],
					"speakerTitle": "維奇琳"
				},
				{
					"id": 150290113,
					"content": "所以，我們的祖先為什麼堅持用這種彩色織物來記錄歷史，妳大概也能猜到吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290114
					],
					"speakerTitle": "維奇琳"
				},
				{
					"id": 150290114,
					"content": "因為「歷史」，就是一個民族的「記憶」啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290115
					],
					"speakerTitle": "維奇琳"
				},
				{
					"id": 150290115,
					"content": "希望他們到那個世界之後仍能感受到夕陽的溫暖，所以才為「歷史」染上橘紅的底色吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290116
					],
					"speakerTitle": "維奇琳"
				},
				{
					"id": 150290116,
					"content": "希望他們到那個世界之後仍能歡度豐收的季節，所以才為「歷史」點綴上顆粒果的花紋吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290117
					],
					"speakerTitle": "維奇琳"
				},
				{
					"id": 150290117,
					"content": "這一點我當然知道…聽起來像是一種重要的部族事務，為什麼不託付給妳的那些學生呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290118
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290118,
					"content": "我專門找妳過來，的確帶了作為朋友的一點私心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290119
					],
					"speakerTitle": "維奇琳"
				},
				{
					"id": 150290119,
					"content": "咳咳…僅憑剩下的時間，我恐怕無法讓妳明白這個決定了，但我相信妳總會明白的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290120
					],
					"speakerTitle": "維奇琳"
				},
				{
					"id": 150290120,
					"content": "請先答應我最後的這個請求，可以嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290121
					],
					"speakerTitle": "維奇琳"
				},
				{
					"id": 150290121,
					"content": "…只有這一次哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290122
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290122,
					"content": "現在，我的確明白妳的決定了…小爪，幫我把它搬到室外，我要準備為它上色了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290123
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290123,
					"content": "！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290124
					],
					"speakerTitle": "特拉波"
				},
				{
					"id": 150290124,
					"content": "#{NICKNAME}和派蒙也請跟我來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "茜特菈莉"
				}
			]
		},
