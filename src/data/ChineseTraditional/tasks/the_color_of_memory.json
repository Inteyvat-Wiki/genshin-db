			},
			"dialogs": [
				{
					"id": 150290501,
					"content": "#{F#妳}{M#你}們仔細跟他講了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290502
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290502,
					"content": "嗯，特意隱藏了茜特菈莉的貢獻哦。不過，好像差點被拆穿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150290503,
					"content": "#明明{F#妳}{M#你}們也說是「神明的饋贈」就能應付過去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290504
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290504,
					"content": "庇蘭的努力值得一份回報。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290505
					]
				},
				{
					"id": 150290505,
					"content": "我知道…他跟之前的那些首領都不太一樣。我只是害怕萬一把我暴露了，又有一堆麻煩事找上門來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290506
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290506,
					"content": "#我找了好久，原來{F#妳}{M#你}們在這裡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290507
					],
					"speakerTitle": "艾列爾"
				},
				{
					"id": 150290507,
					"content": "是那個楓丹研究員…怎麼沒和那個奸商在一起？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150290508,
					"content": "叫我艾列爾就好…我也接受了審訊，因為我並未犯下任何實質性的罪行，所以被放出來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290509
					],
					"speakerTitle": "艾列爾"
				},
				{
					"id": 150290509,
					"content": "失去了僱主，我就得盡快返回楓丹——畢竟沒了經費來源。不過在離開納塔之前，我想至少完成之前的調查。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290510
					],
					"speakerTitle": "艾列爾"
				},
				{
					"id": 150290510,
					"content": "請問您願意幫我把維奇琳的故事補全，讓納塔以外的人也能瞭解到她的事蹟嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290511
					],
					"speakerTitle": "艾列爾"
				},
				{
					"id": 150290511,
					"content": "採訪？真麻煩…我為什麼要關心納塔以外的人是否瞭解我們的故事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290512
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290512,
					"content": "不要誤會，我並非想曲解你們的歷史或者以此牟利，我只是單純地對其他國家的歷史有興趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290513
					],
					"speakerTitle": "艾列爾"
				},
				{
					"id": 150290513,
					"content": "我覺得真正精彩的故事就應該讓全提瓦特都知道，文化也就是在這樣的交流中才變得繁榮起來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290514
					],
					"speakerTitle": "艾列爾"
				},
				{
					"id": 150290514,
					"content": "我覺得很有道理。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290515
					]
				},
				{
					"id": 150290515,
					"content": "那你快問，再過一會奶奶我就要有重要的安排了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290516
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290516,
					"content": "「重要的安排」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290517
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150290517,
					"content": "非常感謝！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290518
					],
					"speakerTitle": "艾列爾"
				},
				{
					"id": 150290518,
					"content": "艾列爾詳細詢問了與維奇琳有關的各種往事，直到茜特菈莉有些生氣了才不得不離開。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150290519
					]
				},
				{
					"id": 150290519,
					"content": "今天的社交份額又超標了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290520
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290520,
					"content": "看來也到我們告別的時候了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290521
					]
				},
				{
					"id": 150290521,
					"content": "#嗯…等一下，{F#妳}{M#你}還欠我兩本絕版書呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290522
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290522,
					"content": "哦，是那個啊…有關輕小說的事，茜特菈莉果然記得很清楚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290523
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150290523,
					"content": "可是一時之間也找不到啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290524
					]
				},
				{
					"id": 150290524,
					"content": "#我知道，那兩本絕版書的珍稀程度我比{F#妳}{M#你}更瞭解，可能要專門去一趟稻妻的八重堂總部…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290525
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290525,
					"content": "#我不需要{F#妳}{M#你}馬上幫我找到，不過{F#妳}{M#你}最好惦記著。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290526
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290526,
					"content": "嗯嗯，找到了就立刻幫茜特菈莉送過去！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290527
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150290527,
					"content": "#送過來…我滿討厭宿醉的時候聽到有人敲門——這樣吧，這個給{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290528
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290528,
					"content": "這是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290529
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150290529,
					"content": "我家的鑰匙。下次來就不要敲門了，擾人清夢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "茜特菈莉"
				}
			]
