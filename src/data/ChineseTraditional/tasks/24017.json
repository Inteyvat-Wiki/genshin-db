				"points": []
			},
			"dialogs": [
				{
					"id": 240170301,
					"content": "您幫我撈到那些東西了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊維斯"
				}
			]
		},
		{
			"id": 2401704,
			"completionStepIds": [
				2401704
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2401704",
							"2"
						],
						"stepId": 2401704,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"伊維斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240170401,
					"content": "沒錯，這就是我們整天打撈的東西，都是一些這樣的破爛垃圾。那個整天吃破爛的吝嗇鬼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170402
					],
					"speakerTitle": "伊維斯"
				},
				{
					"id": 240170402,
					"content": "多謝您的幫忙，這些錢是我之前找戈爾德曼預支的薪水，請您收下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170403
					],
					"speakerTitle": "伊維斯"
				},
				{
					"id": 240170403,
					"content": "我不能拿這些錢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170404
					]
				},
				{
					"id": 240170404,
					"content": "必須收下！這是您由工作所獲得的報酬！這些錢已經不屬於我，如果您不要，我就讓錢袋沉到水底去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170405
					],
					"speakerTitle": "伊維斯"
				},
				{
					"id": 240170405,
					"content": "好吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170406
					]
				},
				{
					"id": 240170406,
					"content": "這樣就好，如果您之後有什麼東西要撈，儘管來找我，無論您要撈的東西在哪裡，我一定完完整整地撈上來給您！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170407
					],
					"speakerTitle": "伊維斯"
				},
				{
					"id": 240170407,
					"content": "我得繼續補補這潛水服了，唉，這破洞也太大了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊維斯"
				}
			]
		},
		{
			"id": 2401705,
			"completionStepIds": [
				2401706
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2401706",
							"2"
						],
						"stepId": 2401706,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"伊維斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240170501,
					"content": "這是…哎呀！這裡面怎麼都是首飾？難道戈爾德曼真正要我們撈的，其實是這些東西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170502
					],
					"speakerTitle": "伊維斯"
				},
				{
					"id": 240170502,
					"content": "多謝您的幫忙，這些錢…這些錢請您收下，請您千萬別說出去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170503
					],
					"speakerTitle": "伊維斯"
				},
				{
					"id": 240170503,
					"content": "要是能把它賣出去，我就能自己買一套潛水服，再也不用付戈爾德曼租金了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170504,
						240170505
					],
					"speakerTitle": "伊維斯"
				},
				{
					"id": 240170504,
					"content": "我不能收。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170506
					]
				},
				{
					"id": 240170506,
					"content": "不！不！這是您應得的報酬，這麼一點錢一定配不上您剛才的勞苦，但這是我最後一點錢了，本來是預留著晚上去喝點酒的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170507
					],
					"speakerTitle": "伊維斯"
				},
				{
					"id": 240170507,
					"content": "請您一定要收下！我收拾收拾，等等就去看看，怎樣才可以把這首飾偷偷賣出去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊維斯"
				},
				{
					"id": 240170505,
					"content": "我不會說出去。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170506
					]
				}
			]
		},
		{
			"id": 2401706,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2401705",
							"2"
						],
						"stepId": 2401705,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2401702",
							"2"
						],
						"stepId": 2401702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"伊維斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240170601,
					"content": "那個吝嗇鬼，呸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170602,
						240170608,
						240170612
					],
					"speakerTitle": "伊維斯"
				},
				{
					"id": 240170602,
					"content": "你可以再說說戈爾德曼嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170603
					]
				},
				{
					"id": 240170603,
					"content": "戈爾德曼是我老闆，雇了一群像我這樣沒什麼本事，只能靠體力賺錢糊口的人為他工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170604
					],
					"speakerTitle": "伊維斯"
				},
				{
					"id": 240170604,
					"content": "這個腦子裡只有楓達的傢伙既苛刻、又吝嗇！他要求我們在工作時絕對遵守那本厚厚的工作準則…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170614
					],
					"speakerTitle": "伊維斯"
				},
				{
					"id": 240170614,
					"content": "而且，就連我們工作時用的潛水服也是他「租」給我們的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170605
					],
					"speakerTitle": "伊維斯"
				},
				{
					"id": 240170605,
					"content": "只要我們違反了工作條例，或者潛水服破損，我們就得反過來賠他一筆錢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170615
					],
					"speakerTitle": "伊維斯"
				},
				{
					"id": 240170615,
					"content": "也就是說，如果我工作時一個不小心，我甚至要付一筆錢給這吝嗇鬼，央求他繼續雇我！呸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170606
					],
					"speakerTitle": "伊維斯"
				},
				{
					"id": 240170606,
					"content": "您瞭解他做什麼，難道是想去見見他嗎？我求您，就算是為了您的名聲著想，也一定要離戈爾德曼遠一點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170616
					],
					"speakerTitle": "伊維斯"
				},
				{
					"id": 240170616,
					"content": "他是個無恥的人，身邊總是聚著一群和他臭味相投的壞傢伙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170607
					],
					"speakerTitle": "伊維斯"
				},
				{
					"id": 240170607,
					"content": "您千萬不要和他往來，想把一個爛泥坑清理乾淨，再倒滿清水絕對不是一件容易的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170617
					],
					"speakerTitle": "伊維斯"
				},
				{
					"id": 240170617,
					"content": "但用臭泥巴汙染一個清白的池塘，是根本花不了一點工夫的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊維斯"
				},
				{
					"id": 240170608,
					"content": "你的工作很辛苦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170609
					]
				},
				{
					"id": 240170609,
					"content": "哈，您說得沒錯，但這也是我唯一能謀生的方法了。我不聰明，沒其他的本事，但也絕不願意做不好的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170618
					],
					"speakerTitle": "伊維斯"
				},
				{
					"id": 240170618,
					"content": "如果我非得做壞事才能換來麵包，那我寧願餓著肚子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170610
					],
					"speakerTitle": "伊維斯"
				},
				{
					"id": 240170610,
					"content": "現在的工作雖然非常辛苦，但我每天晚上睡覺至少闔得上眼，不必擔心有人恨透了我，想趁我睡著後拿刀刺我的眼睛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170611
					],
					"speakerTitle": "伊維斯"
				},
				{
					"id": 240170611,
					"content": "在這一點上，我比那個戈爾德曼好太多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊維斯"
				},
				{
					"id": 240170612,
					"content": "再見。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170613
					]
				},
				{
					"id": 240170613,
					"content": "#好，打撈的事就倚仗您了，好心的{M#先生}{F#女士}，我得繼續去補我的那套潛水服了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊維斯"
				}
			]
		},
		{
			"id": 2401707,
			"completionStepIds": [
				2401701
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
