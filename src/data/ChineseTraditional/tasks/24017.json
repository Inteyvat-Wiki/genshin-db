					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"2401701",
							"2"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"伊維斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240170701,
					"content": "唉…運氣真不好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170702
					],
					"speakerTitle": "伊維斯"
				},
				{
					"id": 240170702,
					"content": "你把東西賣出去了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170703
					]
				},
				{
					"id": 240170703,
					"content": "是您啊。別提了，我本來都偷偷地找好了賣家，但戈爾德曼突然闖進了我的屋子，把那盒首飾都拿走了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170704
					],
					"speakerTitle": "伊維斯"
				},
				{
					"id": 240170704,
					"content": "如果不是他還需要我工作，那我一定要被揍一頓了…但我還是被他扣下了兩個月的薪水…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170716
					],
					"speakerTitle": "伊維斯"
				},
				{
					"id": 240170716,
					"content": "要等我做完了今年所有的工作，再把錢給我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170705
					],
					"speakerTitle": "伊維斯"
				},
				{
					"id": 240170705,
					"content": "唉…算了、算了。好運氣總是不願意找上我這類蠢蛋的…戈爾德曼沒有找您吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170706,
						240170709
					],
					"speakerTitle": "伊維斯"
				},
				{
					"id": 240170706,
					"content": "沒有。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170707
					]
				},
				{
					"id": 240170707,
					"content": "那就好，我就算被打了也沒關係，希望這傢伙不要去找您的麻煩就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170708
					],
					"speakerTitle": "伊維斯"
				},
				{
					"id": 240170708,
					"content": "我沒有把您幫忙打撈的事說出來，但我總覺得，是有其他人知道了這件事，向那個吝嗇鬼告密…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170711
					],
					"speakerTitle": "伊維斯"
				},
				{
					"id": 240170711,
					"content": "不過，今天我必須得再請您幫幫忙了，我的潛水服還沒補好，但戈爾德曼卻一直催我工作，把前幾天沒完成的工作全補上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170712
					],
					"speakerTitle": "伊維斯"
				},
				{
					"id": 240170712,
					"content": "我只好找人家借了一套潛水服，趕快來撈東西了…但這樣還是撈不完，只能再請您大發慈悲，幫我一次了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170713,
						240170714
					],
					"speakerTitle": "伊維斯"
				},
				{
					"id": 240170713,
					"content": "沒問題！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170715
					]
				},
				{
					"id": 240170715,
					"content": "謝謝您，我把那些東西的位置幫您標好，我們兩個就分頭出發…等工作結束，我再去補我的那套潛水服。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊維斯"
				},
				{
					"id": 240170714,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170715
					]
				},
				{
					"id": 240170709,
					"content": "他來的話，我要好好教訓他。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170710
					]
				},
				{
					"id": 240170710,
					"content": "您千萬不要和那胖子扯上關係。他是個卑劣無恥的傢伙！您這樣值得敬佩的好人根本就不該結識他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170711
					],
					"speakerTitle": "伊維斯"
				}
			]
		}
	]
}