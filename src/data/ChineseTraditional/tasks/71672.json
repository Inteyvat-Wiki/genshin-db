			"completionStepIds": [
				7167201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7167201",
							"2"
						],
						"stepId": 7167201,
						"stateName": "QUEST_STATE_UNFINISHED"
