				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"報菲"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716720101,
					"content": "嘿嘿…昨天又聽了一段和「白馬仙人」有關的書，這下又有新靈感了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716720102,
						716720103
					],
					"speakerTitle": "報菲"
				},
				{
					"id": 716720102,
					"content": "什麼靈感？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716720104
					]
				},
				{
					"id": 716720104,
					"content": "#欸…啊！{F#妳}{M#你}好{F#妳}{M#你}好{F#妳}{M#你}好，歡…歡迎來璃月港！海燈節歡迎{F#妳}{M#你}…不對不對，璃月港歡迎{F#妳}{M#你}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716720105
					],
					"speakerTitle": "報菲"
				},
				{
					"id": 716720105,
					"content": "萍溪姐沒看見吧？好，應該沒看見…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716720106
					],
					"speakerTitle": "報菲"
				},
				{
					"id": 716720106,
					"content": "歡迎來到璃月港！您一定是來參加海燈節的，對吧？那麼，您一定不能錯過我設計的小遊藝「月映仙蹤」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716720107
					],
					"speakerTitle": "報菲"
				},
				{
					"id": 716720107,
					"content": "妳這是進入工作狀態了啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716720108
					]
				},
				{
					"id": 716720108,
					"content": "別、別拆穿啊！要是被萍溪姐發現我走神，我肯定又要挨訓了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716720109
					],
					"speakerTitle": "報菲"
				},
				{
					"id": 716720109,
					"content": "#我可是磨了好久的嘴皮子才讓她同意我過來擺攤的，{F#妳}{M#你}先聽我說完…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716720110
					],
					"speakerTitle": "報菲"
				},
				{
					"id": 716720110,
					"content": "咳、咳咳，「月映仙蹤」是取材自流傳在我們璃月港的「白馬仙人」傳說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716720111
					],
					"speakerTitle": "報菲"
				},
				{
					"id": 716720111,
					"content": "據傳說呢，這位仙人常常在天上循著月光游弋，為璃月港驅除邪魔妖祟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716720112
					],
					"speakerTitle": "報菲"
				},
				{
					"id": 716720112,
					"content": "…哎呀，但這種傳說我都覺得太無聊了，所以…嘿嘿，特意在這個小遊戲裡加入了一些聽來的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716720113
					],
					"speakerTitle": "報菲"
				},
				{
					"id": 716720113,
					"content": "比如…其實天上一直有怪物，想要吞掉整個月亮！多虧了白馬仙人，那些怪物才沒能得逞…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716720114
					],
					"speakerTitle": "報菲"
				},
				{
					"id": 716720114,
					"content": "雖然我不知道月亮被吞掉的時候具體是什麼樣…但劉蘇說，就和我們啃燒餅一樣，怪物嘎嘎嘎地把月亮慢慢吞進肚子裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716720115
					],
					"speakerTitle": "報菲"
				},
				{
					"id": 716720115,
					"content": "但我過幾天去聽，劉蘇他又換了一種說法，說什麼怪物就和吃湯圓一樣，啊嗚一口，就把月亮整個吞下去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716720116
					],
					"speakerTitle": "報菲"
				},
				{
					"id": 716720116,
					"content": "不過，在故事的最後，白馬仙人總是會藉助著霄燈的光芒，把所有魔物都一口氣驅散掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716720117
					],
					"speakerTitle": "報菲"
				},
				{
					"id": 716720117,
					"content": "這也是傳說？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716720118
					],
					"speakerTitle": "報菲"
				},
				{
					"id": 716720118,
					"content": "反正劉蘇說的那段書是這麼說的，我覺得很帥氣，就把這段故事也加入「月映仙蹤」裡啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716720119
					],
					"speakerTitle": "報菲"
				},
				{
					"id": 716720119,
					"content": "呃，不好不好，我不能閒聊了，還是要辦正事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716720120
					],
					"speakerTitle": "報菲"
				},
				{
					"id": 716720120,
					"content": "#{F#妳}{M#你}想要試玩「月映仙蹤」的話，就和我說一聲，所有東西都準備齊全了，隨時可以開始。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "報菲"
				},
				{
					"id": 716720103,
					"content": "妳是準備說書嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716720104
					]
				}
			]
		}
	]
}