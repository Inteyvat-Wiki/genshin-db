			"dialogs": [
				{
					"id": 761010201,
					"content": "葉洛亞！你總算回來了，尼基塔執燈長正在等你呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010202
					],
					"speakerTitle": "奧拉維"
				},
				{
					"id": 761010202,
					"content": "欸？尼基塔…執燈長？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761010203,
					"content": "#{NICKNAME}，「尼基塔」不就是委託我們去找「銀燈芯」的那個老爺爺嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761010204,
					"content": "我記得他明明說自己只是個普通的執燈士…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010205,
						761010206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761010205,
					"content": "是啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761010207
					]
				},
				{
					"id": 761010207,
					"content": "#老爺子還真是的…唉，{F#妳}{M#你}們就當是他的惡作劇吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010208
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 761010208,
					"content": "先不說這些了，我們去向他報告情況吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 761010206,
					"content": "不，他怎麼看都不像普通執燈士吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761010207
					]
				}
			]
		},
