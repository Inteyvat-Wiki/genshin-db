			},
			"dialogs": [
				{
					"id": 761010301,
					"content": "老爺子，我們回來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010302
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 761010302,
					"content": "回來就好，苦壑崖的情況怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010303
					],
					"speakerTitle": "尼基塔"
				},
				{
					"id": 761010303,
					"content": "簡明扼要地說明了情況…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761010304
					]
				},
				{
					"id": 761010304,
					"content": "果然如此啊…從這裡也能清楚地觀測到，厄布拉神柱完全被深淵力量…被那不死的妖魔「教授」給控制了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010305
					],
					"speakerTitle": "尼基塔"
				},
				{
					"id": 761010305,
					"content": "但它目前還沒有太大的動作，想來是那位愛莉厄小姐在全力與之抗衡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010306
					],
					"speakerTitle": "尼基塔"
				},
				{
					"id": 761010306,
					"content": "她為我們爭取來的時間難能可貴，一點也不能浪費。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010307
					],
					"speakerTitle": "尼基塔"
				},
				{
					"id": 761010307,
					"content": "所幸在菲林斯和大家的幫助下，準備工作已經完成得差不多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010308
					],
					"speakerTitle": "尼基塔"
				},
				{
					"id": 761010308,
					"content": "有了你們帶回來的「螺旋劍」，「德肋庇革勞諾之箭」也就成型了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010309
					],
					"speakerTitle": "尼基塔"
				},
				{
					"id": 761010309,
					"content": "呃…「德肋庇革勞諾之箭」是什麼？是跟「銀燈芯」、「螺旋劍」一樣厲害的聖物嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761010310,
					"content": "哈哈，是比那些更厲害的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010311
					],
					"speakerTitle": "尼基塔"
				},
				{
					"id": 761010311,
					"content": "五百年前，鑄燈者力有未逮，只將那不死的妖魔封印於苦壑崖之下。但在那之後，鑄燈者和初代詠月使也並未放棄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010312
					],
					"speakerTitle": "尼基塔"
				},
				{
					"id": 761010312,
					"content": "為了在未來的某一天徹底終結那不死的妖魔，他們用古老的技術打造了這把「弓矢」，由我們執燈人代代守護至今。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010313
					],
					"speakerTitle": "尼基塔"
				},
				{
					"id": 761010313,
					"content": "現在終於到讓它完成使命的時刻了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010314
					],
					"speakerTitle": "尼基塔"
				},
				{
					"id": 761010314,
					"content": "哦…居然有這麼厲害的箭，真想看看…它長什麼樣子啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761010315,
					"content": "傻孩子，你們早就見過了。不如說，我們就在「德肋庇革勞諾之箭」裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010316,
						761010318
					],
					"speakerTitle": "尼基塔"
				},
				{
					"id": 761010316,
					"content": "啊？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761010317
					]
				},
				{
					"id": 761010317,
					"content": "難、難道是要把我們一起發射出去…怎麼想都不可能吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761010320,
					"content": "這座麥酒大廳就是圍繞「德肋庇革勞諾之箭」建造的，而你們帶回的「螺旋劍」，正是它所缺失的箭頭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010321
					],
					"speakerTitle": "尼基塔"
				},
				{
					"id": 761010321,
					"content": "只要將「螺旋劍」裝填進這裡，就能讓「德肋庇革勞諾之箭」進入發射準備了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010322
					],
					"speakerTitle": "尼基塔"
				},
				{
					"id": 761010322,
					"content": "但這不是壁爐嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761010323,
					"content": "是壁爐，也是讓「螺旋劍」化為「箭鏃」的特殊裝置。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010324
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 761010324,
					"content": "趁那個「惡卵」尚未孵化…用這傳承至今的「弓矢」，將牠徹底葬送吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010325
					],
					"speakerTitle": "尼基塔"
				},
				{
					"id": 761010325,
					"content": "在此期間，想必那不死的妖魔還會垂死掙扎吧。不管它送來多少爪牙，我們一定會替你們攔下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010326
					],
					"speakerTitle": "尼基塔"
				},
				{
					"id": 761010326,
					"content": "發射「德肋庇革勞諾之箭」的重任，就交給你們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "尼基塔"
				},
				{
					"id": 761010318,
					"content": "是要把我也發射出去嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761010319
					]
				},
				{
					"id": 761010319,
					"content": "#原來{NICKNAME}就是我們的最終決戰兵器！…才不是吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010320
					],
					"speakerTitle": "派蒙"
				}
			]
		},
