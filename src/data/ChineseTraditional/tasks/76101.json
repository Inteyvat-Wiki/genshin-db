					}
				]
			},
			"dialogs": [
				{
					"id": 761011301,
					"content": "通往魔天的門扉已經開啟，此等微弱的月矩力能奈我何！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011302
					],
					"speakerTitle": "「教授」"
				},
				{
					"id": 761011302,
					"content": "但為何我會被困囿於此…我明白了，是三寶磨又一次拒絕了我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011303
					],
					"speakerTitle": "「教授」"
				},
				{
					"id": 761011303,
					"content": "看看是誰來了，稀客啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011304
					],
					"speakerTitle": "愛莉厄"
				},
				{
					"id": 761011304,
					"content": "…誰在那裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011305
					],
					"speakerTitle": "「教授」"
				},
				{
					"id": 761011305,
					"content": "這副模樣…啊，是你，雷勒。太好了，我就知道你還活著。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011306
					],
					"speakerTitle": "「教授」"
				},
				{
					"id": 761011306,
					"content": "現在，命令三寶磨的力量臣服於我！擁有聖嗣之血的你一定能做到。畢竟和那三個廢物不同，你是我最欣賞的弟子啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011307
					],
					"speakerTitle": "「教授」"
				},
				{
					"id": 761011307,
					"content": "哈，居然把我認作了雷勒…當年那個巧舌如簧的妖僧竟然昏聵至此，真是諷刺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011308
					],
					"speakerTitle": "愛莉厄"
				},
				{
					"id": 761011308,
					"content": "不要猶豫，雷勒。你忘記我們共同的理想了嗎？你不想取回那本應屬於你的地位與身分了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011309
					],
					"speakerTitle": "「教授」"
				},
				{
					"id": 761011309,
					"content": "為受欺凌和侮辱的人們創造「樂園」，讓那些醜陋的妖精貴族都對你俯首，整個蒼星王廷只有同為人類的我願意幫你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011310
					],
					"speakerTitle": "「教授」"
				},
				{
					"id": 761011310,
					"content": "如今，只差最後一步我就能登上群星的階梯…當天穹之外的「樂園」降臨時，唯有你我這樣的受選之人才能夠活下來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011311
					],
					"speakerTitle": "「教授」"
				},
				{
					"id": 761011311,
					"content": "那時，所有的腐敗與汙穢都將被洗淨，這不正是你所渴望的世界嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011312
					],
					"speakerTitle": "「教授」"
				},
				{
					"id": 761011312,
					"content": "不，那並非他想要的世界…都到這種時候了，還在試圖施展你那拙劣的騙術嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011313
					],
					"speakerTitle": "愛莉厄"
				},
				{
					"id": 761011313,
					"content": "從一開始你就在利用他，所有的謊言都不過是為了讓他替你取得三寶磨，你口中的那個「樂園」從來就只有你自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011314
					],
					"speakerTitle": "愛莉厄"
				},
				{
					"id": 761011314,
					"content": "就連他一開始會丟掉軍官的身分成為大盜，也是因為你和阿爾維斯大公共同設下的圈套吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011315
					],
					"speakerTitle": "愛莉厄"
				},
				{
					"id": 761011315,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011316
					],
					"speakerTitle": "「教授」"
				},
				{
					"id": 761011316,
					"content": "雖然你認錯了人，不過繼承了他身分與意志的我，當然也不會拒絕雷德·米勒之名。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011317
					],
					"speakerTitle": "愛莉厄"
				},
				{
					"id": 761011317,
					"content": "以雷德·米勒的名義，拉烏斯萬格、妖僧、「教授」、不死的毒蛇…就由我為你的故事畫上最後的句點吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011318
					],
					"speakerTitle": "愛莉厄"
				},
				{
					"id": 761011318,
					"content": "我們做到了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011319
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 761011319,
					"content": "這次終於，將那不死的妖魔徹底葬送了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011320
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 761011320,
					"content": "「那不死的毒蛇必將兩度復活，再被三次擊倒…直到被月下世界的英雄們徹底埋葬…」\\n與英勇的執燈士們並肩作戰，終於消滅了「教授」…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761011321
					]
				},
				{
					"id": 761011321,
					"content": "之後，在皮拉米達城盤桓了數日…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		}
	]
