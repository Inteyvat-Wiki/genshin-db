			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"萍姥姥"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10140101,
					"content": "世事無常，世事無常…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140102,
						10140105
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140102,
					"content": "您好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140103
					]
				},
				{
					"id": 10140103,
					"content": "#咦？年輕人，{F#妳}{M#你}是來賞花的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140104
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140104,
					"content": "#可惜啊，{F#妳}{M#你}來得不是時候，這「琉璃百合」，都要謝完了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140107
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140107,
					"content": "這些花…為什麼都謝了呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10140108,
					"content": "在我那個年頭，人們說「琉璃百合」通人性。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140109
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140109,
					"content": "如果它們聽見了好聲音，比如笑聲啦，歌聲啦…它們就會很高興，會長得很好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140110
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140110,
					"content": "但如果反過來，聽了太多不好的聲音…比如亂七八糟的流言蜚語，它們就會枯萎得很快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140111
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140111,
					"content": "…所以，現在璃月港裡的狀況，這些花也感覺到了呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10140112,
					"content": "是啊，岩王帝君之死的傳言，可不是小事。這大街小巷裡，說什麼的都有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140113
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140113,
					"content": "有人說是愚人眾的陰謀，有人說是「海裡的東西」要鎮不住了，還有人說，這些都是七星自導自演的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140114
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140114,
					"content": "這座港口，就和柴火堆一樣。只要一點火星，火就要止不住了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140115
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140115,
					"content": "#唉，話頭就到這打住吧，我老婆子年紀大了，就喜歡嘮叨…年輕人，{F#妳}{M#你}們找我有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140116,
						10140121
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140116,
					"content": "想借您的「滌塵鈴」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140117
					]
				},
				{
					"id": 10140117,
					"content": "喔，那個老東西啊…我記得。確實在我這，但是具體放在哪…我老婆子就記不清啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140118
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140118,
					"content": "那是我年輕的時候，一個老朋友身上戴著的小玩意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140119
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140119,
					"content": "他看我老是眼巴巴地看著，就把鈴鐺送給我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140120
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140120,
					"content": "但他當年就和我說，假如以後有人來借這個鈴鐺，我可不能捨不得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140127
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140127,
					"content": "這麼多年了，這鈴鐺也不知道被借走了多少次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140128
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140128,
					"content": "但是，不知道從什麼時候開始，已經很久沒人再來借這個鈴鐺啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140129
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140129,
					"content": "#唉，我這個老身子骨，找起東西來慢吞吞的，{F#妳}{M#你}們怕是等不得喲…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140130,
						10140133
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140130,
					"content": "我們自己來找就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140131
					]
				},
				{
					"id": 10140131,
					"content": "對，婆婆，我們陪您回家，然後我們自己來找。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10140132,
					"content": "還能…還能幫您收拾屋子呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10140135,
					"content": "#好啦，孩子們，那個鈴鐺我也沒有放多遠，{F#妳}{M#你}們也別太操心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140136
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140136,
					"content": "咦？婆婆，您家就在這附近嗎？嗚哇…這可是玉京臺呀，真有錢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140137
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10140137,
					"content": "呵呵，我老婆子可置辦不起城裡的房子——看看這個壺，我的全部家當都放在裡面啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140138
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140138,
					"content": "全部家當…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140139,
						10140140,
						10140143
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10140139,
					"content": "您是指，把屋子鑰匙放裡面了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140146
					]
				},
				{
					"id": 10140146,
					"content": "呵呵呵…孩子們，總之鈴鐺就放在這個壺裡。想找鈴鐺的話，就自己去看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140140,
					"content": "您的家當就一個鈴鐺嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140141
					]
				},
				{
					"id": 10140141,
					"content": "這麼說很不禮貌！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140142
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10140142,
					"content": "就，就算是這樣，那…那也是個很珍貴的鈴鐺！對吧，婆婆？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140146
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10140143,
					"content": "派蒙進壺裡看看吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140144
					]
				},
				{
					"id": 10140144,
					"content": "進不去！怎麼想我都進不去吧？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140145
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10140145,
					"content": "#而且{F#妳}{M#你}為什麼要讓我進去，掀開蓋子看看不就好了嗎！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140146
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10140133,
					"content": "我跟西風騎士團長學過找東西。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140134
					]
				},
				{
					"id": 10140134,
					"content": "唔…突然在意外的地方自豪起來了？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10140121,
					"content": "想找您借個東西…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140122
					]
				},
				{
					"id": 10140122,
					"content": "#東西？喔…{F#妳}{M#你}們是要來借「滌塵鈴」的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140123
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140123,
					"content": "#除了這個老東西，我也沒什麼值得{F#妳}{M#你}們年輕人來求的了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140124
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140124,
					"content": "不過，這鈴鐺本來也不是我的，本來是我一個老朋友戴著的小玩意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140125
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140125,
					"content": "我年輕的時候愛漂亮，喜歡那個鈴鐺，所以就黏著他，一個勁地央求…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140126
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140126,
					"content": "他拗不過我，所以就把鈴鐺送給我了。不過他和我說，假如以後有人來借鈴鐺，我可不能捨不得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140127
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140105,
					"content": "您怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140106
					]
				},
				{
					"id": 10140106,
					"content": "沒事，沒事，我只不過看見「琉璃百合」謝了太多，覺得太可惜了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140107
					],
					"speakerTitle": "萍姥姥"
				}
			]
		},
		{
			"id": 101402,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101406",
							"2"
						],
						"stepId": 101406,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"萍姥姥"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10140201,
					"content": "#孩子們，{F#妳}{M#你}們不是急著要鈴鐺嗎？還不快去找？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140202
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140202,
					"content": "#不過這壺我很久沒打掃，{F#妳}{M#你}們可要當心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140203
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140203,
					"content": "穿著這麼漂亮的衣服，弄髒的話，洗乾淨可要花功夫嘍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "萍姥姥"
				}
			]
		},
		{
			"id": 101403,
			"completionStepIds": [
				101403
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101403",
							"2"
						],
						"stepId": 101403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"萍姥姥"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10140301,
					"content": "年輕人手腳就是利索，這麼一會，就拿到了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140302,
						10140305,
						10140308
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140302,
					"content": "您是仙人嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140303
					]
				},
				{
					"id": 10140303,
					"content": "仙人…這兩個字，我老婆子可很久沒有聽人正經提起了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140304
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140304,
					"content": "#至於我是不是仙人，孩子，{F#妳}{M#你}心裡難道不明白嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140312
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140312,
					"content": "唔…好像懂了，又好像沒全懂。不過婆婆，您…就這麼把鈴鐺給我們了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10140313,
					"content": "您不奇怪嗎？岩王帝君剛出事，我們就急匆匆地找您來要鈴鐺…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10140314,
					"content": "傻孩子，璃月港古往今來，不知道有多少仙人離開，也不知道折騰出了多少風浪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140315
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140315,
					"content": "但無論是哪一次，都是按規矩先把「送仙典儀」辦體面了，再去安排後面的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140316
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140316,
					"content": "一個勁地喊著「抓兇手」，卻耽誤了「送仙典儀」，在我看來，才是本末倒置。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140317
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140317,
					"content": "#現在{F#妳}{M#你}們來借鈴鐺，我揣摩著，大概是哪位老朋友終於看不過眼，出來主持大局了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140318
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140318,
					"content": "#所以，我又怎麼會不肯借鈴鐺給{F#妳}{M#你}們呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140319,
						10140322
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140319,
					"content": "要是您的「老朋友」借了不還呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140320
					]
				},
				{
					"id": 10140320,
					"content": "不還？哈哈哈，要是他們真腆著臉這麼幹了，那我老婆子說不得就要走一趟了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140321
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140321,
					"content": "正好很久沒見，去找他們喝喝茶，聊聊天，也是很好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140326
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140326,
					"content": "好了，既然拿到了東西，就快點回去吧，可別誤事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140327
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140327,
					"content": "#再幫我給那位差遣{F#妳}{M#你}們的人帶句話，就說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140328
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140328,
					"content": "有空的話，過來喝喝茶也是可以的。老婆子我沒什麼家當，但總歸還是有盞茶壺的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140329
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140329,
					"content": "嗯！我們記住啦，謝謝婆婆！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10140322,
					"content": "這鈴鐺能送我嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140323
					]
				},
				{
					"id": 10140323,
					"content": "#喂！{F#妳}{M#你}這個人，這可是婆婆的東西呀！用完了就要還給人家！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140324
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10140324,
					"content": "#送{F#妳}{M#你}？{F#妳}{M#你}這孩子還真直白，哈哈哈，{F#妳}{M#你}想拿就拿著吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140325
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140325,
					"content": "不過這鈴鐺很戀家，指不定什麼時候啊，它就溜回我老婆子這來囉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140326
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140305,
					"content": "您是「璃月七星」的人吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140306
					]
				},
				{
					"id": 10140306,
					"content": "「璃月七星」…那些孩子，很久之前就不願意讓我這老婆子…還有我的老夥計們…去幫工嘍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140307
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140307,
					"content": "不過，這些年他們做得也不錯。我們這些老傢伙，也樂得個清閒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140312
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140308,
					"content": "難道您是愚人眾的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140309
					]
				},
				{
					"id": 10140309,
					"content": "#愚人眾？哈哈哈，{F#妳}{M#你}這孩子，心思倒是多得很，成天都在想些什麼歪門故事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140310
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140310,
					"content": "我老婆子一把年紀了，可懶得和這些外人折騰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140311
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140311,
					"content": "不過，他們的手要是再伸長一點，該勞碌的，還是要勞碌的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140312
					],
					"speakerTitle": "萍姥姥"
				}
			]
		},
