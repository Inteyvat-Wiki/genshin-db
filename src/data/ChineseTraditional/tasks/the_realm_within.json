					"鍾離"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10140401,
					"content": "不錯，這正是「滌塵鈴」…嗯，保管得還真不錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140402
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10140402,
					"content": "我們順便把之前做好的香膏也安放了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140403,
						10140405
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10140403,
					"content": "你認識萍姥姥？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140404
					]
				},
				{
					"id": 10140404,
					"content": "自然是認識的，不然我怎麼會知道，這枚鈴鐺在她那？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140407
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10140407,
					"content": "嗯…疑點重重！但你不想說的話，我們也就先不追問了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10140408,
					"content": "對了，那位婆婆讓我們帶句話給你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10140409,
					"content": "「有空的話，過來喝喝茶也是可以的。老婆子我沒什麼家當，但總歸還是有盞茶壺的。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10140410,
					"content": "哈哈哈，這語氣可不太適合妳。不過，她的茶壺確實很不錯，用來泡茶再好不過了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140411
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10140411,
					"content": "等到了合適的時候，我自然會帶著好茶…去見她的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140412
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10140412,
					"content": "那麼，儀式下一項準備，該是什麼了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10140413,
					"content": "嗯，下一項…我們去買<color=#00E1FFFF>風箏</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140414
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10140414,
					"content": "風箏！鍾離要帶我們去玩風箏了嗎？這算是…中場休息？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10140415,
					"content": "哈哈，不是那樣。風箏雖說是孩子的玩具，但在璃月的種種儀式上，還有其它象徵意義。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140416
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10140416,
					"content": "#我會為{F#妳}{M#你}們解釋的。但我們接下來的行動，還是先去把風箏買到手再說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140417
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10140417,
					"content": "唔…好吧，一頭霧水…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10140405,
					"content": "你也是仙人？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140406
					]
				},
				{
					"id": 10140406,
					"content": "仙人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140407
					],
					"speakerTitle": "鍾離"
				}
			]
		},
