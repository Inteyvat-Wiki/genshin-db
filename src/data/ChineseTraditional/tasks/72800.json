							"2"
						],
						"stepId": 7280004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"？？？",
					"朱莉",
					"芭爾瓦涅",
					"旭東"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728000201,
					"content": "…你們有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000202
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 728000202,
					"content": "請問你是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000203
					]
				},
				{
					"id": 728000203,
					"content": "我是龜井宗久，只是個路過的人而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000204
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 728000204,
					"content": "嗚哇…這個大叔的穿著，感覺就像「武士」一樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000205
					],
					"speakerTitle": "朱莉"
				},
				{
					"id": 728000205,
					"content": "武、武士嗎？難道是幕府的那個「武士」…我聽說，幕府對外國人的態度很…微妙來著…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000206
					],
					"speakerTitle": "芭爾瓦涅"
				},
				{
					"id": 728000206,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000207
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 728000207,
					"content": "不用擔心。我已經離開幕府，不再是個武士了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000208
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 728000208,
					"content": "我經常來這裡找可以吃的東西，但今天過來的時候，發現有魔物在這附近遊蕩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000209
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 728000209,
					"content": "而且周圍的食材似乎也被它們搜刮乾淨了，我就不得不把它們全部打倒了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000210,
						728000212,
						728000214
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 728000210,
					"content": "你經常來這裡？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000211
					]
				},
				{
					"id": 728000211,
					"content": "這裡平時並沒有什麼魔物，我經常來這取一些水果，或者獵一些動物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000217
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 728000217,
					"content": "話就說到這吧，我打倒這些魔物之後，周圍的魔物應該也暫時不敢過來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000218
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 728000218,
					"content": "如果你們也是來找食物的話，可以去周圍找找，我只拿了我一個人的份，應該還有不少食材留下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000219
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 728000219,
					"content": "那麼，在下先告辭了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000220
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 728000220,
					"content": "就、就這麼走了。感覺這個大叔的作風，和我之前聽說的武士作風也一模一樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000221
					],
					"speakerTitle": "朱莉"
				},
				{
					"id": 728000221,
					"content": "但是，他說自己離開了幕府是什麼意思？而且離開了幕府的武士，不就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000222,
						728000223
					],
					"speakerTitle": "芭爾瓦涅"
				},
				{
					"id": 728000222,
					"content": "就像是之前遇見過的敵人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000224
					]
				},
				{
					"id": 728000224,
					"content": "對，之前我也聽說，有一些脫離幕府四處流浪的武士，為了生計到處劫掠行人什麼的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000225
					],
					"speakerTitle": "芭爾瓦涅"
				},
				{
					"id": 728000225,
					"content": "雖然那位大叔看起來不像是那些惡徒，但我們還是提高警惕比較好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000226
					],
					"speakerTitle": "芭爾瓦涅"
				},
				{
					"id": 728000226,
					"content": "好了，好了。我們來這裡不是尋找食材的嗎？不過看周圍這個情況，我們還是別再繼續深入了，免得再遇見什麼危險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000227
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 728000227,
					"content": "這位旅行者護送了我們這麼久，應該也累了，我們就在這裡做點吃的，迅速休整一下，然後回城去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000228
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 728000228,
					"content": "那位大叔說，周圍還有剩下的食材對吧？我們去周圍找找看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "旭東"
				},
				{
					"id": 728000223,
					"content": "就像是「海亂鬼」一樣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000224
					]
				},
				{
					"id": 728000212,
					"content": "這些魔物都是你打倒的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000213
					]
				},
				{
					"id": 728000213,
					"content": "是的，都只是一些普通的魔物而已，對付起來很容易。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000217
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 728000214,
					"content": "你為什麼要在野外找食物？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000215
					]
				},
				{
					"id": 728000215,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000216
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 728000216,
					"content": "我有我自己的原因。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000217
					],
					"speakerTitle": "？？？"
				}
			]
		},
		{
			"id": 7280003,
			"completionStepIds": [
				7280011
			],
