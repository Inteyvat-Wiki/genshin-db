						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280011",
							"2"
						],
						"stepId": 7280011,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"旭東",
					"朱莉",
					"芭爾瓦涅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728000301,
					"content": "本來想要找點新鮮食材…算了，這些應該也能用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000302
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 728000302,
					"content": "#抱歉啦，本來是想給{F#妳}{M#你}做點好吃的，現在看來，只能湊合做點了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000303,
						728000306
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 728000303,
					"content": "沒關係。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000304
					]
				},
				{
					"id": 728000304,
					"content": "#{F#妳}{M#你}這麼辛苦護送我們，可不能一句「沒關係」就略過了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000305
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 728000305,
					"content": "#這頓飯我先記下，下次一定請{F#妳}{M#你}吃頓好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000308
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 728000308,
					"content": "朱莉，燉的湯應該好了吧？記得別讓芭爾瓦涅…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000309
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 728000309,
					"content": "唔唔，不、不要啦，只要讓湯安安靜靜地燉著就好了啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000310
					],
					"speakerTitle": "朱莉"
				},
				{
					"id": 728000310,
					"content": "沒關係，我可是按照我改良過的食譜在給這份湯調味，只不過是放一點調料而已…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000311
					],
					"speakerTitle": "芭爾瓦涅"
				},
				{
					"id": 728000311,
					"content": "那份妳改良過的食譜我都看不懂啦，快點住手！旭東，旭東快來呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000312
					],
					"speakerTitle": "朱莉"
				},
				{
					"id": 728000312,
					"content": "芭爾瓦涅！喂！妳又在往裡面放什麼奇怪的調味料！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000313
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 728000313,
					"content": "奇怪的調料？那是我研製的特別調料！這可是我用論文論述過的研究成果！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000314
					],
					"speakerTitle": "芭爾瓦涅"
				},
				{
					"id": 728000314,
					"content": "不用了！我們今天就吃一點普通的東西就好了！朱莉，拉住她！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000315
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 728000315,
					"content": "哼，真是不識貨…算了，等我再完善完善吧，我一定能做出那種只要放進菜裡，無論什麼菜都能變美味的萬能調味料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000316
					],
					"speakerTitle": "芭爾瓦涅"
				},
				{
					"id": 728000316,
					"content": "萬能調味料…這種東西真的能做出來嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000317
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 728000317,
					"content": "就是因為沒人做出來，我才要做出來。然後，我就能讓教令院裡那幫死腦筋的傢伙好好地震驚一下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000318
					],
					"speakerTitle": "芭爾瓦涅"
				},
				{
					"id": 728000318,
					"content": "哈哈…好吧，我會好好期待的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000319
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 728000319,
					"content": "#對了，旅行者，謝謝{F#妳}{M#你}陪我們在外面跑了這麼久，這次辛苦{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000320
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 728000320,
					"content": "#我再幫{F#妳}{M#你}打包一份帶走吧，在外面冒險，可一定要吃飽喝足才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000321
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 728000321,
					"content": "#下次我們見面的時候，我一定會請{F#妳}{M#你}吃一頓好菜的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "旭東"
				},
				{
					"id": 728000306,
