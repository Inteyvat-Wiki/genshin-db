			"dialogs": [
				{
					"id": 760300101,
					"content": "哦~今天這裡的氛圍有點不尋常。哥倫比婭妳在妝點這處花田嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760300102,
					"content": "不是我，是它們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300103
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760300103,
					"content": "它們…月靈？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760300104,
					"content": "這種石頭在吸收了月矩力之後會泛出微光，月靈們很喜歡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300105
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760300105,
					"content": "所以它們就…把石頭放在地上玩？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760300106,
					"content": "#{F#妳}{M#你}們到這裡來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300107
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760300107,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760300108,
					"content": "哦！原來從高處看的話是一幅畫欸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760300109,
					"content": "但好像缺了一塊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760300110
					]
				},
				{
					"id": 760300110,
					"content": "有點不夠了，我去採一點吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300111
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760300111,
					"content": "咦？妳要出去採？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760300112,
					"content": "我知道一個不錯的地方，那裡月光照拂，有很多這樣的石頭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300113
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760300113,
					"content": "要我們陪妳嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760300114
					]
				},
				{
					"id": 760300114,
					"content": "好啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300115
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760300115,
					"content": "嗯，那就多採一些吧，我們也想看看完整的畫呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
