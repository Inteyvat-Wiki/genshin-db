			"dialogs": [
				{
					"id": 760300301,
					"content": "這樣就夠了吧。總覺得已經採了好多好多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760300302,
					"content": "我們回去吧，也不能老讓那畫缺一塊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760300303,
					"content": "嗚嗚…嗚嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300304
					],
					"speakerTitle": "莉潔卡"
				},
				{
					"id": 760300304,
					"content": "呀！有人過來了，先躲起來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760300305,
					"content": "嗚嗚…這裡是哪裡呀…媽媽…我想回家…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300306
					],
					"speakerTitle": "莉潔卡"
				},
				{
					"id": 760300306,
					"content": "看起來是「霜月之子」的人欸，她迷路了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760300307,
					"content": "我去幫幫她吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760300308
					]
				},
				{
					"id": 760300308,
					"content": "真的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300309
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760300309,
					"content": "啊？這怎麼看都得幫吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760300310,
					"content": "我記得「霜月之子」對「外來者」很戒備。這麼晚了，你頭上沒有角冠，如果她反倒被嚇跑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300311
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760300311,
					"content": "你…你說得倒的確有可能，但也不能就這麼不管吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760300312,
					"content": "唔…跟我來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300313
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760300313,
					"content": "欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
