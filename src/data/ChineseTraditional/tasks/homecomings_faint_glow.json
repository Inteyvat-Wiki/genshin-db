			"dialogs": [
				{
					"id": 760300501,
					"content": "嗚嗚…咦？這是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300502
					],
					"speakerTitle": "莉潔卡"
				},
				{
					"id": 760300502,
					"content": "好漂亮…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300503
					],
					"speakerTitle": "莉潔卡"
				},
				{
					"id": 760300503,
					"content": "這樣就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300504
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760300504,
					"content": "哦~她一路撿著石頭回去了，那邊是「霜月之坊」的方向呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760300505,
					"content": "（哥倫比婭…雖說自己不想被當作「神明」，但還是會幫助遇到困難的人…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760300506
					]
				},
				{
					"id": 760300506,
					"content": "啊，但這麼一來，那幅畫是不是就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760300507,
					"content": "沒關係。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300508
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760300508,
					"content": "殘缺的畫可以之後再加上去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300509
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760300509,
					"content": "我喜歡看人們找到「回家」的路，回到屬於他們的「家」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				}
			]
