			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凱瑟琳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200300101,
					"content": "#歡迎來到<color=#00E1FFFF>冒險家協會</color>，我已經觀察{F#妳}{M#你}很久了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300102
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 200300102,
					"content": "#觀察{NICKNAME}？難道我的夥伴做了什麼奇怪的事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200300103,
					"content": "沒有沒有，發現優秀的冒險者，這也是我的工作之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300104
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 200300104,
					"content": "#從{F#妳}{M#你}的身上，我能看到與那些傳說中的冒險家比肩的資質。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300105
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 200300105,
					"content": "嘿嘿，這個我也看得出來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200300106,
					"content": "#跟著{NICKNAME}冒險，總感覺很安心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200300107,
					"content": "嗯嗯，不過對冒險家來說，閱歷比資質更加重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300108
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 200300108,
					"content": "只有不斷累積<color=#00E1FFFF>「冒險閱歷」</color>，才能提高<color=#00E1FFFF>「冒險等階」</color>的評定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300109
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 200300109,
					"content": "事不宜遲，就由我為剛入籍的冒險家介紹一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300110
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 200300110,
					"content": "等一下！我們已經成為正式冒險家了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200300111,
					"content": "放心，冒險家協會無需會費，也更不會強制冒險家履行什麼義務。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300112
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 200300112,
					"content": "換句話說，加入協會是只有好處，沒有壞處的哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300113,
						200300114
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 200300113,
					"content": "好吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200300116
					]
				},
				{
					"id": 200300116,
					"content": "總之，每當「冒險等階」提升，冒險家協會都會提供獎勵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300117
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 200300117,
					"content": "#這就當做協會的新人禮了，請{F#妳}{M#你}親自確認一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300118
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 200300118,
					"content": "冒險等階獎勵",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 200300114,
					"content": "我現在就要好處！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200300115
					]
				},
				{
					"id": 200300115,
					"content": "哈哈…現在的新人怎麼變得這麼直接了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300116
					],
					"speakerTitle": "凱瑟琳"
				}
			]
		},
		{
			"id": 2003002,
			"completionStepIds": [
				2003003,
				2003004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2003003",
							"2"
						],
						"stepId": 2003003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凱瑟琳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200300201,
					"content": "#那麼容我正式歡迎{F#妳}{M#你}的加入，冒險家新星！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300202
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 200300202,
					"content": "#這是{F#妳}{M#你}的<color=#00E1FFFF>「冒險之證」</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300203,
						200300205
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 200300203,
					"content": "還有證書？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200300204
					]
				},
				{
					"id": 200300204,
					"content": "新人加入這麼重要的事，當然要有儀式感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300207
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 200300207,
					"content": "這上面記載了很多關於協會的委託和獎勵的資訊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300208
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 200300208,
					"content": "同時這也是會員的證明，記得多多查看並妥善保管哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300209
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 200300209,
					"content": "對了，還有一件事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300210
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 200300210,
					"content": "「冒險等階」的提升是會有瓶頸存在的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300211
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 200300211,
					"content": "到那時就需要完成一些「令人印象深刻的任務」來得到協會的進一步認可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300212
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 200300212,
					"content": "令人印象深刻…的任務？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200300213,
					"content": "可以說是用來突破「冒險等階」上限的「突破任務」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300214
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 200300214,
					"content": "#現在還不是時候，當{F#妳}{M#你}的「閱歷」足夠豐富，自然就會有博得大家認可的機會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300215
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 200300215,
					"content": "那麼今天就先這樣吧，以後我們應該還會經常見面的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300216
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 200300216,
					"content": "努力吧冒險家，向著星辰與深淵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 200300205,
					"content": "這是…宣傳手冊？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200300206
					]
				},
				{
					"id": 200300206,
					"content": "這麼說也可以，但它的功能性更強。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300207
					],
					"speakerTitle": "凱瑟琳"
				}
			]
		}
	]
}