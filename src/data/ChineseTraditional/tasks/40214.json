				]
			},
			"dialogs": [
				{
					"id": 766530301,
					"content": "您總算來了，愛諾…女士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530302
					],
					"speakerTitle": "薩林"
				},
				{
					"id": 766530302,
					"content": "#嗯？這不是大名鼎鼎的{NICKNAME}和{M#他的}{F#她的}精靈旅伴嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530303
					],
					"speakerTitle": "薩林"
				},
				{
					"id": 766530303,
					"content": "你認識我們？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766530304,
					"content": "#我叫薩林，是挪德卡萊冒險家協會的分會長。考慮一下{F#妳}{M#你}們在冒險家協會內部的聲望吧，我不認識{F#妳}{M#你}們的話算是嚴重失職呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530305
					],
					"speakerTitle": "薩林"
				},
				{
					"id": 766530305,
					"content": "哦，原來是這樣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766530306,
					"content": "原來你們認識。不過我還是要確認一下，你的訂單是哪一張？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530307
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 766530307,
					"content": "我也滿好奇的，冒險家協會要找愛諾幫什麼忙？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766530308,
					"content": "#唉…{F#妳}{M#你}們知道的，冒險家們在野外遇到的一大問題就是各種攔路的敵人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530309
					],
					"speakerTitle": "薩林"
				},
				{
					"id": 766530309,
					"content": "要是在其他國家，協會還能與當地的管理者合作，為冒險家們提供一些保護。但在挪德卡萊這種地方，協會就只能靠自己了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530310
					],
					"speakerTitle": "薩林"
				},
				{
					"id": 766530310,
					"content": "不久前我想到了一個點子——設計一種可以隨身攜帶的防身裝置，讓那些不擅長戰鬥的冒險家也可以擊退強大的敵人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530311
					],
					"speakerTitle": "薩林"
				},
				{
					"id": 766530311,
					"content": "可惜最終失敗了…我終究沒有這方面的才華，只能求助於專業人士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530312
					],
					"speakerTitle": "薩林"
				},
				{
					"id": 766530312,
					"content": "我想起那份訂單了。點子很好，設計太差。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530313
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 766530313,
					"content": "所以才要拜託愛諾…女士啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530314
					],
					"speakerTitle": "薩林"
				},
				{
					"id": 766530314,
					"content": "這份訂單的難點在於，他設計的防身裝置使用了來自其他國家的技術，無法適應挪德卡萊的月矩力環境。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530315
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 766530315,
					"content": "這個訂單需要我們做的事並不複雜，主要就是帶著他的裝置找一些敵人進行測試，然後改進設計。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530316
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 766530316,
					"content": "測試的時候，我也能順便收集一些與月矩力環境有關的資料，所以這份訂單很划算。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530317
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 766530317,
					"content": "不過，自己的身手一定要夠好。萬一這種裝置不夠力，就得靠自己了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530318,
						766530319
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 766530318,
					"content": "小問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766530320
					]
				},
				{
					"id": 766530320,
					"content": "那就拜託各位了，有需要我的地方儘管說。成功之後，挪德卡萊冒險家協會一定會支付豐厚的報酬！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "薩林"
				},
				{
					"id": 766530319,
					"content": "我喜歡戰鬥！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766530320
					]
				}
			]
		}
	]
}