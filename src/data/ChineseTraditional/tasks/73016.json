			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"蘭百梨迦",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730160301,
					"content": "那菈…和會飛的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160302
					],
					"speakerTitle": "蘭百梨迦"
				},
				{
					"id": 730160302,
					"content": "#對啦，我是會飛的派蒙，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}是{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730160303,
					"content": "你應該就是蘭百梨迦了吧，話說回來，你一點也不怕我們呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730160304,
					"content": "金色的那菈，有蘭般度的氣息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160305
					],
					"speakerTitle": "蘭百梨迦"
				},
				{
					"id": 730160305,
					"content": "啊，這個嘛，的確是蘭般度讓我們來的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730160306,
					"content": "感受不到惡意。想對我下手，應該趁大鐵塊還能動的時候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160307
					],
					"speakerTitle": "蘭百梨迦"
				},
				{
					"id": 730160307,
					"content": "確實，這就叫「趁蘭那羅之危」嗎…不對不對，我們才不會做那種事啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730160308,
					"content": "為什麼不做？如果我是敵人，包夾敵人是好的方法，連動物捕獵時都會用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160309
					],
					"speakerTitle": "蘭百梨迦"
				},
				{
					"id": 730160309,
					"content": "唔…好有道理…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730160310,
					"content": "派蒙糊塗啦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160311
					]
				},
				{
					"id": 730160311,
					"content": "…總之，總之！我們一定不會「趁蘭那羅之危」就對了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730160312,
					"content": "因為蘭那羅是朋友。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160313
					]
				},
				{
					"id": 730160313,
					"content": "#對對對，就是這個，因為蘭那羅都是朋友！我和{NICKNAME}是不會做對不起朋友的事情的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730160314,
					"content": "哼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160315
					],
					"speakerTitle": "蘭百梨迦"
				},
				{
					"id": 730160315,
					"content": "呃…怎麼感覺他好像很不滿意的樣子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160316,
						730160318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730160316,
					"content": "派蒙沒有留下好的第一印象。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160317
					]
				},
				{
					"id": 730160317,
					"content": "可是我也沒覺得自己做錯了什麼呀…唔…蘭那羅的脾氣真難捉摸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730160320,
					"content": "對了，蘭般度說過，蘭百梨迦的「蘭迦拉梨」非常厲害。剛才他能夠擊敗遺蹟守衛，一定就是靠的「蘭迦拉梨」吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160321
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730160321,
					"content": "派蒙知道蘭迦拉梨？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160322
					],
					"speakerTitle": "蘭百梨迦"
				},
				{
					"id": 730160322,
					"content": "…喔、喔！我當然知道啦！就是…就是那個嘛！很厲害很厲害的…什麼能力！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730160323,
					"content": "哼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160324
					],
					"speakerTitle": "蘭百梨迦"
				},
				{
					"id": 730160324,
					"content": "嗚哇！感覺又被瞧不起了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160325
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730160325,
					"content": "還是說正事吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160326
					]
				},
				{
					"id": 730160326,
					"content": "嗯…我們是來幫忙治好法留納神機的！這裡應該也有法留納神機的「枝」和「葉」吧，不過好像沒看到呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160327
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730160327,
					"content": "什麼「枝」和「葉」，更像是「根」才對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160328
					],
					"speakerTitle": "蘭百梨迦"
				},
				{
					"id": 730160328,
					"content": "欸？是這樣嗎？可是蘭般度說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160329
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730160329,
					"content": "有了遍佈桓那的「根系」，法留納神機才能從桓那獲得力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160330
					],
					"speakerTitle": "蘭百梨迦"
				},
				{
					"id": 730160330,
					"content": "喔…好像也有點道理…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160331
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730160331,
					"content": "而且，「根」在地下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160332
					],
					"speakerTitle": "蘭百梨迦"
				},
				{
					"id": 730160332,
					"content": "這裡的石頭和鐵塊，不屬於蘭那羅。要下去，得先打敗鐵塊。鐵塊很強，但是金色的那菈也不弱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160333
					],
					"speakerTitle": "蘭百梨迦"
				},
				{
					"id": 730160333,
					"content": "#那是當然，{NICKNAME}已經不知道打敗過多少大鐵塊啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160334
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730160334,
					"content": "喔？那就讓蘭百梨迦也見識一下那菈的本領！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160335
					],
					"speakerTitle": "蘭百梨迦"
				},
				{
					"id": 730160335,
					"content": "欸？！他怎麼鑽進土裡了…啊！難道是已經去遺蹟守衛那邊了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160336
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730160336,
					"content": "#{NICKNAME}，我們快跟上他吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730160318,
					"content": "可能他對誰都是這樣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160319
					]
				},
				{
					"id": 730160319,
					"content": "怎麼會這樣呢？明明外表這樣可愛，脾氣卻這麼壞…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160320
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7301607,
			"completionStepIds": [
				7301607
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301607",
							"2"
						],
						"stepId": 7301607,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"蘭百梨迦",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730160701,
					"content": "我們已經打敗了大鐵塊，現在只要讓水流走，就可以下到地下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160702
					],
					"speakerTitle": "蘭百梨迦"
				},
				{
					"id": 730160702,
					"content": "但是，很久沒有來，全都和過去不一樣了，說不定地下也有大鐵塊，能感受到鐵的味道，是不好的味道，所以要小心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160703
					],
					"speakerTitle": "蘭百梨迦"
				},
				{
					"id": 730160703,
					"content": "#那菈{NICKNAME}是有本領的，不用擔心。但是派蒙，和蘭那庫拉一樣弱，小心被蘑菇吞掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160704
					],
					"speakerTitle": "蘭百梨迦"
				},
				{
					"id": 730160704,
					"content": "唔…是蘭百梨迦太強啦！我們之前也遇到過很多蘭那羅，應該還沒有誰能一擊就讓遺蹟守衛倒下的吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160705
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730160705,
					"content": "派蒙對蘭那羅知道得太少，如果是蘭帝裟，閉上眼睛再睜開的工夫，大鐵塊就被解決了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160706
					],
					"speakerTitle": "蘭百梨迦"
				},
				{
					"id": 730160706,
					"content": "蘭帝裟的蘭迦拉梨，過去是非常厲害的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160707
					],
					"speakerTitle": "蘭百梨迦"
				},
				{
					"id": 730160707,
					"content": "過去？那現在呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160708
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730160708,
					"content": "現在，蘭帝裟不在現在，所以蘭百梨迦才要更努力修煉蘭迦拉梨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160709
					],
					"speakerTitle": "蘭百梨迦"
				},
				{
					"id": 730160709,
					"content": "要是我也能學會「蘭迦拉梨」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160710,
						730160714
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730160710,
					"content": "那以後戰鬥就交給派蒙了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160711
					]
				},
				{
					"id": 730160711,
					"content": "#嘿嘿，就讓我來保護{NICKNAME}吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160712
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730160712,
					"content": "派蒙，加油！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160713
					]
				},
				{
					"id": 730160713,
					"content": "交給我吧！全都可以交給我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160718
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730160718,
					"content": "派蒙很會做夢，不知道是好事還是壞事。但是現在我們要找到石頭的機關，讓水流走，否則沒辦法到地下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160719
					],
					"speakerTitle": "蘭百梨迦"
				},
				{
					"id": 730160719,
					"content": "蘭那羅可以鑽進土裡，不能鑽進水裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160720
					],
					"speakerTitle": "蘭百梨迦"
				},
				{
					"id": 730160720,
					"content": "#嗯，{NICKNAME}，我們在附近找找看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730160714,
					"content": "派蒙應該學不會的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160715
					]
				},
				{
					"id": 730160715,
					"content": "我只要想學一定也能學會的啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160716
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730160716,
					"content": "會這樣說的人多半都…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160717
					]
				},
				{
					"id": 730160717,
					"content": "要不等我們到了安全的地方，吃過飯，休息好了，再拜託蘭百梨迦教我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160718
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7301610,
			"completionStepIds": [
				7301610
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301610",
							"2"
						],
						"stepId": 7301610,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙",
					"蘭百梨迦"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730161001,
					"content": "好像…好像都是壞掉的？都不會動欸！嚇、嚇死我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161002
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730161002,
					"content": "哼哼，什麼嘛，不就是些生鏽的鐵塊而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161003
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730161003,
					"content": "現在的桓那是危險的桓那，派蒙大意，會吃大虧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161004
					],
					"speakerTitle": "蘭百梨迦"
				},
				{
					"id": 730161004,
					"content": "唔…蘭百梨迦好嚴格喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161005
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730161005,
					"content": "是派蒙太散漫了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730161006
					]
				},
				{
					"id": 730161006,
					"content": "是這樣嗎？那…那我也像蘭百梨迦那樣嚴格的話，也能像他一樣強嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161007
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730161007,
					"content": "派蒙應該對自己嚴格而不是對別人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730161008
					]
				},
				{
					"id": 730161008,
					"content": "好喔，那就從明天開始對自己嚴格要求吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161009
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730161009,
					"content": "總之，既然石頭的「枝」就在這裡，接下來只要…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161010
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730161010,
					"content": "找到三個石頭都朝向這裡就可以了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161011
					],
					"speakerTitle": "蘭百梨迦"
				},
				{
					"id": 730161011,
					"content": "被、被搶答了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161012
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730161012,
					"content": "說起來，蘭百梨迦的說話風格和蘭般度差好多，完全不會用比喻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161013,
						730161015
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730161013,
					"content": "不過這樣更好懂。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730161014
					]
				},
				{
					"id": 730161014,
					"content": "直來直往的確很明白呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161017
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730161017,
					"content": "因為蘭般度想很多，蘭百梨迦想很少。我只懂保護。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161018
					],
					"speakerTitle": "蘭百梨迦"
				},
				{
					"id": 730161018,
					"content": "蘭般度曾經和那菈法留納一起保護桓那，他們一起趕走了黑色的不祥的汙泥，治好了法留納神機。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161019
					],
					"speakerTitle": "蘭百梨迦"
				},
				{
					"id": 730161019,
					"content": "#那菈法留納離開桓那已經很久，無憂節，{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}或許也不會來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161020
					],
					"speakerTitle": "蘭百梨迦"
				},
				{
					"id": 730161020,
					"content": "蘭般度一定知道。已經不知道過去了多久，時間足夠一粒種子長成參天大樹，離開桓那的那菈不會再回來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161021
					],
					"speakerTitle": "蘭百梨迦"
				},
				{
					"id": 730161021,
					"content": "但是蘭般度想要又一次治好法留納神機，為了桓那，為了無憂節，也為那菈法留納。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161022
					],
					"speakerTitle": "蘭百梨迦"
				},
				{
					"id": 730161022,
					"content": "原來是這樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161023
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730161023,
					"content": "#蘭百梨迦沒有見過那菈法留納，但是{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}的事，桓那知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161024
					],
					"speakerTitle": "蘭百梨迦"
				},
				{
					"id": 730161024,
					"content": "蘭百梨迦不會像蘭般度一樣想很多，只知道，蘭百梨迦足夠強，可以保護蘭那羅，也可以保護桓那。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161025
					],
					"speakerTitle": "蘭百梨迦"
				},
				{
					"id": 730161025,
					"content": "那菈法留納不在了，蘭那羅也可以治好法留納神機。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161026
					],
					"speakerTitle": "蘭百梨迦"
				},
				{
					"id": 730161026,
					"content": "#嗯！而且還有我和{NICKNAME}幫忙呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161027
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730161027,
					"content": "#這裡的鐵的味道，不對勁。那菈{NICKNAME}，就交給你了。我在這裡等你們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161028
					],
					"speakerTitle": "蘭百梨迦"
				},
				{
					"id": 730161028,
					"content": "不知道蘭百梨迦感知到了什麼…不過森林的事情，蘭那羅一定知道得更清楚吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161029
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730161029,
					"content": "#{NICKNAME}，總之，我們在附近找找三個分散的「葉」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730161015,
					"content": "有點不像蘭那羅…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730161016
					]
				},
				{
					"id": 730161016,
					"content": "不過，什麼才叫「像蘭那羅」呢？唔…搞不懂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161017
					],
					"speakerTitle": "派蒙"
				}
			]
		},
