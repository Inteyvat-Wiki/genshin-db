			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"龍二"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400320101,
					"content": "#{F#妳}{M#你}們來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320102
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320102,
					"content": "找到線索了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320103
					]
				},
				{
					"id": 400320103,
					"content": "嗯。這次多虧珊瑚社長了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320104
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320104,
					"content": "根據她的「演繹」，大致上確定了幾處地點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320105
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320105,
					"content": "目前看來，有一處營地是由昨天那隻「帽子狗」看守的，需要格外小心應對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320106
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320106,
					"content": "感覺像派蒙會取的外號。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320107
					]
				},
				{
					"id": 400320107,
					"content": "喂！派蒙才不會取這樣的外號。如果是我的話，應該會叫…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400320108,
					"content": "嗯——就叫「刀子狗」吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400320109,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320110
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320110,
					"content": "總之，我在那邊設置了一些一樣的機關。希望這次也能奏效吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320111
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320111,
					"content": "哇！竟然被無視了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400320112,
					"content": "#那麼，就拜託{F#妳}{M#你}們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320113
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320113,
					"content": "還有什麼問題嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320114
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320114,
					"content": "地點可靠嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320115
					]
				},
				{
					"id": 400320115,
					"content": "絕對可靠。畢竟，我去實地考察過了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320116
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320116,
					"content": "龍二為什麼這次不和我們一起去呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400320117,
					"content": "#雖然我也很想和{F#妳}{M#你}們一起，但今天不巧有珊瑚社長給我安排的其他任務。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320118
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320118,
					"content": "大體來說，她對「帽子狗」的來歷有些想法。所以委託我順便去調查一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320119
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320119,
					"content": "「刀子狗」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400320120,
					"content": "「帽子狗」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320121,
						400320124
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320121,
					"content": "「帽子刀子狗子」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320122
					]
				},
				{
					"id": 400320122,
					"content": "好奇怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320123
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320123,
					"content": "這是什麼外號，好奇怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400320125,
					"content": "…算了，還是叫牠「黑影」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320126
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320126,
					"content": "無論如何，小動物就拜託了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320124,
					"content": "別爭了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320125
					]
				}
			]
		},
		{
			"id": 4003203,
			"completionStepIds": [
				4003203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003203",
							"2"
						],
						"stepId": 4003203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"龍二"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400320301,
					"content": "#辛苦{F#妳}{M#你}們了。我看看…數量還是對不上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320302
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320302,
					"content": "原來丟了那麼多小動物嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400320303,
					"content": "是的。按照接到的委託來看，我們已經找到大概半數的失蹤小動物了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320304
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320304,
					"content": "只可惜現在也沒有更多的線索了。不過沒關係，活物比沒有生命的物品更加好調查。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320305
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320305,
					"content": "之前有幫大戶人家找過被偷走的物品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320306
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320306,
					"content": "曾經一再斷了線索，多虧了珊瑚社長的推理，最後才找到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320307,
						400320325
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320307,
					"content": "能具體說說嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320308
					]
				},
				{
					"id": 400320308,
					"content": "好像很有趣的樣子，快詳細講講嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400320309,
					"content": "#想不到{F#妳}{M#你}們對探案也有興趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320310
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320310,
					"content": "其實當時，我們已經鎖定了嫌疑人。只是他家裡並沒有找到贓物，也沒有其他線索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320311
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320311,
					"content": "後來，我在外打聽的時候，無意間得知，嫌疑人在一天前賣出過鳴草。我去找買家看過鳴草，還算是新鮮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320312
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320312,
					"content": "珊瑚社長聽說後，馬上就讓我去影向山山腳一帶調查。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320313
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320313,
					"content": "咦？為什麼是影向山？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400320314,
					"content": "「首先嫌疑人住在鳴神島上。雖然稻妻有很多地方都有鳴草，但是如果要去別的島上，普通人必然需要船，但是我們沒有發現船。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320315
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320315,
					"content": "「再加上天領奉行由於鎖國令對船十分敏感，他如果打算作案，必然不會讓自己暴露在天領奉行的眼皮子底下。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320316
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320316,
					"content": "「所以基本上可以排除掉其他島。」珊瑚社長是這麼說的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320317
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320317,
					"content": "但是鳴神大社附近也有鳴草吧？為什麼是影向山山腳呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400320318,
					"content": "這點珊瑚社長也考慮到了。「雖然鳴神大社附近也有鳴草分佈，但是鳴神大社有巫女在，也有去參拜的信眾。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320319
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320319,
					"content": "「如果有什麼不同尋常的地方，大家來來往往很容易就會被發現。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320320
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320320,
					"content": "原來是這樣子！現在我相信她是頭腦派了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320321
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400320321,
					"content": "然後在影向山山腳果然發現了一處土堆，有近期鬆動過的痕跡。嫌疑人把贓物先埋掉，打算等風頭過了，再來取出銷贓。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320322
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320322,
					"content": "但是他覺得自己背著背簍出去又空手回來會讓人起疑，於是摘了路邊的鳴草回去賣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320323
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320323,
					"content": "但又恰恰是鳴草暴露了他！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320324
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400320324,
					"content": "沒錯。所以一定還有什麼線索，在我們沒有注意到的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320327
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320327,
					"content": "#我覺得我們這樣的合作也不錯。畢竟，我的特長本來也是跑腿，而不是潛入和戰鬥。這部分交給{F#妳}{M#你}，真是再合適不過了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320328
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320328,
					"content": "如何？有沒興趣來「萬端珊瑚」就職？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320329
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320329,
					"content": "珊瑚…社長她雖然看起來有點難以溝通，會說「良知是智慧的累贅」之類的話，但骨子裡其實是很溫柔的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320330,
						400320331
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320330,
					"content": "算了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320332
					]
				},
				{
					"id": 400320332,
					"content": "真可惜呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320333
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400320333,
					"content": "#不過說得也是，要是珊瑚社長身邊有像{F#妳}{M#你}這麼能幹的人，我就該失業了。",
