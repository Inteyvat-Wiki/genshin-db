			},
			"dialogs": [
				{
					"id": 722680101,
					"content": "#我乃末代地走官·宇陀。珊瑚宮之勇者，我認可{F#妳}{M#你}挑戰的榮譽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722680102
					],
					"speakerTitle": "宇陀"
				},
				{
					"id": 722680102,
					"content": "#我將主持「智慧」之試煉。請{F#妳}{M#你}動身去解開所有的謎題，讓「高門之火」歸位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722680103
					],
					"speakerTitle": "宇陀"
				},
				{
					"id": 722680103,
					"content": "如果沒有足夠的智慧，勇往直前並不能稱為勇敢，只是魯莽罷了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722680104
					],
					"speakerTitle": "宇陀"
				},
				{
					"id": 722680104,
					"content": "#我將在上方三界塔處等候{F#妳}{M#你}完成挑戰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宇陀"
				}
			]
		},
