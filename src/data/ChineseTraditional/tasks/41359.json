						413590302
					],
					"speakerTitle": "小千"
				},
				{
					"id": 413590302,
					"content": "#這也難不倒{F#妳}{M#你}嗎…{F#妳}{M#你}果然是個很厲害的冒險家啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590303
					],
					"speakerTitle": "小千"
				},
				{
					"id": 413590303,
					"content": "快去看看屏風吧，寶藏的線索都隱藏在裡面了。",
