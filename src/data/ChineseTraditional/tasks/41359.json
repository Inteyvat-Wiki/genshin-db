			"trigger": {
				"objectNames": [
					"小千"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413590201,
					"content": "怎麼樣，尋寶之旅還順利嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590202
					],
					"speakerTitle": "小千"
				},
				{
					"id": 413590202,
					"content": "已經找到全部寶藏了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413590203
					]
				},
				{
					"id": 413590203,
					"content": "#{F#妳}{M#你}居然真的把三張圖都解完了…{F#妳}{M#你}還挺厲害的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590204
					],
					"speakerTitle": "小千"
				},
				{
					"id": 413590204,
					"content": "#咳，對於{F#妳}{M#你}這種實力高超的冒險家，我們協會也特別準備了一份大禮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590205
					],
					"speakerTitle": "小千"
				},
				{
					"id": 413590205,
					"content": "#看到對面那些寶箱了嗎？打開吧，裡面的東西都歸{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590206
					],
					"speakerTitle": "小千"
				},
				{
					"id": 413590206,
					"content": "我拿了之後…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413590207
					]
				},
				{
					"id": 413590207,
					"content": "後面的人當然就沒了，冒險就是這樣，戰利品誰先拿到就歸誰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590208
					],
					"speakerTitle": "小千"
				},
				{
					"id": 413590208,
					"content": "#好了，祝{F#妳}{M#你}在海燈節玩得開心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小千"
				}
			]
		},
