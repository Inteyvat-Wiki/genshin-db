				"points": []
			},
			"dialogs": [
				{
					"id": 413590101,
					"content": "歡迎試玩「玲瓏霄燈圖」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590102
					],
					"speakerTitle": "小千"
				},
				{
					"id": 413590102,
					"content": "這次也準備了不一樣的圖案嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413590103
					]
				},
				{
					"id": 413590103,
					"content": "#當然啦，畢竟被{F#妳}{M#你}連續解開了兩次，這次我可是真的去換了難度最高的幾盞燈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590104
					],
					"speakerTitle": "小千"
				},
				{
					"id": 413590104,
					"content": "不過，圖當然還是三個拼成一個完整的，難度還是在<color=#00E1FFFF>「連軸」</color>上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590105
					],
					"speakerTitle": "小千"
				},
				{
					"id": 413590105,
					"content": "#嘿嘿，{F#妳}{M#你}就自己去體會一下吧，這次的圖案是<color=#00E1FFFF>「仙鶴」</color>哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590106
					],
					"speakerTitle": "小千"
				},
				{
					"id": 413590106,
					"content": "#拼好了圖之後，{F#妳}{M#你}就可以去找寶藏去啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小千"
				}
			]
		},
		{
			"id": 4135902,
