					}
				]
			},
			"dialogs": [
				{
					"id": 731850501,
					"content": "這隻馱獸…好像心情不太好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731850502,
					"content": "#嗚哇，{F#妳}{M#你}看牠的蹄子，感覺好結實的樣子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731850503,
					"content": "要是被踢上一下，一般人應該會直接昏過去吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731850504,
					"content": "派蒙把這些食物送過去吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850505
					]
				},
				{
					"id": 731850505,
					"content": "#{F#妳}{M#你}、{F#妳}{M#你}去啦！快點快點！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850506,
						731850507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731850506,
					"content": "請您慢用…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850508
					]
				},
				{
					"id": 731850507,
					"content": "我無意冒犯您的蹄子…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850516
					]
				},
				{
					"id": 731850510,
					"content": "馱獸緩緩地吞下了食物，蹄子似乎安分了一些…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731850511
					]
				},
				{
					"id": 731850508,
					"content": "牠看起來好像沒那麼生氣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850509
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731850509,
					"content": "我們快把牠帶回去吧，小心啊！可別被踢到了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850510
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731850511,
					"content": "和馱獸一起回到了阿爾伯身邊…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731850512
					]
				},
				{
					"id": 731850512,
					"content": "太好了…我還以為這隻馱獸真跑丟了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850513
					],
					"speakerTitle": "阿爾伯"
				},
				{
					"id": 731850513,
