			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿爾伯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731850101,
					"content": "#呼…呼…謝謝{F#妳}{M#你}旅行者…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850102,
						731850103
					],
					"speakerTitle": "阿爾伯"
				},
				{
					"id": 731850102,
					"content": "沒事就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850104
					]
				},
				{
					"id": 731850104,
					"content": "我叫阿爾伯，是個商人，本來只是在這裡休息一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850105
					],
					"speakerTitle": "阿爾伯"
				},
				{
					"id": 731850105,
					"content": "但沒想到，卻被那些丘丘人突然襲擊了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850106,
						731850107
					],
					"speakerTitle": "阿爾伯"
				},
				{
					"id": 731850106,
					"content": "你沒有護衛嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850108
					]
				},
				{
					"id": 731850108,
					"content": "對呀，我們在城裡聽說，外出運貨的商人們一般都會雇傭「鍍金旅團」的人來幫忙呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731850109,
					"content": "哎呀，我…我不是捨不得那些錢嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850110
					],
					"speakerTitle": "阿爾伯"
				},
				{
					"id": 731850110,
					"content": "那些「鍍金旅團」的人出價時個個都是獅子大開口，要的數目一個比一個誇張。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850111
					],
					"speakerTitle": "阿爾伯"
				},
				{
					"id": 731850111,
					"content": "我本來做的就是小本生意，可付不起那麼多錢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850112
					],
					"speakerTitle": "阿爾伯"
				},
				{
					"id": 731850112,
					"content": "我就想，反正我也會一點武藝，運貨的路程也不遠，乾脆直接出發算了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850113
					],
					"speakerTitle": "阿爾伯"
				},
				{
					"id": 731850113,
					"content": "但沒想到，那些丘丘人襲擊的時候，把我的兩隻馱獸嚇到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850114
					],
					"speakerTitle": "阿爾伯"
				},
				{
					"id": 731850114,
					"content": "我還沒反應過來，就先被一隻馱獸撞到了地上，站起來之後，又挨了另外一隻馱獸一蹄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850115
					],
					"speakerTitle": "阿爾伯"
				},
				{
					"id": 731850115,
					"content": "嗚哇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731850116,
					"content": "#然後，兩隻馱獸奪路而跑，我則被那群丘丘人圍攻…還好有{F#妳}{M#你}們幫忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850117
					],
					"speakerTitle": "阿爾伯"
				},
				{
					"id": 731850117,
					"content": "#但我的全部身家都在那兩頭馱獸的身上…旅行者，能不能請{F#妳}{M#你}去幫我把牠們帶回來？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850118,
						731850119
					],
					"speakerTitle": "阿爾伯"
				},
				{
					"id": 731850118,
					"content": "我、我不想被踢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850120
					]
				},
				{
					"id": 731850120,
					"content": "別怕、別怕，不用擔心。牠們的性情本來很溫和的，只是那些丘丘人把牠們的食物給打翻了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850121
					],
					"speakerTitle": "阿爾伯"
				},
				{
					"id": 731850121,
					"content": "牠們馱著貨物走了這麼遠，已經非常餓了，被打翻食物之後就變得格外暴躁…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850122
					],
					"speakerTitle": "阿爾伯"
				},
				{
					"id": 731850122,
					"content": "原來如此…在吃飯的時候被打擾，吃的東西還都被打翻了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731850123,
					"content": "唔唔唔，光是想想都很生氣了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731850124,
					"content": "派蒙理解得可真快啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850125
					]
				},
				{
					"id": 731850125,
					"content": "#這樣好了…來，這些食物給{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850126
					],
					"speakerTitle": "阿爾伯"
				},
				{
					"id": 731850126,
					"content": "#{F#妳}{M#你}找到馱獸之後，就把這些食物餵給牠們吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850127
					],
					"speakerTitle": "阿爾伯"
				},
				{
					"id": 731850127,
					"content": "只要有吃的，牠們就不會亂發脾氣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850128
					],
					"speakerTitle": "阿爾伯"
				},
				{
					"id": 731850128,
					"content": "我之前留意到，有一隻馱獸撞開了那些丘丘人，自顧自地跑遠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850129
					],
					"speakerTitle": "阿爾伯"
				},
				{
					"id": 731850129,
					"content": "另外一隻好像被那些丘丘人抓住帶走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850130
					],
					"speakerTitle": "阿爾伯"
				},
				{
					"id": 731850130,
					"content": "#我把那兩隻馱獸離開的方向大致給{F#妳}{M#你}標記一下…這件事就交給{F#妳}{M#你}了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850131
					],
					"speakerTitle": "阿爾伯"
				},
				{
					"id": 731850131,
					"content": "#只要能把貨物找回來，我一定會付給{F#妳}{M#你}一筆豐厚報酬的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿爾伯"
				},
				{
					"id": 731850119,
					"content": "我、我擔心被撞…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850120
					]
				},
				{
					"id": 731850107,
					"content": "沒有人保護你？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850108
					]
				},
				{
					"id": 731850103,
					"content": "小事而已。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850104
					]
				}
			]
		},
		{
