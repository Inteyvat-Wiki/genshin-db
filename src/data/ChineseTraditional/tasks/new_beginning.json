			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"珊瑚宮心海",
					"九條裟羅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120240101,
					"content": "好久不見，九條裟羅。上次見面，還是在戰場上吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240102
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240102,
					"content": "是啊，當時我們在妳手上吃了不小的虧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240103
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 120240103,
					"content": "#話說回來，{F#妳}{M#你}怎麼也在這？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240104
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 120240104,
					"content": "來見證這次和談。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120240105
					]
				},
				{
					"id": 120240105,
					"content": "#沒錯，{NICKNAME}是這次和談的見證人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240106
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240106,
					"content": "#{F#她}{M#他}完整地經歷了我們之間的戰爭，為現在的和平做出了巨大的貢獻。我想，應該沒有人比{F#她}{M#他}更合適了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240107
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240107,
					"content": "也是，那我們直接進入正題吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240108
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 120240108,
					"content": "首先是海域管轄權的問題。戰爭期間，我們限制了海祇島的打漁人在鳴神島海域活動…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240109
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 120240109,
					"content": "現在我們打算正式解除限制，但他們需要按照我們鳴神島的稅法進行納稅，才能將收穫帶回海祇島。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240110
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 120240110,
					"content": "可以。不過在鳴神島附近捕魚的人，需要受到天領奉行的保護。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240111
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240111,
					"content": "如果他們因治安問題有任何損失，天領奉行必須要出面解決。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240112
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240112,
					"content": "這一點我答應了，寫到協約中吧。有天領奉行在，他們不會有事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240113
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 120240113,
					"content": "感覺她們之間的談判還算順利呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120240114,
					"content": "接下來是人員往來和常駐軍的所屬問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240115
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 120240115,
					"content": "以前不管是我們的人去海祇島，還是海祇島的人過來，都會遭受重重盤問。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240116
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 120240116,
					"content": "結果就是彼此交流愈來愈少，很少有商人願意跨島嶼經商。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240117
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 120240117,
					"content": "戰爭既然結束，那我提議由社奉行選出一些商人，主管兩邊的商務貿易。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240118
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 120240118,
					"content": "商務貿易，需要有來有往。雙方的商人都要參與，不能完全交給社奉行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240119
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240119,
					"content": "但據我瞭解，海祇島現在急需各種物資。交由社奉行統一調配，對你們也是一件好事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240120
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 120240120,
					"content": "物資緊缺，我們自然有辦法緩解。海祇島物產豐富，也有許多外地的商人願意過來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240121
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240121,
					"content": "更何況這種事，應該由神里家與我們談。天領奉行…應該沒有這方面的權力吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240122
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240122,
					"content": "既然這樣，那我們聊聊治安吧。我想讓海祇島的治安部隊，回歸到天領奉行的管轄之下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240123
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 120240123,
					"content": "暫時來說，不可能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240124
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240124,
					"content": "沒有不可能的事情。天領奉行統管稻妻治安，不可能一直放任海祇島處於例外…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240125
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 120240125,
					"content": "卑鄙的九條家，你們勾結愚人眾，還想奪走我們海祇島的一切！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240127
					],
					"speakerTitle": "忠勝"
				},
				{
					"id": 120240127,
					"content": "心海！這時候我們要用錦囊第幾條呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120240128,
					"content": "#最後一條…不過暫時不需要{F#妳}{M#你}們出手了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240129
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240129,
					"content": "忠勝，如今情況有變，你們先在一旁待命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240130
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240130,
					"content": "放心，你們的訴求我已瞭解，接下來就交給我來處理吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240131
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240131,
					"content": "九條小姐，關於這件事，妳是不是應該給我們海祇島一個交代？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240132
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240132,
					"content": "…稍等。所有人不要動手，等我調查完再說！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240133
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 120240133,
					"content": "你們兩個，過來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240134
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 120240134,
					"content": "說吧，你們跟愚人眾真的有什麼勾結嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240135
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 120240135,
					"content": "這…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240136
					],
					"speakerTitle": "元助"
				},
				{
					"id": 120240136,
					"content": "就，其實也算不上勾結…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240137
					],
					"speakerTitle": "陶義隆"
				},
				{
					"id": 120240137,
					"content": "愚人眾有些人找上我們，說可以跟我們合作，延續對海祇島的戰爭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240138
					],
					"speakerTitle": "元助"
				},
				{
					"id": 120240138,
					"content": "當時我想，反正試試也沒什麼壞處…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240139
					],
					"speakerTitle": "元助"
				},
				{
					"id": 120240139,
					"content": "但其實我們很謹慎，沒答應他們，只說讓他們可以先去海祇島搞破壞，我們看看情況再說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240140
					],
					"speakerTitle": "陶義隆"
				},
				{
					"id": 120240140,
					"content": "九條大人，我們跟他們真的沒什麼勾結。只是不久之前談過這麼一次，誰知道海祇島的人怎麼得知的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240141
					],
					"speakerTitle": "陶義隆"
				},
				{
					"id": 120240141,
					"content": "夠了…回去之後，自己領罰吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240142
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 120240142,
					"content": "那可是愚人眾，他們對我們做了什麼，你們都忘了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240143
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 120240143,
					"content": "別說合作，你們根本就不該和他們有任何牽扯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240144
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 120240144,
					"content": "他們的目的是什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240145
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 120240145,
					"content": "愚人眾的主力應該已經從稻妻撤出了，找上我們的那些人，似乎是想為他們的老大報仇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240146
					],
					"speakerTitle": "陶義隆"
				},
				{
					"id": 120240146,
					"content": "那個女人的部下嗎…看來是準備報復，想讓稻妻再次動亂起來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240147
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 120240147,
					"content": "早晚有一天，我會親手把他們全部抓住。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240148
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 120240148,
					"content": "這件事，確實是我們的問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240149
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 120240149,
					"content": "非常抱歉，因為我的疏忽，才有這樣的局面。請再給我們一個機會，讓和談繼續下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240150
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 120240150,
					"content": "呵呵…我當然相信九條小姐能夠處理好這件事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240151
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240151,
					"content": "但既然天領奉行做不到上下齊心，我很難放心把海祇島的治安交給你們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240152
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240152,
					"content": "無法反駁…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240153
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 120240153,
					"content": "這個議題暫時擱置吧。等天領奉行整頓完畢之後，我們再好好討論討論。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240154
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 120240154,
					"content": "關於商人的問題，我也會和社奉行那邊商量，讓雙方都能參與其中…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240155
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 120240155,
					"content": "感覺裟羅的氣勢一下子弱了不少，這樣和談應該能夠順利進行了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240156
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120240156,
					"content": "沒想到海祇島的「軍師」除了擅長作戰，也是談判好手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240157
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 120240157,
					"content": "#希望下次見面，我們還能像這樣坐下來談話。畢竟在戰場上見到{F#妳}{M#你}，太過棘手了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240158
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 120240158,
					"content": "今天就到這裡吧，我也要回去徹查天領奉行內部的問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240159
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 120240159,
					"content": "愚人眾的營地被我們擊潰，再過不久，他們應該就會再和你們聯絡，想要從你們那裡獲得支援。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240160
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240160,
					"content": "我建議妳先不要放出風聲，以免打草驚蛇。等他們現身，就可以將他們一網打盡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240161
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240161,
					"content": "我會考慮的，非常感謝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240162
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 120240162,
					"content": "那我先回去了，下次再見吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240163
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 120240163,
					"content": "珊瑚宮大人，我們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240164
					],
					"speakerTitle": "忠勝"
				},
				{
					"id": 120240164,
					"content": "回海祇島再說吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚宮心海"
				}
			]
		},
		{
			"id": 1202402,
