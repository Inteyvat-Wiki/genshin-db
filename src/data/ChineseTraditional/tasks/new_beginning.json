			"dialogs": [
				{
					"id": 120240301,
					"content": "#辛苦{F#妳}{M#你}了。多虧了{F#妳}{M#你}的幫忙，海祇島又一次恢復了和平。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240302
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
