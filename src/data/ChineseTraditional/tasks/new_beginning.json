			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"珊瑚宮心海"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120240201,
					"content": "珊瑚宮大人，您都知道了…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240202
					],
					"speakerTitle": "忠勝"
				},
				{
					"id": 120240202,
					"content": "你們鬧事的理由，我已經聽說了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240203
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240203,
					"content": "你們覺得天領奉行信不過，所以不想要和談，想要繼續打下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240204
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240204,
					"content": "雖然從結果來看，你們誤打誤撞地識破了他們的陰謀，但你們的做法我還是無法認可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240205
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240205,
					"content": "可是珊瑚宮大人，我們犧牲了那麼多同伴，如果就這樣停下來，過去的努力不是白費了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240206
					],
					"speakerTitle": "忠勝"
				},
				{
					"id": 120240206,
					"content": "我希望戰爭繼續打下去，就算我犧牲了也沒有關係，我希望我們能徹底贏下來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240207
					],
					"speakerTitle": "忠勝"
				},
				{
					"id": 120240207,
					"content": "我能夠理解你們的想法…但你們不能強求別人為你們的想法承擔後果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240208
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240208,
					"content": "戰爭期間，我們有過低谷，也打過勝仗。對你們來說，這是一段熱血澎湃的經歷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240209
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240209,
					"content": "但其實在戰爭期間，也有許多你們看不到的人，每天都活在煎熬之中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240210
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240210,
					"content": "海祇島的人嚮往和平，是因為每個人都為戰爭付出了太多。他們已經累了，不該被你們又一次拖下水。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240211
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240211,
					"content": "我…可是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240212
					],
					"speakerTitle": "忠勝"
				},
				{
					"id": 120240212,
					"content": "我明白，這不完全是你們的錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240213
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240213,
					"content": "是我考慮不周。我告訴你們要有戰鬥的意志，卻沒有告訴你們該如何放手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240214
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240214,
					"content": "不是珊瑚宮大人的錯！是我們…太過自私了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240215
					],
					"speakerTitle": "忠勝"
				},
				{
					"id": 120240215,
					"content": "不論如何，我們願意接受軍法處置。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240216
					],
					"speakerTitle": "忠勝"
				},
				{
					"id": 120240216,
					"content": "好那我現在宣佈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240217
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240217,
					"content": "從今天開始，成立一支秘密軍隊。負責保衛海祇島的安全，清理一切危險之物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240218
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240218,
					"content": "所有像你們一樣的人，都可以加入其中，不過訓練比較辛苦，希望你們可以咬牙堅持住。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240219
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240219,
					"content": "珊瑚宮大人的意思是…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240220
					],
					"speakerTitle": "忠勝"
				},
				{
					"id": 120240220,
					"content": "從這次和談來看，九條家短時間內不會太平。有人想要和平，就有人想要戰爭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240221
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240221,
					"content": "海祇島嚮往和平，但也要有自保的能力。既然你們還有戰鬥意志，就從今天開始魔鬼訓練。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240222
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240222,
					"content": "直到每個人能在正面戰場上，打贏兩個幕府武士再說！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240223
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240223,
					"content": "…多謝珊瑚宮大人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240224
					],
					"speakerTitle": "忠勝"
				},
				{
					"id": 120240224,
					"content": "好了，去找五郎報名吧。今後記住，無論發生什麼事情，都不可以擅自行動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240225
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240225,
					"content": "如果再有下次…不管是什麼理由，都不會有商量的餘地了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240226
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240226,
					"content": "…明白。從今往後，我們一定好好訓練。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240227
					],
					"speakerTitle": "忠勝"
				},
				{
					"id": 120240227,
					"content": "多謝珊瑚宮大人給我們這個機會，我們去找五郎大人報名了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240228
					],
					"speakerTitle": "忠勝"
				},
				{
					"id": 120240228,
					"content": "呼…這樣終於妥善解決了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240229
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240229,
					"content": "總覺得「能量」又開始下降了…我們到「秘密基地」附近休息一下吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚宮心海"
				}
			]
		},
