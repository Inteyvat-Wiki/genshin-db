	"talks": [
		{
			"id": 7565801,
			"completionStepIds": [
				7565801
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7565801",
							"2"
						],
						"stepId": 7565801,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"赫卡"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 756580101,
					"content": "欸？從冒險家協會得知的資訊不是「不便透露詳情的組織」發布的超高難度委託嗎？委託人怎麼會是小孩？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756580102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756580102,
					"content": "#想必兩位就是{NICKNAME}和派蒙了。初次見面，我是委託人赫卡，這次委託的內容兩位應該已經瞭解了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756580103
					],
					"speakerTitle": "赫卡"
				},
				{
					"id": 756580103,
					"content": "協助我收集巨大怪物的情報，也包括在戰鬥方面的表現。那麼接下來的一段時間要受兩位照顧了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756580104
					],
					"speakerTitle": "赫卡"
				},
				{
					"id": 756580104,
					"content": "哦！就交給我們好了…不對！我們都還沒有自我介紹，你怎麼會知道我們的名字？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756580105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756580105,
					"content": "考慮到這次委託的難度，冒險家協會多半會把任務交給有資歷和實績的冒險家吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756580106
					],
					"speakerTitle": "赫卡"
				},
				{
					"id": 756580106,
					"content": "而在這些有名氣的候選人之中，金髮旅行者和小小白色嚮導的組合也並不多見，所以…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756580107
					],
					"speakerTitle": "赫卡"
				},
				{
					"id": 756580107,
					"content": "原來是這樣，不過你明明是個小孩子，懂很多耶！說話也有點老…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756580108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756580108,
					"content": "咳…比一般的小孩沉穩。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756580109
					]
				},
				{
					"id": 756580109,
					"content": "啊，對！說回正題，你真的是委託人嗎？還有「不便透露詳情的組織」也很令人在意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756580110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756580110,
					"content": "委託的確是我發出的，至於「不便透露詳情的組織」…是卡嘉教我的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756580111
					],
					"speakerTitle": "赫卡"
				},
				{
					"id": 756580111,
					"content": "雖然很不甘心，但比起一個沒有來歷的小孩，背景模糊的組織顯然更能讓協會的人拿出認真的態度對待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756580112
					],
					"speakerTitle": "赫卡"
				},
				{
					"id": 756580112,
					"content": "不過關於組織的事我可沒有騙人，我的確是這個「不便透露詳情的組織」的成員。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756580113
					],
					"speakerTitle": "赫卡"
				},
				{
					"id": 756580113,
					"content": "我只是把我認為他們應該知道的部分告訴了他們，至於他們從中解讀出了怎樣的資訊，就取決於他們的想像力了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756580114,
						756580116
					],
					"speakerTitle": "赫卡"
				},
				{
					"id": 756580114,
					"content": "不會是偶爾聚餐的那種組織吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756580115
					]
				},
				{
					"id": 756580115,
					"content": "原來是偶爾聚餐的「秘密組織」啊…那根本就是普通朋友聚會吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756580117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756580117,
					"content": "嗯。畢竟出發之前和玫熙約好了，絕對不說謊話欺騙別人，也不做危險的事。這兩項我都做到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756580118
					],
					"speakerTitle": "赫卡"
				},
				{
					"id": 756580118,
					"content": "只說實話也可以讓事情朝著有利自己的方向發展。只要帶著強大的幫手，危險的地方也是安全的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756580119
					],
					"speakerTitle": "赫卡"
				},
				{
					"id": 756580119,
					"content": "是、是這樣嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756580120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756580120,
					"content": "當然是了。所以，兩位準備好了的話，我們就馬上出發吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "赫卡"
				},
				{
					"id": 756580116,
					"content": "哇，是「秘密組織」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756580117
					]
				}
			]
		}
	]
}