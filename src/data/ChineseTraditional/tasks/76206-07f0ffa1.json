			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"卡斯蒂廖內"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 762060101,
					"content": "狩野啊，你屏風還沒畫完就別到處亂竄了，先想想你的瀑布怎麼畫吧。看在厄歌莉婭的份上，哪有人用散點透視畫瀑布的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762060102
					],
					"speakerTitle": "卡斯蒂廖內"
				},
				{
					"id": 762060102,
					"content": "…嗯？啊，抱歉，原來是陌生的朋友啊。聽腳步聲我還以為是狩野呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762060103
					],
					"speakerTitle": "卡斯蒂廖內"
				},
				{
					"id": 762060103,
					"content": "你在這裡做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762060104
					]
				},
				{
					"id": 762060104,
					"content": "如您所見，我在作畫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762060105
					],
					"speakerTitle": "卡斯蒂廖內"
				},
				{
					"id": 762060105,
					"content": "為了避免您誤會，請讓我先和您說清楚——雖然我擅長畫動物，但我畫的動物不是用來吃的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762060106
					],
					"speakerTitle": "卡斯蒂廖內"
				},
				{
					"id": 762060106,
					"content": "欸，原來可以吃嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762060107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762060107,
					"content": "畫中人是眼前人，畫中獸自然也能是盤中獸…唉，雖說如此，還是希望您不要像璃月的那位妌癸女士一樣，只纏著我畫魚肉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762060108
					],
					"speakerTitle": "卡斯蒂廖內"
				},
				{
					"id": 762060108,
					"content": "藝術——可敬的藝術！無論時代，主旨都應當是人類靈魂的救贖、情操的陶冶，以真、善、美指引我等，通往更高的精神境界。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762060109
					],
					"speakerTitle": "卡斯蒂廖內"
				},
				{
					"id": 762060109,
					"content": "舉例來說，登臨山峰的最高處，所見的風景自然真實無阻。我所追求的藝術也是如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762060110
					],
					"speakerTitle": "卡斯蒂廖內"
				},
				{
					"id": 762060110,
					"content": "嗯…只是像這樣說的話，您也許沒有辦法直觀地理解。這樣好了，我替您畫個浮臺，您上去體驗一番便是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡斯蒂廖內"
				}
			]
		}
	]
}