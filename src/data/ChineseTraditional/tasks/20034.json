			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"班尼特",
					"菲謝爾",
					"安娜",
					"奧茲"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200340201,
					"content": "菲謝爾，妳剛才跑得太快了，很危險的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340202
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 200340202,
					"content": "本皇女的聖裁之雷，絕不會放任邪孽滋長…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340203
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 200340203,
					"content": "是菲謝爾前輩，還有班尼特前輩，你們好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340204
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200340204,
					"content": "#是安娜啊，還有旅行者，{F#妳}{M#你}們是在這裡執行協會的委託嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340205
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 200340205,
					"content": "#喔！本皇女的祝聖之人啊，想來是命運的絲線，將{F#妳}{M#你}引至此地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340206
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 200340206,
					"content": "#小姐很意外會在這種地方見到{F#妳}{M#你}，她很高興。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340207
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 200340207,
					"content": "我是陪著安娜出來執行委託的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200340208
					]
				},
				{
					"id": 200340208,
					"content": "是的，我和旅行者正在這裡護送貨運熱氣球呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340209
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200340209,
					"content": "可是，突然看見有一群盜寶團朝我們衝了過來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340210
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200340210,
					"content": "抱歉抱歉，這都要怪我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340211
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 200340211,
					"content": "原本我和菲謝爾接了委託，要追查一群盜寶團的下落…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340212
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 200340212,
					"content": "奧茲好不容易捕捉了對方的去向，我們正準備去捉拿的時候…我被路上的樹枝絆倒，一下子就摔了出去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340213
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 200340213,
					"content": "這夥盜寶團發現動靜，掉頭就跑，我們只能在後面一直追、一直追…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340214
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 200340214,
					"content": "無須煩憂。蒼紫的罰罪之光，註定裁斷惡徒的命運。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340215
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 200340215,
					"content": "但小姐，真正出手抓住惡徒的，是旅行者…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340216
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 200340216,
					"content": "奧、奧茲！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340217
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 200340217,
					"content": "#話、話說回來，這次真要好好謝謝{F#妳}{M#你}們了，多虧有{F#妳}{M#你}們在前面攔著！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340218
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 200340218,
					"content": "看來，我今天的運氣還是挺好的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340219
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 200340219,
					"content": "能幫上忙就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200340220
					]
				},
				{
					"id": 200340220,
					"content": "#嘿嘿，那我們先帶著這群盜寶團回協會去了，{F#妳}{M#你}們執行委託路上也要小心啊，尤其是注意腳下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "班尼特"
				}
			]
		},
