			"dialogs": [
				{
					"id": 200340301,
					"content": "班尼特前輩，還是一如既往地可靠呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340302
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200340302,
					"content": "菲謝爾前輩…她說的話也一如既往地很有氣勢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340303,
						200340308
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200340303,
					"content": "關於班尼特。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200340304
					]
				},
				{
					"id": 200340304,
					"content": "妳說班尼特前輩？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340305
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200340305,
					"content": "我剛進入協會的時候，班尼特前輩給我解答了很多問題，也幫了我不少忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340306
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200340306,
					"content": "但我聽說，班尼特前輩的運氣一直很差。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340307
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200340307,
					"content": "真是不公平啊，明明是那麼好的人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340313
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200340313,
					"content": "#呼…這樣子委託也完成了，謝謝{F#妳}{M#你}旅行者，我這就回去協會報告啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340314
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200340314,
					"content": "不過，為什麼我連續幾天都是在護送熱氣球…協會裡沒有別的委託了嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安娜"
				},
				{
					"id": 200340308,
					"content": "關於菲謝爾。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200340309
					]
				},
				{
					"id": 200340309,
					"content": "菲謝爾前輩…嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340310
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200340310,
					"content": "她、她也很可靠喔！箭法很好，也執行過很多委託。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340311
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200340311,
					"content": "雖然她說的那些話…我不太能聽懂…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340312
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200340312,
					"content": "但她也是一位…一位很有經驗的冒險家！不、不對，調查員！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340313
					],
					"speakerTitle": "安娜"
				}
			]
		},
		{
