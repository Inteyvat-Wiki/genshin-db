			},
			"dialogs": [
				{
					"id": 200340401,
					"content": "#旅行者，還請{F#妳}{M#你}多照顧一下安娜，這孩子最近好像興奮過頭了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340402
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 200340402,
					"content": "你不希望她做冒險家嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200340403
					]
				},
				{
					"id": 200340403,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340404
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 200340404,
					"content": "我尊重我妹妹的夢想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340405
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 200340405,
					"content": "她的病好不容易痊癒了，也得到了追逐自己夢想的機會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340406
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 200340406,
					"content": "作為她的哥哥，我…會全力支持她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340407
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 200340407,
					"content": "就這樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安東尼"
				}
			]
		}
	]
