						"stepId": 4005714,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaedehara Kazuha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400570701,
					"content": "Kazuha เป็นอะไรรึเปล่า? ฉันเห็นนายยืนอยู่ตรงผืนผ้าใบว่างเปล่านี้ตั้งแต่เมื่อกี้แล้ว แถมสีหน้าก็ดูไม่ค่อยดีด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400570702,
					"content": "ขอโทษนะ ถึงแม้นี่จะเป็นแค่การคาดเดาของฉัน แต่เรื่องราวของ Kasen ทั้งห้าทำให้คุณนึกถึงอะไรบางอย่างใช่หรือเปล่า?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570703
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 400570703,
					"content": "เมื่อกี้ฉันนึกถึงเรื่องบางอย่างจริง ๆ แต่นั่นเป็นเพียงแค่เรื่องราวในอดีตของครอบครัวฉันน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570704
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400570704,
					"content": "ถึงแม้ฉันจะไม่ได้รังเกียจที่จะบอกทุกคน แต่ฉันคิดว่าไม่ควรจะลำบากพวกเธออีกแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570705
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400570705,
					"content": "Kazuha พวกเราเป็นเพื่อนกันนะ ไม่มีเรื่องลำบากหรือไม่ลำบากหรอก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400570706,
					"content": "Kaedehara ต้องขออภัยที่เสียมารยาท เรื่องที่คุณกำลังคิด เกี่ยวข้องกับ \"Raiden Gokaden\" ใช่หรือไม่?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570707
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 400570707,
					"content": "\"Raiden Gokaden\" คืออะไรเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400570708,
					"content": "ดูเหมือนว่าฉันกับคุณหนู Kamisato จะคิดเรื่องเดียวกันนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570709
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400570709,
					"content": "เรื่องนี้เกี่ยวข้องกับสำนัก Yashiro ไม่น้อยเลย คุณยินดีให้ฉันบอกเล่าเรื่องนี้กับทุกคนหรือเปล่า?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570710
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400570710,
					"content": "ทุกคนที่อยู่ที่นี่ต่างเป็นคนที่ไว้ใจได้ทั้งนั้น ไม่มีอะไรเสียหายอยู่แล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570711
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 400570711,
					"content": "เพียงแต่ว่าถ้าจะอธิบายก็คงจะซับซ้อนอยู่ไม่น้อย ให้ฉันเริ่มเล่าจาก Raiden Gokaden ก่อนก็แล้วกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570712
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 400570712,
					"content": "อย่างที่ทุกคนทราบ สำนัก Yashiro มีหน้าที่รับผิดชอบงานด้านพิธีกรรมและมรดกทางวัฒนธรรม และศิลปะการตีดาบของ Inazuma ก็เป็นส่วนที่สำคัญเช่นกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570713
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 400570713,
					"content": "Raiden Gokaden เคยเป็นสำนักสอนตีดาบที่ขึ้นชื่อห้าอันดับแรกของ Inazuma แม้ว่าห้าตระกูลนี้จะเป็นตระกูลช่างตีดาบ แต่พวกเขากลับดำรงตำแหน่งทางการมากมายในสำนัก Yashiro",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570714
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 400570714,
					"content": "แต่น่าเสียดายที่ตอนนี้เหลือเพียง \"Amenoma Art\" เท่านั้นที่ยังมีอาจารย์และศิษย์สืบทอด แม้ว่าศิลปะของ \"Isshin Art\" จะสูญหายไป แต่โชคดีที่ลูกหลานยังคงมีชีวิตอยู่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570715
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 400570715,
					"content": "และตระกูลของ Kaedehara ก็เป็นทายาททางสายเลือดของ \"Isshin\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570716
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 400570716,
					"content": "เรารู้แค่ว่าตระกูล Kazuha เคยเป็นชนชั้นสูง แต่คิดไม่ถึงเลยว่าจะเกี่ยวข้องกับสำนัก Yashiro และการตีดาบด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400570717,
					"content": "อืม แต่ทั้งหมดนี้เป็นเรื่องที่ผ่านมานานแล้วล่ะ Isshin Art สูญหายไปพร้อมกับรุ่นปู่ทวดของฉันแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570718
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400570718,
					"content": "ปู่ของฉันไม่พอใจกับการไม่พยายามของปู่ทวด ในตอนที่ยังหนุ่มเขาเดินทางไปทั่ว Teyvat เพื่อหาทางฟื้นฟูธุรกิจของครอบครัว แต่โชคร้ายที่เขาไม่ประสบความสำเร็จ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570719
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400570719,
					"content": "และในตอนนี้ แม้แต่คฤหาสน์บรรพบุรุษที่เหลืออยู่เพียงอย่างเดียวก็สูญหายไปแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570720
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400570720,
					"content": "ก่อนหน้านี้ฉันได้ยินจากพี่ชายว่า Raiden Gokaden ล่มสลายลงอย่างรวดเร็ว ในเวลาเพียงไม่กี่ทศวรรษ สามตระกูลก็พบกับเรื่องโชคร้ายต่าง ๆ และหายสาบสูญไปในที่สุด",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570721
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 400570721,
					"content": "และหลังจากนั้นทุกคนก็คาดเดากันว่า เรื่องโชคร้ายเหล่านี้เกิดจากการอยู่เบื้องหลังของใครบางคน มีคนต้องการกำจัด Raiden Gokaden",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570722
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 400570722,
					"content": "แต่เนื่องจาก Raiden Gokaden ไม่ได้หายไปอย่างสมบูรณ์ สุดท้ายแล้วคำพูดดังกล่าวจึงเป็นเพียงแค่ข่าวลือเท่านั้น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570723
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 400570723,
					"content": "ใช่ เมื่อก่อนฉันก็คิดแบบนั้นเหมือนกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570724
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400570724,
					"content": "แต่ฉันรู้ว่ามีเหตุการณ์สำคัญเกิดขึ้นกับปู่ทวดของฉันในตอนที่เขายังหนุ่ม",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570725
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400570725,
					"content": "เหตุการณ์นั้นไม่เพียงแต่เกี่ยวข้องกับตระกูล Kaedehara ของเราเท่านั้น แต่เกือบทำให้ตำแหน่งในสำนัก Yashiro ของตระกูล Kamisato สั่นคลอนไปด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570726
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400570726,
					"content": "หลังจากฉันอ่านเรื่องราวของ Kasen ทั้งห้า ก็ทำให้ฉันอดคิดไม่ได้ว่า เหมือนเรื่องราวกำลังชี้ให้ฉันเห็นถึงความจริงของเหตุการณ์ที่เกิดขึ้น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570727
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400570727,
					"content": "Kazuha ตอนนั้นเกิดอะไรขึ้นกันแน่?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400570728,
					"content": "ฉันยังต้องหาคนมายืนยันรายละเอียดบางอย่างของเหตุการณ์นั้น พวกเราค่อยมาเจอกันใหม่ในตอนเที่ยงของวันพรุ่งนี้นะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570729
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400570729,
					"content": "ถึงตอนนั้น ฉันจะบอกทุกอย่างที่รู้ให้ทุกคนฟังเอง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
