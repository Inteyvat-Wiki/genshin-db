				"points": []
			},
			"dialogs": [
				{
					"id": 722060101,
					"content": "เห้! ฉันยังอยู่ตรงนี้อยู่นะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060102
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060102,
					"content": "เด็กสมัยนี้นี่มันยังไงกัน ไม่มีกาลเทศะกันบ้างเลยเหรอ!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060103,
						722060105
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060103,
					"content": "ขะ...ขอโทษ!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060104
					]
				},
				{
					"id": 722060104,
					"content": "ฮึ่ม... ก็ยังดี สำนึกผิดก็ยังดี เห็ดนั่นถือว่าฉันให้เธอก็แล้วกัน... แล้วอย่ามาแตะต้องเห็ดของฉันอีกเชียวนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060105,
					"content": "นี่คือเห็ดของคุณงั้นเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060106
					]
				},
				{
					"id": 722060106,
					"content": "แล้วเธอมายุ่งอะไรด้วย! เลิกเด็ดไปเรื่อย แล้วก็ออกไปซะดี ๆ !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Abe"
				}
			]
		},
		{
			"id": 7220602,
			"completionStepIds": [
				7220603
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7220602",
							"3"
						],
						"stepId": 7220602,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7220603",
							"2"
						],
						"stepId": 7220603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722060201,
					"content": "อ๋าาาา! คนนั้นเมื่อกี้... เธอเห็นใช่มั้ย?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060202,
						722060203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722060202,
					"content": "ไม่เห็นนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060204
					]
				},
				{
					"id": 722060204,
					"content": "อ่าา... น่ากลัวชะมัด พวกเราเก็บอีกสักหน่อยแล้วรีบออกไปกันเถอะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722060203,
					"content": "ภาพมายาล่ะมั้ง",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060204
					]
				}
			]
		},
		{
			"id": 7220603,
			"completionStepIds": [
				7220605
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7220604",
							"3"
						],
						"stepId": 7220604,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7220605",
							"2"
						],
						"stepId": 7220605,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Abe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722060301,
					"content": "เห้! ฉันเตือนพวกเธอแล้วไม่ใช่เหรอไง! นี่พวกเธอหูไม่ดี หรือเอาแต่หลับตาอยู่กันแน่เนี่ย?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060302
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060302,
					"content": "อ๋า ผีนี่เอง",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060303
					]
				},
				{
					"id": 722060303,
					"content": "หวาาา! ผีอะไร?! ผีอยู่ที่ไหน!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060304,
						722060305
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060304,
					"content": "ก็ที่นี่ไง",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060306
					]
				},
				{
					"id": 722060306,
					"content": "อ๋าาา! ไป ไปซะ! รีบไปซะเจ้าผีร้าย!! ในนามของฉัน Abe ผู้นี้ ขอสั่งให้แกรีบจากไปโดยเร็ว!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060307
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060307,
					"content": "อึ๋ยย น่ากลัว น่ากลัวเป็นบ้า! ฉันอยู่มาตั้งขนาดนี้ ยังไม่เคยเจอผีที่ร้ายกาจขนาดนี้มาก่อนเลย!! ทำไมถึงยังไม่รีบหายไปอีกนะ!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060308
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060308,
					"content": "ฉันมาจากด้านนอกของเกาะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060309
					]
				},
				{
					"id": 722060309,
					"content": "ผีร้ายจากนอกหมอกงั้นเหรอ... ฮึ่ม ฉันไม่กลัวแกหรอกนะ! แกอยู่ตรงนั้นแหละ อย่าไปไหนเชียวล่ะ รอให้ Thunderbird ผู้ยิ่งใหญ่มาขับไล่แกซะเถอะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060310,
						722060311
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060310,
					"content": "Thunderbird ไม่มาอีกแล้วล่ะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060312
					]
				},
				{
					"id": 722060312,
					"content": "พูดอะไรน่ะ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060313,
						722060314
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060313,
					"content": "ทุกคนต่างก็จากไปกันหมดแล้ว",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060315
					]
				},
				{
					"id": 722060315,
					"content": "อะไร... พูดอะไรน่ะ... อย่าพูดอะไรที่มันน่ากลัวสิ ขนลุกหมดแล้ว...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060316
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060316,
					"content": "แต่ว่า... คนบนเกาะน้อยลงเรื่อย ๆ เลย... ก่อนหน้านี้ยัยหนู Kina นั่นบอกว่า ทุกคนไปนั่งเรือกันหมดแล้ว... เฮ้อ ก็ไม่รู้เหมือนกันว่าเด็กคนนั้นไปเล่นที่ไหนแล้ว...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060317
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060317,
					"content": "จริงสิ นายท่านวิญญาณร้ายจากนอกเกาะ ท่านไม่ไปรึ...? เรือสีเงินแวววาวที่ริมทะเลลำนั้นน่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060318,
						722060319
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060318,
					"content": "ฉันไม่เห็นเรือที่ไหนเลย",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060320
					]
				},
				{
					"id": 722060320,
					"content": "หึ... ฉันรู้อยู่แล้ว เรือนั่นน่ะ คนจากนอกเกาะไม่มีทางมองเห็นหรอก...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060321
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060321,
					"content": "ขอบคุณที่กระตุ้นให้ฉันขึ้นเรือนะ นายท่านวิญญาณร้ายจากนอกเกาะ เพียงแต่ว่า... ฉันอยู่มาตั้งขนาดนี้ แต่ก็ยังมีของอีกหลายสิ่งที่ยังไม่เคยได้พบเจอ จะจากไปตอนนี้มันก็ข้องใจ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060322
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060322,
					"content": "ต้องการอะไร?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060323
					]
				},
				{
					"id": 722060323,
					"content": "ต้องการ? ฮ่าฮ่า ก็ไม่ได้ถือว่าเป็นความต้องการหรอกนะ... แค่อยากจะเห็นอะไรแปลกใหม่ก็เท่านั้น...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060324
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060324,
					"content": "ตอนที่ฉันยังเป็นเด็ก ฉันเคยพนันกับพี่ Una ไว้... ฉันบอกว่าที่นอกเกาะจะต้องมีเห็ดที่ไม่เหมือนกันอยู่แน่ แต่ว่าเธอไม่เชื่อ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060325
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060325,
					"content": "ต่อมา... สามีของเธอก็ออกทะเลเพื่อมุ่งไปยังดินแดนของคนนอก จากนั้นก็ไม่กลับมาอีกเลย... วิญญาณของเขาทำได้แค่ร่อนเร่ไปทั่วในดินแดนของคนนอกซะแล้ว... น่าสงสารจริง ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060326
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060326,
					"content": "เพราะเหตุนั้น พี่ Una ก็เลยต้องอยู่ตัวคนเดียวมาจนถึงทุกวันนี้... พอคิดดูแล้วฉันก็... เฮ้อ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060327,
						722060328
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060327,
					"content": "อย่ามัวแต่คิดถึงคนอื่นอีกเลย",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060329
					]
				},
				{
					"id": 722060329,
					"content": "ฉันเคยขอร้องท่านนักบวชด้วยนะ... ว่าไม่ว่าจะยังไงก็ต้องหาที่อาศัยให้แก่เขา... อื๋อ? โอ้ จริงสิ ๆ เห็ดยังไงล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060330
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060330,
					"content": "อะแฮ่ม... จะต้องไปขึ้นเรืออยู่แล้ว ฉันเองก็ไม่เหลืออะไรให้ต้องเสียใจแล้วล่ะ... ก็แค่ไม่เคยเห็นของจากด้านนอกเกาะก็เท่านั้น... แต่สิ่งที่ฉันสนใจมากที่สุดน่ะนะ... ก็เป็นเห็ดทั้งหลายที่ฉันคอยดูแลอยู่ทุกวันนั่นแหละ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060331
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060331,
					"content": "งั้นขอให้คุณช่วยนำเห็ดจากด้านนอกของทะเลหมอกมาให้ฉันทีสิ... ถือซะว่าเป็นการช่วยเปิดหูเปิดตาให้ฉันด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060332
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060332,
					"content": "ขอร้องล่ะนะ นายท่านวิญญาณร้ายจากนอกเกาะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060328,
					"content": "เกี่ยวกับเห็ด...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060329
					]
				},
				{
					"id": 722060319,
					"content": "นั่นไม่ได้เตรียมไว้ให้ฉันหรอกนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060320
					]
				},
				{
					"id": 722060314,
					"content": "ถึงเวลาต้องบอกลากันแล้ว",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060315
					]
				},
				{
					"id": 722060311,
					"content": "\"ทะเลหมอก\" มันเป็นอดีตไปแล้วล่ะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060312
					]
				},
				{
					"id": 722060305,
					"content": "ฉันเองแหละ แฮ่!",
