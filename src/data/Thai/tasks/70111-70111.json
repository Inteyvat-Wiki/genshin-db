				]
			},
			"dialogs": [
				{
					"id": 701110101,
					"content": "ท่านแขกผู้มีเกียรติ ช้าก่อน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110102
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110102,
					"content": "ข้ามเรื่องหยุมหยิมไปเลยแล้วกัน ข้ามีเรื่องหนึ่งอยากขอร้อง วันก่อน ท่าน Yu Huangyi แห่ง Liyue ได้ส่งของล้ำค่าหายากชิ้นหนึ่งมาให้ข้า แต่จนถึงป่านนี้ก็ยังมาไม่ถึง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110103
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110103,
					"content": "ข้าสงสัยว่าสิ่งนั้น อาจจะถูกผู้พิทักษ์ของสถานที่นี้ฉกฉวยไป หากท่านพบ \"ของล้ำค่า\" ที่ท่าน Yu Huangyi กล่าวถึง ช่วยนำกลับมาให้ข้าได้หรือไม่? ถึงเวลานั้น ข้าจะมอบสิ่งตอบแทนให้อย่างงามแน่นอน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				}
			]
		},
		{
			"id": 7011102,
			"completionStepIds": [
				7011102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7011102",
							"2"
						],
						"stepId": 7011102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soga Sumidanoryu Sakon Shigehira"
				],
				"points": [
					{
						"sceneId": 103,
						"position": [
							322.275,
							205.963,
							571.86
						],
						"pointId": 229
					}
				]
			},
			"dialogs": [
				{
					"id": 701110201,
					"content": "พวกเรากลับมาแล้ว! คุณลองดู นี่ใช่ \"ของล้ำค่า\" ที่คุณว่ารึเปล่า?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 701110202,
					"content": "โอ้ ขอบพระคุณจริง ๆ! ขอบคุณทั้งสองท่านมากที่ช่วยเหลือ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110203
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110203,
					"content": "งั้นก็ เพื่อไม่ให้เป็นการเสียเวลา ข้าจะเปิดผนึกเดี๋ยวนี้ล่ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110204
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110204,
					"content": "นะ...นี่มัน...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110205
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110205,
					"content": "หวา! เจ้านี่มันใกล้จะระเบิดแล้วรึเปล่าเนี่ย?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 701110206,
					"content": "ท่าน Yu Huangyi ไม่มีทางทำร้ายข้าแน่... หรือว่ามันจะถูกผู้พิทักษ์พบเข้า แล้วเจอดัดแปลงให้เป็นสิ่งที่เรียกว่า \"ระเบิด\"?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110207
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110207,
					"content": "ช่างน่าอับอายยิ่งนัก แต่ข้าไม่รู้วิธีปลดชนวน \"ระเบิด\" เลยแม้แต่น้อย... จนปัญญาแล้ว คงได้แต่ต้องโยนมันออกไปแล้วล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110208
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110208,
					"content": "ไม่ต้องห่วง! ข้าจำได้ว่าท่านผู้หนึ่งจาก \"Hyperborea\" เหมือนจะเคยตรัสไว้ว่า ควรจะขว้าง \"ระเบิด\" ศักดิ์สิทธิ์ออกไปอย่างไร!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110209
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110209,
					"content": "\"ท่านจงนับถึงสาม ห้ามมากไป ห้ามน้อยไป นับถึงสี่ ไม่ได้ นับถึงแค่สองก็ไม่ได้ ห้านั้นถือว่ามากเกินไป เมื่อตัวเลขที่ท่านนับถึงคือสาม...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110210
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110210,
					"content": "พูดมากเกินไปแล้ว! ขืนไม่รีบโยนเดี๋ยวก็ได้ระเบิดจริง ๆ หรอก!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
