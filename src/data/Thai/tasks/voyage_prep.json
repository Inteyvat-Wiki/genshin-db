	"talks": [
		{
			"id": 7265201,
			"completionStepIds": [
				7265201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7265201",
							"2"
						],
						"stepId": 7265201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"???"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726520101,
					"content": "เฮ้ นักเดินทาง! ช่วงนี้เป็นไงบ้าง? สนใจมาช่วยงานของกองเรือ Crux หน่อยมั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520102,
						726520103
					],
					"speakerTitle": "???"
				},
				{
					"id": 726520102,
					"content": "กองเรือ Crux...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726520104
					]
				},
				{
					"id": 726520104,
					"content": "โอ้... อาฮ่าฮ่าฮ่าฮ่า ขอโทษทีนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520105
					],
					"speakerTitle": "???"
				},
				{
					"id": 726520105,
					"content": "ฉันชื่อ Muzhen เป็นหัวหน้าฝ่ายเทคนิคของ The Alcor ปกติฉันมักจะขลุกอยู่ที่ห้องโดยสาร ไม่ค่อยได้ออกมา เธอไม่รู้จักฉันก็ไม่แปลกหรอก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520106
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726520106,
					"content": "สุดท้ายเลยโดนพี่ Sea Drake ถีบออกมาซะแล้ว ฮ่าฮ่า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520107
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726520107,
					"content": "เขาบอกว่า \"เธอน่ะขี้เกียจตัวเป็นขนแล้ว ขยับตัวบ้างเถอะ! ออกไปอาบแดดบ้างก็คงไม่เป็นไรมั้ง!\" แล้วก็ไล่ฉันมาอยู่บนฝั่งนี่แหละ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520108
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726520108,
					"content": "แต่เขาไม่กล้าแม้แต่จะลงจากเรือด้วยซ้ำ พอมาถึงฝั่งเขาก็วูบไปเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520109,
						726520110
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726520109,
					"content": "งั้นเหรอ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726520111
					]
				},
				{
					"id": 726520111,
					"content": "อ่า จริงด้วย ขอโทษทีนะ ฉันมัวแต่หัวเราะเยาะคนอื่นจนลืมเรื่องสำคัญเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520112
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726520112,
					"content": "เพื่อเตรียมการทางเทคนิคสำหรับการเดินทางทริปต่อไปของนายหญิง ฉันต้องขอให้เธอช่วยอะไรทำบางอย่าง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520113
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726520113,
					"content": "ปกตินายหญิงจะเป็นคนจัดการเรื่องพวกนี้เอง ในฐานะของผู้นำกองเรือ Crux จะต้องมีจิตวิญญาณของการเป็นผู้นำ เพื่อมุ่งไปสำรวจพื้นที่ที่ไม่มีใครรู้จัก...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520114
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726520114,
					"content": "นี่ก็คือกฎของกองเรือ Crux ไม่ว่าใครในหมู่พวกเราได้ขึ้นเป็นหัวหน้า ต่างก็ต้องเคารพกฎนี้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520115
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726520115,
					"content": "ตอนนี้นายหญิงมีเรื่องสำคัญกว่าที่ต้องจัดการใน Inazuma จะปล่อยให้เรื่องเล็กน้อยพวกนี้ทำให้ภารกิจสำคัญช้าลงไม่ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520116
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726520116,
					"content": "เพราะงั้นก็เลยโยนมาให้เรา?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726520117,
					"content": "แหะแหะ ฉันก็เป็นแค่ฝ่ายเทคนิคไม่ใช่นักรบซะหน่อย... อีกอย่างงานบนเรือก็ล้นมือ ทุกคนต่างยุ่งอยู่กับมัน ไม่มีใครปลีกตัวมาได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520118
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726520118,
					"content": "โอเค ไม่พูดเรื่อยเปื่อยแล้ว เรื่องมันเป็นอย่างงี้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520119
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726520119,
					"content": "คนที่จ้างเราส่งสินค้าล็อตต่อไปอยากได้ตัวอย่างสินค้าบางอย่าง ซึ่งก็คือชิ้นส่วนของเครื่องจักรโบราณพิเศษของที่นี่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520120
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726520120,
					"content": "ตามการวิเคราะห์บันทึกของผู้เห็นเหตุการณ์ที่เราได้มาจากนายจ้าง เครื่องจักร... หรือสิ่งมีชีวิตพวกนั้น ซ่อนอยู่เกาะไหนสักแห่งของ Inazuma ซึ่งน่าสนใจสุด ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520121,
						726520125,
						726520130
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726520121,
					"content": "นายจ้างคือใครล่ะ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726520122
					]
				},
				{
					"id": 726520122,
					"content": "เฮ้ คิดจะล้วงความลับทางธุรกิจของกองเรือ Crux รึไง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520123
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726520123,
					"content": "ฮ่าฮ่า ไม่ต้องซีเรียสน่า ถ้าฉันรู้ ฉันต้องบอกเธอแน่นอน... แต่ว่าตามกฎแล้วนี่เป็น \"โทษประหาร\" เลยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520124
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726520124,
					"content": "เพราะงั้นต้องขอโทษจริง ๆ ฉันเองก็ไม่รู้ว่านายจ้างคือใคร แต่มันก็ไม่ได้สำคัญสำหรับเธอหรอก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520134
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726520134,
					"content": "พวกมันอยู่ไหนล่ะ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726520135
					]
				},
				{
					"id": 726520135,
					"content": "ฮ่า เธอถามถูกจุดแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520136
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726520136,
					"content": "ปัญหาคือฉันก็ไม่รู้ว่าพวกมันอยู่ที่ไหนกันแน่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520137
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726520137,
					"content": "แต่ว่าจะมีปรากฏการณ์ประหลาดบางอย่างของธาตุไฟฟ้าบนบางตำแหน่งของเกาะ จากที่ฉันสังเกตดู ความถี่ของมันต่างจากปรากฏการณ์ธาตุไฟฟ้าอื่น ๆ บนเกาะมากเลยทีเดียว...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520138
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726520138,
					"content": "สรุปคือ ฉันคิดว่าเราควรตรวจสอบพื้นที่ที่ผิดปกติพวกนั้นก่อน เป็นไปได้สูงมากว่ามันจะพาเราไปหาเป้าหมายของเรา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520139
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726520139,
					"content": "อีกเรื่องนึง ถ้าพวกมันผลิตอะไรบางอย่างออกมา ฉันหวังว่าเธอจะเอากลับมาให้ฉันศึกษา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520140
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726520140,
					"content": "ไม่ต้องห่วงนะ ฉันจะจ่ายค่าตอบแทนให้แน่นอน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726520125,
					"content": "สิ่งมีชีวิตจักรกล...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726520126
					]
				},
				{
					"id": 726520126,
					"content": "...อืม คนงานเหมืองของ Chasm เคยขุดสิ่งที่คล้ายกันขึ้นมาครั้งนึง ว่ากันว่ามันเกี่ยวกับภัยพิบัติเมื่อห้าร้อยปีก่อน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520127
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726520127,
					"content": "สรุปก็คือ... พวกมันเป็นสิ่งที่ชั่วร้ายที่เดินเพ่นพ่านอยู่ตามโบราณสถาน มันทั้งน่ากลัวและเร้าใจ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520128
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726520128,
					"content": "แค่คิดว่าพวกมันอยู่ที่นี่ ฉันก็คันไม้คันมืออยากจะผ่าพวกมันดูจะแย่แล้ว...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520129
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726520129,
					"content": "แต่เธอไม่ใช่ช่างเทคนิค ความรู้สึกแบบนี้เธอคงไม่เข้าใจหรอก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520134
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726520130,
					"content": "น่าสนใจงั้นเหรอ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726520131
					]
				},
				{
					"id": 726520131,
					"content": "เอ่อ... เธอไม่อยากลองผ่ามันด้วยมือเธอเองสักเครื่องรึไง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520132
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726520132,
					"content": "ไม่ค่อยอยาก... เท่าไร...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726520133,
					"content": "หึ เอาเถอะ... คงมีแต่ช่างเทคนิคที่จะเข้าใจความรู้สึกแบบนี้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520134
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726520110,
					"content": "แล้วมีอะไรให้ช่วยล่ะ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726520111
					]
				},
				{
					"id": 726520103,
					"content": "ฉันรู้จักเธอด้วยเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726520104
					]
				}
			]
		}
	]
}