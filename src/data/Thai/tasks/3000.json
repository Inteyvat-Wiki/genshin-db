					"nextDialogs": [
						30001071
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30001071,
					"content": "พักผ่อนในห้องหนึ่งคืน...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
