				"points": []
			},
			"dialogs": [
				{
					"id": 721740101,
					"content": "ทางฝั่งนี้ของแม่น้ำ... มีต้นไซเปรสสีเงิน พุ่มไม้สีเงิน และก้อนหินสีเงิน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740102,
						721740103
					],
					"speakerTitle": "\"คนพายเรือ\""
				},
				{
					"id": 721740102,
					"content": "ไม่ทราบว่า...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740104
					]
				},
				{
					"id": 721740104,
					"content": "โอ้... มีลูกค้ามา? จะขึ้นเรือรึ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740105
					],
					"speakerTitle": "\"คนพายเรือ\""
				},
				{
					"id": 721740105,
					"content": "อ่ะฮ่าา ดูดี ๆ แล้วเป็นคนนอกนี่นา... ไม่ได้ ไม่ได้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740106,
						721740107
					],
					"speakerTitle": "\"คนพายเรือ\""
				},
				{
					"id": 721740106,
					"content": "ไม่ได้...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740108
					]
				},
				{
					"id": 721740108,
					"content": "เรือสีเงินสว่างไสวที่มุ่งไปยังดวงจันทร์นี้ไม่ได้เตรียมไว้ให้เธอหรอกนะ... อย่าได้เหยียบขึ้นมา และอย่าทำเรือของฉันสกปรกเชียว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740109
					],
					"speakerTitle": "\"คนพายเรือ\""
				},
				{
					"id": 721740109,
					"content": "อ่ะฮ่าา... หมอกจางลงแล้ว หมอกจางลงแล้ว... ใครที่ยังไม่ได้ขึ้นเรือ... นายหญิงแห่งบ้านสีทองจะโกรธเอานะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740110
					],
					"speakerTitle": "\"คนพายเรือ\""
				},
				{
					"id": 721740110,
					"content": "เรือ...? อยู่ไหนเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740111
					]
				},
				{
					"id": 721740111,
					"content": "เหอะ ๆ... เรือสีเงินสว่างไสว เรือแห่งตะวันและขุนเขา ทุกคนต้องกลับบ้านแล้ว บ้านสีทองอร่ามบนดวงจันทร์...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740112
					],
					"speakerTitle": "\"คนพายเรือ\""
				},
				{
					"id": 721740112,
					"content": "แต่ เอ่อ แต่ว่า... มีเด็กคนหนึ่งหลงทาง จนถึงตอนนี้ก็ยังไม่ขึ้นเรือเลย... นายหญิงต้องโกรธแน่ ๆ ไม่ได้การแล้ว...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740113,
						721740114
					],
					"speakerTitle": "\"คนพายเรือ\""
				},
				{
					"id": 721740113,
					"content": "คุณต้องการความช่วยเหลือมั้ย?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740115
					]
				},
				{
					"id": 721740115,
					"content": "รีบขึ้นเรือ รีบขึ้นเรือเร็วเข้า... อย่าหลงทาง อย่ามัวแต่อาลัยอาวรณ์อยู่เลย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"คนพายเรือ\""
				},
				{
					"id": 721740114,
					"content": "คุณฟังที่พูดอยู่รึเปล่า?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740115
					]
				},
				{
					"id": 721740107,
					"content": "พูดเรื่องอะไรน่ะ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740108
					]
				},
				{
					"id": 721740103,
					"content": "คุณคือใคร?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740104
					]
				}
			]
		},
