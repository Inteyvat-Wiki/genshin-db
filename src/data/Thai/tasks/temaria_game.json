				"points": []
			},
			"dialogs": [
				{
					"id": 721760101,
					"content": "#นี่! {F#พี่สาว}{M#พี่ชาย} ฉันมีของดีด้วยล่ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760102
					],
					"speakerTitle": "Kujirai"
				},
				{
					"id": 721760102,
					"content": "ขอบใจนะ แต่ยังไม่สนใจน่ะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760103
					]
				},
				{
					"id": 721760103,
					"content": "น่าสงสารจัง อายุน้อยขนาดนี้ถูกคนอื่นบังคับให้ทำสิ่งที่น่าสงสัยแบบนี้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760104,
					"content": "#ไม่ใช่นะ! ฉันแค่อยากจะเล่น Temari กับ{F#พี่สาว}{M#พี่ชาย}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760105
					],
					"speakerTitle": "Kujirai"
				},
				{
					"id": 721760105,
					"content": "\"Temari\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760106,
					"content": "#พูดง่ายๆ ก็คือ ฉันจะเอา Temari ไปซ่อนที่ไหนสักที่ ภายในช่วงของเพลง Temari ถ้า{F#พี่สาว}{M#พี่ชาย}หาเจอ ก็จะถือว่า{F#พี่สาว}{M#พี่ชาย}ชนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760107
					],
					"speakerTitle": "Kujirai"
				},
				{
					"id": 721760107,
					"content": "Temari เล่นแบบนี้เหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760108
					]
				},
				{
					"id": 721760108,
					"content": "เอ๋? พี่สาวนักผจญภัยเป็นคนสอนฉันเอง พี่สาวยังบอกว่า...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760109
					],
					"speakerTitle": "Kujirai"
				},
				{
					"id": 721760109,
					"content": "\"Kujirai จำไว้เธอจะต้องพูดว่า 'ถ้าชนะแล้วจะได้ของดี' \"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760110
					],
					"speakerTitle": "Kujirai"
				},
				{
					"id": 721760110,
					"content": "#เพราะงั้นนะ {F#พี่สาว}{M#พี่ชาย} ถ้าชนะแล้วจะได้ของดี",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760111
					],
					"speakerTitle": "Kujirai"
				},
				{
					"id": 721760111,
					"content": "#ดีเลย! {NICKNAME} ฉันรู้สึกว่าการเล่นกับเด็กเป็นสิ่งที่ถูกต้อง!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760112,
						721760115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760112,
					"content": "แต่ฉันรู้สึกว่า Temari ไม่ได้เล่นแบบนี้...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760113
					]
				},
				{
					"id": 721760113,
					"content": "อาจจะมีแค่คนในพื้นที่เท่านั้นที่จะรู้วิธีการเล่น อย่าสนใจกับรายละเอียดเล็ก ๆ น้อย ๆ แบบนี้มากนักเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760114,
					"content": "Kujirai ใช่ไหม? พวกเราจะเล่นเป็นเพื่อนเธอเอง!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760116,
					"content": "ได้เลย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kujirai"
				},
				{
					"id": 721760115,
					"content": "ก็ได้",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760116
					]
				}
			]
		},
