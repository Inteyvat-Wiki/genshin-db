			"dialogs": [
				{
					"id": 721760202,
					"content": "อ่า ยากเกินไปเหรอ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760203
					],
					"speakerTitle": "Kujirai"
				},
				{
					"id": 721760203,
					"content": "เมื่อกี้ก็แค่เล่นไม่ดีก็เท่านั้นเอง!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760204,
					"content": "#{F#พี่สาว}{M#พี่ชาย} พวกพี่อยากจะลองอีกครั้งมั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760205
					],
					"speakerTitle": "Kujirai"
				},
				{
					"id": 721760205,
					"content": "#ได้อยู่แล้ว! {NICKNAME} พวกเราให้ Kujirai เห็นความเก่งกาจของพวกเราหน่อยดีกว่า!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760206,
					"content": "เอามาอีก!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760207
					]
				},
				{
					"id": 721760207,
					"content": "ได้เลย! เป้าหมายคือหา Temari ให้เจอภายในเวลาที่กำหนด!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kujirai"
				}
			]
		},
		{
