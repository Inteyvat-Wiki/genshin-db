		{
			"id": 4006606,
			"completionStepIds": [
				4006606
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4006606",
							"2"
						],
						"stepId": 4006606,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaedehara Kageharu",
					"Kaedehara Kazuha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400660601,
					"content": "...ตกลง เป็นแบบนี้ก็ดีแล้วล่ะ Kazuha มาพอดีเลย ดูสิข้าแกะสลักหินก้อนนี้เป็นยังไงบ้าง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660602
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400660602,
					"content": "มีความซับซ้อนและน่าสนใจ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660603
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400660603,
					"content": "หึหึ นี่คือวิวภูเขาที่ข้าเจอในหนังสือ ที่อื่นมีภูเขาดัง ๆ เยอะแยะไปหมด ถ้ามีโอกาส ก็อยากออกไปดูกับตาจริง ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660604
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400660604,
					"content": "ถ้าท่านพ่ออยากจะไป จะออกเดินทางตอนไหนก็ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660605
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400660605,
					"content": "พูดอย่างนี้ไม่ได้หรอก ตอนนี้ข้าเป็นหัวหน้าครอบครัว ถึงจะบอกว่าครอบครัว Kaedehara ไม่เหมือนกับแต่ก่อนแล้ว แต่เรื่องที่ต้องทำ จะปล่อยปละละเลยไม่ได้เลยสักอย่าง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660606
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400660606,
					"content": "แต่...ถ้าจะให้ยึดมั่นตามเส้นทางของท่านพ่อ อุทิศตนทั้งหมดให้กับตระกูลที่ล่มสลายแล้วอย่างนั้น มันคุ้มค่าแล้วจริง ๆ เหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660607
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400660607,
					"content": "ท่านพ่อ ข้า... ไม่เข้าใจ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660608
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400660608,
					"content": "...Kazuha ข้าหวังว่าเจ้าจะจำเรื่องหนึ่งเอาไว้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660609
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400660609,
					"content": "ตระกูลนั้นสำคัญมาก แต่คนก็ไม่ควรยึดติดกับสิ่งนี้เช่นกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660610
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400660610,
					"content": "ครอบครัวอยู่ได้เพราะคน ถ้าพวกเราอยู่กันแบบทนทุกข์ แล้วจะทำให้คนในบ้านมีความสุขได้ยังไงล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660611
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400660611,
					"content": "เรื่องในอดีตส่งผลกระทบต่อตระกูลมาก แต่มันก็ไม่ควรจะเป็นภาระให้ลูกหลานแบกรับ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660612
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400660612,
					"content": "...ถ้าสักวันหนึ่ง เจ้าเหนื่อยหน่ายกับชีวิตที่น่าเบื่อ ก็จงทิ้งทุกอย่างแล้วจากไปซะ จำไว้ว่า อย่าปล่อยให้ชีวิตมาผูกมัดเจ้าไว้เด็ดขาด",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660613
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400660613,
					"content": "ข้าเข้าใจแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
