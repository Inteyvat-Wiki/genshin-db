			"dialogs": [
				{
					"id": 221010101,
					"content": "ไม่มีที่สิ้นสุดเลย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010102
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010102,
					"content": "ทำไมเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221010103
					]
				},
				{
					"id": 221010103,
					"content": "เฮ้อ เปิดโรงแรมที่นี่มันไม่ง่ายเลยจริง ๆ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010104
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010104,
					"content": "ไม่รู้ว่าฉันคิดไปเองรึเปล่า ทำไมถึงรู้สึกว่าอสูรรอบ ๆ บริเวณนี้มันมีมากขึ้นเรื่อย ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010105
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010105,
					"content": "ถึงแม้พวกมันจะไม่มีทางเข้ามาใกล้โรงแรม แต่ว่าที่โรงแรมนั้นก็มีคนเข้าออกอยู่ตลอด พวกกองทหาร Millelith ที่ไป ๆ มา ๆ ก็ไม่สามารถที่จะคอยปกป้องได้ตลอดเวลา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010106
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010106,
					"content": "ถ้าเกิดมีเวลาล่ะก็ เธอช่วยไปจัดการกับพวกอสูรที่อยู่รอบ ๆ โรงแรมนี่ให้หน่อยได้มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010107,
						221010108
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010107,
					"content": "ฉันรู้แล้ว",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221010109
					]
				},
				{
					"id": 221010109,
					"content": "ฮ่าฮ่าฮ่า คุณนี่ตรงไปตรงมาดีนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010113
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010113,
					"content": "ต้องให้คุณมาเหนื่อย รู้สึกไม่ดีเลยจริง ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010114
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010114,
					"content": "ถ้าจัดการเรื่องเสร็จแล้ว รับรองต้องมีของตอบแทนให้คุณอย่างแน่นอน เรื่องนี้ขอให้คุณลูกค้าวางใจ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010115
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010115,
					"content": "ถ้างั้นก็ช่วยจัดการเรื่องต่าง ๆ ทีนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010108,
					"content": "โรงแรมแห่งนี้...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221010110
					]
				},
				{
					"id": 221010110,
					"content": "มาเปิดโรงแรมในสถานที่แบบนี้ก็คงหลีกเลี่ยงไม่ได้ที่จะเจอปัญหาอย่างนี้ล่ะนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010111
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010111,
					"content": "แต่ว่าถ้าเกิดไม่มีโรงแรมของพวกเราตรงนี้ล่ะก็ ถ้างั้นเหล่านักเดินทางที่อยู่ข้างนอกจะไปพักที่ไหนกันล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010112
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010112,
					"content": "ถึงแม้ว่าจะเหนื่อย แต่เปิดต่อไปอย่างนี้ก็ถือว่าเป็นเรื่องดีล่ะนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010113
					],
					"speakerTitle": "Huai'an"
				}
			]
		},
