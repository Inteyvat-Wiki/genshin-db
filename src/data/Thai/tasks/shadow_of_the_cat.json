				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220450101,
					"content": "เอ... แบบนี้ดูเหมือนจะยังไม่ถูกนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450102
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450102,
					"content": "ทำไมเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450103
					]
				},
				{
					"id": 220450103,
					"content": "นักเดินทาง! มาพอดีเลย ฉันกำลังคิดจะไปหาเธออยู่พอดี!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450104
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450104,
					"content": "ช่วงนี้ฉันรู้สึกว่าเวลาแกะสลักรูปปั้น... รูปสลักที่ได้มันดูไม่มีชีวิต...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450105,
						220450107
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450105,
					"content": "ก็มันเป็นรูปสลักไม้นี่นา",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450106
					]
				},
				{
					"id": 220450106,
					"content": "เอ่อ อย่าพูดอย่างงั้นสิ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450108
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450108,
					"content": "อ่า... จะอธิบายยังไงดีนะ? พูดง่าย ๆ คือ ฉันอยากให้มันมี... ชีวิตชีวา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450109
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450109,
					"content": "เธอดูสิ ส่วนใหญ่ท่านรักษาการณ์หัวหน้ามิโกะจะชอบนอนใช่มั้ยล่ะ แต่บางครั้งก็จะลุกมายืดเส้นยืดสาย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450110
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450110,
					"content": "เวลายืดเส้นยืดสาย ท่านรักษาการณ์หัวหน้ามิโกะก็จะกระโดด, ตะครุบใบไม้ร่วง หรือบิดขี้เกียจอะไรพวกนั้น...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450111
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450111,
					"content": "ท่าทางแบบนี้ก็คือความมีชีวิตชีวาที่ฉันอยากได้ ฉันอยากจะ... ใช้ท่าทางพวกนี้เป็นแบบในการแกะสลัก แบบนี้รูปสลักที่ได้ก็น่าจะมีชีวิตชีวาเหมือนที่ฉันอยากได้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450112,
						220450113
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450112,
					"content": "งั้นเธอก็ไปสังเกตดูสิ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450114
					]
				},
				{
					"id": 220450114,
					"content": "อะแฮ่ม ฉัน... ไม่กล้าไปน่ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450115
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450115,
					"content": "ถึงยังไงรักษาการณ์หัวหน้ามิโกะก็เป็นเจ้านายที่ให้เงินเดือนฉัน ถ้าฉันได้สังเกตเธออยู่ข้าง ๆ อาจจะทำให้เธอไม่พอใจได้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450116
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450116,
					"content": "แต่เธอน่าจะสนิทกับรักษาการณ์หัวหน้ามิโกะใช่มั้ย งั้นรบกวนเธอไปถ่ายรูปสักสองสามรูปมาให้ฉันใช้อ้างอิงหน่อยสิ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450117,
						220450118
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450117,
					"content": "ฉันเข้าใจแล้ว",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450121
					]
				},
				{
					"id": 220450121,
					"content": "งั้นช่วยหน่อยนะ ถ่ายรูปเสร็จเมื่อไหร่ก็เอากลับมาให้ฉันละกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450118,
					"content": "แล้วถ้าถ่ายที่ทางที่เธออยากได้ออกมาไม่ได้ล่ะ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450119
					]
				},
				{
					"id": 220450119,
					"content": "ไม่เป็นไร ไม่จำเป็นต้องถ่ายท่าทางแบบนั้นเป๊ะ ๆ หรอก ฝีมือของฉันในตอนนี้ก็แกะสลักท่าทางพวกนั้นยังไม่สวยอยู่ดี...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450120
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450120,
					"content": "แค่ถ่ายรูปรักษาการณ์หัวหน้ามิโกะมาสักสองสามท่า ก็น่าจะพอให้ฉันฝึกฝีมือแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450121
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450113,
					"content": "Neko ก็อยู่ตรงนั้นไม่ใช่เหรอ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450114
					]
				},
				{
					"id": 220450107,
					"content": "เธออยากจะให้มันมี \"ชีวิต\" แบบไหนกัน?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450108
					]
				}
			]
		},
