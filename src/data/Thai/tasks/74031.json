			"dialogs": [
				{
					"id": 740310101,
					"content": "นักรบวัยรุ่น มาประลองกับฉันหน่อยมั้ยล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740310102
					],
					"speakerTitle": "Nizami"
				},
				{
					"id": 740310102,
					"content": "ปุ๊บปั๊บจัง!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740310103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740310103,
					"content": "#จะว่าไงก็ตามแต่ใจเลย {M#น้องชาย}{F#น้องสาว}ผมบลอนด์ แค่มองแวบเดียวฉันก็รู้แล้ว ว่าเธอคือผู้แข็งแกร่งที่ผ่านการฝึกฝนมานาน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740310104
					],
					"speakerTitle": "Nizami"
				},
				{
					"id": 740310104,
					"content": "ช่วงนี้ไม่มีใครมาประลองกับฉันเลย ฉันเบื่อจะแย่แล้วเนี่ย ถ้าเธอยินดีฝึกกับฉันละก็ ฉันจะให้คูปองสวัสดิการเลยนะ! ก่อนหน้านี้ฉันชนะ Roussimoff มาได้ตั้งเยอะ ไม่มีที่จะใช้อยู่พอดีเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740310105
					],
					"speakerTitle": "Nizami"
				},
				{
					"id": 740310105,
					"content": "ว่าไง จะประลองกับฉันหน่อยมั้ย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nizami"
				}
			]
		},
