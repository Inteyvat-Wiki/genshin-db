			"dialogs": [
				{
					"id": 414020301,
					"content": "เอาล่ะ \"กล่องถ่ายรูป\" ตัวนี้ยกให้เธอนะ รับไปสิ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020302,
						414020303
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020302,
					"content": "\"กล่องถ่ายรูป\" นี่... ยกให้ฉันเลยงั้นเหรอ?",
