					"Zakariya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230180101,
					"content": "เฮ้อ ช่างน่าเป็นห่วงจริง ๆ เลย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180102,
						230180103
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180102,
					"content": "มีอะไรให้ช่วยรึเปล่า?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180119
					]
				},
				{
					"id": 230180119,
					"content": "ช่วงนี้กำลังคนของพวกเราก็ไม่พอจริง ๆ นั่นแหละ ฉันเองก็ไม่ได้พักติดต่อกันมาหลายวันแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180120
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180120,
					"content": "นักเดินทาง ถ้าเธอมีเวลาว่างล่ะก็ ช่วยเอายาไปส่งให้ผู้ป่วยที่อยู่แถวนี้ให้ฉันหน่อยได้มั้ย? แล้วก็รบกวนถามอาการเขามาด้วยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180121,
						230180124
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180121,
					"content": "ให้ฉันจัดการเอง",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180122
					]
				},
				{
					"id": 230180122,
					"content": "ถ้างั้นก็รบกวนเธอด้วยนะ เห็นแก่เทพแห่งพฤกษา ฉันต้องการความช่วยเหลือจากคนที่ไม่คอยพร่ำขอให้เทพแห่งพฤกษาช่วยปกปักรักษาตลอดทั้งวันอะไรแบบนั้นจริง ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180123
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180123,
					"content": "อ่า เห็นแก่เทพแห่งพฤกษา... ฉันพูดคำนี้จนคล่องปากแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180124,
					"content": "คุณพักผ่อนหน่อยเถอะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180125
					]
				},
				{
					"id": 230180125,
					"content": "ฉันพักไม่ได้หรอก มีผู้ป่วยที่หนักกว่านี้บางคนที่ฉันส่งไปไว้ที่อื่น ฉันยังต้องจ่ายยาให้พวกเขา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180126
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180126,
					"content": "เฮ้อ ผู้ป่วยคนนั้นจะต้องถามฉันอีกแน่ ว่าจะรับพรจากเทพแห่งพฤกษาได้ยังไง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180127
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180127,
					"content": "ฝากด้วยนะ นักเดินทาง ฉันต้องการความช่วยเหลือจากคนที่ไม่คอยพร่ำขอให้เทพแห่งพฤกษาช่วยปกปักรักษาตลอดทั้งวันอะไรแบบนั้นจริง ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180103,
					"content": "ที่นี่เกิดเรื่องอะไรขึ้นเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180104
					]
				},
				{
					"id": 230180104,
					"content": "เธอคือนักเดินทางสินะ ที่นี่คือ Bimarstan โรงพยาบาลที่ช่วยเหลือมวลชน... อืม... โดยการเผยแพร่คำอวยพรของเทพแห่งพฤกษา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180105
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180105,
					"content": "ไม่ว่าจะรวยหรือจน พวกเราก็จะให้ความช่วยเหลือทางการแพทย์แก่ผู้ที่ต้องการความช่วยเหลือ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180106
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180106,
					"content": "แต่ผลก็คือ... พวกเรามีผู้ป่วยมากเกินไป คนก็เลยไม่พอยุ่งมาก ๆ เลยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180107
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180107,
					"content": "เอ่อ แม้ความกรุณาของเทพแห่งพฤกษาที่มีให้เรานั้นไม่มีจำกัด... แต่งบประมาณและกำลังคนของโรงพยาบาลมีจำกัดนี่นา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180108
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180108,
					"content": "ผู้ป่วยบางคนก็ไม่ฟังคำสั่งของแพทย์ เอาแต่ถามว่าเขาจะรับพรจากเทพแห่งพฤกษาให้ดีขึ้นกว่านี้ได้ยังไง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180109
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180109,
					"content": "ฮ่าฮ่า พรของเทพแห่งพฤกษา... เห็นแก่พระเจ้า!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180110
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180110,
					"content": "ถ้าเทพแห่งพฤกษาประทานพรจริง ๆ พวกเขาก็คงไม่ป่วยหรอก!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180111
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180111,
					"content": "...ฟู่ว ขอโทษทีนะ ฉันไม่ควรพูดแบบนี้ เธออย่าเอาไปบอก Golshan นะ ไม่อย่างงั้นเธอบ่นอีก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180112,
						230180115
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180112,
					"content": "คุณไม่ใช่ผู้ศรัทธาเทพแห่งพฤกษาที่เคร่งครัดเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180113
					]
				},
				{
					"id": 230180113,
					"content": "ฉันต้องเป็นอยู่แล้วล่ะ ในเมือง Sumeru มีคนที่ไม่เป็นด้วยเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180114
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180114,
					"content": "แต่คุณเอาคำว่า \"เคร่งครัด\" นั่นออกไปได้เลยนะ ฉันเป็นผู้ศรัทธาในเทพแห่งพฤกษาอย่างมีเหตุมีผลน่ะ ฮ่าฮ่า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180118
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180118,
					"content": "เอ่อ... ขอโทษทีนะ ฉันจะต้องเหนื่อยเกินไปแล้วแน่ ๆ อารมณ์ของฉัน เธออย่าเอาไปคิดเป็นจริงเป็นจังเลยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180119
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180115,
					"content": "มีคนบอกว่าการรักษาเป็นพรของเทพแห่งพฤกษา...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180116
					]
				},
				{
					"id": 230180116,
					"content": "เฮ้อ คำพูดพวกนี้เธอฟังไว้ก็พอแล้วล่ะ อย่าไปคิดจริงจังเหมือนคนไข้พวกนั้นเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180117
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180117,
					"content": "ถ้าเทพแห่งพฤกษาทำทุกสิ่งทุกอย่างได้จริง งั้นฉันให้คนไข้กินเห็ด พวกเขาก็น่าจะหายป่วยได้แล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180118
					],
					"speakerTitle": "Zakariya"
				}
			]
		},
		{
