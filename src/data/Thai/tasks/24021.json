				]
			},
			"dialogs": [
				{
					"id": 240210101,
					"content": "โอ๊ย... ทำไมกล่องนี้มันถึงได้หนักขนาดนี้เนี่ย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210102
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210102,
					"content": "เธอไม่เป็นไรใช่มั้ย?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240210103
					]
				},
				{
					"id": 240210103,
					"content": "นักวิจัยกิตติมศักดิ์ระดับสูง เจอกันอีกแล้วนะ ต้องขอโทษจริง ๆ ฉัน... ดูเหมือนเอวของฉันจะได้รับบาดเจ็บ เจ็บมากเลย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210104
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210104,
					"content": "ก่อนหน้านี้ฉันเตรียมจะย้ายกล่องอันหนึ่ง เพื่อจัดระเบียบข้อมูลที่อยู่ข้างในน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210105
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210105,
					"content": "ฉะ...ฉันไม่นึกว่ากล่องใบนั้นจะหนักขนาดนี้ พอฉันยกขึ้นก็ยืนไม่อยู่แล้วน้ำหนักทั้งหมดก็ตกอยู่ที่เอว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210106
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210106,
					"content": "ตอนนี้ฉัน... รู้สึกเหมือนเอวจะหักแล้ว โธ่เอ้ย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210107,
						240210108
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210107,
					"content": "ให้ฉันแบกเธอไปหาหมอมั้ย?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240210109
					]
				},
				{
					"id": 240210109,
					"content": "มะ...ไม่ต้อง... ก่อนหน้านี้เอวฉันก็ได้รับบาดเจ็บมาก่อน ขอแค่ได้พักผ่อนสักหน่อยเดี๋ยวก็ดีขึ้น...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210110
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210110,
					"content": "ใส่เอกสารไว้เยอะแยะแค่ไหนเนี่ย ถึงได้หนักขนาดนั้น...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240210111,
					"content": "น่าจะเป็น... แฟ้มเอกสารเยอะมาก เยอะมาก ๆ เลยล่ะ ก่อนหน้านี้ทางศูนย์เคยใช้ \"บันทึกเครื่องหมายทำงาน\" อยู่ช่วงหนึ่งน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210112
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210112,
					"content": "พูดง่าย ๆ ก็คือ การดำเนินการวิจัยในศูนย์ทั้งหมด ต้องทิ้งเอกสารกระดาษไว้เป็นหลักฐาน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210113
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210113,
					"content": "หลังจากการส่งเสริมวิธีนี้ในการทำงาน ปริมาณการใช้กระดาษของศูนย์วิทยาศาสตร์ทั้งหมดก็เพิ่มขึ้นถึงห้าเท่า...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210114
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210114,
					"content": "เนื่องจากมีเอกสารเยอะเกินไป แต่ละสำนักงานจึงถูกบังคับให้ตั้งตำแหน่งสำหรับ \"จัดระเบียบเอกสาร\" เพื่อจัดเรียงเอกสารให้เป็นหมวดหมู่โดยเฉพาะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210115
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210115,
					"content": "หมายความว่า ทุกอย่างต้องเขียนลงบนกระดาษ? ฟังดูยุ่งยากชะมัด...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240210116,
					"content": "ใช่แล้ว ต่อมารูปแบบการทำงานแบบนี้ก็ค่อย ๆ หายไป มีเหลือทำกันอยู่แค่กลุ่มเล็ก ๆ เท่านั้น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210117
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210117,
					"content": "อย่าพูดถึงเรื่องนี้เลย... นักวิจัยกิตติมศักดิ์ระดับสูง คุณช่วยฉันหิ้วกล่องแฟ้มหน่อยได้มั้ย? ถึงฉันจะยังปวดหลัง แต่ก็ต้องรีบจัดแฟ้มเอกสารข้างในให้เรียบร้อยก่อน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210118,
						240210119
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210118,
					"content": "ก็ได้",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 240210119,
					"content": "เธอก็พักผ่อนให้เต็มที่เถอะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240210120
					]
				},
				{
					"id": 240210120,
					"content": "ไม่เป็นไร การจัดเอกสารใช้แค่มือเท่านั้น ไม่ได้ใช้เอว คุณวางใจเถอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210108,
					"content": "ฉันจะเรียกคนมาได้นะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240210109
					]
				}
			]
		},
