					"Kaedehara Kazuha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400720201,
					"content": "หยุดนะ ใครน่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720202
					],
					"speakerTitle": "เรเวนผู้เคร่งขรึม"
				},
				{
					"id": 400720202,
					"content": "ดูท่าทางแล้ว พวกเธอไม่น่าใช่คนของดินแดนแห่งราตรีบริสุทธิ์นะ? พูดมา! พวกเธอมาทำอะไรที่นี่!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720203
					],
					"speakerTitle": "เรเวนผู้มีสายตาเย็นชา"
				},
				{
					"id": 400720203,
					"content": "มีทหารรักษาการณ์ด้วยแฮะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400720204,
					"content": "อย่าตกใจไป",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400720205
					]
				},
				{
					"id": 400720205,
					"content": "เอ๋? เธอทำอะไรน่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400720206,
					"content": "พวกเราคือข้ารับใช้ของเจ้าหญิง",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400720207
					]
				},
				{
					"id": 400720207,
					"content": "ผู้ที่เดินทางข้ามผ่านทะเลแห่งดวงดาวมา",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400720208
					]
				},
				{
					"id": 400720208,
					"content": "จะพิสูจน์ได้ยังไงว่าเธอคือข้ารับใช้ของฝ่าบาท?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720209
					],
					"speakerTitle": "เรเวนผู้เคร่งขรึม"
				},
				{
					"id": 400720209,
					"content": "เหอะ กล้าถามคำถามแบบนี้ออกมา บ่งบอกว่าพวกเธอมีตาแต่หามีแววไม่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720210
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400720210,
					"content": "\"ขอให้ประชาชนของข้าจงมีอิสรภาพ และไม่ยึดติดกับกฎเกณฑ์โบราณทั้งปวง\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720211
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400720211,
					"content": "มะ...มันคือรหัสลับของดินแดนแห่งราตรีบริสุทธิ์! พวกเขาเป็นข้ารับใช้ของฝ่าบาทจริง ๆ ด้วย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720212
					],
					"speakerTitle": "เรเวนผู้มีสายตาเย็นชา"
				},
				{
					"id": 400720212,
					"content": "โอ้ ฉะ...ฉันเสียมารยาทแล้ว! ทุกท่านได้โปรดให้อภัยพวกเราด้วย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720213
					],
					"speakerTitle": "เรเวนผู้เคร่งขรึม"
				},
				{
					"id": 400720213,
					"content": "รู้ว่าผิดแล้วยังไม่รีบหลบไปอีก?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400720214,
					"content": "ดะ...ได้ ฉันจะไปเดี๋ยวนี้แหละ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720215
					],
					"speakerTitle": "เรเวนผู้เคร่งขรึม"
				},
				{
					"id": 400720215,
					"content": "พวกเขาไปแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400720216,
					"content": "นี่ก็คือเล่มที่สองของ \"บทร่ายแห่งดินแดนศักดิ์สิทธิ์\" ทุกคนพร้อมกันรึยัง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720217
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400720217,
					"content": "ไปกันเลย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
