				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaedehara Kazuha",
					"Xinyan",
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400721301,
					"content": "กลับมาอีกแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400721302,
					"content": "เมื่อกี้พวกเราเหมือนจะแอบเห็นโฉมหน้าที่แท้จริงของมังกรชั่วร้ายแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721303
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400721303,
					"content": "เฮ้อ เรื่องแบบนี้ฉันเข้าใจดีเลยล่ะ มักจะมีคนชอบคิดว่างานอดิเรกของพวกเราเป็นเรื่องเสียเวลา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721304
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400721304,
					"content": "หืม? เธอ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721305
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400721305,
					"content": "ฉันคือ \"Arnold ผู้ปรารถนาให้ถูกถามทาง\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721306
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400721306,
					"content": "ฉันหมายถึง ทำไมเป็นเธออีกแล้วล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721307
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400721307,
					"content": "อ้อ อ้อ ฉันเดาว่าพวกเธอน่าจะตามหาตอนที่สามของ \"บทร่ายแห่งดินแดนศักดิ์สิทธิ์\" น่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721308
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400721308,
					"content": "ทายแม่นจริง ๆ นะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721309
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400721309,
					"content": "ท่านหญิงที่รัก คุณไม่จำเป็นต้องทำอะไรเพื่อฉันเลย ความงามของคุณคือรางวัลอันแสนยิ่งใหญ่ที่สุดแล้วสำหรับฉัน ฉันขอมอบคำตอบทั้งหมดที่คุณกำลังตามหาไว้ ณ ที่แห่งนี้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721310
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400721310,
					"content": "ตอนที่สามของพระคัมภีร์ศักดิ์สิทธิ์ อยู่บนชั้นบนสุดของเมือง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721311
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400721311,
					"content": "มีมาตรการรักษาความปลอดภัยอะไรมั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721312
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400721312,
					"content": "อ้อ อ้อต้องมีอยู่แล้วล่ะ คุณก็พูดไปเรื่อยเนอะ? ประเทศไหนจะเอาหนังสือที่สำคัญที่สุดไปไว้ในที่โล่งแจ้งกันล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721313
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400721313,
					"content": "หมายความว่า ที่นั่นก็มีผู้พิทักษ์เรเวนรัตติกาลอยู่งั้นเหรอ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721314
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400721314,
					"content": "การปกป้องพระคัมภีร์ศักดิ์สิทธิ์ถือเป็นเกียรติสูงสุดของชาวเมือง แต่ไม่เป็นไร คิดว่าท่านหญิงท่านนี้ก็แค่อยากจะอ่านพระคัมภีร์ศักดิ์สิทธิ์เท่านั้น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721315
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400721315,
					"content": "ใบหน้าของคุณช่างน่าหลงใหล และยังเปี่ยมล้นด้วยปัญญา คู่หูของคุณก็ดูเหมือนผู้กล้าเลย ถ้าเป็นทุกท่านล่ะก็ คงจะเข้าใจเรื่องราวในพระคัมภีร์ศักดิ์สิทธิ์ของพวกเราได้อย่างแน่นอน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721316
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400721316,
					"content": "เรื่องราวของฝ่าบาทที่ได้รับการถ่ายทอดโดยท่าน Oz เสมียนคนสำคัญ กลายเป็นสมบัติล้ำค่าของดินแดนแห่งราตรีบริสุทธิ์ ทุกครั้งที่ฉันอ่านหนังสือเล่มนี้ ฉันจะภาวนาให้ฝ่าบาทมีความสุข",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arnold"
				}
			]
		},
		{
			"id": 4007218,
			"completionStepIds": [
				4007218
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
