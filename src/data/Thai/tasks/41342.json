					"Wrench Wang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413420501,
					"content": "Siyu? ธะ...เธอให้โคม Xiao ฉันงั้นเหรอ? ฉะ..ฉันขอดูหน่อย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420502
					],
					"speakerTitle": "Wrench Wang"
				},
				{
					"id": 413420502,
					"content": "ฮ่าฮ่าฮ่า นี่คือความปรารถนาที่เธอเขียนให้ฉันเหรอ ตอนเด็ก ๆ ฉันอยากให้ความปรารถนานี้เป็นจริงมากที่สุดเลยล่ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420503
					],
					"speakerTitle": "Wrench Wang"
				},
				{
					"id": 413420503,
					"content": "เวลาหลายปีผ่านไปในชั่วพริบตา ช่างผ่านไปเร็วจริง ๆ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420504
					],
					"speakerTitle": "Wrench Wang"
				},
				{
					"id": 413420504,
					"content": "แต่ทำไม Siyu ถึงให้เธอเอาโคม Xiao นี้มาให้แทนล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420505,
						413420506
					],
					"speakerTitle": "Wrench Wang"
				},
				{
					"id": 413420505,
					"content": "เธอยังมีเรื่องในบ้านที่ต้องทำน่ะ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420507
					]
				},
				{
					"id": 413420507,
					"content": "งั้นเหรอ อย่างนี้นี่เอง...ดีแล้ว ดีแล้วล่ะ ดีมากเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420508
					],
					"speakerTitle": "Wrench Wang"
				},
				{
					"id": 413420508,
					"content": "ตอนนี้ Siyu คงมีความสุขมากเลยสินะ แบบนี้ก็ดีแล้วล่ะ... ฮ่าฮ่า...ฮ่า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420509
					],
					"speakerTitle": "Wrench Wang"
				},
				{
					"id": 413420509,
					"content": "งั้นก็ดีเลย... ขอโทษนะ...พอดีฉันยังมีงานที่ต้องทำอีกเยอะเลย ขอตัวก่อนล่ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wrench Wang"
				},
				{
					"id": 413420506,
					"content": "เธอบอกว่าจะกลับไปช่วยสามีที่บ้านน่ะ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420507
					]
				}
			]
		},
