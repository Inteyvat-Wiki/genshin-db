				{
					"id": 413421202,
					"content": "โอ้ ใช้ได้เลย ขอบคุณมากนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413421203
					],
					"speakerTitle": "Wrench Wang"
				},
				{
					"id": 413421203,
					"content": "ยังมีงานเล็ก ๆ น้อย ๆ ที่ต้องทำ... รบกวนเธอช่วยไปที่ท่าเรือและจัดการสินค้าใหม่ที่เพิ่งมาถึงได้มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413421204
					],
					"speakerTitle": "Wrench Wang"
				},
				{
					"id": 413421204,
					"content": "น่าจะมีทั้งหมดสามกล่อง กองอยู่ที่ท่าเรือน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413421205
					],
					"speakerTitle": "Wrench Wang"
				},
				{
					"id": 413421205,
					"content": "ให้ฉันจัดการเอง",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413421206
					]
				},
				{
					"id": 413421206,
					"content": "งั้นก็ช่วยหน่อยนะ ฉันต้องจัดการงานตรงนี้ให้เสร็จ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wrench Wang"
				}
			]
