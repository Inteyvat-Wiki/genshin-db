				{
					"id": 150400310,
					"content": "เรื่องจิ๊บจ๊อยน่า ฮี่ฮี่ ต้องยกผลงานให้พวกเขาสองคนนั้นเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400311
					],
					"speakerTitle": "Paimon"
				},
