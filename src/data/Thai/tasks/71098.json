					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710981515,
					"content": "\"เครื่องคำนวณค่า\"... มี \"ความคิด\" อยู่รึเปล่า?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710981516
					]
