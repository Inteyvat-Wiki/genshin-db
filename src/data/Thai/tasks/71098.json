	"talks": [
		{
			"id": 7109801,
			"completionStepIds": [
				7109803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
