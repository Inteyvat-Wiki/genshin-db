					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 732150302,
					"content": "พวกเธอมาทำอะไรกันเนี่ย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150303
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 732150303,
					"content": "ก็เธอบอกว่าอย่าลืมกลับมาเล่นด้วยอีกไม่ใช่รึไง!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732150304,
					"content": "เอ๋ ฉันเคยพูดแบบนี้ด้วยเหรอ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150305,
						732150307
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 732150305,
