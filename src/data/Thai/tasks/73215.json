			"dialogs": [
				{
					"id": 732150201,
					"content": "สวัสดี สวัสดี!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150202
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 732150202,
					"content": "สวัสดี เจ้าตัวน้อย! ยังจำพวกเราได้มั้ย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732150203,
					"content": "เจ้าตัวขาวบินได้จอมร้ายกาจ ฉันไม่ใช่เจ้าตัวน้อยนะ! พวกเธอยังจำเพลงที่ฉันสอนให้ได้มั้ย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150204
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 732150204,
					"content": "แน่นอน",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150205
					]
				},
				{
					"id": 732150205,
					"content": "ดีจังเลย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150206
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 732150206,
					"content": "งั้นพวกเธอต้องรับปากฉันนะ ถึงแม้ฉันลืมเพลงของตัวเองไป... พวกเธอก็ต้องจำได้นะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakin"
				}
			]
		},
