					"nextDialogs": [
						400390404
					]
				},
				{
					"id": 400390404,
					"content": "นักเดินทาง? พวกเธอมาได้ยังไงเนี่ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390405
					],
					"speakerTitle": "Beidou"
				},
				{
