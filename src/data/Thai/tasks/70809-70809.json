						],
						"pointId": 16779
					}
				]
			},
			"dialogs": [
				{
					"id": 708090301,
					"content": "(ในรังนกมีเศษกระดาษชิ้นเล็กชิ้นน้อยกระจัดกระจายอยู่มากมาย ดูเหมือนจะมีร่องรอยลายมือที่ขาด ๆ หาย ๆ อยู่ด้วย...)",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						708090302
					]
				},
				{
					"id": 708090302,
					"content": "เศษกระดาษพวกนี้... คงไม่ใช่ว่าพวกมันตั้งใจฉีกมาเพื่อทำรังหรอกใช่มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090303,
					"content": "เหมือนจะมีตัวหนังสือเขียนอยู่ด้วยนะ อยากลองต่อดูมั้ยว่าเขียนไว้ว่าอะไร?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090304,
					"content": "สุดท้ายก็ต้องมาต่อเองอยู่ดี...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708090305
					]
				},
				{
					"id": 708090305,
					"content": "เธอไม่สงสัยหน่อยเหรอ? เผลอ ๆ อาจจะเป็นแผนที่สมบัติก็ได้นะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090306,
					"content": "ต่อแผ่นกระดาษจนเสร็จ ท่ามกลางเสียงเร่งเร้าของ Paimon...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						708090307
					]
				},
				{
					"id": 708090307,
					"content": "ไหนฉันดูหน่อยซิ... นี่มัน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090308,
					"content": "นะ...นี่หรือว่าจะเป็น... \"แผนการก่ออาชญากรรม\" งั้นเหรอ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090309,
						708090311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090309,
					"content": "แผนก่ออาชญากรรมของใครจะโดนนกคาบไปกันล่ะ!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708090310
					]
				},
				{
					"id": 708090310,
					"content": "ตะ...แต่ว่าในนิยายก็มักจะมีพล็อตแบบนี้อยู่บ่อย ๆ นี่นา! แผนการที่ไม่มีทางพลาด ดันมาพลาดในจุดที่ไม่น่าจะเป็นไปได้ที่สุด...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090313,
					"content": "พวกเราไปสืบข่าวที่ร้านเหล้าแถว ๆ นี้กันดูมั้ย? เผื่อจะมีใครเคยได้ยินเรื่องอย่าง \"ช่วงนี้มีคนกำลังจะก่ออาชญากรรม!\" อะไรทำนองนี้บ้าง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090311,
					"content": "เชื่อว่ามีไว้ก่อน ดีกว่าเชื่อว่าไม่มี...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708090312
					]
				},
				{
					"id": 708090312,
					"content": "ธะ...เธอพูดถูก กันไว้ดีกว่าแก้... ถ้ามีคนคิดจะก่ออาชญากรรมจริง ๆ จะมาเสียใจทีหลังก็สายไปแล้ว!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090313
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7080904,
			"completionStepIds": [
				7080907
			],
