			"dialogs": [
				{
					"id": 761250201,
					"content": "(Columbina ไม่อยู่ที่นี่จริง ๆ ด้วย...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250202
					]
				},
				{
					"id": 761250202,
					"content": "หรือว่า Columbina จะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250203,
					"content": "(เธอก้าวเข้าไปใน \"ประตูจันทรา\" ไม่มีใครรู้ว่าข้างในนั้นมีอะไร แต่ที่นั่นเป็นสถานที่ที่แม้แต่ \"ผู้ล่าจันทรา\" ที่แข็งแกร่งที่สุดก็ยังถูกฉีกเป็นชิ้น ๆ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250204
					]
				},
				{
					"id": 761250204,
					"content": "(ถ้าตอนนั้นฉัน...)",
