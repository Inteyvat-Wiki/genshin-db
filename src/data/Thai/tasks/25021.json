				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250210101,
					"content": "คราวนี้อย่าวิ่งเพ่นพ่านอีกนะ Hora",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210102
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210102,
					"content": "กรร กรร..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210103
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250210103,
					"content": "วันนี้ Hora เป็นเด็กดีมากเลย",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210104
					]
				},
				{
					"id": 250210104,
					"content": "ใช่แล้ว ต้องขอบคุณที่เธอช่วยฉันทำ \"ลูกบอลลอยน้ำ\" อันนั้นด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210105
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210105,
					"content": "พอมีลูกบอลนี้แล้ว ฉันก็สามารถล่อให้ Hora ทำเรื่องต่าง ๆ ได้ ไม่ว่าจะเป็นการอาบน้ำ กินข้าว นอนหลับ หรือฝึกซ้อม ทุกอย่างสะดวกขึ้นเยอะเลยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210106
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210106,
					"content": "โดยเฉพาะเรื่องตัดเล็บนี่! ถ้าเป็นเมื่อก่อนนะ ลำพังแค่ไล่ตาม Hora ฉันก็เหนื่อยจนแทบหมดแรงแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210107
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210107,
					"content": "ตอนนี้แค่เอาลูกบอลไปวางไว้ตรงหน้า Hora เจ้าเด็กคนนี้ก็จะนั่งลงแต่โดยดีแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210108
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210108,
					"content": "กรรรร กรร...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210109
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250210109,
					"content": "#Hora นายจำ{M#เขา}{F#เธอ}ได้มั้ย? คนที่ช่วยทำของเล่นให้นายเลยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210110
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210110,
					"content": "กรร กรร!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210111,
						250210112
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250210111,
					"content": "เป็นเด็กดีนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210113
					]
				},
				{
					"id": 250210113,
					"content": "โอ้! Hora จำเธอได้ด้วย ดูท่าทางมันจะมีความสุขนะเนี่ย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210114
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210114,
					"content": "เธอจะลองตัดเล็บของมันดูมั้ย? แล้วก็ลองเช็ดเขาของมันด้วยเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210115
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210115,
					"content": "นี่เป็นเรื่องสำคัญสำหรับ Tepetlisaurus ตัวน้อยมากนะ เพราะพวกมันจะต้องขุดหินขุดดิน และก็ต้องคอยฝนเล็บอยู่เสมอ เพื่อตัดเล็บที่ยาวเกินไป หรือเล็บที่ถูกกระแทกจนเสียหาย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210116
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210116,
					"content": "มีแค่วิธีนี้แหละ ที่จะรับประกันได้ว่า Tepetlisaurus ตัวน้อยจะมีกรงเล็บที่สมบูรณ์แบบ เมื่อมันโตขึ้น...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210117
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210117,
					"content": "อะ เอานี่ไปสิ! เรามาใช้โอกาสนี้ตัดเล็บให้มัน และทำความสะอาดตัวให้ Hora กันเถอะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210118,
						250210119
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210118,
					"content": "นายพูดละเอียดจังเลย...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210120
					]
				},
				{
					"id": 250210120,
					"content": "กรรร กรร...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210121
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250210121,
					"content": "แค่ก... นาน ๆ ทีจะได้เห็น Hora เชื่อฟังขนาดนี้นะเนี่ย พอคิดว่าวันนี้ฉันไม่ต้องวิ่งไล่ตาม Hora ไปทั่วทั้งเผ่าแล้ว ฉันก็อดดีใจไม่ได้เลย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210122
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210122,
					"content": "...เหนื่อยแย่เลยนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210123
					]
				},
				{
					"id": 250210123,
					"content": "ไม่มีอะไรหรอก! งั้นเรามาเริ่มกันเถอะ ฉันจะคอยสอนเธออยู่ข้าง ๆ เอง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210124
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210124,
					"content": "เพื่อให้ Hora ผ่อนคลาย ก่อนอื่นเธอต้องใช้แปรงขนาดใหญ่ ทำความสะอาดหลังของมันเบา ๆ ก่อน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210130
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210130,
					"content": "จากนั้นก็ใช้แปรงขนนุ่มทำความสะอาดเขาของมัน ขั้นตอนนี้ต้องออกแรงหน่อยนะ ไม่งั้นอาจจะพลาดคราบสกปรกบางจุดที่อยู่ในรอยแยกไป",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210125
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210125,
					"content": "จากนั้นก็ใช้ผ้าขนหนูเช็ดตัว Hora... แบบนี้มันจะค่อย ๆ ผ่อนคลายขึ้น และกรงเล็บทั้งสี่ก็จะยื่นออกมา ทีนี้ก็สามารถตัดเล็บของมันได้แล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210126,
						250210127
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210126,
					"content": "นี่มันจะละเอียดเกินไปแล้ว",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210128
					]
				},
				{
					"id": 250210128,
					"content": "แน่นอนอยู่แล้ว ฉันเลี้ยงดู Hora มาตั้งแต่เล็ก ๆ ทั้งเผ่า... ไม่สิ ทั้ง Natlan นี้ ไม่มีใครรู้จักมันดีไปกว่าฉันแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210129
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210129,
					"content": "เอาล่ะ เธอช่วยตัดเล็บให้ Hora ตามที่ฉันบอกตะกี้นะ ฉันจะอยู่ข้าง ๆ นี้ ถ้าไม่เข้าใจอะไรก็มาถามฉันได้เลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210127,
					"content": "นายนี่เข้าใจ Hora ดีจริง ๆ เลยนะ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210128
					]
				},
				{
					"id": 250210119,
					"content": "ทำไมจู่ ๆ ก็ตื่นเต้นขึ้นมาล่ะ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210120
					]
				},
				{
					"id": 250210112,
					"content": "(ลูบ Hora)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210113
					]
				}
			]
		},
