					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030205,
						730030206
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030205,
					"content": "ทางนี้ให้ฉันจัดการเอง",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030207
					]
				},
				{
					"id": 730030207,
					"content": "ไม่ได้การล่ะ... ไม่มีเวลาแล้ว...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030208
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030208,
					"content": "#บ้าจริง {NICKNAME} รบกวนเธอด้วยนะ! เรามาลุยไปด้วยกันเถอะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030209
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030209,
					"content": "Iotham เธออยู่ตรงนั้นอย่าขยับนะ! เรามาช่วยเธอแล้ว!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030206,
