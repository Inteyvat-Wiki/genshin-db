					"content": "ยังเลย",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500203
					]
				},
				{
					"id": 733500203,
					"content": "อืม ไม่ต้องรีบนะ การถ่ายรูปไม่ใช่เรื่องง่ายจริง ๆ",
					"roleType": "TALK_ROLE_NPC",
