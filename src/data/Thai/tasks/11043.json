				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110430301,
					"content": "เยี่ยมมาก ผลงานของเธอทำให้ฉันอึ้งจนตาค้างเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430302
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110430302,
					"content": "เป็นนักเดินทางที่สมคำร่ำลือจริง ๆ สถิติแต่ละรายการของเธอ ดีกว่ามาตรฐานเฉลี่ยของชาว Mondstadt ทั้งนั้นเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430303
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110430303,
					"content": "คุณตามพวกเราตลอด แต่ก็ดูไม่เหนื่อยเลยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110430304,
					"content": "ฉันเหรอ? จริง ๆ แล้วฉันใช้การเล่นแร่แปรธาตุช่วยน่ะ แต่นั่นไม่สำคัญหรอก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430305
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110430305,
					"content": "ถ้ากฎของ Teyvat ไม่มีผลต่อเธอล่ะก็ งั้นฉันก็พอจะคาดเดาอารยธรรมของโลกอื่นได้หลายอย่างเลยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430306
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110430306,
					"content": "ถ้ากฎของ Teyvat ไม่มีผลต่อเธอล่ะก็ งั้นฉันก็พอจะคาดการณ์ได้ว่าจะเกิดวิวัฒนาการอะไรบ้าง หากไม่มีผลกระทบเหล่านี้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430307
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110430307,
					"content": "ซึ่งในนั้นแฝงไปด้วยความเป็นไปได้อย่างนับไม่ถ้วน น่าสนใจมากจริง ๆ และคุ้มค่าที่จะลองซ้ำ ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430308
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110430308,
					"content": "ว่าแต่... นี่ช่วยอะไรในงานวิจัยของคุณบ้างเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110430309,
					"content": "ก็ช่วยคลี่คลายปัญหาที่ฉันกลุ้มใจมานานได้ไงล่ะ เดี๋ยวถ้ากลับถึงแคมป์แล้ว ฉันมีสิ่งที่น่าสนใจให้เธอดูด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430310
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110430310,
					"content": "คุณเคยวิจัยสิ่งอื่นแบบนี้อีกบ้างมั้ย?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110430311
					]
				},
				{
					"id": 110430311,
					"content": "ถ้าอย่างงั้นเธออาจจะถูกเปรียบเทียบกับสิ่งแปลก ๆ เยอะแยะมากมาย เธออาจจะไม่ชอบก็ได้นะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430312
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110430312,
					"content": "ทองคำ, Petrified Tree, ดวงอาทิตย์ขนาดแปดเท่า...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430313
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110430313,
					"content": "กระบวนการสำรวจแก่นแท้นั้นน่าหลงใหล แต่น่าเสียดายที่ช่วงเวลาอันน่าหลงใหลนี้ มีเพียงแค่ชั่วขณะเท่านั้น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430314
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110430314,
					"content": "ฉันยอมทุ่มเทแรงกายแรงใจทั้งหมดให้กับการวิจัย แต่ตัวอย่างนั้นมีจำกัด เมื่อได้รู้ในสิ่งที่ไม่รู้แล้ว ความน่าหลงใหลนั้นก็จะค่อย ๆ หายไป",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430315
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110430315,
					"content": "สุดท้ายพวกมันก็จะกลายเป็นสิ่งมีชีวิตธรรมดาทั่วไปอย่าง Sunsettia, Sweet Flower ซึ่งไม่คุ้มที่จะเสียเวลาไปสนใจ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430316
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110430316,
					"content": "โอ๊ะ อย่างงั้นภาพ Hilichurl ที่คุณวาด ก็จะต้องเป็น Hilichurl ที่ไม่เหมือนกัน ถึงจะมีความแตกต่างที่ชัดเจนสินะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110430317,
					"content": "ใช่แล้ว ตอนนั้นที่ฉันบอกว่า \"น่าเบื่อจะตาย ไม่คุ้มที่จะเสียเวลาหรอก\" ก็เพราะสำหรับฉันแล้ว ความน่าสนใจของพวกมันหมดไปตั้งนานแล้วน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430318
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110430318,
					"content": "งั้นหลังจากการทดลองจบแล้ว ในสายตาของคุณ พวกเราจะกลายเป็นแบบนั้นมั้ย? กลายเป็น...เอ่อ ภาพร่าง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110430319,
					"content": "ไม่ต้องห่วงเลย พวกเธอเป็นผู้ช่วยของฉัน และฉันไม่มีทางลืมมิตรภาพนี้แน่นอน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430320
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110430320,
					"content": "เอาล่ะ ก่อนกลับแคมป์เรามาทำการทดลองอันสุดท้าย ซึ่งก็คือการทดลองด้านสติปัญญา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430321
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110430321,
					"content": "มากับฉันสิ พวกเราไปซากปรักหักพังอีกที่นึงกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				}
			]
		},
