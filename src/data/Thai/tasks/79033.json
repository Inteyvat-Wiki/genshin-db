					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790330201,
					"content": "หอยสังข์สามารถลอยอยู่กลางบ่อน้ำได้จริงดิ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330202,
						790330203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330202,
					"content": "ยังไงก็เป็นหอยสังข์ที่ได้รับผลกระทบจากมิติมายานี่นะ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790330204
					]
				},
				{
					"id": 790330204,
					"content": "#อืม มหัศจรรย์จริง ๆ... อ๊ะ ภาพปรากฏขึ้นมาแล้ว {NICKNAME} เธอรีบมาดูเร็ว ในนั้นมีคนกำลังก้มตั... หวาา!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330205,
					"content": "#{NICKNAME} อย่าเพิ่งขยับนะ ด้านหลังของเธอ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330206,
						790330207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330206,
					"content": "ปะ...เป็นของที่น่ากลัวงั้นเหรอ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790330208
					]
				},
				{
					"id": 790330208,
					"content": "อ๊ะ พอมองดูดี ๆ เป็นแค่ภาพที่ฉายจากหอยสังข์แฮะ! จู่ ๆ ก็โผล่มาด้านหลัง ทำเอาตกอกตกใจหมดเลยง่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330209,
					"content": "อุปกรณ์ทดสอบสัญญาณ... สองชุด...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330210,
					"content": "เฮ้อ ฉันนึกว่าเขาจะโดนลงโทษหนักแน่ ๆ เพราะถูกเรียกออกไปคนเดียวแบบนั้นน่ะ ที่แท้ก็แค่ถูกจัดให้ไปทำงานที่ยากกว่าเดิมแค่นั้นเอง โล่งใจจริง ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330211,
					"content": "เขากลัวว่าจะโดนนายด่ามากเลยนะ ฮ่าฮ่า ดูแล้วเหมือน 'น้องชาย' ที่กลัวถูก 'พี่ชาย' ต่อว่าเลยล่ะ... นายว่าจริง ๆ แล้วเขาแค่กลัวว่าทุกคนจะผิดหวังในตัวเขารึเปล่านะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330212,
					"content": "ทั้ง ๆ ที่ทุกคนก็เป็นแค่สมาชิกทีมเดียวกันก็เท่านั้น... แต่ในบางเวลาก็ให้ความรู้สึกเหมือนเป็น \"คนในครอบครัว\" เลยนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330213,
					"content": "คนในครอบครัวงั้นเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330214,
					"content": "อืม... ฉันรู้สึกเหมือนแอบฟังสิ่งที่ไม่ควรจะได้ยินอยู่เลยแฮะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330215,
					"content": "คนที่อยู่ในภาพนี้ดูเหมือนจะไม่ใช่...Fatui ที่ชั่วร้ายขนาดนั้น...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330207,
					"content": "อย่าทำให้คนเค้ากลัวเซ่!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790330208
					]
				},
				{
					"id": 790330203,
					"content": "น่าจะมีอากาศอยู่ในเปลือก...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790330204
					]
				}
			]
		},
		{
