				"objectNames": [
					"Arouet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240130201,
					"content": "นักเดินทาง เธอมาช่วยงานร้านเรางั้นเหรอ? ยินดีต้อนรับนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130202
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 240130202,
					"content": "ไม่ใช่หรอก พวกเราแค่อยากชงกาแฟให้เพื่อนคนนึงน่ะ ตอนนี้ดูเหมือนเขา... เอิ่ม...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130203,
						240130204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240130203,
					"content": "ตอนนี้เขาเศร้าอยู่น่ะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130205
					]
				},
				{
					"id": 240130205,
					"content": "เพื่อนที่พวกเธอพูดถึง หมายถึง Iaune ที่นั่งอยู่ตรงนั้นเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130206
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 240130206,
					"content": "คุณรู้จักเขาด้วยเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130207
					]
				},
				{
					"id": 240130207,
					"content": "ฉันกับ Roialte เป็นเพื่อนกันมานานแล้วล่ะ เขาเคยพูดกับฉันว่า ในสำนักงานของพวกเขามีเด็กที่ทั้งฉลาดและจริงจังคนนึงอยู่คนนึง นั่นก็คือ Iaune",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130208
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 240130208,
					"content": "ไม่ต้องห่วงเขาหรอก คนหนุ่มสาวที่เพิ่งไปทำงานที่กรมกิจการทั่วไป ก็ต้องผ่านช่วงเวลาที่หดหู่ทุกคนนั่นแหละ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130209
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 240130209,
					"content": "พอพวกเขาหาจุดที่เป็นของตัวเองเจอ ก็จะผ่อนคลายลงเองแหละ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130210
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 240130210,
					"content": "ทำไมคุณถึงมีประสบการณ์เยอะขนาดนี้ล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240130211,
					"content": "เพราะฉันเองก็เคยเป็นหัวไชเท้าที่ถูกปลูกอยู่ในกรมกิจการทั่วไปไงล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130212
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 240130212,
					"content": "แต่ฉันไม่พอใจที่เป็นแค่หัวไชเท้า ก็เลยออกมาจากหลุมของฉัน จากนั้น... ก็มาเปิดร้านกาแฟนี้แหละ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130213,
						240130214
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 240130213,
					"content": "ฟังดูเหมือนจะเกิดเรื่องขึ้นเยอะแยะเลย...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130215
					]
				},
				{
					"id": 240130215,
					"content": "ฮ่าฮ่าฮ่า ก็คงงั้นแหละ แต่ตอนนี้ฉันเป็นแค่เจ้าของร้านกาแฟธรรมดา ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130216
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 240130216,
					"content": "เอาเถอะ พวกเธอจะทำกาแฟให้ Iaune แก้วนึงไม่ใช่เหรอ? ฉันจะไปปรับอุปกรณ์ก่อน พวกเธอเตรียมตัวพร้อมแล้วก็มาหาฉันได้เลยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arouet"
				},
				{
					"id": 240130214,
					"content": "รู้สึกว่าข้างในมีเรื่องราวเยอะแยะเลย...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130215
					]
				},
				{
					"id": 240130204,
					"content": "ตอนนี้เขากดดันมากเลยน่ะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130205
					]
				}
			]
		},
