				]
			},
			"dialogs": [
				{
					"id": 747150101,
					"content": "Freminet ทำไมนายดูเหนื่อยจังเลยล่ะ ช่วงนี้ไปเก็บกู้ของมาจนเหนื่อยเกินไปเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747150102,
					"content": "อืม...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150103
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747150103,
					"content": "อย่าหลบอยู่ในหมวกดำน้ำเลยน่า! พวกเราเป็นเพื่อนกันนะ พูดออกมาดีกว่าเก็บเอาไว้ในใจนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747150104,
					"content": "...อืม ผมเข้าใจแล้วฮะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150105
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747150105,
					"content": "เมื่อกี้ ตอนที่ผมลงไปเก็บกู้ของในน้ำ ผมเจอคนน่ารังเกียจคนนึง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150106
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747150106,
					"content": "คนน่ารังเกียจเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747150107,
					"content": "เอ่อ... จะเริ่มเล่าจากตรงไหนดีนะ ตามกฎหมายของ Fontaine สำหรับวัตถุที่จมอยู่ใต้น้ำ ถ้าเจ้าของเดิมได้รับเงินชดเชยค่าประกันแล้ว ของพวกนั้นจะกลายเป็นทรัพย์สินอิสระ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150108
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747150108,
					"content": "จากกฎข้อนี้ ทำให้บางคนมองว่าการดำน้ำเป็นหนทางรวยทางลัด โดยการกู้ซากของที่คนอื่นทำหาย แล้วนำไปขายเป็น Mora ตอนขึ้นฝั่ง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150109
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747150109,
					"content": "การทำแบบนี้ไม่ได้มีเงื่อนไขอะไรที่ยุ่งยาก เลยทำให้ในกลุ่มนักประดาน้ำมี... คนประเภทที่คิดแต่จะหาเงิน ปะปนเข้ามาอยู่เพียบเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150110
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747150110,
					"content": "บางครั้งพวกเขาก็จะไล่ฝูงปลาและ Blubberbeast ไปอย่างหยาบคาย แค่เพราะพวกมันขวางทางทำมาหากินของพวกเขา... ที่ผมไม่รับคำขอบางอย่าง ก็มีส่วนเกี่ยวข้องกับคนพวกนี้อยู่เหมือนกันฮะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150111
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747150111,
					"content": "ที่แท้ก็เป็นแบบนี้นี่เอง... ฉันพอจะเข้าใจความรู้สึกของ Freminet แล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747150112,
					"content": "เมื่อกี้ตอนอยู่ใต้น้ำ ผมก็เจอสถานการณ์แบบนี้อีกแล้ว ผมรวบรวมความกล้าหยุดการกระทำของอีกฝ่าย ถึงแม้ว่าสุดท้ายจะ... โดนด่าก็เถอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150113
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747150113,
					"content": "ทำไมถึงเป็นแบบนั้นล่ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150114,
						747150115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747150114,
					"content": "นายทำถูกแล้วล่ะ!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747150116
					]
				},
				{
					"id": 747150116,
					"content": "#ขอบคุณที่หวังดีนะ {NICKNAME} กับ Paimon แต่ว่า... ถึงมันจะยากและเหนื่อยมากสำหรับผม แต่ผมก็ยังอยากจะพยายามด้วยตัวเอง เพื่อเปลี่ยนแปลงอะไรบางอย่างดูเหมือนกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150117
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747150117,
					"content": "ผมชอบความรู้สึกที่ได้แหวกว่ายอยู่ใต้น้ำอย่างอิสระ คอยสังเกตลวดลายของ Beryl Conch และสัมผัสถึงการหายใจของ Romaritime Flower...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150118
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747150118,
					"content": "เมื่อโลกใต้น้ำยอมรับในตัวคุณ มันก็จะตอบสนองคุณอย่างเป็นมิตรฮะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150119
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747150119,
					"content": "ผมคิดว่านี่คือวิถีทางที่เราควรเลือกที่จะอยู่ร่วมกับโลก ไม่ใช่การแย่งชิงมาอย่างเห็นแก่ตัว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150120
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747150120,
					"content": "ฉันว่า Freminet พูดได้ดีมากเลยนะ! เห็นมั้ยล่ะ พอมีอะไรที่อยากทำหรืออยากพูดจริง ๆ การแสดงมันออกมาก็ทำให้รู้สึกดีกว่าใช่มั้ยล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747150121,
					"content": "อืม...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150122
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747150122,
					"content": "Freminet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747150123,
					"content": "ขอโทษนะฮะ... ผมค่อนข้างจะขี้อาย เอาเป็นว่า... ผะ...ผมจะพยายามต่อไปนะฮะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150124
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747150124,
					"content": "เกือบลืมไปเลย... นี่คือข้อมูลการสำรวจใต้น้ำล่าสุด รับไว้เถอะนะฮะ มันน่าจะเป็นประโยชน์กับพวกคุณ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747150115,
					"content": "คราวหน้าพวกเราช่วยออกหน้าแทนได้นะ!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747150116
					]
				}
			]
		}
	]
}