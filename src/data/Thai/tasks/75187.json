			"dialogs": [
				{
					"id": 751870101,
					"content": "#บนเขาไม่มีลวดลายที่เหมือนเปลวไฟแฮะ... ไม่ใช่ {REALNAME[ID(2)|SHOWHOST(true)]}...",
