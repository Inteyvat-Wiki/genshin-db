			"dialogs": [
				{
					"id": 220000101,
					"content": "วันนี้พวกเราจะเล่นอะไรกันดี?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000102
					],
					"speakerTitle": "หนูน้อย Meng"
				},
				{
					"id": 220000102,
					"content": "อืม ถ้าไม่มีใครมาเล่นเป็นโจรสลัด วันนี้ก็คงจะเล่นไม่ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000103
					],
					"speakerTitle": "หนูน้อย Fei"
				},
				{
					"id": 220000103,
					"content": "แต่ว่าไม่มีใครยอมเป็นโจรสลัดเลย ทำยังไงดีนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000104
					],
					"speakerTitle": "หนูน้อย Meng"
				},
				{
					"id": 220000104,
					"content": "พวกเธอทำอะไรกัน?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000105
					]
				},
				{
					"id": 220000105,
					"content": "พวกเรากำลังเล่นเกมอยู่ แต่ว่ามักจะขาดคนมาเล่นเป็นโจรสลัดทุกทีเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000106
					],
					"speakerTitle": "หนูน้อย Meng"
				},
				{
					"id": 220000106,
					"content": "เพราะว่าไม่มีคนมาเล่นเป็นโจรสลัดเพื่อออกปล้น พวกเราก็เลยเริ่มเล่นกันไม่ได้สักที...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000107
					],
					"speakerTitle": "หนูน้อย Meng"
				},
				{
					"id": 220000107,
					"content": "จริงสิ! พี่ช่วยมาเป็นโจรสลัดทีได้มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000108,
						220000110
					],
					"speakerTitle": "หนูน้อย Meng"
				},
				{
					"id": 220000108,
					"content": "ให้ฉันจัดการเอง",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000109
					]
				},
				{
					"id": 220000109,
					"content": "เยี่ยมไปเลย! งั้นพวกเราไปเตรียมตัวก่อนนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000115
					],
					"speakerTitle": "หนูน้อย Meng"
				},
				{
					"id": 220000115,
					"content": "ถ้าพี่เตรียมตัวพร้อมแล้วก็มาหาทางนี้ได้เลยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "หนูน้อย Meng"
				},
				{
					"id": 220000110,
					"content": "ฉันไม่ค่อยถนัดเรื่องพวกนี้เลยอ่ะ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000111
					]
				},
				{
					"id": 220000111,
					"content": "ไม่เป็นไร ๆ โจรสลัด... อืม ก็พวกที่ไม่มีเหตุผลแล้วก็ชอบขโมยของของคนอื่นนั่นไงล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000112
					],
					"speakerTitle": "หนูน้อย Meng"
				},
				{
					"id": 220000112,
					"content": "ถึงหนูจะยังไม่เคยเห็น แต่ก็เคยฟังมาจากพี่ Beidou ล่ะนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000113
					],
					"speakerTitle": "หนูน้อย Meng"
				},
				{
					"id": 220000113,
					"content": "แต่หนูคิดว่า... คนประเภทนี้ น่าจะเลียนแบบได้ไม่ยากล่ะมั้ง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000114
					],
					"speakerTitle": "หนูน้อย Meng"
				},
				{
					"id": 220000114,
					"content": "อิอิ สรุปก็คือช่วยหน่อยนะพี่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000115
					],
					"speakerTitle": "หนูน้อย Meng"
				}
			]
		},
