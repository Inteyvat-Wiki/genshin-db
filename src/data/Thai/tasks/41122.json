					"Mack"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411220201,
					"content": "สวัสดี เธอมาหาฉันมีธุระอะไรงั้นรึ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220202
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220202,
					"content": "หนังสือสั่งการนี้...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220203
					]
				},
				{
					"id": 411220203,
					"content": "หนังสือสั่งการ? จริง ๆ เลย ขอฉันดูหน่อย... จะให้ฉันกลับไปช่วยจัดการงานต่าง ๆ ในเมือง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220204
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220204,
					"content": "โธ่ ให้กลับไปในเมืองน่ะไม่มีปัญหาหรอก แต่เธอดูเด็กสองคนนั้นสิ พวกเขาไม่ยอมกลับเข้าไปในเมืองน่ะสิ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220205
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220205,
					"content": "ไม่รู้ว่าพ่อแม่ของพวกเขาไปไหน ฉันก็ไม่อยากบังคับให้พวกเขากลับไป เลยได้แต่เฝ้าพวกเขาอยู่ที่นี้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220206
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220206,
					"content": "ในสถานการณ์แบบนี้ ถ้าฉันกลับเมืองไปแล้วเกิดอะไรขึ้นกับเด็กสองคนนี้จะทำยังไงล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220207
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220207,
					"content": "เฮ้อ ฉันบอกไปตั้งกี่ครั้งต่อกี่ครั้งแล้ว ตอนนี้พวกเขาไม่ฟังคำพูดฉันแม้แต่น้อยเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220208
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220208,
					"content": "เอ่ หรือว่า... เธอช่วยพูดแทนฉันดีมั้ย? ไม่แน่ว่าพวกเขาอาจจะฟังเธอบ้าง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220209
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220209,
					"content": "ถ้าสามารถเกลี้ยกล่อมให้พวกเขายอมกลับเมืองแต่โดยดีได้ งั้นฉันก็จะได้กลับไปอย่างสบายใจ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220210
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220210,
					"content": "ฉันจะไปลองดู",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220211
					]
				},
				{
					"id": 411220211,
					"content": "งั้นช่วยหน่อยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mack"
				}
			]
		},
