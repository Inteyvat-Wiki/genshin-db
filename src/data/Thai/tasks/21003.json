					"Qiaoxi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210033001,
					"content": "แล้วนี่จะทำยังไง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033002
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033002,
					"content": "ทำไมเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210033003
					]
				},
				{
					"id": 210033003,
					"content": "อื๋อ? เธอเป็นใครกัน? คนที่จะข้ามสะพานใหญ่น่ะ จะต้องถูกสอบสวนนะ เธอ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033004
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033004,
					"content": "แต่ว่า อืม... ดูเธอแต่งตัวแปลก ๆ อย่างนี้ ไม่น่าจะเป็นคนเลวล่ะนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033005
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033005,
					"content": "ทำไมงั้นเหรอ... เธอคิดดูนะ ถ้าคิดจะทำเรื่องไม่ดีล่ะก็ ต้องแต่งตัวให้ธรรมดาที่สุดถึงจะดีใช่มั้ยล่ะ? จะไปแต่งตัวให้สะดุดตาอย่างเธอได้ยังไงกันล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033015
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033015,
					"content": "มาทำอะไรที่นี่?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033006
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033006,
					"content": "ฉันคือ Millelith ที่รับผิดชอบพื้นที่แห่งนี้ เพราะว่าที่นี่คือจุดคมนาคมสำคัญของ Dihua Marsh ไม่ว่าจะเป็นนักธุรกิจหรือว่านักเดินทาง ทั้งหมดล้วนต้องผ่านที่นี่ทั้งนั้น เพราะงั้นฉันถึงถูกส่งมาเฝ้ายังไงล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033007
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033007,
					"content": "ไม่กี่วันก่อน ฉันได้เจอกับมอนสเตอร์กลุ่มนึง... ดูท่าทางพวกมันจะตั้งค่ายกัน แม้ว่าตอนนี้พวกมันจะยังไม่ได้ทำอะไร แต่ว่าต้องปลอดภัยไว้ก่อน ยังไงฉันก็ต้องคอยเฝ้าดูพวกมัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033008
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033008,
					"content": "ถึงแม้ว่าฉันอยากที่จะไปจัดการกับพวกมัน... แต่ก็ยังกังวล ถ้าเกิดฉันออกห่างจากที่นี่ อาจจะมีมอนสเตอร์ที่อาศัยจังหวะนี้เข้าทำร้ายคนที่เดินทางก็ได้ เพราะงั้นเลยทำได้แค่ติดอยู่ที่นี่...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033009
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033009,
					"content": "ฉันจัดการมอนสเตอร์พวกนั้นเรียบร้อยแล้วล่ะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210033010
					]
				},
				{
					"id": 210033010,
					"content": "เธอจัดการแล้วเหรอ? อา นี่... นี่มันเยี่ยมสุด ๆ ไปเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033011
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033011,
					"content": "รบกวนเธอซะแล้ว ขอโทษจริง ๆ เลยนะ แต่เดิมเป็นงานของฉันแท้ ๆ กลับต้องมากวนเธอซะได้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033012
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033012,
					"content": "เห้อ ก็ไม่รู้ว่าเบื้องบนคิดยังไงกัน ไม่ยอมส่งคนมาที่นี่สักที ฉันคนเดียวจะไปดูทั่วถึงได้ยังไงกันล่ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033013
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033013,
					"content": "ฉันจะต้องหาโอกาสเพื่อรายงานเรื่องนี้ให้ทางเบื้องบนรู้ให้ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033014
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033014,
					"content": "ขอบคุณนะ รับนี่ไปสิ ถือซะว่าเป็นของตอบแทนละกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qiaoxi"
				}
			]
		},
