					"nextDialogs": [
						20131018
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20131018,
					"content": "ขอให้ทั้งสองคนระวังตัวด้วย ถ้าโชคชะตาเป็นใจ เราคงได้พบกันอีก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131019
					],
					"speakerTitle": "Hiiragi Chisato"
