					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205050101,
					"content": "ขอโทษนะ เรียกเธอมาอีกแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050102,
						205050104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050102,
					"content": "ไม่เป็นไร ปกติฉันก็ได้รับการดูแลอย่างดี",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050103
					]
				},
				{
					"id": 205050103,
					"content": "พูดอย่างนี้ก็เยี่ยมไปเลย งั้นฉันจะพยายามพูดให้มันสั้นๆนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050106
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050106,
					"content": "ขอบคุณที่เธอช่วยทำคำขอของกิลด์นักผจญภัยให้เสร็จก่อนหน้านี้ ชื่อเสียงของกิลด์นักผจญภัยนั้นดีไปเรื่อย ๆ แล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050107,
					"content": "แต่ก็เพราะอย่างนี้นี่แหละ คนที่อยากจะมายื่นคำขอที่กิลด์ขอมากขึ้นเรื่อย ๆ แล้ว เหล่านักผจญภัยในตอนนี้ก็ยุ่งกันจนหัวหมุนไปหมด",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050108
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050108,
					"content": "อยากให้พวกเราช่วยหาคนงั้นเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205050109,
					"content": "อืม ไม่ใช่อย่างนั้น ดีใจที่เธอคิดอย่างนั้นนะ ฉันเองก็อยากให้มีคนใหม่เข้ามาเพิ่ม...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050110
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050110,
					"content": "แต่ว่าถึงจะหาคนใหม่ในตอนนี้ก็ยังไม่ได้ช่วยแก้ปัญหาอะไรเท่าไหร่หรอกนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050111
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050111,
					"content": "ฉันอยากจะถามดู ไม่รู้ว่าเพื่อนของเธอจะมีเวลามาช่วยมั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050112,
						205050114
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050112,
					"content": "อยากจะลองปรึกษากับเขาดู",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050113
					]
				},
				{
					"id": 205050113,
					"content": "เยี่ยมไปเลย ขอบคุณนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050117
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050117,
					"content": "ยังไงฉันขอพูดก่อนละกัน เรื่อง <color=#00E1FFFF>\"ออกสำรวจ\"</color> ที่ตอนนี้ค่อนข้างจะเร่งรีบ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050118
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050118,
					"content": "\"ออกสำรวจ\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050119
					]
				},
				{
					"id": 205050119,
					"content": "พวกเรานั้นมักจะคอยสังเกตสิ่งต่าง ๆ รอบ ๆ เมืองเสมอ อย่างเช่นความอันตรายที่หลบซ่อนอยู่ หรือแม้แต่สถานการณ์แปลก ๆ ที่เกิดขึ้นในโบราณสถานด้านล่าง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050120
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050120,
					"content": "เพราะว่าไม่ใช่คำขอที่มาจากคนอื่น เพราะงั้นจึงไม่มีการจำกัดเวลา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050121
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050121,
					"content": "แต่หากพักไว้เป็นเวลานาน ความยุ่งเหยิงของอันตรายที่ซ่อนอยู่อาจกลายเป็นหายนะครั้ง ใหญ่ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050122
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050122,
					"content": "ฟังดูแล้วสำคัญมากเลยนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050123,
						205050125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205050123,
					"content": "พวกเพื่อนๆน่าจะเข้าใจได้ล่ะนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050124
					]
				},
				{
					"id": 205050124,
					"content": "แค่พวกเขาตกลงที่จะเข้าช่วย ขั้นตอนที่เหลือให้ฉันจัดการเอง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050127
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050127,
					"content": "ถ้างั้นจะช้าอยู่ทำไม แนะนำพวกเธอหน่อยละกันว่าการ \"ออกสำรวจ\" ในตอนนี้มีที่ไหนบ้าง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050128
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050128,
					"content": "ยืนยันการ \"ออกสำรวจ\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 205050125,
					"content": "รางวัลล่ะ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050126
					]
				},
				{
					"id": 205050126,
					"content": "สบายใจได้ สิ่งที่ได้ระหว่างการสำรวจนั้นทางกิลด์จะไปรับเอาไว้ ทั้งหมดให้พวกเธอหมดเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050127
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050114,
					"content": "ที่แท้ก็อยากให้เพื่อนฉันเข้าร่วมกิลด์?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050115
					]
				},
				{
					"id": 205050115,
					"content": "ไม่ๆๆ เธอเข้าใจผิดแล้ว ฉันเข้าใจว่าเพื่อนของเธอนั้นมีมากมายหลายแนว จะให้พวกเขามาเข้านั้นก็ออกจะเว่อเกินไปหน่อย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050116
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050116,
					"content": "นี่อาจจะเป็นคำขอที่มากเกินไปหน่อยของทางกิลด์",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050117
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050104,
					"content": "มีรางวัลให้รับแล้วเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050105
					]
				},
				{
					"id": 205050105,
					"content": "ฮ่าฮ่า...ใช่เลย! ดูเธอจะสนใจมากเลยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050106
					],
					"speakerTitle": "Katheryne"
				}
			]
		},
