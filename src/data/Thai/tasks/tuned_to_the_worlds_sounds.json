			"dialogs": [
				{
					"id": 700300301,
					"content": "สายลมยังไม่ได้นำข่าวของเธอมาเลย แต่เธอก็กลับมาแล้ว ช่างน่าประทับใจจริง ๆ เธอทำได้ยังไงน่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300302
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300302,
					"content": "#ฮี่ฮี่ {NICKNAME} น่ะเก่งกว่าที่เธอคิดนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700300303,
					"content": "อะแฮ่ม เท่านี้พอมั้ย?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300304
					]
				},
				{
					"id": 700300304,
					"content": "ขอฉันดูหน่อย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
		{
			"id": 7003004,
			"completionStepIds": [
				7003007
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
