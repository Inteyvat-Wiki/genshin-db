				]
			},
			"dialogs": [
				{
					"id": 700500601,
					"content": "เป็นไง? อันนี้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500602
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500602,
					"content": "กาต้มชา",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500603
					]
				},
				{
					"id": 700500603,
					"content": "ใช่แล้ว! มันคือชา... ชาอะไรน้า? เอาเป็นว่า... มันเป็นของที่พิเศษมากก็แล้วกัน! แถมยังอยู่ใจกลางหมู่บ้านซะด้วย ฉันว่ามันจะต้องมีความหมายพิเศษมากแน่นอน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500604
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500604,
					"content": "อืม... พวกเธอว่า อสูรเสวียนเหวินจะอยู่ในนี้รึเปล่า?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500605,
						700500606
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500605,
					"content": "ถ้าเขียนแบบนี้ มันจะกลายเป็นนิยายในตำนานนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500607
					]
				},
				{
					"id": 700500607,
					"content": "ถ้าเขียนแบบนี้ นิยายของเธอก็ต้องมีองค์ประกอบอย่างเทพเซียนอะไรด้วยน่ะสิ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700500608,
					"content": "นิยายสืบสวนที่มีหัวข้อแบบนี้ รู้สึกว่า...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500609
					]
				},
				{
					"id": 700500609,
					"content": "...อืม! สีหน้าของพวกเธอไม่เลวเลย พวกเธอคิดว่าถ้าเขียนนิยายสืบสวนที่มีอสูรเสวียนเหวินเป็นหัวข้อหลักละก็ คดีนี้มันจะ \"ไร้สาระ\" เกินไปใช่มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500610
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500610,
					"content": "เอ๋? กะ...ก็ให้ความรู้สึกแบบนั้นหน่อย ๆ แหละ แต่ไม่ว่ายังไง นิยายสืบสวนก็ไม่ควรพัฒนาเนื้อเรื่องด้วยหัวข้อแบบนี้ปะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700500611,
					"content": "เดี๋ยวนะ หรือว่าเธอ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500612
					]
				},
				{
					"id": 700500612,
					"content": "#อื้ม ฉลาดนะเนี่ย {NICKNAME} สมกับชื่อเสียงของเธอจริง ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500613
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500613,
					"content": "ใช่แล้วล่ะ สิ่งที่ฉันอยากเขียนก็คือ \"คดีที่ไร้สาระจนไม่อาจเป็นไปได้\" ปฏิกิริยาของคุณ Hung Fan กับพวกเธอนี่น่าสนใจจัง เดี๋ยวฉันจะเอาไปเขียนลงในนิยายด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500614
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500614,
					"content": "ส่วนอสูรเสวียนเหวิน... มันเป็น \"คนร้าย\" ที่ฉันวางไว้น่ะ \"อสูรเสวียนเหวิน\" ที่เล่าลือกันว่าคอยกินคนชั่วร้ายในหมู่บ้าน แต่ไม่มีใครเคยเห็นมันจริง ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500615
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500615,
					"content": "ในช่วงงานเทศกาลครั้งหนึ่ง มีคนในหมู่บ้านคนหนึ่งถูกสังหารในป่า ดูเหมือนจะถูกสัตว์ร้ายโจมตี...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500616
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500616,
					"content": "แต่ในงานฉลองวันที่สอง ตัวเอกของฉันกลับพบเหยื่อที่เดิมทีควรจะตายไปแล้วคนนั้นอีกครั้ง และหลังจากนั้นก็มีเหยื่ออีกคนปรากฏตัวขึ้น...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500617
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500617,
					"content": "แล้วไงต่ออะ แล้วไงต่อ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700500618,
					"content": "ยังไม่ได้คิดน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500619
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500619,
					"content": "...ฉันจะไปล่ะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500620
					]
				},
				{
					"id": 700500620,
					"content": "อย่าเพิ่งสิ รอฉันเขียนเสร็จเมื่อไหร่ ฉันจะมอบให้พวกเธอสองเล่มเลย ฉันยังมีเรื่องใหญ่อีกเรื่องที่อยากจะขอให้พวกเธอช่วยน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500621
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500621,
					"content": "คุณ Hung Fan บอกตลอดไม่ใช่เหรอ ว่าห้ามฉันออกไปนอกหมู่บ้านคนเดียวเด็ดขาด? เรื่องนี้ฉันทำตามที่เขาบอกอย่างเคร่งครัดเลยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500622
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500622,
					"content": "แต่ตอนนี้... ในเมื่อพวกเธอก็มาแล้ว งั้นฉันก็ไม่ถือว่า \"ตัวคนเดียว\" อีกแล้วสิ แล้วก็สามารถออกไปเดินเล่นนอกหมู่บ้านได้แล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500623
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500623,
					"content": "แน่นอนว่าฉันไม่ไปไหนไกลนักหรอก! พวกเธอเต็มใจจะช่วยฉันมั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500624,
						700500625
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500624,
					"content": "ได้... เพราะอยากรู้ตอนจบของนิยายหรอกนะ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500627
					]
				},
				{
					"id": 700500627,
					"content": "ถ้างั้นพวกเราไปทางนั้นกันเถอะ ฉันมีที่หนึ่งอยากจะไปมากเลย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500625,
					"content": "ต้องจ่ายค่าตอบแทนตามกฎนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500626
					]
				},
				{
					"id": 700500626,
					"content": "แน่นอนอยู่แล้ว พวกเธอไม่ต้องห่วงนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500627
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500606,
					"content": "นี่มันเกี่ยวข้องกับนิยายสืบสวนยังไงเหรอ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500607
					]
				}
			]
		},
