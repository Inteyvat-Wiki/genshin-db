					"Zhiqiong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710410301,
					"content": "...กลไกการล็อกยังไม่ขึ้นสนิม มีร่องรอยของน้ำมันหล่อลื่นด้วย... ดูเหมือนว่าหลังปิดเหมืองแล้วก็ยังมีคนคอยดูแลอยู่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410302
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410302,
					"content": "ก้นบล็อกปืนเองก็ยังสมบูรณ์ดี... เพียงแต่กลไกความปลอดภัยนั้นอยู่ในสถานะปิดล็อก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410303
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410303,
					"content": "ฟังไม่รู้เรื่อง... มันคืออะไรอ่ะ คาถาเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710410304,
					"content": "อุโมงค์ข้างหน้าถูกคนเอาหินก้อนยักษ์มาปิดไว้ก่อนที่จะอพยพไปจากเหมือง... ดูเหมือนว่าจะได้ใช้ประโยชน์จากเจ้าปืนนี่แล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410305
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410305,
					"content": "แต่ถ้าไม่มีกระสุน ปืนใหญ่ก็ไร้ประโยชน์อยู่ดี พวกเราต้องหากระสุนให้เจอถึงจะใช้ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410306
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410306,
					"content": "หึ... อย่าพูดเหมือนฉันไม่รู้อะไรนะ จอมเจ้าเล่ห์",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410307
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410307,
					"content": "ใกล้ ๆ นี้มีคลังเก็บของอยู่ที่หนึ่ง ที่นั่นน่าจะมีกระสุนปืนเก็บอยู่... หวังว่าตอนที่อพยพกันในปีนั้นจะไม่ได้ขนกระสุนปืนไปจนหมดนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410308
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410308,
					"content": "เราออกเดินทางกันเถอะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410309
					]
				},
				{
					"id": 710410309,
					"content": "ไปกันเถอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clitopho"
				}
			]
		},
