			"dialogs": [
				{
					"id": 705080101,
					"content": "#โอ้! นี่มัน {NICKNAME} ไม่ใช่เหรอ พอดีเลย มานั่งดื่มกันสักแก้วสองแก้วมั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080102
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080102,
					"content": "ดีใจมากเลยนะที่ได้มาเจอกับเธอที่นี่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080103
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080103,
					"content": "ทำไมทั้งสองคนถึงมาอยู่ที่นี่ได้ล่ะ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705080104
					]
				},
				{
					"id": 705080104,
					"content": "เดี๋ยวนะ พวกเธอสองคนคงไม่ได้มาด้วยกันหรอกใช่มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705080105,
					"content": "ผู้หญิงคนนี้จู่ ๆ ก็โพล่งขึ้นว่าอยากจะพักผ่อนสักหน่อย ก็เลยตัดสินใจมาเที่ยวแถบนี้น่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080106
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080106,
					"content": "แต่ดูเหมือนว่า ความเข้าใจในเรื่องการเดินทางท่องเที่ยวของพวกเราจะไม่เหมือนกันนะ ยังไม่ทันได้ปีนเขาอะไรเท่าไหร่ ก็มาพักผ่อนที่นี่แล้ว นี่มันโรคคนรวยชัด ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080107
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080107,
					"content": "พูดแบบนี้ฉันก็เสียใจเหมือนกันนะ ฉันอุตส่าห์ตั้งใจเลือกที่นี่ เพราะเห็นว่าเธอชอบดื่มเหล้าเลยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080108
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080108,
					"content": "แต่น่าเสียดายที่กัปตันใหญ่เห็นโลกมาเยอะ ก็เลยไม่ค่อยจะพึงพอใจกับร้านเหล้านี้สักเท่าไหร่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080109
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080109,
					"content": "ก็ได้ ๆ มื้อนี้ฉันเลี้ยงเอง โอเคแล้วใช่มั้ยล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080110
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080110,
					"content": "Beidou จะเลี้ยงเหรอ? เลี้ยงพวกเราด้วยมั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705080111,
					"content": "Paimon พวกเราเป็นบาร์เทนเดอร์นะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705080112
					]
				},
				{
					"id": 705080112,
					"content": "อ่ะ จริงด้วย พอดีมันชินน่ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705080113,
					"content": "ทั้งสองท่าน จะดื่มอะไรดีล่ะ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705080114
					]
				},
				{
					"id": 705080114,
					"content": "ฉันขอ Birch Sap แก้วเล็กละกัน จะให้ดีก็ขอแบบเปรี้ยว ๆ หน่อยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080115
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080115,
					"content": "ฉันเอา Dusk แก้วใหญ่ ขอบใจ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080116
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080116,
					"content": "เข้าใจแล้วล่ะ รอแป๊บนึงนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
