					"nextDialogs": [
						4520123
					]
				},
				{
					"id": 4520124,
					"content": "สวัสดี ช่วงนี้เป็นไงบ้าง?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4520125
					]
				},
				{
					"id": 4520125,
