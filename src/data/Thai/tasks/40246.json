						402460706
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460706,
					"content": "เข้าใจแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460707
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460707,
					"content": "เอาล่ะ พวกเธอเงียบหน่อย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460708
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460708,
					"content": "...เหล่าวิญญาณเร่ร่อนที่ล่องลอยไปตามกระแสน้ำ ข้าขอเรียกหาพวกเจ้า เหล่าดวงวิญญาณแตกสลายที่ถูกพรากจาก ถูกทอดทิ้ง และถูกบังคับให้เงียบงันเอ๋ย จงกลับคืนมาตามกลิ่นอายของวันวานเถิด",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460709
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460709,
					"content": "...จงให้ความแค้นที่ไร้นามจำแนกพวกพ้อง จงให้มลทินที่ต้องห้ามดึงดูดเข้าหากัน ณ ที่แห่งนี้ จงรวมตัวขึ้นเป็นรูปเป็นร่างอีกครั้ง!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460710
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460710,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460711
					]
				},
				{
					"id": 402460711,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460712,
					"content": "(...แล้วไงต่อ? จบแล้วเหรอ?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460713
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460713,
					"content": "(อ่า... นี่แหละเหตุผลที่ฉันรับมือกับเวทมนตร์และศาสตร์ลับพวกนี้ไม่ไหว... ไม่รู้เลยว่าขั้นตอนการคำนวณไปถึงไหนแล้ว แถมมองตรรกะของสูตรไม่ออกเลยด้วย)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460714
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460714,
					"content": "(แตกต่างจากวิทยาศาสตร์จักรกลที่ฉันคุ้นเคยลิบลับเลย...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460715
