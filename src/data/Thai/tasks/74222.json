			},
			"dialogs": [
				{
					"id": 742220801,
					"content": "ไม่น่าเชื่อ... ใช่แล้ว นี่คือเสาสัญญาณที่พวกอนารยชนใช้ส่งสัญญาณกัน!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220802,
						742220803
					],
					"speakerTitle": "Giovanni"
				},
				{
