					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220702,
					"content": "ฉันเจออะไรบางอย่าง...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 742220703,
					"content": "ไม่มีอะไร",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220704
					]
				},
				{
					"id": 742220704,
					"content": "ระวังตัวด้วยนะ ถ้ามีอะไรก็รายงานฉันได้ทุกเมื่อเลย!",
					"roleType": "TALK_ROLE_NPC",
