					"nextDialogs": [
						250290217,
						250290221
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290217,
					"content": "ไม่มีปัญหา",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290218
					]
				},
				{
					"id": 250290218,
					"content": "ขอบคุณนะ! ครั้งนี้ผมจะต้องจับการเคลื่อนไหวของพี่ได้อย่างชัดเจนแน่นอน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290219
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290219,
					"content": "Qica นายเองก็ต้องจับตาดูให้ดี ๆ นะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290220
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290220,
					"content": "กรร!",
