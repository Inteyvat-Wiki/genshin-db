						250290204
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290204,
					"content": "มาพยายามด้วยกันเถอะ!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290206
					]
				},
				{
					"id": 250290206,
					"content": "#เอ๋? สวัสดี {M#พี่ชาย}{F#พี่สาว}! พวกเรากำลังฝึกปีนเขากันอยู่น่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290207
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290207,
					"content": "กรรรร! กรรรร!",
