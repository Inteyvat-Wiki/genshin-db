			"dialogs": [
				{
					"id": 705510101,
					"content": "#สวัสดีตอนบ่ายนะ {NICKNAME}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510102
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510102,
					"content": "...นึกไม่ถึงเลยนะว่า ฉันจะโชคดีได้มีโอกาสมาเห็นพรสวรรค์ในการ \"ผสมผสาน\" ของเธอที่ Mondstadt แบบนี้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510103,
						705510104
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510103,
					"content": "คุณ Emilie มาเที่ยวเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510105
					]
				},
				{
					"id": 705510105,
					"content": "ทั้งสองอย่างเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510106
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510106,
					"content": "มีคุณผู้หญิงท่านหนึ่งที่เรียกตัวเองว่าแม่มด ได้เชิญให้ฉันมาดูแลร้านดอกไม้เล็ก ๆ ของเขาน่ะ อีกอย่าง ฉันยังได้รับคำขอจากร้าน Cat's Tail ให้มาช่วยปรุงกลิ่นหอมสูตรใหม่สำหรับร้านด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510107
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510107,
					"content": "#และการได้ปิดท้ายวันที่วุ่นวายด้วยเครื่องดื่มฝีมือ {NICKNAME} ก็ถือเป็นกำไรชีวิตที่ยอดเยี่ยมเลยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510108,
						705510109
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510108,
					"content": "งั้นฉันต้องงัดทีเด็ดออกมาโชว์หน่อยแล้ว!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510110
					]
				},
				{
					"id": 705510110,
					"content": "ฉันเชื่อในการตัดสินใจของเธอนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510111
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510111,
					"content": "(Emilie ไวต่อกลิ่นมากกว่าคนทั่วไป ถ้าเกิดกลิ่นตีกันมั่วซั่วจนคุมไม่อยู่ เธออาจจะรู้สึกไม่โอเครึเปล่านะ?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510112
					]
				},
				{
					"id": 705510112,
					"content": "(เอาเป็นว่า ใช้วัตถุดิบที่เข้ากับกลิ่นอื่นได้ง่าย แล้วก็เติมกลิ่นอายแบบ Fontaine ลงไปหน่อยแล้วกัน)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510113
					]
				},
				{
					"id": 705510113,
					"content": "(งั้นเริ่มจาก \"Lumidouce Twilight\" ฉบับดัดแปลงสไตล์ Mondstadt ก่อนเลยละกัน)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 705510109,
					"content": "ฉันจะชงเครื่องดื่มสุดเซอร์ไพรส์ให้เธอเอง!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510110
					]
				},
				{
					"id": 705510104,
					"content": "คุณ Emilie มาทำธุระเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510105
					]
				}
			]
		},
