				"points": []
			},
			"dialogs": [
				{
					"id": 716620401,
					"content": "โอ้วว! สมกับที่เป็นเธอ แป๊บเดียวก็เข้าใจวิธีจัดการกับดันเจี้ยนนี่แล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620402
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620402,
					"content": "งั้นรบกวนเธอหน่อยนะ ใช้จินตนาการของเธอให้มากที่สุดเท่าที่จะทำได้ เพื่อทำให้ดันเจี้ยนแห่งนี้เปลี่ยนแปลงดูทีสิ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620403
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620403,
					"content": "หวังว่า...พวกเราจะเข้าใจรูปแบบการเปลี่ยนแปลงของดันเจี้ยนนี้ได้โดยเร็ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Honglang"
				}
			]
		},
