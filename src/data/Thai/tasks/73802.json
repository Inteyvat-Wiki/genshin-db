			"dialogs": [
				{
					"id": 738020101,
					"content": "มุ่งสู่ดวงดาวและก้นเหว! ยินดีต้อนรับสู่กิลด์นักผจญภัย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020102
