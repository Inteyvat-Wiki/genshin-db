				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722110101,
					"content": "คุณ Etsuko พวกเราจะไปสำรวจที่ไหนกันต่อดี?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110102
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722110102,
					"content": "ฟู่วว... พักกันสักหน่อยเถอะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110103
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722110103,
					"content": "หืม? พวกเธอเองเหรอ มาหาฉันมีธุระอะไรเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110104
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722110104,
					"content": "เกี่ยวกับเชฟที่พึ่งพาได้...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110105
					]
				},
				{
					"id": 722110105,
					"content": "ตามหาเชฟที่เกาะ Seirai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110106
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722110106,
					"content": "เรื่องมันเป็นอย่างนี้ พอดี Neko เธอ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110107,
					"content": "เธอบอกว่า.... ท่าน Neko ขอให้เธอเตรียมอาหารให้งั้นเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110108
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722110108,
					"content": "อ่า... น่าโมโห! ถ้าฉันมีฝีมือในการทำอาหารก็คงจะดี!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110109
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722110109,
					"content": "ก็คือ พวกเธอต้องการหาเชฟที่ช่วยให้พวกเธอเข้าใจว่าต้องใช้วัตถุดิบอะไรในการทำอาหารที่แมวชอบ ใช่มั้ยล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110110
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722110110,
					"content": "ฉันคิดแป๊บนะ... เชฟ... เชฟ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110111
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722110111,
					"content": "โอ้ พวกเธอลองไปหา Kiminami Anna จากภัตตาคาร Kiminami ที่เมือง Inazuma ดูสิ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110112
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722110112,
					"content": "Kiminami เธอเป็นคนดีมากเลยล่ะ ฝีมือการทำอาหารก็ไม่เลว น่าจะช่วยเหลือเธอได้นะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110113
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722110113,
					"content": "ขอบคุณนะ พวกเราจะลองไปดู",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110114
					]
				},
				{
					"id": 722110114,
					"content": "ไม่เป็นหรอก รีบไปเถอะ Taisuke และฉันจะต้องวางแผนการสำรวจต่อแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110115
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722110115,
					"content": "ฮ่าฮ่า หวังว่าจะช่วยให้ศาลเจ้านี้กลับมาครึกครื้นได้นะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110116
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722110116,
					"content": "ไม่อยากนั้นสิ่งที่เธอกับท่าน Neko ทุ่มเทกันมานานก็จะเสียเปล่า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Etsuko"
				}
			]
		},
		{
