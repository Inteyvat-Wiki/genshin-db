			"dialogs": [
				{
					"id": 740840801,
					"content": "...เมลูซีน!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840802
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740840802,
					"content": "Pahsiv ทำไมเธอถึงมาอยู่ที่นี่ได้? รีบอยู่ให้ห่าง Vishap ตัวนั้นนะ มันอันตรายมาก!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740840803,
					"content": "Paimon ใจดี Pahsiv! อันตราย เมลูซีน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840804
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740840804,
					"content": "Pahsiv ยื่นมือออกไปลูบหัว Vishap ทำให้ Vishap ที่กำลังโกรธเกรี้ยวย่อตัวลงอย่างว่าง่าย\\nมันอ้าปากแล้วคายหยดน้ำใสดั่งคริสตัลออกมา หลังจากนั้นก็หันหลังกระโดดลงน้ำไป",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740840805
					]
				},
				{
					"id": 740840805,
					"content": "กุญแจนี่! ที่แท้กุญแจก็ซ่อนอยู่ในปากของ Vishap นี่เอง! แถมมันยังมอบกุญแจให้เองด้วย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740840806,
					"content": "ของสีฟ้า ของดี กุญแจ ปกป้อง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840807
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740840807,
					"content": "ของสีฟ้าก็คือ Vishap ตัวเมื่อกี้?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740840808
					]
				},
				{
					"id": 740840808,
					"content": "Pahsiv เธอเป็นเพื่อนกับ Vishap ตัวนั้นเหรอ? มันช่วยเธอปกป้องกุญแจ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740840809,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840810
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740840810,
					"content": "ของสีม่วง แย่งกุญแจ... ของสีฟ้า สลบไป...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840811
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740840811,
					"content": "ขะ...ของสีม่วง? ใครอีกนั่น?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740840812,
					"content": "#ของสีม่วง ของไม่ดี... ของสีฟ้า Paimon {NICKNAME} ของดี!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840813
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740840813,
					"content": "เอิ่ม... เอาเถอะ ถึงจะฟังออกว่าเธอกำลังชมพวกเรา แต่ก็รู้สึกแปลก ๆ แฮะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740840814,
					"content": "ของสีม่วง แย่มาก Erinnyes เมลูซีนมาก...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840815
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740840815,
					"content": "เธอหมายถึง... คนที่ทำร้ายเกาะนี้คือเจ้าตัวสีม่วง? โชคดีนะที่ตอนนี้กุญแจอยู่ในมือพวกเรา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740840816,
					"content": "#Paimon {NICKNAME} Pahsiv! แต่ว่า...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840817
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740840817,
					"content": "กุญแจ กุญแจ กุญแจ จัตุรัส ตก...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840818
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740840818,
					"content": "รู้แล้วน่า Pahsiv อย่ารีบร้อนไปเลย พวกเราจะไปจัตุรัสทางตะวันตกเดี๋ยวนี้แหละ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
