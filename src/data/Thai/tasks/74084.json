						740841149
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841149,
					"content": "เมลูซีน!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841150
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841150,
					"content": "เธออยากให้พวกเราช่วยเหลือ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841151
					]
				},
				{
					"id": 740841151,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841152
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841152,
					"content": "ที่แท้ก็คือช่วยเหลือนี่เอง โชคดีไป ๆ ถ้าเกิดจะให้พวกเราไปเต้นใส่เกาะสักสองรอบ นั่นก็งานหยาบเลย...",
