				"points": []
			},
			"dialogs": [
				{
					"id": 722340101,
					"content": "เป็นไง นั่งสบายใช่มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340102
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340102,
					"content": "จู่ ๆ ก็โผล่ออกมา ตกใจหมดเลย!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340103
					]
				},
				{
					"id": 722340103,
					"content": "ขอโทษ ๆ ไม่คิดว่าจะเป็นแบบนี้น่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340104
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340104,
					"content": "ฉันชื่อ Kabayama ฉันก็ชอบนั่งที่ที่เธอนั่งนี่เหมือนกัน เงียบสงบ เหมาะกับการนั่งคิดเรื่องชีวิตมากเลยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340105
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340105,
					"content": "งั้นฉะ ฉันยกให้คุณนั่ง?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340106
					]
				},
				{
					"id": 722340106,
					"content": "อ๋อ ขอบใจนะ แต่ไม่เป็นไรหรอก ว่าแต่เธอมาจากที่อื่นเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340107
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340107,
					"content": "ใช่",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340108
					]
				},
				{
					"id": 722340108,
					"content": "งั้นเธอก็ต้องมีความรู้มากเลยสินะ ฉันไม่เคยไปไหนมาก่อนเลย ถึงแม้จะมีประสบการณ์การย้ายบ้านที่มากมายก็ตาม",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340109
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340109,
					"content": "เอ พูดถึงประสบการณ์การย้ายบ้าน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340110
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340110,
					"content": "เพราะตอนเด็กฉันย้ายบ้านบ่อย ๆ ฉันเลยแทบจะไม่มีเพื่อนสนิทเลย เวลาเดินเล่นแล้วเจอวิวสวย ๆ ก็ไม่มีคนที่จะแบ่งปันด้วยเลย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340111
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340111,
					"content": "เฮ้อ ถ้าพวกเธอได้เห็นวิวพวกนั้นคงจะดีมากแน่ ๆ หากเธอเดินทางผ่านสถานที่เหล่านี้ ก็ลองนั่งลงชมวิวดูสักพักก็ได้ แล้วถ้ากลับมาบอกความรู้สึกกับฉันได้ด้วยก็ยิ่งดีเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340112
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340112,
					"content": "หนึ่งในนั้นอยู่ใต้ประตูหินที่จุดสูงสุดใน The Narrows อีกแห่งหนึ่งคือพื้นที่เปิดโล่งที่รายล้อมไปด้วยปะการังใกล้ Evernight Temple และสุดท้ายคือข้างซากปรักหักพังที่ตั้งสูงตระหง่านของ The Serpent's Heart",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340113
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340113,
					"content": "ฉันทำสัญลักษณ์ไว้ในสถานที่เหล่านั้นหมดแล้วล่ะ แล้วก็แขวนโคมไว้บนที่สูงเพื่อให้แสงสว่างกับตัวเองด้วย เธอน่าจะหาเจอได้ไม่ยาก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kabayama"
				}
			]
		},
