					"nextDialogs": [
						240170407
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170407,
					"content": "ฉันต้องซ่อมชุดประดาน้ำต่อแล้วล่ะ เฮ้อ รูนี่ใหญ่ชะมัดเลย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yves"
				}
