						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yves"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240170201,
					"content": "ไอ้เจ้าคนโลภมากไม่รู้จักพอ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170203
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170203,
					"content": "ชุดประดาน้ำของนายเป็นยังไงบ้าง?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170204
					]
				},
				{
					"id": 240170204,
					"content": "คุณเองเหรอ! ได้เจอคุณแบบนี้ เป็นเรื่องดีที่สุดของฉันในวันนี้เลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170205
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170205,
					"content": "คุณไม่รู้หรอกว่า Goldman หาวิธีใหม่มาทรมานเราอีกแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170206
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170206,
					"content": "เขาจ้างคนที่เก่งเรื่องการคำนวณ และคำนวณว่าในแต่ละวันเราจะเก็บกู้ของได้เท่าไหร่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170222
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170222,
					"content": "หลังจากนั้นเขาก็ใช้ \"ผลการคำนวณ\" นี้ บังคับให้พวกเราต้องเก็บกู้ของให้ได้เยอะเท่านั้นทุกวัน!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170207
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170207,
					"content": "พวกเราเหนื่อยกันมาก บางครั้งก็ได้รับบาดเจ็บ แถมยังหิวจนไส้กิ่วด้วย แทบไม่มีแรงกันเลย เราเก็บกู้ของเยอะขนาดนั้นทุกวันไม่ได้หรอก... แต่ Goldman ก็ไม่สนใจเลยสักนิด!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170223
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170223,
					"content": "ถ้าของที่เราเก็บกู้มาไม่ตรงกับ \"ผลการคำนวณ\" นี้ เขาก็จะด่าพวกเรา แล้วก็หักเงินเราด้วย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170208
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170208,
					"content": "แต่นี่ไม่ใช่ความผิดของคนคำนวณหรอกนะ ผู้ชายคนนั้นชื่อ Finnegan เขาเป็นคนดีที่เห็นอกเห็นใจคนอื่น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170209
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170209,
					"content": "เวลาเขาคำนวณ เขาจะถามเราทีละคนเกี่ยวกับงานที่เราทำแต่ละวัน มีอยู่วันนึงหลังจากที่เขาได้ยินที่พวกเราพูด เขาก็คำนวณไว้เสร็จสรรพเลยล่ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170224
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170224,
					"content": "จู่ ๆ เขาก็ลุกขึ้นและวิ่งเข้าไปในบ้านของ Goldman แล้วตะโกนเรียกหาเขา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170210
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170210,
					"content": "\"...นี่มันไม่สมเหตุสมผล พวกเขาเป็นคนที่มีชีวิต ไม่ใช่เครื่องจักร!\"... ฉันได้ยินแค่ประโยคนี้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170211
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170211,
					"content": "...หลังจากนั้น ลูกน้องของ Goldman ก็โยนเขาออกมา แล้วตกลงไปในแอ่งน้ำ พวกเราเลยไปช่วยเขาขึ้นมา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170212
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170212,
					"content": "หลังจากนั้นคุณคนนั้นก็ขอโทษพวกเรา แล้วก็ร้องไห้อย่างเสียใจ พวกเราไม่ได้โทษเขาหรอก คนคำนวณคนนี้ก็แค่ถูก Goldman เอาเปรียบเหมือนกับพวกเรา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170213
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170213,
					"content": "เขาสัญญากับพวกเราว่า จะต้องหาวิธีทวงความยุติธรรมให้พวกเรา... แต่พวกเราหวังจากใจว่า เขาจะไม่กลับมาบ่อโคลนที่เน่าเหม็นนี้อีก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170214,
						240170215
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170214,
					"content": "งั้นวันนี้นายยังต้องทำงานอีกนานเท่าไหร่?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170216
					]
				},
				{
					"id": 240170216,
					"content": "เยอะเลยล่ะ ไม่รู้เหมือนกันว่าจะทำเสร็จตอนไหน ฉันทำได้แค่พยายามทำให้เยอะ ๆ หวังว่าจะโดนหักเงินน้อยลงบ้าง... ฉันยังต้องไปขอยืมชุดประดาน้ำคนอื่นมาทำงานเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170217,
						240170218
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170217,
					"content": "ให้ฉันช่วยนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170219
					]
				},
				{
					"id": 240170219,
					"content": "จริงเหรอ? คุณยินดีที่จะช่วยฉันต่อจริงเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170220
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170220,
					"content": "คุณเป็นผู้ช่วยชีวิตของฉันจริง ๆ ถ้า Goldman ใจดีได้สักครึ่งนึงของคุณ... อ๊ะ ขอโทษนะ ฉันไม่ควรเอาตาหมูป่าโง่นั่นมาเปรียบกับคุณ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170221
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170221,
					"content": "งั้นก็เหมือนกับครั้งที่แล้ว ฉันทำเครื่องหมายตำแหน่งของของพวกนั้นให้คุณแล้วล่ะ พวกเราแยกกันออกเดินทางกันเถอะ เฮ้อ ฉันจะทำให้ชุดประดาน้ำที่ยืมมาชุดนี้เสียหายไม่ได้เด็ดขาด...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170218,
					"content": "ฉันจะแบ่งเบาภาระนายนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170219
					]
				},
				{
					"id": 240170215,
					"content": "งั้นวันนี้นายต้องทำงานอีกกี่อย่าง?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170216
					]
				}
			]
		},
