				]
			},
			"dialogs": [
				{
					"id": 80160201,
					"content": "เฮ้ มี Hilichurl อยู่ที่นี่ด้วย มันกำลังพักผ่อนอยู่เหรอ? ดูเหมือนจะไม่ก้าวร้าวเลยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160202,
					"content": "ทำไมถึงมาแอบอยู่ที่นี่ล่ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160203,
					"content": "อ้าว เธอทำให้มันตื่นซะแล้ว...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160204,
					"content": "หืม? หนีไปซะแล้ว... ชื่อเสียงของพวกเราใน Natlan ทำให้พวก Hilichurl กลัวหัวหดเลยเหรอเนี่ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160205,
					"content": "เหมือนจะมีอะไรอยู่ตรงนั้นนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160206
					]
				},
				{
					"id": 80160206,
					"content": "เธอหมายถึงอันที่ส่องประกายวิบวับนั่นน่ะเหรอ? มันน่าจะหล่นมาจากตัวเจ้านั่น ตอนที่มันวิ่งหนีละมั้ง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160207,
					"content": "อืม... ฉันเดาว่า มันคงคิดว่าเก็บสมบัติอะไรได้ ก็เลยคิดจะซ่อนไว้ที่นี่ละมั้ง แต่นึกไม่ถึงว่าจะถูกพวกเราเจอเร็วขนาดนี้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160208,
					"content": "ไหนดูซิ ๆ ถึงจะรู้สึกว่า ด้วยสติปัญญาของพวก Hilichurl แล้ว มันไม่น่าจะเป็นของดีอะไรก็เถอะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160209,
					"content": "...!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160210
					]
				},
				{
					"id": 80160210,
					"content": "#เห? ทำไมเหรอ {NICKNAME} ทำไมถึงทำหน้าซีเรียสแบบนั้นล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160211,
					"content": "นี่มันก็แค่กุญแจธรรมดานี่นา แต่ว่ารูปลักษณ์มันดูแปลกจริง ๆ นั่นแหละ ไม่เหมือนสไตล์ของ Natlan เลย... อืม... มันทำขึ้นในประเทศไหนกันนะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160212,
						80160213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160212,
					"content": "นี่มัน...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160214
					]
				},
				{
					"id": 80160214,
					"content": "แคปซูลจำศีลของยานอวกาศ? ยานอวกาศอะไร แคปซูลจำศีลอะไรกัน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160215,
					"content": "เดี๋ยวนะ! แคปซูลจำศีลของยานอวกาศ? ระ...หรือว่า! จะเป็นยานอวกาศที่พาเธอเดินทางมาที่ Teyvat ลำนั้นเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160216,
					"content": "ใช่แล้วล่ะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160217
					]
				},
				{
					"id": 80160217,
					"content": "ทำไมจู่ ๆ มันถึงมาโผล่ที่นี่ได้ล่ะ! แน่ใจนะว่า เมื่อกี้เธอไม่ได้ทำมันหล่นเอง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160218,
						80160219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160218,
					"content": "ของฉันยังอยู่ตรงนี้...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160220
					]
				},
				{
					"id": 80160220,
					"content": "หืม~ เหมือนกันเปี๊ยบเลย... ถ้ากุญแจดอกนี้ไม่ใช่ของเธอ งั้นก็แสดงว่ามันเป็นของ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160221,
						80160222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160221,
					"content": "มันมีแค่สองดอกนั่นแหละ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160223
					]
				},
				{
					"id": 80160223,
					"content": "ว่าแล้วไง... อืม ตอนนี้ฉันถึงเริ่มรู้สึกได้แล้วว่าเธอเป็น \"มนุษย์ต่างดาว\"... อ๊ะ ไม่สิ \"ผู้มาเยือน\" จริง ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160224,
					"content": "ถ้าดูจากสถานการณ์แล้ว ฉันว่าสิ่งที่เกิดขึ้นคือ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160225,
					"content": "#ที่ Hilichurl เก็บกุญแจดอกนี้ได้และซ่อนมันไว้ ก็น่าจะเพราะ{M#น้องสาว}{F#พี่ชาย}ของเธอทำมันหล่นไว้แถวนี้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160226,
					"content": "#แสดงว่า{M#น้องสาว}{F#พี่ชาย}ของเธอ เคยมาที่นี่เมื่อไม่นานมานี้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160227,
						80160228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160227,
					"content": "นั่นก็หมายความว่า...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160229
					]
				},
				{
					"id": 80160229,
					"content": "#ใช่แล้ว... ไม่คิดเลยว่าตอนแรกแค่รับปากช่วย Iansan ลาดตระเวน แต่กลับได้เจออะไรที่สำคัญขนาดนี้ แถมยังเจอเบาะแสของ{M#น้องสาว}{F#พี่ชาย}เธอด้วย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160230,
					"content": "ตอนนี้พวกเราจะหาเบาะแสแถวนี้ต่อ หรือจะกลับไปหา Iansan ที่ \"ผองสรรพสิ่ง\" ก่อนดีล่ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160231,
					"content": "พวกเธออยู่นี่เองเหรอ ลำบากแล้วนะ ดูเหมือนพวกเธอจะตั้งใจลาดตระเวนมากเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160232
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160232,
					"content": "Iansan! ทำไมถึงมาที่นี่ได้ล่ะ ไหนว่าให้ไปรวมตัวกันที่ \"ผองสรรพสิ่ง\" ไง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160233,
					"content": "พวกเรากำลังคิดอยู่เลยว่าจะไปหาเธอดีมั้ย เมื่อกี้เราเจอของสำคัญด้วยล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160234,
					"content": "ฉันมาแจ้งพวกเธอว่า ไม่ต้องลาดตระเวนต่อแล้วล่ะ เพราะการแข่งขันเพาะกายเพิ่งถูกยกเลิกไป เดี๋ยวจะมีหน่วยลาดตระเวนมารับช่วงต่อแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160235
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160235,
					"content": "เดี๋ยวนะ เกิดอะไรขึ้นเหรอ ทำไมจู่ ๆ ถึง...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160236,
					"content": "\"Abyss Order\" บุกโจมตีน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160237
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160237,
					"content": "หา?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160238,
					"content": "นึกไม่ถึงเลยว่า จะยืนยันข้อสันนิษฐานได้เร็วขนาดนี้",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160239
					]
				},
				{
					"id": 80160239,
					"content": "#(ดูเหมือนว่า{F#พี่จะเริ่มเคลื่อนไหวอีกแล้วสินะ} {M#Lumine จะเริ่มเคลื่อนไหวอีกแล้วสินะ})",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160240
					]
				},
				{
					"id": 80160240,
					"content": "#(ครั้งนี้ต้องคว้าโอกาสนี้ไว้ แล้วไปเจอ{M#เธอ}{F#พี่}ให้ได้)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160241
					]
				},
				{
					"id": 80160241,
					"content": "ฉันเคยได้ยินชื่อของ Abyss Order มาก่อน แต่ไม่เคยเห็นพวกมันเคลื่อนไหวระดับใหญ่ขนาดนี้มาก่อนเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160242
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160242,
					"content": "อย่างกับว่า... เตรียมจะเปิดสงครามกับ Natlan ทั้งประเทศอย่างงั้นแหละ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160243
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160243,
					"content": "แค่ \"ภาคี\" เดียว จะเปิดสงครามกับประเทศที่ได้ชื่อว่าเป็น \"ประเทศแห่งสงคราม\" เนี่ยนะ? ไม่อยากจะเชื่อเลย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160244,
					"content": "จำได้ว่าส่วนใหญ่ Abyss Order จะเคลื่อนไหวอย่างลับ ๆ นี่นา นี่เป็นครั้งแรกที่เราเจออะไรแบบนี้... พวกเขาคิดจะทำอะไรกันแน่นะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160245
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160245,
					"content": "ตอนนี้ถ้ามองจากมุมมองของ \"ผองสรรพสิ่ง\" แค่อย่างเดียว สถานการณ์การต่อสู้มันยังไม่ชัดเจนพอ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160246
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160246,
					"content": "ตอนนี้การป้องกันของ \"ผองสรรพสิ่ง\" ไม่น่าจะมีปัญหา ฉันเลยตัดสินใจจะไปหาท่าน Mavuika ที่ลานประลองเพลิงศักดิ์สิทธิ์ เพราะที่นั่นคือศูนย์กลางของเรา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160247
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160247,
					"content": "#{NICKNAME} อยากจะไปกับฉันมั้ยล่ะ ถ้ามีผู้กล้าของ Natlan อยู่ด้วย มันรู้สึกอุ่นใจกว่าน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160248,
						80160249
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160248,
					"content": "ฉันเองก็อยากรู้สถานการณ์เหมือนกัน",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160250
					]
				},
				{
					"id": 80160250,
					"content": "งั้นก็ดีเลย พวกเราไปด้วยกันเถอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160249,
					"content": "ฉันพอจะรู้เรื่อง Abyss Order อยู่บ้าง",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160250
					]
				},
				{
					"id": 80160228,
					"content": "\"Abyss Order\" ก็อาจจะเคยมาที่นี่เหมือนกัน",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160229
					]
				},
				{
					"id": 80160222,
					"content": "#ดอกนึงอยู่กับฉัน ส่วนอีกดอกนึงเป็นของ{M#น้องสาว}{F#พี่ชาย}ฉัน",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160223
					]
				},
				{
					"id": 80160219,
					"content": "...ฉันพกมันติดตัวตลอด",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160220
					]
				},
				{
					"id": 80160213,
					"content": "...กุญแจแคปซูลจำศีลของยานอวกาศ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160214
					]
				}
			]
		},
