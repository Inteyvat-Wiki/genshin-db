					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100608
					],
					"speakerTitle": "Soheil"
				},
				{
					"id": 731100608,
					"content": "ทำไมถึงเป็นแบบนี้ล่ะ...?",
