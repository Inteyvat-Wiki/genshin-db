				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722140201,
					"content": "พอจะเป็นรูปเป็นร่างบ้างแล้ว...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140202
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140202,
					"content": "ฮ่า ๆ พวกเธอเหรอ มาดูรูปปั้นของฉันเร็วเข้า เริ่มเหมือนท่านรักษาการณ์หัวหน้ามิโกะบ้างรึยัง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140203,
						722140205
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140203,
					"content": "เริ่มคล้าย ๆ แล้วล่ะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140204
					]
				},
				{
					"id": 722140204,
					"content": "ใช่มั้ยล่ะ? ฮ่าฮ่าฮ่า ที่ฉันอดหลับอดนอนมาหลายวัน ก็คงไม่เสียเปล่าแล้วสินะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140207
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140207,
					"content": "อ่าา หิวจัง...ฉันไปหาอะไรกินก่อนนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140208
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140208,
					"content": "นี่คือเนื้อปลาที่ Neko ฝากมาให้น่ะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140209
					]
				},
				{
					"id": 722140209,
					"content": "อ่า...ขอบคุณในน้ำใจของท่านรักษาการณ์หัวหน้ามิโกะ แต่ฉัน...ไปหาของกินเองจะดีกว่า...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140210
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140210,
					"content": "ฉันกินปลาติด ๆ กันมาหลายวัน จนแทบจะทนไม่ไหวแล้วล่ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140211
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140211,
					"content": "ฉันก็เลยออกไปหาอาหารเองทุกวัน ถ้าโชคดีก็อาจจะจับนกกระจอกหรือนกพิราบได้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140212
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140212,
					"content": "เฮ้อ แต่ฉันอยากกินเนื้อที่แน่น ๆ ฉ่ำๆ นี่นา...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140213
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140213,
					"content": "อ่า...นักเดินทาง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140214
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140214,
					"content": "ถ้าเธอไม่ว่าอะไรล่ะก็ ช่วยหา Raw Meat ให้ฉันสักสามชิ้นได้มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140215
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140215,
					"content": "ฉันล่าสัตว์ไม่ได้เรื่องเลยน่ะ ผ่านมาตั้งหลายวันแล้วก็ยังไม่ได้สักชิ้นเลย...รบกวนพวกเธอด้วยนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140216,
						722140217
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140216,
					"content": "ก็ได้...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140220
					]
				},
				{
					"id": 722140220,
					"content": "งั้นก็รบกวนพวกเธอด้วยนะ ขอ Raw Meat สักสามชิ้นก็แล้วกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140217,
					"content": "ทำไมไม่กลับไปกินอาหารที่เกาะ Narukami สักมื้อล่ะ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140218
					]
				},
				{
					"id": 722140218,
					"content": "เพราะมันไกลมาก อีกอย่าง...เพราะมือฉันกำลังทำรูปปั้นได้เข้าที่เข้าทางน่ะ ถ้าขืนไปเกาะ Narukami ล่ะก็... ไปมา ๆ มือฉันคงลืมความรู้สึกนี้ไปหมด",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140219
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140219,
					"content": "สู้ให้ฉันอยู่ที่นี่แล้วหาอาหารจานด่วนกิน จะได้กลับไปแกะสลักรูปปั้นต่อยังดีกว่า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140220
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140205,
					"content": "รูปปั้นดูตัวใหญ่กว่า Neko เยอะเลย",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140206
					]
				},
				{
					"id": 722140206,
					"content": "แน่นอนสิ ถึงแม้ท่านรักษาการณ์หัวหน้ามิโกะจะตัวโตกว่าแมวทั่ว ๆ ไป...แต่ถ้าอยากได้รูปปั้นที่สง่างามล่ะก็ รูปปั้นต้องมีขนาดใหญ่กว่านี้อีก นี่เป็นถึงรูปปั้นที่จะวางไว้ในศาลเจ้านี่นา!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140207
					],
					"speakerTitle": "Ooshima Junpei"
				}
			]
		},
