					"nextDialogs": [
						120060619
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060619,
					"content": "ขอบคุณนะ Paimon ที่ปลอบใจฉัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060620
