					"nextDialogs": [
						120060621
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060622,
					"content": "ไม่เห็นเป็นไรเลย",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060624
					]
				},
				{
					"id": 120060623,
					"content": "ก็ฉันเป็นเพื่อนของเธอไง",
