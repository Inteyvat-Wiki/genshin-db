					"content": "ทั้ง ๆ ที่เป็นสิ่งที่สามารถขายได้ราคาสูง แต่กลับยอมที่จะแบ่งปันโดยที่ไม่เห็นแก่ตัว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060222
					],
					"speakerTitle": "Kamisato Ayaka"
				},
