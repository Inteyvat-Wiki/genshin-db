				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ivanovich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411310101,
					"content": "อื้ม...ไม่เลวเลย งานนี้ฉันมั่นใจว่าจะสร้างเงินก้อนโตได้ แต่ยังมีปัญหาอยู่เรื่องนึง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310102
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310102,
					"content": "ปัญหาอะไรเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310103
					]
				},
				{
					"id": 411310103,
					"content": "หืม? โอ้...นักเดินทาง เธอนั่นเอง เธอมาได้จังหวะพอดีเลย! เธอสนใจจะร่วมเอ่อ...การ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310107
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310107,
					"content": "ธุรกิจที่...มหัศจรรย์ ...ยิ่งใหญ่ ...และไม่เคยมีมาก่อน จะทำเงินก้อนโตได้จริงเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310108
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310108,
					"content": "ขอแค่เธอช่วยฉันนิดหน่อย ๆ เราสองคนก็จะทำเงินก้อนโตได้แน่นอน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310104,
						411310109
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310104,
					"content": "ธนาคาร Northland Bank มีการรักษาความปลอดภัยอย่างเข้มงวด",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310105
					]
				},
				{
					"id": 411310105,
					"content": "อ่า นั่นมันแน่นอนอยู่แล้ว แม้แต่ยามรักษาการณ์ยังเป็นชาว Snezhnaya ฉัน...ไม่! ไม่นะ คุณคิดอะไรอยู่?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310106
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310106,
					"content": "ดูเหมือนการเดินทางไปทั่วโลก จะทำให้คุณเปิดโลกทัศน์ได้มากเลย ความคิดของคุณช่างเต็มไปด้วยจินตนาการ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310112
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310112,
					"content": "แต่แผนธุรกิจของฉันในครั้งนี้ เป็นแผนที่เป็นจริงได้แน่นอน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310113
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310113,
					"content": "เธอรู้เรื่องอุกกาบาตที่ตกลงมาจากฟ้าในช่วงนี้มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310114
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310114,
					"content": "ฉันอยากไปตามหาอุกกาบาตที่ตกลงมา แล้วเอากลับมาสักก้อนสองก้อน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310115
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310115,
					"content": "จากนั้นค่อยหาช่างฝีมือดีสักคน มาแกะสลักและขัดเกลาให้เป็นเครื่องประดับ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310116
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310116,
					"content": "เครื่องประดับที่ทำมาจากอุกกาบาต... ไม่ว่าจะเป็นแหวน, สร้อยคอ, กำไลหรือตุ้มหู ต้องทำให้พวกคนมีตังค์ ยินดีควักเงินซื้อแน่นอน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310117
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310117,
					"content": "นักเดินทาง เรื่องที่เธอต้องทำนั้นง่ายมาก เพียงแค่ช่วยคุ้มครองฉัน ให้แน่ใจว่าจะไม่มีมอนสเตอร์มารบกวน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310118
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310118,
					"content": "เป็นยังไง เราสองคนตกลงตามนี้โอเคมั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310119
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310119,
					"content": "อย่าเข้าใกล้อุกกาบาตเด็ดขาด",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310120
					]
				},
				{
					"id": 411310120,
					"content": "ว่าไงนะ? จะปล่อยให้โอกาสดีในการทำธุรกิจหลุดมือได้ยังไงกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310109,
					"content": "เธอพบช่องโหว่ในประมวลกฎหมายงั้นเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310110
					]
				},
				{
					"id": 411310110,
					"content": "เอ่อ บอกตามตรง ประมวลกฎหมายของ Liyue นั้นเขียนไว้อย่างละเอียดและรัดกุมมาก ๆ แทบจะไม่มีช่องโหว่เลย แต่...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310111
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310111,
					"content": "เฮ้ ไม่! ไม่นะ สิ่งที่ฉันทำน่ะถูกต้องตามกฎหมายแน่นอน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310106
					],
					"speakerTitle": "Ivanovich"
				}
			]
		},
