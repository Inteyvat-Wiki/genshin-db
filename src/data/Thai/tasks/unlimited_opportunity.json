			"dialogs": [
				{
					"id": 411310301,
					"content": "คนอื่นก็น่าจะอยากทำธุรกิจแบบนี้...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310302
					]
				},
				{
					"id": 411310302,
					"content": "อ่ะ แน่นอน พวกเราถึงต้องรีบไปที่นั่นไงล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310303
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310303,
					"content": "นักเดินทาง ถ้าเธอตกลงล่ะก็ เรารีบออกเดินทางกันเถอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310304
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310304,
					"content": "ทุกวินาทีที่เราเอาแต่คุยเรื่องไร้สาระกันอยู่ที่นี่ เราอาจจะเสียโอกาสทำเงินไปหนึ่ง Mora ก็ได้นะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310305
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310305,
					"content": "...อื้อหือ...อย่างงี้คงไม่มีทางเกลี้ยกล่อมเขาได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310306
					],
					"speakerTitle": "Paimon"
				},
