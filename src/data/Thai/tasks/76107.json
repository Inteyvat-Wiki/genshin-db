				"points": []
			},
			"dialogs": [
				{
					"id": 761071201,
					"content": "ฉันคือนักวิจัยระดับพิเศษ... ของท่าน Marionette",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071202
					]
				},
				{
					"id": 761071202,
					"content": "นักวิจัยระดับพิเศษงั้นเหรอ? ท่านผู้นั้นเชี่ยวชาญในการวิจัยกลไกและแรงจันทราผันในระดับสูง ฉันนึกภาพไม่ออกเลยจริง ๆ ว่าท่านผู้นั้นจะต้องการนักวิจัยอัตราจ้างพิเศษด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risto"
				}
			]
		},
		{
			"id": 7610713,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Risto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071301,
					"content": "งานวิจัยทางวิทยาศาสตร์ต้องอาศัยความร่วมมือเป็นพื้นฐานน่ะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071302
					]
				},
				{
					"id": 761071302,
					"content": "จริงด้วย ฉันเองก็เคยรวบรวมรายงานวิจัยจากศูนย์วิทยาศาสตร์ Fontaine ให้ท่านผู้นั้นมาไม่น้อยเหมือนกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071303
					],
					"speakerTitle": "Risto"
				},
				{
					"id": 761071303,
					"content": "ในเมื่อคุณเป็นผู้เชี่ยวชาญในด้านนี้ ถ้าอย่างนั้น ปัญหาขัดข้องที่เกิดขึ้นกับยานตรวจการณ์ลำนี้ คงจะเป็นของกล้วย ๆ สำหรับคุณใช่มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risto"
				}
			]
		},
		{
			"id": 7610714,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
