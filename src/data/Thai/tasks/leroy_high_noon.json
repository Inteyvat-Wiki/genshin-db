					"nextDialogs": [
						741530825
					]
				},
				{
					"id": 741530825,
					"content": "จริงเหรอ? ถ้าแม้แต่เธอก็คิดแบบนี้ แสดงว่าฉันไม่โง่จริง ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530826
					],
					"speakerTitle": "Paimon"
				},
				{
