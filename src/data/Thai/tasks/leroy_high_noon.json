					"nextDialogs": [
						741530829
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741530829,
					"content": "ก็คงต้องตามนั้นล่ะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530830
					]
				},
				{
					"id": 741530830,
					"content": "โอเค งั้นไว้เราค่อยกลับมาใหม่แล้วกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741530824,
					"content": "Paimon ไม่ได้โง่นะ",
