					"nextDialogs": [],
					"speakerTitle": "Anna"
				},
				{
					"id": 200670109,
					"content": "(หรือว่าครั้งก่อนจะตอบผิดไป...)",
					"roleType": "TALK_ROLE_PLAYER",
