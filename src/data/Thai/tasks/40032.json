				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400320301,
					"content": "ลำบากพวกเธอแล้วล่ะนะ ฉันว่า...น่าจะยังไม่ครบ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320302
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320302,
					"content": "สิ่งมีชีวิตตัวน้อยหายไปเยอะขนาดนั้นเลยเหรอเนี่ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400320303,
					"content": "ใช่แล้ว ดูจากคำขอที่ได้รับมา เราน่าจะเจอสิ่งมีชีวิตตัวน้อยที่หายไปประมาณครึ่งนึงแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320304
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320304,
					"content": "น่าเสียดายที่ตอนนี้ไม่มีเบาะแสเพิ่มเติม แต่ไม่เป็นไร สัตว์ที่มีชีวิตนั้นตรวจสอบได้ง่ายกว่าสิ่งที่ไม่มีชีวิตอยู่แล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320305
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320305,
					"content": "ก่อนหน้านี้ตอนที่ช่วยตระกูลใหญ่ตามหาสิ่งของที่ถูกขโมยไป",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320306
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320306,
					"content": "ก็มีช่วงที่ขาดเบาะแสไปหลายต่อหลายครั้ง ต้องขอบคุณการคาดการณ์ของท่านประธาน Sango สุดท้ายถึงได้หาจนเจอ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320307,
						400320325
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320307,
					"content": "พอจะบอกรายละเอียดได้มั้ย?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320308
					]
				},
				{
					"id": 400320308,
					"content": "ดูท่าทางน่าสนใจแฮะ รีบเล่ามาเร็วเข้า!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400320309,
					"content": "คิดไม่ถึงเลยว่าพวกเธอจะสนใจการสืบคดีด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320310
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320310,
					"content": "จริง ๆ ในตอนนั้น เราจับผู้ต้องสงสัยได้แล้ว เพียงแต่เราดันหาหลักฐานในบ้านของเขาไม่เจอ และก็ไม่มีเบาะแสอื่นด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320311
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320311,
					"content": "ต่อมาตอนที่ฉันกำลังสอบถามข้อมูลอยู่ ก็บังเอิญได้ยินว่า เมื่อวันก่อนผู้ต้องสงสัยได้ขาย Naku Weed ไป ฉันเลยไปหาคนซื้อเพื่อขอดู Naku Weed นั้น และพบว่ามันยังสดมาก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320312
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320312,
					"content": "พอท่านประธาน Sango ได้ยินดังนั้น ก็รีบให้ฉันไปตรวจสอบที่เชิงเขา Mt. Yougou",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320313
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320313,
					"content": "เอ๋? ทำไมต้องเป็น Mt. Yougou ล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400320314,
					"content": "\"อย่างแรกเพราะผู้ต้องสงสัยของเราอาศัยอยู่บนเกาะ Narukami ถึงแม้ Naku Weed จะสามารถหาได้ตามที่หลาย ๆ แห่งทั่ว Inazuma แต่ถ้าจะไปยังเกาะอื่น คนทั่ว ๆ ไปก็ต้องใช้เรืออยู่ดี ซึ่งเราก็ไม่เจอเรือแต่อย่างใด\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320315
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320315,
					"content": "\"อีกอย่างสำนัก Tenryou ก็เคร่งกับกฎ Sakoku มาก ถ้าเขาคิดจะก่อเรื่อง ก็คงจะไม่ทำอะไรที่ไปกระตุกหนวดเสือของสำนัก Tenryou หรอก\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320316
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320316,
					"content": "\"ดังนั้นสามารถตัดเรื่องเกาะอื่นออกไปได้เลย\" ท่านประธาน Sango พูดแบบนี้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320317
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320317,
					"content": "แต่แถว ๆ ศาลเจ้า Grand Narukami ก็มี Naku Weed นี่นา? ทำไมต้องเป็นเชิงเขา Mt. Yougou ด้วยล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400320318,
					"content": "ท่านประธาน Sango ก็คิดถึงจุดนี้เหมือนกัน \"ถึงแม้แถว ๆ ศาลเจ้า Grand Narukami จะมี Naku Weed แต่ที่ศาลเจ้า Grand Narukami นั้นมีมิโกะประจำอยู่ แถมยังมีผู้คนที่มาสักการะด้วย\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320319
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320319,
					"content": "\"ถ้ามีอะไรที่ผิดปกติ ผู้คนที่ผ่านไปมาก็จะสังเกตเห็นได้ง่าย ๆ\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320320
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320320,
					"content": "อย่างนี้นี่เอง! ตอนนี้ฉันเชื่อแล้วว่าท่านประธานคือฝ่ายมันสมอง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400320321,
					"content": "ต่อมาเราเจอกองดินบริเวณเชิงเขา Mt. Yougou ซึ่งมีร่องรอยที่เกิดขึ้นเมื่อไม่นานมานี้ ผู้ต้องสงสัยได้ฝังของที่ขโมยมา เพื่อรอให้เรื่องเงียบก่อน แล้วค่อยมาขุดเอาของออกไปขาย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320322
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320322,
					"content": "เขาคิดว่าการที่ออกไปพร้อมกับของเต็มหลัง แต่ดันกลับมามือเปล่านั้นจะดูน่าสงสัย ก็เลยเก็บ Naku Weed ตามริมทางกลับมาขายด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320323
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320323,
					"content": "แต่สุดท้าย Naku Weed นั่นแหละที่เปิดโปงเขา!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400320324,
					"content": "ใช่แล้วล่ะ เพราะงั้นจะต้องมีเบาะแสอยู่ในที่ที่เราไม่ทันได้สังเกตอีกแน่ ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320327
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320327,
					"content": "ฉันว่าเราร่วมมือกันแบบนี้ก็ไม่เลวเลยนะ สิ่งที่ฉันถนัดคือการวิ่งเต้น ไม่ใช่การแฝงตัวหรือการต่อสู้ ในส่วนนี้ยกให้เธอน่าจะเหมาะกว่า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320328
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320328,
					"content": "ยังไงน่ะเหรอ? สนใจจะมาทำงานที่ \"Bantan Sango\" มั้ยล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320329
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320329,
					"content": "ถึงแม้ท่านประธาน...Sango จะดูคุยด้วยยากอยู่สักหน่อย และมักจะพูดแต่เรื่องราวทำนอง \"มโนธรรมเหนี่ยวรั้งสติปัญญา\" แต่เนื้อแท้ของเธอนั้นเป็นคนที่อ่อนโยนมาก ๆ เลยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320330,
						400320331
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320330,
					"content": "ไม่ดีกว่า",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320332
					]
				},
				{
					"id": 400320332,
					"content": "น่าเสียดายจริง ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320333
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320333,
					"content": "แต่พูดก็พูดเถอะนะ ถ้าท่านประธาน Sango มีคนเก่ง ๆ อย่างเธออยู่ข้าง ๆ ล่ะก็ เห็นทีฉันคงต้องตกงาน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320334
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320334,
					"content": "เดี๋ยวฉันจะตรวจสอบต่อเอง ถ้าพวกเธอมีธุระอย่างอื่นก็ไปทำได้เลยนะ วางใจได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320335
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320335,
					"content": "ไว้อีกสักพัก เราค่อยมาเจอกันที่สำนักงานนักสืบก็แล้วกัน แต่ไม่ว่ายังไงก็ต้องขอบคุณพวกเธอด้วยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320331,
					"content": "ขอบคุณนะ แต่ไม่ดีกว่า",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320332
					]
				},
				{
					"id": 400320325,
					"content": "หวังว่าคราวนี้ก็จะราบรื่นนะ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320326
					]
				},
				{
					"id": 400320326,
					"content": "อืม พวกชาวบ้านที่สิ่งมีชีวิตตัวน้อยหายไปต่างก็ร้อนใจกันมากเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320327
					],
					"speakerTitle": "Paimon"
				}
			]
		},
