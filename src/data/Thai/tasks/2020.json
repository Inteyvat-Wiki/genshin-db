					"Raiden Shogun"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20200301,
					"content": "ขอฉันคิดดูสักหน่อยว่าเพราะอะไร เธอถึงปรากฏตัวขึ้นตรงหน้าฉันอีกครั้ง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200302
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200302,
					"content": "ความกล้าหาญที่โง่เขลาของเธอที่จะปกป้องคนพวกนั้น หรือจะบอกว่า... ตั้งใจที่จะมาหาฉันกัน?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200303,
						20200304
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200303,
					"content": "Fatui จะชักจูงโชกุน Raiden",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200305
					]
				},
				{
					"id": 20200305,
					"content": "อ๋า? ปลุกฉันจากการทำสมาธิชั่วนิรันดร์ คงไม่ใช่เพื่อพูดเรื่องพวกนี้หรอกใช่มั้ย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200306
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200306,
					"content": "ถ้าอย่างนั้นเธอก็คงจะดูถูกฉันเกินไปหน่อย ฉันต้องรู้เรื่องคำสั่งล่าวิชั่นอยู่แล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200307
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200307,
					"content": "เธอรับรู้เรื่องราวภายนอกหมดเลยงั้นเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200308
					]
				},
				{
					"id": 20200308,
					"content": "ก็ไม่ใช่แบบนั้นหรอก ฉันรู้ก็แค่เรื่องที่เกี่ยวข้องกับความเป็นนิรันดร์เท่านั้น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200309
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200309,
					"content": "รวมถึงเรื่องประกาศคำสั่งล่าวิชั่นด้วย ฉันเองก็เห็นด้วยตามนั้น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200310
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200310,
					"content": "แต่ว่าการกระทำของพวก Fatui พวกนั้น ยังไม่ได้ก่อให้เกิดความเสียหายกับความเป็นนิรันดร์ ไม่อย่างนั้น... พวกเขาคงโดนกำจัดเกลี้ยงไปแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200311,
						20200312
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200311,
					"content": "แต่ว่าคำสั่งล่าวิชั่น",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200313
					]
				},
				{
					"id": 20200313,
					"content": "ความปรารถนานั่นเป็นสิ่งที่ไม่เป็นประโยชน์ต่อความเป็นนิรันดร์",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200314
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200314,
					"content": "บางทีพวกเธออาจจะยังไม่ได้ตระหนักถึง ว่าการไล่ตามความปรารถนานั้น... ทำให้ผู้คนสูญเสียสิ่งต่าง ๆ มากมายยิ่งกว่า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200315
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200315,
					"content": "เช่นเดียวกับการยึดวิชั่นเอง ก็ไม่มีใครตายเพราะวิชั่นออกจากร่าง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200316
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200316,
					"content": "คนที่เสียชีวิตกลับเป็นพวกคนที่ยืนกรานที่จะไล่ตามความปรารถนา ไม่ใช่เหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200317
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200317,
					"content": "Teppei...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200318
					]
				},
				{
					"id": 20200318,
					"content": "นักเดินทาง เธอคือสิ่งพิเศษในสายตาของฉัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200319
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200319,
					"content": "ดูเหมือนจะมีความไม่แน่นอนมากมายในร่างกายของเธอ หรือจะพูดอีกแบบนึงก็คือ เธออยู่ห่างจาก \"ความเป็นนิรันดร์\" ที่สุดเลยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200320
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200320,
					"content": "ฉันจะไม่ยืนกรานให้เธอเข้าใจความหมายของการกระทำของฉัน ฉันแค่ใช้เส้นทางของ \"ความเป็นนิรันดร์\" ในนามของผู้คนบนโลกใบนี้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200321
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200321,
					"content": "ที่นี่คือ \"ดินแดนแห่งใจที่บริสุทธิ์\" ของเธอ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200322
					]
				},
				{
					"id": 20200322,
					"content": "นี่เป็นพื้นที่ที่สร้างขึ้นจากจิตสำนึกของเธอสินะ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200323
					]
				},
				{
					"id": 20200323,
					"content": "ถูกต้องแล้วล่ะ ไม่คิดเลยว่าเธอจะรู้เรื่องนี้ด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200324
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200324,
					"content": "ช่างเถอะ เป็นเธอที่คอยหาโอกาส... สั่นคลอนจิตสำนึกของฉันสินะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200325
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200325,
					"content": "ฉันไม่อยากเถียงกับเธอแล้วล่ะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200326
					]
				},
				{
					"id": 20200326,
					"content": "ฉันจะมาเพื่อ \"หักล้าง\" ข้อโต้แย้งของเธอน่ะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200327
					]
				},
				{
					"id": 20200327,
					"content": "......",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200328
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200328,
					"content": "เอาเถอะ ถ้าอย่างนั้น \"ผู้ที่อยู่ห่างไกลจากความเป็นนิรันดร์\"... แสดงให้ฉันเห็นสิ... ว่าเธอรู้แจ้งแค่ไหน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200312,
					"content": "ทำให้ชาว Inazuma สูญเสียไปตั้งมากมาย",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200313
					]
				},
				{
					"id": 20200304,
					"content": "ไม่ควรมีการประกาศคำสั่งล่าวิชั่น",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200305
					]
				}
			]
		},
