				"points": []
			},
			"dialogs": [
				{
					"id": 413350101,
					"content": "ไม่ใช่ แบบนี้ก็ไม่ถูก...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350102
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350102,
					"content": "ทำไมเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413350103
					]
				},
				{
					"id": 413350103,
					"content": "อ๊ะ สวัสดี ฉันกำลังหาแรงบันดาลใจอยู่แถวนี้อยู่เนี่ย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350104
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350104,
					"content": "ตอนนี้มันคือช่วงเทศกาลใช่มั้ยล่ะ? ฉันกำลังคิดว่า ทำยังไงถึงจะอธิบายเกี่ยวกับเทศกาล Lantern Rite และท่าเรือ Liyue ผ่านทางภาพวาดได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350105
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350105,
					"content": "เฮ้อ... ไม่รู้ว่าชั้นใช้เทคนิคการวาดไม่ถูกต้อง หรือว่าเพราะสาเหตุอะไร... ทำไมภาพวาดมันยังให้ความรู้สึกที่ไม่โดนใจนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350106
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350106,
					"content": "ฉันกำลังคิดว่า บางทีถ้าเปลี่ยนที่วาดอาจทำให้มีแรงบันดาลใจบ้าง แต่ฉันก็ยังหาที่ที่วิวสวยกว่านี้ไม่เจอ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350107
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350107,
					"content": "#นักเดินทาง {F#เธอ}{M#นาย}พอจะรู้จักจุดที่เหมาะกับการวาดภาพมั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350108
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350108,
					"content": "เดี๋ยวเราไปลองหาดูแถวนี้ละกัน",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413350109
					]
				},
				{
					"id": 413350109,
					"content": "อืม... ก็ได้ งั้นเราไปดูรอบ ๆ ด้วยกันเถอะ บางทีอาจจะเจอที่สวย ๆ ที่เหมาะกับการวาดภาพก็ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				}
			]
		},
		{
			"id": 4133503,
			"completionStepIds": [
				4133503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
