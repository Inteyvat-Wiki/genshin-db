			},
			"dialogs": [
				{
					"id": 110420601,
					"content": "ฉันชิมดูแล้ว เป็นอย่างที่ฉันคาดไว้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420602
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420602,
					"content": "จำไว้ว่าทำใจให้สบายในตอนดื่ม ถ้ารู้สึกไม่สบายให้สูดหายใจเข้าลึก ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420603
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420603,
					"content": "ฉันจะจดบันทึกข้อมูลและผลจากการเฝ้าดูอาการไว้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				}
			]
		},
		{
			"id": 1104207,
			"completionStepIds": [
				1104207
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104207",
							"2"
						],
						"stepId": 1104207,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110420701,
					"content": "#เป็นไงบ้าง? {NICKNAME} สีหน้าเธอดูเหมือนไม่ค่อยสบายเท่าไหร่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420702,
						110420703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420702,
					"content": "เหมือนกำลัง... โดนเผา",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420704
					]
				},
				{
					"id": 110420704,
					"content": "ไหนคุณบอกว่าลองดื่มแล้วไง! บอกว่ามันดื่มได้ไม่ใช่หรอ? แล้วทำไมถึงได้เป็นอย่างงี้ล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420705,
					"content": "หืม? นี่เป็นผลลัพธ์ที่ฉันคาดการณ์ไว้แล้วน่ะ และเป็นผลลัพธ์ที่ดีด้วยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420706
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420706,
					"content": "น้ำยาโพชั่นชนิดนี้จะดึงพลังงานธาตุเข้าสู่ร่างกาย และในกรณีปกติจะทำให้เกิดปฏิกิริยาต่อต้าน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420707
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420707,
					"content": "ถ้าการไหลเวียนของธาตุในร่างกายไม่ถูกปิดกั้น ก็จะรู้สึกไม่สบายตัวแค่ชั่วคราว รอให้การไหลเวียนสิ้นสุดลงก็เสร็จแล้ว มันไม่มีผลข้างเคียงอะไร",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420708
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420708,
					"content": "หมายความว่า คุณรู้อยู่แล้วว่าดื่มแล้วจะรู้สึกไม่สบาย แต่คุณก็ยังดื่มมันงั้นเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420709,
					"content": "ฮึฮึ ฉันเป็นคนผสมมันขึ้นมานี่นา แน่นอนว่าฉันต้องใช้ตัวเองเป็นหนูทดลองก่อน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420710,
						110420712
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420710,
					"content": "นี่คือ... การคำนึงถึงผู้ที่ถูกทดสอบ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420711
					]
				},
				{
					"id": 110420711,
					"content": "แน่นอนสิ เธอเป็นผู้ช่วยของฉัน ฉันจะปล่อยให้เธอรับความเสี่ยงได้ยังไงล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420714
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420714,
					"content": "สรุปแล้ว เรามาดูผลการทดสอบกันดีกว่า ในแง่ของการทดสอบพลังงานธาตุ เธอไม่แตกต่างกับคนอื่นบนโลกในนี้ ทุกอย่างปกติดี",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420715
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420715,
					"content": "นึกว่าจะมีอะไรที่น่าตื่นเต้นซะอีก...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420716,
					"content": "ฉันคิดว่าสิ่งธรรมดามันดีกว่าสิ่งพิเศษนะ ความ \"พิเศษ\"... บางครั้งมันก็ไม่ใช่เรื่องดี",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420717
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420717,
					"content": "รู้สึกว่าเจาะจงแบบแปลก ๆ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420718
					]
				},
				{
					"id": 110420718,
					"content": "ข้อดีของความธรรมดาคือ สามารถใช้วัตถุอะไรมาอ้างอิงก็ได้ และทุกคนเข้าใจเธอ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420719
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420719,
					"content": "เพราะว่าเป็นคนเหมือนกัน จึงสามารถเข้าใจ รับรู้ความรู้สึก ให้กำลังใจ สนับสนุนซึ่งกันและกันได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420720
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420720,
					"content": "ถ้าไม่สบาย หมอก็จะสามารถวินิจฉัยอาการได้อย่างง่ายดาย ถ้าพบปัญหา ก็จะสามารถขอคำแนะนำจากคนอื่น ๆ ที่เคยเจอปัญหาเดียวกันได้ เพราะเป็นคนเหมือนกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420721
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420721,
					"content": "แต่คนที่ \"พิเศษ\"... จะไม่สามารถสัมผัสได้ถึงสิ่งเหล่านี้ เพราะพื้นฐานในชีวิตของพวกเขานั้นต่างออกไป",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420722
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420722,
					"content": "ยกตัวอย่างเช่น... มนุษย์ไม่สามารถเข้าใจ Pyro Regisvine หรือ Eye of the Storm ได้ ฉันพูดอย่างงี้ เธอพอเข้าใจมั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420723,
						110420724
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420723,
					"content": "ก็พอเข้าใจอยู่",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420725
					]
				},
				{
					"id": 110420725,
					"content": "สรุปคือ นี่เป็นผลลัพธ์ที่ดี อย่างน้อยในอนาคต เธอก็สามารถใช้พลังของเธอได้อย่างวางใจ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420726
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420726,
					"content": "Timaeus ผลการทดลองครั้งล่าสุดออกมาแล้ว เธอช่วยจัดการมันด้วยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420727
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420727,
					"content": "ได้เลยครับ! ผมจะจัดการเอง!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420728
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420728,
					"content": "ที่อาจารย์ว่ามาเมื่อกี้ ทำให้ฉันรู้ว่าความคิดของฉันถูกจำกัด แต่ตอนนี้มันชัดเจนมากขึ้นแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420729
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420729,
					"content": "จะบอกว่าเธอเป็น \"สัตว์\" ก็ดูไม่ค่อยเหมาะสม แต่ถ้าเปลี่ยนมุมมองว่าเธอเป็น \"สิ่งมีชีวิตธาตุ\" ละก็...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420730
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420730,
					"content": "ไม่เลวเลยทีเดียว นี่เป็นมุมมองที่น่าสนใจ แต่ความจริงจะเป็นยังไง ให้เธอลองศึกษาเอง น่าจะดีกว่าให้ฉันตัดสินล่ะนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420731
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420731,
					"content": "อืม วางใจได้เลย ผมจะหาคำตอบที่ทำให้ทุกคนพอใจได้อย่างแน่นอน!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420732
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420732,
					"content": "นอกจากเขาจะไม่ผิดหวังแล้ว ยังดูฮึกเหิมกว่าเดิมอีก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420733
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420733,
					"content": "ควรพูดว่าเขาจริงจังมากหรือว่า Albedo เข้าใจพูดดีนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420734,
					"content": "ถ้างั้น ก่อนที่เราจะวิจัยกันต่อไป ฉันต้องเตรียมของบางอย่าง รอเดี๋ยวนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420735
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420735,
					"content": "ถ้าเธอสนใจล่ะก็ จะลองเดินดูรอบ ๆ ก็ได้นะ ถือซะว่าฆ่าเวลา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420724,
					"content": "ก็ยังฟังดู... เจาะจงแบบแปลก ๆ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420725
					]
				},
				{
					"id": 110420712,
					"content": "แล้วเธอไม่กลัวว่าตัวเองจะมีอันตราย?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420713
					]
				},
				{
					"id": 110420713,
					"content": "นี่อาจเป็นความมั่นใจของนักวิชาการก็ได้ มันช่วยลดความยุ่งยากไปได้เยอะเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420714
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420703,
					"content": "เธอดื่มลงได้ยังไง",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420704
					]
				}
			]
		},
