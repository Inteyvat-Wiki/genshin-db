					"nextDialogs": [
						3081407,
						3081408
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081407,
					"content": "ทำไมมันถึงทำอย่างนั้นล่ะ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3081409
					]
				},
				{
					"id": 3081409,
					"content": "ฉันคิดว่า...น่าจะเป็นเพราะ \"ความเกลียดชัง\" นะ",
