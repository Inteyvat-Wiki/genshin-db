						3081107
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081107,
					"content": "งั้นตกลงมันเหลือเรื่องอะไรบ้างล่ะเนี่ย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3081111,
