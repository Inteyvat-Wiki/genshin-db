					"nextDialogs": [
						3081106
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081106,
					"content": "โดยทั่วไปแล้ว ก็เรื่องที่นอกเหนือจากแรงกายและแรงสมองล่ะนะ",
					"roleType": "TALK_ROLE_NPC",
