			"dialogs": [
				{
					"id": 10080601,
					"content": "ขอบคุณท่านตัวแทนเซียน ที่ช่วยเหลือพี่น้องฉัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080602
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080602,
					"content": "พวกคุณเคยเจอเซียนไหม?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080603
					]
				},
				{
					"id": 10080603,
					"content": "อืม? พวกเรา...พวกเราแค่เคยได้ยินน่ะ ว่าภูเขา Mt. Hulao นี้เป็นตำหนักเซียน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080604
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080604,
					"content": "แต่คนธรรมดาอย่างพวกฉัน แน่นอนว่าไม่เคยเจอเซียน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080605
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080605,
					"content": "แต่ท่านนั้นคือตัวแทนจากเซียน ซึ่งแตกต่างจากพวกเรา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080606
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080606,
					"content": "เออ จริงด้วย จะรบกวนตำหนักเซียนอีกไม่ได้แล้ว พวกเราขอลงเขาก่อนนะ ขอบคุณท่านตัวแทนเซียนอีกครั้ง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080607
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080607,
					"content": "ขอบคุณท่านตัวแทนเซียน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080608
					],
					"speakerTitle": "Li Dang"
				},
				{
					"id": 10080608,
					"content": "...ถ้าพวกเราเป็นตัวแทนเซียนก็ดีสินะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10080609,
					"content": "รู้สึกว่าเซียนท่านนี้อารมณ์ไม่ค่อยจะดีเท่าไหร่เลยนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10080610,
					"content": "แต่เราก็ไม่ได้ทำเรื่องเลวร้ายอะไร คงจะไม่เป็นไรหรอก...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089601
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10089601,
					"content": "ล่วงเข้ามาในอาณาเขตข้า และยังแอบปล่อยตัวโจร",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089602
					],
					"speakerTitle": "จ้าวบงการภูผา"
				},
				{
					"id": 10089602,
					"content": "มนุษย์โง่เขลา ยังไม่รีบ ๆ มารับโทษ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "จ้าวบงการภูผา"
				}
			]
