			"dialogs": [
				{
					"id": 745290401,
					"content": "#อ๊ะ {NICKNAME} มาแล้วเหรอ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290402,
						745290403
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 745290402,
					"content": "Citlali ไม่ได้เจอกันนานเลยนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290404
					]
				},
				{
					"id": 745290404,
					"content": "พูดอะไรของเธอ บางทีฉันก็ออกมาเดินเล่นบ้างสิ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290405
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 745290405,
					"content": "แถมเมื่อคืนฉันก็ได้ทำนายดวงชะตา ผลบอกว่าถ้าออกมาข้างนอกวันนี้ จะได้เจอเรื่องดี ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290406
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 745290406,
					"content": "เห็นมั้ย พอออกจากบ้านปุ๊บ เรื่องดี ๆ ก็มาหาถึงที่เลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290407,
						745290408
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 745290407,
					"content": "ถ้างั้นก็ขอให้เป็นเรื่องดี ๆ สองเท่าเลย!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290409
					]
				},
				{
					"id": 745290409,
					"content": "มันก็ได้อยู่หรอก... แต่สองวันก่อนฉันเพิ่งโต้รุ่ง อ่านไลท์โนเวลเล่มใหม่จนจบน่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290410
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 745290410,
					"content": "ช่วยดูหน่อยสิ ตอนนี้ฉันดูเป็นยังไงบ้าง? รอยคล้ำใต้ตาน่าจะหายไปแล้วใช่มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290411,
						745290412
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 745290411,
					"content": "ดูสดใสเหมือนทุกทีนั่นแหละ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290413
					]
				},
				{
					"id": 745290413,
					"content": "จริงเหรอ? ห้ามหลอกฉันนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290414
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 745290414,
					"content": "ขอบอกไว้ก่อนนะ ถ้าถ่ายออกมาไม่สวย รูปนั้นต้องเป็นของฉัน... ถ้าจะเก็บไว้ ก็เก็บได้แค่รูปที่สวยที่สุดเท่านั้น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Citlali"
				},
				{
					"id": 745290412,
					"content": "ดูเปล่งปลั่งมากเลย!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290413
					]
				},
				{
					"id": 745290408,
					"content": "ขอถ่ายรูปคุณสักใบได้มั้ย!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290409
					]
				},
				{
					"id": 745290403,
					"content": "ไม่ได้นอนอยู่ในบ้านเหรอ แปลกจัง",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290404
					]
				}
			]
		}
	]
