			"dialogs": [
				{
					"id": 747050101,
					"content": "...ฉันคิดว่าเป็นตัวนี้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050102
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 747050102,
					"content": "ก็มีเหตุผล",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050103
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747050103,
					"content": "ทำไมล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050104
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 747050104,
					"content": "ดูสีที่หางนั่นสิ ในตู้ปลาไม่มีอะไรทันสมัยไปกว่ามันอีกแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050105
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 747050105,
					"content": "ถึงสีจะฉูดฉาดไปหน่อย แต่ก็ได้ ฉันจะถือซะว่าเธอกำลังชมฉันอยู่ละกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050106
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 747050106,
					"content": "ว้าว! คนเยอะจัง! ทุกคนมาเที่ยวพิพิธภัณฑ์สัตว์น้ำกันเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747050107,
					"content": "อืม พอดีเพิ่งถ่ายฉากนึงเสร็จ ก็เลยถือโอกาสมาเดินเที่ยวชมในช่วงพักน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050108
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747050108,
					"content": "เมื่อกี้พวกเธอคุยอะไรกันเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747050109,
					"content": "ปลาตัวไหนที่เหมือน Chiori มากกว่ากันน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050110
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 747050110,
					"content": "ทำไมพวกเธอถึง...?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747050111,
					"content": "อ๋า... ฮ่าฮ่า เหมือนว่าตอนที่คุยกันจะได้ยินคุณ Columbina พูดถึงเรื่องทำนองนี้ เรารู้สึกว่ามันน่าสนใจดี ก็เลยเผลอเล่นตามไปด้วยน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050112
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747050112,
					"content": "ที่แท้เรื่องแบบนี้มันติดต่อกันได้ด้วยสินะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747050113,
					"content": "โอ๊ะ! ตัวนั้นเหมือนเธอเลย Chevreuse",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050114
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 747050114,
					"content": "เหมือนยังไงก่อน?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050115
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 747050115,
					"content": "ก็พอว่างเมื่อไหร่ก็จะว่ายวนอยู่ในอ่างน้ำ แล้วก็ออกกำลังกายไง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050116
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 747050116,
					"content": "...นี่เธอเห็นฉันเป็นคนแบบนั้นเหรอเนี่ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chevreuse"
				}
			]
		}
	]
