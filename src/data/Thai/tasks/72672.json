				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726720201,
					"content": "แบบนี้น่าจะได้แล้วล่ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720202
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720202,
					"content": "เธอคือ Wakamurasaki หรือเปล่า?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720203
					]
				},
				{
					"id": 726720203,
					"content": "ใช่แล้วล่ะ เธอมาฉันมีเรื่องอะไรงั้นเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720204
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720204,
					"content": "เกี่ยวกับเรื่อง Ubiquity Net...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720205
					]
				},
				{
					"id": 726720205,
					"content": "เอ๊ะ? ฉันจำได้แล้วล่ะ เธอคงจะเป็นนักเดินทางคนนั้นสินะ? Sango เคยบอกฉันเกี่ยวกับเรื่องของเธอน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720206
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720206,
					"content": "คุณใช้งาน Ubiquity Net นั้นได้ชาญฉลาดมาก ฉันได้รับแรงบันดาลใจมากมายเลยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720207
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720207,
					"content": "ได้ยินว่าเธอกำลังปรับปรุงมัน?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720208
					]
				},
				{
					"id": 726720208,
					"content": "ใช่แล้วล่ะ แฮะแฮะ... พอดี Sango มอบเทคนิควิชาองเมียวใหม่ให้ฉันมาน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720209
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720209,
					"content": "ฉันใช้เทคนิคนั้นเพื่อดัดแปลงตาข่ายนี้อีกครั้ง และตอนนี้ชื่อของตาข่ายนี้คือ \"Omni-Ubiquity Net\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720210
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720210,
					"content": "ตามที่จาก Sango บอกมา เทคนิคนี้สามารถจดจำรูปลักษณ์ของสิ่งมีชีวิต แล้วใช้วัตถุบางอย่าง เป็นสื่อกลางในการสร้างร่างของสิ่งมีชีวิตนั้นขึ้นมาอีกครั้ง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720211
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720211,
					"content": "เธอยังบอกอีกว่า ถ้าพัฒนาเทคนิควิชาองเมียวจนถึงขีดสุด ก็จะสามารถจดจำรูปลักษณ์ของมนุษย์ได้ด้วยล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720212
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720212,
					"content": "ร่างของมนุษย์ที่ถูกดักจับจะสามารถตอบคำถามได้ และจะไม่มีทางพูดโกหก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720213
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720213,
					"content": "เทคนิคนี้ถือได้ว่าเป็นเครื่องมือที่แข็งแกร่งที่สุดสำหรับนักสืบอย่าง Sango",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720214
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720214,
					"content": "ฉันคิดว่า คงเป็นเพราะเหตุผลนี้แหละ เธอถึงได้ยอมให้เทคนิคนี้กับฉัน เพื่อให้ฉันใช้ในการปรับปรุงตาข่ายนี้น่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720215
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720215,
					"content": "อ๊ะ! เธออย่าเอาเรื่องนี้ไปบอกคนอื่นนะ! ที่ฉันบอกเธอ เพราะเห็นว่าเธอเป็นเพื่อนของ Sango น่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720216,
						726720217
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720216,
					"content": "แข็งแกร่งขนาดนั้นเลยเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720218
					]
				},
				{
					"id": 726720218,
					"content": "อ่อ... ตอนนี้ยังน่ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720219
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720219,
					"content": "ไม่ว่าจะใช้วิธีไหนในการปรับปรุง ตาข่ายนี้ก็สามารถดักจับได้แค่สิ่งมีชีวิตเล็ก ๆ เท่านั้นแหละ ยังใช้ไม่ได้ผลกับคนเลยน่ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720220
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720220,
					"content": "นักเดินทาง เธอเองก็ลองใช้ตาข่ายนี้ดูสิ ไม่แน่นะ... วิธีที่เธอใช้ตาข่ายนี่ อาจจะจุดประกายให้ฉันอีกก็ได้นะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720221
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720221,
					"content": "อ่อ ตาข่ายนี่ให้เธอนะ ชื่อของตาข่ายนี้ก็คือ \"Omni-Ubiquity Net\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720222
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720222,
					"content": "ลองใช้ตาข่ายนี้จับสิ่งมีชีวิตตัวน้อยดูสิ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720217,
					"content": "ปรับปรุงเสร็จแล้วเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720218
					]
				}
			]
		},
