			"dialogs": [
				{
					"id": 760300101,
					"content": "วันนี้บรรยากาศดูแปลกไปนะ เธอกำลังตกแต่งทุ่งดอกไม้อยู่เหรอ Columbina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300102,
					"content": "ไม่ใช่ฉัน แต่เป็นพวกมัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300103
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760300103,
					"content": "พวกมัน... ภูตจันทราเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300104,
					"content": "เมื่อหินชนิดนี้ดูดซับแรงจันทราผัน จะเปล่งแสงอ่อน ๆ ออกมา พวกภูตจันทราชอบมันมากเลยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300105
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760300105,
					"content": "พวกมันก็เลย... วางก้อนหินลงบนพื้นแล้วเล่นกับมันเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300106,
					"content": "มานี่สิ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300107
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760300107,
					"content": "หืม?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300108,
					"content": "ว้าว! พอมองจากที่สูง ๆ แล้วเหมือนภาพวาดเลย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300109,
					"content": "แต่ดูเหมือนจะขาดไปก้อนนึงนะ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760300110
					]
				},
				{
					"id": 760300110,
					"content": "มีไม่พอเหรอเนี่ย ฉันจะไปเก็บมาเพิ่ม",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300111
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760300111,
					"content": "เอ๋? จะออกไปเก็บเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300112,
					"content": "ฉันรู้จักที่ที่ไม่เลวแห่งหนึ่ง ที่นั่นมีแสงจันทร์สาดส่อง และมีหินแบบนี้อยู่เต็มไปหมด",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300113
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760300113,
					"content": "ให้พวกเราไปเป็นเพื่อนมั้ย?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760300114
					]
				},
				{
					"id": 760300114,
					"content": "ได้สิ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300115
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760300115,
					"content": "อืม งั้นเก็บเพิ่มอีกหน่อยละกัน พวกเราก็อยากเห็นภาพที่สมบูรณ์เหมือนกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
