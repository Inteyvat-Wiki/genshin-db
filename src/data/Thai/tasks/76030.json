				},
				{
					"id": 760300302,
					"content": "เรากลับกันเถอะ จะปล่อยให้ภาพนั้นไม่สมบูรณ์ไม่ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300303,
