			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kayabuki Ikkei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726600201,
					"content": "ถึงแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600202
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600202,
					"content": "แค่ก้าวผ่านประตูที่น่าสงสัยบานนี้ ก็สามารถเข้าสู่สถานที่จัดการประลองร้อยใจรวมเป็นหนึ่งได้แล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600203,
						726600204
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600203,
					"content": "น่าตื่นเต้นจัง",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600205
					]
				},
				{
					"id": 726600205,
					"content": "ถึงแม้ \"ชาวลัทธิเท็งงุ\" จะถูกสั่งห้ามมานานแล้ว เพราะทำลายความสงบเรียบร้อยและศีลธรรมอันดีงาม แต่ก็ยังมีคนที่แอบจัดการประลองร้อยใจรวมเป็นหนึ่งอยู่ดี",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600206
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600206,
					"content": "ทั้งมอนสเตอร์ นักผจญภัย และนักรบที่โหยหาการต่อสู้จากทั่วทุกมุมโลก ต่างถูกดึงดูดให้มาเข้าร่วมการต่อสู้อันแสนดุเดือดบนเวทีการประลองแห่งนี้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600207
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600207,
					"content": "เธอสามารถเข้าร่วมการประลองกับคู่หูนักรบที่รักการต่อสู้เหมือนกันได้ เพราะคำว่า \"ร้อยใจ\" น่ะ หมายถึงว่าคนยิ่งเยอะยิ่งดีไงล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600208
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600208,
					"content": "ดูท่าทางเธอคงเป็นนักผจญภัยที่ไปมาทั่วทั้งร้อยเอ็ดเจ็ดย่านน้ำ เพราะงั้นเธอน่าจะมีเพื่อนที่ยินดีจะเข้าร่วมด้วยแน่นอน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600209
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600209,
					"content": "ว่าแต่เธอไม่เข้าร่วมเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600210
					]
				},
				{
					"id": 726600210,
					"content": "ฉันเหรอ? ฉันจะเข้าร่วมในฐานะผู้ชม เพื่อช่วยเชียร์เธอไงล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600211
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600211,
					"content": "จริง ๆ แล้ว เป้าหมายของฉันคือการเขียนนิยายต่อสู้ที่ดีที่สุด และได้รับรางวัล \"นิยายยอดเยี่ยม\" จากสำนักพิมพ์ Yae น่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600212
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600212,
					"content": "เซ้นส์ของฉันบอกว่า เธอจะต้องเป็นดาวที่สว่างที่สุดในเวทีการประลองนี้อย่างแน่นอน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600213,
						726600214
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600213,
					"content": "ฉันจะพยายามเต็มที่",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600215
					]
				},
				{
					"id": 726600215,
					"content": "ฉันตั้งชื่อนิยายเอาไว้แล้ว นั่นก็คือ \"ร้อยใจรวมเป็นหนึ่ง～การประลองอันแสนดุเดือด\" ถ้าวันหนึ่งเธอเห็นหนังสือเล่มนี้ในร้านหนังสือของสำนักพิมพ์ Yae ล่ะก็ งั้นแสดงว่าจะต้องนักรบต่างแดนผมบลอนด์อยู่บนเวทีการประลองแล้วแน่ ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600216
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600216,
					"content": "ฉันตั้งตารอดูผลงานของเธอเลยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600214,
					"content": "แน่นอนอยู่แล้วล่ะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600215
					]
				},
				{
					"id": 726600204,
					"content": "น่าสงสัยจัง",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600205
					]
				}
			]
		}
	]
}