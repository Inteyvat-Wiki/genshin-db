					"Kayabuki Ikkei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726600101,
					"content": "เฮ้! เจ้าคนต่างแดนทางนั้นน่ะ อยากจะดวลกันหน่อยมั้ยล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600102,
						726600104
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600102,
					"content": "ฉันคือนักรบที่ผ่านศึกมานับร้อย",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600103
					]
				},
				{
					"id": 726600103,
					"content": "ดีเลย ฉันมองคนไม่ผิดจริง ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600106
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600106,
					"content": "คืออย่างงี้นะ ดูเหมือนช่วงนี้จะมีคนแอบจัดการประลอง \"ร้อยใจรวมเป็นหนึ่ง\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600107,
						726600109
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600107,
					"content": "ร้อยใจร้องเพลงหนึ่ง?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600108
					]
				},
				{
					"id": 726600108,
					"content": "ไม่ใช่ ๆ ร้อยใจรวมเป็นหนึ่งต่างหากล่ะ ร้อยใจร้องเพลงหนึ่งนี่คืออะไรเหรอ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600110
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600110,
					"content": "มันเป็นพิธีกรรมดั้งเดิมที่สืบทอดกันในหมู่ \"ชาวลัทธิเท็งงุ\" ซึ่งเลียนแบบมาจากเท็งงุ พูดง่าย ๆ ก็คือ..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600111
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600111,
					"content": "เมื่อสถานการณ์ไม่สดใส จิตใจย่ำแย่ หรือมีเรื่องราวดี ๆ ที่ควรฉลอง หรือแค่ตอนที่รู้สึกเบื่อ ๆ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600112
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600112,
					"content": "พวกเขาจะต่อสู้อย่างเต็มที่เพื่อเฉลิมฉลอง หรือเพียงเพื่อกำจัดความโชคร้าย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600113
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600113,
					"content": "เหมือนจะจัดได้ตลอดเวลาเลยนะ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600114
					]
				},
				{
					"id": 726600114,
					"content": "...คิดดูดี ๆ แล้วก็เหมือนจะเป็นอย่างนั้นนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600115
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600115,
					"content": "เอาเป็นว่า เราเปลี่ยนที่คุยกันดีกว่า ในเมืองคนค่อนข้างพลุกพล่าน ไม่ค่อยสะดวกเท่าไหร่...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600109,
					"content": "งั้นก็ว่ามาเลยสิ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600110
					]
				},
				{
					"id": 726600104,
					"content": "มีคำขออะไรเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600105
					]
				},
				{
					"id": 726600105,
					"content": "ไม่ใช่คำขอหรอก เอาเป็นว่า...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600106
					],
					"speakerTitle": "Kayabuki Ikkei"
				}
			]
		},
		{
			"id": 7266002,
			"completionStepIds": [
				7266002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
