					"Viktor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230110101,
					"content": "เอ่อ... ตรงนี้จะแกะสลักยังไงดีนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110102,
						230110103
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110102,
					"content": "เฮ้!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110104
					]
				},
				{
					"id": 230110104,
					"content": "เอ๊ะ นั่นใครน่ะ อย่าเพิ่งมากวนฉัน ฉันกำลัง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110105
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110105,
					"content": "ห๊ะ?! นักเดินทาง?! ทำไมถึงมาที่ Sumeru ด้วยล่ะเนี่ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110106
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110106,
					"content": "คงไม่ใช่ว่าเจ้า Rudolf นั่นส่งเธอมาเล่นงานฉันหรอกใช่มั้ย ฉันแค่เคยให้ของขวัญเล็ก ๆ น้อย ๆ แก่ Lily เอง แถมยังผ่านมาตั้งนานแล้วด้วย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110107,
						230110109
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110107,
					"content": "ฉันแค่เดินทางผ่านมาเฉย ๆ น่ะ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110108
					]
				},
				{
					"id": 230110108,
					"content": "เธอยังเดินทางอยู่อีกเหรอ ช่างมีเรี่ยวแรงล้นเหลือดีจริง ๆ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110112
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110112,
					"content": "แต่นึกไม่ถึงเลยว่าจะได้เจอเธอที่ Sumeru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110113
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110113,
					"content": "ตอนที่ฉันถูกย้ายมาจาก Mondstadt เดิมทีคำสั่งที่ได้รับคือ ให้ฉันตรงกลับไปที่ Snezhnaya เลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110114
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110114,
					"content": "แต่ระหว่างทางกลับได้รับคำสั่งใหม่ ให้ฉันมาช่วยงานคุณ Vsevolod ที่เมือง Sumeru ทั้งยังแจ้งอีกว่า ฉันถูกย้ายไปอยู่ใต้สังกัดของท่าน \"Pulcinella\" แล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110115,
						230110116
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110115,
					"content": "\"Pulcinella\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110117
					]
				},
				{
					"id": 230110117,
					"content": "ใช่แล้วล่ะ... อ๊ะ ไม่ได้สิ ฉันพูดต่อไม่ได้แล้ว ไม่งั้นคุณ Vsevolod จะหาว่าฉันไม่รู้จักรักษาความลับ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110118
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110118,
					"content": "เฮ้อ ชื่อของเหล่าท่านผู้บริหารก็ไม่ใช่ความลับสักหน่อย ไม่รู้เขาจะเข้มงวดขนาดนั้นไปทำไม",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110119
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110119,
					"content": "คุณมาทำอะไรที่ Sumeru เหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110120
					]
				},
				{
					"id": 230110120,
					"content": "อ้อ ฉันและคุณ Vsevolod รับหน้าที่ประสานงานด้านโลจิสติกส์ พูดง่าย ๆ ก็คือ มีหน้าที่ไปจัดซื้อสิ่งของจากที่ต่าง ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110121
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110121,
					"content": "ถึงจะฟังดูไม่ใช่หน้าที่สำคัญอะไร แต่ก็ดีกว่าอยู่เฉย ๆ ในมหาวิหารแห่ง Mondstadt",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110122
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110122,
					"content": "ฮี่ฮี่ อีกอย่างตอนทำงานนี้ก็มีเวลาว่างเยอะเลย แถมยังไม่มีคนคอยจับจ้องฉันด้วย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110123
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110123,
					"content": "ฉันเลยรื้อฟื้นฝีมือแกะสลักเมื่อครั้งยังเด็กกลับมา ยังไงที่ Sumeru ก็มีไม้เยอะแยะ เหมาะให้ฝึกฝีมือพอดี",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110124
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110124,
					"content": "นึกไม่ถึงว่าพวกเด็ก ๆ จะชื่นชอบงานแกะสลักของฉันมาก ร้องจะเอาให้ได้ ฉันเลยรับปากพวกเขาว่า จะแกะสลักของเล่นให้พวกเขาคนละชิ้น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110125,
						230110128
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110125,
					"content": "คุณคือ Fatui หรือเปล่าเนี่ย?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110126
					]
				},
				{
					"id": 230110126,
					"content": "ก็ใช่น่ะสิ ทำไม? ห๊าย... มีใครกำหนดไว้หรือไงว่า Fatui จะมอบของเล่นให้เด็กไม่ได้?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110127
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110127,
					"content": "อีกอย่างนะ ตอนนี้ฉันรับผิดชอบดูแลด้านโลจิสติกส์อยู่ เพราะงั้นเรื่องใหญ่ ๆ ก็ปล่อยให้เบื้องบนจัดการไปแล้วกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110130
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110130,
					"content": "เอาเป็นว่าสถานการณ์ของฉันในตอนนี้ก็เป็นแบบนี้แหละ แม้ว่าจะกลับไป Snezhnaya ไม่ได้ แต่ฉันก็ชอบ Sumeru มากเหมือนกัน มีทั้งที่กิน, ที่เที่ยว, แถมสภาพแวดล้อมก็ดีด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110131
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110131,
					"content": "หลังทำงานเสร็จก็ไปซื้อของกิน แล้วหาจุดที่แดดส่องกำลังดี นั่งแกะสลักงานไม้สักหน่อย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110132
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110132,
					"content": "แม้ว่า... ฮ่าฮ่า ทุกคนจะมองฉันด้วยสีหน้าเหลือเชื่อ เหมือนตอนที่เธอคุยกับฉันครั้งแรกก็เถอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110133
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110133,
					"content": "มันช่วยไม่ได้ ก็ฉันเป็น Fatui นี่นา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110134,
						230110135
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110134,
					"content": "ตอนนี้ฉันก็ไม่ได้เชื่อใจคุณนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110136
					]
				},
				{
					"id": 230110136,
					"content": "ก็ได้ ๆ... สรุปก็คือฉันพอใจกับชีวิตในตอนนี้มาก และก็พอมีเงินเก็บบ้างแล้วด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110137
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110137,
					"content": "ถ้าเป็นแบบนี้ไปเรื่อย ๆ อีกไม่กี่ปี ฉันคงลงหลักปักฐานที่ Sumeru ได้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110138
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110138,
					"content": "อะแฮ่ม คุยเรื่องอื่นกันดีกว่า ไหน ๆ นักเดินทางก็มาที่ Sumeru แล้ว ถ้าเธอสนใจล่ะก็ พวกเรามาทำ \"การแลกเปลี่ยนที่เท่าเทียม\" กันมั้ยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110139
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110139,
					"content": "แต่ครั้งนี้ ฉันไม่มีเรื่องจะเล่าให้ฟังแล้ว คงต้องจ่ายค่าตอบแทนเป็นของมีค่าให้เธอแทน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110140,
						230110141
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110140,
					"content": "แบบนี้ก็เยี่ยมเลย",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110143
					]
				},
				{
					"id": 230110143,
					"content": "เอาล่ะ ฉันจะอธิบายรายละเอียดคำขอให้ฟังนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110144
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110144,
					"content": "หลายวันก่อนฉันสั่งไม้จาก Hamawi ไว้ล็อตนึง แต่ตอนนี้เขายังไม่ส่งสินค้ามาให้ฉันเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110145
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110145,
					"content": "ตอนนี้ฉันยังอยู่ในเวลางาน แล้วก็ไม่กล้าออกไปหาเขา ไม่งั้นเดี๋ยวจะถูกคุณ Vsevolod บ่นอีก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110146
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110146,
					"content": "นักเดินทาง เธอช่วยไปสอบถาม Hamawi ให้ฉันทีนะว่า ไม้ที่ฉันสั่งไว้จะมาถึงเมื่อไหร่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110147,
						230110149
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110147,
					"content": "เตรียมค่าตอบแทนไว้ด้วยล่ะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110148
					]
				},
				{
					"id": 230110148,
					"content": "วางใจได้เลย ฉันจะเตรียมไว้ให้แน่นอน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110151
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110151,
					"content": "เอาเป็นว่า ฝากเธอจัดการเรื่องนี้ด้วยนะ นักเดินทาง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110149,
					"content": "ไม่ได้วางแผนร้ายอะไรไว้จริง ๆ ใช่มั้ย...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110150
					]
				},
				{
					"id": 230110150,
					"content": "เมื่อก่อนตอนที่ฉันแลกเปลี่ยนกับเธอ ก็ไม่เคยเล่นเล่ห์กับเธอสักครั้ง วางใจเถอะ ฉันขี้เกียจสร้างปัญหาแบบนั้นแล้วล่ะ สู้ใช้ชีวิตสบาย ๆ ไม่ดีกว่าเหรอ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110151
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110141,
					"content": "นี่คือคำขอจาก \"Fatui\" เหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110142
					]
				},
				{
					"id": 230110142,
					"content": "ไม่ใช่หรอก เป็นแค่คำขอจาก Viktor น่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110143
					],
