					"Ekaterina"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10100201,
					"content": "#ยินดีต้อนรับสหายของนายท่าน Childe นับแต่นี้ต่อไปขอให้เธอเป็นใหญ่เป็นโตกับ Fatui เร็ว ๆ นะ {NICKNAME}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100202,
						10100203
					],
					"speakerTitle": "Ekaterina"
				},
				{
					"id": 10100202,
					"content": "ฉันไม่ใช่เพื่อนของ Childe หรอกนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100204
					]
				},
				{
					"id": 10100204,
					"content": "โอ้... พวกเราต่างก็เป็นเพียงแค่มนุษย์ ไม่ใช่ \"จักรพรรดินีน้ำแข็ง\" นี่นะ ความคิดของมนุษย์ธรรมดาน่ะ ก็เป็นเหมือนกับชั้นของน้ำที่อยู่ใต้น้ำแข็ง... ไม่มีวันที่จะแทรกซึมขึ้นมาได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100205
					],
					"speakerTitle": "Ekaterina"
				},
				{
					"id": 10100205,
					"content": "เสียมารยาทซะแล้ว ขอฉันกลับเข้าประเด็นเลยนะ นายท่าน Childe บอกว่าข้อตกลงของเขาและพวกคุณได้สำเร็จลงแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100206
					],
					"speakerTitle": "Ekaterina"
				},
				{
					"id": 10100206,
					"content": "ข้อตกลงสำเร็จแล้ว? อ๋า หมายถึงตอนที่เขาบอกว่าจะช่วยพวกเราตามหาคนก่อนหน้านี้ใช่มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100207,
					"content": "ใช่แล้วล่ะ นายท่าน Childe รับปากที่จะหาคนมาแก้ไขสถานการณ์ให้พวกคุณ ผู้บริหารแห่ง Fatui น่ะ ไม่มีวันผิดคำพูดหรอกนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100208
					],
					"speakerTitle": "Ekaterina"
				},
				{
					"id": 10100208,
					"content": "แล้ว... เขาไปไหนแล้วล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100209,
					"content": "นายท่านอยู่ที่ <color=#00E1FFFF>Liuli Pavilion</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100210
					],
					"speakerTitle": "Ekaterina"
				},
				{
					"id": 10100210,
					"content": "Liuli Pavilion?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100211
					]
				},
				{
					"id": 10100211,
					"content": "อ๋าาา Liuli Pavilion ไงล่ะ! ฉันเคยได้ยิน!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100212,
					"content": "อาหารสองสายหลักของ Liyue \"อาหาร Li\" และ \"อาหาร Yue\" น่ะ แข่งขันกันมาตั้งนานหลายร้อยปีแล้วล่ะ ไม่มีแพ้ไม่มีชนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100213,
					"content": "ตัวแทนที่ดีที่สุดของ \"อาหาร Li\" ก็คือภัตตาคาร \"Liuli Pavilion\" เถ้าแก่ของที่นั่นน่ะตั้งใจเปิดร้านที่ Feiyun Slope เพื่อเผชิญหน้ากับ \"Xinyue Kiosk\" ซึ่งเป็นตัวแทนของ \"อาหาร Yue\" แบบซึ่ง ๆ หน้าเลยเชียวนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100214,
						10100215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100214,
					"content": "Paimon จะทำตัวเป็นผู้นำทางที่ดีก็กับเฉพาะเวลาแบบนี้เท่านั้นล่ะนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100216
					]
				},
				{
					"id": 10100216,
					"content": "#อย่าพูดอย่างนั้นสิ สรุปก็คือ... มีของอร่อยไงล่ะ! {NICKNAME} พวกเรารีบไปกันเถอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100215,
					"content": "พอพูดถึงเรื่องกินทีไร เธอก็...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100216
					]
				},
				{
					"id": 10100203,
					"content": "ฉันไม่ได้อยากจะเข้าร่วมกับ Fatui หรอกนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100204
					]
				}
			]
		},
