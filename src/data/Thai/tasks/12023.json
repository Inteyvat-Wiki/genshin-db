					"nextDialogs": [
						120230206
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230206,
					"content": "#สิ่งสำคัญที่สุดของกองทัพต่อต้านคืออะไร {M#นาย}{F#เธอ}จำได้มั้ย?",
