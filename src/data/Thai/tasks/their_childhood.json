					"Verut",
					"Aurele"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240030101,
					"content": "ที่ซ่อนของฉันในครั้งนี้ พี่ต้องหาไม่เจอแน่!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030102
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030102,
					"content": "ถ้าเธอไปซ่อนตามที่พวกนั้น คนที่ไปตามหาเธอคงไม่ใช่ฉัน แต่เป็นพ่อกับแม่นะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030103
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030103,
					"content": "พวกเธอทำอะไรกันอยู่น่ะ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030104
					]
				},
				{
					"id": 240030104,
					"content": "ฉันกำลังเล่นซ่อนแอบกับพี่ชายอยู่น่ะ! แต่ว่า... เขารู้ที่ซ่อนของฉันทุกที่เลย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030105
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030105,
					"content": "Verut... พวกเราเล่นอยู่นี่มานานแค่ไหนละ ทุกมุมที่ซ่อนได้เธอก็ซ่อนไปหมดแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030106
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030106,
					"content": "ส่วนสถานที่ที่ซ่อนไม่ได้น่ะ... ฉันก็บอกเธอหลายครั้งแล้วนะ ว่าทำไมถึงไปซ่อนที่นั่นไม่ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030107
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030107,
					"content": "สถานที่พวกนั้นไม่เห็นจะอันตรายตรงไหนเลย พ่อกับแม่ชอบพูดเกินจริง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030108
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030108,
					"content": "แต่ถ้าเธอไปซ่อนในที่แบบนั้น เสื้อกับกางเกงก็จะสกปรกเสียหาย พ่อกับแม่ทำงานก็เหนื่อยแล้ว อย่าให้พวกเขาต้องมาห่วงเรื่องพวกนี้เลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030109
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030109,
					"content": "เง้อ... ก็ได้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030110,
						240030111
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030110,
					"content": "ไม่งั้น... ฉันเล่นเป็นเพื่อนพวกเธอเอามั้ย?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030112
					]
				},
				{
					"id": 240030112,
					"content": "จริงเหรอ?! พี่อยากเล่นกับฉันเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030113
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030113,
					"content": "Verut อย่าไปรบกวนคนอื่นสิ! ขอโทษนะ น้องชายของฉันวัน ๆ เอาแต่จะเล่น...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030114,
						240030115
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030114,
					"content": "ไม่เป็นไรหรอก ฉันว่างอยู่พอดี",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030116
					]
				},
				{
					"id": 240030116,
					"content": "ได้เลย! พี่ดูสิ พี่คนนี้รับปากแล้วนะ! ฉันต้องซ่อนเก่งกว่าพี่แน่นอน!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030117
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030117,
					"content": "#ก็ได้... งั้นก็รบกวนด้วยนะ{M#พี่ชาย}{F#พี่สาว}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030118
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030118,
					"content": "Verut อย่าไปซ่อนตรงที่ฉันเคยพูดถึงนะ วันนี้พ่อกับแม่จะกลับบ้านช้าหน่อย ถ้าทำเสื้อผ้าขาดล่ะก็ ไม่มีคนเย็บให้แล้วนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030119
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030119,
					"content": "รู้แล้วน่า พี่พูดมากจังเลย... ฉันไปซ่อนตัวก่อนล่ะ พี่ก็มาเล่นด้วยกันเถอะ เร็วเข้า ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030120
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030120,
					"content": "เธอไปเถอะ ฉันคิดไว้แล้วว่าจะไปซ่อนที่ไหน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030121
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030121,
					"content": "#จริงเหรอ? พี่โม้รึเปล่าเนี่ย... พี่ต้องถูก{M#พี่ชาย}{F#พี่สาว}คนนี้เจอเป็นคนแรกแน่ ๆ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030122
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030122,
					"content": "Aurele และ Verut แยกย้ายกันไปซ่อนตัว...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 240030115,
					"content": "ไม่เป็นไร ไม่รบกวนหรอก",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030116
					]
				},
				{
					"id": 240030111,
					"content": "ฉันต้องหาพวกเธอไม่เจอแน่เลย",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030112
					]
				}
			]
		},
