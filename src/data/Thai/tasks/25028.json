						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Milu Nui",
					"Lillo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250280201,
					"content": "เอาล่ะ สหาย Lillo เป้าหมายของเราในวันนี้ก็คือเจ้าพวกนั้นนั่นแหละ เตรียมตัวให้ดีล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280202
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250280202,
					"content": "ไม่มีปัญหา พร้อมอยู่แล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280203,
						250280204
					],
					"speakerTitle": "Lillo"
				},
				{
					"id": 250280203,
					"content": "ยุ่งอยู่กับการทำแผ่นเสียงอีกแล้วเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250280205
					]
				},
				{
					"id": 250280205,
					"content": "สวัสดี ไม่นึกว่าจะได้เจอกับคุณที่นี่อีก ใช่แล้วล่ะ พวกเรากำลังรวบรวมข้อมูลสำหรับเพลงใหม่อยู่น่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280206
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250280206,
					"content": "หลังจากเรื่องคราวก่อน ฉันกับสหาย Lillo ก็ได้พูดคุยเรื่องปัญหาของแผ่นเสียงกันอย่างละเอียดแล้ว และได้รับแรงบันดาลใจใหม่ ๆ มาเยอะเลยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280207
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250280207,
					"content": "พูดเวอร์เกินไปแล้ว ฉันแค่แนะนำให้คุณ Milu Nui เปลี่ยนวิธี หรือหาข้อมูลอื่นมาทำเพลงก็เท่านั้นเอง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280208
					],
					"speakerTitle": "Lillo"
				},
				{
					"id": 250280208,
					"content": "เพลงที่ฉันเคยได้ยินจากในเผ่า บางเพลงถึงขั้นใส่เสียงกระทบกันของอาวุธ เสียงร้องตะโกนในการต่อสู้ เสียงฝีเท้าของคนที่วิ่งไปมาเพิ่มเข้าไปในบทเพลงด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280209
					],
					"speakerTitle": "Lillo"
				},
				{
					"id": 250280209,
					"content": "เพลงที่ทำขึ้นด้วยวิธีนี้ได้รับความนิยมมาก แถมแพร่ไปอย่างรวดเร็วเลยด้วย... ฉันคิดว่านี่อาจจะเป็น \"ความป๊อป\" ที่คุณ Milu Nui ต้องการก็ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280210
					],
					"speakerTitle": "Lillo"
				},
				{
					"id": 250280210,
					"content": "ใช่แล้วล่ะ! เพราะงั้นพวกเราเลยตามหานักรบกันอยู่ตลอด เพื่อดูว่าพวกเขาต่อสู้กันยังไง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280211
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250280211,
					"content": "แล้วพวกคุณเจอเป้าหมาย ที่จะเก็บข้อมูลแล้วรึยัง?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250280212
					]
				},
				{
					"id": 250280212,
					"content": "เจอแล้ว! ก็พวกคนที่อยู่ข้างหน้านี่แหละ เราได้ยินมาจากในเผ่าว่า คนกลุ่มนี้มักจะออกไปหาคู่ต่อสู้ข้างนอกอยู่ตลอด แถมพวกเขายังแข็งแกร่งมากเลยด้วย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280213
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250280213,
					"content": "อะแฮ่ม พูดง่าย ๆ ก็คือ คนกลุ่มนี้ชอบก่อเรื่องอยู่ข้างนอกเป็นประจำ พอเจอใครก็จะเข้าไปถามว่า \"อยากประลองฝีมือกันมั้ย\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280214
					],
					"speakerTitle": "Lillo"
				},
				{
					"id": 250280214,
					"content": "ถ้าเกิดคนคนนั้นแพ้พวกเขา ก็จะถูกบังคับให้เอาของออกมาเป็นเดิมพันด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280215
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250280215,
					"content": "ฉันเองก็มีเพื่อนนักดนตรีหลายคนที่ถูกพวกเขาปล้นไป... ฉันยอมไม่ได้หรอก!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280216
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250280216,
					"content": "ใช่แล้ว คนในเผ่าเองก็แทบจะทนไม่ไหวกันแล้ว ต้องหาคนไปสั่งสอนพวกเขาสักหน่อย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280217
					],
					"speakerTitle": "Lillo"
				},
				{
					"id": 250280217,
					"content": "เป็นกลุ่มคนที่แปลกจริง ๆ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250280218
					]
				},
				{
					"id": 250280218,
					"content": "ใครจะไปรู้ว่าพวกเขาคิดอะไรอยู่? บอกตามตรงนะ ฉันไม่เข้าใจความคิดของคนพวกนี้เลยจริง ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280219
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250280219,
					"content": "ถ้าคุณเต็มใจละก็ ช่วยไปสั่งสอนพวกเขาพร้อมกับสหาย Lillo หน่อยสิ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280220
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250280220,
					"content": "ฉันเคยเห็นฝีมือของคุณมาตั้งนานแล้ว ถ้าได้เห็นคุณปล่อยหมัดละก็ ฉันจะต้องหาแรงบันดาลใจได้มากขึ้น และดีขึ้นกว่าเดิมแน่นอน!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280221
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250280221,
					"content": "แต่... ฉันคุณต้องระวังด้วยนะ! ถ้าพวกนั้นมีแผ่นเสียงอยู่ในมือละก็ คุณห้ามทำพังเชียวล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280222
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250280222,
					"content": "ไม่งั้นเพื่อนนักดนตรีของฉัน คงจะเป็นลมอีกรอบแน่ ๆ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280223,
						250280224
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250280223,
					"content": "ไม่มีปัญหา จะดูให้ดีเลยล่ะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250280225
					]
				},
				{
					"id": 250280225,
					"content": "โอเค! ฮ่าฮ่าฮ่า งั้นก็เยี่ยมไปเลย มีคุณช่วยแบบนี้ ฉันจะต้องทำเพลงที่ยอดเยี่ยมออกมาได้แน่นอน!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250280224,
					"content": "ฉันจะแสดงฝีมือให้คุณดูเอง",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250280225
					]
				},
				{
					"id": 250280204,
					"content": "พวกคุณกำลังเก็บข้อมูลกันอยู่เหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
