	"talks": [
		{
			"id": 2502801,
			"completionStepIds": [
				2502801
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2502801",
							"2"
						],
						"stepId": 2502801,
						"stateName": "QUEST_STATE_UNFINISHED"
