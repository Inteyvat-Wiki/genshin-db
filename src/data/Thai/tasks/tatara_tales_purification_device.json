				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721160101,
					"content": "ยังต้องรออีกสักพักสินะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160102
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160102,
					"content": "รวบรวมข้อมูลเสร็จแล้วเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721160103
					]
				},
				{
					"id": 721160103,
					"content": "คุณนี่เอง...ดีจริง ๆ ที่ได้เจอ ตอนนี้ยังรวบรวมข้อมูลไม่เสร็จ ฉันคิดว่าน่าจะต้องการเวลาอีกสักหน่อย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160104
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160104,
					"content": "อย่างไรก็ตาม ฉันอาศัยจังหวะนี้ เพื่อคิดเกี่ยวกับโครงสร้างของอุปกรณ์ชำระล้างฉุกเฉิน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160105,
						721160107
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160105,
					"content": "อะไรคืออุปกรณ์ชำระล้างฉุกเฉิน?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721160106
					]
				},
				{
					"id": 721160106,
					"content": "มันก็แค่เทคนิคฉุกเฉินของฉันเท่านั้น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160109
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160109,
					"content": "ตามแผนการที่เราหารือกันก่อนหน้า พวกเราจะต้องรับมือกับเรื่องยุ่งยากจากทั้ง Fatui และ \"Tatarigami\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160110
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160110,
					"content": "ฉันเชื่อว่าคุณสามารถจัดการพวก Fatui ได้แน่ ส่วนฉัน...แน่นอนว่าจะต้องรับมือกับ \"Tatarigami\" ให้ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160111
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160111,
					"content": "อุปกรณ์ชำระล้างฉุกเฉินนี้ ก็คืออุปกรณ์ที่จะทำให้ฉันจัดการกับ \"Tatarigami\" เหล่านั้นได้ แต่การจะทำอุปกรณ์แบบนี้ขึ้นมา จะต้องขอความร่วมมือจากคุณอีกครั้ง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160112,
						721160113
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160112,
					"content": "ต้องการให้ฉันช่วยอะไร?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721160117
					]
				},
				{
					"id": 721160117,
					"content": "เพื่อที่จะทำให้สามารถใช้งานเจ้าอุปกรณ์นี้ใน Mikage Furnace ได้อย่างราบรื่น ฉันยังต้องการใช้วัสดุพิเศษบางอย่างอีก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160118
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160118,
					"content": "คริสตัลที่ประกอบไปด้วยพลังงานของ \"Tatarigami\" ที่เต็มไปด้วยความเฉื่อยอย่าง \"Crystal Marrow\" นี้มีความเหมาะสมมากเลยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160119
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160119,
					"content": "ในความเป็นจริงแล้ว ความลับของ Jade Steel ที่แสนโด่งดัง ก็อยู่ที่การเติมวัสดุแบบนี้เข้าไปด้วยกรรมวิธีพิเศษในระหว่างการหลอม เพื่อเพิ่มความแข็งแรงของเหล็ก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160120
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160120,
					"content": "แน่นอนว่า \"กรรมวิธีพิเศษ\" แบบนี้น่ะ เป็นส่วนหนึ่งของความลับทางการค้า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160121
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160121,
					"content": "ฉันจำได้ว่าแถวนี้น่าจะมีแร่คริสตัลแบบนี้อยู่ รบกวนคุณช่วยรวบรวมให้ฉันสักสามชิ้นทีนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160122
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160122,
					"content": "เข้าใจแล้ว",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721160123
					]
				},
				{
					"id": 721160123,
					"content": "งั้นรบกวนคุณหน่อยนะ Crystal Marrow สามชิ้น คุณรวบรวมได้ครบเมื่อไหร่ก็นำมาให้ฉันได้เลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160113,
					"content": "ก็นึกว่ามันมีชื่ออย่างเป็นทางการ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721160114
					]
				},
				{
					"id": 721160114,
					"content": "ชื่ออย่างเป็นทางการก็ \"อุปกรณ์ชำระล้างฉุกเฉิน\" ไม่ใช่หรือไง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160115
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160115,
					"content": "อ่า...คุณหมายถึง หมายเลขระบุผลิตภัณฑ์และวันที่ผลิตของโรงงานอย่างเป็นทางการงั้นเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160116
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160116,
					"content": "อุปกรณ์ฉุกเฉินแบบนี้ ของแบบนั้นไม่ต้องใช้แล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160117
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160107,
					"content": "นี่ก็เป็น \"มาตรการฉุกเฉิน\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721160108
					]
				},
				{
					"id": 721160108,
					"content": "จะว่างั้นก็ได้ แต่เทคนิคแบบนี้ ปกติแล้วในตอนที่บริการลูกค้าน่ะ ฉันไม่ทำให้หรอกนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160109
					],
					"speakerTitle": "Xavier"
				}
			]
		},
