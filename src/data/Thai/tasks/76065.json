			"dialogs": [
				{
					"id": 760650101,
					"content": "มาแล้วเหรอ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650102
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650102,
					"content": "ไม่คิดเลยว่า Columbina จะอยู่ที่นี่",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650103
					]
				},
				{
					"id": 760650103,
					"content": "อืม ตอนนี้เธอก็มาแล้ว เพราะงั้นพวกเราก็เลยมาอยู่ที่นี่ด้วยกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650104
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650104,
					"content": "พูดอย่างกับเธอรู้ว่าฉันจะมางั้นแหละ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650105
					]
				},
				{
					"id": 760650105,
					"content": "ฉันไม่รู้หรอกนะว่าเมื่อไหร่ แต่เธอก็ต้องมาอยู่แล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650106
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650106,
					"content": "เหมือนกับดวงจันทร์และ Teyvat ที่มีแรงดึงดูดเชื่อมโยงถึงกันเสมอ เธอมักจะหาฉันเจอทุกครั้ง ไม่ใช่เหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650107
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650107,
					"content": "มาสิ มานั่งด้วยกันเถอะ ฉันเว้นที่ไว้ให้เธอแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650108
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650108,
					"content": "คราวก่อนพวกเรามองดู Teyvat จากบนยานอวกาศของเธอ คราวนี้มามองดูดวงดาวบนท้องฟ้ากันเถอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650109
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650109,
					"content": "Ninnin กับรุ่นพี่ของเธอถูกท้องฟ้าพร่างดาวผืนนี้ดึงดูดเอาไว้ ที่นั่นจะต้องมีแรงดึงดูดที่แตกต่างออกไปแน่ ๆ ฉันสัมผัสได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650110
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650110,
					"content": "Ninnin และข้อความที่เธอส่งมา...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650111
					]
				},
				{
					"id": 760650111,
					"content": "ไม่ต้องกังวล เธอไม่ได้เจออันตราย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650112
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650112,
					"content": "เธอเดินทางไปไกลแสนไกลอย่างปลอดภัย ไกลซะจนไม่อาจสัมผัสได้ถึงพลังที่ฉันคุ้มครองเธอแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650113
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650113,
					"content": "แต่ว่าฉันสงสัย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650114
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650114,
					"content": "สงสัยอะไรเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650115
					]
				},
				{
					"id": 760650115,
					"content": "อืม มีเยอะเลย อย่างเช่น คนอื่นจะได้รับข้อความจากผู้เฝ้ามองจันทร์มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650116
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650116,
					"content": "คนที่ได้รับ หรือตัวตนอื่น... พวกเขาจะเป็นใครกันนะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650117
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650117,
					"content": "พวกเขาจะคิดยังไงนะ? จะมีทั้งความรักและความเกลียดชังอยู่ในใจ เหมือนกับพวกเรามั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650118
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650118,
					"content": "จะเหมือนกับพวกเรา ที่แม้จะถูกรายล้อมไปด้วย Abyss แต่ก็ยังคงถูกดึงดูดด้วยท้องฟ้าพร่างดาว ที่งดงามและลึกลับนี้มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650119
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650119,
					"content": "จะเป็นเหมือนพวกเรามั้ย ที่อยากตามหาคนอื่น แล้วก็โบกมือให้พร้อมกับพูดว่า \"เพื่อน ยินดีที่ได้รู้จักนะ\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650120
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650120,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650121
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650121,
					"content": "ในส่วนลึกของท้องฟ้าพร่างดาวแห่งนี้ ยังมีอารยธรรมที่ไม่ได้ถูกความมืดกลืนกินอยู่อีกมั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650122
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650122,
					"content": "ฉันคิดว่าน่าจะมีนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650123
					]
				},
				{
					"id": 760650123,
					"content": "หืม?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650124
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650124,
					"content": "ยานอวกาศของเรา เคยได้รับข้อความหนึ่ง",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650125
					]
				},
				{
					"id": 760650125,
					"content": "ข้อความอะไรเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650126
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650126,
					"content": "เนื้อหาสำคัญแทบจะสูญหายไปหมดแล้ว",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650127
					]
				},
				{
					"id": 760650127,
					"content": "แต่จะต้องเป็นอารยธรรม ที่มีภูมิปัญญาอย่างแน่นอน",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650128
					]
				},
				{
					"id": 760650128,
					"content": "ที่สูญหายไป... เป็นเพราะเดินทางมาไกลเกินไปรึเปล่า...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650129
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650129,
					"content": "แต่แค่นี้ก็น่าดีใจแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650130
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650130,
					"content": "#จริงสิ {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650131
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650131,
					"content": "หืม?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650132
					]
				},
				{
					"id": 760650132,
					"content": "บ้านเกิดเดิมของเธอ ก็อยู่ลึกเข้าไปในนั้นสินะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650133
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650133,
					"content": "ถ้ามีวันหนึ่ง เธออยากจะกลับไปยังสถานที่ที่เธอเริ่มต้นออกเดินทาง เพื่อทำความสะอาดที่นั่น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650134
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650134,
					"content": "ฉันก็พร้อมจะช่วย เหมือนกับที่เธอช่วยฉันทำความสะอาดดวงจันทร์ยังไงล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650135
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650135,
					"content": "งั้นฉันจะไม่ลืมชวนเธอแน่นอน",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650136
					]
				},
				{
					"id": 760650136,
					"content": "จัดปาร์ตี้อีกเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650137
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650137,
					"content": "จัดปาร์ตี้อีกรอบ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650138
					]
				},
				{
					"id": 760650138,
					"content": "งั้น...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650139
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650139,
					"content": "ตั้งชื่อว่า \"ค่ำคืนแห่งการหวนคืน\" เธอคิดว่ายังไง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650140
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650140,
					"content": "อาจจะเป็นตอนกลางวันก็ได้นะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650141
					]
				},
				{
					"id": 760650141,
					"content": "งั้นก็ฉลองกันตั้งแต่กลางวันจนถึงกลางคืนเลย ชวนเพื่อนสนิทมาให้หมดเลยด้วยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650142
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650142,
					"content": "ฟังดูน่าสนุกดีนี่",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650143
					]
				},
				{
					"id": 760650143,
					"content": "ขอให้ค่ำคืนนั้นมาถึงในวันที่อากาศดี พร้อมกับการรวมตัวกันของเพื่อน ๆ นะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Columbina"
				}
			]
		}
	]
}