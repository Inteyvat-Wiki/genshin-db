			"dialogs": [
				{
					"id": 412100401,
					"content": "#อยู่นั่นไง! ที่{F#ยัยหนู}{M#ไอ้หนู}นั่นมันถืออยู่นั่นน่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100402
					],
					"speakerTitle": "ชายผู้เกรี้ยวกราด"
				},
				{
					"id": 412100402,
					"content": "ส่งของนั่นมาเดี๋ยวนี้นะ หัวขโมย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100403
					],
					"speakerTitle": "ชายผู้เกรี้ยวกราด"
				},
				{
					"id": 412100403,
					"content": "กองโจรล่าสมบัติ? ในที่ที่หนาวขนาดนี้ก็ยังมีกองโจรล่าสมบัติอีกเหรอเนี่ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100404,
					"content": "พูดมากน่ะ! ส่งมันมาซะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100405
					],
