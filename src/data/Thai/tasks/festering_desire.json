					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412100501,
					"content": "กองโจรล่าสมบัติเรียกพวกเราว่าหัวขโมยเนี่ยนะ พวกมันต่างหากล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100502,
					"content": "พวกนี้นี่มากันไวจังเลยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100503,
						412100504
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100503,
					"content": "Albedo คุณคือหัวขโมยงั้นเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100505
					]
				},
				{
					"id": 412100505,
					"content": "จะเป็นอย่างนั้นไปได้ยังไง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100506
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100506,
					"content": "ของที่พวกนั้นพูดถึงน่ะ ดูท่าน่าจะเป็นดาบเล่มนี้นี่แหละนะ นี่มันเรื่องอะไรกันเนี่ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100507,
					"content": "มองอย่างนั้นหมายความว่ายังไงกัน? ฉันจะไปขโมยดาบเพื่ออะไรกันล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100508
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100508,
					"content": "ไม่นานมานี้ ทางกองอัศวินจับกองโจรล่าสมบัติกลุ่มนึงได้ที่นอก Mondstadt ส่วนของที่ถูกขโมยมาที่พวกมันลักลอบขนมาด้วยก็ถูกยึดเอาไว้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100509
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100509,
					"content": "ดาบเล่มนี้ก็คือหนึ่งในของเหล่านั้นนั่นแหละ ถึงจะบอกว่าเป็นของที่ถูกขโมยมา แต่ก็ไม่มีใครมาขอรับคืน และก็ไม่รู้ที่มาว่ามาจากที่ไหน แล้วก็ถูกทิ้งไว้ที่ห้องเก็บของมาโดยตลอด",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100510
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100510,
					"content": "ฉันบังเอิญไปเห็นมันเข้าตอนที่ไปหยิบของ พูดจริง ๆ เลยนะ ดาบที่เก่าขนาดนี้น่ะ ถ้าไม่เอามาทำเป็นวัสดุสำหรับแปรธาตุ ก็ไม่รู้ว่าจะเอาไว้ทำอะไรแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100511
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100511,
					"content": "เอ๋? ทำไมมั่วนิ่มเอาของที่ถูกขโมยมาเป็นของตัวเองเฉยเลยล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100512,
					"content": "แล้วไงต่อ? คุณก็หยิบมันมาเลยงั้นเรอะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100513,
					"content": "อื้อ ฉันอยากจะเอามาใช้ในการทดลองน่ะ แต่นึกไม่ถึงเลย ว่าจะได้รู้ถึงที่มาของมันในระหว่างที่กำลังตรวจสอบอยู่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100514
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100514,
					"content": "อาวุธที่ดูเก่านี้ถูกตีขึ้นโดยช่างตีเหล็กผู้ล่วงลับ มันคือดาบวิเศษในตำนาน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100515
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100515,
					"content": "ดาบวิเศษ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100516,
					"content": "ว่ากันว่าช่างตีดาบได้หายตัวไปหลังจากตีดาบเสร็จได้ไม่นาน ส่วนตัวดาบก็หายไปอย่างไร้ร่องรอยเหมือนกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100517
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100517,
					"content": "ถ้าคิดย้อนไปจากที่มาของมัน ก็มีความเป็นไปได้สูงที่มันจะถูกกองโจรล่าสมบัติขโมยไป แล้วก็หายไปตั้งแต่นั้นมาจนถึงเดี๋ยวนี้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100518
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100518,
					"content": "อ๋า! คนที่ตีมันขึ้นมาหายตัวไปเหรอ?! น่ากลัวจังเลย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100519,
					"content": "ไม่แปลกใจเลยที่มันเป็นดาบวิเศษที่ต้องคำสาป!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100520,
					"content": "ถูกต้อง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100521
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100521,
					"content": "มนุษย์ตีดาบวิเศษอย่างนี้ขึ้นมาได้ด้วยเหรอเนี่ย...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100522
					]
				},
				{
					"id": 412100522,
					"content": "เธอรู้เรื่องราวระหว่าง <color=#00E1FFFF>Durin</color> กับภูเขาหิมะแห่งนี้รึเปล่า?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100523
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100523,
					"content": "<color=#00E1FFFF>Durin</color> ก็คือมังกรดำที่เคยคุกคาม Mondstadt และถูก <color=#00E1FFFF>\"เทพแห่งลม Barbatos\"</color> กับ <color=#00E1FFFF>\"Dvalin\"</color> ร่วมมือกันกำจัดเมื่อหลายร้อยปีก่อน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100524
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100524,
					"content": "ในตอนสุดท้ายของการต่อสู้อันดุเดือด Durin ผู้พ่ายแพ้ก็ร่วงลงจากอากาศ และตกลงไปในหิมะสีขาวอันกว้างใหญ่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100525
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100525,
					"content": "ภูเขาหิมะที่ปกคลุมด้วยหิมะซึ่งไม่ละลายตลอดทั้งปีนั้น ถือเป็นปรากฏการณ์ที่มหัศจรรย์มาก การที่ Durin ตกลงมาที่นี่น่ะ มันคือเรื่องบังเอิญ หรือคือสิ่งที่หลีกเลี่ยงไม่ได้กันนะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100526
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100526,
					"content": "มีโอกาสเป็นสิ่งที่หลีกเลี่ยงไม่ได้ด้วยงั้นเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100527
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100527,
					"content": "การเลือกภูเขาหิมะเป็นสุสาน ไม่แน่อาจเป็นเพราะต้องการใช้พลังในการแช่แข็งทุกอย่างเพื่อระงับพิษร้ายแรงในร่างกายของ Durin ก็เป็นได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100528
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100528,
					"content": "มันมีความเป็นไปได้ที่เทพอย่างท่าน Barbatos จะใช้วิธีอย่างนี้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100529
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100529,
					"content": "ว้าววว Barbatos นี่เก่งขนาดนั้นเลยเหรอเนี่ย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100530
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100530,
					"content": "นี่ก็เป็นแค่การคาดเดาของฉันเท่านั้นแหละ ไม่มีหลักฐานยืนยันหรอกนะ แต่ที่แน่ ๆ ภูเขาหิมะแห่งนี้เชื่อมโยงกันกับ Durin อย่างลึกซึ้งอย่างแน่นอน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100531
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100531,
					"content": "และวัสดุที่ใช้ทำดาบที่อยู่ในมือของเธอ ก็น่าจะมาจากเศษซากที่เหลืออยู่ของ Durin",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100532
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100532,
					"content": "เศษซากของมังกร?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100533
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100533,
					"content": "อื้ม นำดวงตา, กรงเล็บและเกล็ดของมังกรที่ตายไป... มาบดเป็นผงและเคลือบตัวดาบเอาไว้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100534
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100534,
					"content": "เท่านี้ ความโสมมและพิษของ Durin ก็จะแทรกซึมลงไปในตัวดาบ และกลายเป็นที่มาของพลังของดาบเล่มนี้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100535
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100535,
					"content": "นี่เป็นงานฝีมือระดับสูงมาก ๆ และเมื่อช่างตีดาบตีดาบเสร็จแล้ว ก็น่าจะต้องทดลองใช้ด้วยตนเองเพื่อเป็นการฉลองอย่างแน่นอน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100536
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100536,
					"content": "ขอเพียงแค่เขาใช้ดาบเล่มนี้ในการต่อสู้ พลังอันเลวร้ายบนดาบก็จะไหลเข้าสู่ร่างกายของเขาตามด้ามจับทันที",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100537
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100537,
					"content": "พลังที่คนทั่วไปไม่สามารถต้านทานได้ และช่างตีเหล็กที่บ้าคลั่งเพราะคำสาปก็หนีหายไป บางทีเขาอาจจะประสบอุบัติเหตุที่ไหนสักแห่งก็เป็นได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100538
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100538,
					"content": "อา...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100539
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100539,
					"content": "......",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100540
					]
				},
				{
					"id": 412100540,
					"content": "เธอที่เคยชำระล้างหยดน้ำตาของ Dvalin นั้นมีพลังที่หายากมาก ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100541
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100541,
					"content": "ซึ่งพลังนี้ช่วยให้มั่นใจได้ว่า เธอจะไม่เพียงแต่จะไม่ถูกครอบงำจากความสกปรกและพิษร้ายเท่านั้น แต่ยังจะสามารถกำจัดอันตรายของมันได้อย่างสมบูรณ์อีกด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100542
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100542,
					"content": "เพราะงั้น ก็มีแค่เธอเท่านั้นแหละ ที่สามารถใช้ดาบเล่มนี้ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100543
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100543,
					"content": "ถึงจะพูดอย่างนั้น แต่ดาบเล่มนี้นี่มันใหญ่จังเลยนะ... อึ๋ยยย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100544
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100544,
					"content": "มัน ดูเหมือนมันจะเรืองแสงขึ้นมานะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100545
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100545,
					"content": "สำหรับฉันแล้ว นี่ก็คือสัญญาณของการเริ่มการทดลอง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100546
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100546,
					"content": "ดาบเล่มนี้น่ะอ่อนแอมากในตอนนี้ แต่ว่ามันสามารถดูดซับพลังงานได้ และด้วยวิธีนี้ มันจะแข็งแกร่งขึ้นไปเรื่อย ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100547
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100547,
					"content": "ในบางมุมมอง ก็ถือว่าเป็น \"สิ่งมีชีวิต\" ล่ะนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100548
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100548,
					"content": "นักเดินทาง ช่วยนำมันไปผจญภัยให้มากที่สุดเท่าที่จะทำได้ทีสิ ฉันอยากให้เธอทำให้มันเติบโตขึ้นไปเรื่อย ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100549
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100549,
					"content": "เชื่อว่าในอนาคตอันใกล้นี้ ข้อสันนิษฐานทั้งหลายก็จะได้รับการพิสูจน์",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100504,
					"content": "อย่าบอกนะว่าคุณไปขโมยของของพวกนั้นมาน่ะ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100505
					]
				}
			]
		}
	]
}