			"dialogs": [
				{
					"id": 412100301,
					"content": "Albedo—!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100302,
					"content": "สวัสดี พวกเรามาอีกแล้วล่ะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100303
					]
				},
				{
					"id": 412100303,
					"content": "อื๋อ? ทำไมพวกเธอถึงกลับมากันอีกล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100304
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100304,
					"content": "หลงทางงั้นเรอะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100305
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100305,
					"content": "ม่ายช่ายยย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100306,
						412100307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100306,
					"content": "พอดี Sucrose ขอร้องมาน่ะ ว่าให้ช่วยมาสืบดูความลับของคุณ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100308
					]
				},
				{
					"id": 412100308,
					"content": "อื๋อ? ความลับงั้นเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100309
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100309,
					"content": "อ๋าาาาา นี่เธอทำบ้าอะไรของเธอน่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100310,
					"content": "ช่วงเวลาอย่างนี้มันควรจะต้องค่อย ๆ แอบสืบดูไม่ใช่เหรอ? ทำไมอยู่ ๆ ถึงไปบอกเค้าล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100311,
					"content": "ยังไงก็หลอก Albedo ไม่ได้หรอกมั้ง",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100312
					]
				},
				{
					"id": 412100312,
					"content": "อาา... ถึงเธอจะพูดอย่างนั้น...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100313,
					"content": "มาพอดีเลย ฉันก็มีเรื่องจะคุยกับเธอเหมือนกัน นักเดินทาง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100314
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100314,
					"content": "เอ้า! รับ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100315
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100315,
					"content": "เอ๋ นี่คืออะไรอ่า?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100316,
					"content": "อย่างที่เห็นนั่นแหละ มันคือดาบยังไงล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100317,
						412100318
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100317,
					"content": "นี่คุณตีดาบได้ด้วยเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100319
					]
				},
				{
					"id": 412100319,
					"content": "ดาบนั่นฉันไม่ได้เป็นคนตีขึ้นมาหรอกนะ แต่ว่าเมื่อกี้ฉันใช้วิชาแปรธาตุกับพื้นผิวของมันน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100320
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100320,
					"content": "อยากลองมั้ยล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100321
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100321,
					"content": "อื๋อ? จะยกมันให้ฉันเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100322
					]
				},
				{
					"id": 412100322,
					"content": "จากการวิจัยของฉัน ดาบเล่มนี้น่ะมีความพิเศษอยู่ และมีเพียงแค่เธอเท่านั้นที่ใช้มันได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100323
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100323,
					"content": "แต่ว่าตอนนี้ฉันอยากจะได้ข้อมูลของมัน ยังไงเธอช่วยเอามันไปใช้สู้หน่อยได้มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100324
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100324,
					"content": "ดะ-เดี๋ยวนะ ทำไมถึงมีดาบที่มีแค่คนเดียวที่สามารถใช้ได้อยู่ล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100325,
					"content": "คงจะไม่มีผลกระทบจากการใช้หรอกนะ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100326
					]
				},
				{
					"id": 412100326,
					"content": "เฉียบแหลมมาก ดาบเล่มนี้ไม่ธรรมดาจริง ๆ นั่นแหละ มันถูกคำสาปบางอย่างร่ายเอาไว้น่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100327
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100327,
					"content": "คนทั่วไปน่ะไม่สามารถใช้มันได้แน่นอน แต่ว่าเธอแตกต่างออกไป",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100328
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100328,
					"content": "อื๋อ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100329,
					"content": "พูดได้ว่า มีเพียงเธอเท่านั้นที่จะไม่ถูกคำสาปของดาบเล่มนี้เล่นงาน ในเมื่อเป็นแบบนี้ แล้วฉันจะยังไปขอให้ใครช่วยได้อีกล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100330
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100330,
					"content": "พูดมากไปก็ไม่ได้ประโยชน์อะไร ไปหามอนสเตอร์แถว ๆ นี้ดูทีละกัน ลองดูเดี๋ยวก็รู้เองแหละ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100318,
					"content": "นักเล่นแร่แปรธาตุก็ต้องตีดาบด้วยเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100319
					]
				},
				{
					"id": 412100307,
					"content": "Sucrose บอกว่าคุณมีความลับที่ไม่สามารถบอกใครได้อยู่",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100308
					]
				}
			]
		},
