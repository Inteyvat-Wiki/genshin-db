						740360103
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360102,
					"content": "Iaune?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360104
					]
				},
				{
					"id": 740360104,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360105
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360105,
					"content": "Iaune!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360106
					]
				},
				{
					"id": 740360106,
					"content": "อ๊า!? ทำไมเหรอ! ฉันเขียนเสร็จแล้ว ฉันเขียนเสร็จแล้วล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360107
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360107,
					"content": "ฉันเองแหละ เธอเขียนเสร็จแล้วเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360108
					]
				},
				{
					"id": 740360108,
					"content": "เธอเองเหรอ เมื่อกี้ฉัน... เมื่อกี้ฉันต้องหลับไปแน่ ๆ ขอโทษนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360109
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360109,
					"content": "คุณ Roialte กับคุณ Semaine มาอยู่เป็นเพื่อนฉันครึ่งคืน จากคำชี้แนะของพวกเขา ในที่สุดฉันก็ปั่นจดหมายเสนอแนะฉบับนั้นออกมาจนได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360110
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360110,
					"content": "แต่ฉันเหนื่อยเกินไป ก็เลยหลับตาและกะว่าจะพักผ่อนแป๊บนึง แต่คิดไม่ถึงเลยว่าจะหลับจนถึงตอนนี้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360111
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360111,
					"content": "ฉันต้องไปหาคุณ Thales ก่อน เพื่อประทับตรากรมกิจการทั่วไปลงบนจดหมายเสนอแนะฉบับนี้ แล้วก็เอาไปให้คุณ Difor ประทับตรา จากนั้นก็เผยแพร่อย่างเป็นทางการ... เท่านี้ก็เสร็จเรื่องแล้วล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360112,
						740360113
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360112,
					"content": "ฟังดูง่ายดีนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360114
					]
				},
				{
					"id": 740360114,
					"content": "ไม่ใช่เลยสักนิด อีกอย่างฉันได้ยินมาว่าคุณ Thales ได้เอาเครื่องประทับตราแบบใหม่มาใช้เครื่องนึง เครื่องประทับตรานี้ทั้งสะดวกและรักษาความลับได้ พวกเขาเตรียมที่จะเอามันมาใช้ในกรมกิจการทั่วไป",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360115
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360115,
					"content": "ดูสิ คุณ Roialte ยังมอบกุญแจให้ฉันดอกนึงด้วยนะ แต่ละแผนกต้องใช้กุญแจนี้เพื่อเปิดใช้งานเครื่องประทับตรา... พูดได้ว่า มันฟังดูเป็นทางการมากเลยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360116
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360116,
					"content": "ถ้างั้น ทำไมเธอไม่งีบสักหน่อยล่ะ? รู้สึกว่าเธอเดินแทบจะไม่ไหวแล้วนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740360117,
					"content": "ตอนนี้ก็เหลือแค่ไปประทับตราเอง แถมยังมี... เครื่องประทับตราอะไรนั่นอีก แบบนี้ก็ไม่ต้องรีบร้อนแล้วนี่นา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740360118,
					"content": "ไม่ได้หรอก จะเสียเวลาไม่ได้ เรารีบออกเดินทางกันเถอะ แค่ประทับตราน่าจะใช้เวลาไม่มาก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360113,
					"content": "อย่างน้อยมันก็ไม่ซับซ้อนเหมือนก่อนหน้านี้",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360114
					]
				},
				{
					"id": 740360103,
					"content": "เธอ... เขียนเสร็จรึยัง?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360104
					]
				}
			]
		},
