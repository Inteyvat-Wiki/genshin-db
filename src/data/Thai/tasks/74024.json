					"nextDialogs": [
						740240507
					]
				},
				{
					"id": 740240507,
					"content": "เธอไม่ต้องไปเชียร์ตามเลยนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240508
