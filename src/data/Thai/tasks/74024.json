						740240301
					]
				},
				{
					"id": 740240301,
					"content": "ไม่ว่ายังไง ต้องขอบคุณทั้งสองท่านมากที่ช่วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240302
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240302,
					"content": "#แต่ว่าท่าน {NICKNAME} ฉันจะเอาของของคุณไปตามใจชอบไม่ได้หรอก แค่บอกชื่อของวัสดุมาก็พอ แล้วฉันจะตามหามันเองทีหลัง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240303
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240303,
					"content": "แต่จะว่าไปแล้ว สีแบบนี้มันจะเข้มข้นเกินไปรึเปล่านะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240304
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240304,
					"content": "\"สีของดวงอาทิตย์\" มันน่าจะดูอ่อนกว่านี้หน่อย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240305
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240305,
					"content": "อ่อนกว่านี้ เธอหมายถึงให้สีออกขาวกว่านี้เหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240306,
					"content": "พอพูดอย่างงี้ ถ้าเทียบแล้ว \"ดวงอาทิตย์\" มันก็ดูใกล้เคียงกับ \"สีขาว\" มากกว่า \"สีทอง\" จริง ๆ ด้วยแฮะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240307,
					"content": "\"สีขาว\"... งั้นเหรอ? แต่ฉันก็ไม่รู้ว่าต้องใช้วัสดุอะไรดี ถึงจะทำให้สีมันอ่อนลงได้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240308,
						740240311
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240308,
					"content": "เราผสมน้ำเข้าไปเลยไม่ได้เหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240309
					]
				},
				{
					"id": 740240309,
					"content": "ถ้าผสมน้ำละก็... ฉันเคยลองแล้วนะ แต่ได้ผลไม่ค่อยดีน่ะ สีที่ทำด้วยวิธีนี้จะออกสีหม่น ๆ มันไม่มีความเจิดจ้าเหมือนแสงอาทิตย์...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240310
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240310,
					"content": "เพราะงั้น ถ้าเป็นไปได้ ฉันหวังว่าเราจะใช้วัสดุอื่นเข้ามาช่วยได้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240314
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240314,
					"content": "แต่ว่าสิ่งของที่ดูเจิดจ้าและมีสีขาว พวกเราน่าจะเคยเห็นอยู่บ่อย ๆ เหมือนกันนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240311,
					"content": "ในเมื่อเป็นแบบนี้ งั้นใช้เส้นผมของ Paimon มั้ย...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240312
					]
				},
				{
					"id": 740240312,
					"content": "จะเอาเส้นผมมาทำเป็นสีได้ยังไงกันเล่า!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240313,
					"content": "ไม่สิ ต่อให้เอามาทำได้จริง ๆ แต่จะมาถอนผมฉันมั่วซั่วไม่ได้มั้ย?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240314
					],
					"speakerTitle": "Paimon"
				}
			]
