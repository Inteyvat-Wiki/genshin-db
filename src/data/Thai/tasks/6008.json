						"position": [
							2143.145,
							109.201,
							11210.94
						],
						"pointId": 11739
					}
				]
			},
			"dialogs": [
				{
					"id": 60080401,
					"content": "หืม? เธอพูดว่าอะไรนะ ช่วยพูดอีกทีได้มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080402
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080402,
					"content": "หา? หมายถึง... เอ่อ อดีตเพื่อนร่วมงานของเธอน่ะเหรอ? ตอนนั้น Marionette อยู่ด้วยกันกับเราที่หาดทรายดาวน่ะ ดูเหมือนเธอจะถูก \"การล่าอันบ้าคลั่ง\" จัดการจนอ่วมล่ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080403,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080404
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080404,
					"content": "เอ่อ... เมื่อกี้เธอหัวเราะงั้นเหรอ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080405,
					"content": "...เปล่าเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080406
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080406,
					"content": "(เมื่อกี้เธอหัวเราะแน่ ๆ!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080407,
					"content": "เธอกับ Marionette ไม่ค่อยถูกกันเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080408,
					"content": "เปล่าหรอก แค่นึกถึงตอนเธอคนนั้นทำหน้าไม่พอใจขึ้นมาได้ ก็เลยรู้สึกว่ามันตลกน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080409
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080409,
					"content": "สีหน้าเธอตอนนั้นดูผิดหวังมากเลยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080410,
					"content": "ก็แค่แป๊บเดียวเท่านั้นแหละ Marionette เป็นคนปรับตัวเก่งจะตาย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080411
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080411,
					"content": "เผลอพูดนอกเรื่องไปไกลเลย ในเมื่อเรารู้แล้วว่า คนที่เพ่งเล็ง \"แก่นจันทรา\" อยู่อันตรายมากขนาดไหน เธอยังจะพกมันติดตัวอยู่อีกเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080412,
					"content": "ถ้าข้อมูลของพวก Fatui ไม่ผิดพลาดละก็ เวลาผู้ล่าจันทราเอาจริงขึ้นมา ต่อให้เป็นคนทั้งเมือง Nod-Krai รวมกันก็สู้กับเขาไม่ไหวหรอก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080413
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080413,
					"content": "เพียงแต่แค่ตอนนี้... อาจมีเหตุผลบางอย่างทำให้เขาทำแบบนั้นไม่ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080414
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080414,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080415
					]
				},
				{
					"id": 60080415,
					"content": "ก่อนฉันจะตัดสินใจ ฉันมีเรื่องอยากจะรบกวน Columbina หน่อย",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080416
					]
				},
				{
					"id": 60080416,
					"content": "เรื่องอะไรเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080417
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080417,
					"content": "#ไม่รู้ว่าเธอพอจะช่วยให้ฉันเห็นภาพเหตุการณ์ ตอนยานของฉันกับ{M#น้องสาว}{F#พี่}ลงจอดใน Nod-Krai ได้มั้ย",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080418
					]
				},
				{
					"id": 60080418,
					"content": "ได้สิ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080419
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080419,
					"content": "ตอบตกลงเร็วจัง!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080420,
					"content": "ฉันเคยบอกไปแล้วว่า มันเป็นเพียงแค่การดึงแสงจันทร์มาเท่านั้น ไม่ใช่เรื่องยากอะไรเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080421
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080421,
					"content": "ยื่นมือมาสิ เตรียมตัวให้พร้อมนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080422
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080422,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080423
					]
				},
				{
					"id": 60080423,
					"content": "(เหมือนกับที่เคยเห็นก่อนหน้านี้ เพียงแต่ชัดเจนกว่าเดิม...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080424
					]
				},
				{
					"id": 60080424,
					"content": "(โชคดีที่ตอนนั้นลงจอดฉุกเฉินอย่างปลอดภัย...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080425
					]
				},
				{
					"id": 60080425,
					"content": "(...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080426
					]
				},
				{
					"id": 60080426,
					"content": "(เหมือนจะผ่านมานานแล้ว...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080427
					]
				},
				{
					"id": 60080427,
					"content": "#({M#Lumine }{F#พี่}กับฉันน่าจะยังอยู่ข้างใน ไม่คิดเลยว่าเราจะอยู่ในยานอวกาศกันมานานขนาดนี้{M# Lumine }{F# พี่}ออกไปตั้งแต่ตอนไหนกันนะ?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080428
					]
				},
				{
					"id": 60080428,
					"content": "#(เอ๋?! นั่น...{M# Lumine }{F# พี่}ไม่ใช่เหรอ?!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080429
					]
				},
				{
					"id": 60080429,
					"content": "(ทำไมล่ะ... หลังจากยานลงจอดฉุกเฉินแล้ว ก็ไม่เห็นมีใครออกจากยานมาเลย! ประตูยานก็ยังถูกปิดสนิท ไม่ได้ถูกเปิดออกมาเลย!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080430
					]
				},
				{
					"id": 60080430,
					"content": "ที่นี่คือ... ที่ไหน?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080431
					]
				},
				{
					"id": 60080431,
					"content": "#{M#พี่}{F#Lumine}! เร็วเข้า พวกเราต้องรีบออกไปจากที่นี่!",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						60080432
					]
				},
				{
					"id": 60080432,
					"content": "...หา?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080433
					]
				},
				{
					"id": 60080433,
					"content": "มะ...ไม่เป็นอะไรใช่มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080434
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080434,
					"content": "หลังจากยานอวกาศของเรา... ลงจอดฉุกเฉินมาพักใหญ่ ๆ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080435
					]
				},
				{
					"id": 60080435,
					"content": "#ก็ไม่เห็นมีใครออกจากยานมาเลย แต่{M# Lumine}{F#พี่}... กลับอยู่ข้างนอกยานและหาฉันเจอ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080436
					]
				},
				{
					"id": 60080436,
					"content": "เอ๊ะ?! มะ...มันจะเป็นไปได้ยังไง!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080437,
					"content": "ฉันก็ไม่รู้...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080438
					]
				},
				{
					"id": 60080438,
					"content": "ความลับที่ซ่อนอยู่ในภาพความทรงจำพวกนั้น ก็เหมือนกับคุกกี้เลย เพียงกัดไปแค่คำเดียว มันก็กระจัดกระจายไปทั่ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080439
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080439,
					"content": "(เรื่องนี้... มันแปลกมาก ๆ ฉันต้องสืบหาความจริงให้เจอ)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080440
					]
				},
				{
					"id": 60080440,
					"content": "(แต่ก็อย่างที่ Nefer บอก ถ้า Nod-Krai ถูกทำลายล้างด้วยภัยพิบัติก่อนหน้านี้ งั้นก็คงไม่มีทางสืบหาความจริงได้แล้ว...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080441
					]
				},
				{
					"id": 60080441,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080442
					]
				},
				{
					"id": 60080442,
					"content": "เรื่อง \"แก่นจันทรา\" ยกให้ฉันจัดการเอง",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080443
					]
				},
				{
					"id": 60080443,
					"content": "อะ เอ๋? เอ่อ... ก็ได้ ในเมื่อเธอพูดอย่างนั้น แต่ว่าของสิ่งนี้... เอ่อ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080444
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080444,
					"content": "อยากให้ฉันช่วยมั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080445
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080445,
					"content": "เธอหมายถึงเรื่องอะไรเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080446
					]
				},
				{
					"id": 60080446,
					"content": "ฉันช่วยพวกเธอซ่อน \"แก่นจันทรา\" ได้นะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080447
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080447,
					"content": "จริงเหรอ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080448
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080448,
					"content": "ที่จริงตอนอยู่ในตัวเธอ มันก็ไม่ได้โดนตรวจจับง่าย ๆ อยู่แล้ว ฉันสอนวิธีการใช้แรงจันทราผันได้นะ มันจะช่วยซ่อนกลิ่นอายของ \"แก่นจันทรา\" ได้ดีขึ้น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080449
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080449,
					"content": "อย่างเช่นแบบนี้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080450
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080450,
					"content": "อ๋อ! เหมือนกับโล่เลย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080451
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080451,
					"content": "(นี่มัน... เป็นความรู้สึกที่อ่อนโยนจัง... รู้สึกเหมือนกับแสงจันทร์เลย...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080452
					]
				},
				{
					"id": 60080452,
					"content": "รู้สึกได้มั้ย? ทีนี้พยายามคงสภาพมันเอาไว้นะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080453
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080453,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080454
					]
				},
				{
					"id": 60080454,
					"content": "เธอหัวไวมาก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080455
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080455,
					"content": "ดูเหมือนจะแข็งแรงอยู่นะ มันน่าจะเอาไปใช้ป้องกันตัวในเวลาคับขันได้ด้วยนะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080456
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080456,
					"content": "ขอบคุณที่สอนฉันนะ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080457
					]
				},
				{
					"id": 60080457,
					"content": "ปกติ Columbina อยู่ที่นี่ตลอดเลยเหรอ? ไม่ออกไปเดินเล่นข้างนอกบ้างเลย? ถึงการออกไปเดินเล่นตอนนี้ จะอันตรายอยู่บ้างก็เถอะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080458
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080458,
					"content": "เอ่อ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080459
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080459,
					"content": "ฉันไม่ชอบสุงสิงกับคนแปลกหน้าน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080460
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080460,
					"content": "นี่เราเป็น \"คนรู้จัก\" กันแล้วเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080461
					]
				},
				{
					"id": 60080461,
					"content": "ก็ดีกว่าคนแปลกหน้านิดหน่อยแหละ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080462,
						60080463
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080462,
					"content": "ไว้เรื่อง \"การล่าอันบ้าคลั่ง\" จบลงแล้ว...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080464
					]
				},
				{
					"id": 60080464,
					"content": "จริงสิ ตอนนี้ \"ลูกหลานจันทราน้ำค้างแข็ง\" ไม่เหมือนกับแต่ก่อนแล้ว ไม่แน่เธออาจจะชอบก็ได้นะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080465
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080465,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080466
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080466,
					"content": "ฉันจะลองเอาไปคิดดู...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080467
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080467,
					"content": "เธอดูเหนื่อย ๆ นะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080468
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080468,
					"content": "คงนานมากแล้วสินะ ที่ไม่ได้พูดเยอะแบบนี้...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080469
					]
				},
				{
					"id": 60080469,
					"content": "เอาเป็นว่า ขอบคุณเธอมากนะ ที่ช่วยเหลือพวกเรา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080470
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080470,
					"content": "...ไม่ได้หนักหนาอะไรเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080471
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080471,
					"content": "ดอกไม้ที่นี่ ชอบแขกแบบพวกเธอ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080463,
					"content": "เราไปเดินเล่นด้วยกันนะ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080464
					]
				}
			]
		}
	]
}