			"dialogs": [
				{
					"id": 230280501,
					"content": "พี่ Yasmin! อ๊ากกก!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280502
					]
				},
				{
					"id": 230280502,
					"content": "ผะ ผมใกล้จะหายใจไม่ออกแล้ว พวกเรารีบไปจากที่นี่กันเถอะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280503
					]
				},
				{
					"id": 230280503,
					"content": "นี่คืออะไร... แค่ก แค่กแค่ก! กลิ่นอะไรล่ะเนี่ย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230280504,
					"content": "ดูเหมือน Ladep จะทำงานได้ไม่เลวเลยนะเนี่ย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280505
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280505,
					"content": "ตรงนี้พ่นเสร็จเรียบร้อยแล้ว พวกเราไปสถานที่แห่งต่อไปกันเถอะ ใกล้ ๆ แถวนี้แหละ ไม่ไกลหรอก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasmin"
				}
			]
		}
