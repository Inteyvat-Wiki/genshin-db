					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240907,
					"content": "สู้ ๆ นะ!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240910
					]
				},
				{
					"id": 742240910,
					"content": "งั้นฉันต้องรีบกลับไปศึกษาโน้ตเพลงแผ่นนี้แล้วล่ะ",
