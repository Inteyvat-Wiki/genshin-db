				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tailleferre"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742240201,
					"content": "เอ๋? นี่ พี่ Tailleferre ไม่ใช่เหรอ? ไม่คิดเลยว่าจะได้เจอกันอีก!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240202,
					"content": "อ๊ะ พวกเธอเองเหรอ นักผจญภัยกับผู้ช่วยตัวน้อย ครั้งก่อนลืมถามชื่อของพวกเธอไปเลย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240203
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240203,
					"content": "#ฉันชื่อ Paimon ส่วนนี่ชื่อ {NICKNAME} ครั้งที่แล้วต้องขอบคุณพี่มากนะ พวกเราเลยใช้ \"พิณหอยสังข์\" เล่นโน้ตเพลงโบราณได้สำเร็จ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240204,
					"content": "ว่าแต่ทำไมพี่ Tailleferre ถึงมาที่เมือง Petrichor ได้ล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240205,
					"content": "ฉันก็อยากจะถามพวกเธอเหมือนกัน พอฉันได้ยินข่าวลือก็รีบมาทันทีเลย แต่ในเมื่อพวกเธอเป็นนักผจญภัย ก็เป็นเรื่องธรรมดาที่พวกเธอจะมาถึงก่อน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240206
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240206,
					"content": "ข่าวลือ พี่พูดถึงข่าวลืออะไรน่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240207,
					"content": "ก็ข่าวใหญ่ในช่วงนี้ของเมือง Petrichor ไง มันก็มีแต่เรื่องนั้นไม่ใช่เหรอ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240208,
						742240209
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240208,
					"content": "เรื่องที่พวกเราบังเอิญกอบกู้โลกเอาไว้เหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240210
					]
				},
				{
					"id": 742240210,
					"content": "หือ? พูดอะไรของเธอน่ะ แน่นอนว่าเป็นเรื่องที่ปราสาทที่ซีดจางในตำนานถูกค้นพบอีกครั้งน่ะสิ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240211
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240211,
					"content": "ครั้งสุดท้ายที่มีบันทึกเกี่ยวกับปราสาทที่ซีดจางก็เมื่อหลายร้อยปีก่อนแหนะ ฉันนึกว่าพวกเธอมาเพราะเรื่องนี้ซะอีก!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240212
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240212,
					"content": "เรื่องนี้น่ะเหรอ ถึงมันจะเกี่ยวกับพวกเราอยู่บางส่วนก็เถอะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240213,
					"content": "พวกเธอน่าจะรู้ใช่มั้ย? ปราสาทที่ซีดจางเคยเป็นของ Boethius นักดนตรีที่สำคัญที่สุดในประวัติศาสตร์ของ Fontaine",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240214
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240214,
					"content": "ไม่ว่าจะเป็นละครที่ Boethius แต่งขึ้น หรือว่าโน้ตเพลงโบราณของ Remuria ที่เขาเรียบเรียงขึ้น ล้วนแต่มีบทบาทพิเศษในประวัติศาสตร์ของดนตรี",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240215
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240215,
					"content": "เนื่องจากเป็นปราสาทที่เขาเคยอาศัยอยู่ เพราะงั้นจะต้องมีข้อมูลที่ถูกเก็บรักษาเอาไว้ที่นี่มากมายแน่ ๆ นี่เป็นเอกสารที่สำคัญมากสำหรับสมาคมนักดนตรีของพวกเรา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240216
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240216,
					"content": "เพราะงั้นพอได้ยินข่าวนี้ ฉันก็รีบวิ่งมาที่นี่ เพื่อเก็บเอกสารสำคัญเอาไว้ก่อนที่นักผจญภัยคนอื่นจะมาถึง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240217
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240217,
					"content": "คิดไม่ถึงเลยว่าพวกเธอจะนำหน้าอยู่หนึ่งก้าว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240218
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240218,
					"content": "(ทำยังไงดี? ต้องบอกเธอมั้ย ว่า Boethius คนนั้นเป็นคนเลว แถมยังใช้ดนตรีพวกนั้นทำเรื่องเลวร้ายอีกเพียบเลย...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240219,
					"content": "(ถ้าเธอรู้ความจริง คงจะไม่เสียใจใช่มั้ย...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240220,
						742240221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240220,
					"content": "\"บทเพลง\" ทำเรื่องไม่ดีไม่ได้แล้วล่ะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240222
					]
				},
				{
					"id": 742240222,
					"content": "หืม? พวกเธอแอบซุบซิบอะไรกันอยู่น่ะ คงไม่ใช่ว่าพวกเธอเจอโน้ตเพลงโบราณอะไรแล้วหรอกใช่มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240223
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240223,
					"content": "เอ่อ สมมติว่า... ฉันแค่สมมตินะว่า ถ้า Boethius เป็นคนเลวร้ายมาก ๆ พวกเธอยังอยากจะได้โน้ตเพลงที่เขาทิ้งไว้อีกมั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240224,
					"content": "อืม... ถึงจะไม่รู้ว่าที่เธอพูดว่าเลวร้ายมาก ๆ หมายความว่ายังไง แต่นอกจากด้านดนตรีแล้ว Boethius ในประวัติศาสตร์ก็ไม่ได้มีชื่อเสียงดีอะไรหรอกนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240225
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240225,
					"content": "จากละครเพลงสุดโรแมนติกเรื่อง \"คนต่างแดนพเนจร\" ของเขา เขาก็ไม่เคยล้มเลิกการสร้าง Remuria ขึ้นมาใหม่อีกครั้ง จนกระทั่งเขาเสียชีวิต เพราะเหตุนี้จึงมอง Fontaine ที่ถือกำเนิดขึ้นใหม่เป็นศัตรู",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240226
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240226,
					"content": "และตามที่นักประวัติศาสตร์ว่าไว้ สงครามที่เกิดขึ้นตอนที่ Fontaine เพิ่งก่อตั้งก็เกี่ยวข้องกับเขาด้วย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240227
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240227,
					"content": "แต่ความสำเร็จทางด้านดนตรีก็เป็นอีกเรื่องนึง ต่อให้ดนตรีที่เขาสร้างนั้นจะมีประวัติที่ผิดพลาด แต่ก็ไม่สามารถปฏิเสธคุณค่าทางศิลปะของพวกมันได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240228
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240228,
					"content": "ในความคิดของฉัน นี่ก็เป็นส่วนหนึ่งของประวัติศาสตร์อยู่แล้ว แม้แต่ศิลปะที่บริสุทธิ์ก็ยังสามารถนำมาใช้ทำเรื่องเลวร้ายได้ ในฐานะนักดนตรีก็ต้องคำนึงถึงข้อนี้ไว้ให้ขึ้นใจด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240229,
						742240231
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240229,
					"content": "ถ้าเป็นเธอล่ะก็ คงไม่ใช้มันทำเรื่องไม่ดีหรอก",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240230
					]
				},
				{
					"id": 742240230,
					"content": "ฮ่าฮ่า ฉันเป็นแค่นักวิจัยเท่านั้น การได้ฟังบทเพลงโบราณพวกนี้ ถือเป็นความปรารถนาสูงสุดของฉันแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240233
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240233,
					"content": "จะว่าไปแล้ว ในเมื่อบังเอิญเจอพวกเธอแล้ว งั้นพวกเธอช่วยฉันสักเรื่องได้มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240234
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240234,
					"content": "ถือซะว่าเป็นการตอบแทนที่ฉันช่วยพวกเธอครั้งก่อนก็แล้วกัน!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240235,
						742240237,
						742240239
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240235,
					"content": "ครั้งก่อนเธอบอกว่า ไม่เอาค่าตอบแทนไม่ใช่เหรอ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240236
					]
				},
				{
					"id": 742240236,
					"content": "ฮิฮิ งั้นก็ถือซะว่าช่วยฉันหน่อยละกันน่า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240240
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240240,
					"content": "สรุปก็คือ ก็อย่างที่บอกไปเมื่อกี้ ที่ฉันมาที่นี่ก็เพื่อตามหาโน้ตเพลงที่หายไปของละครชื่อดังเรื่อง \"คนต่างแดนพเนจร\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240241
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240241,
					"content": "ตามบันทึกที่คนที่ชื่อ Ruggiero ทิ้งไว้ เมื่อหลายร้อยปีก่อน มันน่าจะถูกซ่อนไว้ที่ไหนสักแห่งในปราสาทที่ซีดจาง จะดีมากเลยถ้าพวกเธอช่วยฉันตามหาอีกแรง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240242
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240242,
					"content": "ยังไงซะเรื่องสำรวจโบราณสถาน พวกเธอน่าจะเชี่ยวชาญมากกว่า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240243
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240243,
					"content": "#{NICKNAME} ในเมื่อเขาพูดขนาดนี้แล้ว งั้นเราก็ช่วยเขาเถอะ ยังไงโน้ตเพลงพวกนั้นก็คงไม่มี \"พลังแบบนั้น\" แล้วมั้ง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240244,
					"content": "อื้ม ๆ งั้นฉันจะถือว่าพวกเธอตกลงแล้วนะ เยี่ยมไปเลย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240245
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240245,
					"content": "งั้นก็รบกวนพวกเธอด้วยนะ ก่อนที่พวกเธอจะกลับมา ฉันจะรอข่าวดีอยู่ในเมืองนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240237,
					"content": "ฉันต้องเก็บค่าตอบแทนนะ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240238
					]
				},
				{
					"id": 742240238,
					"content": "แน่นอนว่าจะให้ค่าตอบแทนพวกเธอ สมาคมนักดนตรีของพวกเราไม่ใช่สมาคมที่ยากจนข้นแค้นอะไรหรอกนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240240
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240239,
					"content": "ฉันเดาไว้แล้วว่าต้องเป็นแบบนี้...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240240
					]
				},
				{
					"id": 742240231,
					"content": "เป็นการวิจารณ์ที่มีจริยธรรมจริง ๆ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240232
					]
				},
				{
					"id": 742240232,
					"content": "ฮิฮิ ก็แค่ความเห็นส่วนตัวของฉันน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240233
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240221,
					"content": "เรื่องนี้ถ้าจะอธิบายให้ชัดเจน ก็ออกจะยากอยู่นะ...",
