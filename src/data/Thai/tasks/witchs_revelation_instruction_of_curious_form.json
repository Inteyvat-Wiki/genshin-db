				]
			},
			"dialogs": [
				{
					"id": 746960101,
					"content": "นึกออกรึยัง? Qiqi",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960102
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960102,
					"content": "เอ่อ... ขอโทษนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960103
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960103,
					"content": "ไม่ต้องขอโทษหรอก ไม่เป็นไร ยังอีกสักพักกว่าจะถึงพระราชวัง Mermonia พวกเราเดินกันต่ออีกหน่อยเถอะ ไม่แน่อาจจะนึกออกก็ได้ว่าบ้านคุณอยู่ที่ไหน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960104
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960104,
					"content": "#{NICKNAME} ดูสิ นั่น Qiqi นี่นา! แถมยังมีเมลูซีนอีกคนด้วย เป็นการรวมตัวที่ไม่เคยเห็นมาก่อนเลยแฮะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960105,
					"content": "#อ๊ะ! {NICKNAME} แล้วก็... Pai...Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960106
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960106,
					"content": "สวัสดีทุกคน",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960107
					]
				},
				{
					"id": 746960107,
					"content": "คนรู้จักของ Qiqi ใช่รึเปล่า? ดีจังเลย ตอนที่ฉันกำลังสืบคดีอยู่แถวท่าเรือ Lumidouce ก็เจอกับเด็กหลงทางคนนี้เข้า... เธอเป็นเด็กใช่มั้ย? ดูจากรูปร่างแล้ว น่าจะเป็นมนุษย์เด็กนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960108
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960108,
					"content": "Qiqi เป็น... เป็น...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960109
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960109,
					"content": "เพื่อนรักของพวกเราเอง!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960110
					]
				},
				{
					"id": 746960110,
					"content": "ใช่ ๆ! พวกเรารู้จักกันมานานแล้วล่ะ เป็นเพื่อนสนิทกัน!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960111,
					"content": "โอ้โห! เธอหัวไวมากอะ ขืน Qiqi บอกว่าตัวเองเป็นซอมบี้ละก็ มีหวังทำให้เขาตกใจกลัวแหง ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960112,
					"content": "อืม... เพื่อนสนิท... ใช่แล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960113
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960113,
					"content": "ในที่สุดก็ได้เบาะแสสักที บอกตามตรง ฉันเองก็เพิ่งเคยเจอสถานการณ์ ที่จนปัญญาแบบนี้เป็นครั้งแรกเหมือนกัน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960114
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960114,
					"content": "งั้นพวกคุณก็น่าจะรู้สินะว่า ดูเหมือนความทรงจำของเธอ จะมีปัญหานิดหน่อย นอกจากชื่อแล้ว เธอก็แทบจะนึกอะไรอย่างอื่นไม่ออกเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960115
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960115,
					"content": "บางที Qiqi เขาก็เป็นแบบนี้แหละ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960116,
					"content": "ช่างเป็นเด็กที่น่าสงสารจริง ๆ ตอนแรกฉันตั้งใจจะพาเธอไปพักที่หน่วยล่าเงาก่อน แล้วระหว่างทางก็คอยดูไปด้วยเลยว่า เธอพอจะฟื้นความทรงจำกลับมาได้บ้างรึเปล่า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960117
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960117,
					"content": "ในเมื่อพวกคุณเป็นเพื่อนสนิทกัน พวกคุณรู้มั้ยว่าบ้านของเธออยู่ที่ไหน? ฉันพาเธอไปส่งที่บ้านเลยก็ได้ แบบนี้จะได้ช่วยลดความยุ่งยากไปได้เยอะเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960118
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960118,
					"content": "ก็รู้อยู่หรอก... เอ่อ แต่มันไกลจากที่นี่เกินไปหน่อยน่ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960119,
					"content": "ไกล... ไป...? Qiqi เดินตาม Seelie มาไกลมาก จนถึงท่าเรือ Lumidouce...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960120
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960120,
					"content": "เอ๋? นึกออกแล้วเหรอ? แล้วเรื่องก่อนหน้านั้นล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960121
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960121,
					"content": "ก่อนหน้านี้... คุณ Bai พา Qiqi ออกไปตรวจคนไข้ที่ Yi... เอ่อ Yi อะไรนะ? Qiqi ไปเก็บสมุนไพร จากนั้นก็...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960122
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960122,
					"content": "อ๋อ! ท่าเรือ Yilong สินะ! ยอดนักสืบ Paimon รู้แล้วล่ะว่าเกิดอะไรขึ้น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960123,
					"content": "Baizhu พา Qiqi ไปตรวจคนไข้ที่ท่าเรือ Yilong ด้วยกัน ตอนที่ Qiqi กำลังเก็บสมุนไพรอยู่แถวนั้นก็ดันหลงทาง บังเอิญไปเจอ Seelie เข้าก็เลยเดินตามมาจนถึงท่าเรือ Lumidouce",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960124,
					"content": "#หึหึ ยังดีนะที่ฉันกับ {NICKNAME} เคยอ่าน \"จอมโจรและยอดนักสืบ\" ด้วยกัน ข้อสันนิษฐานง่าย ๆ แค่นี้ไม่คณามือฉันหรอก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960125,
					"content": "ความจริงแล้วเรื่องนั้นเป็นเรื่องที่แต่งขึ้นมา หมดเลยไม่ใช่รึไง...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960126
					]
				},
				{
					"id": 746960126,
					"content": "โอ้ว! ก็สมเหตุสมผลอยู่นะ งั้นฉันจะรีบพา Qiqi กลับไปที่ท่าเรือ Yilong เดี๋ยวนี้เลย คุณ Baizhu เป็นผู้ปกครองของ Qiqi ใช่มั้ย? เขาต้องร้อนใจจะแย่แล้วแน่ ๆ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960127,
						746960128
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960127,
					"content": "เดี๋ยวนะ ในบรรดาคนที่คุณ Barbeloth กำลังรออยู่...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960129
					]
				},
				{
					"id": 746960129,
					"content": "จริงด้วย! เกือบจะลืมเรื่องนี้ไปซะสนิทเลย คุณ Barbeloth... อยู่รึเปล่า? ได้ยินมั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960130,
					"content": "ไม่ต้องตะโกนดังขนาดนั้นก็ได้ ฉันอยู่ตรงนี้ตลอด แค่ไม่อยากขัดจังหวะการสนทนาของพวกเธอเท่านั้นเอง เพราะการรับฟังคือสัญชาตญาณของนักพยากรณ์ที่ดี",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960131
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960131,
					"content": "สิ่งที่เรียกว่าการนำทางของ Seelie ก็นับว่าเป็นการชี้นำของโชคชะตาอย่างหนึ่งเหมือนกัน หึหึ ... ในเมื่อมาถึงที่นี่แล้ว ลอง \"ทำนาย\" กันดูสักหน่อยดีมั้ย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960132
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960132,
					"content": "ทำ...นาย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960133
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960133,
					"content": "อุ๊ยตาย ขอขัดจังหวะหน่อยนะ Barbie ท่าทีเป็นการเป็นงานแบบนี้ของเธอ จะทำให้เด็ก ๆ ตกใจเอารึเปล่า?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960134
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960134,
					"content": "เธอหลบไปก่อน ดูให้ดีนะ ต้องมอบของขวัญเซอร์ไพรส์เล็ก ๆ ให้เขาแบบฉันนี่ถึงจะถูก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960135
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960135,
					"content": "อะแฮ่ม หนู Qiqi สมาชิกสมาคมแม่มดน้อยจ๊ะ ฉันคือแม่ของ Klee พันธมิตรของหนูเอง คุณน้า Alice แม่มดผู้ยิ่งใหญ่ที่ยอดเยี่ยมที่สุดในโลกนี้ยังไงล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960136
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960136,
					"content": "สวัสดีคุณน้า Alice...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960137
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960137,
					"content": "ช่างเป็นเด็กดีที่น่ารักและมีมารยาทจริง ๆ มานี่สิ มาให้แม่มดผู้ยิ่งใหญ่ จัดพิธีทำนายสุดเซอร์ไพรส์ให้แม่มดน้อยดีกว่า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960138
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960138,
					"content": "พิธี...ทำนาย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960139
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960139,
					"content": "ใช่แล้ว! ลองดูไพ่ตรงหน้าหนูสิ สวยมั้ย? ชอบรึเปล่า?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960140
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960140,
					"content": "ชอบ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960141
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960141,
					"content": "ชอบก็ดีแล้ว งั้นก็หยิบมาใบนึงนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960142
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960142,
					"content": "อืม... ใบนี้ ได้มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960143
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960143,
					"content": "ได้อยู่แล้วสิ ถือเป็นรางวัลที่หนูให้ความร่วมมือเป็นอย่างดี ไพ่ในมือหนูก็ยกให้หนูไปเลย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960144
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960144,
					"content": "...ขอบคุณ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960145
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960145,
					"content": "เอาล่ะ Barbie หมดเวลาพักของเธอแล้ว ได้เวลามาช่วยหนูน้อย Qiqi ตีความแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960146
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960146,
					"content": "ไม่ต้องมาเขย่าไหล่ฉันเลย... ฉันก็ดูอยู่นี่ไง อ๋า ได้ไพ่ Hanged Man หัวตั้ง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960147
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960147,
					"content": "คนที่จั่วได้ไพ่ใบนี้มีไม่เยอะหรอกนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960148
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960148,
					"content": "นั่นก็หมายความว่าหนูพิเศษมากเลยยังไงล่ะ Qiqi",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960149
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960149,
					"content": "มันเป็นสัญลักษณ์ของการก้าวข้ามและการรอคอย และยังหมายถึงการหลุดพ้นจากเรื่องทางโลกอีกด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960150
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960150,
					"content": "หนูอยู่ภายใต้ข้อจำกัดบางอย่าง แต่ตัวหนูเองกลับไม่ได้อยากดิ้นรน เพื่อให้หลุดพ้นจากข้อจำกัดนี้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960151
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960151,
					"content": "ข้อจำกัด... หมายถึงคำสั่งเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960152
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960152,
					"content": "ถ้ามองแค่ผิวเผิน หนูจะเข้าใจแบบนั้นก็ไม่ผิดหรอก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960153
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960153,
					"content": "สำหรับเรื่องอนาคต หนูแค่รอต่อไปก็พอ แน่นอนว่าสำหรับหนูแล้ว สิ่งที่หนูไม่ขาดเลยก็คงจะเป็นเวลา แต่ว่า... โอ๊ะ แปลกจัง แปลกจริง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960154
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960154,
					"content": "เอาล่ะ ๆ พอแค่นี้แหละ! ขืนพูดรวดเดียวเยอะขนาดนี้ จะเป็นการเพิ่มภาระให้เด็ก ๆ เอานะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960155
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960155,
					"content": "ให้หนู Qiqi ลองสัมผัสของขวัญในมือชิ้นนี้ให้ดีก่อนเถอะ เธอต้องใจเย็นกับเด็กหน่อย ให้เวลาเขาเพิ่มอีกนิด",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960156
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960156,
					"content": "เป็นยังไงบ้าง หนู Qiqi ชอบเซอร์ไพรส์เล็ก ๆ นี้มั้ยจ๊ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960157
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960157,
					"content": "ไพ่ สวยจัง... ขอบคุณนะคุณน้า Alice",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960158
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960158,
					"content": "แหม เป็นเด็กดีจังน้า พยายามจำชื่อคุณน้าด้วย ถึงน้าจะยังอยากคุยกับหนูต่ออีกหน่อย แต่ก็ได้เวลาที่เด็กดีต้องกลับบ้านได้แล้วนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960159
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960159,
					"content": "ถ้าคุณน้า Barbie ยังมีเรื่องที่อยากพูดอีกละก็ ไว้คราวหน้า ตอนที่สมาชิกสมาคมแม่มดน้อยมารวมตัวกันอีกครั้ง ค่อยทำนายให้แม่มดน้อยแต่ละคนก็แล้วกัน! ทุกคนจะต้องดีใจมากแน่ ๆ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960160
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960160,
					"content": "...อย่ามาเพิ่มภาระงานให้ฉันตามใจชอบจะได้มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960161
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960161,
					"content": "งั้นก็ตกลงตามนี้นะ! ไว้เจอกันใหม่นะ หนูน้อย Qiqi และพยานทุกท่าน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960162
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960162,
					"content": "ลาก่อน... คุณน้า Alice และเพื่อนสนิทของ... คุณน้า Alice",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960163
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960163,
					"content": "เฮ้อ... นี่คือจบเรื่องแล้วใช่มั้ย? เสียงของสองคนเมื่อกี้ ดังมาจากในตุ๊กตาตัวนี้เหรอ? นี่เป็นของเล่นรูปแบบใหม่อะไรกันน่ะ น่ารักจัง หาซื้อได้ที่ไหนเหรอ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960164
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960164,
					"content": "อ๊ะ! ไม่สิ ๆ ตอนนี้ไม่ใช่เวลามาคิดเรื่องพวกนี้ Qiqi พวกเราไปหาคุณผู้ชายที่ชื่อ Baizhu กันก่อนเถอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960165
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960165,
					"content": "#...อืม ถึงเวลาแล้ว Qiqi ต้องกลับแล้ว ไว้เจอกันใหม่... คราวหน้านะ {NICKNAME} กับ Paimon",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960166,
						746960167
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960166,
					"content": "เดินทางดี ๆ นะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960168
					]
				},
				{
					"id": 746960168,
					"content": "ไพ่... ของขวัญ อืม... สวย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960167,
					"content": "ระวังตัวด้วยนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960168
					]
				},
				{
					"id": 746960128,
					"content": "มี Qiqi อยู่ด้วยใช่มั้ย?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960129
					]
				}
			]
		},
