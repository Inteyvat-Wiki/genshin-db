				"points": []
			},
			"dialogs": [
				{
					"id": 710740401,
					"content": "หินโบราณจริง ๆ ด้วย ขอบคุณพวกเธอมากนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740402
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740402,
					"content": "ฉันตัดสินใจถูกจริง ๆ ที่มารบกวนพวกเธอ ถ้าส่งคำขอให้ทางกิลด์นักผจญภัยล่ะก็ พวกเขาคงไม่หาเจอเร็วขนาดนี้แน่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740403
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740403,
					"content": "ก็ไม่แน่หรอก บางทีทางกิลด์นักผจญภัยอาจจะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740404,
					"content": "มอบหมายคำขอให้กับพวกเราโดยตรงก็ได้",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740405
					]
				},
				{
					"id": 710740405,
					"content": "ก็จริง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740406
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740406,
					"content": "นักผจญภัย... อืม ... เมื่อก่อนฉันก็อิจฉานักผจญภัยเหล่านั้นเหมือนกันนะ วัน ๆ ถ้าไม่ขึ้นเหนือก็ลงใต้ ราวกับว่าไม่มีที่ไหนที่พวกเขาไม่กล้าไปเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740407
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740407,
					"content": "เหมือนกับฉันที่ถูกส่งมาทำงานที่ Chasm ตั้งหลายปี แต่กระทั่ง Cinnabar Cliff ที่อยู่บนยอดของ Chasm ก็ยังไม่เคยขึ้นไปเลยแม้แต่ครั้งเดียว...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740408
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740408,
					"content": "นายไม่เคยไปเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740409,
					"content": "จะว่ายังไงดี Cinnabar Cliff ก็เหมือนกับพวก \"สถานที่ท่องเที่ยวที่มีชื่อเสียง แต่คนในพื้นที่ไม่นิยมไป\" อะไรแบบนี้น่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740410
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740410,
					"content": "บางทีทุกคนอาจจะคิดว่ายังไงมันก็อยู่ใกล้ ๆ ไว้มีว่างค่อยหาเวลาไปเที่ยวดูสักหน่อยก็ได้... สุดท้ายก็ไม่ได้ไปเลยสักครั้ง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740411
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740411,
					"content": "งั้นไปตอนนี้เลยมั้ยล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740412,
					"content": "การคิดปุ๊บทำปั๊บก็เป็นสิ่งสำคัญเหมือนกันนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740413,
					"content": "ช่างเถอะ ๆ ตอนนี้ยังไม่ใช่ตอนฉัน \"ว่าง\" หรอกนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740414
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740414,
					"content": "ยิ่งไปกว่านั้น ธุระที่ต้องออกไปทำข้างนอกแบบนี้ ปล่อยให้นักผจญภัยเหล่านั้นจัดการจะดีกว่า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740415
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740415,
					"content": "ที่ที่พวกเขาไปล้วนเป็นสถานที่อันตรายทั้งนั้นเลย ถ้าฉันไปแล้วดันบาดเจ็บระหว่างทางขึ้นมาล่ะก็... คงจะแย่มากแน่ ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740416
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740416,
					"content": "ก็จริง การบาดเจ็บเป็นเรื่องที่ร้ายแรงมากทีเดียว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740417,
					"content": "ถ้าฉันบาดเจ็บขึ้นมา ทีมสำรวจที่อยู่ข้างล่างก็คงไม่มีใครดูแล และจะไม่มีใครรับผิดชอบตรวจสอบความปลอดภัยของคนงานเหมืองอีกด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740418
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740418,
					"content": "ถ้าเกิดอะไรขึ้น ก็คงจะกลายเป็นปัญหาร้ายแรงแน่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740419
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740419,
					"content": "ที่แท้ปัญหาก็อยู่ตรงนี้เหรอ... ฉันก็นึกว่า Muning กลัวจะบาดเจ็บซะอีก!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740420,
					"content": "สถานที่อันตรายอย่างพวกหน้าผาสูงที่ตั้งตระหง่านรอบ Chasm เอย หรือหุบเหวที่ลึกจนไม่เห็นก้นเหวเอย... ไหนจะยังมีสนามรบโบราณที่ท่านลอร์ดแห่งหินหลงเหลือไว้อีก...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740421
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740421,
					"content": "ฉันไม่อยากจะเข้าใกล้เลยสักนิด",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740422
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740422,
					"content": "เอาล่ะ นี่เป็นค่าตอบแทนหินโบราณสามชิ้นที่พวกเธอหาได้ แต่ Huishan Hall ยังอยากได้หินโบราณอีกมาก ถ้าพวกเธอเจออีกก็รวบรวมมาทีละสามก้อนนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740423
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740423,
					"content": "แน่นอนว่ามีค่าตอบแทนที่สมน้ำสมเนื้อให้อยู่แล้ว ถ้าเจอหินโบราณอีกอย่าลืมมาหาฉันนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740424
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740424,
					"content": "โอเค!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
