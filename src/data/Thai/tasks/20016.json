			"dialogs": [
				{
					"id": 200160101,
					"content": "ออเดอร์เดลิเวอรี่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160102
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160102,
					"content": "นักเดินทาง! มาพอดีเลย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160103
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160103,
					"content": "ขอโทษนะ ถึงเธอจะยังหิวอยู่ แต่ยังไงช่วยฉันหน่อยจะได้มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160104
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160104,
					"content": "ตอนนี้ออเดอร์เดลิเวอรี่มีเยอะมากขึ้นเรื่อย ๆ ปกติฉันจะแบ่งรายการสั่งไปตามพื้นที่ต่าง ๆ แล้วค่อยทำสัญลักษณ์ว่าใครสั่งบ้าง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160105
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160105,
					"content": "แต่ว่าสัญลักษณ์คนสั่งของรายการ <color=#00E1FFFF>Calla Lily Seafood Soup</color> จานนี้หายไปซะแล้ว รู้แค่ว่าคนสั่งอยู่ที่ Springvale",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160106
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160106,
					"content": "เธอช่วยฉันส่ง <color=#00E1FFFF>Calla Lily Seafood Soup</color> นี่ไปที่ Springvale หน่อยและหาว่าเป็นของใครได้มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160107,
						200160110
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160107,
					"content": "โอเค แต่ว่า...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200160108
					]
				},
				{
					"id": 200160108,
					"content": "รอเธอกลับมาแล้ว จะต้องจัดมื้อใหญ่ให้ซักมื้อแน่นอน!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160109
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160109,
					"content": "ช่วยหน่อยนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160110,
					"content": "หิวจังเลย ฉันแค่จะมาหาข้าวกินน่ะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200160111
					]
				},
				{
					"id": 200160111,
					"content": "รอเธอช่วยฉันเสร็จแล้ว ฉัน ฉันจะสั่งอาหารจานพิเศษของ Good Hunter ให้กับเธอ ยังไงช่วยหน่อยนะ!",
					"roleType": "TALK_ROLE_NPC",
