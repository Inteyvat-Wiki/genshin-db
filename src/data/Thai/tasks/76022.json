			},
			"dialogs": [
				{
					"id": 760220201,
					"content": "เฮ้! พี่เบิ้ม! ทำอะไรน่ะ! หยุดเดี๋ยวนี้นะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760220202,
					"content": "Mora... ไม่สิ ไม่ใช่! เจ้าคนที่ทำให้ Murasaki ต้องตาย... ตายซะเถอะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220203
					],
					"speakerTitle": "ซามูไรที่โมโห"
				},
				{
					"id": 760220203,
					"content": "#หวาาา! {NICKNAME} ระวัง!",
