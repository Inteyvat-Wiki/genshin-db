					"nextDialogs": [],
					"speakerTitle": "กระดานข้อความ"
				}
			]
		},
		{
			"id": 7320102,
			"completionStepIds": [
				7320102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320102",
							"2"
						],
						"stepId": 7320102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010201,
					"content": "\"อาทิตย์นี้จะเล่าตำนานของยอดฮีโร่ Antara ให้ทุกคนฟังกันต่อ!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010202
					],
					"speakerTitle": "กระดานข้อความ"
				},
				{
					"id": 732010202,
					"content": "\"นำเสนอโดย Maddah 'นักเล่าเรื่องรับเชิญพิเศษประจำร้าน Puspa Café' อย่าพลาดเชียวนะ!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010203
					],
					"speakerTitle": "กระดานข้อความ"
				},
				{
					"id": 732010203,
					"content": "คุณ Maddah... ร้านเราจะเสิร์ฟกาแฟให้คุณเพิ่มอีกหนึ่งแก้ว ถ้าคุณยอมเลิกโฆษณาที่นี่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "กระดานข้อความ"
				}
			]
		},
