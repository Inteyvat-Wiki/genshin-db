			"dialogs": [
				{
					"id": 732010301,
					"content": "\"ฮี่ฮี่ Gata ฮี่ฮี่\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010302
					],
					"speakerTitle": "กระดานข้อความ"
				},
				{
					"id": 732010302,
					"content": "Gata ดูเหมือนจะชอบคุณมากเลยนะ คุณ Nilou",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
