				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010401,
					"content": "\"Puspa Card Club เปิดรับสมัครสมาชิก 'เกมกลเจ็ดอัจฉริยะ' อย่างต่อเนื่อง!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010402
					],
					"speakerTitle": "กระดานข้อความ"
				},
				{
					"id": 732010402,
					"content": "\"ถ้าอยากพูดคุยแลกเปลี่ยนเทคนิคการสร้างชุดการ์ด มาหาฉันที่โต๊ะได้เลยนะ!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010403
					],
					"speakerTitle": "กระดานข้อความ"
				},
				{
					"id": 732010403,
					"content": "คุณ Nayab ถ้าอยากเล่นการ์ดในร้าน อย่างน้อยก็ช่วยสั่งกาแฟสักแก้วเถอะนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "กระดานข้อความ"
				}
			]
		},
		{
			"id": 7320105,
			"completionStepIds": [
				7320105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320105",
							"2"
						],
						"stepId": 7320105,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010501,
					"content": "\"พักนี้มีคดีลักลอบซื้อขายผลึกความรู้เกิดขึ้นติด ๆ กันหลายคดี\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010502
					],
					"speakerTitle": "กระดานข้อความ"
				},
				{
					"id": 732010502,
					"content": "\"คำเตือนพิเศษจากเจ้าหน้าที่มาตรา: นักเรียนทุกท่าน หากท่านต้องการรับความรู้ที่เกี่ยวข้อง โปรดสมัครผ่านช่องทางปกติ\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010503
					],
					"speakerTitle": "กระดานข้อความ"
				},
				{
					"id": 732010503,
					"content": "\"หากผู้ใดได้รับความรู้ด้วยช่องทางมิชอบ เมื่อถูกจับได้จะถูกเพิกถอนสิทธิ์การเรียนรู้ในสถาบัน ขอให้ทุกคนระมัดระวังคำพูดและพฤติกรรมด้วย\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "กระดานข้อความ"
				}
			]
		},
		{
			"id": 7320106,
			"completionStepIds": [
				7320106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320106",
							"2"
