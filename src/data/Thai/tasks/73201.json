			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010701,
					"content": "\"ทุกคนระวังนะ เพื่อนฉันรีบเดินทางกลางดึกคราวก่อน ไปเจอกับราชสมิงที่ป่าตะวันตกเฉียงเหนือเข้าด้วยล่ะ! ยังดีที่เขาไม่ได้รับบาดเจ็บอะไร แต่ตอนกลางดึกอย่าออกไปไหนจะดีกว่า!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "กระดานข้อความ"
				}
			]
		},
		{
			"id": 7320108,
			"completionStepIds": [
				7320108
