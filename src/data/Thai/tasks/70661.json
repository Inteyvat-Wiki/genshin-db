					"Nantuck"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706610201,
					"content": "ช่วงนี้ปลาชุกชุมมากเลย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610202
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610202,
					"content": "มีอะไรให้ช่วยเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610203
					]
				},
				{
					"id": 706610203,
					"content": "อ่า ในที่สุดผู้ช่วยก็มาแล้ว สวัสดี!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610204
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610204,
					"content": "ฉันชื่อ Nantuck นักตกปลาที่มากประสบการณ์จากสมาคมตกปลาแห่ง Mondstadt อะแฮ่ม ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610205
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610205,
					"content": "ช่วงนี้จู่ ๆ ก็มีปลาสายพันธุ์ใหม่มากมาย ปรากฏขึ้นในน่านน้ำแถว ๆ นี้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610206
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610206,
					"content": "ก็เลยติดต่อเพื่อนนักตกปลาในพื้นที่อื่นทันที และปรากฏว่าพื้นที่อื่นก็มีสถานการณ์แบบเดียวกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610207
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610207,
					"content": "บางคนถึงกับบอกว่านี่เป็นช่วงที่ปลาชุกชุมที่สุดใน Teyvat ซึ่งมีให้เห็นเพียงครั้งเดียวในรอบร้อยปี",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610208
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610208,
					"content": "อันที่จริงก็ยังหาสาเหตุที่แท้จริงไม่ได้ แต่ฉันเดาว่าน่าจะเกี่ยวกับการเปลี่ยนแปลงของระบบนิเวศ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610209
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610209,
					"content": "โอ้...คงเพราะปลาพวกนี้มีเยอะเกินไป เลยสร้างปัญหาให้พวกคุณใช่มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706610210,
					"content": "ไม่ต้องห่วง เดี๋ยว Paimon จัดการให้เอง! ขอแค่พวกมันพอกินได้ล่ะก็...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706610211,
					"content": "ฮ่า ๆ ไม่ใช่ปัญหาสำหรับสมาคมตกปลาหรอก ยิ่งปลาเยอะเท่าไหร่ก็ยิ่งดี เพียงแค่ก่อนหน้านี้กำลังคนไม่พอน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610212
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610212,
					"content": "แต่บอกตามตรง ถ้าดูจากกำลังคนของเราในตอนนี้ล่ะก็...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610213
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610213,
					"content": "ถ้าจะจับปลาสายพันธุ์ใหม่ทั้งหมดในเวลาอันสั้นเพื่อทำการวิจัยล่ะก็... เป็นอะไรที่กดดันมากทีเดียว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610214
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610214,
					"content": "แต่ในทางกลับกัน นี่ก็ถือเป็นโอกาสที่ดีในการพัฒนาของสมาคมตกปลาไม่ใช่เหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610215
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610215,
					"content": "ดังนั้นฉันเลยประกาศคำขอที่กิลด์นักผจญภัยไงล่ะ ว่าไง? สนใจจะเข้าร่วมกับพวกเรามั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610216
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610216,
					"content": "ตกปลาน่ะสนุกมากเลยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610217,
						706610219
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610217,
					"content": "ไม่มีปัญหา ฉันตกปลาเก่งมากนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610218
					]
				},
				{
					"id": 706610218,
					"content": "ดีเลย เป็นคนหนุ่มสาวที่มีความกระตือรือร้นมาก!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610223
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610223,
					"content": "ถ้างั้น ตอนนี้ตามฉันไปอีกด้านของ Cider Lake ก่อนเถอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610224
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610224,
					"content": "ตรงนั้นมีลานตกปลาที่พวกเราเตรียมไว้ให้สำหรับพวกมือใหม่อยู่ ฉันจะสอนพื้นฐานบางอย่างแก่เธอก่อนละกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610219,
					"content": "ลงไปจับดื้อ ๆ เลยได้มั้ย?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610220
					]
				},
				{
					"id": 706610220,
					"content": "อยู่ดี ๆ ก็กระโดดลงไปมันอันตรายมากเลยรู้ไหม? พวกนักเดินทางอย่างพวกเธอเนี่ย จะกล้าหาญเกินไปแล้ว...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610221
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610221,
					"content": "น่าเสียดายที่ปลาพวกนั้นไม่กล้าหาญเหมือนเธอ แค่เห็นคนตัวใหญ่กระโดดลงไปในน้ำก็กลัวหนีไปหมดแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610222
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610222,
					"content": "ถ้าไม่ทำเรื่องแบบนี้จะดีกว่านะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610223
					],
					"speakerTitle": "Nantuck"
				}
			]
		},
