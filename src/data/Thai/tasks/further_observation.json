			},
			"dialogs": [
				{
					"id": 30010101,
					"content": "เอาล่ะ ต่อไปก็มือขวา... สถานการณ์ดูจะโอเคนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010102
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30010102,
					"content": "แต่ยังไงก็ต้องระวังอยู่ดี เข้าใจมั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010103
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30010103,
					"content": "อื้ม เข้าใจแล้วล่ะ จริงสิอาจารย์ ฉันยังไม่ได้รับแผนที่เส้นทางลาดตระเวนของวันนี้เลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010104
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010104,
					"content": "วันนี้เส้นทางยาวไกลอยู่ เธอไม่ต้องไปกับฉันหรอก อีกอย่างอาจจะมีสิ่งพวกนั้นปรากฏขึ้นระหว่างทางก็ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010105
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30010105,
					"content": "ฉันมีวิชั่นอยู่กับตัวแท้ ๆ แต่กลับช่วยอะไรอาจารย์ไม่ได้เลย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010106
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010106,
					"content": "อย่าพูดแบบนี้ นี่ไม่ใช่เรื่องที่เธอต้องคิดในตอนนี้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010107
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30010107,
					"content": "มาแล้วเหรอ รู้สึกดีขึ้นบ้างมั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010108
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30010108,
					"content": "มีอะไรให้ช่วยมั้ย?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010109
					]
				},
				{
					"id": 30010109,
					"content": "ใช่ ไหน ๆ ก็อยู่ที่นี่แล้ว เราก็อยากจะหาอะไรทำสักหน่อย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010110,
					"content": "พวกเธอเป็นคนประเภทไม่ชอบอยู่ว่าง ๆ สินะ? ก็ได้ ถ้าอย่างนั้นวันนี้ก็ให้ Collei พาพวกเธอไปลาดตระเวนแถว ๆ ทางใต้ของ Gandharva Ville ละกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010111
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30010111,
					"content": "หากเธอเชื่อมั่นในกำลังของตัวเอง งั้นเรื่องทำความสะอาด Statue of The Seven ก็ยกให้เป็นหน้าที่ของเธอก็แล้วกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010112
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30010112,
					"content": "คุณ Tighnari พวกเราเตรียมพร้อมแล้วล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010113
					],
					"speakerTitle": "Amir"
				},
				{
					"id": 30010113,
					"content": "ไปเดี๋ยวนี้แหละ... เดี๋ยวพวกเราจะออกเดินทางเข้าป่ากันก่อน ส่วนที่เหลือเดี๋ยวให้ Collei อธิบายให้พวกเธอฟังก็แล้วกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010114
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30010114,
					"content": "อื้ม ให้ฉันจัดการเอง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010115
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010115,
					"content": "Collei วันนี้พวกเราต้องทำอะไรบ้างเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010116,
					"content": "เมื่อกี้ Tighnari บอกว่าต้องทำความสะอาด Statue of The Seven แต่ฉันไม่คิดเลยว่างานนี้จะเป็นหน้าที่ของเจ้าหน้าที่พิทักษ์ป่าด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010117,
					"content": "อืม ที่จริงงานของเจ้าหน้าที่พิทักษ์ป่าค่อนข้างกว้างน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010118
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010118,
					"content": "ตรวจสอบสภาพถนน, ซ่อมบำรุงสิ่งอำนวยความสะดวกในป่า, กำจัดอันตรายจากไฟไหม้ รวมถึงให้ความช่วยเหลือนักเดินทางและผู้อยู่อาศัย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010119
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010119,
					"content": "ถ้าเป็นอาจารย์ละก็ ต้องคอยไปจัดการพื้นที่อันตรายในป่าฝนด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010120
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010120,
					"content": "ก่อนที่เราจะไปที่ Statue of The Seven เรามาตรวจสอบไฟถนนระหว่างทางกันก่อนดีกว่า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Collei"
				}
			]
		},
		{
			"id": 300105,
			"completionStepIds": [
				300103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"300103",
							"2"
						],
						"stepId": 300103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Collei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30010501,
					"content": "Statue of The Seven อยู่บนผาหินก้อนใหญ่ ๆ นั่น ก่อนหน้านี้ตอนที่เดินผ่านเส้นทางนี้มา พวกเธอน่าจะเคยเห็นแล้วแหละเนอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010502
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010502,
					"content": "ค่อนข้างสูงใช่มั้ยล่ะ? ถ้าพวกเธอรู้สึกว่าการปืนขึ้นไปนั้นลำบากเกินไป งั้นไม่ทำความสะอาดก็ได้นะ อาจารย์ไม่ว่าอะไรหรอก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010503,
						30010504
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010503,
					"content": "ไม่ต้องห่วง ฉันช่ำชองการปีนเขาที่สุดแล้ว",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010505
					]
				},
				{
					"id": 30010505,
					"content": "จริงเหรอ งั้นก็รบกวนด้วยนะ พื้นที่รอบบริเวณรูปปั้นค่อนข้างแคบ พวกเธออยู่ข้างบนก็ระวังด้วยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010506
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010506,
					"content": "#{NICKNAME} ฉันขึ้นไปกับเธอดีกว่า ฉันสามารถช่วยทำความสะอาดที่สูง ๆ ได้นะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010507,
					"content": "จริงสิ Collei เธอพอจะรู้มั้ยว่าเทพแห่งพฤกษาเป็นเทพแบบไหนเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010508,
					"content": "เธอหมายถึง \"ท่านหญิง Rukkhadevata ผู้ยิ่งใหญ่\" หรือว่า \"ท่านหญิงน้อย Kusanali\" ล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010509
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010509,
					"content": "หืม \"ท่านหญิง Rukkhadevata ผู้ยิ่งใหญ่\" เหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010510,
					"content": "เอ๋ หรือว่านี่เป็นชื่อของเทพแห่งพฤกษารุ่นก่อน?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010511,
					"content": "ใช่ \"ท่านหญิง Rukkhadevata ผู้ยิ่งใหญ่\" เป็นเทพแห่งพฤกษารุ่นแรกของ Sumeru ท่านสร้างป่าฝนและกำแพงป้องกันทรายที่ชายขอบของทะเลทรายขึ้น เพื่อให้ทุกคนมีชีวิตที่สงบสุข",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010512
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010512,
					"content": "ในสายตาของชาว Sumeru ท่านเป็นสัญลักษณ์ของปัญญา ความเมตตา และทำได้ทุกสิ่งอย่าง แต่ท่านกลับหายตัวไปในภัยพิบัติเมื่อหลายร้อยปีก่อน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010513,
						30010514
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010513,
					"content": "(เหมือนกับ Raiden Makoto น่ะเหรอ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010515
					]
				},
				{
					"id": 30010515,
					"content": "ฉันได้ยินอาจารย์บอกว่า ต่อมาเหล่านักปราชญ์ได้พบท่านเทพแห่งพฤกษาที่ถือกำเนิดขึ้นใหม่ และได้พาเธอกลับมายัง Sumeru",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010516
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010516,
					"content": "เพื่อเป็นการเฉลิมฉลองการกลับมาของเทพเจ้า เหล่านักปราชญ์จึงเรียกเธอว่า \"ท่านหญิงน้อย Kusanali\" และให้เธออยู่อาศัยในวิหารแห่ง Surasthana",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010517
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010517,
					"content": "อื้ม ๆ แล้วยังไงต่อเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010518,
					"content": "แล้ว เอ่อ... ฉันก็ไม่รู้แล้วเหมือนกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010519
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010519,
					"content": "เอ๋ เธอเองก็ไม่รู้เหรอ? หรือว่าเธอไม่ใช่ชาว Sumeru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010520,
					"content": "ไม่ ฉันเป็นชาว Sumeru จริง ๆ แต่ว่า...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010521
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010521,
					"content": "เพราะพวกเราเป็นคนแปลกหน้ากัน เรื่องบางเรื่องก็เลยไม่สะดวกที่จะพูดเหรอ? ถ้าเป็นแบบนั้นจริงก็ไม่เป็นไรหรอก เธอไม่ต้องใส่ใจหรอกนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010522,
					"content": "ไม่ ๆ พวกเธอเข้าใจผิดแล้ว ฉันไม่ได้ปิดบังอะไรนะ ยิ่งไปกว่านั้น สำหรับฉันแล้วพวกเธอไม่ใช่คนแปลกหน้าอะไรเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010523
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010523,
					"content": "คือว่า... พะ...พวกเธอรู้จัก Amber ใช่มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010524
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010524,
					"content": "เดี๋ยวนะ หรือว่าเธอหมายถึง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010525,
						30010526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010525,
					"content": "อัศวินลาดตระเวนของกองอัศวินแห่ง Favonius?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010527
					]
				},
				{
					"id": 30010527,
					"content": "ใช่ คนนั้นแหละ! ก่อนหน้านี้ฉันเคยอยู่ที่ Mondstadt ช่วงหนึ่ง ตอนนั้นฉันได้รับความช่วยเหลือจาก Amber มากมายเลย เรียกว่าเธอทำให้ฉันเปลี่ยนไปเลยก็ว่าได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010528
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010528,
					"content": "Amber เป็นคนที่เก่งมากจริง ๆ! รักชีวิต มีความยุติธรรม นอกจากจะเปี่ยมล้นไปด้วยพลังแล้ว เธอยังเป็นคนที่ใจดีมาก สามารถให้ทางสว่างแก่คนอื่นอยู่เสมอ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010529
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010529,
					"content": "สำหรับฉันแล้ว เธอเหมาะที่จะเป็นอัศวินลาดตระเวนที่สุดเลย เพราะทุกคนที่ไปถึง Mondstadt จะต้องพบเธอเป็นคนแรก หลังจากนั้นทุกคนก็จะตกหลุมรักความเป็นกันเอง และดินแดนแห่งนั้นยังไงล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010530
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010530,
					"content": "อ๊ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010531,
						30010532
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010531,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010533
					]
				},
				{
					"id": 30010533,
					"content": "อืม ถึงแม้ฉันจะรู้สึกว่าเป้าหมายงานของอัศวินลาดตระเวนจะไม่ใช่แบบนี้ แต่ฉันสัมผัสได้อย่างดีเลยล่ะว่า Collei ชอบ Amber เอามาก ๆ เลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010534
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010534,
					"content": "อะแฮ่ม... ทะ...โทษที ดูเหมือนเมื่อกี้ฉันพูดจาแปลก ๆ ออกมา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010535
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010535,
					"content": "ฮี่ฮี่ ไม่เป็นไรหรอก พอรู้ว่าเธอเป็นเพื่อนกับ Amber ปุ๊บ ฉันก็รู้สึกสนิทกับเธอขึ้นมาปั๊บเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010536
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010536,
					"content": "แต่เธอรู้ได้ยังไงเหรอว่าพวกเราก็รู้จัก Amber เหมือนกัน?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010537
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010537,
					"content": "อ๋อ คืออย่างนี้ หลังจากที่กลับมาถึง Sumeru ฉันกับ Amber ก็ส่งจดหมายติดต่อกันตลอด",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010538
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010538,
					"content": "ในจดหมาย เธอได้เขียนเล่าเรื่องที่ Mondstadt เคยถูกมังกรโจมตี เห็นบอกว่ามีนักเดินทางผมบลอนด์คนหนึ่งกับคู่หูลอยได้ของเขามาช่วยคลี่คลายวิกฤติน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010539
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010539,
					"content": "เมื่อวานที่เจอพวกเธอ ฉันก็เลยรู้ได้ในทันทีไงล่ะ แต่ตอนนั้นนักเดินทางเพิ่งจะรู้สึกตัว ฉันก็เลยไม่กล้าถามเรื่องนี้น่ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010540
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010540,
					"content": "เป็นอย่างนี้นี่เอง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010541
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010541,
					"content": "อื้ม! เพราะงั้นพวกเธอไม่ต้องเป็นกังวลนะ ฉันเชื่อใจพวกเธออยู่แล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010542
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010542,
					"content": "ฉันก็อยากบอกเล่าเรื่องท่านเทพแห่งพฤกษากับเธอมากกว่านี้นะ แต่ฉันไม่ได้ใช้ชีวิตใน Sumeru มานาน แล้วก็ไม่ได้อ่านหนังสืออะไรเลยด้วย... ต้องขอโทษด้วยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010543
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010543,
					"content": "ไม่เป็นไร แค่ข้อมูลที่เธอบอกเราเมื่อกี้ก็มีค่ามากแล้วล่ะ เมื่อก่อนพวกเราไม่เคยได้ยินชื่อ \"ท่านหญิง Rukkhadevata ผู้ยิ่งใหญ่\" หรือ \"วิหารแห่ง Surasthana\" อะไรพวกนี้เลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010544
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010544,
					"content": "ได้ช่วยนิด ๆ หน่อย ๆ ก็ยังดี ว่าแต่ทำไมพวกเธอถึงอยากรู้เรื่องเทพแห่งพฤกษาล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010545
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010545,
					"content": "บอกจุดประสงค์ของการเดินทางให้กับ Collei",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						30010546
					]
				},
				{
					"id": 30010546,
					"content": "อย่างนี้นี่เอง ขอบคุณที่บอกเรื่องนี้กับฉันนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010547
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010547,
					"content": "ไม่เป็นไร ยังไงพวกเราก็เป็นเพื่อนกันแล้วนี่นา ใช่มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010548
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010548,
					"content": "Paimon พูดถูก",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010549
					]
				},
				{
					"id": 30010549,
					"content": "เอาล่ะ งั้นตอนนี้เราไปทำความสะอาดรูปปั้นข้างบนกันเถอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010550
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010550,
					"content": "อื้ม รบกวนด้วยนะ ฉันจะไปตรวจดูผืนป่าฝนข้างหน้านั่นก่อน งั้นเดี๋ยวพวกเรามาเจอกันแถวนี้อีกทีนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010532,
					"content": "ที่แท้เธอก็เป็นคนแบบนี้เองสินะ Collei",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010533
					]
				},
				{
					"id": 30010526,
					"content": "คนที่ชื่นชอบการร่อนเวหาแห่ง Mondstadt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010527
					]
				},
				{
					"id": 30010514,
					"content": "(ราว ๆ ช่วง Khaenri'ah ด้วยใช่มั้ย)",
