					"Cyno"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130100201,
					"content": "ร้อนจัง... ถ้ามีที่ที่ร่มเย็นให้พักสักหน่อยคงจะดี...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100202,
					"content": "พักสักหน่อยเถอะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100203
					]
				},
				{
					"id": 130100203,
					"content": "ยังต้องเดินทางอีกไกล อดทนอีกหน่อยนะ อีกอย่างดูจากสภาพแวดล้อมรอบ ๆ นี้แล้ว ที่นี่คงไม่เหมาะแก่การพักผ่อนเท่าไหร่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100204
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100204,
					"content": "เฮ้อ... ก็ได้ แต่ Cyno ไม่รู้สึกร้อนเลยเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100205,
					"content": "ร้อนอยู่แล้ว แต่ฉันชินแล้วน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100206
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100206,
					"content": "มีเคล็ดลับอะไรมั้ย? ฉันรู้สึกว่าเริ่มจะทนไม่ไหวแล้วสิ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100207,
					"content": "ต้องตั้งสติไว้ให้ได้มากที่สุด จากนั้นก็ต้องอดทนด้วยจิตใจที่แน่วแน่ หากเริ่มผ่อนคลายเมื่อไหร่ ก็มีแต่จะยิ่งทำให้เหนื่อยล้ามากขึ้น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100208
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100208,
					"content": "ค่อย ๆ เดินทีละก้าว อย่าให้สมองคิดถึงขีดจำกัดของร่างกาย เมื่อถึงสถานที่ที่ค่อนข้างปลอดภัยค่อยผ่อนคลายอย่างเต็มที่นะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100209
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100209,
					"content": "ก็ได้ แต่สถานที่ที่ปลอดภัยที่ว่า หมายถึงที่ไหนเหรอ? ฉันว่าที่นี่ก็ดูปลอดภัยมากนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100210,
					"content": "เธอดูสิ ที่นี่คือทะเลทรายที่กว้างสุดลูกหูลูกตา แล้วแถวนี้ก็ไม่มีมอนสเตอร์อะไรด้วย... อึ๋ย! แมงป่องพวกนี้มาจากไหนกันเนี่ย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100211,
					"content": "ระวังนะ เจ้าพวกนี้ดูไม่ปกติ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyno"
				}
			]
		},
		{
			"id": 1301004,
			"completionStepIds": [
				1301004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301004",
							"2"
						],
						"stepId": 1301004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cyno"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130100401,
					"content": "เฮ้อ... ไม่คิดเลยว่าที่นี่จะมีแมงป่องพิษด้วย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100402,
					"content": "นี่ไม่ใช่แมงป่องพิษธรรมดา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100403
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100403,
					"content": "เธอดูสิ บนก้ามของพวกมันมีหมายเลขอยู่ นี่เป็นแมงป่องที่ถูกเลี้ยงโดยมนุษย์",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100404
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100404,
					"content": "เธอหมายความว่า...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100405
					]
				},
				{
					"id": 130100405,
					"content": "มีคนไม่อยากให้เราไปงานประมูล เลยส่งพวกมันมาดักล้อมพวกเราไว้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100406
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100406,
					"content": "ยังไงซะรอบ ๆ ก็เป็นทะเลทรายที่กว้างใหญ่ไพศาล ต่อให้พวกเราถูกกำจัด ก็ไม่มีใครรู้หรอก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100407
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100407,
					"content": "อันตรายจัง! โชคดีนะที่พวกเราไม่ได้ประมาท",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100408,
					"content": "แต่มันดูผิดปกตินะ... ทะเลทรายไม่มีเส้นทางที่แน่นอน พวกเขาจะรู้ได้ยังไงว่าพวกเราเดินทางมาถึงตรงนี้?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100409
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100409,
					"content": "#อย่าขยับ {NICKNAME}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100410
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100410,
					"content": "ที่แท้... พวกเขาก็เอาสิ่งนี้ติดไว้กับเธอ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100411
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100411,
					"content": "มีอะไรกันเนี่ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100412,
					"content": "เครื่องระบุตำแหน่งขนาดเล็กที่ภาควิชาเทคโนโลยีสร้างขึ้นมา ซึ่งสามารถใช้สิ่งนี้เพื่อระบุตำแหน่งคร่าว ๆ ของผู้ที่ติดไว้ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100413
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100413,
					"content": "ฉันจำได้ว่าอุปกรณ์นี้ไม่ได้รับอนุญาตให้ผลิตในจำนวนมาก พวกเขาไปเอามันมาจากไหน... หรือว่ามีนักวิชาการของภาควิชาเทคโนโลยีเกี่ยวข้องกับเรื่องนี้ด้วย? แต่ก็ไม่น่าใช่...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100414
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100414,
					"content": "#มีของแบบนี้ด้วยหรือเนี่ย ทำไมถึงอยู่บนตัวของ {NICKNAME} ได้ล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100415,
					"content": "น่าจะเป็นตอนที่ต่อสู้กับทหารรับจ้าง แล้วถูกพวกเขาติดเอาไว้น่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100416,
						130100417
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100416,
					"content": "ขอโทษ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100418
					]
				},
				{
					"id": 130100418,
					"content": "ตอนนั้นสถานการณ์วุ่นวายมาก ไม่รู้ตัวก็ไม่แปลกหรอก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100419
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100419,
					"content": "โชคดีที่ Cyno เห็นเข้า งั้นพวกเรารีบทิ้งมันไปเถอะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
