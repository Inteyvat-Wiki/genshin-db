						130100602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100602,
					"content": "ไม่มีใครเลย",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100603
					]
				},
				{
					"id": 130100603,
					"content": "นั่นสิ! ไม่มีคนอยู่เลย อยู่ในช่วงพักครึ่งอยู่งั้นเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100604,
					"content": "หลังจากเอาชนะทหารรับจ้างพวกนั้นได้แล้ว พวกเราก็รีบมาที่นี่โดยทันที ที่เร่งรีบขนาดนี้ ก็เพราะห่วงว่าจะมีคนมาส่งข่าว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100605
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100605,
					"content": "แต่สุดท้ายเราก็คว้าน้ำเหลว น่าจะเป็นเพราะว่าคนที่นี่ตรวจสอบการเคลื่อนไหวของเราผ่านเครื่องระบุตำแหน่ง เลยหนีไปก่อนหน้านี้แล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100606
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100606,
					"content": "งั้นตอนนี้เราควรทำยังไงดี?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100607,
					"content": "ค้นหา พวกเขาไม่ทันได้ขนย้ายผลึกความรู้ทั้งหมดออกไปแน่ ที่นี่อาจจะมีเบาะแสอยู่ก็ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100608
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100608,
					"content": "งั้นพวกเราต้องค้นหาให้ทั่วเลยนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
