					"Daya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736900101,
					"content": "#สวัสดี ฉันคือ Daya จากคณะ Kshahrewar! {F#เธอ}{M#นาย}ก็มาร่วมงานรื่นเริงประเทืองปัญญาเหมือนกันเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900102
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900102,
					"content": "นี่คือโครงการเกมที่คณะของเรานำเสนอ: \"แผนเส้นทางสัญจร\" ยังไงล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900103
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900103,
					"content": "ว่าไง? สนใจลองเล่นดูมั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900104
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900104,
					"content": "ฉันจำได้ว่าคณะ Kshahrewar วิจัยเรื่อง...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736900105
					]
				},
				{
					"id": 736900105,
					"content": "ส่วนใหญ่คณะของเราจะวิจัยเกี่ยวกับกลไก และสิ่งปลูกสร้างน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900107
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900107,
					"content": "อะแฮ่ม นอกเรื่องไปไกลละ... เพื่อเข้าร่วมงานรื่นเริงประเทืองปัญญาในครั้งนี้ นักเรียนหลายคนในคณะของเราเลยร่วมมือร่วมใจกัน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900108
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900108,
					"content": "และวิจัยโครงการเกม \"แผนเส้นทางสัญจร\" ออกมาได้ในที่สุด!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900109
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900109,
					"content": "พูดง่าย ๆ ก็คือผู้เล่นต้องใช้ของต่าง ๆ ที่เราเตรียมไว้ให้มาสร้างเส้นทางนั่นเอง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900110
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900110,
					"content": "ไม่ว่าจะเป็นสะพานเอย บันไดพาดเอย... สุดท้ายเป้าหมายก็คือการสร้างเส้นทาง ให้คนสามารถมุ่งตรงไปสู่ปลายทางได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900111
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900111,
					"content": "หลังจากสร้างเสร็จแล้ว เราจะทำการตรวจงานในตอนสุดท้ายอีกครั้ง... เหมือนเป็นการตรวจงานสิ่งปลูกสร้างที่สร้างเสร็จนั่นแหละ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900112
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900112,
					"content": "เอาเป็นว่าแค่สร้างเส้นทางที่ปลอดภัยออกมาได้สักเส้น ก็ถือว่าชนะแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900113,
						736900114
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900113,
					"content": "ฟังดูซับซ้อนจัง...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736900115
					]
				},
				{
					"id": 736900115,
					"content": "ฮ่าฮ่าฮ่า ไม่ต้องห่วง เราไม่ได้ให้สร้างสิ่งปลูกสร้างจริง ๆ สักหน่อย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900116
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900116,
					"content": "เพราะงั้นต่อให้สร้างผิดพลาด เส้นทางพังถล่มก็ไม่เป็นไร แค่สร้างใหม่ก็พอแล้ว และเราไม่ได้จำกัดจำนวนครั้งการลองด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900117
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900117,
					"content": "แค่ใช้จินตนาการ และสร้างเส้นทางที่สวยงามออกมาก็พอแล้ว!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900118,
						736900120
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900118,
					"content": "ฉันอยากลองดู",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736900119
					]
				},
				{
					"id": 736900119,
					"content": "ไม่มีปัญหา งั้นโปรดมองมาทางนี้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900120,
					"content": "ยังมีเรื่องอื่นต้องทำน่ะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736900121
					]
				},
				{
					"id": 736900121,
					"content": "งั้นเหรอ... ไม่เป็นไร แผงของเราจะเปิดตลอดในงานรื่นเริงประเทืองปัญญานะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900122
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900122,
					"content": "#ถ้า{F#เธอ}{M#นาย}อยากลองเล่นเมื่อไหร่ ก็แวะมาได้เลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900114,
					"content": "ฉันไม่มีพรสวรรค์ด้านการก่อสร้างน่ะ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736900115
					]
				}
			]
		}
	]
}