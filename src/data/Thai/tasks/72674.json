						726740402
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740402,
					"content": "จะไปเดี๋ยวนี้แหละ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740403
					]
				},
				{
					"id": 726740403,
					"content": "รีบไปเถอะ ยังไงข้าก็ไปที่ไหนไม่ได้ ยังมีเวลาอีกมาก แต่พวกทานูกิน้อยพวกนั้นไม่เหมือนกับข้า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
