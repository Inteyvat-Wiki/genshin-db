					"Ioroi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726740101,
					"content": "สวัสดี Ioroi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740102,
					"content": "อ๊ะ! ดูออกด้วยเหรอเนี่ย! พวกเจ้าเป็นใครกันแน่... กลิ่นนี้มัน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740103
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740103,
					"content": "เจ้าเด็กพวกนี้นี่เอง! ไม่เจอกันนาน จนข้าเกือบจะจำกลิ่นไม่ได้แล้วนะเนี่ย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740104
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740104,
					"content": "Ioroi นี่ไม่เปลี่ยนไปเลยจริง ๆ นะ แค่เห็นคนก็กลัวซะล่ะ แถมยังติดอยู่ในก้อนหินอีก!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740105,
					"content": "เอ๋?! เจ้าเด็กนี่ ที่พูดหมายความว่ายังไงกัน?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740106,
						726740107
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740106,
					"content": "หวังว่าผนึกของคุณจะถูกปลดออกในเร็ววันน่ะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740108
					]
				},
				{
					"id": 726740108,
					"content": "มันก็แค่ผนึกของพวกมนุษย์! ขอแค่ข้าพยายามขึ้นหน่อย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740109
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740109,
					"content": "แค่กแค่ก",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740110
					]
				},
				{
					"id": 726740110,
					"content": "......",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740111
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740111,
					"content": "#หึ แต่ไม่ว่ายังไงก็ตาม พวกเด็ก ๆ ได้รับการดูแลจากพวกเจ้าไม่น้อย เจ้าพวกทานูกิน้อยมักบอกว่ามี{F#ป้า}{M#ลุง}ขนสีเหลือง ที่ดมแล้วได้กลิ่นหอมมาก มาเล่นกับพวกเขาอยู่บ่อย ๆ ดูดีใจมากเลยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740112,
						726740113,
						726740114
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740112,
					"content": "#{F#ป้า}{M#ลุง}ขนสีเหลือง...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740115
					]
				},
				{
					"id": 726740115,
					"content": "เดิมทีข้าคิดว่า พวกมนุษย์จะเป็นเหมือนเจ้าคนที่เอาพวก Bake-Danuki อย่างข้ามาผนึกไว้ ทั้งชั่วช้าและน่ากลัว ดูเหมือนว่า จะยังมีคนดีอยู่บ้าง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740116,
						726740117
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740116,
					"content": "ส่วนใหญ่ก็เป็นคนดีนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740118
					]
				},
				{
					"id": 726740118,
					"content": "#ใช่แล้วล่ะ คนที่ฉันกับ {NICKNAME} พบเจอ ส่วนมากก็เป็นคนดีนะ ที่ Ioroi โดนผนึกก็เพราะว่าขโมยหวีไปไม่ใช่เหรอ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740119,
					"content": "เหอะ ตอนนี้หวีก็คืนให้พวกเจ้าไปแล้ว ถ้าพวกเจ้าเจอคนที่เรียนวิชาคาถามาจาก Reizenbou ล่ะก็ บอกให้เขามาเอาตัวข้าออกจากหินทีนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740120
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740120,
					"content": "ข้าอยู่ในนี้มานานมากแล้ว ต้องโทษเจ้าจิ้งจอกบ้านั่น...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740121
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740121,
					"content": "(ตอนที่ Ioroi บ่นนี่เหมือนคนแก่เลยเนอะ)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740122,
					"content": "(อายุน่าจะเยอะแล้วจริง ๆ แหละ)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740123
					]
				},
				{
					"id": 726740123,
					"content": "มือของพวกเจ้าก็ไม่ได้เป็นหิน เท้าก็ไม่ได้เป็นหิน คงเคยไปมาหลายที่เลยสินะ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740124
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740124,
					"content": "#ฮี่ ๆ ฉันกับ {NICKNAME} มาจากอีกฟากหนึ่งของทะเลเชียวนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740125,
					"content": "เล่าเรื่องราวของ Liyue และ Mondstadt ให้ Ioroi ฟัง",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						726740126
					]
				},
				{
					"id": 726740126,
					"content": "...ที่แท้ข้างนอกยังมีอีกตั้งหลายที่เลย น่าทึ่งจริง ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740127
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740127,
					"content": "ตั้งแต่ไหนแต่ไรมา ก็ฟังมาจากที่เจ้าทานูกิน้อยเอามารายงานข้า ดังนั้นก็เลยไม่รู้ว่าจริง ๆ แล้วโลกภายนอกเป็นยังไงกันแน่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740128
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740128,
					"content": "แต่ก่อนตอนที่อยู่บนภูเขา Yougou ข้าเคยเห็นว่าฝั่งตรงข้ามทะเลทางเหนือมีภูเขาที่สูงมาก ๆ อยู่ลูกหนึ่ง บางทีอาจจะสูงกว่าภูเขา Yougou ด้วยซ้ำ ข้าอยากรู้มาตลอดเลยล่ะ ว่าที่นั่นคือที่ไหน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740129,
						726740131
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740129,
					"content": "ทางนั่นน่ะเหรอ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740130
					]
				},
				{
					"id": 726740130,
					"content": "ดูจากมุมมองนั้นแล้ว น่าจะเป็นภูเขา Dragonspine ละมั้ง!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740132,
					"content": "บรื้อออ ภูเขา Dragonspine... แค่ได้ยินชื่อก็เย็นพุงแล้ว ไม่รู้จริง ๆ ว่าทำไมเจ้านั่นถึงอยากไปสถานที่แบบนั้น...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740133
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740133,
					"content": "......",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740134
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740134,
					"content": "อะแฮ่ม ๆ ก่อนหน้านี้ก็บอกไปแล้ว ว่าพวกเจ้าเป็นคนดี เพราะฉะนั้น...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740135
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740135,
					"content": "เป็นน้ำเสียงที่ใช้ขอให้คนช่วยเหลือล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740136,
					"content": "หึ! ข้าได้รับคำสั่งจากท่าน Ogosho ให้เป็นเทพลึกลับผู้คุ้มครองป่า Chinju เชียวนะ ถ้าไม่ได้ถูกผนึกอยู่ในก้อนหิน สักวันข้าจะต้องใช้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740137,
						726740138
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740137,
					"content": "มีอะไรใช้ช่วยงั้นเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740143
					]
				},
				{
					"id": 726740143,
					"content": "แม้ว่าข้าจะไม่สามารถเคลื่อนไหวไปไหนมาไหนได้อย่างอิสระ แต่เจ้าเด็ก ๆ พวกนั้นทำได้ไม่มีปัญหาอะไร ข้าเลยอยากให้เจ้าช่วยพาพวกทานูกิน้อยออกไป \"ฝึกฝน\" ที่ข้างนอกหน่อยน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740144
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740144,
					"content": "พาเจ้า Kichiboushi ไปละกัน คราวก่อนหลังจากที่ออกไปเที่ยวเล่นกับพวกเจ้า เขาก็เอาแต่พูดอยู่ตลอดว่าอยากเจอกับพวกเจ้าอีกครั้งน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740145,
						726740146
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740145,
					"content": "จะว่าได้ก็ได้อยู่นะ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740147
					]
				},
				{
					"id": 726740147,
					"content": "อืม คือพวกเราสื่อสารกับ Kichiboushi ไม่รู้เรื่องน่ะ ถ้าออกเดินทางไปด้วยกัน คงจะเจอปัญหาไม่น้อยเลยล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740148
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740148,
					"content": "จะเป็นไปได้ยังไงกัน เผ่า Bake-Danuki ของพวกข้า เข้าใจภาษาของพวกมนุษย์อยู่แล้วล่ะ เพียงแค่พวกเจ้าไม่เข้าใจที่ Bake-Danuki ทั่วไปพูดเท่านั้นเอง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740149
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740149,
					"content": "อะไรกัน! มีเรื่องแบบนี้ด้วยเหรอเนี่ย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740150
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740150,
					"content": "แต่ถ้าต้องร่วมเดินทางไปด้วยกัน...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740151
					]
				},
				{
					"id": 726740151,
					"content": "ก็ยังหวังว่าจะได้เดินทางไปด้วยกัน แล้วก็พูดคุยกันไปด้วยน่ะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740152
					]
				},
				{
					"id": 726740152,
					"content": "#เหมือนแบบที่ Paimon และ {NICKNAME} ทำยังไงล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740153
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740153,
					"content": "เฮ้อ เจ้านี่จริง ๆ เลยนะ ก่อนหน้านี้ก็มีคนใช้วิชาคาถาเผ่า Bake-Danuki ของข้า ทำอาหารให้พวกเจ้าแล้วไม่ใช่หรือ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740154
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740154,
					"content": "ถึงแม้ว่าข้าจะอยู่ในสภาพนี้ แต่ถ้าจะให้ทำ \"อาหาร\" ที่ทำให้พวกเจ้าฟัง Kichiboushi รู้เรื่องได้ ก็ไม่ใช่ปัญหาอะไร",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740155
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740155,
					"content": "เยี่ยมเลย! ของอร่อยสินะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740156
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740156,
					"content": "ก็ไม่ถือว่าเป็นของอร่อยหรอก...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740157
					]
				},
				{
					"id": 726740157,
					"content": "หึ อย่าดูถูกฝีมือของข้าเชียวนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740158
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740158,
					"content": "แม้ว่าจะอธิบายได้ยากว่า Ioroi เสกมันออกมาจากที่ไหน...\\nแต่คุณกับ Paimon ก็ได้กินอาหารมื้อใหญ่ที่ \"ดูน่าอร่อยมาก\" ที่วางบนท้องของ Ioroi ด้วยกัน",
