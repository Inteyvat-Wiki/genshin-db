						"rawParams": [
							"7106001",
							"2"
						],
						"stepId": 7106001,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7226618",
							"3"
						],
						"stepId": 7226618,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katarina"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710591101,
					"content": "ว่าไง? พวกเธอตั้งใจมารบกวนการพักผ่อนของฉันเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591102
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591102,
					"content": "เปล่าสักหน่อย เราก็แค่เห็นว่าเธออยู่ที่นี่เหงา ๆ คนเดียว ก็เลยอยากมาคุยด้วยน่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591103,
						710591104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710591103,
					"content": "ดื่มคนเดียวคงจะเบื่อสินะ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591105
					]
				},
				{
					"id": 710591105,
					"content": "...งั้นเหรอ? ขอบใจมากนะ ท่าทางของพวกเธอตอนนี้... ทำให้ฉันคิดถึง Lyudochka",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591106
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591106,
					"content": "เธอก็เป็นคนใจดีเหมือนกัน... ในตอนนั้นเธอมักจะคอยอยู่เคียงข้างฉัน และเล่าเรื่องราวต่าง ๆ นานา... หลายครั้งเธอก็เต็มใจที่จะบอกเล่าแค่กับฉัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591107
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591107,
					"content": "เฮ้อ ถ้า Lyudochka อยู่ด้วยก็คงจะดี... เธอเป็นคนที่อยู่ด้วยแล้วสนุกมาก พวกเธอจะต้องชอบ Lyudochka แน่ ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591108,
						710591113
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591108,
					"content": "Lyudochka? เขาเป็นใครเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591109
					]
				},
				{
					"id": 710591109,
					"content": "เธอน่ะ... เป็นเพื่อนของฉันเอง ถึงแม้ภายนอกจะดูจริงจัง แต่จริง ๆ เป็นคนสนุกสนานเฮฮามาก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591110
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591110,
					"content": "ตอนที่อยู่ใน \"บ้านแสนอบอุ่น\" พวกเราสนิทกันเหมือนพี่สาวน้องสาว... หรืออาจจะมากกว่าพี่น้องก็ได้ เธอชอบแกล้งฉัน... และก็ดูแลฉันเป็นอย่างดี",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591111
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591111,
					"content": "ฮ่าฮ่า ยังไงซะฉันก็มีลางสังหรณ์ว่าเธออยู่ข้างนอกนั่นคงจะสุขสบายดี พอฉันคิดแบบนี้ บาดแผลที่ได้รับจากสถานที่บ้า ๆ แห่งนี้ก็ไม่มีค่าอะไรแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591112
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591112,
					"content": "หวังว่าเธอจะทำงานของตัวเองได้ดี... และหวังอย่าให้ว่าเธอคิดถึงฉันเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591113,
					"content": "Lyudochka... เธอหมายถึงคนที่อยู่ Inazuma นั่นเหรอ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591114
					]
				},
				{
					"id": 710591114,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591115
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591115,
					"content": "หมายความว่า เธอถูกจับได้แล้วเหรอ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591116
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591116,
					"content": "เอ๊ะ... เธอรู้ได้ยังไง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591117,
						710591118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710591117,
					"content": "เธอ... หนีรอดมาได้",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591119
					]
				},
				{
					"id": 710591119,
					"content": "จริงเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591120
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591120,
					"content": "ฮ่าฮ่า... งั้นก็ดีแล้วล่ะ หวังว่าเธอจะทำงานของตัวเองได้ดีนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591121
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591121,
					"content": "แต่ถ้าเธอทรยศต่อท่าน Tsaritsa เพราะกลัวความตาย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591122
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591122,
					"content": "...ก็หวังว่าเธอจะไม่คิดถึงฉันนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591118,
					"content": "เธอยังมีชีวิตอยู่ แล้วก็สบายดีด้วย",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591119
					]
				},
				{
					"id": 710591104,
					"content": "พวกเราตั้งใจมาพูดคุยกับเธอเลยนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591105
					]
				}
			]
		},
