			"dialogs": [
				{
					"id": 110410401,
					"content": "นั่นก็คือ Albedo เหรอ? ทำไมเขาถึงมาอยู่ในที่แบบนี้ล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410402,
					"content": "ได้ยินมาว่า Albedo ชอบวาดรูปมาก ก็ไม่แปลกอะไรที่เขาจะมาที่แบบนี้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410403
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110410403,
					"content": "วิวทิวทัศน์ที่นี่ดีมาก ไม่ว่าจะวิวใกล้หรือไกลก็คุ้มค่าที่จะวาด",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410404
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110410404,
					"content": "แต่...เขาทันได้สังเกต Hilichurl พวกนั้นมั้ยนะ? จะถูกจู่โจมมั้ยเนี่ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410405,
					"content": "อ๊าาา?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1104106,
			"completionStepIds": [
				1104106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
