				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110410601,
					"content": "พวกเธอคือใคร? ทำไมถึงต้องทำให้พวกมันรู้ตัวด้วย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410602
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410602,
					"content": "โชคดีที่ฉันวาดเสร็จแล้ว ถ้าวาด Hilichurl ไม่เสร็จล่ะก็เสียดายแย่เลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410603,
						110410604
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410603,
					"content": "ที่แท้คุณก็มาวาดภาพ Hilichurl นี่เอง",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410605
					]
				},
				{
					"id": 110410605,
					"content": "ว่าแต่ Hilichurl มีอะไรให้น่าวาดเหรอ ดูหน้าตาเหมือน ๆ กันไปหมดนี่นา?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410606,
					"content": "อืม...คำถามนี้ถ้าจะให้อธิบายล่ะก็ มันค่อนข้างจะซับซ้อนน่ะ พวกเธอดูจากภาพที่ฉันวาดเอาก็แล้วกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410607,
						110410608
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410607,
					"content": "เอ่อ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410609
					]
				},
				{
					"id": 110410609,
					"content": "ว้าว วาดได้ละเอียดจริง ๆ แต่ดูเหมือนจะรีบวาดมากเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410610,
					"content": "Hilichurl พวกนั้นเจอได้ทุกที่แหละ น่าเบื่อจะตาย ไม่คุ้มที่จะเสียเวลาหรอก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410611
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410611,
					"content": "แต่เธอดูตัวนี้สิ ร่างกายของมัน ขนของมัน ท่าทางของมัน ล้วนมีพลังที่ต่างจากตัวอื่น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410612
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410612,
					"content": "ในวัฏจักรชีวิตของคนโบราณนั้น คุณลักษณะพิเศษเหล่านี้แสดงให้เห็นถึงวิวัฒนาการ ซึ่งวิวัฒนาการนั้นเป็นสิ่งที่เริ่มจากไม่มีจนถึงมี จากรู้จนถึงไม่รู้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410613
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410613,
					"content": "เดี๋ยวก่อน ๆ ฉันมีลางสังหรณ์ว่าจะเล่ากันยาวเลยสินะ ฉันไม่ได้สนใจอยากฟังด้วยเท่าไหร่หรอกนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410614
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110410614,
					"content": "ในเมื่อหาเจอแล้ว ฉันขอตัวก่อนนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410615
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110410615,
					"content": "อ่า คุณไม่ได้มีอะไรจะถามเขาเหรอ? เฮ้!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410616,
					"content": "เอ่ เป็นคนที่แปลกจริง ๆ ด้วยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410617,
					"content": "คิดไม่ถึงเลยว่าซิสเตอร์ Rosaria จะเป็นคนนำทางให้พวกเธอ อืม ไม่ทันได้ขอบคุณเธอเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410618
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410618,
					"content": "ฟังจากที่ Rosaria พูดแล้ว พวกเธอเดินทางมาหาฉันโดยเฉพาะเลยเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410619
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410619,
					"content": "อื้ม ใช่แล้ว พวกเราเจอกับเด็กผู้หญิงคนนึงชื่อ Sucrose ที่ Mondstadt Sucrose บอกว่างานวิจัยของเธอกำลังติดขัด",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410620,
					"content": "อย่างนี้นี่เอง Sucrose แนะนำให้พวกเธอมาสินะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410621
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410621,
					"content": "งั้นถ้าฉันทายไม่ผิดล่ะก็ เธอก็คือ \"อัศวินผู้มีเกียรติ\" ที่ใน Mondstadt พูดถึงกันอยู่ช่วงนี้สินะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410622
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410622,
					"content": "ฉันได้ยินเรื่องราวของเธอ ทั้งวีรกรรมของเธอตอนเกิดภัยพิบัติมังกร การควบคุมพลังงานธาตุของเธอ และเรื่องลึกลับ ๆ อีกเยอะเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410623
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410623,
					"content": "เอาตรง ๆ เลยนะ ความเป็นไปได้เพียงอย่างเดียวก็คือเธอมาจาก \"โลกอื่น\" ใช่มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410624,
						110410625
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410624,
					"content": "อืม ใช่แล้ว",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410626
					]
				},
				{
					"id": 110410626,
					"content": "เยี่ยมเลย ถ้ามีเธอคอยช่วยล่ะก็ งานวิจัยของฉันจะต้องมีความคืบหน้าอย่างมากแน่นอน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410627,
						110410628
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410627,
					"content": "งานวิจัยของคุณ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410629
					]
				},
				{
					"id": 110410629,
					"content": "อ่า ขอโทษด้วย ตอนนี้เธอคงจะสงสัยแน่ ๆ จะเริ่มอธิบายจากตรงไหนดีนะ... เอ่อ พูดถึงเรื่องแก่นแท้ของชีวิตก่อนแล้วกัน?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410630
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410630,
					"content": "เดี๋ยว ๆ นี่มันจะนามธรรมมากไปแล้ว!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410631
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410631,
					"content": "อ่า...ก็จริง เทียบกับการอธิบายด้วยคำพูดแล้ว สาธิตอะไรให้พวกเธอดูคงจะดีกว่า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410632
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410632,
					"content": "อย่างเช่น คืนชีพให้กิ่งไม้แห้งมี \"ชีวิตใหม่\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410634
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410634,
					"content": "ทำเรื่องแบบนี้ได้ด้วยเหรอ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410635,
						110410636
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410635,
					"content": "การเล่นแร่แปรธาตุนี่น่าอัศจรรย์จริง ๆ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410637
					]
				},
				{
					"id": 110410637,
					"content": "แต่...ฉันมีเมล็ดพันธุ์พิเศษอยู่เมล็ดนึง วีธีเมื่อกี้นี้ใช้กับมันไม่ได้ผลเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410639
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410639,
					"content": "มันก็มาจากโลกอื่นเหมือนกับเธอ การทำให้มันเติบโตและออกดอกออกผล ก็คือส่วนที่งานวิจัยมีปัญหาอยู่ และต้องการความช่วยเหลือจากเธอนั่นแหละ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410640
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410640,
					"content": "เรื่องที่คุณเองยังทำไม่ได้ งั้นพวกเราก็คงช่วยไม่ได้หรอกมั้ง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410641
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410641,
					"content": "ได้อยู่แล้ว เพราะฉันเองก็ไม่สามารถจินตนาการถึงชีวิตรูปแบบอื่นที่อยู่นอกโลกได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410642
					],
