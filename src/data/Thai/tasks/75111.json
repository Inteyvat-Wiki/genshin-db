			"dialogs": [
				{
					"id": 751110101,
					"content": "ก่อนหน้านี้ฉันเก็บเจ้านี่ได้...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751110102
					]
				},
				{
					"id": 751110102,
					"content": "อ๊ะ? อย่าบอกนะว่าเจ้าโง่ที่ไหนมาทำตกเอาไว้ รีบเอามาให้ฉันดูเร็วเข้า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michica"
				}
			]
		},
		{
			"id": 7511102,
			"completionStepIds": [
				7511102
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7511102",
							"2"
						],
						"stepId": 7511102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Michica"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751110201,
					"content": "นี่มันดูเหมือน... พัสดุที่ส่งให้ Acat เลยแฮะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110202
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110202,
					"content": "...บรรจุภัณฑ์ด้านนอกฉีกขาด ถ้าส่งออกไปอีกครั้ง พัสดุทั้งหมดอาจจะเสียหายได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110203
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110203,
					"content": "ฉันยังต้องจัดการพัสดุในร้านอีก เธอช่วยเอาพัสดุไปส่งให้ Acat หน่อยได้มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110204
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110204,
					"content": "เขาเป็นเจ้าของร้าน \"จานสีของ Frida\" ในลานประลองเพลิงศักดิ์สิทธิ์ ร้านของเขาโดดเด่นมากเลยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michica"
				}
			]
		},
		{
			"id": 7511103,
			"completionStepIds": [
				7511103
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7511103",
							"2"
						],
