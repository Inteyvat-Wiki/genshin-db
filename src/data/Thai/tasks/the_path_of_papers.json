					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731050101,
					"content": "Alrani... เธอไปอยู่ไหนกันนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050102
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050102,
					"content": "Alrani?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050103
					]
				},
				{
					"id": 731050103,
					"content": "เอ๋? ฉันจำชื่อนี้ได้... ใช่ผู้หญิงที่เอาแต่เขียนวิทยานิพนธ์คนนั้นรึเปล่านะ? ที่พวกเราเคยเจอบนเกาะ Watatsumi อ่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050104,
					"content": "ใช่แล้ว! เขาเคยบอกว่าออกมาจากสถาบันเพื่อเก็บข้อมูลน่ะ ตอนนี้ก็น่าจะกลับมาแล้วสิ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050105,
					"content": "แต่... ดูคนนั้นร้อนรนยังไงไม่รู้... พวกเราลองไปถามดูกันเถอะว่าเกิดอะไรขึ้น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050106,
					"content": "ถ้า Alrani กลับมาที่สถาบันแล้วจริง ๆ พวกเราเองก็แวะไปทักทายด้วยซะเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050107,
					"content": "สวัสดี เกี่ยวกับ Alrani...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050108
					]
				},
				{
					"id": 731050108,
					"content": "เธอคือนักผจญภัยที่กิลด์นักผจญภัยส่งมาสินะ?! ขอถามหน่อยได้มั้ยว่า เธอเจอเบาะแสของ Alrani บ้างรึเปล่า?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050109
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050109,
					"content": "ฉันรู้ตัวว่าฉันทวงถามไปหลายครั้งแล้ว รู้สึกเกรงใจมากจริง ๆ แต่ฉันเป็นห่วงเขามากจริง ๆ ฉัน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050110
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050110,
					"content": "โอ้ว คุณใจเย็น ๆ ก่อนนะ พวกเราไม่ใช่คนที่กิลด์นักผจญภัยส่งมาหรอก พวกเราแค่เดินผ่าน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050111,
					"content": "ขอถามหน่อยว่าคุณคือ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050112
					]
				},
				{
					"id": 731050112,
					"content": "พวกเธอไม่ใช่นักผจญภัยเหรอ? ขอโทษด้วย พอดีฉันไม่ได้ข่าวอะไรจากทางกิลด์เลย ฉะ...ฉันก็เลยร้อนใจมากเลย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050149
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050149,
					"content": "เล่าเหตุการณ์ที่เคยประสบพบเจอร่วมกันกับ Alrani...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731050113
					]
				},
				{
					"id": 731050113,
					"content": "ที่แท้เธอก็คือนักเดินทางคนที่ Alrani พูดถึงตลอดคนนั้น...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050114
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050114,
					"content": "ฉันชื่อ Niloofar เป็นนักวิชาการของสถาบัน... พวกเธอเองก็น่าจะพอมองออกใช่มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050115
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050115,
					"content": "ถึงฉันจะเป็นนักวิชาการ แต่ตอนนี้ฉันทุ่มความสนใจส่วนใหญ่ไปที่การชี้แนะเรื่องการวิจัยให้กับนักเรียนน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050116
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050116,
					"content": "Alrani ก็เป็นหนึ่งในนักเรียนของฉัน และเด็กคนนี้ก็มีปัญหาในการเขียนมาโดยตลอด...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050117
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050117,
					"content": "คุณ... คุณก็คืออาจารย์ที่ปรึกษาคนนั้นของ Alrani?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050118
					]
				},
				{
					"id": 731050118,
					"content": "Alrani บอกว่าอาจารย์ที่ปรึกษาบอกว่าวิทยานิพนธ์หลายฉบับของเขายังไม่ดีพอ เขาก็เลยต้องเขียนแล้วเขียนอีก...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050119,
					"content": "ไม่สิไม่สิ ตอนนี้ไม่ใช่เวลามาพูดถึงเรื่องนี้ เกิดอะไรขึ้นกับ Alrani เหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050120,
					"content": "เด็กคนนี้... เด็กคนนี้หายตัวไปแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050121
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050121,
					"content": "ก่อนหน้านี้ Alrani กลับมาจาก Inazuma พร้อมวิทยานิพนธ์ฉบับหนึ่ง เนื้อหาในวิทยานิพนธ์เกี่ยวกับการศึกษาวัฒนธรรมพื้นบ้านของเกาะ Watatsumi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050122,
						731050123
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050122,
					"content": "Alrani ตั้งใจเขียนวิจัยมาก",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050124
					]
				},
				{
					"id": 731050124,
					"content": "ฉันเห็นแล้วว่าวิทยานิพนธ์ฉบับนี้เขียนได้ดีมาก และได้รับคะแนนสูงในทุก ๆ ด้าน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050125
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050125,
					"content": "แต่... แต่เขากลับมาช้าไป! ฉันขอให้เขาส่งร่างฉบับแรกให้ฉันล่วงหน้า แต่ก็ไม่เคยได้รับการตอบกลับมาเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050126
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050126,
					"content": "ตอนที่เขากลับมาพร้อมกับวิทยานิพนธ์ฉบับเต็ม ก็มีคนส่งบทความที่มีเนื้อหาเดียวกันกับงานวิจัยของเธอมาแล้ว และทั้งหมดก็ผ่านการตรวจสอบเบื้องต้นแล้วด้วย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050127
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050127,
					"content": "ถึงฉันจะพยายามช่วยเขาให้ได้รับโอกาสอย่างเต็มที่ แต่วิทยานิพนธ์ของเขาก็ยัง... ก็ยังไม่ผ่าน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050128
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050128,
					"content": "ไม่น่าใช่นะ Alrani เริ่มเก็บข้อมูลมาตั้งแต่นานแล้วไม่ใช่เหรอ? ทำไมถึงยืดยาวมาถึงตอนนี้ได้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050129,
					"content": "เดี๋ยวนะ พูดถึง Inazuma... หรือว่า...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050130,
					"content": "กฎ... กฎ Sakoku!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050131
					]
				},
				{
					"id": 731050131,
					"content": "ทำไมถึงเป็นแบบนี้ล่ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050132,
					"content": "ฉันไม่รู้จะบอกข่าวนี้กับเขายังไงดี... ตอนแรกฉันวางแผนไว้ว่ารอสักสองสามวันจะบอกกับเขาแบบอ้อม ๆ ดู",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050133
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050133,
					"content": "แต่ก็ไม่รู้ว่าใครไปปากโป้งเอาข่าวนี้ไปบอกเขา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050134
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050134,
					"content": "จากนั้นเขาก็หายตัวไป ฉันค้นหาสถาบันจนทั่วแต่ก็ไม่เจอ ฉันก็เลยต้องไปส่งคำขอที่กิลด์นักผจญภัยน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050135
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050135,
					"content": "แต่นักผจญภัยก็ไม่เห็นเงาของเขาเลย เจอก็แต่สมุดบันทึกของ Alrani",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050136
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050136,
					"content": "ตอนนี้ พวกนักผจญภัยคงกำลังค้นหาเบาะแสของ Alrani กันอยู่...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050137
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050137,
					"content": "ฉัน...ฉันเองก็ไม่รู้ว่าจะทำยังไงดี ฮือ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050138,
						731050140
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050138,
					"content": "ฉันเองก็จะไปช่วยตามหา Alrani ด้วย",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050139
					]
				},
				{
					"id": 731050139,
					"content": "จริงสิ พวกเราก็จะช่วยด้วย! เริ่มหาจาก... เริ่มหาจากตำแหน่งที่เจอสมุดบันทึกแล้วกัน!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050142,
					"content": "เธออยากช่วยเหรอ? ขอบคุณมากเลย ขอบคุณมากจริง ๆ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050143
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050143,
					"content": "ฉันจะทำเครื่องหมายตำแหน่งของสมุดบันทึกไว้บนแผนที่ให้นะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050144
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050144,
					"content": "จริงสิ แล้วก็มีค่าตอบแทนให้ด้วย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050145,
						731050146
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050145,
