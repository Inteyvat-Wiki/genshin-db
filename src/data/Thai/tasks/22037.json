			"dialogs": [
				{
					"id": 220370201,
					"content": "เห็ดพวกนี้เกิดขึ้นมาได้ไงนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370202,
						220370203
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370202,
					"content": "ฉันมากำจัดเห็ดแล้ว!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370205
					]
				},
				{
					"id": 220370205,
					"content": "Vahid ส่งเธอมาช่วยฉันกำจัดเห็ดเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370206
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370206,
					"content": "อ่า งั้นก็รบกวนเธอด้วยนะ เห็ดในไร่นาโตเร็วมากจริง ๆ คนแก่อย่างฉันเก็บไม่ทันแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370207
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370207,
					"content": "เห็ดพวกนี้ ทำไมโตเร็วขนาดนี้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370203,
					"content": "ขอโทษด้วยนะ ที่เพิ่มปัญหาเรื่องเห็ดให้คุณ!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370204
					]
				},
				{
					"id": 220370204,
					"content": "เพิ่มปัญหาเรื่องเห็ด? อ่า ที่โต๊ะอาหารบ้านฉันไม่เคยขาดแคลนเห็ดหรอกนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370205
					],
					"speakerTitle": "Konda Densuke"
				}
			]
