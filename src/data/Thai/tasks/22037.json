				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220370101,
					"content": "แย่แล้ว... ทำไมกลายเป็นแบบนี้?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370102
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370102,
					"content": "เป็นอะไรเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370103
					]
				},
				{
					"id": 220370103,
					"content": "นักเดินทาง ฉันกำลังหาเธออยู่พอดีเลย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370104
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370104,
					"content": "คุณจำลูกค้าที่ชื่อ Konda Densuke ได้มั้ย? เขามาถามเกี่ยวกับปุ๋ยที่ร้านเมื่อวันก่อน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370105
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370105,
					"content": "เขาพอใจในปุ๋ยของร้านไหม?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370106
					]
				},
				{
					"id": 220370106,
					"content": "ไม่เกี่ยวกับเรื่องพอใจหรือไม่พอใจหรอก พูดให้ถูกคือ คุณ Konda Densuke กำลังเคว้งคว้าง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370107
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370107,
					"content": "เคว้งคว้าง?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370108
					]
				},
				{
					"id": 220370108,
					"content": "เอ่อ คืออย่างงี้ หลังจากที่เธอไปโปรโมทสินค้าครั้งที่แล้ว คุณ Densuke ได้ผสมปุ๋ยของเรา ตามวิธีที่เธอบอก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370109
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370109,
					"content": "ถึงแม้ว่าหลังจากนั้นพืชจะเติบโตขึ้นก็ตาม แต่ในขณะเดียวกัน... มีเห็ดจำนวนมากผุดขึ้นมาโดยไม่รู้สาเหตุ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370110
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370110,
					"content": "หลังจากที่คุณ Densuke บอกฉันเรื่องนี้ บอกตามตรง ฉันเองก็มึนเหมือนกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370111
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370111,
					"content": "ไม่ว่ายังไง เรื่องนี้จะต้องเกี่ยวกับปุ๋ยที่ใส่ลงไปแน่ ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370112
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370112,
					"content": "นักเดินทาง ช่วยไปที่หมู่บ้าน Konda เพื่อช่วยคุณ Densuke กำจัดเห็ดพวกนั้นหน่อยได้มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370113,
						220370116
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370113,
					"content": "ให้ฉันจัดการเอง",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370114
					]
				},
				{
					"id": 220370114,
					"content": "งั้นก็รบกวนเธอด้วยนะ ฉันจะตรวจสอบข้อมูลอยู่ที่ร้านอีกครั้ง ดูซิว่าอะไรเป็นสาเหตุของเรื่องนี้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370115
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370115,
					"content": "เฮ้อ ถ้า Alrani อยู่ที่นี่ก็ดีสิ เธอจะต้องหาสาเหตุของเรื่องนี้ได้แน่นอน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370116,
					"content": "ทำไมไม่ขอให้ Alrani ช่วยวิจัยปัญหาพวกนี้ล่ะ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370117
					]
				},
				{
					"id": 220370117,
					"content": "หากว่าเธออยู่ล่ะก็ จะต้องหาสาเหตุจริง ๆ ได้แน่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370118
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370118,
					"content": "แต่ตอนนี้เธอยังไม่กลับมา ไม่รู้ว่าเธอไปไหนเหมือนกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370119
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370119,
					"content": "รบกวนเธอด้วยนะ นักเดินทาง ฉันจะตรวจสอบข้อมูลอยู่ที่ร้านอีกครั้ง ดูซิว่าอะไรเป็นสาเหตุของเรื่องนี้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vahid"
				}
			]
		},
