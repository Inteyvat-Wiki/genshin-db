			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jinwu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710890201,
					"content": "พี่ Jinwu พวกเราเจออันนี้ด้วยล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710890202,
					"content": "โอเค ๆ ไม่ต้องรีบร้อนขนาดนั้น ไหนพวกเธอไปเจออะไรมา? เกี่ยวข้องกับที่อยู่ของ Zhiqiong มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890203
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890203,
					"content": "เป็นจดหมายที่เธอทิ้งเอาไว้น่ะ เธอเข้าไปที่ส่วนลึกอยู่ลึกเข้าไปของ Chasm น่ะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710890204
					]
				},
				{
					"id": 710890204,
					"content": "...ขอบคุณนะ ขอฉันดูหน่อยว่าหล่อนเขียนไว้ว่ายังไง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890205
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890205,
					"content": "Jinwu อ่านจดหมายของ Zhiqiong อย่างละเอียด",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710890206
					]
				},
				{
					"id": 710890206,
					"content": "เด็กคนนี้นะ...ฉันไม่เคยนึกถึงปัญหาที่ใหญ่ขนาดนี้มาก่อน แล้วก็ไม่อาจวิจารณ์ทางเลือกของหล่อนได้ แต่บางที...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890207
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890207,
					"content": "บางทีอาจเป็นเพราะฉันไม่มีเวลามาสนใจกับการค้นพบของหล่อน ให้ความเคารพและความเข้าใจกับหล่อนไม่เพียงพอล่ะมั้ง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890208
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890208,
					"content": "ทั้ง ๆ ที่ถ้าไม่มีแผนที่ของหล่อน การสำรวจในภายหลังก็ยากที่จะสำเร็จได้... ฉันก็มัวแต่เป็นห่วงเรื่องสุขภาพของหล่อน แต่กลับละเลยความพยายามและความสำเร็จที่หล่อนทุ่มเททำมันขึ้นมา...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890209
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890209,
					"content": "เพราะยังไงหล่อนก็ต่างจากคนงานเหมืองอย่างพวกเราตั้งแต่แรกอยู่แล้ว ทำไมฉันไม่คิดถึงจุดนี้เลยนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890210
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890210,
					"content": "เธอก็แค่ไม่อยากถูกลืมน่ะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710890211
					]
				},
				{
					"id": 710890211,
					"content": "สำหรับพวกเราคนธรรมดาที่ทวยเทพไม่ได้โปรดปราน จะมีใครล่ะที่ไม่เป็นแบบนั้น...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890212
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890212,
					"content": "ใครล่ะที่ไม่เป็นแบบนั้น...แต่จะมีใครล่ะที่หมกมุ่นอยู่กับมันเหมือนหล่อนล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890213
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890213,
					"content": "แต่พอนึกได้ว่าช่วงเวลานึงตัวเองเคยเลิกหมกมุ่นกับการทำให้ตัวเองยิ่งใหญ่... พอรู้ตัวว่าเริ่มชินกับความธรรมดาที่ซ้ำไปซ้ำมาอยู่ทุกวัน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890214
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890214,
					"content": "ก็ชักจะไม่มีหน้าไปวิจารณ์ตัดสิน Zhiqiong แล้วล่ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				}
			]
		}
	]
}