				"points": []
			},
			"dialogs": [
				{
					"id": 750460101,
					"content": "ฮือฮือฮือ... ฮือ... รีบกลับมาเถอะ ฮือฮือฮือ... ฮือ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460102
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460102,
					"content": "สวัสดี",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750460103
					]
				},
				{
					"id": 750460103,
					"content": "ฮือฮือ...ฮือ เฮ้อ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460104
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460104,
					"content": "ฉันไม่ดีเอง ตรงนี้ เสียใจ ทำใจไม่ได้เลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460105
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460105,
					"content": "ฉันแค่ออกไปซื้อฟางแป๊บเดียวเอง Tatankasaurus น้อยที่เลี้ยงไว้อีกแปดตัวก็หายไปไหนแล้วไม่รู้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460106
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460106,
					"content": "พวกมันยังตัวเล็กขนาดนั้น ถ้าถูกพวก Hilichurl ที่อยู่ข้างนอกรังแกขึ้นมาจะทำยังไง? ถ้าเกิดหลงทางขึ้นมาจะเป็นยังไง? แล้วถ้าถูกขังอยู่ล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460107
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460107,
					"content": "คนใจดี คุณเห็น Tatankasaurus น้อยที่ฉันเลี้ยงไว้มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460108
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460108,
					"content": "พวกมันหน้าตาเป็นยังไงเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750460109
					]
				},
				{
					"id": 750460109,
					"content": "แม่ของ Tatankasaurus ทั้งแปดตัวนี้ ฉันเลี้ยงมาเองกับมือ ไม่ต่างอะไรกับลูกสาวของฉันเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460110
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460110,
					"content": "เธอเป็น Saurian ที่งดงามที่สุดของเผ่าผองสรรพสิ่ง แถมยังเคยชนะรางวัลพิเศษ ในการประกวดความงามของพื้นที่เราด้วย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460111
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460111,
					"content": "เจ้าตัวแสบทั้งแปดตัวของฉัน ได้ความงามมาจากแม่ของพวกมัน ทั้งผิวขาวเนียนอมชมพู บนเขาสวยทรงพัดที่สมมาตรมีสีม่วงแต้มอยู่ด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460112
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460112,
					"content": "ถ้าคุณเจอพวกมัน ก็ช่วยหาวิธีพาพวกมันกลับมาหาฉันทีนะ ขอร้องล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460113
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460113,
					"content": "Saurian น้อยของฉัน... ปู่จะไม่ดุพวกแกอีกแล้ว...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460118
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460118,
					"content": "ฉันจะช่วยดูให้นะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750460119
					]
				},
				{
					"id": 750460119,
					"content": "ขอบคุณมากนะ คนใจดี วันนี้คุณจะต้องยกบาร์เบลทำลายสถิติได้แน่นอน แถมดึงข้อยังไงก็ไม่มีทางเป็นตะคริวแน่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Urubamba"
				}
			]
		},
