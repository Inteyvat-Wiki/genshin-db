				"points": []
			},
			"dialogs": [
				{
					"id": 765010101,
					"content": "#เอ๊ะ {NICKNAME} กับ Paimon นี่เอง เมื่อกี้นกที่บินอยู่ในป่าเพิ่งจะพูดถึง การมาถึงของพวกเธออยู่เลย วันนี้พวกเธอมาเพราะมีเรื่องสำคัญเหรอ หรือว่า... อยากให้ฉันช่วยนำทางให้?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010102,
						765010103
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010102,
					"content": "เรากำลังเยี่ยมชมบริเวณรอบ ๆ นี้",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010104
					]
				},
				{
					"id": 765010104,
					"content": "ที่นี่อุดมด้วยแสงจันทร์ ทั้งพืชพรรณและสิ่งมีชีวิตที่อาศัยอยู่ที่นี่ ล้วนแตกต่างจากโลกภายนอก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010105
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010105,
					"content": "เป็นสถานที่ที่เหมาะจะถ่ายภาพที่มีค่าไว้จริง ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010106
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010106,
					"content": "เชิญทั้งสองคนเดินสำรวจตามสบายเลย ถ้ามีคำถามอะไรก็มาถามฉันได้ตลอดเวลาเลยนะ ฉันจะพยายามตอบอย่างเต็มที่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010107,
						765010108
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010107,
					"content": "บรรยากาศที่นี่เงียบสงบมาก",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010109
					]
				},
				{
					"id": 765010109,
					"content": "ใช่แล้ว ที่นี่เป็นสถานที่ที่ฉันทำสมาธิ และยังเป็นที่ที่ฉันสื่อสารกับสรรพสิ่งด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010110
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010110,
					"content": "แค่ยืนอยู่ตรงนี้ จิตใจก็กลับมาสงบแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010111
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010111,
					"content": "ว้าว ฟังดูแล้วสุนทรีย์มากเลย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010112,
						765010113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765010112,
					"content": "ที่จริง ฉันมีเรื่องอยากจะขอร้องหน่อยน่ะ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010114
					]
				},
				{
					"id": 765010114,
					"content": "ใช่ Lauma ยืนตรงนี้เข้ากับทิวทัศน์ของที่นี่มากเลย อย่างกับภาพวาดเลยแหนะ! ถ้าใช้กล่องถ่ายรูปถ่ายไว้ ต้องสวยมากแน่ ๆ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765010115,
					"content": "ถ่ายรูป... ให้ฉันเหรอ? นี่เป็นประสบการณ์ที่แปลกใหม่ดีนะ ถ้าพวกเธอคิดว่าความสงบสุขในตอนนี้ รวมถึงรูปลักษณ์ของฉัน มีค่าให้บันทึกไว้ในกล้องของพวกเธอ ฉันก็ยินดีมากเลยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010116
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010116,
					"content": "ได้เป็นความทรงจำที่ดีในการเดินทางของพวกเธอ ก็ถือเป็นเกียรติของฉันเหมือนกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010117
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010117,
					"content": "ถ้างั้น ฉันควรทำยังไงดี? ฉันต้องมองไปทางไหน หรือฉันทำท่าทางตามสบายก็พอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010118,
						765010119
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010118,
					"content": "ทำตัวปกติก็พอ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010120
					]
				},
				{
					"id": 765010120,
					"content": "ได้เลย งั้นจากนี้ก็ฝากเธอด้วยนะ ขอให้เธอคว้าแสงแรงบันดาลใจที่แวบเข้ามาได้นะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010119,
					"content": "ฉันจะพยายามจับภาพช่วงเวลา ที่น่าประทับใจที่สุดเอาไว้",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010120
					]
				},
				{
					"id": 765010113,
					"content": "เราอยากถ่ายรูปให้เธอน่ะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010114
					]
				},
				{
					"id": 765010108,
					"content": "ปกติ Lauma จะอยู่แถวนี้เหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010109
					]
				},
				{
					"id": 765010103,
					"content": "ถือโอกาสหาองค์ประกอบถ่ายรูปน่ะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010104
					]
				}
			]
		},
