			"dialogs": [
				{
					"id": 10200701,
					"content": "หืมมม? บินมาได้ถึงแค่นี้เหรอ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200702,
					"content": "เพราะสนามลมแรงไม่พอน่ะสิ ไม่งั้นก็ไปถึงยอดได้แล้ว!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200703,
					"content": "กลับ Liyue กันเถอะ... ลองไปถามกองทหาร Millelith ดู",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200704
					]
				},
				{
					"id": 10200704,
					"content": "หืม? ทำไมล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200705,
					"content": "วิธีขึ้นไปไม่น่าจะเป็นความลับ ไม่งั้น...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200706
					]
				},
				{
					"id": 10200706,
					"content": "ไม่งั้น? ...อ่า เข้าใจแล้ว ไม่งั้น Ganyu คงไม่ให้เรามาที่ Jade Chamber เองหรอกใช่มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200707,
					"content": "เอาล่ะ งั้นก็ทำตามที่เธอบอกก็แล้วกัน พวกเรา...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200708,
					"content": "อ่า! เดี๋ยวก่อน เธอดูข้างล่างสิ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200709,
					"content": "ดูเหมือนเราจะอยู่ใกล้กับ <color=#00E1FFFF>Guizhong Ballista</color> ล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200710,
					"content": "ถ้าเป็นแบบนี้ล่ะก็... เอ่อ... Paimon มีไอเดียใหม่ด้วย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200711,
					"content": "เราลองใช้ Guizhong Ballista ยิงเพื่อส่งเธอขึ้นไปดีมั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200712,
						10200714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200712,
					"content": "ไม่เอาอ่ะ นั่นตายได้เลยนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200713
					]
				},
				{
					"id": 10200713,
					"content": "โอ้... จริงด้วย ลืมคิดเรื่องความปลอดภัยไปเลย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200716,
					"content": "แต่ฉันจำได้ว่า Guizhong Ballista มีฟังก์ชันส่องทางไกลด้วยนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200717
					]
				},
				{
					"id": 10200717,
					"content": "อ่า จริงสิ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200718,
					"content": "อย่างนั้นเราก็ใช้มันให้เป็นประโยชน์ได้สินะ... งั้นมาใช้ Guizhong Ballista มองหาดูแถว ๆ นี้ ว่ามีทางขึ้นไปรึเปล่า!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200714,
					"content": "หรือว่าเธอเกลียดฉันมากเลยรึไง?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200715
					]
				},
				{
					"id": 10200715,
					"content": "อ่าา... ก็แค่ลืมคิดเรื่องความปลอดภัยไปเท่านั้นเองน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200716
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
