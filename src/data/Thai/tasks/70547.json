					"Valerina"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705470101,
					"content": "อ๋า เป็นผู้ช่วยชีวิตเจ้าเหมียวกับนักเวทเหมียวขาวนี่เอง! พวกเธอมาสักทีนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470102
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470102,
					"content": "เอ๋? เมื่อกี้เธอเรียกพวกเราว่าอะไรนะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470103,
						705470104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705470103,
					"content": "ฟังดูคุ้น ๆ นะ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470105
					]
				},
				{
					"id": 705470105,
					"content": "อือ... รู้สึกว่าเราน่าจะเคยเจอกันมาก่อนนะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705470106,
					"content": "ฮ่าฮ่า! นักเวทเหมียวขาวยังจำฉันได้ ถือเป็นความสำเร็จของ Valerina เลยนะเนี่ย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470107
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470107,
					"content": "เรื่องรำลึกความหลังน่ะเอาไว้ก่อนเถอะ ตอนนี้มาลองเล่นเกมใหม่ที่ฉันเป็นสปอนเซอร์ดีมั้ย? มันทำให้ฉันมีความสุขมาตลอดทั้งอาทิตย์เลยนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470108
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470108,
					"content": "ศึกอลหม่านระเบิด Dodoco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470109
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470109,
					"content": "มะ...มี Dodoco หลายประเภทเลย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470110,
						705470111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705470110,
					"content": "แถมแต่ละประเภทก็ดูคุ้นตามากด้วย",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470112
					]
				},
				{
					"id": 705470112,
					"content": "ดูสิ ผู้ช่วยชีวิตเจ้าเหมียว... อะแฮ่ม ต้องเรียกว่าอัศวินผู้มีเกียรติที่เคารพ! ผู้เปล่งประกายเจิดจรัสมากกว่าสิ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470113
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470113,
					"content": "ตุ๊กตา Dodoco ตัวนี้ออกแบบโดยยึดคุณเป็นต้นแบบเลยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470114
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470114,
					"content": "#จะ...จริงด้วย ทั้งสีสันและลวดลายก็ดูเป็นสไตล์ของ {NICKNAME} ทั้งนั้นเลย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705470115,
					"content": "ภายในเกม Dodoco ดอกไม้เพลิง, Dodoco แสงวิบวับ, Dodoco ทหารม้า และ Dodoco เวทมนตร์ต้องร่วมมือกัน ใช้ระเบิดเอาชนะศัตรูที่ไม่เคยเจอมาก่อน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470116
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470116,
					"content": "ฉันรับผิดชอบเป็นสปอนเซอร์ และการดำเนินการเกมเท่านั้น ไม่รู้รายละเอียดของการพัฒนา และไม่รู้ว่าจริง ๆ แล้วต้นแบบของศัตรูพวกนี้หน้าตาเป็นยังไง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470117
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470117,
					"content": "แต่ฉันเชื่อว่า ต่อให้วันไหนเราได้เจอกันจริง ๆ Dodoco ผู้น่าทึ่งก็ต้องเอาชนะพวกมันได้แน่นอน!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470118
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470118,
					"content": "แน่นอนอยู่แล้ว ไม่ว่ามอนสเตอร์ตัวไหนก็หยุด Klee กับคู่หู Dodoco ของเธอไม่ได้หรอก พวกเราก็คิดแบบนั้นเหมือนกัน!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470119,
						705470120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705470119,
					"content": "งั้นก็มาลองเล่นกันเถอะ!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470121
					]
				},
				{
					"id": 705470121,
					"content": "ฮี่ฮี่ พวกคุณจะต้องสนุกกับมันแน่นอน!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470120,
					"content": "เกม Dodoco เกมใหม่!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470121
					]
				},
				{
					"id": 705470111,
					"content": "มองต้นแบบออกได้ง่าย ๆ เลย",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470112
					]
				},
				{
					"id": 705470104,
					"content": "เป็นฉายาใหม่ที่ไม่เคยได้ยินมาก่อนเลย...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470105
					]
				}
			]
		}
	]
}