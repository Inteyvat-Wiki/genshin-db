				"points": []
			},
			"dialogs": [
				{
					"id": 210240601,
					"content": "ดูแล้วไม่น่ามีประโยชน์อะไร...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240602
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240602,
					"content": "ขอถามหน่อยสิ คุณเคยเห็นกล่อง ๆ หนึ่งบ้างมั้ย...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210240603
					]
				},
				{
					"id": 210240603,
					"content": "กล่อง? โอ้ ฉันเก็บกล่อง ๆ หนึ่งได้พอดี",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240604
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240604,
					"content": "ฉันเปิดดูแล้ว มันคือรายการสินค้าล็อตหนึ่งน่ะ ดูแล้วเป็นล็อตใหญ่เลยทีเดียว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240605
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240605,
					"content": "ไอ้หยา แต่ก็ไม่รู้ว่าเจ้าของเจ้ากล่องจะยอมจ่ายสักเท่าไหร่เพื่อเอากล่องนี้กลับไป...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240606
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240606,
					"content": "...หมายความว่ายังไง?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210240607
					]
				},
				{
					"id": 210240607,
					"content": "อย่าเครียดขนาดนั้นสิ ฉันแค่ล้อคุณเล่นน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240608
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240608,
					"content": "มูลค่าของรายการสินค้าที่จดไว้ในนี้ไม่น้อยเลย ไม่รู้ว่าเถ้าแก่คนไหนของท่าเรือ Liyue ที่มือหนักขนาดนี้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240609
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240609,
					"content": "ฉันก็ไม่ใช่คนที่ไม่รู้กาลเทศะ เมื่อรู้ว่าเป็นแผ่นเหล็ก ก็ไม่มีเหตุผลที่จะไปเตะมัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240610
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240610,
					"content": "ว่าแต่ฉันทุ่มเททั้งกายและใจเก็บรักษารายการสินค้าขนาดนี้ คุณพูดแค่ประโยคเดียวก็จะไปแล้วอย่างงั้นเหรอ นี่มัน...จะไม่น่าเกลียดไปหน่อยหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240611
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240611,
					"content": "เอางี้เรามาใช้วิธีดั้งเดิม \"การแลกเปลี่ยนของ\" มาแก้ปัญหานี้กัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240612
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240612,
					"content": "คุณไปหา Noctilucous Jade มาให้ฉันสักสามอันสิ แล้วฉันจะให้รายการสินค้ากับคุณ โอเคมั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240613
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240613,
					"content": "ถ้าเทียบกับรายการสินค้าล็อตใหญ่เหล่านี้ที่จดเอาไว้แล้ว... Noctilucous Jade 3 อันนี้ก็ไม่เท่าไหร่เอง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240614,
						210240616
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240614,
					"content": "ฉันรู้แล้ว",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210240615
					]
				},
				{
					"id": 210240615,
					"content": "งั้นคุณรีบไปเถอะ หาเจอแล้วเราค่อยมายื่นหมูยื่นแมวกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240616,
					"content": "...ในนี้จดการค้าขายอะไรเอาไว้?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210240618
					]
				},
				{
					"id": 210240618,
					"content": "คุณไม่รู้เหรอ? ว่าคุณน่ะแค่มาทำธุระแทนคนอื่นเค้า...เอ่ แต่แบบนี้ก็ดีเหมือนกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240619
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240619,
					"content": "ฟังฉันนะ การค้าขายแบบนี้ คุณไม่ต้องไปถามอะไรมากจะดีกว่า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240620
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240620,
					"content": "เอาล่ะ คุณไปเอา \"Noctilucous Jade\" มาให้ฉัน แล้วฉันจะเอารายการสินค้าให้คุณ แล้วคุณค่อยเอารายการสินค้านั้นไปให้คนที่วานให้คุณมาทำธุระคนนั้น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240621
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240621,
					"content": "ทำธุระเสร็จ หมดจด หมดปัญหากวนใจ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				}
			]
		},
