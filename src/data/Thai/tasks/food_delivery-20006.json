			"dialogs": [
				{
					"id": 200060101,
					"content": "ออเดอร์เดลิเวอรี่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060102
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060102,
					"content": "ยินดีต้อนรับสู่ Good Hunter... นักเดินทาง? มาพอดีเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060103
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060103,
					"content": "ขอโทษนะ ฉันรู้ว่าเธอหิวจะแย่อยู่แล้ว แต่ยังไงช่วยฉันหน่อยได้มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060104
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060104,
					"content": "คุณ Orlean ที่ Springvale สั่ง <color=#00E1FFFF>Sticky Honey Roast</color> หนึ่งที่ แต่ฉันได้ยินว่าช่วงนี้ที่ Springvale มีพวก Slime ออกมาป้วนเปี้ยนอยู่บ่อย ๆ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060105
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060105,
					"content": "ฉันไม่กล้าไปเอง...ช่วยฉันส่งอาหารนี้ไปให้ <color=#00E1FFFF>Orlean ที่ Springvale</color> หน่อยได้มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060106,
						200060107
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060106,
					"content": "โอเค แต่ว่า...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200060108
					]
				},
				{
					"id": 200060108,
					"content": "รอเธอกลับมาแล้ว จะต้องจัดมื้อใหญ่ให้ซักมื้อแน่นอน!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060109
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060109,
					"content": "ช่วยหน่อยนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060107,
					"content": "หิวจังเลย ฉันแค่จะมาหาข้าวกินน่ะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200060110
					]
				},
				{
					"id": 200060110,
					"content": "รอเธอช่วยฉันเสร็จแล้ว ฉัน ฉันจะสั่งอาหารจานพิเศษของ Good Hunter ให้กับเธอ ยังไงช่วยหน่อยนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				}
			]
		},
