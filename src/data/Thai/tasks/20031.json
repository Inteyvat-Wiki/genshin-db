			"dialogs": [
				{
					"id": 200310101,
					"content": "เจอกันอีกแล้วนะ ดาวดวงใหม่แห่งพี่น้องนักผจญภัย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310102,
					"content": "เป็นไงบ้าง การผจญภัยช่วงนี้ราบรื่นดีมั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310103,
						200310105
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310103,
					"content": "ราบรื่นมากเลย",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310104
					]
				},
				{
					"id": 200310104,
					"content": "สปิริตดีมาก ขอให้เป็นอย่างนี้ต่อไปเรื่อย ๆ นะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310107,
					"content": "เท่าที่ดูตอนนี้เธอก็รวบรวม Exp ได้เยอะแล้วนะ ได้เวลาแนะนำงานสำคัญของกิลด์นักผจญภัยให้เธอแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310108
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310108,
					"content": "ในแต่ละวันทางกิลด์นักผจญภัยจะได้รับ<color=#00E1FFFF>คำขอ</color>มาจากทั่วทุกหนแห่ง และก็จัดการกระจายงานไปสู่นักผจญภัยทั้งหลาย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310109
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310109,
					"content": "นี่เป็นแหล่งที่มาหลักของรางวัลสำหรับนักผจญภัย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310110
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310110,
					"content": "คำขอเป็นยังไงบ้างเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200310111,
					"content": "แบบไหนก็มีทั้งนั้น ตั้งแต่ช่วยชาวบ้านจนถึงจัดการกับมอนสเตอร์ มีทั้งงานง่ายและงานอันตราย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310112
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310112,
					"content": "โบราณว่าสิบปากว่าไม่เท่าตาเห็น ลองทำดูเดี๋ยวก็เข้าใจเองแหละนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310113
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310113,
					"content": "นี่คือเนื้อหาคำขอในวันนี้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310114
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310114,
					"content": "ยังไงถ้าทำเสร็จแล้วก็ช่วยมารายงานฉันทีนะ แล้วฉันจะมอบรางวัลให้อย่างงามเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310115,
						200310117
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310115,
					"content": "ให้ฉันจัดการเอง",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310116
					]
				},
				{
					"id": 200310116,
					"content": "#สมแล้วที่เป็น {NICKNAME} พึ่งพาได้จริง ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310119
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310119,
					"content": "#งั้นฉันรอฟังข่าวจากเธอที่นี่นะ {NICKNAME} จงมุ่งสู่ดวงดาวและก้นเหว!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310117,
					"content": "งามแค่ไหนกัน?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310118
					]
				},
				{
					"id": 200310118,
					"content": "อย่ารีบร้อน รอลุ้นไปก่อนเถอะ ไม่ทำให้ผิดหวังแน่นอน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310119
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310105,
					"content": "เหนื่อยเหมือนกันนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310106
					]
				},
				{
					"id": 200310106,
					"content": "ตอนเริ่มก็อย่างนี้แหละ เตรียมตัวให้ดีก่อนที่จะเริ่มจะช่วยให้เธอผจญภัยได้สบายยิ่งขึ้น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310107
					],
					"speakerTitle": "Katheryne"
				}
			]
		},
