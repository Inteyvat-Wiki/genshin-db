							4642.497
						],
						"pointId": 4927
					}
				]
			},
			"dialogs": [
				{
					"id": 740620301,
					"content": "(ฟังจากที่ Nakul พูดแล้ว ถ้าไม่ใช่ชาว Fontaine ละก็ ดูเหมือนเขาจะปฏิเสธนะ? แบบนี้เขาก็คงไม่สนใจเราเหมือนกันสิ? มีวิธีอะไรดี ๆ บ้างมั้ยนะ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620302,
					"content": "(เคาะประตู)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620303
					]
				},
				{
					"id": 740620303,
					"content": "ใครน่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620304,
						740620306,
						740620309
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620304,
					"content": "นักเดินทางนิรนาม เป็นนักผจญภัยที่เดินทางไปทั่วทุกประเทศ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620305
					]
				},
				{
					"id": 740620305,
					"content": "...ที่นี่กลายเป็นจุดชมวิวตั้งแต่เมื่อไหร่กัน?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620312
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620312,
					"content": "#{NICKNAME} จริงจังหน่อยสิ อย่าลืมเป้าหมายของเราสิ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620313,
						740620378
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620313,
					"content": "พวกเราได้รับคำขอมา และมีเรื่องอยากจะคุยกับคุณ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620314
					]
				},
				{
					"id": 740620314,
					"content": "เรื่องมันเป็นแบบนี้ พวกเราได้รับคำขอให้มาเจรจากับคุณ ไม่ทราบว่าคุณยินดีจะปล่อยเช่าห้องนี้มั้ย? แน่นอนว่าผู้มอบหมายคำขอจะจ่ายคูปองสวัสดิการให้เป็นค่าตอบแทนด้วย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620315,
					"content": "ก่อนหน้านี้ก็เหมือนจะมีเรื่องแบบนี้เกิดขึ้น... ซ้ำแล้วซ้ำเล่า ไม่รู้จักยอมแพ้ซะจริง ๆ คนที่พูดจาปลอม ๆ นั่นเป็นคนส่งพวกเธอมาล่ะสิท่า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620316
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620316,
					"content": "ช่างเถอะ เห็นแก่ความพยายามของเขา... พวกเธอเสนอราคามาสิ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620317
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620317,
					"content": "(เยี่ยมเลย ดูท่าก็ไม่ใช่ว่าจะไม่มีวิธีเจรจาเลยนี่นา)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620318,
					"content": "(Nakul ได้บอกราคาที่คาดหวังของเขาให้เราแล้ว ถ้าเราเสนอราคาละก็ จะบอกราคาสูงสุดตามตรงตั้งแต่แรกเลยมั้ย? หรือจะลองกดราคาดี?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620319,
						740620356
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620319,
					"content": "(บอกราคาสูงสุดตามตรง)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620320
					]
				},
				{
					"id": 740620320,
					"content": "โอเค งั้นฉันบอกตามตรงเลยก็แล้วกัน ราคาที่ผู้มอบหมายคำขอคาดหวังไว้ก็คือคูปองสวัสดิการ 54,000 ใบ ฉันว่าคุ้มค่ามากเลยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620321,
					"content": "54,000? เพิ่มขึ้นจากเจ้าบ้าที่มาเคาะประตูคราวก่อน... แค่ 10% แค่นี้มันไม่ได้เพิ่มมากมายอะไรเลยนะ น่าเบื่อจริง ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620322
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620322,
					"content": "นี่ยังน้อยอีกเหรอ? ฉันว่ามันเยอะมากแล้วนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620323,
					"content": "ไม่รู้เรื่องเลยจริง ๆ พวกเธอรู้จัก Carranza รึเปล่า? เขาทุ่มหนักกว่านี้อีกนะ เขายอมจ่าย... 108,000 ใบเลยนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620324
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620324,
					"content": "จริงเหรอ? เยอะขนาดนั้นเชียว?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620325,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620326
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620326,
					"content": "...ก็...ก็ต้องจริงน่ะสิ เธอเห็นฉันเป็นคนโกหกหลอกลวงรึไง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620327
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620327,
					"content": "กั้นประตูแบบนี้ พวกเรามองไม่เห็นอะไรสักอย่างเลยต่างหาก!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620328,
					"content": "(น้ำเสียงของเขาดูไม่ค่อยมีความมั่นใจสักเท่าไหร่เลย ไม่แน่อาจจะกำลังแต่งเรื่องหลอกเราอยู่ก็ได้)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620329,
					"content": "#({NICKNAME} พวกเราจะต่อรองยังไงดีล่ะ?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620330,
						740620340
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620330,
					"content": "(ความจริงก็มีอยู่เท่านี้ บอกเขาไปตามนี้ก็พอแล้วล่ะ)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620331
					]
				},
				{
					"id": 740620331,
					"content": "พวกเราบอกตามตรงตั้งแต่แรกแล้ว ว่าให้ได้แค่ 54,000 เท่านั้น 108,000 มันเวอร์เกินไปจริง ๆ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620332,
					"content": "ถ้าคุณไม่ยินดีละก็ งั้นพวกเรา... พวกเราก็ไม่มีวิธีอื่นที่ดีกว่านี้ นอกจากต้องยอมแพ้เท่านั้นแหละ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620333,
					"content": "ก็แค่ต้องรอก่อน... รออีกสักพักก็จะขึ้นราคาเอง ไว้พวกเธอมาคราวหน้า หรือหลังจากคราวหน้า พวกเธอก็จะมีราคาที่สูงกว่านี้มาให้แน่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620334
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620334,
					"content": "ฉันคิดไว้ไม่ผิดแน่! จะต้องขึ้นราคาชัวร์! เพราะงั้นฉันเลยอดทนไว้ก่อน! จะยอมตกลงด้วยง่าย ๆ ไม่ได้หรอก...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620335
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620335,
					"content": "พูดซะมั่นอกมั่นใจขนาดนี้ คุณยึดตามหลักอะไรเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620336,
					"content": "ก็ต้องจากประสบการณ์น่ะสิ! ประสบการณ์สองครั้งก่อนบอกฉันว่า ตราบใดที่ฉันไม่ขัดจังหวะซะก่อน ราคาก็จะต้องขึ้นไปเรื่อย ๆ แน่ มันก็เป็นหลักการง่าย ๆ ไม่ใช่รึไง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620337
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620337,
					"content": "หลักการอะไรเนี่ย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620338
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620338,
					"content": "เธอเป็นแค่เด็กน้อย แน่นอนว่าไม่เข้าใจอะไรหรอก ยังไงก็เถอะ ตอนนี้ยังไม่ถึงเวลา ฉันไม่มีทางตอบตกลงหรอก พวกเธอไปเถอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620339
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620339,
					"content": "#อืม... ดูเหมือนว่าเขาจะไม่เปลี่ยนใจนะ {NICKNAME} พวกเรากลับไปบอก Nakul กันเถอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620340,
					"content": "(เขาคิดจะหลอกเรา งั้นก็เล่นกับเขาหน่อยละกัน)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620341
					]
				},
				{
					"id": 740620341,
					"content": "ฮือฮือ... ไม่คิดเลยว่า Carranza จะเป็นคู่ต่อสู้ที่แข็งแกร่งขนาดนี้ ไม่ว่ายังไงฉันก็เทียบไม่ติดเลยจริง ๆ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620342
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620342,
					"content": "#{NICKNAME} พวกเรากลับไปบอก Nakul กันเถอะ ว่าราคาที่เขาเสนอมันต่ำเกินไปจนไม่ถูกใจเขาเลยสักนิด",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620343
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620343,
					"content": "คุณที่อยู่หลังประตูนั่นน่ะ ขอให้คุยกับคุณ Carranza อย่างมีความสุขนะ พวกเราขอตัวก่อนล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620344
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620344,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620345
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620345,
					"content": "...เอ๋? จะไปแบบนี้เลยเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620346
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620346,
					"content": "เฮ้ พวกเธอยังอยู่รึเปล่า?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620347
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620347,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620348
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620348,
					"content": "เฮ้... อย่าเพิ่งไปสิ... พวกเธอกลับมาก่อน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620349
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620349,
					"content": "ฉันได้ยินเสียงคุณเรียกพวกเราจากไกล ๆ มีอะไรเหรอ หรือว่าจะให้เราช่วยตามคุณ Carranza มาที่นี่?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620350
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620350,
					"content": "ฉันจะไปกล้าได้ไง แบบนั้นก็รบกวนพวกเธอแย่เลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620351
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620351,
					"content": "#ไม่รบกวน ๆ ยังไงก็ทางผ่านอยู่แล้ว ใช่มั้ยล่ะ {NICKNAME}? เรื่องเล็กน้อยแค่นี้ จิ๊บ ๆ น่า!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620352
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620352,
					"content": "อะแฮ่ม... เจ้าตัวเล็กนี่ร้ายกาจเหมือนกันนะเนี่ย บอกมาสิ ราคาที่พวกเธอเสนอมาเมื่อกี้ยังนับอยู่ปะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620353
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620353,
					"content": "ตอนนี้ก็ยังนับอยู่ แต่หลังจากนี้ก็ไม่รู้ละ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620354
					]
				},
				{
					"id": 740620354,
					"content": "โอเค ฉันยอมรับแล้ว งั้นก็ราคานี้แหละ แต่ต้องให้ผู้มอบหมายคำขอของพวกเธอมาเจรจาเอง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620355
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620355,
					"content": "#ได้เลย! {NICKNAME} พวกเรากลับไปบอก Nakul กันเถอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620356,
					"content": "(กดราคาให้ต่ำสุด ๆ เลย!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620357
					]
				},
				{
					"id": 740620357,
					"content": "งั้น...งั้นก็ 27,000! คูปองสวัสดิการ 27,000 ใบ คุณคิดว่าไง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620358
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620358,
					"content": "27,000?! ล้อกันเล่นรึไง นี่พวกเธอตั้งใจมาเยาะเย้ยฉันใช่มั้ย? ทำไมถึงได้น้อยกว่าครั้งก่อนล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620359
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620359,
					"content": "เจ้าบ้าที่มาเคาะประตูคนนั้นให้ราคาสูงกว่านี้ฉันยังไม่ตกลงด้วยเลย แล้วจะตกลงกับพวกเธอได้ไงหา?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620360
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620360,
					"content": "#({NICKNAME} ทำไงดี พวกเราจะเสนอราคานี้ต่อไปมั้ย?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620361,
						740620370
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620361,
					"content": "ราคากำลังตก ต่อไปจะตกต่ำกว่านี้อีกมาก",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620362
					]
				},
				{
					"id": 740620362,
					"content": "พูดจริงเหรอ? แต่ Nakul อยากได้ห้องนี้มากไม่ใช่เหรอ? เขาต้องยอมจ่ายราคาที่สูงมากแน่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620363
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620363,
					"content": "เรื่องนั้นน่ะเหรอ... ความอดทนของคนเรามีจำกัด! ก่อนหน้านี้คุณปฏิเสธอย่างโหดร้ายถึงสองครั้ง บางทีเขาอาจจะท้อไปแล้วก็ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620364
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620364,
					"content": "ครั้งนี้เหลือครึ่งนึง ไม่แน่ครั้งต่อไปอาจจะ... อ้อ! บางทีอาจจะไม่มีใครต่อไปแล้วก็ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620365
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620365,
					"content": "...ขอคิดดูก่อนนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620366
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620366,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620367
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620367,
					"content": "นี่ ๆ คุณที่อยู่หลังประตูนั่นน่ะ คิดได้รึยัง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620368
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620368,
					"content": "โอเค ฉันยอมรับแล้ว งั้นก็ราคานี้แหละ แต่ต้องให้ผู้มอบหมายคำขอของพวกเธอมาเจรจาเอง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620369
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620369,
					"content": "#ได้เลย! {NICKNAME} พวกเรากลับไปบอก Nakul กันเถอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620370,
					"content": "(เพิ่มขึ้นเป็นราคาตามงบของผู้มอบหมายคำขอ)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620371
					]
				},
				{
					"id": 740620371,
					"content": "อืม... แล้วถ้าเป็นคูปองสวัสดิการ 54,000 ใบล่ะ? เยอะกว่า 27,000 เท่าตัวเลยนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620372
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620372,
					"content": "54,000? เพิ่มขึ้นจากเจ้าบ้าที่มาเคาะประตูคราวก่อน... แค่ 10% แค่นี้มันไม่ได้เพิ่มมากมายอะไรเลยนะ น่าเบื่อจริง ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620373
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620373,
					"content": "ราคาที่พวกเธอบอกเปลี่ยนไปมาอยู่เรื่อยเลย... ฉันว่าน่าจะมีโอกาสเพิ่มขึ้นอีกแน่นอน!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620374
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620374,
					"content": "ก็แค่ต้องรอก่อน... รออีกสักพักก็จะขึ้นราคาเอง ไว้พวกเธอมาคราวหน้า หรือหลังจากคราวหน้า พวกเธอก็จะมีราคาที่สูงกว่านี้มาให้แน่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620375
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620375,
					"content": "ฉันคิดไว้ไม่ผิดแน่! จะต้องขึ้นราคาชัวร์! เพราะงั้นฉันเลยอดทนไว้ก่อน! จะยอมตกลงด้วยง่าย ๆ ไม่ได้หรอก...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620376
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620376,
					"content": "พวกเธอไปเถอะ ฉันไม่ตกลงด้วยหรอก อย่างน้อยก็ไม่ใช่ครั้งนี้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620377
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620377,
					"content": "#อืม... ดูเหมือนว่าเขาจะไม่เปลี่ยนใจนะ {NICKNAME} พวกเรากลับไปบอก Nakul กันเถอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620378,
					"content": "(ลองเปิดประตู)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620379
					]
				},
				{
					"id": 740620379,
					"content": "...นี่! ธะ...เธอจะทำอะไรน่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620380
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620380,
					"content": "จะเปิดประตูไง คุยกันแบบมีประตูกั้นไว้แบบนี้ ฉันมองไม่เห็นสีหน้าของอีกฝ่ายเลย ถ้าจะคุยธุระก็ต้องคุยกันซึ่งหน้าสิถึงจะดี",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620381
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620381,
					"content": "แล้วห้องในป้อมปราการ Meropide ก็ไม่ใช่ของส่วนตัวของใครด้วยนี่นา? ถ้าแค่อาศัยอยู่ชั่วคราว งั้นพวกเราก็ต้องเข้าไปได้สิ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620382
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620382,
					"content": "ไม่ได้! ไม่ได้เด็ดขาด! พวกเธอไม่เข้าใจ... พวกเธอไม่รู้ว่าความมืดที่ซ่อนอยู่หลังประตูมันเป็นยังไง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620383
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620383,
					"content": "เอ่อ ฉันหมายถึง เวลาสบตากับผู้คนฉันจะตื่นเต้นจนพูดไม่ออกน่ะ พวกเราคุยกันผ่านประตูแบบนี้แหละดีแล้ว พวกเธอมีธุระอะไรกันแน่?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620384,
						740620449
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620384,
					"content": "พวกเราได้รับคำขอมา และมีเรื่องอยากจะคุยกับคุณ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620385
					]
				},
				{
					"id": 740620385,
					"content": "อืม พวกเราได้รับคำขอให้มาเจรจากับคุณ ไม่ทราบว่าคุณยินดีจะปล่อยเช่าห้องนี้มั้ย? แน่นอนว่าผู้มอบหมายคำขอจะจ่ายคูปองสวัสดิการให้เป็นค่าตอบแทนด้วย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620386
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620386,
					"content": "ก่อนหน้านี้ก็เหมือนจะมีเรื่องแบบนี้เกิดขึ้น... ซ้ำแล้วซ้ำเล่า ไม่รู้จักยอมแพ้ซะจริง ๆ คนที่พูดจาปลอม ๆ นั่นเป็นคนส่งพวกเธอมาล่ะสิท่า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620387
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620387,
					"content": "ช่างเถอะ เห็นแก่ความพยายามของเขา... พวกเธอเสนอราคามาสิ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620388
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620388,
					"content": "(เยี่ยมเลย ดูท่าก็ไม่ใช่ว่าจะไม่มีวิธีเจรจาเลยนี่นา)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620389
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620389,
					"content": "(Nakul ได้บอกราคาที่คาดหวังของเขาให้เราแล้ว ถ้าเราเสนอราคาละก็ จะบอกราคาสูงสุดตามตรงตั้งแต่แรกเลยมั้ย? หรือจะลองกดราคาดี?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620390,
						740620427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620390,
					"content": "(บอกราคาสูงสุดตามตรง)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620391
					]
				},
				{
					"id": 740620391,
					"content": "โอเค งั้นฉันบอกตามตรงเลยก็แล้วกัน ราคาที่ผู้มอบหมายคำขอคาดหวังไว้ก็คือคูปองสวัสดิการ 54,000 ใบ ฉันว่าคุ้มค่ามากเลยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620392
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620392,
					"content": "54,000? เพิ่มขึ้นจากเจ้าบ้าที่มาเคาะประตูคราวก่อน... แค่ 10% แค่นี้มันไม่ได้เพิ่มมากมายอะไรเลยนะ น่าเบื่อจริง ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620393
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620393,
					"content": "นี่ยังน้อยอีกเหรอ? ฉันว่ามันเยอะมากแล้วนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620394
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620394,
					"content": "ไม่รู้เรื่องเลยจริง ๆ พวกเธอรู้จัก Carranza รึเปล่า? เขาทุ่มหนักกว่านี้อีกนะ เขายอมจ่าย... 108,000 ใบเลยนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620395
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620395,
					"content": "จริงเหรอ? เยอะขนาดนั้นเชียว?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620396
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620396,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620397
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620397,
					"content": "...ก็...ก็ต้องจริงน่ะสิ เธอเห็นฉันเป็นคนโกหกหลอกลวงรึไง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620398
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620398,
					"content": "กั้นประตูแบบนี้ พวกเรามองไม่เห็นอะไรสักอย่างเลยต่างหาก!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620399
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620399,
					"content": "(น้ำเสียงของเขาดูไม่ค่อยมีความมั่นใจสักเท่าไหร่เลย ไม่แน่อาจจะกำลังแต่งเรื่องหลอกเราอยู่ก็ได้)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620400
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620400,
					"content": "#({NICKNAME} พวกเราจะต่อรองยังไงดีล่ะ?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620401,
						740620411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620401,
					"content": "(ความจริงก็มีอยู่เท่านี้ บอกเขาไปตามนี้ก็พอแล้วล่ะ)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620402
					]
				},
				{
					"id": 740620402,
					"content": "พวกเราบอกตามตรงตั้งแต่แรกแล้ว ว่าให้ได้แค่ 54,000 เท่านั้น 108,000 มันเวอร์เกินไปจริง ๆ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620403,
					"content": "ถ้าคุณไม่ยินดีละก็ งั้นพวกเรา... พวกเราก็ไม่มีวิธีอื่นที่ดีกว่านี้ นอกจากต้องยอมแพ้เท่านั้นแหละ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620404,
					"content": "ก็แค่ต้องรอก่อน... รออีกสักพักก็จะขึ้นราคาเอง ไว้พวกเธอมาคราวหน้า หรือหลังจากคราวหน้า พวกเธอก็จะมีราคาที่สูงกว่านี้มาให้แน่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620405
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620405,
					"content": "ฉันคิดไว้ไม่ผิดแน่! จะต้องขึ้นราคาชัวร์! เพราะงั้นฉันเลยอดทนไว้ก่อน! จะยอมตกลงด้วยง่าย ๆ ไม่ได้หรอก...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620406
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620406,
					"content": "พูดซะมั่นอกมั่นใจขนาดนี้ คุณยึดตามหลักอะไรเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620407,
					"content": "ก็ต้องจากประสบการณ์น่ะสิ! ประสบการณ์สองครั้งก่อนบอกฉันว่า ตราบใดที่ฉันไม่ขัดจังหวะซะก่อน ราคาก็จะต้องขึ้นไปเรื่อย ๆ แน่ มันก็เป็นหลักการง่าย ๆ ไม่ใช่รึไง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620408
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620408,
					"content": "หลักการอะไรเนี่ย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620409,
					"content": "เธอเป็นแค่เด็กน้อย แน่นอนว่าไม่เข้าใจอะไรหรอก ยังไงก็เถอะ ตอนนี้ยังไม่ถึงเวลา ฉันไม่มีทางตอบตกลงหรอก พวกเธอไปเถอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620410
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620410,
					"content": "#อืม... ดูเหมือนว่าเขาจะไม่เปลี่ยนใจนะ {NICKNAME} พวกเรากลับไปบอก Nakul กันเถอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620411,
					"content": "(ในเมื่อเขาคิดจะหลอกเรา งั้นก็เล่นกับเขาหน่อยละกัน)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620412
					]
				},
				{
					"id": 740620412,
					"content": "ฮือฮือ... ไม่คิดเลยว่า Carranza จะเป็นคู่ต่อสู้ที่แข็งแกร่งขนาดนี้ ไม่ว่ายังไงฉันก็เทียบไม่ติดเลยจริง ๆ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620413,
					"content": "#{NICKNAME} พวกเรากลับไปบอก Nakul กันเถอะ ว่าราคาที่เขาเสนอมันต่ำเกินไปจนไม่ถูกใจเขาเลยสักนิด",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620414,
					"content": "คุณที่อยู่หลังประตูนั่นน่ะ ขอให้คุยกับคุณ Carranza อย่างมีความสุขนะ พวกเราขอตัวก่อนล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620415,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620416,
					"content": "...เอ๋? จะไปแบบนี้เลยเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620417
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620417,
					"content": "เฮ้ พวกเธอยังอยู่รึเปล่า?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620418
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620418,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620419,
					"content": "เฮ้... อย่าเพิ่งไปสิ... พวกเธอกลับมาก่อน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620420
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620420,
					"content": "ฉันได้ยินเสียงคุณเรียกพวกเราจากไกล ๆ มีอะไรเหรอ หรือว่าจะให้เราช่วยตามคุณ Carranza มาที่นี่?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620421,
					"content": "ฉันจะไปกล้าได้ไง แบบนั้นก็รบกวนพวกเธอแย่เลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620422
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620422,
					"content": "#ไม่รบกวน ๆ ยังไงก็ทางผ่านอยู่แล้ว ใช่มั้ยล่ะ {NICKNAME}? เรื่องเล็กน้อยแค่นี้ จิ๊บ ๆ น่า!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620423,
					"content": "อะแฮ่ม... เจ้าตัวเล็กนี่ร้ายกาจเหมือนกันนะเนี่ย บอกมาสิ ราคาที่พวกเธอเสนอมาเมื่อกี้ยังนับอยู่ปะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620424
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620424,
					"content": "ตอนนี้ก็ยังนับอยู่ แต่หลังจากนี้ก็ไม่รู้ละ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620425
					]
				},
				{
					"id": 740620425,
					"content": "โอเค ฉันยอมรับแล้ว งั้นก็ราคานี้แหละ แต่ต้องให้ผู้มอบหมายคำขอของพวกเธอมาเจรจาเอง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620426
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620426,
					"content": "#ได้เลย! {NICKNAME} พวกเรากลับไปบอก Nakul กันเถอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620427,
					"content": "(กดราคาให้ต่ำสุด ๆ เลย!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620428
					]
				},
				{
					"id": 740620428,
					"content": "งั้น...งั้นก็ 27,000! คูปองสวัสดิการ 27,000 ใบ คุณคิดว่าไง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620429
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620429,
					"content": "27,000?! ล้อกันเล่นรึไง นี่พวกเธอตั้งใจมาเยาะเย้ยฉันใช่มั้ย? ทำไมถึงได้น้อยกว่าครั้งก่อนล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620430
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620430,
					"content": "เจ้าบ้าที่มาเคาะประตูคนนั้นให้ราคาสูงกว่านี้ฉันยังไม่ตกลงด้วยเลย แล้วจะตกลงกับพวกเธอได้ไงหา?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620431
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620431,
					"content": "#({NICKNAME} ทำไงดี พวกเราจะเสนอราคานี้ต่อไปมั้ย?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620432,
						740620441
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620432,
					"content": "ราคากำลังตก ต่อไปจะตกต่ำกว่านี้อีกมาก",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620433
					]
				},
				{
					"id": 740620433,
					"content": "พูดจริงเหรอ? แต่ Nakul อยากได้ห้องนี้มากไม่ใช่เหรอ? เขาต้องยอมจ่ายราคาที่สูงมากแน่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620434
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620434,
					"content": "เรื่องนั้นน่ะเหรอ... ความอดทนของคนเรามีจำกัด! ก่อนหน้านี้คุณปฏิเสธอย่างโหดร้ายถึงสองครั้ง บางทีเขาอาจจะท้อไปแล้วก็ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620435
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620435,
					"content": "ครั้งนี้เหลือครึ่งนึง ไม่แน่ครั้งต่อไปอาจจะ... อ้อ! บางทีอาจจะไม่มีใครต่อไปแล้วก็ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620436
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620436,
					"content": "...ขอคิดดูก่อนนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620437
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620437,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620438
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620438,
					"content": "นี่ ๆ คุณที่อยู่หลังประตูนั่นน่ะ คิดได้รึยัง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620439
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620439,
					"content": "โอเค ฉันยอมรับแล้ว งั้นก็ราคานี้แหละ แต่ต้องให้ผู้มอบหมายคำขอของพวกเธอมาเจรจาเอง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620440
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620440,
					"content": "#ได้เลย! {NICKNAME} พวกเรากลับไปบอก Nakul กันเถอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620441,
					"content": "(งั้นก็เพิ่มขึ้นเป็นราคาตามงบของผู้มอบหมายคำขอ)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620442
					]
				},
				{
					"id": 740620442,
					"content": "อืม... แล้วถ้าเป็นคูปองสวัสดิการ 54,000 ใบล่ะ? เยอะกว่า 27,000 เท่าตัวเลยนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620443
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620443,
					"content": "54,000? เพิ่มขึ้นจากเจ้าบ้าที่มาเคาะประตูคราวก่อน... แค่ 10% แค่นี้มันไม่ได้เพิ่มมากมายอะไรเลยนะ น่าเบื่อจริง ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620444
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620444,
					"content": "ราคาที่พวกเธอบอกเปลี่ยนไปมาอยู่เรื่อยเลย... ฉันว่าน่าจะมีโอกาสเพิ่มขึ้นอีกแน่นอน!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620445
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620445,
					"content": "ก็แค่ต้องรอก่อน... รออีกสักพักก็จะขึ้นราคาเอง ไว้พวกเธอมาคราวหน้า หรือหลังจากคราวหน้า พวกเธอก็จะมีราคาที่สูงกว่านี้มาให้แน่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620446
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620446,
					"content": "ฉันคิดไว้ไม่ผิดแน่! จะต้องขึ้นราคาชัวร์! เพราะงั้นฉันเลยอดทนไว้ก่อน! จะยอมตกลงด้วยง่าย ๆ ไม่ได้หรอก...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620447
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620447,
					"content": "พวกเธอไปเถอะ ฉันไม่ตกลงด้วยหรอก อย่างน้อยก็ไม่ใช่ครั้งนี้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620448
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620448,
					"content": "#อืม... ดูเหมือนว่าเขาจะไม่เปลี่ยนใจนะ {NICKNAME} พวกเรากลับไปบอก Nakul กันเถอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620449,
					"content": "(ลองเปิดประตูต่อไป)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620450
					]
				},
				{
					"id": 740620450,
					"content": "ให้ตายสิ! ทำไมพวกเธอถึงยังไม่หยุดอีกเนี่ย? ฉันบอกแล้วไงว่าพวกเธอไม่เข้าใจว่าความมืดที่ซ่อนอยู่หลังประตูนั้นเป็นยังไง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620451
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620451,
					"content": "ถ้าไม่คุยกันแบบต่อหน้า แล้วฉันจะรู้ได้ไงว่าคุณเป็นคนจริงรึเปล่า?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620452
					]
				},
				{
					"id": 740620452,
					"content": "ฉันก็ต้องเป็นคนจริงสิ... แต่ต่อให้ฉันไม่ใช่คน แล้วมันจะเกี่ยวอะไรกัน? ก็เหมือนกับที่ฉันไม่รู้ว่าพวกเธอมีตัวตนอยู่จริง ๆ รึเปล่า พวกเราก็สื่อสารแบบเดียวกันนี่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620453,
						740620455
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620453,
					"content": "ฉันหยิกแก้ม Paimon ได้นะ เธอดูเหมือนจะจริงมากเลย",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620454
					]
				},
				{
					"id": 740620454,
					"content": "เอาเถอะ ดูเหมือนว่าพวกเธอจะพิสูจน์กันและกันแล้วว่าเป็นตัวจริง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620458
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620458,
					"content": "ไม่ว่ายังไง ฉันก็ไม่มีวันเปิดประตูแน่ ฉันขอแนะนำว่าพวกเธอก็อย่าทำแบบนั้นเหมือนกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620459
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620459,
					"content": "เอ๋... แต่เราได้รับคำขอให้มาเจรจากับคุณ เพื่อหวังว่าจะสามารถยืมห้องนี้ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620460
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620460,
					"content": "งั้นก็คงต้องให้เขาล้มเลิกมันแล้วล่ะ คนที่จะอยู่กับความมืด มีแค่ฉันคนเดียวก็พอแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620461
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620461,
					"content": "ฉันเห็นพูดเรื่องความมืดตั้งแต่เมื่อกี้แล้วนะ นี่มันคือเรื่องอะไรกันแน่เนี่ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620462
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620462,
					"content": "ฟังจากน้ำเสียงของเธอแล้วเหมือนกับเด็กไม่มีผิด เด็ก ๆ ไม่มีวันเข้าใจได้หรอก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620463
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620463,
					"content": "ฮึ ฉันว่าคุณก็แค่โกหก และคิดจะเล่นตุกติกกับเราเท่านั้นแหละ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620464
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620464,
					"content": "ฮ่าฮ่า ก็อาจเป็นไปได้ แต่ฉันบอกสิ่งที่ควรจะบอกไปหมดแล้ว ยังไงฉันก็ไม่มีวันเปิดประตู และไม่มีวันตอบตกลงเรื่องเช่าห้องนั่นด้วย พวกเธอกลับไปเถอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620465
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620465,
					"content": "เสียงจากหลังประตูหายไปแล้ว\\nคุณรอสักพักแล้วลองเคาะประตูอีกครั้ง แต่ก็ไม่มีเสียงตอบรับใด ๆ ราวกับว่าไม่มีใครอยู่ตรงนั้นตั้งแต่แรกแล้ว",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740620466
					]
				},
				{
					"id": 740620466,
					"content": "เอ๋? ดูเหมือนเขาจะไม่สนใจเราจริงด้วย... นี่พวกเราทำคำขอพังแล้วรึเปล่านะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620467
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620467,
					"content": "อืม เอาเถอะ พวกเรากลับไปบอก Nakul กันก่อนดีกว่า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620455,
					"content": "บางทีฉันอาจเป็นแค่ตัวละครในความฝันของใครบางคน",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620456
					]
				},
				{
					"id": 740620456,
					"content": "จะใช่ความฝันของฉันรึเปล่า? ฉันเคยได้ยินเสียงของพวกเธอ... ได้ยินเสียงพวกเธอพูดคุยกับสาวน้อยที่ร่าเริงคนหนึ่ง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620457
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620457,
					"content": "#หรืออาจจะเป็นความฝันของฉันก็ได้? ถ้าเป็นแบบนั้น... ถ้าตื่นขึ้นมาแล้วยังพบว่า {NICKNAME} อยู่ข้าง ๆ ก็คงดี อืม...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620458
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620306,
					"content": "อย่าถามว่าฉันเป็นใคร และอย่าถามว่าฉันมาจากไหน",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620307
					]
				},
				{
					"id": 740620307,
					"content": "หา?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620308
					],
					"speakerTitle": "ใครบางคน"
				},
				{
					"id": 740620308,
					"content": "(นี่เธอทำอะไรเนี่ย ขืนทำแบบนี้มีหวังเรื่องต้องยุ่งยากกว่าเดิมแน่?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620309,
					"content": "เราเป็นเมลูซีน",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620310
					]
				},
