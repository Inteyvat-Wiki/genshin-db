			"dialogs": [
				{
					"id": 401720401,
					"content": "สิ่งทอใหม่ปรากฏขึ้นมาแล้ว! นี่มัน... แผนที่นี่นา!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720402
