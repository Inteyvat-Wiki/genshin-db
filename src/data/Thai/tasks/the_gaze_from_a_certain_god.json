					"Nahida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30170501,
					"content": "เดี๋ยวนะ นั่นมัน!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170502,
						30170503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170502,
					"content": "Nahida!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170504
					]
				},
				{
					"id": 30170504,
					"content": "เธอไม่เป็นอะไรจริง ๆ ด้วย เยี่ยมไปเลย! พวกเราเป็นห่วงเธอมากเลยนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170505,
						30170506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170505,
					"content": "เป็นจิตสำนึกของ Nahida ใช่มั้ย?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170507
					]
				},
				{
					"id": 30170507,
					"content": "#เฮ้ {NICKNAME} เป็นการเจอกันที่ซึ้งซะขนาดนี้ เธอดันทำบรรยากาศเสียหมดเลย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170508,
					"content": "Paimon การที่นักเดินทางระวังฉันในตอนนี้เป็นการกระทำที่ถูกต้องแล้ว เพราะยังไง \"The Doctor\" ก็เคยเผยเทคนิคที่คล้ายการควบคุมจิตสำนึกของคนมาก่อน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170509
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30170509,
					"content": "หลังแยกกัน เกิดอะไรขึ้นตอนที่ฉันเผชิญหน้ากับ \"The Doctor\" เพียงลำพังบ้าง พวกเธอก็ไม่มีทางรู้ได้เลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170510
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30170510,
					"content": "เหมือนกับยามที่พายุฝนอันรุนแรงราวกับภัยพิบัติพัดผ่านไปแล้ว บางครั้งน้ำที่ขังอยู่บนพื้นก็สามารถปลอมตัวเป็นท้องฟ้าได้เหมือนกันนั่นแหละ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170511
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30170511,
					"content": "อืม... คนที่เปรียบเปรยได้ประหลาดแบบนี้ ก็คงมีแต่ Nahida ตัวจริงเท่านั้นแหละ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170512,
						30170513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170512,
					"content": "ฉันก็คิดอย่างงั้น",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170514
					]
				},
				{
					"id": 30170514,
					"content": "เอ๋? เมื่อกี้ฉันไม่ได้กำลังโน้มน้าวให้เชื่อนะ แค่อยากอธิบายให้เข้าใจง่ายขึ้นก็เท่านั้นเอง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170515
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30170515,
					"content": "เอาเถอะ ๆ พวกเรารู้แล้วน่า Nahida รีบบอกมาเร็ว หลังพวกเราแยกกันแล้ว มันเกิดอะไรขึ้นบ้าง? คนพวกนั้นเป็นยังไงบ้างแล้ว?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170516,
					"content": "ตอนพวกเธอจากไป ฉันกำลังพยายามอย่างเต็มที่เพื่อฟื้นสภาพจิตสำนึกของทุกคน โชคดีที่การ \"ใส่ข้อมูลลงในจิตใต้สำนึก\" ที่ \"The Doctor\" พูดถึง ไม่ใช่การฝังแน่นลึกเข้าไปในสมอง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170517
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30170517,
					"content": "...แต่มันคล้ายกับการสร้างภาพลวงตาในสมองของคนแทน ซึ่งพลังของฉันในตอนนี้สามารถจัดการสิ่งพวกนั้นได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170518
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30170518,
					"content": "โชคดีคือในจังหวะที่เขากำลังจะควบคุมฉันนั้น ฉันฟื้นสภาพจิตสำนึกคนเสร็จสิ้นแล้วใช้จิตสำนึกหลบหนีออกมาได้สำเร็จพอดี",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170519
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30170519,
					"content": "ยังดีนะเนี่ย วิธีของ \"The Doctor\" มันเกินความคาดหมายจริง ๆ นั่นแหละ ยังดีที่มี Nahida อยู่ด้วย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170520,
					"content": "ก็ไม่ได้ดีขนาดนั้นหรอก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170521
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30170521,
					"content": "ในระหว่างการฟื้นสภาพจิตสำนึกของทุกคน \"The Doctor\" ได้รู้ตัวตนที่แท้จริงของฉันเข้าซะแล้ว พวกเราเสียไพ่ตายไปอีกหนึ่งใบ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170522
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30170522,
					"content": "อีกอย่าง... ในเมื่อเขามีความสามารถในการดัดแปลง Akasha Terminal บางทีการ \"จับ\" จิตสำนึกของฉันไว้ได้ก็อาจเป็นแค่เรื่องของเวลา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170523
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30170523,
					"content": "หมายถึงเธอไม่สามารถโอนย้ายจิตสำนึกอย่างอิสระแบบนี้ต่อไปได้แล้วเหรอ งั้นทำยังไงดีล่ะ... ตอนนี้เขาอยู่ที่สถาบัน มีความเป็นไปได้ว่าอาจเล่นงาน Akasha ต่อ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170524,
						30170525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170524,
					"content": "พวกเราต้องรีบแล้วล่ะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170526
					]
				},
				{
					"id": 30170526,
					"content": "ให้ตายเถอะ... รู้สึกเหมือนเขากำลังเล่นกับพวกเรายังไงอย่างนั้น ช่างเป็นศัตรูที่รับมือด้วยยากจริง ๆ ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170527
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170527,
					"content": "แถมว่ากันว่าแค่ความสามารถด้านการต่อสู้เพียงอย่างเดียว \"The Doctor\" ก็สามารถนั่งครองอยู่ใน \"อันดับสอง\" อย่างมั่นคงแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170528
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170528,
					"content": "ยังไม่ใช่เวลาที่จะท้อแท้นะ มาคิดหาทางออกกันเถอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170529
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30170529,
					"content": "อืม จริงสิ Nahida รู้ได้ยังไงว่าพวกเราจะมาสวน Pardis Dhyai? เธอมารอที่นี่ล่วงหน้าเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170530
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170530,
					"content": "#ใช่ ฉันสามารถจับสัมผัสพลังธาตุบนตัว {NICKNAME} ได้ จากนั้นก็คาดคะเนจากทิศทางการเคลื่อนที่ของพลังพวกนี้น่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170531
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30170531,
					"content": "พวกเธอคงไม่ได้มาเพื่อท่องเที่ยวหรอกใช่มั้ย? เจอเบาะแสอะไรหรือยัง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170532
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30170532,
					"content": "เรามาที่นี่เพื่อหานักวิชาการที่เรารู้จักก่อนหน้านี้น่ะ เขาชื่อ Tighnari ฉันจำได้ว่านักปราชญ์เคยติดต่อเขาไป Nahida ก็เข้าไปดูพร้อมกับพวกเรากันเถอะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170533
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170533,
					"content": "ก็ได้ ฉันหวังว่าพวกเราในตอนนี้จะไม่ทำให้เขาต้องลำบากนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30170525,
					"content": "ขืนเป็นแบบนี้ต่อไป พวกเราก็ยิ่งเสียเปรียบมากขึ้น",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170526
					]
				},
				{
					"id": 30170513,
					"content": "ฉันเชื่อเธอแล้ว",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170514
					]
				},
				{
					"id": 30170506,
					"content": "ไม่ได้ถูก \"The Doctor\" ทำอะไรใช่มั้ย?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170507
					]
				},
				{
					"id": 30170503,
					"content": "Katheryne!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170504
					]
				}
			]
		},
		{
