				]
			},
			"dialogs": [
				{
					"id": 765080101,
					"content": "ช่วงนี้ \"เหล่าวารี\" จัดกิจกรรมอะไรกันอยู่เหรอ? เหมือนจะมีนักท่องเที่ยวเพิ่มขึ้นนะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765080102,
					"content": "ตรงนั้นมีแขกจาก Sumeru อยู่ด้วย... กำลังเต้นรำให้ทุกคนดูอยู่งั้นเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765080103,
					"content": "ว้าว ผู้กล้าผู้ยิ่งใหญ่ที่เปล่งประกาย และเสนาธิการ Paimon ผู้น่ารักมาแล้ว!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080104
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080104,
					"content": "ขอทักทายด้วยความจริงใจ นักรบที่ฉันเคารพอย่างที่สุด ผู้กล้าที่โดดเด่นทั้งการต่อสู้และเต้นรำ ผู้ซึ่งดื่มด่ำกับชีวิต!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080105
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080105,
					"content": "เอ๋ คุณคนนี้คุ้นหน้าจังเลย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765080106,
					"content": "#อีกอย่าง ทำไมคุณถึงรู้ล่ะว่า {NICKNAME} มีความสุขกับการเต้นรำ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765080107,
					"content": "#ก็เพราะเคยเห็นลีลาการเต้นรำอันสดใสร่าเริงของ{M#เขา}{F#เธอ} ที่หน้าลานประลองเพลิงศักดิ์สิทธิ์น่ะสิ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080108
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080108,
					"content": "#หลังถ่ายรูปเสร็จ ฉันก็ไปหาที่ที่ไม่ค่อยสะดุดตา แล้วกิน Saurus Cracker ไปพลาง ดูการเต้นรำอวยพรของ {NICKNAME} ไปพลาง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080109
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080109,
					"content": "#การเต้นรำมันต้องสบาย ๆ ปลดปล่อยความเป็นตัวเอง! ฉันอยากจะขึ้นไปเต้นรำกับ {NICKNAME} เลยล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080110,
						765080112
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080110,
					"content": "นึกออกแล้ว!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765080111
					]
				},
				{
					"id": 765080111,
					"content": "ถือเป็นเกียรติของฉันเลยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080114
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080114,
					"content": "กลับเข้าเรื่องก่อน ก็อย่างที่คุณเห็น ช่วงนี้มีเพื่อน ๆ จาก Sumeru มาเยี่ยมเยียนอย่างอบอุ่น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080115
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080115,
					"content": "จากการหารือของ Mutota, Amina, Pacal และ Mualani พวกเรา \"วงศ์ปีกบุปผา\" เลยตัดสินใจร่วมมือกับ \"บุตรแห่งเสียงสะท้อน\" และ \"เหล่าวารี\" เพื่อต้อนรับพวกเขาอย่างดี",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080116
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080116,
					"content": "ดูเหมือน จะมีทหารรับจ้างของ \"กลุ่ม Eremite\" อยู่เพียบเลยนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765080117,
					"content": "ให้ฉันเดานะ ตอนที่เดินทางในทะเลทราย ถ้าไม่ต่อสู้ ก็คงไม่ได้รู้จักกัน ใช่มั้ยล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765080118,
					"content": "เอ่อ ก็ประมาณนั้นแหละ! แต่ว่า ไม่ใช่การต่อสู้กันระหว่างพวกเราหรอกนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080119
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080119,
					"content": "ตอนที่พวกเราจัดปาร์ตี้บาร์บีคิว ทางใต้ของพื้นที่ทะเลทราย Hadramaveth ก็เรียกแร้งสีชาดที่ดุร้ายมา พวกมันจงใจเลือกลงมือตอนที่พวกเราอิ่มแปล้ จนวิ่งหนีไม่ไหว...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080120
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080120,
					"content": "พวกมันเจ้าเล่ห์มาก พวกเราต่อสู้กันอย่างยากลำบากแต่ก็ไร้ผล พวกมันใช้ประโยชน์ จากความคุ้นเคยกับภูมิประเทศ เล่นเอาซะเหนื่อยแทบแย่ ก็เลยต้องถอยก่อน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080121
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080121,
					"content": "ไม่นึกเลย ว่าจะมีทหารรับจ้างกลุ่มนึง โผล่มาระหว่างทางที่พวกเรากำลังถอย แล้วเริ่มแสดงการเต้นรำอันลึกลับ เข้าไปหาพวกแร้งสีชาด...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080122
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080122,
					"content": "สุดท้ายแร้งสีชาดพวกนั้น ก็เหมือนจะเห็นพ้องต้องกัน และเลือกถอยกลับไป!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080123
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080123,
					"content": "ชะ...ใช้ระบำต่อสู้ทำให้แร้งสีชาดหนีไปงั้นเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080124,
						765080125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765080124,
					"content": "ท่าเต้นแปลกจนทำให้พวกมันตกใจกลัว จนหนีไปมากกว่า...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765080126
					]
				},
				{
					"id": 765080126,
					"content": "มหัศจรรย์มากเลยใช่มั้ยล่ะ? พวกเราก็อยากรู้ความลับของการเต้นรำนั้นเหมือนกัน!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080127
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080127,
					"content": "หลังเก็บกวาดค่ายเสร็จ พวกเราก็กินเนื้อกันเต็มปากเต็มคำ และดื่มเหล้ากันเป็นถัง ๆ รอจนกินอิ่มแล้ว ก็เริ่มแลกเปลี่ยนเทคนิคการเต้นรำกัน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080128
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080128,
					"content": "ถ้าระหว่างทางยังมีมอนสเตอร์หรืออสูรอื่น ๆ มาขัดจังหวะพวกเรา พวกเราก็คว้าอาวุธแล้วลุยไปด้วยกัน!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080129
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080129,
					"content": "ไม่ถึงสองอาทิตย์ พวกเราก็กลายเป็นสหายร่วมรบ และสหายเต้นรำกันแล้ว!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080130
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080130,
					"content": "ก่อนจะแยกกัน พวกเราก็ตกลงกันว่า หลังจากนี้จะไปเยี่ยมค่ายของกันและกันอย่างเป็นทางการ เพื่อ \"แลกเปลี่ยนเทคนิคการเต้น\" ต่อไป นี้ก็คือจุดเริ่มต้น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080131
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080131,
					"content": "#เดี๋ยวนะ {NICKNAME} เหมือนว่าก่อนหน้านี้พวกเราจะยังไม่เคยเข้าร่วม... กิจกรรมที่เพื่อนจาก Sumeru และ Natlan มาเต้นรำแลกเปลี่ยนกันแบบนี้เลยใช่มั้ยนะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080132,
						765080133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765080132,
					"content": "ก็แปลกใหม่จริง ๆ แหละนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765080134
					]
				},
				{
					"id": 765080134,
					"content": "นี่เป็นโอกาสดีที่หาได้ยากนะ มาช่วยชี้แนะให้กับพวกเราหน่อยเป็นไง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080135
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080135,
					"content": "Mualani ก็อยู่ด้วยนะ เธอถือเป็นตัวแทนนักเต้นรำที่ร่าเริงที่สุด ในหมู่พวกเราเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080136
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080136,
					"content": "อีกอย่าง เพื่อนใน \"กลุ่ม Eremite\" ยังใช้เงินจำนวนมากเชิญนักเต้นรำท้องถิ่นที่มีชื่อเสียง มาเป็นหัวหน้าและที่ปรึกษาของฝั่ง Sumeru ด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080137
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080137,
					"content": "ฉันว่า พวกคุณต้องรู้จักนักเต้นรำคนนั้นแน่ ๆ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080138
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080138,
					"content": "เหมือนจะเดาได้แล้วล่ะว่าเป็นใคร ฮี่ฮี่ เดี๋ยวพวกเราเตรียมเซอร์ไพรส์ใหญ่ให้เธอดีกว่า...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080139,
						765080140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765080139,
					"content": "ดี ๆ ฉันเอาด้วย!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765080141
					]
				},
				{
					"id": 765080141,
					"content": "ฮ่าฮ่าฮ่าฮ่า! แบบนี้ก็ยิ่งสนุกน่ะสิ ถ้าใช้คำพูดของ Mualani ก็คือ บรรยากาศมาถึงจุดสนุกสุดเหวี่ยงที่สุดแล้วล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080142
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080142,
					"content": "ไปกันเถอะ พวกเราไปหาน้อง Taraneh กัน!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080140,
					"content": "กิจกรรมแบบนี้ ห้ามพลาดเด็ดขาด!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765080141
					]
				},
				{
					"id": 765080133,
					"content": "อยากดูจัง",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765080134
					]
				},
				{
					"id": 765080125,
					"content": "หรือว่าจะรู้จักกันมาก่อน?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765080126
					]
				},
				{
					"id": 765080112,
					"content": "จากนี้ไปต้องจำได้แน่นอน",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765080113
					]
				},
				{
					"id": 765080113,
					"content": "นั่นหมายความว่าฉันยังทำงานไม่เต็มที่มากพอ เลยไม่มีความสำเร็จที่โดดเด่นอะไร ยังต้องพยายามอีก!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080114
					],
					"speakerTitle": "Nusta"
				}
			]
		},
