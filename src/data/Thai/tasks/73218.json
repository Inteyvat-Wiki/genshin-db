				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180601,
					"content": "\"Gilded Journey\" เป็นโรงแรมเพียงแห่งเดียวของ Caravan Ribat แม้ดูเหมือนจะไม่จำเป็นต้องโฆษณาก็ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180602
					],
					"speakerTitle": "กระดานข่าวสาร"
				},
				{
					"id": 732180602,
					"content": "แต่เนื้อย่างของเรานั้นอร่อยมาก เป็นต้นตำรับจากทะเลทราย รสชาติดั้งเดิมกว่าในเมืองหลายเท่า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180603
					],
					"speakerTitle": "กระดานข่าวสาร"
				},
				{
					"id": 732180603,
					"content": "เดินทางมาเหนื่อย ๆ ก็อย่าลืมมาชิมให้ได้นะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "กระดานข่าวสาร"
				}
			]
		},
		{
			"id": 7321807,
			"completionStepIds": [
				7321807
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321807",
							"2"
						],
						"stepId": 7321807,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180701,
					"content": "\"หวังว่าเจ้าหน้าที่สถาบันจะพิจารณาเพิ่มข้อจำกัดในการผ่านด่านที่ Caravan Ribat นะ\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180702
					],
					"speakerTitle": "กระดานข่าวสาร"
				},
				{
					"id": 732180702,
					"content": "\"ตอนนี้ชาวทะเลทรายสามารถผ่านด่านได้ตามใจชอบ นอกจากแย่งโอกาสการทำงานของชาว Sumeru อย่างเราแล้ว ยังทำให้โจรผู้ร้ายฉวยโอกาสเข้าไปหลบซ่อนในป่าอีกด้วย\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180703
					],
					"speakerTitle": "กระดานข่าวสาร"
				},
				{
					"id": 732180703,
					"content": "\"แม้ตอนนี้ยังไม่ได้เปิดสิทธิ์ให้ชาวทะเลทรายเข้าถึง Akasha แต่คำขอจากป้อมปราการ Regzar ไม่ได้สงวนไว้สำหรับทหารรับจ้างเท่านั้นแล้ว ขืนเป็นแบบนี้ต่อไป ต่อให้ทุกคนไปสอบสถาบันกันหมด ก็ต้องมีคนตกงานอยู่ดี\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180704
					],
					"speakerTitle": "กระดานข่าวสาร"
				},
				{
					"id": 732180704,
					"content": "\"คุณพูดอะไรน่ะ ชาวทะเลทรายก็เป็นประชากรของท่านหญิง Rukkhadevata ผู้ยิ่งใหญ่เหมือนกัน พวกเขาก็เป็นชาว Sumeru ด้วย การให้พวกเขาเข้าเมืองก็เป็นเรื่องที่สมควรอยู่แล้ว\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180705
					],
					"speakerTitle": "กระดานข่าวสาร"
				},
				{
					"id": 732180705,
