			"dialogs": [
				{
					"id": 732180401,
					"content": "สถาบันห้ามการทำลายกำแพงป้องกันทรายทุกรูปแบบ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180402
					],
					"speakerTitle": "กระดานข่าวสาร"
				},
				{
					"id": 732180402,
					"content": "หากถูกจับได้ จะโดนลงโทษสถานหนัก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
