			]
		},
		{
			"id": 7321805,
			"completionStepIds": [
				7321805
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321805",
							"2"
						],
						"stepId": 7321805,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180501,
					"content": "\"จัดจำหน่ายของขึ้นชื่อในทะเลทราย ผลไม้แห้งทุกชนิด วัตถุดิบในการทำของหวาน\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180502
					],
					"speakerTitle": "กระดานข่าวสาร"
				},
				{
					"id": 732180502,
					"content": "\"สั่งซื้อล็อตใหญ่ บริการจัดส่งฟรี\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180503
					],
					"speakerTitle": "กระดานข่าวสาร"
				},
				{
					"id": 732180503,
					"content": "\"อันนี้ดีมากเลย รู้สึกว่าเอามาทำ Dango ได้ ช่วยส่งไปที่ Inazuma ได้มั้ย?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180504
					],
					"speakerTitle": "กระดานข่าวสาร"
				},
				{
					"id": 732180504,
					"content": "\"ขอโทษด้วยนะ การจัดส่งต่างแดนตอนนี้ให้บริการเฉพาะที่ Liyue เท่านั้น\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "กระดานข่าวสาร"
				}
			]
		},
		{
			"id": 7321806,
			"completionStepIds": [
				7321806
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321806",
