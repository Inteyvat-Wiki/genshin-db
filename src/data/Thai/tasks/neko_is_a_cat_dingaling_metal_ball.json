					"Neko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722150101,
					"content": "เมี้ยว เมื่อไหร่หินก้อนนี้จะเหมือนกับข้าน้อยสักทีนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150102,
					"content": "รูปปั้นทำไมเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150103
					]
				},
				{
					"id": 722150103,
					"content": "คนทุบหินคนนั้น บอกว่าอีกสักพักหินก้อนนั้นก็จะเคาะเสร็จแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150104
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150104,
					"content": "ไว้ Hibiki กลับมาเมื่อไหร่จะต้องดีใจมาก ๆ แน่เลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150105
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150105,
					"content": "เอาล่ะ ไม่ใช่แค่ทุบหินก้อนนั้นเท่านั้น ข้าน้อยจะต้องตกแต่งรอบ ๆ ศาลเจ้าซะหน่อย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150106
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150106,
					"content": "พวกท่านช่วยเอาไอ้เจ้าเหล็กกลม ๆ ที่มีเสียงกรุ๊งกริ๊งนี่ไปแขวนรอบ ๆ ศาลเจ้าหน่อยสิ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150107
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150107,
					"content": "ของพวกนี้เป็นสิ่งที่ Hibiki เตรียมเอาไว้น่ะ เห็นบอกว่า Domeki ให้เธอมา เพราะเห็นว่าชอบเล่นกับข้าน้อยแล้วก็พวกเด็ก ๆ น่ะ กว่าข้าน้อยจะหาเจอไม่ง่ายเลยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150108
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150108,
					"content": "นี่คือ...กระพรวน?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150109
					]
				},
				{
					"id": 722150109,
					"content": "กระพรวน? ข้าน้อยไม่เข้าใจแฮะ... แต่ก่อนหน้านี้ Hibiki มักจะชอบเล่นไอ้เจ้าเหล็กกลม ๆ นี่กับข้าน้อยด้วยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150110
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150110,
					"content": "Hibiki จะเอาเจ้าเหล็กกลม ๆ นี่วางไว้บนพื้นแล้วก็ตีไปไกล ๆ พอเจ้าเหล็กกลมเคลื่อนที่ ก็จะมีเสียงดังกรุ๊งกริ๊ง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150111
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150111,
					"content": "ไม่รู้ว่าเหมือนกันว่าไอ้เจ้าเหล็กกลม ๆ นี่มีพลังวิเศษอะไร พอข้าน้อยกับแมวตัวอื่นได้ยินเสียงก็อดไม่ได้ที่จะวิ่งตามไป",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150112
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150112,
					"content": "เพราะงั้นข้าน้อยเข้าใจแล้วล่ะ ที่ตอนนี้คนมาศาลเจ้าน้อยขนาดนี้ ต้องเป็นเพราะว่าศาลเจ้าไม่มีเจ้าเหล็กกลม ๆ นี่แน่เลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150113
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150113,
					"content": "ข้าน้อยเลยอยากจะขอให้เจ้าช่วยเอาเหล็กกลม ๆ นี่ไปแขวนไว้ที่สูง ๆ ให้หน่อยน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150114
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150114,
					"content": "แบบนี้พอคนได้เสียงเจ้าเหล็กกลม ๆ นี่ ก็จะได้มาศาลเจ้า แล้วก็ไม่ไปผิดทางยังไงล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150115
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150115,
					"content": "ที่นี้จะได้พากันมาโยน Mora ลงใน \"กล่องโยนเหรียญขอพร\" กันเยอะ ๆ ศาลเจ้าจะได้กลับมาคึกคัก และพอ Hibiki กลับมาก็จะได้มีความสุข",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150116
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150116,
					"content": "เพราะงั้นช่วยข้าน้อยเอาเจ้าเหล็กกลมนี่ไปแขวนรอบศาลเจ้าให้หน่อยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150117
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150117,
					"content": "เข้าใจแล้ว",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150118
					]
				},
				{
					"id": 722150118,
					"content": "รบกวนด้วยนะ เมี้ยว เมี้ยว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
