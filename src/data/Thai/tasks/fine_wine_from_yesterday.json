			"dialogs": [
				{
					"id": 705050101,
					"content": "นายท่าน Diluc! หายากนะเนี่ย! วันนี้ว่างไม่มีอะไรทำพอดีเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705050102,
					"content": "ว่างไม่มีอะไรทำอะไรกัน ฉันได้ยินข่าวว่าเธอมาทำงานเป็นบาร์เทนเดอร์ที่นี่ ก็เลยแวะดูแค่นั้นเอง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050103
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050103,
					"content": "ว้าว ข่าวนี่ไปไวจังเลยนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705050104,
					"content": "#แล้ว {NICKNAME} รู้สึกยังไงกับประสบการณ์การเป็นบาร์เทนเดอร์บ้างล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050105
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050105,
					"content": "เพิ่งจะเริ่มเอง...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705050106
					]
				},
				{
					"id": 705050106,
					"content": "ใช่แล้วล่ะ นายท่าน Diluc ถามเร็วเกินไปแล้วล่ะ พวกเราเพิ่งจะเริ่มต้นไม่นานนี้เอง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705050107,
					"content": "ก็แค่อยากจะถามความรู้สึกในแวบแรกน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050108
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050108,
					"content": "ตื่นเต้น? หรือว่าสับสน? รู้สึกยังไงก็พูดออกมาตรง ๆ ก็พอแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050109,
						705050110
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050109,
					"content": "ก็แปลกใหม่ดีนะ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705050111
					]
				},
				{
					"id": 705050111,
					"content": "อย่างนี้นี่เอง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050112
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050112,
					"content": "มะ ไม่ถาม Paimon หน่อยเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705050113,
					"content": "ความรู้สึกแรกของ Paimon ก็คือ... อร่อยมาก!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705050114,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050115
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050115,
					"content": "ถ้างั้นก็ดี ดีใจกับเธอด้วยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050116
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050116,
					"content": "ช่วยทำ Gray Valley Sunset ให้ฉันแก้วนึงได้มั้ย? ขนาดแก้วก็ตามใจเธอเลยละกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050117
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050117,
					"content": "เข้าใจแล้วล่ะ รอแป๊บนึงนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705050118
					]
				},
				{
					"id": 705050118,
					"content": "อืม ไม่ต้องรีบก็ได้นะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050110,
					"content": "ก็รู้สึกลนลานทำอะไรไม่ถูกอยู่นะ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705050111
					]
				}
			]
		},
