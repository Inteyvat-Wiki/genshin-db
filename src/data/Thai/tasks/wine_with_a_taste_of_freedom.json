			"dialogs": [
				{
					"id": 223030301,
					"content": "ฉันลองดูก่อนละกัน ดูซิว่าพอจะใช้วิธีของ Liyue มาทำกับดอก Dandelion ได้มั้ย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030302
