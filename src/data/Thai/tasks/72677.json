					"nextDialogs": [
						726771018
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726771018,
					"content": "#โอ๊ะ... ก็ใช่นะ {NICKNAME} นี่เป็นเพราะอะไรกันล่ะ?",
