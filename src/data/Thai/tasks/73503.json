				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735030101,
					"content": "อื้ม ที่นี่ไม่เลวเลยนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030102
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030102,
					"content": "นี่คุณกำลังวิจัยปริศนาอีกแล้วเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030103
					]
				},
				{
					"id": 735030103,
					"content": "นักเดินทาง! คุณมาพอดีเลย ฉันกำลังเตรียมจะออกแบบปริศนาต่อเนื่องอยู่น่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030104
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030104,
					"content": "ภูมิประเทศของที่นี่ค่อนข้างซับซ้อน คุณดูสิ ด้านนึงของท่าเรือมีระบบรากขนาดยักษ์ของ \"ต้นไม้ศักดิ์สิทธิ์\" ที่คอยนำน้ำเข้าไป",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030105
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030105,
					"content": "อีกด้านนึงก็เป็นใบบัวยักษ์ใบนึง กับกองเรือที่เตรียมจะออกสู่ทะเล",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030106
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030106,
					"content": "นักเดินทาง คุณคิดว่าปริศนาช่วงนี้ใช้ทัศนียภาพของฝั่งไหนเป็นหัวข้อดีล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030107,
						735030110,
						735030113
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030107,
					"content": "เริ่มจากระบบรากมั้ยล่ะ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030108
					]
				},
				{
					"id": 735030108,
					"content": "งั้นเหรอ? ระบบรากยักษ์ของ \"ต้นไม้ศักดิ์สิทธิ์\" สะดุดตามากจริง ๆ ถ้าเอามาเป็น \"จุดเริ่มต้น\" ของการไขปริศนาก็จะถูกสังเกตเห็นได้ง่ายกว่า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030109
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030109,
					"content": "ดีล่ะ! งั้นฉันจะใช้ระบบรากเป็นหัวข้อในการเขียนปริศนาละกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030115,
						735030116
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030115,
					"content": "ฮิฮิฮิ ฉันขอเขียนเอง",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030115,
						735030116
					]
				},
				{
					"id": 735030116,
					"content": "ฮิฮิฮิ ให้เป็นหน้าที่ฉันเอง",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030117
					]
				},
				{
					"id": 735030117,
					"content": "นี่ ทำไมเธอถึงยิ้มมีความสุขแบบนี้ล่ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735030118,
					"content": "เขียนเสร็จแล้ว ลองอ่านดูสิ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030119
					]
				},
				{
					"id": 735030119,
					"content": "\"สถานที่ซึ่งปัญญาหวนคืนทะเล สมบัติอยู่ท่ามกลางใบเรือ\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030120
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030120,
					"content": "ดูแล้วเข้าท่ามากเลย! แล้วปริศนานี้ก็ชวนให้นึกถึง \"ท่าเรือ\" ด้วย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030121
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030121,
					"content": "พอจับคู่กับ \"สถานที่ซึ่งปัญญาหวนคืนทะเล\" ก็ไม่ยากที่จะรู้ว่าสถานที่นี้เกี่ยวกับสถาบันหรือไม่ก็เมือง Sumeru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030122
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030122,
					"content": "นึกไม่ถึงว่าคุณจะมีความสามารถด้านนี้ด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030123
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030123,
					"content": "เดี๋ยวก่อนนะ ฉันจะติดปริศนานี้ไว้ตำแหน่งที่ถูกสังเกตเห็นได้ง่าย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030124
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030124,
					"content": "เอ๋? ติดไว้แถวนี้เหรอ? แต่ตำแหน่งที่ปริศนาพูดถึงก็อยู่ไม่ไกล? ไม่แน่อาจจะถูกหาเจอทันทีเลยก็ได้นะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735030125,
					"content": "ฮ่าฮ่าฮ่า ถือเป็นการกำหนดขอบเขตคำตอบของปริศนาไง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030126
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030126,
					"content": "ถ้าไม่ทำแบบนี้ งั้นขอบเขตในการไขปริศนาก็จะกว้างเกินไป",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030127
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030127,
					"content": "Drusus เริ่มจัดวางปริศนา...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						735030128
					]
				},
				{
					"id": 735030128,
					"content": "เอาล่ะ ปริศนาของที่นี่เอาไว้แบบนี้ละกัน พวกเราไปจุดต่อไปกันเถอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030129
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030129,
					"content": "เอ๋? มีจุดต่อไปด้วยเหรอ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735030110,
					"content": "ใบบัวกับเรือน่าสนใจจังเลย",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030111
					]
				},
				{
					"id": 735030111,
					"content": "ใช่แล้วล่ะ... ถ้าเชื่อมโยงสองอย่างนี้เข้าด้วยกัน ก็อาจจะสนุกไปอีกแบบนึงเหมือนกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030112
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030112,
					"content": "ไม่มีปัญหา ฉันจะใช้หัวข้อนี้เขียนปริศนาละกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030115,
						735030116
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030113,
					"content": "พวกนี้มันง่ายเกินไป!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030114
					]
				},
				{
					"id": 735030114,
					"content": "ง่ายเกินไปเหรอ? แล้วคุณมีความคิดอะไรอีกมั้ยล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030115,
						735030116
					],
					"speakerTitle": "Drusus"
				}
			]
		},
		{
			"id": 7350302,
			"completionStepIds": [
				7350302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
