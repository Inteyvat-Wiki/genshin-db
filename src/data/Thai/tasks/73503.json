					"Drusus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735030401,
					"content": "นี่เป็นหีบใบสุดท้ายแล้ว ครั้งนี้ไม่ต้องเขียนปริศนาแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030402
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030402,
					"content": "แต่จะใส่อะไรไว้ดีนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030403,
						735030406,
						735030409
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030403,
					"content": "ของที่มีค่ามากพอ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030404
					]
				},
				{
					"id": 735030404,
					"content": "มีเหตุผลนะ มูลค่าสิ่งของในหีบใบนี้ จะต้องคุ้มค่ากับความเหนื่อยที่ผู้ไขปริศนาใช้สมองอย่างยากลำบากมาตลอดทาง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030405
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030405,
					"content": "พูดถึงมูลค่าแล้ว ของที่มีมูลค่าชัดเจนที่สุดก็คงต้องเป็น Mora แล้วล่ะ อืม... ฉันจะใส่ Mora เข้าไปเยอะ ๆ ละกัน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030413
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030413,
					"content": "เอาล่ะ \"ปริศนา\" ชุดนี้ถือว่าจัดวางเสร็จเรียบร้อยแล้วล่ะ ขอบคุณที่ช่วยนะ นักเดินทาง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030414
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030414,
					"content": "ของพวกนี้ฉันให้คุณนะ ถือซะว่าเป็นของตอบแทนละกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030415
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030415,
					"content": "เห้อ ตอนแรกฉันกะว่าจะถกปริศนาแบบลงลึกกับคุณอีกสักหน่อย แต่ฉันยังต้องกลับไปจัดการธุระที่สถาบันต่อ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030416
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030416,
					"content": "ถ้าต่อไปคุณพบปริศนาแปลก ๆ ในการเดินทาง หรือว่ามีปริศนาที่ไขไม่ออกล่ะก็ อย่าลืมมาหาฉันล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030417
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030417,
					"content": "พวกเราจะได้มาถกเถียงกันแบบลงรายละเอียด แล้วก็... จัดวางให้กับพวกนักผจญภัยอีกที ฮ่าฮ่าฮ่า!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030418
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030418,
					"content": "งั้นฉันขอไปก่อนล่ะ นักเดินทาง ขอให้โชคดีในการเดินทางครั้งต่อไปของคุณนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030419
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030419,
					"content": "หวังว่ากองโจรล่าสมบัติที่ชื่อ Narzam จะไม่ก่อปัญหายุ่งยากขึ้นมานะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030406,
					"content": "ของที่มีคุณค่าในแบบใช้งานได้จริง",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030407
					]
				},
				{
					"id": 735030407,
					"content": "ใช้งานได้จริงงั้นเหรอ? เอิ่ม... มีของอะไรที่เอามาใช้ได้จริงบ้างนะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030408
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030408,
					"content": "จริงสิ! หลายวันก่อนฉันได้สูตรอาหารจากคนอื่นมาน่ะ ใส่เข้าไปในหีบเป็นของรางวัลแล้วกันนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030413
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030409,
					"content": "ประสบการณ์การครุ่นคิดครั้งนี้ก็คือสมบัติที่ดีที่สุดแล้ว",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030410
					]
				},
				{
					"id": 735030410,
					"content": "ฮ่าฮ่าฮ่าฮ่าฮ่า คุณพูดถูกเผงเลย! ถูกต้องที่สุด! การครุ่นคิดที่ยากลำบากนี้เป็นประสบการณ์ที่ยอดเยี่ยมและประเมินค่าไม่ได้! เทียบกับมันแล้ว ของอย่างอื่นดูไร้ค่าไปเลยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030411
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030411,
					"content": "ไม่ถูกต้องเลยสักนิด! ใส่ Mora หรือสูตรอาหารลงไปบ้างสิ! ไม่งั้นก็ใส่ผักผลไม้ก็ได้ อย่าปล่อยให้มันโล่ง ๆ อะไรก็ไม่ใส่สิ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735030412,
					"content": "ล้อเล่นน่า ล้อเล่นเฉย ๆ ยังไงฉันก็ต้องใส่ของรางวัลเข้าไปอยู่แล้วน่า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030413
					],
					"speakerTitle": "Drusus"
				}
			]
		},
