						],
						"stepId": 7350302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Drusus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735030201,
					"content": "ดีล่ะ! จัดวางปริศนาที่สองตรงนี้ละกัน ถ้าไขปริศนาข้อนี้ออก ก็จะเจอหีบสมบัติใบสุดท้าย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030202
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030202,
					"content": "ฉันกะว่าจะวางสมบัติสุดท้ายไว้... ตรงนั้น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030203
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030203,
					"content": "เอ๊ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735030204,
					"content": "อึก...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030205
					]
				},
				{
					"id": 735030205,
					"content": "นี่เป็นแค่เนินเขาธรรมดา แล้วมีน้ำตกน้อย ๆ ธรรมดา ๆ อยู่ข้าง ๆ ไม่ใช่เหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735030206,
					"content": "ถูกต้อง! แต่มันกำลังจะไม่ธรรมดาอีกต่อไป เพราะปริศนาของพวกเราไงล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030207
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030207,
					"content": "เอาล่ะ นักเดินทาง คุณมีข้อเสนอแนะกับปริศนาข้อนี้มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030208,
						735030211,
						735030214
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030208,
					"content": "เลิกทรมานคนอื่นเขาเถอะ เอาแบบตรงไปตรงมาหน่อยดีมั้ย...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030209
					]
				},
				{
					"id": 735030209,
					"content": "เอ๋? อย่างนี้เองเหรอ? อื้ม... คนไขปริศนาเดินทางข้ามภูเขามาถึงที่นี่ ก็ต้องรู้สึกเหนื่อยแหละนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030210
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030210,
					"content": "ได้ งั้นก็เอาแบบง่าย ๆ ละกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030219,
						735030220
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030219,
					"content": "จะบอกว่าเรียนมาโดยเฉพาะก็ไม่ถูกหรอก...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030219,
						735030220
					]
				},
				{
					"id": 735030220,
					"content": "เรียกว่าฝึกมาเยอะจนชำนาญดีกว่า...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030221
					]
				},
				{
					"id": 735030221,
					"content": "เป็นอย่างนี้นี่เอง สมแล้วที่เป็นนักเดินทาง รอบรู้จริง ๆ เลยนะ... ดีล่ะ ฉันจะเอาปริศนาที่คุณเขียนไปจัดวางเลยเดี๋ยวนี้เลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030222
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030222,
					"content": "Drusus เริ่มจัดวางปริศนา...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						735030223
					]
				},
				{
					"id": 735030223,
					"content": "เอาล่ะ! แผ่นป้ายประกาศเล็ก ๆ นี่น่าจะสะดุดตามากพอแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030224
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030224,
					"content": "งั้นตอนนี้เราไปจัดวางหีบสมบัติใบสุดท้ายเถอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030211,
					"content": "ใช้น้ำตกเป็นหัวข้อละกันนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030212
					]
				},
				{
					"id": 735030212,
					"content": "อืม... น้ำตกก็เป็นหัวข้อที่ชัดเจนมากทีเดียว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030213
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030213,
					"content": "โอเค งั้นใช้มันเป็นหัวข้อละกัน แล้วก็ความยากของปริศนาข้อสุดท้าย... เราปรับให้ยากน้อยลงหน่อยแล้วกันนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030219,
						735030220
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030214,
					"content": "ฮิฮิฮิ ฉันขอเขียนเอง",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030215
					]
				},
				{
					"id": 735030215,
					"content": "เน้! เธอจะหัวเราะดีใจมากเกินไปแล้วนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735030216,
					"content": "เขียนเสร็จแล้วล่ะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030217
					]
				},
				{
					"id": 735030217,
					"content": "\"ร่มเขียวโอบสมบัติเพ่งม่านมุก\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030218
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030218,
					"content": "อืม... ปริศนานี้ ให้ความรู้สึกพิเศษจังเลย... คุณได้ไปเรียนความรู้ด้านนี้ที่ไหนมาโดยเฉพาะรึเปล่า?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030219,
						735030220
					],
					"speakerTitle": "Drusus"
				}
			]
		},
