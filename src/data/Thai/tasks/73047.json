				"points": []
			},
			"dialogs": [
				{
					"id": 730470101,
					"content": "#Nara {NICKNAME}, Paimon เจอกันอีกแล้วนะ ฮี่ฮี่ฮี่...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470102
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730470102,
					"content": "ดูเหมือน Araja มีความสุขมากเลยนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730470103,
					"content": "ฮ่า ๆ ๆ... ข้ามีความสุขมากจริง ๆ ที่ได้เห็น Vanarana คึกคักขนาดนี้ มี Aranara มากมายกลับมายังบ้านเกิด อ่าา คิดไม่ถึงเลยว่าจะได้เข้าร่วมเทศกาลไร้อาวรณ์ด้วยตัวเอง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470104,
						730470105
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730470104,
					"content": "เธอไม่เคยเข้าร่วมเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730470107
					]
				},
				{
					"id": 730470107,
					"content": "ข้าได้มีส่วนร่วมในเรื่องราว และเคยเข้าร่วมอยู่ครั้งหนึ่ง แต่นั่นเป็นเรื่องที่ผ่านมานานมากแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470108
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730470108,
					"content": "ข้า, Aramuhukunda, Arana, Araji... เหล่า Aranara มากมาย ได้ร่วมฉลองเทศกาลไร้อาวรณ์ ด้วยกันกับ Nara Varuna",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470109
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730470109,
					"content": "นั่นเป็นยุคสมัยที่ยากลำบากมาก แต่ว่าในเทศกาลไร้อาวรณ์ เราก็ยังหัวเราะ และร้องเพลงไปด้วยกัน ข้าชอบเรื่องราวนี้ยิ่งนัก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470110
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730470110,
					"content": "เอ๋ Araja ก็เคยเข้าร่วมไม่ใช่เหรอ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730470111,
					"content": "อ้อ หากในเรื่องราวก็ถือว่าเคยเข้าร่วมจริง ๆ นั่นแหละ แต่ว่าข้าจำไม่ได้แล้ว เรื่องราวเหล่านั้นล้วนเป็นสิ่งที่ Arana มาบอกข้าในภายหลัง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470112
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730470112,
					"content": "อืม... รู้สึกว่า Araja พูดจาเหมือนคุณปู่แก่ ๆ เลย อาจเพราะอายุมากแล้วเลยจำไม่ค่อยได้ล่ะมั้ง!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730470113,
					"content": "#บางทีแบบนี้ก็อาจจะดีเหมือนกัน...ไม่ว่ายังไงก็ตาม Nara {NICKNAME}, Paimon พวกเจ้าเต็มใจที่จะรับสิ่งนี้ไว้มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470114
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730470114,
					"content": "ดอกไม้นี่...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730470115,
					"content": "อืม หวังว่าระหว่างการเดินทางต่อจากนี้ ดอกไม้ดอกนี้จะสามารถอยู่เคียงข้างพวกเจ้าไปตลอดนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470116,
						730470117
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730470116,
					"content": "งั้นฉันขอรับเอาไว้นะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730470118
					]
				},
				{
					"id": 730470118,
					"content": "เวลาของ Nara มีค่ามากกว่าเวลาของ Aranara มาก ข้าไม่รบกวนเวลาของพวกเจ้าแล้วล่ะ สนุกกันให้เต็มที่นะ อีกเดี๋ยวพวกเจ้าไปหา Arakavi ด้วยล่ะ เขาก็กำลังเตรียมพิธีของเทศกาลไร้อาวรณ์อยู่เหมือนกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araja"
				},
				{
					"id": 730470117,
					"content": "ขอบคุณนะ!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730470118
					]
				},
				{
					"id": 730470105,
					"content": "ฉันมีความสุขมากเหมือนกัน",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730470106
					]
				},
				{
					"id": 730470106,
					"content": "ฉันก็มีความสุขมากเหมือนกัน! แต่ว่าเมื่อก่อน Araja ไม่เคยเข้าร่วมเทศกาลไร้อาวรณ์เหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470107
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}