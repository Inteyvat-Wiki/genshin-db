						220300302
					]
				},
				{
					"id": 220300302,
					"content": "งั้นก็รบกวนเธอด้วย ฉันจะไปทางค่ายทางด้านนั้น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300303
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300303,
					"content": "คุณรับมือกับพวกมันคนเดียวได้เหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300304
					]
				},
				{
					"id": 220300304,
					"content": "แค่มอนสเตอร์ไม่กี่ตัว ไม่ต้องกังวลหรอก ถ้าไม่ได้เป็นห่วงเรื่องวัตถุดิบละก็ แค่ฉันคนเดียวก็สามารถรับมือกับมอนสเตอร์สองฝั่งได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300305
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300305,
					"content": "เอาล่ะ ถ้าเธอกำจัดมอนสเตอร์และเอาวัตถุดิบมาได้แล้ว ก็ไปหาฉันที่ค่ายอีกที่หนึ่งล่ะกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300306
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300306,
					"content": "พวกเรารีบเดินทางกันเถอะ ถ้าว่าวัตถุดิบเน่าล่ะก็ อาหารที่ทำออกมาคงกินไม่ได้แน่ ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamei Munehisa"
				}
			]
