			},
			"dialogs": [
				{
					"id": 210080101,
					"content": "ทำไมไม่ไปเองล่ะ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210080102
					]
				},
				{
					"id": 210080102,
					"content": "เอ่อ คืออย่างนี้นะ จะมีคนมาตรวจดูไฟของคบเพลิงน่ะ.... ฉันอยู่ที่นี่ยังพอจะซื้อเวลาได้บ้าง..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080103
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 210080103,
					"content": "ถ้าเกิดคนตรวจมาเจอคุณยืนอยู่ที่นี่ หรือเจอว่าที่นี่ไม่มีคนเลย นั่นมันยิ่งแย่เลยไม่ใช่เหรอไง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080104
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 210080104,
					"content": "เพราะงั้น ช่วยทีเถอะนะนักเดินทาง! ไปจุดไฟทีเถอะนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinghuo"
				}
			]
		},
