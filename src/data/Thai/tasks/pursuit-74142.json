						741421419
					]
				},
				{
					"id": 741421419,
					"content": "ไม่รู้ แต่ฉันไม่อยากอ่านหนังสืออีกแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421420
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421420,
					"content": "...Canotila แบบนี้มันสุดโต่งไปหน่อยรึเปล่า?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421421,
					"content": "อืม แต่ \"หนังสือวิวรณ์\" น่ากลัวมากจริง ๆ นะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421422
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421422,
					"content": "(สรุปว่าเกิดอะไรขึ้นกันแน่เนี่ย?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421423,
					"content": "(อธิบายยากน่ะ...)",
