					"nextDialogs": [
						741421413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421413,
					"content": "ฮือฮือ... ขอบคุณนะ Paimon... อื้ม...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421414
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421414,
					"content": "(เคี้ยว)",
					"roleType": "TALK_ROLE_NPC",
