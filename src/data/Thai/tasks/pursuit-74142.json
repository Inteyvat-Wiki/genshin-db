						],
						"pointId": 6836
					}
				]
			},
			"dialogs": [
				{
					"id": 741420401,
					"content": "#เอ๋ พี่ {NICKNAME}... เมื่อกี้พวกเราเพิ่งเจอกันไม่ใช่เหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420402
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741420402,
					"content": "ตอนไหนเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420403
					]
				},
				{
					"id": 741420403,
					"content": "เอ่อ ฉันก็ไม่แน่ใจเหมือนกัน... แต่ยังไงก็ที่นี่เนี่ยแหละ แค่ไม่รู้ว่าตอนไหน!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420404
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741420404,
					"content": "Canotila ไปกับฉันหน่อยเถอะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420405
					]
				},
				{
					"id": 741420405,
					"content": "ที่นี่ไม่ปกติเลย",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420406
					]
				},
				{
					"id": 741420406,
					"content": "แต่จะปกติหรือไม่ปกติ ก็ไม่ใช่สิ่งที่พวกเราจะตัดสินได้ไม่ใช่เหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420407
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741420407,
					"content": "อืม... ฉันก็ไม่ได้มีเจตนาอื่นหรอก แต่สำหรับฉันแล้ว ที่นี่ดีมากจริง ๆ ที่นี่เต็มไปด้วยความมีชีวิตชีวาและสีสัน ฉันไม่เคยเห็นภาพแบบนี้ในโลกนั้นมาก่อนเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420408
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741420408,
					"content": "ฉันเห็นแค่ดอกทานตะวันดอกเดียว...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420409
					]
				},
				{
					"id": 741420409,
					"content": "จริงเหรอ? ว้าว! ที่ไหนกัน?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420410
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741420410,
					"content": "ที่ที่เราเจอหมาน้อยก่อนหน้านี้",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420411
					]
				},
				{
					"id": 741420411,
					"content": "อ๋อ! ฉันไปก่อนล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420412
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741420412,
					"content": "เดี๋ยวก่อน...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
