					"nextDialogs": [
						741421426
					]
				},
				{
					"id": 741421426,
					"content": "(อะไรกัน! น่าโมโหจริง ๆ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421427
					],
					"speakerTitle": "Paimon"
				},
				{
