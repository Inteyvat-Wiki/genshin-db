						750320603
					]
				},
				{
					"id": 750320603,
					"content": "เธอได้ยินฉันพูดกับตัวเองซะแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320606
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320606,
					"content": "ฉันคิดว่าจะไปจากที่นี่แล้วกลับบ้านสักหน่อย ฉันยังไม่ได้บอกครอบครัวเรื่องที่ตัวเองเกษียณเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320607
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320607,
					"content": "ต่อไปฉันก็จะมีเวลาว่างเต็มที่แล้ว ยังไม่ได้คิดเลยว่าจะทำอะไรดี",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320608
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320608,
					"content": "พอปรับสภาพจิตใจตัวเองแล้ว ก็ต้องเผชิญกับช่วงต่อไปของชีวิต",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320609
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320609,
					"content": "ฟังคำแนะนำของคนในครอบครัวก่อนน่าจะดีกว่า พ่อฉันเคยเป็นสมาชิกหน่วยนักบิน แล้วพอเกษียณก็ไปเป็นครูฝึก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320610
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320610,
					"content": "เส้นทางที่ฉันเคยเดิน เขาเองก็เคยเดินมาก่อน น่าจะมีมุมมองพิเศษอะไรบ้างแหละ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320611
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320611,
					"content": "เพราะงั้นฉันจะรื้อกระท่อมลอยฟ้านี้แล้วเอามันไปด้วย แต่จะเก็บเส้นทางเอาไว้ เพราะว่านักรบรุ่นเยาว์อย่างเธอ คงต้องการสถานที่ฝึกฝนแน่นอน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320612
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320612,
					"content": "Manyoya ต่อไปเราจะได้เจอเธออีกมั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750320613,
					"content": "ฉันไม่รู้หรอก แต่ฉันเดาว่า ไม่ว่าตัวเองจะเลือกอะไร คงทิ้งท้องฟ้าไม่ได้อยู่ดี",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320614
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320614,
					"content": "ตราบใดที่เธอยังโบยบินอยู่ เราคงจะได้เจอกันอีก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320615
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320615,
					"content": "แล้วเจอกันใหม่นะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320616
					]
				},
				{
					"id": 750320616,
					"content": "แล้วเจอกันใหม่ นักรบรุ่นเยาว์",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manyoya"
				},
				{
