					"Xavier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721190101,
					"content": "อ๋า! นักเดินทาง ฉันว่า...ท่าทางไม่ค่อยดีเท่าไหร่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190102
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190102,
					"content": "พวก Fatui ได้รวมกองกำลังของพวกเขาไว้ใกล้กับแกนกลาง ดูเหมือนว่าพวกเขาจะค้นพบอะไรบางอย่าง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190103
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190103,
					"content": "พวกเขาคงจะไม่สามารถทำลายการป้องกันของแกนกลางได้จริง ๆ หรอกใช่มั้ย... ไม่ได้แล้ว พวกเราจะมัวช้าอยู่ไม่ได้ ต้องเริ่มการทดสอบการใช้งานทันทีแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190104
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190104,
					"content": "การทดสอบการทำงาน?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721190105
					]
				},
				{
					"id": 721190105,
					"content": "ก็คือทดสอบความสามารถในการชำระล้างของเพื่อนใหม่เราซะหน่อย ฉันไม่อยากจะพบว่ามันไม่สามารถทำงานได้ หลังจากที่ขนมันเข้าไปข้างในเรียบร้อยแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190106
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190106,
					"content": "ดังนั้น ฉันอยากจะขอให้คุณช่วยหา Onikabuto มาสามตัว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190107
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190107,
					"content": "ฉันอยากจะนำพวกมันไปไว้รอบ ๆ Mikage Furnace ในตอนนี้ เพื่อให้พวกมันปนเปื้อน Tatarigami",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190108
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190108,
					"content": "จากนั้นค่อยนำพวกมันกลับมา แล้วลองใช้อุปกรณ์ชำระล้างเพื่อชำระ Tatarigami ที่พวกมันได้รับการปนเปื้อน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190109
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190109,
					"content": "และนี่คือ \"การทดสอบการใช้งาน\" ที่ฉันออกแบบ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190110
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190110,
					"content": "จะสามารถหา \"Onikabuto\" ได้จากที่ไหนบ้าง?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721190111
					]
				},
				{
					"id": 721190111,
					"content": "อืม... โดยทั่วไปแล้วพวกมันจะอาศัยอยู่ในพื้นที่ที่อุดมไปด้วยธาตุไฟฟ้า...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190112
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190112,
					"content": "นอกจากนี้ฉันยังได้ยินมาว่า พวกมันสามารถมีชีวิตอยู่ได้แม้ว่าจะอยู่ใกล้กับ Mikage Furnace... เจ้าตัวเล็กพวกนั้นช่างร้ายกาจซะจริง ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190113
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190113,
					"content": "งั้นฉันเข้าไปจับใน Mikage Furnace โดยตรงเลยไม่ดีกว่าเหรอ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721190114
					]
				},
				{
					"id": 721190114,
					"content": "ถึงแม้ว่าสามารถทำแบบนั้นได้เหมือนกัน แต่ถ้าไปจับ Onikabuto ใน Mikage Furnace มาทดสอบโดยตรงเลยล่ะก็...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190115
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190115,
					"content": "บอกตามตรงว่าฉันกังวลมากเกี่ยวกับ... ความน่าเชื่อถือของเพื่อนใหม่ของเรา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190116
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190116,
					"content": "ในการทำการทดสอบ ทางที่ดีควรทำการทดสอบทีละขั้นตอน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190117
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190117,
					"content": "อะแฮ่ม สรุปก็คือ ช่วยฉันหา Onikabuto มาสามตัวทีนะ ฉันจะรอคุณอยู่ที่นี่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190118,
						721190120
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190118,
					"content": "ให้ฉันจัดการเอง",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721190119
					]
				},
				{
					"id": 721190119,
					"content": "งั้นก็ขอรบกวนคุณหน่อยนะ ขอแค่ Onikabuto สามตัวเท่านั้น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190120,
					"content": "ไม่งั้นสู้ฉันเข้าไปเดินวนสักรอบเลย...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721190121
					]
				},
				{
					"id": 721190121,
					"content": "เอ่อ...ในเรื่องของการทดสอบแล้ว ถ้าคุณเข้าไปข้างในและวนไปรอบ ๆ แล้วออกมาหลังจากถูกปกคลุมไปด้วย Tatarigami คุณก็สามารถเป็นผู้ถูกทดสอบได้อย่างแน่นอน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190122
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190122,
					"content": "แต่ก่อนหน้านี้ฉันก็เคยพูดแล้วว่า ความน่าเชื่อถือของอุปกรณ์นี้ค่อนข้าง... ไม่ได้เป็นไปตามที่หวัง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190123
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190123,
					"content": "ถ้าหากระหว่างขั้นตอนการชำระล้าง เกิดสถานการณ์ที่อยู่เหนือความคาดหมายจริง ๆ ล่ะก็ คุณก็อาจจะ... ต้องเผชิญกับปัญหาที่อยู่นอกเหนือจากความคาดหมายเช่นกัน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190124
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190124,
					"content": "เห้อ ยังไงซะ พวกเราก็ใช้ Onikabuto ในการทดลองเถอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190125
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190125,
					"content": "ต้องการ Onikabuto แค่สามตัวเท่านั้น คุณจับได้เมื่อไหร่ ก็นำมันมาให้ฉันเถอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
