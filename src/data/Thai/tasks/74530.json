				"points": []
			},
			"dialogs": [
				{
					"id": 745300401,
					"content": "อ๊ะ อาจารย์! กลับมาแล้วเหรอ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300402,
						745300403
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300402,
					"content": "Kachina ดูมีความสุขมากเลยนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300404
					]
				},
				{
					"id": 745300404,
					"content": "ฮิฮิ ครั้งนี้ฉันขุดเจอแร่ดิบคุณภาพดีมากเลยล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300405
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300405,
					"content": "ถ้าขัดเกลาให้ดี ๆ อาจจะกลายเป็นอัญมณีเม็ดโต ที่เปล่งประกายวิบวับก็ได้นะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300406
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300406,
					"content": "เยี่ยมไปเลย!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300407
					]
				},
				{
					"id": 745300407,
					"content": "อืม! ตอนแรกฉันไม่เจออะไรเลย นึกว่าจะต้องกลับมือเปล่าซะแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300408
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300408,
					"content": "แต่ฉันก็คิดว่าต้องอดทนต่อไป... เลยบอกกับตัวเองว่า ขุดลงไปอีกนิดนะ อีกแค่นิดเดียวเท่านั้น...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300409
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300409,
					"content": "ไม่รู้ว่าทำแบบนั้นซ้ำ ๆ กี่ครั้ง ในที่สุดก็เจออันนี้เข้า!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300410
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300410,
					"content": "พอฉันออกมาได้ ถึงรู้ว่าพระอาทิตย์กำลังจะตกแล้ว... ดูเหมือนว่าฉันจะเผลอขุดไปทั้งวันโดยไม่รู้ตัวเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300411,
						745300412
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300411,
					"content": "สมแล้วที่เป็น Kachina มีความมุ่งมั่นดีจริง ๆ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300413
					]
				},
				{
					"id": 745300413,
					"content": "อื้อ... จริงเหรอ? ฉัน... ฉันเขินกล้องน่ะ ไม่รู้ว่าจะถ่ายออกมาดีรึเปล่า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300414
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300414,
					"content": "แต่ว่า... ถ้าเป็นคำขอจากอาจารย์ ฉันจะพยายามให้เต็มที่นะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300415,
						745300416
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300415,
					"content": "เธอพยายามมากแล้วล่ะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300417
					]
				},
				{
					"id": 745300417,
					"content": "อืม! ฉันเข้าใจแล้ว งั้นก็ฝากด้วยนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300416,
					"content": "Kachina เป็นอย่างนี้ก็ดีอยู่แล้วนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300417
					]
				},
				{
					"id": 745300412,
					"content": "ขอถ่ายรูปเธอที่กำลังเปล่งประกายได้มั้ย?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300413
					]
				},
				{
					"id": 745300403,
					"content": "มีเรื่องดี ๆ อะไรเกิดขึ้นงั้นเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300404
					]
				}
			]
		}
	]
