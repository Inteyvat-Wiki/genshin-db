					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030316,
					"content": "เป็นสิ่งที่อันตรายมาก...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030318
