					"nextDialogs": [
						80030319
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030319,
					"content": "งั้นงั้นงั้น จะจัดการกับดวงตานี่ยังไงดีล่ะ?",
