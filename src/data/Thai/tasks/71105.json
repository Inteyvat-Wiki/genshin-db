				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 711050201,
					"content": "\"หลับเพลินไปหน่อย! ต้องรีบกลับไปก่อนวันพรุ่งนี้แล้ว ไม่อย่างนั้นจะไม่มีคนดูแล Xiangjun... ฉันนี่โง่จริง ๆ...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050202
					],
					"speakerTitle": "บันทึกของใครสักคน"
				},
				{
					"id": 711050202,
					"content": "\"ฉันจำได้ว่าจากหุบเขา Yaodie ไปภูเขา Xuanlian ตรงกลางมีถนนเล็ก ๆ อยู่หนึ่งสาย... เดินไปตามถนนสายเล็ก จากนั้นทะลุถ้ำหนึ่งแห่งก็จะถึงแล้ว...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050203
					],
					"speakerTitle": "บันทึกของใครสักคน"
				},
				{
					"id": 711050203,
					"content": "\"ได้ยินว่าแถวนั้นมีมอนสเตอร์อยู่ด้วย แต่ตอนนี้คงได้แค่ลองใช้ทางลัดดูแล้วล่ะ...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050204
					],
					"speakerTitle": "บันทึกของใครสักคน"
				},
				{
					"id": 711050204,
					"content": "ดูเหมือนว่านี่คือสิ่งที่คุณปู่คนนั้นทิ้งไว้สินะ? เขาไปทางลัดแล้ว! พวกเราไปตามหากันเถอะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7110505,
			"completionStepIds": [
				7110505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7110505",
							"2"
						],
						"stepId": 7110505,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 711050501,
					"content": "\"...ถึงแม้กลัวว่าจะมีมอนสเตอร์... แต่...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050502
					],
					"speakerTitle": "บันทึกของใครสักคน"
				},
				{
					"id": 711050502,
					"content": "\"...ไหลเยอะมาก... ต้นขาห้ามไม่อยู่แล้ว...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050503
					],
					"speakerTitle": "บันทึกของใครสักคน"
				},
				{
					"id": 711050503,
					"content": "\"...ง่วงจัง... แต่ภูเขา Xuanlian อยู่ข้างหน้านี่เอง... Xiangjun... ฉันต้องเอาน้ำทิพย์มาให้ได้...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050504
					],
					"speakerTitle": "บันทึกของใครสักคน"
				},
				{
					"id": 711050504,
					"content": "\"...Xiangjun... ฉันต้องเอาน้ำทิพย์มาให้ได้...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
