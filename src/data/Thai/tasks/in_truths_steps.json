					"Bahar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736960101,
					"content": "สวัสดี นักเดินทาง ดูท่าทางแล้ว... คุณคงมาเข้าร่วมงานรื่นเริงประเทืองปัญญาสินะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960102
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960102,
					"content": "ถ้าสนใจละก็ ลองมาเล่นกิจกรรมที่คณะ Haravatat ของเราจัดขึ้นดูมั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960103
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960103,
					"content": "ฉันจำได้ว่าคณะ Haravatat ศึกษาด้าน...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736960104
					]
				},
				{
					"id": 736960104,
					"content": "ถ้าใช้คำหนึ่งมาสรุปแบบคร่าว ๆ แล้วก็คือ... \"ภาษา\" นั่นเอง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960105
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960105,
					"content": "นี่แหละสิ่งที่คณะ Haravatat ของพวกเรากำลังศึกษาวิจัย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960106
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960106,
					"content": "เป็นไง? ฟังดูไม่เข้ากับบรรยากาศผ่อนคลายสนุกสนานของงานรื่นเริงประเทืองปัญญาเลยใช่มั้ยล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960107
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960107,
					"content": "เพื่อน ๆ หลายคนในคณะเราก็คิดแบบนี้เหมือนกันนั่นแหละ ทุกคนออกมาเที่ยวเล่นสนุกครึกครื้นทั้งที เราจะไปขอให้คนเขาทายปริศนาก็คงไม่ได้หรอกเนอะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960108
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960108,
					"content": "แถมเกมอย่างการทายปริศนา ก็ไม่ค่อยดึงดูดความสนใจของทุกคนซะด้วยสิ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960109
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960109,
					"content": "หลังจากที่หารือกันอย่าง... สมานฉันท์มาหลายวัน พวกเราก็คิดเกม \"แสวงหาความจริง\" ออก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960110
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960110,
					"content": "อีกอย่างเกมนี้ก็ไม่ต้องใช้อุปกรณ์มากมาย ขอแค่คุณเตรียมสมองของตัวเองให้พร้อมก็พอแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960111
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960111,
					"content": "ก่อนที่เกมนี้จะเริ่มขึ้น ฉันจะทำการเล่าเรื่องสั้นหนึ่งเรื่องให้คุณฟัง เรื่องเล่าอาจฟังดูไม่ค่อยสมบูรณ์เท่าไหร่ และบางจุดก็อาจย้อนแย้งกันอีกด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960112
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960112,
					"content": "ส่วนคุณจะสามารถ \"ถามคำถาม\" ฉันได้ แต่ฉันจะให้คำตอบแค่ 3 แบบ นั่นคือ <color=#00E1FFFF>\"ใช่\"</color> <color=#00E1FFFF>\"ไม่ใช่\"</color> และ <color=#00E1FFFF>\"ไม่เกี่ยวข้อง\"</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960113
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960113,
					"content": "สิ่งที่คุณต้องทำ ก็คือใช้การ \"ถามคำถาม\" เพื่อค้นหา \"ความจริง\" ของเรื่องเล่าออกมา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960114
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960114,
					"content": "แต่คุณไม่ต้องเครียดจนเกินไปนะ เพราะความจริงของเรื่องเล่านี้ไม่ได้ซับซ้อนอะไรมากนักหรอก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960115
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960115,
					"content": "เป็นยังไงบ้าง? ถ้าสนใจละก็ เรามาเริ่มกันตอนนี้เลยมั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960116,
						736960118
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960116,
					"content": "งั้นก็เริ่มกันเถอะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736960117
					]
				},
				{
					"id": 736960117,
					"content": "ไม่มีปัญหา งั้นก็ฟังเรื่องเล่าเรื่องแรกให้ดี ๆ นะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960118,
					"content": "ยังมีเรื่องอื่นต้องทำน่ะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736960119
					]
				},
				{
					"id": 736960119,
					"content": "ช่วงนี้ฉันจะประจำอยู่ตรงนี้ตลอด ถ้าคุณอยากเล่นก็มาหาฉันได้ตลอดเวลาเลยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bahar"
				}
			]
		}
	]
}