					"Kujou Kamaji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120180506,
					"content": "ท่านโชกุน!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180507
					],
					"speakerTitle": "Takatsukasa Susumu"
				},
				{
					"id": 120180507,
					"content": "ทำไมท่านโชกุนถึง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180508
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180508,
					"content": "บอกสถานการณ์ของสถานที่นี้ให้ข้าฟัง ทายาทตระกูล Takatsukasa",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180509
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180509,
					"content": "พวกเรากำลังพูดถึงเรื่องเล็กน้อยที่เกิดขึ้นเมื่อเร็ว ๆ นี้ในสำนัก Tenryou ท่านโชกุนไม่ต้องกังวลถึงเรื่องนั้น...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180510
					],
					"speakerTitle": "Takatsukasa Susumu"
				},
				{
					"id": 120180510,
					"content": "เพราะแบบนี้ถึงต้องเลือกสถานที่ลับหูลับตาคนแบบนี้ แล้วยังต้องให้พวกโรนินและ Kairagi มาคุ้มกันไว้อีกงั้นเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180511
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180511,
					"content": "นั่นเป็นเพราะช่วงก่อนเกิดความวุ่นวายขึ้น ก็เลยต้องคำนึงถึงปัญหาเรื่องความปลอดภัย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180512
					],
					"speakerTitle": "Takatsukasa Susumu"
				},
				{
					"id": 120180512,
					"content": "พอได้แล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180513
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180513,
					"content": "ทายาทตระกูล Kujou ไหนเจ้าลองเล่ามาสิ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180514
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180514,
					"content": "ได้เลยขอรับ เดิมทีฉันมาที่นี่เพื่อมาเจรจา แต่ไม่คิดว่าสิ่งที่พวกเขาต้องการคือคำสารภาพที่เป็นลายลักษณ์อักษรจากตระกูล Kujou เท่านั้นเอง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180515
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180515,
					"content": "คำสารภาพที่เป็นลายลักษณ์อักษรงั้นเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180516
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180516,
					"content": "ใช่แล้วขอรับ คำแถลงยอมรับทุกอาชญากรรมที่ก่อโดยตระกูล Kujou ตั้งแต่เริ่มก่อตั้งคำสั่งล่าวิชั่น รวมถึงการประพฤติผิดล่าสุดทั้งหมด...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180517
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180517,
					"content": "ข้อความทั้งหมดก็เขียนขึ้นตามข้อเท็จจริง ไม่มีการสร้างเรื่องขึ้นมาสักหน่อย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180518
					],
					"speakerTitle": "Takatsukasa Susumu"
				},
				{
					"id": 120180518,
					"content": "ฉันไม่ปฏิเสธเรื่องนั้นหรอก แต่ว่าในคำสารภาพยังเน้นย้ำถึงคุณงามความดีของตระกูล Takatsukasa อยู่หลายครั้ง บอกว่าตระกูล Takatsukasa กำลังตกอยู่ในอันตรายและพยายามพลิกกระแส...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180519
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180519,
					"content": "แต่เรื่องพวกนี้ไม่ใช่เรื่องจริงเลยสักนิด",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180520
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180520,
					"content": "ใครเขียนแบบนั้นกัน? ทำไมนาย... นายเปลี่ยนสีเร็วขนาดนี้ละ พูดกลับกันไปหมด!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180521
					],
					"speakerTitle": "Takatsukasa Susumu"
				},
				{
					"id": 120180521,
					"content": "ฉันเองก็กำลังอธิบายความจริงอยู่ไงล่ะ ท่านโชกุนท่านสามารถตัดสินข้อเท็จจริงได้ด้วยตัวเอง ความคิดของตระกูล Takatsukasa ก็แค่ต้องการการสร้างภาพลักษณ์ที่ดีและหาทางแทนที่ตระกูล Kujou!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180522
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180522,
					"content": "ไม่อย่างนั้น ทำไมต้องเน้นย้ำบุญคุณที่ไม่เคยมีอยู่ในคำสารภาพของตระกูล Kujou แล้วยังใช้วิธีกักบริเวณบังคับให้ฉันเซ็นชื่อล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180523
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180523,
					"content": "นายพูดเรื่องอะไรกัน? ใครกักบริเวณนาย! นี่คือการเจรจา! นี่ไม่เหมือนกับที่คุยกันเมื่อกี้เลยนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180524
					],
					"speakerTitle": "Takatsukasa Susumu"
				},
				{
					"id": 120180524,
					"content": "ข้าพอจะเข้าใจสถานการณ์แล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180525
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180525,
					"content": "อย่าไปฟังเรื่องไร้สาระของเด็กคนนี้ ความผิดพลาดครั้งใหญ่ที่ตระกูล Kujou เคยทำมาก่อน ท่านโชกุนก็รู้ว่าคำพูดของพวกเขาไม่สามารถเชื่อถือได้!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180526
					],
					"speakerTitle": "Takatsukasa Susumu"
				},
				{
					"id": 120180526,
					"content": "หึ ความขัดแย้งของพวกเจ้า ข้าไม่ได้สนใจหรอกนะ แต่ทายาท Takatsukasa เจ้าคงจะอยากเป็นคนดูแลสำนัก Tenryou สินะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180527
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180527,
					"content": "เอ่อ เรื่องนี้... ก็ใช่ขอรับ เป็นการแสวงหาชั่วนิรันดร์ของทุกคนในสำนัก Tenryou มอบชีวิตของเราเพื่อรับใช้ท่านโชกุนผู้ทรงอำนาจ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180528
					],
					"speakerTitle": "Takatsukasa Susumu"
				},
				{
					"id": 120180528,
					"content": "สถานการณ์ก็ไม่ซับซ้อนอย่างที่คิด ยังไงซะ ในเมื่อข้าเป็นคนแต่งตั้งผู้นำ Tenryou ใครก็ตามที่สามารถเอาชนะข้าได้จะกลายเป็นผู้นำคนใหม่ของสำนัก Tenryou",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180529
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180529,
					"content": "ต้อง... จะต้องประลองกับท่านโชกุนงั้นเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180530
					],
					"speakerTitle": "Takatsukasa Susumu"
				},
				{
					"id": 120180530,
					"content": "รุ่นแรก ๆ ของสำนัก Tenryou ต่างใช้ฝีมือดาบในการพิสูจน์เจตจำนงของเขา จากนั้นตระกูล Kujou ก็ได้สืบทอดมาจนถึงปัจจุบัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180531
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180531,
					"content": "อยากให้ฉันยอมรับคนใหม่ ๆ ก็ต้องผ่านการทดสอบจากข้าก่อนสิ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180532
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180532,
					"content": "เอ่อ คือ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180533
					],
					"speakerTitle": "Takatsukasa Susumu"
				},
				{
					"id": 120180533,
					"content": "หรือว่าพวกเจ้าไม่รู้วิชาดาบ? หรือเพราะความชราและความอ่อนแอก็เลยสูญเสียความมั่นใจ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180534
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180534,
					"content": "ตะโกนปาว ๆ ว่ายอมสละชีวิตเพื่อรับใช้ข้า แต่กลับไม่กล้าเผชิญหน้ากับดาบของข้างั้นเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180535
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180535,
					"content": "อ๋า...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180536
					],
					"speakerTitle": "Takatsukasa Susumu"
				},
				{
					"id": 120180536,
					"content": "ช่างเถอะ แล้วพวกเจ้าล่ะ? ไม่ว่าจะเป็น Takatsukasa หรืออะไรก็ตาม ใครที่สามารถเอาชนะข้าได้ คนผู้นั้นก็เป็นผู้นำสำนัก Tenryou",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180537
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180537,
					"content": "......",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180538
					],
					"speakerTitle": "ผู้ดูแลตระกูล Takatsukasa"
				},
				{
					"id": 120180538,
					"content": "ไม่มีผู้ใดกล้าก้าวออกมาเลยงั้นเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180539
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180539,
					"content": "......",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180540
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180540,
					"content": "ฉัน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180541
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180541,
					"content": "ฉันขอท้าทายท่าน ท่านโชกุน!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180542
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180542,
					"content": "ห๊าาา?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180543
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120180543,
					"content": "ทายาทตระกูล Kujou น่าเสียดายจัง ต่อให้เจ้าเอาชนะข้าได้ ก็ไม่สามารถลบความผิดของตระกูล Kujou ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180544
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180544,
					"content": "ฉันรู้เรื่องนั้น ฉันไม่คิดว่าฉันมีโอกาสชนะ และฉันรู้ว่าท่านผู้นำเคยทำผิดแบบนั้น และการที่สืบทอดตำแหน่งผู้นำของตระกูล Kujou ควรจะสิ้นสุดลง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180545
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180545,
					"content": "ในตอนที่ใช้คำสั่งล่าวิชั่น ฉันสงสัยในความคิดของท่านพ่อเสมอ และฉันก็รู้สึกว่าตัวเองกำลังทำในสิ่งที่ผิด",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180546
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180546,
					"content": "แต่ก็ทำได้แค่คิดสงสัย ไตร่ตรอง เข้าใจทุกอย่างอย่างชัดเจน แต่ไม่ได้ดำเนินการใด ๆ และไม่ได้ช่วยผู้ใดเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180547
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180547,
					"content": "การล่มสลายของตระกูล Kujou ถือเป็นบทลงโทษสำหรับฉัน ฉันไม่ได้ทำอะไรเลย และทำอะไรไม่ได้เลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180548
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180548,
					"content": "พูดอย่างไม่ถนอมน้ำใจเลยนะ พลังของเจ้าทำอะไรไม่ได้มากหรอก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180549
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180549,
					"content": "เป็นแบบนั้นแหละ พลังของฉันอ่อนแอมาก พ่อไม่มีทางฟังฉัน พี่ชายก็ช่วยอะไรฉันไม่ได้ บางครั้ง Ippei ก็ยังต้องคอยสั่งสอนฉัน มันเป็นแบบนั้นมาโดยตลอด...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180550
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180550,
					"content": "แต่อย่างน้อยในตอนนี้ ในวาระสุดท้ายของตระกูล Kujou ฉันในฐานะตัวแทนของตระกูล Kujou! จะรับทำหน้าที่เดียวกับพ่อของฉัน!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180551
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180551,
					"content": "ก็เหมือนอย่างที่ท่านโชกุนพูดไว้ บรรพบุรุษของฉันพิสูจน์เจตจำนงของพวกเขาด้วยดาบ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180552
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180552,
					"content": "ถ้าอย่างนั้นก็ให้ฉัน Kujou Kamaji จบสิ้นมันด้วยวิธีการเดียวกัน!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180553
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180553,
					"content": "นี่เป็นโอกาสสุดท้ายแล้วที่ฉันพอจะทำอะไรได้บ้าง!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180554
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180554,
					"content": "ทั้ง ๆ ที่มันก็ไม่มีความหมายอะไร",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180555
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180555,
					"content": "แต่ข้าจะรับไว้ละกัน เข้ามาเถอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ei"
				}
			]
		},
