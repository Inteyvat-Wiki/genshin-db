			"dialogs": [
				{
					"id": 3540401,
					"content": "ขอเทพแห่งลมจงสถิตอยู่กับเธอนะ คุณคนแปลกหน้า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540402
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540402,
					"content": "ฉันคือหน่วยลาดตระเวนของกองอัศวิน มีนามว่า Amber",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540403
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540403,
					"content": "เธอไม่ใช่คน Mondstadt ใช่มั้ย? ถ้างั้นรบกวนแสดงบัตรประจำตัวของตัวเองหน่อย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540404
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540404,
					"content": "ใจเย็นก่อน...พวกเราไม่ใช่คนน่าสงสัยหรอกนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3540405,
					"content": "พวกน่าสงสัยก็พูดอย่างนี้ทุกคนแหละ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540406
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540406,
					"content": "#สวัสดี ฉันชื่อ {NICKNAME}",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3540407
					]
				},
				{
					"id": 3540407,
					"content": "...ฟังชื่อดูแล้วไม่น่าใช่คนที่นี่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540408
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540408,
					"content": "แล้วยังเจ้า...ตัวมาสคอตนี่ มันคืออะไรกันน่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540409,
						3540412
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540409,
					"content": "เพื่อนฉันเอง",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3540410
					]
				},
				{
					"id": 3540410,
					"content": "เอ่อ...แม้ว่าจะเพิ่งรู้จักกันได้แค่สองเดือนน่ะนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3540411,
					"content": "แต่ก็กลายเป็นเพื่อนรักกันแล้วล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3540414,
					"content": "สรุปก็คือ...เป็นนักเดินทางใช่มั้ย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540415
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540415,
					"content": "เร็ว ๆ นี้มีมังกรยักษ์ออกมาป้วนเปี้ยนแถว Mondstadt ถ้าเธอเข้าไปในเมืองโดยเร็วน่าจะดีที่สุดนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540416
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540416,
					"content": "ที่นี่อยู่ไม่ไกลจาก Mondstadt ให้อัศวินอย่างฉันไปส่งพวกเธอดีกว่า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540417
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540417,
					"content": "เอ๋? เธอออกจากเมืองมา ไม่มีหน้าที่อื่นต้องทำเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3540418,
					"content": "มีสิ แต่วางใจเถอะ ฉันทำหน้าที่ระหว่างที่ส่งเธอกลับไปอย่างปลอดภัยพร้อมกันได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540419
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540419,
					"content": "นอกจากนี้...ฉันก็ไม่สามารถปล่อยคนน่าสงสัยไปได้!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540420,
						3540421
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540420,
					"content": "ดูแล้วเธอยังไม่เชื่อฉันเท่าไหร่นะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3540422
					]
				},
				{
					"id": 3540422,
					"content": "อ๊ะ...ล่วงเกินไปหน่อย อัศวินที่ดีไม่ควรพูดอย่างนี้เลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540423
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540423,
					"content": "ฉันต้องขอโทษพวกเธอด้วยนะ เอ่อ...คุณนักเดินทางแปลกหน้าผู้น่านับถือ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540424
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540424,
					"content": "นั่นดูฝืนใจมากเลยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3540425,
					"content": "เธอไม่พอใจการใช้ภาษาที่ \"คู่มือแนะนำการเป็นอัศวิน\" บอกไว้งั้นเหรอ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540421,
					"content": "การพูดแบบนี้กับแขก ดูไม่สุภาพเลยนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3540422
					]
				},
				{
					"id": 3540412,
					"content": "เป็นอาหารฉุกเฉิน",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3540413
					]
				},
				{
					"id": 3540413,
					"content": "ไม่ใช่สิ! นั่นยิ่งแย่กว่าตัวมาสคอตอีก!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540414
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
