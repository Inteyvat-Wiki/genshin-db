	"talks": [
		{
			"id": 7224601,
			"completionStepIds": [
				7224602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224602",
							"2"
						],
						"stepId": 7224602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sumida",
					"Kama"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722460101,
					"content": "เป็นสร้อยข้อมือที่สวยมาก! ช่างเป็นแจกันที่สวยงามอะไรเช่นนี้! ของของ Liyue สวยงามมากจริง ๆ !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460102
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460102,
					"content": "...อ๊ะ ไม่สิ การใช้คำแบบนี้ สำหรับนักเขียนนิยายแล้ว มันช่างน่าขายหน้าซะจริง ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460103
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460103,
					"content": "ซื้อขวดลายครามที่แสนจะสวยงามนี้ แล้วใช้เป็นข้อมูลอ้างอิงสำหรับการเขียนนวนิยายตอนต่อไปก็แล้วกัน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460104
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460104,
					"content": "อื้ม... เขียนพล็อตแบบนี้ก็แล้วกัน!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460105
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460105,
					"content": "\"กุญแจสำคัญที่พลิกสถานการณ์ ก็คือวิชั่นที่ซ่อนอยู่ในแจกัน...! \"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460106
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460106,
					"content": "ฟังดูน่าสนใจมากทีเดียวนะเนี่ย! นายว่าไง Kama?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460107
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460107,
					"content": "ฉันยังไงก็...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460108
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460108,
					"content": "......",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460109
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460109,
					"content": "...โดยส่วนตัวแล้วฉันคิดว่า การใช้พู่กันและหมึกสำหรับ \"แจกัน\" นั้นต้องควบคุมให้ดี หากใส่รายละเอียดมากจนเกินพอดี มันจะทำให้ดูเน้นหนักจนเกินไป แต่ถ้าขาดรายละเอียดไปล่ะก็ สุดท้ายมันจะดูขาดตอน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460110
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460110,
					"content": "โอ้ววว พูดได้ดีมาก! ขอฉันจดก่อนนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460111
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460111,
					"content": "อ๊ะ ขอโทษทีนะ พวกเราเปลี่ยนที่กันเถอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460112
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460112,
					"content": "แล้วก็ฉันบอกนายตั้งกี่ครั้งแล้ว ว่าอย่าเรียกฉันว่าท่านหญิง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460113
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460113,
					"content": "อื๋อ? พอลองคิดดูดี ๆ แล้ว นักเดินทางสองคนที่ดูแสนจะธรรมดา การที่คนหนึ่งจะเรียกอีกคนหนึ่งว่า \"ท่านหญิง\" ก็เป็นพล็อตเรื่องที่เห็นได้บ่อย ๆ นี่นะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sumida"
				}
			]
		},
		{
			"id": 7224602,
			"completionStepIds": [
				7224603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224603",
							"2"
						],
						"stepId": 7224603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sumida",
					"Kama"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722460201,
					"content": "ฮู้วววว มีความสุขจังเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460202
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460202,
					"content": "หรือต้องบอกว่า สมกับที่เป็นห้องสมุดที่ใหญ่ที่สุดของแดนเหนือ! ถึงกับสามารถอ่าน \"ความเศร้าโศกของ Vera\" จนจบได้ในคราวเดียวแบบนี้! มีความสุขเป็นบ้าเลย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460203
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460203,
					"content": "ท่านหญิง Sumida... เบาเสียงลงหน่อยเถอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460204
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460204,
					"content": "อ๊ะ ขอโทษที ก็มันตื่นเต้นนี่นา...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460205
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460205,
					"content": "ไม่ใช่อะไร คือฉันกลัวว่าคุณจะเจ็บตัวน่ะ คุณบรรณารักษ์คนนั้นให้ความรู้สึกถึงแรงกดดันที่รุนแรงมาก...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460206
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460206,
					"content": "เอ๋? งั้นเหรอ? ฉันกลับคิดว่าเป็นแม่มดคนหนึ่งที่ดูขี้เกียจตามแบบฉบับทั่วไป...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460207
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460207,
					"content": "...แต่พอมาลองคิดดูดี ๆ แล้ว โดยทั่วไปแล้วตัวละครแบบนี้จะแข็งแกร่งที่สุดนี่นะ แบบนี้ไม่ดีแน่ จะทำให้เธอโกรธไม่ได้เด็ดขาด...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460208
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460208,
					"content": "อืมม เอาล่ะ มีเหตุผล ให้ตัวละครแบบนี้เป็นตัวหลัก ในการเขียนรอบต่อไปก็แล้วกัน \"จอมเวทแห่งห้องสมุดใหญ่\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460209
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460209,
					"content": "การเดินทางของพวกคุณเป็นยังไงบ้าง?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460210
					]
				},
				{
					"id": 722460210,
					"content": "ไม่เจอกันนานเลยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460211
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460211,
					"content": "#เห้ {NICKNAME} ในตำนานนี่นา...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460212
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460212,
					"content": "การเดินทางน่ะเหรอ... ก่อนหน้านี้ฉันก็ต้องออกเดินทางเพื่อรวบรวมข้อมูลอยู่บ่อย ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460213
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460213,
					"content": "\"ไปที่ Musoujin Gorge เพื่อเขียนคำอธิบายของภัยพิบัติสายฟ้า\" \"ไปที่ Serpent's Head เพื่อเขียนอธิบายเกี่ยวกับปีศาจงู\" \"ให้ Kama เข้าร่วมเพื่อเขียนอธิบายเกี่ยวกับผู้หนีสายฟ้า\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460214
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460214,
					"content": "ลำบากแย่เลยนะ Kama...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460215
					]
				},
				{
					"id": 722460215,
					"content": "ก็ไม่ได้ลำบากอะไรหรอกนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460216
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460216,
					"content": "แต่ว่า ครั้งนี้เป็นการเดินทางที่แท้จริง เป็นการเดินทางไกลที่ไร้ซึ่งจุดหมาย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460217
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460217,
					"content": "ฉันเพิ่งค้นพบว่า มีเรื่องราวที่คู่ควรแก่การเขียนและเรื่องราวที่น่าสนใจอยู่เยอะมากจริง ๆ เหมือนกับ \"การเดินทางของ Kino\" เลยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460218
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460218,
					"content": "ฉันกับ Kama กำลังตามหาสถานที่และร้านค้าต่าง ๆ ที่คนในพื้นที่แนะนำ จากนั้นก็จะไปตั้งแคมป์กลางแจ้งที่นอกเมือง และแบ่งปันกองไฟและเรื่องราวร่วมกันกับนักเดินทางแปลกหน้า...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460219
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460219,
					"content": "แล้วเมื่อตื่นขึ้นมา ก็พบว่าเงินที่ใช้สำหรับการเดินทางได้ถูกขโมยไปเรียบร้อยแล้ว...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460220
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460220,
					"content": "...แบบนั้นไม่มีปัญหาเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460221
					]
				},
				{
					"id": 722460221,
					"content": "ไม่มีปัญหา หลังจากที่เจอโจรพวกนั้นและพบว่าพวกเขามีกันอยู่มากกว่าสิบคน ฉันก็นึกว่าคงไม่มีทางจะเอากลับมาได้ซะแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460222
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460222,
					"content": "แต่ Kama กลับสามารถคิดหาทางพูดเกลี้ยกล่อมพวกเขาได้ จนได้เงินกลับคืนมาทั้งหมด แถมยังได้เหรียญที่ระลึกมากมายที่มีลวดลายอีกามาอีกด้วย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460223
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460223,
					"content": "ทั้ง ๆ ที่สามารถนำมาทำเป็นพล็อตเรื่องที่น่าสนใจได้แท้ ๆ แต่ว่า Kama ดันไม่ยอมบอกฉันว่าเขาทำยังไง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460224,
						722460225
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460224,
					"content": "......",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460226
					]
				},
				{
					"id": 722460226,
					"content": "เป็นเรื่องที่ฉันควรทำน่ะ ขอท่านหญิง Sumida อย่าได้ใส่ใจเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460227
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460227,
					"content": "ไม่หรอก Kama พึ่งพาได้มากจริง ๆ !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460228
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460228,
					"content": "เมื่ออยู่กับนาย ถึงจะเป็นการเดินทางเพื่อมุ่งไปยังสุดขอบโลก ก็คงจะไม่มีปัญหาอะไรล่ะนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460229
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460229,
					"content": "ยิ่งกว่านั้น ฉันมักจะรู้สึกว่า ตั้งแต่เกาะ Tsurumi เป็นต้นมา นายเปลี่ยนไปมากเลยนะ มีเรื่องที่อยากทำ และยังตั้งคำถามและแสดงความคิดเห็นอีกด้วย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460230
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460230,
					"content": "หากท่านหญิง Sumida คิดว่าไม่เหมาะสมล่ะก็...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460231
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460231,
					"content": "ฉันคิดว่ามันดีมากเลยล่ะ! ความคิดเห็นของนายน่ะ ค่อนข้างน่าสนใจเลยทีเดียว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460232,
						722460233
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460232,
					"content": "งั้น ฉันไม่กวนแล้วล่ะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460234
					]
