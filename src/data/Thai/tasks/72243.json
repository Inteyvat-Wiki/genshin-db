			"dialogs": [
				{
					"id": 722430102,
					"content": "ฉันมีสมบัติอยากเอามาขายน่ะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722430103
					]
				},
				{
					"id": 722430103,
					"content": "ขายสมบัติ? น่าแปลกใจจริง ๆ เลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430104
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430104,
					"content": "นักผจญภัยที่เก่งกาจแบบเธอ สิ่งที่เธอต้องการขายจะต้องหายากแน่เลยใช่มั้ยล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430105
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430105,
					"content": "เอามาให้ฉันดูเร็วเข้าสิ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430106
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430106,
					"content": "เล่าเรื่อง Dragonbone Orb ให้ Marjorie ฟัง",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722430107
					]
				},
				{
					"id": 722430107,
					"content": "เอ นี่มันคล้ายกับเรื่อง Fretnaught Fruit ที่นักกวีพเนจรพูดถึงไม่ใช่เหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430108
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430108,
					"content": "มีของแบบนี้อยู่จริง ๆ ด้วยงั้นเหรอ... ชื่อเดิมของมันคือ Dragonbone Orb",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430109
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430109,
					"content": "ถ้าผลลัพธ์ของมันเหมือนกับที่เธอพูดจริง ๆ ฉันยินดีที่จะจ่ายเงิน 80000 Mora พร้อมกับเมนูพิเศษบางอย่างเพื่อซื้อมัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430110
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430110,
					"content": "อืม... 80000 Mora พร้อมกับ Moon Pie 5 จาน เธอคิดว่าไง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430111,
						722430114,
						722430120
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430111,
					"content": "คุณจะเอามันไปทำอะไรล่ะ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722430112
					]
				},
				{
					"id": 722430112,
					"content": "ฮิฮิ สมบัติล้ำค่าขนาดนั้น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430113
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430113,
					"content": "ผลลัพธ์ดั่งเทพนิยายแบบนี้ ฉันเชื่อว่าพวกนักเล่นแร่แปรธาตุพวกนั้นไม่เสียดายกระเป๋าเงินของพวกเขาแน่ ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430110
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430114,
					"content": "ราคายุติธรรม ตกลงตามนั้น",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722430115
					]
				},
				{
					"id": 722430115,
					"content": "ถ้าอย่างนั้นฉันขอเก็บสมบัติชิ้นนี้ไว้เลยนะ ขอบคุณที่มาอุดหนุน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430116
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430116,
					"content": "จริงด้วยสิ โดยปกติแล้ว สิ่งของที่เป็นควบแน่นเป็นเม็ดแบบนี้มักจะระเหยช้า ๆ ไปตามสายลม",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430117
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430117,
					"content": "ดังนั้นควรใช้ไดอะแฟรมครอบไว้หรือใส่ไว้ในภาชนะที่ปิดสนิท แบบนี้คุณภาพก็จะดีขึ้น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430118
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430118,
					"content": "นี่คือเคล็ดลับเล็ก ๆ น้อย ๆ สำหรับเธอ หวังว่าจะช่วยในการผจญภัยของเธอได้นะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430119
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430119,
					"content": "ถ้าวันหลังเธอเจอสมบัติประเภทนี้อีกล่ะก็ อย่าลืมว่ามีผู้ซื้อขาประจำของเธออยู่ที่นี่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430120,
					"content": "ไว้ฉันจะคิดดูอีกทีนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722430121
					]
				},
				{
					"id": 722430121,
					"content": "ฮ่าฮ่า ไม่มีปัญหา แต่ฉันเชื่อว่าราคาของฉันเหมาะสมที่สุดแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430122
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430122,
					"content": "ถ้าเธอคิดไตร่ตรองดีแล้ว ก็มาหาฉันใหม่ได้นะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marjorie"
				}
			]
