	"talks": [
		{
			"id": 7351301,
			"completionStepIds": [
				7351301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7351301",
							"2"
						],
						"stepId": 7351301,
						"stateName": "QUEST_STATE_UNFINISHED"
