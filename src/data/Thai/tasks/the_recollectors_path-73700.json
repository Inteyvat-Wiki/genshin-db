				],
				"points": []
			},
			"dialogs": [
				{
					"id": 737000101,
					"content": "รู้ตัวอีกทีการฝึกฝนก็ดำเนินถึงครึ่งหลังแล้วสินะ ทุกอย่างราบรื่นดีไหม?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000102,
						737000103
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737000102,
					"content": "เรียกได้ว่ากำลังไปได้สวยเลยล่ะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737000104
					]
				},
				{
					"id": 737000104,
					"content": "ตอนที่ Sorush เล่าเรื่องให้เราฟัง ก็ดูเหมือนกำลังคิดทบทวนไปด้วยอยู่นะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737000105,
					"content": "การสนทนาเป็นวิธีเรียนรู้ที่ดีมากสำหรับ Sorush โดยเฉพาะยามที่คู่สนทนาไม่ใช่เจ้าพวกคนน่าเบื่อจากกลุ่มวิมตินิยมน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000106
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737000106,
					"content": "#ท่านผู้อาวุโสพูดแบบนี้ก็ด่วนสรุปไปหน่อยนะ... {NICKNAME} ในฐานะ \"ยัสนาปติ\" ถือว่าโดดเด่นมากก็จริง แต่คนของกลุ่มวิมตินิยมก็ใช่ว่าจะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000107
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737000107,
					"content": "บางทีนอกจากการยกยอปอปั้นและการโกหกปิดบังแล้ว พวกเขาก็อาจพอมีความดีหลงเหลืออยู่บ้างละมั้ง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000108
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737000108,
					"content": "ฮื่อ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000109
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737000109,
					"content": "#ท่าทางเจ้าจะไม่เห็นด้วยนะ งั้นประเดี๋ยวก็ให้สักขีพยานอย่าง {NICKNAME} กับ Paimon เป็นคนช่วยวิจารณ์แล้วกัน แน่นอนว่าหลังจากที่เจ้าเล่าจบน่ะนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737000103,
					"content": "ยังสามารถพัฒนาได้อีก",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737000104
					]
				}
			]
		},
		{
			"id": 7370006,
			"completionStepIds": [
				7370006
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7370006",
							"2"
						],
						"stepId": 7370006,
						"stateName": "QUEST_STATE_UNFINISHED"
