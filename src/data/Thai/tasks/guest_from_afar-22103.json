					"nextDialogs": [
						221030303
					]
				},
				{
					"id": 221030303,
					"content": "เยี่ยมไปเลย... ในที่สุดก็สามารถทำธุรกิจอย่างสบายใจได้ซักที",
					"roleType": "TALK_ROLE_NPC",
