			"dialogs": [
				{
					"id": 230240101,
					"content": "ในที่สุดพวกเธอทั้งสองคนก็มาแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240102
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240102,
					"content": "เวลากำลังดี ทุกอย่างเรียบร้อย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240103
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240103,
					"content": "ทำไมถึงได้ตื่นเต้นขนาดนี้ล่ะ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230240104
					]
				},
				{
					"id": 230240104,
					"content": "หรือว่าดอกกุหลาบก่อนหน้านี้จะบานแล้ว?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230240105,
					"content": "ใช่แล้ว ฮ่าฮ่าฮ่า! ทั้งหมดนี้ต้องขอบคุณความช่วยเหลือจากเธอด้วยนะ นักเดินทาง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240106
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240106,
					"content": "แม้ว่ากุหลาบต้นนี้จะยังไม่บาน แต่ดูจากลักษณะต้นของมันแล้ว ดูท่าจะแข็งแรงดีทีเดียว!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240107
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240107,
					"content": "นักเดินทาง ถ้าเธอสนใจก็มาดูใกล้ ๆ ได้นะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240108
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240108,
					"content": "ฮ่าฮ่าฮ่า ไม่แน่นะ มันอาจจะบานต่อหน้าพวกเธอก็ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240109
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240109,
					"content": "งั้นฉันจะจ้องไม่กะพริบตาเลย...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230240110
					]
				},
				{
					"id": 230240110,
					"content": "จะ...จริงเหรอ? มันจะบานเร็วขนาดนั้นเลยเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230240111,
					"content": "ตั้งตารอเลย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
