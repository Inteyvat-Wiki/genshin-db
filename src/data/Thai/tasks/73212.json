					"nextDialogs": [
						732121012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732121012,
					"content": "พวกเขาบอกว่ารู้จักเรา",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121013
					]
				},
				{
					"id": 732121013,
					"content": "เอ่อ... ใช่!",
