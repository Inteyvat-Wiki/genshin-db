					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732120503,
					"content": "สินค้ากระจัดกระจายไปตามทาง...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120504
					]
				},
				{
					"id": 732120504,
					"content": "ดูไม่ค่อยดีเท่าไหร่เลย... บางทีพวกเขาอาจจะทิ้งของอื่น ๆ ไว้ระหว่างทางก็ได้ พวกเราลองตามไปดูดีมั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
