					"speakerTitle": "ตรวจสอบ"
				},
				{
					"id": 732120502,
					"content": "ดูสิ! ไหนี้ยังไม่จมลงไปในทรายเลย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120503,
