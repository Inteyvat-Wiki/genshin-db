			"dialogs": [
				{
					"id": 240160301,
					"content": "ฮู่ว... ขอบคุณที่ช่วยนะ ถ้าไม่มีเธอช่วยล่ะก็ ฉันก็ไม่รู้ว่าเมื่อไหร่จะเก็บกวาดเสร็จ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160302
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160302,
					"content": "สมแล้วที่เป็นนักวิจัยกิตติมศักดิ์ระดับสูง ไม่ว่าจะทำอะไรก็ทำได้อย่างรวดเร็ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160303,
						240160304
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160303,
					"content": "ฉันเจ๋งอยู่แล้ว",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160306
					]
				},
				{
					"id": 240160306,
					"content": "ขอบคุณอีกครั้งที่ช่วยนะ นักวิจัยกิตติมศักดิ์ระดับสูง ของพวกนี้กรุณารับไว้ด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160304,
					"content": "ฉันถนัดเรื่องทำความสะอาดน่ะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160305
					]
				},
				{
					"id": 240160305,
					"content": "เอ๋? งั้นคุณก็เก่งกาจมากจริง ๆ นะ สมแล้วที่เป็นนักวิจัยกิตติมศักดิ์ระดับสูง!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160306
					],
					"speakerTitle": "Chalmet"
				}
			]
