				]
			},
			"dialogs": [
				{
					"id": 790710101,
					"content": "#ยินดีต้อนรับสู่เมืองหลวง Constellation นะ {NICKNAME}, คุณ Paimon",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710102
					],
					"speakerTitle": "Alof"
				},
				{
					"id": 790710102,
					"content": "ฉันได้ยินชื่อและเรื่องราวของพวกคุณจากเพื่อนร่วมงานแล้วล่ะ พวกคุณสองคนช่างเป็นคนที่กล้าหาญดีจริง ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710103
					],
					"speakerTitle": "Alof"
				},
				{
					"id": 790710103,
					"content": "ถ้าไม่ใช่เพราะฉันต้องรับผิดชอบเรื่องการฝึกซ้อมทหารรักษาการณ์ ก็คงอยากจะประลองกับคุณทั้งสองคนดูสักตั้งเหมือนกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710104
					],
					"speakerTitle": "Alof"
				},
				{
					"id": 790710104,
					"content": "คุณคือทหารรักษาการณ์ ของเมืองหลวงงั้นเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790710105
					]
				},
				{
					"id": 790710105,
					"content": "ใช่แล้วล่ะ ฉันรอทำตามคำสั่งของท่านเจ้าเมือง เพื่อปกป้องเมืองหลวง Constellation และรักษาความสงบสุขของที่นี่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710106
					],
					"speakerTitle": "Alof"
				},
				{
					"id": 790710106,
					"content": "หน้าที่ของฉันก็คือการฝึกฝนทหารรักษาการณ์ ให้พวกเขามีความสามารถที่คู่ควรกับหน้าที่ของตัวเอง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710107
					],
					"speakerTitle": "Alof"
				},
				{
					"id": 790710107,
					"content": "แสดงว่าประตูข้างหลังนี้ ก็คือสนามฝึกซ้อมสินะ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790710108
					]
				},
				{
					"id": 790710108,
					"content": "สังเกตได้ดีมาก ทางเข้านี้จะพาไปยังดันเจี้ยนแห่งหนึ่ง ก่อนหน้านี้ไม่นาน พวกเราก็เพิ่งจะทำการปรับปรุงมันเสร็จ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710109
					],
					"speakerTitle": "Alof"
				},
				{
					"id": 790710109,
					"content": "ในสนามฝึกซ้อมนี้ ผู้ฝึกต้องกวัดแกว่งดาบตามจังหวะที่กำหนด โดยที่สภาพแวดล้อมการส่องสว่างของสนาม จะเปลี่ยนแปลงไปตลอดการต่อสู้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710110
					],
					"speakerTitle": "Alof"
				},
				{
					"id": 790710110,
					"content": "เป็นการฝึกที่เข้มงวดมากเลย...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790710111
					]
				},
				{
					"id": 790710111,
					"content": "ฟังดูซับซ้อนจัง... ตอนที่ต่อสู้ยังต้องทำตามจังหวะที่กำหนดด้วยเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790710112,
					"content": "ที่จริงตรงส่วนนี้มาจากนิทานที่ชื่อว่า \"นักดนตรีนกฮูก\" น่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710113
					],
					"speakerTitle": "Alof"
				},
				{
					"id": 790710113,
					"content": "ช่วงก่อนหน้านี้ เรื่องนี้ได้รับความนิยมในหมู่ทหารรักษาการณ์ มีหลายคนที่ดูเรื่องนี้อย่างสนุกสนาน ถึงขั้นลืมเรื่องการฝึกซ้อม และมีบางคนถึงขนาดที่ว่า ลืมเรื่องการลาดตระเวนประจำวันไปเลยด้วยซ้ำ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710114
					],
					"speakerTitle": "Alof"
				},
				{
					"id": 790710114,
					"content": "ในเมื่อทุกคนชอบหนังสือเล่มนี้มาก ฉันเลยคิดว่าการเพิ่มองค์ประกอบของเรื่องนี้ เข้าไปในการฝึกซ้อมด้วย แบบนี้ทุกคนจะต้องชอบการฝึกมากขึ้นแน่ ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710115
					],
					"speakerTitle": "Alof"
				},
				{
					"id": 790710115,
					"content": "ดูจากผลลัพธ์แล้ว ผลการฝึกซ้อมออกมาดีมากเลยล่ะ อย่างน้อย... ก็ไม่มีใครพลาดเวลาลาดตระเวนไป เพราะเหตุผลส่วนตัวอีกแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710116
					],
					"speakerTitle": "Alof"
				},
				{
					"id": 790710116,
					"content": "ฮ่าฮ่า... ไม่รู้ว่าคุณทั้งสองคนสนใจการฝึกซ้อมของพวกเรามั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710117
					],
					"speakerTitle": "Alof"
				},
				{
					"id": 790710117,
					"content": "ฉันว่าด้วยความสามารถของคุณทั้งสองคนแล้ว การทดสอบต่าง ๆ ในสนามฝึกซ้อม คงไม่ใช่เรื่องยากอะไรหรอก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710118,
						790710120
					],
					"speakerTitle": "Alof"
				},
				{
					"id": 790710118,
					"content": "ฉันอยากลองดู!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790710119
					]
				},
				{
					"id": 790710119,
					"content": "เยี่ยมเลย กล้าหาญดีมาก เชิญคุณเข้าไปในดันเจี้ยนได้เลยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alof"
				},
				{
					"id": 790710120,
					"content": "ยังมีเรื่องอื่นต้องทำน่ะ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790710121
					]
				},
				{
					"id": 790710121,
					"content": "ไม่เป็นไร ถ้าคุณทั้งสองคนมีเวลาค่อยมาก็ได้ ช่วงนี้ฉันเฝ้าอยู่ที่นี่ตลอดเลยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alof"
				}
			]
		}
	]
}