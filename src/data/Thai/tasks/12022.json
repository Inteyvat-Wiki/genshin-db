						],
						"stepId": 1202208,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sangonomiya Kokomi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120220204,
					"content": "Kokomi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220205,
					"content": "ที่แท้ก็อยู่ที่นี่เองเหรอ! ไหนบอกว่าวันนี้เราจะไปเตรียมงานเลี้ยงฉลองด้วยกันไง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220206,
					"content": "โอ้... พวกเธอเองเหรอ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220207
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220207,
					"content": "ขอโทษนะ วันนี้... ฉันรู้สึกไม่ค่อยดีเท่าไร",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220208
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220208,
					"content": "เธอไม่สบายเหรอ? เราไปหาหมอกันเดี๋ยวนี้เลย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220209,
					"content": "เปล่าหรอก แค่ตอนนี้ \"พลังงาน\" ของฉันใกล้จะใช้หมดแล้วน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220210
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220210,
					"content": "พลังงาน... ระ หรือว่า Kokomi ไม่ใช่มนุษย์งั้นเหรอ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220211,
					"content": "เปล่า แค่พูดเปรียบเทียบเฉย ๆ น่ะ ถึงจะขายหน้าอยู่หน่อยที่ต้องยอมรับ แต่ว่าฉันไม่ได้เก่งรอบด้านตลอดเวลาหรอกนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220212,
						120220213
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220212,
					"content": "เมื่อวานตอนที่โดนเรียกไปนั่นมานี่...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120220214
					]
				},
				{
					"id": 120220214,
					"content": "อ๊ะ เธอสังเกตเห็นด้วยเหรอ? ดูแล้วฉันยังซ่อนความรู้สึกไม่ดีพอสินะ ต้องฝึกให้มากกว่านี้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220215
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220215,
					"content": "พูดตามตรง ฉันไม่เหมาะจะเป็นผู้นำหรอก ในตอนแรก ๆ ฉันฝันว่าจะได้อ่านตำราทางการทหาร แล้วสักวันได้ทำหน้าที่เป็นที่ปรึกษา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220216
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220216,
					"content": "การพูดคุย, การดูแลความรู้สึก, การสังเกตคำพูดของคนอื่น รวมถึงการจัดสรรผลประโยชน์.... ในความคิดของฉันมันเป็นเรื่องที่ยุ่งยากมากเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220217
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220217,
					"content": "การทำให้คนอื่นรู้สึกดีเพียงแค่ได้อยู่ต่อหน้าฉัน และในขณะเดียวกันก็ต้องได้รับความเคารพจากพวกเขาด้วย... มันเป็นเรื่องที่ฉันไม่เก่งเลย พูดตามตรง มันเป็นสิ่งที่ฉันไม่เคยต้องการจะเข้าไปยุ่ง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220218
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220218,
					"content": "แต่ด้วยสายเลือดของฉัน สุดท้ายตำแหน่ง \"ผู้นำมิโกะ\" ก็ต้องเป็นของฉันอยู่ดี ไม่ว่าจะเต็มใจหรือไม่ก็ตาม ฉันก็ไม่มีทางเลือกอยู่ดี",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220219
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220219,
					"content": "เพราะงั้น เวลาฉันรู้สึกว่าทนไม่ไหว ก็จะมาอ่านหนังสือ พักผ่อนหย่อนใจอยู่ที่นี่...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220220
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220220,
					"content": "ไม่ต้องห่วงหรอกนะ เรื่องนี้ไม่กระทบกับงานหรอก เรื่องการเตรียมงานเลี้ยงฉลอง ฉันได้สั่งให้คนอื่นจัดการแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220221
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220221,
					"content": "เย็นนี้ฉันต้องขึ้นปราศรัย จะให้เหล่าทหารรู้ว่ามีสิ่งผิดปกติไม่ได้... กว่าจะสงบศึกกันมันไม่ง่ายเลย ฉันหวังว่าพวกเขาจะผ่อนคลายกันได้บ้าง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
