			"dialogs": [
				{
					"id": 750090101,
					"content": "...ค่าเข้าสามร้อย Mora",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090102,
						750090103
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090102,
					"content": "ลดให้หน่อยได้มั้ย?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750090105
					]
				},
				{
					"id": 750090105,
					"content": "นี่เป็นราคาที่สมาคมวิจัยมรดกแห่ง Saurian กำหนดไว้ ต่อรองไม่ได้หรอก เท่าที่ฉันรู้ ที่นี่เป็นสถานที่ขุดสำรวจที่ราคาถูกที่สุดแล้ว เพราะเปิดมาตั้งนานแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090106
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090106,
					"content": "แต่ตอนนี้ก็มีนักฝันอย่างพวกเธอมาเสี่ยงโชคเป็นครั้งคราวเหมือนกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090107
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090107,
					"content": "ไม่แน่นะ บางทีคนก่อนหน้าเป็นร้อยเป็นพันอาจจะไม่เห็นค่าของมัน พลาดสิ่งที่ดูเหมือนธรรมดาแต่จริง ๆ แล้วเป็นสมบัติ Saurian สุดล้ำค่าที่มีมูลค่ามหาศาลก็ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090108
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090108,
					"content": "แต่คนที่ยอมจ่ายสามร้อย Mora เพื่อความฝันที่งดงามน่ะ ก็มีอยู่เยอะเลยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090109
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090109,
					"content": "เธอเองก็เชื่อว่าตัวเองเป็นคนโชคดีที่ไม่เหมือนใครใช่มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090110
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090110,
					"content": "กี้...กี้! กี้กี้!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090111,
						750090112
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090111,
					"content": "ฉันมั่นใจในโชคของตัวเอง",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750090113
					]
				},
				{
					"id": 750090113,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} ก็อยากไปเสี่ยงโชคเหมือนกันเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090114,
					"content": "กี้!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090115
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090115,
					"content": "ดูท่าทางจะสนใจมากเลยนะ หึหึ แค่สามร้อย Mora เอง ฉันออกให้ก็ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090116,
					"content": "แค่สามร้อย Mora ก็ซื้อความหวังได้สามส่วนแล้ว นี่ถือว่าคุ้มค่ามากเลยนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090117,
					"content": "งั้นก็ขอให้ทุกท่านโชคดี",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090112,
					"content": "ไม่เป็นไรหรอก ฉันมี Saurian ตัวน้อยนำโชคอยู่",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750090113
					]
				},
				{
					"id": 750090103,
					"content": "ถ้าเอาชนะคุณได้ ก็ได้เข้าฟรีแล้วใช่มั้ย?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750090104
					]
				},
				{
					"id": 750090104,
					"content": "คนปกติเขาไม่ต่อรองกันแบบนี้หรอกนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090105
					],
					"speakerTitle": "Paimon"
				}
			]
		},
