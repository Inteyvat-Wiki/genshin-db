					"nextDialogs": [
						200110206,
						200110207
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200110206,
					"content": "ไม่มีปัญหา",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200110208
					]
				},
				{
					"id": 200110208,
					"content": "ขอบคุณ ฉันจะขอพักหน่อยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200110207,
					"content": "ฉันรีบอยู่นะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200110209
					]
				},
				{
					"id": 200110209,
					"content": "แต่ Anna ยังรอฉันอยู่ที่บ้าน... ยังไงช่วยฉันอีกซักหน่อยนะ",
					"roleType": "TALK_ROLE_NPC",
