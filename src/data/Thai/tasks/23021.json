					"Rafiq"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230210801,
					"content": "เยี่ยมไปเลย สำเร็จ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210802
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210802,
					"content": "โครงสร้างตัวเรือไม่ได้มีปัญหา... แนวน้ำมีความเสถียรมากแล้วก็ไม่มีการพลิกคว่ำ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210803
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210803,
					"content": "Qishan ดูสิ การคำนวณและการออกแบบของฉันมันสมบูรณ์แบบไร้ที่ติเลยนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210804
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210804,
					"content": "นี่เป็นแค่ขั้นตอนแรกของการทดสอบบรรทุกน้ำหนักเท่านั้น อย่ารีบดีใจนักเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210805
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230210805,
					"content": "อีกอย่างนายยังไม่ได้คำนึงถึงสภาพอากาศ และปัญหาตรงจุดรับน้ำหนักตอนที่ขนย้ายของขณะเดินเรือเลยนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210806
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230210806,
					"content": "เอ่อ...เอ่อ... เดี๋ยวฉันจะคิดเองน่า เธอก็ให้ฉันดีใจหน่อยไม่ได้รึไง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210807
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210807,
					"content": "จริงสินักเดินทาง นี่เป็นค่าตอบแทนของเธอนะ ช่วยรับไว้ด้วยเถอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210808
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210808,
					"content": "Qishan เธอจะให้กำลังใจฉันหน่อยไม่ได้เลยรึไง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210809
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210809,
