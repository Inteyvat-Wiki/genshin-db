						],
						"stepId": 7106207,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105802",
							"3"
						],
						"stepId": 7105802,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anton"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710621201,
					"content": "พวกเราจะไปจากที่นี่เร็ว ๆ นี้แล้ว หากเรารบกวนการผจญภัยของเธอ ก็ขอโทษด้วยจริง ๆ นะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621202,
						710621210,
						710621213,
						710621221
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621202,
					"content": "เกี่ยวกับการทำงานร่วมกับกองทหาร Millelith...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621203
					]
				},
				{
					"id": 710621203,
					"content": "เรื่องมันเกิดขึ้นเมื่อนานมาแล้ว ตอนที่นี่เพิ่งจะถูกปิดลง พวกเราได้ติดต่อไปยัง Qixing แห่ง Liyue",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621204
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621204,
					"content": "ในตอนแรกทุกคนยังคุยกันได้อย่างราบรื่น... ท่าน \"Signora\" ยังใช้ประโยชน์จากสถานการณ์และเจรจาข้อตกลงทางการค้าที่เป็นประโยชน์ต่อทั้งสองฝ่ายหลายฉบับ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621205
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621205,
					"content": "และหนึ่งในเงื่อนไขเพิ่มเติมคือ Liyue จะอนุญาตให้ Fatui ส่งทีมสำรวจล่วงหน้าเข้าไปประจำใน Chasm... เรามาที่นี่เพื่อตรวจสอบและกำจัดต้นตอของการเปลี่ยนแปลง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621206
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621206,
					"content": "ข้อมูลทั้งหมดที่ได้จากการตรวจสอบจะถูกใช้ร่วมกันโดย Snezhnaya และ Liyue ตามที่ได้ตกลงไว้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621207
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621207,
					"content": "พวกนายไม่มีเป้าหมายอื่นแล้วเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621208
					]
				},
				{
					"id": 710621208,
					"content": "อย่างน้อยเท่าที่รู้ก็ไม่มี ตอนที่พวกเราออกเดินทาง เราได้รับคำอวยพรจากชาวเมืองมากล้น ทุกคนคิดว่า... เราคือฮีโร่ที่เสียสละตัวเองเพื่อปกป้องผู้อื่น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621209
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621209,
					"content": "เฮ้อ... ใครจะไปรู้ว่าเรื่องราวจะกลายเป็นแบบนี้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621210,
					"content": "เกี่ยวกับ \"ภัยพิบัติแห่งความมืด\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621211
					]
				},
				{
					"id": 710621211,
					"content": "\"ภัยพิบัติที่มืดมน\" หรืออะไรก็ตามแต่ที่เธออยากจะเรียก... ล้วนหมายถึงหายนะครั้งใหญ่ที่เกิดขึ้นเมื่อห้าร้อยปีก่อน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621212
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621212,
					"content": "อย่างไรก็ตาม... มันคือศัตรูชั่วนิรันดร์ของชาว Snezhnaya... เป็นเวลากว่าห้าร้อยปีที่ภัยพิบัติได้ซุ่มซ่อนอยู่ในความมืด และเราต้องคอยระแวดระวังอยู่เสมอ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621213,
					"content": "เกี่ยวกับพวกนาย...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621214
					]
				},
				{
					"id": 710621214,
					"content": "เรื่องของพวกเรา? ไม่มีอะไรให้พูดถึงหรอก... พวกเราพยายามต่อสู้แล้ว แต่ก็ล้มเหลวไม่เป็นท่า ก็แค่นั้น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621215
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621215,
					"content": "ตอนที่ลงมา เราเป็นกองร้อยที่ 9 ซึ่งมีกันทั้งหมด 64 คน แต่ตอนนี้ล่ะ? รวมกับผู้บังคับกองร้อยแล้ว... คนที่เสียชีวิตหรือสูญหายอาจจะมากกว่าครึ่ง หรือก็อาจจะไม่ถึงก็ได้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621216
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621216,
					"content": "แต่จะมากหรือน้อย... พวกเราก็ถูกตีแตกแล้ว และยังขาดการติดต่ออีก... พวกเราแพ้แล้วล่ะ ที่จริงเราควรจะถอยตั้งนานแล้ว...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621217
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621217,
					"content": "แต่คนของนายบนพื้นดินโจมตีท่าเรือ Liyue นะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621218
					]
				},
				{
					"id": 710621218,
					"content": "...ถึงจะน่าตกใจ แต่ฉันก็สามารถเข้าใจได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621219
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621219,
					"content": "เพื่อช่วยให้ความเสี่ยงมีความหมายมากขึ้น ท่าน \"Pulcinella\" จะละทิ้งทรัพย์สินที่มีมูลค่าต่ำกว่า ซึ่งนั่นคือหลักความคิดของเขา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621220
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621220,
					"content": "เราในฐานะผู้ใต้บังคับบัญชาโดยตรงของเขาสามารถยอมรับเรื่องนี้ได้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621221,
					"content": "เกี่ยวกับ Katarina...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621222
					]
				},
				{
					"id": 710621222,
					"content": "เธอเจอเธอคนนั้นแล้วเหรอ? เธอยังมีชีวิตอยู่เหรอ...? ฉันหวังว่าเธอจะให้อภัยพวกเรานะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621223
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621223,
					"content": "Katarina กับน้องชายของเธอ สิบโท Nikolay เติบโตขึ้นมาใน \"บ้านแสนอบอุ่น\"... พวกเขาเป็นเด็ก ๆ ของท่าน Tsarita",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621224
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621224,
					"content": "Katarina บอกว่าจะตามหาน้องชายให้ได้ ฉันคิดว่าเพราะสภาพแวดล้อมด้านล่างทำให้เธอเสียสติไปจนกลายเป็นแบบนี้... น้องชายของเธอไม่มีทางมีชีวิตเหลือรอดหรอก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621225,
						710621230
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621225,
					"content": "พวกนายเลยทิ้งเธอเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621226
					]
				},
				{
					"id": 710621226,
					"content": "ทิ้ง...? ไม่ใช่ ธะ...เธอเต็มใจที่จะอยู่เอง ยังไงซะ ความกังวลที่ไม่จำเป็น... ก็มีแต่จะทำให้ทั้งทีมช้าลง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621227
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621227,
					"content": "ท้ายที่สุดแล้ว...เราทุกคนก็เต็มใจที่จะเสียสละตัวเองเพื่อทุกคน หรือเตรียมพร้อมเสียสละคนสำคัญเพื่อทุกคนอยู่แล้ว... นี่เป็นความตั้งใจในฐานะที่เป็น Fatui",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621228
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621228,
					"content": "Katya ก็คงจะมีความตั้งใจแบบนั้นแน่ ๆ Kolya เองก็เช่นกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621229
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621229,
					"content": "ถ้าพวกเขาทำเรื่องแบบเดียวกันกับฉันละก็ ฉันก็สามารถเข้าใจได้นะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621230,
					"content": "ท่าทางของเธอไม่ได้แย่เหมือนที่นายบอกเลยนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621231
					]
				},
				{
					"id": 710621231,
					"content": "เพราะเธอเป็นคนนอกน่ะ Fatui ไม่สามารถและไม่ควรหลุดอารมณ์ที่แท้จริงต่อหน้าคนทั่วไป",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621232
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621232,
					"content": "แต่สำหรับเธอคนนั้นแล้ว พวกเราเป็นครอบครัวเดียวกัน เธอคนนั้นก็เป็นครอบครัวของเราเหมือนกัน... อย่างน้อยก็เคยเป็น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621233
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621233,
					"content": "เธอเป็นคนยืนยันที่จะตามหา Kolya... หวังว่าเธอจะให้อภัยพวกเรานะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anton"
				}
			]
		},
