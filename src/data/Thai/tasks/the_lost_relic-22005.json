					"Bao'er"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220050101,
					"content": "ที่ไหนกันนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050102
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050102,
					"content": "กำลังทำอะไรอยู่?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220050103
					]
				},
				{
					"id": 220050103,
					"content": "ว๊าก! โผล่มาจากไหนกันเนี่ย? ทำไมไม่ให้สุ้มให้เสียงเลย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050104
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050104,
					"content": "ฉัน? ฉัน... เป็นนักวิชาการ กำลังศึกษาค้นคว้าสิ่งก่อสร้างโบราณและโบราณวัตถุของ Guili Plains อยู่ เรียกฉันว่า Bao'er ละกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050105
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050105,
					"content": "แต่ว่าฉันศึกษาเพลินไปหน่อย ดันทำกล่องที่พกมาหล่นหายไปซะได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050106
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050106,
					"content": "ข้างในนั้นเป็นสม... ของโบราณที่ฉันได้มาอย่างยากลำบาก ช่วยฉันหามันหน่อยได้มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050107,
						220050108,
						220050109
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050107,
					"content": "ฉันรู้แล้ว",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220050110
					]
				},
				{
					"id": 220050110,
					"content": "เยี่ยมไปเลย น่าจะตกอยู่แถวนี้ล่ะนะ... หรือไม่ก็ไกลออกไปอีกหน่อย สรุปก็คือช่วยหาดูอย่างละเอียดทีเถอะนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050108,
					"content": "เป็นกล่องแบบไหนเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220050111
					]
				},
				{
					"id": 220050111,
					"content": "ก็คือ... กล่องพัสดุที่คนทั่ว ๆ ไปเค้าใช้กันนั่นแหละ กล่องสี่เหลี่ยมจัตุรัสที่มีด้านเท่ากันทุกด้าน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050112
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050112,
					"content": "ทำไมถึงใช้มันใส่ของโบราณงั้นเหรอ? เอ่อ เพราะว่า... กล่องอย่างนี้มันสะดวกไงล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050113
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050113,
					"content": "#แล้วก็... ฉันใช้เสื้อผ้ากันไว้หลาย ๆ ชั้นภายในกล่อง ของข้างในไม่มีทางเสียหายแน่นอน ยังไง{F#เธอ}{M#นาย}ช่วยไปหาให้ฉันทีนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050109,
					"content": "เป็นของโบราณแบบไหนเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220050114
					]
				},
				{
					"id": 220050114,
					"content": "#คือ... พูดง่าย ๆ ก็คือของโบราณที่มีความสำคัญมาก ๆ เลยล่ะนะ เห้อ... พูดไป{F#เธอ}{M#นาย}ก็ไม่เข้าใจหรอกนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050115
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050115,
					"content": "มีแต่ผู้เชี่ยวชาญอย่างฉันเท่านั้นแหละที่จะสามารถตีมูลค่าของมันออกมาได้ ขอร้องล่ะนะ รีบไปหาให้ฉันทีเถอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				}
			]
		},
