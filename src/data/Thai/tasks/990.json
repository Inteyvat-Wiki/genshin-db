						9901537
					]
				},
				{
					"id": 9901509,
					"content": "อื้อ ฉันชอบที่นี่มากเลยล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901510
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901510,
					"content": "ทิวทัศน์ที่แตกต่างไปจาก Mondstadt ให้ความรู้สึกที่แปลกใหม่มากเลยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901511
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901511,
					"content": "ตอนที่หัดร้องเพลง ก็สามารถร้องได้อย่างเต็มเสียง ไม่ต้องกังวลว่าจะไปรบกวนใครรึเปล่า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901512
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901512,
					"content": "เสียงเพลงของ Barbara ไม่น่าจะเป็นการรบกวนนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901513
					]
				},
				{
					"id": 9901516,
					"content": "งั้นก็เยี่ยมไปเลย",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901517
					]
				},
				{
					"id": 9901513,
					"content": "เอ่อ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901514
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901514,
					"content": "ขอบคุณมากนะที่พูดแบบนี้ แต่ว่าฉัน... ก็ยังอยากที่จะคิดถึงความรู้สึกของคนอื่นให้มากขึ้นอยู่ดี",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901515
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901515,
					"content": "สรุปก็คือ ฉันดีใจมากเลยล่ะที่เธออุตส่าห์ชวน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901516
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901517,
					"content": "อื้อ ฉันดีใจมากเลยล่ะที่เธอชวน",
