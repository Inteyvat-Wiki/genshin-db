			"dialogs": [
				{
					"id": 10293301,
					"content": "Ushi นายว่ายัย Lavender Melon แคระหลับรึยัง? จะฝันถึงอะไรกันนะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293302
