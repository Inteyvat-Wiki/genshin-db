			"dialogs": [
				{
					"id": 230080101,
					"content": "บางทีอาจจะใกล้สำเร็จแล้วก็ได้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080102
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080102,
					"content": "นักเดินทาง! รอเดี๋ยวสิ นักเดินทาง!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080103,
						230080104
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080103,
					"content": "ทำไมเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230080105
					]
				},
				{
					"id": 230080105,
					"content": "ฉันอยากจะได้ Slime Condensate!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080106
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080106,
					"content": "คืออย่างนี้นะ ฉันได้ทำการทดลองมาตลอดในช่วงไม่กี่วันนี้ โดยนำดินที่เธอนำมาให้ก่อนหน้านี้ มาผสมกันในอัตราส่วนต่าง ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080107
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080107,
					"content": "ถึงแม้ว่าจะล้มเหลวไปตั้งหลายครั้ง... แต่ในที่สุดฉันก็หาส่วนผสมที่เหมาะสมจนได้!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080108
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080108,
					"content": "\"ดินโคลนอัดแน่น\" ที่ผสมจากอัตราส่วนแบบนี้ แม้ว่าก่อนที่จะแข็งตัวจะไม่มีความสามารถในการปรับเปลี่ยนรูปเลย แต่เมื่อแข็งตัวแล้วกลับแข็งแรงและทนทานมาก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080109
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080109,
					"content": "ฉันเดาว่าบางทีอาจเป็นเพราะเติมดินที่ผสมกับ Slime Condensate น้อยไปหน่อย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080110
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080110,
					"content": "นักเดินทาง เธอช่วยนำ Slime Condensate มาให้ฉันทีสิ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080111
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080111,
					"content": "พอได้ Slime Condensate พวกนั้นมา ฉันจะต้องสามารถทำดินที่ต้องการนั่นออกมาได้แน่ ๆ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080104,
					"content": "อยากจะได้อะไรอีกงั้นเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230080105
					]
				}
			]
		},
