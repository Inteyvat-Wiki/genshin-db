				"points": []
			},
			"dialogs": [
				{
					"id": 200580101,
					"content": "อืมม... ทำไงดีนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580102
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580102,
					"content": "ทำไมเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580103
					]
				},
				{
					"id": 200580103,
					"content": "เธอเห็นรูปปั้นเทพแห่งลมนั่นมั้ย? มองขึ้นไปข้างบน ตรงที่สูง ๆ นั่นน่ะ... ที่มือของท่านนั่นน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580104
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580104,
					"content": "ฉันอยากขึ้นไปเล่นบนนั้น... แต่ว่าคุณป้า Grace ต้องไม่ยอมแน่ ๆ เลย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580105
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580105,
					"content": "ช่วยหน่อยนะ ๆ ๆ ช่วยไปทำเป็นพูดกับคุณป้า Grace ทีได้มั้ย อย่าให้เธอมองมาทางนี้ ฉันน่ะปีนเร็วมากเลยนะ แป๊บเดียวก็ขึ้นไปแล้ว...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580106,
						200580108
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580106,
					"content": "โอเค...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580107
					]
				},
				{
					"id": 200580107,
					"content": "งั้นช่วยหน่อยนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580110
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580110,
					"content": "สรุปก็คือ ช่วยไปดึงดูดความสนใจของป้า Grace ทีนะ แล้วฉันจะไปเอง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580111
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580111,
					"content": "Nora! ห้ามไปเด็ดขาด!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580112
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580112,
					"content": "ฟู่วว... เผลอแป๊บเดียว เธอก็มากวนคุณซะแล้ว ขอโทษทีนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580113
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580113,
					"content": "ทำไมล่ะ! แค่ขึ้นไปเล่นเอง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580114
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580114,
					"content": "ไม่ได้ก็คือไม่ได้ พ่อของเธอก็ต้องไม่ยอมแน่นอน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580115
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580115,
					"content": "แล้วก็คุณ อย่าไปตามใจเธอสิ ถ้าคุณทำเรื่องอันตรายอย่างนั้น จะต้องมีคนหนักใจเหมือนกันแน่ ๆ ล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580108,
					"content": "อันตรายเกินไปแล้ว",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580109
					]
				},
				{
					"id": 200580109,
					"content": "ไม่เป็นไร ฉันเก่งมากเลยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580110
					],
					"speakerTitle": "Nora"
				}
			]
		},
