				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Elsie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708280101,
					"content": "อ่า! นักผจญภัยผมบลอนด์ตรงนั้นน่ะ ช่วยรอเดี๋ยว!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280103,
						708280104
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280103,
					"content": "อยากให้ช่วยอะไรมั้ย?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280102
					]
				},
				{
					"id": 708280102,
					"content": "ไม่ใช่ ไม่ใช่ แค่อยากถามว่าเธอมีหนังสือชุดบทกวีเกี่ยวกับความรักบ้างมั้ย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280107
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280107,
					"content": "คืองี้ ฉันเป็นกวีพเนจรที่เก่งมาก ๆ อาจเป็นกวีพเนจรที่เก่งที่สุดในประวัติศาสตร์ของ Mondstadt รองจากท่าน Barbatos เท่านั้น... สรุปก็คือเก่งมาก ๆ นั่นแหละ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280108
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280108,
					"content": "แต่กวีพเนจรคนนึงที่ชื่อ Linus ดูเหมือนจะไม่เคยยอมรับความสามารถของฉันเลย คอยแต่จะมาท่องบทกวีให้ฉันฟังทุกวัน! มันก็เป็นการจงใจยั่วยุฉันชัด ๆ เลยว่ามั้ยล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280109
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280109,
					"content": "ที่น่าโมโหกว่าคือ เขาเอาแต่ท่องแต่บทกวีเรื่องความรักเอย คู่รักเอย... ซึ่งเป็นหัวข้อที่ฉันไม่เคยเขียนทั้งนั้นเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280110
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280110,
					"content": "ฉันเลยตัดสินใจเริ่มเขียนบทกวีรักสุดยิ่งใหญ่ที่จะสะเทือนไปทั่ว Mondstadt ขึ้นด้วยตัวเอง ให้เขาได้รู้จักกับสิ่งที่เรียกว่าพรสวรรค์ที่แท้จริงซะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280111
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280111,
					"content": "แต่ว่า... ฉันทุ่มเทเวลาให้กับศิลปะอันยิ่งใหญ่หมดแล้ว ตอนนี้ยังไม่มีเวลาไปสัมผัสความรักหรอก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280112
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280112,
					"content": "งั้นถ้ามีชุดบทกวีเกี่ยวกับความรักอะไรก็ช่างเถอะ ขายให้ฉันนะ! แค่ให้ฉันเปิดดูสักนิดสักหน่อย ด้วยพรสวรรค์ของฉันแล้ว รับรองว่าจะมีแรงบันดาลใจทันทีเลย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280104,
					"content": "คงช่วยไม่ได้ ฉันมีธุระต้องไปก่อน ขอตัวนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280105
					]
				},
				{
					"id": 708280105,
					"content": "ไม่ได้จะขอให้ช่วยหรอก! อีกอย่างนะ ถ้าทุกคนเจอเรื่องยุ่งแล้วเอาแต่เที่ยวตามคนแปลกหน้าข้างทางมาแก้ปัญหาให้แบบนี้ ป่านนี้คงไม่มีใครกล้าออกมาเดินข้างนอกกันแล้วละมั้ง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280106
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280106,
					"content": "เอ่อ ฉันแค่อยากถามว่าเธอมีชุดบทกวีเกี่ยวกับความรักรึเปล่า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280107
					],
					"speakerTitle": "Elsie"
				}
			]
		},
		{
