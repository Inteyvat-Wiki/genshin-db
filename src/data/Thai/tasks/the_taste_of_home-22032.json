			"dialogs": [
				{
					"id": 220320401,
					"content": "อ่า รสชาตินี้... มะ... เหมือนไม่ใช่อาหารของ Liyue แล้วก็ไม่ใช่อาหารของ Inazuma รสชาติแปลกใหม่มาก...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320402
					],
