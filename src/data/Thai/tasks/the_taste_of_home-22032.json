					"Tang Wen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220320301,
					"content": "อ๊ะ! ใช่แล้วล่ะ! นะ... นี่ก็คือรสชาติบ้านเกิดที่ฉันต้องการ...ช่าง...ฮือ ๆ ...ซึ้งใจมากจริง ๆ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320302
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320302,
					"content": "ขอบใจนะ! มีของกินอร่อยแบบนี้ ฉันก็มีแรงขึ้นมาแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320303
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320303,
					"content": "ของพวกนี้มอบให้เธอนะ ขอให้การเดินทางของเธอราบรื่น!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tang Wen"
				}
			]
		},
		{
