			},
			"dialogs": [
				{
					"id": 746750101,
					"content": "อากาศดีมากเลยนะ ว่ามั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750102
					],
					"speakerTitle": "Petit Lumiere"
				},
				{
					"id": 746750102,
					"content": "คนดังระดับพวกคุณ คงมีแต่คนยื่นนามบัตรให้ไม่หยุดเลยสินะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750103
					],
					"speakerTitle": "Petit Lumiere"
				},
				{
					"id": 746750103,
					"content": "#เอ่อ... เธอรู้จักเราเหรอ? {NICKNAME} เด็กคนนี้ดูเป็นผู้ใหญ่จังเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746750104,
					"content": "ถ้าจะดูถูกคนอื่นเพียงเพราะเขายังเป็นเด็ก มันเป็นความผิดพลาดที่คนโง่เขาทำกัน ฉันคิดว่าคุณสองคนคงไม่คิดตื้น ๆ แบบนั้น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750105
					],
					"speakerTitle": "Petit Lumiere"
				},
				{
					"id": 746750105,
					"content": "ถึงจะไม่ได้ตั้งใจชมตัวเองก็เถอะ แต่ฉันกับพี่ชายก็เป็นถึงผู้กำกับหนังที่โด่งดังของที่นี่ ทุกคนเรียกฉันว่าคุณ Petit Lumiere เลยด้วยซ้ำ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750106,
						746750107
					],
					"speakerTitle": "Petit Lumiere"
				},
				{
					"id": 746750106,
					"content": "สวัสดี",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746750108
					]
				},
				{
					"id": 746750108,
					"content": "ใช่แล้ว ฉันสนใจเรื่องราวการผจญภัยของพวกคุณมาก ในวงการของเรา เรื่องราวที่ไม่ธรรมดาจะได้รับความสนใจเสมอ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750109
					],
					"speakerTitle": "Petit Lumiere"
				},
				{
					"id": 746750109,
					"content": "ในเมื่อพวกคุณยังไม่รู้จักฉัน งั้นให้ฉันแนะนำตัวเองก่อนก็แล้วกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750110
					],
					"speakerTitle": "Petit Lumiere"
				},
				{
					"id": 746750110,
					"content": "ฉันกับพี่ชายถ่ายทำภาพยนตร์ด้วยกันมานานแล้ว สร้างภาพยนตร์ดังมาแล้วหลายเรื่องด้วย บางทีพวกคุณอาจเคยดูเรื่อง \"Employees Leaving the Factory\"...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750111
					],
					"speakerTitle": "Petit Lumiere"
				},
				{
					"id": 746750111,
					"content": "ไม่อะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746750112
					]
				},
				{
					"id": 746750112,
					"content": "อ้อ ไม่เป็นไร งั้น \"The Arrival of an Aquabus\" ล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750113
					],
					"speakerTitle": "Petit Lumiere"
				},
				{
					"id": 746750113,
					"content": "ไม่เคยเหมือนกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746750114,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750115
					],
					"speakerTitle": "Petit Lumiere"
				},
				{
					"id": 746750115,
					"content": "อ่อ แบบนี้นี่เอง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750116
					],
					"speakerTitle": "Petit Lumiere"
				},
				{
					"id": 746750116,
					"content": "...มันก็ไม่แปลก เส้นทางของคนทำภาพยนตร์อย่างเราสองพี่น้องยังอีกยาวไกล ต่อไปจะต้องทำภาพยนตร์ที่รู้จักกันทั่วบ้านทั่วเมืองออกมาให้ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750117
					],
					"speakerTitle": "Petit Lumiere"
				},
				{
					"id": 746750117,
					"content": "การสร้างภาพยนตร์ ตั้งแต่การวางเค้าโครงของเรื่องราว การแสดงของนักแสดง การทำงานร่วมกันระหว่างช่างภาพกับผู้กำกับ ไปจนถึงการตัดต่อ ทั้งหมดต่างก็เป็นขั้นตอนที่น่าสนใจมาก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750118
					],
					"speakerTitle": "Petit Lumiere"
				},
				{
					"id": 746750118,
					"content": "ในบรรดาทั้งหมด ฉันคิดว่าขั้นตอนการถ่ายทำเป็นส่วนที่ต้องใช้เทคนิคมากที่สุด",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750119
					],
					"speakerTitle": "Petit Lumiere"
				},
				{
					"id": 746750119,
					"content": "สิ่งที่โฟกัสในการถ่ายทำจะเป็นตัวกำหนดว่าผู้ชมจะได้รับข้อมูลแบบไหน และสัมผัสได้ถึงบรรยากาศแบบไหน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750120
					],
					"speakerTitle": "Petit Lumiere"
				},
				{
					"id": 746750120,
					"content": "ถึงแม้คำบรรยายจะสำคัญเหมือนกัน แต่เราจะหวังพึ่งแค่คำบรรยายเพื่อสร้างเรื่องราวไม่ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750121
					],
					"speakerTitle": "Petit Lumiere"
				},
				{
					"id": 746750121,
					"content": "สี่ฉาก! ฉันเชื่อมาตลอดว่าแค่สี่ฉากก็จะสามารถประกอบเป็นหน่วยเรื่องราวที่เล็กที่สุดได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750122
					],
					"speakerTitle": "Petit Lumiere"
				},
				{
					"id": 746750122,
					"content": "อัจฉริยะจะต้องสร้างสิ่งมหัศจรรย์จากในสี่ฉากนี้ได้แน่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750123
					],
					"speakerTitle": "Petit Lumiere"
				},
				{
					"id": 746750123,
					"content": "คุณสองคนอยากลองดูมั้ย? ใช้โอกาสนี้มาสัมผัสเสน่ห์ของภาพยนตร์กันเถอะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750124
					],
					"speakerTitle": "Petit Lumiere"
				},
				{
					"id": 746750124,
					"content": "แล้วจะให้เราทำอะไรล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746750125,
					"content": "ง่ายมาก ฉันจัดเตรียมโครงเรื่องสั้น ๆ ไว้ให้พวกคุณใช้เป็นธีมสำหรับถ่ายทำได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750126
					],
					"speakerTitle": "Petit Lumiere"
				},
				{
					"id": 746750126,
					"content": "สิ่งสำคัญคือการลองใช้วิธีจัดการกล้องและคำบรรยายที่หลากหลาย เพื่อให้ถ่ายทำภาพยนตร์สั้นได้หลายเรื่อง พวกคุณสองคนสนใจมั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750127
					],
					"speakerTitle": "Petit Lumiere"
				},
				{
					"id": 746750127,
					"content": "ฟังดูน่าสนใจดีนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746750128
					]
				},
				{
					"id": 746750128,
					"content": "เยี่ยมเลย! ถ้างั้นพอคุณสองคนพร้อมแล้ว ก็ไปยังสถานที่ถ่ายทำที่ฉันเลือกไว้นะ พร้อมให้พวกคุณลองถ่ายทำได้ตลอดเวลาเลย แล้วฉันก็จะให้ฟีดแบ็กหนังที่ถ่ายทำเสร็จแล้วให้ด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Petit Lumiere"
				},
				{
					"id": 746750107,
					"content": "เธอเองก็อยากมอบนามบัตรให้เราเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746750108
					]
				}
			]
		}
	]
}