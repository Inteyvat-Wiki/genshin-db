			"dialogs": [
				{
					"id": 1903203101,
					"content": "ฮือ... ฮือฮือ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203102
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203102,
					"content": "#{F#พี่สาว}{M#พี่ชาย}ช่วย Qianqian หน่อยได้มั้ย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203103,
						1903203104
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203103,
					"content": "จะให้ฉันช่วยอะไรเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203105
					]
				},
				{
					"id": 1903203105,
					"content": "นักปราบปีศาจผมสีฟ้าคนนั้น น่ากลัวสุด ๆ เลย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203106
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203106,
					"content": "Qianqian กลัวมากเลย ช่วยพาเขาไปจากที่นี่หน่อยได้มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203107,
						1903203108
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203107,
					"content": "เธอรู้สึกได้ถึงร่างกายแห่งหยางบริสุทธิ์ของเขาเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203109
					]
				},
				{
					"id": 1903203109,
					"content": "Qianqian ไม่กล้าไปใกล้เขา พลังที่ออกมาจากร่างเขามันน่ากลัวมากเลย มันจะทำให้หนูสลายไป!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203110
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203110,
					"content": "Qianqian ไม่อยากสลายร่างไป เพราะงั้น ขอร้องล่ะพี่...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203111,
						1903203112
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203111,
					"content": "ไม่รู้ว่าเขาจะมองว่าเธอเป็นวิญญาณร้ายรึเปล่านะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203113
					]
				},
				{
					"id": 1903203113,
					"content": "งั้นเอาแบบนี้มั้ย Qianqian มีความคิดนึง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203114
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203114,
					"content": "เมื่อกี้ Qianqian เห็นนักปราบปีศาจผมสีฟ้าทะเลาะกับคนอื่นอยู่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203115
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203115,
					"content": "ถ้า Qianqian หลอกคนที่สร้างความวุ่นวายจนเผ่นหนีไป พี่ช่วยบอกให้เขาปล่อย Qianqian ไปได้มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203116,
						1903203118
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203116,
					"content": "เธอพูดจริงเหรอเนี่ย?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203117
					]
				},
				{
					"id": 1903203117,
					"content": "พูดจริงสิ Qianqian ไม่เคยโกหกนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203120
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203120,
					"content": "เป็นไงล่ะ แบบนี้ดีมั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203121
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203121,
					"content": "ฉันตัดสินใจแทนเขาไม่ได้ แต่ฉันช่วยอธิบายได้",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203122
					]
				},
				{
					"id": 1903203122,
					"content": "ก็ได้ งั้น Qianqian ถือว่าพี่รับปากแล้วนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203123
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203123,
					"content": "หวังว่านักปราบปีศาจผมสีฟ้าคนนั้นจะเป็นคนดี",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203124
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203124,
					"content": "Qianqian จะไปช่วยเขา พี่ก็ต้องไปช่วยเขาด้วย แล้วก็... ค่อยมาช่วย Qianqian อีกที",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203118,
					"content": "เรื่องแค่นี้ฉันก็ช่วยเขาได้",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203119
					]
				},
				{
					"id": 1903203119,
					"content": "ก็จริง แต่มันยุ่งยากนะ Qianqian มีวิธีแล้ว เชื่อ Qianqian เถอะนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203120
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203112,
					"content": "ฉันก็ตัดสินแทนเขาไม่ได้ซะด้วย",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203113
					]
				},
				{
					"id": 1903203108,
					"content": "มิน่าวันนี้ถึงไม่มีใครเห็นเธอ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203109
					]
				},
				{
					"id": 1903203104,
					"content": "ทำไมต้องเป็นฉันล่ะ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203105
					]
				}
			]
		}
	]
