				"points": []
			},
			"dialogs": [
				{
					"id": 721110201,
					"content": "ถุงที่ใส่ Mora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110202
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110202,
					"content": "นี่มัน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110203
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110203,
					"content": "... นี่มันเป็นของบ้านพวกเราเอง ไม่เห็นมีอะไรน่าสงสัยเลย ใช่แล้ว ปกติสุด ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110204
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110204,
					"content": "สุดจะน่าสงสัยเลยอ่ะ! ต้องมีซัมติงแน่!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110205,
						721110206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110205,
					"content": "ขอให้คุณลองวาดสัญลักษณ์ที่อยู่บนนั้น",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110210
					]
				},
				{
					"id": 721110210,
					"content": "......",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110211
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110211,
					"content": "ก็ได้ นี่ไม่ใช่กระเป๋าเงินของฉันจริง ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110212
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110212,
					"content": "ที่ลานหลังบ้านของฉันมีคนวนเวียนมาบ่อย ๆ ถ้าจะมีของอะไรตกหล่นบ้างก็เป็นเรื่องปกตินี่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110213
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110213,
					"content": "นี่คือ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110214
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110214,
					"content": "นี่มันเรื่องอะไรกัน?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110215
					]
				},
				{
					"id": 721110215,
					"content": "เฮอะ! ถือว่าพวกเธอฉลาดมาก ฉันก็แค่ผีละโมบเข้าสิง อยากจะฮุบกระเป๋าเงินในมือของพวกเธอ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110216
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110216,
					"content": "ฉันแก่จนจะลงโลงแล้ว แต่ก็ยังจะคิดอะไรแบบนี้อีก!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110217,
						721110218
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110217,
					"content": "ไม่สิ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110219
					]
				},
				{
					"id": 721110219,
					"content": "ฉะ ฉันยอมรับแล้วไงว่าอยากจะฮุบเงินนั่น ยังจะมีปัญหาอะไรอีก?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110220
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110220,
					"content": "ฉันจะเอากระเป๋าเงินนี่ส่งให้กับทางการเดี๋ยวนี้แหละ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110221
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110221,
					"content": "รู้สึกมีอะไรไม่ถูกต้อง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110222,
						721110223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110222,
					"content": "กระเป๋าเงินนี้ถูกคนจงใจทิ้งไว้",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110227
					]
				},
				{
					"id": 721110227,
					"content": "ธะ... เธอพูดแบบนี้ มีหลักฐานอะไรไหม?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110228
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110228,
					"content": "กระเป๋าเงินเป็นแค่ส่วนหนึ่งเท่านั้นแหละ นอกจากนี้พวกเรายังพบ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110229,
					"content": "#...เจออะไรอีกบ้างนะ? อืมมม ฝากด้วยนะ {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110230,
					"content": "#({NICKNAME} ก่อนหน้านี้พวกเราเจออะไรที่คูน้ำนะ...?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110231,
					"content": "นี่คือของที่ถูกจงใจทิ้งไว้ในวันที่ฝนตก...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 721110223,
					"content": "ไม่มีอะไร Paimon คงคิดมากไปเอง",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110224
					]
				},
				{
					"id": 721110224,
					"content": "#(ไม่มั้ง! {NICKNAME} คุณปู่ Densuke จะต้องการแค่ Mora พวกนี้จริง ๆ เหรอ?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110225,
					"content": "(เขาต้องกำลังปิดบังเรื่องอื่นอยู่แน่ ๆ เลยเนอะ?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110226,
					"content": "กระเป๋าเงินนี้ถูกคนจงใจทิ้งไว้",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110227
					]
				},
				{
					"id": 721110218,
					"content": "คุณกำลังปกปิดอะไรบางอย่าง...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110219
					]
				},
				{
					"id": 721110206,
					"content": "ในนี้มี Mora เท่าไหร่ ไหนลองพูดมาสิ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110207
					]
				},
				{
					"id": 721110207,
					"content": "ฮ่าฮ่าฮ่า นี่มันปัญหาอะไรของเธอ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110208
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110208,
					"content": "ถ้าไม่เปิดกระเป๋าเช็ก เธอเองก็ไม่รู้หรอกว่าในกระเป๋ามี Mora อยู่เท่าไหร่จริงมั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110209
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110209,
					"content": "ขอให้คุณลองวาดสัญลักษณ์ที่อยู่บนนั้น",
					"roleType": "TALK_ROLE_PLAYER",
