						721110309
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110309,
					"content": "บน Mora หรือว่ายังมีรหัสลับอะไรอีก?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110310
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110310,
					"content": "บน Mora ไม่มี แต่ว่าที่อื่นมี",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110311,
					"content": "นั่นก็คือสิ่งที่พวกเราพบ ที่บริเวณใกล้ซากเกวียนพัง",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 721110304,
					"content": "ถูกพบบนยอดต้นไม้ที่ปากทางหมู่บ้าน",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110305
					]
				},
				{
