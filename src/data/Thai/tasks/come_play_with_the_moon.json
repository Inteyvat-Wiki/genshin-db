				},
				{
					"id": 761220214,
					"content": "ไม่เป็นไร ฉันก็ดีใจที่ได้เจอ Luonnotar อีกครั้ง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220216
					],
					"speakerTitle": "Damselette"
				},
				{
