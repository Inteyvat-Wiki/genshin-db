				"points": []
			},
			"dialogs": [
				{
					"id": 730500201,
					"content": "#Nara {NICKNAME} กับ Paimon! พวกเจ้าวายร้ายที่อยากทำให้ Vanarana \"ป่วย\" ไม่หวนกลับมาอีกแล้วล่ะ ตอนนี้วางใจได้แล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500202
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730500202,
					"content": "#ขอบคุณความช่วยเหลือของ Nara {NICKNAME} กับ Paimon จนทำให้ Ararycan ปกป้อง Vanarana ไว้ได้... เพราะงั้น Ararycan จึงขอมอบดอกไม้ให้กับ Nara {NICKNAME} และ Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500203
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730500203,
					"content": "โปรดรับดอกไม้ไว้ด้วยนะ เพื่อนที่แสนดีของ Ararycan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ararycan"
				}
			]
		},
