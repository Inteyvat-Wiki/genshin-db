					"nextDialogs": [
						732670519
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670519,
					"content": "คุณไม่เป็นไรใช่มั้ย?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670520
					]
				},
