				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220390101,
					"content": "ธุรกิจเป็นแบบนี้คงทำได้อีกไม่นานหรอก...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390102
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390102,
					"content": "เป็นอะไรเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220390103
					]
				},
				{
					"id": 220390103,
					"content": "ขอโทษด้วย พอดีคิดเรื่องอื่นอยู่เลยใจลอยไปหน่อย เธอจะสั่งตัดชุดเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390104
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390104,
					"content": "แม้ว่าผ้าไหมอย่างดีของ Liyue จะขาดตลาดอยู่... แต่เรายังมีผ้าแบบใหม่ล่าสุดอยู่นะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390105
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390105,
					"content": "เมื่อก่อนเธอนำเข้าผ้าจาก Liyue เหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220390106
					]
				},
				{
					"id": 220390106,
					"content": "ใช่ เมื่อก่อนพวกเรามักจะนำเข้าสินค้าจากร้านผ้าไหมชั้นนำของ Liyue เช่น \"สมาคมการค้า Feiyun\" ที่ใช้ผ้าไหมที่ทำจาก Silk Flower...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390107
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390107,
					"content": "แต่ว่า เพราะสถานการณ์ Inazuma ในตอนนี้... ทำให้ที่ร้านไม่ได้นำเข้าผ้าไหมมาช่วงหนึ่งแล้ว ตอนนี้ได้แต่อาศัยสต็อกสินค้าที่มีอยู่ก่อนหน้านี้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390108
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390108,
					"content": "ผ้าไหมที่ร้านตอนนี้ พูดได้เลยว่าใช้เท่าไหนก็น้อยลงเท่านั้น...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390109
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390109,
					"content": "อันที่จริงฉันก็อยากออกแบบลวดลายใหม่ ๆ หรือใช้สีย้อมผ้าใหม่ ๆ มาทำกิโมโนรูปแบบใหม่เพื่อดึงดูดลูกค้า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390110
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390110,
					"content": "แต่ว่า ฉันยังไม่เจอสีย้อมผ้าที่เรียกได้ว่าเป็นการย้อมผ้า \"แบบสร้างสรรค์\" เลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390111
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390111,
					"content": "นักเดินทาง เธอเดินทางไปทั่ว คงจะพบเห็นอะไรมากมาย... เธอเคยเห็นการย้อมผ้า \"แบบสร้างสรรค์\" บ้างไหม?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390112,
						220390116
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390112,
					"content": "ฉันเห็นมาเยอะมาก",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220390113
					]
				},
				{
					"id": 220390113,
					"content": "จะ...จริงเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390114
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390114,
					"content": "ถ้าไม่รังเกียจล่ะก็ เธอช่วยชี้แนะฉันทีเถอะ ช่วยหาวัสดุการย้อมผ้าที่สามารถทำให้สีใหม่ให้ฉันทีได้ไหม?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390115
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390115,
					"content": "ฉันจะเตรียมค่าตอบแทนให้ รบกวนเธอด้วยนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390116,
					"content": "อยากได้แค่วัสดุย้อมผ้าเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220390117
					]
				},
				{
					"id": 220390117,
					"content": "สถานการณ์ตอนนี้ ฉันคงทำได้แค่คิดหาวิธีย้อมผ้าใหม่ ๆ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390118
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390118,
					"content": "ถ้าหากเธอรู้จักวัตถุดิบอะไรที่สามารถนำมาใช้ย้อมผ้า \"แบบสร้างสรรค์\" ก็เอามาให้ฉันด้วยนะ ฉันจะเตรียมค่าตอบแทนให้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ogura Mio"
				}
			]
		},
