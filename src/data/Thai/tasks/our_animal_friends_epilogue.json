					"Zhenchen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716690101,
					"content": "#{NICKNAME} ได้ยินเจ้าหน้าที่บอกว่า คุณเจอสิ่งมีชีวิตตัวน้อย ที่ติดอุปกรณ์ส่งสัญญาณทั้งหมดแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690102
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690102,
					"content": "เหลือเชื่อจริง ๆ สัตว์บางตัวมีประสาทสัมผัสไวอยู่แล้ว พอมีสิ่งมีชีวิตแปลกหน้าเข้ามาใกล้ พวกมันก็จะหนีทันที",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690103
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690103,
					"content": "แต่พวกมันกลับยอมให้คุณเข้าใกล้แต่โดยดี น่าแปลกจริง ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690104,
						716690105
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690104,
					"content": "ก็เพราะฉันเป็นเพื่อนของนานาสัตว์ไงล่ะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716690106
					]
				},
				{
					"id": 716690106,
					"content": "ฮ่าฮ่า ความสามารถของคุณน่าอิจฉามากจริง ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690107
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690107,
					"content": "ก่อนหน้านี้ หลายครั้งเวลาที่เจ้าหน้าที่ไปให้อาหารสัตว์กับฉัน ถ้าฉันไม่ถูกไล่ก็จะถูกกัดตลอดเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690112
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690112,
					"content": "แขนฉันมีรอยแผลเต็มไปหมดเลย แถมยังเจ็บมากด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690113
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690113,
					"content": "ถึงพวกมันจะไม่สนิทกับฉันเลย แต่การได้เห็นสิ่งมีชีวิตน่ารักพวกนี้มีชีวิตที่ดี ฉันก็พอใจแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690114
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690114,
					"content": "สำหรับผู้รับเลี้ยงคนอื่น ๆ ก็คงจะเป็นอย่างนี้เหมือนกัน ทุกคนต่างก็อยากจะ ปกป้องสภาพแวดล้อมความเป็นอยู่ของพวกมัน โดยที่ไม่ได้รบกวนชีวิตของมัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690115
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690115,
					"content": "ฉันรู้ว่าสำหรับนักผจญภัยหลาย ๆ คนแล้ว สัตว์ป่าถือเป็นแหล่งอาหารที่สำคัญ และพวกเราเองก็ไม่ได้ขอให้สมาชิก \"เพื่อนรู้คู่หูกรงเล็บ\" เลิกล่าสัตว์ด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690116
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690116,
					"content": "หลักการที่เราสนับสนุนก็คือ ไม่ล่าและห้ามจับตามอำเภอใจโดยเด็ดขาด หากทุกคนสามารถทำได้ตามนี้ สภาพแวดล้อมโดยรอบของเรา จะต้องสมบูรณ์ และสวยงามมากขึ้นอย่างแน่นอน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690117
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690117,
					"content": "#ในฐานะสมาชิกของเรา ถ้า {NICKNAME} เห็นด้วยและยอมรับกับหลักการนี้ ก็คงจะดีมาก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690118,
						716690120
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690118,
					"content": "ฉันเห็นด้วย",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716690119
					]
				},
				{
					"id": 716690119,
					"content": "ฉันรู้อยู่แล้วว่าคนที่มีเหตุมีผลอย่างคุณ จะต้องเห็นด้วยกับพวกเราแน่ ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690122
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690122,
					"content": "แค่สามารถทำให้ทุกคนเก็บไปคิดได้ ก็ถือว่าประสบความสำเร็จแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690123
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690123,
					"content": "ถ้ามีโอกาส ฉันหวังว่าจะเจอคุณในกิจกรรมครั้งต่อไปของ \"เพื่อนรู้คู่หูกรงเล็บ\" อีกนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690124
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690124,
					"content": "หวังว่าพอถึงตอนนั้น แขนของฉันจะไม่มีรอยแผลเพิ่มขึ้นอีกนะ ฮ่าฮ่า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690120,
					"content": "ฉันขอไม่ออกความเห็น",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716690121
					]
				},
				{
					"id": 716690121,
					"content": "ไม่เป็นไร เราไม่ได้บังคับให้ทุกคนยอมรับหรอก แต่ฉันแค่อยากให้ทุกคนคิดถี่ถ้วนให้ดีก่อนที่จะฆ่าสิ่งมีชีวิต",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690122
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690105,
					"content": "นี่คือพรสวรรค์ของนักผจญภัยน่ะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716690106
					]
				}
			]
		},
