				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751650401,
					"content": "นักรบที่เดินผ่านมา ใช่ ใช่แล้ว เธอนั่นแหละ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650402
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650402,
					"content": "เฮ้อ ผอมเกินไปแล้ว... เธอได้กินข้าวให้เต็มที่มั้ยเนี่ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650406,
						751650404
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650406,
					"content": "อาหารถูกผู้นำทาง Paimon กินไปแล้ว",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650403
					]
				},
				{
					"id": 751650403,
					"content": "ไม่ว่าเธอจะมีเหตุผลหรือลำบากใจอะไร อย่างแรกคือข้าวต้องกินข้าวให้เต็มที่!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650408
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650408,
					"content": "ในเมื่อเธอเข้ามาใน Teteocan แล้ว น่าจะเคยเห็นนักรบผู้แข็งแกร่งของ \"ผองสรรพสิ่ง\" แล้วสินะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650409
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650409,
					"content": "ด้วยความหวังดีนะ ฉันขอเตือนเธอเลยว่า อย่าไปเชื่อพวกที่เอาแต่เชิดชูกล้ามเนื้อเด็ดขาด",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650410
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650410,
					"content": "ไขมันที่เทพเจ้าประทานให้เรา เป็นของขวัญที่ล้ำค่า เพื่อให้มีกล้ามเนื้อที่สวยงาม ต้องตัดขาดของอร่อย ๆ ทั้งหมด และละทิ้งไขมัน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650411
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650411,
					"content": "ทำแบบนั้นก็โง่เกินไปแล้ว หมูป่ายังต้องเห็นใจเธอ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650412
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650412,
					"content": "แล้วถ้าจะพูดว่าดูดี การยกยอกล้ามเนื้อ เหมือนจะเป็นเรื่องเมื่อไม่กี่สิบปีนี้เอง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650413
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650413,
					"content": "คุณปู่ของฉันบอกว่า ตอนที่เขายังหนุ่ม ทุกคนค่อนข้างจะชอบหุ่นที่ท้วม",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650414
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650414,
					"content": "ดังนั้น อย่าไปฟังคนอื่นล่อลวง แล้วเดินบนเส้นทางลดน้ำหนักที่ผิดพลาด!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650415
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650415,
					"content": "แต่ถ้าวันหนึ่ง เธอเหมือนกับพวกญาติ ๆ ของฉันใน \"ผองสรรพสิ่ง\" เลือกจะลดน้ำหนัก เพื่อแสวงหาความแข็งแกร่ง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650416
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650416,
					"content": "งั้นฉันยังมีอีกประโยคหนึ่ง: เรื่องความคล่องแคล่ว นักรบที่มีรูปร่างท้วมก็สามารถพลิ้วไหวได้เหมือนปลา ส่วนเรื่องความแข็งแกร่ง พวกผอมแห้งนั่นไม่ใช่คู่ต่อสู้ของพวกเรา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650417
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650417,
					"content": "ถ้าจะถามหลักฐานล่ะก็ เจ้าพวกโถที่อยู่ในสนามฝึกซ้อมนี้ก็คือหลักฐาน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650418
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650418,
					"content": "ด้วยรูปร่างของฉัน ถ้าจะให้<color=#00E1FFFF>ผ่านไปอย่างว่องไว โดยที่ไม่ทำให้โถแตก</color>น่ะง่ายจะตาย ความคล่องแคล่วระดับนี้ ต่อให้เป็นคนผอมก็คงจะทำไม่ได้หรอกมั้ง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650419
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650419,
					"content": "ดูจากสีหน้าที่เธออยากหัวเราะ แต่ก็ไม่กล้าหัวเราะแล้ว ไม่เป็นไร ๆ ฉันรู้ว่าเธอไม่เชื่อ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650420
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650420,
					"content": "มาลองดูสิ ผ่านสนามฝึกนี้ด้วยความเร็วสูงสุดของเธอ แต่ระวัง<color=#00E1FFFF>อย่าทำให้โถแตกแม้แต่ใบเดียวล่ะ</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650421
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650421,
					"content": "มาดูกันว่าคะแนนของเธอจะดีแค่ไหน จะแซงฉันได้มั้ย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650404,
					"content": "ว้าว จะเลี้ยงข้าวเรางั้นเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650407
					]
				},
				{
					"id": 751650407,
					"content": "ไม่ได้หมายความว่าอย่างนั้น... ถ้าเธอหิวจริง ๆ ล่ะก็ ในกระเป๋าที่ฉันพกติดตัวยังมีเนื้อย่างอยู่นิดหน่อย แต่เรื่องนี้เอาไว้ก่อนเถอะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650408
					],
					"speakerTitle": "Illimani"
				}
			]
		},
