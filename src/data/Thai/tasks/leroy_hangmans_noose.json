			"dialogs": [
				{
					"id": 741540201,
					"content": "แปลก แปลกมาก ขนาดฉันยังว่าแปลกเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540202,
					"content": "#{NICKNAME} เธอฉลาด ช่วยคิดหน่อยว่าควรทำยังไงต่อ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540203,
						741540204,
						741540205,
						741540206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540203,
					"content": "Benoit อยากขอความช่วยเหลือ แต่กลับบอกว่าไม่ต้องช่วยเขา...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540207
					]
				},
				{
					"id": 741540207,
					"content": "งั้นเราไปดูแถวบ้าน Benoit กันมั้ย? ตรงหน้าต่างหลังบ้านเขามีกล่องประหลาดอยู่หนึ่งใบไม่ใช่เหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540208,
					"content": "ต้องมีอะไรซ่อนอยู่ในนั้นแน่ มันอาจจะยืนยันข้อสันนิษฐานของเธอได้นะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540204,
					"content": "สามีภรรยาคู่นี้อาจจะมาจาก Fleuve Cendre...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540207
					]
				},
				{
					"id": 741540205,
					"content": "ดูจากปฏิกิริยาของพวกเขาแล้ว น่าจะมีอะไรแอบแฝง...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540207
					]
				},
				{
					"id": 741540206,
					"content": "ฉันมีข้อสันนิษฐานบางอย่าง ถึงแม้จะไม่มีหลักฐานก็เถอะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540207
					]
				}
			]
		},
