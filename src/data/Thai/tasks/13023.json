				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaveh",
					"Alhaitham"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130230101,
					"content": "Siraj ชื่อนี้ฉันจำไม่ได้ด้วยซ้ำ มีคนแบบนี้ในรุ่นของพวกนายด้วยเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230102
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 130230102,
					"content": "ไม่ใช่คนน่าประทับใจอะไร เป็นเรื่องปกติที่จะจำไม่ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230103
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130230103,
					"content": "สถาบันชอบสวมหมวกที่เรียกว่าอัจฉริยะกับพรสวรรค์ เพื่อเพิ่มความกดดันให้กับผู้คน ฉันไม่เคยชื่นชมในจุดนี้เลยสักนิด",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230104
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 130230104,
					"content": "แต่ถ้าเป็นแบบนี้ สถาบันก็คงไม่สามารถมอบหมายหน้าที่ผู้นำให้นายได้แล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230105
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 130230105,
					"content": "น่าจะพูดว่า ฉันดีใจที่นายยังรู้จักตัวเองดีอ่ะนะ ถ้าคนในสถาบันไม่ได้เป็นบ้าไปแล้ว ก็ควรจะรู้ว่าให้ฉันขึ้นเป็นนักปราชญ์ยังจะดีกว่าปล่อยให้นายเป็น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230106
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 130230106,
					"content": "แล้วให้พวกเขาได้รับรู้ว่า ชีวิตนักปราชญ์ของนายมันพังทลายเหมือนภาพวาด ที่แขวนจะตกมิตกแหล่อยู่นั่นน่ะเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230107
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130230107,
					"content": "เจ้าคนที่กำลังจะตกงานเพราะลาออกนี่พูดอะไรกันนะ? อีกไม่กี่วันก็ต้องไปจัดการเอกสารอีก แล้วหลังจากนั้นชีวิตก็จะมุ่งสู่จุดตกต่ำ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230108
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 130230108,
					"content": "แต่เบี้ยเลี้ยงที่ทางสถาบันให้ฉันก็ไม่น่าจะน้อยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230109
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130230109,
					"content": "ทำไมอะ?! มีสิทธิ์อะไรเนี่ย!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230110
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 130230110,
					"content": "แถมไม่ต้องทำงานหามรุ่งหามค่ำแบบพวกเด็กสถาปัตย์ด้วย ทำงานเหนื่อยแทบตาย เพื่อแลกกับรอยยิ้มเดียวของลูกค้า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230111
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130230111,
					"content": "นาย...นาย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230126
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 130230126,
					"content": "วันนี้ฉันไม่น่าใจดีช่วยนายทำความสะอาดห้องนั่งเล่นเลย! ฉันยังมีแปลนที่ยังต้องวาดอยู่นะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230112
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 130230112,
					"content": "แล้วก็อย่าลืมจ่ายค่าเช่าที่นายค้างอยู่มาด้วยนะ ฉันจะเอาเงินซื้อเฟอร์นิเจอร์",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230113
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130230113,
					"content": "อะ...นี่นายกวนประสาทฉัน? ให้ตายเถอะ ของตกแต่งที่นายซื้อมาพวกนั้นจะดูอันไหนก็ไร้รสนิยมโคตร ๆ เอาไม้แกะสลักแห้งกรอบพวกนั้นไว้ในบ้านเพื่อ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230114
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 130230114,
					"content": "ก็ใครใช้ให้ฉันมีอิสระทางการเงินล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230115
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130230115,
					"content": "ฉันว่านะ การที่มักชอบยกตนข่มท่านเป็นการหนีรูปแบบหนึ่งป่ะ? ถ้าตัดเรื่องเงินออกไป นายมีอะไรดีเหลือให้โอ้อวดบ้างล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230116
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 130230116,
					"content": "ถ้าจะให้คิดว่านายมีอะไรบ้างที่เหนือกว่านี่ยากจังนะ ตัวนายเองคิดออกมั้ยล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230117
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130230117,
					"content": "ก็ศิลปะไง! ก็บอกไปแล้วไงว่านายน่ะไม่มีเซนส์เรื่องการตกแต่งภายในเลย ไม่อนุญาตให้ซื้อเฟอร์นิเจอร์ตามอำเภอใจอีก เว้นแต่ว่านายจะพาฉันไปด้วย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230118
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 130230118,
					"content": "พานายไปแถมต้องเลี้ยงเหล้านายด้วยน่ะนะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230119
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130230119,
					"content": "ของมันแน่อยู่แล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230120
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 130230120,
					"content": "แล้วทำไมฉันต้องทำแบบนั้น? นี่มันเป็นแค่การยืมในอีกรูปแบบหนึ่งเท่านั้น ผ่านไปไม่นานนายก็ต้องคืนเงินฉันอยู่ดี",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230121
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130230121,
					"content": "นายเองก็เป็นได้นะ คนจิตใจดีน่ารักที่จะไม่ทวงหนี้ฉันน่ะ เนอะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230122
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 130230122,
					"content": "การแสร้งทำเป็นไม่มีหนี้สิน ก็น่าขันเหมือนการแสร้งทำเป็นว่าตัวเองไม่ได้อาศัยอยู่ในบ้านของคนอื่นนั่นแหละ ไม่ช้าก็เร็วคนอื่นก็จะรู้ความจริง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230123
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130230123,
					"content": "พูดถึงเรื่องนี้ คนที่มาที่บ้านวันนี้คงไม่พูดออกไปหรอกเนอะ? นายอย่าลืมช่วยฉันบอกให้พวกเขาเก็บเป็นความลับทีนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230124
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 130230124,
					"content": "ฉันกลับคิดว่านายแฉตัวเองไปหมดเรียบร้อยแล้ว ไม่เห็นต้องปกปิดให้ยุ่งยาก ด้วยความคออ่อนของนาย แค่เหล้าไม่กี่แก้ว กับไปร้านเหล้าแค่ไม่กี่ครั้ง นายก็บอกความลับทั้งหมดออกอย่างหมดจดเรียบร้อย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230125
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130230125,
					"content": "ไม่หรอกมั้ง? ...ไม่น่า คงไม่หรอกเนอะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaveh"
				}
			]
		}
	]
}