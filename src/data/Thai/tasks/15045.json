						150450618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450618,
					"content": "Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450619
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450619,
					"content": "...ขอโทษนะ พอฟังอะไรไร้สาระเยอะไปหน่อย จู่ ๆ สมองก็คิดอะไรไม่ออก ไม่รู้จะพูดอะไรดี...",
					"roleType": "TALK_ROLE_NPC",
