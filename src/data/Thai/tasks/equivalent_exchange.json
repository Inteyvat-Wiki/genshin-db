				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708100201,
					"content": "เกี่ยวกับของพิเศษเฉพาะใน Mondstadt...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708100202
					]
				},
				{
					"id": 708100202,
					"content": "ของพิเศษเฉพาะใน Mondstadt? ถึงแม้จะพูดได้ว่าอาหารของเรามีเอกลักษณ์ของ Mondstadt อยู่...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100203
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 708100203,
					"content": "แต่ว่าอาหารในร้านของเราน่ะเก็บไว้ได้ไม่นานหรอกนะ แล้วก็พกพาไม่สะดวกด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100204
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 708100204,
					"content": "ถึงแม้ว่าพวกเราจะสามารถทำให้มันพกพาและเก็บง่ายขึ้นได้... แต่แบบนั้นรสชาติกับความรู้สึกก็เปลี่ยนกันพอดี",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100205
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 708100205,
					"content": "ก็ไม่เห็นเป็นไรนี่",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708100206
					]
				},
				{
					"id": 708100206,
					"content": "ก็ได้ ถ้าคุณยืนยันแบบนั้น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100207
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 708100207,
					"content": "แต่ว่า อาหารในร้านน่ะถูกทำไว้ซักพักแล้วล่ะ ถ้าเกิดคุณอยากจะเอาไปส่งให้คนอื่นล่ะก็ ถ้ายังไงทำใหม่เลยจะดีกว่านะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100208
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 708100208,
					"content": "ขอโทษนะ ไม่ทราบเพื่อนของคุณอยู่ที่ไหนเหรอ? ฉันจะได้ช่วยคิดว่าจะทำอะไรส่งให้ดี",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100209,
						708100211
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 708100209,
					"content": "Snezhnaya น่ะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708100210
					]
				},
				{
					"id": 708100210,
					"content": "Snezhnaya งั้นเหรอ? ไกลมากเลยนะเนี่ย งั้นคงต้องคิดดี ๆ หน่อยว่าจะทำอะไรดี",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100213
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 708100213,
					"content": "อืม ถึงจะไม่รู้ว่าชาว Snezhnayan ชอบกินรสชาติแบบไหน แต่มีอยู่เมนูนึงที่น่าจะโอเคนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100214
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 708100214,
					"content": "คุณช่วยทำ Satisfying Salad มาให้ฉันซักที่ได้มั้ย ที่เหลือเดี๋ยวฉันจัดการเอง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100215
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 708100215,
					"content": "ไม่ได้ดัดแปลงอาหารแบบนี้มานานแล้วนะเนี่ย ฉันขอไปหาเครื่องมือก่อนนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				},
				{
					"id": 708100211,
					"content": "พวก Fatui น่ะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708100212
					]
				},
				{
					"id": 708100212,
					"content": "F..Fatui? คุณหมายถึงพวกที่มาจาก Snezhnaya นั่นใช่มั้ย? ...คุณนี่กว้างขวางดีจังเลยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100213
					],
					"speakerTitle": "Sara"
				}
			]
		},
