					"Xuanji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711340301,
					"content": "เอ๋? คุณลูกค้า...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340302
					],
					"speakerTitle": "Xuanji"
				},
				{
					"id": 711340302,
					"content": "ฉันเอาวัตถุดิบพวกนี้มาให้ เสิร์ฟชาให้หน่อยนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711340303
					]
				},
				{
					"id": 711340303,
					"content": "อะไรนะ? นี่พวกคุณไปจัดการ <color=#00E1FFFF>Pyro Whopperflower</color> พวกนั้นจริง ๆ เหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340304
					],
					"speakerTitle": "Xuanji"
				},
				{
					"id": 711340304,
					"content": "จริง ๆ แล้วพวกมันก็มีไม่น้อยเลยนะ แต่ก็ไม่เท่าไหร่สำหรับเราหรอก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711340305,
					"content": "มีไม่น้อย? อ่า ไม่ ๆ ฉันรู้อยู่แล้วล่ะว่ามันมีเยอะ ฮ่าฮ่า พวกคุณสองคนนี่กล้าหาญมากจริง ๆ นับถือ ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340306
					],
					"speakerTitle": "Xuanji"
				},
				{
					"id": 711340306,
					"content": "(โชคดีสองคนนี้ไม่เป็นอะไร... ไม่งั้นฉันคงได้ตกงานแน่... ดูท่าคราวหน้าคงต้องเปลี่ยนคำพูดแล้วล่ะ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340307
					],
					"speakerTitle": "Xuanji"
				},
				{
					"id": 711340307,
					"content": "ฮึฮึ คราวนี้คุณก็ปฏิเสธไม่ได้แล้วล่ะสิ ตอนนี้พวกเราอยากจะดื่มชาน้ำผึ้งหวานระเบิดสูตรร้อนแรงสุดพิเศษแล้วล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711340308,
					"content": "อะแฮ่ม... ได้สิ... เดี๋ยวฉันจะไปเตรียมให้เดี๋ยวนี้แหละ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340309
					],
					"speakerTitle": "Xuanji"
				},
				{
					"id": 711340309,
					"content": "(ให้ตายสิ... จะทำไงล่ะทีนี้... คงจะไม่ยากอะไรหรอกมั้ง?! ก็แค่เอา Sweet Flower กับ Whopperflower Nectar ใส่เข้าไปด้วยกันสินะ?!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340310
					],
					"speakerTitle": "Xuanji"
				},
				{
					"id": 711340310,
					"content": "Xuanji แสดงสีหน้าลำบากใจ แต่ก็ยังหยิบวัตถุดิบที่พวกคุณนำมาใส่ลงไปในแก้ว หลังจากนั้นไม่นาน เขาก็หยิบออกมาเพิ่ม แต่สุดท้ายก็วางกลับไปทั้งหมด",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						711340311
					]
				},
				{
					"id": 711340311,
					"content": "จากนั้นเขาก็ปิดฝา และเริ่มเขย่าอย่างแรง ไม่นานนัก ของเหลวสีน้ำตาลที่มีฟองประหลาด ก็ถูกยกมาเสิร์ฟตรงหน้าของพวกคุณ",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						711340312
					]
				},
				{
					"id": 711340312,
					"content": "คุณรู้สึกได้ว่ามีบางอย่างแปลก ๆ แต่ Paimon กลับรับแก้วนั้นมา และดื่มหมดในอึกเดียว",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						711340313
					]
				},
				{
					"id": 711340313,
					"content": "แหวะะะะะะ!!! นี่มันอะไรเนี่ย! เกิดมาฉันไม่เคยกินอะไรที่รสชาติแย่แบบนี้มาก่อนเลย... นี่คุณเปิดแผงขายชาแบบนี้ได้ยังไงเนี่ย ถามจริง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711340314,
					"content": "เอ่อฮ่าฮ่า... ขะ...ขอโทษนะ! ที่ทำให้ลิ้นของคุณลูกค้าต้องทุกข์ทรมานแบบนี้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340315
					],
					"speakerTitle": "Xuanji"
				},
				{
					"id": 711340315,
					"content": "นี่เป็นน้ำใจเล็ก ๆ น้อย ๆ ช่วยรับไว้ด้วยนะ! ถือซะว่าเป็นสินไหมชดเชยเรื่องลิ้นของคุณก็แล้วกัน แล้วก็เป็นค่าตอบแทนสำหรับวัตถุดิบที่พวกคุณหามาด้วย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340316
					],
					"speakerTitle": "Xuanji"
				},
				{
					"id": 711340316,
					"content": "อ่า... ก็ได้ ถึงแม้ฝีมือการชงชาของคุณจะไม่ได้เรื่อง แต่ก็ถือเป็นคนดีมีคุณธรรม...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711340317,
					"content": "แหะ ๆ ไม่หรอก... ยังไงก็ขอบคุณมากนะ ที่ทำให้วัตถุดิบของฉันครบซะที",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340318
					],
					"speakerTitle": "Xuanji"
				},
				{
					"id": 711340318,
					"content": "ถ้าทั้งสองไม่มีธุระอะไรแล้วก็รีบกลับไปเถอะ อยู่ด้านนอกนาน ๆ แบบนี้ ไม่รู้จะมีอันตรายอะไรรึเปล่า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xuanji"
