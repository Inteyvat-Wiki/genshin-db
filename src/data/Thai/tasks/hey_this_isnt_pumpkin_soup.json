						740390602,
						740390605
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390602,
					"content": "ใช่แล้วล่ะ \"โพชั่นสุดแกร่ง\" ทำให้ฉันแกร่งเกินต้านทาน!",
					"roleType": "TALK_ROLE_PLAYER",
