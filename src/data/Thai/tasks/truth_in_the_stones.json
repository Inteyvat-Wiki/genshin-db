					"content": "ถูกต้อง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210412,
						111210413
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210412,
					"content": "บางทีพวกเขาอาจจะไม่ต้องใช้มัน?",
