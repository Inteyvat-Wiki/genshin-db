				{
					"id": 150421401,
					"content": "ตอนนี้รู้สึกยังไงบ้าง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421402,
						150421404,
						150421406
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421402,
					"content": "สบายมากเลยล่ะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421403
					]
				},
				{
					"id": 150421403,
					"content": "ปากเก่งเหมือนกันนะ แต่ฉันว่าเธอทำได้ดีมากจริง ๆ นั่นแหละ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421408
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421408,
					"content": "บางทีฉันอาจจะเสนอความคิดเห็นให้กับพนักงาน เพื่อให้พวกเขาปรับปรุงมันในอนาคตก็ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421409
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421409,
					"content": "ยังไงซะ... อย่างน้อยก็ควรให้ผู้เข้าแข่งขันสองคนลองแข่งกันดูว่าใครจะชนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421404,
					"content": "ตาลายไปหมดแล้ว...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421405
					]
				},
				{
					"id": 150421405,
					"content": "ฮ่าฮ่า การตั้งใจโฟกัสมันเป็นเรื่องที่ใช้พลังกายเยอะมาก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421408
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421406,
					"content": "ก็สนุกดีนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421407
					]
				},
				{
					"id": 150421407,
					"content": "จริงเหรอ? ดูเหมือนเราจะคิดเหมือนกันสินะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421408
					],
					"speakerTitle": "Chasca"
				}
			]
