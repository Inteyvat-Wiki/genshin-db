				"points": []
			},
			"dialogs": [
				{
					"id": 120320101,
					"content": "ในอนาคต Inazuma จะต้องเจอกับการท้าทายอีกมากมาย แต่ว่าฉันได้เตรียมการรับมือไว้แล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320102,
						120320107,
						120320112,
						120320117,
						120320122,
						120320128
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 120320102,
					"content": "เกี่ยวกับ \"การท้าทาย\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320103
					]
				},
				{
					"id": 120320103,
					"content": "การยกเลิกกฎ Sakoku มันเกี่ยวข้องกับคนหลายฝ่ายอย่างเลี่ยงไม่ได้ ฉันไม่สามารถพูดได้ว่ามันมีแต่ผลดี และไม่มีผลเสียอะไรเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320104
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 120320104,
					"content": "ยกตัวอย่างเช่น ฉันสามารถคาดการณ์ได้ว่า โลกภายนอกจะส่งผลกระทบต่อธุรกิจของ Inazuma ปัญหาต่าง ๆ เหล่านี้คือสิ่งที่ฉันต้องจัดการต่อไป",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320105
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 120320105,
					"content": "Ei จริงจังสุด ๆ เลยนะ เรื่องที่ฉันคิดมีแต่เรื่องพื้น ๆ อย่างเช่น ในอนาคตศาลเจ้า Grand Narukami จะขายตั๋วเข้าชมได้รึเปล่าเท่านั้นเอง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320106
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120320106,
					"content": "เธอนี่นะ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 120320107,
					"content": "เกี่ยวกับความสนใจของเหล่าทวยเทพ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320108
					]
				},
				{
					"id": 120320108,
					"content": "ความสนใจของ Makoto นั้นอยู่กับชาว Inazuma ตลอดเลย ฉันเคยคิดมาตลอดว่ามันคือหน้าที่ของเธอ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320109
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 120320109,
					"content": "แต่ตอนนี้ฉันรู้แล้วว่า การเฝ้ามองแบบนี้มันเต็มไปด้วยความชื่นชมและความคาดหวัง นอกจากจะเป็นหน้าที่แล้ว เธอต้องมีความสุขกับมันด้วยแน่ ๆ เธอรักมนุษย์มากเลยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320110
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 120320110,
					"content": "ถ้าผู้คนในอดีตควรค่าแก่การเฝ้ามอง งั้นผู้คนในปัจจุบันและอนาคตก็เป็นเช่นกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320111
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120320111,
					"content": "อืม ฉันจะไม่มองข้ามความปรารถนาและความฝันของพวกเขาอีกต่อไป",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 120320112,
					"content": "เกี่ยวกับสงครามหลายร้อยปี...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320113
					]
				},
				{
					"id": 120320113,
					"content": "พูดกันตามตรง มันคือความทรมานที่มองไม่เห็นจุดสิ้นสุด",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320114
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 120320114,
					"content": "เมื่อต้องเผชิญหน้ากับสงครามที่ไร้จุดจบ ฉันต้องมีสมาธิตลอดเวลา ถ้าฉันเผลอแค่นิดเดียว ดาบของโชกุนก็จะเอาชีวิตฉันได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320115
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 120320115,
					"content": "สามารถพูดได้เลยว่า ถ้าฉันไม่มีประสบการณ์และความรู้ด้านการต่อสู้มาก่อน และไม่มีทักษะในการใช้ดาบ ฉันต้องพ่ายแพ้แน่นอน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320116
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 120320116,
					"content": "ในเรื่องนี้ต้องขอบคุณเธอด้วยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 120320117,
					"content": "เกี่ยวกับรอยแผลบนต้น Sacred Sakura...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320118
					]
				},
				{
					"id": 120320118,
					"content": "วางใจเถอะ ฉันไม่ได้ลืมหรอก ฉันจะไปสั่งการสำนัก Tenryou กับสำนัก Yashiro ไว้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320119
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 120320119,
					"content": "นอกจากภัยคุกคามจากพวกมอนสเตอร์แล้ว ฉันยังกังวลว่าจะมีอะไรอย่างอื่นที่หลุดรอดออกมาจากต้น Sacred Sakura อีกรึเปล่า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320120
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 120320120,
					"content": "มันก็พูดยากอยู่นะ เพราะนอกจากความทรงจำแล้ว ข้างในกระแสพลังยังมีอะไรอีกมากมาย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320121
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120320121,
					"content": "ถ้าเธอรู้ดีอยู่แล้ว งั้นก็อย่าขี้เกียจสิ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 120320122,
					"content": "Yae Miko บอกว่าเทพเจ้าของเธอ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320123
					]
				},
				{
					"id": 120320123,
					"content": "อะแฮ่ม! พูดจาเพ้อเจ้อต่อหน้าฉันเลยเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320124
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120320124,
					"content": "เรื่องบางเรื่อง จะเอามาบอกคนอื่นง่าย ๆ ไม่ได้นะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320125
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120320125,
					"content": "เธอคงไม่อยากรู้หรอกว่า ถ้าทรยศฉันจะต้องชดใช้ยังไงบ้าง ให้คิดซะว่าเรื่องที่ฉันพูดกับเธอ เป็นความลับระหว่างเราสองคน เข้าใจมั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320126
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120320126,
					"content": "พวกเธอคุยเรื่องอะไรกันอยู่เหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320127
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 120320127,
					"content": "ไม่มีอะไรหรอก จู่ ๆ ก็อยากกินเต้าหู้ทอดซะแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120320128,
					"content": "ไม่มีคำถามอะไรจะถามแล้วล่ะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		}
	]
}