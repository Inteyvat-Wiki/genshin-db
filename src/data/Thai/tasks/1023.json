			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10230301,
					"content": "ว้าววว... ที่นี่คือ <color=#00E1FFFF>Golden House</color> งั้นเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230302,
					"content": "จากข้างนอกก็ดูหรูหราแล้ว นึกไม่ถึงว่าข้างในจะอลังการขนาดนี้! แล้วก็... แล้วก็มีแต่ Mora กองอยู่เต็มพื้นเลย!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230303,
					"content": "Mora ทั่วทั้งดินแดน Teyvat ก็ถูกสร้างขึ้นจากที่นี่ งั้น... ถ้าจะหายไปนิดหน่อย ก็คงไม่มีใครรู้ได้ง่าย ๆ หรอกมั้ง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230304,
						10230305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230304,
					"content": "อย่าไปแตะมันนะ ถ้าแตะต้องมันต้องโดนจับแน่",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230306
					]
				},
				{
					"id": 10230306,
					"content": "ที่แท้ก็เป็นกับดัก อันตรายจังเลย! โชคดีที่เธอเตือนก่อน!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230307,
					"content": "ถึงจะเอาไปไม่ได้ แต่เข้าไปดูใกล้ ๆ คงไม่มีปัญหาหรอกมั้ง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230308,
					"content": "ถ้าทำได้ล่ะก็ ฉันอยากจะไปนอนอยู่บนนั้น! ใช้ Mora มาทำเป็นผ้าห่ม คงจะฝันหวานน่าดู ฮี่ฮี่ฮี่...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230309,
						10230310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230309,
					"content": "ไปตรวจดู Exuvia กันก่อนเถอะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230311
					]
				},
				{
					"id": 10230311,
					"content": "อ้อ จริงด้วยสิ เรื่องนี้ก็สำคัญ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230312,
					"content": "ที่นี่... เงียบเกินไปรึเปล่า? ของสำคัญอย่าง Exuvia เป็นไปไม่ได้หรอกที่จะไม่มีคนเฝ้า?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230313,
					"content": "#อ๊ะ?! {NICKNAME} ดูนั่นสิ นั่นมันอะไรกันน่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230314,
