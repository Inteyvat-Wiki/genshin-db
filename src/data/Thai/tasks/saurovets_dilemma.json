							9383.85
						],
						"pointId": 9801
					}
				]
			},
			"dialogs": [
				{
					"id": 750180301,
					"content": "\"ก้า...!\"\\nเหมือนมันจะรู้ว่า ตัวเองสู้ไม่ไหว Qucusaurus จึงส่งเสียงร้องแล้วบินจากไป...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750180302
					]
				},
				{
					"id": 750180302,
					"content": "ว้าววว!! บะ...บินเร็วชะมัด! แป๊บเดียวก็บินไปไกลขนาดนั้นแล้ว!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180303,
						750180305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180303,
					"content": "Paimon รีบตามไปเร็ว!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750180304
					]
				},
				{
					"id": 750180304,
					"content": "หา ให้ฉันตามไป? ฉันเนี่ยนะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180307,
					"content": "...อืม บินเร็วขนาดนี้ ดูเหมือนพลังกายจะฟื้นฟูได้พอสมควรแล้ว ต่อไปก็...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180308
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180308,
					"content": "จะว่าไปแล้ว ทำไมเจ้า Qucusaurus นั่นถึงได้โกรธขนาดนั้นล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180309,
					"content": "...อ๊ะ รู้แล้ว! เธอคงไม่ได้แอบกินขนมของมันหรอกใช่มั้ย? ความแค้นที่เกิดจากอาหาร มันหนักหนาสาหัสมากเลยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180310,
					"content": "ขนม? กินก็เคยกินอยู่หรอก แต่ \"จ๊อกจ๊อก\" เป็น Qucusaurus ที่ไม่ค่อยสนใจเรื่องรายละเอียด เพราะงั้นคงไม่คิดมากกับเรื่องเล็กน้อยแบบนี้หรอก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180311
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180311,
					"content": "\"จ๊อกจ๊อก\"? ที่แท้มันก็เป็น Saurian ที่มีชื่อนี่เอง... แต่ดูท่าทางจะอารมณ์ไม่ดีเท่าไหร่นะ เมื่อกี้ยังเล่นงานคนอื่นไปทั่วอยู่เลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180312,
					"content": "อืม... ไม่ใช่ความผิดของมันหรอก ทั้งหมดก็เพื่อการรักษาน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180313
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180313,
					"content": "ที่แท้การโดนซ้อมก็เป็นการรักษาเหรอเนี่ย ความรู้ใหม่เลย",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750180314
					]
				},
				{
					"id": 750180314,
					"content": "กี้! กี้กี้!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180315
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750180315,
					"content": "#มีวิธีรักษาแบบนี้ที่ไหนกัน! เห็นมั้ย เธอพูดมั่วแบบนี้ {REALNAME[ID(2)|SHOWHOST(true)]} คิดจริงจังแล้วเนี่ย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180316,
					"content": "กี้? หงิง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180317
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750180317,
					"content": "ฮ่าฮ่า ถ้ามีวิธีการรักษาแบบนี้อยู่จริง แล้วยังได้ผลอีก ฉันก็อยากลองดูเหมือนกัน! แต่ Saurian ไม่เหมือนกับมนุษย์ ต่อให้พูดกับพวกมันว่า ที่ทำไปก็เพื่อให้หายเร็วขึ้น พวกมันก็ไม่เข้าใจอยู่ดี",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180318
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180318,
					"content": "จริงสิ ยังไม่ได้แนะนำตัวเลย ฉันชื่อ Mazkal ปกติจะคอยดูแล Saurian ที่ได้รับบาดเจ็บหรือป่วยอยู่แถวนี้ ฉันไม่ได้โม้นะ ยาที่ฉันปรุงได้รับคำชมเยอะเลยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180319
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180319,
					"content": "อืม เจ้าตัวน้อยของพวกเธอดูแข็งแรงดีนะ ดูท่าคงไม่ต้องการการดูแลจากฉันแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180320
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180320,
					"content": "กี้! กี้กี้!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180321
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750180321,
					"content": "ที่แท้เธอก็คือหมอที่รักษา Saurian นี่เอง เอ่อ ดูจาก \"จ๊อกจ๊อก\" แล้ว น่าจะเป็นงานที่เหนื่อยมากเลยสินะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180322,
					"content": "ฉันว่าก็ไม่ได้ลำบากขนาดนั้นหรอก แต่เพราะสถานการณ์ของ \"จ๊อกจ๊อก\" ค่อนข้างพิเศษ... ตอนนี้มันไม่เชื่อใจมนุษย์เลย แถมยังต่อต้านการรักษาและการกินยาด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180323
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180323,
					"content": "เฮ้อ ถ้าฉันเป็น Saurian ก็ดีสิ ก่อนหน้านี้ฉันสังเกตเห็นว่า มันเข้ากันได้ดีกับ Saurian ตัวอื่น ๆ ถ้า Saurian ด้วยกันเกลี้ยกล่อมให้มันกินยา บางทีมันอาจจะยอมก็ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180324
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180324,
					"content": "หงิง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180325
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750180325,
					"content": "ถ้าเป็นแบบนี้ ไม่แน่ว่าพวกเราอาจจะช่วยได้นะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180326,
					"content": "เอ๋? หรือว่า ถึงรูปลักษณ์ภายนอกของพวกเธอจะเป็นแบบนี้ แต่จริง ๆ แล้วเป็น Saurian?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180327
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180327,
					"content": "นี่เธอคิดไปถึงไหนแล้วเนี่ย! เฮ้อ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180328,
					"content": "#อ่า จริงสิ! ที่จริงแล้วเป็นเพราะ {REALNAME[ID(2)|SHOWHOST(true)]} เป็น Saurian น้อยที่ฉลาดมากเลยล่ะ! เรื่องนี้มันช่วยได้นะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180329,
					"content": "เอ๋? เก่งขนาดนั้นเลยเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180330,
						750180332
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180330,
					"content": "มันเลือกฉัน ถือว่าเทสดีไม่เบาเลยล่ะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750180331
					]
				},
				{
					"id": 750180331,
					"content": "จะพูดแบบนั้นก็ไม่ผิด... แต่ประเด็นสำคัญตอนนี้ไม่ใช่เรื่องนี้ซะหน่อย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180333,
					"content": "#เอาเป็นว่าเรื่องเล็กน้อยแค่นี้ ปล่อยให้ {REALNAME[ID(2)|SHOWHOST(true)]} จัดการเถอะ ไม่มีปัญหาแน่นอน!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180334,
					"content": "กี้! กี้!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180335
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750180335,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} งั้นฉันขอขอบคุณแทนเจ้า \"จ๊อกจ๊อก\" ด้วยนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180336
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180336,
					"content": "ตอนแรกฉันกังวลมากว่า ขืนมันยังก่อเรื่องแบบนี้ต่อไป ไม่ใช่แค่แผลเก่าจะไม่หาย แต่คงจะได้แผลใหม่อีกด้วย... แต่พอได้พวกเธอมาช่วย ก็สบายใจขึ้นเยอะเลย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180337
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180337,
					"content": "ฉันเตรียมโพชั่นไว้ให้กับเจ้า \"จ๊อกจ๊อก\" สองชนิด ถึงแม้ว่าฉันจะอยากให้มันมีประสิทธิภาพการรักษา และรสชาติที่ลงตัวกว่านี้ แต่ตอนนี้ฉันยังไม่สามารถทำสูตรที่สมบูรณ์แบบได้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180338
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180338,
					"content": "เพราะงั้น โพชั่นทั้งสองชนิดนี้ ชนิดที่มีประสิทธิภาพการรักษาดี น่าจะเป็นรสชาติที่ Saurian ไม่ค่อยชอบ ส่วนรสชาติที่พวกมันชอบ ประสิทธิภาพก็อาจจะไม่ดีขนาดนั้น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180339
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180339,
					"content": "#อืม... แทนที่จะให้ฉันอธิบาย ให้ {REALNAME[ID(2)|SHOWHOST(true)]} ลองดมดูละกัน พวกเธอดูปฏิกิริยาของมัน น่าจะเข้าใจมากกว่านะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180340
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180340,
					"content": "อันนี้ประสิทธิภาพดีกว่า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180341
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180341,
					"content": "หงิง... หงิงหงิง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180342
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750180342,
					"content": "อันนี้ให้ผลการรักษาไม่ค่อยดีเท่าไหร่ แต่สีของมันดูน่ากินมากเลยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180343
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180343,
					"content": "กี้! กี้กี้!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180344
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750180344,
					"content": "ว้าว เข้าใจแล้วล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180345
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180345,
					"content": "ไม่ว่าจะเป็นแบบไหน ขอแค่เจ้า \"จ๊อกจ๊อก\" ยอมกิน ก็จะช่วยฟื้นฟูมันได้ เพราะงั้นโพชั่นทั้งสองชนิดนี้ ฉันให้พวกเธอก็แล้วกัน ส่วนจะใช้ชนิดไหนก็แล้วแต่พวกเธอแล้วล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180346
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180346,
					"content": "กี้!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180347
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750180347,
					"content": "ฮิฮิ พึ่งพาได้จริง ๆ! งั้นฉันจะกลับไปเตรียมตัวที่ค่ายก่อนนะ ส่วนเรื่อง \"จ๊อกจ๊อก\" ก็รบกวนพวกเธอด้วยนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180348
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180348,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} เป็นคู่หูที่พึ่งพาได้ คราวนี้ปล่อยให้มันจัดการเองเถอะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180332,
					"content": "มันพอจะเชื่อมสัมพันธ์ระหว่างมนุษย์กับ Saurian เข้าด้วยกันได้",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750180333
					]
				},
				{
					"id": 750180305,
					"content": "แค่นี้ก็เผ่นแล้วเหรอ แน่จริงก็กลับมาสิ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750180306
					]
				},
				{
					"id": 750180306,
					"content": "Saurian ไม่เข้าใจคำพวกนี้หรอก!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180307
					],
					"speakerTitle": "Paimon"
				}
			]
