				"points": []
			},
			"dialogs": [
				{
					"id": 3730201,
					"content": "เอ๋? ไหงเธอมาที่นี่ได้ล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730202
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730202,
					"content": "ถึงฉันจะยังแอบคิดอยู่ ว่าเธอคงอาจจะตามมา...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730203
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730203,
					"content": "ฉันอยากรู้เกี่ยวกับเทพแห่งลมมากกว่านี้",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3730204
					]
				},
				{
					"id": 3730204,
					"content": "เทพแห่งลม Barbatos น่ะเหรอ? เขาหายตัวไปจาก Mondstadt ตั้งนานแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730205
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730205,
					"content": "เทพแห่งหินกับสายฟ้าของประเทศเพื่อนบ้านอย่าง Liyue กับ Inazuma นั้นยังคงอยู่ แต่ชาว Mondstadt ไม่เจอเทพของพวกเขามานานแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730206
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730206,
					"content": "ทำไมถึงอยากรู้เรื่องเกี่ยวกับเทพแห่งลมล่ะ? เป็นเพราะ Dvalin เหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730207
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730207,
					"content": "อ๊า เรื่องนี้...เพราะว่า \"เทพเจ้า\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3730208,
					"content": "อืม มีคนเล่าอดีตของมังกรให้ฉันฟัง",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3730209
					]
				},
				{
					"id": 3730209,
					"content": "ตอนนี้ผู้คนนั้นคิดยังไงเกี่ยวกับ \"Stormterror\" กันนะ? ฉันสนใจจริง ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730210
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730210,
					"content": "แต่ว่า ไม่ต้องรีบหรอกนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730211
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730211,
					"content": "ฉันไม่ได้กลับมาที่นี่นานแล้ว ดูเหมือนว่าจะมีบางอย่างไม่พอใจกับการมาของฉันนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
		{
			"id": 37304,
			"completionStepIds": [
				37304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"37304",
							"2"
						],
						"stepId": 37304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3730401,
					"content": "อืม...การเปลี่ยนทิศของลม สิ่งที่ได้รับผลกระทบนั้นไม่ได้มีแต่มังกรสินะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730402
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730402,
					"content": "จริงสิ เมื่อกี้เธอบอกว่า มีคนบอกเธอเกี่ยวกับอดีตของมังกรงั้นเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730405,
					"content": "...งั้นเหรอ? นั่นคือมุมมองของนักวิชาการของ Mondstadt อย่าง Lisa สินะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730406
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730406,
					"content": "ก็ไม่ผิด มาถึงจุดนี้แล้ว แน่นอนเพราะทั้งสองฝ่ายต่างเริ่มที่จะใช้กำลัง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730407
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730407,
					"content": "แต่ความเกลียดชังแรกเริ่มของมันนั้นแน่นอนว่าไม่ใช่เพราะผู้คนไม่บูชา \"สี่วายุ\" อีกต่อไปแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730408
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730408,
					"content": "...นั่นไม่ใช่ความเกลียดชังโดยธรรมชาติ แต่เป็นผลมาจากการกัดกร่อน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730409
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730409,
					"content": "กัด...กัดกร่อน?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3730410,
					"content": "เป็นเลือดสีดำที่ไหลเข้ามาในหัวใจ ทำให้มันเจ็บปวดและนอนไม่หลับเป็นเวลาหลายปี",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730411
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730412,
					"content": "Abyss Mages? ไม่เคยได้ยินชื่อนี้มาก่อน",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3730413
					]
				},
				{
					"id": 3730414,
					"content": "เหมือนฉันจะเคยได้ยินคำนี้จาก Mondstadt...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3730415
					]
				},
				{
					"id": 3730411,
					"content": "เพราะงั้นการตื่นครั้งนี้ จิตวิญญาณของมันถึงได้ถูกการกัดกร่อนสาปแช่งของ \"Abyss Mage\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730412,
						3730414
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730413,
					"content": "Abyss Order นั้นประกอบไปด้วยอมนุษย์ เป็นองค์กรที่ไม่เป็นมิตรต่อมนุษยชาติ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730416
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730415,
					"content": "ถูกต้อง องค์กรอมนุษย์ Abyss Order เป็นองค์กรที่ไม่เป็นมิตรต่อมนุษยชาติ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730416
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730416,
					"content": "ฉันไม่รู้ที่มาของพวกมัน รู้แค่ว่าพวกมันนั้นเกลียดชังมนุษย์มาก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730417
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730417,
					"content": "เหล่า Hilichurl ในป่านั้นก็ฟังคำสั่งจากพวกมัน กลายเป็นเครื่องมือให้กับพวกมัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730418
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730418,
					"content": "ก่อนจะมาถึงที่นี่ ฉันเองก็เป็นเหมือนกับ Dvalin ถูกคำสาปกัดกร่อน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730419
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730419,
					"content": "ตำแหน่งที่พวกเราอยู่ตอนนี้ก็คือ \"สัญลักษณ์แห่งฮีโร่\" ต้นกำเนิดของทุกอย่างของ Mondstadt ในปัจจุบัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730420
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730420,
					"content": "ลมแถวต้นไม้นี่ดีมาก ฉันชอบกลิ่นแบบนี้จัง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730421
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730421,
					"content": "การอยู่ใต้ร่มต้นไม้กับเธอ จะสามารถขับสารพิษออกไปจากร่างกายของฉัน เหมือนกับน้ำตามังกร",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730422
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730423,
					"content": "เฮ้อ...รู้สึกดีขึ้นเยอะเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730424
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730424,
					"content": "แล้ว...ตอนแรกเธอโดนพิษอะไรมา?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3730425,
					"content": "อ๋อ...เป็นเพราะฉันพยายามสื่อสารกับ Dvalin ก่อนหน้านี้ แต่ฉันถูกขัดจังหวะซะก่อน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730426
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730427,
					"content": "เอ่อ... คือ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3730429
					]
				},
				{
					"id": 3730428,
					"content": "เป็นเพราะว่าฉัน...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3730429
					]
				},
				{
					"id": 3730426,
					"content": "ทำให้ไม่เพียงแต่ไม่ถอนคำสาปให้ Dvalin ไม่สำเร็จ แต่ยังถูกพิษนั่นกัดกินไปด้วย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730427,
						3730428
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730429,
					"content": "ถูกต้อง!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730430
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730431,
					"content": "#เพราะงั้นเพื่อเป็นการไถ่โทษ...{NICKNAME} เธอไปที่มหาวิหาร ของ Mondstadt กับฉันหน่อยนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730432
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730432,
					"content": "มหาวิหารของ Mondstadt? ไปทำอะไรน่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3730433,
					"content": "ไปเอาสิ่งที่เรียกว่า \"Holy Lyre der Himmel\" น่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		}
	]
}