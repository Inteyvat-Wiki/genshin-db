						412130524
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130524,
					"content": "Sucrose อาจจะดูเป็นคนทื่อ ๆ แต่ที่จริงแล้วเป็นเด็กที่จิตใจดีมาก ๆ เลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130525
					],
					"speakerTitle": "Paimon"
				},
