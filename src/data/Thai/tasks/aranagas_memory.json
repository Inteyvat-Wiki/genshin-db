						730560603
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560603,
					"content": "ว้าว... อะไรน่ะ? มันคืออะไรกัน?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560604,
					"content": "พวกเธอน่าจะเคยเห็นมาก่อนแล้วล่ะ มันคือดอกไม้แห้งดอกน้อย ๆ น่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560605
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560605,
					"content": "เอ๊ะ...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560606,
						730560607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560606,
					"content": "นี่มัน...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560608
					]
				},
				{
					"id": 730560608,
					"content": "ใช่แล้วล่ะ และถ้าหากว่าฉันเดาไม่ผิดล่ะก็... พวกเขาก็ให้ของขวัญแบบเดียวกันนี้กับเธอใช่มั้ยล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560609
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560609,
					"content": "โฮะโฮะ... ฉันก็รู้อยู่แล้วล่ะ ว่าการพบกันของพวกเรามันไม่ใช่แค่เรื่องบังเอิญแบบทั่วไปแน่ ๆ... ฉันไม่เคยเชื่อเรื่องความบังเอิญมาตั้งแต่ไหนแต่ไรแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560610
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560610,
					"content": "ดอกไม้นี้มอบให้เธอแล้ว ไหว้วานให้เธอเอามันไปมอบให้กับเพื่อนที่พวกเรามีร่วมกันด้วยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560611
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560611,
					"content": "เอ่อ ได้มันก็ได้อยู่หรอก แต่ว่า...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560612,
						730560614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560612,
					"content": "พวกเขาน่าจะจำฉันไม่ได้แล้วน่ะสิ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560613
					]
				},
				{
					"id": 730560613,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560615
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560615,
					"content": "ฉันเองมองไม่เห็นพวกเขาแล้วเหมือนกัน... ฉันแทบไม่อยากจะเชื่อด้วยซ้ำว่าพวกเขาจะมีอยู่จริง หรือบางที... มันอาจจะเป็นแค่จินตนาการในวัยเด็กของฉันก็เป็นได้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560616
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560616,
					"content": "แต่ฉันก็ยังยืนยันคำเดิมนะเด็ก ๆ เอาดอกไม้นี้ไปมอบให้พวกเขาที... ในวันที่เธอยังเจอพวกเขาอยู่ ถือโอกาสในตอนที่ปาฏิหาริย์เกิดขึ้นได้น่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560614,
					"content": "พวกเขาอาจจะจำคุณไม่ได้แล้ว",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560615
					]
				},
				{
					"id": 730560607,
					"content": "พวก Aranara...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560608
					]
				}
			]
