				"points": []
			},
			"dialogs": [
				{
					"id": 730560201,
					"content": "หลัก ๆ ฉันต้องการตรวจสอบอยู่สามแห่งน่ะ ฮ่าฮ่า ความทรงจำของเมื่อสามสิบปีก่อนน่าจะยังไม่จางหายไปหมดนะ... ฉันยังพอชี้จุดให้พวกเธอดูได้อยู่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560202
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560202,
					"content": "ยังไงก็ ขอบคุณพวกเธอที่มาเป็นเพื่อนนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560203
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560203,
					"content": "ไม่ต้องเกรงใจหรอกน่า คุณ Khayyam! นี่มันเป็นเรื่องที่ Javan อย่างเราต้องทำอยู่แล้วล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7305603,
			"completionStepIds": [
				7305609
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7305609",
							"2"
						],
						"stepId": 7305609,
						"stateName": "QUEST_STATE_UNFINISHED"
