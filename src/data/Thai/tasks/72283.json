			},
			"dialogs": [
				{
					"id": 722830201,
					"content": "เธอก็ยิงไม่โดนเป้าเหมือนกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830202
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830202,
					"content": "ดูเหมือนวันนี้ดวงจะแย่จริง ๆ ต้องมีบางสิ่งที่ไม่ดีส่งผลต่อฝีมือของเธอแน่เลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830203
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830203,
					"content": "งั้นลองอีกทีมั้ย? ยังไงซะ เป้าหมายก็ไม่ว่ายไปมาเหมือนพวกลูกปลา Unagi",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830203
					],
					"speakerTitle": "Akashi"
				}
			]
		},
		{
			"id": 7228303,
			"completionStepIds": [
				7228303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
