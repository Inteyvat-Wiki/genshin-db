					"Akashi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722830301,
					"content": "ว้าว! เธอทำสำเร็จแล้ว!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830302
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830302,
					"content": "เอ๋ แต่ท่าทางการยิงธนูของเธอดูดีมากเลยนะ อย่างกับผู้เชี่ยวชาญแหนะ แต่คนที่ไม่ได้เรื่องได้ราวอย่างฉัน ต่อให้ฝึกอีกหลายปีก็คงเทียบเธอไม่ติดหรอก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830303
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830303,
					"content": "และเพราะมัวแต่ฝึกยิงธนูในที่บ้า ๆ แบบนี้ทุกวัน ฉันเลยไม่ได้เห็น Unagi ตัวเป็น ๆ มานานแล้วเนี่ย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830304
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830304,
					"content": "ว่าแต่เธอชอบ Unagi มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830305,
						722830306
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830305,
					"content": "ชอบนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722830307
					]
				},
				{
					"id": 722830307,
					"content": "งั้นเหรอ เพราะฉันชอบ Unagi มาก เลยอยากลองเลี้ยงเอง เธอไม่คิดว่าพวกมันน่ารักเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830308
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830308,
					"content": "แน่นอนว่า Unagi บนจานนั่นดูสวยมากกว่าอยู่แล้ว ทั้งดูดีแล้วก็อร่อยด้วย ดีจริง ๆ เลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830309
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830309,
					"content": "แต่จะว่าไปแล้ว เพราะชอบ Unagi ก็เลยอยากเลี้ยง เพราะอยากเลี้ยง Unagi ก็เลยฝึกยิงธนู ฉันลำดับความสำคัญผิดมั้ยนะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830310
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830310,
					"content": "แต่สุดท้าย ฉันก็ชอบ Unagi ที่มีชีวิตอิสระมากกว่า เรื่องเลี้ยงอะไรนั่นก็ช่างมันดีกว่า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830311
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830311,
					"content": "จริงสิ ขอบคุณที่ช่วยสาธิตให้ดูนะ รับของเหล่านี้ไว้ด้วยเถอะ ขอให้โชคดีนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830306,
					"content": "ไม่ค่อยเท่าไหร่",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722830307
					]
				}
			]
		}
	]
}