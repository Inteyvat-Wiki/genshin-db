				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chuno"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750880201,
					"content": "ฮ่าฮ่า เยี่ยมไปเลย ทีนี้ฉันก็สามารถถอดรหัสลวดลายสีทองเหล่านี้บน \"จารึกเรืองรอง\" ได้แล้ว... รางวัล รางวัลต้องเป็นของฉัน!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880202
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880202,
					"content": "พูดตรง ๆ เลยว่าถ้าครั้งนี้ล้มเหลวอีก ก็จะไม่มีเงินทุนเหลือแล้ว จะอยู่หรือจะตายก็ขึ้นอยู่กับเรื่องนี้แล้วล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880203
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880203,
					"content": "อ๊ะ จริงสิ นี่เป็นค่าตอบแทนของพวกเธอนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chuno"
				}
			]
		},
		{
			"id": 7508803,
			"completionStepIds": [
				7508803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7508803",
							"2"
						],
						"stepId": 7508803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chuno"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750880301,
					"content": "อืม ถ้ามีตัวอย่างที่มากพอละก็ ไม่แน่ว่า...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880302
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880302,
					"content": "โอ๊ะ ที่นี่มีคนประหลาดกำลังพึมพำอะไรบางอย่างด้วย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750880303,
					"content": "ใน Natlan นี้มีคนแบบฉันอยู่เต็มไปหมด คนที่แปลกคือพวกเธอมากกว่า... ถ้าไม่มีธุระอะไรก็เลิกมารบกวนการวิจัยของฉันได้แล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880304
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880304,
					"content": "ค่าใช้จ่ายของฉันเดือนนี้สูงกว่าที่คาดเอาไว้อีกแฮะ คงต้องอาศัยเงินรางวัลจากการแก้ไขปัญหาการวิจัยของสมาคมมาช่วยถูไถแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880305
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880305,
					"content": "ที่แท้การทำวิจัยก็ได้เงินด้วยเหรอเนี่ย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750880306,
					"content": "ใช่ \"สมาคมวิจัยมรดกแห่ง Saurian\" ก็เป็นองค์กรแบบนี้แหละ ต้องมีรางวัลให้ ถึงจะสามารถส่งเสริมงานวิจัยของทุกคนในหัวข้อต่าง ๆ ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880307
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880307,
					"content": "ครั้งนี้ฉันจะต้องท้าทายการถอดรหัส \"จารึกเรืองรอง\"... ว่ากันว่านี่เป็นผลงานอันยิ่งใหญ่ ที่ยังไม่เคยมีใครทำสำเร็จเลย แถม Mora ที่จะได้ก็เยอะมากเลยด้วย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880308
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880308,
					"content": "แต่ว่า...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880309
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880309,
					"content": "แต่ว่าอะไรเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750880310,
					"content": "ถ้าจะถอดรหัส \"จารึกเรืองรอง\" ก่อนอื่นต้องมีชิ้นส่วน \"จารึกเรืองรอง\" ที่มากพอซะก่อน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880311
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880311,
					"content": "...อืม งั้นเอางี้มั้ย ถ้าพวกเธอสามารถหาชิ้นส่วนของ \"จารึกเรืองรอง\" มาให้ฉันได้ ฉันจะให้ค่าตอบแทนกับพวกเธอ เป็นไง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880312
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880312,
					"content": "ฉันเห็นว่าพวกเธอเป็นนักผจญภัยที่มากประสบการณ์ คงจะได้รับคำขอแบบนี้อยู่บ่อย ๆ สินะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880313
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880313,
					"content": "ก็ไม่ใช่ว่าจะไม่ได้หรอก แต่ไหนว่าค่าใช้จ่ายเดือนนี้ของคุณเกินกว่าที่กำหนดไว้แล้วไม่ใช่เหรอ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750880314,
					"content": "ไหน ๆ ก็เกินงบอยู่แล้ว งั้นก็เกินอีกสักหน่อยก็ไม่เป็นไรหรอก... ตราบใดที่ได้ชิ้นส่วนของ \"จารึกเรืองรอง\" มา และถอดรหัสเนื้อหาของมันได้ ยังไง้ยังไงก็ต้องได้ Mora ไม่มากก็น้อยแหละ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880315,
						750880316
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880315,
					"content": "พวกเราแค่ตามหาชิ้นส่วนเท่านั้นนะ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750880317
					]
				},
				{
					"id": 750880317,
					"content": "พวกเธอแค่รับปากว่าจะหา \"ของแท้\" มาให้ได้ก็พอ พูดแล้วก็โมโห วัตถุจากสถานแห่งเดนลับที่พ่อค้าคนกลางเอามาขายให้ฉันในเดือนนี้ มีแต่ของปลอมทั้งนั้นเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880318
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880318,
					"content": "หลอก Mora ฉันไปก้อนโตเลย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880319
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880319,
					"content": "อ๋อ ที่ค่าใช้จ่ายเกินก็เพราะแบบนี้เองสินะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750880320,
					"content": "เพราะงั้นฉันเลยต้องใช้ชิ้นส่วนของ \"จารึกเรืองรอง\" มาแก้สถานการณ์ไงล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880321
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880321,
					"content": "ขอร้องละนะ ฉันขอฝากเรื่องหาชิ้นส่วนด้วยละกัน! ถ้าเจอแล้วช่วยเอามาให้ฉันที่นี่ด้วยนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880322
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880322,
					"content": "อืม ไม่ต้องเอาเยอะแยะหรอก แค่... สาม ไม่สิ สี่ชิ้นละกัน! ถ้าเยอะเกินฉันคงจ่ายค่าตอบแทนไม่ไหวแน่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880316,
					"content": "ไม่แน่ใจว่าชิ้นส่วนจะมีประโยชน์รึเปล่านะ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750880317
					]
				}
			]
		},
