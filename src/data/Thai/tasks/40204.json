	"talks": [
		{
			"id": 4020401,
			"completionStepIds": [
				4020401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4020401",
							"2"
						],
						"stepId": 4020401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fadaweh",
					"Atashye",
					"Darwish"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 402040101,
					"content": "Atashye ฉันทนนายมานานแล้วนะ... ที่นายรายงานมาแต่ละอย่าง มันไม่มีประโยชน์เลยสักนิด!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040102
					],
					"speakerTitle": "Fadaweh"
				},
				{
					"id": 402040102,
					"content": "ลองดูสิว่า นายเขียนอะไรส่งมาบ้าง... \"อาจจะ\", \"น่าจะ\", \"ประมาณ\" นายจะให้ฉันทำโมเดลคณิตศาสตร์ จากของพวกนี้ได้ยังไงกัน?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040103
					],
					"speakerTitle": "Fadaweh"
				},
				{
					"id": 402040103,
					"content": "คะ...คือว่า ฉันมีเวลากำหนดหัวข้อค่อนข้างจำกัด อีกอย่างฉันก็มาจากภาควิชาเทคโนโลยี ใครจะไปรู้ล่ะ ว่าจะต้องวัดผลกระทบที่เกิดขึ้นกับสิ่งมีชีวิตยังไง... ยะ...อย่างเช่น Fungus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040104
					],
					"speakerTitle": "Atashye"
				},
				{
					"id": 402040104,
					"content": "จะ...จะให้ฉันยื่นมือเข้าไปในปากของ Fungus แล้วให้พวกมันกัดสักคำ จากนั้นก็บันทึกไว้ว่า \"แรงกัดน่าทึ่งมาก\" คงไม่ได้หรอกมั้ง!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040105
					],
					"speakerTitle": "Atashye"
				},
				{
					"id": 402040105,
					"content": "Darwish นายเป็นคนของภาควิชาชีววิทยาไม่ใช่เหรอ มาช่วยตัดสินหน่อยสิ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040106
					],
					"speakerTitle": "Atashye"
				},
				{
					"id": 402040106,
					"content": "ฮ่า ๆ ถ้าจะให้ฉันเป็นคนตัดสินละก็ ฉันคงต้องบอกว่า Atashye นายน่ะ เรียนวิชาพื้นฐานไม่ได้เรื่องเลยนะ เพราะทุกคนก็รู้กันอยู่แล้วว่า Fungus ส่วนใหญ่ไม่มีปาก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040107
					],
					"speakerTitle": "Darwish"
				},
				{
					"id": 402040107,
					"content": "ฮ่า!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040108
					],
					"speakerTitle": "Fadaweh"
				},
				{
					"id": 402040108,
					"content": "แต่ว่านะ Fadaweh ครั้งนี้พวกเราไม่จำเป็นต้องใช้โมเดลคณิตศาสตร์ ที่เข้มงวดขนาดนี้หรอก หัวข้อที่เราจะทำในครั้งนี้ ก็ไม่ได้มุ่งเป้าไปที่นักวิชาการหัวโบราณในสถาบันเหมือนกัน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040109
					],
					"speakerTitle": "Darwish"
				},
				{
					"id": 402040109,
					"content": "หัวข้อที่เราต้องทำคือหัวข้อที่เกี่ยวกับเด็กพวกนั้น... อืม ความสนุกต้องมาก่อน บางทีการจินตนาการอย่างเหมาะสม ก็เป็นสิ่งที่จำเป็นเหมือนกันนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040110
					],
					"speakerTitle": "Darwish"
				},
				{
					"id": 402040110,
					"content": "อืม... ในเมื่อรุ่นพี่พูดขนาดนี้แล้ว...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040111
					],
					"speakerTitle": "Fadaweh"
				},
				{
					"id": 402040111,
					"content": "เฮ้ Fadaweh ท่าทีที่เธอปฏิบัติต่อ Darwish ดูจะแตกต่างจากที่เธอปฏิบัติกับฉันมากเกินไปหน่อยนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040112
					],
					"speakerTitle": "Atashye"
				},
				{
					"id": 402040112,
					"content": "เอาล่ะ ๆ ส่วนที่ฉันรับผิดชอบก็ใกล้จะเสร็จแล้ว และฉันก็ได้อ่านข้อสรุปของ Atashye มาแล้วด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040113
					],
					"speakerTitle": "Darwish"
				},
				{
					"id": 402040113,
					"content": "อีกอย่าง ข้อมูลก็สามารถปรับแก้หลังจากการทดสอบ นี่ก็คือความหมายของการทดสอบไง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040114
					],
					"speakerTitle": "Darwish"
				},
				{
					"id": 402040114,
					"content": "อ่า สมแล้วที่เป็นรุ่นพี่ Darwish... เขียนได้ละเอียดและชัดเจนกว่าใครบางคนเยอะเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040115
					],
					"speakerTitle": "Fadaweh"
				},
				{
					"id": 402040115,
					"content": "อื้ม ๆ ฉันขอไม่ถามละกันว่า \"ใครบางคน\" ที่ว่านั่นหมายถึงใคร",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040116
					],
					"speakerTitle": "Atashye"
				},
				{
					"id": 402040116,
					"content": "เอาล่ะ ๆ รีบไปเตรียมตัวขั้นสุดท้ายกันเถอะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040117
					],
					"speakerTitle": "Darwish"
				},
				{
					"id": 402040117,
					"content": "ระ...รับทราบ! รุ่นพี่!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040118
					],
					"speakerTitle": "Fadaweh"
				},
				{
					"id": 402040118,
					"content": "ฉันจะไปดูสีบนภาพวาดด้วยว่าแห้งรึยัง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040119
					],
					"speakerTitle": "Atashye"
				},
				{
					"id": 402040119,
					"content": "แต่พูดถึงการทดสอบ... ผู้ทดสอบทั้งสองที่อยู่ตรงนั้น สนใจมั้ยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040120
					],
					"speakerTitle": "Darwish"
				},
				{
					"id": 402040120,
					"content": "เมื่อกี้ยืนมองอยู่ตรงนั้นตั้งนานแล้วสินะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040121
					],
					"speakerTitle": "Darwish"
				},
				{
					"id": 402040121,
					"content": "หืม พวกเราเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402040122,
					"content": "ใช่แล้ว เข้าร่วมการทดสอบ จะได้กินผลไม้สด ๆ จำนวนมากด้วยนะ สนใจมั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040123,
						402040125
					],
					"speakerTitle": "Darwish"
				},
				{
					"id": 402040123,
					"content": "เป็นการทดสอบผลไม้พันธุ์ใหม่งั้นเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402040124
					]
				},
				{
					"id": 402040124,
					"content": "ไม่ใช่ อืม... ขอฉันคิดก่อนนะว่าจะเริ่มเล่าจากตรงไหนดี...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040130
					],
					"speakerTitle": "Darwish"
				},
				{
					"id": 402040130,
					"content": "เอางี้ ฉันขอถามอะไรพวกเธอสักอย่างก่อนดีกว่า... อืม เช่น... \"ถ้า Pyro Fungus เด้งดึ๋งที่ยืดหดตัวได้กับสมิงเครายาวสู้กัน ใครจะแข็งแกร่งกว่ากัน?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040131,
						402040134,
						402040137
					],
					"speakerTitle": "Darwish"
				},
				{
					"id": 402040131,
					"content": "Pyro Fungus เด้งดึ๋งที่ยืดหดตัวได้...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402040132
					]
				},
				{
					"id": 402040132,
					"content": "งั้นเหรอ แต่ฉันคิดว่าสมิงเครายาวดูจะสู้เก่งกว่าซะอีกนะ... เพราะกรงเล็บที่ยาวและแหลมคมของสมิงเครายาวนั่นแหละ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402040133,
					"content": "หืม ทำไมถึงถามคำถามแปลก ๆ แบบนี้ล่ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402040140,
					"content": "เดี๋ยวสิ... ยังมีอีกนะ \"Floating Anemo Fungus กับ Anemo Slime ใครแข็งแกร่งกว่ากัน\" \"กลุ่ม Eremite กับนักรบ Saurian ของ Natlan ใครแข็งแกร่งกว่ากัน? แล้ว Kairagi ล่ะ...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040141
					],
					"speakerTitle": "Darwish"
				},
				{
					"id": 402040141,
					"content": "นี่เป็นคำถามที่พวกเด็ก ๆ ชอบถามตอนที่เราสอนอยู่น่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040142
					],
					"speakerTitle": "Darwish"
				},
				{
					"id": 402040142,
					"content": "อายุแค่นี้แต่สนใจเรื่องพวกนี้กันแล้วเหรอ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402040143,
					"content": "ฮ่าฮ่า แต่ความอยากรู้อยากเห็นของเด็ก ๆ ก็เป็นจุดเริ่มต้นของการเรียนรู้นะ พวกเขา \"อยากรู้\"... เพราะงั้นพวกเราก็เลยทำสิ่งนี้ขึ้นมา...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040144
					],
					"speakerTitle": "Darwish"
				},
				{
					"id": 402040144,
					"content": "\"การผจญภัยครั้งใหญ่ของคู่หู\" ที่เลียนแบบจาก \"เกมสงคราม\" ที่จริงจัง! ให้พวกเด็ก ๆ จำลองทีมผจญภัยของพวกเขา แล้วต่อสู้กับศัตรู!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040145
					],
					"speakerTitle": "Darwish"
				},
				{
					"id": 402040145,
					"content": "Atashye กำลังทำหัวข้อวิจัยผลกระทบของอาหารการกิน และสภาพแวดล้อมที่มีต่อมอนสเตอร์ ส่วน Fadaweh ก็ช่วยสร้างโมเดล \"จำลองการพัฒนา\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040146
					],
					"speakerTitle": "Darwish"
				},
				{
					"id": 402040146,
					"content": "จำลองการพัฒนา?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402040147
					]
				},
				{
					"id": 402040147,
					"content": "ใช่แล้ว จะให้เด็ก ๆ ไปเล่นกับ Fungus จริง ๆ ได้ยังไงกัน ส่วนการไปเจอกับกลุ่ม Eremite น่ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040148
					],
					"speakerTitle": "Darwish"
				},
				{
					"id": 402040148,
					"content": "เป็นยังไงบ้าง ถ้ามีเวลาว่างก็มาดูได้นะ แหะ ๆ ถ้าเข้าร่วมการทดสอบ ก็ถือว่าเป็นการเข้าร่วมการวิจัยด้วยนะ แบบนี้เธอเองก็จะได้รับประสบการณ์ทางวิชาการอันมีค่าไปพร้อม ๆ กันด้วย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040149
					],
					"speakerTitle": "Darwish"
				},
				{
					"id": 402040149,
					"content": "#อืมมม ฟังดูเจ๋งไปเลยนะ... {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040150
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402040150,
					"content": "เอาล่ะ ทีนี้ Paimon ก็จะได้สั่งสมความรู้ และกลายเป็นนักปราชญ์แล้ว!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402040151
					]
				},
				{
					"id": 402040151,
					"content": "ฮึ อย่ามาดูถูกฉันนะ ฉันน่ะเก่งมากนะจะบอกให้ แล้วจะต้องเก่งขึ้นกว่าเดิมแน่นอน อื้ม! เดี๋ยวพวกเราไปดูกันเถอะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040152
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402040152,
					"content": "#งั้นก็ยินดีต้อนรับพวกเธอเข้าร่วมการทดสอบนะ {NICKNAME} แน่นอนว่า ฮ่า ๆ ฉันต้องขอขอบคุณว่าที่นักปราชญ์ผู้ยิ่งใหญ่ Paimon ด้วย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040153
					],
					"speakerTitle": "Darwish"
				},
				{
					"id": 402040153,
					"content": "อืม ถ้าพวกเธออยากลองดูก็บอกฉันได้เลยนะ ฉันจะอธิบายกติกาการ \"จำลองการพัฒนา\" ให้พวกเธอฟังก่อน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Darwish"
				},
				{
					"id": 402040134,
					"content": "ก็ต้องเป็นสมิงเครายาวอยู่แล้ว!",
					"roleType": "TALK_ROLE_PLAYER",
