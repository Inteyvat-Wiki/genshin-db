				]
			},
			"dialogs": [
				{
					"id": 761760301,
					"content": "...พี่ Aria พี่ Canon",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760302
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760302,
					"content": "นี่ไม่ใช่ครั้งแรกสักหน่อย นี่มัน...เกินขอบเขตของ \"การลงโทษ\" ไปแล้วนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760303
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760303,
					"content": "ไม่ว่าจะเป็นเมืองของมังกร ที่ท่านราชาได้มอบหมายให้พวกเรา หรือบ้านที่เปราะบางแต่ก็งดงาม ซึ่งสร้างขึ้นโดยมนุษย์ตัวเล็ก ๆ พวกนั้น...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760304
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760304,
					"content": "พวกพี่จะทนดูสิ่งมีชีวิตที่บริสุทธิ์ต้องตายไปอีกเท่าไหร่ ถึงจะเลิกนิ่งดูดายได้สักที?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760305
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760305,
					"content": "ถ้าหากท่านราชาของเรายังอยู่ที่นี่...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760306
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760306,
					"content": "...ท่านราชาของเราไม่อยู่ที่นี่ Sonnet",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760307
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761760307,
					"content": "ถ้าองค์เหนือหัวที่ห่างไกลจากการรอบรู้สรรพสิ่งผู้นั้น มองว่าชะตากรรมอันซีดเซียวและน่าสยดสยองนี้คือ \"ระเบียบ\" และถ้านี่เป็นแค่หนทางเดียว ที่จะทำให้โลกที่ถูกกำหนดให้ต้องล่มสลายใบนี้ รอดพ้นจากการถูกกลืนกิน งั้น...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760308
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761760308,
					"content": "ไม่ว่าราคาที่ต้องจ่ายจะหนักหนาแค่ไหน... และไม่ว่าราคานั้นจะทำให้ฉันเสียใจเพียงใด มันก็ยังดีกว่าความเงียบสงัดอันมืดมิดมากนัก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760309
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761760309,
					"content": "ในเมื่อโลกถูกกำหนดให้ต้องพบกับการล่มสลายอยู่แล้ว... งั้นการต่อต้านความมืดมิดจะมีความหมายอะไรล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760310
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760310,
					"content": "...Sonnet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760311
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761760311,
					"content": "มะ...ไม่มีอะไร พี่ Aria! ฉันไม่ได้พูดอะไรเลย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760312
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760312,
					"content": "ฉันแค่รู้สึกว่า เราไม่ควรนิ่งดูดาย และปล่อยให้ทรราชคนนั้น สังหารสิ่งมีชีวิตที่เชื่อมั่นในตัวเรา... ไม่ว่าจะเป็นมังกรหรือมนุษย์ตัวเล็ก ๆ พวกนั้น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760313
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760313,
					"content": "เรา... ควรจะช่วยพวกเขาไม่ใช่เหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760314
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760314,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760315
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761760315,
					"content": "...ฉันเข้าใจความโกรธของ Sonnet นะ Aria ฉันคิดว่า สิ่งที่องค์เหนือหัวผู้นั้นทำลงไป มันก็ออกจะโหดร้ายเกินไปหน่อย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760316
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761760316,
					"content": "ต่อให้มีความเป็นไปได้แค่เล็กน้อย... ฉันก็หวังว่าจะทุ่มเททุกอย่าง เพื่อช่วยเหลือสิ่งมีชีวิตที่ยังพอจะช่วยได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760317
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761760317,
					"content": "แต่ว่า... แล้วพวกที่ช่วยไว้ไม่ได้ล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760318
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760318,
					"content": "พวกคนที่ช่วยไว้ไม่ได้ สิ่งมีชีวิตที่ช่วยไว้ไม่ได้... ทั้งหยาดเลือด น้ำตา และเสียงร่ำไห้ของพวกเขา ควรจะหายไปอย่างไร้ร่องรอยงั้นเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760319
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760319,
					"content": "ไม่... มันไม่ควรจะเป็นแบบนั้น ฉันหวังว่าจะช่วยทุกคนไว้ได้ และไม่มีใครต้องจมดิ่งลงไป",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760320
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760320,
					"content": "ตราบใดที่ \"ระเบียบ\" ของมันตายไปพร้อมกับมัน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760321
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760321,
					"content": "...Sonnet อย่าลืมเหตุผลที่เราถือกำเนิดขึ้นมาตั้งแต่แรกนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760322
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761760322,
					"content": "ภารกิจของพวกเรามีแค่การปกป้องโลกใบนี้ จนกว่าท่านราชาผู้มอบชีวิตให้เราจะกลับมาจากแดนไกล",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760323
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761760323,
					"content": "เรารู้ดีถึงราคาของระเบียบนี้ตั้งแต่แรก... เพราะเราไม่อาจปล่อยให้โลกใบนี้มุ่งสู่การล่มสลายได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760324
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761760324,
					"content": "...ไม่ นี่มันไม่เกี่ยวอะไรกับระเบียบเลยด้วยซ้ำ Aria",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760325
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761760325,
					"content": "Sonnet สำหรับพวกเรา... สำหรับฉัน เธอคือน้องสาวที่สำคัญที่สุด",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760326
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761760326,
					"content": "ดังนั้น... ได้โปรดอย่าทำเรื่องที่จะทำให้ Aria กับฉันต้องเจ็บปวดเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760327
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761760327,
					"content": "อย่าได้ต่อต้านระเบียบแห่งสรวงสวรรค์ตรง ๆ อย่างน้อย... ก็ไม่ใช่ในตอนนี้ที่โลกยังคงเปราะบาง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760328
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761760328,
					"content": "พี่ Canon... ฉัน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760329
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760329,
					"content": "Istaroth เคยบอกฉันถึงคำศัพท์คำหนึ่งที่เป็นของมนุษย์เท่านั้นว่า... \"ความหวัง\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760330
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761760330,
					"content": "ตราบใดที่ยังมีชีวิต ก็ยังมีความหวัง... และความหวังจะมีอยู่เสมอ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canon"
				}
			]
		}
	]
}