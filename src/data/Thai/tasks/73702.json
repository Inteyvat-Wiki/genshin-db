				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sorush"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 737020601,
					"content": "ห้วงทมิฬ Tunigi... ที่นี่คือศูนย์กลางของภัยพิบัติ แม้ว่าทุกอย่างจะสงบลงแล้วก็ตาม...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020602
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020602,
					"content": "จินตนาการสถานการณ์ในตอนนั้นออกเลยแฮะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020603
					]
				},
				{
					"id": 737020603,
					"content": "ผลึกคริสตัลอันเบ้อเริ่มที่อยู่รอบ ๆ พวกนี้... ใหญ่กว่า Wenut ตั้งหลายเท่าแน่ะ! พอนึกถึงว่าอนาคต Sorush ต้องรับผิดชอบมาจัดการปัญหาใหญ่ของที่นี่แล้ว...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737020604,
					"content": "นี่ก็คือหน้าที่ที่วีรชนภูตดอกไม้ควรแบกรับเอาไว้มากสุดมิใช่หรือ? อีกทั้งยังเป็นสิ่งที่ Sorush ปรารถนาเองด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020605
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020605,
					"content": "ถึงจะพูดแบบนั้นก็เถอะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737020606,
					"content": "หรือว่ายังไม่ไว้ใจข้าอีก? ฮึ ไม่นึกว่าจนป่านนี้แล้ว ข้ายังจะถูกเจ้าปุยขาวดูถูกอีก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020607
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020607,
					"content": "โห รู้สึกเหมือนได้ Sorush สุดปากแจ๋วก่อนหน้านี้คืนมาเลยอะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737020608,
					"content": "ไม่รู้ว่าเป็นเรื่องดีหรือเรื่องร้ายกันแน่",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020609
					]
				},
				{
					"id": 737020609,
					"content": "อืม... หลังใช้เวลาร่วมกันจนถึงตอนนี้ \"ยัสนาปติ\" กับเจ้าปุยขาวยังสงสัยในตัวข้าอีกหรือ? ข้าหาได้โอหังแบบไม่มีเหตุผลไม่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020610
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020610,
					"content": "ฮึฮึ พวกเจ้ารู้ไว้ด้วยว่า ข้าได้ทำความเข้าใจกับข้อผิดพลาดในอดีตของตนหมดแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020611
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020611,
					"content": "ในอดีต ข้ามองว่าชื่อเสียงสำคัญกว่าการกระทำ แต่ยามนี้ข้ารู้แล้วว่า การทำเช่นนี้เป็นการลำดับความสำคัญผิด",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020612
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020612,
					"content": "เช่นเดียวกันกับ \"ซีเมิร์ก\" ที่กลายเป็นวิหคศักดิ์สิทธิ์ เพราะการเสียสละของตัวเอง ข้าจะกลายเป็นวีรชนภูตดอกไม้ เพราะสิ่งที่ข้าทำ แล้วถูกผู้คนสรรเสริญสืบไปกาลนาน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020613
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020613,
					"content": "อีกอย่าง ข้าก็ทำการฝึกฝนที่ท่านผู้อาวุโสกำหนดไว้เสร็จสิ้นทั้งหมดแล้ว ทีนี้ต่อให้ท่านผู้อาวุโสเองก็ต้องยอมรับว่าข้าเป็นวีรชนได้สมชื่อ และคู่ควรกับ \"มงกุฎดอกไม้เขาคู่\" อย่างแท้จริง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020614
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020614,
					"content": "ข้าย่อมไม่มีปัญหากับการตัดสินใจของควาเรนาห์อยู่แล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020615
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020615,
					"content": "...เอ๋?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020616
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020616,
					"content": "อะไรกัน? หรือว่าตอนนี้ข้าต้องคัดค้านล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020617
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020617,
					"content": "ไม่... คือ... ข้าแค่นึกไม่ถึงว่าท่านผู้อาวุโสจะยอมรับรวดเร็วฉับไวขนาดนี้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020618
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020618,
					"content": "นึกว่าจะพูดจาค่อนแคะอีกสักหน่อย",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020619
					]
				},
				{
					"id": 737020619,
					"content": "โอ้ ข้ามิใช่ผู้อาวุโสที่ใจร้ายอะไรหรอกนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020620
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020620,
					"content": "ใช่แล้ว ส่วนเรื่องหน้าที่ของวีรชน... ข้าไม่เห็นได้รับความรู้ด้านนี้จากมงกุฎดอกไม้เลย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020621
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020621,
					"content": "เพราะข้ายังเป็นวีรชนที่ไม่สมบูรณ์สินะ? หรือว่าข้ายังต้องผ่านการฝึกฝนอะไรอีก...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020622
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020622,
					"content": "เรื่องนี้หรือ... ถึงแม้ว่านามของวีรชนจะเป็นส่วนหนึ่งในการสืบทอดของภูตดอกไม้ แต่หน้าที่อย่างละเอียดกลับเปลี่ยนแปลงไปตามยุคสมัย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020623
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020623,
					"content": "อื้มอื้ม",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020624
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020624,
					"content": "กล่าวโดยสรุปก็คือ ไม่มีกำหนดไว้ชัดเจนว่าจักต้องทำเรื่องใด ไม่มีมาตรฐานเกณฑ์ตัดสินตายตัวว่าผ่านเกณฑ์หรือไม่ ปกติแล้ว การตัดสินใจของควาเรนาห์ถือเป็นที่สิ้นสุด",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020625
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020625,
					"content": "เอ๊ะ? งั้นก็หมายความว่า...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020626
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020626,
					"content": "ข้าไม่มีทางยึด \"มงกุฎดอกไม้เขาคู่\" คืนหรอกนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020627,
						737020629
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020627,
					"content": "ทีนี้ก็ไม่ต้องกลัวว่าจะหนาวหัวแล้วนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020628
					]
				},
				{
					"id": 737020628,
					"content": "ประเด็นมันใช่ตรงนี้ที่ไหนกันเล่า!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020633
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737020633,
					"content": "ข้ารู้แล้วล่ะ! นี่คงจะเป็นส่วนนึงของการ \"ทดสอบ\" ด้วยสินะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020634
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020634,
					"content": "ดูเหมือนจู่ ๆ Sorush ก็เข้าใจอะไรบางอย่างนะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020635
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737020635,
					"content": "เจ้าปุยขาวนี่ขี้ลืมจัง ข้าเพิ่งจะพูดไปหยก ๆ! การฝึกฝนพวกนี้ นอกจากจะช่วยขัดเกลาความสามารถ และความช่างสังเกตของข้าแล้ว สิ่งสำคัญที่สุดคือ การทำให้ข้าเข้าใจถึงข้อผิดพลาดในอดีตของตัวเองอย่างไรล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020636
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020636,
					"content": "หากละเลยขั้นตอนในการฝึกฝน เพียงเพราะรู้ว่าผลลัพธ์จะไม่เปลี่ยนแปลง งั้นจะต่างอะไรกับการเดินซ้ำรอยเดิมล่ะ? เพราะฉะนั้น นี่จะต้องเป็นบททดสอบสุดท้ายที่ท่านผู้อาวุโสมอบให้ข้าแน่นอน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020637
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020637,
					"content": "สำหรับวีรชนภูตดอกไม้ตัวจริงเสียงจริงแล้ว นี่เป็นเพียงเรื่องเล็กน้อย นี่คือการแสดงออกว่าท่านผู้อาวุโสไว้ใจข้าอย่างเต็มที่ไงล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020638
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020638,
					"content": "ไม่นึกเลยว่า Sorush จะดูออกทะลุปรุโปร่ง สมแล้วที่เป็นภูตดอกไม้ที่ควาเรนาห์เลือก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020639
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020639,
					"content": "#แต่ที่ Sorush เปลี่ยนแปลงแบบนี้ได้ คงต้องขอขอบคุณ {NICKNAME} กับ Paimon ด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020640
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020640,
					"content": "อื้ม! \"ยัสนาปติ\" ของข้ากับคู่หูอย่างเจ้าปุยขาว ช่างเป็นบุคคลที่มีความสามารถล้ำเลิศเสียจริง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020641
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020641,
					"content": "#ถึงอยากกล่าวว่ามีข้าคนเดียวก็เหลือเฟือแล้ว... แต่เชื่อว่าเมื่อมีความช่วยเหลือจากพวก{M#เขา}{F#นาง} การดับ \"ปรากฏการณ์ Apaosha\" ก็คงจะมิใช่ใช่เรื่องยากเย็นอะไร",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020642
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020642,
					"content": "ฟังดูพึ่งพาได้มากเลยล่ะ ทว่าอย่าลืมไปเชียว Mihir กับ Rashnu ก็จะช่วยเหลือพวกเจ้าด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020643
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020643,
					"content": "ท่านผู้อาวุโสวางใจปล่อยให้ข้าจัดการได้เลย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020644
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020644,
					"content": "อย่างกับว่าทั้งหมดนี้เป็นแผนที่ Zurvan จัดวางเอาไว้เลย... แต่เห็นท่าทางดีใจของ Sorush แล้ว แบบนี้ก็ดีเหมือนกันแหละเนอะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737020629,
					"content": "ไม่ใช่ว่าถึงอยากยึดก็ยึดไม่ได้เหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020630
					]
				},
				{
					"id": 737020630,
					"content": "นั่นสิ Zurvan ก็พูดเองนี่นาว่า การตัดสินใจของควาเรนาห์ถือเป็นที่สิ้นสุด ต่อให้เป็น Zurvan ก็เปลี่ยนแปลงผลลัพธ์แบบนี้ไม่ได้ง่าย ๆ หรอกมั้ง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020631
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737020631,
					"content": "ฮึฮึ... จะไม่ได้จริง ๆ รึ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020632
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020632,
					"content": "ฮื่อ... รู้สึกน่ากลัวแฮะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020633
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7370207,
