			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Araminali"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731000101,
					"content": "#Nara {NICKNAME} อยากเปิด \"หีบสมบัติ\" เหรอ? แต่ว่า... ที่ Vana ยังมี Aranara ที่ต้องการความช่วยเหลืออีกหลายตนเลย ถ้า Nara สีทองไปช่วย Aranara เหล่านี้ได้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000102
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000102,
					"content": "Araminali จะเตรียม \"หีบสมบัติ\" ไว้ให้เต็ม ๆ เลย! และใส่ \"สมบัติ\" ที่ Aranimba ส่งกลับมาลงใน \"หีบ\" ให้เต็ม ๆ ด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araminali"
				}
			]
		},
		{
			"id": 7310002,
			"completionStepIds": [
				7310014
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7310014",
							"2"
						],
						"stepId": 7310014,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Araminali"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731000201,
					"content": "#Araminali รู้ว่า Nara สีทองคือ Nara นิสัยดีที่เคยช่วย Aranara ไว้ เพราะงั้น Araminali เลยจะมอบ \"หีบสมบัติ\" ให้ Nara {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araminali"
				}
			]
		},
		{
			"id": 7310003,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
