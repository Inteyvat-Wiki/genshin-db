				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Araminali"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731000301,
					"content": "#Araminali ได้ยินมาว่า Nara {NICKNAME} ได้ \"โชว์ฝีมือ\" ที่ Vana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000302
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000302,
					"content": "#ใส่ \"สมบัติ\" ลงใน \"หีบ\" แล้ว Nara {NICKNAME} สามารถเปิด \"หีบสมบัติ\" ได้แล้ว \"ไม่ต้องเกรงใจนะ\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araminali"
				}
			]
		},
		{
			"id": 7310004,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7310014",
							"3"
						],
						"stepId": 7310014,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_GREATER",
						"rawParams": [
							"73100",
							"32"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Araminali"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731000401,
					"content": "#Nara {NICKNAME} กับ Paimon ช้าจังเลย! \"หีบสมบัติ\" ของ Araminali เตรียมเสร็จตั้งนานแล้ว และ Araminali ก็รอมานานมาก ๆ แล้วด้วย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000402
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000402,
					"content": "เพื่อนที่แสนดีของ Aranara ตอนนี้ \"หีบสมบัติ\" เต็มแล้ว สามารถเปิดได้แล้วล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araminali"
				}
			]
		},
		{
			"id": 7310005,
			"completionStepIds": [
				7310015
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7310015",
							"2"
						],
						"stepId": 7310015,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Araminali",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731000501,
					"content": "#มี Aranara หลายตนบอก Araminali ว่า Nara {NICKNAME} และ Paimon ทำเรื่องดี ๆ ไว้มากมายเลย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000502
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000502,
					"content": "Araminali รู้ตั้งนานแล้วล่ะ คำชื่นชมเหล่านั้น พัดผ่านกิ่งไม้ในผืนป่า ไหลผ่านกระแสน้ำลำธาร ลอยตามสายลมมาถึง \"รังแห่งความสุข\" ของ Araminali หมดแล้วล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000503
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000503,
					"content": "#เพราะงั้นคราวนี้ Araminali เลยเติม \"หีบ\" จนเต็มแน่น เพื่อรอ Nara {NICKNAME} มาเปิดไงล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000504
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000504,
					"content": "#Aranimba ส่งพวกของแวววาวกลับมา Araminali ก็ใส่ลงไปใน \"หีบ\" แล้วเหมือนกัน Nara {NICKNAME} อาจจะชอบก็ได้มั้ง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000505
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000505,
					"content": "Aranimba ไม่ได้กลับมาเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731000506
					]
				},
				{
					"id": 731000506,
					"content": "อืม Aranimba ไม่ได้หยั่งรากลึกเหมือนต้นไม้ใหญ่ เขาเป็น Aranara ที่ไม่เคยหยุดนิ่ง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000507
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000507,
					"content": "เอ๋... แล้ว Araminali อยู่ที่นี่ตนเดียวไม่เหงาเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731000508,
					"content": "\"เหงา\" หมายความว่าอะไรเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000509
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000509,
					"content": "เอ่อ... ก็หมายความว่า เวลาอยู่คนเดียวแล้ว รู้สึกอยากให้มีเพื่อนคอยอยู่ข้าง ๆ ด้วย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731000510,
					"content": "ที่ Vanarana มี Aranara อยู่เยอะแยะเลย เพราะงั้น Araminali เลยไม่ \"เหงา\" เลยสักนิด",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000511
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000511,
					"content": "แต่ Arayama กับ Aranimba ไม่อยู่ที่ Vanarana ทั้งคู่เลย เมื่อก่อน Aranara ทั้งสามอยู่ด้วยกัน ไม่ว่าจะทำอะไรก็มีความสุขไปหมด",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000512
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000512,
					"content": "Ararakalari ของ Arayama แข็งแกร่งมาก Nara ที่อ่อนแอไม่สามารถทำลายมันได้เลยนะ Aranimba วาดภาพเก่งมาก สิ่งต่าง ๆ ที่เขาวาด มีแต่สวย ๆ ทั้งนั้นเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000513
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000513,
					"content": "แต่ตอนนี้เหลือแค่ Araminali และ \"หีบสมบัติ\" ของ Araminali เท่านั้น...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000514
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000514,
					"content": "Araminali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731000515,
					"content": "ไม่เป็นไร Araminali มี \"หีบสมบัติ\" เยอะแยะ แม้จะไม่รู้ว่าทำไม Nara ถึงชอบเปิดหีบขนาดนั้นก็เถอะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000516
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000516,
					"content": "แต่ Araminali คือเจ้าของ \"หีบสมบัติ\" Nara ที่ชอบหีบสมบัติก็คงชอบ Araminali ด้วยใช่มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000517
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000517,
					"content": "แต่ Araminali ไม่มี \"หีบ\" มากกว่านี้แล้ว อืม... เห็นที \"หีบ\" คงต้องท้องว่างไปสักพักแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000518
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000518,
					"content": "#แม้ว่าหลังจากนี้ \"หีบสมบัติ\" ของ Araminali จะว่างเปล่า แต่ Nara {NICKNAME} ก็ต้องเป็นเพื่อนที่ดีกับ Aranara ต่อไปนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araminali"
				}
			]
		},
