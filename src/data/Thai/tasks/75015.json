					"nextDialogs": [
						750150407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150407,
					"content": "หลังจากทำปลาย่างเสร็จ ทุกคนก็กินกันอย่างอิ่มหนำสำราญ",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750150408
					]
				},
				{
					"id": 750150408,
					"content": "กี้!",
