					"nextDialogs": [
						750150405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150405,
					"content": "กี้กี้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150406
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150406,
					"content": "#เอ๋! ยังไม่ได้ย่างเลย ต้องรอให้ {NICKNAME} ทำเสร็จก่อนถึงจะกินได้นะ!",
