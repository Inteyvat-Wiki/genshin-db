			"dialogs": [
				{
					"id": 750150401,
					"content": "#ทะดาา! สมแล้วที่เป็น {NICKNAME} จับปลาลีลาเยอะตัวนี้ได้!",
					"roleType": "TALK_ROLE_NPC",
