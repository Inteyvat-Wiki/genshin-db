					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420305
					]
				},
				{
					"id": 120420305,
					"content": "การต่อสู้ในครั้งนี้ชวนให้คิดถึงจริง ๆ",
