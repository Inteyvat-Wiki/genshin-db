			"dialogs": [
				{
					"id": 706660101,
					"content": "ทำการดูเอลเลื่อนขั้น!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706660102
					]
				},
				{
					"id": 706660102,
					"content": "#เหมียว... \"โอ๊ะ จะมาทดสอบการเลื่อนขั้นผู้เล่นเหรอ... อื้ม {NICKNAME} มีคุณสมบัติในการท้าทายแล้ว งั้นฉันก็จะ...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660103
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706660103,
					"content": "\"จะให้ Shuyun เตรียมเซ็ตเกมสำหรับการเลื่อนขั้นละกัน แต่เธอต้องรับมือให้ดีนะ...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Prince"
				}
			]
		},
		{
			"id": 7066802,
			"completionStepIds": [
				7066804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7066804",
							"2"
						],
						"stepId": 7066804,
						"stateName": "QUEST_STATE_UNFINISHED"
