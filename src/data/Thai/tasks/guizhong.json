					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10150301,
					"content": "ไม่นึกเลยว่าจะใหญ่ขนาดนี้ สมกับเป็นสิ่งประดิษฐ์ของเหล่าเซียนที่ยังเหลืออยู่จริง ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150302,
					"content": "ว่าแต่ เจ้านี่มันใช้งานยังไงเนี่ย ต้องมีพละกำลังเท่าไรถึงจะสามารถควบคุมมันได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150303,
					"content": "ตอนนี้ใช้งานไม่ได้หรอก เพราะมันพังแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150304
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150304,
					"content": "พังแล้ว...ซะงั้น?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150305,
					"content": "มันผ่านลมผ่านฝนมานับพันปี ถึงแม้จะเป็นเครื่องกลของท่านเซียนก็เถอะ มันก็ยากที่จะคงอยู่ในสภาพเดิม",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150306
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150306,
					"content": "ถ้างั้นพวกเราทำไงดีล่ะ? คุณ Zhongli รีบใช้ทักษะ \"ความรู้ทางสังคมขั้นสูง\" ของคุณมาคิดหาวิธีเร็วเข้า!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150307,
					"content": "เอ ทำไมมันฟังดูเหมือนนอกจากฟังเสียงนกเสียงกาเล่นไปวัน ๆ แล้ว ฉันก็เป็นแค่เศรษฐีเพลย์บอยแค่นั้น?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150308
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150308,
					"content": "ขอคิดก่อนนะ...อืม ที่จริงแล้วจุดประสงค์แรกเริ่มในการสร้าง Guizhong Ballista คือเพื่อใช้รับมือกับสถานการณ์ต่าง ๆ เช่น การทำสงคราม ได้มีการเตรียมวัสดุสำรองไว้ด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150309
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150309,
					"content": "หากเดาไม่ผิด ที่ Tianheng Pass น่าจะสามารถหาห้องเตรียมศึกในอดีตได้อย่างแน่นอน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150310
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150310,
					"content": "เมื่อได้วัสดุที่เก็บไว้ในห้องเตรียมศึก ตราบใดที่เรารู้หลักการทำงานของ Guizhong Ballista ก็ไม่ยากที่จะซ่อมมันขึ้นมา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150311
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150311,
					"content": "พูดอย่างงี้...คุณ Zhongli รู้หลักการทำงานของมันงั้นเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150312,
					"content": "รู้นิดหน่อยน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150313
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150313,
					"content": "ขอเพียงแค่<color=#00E1FFFF>รวบรวมวัสดุมาได้ครบ</color> ก็สามารถลองซ่อมดูได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				}
			]
		},
