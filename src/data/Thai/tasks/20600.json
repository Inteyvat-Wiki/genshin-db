					"nextDialogs": [
						206000604
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000604,
					"content": "#งั้นฉันจะเล่าเรื่องเกี่ยวกับ Fatui ให้{F#เธอ}{M#นาย}ฟังซักหน่อยละกัน",
