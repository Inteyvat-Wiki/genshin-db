				],
				"points": []
			},
			"dialogs": [
				{
					"id": 206000301,
					"content": "เกี่ยวกับ \"เนตรมาร\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000302
					]
				},
				{
					"id": 206000302,
					"content": "#เหอะ... นี่{F#เธอ}{M#นาย}โง่หรือว่าแกล้งโง่กันแน่เนี่ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000303
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000303,
					"content": "#{F#เธอ}{M#นาย}ยังไม่ใช่สมาชิกอย่างเป็นทางการของ Fatui ซักหน่อย คิดจริง ๆ เหรอว่าอยู่ ๆ ก็จะถามฉันเกี่ยวกับ \"เนตรมาร\" แบบนั้นได้น่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000304
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000304,
					"content": "#{F#เธอ}{M#นาย}คิดว่าอยู่ ๆ ฉันก็จะเล่าให้{F#เธอ}{M#นาย}ฟังแบบหมดเปลือกเลยงั้นเหรอ? นี่ฉันไม่ใช่เจ้าอัศวินแห่ง Favonius สองคนที่เฝ้าประตูอยู่นั่นนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000305
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000305,
					"content": "#แต่ว่า... \"เนตรมาร\" น่ะเป็นถึงสมบัติของพวกเรา Fatui การที่จะเล่าให้{F#เธอ}{M#นาย}ฟังซักเล็กน้อย มันก็พอจะได้อยู่หรอกนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000306
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000306,
					"content": "#อย่างนี้ละกัน {F#เธอ}{M#นาย}ออกไปอีกรอบ เคยเห็นพวก \"กองโจรล่าสมบัติ\" นั่นแล้วใช่มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000307
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000307,
					"content": "ถึงจะเป็นพวกขโมยปลาซิวปลาสร้อย แต่เจ้าพวกนั้นก็ยังพอจะได้ของล้ำค่าบ้างในบางครั้งล่ะนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000308
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000308,
					"content": "#{F#เธอ}{M#นาย}ช่วยออกไปอีกรอบทีละกัน ไปเอาของมาจากเจ้า \"กองโจรล่าสมบัติ\" พวกนั้นที แล้วเพื่อเป็นการแลกเปลี่ยน ฉันจะเล่าเรื่องเกี่ยวกับ \"เนตรมาร\" ให้ฟังละกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000309,
						206000311
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000309,
					"content": "ฉันรู้แล้ว",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000310
					]
				},
				{
					"id": 206000310,
					"content": "#ฉันล่ะชอบคนพูดง่าย ๆ ตรงไปตรงมาอย่างนี้จริง ๆ งั้น{F#เธอ}{M#นาย}ก็รีบไปเถอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000311,
					"content": "นี่คุณจนขนาดนั้นเลยงั้นเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000312
					]
				},
				{
					"id": 206000312,
					"content": "#จน? ฮ่าฮ่าฮ่า {F#เธอ}{M#นาย}อย่าเอาพวกเราไปเทียบกับกองอัศวินแห่ง Favonius อย่างนั้นสิ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000313
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000313,
					"content": "ฉันก็แค่อยากรู้น่ะ ว่าเจ้ากองโจรล่าสมบัติพวกนั้นจะได้อะไรจาก Mondstadt ไปบ้าง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000314
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000314,
					"content": "แต่ว่า... หึหึ คิดว่าพวกมันก็คงจะได้แต่ของจิ๊บจ๊อยไร้สาระนั่นแหละนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
