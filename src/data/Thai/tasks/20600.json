				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Viktor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 206000201,
					"content": "เกี่ยวกับ Fatui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000202
					]
				},
				{
					"id": 206000202,
					"content": "โอ้โห ตรงดีจังเลยนะ เหอะ ๆ จะให้เล่าเรื่องมันก็ยาวอยู่นา...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000203
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000203,
					"content": "#แต่ว่า... {F#เธอ}{M#นาย}ยังไม่ได้เป็นสมาชิกอย่างเป็นทางการของ Fatui เพราะงั้นฉันคงจะบอกกับ{F#เธอ}{M#นาย}ไม่ได้หรอกนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000204
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000204,
					"content": "ฉันได้ยินมาว่ารอบ ๆ Mondstadt นี่น่ะมี Hilichurl อยู่เพียบเลย และบางส่วนก็รวมตัวกันกลายเป็นกลุ่ม",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000205
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000205,
					"content": "#{F#เธอ}{M#นาย}ช่วยออกไปเก็บ Trophy จาก \"Mitachurl\" มาให้ฉันทีสิ แล้วฉันจะเล่าเรื่องน่าสนใจให้ฟัง ตกลงมั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000206,
						206000209
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000206,
					"content": "ฉันรู้แล้ว",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000207
					]
				},
				{
					"id": 206000207,
					"content": "โอ้วว ตรงไปตรงมาดีเหลือเกินนะ ไม่คิดว่าจะเจอคนแบบนี้ที่ Mondstadt นี่นะเนี่ย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000208
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000208,
					"content": "#งั้นก็รีบหน่อยละกัน ฉันจะรอ{F#เธอ}{M#นาย}อยู่ที่นี่แหละ ยังไงรีบไปรีบกลับละกันนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000209,
					"content": "ที่อยากได้มีแค่นี้เหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000210
					]
				},
				{
					"id": 206000210,
					"content": "#หืม {F#เธอ}{M#นาย}ว่ามันง่ายไปงั้นเหรอ? ขอทีเถอะ ถ้ามอนสเตอร์ที่ร้ายกว่านี้แล้ว{F#เธอ}{M#นาย}จะจัดการได้จริง ๆ งั้นเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000211
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000211,
					"content": "รีบไปรีบมาละกัน ฉันจะรออยู่ที่นี่ละกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000212
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000212,
					"content": "เห้อ... ขืนช้ากว่านี้อีกหน่อย ฉันได้เผลอหลับเพราะลมที่พัดนี่แน่ ๆ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
		{
			"id": 2060003,
