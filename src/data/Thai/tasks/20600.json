						206000402
					]
				},
				{
					"id": 206000402,
					"content": "หืม อยากจะถามฉันเกี่ยวกับท่าน Tsaritsa งั้นเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000403
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000403,
					"content": "#อย่าบอกนะว่าเป็นเพราะท่าน Tsaritsa {F#เธอ}{M#นาย}ถึงคิดที่จะเข้าร่วมกับ Fatui น่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000404
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000404,
					"content": "#เหอะ ฉันไม่ได้จะว่า{F#เธอ}{M#นาย}นะ แต่ยังไงช่วยส่องกระจกดูตัวเองหน่อยมั้ย?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000405
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000405,
					"content": "#ยังไงก็ตาม ข้อมูลเกี่ยวกับท่าน Tsaritsa น่ะ ยิ่งเป็นไปไม่ได้เลยที่ฉันจะบอกให้{F#เธอ}{M#นาย}ฟัง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000406
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000406,
					"content": "#{F#เธอ}{M#นาย}ออกไปอีกรอบสิ ไปเอาของกลับมาจาก Ruin Guard ซะ อยู่ ๆ ฉันก็อยากจะได้มาเก็บไว้เล่น ๆ น่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000407,
						206000409
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000407,
					"content": "ฉันรู้แล้ว",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000408
					]
				},
				{
					"id": 206000408,
					"content": "โอ้ งั้นก็รีบไปเถอะ ฉันจะรออยู่ที่นี่แหละ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000409,
					"content": "คุณจะเอามันไปทำอะไรน่ะ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000410
					]
				},
				{
					"id": 206000410,
					"content": "#อ๋า? เก็บของแบบนั้นไม่ได้งั้นเหรอ? ทำไมกัน หรือ{F#เธอ}{M#นาย}เป็นเหมือนพวก Mondstadt ขี้ป๊อดพวกนั้น?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000411
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000411,
					"content": "เหอะ สำหรับ Fatui น่ะ ก็ง่ายเหมือนกระดิกนิ้วแค่นั้นแหละ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000412
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000412,
					"content": "#แต่ว่า เห้อ... ลมนี่มันพัดซะจนฉันอยากจะนอน ไม่มีอารมณ์ไปทำอะไรหรอก เพราะงั้นยังไง{F#เธอ}{M#นาย}ช่วยเป็นธุระไปจัดการเรื่องนี้ให้ทีนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
