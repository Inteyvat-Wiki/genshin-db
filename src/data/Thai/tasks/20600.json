			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Viktor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 206000101,
					"content": "#ทางนี้ นักเดินทาง ฉันคอยสังเกต{F#เธอ}{M#นาย}มาได้ซักพักแล้วล่ะนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000102
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000102,
					"content": "มีเรื่องอะไรงั้นเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000103
					]
				},
				{
					"id": 206000103,
					"content": "#ทำไมอยู่ ๆ ถึงทำเสียงระแวงอย่างนั้นล่ะ ฉันอุตส่าห์มีเรื่องดีมาบอกกับ{F#เธอ}{M#นาย}ทั้งที",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000104
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000104,
					"content": "#เป็นไงล่ะ {F#เธอ}{M#นาย}สนใจจะมาเข้าร่วมกับ Fatui มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000105
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000105,
					"content": "เหอะ ไม่มีทางซะหรอก! เนอะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000106,
						206000109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 206000106,
					"content": "ขอฉันคิดดูก่อนนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000107
					]
				},
				{
					"id": 206000107,
					"content": "เห้! เรื่องอย่างนี้เธอก็ยังจะเอาไปคิดดูอีกเหรอ มันต้องปฏิเสธทันทีเลยไม่ใช่เหรอ!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 206000108,
					"content": "แววตาไม่เลวเลยนี่ ถ้าอยากจะประสบความสำเร็จล่ะก็ ไม่มีที่ไหนที่จะดีไปกว่า Fatui อีกแล้วล่ะนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000111
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000111,
					"content": "#อื๋อ ดูท่าทาง{F#เธอ}{M#นาย}อยากจะถามอะไรงั้นสิ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000109,
					"content": "ที่นี่มัน Mondstadt นะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000110
					]
				},
				{
					"id": 206000110,
					"content": "Mondstadt แล้วไงล่ะ? พวกเรา Fatui น่ะก็มีมาจากทั่วทั้งทวีปนั่นแหละ ทั้งยุติธรรมและเท่าเทียม พวกกองอัศวินน่ะทำอะไรไม่ได้หรอก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000111
					],
					"speakerTitle": "Viktor"
				}
			]
		},
		{
			"id": 2060002,
			"completionStepIds": [
				2060002
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
