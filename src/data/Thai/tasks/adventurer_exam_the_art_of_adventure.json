					"Anna"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200201001,
					"content": "นักเดินทาง เธอกลับมาแล้วเหรอ เป็นยังไงบ้าง? ถ่ายภาพได้ครบมั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201002
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200201002,
					"content": "ถ่ายครบทั้งหมดแล้วล่ะ แล้วก็เก็บกลับมาด้วย",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200201003
					]
				},
				{
					"id": 200201003,
					"content": "ว้าว! ทำไมเธอถึงถ่ายได้เร็วขนาดนี้ล่ะ... นี่ก็คือนักผจญภัยที่มากประสบการณ์งั้นเหรอ? สุดยอดเลย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201004
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200201004,
					"content": "ขอบคุณมากนะ นักเดินทาง! อืม...เอางี้แล้วกัน เพื่อเป็นการขอบคุณเธอ ฉันจะลงมือทำอาหารอร่อย ๆ ให้เธอด้วยตัวเองเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201005
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200201005,
					"content": "เป็นไง ไม่เลวเลยใช่มั้ยล่ะ ลองชิมดูสิ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201006
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200201006,
					"content": "ฉันจะกลับไปเขียนบันทึกต่อล่ะนะ อืม...ถ้าเป็นพืชพวกนี้ล่ะก็",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201007
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200201007,
					"content": "ฉันคงต้องไปถาม Jack ว่าเขารู้วิธีทำตัวอย่างพืชรึเปล่า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201008
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200201008,
					"content": "ดอก Cecilia ไม่เอามาทำตัวอย่างแล้ว เอาไปปักในแจกันดีกว่า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				}
			]
		},
