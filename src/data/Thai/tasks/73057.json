				"points": []
			},
			"dialogs": [
				{
					"id": 730570701,
					"content": "มีความทรงจำอะไรอยู่ในนั้นเหรอ? พวกเธอเจออะไรบ้างมั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570702
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570702,
					"content": "เหมือนว่าเจ้าของสมุดบันทึกนี้จะรู้จักเธอนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570703
					]
				},
				{
					"id": 730570703,
					"content": "งั้นเหรอ... ฉันจำไม่ได้แล้วล่ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570704
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570704,
					"content": "เขาบอกว่า... เขามองไม่เห็นเธอแล้ว คงเป็นเพราะเขาโตขึ้นแล้วสินะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570705,
					"content": "อืม... การโตขึ้นนี่มีปัญหามากมายเลยเนอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570706,
					"content": "จริงสิ เขายังบอกในสมุดบันทึกอีกว่า... ดอกไม้ดอกนี้เขาเก็บไว้ให้เธอน่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570707,
					"content": "อ่ะนี่",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570708
					]
				},
				{
					"id": 730570708,
					"content": "เอ๋...? ดอกไม้นี้สำคัญมากเลยนะ! ทำไมเธอถึง... ทำไมเขาถึงมีมันได้ล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570709
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570709,
					"content": "ดอกแบบเดียวกันนี้ จริง ๆ แล้วเธอก็เคยให้พวกเรานะ... แค่เธอจำไม่ได้แล้วเท่านั้นเอง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570710,
					"content": "งั้นเหรอ... ฉันเป็นเพื่อนกับพวกเธอใหม่ได้นะ แต่ว่า... ถ้าเป็นเขา แม้แต่หน้าของเขาฉันยังจำไม่ได้เลยน่ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570711
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570711,
					"content": "มะ ไม่เป็นไร... ไม่ต้องเสียใจไปนะ พวกเรายังมีดอกไม้นี้อยู่ มันจะช่วยฟื้นความทรงจำให้เธอได้เพิ่มอีกแน่ ๆ เลยล่ะ ใช่มั้ยล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570712,
					"content": "อื้อ เจ้าตัวขาวบินได้พูดถูกแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570713
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570713,
					"content": "ฉันจะเอาดอกไม้นี้กลับไป Mawtiyima น่าจะรู้วิธีปลุกเธอให้ตื่นขึ้นมาได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570714
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570714,
					"content": "#อ๊ะ... Nara {NICKNAME} กับเจ้าตัวขาวบินได้ ฉันจะกลับไปหา Aranaga แล้วปลูกเธอ ฟังเพลงของเธอ ถ้าหากพวกเธอทั้งสองว่างก็มาด้วยกันสิ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570715
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570715,
					"content": "อืออือ ได้อยู่แล้วล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
