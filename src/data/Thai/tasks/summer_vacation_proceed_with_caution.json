					"Klee"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400110101,
					"content": "อื้อออ... อากาศดีจังเลยน้าา ยังไม่อยากตื่นเลย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110102,
					"content": "อรุณสวัสดิ์! ว้าววว พวกเธอแต่งตัวอะไรกันเนี่ย?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110103,
					"content": "ฮี่ฮี่ พวกเราดูเป็นยังไงบ้าง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110104
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110104,
					"content": "พวกเราเปลี่ยนเป็นชุดหน้าร้อนแล้วล่ะ! ถึงแม้ว่าพวกเราจะไม่ได้มาที่นี่เพื่อเที่ยว... แต่ไม่ว่ายังไงก็ไม่อยากจะพลาดโอกาส ที่จะได้เพลิดเพลินกับฤดูร้อนที่ริมชายหาดอย่างนี้ล่ะนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110105
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110105,
					"content": "มะ... ไม่แปลกใช่มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110106
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110106,
					"content": "เสื้อผ้าที่หรูหราและบางเบาแบบนี้ ไม่เหมาะกับฉันจริง ๆ ด้วย... อะแฮ่ม! ขอโทษที",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110107,
						400110108
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110107,
					"content": "ไม่ใช่อย่างนั้นเลยสักนิด",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110109
					]
				},
				{
					"id": 400110109,
					"content": "งั้นเหรอ... ขอบคุณนะ นักเดินทาง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110110
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110110,
					"content": "ว่าแต่การที่หัวหน้ากอง Jean ตั้งใจพกเอาเสื้อผ้าหน้าร้อนมาด้วยเนี่ย คาดไม่ถึงจริง ๆ เลยน้าา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110111,
					"content": "ไม่ ๆ ด้วยนิสัยของพี่แล้วน่ะ ไม่มีทางเตรียมเอามาเองหรอกนะ ฉันกับคุณ Lisa เลือกมาให้เธอต่างหากล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110112
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110112,
					"content": "พูดโพล่งออกมาว่า \"พี่\" แล้วแฮะ... แถมเจ้าตัวยังไม่รู้ตัวอีกด้วย Barbara หลงไปกับฤดูร้อนเรียบร้อยแล้ว!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110113,
					"content": "เสื้อผ้าหน้าร้อน... เรื่องมันยาวน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110114
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110114,
					"content": "นึกว่ากระเป๋าที่ Lisa ให้มาจะเป็นของสำหรับเอาไว้ใช้ยามฉุกเฉินซะอีก คิดไม่ถึงเลย ว่าข้างในจะกลายเป็นเสื้อผ้าสำหรับหน้าร้อนซะงั้น...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110115
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110115,
					"content": "แม้แต่เครื่องประดับก็ยังเอามาซะครบเลย สมแล้วที่เป็นคุณ Lisa",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110116,
					"content": "ทุกคนในกองอัศวินอยากให้ฉันหยุดพักผ่อนอยู่ตลอด... ดูท่าทางฉันคงจะกดดันตัวเองมากเกินไปสินะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110117
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110117,
					"content": "ทุกคนมาที่นี่เร็วเข้า!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110118
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110118,
					"content": "เสียง Klee นี่หน่า!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110119
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110119,
					"content": "มีของแปลก ๆ ด้วยล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110120
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110120,
					"content": "เกิดอะไรขึ้นเหรอ? ของแปลก ๆ หมายความว่าอะไร?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110121,
					"content": "ดูที่ทะเลสิ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110122
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110122,
					"content": "มีของแปลก ๆ ลอยอยู่ด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110123
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110123,
					"content": "อุปกรณ์ที่ดูยาวนั่น น่าจะเป็นทุ่นนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110124
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110124,
					"content": "แต่เมื่อวานตอนที่อยู่บนเรือ ดูเหมือนเราจะไม่เห็นอุปกรณ์นี่นะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110125
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110125,
					"content": "จะต้องเป็น Dodo-King วางไว้แน่ ๆ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110126
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110126,
					"content": "อุปกรณ์แปลก ๆ ปรากฏขึ้นในชั่วข้ามคืน จะต้องมีอะไรผิดปกติแน่ ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110127,
					"content": "เขาไม่มาหา Klee เลย เขาไม่ยอมรับ Klee งั้นเหรอ...หรือว่า....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110128
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110128,
					"content": "หรือเขาจะรอให้ Klee ไปหา?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110129
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110129,
					"content": "ทำไมจู่ ๆ ถึงมีทุ่นโผล่ขึ้นมาได้นะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110130
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110130,
					"content": "เข้าไปดูใกล้ ๆ เดี๋ยวก็รู้เอง",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110131
					]
				},
				{
					"id": 400110131,
					"content": "จริงด้วย เอาแต่อยู่บนฝั่งแล้วคาดเดาไปต่าง ๆ นานา แบบนี้ แก้ไขปัญหาอะไรไม่ได้หรอกนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110132,
					"content": "จะดีเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110133
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110133,
					"content": "เข้าไปดูเพื่อยืนยันให้แน่ใจกันดีกว่า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110134
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110134,
