					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721640101,
					"content": "เมี้ยว... เจ้ากล่องนี้มีประโยชน์จริง ๆ เลย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640102,
					"content": "ท่านนั่นเอง กล่องโยนเหรียญขอพรพวกนั้นใช้งานได้ไม่เลวเลยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640103
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640103,
					"content": "หลังจากที่ท่านซ่อมมันเสร็จไม่นาน ก็มีมนุษย์ชุดเขียวสองคนเข้ามาที่ศาลเจ้า เมี้ยว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640104
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640104,
					"content": "ไม่เพียงแต่ใส่เงินเข้าไปในกล่องเท่านั้น พวกมนุษย์ชุดเขียวตัวสูงยังตื่นเต้นมากเมื่อได้ยินข้าน้อยพูด พวกมนุษย์นี่ช่างแปลกประหลาดเสียจริง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640105
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640105,
					"content": "กล่องโยนเหรียญขอพรช่างดีเหลือเกิน ถ้ามีเพิ่มอีกสักใบ ผู้คนก็น่าจะแวะเวียนมาเพิ่มขึ้น?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640106
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640106,
					"content": "ไม่ใช่แบบนั้นหรอก...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640107
					]
				},
				{
					"id": 721640107,
					"content": "เป็นอย่างนั้นเองเหรอ เรื่องราวของพวกมนุษย์ นี่ช่างซับซ้อนเสียจริง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640108
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640108,
					"content": "เรื่องนี้ นะ น่าจะเกี่ยวกับสภาพแวดล้อมของศาลเจ้าด้วยนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721640109,
					"content": "ศาลเจ้าของข้าน้อยเป็นยังไงเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640110,
						721640111
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640110,
					"content": "ดูรกนิดหน่อยน่ะ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640112
					]
				},
				{
					"id": 721640112,
					"content": "เมี้ยว อย่างนั้นเองเหรอ? แต่ว่าเจ้าตัวน้อยพวกนั้นชอบเล่นกับกองใบไม้ร่วงนี่นา...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640113
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640113,
					"content": "เมี้ยว ลองคิดดูอย่างถี่ถ้วนแล้ว Hibiki ก็เคยใช้ไม้แหลม ๆ รวบรวมเศษใบไม้เข้ามารวมกัน ในเมื่อ Hibiki ทำเช่นนั้น ก็น่าจะถูกต้องแล้วนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640114,
						721640115
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640114,
					"content": "ต้องทำความสะอาดตรงไหนล่ะ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640116
					]
				},
				{
					"id": 721640116,
					"content": "ข้าน้อยจะเข้าใจถึงความซับซ้อนของสิ่งที่ท่านและมนุษย์คนอื่น ๆ ทำได้อย่างไรกัน เมี้ยว... ถ้าเป็น Hibiki ล่ะก็...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640117
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640117,
					"content": "ยามที่ตะวันยังไม่โผล่พ้นฟ้า Hibiki จะจับไม้ยาว ๆ ลากไปลากมาบนพื้น ข้าน้อยเองก็ชอบวิ่งไล่ตามเจ้าไม้นั่น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640118
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640118,
					"content": "แต่ในตอนนี้ข้าน้อยเป็นถึงรักษาการณ์หัวหน้ามิโกะ จะทำกิริยาเช่นนั้นคงไม่เหมาะสม เพราะข้าน้อยไม่เหมือนเจ้าตัวน้อยพวกนั้นน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640119
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640119,
					"content": "แต่ว่า Hibiki ก็จะใช้น้ำเทลงบนพื้นเช่นกัน แต่น้ำมักจะทำให้สิ่งของพังเสียหายน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640120
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640120,
					"content": "บางครั้ง Domeki ก็มาด้วย จากนั้นใช้ใบมีดเหล็กสองใบตัดตรงนี้และตรงนั้น! แล้วใบไม้และกิ่งไม้ร่วงหล่นลงมา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640121,
						721640123
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640121,
					"content": "Domeki ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640122
					]
				},
				{
					"id": 721640122,
					"content": "เป็นมนุษย์ตัวใหญ่เสียงดังที่ชอบมาเล่นกับ Hibiki",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640125
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640125,
					"content": "เมี้ยว! ทุกครั้งเขาจะตัดกิ่งที่ข้าน้อยชอบทิ้ง เจ้านั่นช่างน่ารังเกียจ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640126
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640126,
					"content": "ดูเหมือน... จะเป็นการกวาดทำความสะอาด หรือไม่ก็การจัดระเบียบจริง ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721640127,
					"content": "กวาดพื้น สาดน้ำ แล้วยังมีการตัดแต่งกิ่งไม้ด้วย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721640128,
					"content": "เป็นงานที่คุ้นเคยทั้งนั้นเลยนะ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640129
					]
				},
				{
					"id": 721640129,
					"content": "นี่คือการทำความสะอาดอย่างนั้นเหรอ? ข้าน้อยเข้าใจแล้วล่ะ อย่างนั้นต้องรบกวนท่านด้วยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640130
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640130,
					"content": "เมี้ยว ไม่ต้องตัดนั่นตัดนี่นะ ข้าน้อยชอบกิ่งไม้ที่มีอยู่ในตอนนี้มาก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640131
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640131,
					"content": "แค่กวาดใบไม้ ล้างน้ำก็พอแล้วล่ะ ท่านเข้าใจใช่มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640132,
						721640133
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640132,
					"content": "ให้พวกเราจัดการเอง",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640144
					]
				},
				{
					"id": 721640144,
					"content": "เมี้ยว เมี้ยว งานนี้ Hibiki มอบหมายให้กับข้าน้อยไว้ จะต้องมีข้าน้อยจึงจะทำงานที่สำคัญได้สำเร็จ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640133,
					"content": "อ่อ แล้ว Hibiki คือ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640134
					]
				},
				{
					"id": 721640134,
					"content": "Hibiki ก็คือ Hibiki ไงเล่า เป็นหัวหน้ามิโกะของศาลเจ้า Asase",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640135
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640135,
					"content": "งั้นชื่อของเธอคือ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640136
					]
				},
				{
					"id": 721640136,
					"content": "ข้าน้อยชื่อ Neko ชื่อนี้ Hibiki เป็นผู้ตั้งให้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640137
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640137,
					"content": "โดยปกติแล้ว Hibiki จะออกมารับแขกของศาลเจ้า ข้าน้อยไม่ต้องดูแลศาลเจ้า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640138
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640138,
					"content": "แต่ก่อนข้าน้อยไม่มีชื่อ และไม่ต้องดำรงตำแหน่งรักษาการณ์หัวหน้า อยากจะนอนก็นอน อยากไปเล่นกับผู้ใดก็ออกไปเล่น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640139
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640139,
					"content": "Hibiki บอกว่า เพราะข้าน้อยชอบนอนก็เลยเรียกข้าน้อยว่า Neko",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640140
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640140,
					"content": "ในตอนนี้ Hibiki ไม่อยู่ ที่ศาลเจ้าเลยไม่มีหัวหน้า ดังนั้นข้าน้อยจึงต้องเป็นรักษาการณ์หัวหน้าน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640141
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640141,
					"content": "ก่อนที่ Hibiki จะกลับมา ข้าน้อยต้องทำให้ศาลเจ้านี้ให้ดีและคึกคักขึ้น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640142
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640142,
					"content": "...เมี้ยว! ถ้าเช่นนั้นพอเธอกลับมา ข้าน้อยก็จะได้นอนในอ้อมกอดของ Hibiki ไม่ต้องรอเธอซ่อมกล่องโยนเหรียญขอพร และก็ไม่ต้องรอเธอทำกวาดใบไม้แล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640143
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640143,
					"content": "เรื่องนี้ต้องรบกวนท่านแล้วล่ะ ข้าน้อยจะรีบไปไล่แมลงที่แอบเข้าไปในศาลเจ้าออกไป",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640144
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640123,
					"content": "ตัดตรงนั้นตัดตรงนี้เหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640124
					]
				},
				{
					"id": 721640124,
					"content": "อ่า คงจะตัดแต่งกิ่งไม้ละมั้ง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721640115,
					"content": "จะต้องทำอะไรบ้างล่ะ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640116
					]
				},
				{
					"id": 721640111,
					"content": "น่าจะต้องปัดกวาดเช็ดถูสักหน่อย...",
