			"dialogs": [
				{
					"id": 722250101,
					"content": "เจ็บจัง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250102
					],
					"speakerTitle": "Ku"
				},
				{
					"id": 722250102,
					"content": "#พี่ {NICKNAME}, Paimon มาได้เวลาพอดีเลยล่ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250103
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250103,
					"content": "เกิดอะไรขึ้นงั้นเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250104
					]
				},
				{
					"id": 722250104,
					"content": "เท้าแพลงน่ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250105
					],
					"speakerTitle": "Ku"
				},
				{
					"id": 722250105,
					"content": "พี่ Ku ได้รับบาดเจ็บอีกแล้วล่ะ ช่วยเอาของไปถวายที่คอนให้หน่อยได้มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250106,
						722250108
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250106,
					"content": "ฉันคิดไว้แล้วล่ะว่าต้องเกิดเรื่องแบบนี้ขึ้น...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250107
					]
				},
				{
					"id": 722250107,
					"content": "ไม่ต้องกังวลไป งั้นก็ปล่อยให้พวกเราจัดการละกัน!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722250109,
					"content": "ขอบคุณมาก ๆ เลย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250110
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250110,
					"content": "ใช่แล้วล่ะ Ruu นายเองก็มีสัมผัสที่ไวต่อธาตุไม่ใช่เหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722250111,
					"content": "ทำไมนายไม่ไปถวายของให้คอนด้วยตัวเองล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722250112,
					"content": "เอ่อ... ผมเคยลองทำหลาย ๆ อย่างในพิธีกรรมครั้งก่อน แต่ผลลัพธ์ที่ออกมาไม่ค่อยดีเท่าไหร่น่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250113,
						722250115,
						722250116
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250113,
					"content": "ทำไมล่ะ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250114
					]
				},
				{
					"id": 722250114,
					"content": "ผมเองก็ไม่รู้เหมือนกัน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250117
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250117,
					"content": "ช่วยไม่ได้ล่ะนะ ถ้าอย่างนั้นเรื่องคอนนั่นปล่อยให้เป็นหน้าที่ของพวกเราละกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722250115,
					"content": "ถ้างั้นให้ฉันจัดการเอง",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250117
					]
				},
				{
					"id": 722250116,
					"content": "นายก็ช่วยดูแลคนที่บาดเจ็บอยู่ด้วยนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250117
					]
				},
				{
					"id": 722250108,
					"content": "ให้ฉันจัดการเอง",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250109
					]
				}
			]
		},
