						80040403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040403,
					"content": "อืม เรียกว่าอะไรนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040404,
					"content": "รูปปั้นมลทิน",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040405
					]
				},
				{
					"id": 80040405,
					"content": "ใช่ ๆ! อันนั้นแหละ ทั้งแปลก ทั้งกลับหัวกลับหาง แถมยังให้ความรู้สึกน่าขนลุกอีกด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040406,
					"content": "ถ้าอย่างนั้น หรือว่าข้างล่างของ Chasm จะเกี่ยวข้องกับ Abyss Order จริง ๆ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040407,
					"content": "เราต้องหาวิธีไปตรวจสอบดูสักหน่อย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040408,
					"content": "...อ๊ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040409
