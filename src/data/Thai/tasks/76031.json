			"dialogs": [
				{
					"id": 760310101,
					"content": "Columbina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310102,
					"content": "คร่อก... ฟี้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310103
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760310103,
					"content": "#อ๊ะ! เธอกำลังนอนกลางวันอยู่นี่นา {NICKNAME} ไว้เราค่อยมาใหม่ละกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310104,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310105
					],
					"speakerTitle": "แบดเจอร์สุดเก๋"
				},
				{
					"id": 760310105,
					"content": "เฮ้! อย่าไปตรงนั้น!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310106,
					"content": "...โอ๊ย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310107
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760310107,
					"content": "เจ็บจัง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310108
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760310108,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310109
					],
					"speakerTitle": "แบดเจอร์สุดเก๋"
				},
				{
					"id": 760310109,
					"content": "เผลอลื่นงั้นเหรอ? เอ่อ ไม่เป็นไร ฉันโอเค หืม? พวกเธอก็มาด้วยเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310110
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760310110,
					"content": "\"เทพจันทรา\" ก็ถูกสัตว์วิ่งชนจนเจ็บได้เหมือนกันเหรอเนี่ย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310111,
					"content": "แรงจันทราผันที่เปล่งออกมาจากสัตว์ไม่มีเจตนาร้าย ฉันก็เลยไม่ได้สนใจ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310112
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760310112,
					"content": "เป็นอะไรไป? ทำไมแกถึงกลัวขนาดนั้น?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310113
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760310113,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310114
					],
					"speakerTitle": "แบดเจอร์สุดเก๋"
				},
				{
					"id": 760310114,
					"content": "อืม ๆ เข้าใจแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310115
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760310115,
					"content": "เธอฟังพวกมันรู้เรื่องด้วยเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310116,
					"content": "Nod-Krai คือที่ที่พระจันทร์ขึ้น สัตว์ที่เติบโตภายใต้แรงจันทราผัน จะถือว่าเป็น \"ผู้ติดตามของเทพจันทรา\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310117
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760310117,
					"content": "แล้วมันพูดว่าอะไรเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310118,
					"content": "มีมอนสเตอร์ปรากฏตัวขึ้นในที่ที่มันอาศัยอยู่ ตอนแรกมันคิดจะไปหา Lauma... แต่ระหว่างทางถูกมอนสเตอร์ไล่ตามมาจนถึงแถวนี้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310119
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760310119,
					"content": "อ๋อ มิน่าถึงได้กลัวขนาดนั้น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310120,
					"content": "จะส่งมันกลับไปมั้ย?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760310121
					]
				},
				{
					"id": 760310121,
					"content": "อืม พามันไปหา Lauma เถอะ เธอจะจัดการเอง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310122
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760310122,
					"content": "โอเค ต้องออกไปข้างนอกอีกแล้วสินะ แต่ครั้งนี้เราจะไปหา \"ลูกหลานจันทราน้ำค้างแข็ง\" เธอต้องซ่อนตัวให้ดีนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
