				"points": []
			},
			"dialogs": [
				{
					"id": 726820201,
					"content": "ถึงแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820202
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820202,
					"content": "เพียงแค่ก้าวผ่านประตูบานใหญ่ที่ดูสุดแสนจะน่าสงสัยบานนี้ไป ก็สามารถเข้าสู่การประลองในครั้งนี้ได้แล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820203,
						726820204
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820203,
					"content": "น่าตื่นเต้นจังแฮะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820205
					]
				},
				{
					"id": 726820205,
					"content": "กฎในครั้งนี้น่าจะไม่ต่างจากครั้งที่แล้วเท่าไหร่ ทั้งมอนสเตอร์ นักผจญภัย และนักรบจากทั่วทุกมุมโลกที่กระหายในการต่อสู้ ต่างก็ต่อสู้กันอย่างเต็มที่บนเวทีประลอง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820206
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820206,
					"content": "ก็เหมือนกับก่อนหน้านี้ เธอสามารถเข้าร่วมการประลองกับคู่หูนักรบที่รักการต่อสู้เหมือนกันได้ เพราะคำว่า \"ร้อยใจ\" น่ะ หมายถึงว่าคนยิ่งเยอะยิ่งดีไงล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820207
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820207,
					"content": "ฉันตั้งตารอดูผลงานของเธอเลยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820208
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820208,
					"content": "ครั้งนี้เธอก็จะไม่เข้าร่วมงั้นเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820209
					]
				},
				{
					"id": 726820209,
					"content": "ฉันเหรอ? ฉันจะเข้าร่วมในฐานะผู้ชม เพื่อช่วยเชียร์เธอไงล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820210
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820210,
					"content": "ยังไงซะเป้าหมายของฉันก็คือการเขียนนิยายการต่อสู้ที่ดีที่สุดขึ้นมา ไม่ใช่การเป็นนักรบที่เปล่งรัศมีเหมือนดาวจรัสแสงอย่างเธอหรอกนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820211
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820211,
					"content": "เซ้นส์ของฉันบอกว่า เธอจะต้องเป็นดาวที่สว่างที่สุดในเวทีการประลองนี้อย่างแน่นอน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820212,
						726820213
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820212,
					"content": "ฉันจะพยายามเต็มที่",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820214
					]
				},
				{
					"id": 726820214,
					"content": "อื้ม คิดว่าครั้งนี้เธอก็น่าจะสามารถแสดงระบำดาบอันแสนตระการตาออกมาให้เห็นอีกล่ะนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820213,
					"content": "คอยดูละกัน",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820214
					]
				},
				{
					"id": 726820204,
					"content": "ยุ่งยากจัง",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820205
					]
				}
			]
		}
	]
}