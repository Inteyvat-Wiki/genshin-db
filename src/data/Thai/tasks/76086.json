			"dialogs": [
				{
					"id": 760540301,
					"content": "แบบนี้ใช่มั้ยนะ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540302
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540302,
					"content": "ขอฉันคิดก่อนนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540303
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540303,
					"content": "อืม...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540304
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540304,
					"content": "ดวงจันทร์... ดวงจันทร์...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540305
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540305,
					"content": "ตรงนี้ล่ะเป็นไง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540306
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540306,
					"content": "ครั้งนี้ฉันชนะแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540307
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540307,
					"content": "ดวงจันทร์สามดวงของฉันเรียงต่อกันแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540308
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540308,
					"content": "อืม ชนะแบบนี้นี่เอง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540309
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540309,
					"content": "อืม... พระจันทร์ลอยขึ้นและล่วงลับ ช่างยาวนานจริง ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540310
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540310,
					"content": "ดวงจันทร์ของเราต่างไม่มีใครยอมใครเลยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540311
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540311,
					"content": "นี่มัน... ใกล้จะเสมอกันแล้วรึเปล่า?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540312
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540312,
					"content": "ที่แท้เธอก็เป็นคนที่ชอบคิดให้รอบคอบ ก่อนตัดสินใจสินะ อืม ไม่เป็นไร เรามีเวลาอีกเยอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540313
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540313,
					"content": "ลืมวิธีวาง \"ดวงจันทร์\" ลงบน \"นภาราตรี\" แล้วเหรอ? ให้ฉันช่วยมั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540314
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540314,
					"content": "ไม่ชอบเกมนี้งั้นเหรอ? ฉันว่าก็สนุกดีนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540315
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540315,
					"content": "หืม? เธอกำลังจ้องฉันอยู่เหรอ? ฉันรู้สึกได้นะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540316
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540316,
					"content": "บนใบหน้าของฉัน... มีคำตอบเกี่ยวกับ \"ดวงจันทร์\" อยู่เหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540317
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540317,
					"content": "กระดานหมากอยู่ทางนั้นนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540318
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540318,
					"content": "อืม \"ดวงจันทร์\" ของเธอชนะแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540319
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540319,
					"content": "นภาราตรีผืนนี้เป็นของเธอแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540320
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540320,
					"content": "อ๊ะ... เผลอไปหน่อยเดียวเอง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540321
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540321,
					"content": "ใช้เวลาเล่นเกมกับ Columbina อย่างสนุกสนาน...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760540322
					]
				},
				{
					"id": 760540322,
					"content": "ขอบคุณนะ ฉันสนุกมากเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540323
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540323,
					"content": "ถ้าเป็นไปได้ คราวหน้าก็มาเล่นเป็นเพื่อนฉันอีกนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540324
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540324,
					"content": "ใช้สิ่งนี้ เป็นเครื่องยืนยันถึง \"สัญญา\" ระหว่างเรา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Damselette"
				}
			]
