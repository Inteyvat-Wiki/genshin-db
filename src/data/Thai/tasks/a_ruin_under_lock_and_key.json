			"dialogs": [
				{
					"id": 110210801,
					"content": "นายน่ะ ก็แค่พวกบ้าเงินเท่านั้นแหละ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210802
