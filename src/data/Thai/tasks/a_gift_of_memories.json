						],
						"pointId": 12536
					}
				]
			},
			"dialogs": [
				{
					"id": 765000101,
					"content": "#{NICKNAME}! รีบมาทางนี้เร็วเข้า! ฉันมีของดีมากจะให้เธอดู!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765000102,
					"content": "ท๊าดา...! ดูสิ นี่คือของดีที่ฉันใช้ความพยายามอย่างมาก กว่าจะหาได้จากตลาดที่วุ่นวายแห่งนี้เลยนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000103,
						765000104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765000103,
					"content": "กล่องถ่ายรูปอันนี้... ดูเก่ามากเลย",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765000106
					]
				},
				{
					"id": 765000106,
					"content": "ได้ยินคนขายลึกลับคนนั้นบอกว่า นี่เป็นกล่องถ่ายรูปที่คุณ Pierre Leblanc ช่างภาพชื่อดังแห่ง Fontaine เคยใช้เมื่อหลายสิบปีก่อนเลยนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765000107,
					"content": "ว่ากันว่า รูปที่เขาใช้กล่องถ่ายรูปเครื่องนี้ถ่าย ได้รับความนิยมทุกรูปเลย แถมยังถูกนำไปลงพาดหัวข่าวใน \"หนังสือพิมพ์ The Steambird\" บ่อย ๆ อีกด้วย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765000108,
					"content": "#ถ้า {NICKNAME} ได้ใช้กล่องถ่ายรูปดี ๆ แบบนี้ อาจจะถ่ายผลงานชิ้นเอกที่โด่งดังออกมาได้นะ! ไม่แน่อาจจะขายได้ราคาสูงลิ่วเลยด้วย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000109,
						765000112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765000109,
					"content": "กล่องถ่ายรูปนี้... คงไม่ใช่ถูก ๆ สินะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765000110
					]
				},
				{
					"id": 765000110,
					"content": "อะฮิฮิ ไม่เป็นไรหรอก! Paimon ก็แอบเก็บ \"เงินทุนฉุกเฉิน\" เอาไว้เหมือนกัน!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765000111,
					"content": "#ขอแค่ {NICKNAME} ชอบ Mora แค่นี้ไม่เท่าไหร่หรอก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000116,
						765000117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765000116,
					"content": "ขอบใจนะ Paimon ฉันชอบมากเลย",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765000118
					]
				},
				{
					"id": 765000118,
					"content": "ดีจัง เธอชอบก็ดีแล้ว! เราเพิ่งมาถึงประเทศใหม่กันพอดี ที่นี่จะต้องมีเรื่องสนุก ๆ ให้ถ่ายเยอะแยะแน่ ๆ เรามาถ่ายไว้ให้หมดเลยดีกว่า!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765000119,
					"content": "แถมฉันยังเตรียมอัลบั้มถ่ายรูปเล่มใหม่ไว้ให้แล้วด้วย ฉันใส่ใจมากเลยใช่มั้ยล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765000120,
					"content": "เอาล่ะ ๆ เราไปสำรวจสถานที่สนุก ๆ พวกนั้นกันเถอะ! ไปกันเลย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765000117,
					"content": "ฉันจะพยายามใช้มัน ถ่ายรูปออกมาให้ดีที่สุดเลย",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765000118
					]
				},
				{
					"id": 765000112,
					"content": "Paimon คงไม่ได้เจอกับพ่อค้าหน้าเลือดหรอกนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765000113
					]
				},
				{
					"id": 765000113,
					"content": "ไม่ต้องห่วง เพื่อกันพลาด ฉันฝากให้วิศวกรที่ไว้ใจได้ช่วยตรวจสอบให้แล้ว นี่เป็นรุ่นที่ผู้เชี่ยวชาญ Leblanc เคยใช้ในตอนนั้นจริง ๆ ไม่ผิดแน่!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765000114,
					"content": "อีกอย่าง ตอนที่วิศวกรแยกชิ้นส่วนออกมา ยังพบตราสัญลักษณ์ขนาดเล็กที่มีชื่อเขาอยู่ด้านในด้วย นี่เป็นหลักฐานเฉพาะเจาะจงที่หาไม่ได้แล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765000115,
					"content": "ฮึฮึ ในฐานะผู้นำทางของเธอแล้ว ฉันน่ะพึ่งพาได้มากเลยนะเนี่ย ช่วงเวลาสำคัญ ๆ ฉันจะไม่ทำให้เธอผิดหวังแน่นอน!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000116,
						765000117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765000104,
					"content": "Paimon จะเริ่มทำธุรกิจ ขายของโบราณแล้วเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765000105
					]
				},
				{
					"id": 765000105,
					"content": "ไม่ใช่ซะหน่อย! นี่เป็นของขวัญเซอร์ไพรส์ ที่ฉันตั้งใจเตรียมมาให้เธอโดยเฉพาะเลยนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000106
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}