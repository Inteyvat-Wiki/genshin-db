			"dialogs": [
				{
					"id": 730680201,
					"content": "#Nara {NICKNAME} กับ Paimon? Aranakula ตาม Arapandu ไปที่ Ashavan Realm และยังไม่กลับมากันเลย งั้นเราถือโอกาสนี้ไปกินเห็ดกันดีกว่า",
					"roleType": "TALK_ROLE_NPC",
