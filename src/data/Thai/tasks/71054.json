			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105413",
							"2"
						],
						"stepId": 7105413,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yanbo",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710540701,
					"content": "เยี่ยมยอดสุด ๆ ไปเลยล่ะ! ขอบคุณการช่วยเหลือของคุณนะ จริงสิ นี่คือรางวัลที่คุยกันไว้น่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540702
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540702,
					"content": "โอ้เย้! Mora เยอะแยะไปหมดเลย! เอ๋... คุณไปเปลี่ยนชุดมาตอนไหนกันล่ะเนี่ย...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540723
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710540723,
					"content": "ในตอนที่พวกคุณลงมือ... อะแฮ่ม ฉันหมายความว่า นั่นไม่สำคัญ... เพื่อเป็นการป้องกันไม่ให้พวกคุณเลือดร้อนและทำร้ายพวกเราโดยไม่ได้ตั้งใจอีกรอบ ก็เลยจำเป็นต้องเปลี่ยนชุดกลับมาเป็นแบบเดิมน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540703
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540703,
					"content": "กองทหาร Millelith จะขอบคุณสำหรับความช่วยเหลือของคุณเสมอไป ตามที่เราตกลงกันไว้ มองไปรอบ ๆ ดูสิว่ามีสิ่งของอะไรที่พวกคุณต้องการรึเปล่า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540704
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540704,
					"content": "เอ่อ... ฉันหมายถึง นอกเหนือจากของโจรที่พวกเรากำลังตรวจสอบน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540705,
						710540707
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540705,
					"content": "ยินดีกับคุณด้วยนะ ภารกิจสำเร็จอย่างสมบูรณ์แล้วล่ะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540706
					]
				},
				{
					"id": 710540706,
					"content": "ฮ่าฮ่า แน่นอน โชคดีที่พวกคุณเข้ามาให้การช่วยเหลือ พวกเราถึงทำสำเร็จได้อย่างราบรื่นแบบนี้น่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540709
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540709,
					"content": "อืม ความหมายของฉันก็คือ... ขอแค่คุณไม่คิดใช้ทางลัดเหมือนพวกหัวขโมยพวกนี้ พวกเราก็จะไม่ทำให้คุณต้องลำบากน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540710
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540710,
					"content": "ฮึ พวกเราไม่ใช่คนแบบนั้นสักหน่อย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710540711,
					"content": "ฮ่าฮ่า ก็จริงเนอะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540712
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540712,
					"content": "เฮ้อ จะว่าไปแล้ว คนที่ใช้พลังธาตุได้อย่างคุณ ไม่ว่าจะทำเรื่องดีหรือร้าย ต่างก็เป็นพลังที่ประมาทไม่ได้ทั้งนั้น...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540713
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540713,
					"content": "งานที่พวกเราต้องใช้เวลาหลายสัปดาห์ หรือไม่ก็หลายเดือนในการทำให้สำเร็จ แต่สำหรับพวกคุณมันอาจจะเป็นแค่เรื่องง่าย ๆ เท่านั้น... และถ้าใช้พลังธาตุในการทำเรื่องไม่ดีล่ะก็ คุณก็สามารถสร้างความเสียหายที่น่าสะพรึงกลัวได้โดยที่สูญเสียบางอย่างไปเพียงน้อยนิดเท่านั้น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540714
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540714,
					"content": "ดังนั้น ฉันเลยไม่รู้สึกว่าการไม่มี \"วิชั่น\" เป็นเรื่องเลวร้ายอะไรน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540715
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540715,
					"content": "ฉันเคยเห็นบางคนยอมใช้ชีวิตแลกกับกำลังที่เหนือมนุษย์ แต่ท้ายที่สุดแล้วก็เป็นเพียงแค่เครื่องมือหรือไม่ก็หุ่นเชิดของคนอื่นก็เท่านั้น คุณว่า แบบนี้มันคุ้มค่ากันมั้ยล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540716
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540716,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540717
					]
				},
				{
					"id": 710540717,
					"content": "บนโลกใบนี้ยังมีผู้คนที่ไร้ซึ่งพลังของวิชั่นอาศัยอยู่เป็นส่วนมาก และคนที่เข้าใจพวกเขาและปกป้องพวกเขาได้อย่างแท้จริง ก็คือคนธรรมดาเหมือนพวกเขานั่นแหละ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540718
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540718,
					"content": "ในฐานะคนธรรมดา การได้ทำหน้าที่ปกป้องคนส่วนใหญ่ ก็ถือว่าเป็นเกียรติของฉันน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540719
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540719,
					"content": "วันไหนที่ไม่มีใครได้รับวิชั่นอีกแล้ว หรือเซียนที่คอยคุ้มครองท่าเรือ Liyue สิ้นชีพไป... ฉันก็ไม่มีทางละทิ้งความรับผิดชอบเหล่านี้แน่นอน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540720
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540720,
					"content": "อ๊ะ ขอโทษด้วยนะ... พูดเองเออเองไร้สาระอยู่นานเลย คงจะเสียเวลาคุณไปมากแล้วสินะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540721
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540721,
					"content": "เอาล่ะ ฉันยังต้องตรวจสอบและลงทะเบียนของโจรที่ยึดมา คงไม่พูดคุยเล่นแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540722
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540722,
					"content": "ในนามตัวแทนของเพื่อนร่วมงาน ฉันขอขอบคุณอีกครั้งสำหรับการช่วยเหลือของคุณ ขอให้การเดินทางในภายภาคหน้าของคุณเป็นไปได้อย่างราบรื่น Millelith อันแข็งแกร่ง ผู้แสนหนักแน่นไม่หวั่นไหว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540707,
					"content": "ตอนนี้พวกเราก็ไม่ต้องติดคุกแล้วสินะ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540708
					]
				},
				{
					"id": 710540708,
					"content": "ใช่แล้วล่ะ พวกคุณช่วยกองทหาร Millelith... เอ่อ พวกคุณเป็นฮีโร่คนแรกที่ไขคดีลักลอบขนของเถื่อนครั้งใหญ่ด้วยความช่วยเหลือของกองทหาร Millelith พวกเราจะกล้าจับพวกคุณเข้าคุกได้ยังไงกัน?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540709
					],
					"speakerTitle": "Yanbo"
				}
			]
		},
