					"Liloupar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732790101,
					"content": "#อ๊ะ {NICKNAME} \"นายท่านแห่งญิน\" ผู้สูงส่ง ยินดีต้อนรับนะ กระผมล่ะตกใจจริง ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790102
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790102,
					"content": "ยอดเยี่ยม นี่ก็ทาสแห่งทะเลทรายอีกคน นายท่านของข้า... เฮ้อ ช่างมันเถอะ ท่านคงมีความคิดของท่านเอง ข้าจะเชื่อท่าน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790103
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790103,
					"content": "ไม่ทราบว่าท่านพอจะมีเวลาว่างอยู่บ้างมั้ย... กระผมรอคอยที่จะได้พบท่านดั่งเฝ้ารอดวงจันทร์ และหยาดฝน กระผมตั้งตารอการมาถึงของท่านมาโดยตลอด",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790104
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790104,
					"content": "ประจบโดยไร้สาเหตุ ย่อมมีเจตนาที่ไม่ดี สู้บอกมาตรง ๆ เสียจะดีกว่า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790105
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790105,
					"content": "เยี่ยมเลย ท่านญิน... กระผมมีเรื่องอยากขอร้องจริง ๆ นั่นแหละ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790106
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790106,
					"content": "ฮ่าฮ่า ก็ไม่ใช่เรื่องใหญ่อะไรหรอก... เหยี่ยวนักล่าของกระผม Tadhla... เธอน่าจะตกอยู่ในอันตราย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790107
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790107,
					"content": "เฮ้อ... ถ้าไม่ใช่ว่าขาของกระผมใช้การไม่ได้ดั่งใจ กระผมก็คงไม่คิดจะรบกวนท่าน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790108
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790108,
					"content": "ฉันเข้าใจล่ะ เพราะงั้นพวกเราจะไปช่วยเธอแล้ว คุณก็จะขอบคุณพวกเราด้วย Mora มากมาย จากนั้นพวกเราก็จะไปกินมื้อใหญ่ฉลองกัน! แบบนี้สินะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790109,
					"content": "เอ่อ... ใช่แล้ว ใช่แล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790110
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790110,
					"content": "ถ้าเป็นแบบนั้นก็ให้พวกเราจัดการเอง!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790111,
					"content": "เวลาแบบนี้ทีไร ตรรกะความคิดคล่องเลยนะ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790112
					]
				},
				{
					"id": 732790112,
					"content": "เฮ้อ... งั้นก็เอาตามนี้ก็ได้ เพื่อให้เจ้าตัวน้อยที่แสนละโมบผู้นี้ได้กินมื้อใหญ่สักมื้อ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790113
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790113,
					"content": "ขอบคุณเป็นอย่างสูง... งั้นเรื่องนี้ก็รบกวนท่านด้วยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790114
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790114,
					"content": "อ่า... จุดที่เธอปรากฏตัวครั้งสุดท้ายคือตรงนี้ เดี๋ยวกระผมจะทำเครื่องหมายเอาไว้ให้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790115
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790115,
					"content": "คนที่พวกท่านต้องตามหา Tadhla... เธอตัวสูงมาก ผิวออกสีแทน ไว้ผมยาวสีอ่อน ใช้ธนูเป็นอาวุธ... อืม ข้อมูลแค่นี้น่าจะเพียงพอแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790116
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790116,
					"content": "พวกท่านจำเอาไว้แล้วใช่มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790117
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790117,
					"content": "อื้ม... ผู้หญิงร่างสูง ผิวสีเข้ม ผมสีอ่อน ถือธนู! อิอิ ความจำฉันดีมากนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790118,
					"content": "อืม... ขอให้สายลมนำพาท่านข้ามผ่านทะเลทราย และแคล้วคลาดอันตรายทั้งปวง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790119
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790119,
					"content": "โอเค พวกเราไปละนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
