				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tadhla",
					"Liloupar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732790601,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790602
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790602,
					"content": "คือว่า... เธอคือ Tadhla ใช่มั้ย? พวกเรามาช่วยเธอแล้ว!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790603,
					"content": "หืม...? อืม",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790604
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790604,
					"content": "เธอปล่อยพวกเขาไปหมดเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790605,
						732790606
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790605,
					"content": "คนพวกนั้นทำอันตรายอะไรไม่ได้แล้ว",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790607
					]
				},
				{
					"id": 732790607,
					"content": "...พวกเขาจะกลับไปบอกคนอื่น ๆ จากนั้นพวกเขาที่เหลือก็จะรู้ว่าพวกเราอยู่ที่นี่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790608
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790608,
					"content": "เห็นไหม ผู้มีสติปัญญาต่างมีความคิดละม้ายคล้ายคลึง ข้าชอบหญิงสาวคนนี้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790609
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790609,
					"content": "เรื่องพวกนั้นไม่สำคัญหรอก! ถ้าแห่กันมาอีก พวกเราก็ซัดพวกเขาให้หมอบไปเลย! แต่ว่าเธอบาดเจ็บนี่นา... ให้พวกเราช่วยมั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790610,
					"content": "ฉันโอเค เดินไหว ยังสามารถหาที่ให้ตัวเองตายไปคนเดียวได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790611
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790611,
					"content": "อ้อ... งั้นก็ดีแล้วล่ะ เธอยังสามารถหาที่ให้ตัวเอง... เน้ ไม่ดีเลยสักนิด!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790612,
					"content": "ฉันล้อเล่นน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790613
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790613,
					"content": "ฮ่าฮ่า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790614
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790614,
					"content": "ข้าชอบอารมณ์ขันของนางนะ... มีก็เหมือนไม่มี",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790615
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790615,
					"content": "ขอบคุณพวกเธอนะ พวกเรากลับไปกันเถอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790616,
						732790618
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790616,
					"content": "เธอเดินสะดวกมั้ย?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790617
					]
				},
				{
					"id": 732790617,
					"content": "ไม่สะดวก แต่ก็ไม่จำเป็นต้องช่วยพยุง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790618,
					"content": "ไม่พักหน่อยเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790619
					]
				},
				{
					"id": 732790619,
					"content": "พัก...? ไม่ดีกว่า พวกเรายังไม่ได้สนิทกันขนาดนั้น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790620
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790620,
					"content": "แต่ข้าคิดว่าพวกเราลองทำความรู้จักกันได้นะ เจ้าว่าไง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790621
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790621,
					"content": "ขอบคุณ ไว้วันหลังเถอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790606,
					"content": "ไม่จำเป็นต้องตามไล่ฆ่า",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790607
					]
				}
			]
		},
		{
			"id": 7327907,
			"completionStepIds": [
				7327907
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
