			"dialogs": [
				{
					"id": 740430201,
					"content": "ประท้วง! ประท้วง! ประท้วงขอสิทธิ์ทำงาน!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430202,
