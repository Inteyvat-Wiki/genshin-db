			"dialogs": [
				{
					"id": 220340203,
					"content": "เจ้าพวกนี้ วิ่งเร็วชะมัดเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340204
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340204,
					"content": "พวกเขาน่าจะกลับไปแจ้งข่าวของพวกเรา แบบนี้เราก็บรรลุเป้าหมายของเราแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340205
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340205,
					"content": "เหนื่อยหน่อยนะนักเดินทาง รับค่าตอบแทนนี้ไว้ด้วยเถอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340206
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340206,
					"content": "ฉันจะกลับไปรายงานสถานการณ์ต่อท่าน Sango เดี๋ยวนี้ล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340207
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340207,
					"content": "ไม่รู้ว่าท่านประธานคิดอะไรออกรึยัง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				}
			]
		},
