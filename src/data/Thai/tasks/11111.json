				}
			]
		},
		{
			"id": 1111105,
			"completionStepIds": [
				1111105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1111105",
							"2"
						],
						"stepId": 1111105,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hu Tao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111110501,
					"content": "เป็นไงบ้าง? รู้สึกได้รึเปล่าว่าคำสาปถูกถอนไปแล้ว?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110502
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111110502,
					"content": "ว้าว สบายอย่างที่ไม่เคยรู้สึกมาก่อนเลย! ฉันหายแล้ว!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110503
					],
					"speakerTitle": "Luocheng"
				},
				{
					"id": 111110503,
					"content": "ขอบคุณมากเลยนะ แล้วก็ขอบคุณนักเดินทางด้วย! ถ้าไม่ได้พวกเธอช่วยไว้ คำสาปนี้อาจจะเอาชีวิตฉันไปเลยก็ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110504
					],
					"speakerTitle": "Luocheng"
				},
				{
					"id": 111110504,
					"content": "งั้น ตอนนี้ฉันก็บอกเธอได้แล้วล่ะว่า ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110505
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111110505,
					"content": "ทะ-ดาาา! เธอถูกหลอกแล้วล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110506
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111110506,
					"content": "หา? วะ ว่าไงนะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110507
					],
					"speakerTitle": "Luocheng"
				},
				{
					"id": 111110507,
					"content": "เจ้าของสิ่งนี้ คนธรรมดาอาจไม่รู้จัก แต่ความจริงแล้วมันคือ Ley Line Monolith ธรรมดานี่แหละ มันดึงดูดมอนสเตอร์ได้ง่ายมากเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110508
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111110508,
					"content": "มอนสเตอร์พวกนั้นก็เป็นมอนสเตอร์จริง ๆ ไม่ใช่มอนสเตอร์ที่กลายร่างมาจากคำสาป",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110509
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111110509,
					"content": "แปลกมากใช่มั้ยล่ะ ฉันไม่ได้ทำอะไรเลย แต่เธอกลับบอกว่าหายแล้วซะงั้น มันหมายความว่ายังไงเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110510
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111110510,
					"content": "นะ นี่มัน... หรือว่าฉันไม่ได้โดนสาป?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110511
					],
					"speakerTitle": "Luocheng"
				},
				{
					"id": 111110511,
					"content": "งั้นทำไมฉันถึงป่วยได้ล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110512
					],
					"speakerTitle": "Luocheng"
				},
				{
					"id": 111110512,
					"content": "เป็นหวัด, กินอาหารบูด หรือทำให้ตัวเองกลัว แล้วแต่จะเดา... แต่ฉันเดาว่าเป็นข้อสุดท้าย เป็นการป่วยที่ฉันเจอจนชินแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110513
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111110513,
					"content": "นึกไม่ถึงว่าจะเป็นแบบนี้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110514
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111110514,
					"content": "ฉันก็นึกไม่ถึงเหมือนกัน แต่... ยังไงก็ขอบใจนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110515
					],
					"speakerTitle": "Luocheng"
				},
				{
					"id": 111110515,
					"content": "ไม่เป็นไรหรอก ทีหลังก็อย่ากลัวจนสติแตกอีกล่ะ คราวหน้าฉันอาจหาวิธีรักษาที่เหมาะสมไม่ได้แล้วก็ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110516
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111110516,
					"content": "ชีวิตคนเรามันสั้นนะ เพราะงั้นตอนยังมีชีวิตอยู่ ก็ใช้ชีวิตอย่างมีความสุขจะดีกว่า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110517
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111110517,
					"content": "คำพูดนี้ทำไมฟังดู... แปลก ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110518
					],
					"speakerTitle": "Luocheng"
				},
				{
					"id": 111110518,
					"content": "งะ งั้นฉันไปแล้วนะ ขอโทษด้วยที่ทำให้วุ่นวาย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110519
					],
					"speakerTitle": "Luocheng"
				},
				{
					"id": 111110519,
					"content": "ดูแล้วคงไม่ใช่ฝีมือพี่ Big G สินะ งั้นฉันก็ค่อยสบายใจหน่อย แต่ว่าถ้าพี่ Big G ยังไม่ไปจากโลกมนุษย์ ก็ห้ามเขาสร้างความวุ่นวายไม่ได้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110520
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111110520,
					"content": "เรื่องนี้จัดการเรียบร้อยแล้ว งั้นเรากลับไปตามหาพี่ Big G ต่อได้แล้วใช่มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110521
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111110521,
					"content": "ฉันคิดว่า ไม่จำเป็นหรอก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110522
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111110522,
					"content": "เพราะเขามาหาเราแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110523
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111110523,
					"content": "พะ พี่ Big G——?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110524
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111110524,
					"content": "อะ เอิ่ม... ขอโทษที่รบกวนเธอ แล้วก็ทุกคนด้วยนะ ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110525
					],
					"speakerTitle": "Big G"
				},
				{
					"id": 111110525,
					"content": "เขาเนี่ยนะ Big G? ทำไมยังเป็นเด็กอยู่เลยล่ะ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111110526,
					"content": "เพราะเขาเป็นวิญญาณไงล่ะ แน่นอนว่าต้องคงสภาพเหมือนตอนที่เขาจากโลกนี้ไป",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110527
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111110527,
					"content": "หืม ดูตัวไม่สมกับชื่อ Big G เลยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110528
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111110528,
					"content": "พาเขากลับไปคุยที่โถงแห่งการเกิดใหม่ Wangsheng เถอะ ยังมีเรื่องอีกมากที่ต้องจัดการ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hu Tao"
				}
			]
		},
