			"dialogs": [
				{
					"id": 741430201,
					"content": "เด็ก ๆ! พะ...พวกเธอ... ฉัน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430202
					],
					"speakerTitle": "Earnshaw"
				},
				{
					"id": 741430202,
					"content": "เอ๋ คุณตา Earnshaw เป็นอะไรไป? ทำไมหอบแบบนี้ล่ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741430203,
					"content": "Lanoire... Lanoire... ถูก Hilichurl จับตัวไป!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430204
					],
					"speakerTitle": "Earnshaw"
				},
				{
					"id": 741430204,
					"content": "เอ๋? เป็นไปได้ยังไง!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741430205,
					"content": "มันมุ่งหน้าไปทางนั้นแล้ว! ฉันจะไปตามคนมาช่วย ขอร้องล่ะ พวกเธอช่วยไปดูสถานการณ์หน่อยได้มั้ย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430206
					],
					"speakerTitle": "Earnshaw"
				},
				{
					"id": 741430206,
					"content": "เข้าใจแล้ว! พวกเรารีบไปกันเถอะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
