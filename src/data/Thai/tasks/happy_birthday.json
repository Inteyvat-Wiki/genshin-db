				]
			},
			"dialogs": [
				{
					"id": 741430401,
					"content": "พวกคุณนี่เอง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430402
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741430402,
					"content": "อะไรกัน! ที่แท้ก็ Caterpillar เองเหรอ! ให้ตายสิ ฉันก็เป็นห่วงแทบแย่...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741430403,
					"content": "#โอ้! พี่ {NICKNAME} กับพี่ Paimon นี่นา! ดีใจจัง วันนี้คนที่หนูชอบที่สุดมากันหมดเลย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430404
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430404,
					"content": "คุณตาทำ \"เค้กวันเกิด\" อันใหญ่เบิ้มและหวานละมุนไว้ให้หนูด้วย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430405
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430405,
					"content": "อ๋อ! วันนี้เป็นวันเกิดของ Lanoire สินะ สุขสันต์วันเกิดนะ! แล้ว... เค้กยังเหลืออยู่มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741430406,
					"content": "เอ่อ... พวกเรากินหมดแล้วล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430407
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430407,
					"content": "อะไรกัน ขี้งก!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741430408,
					"content": "Caterpillar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741430409
					]
				},
				{
					"id": 741430409,
					"content": "เธอโอเคมั้ย?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741430410
					]
				},
				{
					"id": 741430410,
					"content": "ไม่ต้องห่วงฉัน วันนี้เป็นวันที่มีความสุขนะ อย่าคุยเรื่องน่าเบื่อเลยดีกว่า...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430411
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741430411,
					"content": "#ยังไงก็ขอบคุณนะ {NICKNAME}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430412
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741430412,
					"content": "พวกเธอพูดเรื่องอะไรกันอยู่เนี่ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741430413,
					"content": "ฮ่าฮ่า ไม่มีอะไร ฉันแค่รู้สึกว่า ครั้งก่อนที่เพื่อน ๆ ของ \"ทีมเด็กน้อย\" รวมตัวกัน... ผ่านมาตั้งนานมาก ๆ แล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430414
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741430414,
					"content": "แต่ทำไมพี่ Cater ถึงต้องพาหนูมาที่นี่ด้วยล่ะ? แปลกจัง แถมตอนที่คุณตา Earnshaw เห็นพี่ Cater ก็ดูกลัวมากเลย แม้แต่ผู้กล้า เจ้าชาย และเจ้าหญิงก็กลัวเหมือนกัน!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430415
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430415,
					"content": "ทั้ง ๆ ที่ทุกครั้งเวลาคุณตาฟังหนูเล่าเรื่องพี่ Cater เขาก็คิดอยากจะเชิญพี่ Cater มาเป็นแขกที่บ้านตลอดเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430416
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430416,
					"content": "เอ่อ เพราะรูปลักษณ์ของ Caterpillar ตอนนี้ละมั้ง... Caterpillar ทำไมเธอถึงไม่ยอมกลายเป็นมนุษย์เหมือนแต่ก่อนล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741430417,
					"content": "ไม่ใช่ไม่ยอม แต่ว่า...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430418
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741430418,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741430419,
					"content": "รูปลักษณ์ตอนนี้ของพี่ Cater ก็ดีแล้วนี่นา! เมื่อกี้หนูนั่งบนไหล่พี่ Cater ก็สามารถเก็บ Bulle Fruit ได้เลย พี่ Cater วิ่งเร็วอย่างกับลมแน่ะ เจ๋งสุดยอดไปเลย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430420
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430420,
					"content": "Lanoire เธอต้องจำไว้ให้ดีนะ ถ้าเธอเห็น \"คน\" ที่หน้าตาเหมือนกับฉัน ห้ามเข้าใกล้เด็ดขาดนะ ต้องรีบหนีไปให้ไกล คนพวกนี้ล้วนแต่อันตรายทั้งนั้น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430421
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741430421,
					"content": "จริงเหรอ? แต่ว่าพี่ Cater ไม่ใช่คนไม่ดีอะไรนี่นา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430422
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430422,
					"content": "Lanoire รับปากฉัน สัญญากับฉันก่อน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430423
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741430423,
					"content": "เดิมทีคิดว่า Caterpillar จะใช้ \"ลูกไม้\" ของตัวเองเพื่อสร้างผลกระทบต่อ Lanoire\\nแต่สุดท้ายเขากลับไม่ได้ทำแบบนั้น เขาเพียงแค่รอคำตอบของ Lanoire อย่างจริงจัง",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741430424
					]
				},
				{
					"id": 741430424,
					"content": "แต่... อื้ม ก็ได้ หนูรับปากพี่ Cater",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430425
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430425,
					"content": "แต่... แต่ว่าถ้าอย่างนั้น ต่อไปหนูจะรู้ได้ไงล่ะว่าคนไหนคือพี่ Cater?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430426
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430426,
					"content": "จริงด้วย! พี่ Cater พอออกจากป้อมปราการ Meropide หนูถึงได้รู้ว่า โลกภายนอกกว้างใหญ่ขนาดไหน ทุก ๆ วันหนูจะเดินไปตามเส้นทางที่ต่างกัน แต่จนถึงตอนนี้หนูก็ยังไม่เจอกำแพงเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430427
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430427,
					"content": "เวลามีแดดจะร้อนมาก พอกลางคืนที่ไม่มีแดดกลับเย็นสุด ๆ จริงสิ! ตกดึกทีไรก็จะมีลมพัดไปทางริมทะเลสาบด้วย มันเย็นสบายเหมือนกับพัดลมเลย นี่เป็นเพราะอะไรเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430428
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430428,
					"content": "นอกจากนั้นนะ เวลาที่ผู้กล้านอนอยู่ข้าง ๆ คุณปู่และหนู เขามักจะเงยหน้าขึ้นมองเราตลอดเลย และเวลาเจ้าชายหลับ บางครั้งขาหลังของเขาก็เตะสิ่งของต่าง ๆ เป็นอะไรที่น่าสนใจมากเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430429
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430429,
					"content": "แล้วก็ ๆ หนูค้นพบว่า เวลาที่ไม่ใส่รองเท้าเดินบนหญ้า หญ้าจะโผล่พ้นหว่างนิ้วเท้าเรา แถมยังเจ็บหน่อย ๆ ด้วย ตอนที่อ่านจากในหนังสือ หนูก็นึกว่าหญ้าจะนุ่มนิ่มซะอีก!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430430
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430430,
					"content": "แล้วก็ ไม่คิดว่าข้างนอกนี้จะมีดอกไม้ที่คุณลุง Estienne มอบให้หนูมากมายขนาดนี้ แถมดอกไม้พวกนี้ยังมีรากที่สามารถปักหลักลงดินได้อย่างมั่นคงอีกด้วย นี่มันเพราะอะไรกันนะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430431
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430431,
					"content": "โลกใบนี้ทั้งกว้างใหญ่และแปลกมากเลย มีแสงที่หลากสีสันอยู่เต็มไปหมด หนูมีเรื่องอยากเล่าให้พี่ Cater เยอะมาก ๆ และก็อยากให้พี่ Cater รับฟังหนูด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430432
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430432,
					"content": "แต่ว่าหนูจะหาพี่ Cater เจอได้ยังไงเหรอ? อย่างกับลูกศิษย์ของพ่อมดเลย ที่เขาพยายามตามหาปลาน้อยมาโดยตลอด",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430433
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430433,
					"content": "เธอจำเรื่องนั้นได้ด้วยเหรอ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430434
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741430434,
					"content": "หนูไม่มีวันลืมอยู่แล้ว! หนูยังรอให้พี่ Cater กลับมาเล่าเรื่องนี้ให้จบตลอดเลยนะ แล้วสุดท้ายลูกศิษย์คนนั้นได้เจอปลาน้อยมั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430435
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430435,
					"content": "เรื่องนี้ หลังจากผ่านมานานแสนนาน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430436
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741430436,
					"content": "ลูกศิษย์พ่อมดผู้โง่เขลาก็รวบรวมความกล้า และบอกลาพ่อมดผู้ยิ่งใหญ่ จากนั้นก็ไปจากเวิร์กชอป และออกเดินทางตามหาปลาน้อย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430437
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741430437,
					"content": "แต่เขาไม่เคยเห็นทะเลอันกว้างใหญ่มาก่อน และไม่รู้ว่าบ้านเกิดที่ปลาน้อยพูดถึงคือที่ไหน ดังนั้นเขาจึงทำได้แค่ถามไปตลอดทาง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430438
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741430438,
					"content": "เขาถามกอหญ้าริมแม่น้ำ กอหญ้าฟังเรื่องราวของเขาแล้วก็ก้มหัวเราะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430439
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741430439,
					"content": "\"สิ่งที่เธอตามหาคือทะเล\" กอหญ้าพูด \"ที่นั่นกว้างใหญ่กว่าแม่น้ำเป็นร้อยเท่าพันเท่า เป็นที่ที่แม่น้ำไหลรินไป\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430440
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741430440,
					"content": "เขาไล่ตามทิศทางที่แม่น้ำไหลจนไปถึงทะเลใหญ่ แต่ทะเลนั้นกลับกว้างขวาง และเขาก็ไม่รู้จะไปทางไหนดี",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430441
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741430441,
					"content": "ดังนั้นเขาจึงถามนกนางนวลสีม่วงทองที่กำลังพักอยู่ที่ท่าเรือนั้น หลังจากได้ยินเรื่องราวของเขาแล้ว นกนางนวลสีม่วงทองก็อ้าปากกว้างด้วยความตกใจ จนมันฝรั่งทอดที่กินเข้าไปตกลงบนพื้น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430442
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741430442,
					"content": "\"เพื่อน เรื่องนี้เป็นไปไม่ได้หรอก\" นกนางนวลตอบ \"จะถามหาปลาน้อยแสนธรรมดา ในทะเลอันกว้างใหญ่ไพศาล ไม่เคยมีใครทำเรื่องแบบนี้กันหรอก อีกอย่างนะ บางทีมันอาจจะ...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430443
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741430443,
					"content": "ลูกศิษย์พ่อมดใช้ขนมปังอุดปากของนกนางนวลไว้ โดยไม่สนใจมันและเพื่อนร่วมทางของมันที่โหวกเหวกโวยวายอีก และเขายังคงสอบถามและตามหาไปตามแนวชายฝั่ง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430444
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741430444,
					"content": "เพราะเขาเป็นศิษย์ที่โง่เขลา จึงรู้แค่วิธีค้นหาที่โง่เง่าที่สุดเท่านั้น เขาใช้เวลานานมากในการเรียนรู้การดำน้ำ และว่ายน้ำไปในทะเลที่ไกลขึ้นและลึกขึ้น จนครั้งแล้วครั้งเล่า...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430445
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741430445,
					"content": "หนูเดาว่าสุดท้ายเขาต้องหาเจอแน่! ตราบใดที่มีความปรารถนามากพอ และไม่ล้มเลิกความพยายาม ยังไงก็ต้องทำความปรารถนาได้สำเร็จแน่! คุณตาเคยบอกหนูไว้แบบนี้น่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430446
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430446,
					"content": "ก็เธอชอบเรื่องที่มีตอนจบสวยงามนี่นา... เอาเถอะ คุณตา Earnshaw พูดถูกแล้วล่ะ ถึงแม้ลูกศิษย์คนนั้นจะโง่เขลา แต่สุดท้ายเขาก็อาศัยวิธีที่โง่เง่าที่สุด ตามหาปลาน้อยตัวนั้นจนพบ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430447
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741430447,
					"content": "ตอนที่เจอมัน ทั้งสองต่างว่ายอยู่ในน้ำพร้อมกับฝูงของตัวเอง และฝูงปลาก็เปลี่ยนรูปร่างไปอย่างอิสระ แต่ท่ามกลางปลามากมาย ลูกศิษย์คนนั้นก็จำมันได้ในทันที",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430448
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741430448,
					"content": "\"ในที่สุดก็เจอนายสักที...\" ลูกศิษย์บรรลุความปรารถนาของตัวเองแล้ว แต่กลับไม่ได้ตื่นเต้นเหมือนอย่างที่จินตนาการไว้ กลับกันแล้ว เขาทำอะไรไม่ถูกซะมากกว่า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430449
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741430449,
					"content": "ฝูงปลารายล้อมเข้ามาด้วยความสงสัย เพื่อเร่งให้เขาเล่าที่มาที่ไปของเรื่องราว เขาอธิบายทุกอย่างที่เกิดขึ้นก่อนหน้านี้ด้วยความความเขลา และสุดท้าย ก็เป่าฟองสบู่เป็นเส้นยาวในน้ำด้วยความโล่งใจ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430450
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741430450,
					"content": "\"ฉันต้องขอโทษสองครั้ง\" ลูกศิษย์พูดขึ้น \"หนึ่ง คือในอดีตที่นายขอความช่วยเหลือจากฉัน แต่ฉันไม่มีความกล้าที่จะมอบให้นายได้ และสองคือตอนนี้ ที่ฉันมาหานายอย่างกะทันหัน...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430451
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741430451,
					"content": "\"พอได้เจอนายฉันถึงได้รู้ว่า ตัวเองเป็นคนเห็นแก่ตัวมากแค่ไหน... ฉันคิดเพียงแค่ว่า ฉันต้องขอโทษนายต่อหน้าเท่านั้น ฉันถึงจะสามารถให้อภัยตัวเองในอดีตได้\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430452
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741430452,
					"content": "\"นี่มันเกี่ยวอะไรกัน?\" คำตอบของปลาน้อยเหนือความคาดหมายของศิษย์ \"ดูสิ ในอดีตนายไม่สามารถช่วยฉันได้ แต่ตอนนี้ฉันก็กลับบ้านเกิดได้แล้ว และได้อยู่ข้าง ๆ ครอบครัว\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430453
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741430453,
					"content": "\"ฉันไม่ได้บาดเจ็บเพราะเรื่องนี้ เพราะงั้นนายไม่ต้องขอให้ใครยกโทษให้หรอก\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430454
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741430454,
					"content": "\"นายใช้เวลาและความพยายามตั้งมากมาย เพื่อเรื่องเล็กน้อยแค่นี้ ไม่รู้ว่าจะบอกว่านายเป็นคนซื่อสัตย์หรือโง่เง่ากันแน่ แต่ถึงจะโง่ยังไง พวกเราก็ไม่รังเกียจที่จะเป็นเพื่อนกับคนโง่หรอกนะ...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430455
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741430455,
					"content": "ว้าว! หมายความว่า สุดท้ายพวกเขาก็กลายเป็นเพื่อนกันใช่มั้ย? แล้วเรื่องราวต่อจากนั้นล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430456
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430456,
					"content": "เรื่องราวต่อจากนั้น? พวกเขาเอ่อ กลายเป็นเพื่อนที่ดีที่สุดของกันและกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430457
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741430457,
					"content": "เอ๋ ไม่มีแล้วเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430458
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741430458,
					"content": "แสดงว่าเรื่องนี้ก็จบลงแค่นี้เหรอ พี่ Cater...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430459
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430459,
					"content": "อื้ม เรื่องราวของฉันจบแล้ว มันคงไม่น่าสนใจหรอก ถ้าเรื่องราวดำเนินมาถึงจุดที่เหมาะสมแล้ว แต่กลับยังไม่จบ ฮีโร่ก็จะกลายเป็นมังกรชั่วร้ายแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430460
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741430460,
					"content": "ฉันเองก็เคยได้ยินเรื่องราวที่ไม่ยอมจบสักทีเหมือนกัน สุดท้ายตอนจบย่ำแย่มาก ทุกคนในเรื่องล้วนแต่เศร้าโศก จนกลายเป็นเรื่องเลวร้ายไป",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430461
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741430461,
					"content": "แต่ Lanoire ที่รัก \"เรื่องราวการผจญภัยในชีวิตยังคงดำเนินต่อไป\" สุขสันต์วันเกิดนะ สักวันหนึ่ง เธอต้องมาเล่าเรื่องของตัวเองให้ฉันฟังนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430462
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741430462,
					"content": "อ่า อื้ม... หนูรับปากพี่ Cater",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430463
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430463,
					"content": "หนูจะต้องไปหาพี่ แล้วเล่าเรื่องราวต่าง ๆ ให้พี่ฟังเยอะ ๆ เลย แล้วก็ ๆ หนูจะทำเค้กวันเกิดอันใหญ่เบ้อเริ่มและอร่อยสุดยอดให้พี่กินด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430464
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430464,
					"content": "ฮ่าฮ่าฮ่า เค้กวันเกิดไม่ต้องหรอก ฉันไม่รู้วันเกิดของตัวเองด้วยซ้ำ แค่รู้วันที่ตัวเองตื่นมาเท่านั้น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430465
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741430465,
					"content": "...ขอบคุณนะ Lanoire เพราะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caterpillar"
				}
			]
		},
