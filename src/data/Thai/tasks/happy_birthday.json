			"dialogs": [
				{
					"id": 741430501,
					"content": "Lanoire! Lanoire! ไม่เป็นไรใช่มั้ย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430502
					],
					"speakerTitle": "Earnshaw"
				},
				{
					"id": 741430502,
					"content": "คุณตา! หนู...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430503
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430503,
					"content": "อ๊ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741430504,
					"content": "#เหอะ ๆ เยี่ยมไปเลย ขอบคุณพวกเธอมากนะ {NICKNAME} กับ Paimon เพราะพวกเธอเลย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430505,
						741430506
					],
					"speakerTitle": "Earnshaw"
				},
				{
					"id": 741430505,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741430507
					]
				},
				{
					"id": 741430507,
					"content": "แต่... ที่จริงเมื่อกี้คือ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741430508,
					"content": "Paimon",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741430509
					]
				},
				{
					"id": 741430509,
					"content": "...เอ่อ แต่ว่า... อื้ม ฉันเข้าใจแล้วล่ะ! แหม โชคดีนะเนี่ยที่ Lanoire ไม่เป็นไร โล่งอกไปที!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430510
					],
					"speakerTitle": "Paimon"
				},
				{
