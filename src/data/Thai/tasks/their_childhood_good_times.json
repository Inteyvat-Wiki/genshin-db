							"2400603",
							"2"
						],
						"stepId": 2400603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aurele"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240060301,
					"content": "ไม่ได้... ประโยคนี้ไม่ค่อยสมเหตุสมผลเท่าไหร่ ต้องมองจากมุมอื่น...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060302
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240060302,
					"content": "แบบนี้... ไม่ถูก แบบนี้ก็ยังไม่ใช่แฮะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060303
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240060303,
					"content": "เอ๋? ฉันโดนหาเจอแล้วเหรอ งั้นฉันจะไปที่จุดรวมตัวเดี๋ยวนี้แหละ",
					"roleType": "TALK_ROLE_NPC",
