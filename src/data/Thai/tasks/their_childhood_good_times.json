					"Verut"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240060201,
					"content": "#โดนหาเจออีกแล้วเหรอเนี่ย {M#พี่ชาย}{F#พี่สาว}เก่งกว่าฉันจริง ๆ ด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060202
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060202,
					"content": "งั้นฉันไปจุดรวมตัวกันก่อนละกัน หวังว่าพี่ชายของฉันจะไม่ได้โดนหาเจอไปก่อนแล้วนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060203
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060203,
					"content": "ทำไมถึงหวังอย่างงั้นล่ะ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060204
					]
				},
				{
					"id": 240060204,
					"content": "พี่ฉันเคยบอกว่า ทุกครั้งที่เล่นซ่อนแอบ เขาก็จะมีไอเดียใหม่ ๆ มากมาย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060205
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060205,
					"content": "ไอเดียพวกนั้นมันเยอะมากเลยล่ะ เขาต้องนั่งจดอยู่บนพื้นนานมากเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060206
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060206,
					"content": "Lovi บอกฉันว่า ไอเดียพวกนั้นมันสำคัญมาก อย่าไปรบกวนเขาเด็ดขาด",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060207
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060207,
					"content": "เพราะงั้นตอนที่ฉันกับ Lovi เล่นซ่อนแอบกับพี่ ถ้าถึงตาที่เขาต้องไปซ่อน เราก็จะจงใจยื้อเวลาไว้ รอให้เขาจดเสร็จค่อยไปตามหาเขา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060208
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060208,
					"content": "แต่ว่า... พอถึงตาที่พี่ฉันต้องเป็นคนตามหา พวกเราก็ต้องรอนานมากเลยล่ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verut"
				}
			]
		},
		{
			"id": 2400603,
			"completionStepIds": [
				2400603
			],
