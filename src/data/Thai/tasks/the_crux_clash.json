					"nextDialogs": [
						20010922
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010922,
					"content": "ด้วยพรสวรรค์ของเธอ บวกกับคำแนะนำเล็กน้อย ๆ จากฉัน เธอก็น่าจะเอาชนะคู่ต่อสู้ได้แล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010923
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
