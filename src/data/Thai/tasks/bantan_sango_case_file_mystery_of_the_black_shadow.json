				"points": []
			},
			"dialogs": [
				{
					"id": 400310101,
					"content": "นักเดินทาง เธอมาพอดีเลย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 400310102,
					"content": "การจั่วหัวที่คุ้นเคยนี้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310103,
						400310104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310103,
					"content": "ประโยคต่อไปจะต้องเป็น...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310105
					]
				},
				{
					"id": 400310105,
					"content": "สมกับที่เป็นนักผจญภัยมือฉมัง ก็อย่างที่เธอพูด มีคำขอที่เหมาะกับเธอน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310106
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 400310106,
					"content": "ทางสำนักงานนักสืบ Bantan Sango กำลังต้องการคน และอยากให้เธอช่วยตรวจสอบ \"คดีสิ่งมีชีวิตตัวน้อยจำนวนมากที่หายไปอย่างประหลาด\" น่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 400310107,
					"content": "เอ๋? แค่ตามหาสิ่งมีชีวิตตัวน้อยน่ะเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310108,
					"content": "#จุ๊ ๆ เรื่องง่าย ๆ แค่นี้ ต้องให้ {NICKNAME} ออกโรงเลยเรอะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310109,
						400310110,
						400310111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310109,
					"content": "ไม่เป็นไร ส่งอาหารฉันก็เคยทำนะ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310113
					]
				},
				{
					"id": 400310113,
					"content": "ว่าแต่ \"Bantan Sango\" คือสำนักงานนักสืบที่ไขคดีต่าง ๆ ไม่ใช่เหรอ? ทำไมถึงมอบหมายคำขอให้นักผจญภัยล่ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310114,
					"content": "คืออย่างนี้ คุณ Sango อยากให้นักผจญภัยที่มากประสบการณ์ร่วมออกปฏิบัติการไปกับคุณ Ryuuji น่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310115
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 400310115,
					"content": "อีกอย่าง ฉันดูก่อนนะ...คำขอของคุณ Sango บอกไว้ว่า:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310116
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 400310116,
					"content": "\"คดีในครั้งนี้มีสัตว์เลี้ยงของผู้คนมากมายหายไป ดังนั้นเราจึงได้รับคำขอมากมายพร้อม ๆ กัน ถ้าสามารถแก้ไขได้ คงจะได้รับค่าตอบแทนมหาศาลเลยทีเดียว\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310117
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 400310117,
					"content": "#มหาศาล...! อืมมม อย่างนั้นเหรอ {NICKNAME} ฉันว่า...สิ่งมีชีวิตตัวน้อยที่ไม่สามารถกลับมาหาเจ้าของได้นี่น่าสงสารมากเลยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310118,
					"content": "อีกอย่างไม่ว่าคำขอจะเล็กหรือใหญ่ แต่ก็สามารถทำให้เราเติบโตและพัฒนาได้ทั้งนั้น ใช่มั้ยล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310119,
					"content": "Paimon นี่เข้าใจง่ายจังนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310120
					]
				},
				{
					"id": 400310120,
					"content": "เอาเป็นว่า เราไปตามหา Sango กันเถอะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310110,
					"content": "ไม่เป็นไร ฉันเคยซ่อมรถด้วยนะ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310113
					]
				},
				{
					"id": 400310111,
					"content": "ไม่เป็นไร ฉันยังเคยกำจัด Stormterror ด้วย...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310112
					]
				},
				{
					"id": 400310112,
					"content": "กำจัด Stormterror ถือเป็น \"เรื่องง่าย ๆ \" ด้วยเหรอ? สมแล้วที่เป็นเธอ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310113
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 400310104,
					"content": "มีคำขอใหม่เหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310105
					]
				}
			]
		},
		{
