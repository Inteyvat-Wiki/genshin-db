				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jinwu",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710700101,
					"content": "อ้าว มาแล้วเหรอ ขอบคุณพวกเธอมากนะที่ช่วยเคลียร์เส้นทางให้ Zhiqiong ช่วยเปิดทางให้พวกเรา และยังช่วยเราอีกเยอะเลย พวกเราซาบซึ้งใจมากจริง ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700102,
						710700113,
						710700122
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700102,
					"content": "เกี่ยวกับแคมป์...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710700103
					]
				},
				{
					"id": 710700103,
					"content": "เป็นไงบ้าง ไม่เลวใช่มั้ยล่ะ? งานถนัดฉันเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700104
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700104,
					"content": "ฉันเรียนรู้สิ่งเหล่านี้มาจากพ่อตั้งแต่ตอนที่อายุสิบขวบกว่า... วิธีสร้างแคมป์ วิธีสร้างโคมไฟคริสตัล หรือวิธีการเก็บรักษาเครื่องมือขุด...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700105
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700105,
					"content": "เรียนไปเรียนมา พ่อก็แก่ชราแล้ว... ต่อมาสายตาของพ่อก็เริ่มใช้งานไม่ได้ ฉันจึงต้องดูแลอุปกรณ์ความปลอดภัยทั้งหมดที่อยู่ในเหมือง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700106
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700106,
					"content": "และหลังจากนั้น ก็อย่างที่คุณเห็น... ตัวฉันเองก็ไม่ใช่เด็กอีกต่อไปแล้ว วันเวลาที่เหลือก็ไม่มีอะไรให้พูดถึงหรอก... มีสามี และสามีก็จากไป จากนั้นก็มีลูกสาว แล้วลูกสาวก็ไปเรียนที่ Sumeru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700107
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700107,
					"content": "บางครั้งผู้ชายในเหมืองก็จากเราไปเร็ว ฉันจึงต้องคอยดูแลเด็ก ๆ ที่ถูกทิ้งไว้... ฉันเลยมักจะพกขนมติดตัวไว้อยู่เสมอ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700108
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700108,
					"content": "ดังนั้น... ในความทรงจำของฉัน เด็ก ๆ ที่มักมีกลิ่นติดตัวหอมหวาน จะคอยตั้งตารอขนมน้ำตาลหรือไม่ก็ก้อนหินจิ๋วสวย ๆ ด้วยสายตาปริบ ๆ อยู่บนดินเสมอ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700109
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700109,
					"content": "ว้าว... แสดงว่าตอนนี้พี่ Jinwu ก็พกลูกอมมาด้วยน่ะสิ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710700110,
					"content": "ลูกอมเหรอ? อืม... ที่นี่ไม่มีลูกอมแฟนซีแบบในเมืองหรอก แต่เธอคงไม่รังเกียจก้อนน้ำตาลหรอกใช่มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700111
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700111,
					"content": "ที่แท้ก็เป็นน้ำตาลแบบนี้นี่เอง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710700112,
					"content": "ผู้คนรอบตัวทั้งมาแล้วก็จากไป ทิ้งไว้เพียงความทรงจำเท่านั้นที่อยู่กับฉัน... ฮ่าฮ่า แล้วยังมีนักผจญภัยที่ลงไปในเหมืองอย่างพวกเธออีก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700113,
					"content": "เกี่ยวกับ Zhiqiong...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710700114
					]
				},
				{
					"id": 710700114,
					"content": "Zhiqiong เป็นคนงานเหมืองรุ่นใหม่ของเรา หล่อนเกิดที่ Mingyun Village ที่จริงคนงานเหมืองที่มากประสบการณ์ใน Chasm ล้วนมาจาก Mingyun Village ทั้งนั้นแหละ... ซึ่ง Zhiqiong ไม่ทันช่วงเวลาทองนี้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700115
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700115,
					"content": "อ้อ... อย่าเข้าใจผิดล่ะ ฉันไม่ได้หมายความว่าตอนนี้ไม่ดี แต่หลายปีมานี้ Mingyun Village ได้หยุดทำเหมืองไปเพราะเขาไม่มีแร่ธาตุแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700116
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700116,
					"content": "ต่อมา Zhiqiong ก็ได้มาที่ Chasm ซึ่ง Chasm ก็หยุดการผลิตเพราะอุบัติเหตุอีก... เด็กคนนี้คงไม่เหมาะจะเป็นคนงานเหมือง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700117
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700117,
					"content": "เอ่อ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710700118
					]
				},
				{
					"id": 710700118,
					"content": "ต่อมาทุกคนก็พบทางเดินของตัวเอง ฉันยังคงอยู่ในเหมืองต่อไป อุปกรณ์ที่หลงเหลือหลังจากการอพยพจะต้องได้รับการดูแล และเธอคนนั้นก็กลายเป็นนักผจญภัยแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700119
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700119,
					"content": "เด็กคนนี้ยังคงเป็นเด็กอยู่เสมอ ไม่รู้จักรักตัวเองเอาซะเลย หรือว่าเธอจะทำงานในเหมืองน้อยเกินไป",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700120
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700120,
					"content": "ถ้าหล่อนคุ้นเคยกับชีวิตของคนงานเหมือง และคุ้นเคยกับการช่วยชีวิตผู้คนที่ตกอยู่ในอันตรายด้วยมือของตัวเองได้... อาจทำให้หล่อนเข้าใจชีวิตลึกซึ้งมากขึ้นก็ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700121
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700121,
					"content": "แม้ว่าจะเป็นคำขอที่งี่เง่า... แต่ฉันหวังว่าเธอจะช่วยจับตาดูหล่อนให้มากขึ้นหน่อย อย่าปล่อยให้หล่อนฆ่าตัวตายเด็ดขาด",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700122,
					"content": "แล้วเจอกัน",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710700123
					]
				},
				{
					"id": 710700123,
					"content": "อื้ม ดูแลตัวเองด้วยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				}
			]
		},
