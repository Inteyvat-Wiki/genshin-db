				"points": []
			},
			"dialogs": [
				{
					"id": 710701701,
					"content": "สวัสดี! การเดินทางเป็นยังไงบ้าง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701702
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710701702,
					"content": "ก็ดีนะ ช่วงนี้นายเป็นยังไงบ้าง?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701703
					]
				},
				{
					"id": 710701703,
					"content": "ขอบคุณโอกาสที่เธอให้นะ ตั้งแต่การติดตั้งชนวนกระสุนสำเร็จ ทุกคนก็ยอมรับให้ฉันอยู่ที่นี่แล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701704
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710701704,
					"content": "ส่วนแผนหลังจากกลับสู่พื้นก็... ฮ่าฮ่า ฉันยังไม่ได้คิดเลย! ยังไงก็คงจะไม่เป็นกองโจรล่าสมบัติแล้วล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701705,
						710701706
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710701705,
					"content": "คงจะ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701707
					]
				},
				{
					"id": 710701707,
					"content": "ไม่เป็นแล้ว ไม่เป็นแล้วแน่นอน!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701708
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710701708,
					"content": "แล้วเจอกัน",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701709
					]
				},
				{
					"id": 710701709,
					"content": "รักษาตัวด้วย!",
					"roleType": "TALK_ROLE_NPC",
