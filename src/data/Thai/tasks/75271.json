			"dialogs": [
				{
					"id": 752710101,
					"content": "อย่าทำลูกโป่งพวกนี้พังนะ ถ้าคุณอยากจะเล่นลูกโป่ง เดี๋ยวฉันจะให้ของอย่างอื่นแทน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710102
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710102,
					"content": "ลูกโป่งพวกนี้ดูพิเศษอยู่นะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710103
					]
				},
				{
					"id": 752710103,
					"content": "พูดแล้วก็เขิน นี่เป็นอุปกรณ์ชิ้นสำคัญเลยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710104
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710104,
					"content": "ดูจากสภาพแล้ว คุณน่าจะเดาได้ว่าใช้สำหรับทำอะไรใช่มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710105,
						752710107
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710105,
					"content": "ขอแต่งงาน?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710106
					]
				},
				{
					"id": 752710106,
					"content": "สารภาพรักต่างหาก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710109
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710109,
					"content": "ฉันจะสารภาพรักกับ Yopoyi ที่รักของฉัน ท่ามกลางลูกโป่งสุดโรแมนติกพวกนี้ คุณคิดว่าไง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710110
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710110,
					"content": "ควรจะใช้ลูกโป่งสีแดงดีกว่านะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710111
					]
				},
				{
					"id": 752710111,
					"content": "เอ๋? มีเหตุผล... ฉันนี่ขาดจิตวิญญาณความโรแมนติกไปหน่อยจริง ๆ เหรอเนี่ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710112
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710112,
					"content": "แต่ Yopoyi กำลังจะมาแล้ว ตอนนี้ฉันจะไปหาลูกโป่งสีแดงได้จากไหนละเนี่ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710107,
					"content": "สารภาพรัก?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710108
					]
				},
				{
					"id": 752710108,
					"content": "ถะ...ถูกต้อง!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710109
					],
					"speakerTitle": "Ziki"
				}
			]
		},
