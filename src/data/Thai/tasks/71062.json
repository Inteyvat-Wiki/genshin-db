					"Anton"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710620137,
					"content": "บอกเป้าหมายของพวกนายมา",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620140
					]
				},
				{
					"id": 710620140,
					"content": "คืออย่างนี้ ไม่ว่าพวกเธอจะสงสัยอะไร... แต่ภารกิจของเราคือการตรวจสอบต้นตอของภัยพิบัติใน Chasm เท่านั้น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620141
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620141,
					"content": "ภัยพิบัติอะไรเหรอ... Chasm ก็ปกติดีไม่ใช่เหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710620142,
					"content": "ภัยพิบัติเมื่อห้าร้อยปีก่อน เป็นเพียงจุดเริ่มต้นของสงครามเท่านั้น สงครามกับความมืดยังคงดำเนินอยู่ และหนึ่งในสนามรบนั้นก็อยู่ใต้เท้าของพวกเรา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620143
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620143,
					"content": "เฮ้อ จ่าสิบเอกผู้บังคับกองร้อยหิวจนขี้โม้อีกแล้ว...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620144
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620144,
					"content": "ปกติเขาก็ขี้โม้ตลอดนั่นแหละ... แต่นี่เป็นครั้งแรกที่เขาพูดเรื่องไร้สาระ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620145
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620145,
					"content": "ช่างเถอะ ๆ... ที่ Antoha พูด ให้สรุปง่าย ๆ ก็คือ... ชาว Liyue ไม่ใช่ศัตรูของพวกเรา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620146
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620146,
					"content": "อย่างน้อยก็ไม่ใช่ศัตรูของกองร้อยที่ 9 ในปฏิบัติการนี้... แต่พี่น้องคนอื่น ๆ ที่แยกไป ฉันก็ไม่รับประกันหรอกนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620147
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620147,
					"content": "ฉันจะช่วยพวกนายเพราะเห็นแก่มนุษยธรรม แต่แค่ครั้งนี้เท่านั้น",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620148
					]
				},
				{
					"id": 710620148,
					"content": "ขอบคุณ... ขอบคุณพวกเธอมาก เราจะไม่มีวันลืมเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anton"
				}
			]
		},
