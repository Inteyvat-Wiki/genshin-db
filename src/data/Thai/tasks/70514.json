	"talks": [
		{
			"id": 7051401,
			"completionStepIds": [
				7051401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7051401",
							"2"
						],
						"stepId": 7051401,
						"stateName": "QUEST_STATE_UNFINISHED"
