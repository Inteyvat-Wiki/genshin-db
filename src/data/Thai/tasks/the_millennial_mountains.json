				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710640201,
					"content": "(แผ่นศิลาเล็ก ๆ ที่มีข้อความจารึกไว้ว่า...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640202
					],
					"speakerTitle": "แผ่นศิลา"
				},
				{
					"id": 710640202,
					"content": "...\"ศึกที่เกิดใน Chasm ทำให้ข้าเสียแขนขาทั้งสี่ ข้าจึงทำได้แค่สั่งให้ใครสักคนบันทึกและสลักไว้ในที่แห่งนี้\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640203
					],
					"speakerTitle": "แผ่นศิลา"
				},
				{
					"id": 710640203,
					"content": "...\"ในการต่อสู้ที่ดุเดือดนี้ ถึงแม้จะรอดชีวิตมาได้ แต่ทุกครั้งที่คิดถึงสหายที่ล่วงลับไป ทำให้ข้านอนไม่หลับตลอดคืน และด้วยร่างกายที่อยู่ในสภาพนี้ ทำให้ข้าโกรธแค้นที่ไม่อาจตามเหล่าสหายไปได้\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640204
					],
					"speakerTitle": "แผ่นศิลา"
				},
				{
					"id": 710640204,
					"content": "...\"ข้าพยายามดับชีวิตตัวเอง แต่ก็ไร้ผล เมื่อราชาได้ยินดังนั้นจึงได้ตำหนิและเรียกสติของข้ากลับมา\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640205
					],
					"speakerTitle": "แผ่นศิลา"
				},
				{
					"id": 710640205,
					"content": "...\"ท่านราชาได้มอบชุดและหมวกเกราะคืนให้กับกองทหาร Millelith แต่ข้าไม่สามารถตอบแทนความโปรดปรานนี้ได้ จึงต้องปล่อยให้ฝุ่นธุลีปกคลุมไว้ แล้วรอวันที่ผู้ถูกลิขิตมารับมันไป\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640206
					],
					"speakerTitle": "แผ่นศิลา"
				},
				{
					"id": 710640206,
					"content": "...\"ทุกท่าน ชีวิตนี้ข้าคงไร้ซึ่งโอกาสแล้ว หวังว่าชาติหน้าเราจะได้เป็นสหายร่วมชาติ ดื่มเหล้าแห่งคำปฏิญาณร่วมกัน และปราบศัตรูแห่ง Liyue ด้วยกันอีกครั้ง\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "แผ่นศิลา"
				}
			]
		},
		{
			"id": 7106403,
			"completionStepIds": [
				7106411
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7106411",
							"2"
						],
						"stepId": 7106411,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710640301,
					"content": "คิดไม่ถึงเลยว่าเธอจะหาเจอจริง ๆ... นี่คือ \"สมบัติของทหาร Millelith\" จริง ๆ เหรอ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640302
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640302,
					"content": "ถึงแม้จะไม่รู้ว่าข้างในเป็นอะไร แต่... เธอสามารถหามันเจอได้ ทหาร Millelith ที่ทิ้งสมบัตินี่ไว้คงจะต้องดีใจแน่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640303
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640303,
					"content": "ภัยพิบัติครั้งนั้นผ่านมากว่าห้าร้อยปีแล้ว พอคิดถึงเมื่อห้าร้อยปีก่อน ที่แห่งนี้คงเป็นสนามรบอันโหดร้าย ที่บรรพบุรุษของเราต้องเสียสละชีวิตนับไม่ถ้วน ฉันอดสงสัยไม่ได้ว่า...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640304
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640304,
					"content": "ในยุคนั้น ผู้คนจำนวนมากต้องต่อสู้เคียงข้างท่านลอร์ดแห่งหิน หนึ่งในพวกเขาจะเป็นที่จดจำจากผู้คนตลอดหลายศตวรรษหรือเปล่านะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640305
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640305,
					"content": "พวกเขาเคยสงสัยหรือลังเลในหน้าที่ของตนเองไหมนะ...? คนธรรมดาที่ไม่ได้รับ \"วิชั่น\" จะภักดีต่อเทพที่ไม่เคยเฝ้าดูพวกเขาเลยไปจนตายได้อย่างไรกัน?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640306,
						710640307
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640306,
					"content": "เพราะว่าเทพไม่เคยห่างพวกเขาไปไกลไง",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710640308
					]
				},
				{
					"id": 710640308,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640309
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640309,
					"content": "อื้ม เธอพูดถูก ไม่ว่าจะมีวิชั่นหรือไม่มี... ผู้คนก็ยังต้องทำงานเพื่ออนาคตที่ไร้ขอบจำกัด นั่นคือแรงผลักดันสินะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640310
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640310,
					"content": "พวกเราก็เหมือนกัน เราไม่ได้อยู่ที่นี่เพื่อช่วงเวลาดี ๆ ในอดีต หรือเพื่อตระหนักรู้ตนเองในปัจจุบัน... แต่เราทำแบบนี้เพื่อสนับสนุนกันและกัน และทิ้งร่องรอยและเสียงของเราไว้ในยุคต่อ ๆ ไป",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640311
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640311,
					"content": "บางทีเมื่อเวลาผ่านไป Chasm อาจจะกลายเป็นอนุสรณ์ของเราก็ได้นะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640314
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640314,
					"content": "ที่แห่งนี้เต็มไปด้วยหลุมและหุบเหว เปียกโชกไปด้วยหยาดเหงื่อและน้ำตาของคนงานเหมืองรุ่นสู่รุ่น... และมันยังเป็นสักขีพยานของเส้นทางยากลำบากที่เราได้เลือกไว้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640312
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640312,
					"content": "เหมือนกับอนุสรณ์หินนี้ไง ในอีกห้าร้อยปี ไม่สิ ในอีกพันปีมันก็ยังคงอยู่ที่นี่ เป็นเครื่องพิสูจน์ว่าการเสียสละของเหล่าทหารไม่ได้สูญเปล่า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640313
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640313,
					"content": "ฮ่ะ ๆ ถึงแม้ว่าฉันจะไม่ได้เห็นมัน... แต่ถึงตอนนั้น หวังว่าจะมีคนมาดื่มอวยพรให้คนงานเหมืองที่น่าสงสารอย่างพวกเราสักแก้ว ฉันก็พอใจแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640307,
					"content": "เพราะพวกเขาภักดีต่อทางเลือกของตนเอง",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710640308
					]
				}
			]
		},
