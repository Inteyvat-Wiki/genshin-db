						4260110,
						4260118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260102,
					"content": "ว่าจะไปทำเควสต์",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4260103
					]
				},
				{
					"id": 4260103,
					"content": "อันนี้ง่ายมาก แตะที่สัญลักษณ์ตรงมุมซ้ายบน ก็จะเห็นเควสต์ที่ทำได้ในตอนนี้แล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260104,
					"content": "เควสต์แต่ละอันจะมีระดับความยาก ถ้าความต่างของระดับมีมากเกินไปก็อาจจะไม่ไหวนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260117,
					"content": "ยังอยากรู้อะไรอีกไหม",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260102,
						4260105,
						4260110,
						4260118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260105,
					"content": "อยากจะไปเดินดูตามที่ต่างๆ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4260106
					]
				},
				{
					"id": 4260106,
					"content": "บริเวณที่แตกต่างกันไปก็จะมีระดับความยากที่ต่างกันไปด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260107,
					"content": "บริเวณที่มีระดับความยากเหมาะสม จึงจะสามารถยกระดับได้อย่างมีประสิทธิภาพนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260108,
					"content": "Alfry จากสมาคมนักผจญภัยนั้นรู้ทุกอย่างที่เกี่ยวกับ Teyvat ดี",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260109,
					"content": "เธออาศัยอยู่ที่บริเวณตัวเมืองตรงทางเข้าเมือง Mondstadt ลองไปถามเธอสิว่ามีพื้นที่ทำการสำรวจที่เหมาะกับเธอไหม",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260110,
					"content": "อยากจะแข็งแกร่งขึ้น",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4260111
					]
				},
				{
					"id": 4260111,
					"content": "อืม งั้นก็หลีกเลี่ยงไม่ได้ที่จะต้องมีอาวุธและอาร์ติแฟกต์ที่ดี",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260112,
					"content": "ได้ยินว่าใต้พื้นดินของเมืองนี้มีของดีซ่อนอยู่ เพียงแต่ว่ามันค่อนข้างอันตราย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260113,
					"content": "แน่นอนว่าสามารถไปที่ตัวเมืองเพื่อหาซื้อได้ด้วย หากว่ามีเงินพอน่ะนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260114,
					"content": "แล้วก็...อาวุธและอาร์ติแฟกต์นั้นล้วนสามารถเสริมสร้างและยกระดับได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260115,
					"content": "เหล่านี้คงต้องให้ตัวเธอเองทำความเข้าใจแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260116,
					"content": "จริงสิ เลเวลของตัวละครของคุณเองก็สำคัญนะ",
					"roleType": "TALK_ROLE_NPC",
