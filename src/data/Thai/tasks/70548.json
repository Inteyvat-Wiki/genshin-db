							2194.736,
							230.089,
							-781.087
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705480101,
					"content": "อ๊ะ ดูเหมือน Hertha จะกลับไปทำธุระ ส่วน Glenfidia ก็ไม่อยู่... นี่ซุ้มเครื่องดื่มถูกเจ้าตัวน้อยรับช่วงไปดูแลต่อแล้วเหรอเนี่ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480102,
						705480103
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480102,
					"content": "ใช่แล้ว ฉันเองแหละ!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480104
					]
				},
				{
					"id": 705480104,
					"content": "ดีเลย~ งั้นฉันก็สั่งได้อย่างสบายใจแล้วล่ะ ไม่ต้องกังวลว่าจะ... ได้ดื่มเครื่องดื่มสูตรพิเศษสุดพิสดารของหน่วยโลจิสติกส์ ที่ทำเอาตาสว่างพลิกตัวไปมาทั้งคืน จนสุดท้ายก็ต้องลุกมานั่งปั่นงานยันโต้รุ่ง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480105,
						705480106
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480105,
					"content": "เรื่องปั่นงานยันโต้รุ่ง คงเป็นอดีตไปแล้วใช่มั้ย?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480107
					]
				},
				{
					"id": 705480107,
					"content": "ใช่แล้วล่ะ ตอนนี้ฉันก็เป็นแค่บรรณารักษ์ว่างงานคนหนึ่งเท่านั้นแหละ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480108
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480108,
					"content": "ถ้ามีคนยืมหนังสือเกินกำหนดน้อยกว่านี้อีกหน่อย ฉันก็คงไม่ต้องเหนื่อยออกไปตามทวงถึงที่ แล้วก็จะได้แวะมาคุยเล่นกับเจ้าตัวน้อยได้เร็วขึ้น รวมถึงได้ลองชิมผลงานชิ้นเอกของเธอเยอะขึ้นด้วยไง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480109,
						705480110
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480109,
					"content": "งั้นวันนี้จะรับเครื่องดื่มอะไรดีล่ะ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480111
					]
				},
				{
					"id": 705480111,
					"content": "ขอฉันคิดก่อนนะ... ฉันไม่มีสูตรไหนที่ชื่นชอบเป็นพิเศษหรอก งั้นฉันขอเป็นเครื่องดื่มที่ช่วยฟื้นฟูแรงกาย แล้วก็ทำให้อารมณ์ดีขึ้นก็แล้วกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480112
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480112,
					"content": "ถ้าช่วยให้ฉันหลับได้สบายแบบผ่อนคลายด้วยแล้วละก็ จะเยี่ยมมากเลยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480113
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480113,
					"content": "(ซุ้มเครื่องดื่มมีสูตรคลาสสิกเยอะแยะเลย เลือกจากในนี้ก่อนแล้วกัน...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480114
					]
				},
				{
					"id": 705480114,
					"content": "(Lisa อยากฟื้นฟูแรงกาย \"Snow-Kissed Dawn\" น่าจะเป็นตัวเลือกที่ไม่เลว...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 705480110,
					"content": "มีรสชาติที่อยากได้เป็นพิเศษมั้ย?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480111
					]
				},
				{
					"id": 705480106,
					"content": "ตอนนี้ Lisa คงไม่ยุ่งขนาดนั้นแล้วมั้ง?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480107
					]
				},
				{
					"id": 705480103,
					"content": "นักผสมเครื่องดื่มผู้มีเกียรติพร้อมให้บริการแล้ว!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480104
					]
				}
			]
		},
