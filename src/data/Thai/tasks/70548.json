					}
				]
			},
			"dialogs": [
				{
					"id": 705480201,
					"content": "แก้วนี้คือ \"Snow-Kissed Dawn\" เชิญเลย",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480202
					]
				},
				{
					"id": 705480202,
					"content": "ใช่ย่อยเลยนะ เจ้าตัวน้อย~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480203
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480203,
					"content": "รสเปรี้ยวกำลังดี หวานแต่ไม่เลี่ยน ดื่มง่ายชุ่มคอ แถมยังมีรสหวานเบา ๆ ติดที่ปลายลิ้นด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480204
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480204,
					"content": "แต่ว่านะ ฉันรู้สึกว่าพอดื่มแก้วนี้เข้าไปแล้ว เหมือนรู้สึกกระปรี้กระเปร่าขึ้นนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480205
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480205,
					"content": "หรือว่าเธอจะบังเอิญไขความลับของ Glenfidia เข้าโดยไม่รู้ตัว จนผสมเครื่องดื่มชูกำลังที่เจ๋งกว่าของเขาได้ซะแล้ว?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480206,
						705480207
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480206,
					"content": "หรือควรจะปรับส่วนผสมสักหน่อยดี?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480208
					]
				},
				{
					"id": 705480208,
					"content": "ไม่เป็นไร ไม่ต้องรีบร้อน~ ในแววตาของเธอดูเต็มไปด้วยความสงสัยนะ เหมือนยังมีเรื่องอยากถามฉันอีกเยอะแยะเลยใช่มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480209
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480209,
					"content": "เรามาคุยกันไปเรื่อย ๆ ก่อนสิ เธอจะได้ค่อย ๆ คิด แล้วเดี๋ยวไอเดียดี ๆ ก็จะผุดขึ้นมาเอง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480210
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480210,
					"content": "วันนี้ Lisa ไปทวงหนังสือเล่มไหนคืนมาบ้างเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480211
					]
				},
				{
					"id": 705480211,
					"content": "เป็นคำถามที่ทำให้ฉันทั้งปวดหัว แล้วก็อดขำไม่ได้อยู่เหมือนกันนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480212
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480212,
					"content": "มีเชฟคนหนึ่งที่เพิ่งเรียนจบ แล้วเดินทางจาก Fontaine มาทำงานที่ Goth Grand Hotel เขายืมหนังสือเล่มที่ล้ำค่าที่สุดอย่าง \"สารานุกรมขนมหวานพันปีแห่ง Mondstadt\" ไป",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480213
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480213,
					"content": "แล้วเขาก็ดันคิดจะเอาแนวทางการทำขนมหวาน ไปดัดแปลงใช้กับพวกเมนูเนื้อสัตว์ เพื่อลดความมันเลี่ยนน่ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480214,
						705480215
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480214,
					"content": "เนื้อสัตว์รสหวานเจี๊ยบงั้นเหรอ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480216
					]
				},
				{
					"id": 705480216,
					"content": "ก็นั่นน่ะสิ ถ้าดูจากผลลัพธ์แล้ว เหมือนเขาจะใช้ซอสคาราเมลพร่ำเพรื่อไปหน่อย จนทำให้เนื้อที่ควรจะส่งกลิ่นหอมกรุ่น กลายเป็นหวานเลี่ยนจนน่าสยองแทน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480217
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480217,
					"content": "ทั้ง ๆ ที่ซอสคาราเมลน่ะเป็นเด็กดีจะตายไป จะเอาไปใส่ในเครื่องดื่มแบบไหนก็ไม่เคยทำให้ใครเกลียดได้ลง บางทีฉันเองก็ยังตักใส่น้ำชายามบ่ายสักหน่อยเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480218
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480218,
					"content": "พอมองแบบนี้แล้ว การดัดแปลงอาหารเนี่ย ก็ใช่ว่ายิ่งมีความคิดสร้างสรรค์แล้วจะดีเสมอไปนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480219
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480219,
					"content": "เหมือน Lisa จะพกสมุดบันทึกมาด้วยเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480220
					]
				},
				{
					"id": 705480220,
					"content": "อ๋อ นี่คือพยานในการทำงานอีกอย่างหนึ่งของวันนี้ล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480221
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480221,
					"content": "อีกไม่นาน สมาชิกกองคณะสำรวจหลายคนก็จะทยอยกลับมาที่ Mondstadt กันแล้ว พวกเขาออกไปปฏิบัติภารกิจข้างนอกมานาน รสนิยมการกินก็อาจจะเปลี่ยนไป",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480222
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480222,
					"content": "เพื่อที่จะนำเข้าวัตถุดิบใหม่ ๆ มาตอบสนองความคุ้นชินที่เปลี่ยนไปของเหล่าอัศวิน Jean ก็เลยขอให้ฉันไปเยี่ยมเยียนครอบครัวตัวแทนสิบกว่าครัวเรือน เพื่อทำแบบสำรวจนิดหน่อยน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480223,
						705480224
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480223,
					"content": "เป็นแผนงานที่ละเอียดจริง ๆ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480225
					]
				},
				{
					"id": 705480225,
					"content": "อื้ม พวกเขาต่างทุ่มเททั้งแรงกาย เวลา และเลือดเนื้อเพื่อ Mondstadt ก็สมควรแล้วที่จะได้รับการให้เกียรติและดูแล เป็นการตอบแทนจากทุกคน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480226
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480226,
					"content": "จากผลสำรวจ วัตถุดิบที่ถูกพูดถึงบ่อยที่สุดก็คือ Cacahuatl จาก Natlan แล้วก็โกโก้ที่ทำมาจากพืชสุดแปลกชนิดนี้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480227
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480227,
					"content": "อัศวินหลายคนเขียนมาในจดหมายว่า พวกเขาเคยชินกับการดื่มโกโก้เพื่อให้ร่างกายกระปรี้กระเปร่า ฉันเองก็เคยลองดื่มโกโก้ร้อนดูแล้ว รู้สึกว่ามันช่วยให้ตื่นตัวได้ดีไม่แพ้กาแฟเลยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480228
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480228,
					"content": "ช่วงนี้ยังได้ไปที่อื่นอีกมั้ย?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480229
					]
				},
				{
					"id": 705480229,
					"content": "หมายถึงถือโอกาสแอบไปเดินเล่นข้างนอกงั้นเหรอ? โดนเธอทายถูกซะแล้วสิ~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480230
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480230,
					"content": "เพื่อที่จะสำรวจเครื่องดื่มที่ไม่ค่อยเป็นที่นิยมใน Mondstadt ฉันเลยแวะไปที่ Dawn Winery แล้วก็คุยกับหัวหน้าสาวใช้ Adelinde อยู่พักหนึ่ง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480231
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480231,
					"content": "ขากลับยังเจออัศวินลาดตระเวนตัวน้อยคนหนึ่งที่ชื่อ Ematol ด้วย เขาดันเจอเข้ากับมอนสเตอร์ที่ไม่รู้ว่าจะรับมือยังไง ก็เลยวิ่งหน้าตื่นมาขอความช่วยเหลือจากฉัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480232
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480232,
					"content": "ฉันก็เลยพาเขาอ้อมไปทาง Wolvendom แล้วก็สั่งสอนเจ้าสุนัขนักล่าที่กำลังอาละวาดนั้นสักหน่อย... นาน ๆ ทีได้ออกแรงยืดเส้นยืดสายแบบนี้ ก็รู้สึกสดชื่นดีเหมือนกันนะ~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480233
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480233,
					"content": "ช่วงนี้ Lisa ชอบพืชอะไรเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480234
					]
				},
				{
					"id": 705480234,
					"content": "โอ้? เจ้าตัวน้อยนี่ช่างเลือกใช้คำได้ระมัดระวังดีจังนะ เพิ่มคำว่า \"ช่วงนี้\" เข้ามาจำกัดความด้วย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480235
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480235,
					"content": "นี่เป็นเพราะคิดว่าเราไม่ได้เจอกันพักหนึ่ง ฉันอาจจะเปลี่ยนไป... หรือเป็นเพราะจำเรื่องเก่า ๆ ไม่ค่อยได้กันล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480236,
						705480237
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480236,
					"content": "ก็ Lisa รอบรู้กว้างขวางจะตายไป...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480238
					]
				},
				{
					"id": 705480238,
					"content": "ไม่เลวนี่ ตอบได้ไร้ที่ติเชียว~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480239
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480239,
					"content": "สมัยเรียน ฉันอาจจะหลงใหลในพืชพรรณแปลกใหม่ในหนังสือ คอยแสวงหาความรู้และก้าวออกจากคอมฟอร์ตโซนอยู่ตลอด แต่ตอนนี้ ฉันเคยชินกับความสงบและชีวิตที่เป็นระเบียบแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480240
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480240,
					"content": "ขอยืมคำเปรียบเปรยของผู้เชี่ยวชาญด้านกฎหมายจาก Liyue มาใช้หน่อยนะ ชีวิตของฉันตอนนี้ก็ใกล้จะเข้าสู่สภาวะ \"พักผ่อนหย่อนใจในวัยเกษียณ\" แล้ว ไม่ใช่คนใจโลเลเปลี่ยนไปเปลี่ยนมาอีกต่อไปแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480241
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480241,
					"content": "เพราะงั้น เธอต้องจำได้แน่ ๆ... ตอนที่เราไปผจญภัยด้วยกันเมื่อหลายปีก่อน เธอก็เคยหาวัตถุดิบเล่นแร่แปรธาตุที่มีรสหวานอ่อน ๆ มาให้ฉัน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480242
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480242,
					"content": "ความชอบของฉันยังเหมือนเดิมไม่เปลี่ยนนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480243
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480243,
					"content": "อื้ม ฉันได้ไอเดียแล้วล่ะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480244
					]
				},
				{
					"id": 705480244,
					"content": "เดี๋ยวฉันจะชงสูตรดัดแปลงพิเศษให้เธอเอง",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480245
					]
				},
				{
					"id": 705480245,
					"content": "สมแล้วที่เป็นเจ้าตัวน้อย ความเฉลียวฉลาดพัฒนาขึ้นไปอีกขั้นแล้วนะเนี่ย แค่ใบ้นิดเดียวก็ปิ๊งไอเดียได้เลย~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480237,
					"content": "การจะมีงานอดิเรกใหม่ ๆ บ้าง ก็สมเหตุสมผลออกไม่ใช่เหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480238
					]
				},
				{
					"id": 705480224,
					"content": "เป็นการจัดการที่ใส่ใจจริง ๆ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480225
					]
				},
				{
					"id": 705480215,
					"content": "แนวคิดนี้ไม่ธรรมดาเลยจริง ๆ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480216
					]
				},
				{
					"id": 705480207,
					"content": "ให้ฉันแก้สูตรแล้วชงให้ใหม่ดีมั้ย?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480208
					]
				}
			]
		},
