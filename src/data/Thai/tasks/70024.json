			"dialogs": [
				{
					"id": 700240202,
					"content": "โชคดีที่พวกเรามาแล้ว...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240204
					]
				},
				{
					"id": 700240203,
					"content": "คุณโอเครึเปล่า...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240204
					]
				},
				{
					"id": 700240201,
					"content": "ฟู่ว... อันตรายจัง โชคดีที่พวกเธอมาแล้ว...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240202,
						700240203
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700240204,
					"content": "เอ่อ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240205
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700240205,
					"content": "เมื่อกี้กำลังคุยกันอย่างราบรื่นแท้ ๆ เชียว... พูดผิดตรงไหนกันนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240206
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700240206,
					"content": "ไม่ว่ายังไง... ขอบคุณพวกเธอมากนะที่มาช่วยไว้ทันเวลาพอดี...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240207
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700240207,
					"content": "เธอดูหงอย ๆ นะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700240208,
					"content": "เรื่องที่เกิดขึ้นเธอก็เห็นแล้วนี่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240223
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700240223,
					"content": "ถ้าออกไปคุยกับ Hilichurl คนเดียวมันก็อันตรายเกินไป...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240209
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700240210,
					"content": "งั้นเหรอ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240212
					]
				},
				{
					"id": 700240211,
					"content": "มีอะไรที่ฉันพอจะช่วยได้มั้ย?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240212
					]
				},
				{
					"id": 700240209,
					"content": "แต่ว่า... จะให้เสียโอกาสในการสื่อสารกับ Hilichurl ไปอย่างงี้ ฉันเองก็ไม่เต็มใจเท่าไหร่นะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240210,
						700240211
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700240212,
					"content": "ถ้าเป็นอย่างงี้ การรวบรวมศัพท์ในพจนานุกรมก็จะล่าช้าออกไปอีก...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240224
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700240213,
					"content": "ฉันช่วยได้นะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240214
					]
				},
				{
					"id": 700240224,
					"content": "ถ้ามีคนตรวจสอบความถูกต้องของเนื้อหาในหนังสือ แทนฉันได้ก็คงจะดี",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240213
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700240214,
					"content": "จะ จริงเหรอ! เยี่ยมไปเลย! งั้นรบกวนเธอถือหนังสือเล่มนี้ไปด้วยนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240215
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700240215,
					"content": "โว้ว... อยู่ดี ๆ ก็ใช้คนอื่นเลยนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700240217,
					"content": "ทฤษฎี?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240218
					]
				},
				{
					"id": 700240216,
					"content": "ถ้าเจอปัญหาระหว่างการสื่อสาร ลองหาคำศัพท์ในนั้นดูน่าจะช่วยได้... อย่างน้อยก็ในทางทฤษฎีล่ะนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240217
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700240218,
					"content": "เพราะงั้นคุณ Musk ก็ไม่รู้ว่าตัวเองเขียนอะไรงั้นเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700240219,
					"content": "มีแต่คนนอกเท่านั้นที่จะถามอะไรอย่างงี้! การวิจัยทางวิทยาศาสตร์ที่ไม่ได้ตรวจสอบข้อสันนิษฐานในสถานการณ์จริง แล้วจะรู้ได้ยังไงว่าตรรกะมันถูกต้องรึเปล่า!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240225
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700240225,
					"content": "เฮ้อ... ช่างเหอะ ถึงยังไงพูดไปเธอก็คงไม่เข้าใจ ไม่ว่ายังไง ครั้งนี้ฉันต้องขอบใจเธอจริง ๆ ที่มาช่วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240220
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700240221,
					"content": "ยินดีต้อนรับเข้าทีม!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 700240222,
					"content": "ไหน ๆ ก็มาแล้วนี่...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 700240220,
					"content": "ถ้าพวกเธอไม่ถือสาล่ะก็ ให้ฉันไปสื่อสารกับพวก Hilichurl ด้วยกันกับเธอเถอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240220,
						700240221
					],
					"speakerTitle": "Ella Musk"
				}
			]
		}
	]
}