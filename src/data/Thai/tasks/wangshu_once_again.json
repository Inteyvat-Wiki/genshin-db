					"Yanxiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718200301,
					"content": "ใคร! อย่าเข้ามาโดย... อ๊ะ เธอนี่เอง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200302
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718200302,
					"content": "มีอะไรรึเปล่า? ถ้าจะสั่งอาหารล่ะก็คงต้องรอซักหน่อยนะ เพราะฉันยุ่งมากเลยตอนนี้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200303,
						718200304
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718200303,
					"content": "มาช่วยน่ะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718200305
					]
				},
				{
					"id": 718200305,
					"content": "มาช่วยงั้นเหรอ? โอ้... งั้นก็เยี่ยมไปเลย ฉันมีเรื่องต้องทำเยอะแยะไปหมดเลยล่ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200306
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718200306,
					"content": "เธอช่วยไปที่ด้านล่างโรงแรมแล้วเอาวัตถุดิบทำอาหารที่เพิ่งจะถูกนำมาส่งมาให้ฉันที่นี่หน่อยสิ ฉันรีบใช้น่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200307
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718200307,
					"content": "แล้วก็ ช่วยนำโคม Xiao พวกนี้ไปแขวนไว้บนต้นไม้สองต้นที่อยู่ตรงทางเข้าโรงแรมทีนะ... ผู้จัดการบอกเรื่องนี้ตั้งไม่รู้กี่รอบแล้วล่ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718200304,
					"content": "มีอะไรที่พอจะช่วยได้บ้างมั้ย?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718200305
					]
				}
			]
		},
