			},
			"dialogs": [
				{
					"id": 220430101,
					"content": "ใช้ไม้หมดอีกแล้วเหรอเนี่ย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430102
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430102,
					"content": "เฮ้! นักเดินทาง เธอมาพอดีเลย ช่วยอะไรฉันหน่อยได้มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430103,
						220430104
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430103,
					"content": "ช่วยอะไรเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220430105
					]
				},
				{
					"id": 220430105,
					"content": "ช่วงนี้ฉันกำลังแกะสลักรูปปั้นไม้ขนาดจิ๋วให้เป็นรูปท่านรักษาการณ์หัวหน้ามิโกะอยู่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430106
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430106,
					"content": "ฉันคิดว่าหลังจากที่ฉันแกะสลักได้เก่งขึ้นแล้ว ฉันจะนำไม้แกะสลักพวกนี้ไปที่เกาะ Narukami เพื่อลองดูว่าจะมีใครเต็มใจที่จะซื้อบ้างรึเปล่า...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430107
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430107,
					"content": "ถ้ามันขายได้ ก็น่าจะเป็นแหล่งรายได้ที่มั่นคงทางหนึ่ง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430108,
						220430111
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430108,
					"content": "น่าจะขายได้นะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220430109
					]
				},
				{
					"id": 220430109,
					"content": "ฮ่าฮ่าฮ่า ขอให้สมพรปากนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430110
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430110,
					"content": "แต่ฉันก็มั่นใจในเสน่ห์ของท่าน Neko มากเลย ฮี่ฮี่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430118
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430118,
					"content": "เอ่อ... ไม่พูดเรื่องพวกนี้แล้ว มาคุยเรื่องสำคัญกันดีกว่า...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430119
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430119,
					"content": "ความจริงคือไม้ที่ฉันใช้ฝึกแกะสลักมันไม่พอ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430120
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430120,
					"content": "นักเดินทาง เธอช่วยรวบรวมไม้ Otogi 10 ท่อน ให้ฉันทีได้ไหม?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430121,
						220430123
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430121,
					"content": "ให้ฉันจัดการเอง",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220430122
					]
				},
				{
					"id": 220430122,
					"content": "งั้นก็รบกวนเธอด้วยนะ นักเดินทาง ช่วยได้มากจริง ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430126
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430126,
					"content": "ถ้ารวบรวมไม้ Otogi ได้ครบแล้ว ช่วยรีบเอามาให้ฉันด้วยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430123,
					"content": "ต้องใช้เยอะขนาดนั้นเลยเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220430124
					]
				},
				{
					"id": 220430124,
					"content": "คือฉันเพิ่งจะเริ่มฝึกไม่นานน่ะ... เลยต้องเตรียมวัสดุไว้เยอะหน่อย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430125
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430125,
					"content": "งั้นรบกวนเธอด้วยนะ นักเดินทาง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430126
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430111,
					"content": "ทำไมจู่ ๆ ถึงเริ่มแกะสลักไม้ล่ะ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220430112
					]
				},
				{
					"id": 220430112,
					"content": "เธอถามเรื่องนี้... เอ่อ เธอรู้มั้ยว่าค่าตอบแทนที่ฉันได้จากรักษาการณ์หัวหน้ามิโกะคืออะไร?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430113
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430113,
					"content": "มันคือ... ขวดเอย กระป๋องเอย ไม่ก็ถ้วยจานอะไรพวกนี้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430114
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430114,
					"content": "ถึงพวกมันจะดูเก่าไปหน่อย แต่พอฉันเอาไปให้คนประเมินดู ถึงได้รู้ว่ามันถือเป็นของโบราณ แล้วก็ขายได้ราคาด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430115
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430115,
					"content": "แต่ว่าการจะเอาของพวกนั้นไปขายมันค่อนข้างยุ่งยาก ทำเอาฉันเหนื่อยแทบตายทุกครั้งเลย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430116
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430116,
					"content": "อีกอย่าง รายได้มันก็ไม่แน่นอน... ถ้าวันนึงรักษาการณ์หัวหน้ามิโกะหาของพวกนี้ไม่ได้แล้ว แบบนั้นฉันก็ตกงานน่ะสิ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430117
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430117,
					"content": "เพราะฉะนั้น ฉันก็เลยต้องคิดหาช่องทางทำธุรกิจใหม่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430118
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430104,
					"content": "เธอทำอะไรอยู่เหรอ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220430105
					]
				}
			]
		},
