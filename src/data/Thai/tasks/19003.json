			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Victoria"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190030301,
					"content": "กลับมาอีกแล้วเหรอ ถ้าเกิดมาหาคุณ Barbara ล่ะก็ เธอยังไม่กลับมาเลยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030302,
						190030303
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030302,
					"content": "เจอกับ Barbara ที่ Wolvendom แล้วล่ะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030304
					]
				},
				{
					"id": 190030304,
					"content": "งั้นเหรอ... เธอไม่เป็นอะไรก็ดีแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030305
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030305,
					"content": "แต่เธอคงจะไม่กลับมาอีกสักพักล่ะมั้ง ดูท่าฉันคงต้องขอให้คนอื่นช่วยจัดการเรื่องของทางโบสถ์แทนแล้วล่ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030306
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030306,
					"content": "งั้นฉันช่วยเอง",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030307
					]
				},
				{
					"id": 190030307,
					"content": "เธอยอมช่วยก็เยี่ยมไปเลย ขอโทษนะ ยังต้องรบกวนเธอ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030308
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030308,
					"content": "ฉันคิดก่อนนะ... งั้นเธอช่วยไปจัดการทำความสะอาดบริเวณรอบ ๆ โบสถ์ให้ทีสิ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030309
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030309,
					"content": "มีคนเดินผ่านมาผ่านไปบริเวณรอบ ๆ โบสถ์อยู่ตลอดเวลา พื้นสกปรกมากเลยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030310
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030310,
					"content": "ก่อนหน้านี้คุณ Barbara เป็นคนจัดการเรื่องพวกนี้น่ะ พอเธอไม่อยู่ รอบ ๆ มันก็...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030311
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030311,
					"content": "ใหญ่ตั้งขนาดนี้ ทั้งหมดมีแค่ Barbara คนเดียวที่จัดการงั้นเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030312
					]
				},
				{
					"id": 190030312,
					"content": "ใช่แล้วล่ะ คุณ Barbara เอาแต่พูดว่าไม่มีปัญหา และก็ไม่ยอมให้ใครช่วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030313
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030313,
					"content": "แต่ทุกครั้งที่ทำความสะอาดเสร็จ เธอก็ดูเหนื่อยสุด ๆ ไปเลยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030314
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030314,
					"content": "จริง ๆ แล้ว การที่เธอยอมช่วย หรือพูดอีกอย่างก็คือ.... การที่คุณ Barbara ยอมให้เธอช่วยเนี่ย ก็ค่อนข้างจะเป็นเรื่องที่เซอร์ไพรส์อยู่นะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030315
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030315,
					"content": "แต่ว่า แบบนี้ภาระของเธอก็ลดลงบ้างล่ะนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030316
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030316,
					"content": "สรุปแล้ว งั้นก็รบกวนเธอเรื่องทำความสะอาดทีนะ คุณอัศวินผู้มีเกียรติ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030303,
					"content": "Barbara ไปดูอาการคุณ Tunner ที่ Dawn Winery แล้วล่ะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030304
					]
				}
			]
		},
