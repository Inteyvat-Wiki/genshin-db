					"Victoria"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190030601,
					"content": "อื๋อ? สวัสดี ยังมีเรื่องอะไรอีกงั้นเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030602
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030602,
					"content": "เกี่ยวกับวันหยุดของ Barbara...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030603
					]
				},
				{
					"id": 190030603,
					"content": "อ๋อ เรื่องนี้น่ะเหรอ ใช่แล้ว คุณ Barbara เพิ่งจะมาขอลาครึ่งวันกับฉันเมื่อกี้นี้เอง บอกว่าอยากจะออกไปกับเพื่อนคนนึงน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030604
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030604,
					"content": "แต่ว่า เรื่องแบบนี้ไม่ค่อยจะเกิดขึ้นหรอกนะ... ที่คุณ Barbara ถึงกับขอลางานเพื่อเพื่อน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030605
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030605,
					"content": "เอาล่ะ พูดเรื่องสำคัญก่อนเถอะ เธอมาหาฉันที่นี่มีธุระอะไรงั้นเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030606
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030606,
					"content": "เกี่ยวกับ \"ปะการังต้มชาสุดซ่าในความฝันอันสุดยอดของฤดูร้อน\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030607
					]
				},
				{
					"id": 190030607,
					"content": "อ๋าา? คุณ Barbara จะออกไปซื้อเครื่องดื่มสุดพิเศษ... กับเธอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030608
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030608,
					"content": "อย่าบอกนะว่าเพื่อนที่คุณ Barbara พูดถึงก่อนหน้าก็คือเธอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030609
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030609,
					"content": "อาา... ถ้าเกิดเป็น \"อัศวินผู้มีเกียรติ\" อย่างเธอล่ะก็ ก็โอเคล่ะนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030610
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030610,
					"content": "เอาล่ะ ฉันพอจะเข้าใจแล้วล่ะ งั้นก็รบกวนเธอช่วยดูแลคุณ Barbara ทีนะ คุณ \"อัศวินผู้มีเกียรติ\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030611
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030611,
					"content": "ทำไม Barbara ต้องรายงานแผนการเดินทางในวันหยุดด้วยล่ะ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030612
					]
				},
				{
					"id": 190030612,
					"content": "เรื่องนี้น่ะเหรอ... เธอก็รู้นี่ ด้วยเหตุผลต่าง ๆ นานา ทำให้คุณ Barbara มีชื่อเสียงใน Mondstadt มาก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030613
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030613,
					"content": "ถึงแม้ว่าพวกชาวเมืองจะมีเจตนาที่ดี แต่เมื่อมันมากจนเกินไป คุณ Barbara ก็ไม่ไหวเหมือนกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030614
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030614,
					"content": "ถ้าเกิดเป็นช่วงเวลางาน พวกคนที่โบสถ์ก็ยังพอจะช่วยเธอออกมาจากวงล้อมได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030615
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030615,
					"content": "แต่ถ้าเป็นช่วงวันหยุด... อย่างนั้นคุณ Barbara ก็ต้องพึ่งตัวเองแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030616
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030616,
					"content": "แต่ว่าเธอก็อ่อนโยน... จนเกินไป มัวแต่จะคอยเติมเต็มความปรารถนาของชาวเมืองให้ได้อย่างถึงที่สุด จนถึงขั้นเหนื่อยกว่างานจริง ๆ ของตัวเองเสียอีก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030617
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030617,
					"content": "ฉันก็แค่คิดว่า ให้คุณ Barbara รายงานแผนการเดินทางของตนเองในวันหยุดซะหน่อย แล้วเมื่อถึงเวลาที่ต้องการให้พวกเราช่วยเธอออกมาจากฝูงชนล่ะก็ พวกเราจะได้รีบไปช่วยได้โดยทันที",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030618
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030618,
					"content": "ก็ได้แต่หวังให้คุณ Barbara เลิกฝืนตัวเองเสียที...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "Victoria"
				}
			]
		},
