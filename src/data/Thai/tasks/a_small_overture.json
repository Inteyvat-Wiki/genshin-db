			"dialogs": [
				{
					"id": 761860201,
					"content": "ชาสมุนไพรอร่อยมาก คุณ Sandrone ฉันสัมผัสได้ถึงความใส่ใจของคุณเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860202,
						761860203
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860202,
					"content": "(ขอนั่งแบบนี้อีกสักพักละกัน)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860204
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761860204,
					"content": "อื้ม งั้นครั้งหน้าให้ฉันชวนคุณมาจิบชาที่ \"ลูกหลานจันทราน้ำค้างแข็ง\" บ้างนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860203,
					"content": "ได้เวลาจบงานเลี้ยงน้ำชาแล้ว",
					"roleType": "TALK_ROLE_NPC",
