					"Rafiq"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230190101,
					"content": "ทำแบบนี้ใช้เงินเยอะกว่าอย่างที่คิดจริง ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190102
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190102,
					"content": "เธอกำลังพูดอะไรอยู่เหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230190103
					]
				},
				{
					"id": 230190103,
					"content": "อ่า สวัสดี ฉันกำลังวิจัยปัญหาการออกแบบของเรือลำนี้อยู่ แล้วตอนนี้... เจอปัญหาบางอย่างเข้าน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190104
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190104,
					"content": "พูดง่าย ๆ เลยก็คือฉันอยากให้เรือบรรทุกของได้มากขึ้นโดยไม่ต้องเพิ่มค่าใช้จ่าย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190105
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190105,
					"content": "เมื่อน้ำหนักเยอะ โครงสร้างของมันก็จะเสียหายได้ง่ายขึ้น และเมื่อความสมดุลของน้ำหนักมันไม่เท่ากันก็จะเกิดปัญหาขึ้น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190106
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190106,
					"content": "วิธีที่ดีที่สุดในการแก้ปัญหาพวกนี้ก็คือใช้วัสดุที่ดีกว่าเดิม แต่แบบนี้ก็จะทำให้ปัญหามันไปตกอยู่ที่ค่าใช้จ่าย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190107
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190107,
					"content": "เฮ้อ ที่จริงพูดไปก็เท่านั้น เพราะฉันไม่มีเงิน แค่คิดอยากจะสร้างเรือดี ๆ ขึ้นมาสักลำเท่านั้น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190108
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190108,
					"content": "เพราะฉะนั้นฉันเลยทำได้แค่คิดหาวิธีการและเทคนิคบางอย่างเพื่อที่จะเลี่ยงปัญหาที่ต้องใช้เงินน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190109
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190109,
					"content": "ทำแบบนี้ได้จริง ๆ เหรอ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230190110
					]
				},
				{
					"id": 230190110,
					"content": "ฮ่า ๆ ๆ พูดไปเธออาจจะไม่เชื่อ แต่จริง ๆ แล้วก็มีหลายคนเลยนะที่ทำแบบนี้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190111
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190111,
					"content": "ถึงยังไงเรือที่พวกเราสร้างทั้งหมดก็เป็นเรือประมงใกล้ชายฝั่งที่ไม่มีทางได้เจอกับคลื่นลมอะไรหรอก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190112
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190112,
					"content": "ทุกคนก็ปฏิบัติตามหลักการของการสร้างเรือที่ยึดถือกันไว้ ประหยัดได้ก็ประหยัด ซ่อมได้ก็ซ่อม... แก้ขัดไป แค่ใช้ได้ก็พอ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190113
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190113,
					"content": "ต้องขอบคุณหลักการนี้ที่ทำให้ธุรกิจการซ่อมเรือของเราไปได้ดีในทุก ๆ วัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190114
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190114,
					"content": "นักเดินทาง ถ้าเธอไม่มีปัญหาอะไร ก็ช่วยฉันตรวจเรือลำนั้นที่เพิ่งกลับมาถึงท่าเรือทีสิ มันดูเหมือนเป็นเพราะว่าบรรทุกของหนักบ่อย ๆ เลยเกิดปัญหานิดหน่อยน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190115
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190115,
					"content": "ฉันกำลังวิจัยปัญหาด้านนี้อยู่พอดีเลย และบางทีฉันอาจพบแรงบันดาลใจบางอย่างจากเรื่องนี้ก็ได้นะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190116,
						230190118
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190116,
					"content": "ให้ฉันจัดการเอง",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230190117
					]
				},
				{
					"id": 230190117,
					"content": "งั้นก็รบกวนเธอด้วยนะ ฉันต้องรีบไปซ่อมเรือลำอื่นแล้วล่ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190118,
					"content": "ทำไมเธอไม่ไปเองล่ะ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230190119
					]
				},
				{
					"id": 230190119,
					"content": "ฉันก็อยากไปเองเหมือนกันแหละ แต่มีคนไหว้วานให้ฉันไปซ่อมเรืออีกลำ ที่จะรีบออกไปเก็บอวนอีกรอบนึง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190120
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190120,
					"content": "เพราะงั้นก็เลยต้องรบกวนเธอด้วยนะ นักเดินทาง!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rafiq"
				}
			]
		},
