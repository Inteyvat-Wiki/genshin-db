			},
			"dialogs": [
				{
					"id": 721490201,
					"content": "#ยินดีต้อนรับที่กลับมานะ {NICKNAME} มีเรื่องอะไรรึเปล่า?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490202
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490202,
					"content": "เกี่ยวกับคำขอของคุณ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721490203
					]
				},
				{
					"id": 721490203,
					"content": "เราได้ Spirit Pearl ทั้งสี่เม็ดมาแล้วล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721490204,
					"content": "อย่างนั้นเหรอ? เป็นที่พึ่งได้ดีจริง ๆ ขอบคุณมากนะ! ทีนี้ก็เหลืออีกแค่ก้าวเดียว ก็จะสามารถปลดผนึกแห่ง \"หัวใจ\" ซึ่งเป็นผนึกอันสุดท้ายได้แล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490205
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490205,
					"content": "ต่อจากนี้คงต้องรบกวนให้ทั้งสองคนช่วยไปกับฉันหน่อย หวังว่าจะไม่รังเกียจนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490206
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490206,
					"content": "#ในเมื่อมาถึงขนาดนี้แล้ว จะไปต่ออีกสักหน่อยเราก็ไม่ถือสาหรอก! ใช่มั้ย {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490207,
						721490208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721490207,
					"content": "เอาสิ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721490209
					]
				},
				{
					"id": 721490209,
					"content": "งั้นอย่าเสียเวลาอยู่เลย เราออกเดินทางกันเถอะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490208,
					"content": "ฉันยังไงก็ได้",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721490209
					]
				}
			]
		},
