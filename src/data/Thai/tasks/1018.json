					"Childe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10031801,
					"content": "พวกเธอกลับมาได้ซักที เรื่องที่ Jueyun Karst เป็นยังไงบ้าง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031802
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031802,
					"content": "...อย่างนี้นี่เอง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031806,
					"content": "ไม่ได้เจอกับเซียนทุกตน... จากที่พวกเขาพูดก็คือ \"ไม่มีวาสนาได้เจอ\" งั้นสินะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031807
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031807,
					"content": "ไม่เป็นไร! ช่วงนี้ถ้าว่างล่ะก็ ลองไปเสี่ยงโชคดูอีกทีก็ได้นี่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031808
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031808,
					"content": "แล้วก็ แค่ข้อมูลของผู้กำราบอสูรก็มีค่ามากแล้วล่ะ ถือว่าเป็นของขวัญตอบแทนละกัน ฉันเองก็มีข้อมูลที่จะมอบให้เธอ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031809
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031809,
					"content": "ปฏิกิริยาของ Liyue Qixing ต่อการตายของเทพเจ้านั้นมันช่างน่าสงสัยจริง ๆ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031810
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031810,
					"content": "พวกเขาบอกว่าเพราะยังหาตัวมือสังหารไม่พบ ตอนนี้จึงไม่มีใครได้รับอนุญาตให้แสดงความเคารพต่อ \"Exuvia\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031811
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031811,
					"content": "ถึงขนาดพยายามที่จะปิดข่าว... แต่ก็เป็นถึงพิธีอัญเชิญเซียนที่มีผู้คนพลุกพล่าน แม้แต่ Qixing ก็ไม่สามารถหยุดข่าวลือได้หรอกนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031812
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031812,
					"content": "Exuvia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10031813,
					"content": "ในมุมมองของคน Liyue แล้ว ราชาแห่งหินก็เป็นเซียนตนหนึ่งนี่นา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031814
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031814,
					"content": "เทพแห่งหินก็คือเทพแห่งพันธสัญญา และในขณะเดียวกันก็เป็นบรรพบุรุษของเหล่าเซียน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031815
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031815,
					"content": "\"เซียนสามตาห้าร่าง\" ทั้งหมดในทุกวันนี้น่ะ ในตอนนั้นล้วนทำพันธสัญญาไว้ว่าจะปกป้องดูแล Liyue",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031816
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031816,
					"content": "อย่างนี้นี่เอง... นึกไม่ถึงว่าพวกเขาจะใส่ใจ Liyue ขนาดนี้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10031817,
					"content": "ถูกต้อง พวกเขามีทั้งความรับผิดชอบและมีความสามารถ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031818
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031818,
					"content": "...หากมีสิ่งผิดปกติเกิดขึ้นกับ Qixing ที่ปกครอง Liyue พวกเขาก็มีสิทธิ์ที่จะลงโทษ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031819
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031820,
					"content": "นี่ก็ถือเป็นเรื่องที่น่ารำคาญมากสำหรับฉันเหมือนกัน",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10031822
					]
				},
				{
					"id": 10031821,
					"content": "ฉันเองก็รับวิธีการอย่างนี้ไม่ได้เหมือนกัน",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10031822
					]
				},
				{
					"id": 10031819,
					"content": "วิญญาณของเทพแห่งหินนั้นขึ้นสู่สรวงสวรรค์และทิ้งไว้เพียงร่างกาย ทำไมถึงต้องให้ Qixing มาเก็บร่างของเขาไว้ด้วย? น่าสงสัยจริง ๆ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031820,
						10031821
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031822,
					"content": "อ๊ะ! ถูกต้อง แต่เดิมพวกเราก็มาเพื่อหาเทพตนนั้น!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031823
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10031823,
					"content": "ถ้าหากว่า Liyue Qixing นำ \"Exuvia\" ไปซ่อนไว้และไม่ให้ใครเข้าไปใกล้ล่ะก็...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031824
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10031824,
					"content": "#เป้าหมายของ {NICKNAME} ที่อยากจะตามหาเทพทั้งเจ็ดก็ล้มเหลวกันพอดีน่ะสิ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031825
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10031826,
					"content": "เกี่ยวอะไรกับคุณด้วย",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10031828
					]
				},
				{
					"id": 10031827,
					"content": "ไม่จำเป็นต้องบอก",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10031828
					]
				},
				{
					"id": 10031825,
					"content": "อื๋อ? พวกเธอกำลังตามหาเทพทั้งเจ็ด? ทำไมกันเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031826,
						10031827
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031828,
					"content": "หึ... เป็นคำตอบที่ไม่เลว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031829
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031829,
					"content": "อัศวินที่ถูกหลอกถามข้อมูลโดย \"Fatui\" อย่างง่ายดายก็คงจะไม่ใช่อัศวินที่ดีใช่มั้ยล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031830
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031830,
					"content": "แต่ว่า... เรื่องนี้ฉันก็ช่วยเธอเหมือนกันได้นะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031831
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031831,
					"content": "เอ๋? จริงเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031832
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10031832,
					"content": "ขอเวลาให้ฉันหน่อย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031833
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031833,
					"content": "ต้องใช้เวลา... เพื่อตามหาคน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031834
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031834,
					"content": "ฉันจะหาคนที่สามารถช่วยเธอให้หลุดพ้นจากทางตันนี้ไปได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031835
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031835,
					"content": "อา... น่าสนใจจริง ๆ ยิ่งความรู้สึกหดหู่ถูกเก็บไว้อย่างสงบมากแค่ไหน สุดท้ายแล้วเมื่อความวุ่นวายระเบิดออกมาก็จะยิ่งรุนแรงมากเท่านั้น...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031836
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031836,
					"content": "เพื่อที่จะมองเห็นความวุ่นวายที่ซ่อนอยู่ด้วยตาของตัวเอง ยังไงก็ต้องมีชีวิตอยู่ถึงวันที่จะมาเจอฉันอีกรอบนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Childe"
				}
			]
		},
