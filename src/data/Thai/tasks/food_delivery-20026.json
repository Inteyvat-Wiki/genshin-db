			"dialogs": [
				{
					"id": 200260101,
					"content": "ออเดอร์เดลิเวอรี่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260102
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260102,
					"content": "นักเดินทาง! มาพอดีเลย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260103
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260103,
					"content": "อื๋อ? เธอบอกว่าเธอแค่จะมาอะไรกินเหรอ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260104
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260104,
					"content": "ฉัน ฉันรู้แล้ว แต่ขอให้เธอช่วยฉันหน่อยได้มั้ย ฉันจะให้อาหารสุดอร่อยกับเธอเพื่อตอบแทนอย่างแน่นอน!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260105
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260105,
					"content": "คุณ Ernest จาก Dawn Winery มักจะมาที่นี่เพื่อสั่งกับแกล้ม แถมยังมักจะขอเพิ่มส่วนประกอบแปลก ๆ เสมอ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260106
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260106,
					"content": "อืม... ครั้งนี้ถึงแม้อาหารที่เขาสั่งจะเป็น <color=#00E1FFFF>Fried Radish Balls</color> แต่เขาก็ให้เราเพิ่มไข่เข้าไป แต่ไข่ของร้านเราหมดซะแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260107
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260107,
					"content": "เพราะงั้น เธอช่วยฉันหาไข่ไก่หน่อยได้มั้ย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260108,
						200260111
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260108,
					"content": "โอเค แต่ว่า...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200260109
					]
				},
				{
					"id": 200260109,
					"content": "ที่ Windrise น่าจะมีไข่ไก่เยอะนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260110
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260110,
					"content": "ถ้างั้นก็ช่วยหน่อยนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260111,
					"content": "หิวจังเลย ฉันแค่จะมาหาข้าวกินน่ะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200260112
					]
				},
				{
					"id": 200260112,
					"content": "ที่ Windrise น่าจะมีไข่ไก่เยอะนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260113
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260113,
					"content": "รอเธอช่วยฉันเสร็จแล้ว ฉัน ฉันจะสั่งอาหารจานพิเศษของ Good Hunter ให้กับเธอ ยังไงช่วยหน่อยนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				}
			]
		},
