				},
				{
					"id": 120000202,
					"content": "จะลองถามมั้ยล่ะว่าที่นี่มี \"หนังสือนำเที่ยว Teyvat\" ฉบับของ Liyue มั้ย? หนังสือนั่นน่ะสนุกมากเลยนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1200003,
			"completionStepIds": [
				1200003
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
