			"dialogs": [
				{
					"id": 120000201,
					"content": "\"Wanwen Bookhouse\"...ที่นี่คือร้านหนังสือของท่าเรือ Liyue ใช่มั้ย",
					"roleType": "TALK_ROLE_NPC",
