						3071102
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071102,
					"content": "หือ...เข้ามาใกล้อีกหน่อยสิ...ได้กลิ่นไหม?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
