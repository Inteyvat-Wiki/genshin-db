					"Vermeer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710330301,
					"content": "นี่ก็คือหมู่บ้าน Qingce Village สินะ... แล้วนักกวีคนนั้นล่ะ? ไปหาแรงบันดาลใจที่ไหนซะแล้วล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330302
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330302,
					"content": "คราวก่อนเราเจอเขากำลังเล่นทายปริศนาโคมกับพวกเด็ก ๆ อยู่...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330303
					]
				},
				{
					"id": 710330303,
					"content": "ทะ...ทายปริศนาโคม? นี่มันเรื่อง...อะไรกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330304
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330304,
					"content": "หรือเขาหาแรงบันดาลใจไม่เจอ เลยคิดจะยอมแพ้งั้นเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330305
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330305,
					"content": "ช่างเถอะ ไม่ว่าเขาจะทำอะไรอยู่ก็ตาม แต่เทศกาล Lantern Rite น่ะใกล้จะจบลงแล้ว จะมัวเสียเวลาอยู่ไม่ได้แล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330306
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330306,
					"content": "เราไปถามผู้ดูแลหมู่บ้านกันเถอะ วันนี้ฉันต้องวัดกับเขาให้รู้ดำรู้แดงกันไปเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				}
			]
		},
