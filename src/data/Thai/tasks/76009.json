				]
			},
			"dialogs": [
				{
					"id": 760090201,
					"content": "อืม... ดูเหมือนจะไม่ใช่ชิ้นนี้นะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090202
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090202,
					"content": "#โอ๊ะ สวัสดี {M#พี่ชาย}{F#พี่สาว}ที่ไม่เคยเจอมาก่อน แล้วก็... อืม คุณภูตสีขาว?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090203
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090203,
					"content": "#ยินดีต้อนรับ{M#พี่ชายพี่สาว}{F#พวกพี่สาว}สู่หอจันทราน้ำค้างแข็ง! มีอะไรให้ช่วยรึเปล่า?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090204
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090204,
					"content": "#เปล่าหรอก แค่เห็นเธออยู่ตรงนี้คนเดียว ก็เลยสงสัยนิดหน่อยน่ะ งั้นขอแนะนำตัวเลยละกันนะ ฉันชื่อ Paimon ส่วน{M#เขา}{F#เธอ}คือ {NICKNAME}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090205,
					"content": "#อื้ม ๆ งั้นก็พี่ {NICKNAME} กับพี่ Paimon! ดูเหมือนพวกพี่จะไม่ใช่คนจากเมือง Nasha สินะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090206,
						760090208
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090206,
					"content": "พวกเราเป็นนักผจญภัยน่ะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760090207
					]
				},
				{
					"id": 760090207,
					"content": "#ใช่แล้ว {NICKNAME} กับฉันเป็นนักผจญภัยที่เก่งกาจมาก ๆ เลยล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090211,
					"content": "ดีจังเลย ได้ไปผจญภัยในที่ต่าง ๆ กับเพื่อนที่แสนดี ได้เห็นทิวทัศน์ที่แตกต่าง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090212
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090212,
					"content": "ใช่ ๆ พวกเราไปมาหลายที่มาก ๆ แล้วล่ะ งั้นเมื่อกี้เธอมาทำอะไรอยู่ที่นี่คนเดียวล่ะ? หาอะไรอยู่งั้นเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090213,
					"content": "อื้ม หนูกำลังหาก้อนหินสวย ๆ อยู่น่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090214
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090214,
					"content": "อ๋อ เข้าใจแล้ว เอาไว้สะสมสินะ! ไม่ใช่แค่เด็ก ๆ หรอกนะ ผู้ใหญ่บางคนก็มีงานอดิเรกแบบนี้เหมือนกัน!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090215,
					"content": "เอ๊ะ ไม่ใช่นะ? หนูจะใช้ก้อนหินสวย ๆ ไปซื้อใจ Mai แล้วให้เธอมาลักพาตัวหนูไป",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090216
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090216,
					"content": "อ๋อ ๆ ที่แท้ก็แบบนี้เอง เพื่อให้เธอลักพา... เดี๋ยวก่อน ๆ เธอพูดอะไรอยู่น่ะ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090217,
						760090218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090217,
					"content": "ฟังดูแปลก ๆ นะ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760090220
					]
				},
				{
					"id": 760090220,
					"content": "#เอ๊ะ? พี่ {NICKNAME} ไม่เคยได้ยินเรื่องราวของจอมโจรผู้ยิ่งใหญ่ Reed Miller กับเจ้าหญิงภูตเหรอ? Mai บอกหนูว่า คนข้างนอกก็เคยฟังกันทั้งนั้น...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090221
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090221,
					"content": "\"มาเถอะ คุณหนูผู้มีดวงตาสว่างไสวดุจแสงจันทร์ ให้ฉันใช้อัญมณีที่คู่ควรกับดวงตาของคุณนี้มาซื้อหัวใจของคุณ แล้วลักพาตัวคุณหนีจากกรงทองนี้...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090222
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090222,
					"content": "ถึงหนูจะไม่ค่อยเข้าใจว่าเรื่องนี้มันหมายถึงอะไรกันแน่ แต่แค่มอบของที่อีกฝ่ายชอบ ก็จะได้ไปผจญภัยกับอีกฝ่ายล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090223,
						760090225
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090223,
					"content": "คำพูดนั้นคงไม่ได้หมายความ แบบนั้นหรอกนะ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760090224
					]
				},
				{
					"id": 760090224,
					"content": "ชะ...ใช่แล้ว ความหมายของคำพูดนั้นจริง ๆ แล้วคือ... เอ่อ เอาเป็นว่าไม่ใช่อะไรที่เด็ก ๆ ควรจะอ่านกันหรอกนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090227,
					"content": "จะว่าไป Mai ที่เธอว่าน่ะเป็นใครกันเหรอ? เล่าเรื่องแปลก ๆ แบบนี้ให้เด็กฟัง ฉันว่าคงเป็นคนที่ไม่ได้มีเจตนาดีอะไรหรอก...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090228,
					"content": "Mai ไม่ใช่คนไม่ดีอะไรหรอก อายุก็ประมาณหนูนี่แหละ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090229
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090229,
					"content": "#ก็เหมือน{M#พี่ชายพี่สาว}{F#พวกพี่สาว}นั่นแหละ เป็นนักผจญภัยที่มาจากข้างนอก! ก่อนหน้านี้เธอทำตัวลับ ๆ ล่อ ๆ อยู่แถว ๆ ค่ายคนเดียว แล้วก็ถูกหนูจับได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090230
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090230,
					"content": "ไม่รู้ทำไม เธอเหมือนจะคิดว่าพวกเราเป็นกลุ่มคนประหลาดน่ากลัว ที่จะเอาเด็ก ๆ ที่จับได้ไปถวายให้ท่านเทพจันทรา เลยแกล้งทำเป็นใจเย็น พลางโน้มน้าวไม่ให้หนูฆ่าเธอ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090231
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090231,
					"content": "ปะ...เป็นการเข้าใจผิดที่แปลกมากเลย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090232,
					"content": "ใช่มั้ยล่ะ? หนูก็ไม่รู้เหมือนกันว่า Mai ไปได้ยินข่าวลือแบบนี้มาจากไหน แปลกจริง ๆ เลยนะ แต่เพราะมันดูน่าสนุกดี หนูเลยไม่ได้แย้งอะไรเธอ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090233
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090233,
					"content": "ในเวลาแบบนี้เธอก็แย้งซะหน่อยสิ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090234,
					"content": "สรุปก็คือ เพื่อเป็นการแลกเปลี่ยน Mai ตกลงจะเป็นเพื่อนที่ดีที่สุดของหนู แล้วยังเล่าเรื่องราวข้างนอกให้หนูฟังเยอะแยะเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090235
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090235,
					"content": "ปกติพ่อแม่จะไม่ให้หนูอ่านเรื่องราวจากข้างนอก บอกว่ามีแต่ผู้ไร้ศรัทธาถึงจะชอบเรื่องไร้สาระแบบนั้น... แต่ว่า เรื่องที่ Mai เล่าให้ฟังก็สนุกมากเลยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090236
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090236,
					"content": "อย่างเช่น ชาวประมงที่ตกหลุมรักภูต จอมโจรผู้ยิ่งใหญ่ที่เคยจบชีวิตไปถึงสามครั้ง แต่ก็หนีรอดจากเงื้อมมือของนายหญิงแห่งยมโลกมาได้ทั้งสามครั้ง แล้วก็วิญญาณที่ปรารถนาจะกลายเป็นมนุษย์...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090237
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090237,
					"content": "ทั้งคนดี คนที่ไม่ได้ดีนัก คนชั่วของชั่วของชั่วที่สุด ไม่ว่าจะร่ำรวยหรือยากจน เที่ยงธรรมหรือชั่วร้าย สุดท้ายทุกคนก็เหมือนกัน จบชีวิตอยู่ท่ามกลางความทุกข์ทรมาน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090238,
						760090240
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090238,
					"content": "ฉันว่าพ่อแม่เธอพูดถูกแล้ว เป็นเรื่องไร้สาระจริง ๆ นั่นแหละ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760090239
					]
				},
				{
					"id": 760090239,
					"content": "ใช่แล้ว เรื่องแบบนี้ไม่เหมาะจะเล่าให้เด็กฟังจริง ๆ แหละนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090243,
					"content": "แต่ว่า หนูไม่ใช่เด็กแล้วนะ เมื่อก่อน Mai ก็บอกว่า โลกข้างนอกน่ะวุ่นวายมาก ไม่เหมาะกับเด็กอย่างหนู...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090244
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090244,
					"content": "ทั้ง ๆ ที่เธอยังใช้พรของ{RUBY#[S]แรงจันทราผัน}ท่านเทพจันทราไม่ได้เลย อายุก็ไล่เลี่ยกับหนู",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090245
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090245,
					"content": "แต่ไม่เป็นไร หนูฉลาดมากนะ ก่อน Mai จะถูกหนูจับได้ เธอพึมพำถึง \"ก้อนหิน\" อะไรนั่นอยู่ตลอดเลย แสดงว่าเป้าหมายของเธอก็คือรวบรวมก้อนหินสวย ๆ สินะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090246
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090246,
					"content": "ถ้าหนูหา<color=#00E1FFFF>ก้อนหินสวย ๆ</color> ได้ หนูจะต้องซื้อใจเธอได้แน่ ๆ แล้วเธอก็จะพาหนูไปจากที่นี่ เหมือนที่ Reed Miller ลักพาตัวคุณภูตไปแบบนั้นใช่มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090247
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090247,
					"content": "เลิกใช้คำว่า \"ซื้อใจ\" ได้แล้วน่า! ที่จริงก็แค่อยากหาก้อนหินสวย ๆ ไปให้เพื่อนที่แสนดีเองนี่ ไม่ต้องพูดจาแปลก ๆ แบบนั้นก็ได้!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090248
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090248,
					"content": "อืม... ยังไงพวกเราก็จะเดินดูแถว ๆ นี้อยู่แล้ว ถ้าเจอชิ้นส่วนสวย ๆ อะไร ก็จะเอากลับมาให้ละกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090249
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090249,
					"content": "#ว้าว จริงเหรอ? ขอบคุณมากนะ {M#พี่ชายพี่สาว}{F#พวกพี่สาว}ใจดีจัง!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090240,
					"content": "อยากฟังจัง เล่าให้ละเอียด ๆ หน่อยได้มั้ย?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760090241
					]
				},
				{
					"id": 760090241,
					"content": "หืม? ได้สิ ก็อย่างเช่น \"Shadow Weasel\" สหายของ Reed Miller ที่สาบานว่าจะไม่ก้าวไปใต้แสงจันทร์อีก...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090242
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090242,
					"content": "เฮ้ ตอนนี้ไม่ใช่เวลามาคุยเรื่องแบบนี้นะ! แถมเรื่องแบบนี้ก็ไม่เหมาะจะเล่าให้เด็กฟังด้วย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090225,
					"content": "ใช่แล้วล่ะ Paimon ก็ถูกฉัน ลักพาตัวมาแบบนี้เหมือนกัน...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760090226
					]
				},
				{
					"id": 760090226,
					"content": "#เฮ้! อย่าสอนเด็กแบบผิด ๆ สิ! ถึงแม้ว่าฉันจะชอบอาหารที่ {NICKNAME} ทำที่สุดจริง ๆ ก็เถอะ... ตะ...แต่ว่ามันเรียกว่าลักพาตัวไม่ได้หรอกนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090218,
					"content": "ก็คงเป็นเรื่องปกติใน Nod-Krai...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760090219
					]
				},
				{
					"id": 760090219,
					"content": "แม้แต่ใน Nod-Krai ก็ไม่ปกติหรอกนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090208,
					"content": "ความจริงแล้วฉันคือผู้บงการตัวจริง ที่อยู่เบื้องหลังเมือง Nasha...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760090209
					]
				},
				{
					"id": 760090209,
					"content": "#ว้าว ฟังดูเท่จังเลย! งั้นหนูเป็นผู้ติดตามของพี่ {NICKNAME} ได้มั้ย? เหมือนในเรื่องเล่าไงล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090210
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090210,
					"content": "เธอพูดเพ้อเจ้ออะไรเนี่ย พวกเราก็แค่นักผจญภัยที่ผ่านมาที่นี่! ไม่ได้มีแผนการควบคุมกองกำลังต่าง ๆ ในเมือง Nasha และอยู่เบื้องหลังอะไรนั่นหรอก... น่าจะไม่นะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090211
					],
					"speakerTitle": "Paimon"
				}
			]
		},
