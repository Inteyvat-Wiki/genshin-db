			"dialogs": [
				{
					"id": 220250401,
					"content": "โอ๊ะโอ เราได้คำตอบที่ไม่เหมือนกันแฮะ ทั้ง Jueyun Guoba และ Bamboo Shoot Soup ต่างก็เป็นอาหารพิเศษ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220250402,
					"content": "สรุปทำอะไรดี? ลังเลจัง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220250403,
					"content": "Paimon คิดว่าน่าจะทำอะไรดีล่ะ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250404
					]
				},
				{
					"id": 220250404,
					"content": "ห๊า? ฉันเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250405
					],
					"speakerTitle": "Paimon"
				},
