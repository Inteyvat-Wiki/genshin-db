			"dialogs": [
				{
					"id": 220190101,
					"content": "...ถ้างั้น รบกวนทั้งสองคนด้วยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190102
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190102,
					"content": "เรื่องนี้ให้พวกเราดูแลเอง วางใจได้คุณ Sango",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190103
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220190103,
					"content": "ที่แท้ก็เส้นผมบังภูเขานี่เอง เป็นคนที่ใจกล้าไม่เบา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190104
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220190104,
					"content": "อีกอย่าง ยังใช้... สถานะแบบนั้นด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190105
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220190105,
					"content": "แต่ไม่ว่ายังไง เส้นทางโจรของเขาคงจะสิ้นสุดลงในวันนี้นี่แหละ Ryuuji เรื่องที่ฉันให้ทำนายจำได้ใช่มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190106
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190106,
					"content": "จำได้ฮะ ท่านประธาน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190107
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220190107,
					"content": "งั้นก็ดี... นักเดินทาง เธอมาแล้วเหรอ เยี่ยมเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190108,
						220190109
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190108,
					"content": "จะไปจับคนร้ายเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190111
					]
				},
				{
					"id": 220190111,
					"content": "เรามีหลักฐานเพียงพอแล้ว และฉันก็เข้าใจในพฤติกรรมของคนร้ายแล้วด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190112
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190112,
					"content": "นักเดินทาง เธอกับ Ryuuji แล้วก็คุณ Andou กับคุณ Amano ไปด้วยกันนะ เอาตัวคนร้ายคนนั้นมาลงโทษให้ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190113
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190113,
					"content": "เจ้าหมอนั่นน่าจะมีคนสมรู้ร่วมคิดไม่น้อยเลย แต่ถ้ามีเธออยู่ โอกาสที่เราจะทำได้สำเร็จก็มากขึ้นไปอีก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190114,
						220190117
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190114,
					"content": "ให้ฉันทำอะไรเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190115
					]
				},
				{
					"id": 220190115,
					"content": "ใช้พลังของเธอขู่ให้คนร้ายกลัว เพื่อกันไม่ให้เขาทำอะไร...ที่โง่ ๆ น่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190116
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190116,
					"content": "แต่ฉันคิดว่าขโมยที่เอาแต่ทำตัวลับ ๆ ล่อๆ แบบนั้น คงไม่กล้าจะทำอะไรรุนแรงหรอก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190121
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190121,
					"content": "ถ้าฉันเดาไม่ผิดล่ะก็ ตอนนี้เจ้าหมอนั่นน่าจะไปอยู่ในป่าแล้ว คงเตรียมเอาของที่ขโมยมาไปฝังดิน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190122
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190122,
					"content": "ถ้าพวกเธอไปตอนนี้ ก็น่าจะจับคนร้ายได้พอดี รีบออกเดินทางเถอะ ฉันจะรอข่าวดีจากพวกเธออยู่ที่นี่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190117,
					"content": "คุณไม่ไปด้วยกันเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190118
					]
				},
				{
					"id": 220190118,
					"content": "สำหรับฉันแล้ว คดีนี้เสร็จสิ้นแล้วล่ะ ส่วนที่เหลือฉันคงไม่เข้าไปร่วมด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190119
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190119,
					"content": "นักเดินทาง เธอก็ใช้พลังของเธอขู่ให้คนร้ายกลัว เพื่อกันไม่ให้เขาทำอะไร...ที่โง่ ๆ น่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190120
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190120,
					"content": "แต่ฉันคิดว่าขโมยที่เอาแต่ทำตัวลับ ๆ ล่อๆ แบบนั้น คงไม่กล้าจะทำอะไรรุนแรงหรอก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190121
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190109,
					"content": "จะปิดคดีแล้วเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190110
					]
				},
				{
					"id": 220190110,
					"content": "อืม ขอแค่ทุกอย่างราบรื่น วันนี้ก็น่าปิดคดีได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190111
					],
					"speakerTitle": "Sango"
				}
			]
		},
