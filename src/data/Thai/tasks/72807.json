				{
					"id": 728070303,
					"content": "จดหมายฉบับนี้ คุณหนู Hiiragi Chisato ฝากให้เธอมาส่งงั้นเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070304
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
