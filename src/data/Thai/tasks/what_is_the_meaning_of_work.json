			"dialogs": [
				{
					"id": 240110401,
					"content": "ขอบคุณนะ ฉันเห็นแล้วล่ะ ต้องรีบกินมันฝรั่งทอดให้หมด ในตอนที่นกนางนวลสีม่วงทองพวกนั้นไม่อยู่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110402
					],
					"speakerTitle": "Iaune"
				},
