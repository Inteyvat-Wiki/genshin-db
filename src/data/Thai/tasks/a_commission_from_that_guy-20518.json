				"objectNames": [
					"Vile"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205180201,
					"content": "#{F#เธอ}{M#นาย}กลับมาแล้วเหรอ อื้อหือ ทำงานเร็วเหมือนกันนะเนี่ย ฉันเข้าใจแล้วว่าทำไมสุภาพบุรุษท่านนั้นชอบ{F#เธอ}{M#นาย}ขนาดนี้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180202,
						205180204
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180202,
					"content": "เอาค่าตอบแทนมาได้แล้ว",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180203
					]
				},
				{
					"id": 205180203,
					"content": "เย็นชาจริงนะ...เอาเถอะ ฉันจะจ่ายค่าตอบแทนให้คุณเดี๋ยวนี้แหละ คุณต้องเข้าใจนะ ว่าฉันน่ะเป็นแค่ช่วยจัดการธุระให้แค่นั้น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180204,
					"content": "ถือเป็นเกียรติสำหรับฉัน",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180205
					]
				},
				{
					"id": 205180205,
					"content": "ไม่เป็นไร ไม่เป็นไร ค่าตอบแทนเหล่านี้ถือดี ๆ ล่ะ แล้วก็...ยินดีที่ได้ร่วมงานกันนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				}
			]
		},
		{
			"id": 2051803,
			"completionStepIds": [
				2051805
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
