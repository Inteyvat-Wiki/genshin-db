			"dialogs": [
				{
					"id": 110030401,
					"content": "ฟู่ว...ฟู่ว...อุ่นขึ้นเยอะเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030402
					],
					"speakerTitle": "Olaf"
				},
				{
					"id": 110030402,
					"content": "ขอบคุณพวกเธอมากนะ ซุปถ้วยนี้อร่อยมากเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030403
					],
					"speakerTitle": "Olaf"
				},
				{
					"id": 110030403,
					"content": "ทำไมถึงเป็นอย่างนี้ไปได้ล่ะ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110030404
					]
				},
				{
					"id": 110030404,
					"content": "ทีแรกฉันมาเพื่อจับหมูป่า ไล่มาตั้งไกล แล้วมันก็หนีเข้าไปข้างใต้โบราณสถานนั่น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030405
					],
					"speakerTitle": "Olaf"
				},
				{
					"id": 110030405,
					"content": "ฉันก็ไล่ตามเข้าไป แล้วก็ดันไปเจอกับ Cryo Regisvine ที่ใหญ่มากกก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030406
					],
					"speakerTitle": "Olaf"
				},
				{
					"id": 110030406,
					"content": "ฉันถูกแช่แข็งในทันที เมื่อรู้สึกตัวก็รีบวิ่งออกมา แต่ว่าพอวิ่งมาถึงนี่ร่างกายก็ไปต่อไม่ไหวแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030407
					],
					"speakerTitle": "Olaf"
				},
				{
					"id": 110030407,
					"content": "Cryo Regisvine? ต้นไม้โจมตีคนได้ด้วยเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030408
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110030408,
					"content": "ใช่สิ เมื่อก่อนฉันฟังแค่คนอื่นพูด เป็นครั้งแรกเลยที่ได้เห็นกับตาตัวเอง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030409
					],
					"speakerTitle": "Olaf"
				},
				{
					"id": 110030409,
					"content": "ฟังดูอันตรายจังนะ... ยังไงพวกเราอย่าเข้าไปในโบราณสถานนั่นละกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110030410,
					"content": "ฟังดูแล้วมันน่าจะอร่อยนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030411,
						110030412
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110030411,
					"content": "...หา?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110030413
					]
				},
				{
					"id": 110030413,
					"content": "อันนี้แหละ! ส่วนประกอบที่ตามหา! ต้องอร่อยสุด ๆ แน่นอน!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030414
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110030414,
					"content": "หนาวเป็นบ้า ต้นที่ดูน่ากลัวขนาดนี้มันกินได้จริง ๆ เหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110030415,
					"content": "ไม่ลองก็ไม่รู้หรอก เร็วเข้า พวกเราไปกันเถอะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030416
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110030416,
					"content": "พุ่งไปอีกแล้ว...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030417,
						110030418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110030417,
					"content": "พวกเราต้องไปแล้วล่ะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110030419
					]
				},
				{
					"id": 110030419,
					"content": "ไม่เป็นไร ไม่ต้องสนใจฉัน แต่ต้องหยุดเธอคนนั้นให้ได้นะ มันอันตรายมาก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Olaf"
				},
				{
					"id": 110030418,
					"content": "คุณกลับไปที่ Springvale ก่อนก็แล้วกัน",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110030419
					]
				},
				{
					"id": 110030412,
					"content": "ยังเอาไปเชื่อมกับของกินได้อีกเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110030413
					]
				}
			]
		},
