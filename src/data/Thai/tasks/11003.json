			"dialogs": [
				{
					"id": 110030201,
					"content": "หนาว...หนาววจังเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030202
					],
					"speakerTitle": "Olaf"
				},
				{
					"id": 110030202,
					"content": "ตัวเขาเย็นมากเลย! ต้องรีบทำให้อุ่นก่อน!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030203
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110030203,
					"content": "งั้นก่อกองไฟที่นี่กันเถอะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110030204,
					"content": "อื้อ ถ้ามีซุปร้อน ๆ ด้วยก็จะดีมาก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030205
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110030205,
					"content": "#{NICKNAME} ฉันดูแลเขาอยู่ที่นี่ ยังไงวาน{F#เธอ}{M#นาย}ช่วยทำ<color=#00E1FFFF>ซุปร้อน ๆ อร่อย ๆ สักถ้วย</color>ให้หน่อยได้มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030206
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110030206,
					"content": "ฉันจำได้ว่าระหว่างทางมาที่นี่มีค่ายของพวก Hilichurl อยู่ ที่นั่นต้องมีที่ที่สามารถทำซุปได้แน่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030207
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110030207,
					"content": "ไม่มีปัญหา",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110030208
					]
				},
				{
					"id": 110030208,
					"content": "โอเค ถ้าทำเสร็จแล้วก็รีบกลับมานะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiangling"
				}
			]
		},
