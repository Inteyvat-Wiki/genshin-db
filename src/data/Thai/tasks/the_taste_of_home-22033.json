			"dialogs": [
				{
					"id": 220330201,
					"content": "กลับมาเร็วขนาดนี้เลย? แน่ใจนะว่าเธอไม่ได้เป็นเชฟแบบลับ ๆ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330202
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330202,
					"content": "อืม... ฉันจะอดใจรอไม่ไหวแล้ว ขอฉันชิมหน่อย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330203,
						220330204
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330203,
					"content": "เชิญทานได้เลย",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220330204,
					"content": "ฉันคิดก่อน... เมื่อกี้พูดถึงเมนูไหนแล้วนะ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330205
					]
				},
				{
					"id": 220330205,
					"content": "อ่า... มี Rice Bun, Lotus Flower Crisp, แล้วก็ Tricolor Dango!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220330206,
					"content": "ตัดสินใจได้แล้วก็ส่งให้ Tang Wen สิ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
