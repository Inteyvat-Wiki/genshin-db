				],
				"points": []
			},
			"dialogs": [
				{
					"id": 762180101,
					"content": "หืม? พวกเธอมาแล้วเหรอ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180102
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180102,
					"content": "สวัสดี! Sandrone",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180103,
						762180104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180103,
					"content": "ขอบคุณสำหรับคำเชิญนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762180105
					]
				},
				{
					"id": 762180105,
					"content": "เอ๊ะ ในจดหมายเธอบอกว่าจะจัดงานเลี้ยงน้ำชาไม่ใช่เหรอ? ทำไมที่นี่ไม่มีอะไรเลยล่ะ นี่เธอคงไม่ได้ลืมเตรียมน้ำชากับของว่างไว้ใช่มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180106,
					"content": "หึ ตลกน่า ดูถูกฉันมากไปแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180107
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180107,
					"content": "ว้าว! นี่... โต๊ะนี่โผล่ออกมาแบบปุบปับได้ยังไงเนี่ย?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180108,
					"content": "หึหึ เจ๋งใช่มั้ยล่ะ? นี่คือโต๊ะน้ำชาแบบพกพา ที่ฉันประดิษฐ์ขึ้นมาใหม่เองแหละ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180109
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180109,
					"content": "มันไม่ใช่แค่พกพาสะดวก และจัดเก็บง่ายเท่านั้นนะ แต่ยังติดตั้งอุปกรณ์ลอยตัวเหมือนของ Fagio ไว้ด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180110
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180110,
					"content": "ที่เจ๋งกว่านั้นคือ... เอ่อ ช่างเถอะ ฉันไม่อวยตัวเองดีกว่า เดี๋ยวจะหาว่าฉันขายของอยู่นั่น พวกเธอไปลองสัมผัสกันเองก็แล้วกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180111
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180111,
					"content": "เอาล่ะ นี่คือชากับขนมที่ฉันเตรียมไว้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180112
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180112,
					"content": "งั้นฉันไม่เกรงใจล่ะนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762180113
					]
				},
				{
					"id": 762180113,
					"content": "อื้ม...! อร่อยจัง! ฝีมือเธอสุดยอดไปเลย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180114,
					"content": "แน่นอนอยู่แล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180115
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180115,
					"content": "ว่าแต่อะไรดลใจให้เธอ สร้างอุปกรณ์แบบนี้ขึ้นมาเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180116,
					"content": "ก็เพื่อที่ว่าจะได้มีช่วงเวลางานเลี้ยงน้ำชาแสนสุขกับเพื่อน ๆ ได้ทุกที่ไงล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180117
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180117,
					"content": "ฉันเคยบอกไปแล้วนี่ วิธีที่จะรักษาสิ่งล้ำค่าเอาไว้ ไม่ได้มีแค่การยึดติดกับสิ่งที่มีอยู่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180118
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180118,
					"content": "ตอนนี้ฉันกลายเป็นคนที่อยากจะออกไปข้างนอก และไปเจอเพื่อน ๆ ให้มากขึ้น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180119
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180119,
					"content": "แต่ถ้าจะให้คนที่ได้รับคำเชิญต้องมาเตรียมของว่างและเก็บโต๊ะน้ำชา มันก็ดูจะไม่ค่อยจะสมกับมารยาทของสุภาพสตรีสักเท่าไหร่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180120
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180120,
					"content": "อิอิ แต่ฉันว่าเพื่อน ๆ ไม่ถือสาหรอกนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180121,
					"content": "แต่ฉันถือนี่นา อีกอย่าง สิ่งประดิษฐ์ง่าย ๆ แบบนี้ก็ไม่ได้ลำบากอะไรสำหรับฉันเลยด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180122
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180122,
					"content": "ในเมื่อพวกเธอชอบมันขนาดนี้ งั้นฉันให้พวกเธอตัวนึงก็ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180123
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180123,
					"content": "เอ๊ะ?! จะดีเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180124,
					"content": "ไม่เป็นไรหรอกน่า ฉันบอกแล้วไงว่าฉันถนัดทำของพวกนี้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180125
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180125,
					"content": "งั้นก็ขอบคุณนะ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762180126
					]
				},
				{
					"id": 762180126,
					"content": "ไม่ต้องเกรงใจหรอก ตอนเทศกาล Fontinalia พวกเธอก็ช่วยฉันไว้เยอะเหมือนกัน ถือซะว่าเป็นของตอบแทนจากสุภาพสตรีก็แล้วกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180104,
					"content": "หวังว่าเธอไม่ได้รอนานเกินไปนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762180105
					]
				}
			]
		}
	]
}