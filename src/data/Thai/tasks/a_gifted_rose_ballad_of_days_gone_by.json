			"dialogs": [
				{
					"id": 732030602,
					"content": "นี่เป็น Sumeru Rose ที่ฉันเก็บมาได้",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030603
					]
				},
				{
					"id": 732030603,
					"content": "ช่างเป็นดอกไม้ที่ทำให้คนหวนนึกถึงจริง ๆ... ฉันเตรียมของขวัญไว้ให้แล้วนะ รับไปสิ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030604
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030604,
					"content": "มันเป็นเมล็ดที่ปลูกที่นี่ไม่ได้ ถ้าคุณมีบ้านอยู่ที่อื่น คุณคงจะได้เห็นพวกมันเจริญเติบโต",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				}
			]
		},
		{
			"id": 7320307,
			"completionStepIds": [],
