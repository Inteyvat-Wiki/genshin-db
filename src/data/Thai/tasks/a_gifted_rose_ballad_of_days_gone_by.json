			"dialogs": [
				{
					"id": 732030701,
					"content": "มาคุยกับฉันเหรอ? ฉันมีเรื่องจะเล่าให้ฟังเยอะแยะเลยนะ",
					"roleType": "TALK_ROLE_NPC",
