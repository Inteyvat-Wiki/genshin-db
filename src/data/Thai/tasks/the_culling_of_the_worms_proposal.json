	"talks": [
		{
			"id": 7351101,
			"completionStepIds": [
				7351101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7351101",
							"2"
						],
						"stepId": 7351101,
						"stateName": "QUEST_STATE_UNFINISHED"
