					"Arataki Itto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726840601,
					"content": "#ฮ่าฮ่าฮ่าฮ่าฮ่าฮ่าฮ่า! เพื่อนรักของฉัน! ในที่สุด{M#นาย}{F#เธอ}ก็มาถึงจนได้!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840602
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840602,
					"content": "#กำลังคิดอยู่เลยว่าจะได้เจอกับ{M#นาย}{F#เธอ}เมื่อไหร่ แล้ว{M#นาย}{F#เธอ}ก็มาถึงพอดี ฉันล่ะดีใจจริง ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840603
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840603,
					"content": "ดูสถานที่ของฉันสิ เป็นไงบ้าง? เป็นตัวเลือกที่สุดยอดไปเลยใช่มั้ยล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840604
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840604,
					"content": "ห้อมล้อมไปด้วยทะเลทั้งสามด้าน อากาศสดชื่น ห่างไกลจากความวุ่นวายในเมือง มีวิวหลักล้านให้นั่งชม",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840605
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726840605,
					"content": "แถมมีฉากหลังเป็น Amakane Island ราวกับได้รับสิทธิพิเศษในการเข้าถึงแพ็กเกจสุดหรูของศูนย์กลางวัฒนธรรมแห่งงานเทศกาลเลยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840606
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 726840606,
					"content": "มีระบบขนส่งทั้งทางบกและทางน้ำที่พัฒนา ไม่ว่าจะเดินทางด้วยเท้าหรือทางเรือก็ล้วนถึงจุดหมายได้อย่างสะดวกสบาย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840607,
						726840608
					],
					"speakerTitle": "Genta"
				},
				{
					"id": 726840607,
					"content": "เป็นสถานที่ที่ไม่เลวจริง ๆ เลยล่ะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840609
					]
				},
				{
					"id": 726840609,
					"content": "ทันทีที่เห็นสถานที่ตรงนี้ ฉันก็ตัดสินใจทันที ว่าตรงนี้แหละ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840610
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840610,
					"content": "ในช่วงเวลานั้น โลกนั้นดูแตกต่างออกไปเลยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840611
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840611,
					"content": "ลูกพี่หลักแหลมสุด ๆ!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840612
					],
					"speakerTitle": "Genta"
				},
				{
					"id": 726840612,
					"content": "อันที่จริงแล้วคงถูกคนของสำนัก Tenryou ไล่มาสินะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840613,
					"content": "แค่ก ๆ... พวกเรามาคุยธุระกันก่อนเถอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840614
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840614,
					"content": "ที่เชิญพวกเธอมาครั้งนี้ ก็เพราะอยากชวนพวกเธอมาเข้าร่วมงานมหกรรมเทศกาลตีกลองโห่ร้องแห่ง Arataki! นี่เป็นเทศกาลที่ยิ่งใหญ่และสำคัญมาก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840615
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840615,
					"content": "ลูกพี่บอกว่า หนึ่งคือได้โปรโมตชื่อเสียงแก๊ง Arataki ของเรา เพื่อสะดวกต่อการรับสมาชิกใหม่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840616
					],
					"speakerTitle": "Genta"
				},
				{
					"id": 726840616,
					"content": "อย่างที่สองก็เพื่อฉลองงานจบการศึกษาให้กับพี่ Shinobu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840617
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726840617,
					"content": "และสุดท้ายคือสามารถชดเชยการจัดกิจกรรมนอกสถานที่ก่อนหน้านี้ ที่ถูกเลื่อนออกไปเพราะขาดเงินทุนด้วยน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840618
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 726840618,
					"content": "มีประโยชน์เยอะแยะจริง ๆ ด้วยแฮะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840619
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840619,
					"content": "Akira... ข้อสุดท้ายไม่ต้องพูดก็ได้มั้ง",
