				"points": []
			},
			"dialogs": [
				{
					"id": 4670101,
					"content": "อาหารจานต่อไปจะทำอะไรดีนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670102
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670102,
					"content": "อื๋อ? พวกเธอเองก็เป็นนักผจญภัยแถวนี้งั้นเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670103
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670103,
					"content": "แค่นักเดินทางที่เดินผ่านมาน่ะ เธอกำลังเตรียมทำอาหารงั้นเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4670104,
					"content": "โอ้ นักเดินทางนี่เอง ยินดีต้อนรับนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670105
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670105,
					"content": "ฉันชื่อ Lynn ผู้เชี่ยวชาญด้านการเอาชีวิตรอดแห่งกิลด์นักผจญภัย ก็อย่างที่เห็น ฉันกำลังศึกษาการทำอาหารอยู่น่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670106
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670106,
					"content": "\"กินให้อิ่มท้องก่อนไป\" คือกฎข้อแรกของ \"คู่มือเอาตัวรอดในโลกกว้าง\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670107
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670107,
					"content": "ปิกนิกเหรอ! ฉันก็ชอบมาก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4670108,
					"content": "เพื่อนร่วมทางของฉันก็ทำอาหารเก่งนะ ใช่ไหมๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670801,
						4670901
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4670801,
					"content": "ฉันทำได้แค่อย่างที่ง่ายๆน่ะ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4670802
					]
				},
				{
					"id": 4670802,
					"content": "ไม่เป็นไร ไฟติดแล้ว ให้ฉันดูฝีมือของเธอหน่อยสิ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670803
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670803,
					"content": "ผู้เชี่ยวชาญด้านการเอาชีวิตรอดมาให้คำแนะนำถึงที่ โอกาสแบบนี้ไม่ได้มีบ่อย ๆ หรอกนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671001
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4671001,
					"content": "ฉันใส่เห็ดกับเนื้อเข้าไปในหม้อนั้น ลองทำ <color=#00E1FFFF>Chicken-Mushroom Skewer</color> ให้หน่อยสิ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670901,
					"content": "ถูกต้อง ฉันก็ชอบทำอาหารเหมือนกัน",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4670902
					]
				},
				{
					"id": 4670902,
					"content": "โอ้! ไฟติดแล้ว ให้ฉันดูฝีมือของเธอหน่อยสิ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670903
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670903,
					"content": "มันเยี่ยมมากเลยที่มีคนมาร่วมฝึกด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671001
