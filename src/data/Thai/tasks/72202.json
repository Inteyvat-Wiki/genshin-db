				"points": []
			},
			"dialogs": [
				{
					"id": 722020101,
					"content": "Thunderbird ผู้ยิ่งใหญ่... ท่านทิ้งข้าน้อยไปแล้วเหรอ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020102,
						722020103
					],
					"speakerTitle": "Chise"
				},
				{
					"id": 722020102,
					"content": "สวัสดี?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722020104
					]
				},
				{
					"id": 722020104,
					"content": "Thunderbird ผู้ยิ่งใหญ่... ขอท่านอย่าได้โกรธเคืองเลย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020105
					],
					"speakerTitle": "Chise"
				},
				{
					"id": 722020105,
					"content": "ข้าน้อยจะอ่านความต้องการของท่าน และอ่านคำสอนของท่านอย่างเต็มที่... แต่ว่า... แต่ว่า...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020106
					],
					"speakerTitle": "Chise"
				},
				{
					"id": 722020106,
					"content": "แต่ว่า... ทำไมท่านถึงยังปฏิเสธข้าน้อย... ทำไมกัน... ฮือฮือ.... ฮือออ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020107
					],
					"speakerTitle": "Chise"
				},
				{
					"id": 722020107,
					"content": "ทำไม... ข้าน้อยถึงเดินลึกเข้าไปในหมอกของท่านไม่ได้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020108,
						722020113
					],
					"speakerTitle": "Chise"
				},
				{
					"id": 722020108,
					"content": "อ่าน... เธอพูดอะไรอยู่น่ะ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722020109
					]
				},
				{
					"id": 722020109,
					"content": "Stormstone ที่ท่านทิ้งไว้... ข้าน้อยจะคิดหาวิธี... เรือสีเงินสว่างไสวมาแล้วล่ะ เวลาของข้าน้อยเหลือไม่มากแล้ว...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020110
					],
					"speakerTitle": "Chise"
				},
				{
					"id": 722020110,
					"content": "Stormstone... มันคืออะไรเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722020111
					]
				},
				{
					"id": 722020111,
					"content": "Stormstone บนที่ราบ Autake... มีเพียงผู้ที่สามารถควบคุมสายฟ้าได้เท่านั้น จึงจะทำให้พวกมันกลับมาทำงานได้... มีเพียงผู้ค้นหาหนทางในสายหมอกเท่านั้น ที่จะค้นพบพวกมัน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020112
					],
					"speakerTitle": "Chise"
				},
				{
					"id": 722020112,
					"content": "ดุจดั่งท่าน Thunderbird ยืนแน่นิ่ง... ดุจดั่งท่าน Thunderbird สยายปีก...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chise"
				},
				{
					"id": 722020113,
					"content": "ม่านหมอก... มันหายไปแล้วไม่ใช่เหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722020109
					]
				},
				{
					"id": 722020103,
					"content": "อยากให้ช่วยงั้นเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722020104
					]
				}
			]
		},
