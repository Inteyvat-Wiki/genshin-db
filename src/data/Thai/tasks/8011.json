						80110613
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110613,
					"content": "ปะ...ป๊า...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110614
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110614,
					"content": "อ่า... Caribert! สวรรค์ นี่มันคือเรื่องจริง ปาฏิหาริย์ชัด ๆ Caribert ของฉัน!!",
