					"Eide"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80110201,
					"content": "ที่นี่มืดทึมมาก ที่แห่งนี้... มีอยู่ตั้งแต่ก่อนหน้านี้แล้วเหรอ? ทำไมฉันเหมือนไม่เคยเจอที่นี่เลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110202,
						80110203
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110202,
					"content": "ดูสิ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110204
					]
				},
				{
					"id": 80110204,
					"content": "หา? พวกเขา... กำลังกราบไหว้อะไรบางอย่างอยู่งั้นเหรอ? เดิน ๆ แล้วก็คุกเข่ามอบสรรเสริญ... ดูเหมือนกำลังสักการบูชาอะไรอยู่เลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110205
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110205,
					"content": "ฉันไม่เคยเห็นอะไรแบบนี้มาก่อน ที่นี่มีอะไรซ่อนอยู่กันแน่...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110206
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110206,
					"content": "ต้องลองสำรวจดูถึงจะรู้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110207
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110207,
					"content": "(ทั้งบรรยากาศและภาพแปลก ๆ ตรงหน้านี้ หรือว่า...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 80110203,
					"content": "พวก Hilichurl พวกนั้นกำลังทำอะไรอยู่?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110204
					]
				}
			]
		},
