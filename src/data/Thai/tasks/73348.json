			"dialogs": [
				{
					"id": 733480201,
					"content": "เดี๋ยวก่อน! เดี๋ยวก่อนสิ! หยุดได้แล้ว! เลิกตีได้แล้ว!",
					"roleType": "TALK_ROLE_NPC",
