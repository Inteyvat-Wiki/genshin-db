				"points": []
			},
			"dialogs": [
				{
					"id": 240050101,
					"content": "พี่ เร็ว ๆ สิ รีบมาทางนี้สิ พวกเรายังไม่เคยเห็นบ้านหลังใหญ่ตรงนั้นเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050102
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050102,
					"content": "เดินช้า ๆ ระวังอย่าลื่นล้มอีกนะ เธอก็เหมือนกันนะ Lovi พ่อของเธอบอกว่าสุขภาพของเธอไม่ดี ระวังจะไม่สบาย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050103
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050103,
					"content": "ให้ตายสิ พี่ชายเธอพูดมากจังเลย เหมือนแม่ของฉันเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050104
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050104,
					"content": "ฉันก็ว่างั้นแหละ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050105
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050105,
					"content": "พวกเธอสองคนนี่...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050106,
						240050107
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050106,
					"content": "เจอกันอีกแล้วนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050108
					]
				},
				{
					"id": 240050108,
					"content": "#สวัสดี{M#พี่ชาย}{F#พี่สาว}! เจอกันอีกแล้วนะ ครั้งนี้พวกเราไม่ได้เล่นซ่อนแอบแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050109
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050109,
					"content": "คือจริง ๆ แล้ว เมื่อกี้เราเล่นไปแล้วล่ะ... แถมยังถูกคุณ Nour ดุด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050110
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050110,
					"content": "ตอนทำงานพี่ Nour จริงจังมากเลยล่ะ ชอบดุคนอื่นตลอดเลย ฉันอุตส่าห์เคยเอาคุกกี้ให้พี่เค้ากินด้วยนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050111
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050111,
					"content": "แต่ว่า เราก็เล่นกันเหนื่อยแล้วแหละ ฉันกำลังอยากพา Aurele กับ Verut ไปเดินเล่นหาของอร่อย ๆ กินอยู่พอดี",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050112
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050112,
					"content": "#{M#พี่ชาย}{F#พี่สาว} พี่อยากไป... เอ่อ... คำนั้นมันพูดว่ายังไงกันนะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050113
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050113,
					"content": "เดินเล่น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050114
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050114,
					"content": "ใช่แล้ว ไปเดินเล่นกับพวกเราเถอะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050115
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050115,
					"content": "พวกเราไปดูที่ลานตรงนั้นกันเถอะ ฉันอยากไปดูน้ำพุด้วย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050116,
						240050117
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050116,
					"content": "งั้นรบกวนเธอช่วยนำทางด้วยนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050118
					]
				},
				{
					"id": 240050118,
					"content": "โอเค งั้นพวกเรา... ไปลานตรงนั้นก่อนเถอะ น้ำพุที่นั่นสวยมากเลยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050117,
					"content": "งั้นรบกวนทุกคนนำทางด้วยนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050118
					]
				},
				{
					"id": 240050107,
					"content": "พวกเธอทำอะไรกันอยู่เหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050108
					]
				}
			]
		},
