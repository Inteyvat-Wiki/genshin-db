			"dialogs": [
				{
					"id": 80200201,
					"content": "เอ๋ Dain? นี่... Dain! มัวแต่เหม่ออะไรอยู่นี่ละนั่น?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200202
