						80200203
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200203,
					"content": "เจอเรื่องอะไรเข้าเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200204,
					"content": "เป็นอะไรไป Dain?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200205
					]
				},
				{
					"id": 80200205,
					"content": "#{NICKNAME} คนที่หายตัวไปที่พวกเธอพูดถึง... เป็นคนแบบไหนเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200206
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200206,
					"content": "หื้อ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200207,
					"content": "ชายหนุ่มอายุประมาณยี่สิบต้น ๆ น่ะ เกิดอะไรขึ้นกันเหรอ Dain...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200208,
					"content": "ตอนนี้ในหัวของฉันเหมือนจะมีบางอย่างโผล่ขึ้นมา...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200209
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200209,
					"content": "...เป็น \"ความทรงจำ\" บางส่วนที่เกี่ยวข้องกับเขา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200210
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200210,
					"content": "อะไรนะ...? หรือว่า... หรือว่าเมื่อวานพวกเราพูดเรื่องเขามากเกินไป เพราะงั้นเมื่อคืนนายเลยฝันแบบนี้?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200211,
					"content": "ไม่ มันไม่ใช่ความฝัน แต่เป็นความทรงจำที่จู่ ๆ ก็โผล่ขึ้นมาในหัว หลังจากที่ฉันตื่นนอนเมื่อเช้านี้....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200212
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200212,
					"content": "และฉันมั่นใจว่า ฉันไม่เคยเจอเขาคนนี้มาก่อน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200213
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200213,
					"content": "แล้วเรื่องราวใน \"ความทรงจำ\" เป็นยังไงเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200214
					]
				},
				{
					"id": 80200214,
					"content": "ฉันจำได้ว่า ในความทรงจำนั้น...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200215
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200215,
					"content": "...ฉันเอา \"ดวงตา Field Tiller ตัวแรกของโลก\" มอบให้เขา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200216
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200216,
					"content": "!?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200217
					]
				},
				{
					"id": 80200217,
					"content": "ห๊า!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200218,
					"content": "...เพราะงั้นตอนนี้คงจะยืนยันได้แล้วว่า คนที่หายตัวไปคนนั้นเกี่ยวข้องกับ Abyss Order สินะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200219,
					"content": "และคนคนนั้นน่าจะมีความสามารถในการ \"ใส่\" ความทรงจำเข้าไปในสมองของคนอื่นได้ด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200220
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200220,
					"content": "ทำได้ยังไงกันนะ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200221
					]
				},
				{
					"id": 80200221,
					"content": "งั้นถ้าพูดแบบนี้ ทุกคนในหมู่บ้าน Vimara ก็ถูกปลูกฝังความทรงจำปลอมเข้าไปงั้นเหรอ? เดิมทีทุกคนอาจจะไม่รู้จักเขาเลยก็ได้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200222,
					"content": "แต่เขาทำแบบนี้ไปเพื่ออะไรกันล่ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200223,
					"content": "ที่จริงเหตุการณ์เมื่อเช้านี้ ก็เปิดโปงข้อเท็จจริงบางอย่างของ Abyss Order ด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200224
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200224,
					"content": "เปิดโปงอะไร?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200225,
					"content": "เป้าหมายของพวกเขา... ยังคงเป็น \"ดวงตา Field Tiller ตัวแรกของโลก\" และไม่มีทางที่จะละทิ้งการตามหามันไปเด็ดขาด",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200226
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200226,
					"content": "ฉันเป็นคนเดียวที่รู้ว่า \"ดวงตา\" อยู่ที่ไหน... เพราะงั้นการปลูกฝังความทรงจำแบบนี้ให้ฉัน ก็คงเพื่อที่จะก่อกวนความคิดฉัน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200227,
						80200228
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200227,
					"content": "งั้นตอนนี้ \"ดวงตา\" ยังปลอดภัยมั้ย?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200229
					]
				},
				{
					"id": 80200229,
					"content": "ความกังวลของเธอไม่ใช่เรื่องไร้เหตุผล ถึงแม้ฉันจะคิดว่า Abyss Order ไม่น่าจะทำให้ความทรงจำนั้นกลายเป็นจริงได้ก็เถอะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200230
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200230,
					"content": "แต่พอพิจารณาถึงความหมกมุ่นที่พวกเขามีต่อ \"ดวงตา\" แล้ว พวกเราควรใช้ความระมัดระวังในระดับเดียวกันถึงจะปลอดภัย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200231
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200231,
					"content": "ไปยืนยันกับฉันทีสิ ว่า \"ดวงตา\" ยังอยู่กับเราอย่างปลอดภัยมั้ย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200232
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200232,
					"content": "เราจะไปที่ที่นายซ่อน \"ดวงตา\" เอาไว้เหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200233,
					"content": "(...แต่ถ้าพวกเราไปเลยแบบนี้ เกิดถูกสะกดรอยตามขึ้นมา ตำแหน่งที่ซ่อนจะไม่ถูกเปิดเผยเอาเหรอ?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200234
					]
				},
				{
					"id": 80200234,
					"content": "(หรือนี่ อาจจะเป็นจุดประสงค์แรกเริ่มของ Abyss Order ที่เอาความทรงจำนั้นไปใส่ให้ Dain? ทำให้เขาเกิดความสงสัย และอยากไปยืนยันอีกรอบ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200235
					]
				},
				{
					"id": 80200235,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200236
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200236,
					"content": "(จากที่รู้จักกับ Dain มา ไม่มีทางที่เขาจะไม่คิดถึงจุดนี้... ดูจากท่าทางของเขาแล้ว น่าจะมีความคิดอื่นอยู่แหละ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200237,
						80200238
					]
				},
				{
					"id": 80200237,
					"content": "งั้นพวกเราไปกันเถอะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200239
					]
				},
				{
					"id": 80200239,
					"content": "...อืม",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200238,
					"content": "นายนำทางเลย Dain",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200239
					]
				},
				{
					"id": 80200228,
					"content": "เป็นไปได้มั้ยที่ \"ความทรงจำ\" จะเป็นเรื่องจริง?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200229
					]
				}
			]
