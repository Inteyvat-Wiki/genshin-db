						],
						"pointId": 6283
					}
				]
			},
			"dialogs": [
				{
					"id": 741401301,
					"content": "เอ๋ มาโผล่ที่นี่อีกแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401302
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401302,
					"content": "ทำไมเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741401303,
					"content": "ที่จริงฉันคิดอยู่ว่าถ้าพูดแบบนี้จะดูสุดโต่งเกินไป เพราะทุกคนดีกับฉันมาก พวกพี่ก็ดีกับฉันเหมือนกัน แต่ว่า...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401304
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401304,
					"content": "ไม่คิดว่าโลกความเป็นจริงในตอนนี้น่าเบื่อจนน่ากลัวเหรอ? ไม่รู้สึกว่าโลกในหนังสือสวยงามกว่าเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401305,
						741401307,
						741401309
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401305,
					"content": "ฉันก็คิดอย่างนั้น",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741401306
					]
				},
				{
					"id": 741401306,
					"content": "เอ๋? นี่เธอก็คิดงั้นเหรอ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741401311,
					"content": "ฉันว่าโลกใน \"หนังสือวิวรณ์\" สวยงามกว่านะ ทุกหนทุกแห่งเต็มไปด้วยกลีบดอกที่ชุ่มฉ่ำหยาดน้ำค้าง และไม่ง่ายเลยที่จะได้เป็นเพื่อนกับหมาน้อย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401312
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401312,
					"content": "หมาน้อย... ว่าแต่ Canotila เธอเข้าใจคำพูดของเจ้าหมาด้วยเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741401313,
					"content": "หืม? ไม่เข้าใจอะ แต่ลูกหมาใน \"หนังสือวิวรณ์\" นั้นพิเศษมาก หรือไม่ก็เพราะฉันเป็นคนพิเศษ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401314
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401314,
					"content": "แต่ฉันทำสมาธิตลอด และไปเที่ยวเล่นในโลกหนังสือเสมอ มีวันหนึ่ง จู่ ๆ เสียงเห่าที่เดิมทีเป็นโฮ่ง ๆ ก็กลายเป็นภาษาพูด",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401315
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401315,
					"content": "ส่วนเรื่องที่เราพูดกันก็คือ... เขาบอกให้ฉันไปซะ และอย่ากลับมาอีก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401316
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401316,
					"content": "เฮ้อ ฉันยังอยากเห็นภาพที่ดอกทานตะวันเบ่งบานอยู่นะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401317
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401317,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741401318
					]
				},
				{
					"id": 741401318,
					"content": "ชะ...ใช่... Canotila ต้องดูแลตัวเองด้วยนะ! งั้นพวกเราไปก่อนล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741401307,
					"content": "ฉันไม่คิดงั้นนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741401308
					]
				},
				{
					"id": 741401308,
					"content": "นั่นสิเนอะ... บางทีนี่อาจจะเป็นสิ่งที่ถูกแล้วล่ะ ฉันทำแบบนี้ไม่ปกติเอาซะเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401311
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401309,
					"content": "สำหรับฉันก็ไม่ได้แตกต่างอะไรนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741401310
					]
				},
				{
					"id": 741401310,
					"content": "#ดูเหมือนพี่ {NICKNAME} จะเป็นคนที่แข็งแกร่งที่สุดนะเนี่ย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401311
					],
					"speakerTitle": "Canotila"
				}
			]
		}
	]
}