				},
				{
					"id": 740732303,
					"content": "ดูเหมือนจะเป็นแบบนั้นนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732304
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740732304,
					"content": "ใครกันแน่นะ...",
