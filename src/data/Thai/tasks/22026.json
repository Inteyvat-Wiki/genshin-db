				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220260101,
					"content": "อ่า... ทั้ง ๆ ที่อยู่แถวนี้นี่นา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260102
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260102,
					"content": "Julie? ทำไมมาอยู่ที่นี่ได้ล่ะ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220260103
					]
				},
				{
					"id": 220260103,
					"content": "หืม? นักเดินทางนี่ ฮี่ฮี่ ไม่คิดว่าจะได้พบเธอที่นี่...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260104
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260104,
					"content": "ฉันมาหาวัตถุดิบที่นี่น่ะ Xudong จะวิจัยอาหารใหม่อีกแล้ว Parvaneh ก็ช่วยออกความคิดอยู่ข้าง ๆ น่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260105
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260105,
					"content": "Xudong บอกว่า เขาจะเอา \"Tricolor Dango\" ของ Inazuma มาทำของหวานที่ทั้งนุ่มและหอมหวาน แต่ต้องการวัตถุดิบพิเศษสักสองสามอย่างน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260106
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260106,
					"content": "คุณลุง Munehisa ไปซื้อ Lavender Melon ในเมือง ฉันมาที่นี่เพื่อรวบรวม \"Sakura Bloom\" น่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260107
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260107,
					"content": "แม้ว่าฉันจะเก็บได้นิดหน่อยแล้ว แต่ว่าแค่นี้ยังไม่พอ ทีแรกฉันอยากจะเดินไปหาที่ข้างหน้าอีก แต่ว่าทางนั้นมีมอนสเตอร์...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260108
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260108,
					"content": "นักเดินทาง รบกวนเธอหน่อยสิ ช่วยฉันหา \"Sakura Bloom\" กลับมาสามอันจะได้มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260109,
						220260111
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260109,
					"content": "เข้าใจแล้วล่ะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220260110
					]
				},
				{
					"id": 220260110,
					"content": "ขอบใจนะ! ไว้เธอกลับมาแล้ว ฉันจะเลี้ยงของอร่อย ๆ เอง!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260111,
					"content": "มอนสเตอร์พวกนี้คงไม่เกินความสามารถเธอหรอกมั้ง?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220260112
					]
				},
				{
					"id": 220260112,
					"content": "โอ้ว ปกติก็เป็นแบบนี้แหละ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260113
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260113,
					"content": "แต่จะว่าไป ถ้าฉันต้องต่อสู้กับพวกมอนสเตอร์นั้นจริง ๆ ล่ะก็ คงจะลืมเรื่องรวบรวมวัตถุดิบไปแน่ ๆ เลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260114
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260114,
					"content": "ตอนที่อยู่ที่ Mondstadt ก็เป็นแบบนี้ ไม่ว่าจะเป็นการมอบหมายอะไร เพียงแค่ต่อสู้กับพวกมอนสเตอร์ ฉันก็จะลืมเรื่องทั้งหมด และสนใจแค่การต่อสู้กับพวกมอนสเตอร์",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260115
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260115,
					"content": "จนกว่าจะกำจัดมอนสเตอร์ได้จนหมด ฉันถึงจะคิดเรื่องที่ต้องจัดการคำขอขึ้นมาได้น่ะ... เพราะแบบนี้เรื่องคำขอที่รับมอบหมายเลยล้มเหลวไปหลายอย่างเลยล่ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260116
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260116,
					"content": "เธอเกลียดพวกมอนสเตอร์จริง ๆ สินะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220260117
					]
				},
				{
					"id": 220260117,
					"content": "เกลียดพวกมอนสเตอร์? นั่นไม่ใช่สาเหตุหลักหรอก อะ... อันที่จริงแล้วฉันรู้สึกว่า พวกมอนสเตอร์น่าสนุกดี...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260118
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260118,
					"content": "นอกจากโค่นมอนสเตอร์แล้ว ก็ไม่ต้องคิดอะไรอีก เธอเคยเป็นมั้ย? มันฟินมากเลยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260119
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260119,
					"content": "อ่า ไม่พูดเรื่องนี้แล้วดีกว่า เอาเป็นว่า เรื่องรวบรวม \"Sakura Bloom\" ก็รบกวนเธอด้วยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260120
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260120,
					"content": "ขอบใจนะ! ไว้เธอกลับมาแล้ว ฉันจะเลี้ยงของอร่อย ๆ เอง!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julie"
				}
			]
		},
