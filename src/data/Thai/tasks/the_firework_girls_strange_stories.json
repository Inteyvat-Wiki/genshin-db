				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120100301,
					"content": "พ่อ หนูกลับมาแล้ว!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100302
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100302,
					"content": "งานแสดงดอกไม้ไฟใกล้เข้ามาทุกที ดอกไม้ไฟของแต่ล่ะบ้านก็ใกล้จะเสร็จแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100303
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 120100303,
					"content": "ว่าแต่สองคนนี้ ไม่เคยเห็นมาก่อนเลย เพื่อนใหม่เหรอ? หรือว่าลูกค้า?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100304
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 120100304,
					"content": "ใช่ทั้งหมดนั่นแหละ พวกเค้าเพิ่งมาที่นี่ได้ไม่นาน ในเมื่อมาถึง Inazuma แล้วจะไม่ดูดอกไม้ไฟได้ยังไงกัน?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100305
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100305,
					"content": "ฮ่าฮ่าฮ่า เอาเป็นว่า หาที่พักผ่อนก่อนเถอะ ฉัน Naganohara Ryuunosuke จะเล่าเกี่ยวกับประวัติศาสตร์อันยาวนานของตระกูล Naganohara ให้พวกเธอฟังเอง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100306
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 120100306,
					"content": "เรื่องนั้นเอาไว้ก่อนเถอะ พ่อ หนูมีเรื่องอยากจะถาม",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100307
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100307,
					"content": "นานแสนนานก่อนหน้านี้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100308
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 120100308,
					"content": "เฮ้อ พ่อเริ่มเล่าเรื่องของตัวเองอีกแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100309
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100309,
					"content": "ขอโทษด้วยนะ พ่อเคยได้รับบาดเจ็บ จากนั้นหูก็เลยไม่ค่อยดีน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100310
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100310,
					"content": "แต่จากบทสนทนาของเมื่อกี้ ก็ดูเหมือนว่าจะไปได้ดีนี่นา...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120100311,
					"content": "จากนั้น ผู้คนก็ใช้เวลานานพอสมควรถึงจะเข้าใจ มีแร่อยู่ชนิดนึง ผงของมันสามารถนำมาเผาเป็นสีที่สวยงามมาก ๆ ด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100312
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 120100312,
					"content": "พ่อ พ่อ เดี๋ยวก่อนสิ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100313
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100313,
					"content": "ฮะ? ทำไมเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100314
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 120100314,
					"content": "วัสดุทำดอกไม้ไฟที่สั่งไปก่อนหน้านี้ มาส่งแล้วรึยัง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100315
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100315,
					"content": "ดอกไม้ไฟของเมื่อวานส่งไปเรียบร้อยแล้ว เมื่อวานซืนก็ด้วย สามวันก่อนก็ด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100316
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 120100316,
					"content": "ไม่ใช่ พ่อ หนูหมายถึงวัสดุที่สั่งไว้ก่อนหน้านี้น่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100317
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100317,
					"content": "ของวันนี้ก็ใกล้เสร็จแล้วล่ะ ไม่ต้องห่วง ฝีมือพ่อน่ะยังแจ๋วเหมือนเดิม",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100318
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 120100318,
					"content": "ไม่ใช่ หนูหมายถึงวัสดุ! วัสดุแร่ที่ใช้ทำดอกไม้ไฟน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100319
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100319,
					"content": "อะไรนะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100320
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 120100320,
					"content": "วัสดุแร่!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100321
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100321,
					"content": "อ๋อ ๆ วัสดุแร่?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100322
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 120100322,
					"content": "ใช่ ๆๆ วัสดุแร่!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120100323,
					"content": "อ่า โทษที... กว่าจะคุยกันรู้เรื่อง ฉันลุ้นซะจนเกร็งเลย ฮี่ฮี่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120100324,
					"content": "ถ้าเป็นวัสดุล่ะก็ ยังไม่มาส่งเลย ส่วนเหตุผลดูเหมือนจะเคยบอกแล้ว แต่พ่อฟังไม่ค่อยชัดน่ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100325
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 120100325,
					"content": "ไม่เป็นไร ๆ รู้แค่นี้ก็พอแล้ว ถ้างั้นเดี๋ยวไว้ค่อยทำแล้วกัน รอให้พวกเขามาส่งก่อน พ่ออย่าลืมรับด้วยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100326
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100326,
					"content": "อืม ๆ วางใจได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100327
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 120100327,
					"content": "ขอโทษด้วย อาจจะเสียงดังไปหน่อย ถ้ามีเรื่องอยากจะถามพ่อ ก็ออกจะวุ่นวายหน่อย ๆ แบบเมื่อกี้น่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100328,
						120100330
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100328,
					"content": "แต่รู้สึกได้ว่าเขาเป็นคนที่ใจดีมาก",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100329
					]
				},
				{
					"id": 120100329,
					"content": "ฮี่ฮี่ ใช่แล้ว พ่อเป็นคนใจดี ทุกคนต่างเคารพเขา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100332
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100332,
					"content": "พ่อไม่เคยทะเลาะกับใคร เพราะเขาได้ยินไม่ค่อยชัด และไม่รู้ว่าคนอื่นพูดอะไร ก็เลยได้แต่ฟังและยิ้มอย่างมีความสุข",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100333
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100333,
					"content": "ตอนเด็ก ๆ ฉันนึกว่าพ่อเข้าใจฉันสุด ๆ และรู้สึกว่าไม่ว่าฉันพูดอะไรก็ถูกไปหมด เพราะงั้นฉันเลยจะพูดกับพ่อทุกเรื่องน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100334
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100334,
					"content": "ต่อมาฉันถึงได้รู้ว่า ที่พ่อยิ้มอย่างมีความสุขแบบนั้น ก็เพราะพ่อได้ยินไม่ชัด แต่ฉันก็ยังเล่าเรื่องให้เขาฟังอยู่ทุกวัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100335
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100335,
					"content": "หืม? ทำไมล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120100336,
					"content": "แค่ได้เห็นพ่อยิ้ม ฉันก็ดีใจแล้ว แบบนี้เขาจะได้ไม่เหงาไงล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100337
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100337,
					"content": "แต่ว่าไปแล้ว ในเมื่อวัสดุยังไม่มาส่ง แต่งานดอกไม้ไฟใกล้จะเริ่มขึ้น พวกเราคงต้องคิดหาวิธีอื่นกันแล้วล่ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100338
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100338,
					"content": "Yoimiya กลับมาแล้วเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100339
					],
					"speakerTitle": "Sakujirou"
				},
				{
					"id": 120100339,
					"content": "ว้าาา...?! อย่าทำให้คนอื่นตกใจสิ บอกแล้วไม่ใช่เหรอว่าอย่าพูดไปเรื่อยน่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100340
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100340,
					"content": "ขะ... ขอโทษ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100341
					],
					"speakerTitle": "Sakujirou"
				},
				{
					"id": 120100341,
					"content": "รอก่อนนะ ฉันจะไปเดี๋ยวนี้แหละ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100330,
					"content": "แต่รู้สึกว่านิสัยของเขาเหมือนเธอเลย",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100331
					]
				},
				{
					"id": 120100331,
					"content": "ฮี่ฮี่ มีแต่คนพูดแบบนี้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100332
					],
					"speakerTitle": "Yoimiya"
				}
			]
		},
