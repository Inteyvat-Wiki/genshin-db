				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nacker",
					"Chronie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740870301,
					"content": "ถ้าเทียบกับที่อื่นแล้ว \"หอพัก\" ไม่ได้รับผลกระทบจากแรงระเบิดมากนัก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870302
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 740870302,
					"content": "หอพัก? แต่ที่นี่ไม่มีแม้แต่เตียงเลยนะ นักวิจัยจะพักผ่อนยังไงล่ะ? พวกเขาคงไม่ได้นั่งหลับบนเก้าอี้หรอกใช่มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870303
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740870303,
					"content": "คุณ Chronie \"การพักผ่อน\" ที่คุณเข้าใจ ไม่เหมือนกับ \"การพักผ่อน\" ที่นักวิจัยต้องการ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870304
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 740870304,
					"content": "ตอนที่นักวิจัยของศูนย์วิทยาศาสตร์ Fontaine บอกว่าต้องการเวลาพักผ่อน เขาก็แค่อยากจะพักสมองสักพักเท่านั้น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870305
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 740870305,
					"content": "หลังจากนั้น เขาก็จะมาเล่นเปียโน, อ่านหนังสืออ่านเล่น แล้วก็ดื่มสักแก้วสองแก้วถ้ามันจำเป็น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870306
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 740870306,
					"content": "เอ่อ... ในมุมมองของฉัน แค่นอนไปเลยมันไม่ได้พักผ่อนสมองได้ดีกว่าหรอกเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870307
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740870307,
					"content": "จะพูดแบบนั้นก็ไม่ผิด แต่...สำหรับนักวิจัยอย่างพวกเราแล้ว การนอนหลับเป็นเรื่องเสียเวลาเกินไป",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870308
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 740870308,
					"content": "การนอนหลับถือเป็นเรื่องเสียเวลางั้นเหรอ? มันคือการพักผ่อนที่จำเป็นต่างหาก!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870309
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740870309,
					"content": "การนอนขัดจังหวะการค้นคว้าทางความคิดโดยสิ้นเชิง สำหรับงานวิจัยแล้ว มันเป็นสิ่งที่ยอมรับไม่ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870310,
						740870311
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 740870310,
					"content": "(ฟังต่อไป...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740870312
					]
				},
				{
					"id": 740870312,
					"content": "นี่จริงจังใช่มั้ย? ถ้าไม่นอน สิ่งที่หยุดชะงักคือชีวิตนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870313
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740870313,
					"content": "ไม่มีทางหรอก ก่อนหน้านี้ทางสถาบันได้ให้ประกันสุขภาพที่ดีเยี่ยม เพื่อให้มั่นใจว่าสุขภาพของนักวิจัยจะไม่มีปัญหา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870314
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 740870314,
					"content": "นี่ก็ไม่ใช่เหตุผลที่จะไม่ยอมนอนมั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870315
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740870315,
					"content": "อีกอย่าง... นักวิจัยพวกนั้นมาที่นี่ก็เพื่อพักสมองชั่วคราวไม่ใช่เหรอ? งั้นความคิดในการวิจัยก็ถูกขัดจังหวะอยู่แต่แรกแล้วไม่ใช่เหรอ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870316
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740870316,
					"content": "ไม่มีทางหรอก ถึงจะบอกว่าเป็นการพักสมองชั่วคราว แต่จริง ๆ แล้วพวกเขายังคงคิดเรื่องปัญหาทางวิชาการโดยสัญชาตญาณ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870317
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 740870317,
					"content": "เหมือนกับท้องทะเลอันกว้างใหญ่ ที่แม้ว่าคลื่นบนผิวน้ำจะเงียบสงบชั่วคราว แต่ใต้น้ำที่ยังมีคลื่นเชี่ยวกรากไหลเวียนอยู่ในส่วนลึก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870318
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 740870318,
					"content": "ในบางครั้ง พลังที่มีอยู่ในคลื่นใต้น้ำ ก็มากกว่าคลื่นบนผิวน้ำซะอีกนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870319
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 740870319,
					"content": "ฉันเข้าใจแล้ว สิ่งที่นายจะสื่อก็คือ ถ้านักวิจัยของศูนย์วิทยาศาสตร์ Fontaine กำลังทำการวิจัย พวกเขาก็จะทำการวิจัยอย่างเดียวโดยไม่ต้องพักต้องผ่อนใช่มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870320
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740870320,
					"content": "คำพูดนี้ไม่ตรงประเด็น ถ้าต้องการนอนจริง ๆ พวกเขาก็กลับไปนอนบ้านตัวเองได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870321
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 740870321,
					"content": "งั้นก็คือ ถ้านักวิจัยของศูนย์วิทยาศาสตร์ Fontaine อยู่ในศูนย์วิทยาศาสตร์ Fontaine ก็จะทำการวิจัยอย่างเดียวโดยไม่ต้องพักต้องผ่อนเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870322
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740870322,
					"content": "ฉันล่ะประทับใจในระดับวาทศิลป์ของคุณจริง ๆ คุณ Chronie",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nacker"
				},
				{
					"id": 740870311,
					"content": "(ไม่ฟังต่อแล้วดีกว่า...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		}
	]
}