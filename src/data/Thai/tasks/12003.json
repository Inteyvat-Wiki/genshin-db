					"Xingqiu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120030801,
					"content": "ไม่เลว แกนี่ไม่ธรรมดาเลยนะ... ถ้าขืนยังจะสู้ต่อไปอย่างนี้ ความเสียหายจะมากเกินกว่าจะยอมรับได้นะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030802
					],
					"speakerTitle": "Agent"
				},
				{
					"id": 120030802,
					"content": "พวกมันจะไม่ไหวแล้ว จัดการต่อไป! เอา Cor Lapis มาให้ได้!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030803
					],
					"speakerTitle": "เจ้าสัว Maocai"
				},
				{
					"id": 120030803,
					"content": "ความสัมพันธ์ระหว่างแกกับ Fatui แต่ไหนแต่ไรก็เกี่ยวกับการร่วมมือทางธุรกิจ ฉันไม่ยอมให้แกลากคนของฉันไปสร้างความวุ่นวายแบบนี้หรอกนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030804
					],
					"speakerTitle": "Agent"
				},
				{
					"id": 120030804,
