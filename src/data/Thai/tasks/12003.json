					"nextDialogs": [
						120030835
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030835,
					"content": "#ว๊ากกก! {NICKNAME} ช่วยฉันด้วย! สายตาเขาเอาจริงนะนั่น!",
