			"dialogs": [
				{
					"id": 200610101,
					"content": "เกี่ยวกับนกพิราบ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610102
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610102,
					"content": "นกพิราบพวกนี้ เอาไปทำกับแกล้มซะดีกว่ามั้งนี่...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610103
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610103,
					"content": "ทำไมเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200610104
					]
				},
				{
					"id": 200610104,
					"content": "แต่เดิมฉันเลี้ยงนกพิราบอยู่ฝูงนึง เอาไว้ส่งจดหมายให้คนอื่น ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610105
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610105,
					"content": "แต่ก็ไม่รู้ว่าทำไม หลัง ๆ มานี่พวกมันพึ่งพาไม่ได้เลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610106
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610106,
					"content": "ถ้าไม่ทำจดหมายหาย ก็ใช้เวลานานเป็นชาติ พักอยู่บนพื้นทีเป็นครึ่งวัน รอให้คนมาไล่มันไป",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610111
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610111,
					"content": "ถ้าเธอว่างล่ะก็ ช่วยออกไปตามดูเจ้านกพิราบที่เพิ่งจะปล่อยออกไปพวกนั้นให้ฉันทีสิ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610107,
						200610109
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610107,
					"content": "ฉันเข้าใจแล้ว",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200610108
					]
				},
				{
					"id": 200610108,
					"content": "งั้นช่วยหน่อยนะ ถ้าเห็นพวกมันขี้เกียจล่ะก็ ช่วยไล่มันทีนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610109,
					"content": "จะโดนนกพิราบเกลียดเอานะ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200610110
					]
				},
				{
					"id": 200610110,
					"content": "ไม่เป็นไร พวกมันมีความจำที่สั้นมาก ผ่านไปแป๊บนึงก็ลืมแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610112
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610112,
					"content": "ดูไม่ออกเลยนะว่าเธอชอบนกพิราบ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Draff"
				}
			]
		},
