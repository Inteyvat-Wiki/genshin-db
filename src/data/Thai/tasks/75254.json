			},
			"dialogs": [
				{
					"id": 752540101,
					"content": "เฮ้ เพื่อน! ยินดีต้อนรับสู่ Paititi ในฝัน... เกาะ Tete!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540102
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540102,
					"content": "เดินตรงไปข้างหน้าก็จะถึงบาร์ \"น้ำผึ้งละมุน\" กับบาร์ \"จิบน้ำค้าง\" แล้วล่ะ ฉันชื่อ Tecuhtli เป็นพนักงานต้อนรับของบาร์นี้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tecuhtli"
				}
			]
		},
		{
			"id": 7525402,
			"completionStepIds": [
				7525403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7525403",
							"2"
						],
						"stepId": 7525403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tecuhtli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752540201,
					"content": "เพื่อนรัก ในเมื่อคุณดื่มน้ำผลไม้ต้อนรับของฉันไปแล้ว งั้นฉันขอเตือนอะไรคุณสักอย่างนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540202
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540202,
					"content": "ถ้าคุณเป็นแค่คนธรรมดา ๆ ที่มาพักผ่อนในวันหยุด ก็อย่าได้เข้าไปใกล้ทางตอนเหนือสุดของเกาะ Tete เชียว ที่นั่นไม่มีอะไรที่จะทำให้คุณผ่อนคลายได้หรอก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tecuhtli"
				}
			]
		},
		{
			"id": 7525403,
			"completionStepIds": [
				7525401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
