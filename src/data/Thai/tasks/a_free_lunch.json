			"dialogs": [
				{
					"id": 741660201,
					"content": "#{M#พี่ชาย}{F#น้องสาว}ตรงนั้นน่ะ ใช่ ๆ เธอนั่นแหละ ๆ มานี่ มา ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660202
					],
					"speakerTitle": "คนแปลก"
				},
				{
					"id": 741660202,
					"content": "หื้อ? เธอเรียกพวกเราเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660203,
					"content": "โอ้ สหายทั้งสอง ฉันแค่ดูก็รู้เลยว่าพวกเธอเพิ่งมาใหม่น่ะ ยังไม่คุ้นเคยกับป้อมปราการ Meropide ล่ะสิท่า?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660204
					],
					"speakerTitle": "คนแปลก"
				},
				{
					"id": 741660204,
					"content": "ยินดีด้วยนะที่ได้พบฉันคนนี้ ฉันเป็น \"ผู้อยู่อาศัย\" ที่ใจดีที่สุดในป้อมปราการ Meropide",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660205
					],
					"speakerTitle": "คนแปลก"
				},
				{
					"id": 741660205,
					"content": "วันนี้ให้ฉันพาพวกเธอไปทำความรู้จักป้อมปราการ Meropide เถอะ แน่นอนว่าทั้งหมดนี้ \"ฟรี\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660206
					],
					"speakerTitle": "คนแปลก"
				},
				{
					"id": 741660206,
					"content": "ที่จริงฉันคุ้นเคยกับที่นี่มากน่ะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741660207
					]
				},
				{
					"id": 741660207,
					"content": "แหม อย่าพูดแบบนั้นซี่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660208
					],
					"speakerTitle": "คนแปลก"
				},
				{
					"id": 741660208,
					"content": "บางทีเธออาจคิดว่าเธอคุ้นเคยกับสถานที่นี้ดี แต่ภายใต้คำแนะนำของฉัน ฉันเชื่อว่าเธอจะสามารถค้นพบทิวทัศน์ที่แตกต่างออกไปได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660209
					],
					"speakerTitle": "คนแปลก"
				},
				{
					"id": 741660209,
					"content": "ในโลกนี้มีอาหารกลางวันฟรีด้วยเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741660210
					]
				},
				{
					"id": 741660210,
					"content": "แน่นอน ๆ ฉันบอกแล้วไง ว่าฉันเป็น \"ผู้อยู่อาศัย\" ที่ใจดีที่สุดในป้อมปราการ Meropide",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660211
					],
					"speakerTitle": "คนแปลก"
				},
				{
					"id": 741660211,
					"content": "เอ่อ ทำไมรู้สึกว่าคนคนนี้ทำตัวประหลาดจัง เพิ่งเจอหน้ากันแท้ ๆ แต่ทำไมถึงกระตือรือร้นขนาดนี้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660212,
					"content": "ฮ่าฮ่า เพื่อนเอ๋ย อย่าคิดมากสิ เอางี้มั้ย พวกเธอไปคุยกันก่อน ส่วนฉันจะรอพวกเธอตัดสินใจอยู่ตรงนี้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660213
					],
					"speakerTitle": "คนแปลก"
				},
				{
					"id": 741660213,
					"content": "รอพวกเธอคุยกันเสร็จก็ค่อยมาหาฉันละกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "คนแปลก"
				}
			]
		},
