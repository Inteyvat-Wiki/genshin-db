			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hosseini"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700290101,
					"content": "เป็นไงบ้าง นักเดินทาง? Pursina's Spike ได้มีโอกาสทำงานรึยัง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290102,
						700290103
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700290102,
					"content": "มันช่วยได้มากเลย",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700290104
					]
				},
				{
					"id": 700290104,
					"content": "ดีแล้วล่ะ เหนื่อยมาตั้งนานแบบนี้ถือว่าไม่ได้เสียแรงเปล่า ในที่สุดภารกิจนี้ก็จบลงเสียที",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290105
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700290105,
					"content": "ส่วนเจ้า Ruin Grader โมเดลพิเศษเครื่องนี้ดูเหมือนจะถูกออกแบบมาต่างจาก Ruin Guard และ Ruin Hunter ทั่วไป แนวคิดในการออกแบบมันล้ำหน้าไปมาก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290106
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700290106,
					"content": "แต่ว่าจักรกลอัตโนมัติแบบนี้หายากทีเดียว ฉันเดาว่า มันอาจจะเป็นโมเดลทดลองบางอย่าง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290107
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700290107,
					"content": "นักออกแบบตั้งใจสร้างมันขึ้นมาเพื่อจุดประสงค์อะไรนะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290108
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700290108,
					"content": "นี่มันหมายความว่า... จักรกลอัตโนมัติของอารยธรรมโบราณมันมีความล้ำหน้ากว่าที่นักวิชาการคาดไว้รึเปล่า? น่าสนใจจริง ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290109
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700290109,
					"content": "ถ้าเอามันมาถอดแยกชิ้นส่วนได้ เราต้องได้ค้นพบนวัตกรรมใหม่ ๆ แน่นอน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290110
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700290110,
					"content": "นักเดินทาง ถ้ามีเวลาล่ะก็ ช่วยพาฉันไปดูซากของ Ruin Grader โมเดลพิเศษทีได้มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290111
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700290111,
					"content": "ไม่เหลืออะไรแล้วล่ะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700290112
					]
				},
				{
					"id": 700290112,
					"content": "หาาา? เธอทุบโครงของมันจนยับหมดเลยเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290113
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700290113,
					"content": "ให้ตายสิ... นี่มันเสียของแท้ ๆ! เป็นความผิดพลาดครั้งใหญ่เลย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290114
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700290114,
					"content": "เฮ้อ ฉันน่าจะเตือนเธอก่อน เป็นความผิดฉันเอง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290115
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700290115,
					"content": "น่าเสียดายจริง ๆ นี่เป็นการค้นพบสิ่งประดิษฐ์จากอารยธรรมโบราณครั้งสำคัญ ตอนนี้แม้แต่ตัวอย่างก็ไม่เหลือให้เก็บแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290116,
						700290119
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700290116,
					"content": "ขอโทษ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700290117
					]
				},
				{
					"id": 700290117,
					"content": "มะ ไม่เป็นไรหรอก เธอไม่เข้าใจความสำคัญด้านวิชาการของเรื่องนี้ เพราะงั้นถึงได้ทำแบบนี้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290118
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700290118,
					"content": "ฉันต่างหากที่เข้าใจความหมายของมัน แต่กลับไม่ได้เตือนเธอ เพราะงั้นคนผิดคือฉัน ไม่ใช่เธอหรอก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290121
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700290121,
					"content": "การทำวิจัยนอกสถานที่ครั้งนี้ปัญหามันเยอะจริง ๆ อย่างแรก ฉันออกไปจาก Ritou นาน ๆ ไม่ได้ ต่อมาก็ต้องสูญเสียการค้นพบทางวิชาการครั้งใหญ่นี่อีก...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290122
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700290122,
					"content": "...ช่างเถอะ มองโลกในแง่ดีดีกว่า อย่างน้อยเรื่องนี้ก็ทำให้ซ่อม Pursina's Spike ได้สำเร็จ แล้วยังได้ทดลองเอามันไปใช้งานจริงด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290123
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700290123,
					"content": "ผู้อาวุโส Priscina กับ Ayesha ที่สร้างอุปกรณ์อันน่าทึ่งแบบนี้ขึ้นมาได้ช่างเก่งกาจจริง ๆ สิ่งประดิษฐ์ล้ำค่าแบบนี้ไม่ควรถูกวางทิ้งในห้องเก็บของ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290124
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700290124,
					"content": "ถ้าการสำรวจใน Inazuma ครั้งนี้ไม่คืบหน้าจริง ๆ ล่ะก็ ฉันจะเปลี่ยนชื่อหัวข้อวิจัยเป็น Pursina's Spike",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290125
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700290125,
					"content": "ถ้าทางสถาบันเห็นความสำคัญของ Pursina's Spike แล้วถ้ารายงานการวิจัยของฉันถูกตีพิมพ์...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290126
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700290126,
					"content": "ฮ่าฮ่า ฉันจะใส่ชื่อเธอลงในกิตติกรรมประกาศแน่นอน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290127
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700290127,
					"content": "หวังว่าฉันจะเข้าใจงานวิจัยของเธอนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700290128
					]
				},
				{
					"id": 700290128,
					"content": "ฮ่าฮ่า เดี๋ยวก็รู้น่า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290129
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700290129,
					"content": "หวังว่าการเดินทางในอนาคตของเธอจะราบรื่น เหมือนความร่วมมือของเราครั้งนี้นะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700290119,
					"content": "ถ้าเธอบอกฉันตั้งแต่เนิ่น ๆ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700290120
					]
				},
				{
					"id": 700290120,
					"content": "ฉันไม่รอบคอบเองที่ไม่ได้นึกถึงข้อนี้มาก่อน มาพูดตอนนี้ก็สายไปแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290121
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700290103,
					"content": "ปัญหาของเราแก้ไขเรียบร้อยแล้ว",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700290104
					]
				}
			]
		}
	]
}