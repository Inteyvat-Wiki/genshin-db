					"nextDialogs": [
						721610706
					]
				},
				{
					"id": 721610706,
					"content": "ฮ่าฮ่า พูดไปเรื่อย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610707
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610707,
					"content": "รอให้เธอไล่พวกเขาไปให้หมดก่อน ค่อยมาพูดกับฉันแบบนี้!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610708
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
