					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610309,
					"content": "ยาสมุนไพรใช้หมดแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610310
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
