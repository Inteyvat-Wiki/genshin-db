					"nextDialogs": [
						755050152
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050152,
					"content": "#โอ๊ะ! Mora! {NICKNAME} พวกเราต้องไม่พลาดโอกาสหาเงินนะ!",
