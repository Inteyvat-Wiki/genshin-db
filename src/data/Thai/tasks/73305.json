					"Liloupar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733050401,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050402
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050402,
					"content": "ฮืม... Liloupar เธอโอเคมั้ย? ทำไมจู่ ๆ ก็เงียบไปล่ะ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050403,
						733050404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050403,
					"content": "ชู่ว...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050405
					]
				},
				{
					"id": 733050405,
					"content": "เดี๋ยวนะ เธอดูสิ... Liloupar กำลังส่องแสงอยู่ ดูไม่ค่อยเหมือนกับตอนปกติเลย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050406,
					"content": "ขวดของญินส่องแสงกะพริบ คล้ายกับกำลังตอบสนองสั่นพ้องกับ \"ตัวหมาก\"\\nคุณได้ยินเสียงเวลาที่กำลังไหลริน ราวกับเสียงหยดน้ำภายในคุกกุมขัง... ยาวนานเสมือนชั่วชีวิต ทว่าก็สั้นประหนึ่งชั่วพริบตา\\nLiloupar เงียบไม่พูดไม่จา",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050407
					]
				},
				{
					"id": 733050407,
					"content": "จากนั้น คุณก็ได้เห็นเมืองท่ามกลางหมอกหนา เมืองที่ทั้งใหญ่โต กว้างขวาง แต่ก็เย็นเยียบ\\nผืนดินกว้างเกิดรอยปริ กลืนกินทุกสิ่งของเมือง Gurabad...\\nหากแต่ประตูเมืองยังตั้งอยู่ตรงนั้น ฝังตัวอยู่ในหินผา สภาพอัปลักษณ์ของมันประดุจจุดศูนย์รวมแห่งมลทินทั้งสิ้นในบรรพกาล แต่กลับรอดพ้นจากสายตาของคนทั้งปวง...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050408
					]
				},
				{
					"id": 733050408,
					"content": "เมือง Gurabad มันอยู่ที่นั่น ข้าจำได้แล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050409
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050409,
					"content": "ฉันปวดหัวจัง...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050410
					]
				},
				{
					"id": 733050410,
					"content": "อุหวา พวกเธอเป็นอะไรกันไปเนี่ย... คราวหน้าถ้าจะเป็นงี้อีกต้องบอกฉันก่อนล่วงหน้านะ! อย่าเอาแต่ทำให้ฉันตกใจสิ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050411,
						733050413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050411,
					"content": "ขอโทษทีนะ Paimon",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050412
					]
				},
				{
					"id": 733050412,
					"content": "ฮึ ฉันโกรธแล้ว!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050415,
					"content": "#ฮ่ะ ๆ... อย่างกับเด็กน้อยแน่ะ เอาล่ะ อย่าเป็นห่วงไปเลย ข้าคืน{M#เขา}{F#นาง}ให้เจ้าแล้ว เจ้าตัวน้อย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050416
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050416,
					"content": "#พอถึงเวลา {M#เขา}{F#นาง}ต้องชดเชยอาหารรสเลิศให้เจ้าอีกมากมาย... อื้ม แล้วก็ต้องให้ \"มูร่า\" ค่าเงินของพวกเจ้าด้วย ใช่ไหม?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050417,
						733050418
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050417,
					"content": "\"Mora\" ต่างหากล่ะ... ทำไมฉันต้องมาแก้ให้เธอด้วยเนี่ย",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050419
					]
				},
				{
					"id": 733050419,
					"content": "แบบนี้ยังพอว่า... ฉันจำไว้แล้วนะ! ของกินอร่อย ๆ แล้วก็ Mora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050420,
					"content": "เอาล่ะ หมดเวลาเล่นแล้ว พวกเราเดินทางไปยังเมือง Gurabad กันต่อเถอะ นายท่านของข้า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050421,
						733050424
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050421,
					"content": "ทำไมพวกเราต้องไปที่นั่นด้วย?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050422
					]
				},
				{
					"id": 733050422,
					"content": "ทำไมงั้นหรือ? ข้าก็ไม่รู้... บางทีเหตุผลอาจไม่สำคัญ แต่ข้าจำเป็นต้องไปที่แห่งนั้น เพราะฉะนั้นแล้ว นายท่านของข้า...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050423
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050423,
					"content": "หากต้องมีเหตุผลสักข้อ งั้นก็คงเป็นเพราะข้าอยากให้ท่านเป็นสักขีพยานในอดีตแห่งข้า และซึมซับบทเรียนของข้า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050428
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050428,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050429
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050429,
					"content": "ถึงจะจับต้นชนปลายไม่ถูก... และฉันก็ฟังไม่ค่อยรู้เรื่องก็ตามเถอะ แต่คำพูดของเธออย่างกับกำลังจะบอกลาแน่ะ เกิดอะไรขึ้นงั้นเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050430,
					"content": "ฮ่าฮ่า ไม่มีอะไรหรอก... เพียงแต่มีบางสิ่งที่ข้าอยากให้พวกเจ้าลองดูเสียหน่อย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050431
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050431,
					"content": "อะไรเนี่ย อายุก็ตั้งขนาดนี้แล้วยังจะมาอึกอักไม่ยอมบอกอีก!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050432
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050432,
					"content": "อย่างไรก็ตาม ท่านโปรดตามข้ามาเถอะ ข้าจะนำทางไปสู่เมือง Gurabad เอง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050424,
					"content": "เมือง Gurabad... ที่นั่นมีอะไรอยู่?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050425
					]
				},
				{
					"id": 733050425,
					"content": "ไม่มีอะไรทั้งนั้น ไม่มีอะไรหลงเหลืออีกต่อไป...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050426
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050426,
					"content": "ข้าคงพูดได้แค่ว่า... ที่แห่งนั้นเหลือเพียงความทรงจำของวิญญาณ ฝันอันแตกสลายที่ไร้หนทางคืนสภาพ และความหอมหวานที่ทิ้งทวนจากการแก้แค้น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050427
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050427,
					"content": "แม้ว่าคำขอนี้จะมากเกินไปหน่อย... แต่ข้าอยากให้ท่านเป็นสักขีพยานในอดีตแห่งข้า และซึมซับบทเรียนของข้า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050428
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050418,
					"content": "อย่าตัดสินใจแทนฉันมั่วซั่วสิ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050419
					]
				},
				{
					"id": 733050413,
					"content": "ฉันไม่เป็นไร Paimon",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050414
					]
				},
				{
					"id": 733050414,
					"content": "ฮึ เธอก็พูดแบบนี้ทุกครั้งอะแหละ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050404,
					"content": "Liloupar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050405
					]
				}
			]
		},
