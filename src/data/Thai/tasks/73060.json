					"nextDialogs": [
						730600304
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730600304,
					"content": "ขอแค่รักษากลไกมหัศจรรย์ Varuna สำเร็จ...",
					"roleType": "TALK_ROLE_NPC",
