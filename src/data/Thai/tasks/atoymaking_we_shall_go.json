				"points": []
			},
			"dialogs": [
				{
					"id": 726940101,
					"content": "ที่แท้ก็นักเดินทางกับ Paimon นี่เอง พอดีเลย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 726940102,
					"content": "พอดีอะไรเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940103,
					"content": "พอดีว่ามีภารกิจนึงที่เหมาะกับพวกคุณมาก ฉันกำลังคิดว่าจะติดต่อพวกคุณอยู่พอดีเลยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 726940104,
					"content": "ภารกิจที่เหมาะกับพวกเรามาก... คงไม่ใช่พวกงานที่ต้องไปหาของ หรือกำจัดพวก Hilichurl อะไรแบบนั้นใช่มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940105,
						726940106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940105,
					"content": "ยังมีพวกเก็บขยะบนหลังคาด้วย...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940107
					]
				},
				{
					"id": 726940107,
					"content": "ไม่ใช่ ๆ ภารกิจในครั้งนี้เหมาะสมกับพวกคุณมากจริง ๆ นะ ที่ว่า \"เหมาะสมมาก\" ก็คือ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940108
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 726940108,
					"content": "งานนี้ไม่เพียงจะน่าสนุก แถมยังมีค่าตอบแทนที่มหาศาลอีกด้วยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940109
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 726940109,
					"content": "ค่าตอบแทนที่มหาศาล!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940110,
					"content": "Paimon มองข้ามส่วนที่น่าสนุกไปเลยนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940111
					]
				},
				{
					"id": 726940111,
					"content": "นะ...แน่นอนว่า ส่วนที่สำคัญที่สุดก็คือความสนุก แล้วสรุปมันคือคำขออะไรล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940112,
					"content": "อืม คำขอในครั้งนี้มาจากคุณ Bertrand ผู้ผลิตสินค้าชาว Fontaine ที่มาทำธุรกิจใน Inazuma น่ะ เขากำลังตามหาผู้ช่วยในการผลิตสินค้าอยู่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940113
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 726940113,
					"content": "เพราะว่าเป็นถึงนักธุรกิจ จำนวนค่าตอบแทนสำหรับคำขอที่ลงทะเบียนไว้กับทางกิลด์นักผจญภัยจึงค่อนข้างมากเลยทีเดียว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940114
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 726940114,
					"content": "แต่เพราะเหตุผลบางประการ ทำให้เขาเคลื่อนไหวได้แค่ใน \"Ritou\" เท่านั้น ส่วนเรื่องรายละเอียดปลีกย่อยให้เขาเป็นคนบอกพวกคุณเองก็แล้วกันนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940115
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 726940115,
					"content": "โอเค พวกเราจะไปหาเขาที่ \"Ritou\" เดี๋ยวนี้แหละ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940106,
					"content": "หรือขนส่งพวกสินค้าแปลกประหลาด...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940107
					]
				}
			]
		},
		{
			"id": 7269402,
			"completionStepIds": [
				7269402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7269402",
							"2"
						],
						"stepId": 7269402,
