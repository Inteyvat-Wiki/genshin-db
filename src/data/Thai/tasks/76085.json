			"dialogs": [
				{
					"id": 760520401,
					"content": "ฉันเคยได้กลิ่นนี้มาก่อน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520402
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760520402,
					"content": "โอ๊ะ? ที่ไหนเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520403,
					"content": "ห้องของ Sandrone น่ะ พอเธอเห็นว่าฉันสนใจเครื่องดื่มที่ส่งกลิ่นหอมนี้ เธอก็แกล้งถือไว้ในมือตั้งนานโดยไม่ยอมดื่มให้หมด",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520404
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760520404,
					"content": "เหมือนกับว่า... กำลังรอให้ฉันถามอยู่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520405
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760520405,
					"content": "แล้วเธอได้ถามรึเปล่า?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520406
					]
				},
				{
					"id": 760520406,
					"content": "อืม",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520407
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760520407,
					"content": "ถามว่าอะไรเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520408,
					"content": "\"เธอควรจะดื่มน้ำมันเครื่องไม่ใช่เหรอ?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520409
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760520409,
					"content": "แล้ว... เขาว่าไงเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520410
					]
				},
				{
					"id": 760520410,
					"content": "อืม...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520411
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760520411,
					"content": "เป็นคำหยาบน่ะ อย่าพูดถึงดีกว่า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520412
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760520412,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520413
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760520413,
					"content": "แค่ดื่มไปจิบเดียวก็ไม่สนใจแล้วเหรอเนี่ย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520414,
