			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730670201,
					"content": "(ในสองสามหน้าแรกถูกเขียนด้วยลายมือตัวจิ๋วไว้ว่า...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670202
					],
					"speakerTitle": "สมุดบันทึกที่เขียนด้วยลายมือโย้เย้ไม่คงที่"
				},
				{
					"id": 730670202,
					"content": "\"...ฮือฮือ ไม่อยากจะเชื่อว่า Nara จะยอมเป็นสหายกับ Arashakun... Nara ช่างแสนดีเหลือเกิน Nara นิสัยดีไม่รังเกียจจอมขี้ขลาดอย่าง Arashakun แถมยังสอนเขียนตัวอักษรของ Nara ด้วย\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670203
					],
					"speakerTitle": "สมุดบันทึกที่เขียนด้วยลายมือโย้เย้ไม่คงที่"
				},
				{
					"id": 730670203,
					"content": "\"...อย่างตอนที่ใบไม้หล่นลงมาบนหัวของ Arashakun จนทำให้ตกใจ Nara นิสัยดีก็คอยปลอบ Arashakun ด้วย Nara นิสัยดีจะเป็นสหายที่ดีของ Arashakun ตลอดไป\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670204
					],
					"speakerTitle": "สมุดบันทึกที่เขียนด้วยลายมือโย้เย้ไม่คงที่"
				},
				{
					"id": 730670204,
					"content": "(ในสองสามหน้าด้านหลัง ลายมือดูเปลี่ยนไป ทั้งเล็กจิ๋วและดูลุกลน...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670205
					],
					"speakerTitle": "สมุดบันทึกที่เขียนด้วยลายมือโย้เย้ไม่คงที่"
				},
				{
					"id": 730670205,
					"content": "\"...ฮือฮือ สหาย Nara ถูก 'ราชาอสูรหน้ากากขนปุย' จับตัวไปแล้ว 'ราชาอสูรหน้ากากขนปุย' แขนยาวเก้งก้าง น่ากลัว น่ากลัวมาก...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670206
					],
					"speakerTitle": "สมุดบันทึกที่เขียนด้วยลายมือโย้เย้ไม่คงที่"
				},
				{
					"id": 730670206,
					"content": "\"...ตะ แต่ว่าต้องไปช่วย Nara ออกมาให้ได้ ฮือ ๆ...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670207
					],
					"speakerTitle": "สมุดบันทึกที่เขียนด้วยลายมือโย้เย้ไม่คงที่"
				},
				{
					"id": 730670207,
					"content": "(ในสองสามหน้าให้หลัง ลายมือดูใหญ่และลงแรงในการเขียนมาก...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670208
					],
					"speakerTitle": "สมุดบันทึกที่เขียนด้วยลายมือโย้เย้ไม่คงที่"
				},
				{
					"id": 730670208,
					"content": "\"ในที่สุดเจ้า 'ราชาอสูรหน้ากากขนปุย' นั่นก็พ่ายแพ้และช่วยสหาย Nara เอาไว้ได้ สหาย Nara มอบ 'ความกล้าหาญ' ให้กับ Arashakun... Arashakun ไม่ใช่จอมขี้ขลาดคนเดิมอีกต่อไปแล้วล่ะ\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670209
					],
					"speakerTitle": "สมุดบันทึกที่เขียนด้วยลายมือโย้เย้ไม่คงที่"
				},
				{
					"id": 730670209,
					"content": "\"...Arashakun ผู้มี 'ความกล้าหาญ' กล้าที่จะต่อสู้กับพวก 'มอนสเตอร์หน้ากากขนปุย' Nara ที่อยู่แถวนี้ก็ไม่ต้องกลัวว่าจะถูก 'ราชาปีศาจหน้ากากขน' ก่อกวนอีกต่อไปแล้วล่ะ!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670210
					],
					"speakerTitle": "สมุดบันทึกที่เขียนด้วยลายมือโย้เย้ไม่คงที่"
				},
				{
					"id": 730670210,
					"content": "(และในหน้าล่าสุดนั้น ลายมือก็กลับไปเล็กจิ๋วเหมือนเดิม...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670211
					],
					"speakerTitle": "สมุดบันทึกที่เขียนด้วยลายมือโย้เย้ไม่คงที่"
				},
				{
					"id": 730670211,
					"content": "\"...ฮือ ๆ อะไรกัน 'ความกล้าหาญ' ของ Arashakun หายไปไหนแล้วล่ะ 'ความกล้าหาญ' ที่ Nara ให้มา... ต้องถูกเจ้า 'ราชาอสูรหน้ากากขนปุย' นั่นขโมยไปแล้วแหง ๆ เลย\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670212
					],
					"speakerTitle": "สมุดบันทึกที่เขียนด้วยลายมือโย้เย้ไม่คงที่"
				},
				{
					"id": 730670212,
					"content": "\" 'ราชาอสูรหน้ากากขนปุย' แขนยาวเก้งก้างจอมเจ้าเล่ห์ แถมยังน่ากลัวอีก แต่ Arashakun สูญเสีย 'ความกล้าหาญ' ไปแล้ว ก็เลยทำอะไรไม่ได้สักอย่าง... ฮือ Arashakun ต้องลองไปตามหาใน<color=#00E1FFFF>ถ้ำทางตะวันออก</color>...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "สมุดบันทึกที่เขียนด้วยลายมือโย้เย้ไม่คงที่"
				}
			]
		},
