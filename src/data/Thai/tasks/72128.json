				"points": []
			},
			"dialogs": [
				{
					"id": 721280102,
					"content": "เฮ้อ รอก่อน กล่องพวกนี้ห้ามเปิดโดยพลการนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280103,
						721280105
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280103,
					"content": "นี่เป็นกล่องของเธอเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280104
					]
				},
				{
					"id": 721280104,
					"content": "แน่นอนสิ กล่องพวกนี้เป็นของที่ฉันตั้งใจวางไว้ที่นี่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280106
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280106,
					"content": "ข้างในใส่ ของล้ำค่าที่ฉันรวบรวมมาได้จากแต่ละที่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280107
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280107,
					"content": "ถ้าเธออยากเปิดกล่องสมบัติพวกนั้นล่ะก็ จะว่าไม่ได้ก็คงไม่ใช่ แต่ว่า... เธอจะต้องให้ของแลกเปลี่ยนกับฉัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280108,
						721280110
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280108,
					"content": "ต้องการ Mora งั้นเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280109
					]
				},
				{
					"id": 721280109,
					"content": "ฮ่าฮ่าฮ่า ไม่จำเป็นต้องใช้ Mora หรอก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280111
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280111,
					"content": "ของที่ฉันอยากได้คือ \"หอยสังข์\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280112
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280112,
					"content": "ที่รอบ ๆ ชายหาด น่าจะหาหอยสังข์แบบนี้ได้เยอะมาก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280113
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280113,
					"content": "ถ้าหากว่าเธออยากเปิดกล่องสมบัติเอาของล้ำค่ามาให้ได้ ก็ต้องใช้หอยสังข์นั่นมาแลกเปลี่ยนกับฉันซะก่อน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280114
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280114,
					"content": "แต่ว่า... ฉันจะไม่บอกเธอหรอกนะ ว่าของในกล่องสมบัติมีอะไรบ้าง ส่วนจะได้สมบัติอะไรนั้น ก็ขึ้นอยู่กับโชคของเธอเองแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280115
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280115,
					"content": "ว่าไง ถ้าเธออยากจะเปิดกล่องสมบัติพวกนี้ดูล่ะก็ เอาหอยสังข์มาให้ฉันสิ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280110,
					"content": "เธออยากได้อะไร?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280111
					]
				},
				{
					"id": 721280105,
					"content": "ข้างในมีอะไร?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280106
					]
				}
			]
		},
