				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Layla",
					"Yae Miko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400840601,
					"content": "#{NICKNAME}, Paimon ฉันเข้ารอบแล้วนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840602
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400840602,
					"content": "เยี่ยมไปเลย Layla! เธอสำเร็จเงื่อนไขในการเข้าแข่งขันแล้ว!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400840603,
					"content": "ช่างน่ายินดีจริง ๆ!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400840604
					]
				},
				{
					"id": 400840604,
					"content": "ฉันได้ยินมาว่าพวกคุณเอาชนะ \"นายกระดูกเหล็กดาบคู่\" ที่ชนะมาอย่างต่อเนื่องได้... แต่ทำไมฉันถึงรู้สึกว่าพวกคุณไม่ค่อยดีใจเลยล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840605
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400840605,
					"content": "จะให้พูดยังไงดีล่ะ... คู่ต่อสู้คนนี้ไม่ค่อยเป็นมิตร แถมยังพูดจาแปลก ๆ อีกต่างหาก...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400840606,
					"content": "เล่ารายละเอียดในการต่อสู้ให้ Layla ฟัง...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400840607
					]
				},
				{
					"id": 400840607,
					"content": "ที่แท้ก็เป็นแบบนี้... รู้สึกว่าเทรนเนอร์แบบนี้ค่อนข้าง... น่าเศร้านะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840608
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400840608,
					"content": "น่าเศร้าเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400840609
					]
				},
				{
					"id": 400840609,
					"content": "อื้ม คนคนนั้นไม่เข้าใจ Haniyyah เลยสักนิด ไปคาดเดาเธอโดยอาศัยภาพจำที่ไม่ชัดเจน ถึงขั้นจะเลียนแบบเธอด้วย ถ้า Haniyyah รู้เรื่องนี้เข้า จะต้องกลุ้มใจมากแน่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840610
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400840610,
					"content": "แถมเทรนเนอร์คนนั้น ยังเข้มงวดกับพวกคู่หูเห็ดที่สามารถกลายเป็นเพื่อนรักขนาดนั้นอีก นอกจากตัวเองจะเสียหายแล้ว ยังจะส่งผลกระทบต่อสภาพจิตใจของผู้เข้าแข่งขันคนอื่นด้วย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840611
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400840611,
					"content": "ใช่น่ะสิ ฉันรู้สึกว่า Layla มีความคิดที่ดีมาก! ถ้าทุกคนเหมือนกับเธอ บรรยากาศในการแข่งขันจะต้องเป็นมิตรและสนุกยิ่งกว่าเดิมแน่!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400840612,
					"content": "เพราะเป้าหมายของฉันไม่สูงละมั้ง... ขอแค่พา \"ต้าวหมุนติ้วเคว้งคว้าง\" กลับไปใช้ชีวิตร่วมกันได้ ฉันก็พอใจมากแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840613
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400840613,
					"content": "ต่อไปก็ถึงตาพวกเราประลองกันแล้ว เราจะต้องประลองกันอย่างเป็นมิตรและมีความสุข แพ้ชนะไม่สำคัญ ถือว่าเป็นการประลองฝีมือระหว่างเพื่อนกันก็พอ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840614
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400840614,
					"content": "ตกลงตามนี้!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400840615
					]
				},
				{
					"id": 400840615,
					"content": "ดีเลย! เรามาดูกันว่าระหว่าง \"ต้าวหมุนติ้วเคว้งคว้าง\" กับ \"เจ้าหมวกกลมโป๊ก ๆ\" ใครเก่งกว่ากัน! คนชนะจะต้องเลี้ยงข้าวคนแพ้นะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400840616,
					"content": "เห็นพวกเธอสัญญากันอย่างชื่นบานแบบนี้แล้ว หรือว่าฉันจะพลาดอะไรสำคัญไป?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840617
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400840617,
					"content": "Miko ในที่สุดเธอก็โผล่มาสักที! คราวก่อนเธอไปแบบไม่บอกไม่กล่าว เรายังมีเบาะแส... อะแฮ่ม มีเรื่องจะปรึกษากับเธออีกนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400840618,
					"content": "ฉันเองก็ปวดหัวมากเหมือนกัน ฉันนึกสนุกมาลงแข่งขำ ๆ แต่ดันเข้ามาในรอบรองชนะเลิศซะได้ ก็เลยได้แต่เจียดเวลาไปหาข้อมูลเป็นเพื่อนพวก Souka แล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840619
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400840619,
					"content": "พวกเธอสองคนคงไม่น่าเป็นห่วงเท่าไหร่ ยังไงก็ต้องเป็นการแข่งขันที่ปรองดองมากแน่ ส่วนฉันก็ต้องจริงจังหน่อยล่ะ เพราะคู่ต่อสู้เป็นเจ้าคนหัวดื้อนั่นนี่นะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840620
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400840620,
					"content": "นั่นสินะ ไม่นึกเลยว่าสถานการณ์จะกลายเป็นแบบนี้ คุณ Yae จะต้องต่อสู้กับ Haniyyah แล้ว...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840621
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400840621,
					"content": "มองโลกในแง่ดีเข้าไว้ ไม่แน่ Miko อาจจะช่วยเราเอาชนะ Haniyyah ก็ได้นะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840622
