			"trigger": {
				"objectNames": [
					"นายกระดูกเหล็กดาบคู่"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400840401,
					"content": "พวกเธอต่างหากเล่า คนอ่อนหัดด้อยประสบการณ์",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840402
					],
					"speakerTitle": "นายกระดูกเหล็กดาบคู่"
				},
				{
					"id": 400840402,
					"content": "จะมั่นหน้าเกินไปแล้วนะ! มีสิทธิ์อะไรมาพูดแบบนี้เล่า!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400840403,
					"content": "มอบความรู้สึกให้กับ Fungus อย่างเปล่าประโยชน์ ช่างอ่อนหัดและน่าตลกสิ้นดี! นี่ขัดต่อหลักการของท่าน Haniyyah ผู้เป็นเทรนเนอร์ที่แข็งแกร่งที่สุด",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840404
					],
					"speakerTitle": "นายกระดูกเหล็กดาบคู่"
				},
				{
					"id": 400840404,
					"content": "เทรนเนอร์ที่แข็งแกร่งที่สุด...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400840405,
					"content": "เราจะปรับแก้แนวคิดของ Haniyyah เอง",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400840406
					]
				},
				{
					"id": 400840406,
					"content": "อย่าฝันไปหน่อยเลย! คนอ่อนแอไม่มีสิทธิ์มาต่อสู้กับท่าน Haniyyah หรอกนะ พวกเธอมาถึงได้แค่นี้เท่านั้นแหละ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "นายกระดูกเหล็กดาบคู่"
				}
			]
		},
		{
			"id": 4008406,
			"completionStepIds": [
				4008406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
