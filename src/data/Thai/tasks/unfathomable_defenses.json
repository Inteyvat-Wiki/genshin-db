					"id": 400841023,
					"content": "หรือว่า...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841024
					]
				},
				{
					"id": 400841016,
					"content": "แนวป้องกันทางจิตใจ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
