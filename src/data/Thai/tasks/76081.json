			"dialogs": [
				{
					"id": 760810201,
					"content": "ได้ต่อสู้กับคุณมันสนุกมากจริง ๆ คุณ Sigurd",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810202
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810202,
					"content": "จุดจบของผู้กล้าก็แบบนี้แหละ ช่างน่าเสียดาย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810203
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810203,
					"content": "เตร็ดเตร่อย่างเดียวดายอยู่ในดินแดนที่คุณได้อุทิศและสิ้นชีพเพื่อมัน... ตอนแรกที่ตอบรับคำสาบานของผู้เฝ้าประภาคาร คุณเคยคิดมาก่อนมั้ยว่าจะมีวันนี้?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810204
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810204,
					"content": "ต่อให้เคยคิด คุณก็คงจะไม่ลังเล",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810205
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810205,
					"content": "อนาคตฉันจะมาเยี่ยมอีก ไว้พบกันใหม่นะ คุณ Sigurd",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				}
			]
		},
