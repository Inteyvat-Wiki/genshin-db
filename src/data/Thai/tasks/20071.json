					"Flora"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200710201,
					"content": "ดอกไม้เป็นยังไงบ้าง?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710202
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710202,
					"content": "ขอโทษ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200710203
					]
				},
				{
					"id": 200710203,
					"content": "เอ๋? เกิดอะไรขึ้น?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710204
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710204,
					"content": "ฉันไม่ได้ทันระวังทำกล่องกับดอกไม้พังหมดเลย...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200710205
					]
				},
				{
					"id": 200710205,
					"content": "ทะ...ทำพัง?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710206
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710206,
					"content": "ฮือ... นั่นคือดอกไม้ที่ฉันตั้งใจเลือกมาเลย ดอกไม้สวย ๆ แบบนั้น ไม่ได้หาได้ง่าย ๆ เลยนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710207
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710207,
					"content": "ภูเขาหิมะอันตรายขนาดนั้นเลยเหรอ? แม้แต่นักผจญภัยอย่างเธอ ยังพลาดทำกล่องดอกไม้หลุดมือได้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710208
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710208,
					"content": "แต่ยังไงก็ขอบคุณเธอที่อุตส่าห์ช่วย ของพวกนี้ถือว่าเป็นการตอบแทน รับไว้ด้วยเถอะนะ ฉันขอตัวไปดูแลดอกไม้ในร้านก่อนล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710209
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710209,
					"content": "เอ่ หรือ...ฉันจะลองใช้วิธีของคุณ Sara ดี...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		},
