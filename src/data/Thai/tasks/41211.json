					"nextDialogs": [
						412110306
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110306,
					"content": "อา... ฟังดูสุดยอดไปเลยนะ!",
					"roleType": "TALK_ROLE_NPC",
