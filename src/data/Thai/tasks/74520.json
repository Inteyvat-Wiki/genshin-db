				"points": []
			},
			"dialogs": [
				{
					"id": 745200401,
					"content": "#เธอนี่เอง {NICKNAME} ไม่นึกว่าจะเจอเธอในที่แบบนี้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200402,
						745200403
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200402,
					"content": "ไม่เจอกันนานเลยนะ Eula!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200404
					]
				},
				{
					"id": 745200404,
					"content": "ก็ลาดตระเวนตามปกตินั่นแหละ แต่สำหรับฉันแล้ว มันเป็นกิจกรรมที่จำเป็น เพื่อรักษาความพร้อมในการต่อสู้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200405
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200405,
					"content": "ช่วงนี้ Mondstadt ค่อนข้างสงบ แทบไม่มีภัยคุกคาม ที่ร้ายแรงพอให้กองสอดแนมต้องยกพลออกมากัน พวกเรา... ก็ผ่อนคลายขึ้นเยอะเหมือนกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200406
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200406,
					"content": "การได้พักผ่อนบ้างก็เป็นเรื่องดีนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200407
					]
				},
				{
					"id": 745200407,
					"content": "ถึงอย่างนั้นก็เถอะ แต่หัวหน้าอย่างฉัน ก็ต้องรักษาความสามารถ ในการต่อสู้ของตัวเองไว้ตลอดเวลา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200408
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200408,
					"content": "ถึงยังไง ดาบของศัตรู ก็ไม่มีวันทื่อเพราะสันติภาพหรอก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200409
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200409,
					"content": "เพราะงั้นฉันเลยมักจะหาที่เงียบ ๆ ฝึกดาบในช่วงที่ว่างจากการลาดตระเวน เพื่อให้แน่ใจว่าจะไม่ลืมท่วงท่าต่าง ๆ ไป",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200410,
						745200411
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200410,
					"content": "ได้จังหวะพอดีเลย!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200412
					]
				},
				{
					"id": 745200412,
					"content": "หืม? เป็นคำขอที่น่าสนใจนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200413
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200413,
					"content": "แต่ฉันเคลื่อนไหวเร็วนะ กล่องถ่ายรูปของเธอจะตามทันรึเปล่า?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200414,
						745200415
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200414,
					"content": "ใช้ความเร็วปกติของเธอก็พอแล้ว!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200416
					]
				},
				{
					"id": 745200416,
					"content": "ได้ ในเมื่อเธอมั่นใจขนาดนี้ ฉันก็ต้องทุ่มสุดตัวแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200417
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200417,
					"content": "ดูให้ดี ๆ นะ ช่วงเวลาที่คลื่นม้วนตัว มันไวในพริบตาเลยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200415,
					"content": "กล้องของฉันจะพยายามตามเธอให้ทันเอง!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200416
					]
				},
				{
					"id": 745200411,
					"content": "ขอถ่ายรูปเธอหน่อยนะ!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200412
					]
				},
				{
					"id": 745200403,
					"content": "เธอกำลังปฏิบัติหน้าที่อยู่ตรงนี้เหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200404
					]
				}
			]
		}
	]
}