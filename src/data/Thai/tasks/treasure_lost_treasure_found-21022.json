						"rawParams": [
							"2102209",
							"2"
						],
						"stepId": 2102209,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soraya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210229501,
					"content": "เจอแผ่นศิลาจารึกห้าแห่ง",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210229502
					]
				},
				{
					"id": 210229502,
					"content": "เยี่ยมไปเลย ไหนฉันดูซิ... อืม ตัวหนังสือพวกนี้ปนกันมั่วไปหมดแล้ว ฉันจะเรียบเรียงดูนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220302
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220302,
					"content": "...ดูเหมือนว่าจะมีตัวอักษรหลายตัวที่ขาดหายไปนะ อ่านไม่ปะติดปะต่อเท่าไหร่ และก็ไม่รู้ด้วยว่าการเรียงลำดับแบบนี้ถูกต้องรึเปล่า...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220303
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220303,
					"content": "อย่างไรก็ตาม ฉันลองทำดูคร่าว ๆ แล้วล่ะ เมื่อเรียงตัวอักษรเหล่านี้เข้าด้วยกันก็จะเป็น...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220304
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220304,
					"content": "\"...ในตอนแรกเริ่มนั้นเฟื่องฟูขึ้นมาเพราะการเกษตร ผู้คนรวมตัวกันจนเกิดเป็นชุมชน... มีเทพนามว่า Guizhong ประทับอยู่ เทพผู้ควบคุมฝุ่นธุลีให้ปกคลุมไปทั่วผืนฟ้าอันกว้างใหญ่...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220305
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220305,
					"content": "\"...นำบทบัญญัติสี่ข้อมาสู่ราษฎร... จากนั้นเทพอีกตนก็ปรากฏ เทพผู้ใช้หินเป็นเครื่องมือ เทพผู้นำชาว Liyue มารวมตัวกันและปกป้องพวกเขา...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220306
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220306,
					"content": "\"...ใช้นามของเทพทั้งสอง ตั้งชื่อชุมชนแห่งนี้เป็น Guili\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220307
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220307,
					"content": "ดูท่า... นี่จะเป็นคำบอกเล่าถึงประวัติศาสตร์ความเป็นมาของ Guili Assembly นะ แล้วก็เทพตนหนึ่งที่ปกครอง Guili Assembly อยู่ เทพผู้มีพลังในการควบคุมฝุ่นธุลี",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220308
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220308,
					"content": "แต่ว่า... ด้านบนยังพูดถึงเทพอสูรอีกตนหนึ่งที่เคยมายังสถานที่แห่งนี้อีกด้วย เทพตนนั้นถึงขั้นนำราษฎรของตัวเองมาด้วยส่วนหนึ่งเลยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220309
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220309,
					"content": "แม้แต่ชื่อ Guili Assembly นี้ ก็ยังเป็นชื่อที่เกิดขึ้นจากการนำชื่อของเทพทั้งสองตนนั้นมารวมกันเลยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220310
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220310,
					"content": "หายากจริง ๆ ในจารึกทั้งหมดที่ฉันเคยอ่านมาน่ะ ยังไม่เคยพูดถึงการที่เทพอสูรสามารถอยู่ร่วมกันแล้วก็ช่วยเหลือซึ่งกันและกันอย่างนี้หรอกนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220311
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220311,
					"content": "ไม่ใช่แค่เป็นเทพอสูรทั้งสองตน แต่ทั้งสองตนยังเป็นเพื่อนที่ดีต่อกันด้วยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220312
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220312,
					"content": "แต่ว่าแปลกจริง ๆ... ทำไมอยู่ ๆ ก็หายไปซะอย่างนั้นล่ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220313
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220313,
					"content": "แล้วหนำซ้ำ Guili Assembly ยังเหลือแต่ซากอย่างนี้อีกด้วย? ทั้ง ๆ ที่มีเทพอสูรถึงสองตนคอยปกปักรักษา โดยทั่วไปแล้วไม่น่าจะมีภัยพิบัติอะไรที่จะมาทำลาย Guili Assembly ได้สิ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220314
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220314,
					"content": "จะต้องมีเรื่องร้ายแรงอะไรที่แม้แต่เทพอสูรก็ยังไม่สามารถแก้ไขได้เกิดขึ้นแน่นอน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220315
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220315,
					"content": "นักเดินทาง เธอช่วยไปหาเบาะแสรอบ ๆ นี้อีกทีได้มั้ย? ถ้าเกิดฉันคิดไม่ผิดล่ะก็ ที่นี่น่าจะยังมีแผ่นศิลาอย่างที่เธอเจอก่อนหน้านี้อีกนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220316
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220316,
					"content": "บางทีเรื่องราวหลังจากนั้นอาจจะมีบอกไว้บนแผ่นศิลาพวกนั้นก็ได้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220317
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220317,
					"content": "แต่ดูเหมือนสิ่งที่บันทึกไว้บนแผ่นศิลาเหล่านี้ กับสิ่งที่บันทึกไว้ในจารึกจะแตกต่างกัน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220318
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220318,
					"content": "เอ่ ทั้งตำนานต่าง ๆ และเรื่องเล่ามากมาย...อันไหนคือเรื่องจริงกันแน่นะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
