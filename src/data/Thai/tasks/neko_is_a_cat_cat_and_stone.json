			"dialogs": [
				{
					"id": 722120101,
					"content": "ท่านมาพอดีเลย มาช่วยข้าน้อยหน่อยสิ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120102,
					"content": "เรื่องอะไรเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120103
					]
				},
				{
					"id": 722120103,
					"content": "ข้าน้อยอยาก...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120104
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120104,
					"content": "ไปวางหินสูง ๆ ใหญ่ ๆ แล้วก็มีรูปร่างเหมือนกับข้าน้อยไว้ข้าง ๆ ศาลเจ้า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120105
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120105,
					"content": "จะ จะไปหาหินแบบนั้นมาจากที่ไหนกันล่ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722120106,
					"content": "พูดถึงรูปปั้นสินะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120107
					]
				},
				{
					"id": 722120107,
					"content": "สิ่งที่ข้าน้อยอยากได้ คือบางสิ่งที่คล้ายกับหินจิ้งจอกบนเกาะที่อยู่ห่างไกลออกไปเกาะนั้นน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120108
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120108,
					"content": "Hibiki เคยบอกไว้ว่าที่บนเกาะนั้นมีหินจิ้งจอกเยอะแยะไปหมด และยังบอกอีกว่าจะทำให้ข้าน้อยอันนึงด้วยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120109
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120109,
					"content": "ข้าน้อยรู้สึกว่า สิ่งที่ Hibiki อยากได้จะต้องเป็นสิ่งที่ดี ท่านช่วยทำหินให้ข้าน้อยหน่อยเถอะนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120110,
						722120113
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120110,
					"content": "ฉันไม่มีฝีมือในการแกะสลัก...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120111
					]
				},
				{
					"id": 722120111,
					"content": "อ่อ ทำยังไงดีล่ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722120112,
					"content": "ใช่แล้วล่ะ ไปหา Taisuke กันเถอะ! เขาชอบแมวมาก บางทีเขาอาจจะเต็มใจที่จะช่วย Neko แกะสลักก็เป็นได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722120113,
					"content": "ไปให้ Taisuke ช่วยก็ดีเหมือนกัน...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120114
					]
				},
				{
					"id": 722120114,
					"content": "ก็มีเหตุผลนะ! เขาชอบแมวขนาดนั้น ไม่อาจจะช่วยได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7221202,
			"completionStepIds": [
				7221202
			],
