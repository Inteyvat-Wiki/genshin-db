					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750503
					]
				},
				{
					"id": 766750503,
					"content": "ได้เลย อย่าเพิ่งยอมแพ้ ลองอีกครั้งนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
