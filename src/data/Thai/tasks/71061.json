							"7106110",
							"2"
						],
						"stepId": 7106110,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710610301,
					"content": "#ชื่นชม {NICKNAME} ชื่นชม Paimon",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610302
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610302,
					"content": "Xamaran ร้องขอตั้งนานแต่ก็ไม่มีใครตอบรับเลย ยิ่งไม่ต้องพูดถึงพวกหลายขากับสี่ขาเลย แถมพวกสองขาก็ทำเป็นหูหนวกตาบอดกับเสียงขอความช่วยเหลือของ Xamaran เหมือนกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610303
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610303,
					"content": "#มีเพียงแค่ผู้ที่มีปัญญาอย่างแท้จริงเท่านั้น จึงจะตอบรับเสียงเรียกของ Xamaran ซึ่ง Paimon เป็นผู้มีปัญญา {NICKNAME} ก็เป็นผู้มีปัญญาเหมือนกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610304
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610304,
					"content": "ผู้เปี่ยมสติปัญญาที่สุดในบรรดาสองขา สมควรได้รับคำขอบคุณจาก Xamaran",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610323
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610323,
					"content": "หึหึ อย่าประมาท \"ผู้มีปัญญา\" อย่าง Paimon เชียวล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610305,
					"content": "เรื่องจิ๊บ ๆ น่ะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610306
					]
				},
				{
					"id": 710610306,
					"content": "#Xamaran เชื่อว่าเมื่อถึงเวลา {NICKNAME} และ Paimon จะต้องกลายเป็นสิ่งมีชีวิตที่มีระดับการคงอยู่เหมือนกับ Xamaran และเผ่าพันธุ์ของ Xamaran อย่างแน่นอน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610307
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610307,
					"content": "เดี๋ยวนะ ที่เห็ดยักษ์พูดหมายความว่าไงเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610308,
					"content": "หลายขาเทียบไม่ได้กับสี่ขา สี่ขาเทียบไม่ได้กับสองขา และแน่นอนว่าสองขาก็เทียบไม่ได้กับการไม่มีขาอยู่แล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610309
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610309,
					"content": "#แม้ว่า {NICKNAME} และ Paimon จะเกิดมาพร้อมกับความบกพร่อง แต่ตราบใดที่มีจิตใจดี ความพยายามในอนาคตก็อาจจะเปลี่ยนเส้นทางแห่งโชคชะตาได้นะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610310
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610310,
					"content": "ก็แค่เห็ดยักษ์เรืองแสง ทำไมถึงได้โอหังแบบนี้นะ! สงสัยจังว่าเห็ดเรืองแสงแบบนี้จะเอาไปทำอาหารได้มั้ยนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610311,
						710610312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610311,
					"content": "Chicken-Mushroom Skewer ก็ไม่เลวนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610313
					]
				},
				{
					"id": 710610312,
					"content": "เห็ดที่สวยงามก็มักจะหลอกลวงเก่ง มันจะต้องมีพิษแน่",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610313
					]
				},
				{
					"id": 710610313,
					"content": "Paimon ตะกละ วันนี้กินเห็ด พรุ่งนี้กินเห็ด อีกร้อยวันข้างหน้าก็จะไม่เหลือ Paimon อยู่ในตัว Paimon อีก จะหลงเหลือแต่เห็ดเท่านั้น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610314
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610314,
					"content": "#ฮือฮือ {NICKNAME} เจ้าเห็ดยักษ์พูดจาน่ากลัวมากเลย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610315,
					"content": "อืม Paimon ไม่มีอารมณ์ขันสินะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610316
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610316,
					"content": "ประโยคนี้ไม่เห็นจะน่าขำสักนิดเลย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610317,
					"content": "Xamaran เป็นอิสระจากกลิ่นอายชั่วร้ายแล้ว แต่เผ่าพันธุ์ของ Xamaran ยังคงทุกข์ทรมานอยู่ และตอนนี้ Xamaran ก็ไม่มีกำลังที่จะปกป้องผู้อ่อนแออย่างที่เคยทำ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610318
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610318,
					"content": "#Xamaran ขอร้อง {NICKNAME} โปรดเมตตาและให้ความช่วยเหลือผู้อ่อนแอที่ไม่สามารถช่วยเหลือตัวเองได้ด้วยเถอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610319
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610319,
					"content": "#หมายความว่า ยังมีเห็ดอื่น ๆ ที่ป่วยอีกงั้นเหรอ? {NICKNAME} ไปช่วยพวกเขาดีมั้ย",
