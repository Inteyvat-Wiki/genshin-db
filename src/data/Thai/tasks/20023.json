			"dialogs": [
				{
					"id": 200230201,
					"content": "ฮ่าฮ่าฮ่า ทุกวันฉันก็รอแต่แก้วนี้นี่แหละ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230202
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200230202,
					"content": "คุณจะเลิกเหล้าไม่ใช่เหรอไง?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230203
					]
				},
				{
					"id": 200230203,
					"content": "อ๋า?! ตกใจแทบแย่แหนะ... นึกว่าเมียฉันซะอีก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230204
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200230204,
					"content": "ดื่มนิดหน่อยนาน ๆ ทีไม่เป็นไรหรอกน่า ก็ทำงานหนักมาทั้งวันนี่นา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230205
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200230205,
					"content": "โอเค ๆ ฉันจะดื่มอีกหน่อย แล้วก็จะกลับล่ะ... Eury คงจะซื้อของใกล้เสร็จแล้วมั้งนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nimrod"
				}
			]
		},
