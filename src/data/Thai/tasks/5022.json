						50220402
					]
				},
				{
					"id": 50220402,
					"content": "(ทำไมฉันถึงมาอยู่ที่นี่ล่ะ? เมื่อกี้ฉันยังอยู่ที่... เอ่อ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220403
					]
				},
				{
					"id": 50220403,
					"content": "(เวียนหัวจังแฮะ คิดอะไรไม่ออกเลย ไปเดินดูแถวนี้ก่อนดีกว่า)",
