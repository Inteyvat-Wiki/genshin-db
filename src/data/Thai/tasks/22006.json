			"dialogs": [
				{
					"id": 220060101,
					"content": "มันอยู่ที่ไหนกันนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060102
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060102,
					"content": "ทำอะไรหายไปอีกแล้วล่ะ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060103
					]
				},
				{
					"id": 220060103,
					"content": "ครั้งนี้ไม่ใช่ \"หาย\" แต่เป็นกำลังเริ่มหาต่างหาก! แต่ว่า... หายังไงก็ไม่เจอ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060104
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060104,
					"content": "อยู่ที่ไหนกันแน่นะ ลำบากแทบแย่กว่าจะได้ตำแหน่งมา...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060105
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060105,
					"content": "#{F#เธอ}{M#นาย}เองก็มาช่วยฉันหาด้วยสิ ของโบราณที่แสนสำคัญนั่น จะปล่อยให้มันหายอยู่อย่างนี้ไม่ได้เด็ดขาด!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060106,
						220060107
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060106,
					"content": "โอเค...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060108
					]
				},
				{
					"id": 220060108,
					"content": "#งั้น{F#เธอ}{M#นาย}ไปทางนั้นละกันนะ ฉันจะหาอยู่ที่นี่ต่อ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060109
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060109,
					"content": "ต้องหามันให้เจอให้ได้!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060107,
					"content": "ครั้งนี้ก็ของโบราณงั้นเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060110
					]
				},
				{
					"id": 220060110,
					"content": "คือ... คือ... เอ่อ สมัยโบราณเมื่อนานมาแล้ว! นับย้อนไป... หนึ่งพัน อ๊ะ ไม่สิ ช่วงเวลาของสงครามเทพอสูรน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060111
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060111,
					"content": "#สรุปก็คือเป็นของโบราณที่มีความสำคัญมาก จะปล่อยให้มันหายอยู่อย่างนี้ไม่ได้เด็ดขาด! {F#เธอ}{M#นาย}เองก็มาช่วยฉันหาด้วยสิ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				}
			]
		},
