				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400670201,
					"content": "...นึกไม่ถึงเลยว่า จะได้จัดการเรื่องที่เหลือเชื่อเช่นนี้ในสถานที่ที่มีทิวทัศน์อันงดงามแบบนี้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670202
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670202,
					"content": "รู้สึกเป็นยังไงบ้างล่ะ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400670203
					]
				},
				{
					"id": 400670203,
					"content": "ก็ไหวอยู่นะ ถ้าเธอช่วยฉันอีกแรงจะยิ่งดีขึ้นไปอีก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670204
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670204,
					"content": "ถ้างั้นโดยหลัก ๆ ต้องการให้พวกเราทำอะไรบ้างเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670205,
					"content": "หื้ม...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670206
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670206,
					"content": "เอ่อ... อ่า... ก็เหมือนจะไม่มีอะไรนะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670207
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670207,
					"content": "นี่เธอ เธอดูถูกพวกเราเหรอ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670208,
					"content": "เปล่านะ ฉันเพิ่งรู้สึกตัวเมื่อกี้ว่า ถึงแม้เธอจะพูดไม่เก่ง แต่ก็มักจะจัดการเรื่องราวได้เป็นอย่างดี แถมยังทำอะไรหลายอย่างเพื่อทุกคนอย่างเงียบ ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670209
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670209,
					"content": "คนแบบเธอเป็นคู่หูที่ทุกคนต้องการมากที่สุดเลยนะ ขอเพียงมีเธออยู่ ก็สบายใจขึ้นเยอะเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670210
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670210,
					"content": "ถึงการคาดหวังโดยไม่ได้ความยินยอมอาจจะสร้างแรงกดดันให้กับอีกฝ่ายก็เถอะ แต่ฉันคิดว่า... โหรแห่งดวงดาวจะต้องเป็นคนช่างสังเกตการณ์ และการมองเห็นจุดเด่นของผู้อื่นก็เป็นการสังเกตการณ์อย่างหนึ่งเช่นกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670211
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670211,
					"content": "เธอก็แค่อยากอวยพวกเราเท่านั้นเอง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670212,
