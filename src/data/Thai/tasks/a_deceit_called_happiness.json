				]
			},
			"dialogs": [
				{
					"id": 120460301,
					"content": "วันนี้ตอนออกทะเล ฉันไม่ได้สังเกตเลยว่าฉันทำตาข่ายขนาดใหญ่นั้นหล่นหายไป แต่ก็ไม่เป็นไรหรอก ฮ่าฮ่า...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460302
					],
					"speakerTitle": "Umihiko"
				},
				{
					"id": 120460302,
					"content": "ฉันเองก็ทำเรื่องพังไม่เป็นท่าเหมือนกัน แต่พอมาคิดดูแล้ว ปล่อยพวกโจรไปสักสองสามคน ก็ไม่ใช่เรื่องใหญ่อะไร ฮ่าฮ่า...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460303
					],
					"speakerTitle": "Susukida"
				},
				{
					"id": 120460303,
					"content": "นี่ พวกนายสองคนน่ะ! เพราะฝันร้ายของพวกนายเลย Murasaki กับ Shion ถึงได้กลายเป็นแบบนี้!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460304,
					"content": "เจ้าตัวน้อยนี่ขี้โมโหจังเลยนะ น่าสนใจดีนี่ ฮ่าฮ่า...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460305
					],
					"speakerTitle": "Susukida"
				},
				{
					"id": 120460305,
					"content": "น่าสนใจจริง ๆ ฮ่าฮ่า...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460306
					],
					"speakerTitle": "Umihiko"
				},
				{
					"id": 120460306,
					"content": "เอ่อ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460307,
					"content": "อะไรเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460308
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460308,
					"content": "สองคนนี้แปลกมากเลย ฉันรู้สึกว่าน้ำเสียงของตัวเองเมื่อกี้ค่อนข้างรุนแรงแล้วนะ แต่พวกเขากลับไม่โกรธเลยสักนิด",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460309,
					"content": "...เดี๋ยวฉันจัดการเอง พวกนายยังจำเรื่องที่เคยไปโรงอาบน้ำ Aisa เพื่อปรับสภาพความฝันเมื่อคืนได้มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460310
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460310,
					"content": "เราไปเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460311
					],
					"speakerTitle": "Umihiko"
				},
				{
					"id": 120460311,
					"content": "ไม่มั้ง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460312
					],
					"speakerTitle": "Susukida"
				},
				{
					"id": 120460312,
					"content": "เอ่อ... ช่วงนี้พวกนายสองคนฝันร้ายบ้างรึเปล่า?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460313
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460313,
					"content": "จะฝันร้ายได้ไงกัน? ในโลกนี้จะมีอะไรที่ทำให้คนฝันร้ายได้?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460314
					],
					"speakerTitle": "Susukida"
				},
				{
					"id": 120460314,
					"content": "ขอฉันคิดก่อนนะ... ไม่มีเลย คนปกติจะฝันร้ายได้ยังไงกัน? แค่มองทะเล ชื่นชมดอกไม้ ชีวิตก็สวยงามมากแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460315
					],
					"speakerTitle": "Umihiko"
				},
				{
					"id": 120460315,
					"content": "นี่มันอะไรกันเนี่ย? ดูเหมือนเจ้าสองคนนี้จะจำเรื่องเมื่อคืนไม่ได้สักนิดเลยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460316,
					"content": "แต่ว่า พอนึกถึงสภาพตอนนี้ของพวกเขาแล้ว ฉันก็นึกภาพไม่ออกเลยจริง ๆ ว่าพวกเขาจะฝันร้ายได้... หรือว่า \"Emura Ichigensai\" คนนั้นจะไม่ได้หลอกลวงใคร?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460317,
					"content": "#ไม่สิ สภาพจิตใจแบบนี้มันแปลกมาก... {NICKNAME} กับ Paimon อย่าว่อกแว่กนะ เดี๋ยวฉันอาจจะต้องใช้วิธีพิเศษบางอย่าง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460318
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460318,
					"content": "นี่มัน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460319,
					"content": "ฉันพบว่าจิตใต้สำนึกของพวกเขากำลังล่องลอยไปมา ซึ่งฉันสามารถใช้วิธีที่คล้ายกับการเข้าสู่ความฝัน เพื่อเข้าไปในจิตใต้สำนึกของพวกเขาได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460320
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460320,
					"content": "บ้าเอ๊ย! ให้ตายสิ! จะปล่อยพวกนั้นไปไม่ได้ ไม่ได้เด็ดขาด!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460321
					],
					"speakerTitle": "Susukida",
					"speakerSubtitle": "Susukida ที่โมโห"
				},
				{
					"id": 120460321,
					"content": "คลื่นลมแรงเกินไป ให้ฉันอยู่บนฝั่งเถอะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460322
					],
					"speakerTitle": "Umihiko",
					"speakerSubtitle": "Umihiko ผู้หวาดกลัว"
				},
				{
					"id": 120460322,
					"content": "หา!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460323,
					"content": "อย่างที่พวกเธอเห็น \"ความกลุ้มใจ\" ของพวกเขาไม่ได้หายไปเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460324
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460324,
					"content": "คนชื่อ Susukida น่าจะเป็นคนใจร้อนและโกรธง่าย ซึ่งสิ่งนี้จะทำให้เขาทำอะไรที่ผิดแปลกไปจากปกติ และทำให้เขาเสียสมาธิได้ง่าย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460325
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460325,
					"content": "ส่วน Umihiko คนนี้ อาจจะกลัวพายุหรือคลื่นลม เพราะเคยมีประสบการณ์จากภัยพิบัติ และไม่อยากออกทะเลอีก ซึ่งสิ่งนี้ก็น่าจะส่งผลกระทบต่อการใช้ชีวิตของเขาอย่างมากเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460326
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460326,
					"content": "อารมณ์ด้านลบของพวกเขาถูกแยกออกจากจิตใจ และล่องลอยอยู่ในจิตใต้สำนึก เพราะงั้นพวกเขาเลยแสดงออกมาแค่ \"ความสุข\" เท่านั้น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460327
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460327,
					"content": "แต่อารมณ์ที่ถูกกดไว้เหล่านั้นจะค่อย ๆ เพิ่มขึ้นในจิตใต้สำนึก และกลายเป็นฝันร้ายที่พวก Murasaki ไม่สามารถย่อยได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460328
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460328,
					"content": "ทำไมถึงเป็นแบบนั้นล่ะ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460329
					]
				},
				{
					"id": 120460329,
					"content": "ฉันว่า \"Emura Ichigensai\" คนนั้นคงไม่ธรรมดาอย่างที่เราคิดแน่ ๆ บางทีเขาอาจจะมีความสามารถในการสร้างผลกระทบต่ออารมณ์ของมนุษย์จริง ๆ เพราะงั้นคนพวกนั้นจึงไม่เคยมองเขาออกเลย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460330
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460330,
					"content": "เมื่อวานตอนที่พวกเธอมาที่นี่ ได้สังเกตเห็นอะไรแปลก ๆ บ้างมั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460331
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460331,
					"content": "ตอนนั้นสองคนนี้ดูปกติกว่านี้นะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460332,
					"content": "ถ้าจะให้พูดละก็...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460333
					]
				},
				{
					"id": 120460333,
					"content": "คุณนึกถึงความฝันประหลาดเมื่อวานขึ้นมา และเล่าให้ Mizuki ฟัง",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						120460334
					]
				},
				{
					"id": 120460334,
					"content": "มีเรื่องแบบนี้เกิดขึ้นด้วยเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460335
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460335,
					"content": "ตอนนั้นฉันก็ไม่ได้สนใจมาก",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460336
					]
				},
				{
					"id": 120460336,
					"content": "หรือว่า... เราต้องรีบหา \"Emura Ichigensai\" คนนี้ให้เจอโดยเร็วที่สุด!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460337
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460337,
					"content": "Mizuki ทำไมจู่ ๆ ถึง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460338
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460338,
					"content": "ตอนนี้ฉันมั่นใจแล้วว่า \"Emura Ichigensai\" คนนั้นไม่ใช่มนุษย์ธรรมดา ผู้คนที่เคยได้รับ \"การชี้นำ\" เหล่านั้นต่างก็เป็นเหยื่อของเขา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460339
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460339,
					"content": "ถ้าไม่รีบจัดการ \"Emura Ichigensai\" ที่เป็นต้นตอของปัญหาให้ทันการละก็ บุคลิกของเหยื่อเหล่านี้ ก็จะได้รับความเสียหายอย่างถาวร แบบที่ไม่สามารถแก้ไขได้แล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460340
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460340,
					"content": "แย่แล้ว... งั้นคงต้องถามสองคนนี้ดูเท่านั้นแล้วล่ะ พวกนายรู้มั้ยว่า \"Emura Ichigensai\" จะมาที่นี่เมื่อไหร่?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460341
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460341,
					"content": "ทำไมจู่ ๆ ก็ใจร้อนซะงั้น? มาเมื่อไหร่แล้วมันสำคัญยังไงเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460342
					],
					"speakerTitle": "Susukida"
				},
				{
					"id": 120460342,
					"content": "มาเมื่อไหร่ก็ได้ทั้งนั้นแหละ ฮ่าฮ่า...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460343
					],
					"speakerTitle": "Umihiko"
				},
				{
					"id": 120460343,
					"content": "น่าโมโหชะมัด!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460344
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460344,
					"content": "ที่จริงพวกนายจำเรื่องที่เกิดขึ้นเมื่อคืนได้ใช่มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460345
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460345,
					"content": "ที่พวกนายไม่ยอมพูดถึงมัน ก็เพราะฝันร้ายที่กวนใจพวกนายเมื่อคืนนี้ ไม่เข้ากับ \"ความสุข\" ในตอนนี้ของพวกนายสินะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460346
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460346,
					"content": "พอนึกย้อนกลับไป ก็รู้สึกถึงความแตกต่างที่ไม่สามารถอธิบายได้ ที่แทบจะฉีกสติของพวกนายออกเป็นชิ้น ๆ เลยใช่มั้ยล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460347
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460347,
					"content": "...เลิกพูดได้แล้ว แค่ไม่คิดถึงมัน ทุกอย่างก็จะไม่เป็นไรแล้ว...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460348
					],
					"speakerTitle": "Umihiko"
				},
				{
					"id": 120460348,
					"content": "นี่แหละคือความอันตรายที่ \"Emura Ichigensai\" ทิ้งไว้บนตัวพวกนาย แต่ตอนนี้ฉันไม่ได้มาเพื่อแก้ไขการหลอกตัวเองของพวกนายหรอก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460349
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460349,
					"content": "ขอแค่พวกนายตอบคำถามเมื่อกี้มาให้ดีก็พอ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460350
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460350,
					"content": "ก็ได้... แต่เราไม่รู้จริง ๆ เมื่อกี้พวกเราก็ถามแล้ว รู้แค่ว่าวันนี้เขาจะไม่มาเท่านั้น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460351
					],
					"speakerTitle": "Susukida"
				},
				{
					"id": 120460351,
					"content": "ใช่ รู้สึกว่าจะเป็นเพราะเมื่อวานเหนื่อยเกินไปรึเปล่านะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460352
					],
					"speakerTitle": "Umihiko"
				},
				{
					"id": 120460352,
					"content": "พยายามเลี่ยงฉันอีกแล้วสินะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460353
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460353,
					"content": "หรือว่าสุดท้ายแล้ว ก็ยังไม่ได้ข้อมูลที่มีประโยชน์อยู่ดี?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460354
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460354,
					"content": "พวกเธอรู้รึยังว่า \"Emura Ichigensai\" อยู่ที่ไหน?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460355
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460355,
					"content": "เมื่อวานฉันก็ถามมาแล้ว แต่คนที่เฝ้าประตูให้เขาก็บอกว่าไม่รู้เหมือนกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460356
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460356,
					"content": "ถ้าอย่างนั้น...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460357,
						120460358
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460357,
					"content": "Mizuki ตอนนี้...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460359
					]
				},
				{
					"id": 120460359,
					"content": "ตอนนี้ฉันเข้าใจฝันร้ายของสองคนนั้นแล้ว และสามารถรักษา Murasaki กับ Shion ได้แล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460360,
						120460361
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460360,
					"content": "งั้นก็รีบไปรักษาพวกเขากันก่อนเถอะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460362
					]
				},
				{
					"id": 120460362,
					"content": "...อันที่จริง หลังจากที่พวกเธอพาฉันมาที่นี่ ฉันก็ไม่มีเหตุผลที่จะต้องรบกวนพวกเธออีกแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460363
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460363,
					"content": "#{NICKNAME} กับฉันยังรอตั้งตารอการบำบัดจิตใจครั้งหน้าอยู่นะ ถ้า Mizuki เอาแต่กังวลเรื่องของเจ้านั่น พวกเราก็ไม่รู้ว่าจะมีโอกาสอีกเมื่อไหร่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460364
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460364,
					"content": "เพราะงั้น จนกว่า Mizuki จะสามารถสงบจิตใจ และกลับมาบริหารโรงอาบน้ำ Aisa ได้อีกครั้ง พวกเราจะช่วยเธอจนถึงที่สุดเลย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460365
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460365,
					"content": "...ดูจากสถานการณ์ของ Murasaki กับ Shion ในตอนนี้ ฉันจะมัวลังเลนานกว่านี้ไม่ได้แล้ว คงต้องรบกวนพวกเธออีกครั้งแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460366
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460366,
					"content": "แต่ฉันมีเรื่องจะขอ ถ้าเจอ \"Emura Ichigensai\" แค่จับตาดูเขาไว้ก็พอ อย่าเพิ่งทำอะไร แล้วก็ให้ใครสักคนมาบอกฉันก่อน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460367
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460367,
					"content": "เอาเป็นว่า ฉันไม่อยากให้พวกเธอต้องตกอยู่ในอันตรายน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460368
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460368,
					"content": "#ไม่ต้องห่วงนะ ฉันกับ {NICKNAME} เคยจัดการศัตรูมาเยอะแยะ เจ้านี่คงไม่คณามือหรอกมั้ง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460369
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460369,
					"content": "Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460370
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460370,
					"content": "โอเค พวกเราจะแจ้งให้เธอรู้ก่อนแน่นอน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460371
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460371,
					"content": "ดีเลย งั้นพวกเราออกเดินทางกันเถอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460372
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460372,
					"content": "เธอก็แค่ไม่อยากให้ Mizuki เป็นห่วงใช่มั้ยล่ะ? แต่ในเมื่อพูดไปแล้ว ถ้าเกิดหาเจ้านั่นไม่เจอจะทำยังไงล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460373
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460373,
					"content": "สองคนนี้... ถามไปก็ไม่ได้อะไรเพิ่มเติมแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460374,
						120460375
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460374,
					"content": "พวกเขาไม่รู้แน่",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460376
					]
				},
				{
					"id": 120460376,
					"content": "Miko? นึกออกแล้ว ที่เมื่อวานพวกเราหาที่นี่เจอได้ ก็เพราะได้ยินเธอพูดถึงสถานที่ตรงนี้นี่นา ดูเหมือนว่าเธอจะมีข้อมูลอยู่ในมือเพียบเลยนะเนี่ย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460377
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460377,
					"content": "อย่ามัวแต่ช้าอยู่เลย เรารีบไปที่ศาลเจ้า Grand Narukami กันเถอะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460375,
					"content": "แต่ Miko น่าจะรู้นะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460376
					]
				},
				{
					"id": 120460361,
					"content": "ฉันจะรับผิดชอบเรื่องตามหา \"Emura Ichigensai\" เอง",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460362
					]
				},
				{
					"id": 120460358,
					"content": "สามารถรักษา Murasaki กับ Shion ได้รึยัง?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460359
					]
				}
			]
		},
		{
			"id": 1204604,
