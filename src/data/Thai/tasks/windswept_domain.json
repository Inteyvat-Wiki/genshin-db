			"completionStepIds": [
				7066401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7066401",
							"2"
						],
						"stepId": 7066401,
						"stateName": "QUEST_STATE_UNFINISHED"
