			},
			"dialogs": [
				{
					"id": 732441701,
					"content": "ละ เลิกตีได้แล้ว...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441702
					],
					"speakerTitle": "เจ้าหน้าที่เจรจาของ Fatui"
				},
				{
					"id": 732441702,
					"content": "หยุดเถอะ ตีต่อไปต้องมีคนตายแน่ ๆ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441703
					],
					"speakerTitle": "เจ้าหน้าที่เจรจาของ Fatui"
				},
				{
					"id": 732441703,
					"content": "เวลาคนโดนตีเป็นฝ่ายพูดแล้วดูน่าเชื่อถือดีแฮะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441704,
					"content": "พูด!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441705,
					"content": "รีบพูดออกมาซะ!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441706
					]
				},
				{
					"id": 732441706,
					"content": "พูดแล้ว ๆ พวกเธออยากรู้อะไร ฉันจะบอกหมดเลย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441707
					],
					"speakerTitle": "เจ้าหน้าที่เจรจาของ Fatui"
				},
				{
					"id": 732441707,
					"content": "ลองบอกมาก่อนสิว่ารู้อะไรบ้าง!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441708,
					"content": "พะ พวกเราก็แค่ทำการซื้อขายแลกเปลี่ยนกับ Aderfi มาตลอดเฉย ๆ... เห็นบอกว่าชเนตตีเผ่า Tanit ลำเอียงรัก Azariq อะไรนั่น... แล้วก็มีเด็กสาวที่มาใหม่...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441709
					],
					"speakerTitle": "เจ้าหน้าที่เจรจาของ Fatui"
				},
				{
					"id": 732441709,
					"content": "หึ ถึงจะไม่รู้ว่าอะไรเป็นอะไรก็เถอะ แต่ดูเหมือนว่า Azariq ก็หายตัวไปแล้วเหมือนกัน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441710
					],
					"speakerTitle": "เจ้าหน้าที่เจรจาของ Fatui"
				},
				{
					"id": 732441710,
					"content": "ผู้หญิงคนนั้นโหดเหี้ยมเลือดเย็น ไม่มีทางเก็บคนที่หมดประโยชน์ในเผ่าไว้แน่... เพราะอย่างนั้น เพื่อที่จะรักษาตำแหน่งของตนไว้ Aderfi จึงคอยติดต่อกับพวกเรา...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441711
					],
					"speakerTitle": "เจ้าหน้าที่เจรจาของ Fatui"
				},
				{
					"id": 732441711,
					"content": "ก่อนหน้านี้ ภารกิจของงานภายในทะเลทรายของพวกเราก็ไม่ราบรื่นเท่าไหร่ จนกระทั่ง เอ่อ กระทั่งได้ร่วมมือกันนี่แหละ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441712,
						732441716
					],
					"speakerTitle": "เจ้าหน้าที่เจรจาของ Fatui"
				},
				{
					"id": 732441712,
					"content": "หมดประโยชน์... หมายความว่าไง?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441713
					]
				},
				{
					"id": 732441713,
					"content": "ฉันไม่รู้... ฉันไม่รู้จริง ๆ! นั่นมันเป็นเรื่องภายในของชาวทะเลทรายพวกนั้น... แต่ถ้าให้ฉันเดาละก็ น่าจะเพราะผู้หญิงคนนั้นคิดว่าพวกเราไม่น่าเชื่อใจล่ะมั้ง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441714
					],
					"speakerTitle": "เจ้าหน้าที่เจรจาของ Fatui"
				},
				{
					"id": 732441714,
					"content": "...เพราะงั้นเจ้าตัวถึงได้เริ่มเว้นระยะจากเรา Aderfi ที่รับหน้าที่ติดต่อกับพวกเราบ่อย ๆ เลยเริ่มรู้สึกกังวล...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441715
					],
					"speakerTitle": "เจ้าหน้าที่เจรจาของ Fatui"
				},
				{
					"id": 732441715,
					"content": "ยังไงซะพวกเราก็ยังออกจากที่บ้า ๆ นี่ได้ ส่วนเขาก็ได้แต่ถูกบีบเค้นผลประโยชน์จนสิ้นแล้ว รอให้ชนเผ่าตัดสินความเป็นอยู่...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441724
					],
					"speakerTitle": "เจ้าหน้าที่เจรจาของ Fatui"
				},
				{
					"id": 732441724,
					"content": "แต่เจ้า Aderfi นี่เป็นคนเจ้าเล่ห์มาก พวกเราให้ของที่เขาต้องการไปไม่น้อยเลย แต่ของที่เราต้องการกลับไม่มีวี่แววอะไรสักอย่าง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441725
					],
					"speakerTitle": "เจ้าหน้าที่เจรจาของ Fatui"
				},
				{
					"id": 732441725,
					"content": "แต่ได้ยินมาว่าเกิดเรื่องขึ้นกับเขา... แม้จะไม่รู้ว่าเรื่องอะไร แต่พวกเราคิดว่า นี่มันเป็นโอกาสที่ดีเลยไม่ใช่หรือไง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441726
					],
					"speakerTitle": "เจ้าหน้าที่เจรจาของ Fatui"
				},
				{
					"id": 732441726,
					"content": "โอกาสที่ดี? โอกาสดีอะไร?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441727,
					"content": "หลังจากนี้พวกเราก็ไม่น่ามีโอกาสได้แลกเปลี่ยนซื้อขายอะไรกับ Aderfi อีก เพราะงั้นก็เลยบอกให้เขาเอา Primal Construct พิเศษอะไรนั่นที่เคยพูดถึงในจดหมายมา...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441728
					],
					"speakerTitle": "เจ้าหน้าที่เจรจาของ Fatui"
				},
				{
					"id": 732441728,
					"content": "ถ้าปล้นแย่งมาได้ ตอนพวกเราล่าถอยในอีกไม่กี่วันให้หลัง ก็คงไม่นับว่ากลับไปมือเปล่าซะทีเดียว...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441729
					],
					"speakerTitle": "เจ้าหน้าที่เจรจาของ Fatui"
				},
				{
					"id": 732441729,
					"content": "อะไรกัน ที่แท้พวกนายก็อยากมาปล้นเหมือนกันเหรอ มิน่าล่ะ นอกจากจะไม่มีสินค้าแล้วยังไม่เห็น \"ตัวเก็บประจุแปลงพลังงาน\" พวกนั้นด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441730
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441730,
					"content": "หา? อยากมาปล้น \"เหมือนกัน\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441731,
						732441732
					],
					"speakerTitle": "เจ้าหน้าที่เจรจาของ Fatui"
				},
				{
					"id": 732441731,
					"content": "ใช่ รีบเอา \"ตัวเก็บประจุแปลงพลังงาน\" ออกมาซะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441733
					]
				},
				{
					"id": 732441733,
					"content": "ฮืม อย่าบอกนะว่า \"ตัวเก็บประจุแปลงพลังงาน\" อะไรนั่น พวกนายก็แค่แต่งขึ้นมากันน่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441734,
					"content": "เปล่านะ \"ตัวเก็บประจุแปลงพลังงาน\" มีอยู่จริง แต่เพราะว่าเป็นวัตถุโบราณเหมือนกัน ถึงจะมีอยู่เยอะมาก แต่ก็ไม่รู้ว่าจะมีอันที่ใช้ได้หรือเปล่า...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441735
					],
					"speakerTitle": "เจ้าหน้าที่เจรจาของ Fatui"
				},
				{
					"id": 732441735,
					"content": "\"ตัวเก็บประจุแปลงพลังงาน\" พวกนั้นอยู่ไหน?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441736
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441736,
					"content": "Paimon ท่าทีไม่เลวเลย",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441737
					]
				},
				{
					"id": 732441737,
					"content": "#ฮี่ฮี่ จริงเหรอ... {NICKNAME} อย่านอกเรื่องเซ่...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441738
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441738,
					"content": "เร็ว รีบบอกแหล่งที่พวกนายซ่อนของไว้ซะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441739
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441739,
					"content": "...อยู่ในที่ปักหลักแถวนี้ นี่เป็นกุญแจของที่นั่น... ฉันบอกสิ่งที่รู้ให้พวกเธอไปหมดแล้ว...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441740,
						732441741
					],
					"speakerTitle": "เจ้าหน้าที่เจรจาของ Fatui"
				},
				{
					"id": 732441740,
					"content": "ไปได้แล้ว!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441742
					]
				},
				{
					"id": 732441742,
					"content": "ได้ ได้ ได้ ฉันจะไปเดี๋ยวนี้แหละ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "เจ้าหน้าที่เจรจาของ Fatui"
				},
				{
					"id": 732441741,
					"content": "อย่าให้พวกเราเจอหน้าอีกนะ!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441742
					]
				},
				{
					"id": 732441732,
					"content": "นับว่าพวกนายโชคดีที่ได้เจอกับฉัน",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441733
					]
				},
				{
					"id": 732441716,
					"content": "พวกนายทำงานอะไรอยู่ในทะเลทราย...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441717
					]
				},
				{
					"id": 732441717,
					"content": "...ความลับ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441718
					],
					"speakerTitle": "เจ้าหน้าที่เจรจาของ Fatui"
