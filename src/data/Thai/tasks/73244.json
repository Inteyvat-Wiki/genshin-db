					"content": "ฮืม...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441521
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441521,
					"content": "เป็นอะไรไป Jeht?",
