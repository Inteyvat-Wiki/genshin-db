			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Harrison"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728090204,
					"content": "ขอบคุณ ขอบคุณ ขอบคุณมาก ๆ เลย นักเดินทาง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090205
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090205,
					"content": "ถ้าไม่ได้รับความช่วยเหลือจากท่าน วันนี้ฉันคงต้องติดอยู่ในนี้แน่นอน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090206,
						728090208
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090206,
					"content": "คุณเป็นคนสร้างค่ายนี้เหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728090207
					]
				},
				{
					"id": 728090207,
					"content": "อืม... จะว่าอย่างนั้นก็ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090210
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090210,
					"content": "พวกคุณก็รู้ดีว่าการทำธุรกิจใน Ritou นั้นไม่ใช่เรื่องง่ายเลย ค่ายนี้... ถือว่าเป็นเคล็ดลับในการทำธุรกิจของฉัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090211
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090211,
					"content": "เมื่อไม่กี่วันก่อน ฉันวาน... ให้เพื่อนของฉันเอาส่วนผสมในการทำเหล้าจาก Mondstadt มาให้ฉัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090212
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090212,
					"content": "ก่อนหน้านี้ไม่นาน เขาได้วานให้เพื่อนของเขาเอาสินค้าทดลองล็อตใหม่จาก \"Dawn Winery\" มา และเพิ่งจัดส่งมาถึงที่นี่เมื่อไม่กี่วันนี้เอง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090213
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090213,
					"content": "แต่เขาไม่ระมัดระวังจนทำให้กล่องได้รับความเสียหาย ฝาขวดส่วนผสมในการทำเหล้าขวดหนึ่งที่บรรจุไว้ในกล่องก็หลวมด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090214
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090214,
					"content": "ฉันจึงจะหมุนฝาออกมาก่อน จากนั้นค่อยใส่เข้าไปใหม่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090215
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090215,
					"content": "แต่ไม่นึกเลยว่า แค่ฉันหมุนฝาออก ฝูง Slime ก็กระโจนเข้ามา มันน่าแปลกใจมากเลย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090216
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090216,
					"content": "ส่วนผสมในการทำเหล้าจาก \"Dawn Winery\" งั้นเหรอ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728090217
					]
				},
				{
					"id": 728090217,
					"content": "ช่างเถอะ ปล่อยเรื่องส่วนผสมในการทำเหล้าไปก่อน ไว้เจ้าหมอนั่นมาคราวหน้า ฉันค่อยคิดบัญชีกับเขาอีกที",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090218
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090218,
					"content": "พวกคุณช่วยฉันเอาไว้ ฉันก็ต้องมอบสินน้ำใจแทนคำขอบคุณสิ... สิ่งของเหล่านี้พวกคุณรับไว้ด้วยเถอะนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090219
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090219,
					"content": "นอกจากของพวกนี้แล้ว พวกคุณเห็นเรือเล็กที่จอดไว้ข้าง ๆ นั่นมั้ย? นั่นคือ... เคล็ดลับอีกข้อนึงของฉัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090220
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090220,
					"content": "พวกคุณสามารถใช้เรือลำนั้นแอบเดินทางไปที่เกาะ Narukami ได้ฮ่าฮ่า สะดวกสุด ๆ ไปเลยใช่ไหมล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090221
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090221,
					"content": "ทำไมฉันต้องไป \"อย่างเงียบ ๆ\" ด้วยล่ะ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728090222
					]
				},
				{
					"id": 728090222,
					"content": "อืม... เอาเป็นว่า... เตรียมไว้ก่อน เผื่อจะได้ใช้ในภายหลังไงล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090223
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090223,
					"content": "เอาล่ะ ฉันต้องกลับไปตรวจนับสินค้าแล้ว ขอตัวก่อน ขอบคุณอีกครั้งนะ นักเดินทาง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090224
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090224,
					"content": "ดูเหมือนว่าฉันต้องเปลี่ยนสถานที่รับสินค้าอีกแล้ว...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090208,
					"content": "คุณกำลังทำอะไรอยู่เหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728090209
					]
				},
				{
					"id": 728090209,
					"content": "ฉัน... กำลังขนย้ายสินค้าน่ะ ฮ่าฮ่าฮ่า ขนย้ายสินค้า...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090210
					],
					"speakerTitle": "Harrison"
				}
			]
		}
	]
}