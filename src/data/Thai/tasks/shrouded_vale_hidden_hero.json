							2187.956
						],
						"pointId": 7885
					}
				]
			},
			"dialogs": [
				{
					"id": 711090601,
					"content": "เอ๋? เหมือนบนดาบเล่มนี้จะเขียนอะไรบางอย่างไว้? ขอฉันดูหน่อย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090602,
					"content": "\"...ลูบดาบร่ายกวี กลับมาเลือดมังกรติดตัว แสงเทพดั่งอัสนี คลื่นหนาวถล่มภูผา...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090603
					],
					"speakerTitle": "คำจารึกนักดาบโบราณ"
				},
				{
					"id": 711090603,
					"content": "\"...ปราบพยัคฆ์ครองปฐพี แทงมังกรเหาะเหินกลางทะเลเมฆ สะบัดปลายอาภรณ์หลังบรรลุหมาย สงบดุจควันวารีชั่วนิรันดร์...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090604
					],
					"speakerTitle": "คำจารึกนักดาบโบราณ"
				},
				{
					"id": 711090604,
					"content": "เหมือนข้าง ๆ ยังมีศิลาจารึกอยู่อีกอัน... เอ๊ะ ลายมือที่อยู่ข้างล่างเหมือนจะต่างกันนะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090605,
					"content": "\"...ตอนแรกตั้งใจจะทิ้งอาหารเมนูปลาและแกะไว้ที่นี่ แต่ผ่านไปนานเข้าอาหารก็เน่าเสียซะแล้ว เลยทิ้งสูตรไว้ที่นี่ละกัน เวลาหิวก็ปรุงกินได้เลย รสเลิศเกินบรรยาย\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090606
					],
					"speakerTitle": "ตราจารึกโบราณ"
				},
				{
					"id": 711090606,
					"content": "\"...นอกจากดาบเล่มนี้และทิวทัศน์แห่งนี้แล้ว ก็ไม่มีสิ่งอื่นใดอีกเลย\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090607
					],
					"speakerTitle": "ตราจารึกโบราณ"
				},
				{
					"id": 711090607,
					"content": "\"...เมื่อเดินมาถึงทางตัน ควรทำอย่างไร? แล้วคุณจะรู้เอง\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090608
					],
					"speakerTitle": "ตราจารึกโบราณ"
				},
				{
					"id": 711090608,
					"content": "\"...ไม่เอา... สมบัติ เหลือเพียงสิ่งเดียว... นับต่อจากนี้...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090609
					],
					"speakerTitle": "จารึกที่บิดเบี้ยว"
				},
				{
					"id": 711090609,
					"content": "\"ให้ความตาย... เป็นสักขีพยาน...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090610
					],
					"speakerTitle": "จารึกที่บิดเบี้ยว"
				},
				{
					"id": 711090610,
					"content": "ว้า... ตัวอักษรบรรทัดข้างล่างพวกนี้บิด ๆ เบี้ยว ๆ อ่านไม่ออกเลยว่าเขียนว่าอะไร!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090611,
						711090612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090611,
					"content": "ความหมายคร่าว ๆ น่าจะหมายถึงว่า เขายังไม่ได้เอาอะไรไปเลยมั้ง",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090613
					]
				},
				{
					"id": 711090613,
					"content": "ฮืออออ สุดท้ายก็ไม่เจอสมบัติที่มีค่าอะไรเลย มาเสียเที่ยวซะงั้น...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090614,
						711090615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090614,
					"content": "นั่นสิ!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090617
					]
				},
				{
					"id": 711090617,
					"content": "แต่ไม่คิดเลยว่าจะได้เห็นทิวทัศน์แบบนี้ในสถานการณ์ที่หมดหนทางแบบนี้... อย่างน้อยก็นับว่าคุ้มค่าแล้วแหละมั้ง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090615,
					"content": "ไม่เป็นไรนะ เดี๋ยวฉันทำอาหารให้กิน",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090616
					]
				},
				{
					"id": 711090616,
					"content": "#เอ๋?! จริงเหรอ! {NICKNAME} สัญญาแล้วนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090612,
					"content": "ฉันก็ไม่เข้าใจ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090613
					]
				}
			]
		},
