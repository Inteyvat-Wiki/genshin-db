						],
						"stepId": 7514914,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"บริวารมังกรแดนลับ",
					"\"Amaru\""
				],
				"points": [
					{
						"sceneId": 101,
						"position": [
							231.523,
							204.46,
							-155.273
						],
						"pointId": 53
					},
					{
						"sceneId": 101,
						"position": [
							230.904,
							204.46,
							-152.31
						],
						"pointId": 910101009
					}
				]
			},
			"dialogs": [
				{
					"id": 751491101,
					"content": "หงิง... กี้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491102
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751491102,
					"content": "มีอะไรเหรอ? แกดูไม่ค่อยดีเลยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751491103,
					"content": "หงิง!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491104
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751491104,
					"content": "หรือว่านั่นคือ... Abyss?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751491105,
					"content": "\"ใช่แล้วล่ะ... มอนสเตอร์จาก Abyss กำลังบุกเข้ามาในเมืองศักดิ์สิทธิ์ Tollan ราวกับโรคร้าย\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491106
					],
					"speakerTitle": "บริวารมังกรแดนลับ"
				},
				{
					"id": 751491106,
					"content": "\"ในเมื่อมาถึงขั้นนี้แล้ว บางทีอาจจขับไล่พวกมันไม่ได้แล้ว และอาจจะต้องทำลายภูเขาศักดิ์สิทธิ์ Tollan ทั้งเขา เพื่อหยุดการเคลื่อนไหวของพวกมัน...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491107
					],
					"speakerTitle": "บริวารมังกรแดนลับ"
				},
				{
					"id": 751491107,
					"content": "เวลาที่เธอเจอมอนสเตอร์ Abyss ตัวนึง...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751491108
					]
				},
				{
					"id": 751491108,
					"content": "\"บางทีบ้านของเจ้าอาจเต็มไปด้วยศัตรูที่มืดมิด และเหนียวหนืดพวกนี้อยู่แล้วก็ได้...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491109
					],
					"speakerTitle": "บริวารมังกรแดนลับ"
				},
				{
					"id": 751491109,
					"content": "หงิง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491110
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751491110,
					"content": "เหวอ พวกเธอพูดอะไรน่ากลัวแบบนี้เนี่ย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751491111,
					"content": "ถ้าตัดขาของพวกมัน ก็จะหยุดพวกมันได้แล้ว!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751491112
					]
				},
				{
					"id": 751491112,
					"content": "ช่วยให้ใจชื้นจังเลยนะ ที่เหลือก็แค่ต้องหาดูว่าขาพวกมันอยู่ตรงไหน... คิดว่าฉันจะพูดแบบนี้รึไง!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751491113,
					"content": "กี้?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491114
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751491114,
					"content": "\"ฮ่าฮ่า น่าเสียดายนะ เจ้าตัวเล็ก บางทีมอนสเตอร์ Abyss ก็ไม่ได้ใช้ขาในการขยับตัวหรอกนะ\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491115
					],
					"speakerTitle": "บริวารมังกรแดนลับ"
				},
				{
					"id": 751491115,
					"content": "\"...มีเพียงการกำจัดศัตรูในเงามืดที่ขวางทางอยู่เท่านั้น ที่จะทำให้พวกเจ้าผ่านที่นี่ เพื่อไปยังหัวใจแห่งภูเขาศักดิ์สิทธิ์ได้\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491116
					],
					"speakerTitle": "บริวารมังกรแดนลับ"
				},
				{
					"id": 751491116,
					"content": "\"แม้ว่าเมืองที่พังทลายแห่งนี้ จะฟื้นฟูกลับมาเป็นเหมือนเดิมไม่ได้แล้ว แต่อย่างน้อยก็ไม่ควรปล่อยให้ซากปรักหักพังของมัน ต้องตกอยู่ในมือของมอนสเตอร์แห่งความมืด\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491117
					],
					"speakerTitle": "บริวารมังกรแดนลับ"
				},
				{
					"id": 751491117,
					"content": "เดี๋ยวนะ มีลูกไฟยักษ์อยู่ไม่ใช่เหรอ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751491118
					]
				},
				{
					"id": 751491118,
					"content": "จริงด้วย ลูกไฟยักษ์ใช้สำหรับต่อกรกับ Abyss ไม่ใช่รึไง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751491119,
					"content": "\"ลูกไฟยักษ์... เจ้าหมายถึง 'กระจุกดาวจำลอง' งั้นเหรอ มันจะมีประโยชน์ก็ต่อเมื่อ ถูกทำลายล้างไปพร้อมกับอีกฝ่ายขณะเข้าใกล้ Abyss เท่านั้น ไม่อย่างนั้นมันจะถูก Abyss กัดกร่อนและห่อหุ้มไป...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491120
					],
					"speakerTitle": "บริวารมังกรแดนลับ"
				},
				{
					"id": 751491120,
					"content": "\"น่าเสียดายที่เมืองนี้ถูกปิดผนึกมานานเกินไป... และเพื่อรักษาความเสถียรของ 'กระจุกดาวจำลอง' เลยเคลื่อนย้ายตามใจชอบไม่ได้...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491121
					],
					"speakerTitle": "บริวารมังกรแดนลับ"
				},
				{
					"id": 751491121,
					"content": "\"ผู้ถูกเลือกโดยมังกรเอ๋ย...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491122
					],
					"speakerTitle": "บริวารมังกรแดนลับ"
				},
				{
					"id": 751491122,
					"content": "กี้?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491123
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751491123,
					"content": "\"หัวใจแห่งภูเขาศักดิ์สิทธิ์ เป็นพื้นที่ที่ถูกขุดขึ้นมาอีกครั้งหลังจากที่ Tollan ก่อตั้งขึ้น... ซึ่งมีรูปปั้นมังกรแดนลับคอยปกป้องอยู่\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491124
					],
					"speakerTitle": "บริวารมังกรแดนลับ"
				},
				{
					"id": 751491124,
					"content": "\"ถ้าอยากเข้าไปในหัวใจแห่งภูเขาศักดิ์สิทธิ์ ก็ต้องได้รับใบอนุญาตก่อน...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491125
					],
					"speakerTitle": "บริวารมังกรแดนลับ"
				},
				{
					"id": 751491125,
					"content": "\"แต่พลังงานของรูปปั้นมังกรแดนลับตัวนั้นก็ถูกกัดกร่อนเช่นกัน เลยต้องหาวิธีเปิดใช้งานมันอีกครั้ง...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491126
					],
					"speakerTitle": "บริวารมังกรแดนลับ"
				},
				{
					"id": 751491126,
					"content": "\"พวกมัน...\" คำเตือน การทำงานถูกรบกวน กำลังปิด... \"อ่า ดูเหมือนว่าเจ้าเครื่องนี้...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491127
					],
					"speakerTitle": "บริวารมังกรแดนลับ"
				},
				{
					"id": 751491127,
					"content": "อ้าว Amaru ใบอนุญาตอะไรเหรอ เอ๋ เธอยังไม่ได้พูดอะไรเลยนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751491128,
					"content": "\"ฮ่าฮ่า... เดินหน้าต่อไปเถอะ ที่นั่นจะมีบริวารมังกรแดนลับตัวใหม่ ที่คอยชี้ทางให้พวกเจ้าอยู่...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491129
					],
					"speakerTitle": "บริวารมังกรแดนลับ"
				},
				{
					"id": 751491129,
					"content": "แกร๊กก...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491130
					],
					"speakerTitle": "บริวารมังกรแดนลับ"
				},
				{
					"id": 751491130,
					"content": "\"นี่คือแผนที่ของใจกลางเมืองศักดิ์สิทธิ์ ข้าจะรอ... เพื่อพวกเจ้า...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491131
					],
					"speakerTitle": "บริวารมังกรแดนลับ"
				},
				{
					"id": 751491131,
					"content": "อ๊ะ แสงบนร่างกายหายไปอีกแล้ว...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751491132,
					"content": "แบบนี้เจ้า \"Amaru\" ก็คงสื่อสารไม่ได้แล้วสิ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751491133,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491134
					],
					"speakerTitle": "บริวารมังกรแดนลับ"
				},
				{
					"id": 751491134,
					"content": "เจ้านี่ชอบทำอะไรตามใจชอบจริง ๆ ช่วยไม่ได้ พวกเรามุ่งหน้าไปหาบริวารมังกรแดนลับตัวใหม่กันเถอะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}