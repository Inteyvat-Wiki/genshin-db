				"points": []
			},
			"dialogs": [
				{
					"id": 730580201,
					"content": "เป็นไงบ้าง เจออะไรบ้างมั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580202
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580202,
					"content": "เอ่อ... เจอแต่พวกคำสั่งที่คลุมเครือ และก็นี่! ดอกไม้แห้งดอกนึงน่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730580203,
					"content": "เอ๋...! อันนี้ ให้ฉันได้มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580204
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580204,
					"content": "นี่มันเป็นของที่พวกคนไม่ดีทิ้งไว้ เธอไม่กลัวว่ามันจะมีพิษ... อะไรแบบนั้นอยู่เหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730580205,
					"content": "ไม่ต้องเป็นห่วง ฉันเคยเห็นดอกไม้นี่มาก่อน... คนคนนั้น ฉันน่าจะเคยเจอมาก่อน... ให้ฉันได้มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580206
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580206,
					"content": "รับไปสิ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730580207
					]
				},
				{
					"id": 730580207,
					"content": "#ขอบคุณนะ! Nara {NICKNAME} และเจ้าตัวขาวบินได้!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580208
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580208,
					"content": "Aragaru นำดอกไม้แห้งดอกน้อย ๆ ไปที่ป่า Mawtiyima...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
