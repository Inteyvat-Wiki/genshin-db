			"dialogs": [
				{
					"id": 730580401,
					"content": "ลองไปดูที่ค่ายของ Nara ที่ชั่วร้ายกันเถอะ! ต้องได้รู้แน่นอนว่าพวกเขามาที่นี่เพื่ออะไรกันแน่!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580402
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580402,
					"content": "เธอแยกแยะคนชั่วร้ายจากอะไร?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730580403
					]
				},
				{
					"id": 730580403,
					"content": "#เอ่อ... ไม่รู้สิ อธิบายไม่ถูก! แต่ฉันรู้ว่า Nara {NICKNAME} กับเจ้าตัวขาวบินได้ไม่ใช่คนชั่วร้ายแน่นอน! Aragaru เชื่อแบบนั้น!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aragaru"
				}
			]
		},
