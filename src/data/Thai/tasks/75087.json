					"nextDialogs": [
						750870520
					]
				},
				{
					"id": 750870520,
					"content": "หงิง... กี้!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870521
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870521,
					"content": "#ดูเหมือน {REALNAME[ID(2)|SHOWHOST(true)]} จะคิดว่ากลยุทธ์การป้องกันนั้นล้าหลังไปหน่อย และจะเป็นการเสียโอกาสที่ดีไปเปล่า ๆ มันก็เลยตั้งท่าโจมตี!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870530
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870522,
					"content": "ไอเทม",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870523
					]
				},
				{
					"id": 750870523,
					"content": "พวกเรามีไอเทมที่ใช้งานตอนนี้ได้ที่ไหนล่ะ! ต่อให้อยากวางกับดักล่าสัตว์ มันก็ช้าไปแล้วมั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870524
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870524,
					"content": "หงิง... กี้!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870525
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870525,
					"content": "#โอ้! {REALNAME[ID(2)|SHOWHOST(true)]} ตั้งท่าโจมตีแล้ว!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870530
					],
