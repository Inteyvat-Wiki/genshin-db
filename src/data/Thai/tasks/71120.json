			"dialogs": [
				{
					"id": 711209101,
					"content": "ทำไมเป็นพวกเธออีกแล้วเนี่ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209102
					],
					"speakerTitle": "เสือหมอบ"
				},
				{
					"id": 711209102,
					"content": "เพื่อนเอ๋ย อย่าอยากรู้อยากเห็นให้มากนักเลย พวกเธอทำเป็นไม่เห็นพวกเรา พวกเราก็จะทำเป็นไม่เห็นพวกเธอด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209103,
						711209111
					],
					"speakerTitle": "นาคาขนด"
				},
				{
					"id": 711209103,
					"content": "พวกเธอเฝ้าอะไรอยู่เหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711209104
					]
				},
				{
					"id": 711209104,
					"content": "เพื่อนเอ๋ย เธอลองทายดูสิว่าเรารับเงินเดือนเพื่ออะไร?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209105
					],
					"speakerTitle": "นาคาขนด"
				},
				{
					"id": 711209105,
					"content": "เพื่ออะไรล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711209106,
					"content": "อะแฮ่ม...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209107
					],
					"speakerTitle": "นาคาขนด"
				},
				{
					"id": 711209107,
					"content": "(ฉันบอกแค่พวกเธอสองคน อย่าบอกคนอื่นเด็ดขาดนะ... มา ๆ ฉันจะบอกให้...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209108
					],
					"speakerTitle": "นาคาขนด"
				},
				{
					"id": 711209108,
					"content": "(อืมอืม! ฉันฟังอยู่!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711209109,
					"content": "เพื่อให้คนที่ไม่เกี่ยวข้องอย่างพวกเธอไสหัวไปให้พ้นไง!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209110
					],
					"speakerTitle": "นาคาขนด"
				},
				{
					"id": 711209110,
					"content": "หว๋าาา!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711209111,
					"content": "มีเสียงแปลก ๆ ในถ้ำ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711209112
					]
				},
				{
					"id": 711209112,
					"content": "ฉันตดเองแหละ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209113
					],
					"speakerTitle": "เสือหมอบ"
				},
				{
					"id": 711209113,
					"content": "เอ่อ... ใช่ เขาตด",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209114
					],
					"speakerTitle": "นาคาขนด"
				},
				{
