			"dialogs": [
				{
					"id": 730750101,
					"content": "#ขอบคุณ Nara {NICKNAME} กับ Paimon มากนะ ตอนนี้มี Viparyas โตเต็มสวน Vanarana เลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730750102
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730750102,
					"content": "Viparyas ของที่นี่มีความสุขกันมาก Arakara ก็เลยมีความสุขไปด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730750103
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730750103,
					"content": "เทศกาลไร้อาวรณ์สิ้นสุดลงแล้ว ก่อนที่ Nara สีทองจะไปจาก Vana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730750104
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730750104,
					"content": "ได้รับ Viparyas มาต้นนึง",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730750105
					]
				},
				{
					"id": 730750105,
					"content": "#Viparyas ที่มีความสุข มอบให้ Nara สีทอง... หวังว่า Nara {NICKNAME} กับ Paimon จะมีความสุขไปด้วยนะ ถึง Viparyas ต้นนี้จะไม่เหี่ยวเฉา แต่...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730750106
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730750106,
					"content": "ต้องคอยพูดคุยกับมันบ้างนะ ทางที่ดีที่สุดก็เล่นดนตรีให้มันฟัง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730750107
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730750107,
					"content": "#พื้นดินกับ Aranara จะไม่มีวันลืม หวังว่า Nara {NICKNAME} กับ Paimon เองก็จะไม่ลืมนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakula"
				}
			]
		},
