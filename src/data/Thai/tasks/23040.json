					"Najat"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230400201,
					"content": "เฮ้อ... แร้งสีชาดพวกนี้ ไม่รู้จักจบจักสิ้นจริง ๆ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400202
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400202,
					"content": "เกิดอะไรขึ้นเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400203
					]
				},
				{
					"id": 230400203,
					"content": "เธอคือ... นักเดินทางใช่มั้ย! ฉันเคยได้ยิน Ebeid พูดถึงเธออยู่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400204
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400204,
					"content": "ฮึฮึ นึกไม่ถึงจริง ๆ ว่าจะมีนักเดินทางมาเยือนหมู่บ้านของเรา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400205
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400205,
					"content": "อ้อ เธอได้เจอกับ Habachi หรือยัง? เขาเป็นคนเคร่งขรึมตลอดเลย... ถ้าเขาพูดกับเธอด้วยท่าทีไม่ค่อยดี เธอก็อย่าถือสาเขาเลยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400206
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400206,
					"content": "เพราะว่า... ทรัพยากรมากมายของหมู่บ้านเราถูกเก็บไว้ในโกดังนี้ทั้งหมด ไม่ว่าจะเป็นเสบียงอาหาร เสื้อผ้า อาวุธ รวมทั้งทรัพย์สินส่วนหนึ่งด้วย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400207
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400207,
					"content": "ในหมู่บ้านมีคนหนุ่มอยู่แค่นั้น ทั้งต้องปกป้องหมู่บ้าน และต้องช่วยคนในหมู่บ้านจัดการเรื่องต่าง ๆ อีก... มีแต่ Habachi คนเดียวที่คอยเฝ้าโกดังอยู่ตลอด",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400208
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400208,
					"content": "นอกจากช่วยจดบัญชีและตรวจนับสิ่งของแล้ว ก็ช่วยอะไรไม่ได้มากหรอก...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400209
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400209,
					"content": "แร้งสีชาดที่คุณพูดถึงเมื่อกี้นี้...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400210
					]
				},
				{
					"id": 230400210,
					"content": "เห้อ อย่าให้พูดเลย ก่อนหน้านี้มีเนื้อแห้งล็อตหนึ่งถูกเก็บเข้าไปในโกดัง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400211
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400211,
					"content": "ไม่รู้ว่ากลิ่นรั่วไหลออกไปทางไหน ทุก ๆ สองสามวันก็จะมีแร้งสีชาดหลายตัวบินมาหยุดอยู่บนเขาที่อยู่ข้างโกดัง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400212
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400212,
					"content": "พวกมันจิกเอาเนื้อแห้งในโกดังไปไม่ได้ แต่ถ้ามีคนกินข้าวต่อหน้าพวกมันแร้งสีชาด พวกนี้ก็จะบินลงมาโจมตีทันที",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400213
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400213,
					"content": "ทหารรักษาการณ์ในหมู่บ้านไม่ว่างไปจัดการพวกมัน คุณ Habachi ก็ปลีกตัวไปไม่ได้ด้วย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400214
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400214,
					"content": "นักเดินทาง ถ้าเธอมีเวลาว่าง ช่วยไปจัดการแร้งสีชาดพวกนั้นให้เราหน่อยได้มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400215,
						230400217
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400215,
					"content": "ให้ฉันจัดการเอง",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400216
					]
				},
				{
					"id": 230400216,
					"content": "งั้นก็ต้องรบกวนเธอแล้วล่ะ แร้งสีชาดพวกนั้นดุร้ายมาก ทางที่ดีก็อย่าเข้าไปใกล้มาก... ถ้าเธอใช้ธนูเป็นก็น่าจะจัดการพวกมันได้อย่างปลอดภัย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400217,
					"content": "พวกมันเคยโจมตีอะไรบ้าง?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400218
					]
				},
				{
					"id": 230400218,
					"content": "สินค้าที่ขนผ่านมาทางนี้ เนื้อแห้งที่ตากเอาไว้ และกล่องข้าวของคุณ Habachi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400219
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400219,
					"content": "เวลาที่คุณ Habachi ทานข้าวระหว่างอยู่เวร เขามักจะเอากับข้าวไว้ข้าง ๆ เสมอ แร้งสีชาดพวกนั้นจะถือจังหวะนี้บินลงมาโฉบเอาเนื้อไป",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400220
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400220,
					"content": "เพราะว่ายังต้องอยู่เวรต่อ คุณ Habachi จึงไปสั่งสอนแร้งสีชาดไม่ได้ ได้แต่มองดูพวกมันบินหนีไป แล้วรีบกินข้าวที่เหลือให้หมด...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400221
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400221,
					"content": "รบกวนด้วยนะ นักเดินทาง รีบจัดการแร้งสีชาดพวกนั้นเถอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Najat"
				}
			]
		},
