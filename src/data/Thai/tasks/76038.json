			"dialogs": [
				{
					"id": 760380101,
					"content": "(บางที <color=#FFCC33FF>Nefer</color> อาจจะสนใจขนมน้ำตาลปั้นก็ได้นะ...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760380102
					]
				},
				{
					"id": 760380102,
					"content": "ขอน้ำตาลปั้นให้ฉันอันนึงสิ Hunajatta",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380103
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 760380103,
					"content": "คุณ Nefer ทำไมคุณถึงมีเวลามาซื้อน้ำตาลปั้นด้วยล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380104
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380104,
					"content": "การออกมาเดินเล่นบ้าง มันดีต่อร่างกายและจิตใจของฉันน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380105
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 760380105,
					"content": "การได้กินของหวาน ก็ช่วยให้ฉันหัวแล่นเวลาคิดเหมือนกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380106
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 760380106,
					"content": "ได้เลย~ รอสักครู่นะ ฉันจะทำให้คุณเดี๋ยวนี้แหละ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380107
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380107,
					"content": "ได้ จริงสิ รับเงินพวกนี้ไปสิ ครั้งหน้าถ้า Jahoda มา...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380108
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 760380108,
					"content": "ทำอันใหญ่กว่านี้ให้เธอเหรอ? หรือว่าเอาหวานกว่านี้?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380109
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380109,
					"content": "เอาเงินพวกนี้ให้เธอ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380110
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 760380110,
					"content": "และบอกเธอว่า \"Nefer จะจ่ายเงินให้เป็นสองเท่า ถ้าคุณแอบอู้เสร็จแล้ว ก็ช่วยเอาน้ำตาลปั้นกลับไปให้เธอด้วย\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nefer"
				}
			]
		},
