			"dialogs": [
				{
					"id": 745280401,
					"content": "เธอนี่เอง การเดินทางทำให้เราได้มาพบกันอีกครั้งแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280402,
						745280403
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 745280402,
					"content": "Skirk ไม่ได้เจอกันนานเลยนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745280404
					]
				},
				{
					"id": 745280404,
					"content": "ฉันกำลังสังเกตดู \"บาดแผล\" บนโลกใบนี้ การระเบิดครั้งนั้น ทำให้ที่นี่กลายเป็นซากปรักหักพัง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280405
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 745280405,
					"content": "แต่ตอนนี้ ผู้คนได้สร้างสิ่งใหม่ขึ้นมา บนซากปรักหักพังเหล่านี้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280406
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 745280406,
					"content": "สรรพสิ่งล้วนมีจุดสิ้นสุด แต่หลังจากการเสื่อมสลาย ก็จะก่อเกิดความเป็นไปได้ใหม่ ๆ ขึ้นมา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280407
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 745280407,
					"content": "พลังของเธอเติบโตขึ้น มากกว่าตอนที่เราพบกันครั้งก่อนอีกนะ ดูเหมือนเธอจะไม่ได้ละเลยการฝึกเลยนะเนี่ย ดีมาก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280408,
						745280409
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 745280408,
					"content": "ที่จริง ฉันมีเรื่องอยากจะขอร้องหน่อยน่ะ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745280410
					]
				},
				{
					"id": 745280410,
					"content": "ถ่ายรูปงั้นเหรอ? สำหรับโลกใบนี้แล้ว ฉันเป็นแค่ผู้มาเยือนชั่วคราว แล้วจะทิ้งร่องรอยไว้ทำไมกันล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280411,
						745280412
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 745280411,
					"content": "แต่สำหรับฉัน คุณไม่ใช่แค่คนที่ผ่านมาเท่านั้นนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745280413
					]
				},
				{
					"id": 745280413,
					"content": "...ในเมื่อเป็นสิ่งที่เธออยากทำ งั้นก็ทำเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280414
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 745280414,
					"content": "ฉันอยู่ตรงนี้แหละ จะเริ่มเมื่อไหร่ก็ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Skirk"
				},
				{
					"id": 745280412,
					"content": "ทุกครั้งที่พบกันใหม่มีค่าให้จดจำเสมอนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745280413
					]
				},
				{
					"id": 745280409,
					"content": "ฉันอยากถ่ายรูปให้คุณน่ะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745280410
					]
				},
				{
					"id": 745280403,
					"content": "คุณมาทำอะไรอยู่ที่นี่เหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745280404
					]
				}
			]
		}
	]
