					"Minglan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715410101,
					"content": "คนที่รับผิดชอบคงไม่ใช่ครูฝึกคนนั้นจริง ๆ หรอกนะ... เฮ้อ คงได้แต่อวยพรให้พวกเขาโชคดีแล้วล่ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410102
					],
					"speakerTitle": "Minglan"
				},
				{
					"id": 715410102,
					"content": "เป็นอะไรเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715410103
					]
				},
				{
					"id": 715410103,
					"content": "#หา?! คะ...คุณเองเหรอ {NICKNAME} เฮ้อ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410104
					],
					"speakerTitle": "Minglan"
				},
				{
					"id": 715410104,
					"content": "ตกใจหมดเลย นึกว่าครูฝึกมาซะอีก ถ้าเกิดเขามาได้ยินเข้าละก็ ฉันคงถูกโยนไปฝึกอีกแน่ ๆ เลย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410105,
						715410106
					],
					"speakerTitle": "Minglan"
				},
				{
					"id": 715410105,
					"content": "พวกคุณ... ฝึกซ้อมกันอยู่เหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715410107
					]
				},
				{
					"id": 715410107,
					"content": "เฮ้อ เทศกาลยิ่งใหญ่เท่าไหร่ เราก็ยิ่งยุ่งนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410108
					],
					"speakerTitle": "Minglan"
				},
				{
					"id": 715410108,
					"content": "ท่าเรือ Liyue ใหญ่โตขนาดนี้ แขกที่มาจากทั่วทุกทิศทุกทางก็ต้องมากมายสิ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410109
					],
					"speakerTitle": "Minglan"
				},
				{
					"id": 715410109,
					"content": "เพื่อรักษาความสงบเรียบร้อย และปกป้องความปลอดภัยของทุกคน กองทหาร Millelith ได้จัดหน่วยลาดตระเวนไว้มากมาย ทั้งในเมืองและนอกเมือง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410110
					],
					"speakerTitle": "Minglan"
				},
				{
					"id": 715410110,
					"content": "คุณรู้จักหน่วยลาดตระเวนมั้ย? อืม... คุณก็เข้าใจง่าย ๆ ว่า เป็นกองทหาร Millelith ที่ไม่ว่าจะไปที่ไหน ก็จะคอยให้ความช่วยเหลือที่นั่นก็พอ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410111
					],
					"speakerTitle": "Minglan"
				},
				{
					"id": 715410111,
					"content": "ถ้าที่มีคนต้องการความช่วยเหลือ แค่คุณพุ่งเข้าไปขอความช่วยเหลือจากคนกลุ่มนั้น พวกเขาก็จะช่วยคุณเองแหละ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410112
					],
					"speakerTitle": "Minglan"
				},
				{
					"id": 715410112,
					"content": "ไม่ว่าจะเจอภัยอันตราย ทำของหาย หรือแม้กระทั่งหลงทาง ก็สามารถไปขอความช่วยเหลือได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410113
					],
					"speakerTitle": "Minglan"
				},
				{
					"id": 715410113,
					"content": "แต่ว่า... เพราะว่าต้องครอบคลุมพื้นที่ที่กว้างมาก เลยทำให้ครูฝึกยกทีมสำรอง ที่เดิมทีมีไว้เป็นกำลังสำรองออกมาฝึกด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410114
					],
					"speakerTitle": "Minglan"
				},
				{
					"id": 715410114,
					"content": "แต่ทีมสำรองพวกนั้นล้วนเป็นทหารใหม่ และไม่ค่อยได้รับการฝึกฝนเท่าไหร่ ครูฝึกเลยบอกว่าจะจัดงานฝึกซ้อมศิลปะต่อสู้ขึ้นมาชั่วคราว เพื่อพัฒนาความสามารถของพวกเขา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410115
					],
					"speakerTitle": "Minglan"
				},
				{
					"id": 715410115,
					"content": "ฉันได้ยินมาว่า... ครูฝึกคนนั้นโหดมาก ใครที่ได้รับการฝึกจากเขา แค่ได้ยินชื่อของเขา ก็ต้องอกสั่นขวัญแขวนไปตาม ๆ กันแล้ว...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410116
					],
					"speakerTitle": "Minglan"
				},
				{
					"id": 715410116,
					"content": "คุณ... ก็เคยผ่านมาแล้วเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715410117
					]
				},
				{
					"id": 715410117,
					"content": "กะ...ก็ถือว่าใช่แหละ การฝึกฝนของครูฝึกคนนั้นมีประสิทธิภาพมาก แต่พอกลับมาคิดถึง... ก็รู้สึกขาอ่อนอยู่เหมือนกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410118
					],
					"speakerTitle": "Minglan"
				},
				{
					"id": 715410118,
					"content": "คุณอยากลองดูมั้ย? ตอนที่ฉันฝึกซ้อม ได้ยินครูฝึกพูดถึงชื่อของคุณบ่อย ๆ เขาบอกว่าคุณไม่ได้เก่งแค่การต่อสู้เป็นทีมเท่านั้น แต่ยังเป็นเลิศในการต่อสู้ด้วยมือเปล่าอีกด้วย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410119
					],
					"speakerTitle": "Minglan"
				},
				{
					"id": 715410119,
					"content": "ถ้าคุณได้ฝึกศิลปะการต่อสู้ในสนามละก็ คะแนนต้องดีกว่าพวกเราแน่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410120,
						715410122
					],
					"speakerTitle": "Minglan"
				},
				{
					"id": 715410120,
					"content": "ฉันอยากลองเล่น!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715410121
					]
				},
				{
					"id": 715410121,
					"content": "ได้ ความกล้าหาญนี้... สมแล้วที่เป็นฮีโร่ของ Liyue งั้นเชิญตามฉันมาเถอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Minglan"
				},
				{
					"id": 715410122,
					"content": "ขอคิดอีกทีนะ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715410123
					]
				},
				{
					"id": 715410123,
					"content": "ไม่เป็นไร ถ้าคุณอยากลองเข้าร่วม ก็บอกฉันได้เลยนะ แต่ถ้าคุณเข้าร่วมการฝึกซ้อมศิลปะการต่อสู้ละก็ ฉันรับรองว่าครูฝึกต้องดีใจมากแน่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Minglan"
				},
				{
					"id": 715410106,
					"content": "ตอนนี้เป็นช่วงเทศกาล Lantern Rite ไม่ใช่เหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715410107
					]
				}
			]
		}
	]
}