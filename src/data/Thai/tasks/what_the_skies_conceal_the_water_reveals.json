				},
				{
					"id": 411130743,
					"content": "ทะ ทำไมจู่ ๆ ถึงพูดอะไรแบบนี้ล่ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130746
