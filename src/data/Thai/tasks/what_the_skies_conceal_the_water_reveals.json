					"Jinglun"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411130201,
					"content": "สวัสดี พวกเรามาจากกิลด์นักผจญภัย ขอถามหน่อยสิว่าหมู่บ้าน Qingce Village ได้รับผลกระทบจากอุกกาบาตบ้างรึเปล่า?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130202,
					"content": "นักผจญภัยเองเหรอ! เยี่ยมเลย กำลังกลุ้มเพราะขาดคนอยู่พอดี!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130203
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411130203,
					"content": "หลายวันมานี้ อยู่ดี ๆ ก็มีอุกกาบาตตกลงมาจากฟ้า อย่าให้บอกเลยว่าวุ่นวายแค่ไหน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130204
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411130204,
					"content": "ทั้งตกลงไป<color=#00E1FFFF>ในไร่นา</color>จนไม่มีใครกล้าไปเก็บเกี่ยวผลผลิต และยังมีที่ตกลงมาที่<color=#00E1FFFF>หน้าประตู</color> จนเป็นปัญหาสำหรับการเข้าออก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130205
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411130205,
					"content": "พวกเธอมีวิธีกำจัดอุกกาบาตพวกนี้มั้ย? มันเกะกะมาก ๆ เลย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130206
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411130206,
					"content": "ดูท่าทางหมู่บ้าน Qingce Village ก็เจอปัญหาเหมือนกัน",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411130207
					]
				},
				{
					"id": 411130207,
					"content": "ช่วยไม่ได้ ถึงเวลาพวกเราลงมือแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
