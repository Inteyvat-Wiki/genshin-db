				"points": []
			},
			"dialogs": [
				{
					"id": 200620101,
					"content": "ทำไงดีนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620102
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620102,
					"content": "ทำไมเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620103
					]
				},
				{
					"id": 200620103,
					"content": "คืออย่างนี้นะ... Ellin ลูกของฉันตั้งใจที่จะเข้าร่วมกองอัศวินแห่ง Favonius กำลังพยายามอย่างหนักเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620104
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620104,
					"content": "เฮ้อ... ทีแรกฉันก็ว่าจะช่วยเธอฝึกด้วยตัวเอง แต่ยังไงเธอก็ไม่ยอมเชื่อว่าฉันเองก็เคยเป็นนักผจญภัย จะฝึกเองท่าเดียว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620105
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620105,
					"content": "ฉันก็ไม่รู้จะพิสูจน์ยังไง... หลังจากที่มีเมียมีลูก ฉันก็ไม่กล้าที่จะออกไปผจญภัยข้างนอกแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620106
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620106,
					"content": "แทนที่จะพอใจกับการผจญภัยและความภาคภูมิใจในตัวเอง การดูแลครอบครัวของฉันเป็นความรับผิดชอบที่สำคัญที่สุดของฉันในตอนนี้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620107
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620107,
					"content": "ฮ่าฮ่า แต่ว่า \"นักผจญภัย\" อย่างฉันนี่ ก็ยังพอทำอะไรได้บ้างล่ะนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620108
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620108,
					"content": "สมัยก่อนที่เที่ยวผจญภัยไปทั่ว ยังจำได้ถึงหุ่นไม้ที่พวก Hilichurl ใช้ฝึกฝนต่อสู้ได้เลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620109
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620109,
					"content": "มันดูคุณภาพดี น่าจะเหมาะกับการฝึกฝนของ Ellin นะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620110
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620110,
					"content": "ช่วยฉันหาหุ่นไม้มาสักหน่อยได้มั้ย ตามกฎของนักผจญภัยแล้ว ฉันก็ไม่ให้ทำฟรีหรอกนะ คิดว่าไงล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620111,
						200620112
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620111,
					"content": "ฉันรู้แล้ว",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620113
					]
				},
				{
					"id": 200620113,
					"content": "โอ้ เธอนี่ไม่เลวเลยนะ เหมือนสมัยที่ฉันเข้าร่วมกิลด์เมื่อก่อนเลย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620114
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620114,
					"content": "ล้อเล่นน่ะ ๆ เอาล่ะ รีบไปเถอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620112,
					"content": "แค่พวก Hilichurl คุณไปเองก็ได้มั้ง...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620115
					]
				},
				{
					"id": 200620115,
					"content": "ไม่ ไม่ไหว ๆ ความสามารถของนักผจญภัยก็มีสิ่งจำกัดนะ หนึ่งคนก็รับการผจญภัยได้หนึ่งอย่างแค่นั้นแหละ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620116
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620116,
					"content": "และการผจญภัยอย่าง \"ชีวิตการแต่งงาน\" น่ะ... ไม่ว่าจะเป็นนักผจญภัยที่ยิ่งใหญ่แค่ไหน ก็ต้องยอมทั้งนั้นแหละ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620117
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620117,
					"content": "เพราะงั้น เธอช่วยรวบรวมหุ่นไม้ทีนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Herman"
				}
			]
		},
