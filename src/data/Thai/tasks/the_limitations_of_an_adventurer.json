					"nextDialogs": [
						200620202
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620202,
					"content": "เจอแล้ว",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620203
					]
				},
				{
					"id": 200620203,
					"content": "อะ...ฮ่าฮ่า ดูสิ ดูแล้วไม่เลวเลยใช่มั้ยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620204
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620204,
					"content": "ถ้าหุ่นนี่ทนพวก Hilichurl ได้ ก็ต้องทน Ellin ได้เหมือนกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620205
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620205,
					"content": "ขอบคุณนะ โอ้ จริงสิ ตามกฎของนักผจญภัย นี่รางวัลตอบแทน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Herman"
				}
			]
		},
