			"dialogs": [
				{
					"id": 760560301,
					"content": "ขอโทษที ฉันยังมีธุระ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760560302
					]
				},
				{
					"id": 760560302,
					"content": "ไม่เป็นไรหรอก ยังไงพวกเราก็มาฆ่าเวลากันที่นี่อยู่แล้ว ถ้าคุณมีเวลาหรือว่างมากซะจนไม่สบายใจ ก็มาหาพวกเราอีกได้นะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Terho"
