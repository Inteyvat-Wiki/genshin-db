			"dialogs": [
				{
					"id": 766550101,
					"content": "Flins คุณก็ขึ้นมาด้วยเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766550102,
					"content": "เหนื่อยหน่อยนะพวกคุณสองคน หลังจากมีคนมาดูแลซ่อมแซม สภาพของประภาคารแห่งนี้ก็ดีขึ้นเยอะเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550103
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 766550103,
					"content": "ฮิฮิ แค่นี้เองเรื่องเล็กน้อยน่า แต่ว่านะ ต่อให้เราดูแลประภาคารดีแค่ไหน ที่นี่ก็ยังมืดอยู่ดี ยังไงก็ต้องมีที่ที่แสงไฟส่องไปไม่ถึง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766550104,
					"content": "ใช่แล้ว มันไม่เหมือนกับข้างนอก เวลาในสุสานแห่งนี้ราวกับหยุดนิ่งอยู่ในยามค่ำคืนตลอดไป หยุดนิ่งอยู่ในคืนที่การต่อสู้ครั้งนั้นจบลง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550105
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 766550105,
					"content": "เดิมทีฉันไม่ได้ตั้งใจจะเปลี่ยนแปลงสภาพแวดล้อมของที่นี่หรอกนะ แต่เป็นพวกคุณที่จุดไฟประภาคารนี้ขึ้นมา ทำให้เวลาของที่นี่ได้ก้าวเดินต่อไป",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550106,
						766550108
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 766550106,
					"content": "มันจะส่งผลกระทบต่อชีวิตของคุณรึเปล่า?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766550107
					]
				},
				{
					"id": 766550107,
					"content": "ถ้าคุณจะถามว่ามันจะสร้างความลำบากให้ฉันมั้ย คำตอบก็คือไม่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550110
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 766550110,
					"content": "ชีวิตคือสังสารวัฏ ถึงแม้จะไม่มีพวกเรา เหล่าผีบนเกาะนี้ก็จะค่อย ๆ สลายไป และกลับคืนกระแสพลังในที่สุด",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550111
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 766550111,
					"content": "เพราะงั้นไม่ต้องกังวลว่าแสงจากประภาคารจะส่องไปไม่ทั่วทั้งเกาะหรอก เพราะเมื่อผีค่อย ๆ หายไป หมอกที่ปกคลุมที่นี่ก็จะค่อย ๆ จางลงไปเอง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550112
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 766550112,
					"content": "ดวงอาทิตย์ย่อมต้องปรากฏขึ้นเสมอ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				},
				{
					"id": 766550108,
					"content": "มันเป็นเรื่องไม่คาดคิดน่ะ ขอโทษด้วยนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766550109
					]
				},
				{
					"id": 766550109,
					"content": "ไม่ต้องขอโทษหรอก ฉันไม่ได้รังเกียจการเปลี่ยนแปลงแบบนี้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550110
					],
					"speakerTitle": "Flins"
				}
			]
		}
	]
