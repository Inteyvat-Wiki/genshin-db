						"stepId": 7309905,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Araminali",
					"Paimon",
					"Aranimba"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730990301,
					"content": "อ๊ะ! Nara สีทอง! แล้วก็มีกลิ่นอายของสายลม กลิ่นอายของดิน และกลิ่นอายของ Aranara ด้วย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990302
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 730990302,
					"content": "Nara สีทองทำลาย Ararakalari ของ Arayama ได้แล้วเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990303
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 730990303,
					"content": "น่ากลัวจริง ๆ! สิ่งกีดขวางไม่มีประโยชน์เลย ใคร ๆ ก็บุกเข้ามาได้ \"รังแห่งความสุข\" ของ Araminali จะถูก \"รุกล้ำ\" แล้ว!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990304
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 730990304,
					"content": "โอ้ว ใจเย็น ๆ ก่อน พวกเราไม่ได้มีเจตนาร้ายนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730990305,
					"content": "ไม่มี \"เจตนาร้าย\" หมายความว่าอะไร? หมายถึงไม่ \"โลภ\" เหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990306
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 730990306,
					"content": "#อืม... จะว่าอย่างนั้นก็ได้! ฉันกับ {NICKNAME} อยู่ฝ่ายเดียวกับ Aranara พวกเราอยากเป็นเพื่อนกับ Aranara นะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730990307,
					"content": "ถึง Paimon จะตะกละ แต่ไม่ได้มีนิสัยเลวร้ายนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730990308
					]
				},
				{
					"id": 730990308,
					"content": "เฮ้! ถึงมันจะเป็นแบบนั้นก็เถอะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730990309,
					"content": "เพื่อนรักของ Aranara... Nara สีทองมีกลิ่นอายของ Aranara... เป็นกลิ่นที่คุ้นเคย แต่ไม่ได้กลิ่นแบบนี้มานานแล้ว...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990310
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 730990310,
					"content": "#อ๊ะ จริงสิ เมล็ดพืชประหลาดนั่น! {NICKNAME} เอาเมล็ดพืชให้ Araminali ดูสิ เผื่อเขาอาจจะรู้อะไรบ้างก็ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730990311,
					"content": "อ่า! เขาหิวน้ำมาก! เขาต้องดื่มน้ำเยอะ ๆ ถึงจะฟื้นคืนสภาพเดิมได้... เร็วเข้า ตรงนี้มีน้ำเยอะแยะเลย ให้เขาดื่มให้เต็มที่ จะได้ฟื้นคืนสภาพได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990312
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 730990312,
					"content": "วางเมล็ดพืชลงในน้ำ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730990313
					]
				},
				{
					"id": 730990313,
					"content": "...ฟู่วว! กลับมาแล้วจ้า!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990314
					],
					"speakerTitle": "Aranimba"
				},
				{
					"id": 730990314,
					"content": "#ว้าว! เมล็ดพืชกลายเป็น Aranara แล้ว! เราหา \"Aranara ที่กำลังลำบาก\" เจอจริง ๆ ด้วย! ดูสิ ฉันพูดถูกใช่มั้ยล่ะ {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990315,
						730990316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730990315,
					"content": "มี \"Aranara ที่กำลังลำบาก\" อยู่จริง ๆ ด้วย...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730990317
					]
				},
				{
					"id": 730990317,
					"content": "Aranimba นี่เอง! เขาไม่เหมือนกับ Araminali เลย Aranimba ชอบตะลอนไปทั่ว เมื่อก่อนเขาจะวาดภาพทิวทัศน์ที่มองเห็นจากที่ไกล ๆ ส่งกลับมาที่ Vanarana แต่หลัง ๆ มานี้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990318
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 730990318,
					"content": "หลัง ๆ มานี้ไปแต่ที่แข็ง ๆ มืด ๆ มีดินน้อยมาก แต่มีหินเยอะแยะ... ข้างใต้ดินมีหญ้าน้อยมาก ต้นไม้น้อยมาก แต่มีเห็ดเพียบเลย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990319
					],
					"speakerTitle": "Aranimba"
				},
				{
					"id": 730990319,
					"content": "อืม... น่าจะหมายถึงที่ Chasm สินะ? แต่ Aranara อย่าง Aranimba กล้าไปสถานที่ไกล ๆ ถึงขั้นออกนอกเมือง Sumeru คนเดียวเลยเหรอ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730990320,
					"content": "อื้ม! ไกลมาก อันตรายด้วย แถมยังเจอ Nara สีดำที่แสนอันตรายอีก! แต่ Aranimba มี Aramuhukunda คอยดูแล และกลายเป็นเมล็ดพืชจน \"หนีรอดมาได้\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990321
					],
					"speakerTitle": "Aranimba"
				},
				{
					"id": 730990321,
					"content": "ตอนนี้ Aranimba กลับมาอย่างปลอดภัยแล้ว ขอบคุณ Nara สีทอง และเจ้าตัวขาวบินได้มากนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990322
					],
					"speakerTitle": "Aranimba"
				},
				{
					"id": 730990322,
					"content": "#{NICKNAME} และ Paimon ต่างหากล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730990323,
					"content": "#ใช่แล้ว Nara {NICKNAME} และ Paimon เป็นเพื่อนที่แสนดีของ Aranara",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990324
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 730990324,
					"content": "#Araminali เป็น \"เพื่อนที่แสนดี\" ของ Aranimba เพราะงั้น Nara {NICKNAME} และ Paimon ก็เป็น \"เพื่อนที่แสนดี\" ของ Aranimba เหมือนกัน อื้ม เข้าใจแล้วล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990325
					],
					"speakerTitle": "Aranimba"
				},
				{
					"id": 730990325,
					"content": "Aranimba จะออกเดินทางแล้ว คราวนี้ไม่ใช่แค่ภาพวาด แต่ Aranimba จะส่ง \"ของขวัญ\" กลับมาให้ Araminali เก็บใส่ \"หีบสมบัติ\" ด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990326
					],
					"speakerTitle": "Aranimba"
				},
				{
					"id": 730990326,
					"content": "\"หีบสมบัติ\" ทุกใบที่นี่เป็นของ Araminali... Araminali เป็นเจ้าของ \"หีบสมบัติ\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990327
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 730990327,
					"content": "ถ้าเป็นเพื่อนที่แสนดีของ Aranara และเคยช่วยเหลือ Aranara มาก่อนจริง ๆ... Aranara ย่อม \"รู้บุญคุณ\" และใส่ \"สมบัติ\" ไว้ใน \"หีบ\" อยู่แล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990328
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 730990328,
					"content": "ที่แท้เดิมทีเป็นหีบเปล่างั้นเหรอ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730990329,
					"content": "Aranara รู้ทุกอย่างเกี่ยวกับ Vana ตั้งแต่ตอนถือกำเนิดแล้ว แต่ตอนที่ \"หีบ\" ถือกำเนิด ในท้องของมันกลับว่างเปล่า! Araminali ก็ไม่เข้าใจเหมือนกันว่าเป็นเพราะอะไร",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990330
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 730990330,
					"content": "Paimon ก็ไม่เข้าใจเหมือนกัน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730990331,
					"content": "#...รอให้ Araminali ใส่ของเสร็จแล้ว Nara {NICKNAME} ก็เปิด \"หีบสมบัติ\" ได้ แล้วหลังจากนั้นบางครั้งก็จะ \"เย้!\" บางครั้งก็จะ \"เฮ้อ...\" เหมือนที่ Nara สีเขียวทำ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990332
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 730990332,
					"content": "ทำไมต้องทำอะไรยุ่งยากด้วยล่ะ? Araminali และ Aranimba เอาของที่จะใส่ในหีบสมบัติมอบให้เราเป็นของตอบแทนเลยก็ได้นี่นา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730990333,
					"content": "#Araminali รู้มาว่า Nara สีเขียวชอบเข้าไปในถ้ำ หรือในบ้าน จากนั้นก็เปิด \"หีบสมบัติ\" แล้ว Nara {NICKNAME} กับ Paimon ไม่ชอบเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990334
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 730990334,
					"content": "อ่อ... ก็ไม่ใช่ว่าไม่ชอบหรอก... มันรู้สึกว่า... มีแรงดึงดูดแบบอธิบายไม่ถูกล่ะมั้ง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990335
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730990335,
					"content": "อืม Nara ชอบ \"หีบสมบัติ\" Araminali ก็ชอบเหมือนกัน เพราะงั้นเลยอนุญาตให้ Nara นิสัยดีที่เคยช่วย Aranara สามารถเปิด \"หีบสมบัติ\" ได้ไงล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990336
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 730990336,
					"content": "ที่ Vana มี Aranara อยู่มากมายเลย บางตนต้องการความช่วยเหลือ บางตนก็อยากเล่นกับ Nara และ Nara ที่ทำให้ความปรารถนาของพวกเขาเป็นจริงก็ถือเป็นเพื่อนของ Aranara",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990337
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 730990337,
					"content": "Nara แบบนี้สามารถเปิด \"หีบสมบัติ\" ที่ Araminali เตรียมไว้ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990338
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 730990338,
					"content": "เพราะงั้น Aranimba ควรออกเดินทางเดี๋ยวนี้ เพื่อเติม \"หีบสมบัติ\" ให้เต็ม",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990339
					],
					"speakerTitle": "Aranimba"
				},
				{
					"id": 730990339,
					"content": "เอ๋? แต่ Aranimba เพิ่งกลับมาได้แป๊บเดียวเองไม่ใช่เหรอ? จะรีบไปแล้วเหรอ? ช่างไฟแรงเหมือนมีลมช่วยโหมซะจริง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990340
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730990340,
					"content": "อ๋าา! มีลมน่ะดีมาก แต่ไม่เอาไฟนะ อยู่ใกล้ไฟแล้ว เดี๋ยว Aranimba จะหิวน้ำมาก ๆ อีก...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990341
					],
					"speakerTitle": "Aranimba"
				},
				{
					"id": 730990341,
					"content": "เอ่อ ฉันหมายความว่า \"ทำไม Aranimba รีบไปจังเลย\" ต่างหากล่ะ ทั้ง ๆ ที่อยู่คุยกับ Araminali ต่ออีกหน่อยก็ได้แท้ ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990342
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730990342,
					"content": "Araminali ก็เหมือนกัน ไม่ได้เจอ Aranimba มาตั้งนาน น่าจะมีเรื่องให้คุยกันเยอะแยะไม่ใช่เหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990343
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730990343,
					"content": "Aranimba เป็น Aranara ที่ไม่เคยหยุดนิ่ง เพราะงั้นเลยเป็นเจ้าของ \"หีบสมบัติ\" ไม่ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990344
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 730990344,
					"content": "ส่วนข่าวคราวการตะลอนไปตามที่ต่าง ๆ ของ Aranimba นั้น ขอแค่ Vana รู้ สายลมรู้ ดอกไม้และต้นหญ้ารู้ Araminali ก็รู้ด้วยเหมือนกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990345
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 730990345,
					"content": "เพราะงั้นไม่เป็นไรหรอก ไม่จำเป็นต้องพูดเยอะ แต่ถ้า Aranimba อยากพูด Araminali ก็พร้อมจะฟัง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990346
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 730990346,
					"content": "#อืม... นี่คือมิตรภาพของ Aranara สินะ? ถ้าเป็นฉันล่ะก็ คงมีเรื่องอยากเล่าให้ {NICKNAME} ฟังไม่จบไม่สิ้นแหง ๆ เลย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730990316,
					"content": "เธอโอเครึเปล่า?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730990317
					]
				}
			]
		},
