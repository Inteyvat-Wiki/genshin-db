							"3"
						],
						"stepId": 7221602,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Etsuko",
					"Taisuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722160401,
					"content": "แต่ทั้ง \"Hibiki\"... \"Asase Shrine\" และ \"Domeki\" ต่างเป็นชื่อที่ชวนให้สงสัย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160402,
						722160407
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160402,
					"content": "พวกเธอโผล่มาตั้งแต่เมื่อไหร่เนี่ย...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160403
					]
				},
				{
					"id": 722160403,
					"content": "ก็บนเกาะเกิดเสียงดังขนาดนี้ เราเลยมาดูน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160404
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160404,
					"content": "แต่มีบางเรื่องที่ฉันคิดว่าควรจะบอกพวกเธอ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160405
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160405,
					"content": "Taisuke เล่าสิ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160406
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160406,
					"content": "อ่า...ได้เลยคุณ Etsuko คืออย่างนี้ สิ่งที่ฉันจะบอกเป็นเรื่อง...เกี่ยวกับเกาะ Seirai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160408
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160408,
					"content": "ประวัติของเกาะ Seirai นั้นเก่าแก่มาก ๆ ถึงแม้ทางกิลด์จะพยายามค้นหาข้อมูลเกี่ยวกับเกาะนี้ แต่ดูเหมือนจะไม่เจอข้อมูลที่มีประโยชน์เลย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160409
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160409,
					"content": "จากข้อมูลของกิลด์ เมื่อหลายร้อยปีก่อน ดูเหมือนที่แห่งนี้จะเคยเป็นแหล่งรวมตัวของ \"โจรสลัด\" ในตอนนั้นโชกุนเป็นผู้กวาดล้างโจรสลัดทั้งหมด และย้ายผู้คนบนเกาะแห่งนี้ไปยังที่อื่น...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160410
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160410,
					"content": "ถ้าเดาไม่ผิดล่ะก็ \"Domeki\" คนนั้นอาจจะเป็นหัวหน้าโจรสลัด \"Ako Domeki\" ที่เคยขัดแย้งและต่อสู้กับโชกุน ชื่อของเขาเขียนไว้อย่างชัดเจนในบันทึกทางประวัติศาสตร์ด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160411
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160411,
					"content": "ตามเอกสารเหล่านั้นที่ทางกิลด์ให้เรามา \"Ako Domeki\" คนนี้ ได้นำกองเรือโจรสลัดของเขาไปต่อสู้กับโชกุนในการรบทางทะเล",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160412
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160412,
					"content": "ถึงแม้กองเรือของเขาจะถูกโชกุนควบคุมได้อย่างรวดเร็ว จนต้องหนีไปยังเกาะ Seirai..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160413
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160413,
					"content": "แต่กองทัพเรือของโชกุนก็ไล่ตามพวกเขาไป แล้วจู่ ๆ ก็มีพายุฝนปกคลุมไปทั่วทั้งเกาะ Seirai",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160414
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160414,
					"content": "กองเรือของ Ako Domeki และกองทัพเรือของโชกุนต่างก็ติดอยู่ในพายุฝน... และแล้วพวกเขาทั้งหมดก็หายตัวไปอย่างไร้ร่องรอย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160415
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160415,
					"content": "พายุฝน...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160416
					]
				},
				{
					"id": 722160416,
					"content": "ต่อจากนี้เดี๋ยวฉันเป็นคนเล่าเอง จุดที่น่าสงสัยที่สุดของเรื่องนี้ก็คือ พายุฝนที่จู่ ๆ ก็เกิดขึ้นอย่างกะทันหัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160417
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160417,
					"content": "ถึงแม้กองเรือของ Ako Domeki จะถูกพายุฝนพัดถล่มไปเกือบหมด... แต่กองทัพเรือที่ฝ่ายโชกุนส่งมายังเกาะ Seirai ก็ถูกทำลายแทบไม่เหลือเช่นกัน และยังถูกให้ล่าถอยไปยังเกาะ Narukami ด้วย ซึ่งคงต้องใช้เวลาพอสมควรในการฟื้นฟูกองทัพเรือขึ้นมาใหม่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160418
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160418,
					"content": "พายุฝนในคราวนั้นเป็นอะไรที่บังเอิญจนเกินไป พูดง่าย ๆ ก็คือเหมือนกับ...มีคนจงใจทำให้เกิดขึ้นยังไงยังงั้นเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160419
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160419,
					"content": "เธอคงจำ \"หินเครื่องราง\" บนเกาะแห่งนี้ ที่ถูกเปิดผนึกอย่างจงใจได้ใช่มั้ย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160420
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160420,
					"content": "แล้วหลังจากที่เราผนึก \"หินเครื่องราง\" เหล่านั้นแล้ว พายุบนเกาะก็สงบลง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160421
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160421,
					"content": "ฉันก็ไม่อยากด่วนสรุป แต่...ฉันรู้สึกว่าเรื่องราวทั้งหมดนี้ น่าจะมีความเกี่ยวข้องกันไม่มากก็น้อย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160422
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160422,
					"content": "เราไปถามคุณเหมียว Neko กันเถอะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160423
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160423,
					"content": "...ช่างเถอะ ในบันทึกบอกว่า Domeki คนนั้นหายไปอย่างไร้ร่องรอย แต่ถ้าเขาถูกพายุโจมตีล่ะก็ บางทีอาจจะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160424
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160424,
					"content": "เราจะสำรวจเกาะแห่งนี้และรวบรวมเบาะแสเกี่ยวกับเรื่องนี้ต่อไป แล้วอีกสักพักเราจะกลับไปรายงานให้ทางกิลด์ทราบ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160425
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160425,
					"content": "นักเดินทาง ไม่แน่ว่าพอถึงตอนนั้น เราอาจจะได้ร่วมมือกันอีกก็ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160426
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160426,
					"content": "ถึงตอนนี้ก็ฝากเนื้อฝากตัวด้วยนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160427
					]
				},
				{
					"id": 722160427,
					"content": "ได้เลย ร่วมด้วยช่วยกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160428
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160428,
					"content": "Taisuke เตรียมตัวนะ เราจะไปสำรวจกันต่อ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160429
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160429,
					"content": "เอ่อ...คุณ Etsuko แล้วคุณเหมียว Neko ล่ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160430
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160430,
					"content": "ก่อนหน้านี้เธอเข้าหาแมวตัวนั้นยังไง ก็ทำแบบนั้นนั่นแหละ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160431
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160431,
					"content": "แต่จำไว้ว่า อย่าพูดในสิ่งที่ไม่ควรเชียวล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160432
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160432,
					"content": "ตอนนี้...มันคงจะมีความสุขมาก ๆ อย่าพูดอะไรที่ทำให้เสียบรรยากาศล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160433
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160433,
					"content": "เข้าใจแล้ว! ฮี่ฮี่ คุณ Etsuko เองก็....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160434
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160434,
					"content": "...ฉันแค่อยากทำภารกิจให้สำเร็จก็เท่านั้นเอง รีบไปทำงานเร็วเข้า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160435
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160435,
					"content": "เกาะ Seirai...แห่งนี้ ดูท่าทางจะมีความลับอีกมากมายเลย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160407,
					"content": "พวกเธอรู้อะไรงั้นเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160408
					]
				}
			]
		}
	]
}