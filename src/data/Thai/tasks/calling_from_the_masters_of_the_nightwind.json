					}
				]
			},
			"dialogs": [
				{
					"id": 150240701,
					"content": "ฟู่ว... ในที่สุดก็ออกมาได้ซะที!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240702,
					"content": "ดูท่าพวกคุณจะมีความสามารถที่จะทำภารกิจนี้ได้จริง ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240703
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240703,
					"content": "ข้อสันนิษฐานของคุณ ได้รับการพิสูจน์รึยังล่ะ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240704
					]
				},
				{
					"id": 150240704,
					"content": "ใช่แล้วล่ะ พวกคุณคงได้เห็นสิ่งทอสุดพิเศษในนั้นเยอะแยะเลยใช่มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240705
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240705,
					"content": "อื้ม ใช่แล้ว...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240706,
					"content": "ฉันได้ศึกษาสิ่งทอที่บรรพบุรุษทิ้งไว้พวกนี้อย่างละเอียด และพบว่าพวกมันมี \"สีสัน\" บางอย่างที่สิ่งทอทั่วไปไม่มี",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240707
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240707,
					"content": "\"สีสัน\" แบบนี้มันมหัศจรรย์มาก แม้แต่ฉันก็ยังต้องใช้วิธีพิเศษ ถึงจะยืนยันการมีอยู่จริงของมันได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240708
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240708,
					"content": "แต่มีคนอีกประเภทนึงที่เกิดมาพร้อมกับความสามารถในการแยกแยะ \"สีสัน\" และนี่ก็เป็นเหตุผลที่ฉันทดสอบพวกคุณสองคน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240709
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240709,
					"content": "งั้นก็หมายความว่า...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240710,
					"content": "พื้นที่ที่พวกคุณเพิ่งเข้าไปเมื่อกี้ ก็คือห้องจัดแสดงที่ใช้จัดเก็บสิ่งทอพวกนี้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240711
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240711,
					"content": "หลายร้อยปีก่อน มีชาแมนผู้ยิ่งใหญ่ชื่อว่า Huitzilin เคยผนึกห้องจัดแสดงแห่งนี้ไว้ ถ้ามีคนนอกบุกเข้ามาโดยไม่ได้รับอนุญาต ก็จะถูกขังไว้ในนั้น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240712
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240712,
					"content": "ผนึกนี้ยังคงอยู่จนถึงทุกวันนี้ ถึงแม้ว่าจะยังไม่เข้าใจหลักการของมัน แต่ฉันก็เจอวิธีที่จะเปิดและปิดมันแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240713
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240713,
					"content": "ถ้าถูกขังไว้ ก็แทบจะเป็นไปไม่ได้ที่จะหนีออกมาสู่โลกภายนอกได้ นอกจากว่าคนคนนั้นจะมีความสามารถในการแยกแยะ \"สีสัน\" เหมือนกับชาแมนผู้ยิ่งใหญ่คนนั้น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240714,
						150240715
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240714,
					"content": "ฉันนึกออกแล้วล่ะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240716
					]
				},
				{
					"id": 150240716,
					"content": "ดูเหมือนว่าคุณจะมีความสามารถแบบนี้อยู่จริง ๆ... เพราะงั้นผู้อาวุโส Iktomisaurus น่าจะสามารถแยกแยะคนที่มีความสามารถแบบนี้ได้โดยตรง และใช้สิ่งนี้เพื่อกำหนดผู้ได้รับเลือกในแต่ละครั้ง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240717
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240717,
					"content": "เธอยังมีความลับที่ฉันไม่รู้อีกกี่เรื่องกันเนี่ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240718,
					"content": "แต่ว่า ต่อให้มีความสามารถแบบนี้ แต่ถ้าจะให้พวกเราสร้างสิ่งทอ ก็ยังไม่รู้ว่าจะเริ่มจากตรงไหนดีอยู่ดี",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240719,
					"content": "พวกคุณไม่ต้องห่วงนะ ฉันเคยเปรียบเทียบแล้ว เทคนิคการทอสิ่งทอชนิดนี้ก็ไม่ต่างจากสิ่งทอทั่วไปเท่าไหร่ ความแตกต่างที่สำคัญที่สุดอาจอยู่ที่สีย้อมและการย้อมสี",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240720
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240720,
					"content": "ถ้าฉันเดาไม่ผิด งั้นกุญแจสำคัญในการทำสิ่งทอชนิดนี้ก็คือ สีย้อมพิเศษชนิดหนึ่ง และการจะได้มันมา ก็ต้องอาศัยความสามารถของพวกคุณสองคน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240721
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240721,
					"content": "ส่วนเรื่องการย้อมสี... ขอแค่ได้รับสีย้อมมา ก็ไม่น่าจะมีปัญหาอะไร ส่วนนี้ฉันช่วยแนะนำพวกคุณสองคนได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240722
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240722,
					"content": "...อื้ม งั้นก็เอาตามที่หัวหน้าเผ่าว่าละกัน!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240723
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240723,
					"content": "งั้นก็รบกวนพวกคุณช่วยใช้ความสามารถนี้ ตามหาสีย้อมที่ต้องการก่อนนะ ฉันจะหาคนมาเตรียมสิ่งทอที่ใช้สำหรับทดสอบสีย้อม",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240724
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240724,
					"content": "พวกเรามาทำสิ่งทอตัวอย่าง เพื่อพิสูจน์ข้อสันนิษฐานของฉันก่อน ถ้าทำสำเร็จ ก็เริ่มกันได้เลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240725
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240725,
					"content": "หลังจากเสร็จงานแล้ว ฉันยินดีจะให้ค่าตอบแทนอย่างงามเป็นการขอบคุณ พวกคุณคิดว่าไง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240726
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240726,
					"content": "พลังที่ยิ่งใหญ่มาพร้อมกับ ความรับผิดชอบอันใหญ่ยิ่ง",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240727
					]
				},
				{
					"id": 150240727,
					"content": "อื้ม ๆ แถมยังมีค่าตอบแทนด้วย! จริงสิ ในค่าตอบแทนมีของอร่อย ๆ บ้างมั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240728,
					"content": "เรื่องนี้มีความสำคัญต่อจ้าวแห่งลมราตรีของเรามาก ฉันยินดีจะมอบเงินก้อนโตเป็นการตอบแทน แค่อาหารอร่อยสักมื้อจะเป็นปัญหาได้ยังไง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240729
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240729,
					"content": "เย้! จะว่าไปแล้ว พวกเราจะไปหาสีย้อมแบบนั้นจากที่ไหนกันล่ะ? จะให้เดินทางไปทั่ว Natlan ก็ไม่ไหวมั้ง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240730
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240730,
					"content": "ไม่จำเป็นหรอก ในระหว่างที่เตรียมการก่อนหน้านี้ ฉันเจอสถานที่ที่อาจจะมีสีย้อมนี้อยู่ และได้จัดเตรียมผู้นำทางให้พวกคุณแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240731
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240731,
					"content": "ถ้าพวกคุณพร้อมแล้วก็ออกเดินทางได้เลย ผู้นำทางกำลังรออยู่ข้างนอกละ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240715,
					"content": "เป็น \"สีสัน\" แบบนั้น...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240716
					]
				}
			]
		},
