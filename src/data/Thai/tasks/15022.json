						],
						"stepId": 1502201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xilonen"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-1350.876,
							161.634,
							7851.647
						],
						"pointId": 350400213
					}
				]
			},
			"dialogs": [
				{
					"id": 150220101,
					"content": "Allpa เคยบอกไว้ว่า... Tepal มาจากบุตรแห่งเสียงสะท้อนใช่มั้ยนะ? จะหาเขาเจอได้ยังไงล่ะ? ไล่ถามไปทีละคนงั้นเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220102,
					"content": "ไปขอความช่วยเหลือจากคนรู้จักที่บุตรแห่งเสียงสะท้อน น่าจะเร็วกว่านะ เวลาแบบนี้และสถานที่แบบนี้ คนที่หาได้ง่ายที่สุดก็คงเป็น...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220103
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220103,
					"content": "...Xilonen ตื่นได้แล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220104
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220104,
					"content": "*หาว*... พวกเธอเองเหรอ... เอ่อ... รอเดี๋ยวนะ... ขอฉันลงจากต้นไม้ก่อน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220105
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220105,
					"content": "อ่า... ฮือ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220106
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220106,
					"content": "พวกเธอสองคนนี่ ชอบอยู่บนต้นไม้กันจังเลยนะ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220107
					]
				},
				{
					"id": 150220107,
					"content": "ฉันขึ้นไปบนต้นไม้ก็เพื่อบินให้ได้นานขึ้นและมองเห็นได้ไกลขึ้น ปกติฉันจะไม่นอนบนต้นไม้หรอกนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220108
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220108,
					"content": "ไม่ใช่ว่าทุกคนจะเหมือนกับเธอนะ ที่เที่ยวเล่นไปทั่วทั้งวันก็ไม่รู้จักเหน็ดเหนื่อยน่ะ... ว่าแต่มารบกวนเวลาพักผ่อนอันมีค่าของฉัน เพราะเรื่องอะไรงั้นเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220109
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220109,
					"content": "ขอโทษทีนะ Xilonen แต่เรื่องนี้เป็นเรื่องด่วนมากจริง ๆ... เธอพอจะรู้จักช่างฝีมือคนนึงที่ชื่อว่า Tepal มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220110
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220110,
					"content": "Tepal เหรอ? เหมือนจะคุ้น ๆ อยู่นะ... น่าจะเป็นลูกของตระกูล Puma รึเปล่านะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220111
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220111,
					"content": "งั้นตอนนี้เขาอยู่ที่บุตรแห่งเสียงสะท้อนรึเปล่า?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220112
					]
				},
				{
					"id": 150220112,
					"content": "ไม่น่า เหมือนว่าเขาจะไม่อยู่มาหลายปีแล้วนะ... ว่าแต่ทำไมพวกเธอถึงต้องตามหาเขาด้วยล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220113
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220113,
					"content": "เรื่องมันยาวน่ะ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220114
					]
				},
				{
					"id": 150220114,
					"content": "พวกคุณพยายามอธิบายเรื่องราวที่เกิดขึ้นให้เธอฟังอย่างคร่าว ๆ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150220115
					]
				},
				{
					"id": 150220115,
					"content": "\"ปีกโฟลจิสตัน\"? เจ้าเด็ก Tepal นี่สร้างของที่สุดยอดขนาดนี้ขึ้นมาได้จริง ๆ เหรอเนี่ย... เห็นทีวันนี้คงจะไม่มีเวลาพักผ่อนแล้วสิ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220116
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220116,
					"content": "\"จริง ๆ\"? หรือว่าเขาเคยศึกษาเรื่องแบบนี้มาก่อนงั้นเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220117,
					"content": "ใช่แล้วล่ะ ก็ตั้งแต่ตอนที่เขากลับมาจากวงศ์ปีกบุปผา เขาก็เริ่มคิดหาวิธีที่จะใช้สิ่งประดิษฐ์ฝีมือมนุษย์บินขึ้นไปบนฟ้า...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220118
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220118,
					"content": "หลังจากกลายเป็น \"ผู้ไร้ปีก\" แล้ว... สิ่งประดิษฐ์นี้... ก็เหมือนกับปืนที่เธอสร้างให้ฉันงั้นเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220119
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220119,
					"content": "\"ปืน\" ของเธอควบคุมยากกว่า Qucusaurus ที่หยิ่งผยองที่สุดซะอีก... และสิ่งที่เขาต้องการ ก็คือการทำให้คนธรรมดาที่ไม่มีพรสวรรค์ สามารถบินได้อย่างอิสระ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220120
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220120,
					"content": "แต่ตอนนั้นเขามักจะล้มเหลวอยู่เสมอ ระเบิดเวิร์กชอปไปตั้งหลายครั้ง จนเกือบจะเอาชีวิตตัวเองไม่รอดด้วยซ้ำ ส่วนเรื่องหลังจากนั้น ฉันก็ไม่ได้สนใจมากเท่าไหร่แล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220121
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220121,
					"content": "พ่อแม่ของ Tepal เดินทางไปต่างแดนตั้งแต่เด็ก ต่อมาพอมี Tepal พวกเขาถึงจะกลับมาที่เผ่า แต่ก็เลือกที่จะอาศัยอยู่ในสถานที่ห่างไกล และไม่ค่อยยุ่งเกี่ยวกับใครเท่าไหร่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220122
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220122,
					"content": "ผู้คนในเผ่าไม่ค่อยจะสนิทกับพวกเขาเท่าไหร่นักหรอก... ถ้าอยากรู้รายละเอียดเกี่ยวกับ Tepal ละก็ ลองไปหาคนในครอบครัวของเขาน่าจะดีกว่านะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220123
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220123,
					"content": "ฉันจะไปเรียก Puma มาเดี๋ยวนี้แหละ พวกเธอรออยู่หน้าเวิร์กชอปก่อนละกันนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xilonen"
				}
			]
		},
