					}
				]
			},
			"dialogs": [
				{
					"id": 790740101,
					"content": "ดูสิ มีผู้กล้ามาอีกสองคนแล้ว! พวกคุณจะมาท้าทาย \"กระแสลมเหนือ\" งั้นเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740102
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740102,
					"content": "มาเถอะ มาทางนี้ หวังว่าคุณจะบินเก่งกว่าใคร ๆ นะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740103,
						790740104
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740103,
					"content": "ใจเย็นก่อนนะ!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790740105
					]
				},
				{
					"id": 790740105,
					"content": "การบินไม่จำเป็นต้องใจเย็นนะ คุณแขกผู้มีเกียรติ ไม่จำเป็นเลยสักนิด",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740106
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740106,
					"content": "ใจเย็นไปก็รังแต่จะทำให้คุณรู้สึกถึงลมได้ช้าลง มีเพียงการเผชิญหน้ากับพายุโดยไม่ได้เตรียมตัวเท่านั้น ที่จะดึงศักยภาพของคุณออกมาได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740107
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740107,
					"content": "ตอนนี้กระรอกบินขี้ขลาดเกินไปแล้ว! ลืมคำสอนใน \"ลมเหนือแสนกล้าหาญ\" ไปหมดแล้ว!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740108
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740108,
					"content": "เอาแต่ยืนอยู่ในที่ที่ปลอดภัย ชื่นชมความกล้าของใบไม้ที่ปลิดปลิวไปตามสายลม แต่ตัวเองกลับขลาดเขลา ไม่กล้าก้าวเข้าไปในสายลมด้วยตัวเอง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740109
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740109,
					"content": "ถ้าเป็นแบบนี้ต่อไป พวกเราจะไปปกป้องอาณาจักรกับเจ้าหญิงได้ยังไงกัน! ไม่สมเหตุสมผลเลยจริง ๆ! ไม่สมเหตุสมผลเลย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740110
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740110,
					"content": "ช่างเป็นกระรอกบินที่พลังเหลือล้นดีจริง ๆ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790740111,
					"content": "ดูเหมือนเขาจะชอบการบินมากเลยนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790740112
					]
				},
				{
					"id": 790740112,
					"content": "เพราะงั้น ฉันเลยตามหาเส้นทางสายลมที่พัดแรงมากมาหลายเส้นทาง แล้วติดตั้งกลไกต่าง ๆ ไว้ในนั้น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740113
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740113,
					"content": "มีเพียงผู้กล้าที่กล้าหาญและชำนาญการบินที่สุดเท่านั้น ถึงจะผ่านเส้นทางสายลมนี้ไปได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740114
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740114,
					"content": "แขกผู้มีเกียรติทั้งสอง พวกคุณมีความกล้าหาญแบบนี้รึเปล่าล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740115,
						790740117
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740115,
					"content": "ฉันอยากลองดู!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790740116
					]
				},
				{
					"id": 790740116,
					"content": "เยี่ยมเลย งั้นตามฉันมา เส้นทางสายลมอยู่ไม่ไกลจากที่นี่แล้วล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740117,
					"content": "คือ... ยังมีเรื่องอื่นต้องทำอีกน่ะ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790740118
					]
				},
				{
					"id": 790740118,
					"content": "ทำไม? ต้องเตรียมตัวอะไรอีกงั้นเหรอ? ก็ได้ ฉันจะรออยู่ที่นี่ละกันนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740119
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740119,
					"content": "ถ้าแขกผู้มีเกียรติทั้งสองคนอยากท้าทายเส้นทางสายลมละก็ ก็มาหาฉันที่นี่ได้เลยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740104,
					"content": "ฉันยังไม่ได้พูดอะไรเลยนะ!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790740105
					]
				}
			]
		}
	]
}