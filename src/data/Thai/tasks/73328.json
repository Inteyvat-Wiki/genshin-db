			},
			"dialogs": [
				{
					"id": 733280101,
					"content": "เธอนี่เอง Jeht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733280102,
					"content": "#{NICKNAME}?! แล้วก็ Paimon น้อย!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280103
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280103,
					"content": "ปี๊บปี๊บ...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280104
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 733280104,
					"content": "ฮ่าฮ่า ฉันเคยพูดไว้ว่ายังไง! พวกเราเจอกันอีกแล้วเห็นมั้ย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280105
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280105,
					"content": "เธอทำอะไรอยู่ที่นี่เหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280106
					]
				},
				{
					"id": 733280106,
					"content": "อืม... ความลับของสุภาพสตรีโตเต็มวัยน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280107
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280107,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733280108,
					"content": "#{M#หมายถึงว่าอย่าถามมากไงล่ะ! ฉันก็ต้องการความเป็นส่วนตัวเหมือนกันนะ...}{F#หาอิซากายะสักร้านแล้วทำให้ฉันอารมณ์ดีสิ ไม่แน่ฉันอาจจะบอกเธอก็ได้นะ... ต้องให้ฉันสอนมั้ย?}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280109
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280109,
					"content": "#{M#พรืดฮ่าฮ่า... กฎของสำนักงานผู้คุ้มกันน่ะ ฉันเองก็บอกไม่ได้ โทษทีน้า}{F#ละ ล้อเล่นน่า อย่าเอาจริงสิ! เป็นกฎของสำนักงานผู้คุ้มกันน่ะ... สินค้าคราวนี้ต้องเก็บเป็นความลับขั้นสูงสุด โทษทีน้า}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280110
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280110,
					"content": "ฮึ ทำตัวลับ ๆ ล่อ ๆ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733280111,
					"content": "แล้ว... ช่วงนี้เป็นไงบ้าง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280112,
						733280113
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280112,
					"content": "ไม่เลว",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280114
					]
				},
				{
					"id": 733280114,
					"content": "อื้ม... ฉันก็เหมือนกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280115
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280115,
					"content": "โอเค ไม่รั้งตัวเธอไว้ล่ะ เฮ้อ... ฉันยังมีเรื่องตัวเองที่ต้องไปทำอีก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280116
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280116,
					"content": "เอ๋ Jeht ยุ่งขนาดนี้เลยเหรอเนี่ย... เมื่อก่อนไม่เห็นเป็นแบบนี้เลยนี่นา?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733280117,
					"content": "คิก... ก็เพราะเจองานที่ \"มั่นคง\" แล้วนี่นา ถึงเนื้องานจะไม่ต่างอะไรจากก่อนหน้านี้มากก็เถอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280118
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280118,
					"content": "หลังหางานจากสำนักงานผู้คุ้มกันได้ไม่นาน ฉันก็เริ่มคิดถึงชีวิตไร้ข้อผูกมัดในสมัยก่อนซะแล้ว...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280119
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280119,
					"content": "ถึงจะไม่รู้สถานการณ์ฝั่งเธอ แต่ฉันก็ตั้งตารอเรื่องราวของเธออยู่เสมอเลยนะ ฉันเองก็มีเรื่องมากมายที่อยากเล่าให้เธอฟัง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280120
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280120,
					"content": "แต่ตอนนี้ยังไม่ต้องรีบหรอก ตอนนี้ยังไม่ต้องรีบ... เรื่องราวดี ๆ ก็ต้องเก็บสะสมทีละนิดทีละน้อย และบ่มเพาะเอาไว้นี่เนอะ เพราะนักเดินทางในทะเลทรายเคยพึ่งพวกมันมาประคับประคองชีวิตไงล่ะ! ฮิฮิ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280121
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280121,
					"content": "อื้ม... ยังไงก็รักษาตัวด้วยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280122
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280122,
					"content": "เธอเองก็ด้วย",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280123
					]
				},
				{
					"id": 733280123,
					"content": "อื้ม กอดพันครั้งไปเลย ฉันจะคอยสวดภาวนาให้เธอเอง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280124
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280124,
					"content": "ปี๊บปี๊บ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280125
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 733280125,
					"content": "ฮ่าฮ่า Benben ก็ด้วย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280113,
					"content": "เฉย ๆ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280114
					]
				}
			]
		},
