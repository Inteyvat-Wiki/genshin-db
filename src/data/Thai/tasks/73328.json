			"dialogs": [
				{
					"id": 733280201,
					"content": "เอากอดพันครั้งไปเลย! จะตั้งตารอการเจอกันครั้งต่อไปนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280202,
						733280206
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280202,
					"content": "คราวหน้าฉันจะได้เจอเธอที่ไหนกันนะ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280203
					]
				},
				{
					"id": 733280203,
					"content": "ใครจะไปรู้ล่ะ? Celestia มั้ง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280204
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280204,
					"content": "ฮ่าฮ่าฮ่าฮ่าฮ่า ล้อเล่น! แต่ถ้าเธออยากเห็นฉันที่นั่น ฉันก็จะไปอยู่ที่นั่นแน่นอน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280205
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280205,
					"content": "อย่าถามว่าทำไมเลย ฉันรู้ว่าต้องเป็นแบบนั้นแน่ ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280208
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280208,
					"content": "ยังไงก็ไว้เจอกันใหม่คราวหน้านะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280206,
					"content": "อ่ะ กอดเธอพันครั้งเหมือนกันนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280207
					]
				},
				{
					"id": 733280207,
					"content": "ฮ่าฮ่า ขอบคุณนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280208
					],
					"speakerTitle": "Jeht"
				}
			]
		}
