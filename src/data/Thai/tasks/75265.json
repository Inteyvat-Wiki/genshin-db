					"Manou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752650101,
					"content": "เฮ้! เพื่อน ฉันมีของดีราคาเบา ๆ สนใจมาดูหน่อยมั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650102
					],
					"speakerTitle": "Manou"
				},
				{
					"id": 752650102,
					"content": "เอ๋? นี่มันตุ๊กตา Koholasaurus นี่? เหมือนจะเคยเห็นในตลาดนัดแสนสบายเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752650103,
					"content": "ตาดีจริง ๆ แต่ของฉันขายถูกกว่า ลดไปตั้งครึ่งนึงเลยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650104
					],
					"speakerTitle": "Manou"
				},
				{
					"id": 752650104,
					"content": "ทำไมถึงถูกขนาดนั้น?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752650105
					]
				},
				{
					"id": 752650105,
					"content": "ฮิฮิ เพื่อน อย่าไปสนเลยน่า ฉันมีช่องทางของตัวเองน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650106
					],
					"speakerTitle": "Manou"
				},
				{
					"id": 752650106,
					"content": "ถึงจะถูกกว่าเยอะ แต่รู้สึกว่าสีของตุ๊กตาพวกนี้ดูแปลก ๆ คงไม่ใช่ว่าเป็นของปลอมหรอกนะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752650107,
					"content": "ของปลอม? คนอะไรไม่รู้จักของดี... ไปโน่นเลยไป!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650108
					],
					"speakerTitle": "Manou"
				},
				{
					"id": 752650108,
					"content": "ชิ่ว ๆ! ฉันไม่ขายให้พวกเธอแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manou"
				}
			]
		},
