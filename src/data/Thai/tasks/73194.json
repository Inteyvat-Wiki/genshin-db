			},
			"dialogs": [
				{
					"id": 731940101,
					"content": "นี่คือกระดานข่าวสารที่จัดทำโดยเจ้าหน้าที่สถาบัน เรื่องสำคัญต่าง ๆ ภายในเมือง Sumeru จะถูกประกาศไว้ที่นี่ หากมีข้อสงสัยใด ๆ สามารถฝากข้อความไว้ที่นี่ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "กระดานข่าวสาร"
				}
			]
		},
		{
			"id": 7319402,
			"completionStepIds": [
				7319402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319402",
							"2"
						],
						"stepId": 7319402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940201,
					"content": "\"รู้เรื่องนั้นหรือยัง? ได้ยินเจ้าหน้าที่พิทักษ์ป่าพูดกันว่า ไม่รู้ว่ามีวังสวย ๆ มาสร้างในป่าทางทิศเหนือตั้งแต่เมื่อไหร่\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940202
					],
					"speakerTitle": "กระดานข่าวสาร"
				},
				{
					"id": 731940202,
					"content": "\"แต่ดูเหมือนว่าคนที่เคยไปที่นั่น สุดท้ายต่างก็ถูกหลอกจนหมดตัวกันทั้งนั้น ตอนที่ถูกเจ้าหน้าที่พิทักษ์ป่าพบตัว ก็สวมแค่กางเกงในตัวเดียว\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940203
					],
					"speakerTitle": "กระดานข่าวสาร"
				},
				{
					"id": 731940203,
					"content": "\"พอถามพวกเขาว่าเกิดอะไรขึ้น ก็ไม่ยอมตอบ เอาแต่ร้องไห้อย่างเดียว น่ากลัวจริง ๆ เลย\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940204
					],
					"speakerTitle": "กระดานข่าวสาร"
				},
				{
					"id": 731940204,
					"content": "\"ทุกคนอย่าเที่ยวเดินเตร่ซี้ซั้วในป่าล่ะ\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "กระดานข่าวสาร"
				}
			]
		},
		{
			"id": 7319403,
			"completionStepIds": [
				7319403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
