					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020125,
						102020126
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102020127,
					"content": "ถึงเวลาพี่เองก็ต้องมาด้วยนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020128
