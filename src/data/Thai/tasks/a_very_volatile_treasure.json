					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020411
					]
				},
				{
					"id": 102020411,
					"content": "รอให้ถึง Ludi Harpastum ก่อนเถอะ อื้อ! ทุกคนจะต้องชอบแน่!",
					"roleType": "TALK_ROLE_NPC",
