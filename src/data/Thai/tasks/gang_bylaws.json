				},
				{
					"id": 191431102,
					"content": "ขะ...เข้าใจแล้ว พวกเราวิ่งไม่ไหวแล้วจริง ๆ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431103
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 191431103,
					"content": "ตอนนี้วิ่งไม่ไหว แต่พอหายเหนื่อยแล้ว คงไม่คิดหนีอีกหรอกนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431104
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
