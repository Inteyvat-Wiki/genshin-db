					"nextDialogs": [
						80010333
					]
				},
				{
					"id": 80010324,
					"content": "(Dain และ Khaenri'ah... ลองวัดดูสักตั้งก็แล้วกัน)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
