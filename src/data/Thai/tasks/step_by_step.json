					"Doolan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200470101,
					"content": "การผจญภัยนั้นไม่มีทางเป็นไปตามแผนได้อย่างสมบูรณ์! ถ้ามัวแต่รีรอ แล้วเมื่อไหร่จะไปต่อข้างหน้าได้?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470102
					],
					"speakerTitle": "Patchi สาวขี้สงสัย"
				},
				{
					"id": 200470102,
					"content": "ถึงจะพูดว่าไม่มีแผนที่สมบูรณ์แบบ แต่ก็ยังต้องเตรียมตัวให้พร้อม!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470103
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470103,
					"content": "พวกเธอเถียงอะไรกันอยู่น่ะ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200470104
					]
				},
				{
					"id": 200470104,
					"content": "โอ้ พวกเราอยากจะไปทำการสำรวจที่ <color=#00E1FFFF>Thousand Winds Temple</color> อย่างละเอียด แต่ว่าคุณ Patchi นั้นไม่มีประสบการณ์การผจญภัยเลย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470105
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470105,
					"content": "ช่วงนี้ข้างในวิหารก็เต็มไปด้วยมอนสเตอร์ดุร้าย แล้วยังมีพวก Ruin Guard ที่น่ากลัวนั่นอีก...ถ้ายังฝืนเข้าไปก็มีแต่จะทำให้ชีวิตของตัวเองนั้นตกอยู่ในอันตราย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470106
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470106,
					"content": "เพื่อที่จะปกป้อง Patchi... ไม่สิ เพื่อความปลอดภัยของพวกเรา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470107
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470107,
					"content": "ฉันกำลังเกลี้ยกล่อมเธอว่าให้คิดแผนการผจญภัยให้ดีก่อน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470108
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470108,
					"content": "ถ้าสมมุติว่าฉันไปเดินสำรวจดูรอบ ๆ ไม่แน่ Patchi อาจจะตื่นเต้นรีบพุ่งเข้าไปเลยก็ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470109
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470109,
					"content": "ฉันต้องคอยดูเธอให้ดี ช่วยฉันไปสำรวจดูสถานที่รอบ ๆ หน่อยได้มั้ย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470110,
						200470113
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470110,
					"content": "ฉันรู้แล้ว",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200470111
					]
				},
				{
					"id": 200470111,
					"content": "เยี่ยมไปเลย ช่วยดูให้ละเอียดหน่อยนะ สิ่งเล็กๆน้อย ๆ ก็สามารถทำให้การผจญภัยล้มเหลวได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470112
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470112,
					"content": "ไม่ว่าจะเจออะไร ช่วยเก็บมาให้ฉันหน่อยแล้วกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470113,
					"content": "งั้นฉันขออยู่เฝ้า Patchi แทนได้มั้ย...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200470114
					]
				},
				{
					"id": 200470114,
					"content": "ไม่ ไม่ได้! แผนการนั้นยังมีรายละเอียดอีกเยอะมาก ฉันจะต้องทบทวนกับเธออีกครั้ง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470115
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470115,
					"content": "เธอช่วยเร่งมือทำการสำรวจหน่อยนะ ขอร้องล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Doolan"
				}
			]
		},
