			"dialogs": [
				{
					"id": 733560201,
					"content": "ต่างคนต่างมีทางที่ต้องเดิน ไม่ต้องพูดอะไรมากแล้วล่ะ อ้อ ชานี่ก็ไม่เลวนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560202,
						733560203
					],
					"speakerTitle": "สมหมวก"
				},
				{
					"id": 733560202,
					"content": "(ขอนั่งแบบนี้อีกสักพักละกัน)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560204
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 733560204,
					"content": "ได้สิ แล้วเจอกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "สมหมวก"
				},
				{
