					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400701705,
					"content": "...หึ มากันได้แล้วเหรอ เจ้าพวกข้ารับใช้ผู้โง่เขลาทั้งหลาย",
					"roleType": "TALK_ROLE_NPC",
