				"points": []
			},
			"dialogs": [
				{
					"id": 400701001,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701002
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701002,
					"content": "ในที่สุด ก็ถึงเวลานี้ซะที",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701003
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701003,
					"content": "ทุกคน... ฉันเคยอธิษฐานไว้ว่า อยากจัดงานคอนเสิร์ตกับคนที่ทุกคนคาดไม่ถึงไว้ แล้ววันนี้ ฉันก็พบคำตอบนั้นที่เกาะกลางทะเลแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701004
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701004,
					"content": "ชายผู้ทำให้เกาะแห่งนี้กลายเป็นเครื่องดนตรีขนาดยักษ์เมื่อหลายปีก่อน ไม่มีใครรู้จักชื่อหรือหน้าตาของเขา แต่เขาคือหนึ่งในนักดนตรีที่ยิ่งใหญ่ที่สุดของ Teyvat อย่างแน่นอน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701005
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701005,
					"content": "ฉันไม่เคยคิดว่าจะได้พบกับเครื่องดนตรีแบบนี้เลย ยิ่งคิดไม่ถึงด้วยว่า พวกเราจะสามารถบรรเลงมันตามจังหวะสายน้ำขึ้นน้ำลง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701006
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701006,
					"content": "จะแสดงดนตรีร็อกแอนด์โรลแล้วเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400701007
					]
				},
				{
					"id": 400701007,
					"content": "เปล่า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701008
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701008,
					"content": "ดนตรีคือของขวัญที่มอบให้แก่คนที่รู้ใจ เพราะฉะนั้น... ฉันจะเลือกวิธีการเล่นที่เหมาะกับการร่วมบรรเลงเพลงด้วยกันกับชาวพื้นเมืองคนนี้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701009
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701009,
					"content": "วันนี้ไม่เล่นดนตรีร็อกแอนด์โรล แต่จะแสดงทีเด็ดใหม่ ๆ ให้ทุกคนดู!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701010
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701010,
					"content": "...ฟู่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701011
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701011,
					"content": "เป็นยังไงบ้าง? การแสดงของฉันไม่เลวเลยใช่มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701012
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701012,
					"content": "เยี่ยมมาก ๆ เลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701013
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701013,
					"content": "ไม่เคยฟังการบรรเลงร่วมกันแบบนี้มาก่อนเลย สนุกมากละ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701014
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400701014,
					"content": "แถมยังดูเลิศเลอสุด ๆ อีกด้วย! ฉันไม่รู้จะพูดยังไง... คือว่ามันแจ่มแมวมากเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701015,
						400701016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400701015,
					"content": "เป็นการแสดงที่บ่งบอกตัวตนได้ดีมาก",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400701017
					]
				},
				{
					"id": 400701017,
					"content": "ฮิฮิ ขอบคุณมากนะทุกคน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701018
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701018,
					"content": "ถ้าอย่างนี้ ความปรารถนาของฉันก็ถือว่าสำเร็จแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701019
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701019,
					"content": "ยังมีเรื่องอะไรที่อยากทำอีกมั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701020
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701020,
					"content": "ไม่มีแล้วล่ะ คืนนี้คงได้นอนหลับฝันดีแน่เลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701021
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701021,
					"content": "งั้นตอนนี้ทุกคนคงว่างกันแล้วสินะ? ฉันมีข้อเสนอน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701022
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400701022,
					"content": "ฉันอยากไปยืนยันสถานการณ์ที่ค่าย Fatui อีกสักครั้ง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701023
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400701023,
					"content": "หื้อ? ที่แท้พวกเธอก็พบค่ายของ Fatui ด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701024
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701024,
					"content": "เดี๋ยวนะ เธอก็รู้หรอกเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701025
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400701025,
					"content": "ฉันเป็นถึงโหรแห่งดวงดาวนะ แล้วฉันไม่ได้บอกหรอกเหรอว่า กระจกส่องดาวฟื้นฟูกลับมาได้นิดหน่อยแล้ว? ฉันเลยพอจะทำนายได้ถึงสถานการณ์ที่นี่ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701026
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701026,
					"content": "เอ๊ะ ที่นี่ก็มีพวก Fatui ด้วย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701027
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701027,
					"content": "ใช่แล้ว วันนี้ตอนแยกกับ Fischl ฉันก็ได้บอกเรื่องนี้กับเธอด้วย เผื่อว่าพบพวก Fatui เธอจะได้หลบซ่อนตัวโดยไม่ต้องเสี่ยงอันตราย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701028
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701028,
					"content": "ที่แท้ก็เป็นแบบนี้ งั้นเรามาเปิดใจคุยกันตรง ๆ กันเถอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701029
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400701029,
					"content": "เล่าเรื่องที่พบค่าย Fatui กับเครื่องจักรประหลาดในวันที่ขึ้นเกาะวันนั้นให้คนอื่นฟังอย่างละเอียด...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400701030
					]
				},
				{
					"id": 400701030,
					"content": "เครื่องจักรประหลาด, Fatui ที่ดูไม่มีสติสตัง... ความหมายของพวกเธอคือ เรื่องเหล่านี้มีความเกี่ยวข้องกับมิติมายาในช่วงนี้?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701031
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701031,
					"content": "ยังไม่สามารถยืนยันได้หรอกนะ แต่ฉันคิดว่า ระหว่างสองอย่างนี้ไม่น่าจะไม่มีความเกี่ยวข้องกันเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701032
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400701032,
					"content": "มีเหตุผลนะ งั้นรีบไปดูที่แคมป์กันเถอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701016,
					"content": "เป็นการแสดงที่ได้อรรถรสมาก",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400701017
					]
				}
			]
		},
