			"dialogs": [
				{
					"id": 790000301,
					"content": "ฮือออ เปิดไม่ออก... ดูเหมือนว่าจะใส่รหัสไม่ถูกต้องนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000302
