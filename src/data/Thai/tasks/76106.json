					"Veroslava"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761060201,
					"content": "...อืม",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761060202
					]
				},
				{
					"id": 761060202,
					"content": "ฉันแค่เป็นห่วงน่ะ ถ้าไม่มีธุระอะไรก็อย่าเดินเข้าไปในสำนักงานออกแบบล่ะ โดยเฉพาะชั้น 2! ถ้าดูดซับแรงจันทราผันมากเกินไป... เบาสุดก็อาจเกิดอาการปวดหัว ถ้าร้ายแรงหน่อยก็อาจอาเจียน อย่าหาว่าฉันไม่เตือนก็แล้วกัน!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Veroslava"
				}
			]
		},
		{
			"id": 7610603,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Veroslava"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761060301,
					"content": "จริงเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761060302
					]
				},
				{
					"id": 761060302,
					"content": "แน่นอน! ทุกคนที่ทำงานในนี้จะได้รับแอปเปิลไซเดอร์ 1 แก้ว ลองคิดดูสิ ถ้ามันไม่ส่งผลกระทบต่อสุขภาพ มีเหรอจะได้ข้อเสนอดี ๆ แบบนี้?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761060303
					],
					"speakerTitle": "Veroslava"
				},
				{
					"id": 761060303,
					"content": "อีกอย่าง ก่อนหน้านี้ฉันเห็นที่ลูกหลานจันทราน้ำค้างแข็งกับตาของตัวเองมาแล้ว! บนหัวของพวกผู้ประกอบพิธีล้วนมีเขางอกออกมาจากบนหัวด้วยนะ เธอว่าแบบนี้มันปกติมั้ยล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761060304
					],
					"speakerTitle": "Veroslava"
				},
				{
					"id": 761060304,
					"content": "ที่แท้ก็เป็นอย่างนี้นี่เอง... ขอบคุณที่เตือนนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761060305
					]
				},
				{
					"id": 761060305,
					"content": "ฟังดูน่ากลัวจังเลย! ฉันจะ...จะกลายเป็นมอนสเตอร์ไปด้วยรึเปล่า?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761060306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761060306,
					"content": "เฮ้อ เอาแต่ส่งคนใหม่ ๆ มาทำงานอันตราย... พวกเธอก็ระวังตัวด้วยล่ะ อย่าอยู่ในนั้นนานเกินไปนัก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Veroslava"
				}
			]
		},
		{
			"id": 7610604,
			"completionStepIds": [
				7610601
			],
			"beginWay": "TALK_BEGIN_NONE",
