					"Iaune"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240190101,
					"content": "เท่านี้ก็น่าจะให้อาหารเสร็จแล้วล่ะ หวังว่าพวกมันจะอิ่มนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190102
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190102,
					"content": "เธอทำอะไรอยู่เหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190103
					]
				},
				{
					"id": 240190103,
					"content": "ฉันกำลังให้อาหารนกนางนวลสีม่วงทองพวกนี้อยู่ เธอดูสิ พวกมันน่าจะกินอิ่มแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190104
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190104,
					"content": "โว้ว... เธอกับนกนางนวลสีม่วงทองพวกนี้ไปสนิทกันตั้งแต่เมื่อไหร่?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240190105,
					"content": "พวกมันไม่แย่งมันฝรั่งทอดเธอกินแล้วเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190106
					]
				},
				{
					"id": 240190106,
					"content": "ไม่แล้วล่ะ ที่นี่มีคนมาให้อาหารมันโดยเฉพาะเป็นประจำ นกนางนวลสีม่วงทองฝูงนี้เลยไม่สนใจมันฝรั่งทอดของฉันเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190107
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190107,
					"content": "แต่ครั้งที่แล้วเธอบอกว่า ถ้าอยู่ไกลเกินไปก็จะกลับไปทำงานไม่ทันไม่ใช่เหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240190108,
					"content": "ฮ่าฮ่าฮ่า ไม่เป็นไรหรอก วันนี้เป็นวันหยุดของฉันน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190109
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190109,
					"content": "ที่นี่ไม่มีเพื่อนร่วมงานที่จะดึงฉันไปคุยเรื่องงาน และไม่มีคนหรือสัตว์มาแย่งมันฝรั่งทอดของฉัน... มันเหมาะกับการพักผ่อนจริง ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190110
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190110,
					"content": "แถมนกนางนวลสีม่วงทองที่นี่มันเป็นมิตรสุด ๆ เลย ไม่มาแย่งมันฝรั่งทอดของฉัน และไม่พุ่งมาโจมตีฉันด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190111
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190111,
					"content": "หลังจากที่ฉันให้อาหารพวกมันด้วยมือฉันเองหลายครั้ง ดูเหมือนว่านกนางนวลสีม่วงทองพวกนี้จะจำฉันได้แล้วล่ะ ต่อให้ฉันไปลูบขนพวกมัน พวกมันก็คงไม่ว่าอะไรหรอก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190112
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190112,
					"content": "ถ้าเทียบกับนกนางนวลสีม่วงทองฝูงที่อยู่แถวพระราชวัง Mermonia แล้ว เจ้าพวกนี้เรียกได้ว่าเป็นนกผู้ดีได้เลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190113
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190113,
					"content": "ถ้าพวกมันใช้กรงเล็บของมันพิมพ์งานได้ ก็คงจะเอามาทำงานแทนพวกเราได้เลยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190114,
						240190116
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190114,
					"content": "นกนางนวลสีม่วงทองมันไม่มาช่วยงานคนหรอกนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190115
					]
				},
				{
					"id": 240190115,
					"content": "แต่อย่างน้อยพวกนกนางนวลสีม่วงทองมันก็ไม่ทำให้เรื่องแย่ลงนะ อีกอย่างทุกคนก็รู้ดีว่า เรื่องบางเรื่องมันยากเกินไปสำหรับนกนางนวลสีม่วงทอง พวกมันทำไม่ได้หรอก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190118
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190118,
					"content": "อย่าเพิ่งพูดเรื่องนี้เลย เธออยากทำความรู้จักกับนกผู้ดีพวกนี้มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190119
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190119,
					"content": "ถึงขั้นเรียกพวกมันว่านกผู้ดีแล้วเหรอเนี่ย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190120,
						240190122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240190120,
					"content": "ถ้าฉันเดินดุ่ม ๆ เข้าไปหาพวกมันเลย แบบนี้จะเสียมารยาทรึเปล่า",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190121
					]
				},
				{
					"id": 240190121,
					"content": "ไม่หรอกน่า นกผู้ดีพวกนี้ใจดีมาก ขอแค่อย่าไปลูบขนพวกมันก็พอ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190124
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190124,
					"content": "มาสิ นี่คือเนื้อปลาที่ฉันทำขึ้นเป็นพิเศษ เธอเอาไปวางไว้ในชามก็พอแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190125
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190125,
					"content": "วางใจเถอะน่า นกนางนวลสีม่วงทองพวกนี้ใจดีสุด ๆ แค่เธอให้อาหาร พวกมันก็จะรู้สึกดีกับเธอ มันไม่ย้อนถามเธอหรอกว่าเนื้อปลาพวกนี้ได้มายังไง และปรุงแบบไหน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190122,
					"content": "เป็นเพื่อนกับนกนางนวลสีม่วงทองต้องระวังอะไรบ้าง?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190123
					]
				},
				{
					"id": 240190123,
					"content": "ไม่มีอะไรพิเศษหรอก ขอแค่อย่าไปลูบขนของพวกมันก็พอ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190124
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190116,
					"content": "นกนางนวลสีม่วงทองไม่เข้าใจภาษาคนนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190117
					]
				},
				{
					"id": 240190117,
					"content": "ไม่แน่หรอกนะ บางทีพวกมันอาจแกล้งทำเป็นไม่เข้าใจคำพูดมนุษย์ เพื่อจะได้มีชีวิตที่สบายขึ้น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190118
					],
					"speakerTitle": "Iaune"
				}
			]
		},
