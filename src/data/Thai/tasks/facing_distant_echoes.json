			"dialogs": [
				{
					"id": 726550201,
					"content": "ฮ่าฮ่า ที่นี่แหละ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550202
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550202,
					"content": "ที่แท้ที่นี่มีโบราณสถานใต้ดินด้วยเหรอเนี่ย... เฮือก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550203,
						726550204
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550203,
					"content": "เป็นอะไรเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726550205
					]
				},
				{
					"id": 726550205,
					"content": "มะ ไม่มีอะไรหรอก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550206
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550206,
					"content": "เอ๋ เธอดูไม่ค่อยสบายเลยนะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726550207,
					"content": "ฮ่าฮ่า ปกติฉันไม่ค่อยได้ลงจากเรือ พอมาเจอทางเข้าโบราณสถานที่อลังการแบบนี้ เลยรู้สึกหวั่น ๆ น่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550208
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550208,
					"content": "ที่นี่เนี่ยนะอลังการ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726550209,
					"content": "เอาเถอะ ออเดอร์ของนายหญิงยังไงต้องไปจัดการให้เสร็จ นักเดินทางเองก็คงสงสัยว่าในนั้นมีความลับอะไรซ่อนอยู่ใช่มั้ยล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550210
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550210,
					"content": "เพราะงั้น ขอเชิญให้นักเดินทางผู้มากประสบการณ์นำทางไปเลยเป็นไง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550211
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550211,
					"content": "ฉันหมดคำจะพูดแล้ว...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726550212
					]
				},
				{
					"id": 726550212,
					"content": "ฉันหมดคำจะพูดแล้ว... เราไปกันเถอะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726550204,
					"content": "เจออะไรบ้างมั้ย?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726550205
					]
				}
			]
		},
