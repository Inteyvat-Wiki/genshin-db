				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413340101,
					"content": "ต้องคิดหาวิธี...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340102
					],
					"speakerTitle": "เถ้าแก่ Zhu"
				},
				{
					"id": 413340102,
					"content": "หาวิธีทำอะไร?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413340103
					]
				},
				{
					"id": 413340103,
					"content": "อ๊ะ... นักเดินทาง เธอรู้ว่านี่คือช่วงเทศกาล Lantern Rite ใช่มั้ย? ฉันกำลังคิดหาวิธีทำให้กิจการของฉันดีขึ้นช่วงเทศกาลน่ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340104
					],
					"speakerTitle": "เถ้าแก่ Zhu"
				},
				{
					"id": 413340104,
					"content": "เธอดูสิ ที่นี่ทำเลดี วิวก็สวย ส่วนเรื่องอาหาร... เราก็มีไม่น้อยกว่าใคร",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340105
					],
					"speakerTitle": "เถ้าแก่ Zhu"
				},
				{
					"id": 413340105,
					"content": "พอในเมืองปล่อยโคม Mingxiao มานั่งชมวิว พร้อมดื่มเหล้าและทานอาหารดี ๆ ที่โรงแรมของฉัน มันต้องยอดเยี่ยมมากแน่ ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340106
					],
					"speakerTitle": "เถ้าแก่ Zhu"
				},
				{
					"id": 413340106,
					"content": "ฉันกะว่าจะใช้สิ่งนี้เป็นจุดขายเพื่อดึงดูดลูกค้า เธอคิดว่าไง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340107,
						413340108
					],
					"speakerTitle": "เถ้าแก่ Zhu"
				},
				{
					"id": 413340107,
					"content": "ตรงนี้เห็นโคม Mingxiao ได้ด้วยเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413340109
					]
				},
				{
					"id": 413340109,
					"content": "เอ่อ... น่าจะมองเห็นแหละน่า โคม Mingxiao ใหญ่ขนาดนั้น อย่างน้อยก็ต้องเห็นมันส่วนนึงแหละ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340110
					],
					"speakerTitle": "เถ้าแก่ Zhu"
				},
				{
					"id": 413340110,
					"content": "เรื่องนี้... ช่างมันเถอะน่า ถึงเวลาค่อยว่ากัน ฉันต้องจัดเตรียมโรงแรมซะก่อน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340111
					],
					"speakerTitle": "เถ้าแก่ Zhu"
				},
				{
					"id": 413340111,
					"content": "นักเดินทาง ฉันรบกวนเธอช่วยหาวัสดุทำโคม Xiao ให้ฉันทีได้มั้ย? ฉันอยากแขวนโคมไว้รอบ ๆ โรงแรม",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340112,
						413340113
					],
					"speakerTitle": "เถ้าแก่ Zhu"
				},
				{
					"id": 413340112,
					"content": "ฉันทำให้คุณเลยก็ได้นะ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413340114
					]
				},
				{
					"id": 413340114,
					"content": "ไม่เป็นไร แค่วัสดุก็พอแล้วล่ะ ทำโคมก็ยุ่งยากเหมือนกันนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340115
					],
					"speakerTitle": "เถ้าแก่ Zhu"
				},
				{
					"id": 413340115,
					"content": "พอเธอรวบรวมเสร็จแล้ว ก็เอาวัสดุไปให้ Dummy ได้เลยนะ เขาจะทำโคมเอง ในระหว่างนี้ฉันต้องไปจัดเตรียมงานอื่น...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340116
					],
					"speakerTitle": "เถ้าแก่ Zhu"
				},
				{
					"id": 413340116,
					"content": "แน่นอนว่าฉันไม่ให้เธอเหนื่อยฟรีหรอก พอลูกค้าเยอะขึ้น กิจการเริ่มไปได้สวย เดี๋ยวค่าตอบแทนก็ตามมาเองล่ะน่า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340117
					],
					"speakerTitle": "เถ้าแก่ Zhu"
				},
				{
					"id": 413340117,
					"content": "แล้วถ้าไม่มีลูกค้า...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413340118
					]
				},
				{
					"id": 413340118,
					"content": "เอ่อ... ต่อให้ไม่มีลูกค้า... ฉันก็ต้องเตรียมของตอบแทนให้เธอ ไม่ต้องห่วงหรอกน่า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340119
					],
					"speakerTitle": "เถ้าแก่ Zhu"
				},
				{
					"id": 413340119,
					"content": "ถึงยังไง พอจัดโรงแรมเสร็จ พวกลูกค้าก็น่าจะมาพอดี",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340120
					],
					"speakerTitle": "เถ้าแก่ Zhu"
				},
				{
					"id": 413340120,
					"content": "แค่ก... เธอเอาวัสดุให้ Dummy ก็พอแล้วล่ะ เดี๋ยวฉันจะดูสถานการณ์พรุ่งนี้ แล้วค่อยให้ค่าตอบแทนเธออีกที",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "เถ้าแก่ Zhu"
				},
				{
					"id": 413340113,
					"content": "ต้องการแค่วัสดุเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413340114
					]
				},
				{
					"id": 413340108,
					"content": "ที่นี่น่าจะมองไม่เห็นโคม Mingxiao นะ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413340109
					]
				}
			]
		},
