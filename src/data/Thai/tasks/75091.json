					"Qispi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750910101,
					"content": "หนึ่งเม็ด, สองเม็ด อื้ม สามเม็ด...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910102
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910102,
					"content": "หึหึ หนึ่งเม็ด... สองเม็ด",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910103
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910103,
					"content": "อุหวา ที่นี่มีชาวเผ่าประหลาดอยู่ด้วยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910104,
					"content": "ที่ประหลาดน่าจะเป็นพวกเธอชาวต่างแดนมากกว่านะ เหอะ ๆ นี่มันไม่ใช่สถานที่ที่ชาวต่างแดนควรจะเข้ามานะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910105
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910105,
					"content": "ที่นี่เป็นพื้นที่ต้องห้าม... หรือสถานที่ศักดิ์สิทธิ์อะไรแบบนั้นเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910106,
					"content": "ไม่ใช่หรอก ฉันแค่บังเอิญพบสถานที่แห่งขุมทรัพย์น่ะ ฮึ มาสิ พวกเธอสองคน เข้ามาใกล้ ๆ หน่อย เคยได้ยินหินพิเศษก้อนนี้รึเปล่า... มันคือ \"หินสมบัติ\" น่ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910107
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910107,
					"content": "สิ่งที่ดังออกมาก็เหมือนเสียงฮัมเบา ๆ ราวกับ เอ่อ ราวกับมีคนกำลังหายใจ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910108,
						750910110
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910108,
					"content": "เป็นหินนี่ก็ลำบากเหมือนกันนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910109
					]
				},
				{
					"id": 750910109,
					"content": "ก็แค่หายใจเท่านั้นเอง ลำบากอะไรกัน ไม่สิ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910112,
					"content": "หิน หินเองก็หายใจได้ด้วยเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910113,
					"content": "ไม่ใช่แค่หายใจได้เท่านั้นนะ ถ้าแนบหูลงไป ก็จะได้ยินเสียงจังหวะของมัน แล้วก็ได้ยินเสียงหินเสียดสีภายใต้พื้นผิวขรุขระนี่ด้วย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910114
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910114,
					"content": "ฮิฮิ ช่างเป็นเสียงที่ไพเราะจริง ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910115
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910115,
					"content": "อีกอย่าง อีกอย่างนะ แค่ป้อนหินเล็ก ๆ ให้มันกิน มันก็จะคายหินที่ดีกว่าและสวยกว่านี้ออกมาได้ด้วยนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910116
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910116,
					"content": "อ๊ะ น่าเหลือเชื่อมากเลยใช่มั้ยล่ะ เธอดูสิ อัญมณีพวกนี้ หนึ่งเม็ด, สองเม็ด...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910117
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910117,
					"content": "ที่แท้ตอนที่พวกเรามาเมื่อกี้ คุณกำลังนับอัญมณีพวกนี้อยู่สินะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910118,
					"content": "ใช่แล้วล่ะ อีกอย่าง ฉันรู้สึกได้ว่า \"หินสมบัติ\" นี้จะแข็งแกร่งขึ้นหลังจากกินหินต่าง ๆ เข้าไป...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910119
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910119,
					"content": "นี่ต้องเป็นปาฏิหาริย์ที่น่าทึ่งแน่นอนเลยล่ะ อ๊า \"หินสมบัติ\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910120,
						750910121
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910120,
					"content": "ฟังดูน่าสงสัยจัง...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910122
					]
				},
				{
					"id": 750910122,
					"content": "หึ หึหึ ฉันก็ไม่ได้กะให้คนต่างแดนอย่างพวกเธอจะเชื่ออยู่แล้ว ถ้าไม่ลองดู ก็ไม่มีใครเชื่อหรอก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910123
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910123,
					"content": "ฉันเองก็บังเอิญนำแร่ที่รวบรวมมาได้ไปวางไว้ข้าง ๆ \"หินสมบัติ\" ถึงได้รู้น่ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910124
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910124,
					"content": "จริงสิ ฉันจะให้พวกเธอลองดูละกัน! ลองดูแล้ว พวกเธอก็จะเชื่อเอง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910125
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910125,
					"content": "พอดีเลย มันกินหินแถวนี้ไปหมดแล้ว ต้องให้มันกินหินใหม่ ๆ สักหน่อยแล้วล่ะ...แต่ฉันไปหามาให้มันกินไม่ได้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910126
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910126,
					"content": "เอ๋ ทำไมล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910127,
					"content": "แน่นอนอยู่แล้ว! เพราะฉันต้องคอยเฝ้าดู \"หินสมบัติ\" ยังไงล่ะ! ถ้า ถ้ามันมุดลงไปใต้ดินในตอนที่ฉันจากไป แบบนั้นจะทำยังไงล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910128
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910128,
					"content": "ฉันเฝ้าอยู่ที่นี่มานานมากแล้ว... หินที่อยู่บนตัวก็เอาให้มันกินไปหมดแล้ว...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910129
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910129,
					"content": "พวกเธอ พวกเธอเอาหินใหม่ ๆ มาให้ฉันหน่อยสิ ฉันจะป้อนหินให้มันกิน เพื่อพิสูจน์ให้พวกเธอดูเอง!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910130
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910130,
					"content": "เอ่อ ฟังดูเหมือนคนโกหกเลยแฮะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910131,
					"content": "#ว่าไง {NICKNAME} จะลองดูหน่อยมั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910132,
					"content": "ยังไงก็แค่ก้อนหินละนะ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910133
					]
				},
				{
					"id": 750910133,
					"content": "ฮี่ฮี่ งั้นก็เลือกหินมาให้ฉันละกันนะ... \"หินสมบัติ\" จะต้องคายหินที่ดีกว่านี้ออกมาแน่นอนเลยล่ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910121,
					"content": "จริงเหรอ ดูเหมือนกำลังโกหกอยู่เลย...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910122
					]
				},
				{
					"id": 750910110,
					"content": "ฉันก็หายใจได้เหมือนกัน",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910111
					]
				},
				{
					"id": 750910111,
					"content": "นั่นน่ะสิ หายใจได้มันเจ๋งตรงไหนกัน... เดี๋ยวนะ เรากำลังพูดถึงอะไรกันอยู่เนี่ย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910112
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
