				]
			},
			"dialogs": [
				{
					"id": 760540101,
					"content": "เอ๋? Columbina ล่ะ? ทำไมไม่เห็นเธอเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540102,
					"content": "ฉันอยู่ทางนี้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540103
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540103,
					"content": "ว้าว! เธอขึ้นไปทำอะไรบนที่สูงขนาดนั้นน่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540104,
					"content": "ขึ้นมาสิ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540105
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540105,
					"content": "หืม? คราวนี้จะทำอะไรอีกล่ะเนี่ย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540106,
					"content": "ยังจำหินที่เราออกไปเก็บกันคราวก่อนได้มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540107
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540107,
					"content": "คราวก่อนเหรอ? อ๋อ หมายถึงแร่ที่พอซึมซับแรงจันทราผันเข้าไปแล้ว จะเรืองแสงได้นั่นสินะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540108,
					"content": "ใช่ หลังจากนั้นพวกภูตจันทราก็ไปเก็บมาเพิ่มอีก ฉันเลยเอาหินพวกนี้มาจัดการนิดหน่อย แล้วแบ่งออกคร่าว ๆ เป็นสองประเภทคือสีเข้มกับสีอ่อนน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540109
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540109,
					"content": "สีเข้มกับสีอ่อนเหรอ? ทำไมล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540110,
					"content": "ก็ต้องเอาไว้เล่น \"หมากจันทรา\" ไงล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540111
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540111,
					"content": "เอ๋? \"หมากจันทรา\"... คืออะไรน่ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540112,
					"content": "พวกเธอไม่เคยเล่นกันเหรอ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540113
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540113,
					"content": "ไม่เลย...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760540114
					]
				},
				{
					"id": 760540114,
					"content": "อย่างนั้นเหรอ... เมื่อก่อนตอนที่เห็นพวกเด็ก ๆ \"ลูกหลานจันทราน้ำค้างแข็ง\" ขีดเส้นตารางบนพื้น ฉันก็อยากจะลองเล่นดูบ้าง แต่ว่าไม่มีใครเล่นเป็นเพื่อนฉันเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540115
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540115,
					"content": "แล้วกฎกติกาเป็นยังไงเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540116,
					"content": "อืม... อธิบายแบบนี้น่าจะเข้าใจง่ายกว่า...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540117
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540117,
					"content": "โอ้! สะ...สุดยอด... เธอทำได้ยังไงน่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540118,
					"content": "หืม? ก็แค่ใช้แรงจันทราผันง่าย ๆ เท่านั้นเอง พวกเธอทำไม่ได้เหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540119
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540119,
					"content": "อย่าเอามาตรฐานของเทพเจ้ามาใช้กับพวกเราสิ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540120,
					"content": "ก็ได้ นี่คือกระดานหมาก มันคือ \"นภาราตรี\" ของเกมนี้ ส่วนตัวหมากในมือของทั้งสองคน ก็เปรียบเสมือน \"ดวงจันทร์\" ที่แต่ละคนมีอยู่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540121
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540121,
					"content": "ทั้งสองคนจะต้องผลัดกันวาง \"ดวงจันทร์\" ลงบน \"นภาราตรี\" ใครที่วางดวงจันทร์สามดวง เรียงต่อกันเป็นเส้นตรงได้ก่อน ก็จะเป็นฝ่ายชนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540122
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540122,
					"content": "อ๋อ! สรุปก็คือเกมเรียงหมากสามตัว ให้เป็นแถวเดียวกันสินะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540123,
					"content": "ที่ Nod-Krai เรียกเกมนี้ว่า \"หมากจันทรา\" นี่เอง... มีความเป็นเอกลักษณ์ของท้องถิ่นจริง ๆ ด้วยนะเนี่ย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540124,
					"content": "แต่ว่า \"ดวงจันทร์\" ก็มีการหมุนเวียนนะ บนท้องฟ้าไม่อาจมี \"ดวงจันทร์\" อยู่พร้อมกันเกินสามดวงได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540125
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540125,
					"content": "เพราะงั้นพอจำนวน \"ดวงจันทร์\" บน \"นภาราตรี\" มีถึงจำนวนที่กำหนด \"ดวงจันทร์\" ดวงแรกที่ถูกวางไว้ก็จะหายไป",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540126
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540126,
					"content": "กะ...ก็สมเหตุสมผลดีนะ... แถมยังทำให้เกมยากขึ้นอีกเยอะเลยด้วย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540127,
					"content": "อืม จะลองเล่นดูมั้ยล่ะ? ฉันเองก็เล่นเป็นครั้งแรกเหมือนกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540128
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540128,
					"content": "(ดูท่าทางเธอจะคาดหวังน่าดูเลยนะ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760540129
					]
				},
				{
					"id": 760540129,
					"content": "แหะ ๆ งั้นฉันจะเป็นกรรมการให้พวกเธอเอง เจ้านี่หัวดีไม่เบาเลยนะ เธอต้องระวังให้ดีล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540130,
					"content": "ได้เลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Damselette"
				}
			]
		},
