			"dialogs": [
				{
					"id": 731960101,
					"content": "นี่คือกระดานข่าวสารที่ศูนย์แลกเปลี่ยน Kalimi จัดทำขึ้น เพื่อให้ผู้แลกเปลี่ยนทั้งในและนอกประเทศใช้ประกาศแจ้งข่าวสารทางธุรกิจโดยเฉพาะ เพราะฉะนั้นห้ามปิดประกาศข่าวสารอื่น ๆ ที่ไม่เกี่ยวข้อง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "กระดานข่าวสาร"
				}
			]
		},
		{
			"id": 7319602,
			"completionStepIds": [
				7319602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
