			"dialogs": [
				{
					"id": 731960401,
					"content": "ธนาคารของเราจะเปิดสำนักงานที่ Sumeru เร็ว ๆ นี้ ลูกค้าทุกท่านโปรดรอติดตาม!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960402
					],
					"speakerTitle": "กระดานข่าวสาร"
				},
				{
					"id": 731960402,
					"content": "หากต้องการดำเนินการทางธุรกิจ กรุณาติดต่อ Victor เพื่อดำเนินการที่สาขา Liyue!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960403
					],
					"speakerTitle": "กระดานข่าวสาร"
				},
				{
					"id": 731960403,
					"content": "หากคุณต้องการกู้ยืม เชิญเข้ามาพูดคุยรายละเอียดกับเจ้าหน้าที่สินเชื่อได้เลย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "กระดานข่าวสาร"
				}
			]
