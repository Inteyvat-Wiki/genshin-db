					"Hanayama Kaoru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721270101,
					"content": "เธอมาแล้ว เธอสังเกตบริเวณรอบ ๆ ดอกไม้เริ่มบานเยอะแล้ว เป็นอย่างไร สวยไหม?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270102,
						721270104
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270102,
					"content": "สวยมากๆ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721270103
					]
				},
				{
					"id": 721270103,
					"content": "ฮี่ๆ... แน่นอนอยู่แล้ว ฉันดูแลพวกมันอย่างระมัดระวัง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270106
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270106,
					"content": "ใช่แล้ว เธอช่วยฉันหน่อยได้ไหม? ตอนนี้ดอกไม้บานดีมากๆ เดิมทีฉันอยากเก็บดอกไม้ไปทำเป็นดอกไม้แห้ง ส่งไปพร้อมกับจดหมายไปให้แก่คนที่ไม่ได้กลับ Tatarasuna",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270107
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270107,
					"content": "แต่ว่า... ไม่รู้ว่าฉันนอนน้อยไปไหม เมื่อกี้ออกไปเก็บดอกไม้ไม่กี่ดอกก็เหนื่อยแล้ว...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270108
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270108,
					"content": "ขอร้องให้เธอช่วยฉันเก็บ Sweet Flower มาได้ไหม? แค่สามดอกก็ได้แล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270109,
						721270111
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270109,
					"content": "ฉันรู้แล้ว",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721270110
					]
				},
				{
					"id": 721270110,
					"content": "อย่างนั้นก็รบกวนเธอแล้ว ฉันจะพักที่นี่สักหน่อย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270112
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270112,
					"content": "ฉันแค่ต้องการกลิ่นดอกไม้ที่ดึงดูดคนของ Sweet Flower ส่วนดอกไม้แห้งอื่น ๆ ก็เอาไปติดในจดหมายด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270113
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270113,
					"content": "ฉันว่า ถ้าคนที่อ่านจดหมายฉบับนี้ได้กลิ่นหอมของ Sweet Flower ล่ะก็ บางทีอาจจะอารมณ์ดีขึ้นก็ได้นะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270114
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270114,
					"content": "งั้นช่วยหน่อยนะ ฉันพักที่นี่สักหน่อย...หลังเธอเก็บดอกไม้มาแล้ว ก็เอากลับมาให้ฉันละกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270111,
					"content": "Sweet Flower พบเห็นได้ทุกที่...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721270112
					]
				},
				{
					"id": 721270104,
					"content": "เธอปลูกนานแค่ไหนกันล่ะ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721270105
					]
				},
				{
					"id": 721270105,
					"content": "ไม่นานมากล่ะ กะ... ก็แค่นอนน้อยลงไปหน่อยแค่นั้นแหละ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270106
					],
					"speakerTitle": "Hanayama Kaoru"
				}
			]
		},
