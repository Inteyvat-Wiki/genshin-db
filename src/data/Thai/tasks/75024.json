							-2032.248,
							74.7,
							8496.88
						],
						"pointId": 9621
					}
				]
			},
			"dialogs": [
				{
					"id": 750240201,
					"content": "\"...วันนี้ฝนตก เตรียม <color=#00E1FFFF>Sour Sauce Ceviche</color> ที่ Ripple ชอบไว้ให้มันแล้ว แค่ได้เห็นมันมีความสุข ทุกอย่างก็คุ้มค่าแล้วล่ะ...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240202
					],
					"speakerTitle": "ไดอารี่ของใครบางคน"
				},
				{
					"id": 750240202,
					"content": "\"...แม้ว่าตอนแรกมันจะเอาแต่ว่ายน้ำไปเรื่อยเปื่อย แต่พอเอา <color=#00E1FFFF>Sour Sauce Ceviche</color> ออกมา มันก็จะกระโดดออกมาจากน้ำ เส้นโค้งนั่นสมบูรณ์แบบเลยล่ะ!...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240203
					],
					"speakerTitle": "ไดอารี่ของใครบางคน"
				},
				{
					"id": 750240203,
					"content": "\"...ฉันไม่สงสัยในความรักที่มันมีให้ฉันหรอกนะ แต่แค่กังวลว่า มันรัก <color=#00E1FFFF>Sour Sauce Ceviche</color> มากกว่าฉันรึเปล่า...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240204
					],
					"speakerTitle": "ไดอารี่ของใครบางคน"
				},
				{
					"id": 750240204,
					"content": "Ripple... หมายถึง Koholasaurus สินะ หม้อในแคมป์ก็กำลังปรุง Sour Sauce Ceviche อยู่เหมือนกัน ต้องเตรียมไว้ให้มันแน่เลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240205,
					"content": "\"...ดวงตากลม ๆ หางม้วน ๆ เสียงร้องอันร่าเริงมีชีวิตชีวา... เจ้า Jade เอ๋ย เจ้า Jade บนโลกใบนี้ยังจะมี Saurian ตัวไหนที่น่ารักกว่าแกอีกเหรอ...?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240206
					],
					"speakerTitle": "ไดอารี่ของใครบางคน"
				},
				{
					"id": 750240206,
					"content": "\"...ไม่เคยถูกหลอก แล้วก็ไม่รู้จักการสงสัย ดูเหมือนจะสามารถเป็นเพื่อนกับสิ่งมีชีวิตทั้งหมดในโลกนี้ และแบ่งปันความสุขในการเล่นสนุกได้...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240207
					],
					"speakerTitle": "ไดอารี่ของใครบางคน"
				},
				{
					"id": 750240207,
					"content": "\"...ถ้าไม่ใช่เพราะยุ่งมาก ฉันเองก็อยากจะเล่นกับแกทั้งวันทั้งคืน มองดูแกเดินผ่านป่าที่เต็มไปด้วยแสงแดดราวกับบุตรแห่งสายลม ราวกับภูตที่ไร้กังวล!...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240208
					],
					"speakerTitle": "ไดอารี่ของใครบางคน"
				},
				{
					"id": 750240208,
					"content": "#อืม ดูเหมือน Yumkasaurus ตัวนั้นจะชื่อว่าเจ้า Jade นะ แถมยังเป็น Saurian ที่ชอบเล่นสนุกด้วย ไม่แน่ {REALNAME[ID(2)|SHOWHOST(true)]} อาจจะเป็นเพื่อนกับมันได้ก็ได้นะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240209,
					"content": "กี้!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240210
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750240210,
					"content": "\"...ฉันเดินทางข้ามเนินเขาและหุบเขา เพียงเพื่อตามหาร่องรอยของแก ถ้าแกไม่อยากเจอฉันอีกแล้ว ก็จงจากไปซะเถอะ...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240211
					],
					"speakerTitle": "ไดอารี่ของใครบางคน"
				},
				{
					"id": 750240211,
					"content": "\"...แต่แกกลับดูแลฉันเป็นอย่างดี เดิน ๆ หยุด ๆ แถมยังเก็บ Grainfruit มากมาย แล้วก็หินที่แวววาวพวกนั้นมาให้ฉันด้วย...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240212
					],
					"speakerTitle": "ไดอารี่ของใครบางคน"
				},
				{
					"id": 750240212,
					"content": "\"...เจ้า Marigold ที่รักของฉัน มีแค่ฉันเท่านั้นที่รู้ว่า ภายใต้เปลือกแข็งที่ห่อหุ้มนั้นคือหัวใจที่อ่อนโยนช่างเอาใจใส่ การต่อสู้อย่างกล้าหาญ ไม่ใช่ความตั้งใจเดิมของแก...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240213
					],
					"speakerTitle": "ไดอารี่ของใครบางคน"
				},
				{
					"id": 750240213,
					"content": "เอ่อ... เจ้า Marigold คงไม่ได้หมายถึง Tepetlisaurus ที่อารมณ์ร้อนนั่นหรอกใช่มั้ย? ท่าทางที่ดุร้ายโหดเหี้ยม แถมยังชอบวิ่งชนคน จะมีความอ่อนโยนและเอาใจใส่อะไรได้!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240214,
					"content": "จะว่าไปแล้ว อันที่จริงแล้ว Saurian ทั้งสามตัวนี้เป็น... เพื่อนของเขางั้นเหรอ? แล้วเป็นเพราะอะไรกันแน่ ถึงซัดเขาจนสลบ แล้วก็ล้อมเอาไว้แบบนี้ล่ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240215,
					"content": "รีบช่วยเขาออกมาก่อน แล้วค่อยถามเถอะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240216
					]
				},
				{
					"id": 750240216,
					"content": "จะว่าไปก็จริงนะ ถ้ามีวิธีที่จะทำให้ Saurian หลีกทางได้ก็คงจะดี... จริงสิ ในบันทึกบอกว่า Ripple ชอบกิน Sour Sauce Ceviche ไม่ใช่เหรอ? ในแคมป์มีอยู่พอดี ไม่แน่อาจจะล่อมันออกไปได้นะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240217,
						750240219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240217,
					"content": "#ให้ {REALNAME[ID(2)|SHOWHOST(true)]} กับเจ้า Jade เป็นเพื่อนกัน?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240218
					]
				},
				{
					"id": 750240218,
					"content": "#อื้ม! เจ้า Jade ขี้เล่นมาก แค่ {REALNAME[ID(2)|SHOWHOST(true)]} พามันไปเล่นข้าง ๆ ก็น่าจะได้แล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240221,
					"content": "กี้! กี้กี้!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240222
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750240222,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} เองก็ฮึกเหิมมากเลยนะเนี่ย! แต่ว่าพวกเรามาลองวิธีที่ง่ายที่สุดกันก่อนดีกว่า ถ้าไม่กิน Sour Sauce Ceviche ก็เสียเปล่าน่ะสิ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240219,
					"content": "มาดวลกับเจ้า Marigold กันเถอะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240220
					]
				},
				{
					"id": 750240220,
					"content": "#ลองใช้วิธีสันติก่อนดีกว่า! อย่างเช่นให้ {REALNAME[ID(2)|SHOWHOST(true)]} ล่อเจ้า Jade ที่ห่วงเล่นออกไป...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240221
					],
					"speakerTitle": "Paimon"
				}
			]
		},
