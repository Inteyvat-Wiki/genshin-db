			},
			"dialogs": [
				{
					"id": 741920201,
					"content": "ฮือฮือ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920202
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920202,
					"content": "Canotila...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920203
					]
				},
				{
					"id": 741920203,
					"content": "#เอ๋? {M#พี่ชาย}{F#พี่สาว}... พี่เป็นใครน่ะ? ฉันนึกว่า นอกจากฉันแล้วจะไม่มีใครเข้ามาที่นี่ได้ซะอีก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920204
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920204,
					"content": "ทำไมพี่ถึงรู้จักชื่อของฉันล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920205,
						741920207
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920205,
					"content": "พวกเรารู้จักกันนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920206
					]
				},
				{
					"id": 741920206,
					"content": "โกหก! พี่ต้องเหมือนกับพวกมอนสเตอร์พวกนั้นแน่ ๆ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920207,
					"content": "(โกหก) Serene บอกให้ฉันมาหาเธอน่ะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920208
					]
				},
				{
					"id": 741920208,
					"content": "จริงด้วย... ทำให้เธอต้องเป็นห่วงแบบนี้ตลอดเลย ฉันนี่เป็นเด็กที่แย่จริง ๆ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920209
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920209,
					"content": "#ฉันชื่อ {NICKNAME} เธอยังจำได้มั้ย?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920210
					]
				},
				{
					"id": 741920210,
					"content": "#พี่ {NICKNAME} ฉันจำได้แล้วล่ะ... ถึงจะเป็นมอนสเตอร์ตัวใหญ่ที่กลืนโลกทั้งใบได้ในคำเดียว แต่ก็ใจดีมากเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920211,
						741920213
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920211,
					"content": "ไม่มีมารยาทเอาซะเลย",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920212
					]
				},
				{
					"id": 741920212,
					"content": "ขอโทษด้วยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920214
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920214,
					"content": "เกิดเรื่องอะไรขึ้นงั้นเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920215
					]
				},
				{
					"id": 741920215,
					"content": "ฉันเห็นคนหลายคนค่อย ๆ ละลายและกลายเป็นมอนสเตอร์...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920216
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920216,
					"content": "ฮืออ น่ากลัวจังเลย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920213,
					"content": "ขอบคุณนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920214
					]
				}
			]
		},
