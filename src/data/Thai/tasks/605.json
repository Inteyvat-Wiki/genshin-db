			"dialogs": [
				{
					"id": 6051101,
					"content": "#คุณ Albedo! {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6051102
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 6051102,
					"content": "ทุกอย่างน่าจะเรียบร้อยดีแล้วนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6051103
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 6051103,
					"content": "อื้ม! เมื่อกี้มีมอนสเตอร์หลุดเข้าไปในเมือง แต่ฉันกับนายท่าน Diluc และคุณ Kaeya ช่วยกันขับไล่พวกมันออกไปแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6051104
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 6059901,
					"content": "ก่อนหน้านี้ไม่นาน...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
