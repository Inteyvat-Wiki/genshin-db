				},
				{
					"id": 110320245,
					"content": "สู้ ๆ นะ! รุ่นพี่ Ganyu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320246
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320246,
					"content": "เห้ เห้! จะไปทั้งอย่างนี้เลยเหรอ Paimon ยังไม่อิ่มเลยนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
