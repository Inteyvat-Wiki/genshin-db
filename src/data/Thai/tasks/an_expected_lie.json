					"nextDialogs": [
						741361103
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361103,
					"content": "หวาา! คุณ Choiseul จะเป็นลมจริง ๆ ด้วย!",
					"roleType": "TALK_ROLE_NPC",
