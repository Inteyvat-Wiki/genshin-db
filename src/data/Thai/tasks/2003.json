		{
			"id": 200304,
			"completionStepIds": [
				200304
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200304",
							"2"
						],
						"stepId": 200304,
						"stateName": "QUEST_STATE_UNFINISHED"
