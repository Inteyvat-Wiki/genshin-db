				"points": []
			},
			"dialogs": [
				{
					"id": 726590101,
					"content": "\"Lunar Leviathan\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590102
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726590102,
					"content": "\"Lunar Leviathan\" อะไรเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726590103
					]
				},
				{
					"id": 726590103,
					"content": "อ่า สวัสดี! เธอคือ...นักตกปลาที่มาจากกิลด์นักผจญภัยคนนั้นใช่มั้ย? ฉัน Kujirai Momiji เป็นนักตกปลาของ Inazuma น่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590104
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726590104,
					"content": "ฉันได้ยินเรื่องราวของเธอมาจากสมาคมตกปลา พอได้มาเจอกันวันนี้ เธอยังดูเด็กอยู่เลยนะเนี่ย หวังว่าฉันจะไม่ได้ทักคนผิดนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590105
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726590105,
					"content": "ช่วงนี้ฉันกำลังตามหาปลายักษ์ในตำนานที่ชื่อ \"Lunar Leviathan\" อยู่น่ะ ตำนานบอกไว้ว่า มันสามารถทำให้ความปรารถนาเป็นจริงได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590106
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726590106,
					"content": "อุว้าว...ปลายักษ์ที่ทำให้ความปรารถนาเป็นจริงได้งั้นเหรอ! ฉันชอบเรื่องเล่าในตำนานแบบนี้!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726590107,
					"content": "อื้ม ถึงแม้ทุกคนจะมองว่าเป็นแค่เรื่องเล่า แต่...ฉันเชื่อว่ามันเป็นเรื่องจริง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590108
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726590108,
					"content": "เพราะเมื่อหลายปีก่อน ฉันเหมือนจะเคยเจอกับ \"Lunar Leviathan\" จริง ๆ นะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590109
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726590109,
					"content": "แล้วมันทำให้ความปรารถนาของคุณเป็นจริงรึเปล่า?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726590110
					]
				},
				{
					"id": 726590110,
					"content": "อื้ม...ก็ถือเป็นจริงอยู่นะ คือเรื่องมันเป็นอย่างงี้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590111
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726590111,
					"content": "เมื่อหลายปีก่อน เป็นเพราะต่างคนต่างมีความปรารถนาของตัวเอง ฉันกับเพื่อนอีกสองคน คนนึงชื่อ Jiawei กับอีกคนชื่อ Nantuck เลยออกทะเลไปด้วยกัน เพื่อตามหา \"Lunar Leviathan\" ในตำนาน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590112
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726590112,
					"content": "แต่การเดินทางนั้นไม่ราบรื่นนัก เราเจอกับพายุฝนเข้าให้ ถึงแม้เรือหาปลาของเราจะไม่เป็นอะไร แต่เข็มทิศกลับพังเสียหมด เราเลยหลงทางอยู่ในทะเลที่ไม่รู้จัก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590113
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726590113,
					"content": "หลายวันต่อมา เรายังคงหาทางกลับบ้านไม่ได้ และน้ำจืดก็ไม่มีแล้วด้วย ถึงแม้จะไม่มีใครพูดอะไร แต่ทุกคนก็เริ่มหมดหวังกันแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590114
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726590114,
					"content": "จนมีอยู่คืนหนึ่ง เจ้า Jiawei เขียนจดหมายลาตายใส่ลงในขวดแล้วโยนลงทะเลไป และเขาตั้งใจจะกระโจนตามไปด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590115
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726590115,
					"content": "เขาไม่รู้ว่าพวกเรายังไม่หลับ พอได้ยินเสียงเขาย่องออกไป เราก็เลยรีบไปคว้าตัวเขาเอาไว้ ในตอนนั้นเอง เราก็เห็นเงาขนาดใหญ่ลอยอยู่ใต้ทะเล",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590116
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726590116,
					"content": "เงานั่นเปล่งแสงประกายจาง ๆ ออกมา ราวกับว่ามีชิ้นส่วนของดวงจันทร์ตกลงไปในทะเล",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590117
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726590117,
					"content": "นั่นคือ \"Lunar Leviathan\" รึเปล่านะ? พวกเราที่ต่างก็หมดหวัง เลยรีบพากันอธิษฐานขอพร เพื่อขอให้มันช่วยคุ้มครองให้เรากลับบ้านโดยสวัสดิภาพ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590118
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726590118,
					"content": "ใช่แล้ว อย่างที่เธอคิดนั่นแหละ สุดท้ายพวกเราก็รอดมาได้ พอเงาที่ดูเหมือนจะมีพลังเวทมนตร์นั่นลอยออกไป เราก็ตามมันไปด้วย ซึ่งนั่นก็ทางกลับบ้านของเรายังไงล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590119
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726590119,
					"content": "อื้อหือ... เป็นเรื่องเล่าตำนานที่น่าตื่นเต้นสุด ๆ ไปเลย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726590120,
					"content": "ไม่นะ นี่คือเรื่องจริง! เชื่อฉันสิ เราจะต้องเจอมันอีกแน่ ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590121
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726590121,
					"content": "ทำยังไงเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726590122
					]
				},
				{
					"id": 726590122,
					"content": "ไปหาเพื่อนสองคนนั้นของฉันกันก่อนเถอะ พวกเขาเป็นนักตกปลาที่มากประสบการณ์ ถ้ามีพวกเขาอยู่ด้วยก็เบาใจขึ้นเยอะเลยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590123
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726590123,
					"content": "<color=#00E1FFFF>Jiawei อยู่ที่ Liyue</color> น่ะ ฉันได้ยินมาว่าหลังจากเขากลับมาที่ Liyue แล้วก็ไม่ไปไหนอีกเลย ฉันว่าเขาน่าจะคิดถึงเรื่อง \"Lunar Leviathan\" เหมือนกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590124
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726590124,
					"content": "ส่วน Nantuk น่ะ ฉันได้ยินแค่ว่าต่อมาเขากลายไปเป็นนักเขียนเกี่ยวกับทะเลน่ะ ไว้เธอเจอกับ Jiawei แล้วลองถามเขาดูแล้วกันว่า Nantuk อยู่ที่ไหน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kujirai Momiji"
				}
			]
		},
