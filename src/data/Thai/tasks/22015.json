				"points": []
			},
			"dialogs": [
				{
					"id": 220150701,
					"content": "ฉันเคยเจอ \"ที่ปรึกษาด้านกฎหมาย\" คนหนึ่ง...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150702
					]
				},
				{
					"id": 220150702,
					"content": "\"ที่ปรึกษาด้านกฎหมาย\"? อ๊ะ... ฉันเคยได้ยินมาเหมือนกัน คนแบบนี้น่ะ...รับมือได้ยากมาก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150703
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150703,
					"content": "ฉันว่า สิ่งที่คนแบบนี้ถนัดก็คือทำเรื่องง่ายให้เป็นเรื่องยาก และใช้แผนทำให้ปัญหาซับซ้อน จากนั้นก็เปลี่ยนเป็นสัญญาที่แสนสับสน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150704
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150704,
					"content": "ถ้าเป็นไปได้ล่ะก็ ฉันหวังว่าจะไม่เจอคนแบบนี้ตลอดไป",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				}
			]
		},
		{
			"id": 2201508,
			"completionStepIds": [
				2201501
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201501",
							"2"
						],
						"stepId": 2201501,
						"stateName": "QUEST_STATE_UNFINISHED"
