				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sango"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220150801,
					"content": "ดูจากท่าทางของเธอแล้ว เธอสนใจสำนักงานนักสืบงั้นเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150802,
						220150807
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150802,
					"content": "ฉันพอจะเป็นนักสืบได้มั้ย?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150803
					]
				},
				{
					"id": 220150803,
					"content": "เธออยากเป็นนักสืบ? มันเป็นงานที่น่าเบื่อนะ อย่าไปเชื่อนิยายนักสืบพวกนั้นเชียวล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150804
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150804,
					"content": "ตอนที่นักสืบกำลังสืบคดีน่ะ ไม่มีการต่อสู้ที่น่าตื่นเต้น และก็ไม่มีการตัดสินใจที่เกี่ยวกับความเป็นความตายด้วย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150805
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150805,
					"content": "เอกสารเต็มห้องไปหมด ถนนบนภูเขาที่เต็มไปด้วยโคลนและผู้ต้องสงสัยที่ไม่ทิ้งร่องรอย... นั่นต่างหากคืองานของนักสืบที่แท้จริง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150806
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150806,
					"content": "แต่พูดแบบนี้เธอก็คงจะไม่เข้าใจ... ฉันมีคดีเล็ก ๆ อยู่คดีนึง เธอลองมาสัมผัสงานนักสืบด้วยตัวเองดูมั้ยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150815
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150815,
					"content": "ผู้ช่วยของฉันชื่อว่า Ryuuji ก่อนหน้านี้เขาออกไปรวบรวมเบาะแสข้างนอก แต่จนป่านนี้ก็ยังไม่กลับมาเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150816
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150816,
					"content": "จนป่านนี้แล้ว เขาควรจะเก็บรวบรวมเบาะแสที่เพียงพอแล้วนี่นา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150817
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150817,
					"content": "ฉันอยากจะให้เธอช่วยพา Ryuuji กลับมาที",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150818,
						220150821
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150818,
					"content": "ไม่รู้ว่าไปเจออันตรายอะไรหรือเปล่า...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150819
					]
				},
				{
					"id": 220150819,
					"content": "ฉันบอกเขาไปหมดทุกอย่างแล้ว ไม่ว่าเขาจะเจอกับสถานการณ์ที่ไม่คาดคิดอะไร เขาก็น่าจะแก้ไขได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150820
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150820,
					"content": "สิ่งที่ฉันสนใจไปกว่านั้นก็คือ เขาจะสามารถหาสิ่งที่ฉันต้องการได้มั้ย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150826
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150826,
					"content": "ถ้างั้นเรื่องนี้ก็รบกวนเธอด้วยนะ ฉันจะเตรียมค่าตอบแทนไว้ให้ อีกอย่าง...เธอจะได้สัมผัสกับประสบการณ์การทำงานของนักสืบด้วยตัวเองด้วยไงล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150821,
					"content": "คงจะไม่เจอเรื่องที่ไม่คาดคิดอะไรหรอกนะ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150822
					]
				},
				{
					"id": 220150822,
					"content": "คงไม่เกิดเรื่องที่ไม่คาดคิดอะไรหรอก ฉันบอกเรื่องราวทั้งหมดกับเขาแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150823
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150823,
					"content": "ต่อให้เจอสถานการณ์ที่ไม่คาดคิดอะไร...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150824
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150824,
					"content": "ด้วยฝีมือของเขา น่าจะจัดการได้ล่ะนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150825
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150825,
					"content": "สิ่งที่ฉันสนใจไปกว่านั้นก็คือ เขาจะสามารถหาสิ่งที่ฉันต้องการได้มั้ย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150826
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150807,
					"content": "รู้สึกว่ายุ่งยากจัง...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150808
					]
				},
				{
					"id": 220150808,
					"content": "แน่นอนสิ แต่อาชีพนักสืบก็คือผู้เชี่ยวชาญใน \"จัดการปัญหา\" ให้คนอื่นยังไงล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150809
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150809,
					"content": "การไล่ล่าที่น่าตื่นเต้น การเดิมพันระหว่างความเป็นและความตาย... ล้วนเป็นสิ่งที่นิยายแต่งขึ้นมาทั้งนั้น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150810
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150810,
					"content": "เอกสารเต็มห้องไปหมด ถนนบนภูเขาที่เต็มไปด้วยโคลนและผู้ต้องสงสัยที่ไม่ทิ้งร่องรอย... นั่นต่างหากคืองานของนักสืบที่แท้จริง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150811
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150811,
					"content": "แต่มีสิ่งหนึ่งที่นิยายพูดถูก นั่นก็คือนักสืบมักจะมีผู้ช่วยหลากหลายรูปแบบ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150812
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150812,
					"content": "เพราะงั้นคุณเองก็มีผู้ช่วย?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150813
					]
				},
				{
					"id": 220150813,
					"content": "ก็ใช่น่ะสิ ผู้ช่วยของฉันกำลังยุ่งอยู่ที่ข้างนอก แล้วตอนนี้... ฉันก็กำลังต้องการผู้ช่วยอีกคนหนึ่ง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150814
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150814,
					"content": "ถ้าเธอยินดีล่ะก็ ช่วยฉันหน่อยได้มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150815
