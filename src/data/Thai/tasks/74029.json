				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740290301,
					"content": "Iara นำ Ball Octopus ที่อ่อนแอไปใส่ไว้ในถัง...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740290302
					]
				},
				{
					"id": 740290302,
					"content": "เป็นเทคนิคตกปลาที่งดงามจริง ๆ... แต่ตอนนี้เจ้าตัวนี้มันไม่สวยแล้ว ทำไมถึงเป็นแบบนี้ล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290303
					],
					"speakerTitle": "Iara"
				},
				{
					"id": 740290303,
					"content": "ขอโทษทีนะ... เราไม่รู้ว่า \"สิ่งนั้น\" ที่ Iara พูดถึงคือ Ball Octopus น่ะ พอเผลอนิดเดียวก็...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290304,
						740290306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740290304,
					"content": "จะโทษก็โทษฉันเถอะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740290305
					]
				},
				{
					"id": 740290305,
					"content": "#เพราะ {NICKNAME} ใจร้อนเกินไปน่ะสิ! แต่ฉันก็ผิดเองที่ไม่ได้ห้ามเธอ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740290308,
					"content": "#อาจารย์ {NICKNAME} กับอาจารย์ Paimon ไม่ต้องขอโทษหรอก ตอนนี้มันอยู่ในถังแล้ว เท่านี้ก็พอแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290309
					],
					"speakerTitle": "Iara"
				},
				{
					"id": 740290309,
					"content": "เอาเถอะ... ว่าแต่ทำไมที่นี่ถึงมี Ball Octopus ล่ะ? มันบังเอิญลอยตามกระแสน้ำมาถึงนี่เหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740290310,
					"content": "ฉันไปจับมันมาจากข้างนอกน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290311
					],
					"speakerTitle": "Iara"
				},
				{
					"id": 740290311,
					"content": "เอ๋?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740290312,
					"content": "เพราะฉันอยากทดสอบวิธีตกปลาด้วยคันเบ็ด... ก็เลยไปจับ \"สิ่งนั้น\" ที่พวกเธอเรียกว่า Ball Octopus มาไงล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290313
					],
					"speakerTitle": "Iara"
				},
				{
					"id": 740290313,
					"content": "พอเอามันมาไว้ที่นี่ ฉันก็จะมาตกปลาได้ตลอดเลยไง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290314
					],
					"speakerTitle": "Iara"
				},
				{
					"id": 740290314,
					"content": "ตอนแรกก็นึกว่ามันเป็นแผนที่ดีอยู่หรอก แต่รอมาตั้งนานสองนาน มันก็ไม่ยอมงับเหยื่อสักที",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290315
					],
					"speakerTitle": "Iara"
				},
				{
					"id": 740290315,
					"content": "ถึงเรื่องที่บอกว่าไปจับ Ball Octopus มาไว้ในสระน้ำ เพื่อฝึกใช้คันเบ็ดโดยเฉพาะจะน่าเป็นห่วงอยู่ก็เถอะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740290316,
					"content": "แต่เมื่อกี้เราแค่โปรยเหยื่อกระจายไปในน้ำ มันก็ถูกดึงดูดขึ้นมาบนผิวน้ำแล้วนี่? Iara ไม่เคยคิดถึงวิธีโปรยเหยื่อแบบกระจาย ๆ มาก่อนเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740290317,
					"content": "ฉันเคยลองใช้เหยื่อมาหลายอย่างเลยนะ เช่น เนื้อสับ เกล็ดขนมปัง หนอน มินต์ หรือชิ้นส่วนอะไรพวกนั้น... แต่พอมันกินเข้าไปแล้ว ก็ไม่โผล่มาอีกเลยน่ะซี่ ฉันเลยนึกว่า เหยื่อไม่น่าจะใช้กับมันได้ผล",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290318
					],
					"speakerTitle": "Iara"
				},
				{
					"id": 740290318,
					"content": "ชะ ชิ้นส่วน?! ฟังดูไม่เหมือนเหยื่อล่อปลาเลยสักนิด...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290319,
						740290321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740290319,
					"content": "อย่าเอาของประหลาด ๆ ไปให้ผลิตภัณฑ์จากน้ำกินสิ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740290320
					]
				},
				{
					"id": 740290320,
					"content": "อื้อ นั่นสิ ๆ! แต่พอเรียกว่า \"ผลิตภัณฑ์จากน้ำ\" นี่ก็ฟังดู...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740290323,
					"content": "อื้อ อีกอย่างชิ้นส่วนก็เป็นของสำคัญมากเลยนะ ในเมื่อมันไม่ใช่ของที่จะเอามาเป็นเหยื่อให้ Ball Octopus กินได้ งั้นก็คงต้องหาทางเอามันคืนมาแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290324
					],
					"speakerTitle": "Iara"
				},
				{
					"id": 740290324,
					"content": "#จริงสิ เพื่อเป็นการขอบคุณที่อาจารย์ {NICKNAME} กับอาจารย์ Paimon ช่วยเหลือฉัน งั้นช่วยรับชิ้นส่วนอันนี้ไปด้วยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290325
					],
					"speakerTitle": "Iara"
				},
				{
					"id": 740290325,
					"content": "...มะ ไม่ต้องหรอก พวกเราไม่ได้ช่วยอะไรมากมายเลยนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740290326,
					"content": "หืม? แต่ Delaroche เคยบอกว่า เวลาจะขอให้คนอื่นช่วย ต้องเรียกอีกฝ่ายว่า \"อาจารย์\" และต้อง \"จ่ายค่าปรึกษา\" แบบนี้อีกฝ่ายถึงจะดีใจ ไม่ใช่แบบนี้งั้นเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290327
					],
					"speakerTitle": "Iara"
				},
				{
					"id": 740290327,
					"content": "รับชิ้นส่วนแห้ง ๆ นี่ไปเถอะ มันจะมีประโยชน์มากในหมู่บ้าน Merusea",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290328
					],
					"speakerTitle": "Iara"
				},
				{
					"id": 740290328,
					"content": "ในเมื่อ Iara พูดแบบนี้... งั้นก็ขอบใจน้าาา!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740290329,
					"content": "#อื้อ หวังว่าคราวหน้าจะมีโอกาสเรียนเทคนิคตกปลาที่งดงามจากอาจารย์ {NICKNAME} กับอาจารย์ Paimon อีกนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iara"
				},
				{
					"id": 740290321,
					"content": "ที่แท้ Ball Octopus ก็กินชิ้นส่วนด้วยเหรอเนี่ย...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740290322
					]
				},
				{
					"id": 740290322,
					"content": "มันน่าจะกินแบบไม่ได้ตั้งใจรึเปล่า...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740290306,
					"content": "ฉันกลัวว่ามันจะโจมตีเราน่ะ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740290307
					]
				},
				{
					"id": 740290307,
					"content": "เวลาเจออันตรายก็ต้องเป็นฝ่ายซัดมันก่อน! แต่ก็นะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290308
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
