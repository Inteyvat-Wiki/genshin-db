				]
			},
			"dialogs": [
				{
					"id": 740820701,
					"content": "มีหยดน้ำใสดั่งคริสตัลปรากฏขึ้นบนแท่นบูชา",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740820702
					]
				},
				{
					"id": 740820702,
					"content": "เอ๋ หยดน้ำนี่... หยดน้ำนี่คงไม่ใช่สมบัติหรอกใช่มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820703,
					"content": "หน้าตาดูไม่เหมือนสมบัตินะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820704
					]
				},
				{
					"id": 740820704,
					"content": "ฉันก็ว่างั้น... มันจะไปง่ายขนาดนั้นได้ยังไง... งั้นมันคืออะไรกันแน่?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820705,
						740820710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820705,
					"content": "บางทีมันอาจเป็นกุญแจสำคัญ ในการสยบราชาปีศาจก็ได้นะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820706
					]
				},
				{
					"id": 740820706,
					"content": "อะไรนะ? งั้นพวกเราก็ก่อเรื่องใหญ่แล้วน่ะสิ! รีบใส่มันกลับไปเร็วเข้า! หวังว่าจะยังทันนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820707,
					"content": "อ๊ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820708
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820708,
					"content": "แย่แล้ว! ราชาปีศาจโผล่มาแล้ว!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820709,
					"content": "ราชาปีศาจ? เมลูซีน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820715
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820715,
					"content": "ตกใจหมดเลย... ที่แท้ก็เป็นเมลูซีนนี่เอง... ทำไมเธอถึงมาอยู่ที่นี่ได้ล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820716,
					"content": "กุญแจ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820717
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820717,
					"content": "กะ...กุญแจอะไรเหรอ? หรือว่าหยดน้ำนี่คือกุญแจ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820718,
					"content": "Pahsiv",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820719
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820719,
					"content": "เอ่อ... หยดน้ำนี่คือ Pahsiv?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820720,
					"content": "เมลูซีน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820721
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820721,
					"content": "โอ๊ย! หมายความว่ายังไงเนี่ย? หยดน้ำนี้คือเมลูซีน? ฉันเป็นลิงอีกแล้วเหรอ สับสนไปหมดแล้ว สรุปมันคืออะไรกันแน่เนี่ย เธอต่างหากที่เป็นเมลูซีนไม่ใช่เหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820722
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820722,
					"content": "Pahsiv...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820723
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820723,
					"content": "เอิ่ม... เธอคือ Pahsiv? หรือว่าเธอชื่อ Pahsiv? เดี๋ยวก่อน... คำตอบของเธอต้องยิ่งทำให้ฉันงงกว่าเดิมแหง ๆ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820724
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820724,
					"content": "ฉันตัดสินใจแล้วว่าจะเรียกเธอว่า Pahsiv ดีมั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820725
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820725,
					"content": "เมลูซีน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820726
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820726,
					"content": "#{NICKNAME}... ทำยังไงดีอ่า? ฉันไม่เข้าใจความหมายที่เขาจะสื่อเลย เขากำลังพูดอะไรกันแน่...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820727,
					"content": "เธอเข้าใจสิ่งที่พวกเราพูดใช่มั้ย?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820728
					]
				},
				{
					"id": 740820728,
					"content": "Pahsiv...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820729
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820729,
					"content": "หยดน้ำหยดนี้คือกุญแจใช่มั้ย?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820730
					]
				},
				{
					"id": 740820730,
					"content": "Pahsiv",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820731
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820731,
					"content": "เธอไม่ใช่มนุษย์ใช่มั้ย?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820732
					]
				},
				{
					"id": 740820732,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820733
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820733,
					"content": "เอ่อ... จู่ ๆ ทำไมถามแบบนี้ล่ะ ไม่ค่อยดีมั้ง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820734,
					"content": "ฉันไม่ใช่มนุษย์ใช่มั้ย?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820735
					]
				},
				{
					"id": 740820735,
					"content": "เม...เมลูซีน?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820736
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820736,
					"content": "อ๊า! เดี๋ยวนะ ฉันรู้สึกเหมือนจะฟังออกแล้ว... \"Pahsiv\" หมายถึงถูกต้อง \"เมลูซีน\" หมายถึงปฏิเสธ ความหมายคือแบบนี้ใช่มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820737
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820737,
					"content": "Pahsiv! Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820738
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820738,
					"content": "ที่แท้เธอไม่ได้ชื่อ Pahsiv... ขอโทษนะ ฉันคิดผิดซะแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820739
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820739,
					"content": "Pahsiv... ชอบ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820740
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820740,
					"content": "เธอชอบชื่อนี้เหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820741
					]
				},
				{
					"id": 740820741,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820742
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820742,
					"content": "#ดีจังเลย! งั้นก็เรียกเธอด้วยชื่อนี้ละกัน ฮี่ฮี่ ฉันชื่อ Paimon ส่วนนี่คือ {NICKNAME} ดีใจที่ได้พบเธอนะ Pahsiv ฉันไม่เคยเจอเมลูซีนแบบเธอมาก่อนเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820743
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820743,
					"content": "#Paimon Pahsiv! {NICKNAME} Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820744
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820744,
					"content": "Erinnyes... เมลูซีน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820745
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820745,
					"content": "...Erinnyes ปฏิเสธ? เอ่อ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820746
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820746,
					"content": "เกาะ Erinnyes แย่แล้ว?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820747
					]
				},
				{
					"id": 740820747,
					"content": "Erinnyes เมลูซีน ตอนนี้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820748
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820748,
					"content": "Pahsiv Erinnyes ปกป้อง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820749
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820749,
					"content": "ตอนนี้เกาะ Erinnyes เริ่มแย่แล้ว แล้วเธอก็อยากจะปกป้องมัน?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820750
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820750,
					"content": "#Paimon {NICKNAME} Erinnyes ชะชะ ชะชะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820751
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820751,
					"content": "#เอิ่ม... ครั้งนี้ห้าคำ เอ่อ เธออยากให้ Paimon กับ {NICKNAME} เต้นชะชะช่าให้เกาะ Erinnyes สักสองรอบงั้นเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820752
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820752,
					"content": "เมลูซีน!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820753
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820753,
					"content": "เธออยากให้พวกเราช่วยเหลือ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820754
					]
				},
				{
					"id": 740820754,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820755
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820755,
					"content": "ที่แท้ก็คือช่วยเหลือนี่เอง โชคดีไป ๆ ถ้าเกิดจะให้พวกเราไปเต้นใส่เกาะสักสองรอบ นั่นก็งานหยาบเลย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820756
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820756,
					"content": "ชะชะ ชะชะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820757,
						740820761
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820757,
					"content": "มีค่าตอบแทนมั้ย?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820758
					]
				},
				{
					"id": 740820758,
					"content": "ตอบ...แทน?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820759
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820759,
					"content": "#เฮ้อ {NICKNAME} เธอดู Pahsiv สิ พูดยังพูดไม่ค่อยจะได้ จะไปหาใครที่ไหนมาช่วยได้อีก พวกเราช่วยเขากันมั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820760
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820760,
					"content": "งั้นจะให้ช่วยยังไงล่ะ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820762
					]
				},
				{
					"id": 740820762,
					"content": "กุญแจ กุญแจ กุญแจ จำนวน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820763
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820763,
					"content": "แล้วไงต่อ? จำนวนกุญแจคือ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820764
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820764,
					"content": "กุญแจ! กุญแจ! กุญแจ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820765
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820765,
					"content": "กุญแจสามดอก?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820766
					]
				},
				{
					"id": 740820766,
					"content": "Pahsiv! กุญแจ ถนนหมอก ใต้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820767
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820767,
					"content": "กุญแจ ตาน้ำ เหนือ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820768
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820768,
					"content": "กุญแจ ต้นหลิว ออก...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820769
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820769,
					"content": "โอ้ ที่แท้ก็หมายความว่าอย่างนี้นี่เอง... ฉันขอฉันจดแป๊บนึง มีกุญแจทั้งหมดสามดอก แบ่งออกเป็นถนนสายหมอกทางใต้ ตาน้ำทางเหนือ ต้นหลิวทางตะวันออก... แบบนี้เหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820770
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820770,
					"content": "กุญแจ กุญแจ กุญแจ จัตุรัส ตก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820771
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820771,
					"content": "ที่จัตุรัสทางตะวันตกยังมีกุญแจอีกสามดอก?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820772
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820772,
					"content": "รวบรวมกุญแจทั้งสามแล้วไปที่จัตุรัส?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820773
					]
				},
				{
					"id": 740820773,
					"content": "#Paimon เมลูซีน! {NICKNAME} Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820774
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820774,
					"content": "#โอ้ ไม่นะ Pahsiv เธออย่าพูดเหมือนแบบ {NICKNAME} ฉลาดกว่าฉันสิ! ทั้ง ๆ ที่ฉันกับ {NICKNAME} ฉลาดพอ ๆ กันแท้ ๆ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820775
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820775,
					"content": "สรุปก็คือ ตอนนี้พวกเราได้กุญแจมาแล้วหนึ่งดอก ดูท่าแค่หากุญแจอีกสองดอกก็พอแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820776
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820776,
					"content": "Erinnyes เมลูซีน... Pahsiv ปกป้อง!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820777
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820777,
					"content": "เธอวางใจเถอะ ถึงจะไม่รู้ว่าเกิดอะไรขึ้น แต่พวกเราจะช่วยเธอปกป้องเกาะ Erinnyes เอง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820778
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820778,
					"content": "แต่ขอฉันอธิบายเพิ่มอีกนิดนะ Pahsiv ถ้าเธอบังเอิญเจออะไรที่แบบดูไม่มีใครต้องการ ที่มีสีทอง ๆ วิบวับ ๆ กลม ๆ หรือกล่องที่ดูแพง ๆ ละก็...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820779
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820779,
					"content": "ถ้าบอกพวกเราสักคำจะเริ่ดมาก!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820780
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820780,
					"content": "Pahsiv ลูบหัวอย่างไม่ค่อยเข้าใจ ทั้งยังกระโดดสองสามทีอย่างมีความสุข จากนั้นก็รีบวิ่งจากไป",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740820781
					]
				},
				{
					"id": 740820781,
					"content": "#อ๊ะ จู่ ๆ ก็วิ่งไปซะแล้ว ดูท่าจะมีเรื่องด่วนสินะ {NICKNAME} ตอนนี้พวกเราไปหากุญแจอีกสองดอกกันมั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820761,
					"content": "งั้นจะให้ช่วยยังไงล่ะ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820762
					]
				},
				{
					"id": 740820710,
					"content": "ไม่แน่อาจจะถูกคนเก็บเอาไว้ที่นี่ก็ได้",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820711
					]
				},
				{
					"id": 740820711,
					"content": "อะไรนะ? แย่แล้วไง งั้นพวกเราก็เป็นขโมยไปซะแล้วสิ? ขอโทษนะ ขอโทษ... พวกเรารีบเอาของกลับไปคืนเถอะนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820712,
					"content": "อ๊ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820713
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820713,
					"content": "แย่แล้ว! เจ้าของกลับมาแล้ว!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820714,
					"content": "เจ้าของ? เมลูซีน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820715
					],
					"speakerTitle": "Pahsiv"
				}
			]
