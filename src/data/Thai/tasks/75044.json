				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750443901,
					"content": "(อัลบั้มภาพที่ดูไม่เป็นที่นิยมเท่าไร ในนั้นมีภาพสาวสวยให้ชื่นชมมากมาย)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750443902
					],
					"speakerTitle": "\"คอลเลกชันโฆษณาน้ำหอม Fontaine\""
				},
				{
					"id": 750443902,
					"content": "ฮึ... มีแต่รูปสาว ๆ เหรอ? ไม่เห็นน่าสนใจเลย!",
