		{
			"id": 7504436,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750443601,
					"content": "(นิยายโรแมนติกเล่มหนึ่งที่เขียนโดย Dorothy Leeckson บนหน้าปกสีซีดจาง มีผู้หญิงคนหนึ่งนอนอยู่บนเตียงที่รายล้อมไปด้วยดอกไม้ )",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750443602
					],
					"speakerTitle": "\"ดอกลาเวนเดอร์\""
				},
				{
					"id": 750443602,
					"content": "(หลังจากอ่านหนังสือเล่มนี้คร่าว ๆ คุณรู้สึกอบอุ่นและพอใจ แต่ไม่ได้แรงบันดาลใจที่มีประโยชน์อะไร)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750443603
					],
					"speakerTitle": "\"ดอกลาเวนเดอร์\""
				},
				{
					"id": 750443603,
					"content": "เพราะงั้น... นั่นเป็นคนสวนของบ้านเขา รึว่าพี่เขยคนรองของลูกพี่ลูกน้องเพื่อนสนิทของเขากันแน่เนี่ย...โอ๊ย หัวจะปวด!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7504437,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750443701,
					"content": "(ชีวประวัติของ Frank Drebin สารวัตรที่เกษียณแล้วของหน่วยสืบสวนพิเศษ หน่วยล่าเงาแห่ง Fontaine ใช่แล้ว คุณสารวัตรเป็นแมวสีขาวคล่องแคล่วตัวนึง)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750443702
					],
					"speakerTitle": "\"นักสืบเท้าหิมะ\""
				},
				{
					"id": 750443702,
					"content": "(มีรอยอุ้งเท้าแมวใหญ่ ๆ ประทับอยู่บนหน้าชื่อเรื่องหนังสือเล่มนี้ บางทีอาจเป็นที่ระลึกที่คุณสารวัตรทิ้งไว้ให้กับลูกน้องเป็นพิเศษก็ได้นะ)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750443703
					],
					"speakerTitle": "\"นักสืบเท้าหิมะ\""
				},
				{
					"id": 750443703,
					"content": "อะไรเนี่ย... เขียนหนังสือให้ฉันสักเล่มยังจะดีซะกว่า ชื่อเรื่องว่า... \"ยอดนักสืบผมขาว\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7504438,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
