					"Hosseini"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700280101,
					"content": "แต่เพราะได้ข้อมูลที่เธอรวบรวมมา ทำให้การปรับแต่งขั้นสุดท้ายของ Pursina's Spike เรียบร้อยแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280102
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280102,
					"content": "ตอนนี้ฉันมั่นใจว่ามันจะต้องทำงานได้อย่างเสถียรแน่นอน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280103
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280103,
					"content": "แค่เอา Pursina's Spike ไปวางในพื้นที่ที่เจ้า Ruin Grader โมเดลพิเศษ ชอบออกมาเพ่นพ่าน ก็จะสามารถควบคุมแหล่งพลังงานของมันได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280104
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280104,
					"content": "ตราบใดที่ Pursina's Spike ถูกเปิดใช้งาน ร่างกายไม่สามารถรักษาตัวเองซ้ำ ๆ ได้อีกต่อไป",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280105,
						700280107
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280105,
					"content": "ขอบใจมากนะที่ช่วย",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700280106
					]
				},
				{
					"id": 700280106,
					"content": "ไม่ต้องขอบใจฉันหรอก เราควรจะขอบคุณภูมิปัญญาที่เหล่าบรรพบุรุษทิ้งไว้ต่างหาก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280109
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280109,
					"content": "ถ้าไม่มีความรู้พวกนั้นช่วยชี้แนะ ฉันก็คงคิดหาวิธีจัดการกับ Ruin Grader โมเดลพิเศษไม่ออกอยู่ดี",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280110
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280110,
					"content": "ทุกสิ่งที่เราทำต้องอาศัยความรู้พวกนี้เป็นตัวชี้นำ ความรู้เป็นทรัพยากรที่สำคัญที่สุดในโลกอย่างแท้จริง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280111
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280111,
					"content": "ฟังเข้าใจยากจัง",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700280112
					]
				},
				{
					"id": 700280112,
					"content": "เธอไม่เข้าใจเรื่องพื้นฐานแบบนี้ก็ไม่แปลกหรอก เพราะเธอยังไม่ได้รับการสั่งสอนจากผู้ทรงปัญญาไงล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280113
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280113,
					"content": "เหนื่อยอยู่เสียนาน ในที่สุดก็ซ่อม Pursina's Spike เสร็จซะที เมื่อกี้ฉันตื่นเต้นไปหน่อย ฮ่าฮ่าฮ่า พูดนอกเรื่องไปไกลเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280114
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280114,
					"content": "ทีนี้ก็เหลือแค่การเตรียมการครั้งสุดท้ายแล้วล่ะ เอา Pursina's Spike ไปติดตั้งที่เกาะ Tsurumi ได้เลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280115
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280115,
					"content": "ต้องขอโทษด้วยนะ เรื่องนี้ฉันช่วยเธอไม่ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280116
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280116,
					"content": "ตามกฎหมายของ Inazuma คนที่ยังทำใบอนุญาตผู้อาศัยไม่เสร็จจะไปไหนตามใจไม่ได้ เพราะงั้นเรื่องนี้คงต้องให้เธอจัดการแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280117
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280117,
					"content": "เข้าใจแล้ว",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700280118
					]
				},
				{
					"id": 700280118,
					"content": "ลำบากเธอแล้วนะ ฉันขอแนะนำว่าหลังจากติดตั้งเสร็จก็อย่าเพิ่งรีบลงมือ ให้สำรวจดูให้ดีก่อนว่าสถานการณ์เป็นปกติรึเปล่า แล้วค่อยกลับมาบอกฉันอีกที",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280119
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280119,
					"content": "เพื่อความปลอดภัยของเธอ เราต้องระวังให้มาก ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280107,
					"content": "ขอบคุณเทคโนโลยี",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700280108
					]
				},
				{
					"id": 700280108,
					"content": "ฉันไม่ได้คิดอย่างงั้นนะ เราควรจะขอบคุณภูมิปัญญาที่เหล่าบรรพบุรุษทิ้งไว้ต่างหาก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280109
					],
					"speakerTitle": "Hosseini"
				}
			]
		},
