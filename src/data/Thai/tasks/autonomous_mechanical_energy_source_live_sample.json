			"dialogs": [
				{
					"id": 700280301,
					"content": "เป็นยังไง? Pursina's Spike ทำงานตามปกติมั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280302
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280302,
					"content": "ทุกอย่างปกติดี",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700280303
					]
				},
				{
					"id": 700280303,
					"content": "อ่า ทุกอย่างปกติก็ดีแล้ว หวังว่าจะไม่มีปัญหาอะไรทีหลังนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280304
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280304,
					"content": "แบบนี้ พอเจ้า Ruin Grader โมเดลพิเศษมาเพ่นพ่านในใกล้เคียงของ Pursina's Spike แหล่งพลังงานของ Ruin Grader โมเดลพิเศษจะต้องถูกตัดแน่นอน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280305
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280305,
					"content": "คราวนี้ก็น่าจะสามารถปราบมันได้แล้วล่ะ รีบไปจัดการเถอะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280306
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280306,
					"content": "ฉันเชื่อในความสามารถของเธอ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hosseini"
				}
