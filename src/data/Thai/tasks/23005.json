					"Hatim"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230050401,
					"content": "เอ่อ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050402
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050402,
					"content": "เฮ้! Hatim ช่วงนี้เธอเป็นยังไงบ้าง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230050403,
					"content": "อืม... พวกเธอเองเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050404
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050404,
					"content": "เฮ้อ เห็นท่าทางที่กลัดกลุ้มของฉันแล้ว พวกเธอก็น่าจะเดาออกบ้างแล้วใช่มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050405
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050405,
					"content": "บอกตรง ๆ เลยแล้วกัน จนถึงตอนนี้ กระเป๋าเงินของฉันหมดเกลี้ยงไปแล้วครึ่งหนึ่ง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050406
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050406,
					"content": "แปลกจัง... ไม่น่าจะเป็นแบบนี้นี่นา...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050407
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050407,
					"content": "แต่จะว่าไปแล้ว... จากการคาดเดาของฉัน บางทีนี่อาจจะเป็นสัญญาณว่าตลาดกำลังจะเริ่มต้นขึ้น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050408
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050408,
					"content": "เหมือนกับที่คนเราจะต้องก้มตัวลงก่อน จากนั้นถึงจะสามารถกระโดดขึ้นสูงได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050409
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050409,
					"content": "ก็เหมือนกับตลาดซื้อขายสัญญาล่วงหน้า ตอนนี้ทั้งตลาดกำลังอยู่ในจุดที่ตกต่ำที่สุด ต่อไปต้องถึงช่วงเวลาที่ดีดตัวจากจุดที่ต่ำที่สุดแล้วสินะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050410
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050410,
					"content": "หรือก็หมายความว่า ตอนนี้เป็นโอกาสที่ดีที่สุดในการต่อรองราคา!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050411,
						230050412
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050411,
					"content": "บางทีถ้าเราอยู่บนไหล่เขา",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230050413
					]
				},
				{
					"id": 230050413,
					"content": "ไม่สิ ฉันมั่นใจเลยว่า นี่เป็นโอกาสที่หายาก ฉันจะไม่ยอมพลาดโอกาสที่เป็นหนทางแห่งความมั่งคั่งเด็ดขาด",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050414
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050414,
					"content": "แบบนี้ถึงจะสมกับชื่อของ Hatim มหาเศรษฐีผู้ร่ำรวยแห่ง Kalimi สิ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050415
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050415,
					"content": "ช่วยฉันอีกสักครั้งได้มั้ย? เพื่อน ช่วยเลือก \"อาหารจานทอง\" ให้ฉันอีกสักจานเถอะนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050416
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050416,
					"content": "ต้องเลือกจากหนึ่งในสามจานนั้นเหมือนเดิมใช่มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230050417,
					"content": "อ่อ... ไม่! ในเมื่อต้องต่อรอง ฉันต้องการอาหารจานที่พิเศษมากกว่านี้ มันจะสามารถทำให้ตลาดเปลี่ยนแปลงไปในทางที่ดีได้!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050418
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050418,
					"content": "ฉันได้ยินว่าที่ Mondstadt มีเศรษฐีอยู่คนหนึ่ง ธุรกิจเกี่ยวกับไวน์ของเขารุ่งเรืองสุด ๆ ไปเลยล่ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050419
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050419,
					"content": "คุณหมายถึง...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230050420
					]
				},
				{
					"id": 230050420,
					"content": "นายท่าน Diluc?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230050421,
					"content": "แต่ว่าคุณรู้เรื่องนี้ได้ยังไง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230050422,
					"content": "ฮ่าฮ่าฮ่า ขนาด \"Pile 'Em Up\" ฉันยังรู้จักเลย แล้วจะไม่รู้จักเขาได้ยังไงกัน?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050423
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050423,
					"content": "ร้านเหล้าของเขาวางขายของดีที่ชื่อว่า \"Apple Cider\" อยู่ ถ้าได้ดื่มมัน ฉันอาจได้อานิสงส์โชคลาภจากเศรษฐีคนนั้นมาบ้างก็ได้!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050424
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050424,
					"content": "ขอร้องล่ะ ช่วยเตรียม Apple Cider 1 อัน ให้ฉันหน่อยนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050412,
					"content": "แล้วงอขาก็อาจจะทำให้ปวดขาได้...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230050413
					]
				}
			]
		},
