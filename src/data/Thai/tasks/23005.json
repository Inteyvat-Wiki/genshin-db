					"Hatim"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230050201,
					"content": "เอ่อ... ถือว่าไม่เลว...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050202
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050202,
					"content": "ดูเหมือนจะหาเงินได้ไม่น้อยเลยนะ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230050203
					]
				},
				{
					"id": 230050203,
					"content": "อ๊ะ นักเดินทาง! ต้องขอบคุณเธอจริง ๆ ครั้งนี้ฉันได้กำไรมานิดหน่อย ดูเหมือนว่า \"อาหารจานทอง\" จะมีประสิทธิภาพจริง ๆ นะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050204
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050204,
					"content": "แต่ว่ากำไรที่ได้ก็ไม่ต่างจากที่ทำการซื้อขายแบบปกติมากเท่าไหร่...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050205
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050205,
					"content": "นี่ไม่น่าจะใช่ผลลัพธ์ของ \"อาหารจานทอง\" หรือฉันกินอาหารผิดจานไปงั้นเหรอ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050206
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050206,
					"content": "นักเดินทาง งั้นเรามาลองกันอีกครั้งดีกว่า ช่วยเลือก \"อาหารจานทอง\" ให้ฉันอีกครั้งเถอะนะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050207
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050207,
					"content": "เงื่อนไขเหมือนเดิมเลย เลือกหนึ่งจานจาก <color=#00E1FFFF>Mora Meat</color>, <color=#00E1FFFF>Butter Chicken</color> และ <color=#00E1FFFF>\"Pile 'Em Up\"</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hatim"
				}
			]
		},
		{
			"id": 2300503,
