			"dialogs": [
				{
					"id": 700070101,
					"content": "Ye ika gusha mosi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070102,
						700070103
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070102,
					"content": "ดูเหมือนคุณจะอารมณ์ไม่ค่อยดีนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070104
					]
				},
				{
					"id": 700070104,
					"content": "ขอโทษด้วย เป็นเพราะช่วงนี้ในห้องสมุดเสียงดังมาก ฉันเลยไม่มีสมาธิศึกษาภาษา Hilichurl เลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070105
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070105,
					"content": "ตั้งแต่เทศกาล Windblume เริ่มต้นขึ้น ก็มีผู้คนมากมายมานัดเดทกันที่นี่ ตอนแรกพวกเขาอ่านหนังสืออย่างเงียบ ๆ แต่หลังจากนั้นก็เริ่มพูดคุยกัน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070106
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070106,
					"content": "อีกอย่าง...พวกเขายังทำเรื่องที่น่ากลัวต่างๆ นานา ด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070107
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070107,
					"content": "พับมุมหนังสือจนเสียหาย...สอดของแปลก ๆ ไว้ในหน้าหนังสือ...หรือแม้แต่ยัดหนังสือเข้าไปในชั้นแบบกลับหัว!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070108
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070108,
					"content": "ห้องสมุดไม่ใช่ที่ ๆ เอาไว้เดทกันนะ! แบบนี้มันรบกวนคนที่มาอ่านหนังสือจริง ๆ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070109,
						700070111
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070109,
					"content": "Wyratt ควรจะเข้ามารักษาความเป็นระเบียบเรียบร้อยในนี้",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070110
					]
				},
				{
					"id": 700070110,
					"content": "เขาทำอะไรไม่ได้เลย การไล่คนออกไปก็ไม่ใช่การแก้ปัญหาที่ถูกจุด",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070113
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070113,
					"content": "ยังไงรบกวนเธอช่วยทำให้คนในนี้สงบลงทีเถอะนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070114,
						700070115
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070114,
					"content": "ให้ฉันจัดการเอง",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070116
					]
				},
				{
					"id": 700070116,
					"content": "ขอบคุณมากนะ กลุ่มที่เอะอะโวยวายที่สุดก็คือสามคู่ที่อยู่ทางนั้น ถ้าเธอทำให้พวกเขารู้ได้ว่าการส่งเสียงดังแบบนี้น่ารำคาญแค่ไหนล่ะก็ ฉันคงได้ทำงานวิจัยของฉันต่อไป",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070117
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070117,
					"content": "แต่ระวังนะ พวกนั้นน่ะรับมือได้ยากมากเลยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070115,
					"content": "ฉันจะลองดูนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070116
					]
				},
				{
					"id": 700070111,
					"content": "ไปหาคุณ Lisa สิ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070112
					]
				},
				{
					"id": 700070112,
					"content": "แต่ฉันได้ยินมาว่าคุณ Lisa ไม่อยู่เพราะออกไปลาดตระเวนกับรักษาการผู้บัญชาการน่ะ ถ้าเธออยู่ล่ะก็ คู่รักพวกนี้คงจะสำรวมกว่านี้เยอะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070113
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070103,
					"content": "น้ำเสียงฟังดูดุกว่าทุกที",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070104
					]
				}
			]
		},
