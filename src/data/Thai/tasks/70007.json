						700070202
					],
					"speakerTitle": "ชายหนุ่มที่กำลังมีความรัก"
				},
				{
					"id": 700070202,
					"content": "อีกหน่อยเราคงไม่กลายเป็นแบบนั้นใช่มั้ย ที่รัก?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070203
					],
					"speakerTitle": "สาวน้อยที่กำลังมีความรัก"
				},
				{
					"id": 700070203,
					"content": "แน่นอนอยู่แล้ว ถึงแม้เราจะอยู่ห่างกัน แต่ฉันจะต้องหาทางพาเธอกลับมาอยู่เคียงข้างให้ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070204,
						700070205
					],
					"speakerTitle": "ชายหนุ่มที่กำลังมีความรัก"
				},
				{
					"id": 700070204,
					"content": "ไม่ควรส่งเสียงดังในห้องสมุดนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070206
					]
				},
				{
					"id": 700070206,
					"content": "เอ๋? ฉันพูดเสียงเบาอยู่ตลอดนี่นา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070207
					],
					"speakerTitle": "สาวน้อยที่กำลังมีความรัก"
				},
				{
					"id": 700070207,
					"content": "เอ่ บางทีนี่อาจจะเป็นอุปสรรคของความรักของเราล่ะมั้ง ที่รัก...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070208
					],
					"speakerTitle": "ชายหนุ่มที่กำลังมีความรัก"
				},
				{
					"id": 700070208,
					"content": "หนังสือที่อ่านจบแล้ว ก็ควรจะเอากลับไปไว้ที่เดิม",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070209,
					"content": "ขืนวางเกะกะแบบนี้ คนที่มีหน้าที่เอากลับไปไว้ที่ชั้นวางก็ปวดหัวกันพอดี",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070210,
					"content": "รู้แล้ว รู้แล้ว อย่ารบกวนพวกเราจะได้มั้ย กำลังเข้าด้ายเข้าเข็มเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070211
					],
					"speakerTitle": "ชายหนุ่มที่กำลังมีความรัก"
				},
				{
					"id": 700070211,
					"content": "กำลังเข้าด้ายเข้าเข็ม?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070212,
					"content": "ไม่ว่าจะมีอุปสรรคขัดขวางแค่ไหน เธอก็จะเป็นเหมือนเดิมตลอดไปใช่มั้ย ที่รัก?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070213
					],
					"speakerTitle": "สาวน้อยที่กำลังมีความรัก"
				},
				{
					"id": 700070213,
					"content": "ใช่แล้ว ฉันสาบานด้วยชีวิตเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070214
					],
					"speakerTitle": "ชายหนุ่มที่กำลังมีความรัก"
				},
				{
					"id": 700070214,
					"content": "ที่รักไม่เห็นต้องพูดขนาดนั้นเลย...ชีวงชีวิตอะไรกันล่ะ ฉันปวดใจนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070215
					],
					"speakerTitle": "สาวน้อยที่กำลังมีความรัก"
				},
				{
					"id": 700070215,
					"content": "อ่า เป็นเพราะที่รักอ่อนโยนแบบนี้ไง ฉันถึงได้หลงเธอหัวปักหัวปำขนาดนี้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070216
					],
					"speakerTitle": "ชายหนุ่มที่กำลังมีความรัก"
