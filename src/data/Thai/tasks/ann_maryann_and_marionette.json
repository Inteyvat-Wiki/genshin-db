			"dialogs": [
				{
					"id": 742530201,
					"content": "วันเวลาที่สงบสุขแบบนี้ ดีจังเลยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530202,
						742530203
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530202,
					"content": "(ขอนั่งแบบนี้อีกสักพักละกัน)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530204
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742530204,
					"content": "ป่านนี้แล้วเหรอเนี่ย? ฮ่าฮ่า งั้นวันหลังพวกเราก็มาเจอกันบ่อย ๆ นะ คุณ Sandrone",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530203,
					"content": "ได้เวลาจบงานเลี้ยงน้ำชาแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530204
					],
					"speakerTitle": "Marionette"
				}
			]
		}
	]
