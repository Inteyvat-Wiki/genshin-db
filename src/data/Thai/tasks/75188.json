				}
			]
		},
		{
			"id": 7518802,
			"completionStepIds": [
				7518802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7518802",
							"2"
						],
						"stepId": 7518802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paqarin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751880201,
					"content": "ทางนั้น ใช่ ใช่แล้ว เธอนั่นแหละ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880202
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880202,
					"content": "ดูเธอคล่องแคล่ว วิ่งได้เร็วมาก น่าจะแข็งแรงดีนะ เหมือนคนที่ออกกำลังกายบ่อย ๆ เลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880203
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880203,
					"content": "เธอคือนักรบแห่ง \"ผองสรรพสิ่ง\" ของพวกเรางั้นเหรอ? หรือว่าเธอมาจากเผ่าอื่น?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880204,
						751880205
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880204,
					"content": "ฉันคือนักผจญภัยที่ผ่านทางมา",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751880206
					]
				},
				{
					"id": 751880206,
					"content": "งั้นเหรอ น่าเสียดายนะ เฮ้อ แต่ก็นะ ตอนที่กำลังขาดคนอยู่ จู่ ๆ ก็มีคนมาช่วย เรื่องดี ๆ แบบนี้มีแค่ในฝันเท่านั้นแหละ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880207
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880207,
					"content": "มีอะไรเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751880208
					]
				},
				{
					"id": 751880208,
					"content": "คืออย่างนี้นะ เธอก็เห็นแล้ว ฉันมีฟาร์มอยู่ตรงนี้ใช่มั้ย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880209
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880209,
					"content": "ฉันดูแลฟาร์มนี้อยู่คนเดียวมาตลอด แต่ช่วงนี้ดันเกิดเรื่องไม่ค่อยดีเท่าไหร่...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880210
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880210,
					"content": "หลายวันก่อน ฉันไปต่อสู้กับนักรบในเผ่า จนได้รับบาดเจ็บที่หลัง... ใช่ ฉันรู้ว่าเรื่องนี้มันโง่มาก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880211
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880211,
					"content": "สุดท้าย ตอนนี้ฉันไม่สามารถช่วยพ่อบุกเบิกพื้นที่ใหม่ได้ และไม่สามารถดูแลฟาร์มของตัวเองได้ด้วย บอกตามตรง แม้แต่ตอนเดินก็ยังเจ็บ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880212
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880212,
					"content": "กำลังคิดว่าจะจ้างคนมาช่วยงานสักสองสามวัน แล้วบังเอิญเจอเธอเข้าพอดี",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880213
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880213,
					"content": "น่าเสียดายที่เธอแค่เดินผ่านมา การทำสวนนี่ต้องลงแปลงทุกวันนะ ถ้าเธอมาบ้างไม่มาบ้าง สวนของฉันก็จะถูกทิ้งร้าง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880214
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880214,
					"content": "แต่ตอนนี้ฉันไม่มีแรงจะเดินไปไกลถึงในเผ่า เพื่อหาคนช่วยเลย เฮ้อ นอกจาก Tatankasaurus น้อยที่เลี้ยงไว้ไม่กี่ตัว ตอนนี้ก็ไม่มีใครที่สามารถช่วยได้แล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880215
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880215,
					"content": "ช่วงนี้เจ้าพวกตัวแสบก็ไม่ค่อยเชื่อฟังสักเท่าไหร่ ทั้ง 3 ตัวต่างก็เอาแต่หลบอยู่ในสวน ไม่ยอมมาหาฉันเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880216
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880216,
					"content": "เอางี้ละกัน ฉันขอให้คุณช่วยพาพวกมันกลับมาแทนฉันที ฉันเดินไม่ค่อยไหวจริง ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880217
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880217,
					"content": "ไม่มีปัญหา",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751880218
					]
				},
				{
					"id": 751880218,
					"content": "งั้นก็เยี่ยมไปเลย ปกติพวกมันค่อนข้างจะเชื่อฟังดี และมักจะช่วยฉันทำงานในสวน แต่ไม่รู้ว่าสองวันมานี้เกิดอะไรขึ้น...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880219
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880219,
					"content": "พอเธอเรียกพวกมัน Saurian น้อยของฉันทั้ง 3 ตัว ก็น่าจะกลับมาเอง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880205,
					"content": "ฉันไม่ใช่ชาว Natlan",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751880206
					]
				}
			]
		},
