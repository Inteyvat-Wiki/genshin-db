					"Nahida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130150301,
					"content": "เราเป็นผู้ชมเงียบ ๆ ไปก็พอแล้วมั้ง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150302,
					"content": "ไม่รู้ว่าเขาจะพูดอะไรแฮะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150303,
					"content": "สวัสดี ผู้คนที่เพิ่งตื่นมาทุกท่าน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150304
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150304,
					"content": "ฉันต้องขออภัยด้วยที่รบกวนฝันหวานของพวกคุณ แล้วต้องขอโทษสำหรับการจัดการสิ่งในห้วงฝันที่ออกจะเย็นชาเกินไปหน่อยด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150305
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150305,
					"content": "ความฝันมีพลังที่อัศจรรย์มาก สำหรับคนที่มีจิตใจแน่วแน่ มันสามารถให้ขวัญกำลังใจ และติดปีกให้กับอุดมการณ์ได้เลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150306
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150306,
					"content": "แต่มันก็อาจจะฉวยโอกาสเข้าไปบิดเบือนการรับรู้ของมนุษย์ และกลับผิดให้เป็นถูก... ทุกคนโชคร้ายที่ตกเป็นเหยื่อของมัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150307
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150307,
					"content": "เหมือนอย่างที่ฉันเคยพูดไปก่อนหน้านี้ ฉันยังคงเรียนรู้อยู่ตลอด จึงไม่กล้าพูดว่า เข้าใจถึงความเจ็บปวดของการลาจากได้เหมือนพวกคุณ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150308
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150308,
					"content": "แต่เมื่อได้มองดูรอบ ๆ แล้วก็ทำให้รู้ว่า คนที่มีประสบการณ์ใกล้เคียงกันก็มีไม่น้อยเช่นเดียวกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150309
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150309,
					"content": "ทุกคนควรภาคภูมิใจที่สามารถมารวมตัวกันที่นี่ได้ และมองไปสู่อนาคตร่วมกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150310
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150310,
					"content": "เส้นทางชีวิตยาวไกลมาก จึงยากที่จะมองเห็นปลายทาง ดังนั้นเราอาจจะเกิดคำถามขึ้นมากมาย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150311
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150311,
					"content": "\"ฉันมีชีวิตอยู่เพื่ออะไร? เป้าหมายของฉันคืออะไร? ทำไมฉันต้องทนทุกข์ทรมานอยู่ตลอดเวลาด้วย?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150312
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150312,
					"content": "แน่นอน การหยุดก้าวต่อ ยอมแพ้ที่จะครุ่นคิด และวนเวียนทำแต่สิ่งเดิม ๆ ที่คุ้นเคยนั้น ล้วนเป็นทางเลือกที่สบายที่สุด",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150313
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150313,
					"content": "ทุกครั้งที่เกิดความคิดแบบนี้ขึ้น ก็จงมองดูผู้คนและสิ่งที่อยู่ข้างกายตัวเองเถอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150314
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150314,
					"content": "บางคนขยันทำงานทั้งวัน เพื่อที่จะให้ทั้งครอบครัวได้ทานอาหารร้อน ๆ ตอนกลางคืน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150315
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150315,
					"content": "บางคนเดินไปทั่วทุกสารทิศ เพื่อที่จะสร้างสรรค์ผลงานศิลปะที่จะทำให้ทั่วทั้ง Teyvat เกิดความรู้สึกร่วมกันได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150316
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150316,
					"content": "บางคนสำรวจความลับของโลก เพื่อป้องกันภัยพิบัติอันยากจะอธิบายที่กำลังคืบคลานเข้ามา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150317
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150317,
					"content": "...ตัวตนไม่ใช่ความหมายทั้งหมดของชีวิต แต่การกระทำแต่ละครั้งล้วนเป็นการสร้างตัวตนและโลกขึ้นมา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150318
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150318,
					"content": "ญาติและเพื่อนฝูงจะจดจำทุกการกระทำของพวกคุณไว้ คนแปลกหน้าก็อาจได้รับประโยชน์จากความเคลื่อนไหวของพวกคุณด้วยเช่นกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150319
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150319,
					"content": "เพื่อการนี้ มีผู้คนอีกมากมายที่ยังยืนกรานจะบุกเบิกเส้นทางใหม่ แม้ต้องทนกับความเจ็บปวดก็ตาม",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150320
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150320,
					"content": "เมื่อพวกคุณก้าวสู่เส้นทางที่เหมือนกัน คำตอบของคำถามสุดท้ายเหล่านั้นก็จะค่อย ๆ ปรากฏขึ้น แล้วมันจะไม่สำคัญอีกต่อไป",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150321
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150321,
					"content": "แต่หากพวกคุณคิดว่าชีวิตคือความว่างเปล่า งั้นมันก็จะค่อย ๆ เดินไปสู่ความว่างเปล่า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150322
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150322,
					"content": "พวกคุณมีอิสระในการเลือกวิธีใช้ชีวิตของตัวเอง แต่ในฐานะเทพเจ้า ฉันมีหน้าที่ต้องปลุกทุกคนให้ตื่นขึ้นมาก่อน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150323
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150323,
					"content": "จะยอมทอดทิ้งโลกความเป็นจริงเพื่อครอบครองความฝันหรือไม่นั้น ก็ขึ้นอยู่กับตัวทุกคนเองแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nahida"
				}
			]
		},
		{
			"id": 1301504,
			"completionStepIds": [
				1301504
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301504",
							"2"
						],
						"stepId": 1301504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nahida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130150401,
					"content": "เธอเก่งมากเลย ตอนอยู่ในความฝัน ขนาดฉันยังเถียงนักวิชาการคนนั้นไม่ค่อยออกเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150402,
					"content": "เพราะเขาสามารถนำจุดอ่อนของมนุษย์มาใช้ประโยชน์ได้อย่างแยบยล บางทีแม้แต่ตัวเขาก็ถลำลึกไปแล้วเหมือนกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150403
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150403,
					"content": "ความฝันนั้นมีความเย้ายวนใจที่ยากจะบรรยายออกมาเป็นคำพูด มันงดงามจนทำให้คนเสพติด และคนทั่วไปก็ยากที่จะแยกแยะได้อย่างชัดเจน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150404
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150404,
					"content": "แต่ขอแค่ตื่นจากฝัน จะเมื่อไหร่ก็ไม่นับว่าสายเกินไปหรอก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150405
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150405,
					"content": "เธอเองก็พัฒนาขึ้นเยอะนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150406
					]
				},
				{
					"id": 130150406,
					"content": "เอ๋? ทำไมจู่ ๆ ถึงพูดแบบนี้ล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150407
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150407,
					"content": "ที่จริงเธอก็รู้สึกร่วมกับคนอื่นได้ดีเหมือนกันนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150408
					]
				},
				{
					"id": 130150408,
					"content": "ใช่เลย แม้เธอจะบอกว่าตัวเองไม่ค่อยเข้าใจความรู้สึกของมนุษย์ แต่พวกเราก็มองเห็นความลังเลในสายตาของเธอนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150409,
					"content": "สิ่งที่เธอพูดเมื่อกี้นี้ก็พูดด้วยจุดยืนของพวกเขา เธอก็ทำมันได้ดีเลยไม่ใช่หรือไง!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150410,
					"content": "ขอบคุณพวกเธอนะ ตลอดทางที่ผ่านมาฉันได้ยินเรื่องราวโศกเศร้ามามากมาย ภายในใจเกิดแรงกระเพื่อมขึ้นหลายต่อหลายครั้งเลยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150411
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150411,
					"content": "การกระทำของผู้เสียหายไม่ถือว่าผิดหรอก แล้วสิ่งที่พวกเขาต้องการก็ไม่มากเกินไปด้วย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150412
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150412,
					"content": "ดังนั้นตอนที่พวกเขาพยายามจะต่อต้านพวกเราเพื่อปกป้องความฝันไว้ ฉันพอจะเข้าใจการตัดสินใจของพวกเขานะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150413
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150413,
					"content": "แต่เมื่อเทียบความเข้าใจและความรู้สึกของฉัน กับความเจ็บปวดที่พวกเขาได้เผชิญมาแล้วนั้น อาจจะไม่ถึงหนึ่งในร้อยด้วยซ้ำ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150414
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150414,
					"content": "\"หนึ่งในร้อย\" ที่ว่านี้ ฉันไม่กล้าคิดว่ามันเป็นความร่วมรู้สึกไปด้วยหรอกนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150415
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150415,
					"content": "มาตรฐานของเธอสูงจังเลย มันก็ต้องใช่อยู่แล้วสิ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150416,
						130150417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150416,
					"content": "ไม่มีใครสามารถร่วมรู้สึกได้โดยสมบูรณ์หรอก",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150418
					]
				},
				{
					"id": 130150418,
					"content": "ฮี่ฮี่ ก็ได้ ออกมาเจอกับโลกภายนอกบ้างแบบนี้ ถึงจะเติบโตได้สิเนอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150419
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150419,
					"content": "ความรู้สึกไม่เหมือนกับความรู้เลย ฉันไม่สามารถใช้คำพูดอธิบายพวกมันได้อย่างชัดเจน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150420
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150420,
					"content": "Beynuni... หรือ \"Moseis\" บอกว่า ฉันไม่เคยเจอกับการเกิดแก่เจ็บตายมาก่อน แต่ฉันมีความรู้สึกบางอย่างที่คอยเตือนว่ามันไม่ใช่แบบนี้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150421
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150421,
					"content": "ทันทีที่เข้าสู่ความฝัน ฉันก็รู้สึกว่าตัวเองถูกกระแสความอบอุ่นโอบล้อมไว้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150422
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150422,
					"content": "มันอบอุ่นจนฉันรู้สึกเหมือนตัวเองได้กลับคืนสู่สถานะแรกเริ่มของชีวิต และไม่อยากตื่นขึ้นมาอีกเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150423
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150423,
					"content": "(หรือว่าเธอก็มองเห็นบางอย่างเหมือนกัน?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150424
					]
				},
				{
					"id": 130150424,
					"content": "แต่พอฉันลืมตาขึ้นมา ความรู้สึกแบบนั้นก็หายไป โดยไม่ทิ้งร่องรอยไว้เลยสักนิด",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150425
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150425,
					"content": "ถ้าให้ยกตัวอย่างละก็ มันก็เหมือนลายมือบนกระดาษขาวที่ถูกลบออกไปแล้ว ฉันมองไม่เห็นตัวหนังสือ แต่ยังสามารถมองเห็นรอยกดจาง ๆ ที่หลงเหลืออยู่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150426
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150426,
					"content": "หลังจากความฝันครั้งนี้ ฉันก็คิดตก ไม่ว่ากระแสอุ่น ๆ นั่นจะหมายถึงอะไร มันก็ไม่สำคัญ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150427
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150427,
					"content": "สิ่งที่ฉันแน่ใจได้ก็คือ พลังอบอุ่นนั้นเคยประคับประคองพยุงฉันให้เดินทางมาถึงทุกวันนี้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150428
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150428,
					"content": "แต่ถ้าไปสนใจกับความเป็นมาของมันมากเกินไป ก็จะเป็นการให้ความสำคัญผิดจุด",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150429
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150429,
					"content": "เมื่อกี้พูดกับทุกคนอย่างมีอุดมการณ์ไปตั้งมากมาย สุดท้ายแล้วตัวเองกลับทำไม่ได้ แบบนั้นก็ขายหน้าแย่เลยสิ ฮี่ฮี่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150430
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150430,
					"content": "(ท่านหญิง Rukkhadevata ผู้ยิ่งใหญ่ ได้ใช้การกระทำของเธอสร้าง Nahida ขึ้นมาแล้ว)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150431
					]
				},
				{
					"id": 130150431,
					"content": "(แม้โลกจะลืมเลือนเธอไปแล้ว แต่ความคิดและปณิธานของ Nahida เป็นหลักฐานที่ยืนยันว่าเธอ \"เคยมีตัวตนอยู่บนโลกนี้\" จริง ๆ)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150432
					]
				},
				{
					"id": 130150432,
					"content": "(แทนที่จะพูดความจริงออกไป ฉันว่าฉันควรเคารพความคิดของพวกเธอมากกว่า)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150433
					]
				},
				{
					"id": 130150433,
					"content": "เป็นอะไรไปเหรอ? ทำไมจู่ ๆ ก็ทำสีหน้าหนักใจแบบนี้ล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150434
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150434,
					"content": "เห็นเธอทำท่าเหมือนมีอะไรจะพูดอยู่หลายที มีเรื่องอะไรจะบอกฉันเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150435,
						130150436
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150435,
					"content": "ฉันลืมไปแล้วว่าจะพูดอะไร",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150437
					]
				},
				{
					"id": 130150437,
					"content": "ฮ่าฮ่า งั้นเหรอ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150438
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150438,
					"content": "ในเมื่อเราเพิ่งตื่นกัน งั้นมายืดเส้นยืดสายกันสักหน่อยเถอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150439
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150439,
					"content": "วันใหม่กำลังจะเริ่มขึ้นแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150436,
					"content": "ไม่สำคัญหรอก",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150437
					]
				},
				{
					"id": 130150417,
					"content": "เธอมั่นใจกว่านี้หน่อยก็ได้นะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150418
					]
				}
			]
		},
		{
			"id": 1301505,
