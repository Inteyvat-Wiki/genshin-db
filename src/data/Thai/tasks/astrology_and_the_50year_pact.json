			"dialogs": [
				{
					"id": 105000701,
					"content": "หาเจอแล้ว! น่าจะเป็นแหวนวงนี้แหละ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000702
