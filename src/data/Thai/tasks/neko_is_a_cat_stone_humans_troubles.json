			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ooshima Junpei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722130301,
					"content": "เฮ้อ ไม่มีค้อน ไม่มีสิ่ว จะทำงานได้ยังไงล่ะเนี่ย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130302
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130302,
					"content": "เจอปัญหาอะไรงั้นเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130303
					]
				},
				{
					"id": 722130303,
					"content": "โอ้ พวกเธอนี่เอง เฮ้อ... ฉันสะเพร่าไปหน่อยน่ะ ในตอนที่มาไม่ได้เช็กเครื่องมือ พอตั้งใจทำงานมากเกินไป ก็เลยเผลอทำค้อนกับสิ่วหักไปโดยไม่ได้ตั้งใจน่ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130304
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130304,
					"content": "ถึงฉันจะอยากกลับไปซื้อเครื่องมือที่เกาะ Narukami แต่ว่า...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130305
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130305,
					"content": "จะบอกยังไงดีล่ะ... พวกงานแกะสลักฉันชินที่จะต้องทำให้เสร็จในรอบเดียวน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130306
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130306,
					"content": "แม้ว่าค้อนและสิ่วจะหัก แต่ฉันก็ยังต้องวางแผนต่อ ว่าจะแกะสลักต่อไปยังไง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130307
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130307,
					"content": "ถ้าต้องทิ้งรูปปั้นนี้เพื่อเดินทางไปซื้อเครื่องมือที่เกาะ Narukami ล่ะก็... ฉันตอนที่กลับมา ฉันต้องรื้อฟื้นความคุ้นชินในการแกะสลักใหม่ตั้งแต่แรก...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130308
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130308,
					"content": "และอีกอย่างหินนั้นก็แข็งเกินไป ถ้าใช้เครื่องมือธรรมดา ๆ ล่ะก็เครื่องมือจะต้องพังง่าย ๆ แน่ ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130309
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130309,
					"content": "เฮ้อ... ช่วยไม่ได้นี่นา...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130310
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130310,
					"content": "นักเดินทาง ช่วยหา Iron Chunk 3 อัน มาให้หน่อยได้มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130311
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130311,
					"content": "ฉันต้องหาวิธีสร้างเครื่องมือที่เชื่อถือได้สองสามอย่างด้วยตัวเอง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130312,
						722130314
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130312,
					"content": "ให้ฉันจัดการเอง",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130313
					]
				},
				{
					"id": 722130313,
					"content": "โอ้! ต้องรบกวนพวกเธอด้วยนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130314,
					"content": "คุณ... จะหล่อขึ้นมาเองเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130315
					]
				},
				{
					"id": 722130315,
					"content": "ฉันก็เคยทำงานอยู่ที่ Tatarasuna นะ งานหล่องานหลอมก็พอทำเป็นอยู่บ้าง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130316
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130316,
					"content": "แต่ว่าฉันคงเปิดเตาหลอมที่ศาลเจ้าไม่ได้ ไม่งั้นท่านรักษาการณ์หัวหน้ามิโกะจะต้องโกรธแน่... แฮะแฮะ ยังไงก็เป็นแมวนี่นา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130317
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130317,
					"content": "งั้นเธอก็เอา Iron Chunk 3 อัน มาให้ฉันก่อนก็แล้วกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ooshima Junpei"
				}
			]
		},
