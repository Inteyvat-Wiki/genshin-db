			"dialogs": [
				{
					"id": 742510201,
					"content": "ยินดีที่ได้จิบน้ำไปพลาง ได้แชร์เรื่องราวในอดีตกับคุณไปพลางแบบนี้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510202,
						742510203
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510202,
					"content": "(ขอนั่งแบบนี้อีกสักพักละกัน)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510204
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742510204,
					"content": "โอเค ขอให้คุณเดินทางโดยสวัสดิภาพนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510203,
					"content": "ได้เวลาจบงานเลี้ยงน้ำชาแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510204
					],
