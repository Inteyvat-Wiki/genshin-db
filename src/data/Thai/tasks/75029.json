					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290144,
					"content": "นักรบ ฉันกำลังรอคำตอบอยู่นะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
