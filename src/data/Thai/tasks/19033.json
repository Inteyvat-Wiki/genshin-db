			"dialogs": [
				{
					"id": 1903201201,
					"content": "เฮ้อ เหนื่อยชะมัด ในที่สุดก็ได้พักซะที",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201202
					],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201202,
					"content": "ฉันทำเกินไปหน่อยรึเปล่านะ ดูเหมือนคนจะพากันกลัวแทบตายเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201203
					],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201203,
					"content": "ขอโทษนะ คุณคือ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903201204
					]
				},
				{
					"id": 1903201204,
					"content": "#เฮ้!{F#เธอ}{M#นาย}เข้ามาที่นี่ได้ยังไงกัน!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201205
					],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201205,
					"content": "เอ่อ ช่างเหอะ เมื่อกี้ได้ยินหมดแล้วล่ะสิ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201206
					],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201206,
					"content": "ฉันทำงานอยู่ที่นี่น่ะ ต้องแสดงเป็นผี ตอนนี้เป็นเวลาพักพอดี ฉันก็เลยถอดชุดออกจะได้หายใจคล่องหน่อย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201207,
						1903201208
					],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201207,
					"content": "ที่แท้ที่นี่ก็ไม่มีผีใช่มั้ย?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903201209
					]
				},
				{
					"id": 1903201209,
					"content": "ใช่แล้ว จะมีผีจริง ๆ ได้ไงล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201210
					],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201210,
					"content": "ไม่ว่าพวกเรา หรือคนที่มาร่วมงานก็ไม่มีใครอยากเห็นผีจริง ๆ หรอกน่า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201211
					],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201211,
					"content": "สิ่งที่พวกเขาต้องการคือบรรยากาศ หรือสถานการณ์ที่ทำให้พวกเขารู้สึกตื่นเต้น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201212
					],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201212,
					"content": "เวลาคนเรากำลังตกใจหรือต้องเผชิญหน้ากับเหตุการณ์ที่ไม่คาดคิด พวกเขาก็จะพูดสิ่งที่ไม่กล้าพูดออกมา นี่คือจุดมุ่งหมายของการประชันความกล้าไงล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201213,
						1903201214
					],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201213,
					"content": "ฉันก็คิดเหมือนกัน",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903201215
					]
				},
				{
					"id": 1903201215,
					"content": "เอาเถอะ ใกล้ถึงเวลาทำงานของฉันละ ขอให้เธอกับเพื่อนสนุกกับงานนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201214,
					"content": "(Chongyun ต้องผิดหวังมากแน่ ๆ เลย)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903201215
					]
				},
				{
					"id": 1903201208,
					"content": "แค่พยายามหลอกให้คนกลัวเท่านั้นเอง?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903201209
					]
				}
			]
		}
	]
}