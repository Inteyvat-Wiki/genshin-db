				"points": []
			},
			"dialogs": [
				{
					"id": 722270301,
					"content": "คอนตรงนี้จัดการเรียบร้อยแล้วล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722270302,
					"content": "เก่งมากเลย! นักผจญภัยที่แท้จริงเป็นแบบเองน่ะเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270303
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270303,
					"content": "เอ่อ... เมื่อก่อนก็เคยมีคนมาที่นี่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270304
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270304,
					"content": "#แต่ว่าไม่ได้เก่งเหมือนพี่ {NICKNAME} กับ Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270305
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270305,
					"content": "คนอื่น?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722270306,
					"content": "อื้ม พวกเขามาตามหา Maushiro น่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270307,
						722270308
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270307,
					"content": "หรือว่าจะเป็นคุณ Sumida...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270309
					]
				},
				{
					"id": 722270309,
					"content": "ว่าแต่ Maushiro คืออะไรกันแน่? ถึงจะเคยได้ยินมาว่าเป็นเครื่องดนตรีของชาวเกาะ Tsurumi ก็ตาม...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722270310,
					"content": "อื้อ ~ มันคือของที่ส่งเสียงออกมาได้น่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270311
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270311,
					"content": "เพราะว่าทะเลหมอกนั่น ทำให้พวกเรามองเห็นสิ่งของได้ไม่ชัดเจนใช่มั้ยล่ะ? ดังนั้นทุกคนจึงใช้ Maushiro เพื่อบอกตำแหน่งของตัวเอง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270312
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270312,
					"content": "เพราะว่าถ้าตะโกนจะหนวกหูเกินไปหน่อย! แล้วถ้าทำแบบนั้นคอก็จะพังด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270313
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270313,
					"content": "มองไม่เห็นอะไรเลยจริง ๆ ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722270314,
					"content": "ใช่มั้ยล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270315
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270315,
					"content": "พะ... คุณปู่ Mata ยังบอกอีกว่า เสียงของ Maushiro ยังสามารถนำทางกลับบ้านให้กับดวงวิญญาณที่หลงอยู่ในทะเลหมอกได้อีกด้วย ดังนั้นจึงถือว่าเป็นสิ่งที่สำคัญมากเลยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270316
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270316,
					"content": "หืม? สำคัญขนาดนี้เลยเหรอเนี่ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722270317,
					"content": "มิน่าล่ะพิธีกรรมถึงได้สำคัญขนาดนั้น",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270318
					]
				},
				{
					"id": 722270318,
					"content": "#อื้อ พี่ {NICKNAME} กับ Paimon จะต้องสนุกกับพิธีกรรมแน่ ๆ เลย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270319
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270319,
					"content": "พวกพี่ไปกันก่อนเถอะ ผมยังอยากอยู่ที่ใต้ต้นไม้อีกสักพักน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270320
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270320,
					"content": "จะไม่เป็นไรเหรอ? ข้างนอกอาจจะมีมอนสเตอร์นะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722270321,
					"content": "ไม่เป็นไรหรอก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270308,
					"content": "หรือว่านั่นจะเป็นคำขอสุดหินที่คุณ Katheryne เคยบอก...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270309
					]
				}
			]
