			"dialogs": [
				{
					"id": 722270101,
					"content": "#ตอนที่พี่ {NICKNAME} ต่อสู้ ดูเท่สุด ๆ ไปเลยล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270102
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270102,
					"content": "ที่แท้ Ruu ก็อยู่ที่นี่เอง!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270103,
						722270104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722270103,
					"content": "ไม่เป็นไรใช่มั้ย?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270105
					]
				},
				{
					"id": 722270105,
					"content": "ผมไม่เป็นอะไร!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270106
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270106,
					"content": "มอนสเตอร์พวกนั้น...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270108
					]
				},
				{
					"id": 722270108,
					"content": "ไม่รู้ว่ามอนสเตอร์พวกนั้นมาจากไหนกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270109
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270109,
					"content": "จริงด้วยล่ะ ดูเหมือนจะไม่ใช่สิ่งมีชีวิตที่อาศัยอยู่ที่นี่นะ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722270110,
					"content": "อื้ม แต่ก่อน ที่นี่ไม่มีของพวกนี้หรอกนะ ไม่มีพวกคนที่มีขนเยอะ แล้วก็ไม่มีพวกหุ่นยนต์ตัวใหญ่ด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270111
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270111,
					"content": "เมื่อก่อนเราเคยมีสัตว์พื้นเมืองที่เราเรียกว่า \"Wen Kamuy\" พวกมันเชื่องมาก แล้วยังอร่อยมากอีกด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270112
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270112,
					"content": "ไม่เคยได้ยินมาก่อน",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270113
					]
				},
				{
					"id": 722270113,
					"content": "ผมก็คิดอย่างนั้นเหมือนกัน ไม่รู้ว่าตั้งแต่เมื่อไหร่กันที่พวก Wen Kamuy หายตัวไป และมอนสเตอร์พวกนี้ก็โผล่ขึ้นมาแทน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270114
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270114,
					"content": "ไม่รู้ว่ามาจากข้างนอกทะเลหมอกนั่นรึเปล่า...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270115
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270115,
					"content": "ข้างนอกนั่นมี Hilichurl ด้วยนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270116
					]
				},
				{
					"id": 722270116,
					"content": "ฟังดูอันตรายจัง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270117,
						722270119
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270117,
					"content": "ก็อันตรายจริง ๆ นั่นแหละ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270118
					]
				},
				{
					"id": 722270118,
					"content": "แต่มันก็ทำให้ประสบการณ์การผจญภัยน่าสนใจขึ้นนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722270120,
					"content": "ผมเองก็อยากผจญภัยเหมือนกัน!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270121
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270121,
					"content": "ฮิฮิ ถ้า Ruu โตขึ้น ฉันเชื่อว่า Ruu จะต้องเป็นนักผจญภัยที่เยี่ยมยอดมาก ๆ เลยล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722270122,
					"content": "อื้อ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270123
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270123,
					"content": "งั้นเรื่องคอนปล่อยให้พวกเราจัดการแล้วกันนะ ที่นี่มีมอนสเตอร์อยู่ ถ้าให้ Ruu วิ่งไปวิ่งมาจะต้องอันตรายมากแน่ ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722270124,
					"content": "ให้พวกเราจัดการเอง",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 722270119,
					"content": "แต่ว่าการผจญภัยมันสนุกมากเลยนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270120
					]
				},
				{
					"id": 722270104,
					"content": "ไม่ได้รับบาดเจ็บใช่มั้ย",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270105
					]
				}
			]
		},
