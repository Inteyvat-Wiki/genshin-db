						722390323
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390323,
					"content": "ฝากไปบอกพวกเขาว่า อย่าได้ยอมแพ้ ความหวังของ Byakuyakoku อยู่ท่ามกลางพวกเขา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390320
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
