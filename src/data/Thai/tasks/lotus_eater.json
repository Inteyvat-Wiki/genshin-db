			]
		},
		{
			"id": 7223919,
			"completionStepIds": [
				7223906
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Adonis",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722391901,
					"content": "เมื่อดวงตะวันลับขอบฟ้า ความมืดมิดก็บังเกิด...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391902
					]
				},
				{
					"id": 722391902,
					"content": "แต่แสงสว่างนั้น ยังคงซ่อนอยู่ในตัวเรา...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391903
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391903,
					"content": "เฮ้อ... ฉันเกือบลืมไปแล้ว นานแค่ไหนแล้วนะที่ไม่ได้ยินประโยคนี้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391904
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391904,
					"content": "บอกฉันมา สหาย ใครส่งเธอมา?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391905
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391905,
					"content": "Supada no Hiko",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391906
					]
				},
				{
					"id": 722391906,
					"content": "อาจารย์ Spartacus?! เป็นท่านอาจารย์งั้นเหรอ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391907
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391907,
					"content": "เขาอยู่ที่ไหน? ฉันรู้ว่าเขาถูกพรรคพวกของบุตรแห่งสุริยันจับตัวไปในช่วงชุลมุน จากนั้นก็ไม่ได้ข่าวคราวของเขาอีกเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391908
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391908,
					"content": "เขาถูกขังอยู่ที่แท่นบูชาของ The Serpent's Heart... แต่เกรงว่าสภาพของเขาคงออกมาไม่ได้แล้ว ดังนั้นจึงขอร้องให้พวกเรามาตามหาพวกเธอ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391909,
					"content": "เจ้าบุตรแห่งสุริยันบ้านั่น...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391910
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391910,
					"content": "อาจารย์มีคำสั่งอะไรถึงได้ส่งพวกเธอมา?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391911
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391911,
					"content": "คุณลุงแค่ฝากพวกเรามาส่งข้อความเท่านั้นแหละ เขาบอกว่า...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391912,
					"content": "เหล่าเด็ก ๆ อย่ายอมแพ้โดยเด็ดขาด ความหวังของ Byakuyakoku อยู่ท่ามกลางพวกเธอ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391913,
					"content": "......",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391914
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391914,
					"content": "......",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391915
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391915,
					"content": "ขอโทษ... ขอโทษครับ! อาจารย์ พวกเราทำให้คุณผิดหวังซะแล้ว!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391916
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391916,
					"content": "ทำไมเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391917
					]
				},
				{
					"id": 722391917,
					"content": "ไม่มีกองทัพต่อต้านอีกต่อไปแล้ว...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391918
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391918,
					"content": "เอ่อ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391919
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391919,
					"content": "หลังจากที่อาจารย์ถูกจับตัวไป แกนหลักของกองทัพต่อต้านก็ถูกทำลายลง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391920
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391920,
					"content": "เหลือเพียงลูกศิษย์ที่คอยติดตามอาจารย์อย่างพวกเรา ที่หนีรอดมาได้ก็เพราะอยู่ห่างไกลจากศูนย์กลางของเหตุการณ์",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391921
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391921,
					"content": "จากนั้นพวกเราก็หนีไปยังจุดซ่อนตัวที่เตรียมไว้ล่วงหน้า หวังจะรวบรวมกำลังพลขึ้นมาใหม่อีกครั้ง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391922
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391922,
					"content": "เดิมทีในหมู่พวกเรามีนักยุทธศาสตร์ที่ยอดเยี่ยม นักวิชาการมืออาชีพ นักเวทที่มีทักษะ และแพทย์ที่เชื่อถือได้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391923
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391923,
					"content": "ก็ฟังดูดีมีความหวังอยู่นี่นา...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391924
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391924,
					"content": "พวกเราเองก็คิดอย่างนั้น ขอแค่มีเวลา พวกเราก็จะสามารถฟื้นฟูกำลังขึ้นมาใหม่ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391925
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391925,
					"content": "แต่สิ่งเหล่านี้ต้องการเงินทุน... ไม่ว่าจะทำอะไรก็ต้องใช้เงินทุน พวกเรามีหมดทุกอย่าง แต่สิ่งที่ขาดก็คือเงิน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391926
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391926,
					"content": "สุดท้ายก็มีคนเสนอไอเดียขึ้นมา... ให้เราขาย Dragonbone Orb",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391927
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391927,
					"content": "Dragonbone Orb คืออะไร?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391928
					]
				},
				{
					"id": 722391928,
					"content": "เป็นผลไม้ที่ออกมาจาก Dragonbone Flowers ภายใต้สถานการณ์พิเศษ เป็นสิ่งที่หายากมาก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391929
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391929,
					"content": "มันจะสร้างกลิ่นหอมสดชื่นออกมา ซึ่งจะทำให้ผ่อนคลายจิตใจ ช่วยให้ความคิดสงบ คลายความกังวล ดังนั้นมันจึงมีมูลค่าในตลาดที่สูงมาก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391930
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391930,
					"content": "มันวิเศษขนาดนั้นจริงเหรอ? ไม่ได้หลอกกันใช่ไหม?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391931
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391931,
					"content": "ถ้าเป็นแค่เรื่องหลอกก็ดีสิ... เป็นเพราะความซื่อบื้อของฉัน ที่มองอันตรายข้างในของมันไม่ออกตั้งแต่แรก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391932
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391932,
					"content": "ฉันจำไม่ได้แล้วว่าได้สูตรมาจากที่ไหน รู้แค่ว่า เจ้าสิ่งนี้ทำให้พวกเราได้เงินทุนเพิ่มขึ้นอย่างมหาศาล",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391933
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391933,
					"content": "ทุกอย่างกำลังไปได้ด้วยดี... แต่ไม่นานนี้ฉันพบว่าสหายร่วมรบของฉันเริ่มหลีกเลี่ยงความขัดแย้งและปฏิเสธที่จะต่อสู้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391934
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391934,
					"content": "คนพวกนี้เริ่มมากขึ้นเรื่อย ๆ จนพักหลังถึงขนาดมาขอออกจากหน่วยของฉัน และฉันก็ไม่อาจจะห้ามพวกเขาได้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391935
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391935,
					"content": "ทำไมถึงเป็นแบบนั้นล่ะ? เป็นเพราะการขาย Orb ทำเงินได้มาก ก็เลยไม่อยากต่อสู้รึเปล่า...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391948
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391948,
					"content": "เธอหมายถึงสิ่งล่อใจของเงินทองน่ะเหรอ? ไม่...ฉะ ฉันไม่รู้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391949
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391949,
					"content": "ฉันรู้แค่ว่าเมื่อผู้ถูกกดขี่พอใจกับชีวิตของพวกเขา พวกเขาก็จะเลิกต่อต้านไปเอง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391936
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391936,
					"content": "การล่มสลายจึงเริ่มขึ้นตั้งแต่ตอนนั้น และไม่อาจหวนคืนได้อีก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391947
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391947,
					"content": "บางทีฉันก็ถึงขั้นสงสัย ว่าสูตรในการทำเจ้าสิ่งนี้ เป็นสิ่งที่ผู้ปกครองเจ้าเล่ห์พวกนั้นจงใจส่งมาให้พวกเรารึเปล่า...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391950
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391950,
					"content": "เป็นไปได้มั้ยว่าการขายของพวกนี้ เป็นเพียงสิ่งที่เสแสร้งที่ผู้ปกครองเจ้าเล่ห์พวกนั้นสร้างขึ้นมา?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391937
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391937,
					"content": "เฮ้อ ถ้าหากเป็นอาจารย์ เขาจะจัดการกับสถานการณ์แบบนี้ยังไงนะ เขาจะตัดไฟแต่ต้นลมเลยรึเปล่านะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391938
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391938,
					"content": "ขอโทษนะท่านอาจารย์ ที่พวกเราไม่อาจกลายเป็นความหวังได้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391939,
						722391940
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391939,
					"content": "เสียใจที่ได้ยินอย่างนั้น...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391941
					]
				},
				{
					"id": 722391941,
					"content": "ฉันไม่มีหน้าไปเจออาจารย์หรอก...",
					"roleType": "TALK_ROLE_NPC",
