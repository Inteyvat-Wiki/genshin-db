						722390303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722390303,
					"content": "ขอบคุณนะ พวกเรารู้จักกันจริง ๆ เหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
