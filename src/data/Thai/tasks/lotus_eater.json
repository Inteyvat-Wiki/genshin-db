			"dialogs": [
				{
					"id": 722391801,
					"content": "แสงสว่างหลังตะวัน...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391802
					]
				},
				{
					"id": 722391802,
					"content": "นี่มันอะไรกัน รีบออกไปซะ!",
					"roleType": "TALK_ROLE_NPC",
