				"points": []
			},
			"dialogs": [
				{
					"id": 201020701,
					"content": "อื๋อ เธอส่งจดหมายไปแล้วเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020702
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020702,
					"content": "นี่คือจดหมายที่ Timmie เขียนถึงพ่อของเขา",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020703
					]
				},
				{
					"id": 201020703,
					"content": "จดหมายที่ Timmie ส่งให้พ่อ... เธอเองก็น่าจะได้ยินจากซิสเตอร์ Grace แล้วสินะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020704
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020704,
					"content": "จดหมายนี้น่ะ... ส่งไปไหนไม่ได้หรอกนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020705,
						201020708,
						201020712
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020705,
					"content": "งั้นก็ไม่ส่งแล้วงั้นเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020706
					]
				},
				{
					"id": 201020706,
					"content": "จะคิดยังไงก็ส่งไปไม่ได้นี่นะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020707
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020707,
					"content": "ช่วยไม่ได้ ยังไงฉันจะเก็บมันไว้ก่อนแล้วกันนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020717
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020717,
					"content": "เอาล่ะ ทิ้งจดหมายนี่ไว้ที่ฉันเนี่ยแหละ... ถือซะว่าส่งมันไปแล้วก็แล้วกันนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020718
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020718,
					"content": "เพื่อนรักของฉันจะต้องเข้าใจอย่างแน่นอน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020719
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020719,
					"content": "ขอบคุณนะ แล้วอย่าบอกเรื่องนี้กับ Timmie ล่ะ เธอต้องทำได้แน่ ใช่มั้ย? อย่างน้อย... ก็ช่วยดูของตอบแทนนี่หน่อยเถอะนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020708,
					"content": "เผาทิ้งซะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020709
					]
				},
				{
					"id": 201020709,
					"content": "ฮ่าฮ่าฮ่า เธอนี่เริ่มจะดูเป็นนักผจญภัยขึ้นเรื่อย ๆ แล้วนะ จริงจังกับทุกสิ่งทุกอย่างจริง ๆ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020710
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020710,
					"content": "แต่ว่าฉันไม่ใช่นักผจญภัยหรอกนะ ฉันมันก็แค่นายพรานทั่ว ๆ ไป",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020711
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020711,
					"content": "ฉันจะไม่เผาจดหมายนี่หรอกนะ และก็จะไม่เปิดด้วย... ฉันจะเก็บมันไว้อย่างดี",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020717
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020712,
					"content": "ให้ฉันเก็บมันไว้เอง",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020713
					]
				},
				{
					"id": 201020713,
					"content": "เธอจะเก็บมันไปทำไมล่ะ? อย่าบอกนะว่าเธอคิดว่าบางทีเพื่อนของฉันคนนั้นอาจจะยังมีชีวิตอยู่...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020714
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020714,
					"content": "...ขอแค่เธอเดินทางมากขึ้น ก็อาจจะได้พบกับเขา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020715
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020715,
					"content": "ฉันเองก็เคยคิดอย่างนี้เหมือนกัน ถึงขั้นลงมือทำด้วยนะ แต่ว่า...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020716
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020716,
					"content": "สุดท้ายก็ต้องยอมรับความจริง ความจริงที่ว่าเพื่อนรักของฉันได้ตายไปแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020717
					],
					"speakerTitle": "Draff"
				}
			]
