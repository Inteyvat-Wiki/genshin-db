						"stepId": 1302012,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Alhaitham"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130201201,
					"content": "ปรากฏว่า Siraj ไม่ได้มาที่ร้านเหล้า Narendra เองก็ไม่มีเบาะแสอะไรเลย... ดูเหมือนว่าจะถึงทางตันซะแล้วสิ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130201202,
					"content": "Alhaitham เธอจะไปให้สุดจริง ๆ เหรอ? เธอดูสนใจเรื่องนี้มาก ๆ จน Paimon รู้สึกแปลกใจ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130201203,
					"content": "ฉันคิดว่าเธอคาดเดาเหตุผลได้แล้วซะอีก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201204
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130201204,
					"content": "#เอ๋? Paimon จะไปเดาออกได้ไง {NICKNAME} เธอเดาออกมั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130201205,
					"content": "เธอรู้จัก Siraj?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130201206
					]
				},
				{
					"id": 130201206,
					"content": "อืม เพื่อนร่วมรุ่นน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201207
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130201207,
					"content": "อย่างนี้นี่เอง! เพราะงั้นพอ Aarav รายงานเธอ เธอเลยตามมาดูด้วยสินะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130201208,
					"content": "ที่เธอสนใจคดีนี้ไม่ใช่เพราะเนื้อหา แต่เป็นเพราะผู้ต้องสงสัยเป็นคนที่เธอรู้จักงั้นเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130201209,
					"content": "คำอธิบายเธอห่างไกลความจริงมาก แต่ฉันก็ไม่ได้คาดหวังว่าเธอจะได้คำตอบที่ถูกอยู่แล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201210
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130201210,
					"content": "ตอนนี้เธอจะเข้าใจอย่างนั้นไปก็ได้ พวกเราเข้าเรียนที่สถาบันในรุ่นเดียวกัน หลังจากนั้นฉันก็มาเป็นเสมียน ส่วนเขาก็ยังทำงานด้านวิชาการต่อไป",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201211
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130201211,
					"content": "เมื่อหนึ่งปีที่แล้ว เขาได้ยื่นคำร้องหัวข้อหนึ่งมา มหาปราชญ์ในเวลานั้นถามความคิดเห็นของฉัน แต่ฉันไม่ค่อยเห็นด้วยมากนัก เพราะในแง่ของผลลัพธ์ มันแตะ \"เรื่องวิวัฒนาการของมนุษย์\" ในบาปแห่งรากเหง้าทั้งหก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201212
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130201212,
					"content": "ตั้งแต่ \"เรื่องการวิวัฒนาการของมนุษย์\" จนถึง \"การกระทำสิ่งต้องห้ามโดยไร้ใจหวั่นเกรง\" บาปแห่งรากเหง้าทั้งหกเป็นจุดเริ่มต้นของความผิดทั้งหมดในโลกนี้ นักปราชญ์เองก็ใช้มันในการอ้างอิงสำหรับปฏิรูปกฎระเบียบในสถาบัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201213
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130201213,
					"content": "การวิจัยของ Siraj สำหรับฉันมันดูไร้เดียงสา แต่ผลลัพธ์สุดท้ายของเขาก็ข้ามเส้นอยู่ดี มหาปราชญ์พิจารณาความคิดเห็นต่าง ๆ จนท้ายที่สุดรายงานนั้นก็ไม่ได้รับการอนุมัติ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201214
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130201214,
					"content": "เพราะงี้เขาก็เลยมาซื้อพลังงานกับชิ้นส่วนอิเล็กทรอนิกส์...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130201215,
					"content": "น่าจะเพราะต้องการทำการทดลองโดยที่ไม่ได้รับอนุญาต",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201216
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130201216,
					"content": "ฟังดูน่าสงสัยสุด ๆ ยังไงก็ควรหยุดเขาดีกว่าเนอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130201217,
					"content": "Ilyas นายลองนึกดูดี ๆ อีกสักครั้งสิ เผื่อจะนึกอะไรใหม่ออก?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130201218,
					"content": "ขอโทษด้วย ผมพยายามนึกดูหลายครั้งแล้ว แต่ไม่ว่าจะพยายามนึกแค่ไหน เรื่องราวพวกนั้นก็ดูพร่าเลือน เหมือนมีหมอกหนาปกคลุมอยู่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201219
					],
					"speakerTitle": "Ilyas"
				},
				{
					"id": 130201219,
					"content": "เมื่อมนุษย์ถูกกระตุ้นอย่างรุนแรง ด้วยกลไกป้องกันตัวเอง อาจจะทำให้ความทรงจำบางส่วนหายไปโดยไม่รู้ตัว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201220
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130201220,
					"content": "แต่ความทรงจำพวกนั้นไม่ได้หายไปจริง ๆ มันแค่ถูกผนึกไว้ชั่วคราว หากได้รับการกระตุ้นอย่างเหมาะสม ก็ยังมีโอกาสฟื้นกลับมาได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201221
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130201221,
					"content": "พยายามนึกถึงเรื่องที่เธอสนใจ ไม่จำเป็นต้องเกี่ยวกับคดีนี้ก็ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201222
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130201222,
					"content": "ที่จริงผมก็รู้สึกว่าตัวเองลืมอะไรไปหลายอย่าง ไม่ใช่แค่ส่วนที่เกี่ยวข้องกับตอนที่ถูกจับไปทดลองเท่านั้น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201223
					],
					"speakerTitle": "Ilyas"
				},
				{
					"id": 130201223,
					"content": "ผมเป็นคนยังไง ทำอะไรมาบ้าง บางส่วนก็นึกออก แต่บางส่วนไม่ว่าจะทำยังไงก็นึกไม่ออก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201224
					],
					"speakerTitle": "Ilyas"
				},
				{
					"id": 130201224,
					"content": "แต่ผมจำได้ราง ๆ ว่าผมมี \"สิ่งที่ต้องทำ\" อยู่สองอย่าง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201225
					],
					"speakerTitle": "Ilyas"
				},
				{
					"id": 130201225,
					"content": "ลองพูดออกมาสิ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201226
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130201226,
					"content": "อย่างแรกคือ \"รับเงินเดือนจากสถาบัน และมอบให้น้องสาวของผมที่อยู่ที่ Gandharva Ville\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201227
					],
					"speakerTitle": "Ilyas"
				},
				{
					"id": 130201227,
					"content": "ผมจำรายละเอียดได้ไม่แน่ชัด... แต่ที่ผมจำได้คือผมต้องให้เงินน้องสาวทุกเดือนเพื่อนำไปจุนเจือครอบครัว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201228
					],
					"speakerTitle": "Ilyas"
				},
				{
					"id": 130201228,
					"content": "อย่างที่สองล่ะ? อย่างที่สองคืออะไร?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130201229,
					"content": "นึกไม่ออกจริง ๆ ขอโทษนะ ผมลืมหลายสิ่งหลายอย่างไปมากมายเหลือเกิน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201230
					],
					"speakerTitle": "Ilyas"
				},
				{
					"id": 130201230,
					"content": "ไม่น่าแปลกใจ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201231
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130201231,
					"content": "มีแค่เธอเท่านั้นที่เคยเจอ Siraj และมีแค่เธอเท่านั้นที่รู้ตำแหน่งที่แน่นอนของถ้ำนั้น เพราะงั้น พวกเราจะให้การสนับสนุนที่จำเป็นทั้งหมดเพื่อช่วยให้เธอฟื้นฟูความจำได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201232
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130201232,
					"content": "การที่สูญเสียความทรงจำไป... มันคงจะเจ็บปวดมากเลยสินะ แต่ไม่ต้องห่วงนะ พวกเราจะช่วยให้นายจำมันได้เอง!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130201233,
					"content": "ขอบคุณมากนะ แต่ไม่ใช่ \"ความเจ็บปวด\" หรอกนะ มันเป็นความรู้สึกที่ผมก็อธิบายไม่ถูก...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201234
					],
					"speakerTitle": "Ilyas"
				},
				{
					"id": 130201234,
					"content": "การที่ผมสูญเสียความทรงจำมากจนเกินไป มันทำให้ประสาทการรับรู้ของผมเลือนรางขึ้น ในสมองอื้ออึงราวกับวินาทีต่อมาจะหมดสติไปให้ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201235
					],
					"speakerTitle": "Ilyas"
				},
				{
					"id": 130201235,
					"content": "แต่ในความรู้สึกวิงเวียนนี้ กลับทำให้ผมรู้สึกถูกปลดปล่อย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201236
					],
					"speakerTitle": "Ilyas"
				},
				{
					"id": 130201236,
					"content": "ไม่ว่าจะยังไง ผมก็ขอขอบคุณทุกคนมาก สติของผมรู้สึกแจ่มชัดขึ้นมานิดหน่อยแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201237
					],
					"speakerTitle": "Ilyas"
				},
				{
					"id": 130201237,
					"content": "ผมจำได้ว่าผมทำงานพิเศษอยู่ในที่ที่เรียกว่า \"ศูนย์จัดเตรียมการวิจัย\" ทุกเดือนจะได้รับเงินเดือนจากที่นั่น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201238
					],
					"speakerTitle": "Ilyas"
				},
				{
					"id": 130201238,
					"content": "เข้าใจแล้ว งั้นไปหาผู้ดูแลที่นั่นกันเถอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alhaitham"
				}
			]
		},
