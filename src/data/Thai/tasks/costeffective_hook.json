			]
		},
		{
			"id": 7310412,
			"completionStepIds": [
				7310412
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7310412",
							"2"
						],
						"stepId": 7310412,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kayvan",
					"Helbet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731041201,
					"content": "ดูท่าทางราบรื่นดี ถึงเวลาที่จะปิดจ๊อบการตกปลาครั้งสุดท้ายแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041202
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041202,
					"content": "เห้อ... นี่มันสามครั้งแล้วนะ ถึงจะเป็นปลาขนาดเท่าหัวแม่มือก็โอเคนะ อย่างน้อยก็มาติดเบ็ดของฉันสักตัวเถอะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041203
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041203,
					"content": "Kayvan ทำเหยื่อตกปลา แล้วเริ่มตกปลา...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731041204
					]
				},
				{
					"id": 731041204,
					"content": "หลังจากผ่านไปสักครู่ พัสดุเปียก ๆ กล่องที่สามก็ถูกดึงขึ้นมาบนผิวน้ำด้วยสายเบ็ดนั้น",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731041205
					]
				},
				{
					"id": 731041205,
					"content": "คุณดูเอาเองเถอะ ฉันไม่อยากดูแล้ว...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041206
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041206,
					"content": "โอเคเลย! ฉันดูหน่อย... สภาพยังดี ไม่มีตรงไหนชำรุด",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041207
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731041207,
					"content": "เพอร์เฟกต์สุด ๆ! คุณ Kayvan สมแล้วที่เป็น \"ฉากปลาติดตะขอสุดประทับใจ\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041208
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731041208,
					"content": "อ่ะฮ่า ฮ่าฮ่า... คุณปิดจ๊อบได้ก็ดีแล้ว ๆ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041209
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041209,
					"content": "คิดไม่ถึงว่าจะตกวัตถุโบราณสามชิ้นขึ้นมาได้จากการตกเบ็ดทั้งสามครั้ง แล้วก็ไม่มีปลาตัวไหนมาติดเบ็ดเลยด้วย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041210,
						731041211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731041210,
					"content": "นี่แหละคือความเจ๋งของคุณ Kayvan",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731041212
					]
				},
				{
					"id": 731041212,
					"content": "นี่! ฉันจริงจังกับการตกปลาตัวใหญ่มาตลอดเลยนะ ไม่เคยอยากที่จะตกวัตถุโบราณอะไรนี่เลยสักนิด!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041213
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041213,
					"content": "ถึงเทคนิคการตกปลาของฉันจะไม่เก่ง ไม่มีแรงเหวี่ยงเบ็ด... อะไรต่อมิอะไร...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041214
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041214,
					"content": "แต่ฉันก็เหวี่ยงเบ็ดไปหลายครั้งแล้ว ต่อให้เป็นการเสี่ยงโชค ก็ควรตกได้ปลามาบ้างสิ จริงมั้ยล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041215
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041215,
					"content": "จนถึงตอนนี้ ฉันยังตกปลาไม่ได้สักตัวเลยนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041216
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041216,
					"content": "เอ่อ... พูดแบบนี้แล้ว มันก็น่าแปลกจริง ๆ ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731041217,
					"content": "เอ่อ... คุณ Kayvan ถ้าคุณสนใจล่ะก็ ฉันสามารถแนะนำให้คุณรู้จักกับนักวิชาการที่ศึกษาการตกปลาได้นะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041218
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731041218,
					"content": "เขามีส่วนร่วมในการออกแบบเหยื่อตกปลาและคันเบ็ดทุกชนิดที่ได้รับความนิยมในตลาดตอนนี้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041219
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731041219,
					"content": "แม้จะไม่รู้เลยว่าทำไมคุณถึงตกปลาไม่ได้ แต่ว่า... ไปสอบถามจากผู้เชี่ยวชาญก็ไม่เลวเหมือนกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041220
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731041220,
					"content": "ไม่แน่ นักวิชาการคนนั้นอาจสนใจในตัวคุณก็ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041221
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731041221,
					"content": "สนใจในตัวฉัน? คุณหมายถึง สนใจเอกลักษณ์ของฉันที่ \"ตกได้หมดทุกอย่างยกเว้นปลา\" เหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041222
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041222,
					"content": "แต่ว่าที่คุณพูดก็ไม่ผิด ฉันจะใช้โอกาสนี้ เพื่อดูว่าเกิดปัญหาอะไรกับเทคนิคการตกปลาของฉัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041223
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041223,
					"content": "ไม่มีปัญหา เรื่องแนะนำให้รู้จักกัน ให้ฉันจัดการเองแล้วกันนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041224
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731041224,
					"content": "แต่ว่านะ เรื่องตกปลาอะไรพวกนี้ พวกนักวิชาการที่แค่นั่งอ่านหนังสืออยู่แต่ในห้องจะเข้าใจเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041225
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041225,
					"content": "อ้อ... จริงสิ! ขอบคุณนักเดินทางที่ช่วยนะ นี่คือค่าตอบแทน ช่วยรับไว้ด้วยเถอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041211,
					"content": "บางทีนี่อาจจะเป็นหนึ่งในทักษะของการตกปลาล่ะมั้ง...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731041212
					]
				}
			]
		},
