			"dialogs": [
				{
					"id": 105020501,
					"content": "เกี่ยวกับที่มาและปัญหาของ Mona...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020502
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 105020502,
					"content": "ที่แท้ก็เป็นอย่างงี้ ฉันเข้าใจแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020503
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 105020503,
					"content": "ในเมือง Mondstadt มี<color=#00E1FFFF>ห้องทดลองเวทมนตร์</color>ที่ว่างอยู่ แต่ไม่รู้โดนใครไปผนึกไว้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020504
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 105020504,
					"content": "แม้ว่ามีผู้เชี่ยวชาญหลายคนที่สามารถปลดผนึกได้ แต่พวกเขาต่างก็มีห้องทดลองของตนเอง ก็เลยไม่สนใจในเรื่องนี้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020505
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 105020505,
					"content": "ฉันคิดว่า ถ้าโหรแห่งดวงดาวที่คุณพูดถึงสามารถปลดผนึกได้ เจ้าของตึกก็คงเต็มใจที่จะให้เธออาศัยอยู่ที่นั่น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020506,
						105020507
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 105020506,
					"content": "ฉันคิดว่าเธอน่าจะมีวิธี",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020508
					]
				},
				{
					"id": 105020508,
					"content": "โอเค งั้นเดี๋ยวฉันจะบอกตำแหน่งของตึกนั้นให้คุณ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 105020507,
					"content": "ฉันจะพาเธอไปดู",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020508
					]
				}
			]
		},
		{
			"id": 1050206,
			"completionStepIds": [
				1050211
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
