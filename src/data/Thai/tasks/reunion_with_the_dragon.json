					"nextDialogs": [
						3840208
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840208,
					"content": "หึ กองอัศวินต้องรู้จักออกแรงบ้างนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
