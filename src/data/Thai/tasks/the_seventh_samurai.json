	"talks": [
		{
			"id": 7215401,
			"completionStepIds": [
				7215401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7215401",
							"2"
						],
						"stepId": 7215401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Xavier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721540101,
					"content": "เดี๋ยวก่อน! คุณทหาร คำที่คุณอ่านเมื่อกี้ใส่อารมณ์ไม่ถูกนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540102
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540102,
					"content": "\"ซามูไร เสมือนดั่งสายลมที่กวาดโลก\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540103
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540103,
					"content": "คุณยังจำที่ฉันบอกได้มั้ย ต้องมีความรู้สึกอิสระ และรู้สึกเหมือนผ่านโลกมาโชกโชน เข้าใจไหม?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540104
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540104,
					"content": "ประโยคนี้เป็นหัวใจสำคัญของการแสดงทั้งหมด คุณต้องแสดงอารมณ์ออกมาอย่างครบถ้วน อิ่มเอิบและสมบูรณ์แบบ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540105
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540105,
					"content": "เอ่อออ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540106
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540106,
					"content": "อีกทั้งเมื่อตวัดดาบ ไม่ต้องเร็วขนาดนั้น ต้องให้ตัวเองแน่ใจว่าอยู่ในเลนส์กล้อง ไม่อย่างนั้น \"เครื่องโปรเจคเตอร์\" จะจับภาพไม่ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540107
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540107,
					"content": "ตั้งท่าไว้ก่อน แล้วค่อยหยุด เข้าใจมั้ย? หยุดครู่หนึ่งแล้วค่อยฟันออกไป",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540108
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540108,
					"content": "แต่เวลาสู้กับคนจริง ๆ ตวัดดาบแบบนี้ไม่ได้นะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540109
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540109,
					"content": "นี่ไม่ใช่สิ่งที่เนื้อเรื่องและฝ่ายการผลิตต้องการ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540110
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540110,
					"content": "เอาล่ะ ไปเตรียมตัวอีกสักหน่อย แล้วเราค่อยมาต่อกันอีกครั้งก็แล้วกัน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540111,
						721540112
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540111,
					"content": "พวกเธอกำลังทำอะไรอยู่นะ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540114
					]
				},
				{
					"id": 721540114,
					"content": "#อ๋าา คุณนี่เอง! สวัสดี{F#เด็กสาว}{M#เด็กหนุ่ม}ที่น่ารักของฉัน ต้องเป็นสายลมที่พัดพาเธอให้ผ่านเข้ามาหาฉันแน่ ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540115
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540115,
					"content": "อย่างที่คุณเห็น ฉันกับทหารคนนี้กำลังถ่ายทำ \"ภาพยนตร์ดาบ\" ที่มีชื่อว่า \"ซามูไรคนที่เจ็ด\" อยู่น่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540116
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540116,
					"content": "อ่อ \"ภาพยนตร์ดาบ\" เป็นคำที่ฉันตั้งขึ้นมาเพื่อใช้เรียก \"ภาพยนตร์\" ประเภทนี้น่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540117
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540117,
					"content": "เน้นฉากการต่อสู้กันด้วยดาบ ทำให้คนดูรู้สึกเหมือนเดินอยู่ใน \"สนามรบ\" ...ก็ประมาณนี้แหละ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540118,
						721540121
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540118,
					"content": "ไม่คิดเลยว่า Toranosuke จะมีเวลาว่าง...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540119
					]
				},
				{
					"id": 721540119,
					"content": "งานนี้ได้รับการอนุมัติจากนายท่านแล้ว ท่านกล่าวว่า นี่เป็นการช่วยให้ซามูไรของ Shogunate ดูน่าเกรงขามมากยิ่งขึ้น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540120
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540120,
					"content": "ฉันก็ไม่รู้ว่า Xavier พูดโน้มน้าวท่านได้ยังไง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540123
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540123,
					"content": "พูดกันตามจริงแล้ว ท่าน Mikoshi Genjirou เป็นคน...เอาจริงเอาจัง แต่ในขณะเดียวกันก็ยังเป็นคนที่เข้าอกเข้าใจผู้อื่นอีกด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540124
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540124,
					"content": "หลังจากที่ฉันได้คุยกับเขาอย่างจริงจังแล้ว เขาก็ตอบรับคำขอร้องของฉัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540125
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540125,
					"content": "แต่ว่า... มีข้อแลกเปลี่ยนคือ ฉันต้องสร้าง \"ภาพยนตร์\" เกี่ยวกับ Shogunate โดยให้มีซามูไรเป็นตัวเอก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540126
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540126,
					"content": "ฉันว่าหัวข้อแบบนี้ก็น่าสนใจดี ก็เลยตอบตกลงไป และ ท่าน Mikoshi Genjirou เองก็ดีใจมาก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540127
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540127,
					"content": "นอกจากจะสั่งให้นายทหารมาคอยช่วยฉันแล้ว ยังส่งกองทหารฝีมือดีมาให้ฉันด้วย และเขายังบอกอีกว่า...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540128
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540128,
					"content": "\"ในฉากที่ต่อสู้กันด้วยดาบนั้น ต้องแสดงให้เห็นถึงความน่าเกรงขามของซามูไรและ Shogunate\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540129
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540129,
					"content": "คงต้องบอกว่า ท่าน Mikoshi Genjirou เป็นคนที่มีวิสัยทัศน์ยาวไกลจริง ๆ นึกไม่ถึงเลยว่าจะใช้ \"ภาพยนตร์\" ในการโฆษณา...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540130
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540130,
					"content": "และสำหรับฉัน ทุกเรื่องที่เป็นประโยชน์ในการสร้าง \"ภาพยนตร์\" ฉันไม่ปฏิเสธอยู่แล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540131,
						721540135
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540131,
					"content": "การถ่ายทำราบรื่นดีมั้ย?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540132
					]
				},
				{
					"id": 721540132,
					"content": "พูดตามตรงเลยนะ... ไม่ราบรื่นเลย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540133
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540133,
					"content": "แม้ว่าศิลปะการต่อสู้ของทหารทุกท่านจะแข็งแกร่งมาก แต่ไม่เคยชินกับการต่อสู้แบบ \"การแสดง\" อย่างนี้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540134
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540134,
					"content": "ไม่ใช่แค่การตวัดดาบที่รวดเร็ว จน \"เครื่องโปรเจคเตอร์\" ไม่สามารถบันทึกได้ แล้วยังมีที่บางครั้งก็วิ่งหลุดออกจากกล้องไป...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540140
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540140,
					"content": "นักเดินทาง ถ้าเธอว่างล่ะก็ ช่วยแสดงให้เหล่าทหารดู ตามบทที่ฉันเขียนได้ไหม?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540141
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540141,
					"content": "ฉันเชื่อว่า ด้วยความสามารถและความเข้าใจของเธอ จะต้องแสดงได้อย่างยอดเยี่ยมแน่นอน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540142
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540142,
					"content": "หลังจากที่ได้ดูการแสดงในฐานะคนดู พวกเขาจะต้องเข้าใจฉากนี้ได้ดีขึ้นแน่ ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540143
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540143,
					"content": "มามามา เธอมาดูบทก่อน ช่วงนี้หลัก ๆ คือการแสดงต่อสู้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540144,
						721540145,
						721540146,
						721540156
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540144,
					"content": "\"สนามรบนี้ ก็ถือว่าแพ้แล้ว\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540147
					]
				},
				{
					"id": 721540147,
					"content": "นี่เป็นบทของฉากต่อไป... ฉากนี้หลัก ๆ คือต่อสู้ ไม่มีบทพูดอะไรมาก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540148
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540148,
					"content": "ขอฉันอ่านบทก่อน...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540149
					]
				},
				{
					"id": 721540149,
					"content": "อ้อจริงสิ เธอแสดงเป็นตัวละครที่ชื่อว่า \"Juusaburou\" เขาและเพื่อน ๆ ของเขา ถูกจ้างโดยชาวบ้านให้ปกป้องหมู่บ้าน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540150
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540150,
					"content": "อ่า ฉากนี้ยังมีเพื่อนคนหนึ่งที่ชื่อว่า \"Kyuuzou\" มีบทพูดด้วย... เดี๋ยวฉันเล่นบทนี้เอง ลองอ่านดูก่อนละกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540151
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540151,
					"content": "เธอจะต้องเข้าถึงตัวละคร ต้องเข้าใจตัวละคร! และคิดว่าตัวเองเป็น \"Juusaburou\" เข้าใจมั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540152,
						721540153
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540152,
					"content": "ขะ... เข้าใจแล้ว",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540154
					]
				},
				{
					"id": 721540154,
					"content": "ดีมาก เยี่ยมมาก สุดยอด!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540155
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540155,
					"content": "ถ้าเธอเตรียมตัวเสร็จแล้วบอกฉันนะ ฉันจะไปปรับ \"เครื่องโปรเจคเตอร์\" สักหน่อย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540153,
					"content": "ฉันคือ Juusaburou",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540154
					]
				},
				{
					"id": 721540145,
					"content": "\"ต่อให้ตกระกำลำบาก ซามูไรก็คือซามูไร\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540147
					]
				},
				{
					"id": 721540146,
					"content": "\"พวกเธอคือหุ่นไล่กาที่ได้มาตรฐาน...\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540147
					]
				},
				{
					"id": 721540156,
					"content": "\"...แต่ศัตรูของเราไม่ใช่นก\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540147
					]
				},
				{
					"id": 721540135,
					"content": "ฉันแสดงด้วยได้มั้ย?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540136
					]
				},
				{
					"id": 721540136,
					"content": "#ได้สิ! แน่นอน! คุณคือ{F#นางเอก}{M#พระเอก}ของฉันตลอดกาล!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540137
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540137,
					"content": "ฉันยังจำ \"เรื่องราวแห่ง Tatara\" ได้เสมอ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540138
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540138,
					"content": "แม้ว่าศิลปะการต่อสู้ของทหารทุกท่านจะแข็งแกร่งมาก แต่พวกเขาไม่เคยชินกับการต่อสู้แบบ \"การแสดง\" อย่างนี้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540139
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540139,
					"content": "ไม่ใช่แค่การตวัดดาบที่รวดเร็วจน \"เครื่องโปรเจคเตอร์\" ไม่สามารถบันทึกได้ แล้วยังมีที่บางครั้งก็วิ่งหลุดออกจากกล้องไป...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540140
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540121,
					"content": "เธอพูดโน้มน้าวเขาได้อย่างไร?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540122
					]
				},
				{
					"id": 721540122,
					"content": "ทหารคุณเข้าใจถูกแล้ว งานหลักของฉัน คือการโน้มน้าว ท่าน Mikoshi Genjirou คนนั้น ให้เขาอนุญาตให้ฉันสร้าง \"ภาพยนตร์\" ที่ Inazuma",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540123
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540112,
					"content": "\"นักรบ เสมือนดั่งสายลมที่กวาดโลก\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540113
					]
				},
				{
					"id": 721540113,
					"content": "อารมณ์ของคุณเวลาพูดประโยคนี้มันเดือดดาลเกินไป ควรจะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540114
					],
					"speakerTitle": "Xavier"
				}
			]
		},
