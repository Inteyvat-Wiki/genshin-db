			"dialogs": [
				{
					"id": 721540201,
					"content": "ตายจริง \"ภาพยนตร์\" ที่ถ่ายออกมาแบบนี้ไม่ค่อยถูก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540202
