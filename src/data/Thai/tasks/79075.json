				},
				{
					"id": 790750202,
					"content": "เรื่องโน้มน้าว Chauvigne ต้องรบกวนพวกคุณสองคนแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750203
