				},
				{
					"id": 700610702,
					"content": "ไล่ตะเพิดไปเรียบร้อยแล้วล่ะ!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700610703
					]
				},
				{
					"id": 700610703,
					"content": "อ้า ขอบคุณเธอมาก ๆ เลยนะ เอ้า นี่คือค่าตอบแทนของเธอ",
					"roleType": "TALK_ROLE_NPC",
