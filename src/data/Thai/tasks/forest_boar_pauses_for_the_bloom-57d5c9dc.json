			"dialogs": [
				{
					"id": 700610701,
					"content": "โอ้... พวกเธอกลับมาแล้วเหรอ? เป็นยังไงบ้าง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
