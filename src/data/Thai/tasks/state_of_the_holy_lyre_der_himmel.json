					"nextDialogs": [
						3790207
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790207,
					"content": "แบบนี้ ถ้าแค่เอาไว้เล่นแสดงในร้านของ Diluc ก็คงจะพอไหว...",
