							529.205,
							11.864,
							433.945
						],
						"pointId": 4
					}
				]
			},
			"dialogs": [
				{
					"id": 760690401,
					"content": "ความรู้สึกแบบนี้... ดูเหมือนจะเป็นร่างแปลงของเศษเสี้ยววิญญาณหมาป่า ที่ฉันยังไม่เคยเจอสินะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690402
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 760690402,
					"content": "ใครเป็นคนทิ้งนายไว้ที่นี่? และนายอยู่เพื่อปกป้องอะไร? ตอนนี้... ตอบฉันมาเถอะนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690403
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 760690403,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690404
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 760690404,
					"content": "...ข้าเคยบอกไปตั้งกี่หนแล้ว เส้นทางที่เปื้อนเลือดนี้ มีข้าคนเดียวก็พอแล้ว ไม่อยากให้ใครมาเดินซ้ำรอยเดิมข้าอีก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690405
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 760690405,
					"content": "ฮ่า งั้นก็คิดซะว่า พวกเราแค่บังเอิญเดินร่วมทางสายเดียวกันซะสิ? บังเอิญเดินกันมาตั้งแต่ Mondstadt จนถึง Nod-Krai",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690406
					]
				},
				{
					"id": 760690406,
					"content": "แล้วก็บังเอิญเคยได้รับความช่วยเหลือ จากอัศวินคนหนึ่งมานับครั้งไม่ถ้วน บังเอิญเกิดความเลื่อมใสในตัวอัศวินคนนั้น... ก็เลยอดไม่ได้ ที่จะเลือกเดินบนเส้นทางเดียวกับเขา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690407
					]
				},
				{
					"id": 760690407,
					"content": "ถึงจะไม่เข้าใจเลยสักนิด แต่อย่างน้อยก็อยากจะอยู่เคียงข้าง เพื่อเป็นพยาน... แม้ว่าตลอดเส้นทางที่ผ่านมานี้ จะเหลือเพียงแค่พวกเราไม่กี่คนแล้วก็ตาม",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690408
					]
				},
				{
					"id": 760690408,
					"content": "บรู้ววว...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690409
					]
				},
				{
					"id": 760690409,
					"content": "หากนี่คือวิถีอัศวินในแบบที่พวกเจ้าเชื่อละก็... ข้าก็ไม่มีสิทธิ์ปฏิเสธ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690410
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 760690410,
					"content": "...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760690411
					]
				},
				{
					"id": 760690411,
					"content": "เจ้ามอนสเตอร์เฮงซวยพวกนั้น...โดนกำจัดไปหมดแล้วใช่มั้ย? แล้วผู้คนแถวนี้... ไม่เป็นไรกันใช่รึเปล่า?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690412
					]
				},
				{
					"id": 760690412,
					"content": "แค่ก... ดีจริง ๆ... แต่น่าเสียดายที่พวกเราไม่มีแรงพอ จะอยู่ดูท่านเดินไปจนถึงปลายทางได้แล้ว... น่าเจ็บใจชะมัด!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690413
					]
				},
				{
					"id": 760690413,
					"content": "นับตั้งแต่นี้ไป ก็จะเหลือท่านแค่คนเดียวแล้วนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690414
					]
				},
				{
					"id": 760690414,
					"content": "...สุดท้ายแล้ว ดาบของข้าก็ปกป้องทุกอย่างไว้ไม่ได้อยู่ดี",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690415
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 760690415,
					"content": "...สุดท้ายแล้ว บนเส้นทางนี้ก็เหลือแค่ข้าคนเดียว... บางทีมันก็ควรจะเป็นอย่างนี้มาตั้งแต่แรกอยู่แล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690416
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 760690416,
					"content": "อย่างน้อยก็ให้ดาบพวกนี้ และวิญญาณหมาป่าของที่นี่ คอยเฝ้าหลุมศพของพวกเจ้าไว้เถอะ เพื่อไม่ให้สิ่งชั่วร้ายอันมืดมิด มารบกวนความสงบสุขยามนิทราของพวกเจ้าได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690417
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 760690417,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690418
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 760690418,
					"content": "อย่างนี้นี่เอง... ในบันทึกของกองอัศวินมีบันทึกไว้ว่า เมื่อ \"อัศวินอาบเลือด\" จากไป เคยมีอัศวินบางคนติดตามเขาไปด้วยความสมัครใจ แต่ก็ไม่มีบันทึกอะไรเพิ่มเติมหลังจากนั้น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690419
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 760690419,
					"content": "ไม่คิดเลยว่าสุดท้ายพวกเขาจะสู้กับมอนสเตอร์ จนต้องมาฝังร่างอยู่ที่นี่... สมกับเป็นอัศวินของกองอัศวินแห่ง Favonius จริง ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690420
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 760690420,
					"content": "แต่ \"ความปรารถนา\" ของพวกคุณจะหยุดอยู่แค่นี้จริง ๆ เหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690421
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 760690421,
					"content": "ไฟสงครามที่ไม่เคยมอดดับ ความอาวรณ์ที่สถิตอยู่ในดาบ... โปรดสำแดงให้ฉันเห็นถึงปณิธานของเหล่า \"อัศวิน\" ทีเถิด",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690422
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 760690422,
					"content": "ข้าจะใช้พลังที่ Boreas ทิ้งเอาไว้ที่นี่ปิดผนึกสนามรบนี้ไว้... และเจ้าหมาป่าน้อยตัวนั้น ก็จะคอยคุ้มครองพวกเจ้าอยู่ข้างนอก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690423
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 760690423,
					"content": "พวกเจ้าสมควรได้รับการ \"ปกป้อง\" เช่นนี้... ไม่มีใครมารบกวนได้อีกตลอดไป ได้พักผ่อนสงบสุขตลอดไป และไม่ต้องเห็นความอยุติธรรมของโลกนี้อีก... ตลอดกาล",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690424
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 760690424,
					"content": "ลาก่อน... \"สหายร่วมรบ\" คนสุดท้ายของข้า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690425
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 760690425,
					"content": "...ไม่...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690426
					]
				},
				{
					"id": 760690426,
					"content": "...ไม่นะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690427
					]
				},
				{
					"id": 760690427,
					"content": "...ขอให้เรา...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690428
					]
				},
				{
					"id": 760690428,
					"content": "...อีกครั้ง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690429
					]
				},
				{
					"id": 760690429,
					"content": "แน่นอน... \"ความปรารถนา\" ของพวกคุณ... คงไม่ใช่การค่อย ๆ เน่าเปื่อยไปอย่างเงียบ ๆ ในที่มืดมิดแบบนี้หรอกใช่มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690430
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 760690430,
					"content": "งั้นก็มาสิ! มากับฉัน จากนั้น...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690431
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 760690431,
					"content": "...ก็มุ่งสู่สนามรบอีกครั้ง!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				}
			]
		}
	]
}