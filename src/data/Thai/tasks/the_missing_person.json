				"points": []
			},
			"dialogs": [
				{
					"id": 190361401,
					"content": "ถ้านักเดินทางท่านนั้นไม่ว่าง จะทำยังไงดีล่ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361402
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361402,
					"content": "นั่นเป็นปัญหาของนาย ใครใช้ให้นายไปรับเรื่องยุ่งยากแบบนี้มาตามใจชอบกันล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361403
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361403,
					"content": "อุ๊ย นายนี่โชคดีจริง ๆ คนช่วยชีวิตนายมาโน่นแล้วน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361404
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361404,
					"content": "เอ๋? เยี่ยมเลย! นักเดินทาง คุณมาแล้วเหรอ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361405
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361405,
					"content": "ไม่ต้องห่วงนะ ฉันว่างมากเลยล่ะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361406
					]
				},
				{
					"id": 190361406,
					"content": "ก็คงว่างจริง ๆ นั่นแหละ พูดถึงปุ๊บก็มาปั๊บเลยน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361407
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361407,
					"content": "ท่านประธาน!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361408
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361408,
					"content": "ถ้าเทียบกันแล้ว ท่านประธานยังดูว่างงานกว่านักเดินทางซะอีกนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361409
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361409,
					"content": "ใช่ที่ไหนกัน ฉันยุ่งมากต่างหาก ยุ่งที่ต้องยืนอยู่ตรงนี้... แถมยังต้องยืนทั้งวันด้วยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361410
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361410,
					"content": "ต่อให้เป็นคำขอที่ไม่อยากรับ ข้อแก้ตัวนี้ของท่านประธานก็ยังฟังไม่ขึ้นอยู่ดี",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361411
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361411,
					"content": "คำขอที่ไม่อยากรับงั้นเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361412
					]
				},
				{
					"id": 190361412,
					"content": "ใช่แล้วล่ะ... นี่คือเหตุผลที่ฉันเรียกพวกคุณมา เดี๋ยวฉันจะอธิบายรายละเอียดให้ฟังนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361413
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361413,
					"content": "เมื่อเร็ว ๆ นี้มีคนสำคัญคนหนึ่งของสำนัก Tenryou หายตัวไป ไม่มีใครพบเห็นเขา แถมยังติดต่อไม่ได้อีกด้วยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361414
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361414,
					"content": "แต่เพราะเหตุผลบางอย่าง สำนัก Tenryou เลยไม่สะดวกที่จะออกตามหาอย่างเปิดเผย ก็เลยได้แอบไหว้วานให้พวกเราช่วยตามหาน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361415
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361415,
					"content": "ชื่อของเขาก็คือ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361416
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361416,
					"content": "Kujou Sara! นายพลคนนี้หายตัวไปน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361417
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361417,
					"content": "...ถ้าท่านนายพลคนนั้นหายตัวไปจริง ๆ พวกเขาคงพลิกเมือง Inazuma ค้นหาไปแล้ว จะมาไหว้วานพวกเราทำไมกัน?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361418
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361418,
					"content": "นักเดินทาง คุณอย่าไปฟังท่านประธานพูดซี้ซั้วเลย จริง ๆ แล้วคนที่หายตัวไปชื่อว่า Shikanoin Heizou ต่างหากล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361419
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361419,
					"content": "เขาคือนักสืบพิเศษของกองปราบปราม แม้ว่าเขาจะมียศแค่ Doushin แต่เขาเก่งไม่เบาเลย กองปราบปรามเลยให้ความสำคัญกับเขามากเลยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361420
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361420,
					"content": "หืม? เก่งกว่าฉันอีกเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361421
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361421,
					"content": "ท่านประธาน คุณไม่ยอมช่วยก็ไม่เป็นไร แต่อย่างน้อยช่วยเลิกกวนได้มั้ย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361422
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361422,
					"content": "ขอโทษด้วยนะ นักเดินทาง แม้ว่าฉันจะรับคำขอนี้มา...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361423
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361423,
					"content": "แต่คุณคงเห็นแล้วว่า ท่านประธาน... ไม่อยากเข้าไปยุ่งเรื่องนี้น่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361424,
						190361425
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361424,
					"content": "เพราะค่าตอบแทนน้อยเกินไป?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361426
					]
				},
				{
					"id": 190361426,
					"content": "ไม่ตรงเลยสักนิด! ให้ศูนย์คะแนนไปเลย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361427
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361427,
					"content": "ถ้าถามว่าทำไม นั่นก็เพราะฉันจะไม่ยุ่งเรื่องของเจ้าหมอนั่นเด็ดขาดไงล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361428
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361428,
					"content": "ถ้าจะมีเรื่องอะไรน่าดีใจไปกว่าการที่ \"Shikanoin หายตัวไป\" ล่ะก็... นั่นต้องเป็นเรื่องที่ \"Shikanoin หายตัวไปหนึ่งร้อยปี\" น่ะสิ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361429
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361429,
					"content": "อะแฮ่ม... เอาเป็นว่าประธาน Sango กับคุณ Heizou เคยมีเรื่องกันนิดหน่อยน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361430
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361430,
					"content": "ฉันเข้าใจแล้วล่ะ... พวกเขาเป็นคู่แข่งกันสินะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361431
					]
				},
				{
					"id": 190361431,
					"content": "อะแฮ่ม... คุณเข้าใจผิดแล้วล่ะ มันหนักกว่านั้นอีก...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361432
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361432,
					"content": "ท่านประธานบอกว่า คุณ Heizou คืออุปสรรคที่กีดขวางเส้นทางสู่วิหารแห่งความจริงของเธอน่ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361433
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361433,
					"content": "เป็นหมาที่มาขวางทางต่างหากล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361434
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361434,
					"content": "เฮ้อ... แม้ว่าคุณ Heizou จะเป็นคนค่อนข้าง... เอ่อ... ไม่เหมือนใคร? แต่เขาเป็นคนดีนะ เขาเคยสอนฉันหลายเรื่องเลยล่ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361435
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361435,
					"content": "เพราะงั้นถึงท่านประธานจะไม่อนุญาต ฉันก็ทนอยู่เฉยไม่ได้หรอก อย่างน้อยก็ต้องส่งต่อคำขอให้คนที่ไว้ใจได้ อย่างเช่น นักเดินทางผู้มากความสามารถยังไงล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361436,
						190361437
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361436,
					"content": "เข้าใจแล้วล่ะ นายจะจ้างฉันต่ออีกทอดนึงสินะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361438
					]
				},
				{
					"id": 190361438,
					"content": "อ่า... มะ ไม่ใช่นะ! เอ่อ... ค่าตอบแทนที่สำนัก Tenryou รับปากไว้ ฉันจะจ่ายให้เต็มจำนวนแน่นอน และฉันจะจ่ายเพิ่มให้เป็นการส่วนตัวด้วยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361439
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361439,
					"content": "เพราะงั้นหวังว่าคุณจะรับคำขอนี้นะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361440
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361440,
					"content": "ถ้าคุณ Heizou ตกอยู่ในอันตรายจริง ๆ ฉันคิดว่าเขาจะปลอดภัยกว่า ถ้ามีคุณอยู่ด้วยน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361441,
						190361445
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361441,
					"content": "นายสนิทกับเขามากเลยเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361442
					]
				},
				{
					"id": 190361442,
					"content": "อันที่จริงพวกเราก็สนิทกันดีนะ แต่ประธาน Sango เอาแต่ขอให้ฉันรักษาระยะห่างกับเขา และไม่ยอมให้ฉันแสดงท่าทีสนิทสนมกับเขาอย่างเปิดเผยน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361443
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361443,
					"content": "เพราะงั้นเวลาคนอื่นถาม ฉันจึงมักจะตอบไปว่า ฉันเคยพบคุณ Shikanoin แค่ไม่กี่ครั้ง วันนี้ถ้าไม่ใช่เพราะเกิดเรื่องนี้ขึ้น...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361444
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361444,
					"content": "อะแฮ่ม... เลิกพูดเรื่องนี้กันดีกว่า สรุปว่าคุณจะช่วยตามหาเขาได้มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361449
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361449,
					"content": "เข้าใจแล้วล่ะ ฉันจะไปเดี๋ยวนี้แหละ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361450
					]
				},
				{
					"id": 190361450,
					"content": "อืม เรื่องที่ฉันจะบอกก็มีเท่านี้แหละ เก็บเอกสารคำขอของกองปราบปรามไว้ให้ดีล่ะ ถ้าเจอคุณ Heizou แล้ว ก็กลับไปรายงานที่กองปราบปรามได้เลยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361445,
					"content": "ได้สิ แต่ฉันต้องการข้อมูลมากกว่านี้",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361446
					]
				},
				{
					"id": 190361446,
					"content": "เยี่ยมเลย! พวกเรารู้มาว่า ก่อนที่คุณ Heizou จะหายตัวไป เขาดูสนใจเกาะ Watatsumi มากเลยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361447
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361447,
					"content": "ดูเหมือนเขาจะเคยปฏิบัติภารกิจในช่วงสงครามที่เกาะ Watatsumi มาก่อน และหลังสงครามสิ้นสุด เขาเองก็ยังไปที่เกาะ Watatsumi อยู่บ่อย ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361448
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361448,
					"content": "ฉันได้ยินว่าคุณคุ้นเคยกับทาง Sangonomiya เป็นอย่างดี บางทีคุณอาจเริ่มสืบจากที่นั่นก็ได้นะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361449
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361437,
					"content": "เข้าใจแล้วล่ะ นายเป็นพ่อค้าคนกลางสินะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361438
