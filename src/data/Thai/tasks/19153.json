			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Layla"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 191530901,
					"content": "แบบนี้นี่เอง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530902
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530902,
					"content": "ลองวิเคราะห์ให้ฉันฟังหน่อยสิ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191530903
					]
				},
				{
					"id": 191530903,
					"content": "อืม ก่อนอื่น จากข้อมูลที่ Katayoun ให้มา สามารถสรุปได้ว่าตัวตนที่แท้จริงของ Seelie เป็นนักเรียนของคณะ Rtawahist",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530904
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530904,
					"content": "ความเป็นไปได้ที่จะเป็นบุคคลภายนอกถูกตัดออก เพราะไม่มีทางที่จะเลี่ยงผู้ดูแล และนำหนังสือสองเล่มนั้นออกไปได้หรอก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530905
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530905,
					"content": "ต่อไป ตัดความสามารถเหนือธรรมชาติทิ้งไป จุดที่พบเห็นก็ล้วนเป็นสถานที่สังเกตการณ์ทางโหราศาสตร์ ที่สถาบันแนะนำทั้งนั้นเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530906
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530906,
					"content": "หรือพูดอีกอย่างก็คือ... มันอาจจะทำวิจัยอยู่ และเนื้อหาวิจัยก็คล้ายกับของฉันด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530907
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530907,
					"content": "คำถามที่ฉันถามมันนั้นยากมากเลย แต่มันกลับใช้เวลาแค่วันเดียวก็ตอบฉันได้แล้ว แสดงว่ามันมีความรู้เกี่ยวกับเรื่องนี้เหมือนกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530908
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530908,
					"content": "ดังนั้น ถ้าเป็นไปตามสมมุติฐานนี้ พวกเราก็แค่ต้องไปรอมันที่สถานที่สังเกตการณ์ทางโหราศาสตร์ที่ต่อไปก็พอ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530909,
						191530910
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530909,
					"content": "แนวคิดชัดเจนมาก",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191530911
					]
				},
				{
					"id": 191530911,
					"content": "ชะ ชมเกินไปแล้ว... ที่จริงยังมีเหตุผลอื่น ๆ ที่ฉันคาดเดามาตลอดอีก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530912
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530912,
					"content": "แต่เรื่องนี้ไม่สำคัญหรอก เอาไว้ก่อนละกัน ต่อให้มีเบาะแส แต่จะได้ข้อสรุปอะไรมั้ย ก็ยังยากที่จะตอบได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530913
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530913,
					"content": "ส่วนทำไมฉันถึงคิดแบบนี้นั้น... ไว้ถ้ามันไม่โผล่ออกมา ฉันค่อยเล่าให้คุณฟังก็แล้วกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530910,
					"content": "เธอมีความสามารถในการใช้เหตุและผลขนาดนี้ งั้นเรื่องเขียนวิทยานิพนธ์ก็คงไม่มีปัญหาหรอก",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191530911
					]
				}
			]
		}
	]
}