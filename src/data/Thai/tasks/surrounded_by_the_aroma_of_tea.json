			"dialogs": [
				{
					"id": 705070101,
					"content": "Zh...Zhongli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705070102,
					"content": "ไม่เจอกันนานเลยนะ ช่วงนี้เป็นยังไงบ้างล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070103
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 705070103,
					"content": "ไม่ ๆ ไม่สิ... Zhongli ทำไมคุณถึงมาอยู่ที่นี่ได้ล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705070104,
					"content": "ในเมื่อออกเดินทางพักผ่อน จึงไม่ควรจำกัดจุดหมายปลายทาง ดินแดนแห่งสายลมที่อิสระและอุดมสมบูรณ์ ก็เป็นสถานที่ที่น่าเยี่ยมชมด้วยเช่นกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070105
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 705070105,
					"content": "ก็น่าแปลกใจเหมือนกันที่ได้มาเจอกับพวกเธอที่นี่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070106,
						705070107
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 705070106,
					"content": "จะดื่มอะไรสักหน่อยมั้ย?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070108
					]
				},
				{
					"id": 705070108,
					"content": "ขอ Misty Garden แก้วนึง ขอรสชาติชาเข้ม ๆ หน่อย ต้องรบกวนเธอแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 705070107,
					"content": "จิบชาพลางคุยไปก็ได้นะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070108
					]
				}
			]
		},
		{
