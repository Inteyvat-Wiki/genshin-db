			"dialogs": [
				{
					"id": 3600101,
					"content": "เรื่องกล้วยๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600102
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3600102,
					"content": "แต่ว่าคิดไม่ถึงเลยนะ ที่แท้เธอก็ไม่ใช่นักเดินทางทั่วไปที่ไม่มีความสามารถในการต่อสู้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600103
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3600103,
					"content": "ขอบคุณที่ช่วยนะ รู้สึกยังไงบ้างล่ะที่สู้ไปเมื่อกี้?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600104,
						3600105
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3600104,
					"content": "สบาย ๆ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3600106
					]
				},
				{
					"id": 3600106,
					"content": "จะว่าไปทำไมพวก \"Hilichurl\" ถึงมาโผล่แถวนี้กัน?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3600107,
					"content": "สิ่งมีชีวิตพวกนี้ ปกติไม่น่าจะมาทำรังแถวเมืองแบบนี้นะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3600108,
					"content": "ใช่สิ พวกมันควรต้องป้วนเปี้ยนอยู่แถวป่าลึกนู่นสิ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600109
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3600109,
					"content": "แต่ว่าช่วงนี้มี Stormterror โผล่ออกมาบ่อย ๆ สวนผลไม้ก็โดนทำลายไปแล้ว เส้นทางการค้าก็รับผลกระทบไปด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600110
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3600110,
					"content": "พายุมาทีก็มักจะมีคนได้รับบาดเจ็บ...เพราะฉะนั้นกองอัศวินจะต้องคอยป้องกันให้ดี",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600111
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3600111,
					"content": "เพราะงั้นเจ้ามอนสเตอร์น่ารำคาญพวกนี้ก็เข้ามาใกล้เมืองเรื่อย ๆ ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3600112,
					"content": "ใช่สิ แต่ว่าวันนี้ก็ทำลายรังไปอีกแห่งนึงละ ก็ยังโอเคอยู่นะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600113
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3600113,
					"content": "มากับฉันสิ! อัศวินผู้มีความรับผิดชอบจะขอส่งคุณเข้าเมืองอย่างปลอดภัยล่ะนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 3600105,
					"content": "ก็เหนื่อยอยู่นะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3600106
					]
				}
			]
		}
	]
