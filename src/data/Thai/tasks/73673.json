					"Effendi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736730101,
					"content": "สวัสดี ยินดีต้อนรับสู่ป้อมปราการ Regzar",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730102
					],
					"speakerTitle": "Effendi"
				},
				{
					"id": 736730102,
					"content": "ที่นี่คือที่ที่ \"กลุ่มภาคี 30\" ใช้สื่อสารและประสานงานเรื่องต่าง ๆ ดูจากการแต่งตัวแล้ว เธอไม่ใช่สมาชิกของพวกเขาแน่...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730103
					],
					"speakerTitle": "Effendi"
				},
				{
					"id": 736730103,
					"content": "ฉันเข้าใจแล้ว คุณได้ข่าวการรับสมัคร ก็เลยจะมาสมัครใช่มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730106,
						736730104
					],
					"speakerTitle": "Effendi"
				},
				{
					"id": 736730106,
					"content": "ใช่แล้วล่ะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736730107
					]
				},
				{
					"id": 736730107,
					"content": "ที่แท้ก็อย่างนี้นี่เอง ดีมาก ฉันจะอธิบายรายละเอียดของเนื้องานให้ฟังอีกครั้งแล้วกัน กันไว้ดีกว่าแก้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730108
					],
					"speakerTitle": "Effendi"
				},
				{
					"id": 736730108,
					"content": "ฉันชื่อ Effendi ฉันได้รับมอบหมายจากสถาบันให้ทำหน้าที่เป็นเจ้าหน้าที่ประสานงาน คอยรับผิดชอบการประสานงานระหว่างสถาบันกับ \"กลุ่มภาคี 30\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730109
					],
					"speakerTitle": "Effendi"
				},
				{
					"id": 736730109,
					"content": "คุณอาจพอรู้แล้วว่า \"กลุ่มภาคี 30\" ได้รับการจ้างวานจากสถาบันให้รับผิดชอบดูแลเมือง Sumeru",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730110
					],
					"speakerTitle": "Effendi"
				},
				{
					"id": 736730110,
					"content": "นอกจากนี้ พวกเขายังรับผิดชอบจัดการกับปัญหาบางอย่างที่ชาวบ้านพบเจอในชีวิตประจำวันอีกด้วย ปริมาณงานก็เลยเยอะมากพอตัวเลยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730111
					],
					"speakerTitle": "Effendi"
				},
				{
					"id": 736730111,
					"content": "หลังจากได้พูดคุยกับ Parchamdar แล้ว ฉันก็ตัดสินใจจ้างผู้ช่วยคนนึงเพื่อแบ่งเบาภาระ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730112
					],
					"speakerTitle": "Effendi"
				},
				{
					"id": 736730112,
					"content": "แน่นอนว่าคุณไม่ต้องเป็นห่วงเรื่องงานป้องกันเมืองเลย ขอเพียงคุณช่วยทำตามคำขอในชีวิตประจำวันของชาวเมืองก็พอ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730113
					],
					"speakerTitle": "Effendi"
				},
				{
					"id": 736730113,
					"content": "ในส่วนของรายละเอียดของคำขอในชีวิตประจำวันนั้น ส่วนใหญ่จะค่อนข้างยุ่งยากและละเอียดมาก ฉันจะยกตัวอย่างให้เข้าใจง่าย ๆ ละกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Effendi"
				},
				{
					"id": 736730104,
					"content": "รับสมัคร?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736730105
					]
				},
				{
					"id": 736730105,
					"content": "นี่คุณยังไม่ได้อ่านรายละเอียดการรับสมัครก็ตรงดิ่งมานี่เลยงั้นเหรอ? ช่างมันเถอะ ไม่เป็นไรเลย ฉันจะอธิบายให้ฟังก็แล้วกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730108
					],
					"speakerTitle": "Effendi"
				}
			]
		},
		{
			"id": 7367302,
			"completionStepIds": [
				7367302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
