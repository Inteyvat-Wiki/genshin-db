					"Ilmari"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760210401,
					"content": "วันนี้ก็กลับมือเปล่าอีกแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210402,
						760210405,
						760210412,
						760210417,
						760210421
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210402,
					"content": "มาทำอะไรอยู่ที่นี่เหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760210403
					]
				},
				{
					"id": 760210403,
					"content": "ตกปลาน่ะ แต่จนถึงตอนนี้ยังไม่ได้ปลาเลย ได้แต่ของอย่างอื่น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210404
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210404,
					"content": "ถ้าเป็นของเล็ก ๆ น้อย ๆ ที่อยู่ในเรืออับปางอะไรพวกนั้นก็ยังดีนะ พ่อค้าเร่คงรับซื้ออยู่ ก่อนหน้านี้ฉันเคยตกได้รองเท้าบูทที่มาแค่ครึ่งซีก... เฮ้อ ไม่พูดแล้ว พูดมากไปเดี๋ยวปลาหนีหมด",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210405,
					"content": "แถวนี้มีอะไรน่าสนใจบ้างมั้ย?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760210406
					]
				},
				{
					"id": 760210406,
					"content": "เธอมาหาสมบัติอีกแล้วเหรอ? \"สมบัติอันยิ่งใหญ่\" ที่ว่ากันว่า จะหาได้แค่ในจันทราบูรพาและสุริยันประจิมอะไรนั่นน่ะ... แค่ฟังก็รู้ว่าคงไม่ใช่ที่นี่หรอก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210407
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210407,
					"content": "จริง ๆ ที่นี่ก็เคยเกิดอุบัติเหตุเรืออับปางขึ้นไม่น้อย ในซากเรืออาจมีของมีค่าอยู่จริง ๆ ก็ได้ แต่คงหาไม่ได้ง่าย ๆ หรอก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210408
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210408,
					"content": "เคยได้ยินกะลาสีที่รอดชีวิตเล่าในร้านเหล้าว่า คืนนั้นเป็นคืนไร้จันทร์ แต่กลับมองเห็นแสงประหลาดท่ามกลางคลื่นยักษ์ที่ถาโถม",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210409
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210409,
					"content": "พวกเขาบอกว่านั่นต้องเป็น Kratti ตาเดียวแน่ ๆ มันเป็นสัตว์ประหลาดที่สามารถกลืนกินแม้กระทั่งจันทรา ที่กำลังแย่งชิงอาณาเขตกับอสรพิษยักษ์ในทะเลอยู่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210410
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210410,
					"content": "หลังจากนั้นพักใหญ่ พื้นที่บริเวณนี้ก็มืดมิดราวกับขวดหมึกในสำนักงานบัญชี ไม่มีเรือลำไหนกล้าเสี่ยงผ่านทางนี้เลย ทุกคนต่างก็กลัวว่า จะถูกวิญญาณใต้ผืนน้ำตามหลอกหลอน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210411
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210411,
					"content": "ไม่ว่าวิญญาณเหล่านั้นจะยังวนเวียนอยู่แถว ๆ นี้รึเปล่า ยังไงฉันก็มองไม่เห็นอยู่ดี",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210412,
					"content": "เกี่ยวกับต้นไม้ต้นนั้น...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760210413
					]
				},
				{
					"id": 760210413,
					"content": "มันก็แปลก ๆ จริง ๆ แหละ แต่ก่อนตรงนี้เคยมีน้ำวน พวกกะลาสีเรียกมันว่าดวงตาแห่ง Kratti แต่จู่ ๆ วันหนึ่งต้นไม้นี้ก็งอกขึ้นมาเฉยเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210414
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210414,
					"content": "แต่เรื่องแปลก ๆ ที่เกิดขึ้นช่วงนั้นมันไม่ได้มีแค่เรื่องเดียวนะ พอมาคิด ๆ ดูแล้ว ทั้งหมดนี้เกิดขึ้น หลังจากที่ก้อนหินพวกนั้นร่วงลงมาจากฟ้า... ไม่แน่ว่าต้นไม้นี่อาจจะมาจากนอกโลก เหมือนกับก้อนหินพวกนั้นก็ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210415
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210415,
					"content": "แถมยังมีเจ้าสิ่งเล็ก ๆ ที่ระยิบระยับมาให้เห็นได้เป็นบางครั้งคราวนั่นอีก มันหายากมากเลย คิดว่าอาจจะมีปลาพันธุ์ใหม่ ๆ ด้วยมั้ง ฉันก็เลยมาลองเสี่ยงโชคดูหน่อย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210416
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210416,
					"content": "ตอนแรกฉันมีเพื่อนนักตกปลาคนหนึ่งมาด้วยกัน แต่เขาบอกว่าได้ยินเสียงเพลงประหลาด เลยกลัวจนไม่กล้ามาอีก ฮึ ถึงเขาจะเป็นลูกหลานจันทราน้ำค้างแข็งแค่ครึ่งเดียว แต่นิสัยเสียนี่มีครบไม่ขาดเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210417,
					"content": "เกี่ยวกับ \"หลักฐานของผู้ทรงความรู้\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760210418
					]
				},
				{
					"id": 760210418,
					"content": "\"หลักฐานของผู้ทรงความรู้\" หรือ \"สมบัติอันยิ่งใหญ่\" ที่จะหาได้แค่ในจันทราบูรพาและสุริยันประจิมอะไรนั่น ถ้าจะให้ฉันพูดละก็...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210419
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210419,
					"content": "ถูกความโลภครอบงำ ไล่ล่าสิ่งที่ไม่ใช่ของตัวเอง คงจบไม่สวยหรอก อย่างเรือ Atlas นั่นไง ได้ยินว่ากัปตัน Grettir ก็หลงใหลในสมบัติพวกนี้เหมือนกับคนถูกสะกดจิต",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210420
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210420,
					"content": "สุดท้ายก็จมดิ่งสู่ก้นทะเล แต่สมบัติกลับไม่ได้ติดตัวเขาไปด้วย เสียเวลาเปล่าแท้ ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210421,
					"content": "ขอโทษที่รบกวนนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760210422
					]
				},
				{
					"id": 760210422,
					"content": "ไม่เป็นไรหรอก ตอนนี้ไม่เห็นแม้แต่เงาปลาเลยสักตัว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ilmari"
				}
			]
		}
	]
}