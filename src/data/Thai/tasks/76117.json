			"dialogs": [
				{
					"id": 761170201,
					"content": "...ชิ ไอ้พวกกระจอกเอ๊ย ไม่มีอะไรติดตัวเลยรึยังไงนะ",
					"roleType": "TALK_ROLE_NPC",
