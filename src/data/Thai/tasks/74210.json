					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741361201,
					"content": "คุณมีอะไรที่อยากถามมั้ย นักวิจัยกิตติมศักดิ์ระดับสูง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361202,
						741361208,
						741361220
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361202,
					"content": "เกี่ยวกับการจัดการกับ Nacker และ Edwin...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361203
					]
				},
				{
					"id": 741361203,
					"content": "พวกเขาจะอยู่ที่ป้อมปราการ Meropide สักพักหนึ่ง เพื่อสำนึกผิดกับสิ่งที่พวกเขาทำไปทั้งหมด",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361204
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361204,
					"content": "ซึ่งแน่นอนว่าจากนิสัยของ Edwin แล้ว เขาคงไม่มีทาง \"สำนึกผิด\" หรอก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361205
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361205,
					"content": "แต่ไม่ว่ายังไง ขอแค่ทำให้ Edwin อยู่ให้ห่างจากอุปกรณ์วิจัยและ Arkhium ก็พอแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361206
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361206,
					"content": "ส่วน Nacker... ฉันว่าเขาคงไม่สร้างปัญหาให้เราอีกแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361207
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361207,
					"content": "เฮ้อ หวังว่าฉันจะไม่ต้องเจอสถานการณ์ที่ต้องใช้งานพวกเขานะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361208,
					"content": "เมื่อก่อน Fusilier ชื่นชม Edwin มากเลยเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361209
					]
				},
				{
					"id": 741361209,
					"content": "...คุณ Edwin Eastinghouse เป็นอัจฉริยะคนหนึ่ง คนที่เคยทำงานสายเดียวกับเขา ถ้าไม่หมดอาลัยตายอยาก ก็กลายเป็นลูกศิษย์ถวายหัว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361210
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361210,
					"content": "คุณ Fusilier เป็นนักวิจัยที่มีความกระตือรือร้นและสร้างสรรค์มาก เธอมักจะสร้างผลงานที่น่าทึ่ง ด้วยงบประมาณเพียงน้อยนิด",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361211
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361211,
					"content": "หลังจากเข้าร่วมทีมเทคนิคคนที่สามของโครงการวิจัย Arkhium เธอก็รับผิดชอบในการออกแบบโครงสร้างเครื่องยับยั้ง และได้รู้จักกับ Edwin มากยิ่งขึ้น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361212
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361212,
					"content": "บางทีอาจจะเป็นตอนนั้นแหละที่เธอกลายเป็นศิษย์ของ Edwin ซึ่งสิ่งเดียวที่เธอปรารถนาก็เหมือนกับศิษย์คนอื่น ๆ นั่นแหละ นั่นก็คือการยอมรับจาก Edwin",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361213
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361213,
					"content": "หลังจากเหตุระเบิด เธอไม่เชื่อว่า Edwin จะเป็นผู้ก่อเหตุ ก็เลยสมัครเข้าร่วมการสืบสวน และพยายามจะช่วยพลิกคดีให้ Edwin",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361214
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361214,
					"content": "คุณเองก็เคยคุยกับ Edwin คุณคิดว่าไงบ้างล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361215
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361215,
					"content": "เขาเป็นคนประหลาดที่ไม่สนใจอะไรนอกจากการวิจัย! เขาปัดความรับผิดชอบของตัวเอง แล้วยังจำชื่อของคุณ Fusilier ไม่ได้เลยด้วยซ้ำ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741361216,
					"content": "ใช่ เขาเป็นคนแบบนั้นแหละ นอกจากงานวิจัยที่อยู่ในมือแล้ว ก็แทบไม่มีสิ่งใดหรือใคร ๆ เลย ที่จะควรค่าให้เขาเหลียวแล",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361217
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361217,
					"content": "ขอแค่งานวิจัยราบรื่น เขาก็แทบจะไม่สนใจเรื่องอื่น ๆ แล้ว แม้แต่นักวิจัยของเขาที่แอบขายทรัพยากรการวิจัย เขาก็ยังไม่สนใจเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361218
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361218,
					"content": "ที่ฉันยอมรับให้ Fusilier เข้าร่วมการสืบสวน... ก็แค่หวังว่าเธอจะเข้าใจในเร็ววัน ว่าเธอกำลังไล่ตามภาพมายาที่เธอสร้างขึ้นจากจินตนาการ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361219
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361219,
					"content": "ตอนนี้ ในที่สุดภาพมายานั่นก็ถูกทำลายแล้ว หวังว่าเธอจะมีกำลังใจขึ้นในเร็ววัน... ศูนย์วิทยาศาสตร์ Fontaine ไม่อาจเสียนักวิจัยคนไหนไปได้อีกแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361220,
					"content": "แล้วเจอกัน",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361221
					]
				},
				{
					"id": 741361221,
					"content": "แล้วเจอกัน นักวิจัยกิตติมศักดิ์ระดับสูง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raimondo"
				}
			]
		},
		{
			"id": 7413613,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
