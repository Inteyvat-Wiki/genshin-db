			"dialogs": [
				{
					"id": 705430101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430102
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430102,
					"content": "...เมี้ยว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430103
					],
					"speakerTitle": "Dustball"
				},
				{
					"id": 705430103,
					"content": "...พวกเธอเองเหรอ ฉันกำลัง คุยอยู่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430104
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430104,
					"content": "คุย... Razor คุยอยู่กับ \"Dustball\" เหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430105,
					"content": "เมี้ยว เมี้ยว ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430106
					],
					"speakerTitle": "Dustball"
				},
				{
					"id": 705430106,
					"content": "เหมือนว่า \"Dustball\" อยากจะบอกว่า... \"ถูกต้อง\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430107,
					"content": "ได้กลิ่นที่คุ้นเคย หาเพื่อน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430108
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430108,
					"content": "มันดีมาก มีความสุข",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430109
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430109,
					"content": "เมี้ยว เมี้ยว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430110
					],
					"speakerTitle": "Dustball"
				},
				{
					"id": 705430110,
					"content": "กลิ่นดึงดูดเพื่อน เธอก็มาด้วย ดีใจจัง บนตัวเธอมีกลิ่นลมและฝน คุ้นเคยมาก... กลิ่นแมว ก็คุ้นเคย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430111
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430111,
					"content": "Paimon กลิ่นหวาน หอมจัง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430112
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430112,
					"content": "เอ๊ะ?! กลิ่นหวาน... หรือจะเป็นกลิ่นแพนเค้กที่ Valerina ให้พวกเรา? ฉะ...ฉันกินเยอะขนาดนั้นเลยเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430113,
						705430114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430113,
					"content": "ฉันแบ่งส่วนของฉันให้เธอครึ่งหนึ่งแล้วนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705430115
					]
				},
				{
					"id": 705430115,
					"content": "ไม่ทันสังเกตเลย... โอ๊ย เพราะแพนเค้กอร่อยมากไงล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430116,
					"content": "อิอิ ฉันยังอยากกิน Sweet Madame, Steak กับ Hash Brown... แล้วก็ Apple Cider!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430117,
					"content": "#งั้นเมนูตามนี้นะ {NICKNAME} เรารีบไปสั่งอาหารกับ Valerina กันเถอะ Razor ก็ไปด้วยกันสิ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430118,
					"content": "ขะ...ขอบคุณ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430119
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430119,
					"content": "\"Dustball\" เอาถั่ว... มาให้ฉันเยอะเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430120
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430120,
					"content": "ยังมี กล่องเนื้อด้วย... ฉัน อิ่มมากเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430121
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430121,
					"content": "ฟังดูเหมือนเป็นออเดอร์เดลิเวอรี่ของคุณ Valerina เลย? หรือว่า \"Dustball\" เอาอาหารเดลิเวอรี่ไปส่งให้ Razor กิน?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430122,
					"content": "เมี้ยว ๆ เมี้ยว!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430123
					],
					"speakerTitle": "Dustball"
				},
				{
					"id": 705430123,
					"content": "คิดไม่ถึงเลยว่าใน \"Furball Fortress\" จะมีเรื่องที่แมวมารับรองแขกด้วยตัวเองด้วย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430124,
					"content": "ดูเหมือนว่า \"วาสนาแมว\" ของ Razor จะดีจริง ๆ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430114,
					"content": "ไม่เป็นไร เธอยังกินได้อีกสามเท่า",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705430115
					]
				}
			]
		}
	]
}