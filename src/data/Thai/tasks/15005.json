				},
				{
					"id": 150050206,
					"content": "เหวอ เจ้า Koholasaurus ป่ามันงับคนจริง ๆ ด้วยแฮะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050207,
