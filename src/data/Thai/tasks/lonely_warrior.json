						],
						"stepId": 1601109,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Roland"
				],
				"points": [
					{
						"sceneId": 20336,
						"position": [
							387.989,
							123.18,
							197.075
						],
						"pointId": 1
					},
					{
						"sceneId": 20336,
						"position": [
							387.824,
							111.946,
							237.497
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 160110901,
					"content": "... ตามที่เจ้าต้องการ อัศวินแห่ง Boreas",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110902
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110902,
					"content": "ฮ่า ผิดจากที่ฉันจินตนาการไว้แฮะ ดูเหมือนคุณจะไม่ได้ดู \"บ้าคลั่ง\" เหมือนกับในความทรงจำที่อยู่ใน \"เศษเสี้ยว\" นั่นเลยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110903
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110903,
					"content": "ข้าไม่เคยเบี่ยงเบนไปจากเส้นทางที่ถูกต้องเลยสักครั้ง ส่วนเจ้าน่ะเหรอ... ตอนนี้ เจ้าดูไม่เหมือนวีรบุรุษผู้ปราบมังกรได้เลยสักนิด แต่ดูเหมือนอัศวินตกอับ... ที่เร่ร่อนมานานเกินไปมากกว่า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110904
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110904,
					"content": "ก็พอกันนั่นแหละ ดูเหมือนว่าเราทั้งคู่ จะไม่ได้อยู่ในช่วงที่ตัวเองรุ่งโรจน์ที่สุดแล้วสินะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110905
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110905,
					"content": "กองทัพของผู้ล่าจันทราถูกกำจัดไปแล้ว \"ตัวข้า\" ที่ถูกสร้างขึ้นจาก Abyss ย่อมเป็นแค่เงาสะท้อนที่ไม่สมบูรณ์เท่านั้น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110906
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110906,
					"content": "แม้พลังจะเทียบเท่า Roland ในยุคที่รุ่งโรจน์ที่สุด แต่จิตใจกลับยังคงหยุดนิ่งอยู่ในช่วงเวลาอาบเลือดนั้น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110907
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110907,
					"content": "ดังนั้น \"ตัวข้า\" เองจึงไม่ถูกต้องเช่นกัน... และอัศวินก็ไม่อาจยอมให้ตัวเองหยุดอยู่แค่นี้ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110908
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110908,
					"content": "หลังจากที่ข้าได้ช่วยเจ้าจากความอยุติธรรม และนำพาเจ้าเข้าสู่ Abyss แล้ว ข้าก็จะแก้ไขตัวเองให้ถูกต้อง และดำเนินตามวิถีของอัศวินต่อไป",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110909
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110909,
					"content": "เฮอะ! โลกภายนอกคงทนให้คุณก่อเรื่องต่อไปไม่ไหวหรอก... ส่วนความยึดติดของคุณ ก็เหมือนกับที่ฉันคิดไว้ไม่มีผิด ดูท่าฉันคงไม่มีทางกล่อมให้คุณเชื่อได้แล้วสินะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110910
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110910,
					"content": "คุณธรรมที่อัศวินเชิดชู ไม่มีวันมัวหมองเพียงเพราะวาทกรรม ไม่ว่ามันจะฟังดูสูงส่งแค่ไหนก็ตาม... เราสองคนไม่มีทางโน้มน้าวอีกฝ่ายได้หรอก เจ้าเองก็รู้ดีอยู่แก่ใจ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110911
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110911,
					"content": "ไม่งั้นพวกเจ้าจะฝากความหวังทั้งหมดไว้กับ \"ความคิดเดียว\" ของ Boreas ไปทำไม?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110912
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110912,
					"content": "แต่ตอนนี้ ดาบที่เคยใช้บรรจุวิญญาณหมาป่าของเจ้า ได้แตกเป็นเสี่ยงไปนานแล้ว สิ่งที่เจ้าถืออยู่ในมือ ก็เป็นแค่ภาพมายาที่มีรูปลักษณ์เท่านั้น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110913
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110913,
					"content": "เจ้าไม่มีทางเปลี่ยนแปลงอะไรได้อีกแล้ว และไม่มีกำลังเสริมให้หวังพึ่งด้วย... ที่นี่ก็คือ \"ทางตัน\" ของเจ้า นักสำรวจผู้โดดเดี่ยวเอ๋ย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110914
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110914,
					"content": "เหอะ หนทางน่ะช่างมันก่อน... แต่ถ้าพูดถึงกำลังเสริมละก็ ที่นี่ก็ยังมีอยู่อีกคนนึงไม่ใช่รึไง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110915
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110915,
					"content": "...อะไรนะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110916
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110916,
					"content": "...คนที่ฉันต้องโน้มน้าว ตั้งแต่ต้นจนจบก็มีแค่คนนั้นคนเดียว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110917
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110917,
					"content": "ที่นี่คือ \"หัวใจ\" ของเทพอสูรแห่งลมเหนือ Andrius ใช่มั้ยล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110918
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110918,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110919
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160110919,
					"content": "... เฮ้! ได้ยินมั้ย! Andrius!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110920
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110920,
					"content": "รีบตื่นได้แล้ว! เป็นเทพอสูรแห่งลมเหนือผู้ยิ่งใหญ่แท้ ๆ จะถูก Abyss ควบคุมไปอีกนานแค่ไหนกัน!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110921
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110921,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110922
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160110922,
					"content": "ถ้านี่คือการดิ้นรนเฮือกสุดท้ายของเจ้าละก็ ข้าคงรู้สึกผิดหวังมาก อัศวินแห่ง Boreas",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110923
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110923,
					"content": "แรงใจและแรงปรารถนา เรียกปาฏิหาริย์มาไม่ได้หรอก... โลกใบนี้ไม่เคยใจดีขนาดนั้น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110924
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110924,
					"content": "...กลับไป...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110925
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160110925,
					"content": "...กลับไปสู่...กระแสพลัง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110926
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160110926,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110927
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110927,
					"content": "... นี่คือสิ่งที่ \"ข้า\" เลือก... ความทรงจำของ \"ข้า\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110928
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160110928,
					"content": "...นี่ก็คือคำตอบที่ \"ข้า\" ค้นพบ... ที่จุดสิ้นสุดของการเดินทางงั้นเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110929
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160110929,
					"content": "Andr{RUBY#[D]Boreas}ius... จดหมายของนาย ฉันส่งมันกลับไปถึงในใจ \"นาย\" เรียบร้อยแล้วนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110930
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110930,
					"content": "ฮึ... อัศวินแห่ง Boreas รึ... คอยดูเถอะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110931
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160110931,
					"content": "...นี่คือสิ่งเดียวที่ \"หมา{RUBY#[S]ข้า}ป่า\"... สามารถทำเพื่อ \"มนุ{RUBY#[S]พวกเจ้า}ษย์\" ได้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110932
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160110932,
					"content": "...ในนามของมนุษย์บนแผ่นดิน ฉันขอขอบคุณท่านแล้ว ท่านจ้าวแห่งฝูงหมาป่า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110933
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110933,
					"content": "Boreas... กำลังกลับสู่กระแสพลัง เพราะอะไรกัน? ดาบของเจ้าหักไปแล้ว เจ้าไม่มีทางบรรจุวิญญาณได้อีกแล้วนี่นา ไม่สิ หรือว่า...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110934
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110934,
					"content": "แรงใจและแรงปรารถนา เรียกปาฏิหาริย์มาไม่ได้... เรื่องพรรค์นี้แน่ล่ะว่าฉันรู้ดี",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110935
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110935,
					"content": "...แต่การฝากวิญญาณน่ะ ไม่ได้มีแค่การฝากไว้ใน \"ดาบ\" อย่างเดียวมาตั้งแต่แรกแล้ว!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110936
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110936,
					"content": "...Dominator of Wolves เคยมอบพลังแห่งวิญญาณ ให้กับฝูงหมาป่าที่อยู่ใต้บังคับบัญชา เพื่อเสริมความแข็งแกร่งให้กับหัวใจ และลับเขี้ยวเล็บของพวกมันให้แหลมคม",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110937
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 160110937,
					"content": "...แม้ \"ข้า\" จะไม่ได้ตั้งใจให้เป็นเช่นนั้น แต่ \"หัวใจ\" ของมนุษย์ ก็จะถูกจิตวิญญาณของ Lupus Boreas ฉีกกระชาก กลืนกิน และหลอมรวม... ไม่ต่างอะไรกับฝูงคนที่ถูกบังคับให้รวมเข้ากับฝูงหมาป่า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110938
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 160110938,
					"content": "...การใช้หัวใจของมนุษย์ มารองรับวิญญาณของเทพอสูร... มันคือเส้นทางที่ไม่อาจย้อนกลับได้อีก แต่ฉันจะไม่ห้ามอัศวิน ที่ก้าวเข้าสู่เส้นทางที่เขาเลือกเองหรอกนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110939
					],
					"speakerTitle": "The Captain"
				},
				{
					"id": 160110939,
					"content": "หัวใจและจิตวิญญาณของเจ้า... ก็กำลังแตกสลายไปพร้อมกันด้วยงั้นเหรอ? ...อย่างนี้นี่เอง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110940
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110940,
					"content": "\"ลูกแกะไร้เดียงสา จะผูกกระดิ่งไว้ที่หน้าอกของหมาป่าได้ยังไง\"... คุณเคยถามแบบนี้ใช่มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110941
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110941,
					"content": "คำตอบของฉันก็คือ... ปล่อยให้หมาป่ากลืนหัวใจดวงนี้ลงไปเอง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110942
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110942,
					"content": "วิญญาณหมาป่าที่ฝากไว้ในดาบน่ะเป็นแค่ตัวหลอก แต่ความคิดและความทรงจำที่แท้จริง ถูกบรรจุอยู่ในหัวใจของเจ้า...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110943
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110943,
					"content": "เพื่อไม่ให้ข้าสังเกตเห็น เจ้าจงใจให้วิญญาณของ Lupus Boreas หลอมรวมกับตัวเจ้า แล้วค่อยถูกข้ากลืนกิน... จนถึงตอนนี้ เจ้าฝืนต่อสู้ทั้งที่ต้องแบกรับภาระ ที่หนักหนาขนาดนี้มาตลอดเลยงั้นรึ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110944
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110944,
					"content": "เทียบกับความมุ่งมั่นของ Lupus Boreas แล้ว... เสียสละแค่นี้ถือว่าเล็กน้อย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110945
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110945,
					"content": "เจตจำนงที่แข็งแกร่ง กลยุทธ์ที่ยอดเยี่ยม... แต่นี่ไม่ใช่วิธีต่อสู้ที่อัศวินพึงมี นั่นแหละคือเหตุผลที่ว่า ทำไมสิ่งที่เจ้าเลือกถึงได้ผิด",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110946
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110946,
					"content": "วิญญาณของเจ้าได้หลอมรวมเป็นหนึ่งเดียวกับ Andrius แล้ว เมื่อมันผสานตัวเองเข้ากับกระแสพลังอย่างสมบูรณ์ เจ้าก็จะร่วงหล่นลงไปพร้อมกับมันด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110947
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110947,
					"content": "ถึงตอนนั้น ไม่ว่าจะเป็น Barbatos หรือนักเดินทางคนนั้นที่อยู่ข้างกายเจ้า ก็ไม่อาจยึดเหนี่ยววิญญาณของเจ้า จากในกระแสพลังได้อีกต่อไป ยิ่งไม่ต้องพูดถึงว่าจะช่วยเจ้าออกมาได้เลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110948
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110948,
					"content": "เจ้าแพ้แล้ว ข้าก็เช่นกัน น่าเสียดาย ตอนนี้ข้าช่วยเจ้าไม่ได้แล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110949
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110949,
					"content": "...ขอให้วิญญาณของเจ้า ได้พักผ่อนอย่างสงบไปพร้อมกับ Boreas นักสำรวจผู้โดดเดี่ยวเอ๋ย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110950
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110950,
					"content": "...ฮ่าฮ่า โดดเดี่ยวงั้นเหรอ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110951
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110951,
					"content": "โทษทีนะ... ถึงฉันจะเคยคิดว่า การได้จบสิ้นไปพร้อมกับคุณในกระแสพลังนี้ ก็น่าจะเป็นตอนจบที่สมบูรณ์แบบพอแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110952
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110952,
					"content": "แต่น่าเสียดายที่มันไม่เหมือน Roland ในตอนนั้น ข้างนอกยังมีไวน์ดี ๆ และเพื่อนฝูงที่รอให้ฉันกลับไปอยู่ เพราะงั้น...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110953
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110953,
					"content": "...ฉันยังไม่คิดจะยอมรับชะตากรรมหรอกนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110954
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110954,
					"content": "ดิ๊งต่อง~ มีจดหมายถึงนายด้วยล่ะ~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
		{
			"id": 1601111,
