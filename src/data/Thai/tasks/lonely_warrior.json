					}
				]
			},
			"dialogs": [
				{
					"id": 160111101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111102
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111102,
					"content": "...เดินหน้าต่อไป ไม่ต้องหันกลับมา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111103
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160111103,
					"content": "\"Varka... ความหมายของชื่อผม... ผมรู้แล้วล่ะ\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111104
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 160111104,
					"content": "\"...ทำให้ทุกคนต้องลำบากขนาดนี้ ไว้กลับมาแล้ว ต้องขอบคุณกันดี ๆ ด้วยล่ะ\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111105
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 160111105,
					"content": "\"ไง ถึงจะมีเรื่องอยากรายงานหลายเรื่องเลยก็เถอะ แต่ว่า... แค่กลับมาก็ดีแล้วล่ะ\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111106
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 160111106,
					"content": "\"ผมไม่คิดจะกลับไปที่กองอัศวินอีก เพราะงั้น... เชิญท่านจัดการเองต่อไปแล้วกัน\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111107
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 160111107,
					"content": "\"...แกรนด์มาสเตอร์ พวกเรารอคุณอยู่นะ\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111108
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 160111108,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111109
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111109,
					"content": "หืม?... ฮึ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111110
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111110,
					"content": "ฉันทำหน้าที่แกรนด์มาสเตอร์ได้ไม่เลวเลยใช่มั้ยล่ะ?... ทุกคน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111111
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111111,
					"content": "...ฉันจะถือว่าพวกนายเห็นด้วยแล้วกันนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111112
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111112,
					"content": "สิ่งที่พวกนายสาบานว่าจะปกป้องด้วยชีวิตเมื่อตอนนั้น... ตอนนี้ก็ยังคงอยู่ที่นั่นเป็นอย่างดีเลยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111113
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111113,
					"content": "อืม ทั้งกองอัศวิน ทั้ง Mondstadt... และคำสาบานของอัศวิน ฉันจะปกป้องมันไว้ให้ดี",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111114
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111114,
					"content": "ดังนั้น... จดหมายฉบับนั้น ฉันจะเอาไปส่งให้แทนพวกนายเอง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111115
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111115,
					"content": "...ถึงจะเป็นเพียงเงาสะท้อนของ \"เขา\" แต่ถ้ามีเวลา ช่วยอ่านแทน \"เขา\" หน่อยได้มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111116
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111116,
					"content": "... ทั้ง Rostam และ Arundolyn ต่างก็ไม่เคยลืมนายเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111117
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111117,
					"content": "เฮ้อ... ครั้งนี้เดินทางมาไกลจริง ๆ เลยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111118
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111118,
					"content": "ส่วนที่เหลือก็...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111119
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111119,
					"content": "...ขอให้สายลมนำพาไปแล้วกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111122
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111122,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111130
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 160111130,
					"content": "...ไง ไม่เจอกันนานเลยนะ ทุกคน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111131
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111131,
					"content": "...ดีจริง ๆ ที่ได้เจอทุกคนอีกครั้ง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111132
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111132,
					"content": "ยินดีต้อนรับกลับมานะ... แกรนด์มาสเตอร์",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111133
					]
				},
				{
					"id": 160111133,
					"content": "...อื้ม ฉันกลับมาแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111123
					],
					"speakerTitle": "Varka"
				},
				{
