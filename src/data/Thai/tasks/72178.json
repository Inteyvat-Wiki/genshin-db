			"dialogs": [
				{
					"id": 721780201,
					"content": "ที่นี่ก็มีศาลเจ้า พวกเราเข้าไปดูกันเถอะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721780202,
					"content": "(ดูแล้วก็เป็นศาลเจ้าทั่วไป ไม่มีร่องรอยธาตุแปลกปลอมแต่อย่างใด)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780203
					],
					"speakerTitle": "ศาลเจ้า"
				},
				{
					"id": 721780203,
					"content": "ตรวจสอบ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721780204
					]
				},
				{
					"id": 721780204,
					"content": "(ศาลเจ้าที่นี่ดูสะอาดตามาก มีกลิ่นของ Sacred Sakura หอมฟุ้งกระจายไปทั่ว บางทีอาจจะเพิ่งมีคนเข้ามาขอพรที่นี่)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780205
					],
					"speakerTitle": "ศาลเจ้า"
				},
				{
					"id": 721780205,
					"content": "(แต่ว่านอกจากนี้แล้ว ก็ไม่มีร่องรอยอะไรใหม่ ๆ เลย)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780206
					],
					"speakerTitle": "ศาลเจ้า"
				},
				{
					"id": 721780206,
					"content": "กลิ่นของกลีบดอก Sacred Sakura นี่นา... แม่ของ Chouji อาจจะเคยมาที่นี่ก็ได้นะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721780207,
					"content": "และแน่นอนว่า เพิ่งมาเมื่อไม่นานนี้เอง!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
