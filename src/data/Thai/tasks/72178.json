			"dialogs": [
				{
					"id": 721780401,
					"content": "นี่ก็คือศาลเจ้าที่ Chouji พูดถึงสินะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721780402,
					"content": "(ดูแล้วเป็นศาลเจ้าที่ธรรมดา ๆ ไม่มีร่องรอยหรือสิ่งแปลกปลอมใด ๆ)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780403
