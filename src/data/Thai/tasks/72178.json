			"dialogs": [
				{
					"id": 721780101,
					"content": "(ดูแล้วก็เป็นศาลเจ้าทั่วไป ไม่มีร่องรอยธาตุแปลกปลอมแต่อย่างใด)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780102
					],
					"speakerTitle": "ศาลเจ้า"
				},
				{
					"id": 721780102,
					"content": "ตรวจสอบ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721780103
					]
				},
				{
					"id": 721780103,
					"content": "(ศาลเจ้าที่นี่ดูสภาพดีมากเลยล่ะ เหมือนเพิ่งถูกทำความสะอาดไปเมื่อไม่นานมานี้ คนที่ทำความสะอาดที่นี่อาจจะเป็นคนที่ละเอียดรอบคอบมากเลย)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780104
					],
					"speakerTitle": "ศาลเจ้า"
				},
				{
					"id": 721780104,
					"content": "(แต่ว่านอกจากนี้แล้ว ก็ไม่มีร่องรอยใหม่ ๆ เลยล่ะ)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780105
					],
					"speakerTitle": "ศาลเจ้า"
				},
				{
					"id": 721780105,
					"content": "แปลกจัง... เหมือนจะมีคนมานะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
