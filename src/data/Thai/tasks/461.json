			"dialogs": [
				{
					"id": 4610101,
					"content": "อ๊าาา ซวยแล้ว...แย่แล้ว...ทำไงดี...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610102,
						4610103
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610102,
					"content": "เป็นอะไร Kaeya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610104
					]
				},
				{
					"id": 4610104,
					"content": "#โอ้ ขอบคุณสายลมนับพันจริง ๆ ที่พา{F#เธอ}{M#นาย}มา {NICKNAME} ช่างเป็นของขวัญจากพระเจ้าจริง ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610105
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610105,
					"content": "#เทพแห่งลมได้ส่งเทวทูตลงมาเพื่อช่วยพวกเราแท้ ๆ ตอนนี้{F#เธอ}{M#นาย}พอจะว่างอยู่ไหม?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610106
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610106,
					"content": "โห จริงเร้ออ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610107,
						4610109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610107,
					"content": "จะพูดว่าไม่ว่างก็ไม่เชิง",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610108
					]
				},
				{
					"id": 4610108,
					"content": "งั้นก็เยี่ยมไปเลย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610110
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610110,
					"content": "#จริง ๆ มีเรื่องที่อัศวินคนอื่นรู้ไม่ได้ จำเป็นต้องให้{F#เธอ}{M#นาย}ช่วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610111
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610111,
					"content": "ยังไงพวกเราย้ายไปคุยที่อื่นกันเถอะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610112
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610112,
					"content": "ไปคุยกันที่ลานด้านนอกศูนย์บัญชาการละกัน ตามฉันมาเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610113
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610113,
					"content": "ทำไมต้องลับ ๆ ล่อ ๆ ด้วยนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610109,
					"content": "บอกมาเถอะว่าจริง ๆ แล้วมีอะไรกันแน่?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610110
					]
				},
				{
					"id": 4610103,
					"content": "คุณไม่น่าจะเป็นคนที่ขี้โวยวายนี่",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610104
					]
				}
			]
		},
