			"dialogs": [
				{
					"id": 200530101,
					"content": "เห้อ ปวดหัวจริงจริ๊งงง ...จะแก้ไขยังไงดีนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
