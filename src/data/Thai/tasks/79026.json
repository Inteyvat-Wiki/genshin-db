			"dialogs": [
				{
					"id": 790260101,
					"content": "ยินดีต้อนรับนะ! ยินดีต้อนรับ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260102
					],
					"speakerTitle": "หัวหน้าคณะละครทไวไลท์"
				},
				{
					"id": 790260102,
					"content": "ยินดีต้อนรับ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260104
					],
					"speakerTitle": "หัวหน้าคณะละครทไวไลท์"
				},
				{
					"id": 790260104,
					"content": "#คุณคือ {NICKNAME} ที่มีชื่อเสียง! แล้วก็ท่าน Paimon คู่หูที่ดีที่สุดสินะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260105
					],
					"speakerTitle": "หัวหน้าคณะละครทไวไลท์"
				},
				{
					"id": 790260105,
					"content": "ว้าวววว! คุณรู้จักชื่อของพวกเราได้ยังไงกัน?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790260106,
					"content": "แขกผู้มีเกียรติบนเกาะ ฉันก็ต้องรู้อยู่แล้วล่ะ เพราะว่าฉัน!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260107
					],
					"speakerTitle": "หัวหน้าคณะละครทไวไลท์"
				},
				{
					"id": 790260107,
					"content": "คุณ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790260108,
					"content": "ฉันคือหัวหน้าคณะละครทไวไลท์ผู้แสนโด่งดังยังไงล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260109
					],
					"speakerTitle": "หัวหน้าคณะละครทไวไลท์"
				},
				{
					"id": 790260109,
					"content": "ที่แท้ก็มีคนที่เรียกตัวเองว่ามีชื่อเสียงอยู่จริง ๆ ด้วยแฮะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790260110
					]
				},
				{
					"id": 790260110,
					"content": "ถึงแม้คุณจะบอกว่าตัวเองมีชื่อเสียง แต่พวกเราไม่เคยได้ยินเรื่องคุณมาก่อนเลยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790260111,
					"content": "ไม่เป็นไรหรอก! ในตอนนี้ทั้งสองท่านก็ได้ยินแล้วนี่นา!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260112
					],
					"speakerTitle": "หัวหน้าคณะละครทไวไลท์"
				},
				{
					"id": 790260112,
					"content": "หลังผ่านการเตรียมงานมาอย่างเข้มข้น ละครเวทีของเรา \"บันทึกดาบแห่งเจ้าหญิง\" ก็กำลังจะทำการแสดงรอบปฐมทัศน์แล้วล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260113
					],
					"speakerTitle": "หัวหน้าคณะละครทไวไลท์"
				},
				{
					"id": 790260113,
					"content": "ละครมีทั้งหมด 5 องก์ แต่ละองก์แบ่งเป็น 2 ฉาก ฉากแรกและฉากหลัง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260114
					],
					"speakerTitle": "หัวหน้าคณะละครทไวไลท์"
				},
				{
					"id": 790260114,
					"content": "แขกผู้มีเกียรติทั้งหลายมาได้เวลาพอดี! บทโหมโรงกำลังจะเริ่มทำการแสดงแล้ว! ขอให้ทุกท่านนั่งลง!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260115
					],
					"speakerTitle": "หัวหน้าคณะละครทไวไลท์"
				},
				{
					"id": 790260115,
					"content": "หลังเวทียังมีเรื่องต้องไปจัดการอีกนิดหน่อย ฉันขอตัวก่อนนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260116
					],
					"speakerTitle": "หัวหน้าคณะละครทไวไลท์"
				},
				{
					"id": 790260116,
					"content": "ละครเวทีที่คณะละครทไวไลท์บรรจงสร้างขึ้นมาอย่างสุดกำลัง กำลังจะเปิดม่านแล้ว ขอเชิญทุกท่านรับชมได้เลย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "หัวหน้าคณะละครทไวไลท์"
				}
			]
		}
	]
