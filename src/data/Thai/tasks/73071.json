			"dialogs": [
				{
					"id": 730710601,
					"content": "ว้าว... Sweet Flower เพียบเลย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710602
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710602,
					"content": "Varsha วิ่งเร็วอย่างนั้น ระวังล้มนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710603,
					"content": "ฮี่ฮี่ ดอกไม้ที่นี่บานสะพรั่งเลย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710604
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710604,
					"content": "#Paimon! {NICKNAME}! รีบมาดูนี่สิ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710605
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710605,
					"content": "#Varsha ใจร้อนจังเลยนะ {NICKNAME} พวกเราก็รีบไปกันเถอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
