			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amane",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30320501,
					"content": "ฟู่วววว! ในที่สุดก็ได้เวลาพักแล้ว!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320502,
					"content": "จู่ ๆ พอผ่อนคลายลงก็รู้สึกทั้งหิวทั้งเหนื่อยเลยอ่า...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320503,
						30320504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320503,
					"content": "Paimon พักผ่อนเยอะ ๆ เถอะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320505
					]
				},
				{
					"id": 30320505,
					"content": "เย้! เยี่ยมไปเลย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320506,
					"content": "...เอ๋? กาน้ำนั่น...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320507,
					"content": "...หืม?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320508
					]
				},
				{
					"id": 30320508,
					"content": "มีคนทำมันแตกตอนมาทำความสะอาดหรือเปล่านะ? แต่ว่า ไม่เห็นได้ยินว่าจะมีคนมาเก็บกวาดห้องเลยนี่นา...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320509,
					"content": "(คืนนั้นตอนอยู่ในที่พัก Paimon ตกอกตกใจกับเรื่องของ The Balladeer จนไม่ระวังชนโต๊ะ ทำกาน้ำอันนี้ตกแตก)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320510
					]
				},
				{
					"id": 30320510,
					"content": "(แต่จากนั้น The Balladeer ก็ลบเลือนการมีอยู่ของตัวเองไปแล้วนี่ เขาเปลี่ยนโลกนี้ไปแล้วไม่ใช่เหรอ? งั้นกาน้ำนี่... ทำไมถึงยังแตกอยู่ล่ะ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320511
					]
				},
				{
					"id": 30320511,
					"content": "ฟังดูแล้ว เธอคงสับสนน่าดูเลยสินะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320512
					],
					"speakerTitle": "Amane"
				},
				{
					"id": 30320512,
					"content": "...ใครน่ะ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320513
					]
				},
				{
					"id": 30320513,
					"content": "ฉันเข้าใจถึงความรู้สึกของเธอดี ไม่ว่าใครมารู้เรื่องพวกนี้ก็ต้องรู้สึกสับสนมึนงงทั้งนั้น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320514
					],
					"speakerTitle": "Amane"
				},
				{
					"id": 30320514,
					"content": "เอ๋? มีคนกำลังพูดอยู่ที่ข้างหูพวกเราเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320515,
					"content": "แต่ว่าน่าเสียดาย โชคชะตาของ Teyvat ไม่อาจสั่นคลอนได้ง่าย ๆ เทพเจ้ามีโอกาสเพียงน้อยนิดที่จะทำสำเร็จ ทว่าตัวตนที่ไม่ใช่เทพเจ้านั้น... ก็คงจะพูดยาก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320516
					],
					"speakerTitle": "Amane"
				},
				{
					"id": 30320516,
					"content": "สิ่งมีชีวิตตัวเล็กตัวน้อยชนกิ่งไม้แล้วอาจทำให้มันสั่นไหว ทว่าการเอียงหรือเบี้ยวไม่เท่ากับการย้ายตำแหน่ง โชคชะตาก็เช่นกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320517
					],
					"speakerTitle": "Amane"
				},
				{
					"id": 30320517,
					"content": "เช่นเดียวกับที่กาน้ำตกลงพื้น จะเป็นแมวที่ปัดมันตกแตก หรือจะเป็นนกที่บินชนมันตกแตกก็ดี ผลลัพธ์ของมันก็ยังแตกอยู่ดี ใช่มั้ยล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320518
					],
					"speakerTitle": "Amane"
				},
				{
					"id": 30320518,
					"content": "ธะ เธอเป็นใครน่ะ! ทำไมเธอถึงรู้เรื่องพวกนี้ได้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320519,
					"content": "ประวัติศาสตร์ไม่ได้เปลี่ยนแปลงโดยง่าย แต่ใจของผู้คนนั้นจะแปรเปลี่ยนไป เชื่อมั่นในดวงตาของตัวเอง สิ่งที่เธอพบเห็นถึงจะเป็นความจริง ส่วนสิ่งที่ไม่เห็นต่างก็เป็นสิ่งลวงหลอก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320520
					],
					"speakerTitle": "Amane"
				},
				{
					"id": 30320520,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320521
					]
				},
				{
					"id": 30320521,
					"content": "เสียงหายไปแล้ว...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320522,
					"content": "คนเมื่อตะกี้คือใครกันแน่เนี่ย! จู่ ๆ ก็โผล่ออกมาพูดอะไรน่ากลัว ๆ หมายความว่าอะไรกันแน่...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320523,
					"content": "(เชื่อมั่นในดวงตา? สิ่งที่เธอพูด... หมายถึงให้ฉันเชื่อมั่นในความทรงจำของตัวเองงั้นเหรอ?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320524
					]
				},
				{
					"id": 30320524,
					"content": "ว่าแต่ เศษกาน้ำแตกบนพื้นยังไม่ได้จัดการเลย ฉันไปเรียกคนให้มาช่วยเก็บแล้วกันนะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320525,
					"content": "...รู้สึกว่าถ้าปล่อยเอาไว้แบบนี้ ในใจมันจะรู้สึกแปลก ๆ พิกลน่ะ เดี๋ยวฉันรีบไปรีบกลับนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320526,
					"content": "(...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320527
					]
				},
				{
					"id": 30320527,
					"content": "(ในอนาคต ยังจะมีเรื่องอะไรรอฉันอยู่อีกนะ?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 30320504,
					"content": "เดี๋ยวซื้อของกินอร่อย ๆ มาเป็นรางวัลให้นะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320505
					]
				}
			]
