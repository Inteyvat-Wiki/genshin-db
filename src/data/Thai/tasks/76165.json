					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761650101,
					"content": "อืม... ดูเหมือนจะเป็นสุสานของผู้เฝ้าประภาคารนะ หรือจะเป็นของทหารประภาคารที่เราเจอในหุบเขา?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761650102,
					"content": "พวกเขาผลุบ ๆ โผล่ ๆ แวบมาแล้วก็หายไปอย่างรวดเร็ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761650103,
					"content": "อืม ฉันไม่เข้าใจเลย คราวหน้าไปถามคนที่ Piramida ดีกว่า! บางทีอาจจะมีคนที่นั่นรู้เรื่องนี้ก็ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7616502,
			"completionStepIds": [
				7616502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7616502",
							"2"
						],
						"stepId": 7616502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Patolichev"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761650201,
					"content": "อ้อ สวัสดี ฉันชื่อ Patolichev เป็นเจ้าหน้าที่จัดการทรัพยากรของผู้เฝ้าประภาคาร คุณมีธุระอะไรเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650202
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650202,
					"content": "Patolichev แห่ง \"อาชาแห่งสายลมหนาว\" เหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761650203
					]
				},
				{
					"id": 761650203,
					"content": "\"อาชาแห่งสายลมหนาว\"... อ๋อ เงาประหลาดที่พวกเราเห็นก่อนหน้านี้น่ะเหรอ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761650204,
					"content": "ใช่แล้ว นั่นคือหน่วยที่ฉันเคยสังกัดอยู่ \"อาชาแห่งสายลมหนาว\" เป็นชื่อที่ชวนให้คิดถึงจริง ๆ ไม่คิดว่าจะได้ยินมันจากปากของคุณ... คุณรู้ได้ยังไง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650205,
						761650208
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650205,
					"content": "เราเคยไปที่หน้าผา Kipumaki",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761650206
					]
				},
				{
					"id": 761650206,
					"content": "ใช่แล้ว ใช่แล้ว พวกเรากวาดล้างการล่าอันบ้าคลั่งตรงนั้นเรียบร้อยแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761650207,
					"content": "และพวกเรายังได้เห็นทหารประภาคารของ \"อาชาแห่งสายลมหนาว\" และเงาที่เหลือจากการต่อสู้กับการล่าอันบ้าคลั่งด้วย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761650210,
					"content": "ไม่คิดเลยว่าจะเป็นเรื่องจริง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650211
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650211,
					"content": "ก็เป็นเรื่องจริงน่ะสิ พวกเราเห็นมากับตาตัวเองเลยนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761650212,
					"content": "อ๋า... ตลอดหลายปีที่ผ่านมา มีคนมาบอกฉันเป็นระยะ ๆ ว่าเคยเห็นเงาของเพื่อนร่วมงานฉัน ที่เสียสละชีวิตไปแล้วที่หน้าผา Kipumaki เพราะอย่างนี้ฉันถึงยังไปที่นั่นบ่อย ๆ จนถึงตอนนี้... ก็ยังคอยแวะไปทำความสะอาดหลุมศพของพวกเขาด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650213
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650213,
					"content": "แต่ฉันไม่เคยเจอพวกเขาเลยสักครั้ง... มันผ่านมานานมากแล้ว ฉันคิดว่ามันคงเป็นคำโกหกที่แต่งขึ้นมา เพื่อปลอบใจฉัน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650214
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650214,
					"content": "ไม่คิดเลยว่าพวกคุณจะได้เจอกับพวกเขาจริง ๆ... แต่ทำไมตอนที่ฉันไป พวกเขาถึงไม่ยอมออกมาพบฉันล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650215,
						761650217
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650215,
					"content": "บางทีอาจยังไม่ถึงเวลาที่จะได้พบกันก็ได้...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761650216
					]
				},
				{
					"id": 761650216,
					"content": "ก็อาจจะอย่างนั้น... แต่ฉันรู้ว่าพวกเขาอยู่ที่นั่นจริง ๆ ถึงจะเป็นแค่ความทรงจำเลือนราง หรือเงาที่จับต้องไม่ได้ แต่สำหรับฉัน แค่นี้ก็เพียงพอแล้ว...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650219
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650219,
					"content": "เอาเป็นว่า ขอบคุณมากนะที่ยอมเล่าให้ฉันฟัง เรื่องนี้สำคัญกับฉันมาก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650220
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650220,
					"content": "ต้องขอบคุณพวกเขา ฉันถึงได้มายืนอยู่ตรงนี้ แต่ฉันก็หวังจากใจจริงว่า จะได้ยืนเคียงข้าง และต่อสู้ร่วมกับพวกเขาที่หน้าผา Kipumaki อีกครั้ง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650221
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650221,
					"content": "...สักวันหนึ่ง สักวันหนึ่งฉันจะต้องได้พบกับพวกเขาอีกครั้ง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650217,
					"content": "บางทีคงไม่อยากให้คุณนึกถึงอดีตที่เจ็บปวด...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761650218
					]
				},
				{
					"id": 761650218,
					"content": "ฮึ... ช่วงเวลาที่ได้ต่อสู้เคียงข้างพวกเขาจนถึงที่สุด จะเป็นความเจ็บปวดได้ยังไง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650219
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650208,
					"content": "พวกเราได้เห็นทหารประภาคารของ \"อาชาแห่งสายลมหนาว\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761650209
					]
				},
				{
					"id": 761650209,
					"content": "ใช่แล้ว ถึงพวกเขาจะเหลือไว้แค่เงาบางส่วน... แต่เงาพวกนั้นก็ได้บันทึกภาพการต่อสู้ ระหว่างพวกเขากับการล่าอันบ้าคลั่งเอาไว้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650210
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}