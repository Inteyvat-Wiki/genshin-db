			},
			"dialogs": [
				{
					"id": 230060101,
					"content": "เฮ้อ เวลานี้จะหาใครได้ล่ะเนี่ย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060102
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060102,
					"content": "เป็นอะไรเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060103
					]
				},
				{
					"id": 230060103,
					"content": "อ๊ะ! สะ สวัสดี นักเดินทาง เธอมารับการรักษาเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060104,
						230060105
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060104,
					"content": "แค่ผ่านมาน่ะ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060106
					]
				},
				{
					"id": 230060106,
					"content": "ฮ่าฮ่า... เห็นชัดขนาดนั้นเลยเหรอ? แต่ฉันกำลังกลุ้มใจมากจริง ๆ นั่นแหละ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060107
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060107,
					"content": "ไม่รู้ทำไมช่วงนี้ถึงมีคนมาขอรับการรักษาที่ \"Bimarstan\" ของเราเยอะขึ้นเรื่อย ๆ จนเราต้องจัดสรรพนักงานเกือบทั้งหมดไปคอยดูแลผู้ป่วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060108
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060108,
					"content": "แต่คุณหมอ Zakariya ก็ยังยืนกรานให้ฉันหาทางทำความสะอาดพื้นที่โดยรอบอยู่ดี...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060109
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060109,
					"content": "เขาบอกว่า เพื่อให้ทุกคนรับการคุ้มครองจากเทพแห่งพฤกษาได้ง่ายขึ้น จำเป็นต้องรักษาร่างกายและจิตใจของผู้ป่วย รวมถึงโรงพยาบาลให้สะอาดอยู่เสมอ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060110
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060110,
					"content": "เฮ้อ แต่ตอนนี้หาคนไม่ได้เลย จะไหว้วานให้ผู้ป่วยที่มีอาการไม่รุนแรงมาช่วยตลอดก็คงไม่ได้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060111,
						230060113
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060111,
					"content": "เดี๋ยวฉันจัดการให้ก็ได้",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060112
					]
				},
				{
					"id": 230060112,
					"content": "เธอยินดีช่วยงั้นเหรอ? ขอบคุณมากเลยนะ! ฉันจะเตรียมค่าตอบแทนไว้ให้แน่นอน แม้ว่า เอ่อ จะไม่เยอะมากก็เถอะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060123
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060123,
					"content": "เฮ้อ ขอให้ท่านเทพแห่งพฤกษาช่วยคุ้มครองทุกคนให้ปราศจากโรคภัยไข้เจ็บด้วยเถิด...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060113,
					"content": "จ้างคนมาช่วยไม่ได้เหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060114
					]
				},
				{
					"id": 230060114,
					"content": "ที่นี่มีแต่คนป่วย เลยไม่ค่อยมีใครอยากอาสามาช่วย เราเองก็มีเงินจำกัด จะจ้างคนเยอะ ๆ ก็คงไม่ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060115
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060115,
					"content": "ปกติเราจะผลัดกันเข้าเวร แต่ตอนนี้งานยุ่งมาก ไม่มีใครว่างเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060116
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060116,
					"content": "นักเดินทาง ถ้า... ถ้าเธอสะดวกล่ะก็ มาช่วยเราหน่อยได้มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060117
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060117,
					"content": "เรามีค่าตอบแทนให้นะ! แม้ว่า... แม้ว่าจะไม่เยอะมากก็เถอะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060118
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060118,
					"content": "อาการของผู้ป่วยที่นี่...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060119
					]
				},
				{
					"id": 230060119,
					"content": "ผู้ป่วยของที่นี่จะมีอาการเจ็บป่วยเล็ก ๆ น้อย ๆ จำพวกอาการปวดหัวน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060120
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060120,
					"content": "คุณหมอ Zakariya เคยบอกไปหลายครั้งแล้วว่า อาการป่วยพวกนี้ไม่ได้อันตราย แต่ก็ไม่มีใครฟังเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060121
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060121,
					"content": "ฉันคิดว่า บางทีสิ่งที่ทุกคนกลัวอาจไม่ใช่ตัวโรค แต่กลัวว่าจะป่วยต่างหาก...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060122
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060122,
					"content": "งั้นฝากนักเดินทางจัดการเรื่องการทำความสะอาดด้วยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060123
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060105,
					"content": "แค่เห็นว่าคุณดูกลุ้มใจมากน่ะ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060106
					]
				}
			]
		},
