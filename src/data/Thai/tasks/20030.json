			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200300201,
					"content": "ถ้างั้นก็ให้ฉันต้อนรับเธออย่างเป็นทางการเลยละกัน ดาวดวงใหม่แห่งพี่น้องนักผจญภัย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300202
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300202,
					"content": "นี่คือ <color=#00E1FFFF>คู่มือนักผจญภัย</color> ของเธอ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300203,
						200300205
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300203,
					"content": "คู่มือนักผจญภัย?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200300204
					]
				},
				{
					"id": 200300204,
					"content": "เรื่องสำคัญอย่างการที่มีคนใหม่เข้ามานี้ แน่นอนต้องมีพิธีกรรมสักหน่อยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300207
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300207,
					"content": "มันจะบันทึกข้อมูลจำนวนมากเกี่ยวกับคำขอและรางวัลของทางกิลด์",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300208
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300208,
					"content": "ในขณะเดียวก็เป็นใบประกาศการเป็นสมาชิกของกิลด์ด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300209
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300209,
					"content": "จริงสิ ยังมีอีกเรื่องหนึ่ง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300210
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300210,
					"content": "บางครั้งมันจะมีช่วงที่ยากในการเพิ่ม \"แรงก์ผจญภัย\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300211
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300211,
					"content": "ถึงตอนนั้นจำเป็นจะต้องทำ \"เควสต์ที่ทำให้คนประทับใจ\" เพื่อรับการยอมรับจากทางกิลด์",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300212
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300212,
					"content": "เควสต์...ที่ทำให้คนประทับใจ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200300213,
					"content": "พูดได้ว่าเป็น \"เควสต์เลื่อนขั้น\" เพื่อทะลุกำแพงของ \"แรงก์ผจญภัย\" ล่ะนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300214
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300214,
					"content": "ตอนนี้ยังไม่ถึงเวลา เมื่อเธอได้รับ Exp ที่เพียงพอ เดี๋ยวก็จะได้โอกาสที่จะได้รับการยอมรับจากทุกคนเองแหละ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300215
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300215,
					"content": "งั้นวันนี้พอแค่นี้ก่อนนะ เดี๋ยวอีกหน่อยพวกเราจะได้พบกันบ่อย ๆ แน่นอน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300216
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300216,
					"content": "สู้ ๆ นะคุณนักผจญภัย ไปให้ถึงดวงดาวและก้นเหว!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300205,
					"content": "นี่คือ...แผ่นพับโฆษณา?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200300206
					]
				},
				{
					"id": 200300206,
					"content": "พูดอย่างนี้ก็ได้ แต่ว่ามันมีประโยชน์มากเลยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300207
					],
					"speakerTitle": "Katheryne"
				}
			]
		}
	]
}