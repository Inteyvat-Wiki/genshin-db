					"#{REALNAME[ID(2)|SHOWHOST(true)]}"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750080101,
					"content": "Manqu พวกเรากลับมาแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750080102,
					"content": "กี้!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080103
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750080103,
					"content": "อืม นี่เป็นการรอคอยที่ทรมานมากเลย ยิ่งต้องรอนานเท่าไหร่ บอกตามตรงเลยนะ ใจของฉันก็ยิ่งเป็นกังวลมากเท่านั้นน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080104
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080104,
					"content": "แม้ว่า... ฉันจะเป็นคนเสนอขึ้นมา แต่ถ้าพวกเธอเข้าไปในโบราณสถานแล้วกลับมาไม่ได้ ฉันเองก็คงจะต้องอยู่กับความรู้สึกผิดแน่ ๆ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080105
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080105,
					"content": "แต่ว่า ขอโทษที่ต้องพูดตรง ๆ พวกเธอคงจะเจอโทเคนที่ \"ปราชญ์จอมโจรขโมยเพลิง\" ทิ้งเอาไว้ในโบราณสถานแล้วสินะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080106,
						750080107
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080106,
					"content": "เหนื่อยพอควรเลยล่ะ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750080108
					]
				},
				{
					"id": 750080108,
					"content": "ฉันเชื่ออยู่แล้วล่ะว่าพวกเธอจะต้องทำสำเร็จได้แน่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080109
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080109,
					"content": "กี้!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080110
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750080110,
					"content": "ดูสิ มันก็คือเจ้าสิ่งที่เหมือนแผ่นกลม ๆ นี่แหละ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750080111,
					"content": "อ๊ะ... \"แผ่นทองแห่งคำชี้ขาด\" นี่นา \"แผ่นทองแห่งคำชี้ขาด\" ในตำนานมีอยู่จริงเหรอเนี่ย เยี่ยมไปเลย ฉันต้องบันทึกไว้ในผลการวิจัยของฉันให้ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080112
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080112,
					"content": "ที่แท้ของสิ่งนี้ก็เรียกว่า \"แผ่นทองแห่งคำชี้ขาด\" นี่เอง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750080113,
					"content": "ชะ...ใช่แล้วล่ะ เฮ้อ ขอโทษที่ฉันเสียมารยาทนะ ฉันตื่นเต้นเกินไปหน่อยน่ะ ได้ยินมาว่านี่เป็นของที่ \"ปราชญ์จอมโจรขโมยเพลิง\" คนนั้นเคยผ่านมือมาด้วยตัวเองเลยล่ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080114
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080114,
					"content": "เมื่อกี้มีอยู่แวบนึงเลย ที่ฉันอยากจะครอบครองเอามันมาเป็นของตัวเอง เพื่อใช้เป็นมรดกตกทอดของครอบครัวอะไรแบบนั้นน่ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080115
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080115,
					"content": "#ทำแบบนั้นไม่ได้หรอก พวกเราจะเอาไปใช้ช่วย {REALNAME[ID(2)|SHOWHOST(true)]} นะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750080116,
					"content": "กี้!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080117
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750080117,
					"content": "ฉันรู้น่า... แต่ว่าเบาะแสของโทเคน ฉันก็รู้แค่เบาะแสของอันนี้แหละ ส่วนอีกอันนึง ฉันไม่รู้ว่ามันอยู่ที่ไหนเหมือนกันน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080118
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080118,
					"content": "Ochkanatlan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750080119
					]
				},
				{
					"id": 750080119,
					"content": "#เอ่อ ขอโทษที่ต้องพูดตรง ๆ นะ {NICKNAME} เธอหมายถึง Ochkanatlan งั้นเหรอ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080120
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080120,
					"content": "(เล่าสิ่งที่เห็นในตอนสัมผัสแผ่นศิลา...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750080121
					]
				},
				{
					"id": 750080121,
					"content": "อืม ที่ Ochkanatlan เองสินะ... นั่นเป็นซากปรักหักพังของเมืองโบราณ ที่อยู่ทางทิศเหนือของเผ่าวงศ์ปีกบุปผา ที่อยู่อีกฟากของทะเลน่ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080122
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080122,
					"content": "ถ้าเป็นที่ Ochkanatlan ฉันต้องขอโทษด้วยนะ แต่ฉันคงช่วยอะไรไม่ได้ ที่นั่นไม่ใช่แค่เป็นพื้นที่ต้องห้ามของเผ่าเท่านั้น แต่ยังเป็นพื้นที่ต้องห้ามของสมาคมวิจัยมรดกแห่ง Saurian อีกด้วย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080123
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080123,
					"content": "ว่ากันว่าเมื่อหลายปีก่อน มีสมาชิกของสมาคมวิจัยมรดกแห่ง Saurian ได้รับคำขอให้ไปตรวจสอบ แต่สุดท้ายก็เหมือนกับก้อนหินที่จมลงไปในน้ำ ไม่มีข่าวคราวอะไรกลับมาอีกเลยน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080124
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080124,
					"content": "ตั้งแต่นั้นมา ทางสมาคมของพวกเราก็ไม่ได้เข้าไปยุ่งเกี่ยวกับเรื่องใด ๆ ก็ตาม ที่เกี่ยวกับ Ochkanatlan อีกเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080125
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080125,
					"content": "ไม่เป็นไร รู้แค่นี้ก็พอแล้วล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750080126,
					"content": "กี้!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080127
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750080127,
					"content": "อืม ฉันต้องขอขอบคุณพวกเธออีกครั้งนะ การที่ได้เห็น \"แผ่นทองแห่งคำชี้ขาด\" มันสำคัญกับฉันมากจริง ๆ ไม่ได้การแล้วล่ะ ฉันต้องรีบกลับไปบันทึกเรื่องนี้เอาไว้แล้ว...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080128
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080128,
					"content": "#ขอบคุณอีกครั้งนะ {NICKNAME}, Paimon ขอให้การเดินทางของพวกเธอราบรื่นนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080129
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080129,
					"content": "#แล้วก็ขอให้ {REALNAME[ID(2)|SHOWHOST(true)]} กำจัดตราสัญลักษณ์ \"พรแห่งจ้าวอัคคี\" ออกไปได้นะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080130
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080130,
					"content": "แล้วเจอกัน!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750080131
					]
				},
				{
					"id": 750080131,
					"content": "อืม... ที่จุดหมายในการเดินทาง ณ สถานที่ที่ดวงวิญญาณหวนคืน พวกเราจะได้พบกันอีกครั้งแน่นอน!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080107,
					"content": "สบายมากแค่นี้จิ๊บ ๆ!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750080108
					]
				}
			]
		},
