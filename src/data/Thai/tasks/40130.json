						"pointId": 6609
					}
				]
			},
			"dialogs": [
				{
					"id": 401300801,
					"content": "เฮ้! Freminet! \"Thelxie\"! พวกเรามาแล้ว~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300802,
					"content": "#สวัสดี Paimon แล้วก็ {NICKNAME}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300803
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300803,
					"content": "-.. -... .-- -...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300804
					],
					"speakerTitle": "\"Thelxie\""
				},
				{
					"id": 401300804,
					"content": "วันนี้ทำมงกุฎเสร็จแล้วใช่มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300805,
					"content": "อื้ม ตอนนี้รอแค่มาดาม Zuria แล้วล่ะ เธอยังไม่มาน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300806
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300806,
					"content": "งั้นพวกเรารออีกสักพักละกัน หรือว่าไปหามาดามเลยดีมั้ย ยังไงก็อยู่ไม่ไกลอยู่ล่ะ บ้านของเธออยู่ตรงเนินเขานั่นใช่มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300807,
					"content": "#เฮ้! {NICKNAME}! Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300808
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 401300808,
					"content": "ฮิฮิ พอพูดถึงก็มาเลยเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300809,
					"content": "ในที่สุดก็เจอพวกเธอซะที... โล่งอกไปทีที่พวกเธอไม่เป็นไร...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300810
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 401300810,
					"content": "เอ๋? Delaroche ทำไมถึงเป็นเธอล่ะ? พวกเราจะเป็นอะไรได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300811,
					"content": "จะเป็นอะไรได้งั้นเหรอ? ก็มาเพราะเรื่อง Thelxie ไง! อิมป์น้ำที่น่ากลัว ๆ นั่นน่ะ! วันนั้นที่มอบหมายคำขอให้เธอ ฉันก็รู้สึกไม่ค่อยสบายใจ ก็เลยไปสืบเรื่องเด็กที่เดินลงไปในน้ำคนนั้น...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300812
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 401300812,
					"content": "เรื่องนั้นพวกเราตรวจสอบมาแล้วล่ะ ที่จริงคือ Freminet ต่างหากล่ะ ส่วนฝูงปลาก็เป็นเพราะเขานั่นแหละที่ทำให้มันตกใจจนหนีไป ไม่ต้องห่วงนะ เดี๋ยวพวกเราทำงานเสร็จเมื่อไหร่ ก็จะช่วยตามฝูงปลากลับมาเอง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300813,
					"content": "ขอโทษนะ ผมเป็นนักประดาน้ำ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300814
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300814,
					"content": "เอ๋? Freminet? นักประดาน้ำ? ไม่ไม่ไม่... น่าจะไม่ใช่งี้นะ? ข่าวที่ฉันได้ยินมาไม่ใช่แบบนี้นี่...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300815
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 401300815,
					"content": "ฉันได้ยินมาว่า เมื่อประมาณหนึ่งเดือนก่อน มีเด็กคนหนึ่งที่บนตัวผูกด้วยเปลือกหอยหนักรอบตัว และเดินลงไปในน้ำด้านหลังนั่น... หลังจากนั้นเขาก็ไม่เคยกลับมาอีกเลย... เขาต้องถูกอิมป์น้ำหลอกลวงไปแน่ ๆ เลย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300816
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 401300816,
					"content": "อะไรนะ? ธะ...เธอเข้าใจผิดแล้วรึเปล่า?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300817,
					"content": "จริงแท้แน่นอน ฉันยืนยันกับชาวประมงที่เคารพนับถือหลายคนแล้ว ปีนี้เด็กคนนั้นอายุ 8 ขวบ เขาชื่อว่า Lescot... Lescot Destree",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300818
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 401300818,
					"content": "เดี๋ยวนะ... Lescot Destree?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300819
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300819,
					"content": "ใช่ ชื่อนี้แหละ ว่ากันว่าบรรพบุรุษของตระกูลพวกเขา ย้ายมาจากเมืองหนึ่งที่ชื่อ Destree อะไรนี่แหละ แม่ของเขาเป็นนักค้างานศิลปะ ส่วนพ่อเห็นว่าเสียชีวิตไปนานแล้วจากอุบัติเหตุ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300820
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 401300820,
					"content": "เฮ้อ... พอเกิดเรื่องนี้ขึ้น แม่ของเขาก็รู้สึกเสียใจกับเหตุการณ์นี้มาก จนล้มป่วยหนัก ได้ยินว่าตอนนี้ออกจากนครว่าการ Fontaine ไปแล้ว และไม่รู้ว่าไปอยู่ที่ไหน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300821
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 401300821,
					"content": "ไม่ใช่มั้ง? Lescot Destree... Zuria Destree... คงไม่บังเอิญขนาดนั้นหรอกมั้ง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300822
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300822,
					"content": "เห็นทีคงต้องไปที่บ้านมาดาม Zuria หน่อยแล้วล่ะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401300823
					]
				},
				{
					"id": 401300823,
					"content": "คุณผู้หญิง ขอโทษนะฮะ! พวกเรามีธุระต้องขอตัวก่อนนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300824
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300824,
					"content": "อ้อ ๆ... พวกเธอไปเถอะ ฉันก็แค่แวะมาดูเท่านั้น พวกเธอไม่เป็นไรก็ดีแล้ว งั้นฉันกลับก่อนนะ... พวกเธอก็ระวังตัวด้วยนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Delaroche"
				}
			]
		},
