				]
			},
			"dialogs": [
				{
					"id": 762010201,
					"content": "...พี่ Metta ใจร้าย ฉันก็แค่อยากให้พี่สนุกกับการผจญภัย ทำไมต้องพูดขัดคอแบบนี้ด้วยล่ะ ฮือ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010202
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010202,
					"content": "ถ้านายไม่เลิกนิสัยนึกอยากจะทำอะไรก็ทำแบบนี้ คนอื่นเขาก็คงจะรับนายไม่ไหวเหมือนกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010203
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010203,
					"content": "ฉันไม่ได้นึกอยากจะทำอะไรก็ทำซะหน่อย... ฉะ...ฉันเองก็มีการวางแผนของตัวเองเหมือนกันนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010204
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010204,
					"content": "การวางแผนเหรอ... อื้ม",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010205
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010205,
					"content": "ทำเป็นไม่สนใจฉันอีกแล้วนะ... ฉันจะไม่คุยกับพี่อีกแล้ว ต่อให้ตอนนั้นพี่จะเสียใจทีหลัง ก็ไม่มีประโยชน์แล้วล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010206
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010206,
					"content": "...อ๊ะ พี่ Linnea! พี่ฟังฉันนะ พี่ Metta เขา...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010207
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010207,
					"content": "หลังจากฟัง Vesa เล่าเรื่องราวที่เกิดขึ้นก่อนหน้านี้อย่างตะกุกตะกัก ก็ดูเหมือนจะเป็นแค่ความขัดแย้งเล็ก ๆ น้อย ๆ ที่พบได้บ่อยในหมู่เด็ก ๆ...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						762010208
					]
				},
				{
					"id": 762010208,
					"content": "ไม่ว่ายังไง ฉันก็ไม่ใช่ฝ่ายผิดอยู่ดีนั่นแหละ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010209
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010209,
					"content": "งั้น ฉัน... ฉันก็ไม่ผิดเหมือนกันนะ! พี่ Linnea...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010210
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010210,
					"content": "อืม... บางครั้งเรื่องแบบนี้ก็เกิดขึ้นได้นะ ทั้งที่ทุกคนไม่ได้ทำอะไรผิด แต่ผลลัพธ์กลับไม่ได้เป็นอย่างที่หวัง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010211
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010211,
					"content": "จริงด้วย เหมือนกับเรื่องราวของสองพี่น้องลูกหลานจันทราน้ำค้างแข็ง ที่เป็นตัวแทนของดอก Nocturnal เลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010212
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010212,
					"content": "เรื่องราวของพี่น้องเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010213
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010213,
					"content": "อืม ว่ากันว่ากาลครั้งหนึ่งเคยมีพี่น้องลูกหลานจันทราน้ำค้างแข็งคู่หนึ่ง พวกเธอมีนิสัยที่แตกต่างกันอย่างสิ้นเชิง เหมือนกับดอก Nocturnal สีแดงและสีฟ้า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010214
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010214,
					"content": "สองพี่น้องต่างก็ทำในสิ่งที่ตัวเองคิดว่าถูกต้อง แต่ก็เพราะแบบนั้นเหมือนกันที่ทำให้ต้องแยกทางกันไป",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010215
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010215,
					"content": "ว่ากันว่าน้องสาวไม่เคยยกโทษให้พี่สาวที่ทิ้งตัวเองไปเลย ถึงแม้ว่าหลังจากนั้น พี่สาวจะช่วยชีวิตผู้คนเอาไว้มากมายก็ตาม... แต่สุดท้าย ทั้งสองคนก็ไม่ได้พบกันอีกเลย จนวาระสุดท้ายของชีวิต",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010216
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010216,
					"content": "ลูกหลานจันทราน้ำค้างแข็งมีเรื่องราวแบบนี้อยู่ด้วยเหรอเนี่ย... ไม่เคยได้ยินมาก่อนเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010217
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010217,
					"content": "ฉันก็ไม่เคยได้ยินเหมือนกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010218
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010218,
					"content": "ฉันเองก็ฟังมาจากพวกกวีพเนจรเหมือนกัน บางทีอาจจะมีส่วนที่เสริมเติมแต่งเข้าไปบ้าง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010219
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010219,
					"content": "อ๋อ ที่แท้ก็เป็นเรื่องที่แต่งขึ้นมานี่เอง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010220
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010220,
					"content": "แหม ถึงเรื่องราวอาจจะเป็นเรื่องโกหก แต่เหตุผลของเรื่องนี้ก็ยังถูกอยู่ดีรึเปล่า?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010221
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010221,
					"content": "ไม่มีใครคิดว่าตัวเองเป็นฝ่ายผิดเลย ต่างก็เชื่อมั่นว่าการตัดสินใจของตัวเองนั้นถูกต้องที่สุด แต่ทางเลือกของพวกเธอ ก็ทำให้พวกเธอต้องสูญเสียกันและกันไปตลอดกาล",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010222
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010222,
					"content": "ถ้าหากว่าการพิสูจน์ความถูกต้องของตัวเอง ต้องแลกมากับการสูญเสียเพื่อนไป... พวกเธอจะเลือกยังไงกันเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010223
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010223,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010224
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010224,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010225
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010225,
					"content": "เฮ้อ จริง ๆ แล้วพอมีเรื่องไม่คาดคิดแทรกมาระหว่างการผจญภัยแบบนี้บ้าง ก็ไม่เลวเหมือนกันนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010226
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010226,
					"content": "...อืม! พอลองคิดดูดี ๆ เวลาที่พี่ Metta จะมาผจญภัยกับฉันมีค่ามาก ถ้ามัวแต่เปลี่ยนไปเปลี่ยนมา สุดท้ายอาจจะไม่ได้เล่นอะไรเลยก็ได้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010227
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010227,
					"content": "ครั้งหน้า... ครั้งหน้าฉันจะวางแผนให้ดีกว่านี้!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010228
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010228,
					"content": "ฮิฮิ คืนดีกันได้ก็ดีแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010229
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010229,
					"content": "หลังจากนี้ถ้าเจอหินแปลก ๆ ที่หายากได้ระหว่างการผจญภัยกับ Vesa พวกเราจะส่งไปที่ \"Speranza\" นะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010230
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010230,
					"content": "ได้เลย! งั้นก็ขอบคุณล่วงหน้านะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linnea"
				}
			]
		},
