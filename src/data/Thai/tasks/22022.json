					]
				},
				{
					"id": 220220207,
					"content": "อ่า... อย่างนั้นเหรอ? ฉันจดก่อนนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220208,
					"content": "Jueyun Chili",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220210
					]
				},
				{
