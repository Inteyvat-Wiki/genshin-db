					"Khedive"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710500902,
					"content": "ยอดเยี่ยมมาก เป็นภาพถ่ายที่งดงามหาได้ยากมากเลยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500903
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500903,
					"content": "ค่าใช้จ่ายของทีมสำรวจนั้น แค่ได้ภาพถ่ายพวกนี้มาก็คุ้มทุนแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500904
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500904,
					"content": "เธอดูสิ พวกนี้เป็นกระดูกของสิ่งมีชีวิตโบราณใต้ทะเล แถมรูปร่างก็ชัดเจนมากเลยด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500905
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500905,
					"content": "พิสูจน์ได้ว่าก่อนที่จะก่อตัวขึ้นเป็น Chasm จริง ๆ แล้วเคยเป็นสภาพแวดล้อมทางทะเลมาก่อน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500906
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500906,
					"content": "แต่น่าเสียดายจริง ๆ ถ้าเจอฟอสซิลแบบนี้ที่ Sumeru คงสามารถยกกลับไปที่สถาบันแล้วทำการวิจัยได้เลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500907
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500907,
					"content": "ครั้งหน้าถ้าได้ติดต่อกับฝ่ายกิจการทั่วไปอีก ต้องคุยกับพวกเขาให้ดี ๆ แล้วล่ะ ให้พวกเราออกเงินจ้างคนมาเฝ้าไว้ก็ได้ แต่ต้องระวังไม่ให้คนงานเหมืองมาทำลายฟอสซิลพวกนี้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500908
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500908,
					"content": "แต่ว่า...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500909,
						710500910
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500909,
					"content": "แต่ว่า...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500911
					]
				},
				{
					"id": 710500911,
					"content": "ภาพถ่ายพวกนี้... นับว่าพอแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500912
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500912,
					"content": "ก่อนหน้านี้เคยบอกไว้แล้วว่า ฟอสซิลที่มีลักษณะที่ดีและโครงสร้างที่สมบูรณ์นั้นมีเงื่อนไขในการก่อตัว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500913
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500913,
					"content": "นั่นก็คือการถูกฝังกลบลงในดินอย่างรวดเร็ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500914
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500914,
					"content": "ฟอสซิลของ Chasm โดยทั่วไปจะปรากฏเฉพาะในระดับความสูงที่เฉพาะเจาะจงเท่านั้น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500918,
						710500919
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500918,
					"content": "ระดับความสูงที่เฉพาะเจาะจง?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500920
					]
				},
				{
					"id": 710500920,
					"content": "ในมุมมองเชิงธรณีวิทยาแล้ว ความแตกต่างในระดับนี้สามารถละเลยได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500915
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500915,
					"content": "อย่างไรก็ตาม นี่แสดงให้เห็นว่าฟอสซิลก่อตัวขึ้นในช่วงเวลาสั้น ๆ และเกิดในระยะเวลาช่วงใกล้เคียงกัน... บ่งชี้ว่าการเปลี่ยนแปลงทางนิเวศวิทยาครั้งใหญ่นั้นเกิดขึ้นในระยะเวลาอันสั้น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500916
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500916,
					"content": "อย่างเช่น การพุ่งชนครั้งใหญ่... อะไรแบบนั้นน่ะ",
					"roleType": "TALK_ROLE_NPC",
