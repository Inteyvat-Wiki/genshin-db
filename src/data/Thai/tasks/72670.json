				"points": []
			},
			"dialogs": [
				{
					"id": 726700101,
					"content": "แค่ก อะแฮ่ม....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700102
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700102,
					"content": "สวัสดี",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726700103
					]
				},
				{
					"id": 726700103,
					"content": "สวัสดี ๆ ในที่สุดคนที่เหมาะสมก็มาถึงสักที แค่กแค่ก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700104
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700104,
					"content": "แถมยังเป็นคนที่คุ้นเคยอีกด้วย ทีนี่ฉันก็ไม่ต้องกังวลว่าตัวอย่างจะไม่พอแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700105
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700105,
					"content": "รออยู่ตั้งนาน ไม่เจอคนแก่ก็เจอเด็ก ๆ ต่างก็ใช้งานไม่ได้ทั้งนั้น...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700106,
						726700109
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700106,
					"content": "คุณคือ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726700107
					]
				},
				{
					"id": 726700107,
					"content": "อ๋า ทำไมลืมฉันเร็วขนาดนี้ล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700108
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700108,
					"content": "ฉันไม่ใช่คนร้ายที่วางแผนทำอะไรไม่ดีสักหน่อย อย่าแสร้งทำเป็นไม่รู้จักฉันแบบนี้สิ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700111
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700111,
					"content": "คุณลองดูดี ๆ สิ ฉันไง พวกเราเคยเจอกันที่ Ritou ใน Inazuma ไงล่ะ แค่กแค่ก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700112
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700112,
					"content": "น่าสงสัยจริง ๆ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726700113
					]
				},
				{
					"id": 726700113,
					"content": "ดูเหมือนว่าเธอจะลืมฉันไปแล้วจริง ๆ เฮ้อ ถ้าอย่างนั้นฉันแนะนำตัวใหม่อีกครั้งแล้วกันนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700114
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700114,
					"content": "ฉันชื่อ Hosseini นักวิชาการในสถาบันของ Sumeru ฉันต้องเดินทางมายัง Inazuma อย่างยากลำบากเพื่อทำโครงการวิจัยใน Inazuma",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700115
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700115,
					"content": "แต่น่าเสียดาย... แค่ก... การทำการวิจัยใน Inazuma นั้นมีข้อจำกัดมากเกินไปน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700116
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700116,
					"content": "ถึงสุดท้ายแล้วก็ไม่ใช่ว่าจะไม่ได้อะไรกลับมาเลย แต่เมื่อเทียบกับเส้นทางที่ลุ่ม ๆ ดอน ๆ ที่ผ่านมาพวกนี้แล้ว ก็รู้สึกว่าได้ไม่คุ้มกับที่เสียอยู่นิดหน่อยน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700117
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700117,
					"content": "ทุนวิจัยก็เหลืออยู่ไม่เท่าไหร่แล้วล่ะ ฉันเลยต้องหาทางจาก Liyue กลับไปที่สถาบัน แต่ว่าฉันก็ยังหวังว่าจะใช้เวลาเดินทางกลับเพื่อทำอะไรชดเชยสักหน่อย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700118
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700118,
					"content": "ฉันคิดว่า มันคงจะดีกว่าถ้าทำงานในงานวิจัย \"แผ่นควบคุมพลังงาน\" ที่ได้รับการยืนยันจากสถาบันต่อไปน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700119
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700119,
					"content": "ส่วนเรื่องแผ่นควบคุมพลังงาน ไม่รู้ว่าคุณจะยังจำมันได้อยู่รึเปล่า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700120
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700120,
					"content": "มันเป็นวัตถุโบราณล้ำค่าที่สามารถใช้กระแสพลังงานจากทุกหนทุกแห่ง เพื่อเพิ่มเสริมพลังให้กับผู้ที่ใช้มันน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700121
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700121,
					"content": "แค่กแค่ก หัวข้อวิจัยนี้ยังอยู่ในช่วงเริ่มต้น และรายงานการสำรวจที่ฉันส่งไปก่อนหน้านี้เทียบเท่ากับส่วนคำนำของงานวิจัยฉบับสมบูรณ์เท่านั้นแหละ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700122
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700122,
					"content": "ยังมีงานอีกมากที่ต้องทำ เพื่อทำความเข้าใจหลักการทำงานและความเป็นไปได้ในการใช้งานของ \"แผ่นควบคุมพลังงาน\" ทั้งหมด",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700123
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700123,
					"content": "ฉันจึงมาที่นี่เพื่อรับสมัครอาสาสมัคร และเชิญชวนพวกเขาให้ใช้ \"แผ่นควบคุมพลังงาน\" เพื่อจะได้รับข้อมูลใหม่เพิ่มเติมที่ใช้ในการสนับสนุนงานวิจัยของฉันน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700124
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700124,
					"content": "ฉัน... แค่ก... ไม่ใช่คนที่น่าสงสัยหรอกนะ อย่าได้เข้าใจฉันผิด",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700125
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700125,
					"content": "อย่างนี้นี่เอง",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726700126
					]
				},
				{
					"id": 726700126,
					"content": "ใช่แล้วล่ะ... แค่ก... ถ้าอย่างนั้นฉันน่าจะถามได้แล้วใช่มั้ยล่ะ นักเดินทาง คุณยินดีที่จะเป็นอาสาสมัคร ช่วยทดลองใช้ \"แผ่นควบคุมพลังงาน\" หน่อยได้มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700127
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700127,
					"content": "ลองดูก็ได้",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726700128
					]
				},
				{
					"id": 726700128,
					"content": "ฉันขอขอบคุณก่อนเลย ที่คุณเต็มใจที่จะมีส่วนร่วมในการแสวงหาปัญญามาโดยตลอด",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700129
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700129,
					"content": "แต่ก่อนที่ฉันจะมอบ \"แผ่นควบคุมพลังงาน\" ให้กับคุณ เพื่อความปลอดภัย เรามาทำกิจกรรมอุ่นเครื่องเล็ก ๆ น้อย ๆ กันก่อนแล้วกันนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700130
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700130,
					"content": "และนี่ก็เพื่อยืนยันว่าอาสาสมัครที่มีความสามารถในการปกป้องตัวเองหรือไม่... แค่ก... เพราะว่าผู้รับผิดชอบงานวิจัยจะไม่เอาชีวิตของอาสาสมัครไปเสี่ยงอันตรายน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700131
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700131,
					"content": "ถ้าคุณเตรียมตัวพร้อมแล้ว ก็ไปยังที่พื้นที่ที่กำหนดไว้ เพื่อลองกำจัดค่ายที่อยู่ที่นั่นดูแล้วกันนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700132
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700132,
					"content": "ฉันจะรอคุณอยู่ที่นี่ ระวังตัวด้วยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700109,
					"content": "...คุณวางแผนจะทำอะไรล่ะ!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726700110
					]
				},
				{
					"id": 726700110,
					"content": "ฉันดูเหมือนนักวิชาการบ้า ๆ ที่ลักพาตัวคนที่เดินผ่านไปมาทำการทดลองงั้นเหรอ? อย่าใช้น้ำเสียงราวกับฉันเป็นโจรขโมยแบบนั้นสิ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700111
					],
					"speakerTitle": "Hosseini"
				}
			]
		},
		{
			"id": 7267002,
			"completionStepIds": [
				7267003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7267003",
							"2"
						],
						"stepId": 7267003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hosseini"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726700201,
					"content": "กลับมากันแล้วเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700202
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700202,
					"content": "ไม่ได้รับบาดเจ็บเลยสักนิด",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726700203
					]
				},
				{
					"id": 726700203,
					"content": "ฮ่าฮ่า... แค่ก ฉันคงจะคิดมากเกินไปแล้วล่ะ พละกำลังของคุณนั้นแข็งแกร่งมาก ฉันวางใจที่จะมอบ \"แผ่นควบคุมพลังงาน\" ให้คุณดูแลแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700204
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700204,
					"content": "วิธีการใช้งานของ \"แผ่นควบคุมพลังงาน\" นั้นง่ายมาก แค่คุณเห็นก็น่าจะใช้เป็นแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700205
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700205,
					"content": "แต่ว่าระวังในตอนที่ใช้งาน เพราะของสิ่งนี้คือของโบราณที่แท้จริง ถ้าทำหายหรือว่าทำพังไป ฉันคงถึงคราวซวยครั้งใหญ่เลยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700206
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700206,
					"content": "คุณลองทำความคุ้นเคยกับ \"แผ่นควบคุมพลังงาน\" ดูก่อนได้นะ จากนั้นค่อยทดลองใช้งานน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700301
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700301,
					"content": "เป็นยังไงบ้าง เข้าใจวิธีใช้ \"แผ่นควบคุมพลังงาน\" รึยัง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700302,
						726700304
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700302,
					"content": "ก็ไม่ได้ซับซ้อนอะไรนี่นา",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726700303
					]
				},
				{
					"id": 726700303,
					"content": "ก็จริง ถ้าเทียบกับอุปกรณ์อันอื่น ๆ ของสถาบันแล้ว \"แผ่นควบคุมพลังงาน\" มันถือว่าค่อนข้างใช้ง่ายเลยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700306
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700306,
					"content": "ระดับคุณแล้ว ถ้าจะขยายขอบเขตการทดสอบ ก็น่าจะทำได้อย่างไม่มีปัญหา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700307
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700307,
					"content": "ฉันได้ยินนักผจญภัยที่เดินทางผ่านไปมาบอกว่า เขาเพิ่งค้นพบดันเจี้ยนที่ลึกลับและแปลกประหลาดอยู่ที่นึง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700308
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700308,
					"content": "เนื่องจากไม่มีใครค้นพบสถานที่แห่งนี้มาก่อน จึงมีมอนสเตอร์จำนวนมากรวมตัวกันอยู่ในนั้น และความสามารถของมันก็แข็งแกร่งกว่ามอนสเตอร์ที่เร่ร่อนอยู่ในป่าซะอีก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700309
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700309,
					"content": "หากคุณใช้ที่นั่นเป็นสถานที่ในการทดสอบ จะต้องสามารถรับข้อมูลที่ครอบคลุมมากขึ้นแน่ ๆ เลยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700310
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700310,
					"content": "ผลงานที่ผ่านมาของคุณ... อะแฮ่ม... พูดตามตรงมันโดดเด่นมากเลยล่ะ แต่บันทึกที่เหลือใน \"แผ่นควบคุมพลังงาน\" มีอยู่อย่างจำกัด",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700311
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700311,
					"content": "แต่ถ้าเป็นคุณละก็ การเข้าและออกจากดันเจี้ยนนี้คงไม่ใช่เรื่องยาก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700312
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700312,
					"content": "ยังต้องพูดอีกเหรอ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726700313
					]
				},
				{
					"id": 726700313,
					"content": "ถ้าคนอื่นมาพูดแบบนี้ ฉันคงไม่เชื่อ แต่ถ้าเป็นคุณล่ะก็ ฉันคิดว่าจะต้องไม่มีปัญหาอะไรแน่ ๆ เลยล่ะ ฮ่าฮ่า... แค่กแค่ก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700314
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700314,
					"content": "ฉันทำเครื่องหมายตำแหน่งของดันเจี้ยนไว้บนแผนที่ให้คุณแล้วล่ะ ภารกิจทดสอบต้องรบกวนคุณแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700304,
					"content": "ยังไม่ค่อยเข้าใจเท่าไหร่",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726700305
					]
				},
				{
					"id": 726700305,
					"content": "เป็นเรื่องปกติ วางใจเถอะ ในฐานะที่ไม่ใช่ผู้เชี่ยวชาญ เธอแค่รู้วิธีใช้งานพื้นฐานก็พอแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700306
					],
					"speakerTitle": "Hosseini"
				}
			]
		}
	]
}