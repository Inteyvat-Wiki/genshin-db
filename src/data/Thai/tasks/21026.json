					"Yue Chuan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210260101,
					"content": "ข้อความในขวดลอยน้ำนี้ ดูเหมือนจะเป็นลายมือเด็กเลย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260102
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260102,
					"content": "Meng? เด็กคนนี้คือใครกันนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260103
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260103,
					"content": "เอ๋? ขวดลอยน้ำนี้...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260104
					]
				},
				{
					"id": 210260104,
					"content": "นักเดินทาง? ฟังจากน้ำเสียงแล้ว เธอรู้จักคนเขียนจดหมายนี่เหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260105,
						210260106
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260105,
					"content": "นับว่ารู้จักมั้ง...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260107
					]
				},
				{
					"id": 210260107,
					"content": "อย่างนี้นี่เอง เด็กคนนี้คิดมากเหมือนกันนะเนี่ย อยากเป็นผู้ใหญ่งั้นสิ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260108
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260108,
					"content": "ฉันว่านะ ถ้าเขาได้ออกไปท่องเที่ยวข้างนอกสักครั้ง ได้เปิดหูเปิดตาสักหน่อย ไม่แน่ปัญหาพวกนี้อาจจะคลี่คลายก็ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260109
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260109,
					"content": "ที่จริง Meng ก็เคยพูดแบบนี้ เขาบอกว่าอยากออกไปสำรวจนอกท่าเรือ Liyue บ้าง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210260110,
					"content": "แต่เราก็เคยชวนเขาแล้ว ทำไมเขาถึงไม่ตกลงเลยนะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210260111,
					"content": "ฮ่าฮ่าฮ่า บางทีนี่อาจจะเป็น \"ความดื้อรั้น\" ของเด็กหนุ่มคนนั้นก็ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260112
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260112,
					"content": "ในเมื่อเป็นปัญหาของตัวเอง แน่นอนว่าเขาต้องอยากแก้ไขด้วยตัวเอง ไม่ใช่พึ่งพาให้คนอื่นช่วยเหลือ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260113
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260113,
					"content": "แต่แค่ Meng ทิ้งขวดลอยน้ำ มันก็แก้ปัญหาไม่ได้นี่นา...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210260114,
					"content": "เพราะฉะนั้น ในเวลานี้จึงต้องมีผู้ใหญ่ที่ไว้ใจได้คอยช่วยเหลือเขาไงล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260115
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260115,
					"content": "มาสิ นักเดินทาง เรามาเขียนจดหมายให้เด็กคนนี้กันเถอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260116
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260116,
					"content": "ใช้จดหมายฉบับนี้บอกเขาว่า มีสิ่งแปลกใหม่กำลังรอเขาอยู่ในโลกภายนอก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260117
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260117,
					"content": "แต่ว่า... แฮะ ๆ ฉันก็ไม่ค่อยได้ไปไหนสักเท่าไหร่ งั้นเธอตัดสินใจละกันนะนักเดินทาง ว่าจะเขียนสิ่งแปลกใหม่อะไรลงไปบ้าง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260118,
						210260119,
						210260120
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260118,
					"content": "เกี่ยวกับซากปรักหักพังของหอคอยสูงที่มีลมพายุห้อมล้อม...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260121
					]
				},
				{
					"id": 210260121,
					"content": "พูดช้า ๆ หน่อย ฉันยังจดไม่เสร็จเลย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260122
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260122,
					"content": "เอ๊ะ ตรงนี้...เขียนยังไงน้า...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260123
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260123,
					"content": "เอาล่ะ! เรียบร้อย เผลอแป๊บเดียวเขียนได้เยอะขนาดนี้เลยเหรอเนี่ย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260124
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260124,
					"content": "ฮ่าฮ่าฮ่า ฟังเธอพูดเรื่องพวกนี้แล้ว ทำให้ฉันอยากไปเที่ยวข้างนอกเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260125
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260125,
					"content": "ออกไปท่องเที่ยวก็ไม่เลวเลยนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260126
					]
				},
				{
					"id": 210260126,
					"content": "ฉันอายุปูนนี้แล้ว มีหลายสิ่งหลายอย่างที่ต้องทำ ไม่มีสิทธิ์จะเดินทางเที่ยวเล่นตามอำเภอใจแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260127
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260127,
					"content": "ฉันใส่จดหมายฉบับนี้ลงในขวดลอยน้ำแล้วล่ะ เธอรีบเอาไปปล่อยลงในแม่น้ำเถอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260119,
					"content": "เกี่ยวกับเกาะนอกทะเลที่รายล้อมไปด้วยพายุฝนฟ้าคะนอง...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260121
					]
				},
				{
					"id": 210260120,
					"content": "เกี่ยวกับหมู่เกาะที่เทพแห่งสายฟ้าผ่ามันแยกออกด้วยดาบ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260121
					]
				},
				{
					"id": 210260106,
					"content": "เป็นเด็กคนหนึ่งในท่าเรือ Liyue...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260107
					]
				}
			]
		},
