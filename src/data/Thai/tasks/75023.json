				{
					"id": 750230301,
					"content": "เป็นอะไรเหรอ อยากให้ฉันทวนขั้นตอนให้ฟังอีกรอบมั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230302,
						750230305
