					"nextDialogs": [
						741460207
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 741460207,
					"content": "ผู้เหลือรอดของสมาคม Narzissenkreuz - Caterpillar ไม่ได้ให้ข้อมูลทั้งหมด",
					"roleType": "TALK_ROLE_NPC",
