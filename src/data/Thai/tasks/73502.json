					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 735020101,
					"content": "\"กลางวันที่เปลี่ยนเวรกับกลางวัน จากบนสะพาน สามารถมองเห็นด้านหลังของประภาคารที่รีบเลิกงานได้\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020102
					],
					"speakerTitle": "ตรวจสอบ"
				},
				{
					"id": 735020102,
					"content": "นี่ นี่คืออะไรเหรอ... ปริศนางั้นเหรอ? หรือว่าสุภาษิตอะไรพวกนั้น...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735020103,
					"content": "กลางวันที่เปลี่ยนเวรกับกลางวัน? ด้านหลัง... เลิกงาน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735020104,
					"content": "นี่มันนักเดินทางนี่นา! พวกเธอก็สนใจปริศนาของคุณ Drusus เหมือนกันเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020105,
						735020106
					],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020105,
					"content": "นี่เป็นปริศนาจริง ๆ เหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735020107
					]
				},
				{
					"id": 735020107,
					"content": "คนที่เอาปริศนามาวางไว้ที่นี่เป็นนักวิชาการจากสถาบันน่ะ เขาชื่อว่าคุณ Drusus",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020108
					],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020108,
					"content": "เท่าที่ฉันรู้มา... คนคนนั้นถือว่าเป็นคนประหลาดในสถาบันเลยก็ว่าได้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020109
					],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020109,
					"content": "เขาชอบถกเถียงปริศนาแบบต่าง ๆ กับคนอื่นที่สุดเลย แล้วยังชอบศึกษาวิธีเข้ารหัสแบบต่าง ๆ ด้วยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020110
					],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020110,
					"content": "แต่ปริศนาของเขาเข้าใจยากสุด ๆ ก็เลยไม่ค่อยมีคนอยากคุยกับเขา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020111
					],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020111,
					"content": "เขาก็เลยคิดรูปแบบ \"ไขปริศนารับรางวัล\" แบบนี้ออกมาไงล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020112
					],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020112,
					"content": "พูดง่าย ๆ ก็คือ ปริศนานี่เป็นคำบอกใบ้ของ \"จุดซ่อนสมบัติ\" แห่งหนึ่งน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020113
					],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020113,
					"content": "ถ้าไปถึงตำแหน่งที่ถูกต้อง ในเวลาที่กำหนด ด้วยวิธีการที่ถูกต้อง ก็จะได้รับสมบัติไป",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020114
					],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020114,
					"content": "แถมคุณ Drusus ก็บอกแล้วว่า \"จุดซ่อนสมบัติ\" พวกนี้อยู่ในเมือง Sumeru ทั้งหมด",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020115
					],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020115,
					"content": "แต่ก็เป็นอย่างที่พวกเธอเห็น ยังไม่มีนักผจญภัยคนไหนไขปริศนาข้อนี้ได้เลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020116
					],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020116,
					"content": "ถ้าพวกเธอสนใจ จะลองดูก็ได้นะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020117
					],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020117,
					"content": "แต่ฉันแนะนำว่า พวกเธอไปทำอะไรที่เป็นเรื่องเป็นราวดีกว่านะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020106,
					"content": "คุณรู้เหรอว่าใครเป็นคนจัดวางไว้?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735020107
					]
				}
			]
		},
		{
			"id": 7350203,
			"completionStepIds": [
				7350203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
