					"id": 760520512,
					"content": "ตอนนั้นฉันถึงได้เข้าใจว่า กลิ่นหอมก็คือแรงดึงดูดที่ไม่มีใครหลีกหนีได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520513
					],
					"speakerTitle": "Damselette"
				},
