				"objectNames": [
					"Kaeya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401111301,
					"content": "โย่ มีอะไรที่อยากคุยกันอีกมั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111302,
						401111306,
						401111310
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401111302,
					"content": "เกี่ยวกับ \"เกมกลเจ็ดอัจฉริยะ\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401111303
					]
				},
				{
					"id": 401111303,
					"content": "ช่วงนี้เกมการ์ดนี้กำลังเป็นที่นิยมสุด ๆ เลยล่ะ แทบจะกลายเป็นส่วนหนึ่งในชีวิตประจำวันของทุกคนแล้ว ไปที่ไหนก็เห็นแต่คนเล่นเต็มไปหมด",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111304
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401111304,
					"content": "แถมมีคนยอมหักดิบเลิกกินเหล้า เพราะอยากรักษาสติแจ่มชัดตอนเล่นการ์ดด้วยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111305
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401111305,
					"content": "จิ๊ ๆ ถ้า Diona รู้เรื่องเข้าคงจะดีใจแย่เลยมั้ง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111306,
						401111310
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401111306,
					"content": "ทุกคนในกองอัศวิน...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401111307
					]
				},
				{
					"id": 401111307,
					"content": "วางใจเถอะ ๆ ทุกคนสบายดี",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111308
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401111308,
					"content": "ฉันเคยลองลากหัวหน้ากอง Jean ให้มาเล่นด้วยนะ ปรากฏว่าเล่นไปได้แค่ครึ่งตา หัวหน้าเขาก็โดนคนเรียกตัวไปแล้ว ฉันได้แต่เล่นเกมที่เหลือจนจบด้วยตัวคนเดียว เฮ้อ ช่วยไม่ได้ละน้า คงพูดได้แค่ว่าแต่ละคนมีหน้าที่ของตัวเองนั่นแหละ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111309
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401111309,
					"content": "แต่พอเห็นว่างานครั้งนี้ประสบความสำเร็จ ทุกคนต่างสนุกไปกับมันขนาดนี้ หัวหน้ากองเขาก็คงจะโล่งใจน่าดู",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111302,
						401111310
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401111310,
					"content": "ไว้คุยกันวันหลังนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401111311
					]
				},
				{
					"id": 401111311,
					"content": "เอาสิ ถ้ามีโอกาสก็อยากจะเล่น \"เกมกลเจ็ดอัจฉริยะ\" กับเธออีกสักตานะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				}
			]
		},
		{
			"id": 4011114,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
