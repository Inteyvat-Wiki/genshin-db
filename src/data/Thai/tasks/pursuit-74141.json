							4707.657
						],
						"pointId": 6832
					}
				]
			},
			"dialogs": [
				{
					"id": 741410101,
					"content": "(เนื้อหาบนหน้าหนังสือยังคงประกอบด้วยภาพรูปร่าง ตัวอักษร ภาษาโบราณ และรูปทรงเรขาคณิตที่เข้าใจยาก แต่หลังจากที่ตั้งสมาธิแล้ว ดูเหมือนว่าคุณจะค่อย ๆ เข้าใจเนื้อหาในนั้น)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410102
					],
					"speakerTitle": "อ่าน"
				},
				{
					"id": 741410102,
					"content": "ดูเหมือน Canotila จะไม่อยู่นะ คงไปอยู่ที่สถานที่ลึกลับอีกล่ะมั้ง! เธอจะไปทำ \"สมาธิ\" เหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741410103,
					"content": "พอฟังคำพูดที่เธอบอกเมื่อคราวก่อน...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410104
					]
				},
				{
					"id": 741410104,
					"content": "ฉันชักสงสัยล่ะ ฉันจะไปดูสักหน่อย",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410105
					]
				},
				{
					"id": 741410105,
					"content": "เอ่อ... ถึงจะไม่ค่อยสบายใจ แต่พวกเราไปดูด้วยกันดีกว่า! Canotila นี่ทำให้คนเป็นห่วงจริง ๆ เลยนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741410106,
					"content": "Paimon เธอรออยู่ข้างนอกก็ได้",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410107
					]
				},
				{
					"id": 741410107,
					"content": "เอ๊ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741410108,
					"content": "โลกใน \"หนังสือวิวรณ์\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410109,
						741410110
					]
				},
				{
					"id": 741410109,
					"content": "อาจจะอันตรายกว่าที่คิด",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410111
					]
				},
				{
					"id": 741410111,
					"content": "เพราะงั้นฉันเลยไม่อยากให้เธอเสี่ยงอันตราย",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410112
					]
				},
				{
					"id": 741410112,
					"content": "แต่... แต่พวกเราก็ผจญภัยมาด้วยกันตลอดไม่ใช่เหรอ? ถ้าเราอยู่ด้วยกัน ก็ไม่มีอุปสรรคอะไรที่เราฝ่าฟันไปไม่ได้ และไม่มีศัตรูหน้าไหนที่เอาชนะไม่ได้นี่นา...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741410113,
					"content": "อันตรายที่อยู่ข้างใน อาจจะไม่สามารถแก้ไขด้วยการต่อสู้นะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410114
					]
				},
				{
					"id": 741410114,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741410115,
					"content": "ก็ได้! หึ เธอฉลาดกว่าฉันเยอะ ฉันเชื่อเธอก็ได้ งั้นเธอห้ามทิ้งฉันนะ! ฉันจะรอเธอกลับมาเสมอ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741410110,
					"content": "อาจจะมีด้านที่พวกเราไม่รู้ก็ได้",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410111
					]
				}
			]
		},
