						741410803
					]
				},
				{
					"id": 741410803,
					"content": "ใครน่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410804
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741410804,
					"content": "...คุณเองเหรอ ฉันจำคุณได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410805
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741410805,
					"content": "ทำไมถึงมาอยู่ที่นี่ได้ล่ะ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410806
					]
				},
				{
					"id": 741410806,
					"content": "คุณชิงถามก่อนซะแล้ว ฉันก็กะจะถามคำถามนี้กับคุณเหมือนกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410807
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741410807,
					"content": "ไม่มีอะไร ฉันแค่คิดว่า...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410808
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741410808,
					"content": "#คุณคือ {NICKNAME} ใช่มั้ย? แล้วเจ้าตัวเล็กสีขาวที่คอยอยู่ข้างกายคุณล่ะ... เธอชื่ออะไรนะ ทำไมถึงไม่มาด้วยกันล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410809,
						741410811
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741410809,
					"content": "Paimon รอฉันอยู่ด้านนอก",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410810
					]
				},
				{
					"id": 741410810,
					"content": "ชื่อ Paimon เหรอ? ช่างเถอะ ไม่สำคัญอะไร คุณเป็นคนดี Paimon ก็เป็นคนดี",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410812
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741410812,
					"content": "ฉันมาที่นี่เพื่อตามหาของสำคัญบางอย่าง คุณรู้มั้ยว่าฉันกำลังตามหาอะไร?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410813
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741410813,
					"content": "ช่างเถอะ คิดซะว่าฉันไม่เคยถามละกัน ทำไมคุณถึงมาอยู่ที่นี่ล่ะ? รีบไปซะ ที่นี่อันตรายมากนะ ก่อนหน้านี้ก็มีคนมาเข้าร่วมการทดสอบที่นี่ แต่สุดท้ายก็หลงทาง และสมองของเขาก็เลอะเลือนไป...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410814
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741410814,
					"content": "ฉันนึกออกแล้ว คุณกับฉัน เราเคยผ่านเรื่องราวน่าทึ่งมาด้วยกัน นั่นเป็นอย่างเดียวในชีวิตที่ฉันภาคภูมิใจ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410815
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741410815,
					"content": "เธอหมายถึง...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410816,
						741410818
					]
				},
				{
					"id": 741410816,
					"content": "เอาชนะ Narzissenkreuz เหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410817
					]
				},
				{
					"id": 741410817,
					"content": "อาจารย์เป็นยังไงบ้างแล้ว? เขายังเป็นสมาชิกของสมาคม Narzissenkreuz รึเปล่า... หรือว่าคุณคือคนของ Guillotin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410820
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741410820,
					"content": "อ๋า ผีเสื้อสีทอง ส่องประกายสีราวกับแสงแดด",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410821
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741410821,
					"content": "ตราบใดที่ได้รับแสงแบบนั้น ทุกอย่างก็ล้วนแต่... ทุกอย่างก็ล้วน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741410818,
					"content": "ช่วย Lanoire เหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410819
					]
				},
				{
					"id": 741410819,
					"content": "ฉันนึกออกแล้ว ใช่แล้วล่ะ พวกเราพา Lanoire หนีออกจากคุกใต้ทะเล เด็กไม่ควรอาศัยอยู่ในที่แบบนั้น เธอควรจะใช้ชีวิตอยู่ใต้แสงแดด และท่ามกลางมวลดอกไม้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410820
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741410811,
					"content": "เธอโอเคมั้ย?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410812
					]
				}
			]
