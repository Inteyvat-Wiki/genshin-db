			"dialogs": [
				{
					"id": 10210301,
					"content": "(ตามที่ Keqing สอนมา ต้องพูดแบบนี้สินะ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210302,
					"content": "สวัสดี ที่นี่มีดวงจันทร์ขายใช่มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210303,
					"content": "ใช่แล้ว จะเอากี่ดวงล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210304
					],
					"speakerTitle": "Bu'yun"
				},
				{
					"id": 10210304,
					"content": "ไม่สะดวกจะบอกจำนวนน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210305,
					"content": "ตอบได้ดี ท่านทั้งสองเชิญไป Chamber จากทางนี้ได้เลย จริงสิ ท่านทั้งสองคือแขกที่ท่านหญิง Ningguang นัดเจอวันนี้ใช่มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210306
					],
					"speakerTitle": "Bu'yun"
				},
				{
					"id": 10210306,
					"content": "ถูกต้อง!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210307,
					"content": "(นี่ไม่ใช่รหัสลับของ \"แขก\" แต่เป็นรหัสลับของ \"Yuheng\" นี่มันอะไรกันเนี่ย...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bu'yun"
				}
			]
		}
	]
