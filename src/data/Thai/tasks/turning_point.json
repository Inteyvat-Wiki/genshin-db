				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10240201,
					"content": "แฮ่ก ๆ... เหนื่อยสุด ๆ ไปเลย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240202,
					"content": "ถ้าไม่เห็น Jade Chamber ลอยอยู่บนฟ้าเมื่อตอนออกจาก Golden House ตอนนี้ก็คงไม่รู้ว่าควรไปทางไหนล่ะนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240203,
					"content": "พวกเรามาทันไหม? เทพแห่งกระแสน้ำวนยังอยู่ใต้น้ำ ยังไม่ขึ้นมาถึงเมือง Liyue ใช่ไหม?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240204,
					"content": "พวกเธอ...มาได้ยังไง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240205
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 10240205,
					"content": "หืม?...หา! พวกเซียนนี่! ทำไมพวกคุณถึงอยู่บน Jade Chamber? ตอนแรกได้ยินมาว่าพวกคุณกำลังทะเลาะอยู่กับ Qixing นี่นา... ทะเลาะกันเสร็จแล้วเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240206,
					"content": "ในช่วงวิกฤตเหล่าเซียนและ Qixing จะปล่อยวางความบาดหมาง และร่วมสู้กับศัตรูเดียวกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240207
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10240207,
					"content": "หึ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240208
					],
					"speakerTitle": "จ้าวดับจันทร์ตะวันฉาย"
				},
				{
					"id": 10240208,
					"content": "อย่างนี้นี่เอง งั้น ตอนนี้ทุกคนมีแผนการการป้องกันอะไรบ้างไหม?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240209,
					"content": "หืม...เทพแห่งกระแสน้ำวนนั่น แค่มองไกล ๆ ก็ยังรู้สึกท้องไส้ปั่นป่วน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240210,
					"content": "ในกองทหาร Millelith มีทหารใหม่หลายนาย ตัวสั่นไม่หยุดจนยืนแทบไม่ไหว แรงกดดันของเทพอสูรจากอดีตกาล มีผลต่อร่างกายมนุษย์เป็นอย่างมากเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240211
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10240211,
					"content": "ก็เพราะด้วยเหตุนี้ ยิ่งให้อสูรนั่นเข้าใกล้ประชาชนเมือง Liyue ไม่ได้เป็นอันขาด!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240212
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10240212,
					"content": "น่ากลัวจังเลย...สงครามเทพอสูรเมื่อสองพันปีก่อน ต้องต่อสู้กับศัตรูแบบนี้งั้นเหรอ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240213,
					"content": "......",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240214
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 10240214,
					"content": "เพราะงั้น พลังแห่ง Qixing, กองทหาร Millelith และเหล่าเซียนรวมกัน จะสามารถหยุดยั้งเทพอสูรจากทะเลตนนั้นได้เหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240215,
					"content": "ทุกคนได้ร่วมกันหารือเรื่องนี้แล้ว และได้ข้อสรุปว่า... อาจทำไม่ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240216
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10240216,
					"content": "อะไรนะ!? แต่... แต่ว่าพวกเธอคือเหล่าเซียน และ Qixing ผู้ปกป้องเมือง Liyue เชียวนะ! คิดหาวิธีหน่อยไม่ได้เหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240217,
					"content": "มันก็ยังพอมีวิธีอยู่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240218
					],
					"speakerTitle": "จ้าววังวนเมฆา"
				},
				{
					"id": 10240218,
					"content": "เอ๋?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240219,
					"content": "เรื่องของ Guizhong Ballista ในคราวก่อน ได้ทำให้ Qixing เกิดความสนใจ และได้ไปศึกษาดู",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240220
					],
					"speakerTitle": "จ้าววังวนเมฆา"
				},
				{
					"id": 10240220,
					"content": "เซียนผู้ที่สร้าง Guizhong Ballista นั้น บังเอิญอยู่ที่นี่ด้วย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240221
					],
					"speakerTitle": "จ้าววังวนเมฆา"
				},
				{
					"id": 10240221,
					"content": "มนุษย์ปุถุชนศึกษาเกี่ยวกับเครื่องกลของเทพ จะไปรู้เรื่องได้ยังไง? แค่ทำการปรับแต่งเพียงเล็กน้อย ปืนหน้าไม้อันนี้ก็จะกลายเป็นอาวุธที่ร้ายแรงเหนือจินตนาการ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240222
					],
					"speakerTitle": "จ้าววังวนเมฆา"
				},
				{
					"id": 10240222,
					"content": "หึหึ... นี่ก็ถือว่าเป็น \"พรแห่งเซียน\" อย่างหนึ่งสินะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240223
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10240223,
					"content": "งั้นก็เอาตามนี้ เราจะปรับแต่ง Guizhong Ballista เพื่อต่อสู้กับเทพอสูร และขอให้เหล่าเซียนที่อยู่ที่นี่ ช่วยใช้พลังแห่งเซียนเพื่อเสริมความแข็งแกร่งให้มันด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240224
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10240224,
					"content": "เราไม่มีเวลาแล้ว ศึกแห่งการตัดสินได้มาถึงแล้ว... เริ่มได้!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ningguang"
				}
			]
		},
