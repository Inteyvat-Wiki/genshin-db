			"dialogs": [
				{
					"id": 220160401,
					"content": "แฮ่ก ๆ... ถูกเจ้าพวกมอนสเตอร์เล่นซะน่วมเลย ขอโทษด้วยที่ทำให้ต้องมาเจอฉันในสภาพแบบนี้",
					"roleType": "TALK_ROLE_NPC",
