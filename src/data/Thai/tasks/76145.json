			"dialogs": [
				{
					"id": 761450701,
					"content": "โอ้ ช่างเป็นพรหมลิขิตจริง ๆ เราถึงมาเจอกันที่นี่อีก อยากดูสินค้าของฉันมั้ย? คราวนี้มีของดี ๆ เพียบเลยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450709,
