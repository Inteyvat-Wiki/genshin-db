				},
				{
					"id": 220490302,
					"content": "สวยมากเลยล่ะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490303
					]
				},
				{
					"id": 220490303,
					"content": "พวกเธอชอบก็ดีแล้วล่ะ ฮ่าฮ่าฮ่า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490306
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490306,
					"content": "โอเค ฉันต้องไปดูแลร้านแล้วล่ะ ช่วงนี้ลูกค้ามาซื้อดอกไม้ไฟที่ร้านเยอะขึ้นเรื่อย ๆ เลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490307
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490307,
					"content": "เจ้าลูกคนนั้นทำไมยังไม่กลับมาอีกนะ ไปทำดอกไม้ไฟที่ไหนกันแน่...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490304,
					"content": "ยังเล่นไม่หนำใจเลย...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490305
					]
				},
				{
					"id": 220490305,
					"content": "พวกเธอชอบมากเลยเหรอ? งั้นก็ดีแล้วล่ะ คราวหน้าก็มาเอาไปเล่นอีกนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490306
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				}
			]
