	"talks": [
		{
			"id": 7067901,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7067901",
							"2"
						],
						"stepId": 7067901,
						"stateName": "QUEST_STATE_UNFINISHED"
