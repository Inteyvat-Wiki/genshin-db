			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7329608",
							"2"
						],
						"stepId": 7329608,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Julien"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732960801,
					"content": "เป็นไงล้า วิวสวยสุด ๆ ไปเลยใช่ม้า? เมื่อกี้ \"Pepper\" เองก็ดูตื่นเต้นมากเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960802,
					"content": "เจอวิวทิวทัศน์แบบนี้เข้าไป คำพูดก็ไม่จำเป็นอีกต่อไป Caterpillar พูดถูก ยังมีโลกที่กว้างใหญ่รออยู่นอกตะแกรงเหล็ก...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960803
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960803,
					"content": "ตะแกรงเหล็กเหรอ... ก่อนหน้านี้ Julien เคยบอกนี่นะ ว่าบ้านใน Fontaine เล็กมาก...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960804,
					"content": "อะแฮ่ม ใน Sumeru มีวิวธรรมชาติอยู่เยอะเลย",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960805
					]
				},
				{
					"id": 732960805,
					"content": "... อ๊ะ ใช่ใช่! เขาตัดสินใจว่าจะเป็นจิตรกรที่น่ายกย่องให้ได้แล้วนี่นา ได้เปลี่ยนสภาพแวดล้อมบ้างก็ดีเหมือนกัน ประโยคนั้นมันพูดว่ายังไงนะ... อ้อ เปิดโลกทัศน์ให้กว้างขึ้นไง!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960806,
					"content": "ถึง Julien จะบอกเองว่าอยากยอมแพ้... แต่ฉันว่าอย่าเพิ่งรีบตัดสินใจขนาดนั้นเลย! ค่อย ๆ คิดพิจารณาต่อไปก็ได้นี่นา...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960807,
					"content": "ลองคิดดูสิ คุณยังไม่เคยเห็นวิวที่เหมือนตรงหน้า หรืออาจจะสวยกว่านี้อีกเยอะแยะเลยนะ ไม่แน่... ไม่แน่ว่าคุณอาจเกิดแรงบันดาลใจหลังจากได้เห็นพวกมันก็ได้!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960808,
					"content": "ส่วนเรื่องแยกแยะสี... Julien เองก็พูดเองนี่นาว่า \"แค่เห็นวิวที่ต่างออกไปก็เท่านั้นเอง\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960809,
					"content": "\"แต่ความงามก็สื่อถึงกันได้นี่นา\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960810
					]
				},
				{
					"id": 732960810,
					"content": "ใช่มั้ยล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960811,
					"content": "ก็จริง... คำพูดพวกคุณเข้าท่ามากเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960812
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960812,
					"content": "เป็นคำพูดของคุณเองนั่นแหละ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960813,
					"content": "ฉัน... ฮ่าฮ่า ฉันก็เข้าใจความจริงข้อนี้ดีนั่นแหละ เพียงแต่... เพียงแต่ฉันมักจะเลือกเดินทางผิดอยู่เรื่อยเลย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960814
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960814,
					"content": "เพราะ \"Pepper\" พาคุณเดินมาทางนี้ พวกเราถึงได้รู้จักกันนะ เพราะงั้นมันก็ไม่ใช่ \"ทางผิด\" ซะทีเดียวหรอกมั้ง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960815
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960815,
					"content": "ถึงจะรู้สึกเสียดายที่ช่วยคุณตามหาเส้นทางแสวงบุญของ Oceanid ไม่เจอก็เถอะ... ฮื่อ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960816,
					"content": "มันมีอยู่จริงแน่เหรอ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960817
					]
				},
				{
					"id": 732960817,
					"content": "ตอนนี้ฉันก็ยังเชื่อนะว่า เส้นทางแสวงบุญมีอยู่จริง แต่... สำหรับฉันแล้ว จะเจอหรือไม่เจอจุดสิ้นสุดของมันนั้น ก็ไม่สำคัญอีกต่อไปแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960818
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960818,
					"content": "เพราะฉันได้พบคำตอบที่ฉันต้องการแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960819
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960819,
					"content": "ขอบคุณเพื่อนทั้งสองคนมากเลยนะ เฮ้อ ฉันควรขอบคุณพวกคุณยังไงดีเนี่ย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960820
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960820,
					"content": "ถ้าซื้อไข่นกวิเศษฟองนั้นซะตั้งแต่แรกก็คงดี... อุปกรณ์วิเศษที่สามารถลบล้างความโชคร้ายในแต่ละวันออกไปได้แบบนั้น คงเหมาะที่จะมอบให้นักผจญภัยอย่างพวกคุณมากเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960821,
						732960823
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960821,
					"content": "ใช่ น่าเสียดายจัง",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960822
					]
				},
				{
					"id": 732960822,
					"content": "#{NICKNAME} เชื่อเรื่องอุปกรณ์วิเศษที่ฟังดูสะดวกแบบนั้นด้วยเหรอเนี่ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960825
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960825,
					"content": "ฉันกะจะอยู่ที่นี่ต่ออีกสักหน่อย ที่นี่ทำให้รู้สึกสงบมากเลย เหมาะกับการใช้ความคิดมาก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960826
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960826,
					"content": "เหมือนมีลางว่าจะวาดอะไรบางอย่างที่แตกต่างออกมาได้เลย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960827
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960827,
					"content": "ขอบคุณทั้งสองคนที่คอยช่วยเหลือนะ และก็ขอให้การเดินทางของเพื่อน ๆ เป็นไปได้ด้วยดีนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960823,
					"content": "ขอบคุณมากนะ แต่อย่าเลยดีกว่า",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960824
					]
				},
				{
					"id": 732960824,
					"content": "ทำไมล่ะ! ต่อให้ลบล้างความโชคร้ายออกไปไม่ได้... แต่ไม่แน่ว่า... ไม่แน่ว่ามันอาจเป็นไข่นกที่อร่อยกว่าไข่นกทั่วไปเป็นร้อยเท่าก็ได้นะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960825
					],
					"speakerTitle": "Paimon"
				}
			]
		},
