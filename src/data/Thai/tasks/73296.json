					"Julien"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732960301,
					"content": "ได้ยินมาว่า ก่อนที่จิตรกรแต่ละคนจะเริ่มลงมือวาด พวกเขาจะคอยสังเกตจากหลาย ๆ มุมที่ต่างกันก่อนสินะ... คราวนี้ฉันไม่ได้กำลังเหมารวมอยู่ใช่มั้ยนะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960302,
					"content": "พวกเราเดินเล่นที่แถวนี้ด้วยกันมั้ย? เดี๋ยวไปบนที่สูงที่มีวิวดีกว่านี้ได้ด้วยนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960303,
					"content": "เป็นความคิดที่ไม่เลวเลย ฉันพร้อมจะออกเดินทางแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960304
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960304,
					"content": "#จริงสิ เรามาแข่งกันดีกว่าว่า ใครจะถึงจุดหมายกันก่อน {NICKNAME} พร้อมหรือยัง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7329604,
			"completionStepIds": [
				7329604
			],
