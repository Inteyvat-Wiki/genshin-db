			"dialogs": [
				{
					"id": 705170101,
					"content": "แถวนี้ก็ดูไม่มีอะไรนี่นา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170102,
					"content": "ดูเหมือนจะหาของกินอะไรไม่ได้เลยนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170103,
						705170104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170103,
					"content": "หลุดปากออกมาแล้วสินะ Paimon",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705170105
					]
				},
				{
					"id": 705170105,
					"content": "อะแฮ่ม ระหว่างที่ออกมาสืบความลับก็ต้องกินข้าวนี่นา นี่มันเป็นปกติของมนุษย์ต่างหากล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170106,
					"content": "แล้วอีกอย่างนึง ช่วงนี้พวกเรากินแต่ของปิ้งย่างเพื่อจะได้ประหยัดเวลา เธอเองก็น่าจะเบื่อแล้วเหมือนกัน ใช่มั้ยล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170107,
					"content": "ถ้าพวกเราเก็บเปลือกหอยหรือหอยสังข์บนชายหาดได้ ก็เอาพวกมันไปเคี่ยวกับผลไม้กินกันเถอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170108,
					"content": "ทั้งสด ทั้งหวาน แถมยังเคี้ยวหนึบอีกต่างหาก...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170109,
						705170111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170109,
					"content": "ฟังดูไม่น่ากินเลยสักนิด ฉันไม่เอาด้วยหรอก",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705170110
					]
				},
				{
					"id": 705170110,
					"content": "ลองดูหน่อยน้าา ไม่แน่อาจจะเป็นการเปิดโลกให้เธอก็ได้!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170113,
					"content": "#เดี๋ยวก่อนนะ {NICKNAME} เธอดูทางนั้นสิ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170114,
					"content": "กลไกที่จู่ ๆ ก็โผล่ขึ้นมา... มันดูแปลก ๆ อยู่นะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170115,
					"content": "ใกล้ ๆ ก็มีสัมภาระบางอย่างอยู่ด้วย เป็นของพวก Fatui รึเปล่านะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170116,
					"content": "เหมือนที่ Paimon บอกไว้จริง ๆ ด้วยแฮะ เจ๋งไปเลย",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705170117
					]
				},
				{
					"id": 705170117,
					"content": "ลางสังหรณ์ของฉันนี่พึ่งพาได้จริง ๆ ด้วย เจ๋งไปเลย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170118,
					"content": "มันเจ๋งตรงไหนกันล่ะเนี่ย ถุ้ย ๆ ๆ! พวกเรางานเข้าแล้วต่างหากล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170119,
					"content": "ในเมื่อสิ่งของที่มีความเกี่ยวข้องกับพวก Fatui โผล่ขึ้นมาที่นี่ งั้นก็ต้องมีแผนร้ายอะไรแน่ ๆ เลยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170120,
					"content": "ถ้าปล่อยทิ้งเอาไว้แบบนี้ ไม่แน่แผนการอาจจะพัฒนาต่อไปเรื่อย ๆ จนกลายเป็นเรื่องที่ยากจะรับมือก็ได้นะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170121,
					"content": "ยังไง พวกเราก็ลองจัดการกลไกนั่นดูกันก่อนมั้ย? และถ้าเธอคิดว่ามีความจำเป็น เราค่อยไปตรวจสอบข้าวของพวก Fatui กันต่อ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170122,
					"content": "#{NICKNAME} มาแสดงฝีมือกันอย่างที่ชอบทำกันเถอะ หลังจากจัดการพวกมันเสร็จแล้ว พวกเราจะได้ไปหาวัตถุดิบอย่างสบายใจกันซักที!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170111,
					"content": "ฟังดูเหมือนรสชาติของ Paimon เลยล่ะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705170112
					]
				},
				{
					"id": 705170112,
					"content": "นี่! Paimon ไม่ใช่อาหารทะเลนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170104,
					"content": "ก็ว่าทำไมเธอถึงกระตือรือร้นขนาดนี้",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705170105
					]
				}
			]
		}
	]
}