				"objectNames": [
					"Chenxiang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220080101,
					"content": "Doudou เด็กดี กินยาแล้วอาการป่วยถึงจะหายดีนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080102
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080102,
					"content": "ไม่กิน ไม่กิน! ยามันขม หนูไม่อยากกิน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080103
					],
					"speakerTitle": "Hongdou"
				},
				{
					"id": 220080103,
					"content": "ทำไมเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220080104
					]
				},
				{
					"id": 220080104,
					"content": "นักเดินทางงั้นเหรอ... คืออย่างนี้นะ Doudou น่ะสุขภาพไม่ค่อยแข็งแรง ก่อนหน้านี้เลยขอให้คุณ Bai ให้ช่วยจ่ายยาให้ชุดนึง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080105
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080105,
					"content": "แต่ว่า Doudou เอาแต่บอกว่ายามันขมเกินไป ยังไงก็ไม่ยอมกิน เห้อ มียาที่ไหนไม่ขมกันล่ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080106
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080106,
					"content": "เพื่อที่จะทำให้เด็กคนนี้ยอมกินยา ฉันเลยรับปากกับเธอว่าทุกครั้งหลังจากกินยาจะให้กิน Almond Tofu หนึ่งถ้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080107
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080107,
					"content": "นักเดินทาง ถ้าเกิดมีเวลาล่ะก็ ช่วยหา Almond Tofu มาให้ฉันทีได้มั้ย? ฉันต้องคอยกล่อมเธอน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080108,
						220080110,
						220080115
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080108,
					"content": "ฉันรู้แล้ว",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220080109
					]
				},
				{
					"id": 220080109,
					"content": "งั้นช่วยหน่อยนะ Almond Tofu หนึ่งถ้วยก็พอ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080110,
					"content": "เธอป่วยเป็นอะไรงั้นเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220080111
					]
				},
				{
					"id": 220080111,
					"content": "เห้อ ฉันก็ไม่รู้จะพูดยังไง แต่จากที่คุณ Bai บอกน่ะ มันแทบจะเป็นไปไม่ได้เลยที่จะรักษาอาการป่วยนี้ ทำได้แค่กินยาไปเรื่อย ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080112
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080112,
					"content": "ไม่แน่ Doudou อาจจะต้องกินยาไปตลอดชีวิต เธอยังเล็กอยู่แท้ ๆ... ฉันล่ะไม่อยากจะคิดเลย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080113
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080113,
					"content": "ฉันอยากจะป่วยแทนเธอจริง ๆ แต่ว่า... ที่ฉันทำได้ก็แค่หวังว่า Doudou จะไม่ต้องมาเจออะไรที่แย่ไปกว่านี้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080114
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080114,
					"content": "นักเดินทาง ช่วยหน่อยนะ ช่วยหา Almond Tofu มาให้ฉันที หนึ่งถ้วยก็พอ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080115,
					"content": "Doudou ทำไมหนูถึงไม่ยอมกินยา",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220080116
					]
				},
				{
					"id": 220080116,
					"content": "ยานั่นมันขมอ่ะ! ยาของพวก Lulu ไม่เห็นจะขมอย่างนี้เลย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080117
					],
					"speakerTitle": "Hongdou"
				},
				{
					"id": 220080117,
					"content": "Doudou จ๊ะ พวก Lulu น่ะแค่เล่นกันเฉย ๆ นะ นั่นน่ะเป็นแค่น้ำหวานของ Almond Tofu ไม่ใช่ยาหรอกนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080118
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080118,
					"content": "งั้น... งั้นหนูกิน Almond Tofu เพื่อรักษาไม่ได้เหรอ? ต้องกินยาขม ๆ นั่นด้วยเหรอ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080119
					],
					"speakerTitle": "Hongdou"
				},
				{
					"id": 220080119,
					"content": "Doudou เด็กดี ขอแค่หายป่วย อีกหน่อยจะกินอะไรก็ได้ทั้งนั้นแหละ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080120
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080120,
					"content": "ทำไมยาถึงหวานเหมือน Almond Tofu ไม่ได้ล่ะ ไม่ชอบเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080121
					],
					"speakerTitle": "Hongdou"
				},
				{
					"id": 220080121,
					"content": "เด็กคนนี้นี่นะ เห้อ... นักเดินทาง ช่วยหา Almond Tofu มาให้ฉันทีนะ แค่ถ้วยเดียวก็พอ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chenxiang"
				}
			]
		},
