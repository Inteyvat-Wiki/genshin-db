			"dialogs": [
				{
					"id": 730200201,
					"content": "อ่าาา \"เห็ดหนึ่งดอก\" ที่ฉันพร่ำคะนึงหาทั้งวันทั้งคืน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200202
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200202,
					"content": "\"เห็ดหนึ่งดอก\" ถ้าเธอสูญเสียกลิ่นหอมของตัวเธอไปแล้ว เธอยังจะเป็น \"เห็ดหนึ่งดอก\" อยู่มั้ยนะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200203
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200203,
					"content": "ฮี่ฮี่ เห็ดนี่กลิ่นหอมไม่เบาเลยจริง ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200204,
					"content": "ไม่ว่าจะยังไง พวกเราออกไปกันเถอะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7302003,
			"completionStepIds": [
				7302010
			],
			"beginWay": "TALK_BEGIN_MANUAL",
