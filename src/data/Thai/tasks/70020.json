					"nextDialogs": [
						700200201
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700200201,
					"content": "Yeye dada! Mosi mita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200202
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700200202,
					"content": "Odomu tomo zido mi! Mi mani yeye! <color=#00E1FFFF>Unta nunu</color>！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200203
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700200204,
					"content": "เอ่อ... ขอบใจนะ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700200206
					]
				},
				{
					"id": 700200205,
					"content": "Tomo, valo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700200206
					]
				},
				{
					"id": 700200203,
					"content": "<color=#00E1FFFF>Unta nunu</color>... ดูเหมือนจะเกี่ยวกับเวลานะ...อย่าลืมดูในคู่มือล่ะ?",
					"roleType": "TALK_ROLE_NPC",
