						700200103
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700200103,
					"content": "เดี๋ยวก่อน ให้ฉันจัดการเองเถอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200104
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700200104,
					"content": "Mimi tomo, Odomu nye! Muhe mani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200105
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700200105,
					"content": "Mani? Mani! Yoyo mani mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200106
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700200106,
					"content": "Dada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200107
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700200107,
					"content": "Dada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200108,
						700200109
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700200108,
					"content": "ดูเหมือนจะราบรื่นดีนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700200110
					]
				},
				{
					"id": 700200110,
					"content": "ฉันกำลังถามว่าเขาต้องการความช่วยเหลือมั้ย เพราะดูเหมือนเขาต้องการให้เราช่วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200111
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700200111,
					"content": "Dada odomu! Kundala dada! Kundala zido, mi dada! Muhe yeye!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200112
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700200112,
					"content": "เอ... เขาน่าจะหมายถึง อยากให้เราช่วยเขาเอาชนะ... ศัตรูที่แข็งแกร่ง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200113
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700200113,
					"content": "Ya zido? Ye? Mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200114
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700200114,
					"content": "Mi! Mi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200115
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700200115,
					"content": "โอเค ตำแหน่งของเขาอยู่บนแผนที่นี้แล้วล่ะ ที่เหลือต้องพึ่งเธอแล้วนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200116
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700200116,
					"content": "Dada, Valo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700200109,
					"content": "พวกเขาพูดว่าอะไรเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700200110
					]
				}
			]
		},
