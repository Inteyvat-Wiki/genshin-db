					"Kaeya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4620701,
					"content": "\"เธอนั้นไม่ได้รักเขาเลย ความกระตือรือร้นของ Spring นั้นเป็นเพียงภาพลวง เมื่อมันเยือกเย็นและเหงาหงอย หัวใจของเธอก็เผยให้เห็นความจริง\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620702
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620702,
					"content": "คิดอะไรออกรึยัง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620703,
					"content": "อย่าบอกนะว่านี่คือหน้ากระดาษจากนิยายรักที่พวกเธอบังเอิญเจอเข้าน่ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620704
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620704,
					"content": "ที่แท้ก็เข้าใจผิดซะแล้ว ไม่แปลกใจที่ฉันฉลาดขนาดนี้ยังเดาผิด!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620705,
					"content": "ฮ่าฮ่าฮ่า...แค่ล้อเล่นน่า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620706
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620706,
					"content": "อืม...จริงจังหน่อยสิ Kaeya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620707,
					"content": "ฮ่าฮ่า ปริศนาอันนี้ยากกว่าจริง ๆ Spring...หมายถึง Springvale งั้นเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620708
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620717,
					"content": "ตอนที่มีคนซักผ้าในบ่อน้ำแร่?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4620724,
					"content": "ตอนที่น้ำเปลี่ยนระดับ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4620708,
					"content": "\"ความกระตือรือร้นของ Spring\"...จะมีความกระตือรือร้นในสถานการณ์แบบไหนกันนะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620709
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620718,
					"content": "...สิ่งที่ไม่เหมาะสมแบบนี้ ฉันรู้สึกว่า Mondstadt ไม่ค่อยมีหรอกนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620719,
					"content": "อย่าบอกนะว่านี่คือสิ่งที่เธอสนใจ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620720,
					"content": "ห่ะห่ะ ขอโทษๆ ฉันไม่ควรตัดสินความสนใจของผู้อื่นนี่นะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620721,
					"content": "#เห่ย เธอเอาจินตนาการของ {NICKNAME} ไปเปลี่ยนเป็นอะไรไปแล้วน่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620723,
					"content": "อืม...อย่าบอกนะว่าพูดถึงตอนน้ำเปลี่ยนระดับน่ะ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4620722,
					"content": "เหอะๆ ประเด็นก็คือถ้าเป็นอย่างนั้น ความกระตือรือร้นจะไม่ได้เกี่ยวกับน้ำแร่ แต่เป็นคนที่อาบน้ำต่างหาก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620725,
					"content": "เป็นความคิดที่ไม่เลว! อย่างเช่น...น้ำตกอะไรอย่างนี้?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620726,
					"content": "ถ้าอย่างนั้น ฉันว่าที่มันจะบอกก็คือ น้ำตกที่อยู่ด้านหลังของ Springvale",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620727,
					"content": "น่าจะมีแต่ที่นั่นแหละ บ่อน้ำแร่ที่เดียวใน Mondstadt ที่ตรงกับคำบรรยายในนี้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620709,
					"content": "และ \"หัวใจแห่งน้ำตก\" จะต้องอ้างถึงหน้าผาทางด้านซ้ายของน้ำตก ฉันเคยเห็นมันครั้งหนึ่ง ตอนฉันออกไปลาดตระเวนพื้นที่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620710
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620710,
					"content": "สุดท้าย \"เมื่อมันเยือกเย็นและเหงาหงอย\" บางทีอาจจะเกี่ยวกับวิชั่นที่สามารถควบคุมน้ำแข็งได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620711
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620712,
					"content": "ขอบคุณมาก Kaeya",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620713
					]
				},
				{
					"id": 4620711,
					"content": "#{F#เธอ}{M#นาย}น่าจะ<color=#00E1FFFF>พาใครสักคนที่มีพลังของธาตุน้ำแข็งไปด้วย</color>นะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620712
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620713,
					"content": "ไม่เป็นไรๆ ในฐานะอัศวิน Favonius แล้ว หากปริศนาแค่นี้ยังไขไม่ได้ แล้วจะไปไขปริศนาแผนอาชญากรรมได้ยังไง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620714
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620714,
					"content": "งั้นเราไปดูที่ Springvale กัน ไม่กวนเวลาเธอวางแผนอาชญากรรมละนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620715
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620715,
					"content": "...อื๋อ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620716
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620716,
					"content": "โอ้ไม่ใช่ๆ...หมายถึงไม่รบกวนเวลาเธอในการไขปริศนาแผนอาชญากรรมแล้ว!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
