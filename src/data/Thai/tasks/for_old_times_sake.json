			"dialogs": [
				{
					"id": 221150301,
					"content": "ไปซะแล้ว... งั้นพวกเราก็กลับกันบ้างบ้างเถอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150302
					],
