			"dialogs": [
				{
					"id": 221150101,
					"content": "เห้อ Chang... ทำไมยังไม่กลับมาอีกนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150102
					],
					"speakerTitle": "คุณยาย Ruoxin"
				},
				{
					"id": 221150102,
					"content": "Chang ไหนเหรอ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150103
					]
				},
				{
					"id": 221150103,
					"content": "Chang น่ะเหรอ ก็ที่พวกเธอเรียกว่า \"Chang ที่เก้า\" นั่นไงล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150104
					],
					"speakerTitle": "คุณยาย Ruoxin"
				},
				{
					"id": 221150104,
					"content": "เห้อ ฉันเรียกเขาว่า Chang จนชินแล้วล่ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150105
					],
					"speakerTitle": "คุณยาย Ruoxin"
				},
				{
					"id": 221150105,
					"content": "เมื่อวานตอนเย็นเขาบอกว่าจะออกไปเพื่อรวบรวมข้อมูลเพิ่มเติมสำหรับนิยายของเขา ฉันก็ไม่ได้สนใจอะไร แค่บอกไปว่ากลับมาเร็ว ๆ เท่านั้น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150106
					],
					"speakerTitle": "คุณยาย Ruoxin"
				},
				{
					"id": 221150106,
					"content": "แต่จนถึงตอนนี้เขาก็ยังไม่กลับมาเลย ฉันกลัวจริง ๆ เลยว่าจะเกิดอะไรขึ้นกับเขา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150107
					],
					"speakerTitle": "คุณยาย Ruoxin"
				},
				{
					"id": 221150107,
					"content": "แต่ฉันน่ะแก่แล้ว ออกไปหาเขาไม่ไหวหรอก ยังไงพวกเธอช่วยไปหาเขาให้หน่อยได้มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150108,
						221150110
					],
					"speakerTitle": "คุณยาย Ruoxin"
				},
				{
					"id": 221150108,
					"content": "ให้พวกเราจัดการเอง",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150109
					]
				},
				{
					"id": 221150109,
					"content": "เยี่ยมไปเลย ช่วยหน่อยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "คุณยาย Ruoxin"
				},
				{
					"id": 221150110,
					"content": "คุณรู้มั้ยว่าเขาไปที่ไหน?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150111
					]
				},
				{
					"id": 221150111,
					"content": "เห้อ เขาจะไปไหนได้... ก็ที่ Wuwang Hill ที่อยู่ทางเหนือนั่นไงล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150112
					],
					"speakerTitle": "คุณยาย Ruoxin"
				},
				{
					"id": 221150112,
					"content": "เธอช่วยไปดูเขาให้ทีได้มั้ย นี่มันก็นานแล้ว หวังว่าเขาจะไม่เป็นอะไรนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "คุณยาย Ruoxin"
				}
			]
		},
