			"dialogs": [
				{
					"id": 722040201,
					"content": "โอเค... ให้ย่านอนพักสักเดี๋ยวนึงนะ... อื้ม... คร่อก... ฟี้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040202
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040202,
					"content": "พวกเธอระวังด้วยนะ... อย่าไปเล่นไกลล่ะ... คร่อก... ฟี้...",
					"roleType": "TALK_ROLE_NPC",
