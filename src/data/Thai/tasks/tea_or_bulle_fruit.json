						761870402,
						761870403
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 761870402,
					"content": "(ขอนั่งแบบนี้อีกสักพักละกัน)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870404
