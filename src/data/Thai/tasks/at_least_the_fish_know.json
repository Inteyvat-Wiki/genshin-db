				},
				{
					"id": 240140802,
					"content": "เกิดอะไรขึ้นงั้นเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140804
					]
				},
				{
					"id": 240140804,
					"content": "ซ่อมเสร็จแล้วล่ะ แต่หลังจากนั้นไม่นาน มันก็พังอีกแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
