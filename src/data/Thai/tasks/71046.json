				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tie Hong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710460201,
					"content": "หยุดนะ! Chasm เป็นพื้นที่ต้องห้าม คนภายนอกห้าม... เอ๊ะ เธอเองเหรอ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460202
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460202,
					"content": "แย่แล้ว รีบเผ่นเร็ว!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460203,
						710460204,
						710460205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710460203,
					"content": "Paimon อย่าเสียงดังสิ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710460206
					]
				},
				{
					"id": 710460206,
					"content": "ฮ่าฮ่าฮ่าฮ่า... ขอโทษที่ทำให้ตกใจ คนมีพระคุณแบบนี้ฉันจะลืมได้ยังไงล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460207
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460207,
					"content": "ช่วงนี้ฉันเพิ่งย้ายมาที่นี่... ไม่คิดว่าจะได้มาเจอผู้มีพระคุณที่นี่ด้วย ช่างเป็นโชคดีจริง ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460208
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460208,
					"content": "ผู้มีพระคุณ...? พวกเธอทำอะไรมางั้นเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710460209,
					"content": "ใช่ที่ไหนล่ะ! ตอนที่ทุกคนต่อกรกับอสูรยักษ์ในทะเล ฉันก็อยู่ที่ Jade Chamber เหมือนกัน ฉันได้รับบาดเจ็บนิดหน่อยแล้วก็เพิ่งกลับมานี่แหละ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460210
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460210,
					"content": "บางทีเธออาจจะจำฉันไม่ได้ด้วยซ้ำ แต่ฉันไม่ลืมเธอหรอกนะ สหายที่ร่วมต่อสู้ด้วยกันในวันนั้นได้เห็นสิ่งที่เธอทุ่มเททำเพื่อ Liyue",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460211
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460211,
					"content": "เกี่ยวกับ Chasm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710460212
					]
				},
				{
					"id": 710460212,
					"content": "เมื่อสองปีก่อนมีอุบัติเหตุที่ไม่ทราบสาเหตุเกิดขึ้นในเหมือง ทำให้ Qixing ออกคำสั่งปิดสถานที่ คนงานเหมืองส่วนใหญ่ได้อพยพออกไปได้อย่างปลอดภัย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460213
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460213,
					"content": "แต่น่าเสียดาย ที่เหมืองใหญ่แห่งนี้ต้องหยุดการทำงานลงแบบนี้ คนงานได้รับค่าชดเชยและแยกย้ายกันไปทำมาหากิน... เฮ้อ เมื่อทุกคนแยกจากกันแล้วก็ยากที่จะกลับมารวมตัวกันใหม่ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460214
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460214,
					"content": "อ๋า ขอโทษที่นอกเรื่องไปหน่อย ฉันเชื่อว่าเธอมาถึงที่นี่เพราะมีความจำเป็นบางอย่าง งั้นฉันจะไม่รบกวนเธอแล้วล่ะ ถ้ามีเรื่องอะไรก็มาหา Muning ได้เลย เขาอยู่ตรงแคมป์ทางเข้านั่นแหละ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460215
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460215,
					"content": "เฮ้อ...ไม่ใช่ว่าไม่ไว้ใจ แต่มันเป็นหน้าที่ที่ต้องเตือนเธอว่าอย่าทำอะไรที่ผิดกฎหมายที่นี่!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460216
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460216,
					"content": "ไม่ต้องห่วง คุณยังไม่เชื่อใจพวกเราอีกเหรอ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710460204,
					"content": "คุณรู้จักฉันเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710460206
					]
				},
				{
					"id": 710460205,
					"content": "เขาจำได้แล้ว รีบหนีเร็ว!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710460206
					]
				}
			]
		}
	]
}