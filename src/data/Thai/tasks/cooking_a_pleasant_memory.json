				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730190201,
					"content": "เอ๊ะ! Nara นี่เอง... สูงมาก น่ากลัวจัง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190202
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190202,
					"content": "ขอร้องล่ะ... อย่าเด็ดเลยนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190203
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190203,
					"content": "ได้เลย พวกเราไม่เด็ดหรอกน่า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190204,
					"content": "งั้นก็ดีแล้วล่ะ ฟู่ววว... Zaytun Peach พวกนี้คือสิ่งที่ฉันค่อย ๆ ปลูกขึ้นมาทีละหน่อย ๆ เริ่มตั้งแต่ตอนที่พวกมันยังเป็นเมล็ดอยู่เลยล่ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190205
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190205,
					"content": "มะ ไม่สิ พวกเธอคือ Nara นี่นา ร้ายมาก! มายุ่งกับ Zaytun Peach ที่คนอื่นเขาปลูกไว้ทำไมกัน!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190206
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190206,
					"content": "ทำไมพวก Nara ถะ...ถึงได้มีนิสัยน่ากลัวขนาดนี้นะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190207
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190207,
					"content": "พวกเราไม่ได้ทำอะไรเลยนะ ยังไม่ทันจะเด็ดซะหน่อย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190208,
					"content": "ขนาดยังไม่ได้ทำอะไร ยังน่ากลัวขนาดนี้ นี่ถ้าพวกเธอทำจริง ๆ ล่ะก็ แบบนั้นฉันจะไม่ตกใจตายเลยเหรอ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190209
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190209,
					"content": "เน้!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190210,
					"content": "ไม่ได้การล่ะ Arasaka... ลองคิดดูสิ เพื่อ Zaytun Peach ที่เธออุตส่าห์ปลูกขึ้นมาด้วยความลำบากแสนเข็ญ เพื่อ \"การฝึกทำอาหาร\"... จะมาถอยหลังกลับตอนนี้ไม่ได้ ห้ามกลัวเด็ดขาด...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190211
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190211,
					"content": "ที่แท้เธอก็คือ Arasaka จริง ๆ ด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190212,
					"content": "โอ้โห ธะ...เธอรู้จักชื่อฉันได้ยังไงกันล่ะเนี่ย... พวกเธอคือ Nara จากที่ไหนกัน... ทะ...ทำไมแค่เห็นหน้าครั้งแรกก็รู้จักชื่อของฉันเลยล่ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190213,
						730190216
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190213,
					"content": "ก็เธอเป็นคนบอกเอง...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190214
					]
				},
				{
					"id": 730190214,
					"content": "ปากพาซวยจริง ๆ หมดกัน ชื่อของฉันจะถูกเอาไปใช้เป็นคำสาปที่น่ากลัวแล้วสินะ... ขอร้องพวกเธอล่ะ ช่วยไว้ชีวิตฉันทีเถอะนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190215
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190215,
					"content": "ยกเว้นเรื่องเอา Zaytun Peach ให้พวกเธอแล้ว จะให้ทำอะไร ฉันยอมหมดเลยล่ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190219
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190219,
					"content": "ไม่ต้องกังวลขนาดนั้นหรอกน่า อันที่จริงเราได้รับคำขอจาก Arapacati ให้มาหาเธอน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190220,
					"content": "Ara... Arapacati? อ๋อ \"น้องสาว\" ที่รักของฉันนี่เอง แสงสุริยันในป่าทึบ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190221
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190221,
					"content": "เล่าเหตุการณ์ที่เกิดขึ้นให้ Arasaka ฟัง",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730190222
					]
				},
				{
					"id": 730190222,
					"content": "โอ้ว เทศกาลไร้อาวรณ์ อะไรกันแป๊บ ๆ ก็จะถึงเทศกาลไร้อาวรณ์อีกแล้วเหรอเนี่ย... เฮ้อ พวกเธอคือ Nara ที่มาร่วมงานเทศกาลไร้อาวรณ์ในครั้งนี้งั้นเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190223
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190223,
					"content": "โทษทีนะที่เมื่อกี้บอกว่าพวกเธอเป็น Nara นิสัยไม่ดีน่ะ พวกเธอจะต้องเป็น Nara นิสัยดีแน่ ๆ เพราะมีแต่ Nara นิสัยดีเท่านั้นถึงจะเข้าไปใน Vanarana เพื่อเข้าร่วมงานเทศกาลไร้อาวรณ์ได้น่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190224
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190224,
					"content": "เทศกาลไร้อาวรณ์ใกล้จะถึงแล้ว ถ้า \"การฝึกทำอาหาร\" ยังไม่สำเร็จ แล้วกลับไปที่ Vanarana... ทำแบบนั้นไม่ได้สิ... แต่จะไม่เข้าร่วมเทศกาลไร้อาวรณ์ก็ไม่ได้เหมือนกัน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190225
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190225,
					"content": "ทำไมเครียดกว่าเดิมอีกล่ะ... เธอก็ยังมี Zaytun Peach ที่ปลูกไว้ไม่ใช่รึไง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190226,
					"content": "...มี มีแค่ลูกท้อที่ฉันปลูกอย่างเดียวไม่พอหรอก!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190227
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190227,
					"content": "ต้องไปเอา \"รสชาติแห่งความดีใจ\" มาด้วย ถ้าไม่มี \"รสชาติแห่งความดีใจ\" ลูกท้อก็เป็นแค่ลูกท้อเท่านั้นแหละ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190228
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190228,
					"content": "ทั้ง Arachatora, Arapas และ Araphala ไม่มีใครเชื่อว่าโลกนี้มี \"รสชาติแห่งความดีใจ\" อยู่น่ะ ฉันเลยต้องพิสูจน์ให้พวกเขาเห็น แล้วก็จะเอาให้ Nara ชิมด้วยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190229,
						730190230
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190229,
					"content": "\"รสชาติแห่งความดีใจ\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190231
					]
				},
				{
					"id": 730190231,
					"content": "ฮิฮิ ก่อนหน้านี้ฉันเคยได้ชิม \"รสชาติแห่งความดีใจ\" มาแล้วครั้งนึงน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190232
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190232,
					"content": "\"รสชาติแห่งความดีใจ\" เป็นสีขาว ๆ แค่บีบ ๆ ก็แตกละเอียด... กลายเป็นแบบ Valuka สีขาว แต่ไม่เหมือน Valuka ที่ทั้งแข็งและเจ็บนะ แล้วก็ถูกบรรจุไว้ในฟองอากาศแข็ง ๆ น่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190233,
						730190234
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190233,
					"content": "...Valuka สีขาว?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190235
					]
				},
				{
					"id": 730190235,
					"content": "Valuka สีขาว ก็คือทรายสีขาว... หรือเปล่า? แล้วฟองอากาศแข็ง ๆ นี่มันอะไร...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190236,
					"content": "เอ่อ ไม่เข้าใจเลย \"รสชาติแห่งความดีใจ\" แบบนั้นอยู่ที่ไหนกันนะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190237,
					"content": "ธะ...เธอจะถามไปทำไมล่ะ หรือว่าเธอคิดจะแย่ง \"รสชาติแห่งความดีใจ\" ไปก่อนหน้าฉันงั้นเหรอ? น่ากลัวจังเลย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190238,
						730190239
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190238,
					"content": "พวกเราอยากช่วยเธอต่างหากล่ะ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190241
					]
				},
				{
					"id": 730190241,
					"content": "ช่วยฉัน? ช่วยฉันทำอะไรเหรอ? ฉะ...ฉันไปเอาเองก็ได้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190242
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190242,
					"content": "ก็แค่ที่นั่นมีแต่ Nara เดินไปเดินมาเต็มไปหมด แล้วก็มีหนึ่งคนในนั้น มีกลิ่นเหมือน Nara Valuka อึ๋ย... ฉันกลัว... ถ้าพวก Nara มีน้อย ๆ หน่อย ฉันก็ยังพอไหว...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190243
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190243,
					"content": "...เฮ้อ ก็ตามนั้นแหละ ฉันไปเอามาไม่ได้ ฉะ...ฉันไม่กล้าเข้าไปใน Gandharva Ville ที่นั่น Nara เยอะเกินไป แล้วก็มีแต่ต้นไม้ที่ตายแล้ว ฉันกลัวน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190244
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190244,
					"content": "ฉันมีเพื่อน Nara คนหนึ่งอยู่ในนั้น แต่ก็นานน๊านนานมาแล้วนะ ตอนนี้เขาเปลี่ยนไปแล้ว เขาไม่ได้ยินเสียงฉันแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190245
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190245,
					"content": "แบบนี้เองเหรอ งั้น \"รสชาติแห่งความดีใจ\" ที่เธอพูดถึง จริง ๆ แล้วก็อยู่ใน Gandharva Ville นั่นสินะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190246
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190246,
					"content": "\"รสชาติแห่งความดีใจ\" ไม่ได้งอกขึ้นมาจากดินนะ แต่ Nara เป็นคนสร้างมันขึ้นมาน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190247
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190247,
					"content": "ฉันอยากลองอีกสักครั้งจริง ๆ เลย ฉันยังจำรสชาติที่ลองครั้งแรกได้อยู่เลยนะ มีความสุขล้นใจเลย มันเยี่ยมยอดมาก เป็นรสชาติที่สุดยอดไปเลยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190248
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190248,
					"content": "ฉันกับเพื่อน Nara นับจำนวนแสงสุริยันทอส่องประกายราวกับสีทองที่ร่วงหล่นลงมาจากช่องว่างของใบไม้ด้วยกันในป่า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190249
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190249,
					"content": "แล้วก็ร้องเพลงด้วยกัน ชิม \"รสชาติแห่งความดีใจ\" ไปด้วยกัน ทุกครั้งที่ได้เห็นแสงอาทิตย์ลอดตามช่องว่างของใบไม้ ฉันก็จะคิดถึงเขา ทุกครั้งที่คิดถึงเขา ฉันก็จะคิดถึง \"รสชาติแห่งความดีใจ\" น่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190250
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190250,
					"content": "เพราะฉะนั้น ฉันเลยอยากให้ Arapacati ได้ลองชิมรสชาติแบบนี้บ้างน่ะ แล้วก็ถ้าถึงเทศกาลไร้อาวรณ์แล้ว ก็จะให้ Nara ชิมรสชาติแบบนี้ด้วยเหมือนกันนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190251
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190251,
					"content": "#ฉันเข้าใจแล้วล่ะ งั้นให้เป็นหน้าที่ของฉันกับ {NICKNAME} แล้วกันนะ! ใช่มั้ย {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190252,
						730190253
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190252,
					"content": "ฉันเองก็อยากดีใจเหมือนกัน",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190254
					]
				},
				{
					"id": 730190254,
					"content": "จริง ๆ นะ? พวกเธอไม่ได้หลอกฉันใช่มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190255
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190255,
					"content": "ไม่ได้หลอกหรอกน่า!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190256
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190256,
					"content": "แต่ที่ Gandharva Ville มีคนเยอะแยะขนาดนั้น แล้วต้องไปหาใครที่นั่นกันแน่ล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190257
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190257,
					"content": "ฉันรู้แล้วล่ะ เมื่อไม่นานมานี้ได้เจอกับ Nara คนนึง เขาพกมันเดินผ่านเส้นทางนี้<color=#00E1FFFF>ไปยัง Gandharva Ville</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190258
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190258,
					"content": "เขากำลังแบกอะไรพอง ๆ บางอย่างไว้บนหลังของเขา เป็นของที่ Nara เอาไว้บรรจุสิ่งของน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190259
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190259,
					"content": "แบกสิ่งของพอง ๆ งั้นเหรอ... อืม <color=#00E1FFFF>น่าจะเป็นกระเป๋าเดินทางหรือไม่ก็เป้สะพายหลัง</color>ล่ะมั้ง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190260
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190260,
					"content": "เข้าใจแล้วล่ะ พวกเราจะไปช่วยเธอตามหา \"รสชาติแห่งความดีใจ\" เดี๋ยวนี้เลย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190253,
					"content": "ก็ในเมื่อตอบตกลง Arapacati ไปแล้ว...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190254
					]
				},
				{
					"id": 730190239,
					"content": "ว๊าก! Paimon เธอน่ากลัวมากเลยล่ะ!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190240
					]
				},
				{
					"id": 730190240,
					"content": "นี่! ฉันก็แค่อยากช่วย Arasaka เท่านั้นเอง!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190234,
					"content": "...ฟองอากาศแข็ง ๆ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190235
					]
				},
				{
					"id": 730190230,
					"content": "\"รสชาติแห่งความดีใจ\" ที่เธอพูดถึงคือ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190231
					]
				},
				{
					"id": 730190216,
					"content": "พวกเรารู้ตั้งนานแล้วล่ะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190217
					]
				},
				{
					"id": 730190217,
					"content": "อะไรนะ! รู้ตั้งนานแล้ว? ที่แท้พวกเธอก็เล็งฉันไว้ตั้งนานแล้วเหรอ... หระ หรือว่าพวกเธอต้องการอะไรจากฉัน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190218
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190218,
					"content": "หรือว่าจะเป็น Zaytun Peach? ไม่นะ ไม่ได้ ถ้าเป็นอย่างอื่นฉันให้ได้... ตะ...แต่ลูกท้อให้ไม่ได้ ไม่ว่ายังไงก็ไม่ได้!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190219
					],
					"speakerTitle": "Arasaka"
				}
			]
		},
