			"dialogs": [
				{
					"id": 730190101,
					"content": "ต้องดูดอาหาร, ฝน และน้ำค้างให้ดี ๆ จะได้โตไว ๆ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190102
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190102,
					"content": "สวัสดี! เธอคือ Ara...Ara อะไรนะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190103,
						730190105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190103,
					"content": "เธอคือพี่ชายของ Arapacati ใช่มั้ย?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190104
					]
				},
				{
					"id": 730190104,
					"content": "โอ้ ๆ มุขนี้ใช้ได้เลยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190107,
					"content": "...โตแล้ว โตแล้วกลายเป็นอาหารแสนอร่อย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190108
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190108,
					"content": "ไม่ได้ฟังที่พูดเลยสักนิด...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190105,
					"content": "Arasaka",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190106
					]
				},
				{
					"id": 730190106,
					"content": "Arasaka! เธอคือ Arasaka งั้นเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190107
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7301902,
			"completionStepIds": [
				7301902
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
