				"points": []
			},
			"dialogs": [
				{
					"id": 726950101,
					"content": "Bertrand!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726950102,
					"content": "#{NICKNAME} กับ Paimon นี่เอง มาได้จังหวะพอดีเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950103
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950103,
					"content": "เครื่องสร้างเตาหลอมนีโอ... เอ่อ \"เจ้าเครื่องจักรยักษ์\" ของฉันประมวลผลวัตถุดิบที่เธอรวบรวมมาเสร็จเรียบร้อยแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950104
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950104,
					"content": "ผลเป็นยังไงบ้าง?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950105
					]
				},
				{
					"id": 726950105,
					"content": "ยังไงนั่นก็เป็นถึงเครื่องจักรที่ฉันสร้างเองกับมือ จะไปมีปัญหาได้ยังไงกันเล่า! ถึงจะเห็นฉันเป็นแบบนี้ แต่ทักษะของฉันก็ได้รับการฝึกฝนมาจาก Fontaine เชียวนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950106
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950106,
					"content": "ยังไงฉันก็เป็นคน Fontaine ในโลกนี้ก็ไม่มีใครที่จะเข้าใจการสร้างและการทำงานของเครื่องมือที่มีความแม่นยำได้ดีไปกว่าพวกเราแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950107
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950107,
					"content": "ครั้งก่อนก็แค่รีบร้อนเตรียมการไปหน่อย แล้วก็ไม่มีคนช่วยรวบรวมวัตถุดิบที่จำเป็นด้วย เลยทำให้ของเล่นที่ผลิตออกไปเกิดการระเบิด แต่ครั้งนี้มันไม่เหมือนเดิมแล้ว！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950108
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950108,
					"content": "งั้นเหรอ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726950109,
					"content": "ถ้าของเล่นรอบนี้เกิดระเบิดขึ้นอีก สิ่งที่จะระเบิดตามก็คงเป็นเงินเก็บกับอีกครึ่งชีวิตที่เหลืออยู่ของฉันแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950110
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950110,
					"content": "ถึงเธอจะไม่เชื่อใจฉัน แต่ก็ต้องเชื่อในการตัดสินใจของฉันที่ใช้อีกครึ่งชีวิตที่เหลือเป็นเดิมพันนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950111
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950111,
					"content": "เมื่อก่อนฉันไม่เห็นจะเคยรู้มาก่อนเลยว่าผู้ผลิตของเล่นจะเป็นอาชีพที่ต้องมีการเตรียมใจถึงระดับนี้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726950112,
					"content": "เอาเถอะ ๆ ได้เวลาดำเนินการในขั้นตอนต่อไปแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950113
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950113,
					"content": "เพื่อเป็นการกันไว้ก่อน ฉันขอถามคำถามพวกเธอสักข้อนะ ในทั้งหมดสามขั้นตอน ที่พวกเราทำสำเร็จไปแล้วก็คือการ \"รวบรวมวัตถุดิบ\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950114
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950114,
					"content": "งั้นขั้นตอนต่อไปควรจะเป็น \"รวบรวมแกนกลาง\" หรือว่า \"รวบรวมการชาร์จ\" ล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950115,
						726950118
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950115,
					"content": "\"รวบรวมแกนกลาง\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950116
					]
				},
				{
					"id": 726950116,
					"content": "ยินดีด้วยนะ... เธอตอบผิด ถ้าเธอไปรวบรวมแกนกลางจริง ๆ งั้นก็คงถือว่าเธอมีส่วนในการทำลายอีกครึ่งชีวิตที่เหลืออยู่ของฉันแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950117
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950117,
					"content": "คำตอบที่ถูกต้องคือ \"ชาร์จพลังงานธาตุ\" ต่างหากเล่า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950121
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950121,
					"content": "เอาเป็นว่า... สิ่งที่เรียกว่าการ \"ชาร์จพลังงานธาตุ\" ก็คือการพกพา \"เครื่องรวบรวมวัตถุดิบ\" โดยอยู่ภายในสภาวะที่ได้รับผลกระทบจากธาตุ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950122
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950122,
					"content": "ยกตัวอย่างเช่น ถ้าฉันอยากจะรวบรวมธาตุน้ำ ก็พกพา \"เครื่องรวบรวมวัตถุดิบ\" ไปยืนอยู่ในแม่น้ำสักระยะนึง ถ้าฉันอยากรวบรวมธาตุไฟฟ้า...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950123
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950123,
					"content": "ก็ต้องไปยืนให้ฟ้าผ่า?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726950124,
					"content": "โธ่ ก็พวกเธอเป็นถึงนักผจญภัย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950125
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950125,
					"content": "ฉันเชื่อมั่นในร่างกายของพวกเธอในฐานะนักผจญภัยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950126
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950126,
					"content": "ที่เชื่อมั่นคือร่างกายหรอกเหรอ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950127
					]
				},
				{
					"id": 726950127,
					"content": "ที่จริงวิธีที่ดีที่สุดก็คือการสัมผัสสิ่งมีชีวิตธาตุ ก่อนหน้านี้ตอนที่ท่องเที่ยวอยู่ใน Inazuma ฉันได้ทำเครื่องหมายไว้ยังสถานที่ที่สิ่งมีชีวิตธาตุมักจะปรากฏตัวออกมาอยู่สามแห่ง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950128
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950128,
					"content": "เดิมทีฉันก็คิดไว้ว่าถ้าไม่มีผู้ช่วย ก็จะแอบนั่งเรือไปยังสถานที่เหล่านั้นเพื่อสัมผัสสิ่งมีชีวิตธาตุ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950129
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950129,
					"content": "มันจะอันตรายเกินไปแล้ว...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726950130,
					"content": "ตอนนี้มีพวกเธออยู่ด้วยแล้วนี่นา พวกเธอลองไปยังสถานที่เหล่านั้นเพื่อเสี่ยงโชคดูสิ ลองดูว่าจะมีสิ่งมีชีวิตธาตุอยู่รึเปล่า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950131
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950131,
					"content": "เรื่อง \"ชาร์จพลังงานธาตุ\" ต้องขอฝากพวกเธอด้วยล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950118,
					"content": "\"รวบรวมการชาร์จ\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950119
					]
				},
				{
					"id": 726950119,
					"content": "ฮ่าฮ่า ถึงจะดูเหมือนถูก แต่ความจริงแล้วไม่ใช่การ \"รวบรวมการชาร์จ\" แต่เป็นการ \"ชาร์จพลังงานธาตุ\" ต่างหาก คิดไม่ถึงล่ะสิว่าตัวเลือกทั้งสองข้อที่ฉันมีให้จะไม่มีข้อถูกเลยน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950120
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950120,
					"content": "เขาหัวเราะได้น่าโมโหจริง ๆ เลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950121
					],
					"speakerTitle": "Paimon"
				}
			]
		},
