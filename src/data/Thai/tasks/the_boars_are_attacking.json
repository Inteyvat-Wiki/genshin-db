			"dialogs": [
				{
					"id": 4680201,
					"content": "มีอะไรให้ฉันช่วยไหม?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4680202
					]
				},
				{
					"id": 4680202,
					"content": "คุณคือ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680203
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680203,
					"content": "...นักเดินทางนี่เอง ใจดีจังเลยนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680204
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680204,
					"content": "ตอนนี้เป็นเวลาสำคัญสำหรับการเติบโตขององุ่น แต่ฉันไม่ทราบว่าหมูป่ามาจากไหน พวกมันมาเป็นกลุ่มและจ้องมาที่นี่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680205
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680205,
					"content": "ฉันคนเดียวไล่มันไม่ยอมไป ลูกชายก็ไม่อยู่แถวนี้ ทำได้แค่มองดูพวกมันทำลายที่ดินของฉัน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680206
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680206,
					"content": "หากคุณสามารถสอนบทเรียนกับหมูป่าพวกนี้ได้ ฉันจะให้รางวัลตอบแทนอย่างงามเลย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tunner"
				}
			]
		},
