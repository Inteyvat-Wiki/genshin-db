			"dialogs": [
				{
					"id": 4680301,
					"content": "ฉันยังมีเรื่องต้องทำ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4680302
					]
				},
				{
					"id": 4680302,
					"content": "อย่างนี้นี่เอง งั้นฉันคงต้องรอจนกว่าลูกชายจะหยุดงานแล้วกลับมา แล้วค่อยสั่งสอนเจ้าหมูนิสัยแย่เหล่านี้",
