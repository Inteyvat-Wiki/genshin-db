					"nextDialogs": [
						741185003
					]
				},
				{
					"id": 741185003,
					"content": "ดูจากตอนนี้ พวกเรายังไม่รู้ว่าคนพวกนั้นเป็นใครกันแน่",
					"roleType": "TALK_ROLE_NPC",
