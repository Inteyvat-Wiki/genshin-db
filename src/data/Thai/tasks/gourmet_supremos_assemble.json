					"Xudong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721680301,
					"content": "แบบนี้... แล้วค่อยแบบนั้น...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680302
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680302,
					"content": "เธอทำเสร็จแล้วงั้นเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721680303
					]
				},
				{
					"id": 721680303,
					"content": "ขาดแค่ขั้นตอนสุดท้ายแล้ว... ฉันต้องชุบมันก่อน จากนั้นค่อยเอาลงไปทอด...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680304
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680304,
					"content": "เสร็จแล้ว! Sakura Tempura รีบลองชิมดูสิ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680305
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680305,
					"content": "อะ...อร่อย มันระ...ร้อนนิดหน่อย... ฟู่วฟู่วฟู่ว...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680306
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721680306,
					"content": "Xudong ในหนังสือเรียกว่า \"Tempura\" น่าจะต้องเสิร์ฟกับซอสอะไรนี่แหละ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680307
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721680307,
					"content": "ซอส? ฉันไม่ได้เตรียมไว้ ถ้ามีโอกาสคราวหน้าฉันจะลองทำดู",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680308
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680308,
					"content": "\"Sakura Tempura\" ให้เธอชุดหนึ่ง ช่วยรับไปทีนะ ขอบคุณมากนะที่ช่วยพวกเรา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680309
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680309,
					"content": "แล้วก็ยังมีวิธีการทำ \"Sakura Tempura\" ฉันก็คัดลอกให้เธอชุดหนึ่งแล้วด้วย เธอก็รับไว้เถอะนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680310
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680310,
					"content": "ต่อไปมีโอกาส เธอก็ลองฝึกทำดูนะ การทำอาหารน่ะ สนุกมาก ๆ เลยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680311,
						721680313
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680311,
					"content": "ขอบคุณนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721680312
					]
				},
				{
					"id": 721680312,
					"content": "ไม่ต้องเกรงใจ ไม่ต้องเกรงใจ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680314
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680314,
					"content": "เราจะอยู่ที่ Inazuma อีกสักพัก แล้วอาจจะไปแถว ๆ <color=#00E1FFFF>Kannazuka</color> ทีหลังน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680316
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680316,
					"content": "และ Julie บอกว่า เธออยากไปดูต้น Sacred Sakura ที่อยู่ใน \"ศาลเจ้า Grand Narukami\" ด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680317
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680317,
					"content": "ว่ากันว่า \"Sakura Bloom\" บนเกาะนี้ทั้งหมด ต่างก็ตกลงมาจากต้นไม้ใหญ่ที่นั่น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680318
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680318,
					"content": "ต้องใหญ่แค่ไหนกันนะ ถึงได้ลอยมาเยอะขนาดนั้น...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680319
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680319,
					"content": "ถ้าคุณสนใจ ก็ลองไปดูที่นั่นได้นะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680320
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680320,
					"content": "ขอบคุณอีกครั้งนะที่ช่วย นักเดินทาง ฉันจะไปหาของอะไรกินหน่อย หิวจะตายแล้ว...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680313,
					"content": "พวกเธอจะไปที่ไหนต่อ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721680314
					]
				}
			]
		},
