					"nextDialogs": [
						120240413
					]
				},
				{
					"id": 120240413,
					"content": "งั้นก็เยี่ยมเลย เราออกเดินทางกันเถอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120240412,
					"content": "ฉันก็อยากให้การเจรจาสงบศึกสำเร็จเหมือนกัน",
					"roleType": "TALK_ROLE_PLAYER",
