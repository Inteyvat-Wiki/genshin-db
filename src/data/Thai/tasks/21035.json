				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210350101,
					"content": "เฮ้อ ศิษย์น้อง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350102,
						210350103
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350102,
					"content": "เอ๋? Sun Yu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350104
					]
				},
				{
					"id": 210350104,
					"content": "นักเดินทาง? บังเอิญจังเลย นึกไม่ถึงเลยว่าจะมาเจอเธอที่นี่...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350105
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350105,
					"content": "ฉัน... กำลังฝึกฝนอยู่ที่นี่น่ะ อีกสักพักก็เตรียมจะออกจาก Liyue ไปท่องต่างแดนแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350106,
						210350107
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350106,
					"content": "ทำไมจู่ ๆ ก็อยากออกจาก Liyue ล่ะ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350108
					]
				},
				{
					"id": 210350108,
					"content": "แค่ก พูดไปแล้วก็น่าละอายแก่ใจ ถึงก่อนหน้านี้จะเอาแต่พูดปาว ๆ ว่าอยากฟื้นฟูสำนัก Guhua แต่การกระทำในชีวิตประจำวันกลับ... จะบอกว่าไปตามหาเซียน อันที่จริงก็แค่เดินเตร่ไปทั่ว Jueyun Karst ก็เท่านั้นเอง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350109
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350109,
					"content": "แม้ว่าศิษย์น้องจะคอยอยู่เคียงข้าง แต่ฉันรู้ดีอยู่แก่ใจ การกระทำเช่นนั้นไร้ความหมายต่อการฟื้นฟูสำนัก Guhua อย่างสิ้นเชิง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350110
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350110,
					"content": "ก่อนหน้านี้ ตอนที่ฉันกลับเข้าเมืองมาซื้อของ ได้บังเอิญเจอและคุยกับคนค้าขายจาก Fontaine คนหนึ่ง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350111
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350111,
					"content": "ชาว Fontaine ท่านนั้นบอกฉันว่า: \"คุณไม่อาจเจอวิธีแก้ปัญหาในจุดที่เกิดปัญหาหรอกนะ\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350112
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350112,
					"content": "ฉันเอามาคิดอยู่นาน... บางทีคนค้าขายชาว Fontaine ท่านนี้ อาจกำลังแนะนำให้ฉันลองเดินทางไปพื้นที่นอก Liyue ดูบ้างก็ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350113,
						210350114
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350113,
					"content": "ลองออกไปดูบ้างก็ดีเหมือนกัน",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350115
					]
				},
				{
					"id": 210350115,
					"content": "ฉันก็คิดแบบนั้นเหมือนกัน แต่... แต่ศิษย์น้องกลับไม่ยอมออกจาก Liyue",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350116
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350116,
					"content": "ปกติตอนที่ศิษย์น้องอารมณ์เสียนั้น ฉันรู้ว่าเธอก็แค่แกล้งหยอกฉันเล่น กล่อมไม่กี่ทีก็ดีขึ้นแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350117
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350117,
					"content": "แต่คราวนี้เธอกลับโกรธขึ้นมาจริง ๆ ไม่ว่ายังไงก็ไม่ยอมฟังที่ฉันพูดเลยสักนิด แถมยังหนีกลับเข้าเมืองคนเดียวอีก เฮ้อ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350118
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350118,
					"content": "เลิกพูดเรื่องพวกนี้ดีกว่า เธอฟังฉันพูดเรื่องพวกนี้ก็คงจะรำคาญเหมือนกัน... นักเดินทาง ฉันขอไหว้วานอย่างหนึ่งได้มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350119
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350119,
					"content": "ถึงฉันจะมีวิทยายุทธป้องกันตัวอยู่บ้าง แต่ปกติก็ไม่ค่อยได้ใช้จริงเลย วันหลังถ้าต้องออกไปท่องต่างแดน ฉันก็คงหลีกเลี่ยงการต่อสู้จริง ๆ ไม่ได้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350120
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350120,
					"content": "นักเดินทาง ฉันเคยได้ยินเรื่องราวการผจญภัยต่างแดนของเธอมามากมาย เธอต้องรู้วิธีรับมือกับมอนสเตอร์ไม่น้อยเลยแน่นอน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350121
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350121,
					"content": "ช่วยไปหามอนสเตอร์แถวนี้มาซ้อมมือเป็นเพื่อนฉันหน่อยสิ และช่วยชี้แนะฉันไปด้วยเลยได้เปล่า?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350122,
						210350123
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350122,
					"content": "ไม่มีปัญหา",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350125
					]
				},
				{
					"id": 210350125,
					"content": "ไหนดูหน่อยซิ... มีจุดรวมตัวของมอนสเตอร์อยู่ใกล้ ๆ นี้ พวกเราไปที่นั่นก่อนเลยดีกว่า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350123,
					"content": "หึ กลัวแต่ว่าคุณจะมองเห็นกระบวนท่าฉันไม่ชัดเท่านั้นแหละ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350124
					]
				},
				{
					"id": 210350124,
					"content": "อ๊ะ... วิทยายุทธของเธอเก่งกล้าขนาดนี้เลยเหรอเนี่ย? ฮ่าฮ่าฮ่า งั้นฉันคงต้องขอให้เธอทำท่าช้าลงหน่อยแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350125
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350114,
					"content": "ถือว่าเป็นการผ่อนคลายก็ได้",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350115
					]
				},
				{
					"id": 210350107,
					"content": "คุณจะฟื้นฟูสำนัก Guhua ไม่ใช่เหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350108
					]
				},
				{
					"id": 210350103,
					"content": "กำลังทำอะไรอยู่เหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350104
					]
				}
			]
		},
