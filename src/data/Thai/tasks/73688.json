				"points": []
			},
			"dialogs": [
				{
					"id": 736880201,
					"content": "ทั้งสองคนมากันแล้วเหรอ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880202
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880202,
					"content": "อึ๋ย Hirotatsu นี่นา!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880203,
					"content": "#การประชันเมื่อไม่กี่วันก่อน {NICKNAME} ก็เอาชนะนายไปแล้วนี่ แถมยังเป็นผู้ชนะในตอนสุดท้ายด้วย ตอนนี้นายยังมีอะไรจะพูดอีกมิทราบ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880204,
					"content": "โปรดวางใจเถอะ ฉันไม่ได้จะมาหาเรื่องทั้งสองแต่อย่างใด แต่มาขอโทษต่างหาก นักเดินทาง การประชันกับเธอเมื่อวันก่อน ฉันยอมรับความแพ้จากใจจริง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880205
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880205,
					"content": "วิชาดาบของเธอช่างยอดเยี่ยม กระบวนดาบเฉียบคมแต่ไม่บีบคั้น แสดงให้เห็นถึงลักษณะนิสัยได้เป็นอย่างดี ก่อนหน้านี้ฉันตัดสินเธอผิดไป แถมยังใช้ถ้อยคำเสียมารยาทอีก ต้องขออภัยด้วยจริง ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880206,
						736880207
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880206,
					"content": "ไม่เป็นไร ฉันไม่ได้เก็บเอามาใส่ใจเท่าไหร่",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880208
					]
				},
				{
					"id": 736880208,
					"content": "วันนี้ทั้งสองคนมารับคุณหนู Kamisato กันสินะ? ตอนนี้คุณหนูกำลังแต่งตัวอยู่ด้านใน อีกไม่นานก็คงออกมาแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880209
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880209,
					"content": "นักเดินทาง ถือโอกาสก่อนที่คุณหนูจะออกมา ฉันมีเรื่องอยากจะขอร้องหน่อยน่ะ หวังว่าเธอจะตอบตกลง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880210
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880210,
					"content": "โอเค ว่ามาเลย",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880211
					]
				},
				{
					"id": 736880211,
					"content": "แม้ว่าคุณหนูจะไม่เคยพูดถึง เรื่องการแสดงประชันในวันนี้กับข้ารับใช้อย่างพวกเราก็ตาม แต่ไม่ว่าช่วงนี้คุณหนูจะงานยุ่งแค่ไหน ตอนกลางคืนก็จะหาเวลามาซ้อมวิชาดาบอยู่หลายชั่วโมงเสมอ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880212
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880212,
					"content": "คุณหนูมักจะมุ่งมั่นตั้งใจเสมอ ถึงอันที่จริงจะแพ้ในการแสดงประชันวันนี้ก็ไม่เป็นไร แต่ถ้าดูจากนิสัยของคุณหนูละก็ ต้องทุ่มแรงกายต่อสู้จนไม่สนใจสิ่งรอบด้านแน่นอน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880213
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880213,
					"content": "ในฐานะข้ารับใช้ ฉันเชื่อมั่นในความสามารถของคุณหนูอยู่แล้ว เพียงแต่... หวังว่าเธอจะคอยสนับสนุน และปกป้องความปลอดภัยให้กับคุณหนูบนสนามนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880214
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880214,
					"content": "วางใจเถอะ ฉันจะทำแบบนั้นแน่นอน",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880215
					]
				},
				{
					"id": 736880215,
					"content": "นักเดินทาง งั้นฝากคุณหนูไว้กับเธอด้วยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880217
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880217,
					"content": "โอ้ Ayaka น่าจะออกมาแล้วสินะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880218,
					"content": "ว้าว...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880219,
					"content": "เอ๋ อะไรกัน ทำไมพวกเธอสองคนไม่พูดไม่จาอะไรเลยล่ะ... ชุดนี้มีตรงไหนไม่เหมาะสมหรือเปล่า?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880220
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880220,
					"content": "เปล่าเลย! Ayaka เธอใส่แบบนี้แล้วสวยมากเลย... ให้ความรู้สึกเหมือนจู่ ๆ ตรงหน้าก็สว่างวาบขึ้นเลยไรงี้!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880221,
						736880225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880221,
					"content": "สไตล์นี้เหมาะกับเธอมาก",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880222
					]
				},
				{
					"id": 736880222,
					"content": "ใช่แล้ว ๆ ดูอย่างกับคุณหนูจาก Fontaine แน่ะ บรรยากาศรอบตัวก็ดูสดใสขึ้นเยอะเลย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880223,
					"content": "จริงเหรอ? ฉันยังกังวลอยู่เลยว่าจะดูซุกซนเกินไปหรือเปล่า... ฉันอาจจะไม่เหมาะกับสไตล์แบบนี้ก็ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880224
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880224,
					"content": "แต่ในเมื่อพวกเธอคิดว่าไม่เลว งั้นฉันก็วางใจแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880229
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880229,
					"content": "ฮี่ฮี่ เดี๋ยวพอทุกคนเห็น Ayaka ก็ต้องตะลึงอ้าปากค้างแน่นอน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880230,
					"content": "Paimon ขอบคุณสำหรับคำชมนะ นักเดินทาง ในเมื่อเตรียมตัวพร้อมแล้ว พวกเราก็ออกเดินทางไปสนามแข่งกันเถอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880231
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880231,
					"content": "คุณหนู นักเดินทาง ระวังตัวด้วย ขอให้การแสดงประชันเป็นไปอย่างราบรื่น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880225,
					"content": "ชุดสวยมาก เข้ากับเธอมากเลย",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880226
					]
				},
				{
					"id": 736880226,
					"content": "ใช่แล้ว ๆ พอดูดี ๆ บนกระโปรงปักลายดอกสึบากิประจำตระกูล Kamisato เอาไว้ด้วยนี่นา!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880227,
					"content": "อื้ม คุณ Onodera หาคนมารีบปักให้ในหลายวันมานี้น่ะ ได้ยินมาว่าเพิ่มตามข้อเสนอแนะที่ผู้ชมเขียนเอาไว้บนใบลงเสียงโหวตแน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880228
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880228,
					"content": "ชุดนี้ตัดเย็บได้พอดีตัวมาก เวลาเคลื่อนตัวก็สะดวกกว่าที่คิดเอาไว้ซะอีก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880229
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880207,
					"content": "การประชันกับนายครั้งนั้น ฉันก็สนุกมากเหมือนกัน",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880208
					]
				}
			]
		},
