				"points": []
			},
			"dialogs": [
				{
					"id": 750970201,
					"content": "...อืม รู้สึกไม่ค่อยชินเลยแฮะ ตอนนี้เธอก็ยังไม่สามารถรับพลังธาตุจาก Statue of The Seven ได้อีกงั้นเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970202,
					"content": "เฮ้อ เกิดอะไรขึ้นกับ Statue of The Seven กันแน่นะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970203,
						750970206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970203,
					"content": "อาจเป็นเพราะไม่ได้บำรุงรักษามาหลายปีล่ะมั้ง",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970204
					]
				},
				{
					"id": 750970204,
					"content": "ทั้ง ๆ ที่ตอนที่สัมผัส มันเปล่งแสงสว่างขนาดนั้นแท้ ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970205,
					"content": "เฮ้ Statue of The Seven... นี่ตั้งใจทำงานอยู่รึเปล่าเนี่ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970208,
					"content": "ฉันคิดอะไรไม่ออกเลย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970206,
					"content": "อาจจะเป็นเพราะ Natlan ค่อนข้างพิเศษ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970207
					]
				},
				{
					"id": 750970207,
					"content": "จะว่าไปแล้ว ดูเหมือนว่า Natlan จะได้รับผลกระทบจาก Abyss มาโดยตลอด อย่าบอกนะว่าเป็นเพราะเรื่องนี้?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970208
					],
					"speakerTitle": "Paimon"
				}
			]
		},
