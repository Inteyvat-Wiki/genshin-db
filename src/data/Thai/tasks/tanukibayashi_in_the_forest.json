				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721080101,
					"content": "ในที่สุดก็ถึงแล้ว ที่นี่ก็คือป่า Chinju สินะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080102,
					"content": "มิโกะที่ใส่หน้ากากบอกว่า เธอมีเพื่อนเก่าคนหนึ่งอยู่ในส่วนลึกของป่า Chinju",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080103,
					"content": "ถ้างั้นพวกเรารีบเดินทางกันเถอะ เข้าไปในส่วนลึกของป่ากัน!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7210804,
			"completionStepIds": [
				7210816
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7210816",
							"2"
						],
						"stepId": 7210816,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7210810",
							"3"
						],
						"stepId": 7210810,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721080401,
					"content": "รูปปั้นจิ้งจอกฟ้าที่ปกป้องเครื่องราง... ข้างในไม่มีอะไรอยู่เลยแฮะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080402,
					"content": "ไม่แน่อาจจะถูก \"เพื่อนเก่า\" ของอาเจ๊หน้ากากคนนั้นนำไปซ่อนแล้วก็ได้ ไปถามกันเถอะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080403,
					"content": "อา... อาเจ๊หน้ากาก?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080404
					]
				},
				{
					"id": 721080404,
					"content": "ฉันเพิ่งจะตั้งฉายาใหม่ให้เธอน่ะ เป็นยังไงล่ะ จำง่ายเลยใช่มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080405,
						721080406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080405,
					"content": "ไม่ง่ายเลยสักนิด",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080407
					]
				},
				{
					"id": 721080407,
					"content": "อืม ๆ งั้นก็ช่างเถอะ... สรุปก็คือ พวกเราไปหาเบาะแสกันก่อนเถอะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080406,
					"content": "ไม่รู้จะว่าไงดี อธิบายไม่ถูก",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080407
					]
				}
			]
		},
		{
			"id": 7210807,
			"completionStepIds": [
				7210814
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7210814",
							"2"
						],
						"stepId": 7210814,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ioroi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721080701,
					"content": "อึ๋ยยย... ขะขะขะ... ข้าคือ Ioroi จะทำอะไรก็เชิญ จะ... จะฆ่าจะแกงกันก็เอาเลย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080702
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080702,
					"content": "หวาาาา รูปปั้นพูดได้! แถมยังตกใจกลัวซะจนติดอ่างซะด้วย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080703,
					"content": "ข้าไม่ใช่รูปปั้นหินอะไรนั่นสักหน่อย! แค่ถูกคนผนึกไว้ชั่วคราว ก็เลยมีสภาพที่เป็นแบบนี้เท่านั้น! แต่ข้าก็ยังคงเป็น Bake-Danuki Ioroi ที่มีชื่อเสียงดังกึกก้องไปทั่วทั้งใต้หล้าอยู่ดี!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080704,
						721080705
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080704,
					"content": "Ioroi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080706
					]
				},
				{
					"id": 721080706,
					"content": "อะไรกัน เด็กสมัยนี้... แม้แต่ฉายาของ Ioroi ผู้นี้ก็ไม่รู้จักแล้วงั้นรึ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080707
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080707,
					"content": "\"ม้วนภาพ Tanuki Gyouen\" , \"กาน้ำชาของ Ioroi\" , \"Kakushigami Oobayashi\" , \"Yougou Tanuki Gassen\"... เรื่องพวกนี้ไม่เคยได้ยินบ้างเลยงั้นเหรอ? หืม?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080708
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080708,
					"content": "นี่ตกลงแล้วข้าถูกเจ้าบ้านั่นสาปมานานกี่ปีแล้วกันล่ะเนี่ย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080709,
						721080711
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080709,
					"content": "ฉันไม่มีเจตนาร้ายหรอกนะ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080710
					]
				},
				{
					"id": 721080710,
					"content": "หาา ไม่ใช่ว่าจะมา \"จัดการ\" ข้าหรอกรึ ทำไมไม่บอกให้เร็วกว่านี้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080719
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080719,
					"content": "อะแฮ่ม พูดมาสิ! ที่พวกเจ้ามาหาราชา Bake-Danuki อย่างข้าเนี่ย ต้องการอะไรกัน?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080720,
						721080722
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080720,
					"content": "\"พิธีชำระซากุระศักดิ์สิทธิ์\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080721
					]
				},
				{
					"id": 721080721,
					"content": "สาคูศักดิ์สิทธิ์? นั่นคืออะไรกัน? คือของล้ำค่าของเผ่าปีศาจงั้นรึ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080726
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080726,
					"content": "จริง ๆ เลย...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080727
					]
				},
				{
					"id": 721080727,
					"content": "เฮ้อ เขาเป็นเพื่อนเก่าของมิโกะที่ใส่หน้ากากจริง ๆ งั้นเหรอ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080728,
					"content": "สรุปก็คือ พวกเรากำลังหาของสิ่งหนึ่ง ที่ซ่อนอยู่ในรูปปั้นจิ้งจอกน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080729,
					"content": "อึ๋ยยยย... หะ... หาของนั่นทำไม?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080730,
						721080731
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080730,
					"content": "ว้าว",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080732
					]
				},
				{
					"id": 721080732,
					"content": "ก็เป็นเพราะหวีอันนั้นนั่นแหละ ข้าถึงได้ถูกผนึกไว้ที่นี่...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080733
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080733,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080734,
						721080735,
						721080736
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080734,
					"content": "100 ปี?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080737
					]
				},
				{
					"id": 721080737,
					"content": "ข้าก็ไม่รู้ว่านานเท่าไหร่แล้ว! ที่ป่า Chinju แห่งนี้น่ะ ไม่เห็นเดือนเห็นตะวันตลอดทั้งวัน ไม่สามารถนับวันเวลาได้หรอกนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080738
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080738,
					"content": "ตอนนั้นน่ะ ข้าก็แค่ออกป่วนไปทุกที่ เพื่อที่จะล่อเจ้าจิ้งจอกนั่น แต่ก็ไม่มีผลอะไร",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080739
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080739,
					"content": "ในตอนที่ข้ากำลังจะฉีกรูปปั้นของจิ้งจอกนั่นออกเป็นชิ้น ๆ ด้วยความโกรธนั้น ข้าก็ได้เห็นหวีอันนั้นอยู่ข้างใน จากนั้นจึงคิดอะไรดี ๆ ออก!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080740
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080740,
					"content": "หวีอันนั้นอยู่ในรูปปั้นนั่น แล้วยังมีตราของ Hakushin อยู่ด้วย ก็เลยนึกถึงขนขาว ๆ นั่นขึ้นมา...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080741
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080741,
					"content": "ข้าสังเกตได้ทันทีเลยว่า หวีอันนี้ต้องสำคัญมากแน่ ๆ ถ้าอยากล่อให้จิ้งจอกบ้านั่นออกมา ก็แค่ซ่อนหวีนั่นซะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080742
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080742,
					"content": "อืม ๆ การใช้สมบัติเพื่อดึงดูดผู้คนนั้นมีประโยชน์จริง ๆ นั่นแหละ! แล้วผลลัพธ์ล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080743
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080743,
					"content": "สุดท้ายก็มีมนุษย์ซึ่งเคยเป็นหนึ่งใน \"Yougou Three\" มา จากนั้นก็จัดการสั่งสอนข้าและพวกเด็ก ๆ ในเผ่า แล้วก็เปลี่ยนให้ทั้งหมดกลายเป็นหิน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080744
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080744,
					"content": "นี่คือเหตุผลที่ Ioroi กลัวคนสินะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080745
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080745,
					"content": "ฮึ! เจ้าพวกมนุษย์ ชีวิตก็สั้น แถมยังแปลงกายไม่ได้อีก ไม่รู้ว่าทำไมเจ้าจิ้งจอกบ้าตัวนั้นถึงเข้าข้างพวกมันนัก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080746
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080746,
					"content": "เจ้าคนที่ผนึกพวกข้านั่นก็เกินไป แถมยังพูดประมาณว่า \"อืม ๆ ตอนที่จะโดนผนึกน่ะ ทำท่าเท่ ๆ ด้วยล่ะ จะได้กลายเป็นทิวทัศน์สวย ๆ แถวนี้ไง\" อีกด้วย... น่าโมโหเป็นบ้า!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080747
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080747,
					"content": "ก็เป็นทิวทัศน์ที่สวยจริง ๆ ล่ะนะ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080748
					]
				},
				{
					"id": 721080748,
					"content": "เอ๋? เจ้าเด็กนี่ ทำไมถึงได้...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080749
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080749,
					"content": "#(เห้ {NICKNAME} ถ้าไปทำให้เขาโมโหแล้วอดได้เครื่องรางมาจะทำยังไง...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080750,
						721080751
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080750,
					"content": "หมายถึงคุณดูสูงใหญ่และทรงพลังดีน่ะ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080752
					]
				},
				{
					"id": 721080752,
					"content": "แน่... แน่นอนซี่ ราวกับแสงอันเจิดจรัส ท่ามกลางป่าอันมืดมิดแห่งนี้เลยล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080753
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080753,
					"content": "......",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080754
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080754,
					"content": "ไหนลองว่ามาอีกซิ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080755,
						721080756
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080755,
					"content": "เปรียบเสมือนเทวรูป...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080757
					]
				},
				{
					"id": 721080757,
					"content": "ห้ายย เพราะงั้น... เรื่องที่ถูกผนึกไม่ใช่เรื่องเลวร้ายขนาดนั้นนี่นาา และผู้คนก็ไม่ได้มีเจตนาร้ายด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080758
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080758,
					"content": "ถึงแม้ว่าสิ่งที่เธอพูด จะดูเหมือนว่ามีเหตุผล แต่ก็ยิ่งดูเหมือนว่าเรื่องจะไม่เป็นอย่างนั้น...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080759
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080759,
					"content": "หวีอันนั้นน่ะ ขอยืมดูหน่อยสิ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080760
					]
				},
				{
					"id": 721080760,
					"content": "ก็ไม่ใช่ไม่ได้ แต่พวกเจ้าจะต้องไปเล่นกับพวกเด็ก ๆ ซะก่อน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080761
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080761,
					"content": "#อืมม อันนี้ไม่ยาก {NICKNAME} เข้ากับเด็ก ๆ ได้ดีมาก ๆ เลยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080762,
						721080763
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080762,
					"content": "ที่จริงฉันไม่ถนัดในการรับมือกับเด็ก...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080765
					]
				},
				{
					"id": 721080765,
					"content": "Shousei, Gyoubu Koban, และ Kichiboushi ไปหาพวก<color=#00E1FFFF>ทานูกิน้อยทั้งสาม</color>ในป่า เพื่อเล่นกับพวกเขาสิ ยังไงซะฉันก็ไม่สามารถเคลื่อนไหวได้อย่างอิสระอยู่แล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080766
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080766,
					"content": "เพราะตอนที่ผนึกพวกเขา เจ้านั่นไม่ได้ตั้งใจเท่าไหร่ เพราะงั้นเมื่อไม่นานมานี้ ก็เลยมีบางส่วนวิ่งออกมาแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080767
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080767,
					"content": "...ไม่สิ ต้องพูดว่าพลังเวทมนตร์ของพวกเรา Bake-Danuki นั้นแกร่งกล้า ก็ถือเป็นเรื่องปกติอ่ะนะ ที่จะสามารถหลุดพ้นจากผนึกของพวกมนุษย์ได้!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080768,
						721080770
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080768,
					"content": "แล้วตัวเธอล่ะ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080769
					]
				},
				{
					"id": 721080769,
					"content": "อะแฮ่ม! มีเวทมนตร์อันทรงพลัง!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080771
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080771,
					"content": "แม้ว่าจะเทียบไม่ได้กับเวทมนตร์ของข้า Ioroi ผู้นี้ แต่พวกมันก็ยังพอมีเวทมนตร์อยู่นิดหน่อย ก็เลยพอจะซ่อนร่างของตัวเองได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080772
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080772,
					"content": "เอาล่ะ ๆ รีบไปกันเถอะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080770,
					"content": "เวทมนตร์อันทรงพลัง!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080771
					]
				},
				{
					"id": 721080763,
					"content": "ถูกต้อง ปกติฉันเล่นกับ Paimon ประจำ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080764
					]
				},
				{
					"id": 721080764,
					"content": "เห้ยย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080765
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080756,
					"content": "Statues of The Seven ก็ยังต้องละอายใจ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080757
					]
				},
				{
					"id": 721080751,
					"content": "หมายถึงคุณดูหล่อเหลาและแข็งแกร่งน่ะ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080752
					]
				},
				{
					"id": 721080735,
					"content": "1000 ปี?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080737
					]
				},
				{
					"id": 721080736,
					"content": "1 ล้านปี?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080737
					]
				},
				{
					"id": 721080731,
					"content": "มีปฏิกิริยาด้วยแฮะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080732
					]
				},
				{
					"id": 721080722,
					"content": "\"เครื่องราง\" ของที่นี่...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080723
					]
				},
				{
					"id": 721080723,
					"content": "เครื่องชาม? จะทำอาหารรึ? พวกเรา Bake-Danuki ค่อนข้างมีความรู้เกี่ยวกับการทำอาหารทีเดียว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080724
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080724,
					"content": "ไม่ใช่แล้ว หมายถึง \"พิธีชำระซากุระศักดิ์สิทธิ์\" ต่างหาก!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080725
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080725,
					"content": "สัตว์ปีก? อ่าา นานมากแล้วนะ ที่ไม่ได้กินสัตว์ปีกเนี่ยย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080726
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080711,
					"content": "ฉันมาทวงหนี้",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080712
					]
				},
				{
					"id": 721080712,
					"content": "อ๋า ทวงหนี้?! ที่ไหน เมื่อไหร่? ข้าคิดก่อน ข้าคิดก่อนนะ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080713
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080713,
					"content": "ใบหน้าของเจ้า ตัวของเจ้าเนี่ย... เอ่อ... ข้าติดค้างอะไรอยู่งั้นรึ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080714
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080714,
					"content": "ทางนั้นพยายามนึกทบทวนจนจะแย่แล้ว...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080715
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080715,
					"content": "เฮ้ อย่ามาล้อเล่นกับคนแปลกหน้าแบบนี้ซี่!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080716,
					"content": "หาา อย่ามาล้อเล่นแบบนี้นะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080717
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080717,
					"content": "อืม ไม่มีก็ดี ไม่มีก็ดี... ถ้างั้นข้าขอยืนยันซะหน่อย ไม่ได้ติดค้างอะไรพวกเจ้าจริง ๆ ใช่มั้ย?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080718
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080718,
					"content": "...หรือว่าคุณติดหนี้เยอะงั้นเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080705,
					"content": "ชื่อเสียงดังกึกก้องไปทั่วทั้งใต้หล้า?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080706
					]
				}
			]
		},
