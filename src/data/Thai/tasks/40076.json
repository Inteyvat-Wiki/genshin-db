					"Xinyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400761501,
					"content": "ทัศนียภาพช่างโอ่อ่าเหลือเกิน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761502
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400761502,
					"content": "สมกับเป็นโหรแห่งดวงดาวใช่มั้ยล่ะ ท่าน Megistus คือนักเวทผู้ยิ่งใหญ่ที่เจ๋งที่สุดในดินแดนแห่งราตรีบริสุทธิ์",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761503
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400761503,
					"content": "ขอบคุณ ว่าแต่ดินแดนแห่งราตรีบริสุทธิ์มีประวัติศาสตร์ยาวนานเท่าไหร่แล้วนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761504
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761504,
					"content": "...ดวงดาราดั่งเพชร ดวงจันทราดั่งไข่มุก นี่คือท้องฟ้าที่กว้างใหญ่ที่สุดที่ฉันเคยเห็นเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761505
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400761505,
					"content": "งดงามจริง ๆ ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761506
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400761506,
					"content": "มีมิติมายาแบบนี้ Mona เองก็ต้องซ่อนทะเลแห่งดวงดาวที่กว้างสุดลูกหูลูกตาเอาไว้ในใจด้วยสินะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761507
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400761507,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761508
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761508,
					"content": "Mona เป็นอะไรไปเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400761509
					]
				},
				{
					"id": 400761509,
					"content": "...ฉันกำลังคิดว่า นี่จะต้องเป็นเรื่องที่พวกเราตั้งตารออยู่อย่างแน่นอน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761510
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761510,
					"content": "ท้องฟ้านี้สวยงามมาก พูดได้เลยว่าสวยกว่าฉากภาพที่ฉันทำนายไว้ซะอีก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761511
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761511,
					"content": "ดวงดาวทุกดวงอยู่ในตำแหน่งที่ถูกต้องทั้งนั้น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761512
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761512,
					"content": "...นี่เป็นมิติมายาที่เป็นของฉันอย่างแน่นอน มีเพียงที่นี่เท่านั้นที่จะมองเห็นสิ่งมหัศจรรย์แบบนี้ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761513
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761513,
					"content": "สิ่งมหัศจรรย์? ทำไมพูดแบบนี้ล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400761514,
					"content": "พวกเธอรู้มั้ย? ท้องฟ้าของ Teyvat นั้นมีความแปลกมาก เหมือนมันซ่อนคำตอบทั้งหมดของโลกไว้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761515
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761515,
					"content": "\"ลูกชายฉันที่หายตัวไปจะกลับมาเมื่อไหร่?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761516
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761516,
					"content": "\"ตกลงคนคนนั้นรักฉันรึเปล่า?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761517
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761517,
					"content": "\"ฉันจะแข็งแรงขึ้นมั้ย?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761518
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761518,
					"content": "ไม่ว่าเรื่องมันจะเป็นไง มันก็จะถูกบันทึกไว้ในวงโคจรดวงดาวแห่งชีวิตของเธอแล้ว แต่ในโลกมีผู้คนอยู่มากมาย จึงมีคนบางส่วนที่ห่างไกลจากวงโคจร",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761519
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761519,
					"content": "ดวงดาวที่เป็นตัวแทนของเธอเดินทางไปในวงโคจร จะทำให้เธอได้รับความแข็งแรง โชคดี และสงบสุข",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761520
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761520,
					"content": "แต่ในทางกลับกัน ถ้าดาวของเธออยู่ไกลจากวงโคจร ทั้งหมดก็จะเลวร้ายลง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761521
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761521,
					"content": "เพราะงั้นท้องฟ้าที่อยู่ในผลการทำนายจะไม่มีทางเป็นแบบนี้ได้เลย บางครั้งดวงดาวทั้งหลายก็หลงทาง และบางครั้งก็ตกลงมา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761522
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761522,
					"content": "...ฉันหวังว่าทุกคนจะได้รับความโชคดี และหวังว่าทุกคนจะได้เดินทางอยู่ในวงโคจร",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761523
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761523,
					"content": "ดังนั้นฉันจึงแนะนำว่าให้พูดความจริง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761524
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761524,
					"content": "ฉันรู้อยู่แล้วว่าพวกนี้มันไม่มีประโยชน์ ยังไงโชคชะตาของมนุษย์ก็จะปรากฏอยู่บนท้องฟ้ายามค่ำคืน ซึ่งฉันเองก็แค่หนึ่งในนั้น ที่ไม่อาจเปลี่ยนแปลงอะไรได้เลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761525
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761525,
					"content": "ต่อให้เป็นแบบนี้... นอกจากวิชาทำนายดวงดาวกับวาจาที่บ่งบอกถึงความเป็นจริงแล้ว ฉันก็ยังกกกอดจินตนาการถึงความเพ้อฝันที่ไม่มีทางเป็นจริงอยู่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761526
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761526,
					"content": "มนุษย์ต้องใช้ชีวิตอยู่บนความเป็นจริง แต่... ต่อให้ฉันไม่เจียมตัว ฉันก็ยังคงคาดหวังและเชื่อใน \"ปาฏิหาริย์\" อยู่ดี",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761527
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761527,
					"content": "ในทะเลแห่งดวงดาวที่กว้างใหญ่นี้มีเธอ ฉัน เขา รวมถึงดวงดาวของทุกคน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761528
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761528,
					"content": "มีกี่เปอร์เซ็นต์กันที่ดวงดาวกับดวงดาวจะโคจรมาเจอกัน? การเจอกันแบบนี้คือ \"ปาฏิหาริย์\" ที่สวยงามที่สุดในชีวิตหรือเปล่านั้น?...ฉันก็ไม่รู้เหมือนกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761529
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761529,
					"content": "แต่ในท้องฟ้าของ Teyvat จะมีตำแหน่งของเธอและฉันไปชั่วนิรันดร์ ต่อให้โหรแห่งดวงดาวจะมีเหตุผลที่แน่นอน... แต่โชคชะตากลับไม่แน่นอน ทั้งโหดร้าย และโรแมนติก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761530
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761530,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761531
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761531,
					"content": "ตั้งแต่เมื่อก่อน Mona ก็ครุ่นคิดมาตลอดสินะ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400761532
					]
				},
				{
					"id": 400761532,
					"content": "ตอนนี้เธอหาคำตอบเจอรึยังล่ะ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400761533
					]
				},
				{
					"id": 400761533,
					"content": "...ฉันว่า ฉันรู้แล้วว่าในดวงดาวพวกนั้นซ่อนอะไรเอาไว้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761534
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761534,
					"content": "...\"ตอนนี้ฉันจะคว้าโชคชะตาของตัวเองเอาไว้\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
