				"points": []
			},
			"dialogs": [
				{
					"id": 400760901,
					"content": "ว้าว! นี่ นี่...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760902
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400760902,
					"content": "บ้านใน Mondstadt อีกแล้วเหรอ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760903
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400760903,
					"content": "เจอบ้านฉันได้ไงเนี่ย...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760904
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400760904,
					"content": "บ้านเจ้า? นี่เป็นบ้านของเจ้างั้นรึ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760905
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400760905,
					"content": "โอ้ ไม่อยากจะเชื่อเลย... รู้สึกว่าข้าจะได้ยินมาว่าท่าน Megistus ใช้ชีวิตแบบขัดสนมาโดยตลอด แต่บ้านหลังนี้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760906
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400760906,
					"content": "หนังสือที่อยู่บนพื้นพวกนี้มีที่คั่นหนังสือด้วย \"มีเพียงชิ้นเดียวเท่านั้น เพียง 990000 Mora...\" หา?! แพงขนาดนี้เลยเหรอ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400760907,
					"content": "ทางนี้ยังมีหนังสือปกแข็งที่ดูแวบเดียวก็รู้ว่าแพงมากอีกหลายเล่มเลย...นี่คือห้องของโหรแห่งดวงดาวงั้นเหรอ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760908
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400760908,
					"content": "ห้องตกแต่งได้สวยหรูมาก... ที่นี่จะต้องแพงมากแน่ ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760909,
						400760910
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400760909,
					"content": "Mona รวยขนาดนี้เลยเหรอ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400760911
					]
				},
				{
					"id": 400760911,
					"content": "ฉันบอกว่า บางครั้งฉันก็แค่ไม่มีเงินสด ไม่ได้เป็นคนจนจริง ๆ สักหน่อย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760912
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400760912,
					"content": "ไม่ใช่คนจนงั้นรึ? ข้ายังเคยเลี้ยงข้าวท่าน แถมยังพาท่านไปกินข้าวที่บ้านข้าด้วย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760913
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400760913,
					"content": "คุณหนู ระวังคำพูดด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760914
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400760914,
					"content": "อะแฮ่ม! เจ้าได้รับอนุญาตให้ติดตามเจ้าหญิงผู้นี้เข้าไปยังเมืองหลวงของดินแดนแห่งราตรีบริสุทธิ์ เพื่อไปถวายบังคมพระราชา และพระราชินีแห่งการลงทัณฑ์ เรื่องใหญ่ขนาดนี้ เจ้ายังกล้าลืมได้?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760915
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400760915,
					"content": "จริงด้วย เนื้อตุ๋นกับออเดิร์ฟเนื้อเย็นที่แม่เธอทำอร่อยมากเลยนะ! อื้ม จู่ ๆ ก็อยากกินอีกสักครั้งแล้วสิ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760916
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400760916,
					"content": "ท่าน Megistus ตอนนี้ไม่ใช่เวลาพูดเรื่องนี้นะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760917
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400760917,
					"content": "อาหารของ Mondstadt เหรอ? ฉันก็อยากกินเหมือนกัน! ได้ข่าวว่า Mondstadt มีของอร่อยเพียบเลย โดยเฉพาะเนื้อสัตว์",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760918
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400760918,
					"content": "หึหึ งั้นเจ้าจะได้รับเกียรตินั้นอย่างแน่นอน เดี๋ยวพวกเจ้าจะต้องติดตามเจ้าหญิงผู้นี้ไปเข้าเฝ้าเสด็จพ่อและเสด็จแม่",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760919
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400760919,
					"content": "#จริงเหรอ? เฮ้ {NICKNAME} พวกเราก็ไปด้วยดีกว่า!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760920
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400760920,
					"content": "จะว่าไปแล้ว ก็ไม่ได้แวะไปบ้านเพื่อนมานานแล้วนะ ฉันเองก็ไม่อยากปฏิเสธเสียด้วยสิ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760921
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400760921,
					"content": "อืม แต่ควรเตรียมของติดมือไปด้วยรึเปล่านะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760922
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400760922,
					"content": "ทั้งสองท่านเป็นคนง่าย ๆ และเป็นมิตรกับทุกคน ไม่ค่อยจุกจิกเรื่องพวกนี้หรอก เชิญทุกคนตามสะดวกเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760923
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400760923,
					"content": "ถ้าได้ไปจะต้องได้กินออเดิร์ฟเนื้อเย็นนั่นแน่นอน ได้ข่าวว่าเป็นเมนูพิเศษของบ้านเธอเลยนะ อร่อยเหาะไปเลยล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760924
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400760924,
					"content": "แต่ถ้าเทียบกันแล้ว น่าจะต้องแก้ปริศนาตรงหน้าก่อนหรือเปล่า? ที่จริงตั้งแต่เข้าห้องมาจนถึงตอนนี้ ฉันติดใจของตกแต่งอันนั้นมากเลย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760925
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400760925,
					"content": "อ้ะ จริงด้วยสิ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				},
				{
					"id": 400760910,
					"content": "นี่ฉันเข้าใจผิดไปเองมาตลอดเลยเหรอเนี่ย...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400760911
					]
				}
			]
		},
