			"dialogs": [
				{
					"id": 741850301,
					"content": "ฮิฮิ \"Osse\" ต่อไปที่นี่ก็จะเป็นบ้านของแกแล้วนะ!",
					"roleType": "TALK_ROLE_NPC",
