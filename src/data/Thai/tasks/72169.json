				{
					"id": 721690201,
					"content": "เป็นไงบ้างนักเดินทาง ได้อะไรมาบ้างมั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690202
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690202,
					"content": "โอ้! Crab ตัวนี้ดูใช้ได้เลย คุณนี่เก่งไม่เบาเลยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690203
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690203,
					"content": "เอาล่ะ ในเมื่อวัตถุดิบพร้อมแล้ว งั้นก็เริ่มเตรียมตัวทำได้เลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690204
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690204,
					"content": "ฉันขอเตรียมก่อน นักเดินทาง เธอรอหน่อยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				}
			]
		},
