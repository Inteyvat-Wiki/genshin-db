					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4850301,
					"content": "ข้างหน้าเหมือนจะไม่มีทางให้ไปต่อแล้วนะ... เจ้านั่นมันไปหลบอยู่ที่ไหนกัน?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850302
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850302,
					"content": "Amber ดูตรงข้ามนั่น!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850303,
					"content": "ตื๊อไม่เลิกเลยนะ ช่วยไม่ได้... หือ? ทำไมเป็นเด็กผู้หญิง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850304
					],
					"speakerTitle": "Raptor"
				},
				{
					"id": 4850304,
					"content": "แกคือ Raptor สินะ! ตอนนี้หนีไปไหนไม่ได้แล้วล่ะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850305
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850305,
					"content": "ฮ่าฮ่าฮ่า ฉันจะหนีทำไม ในเมื่อเธอทำอะไรฉันไม่ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850306
					],
					"speakerTitle": "Raptor"
				},
				{
					"id": 4850306,
					"content": "โอ้...สูงเหมือนกันนะเนี่ย...ไปซะไกลเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850307
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850307,
					"content": "สาวน้อย เธอกลับไปดีกว่า ไปบอกให้หัวหน้ากองมาเองซะ แล้วฉันจะยอมให้จับทันทีเลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850308
					],
					"speakerTitle": "Raptor"
				},
				{
					"id": 4850308,
					"content": "นี่แกกำลังหาเรื่องหน่วยลาดตระเวนของกองอัศวินแห่ง Favonius อยู่งั้นสินะ? คอยดูตอนที่ฉันบินไปจับแกให้ดีเถอะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850309,
						4850310
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850309,
					"content": "ใจเย็นก่อนเถอะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850311
					]
				},
				{
					"id": 4850311,
					"content": "โอ้...เธอพูดถูก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850312
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850312,
					"content": "บ้าจริง เห็นอยู่ข้างหน้าแท้ ๆ ถ้าสามารถบินข้ามไปได้ก็ดีสิ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850313
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850313,
					"content": "ว่าแต่เจ้า Raptor นั่นข้ามไปได้ยังไงกันน่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850314,
						4850317,
						4850319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850314,
					"content": "หรือว่าจะมีกลไกเคลื่อนย้ายไปมา?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850315
					]
				},
				{
					"id": 4850315,
					"content": "จากที่ฉันเห็น ก็ไม่เห็นร่องรอยกลไกอะไรนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850316
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850316,
					"content": "อีกทั้งแถวแนวเขานี้ยังไม่สามารถสร้างกลไกอะไรได้ด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850322
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850322,
					"content": "แล้วเจอกันนะ สาวน้อย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850323
					],
					"speakerTitle": "Raptor"
				},
				{
					"id": 4850323,
					"content": "โอ้ว เจ้านั่นจะหนีไปแล้ว!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850324,
					"content": "จะมัวลังเลไม่ได้แล้ว นอกจาก \"การร่อนเวหา\" แล้ว ก็ไม่มีวิธีอื่นที่จะทำให้ข้ามไปได้แล้วล่ะนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850325
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850325,
					"content": "แต่ว่า...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850326,
					"content": "อย่ากังวลไป ฉันเป็นถึงแชมป์นักร่อนเวหาของ Mondstadt เชียวนะ ถ้าหาก Raptor บินข้ามไปได้ ฉันก็ต้องทำได้เหมือนกัน!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850327
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850327,
					"content": "เฮ้! อัศวินลาดตระเวน ถ้าอยากตายล่ะก็ มันจะเหมาะกับเธอกว่านี้นะถ้าจะโดดจากรูปปั้นเทพแห่งลมที่ Mondstadt โดยไม่มีเครื่องร่อนเวหา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850328,
						4850329
					],
					"speakerTitle": "Raptor"
				},
				{
					"id": 4850328,
					"content": "ฉันเข้าใจความหมายของ Amber นะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850330
					]
				},
				{
					"id": 4850330,
					"content": "#ถูกต้อง...นอกเหนือจากคำตอบของ \"การร่อนเวหา\" แล้ว {NICKNAME} เองก็เชื่อว่ามันเป็นอย่างเดียวที่สามารถทำได้แล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850331,
					"content": "#{NICKNAME} เธอยังจำหนังสือที่ฉันหยิบมาผิด... หนังสือแนะนำที่ไม่ใช่หนังสือแนะนำนั่นได้มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850332
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850332,
					"content": "\"แต่เดิมนั้นพวกนกบินไม่ได้ การบินได้คือรางวัลจากความกล้า ที่จะกระโดดจากยอดหุบเขาของพวกมัน\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850333
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850333,
					"content": "ต่อจากนี้ ขอให้พวกเธอเป็นพยาน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850334
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850334,
					"content": "สู้ ๆ นะ! อัศวินลาดตระเวน!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850335
					]
				},
				{
					"id": 4850335,
					"content": "รับทราบ! ให้เจ้านั่นมันเห็นความกล้าหาญของอัศวินลาดตระเวนหน่อย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850336
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850336,
					"content": "หยะ อย่ามาล้อเล่นนะ ตรงนี้มันบินข้ามไม่ได้! กลับไปดี ๆ เถอะน่าสาวน้อย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850337
					],
					"speakerTitle": "Raptor"
				},
				{
					"id": 4850337,
					"content": "Raptor นายคิดว่าอย่างนั้นเหรอ? ลองฟังดูดี ๆ สิ เสียงนกรอบ ๆ นี่...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850338
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850338,
					"content": "สายลมบอกว่า... บินได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850329,
					"content": "ถึงจะต้องใช้ความกล้าแบบสุด ๆ แต่นี่ไม่ใช่การฆ่าตัวตายหรอกนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850330
					]
				},
				{
					"id": 4850317,
					"content": "หรือว่าใช้เวทมนตร์ธาตุ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850318
					]
				},
				{
					"id": 4850318,
					"content": "#{NICKNAME} จิตสัมผัสธาตุของเธอเห็นอะไรบ้างมั้ย?...หืม ไม่ได้จริง ๆ ด้วย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850319,
					"content": "หรือว่าใช้ตะขอหรือหอกอะไรพวกนี้?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850320
					]
				},
				{
					"id": 4850320,
					"content": "ขนาดบินยังทำไม่ได้ ของพวกนี้ก็ช่วยอะไรไม่ได้หรอก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850321,
					"content": "พื้นดินก็ไม่ได้มีร่องรอยตะขอเกี่ยวอะไร",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850322
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850310,
					"content": "ดูรอบ ๆ ให้ดีก่อน...นี่คือสิ่งที่เธอสอนฉันเองนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850311
					]
				}
			]
		},
		{
			"id": 48506,
