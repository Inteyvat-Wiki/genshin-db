						110000513
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000513,
					"content": "อาหารที่ซับซ้อนขนาดนี้จะไปจำได้ในทีเดียวได้ไงกันเล่า...แถมกระทะกับเครื่องปรุงก็ไม่มีด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000514
					],
					"speakerTitle": "Paimon"
				},
				{
