					"nextDialogs": [
						721700705
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721700705,
					"content": "ช่างเถอะ อย่าสนใจเลย รีบไปเก็บ Seagrass กันดีกว่า",
