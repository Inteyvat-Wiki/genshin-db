					"Eide"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80120701,
					"content": "...ฮ่าฮ่า ต้องใช่แน่ ๆ ต้องเป็นแบบนั้นแน่...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120702
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80120702,
					"content": "ในที่สุดฉันก็เข้าใจ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120703
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80120703,
					"content": "(เมื่อกี้ฉัน... สลบไปงั้นเหรอ เหมือนจำได้ราง ๆ ว่า Caribert ถอดหน้ากากออก แล้วก็...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120704
					]
				},
				{
					"id": 80120704,
					"content": "อ่า เธอฟื้นแล้วเหรอ นักเดินทาง... ฉันกำลังอยากจะแบ่งปันข่าวดีนี้กับเธอพอดี!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120705
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80120705,
					"content": "โอ้ ไม่สิ... ไม่จำเป็นต้องเรียกเธอว่า \"นักเดินทาง\" อะไรนั่นอีกต่อไป ฉันจำเธอได้สักพักแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120706,
						80120707
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80120706,
					"content": "จำฉันได้?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120708
					]
				},
				{
					"id": 80120708,
					"content": "หึหึ... ฉันรู้จักเธอแต่แรกอยู่แล้ว แค่มายืนยันว่าใช่เธอจริงมั้ยก็ตอนที่เราคุยกันนี่แหละ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120709
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80120709,
					"content": "แต่ฉันไม่เคยรู้จักคุณมาก่อน...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120710
					]
				},
				{
					"id": 80120710,
					"content": "เป็นเรื่องธรรมดา เธอสูงส่งขนาดนั้น จะมารู้จักพวกเราทั้งหมดได้ยังไงกันล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120711
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80120711,
					"content": "อีกอย่าง... ฉันก็ใช้ชื่อปลอมตั้งแต่แรก Eide เป็นชื่ออดีตข้ารับใช้ของฉัน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120712
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80120712,
					"content": "และชื่อจริงของฉันคือ Chlothar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120713
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80120713,
					"content": "...Chlothar Alberich",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120714,
						80120715
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80120714,
					"content": "Alberich!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120716
					]
				},
				{
					"id": 80120716,
					"content": "เธอก็เห็นแล้วนี่ พลังแบบนั้น... พลังบนตัวของ Caribert เหมือนกับพลังของ \"คนบาป\" ที่เธอเรียกไม่มีผิด...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120717
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80120717,
					"content": "และตอนนี้ฉันค่อนข้างแน่ใจแล้วว่า... พลังนั้นคือ... \"Abyss\" สินะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120718
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80120718,
					"content": "ในที่สุดฉันก็เห็นมันกับตา...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120719,
						80120720
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80120719,
					"content": "ฉันไม่เห็นอะไรเลย...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120721
					]
				},
				{
					"id": 80120721,
					"content": "อย่ามาแส่ให้มาก!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120722
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80120722,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120723
					]
				},
				{
					"id": 80120723,
					"content": "คนบาป... คนบาป... มีแต่คนบาปเท่านั้นที่สามารถช่วยคนบาปได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120724
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80120724,
					"content": "โชคชะตาของ Caribert ไม่ควรเป็นแบบนี้ แต่ตอนนี้... เยี่ยมไปเลย เขาสามารถถักทอโชคชะตาของตัวเองใหม่อีกครั้ง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120725
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80120725,
					"content": "การถือกำเนิดขึ้นท่ามกลางความทุกข์ระทมนั่น จะทำให้เขากลายเป็น...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120726
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80120726,
					"content": "... \"เครื่องถักทอโชคชะตา\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120727
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80120727,
					"content": "(\"เครื่องถักทอโชคชะตา\"... ประโยคนี้อีกแล้ว...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120728,
						80120729
					]
				},
				{
					"id": 80120728,
					"content": "นั่นต้องเป็นของจาก Abyss แน่นอน...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120730
					]
				},
				{
					"id": 80120730,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120731
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80120731,
					"content": "ชั่วร้าย... อันตราย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120732
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80120732,
					"content": "คิดไม่ถึงเลยนะว่า เธอจะเป็นฝ่ายที่พูดแบบนี้ ปฏิเสธ Abyss งั้นเหรอ... เฮอะ น่าขัน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120733
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80120733,
					"content": "พวกเราต่างเคยเชื่อมั่นว่า เธอจะเป็นคนนำพลังและความหวังมาสู่ Khaenri'ah",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120734
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80120734,
					"content": "เพราะเธอเสมือนตัวแทนของ Abyss ประหนึ่งตัวแทนที่อยู่เหนือจินตนาการทั้งปวง อยู่เหนือความลี้ลับที่เข้าใจได้ทั้งมวล...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120735
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80120735,
					"content": "ตราบใดที่ Khaenri'ah ควบคุม Abyss ได้ ทุกอย่างก็จะอยู่ในการควบคุม!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120736
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80120736,
					"content": "พวกเราต่างโหยหาตั้งตารออนาคตนั้นซะขนาดนั้น ทุกสายตาต่างจับจ้องมองไปที่เธอแบบนั้นแท้ ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120737
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80120737,
					"content": "แล้วดูสิ... เธอนำพาอะไรมาแก่พวกเรากัน?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120738
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80120738,
					"content": "#ท่าน{M#องค์หญิง}{F#องค์ชาย}แห่ง... Khaenri'ah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Eide"
				},
				{
					"id": 80120729,
					"content": "แต่ Abyss คือสิ่งชั่วร้ายอันตราย...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120730
					]
				},
				{
					"id": 80120720,
					"content": "Caribert เป็นอะไรกันแน่?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120721
					]
				},
				{
					"id": 80120715,
					"content": "คุณคือ!?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120716
					]
				},
				{
					"id": 80120707,
					"content": "Eide คุณยังปกติดีมั้ย?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120708
					]
				}
			]
		},
