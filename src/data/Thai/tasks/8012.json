					"content": "ฉันมีเรื่อง... อยากจะเล่าให้ฟัง",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120819
					]
				},
				{
					"id": 80120819,
					"content": "...",
