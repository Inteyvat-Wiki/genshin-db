						],
						"pointId": 4592
					}
				]
			},
			"dialogs": [
				{
					"id": 740660301,
					"content": "จุดลงทะเบียนตรงเคาน์เตอร์ต้อนรับ... ตรงนี้แหละ! พวกเราไปเสี่ยงดวงกันเถอะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660302,
					"content": "สวัสดี คุณ Monglane~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660303,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660304
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660304,
					"content": "(อุ๊ย... ดูท่าทางน่าจะคุยด้วยยากแฮะ)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660305,
					"content": "(งั้นลองใช้ \"ศิลปะแห่งการเจรจา\" ดูมั้ย?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660306
					]
				},
				{
					"id": 740660306,
					"content": "(จริงด้วย ยังมีเจ้าสิ่งนี้อยู่นี่นา! นึกไม่ถึงว่าหนังสือเล่มนี้จะมีประโยชน์ตอนนี้นะเนี่ย)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660307,
					"content": "ไหนดูซิ... เจอแล้ว! \"หากคุณพูดเสียงดังแสดงความน่าเกรงขามออกมาข่มอีกฝ่ายก่อน...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660308,
					"content": "นี่แหละ! ใช้ความน่าเกรงขามข่มอีกฝ่าย! ฉันเข้าใจแล้ว! สรุปว่าแค่พูดเสียงดัง ๆ หน่อยก็พอสินะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660309,
					"content": "เฮ้... คุณ Monglane สวัสดี...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660310,
					"content": "...ได้ยินแล้ว ไม่ทราบว่าเธอต้องการความช่วยเหลือหรือเปล่า?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660311
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660311,
					"content": "เอ๋? ได้ผลจริงด้วย!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660312,
					"content": "#ฮี่ฮี่ คุณ Monglane พวกเรามาเข้าร่วมการสำรวจความพึงพอใจน่ะ! อ่า ไม่สิ ฉันมาเป็นเพื่อน{M#เขา}{F#เธอ}ต่างหาก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660313,
					"content": "#(ไม่ต้องห่วง {NICKNAME} พวกเรามีหนังสือเล่มนี้อยู่ ฉันจะแอบอ่าน แล้วเตือนเธอเอง! เอาเป็นว่า... เอ่อ! เอาเป็นว่าเธอทำตามที่ฉันบอกก็พอ)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660314,
					"content": "มาตามประกาศที่อยู่ในหนังสืองั้นเหรอ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660315
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660315,
					"content": "อ่อ! ใช่!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660316,
					"content": "สอดไว้กี่ใบกันแน่เนี่ย... ที่จริง... เฮ้อ ช่างเถอะ ไม่มีอะไรหรอก...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660317
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660317,
					"content": "อะแฮ่ม โปรดรอสักครู่... ฉันขอแนะนำกฎให้รู้ก่อน แบบสอบถามครั้งนี้มีทั้งหมด 5 คำถาม โปรดตอบคำถามตามสัญชาตญาณของเธออย่างรวดเร็ว อย่าลืมล่ะ ตอบอย่างรวดเร็วนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660318
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660318,
					"content": "เข้าใจแล้วใช่มั้ย? เธอพร้อมเมื่อไหร่ ก็เริ่มได้เลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Monglane"
				}
			]
		},
