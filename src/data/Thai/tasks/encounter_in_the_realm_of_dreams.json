			"dialogs": [
				{
					"id": 120440201,
					"content": "อืม... ฉันนึกถึงตอนที่เคยไล่ตามทานูกิที่นี่แล้ว คิดถึงจังเลยแฮะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440202,
					"content": "เอ๋? นั่นอะไรน่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440203,
						120440204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440203,
					"content": "ทานูกิ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440205
					]
				},
				{
					"id": 120440205,
					"content": "ดูยังไงก็ไม่เห็นจะเหมือนเลย? หรือว่า Inazuma จะมีโยไกตัวใหม่โผล่มาอีกแล้ว?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440206,
					"content": "อืม... หรือว่ามันอยากให้เราตามมันไป?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440204,
					"content": "หมูน้อย?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440205
					]
				}
			]
		},
