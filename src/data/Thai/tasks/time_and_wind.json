					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710122402,
					"content": "นี่เธอทำยังไงถึงเรียกเจ้านี่ออกมาได้กัน?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
