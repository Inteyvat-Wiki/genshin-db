			"dialogs": [
				{
					"id": 741500501,
					"content": "พ่อ ช่วงนี้หลับสบายดีมั้ย? ยังนอนไม่หลับอยู่อีกหรือเปล่า?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500502
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500502,
					"content": "ดีขึ้นมากแล้ว ช่วงนี้แทบจะไม่ฝันร้ายแล้วล่ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500503
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500503,
					"content": "(เสียงพูดคุยของครอบครัว Leroy ค่อย ๆ เลือนรางจนได้ยินไม่ชัด)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "เคาะหนึ่งครั้ง"
				}
			]
		},
		{
