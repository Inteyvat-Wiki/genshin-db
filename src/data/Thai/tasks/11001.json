					"nextDialogs": [
						110010425
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110010425,
					"content": "ฉันขอท้าประลองทำอาหารกับเธอ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010426
					],
					"speakerTitle": "Xiangling"
				},
				{
