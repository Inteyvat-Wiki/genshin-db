			"dialogs": [
				{
					"id": 732040701,
					"content": "อ่า ฉันยังไม่ทันได้ทำกับข้าวเลย คงไม่มีอะไรมาต้อนรับพวกเธอหรอกนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040702,
						732040703
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040702,
					"content": "ไม่จำเป็นต้องลำบาก",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040704
					]
				},
				{
					"id": 732040704,
					"content": "ยัยหนูตัวน้อยอีกคนเป็นเพื่อนของเธอใช่มั้ย น่ารักดีนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040705
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040705,
					"content": "ไว้ดอกไม้ที่ฉันปลูกบานแล้ว พวกเธอจะมาดูหน่อยมั้ยล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040706
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040706,
					"content": "โอเค",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040707
					]
				},
				{
					"id": 732040707,
					"content": "อีกสักพักดอกไม้พวกนี้ก็น่าจะบานแล้ว วันหลังพวกเธอคงกลับมากันอีกใช่มั้ย แวะมาดูดอกไม้ที่พวกเธอช่วยปลูกกันไง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040708
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040708,
					"content": "ได้นะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040709
					]
				},
				{
					"id": 732040709,
					"content": "เอาน่า ๆ ฉันเข้าใจแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040710
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040710,
					"content": "♪...",
