			"dialogs": [
				{
					"id": 732050101,
					"content": "มา มา มาดูเมล็ดพวกนี้สิ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050102
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050102,
					"content": "เหมือนไม่มีอะไรเปลี่ยนแปลงนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050103
					]
				},
				{
					"id": 732050103,
					"content": "ใช่ ถึงแม้ฉันจะทำนามานานหลายปีแล้ว แต่ปลูกดอกไม้กับทำนามันก็ไม่เหมือนกันอยู่ดี",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050104
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050104,
					"content": "ไม่อย่างงั้นทำไมตั้งนานแล้วพวกมันยังไม่ยอมงอกออกมาเลยล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050105
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050105,
					"content": "ขอดูก่อนนะ อืม...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732050106,
					"content": "คุณตา Affan สวนเพาะชำของคุณแห้งแล้งเกินไป แล้วดินที่อยู่รอบ ๆ หมู่บ้าน Aaru ก็มีสารอาหารไม่เพียงพอ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732050107,
					"content": "เราเคยช่วยคนอื่นปลูกดอกไม้ในหมู่บ้านมาก่อน เรามีประสบการณ์นะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732050108,
					"content": "อ๋อ งั้นเหรอ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050109
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050109,
					"content": "ก็มีเหตุผลนะ ดอกไม้ที่หายากแบบนี้ก็น่าจะดูแลยากกว่าดอกไม้ทั่วไปแหละ ฉันคงรดน้ำกับให้ปุ๋ยไม่พอจริง ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050110
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050110,
					"content": "แต่สวนเพาะชำแห่งนี้อยู่ไกลจากแหล่งน้ำ ไปเอาน้ำไม่ค่อยสะดวกน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050111
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050111,
					"content": "น้ำที่ฉันเก็บไว้สำหรับใช้ในชีวิตประจำวันก็ไม่ค่อยพอด้วย ถ้าต้องรดน้ำให้กับเมล็ดในสวนเพาะชำบ่อย ๆ มันก็ยุ่งยากไปหน่อย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050112
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050112,
					"content": "ฉันช่วยได้นะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050113
					]
				},
				{
					"id": 732050113,
					"content": "ดีเลย งั้นก็ฝากพวกเธอช่วยรดน้ำให้กับเมล็ดสามเม็ดนี้ด้วยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				}
			]
		},
