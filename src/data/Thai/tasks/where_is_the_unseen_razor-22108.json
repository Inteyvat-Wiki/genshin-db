			"dialogs": [
				{
					"id": 221080201,
					"content": "เธอจัดการพวกมันรึยัง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080202
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080202,
					"content": "ยังเลย",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221080203
					]
				},
				{
					"id": 221080203,
					"content": "อย่ารีบร้อนไป นักผจญภัยที่ใจไม่นิ่งน่ะมีแต่จะเอาตัวเองไปลำบากเท่านั้นแหละนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080204
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080204,
					"content": "แต่ก็อย่าช้าจนเกินไปล่ะ เพราะว่าของตอบแทนของเธอก็ขึ้นอยู่กับเวลาเหมือนกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				}
			]
		},
