						732572905
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732572905,
					"content": "อ้อ... แม้ว่าเจ้าจะลอยอยู่ก็เถอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732572906
