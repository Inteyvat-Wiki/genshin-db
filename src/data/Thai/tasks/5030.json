					"nextDialogs": [
						50300102
					],
					"speakerTitle": "Qhispe"
				},
				{
					"id": 50300102,
					"content": "ถ้ามีผู้เชี่ยวชาญก็ดีสิ... ไม่สิ ไม่ใช่เวลามาถอนหายใจนะ ฉันต้องตั้งสติหน่อยแล้ว!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qhispe"
				}
			]
		},
		{
			"id": 503002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
