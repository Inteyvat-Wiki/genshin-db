						],
						"stepId": 7310903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Javi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731090301,
					"content": "แย่ล่ะ \"กล่องความฝัน\" อันนี้ ไม่ใช่ของฉัน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090302,
						731090304
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090302,
					"content": "เราขุดพบกล่องใบนึง",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090303
					]
				},
				{
					"id": 731090303,
					"content": "ฮ่าฮ่า... ฉันก็ขุดเจอใบนึงเหมือนกัน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090305
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090305,
					"content": "ฉันได้เปิดดู \"กล่องความฝัน\" ใบนี้แล้วด้วย แผ่นกระดาษในกล่องลงชื่อของ Ami ไว้ด้วยแหละ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090306
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090306,
					"content": "ฉันจำเด็กคนนี้ได้ เขาเป็นลูกสาวของ Jahangir ชอบยืนอยู่แถวข้าง ๆ ร้านอาหารน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090307
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090307,
					"content": "เด็กคนนี้ใฝ่ฝันอยากเป็นนักจัดดอกไม้ อยากปลูกดอกไม้เยอะ ๆ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090308
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090308,
					"content": "ดูไม่ออกแฮะ ฉันก็นึกว่า Jahangir จะเลี้ยงให้เขามารับช่วงดูแลกิจการที่บ้านต่อซะอีก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090309,
						731090310
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090309,
					"content": "มาดูความฝันของคุณก่อนเถอะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090311
					]
				},
				{
					"id": 731090311,
					"content": "อ้อ! ใช่ ๆ ต้องดูความฝันของฉันก่อน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090312
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090312,
					"content": "ขอดูหน่อยนะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090313
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090313,
					"content": "\"อยากจะเป็น 'Vanara' และได้อยู่ในป่าตลอดไป...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090314
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090314,
					"content": "ความฝันสมัยเด็กของฉันเป็นแบบนี้เหรอ? ไม่รู้จริง ๆ ว่าตอนนั้นฉันคิดอะไรอยู่...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090315
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090315,
					"content": "เห้อ... เจ้าเด็กบ้า Vanara ไม่ใช่อาชีพที่จะหาเงินได้แบบสบาย ๆ หรอกนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090316,
						731090317
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090316,
					"content": "ฉันคิดว่ามันก็ไม่เห็นจะไม่ดีตรงไหนเลย",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090318
					]
				},
				{
					"id": 731090318,
					"content": "นั่นเป็นความคิดของเด็กตัวน้อย พอถึงวัยอย่างฉันแล้ว ความฝัน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090319
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090319,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090320
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090320,
					"content": "เอาเวลาไปคิดวิธีหา Mora เพิ่มดีกว่า จะได้นอนหลับสบายหน่อย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090321
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090321,
					"content": "เอาเถอะ อย่าพูดถึงความฝันน่าเบื่อ ๆ อันนั้นของฉันเลย มาอ่านของ Ami กันดีกว่า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090322
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090322,
					"content": "ฉันเปิด \"กล่องความฝัน\" ของเธอ คงต้องทำอะไรชดใช้เธอหน่อยแล้วล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090323
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090323,
					"content": "อืม... ขอคิดดูก่อนนะ ในเมื่อเธออยากเป็นนักจัดดอกไม้ งั้นก็ต้องหัดปลูกดอกไม้ก่อน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090324
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090324,
					"content": "ฉันมีกระถางดอกไม้ที่ไม่ได้ใช้พอดี เอาไปให้เธอก็ได้นี่นา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090325
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090325,
					"content": "นักเดินทาง เธอรู้มั้ยว่าจะหาเมล็ดดอกไม้ได้จากที่ไหน?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090326,
						731090327
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090326,
					"content": "ให้ฉันจัดการเอง",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090332
					]
				},
				{
					"id": 731090332,
					"content": "งั้นฝากเรื่องเมล็ดดอกไม้ด้วยนะ นักเดินทาง เดี๋ยวเราไปเจอกันด้านข้างร้านของ Jahangir ละกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090327,
					"content": "ทำไมคุณถึงต้องทำแบบนี้ด้วยล่ะ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090328
					]
				},
				{
					"id": 731090328,
					"content": "ฮ่าฮ่าฮ่า... อยู่ ๆ ก็เกิดคึกขึ้นมาน่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090329
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090329,
					"content": "ฉันคงไปแสวงหาความฝันไม่ได้อีกแล้วล่ะ เพราะอายุก็มากแล้ว อีกอย่างก็คือ... ฉันไม่ค่อยใส่ใจกับความฝันนี้แล้วด้วย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090330
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090330,
					"content": "แต่ Ami ยังเด็กอยู่ เธอยังสามารถลองทำความฝันของตัวเองให้เป็นจริงได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090331
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090331,
					"content": "ผู้ใหญ่น่าเบื่อ ๆ อย่างฉันช่วยอะไรเธอไม่ได้มาก งั้นก็ให้กระถางดอกไม้สักใบ ถือว่าเป็นการให้กำลังใจเธอละกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090332
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090317,
					"content": "ความฝันไม่แบ่งดีหรือแย่หรอกนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090318
					]
				},
				{
					"id": 731090310,
					"content": "นี่คือ \"กล่องความฝัน\" ของคุณ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090311
					]
				},
				{
					"id": 731090304,
					"content": "คุณก็ขุดเจอใบนึงด้วยเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090305
					]
				}
			]
		},
		{
