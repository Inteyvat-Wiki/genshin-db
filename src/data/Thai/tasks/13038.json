					},
					{
						"sceneId": 1091,
						"position": [
							722.837,
							94.339,
							549.55
						],
						"pointId": 20
					}
				]
			},
			"dialogs": [
				{
					"id": 130380201,
					"content": "Sethos พวกเรามาคุยกันหน่อย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380202
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380202,
					"content": "คิดถี่ถ้วนแล้วรึไง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380203
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380203,
					"content": "ก่อนจะเข้าเรื่องนั้น ฉันพอรู้เรื่องการแพทย์อยู่บ้าง ขอฉันตรวจดูอาการของ Bamoun หน่อยได้มั้ย?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380204
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380204,
					"content": "ไม่มีปัญหา แต่ในบรรดาคนของพวกเราก็มีหมออยู่ ถ้านายคิดจะเล่นลูกไม้อะไร ก็ต้องบอกเลยว่าไม่มีทาง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380205
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380205,
					"content": "ฉันแค่ต้องการคำตอบ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380206
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380206,
					"content": "ตามฉันมา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380207
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380207,
					"content": "เบา ๆ หน่อย อย่ารบกวนเขา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380208
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380208,
					"content": "Tighnari หยิบเครื่องมือตรวจที่พกติดตัวในครั้งนี้ออกมา และทำการตรวจอาการพื้นฐานให้กับ Bamoun",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130380209
					]
				},
				{
					"id": 130380209,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380210
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380210,
					"content": "พวกเราออกไปคุยกันข้างนอกเถอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380211
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380211,
					"content": "Bamoun อยู่ในอาการโคม่า สถานการณ์ไม่ค่อยดีเท่าไหร่ หมอของพวกนายต้องวินิจฉัยแบบเดียวกันแน่ ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380212
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380212,
					"content": "ตอนยังวัยรุ่นได้รับบาดเจ็บสาหัสมาก่อน ต่อมาก็ทำงานหนักจนลุกลามกลายเป็นโรค พอแก่ตัวร่างกายก็อ่อนแอลง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380213
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380213,
					"content": "ฉันเสียใจที่ต้องแจ้งให้นายรู้ว่า... อาการของเขาฉันคุ้นเคยกับมันดี ปกติคนประเภทนี้จะทนได้อีกแค่ไม่กี่วันเท่านั้น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380214
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380214,
					"content": "...เรื่องพวกนี้ฉันรู้อยู่แล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380215
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380215,
					"content": "นายเป็นผู้สืบทอดของเขาใช่มั้ย? ดูออกเลยว่านายเคารพเขา แต่ความคิดของพวกนายไม่เหมือนกันซะทีเดียว นายมีข้อกังวลมากกว่า มองความเป็นจริงมากกว่า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380216
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380216,
					"content": "บอกเงื่อนไขมาเถอะ ทำให้เรื่องนี้มันจบลงในตอนที่ Bamoun ยังมองเห็นอยู่ ฉันรู้ว่านายแคร์",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380217
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380217,
					"content": "ใช่ มีหลายเรื่องที่ไม่สามารถเลื่อนเวลาได้อีก นายน่าจะเข้าใจนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130380218,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380219
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380219,
					"content": "ที่จริงตอนนี้สถานการณ์ของพวกนายสองคนคล้ายกันมาก ต่างมีความคิดเห็นที่ต่างจากคนที่เลี้ยงดูตัวเองมา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380220
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380220,
					"content": "อีกอย่างมันเป็นความขัดแย้งของคนรุ่นอื่นแท้ ๆ แต่คนที่ต้องตัดสินใจกลับเป็นพวกนาย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130380221,
					"content": "เธอพูดถูก ในเรื่องนี้จุดยืนของทั้งสองฝ่ายเปลี่ยนไปแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380222
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380222,
					"content": "ฉันเห็นด้วย Cyno ทุกอย่างเริ่มต้นขึ้นจาก Hermanubis งั้นก็ใช้พิธีกรรมของเขาเพื่อยุติมันเถอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380223
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380223,
					"content": "ตำนานเล่าว่าเมื่อ Hermanubis เพิ่งมาถึง Tulaytullah เขาได้ประลองฝีมือกับคนอื่น เขากับคู่หูอีกสองคนต่อสู้กันติดต่อกันอยู่หลายวัน เพื่อเอาชนะใจผู้คน และดึงดูดผู้ที่มีเจตจำนงอันสูงส่งจำนวนมาก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380224
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380224,
					"content": "ต่อมาคนพวกนั้นก็กลายเป็นส่วนหนึ่งของวิหารแห่งความเงียบงัน นี่เป็นจุดเริ่มต้นของพวกเรา และเป็นพิธีกรรมของเราด้วย \"พิธีดวลศาสตรา\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380225
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380225,
					"content": "สมเหตุสมผลมาก งั้นใช้วิธีนี้เถอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380226
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380226,
					"content": "นายเองก็มีพลังแห่ง Hermanubis เหมือนกัน และมีความเกี่ยวข้องอย่างมากกับวิหารแห่งความเงียบงัน ฉันอนุญาตให้นายพาเพื่อนเข้าร่วมการประลองครั้งนี้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380227
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380227,
					"content": "สามต่อสาม ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380228
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380228,
					"content": "แต่ฉันมีเงื่อนไข พวกนายเป็นฝ่ายโจมตี จะต้องชนะสามตาติดต่อกัน และ Cyno นายกับฉันต่างก็ต้องเดิมพันด้วยเสี้ยวจิตแห่ง Ba ของตัวเอง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380229
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380229,
					"content": "การปล่อยให้ Cyrus นำเสี้ยวจิตแห่ง Ba จากไป เป็นความผิดพลาดที่ปู่เคยทำ นี่เป็นประเด็นที่วิหารแห่งความเงียบงันต้องก้าวข้ามไป จุดนี้ฉันไม่สามารถถอยให้ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380230
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380230,
					"content": "ฉันก็คิดอย่างนั้นเหมือนกัน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380231
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380231,
					"content": "ถ้าฉันชนะ วิหารแห่งความเงียบงันจะต้องปล่อยตัว Cyrus และลบล้างเรื่องราวในอดีตทั้งหมด",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380232
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380232,
					"content": "ถ้านายชนะ ฉันจะคืนพลังนี้ให้นาย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380233
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380233,
					"content": "ตกลงตามนี้ งั้นเจอกันที่โถงพิธีกรรมพรุ่งนี้ตอนสองทุ่มนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sethos"
				}
			]
		},
