	"talks": [
		{
			"id": 7104301,
			"completionStepIds": [
				7104305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710430101,
					"content": "\"...จ่าสิบเอก Anton พบระฆังขนาดใหญ่ทางทิศตะวันออกเฉียงใต้... บนกำแพงหินมีอักษรคำว่า 'พวกมัน' เขียนอยู่\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710430102
					],
					"speakerTitle": "บันทึก Fatui"
				},
				{
					"id": 710430102,
					"content": "\"...มันคล้ายกับระฆังใหญ่ที่กัปตันเห็นในซากปรักหักพังทางตะวันตกเฉียงเหนือก่อนหน้านี้ บางที...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710430103
					],
					"speakerTitle": "บันทึก Fatui"
				},
				{
					"id": 710430103,
					"content": "\"...ส่ง Snezhevna กับ Fadeyka ไปสองคน เพื่อแยกกันตีระฆังใหญ่ในซากปรักหักพังทั้งสองด้าน...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710430104
					],
					"speakerTitle": "บันทึก Fatui"
				},
				{
					"id": 710430104,
					"content": "\"...เสียงผิวปากที่น่าสะพรึงกลัวสะท้อนอยู่บนกำแพงหิน หมอกสีดำได้จางหายไปแล้ว เป็นปรากฏการณ์ที่อธิบายไม่ได้ และแปลกประหลาด... ดูเหมือนกำลังป่าวประกาศถึงการมาถึงของใครบางคน...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710430105
					],
					"speakerTitle": "บันทึก Fatui"
				},
				{
					"id": 710430105,
					"content": "\"...มีผู้เสียชีวิต 10 ราย กองหน้าทั้งสองหน่วยได้รับความเสียหายอย่างหนักหน่วง กัปตันออกคำสั่งให้ทำการล่าถอยทันที...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710430106
					],
					"speakerTitle": "บันทึก Fatui"
				},
				{
					"id": 710430106,
					"content": "(แผนที่ธรรมดาแผ่นหนึ่งหลุดออกมาจากหน้าบันทึก บนแผนที่มีเครื่องหมายระฆังขนาดใหญ่สองอัน อยู่ทางทิศตะวันตกเฉียงเหนือและทิศตะวันออกเฉียงใต้ พร้อมภาพวาดหัวกะโหลกที่เด่นสะดุดตาสองอัน)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "บันทึก Fatui"
				}
			]
		},
