			"dialogs": [
				{
					"id": 700270101,
					"content": "เธอมาพอดีเลย การซ่อม Pursina's Spike เป็นไปด้วยดีเลยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270102
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700270102,
					"content": "ขอแค่มีชิ้นส่วนพวกนี้ ฉันก็สามารถซ่อมมันได้ทันทีเลยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270103
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700270103,
					"content": "ฉันรวบรวมมาบ้างแล้วล่ะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700270104
					]
				},
				{
					"id": 700270104,
					"content": "เยี่ยมไปเลย แบบนี้ช่วยได้มากเลยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270105
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700270105,
					"content": "ขอแค่มีชิ้นส่วนพวกนี้ ฉันก็สามารถซ่อมมันได้ทันทีเลยล่ะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270106
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700270106,
					"content": "แต่ยังมีอีกเรื่องนึงที่ฉันอยากจะปรึกษาเธอก่อน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270107
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700270107,
					"content": "สองสามวันที่ผ่านมา ในระหว่างที่เธอรวบรวมชิ้นส่วนพวกนี้ ฉันได้ศึกษาโครงสร้างภายในของ Pursina's Spike อย่างละเอียด",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270108
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700270108,
					"content": "โครงสร้างของมันมหัศจรรย์มากเลย สมกับเป็นอุปกรณ์อันยอดเยี่ยมที่ผู้อาวุโส Pursina สร้างขึ้นมา",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270109
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700270109,
					"content": "การปรับแต่งเพียงเล็กน้อยอาจส่งผลต่อฟังก์ชันของอุปกรณ์ทั้งเครื่อง ฉันก็เลยกังวลอยู่ว่าการปรับแต่งมันจะให้ผลลัพธ์ที่เราคาดไว้รึเปล่า",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270110
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700270110,
					"content": "เพื่อความปลอดภัย เธอช่วยลองใช้งานมันหลาย ๆ ครั้งหน่อยได้มั้ย? ฉันจะปรับอุปกรณ์ตามข้อมูลที่ได้จากการทดลองพวกนี้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270111
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700270111,
					"content": "แบบนี้ถึงจะมั่นใจได้ว่า Pursina's Spike ทำงานได้เต็มประสิทธิภาพ ไม่งั้นถ้ามันเกิดพังขึ้นมาตอนที่เธอสู้กับ Ruin Grader โมเดลพิเศษอยู่ แบบนั้นก็ซวยแย่เลย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270112,
						700270113
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700270112,
					"content": "รอบคอบดีจังเลยนะ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700270114
					]
				},
				{
					"id": 700270114,
					"content": "นี่เป็นครั้งแรกที่ฉันใช้งาน Pursina's Spike นี่นา เราระวังไว้หน่อยก็ดี",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270115
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700270115,
					"content": "ถ้างั้นก็ช่วยทดลองหลาย ๆ รอบหน่อยนะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700270113,
					"content": "ฉันเข้าใจแล้ว",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700270114
					]
				}
			]
		}
