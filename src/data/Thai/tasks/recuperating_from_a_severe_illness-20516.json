			"dialogs": [
				{
					"id": 205160101,
					"content": "เจ้าเด็กคนนี้ วิ่งไปไหนอีกแล้ว...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160102
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160102,
					"content": "Anna ออกไปเล่นอีกแล้วเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160103
					]
				},
				{
					"id": 205160103,
					"content": "ฉันว่าแล้วไง เห็นคุณมีสีหน้าเหมือนชินแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160104
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160104,
					"content": "Anna นับวันยิ่งไม่เชื่อฟัง ฉันเผลอใจลอยแป๊บเดียว เธอก็วิ่งหายไปแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160105
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160105,
					"content": "อาการป่วยของเธอยังไม่ทันหายดี คุณช่วยไปตามหา Anna ให้ทีเถอะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160106,
						205160108,
						205160111
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160106,
					"content": "ฉันรู้แล้ว",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160107
					]
				},
				{
					"id": 205160107,
					"content": "งั้นช่วยหน่อยนะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160115
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160115,
					"content": "จริงสิ...ก่อนหน้านี้ Anna พูดอยู่ตลอดว่าเธออยากไปดูรูปปั้นของเทพแห่งลม",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160116
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160116,
					"content": "ฉันจำได้ว่า ซิสเตอร์ Grace ชอบไปอยู่ที่นั่น",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160117
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160117,
					"content": "คุณลองไปถามเธอดูก่อนเถอะ ไม่แน่ว่าเธออาจจะเห็นอะไรบ้างก็ได้...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160108,
					"content": "คุณลองหาดูรึยัง?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160109
					]
				},
				{
					"id": 205160109,
					"content": "ฉันก็ต้องหาแล้วสิ ขนาดนอกเมืองยังไปหามาแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160110
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160110,
					"content": "แต่หาไม่เจอจริง ๆ ถึงต้องมารบกวนคุณนี่ไง",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160115
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160111,
					"content": "Anna ชอบกินอะไร?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160112
					]
				},
				{
					"id": 205160112,
					"content": "อ้อ เธอชอบกิน...เฮ้ย! บอกแล้วว่าอย่าคิดว่าน้องฉันเป็นแมว!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160113
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160113,
					"content": "อีกอย่างนะ ของที่เธอชอบกินมีเยอะขนาดนั้น ฉันจะนับไหวได้ไง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160114
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160114,
					"content": "เอาเถอะ รบกวนคุณรีบไปช่วยฉันหาเถอะ ฉันรออยู่ที่นี่แหละ หาจนทั่ว ฉันเหนื่อยจะตายแล้ว...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160115
					],
					"speakerTitle": "Anthony"
				}
			]
		},
