					"Timaeus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205060101,
					"content": "สวัสดี ฉันคือนักวิจัยการเล่นแร่แปรธาตุ Timaeus ยินดีต้อนรับสู่ Mondstadt นะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060102
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060102,
					"content": "เล่นแร่แปรธาตุ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060103
					]
				},
				{
					"id": 205060103,
					"content": "เป็นความสามารถอย่างหนึ่งที่ใช้กันในสมัยโบราณนะ ตอนนี้พวกเรายังรู้เกี่ยวกับมันไม่มาก",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060104
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060104,
					"content": "รูปแบบของมันนั้นทั้งลึกลับและแปลกประหลาด แตกต่างอย่างสิ้นเชิงกับสิ่งที่พวกเรารู้ในทุกวันนี้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060105
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060105,
					"content": "ถ้าเกิดสามารถใช้วิชานี้ได้อย่างคล่องแคล่วล่ะก็ พวกเราน่าจะสร้างของที่สุดยอดมากๆขึ้นมาได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060106
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060106,
					"content": "ไอ้นั่นที่อยู่ตรงนั้นก็คือของที่คุณใช้วิชาเล่นแร่แปรธาตุสร้างขึ้นใช่มั้ย",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205060107,
					"content": "ถูกต้อง จริงสิ หรือว่าจะลองดูด้วยตัวเองหน่อยเป็นไงล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060108,
						205060109
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060108,
					"content": "ฟังดูยุ่งยากสุดๆ จะไม่เป็นไรงั้นเหรอ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060110
					]
				},
				{
					"id": 205060110,
					"content": "ไม่เป็นไร ขั้นตอนนั้นไม่ได้ยากอะไร ถ้าเธอสนใจล่ะก็ฉันสามารถสอนส่วนที่เป็นพื้นฐานให้ได้",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060111
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060111,
					"content": "สรรสร้าง",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 205060109,
					"content": "จะระเบิดมั้ยเนี่ย...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060110
					]
				}
			]
		},
		{
			"id": 2050602,
			"completionStepIds": [
				2050602
