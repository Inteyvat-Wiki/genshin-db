			"dialogs": [
				{
					"id": 742490201,
					"content": "อื้ม! ช่วงน้ำชายามบ่ายชิล ๆ แบบนี้ ไม่ว่ายังไงก็ไม่เคยเบื่อเลยจริง ๆ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490202,
						742490203
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490202,
					"content": "(ขอนั่งแบบนี้อีกสักพักละกัน)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490204
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742490204,
					"content": "อืม เวลาแห่งความสุขนี่ผ่านไปเร็วจริง ๆ นะ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490203,
					"content": "ได้เวลาจบงานเลี้ยงน้ำชาแล้ว",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490204
					],
					"speakerTitle": "Marionette"
				}
