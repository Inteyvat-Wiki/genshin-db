				]
			},
			"dialogs": [
				{
					"id": 761001601,
					"content": "...Bjorn เป็นยังไงบ้าง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001602
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761001602,
					"content": "...บาดเจ็บสาหัสมาก การโจมตีมันกะทันหันเกินไป เขาพยายามปกป้องพวกเรา... ฮือ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001603
					],
					"speakerTitle": "Egle"
				},
				{
					"id": 761001603,
					"content": "...สภาพแวดล้อมในสนามรบมันอันตรายเกินไป เขาคงทนต่อการเคลื่อนย้ายไม่ไหว เราเลยทำได้แค่ปฐมพยาบาลเบื้องต้นที่นี่ แต่ด้วยความสามารถที่พวกเรามีอยู่ตอนนี้ มันก็...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001604
					],
					"speakerTitle": "Egle"
				},
				{
					"id": 761001604,
					"content": "...หัวหน้า...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001605
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001605,
					"content": "Bjorn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001606
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761001606,
					"content": "...ขอโทษนะ... ฉันทำภารกิจไม่สำเร็จ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001607
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001607,
					"content": "นายทำได้ดีมาก! แนวรบรักษาไว้ได้แล้ว และทุกคนก็ปลอดภัยดีด้วย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001608
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761001608,
					"content": "จริงเหรอ... ฉันทำได้แล้วสินะ... ดีจัง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001609
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001609,
					"content": "อย่าเพิ่งพูดอะไรเลย พักรักษาตัวก่อน",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001610
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761001610,
					"content": "ถ้าไม่พูดตอนนี้... ต่อไปก็คงไม่มีโอกาสแล้ว...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001611
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001611,
					"content": "...นี่เป็นคำสั่งจากหัวหน้า! ฉันไม่อนุญาตให้นายพูดแบบนี้อีก! นายจะต้องไม่เป็นไร... จะต้องไม่เป็นไรแน่นอน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001612
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761001612,
					"content": "ฮึ... ได้... รับทราบ... ฉันจะไม่พูดแบบนั้นอีก...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001613
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001613,
					"content": "แต่... ถ้าฉันได้เจอ Veyde เมื่อไหร่... ก็คงพอจะมีอะไรไปรายงานเขาได้แล้วล่ะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001614
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001614,
					"content": "เมื่อก่อนเขาชอบพูดอยู่บ่อย ๆ ว่า... พวกเราผู้เฝ้าประภาคารก็เหมือนกับ Winter Icelea...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001615
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001615,
					"content": "เมื่อต้องเผชิญหน้ากับการล่าอันบ้าคลั่ง... พวกเราทุกคนต่างก็เปราะบางเหลือเกิน... ราวกับดอก Winter Icelea... ที่ร่วงโรยได้ง่ายดาย...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001616
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001616,
					"content": "แต่ว่า... ตราบใดที่ใบไม้ยังอยู่... ตราบใดที่รากยังฝังแน่นอยู่ในดิน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001617
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001617,
					"content": "พอถึงฤดูถัดไป... และฤดูต่อ ๆ ไป... ก็จะมีดอกไม้ใหม่เบ่งบานเสมอ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001618
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001618,
					"content": "พวกเราไม่มีวันแพ้หรอก... ใช่มั้ย... หัวหน้า...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001619
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001619,
					"content": "...อื้ม! เราจะไม่มีวันแพ้เด็ดขาด! ฉันจะจัดการมอนสเตอร์พวกนั้นให้สิ้นซากด้วยมือของฉันเอง!",
