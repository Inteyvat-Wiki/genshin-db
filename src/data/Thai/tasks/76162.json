			"dialogs": [
				{
					"id": 761000701,
					"content": "อย่ามาขวาง หลีกไปซะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000702
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761000702,
					"content": "ฮิฮิ... จะรีบร้อนไปไหน...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000703
					],
					"speakerTitle": "เสียงจากมอนสเตอร์"
				},
				{
					"id": 761000703,
					"content": "ยังไงพวกแก... ก็ต้องตายอยู่ดี... แค่มีบางคน... ที่ต้องไปก่อนเวลาเท่านั้นเอง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000704
					],
					"speakerTitle": "เสียงจากมอนสเตอร์"
				},
				{
					"id": 761000704,
					"content": "เขาบ่นไม่ใช่เหรอว่า... ตัวเองไม่ตายเมื่อสามปีก่อน... ตอนนี้... ฉันจะช่วยให้เขาได้อย่างสมใจอยากเอง...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000705
					],
					"speakerTitle": "เสียงจากมอนสเตอร์"
				},
				{
					"id": 761000705,
					"content": "...Bjorn? แกทำอะไรกับเขา?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000706
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761000706,
					"content": "เขาอ่อนแอเกินไปเองต่างหาก... พวกคนกระจอก... ไร้ค่า... แมลงชั้นต่ำ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000707
					],
					"speakerTitle": "เสียงจากมอนสเตอร์"
				},
				{
					"id": 761000707,
					"content": "...ตายไปก็สมควรแล้วไม่ใช่รึไง?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000708
					],
					"speakerTitle": "เสียงจากมอนสเตอร์"
				},
				{
					"id": 761000708,
					"content": "แกอย่ามาดูถูกเขานะ! เขาไม่ได้อ่อนแอเลยสักนิด!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000709
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761000709,
					"content": "อ้อ... ในสายตาแก... เขาเป็นคนที่แข็งแกร่งสินะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000710
					],
					"speakerTitle": "เสียงจากมอนสเตอร์"
				},
				{
					"id": 761000710,
					"content": "แต่ว่า... แต่ว่าคนที่แข็งแกร่งก็ตายได้เหมือนกันนี่...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000711
					],
					"speakerTitle": "เสียงจากมอนสเตอร์"
				},
				{
					"id": 761000711,
					"content": "ฉันนึกว่า... แกรู้ดีอยู่แล้วซะอีก...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000712
					],
					"speakerTitle": "เสียงจากมอนสเตอร์"
				},
				{
					"id": 761000712,
					"content": "คนที่แข็งแกร่งกว่าแก... ก็ตายกันไปหมดแล้วไม่ใช่รึไง... ไม่ว่าจะเมื่อสามปีก่อน... หรือสิบปีก่อนก็ตาม...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000713
					],
					"speakerTitle": "เสียงจากมอนสเตอร์"
				},
				{
					"id": 761000713,
					"content": "...หุบปากสกปรกของแกซะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000714
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761000714,
					"content": "ใช่สิ... ที่แท้คนอ่อนแอ... ก็มีแค่แกคนเดียวนี่นะ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000715
					],
					"speakerTitle": "เสียงจากมอนสเตอร์"
				},
				{
					"id": 761000715,
					"content": "ไม่อย่างนั้นทำไม... ทุกครั้ง... ทุกครั้งคนที่รอดชีวิตถึงมีแต่แกคนเดียวล่ะ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000716
					],
					"speakerTitle": "เสียงจากมอนสเตอร์"
				},
				{
					"id": 761000716,
					"content": "...แกหนีออกจากสนามรบล่ะสิท่า? เจ้าคนขี้ขลาดที่คอยแต่จะเอาตัวรอดอย่างไร้ศักดิ์ศรี...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000717
					],
					"speakerTitle": "เสียงจากมอนสเตอร์"
				},
				{
					"id": 761000717,
					"content": "Illuga! อย่าไปฟังมันพูดเหลวไหล!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761000718,
					"content": "เลิกพล่ามได้แล้ว มาสู้กันเลยเถอะ!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761000719
					]
				},
				{
					"id": 761000719,
					"content": "#...{NICKNAME}! เรารีบจัดการมันเลยเถอะ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				}
			]
		},
