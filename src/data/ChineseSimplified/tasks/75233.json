			"dialogs": [
				{
					"id": 752330201,
					"content": "「承载绽放刺梨的奇迹，用圣火点燃你的笑容！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330202
					],
					"speakerTitle": "练习中的演员"
				},
				{
					"id": 752330202,
					"content": "说了多少次了，喊口号的时候声音要洪亮！是点燃笑容！要有热情懂么！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330203
					],
					"speakerTitle": "「坎帕」"
				},
				{
					"id": 752330203,
					"content": "保持住这个姿势，收紧你的腰腹，别把腿放下来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330204
					],
					"speakerTitle": "「坎帕」"
				},
				{
					"id": 752330204,
					"content": "那、那个，老、老…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330205
					],
					"speakerTitle": "「希顿」"
				},
				{
					"id": 752330205,
					"content": "哦？竟然是你？好！给我站到舞台上面去！现在就去！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330206
					],
					"speakerTitle": "「坎帕」"
				},
				{
					"id": 752330206,
					"content": "呜哇！好、好凶的人，「希顿」真的没问题吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752330207,
					"content": "先静观其变。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752330208
					]
				},
				{
					"id": 752330208,
					"content": "告诉我，偶像最重要的是什么？对！是肌肉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330209
					],
					"speakerTitle": "「坎帕」"
				},
				{
					"id": 752330209,
					"content": "只有强健的肌肉才能跳好舞蹈，只有强健的肌肉才能打败所有的竞争对手！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330210
					],
					"speakerTitle": "「坎帕」"
				},
				{
					"id": 752330210,
					"content": "这、这是哪里的偶像啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752330211,
					"content": "记好了，偶像即战争，只有强者才能生存。偶像之路可是很残酷的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330212
					],
					"speakerTitle": "「坎帕」"
				},
				{
					"id": 752330212,
					"content": "欸，不是也有那种，用温柔的笑容治愈大家的偶像…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752330213,
					"content": "大错特错，那只会让喜爱偶像的人变得软弱…真正的偶像之力可是用肌肉铸就的。起舞吧！让我看看你们的偶像之力！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330214
					],
					"speakerTitle": "「坎帕」"
				},
				{
					"id": 752330214,
					"content": "我…我真的能行吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330215
					],
					"speakerTitle": "「希顿」"
				},
				{
					"id": 752330215,
					"content": "#没事的，你放心跳就好啦！我和{NICKNAME}，会在一旁支援你的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
