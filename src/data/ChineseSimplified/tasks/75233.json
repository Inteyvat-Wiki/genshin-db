			"dialogs": [
				{
					"id": 752331001,
					"content": "欢迎大家来到皮皮潘偶像大赛的决赛现场，我是本次决赛的主持人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752331002
					],
					"speakerTitle": "主持人"
				},
				{
					"id": 752331002,
					"content": "本次的决赛，想必大家都看过宣传册了，是要在舞台之上一决高下，选出最符合偶像之名的人选！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752331003
					],
					"speakerTitle": "主持人"
				},
				{
					"id": 752331003,
					"content": "那么废话不多说，请各位演员们上台！展现你们的偶像之力，直至决出那位最闪耀的冠军吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752331004
					],
					"speakerTitle": "主持人"
				},
				{
					"id": 752331004,
					"content": "闪耀吧！皮皮潘偶像！我宣布——皮皮潘偶像大赛决赛，正式开赛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752331005
					],
					"speakerTitle": "主持人"
				},
				{
					"id": 752331005,
					"content": "#终、终于…呼——{NICKNAME}，派蒙，我、我要上了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752331006
					],
					"speakerTitle": "「希顿」"
				},
				{
					"id": 752331006,
					"content": "#嗯嗯，我和{NICKNAME}会在台下给你鼓劲的！加油哦！你都这么努力了，一定会有一个好结果的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
