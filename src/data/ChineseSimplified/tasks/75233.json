			"dialogs": [
				{
					"id": 752330601,
					"content": "啊！疼疼疼！别打了别打了！都说是演戏了，怎么真的下狠手啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330602
					],
					"speakerTitle": "看起来很魁梧的人"
				},
				{
					"id": 752330602,
					"content": "不、不好意思，你们演得太逼真了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330603
					],
					"speakerTitle": "「希顿」"
				},
				{
					"id": 752330603,
					"content": "…咳，做得好！你合格了！真正的偶像就是要全力以赴，只要永远全力以赴，又何愁服务态度不行？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330604
					],
					"speakerTitle": "奥胡帝亚"
				},
				{
					"id": 752330604,
					"content": "我很感动，皮皮潘偶像就是应该是你这个样子的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330605
					],
					"speakerTitle": "奥胡帝亚"
				},
				{
					"id": 752330605,
					"content": "我已经有点搞不懂皮皮潘偶像到底是什么了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752330606,
					"content": "好！接下来只需要为演员们赔付足够的医药费，就可以获得我的证明！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330607
					],
					"speakerTitle": "奥胡帝亚"
				},
				{
					"id": 752330607,
					"content": "我也不讹你们，一个人十万，一共三十万！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330608
					],
					"speakerTitle": "奥胡帝亚"
				},
				{
					"id": 752330608,
					"content": "你们果然还是来骗钱的吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330609
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752330609,
					"content": "如此，方才能被称为…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330610
					],
					"speakerTitle": "奥胡帝亚"
				},
				{
					"id": 752330610,
					"content": "偶像才不是这样的啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330611
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752330611,
					"content": "经过一番漫长的唇枪舌剑，奥胡帝亚终于心甘情愿地自掏腰包，为演员们支付了医药费，并将证明交给了我们。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
