					}
				]
			},
			"dialogs": [
				{
					"id": 752330101,
					"content": "「承、承载绽放刺梨的奇迹，用圣火点燃你的笑容！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330102
					],
					"speakerTitle": "「希顿」"
				},
				{
					"id": 752330102,
					"content": "呜、呜哇！怪物啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752330103,
					"content": "「以悠悠度假村之名，为你献上欢迎的舞蹈，闪耀吧！皮皮潘偶像！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330104
					],
					"speakerTitle": "「希顿」"
				},
				{
					"id": 752330104,
					"content": "#要、要打过来了！{NICKNAME}，救、救命啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752330105,
					"content": "啊——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330106
					],
					"speakerTitle": "「希顿」"
				},
				{
					"id": 752330106,
					"content": "咦，它怎么自己摔倒了…喂，怪怪的家伙，你、还好吗…有、有没有摔到哪里啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752330107,
					"content": "又、又失败了，我果然还是跳不好这个舞，好羞耻…啊——好想原地消失…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330108
					],
					"speakerTitle": "「希顿」"
				},
				{
					"id": 752330108,
					"content": "那个…原、原来你刚才是在跳舞吗？要不你再跳一次试试？这次说不定会有好结果呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752330109,
					"content": "不行不行不行，我不行的，我做不到啊…果然，我还是没有办法成为皮皮潘偶像…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330110
					],
					"speakerTitle": "「希顿」"
				},
				{
					"id": 752330110,
					"content": "完了，我现在完全搞不懂它在说什么了…欸？等一下，这个是什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752330111,
					"content": "唔——《皮皮潘偶像大赛宣传册》？原来皮皮潘偶像是这个意思啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752330112,
					"content": "那、那个…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330113
					],
					"speakerTitle": "「希顿」"
				},
				{
					"id": 752330113,
					"content": "哦！我明白了，你应该是对比赛没有自信，所以想要找我们给一些建议对不对？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752330114,
					"content": "…我、我不行的，我就连在你们面前跳舞都做不好，而、而且老爹他也说我不行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330115
					],
					"speakerTitle": "「希顿」"
				},
				{
					"id": 752330115,
					"content": "老爹？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752330116,
					"content": "嗯，我的老爹也是演员，也是我的偶像！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330117
					],
					"speakerTitle": "「希顿」"
				},
				{
					"id": 752330117,
					"content": "老爹他跳舞可厉害了！还教出了特别多的优秀演员！只不过…他不愿意教我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330118
					],
					"speakerTitle": "「希顿」"
				},
				{
					"id": 752330118,
					"content": "啊？为什么啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752330119,
					"content": "他、他说——「『希顿』我在你的身上根本没有看到决心！没有决心的人是没办法跳好舞蹈的！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330120
					],
					"speakerTitle": "「希顿」"
				},
				{
					"id": 752330120,
					"content": "为了让老爹承认我，我跟他打了赌，如果我成为了皮皮潘偶像，证明了自己，他就会对我倾囊相授…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330121
					],
					"speakerTitle": "「希顿」"
				},
				{
					"id": 752330121,
					"content": "可、可是，我不仅连欢迎的舞蹈都跳不好，还出了个大丑，呜呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330122
					],
					"speakerTitle": "「希顿」"
				},
				{
					"id": 752330122,
					"content": "#别、别哭啦，你看，你不是遇到我们了吗？我和{NICKNAME}可是知名冒险家，走南闯北见得多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752330123,
					"content": "有我们的帮助，你肯定可以成为皮皮潘偶像，在老爹面前证明自己啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752330124,
					"content": "真、真的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330125,
						752330126
					],
					"speakerTitle": "「希顿」"
				},
				{
					"id": 752330125,
					"content": "既然派蒙都这么说了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752330129
					]
				},
				{
					"id": 752330129,
					"content": "好啦，打起精神来！是时候出发去获取参赛资格啦！放心，有我们在，一定会让你的老爹对你刮目相看的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752330130,
					"content": "谢、谢谢你们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「希顿」"
				},
				{
					"id": 752330126,
					"content": "嚯嚯，闪耀吧！皮皮潘偶像！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752330127
					]
				},
				{
					"id": 752330127,
					"content": "求、求求你，不要再说这句台词了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330128
					],
					"speakerTitle": "「希顿」"
				},
				{
					"id": 752330128,
					"content": "不要再打击她了啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330129
					],
					"speakerTitle": "派蒙"
				}
			]
		},
