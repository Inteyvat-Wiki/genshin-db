					"nextDialogs": [
						752330804
					],
					"speakerTitle": "约娜"
				},
				{
					"id": 752330804,
					"content": "完全明白了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330805
					],
					"speakerTitle": "「希顿」"
				},
				{
					"id": 752330805,
					"content": "别急，先实践一下看看结果…这次就尝试一个常见的关键词吧，唔，「简约」如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330806
					],
					"speakerTitle": "约娜"
				},
				{
					"id": 752330806,
					"content": "「简约」，嗯就是简单的意思吧？说到简单…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330807
					],
					"speakerTitle": "「希顿」"
				},
				{
					"id": 752330807,
					"content": "哦？「希顿」的目光锐利起来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330808
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752330808,
					"content": "我明白了！简约就是简单，简单的极致就是无！就是抛弃一切不必要的要素！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330809
					],
					"speakerTitle": "「希顿」"
				},
				{
					"id": 752330809,
					"content": "#糟糕，{NICKNAME}，我有些不好的预感…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330810
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752330810,
					"content": "喝哈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330811
					],
					"speakerTitle": "「希顿」"
				},
				{
					"id": 752330811,
					"content": "我就知道！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330812
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752330812,
					"content": "怎么样，怎么样？老师，果然，没有任何配饰就是对演出服最好的装饰！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330813
					],
					"speakerTitle": "「希顿」"
				},
				{
					"id": 752330813,
					"content": "我…嗯…你…啊，那个…算了，或许皮皮潘演员都是这样的吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330814
					],
					"speakerTitle": "约娜"
				},
				{
					"id": 752330814,
					"content": "说不定有问题的真的是我，我放弃了，你、你合格了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330815
					],
					"speakerTitle": "约娜"
				},
				{
					"id": 752330815,
					"content": "我、我好像可以理解你的感受…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
