			"dialogs": [
				{
					"id": 752330801,
					"content": "嗯，很不错！这位正在见习的演员同学，说说你的感想吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330802
					],
					"speakerTitle": "约娜"
				},
				{
					"id": 752330802,
					"content": "好、好棒！度假村的那套真的有悠悠度假村的感觉！海洋的那套，也真的很有海洋的感觉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330803
					],
					"speakerTitle": "「希顿」"
				},
				{
					"id": 752330803,
					"content": "你这感想还真挺直白的…总而言之，就是根据主题联想关键词，比如度假可能联想到休闲，海滩则会联想到炎热，明白了吗？",
