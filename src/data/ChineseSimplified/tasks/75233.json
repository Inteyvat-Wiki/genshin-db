			"dialogs": [
				{
					"id": 752330701,
					"content": "欢迎光临！哦，你们是来咨询皮皮潘偶像大赛的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330702
					],
					"speakerTitle": "约娜"
				},
				{
					"id": 752330702,
					"content": "嗯嗯，没错！没想到你一眼就看出来了！好厉害啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330703
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752330703,
					"content": "呵呵，谬赞了，作为非全日制批评家，这点眼力我还是有的。那么，我们就直接说结论吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330704
					],
					"speakerTitle": "约娜"
				},
				{
					"id": 752330704,
					"content": "金色冒险家形象分，九分！白色小精灵形象分，九分！至于皮皮潘——不及格！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330705
					],
					"speakerTitle": "约娜"
				},
				{
					"id": 752330705,
					"content": "——呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330706
					],
					"speakerTitle": "「希顿」"
				},
				{
					"id": 752330706,
					"content": "「希顿」！你还好吗？上来就这么说，你也太过分了，就算是批评家也不能这么批评人吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330707
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752330707,
					"content": "好的偶像就必须做好形象管理！通过使用配饰增强观众印象，是形象管理重要的组成部分！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330708
					],
					"speakerTitle": "约娜"
				},
				{
					"id": 752330708,
					"content": "没、没听懂…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330709
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752330709,
					"content": "就比如，温迪的琴…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752330711
					]
				},
				{
					"id": 752330711,
					"content": "哦！我听明白了！原来是这样，约娜小姐不愧是批评家呢！感觉很专业的样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330712
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752330712,
					"content": "对对对！果然嘛，我就说应该不是我的问题，我还是很专业的，是这里的人太奇怪了，",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330713
					],
					"speakerTitle": "约娜"
				},
				{
					"id": 752330713,
					"content": "为什么说起配饰首先考虑的是战斗属性啊！「装饰」就不应该「实用」吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330714
					],
					"speakerTitle": "约娜"
				},
				{
					"id": 752330714,
					"content": "可、可是，老爹说，太复杂的配饰会影响动作，无论是跳舞还是战斗都会不方便的，况且外观要有个性才行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330715
					],
					"speakerTitle": "「希顿」"
				},
				{
					"id": 752330715,
					"content": "啊，我算是明白，为什么你的演出服会这么丑了…果然都是这里的大人们的错！嗯，让我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330716
					],
					"speakerTitle": "约娜"
				},
				{
					"id": 752330716,
					"content": "金发的冒险家…看上去你的审美比较正常，不然就用我这里的装饰，向这位皮皮潘展示一下何谓真正的「搭配」吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "约娜"
				}
			]
		},
