			"dialogs": [
				{
					"id": 752330301,
					"content": "呼——还好还好，只是普通的舞蹈而已，没有出什么问题。这下想必是能安全过关了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752330302,
					"content": "哼，不要以为完成了规定中的舞蹈就可以了！舞台的高潮现在才刚刚开始呢！来吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
