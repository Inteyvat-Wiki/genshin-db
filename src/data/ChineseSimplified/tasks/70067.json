					}
				]
			},
			"dialogs": [
				{
					"id": 700671501,
					"content": "维尼皮！小右！还有劳姆希尔妲和陌生的朋友！谢谢你们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671502
					],
					"speakerTitle": "柯莎玛"
				},
				{
					"id": 700671502,
					"content": "…我是她的妹妹，彩特琳德。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671503
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 700671503,
					"content": "这样啊，你们长得真像，都是小美人啊。我叫柯莎玛。我来自树…啊，我想说什么来着。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671504
					],
					"speakerTitle": "柯莎玛"
				},
				{
					"id": 700671504,
					"content": "这样啊，你们长得真像，都是小美人啊。我叫柯莎玛。我来自大慈树王的时代。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671505
					],
					"speakerTitle": "柯莎玛"
				},
				{
					"id": 700671505,
					"content": "草神大人还没变小的时代。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671506
					],
					"speakerTitle": "柯莎玛"
				},
				{
					"id": 700671506,
					"content": "维尼皮和柯莎玛介绍了你们一行人，并且还说了维特鲁威的悲惨遭遇…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						700671507
					]
				},
				{
					"id": 700671507,
					"content": "以及他想了数千年或许上万年的墓志铭。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						700671508
					]
				},
				{
					"id": 700671508,
					"content": "笑死我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671509
					],
					"speakerTitle": "柯莎玛"
				},
				{
					"id": 700671509,
					"content": "我没和你说过，你什么都不知道啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671510
					],
					"speakerTitle": "维尼皮"
				},
				{
					"id": 700671510,
					"content": "可能很难瞒住，以后的日子里我看到维特鲁威就会想笑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671511
					],
					"speakerTitle": "柯莎玛"
				},
				{
					"id": 700671511,
					"content": "好了，闲话不多说了。我们一路走来，好像也没漏什么地方了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671512
					],
					"speakerTitle": "维尼皮"
				},
				{
					"id": 700671512,
					"content": "还有其他人吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671513
					],
					"speakerTitle": "维尼皮"
				},
				{
					"id": 700671513,
					"content": "恐怕已经没有了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671514
					],
					"speakerTitle": "柯莎玛"
				},
				{
					"id": 700671514,
					"content": "那解除这个区域沙化的方法呢，你有什么头绪吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671515
					],
					"speakerTitle": "维尼皮"
				},
				{
					"id": 700671515,
					"content": "我们之前的探索并没有什么收获。毕竟「沙上楼阁」的各位也不精通密仪与科学。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671516
					],
					"speakerTitle": "柯莎玛"
				},
				{
					"id": 700671516,
					"content": "所以还是只有众所周知的第一种方法，也就是打败「蛾摩拉的处罚者」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671517
					],
					"speakerTitle": "柯莎玛"
				},
				{
					"id": 700671517,
					"content": "#不必担心，我们有雷穆利亚副军团长级别战斗力的{NICKNAME}在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671518
					],
					"speakerTitle": "维尼皮"
				},
				{
					"id": 700671518,
					"content": "啊，又升级了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671519
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 700671519,
					"content": "但是「蛾摩拉的处罚者」隐藏了身形，我们找不到它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671520
					],
					"speakerTitle": "柯莎玛"
				},
				{
					"id": 700671520,
					"content": "这倒是个问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671521
					],
					"speakerTitle": "维尼皮"
				},
				{
					"id": 700671521,
					"content": "既然好不容易把你们救出来了，要不先逃离这里，回到主殿里吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671522
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700671522,
					"content": "那里还有伊斯托利亚和乔瑟夫斯。他们看起来懂很多的样子，说不定有办法呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671523
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700671523,
					"content": "哦，伊斯托利亚没事啊。那太好了。他可是资历最老的人了，而且很好学。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671524
					],
					"speakerTitle": "柯莎玛"
				},
				{
					"id": 700671524,
					"content": "他在见闻、历史、文化方面，大概能算是全世界最博学的人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671525
					],
					"speakerTitle": "柯莎玛"
				},
				{
					"id": 700671525,
					"content": "那赶紧走吧。早点回去问清楚，早点把维特鲁威和大家救出来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "维尼皮"
				}
			]
		}
	]
}