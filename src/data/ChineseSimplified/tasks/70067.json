			"dialogs": [
				{
					"id": 700670701,
					"content": "呼，真厉害啊。至少顶级百夫长级实力起步了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670702
					],
					"speakerTitle": "维尼皮"
				},
				{
					"id": 700670702,
					"content": "你们赤王时代没有自己的体系吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700670703
					]
				},
				{
					"id": 700670703,
					"content": "主要是因为大方广书阁的那些文化人看过的书多，排出来的战斗力更有理有据。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670704
					],
					"speakerTitle": "维尼皮"
				},
				{
					"id": 700670704,
					"content": "有文化就是好啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670705
					],
					"speakerTitle": "维尼皮"
				},
				{
					"id": 700670705,
					"content": "你知道吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670706
					],
					"speakerTitle": "维尼皮"
				},
				{
					"id": 700670706,
					"content": "伊黎耶手下的骑士们平均能打三个标准雷穆利亚百夫长，但是都比伊黎耶低半级。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670707
					],
					"speakerTitle": "维尼皮"
				},
				{
					"id": 700670707,
					"content": "鳄之王手下的梅德佳都不算精锐部队，但是擅长处理魔兽。实力大概在…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670708
					],
					"speakerTitle": "维尼皮"
				},
				{
					"id": 700670708,
					"content": "好了好了，我们还是先去救你的朋友们吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670709
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700670709,
					"content": "可是我还想听。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700670710
					]
				},
				{
					"id": 700670710,
					"content": "之后再说啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
