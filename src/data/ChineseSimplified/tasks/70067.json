						],
						"pointId": 164
					}
				]
			},
			"dialogs": [
				{
					"id": 700670201,
					"content": "伊斯托利亚，你来啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700670202,
					"content": "嗯，「沙上楼阁」的诸位回到主殿了。所以我就一路小跑来这里了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670203
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 700670203,
					"content": "彩特琳德，你找回你丢失的东西了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670204
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 700670204,
					"content": "劳您挂心，我已经找回来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670205
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 700670205,
					"content": "那太好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670206
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 700670206,
					"content": "说来，你们知道梅兰塔和尼西里塔名字的意思吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670207
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 700670207,
					"content": "我先来，不知道！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700670208,
					"content": "是，「忧郁」和「虚无」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670209
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 700670209,
					"content": "你看的书很多啊。我能和你成为比和你姐姐更要好的朋友，因为兴趣一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670210
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 700670210,
					"content": "是的，姐姐是外向的户外派。不过我不认字的时候，她给我读过很多故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670211
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 700670211,
					"content": "这样的人是怎么被忧郁缠上的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670212
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 700670212,
					"content": "当然，我说的是病理上的忧郁，不是上面那位俯瞰着我们苦难的守望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670213
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 700670213,
					"content": "…她这些都和你说了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670214
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 700670214,
					"content": "她和我说了之后我惊得下巴都掉了。如今的人们居然敢在空之神殿离地升天的遗址上修疗养院。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670215
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 700670215,
					"content": "你知道吗，最早，人们认为忧郁是生理上的病变。忧郁的词源是黑之胆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670216
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 700670216,
					"content": "但随后，忧郁被认为是心因的心理疾病。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670217
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 700670217,
					"content": "正确的认识总是需要发展的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700670218,
					"content": "但现在，人们再度发现了忧郁的真实。它其实也是病变哦。药物和陪伴都是不可或缺的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670219
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 700670219,
					"content": "而我那个时代，早就知道了这一切。都是天使们直接告诉我们的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670220
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 700670220,
					"content": "天使与后世风神的诗歌可以治疗忧郁，不代表一般人不痛不痒的安慰也可以。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670221
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 700670221,
					"content": "您想说什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670222
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 700670222,
					"content": "这个事情是秘密哦。我得小声点说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670223
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 700670223,
					"content": "为什么执掌着天空与空间力量的伟大神明，会用虚无与忧郁作为造物的名字呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670224
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 700670224,
					"content": "据说是因为她缺乏共情能力。她无所不能，却对真正的无意徒劳以及人心之病束手无策。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670225
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 700670225,
					"content": "所以她用这两个她最不擅长对付的事物作为造物的名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670226
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 700670226,
					"content": "好像可以理解她。不可战胜的宿敌名字听起来会很帅很强大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670227
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700670227,
					"content": "#派蒙的宿敌叫做「没摩拉」和「肚子饿」和「没有{NICKNAME}」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670228
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700670228,
					"content": "听起来很弱。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700670229
					]
				},
				{
					"id": 700670229,
					"content": "我跟不上您上千年的智慧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670230
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 700670230,
					"content": "哈哈哈，哪有什么智慧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670231
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 700670231,
					"content": "我祈祷我有勇气可以放弃这一切，去换再活一次的机会。你明白吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670232
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 700670232,
					"content": "如果你需要帮助，请来找我吧。哪怕是，聊聊你姐姐的故事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670233
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 700670233,
					"content": "我…我会的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "彩特琳德"
				}
			]
		},
