			"dialogs": [
				{
					"id": 700671001,
					"content": "维尼皮！你还活着，太好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671002
					],
					"speakerTitle": "维特鲁威"
				},
				{
					"id": 700671002,
					"content": "当然我知道这里死不掉。我意思是你没有变成沙子，这实在太好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671003
					],
					"speakerTitle": "维特鲁威"
				},
				{
					"id": 700671003,
					"content": "总之，你懂我意思就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671004
					],
					"speakerTitle": "维特鲁威"
				},
				{
					"id": 700671004,
					"content": "我懂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671005
					],
					"speakerTitle": "维尼皮"
				},
				{
					"id": 700671005,
					"content": "还有你们几位和小右，十分感谢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671006
					],
					"speakerTitle": "维特鲁威"
				},
				{
					"id": 700671006,
					"content": "我什么都没做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671007
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 700671007,
					"content": "维尼皮和维特鲁威介绍了一下你们，并且说了刚才发生的事情…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						700671008
					]
				},
				{
					"id": 700671008,
					"content": "竟然是标准首席百夫长以上的实力！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671009
					],
					"speakerTitle": "维特鲁威"
				},
				{
					"id": 700671009,
					"content": "连我也开始对你战斗力的定级最终会是什么结果感兴趣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671010
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700671010,
					"content": "是吧是吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700671011
					]
				},
				{
					"id": 700671011,
					"content": "那既然这样，我来带你们去找其他人吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671012
					],
					"speakerTitle": "维特鲁威"
				},
				{
					"id": 700671012,
					"content": "毕竟维尼皮只提供了赤王时代的建筑的纹样与装饰风格。这附近的大结构和路线是我负责的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671013
					],
					"speakerTitle": "维特鲁威"
				},
				{
					"id": 700671013,
					"content": "没错，虽然看起来像是镀金时代的建筑，其实它集结了所有人的知识。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "维尼皮"
				}
			]
		},
