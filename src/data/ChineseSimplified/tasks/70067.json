					},
					{
						"sceneId": 103,
						"position": [
							780.915,
							169.73,
							357.299
						],
						"pointId": 99
					}
				]
			},
			"dialogs": [
				{
					"id": 700670401,
					"content": "你们…没见过啊。这个时候还会有新人上来吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670402
					],
					"speakerTitle": "维尼皮"
				},
				{
					"id": 700670402,
					"content": "不过小右和你们在一起，应该是救兵吧。我叫维尼皮，来自赤王的神躯仍在的时代。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670403
					],
					"speakerTitle": "维尼皮"
				},
				{
					"id": 700670403,
					"content": "#我叫派蒙，这位是{NICKNAME}。还有一位是彩特琳德。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700670404,
					"content": "我们，大概算是最近时代的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700670405,
					"content": "彩特琳德…你是不是有个姐姐？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670406
					],
					"speakerTitle": "维尼皮"
				},
				{
					"id": 700670406,
					"content": "你也认识我姐姐吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670407
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 700670407,
					"content": "那是自然，来到了这里，所有人和所有人都是朋友。不论之前的贤愚贵贱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670408
					],
					"speakerTitle": "维尼皮"
				},
				{
					"id": 700670408,
					"content": "我之前只是修筑赤王陵的建筑工，不过是个无足轻重小人物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670409
					],
					"speakerTitle": "维尼皮"
				},
				{
					"id": 700670409,
					"content": "那天我在沙漠里行路，突然就被提选了上来，丢进无想之间里待了…可能不到一百年？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670410
					],
					"speakerTitle": "维尼皮"
				},
				{
					"id": 700670410,
					"content": "出来之后发现这里都是些古代人物，有的比赤王还要古老。但是我们一样可以交流。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670411
					],
					"speakerTitle": "维尼皮"
				},
				{
					"id": 700670411,
					"content": "后来此处神明的姐妹和我说，没有提选沙漠的建筑，让我凭借记忆复原。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670412
					],
					"speakerTitle": "维尼皮"
				},
				{
					"id": 700670412,
					"content": "还是靠大家帮忙才把这一片区域修出来的。可如今，你看看这断壁残垣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670413
					],
					"speakerTitle": "维尼皮"
				},
				{
					"id": 700670413,
					"content": "说到这个，我想问了。外面那些人形沙雕，是你们赤王时代的…呃…艺术吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700670414,
					"content": "比如用沙做成人，来警醒人物质身躯与生命之无常？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670415
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 700670415,
					"content": "…你和你姐姐真是完全不像。你一定和其他人一样很喜欢看书吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670416
					],
					"speakerTitle": "维尼皮"
				},
				{
					"id": 700670416,
					"content": "那些是人。被惩罚而化成沙的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670417
					],
					"speakerTitle": "维尼皮"
				},
				{
					"id": 700670417,
					"content": "呜啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670418
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700670418,
					"content": "你放心，大家都还活着。这里不存在「死亡」。只要解决了这里的问题，他们都会复原的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670419
					],
					"speakerTitle": "维尼皮"
				},
				{
					"id": 700670419,
					"content": "哦对了，之前听到你说谁救了你，你就把赤王亲赏的钱币给他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670420
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700670420,
					"content": "一定是值不少钱的文物吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670421
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700670421,
					"content": "哈哈，不给！那是我的幸运护符！还是我在地上生活的唯一纪念。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670422
					],
					"speakerTitle": "维尼皮"
				},
				{
					"id": 700670422,
					"content": "哼，既然这么重要，我们就大发慈悲不收你这个报酬了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670423
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700670423,
					"content": "不对，好像它找上门来了！我们闲聊太久了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670424
					],
					"speakerTitle": "维尼皮"
				},
				{
					"id": 700670424,
					"content": "所以现在也不是说闲话的时候了。你有没有雷穆利亚入门级百夫长实力？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670425
					],
					"speakerTitle": "维尼皮"
				},
				{
					"id": 700670425,
					"content": "又听到这个说法了，所以究竟是什么标准啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
