				"points": []
			},
			"dialogs": [
				{
					"id": 732562301,
					"content": "尊使大人，还有尊使的谒颂主，恐怕我只能陪你们到这里了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562302
					],
					"speakerTitle": "那先朱那"
				},
				{
					"id": 732562302,
					"content": "又怎么了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732562303
					]
				},
				{
					"id": 732562303,
					"content": "按照文献中的记载，接下来的路途充满凶险，并非本人的凡人之躯所能承受。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562304
					],
					"speakerTitle": "那先朱那"
				},
				{
					"id": 732562304,
					"content": "从这里进去便是古时荼诃人用来试验机关性能的试验场，其中还有一架未完成的实验型的巨型机关。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562305
					],
					"speakerTitle": "那先朱那"
				},
				{
					"id": 732562305,
					"content": "根据笔记中所抄录的荼诃人的记录，虽然没有发挥什么作用，但这里曾被改造为狙击魔物的防御工事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562306
					],
					"speakerTitle": "那先朱那"
				},
				{
					"id": 732562306,
					"content": "很奇怪不是吗，明明是引发了污秽灾厄的荼诃人，却建造了对抗魔物的机关。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562307
					],
					"speakerTitle": "那先朱那"
				},
				{
					"id": 732562307,
					"content": "不过既然我们现在已经启动了整座遗迹的控制系统，想必这个试验场里面的防御机关也被启动了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562308
					],
					"speakerTitle": "那先朱那"
				},
				{
					"id": 732562308,
					"content": "而我们要找的灵光绝唱，应该就藏在里面的巨像当中。虽然使我望而却步，但对于诸位来说，必定是小菜一碟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562309
					],
					"speakerTitle": "那先朱那"
				},
				{
					"id": 732562309,
					"content": "为了能够集齐全部的灵光绝唱，请允许我暂且在此等候诸位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562310
					],
					"speakerTitle": "那先朱那"
				},
				{
					"id": 732562310,
					"content": "毕竟你也不过是区区人类，这样的请求也算是合情合理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562311
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732562311,
					"content": "蒙您恩许。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562312
					],
					"speakerTitle": "那先朱那"
				},
				{
					"id": 732562312,
					"content": "虽然那先朱那又临阵脱逃了，不过反正你们两个不凑在一块我也感觉轻松很多啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
