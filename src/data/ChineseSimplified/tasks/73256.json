			"dialogs": [
				{
					"id": 732562001,
					"content": "地上出现了一台奇怪的大炮，意思是说要让我们射击那边的大机器人吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562002
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732562002,
					"content": "唔…还真是贴心的设计呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562003
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732562003,
					"content": "白飘飘的想象力还真是够丰富的，刚才「纳苏勒阿」不是说过，这里是由试验机关性能的试验场改造而来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562004
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732562004,
					"content": "想必我们刚才解开的装置，便是用来启动这个试验场的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562005
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732562005,
					"content": "虽然经过了改造，但原本的机关也并未来得及拆卸，可以说是帮了我们大忙呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562006
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732562006,
					"content": "那么，我的谒颂主，操作这台大炮的任务可就交给你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "斯露莎"
				}
			]
		},
		{
