			"dialogs": [
				{
					"id": 110040301,
					"content": "急冻树，急冻树，好吃的~急冻树~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040302
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110040302,
					"content": "急冻树~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040303,
						110040305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110040303,
					"content": "你太捧场了吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110040304
					]
				},
				{
					"id": 110040304,
					"content": "那是你太拘谨了！拿到珍稀的食材，这世界上还会有比这更开心的事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040307
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110040307,
					"content": "啊，这边好像还有什么东西！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040308
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110040308,
					"content": "这就是猎人先生说的他在追的野猪吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110040309,
					"content": "但这种花纹从来没有见过…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110040310,
					"content": "我好像见过这个纹路！我想想，我想想…啊对了，是《璃月风物志》！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040311
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110040311,
					"content": "这种花纹…嗯，不会错的！这是已经灭绝了三百多年的野猪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040312
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110040312,
					"content": "欸？！这么长时间，但为什么会还活着？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040313,
						110040315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110040313,
					"content": "因为被冻住了吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110040314
					]
				},
				{
					"id": 110040314,
					"content": "有道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110040317,
					"content": "书里讲过，这种野猪就是因为肉质太鲜美，所以被捕杀灭绝了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040318
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110040318,
					"content": "急冻树和野猪，捡到两个宝贝了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040319
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110040319,
					"content": "这下胜券在握了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110040320
					]
				},
				{
					"id": 110040320,
					"content": "嗯，我们这就回清泉镇吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "香菱"
				},
				{
					"id": 110040315,
					"content": "因为比较长寿？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110040316
					]
				},
				{
					"id": 110040316,
					"content": "那也太长寿了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110040305,
					"content": "急冻树~",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110040306
					]
				},
				{
					"id": 110040306,
					"content": "哈哈哈，为什么你们唱出来就怪怪的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040307
					],
					"speakerTitle": "香菱"
				}
			]
		}
	]
