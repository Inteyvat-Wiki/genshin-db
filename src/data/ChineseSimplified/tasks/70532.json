			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"弗丽德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705320101,
					"content": "嗯…还要加入这张牌…咦？还有几张牌呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705320102
					],
					"speakerTitle": "弗丽德"
				},
				{
					"id": 705320102,
					"content": "咦？旅行者！抱歉抱歉，我刚才在想牌组的事，没注意到你过来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705320103
					],
					"speakerTitle": "弗丽德"
				},
				{
					"id": 705320103,
					"content": "我是由冒险家协会委派来协办「召唤王大奖赛」的冒险家，我这边负责的是…嗯…一种有着特殊规则的卡牌对决！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705320104
					],
					"speakerTitle": "弗丽德"
				},
				{
					"id": 705320104,
					"content": "我们把它取名为「零时召唤」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705320105,
						705320106
					],
					"speakerTitle": "弗丽德"
				},
				{
					"id": 705320105,
					"content": "结果就是普通的打牌吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705320107
					]
				},
				{
					"id": 705320107,
					"content": "不不不，我们「零时召唤」属于坊间比赛，有一套特别的规则。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705320108
					],
					"speakerTitle": "弗丽德"
				},
				{
					"id": 705320108,
					"content": "简单来说就是，参赛者不能使用自己收藏的卡牌，而是要从我们已经准备好的八套不完整卡牌组中挑选三套，组成一套完整的牌组。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705320109
					],
					"speakerTitle": "弗丽德"
				},
				{
					"id": 705320109,
					"content": "在这三组套牌中，还有一些刚刚推出的全新卡牌，至于如何使用它们…就看你打牌的本事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705320110
					],
					"speakerTitle": "弗丽德"
				},
				{
					"id": 705320110,
					"content": "除了这些之外，其他的规则就和正常的对局没什么区别啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705320111
					],
					"speakerTitle": "弗丽德"
				},
				{
					"id": 705320111,
					"content": "要是你觉得自己没有什么靠谱的组牌思路，我们也可以帮你组建牌组…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705320112
					],
					"speakerTitle": "弗丽德"
				},
				{
					"id": 705320112,
					"content": "但是组出来的牌组究竟好不好用嘛…嘿嘿，那就不知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705320113
					],
					"speakerTitle": "弗丽德"
				},
				{
					"id": 705320113,
					"content": "总之，我的建议还是由你自己来挑选并组建牌组啦，毕竟你可是要拿着这套牌去和人对决的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705320114
					],
					"speakerTitle": "弗丽德"
				},
				{
					"id": 705320114,
					"content": "如果您对自己的实力有信心，甚至可以去其他的「召唤王大奖赛」举办区域，继续玩「零时召唤」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705320115
					],
					"speakerTitle": "弗丽德"
				},
				{
					"id": 705320115,
					"content": "啊，当然啦，你也不用有什么心理负担，只要参加「零时召唤」，无论对局的结果是胜是负，我们都有好礼相赠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705320116
					],
					"speakerTitle": "弗丽德"
				},
				{
					"id": 705320116,
					"content": "旅行者，要是你有兴趣的话，就来体验一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "弗丽德"
				},
				{
					"id": 705320106,
					"content": "和「召唤王大奖赛」的感觉一样嘛…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705320107
					]
				}
			]
		}
	]
}