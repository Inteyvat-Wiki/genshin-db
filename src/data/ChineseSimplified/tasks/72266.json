			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"百代",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722661601,
					"content": "#{NICKNAME}，派蒙，你们来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661602
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722661602,
					"content": "百代小姐，你还好吗？呀，你受了好多伤！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661603
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722661603,
					"content": "#别大惊小怪的，这点小伤算不了什么。{NICKNAME}，麻烦你扶我一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661604
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722661604,
					"content": "你还说自己没事！你看你现在都需要别人扶着才能走了…咦，不对，百代小姐，你为什么不看我们？你的眼睛怎么了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722661605,
					"content": "哦，我去拿装元素粉末的盒子时，盒子被愚人众开枪打碎了。有些粉末进到眼睛里了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661606
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722661606,
					"content": "你之前说过元素粉末是有毒的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661607
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722661607,
					"content": "嚷嚷什么，应该还不至于两只眼睛都废掉。不过这里太黑了，我暂时还看不见东西，我们先到外面去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "百代"
				}
			]
		},
		{
			"id": 7226617,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
