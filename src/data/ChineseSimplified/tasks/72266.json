			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"百代",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722660901,
					"content": "你们来啦。怎么样？那个愚人众小姑娘应该已经放心了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660902
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660902,
					"content": "把柳达希卡留下的信和钱交给百代。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722660903
					]
				},
				{
					"id": 722660903,
					"content": "哈？她留下这些东西之后就走了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660904
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660904,
					"content": "现在看来是这样的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660905
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722660905,
					"content": "啧，真是的，什么「都是我的过错，害得百代小姐失去了眼睛」。一派胡言，我的眼睛又不是她弄瞎的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660906
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660906,
					"content": "真要说的话，这算是工伤？要给钱也应该是终末番给才对吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660907
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660907,
					"content": "总之，我不要她的钱。这些钱，你们爱怎么办就怎么办吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660908
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660908,
					"content": "就算你这样说，这些钱我也不知道该不该要…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660909
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722660909,
					"content": "派蒙竟然会纠结钱的问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722660910
					]
				},
				{
					"id": 722660910,
					"content": "喂，不要说得我好像是个见钱眼开的家伙一样！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660911
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722660911,
					"content": "再说了，离开稻妻之后，柳达希卡小姐会去哪里？她能找到属于自己的生活和快乐吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660912
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722660912,
					"content": "哦对了，我想起来一件事。我现在这个样子，是不可能继续回神社了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660913
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660913,
					"content": "刚才宫司大人跟我说，她觉得之前那个冒牌货就挺不错的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660914
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660914,
					"content": "呵呵，要是宫司大人知道是你们把她给弄没了，应该会让你们好看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660915
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660915,
					"content": "欸，怎么就变成我们的责任了呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660916
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722660916,
					"content": "怎么不是你们的责任？当然是因为你们没拦住她，才让她从稻妻跑了呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660917
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660917,
					"content": "啊，我明白了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660918
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722660918,
					"content": "谢谢你，百代小姐。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722660919
					]
				},
				{
					"id": 722660919,
					"content": "她应该会从离岛想办法离开稻妻，你们去那里找她吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660920
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660920,
					"content": "等你把她带回来，如果她愿意的话，就继续用「玄冬林檎」这个名字好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660921
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660921,
					"content": "虽然是我当时随便给自己起的假名，但没想到和她的身份还挺契合的，不是吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660922
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660922,
					"content": "快去吧，她的事就交给你们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660923
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660923,
					"content": "#{NICKNAME}，我们快去离岛的港口，把柳达希卡小姐追回来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
