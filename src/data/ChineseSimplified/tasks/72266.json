			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"百代",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722660601,
					"content": "呼…牢房里的霉味真要命，现在可算能好好呼吸了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660602
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660602,
					"content": "百代小姐，你的眼睛怎么样了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660603
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722660603,
					"content": "放心吧，这只眼睛的视力已经恢复了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660604
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660604,
					"content": "可是，另一只眼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722660605
					]
				},
				{
					"id": 722660605,
					"content": "你看看你们两个，愁眉苦脸像什么样子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660606
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660606,
					"content": "开心点！一只眼睛的代价，就骗了他们所有人，还顺便把愚人众的据点给端了，这不是超划算的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660607
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660607,
					"content": "呵呵呵，那个「老师」可是对我的手艺深信不疑啊。你们要救的那个愚人众小姑娘，今后就再也不用提心吊胆过日子了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660608
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660608,
					"content": "百代小姐，难道说你是为了让他们相信柳达希卡死了，才没有从安全屋逃走吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660609
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722660609,
					"content": "毕竟是答应了你们的事情。而且如果最后关头出岔子被敌人识破，之前的努力就白费了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660610
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660610,
					"content": "再说了，我相信你们肯定会来救我的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660611
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660611,
					"content": "我被抓这件事发生得很突然，很快还有海祇岛的任务，来不及写书面报告了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660612
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660612,
					"content": "我现在要去趟鸣神大社，找个人帮忙向终末番传话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660613
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660613,
					"content": "你们也去告诉柳达希卡，说她现在已经安全了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660614
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660614,
					"content": "好，我们现在就去！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
