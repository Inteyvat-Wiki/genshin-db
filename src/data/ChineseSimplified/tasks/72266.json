			"dialogs": [
				{
					"id": 722660801,
					"content": "你们找我有事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660802
					],
					"speakerTitle": "荒谷"
				},
				{
					"id": 722660802,
					"content": "你好，我们想打听一个人。这几天在这里做校对的那位小姐她去了哪里？我们是她的朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660803
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722660803,
					"content": "#哦，你们就是{NICKNAME}和派蒙吧，远山小姐和我说过你们会来找她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660804
					],
					"speakerTitle": "荒谷"
				},
				{
					"id": 722660804,
					"content": "（远山小姐？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660805
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722660805,
					"content": "（应该是柳达希卡小姐的假名。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722660806
					]
				},
				{
					"id": 722660806,
					"content": "昨天她告诉我，因为家里突然有急事，她不能继续进行校对工作了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660807
					],
					"speakerTitle": "荒谷"
				},
				{
					"id": 722660807,
					"content": "太可惜了！像她那样又麻利又认真的校对员可不多见，我还想游说她不要做兼职了，来当我们八重堂的正式员工呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660808
					],
					"speakerTitle": "荒谷"
				},
				{
					"id": 722660808,
					"content": "对了，这些东西是她走之前让我转交给你们的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660809
					],
					"speakerTitle": "荒谷"
				},
				{
					"id": 722660809,
					"content": "她给我们留了封信！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660810
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722660810,
					"content": "柳达希卡小姐…她走了。她还说，要把这些钱给百代小姐和我们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660811
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722660811,
					"content": "这样真的好吗…我们去问问百代小姐吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7226609,
			"completionStepIds": [
				7226609
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7226608",
							"3"
						],
						"stepId": 7226608,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7226609",
							"2"
						],
						"stepId": 7226609,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
