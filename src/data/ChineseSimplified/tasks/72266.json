			},
			"dialogs": [
				{
					"id": 722661001,
					"content": "柳达希卡小姐！可算找到你了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661002
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722661002,
					"content": "#{NICKNAME}和派蒙…你们怎么来了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661003
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722661003,
					"content": "我们是来劝你回去的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722661004
					]
				},
				{
					"id": 722661004,
					"content": "没错，不仅百代小姐不要你的钱，我们也不要！柳达希卡小姐，你就用这些钱在稻妻重新开始生活吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661005
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722661005,
					"content": "你们…你们在说什么呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661006
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722661006,
					"content": "我之前不仅是危害稻妻的愚人众，而且还给大家添了那么多麻烦…不管怎么说，我都没有资格继续留在这里了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661007
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722661007,
					"content": "再说了，即使你们希望我留下，其他人…他们又是怎么想的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661008
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722661008,
					"content": "或许这片土地上，并没有人真正需要我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661009
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722661009,
					"content": "不是这样的！除了我们，这里也有人希望你留下来！比如…比如…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661010
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722661010,
					"content": "百代小姐。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722661011
					]
				},
				{
					"id": 722661011,
					"content": "没错！我们之所以能找到你，也多亏了百代小姐的提示！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661012
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722661012,
					"content": "百代小姐说，她失去眼睛并不是你的错。这是工伤，应该终末番给钱才对！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661013
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722661013,
					"content": "工伤什么的就不用说了吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722661014
					]
				},
				{
					"id": 722661014,
					"content": "欸，为什么？可这不是百代小姐的原话吗，而且也很有说服力呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661015
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722661015,
					"content": "但…但是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661016
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722661016,
					"content": "啊，你是觉得只有一个人挽留你，还不够有说服力是吗？还有其他人的，比如…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661017
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722661017,
					"content": "荒谷小姐。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722661018
					]
				},
				{
					"id": 722661018,
					"content": "对对！荒谷小姐夸你又麻利又认真。而且她还说，都想游说你成为八重堂的正式员工了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661019
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722661019,
					"content": "不过我觉得，你还是不要接受这份工作比较好。因为八重堂的员工，他们的黑眼圈都好重耶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661020
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722661020,
					"content": "喂，说这种话真的可以吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722661021
					]
				},
				{
					"id": 722661021,
					"content": "怎么不可以！柳达希卡小姐要留下来的话，择业可是很重要的，我要为她提出宝贵的建议！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661022
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722661022,
					"content": "我觉得，柳达希卡小姐还是做巫女比较好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661023
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722661023,
					"content": "可是，虽然你们这么说，鸣神大社那种地方，也不是像我这种人能够随便去的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661024
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722661024,
					"content": "这件事你不用担心，因为有厉害的人已经认可你了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661025
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722661025,
					"content": "八重宫司。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722661026
					]
				},
				{
					"id": 722661026,
					"content": "她其实早就知道你是假的玄冬林檎，但是她也觉得你很适合神社的工作！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661027
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722661027,
					"content": "#而且，因为百代小姐不会再回神社工作，如果八重宫司知道你也不回去的话…我和{NICKNAME}就惨了呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661028
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722661028,
					"content": "怎么听起来像是威胁…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722661029
					]
				},
				{
					"id": 722661029,
					"content": "才不是！我这是动之以情晓之以理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661030
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722661030,
					"content": "而且我们很有可能真的会被神子用可怕的办法折磨呀，你就一点都不担心吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661031
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722661031,
					"content": "噗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661032
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722661032,
					"content": "你终于笑了！所以你同意不走了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661033
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722661033,
					"content": "#派蒙，{NICKNAME}，谢谢你们，也谢谢那些愿意接纳我的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661034
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722661034,
					"content": "只是…我从小就在进行间谍的各种训练，来到稻妻之前，从没有体验过一般人的生活。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661035
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722661035,
					"content": "身为「雪奈茨芙娜」的我，直到现在，也不知道哪里才是自己的归宿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661036
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722661036,
					"content": "也不知道来自黑暗的自己，是否真的拥有回到阳光下的权利…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661037
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722661037,
					"content": "柳达希卡小姐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661038
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722661038,
					"content": "所以，这个时候离开稻妻，去提瓦特大陆其他地方游历一下，对我来说或许也是不错的选择。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661039
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722661039,
					"content": "至少，我也可以好好想一想，自己到底希望成为怎样的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661040
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722661040,
					"content": "可是，柳达希卡小姐你明明这么喜欢稻妻的！就这样离开的话，你不会感到不舍吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661041
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722661041,
					"content": "我确实有些不舍，不过…这也是没办法的事呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661042
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722661042,
					"content": "唔唔唔，怎么会这样！柳达希卡小姐明明已经非常动摇了，可她就是不肯承认。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661043
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722661043,
					"content": "唉，感觉即使再劝说她留下，也很难有效果了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661044
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722661044,
					"content": "或许可以反其道而行之。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722661045
					]
				},
				{
					"id": 722661045,
					"content": "咦，这是什么意思？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661046
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722661046,
					"content": "先打消她的防备。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722661047
					]
				},
				{
					"id": 722661047,
					"content": "再让她正视自己的内心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722661048
					]
				},
				{
					"id": 722661048,
					"content": "有道理。柳达希卡小姐并不是没有梦想，而是因为她担心自己没有获得幸福的资格，所以不敢正视自己的内心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661049
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722661049,
					"content": "我想起来了！我们身上有一件东西，正合适撬开柳达希卡小姐的心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661050
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722661050,
					"content": "这次一定能成功的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7226612,
			"completionStepIds": [
				7226612,
				7226614
