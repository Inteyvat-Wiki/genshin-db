				"objectNames": [
					"百代",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722661201,
					"content": "咳咳…我已经说过了，跟你们这群垃圾没什么好说的…还不如趁早给我个痛快！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661202
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722661202,
					"content": "百代小姐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722661203,
					"content": "我们来救你了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722661204
					]
				},
				{
					"id": 722661204,
					"content": "#这个声音…是派蒙和{NICKNAME}？呵，真没想到你们能找到这儿来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661205
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722661205,
					"content": "百代小姐，这种时候你就不要嘴硬了。你既然留下了元素粉末，就是相信我们一定会来救你的呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722661206,
					"content": "哼…那你们想听我说什么，夸你们干得漂亮？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661207
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722661207,
					"content": "嘻嘻嘻，不过要夸我们，也还是等到咱们一起离开这里之后吧。我们先帮你把门打开！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722661208,
					"content": "门被锁住了，钥匙现在在他们老大身上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661209
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722661209,
					"content": "之前在拷问我的时候，他们好像突然得知了什么事，就匆匆离开了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661210
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722661210,
					"content": "现在他们应该正在最上层的房间里密谋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661211
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722661211,
					"content": "他们谈话的时候估计会把房门反锁上，那就要用很特殊的勾玉才能从外面打开。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661212
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722661212,
					"content": "我明白了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722661213
					]
				},
				{
					"id": 722661213,
					"content": "嗯，拜托你们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "百代"
				}
			]
		},
		{
			"id": 7226616,
			"completionStepIds": [
				7226616
			],
