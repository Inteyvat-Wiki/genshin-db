			},
			"dialogs": [
				{
					"id": 722660701,
					"content": "柳达希卡小姐，我们回来啦！事情全摆平啦，你现在已经安全了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660702
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722660702,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660703
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722660703,
					"content": "柳达希卡小姐？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660704
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722660704,
					"content": "她不在里面。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722660705
					]
				},
				{
					"id": 722660705,
					"content": "奇怪，她到哪里去了？我们去问问八重堂的员工吧，说不定他们知道柳达希卡小姐的去向。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
