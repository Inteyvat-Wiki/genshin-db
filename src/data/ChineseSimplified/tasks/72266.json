			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「玄冬林檎」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722661801,
					"content": "谢谢你们的好意，不过…我去意已决，就不用再多费口舌了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661802
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722661802,
					"content": "你误会了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722661803
					]
				},
				{
					"id": 722661803,
					"content": "对，我们并不是来劝你的。既然你要离开稻妻，至少在临别之际，我们想送给你一些能代表祝福的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661804
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722661804,
					"content": "咦，你们要给我什么东西吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「玄冬林檎」"
				}
			]
		},
		{
			"id": 7226620,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7226610",
							"2"
						],
						"stepId": 7226610,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"百代"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722662001,
					"content": "怎么了，还有事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662002,
						722662004,
						722662007,
						722662014
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722662002,
					"content": "你的眼睛…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722662003
					]
				},
				{
					"id": 722662003,
					"content": "不要紧，不至于影响行动。而且说不定今后还能凭这副样子混进海盗里去呢。呵呵，想想就很带劲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "百代"
				},
				{
					"id": 722662004,
					"content": "关于今后的打算。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722662005
					]
				},
				{
					"id": 722662005,
					"content": "我们会首先去剿灭试图去海祇岛投毒的愚人众。不过似乎他们的「老师」现在已经离开稻妻了。哼，他如果敢再踏上稻妻，我一定会让他有去无回。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662006
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722662006,
					"content": "已经有人帮我把情报传回终末番了，你可以放心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "百代"
				},
				{
					"id": 722662007,
					"content": "和你接头的人是？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722662008
					]
				},
				{
					"id": 722662008,
					"content": "是个叫早柚的小家伙，她跟我说你们之前认识。现在她已经替我把消息带回终末番了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662009
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722662009,
					"content": "真的没问题吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722662010
					]
				},
				{
					"id": 722662010,
					"content": "虽然她看起来不靠谱，但好歹也是终末番的忍者，关键的事情是不会马虎的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662011
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722662011,
					"content": "哦另外她还说，如果知道是你们用那张暗语表，她可能会更努力一点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662012
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722662012,
					"content": "努力把暗语记全？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722662013
					]
				},
				{
					"id": 722662013,
					"content": "「努力不要把口水流在上面。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "百代"
				},
				{
					"id": 722662014,
					"content": "再见。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722662015
					]
				},
				{
					"id": 722662015,
					"content": "再见，你们快去离岛吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662016
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722662016,
					"content": "呼…百华姐，当年是你把身为孤儿的我捡回来，让我加入了终末番。现在的我，算不算做了一件让你骄傲的事呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "百代"
				}
			]
		},
		{
			"id": 7226621,
			"completionStepIds": [
				7226618
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7226618",
							"2"
						],
						"stepId": 7226618,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「玄冬林檎」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722662101,
					"content": "这是…鸣神大社的御神签？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662102
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722662102,
					"content": "嗯，这是我们用假竹签跟踪你那天，得到的签文。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722662103,
					"content": "虽然竹签是假的，不过它却是让我们能真正了解柳达希卡小姐的钥匙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722662104,
					"content": "当时你对我们说，因为我们是善良的人，所以签文会灵验。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722662105,
					"content": "柳达希卡小姐，你也是善良的人，所以这张签文对于你来说，也一定会灵验的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722662106,
					"content": "希望它能让你回忆起稻妻的时光。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722662107
					]
				},
				{
					"id": 722662107,
					"content": "祝福你能像签文中所说那样：「飞翔吧，漂泊吧，跨越大海，行至远方…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722662108,
					"content": "「但总有一天，你将不再漂泊。」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722662109
					]
				},
				{
					"id": 722662109,
					"content": "「总有一天，你一定能成为你希望的模样。」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722662110
					]
				},
				{
					"id": 722662110,
					"content": "「总有一天，你一定能成为你希望的模样」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662111
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722662111,
					"content": "我所…希望的模样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662112
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722662112,
					"content": "柳达希卡小姐，你告诉所有人，你现在并没有人生的方向，可那并不是真的，那只是因为你被自己的过去牵绊了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722662113,
					"content": "其实，你心里早就知道，自己到底希望成为怎样的人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722662114,
					"content": "我…早就知道答案？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662115
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722662115,
					"content": "没错！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722662116,
					"content": "你身上的巫女服——",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722662117
					]
				},
				{
					"id": 722662117,
					"content": "就是你给出的答案！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722662118
					]
				},
				{
					"id": 722662118,
					"content": "呜——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662119
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722662119,
					"content": "呜…呜呜呜……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662120
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722662120,
					"content": "呜呜呜…是的，是的…你们说得没错！一直以来，我其实都希望成为一个真正的巫女！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662121
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722662121,
					"content": "每天看着那些从御神签箱中摇出竹签的人们，那些认真向我倾诉烦恼的人们，我都会为自己虚假的身份而感到自责。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662122
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722662122,
					"content": "我真的好希望，自己能够为其他人带来祝福！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662123
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722662123,
					"content": "#呜呜…{NICKNAME}，派蒙，我的愿望能够实现吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662124
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722662124,
					"content": "我真的可以留下来吗…我真的可以成为这样的人吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662125,
						722662126
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722662125,
					"content": "你可以留下来。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722662127
					]
				},
				{
					"id": 722662127,
					"content": "百代小姐说，如果你愿意的话，可以继续用「玄冬林檎」的名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722662128,
					"content": "从今以后，你再也不用被柳达希卡的身份束缚了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722662129,
					"content": "呜呜…谢谢你们…谢谢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662130
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722662130,
					"content": "我愿意接受这个名字，成为真正的「玄冬林檎」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662131
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722662131,
					"content": "片刻后，柳达希卡终于平静了下来。\\n然后，将她留下的钱还给了她。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722662132
					]
				},
				{
					"id": 722662132,
					"content": "呼…二位，刚才真是不好意思，害你们花费了这么大力气来挽留我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662133
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722662133,
					"content": "嘿嘿，只要结果是好的就足够啦。你现在感觉好些了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722662134,
					"content": "嗯，我现在已经完全清楚了自己的内心：我想要继续留在稻妻，留在鸣神大社。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662135
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722662135,
					"content": "既然我已经收下了摩拉，也请二位重新收下这枚御神签吧。希望我的祝福，能够一直陪伴你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662136
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722662136,
					"content": "二位，我马上就会回神社，希望还能赶得上当面向百代小姐道谢。而且，也必须感谢八重大人的收留之恩才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662137
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722662137,
					"content": "#{NICKNAME}，派蒙，再见了。希望今后也能经常在鸣神大社看见你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662138
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722662138,
					"content": "再见，柳达希卡。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722662139
					]
				},
				{
					"id": 722662139,
					"content": "呵呵，下次见面，就请叫我「玄冬林檎」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722662126,
					"content": "你可以成为这样的人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722662127
					]
				}
			]
		}
	]
}