			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722660301,
					"content": "百代小姐！百代小姐！你在哪里？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722660302,
					"content": "这里已经被愚人众翻得乱七八糟的了，百代小姐的东西…还有材料什么的都不见了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722660303,
					"content": "看来这里暴露了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722660304
					]
				},
				{
					"id": 722660304,
					"content": "那百代小姐怎么样了，她不会被愚人众抓走了吧？！…阿嚏！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722660305,
					"content": "说起来，从刚才进入安全屋开始，鼻子就感觉怪怪的…阿嚏！空气里好像有什么东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722660306,
					"content": "地面上能看到粉末的痕迹。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722660307
					]
				},
				{
					"id": 722660307,
					"content": "#粉末？难道说是之前那种元素粉末？{NICKNAME}，你快用元素视野看看，这一定是百代小姐在危机之中给我们留下的信息！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7226606,
			"completionStepIds": [
				7226606
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7226616",
