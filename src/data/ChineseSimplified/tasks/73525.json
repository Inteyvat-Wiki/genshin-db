	"talks": [
		{
			"id": 7352501,
			"completionStepIds": [
				7352501
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7352501",
							"2"
						],
						"stepId": 7352501,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"沛休"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735250101,
					"content": "哎呀，这下又得给岚姐添麻烦了…不过这不是也没有办法嘛，事情那么多，干事的就我一个人，怎么做得了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250102
					],
					"speakerTitle": "沛休"
				},
				{
					"id": 735250102,
					"content": "只能再次拖延一下交付测绘结果的期限了。这样下去，在须弥花掉的生活费都已经快赶上预付的定金了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250103
					],
					"speakerTitle": "沛休"
				},
				{
					"id": 735250103,
					"content": "不过、不过最可怕的还是岚姐的怒火…唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250104
					],
					"speakerTitle": "沛休"
				},
				{
					"id": 735250104,
					"content": "咦，这里怎么会有一个璃月冒险家…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735250105,
					"content": "喂，冒险家协会的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735250106,
					"content": "嗯？怎么了，这里的河边不能进行休息吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250107
					],
					"speakerTitle": "沛休"
				},
				{
					"id": 735250107,
					"content": "不是不是，我们只是有些好奇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735250108,
					"content": "璃月的冒险家在须弥…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735250109
					]
				},
				{
					"id": 735250109,
					"content": "确实很少见嘛，而且还在这里一脸苦恼的样子，所以就来问问，有什么我们能帮上忙的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735250110,
					"content": "原来是这样，我的名字叫沛休，二位呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250111
					],
					"speakerTitle": "沛休"
				},
				{
					"id": 735250111,
					"content": "#我叫派蒙，这是{NICKNAME}！所以，沛休，你是为什么跑到了须弥…啊，难道是因为迷路了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735250112,
					"content": "哈哈哈哈哈，小家伙，是叫派蒙，哈哈哈哈，迷路…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250113
					],
					"speakerTitle": "沛休"
				},
				{
					"id": 735250113,
					"content": "有这么好笑吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250114,
						735250115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735250114,
					"content": "勉强好笑。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735250116
					]
				},
				{
					"id": 735250116,
					"content": "…普通情况下倒是没有那么好笑，不过问一名地图测绘师是不是迷路了，这件事就有点滑稽了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250117
					],
					"speakerTitle": "沛休"
				},
				{
					"id": 735250117,
					"content": "地、地图测绘师？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735250118,
					"content": "对，就是负责勘定一下以前的地图，然后看看有没有什么变化…这也是冒险家协会的职责之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250119
					],
					"speakerTitle": "沛休"
				},
				{
					"id": 735250119,
					"content": "很不巧，我就是这样一名地图测绘师，只不过…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250120
					],
					"speakerTitle": "沛休"
				},
				{
					"id": 735250120,
					"content": "只不过？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735250121,
					"content": "我只是个学徒，虽然进行了简单的地图测绘，但是错误很多，要去一些被树木遮掩的幽谷或地道里一一进行勘定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250122
					],
					"speakerTitle": "沛休"
				},
				{
					"id": 735250122,
					"content": "哎，真是快把我给难死了，须弥这里地势复杂，通路和山洞很多，有时甚至让人怀疑是不是整个山都是空的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250123
					],
					"speakerTitle": "沛休"
				},
				{
					"id": 735250123,
					"content": "进展缓慢…唉，我又不像本地人那样熟悉这里的地形。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250124
					],
					"speakerTitle": "沛休"
				},
				{
					"id": 735250124,
					"content": "咦，那为什么不让须弥本地的冒险家来测绘地图呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735250125,
					"content": "呃…其实这是须弥和璃月两个冒险家协会分会的合作项目，测绘出的地图也会供来往两地进行贸易和冒险的人使用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250126
					],
					"speakerTitle": "沛休"
				},
				{
					"id": 735250126,
					"content": "交给璃月这边的人负责…是因为本来应该负责这个项目的前辈有丰富的测绘经验，大家都觉得她十分可靠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250127
					],
					"speakerTitle": "沛休"
				},
				{
					"id": 735250127,
					"content": "哎呀，那位前辈据说以前在翘英庄就做类似的工作，不管多复杂的地形，只要扫上一眼就知道得七七八八，绘图也十分精准。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250128
					],
					"speakerTitle": "沛休"
				},
				{
					"id": 735250128,
					"content": "但她后来去了矿区。咦，我忘了是去层岩巨渊还是黑岩厂来着…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250129
					],
					"speakerTitle": "沛休"
				},
				{
					"id": 735250129,
					"content": "总之，当时看她画出的地图，大家都自愧弗如，使用她所绘地图的冒险家也都赞不绝口。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250130
					],
					"speakerTitle": "沛休"
				},
				{
					"id": 735250130,
					"content": "我就不行啦…虽然做了测绘，但是缺漏还是很多，重新勘定就要耗上太多的时间…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250131
					],
					"speakerTitle": "沛休"
				},
				{
					"id": 735250131,
					"content": "唉，人生地不熟的，虽然也有须弥冒险家协会的协助，但是效率还是太低了，这样下去，预付的定金也要当做旅费用完了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250132
					],
					"speakerTitle": "沛休"
				},
				{
					"id": 735250132,
					"content": "唔，听上去好可怜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735250133,
					"content": "不过，我们也不懂什么地图绘制…要是在地图上标什么地方有好吃的，我倒是可以帮忙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735250134,
					"content": "哈哈，这倒是个好主意，下次画一张美食地图之类的东西，一定会很受欢迎吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250135
					],
					"speakerTitle": "沛休"
				},
				{
					"id": 735250135,
					"content": "不过…其实现在的工作与绘制倒没有太大的关系，现在差的其实是勘定的工作…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250136
					],
					"speakerTitle": "沛休"
				},
				{
					"id": 735250136,
					"content": "也就是尚有几处险境，因为周围地形危险，所以没法入内勘测。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250137
					],
					"speakerTitle": "沛休"
				},
				{
					"id": 735250137,
					"content": "咦，如果只是这样的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250138
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735250138,
					"content": "听上去倒也不是很难？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735250139
					]
				},
				{
					"id": 735250139,
					"content": "对，说不定我们也可以帮忙呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250140
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735250140,
					"content": "…但是这些险境，其实大多十分危险，甚至说不定还会有魔物在里面徘徊呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250141
					],
					"speakerTitle": "沛休"
				},
				{
					"id": 735250141,
					"content": "那就更得交给我们了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250142
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735250142,
					"content": "真、真的吗…感觉如果有两位的帮忙，勘定工作一定会很快完成，这样的话，也能在期限内交出测绘图。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250143
					],
					"speakerTitle": "沛休"
				},
				{
					"id": 735250143,
					"content": "更重要的是，让来往的旅人能用上更新后的地图，不至于再跟着老地图跑到人迹罕至的荒地险境里去了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250144
					],
					"speakerTitle": "沛休"
				},
				{
					"id": 735250144,
					"content": "嗯，不过，嘿嘿，我们的帮忙也是有条件的…等你以后做好了美食地图，得给我们寄一份呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250145
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735250145,
					"content": "哈哈哈，那是一定的…不过，那也得等勘定这份地图之后了！这就交给你们了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "沛休"
				},
				{
					"id": 735250115,
					"content": "五分里给三分吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735250116
					]
				}
			]
		}
	]
}