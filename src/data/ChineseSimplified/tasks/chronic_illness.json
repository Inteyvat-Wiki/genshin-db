						30020402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30020402,
					"content": "让我看看…嗯，品质都很好，你们选得不错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020403
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30020403,
					"content": "你们野外探索经验丰富，的确帮忙节省了不少时间。看来我们接下来还能再去储备点其他的药材…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020404
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30020404,
					"content": "喂——提纳里先生！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020405
					],
					"speakerTitle": "阿米尔"
				},
				{
					"id": 30020405,
					"content": "提纳里，那边有人在叫你，看服装似乎是巡林员。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30020406,
					"content": "确实是熟人，是阿米尔他们。但他们不是才刚出发没多久吗，怎么这时候就回来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020407
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30020407,
					"content": "走，我们过去看看。",
