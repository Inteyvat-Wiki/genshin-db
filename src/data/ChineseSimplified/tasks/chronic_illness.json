	"talks": [
		{
			"id": 300201,
			"completionStepIds": [
				300201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"300201",
							"2"
						],
						"stepId": 300201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"提纳里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30020101,
					"content": "是你们啊，我正准备去找你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020102
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30020102,
					"content": "咦，提纳里，你怎么在这里？柯莱她人呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30020103,
					"content": "我过来看看柯莱的情况。简单地说，她病了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020104
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30020104,
					"content": "她病了？怎么会…等等，难道说是因为昨天我的错…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30020105,
					"content": "不用担心，你这小家伙还不至于造成那么严重的后果，柯莱的病是旧疾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020106
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30020106,
					"content": "但实事求是地说，你们来后这几天，柯莱的确有点兴奋过头，忽视了自己的身体状态。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020107
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30020107,
					"content": "唉，不过这也没办法，毕竟她已经很久没见到朋友了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020108
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30020108,
					"content": "提纳里，柯莱她究竟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30020109,
					"content": "我们换个地方说话吧。她刚吃了药睡下，这里需要安静。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "提纳里"
				}
			]
		},
		{
			"id": 300202,
			"completionStepIds": [
				300203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"300203",
							"2"
						],
						"stepId": 300203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"提纳里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30020201,
					"content": "好了，我们就在这里继续之前的话题吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020202
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30020202,
					"content": "其实直到刚才柯莱和我说起，我才意识到原来你就是那位蒙德的荣誉骑士。你在璃月和稻妻的其他义举，我也有所耳闻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020203
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30020203,
					"content": "但我要声明一下，我把柯莱的真实情况告诉你们，跟你们的身份和过往经历无关，而只是基于一个理由——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020204
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30020204,
					"content": "是柯莱拜托我这么做的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020205
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30020205,
					"content": "说实话，我个人并不建议柯莱把自己的过往经历也告诉你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020206
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30020206,
					"content": "但柯莱却对我说，你们把她当做朋友，真诚地对待她，所以她也应该这样对待你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020207
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30020207,
					"content": "提纳里，柯莱她到底得了什么病？你刚刚说是「旧疾」，她难道已经病了很久了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30020208,
					"content": "对，其实柯莱从小就患有一种叫做「魔鳞病」的疾病。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020209
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30020209,
					"content": "「魔鳞病」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30020210,
					"content": "这是一种须弥独有的病症，因为患者身上会出现灰黑色的鳞片状组织而得名。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020211
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30020211,
					"content": "一开始患者只是感觉皮肤发生变化的区域有些麻木，可随着病情发展，会出现力量减退、手指和脚趾偶尔丧失知觉的情况。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020212
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30020212,
					"content": "最终，患者将会变得无法控制自己的身体，彻底失去行动能力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020213
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30020213,
					"content": "听起来有点可怕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30020214,
					"content": "「无法控制自己的身体」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30020215
					]
				},
				{
					"id": 30020215,
					"content": "等等，难道说之前柯莱有点毛手毛脚的感觉，其实都是因为…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30020216,
					"content": "对，是魔鳞病的影响。所以我让她尽量不要拿东西，避免伤到自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020217
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30020217,
					"content": "这种病可以治愈吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30020218
					]
				},
				{
					"id": 30020218,
					"content": "如果治疗方法得当，患者的病情发展能够得到有效控制。遗憾的是，魔鳞病至今尚无法治愈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020219
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30020219,
					"content": "但曾经却有人骗柯莱的母亲说，有根除魔鳞病的办法，让她把女儿交给了一个叫做「愚人众」的组织。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020220
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30020220,
					"content": "什么，愚人众？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30020221,
					"content": "看来你们知道愚人众，这样正好，省去了解释的功夫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020222
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30020222,
					"content": "总之，把柯莱拜托给我照顾的人说，柯莱被送到了名为「博士」的执行官那里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020223
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30020223,
					"content": "我不知道「博士」是怎么做到的，她的魔鳞病的确在那些年被完全遏制了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020224
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30020224,
					"content": "但在愚人众那里的日子，对她来说绝对不是什么愉快的回忆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020225
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30020225,
					"content": "虽说她很坚强，也一直努力表现得开朗，可直到现在，她偶尔还是会对他人的触碰感到畏惧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020226
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30020226,
					"content": "原来柯莱之前经历过这么多痛苦的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020227
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30020227,
					"content": "对了派蒙，柯莱让我告诉你，她很抱歉昨天吓到了你。此外她还说：对不起，一开始对你们隐瞒了病情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020228
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30020228,
					"content": "这不是柯莱的错，她不需要道歉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020229
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30020229,
					"content": "嗯，这些话我希望下次你们见到她时，能够亲口告诉她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020230
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30020230,
					"content": "她曾经一度认为自己没有获得友谊的资格，请你们不要让我的弟子再次经历类似的痛苦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020231
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30020231,
					"content": "提纳里，你放心吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020232
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30020232,
					"content": "柯莱她现在病情如何？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30020233
					]
				},
				{
					"id": 30020233,
					"content": "还好，不算太严重。这次倒下主要是因为这两天体力有点透支。现在已经吃了药，再休息一下就能好转。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020234
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30020234,
					"content": "不过她刚到化城郭的时候，情况的确要比现在好不少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020235
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30020235,
					"content": "那时因为她对巡林员的工作感兴趣，也很想学习知识，我就让她加入了我们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020236
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30020236,
					"content": "最近她的精力下降了不少，虽说应该保持适量的运动，但远途的巡逻已经不太适合她了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020237
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30020237,
					"content": "好了，柯莱的情况我已经都告诉你们了。现在我要去给她采些药回来，就不多闲聊了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020238
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30020238,
					"content": "我们也能一起去吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30020239
					]
				},
				{
					"id": 30020239,
					"content": "对，提纳里，我们也想为柯莱做点什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020240
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30020240,
					"content": "…也行。不过因为雨林里很危险，旅行者也正在恢复中，所以希望你们能在途中听从我的指示。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020241
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30020241,
					"content": "嗯，我们明白了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020242
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30020242,
					"content": "走吧。我们要去采集的是一种叫做「月莲」的植物，它对魔鳞病患者恢复精力很有帮助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "提纳里"
				}
			]
		},
