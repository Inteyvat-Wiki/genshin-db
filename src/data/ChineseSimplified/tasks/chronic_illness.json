				"objectNames": [
					"阿米尔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30020501,
					"content": "提纳里先生，没想到竟然在这里遇到你了，我们正准备回化城郭找你呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020502
					],
					"speakerTitle": "阿米尔"
				},
				{
					"id": 30020502,
					"content": "出什么事了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020503
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30020503,
					"content": "我们刚刚发现「死域」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020504
					],
					"speakerTitle": "娜丝琳"
				},
				{
					"id": 30020504,
					"content": "「死域」？今天你们走的这条路线，应该是一周前刚彻底清理过才对，竟然这么快就又出现了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020505
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30020505,
					"content": "具体位置在哪？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020506
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30020506,
					"content": "就在前面的河谷深处。因为这次出现的地方几乎把河谷狭窄的区域都堵住了，所以我们就赶快回来找你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020507
					],
					"speakerTitle": "阿米尔"
				},
				{
					"id": 30020507,
					"content": "半径呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020508
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30020508,
					"content": "不好意思，之前看得不是太清楚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020509
					],
					"speakerTitle": "阿米尔"
				},
				{
					"id": 30020509,
					"content": "今天我们队里的人都没有神之眼，而且我们感觉它可能还在扩张期，所以没敢靠太近。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020510
					],
					"speakerTitle": "娜丝琳"
				},
				{
					"id": 30020510,
					"content": "#嗯，你们的判断是正确的。我马上就去处理，你们就先带{M#他们}{F#她们}两个一起回化城郭吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020511
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30020511,
					"content": "等等呀提纳里，为什么突然要让我们回去？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020512
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30020512,
					"content": "哦，你们才刚来到须弥，还不太了解这里的情况。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020513
					],
					"speakerTitle": "阿米尔"
				},
				{
					"id": 30020513,
					"content": "在须弥的雨林中，有些区域会出现一种独特的异变现象，那些地方叫做「死域」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020514
					],
					"speakerTitle": "阿米尔"
				},
				{
					"id": 30020514,
					"content": "「死域」不仅会使植物枯萎，也会夺走动物和人类的生命。如果没有神之眼的话，可绝对不能贸然靠近！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020515
					],
					"speakerTitle": "阿米尔"
				},
				{
					"id": 30020515,
					"content": "他说得没错。我之前告诉你们雨林中存在十分危险的区域，并不是危言耸听。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020516
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30020516,
					"content": "只有拥有神之眼——也就是能驾驭元素力的人，才能在一定时间内抵御死域的侵蚀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020517
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30020517,
					"content": "是啊，所以对于我们这些普通的巡林员来说，发现死域后，会先记录下位置，然后交给提纳里先生这样的专业人士来处理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020518
					],
					"speakerTitle": "阿米尔"
				},
				{
					"id": 30020518,
					"content": "毕竟只有他们才能深入到死域内部，找到消除死域的办法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020519,
						30020520
					],
					"speakerTitle": "阿米尔"
				},
				{
					"id": 30020519,
					"content": "我或许也能帮上忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30020521
					]
				},
				{
					"id": 30020521,
					"content": "可你看起来好像并没有神之眼的样子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020522
					],
					"speakerTitle": "阿米尔"
				},
				{
					"id": 30020522,
					"content": "#你们放心吧，{M#他}{F#她}虽然没有神之眼，但却是使用元素力的老手了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30020520,
					"content": "我也能使用元素力。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30020521
					]
				}
			]
		},
