			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"伊拉德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 756590101,
					"content": "您终于来了，英雄大人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756590102
					],
					"speakerTitle": "伊拉德"
				},
				{
					"id": 756590102,
					"content": "卑职在此等候多时，见到您的身影，疲惫竟一扫而空！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756590103,
						756590104
					],
					"speakerTitle": "伊拉德"
				},
				{
					"id": 756590103,
					"content": "没错，我来得真好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756590105
					]
				},
				{
					"id": 756590105,
					"content": "气氛突然变得好正式！我，我也要用正经的语气说话么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756590106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756590106,
					"content": "啊，请别紧张，英雄大人和尊贵的向导，我简单介绍一下情况。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756590107
					],
					"speakerTitle": "伊拉德"
				},
				{
					"id": 756590107,
					"content": "卑职是话事处的员工，战备联络人伊拉德，负责协助火神大人处理各部族巡逻队的训练事务。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756590108
					],
					"speakerTitle": "伊拉德"
				},
				{
					"id": 756590108,
					"content": "根据传统，每过一段时间，各部族都会从年轻人中选拔新的战士，加入巡逻队。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756590109
					],
					"speakerTitle": "伊拉德"
				},
				{
					"id": 756590109,
					"content": "同时，还要为老成员们设计较高难度的考核，以便他们挑战自我，不断进步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756590110
					],
					"speakerTitle": "伊拉德"
				},
				{
					"id": 756590110,
					"content": "相关的选拔与考核关卡，就是由战备联络人联合各部族的优秀战士一同设计的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756590111
					],
					"speakerTitle": "伊拉德"
				},
				{
					"id": 756590111,
					"content": "哦呀，我听懂了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756590112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756590112,
					"content": "#聊到战斗、竞速之类的挑战，{NICKNAME}的确是专家，应该能帮你设计很多有意思的关卡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756590113,
						756590114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756590113,
					"content": "你要给我发需求吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756590115
					]
				},
				{
					"id": 756590115,
					"content": "不至于，不至于！卑职怎敢让英雄大人来做我份内的工作！那既是我的失职，又是对英雄大人的怠慢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756590116
					],
					"speakerTitle": "伊拉德"
				},
				{
					"id": 756590116,
					"content": "所有的考核关卡已经设计完毕了，我只是想请求英雄大人对这些关卡予以「认证」，同时，也是为战士们树立一个榜样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756590117
					],
					"speakerTitle": "伊拉德"
				},
				{
					"id": 756590117,
					"content": "就如书面考试需要满分，人们修习技艺也需要目标。强大的战士们率先通过这些考核关卡，会给后辈们无尽的动力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756590118
					],
					"speakerTitle": "伊拉德"
				},
				{
					"id": 756590118,
					"content": "比如，「回声之子」相关的考核关卡，就由「巴莱卡」的希诺宁大师认证…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756590119
					],
					"speakerTitle": "伊拉德"
				},
				{
					"id": 756590119,
					"content": "「悬木人」和「花羽会」的关卡则分别请到了「马力卜」基尼奇大师和「武卡」恰斯卡大师，让许多战士满怀热情地挑战…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756590120
					],
					"speakerTitle": "伊拉德"
				},
				{
					"id": 756590120,
					"content": "#原来是这个意思…那这次{NICKNAME}岂不是成了…那句话怎么说的来着？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756590121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756590121,
					"content": "「永远追不上的地平线」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756590122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756590122,
					"content": "好，我来给大家当榜样。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756590123
					]
				},
				{
					"id": 756590123,
					"content": "这气魄，不愧是英雄大人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756590124
					],
					"speakerTitle": "伊拉德"
				},
				{
					"id": 756590124,
					"content": "谦虚点，提瓦特遍地是高手。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756590125
					]
				},
				{
					"id": 756590125,
					"content": "这气度，赞美英雄大人的品德！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756590126
					],
					"speakerTitle": "伊拉德"
				},
				{
					"id": 756590126,
					"content": "那么，请容卑职在地图上标出几个考核关卡的位置，英雄大人随时可以前去大展身手！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊拉德"
				},
				{
					"id": 756590114,
					"content": "你想成为我的甲方吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756590115
					]
				},
				{
					"id": 756590104,
					"content": "有…有什么事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756590105
					]
				}
			]
		}
	]
}