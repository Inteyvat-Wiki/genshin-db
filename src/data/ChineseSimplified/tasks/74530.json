			},
			"dialogs": [
				{
					"id": 745300401,
					"content": "啊，师父！你回来啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300402,
						745300403
					],
					"speakerTitle": "卡齐娜"
				},
				{
					"id": 745300402,
					"content": "卡齐娜看起来很开心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300404
					]
				},
				{
					"id": 745300404,
					"content": "嘿嘿，我这次挖掘，找到了很不错的原矿哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300405
					],
					"speakerTitle": "卡齐娜"
				},
				{
					"id": 745300405,
					"content": "如果能好好打磨的话，说不定能变成闪闪发光的大宝石呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300406
					],
					"speakerTitle": "卡齐娜"
				},
				{
					"id": 745300406,
					"content": "太好了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300407
					]
				},
				{
					"id": 745300407,
					"content": "嗯！本来前面都没什么收获，我差点就要空手而归了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300408
					],
					"speakerTitle": "卡齐娜"
				},
				{
					"id": 745300408,
					"content": "但是我想着，要再坚持一下…所以就告诉自己，再往下挖一点，就再挖一点点…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300409
					],
					"speakerTitle": "卡齐娜"
				},
				{
					"id": 745300409,
					"content": "不知道到底重复了多少次，终于找到了这个！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300410
					],
					"speakerTitle": "卡齐娜"
				},
				{
					"id": 745300410,
					"content": "等我出来的时候，才发现太阳都快下山了…好像不小心就挖了一整天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300411,
						745300412
					],
					"speakerTitle": "卡齐娜"
				},
				{
					"id": 745300411,
					"content": "不愧是卡齐娜，真有毅力。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300413
					]
				},
				{
					"id": 745300413,
					"content": "呜哇，真的吗？我、我面对镜头会容易害羞…不一定能拍得好哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300414
					],
					"speakerTitle": "卡齐娜"
				},
				{
					"id": 745300414,
					"content": "不过…如果是师父的请求，我会努力的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300415,
						745300416
					],
					"speakerTitle": "卡齐娜"
				},
				{
					"id": 745300415,
					"content": "你已经很努力了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300417
					]
				},
				{
					"id": 745300417,
					"content": "嗯！我明白了。那就交给你了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡齐娜"
				},
				{
					"id": 745300416,
					"content": "卡齐娜现在这样就很好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300417
					]
				},
				{
					"id": 745300412,
					"content": "可以拍下闪闪发光的你吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300413
					]
				},
				{
					"id": 745300403,
					"content": "发生什么好事了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300404
					]
				}
			]
		}
	]
