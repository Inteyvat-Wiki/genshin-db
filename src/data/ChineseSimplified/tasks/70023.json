			"dialogs": [
				{
					"id": 700230101,
					"content": "Ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700230102
					],
					"speakerTitle": "丘丘人"
				},
				{
					"id": 700230102,
					"content": "Mimi ika yaya nye! Mimi tomo, mimi mani ye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700230103
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 700230103,
					"content": "Mani. Mi muhe mani. Unu du mani! Hahahahaha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700230104
					],
					"speakerTitle": "丘丘人"
				},
				{
					"id": 700230104,
					"content": "这家伙讲了一个丘丘人语言的笑话，把自己乐到了。它们精神太贫瘠了，看着真可怜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700230105
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 700230105,
					"content": "Mi muhe <color=#00E1FFFF>kucha gusha</color>. Kucha gusha dada. Unu gusha dada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700230106
					],
					"speakerTitle": "丘丘人"
				},
				{
					"id": 700230106,
					"content": "它想要…唔…不管了，只要查看我的手册就能找到的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾拉·马斯克"
				}
			]
		},
