			},
			"dialogs": [
				{
					"id": 700230308,
					"content": "Hola！丘丘人语言的「你好」是这样说的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700230309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700230309,
					"content": "它好像要告诉我们关于那个奇怪的丘丘人的情报呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700230301
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700230301,
					"content": "Yeye dada! Mosi mita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700230302
					],
					"speakerTitle": "丘丘人"
				},
				{
					"id": 700230302,
					"content": "Hahahaha, kucha gusha unu gusha. Unu kucha si!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700230303
					],
					"speakerTitle": "丘丘人"
				},
				{
					"id": 700230303,
					"content": "Wei? Odomu tomo zido mi! <color=#00E1FFFF>Mosi aba nunu</color>！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700230304
					],
					"speakerTitle": "丘丘人"
				},
				{
					"id": 700230305,
					"content": "Mosi mita dada!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700230307
					]
				},
				{
					"id": 700230306,
					"content": "Tomo, valo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700230307
					]
				},
				{
					"id": 700230304,
					"content": "<color=#00E1FFFF>Mosi aba nunu</color>…手册上有写这句话的含义吗…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700230305,
						700230306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700230307,
					"content": "Valo, mi tomo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "丘丘人"
				}
			]
		},
