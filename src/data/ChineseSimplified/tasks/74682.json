			"trigger": {
				"objectNames": [
					"兰吉特"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 746820101,
					"content": "终于还是走到了今天这一步啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820102
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 746820102,
					"content": "儿时的梦想呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746820103
					]
				},
				{
					"id": 746820103,
					"content": "长大成人之后，终于理解了当年巡林官面露难色的理由…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820104
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 746820104,
					"content": "咳，不管怎么说，至少尝试过了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820105
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 746820105,
					"content": "而且也知道了不该带着未经处理的爆炎树果实接近翠翎恐蕈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820106
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 746820106,
					"content": "闻到枯焦味道的时候已经晚了，差点被它散播的孢子淹没。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820107
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 746820107,
					"content": "常常会忘记蕈兽毕竟不是蕈猪，是完全不同的物种呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820108
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 746820108,
					"content": "对哦，说起来，蕈兽应该算是菌类吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746820109,
					"content": "是啊，炖汤的话特别鲜美。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820110
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 746820110,
					"content": "呃，要不我们还是说回今天的挑战对象吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746820111,
					"content": "我还没想好怎么料理…哦！你是在说「交涉」，抱歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820112
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 746820112,
					"content": "不知道两位听说过原海异种的两位霸主的故事没有，故事里形容千年珍珠骏麟都是用的孤傲、高洁这样的词。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820113
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 746820113,
					"content": "相比之下，铁甲熔火帝皇听起来就像是什么不好惹的狠角色，强大但是暴戾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820114
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 746820114,
					"content": "我还以为你会选听起来更强的那个挑战呢，毕竟之前也说过既然要讲故事，对手当然是越强越好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746820115,
					"content": "铁甲熔火帝皇确实很强，可那毕竟是重甲蟹…相比之下，千年珍珠骏麟可是能飞的海马！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820116,
						746820118
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 746820116,
					"content": "能飞的海马是不是应该叫天马？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746820117
					]
				},
				{
					"id": 746820117,
					"content": "你在意的居然是这个问题吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746820119,
					"content": "不管怎么说，只要让我骑乘哪怕一次…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820120
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 746820120,
					"content": "好吧，看来你是要坚持到底了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746820121,
					"content": "来都来了，总不能无功而返！准备好了的话，我们这就出发吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820122,
						746820123
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 746820122,
					"content": "准备好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 746820123,
					"content": "还有别的事，稍候。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746820124
					]
				},
				{
					"id": 746820124,
					"content": "没问题，我就在这儿等你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 746820118,
					"content": "对我来说都没有区别…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746820119
					]
				}
			]
		}
	]
}