				]
			},
			"dialogs": [
				{
					"id": 747080101,
					"content": "#你们好呀，{NICKNAME}和派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080102
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 747080102,
					"content": "听吉约丹小姐说你们最近在打理水族馆。我就受她邀请，来当水族馆的鱼类顾问啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080103,
						747080104
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 747080103,
					"content": "欢迎欢迎。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747080105
					]
				},
				{
					"id": 747080105,
					"content": "太好了，有希格雯护士长在，我们就不用担心它们生病啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747080106,
					"content": "嘿嘿，多亏你们之前邀请我看管「海薇玛映影欢乐城」的动物庄园，我也总结了一些窍门…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080107
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 747080107,
					"content": "照顾病人和懂事的动物客人之间，有着好多相通的道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080108
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 747080108,
					"content": "#不过这次，除了展示普通的鱼类，我还有些「疗养」的计划，想和{NICKNAME}商量看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080109
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 747080109,
					"content": "请说请说，我都好说。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747080110
					]
				},
				{
					"id": 747080110,
					"content": "听希娅警官说，最近有些鱼儿变得格外狂躁，狠狠攻击附近的生物，甚至是潜水员和小船。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080111
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 747080111,
					"content": "我在想，可不可以将它们请到水族馆里来冷静一下，至少别再造成更大的破坏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080112
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 747080112,
					"content": "然后，我来找找办法，治好它们突然出现的坏脾气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080113
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 747080113,
					"content": "这样不仅能帮助鱼儿和水域恢复正常，也算是为水族馆增添独特的演员。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080114
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 747080114,
					"content": "听起来确实是个办法！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747080115,
					"content": "我也支持。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747080116
					]
				},
				{
					"id": 747080116,
					"content": "那，我就给你们提供一些暴躁鱼儿出没水域的消息，之后就拜托你们啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "希格雯"
				},
				{
					"id": 747080104,
					"content": "帮大忙了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747080105
					]
				}
			]
		}
	]
}