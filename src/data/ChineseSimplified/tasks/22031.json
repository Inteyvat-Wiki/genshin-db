					"朝仓"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220310301,
					"content": "您刚才似乎走神了？步伐很混乱，攻击时的力道也时强时弱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310302
					],
					"speakerTitle": "朝仓"
				},
				{
					"id": 220310302,
					"content": "这样可不行啊，请您再准备准备，我们等会再来一次吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "朝仓"
				}
			]
		},
		{
			"id": 2203104,
			"completionStepIds": [
				2203104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
