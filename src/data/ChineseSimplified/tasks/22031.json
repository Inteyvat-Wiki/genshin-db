					"朝仓"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220310401,
					"content": "呼、呼…阁下的武艺真是远超于我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310402
					],
					"speakerTitle": "朝仓"
				},
				{
					"id": 220310402,
					"content": "我下次轻点…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310403
					]
				},
				{
					"id": 220310403,
					"content": "不！请阁下还是使出全力吧，不经历磨砺，我就不会成长。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310404
					],
					"speakerTitle": "朝仓"
				},
				{
					"id": 220310404,
					"content": "您之所以如此强大，应该也是经历了无数锻炼吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310405
					],
					"speakerTitle": "朝仓"
				},
				{
					"id": 220310405,
					"content": "恕我唐突，我真的很好奇，您是…怎么锻炼自己的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310406,
						220310408
					],
					"speakerTitle": "朝仓"
				},
				{
					"id": 220310406,
					"content": "有一只巨龙帮我训练飞行。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310407
					]
				},
				{
					"id": 220310407,
					"content": "居、居然能和巨龙一起飞行，真是难以想象…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310410
					],
					"speakerTitle": "朝仓"
				},
				{
					"id": 220310410,
					"content": "就是…顺便而已。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310411
					]
				},
				{
					"id": 220310411,
					"content": "哈哈哈，是这样吗？那您可绝对算得上是天赋异禀了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310412
					],
					"speakerTitle": "朝仓"
				},
				{
					"id": 220310412,
					"content": "谢谢您和我对练，这场比试，在下铭记在心。这些报酬，请您收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "朝仓"
				},
				{
					"id": 220310408,
					"content": "有一匹巨狼帮我磨砺武艺。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310409
					]
				},
				{
					"id": 220310409,
					"content": "听起来真是…勇武无匹。真想见识一下您和那匹巨狼战斗的场景啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310410
					],
					"speakerTitle": "朝仓"
				}
			]
		},
