			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"朝仓"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220310101,
					"content": "枪扎一线...喝！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310102
					],
					"speakerTitle": "朝仓"
				},
				{
					"id": 220310102,
					"content": "我来和你对练了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310103
					]
				},
				{
					"id": 220310103,
					"content": "噢！是您啊阁下，您又接下我的委托了吗？非常感谢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310104
					],
					"speakerTitle": "朝仓"
				},
				{
					"id": 220310104,
					"content": "您这样武艺高强的人愿意和我对练，实在是太好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310105,
						220310110
					],
					"speakerTitle": "朝仓"
				},
				{
					"id": 220310105,
					"content": "枪法比之前进步不少啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310106
					]
				},
				{
					"id": 220310106,
					"content": "哈哈…您可不要再调侃我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310107
					],
					"speakerTitle": "朝仓"
				},
				{
					"id": 220310107,
					"content": "我听说，枪这种武器被发明的目的之一，就是让我这种不怎么精通武艺的人也能拿着它战斗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310108
					],
					"speakerTitle": "朝仓"
				},
				{
					"id": 220310108,
					"content": "毕竟这种武器又长又尖，就算是拿着的人不懂枪法，只是单纯地戳刺和挥舞，看起来都很有气势。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310109
					],
					"speakerTitle": "朝仓"
				},
				{
					"id": 220310109,
					"content": "不过，按这种原则…其实我感觉那种前面有三个尖的草叉更有威力…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "朝仓"
				},
				{
					"id": 220310110,
					"content": "你不是已经拿回武器了么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310111
					]
				},
				{
					"id": 220310111,
					"content": "武器虽然已经拿回来了，但并不能代表修炼就到此为止了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310112
					],
					"speakerTitle": "朝仓"
				},
				{
					"id": 220310112,
					"content": "曾经会遇见海乱鬼这种家伙，未来很难说不会遇见更强大的敌人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310113
					],
					"speakerTitle": "朝仓"
				},
				{
					"id": 220310113,
					"content": "绝不允许我的武器再次落入敌手，绝不允许武士荣耀再次受人践踏，这就是我追求的武士之道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "朝仓"
				}
			]
		},
		{
			"id": 2203102,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
