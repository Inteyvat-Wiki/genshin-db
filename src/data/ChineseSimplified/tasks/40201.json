			"dialogs": [
				{
					"id": 402010501,
					"content": "这下可以确认了，那两个坏家伙确实很急，要一次把大部分货物运到枫丹，没有耍什么骗人的花招…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402010502,
					"content": "不过，那些涂了奇怪标记的货物是怎么回事呢…我们去问问夜兰吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010503
