			},
			"dialogs": [
				{
					"id": 402010201,
					"content": "不好意思，各位乘客，由于货舱满载，不少货物只能堆放在甲板上，还请各位见谅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010202
					],
					"speakerTitle": "船员"
				},
				{
					"id": 402010202,
					"content": "没事没事！这说明最近生意景气，大家一起发财！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010203
					],
					"speakerTitle": "热情的乘客"
				},
				{
					"id": 402010203,
					"content": "看来「诈狂」标记的货物，托运人一栏登记了科德的名字，多达马尼在船舱内活动，应该也在确认货品交付到位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010204
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 402010204,
					"content": "他们在…检查东西？还在箱子里翻来倒去？搞什么名堂…完全不理解！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402010205,
					"content": "#拿着这份暗语对照表，{NICKNAME}，利用这份道具，你就能读出他们沟通用的黑话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010206
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 402010206,
					"content": "待会儿，我会支开科德和多达马尼，你们趁机调查「诈狂」标记过的货箱，想必能找到什么线索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010207,
						402010208
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 402010207,
					"content": "如果有不妙的东西。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010209
					]
				},
				{
					"id": 402010209,
					"content": "当然，我相信你的判断。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010210
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 402010210,
					"content": "欸？欸欸欸？夜兰你要直接去和那些家伙对话吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402010211,
					"content": "嗯？两位先生…有些面善？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010212
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 402010212,
					"content": "我们是不是在遗珑埠的九略茶馆，有过一面之缘？利奥奈区有名的古董收藏家，科德先生，还有这位朋友？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010213
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 402010213,
					"content": "啊？你…你？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010214
					],
					"speakerTitle": "多达马尼"
				},
				{
					"id": 402010214,
					"content": "…「岩上茶室」的「灵骰传说」夜兰小姐，幸会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010215
					],
					"speakerTitle": "科德"
				},
				{
					"id": 402010215,
					"content": "居然还认识我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010216
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 402010216,
					"content": "我曾在「岩上茶室」喝过一盅绝品，席间，听说了您的传闻。现在看来，同为爱茶之人的我们，大概确实有些缘分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010217
					],
					"speakerTitle": "科德"
				},
				{
					"id": 402010217,
					"content": "既然有如此精妙的巧合…正好，我打算前往枫丹享受假期，有什么推荐的去处吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010218
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 402010218,
					"content": "比如…精美茶具之类的艺术品展览…或是拍卖会？我听说枫丹的红茶别有一番风味，茶具想必也很有特色。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010219
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 402010219,
					"content": "这！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010220
					],
					"speakerTitle": "多达马尼"
				},
				{
					"id": 402010220,
					"content": "嗯？这位朋友，你似乎也对茶具很有兴趣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010221
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 402010221,
					"content": "我…咳咳…没错，我是这条船的船东，受科德的邀请去枫丹旅行，很荣幸能认识你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010222
					],
					"speakerTitle": "多达马尼"
				},
				{
					"id": 402010222,
					"content": "夜兰真的和他们聊起来了？没问题吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010223,
						402010224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402010223,
					"content": "我们抓紧时间。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010225
					]
				},
				{
					"id": 402010225,
					"content": "那好！我们绕到那两个家伙看不见的地方，去调查他们的箱子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402010226,
					"content": "咳咳，箱子里的味道有点刺鼻，好像把好几种东西都混合起来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010227
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402010227,
					"content": "还有个奇怪的纸条，写着什么看不懂的东西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010228,
						402010229
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402010228,
					"content": "是「黑钱领主」的密文…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010230
					]
				},
				{
					"id": 402010230,
					"content": "真不愧是夜兰，每个意外情况都预料到了！你你你，你应该知道怎么破译吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010231
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402010231,
					"content": "怎么样怎么样？那帮家伙在偷偷说什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010232,
						402010233
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402010232,
					"content": "没猜错的话，是炸弹。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010234
					]
				},
				{
					"id": 402010234,
					"content": "炸炸炸炸…炸船？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010235
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402010235,
					"content": "他们疯了吗！他们不是想摆脱调查吗？这样反而把麻烦搞得更大了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010236,
						402010237,
						402010238
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402010236,
					"content": "「诈狂」要保住幕后黑手…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010239
					]
				},
				{
					"id": 402010239,
					"content": "夜兰说得真没错，那家伙完全癫狂了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010240
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402010240,
					"content": "船上还有好多无辜的人，我们得想办法把炸弹都揪出来，让它们都停下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402010237,
					"content": "选择用更大的事态转移焦点…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010239
					]
				},
				{
					"id": 402010238,
					"content": "同时斩断我们这边的线索…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010239
					]
				},
				{
					"id": 402010233,
					"content": "他们想要炸船销赃。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010234
					]
				},
				{
					"id": 402010229,
					"content": "我们有暗语对照表…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010230
					]
				},
				{
					"id": 402010224,
					"content": "好好利用这个窗口。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010225
					]
				},
				{
					"id": 402010208,
					"content": "可以让我自行处置吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010209
					]
				}
			]
		},
