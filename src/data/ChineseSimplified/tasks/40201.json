			"dialogs": [
				{
					"id": 402010401,
					"content": "甲板上的炸弹搞定了，应该还有船舱里的…时间还够吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402010402,
					"content": "船舱里的炸弹，我都处理妥当了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010403
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 402010403,
					"content": "#辛苦你们，{NICKNAME}和派蒙。你们应对突发状况的果决和利落，无可挑剔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010404
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 402010404,
					"content": "夜兰！还好你察觉到不妙，要登船调查，给了我们对照表…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402010405,
					"content": "欸，不对！那两个家伙呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402010406,
					"content": "呵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010407
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 402010407,
					"content": "真惊险啊，科德和多达马尼先生，你们似乎被不得了的危险人物盯上了，他想让你们人财俱失呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010408
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 402010408,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010409
					],
					"speakerTitle": "科德"
				},
				{
					"id": 402010409,
					"content": "的确，我不明白，世间怎会有如此歹毒之人。我也想不起来，我在哪得罪了这种恶人，结下了仇，以至于让他动了杀心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010410
					],
					"speakerTitle": "科德"
				},
				{
					"id": 402010410,
					"content": "现在无需担忧了，我会立即通知执律庭，请他们向柔灯港派遣接应人员，专门保护二位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010411
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 402010411,
					"content": "科德先生的货品也会交由执律庭检查一番，彻底排除安全隐患，再由警员协助护送至预定地点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010412
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 402010412,
					"content": "说起来，科德先生的货品，要送往什么地方来着？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010413
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 402010413,
					"content": "…两天后，德波大饭店的拍卖会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010414
					],
					"speakerTitle": "科德"
				},
				{
					"id": 402010414,
					"content": "那请务必放心，执律庭的警员每个都恪尽职守，一定会保证你的货品——毫发无损地——参加拍卖。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010415
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 402010415,
					"content": "无比感谢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010416
					],
					"speakerTitle": "科德"
				},
				{
					"id": 402010416,
					"content": "一段时间后，船舶安然无恙地抵达了柔灯港。执律庭的警员很快接管了船舶，对船舶进行了安全排查，并将所有货物封存运走。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402010417
					]
				},
				{
					"id": 402010417,
					"content": "你们则向夜兰补充描述了「诈狂」留给科德和多达马尼的信件内容。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
