			"dialogs": [
				{
					"id": 402010301,
					"content": "吓死我了，夜兰！你直接去和那些犯人对峙，就不怕他们突然警惕，然后…然后胡来吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402010302,
					"content": "他们什么都知道，他们也必须硬着头皮面对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010303
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 402010303,
					"content": "现在看来，「黑钱领主」的确相当谨慎，他打算断尾求生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010304
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 402010304,
					"content": "让货品缺席拍卖会，将赃物沉海，除去一切可能导向他的物证，并让「诈狂」吸引所有火力…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010305
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 402010305,
					"content": "但我们和执律庭的行动奏效，等于按着对方的头，强行让他们走完拍卖的流程。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010306
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 402010306,
					"content": "如果「黑钱领主」放弃让代理人拍下这批货品，而是由其他不知情的买家拍下这些炒作包装的艺术品…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010307
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 402010307,
					"content": "买家必将发现这些商品经过了虚假估值，报案上诉，科德就会被列为嫌疑人，甚至定罪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010308
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 402010308,
					"content": "轻则导致「黑钱领主」无法再用这种伎俩为摩拉除痕，重则让「黑钱领主」失去他在枫丹的最后一位得力部下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010309,
						402010310
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 402010309,
					"content": "反之，如果继续参加拍卖…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010311
					]
				},
				{
					"id": 402010311,
					"content": "那么线索就不会中断，我们依然可以通过拍下这批货品的买家，找出「黑钱领主」的踪迹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010312
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 402010312,
					"content": "唔？哎？啊？你？我？你们？怎么回事来着？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402010313,
					"content": "#别心急，派蒙，{NICKNAME}会给你慢慢解释的哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010314
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 402010314,
					"content": "那么，最后也是最关键的一环，拍卖会上的垂钓…就让我们各自好好准备一番吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010315
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 402010315,
					"content": "埃德勒警官已经让线人安排好了，你们拿着这封邀请函。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010316
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 402010316,
					"content": "两天后，我们德波大饭店见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夜兰"
				},
				{
					"id": 402010310,
					"content": "另一种情况也对我们有利…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010311
					]
				}
			]
		},
