			"dialogs": [
				{
					"id": 402010101,
					"content": "不错，非常守时。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010102,
						402010103
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 402010102,
					"content": "进展如何？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010104
					]
				},
				{
					"id": 402010104,
					"content": "我们潜伏观察上次的据点一天后，犯人科德和多达马尼便开始转移其中的货品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010105
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 402010105,
					"content": "看见那艘船了吗？那就是多达马尼调来转移货品的船只，还找了个客货联运的幌子，给自己打掩护。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010106
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 402010106,
					"content": "唔，好一艘大家伙！要装的货物都堆在栈桥上，好像还有不少外地人打算乘它去柔灯港…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010107,
						402010108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402010107,
					"content": "为了确认对方没有假动作，",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010109
					]
				},
				{
					"id": 402010109,
					"content": "漂亮，已经知道提防诱骗了，进步很快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010110
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 402010110,
					"content": "倘若科德和多达马尼足够谨慎，怀疑自己正被调查，的确可能放一艘「空船」去柔灯港，进而观察执法机关的动向。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010111
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 402010111,
					"content": "但要小心，根据被捕犯人陆续供出的情报，被称为「诈狂」的盗宝团老手也在和「黑钱领主」合作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010112
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 402010112,
					"content": "「诈狂」是个亡命徒，最擅长暗中进行破坏，经过之前的调查，可以肯定，在小岛上观察千岩军灯语的眼哨就是他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010113
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 402010113,
					"content": "我会在附近走动，避免「诈狂」监视现场。趁此机会，你们便可以调查货物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010114
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 402010114,
					"content": "行动时，请保持低调。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010115,
						402010116
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 402010115,
					"content": "明白，我会小心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010117
					]
				},
				{
					"id": 402010117,
					"content": "#唔！我也会尽量…飞低一点！不能超过{NICKNAME}的肩膀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402010116,
					"content": "我办事，你放心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010117
					]
				},
				{
					"id": 402010108,
					"content": "我们要提前调查货物吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010109
					]
				},
				{
					"id": 402010103,
					"content": "有动静了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010104
					]
				}
			]
		},
