				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"祖尔宛"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 737000101,
					"content": "不知不觉训练也进行到后半了。进展还顺利吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000102,
						737000103
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 737000102,
					"content": "可以说是渐入佳境。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737000104
					]
				},
				{
					"id": 737000104,
					"content": "不过斯露莎在给我们讲故事的时候，的确有反思的意思？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737000105,
					"content": "对话对于斯露莎来说是很好的学习方法。特别是当对话的对象不是矫论团那帮无趣的家伙的时候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000106
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 737000106,
					"content": "#前辈这话未免有些太武断了…{NICKNAME}作为「谒颂主」是很出众，但矫论团的人也并不全是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000107
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737000107,
					"content": "或许在吹捧与欺瞒之外也有零星被遗漏的美德吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000108
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 737000108,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000109
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737000109,
					"content": "#看你不服气的样子，稍后正好让{NICKNAME}和派蒙两位见证者来评价一下。当然，在你的讲述之后。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 737000103,
					"content": "还有进步的空间。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737000104
					]
				}
			]
		},
		{
			"id": 7370006,
			"completionStepIds": [
				7370006
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7370006",
							"2"
						],
						"stepId": 7370006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"斯露莎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 737000601,
					"content": "好安静啊，谁也不在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737000602,
					"content": "就算拉沙鲁在这里，应该也会很安静吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000603
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737000603,
					"content": "嗯，不过如果她在的话，咱们说话可就得小声点了。她总是一副困困的样子，之前被我们用俱利鼓吵醒的时候也有些不高兴呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737000604,
					"content": "听说越是沉默寡言的家伙，真的发起火来越是可怕。不知道拉沙鲁大发雷霆会是什么样子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737000605,
					"content": "这么说来，吾之「谒颂主」才是最让人害怕的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000606
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737000606,
					"content": "#欸？我最了解{M#他}{F#她}了，这家伙虽然话很少，但是其实很温柔的。对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000607,
						737000609
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737000607,
					"content": "我要认真生气了，嗷呜嗷呜。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737000608
					]
				},
				{
					"id": 737000608,
					"content": "你看，一点也不可怕嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000611
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737000611,
					"content": "好了，还是说回正事吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000612
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737000612,
					"content": "如你们所见，这棵树被称为「跋尔松」，花灵拉沙鲁是「跋尔松」之眷属，不过她现在不在此处。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000613
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737000613,
					"content": "然后呢然后呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000614
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737000614,
					"content": "然后？没有然后了，关于拉沙鲁和「跋尔松」，已经没什么可补足的了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000615
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737000615,
					"content": "总觉得斯露莎在遮掩些什么…对了，关于俱利鼓…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000616
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737000616,
					"content": "遮、遮掩？没有这回事。至于俱利鼓…你们不是已经见识过了么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000617
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737000617,
					"content": "对了，记得当时拉沙鲁说俱利鼓是被她扔在了不同的地方，那先朱那还大吃一惊呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000618
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737000618,
					"content": "没记错的话，斯露莎当时慌慌张张的，也没有回应那先朱那的质疑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000619
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737000619,
					"content": "这样看来，矫论团的文献典籍真的错得离谱呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000620
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737000620,
					"content": "虽然按鼓谱演奏确实唤醒了拉沙鲁。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737000621
					]
				},
				{
					"id": 737000621,
					"content": "好像知道为什么祖尔宛信不过现在的矫论团了，仔细想想，他们真的帮上忙了吗？从矫论团得知的线索几乎都是半真半假的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000622
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737000622,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000623
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737000623,
					"content": "现在的矫论团是有一些不怎么可靠的成员，但是就像大树，无论多繁茂，总会有些枯枝败叶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000624
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737000624,
					"content": "只要这些枯枝败叶都散去了，剩下的…剩下的就一定是坚定可靠的…唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000625
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737000625,
					"content": "…矫论团怎么会变成现在这个样子？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000626
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737000626,
					"content": "我也想知道这个问题的答案。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737000627
					]
				},
				{
					"id": 737000627,
					"content": "正因为一直和矫论团的人类在一起，对于他们的种种变化反而难以察觉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000628
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737000628,
					"content": "只有在和你们这样的外来者对话时才发现，原来矫论团早已不是过去的样子了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000629
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737000629,
					"content": "毕竟都过去几百年了嘛，除了「矫论团」这个名字还和以前一样，其中的成员一定都历经了好几代人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000630
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737000630,
					"content": "我所希求的声名，由人类「谒颂主」所传颂的声名难道最后也会像这样…一切都改变了，只有空虚的名号本身仍存。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000631
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737000631,
					"content": "前辈就是想让我知道这件事吗？不应该是这样的…可是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000632
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737000632,
					"content": "…斯露莎也不要这么沮丧嘛！说不定…说不定祖尔宛不是这个意思…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000633
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737000633,
					"content": "看到斯露莎没精打采的样子，总觉得自己做了什么坏事一样…之后还是让祖尔宛来劝劝她好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737000609,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737000610
					]
				},
				{
					"id": 737000610,
					"content": "#…{NICKNAME}你还是说点什么吧！一言不发的样子真的有点吓人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000611
					],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}