	"talks": [
		{
			"id": 7370001,
			"completionStepIds": [
				7370001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7370001",
							"2"
						],
						"stepId": 7370001,
						"stateName": "QUEST_STATE_UNFINISHED"
