						727180103
					],
					"speakerTitle": "松本"
				},
				{
					"id": 727180103,
					"content": "说不定在意想不到的地方，反而存在着厨艺超凡的高人，所以我才发布了那个委托。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727180104
					],
					"speakerTitle": "松本"
				},
				{
					"id": 727180104,
					"content": "好了，你既然过来了，那五份提瓦特煎蛋也一定准备好了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727180107,
						727180105
					],
					"speakerTitle": "松本"
				},
				{
					"id": 727180107,
					"content": "准备好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 727180105,
					"content": "还没有。",
