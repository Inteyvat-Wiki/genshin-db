						735340303
					],
					"speakerTitle": "幼光"
				},
				{
					"id": 735340303,
					"content": "要是能通过梦境疗法消灭我的噩梦就太好了，感激不尽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
