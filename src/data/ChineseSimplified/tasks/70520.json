				7052001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7052001",
							"2"
						],
						"stepId": 7052001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"伯恩哈德",
					"马茨",
					"保琳",
					"阿贝多"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705200101,
					"content": "荣誉骑士，派蒙！有个好消息要告诉你们！我们有新的帮手了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200102
					],
					"speakerTitle": "伯恩哈德"
				},
				{
					"id": 705200102,
					"content": "这两位店主听说了义卖的事后，想要加入我们，将收益捐献出来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200103
					],
					"speakerTitle": "伯恩哈德"
				},
				{
					"id": 705200103,
					"content": "欸？捐献？真的没关系吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705200104,
					"content": "没事没事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200105
					],
					"speakerTitle": "马茨"
				},
				{
					"id": 705200105,
					"content": "多一份资金，就多一位受益人，我和保琳小姐都觉得比我们埋头赚钱更重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200106
					],
					"speakerTitle": "马茨"
				},
				{
					"id": 705200106,
					"content": "这次佳酿节的客人比往年更多，我们提前完成了经营计划，早就心满意足了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200107
					],
					"speakerTitle": "保琳"
				},
				{
					"id": 705200107,
					"content": "不能只让你们为老人和孩子们忙前忙后，我们也想尽可能帮上忙，请不要有心理负担。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200108
					],
					"speakerTitle": "保琳"
				},
				{
					"id": 705200108,
					"content": "由衷感谢你们。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705200109
					]
				},
				{
					"id": 705200109,
					"content": "嗯，感觉心里暖暖的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705200110,
					"content": "不过这下就得换个名字了吧！那就改叫…「西风哗哗义卖联盟」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200111,
						705200112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705200111,
					"content": "这风还变大了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705200113
					]
				},
				{
					"id": 705200113,
					"content": "让我们一起拿出全力，办好这次义卖活动吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705200114,
					"content": "两位店主加入了队伍，义卖活动的规模扩大了…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705200115
					]
				},
				{
					"id": 705200115,
					"content": "来这边瞧瞧吧，「西风哗哗义卖联盟」的特色小吃、日用百货和鲜花哦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705200116,
					"content": "欸？快看快看，阿贝多来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705200117,
					"content": "#{NICKNAME}和派蒙，你们好啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200118,
						705200119
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 705200118,
					"content": "欢迎光临。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705200120
					]
				},
				{
					"id": 705200120,
					"content": "阿贝多是要采购什么东西吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705200121,
					"content": "我没有什么特别需要的。只是听说，骑士团的店铺由你们管理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200122
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 705200122,
					"content": "正好我和蒂玛乌斯的研究有了进展，就给你们带了一批成品过来，算是对这次义卖活动的赞助吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200123
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 705200123,
					"content": "居然是专程来赞助我们的吗！好感动！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705200124,
					"content": "让我看看…瓶子里装着什么好东西？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705200125,
					"content": "是特效醒酒汤剂。能让喝醉的人恢复清醒，有效缓解头疼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200126
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 705200126,
					"content": "请将它们免费提供给有需要的人吧。这些赠品应该也会为你们吸引更多的顾客。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200127
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 705200127,
					"content": "这么有用的东西，是费了不少工夫才做出来的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705200128,
					"content": "哦？是我太久没露一手了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200129
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 705200129,
					"content": "过去的我，可能不会太在意这类研究吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200130
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 705200130,
					"content": "但能以炼金术的产物为人们的生活带来便捷，的确是一件好事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200131
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 705200131,
					"content": "嗯！虽然我是没有醉酒的经历啦，但我也能想象得出来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705200132,
					"content": "要是刚刚享受完了美酒，就一个脚滑掉进湖里去，或者是被石头绊倒，好心情也会溜走的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705200133,
					"content": "我们也不能白收好处。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705200134
					]
				},
				{
					"id": 705200134,
					"content": "嗯，阿贝多就带一些吃的回去吧，还能和小可莉一起分享，算我们请你的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705200135,
					"content": "好，那我也就不推辞了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200136
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 705200136,
					"content": "想不到，你们有那么出色的商业头脑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200137
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 705200137,
					"content": "小吃店的定位很精妙，不仅契合节日的气氛，分工上也很适合你们两位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200138
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 705200138,
					"content": "如果是由其他骑士团成员负责的话，一般都只会售卖杂货吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200139
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 705200139,
					"content": "哇，被阿贝多夸了夸，我简直就像喝了醒酒汤一样神清气爽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200140
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705200140,
					"content": "欸，不过这样一说，阿贝多对义卖了解得很清楚呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200141
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705200141,
					"content": "嗯，以往骑士团向大家征集杂物用于义卖的时候，我提供过十来张风景画。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200142
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 705200142,
					"content": "阿贝多的画，应该很值钱！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200143
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705200143,
					"content": "派蒙的想法倒是和那些商人一致。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200144
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 705200144,
					"content": "确实有人觉得我的画法少见，有投资价值，就花大价钱买下了它们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200145
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 705200145,
					"content": "再加上之前一些写生画的拍卖收益不错…艾莉丝女士似乎察觉了什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200146
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 705200146,
					"content": "她用她独特的渠道为我的作品申请了认证…记得是叫「专利」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200147
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 705200147,
					"content": "后来，有不少画家模仿我的风景画，它们也成了蒙德城里相当常见的挂饰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200148,
						705200149
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 705200148,
					"content": "有点印象…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705200150
					]
				},
				{
					"id": 705200150,
					"content": "根据艾莉丝女士的「专利」规则，画家们每次出售这种风景画，都需要向我支付一定比例的费用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200151
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 705200151,
					"content": "财富向来不是我的目标，我不关心它的去处，就全权委托给骑士团管理了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200152
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 705200152,
					"content": "要我来出主意的话…嗯，拿去修缮艾莉丝女士造成的破坏也挺合适的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200153
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 705200153,
					"content": "但听说，他们最终还是把它用在了慈善事业上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200154,
						705200155
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 705200154,
					"content": "明明没有参加过义卖…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705200156
					]
				},
				{
					"id": 705200156,
					"content": "该说不愧是你吗，阿贝多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200157
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705200157,
					"content": "虽然我的本意并非如此，但既然有意外的收获，我也慢慢学会接受它了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200158,
						705200160
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 705200158,
					"content": "为你高兴。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705200159
					]
				},
				{
					"id": 705200159,
					"content": "#谢谢你，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200162
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 705200162,
					"content": "那今天我先回工坊了，预祝你们经营顺利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200163
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 705200163,
					"content": "也谢谢你的赞助，阿贝多，研究也要顺利呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200164
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705200164,
					"content": "花时间亲手制作了小吃，给阿贝多带上了…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705200165
					]
				},
				{
					"id": 705200165,
					"content": "有空再来玩哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705200160,
					"content": "想学画画。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705200161
					]
				},
				{
					"id": 705200161,
					"content": "当然，我乐于分享经验。不过…唔，还是要多练习。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200162
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 705200155,
					"content": "却达成了相同的目标…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705200156
					]
				},
				{
					"id": 705200149,
					"content": "原来是你的手笔…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705200150
					]
				},
				{
					"id": 705200119,
					"content": "好久不见。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705200120
					]
				},
				{
					"id": 705200112,
					"content": "哗哗——",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705200113
					]
				}
			]
		},
		{
			"id": 7052002,
