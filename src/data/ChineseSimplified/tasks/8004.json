			},
			"dialogs": [
				{
					"id": 80040301,
					"content": "这里是…一座城市！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80040302,
					"content": "在空中的，倒立的，一整座城市？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040303,
						80040304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80040303,
					"content": "令人震撼的景象…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040402
					]
				},
				{
					"id": 80040402,
					"content": "#看着这座城市，{NICKNAME}，你会不会想起些什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80040403,
					"content": "唔，是什么来着…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80040404,
					"content": "「污秽逆位神像」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040405
					]
				},
				{
					"id": 80040405,
					"content": "对的对的！就是这个，又诡异，又是倒立的，还有一些震撼的感觉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80040406,
					"content": "这样说的话，难道层岩巨渊的下面真的会跟深渊教团有关吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80040407,
					"content": "我们要想办法去调查一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80040408,
					"content": "…啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80040409,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040410,
						80040411
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80040410,
					"content": "戴因斯雷布？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040412
					]
				},
				{
					"id": 80040412,
					"content": "我也没料到会在这里遇上你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040413
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80040413,
					"content": "好久不见，戴因…不对，你为什么会突然出现在层岩巨渊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80040414,
					"content": "层岩巨渊…这里是层岩巨渊之下么，连我也未曾涉足过的地方…原来是这样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040415
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80040415,
					"content": "我有很多事情要问你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040416
					]
				},
				{
					"id": 80040416,
					"content": "那次的「相见」与「分别」都有些仓促，我能理解你的心情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040417
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80040417,
					"content": "而从眼前的这份巧合来看，命运确实欠你一个解答。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040418,
						80040419
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80040418,
					"content": "先解释一下你是怎么出现在这里的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040420
					]
				},
				{
					"id": 80040420,
					"content": "应该不难猜才对。我之前又捕捉到一名深渊使徒的动向，并开始了追迹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040421
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80040421,
					"content": "只可惜，那家伙被我逼入绝路后，又玩起了老把戏…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040422
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80040422,
					"content": "我紧随其后穿过了传送门，果不其然，还是错误的地点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040423,
						80040424
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80040423,
					"content": "这么说来，之前那次你穿过传送门…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040425
					]
				},
				{
					"id": 80040425,
					"content": "嗯，透过近期的一些经历，我只能推断…深渊操控着的传送能力，似乎不只是点对点，而是一个完整的网状结构。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040426
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80040426,
					"content": "传送门的对面可能是传送网络中的任何一个节点，这由他们来决定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040427
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80040427,
					"content": "听起来和传送锚点也有些相似呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040428
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80040428,
					"content": "总之，尽管那次我紧随着你的血亲进入了传送门，可当我认清四周的时候…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040429
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80040429,
					"content": "…却发现自己已经独自一人，身处那条风魔龙的巢穴之中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040430
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80040430,
					"content": "哦，说起来，那颗第一台「耕地机」的眼睛怎么样了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040431
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80040431,
					"content": "我已经安顿好了，在搞清楚那所谓「命运的织机」计划的真面目之前，无需担忧它落入深渊之手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040432,
						80040433
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80040432,
					"content": "请你重新自我介绍一下吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040434
					]
				},
				{
					"id": 80040434,
					"content": "哼，你记住了这个名号么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040435
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80040435,
					"content": "并非我有意隐瞒。这个名号曾沐浴着坎瑞亚的荣光，可如今…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040436
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80040436,
					"content": "…更像一种讽刺，一种诅咒罢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040437
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80040437,
					"content": "作为见证了自己国度覆灭的宫廷卫队队长，我想我有理由不愿再提起这个名号。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040438
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80040438,
					"content": "#看来你的{PLAYERAVATAR#SEXPRO[INFO_FEMALE_PRONOUN_SISTER|INFO_MALE_PRONOUN_BROTHER]}说的都是真的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040439,
						80040440
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80040439,
					"content": "#关于我{PLAYERAVATAR#SEXPRO[INFO_FEMALE_PRONOUN_SISTER|INFO_MALE_PRONOUN_BROTHER]}的往事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040441
					]
				},
				{
					"id": 80040441,
					"content": "我们曾是「旅伴」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040442
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80040442,
					"content": "那是一段怀抱着苦痛不断搜寻命运的旅途，只不过…我们未能共同抵达「终点」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040443
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80040443,
					"content": "「旅途的终点」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040444
					]
				},
				{
					"id": 80040444,
					"content": "在你继续没完没了地发问之前，我有必要提示你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040445
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80040445,
					"content": "假如我对「传送网络」的猜测是正确的，刚刚我又恰巧被传送至此，那就证明在深渊教团眼里，此处存在着设立传送节点的价值。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040446
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80040446,
					"content": "你是说深渊教团准备在这里进行什么行动吗？这倒是跟我和旅行者的预感一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040447
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80040447,
					"content": "那么，此时此刻的我们…很有可能正在被「深渊」窥伺着。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040448
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80040448,
					"content": "别、别这么说，我好像有些毛骨悚然了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040449,
						80040450
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80040449,
					"content": "先进行调查吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040451
					]
				},
				{
					"id": 80040451,
					"content": "呵，明智。那边的岩壁附近似乎有火光，我们过去看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80040450,
					"content": "我暂且相信你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040451
					]
				},
				{
					"id": 80040440,
					"content": "你们之间究竟发生过什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040441
					]
				},
				{
					"id": 80040433,
					"content": "「末光之剑」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040434
					]
				},
				{
					"id": 80040424,
					"content": "#也没能追上我的{PLAYERAVATAR#SEXPRO[INFO_FEMALE_PRONOUN_SISTER|INFO_MALE_PRONOUN_BROTHER]}？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040425
					]
				},
				{
					"id": 80040419,
					"content": "刚才的传送门是怎么回事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040420
					]
				},
				{
					"id": 80040411,
					"content": "真是别样的出场方式。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040412
					]
				},
				{
					"id": 80040304,
					"content": "完全超乎了想象…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040402
					]
				}
			]
		},
