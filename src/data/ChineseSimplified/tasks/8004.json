			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凯瑟琳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80040101,
					"content": "啊旅行者，可真是巧啊，呵呵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040102
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 80040102,
					"content": "凯瑟琳小姐，今天有什么委托吗？还有…你今天见到我们怎么好像格外开心的样子？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80040103,
					"content": "因为今天早些时候我去神社求签，巫女告诉我说，最近适合「意料之外的再会」哦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040104
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 80040104,
					"content": "凯瑟琳小姐会去神社求签？怎么感觉是非常非常稀奇的景象！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80040105,
					"content": "不对，重点是你一天之内去稻妻跑了个来回吗？这里可是璃月欸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80040106,
					"content": "呵呵，哪怕是我，也偶尔会有些私生活的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040107
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 80040107,
					"content": "所以你说「意料之外的再会」，指的是和我们吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80040108,
					"content": "谁知道呢，至少有了这份期待，就感觉见到谁都会很开心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040109
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 80040109,
					"content": "好吧…明明我们几乎每天都要见面的，凯瑟琳小姐开心就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040110,
						80040111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80040110,
					"content": "意料之外的再会…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040112
					]
				},
				{
					"id": 80040112,
					"content": "#你是说…嗯，我理解你的心情，{NICKNAME}，如果巫女所说的真能灵验就好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80040113,
					"content": "#你的{PLAYERAVATAR#SEXPRO[INFO_FEMALE_PRONOUN_SISTER|INFO_MALE_PRONOUN_BROTHER]}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80040114,
					"content": "我是不是…说了什么不该说的话呢？看到你们好像有些沮丧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040115
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 80040115,
					"content": "没事没事，凯瑟琳小姐，我们还是回到委托的话题吧，有没有什么适合我们的委托呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80040116,
					"content": "嗯，正巧有一位矿工大哥的委托，似乎是关于层岩巨渊的调查。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040117
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 80040117,
					"content": "欸，那边难道已经解除封锁了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80040118,
					"content": "那么具体情况就让委托人再详细与你们沟通吧，他叫玥辉，现在应该就在层岩巨渊的附近。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040119
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 80040119,
					"content": "好的，凯瑟琳小姐，那我们就动身啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80040120,
					"content": "嗯，向着星辰与深渊…唔，这次好像真的是向着「深渊」呢，祝两位好运。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 80040111,
					"content": "或许…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040112
					]
				}
			]
		},
		{
			"id": 800402,
			"completionStepIds": [
				800402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800402",
							"2"
						],
						"stepId": 800402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"玥辉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80040201,
					"content": "你好！是那个…那个玥辉吗？我们是冒险家协会派来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80040202,
					"content": "哦，幸会幸会，确实是我发布的委托。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040203
					],
					"speakerTitle": "玥辉"
				},
				{
					"id": 80040203,
					"content": "嗯？这位看起来好像有点眼熟…是很有名的冒险家么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040204,
						80040205
					],
					"speakerTitle": "玥辉"
				},
				{
					"id": 80040204,
					"content": "我的来历比较复杂。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040206
					]
				},
				{
					"id": 80040206,
					"content": "这样啊，好吧。先自我介绍一下，我是前不久才拿到层岩巨渊开采许可的矿工，手下有一些跟着我的兄弟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040207
					],
					"speakerTitle": "玥辉"
				},
				{
					"id": 80040207,
					"content": "居然可以拿到层岩巨渊的开采许可？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80040208,
					"content": "嗯，玉京台那边终于也开窍了，在千岩军的保护下，开始准许一些仅限于浅表范围的矿物开采，我们还是第一批。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040209
					],
					"speakerTitle": "玥辉"
				},
				{
					"id": 80040209,
					"content": "可最近发生了一些事情，矿工兄弟们都有些人心惶惶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040210
					],
					"speakerTitle": "玥辉"
				},
				{
					"id": 80040210,
					"content": "发生了什么事？我们好像没听说过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80040211,
					"content": "嗯…这件事说大不大，说小不小，只是有些诡异…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040212
					],
					"speakerTitle": "玥辉"
				},
				{
					"id": 80040212,
					"content": "有个兄弟在休息的时候，忽然注意到几个丘丘人神情恍惚地路过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040213
					],
					"speakerTitle": "玥辉"
				},
				{
					"id": 80040213,
					"content": "而且这些丘丘人看都没看他一眼，只是径直朝着层岩巨渊深处去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040214
					],
					"speakerTitle": "玥辉"
				},
				{
					"id": 80040214,
					"content": "于是那个兄弟刻意留心观察了一段时日，发现时不时便会有类似的情况发生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040215
					],
					"speakerTitle": "玥辉"
				},
				{
					"id": 80040215,
					"content": "丘丘人难道也有好奇心吗？会不会只是来这边转转…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80040216,
					"content": "不，诡异的地方在于，他发现来到层岩巨渊的丘丘人们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040217
					],
					"speakerTitle": "玥辉"
				},
				{
					"id": 80040217,
					"content": "…从来都是「只进不出」的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040218
					],
					"speakerTitle": "玥辉"
				},
				{
					"id": 80040218,
					"content": "那些丘丘人的行迹永远都是单向的，进去之后就再也没有出来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040219
					],
					"speakerTitle": "玥辉"
				},
				{
					"id": 80040219,
					"content": "这段时间，类似的情况愈发频繁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040220
					],
					"speakerTitle": "玥辉"
				},
				{
					"id": 80040220,
					"content": "「那些丘丘人的目标究竟是什么」，「它们后来怎么样了」，「会不会是在酝酿什么灾厄」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040221
					],
					"speakerTitle": "玥辉"
				},
				{
					"id": 80040221,
					"content": "这些念头在矿工兄弟们的脑海中不断出现，很多人都要把自己吓得发疯了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040222
					],
					"speakerTitle": "玥辉"
				},
				{
					"id": 80040222,
					"content": "唔呃，我好像能理解…光是听上去就觉得有些头皮发麻…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040223,
						80040224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80040223,
					"content": "不敢想象层岩巨渊内部的画面…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040225
					]
				},
				{
					"id": 80040225,
					"content": "是啊，可能源于未知的恐惧才是最深的恐惧吧。只有查明了真相，兄弟们才能安心干活啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040226
					],
					"speakerTitle": "玥辉"
				},
				{
					"id": 80040226,
					"content": "我们…我们真的要接这个委托吗？那个，矿工大哥，让我们再考虑一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040227
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80040227,
					"content": "交给我们吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040228
					]
				},
				{
					"id": 80040228,
					"content": "喂！你也照顾一下我的意见呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040229,
						80040230
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80040229,
					"content": "类似这样的诡异情况…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040231
					]
				},
				{
					"id": 80040231,
					"content": "原来你是这样考虑的，唔…那、那好吧，或许真的藏着什么关于你血亲的线索呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040232
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80040232,
					"content": "不去的话，你会一直很在意的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040233
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80040233,
					"content": "二位决定要接下这个委托了吗？我可不想我的开采许可证就这么白费了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040234
					],
					"speakerTitle": "玥辉"
				},
				{
					"id": 80040234,
					"content": "嗯，就当是我们也想满足一下好奇心吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040235
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80040235,
					"content": "那可真是帮了大忙了，我这就告诉你们那些丘丘人去往的大致位置…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玥辉"
				},
				{
					"id": 80040230,
					"content": "我怀疑和「深渊教团」有所关联。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040231
					]
				},
				{
					"id": 80040224,
					"content": "确实是非常诡异的事件…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040225
					]
				},
				{
					"id": 80040205,
					"content": "还是直接说正事吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040206
					]
				}
			]
		},
		{
