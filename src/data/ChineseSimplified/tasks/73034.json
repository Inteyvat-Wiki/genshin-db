			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730340201,
					"content": "唔？你在看什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730340202,
					"content": "这笔记本里写着照顾花的方法。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730340203
					]
				},
				{
					"id": 730340203,
					"content": "真的吗？我也看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730340204,
					"content": "「…需要安置于开阔地带，多接受日照…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730340205,
					"content": "柯莱应该是没来得及把它给搬出去吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730340206,
					"content": "嘿嘿，那我们来帮柯莱照顾一下这盆花吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730340207,
					"content": "唔…总之，先把这盆花搬出去，就放在屋子旁边吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730340208,
					"content": "也别放太远了，不然柯莱回来找不到的话该着急了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7303406,
			"completionStepIds": [
				7303406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7303406",
							"2"
						],
						"stepId": 7303406,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730340601,
					"content": "咦？这封信…看起来好像是柯莱留下的，我们去看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730340602,
					"content": "但她人怎么还是不在…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730340603
					]
				},
				{
					"id": 730340603,
					"content": "也许又是和提纳里一起出去工作了吧，他们一直都很忙的样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730340604,
					"content": "还是快看看信吧。看这笔迹，柯莱下笔的时候可真用力呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730340605,
					"content": "#「{NICKNAME}和派蒙，谢谢你们帮我照料这盆花。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730340606,
					"content": "「这段时间林子里有太多事要处理，我一忙起来就会忘记打理…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340607
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730340607,
					"content": "「再次谢谢你们帮忙，等我有空了，我们一起去贾汉吉尔先生的店里吃『土豆船』吧！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340608
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730340608,
					"content": "喔！你看，柯莱说要请我们吃好吃的！记下来记下来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340609
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730340609,
					"content": "就是不知道柯莱到底在处理什么事，感觉她都要忙不过来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340610
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730340610,
					"content": "希望她能好好休息，别累坏了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}