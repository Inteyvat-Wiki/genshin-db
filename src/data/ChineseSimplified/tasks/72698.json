					"speakerTitle": "大久保三左卫门"
				},
				{
					"id": 726980109,
					"content": "来吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726980110
					]
				},
				{
					"id": 726980110,
					"content": "那么，别怪我剑下不留情了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大久保三左卫门"
				},
