			"dialogs": [
				{
					"id": 210340501,
					"content": "旅行者，你已经把那片营地里的魔物都清理掉了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340502,
						210340503
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 210340502,
					"content": "已经清理干净了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340504
					]
				},
				{
					"id": 210340504,
					"content": "只是一些寻常魔物，没有费太多力气。而且我的运气不错，找到了一枚颇有价值的长剑碎片。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340505
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 210340505,
					"content": "我那边没有发现…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340506
					]
				},
				{
					"id": 210340506,
					"content": "无需挂怀，你也算是帮我排除了一处错误地点，多谢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340507
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 210340507,
					"content": "这些报酬是给你的，请收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340508,
						210340509
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 210340508,
					"content": "要是能找到所有碎片…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340510
					]
				},
				{
					"id": 210340510,
					"content": "我想做的很简单，那就是…重铸「藏锋」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340511
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 210340511,
					"content": "虽然原来铸造「藏锋」时所用的图纸已经遗失，我也不知道到底用了什么材料铸造…但总会有办法的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340512
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 210340512,
					"content": "如果我真能重铸「藏锋」，那兄长他想必也…唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "岚姐"
				},
				{
					"id": 210340509,
					"content": "你找这些碎片做什么？",
