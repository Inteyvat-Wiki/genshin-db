			"dialogs": [
				{
					"id": 210340101,
					"content": "哼，看来这家伙就在这里了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340102,
						210340103
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 210340102,
					"content": "岚姐？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340104
					]
				},
				{
					"id": 210340104,
					"content": "旅行者，没想到能在这里遇见你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340105
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 210340105,
					"content": "你还记得上次你们帮我找到的那个剑柄吗？它确实是「藏锋」的一部分…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340106
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 210340106,
					"content": "说来好笑，我之所以能把它分辨出来，是因为我小时候偷偷拿刀在上面刻了记号…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340107
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 210340107,
					"content": "那时我和兄长说，如果他之后换了其他的剑，那一定要把「藏锋」送给我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340108
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 210340108,
					"content": "呵呵，我们两个那时候应该都没想到…我居然是以这种形式拿到的「藏锋」。看来，这柄剑…真的已经碎了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340109
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 210340109,
					"content": "好了，闲话就不说了。既然在这里遇见了你，那我还要请你再帮我一个忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340110
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 210340110,
					"content": "前面是两处魔物聚集地，这群魔物四处搜集了不少破损的武器，放在营地里不知作何用途。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340111
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 210340111,
					"content": "协会担心它们扰乱周边，本来打算挂出委托，但我看见之后就自己揽了下来…也许，我能从这里再找到一些「藏锋」的碎片…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340112
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 210340112,
					"content": "旅行者，我们就各去扫清一片营地吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340113
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 210340113,
					"content": "左边的营地聚集着一群丘丘人，虽然对你来说，单个丘丘人并不难对付…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340114
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 210340114,
					"content": "但这里丘丘人的数量不少，如果它们一拥而上，只怕你也需要费一番手脚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340115
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 210340115,
					"content": "右边是一个「丘丘岩盔王」，它的危险程度…我应该也不用解释了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340116
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 210340116,
					"content": "是我请你帮的忙，就由你先选一片营地吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "岚姐"
				},
				{
					"id": 210340103,
					"content": "你怎么在这里？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340104
					]
				}
			]
		},
