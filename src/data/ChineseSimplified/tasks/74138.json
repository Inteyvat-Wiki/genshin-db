				]
			},
			"dialogs": [
				{
					"id": 741380101,
					"content": "嘿，回来了吗？你们刚才可错过了一场好戏啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380102
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741380102,
					"content": "好戏？发生什么事了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741380103,
					"content": "刚刚我带着回收来的水母，在这里等奥格劳先生核查。结果奥格劳先生还没来，之前的买家倒是找上门了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380104
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741380104,
					"content": "他们说自从放生了前几批水母，这人也精神了，生意也顺畅了，一定是做了好事，有神明眷顾！所以就想找我再买一批去放生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380105,
						741380106
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741380105,
					"content": "我这边还在抓…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741380107
					]
				},
				{
					"id": 741380107,
					"content": "#唔唔…{NICKNAME}抓，基肖恩先生卖，买家再去放生…喂！你难道是在用这个方法赚钱吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741380108,
					"content": "没有！没有！怎么可能！？我可不想再被警备队的人找麻烦了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380109
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741380109,
					"content": "咳咳…我跟他们说明了好久，放生这些水母有害无益，可他们就是不听！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380110
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741380110,
					"content": "愣是觉得自己最近走了好运，就是因为做了这种…他们所认为的好事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380111
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741380111,
					"content": "还觉得我接连倒霉，也是囚禁水母带给我的报应。唉…这帮人到底在想什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380112
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741380112,
					"content": "我们还在争辩着呢，奥格劳先生就来了，直接把这群人扣了回去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380113,
						741380114
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741380113,
					"content": "好运到头了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741380115
					]
				},
				{
					"id": 741380115,
					"content": "…说到底，不去了解生物的习性和生态就胡乱放生，为的究竟是这些生命，还是自己的好运呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380116
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741380116,
					"content": "最后还被警备队抓走了…看起来也没多少好运嘛？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741380117,
					"content": "哈，顺带一提，警备队已经免了我的牢狱之灾，多亏有你们帮忙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380118
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741380118,
					"content": "除了之前说好的报酬，我还准备了一点纪念品，请不要客气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380119
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741380119,
					"content": "基肖恩取出了一只水母球…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741380120
					]
				},
				{
					"id": 741380120,
					"content": "欸…这个是？「荧光紫水母」？看着比之前的小好多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741380121,
					"content": "没错，昨天我从库存的水母苗里挑了一些合适的样本，挨个记录编号后又多出了几只，我想…不如就送给你们，做个纪念吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380122
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741380122,
					"content": "剩下的水母我会带回去继续培育，看看怎么让它们在自然环境下野化。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380123
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741380123,
					"content": "而且我也打算留下一些「荧光紫水母」的样本，研究研究聚集发光的成因…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380124,
						741380125
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741380124,
					"content": "看起来还挺可爱的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741380126
					]
				},
				{
					"id": 741380126,
					"content": "等、等等——你可千万别再把它们放生了啊！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741380125,
					"content": "放水里游起来会不会更可爱…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741380126
					]
				},
				{
					"id": 741380114,
					"content": "自作自受呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741380115
					]
				},
				{
					"id": 741380106,
					"content": "你居然还在卖…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741380107
					]
				}
			]
		}
	]
}