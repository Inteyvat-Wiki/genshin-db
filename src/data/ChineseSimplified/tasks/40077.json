			"dialogs": [
				{
					"id": 400770201,
					"content": "（这位研究员遭到万叶制裁后有过片刻清醒，可没多久又晕了过去…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770202
					]
				},
				{
					"id": 400770202,
					"content": "（到底是他本就神志不清，还是被摔晕了呢？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 4007707,
			"completionStepIds": [
				4007707
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007707",
							"2"
						],
						"stepId": 4007707,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"莫娜",
					"枫原万叶",
					"愚人众士官",
					"愚人众新兵",
					"菲谢尔",
					"辛焱",
					"奥兹"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400770701,
					"content": "都放进去了，莫娜，这样就行了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770702
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400770702,
					"content": "应该是吧，反正手稿是这么写的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770703
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400770703,
					"content": "稍等片刻吧。希望它能恢复正常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770704
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400770704,
					"content": "大家席地而坐，就着火堆烤了些食物边吃边聊。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400770705
					]
				},
				{
					"id": 400770705,
					"content": "装置修复后，情况果真有所好转。很快，远处传来了脚步声…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400770706
					]
				},
				{
					"id": 400770706,
					"content": "啊！有人在我们的营地里！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770707
					],
					"speakerTitle": "愚人众士官"
				},
				{
					"id": 400770707,
					"content": "喂，你们是什么人？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770708
					],
					"speakerTitle": "愚人众新兵"
				},
				{
					"id": 400770708,
					"content": "等等，你看那台装置，修、修好了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770709
					],
					"speakerTitle": "愚人众士官"
				},
				{
					"id": 400770709,
					"content": "欸？欸？可是佩尔西科夫先生还躺在那边的地上啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770710
					],
					"speakerTitle": "愚人众新兵"
				},
				{
					"id": 400770710,
					"content": "这台装置是我们修好的哦，你们应该谢谢我们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770711
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400770711,
					"content": "要不是被这些事打扰，我们本来可以度过一个完美无缺的假期。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770712
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400770712,
					"content": "哼！还不快过来向本皇女和诸位家臣致歉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770713
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400770713,
					"content": "啊？！不不不，我、我先走了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770714
					],
					"speakerTitle": "愚人众士官"
				},
				{
					"id": 400770714,
					"content": "喂，喂，别丢下我…佩尔西科夫先生还在那里，快回来救他啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770715
					],
					"speakerTitle": "愚人众新兵"
				},
				{
					"id": 400770715,
					"content": "哈哈哈，那两个人看起来很清醒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770716
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400770716,
					"content": "看来，修复成功了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770717
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400770717,
					"content": "太好啦！那我们别待在这里了，我想回自己的营地继续度假。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770718
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400770718,
					"content": "你说的，是可莉的营地吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770719
					]
				},
				{
					"id": 400770719,
					"content": "嗯！但我现在觉得，那里也是属于我们几个的营地了，就像临时的家一样，嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770720
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400770720,
					"content": "那里或许该被称为幽夜净土暨嘟嘟王国大使馆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770721
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 400770721,
					"content": "欸？不要啦，好难念。我还是喜欢用记得住的名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770722
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400770722,
					"content": "走吧走吧，我们快点回家去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4007708,
			"completionStepIds": [
				4007710
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007710",
							"2"
						],
						"stepId": 4007710,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"菲谢尔",
					"奥兹",
					"辛焱",
					"枫原万叶",
					"莫娜",
					"嘟嘟通讯仪",
					"温迪",
					"？？？"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400770801,
					"content": "呼啊——！回到家里大吃一顿，又在躺椅上躺了半天，总算是放松下来啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770802
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400770802,
					"content": "哦呵呵，幽夜净土的招待，汝还满意吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770803
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400770803,
					"content": "很喜欢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770804
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400770804,
					"content": "喜欢就好。小姐请诸位家臣过来，不仅想让各位见证我等圣国的降临，更是想让各位放松身心，欢度夏日。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770805
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 400770805,
					"content": "真好啊，我好喜欢这里，这次真是来对了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770806
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400770806,
					"content": "这里应该成为永远的乐土。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770807
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400770807,
					"content": "小姐的意思是，希望以后还能与你们一同外出游玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770808
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 400770808,
					"content": "一定！等你们有时间，也可以来璃月找我，我带你们四处转转。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770809
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400770809,
					"content": "哦对，璃月最好吃的饭店是我朋友家经营的，你们肯定喜欢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770810
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400770810,
					"content": "要是想听戏，也可以去找云堇，她人很好，又喜欢结交有趣的朋友，你们或许会在戏剧话题上很合得来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770811
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400770811,
					"content": "哦？辛焱卿极力推荐，我确实开始感兴趣了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770812
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400770812,
					"content": "#{NICKNAME}，我有个想法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770813
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400770813,
					"content": "稻妻有种小吃叫做烤堇瓜，配着鱼肉风味也不错。今晚不如我们也试着把水果和海鲜一起烤，如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770814,
						400770816
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400770814,
					"content": "好啊好啊！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770815
					]
				},
				{
					"id": 400770815,
					"content": "那就说定了，我会尽量多找些水果，调味的话…嗯，就这么办。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770823
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400770823,
					"content": "你们在这儿啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770824
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400770824,
					"content": "我发现一个问题。虽然我们已经修复装置，但你看，那些小岛上的幻境并未消失。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770825
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400770825,
					"content": "我也察觉到了。考虑到幻境诞生需要时间，消失可能也需要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770826
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400770826,
					"content": "嗯，也是一种可能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770827
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400770827,
					"content": "说起来，我的水占盘倒是完全恢复正常，可以用了。刚才占卜的结果也没有太大异常，只是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770828
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400770828,
					"content": "只是？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770829
					]
				},
				{
					"id": 400770829,
					"content": "只是，占卜结果中有些看不懂的东西…似乎有某种力量围绕在我们身侧，注视着我们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770830
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400770830,
					"content": "是装置造成的吗？还是佩尔西科夫？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770831
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400770831,
					"content": "抱歉，我也不清楚。只能确定这股力量目前不具有攻击性，应该是对我们没什么恶意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770832
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400770832,
					"content": "（这么说来，岛上还有一个问题没有解决，只是大家都不知道那件事。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770833
					]
				},
				{
					"id": 400770833,
					"content": "我会留意的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770834
					]
				},
				{
					"id": 400770834,
					"content": "嗯。虽说接下来没有干扰，可以尽情享受假日了，但离开海岛之前，我们还是要多加小心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770835
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400770835,
					"content": "我也会每日占卜的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770836
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400770836,
					"content": "我答应过菲谢尔会担任守卫一职，我也可以帮忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770837
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400770837,
					"content": "好，拜托了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770838
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400770838,
					"content": "…唉，谁让她们那么无忧无虑呀。这次的事，我多操心就是了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770839
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400770839,
					"content": "派蒙，跟我来！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770840
					]
				},
				{
					"id": 400770840,
					"content": "噢噢，来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770841
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400770841,
					"content": "到边上去。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770842
					]
				},
				{
					"id": 400770842,
					"content": "我明白了，是要联络卖唱的对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770843
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400770843,
					"content": "嘟嘟可——嘟嘟可——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770844
					],
					"speakerTitle": "嘟嘟通讯仪"
				},
				{
					"id": 400770844,
					"content": "哎呀哎呀，你们终于联系我了？还以为你们玩得太高兴，把我彻底忘掉了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770845
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 400770845,
					"content": "不是啦，卖唱的，我们遇到了很奇怪的事哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770846
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400770846,
					"content": "将这几天海岛上发生的所有事件详细告知温迪…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400770847
					]
				},
				{
					"id": 400770847,
					"content": "奇怪的装置？甚至能模仿神的能力？啊哈哈，愚人众还有这种计划吗，真是异想天开啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770848
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 400770848,
					"content": "听你的口气，是不知道这事咯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770849
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400770849,
					"content": "我只是个酒馆卖唱的吟游诗人而已，怎么可能知道这些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770850
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 400770850,
					"content": "这家伙，又开始了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770851
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400770851,
					"content": "#不过，撇开这些，{NICKNAME}，派蒙，这次你们玩得开心吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770852
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 400770852,
					"content": "开心！吃了好吃的东西，看了很多奇妙的景象，很不错哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770853,
						400770854
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400770853,
					"content": "体验很不错哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770855
					]
				},
				{
					"id": 400770855,
					"content": "啊哈哈，那就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770856
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 400770856,
					"content": "旅行的意义在于记录心情。只要能给你们留下难忘的体验，这次旅程就有意义。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770857
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 400770857,
					"content": "至于那个神秘的声音，虽然不知道是谁，但至少她没有让你们受到任何伤害，还让你们了解了彼此，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770858
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 400770858,
					"content": "从这一点说，她或许带着善意。否则她都能截断艾莉丝女士发明的通讯工具了，一定也可以成功袭击你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770859
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 400770859,
					"content": "唔，卖唱的说得对…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770860
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400770860,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770861
					]
				},
				{
					"id": 400770861,
					"content": "明白了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770862
					]
				},
				{
					"id": 400770862,
					"content": "啊哈哈，能让你放心些就好。你们就尽情地玩吧，等你回来，别忘了将海岛上的美丽幻境仔细说给我听。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770863
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 400770863,
					"content": "我想把这一切美好回忆记录下来，写进诗歌里。每个夏天，都会成为一段难忘的乐章。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770864
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 400770864,
					"content": "嗯，说好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770865
					]
				},
				{
					"id": 400770865,
					"content": "#那就等你回来喽。{NICKNAME}，假期愉快！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770866
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 400770866,
					"content": "既然卖唱的说不要紧，应该就没事了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770867
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400770867,
					"content": "毕竟，不管怎么说卖唱的也是个神呢，我们应该相信他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770868,
						400770869
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400770868,
					"content": "确实。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770870
					]
				},
				{
					"id": 400770870,
					"content": "那我们回去吧，别让大家久等了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770871
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400770871,
					"content": "刚才菲谢尔还说要去抓螃蟹，我也想去！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770872
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400770872,
					"content": "解决这次事件的你，是否感到满足快乐？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770873
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400770873,
					"content": "（这个声音是…！）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770874
					]
				},
				{
					"id": 400770874,
					"content": "别担心，我不会伤害你。倒不如说，我只是一只偶尔飞经这片海域的小鸟，正从遥远的地方望着你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770875
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400770875,
					"content": "只是偶然，这里竟然有与我相关的力量。我感到好奇，便降落在海滩上，悄悄窥视岛上的一切。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770876
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400770876,
					"content": "…真有趣啊。尽管忙于公务，那些来到海岛的人居然也会露出真心实意的笑容。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770877
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400770877,
					"content": "而后到的你们，更不用说，带来了璀璨的梦境与美丽的意志。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770878
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400770878,
					"content": "你们的幻梦，犹如海面上的气泡，剔透而脆弱。越是动人的泡影，越让我好奇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770879
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400770879,
					"content": "我不能出远门，很羡慕你们这些自由自在的人，所以，也帮着做了一些小设计，希望你们喜欢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770880
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400770880,
					"content": "你是谁？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770881
					]
				},
				{
					"id": 400770881,
					"content": "我说了，我没有目的，只是一只小鸟罢了。留在这里，是为了欣赏你们的喜怒哀乐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770882
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400770882,
					"content": "你是个特别的人，散发着别样色彩。我实在好奇，才以这种方式与你沟通。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770883
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400770883,
					"content": "不必在意我的名字。或许未来某一天，我们会在别处相见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770884
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400770884,
					"content": "到那时，你应该会认得我。呵呵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770885
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400770885,
					"content": "（声音消失了…她刚才是直接在我脑海中说话吗？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770886
					]
				},
				{
					"id": 400770886,
					"content": "喂，你在干什么啊！快跟上！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770887
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400770887,
					"content": "（…这是…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770888
					]
				},
				{
					"id": 400770888,
					"content": "（在别处相见吗…会是什么时候，在哪里呢？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 400770869,
					"content": "马马虎虎吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770870
					]
				},
				{
					"id": 400770854,
					"content": "整体算是满意。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770855
					]
				},
				{
					"id": 400770816,
					"content": "烤堇瓜不错哦，我吃过！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770817
					]
				},
				{
					"id": 400770817,
					"content": "是在稻妻吃的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770818
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400770818,
					"content": "几位稻妻朋友亲手给我烤的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770819
					]
				},
				{
					"id": 400770819,
					"content": "哈哈，那太好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770820
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400770820,
					"content": "我也打算像你一样，四处游历，广交好友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770821
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400770821,
					"content": "万叶的话，一定没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770822
					]
				},
				{
					"id": 400770822,
					"content": "#承你吉言，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770823
					],
					"speakerTitle": "枫原万叶"
				}
			]
		},
		{
			"id": 4007711,
