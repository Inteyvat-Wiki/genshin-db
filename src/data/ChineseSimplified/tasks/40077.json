			},
			"dialogs": [
				{
					"id": 400770101,
					"content": "在这里！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770102
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400770102,
					"content": "恭喜诸位，已寻得解决问题的关键！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770103
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 400770103,
					"content": "我看看…唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770104
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400770104,
					"content": "莫娜接过手稿，仔细研读…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400770105
					]
				},
				{
					"id": 400770105,
					"content": "果然，这组名为「知感拟态」的装置能对人脑产生影响，制造者就是前面那个研究员，他名叫佩尔西科夫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770106
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400770106,
					"content": "从手稿来看，愚人众上层并不支持佩尔西科夫的研究，甚至认为他走了弯路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770107
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400770107,
					"content": "但佩尔西科夫非常坚持要将已成型的装置投入实战。为此，他托关系调用人手，将整组装置拆分为多个部件，运到无人岛上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770108
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400770108,
					"content": "真亏他们能找到这座岛啊！果然不能小看愚人众的情报网呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400770109,
					"content": "佩尔西科夫一意孤行，在这里展开实验。参与实验的成员大都是愚人众下层士兵。他们签署过风险知情书。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770110
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400770110,
					"content": "…看来，他们真的认为这组装置能为愚人众带去收益。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770111
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400770111,
					"content": "装置的原理是什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770112
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400770112,
					"content": "那恐怕就是顶级机密了，手稿中并未详写。但佩尔西科夫提到，这组装置是仿照某位神明的权能制作而成。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770113
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400770113,
					"content": "意思是，有一位神明的权能和这些幻梦有关，而且愚人众还进行过了相关研究？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770114
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400770114,
					"content": "对。否则，他们无法模仿神明的权能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770115
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400770115,
					"content": "（居然还有这样的神明吗？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770116
					]
				},
				{
					"id": 400770116,
					"content": "总而言之，佩尔西科夫的实验过程并不顺利。装置启动后没几天就出现了故障，他们试图维修，没想到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770117
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400770117,
					"content": "毫无技术的愚人众士兵直接把装置搞得一团糟，连最最重要的晶核都被弹飞出去，不知掉到了哪个角落。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770118
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400770118,
					"content": "可见维修是一项多么重要的工作，请各位量力而为。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770119
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 400770119,
					"content": "虽说佩尔西科夫是个科学疯子，却也不想看着自己的部下遭遇不测。再说，如果不解决问题，他自己也会发疯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770120
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400770120,
					"content": "情急之下，佩尔西科夫孤身一人外出寻找晶核，可他是个体弱多病的研究员，根本没那个本事，只得放弃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770121
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400770121,
					"content": "跟着，佩尔西科夫竭尽全力找回那些因疯狂而走散的士兵，把他们带到隐蔽的山洞里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770122
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400770122,
					"content": "登岛那天我们遇到的应该就是这个阶段的他们，佩尔西科夫带着一个身材健壮的愚人众士兵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770123
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400770123,
					"content": "对，佩尔西科夫花了很大力气，将士兵们都聚集到洞穴中，开始想办法唤醒他们。他使用音乐、诗歌…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770124
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400770124,
					"content": "但都没什么用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770125
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400770125,
					"content": "我记得我们来过这里一次，那天谁都不在。这么看，佩尔西科夫就是在那天把所有人召集到了山洞里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770126
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400770126,
					"content": "嗯。最后几页有一个好消息和一个坏消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770127
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400770127,
					"content": "好消息是，佩尔西科夫从疯狂的士兵口中问到零零散散的信息，拼凑出了晶核的所在地…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770128
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400770128,
					"content": "而坏消息是，佩尔西科夫没能唤醒他们。随后他自己也受到影响，陷入了疯狂。手稿最后几页都是他发疯一样的乱涂乱画。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770129
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400770129,
					"content": "如此看来，这份差事又落到了我与家臣们头上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770130,
						400770131
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400770130,
					"content": "没想到，度假还要助人为乐…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770132
					]
				},
				{
					"id": 400770132,
					"content": "手稿里有张地图，这上面标明的应该就是晶核所在地了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770133
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400770133,
					"content": "没其他办法了，我们加油找回那些晶核吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400770131,
					"content": "有一种职责在身的感觉。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770132
					]
				}
			]
		},
