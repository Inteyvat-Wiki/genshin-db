				"points": []
			},
			"dialogs": [
				{
					"id": 400771101,
					"content": "喂！你们看那个人，是不是第一天我们见到的那个？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400771102,
					"content": "啊哈哈…嗝！都疯了，都滚吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771103
					],
					"speakerTitle": "佩尔西科夫"
				},
				{
					"id": 400771103,
					"content": "我们…我们永远不会醒来…但我是对的，我的宝贝，无敌…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771104
					],
					"speakerTitle": "佩尔西科夫"
				},
				{
					"id": 400771104,
					"content": "宝贝？他的什么宝贝？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771105
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400771105,
					"content": "创造奇迹的机械…绝非…不可能…嗝！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771106
					],
					"speakerTitle": "佩尔西科夫"
				},
				{
					"id": 400771106,
					"content": "看来，宝贝就是指那台装置了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771107
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400771107,
					"content": "烂醉如泥，哼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771108
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400771108,
					"content": "噢这扑面的酒气…小姐，请容我用翅膀为您扇风。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771109
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 400771109,
					"content": "太好了，也给我扇扇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771110
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400771110,
					"content": "那我也要。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400771111
					]
				},
				{
					"id": 400771111,
					"content": "当然。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771112
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 400771112,
					"content": "各位，我在附近看过了，没有其他人在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771113
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400771113,
					"content": "很奇怪不是吗？愚人众是一个组织，这里却只剩这位。而上一次来，我们甚至连这位也没找到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771114
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400771114,
					"content": "甚至就连上一次那位胖胖的先生也不见了。我猜…他们躲在其他地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771115
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400771115,
					"content": "至于原因，恐怕就要问眼前这位了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771116
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400771116,
					"content": "可是他醉得像头死猪一样，我们是不是还要等他？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400771117,
					"content": "降下惩戒的圣泉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771118
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400771118,
					"content": "小姐的意思是拿水浇他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771119
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 400771119,
					"content": "听起来不错，我们试试！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400771120,
					"content": "众人找出背囊里的水，毫不客气地对准这位愚人众研究员倒下…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400771121
					]
				},
				{
					"id": 400771121,
					"content": "呀，他睁眼了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400771122,
					"content": "唔…唔？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771123
					],
					"speakerTitle": "佩尔西科夫"
				},
				{
					"id": 400771123,
					"content": "喂，你是愚人众吧？能不能告诉我们这里到底发生了什么事，那台装置究竟有什么用？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771124
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400771124,
					"content": "…愚人…众…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771125
					],
					"speakerTitle": "佩尔西科夫"
				},
				{
					"id": 400771125,
					"content": "…哈哈哈！愚人众！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771126
					],
					"speakerTitle": "佩尔西科夫"
				},
				{
					"id": 400771126,
					"content": "噢，噢…愚昧无知的高层，你后悔了吧！哈哈，否定我的研究，逼我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771127
					],
					"speakerTitle": "佩尔西科夫"
				},
				{
					"id": 400771127,
					"content": "逼我…来到无人岛，做实验…宝贝！宝贝，呜呜呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771128
					],
					"speakerTitle": "佩尔西科夫"
				},
				{
					"id": 400771128,
					"content": "怎么还哭了，感觉他也受过很多委屈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400771129,
					"content": "…蔑视我…和我的宝贝发明！你们、你们…不懂得未来的胜算。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771130
					],
					"speakerTitle": "佩尔西科夫"
				},
				{
					"id": 400771130,
					"content": "唯有我的发明…能让大家征服世界…哈哈，哈哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771131
					],
					"speakerTitle": "佩尔西科夫"
				},
				{
					"id": 400771131,
					"content": "傻子，傻子，哈哈哈哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771132
					],
					"speakerTitle": "佩尔西科夫"
				},
				{
					"id": 400771132,
					"content": "呃啊…！不要打我，我不炸实验室了…对不起！不是故意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771133
					],
					"speakerTitle": "佩尔西科夫"
				},
				{
					"id": 400771133,
					"content": "不行啊，这个人疯疯癫癫的，根本没法交流。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771134
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400771134,
					"content": "第一天我们见到他的时候，他还不是这样，看来是在后几天受到了进一步影响，最终也陷入疯狂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771135
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400771135,
					"content": "呜、呜…我的手稿，手稿！只有这个…能救…救…呜呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771136
					],
					"speakerTitle": "佩尔西科夫"
				},
				{
					"id": 400771136,
					"content": "手稿？在哪里？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771137
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400771137,
					"content": "别凶我，别凶我呜呜呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771138
					],
