			"dialogs": [
				{
					"id": 701140201,
					"content": "多谢桑多涅小姐的招待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140202,
						701140203
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 701140202,
					"content": "（再这么坐一会儿吧。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701140204
					]
				},
				{
					"id": 701140204,
					"content": "好，我们后会有期。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 701140203,
					"content": "茶会时间该结束了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701140204
					]
				}
			]
		}
