			"dialogs": [
				{
					"id": 701140101,
					"content": "桑多涅小姐居然能抽空到蒙德来，真是不容易。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140102
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 701140102,
					"content": "之前在我研究「数秘阵列」的时候，你帮了我很多忙。我想当面向你表示感谢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140103
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 701140103,
					"content": "不必客气。这项课题本就是我专业之外的领域，它能完成更多还是桑多涅小姐你的功劳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140104
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 701140104,
					"content": "这是大家的功劳。咦？这么说来怎么没见杜林？我还以为他不能离你太远，你算是他的监护人呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140105
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 701140105,
					"content": "你的看法也不能说有错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140106
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 701140106,
					"content": "但最近他已经越来越能融入大家的谈话了，所以我在试着让他自己安排日常生活。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140107
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 701140107,
					"content": "你不会担心吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140108
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 701140108,
					"content": "会有一点。以前他独自行动，和一些性格较为强烈的人接触过后，就会…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140109
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 701140109,
					"content": "学到些奇奇怪怪的东西？模仿奇奇怪怪的口癖？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140110
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 701140110,
					"content": "嗯，很准确。桑多涅小姐也经历过类似的事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140111
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 701140111,
					"content": "呵，还用说吗？我可太懂了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140112
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 701140112,
					"content": "一般和法尔伽团长见面过后，我会时不时带杜林去砂糖那协助做些研究，让他静静心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140113
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 701140113,
					"content": "但和琴团长待太久的话，我又会带他去见见可莉。让他重新学会放松。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140114
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 701140114,
					"content": "你也真是不容易…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140115
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 701140115,
					"content": "照顾家人而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140116
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 701140116,
					"content": "桑多涅小姐又是怎么处理此类事情的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140117
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 701140117,
					"content": "啊？我才没心情去管这些乱七八糟的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140118
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 701140118,
					"content": "但在我看来，只要一个人本性不坏，就算受到再多影响，最终也还是会回归到他最本真的样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140119
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 701140119,
					"content": "唔…不错的观点。或许我也该尝试采纳此种想法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿贝多"
				}
			]
		},
