			"dialogs": [
				{
					"id": 728070301,
					"content": "你是…啊，是国外来的旅行者啊，找我有事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070302
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 728070302,
					"content": "关于柊千里的亲笔信…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070303
					]
				},
				{
					"id": 728070303,
					"content": "这封信，是柊小姐拜托你送来的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070304
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 728070304,
					"content": "这字迹，果然是她…真是太好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070305
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 728070305,
					"content": "谢谢你专门跑这一趟，旅行者。",
