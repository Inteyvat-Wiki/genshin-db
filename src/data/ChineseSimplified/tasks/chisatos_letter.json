			"dialogs": [
				{
					"id": 728070201,
					"content": "唉，真是头疼…你好，有事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070202
					],
					"speakerTitle": "真田"
				},
				{
					"id": 728070202,
					"content": "关于镰治…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070203
					]
				},
				{
					"id": 728070203,
					"content": "你说镰治少爷？你找他有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070204
					],
					"speakerTitle": "真田"
				},
				{
					"id": 728070204,
					"content": "（出示亲笔信）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070205
					]
				},
				{
					"id": 728070205,
					"content": "你说这是柊千里小姐的亲笔信？这个…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070206
					],
					"speakerTitle": "真田"
				},
				{
					"id": 728070206,
					"content": "不过，这封信要真是那位柊千里小姐的亲笔信…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070207
					],
					"speakerTitle": "真田"
				},
				{
					"id": 728070207,
					"content": "这件事你还是…还是直接去问问镰治少爷吧，他最近经常在桥那边散步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "真田"
				}
			]
		},
		{
			"id": 7280703,
			"completionStepIds": [
				7280703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
