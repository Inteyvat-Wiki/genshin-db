				"points": []
			},
			"dialogs": [
				{
					"id": 728070401,
					"content": "你好，欢迎光临「木南料亭」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070402
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 728070402,
					"content": "关于镰治订的点心…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070403
					]
				},
				{
					"id": 728070403,
					"content": "喔，镰治少爷订做的点心我已经准备好了，现在就拿给你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070404
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 728070404,
					"content": "但是，不知道镰治少爷是打算把这些点心送给谁呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070405
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 728070405,
					"content": "只是公家的往来罢了，木南小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070406
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 728070406,
					"content": "前段时间，柊慎介大人曾赠予了家父一批好茶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070407
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 728070407,
					"content": "家父知道柊慎介大人的爱女柊千里小姐喜爱点心，就叮嘱我备些点心寄送回去，也算是回礼了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070408
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 728070408,
					"content": "我担心寄送过去耗时太长，路途上又免不了颠簸…所以专门拜托这位旅行者帮我把点心带过去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070409
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 728070409,
					"content": "木南小姐，请把那些点心拿给我看看吧，我先清点一下，免得疏漏了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070410
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 728070410,
					"content": "喔…好的，这是点心，请您看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070411
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 728070411,
					"content": "确实很齐全，谢谢你，木南小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070412
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 728070412,
					"content": "我们去旁边吧，旅行者，不要挡在店门口了，我还有话要和你说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070413
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 728070413,
					"content": "这就是「通行凭证」了，你收好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070414
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 728070414,
					"content": "有了这凭证，你应该就可以自由出入离岛了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070415
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 728070415,
					"content": "谢谢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070416
					]
				},
				{
					"id": 728070416,
					"content": "不用谢，有了这凭证之后，你帮我送点心的时候也能更顺利一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070417
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 728070417,
					"content": "还有…还有这封信。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070418
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 728070418,
					"content": "这是你的亲笔信？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070419
					]
				},
				{
					"id": 728070419,
					"content": "是的，我挑了一封我觉得用词最…得体的，希望柊小姐读的时候不会觉得不快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070420
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 728070420,
					"content": "请你把这封信连同点心一起送给柊小姐吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070421
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 728070421,
					"content": "又要回去吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070422
					]
				},
				{
					"id": 728070422,
					"content": "呵呵，这次你可是拿着「通行凭证」回去的，出入应该都会十分自由了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070423
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 728070423,
					"content": "那拜托你了，旅行者，我也该回去处理公务了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070424
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 728070424,
					"content": "唉，什么时候我才能直接登门拜访呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
