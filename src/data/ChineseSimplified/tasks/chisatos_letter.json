			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"九条镰治"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728070301,
					"content": "你是…啊，是国外来的旅行者啊，找我有事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070302
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 728070302,
					"content": "关于柊千里的亲笔信…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070303
					]
				},
				{
					"id": 728070303,
					"content": "这封信，是柊小姐拜托你送来的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070304
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 728070304,
					"content": "这字迹，果然是她…真是太好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070305
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 728070305,
					"content": "谢谢你专门跑这一趟，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070306
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 728070306,
					"content": "「通行凭证」的事…既然是柊小姐亲自委托，我自然会办周全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070307
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 728070307,
					"content": "但是，这份「通行凭证」我还得回去准备一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070308
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 728070308,
					"content": "这样吧，你先去「木南料亭」那边等我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070309
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 728070309,
					"content": "为什么要去那里？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070310
					]
				},
				{
					"id": 728070310,
					"content": "这个…是我想请你帮我一个小忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070311
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 728070311,
					"content": "我其实…前段时间也想着给柊小姐寄些东西过去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070312
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 728070312,
					"content": "我本来写了封信，又找木南小姐订了些点心，准备一同寄去给柊小姐，权当做是礼物了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070313
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 728070313,
					"content": "但要是父亲发现我给柊小姐寄信，说不定会有些不快…我正想着怎么寄信呢，你就正好来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070314,
						728070320
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 728070314,
					"content": "只是一份礼物而已。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070315
					]
				},
				{
					"id": 728070315,
					"content": "父亲他是不太愿意我和柊小姐通信的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070316
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 728070316,
					"content": "我也明白他的顾虑，我身为九条家的族人，又是天领奉行的执行者之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070317
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 728070317,
					"content": "而柊小姐又是勘定奉行柊家的大小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070318
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 728070318,
					"content": "假如我与她交往过密，难免被有心人抓住话柄，借题发挥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070319
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 728070319,
					"content": "虽然这确实只是一份礼物，但在某些人眼中，却又不仅仅是一份礼物那么简单。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070326
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 728070326,
					"content": "呵呵，我还是别再说这些琐事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070327
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 728070327,
					"content": "旅行者，请你先去「木南料亭」等我吧，我批好「通行凭证」后，就拿去给你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 728070320,
					"content": "你父亲很严厉吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070321
					]
				},
				{
					"id": 728070321,
					"content": "父亲他…自然是很严厉的。他之所以不太愿意我和柊小姐通信，我也能理解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070322
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 728070322,
					"content": "我身为九条家的族人，又是天领奉行的执行者之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070323
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 728070323,
					"content": "而柊小姐又是勘定奉行柊家的大小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070324
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 728070324,
					"content": "假如我与她交往过密，难免被有心人抓住话柄，借题发挥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070325
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 728070325,
					"content": "虽然这确实只是一份礼物，但在某些人眼中，却又不仅仅是一份礼物那么简单。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070326
					],
					"speakerTitle": "九条镰治"
				}
			]
		},
