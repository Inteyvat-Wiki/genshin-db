				]
			},
			"dialogs": [
				{
					"id": 735200301,
					"content": "这里好像有个树洞，不过里面是空的，什么都没有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735200302,
					"content": "嗯？等等，这里面好像有张字条！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735200303,
					"content": "「好那菈教兰迦叶波识字，兰迦叶波要保护好那菈…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735200304,
					"content": "这是什么意思呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
