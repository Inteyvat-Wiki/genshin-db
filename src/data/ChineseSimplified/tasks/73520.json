			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"喀什米"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735200203,
					"content": "「二十年前的事」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735200204
					]
				},
				{
					"id": 735200204,
					"content": "…看来我就不该到处说。上次喝多了酒唠叨了几句，结果最近总有人来问。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200205
					],
					"speakerTitle": "喀什米"
				},
				{
					"id": 735200205,
					"content": "既然你们好奇，我就再讲讲吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200206
					],
					"speakerTitle": "喀什米"
				},
				{
					"id": 735200206,
					"content": "二十年前，我只是个六岁的毛头小子。当时发生的事，我已经完全记不清了。前段时间看了小时候写的日记，才朦胧地回忆起当时的情况。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200207
					],
					"speakerTitle": "喀什米"
				},
				{
					"id": 735200207,
					"content": "那年也办了学院争霸赛，比赛共三轮，最后一轮是在城外。我就央求老妈带我出城去看，她不答应，我就偷偷跑了出去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200208
					],
					"speakerTitle": "喀什米"
				},
				{
					"id": 735200208,
					"content": "然后呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735200209,
					"content": "然后我就在城外迷路了。荒郊野岭，一个人都没有。我越来越怕，忍不住哭了起来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200210
					],
					"speakerTitle": "喀什米"
				},
				{
					"id": 735200210,
					"content": "就在这时，我看到一些奇特的生物…我已经记不起它们的长相了，只记得当时还是孩子的我看到它们，很快就不哭了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200211
					],
					"speakerTitle": "喀什米"
				},
				{
					"id": 735200211,
					"content": "奇特的生物，难道说是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735200212,
					"content": "（是兰那罗吧。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735200213
					]
				},
				{
					"id": 735200213,
					"content": "它们带我去了比赛现场。可惜到那里的时候已经太晚，比赛早就结束了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200214
					],
					"speakerTitle": "喀什米"
				},
				{
					"id": 735200214,
					"content": "就在我心灰意冷的时候，我忽然看到一个奇特的生物拖着一顶王冠慢慢地走着。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200215
					],
					"speakerTitle": "喀什米"
				},
				{
					"id": 735200215,
					"content": "那王冠很漂亮，在月光下闪闪发亮，我忍不住跟了上去。我看到那个小家伙将王冠藏进了一个树洞里，然后就消失不见了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200216
					],
					"speakerTitle": "喀什米"
				},
				{
					"id": 735200216,
					"content": "我很想去摸一摸那顶王冠。但就在这个时候，远处传来了老妈的呼声。原来她发现我跑丢了，就叫上左邻右舍一起来找我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200217
					],
					"speakerTitle": "喀什米"
				},
				{
					"id": 735200217,
					"content": "我最后也没有摸到那顶冠冕，直到后来我长大了，在学院争霸赛现场见到「才识之冠」，才恍然发觉似乎是同一个东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200218
					],
					"speakerTitle": "喀什米"
				},
				{
					"id": 735200218,
					"content": "好吧…你还记得那个王冠最后被放在哪里了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735200219,
					"content": "好像是在道成林，不过我后来去找过几次，都没有发现任何线索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200220
					],
					"speakerTitle": "喀什米"
				},
				{
					"id": 735200220,
					"content": "就算我说了也没人相信。唉，连我自己也记不真切了，可能是我小时候做的一个梦吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200221
					],
					"speakerTitle": "喀什米"
				},
				{
					"id": 735200221,
					"content": "#嗯…{NICKNAME}，我们要不要去找找看？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
