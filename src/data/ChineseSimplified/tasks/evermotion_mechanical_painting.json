				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"菲利斯·尤格",
					"斯万"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705140101,
					"content": "蒙德的热情真是超乎我想象…真是名不虚传，就连那些丘丘人也这么有活力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140102
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140102,
					"content": "无论如何…尤格先生，请您千万不要再自己外出了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140103
					],
					"speakerTitle": "斯万"
				},
				{
					"id": 705140103,
					"content": "什么？那我的机关怎么办，还差…呃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140104
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140104,
					"content": "一、二、三…十八个…十九个部件啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140105
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140105,
					"content": "已经有冒险家在帮您找了，您就安安心心在城里等着吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140106
					],
					"speakerTitle": "斯万"
				},
				{
					"id": 705140106,
					"content": "但没有那些机关，我的…我的灵感，你知道吗？我的灵感来了怎么办？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140107
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140107,
					"content": "灵感稍纵即逝啊，就像…就像喝完酒打出的嗝一样，稍纵即逝啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140108
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140108,
					"content": "喔，这个比喻不错，我得记下来，泽维尔一定会喜欢的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140109
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140109,
					"content": "我…您…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140110
					],
					"speakerTitle": "斯万"
				},
				{
					"id": 705140110,
					"content": "咦？荣誉骑士…太好了，荣誉骑士！请您快些过来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140111,
						705140112
					],
					"speakerTitle": "斯万"
				},
				{
					"id": 705140111,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140113
					]
				},
				{
					"id": 705140113,
					"content": "我介绍一下，这位是来自枫丹廷的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140114
					],
					"speakerTitle": "斯万"
				},
				{
					"id": 705140114,
					"content": "空想家！我们这么称呼自己！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140115
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140115,
					"content": "…尤格先生，这位是我们蒙德城的荣誉骑士…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140116
					],
					"speakerTitle": "斯万"
				},
				{
					"id": 705140116,
					"content": "啊哈！尤格，菲利斯·尤格！向您致敬，荣誉骑士！我早就听闻过您的诸多事迹了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140117
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140117,
					"content": "你认识我？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140118
					]
				},
				{
					"id": 705140118,
					"content": "当然，当然！我当然认识您了，谁能不认识您呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140119
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140119,
					"content": "您之前在蒙德和风龙战斗的那段事迹，可是在《蒸汽鸟日报》的头条上占了足足三周啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140120
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140120,
					"content": "哈哈哈，那帮记者如果知道我正在和您谈话，一定会嫉妒到睡不着的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140121,
						705140124
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140121,
					"content": "《蒸汽鸟日报》是什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140122
					]
				},
				{
					"id": 705140122,
					"content": "您不知道吗？《蒸汽鸟日报》是枫丹廷的一家…嗯…知名度颇高的报纸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140123
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140123,
					"content": "而您，曾经帮他们攀上了销量最高点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140125
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140125,
					"content": "头、头条？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140126
					]
				},
				{
					"id": 705140126,
					"content": "那当然，您可是曾经帮他们攀上了销量最高点啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140127
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140127,
					"content": "头版头条，整刊篇幅，专家访谈，还搭配最好的手绘插图，哈！他们都赚疯了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140128
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140128,
					"content": "那…旅行者，菲利斯·尤格先生，你们先聊着，我…呃…我先去处理点别的事，先失陪了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140129
					],
					"speakerTitle": "斯万"
				},
				{
					"id": 705140129,
					"content": "斯万飞快地离开了…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705140130
					]
				},
				{
					"id": 705140130,
					"content": "好吧，看来西风骑士团和我听说的一样，有着处理不完的事务…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140131
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140131,
					"content": "所以，你为什么会来蒙德？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140132
					]
				},
				{
					"id": 705140132,
					"content": "我？事实上，我正计划着游历提瓦特。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140133
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140133,
					"content": "而我游历的目的，则是要推销我制造的这种「动械核心」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140134
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140134,
					"content": "简单来说，它是一种发条式机关，只要隔段时间扭一扭发条，这种核心就能提供很长时间的动能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140135
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140135,
					"content": "为了展示这种机关，我还专门制作了一种以「动械核心」驱动的恒动型机关玩具，我将它命名为「恒动械画」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140136
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140136,
					"content": "呃…不过很遗憾，虽然我很想向您展示这种机关…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140137
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140137,
					"content": "但这种机关实在是太出色，就连那些魔物也难抵它的魅力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140138
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140138,
					"content": "目前…我的机关正被魔物们不那么友好地分成了无数块，拿在手里细细把玩呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140139
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140139,
					"content": "虽然我已经拜托了冒险家协会帮忙，但冒险家们也一直也没给我点消息…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140140
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140140,
					"content": "荣誉骑士，如果您有兴趣的话，能不能帮我这个忙？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140141
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140141,
					"content": "相信我，我的机关…和报酬，绝不会让您失望的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140142
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140142,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140143
					]
				},
				{
					"id": 705140143,
					"content": "太棒了，您果然和报纸上写的一样，既是个实力强大的冒险家，又富有同情心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140144
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140144,
					"content": "可惜现在咱们在蒙德，如果在枫丹廷，我一定要把《蒸汽鸟日报》的记者领到您这来，给您做个专访。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140145
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140145,
					"content": "他们一定会再次被您的魅力折服，心甘情愿地把接下来三周的头版和稿酬都留给您！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140124,
					"content": "头版头条，整刊篇幅，专家访谈，还搭配最好的手绘插图，哈！他们都赚疯了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140125
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140112,
					"content": "发生什么了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140113
					]
				}
			]
		},
		{
			"id": 7051403,
			"completionStepIds": [],
