			},
			"dialogs": [
				{
					"id": 705140301,
					"content": "荣誉骑士！您回来了，零件的事怎么样了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140302
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140302,
					"content": "是这些吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7051404,
			"completionStepIds": [
				7051404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7051404",
							"2"
						],
						"stepId": 7051404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"菲利斯·尤格"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705140401,
					"content": "就是这些！就是这些！太棒了，我的零件，天呐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140402
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140402,
					"content": "既然零件已经找齐了，那接下来只要把这些零件组合起来就好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140403
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140403,
					"content": "唔…荣誉骑士，如果您有兴趣的话，也可以来试试拼接这幅「恒动械画」部件。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140404
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705140404,
					"content": "相信我，这一定会很有趣的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菲利斯·尤格"
				}
			]
		},
