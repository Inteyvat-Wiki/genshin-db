	"talks": [
		{
			"id": 2050501,
			"completionStepIds": [
				2050501
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2050501",
							"2"
						],
						"stepId": 2050501,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凯瑟琳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205050101,
					"content": "不好意思，又把你叫过来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050102,
						205050104
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 205050102,
					"content": "没关系，平时受了很多照顾。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050103
					]
				},
				{
					"id": 205050103,
					"content": "你能这么说真是太好了，那我尽量长话短说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050106
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 205050106,
					"content": "很感谢你之前能帮忙完成协会的委托，冒险家协会的风评也变得越来越好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050107
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 205050107,
					"content": "不过因为这个，愿意来委托协会的人越来越多，现在冒险家们已经有点忙不过来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050108
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 205050108,
					"content": "是要我们去当宣传员吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 205050109,
					"content": "啊，不是的，有这份心我很感激。我也希望能有更多新人加入协会…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050110
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 205050110,
					"content": "但现在再去找新人，有点远水救不了近火的感觉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050111
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 205050111,
					"content": "我想问问看，不知道你的朋友有时间帮这个忙吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050112,
						205050114
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 205050112,
					"content": "需要和他们商量一下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050113
					]
				},
				{
					"id": 205050113,
					"content": "太好了，谢谢你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050117
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 205050117,
					"content": "总之我先说明一下吧，现在比较紧急的是这种<color=#00E1FFFF>「探索派遣」</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050118
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 205050118,
					"content": "「探索派遣」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050119
					]
				},
				{
					"id": 205050119,
					"content": "我们会随时关注城市周边和野外，比如存在潜在的危险，或者地下遗迹又有异常之类的情况。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050120
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 205050120,
					"content": "因为不是来自他人的委托，所以没有时间限制。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050121
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 205050121,
					"content": "但如果因为繁忙就长期搁置，可能隐患就会变成巨大的灾难。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050122
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 205050122,
					"content": "听起来确实很重要…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050123,
						205050125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 205050123,
					"content": "朋友们应该可以理解。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050124
					]
				},
				{
					"id": 205050124,
					"content": "只要他们答应帮忙，剩下的手续交给我就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050127
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 205050127,
					"content": "那事不宜迟，为你介绍一下目前的「探索派遣」有哪些吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050128
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 205050128,
					"content": "确认「探索派遣」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 205050125,
					"content": "报酬呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050126
					]
				},
				{
					"id": 205050126,
					"content": "放心，探索中的收获协会分文不取，全都归你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050127
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 205050114,
					"content": "原来想劝我的朋友加入协会？！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050115
					]
				},
				{
					"id": 205050115,
					"content": "不不不，你误会了。我明白你的朋友有各种各样的身份，让他们都加入很不现实。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050116
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 205050116,
					"content": "这更像是协会的不情之请。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050117
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 205050104,
					"content": "又有报酬可以拿了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050105
					]
				},
				{
					"id": 205050105,
					"content": "哈哈…确实是这样，看来你很感兴趣的样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050106
					],
					"speakerTitle": "凯瑟琳"
				}
			]
		},
		{
			"id": 2050502,
			"completionStepIds": [
				2050502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2050502",
							"2"
						],
						"stepId": 2050502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凯瑟琳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205050201,
					"content": "你可以随时承接「探索派遣」，而执行委托的伙伴在此期间仍然可以和你一起冒险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050202
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 205050202,
					"content": "进行不同程度的探索会花费不同的时间，探索完成后，只需要来我这里确认一下成果就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050203
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 205050203,
					"content": "随着「冒险等阶」的提高，还可以去更多更危险的地方探索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050204
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 205050204,
					"content": "这就是能力越大，责任越大吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 205050205,
					"content": "是的，当然这也是为了各位的安全着想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050206
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 205050206,
					"content": "再次感谢你的帮助，希望你和你的伙伴能多多承接「探索派遣」哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凯瑟琳"
				}
			]
		}
	]
}