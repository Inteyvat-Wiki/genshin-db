							154.182,
							170.359,
							413.867
						],
						"pointId": 18
					}
				]
			},
			"dialogs": [
				{
					"id": 760950301,
					"content": "伊斯托利亚，现在三个区域基本都解放了。人也差不多都救出来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760950302,
					"content": "彩特琳德丢失的东西也都找回来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760950303,
					"content": "哦哦，太谢谢你们了。尼西里塔开眼之后的眼光真是不错啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950304
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 760950304,
					"content": "现在该你说说，之前提到的去往上面的方法和代价了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760950305,
					"content": "如果只是再来些小冒险或者花点小摩拉什么的，我派蒙是不怕的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760950306,
					"content": "还有哦，我们要怎么把彩特琳德送下去啊。她的事情已经忙完了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760950307,
					"content": "没问题。不过你们先休息一下吧。明天我会和你们详细解释的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950308
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 760950308,
					"content": "那好啊。可是这里没有床也没有吃的啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760950309,
					"content": "在这里欲望是止息的。你发现了吗？在这里这么久了你既不饿也不困。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950310
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 760950310,
					"content": "哇，那我休息一天要怎么打发时间啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760950311,
					"content": "这里有纵贯历史的各种奇人异士，和他们聊天应该挺有趣的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950312
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 760950312,
					"content": "#那好吧。但是睡觉是我的基本权利，就算不困我也要趴在{NICKNAME}头上睡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760950313,
					"content": "彩特琳德，等你休息好了，我想和你谈谈。就是我之前说的，需要时间想想的那件事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950314
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 760950314,
					"content": "你晚些来找我聊聊，好吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950315
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 760950315,
					"content": "好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950316
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950316,
					"content": "#{NICKNAME}和派蒙，你们休息好了的话。过来找我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊斯托利亚"
				}
			]
		},
