					}
				]
			},
			"dialogs": [
				{
					"id": 760950501,
					"content": "休息好了吗？感兴趣的人、有兴趣的话都聊过了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950502,
						760950504
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 760950502,
					"content": "还没。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760950503
					]
				},
				{
					"id": 760950503,
					"content": "好好休息吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950506
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 760950506,
					"content": "彩特琳德，你冷静一点听我说。我没有任何不尊重或者妄想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950507
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 760950507,
					"content": "你的姐姐应该没有死。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950508
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 760950508,
					"content": "我都见到墓碑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950509
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950509,
					"content": "墓碑上甚至还有姐姐的照片。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950510
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950510,
					"content": "但是，墓碑下面也有可能是空的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950511
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 760950511,
					"content": "虽然我也很希望彩特琳德姐姐没事。但是你这个猜测有点过于乐观了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950512
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760950512,
					"content": "我姐姐最后给我的信上写了，她决心要…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950513
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950513,
					"content": "她的告别，写的肯定不是她准备结束生命吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950514
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 760950514,
					"content": "她说她要去很远的地方了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950515
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950515,
					"content": "她和我说过。她的理想是在老去之前，环游世界一次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950516
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 760950516,
					"content": "希尔妲只是字面意思。她从疗养院离开，去环游世界了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950517
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 760950517,
					"content": "她还和你说过这些啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950518
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950518,
					"content": "她一直很开朗，和大家相处得很愉快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950519
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 760950519,
					"content": "那她一定没有和你说过，我们没有别的亲人了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950520
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950520,
					"content": "这…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950521
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 760950521,
					"content": "我用最冷血的方式算算这件事吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950522
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950522,
					"content": "她的离开如果会让三个人、四个人伤心，那这份沉重或许会赢过她的哀愁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950523
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950523,
					"content": "但是现在只剩下了我，而她知道，我理解她。我会原谅她的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950524
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950524,
					"content": "不是这样的，不能这么算。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950525
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 760950525,
					"content": "不用那么怜悯。在我们的童年中，父母都还在，生活很幸福的。这些回忆足够支撑我们长大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950526
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950526,
					"content": "可是，大人的世界，好艰难啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950527
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950527,
					"content": "我从小就更加内向，工作里与人打交道都格外耗费心神。我本以为外向的姐姐会如鱼得水。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950528
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950528,
					"content": "姐姐长大以后，脸上也常年挂着疲惫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950529
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950529,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950530
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760950530,
					"content": "你们还有未来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950531
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 760950531,
					"content": "哦，看来她也没有和你说她未婚夫的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950532
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950532,
					"content": "一个普通的好人，一个有趣的好人。他为什么不是一个坏蛋呢？要是个恶人就好了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950533
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950533,
					"content": "他家里有着短寿的遗传，好像是某种怪病。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950534
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950534,
					"content": "他也总是自嘲：都怪风神把蒙德规划得太好了，他家这种不应该延续的血脉都延续了下来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950535
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950535,
					"content": "后来，他说他要去拯救世界，然后就走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950536
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950536,
					"content": "拯救世界。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950537
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950537,
					"content": "我们的世界现在还在运转，说不定真的是因为他在某个不起眼的角落拯救了世界吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950538
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950538,
					"content": "你们不是常说「永恒的生命如果不能去爱所有人，然后被所有人爱，世界会被悲哀淹没吗？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950539
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950539,
					"content": "说得很有道理。短暂的生命就是不配去爱的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950540
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950540,
					"content": "他想要用自己的生命去爱。结果只是让姐姐受伤更深。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950541
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950541,
					"content": "甚至让她住进了山里的疗养院。我们脚下这个，萦绕着诅咒的疗养院。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950542
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950542,
					"content": "她从没有和我说过这些。对不起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950543
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 760950543,
					"content": "听了这些，你还要坚持姐姐依旧活着的论点吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950544
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950544,
					"content": "是的。因为她在这里，做了一件事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950545
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 760950545,
					"content": "因为我的怯懦，她不得不活下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950546
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 760950546,
					"content": "我很敬重您，伊斯托利亚。但是我觉得，或许你在历史长河里见过的苦难太多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950547
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950547,
					"content": "足以淹没世界好多次的悲伤之沙，只要一抔就可以盖住平凡如我的人生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950548
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950548,
					"content": "您无法理解我和姐姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950549
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950549,
					"content": "请问，我该如何回到地上呢？我只是朝生暮死的小人物，不配得到永恒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950550
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950550,
					"content": "唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950551
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 760950551,
					"content": "伊斯托利亚先生？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950552
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950552,
					"content": "原先此处天地不通，我们是绝无可能离开的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950553
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 760950553,
					"content": "但尼西里塔堕天之后，小右似乎有能力带你们现世之人来往柱殿与地面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950554
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 760950554,
					"content": "但是它是无法带走蒙选上来的人，因为它就是守望者的幼体。这是深埋在它体内的规则。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950555
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 760950555,
					"content": "什么？小右居然和尼西里塔是一种东西？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950556
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760950556,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950557
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 760950557,
					"content": "我们想要下去，只有放弃自己的一切记忆和知识，登上最高处。以前是去觐见女主人，如今是觐见梅兰塔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950558
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 760950558,
					"content": "所以我是没办法和你们一起下去啦。请让我送送你们吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 760950504,
					"content": "已经好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760950505
					]
				},
				{
					"id": 760950505,
					"content": "那好吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950506
					],
					"speakerTitle": "伊斯托利亚"
				}
			]
		},
