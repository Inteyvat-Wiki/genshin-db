						],
						"pointId": 266
					}
				]
			},
			"dialogs": [
				{
					"id": 760950101,
					"content": "#{NICKNAME}、派蒙谢谢你们。在最后认识你们真幸运。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950102
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950102,
					"content": "嘿嘿，没有啦。感觉你还是因为和我们在一起才卷进这些事情里的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760950103,
					"content": "等等，什么叫最后？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760950104,
					"content": "虽然都是些高危冒险，不过见识到了很多神奇的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950105
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950105,
					"content": "也不赖。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950106
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950106,
					"content": "彩特琳德你不要避重就轻啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760950107,
					"content": "有吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "彩特琳德"
				}
			]
		},
