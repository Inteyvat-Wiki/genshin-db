					"优菈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 745200401,
					"content": "#是你啊，{NICKNAME}，没想到能在这种地方遇到你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200402,
						745200403
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 745200402,
					"content": "好久不见了，优菈。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200404
					]
				},
				{
					"id": 745200404,
					"content": "算是例行巡视。不过，对我而言，更像是保持战斗状态的必要活动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200405
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 745200405,
					"content": "最近蒙德相对太平，值得游击小队全体出动的威胁几乎没有。队里的大家…精神上确实放松了不少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200406
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 745200406,
					"content": "劳逸结合也是好事嘛。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200407
					]
				},
				{
					"id": 745200407,
					"content": "话虽如此，但我作为队长，必须要时刻保持自己的战斗力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200408
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 745200408,
					"content": "毕竟，敌人的剑可不会因为和平而变得迟钝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200409
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 745200409,
					"content": "所以，我习惯在巡视的间隙，找个僻静的地方练习剑术，确保姿态不会生疏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200410,
						745200411
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 745200410,
					"content": "时机正好…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200412
					]
				},
				{
					"id": 745200412,
					"content": "哦？倒是有趣的请求。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200413
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 745200413,
					"content": "不过，我的动作很快，你的留影机跟得上吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200414,
						745200415
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 745200414,
					"content": "按照你平时的速度就好了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200416
					]
				},
				{
					"id": 745200416,
					"content": "好。既然你这么有自信，那我也要全力以赴了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200417
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 745200417,
					"content": "看好了，浪花卷起的时刻可是转瞬即逝的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "优菈"
				},
				{
					"id": 745200415,
					"content": "我的镜头会尽力跟上你的！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200416
					]
				},
				{
					"id": 745200411,
					"content": "请让我为你留影！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200412
					]
				},
				{
					"id": 745200403,
					"content": "你是在这里执勤吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200404
					]
				}
			]
		}
	]
