			"dialogs": [
				{
					"id": 401025001,
					"content": "没想到有人敢在学院庆典期间动手，看来萨齐因的财产有很大的诱惑力啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401025002
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 401025002,
					"content": "如果突然有这么一大笔钱，你会做什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401025003
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 401025003,
					"content": "不知道，我从来没有想过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401025004
					],
					"speakerTitle": "坎蒂丝"
				},
				{
					"id": 401025004,
					"content": "那你想想看？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401025005
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 401025005,
					"content": "嗯…购买食物、寻找水源…大概这些吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "坎蒂丝"
				}
			]
