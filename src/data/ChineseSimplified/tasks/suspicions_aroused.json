			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 401020101,
					"content": "#{NICKNAME}，总觉得你好像有什么心事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020102,
						401020103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020102,
					"content": "（比赛开始前见到的白发男子…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020104
					]
				},
				{
					"id": 401020104,
					"content": "#{NICKNAME}、派蒙，总算找到你们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020105
					],
					"speakerTitle": "坎蒂丝"
				},
				{
					"id": 401020105,
					"content": "咦，出什么事了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020106,
					"content": "你们有没有觉得这次学院庆典有些奇怪？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020107
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 401020107,
					"content": "刚刚我和坎蒂丝在咖啡馆，好像见到了来这里办事的佣兵。他们还特地乔装打扮了一番，装作只是来逛街的游客。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020108
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 401020108,
					"content": "但再怎么装，身上的血腥味是掩盖不掉的。看他们那副贼眉鼠眼的样子，接的估计还是绑票、暗杀这种下三滥的活儿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020109
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 401020109,
					"content": "我们听了一会儿，他们的目标好像是一个叫「萨齐因」的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020110
					],
					"speakerTitle": "坎蒂丝"
				},
				{
					"id": 401020110,
					"content": "萨齐因？是不是开幕式的时候，卡莉娜提起过的那个人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020111,
					"content": "据说「才识之冠」还有比赛的奖金都是他赞助的。不过这个人好像一直没有露面…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020112,
					"content": "听上去是个有钱人吧，那就不奇怪了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020113
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 401020113,
					"content": "这年头镀金旅团的日子也不好过，很多佣兵团会接一些「私活」，盯上的都是有钱有势的大人物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020114
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 401020114,
					"content": "用他们的话说叫开张吃半年，只要干成一票，捞到的赎金能让他们潇洒好些日子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020115
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 401020115,
					"content": "因为学院庆典，须弥城一下子来了很多游客，他们估计也是借机混进来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020116
					],
					"speakerTitle": "坎蒂丝"
				},
				{
					"id": 401020116,
					"content": "我和迪希雅原本想直接抓住对方，但他们很警觉，找借口溜走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020117
					],
					"speakerTitle": "坎蒂丝"
				},
				{
					"id": 401020117,
					"content": "要不是不想在城里大打出手，第一时间就该把他们绑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020118
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 401020118,
					"content": "按规矩这事应该谁来管？风纪官？还是三十人团？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020119
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 401020119,
					"content": "嗯…如果赛诺在的话，他应该会管。要不我们先回一趟教令院，把消息告诉风纪官吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020120,
					"content": "迪希雅、坎蒂丝，这次多谢你们啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020121,
					"content": "没什么，我们也是碰巧听到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020122
					],
					"speakerTitle": "坎蒂丝"
				},
				{
					"id": 401020122,
					"content": "是啊，不用放在心上。真让他们得逞了，镀金旅团的名声只会变得更差。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020123
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 401020123,
					"content": "这里毕竟是须弥城，我和坎蒂丝不方便动手，就交给你们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020124
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 401020124,
					"content": "需要帮助的话，来咖啡馆找我们就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020125
					],
					"speakerTitle": "坎蒂丝"
				},
				{
					"id": 401020125,
					"content": "刚刚我总觉得你有什么心事，难道也是在思考学院庆典的问题？听迪希雅和坎蒂丝说完之后，我也感觉这背后好像藏着一些秘密…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020126,
					"content": "嗯…这么干想下去也不是办法。走，我们去教令院找风纪官吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020103,
					"content": "（第一轮比赛结束后听到的密谈…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020104
					]
				}
			]
		},
		{
			"id": 4010202,
