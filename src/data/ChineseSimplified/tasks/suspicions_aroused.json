			"dialogs": [
				{
					"id": 401020401,
					"content": "总之我们先敲门试试…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020402,
					"content": "（敲门。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020403
					]
				},
				{
					"id": 401020403,
					"content": "好像没什么反应…是没人在吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020404,
					"content": "（敲门。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020405
					]
				},
				{
					"id": 401020405,
					"content": "艾尔海森，听得到吗？你在家里吗？我们有事想请你帮忙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020406,
					"content": "是你们两个？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020407
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401020407,
					"content": "卡维！原来你在家呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020408,
					"content": "…总之先进来吧，我给你们开门。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡维"
				}
			]
		},
		{
			"id": 4010205,
			"completionStepIds": [
				4010205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
