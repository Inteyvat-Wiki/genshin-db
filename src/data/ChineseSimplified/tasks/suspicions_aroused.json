			"dialogs": [
				{
					"id": 401020301,
					"content": "呼…妮露，你见到艾尔海森了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020302,
					"content": "艾尔海森先生？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020303
					],
					"speakerTitle": "妮露"
				},
				{
					"id": 401020303,
					"content": "我们正在调查一个人，想拜托他帮忙查查档案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020304,
					"content": "这样啊…抱歉，我也不知道他去了哪里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020305
					],
					"speakerTitle": "妮露"
				},
				{
					"id": 401020305,
					"content": "一般比赛结束后，他都会第一个离开。而且艾尔海森先生也不会向其他人透露自己的行程…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020306
					],
					"speakerTitle": "妮露"
				},
				{
					"id": 401020306,
					"content": "好吧。仔细想想他平时也是这个样子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020307,
					"content": "我想想…艾尔海森先生似乎对学院庆典不太感兴趣，应该不会留在这附近。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020308
					],
					"speakerTitle": "妮露"
				},
				{
					"id": 401020308,
					"content": "对他来说，特邀评论员更像是被安排的工作。你们知道他平时工作结束后会去哪里吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020309,
						401020312
					],
					"speakerTitle": "妮露"
				},
				{
					"id": 401020309,
					"content": "酒馆？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020310
					]
				},
				{
					"id": 401020310,
					"content": "嗯…可是毕竟还有一轮比赛，艾尔海森先生会在这时候去喝酒吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020311
					],
					"speakerTitle": "妮露"
				},
				{
					"id": 401020311,
					"content": "啊！我想到了，他有没有可能是回家了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020314,
					"content": "我记得艾尔海森的住宅好像离这边不远，我们去他家看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020312,
					"content": "回家？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020313
					]
				},
				{
					"id": 401020313,
					"content": "对哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020314
					],
					"speakerTitle": "派蒙"
				}
			]
		},
