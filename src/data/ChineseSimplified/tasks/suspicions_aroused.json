							2772.651
						],
						"pointId": 330201420
					}
				]
			},
			"dialogs": [
				{
					"id": 401020201,
					"content": "两位，好久不见了。你们有事找我吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020202
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 401020202,
					"content": "将迪希雅与坎蒂丝说的情况告诉了阿拉夫。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401020203
					]
				},
				{
					"id": 401020203,
					"content": "预谋绑架萨齐因…居然有人在策划这种事。不过仔细想想，倒也并不奇怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020204
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 401020204,
					"content": "萨齐因赞助了学院庆典，如今学院庆典的影响力逐步扩大，很多人都听说了萨齐因的名声，把他视作超级富豪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020205
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 401020205,
					"content": "既然知道有人盯上了他，是不是应该多派点人，把他保护起来？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020206,
					"content": "不瞒你们说，我们也有过这样的想法。但听说萨齐因原本就喜欢外出调研，常年不在须弥城内，没人能联系上他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020207
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 401020207,
					"content": "唯一的线索，就是他曾经说过「每次举办学院争霸赛的时候，我都会在最近的地方观察，挑选出合适的人来继承我的产业」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020208
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 401020208,
					"content": "如果萨齐因遵守自己的承诺，现在的他应该就在须弥城内。镀金旅团的那些人，估计也是听说了这件事，才来须弥城碰碰运气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020209
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 401020209,
					"content": "看来那帮坏蛋也不知道萨齐因在哪？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020210,
					"content": "应该是这样。赛诺前辈还在休假，这件事就由我来处理吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020211
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 401020211,
					"content": "放心，在如今的须弥城里，一伙儿绑匪翻不起什么风浪，我自有办法让他们现身。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020212
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 401020212,
					"content": "不过，如果你们对萨齐因的事感兴趣，要不要试着去找找他？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020213
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 401020213,
					"content": "越早搞清楚他在哪里，我们越能保证他的安全。毕竟风纪官和三十人团的本领再大，也很难保护一个不肯现身的人啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020214
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 401020214,
					"content": "好吧，那我们去试着找找他。不过该从哪里开始调查呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020215,
					"content": "风纪官这里有萨齐因的资料吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020216
					]
				},
				{
					"id": 401020216,
					"content": "并没有。萨齐因从未做过任何违法乱纪的事情，风纪官这里并没有多少关于他的信息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020217
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 401020217,
					"content": "我听说艾尔海森大人已经卸任代理贤者，重新当回了书记官，你们不妨去找他问问看？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020218
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 401020218,
					"content": "有道理。那我们先回主会场，去找艾尔海森！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
