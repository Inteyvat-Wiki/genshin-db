					}
				]
			},
			"dialogs": [
				{
					"id": 401020501,
					"content": "好多字，看得我头都晕了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020502,
					"content": "总之就是，萨齐因把自己的产业托付给教令院打理，然后自己跑出去做研究了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020503,
					"content": "他还说如果特别认可某位参赛者的话，不光会给他奖金，还会把自己的产业也送给他…那应该值好多好多钱吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020504,
					"content": "什么？！还有这种好事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020505
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401020505,
					"content": "萨齐因的资产…应该多到我这辈子也花不完吧。如果我能拿到，岂不是还清欠款、购置新房之后还能剩下数不清的钱？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020506
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401020506,
					"content": "到时候我可以再造一个卡萨扎莱宫。不，造一个比卡萨扎莱宫大十倍的宫殿——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020507
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401020507,
					"content": "还有奥摩斯港那边的新项目，说是改装桥体，想做出最好的效果恐怕要…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020508
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401020508,
					"content": "快醒醒，现在就考虑这些，未免也太早了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020509
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020509,
					"content": "也是。当务之急还是拿下冠军，早点搬出去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020510
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401020510,
					"content": "嗯？等等，资料里好像还夹着张纸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020511
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020511,
					"content": "这是艾尔海森写的吗？看上去像是他在思考的时候随手记下来的…让我看看，有两句话被圈起来了——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020512
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020512,
					"content": "第一句是「萨齐因生死未知」，第二句是…「才识之冠」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020513
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020513,
					"content": "还有一些看不懂的话。这是别的语言吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020514
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020514,
					"content": "我看看…欸？这种文字…唔，让我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020515
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401020515,
					"content": "「宏大的理想未必能够对抗虚无，微小的选择却可以」。不能保证翻得全对，但大意应该差不多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020516
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401020516,
					"content": "…嗯？底下还有行小字…咦…他这是什么意思？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020517
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401020517,
					"content": "你居然能读懂这种看起来很奇怪的文字呢，好厉害！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020518
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020518,
					"content": "学生时代我跟他合作过课题，题目是「赤王文明古遗迹中的符文古文字与建筑设计方向解读」。那时候跟着稍微学了一点古文字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020519
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401020519,
					"content": "原来是这样！不过…艾尔海森写的这些是什么意思？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020520
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020520,
					"content": "谁知道呢？那家伙的思维方式不是一般人能搞懂的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020521
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401020521,
					"content": "好吧，看来这里也没有更多的线索了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020522
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020522,
					"content": "希望阿拉夫那边有进展。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020523
					]
				},
				{
					"id": 401020523,
					"content": "是呀，希望他早点抓住那些坏蛋。在那之前…嗯…我们先去别处逛逛吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4010206,
			"completionStepIds": [
				4010206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4010206",
							"2"
						],
						"stepId": 4010206,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"卡维"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401020601,
					"content": "刚刚敲门没有反应，我还以为家里没有人呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020602,
					"content": "没办法。如果是教令院的人来找艾尔海森，我跑过去开门，不就暴露我住在这里的事了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020603
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401020603,
					"content": "你在这件事上还真是谨慎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020604,
					"content": "那万一有人来找艾尔海森，你又正好在房子里怎么办？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020605,
					"content": "我在自己房间就行。再说，也不会有人到家里来找艾尔海森的，一般人不敢这样自讨没趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020606
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401020606,
					"content": "好吧，你知道艾尔海森去哪了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020607
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020607,
					"content": "那家伙？谁知道，他爱去哪去哪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020608
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401020608,
					"content": "吵架了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020609
					]
				},
				{
					"id": 401020609,
					"content": "有什么好吵的，是他说话太难听了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020610
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401020610,
					"content": "我跟他说了第二轮比赛的过程。最后我不是抽中签了吗？说明好人有好报，现在的我运气正旺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020611
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401020611,
					"content": "可那家伙…你们根本猜不到他听完之后说什么！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020641
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401020641,
					"content": "「你总强调自己是学长，处理问题却没有学长真正该有的样子。那所谓的学长尊严有什么用？」什么叫学长该有的样子！学长就是学长吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020642
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401020642,
					"content": "还有啊！他还说！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020612
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401020612,
					"content": "「我劝你好好想想，为什么每一轮比赛都要拼运气？你活到现在这个岁数还能对自身最大的困境视而不见，简直难以置信。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020613
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401020613,
					"content": "哈哈…确实像艾尔海森会说的话呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020614
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020614,
					"content": "忍无可忍！不止这次，还有上次、上上次，跟他聊天简直能气死人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020615
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401020615,
					"content": "反正我们互看不顺眼，我会尽快搬出去的，现在就在收拾行李。不会再有人帮他收拾东西打扫屋子了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020616
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401020616,
					"content": "连墙上的挂画我也要取下来带走！今后艾尔海森就要生活在跟感性彻底绝缘的地方了，哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020617
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401020617,
					"content": "等等，你要搬出去了？比赛不是还没结束吗，你哪里来的钱呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020618
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020618,
					"content": "现在当然没有，所以我只是先收拾一下行李，提前做好准备。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020619
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401020619,
					"content": "我挑了一套新房子，等我拿到奖金，立刻就去把它买下来。再把收拾好的行李运过去，最多三天就能从这里离开了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020620
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401020620,
					"content": "为了实现这个目标，我已经打定主意了。无论第三轮比赛发生什么，我都会尽全力去拿下这个冠军！你们就等着瞧吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020621
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401020621,
					"content": "好吧，我们会帮你加油的。不过…你真的没事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020622
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020622,
					"content": "欸？我有什么事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020623
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401020623,
					"content": "莱依拉跟我们说，她认为你有时会陷入「自我矛盾」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020624
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020624,
					"content": "什么意思，你们不会也觉得我的性格有什么问题吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020625
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401020625,
					"content": "我们没有这么说啦！但你想啊，说要拿到奖金的是你，拒绝了珐露珊赠送积分提案的也是你，没办法放着沙狐不管的还是你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020626
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020626,
					"content": "等等，这些都是很正常的事吧。理由我之前就说了，不这么做我会感到愧疚…哪里矛盾了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020627
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401020627,
					"content": "为什么你会感到愧疚呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020628
					]
				},
				{
					"id": 401020628,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020629
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401020629,
					"content": "突然这么问…是啊，为什么呢？也许我的性格就是这样。而且不去做的话，万一产生不好的后果，我也难辞其咎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020630
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401020630,
					"content": "但老是这样想就会活得很累啊。再说你做的事也不是完全没危险…比如晕倒在沙漠里什么的，真的值得吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020631
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020631,
					"content": "…两三句话说不清的，罢了我的事先放一放，以后再聊。你们找艾尔海森做什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020632
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401020632,
					"content": "我们想拜托他查萨齐因的档案。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020633
					]
				},
				{
					"id": 401020633,
					"content": "萨齐因？这几天好像听他念叨过这个人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020634
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401020634,
					"content": "当时他带回来一些资料，一边自言自语一边在纸上写写画画，还说让我有空也看一眼，不过我没看。你们等一下，我找找东西在哪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020635
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401020635,
					"content": "…就是这本。给你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020636
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401020636,
					"content": "呃…这样真的好吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020637
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020637,
					"content": "这有什么？他从我这拿啤酒的时候要多顺手有多顺手，从来没跟我客气过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020638
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401020638,
					"content": "再说几天前他问过我要不要看，当时我觉得用不着，他就放旁边了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020639
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401020639,
					"content": "按他的习惯，资料没收起来就是同意其他人翻看，你不需要担心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020640
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401020640,
					"content": "那我就放心啦。让我翻翻萨齐因的档案里写了什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
