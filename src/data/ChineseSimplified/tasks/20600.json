			"trigger": {
				"objectNames": [
					"维克多"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 206000201,
					"content": "关于「愚人众」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000202
					]
				},
				{
					"id": 206000202,
					"content": "哦唷，单刀直入啊，哼哼，那讲起来可就长咯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000203
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 206000203,
					"content": "不过，你还不是「愚人众」的正式成员，我也不能白告诉你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000204
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 206000204,
					"content": "我听说，这蒙德城周围有很多丘丘人，有的还聚在一起抱起了团。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000205
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 206000205,
					"content": "你帮我去走一趟，从领头的「丘丘人暴徒」那拿点战利品回来，然后，我就给你讲点新鲜故事，怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000206,
						206000209
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 206000206,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000207
					]
				},
				{
					"id": 206000207,
					"content": "哟，还挺爽快的，难得在蒙德城里能遇见这种人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000208
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 206000208,
					"content": "那你快点去吧，我就在这等你，记得快去快回。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "维克多"
				},
				{
					"id": 206000209,
					"content": "就只要这个？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000210
					]
				},
				{
					"id": 206000210,
					"content": "怎么，你还嫌这个不带劲？行了，再厉害点的怪物你搞得定吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000211
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 206000211,
					"content": "快去快回吧，我就在这等着你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000212
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 206000212,
					"content": "哈…要是再磨蹭一会，我非得被这风给吹睡着了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "维克多"
				}
			]
		},
