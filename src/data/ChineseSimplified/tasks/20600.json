			"dialogs": [
				{
					"id": 206000301,
					"content": "关于「邪眼」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000302
					]
				},
				{
					"id": 206000302,
					"content": "嘿…我说，你是真不会说话，还是假装糊涂？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000303
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 206000303,
					"content": "你又不是「愚人众」的正式成员，这么直挺挺一句「『邪眼』是什么？」戳过来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000304
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 206000304,
					"content": "你觉得我会直接一五一十地全部告诉你吗？我又不是那两个看门的西风骑士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000305
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 206000305,
					"content": "不过…「邪眼」可是咱「愚人众」的宝物，让你了解一下，也不是不行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000306
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 206000306,
					"content": "这样吧，你再去跑一趟。你见过蒙德城周围的那些「盗宝团」吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000307
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 206000307,
					"content": "虽然是一群偷偷摸摸的小毛贼，但偶尔还真能让他们撞到宝贝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000308
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 206000308,
					"content": "你去帮我跑一趟，从「盗宝团」的手上拿点东西回来，作为交换，我就给你讲讲「邪眼」的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000309,
						206000311
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 206000309,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000310
					]
				},
				{
					"id": 206000310,
					"content": "我就喜欢爽快的人，那你就快点去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "维克多"
				},
				{
					"id": 206000311,
					"content": "你缺钱了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000312
					]
				},
				{
					"id": 206000312,
					"content": "缺钱？哈哈哈，你以为我们是西风骑士团吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000313
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 206000313,
					"content": "我就是想看看，盗宝团能在蒙德挖出什么东西来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000314
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 206000314,
					"content": "不过…嘿嘿，想来他们也挖不出来什么值得一提的宝贝吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "维克多"
				}
			]
		},
