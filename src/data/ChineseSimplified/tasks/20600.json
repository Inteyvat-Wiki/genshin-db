			"dialogs": [
				{
					"id": 206000401,
					"content": "关于「女皇陛下」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000402
					]
				},
				{
					"id": 206000402,
					"content": "怎么，你想找我打听女皇陛下？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000403
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 206000403,
					"content": "你不会是因为女皇陛下，才考虑加入愚人众的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000404
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 206000404,
					"content": "哼，不是我说你，你自己掂量掂量你这个念头…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000405
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 206000405,
					"content": "不过，关于女皇陛下的消息，我更不能白告诉你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000406
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 206000406,
					"content": "你去跑一趟，从遗迹守卫身上找点宝贝回来吧，我突然想收藏来玩玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000407,
						206000409
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 206000407,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000408
					]
				},
				{
					"id": 206000408,
					"content": "哦，那你快去吧，我就在这等着你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "维克多"
				},
				{
					"id": 206000409,
					"content": "你要这个做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000410
					]
				},
				{
					"id": 206000410,
					"content": "啊？做个收藏不行吗？怎么，蒙德人连个遗迹守卫都不敢试试吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000411
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 206000411,
					"content": "哼，对「愚人众」来说，也就是一抬手的功夫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000412
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 206000412,
					"content": "不过，哈…这股风吹得我只想睡觉，实在提不起劲，所以这件小事就交给你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "维克多"
				}
			]
		},
