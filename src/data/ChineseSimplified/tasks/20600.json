			"dialogs": [
				{
					"id": 206000501,
					"content": "别忘了啊，是「丘丘人暴徒」身上的战利品，拿到了就赶紧回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000502
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 206000502,
					"content": "具体是什么？就是…一个号角。哎呀，你拿到了之后给我就是了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "维克多"
				}
			]
		},
