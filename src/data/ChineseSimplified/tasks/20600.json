			"trigger": {
				"objectNames": [
					"维克多"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 206000101,
					"content": "这里，旅行者，我注意你很久了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000102
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 206000102,
					"content": "找我有什么事吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000103
					]
				},
				{
					"id": 206000103,
					"content": "怎么这么一副提防的语气，我可是有件好事告诉你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000104
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 206000104,
					"content": "怎么样，你有没有兴趣加入「愚人众」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000105
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 206000105,
					"content": "哼，我们才没兴趣呢！对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000106,
						206000109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 206000106,
					"content": "我考虑考虑。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000107
					]
				},
				{
					"id": 206000107,
					"content": "喂！怎么这种事情你也要考虑呀，直接拒绝才对吧！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 206000108,
					"content": "眼力不错啊，想要成就一番事业，加入咱们「愚人众」当然是不二之选。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000111
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 206000111,
					"content": "咦，看你的表情，是有问题想问？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "维克多"
				},
				{
					"id": 206000109,
					"content": "这里可是蒙德城。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000110
					]
				},
				{
					"id": 206000110,
					"content": "蒙德城怎么了？咱们「愚人众」可是全大陆公开征募，绝对公平公正，西风骑士也管不着。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000111
					],
					"speakerTitle": "维克多"
				}
			]
		},
		{
			"id": 2060002,
			"completionStepIds": [
				2060002
			],
