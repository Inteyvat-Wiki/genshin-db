			"dialogs": [
				{
					"id": 206000601,
					"content": "东西拿到了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000602
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 206000602,
					"content": "拿到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000603
					]
				},
				{
					"id": 206000603,
					"content": "我看看，嗯…勉强还行，凑合吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000604
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 206000604,
					"content": "那我就和你们讲讲「愚人众」的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000605
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 206000605,
					"content": "我们「愚人众」来自「至冬宫」，听从女皇陛下的命令，秉承着女皇陛下的意志，在世界各地活动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000606
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 206000606,
					"content": "在其中有十一位最强的人，被女皇陛下赐予了「执行官」之名。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000607
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 206000607,
					"content": "比起我们这些无名小卒，那十一位「执行官」才是有着赫赫威名的大人物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000608
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 206000608,
					"content": "如果你加入了「愚人众」，实力也够强，说不定还会被哪位大人挑中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000609
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 206000609,
					"content": "那样的话，你就飞黄腾达咯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000610
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 206000610,
					"content": "我？被挑中倒是谈不上，我就是在这给「女士」大人办点小事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000611
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 206000611,
					"content": "呃…如果非要选的话，我其实更想跟着「队长」大人啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "维克多"
				}
			]
		},
