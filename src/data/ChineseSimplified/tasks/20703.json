			"dialogs": [
				{
					"id": 207030501,
					"content": "你有什么发现吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030502
					],
					"speakerTitle": "艾迪丝博士"
				},
				{
					"id": 207030502,
					"content": "找到了这些「树叶」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207030503
					]
				},
				{
					"id": 207030503,
					"content": "…树叶？请给我看看。您居然把它们装在这个盒子里...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030504
					],
					"speakerTitle": "艾迪丝博士"
				},
				{
					"id": 207030504,
					"content": "这些树叶…拿在手里的时候，确实能实实在在地感觉到「风」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030505
					],
					"speakerTitle": "艾迪丝博士"
				},
				{
					"id": 207030505,
					"content": "这棵树上，居然真的有这种力量…要是我有「神之眼」的话，就不会浪费这么多时间了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030506
					],
					"speakerTitle": "艾迪丝博士"
				},
				{
					"id": 207030506,
					"content": "谢谢，这是很宝贵的素材，我会好好利用的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030507
					],
					"speakerTitle": "艾迪丝博士"
				},
				{
					"id": 207030507,
					"content": "不过，对这些「树叶」我也没什么保存手段，「风」也许很快就会消散，",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030508
					],
					"speakerTitle": "艾迪丝博士"
				},
				{
					"id": 207030508,
					"content": "这些是给你的报酬，说不定下次还要麻烦你，再来帮我搜集素材了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾迪丝博士"
				}
			]
		}
