				"points": []
			},
			"dialogs": [
				{
					"id": 207030101,
					"content": "…这个也不能作为写作素材，可惜了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030102
					],
					"speakerTitle": "艾迪丝博士"
				},
				{
					"id": 207030102,
					"content": "你在做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207030103
					]
				},
				{
					"id": 207030103,
					"content": "我想写一本以「风」为主题，叙述蒙德历史的新书，正在这里寻找灵感呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030104
					],
					"speakerTitle": "艾迪丝博士"
				},
				{
					"id": 207030104,
					"content": "这里既有代表着风的「七天神像」，又有着与大英雄温妮莎相关的这棵树，在这里寻找灵感，再适合不过了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030105
					],
					"speakerTitle": "艾迪丝博士"
				},
				{
					"id": 207030105,
					"content": "不过说来好笑，因为我没有「神之眼」，无论是想要寻找还是搜集「风」，都实在是太费力了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030106
					],
					"speakerTitle": "艾迪丝博士"
				},
				{
					"id": 207030106,
					"content": "所谓的寻找灵感，也只不过是在这里发呆。仅有的一些素材，也都是从书籍里总结出来的一些二手材料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030107
					],
					"speakerTitle": "艾迪丝博士"
				},
				{
					"id": 207030107,
					"content": "在这片大陆上，没有「神之眼」的人就是这样，做事永远事倍功半。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030108
					],
					"speakerTitle": "艾迪丝博士"
				},
				{
					"id": 207030108,
					"content": "没有「神之眼」，无法使用元素的力量…无论是研究还是生活，都活像个这世界里的局外人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030109
					],
					"speakerTitle": "艾迪丝博士"
				},
				{
					"id": 207030109,
					"content": "哈哈哈，也许在神看来，拥有「神之眼」的人，才是这个世界的主角吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030110
					],
					"speakerTitle": "艾迪丝博士"
				},
				{
					"id": 207030110,
					"content": "抱歉，我说得有些多了。虽然话是这么说啦，但我不会放弃研究的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030111
					],
					"speakerTitle": "艾迪丝博士"
				},
				{
					"id": 207030111,
					"content": "我没有「神之眼」，但绝不能在学术水平上再落下风。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030112
					],
					"speakerTitle": "艾迪丝博士"
				},
				{
					"id": 207030112,
					"content": "而且我听说，你虽然没有「神之眼」，但也能看到元素…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030113
					],
					"speakerTitle": "艾迪丝博士"
				},
				{
					"id": 207030113,
					"content": "如果能亲手拿到附着有「风」元素的东西，一定会对我的研究有帮助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030114
					],
					"speakerTitle": "艾迪丝博士"
				},
				{
					"id": 207030114,
					"content": "旅行者，你能帮我去这棵大树上搜索一下吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾迪丝博士"
				}
			]
		},
