						207030202
					]
				},
				{
					"id": 207030202,
					"content": "太好了，那就拜托你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030303
					],
					"speakerTitle": "艾迪丝博士"
				},
				{
					"id": 207030303,
					"content": "你能够看见「元素」，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030304
					],
					"speakerTitle": "艾迪丝博士"
				},
				{
					"id": 207030304,
					"content": "我想，只要循着「风」的痕迹搜索就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030305
					],
					"speakerTitle": "艾迪丝博士"
				},
				{
					"id": 207030305,
					"content": "我就在树下等着你，有什么收获的话，就拿下来给我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾迪丝博士"
				}
