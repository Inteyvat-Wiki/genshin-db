			"dialogs": [
				{
					"id": 207030401,
					"content": "不得不说，说到做研究，你这样的人明显才更加合适。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030402
					],
					"speakerTitle": "艾迪丝博士"
				},
				{
					"id": 207030402,
					"content": "既有丰富的冒险经验，体能也十分不错…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030403
					],
					"speakerTitle": "艾迪丝博士"
				},
				{
					"id": 207030403,
					"content": "最重要的是，虽然你没有「神之眼」，但也能够操纵元素。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030404
					],
					"speakerTitle": "艾迪丝博士"
				},
				{
					"id": 207030404,
					"content": "元素…在这片大地上，又有什么研究能绕开这两个字呢？对于学者来说，能不能操纵元素实在是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030405
					],
					"speakerTitle": "艾迪丝博士"
				},
				{
					"id": 207030405,
					"content": "啊，我又自顾自说起来了…抱歉，请别放在心上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾迪丝博士"
				}
			]
