			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"小卷",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721500201,
					"content": "你们回来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500202
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500202,
					"content": "你要的东西我们取回来了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500203
					]
				},
				{
					"id": 721500203,
					"content": "是奉纳池的净水，还新鲜哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721500204,
					"content": "真是太感谢你们了，我这就把水给「灵草」续上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500205
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500205,
					"content": "之前说到哪里了来着…对，还需要一个步骤，「灵草」才能更加焕发光泽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500206
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500206,
					"content": "只有在与深海水元素富集的环境中，「灵草」的茎叶才能足够舒展，其光彩才更能展现「愿望」的颜色。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500207
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500207,
					"content": "简而言之…在北方的一处洞窟里，存在着与其生存环境的水质最为近似的水元素。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500208
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500208,
					"content": "而在洞内不同的区域，其浓度也有所不同…其中呢，浓度最为理想的水元素是最为晶莹透明的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500209
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500209,
					"content": "但假如变得浑浊了…比如被其他生物搅扰了，也是会很难办的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500210
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500210,
					"content": "唉，我老了，不太好解释其中道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500211
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500211,
					"content": "到时候你们亲眼看到就会明白了，呵呵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500212
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500212,
					"content": "那处洞窟同我们望泷村先祖的秘密息息相关…只可惜由于近来的战争，已罕有年轻人去那边取水滋养「灵草」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500213
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500213,
					"content": "唉…说起年轻人们，希望他们都能安全归来吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500214
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500214,
					"content": "话说回来，年轻人。如果你们要去那里取水的话，请一定注意安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500215
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500215,
					"content": "嗯，小卷婆婆请放心啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500216,
						721500217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721500216,
					"content": "我们会注意的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500218
					]
				},
				{
					"id": 721500218,
					"content": "那就好，那就好…十分感谢你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500217,
					"content": "请您放心吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500218
					]
				}
			]
		},
		{
			"id": 7215003,
