				"points": []
			},
			"dialogs": [
				{
					"id": 721500301,
					"content": "哦哦，是你们呀，快来休息一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500302
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500302,
					"content": "小卷婆婆，我们把您说的水带回来啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721500303,
					"content": "这是您说的「最理想的水」吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500304
					]
				},
				{
					"id": 721500304,
					"content": "没错，这些就足够了。真是辛苦你们了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500305
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500305,
					"content": "呵呵，精神了很多嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500306
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500306,
					"content": "从「灵草」的光彩来看…来年一定是个和平富足的好年景。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500307
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500307,
					"content": "欸…这是怎么看出来的呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721500308,
					"content": "「灵草」的光彩在于水的润泽，与众人「愿望」的滋养。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500309
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500309,
					"content": "这灵光正是大家愿望的宣示。愿望美好，光彩也就更鲜活，未来也就更有希望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500310
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500310,
					"content": "毕竟…大家的愿望总是向着更好的明天吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500311
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500311,
					"content": "只要大家都有着为改善当前的生活而做点什么的愿望…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500312
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500312,
					"content": "或许相比而言，战争造成的种种困窘就算不得什么了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500313
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500313,
					"content": "唔…所以这和它灵验与否有什么关系吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721500314,
					"content": "当然…这就是我们老人的智慧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500315
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500315,
					"content": "「愿望」驱使和鼓励人行动，而行动的成果反过来验证了人的「愿望」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500316
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500316,
					"content": "只要我们又一次维护了生活的平和，只要从灰暗的日子里保护生活的希望…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500317
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500317,
					"content": "「灵草」的占卜就永远是灵验的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500318,
						721500319
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500318,
					"content": "像是在用敷衍解释迷信…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500320
					]
				},
				{
					"id": 721500320,
					"content": "呵呵，年轻人总会理解的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500321
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500321,
					"content": "顺便一提，水中「愿望」的效力应该还能坚持些时日，两位愿意的话，可以随时来找我占卜哟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500319,
					"content": "但也不是没有道理…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500320
					]
				}
			]
		},
		{
			"id": 7215004,
