				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721500401,
					"content": "你好，年轻人。看样子你是从岛外来的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500402,
						721500403
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500402,
					"content": "是的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500404
					]
				},
				{
					"id": 721500404,
					"content": "想必你是游历四方的旅人吧？那么…不知是否有兴趣稍事停留，顺便占卜一下前路呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500405
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500405,
					"content": "欸，占卜前路…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500406,
						721500407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721500406,
					"content": "占卜前路…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500408
					]
				},
				{
					"id": 721500408,
					"content": "哈哈，二位不必如此忧心忡忡。抱歉呀，是我唐突了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500409
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500409,
					"content": "我的意思是，我们望泷村的海祇神龛十分灵验，所以才要邀请你们占卜一番。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500410
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500410,
					"content": "自然没有说二位前路险峻的意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500411
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500411,
					"content": "啊…当然了，你我各自前路将会如何，又怎能靠只言片语预料呢…呵呵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500412
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500412,
					"content": "原来只是要占卜呀…那我就放心啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721500413,
					"content": "需要收费吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500414
					]
				},
				{
					"id": 721500414,
					"content": "呵呵，不需要的。我们不会就这种事情收取奉纳钱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500415
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500415,
					"content": "维护神龛的人，若是为了「愿望」而向过路的旅人收费，是会招致大御神灵魂不安的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500416
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500416,
					"content": "毕竟同样身为凡人，我们有何资格利用别人的「愿望」，为自己牟取利益呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500417
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500417,
					"content": "唔…是这个道理呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500418
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721500418,
					"content": "所以二位，是否有兴趣赏光占卜前路呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500419
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500419,
					"content": "可以一试。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500420
					]
				},
				{
					"id": 721500420,
					"content": "呵呵，多谢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500421
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500421,
					"content": "这阵子到处都不太平，村里的年轻人大多还在外面忙活计。能看到有年轻人来，我这老婆子还是挺开心的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500422
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500422,
					"content": "更难得的是，作为外国人，对于海祇岛的传统仍怀着尊敬之心，真是了不起，哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500423
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500423,
					"content": "好了，不唠叨了。说起占卜呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500424
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500424,
					"content": "在占卜之前，二位如果不介意的话，可否先帮我一个小忙？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500425
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500425,
					"content": "什么嘛，还是要钱啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500426
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721500426,
					"content": "呵呵，不是要钱…且听我说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500427
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500427,
					"content": "望泷村的神龛之所以灵验，乃是有赖于其中供养的「海渊灵草」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500428
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500428,
					"content": "顾名思义，这种植物最初产于深深的海渊之下…也就是我们的祖先所发源之处。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500429
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500429,
					"content": "数千年前，我们村庄的先民将其遗株从深海带到陆地，加以仔细抚养。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500430
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500430,
					"content": "在一代代村人的照料下…不论是战乱或是天灾，抑或大御神殉难的悲怆…都未曾摧折这长寿的「灵草」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500431
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500431,
					"content": "因为是生长在水底的植物，所以需要频繁供应水源才能成活；",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500432
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500432,
					"content": "因为是曾生活在漆黑环境中的生物，所以永远会泛着磷色的微光…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500433
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500433,
					"content": "于是，我们通过光彩闪烁的规律来判断愿望是否可能得以实现，至于其中奥秘，就在于水源。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500434
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500434,
					"content": "呵呵，年轻些的巫女总会质疑占卜仪式的可信性，觉得这样的民间仪式不够正式，是在散播迷信…之类的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500435
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500435,
					"content": "她们更喜欢明确易懂的理论，不喜欢老一辈口口相传，慢慢衰变的传说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500436
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500436,
					"content": "但是呢…老人的智慧，代代相传的智慧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500437
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500437,
					"content": "或许一时间无法归纳成条目分明的理论，却总是或多或少蕴含着不容忽视的真理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500438
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500438,
					"content": "关于水源…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500439
					]
				},
				{
					"id": 721500439,
					"content": "水源…？哦！呵呵…抱歉，上了年纪，说话总是啰里啰嗦的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500440
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500440,
					"content": "想要供养「灵草」，需要取自岛上神社奉纳池中的水才行。因为那里的水饱含着「愿望」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500441
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500441,
					"content": "「愿望」…水中也会含有那种东西吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500442
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721500442,
					"content": "呵呵，是啊。每一个人托付的「愿望」会沉积在奉纳池中，消融在水里。就像蜜糖。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500443
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500443,
					"content": "没人能亲眼看到它…却能通过水的浓淡与甜味感受到它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500444
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500444,
					"content": "记忆也好，信仰也好…都是这样的道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500445
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500445,
					"content": "另外，要去取水的话，一定要小心…「愿望」的效力，离了奉纳池便很容易就会在空气中逸散…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500446
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500446,
					"content": "就像随着年月流逝而不断消散的梦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500447
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500447,
					"content": "通过触感与分量感的变化，很容易感知这种「愿望」的衰减。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500448
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500448,
					"content": "哇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500449
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721500449,
					"content": "哦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500450
					]
				},
				{
					"id": 721500450,
					"content": "呵呵，抱歉抱歉，话题又跑了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500451
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500451,
					"content": "总之，取到水之后，请不要耽搁太长时间，尽快回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500452
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500452,
					"content": "否则「愿望」的效力会逸散殆尽，「灵草」也难以汲取足够的养分了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500453
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500453,
					"content": "在那之后，还请麻烦再提醒我一下…还有一个步骤滋养「灵草」，占卜才会灵验。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500454
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500454,
					"content": "好麻烦！就没有巫女帮你吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500455
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721500455,
					"content": "唉…现在的年轻巫女要么嫌麻烦，要么对这种古老的传统嗤之以鼻，很少有愿意帮忙的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500456
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500456,
					"content": "您说的是露子吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500457
					]
				},
				{
					"id": 721500457,
					"content": "对哦，珊瑚宫边的那个巫女小姐，总是一副看不起老人家的样子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500458
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721500458,
					"content": "哦哦，你们见过她呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500459
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500459,
					"content": "呵呵，她呀…挺能干的，不过就是呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500460
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500460,
					"content": "呵呵…不多说了，年轻人嘛，总有一天能学会尊重故事传说的意义。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500461
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500461,
					"content": "唔…什么呀…听不明白。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500462
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721500462,
					"content": "看着「灵草」的光泽一日更比一日暗淡…老婆子我啊，比谁都要失落…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500463
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500463,
					"content": "可还是感觉好麻烦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500464
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721500464,
					"content": "有点理解巫女们的意见了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500465
					]
				},
				{
					"id": 721500465,
					"content": "所以，不知两位有没有兴趣帮忙取些水回来？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500466
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500466,
					"content": "我们会帮忙的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500467
					]
				},
				{
					"id": 721500467,
					"content": "那么就拜托你们了，非常感谢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500407,
					"content": "前方很危险吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500408
					]
				},
				{
					"id": 721500403,
					"content": "你好，老人家。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500404
					]
				}
			]
		},
		{
