			"dialogs": [
				{
					"id": 191430901,
					"content": "刚才我在馆里打扫的时候，外面突然吵闹了起来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191430902
					],
					"speakerTitle": "蓝川丞"
				},
				{
					"id": 191430902,
					"content": "我刚一出门，就看到…<color=#00E1FFFF>有个黑影从树下一下子窜了上去！</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191430903
					],
					"speakerTitle": "蓝川丞"
				},
				{
					"id": 191430903,
					"content": "这人来人往的，不会是什么小偷强盗吧…",
