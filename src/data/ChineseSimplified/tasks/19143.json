			"dialogs": [
				{
					"id": 191431001,
					"content": "怎么办？难道今天就玩不了《七圣召唤》了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431002
					],
					"speakerTitle": "奏太"
				},
				{
					"id": 191431002,
					"content": "要不然换个地方？可是除了桥底下，还有什么地方不容易被大人发现啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431003
					],
					"speakerTitle": "瑛太"
				},
				{
					"id": 191431003,
					"content": "啊啊…干脆去请宵宫姐姐放点烟花，把占地方的人给吓出来吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431004
					],
					"speakerTitle": "奏太"
				},
				{
					"id": 191431004,
					"content": "这不太好吧？虽然确实是他先动手把我们赶出来的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431005
					],
					"speakerTitle": "瑛太"
				},
				{
					"id": 191431005,
					"content": "所以全都是他不好嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431006
					],
					"speakerTitle": "奏太"
				},
				{
					"id": 191431006,
					"content": "我觉得…我们是不是，该回家写作业了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431007
					],
					"speakerTitle": "由真"
				},
				{
					"id": 191431007,
					"content": "老是打牌不学习的话，将来不会也变成<color=#00E1FFFF>桥底下那种大人</color>吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "由真"
				}
			]
		},
