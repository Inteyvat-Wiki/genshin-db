			"dialogs": [
				{
					"id": 761000701,
					"content": "别挡道，滚开！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000702
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 761000702,
					"content": "嘻嘻…你急什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000703
					],
					"speakerTitle": "来自魔物的声音"
				},
				{
					"id": 761000703,
					"content": "反正你们…迟早都得死…不过是…有人要提早上路了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000704
					],
					"speakerTitle": "来自魔物的声音"
				},
				{
					"id": 761000704,
					"content": "他不是抱怨…三年前自己没死成么…现在…我就成全他…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000705
					],
					"speakerTitle": "来自魔物的声音"
				},
				{
					"id": 761000705,
					"content": "…比约恩？你把他怎么了？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000706
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 761000706,
					"content": "是他太弱了…弱者…废物…虫豸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000707
					],
					"speakerTitle": "来自魔物的声音"
				},
				{
					"id": 761000707,
					"content": "…会死难道不是理所应当么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000708
					],
					"speakerTitle": "来自魔物的声音"
				},
				{
					"id": 761000708,
					"content": "不准你侮辱他！他一点也不弱！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000709
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 761000709,
					"content": "哦…在你看来…他是强者…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000710
					],
					"speakerTitle": "来自魔物的声音"
				},
				{
					"id": 761000710,
					"content": "可是…可是强者就不会死么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000711
					],
					"speakerTitle": "来自魔物的声音"
				},
				{
					"id": 761000711,
					"content": "我还以为…你心里清楚得很哪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000712
					],
					"speakerTitle": "来自魔物的声音"
				},
				{
					"id": 761000712,
					"content": "那些比你强的人…不都死掉了么…不管是三年前…还是十年前…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000713
					],
					"speakerTitle": "来自魔物的声音"
				},
				{
					"id": 761000713,
					"content": "…闭上你的狗嘴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000714
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 761000714,
					"content": "是啊…原来弱小的…就只有你而已啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000715
					],
					"speakerTitle": "来自魔物的声音"
				},
				{
					"id": 761000715,
					"content": "要不然为什么…每次…每次活下来的都只有你？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000716
					],
					"speakerTitle": "来自魔物的声音"
				},
				{
					"id": 761000716,
					"content": "…是你从战场逃跑了吧？苟且偷生的胆小鬼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000717
					],
					"speakerTitle": "来自魔物的声音"
				},
				{
					"id": 761000717,
					"content": "叶洛亚！别听它胡说八道！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000718
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761000718,
					"content": "少废话，纳命来！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761000719
					]
				},
				{
					"id": 761000719,
					"content": "#…{NICKNAME}！我们速战速决！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "叶洛亚"
				}
			]
		},
