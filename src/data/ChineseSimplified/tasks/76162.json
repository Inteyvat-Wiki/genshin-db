			"dialogs": [
				{
					"id": 761001601,
					"content": "…比约恩怎么样了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001602
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 761001602,
					"content": "…伤得很重。攻击来得太突然了，他为了保护我们…呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001603
					],
					"speakerTitle": "伊捷莉"
				},
				{
					"id": 761001603,
					"content": "…战场环境太危险，他也经不起转移的颠簸了，我们只能就地进行紧急处理，但以我们现有的能力，实在是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001604
					],
					"speakerTitle": "伊捷莉"
				},
				{
					"id": 761001604,
					"content": "…队长…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001605
					],
					"speakerTitle": "比约恩"
				},
				{
					"id": 761001605,
					"content": "比约恩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001606
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 761001606,
					"content": "…对不起…我没能完成任务…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001607
					],
					"speakerTitle": "比约恩"
				},
				{
					"id": 761001607,
					"content": "你完成得很好！阵地守住了，大家也都平安无事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001608
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 761001608,
					"content": "是吗…原来我做到了…太好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001609
					],
					"speakerTitle": "比约恩"
				},
				{
					"id": 761001609,
					"content": "别说话了，先专心养伤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001610
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 761001610,
					"content": "现在不说…以后就没机会了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001611
					],
					"speakerTitle": "比约恩"
				},
				{
					"id": 761001611,
					"content": "…这是队长命令！我不许你再说这种话！你会没事的…一定会没事的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001612
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 761001612,
					"content": "呵…好…遵命…我不会再说了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001613
					],
					"speakerTitle": "比约恩"
				},
				{
					"id": 761001613,
					"content": "不过…等我见到维德…也算能够交代了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001614
					],
					"speakerTitle": "比约恩"
				},
				{
					"id": 761001614,
					"content": "他以前常说…我们执灯人就像冬凌草…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001615
					],
					"speakerTitle": "比约恩"
				},
				{
					"id": 761001615,
					"content": "面对狂猎…我们每个人都很脆弱…就像冬凌草的花一样…会轻易凋落…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001616
					],
					"speakerTitle": "比约恩"
				},
				{
					"id": 761001616,
					"content": "但是…只要叶片还在…只要根还牢牢扎在泥土里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001617
					],
					"speakerTitle": "比约恩"
				},
				{
					"id": 761001617,
					"content": "到了下一季…再下一季…总会有新的花朵绽放…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001618
					],
					"speakerTitle": "比约恩"
				},
				{
					"id": 761001618,
					"content": "我们是不会失败的…对吧…队长…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001619
					],
					"speakerTitle": "比约恩"
				},
				{
					"id": 761001619,
					"content": "…嗯！我们绝不会失败！我一定会亲手、彻底将那魔物葬送！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001620
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 761001620,
					"content": "…你是我们之中最强的…我相信你…队长…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001621
					],
					"speakerTitle": "比约恩"
				},
				{
					"id": 761001621,
					"content": "…放心吧，比约恩，我一定遵守约定。你该休息了…等你伤养好了，一切都会好的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001622
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 761001622,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001623
					],
					"speakerTitle": "比约恩"
				},
				{
					"id": 761001623,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001624
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 761001624,
					"content": "#…{NICKNAME}，派蒙，我们该走了。任务还没结束，我们不能在这里耽搁了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001625
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 761001625,
					"content": "叶洛亚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001626,
						761001627
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761001626,
					"content": "就算为了比约恩，我们也得向前。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761001628
					]
				},
				{
					"id": 761001627,
					"content": "我们一定能打败敌人，取得胜利。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761001628
					]
				},
				{
					"id": 761001628,
					"content": "…嗯，继续前进吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "叶洛亚"
				}
			]
		}
	]
