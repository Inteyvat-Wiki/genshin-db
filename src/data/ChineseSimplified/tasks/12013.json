			"trigger": {
				"objectNames": [
					"义高"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120130301,
					"content": "你们胆敢妨碍公务，好大的胆子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130302
					],
					"speakerTitle": "义高"
				},
				{
					"id": 120130302,
					"content": "这种行为，天领奉行定会严惩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130303
					],
					"speakerTitle": "义高"
				},
				{
					"id": 120130303,
					"content": "就算你们逃到天涯海角，也休想逃脱制裁！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130304
					],
					"speakerTitle": "义高"
				},
				{
					"id": 120130304,
					"content": "说得这么吓人，跑得比谁都快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130305
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120130305,
					"content": "没时间耽误在他们的身上了，我们继续往里面走吧，应该就在里面了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宵宫"
				}
			]
		},
		{
			"id": 1201305,
			"completionStepIds": [
				1201305
