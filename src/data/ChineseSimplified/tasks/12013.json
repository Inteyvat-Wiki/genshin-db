			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"今谷佳祐"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120130501,
					"content": "哈啊…哈啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130502
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120130502,
					"content": "你的剑技，很久没有提升了，朔次郎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130503
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130503,
					"content": "你明知道和我决斗，是不可能有胜算的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130504
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130504,
					"content": "我没想到，最后会落到你的手上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130505
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120130505,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130506
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120130506,
					"content": "我认了，这就是命运吧，我已经没什么想说了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130507
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120130507,
					"content": "但至少你回来就说明，你最终还是认同了我的想法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130508
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130508,
					"content": "随你怎么说吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130509
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120130509,
					"content": "跟我回天领奉行，听候发落。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130510
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130510,
					"content": "这艘船的制造者，也逃不过惩处。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130511
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130511,
					"content": "等一下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130512
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120130512,
					"content": "为什么就这么决定了！你们没有更多的话要说吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130513
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120130513,
					"content": "我知道你，是长野原家造烟花的那个姑娘…早就知道你爱管闲事，但这件事和你无关。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130514
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130514,
					"content": "没事的，宵宫，过去的事已经没有什么好说的了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130515
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120130515,
					"content": "那你辛辛苦苦，不惜偷渡也要回到稻妻是为了什么？！犹豫那么久又是为了什么？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130516
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120130516,
					"content": "不就是想要现在这样，可以好好说话的机会吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130517
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120130517,
					"content": "我没有话要和他说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130518
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130518,
					"content": "他是犯人，我是天领奉行的执行者，本来就没有交谈的余地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130519
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130519,
					"content": "只是念在旧日的友谊，我给了他与我决斗的机会，但他的剑技还是像以前一样不争气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130520
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130520,
					"content": "为什么要说这种话？别再骗人了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130521
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120130521,
					"content": "你把你的手下都留在了那边封路，这里一个跟随的人都没有，不就是觉得，可能还有对话的机会吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130522
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120130522,
					"content": "明明两个人都是一副有话要说的样子，为什么就是什么都不愿意说啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130523
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120130523,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130524
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130524,
					"content": "自作多情，你又懂什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130525
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130525,
					"content": "行了，宵宫，我觉得只是我一厢情愿而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130526
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120130526,
					"content": "不行！明明什么都没做，当然不行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130527
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120130527,
					"content": "既然这样，佳祐，你习惯用决斗解决问题，那就跟我决斗吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130528
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120130528,
					"content": "只要我赢了你，你就要说出你的真心话，不要再把自己藏起来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130529
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120130529,
					"content": "朔次郎，你也是！我赢了的话，你就把你回来的原因告诉他，无论结果如何，都一定要说出来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130530
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120130530,
					"content": "不说的话，可能就再也没有机会了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130531
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120130531,
					"content": "那，如果你输了呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130532
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130532,
					"content": "我输了，那我就承认我是朔次郎的共犯，任凭天领奉行发落！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130533
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120130533,
					"content": "宵宫…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130534
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120130534,
					"content": "那我接受了，一决胜负吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "今谷佳祐"
				}
			]
		},
		{
			"id": 1201307,
			"completionStepIds": [
				1201307
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201307",
							"2"
						],
						"stepId": 1201307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"今谷佳祐"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120130701,
					"content": "#头儿，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_MALE_PRONOUN_SHE]}们真的很强，我们还要找更多的兄弟来支援…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130702
					],
					"speakerTitle": "义高"
				},
				{
					"id": 120130702,
					"content": "退下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130703
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130703,
					"content": "欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130704
					],
					"speakerTitle": "义高"
				},
				{
					"id": 120130704,
					"content": "不是让你们不要闯进来吗！都给我退下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130705
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130705,
					"content": "是、是…不好意思！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130706
					],
					"speakerTitle": "义高"
				},
				{
					"id": 120130706,
					"content": "我觉得，你这个姑娘，跟当年的朔次郎一样固执。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130707
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130707,
					"content": "你为什么觉得，我们之间一定有话要说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130708
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130708,
					"content": "因为，朔次郎回来，虽然没有对我讲你的故事，但他找我做了烟花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130709
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120130709,
					"content": "从你的爸爸妈妈那里，我听到了你和朔次郎过去的故事，那时候我就知道，这烟花对你们有特殊的意义。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130710
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120130710,
					"content": "——那就绝对不是无话可说，绝对不是！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130711
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120130711,
					"content": "不是为了感受寂寞，才放烟花的啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130712
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120130712,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130713
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130713,
					"content": "其实，我是因为迷茫才回来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130714
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120130714,
					"content": "并不是我改变了曾经的想法，而是我觉得我的做法只是在逃避现实。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130715
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120130715,
					"content": "我见识到了蒙德的自由，璃月的契约，须弥的智慧，枫丹的正义…对我而言都有很深的感触。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130716
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120130716,
					"content": "我庆幸我离开了稻妻，但在我庆幸之时，我偶然听说稻妻实施了锁国。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130717
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120130717,
					"content": "我是逃离者，我因我的逃跑而骄傲，但实际上，我真正应该做的，是把这些外面的东西带回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130718
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120130718,
					"content": "你还是天真地想要改变这里吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130719
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130719,
					"content": "不，不再是那么恢弘的想法了，我只是觉得逃走是不对的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130720
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120130720,
					"content": "明明你都没有逃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130721
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120130721,
					"content": "……！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130722
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130722,
					"content": "我过得并不好，也不知道你过得怎么样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130723
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120130723,
					"content": "但就像听到了命运的召唤，我想回来看看的心情，已经无法遏止了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130724
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120130724,
					"content": "…谁又过得好呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130725
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130725,
					"content": "我非常崇拜雷电将军，将她的一切想法都奉为教条去执行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130726
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130726,
					"content": "但我现在的工作，就是在惩罚锁国的违逆者，收缴神之眼。我没有想过成为天领奉行众会做这样的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130727
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130727,
					"content": "我做的，真的就是正确的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130728
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130728,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130729
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130729,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130730
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120130730,
					"content": "船留给你吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130731
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130731,
					"content": "欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130732
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120130732,
					"content": "我没法让你留在稻妻，但我不想把你抓回去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130733
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130733,
					"content": "但这样你不是没办法和上面交代？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130734
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120130734,
					"content": "不用管我，我有办法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130735
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130735,
					"content": "我听说现在外面的人想回稻妻，需要办理的手续很复杂，但总归还是有办法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130736
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130736,
					"content": "我会帮你一把的，在那之前，你在外面等着我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130737
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130737,
					"content": "…别死在路上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130738
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130738,
					"content": "放心吧，佳祐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130739
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120130739,
					"content": "我还想和你一起看烟花呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130740
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120130740,
					"content": "嗯，下次吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130741
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130741,
					"content": "这下子会被降职吧，唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130742
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130742,
					"content": "也老大不小的了，我怎么会做出这么幼稚的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130743
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130743,
					"content": "那个船…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120130744
					]
				},
				{
					"id": 120130744,
					"content": "就是朔次郎想用来逃跑的那一艘，之前我叫义高他们运到了这里，用的是「暂放违禁品」的说法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130745
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130745,
					"content": "把朔次郎追到这里来，也是我早就计划好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130746
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130746,
					"content": "就像宵宫所说，虽然当时我没下定决心，但我的行为，已经暴露了我的愿望…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130747
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130747,
					"content": "但我觉得你做得很正确，而且你看，只要把这些话都说出来，心中的芥蒂是能化解的啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130748
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120130748,
					"content": "嗯，我现在也明白了，谢谢你。没想到你这么敏锐，能看穿我的想法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130749
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130749,
					"content": "嘿嘿，因为我和你的爸妈很熟啊，他们都是特别特别好的人，那你一定也是好人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130750
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120130750,
					"content": "早听说长野原家后继有人，虽然有点鲁莽和吵闹，但…名不虚传。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130751
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130751,
					"content": "对了，那时候的烟花，「长野原烟花店」是可以重现的吧，能为我做一个吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130752
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130752,
					"content": "不行哦，没有那个纸条我是做不出来的，纸条已经被朔次郎带走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130753
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120130753,
					"content": "原来是这样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130754
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130754,
					"content": "那就算了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130755
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130755,
					"content": "嘿嘿，别这么沮丧，我之前说了嘛，朔次郎回来就找我做了烟花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130756
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120130756,
					"content": "虽然不能帮你做，但是现在朔次郎已经没办法放烟花了，为了不浪费，就破例让你代替他放吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130757
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120130757,
					"content": "…非常感谢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130758
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130758,
					"content": "嗯，可不要错过烟花会开始的时间了哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130759
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120130759,
					"content": "这件事上，宵宫表现得很强硬呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130760
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120130760,
					"content": "因为我喜欢说话嘛，我相信，语言拥有强大的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130761
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120130761,
					"content": "不愿意沟通的话，问题就会永远留在那里。人们就看着，看着…直到眼睁睁地错过所有解决它的机会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130762
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120130762,
					"content": "虽然朔次郎和佳祐已经没办法回到从前了，但至少…我觉得不应在心中留下懊悔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130763
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120130763,
					"content": "好了，跟我走吧，我带你去一个最适合看烟花会的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130764
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120130764,
					"content": "老爹会代替我，把答应送给你们的那个烟花，升上天空的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宵宫"
				}
			]
		},
		{
			"id": 1201308,
			"completionStepIds": [
				1201309
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201309",
							"2"
						],
						"stepId": 1201309,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"宵宫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120130801,
					"content": "啊，满足满足，这次的烟花会也好看得要哭出来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130802
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120130802,
					"content": "应该没有真的哭出来吧？我感觉眼眶湿湿的就是了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130803,
						120130804
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120130803,
					"content": "我也觉得非常漂亮。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120130805
					]
				},
				{
					"id": 120130805,
					"content": "对了，你看到第一枚升空的，那颗金色的大烟花了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130806
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120130806,
					"content": "那就是我拜托老爹为你们做的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130807
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120130807,
					"content": "哦哦，感觉很有气势，印象深刻！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130808
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120130808,
					"content": "哈哈，那就对了，那枚烟花我希望你们看过之后的感觉，就是印象深刻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130809
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120130809,
					"content": "无论走了多远，遇到了什么，觉得动摇了，或者累了，至少还能想起今天的烟花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130810
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120130810,
					"content": "我相信在时间的沉淀之后，这枚烟花在你们的心里，会变得越来越漂亮的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130811
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120130811,
					"content": "对了，这样的话你们就是我的客人了，来，纸条也收好，想再看这金色大烟花，就尽管来找我好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130812,
						120130813
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120130812,
					"content": "谢谢你的烟花。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120130814
					]
				},
				{
					"id": 120130814,
					"content": "不过，在看烟花的时候，宵宫你好像变了一个人，什么也不说，也好像什么都听不到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130815
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120130815,
					"content": "那个嘛，其实听到了，只是看烟花的时候，我从来不说话，这是我的习惯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130816
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120130816,
					"content": "自己做出来的东西，安静地目送它升空，是一件有仪式感而又神圣的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130817
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120130817,
					"content": "你刚刚问我，对我来说烟花是什么，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130818
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120130818,
					"content": "嗯嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130819
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120130819,
					"content": "对准备船的耕一来说，他和三姐好像是要纪念友谊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130820
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120130820,
					"content": "对佳祐的爸爸妈妈来说，他们纪念的是婚姻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130821
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120130821,
					"content": "而佳祐和朔次郎，他们要纪念的，嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130822
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120130822,
					"content": "是不曾改变的信念吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120130823
					]
				},
				{
					"id": 120130823,
					"content": "对对对，信念！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130824
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120130824,
					"content": "对我来说呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130825
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120130825,
					"content": "嘿嘿，老实说，我从来没想过，我不知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130826
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120130826,
					"content": "欸？我还以为能听到很震撼的答案呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130827
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120130827,
					"content": "因为其实没什么人会问我这个，我也不觉得这是件很了不起的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130828
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120130828,
					"content": "我只是碰巧生在了长野原家，碰巧在老爹的教导下学了这门手艺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130829
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120130829,
					"content": "碰巧认识了很多人，听说了很多事，知道他们都把心中珍视之物寄托在了烟花里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130830
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120130830,
					"content": "烟花一瞬间就消失了，那是和将军想要的永恒距离最远的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130831
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120130831,
					"content": "但大家的寄托可不会消失，那才是烟花存在的理由。如果没有人想看烟花，那就没有烟花了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130832
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120130832,
					"content": "这也是一种永恒吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120130833
					]
				},
				{
					"id": 120130833,
					"content": "但也要这么想，正是因为有这么多的人把思念寄托在烟花里，长野原才必须存在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130834
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120130834,
					"content": "不然，不是辜负了他们的心意吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130835
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120130835,
					"content": "#你知道吗，{NICKNAME}，虽然我不怎么会去考虑复杂的事——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130836
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120130836,
					"content": "但能生在长野原家，能做好多好多好多漂亮的烟花，我是非常自豪的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120130813,
					"content": "谢谢你的祝福。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120130814
					]
				},
				{
					"id": 120130804,
					"content": "长野原果然名不虚传。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120130805
					]
				}
			]
		},
