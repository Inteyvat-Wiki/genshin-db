					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120902
					],
					"speakerTitle": "今谷三郎"
				},
				{
					"id": 120120902,
					"content": "不过，那个孩子，总要学会面对他的心事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120903
					],
					"speakerTitle": "今谷香里"
				},
				{
					"id": 120120903,
					"content": "这是作父母的，没办法教他的东西啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "今谷香里"
