			"dialogs": [
				{
					"id": 120130201,
					"content": "前方正在执行公务，禁止通行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130202
					],
					"speakerTitle": "义高"
				},
				{
					"id": 120130202,
					"content": "朔次郎和佳祐就在里面对吧？我们有事情要找他们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130203
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120130203,
					"content": "听不懂话吗？说了禁止通行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130204
					],
					"speakerTitle": "义高"
				},
				{
					"id": 120130204,
					"content": "真碍事，那就别怪我们不客气了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宵宫"
				}
			]
		},
		{
			"id": 1201303,
			"completionStepIds": [
				1201304
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
