			"trigger": {
				"objectNames": [
					"松坂"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120130101,
					"content": "宵宫姐姐好！对付「大貉妖」的武器，宵宫姐姐做好了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130102
					],
					"speakerTitle": "松坂"
				},
				{
					"id": 120130102,
					"content": "那个我已经拜托给龙之介伯伯了，等会儿你们就去找他拿吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130103
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120130103,
					"content": "欸？难道姐姐不陪我们玩了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130104
					],
					"speakerTitle": "彩香"
				},
				{
					"id": 120130104,
					"content": "对不起，姐姐还有些重要的事，会稍微晚一点回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130105
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120130105,
					"content": "下次给你们带糖果吧！就是你们喜欢的，很甜很甜的那种糖。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130106
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120130106,
					"content": "好！又有糖吃啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130107
					],
					"speakerTitle": "岩夫"
				},
				{
					"id": 120130107,
					"content": "对了，我有个事想打听，你们刚刚看到了一群看起来很凶的叔叔经过这里吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130108
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120130108,
					"content": "有的有的，他们好像在抓什么人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130109
					],
					"speakerTitle": "彩香"
				},
				{
					"id": 120130109,
					"content": "他们是不是也在抓妖怪啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130110
					],
					"speakerTitle": "岩夫"
				},
				{
					"id": 120130110,
					"content": "没事，你们不用担心，是叔叔他们误会了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130111
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120130111,
					"content": "你们听话，留在城里，等烟花会开始了就和大家一起玩吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130112
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120130112,
					"content": "嗯，会好好听话的！宵宫姐姐说什么我们就做什么！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "松坂"
				}
			]
		},
