					"艾伦"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200070101,
					"content": "#谢，谢谢你，{NICKNAME}，太好了，我还以为这次完蛋了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070102
					],
					"speakerTitle": "艾伦"
				},
				{
					"id": 200070102,
					"content": "这车上都是猎手们辛苦狩猎的成果，杜拉夫先生要我送去蒙德城。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070103
					],
					"speakerTitle": "艾伦"
				},
				{
					"id": 200070103,
					"content": "虽然我不…太擅长狩猎，但是押送这么简单的活，应该还是能做的，我开始是这么想的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070104
					],
					"speakerTitle": "艾伦"
				},
				{
					"id": 200070104,
					"content": "但还是差点搞砸了。突然被这么袭击，肯定是因为这些猎物太好了，那群家伙也想要，还好你来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070105
					],
					"speakerTitle": "艾伦"
				},
				{
					"id": 200070105,
					"content": "呃，虽然很不好意思，但是…刚才被袭击的时候，货车也被弄坏了，想要离开这，我必须把车修好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070106
					],
					"speakerTitle": "艾伦"
				},
				{
					"id": 200070106,
					"content": "周围的树林里应该有能用的材料。但是猎物还在车里，走开的话我实在很担心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070107
					],
					"speakerTitle": "艾伦"
				},
				{
					"id": 200070107,
					"content": "如果可以的话，你能帮我从周围找一块<color=#00E1FFFF>结实的木板</color>来吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾伦"
				}
			]
		},
		{
			"id": 2000702,
