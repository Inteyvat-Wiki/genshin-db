				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"胡塞尼",
					"阿昊",
					"老图"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715030101,
					"content": "#你来得好，{NICKNAME}，我们正讨论怎么将「普尔希娜光钉」搬运进去的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030102
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715030102,
					"content": "不过这里的情况比我们想象的严重太多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030103
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715030103,
					"content": "咳咳…不行，这里的黑泥太多，又全是黑泥引来的怪物，搬不进去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030104
					],
					"speakerTitle": "阿昊"
				},
				{
					"id": 715030104,
					"content": "根本找不到能够再往前的路…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030105
					],
					"speakerTitle": "阿昊"
				},
				{
					"id": 715030105,
					"content": "这还远没到矿道里面呢，来，再搭把手，再试试。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030106
					],
					"speakerTitle": "老图"
				},
				{
					"id": 715030106,
					"content": "要是还是不行，我就去外面再找几个弟兄！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030107
					],
					"speakerTitle": "老图"
				},
				{
					"id": 715030107,
					"content": "不就是搬个东西嘛，我挖矿巨星老图，随便挥挥镐子就能挖空一座山，这层岩巨渊里的怪物能奈我何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030108
					],
					"speakerTitle": "老图"
				},
				{
					"id": 715030108,
					"content": "你就别装了，你憋咳嗽憋得脸都红了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030109
					],
					"speakerTitle": "阿昊"
				},
				{
					"id": 715030109,
					"content": "你胡说，我哪有，呃咳，咳咳咳咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030110
					],
					"speakerTitle": "老图"
				},
				{
					"id": 715030110,
					"content": "不能再继续前进了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030111
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715030111,
					"content": "过度接触这些黑泥，会造成严重后果，而且里面怪物那么多，太危险了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030112
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715030112,
					"content": "可是，可是我们都看到了，之前把机器放到矿区，矿区不就干净了嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030113
					],
					"speakerTitle": "老图"
				},
				{
					"id": 715030113,
					"content": "要是，咳咳，要是能早点解决矿道里的这些黑泥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030114
					],
					"speakerTitle": "老图"
				},
				{
					"id": 715030114,
					"content": "这不是追求速成的时候，无论是处理问题还是实验，不进行准备，完成勘查，就贸然进行，一个误操作就会造成生命危险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030115
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715030115,
					"content": "「个人生命至关重要」，这是「教令院」实验室操作手册上的基本守则之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030116
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715030116,
					"content": "身为「教令院」的学者，我不能对这样的行为视而不见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030117
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715030117,
					"content": "唉，可是我们停手了…这么多黑泥该怎么办？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030118
					],
					"speakerTitle": "阿昊"
				},
				{
					"id": 715030118,
					"content": "如果这些黑泥引来更多怪物…就算我们再来二十个人…咳咳，都没法送进去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030119
					],
					"speakerTitle": "阿昊"
				},
				{
					"id": 715030119,
					"content": "我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030120
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715030120,
					"content": "实在不行就，在这里先启动一次光钉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030121
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715030121,
					"content": "在这里启动光钉？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030122
					],
					"speakerTitle": "阿昊"
				},
				{
					"id": 715030122,
					"content": "对，我刚才目测了一下黑泥涌出的速率，虽然比昨天矿区里要快，但是毕竟不是黑泥的核心区域，清理的速度会比涌出的速度快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030123
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715030123,
					"content": "层岩巨渊的怪物被黑泥吸引，肯定也是受到了黑泥里能量的影响。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030124
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715030124,
					"content": "#在这里启动光钉，减轻周围黑泥的影响，对{NICKNAME}你的行动也有助益。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030125
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715030125,
					"content": "如果清理完黑泥，怪物也不会在此聚集。到时候再试试看往里搬运吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030126
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715030126,
					"content": "那就这么办。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715030127
					]
				},
				{
					"id": 715030127,
					"content": "两位，就先回营地休息一下，之后还有麻烦两位的时候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030128
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715030128,
					"content": "我还不用休息，就这点事…咳咳，还没到我挖矿巨星想要休息的时候，不就是清理怪物嘛，我能帮得上忙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030129
					],
					"speakerTitle": "老图"
				},
				{
					"id": 715030129,
					"content": "别强撑着了，我还不知道你？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030130
					],
					"speakerTitle": "阿昊"
				},
				{
					"id": 715030130,
					"content": "#这位可是{NICKNAME}，事情交给{NICKNAME}，还有什么需要我和你操心的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030131
					],
					"speakerTitle": "阿昊"
				},
				{
					"id": 715030131,
					"content": "#{NICKNAME}，清理周围的黑泥和怪物，就交给你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030132,
						715030133
					],
					"speakerTitle": "阿昊"
				},
				{
					"id": 715030132,
					"content": "嗯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715030134
					]
				},
				{
					"id": 715030134,
					"content": "#对了，{NICKNAME}这周围全是黑泥，比我想象的要严重太多了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030135
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715030135,
					"content": "黑泥周围还有很多的怪物，一定要小心啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030136
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715030136,
					"content": "我会小心的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715030137
					]
				},
				{
					"id": 715030137,
					"content": "不，我是说，一定要注意「普尔希娜光钉」的安全啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030138
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715030138,
					"content": "我相信你的实力，但是「普尔希娜光钉」毕竟是精密而脆弱的伟大仪器…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030139
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715030139,
					"content": "可得注意不让光钉受到损伤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715030133,
					"content": "交给我，你们就放心吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715030134
					]
				}
			]
		}
	]
}