			"dialogs": [
				{
					"id": 718030301,
					"content": "喵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030302
					],
					"speakerTitle": "灰灰"
				},
				{
					"id": 718030302,
					"content": "咦？怎么有只小猫在这里，难道刚才的叫声是它发出来的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 718030303,
					"content": "喵…喵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030304,
						718030308
					],
					"speakerTitle": "灰灰"
				},
				{
					"id": 718030304,
					"content": "灰色的小猫…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030305
					]
				},
				{
					"id": 718030305,
					"content": "灰色的小猫…走失在野外…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 718030306,
					"content": "啊！岚姐之前提到了一个找猫的委托…难道它就是那只猫？好像是叫灰灰还是什么的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 718030307,
					"content": "没想到会在这里找到它…它难道一直躲在这附近吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 718030311,
					"content": "因为丘丘岩盔王在这里的原因，也没有人敢过来找它…它也不敢出去，只能一直躲在这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 718030312,
					"content": "还好我们过来了，不然它不知道还要在这里待到什么时候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 718030313,
					"content": "喵…喵喵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030314,
						718030317
					],
					"speakerTitle": "灰灰"
				},
				{
					"id": 718030314,
					"content": "喵…喵…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030315
					]
				},
				{
					"id": 718030315,
					"content": "喂，你在做什么啊，这样子它也听不懂的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 718030316,
					"content": "我们把它带回去给岚姐好了，让她把灰灰还给委托人吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 718030319,
					"content": "喵…喵！喵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030320,
						718030322
					],
					"speakerTitle": "灰灰"
				},
				{
					"id": 718030320,
					"content": "喵…喵！喵！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030321
					]
				},
				{
					"id": 718030321,
					"content": "你再怎么学它，它也听不懂啦！我们快点把它带回去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 718030322,
					"content": "它好像也答应了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030323
					]
				},
				{
					"id": 718030323,
					"content": "你是怎么听懂的啦…算了，那我们快点把它带回去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 718030317,
					"content": "带回去给岚姐吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030318
					]
				},
				{
					"id": 718030318,
					"content": "嗯，也只有这样了。把灰灰带回去给岚姐，让岚姐把它还给委托人吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 718030308,
					"content": "难道它就是灰灰…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030309
					]
				},
				{
					"id": 718030309,
					"content": "灰色的小猫…走失在野外…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 718030310,
					"content": "啊！是岚姐之前提到的那个委托，居然会在这里发现它…难道它一直躲在这附近？",
					"roleType": "TALK_ROLE_NPC",
