			"dialogs": [
				{
					"id": 761920201,
					"content": "拍得真好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920202
					],
					"speakerTitle": "玫熙"
				},
				{
					"id": 761920202,
					"content": "现在心满意足了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920203
					],
					"speakerTitle": "赫卡"
				},
				{
					"id": 761920203,
					"content": "嗯！不管传说是不是真的，我希望不论赫卡走到哪里，好运都会助你化险为夷，最后平安回到「斯佩兰扎」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920204
					],
					"speakerTitle": "玫熙"
				},
				{
					"id": 761920204,
					"content": "…谢谢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920205
					],
					"speakerTitle": "赫卡"
				},
				{
					"id": 761920205,
					"content": "嘿嘿，那我们回去吧？莉奈娅姐姐，也谢谢你，我们「斯佩兰扎」见！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920206
					],
					"speakerTitle": "玫熙"
				},
				{
					"id": 761920206,
					"content": "「斯佩兰扎」见！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莉奈娅"
				}
			]
