		},
		{
			"id": 7408805,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"纳克"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740880501,
					"content": "这里原本应该是布托尔的「发条应用研究院」。在传统发条机械这一研究领域，布托尔先生是数一数二的权威。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740880502
					],
					"speakerTitle": "纳克"
				},
				{
					"id": 740880502,
					"content": "但是…从学术角度来看，传统发条机械的发展和改进已经到了瓶颈，从应用角度来说，传统发条机械的劣势也太过明显。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740880503
					],
					"speakerTitle": "纳克"
				},
				{
					"id": 740880503,
					"content": "总之，布托尔先生的研究逐渐在院里陷入了边缘化，不仅被削减了经费，也招不到多少研究员。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740880504
					],
					"speakerTitle": "纳克"
				},
				{
					"id": 740880504,
					"content": "最后在一系列的倒霉事之后，布托尔先生的研究组彻底宣告解散，这里也基本上被废弃了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740880505
					],
					"speakerTitle": "纳克"
				},
				{
					"id": 740880505,
					"content": "唉，要我说，布托尔先生真是倒霉透顶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "纳克"
				}
			]
		},
		{
