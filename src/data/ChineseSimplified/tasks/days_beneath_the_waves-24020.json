	"talks": [
		{
			"id": 2402001,
			"completionStepIds": [
				2402001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2402001",
							"2"
						],
						"stepId": 2402001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"伊维斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240200101,
					"content": "真是倒霉，我绝对不能再下水了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200102,
						240200103
					],
					"speakerTitle": "伊维斯"
				},
				{
					"id": 240200102,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200104
					]
				},
				{
					"id": 240200104,
					"content": "是您啊。见到您真好，呼…我差点把命丢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200105
					],
					"speakerTitle": "伊维斯"
				},
				{
					"id": 240200105,
					"content": "我刚刚和往常一样下水干活。下潜了之后，我避过了水草，躲过了垃圾，也没被什么东西划伤或者刺中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200106
					],
					"speakerTitle": "伊维斯"
				},
				{
					"id": 240200106,
					"content": "但就在我打捞东西的时候，水底的泥巴里突然窜出了一群怪物！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200107
					],
					"speakerTitle": "伊维斯"
				},
				{
					"id": 240200107,
					"content": "我不记得具体是什么怪物了，只记得它们猛地撞了过来，我只能赶紧逃跑，一直朝上游。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200108
					],
					"speakerTitle": "伊维斯"
				},
				{
					"id": 240200108,
					"content": "但游了没多远，又撞见了一群怪模怪样的机关，它们看见了我，也和疯了一样朝我冲了过来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200109
					],
					"speakerTitle": "伊维斯"
				},
				{
					"id": 240200109,
					"content": "我都不知道是怎么逃上岸的，还好没受什么伤，潜水服也没损坏…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200110,
						240200111
					],
					"speakerTitle": "伊维斯"
				},
				{
					"id": 240200110,
					"content": "这么危险，那就别在这里打捞了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200112
					]
				},
				{
					"id": 240200112,
					"content": "那可不行啊。这里是戈尔德曼划定的地点…之前就有不少人在这里打捞时受了伤，甚至丢了命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200113
					],
					"speakerTitle": "伊维斯"
				},
				{
					"id": 240200113,
					"content": "久而久之，就算是戈尔德曼威胁说要扣工资，也没有人愿意来这里打捞了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200114
					],
					"speakerTitle": "伊维斯"
				},
				{
					"id": 240200114,
					"content": "过了段时间，戈尔德曼就换了个方法，他说只要有人愿意来这里打捞，就能拿到三倍的钱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200115
					],
					"speakerTitle": "伊维斯"
				},
				{
					"id": 240200115,
					"content": "于是…我和几个实在缺钱的潜水员就接下了这份差事，在这里轮班打捞，还买了几根鱼矛鱼叉用来在水下防身。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200116
					],
					"speakerTitle": "伊维斯"
				},
				{
					"id": 240200116,
					"content": "但还没捞几天，这些武器要么断了，要么丢了…其他人只能去城里再买一批，而我在这里守着。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200117,
						240200118
					],
					"speakerTitle": "伊维斯"
				},
				{
					"id": 240200117,
					"content": "那你刚才还下水？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200119
					]
				},
				{
					"id": 240200119,
					"content": "他们这么长时间还不回来，再不开工，我今天又不知道要熬到多晚了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200120
					],
					"speakerTitle": "伊维斯"
				},
				{
					"id": 240200120,
					"content": "我来帮…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200121
					]
				},
				{
					"id": 240200121,
					"content": "不行！这可不行，这水底下可是有实打实的怪物，一般的冒险家都对付不了它们，我可不能让您冒这个险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200122,
						240200123
					],
					"speakerTitle": "伊维斯"
				},
				{
					"id": 240200122,
					"content": "我是不一般的冒险家。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200124
					]
				},
				{
					"id": 240200124,
					"content": "您…的确看着就不一般…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200125
					],
					"speakerTitle": "伊维斯"
				},
				{
					"id": 240200125,
					"content": "好吧，既然您坚持的话，我把那些东西的位置都给您标好，请千万注意安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊维斯"
				},
				{
					"id": 240200123,
					"content": "你看我像一般的冒险家吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200124
					]
				},
				{
					"id": 240200118,
					"content": "没防身的武器你还下水？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200119
					]
				},
				{
					"id": 240200111,
					"content": "太危险了，不然还是换个地方吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200112
					]
				},
				{
					"id": 240200103,
					"content": "你遇见什么事了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200104
					]
				}
			]
		},
		{
			"id": 2402002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
