				"points": []
			},
			"dialogs": [
				{
					"id": 240200201,
					"content": "您帮我捞到那些东西了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊维斯"
				}
			]
		},
		{
			"id": 2402003,
			"completionStepIds": [
				2402005
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2402005",
							"2"
						],
						"stepId": 2402005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"伊维斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240200301,
					"content": "没错，这就是我们成天打捞的东西，尽是一些这样的破烂垃圾。那个成天吃破烂的吝啬鬼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200302
					],
					"speakerTitle": "伊维斯"
				},
				{
					"id": 240200302,
					"content": "多谢您帮我，这些钱是我之前找戈尔德曼预支的工资，请您收下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200303
					],
					"speakerTitle": "伊维斯"
				},
				{
					"id": 240200303,
					"content": "我不能拿这些钱。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200304
					]
				},
				{
					"id": 240200304,
					"content": "必须收下，这是您由工作所获的报酬！这些钱已经不属于我，如果您不要，我就让钱袋子沉进水底去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200305
					],
					"speakerTitle": "伊维斯"
				},
				{
					"id": 240200305,
					"content": "好吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200306
					]
				},
				{
					"id": 240200306,
					"content": "这就好了，假如您之后有什么东西要捞，尽管来找我，无论您要捞的东西在哪，我一定给您完完整整地捞上来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200307
					],
					"speakerTitle": "伊维斯"
				},
				{
					"id": 240200307,
					"content": "我得再休息一会…唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊维斯"
				}
			]
		},
		{
			"id": 2402004,
			"completionStepIds": [
				2402006
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2402006",
							"2"
						],
						"stepId": 2402006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"伊维斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240200401,
					"content": "这是…哎呀！这里面怎么尽是些首饰？难道戈尔德曼真正想让我们捞的，其实是这东西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200402
					],
					"speakerTitle": "伊维斯"
				},
				{
					"id": 240200402,
					"content": "多谢您帮我，这些钱…这些钱请您收下，请您千万别说出去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200403
					],
					"speakerTitle": "伊维斯"
				},
				{
					"id": 240200403,
					"content": "要是能把它卖出去，我就能给自己买一套潜水服，再也不用付戈尔德曼租金了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200404,
						240200405
					],
					"speakerTitle": "伊维斯"
				},
				{
					"id": 240200404,
					"content": "我不能收。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200406
					]
				},
				{
					"id": 240200406,
					"content": "不！不！这是您应得的报酬，这么一点钱一定配不上您刚才的劳苦，但这是我最后一点钱了，本来是预备着晚上去喝点酒的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200407
					],
					"speakerTitle": "伊维斯"
				},
				{
					"id": 240200407,
					"content": "请您一定收下！我收拾收拾，等会就去看看，怎么才能把这首饰悄悄卖出去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊维斯"
				},
				{
					"id": 240200405,
					"content": "我不会说出去。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200406
					]
				}
			]
		},
		{
			"id": 2402005,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2402002",
							"2"
						],
						"stepId": 2402002,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2402003",
							"2"
						],
						"stepId": 2402003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"伊维斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240200501,
					"content": "那个吝啬鬼，呸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200502,
						240200508,
						240200512
					],
					"speakerTitle": "伊维斯"
				},
				{
					"id": 240200502,
					"content": "你能再说说戈尔德曼吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200503
					]
				},
				{
					"id": 240200503,
					"content": "戈尔德曼是我老板，雇了一群像我这样没什么本事，只能卖自个力气赚钱糊口的人为他工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200504
					],
					"speakerTitle": "伊维斯"
				},
				{
					"id": 240200504,
					"content": "这个脑子里只有枫达的家伙既苛刻，又吝啬！他要求我们在工作时绝对遵守那本厚厚的工作准则…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200514
					],
					"speakerTitle": "伊维斯"
				},
				{
					"id": 240200514,
					"content": "而且，就连我们工作时用的潜水服也是他「租」给我们的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200505
					],
					"speakerTitle": "伊维斯"
				},
				{
					"id": 240200505,
					"content": "只要我们违反了工作条例，或者潜水服破损，我们就得反过来赔他一笔钱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200515
					],
					"speakerTitle": "伊维斯"
				},
				{
					"id": 240200515,
					"content": "也就是说，假如我工作时一个不小心，我甚至要付一笔钱给这吝啬鬼，央求他继续雇我！呸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200506
					],
					"speakerTitle": "伊维斯"
				},
				{
					"id": 240200506,
					"content": "您了解他做什么，难道是想去见见他吗？我求您，就算是为了您的名声着想，也一定要离戈尔德曼远一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200516
					],
					"speakerTitle": "伊维斯"
				},
				{
					"id": 240200516,
					"content": "他是个无耻的人，身边总聚着一群和他臭味相投的坏种…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200507
					],
					"speakerTitle": "伊维斯"
				},
				{
					"id": 240200507,
					"content": "您可千万不要和他交往，想把一个烂泥坑清理干净，再倒满清水绝不是一件容易的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200517
					],
					"speakerTitle": "伊维斯"
				},
				{
					"id": 240200517,
					"content": "但用臭泥巴污染一个清白的池塘，是根本不费一点工夫的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊维斯"
				},
				{
					"id": 240200508,
					"content": "你的工作很辛苦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200509
					]
				},
				{
					"id": 240200509,
					"content": "哈，您说得没错，但这也是我唯一能谋生的路子了。我不聪明，没其他的本事，但也绝不愿意做不好的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200518
					],
					"speakerTitle": "伊维斯"
				},
				{
					"id": 240200518,
					"content": "如果我非得做坏事才能换来面包，那我宁愿饿着肚子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200510
					],
					"speakerTitle": "伊维斯"
				},
				{
					"id": 240200510,
					"content": "现在的活虽然辛苦得很，但我每天晚上睡觉至少合得上眼，不必担心有人恨透了我，想趁我睡着后拿刀刺我的眼睛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200511
					],
					"speakerTitle": "伊维斯"
				},
				{
					"id": 240200511,
					"content": "在这一点上，我可比戈尔德曼好上太多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊维斯"
				},
				{
					"id": 240200512,
					"content": "再见。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200513
					]
				},
				{
					"id": 240200513,
					"content": "#行，打捞的事就倚仗您了，好心的{M#先生}{F#女士}，我得休息一会…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊维斯"
				}
			]
		},
		{
			"id": 2402006,
			"completionStepIds": [
				2402001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2402001",
							"2"
						],
						"stepId": 2402001,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"2401701",
							"2"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"伊维斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240200601,
					"content": "唉…真是坏运气…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200602
					],
					"speakerTitle": "伊维斯"
				},
				{
					"id": 240200602,
					"content": "你把东西卖出去了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200603
					]
				},
				{
					"id": 240200603,
					"content": "是您啊。别提了，我本来都悄悄地找好了卖家，但戈尔德曼突然闯进了我屋子，把那盒首饰都拿走了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200604
					],
					"speakerTitle": "伊维斯"
				},
				{
					"id": 240200604,
					"content": "如果不是他还需要我干活，那我肯定要挨一顿狠揍了…但我还是被他扣下了两个月的工资…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200616
					],
					"speakerTitle": "伊维斯"
				},
				{
					"id": 240200616,
					"content": "要等我做完了今年所有的活计，再把钱给我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200605
					],
					"speakerTitle": "伊维斯"
				},
				{
					"id": 240200605,
					"content": "唉…算了，算了。好运气总是不愿意搭理我这类蠢蛋的…戈尔德曼没有找您吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200606,
						240200609
					],
					"speakerTitle": "伊维斯"
				},
				{
					"id": 240200606,
					"content": "没有。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200607
					]
				},
				{
					"id": 240200607,
					"content": "那就好，我就算挨揍了也不要紧，就是不愿这家伙去找您的麻烦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200608
					],
					"speakerTitle": "伊维斯"
				},
				{
					"id": 240200608,
					"content": "我没有把您帮忙打捞的事说出来，但我总觉着，是有其他人知道了这件事，向那吝啬鬼告了密…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200611
					],
					"speakerTitle": "伊维斯"
				},
				{
					"id": 240200611,
					"content": "不过，今天我必须得再请您帮帮忙了，我的潜水服还没补好，但戈尔德曼却一个劲地催我工作，把前几天没干完的活全补上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200612
					],
					"speakerTitle": "伊维斯"
				},
				{
					"id": 240200612,
					"content": "我只能找人家借了一套潜水服，赶紧来捞东西了…但这样还是捞不完，只能再请您发发好心，帮我一把了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200613,
						240200614
					],
					"speakerTitle": "伊维斯"
				},
				{
					"id": 240200613,
					"content": "没问题！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200615
					]
				},
				{
					"id": 240200615,
					"content": "谢谢您，我把那些东西的位置都给您标好，咱们俩就分头出发吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊维斯"
				},
				{
					"id": 240200614,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200615
					]
				},
				{
					"id": 240200609,
					"content": "他来的话，我就得教训他了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200610
					]
				},
				{
					"id": 240200610,
					"content": "您可千万不要和那胖子沾上关系。他是个卑劣无耻的家伙！您这样值得敬佩的好人根本就不该结识他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200611
					],
					"speakerTitle": "伊维斯"
				}
			]
		}
	]
}