					"speakerTitle": "杜拉夫"
				},
				{
					"id": 200610502,
					"content": "喂！你做了什么，这些鸽子都是用来寄信的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610503
					],
					"speakerTitle": "杜拉夫"
				},
				{
