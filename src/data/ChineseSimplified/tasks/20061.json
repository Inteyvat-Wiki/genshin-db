			},
			"dialogs": [
				{
					"id": 200610101,
					"content": "关于鸽子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610102
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 200610102,
					"content": "这些鸽子，还不如做下酒菜算了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610103
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 200610103,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200610104
					]
				},
				{
					"id": 200610104,
					"content": "我本来在这里养了一群鸽子，用来给人们送信。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610105
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 200610105,
					"content": "但是也不知道是为什么，最近这些鸽子们越来越不靠谱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610106
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 200610106,
					"content": "不是把信送丢，就是送半天也送不到，停在地上半天不动，非要人赶不可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610111
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 200610111,
					"content": "如果你有空的话，就帮我去看看刚放出去的那批鸽子吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610107,
						200610109
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 200610107,
					"content": "我明白了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200610108
					]
				},
				{
					"id": 200610108,
					"content": "那就拜托你了，如果看见鸽子们在偷懒，就赶赶它们吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 200610109,
					"content": "会被鸽子讨厌的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200610110
					]
				},
				{
					"id": 200610110,
					"content": "没关系，鸽子的记忆很短，过一会就什么都忘记了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610112
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 200610112,
					"content": "看不出来，你这么喜欢鸽子啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "杜拉夫"
				}
			]
		},
