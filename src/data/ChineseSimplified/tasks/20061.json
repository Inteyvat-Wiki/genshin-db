				},
				{
					"id": 200610403,
					"content": "但我也不能跟着看，不过总之先这样吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610404
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 200610404,
					"content": "辛苦你了，这是答谢，以后要寄信的话就过来打个招呼吧。",
