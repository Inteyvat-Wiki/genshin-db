						200610505
					]
				},
				{
					"id": 200610505,
					"content": "光道歉起作用的话，那要西风骑士团做什么？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610508
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 200610508,
					"content": "犯错了就要有惩罚，你就代替鸽子们把信送过去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 200610506,
					"content": "赶鸽子太用力了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200610507
					]
				},
				{
					"id": 200610507,
					"content": "赶鸽子？你是拿着锅铲去赶的吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610508
