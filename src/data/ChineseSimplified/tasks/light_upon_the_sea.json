			"trigger": {
				"objectNames": [
					"魈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413130201,
					"content": "如何，事情了结了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130202
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413130202,
					"content": "已经了结了，但是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130203
					]
				},
				{
					"id": 413130203,
					"content": "如此就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130204
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413130204,
					"content": "真的不去看明霄灯吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130205
					]
				},
				{
					"id": 413130205,
					"content": "不去。我说过了，不喜欢人来人往之处，尤其是每年的这几天里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130206
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413130206,
					"content": "今年的明霄灯是「移霄导天真君」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130207
					]
				},
				{
					"id": 413130207,
					"content": "对，是一只看上去很神气很神气的鹿哦，我们一起去看看吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413130208,
					"content": "「移霄导天真君」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130209
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413130209,
					"content": "但终究只是座霄灯罢了，人造的死物，无趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130210
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413130210,
					"content": "你们自去城里，看个热闹就是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "魈"
				}
			]
		},
		{
			"id": 4131303,
			"completionStepIds": [
				4131303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4131303",
							"2"
						],
						"stepId": 4131303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"菲尔戈黛特"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413130301,
					"content": "看来，你们又和魈一起办了件大事啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130302
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 413130302,
					"content": "动静可不小啊，我们在这里都听说了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130303
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 413130303,
					"content": "不过，眼看着今年的海灯节又要结束了，他还是没去看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130304
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 413130304,
					"content": "嗨…这么多年了，我就没见过那位去过海灯节。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130305
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 413130305,
					"content": "要我说，你就是让我把海灯节给搬过来，都比请那位去海灯节要容易…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130306
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 413130306,
					"content": "把海灯节给…搬过来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413130307,
					"content": "好主意。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130308
					]
				},
				{
					"id": 413130308,
					"content": "对啊！既然魈不去海灯节，那我们就把海灯节搬过来给他好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413130309,
					"content": "嗯？这玩笑话…如何当真？要怎么「搬过来」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130310
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 413130310,
					"content": "在逛海灯节的时候，我们学了怎么编「霄灯」，还找到了一个卖特色小吃的摊子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413130311,
					"content": "很多好吃的，漂亮的霄灯，还有…嗯…过往的英雄，和他以前的好朋友们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413130312,
					"content": "这不就是海灯节的全部吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413130313,
					"content": "这么说倒也没错，可是要在哪里布置才好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130314
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 413130314,
					"content": "要这么说的话，那我寻思着，地方得宽敞点，还得搭个摊子才行，嗯…<color=#00E1FFFF>客栈底下</color>也许还有点空间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130315
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 413130315,
					"content": "我们一起去下面选个地方吧。我大概知道你们想要个什么样的摊子了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130316
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 413130316,
					"content": "唔…应该有些样式可以参考的，我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "淮安"
				}
			]
		},
		{
			"id": 4131307,
			"completionStepIds": [
				4131307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4131307",
							"2"
						],
						"stepId": 4131307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"淮安"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413130701,
					"content": "这里还不错，嗯…也很僻静，很合适。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130702
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 413130702,
					"content": "那就这里了，我刚才寻思了寻思，也想好怎么建你们要的那种小摊了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130703
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 413130703,
					"content": "你们稍等啊，我看看，该从哪先开始…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130704
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 413130704,
					"content": "成了，差不多就是这样了，你们看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130705
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 413130705,
					"content": "掌柜的，你这木工…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130706
					]
				},
				{
					"id": 413130706,
					"content": "哎呀，一点点小手艺，不值一提，很多年前学的，我都忘得差不多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130707
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 413130707,
					"content": "这下子摊子有了，我还顺便在上面摆了点「霄灯」，看着还不错吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130708
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 413130708,
					"content": "编霄灯你也会？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130709
					]
				},
				{
					"id": 413130709,
					"content": "哎呀，我这个年纪的璃月人，基本上都会编霄灯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130710
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 413130710,
					"content": "对了，大过节的…请客总得吃点好的吧，你们想好请那位吃什么了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130711
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 413130711,
					"content": "吃…「杏仁豆腐」！我们之前请魈吃过的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130712
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413130712,
					"content": "还有「烤吃虎鱼」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130713
					]
				},
				{
					"id": 413130713,
					"content": "「杏仁豆腐」和「烤吃虎鱼」是吧…行，没问题，我这就让言笑去准备去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130714
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 413130714,
					"content": "正好客栈里备着材料，这么几道小菜，他应该很快就能做完。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130715
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 413130715,
					"content": "那你们先上去请那位下来吧，你们下来的时候，菜应该就已经做好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "淮安"
				}
			]
		},
		{
			"id": 4131308,
			"completionStepIds": [
