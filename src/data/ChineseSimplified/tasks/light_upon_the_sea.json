			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"魈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413130801,
					"content": "还有何事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130802
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413130802,
					"content": "想请你一起去海灯节。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130803
					]
				},
				{
					"id": 413130803,
					"content": "…我不喜欢人来人往的地方，你自己去游玩就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130804
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413130804,
					"content": "不用你去璃月港。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130805
					]
				},
				{
					"id": 413130805,
					"content": "…什么意思？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130806
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413130806,
					"content": "我把海灯节搬过来了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130807
					]
				},
				{
					"id": 413130807,
					"content": "「搬过来」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130808
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413130808,
					"content": "哎呀，就是在客栈下面摆了好多好吃的，好多霄灯，周围也没有多少人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130809
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413130809,
					"content": "还准备了「杏仁豆腐」和「烤吃虎鱼」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130810
					]
				},
				{
					"id": 413130810,
					"content": "我们快点下去吧，不然菜都要凉啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4131309,
			"completionStepIds": [
				4131314
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4131314",
							"2"
						],
						"stepId": 4131314,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"魈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413130901,
					"content": "怎么样，我们给你搬过来的海灯节看上去是不是很好吃？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130902
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413130902,
					"content": "这就是你们搬来的海灯节？人类的行为，非要如此怪异吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130903
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413130903,
					"content": "你们做这些事，意义何在？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130904,
						413130905
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413130904,
					"content": "为了让你参加一次海灯节。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130906
					]
				},
				{
					"id": 413130906,
					"content": "…是这样吗？人的心思真是难以揣测。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130907
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413130907,
					"content": "你们别光顾着说话了，快点吃东西吧，不然菜都要凉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130908
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413130908,
					"content": "嘿嘿，我先开始吃啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130909
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413130909,
					"content": "好啦，东西也吃好了，应该是去看「明霄灯」的时候啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130910
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413130910,
					"content": "魈也一起去吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130911
					]
				},
				{
					"id": 413130911,
					"content": "你们去吧，我对那些东西不感兴趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130912,
						413130913
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413130912,
					"content": "不然，你送送我们也行。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130914
					]
				},
				{
					"id": 413130914,
					"content": "对啊，就算你不想去看「明霄灯」，那…那你送我们过去总可以吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130915
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413130915,
					"content": "从这里去璃月港很远喔，野外也很危险的…对吧，很危险的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130916
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413130916,
					"content": "不用送我们进城啦，只…需要送到城外就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130917
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413130917,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130918
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413130918,
					"content": "…呼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130919
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413130919,
					"content": "那好，我送你们到<color=#00E1FFFF>城外</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130920
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413130920,
					"content": "没问题！我们这就出发吧 ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413130913,
					"content": "拜托了，护法夜叉大人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130914
					]
				},
				{
					"id": 413130905,
					"content": "海灯节是所有人的节日。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130906
					]
				}
			]
		},
		{
			"id": 4131311,
			"completionStepIds": [
				4131311
			],
			"beginWay": "TALK_BEGIN_MANUAL",
