				"points": []
			},
			"dialogs": [
				{
					"id": 413131101,
					"content": "到这里为止吧。我就不陪你们进城了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131102,
						413131104
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413131102,
					"content": "等一下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413131103
					]
				},
				{
					"id": 413131103,
					"content": "还有什么事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131105
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413131105,
					"content": "明明海灯节纪念的英雄里也包括你…为什么你却不想去看灯呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413131106,
					"content": "我…不喜欢人群。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131107
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413131107,
					"content": "无忧无虑的，安详的人群…我和他们不一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131108
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413131108,
					"content": "我和杀戮并存太久，已经习惯了那种苦行。和幸福的人一起，只会让我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131109
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413131109,
					"content": "…这个话题到此为止吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131110
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413131110,
					"content": "再会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131111
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413131111,
					"content": "真的不和我一起看灯吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413131112
					]
				},
				{
					"id": 413131112,
					"content": "你这么喜欢凑热闹？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131113
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413131113,
					"content": "你猜猜看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413131114
					]
				},
				{
					"id": 413131114,
					"content": "喂！这都是正当娱乐活动，不要说是凑热闹呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413131115,
					"content": "…正当的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131116
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413131116,
					"content": "罢了。去看你的灯吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131117
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413131117,
					"content": "但注意安全。遇到任何危险，就直呼我名吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131118
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413131118,
					"content": "你又不在城里，赶得过来吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413131119
					]
				},
				{
					"id": 413131119,
					"content": "随时随地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131120
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413131120,
					"content": "不论是你，还是璃月。所有的灯火，所有祈求平安的愿望，我都已经听到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "魈"
				},
				{
					"id": 413131104,
					"content": "（…算了，在这里就能看到。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413131105
					]
				}
			]
		},
