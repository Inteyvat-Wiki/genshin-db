					"content": "接下来我会努力变强，成为像前辈一样可靠的冒险家的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706811212
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706811212,
					"content": "嘿嘿，虽然相处时间不长，但是我们也很开心呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706811213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706811213,
					"content": "希望以后还能在别的地方相遇！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706811214,
						706811215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706811214,
					"content": "那我们有缘再见啦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706811216
					]
				},
				{
					"id": 706811215,
					"content": "希望你能如愿以偿！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706811216
					]
				},
				{
					"id": 706811216,
					"content": "嗯嗯！前辈也是，祝你们旅途顺利呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706811217
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706811217,
					"content": "格茜妮向你们挥手道别。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706811218
					]
				},
				{
					"id": 706811218,
					"content": "既然来到这里了，我们也在附近逛逛吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706811219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706811219,
					"content": "说不定会有什么奇遇呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
