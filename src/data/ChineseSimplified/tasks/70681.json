			},
			"dialogs": [
				{
					"id": 706810701,
					"content": "和前辈的珍贵合影，我会好好收藏的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810702
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706810702,
					"content": "啊，一放松下来就饿了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810703
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706810703,
					"content": "这么一说，派蒙的肚子也在咕咕叫了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810704,
						706810705
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706810704,
					"content": "找个地方休息吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810708
					]
				},
				{
					"id": 706810708,
					"content": "我们就在附近看看，找个能吃饭的地方吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810709
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706810709,
					"content": "这附近好像没有什么合适的餐馆呢…如果随便对付一下的话，就太委屈前辈了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810710
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706810710,
					"content": "说起来，前面那个建在大石头上的建筑，就是有名的<color=#00E1FFFF>望舒客栈</color>吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810711
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706810711,
					"content": "我以前听来蒙德做买卖的璃月商人说过，那里的菜品可好吃了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810712
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706810712,
					"content": "作为答谢，我请前辈去吃顿大餐吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810713
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706810713,
					"content": "好耶！去吃好吃的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706810705,
					"content": "派蒙，生火做饭！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810706
					]
				},
				{
					"id": 706810706,
					"content": "喂，使唤我也要有个限度呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810707
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706810707,
					"content": "而且我的厨艺水平你也是知道的嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810708
					],
					"speakerTitle": "派蒙"
				}
			]
		},
