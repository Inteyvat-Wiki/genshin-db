			"dialogs": [
				{
					"id": 706819905,
					"content": "格茜妮找掌柜打听这里的菜单，点了一些价格高昂的名菜…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 706810801,
					"content": "听说璃月菜讲究色香味俱全，看上去真的很不一样呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810802
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706810802,
					"content": "光是看着就已经垂涎欲滴了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810803
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706810803,
					"content": "你们细细地品味了这里的美食…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706810804
					]
				},
				{
					"id": 706810804,
					"content": "呜哇，这个也好吃，那个也好吃…实在是吃不下了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810805,
						706810806
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706810805,
					"content": "满足！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810807
					]
				},
				{
					"id": 706810806,
					"content": "旅途的疲惫消除了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810807
					]
				},
				{
					"id": 706810807,
					"content": "前辈一路辛苦了，要是没有你们，我肯定没法这么轻松地来到这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810808
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706810808,
					"content": "刚才听客栈的人说，再往前走就是<color=#00E1FFFF>璃月港</color>了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810809
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706810809,
					"content": "我打算在这里休息几天，跟其他旅客打听一下，怎么才能找到世外高人，然后再决定之后要去哪里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810810
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706810810,
					"content": "虽然跟前辈旅行真的很开心，但是不能继续耽误你们的时间了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810811
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706810811,
					"content": "接下来我会努力变强，成为像前辈一样可靠的冒险家的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810812
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706810812,
					"content": "嘿嘿，虽然相处时间不长，但是我们也很开心呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810813
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706810813,
					"content": "希望以后还能在别的地方相遇！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810814,
						706810815
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706810814,
					"content": "那我们有缘再见啦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810816
					]
				},
				{
					"id": 706810815,
					"content": "希望你能如愿以偿！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810816
					]
				},
				{
					"id": 706810816,
					"content": "嗯嗯！前辈也是，祝你们旅途顺利呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810817
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706810817,
					"content": "格茜妮向你们挥手道别。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706810818
					]
				},
				{
					"id": 706810818,
					"content": "既然来到这里了，我们也在附近逛逛吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810819
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706810819,
					"content": "说不定会有什么奇遇呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810820
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706810820,
					"content": "听格茜妮说，前面就是<color=#00E1FFFF>璃月港</color>，有空我们也去看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
