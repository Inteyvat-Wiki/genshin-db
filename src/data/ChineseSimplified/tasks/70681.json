						],
						"pointId": 9404
					}
				]
			},
			"dialogs": [
				{
					"id": 706810401,
					"content": "前辈！不好意思，可以在这里稍等一下吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810402
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706810402,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810403
					]
				},
				{
					"id": 706810403,
					"content": "难道忘带什么东西了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706810404,
					"content": "这倒没有。只是我看地图，再往前走就要离开蒙德了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810405
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706810405,
					"content": "下次回来也不知道是什么时候…老师看到我留的信，说不定会大发雷霆吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810406,
						706810407
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706810406,
					"content": "之前就听你提过老师…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810408
					]
				},
				{
					"id": 706810408,
					"content": "是的…他刚成为冒险家的时候，在野外遇到了丘丘暴徒，结果在周旋的时候，不小心被一斧子砸晕了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810409
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706810409,
					"content": "好在路过的骑士把他救了回去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810410
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706810410,
					"content": "他觉得很没面子，决定在城里将武艺锻炼到极致再外出冒险。结果这一锻炼就是十年…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810411
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706810411,
					"content": "老师总说基础是最重要的，可是我真的受不了每天砍木桩了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810412
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706810412,
					"content": "所以我就瞒着老师，一个人出门旅行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810413,
						706810414
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706810413,
					"content": "等变强了再回去吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810415
					]
				},
				{
					"id": 706810415,
					"content": "嗯！我也是这么想的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810416
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706810416,
					"content": "啊，我想到了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810417
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706810417,
					"content": "格茜妮翻出背包里的蒲公英籽，放在手掌上，对着它们说了些什么，然后让种子随风飘散…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706810418
					]
				},
				{
					"id": 706810418,
					"content": "在我们的习俗里，蒲公英能够承载愿望呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810419
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706810419,
					"content": "我刚才许了愿，希望这一路能顺利实现目标，也希望老师能理解我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810420
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706810420,
					"content": "风神一定听到你的愿望了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810421
					]
				},
				{
					"id": 706810421,
					"content": "嗯！那我们继续前进吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706810414,
					"content": "做出能让他认可的成就吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810415
					]
				},
				{
					"id": 706810407,
					"content": "他也是冒险家吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810408
					]
				}
			]
		},
