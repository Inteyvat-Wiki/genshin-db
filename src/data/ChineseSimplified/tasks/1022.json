			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 10220201,
					"content": "这里有好多符咒，还有好几叠空白的纸，会是做什么用的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220202,
						10220203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220202,
					"content": "看起来是在抄写符咒上的图案。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220204
					]
				},
				{
					"id": 10220204,
					"content": "这上面的图案，似乎在哪见过…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220205,
					"content": "我想起来了，「公子」给你的那张「百无禁忌箓」，确实也长这样呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220206,
					"content": "嗯…这种和仙人有关的信物，为什么会落到「公子」手里，也确实相当可疑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220207,
					"content": "而且，不止是「信物」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220208
					]
				},
				{
					"id": 10220208,
					"content": "对哦，留云借风真君说过，岩王爷当年造「百无禁忌箓」的时候，不是当作信物来用的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220209,
					"content": "这种符咒最初的用途，是在魔神战争当中，用来发挥神力…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220210,
					"content": "愚人众这样抄写「百无禁忌箓」，是想尝试用什么方法来引导出类似真品的效果吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220211,
					"content": "在战争中发挥神力的效果…唔，听起来很凶险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220212,
						10220213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220212,
					"content": "看来愚人众还有大计划。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220214
					]
				},
				{
					"id": 10220214,
					"content": "真复杂…总之，以后要对「公子」更多防备一些了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220215,
					"content": "好了，在这里折腾了这么久，和钟离约好再见的时间也差不多快到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220216,
					"content": "「送仙典仪筹办之旅」的最后一站…记得是在荻花洲吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220217,
					"content": "快走吧，别迟到啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220213,
					"content": "给我的那张，只是大计划的副产物吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220214
					]
				},
				{
					"id": 10220203,
					"content": "可能是想复制真品。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220204
					]
				}
			]
		},
		{
			"id": 102203,
			"completionStepIds": [
				102203
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102203",
							"2"
						],
						"stepId": 102203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"钟离"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10220301,
					"content": "你们很准时嘛，我也刚到不久。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220302
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10220302,
					"content": "群玉阁好玩吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220303
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10220303,
					"content": "超——大！超华丽，超贵，是我见过最贵的建筑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220304,
					"content": "确实。群玉阁若称第二，璃月便无人敢称第一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220305
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10220305,
					"content": "你们应该见过凝光了。聊得如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220306
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10220306,
					"content": "她好有钱，好慷慨，是很亲切的人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220307,
					"content": "但「亲切」也是商人的武器。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220308
					]
				},
				{
					"id": 10220308,
					"content": "#嗯…{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}对凝光的看法和我不一样。{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}觉得，还是那位说话过于直白的「玉衡星」更加可信一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220309,
					"content": "哦？你们还遇到刻晴了？她对你们说了什么吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220310
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10220310,
					"content": "她说，「『仙人』的时代已经过去了，如果连『璃月七星』都不敢正视这一点，那璃月的未来要怎么办啊？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220311,
					"content": "哈哈哈…不敬仙神。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220312
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10220312,
					"content": "的确，比起什么话都敢说的刻晴，同为七星，还是凝光更像一位典型的商人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220313
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10220313,
					"content": "虽然亲切，但你无法确定她是百分之百的真诚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220314,
						10220315
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10220314,
					"content": "凝光是个有谋略的人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220316
					]
				},
				{
					"id": 10220316,
					"content": "嗯，她能坐上今天的位置，全靠自己。这样的人物，必定有其超凡之处。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220317
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10220317,
					"content": "我听说，不断扩建的「群玉阁」正是她志向的体现，是她人生中第二重要的东西。哪怕放弃天权之位，她也不会放弃群玉阁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220318
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10220318,
					"content": "群玉阁是第二位？那排第一位的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220319,
					"content": "当然是摩拉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220320,
						10220321
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10220320,
					"content": "很有道理。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220322
					]
				},
				{
					"id": 10220322,
					"content": "对了，她找我们说的最多的事，是关于「愚人众」的。她说帝君遇害以后，愚人众一直在璃月搅混水，可坏了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220323,
					"content": "「愚人众」历来如此，我一点都不觉得意外。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220324
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10220324,
					"content": "而且他们正在仿制百无禁忌箓。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220325
					]
				},
				{
					"id": 10220325,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220326
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10220326,
					"content": "不论「愚人众」在图谋什么，总之，与他们打交道时，凡事都多留个心眼吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220327
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10220327,
					"content": "说起来，荻花洲也有送仙典仪要用的东西吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220328
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220328,
					"content": "对，我们今天要找的是野生的琉璃百合。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220329
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10220329,
					"content": "琉璃百合？为什么要来这里找啊？明明玉京台的园林里就有很多…我听说轻策庄也有一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220330
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220330,
					"content": "对了，我记得我们遇到萍姥姥的时候，她就在看花。不如直接去问萍姥姥要吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220331
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220331,
					"content": "不…那都是人工培育的，并不合用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220332
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10220332,
					"content": "琉璃百合曾经大量生长在荻花洲，是一种欢欣的花，会聆听人们的歌声。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220333
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10220333,
					"content": "魔神战争前，荻花洲还是片陆地。是战争引来山崩，才让这里被大水淹没，变为湿地，令琉璃百合几乎绝种。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220334
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10220334,
					"content": "现在，城里还保留了一些人工培育的品类。但只有极少数人知道，其实野生琉璃百合还没完全灭绝…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220335
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10220335,
					"content": "这种琉璃百合香气浓郁，碾成粉末以后放在永生香的香炉里，才是完整的「送仙」传统。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220336
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10220336,
					"content": "不过，想采这种花，还需要你的帮助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220337,
						10220339
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10220337,
					"content": "需要我劳动吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220338
					]
				},
				{
					"id": 10220338,
					"content": "不，我要你对那些花唱歌，来提升它的香气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220341
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10220341,
					"content": "#呃…{NICKNAME}，你唱歌的水平怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220342,
						10220343
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220342,
					"content": "略通一二。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220344
					]
				},
				{
					"id": 10220344,
					"content": "是吗？有点不信…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220345
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220345,
					"content": "效果如何，一试便知。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220346
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10220343,
					"content": "我超会的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220344
					]
				},
				{
					"id": 10220339,
					"content": "需要我…唱歌吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220340
					]
				},
				{
					"id": 10220340,
					"content": "没错，你的歌声一定能让花的香味提升到极致。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220341
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10220321,
					"content": "我不意外。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220322
					]
				},
				{
					"id": 10220315,
					"content": "凝光是个有志向的人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220316
					]
				}
			]
		},
		{
			"id": 102204,
			"completionStepIds": [
				102204
