			"dialogs": [
				{
					"id": 10220401,
					"content": "是时候一展歌喉了，加油！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220402,
					"content": "咳咳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220403
					]
				},
				{
					"id": 10220403,
					"content": "♪…♪♪♪♪…♪♪♪♪…♪♪",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 102206,
			"completionStepIds": [
				102206
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102206",
							"2"
						],
						"stepId": 102206,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10220601,
					"content": "它们根本不是琉璃百合，琉璃百合怎么会打人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220602,
					"content": "超乎想象的敌人…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220603
					]
				},
				{
					"id": 10220603,
					"content": "这是一种叫做「骗骗花」的魔物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220604
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10220604,
					"content": "嗯？这些花瓣…？有点意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220605
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10220605,
					"content": "用于伪装的琉璃百合，与「骗骗花」一起埋了太久，反倒成了极好的药材。因祸得福…把这些花瓣收起来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220606
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10220606,
					"content": "还有这种好事？那这些花瓣可以用在送仙典仪上吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220607
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220607,
					"content": "很遗憾，不能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220608
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10220608,
					"content": "啊，怎么这样——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220609
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220609,
					"content": "请问…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220610
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220610,
					"content": "你们是在找琉璃百合吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220611
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220611,
					"content": "啊！是你！呃、呃…糟糕，想不起名字…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220612,
						10220614
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220612,
					"content": "你好啊，甘雨。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220613
					]
				},
				{
					"id": 10220613,
					"content": "你好，旅行者，没想到你还记得我的名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220617
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220617,
					"content": "说起来，二位的「群玉阁」之行，感受如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220618
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220618,
					"content": "因为你没告诉我们怎么上去，所以我们费了好大力气才找到路呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220619
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220619,
					"content": "哎哎哎？我、我没说吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220620
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220620,
					"content": "我们靠自己打听来的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220621,
						10220622
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220621,
					"content": "因为并不是秘密，所以没提吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220623
					]
				},
				{
					"id": 10220623,
					"content": "是…是的呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220624
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220624,
					"content": "（完了，我竟然忘记说了…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220625
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220625,
					"content": "嗯？感觉甘雨脸色不太对劲的样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220626
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220626,
					"content": "而且比起第一次见面的时候，连气质也不太一样…好像没有当时的那种严肃感了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220627
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220627,
					"content": "啊…因为那时是「天权星使者」的身份，但现在只是在看花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220628
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220628,
					"content": "看花？为什么不在城里看，要跑到这种地方来呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220629
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220629,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220630
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220630,
					"content": "玉京台是帝君逝去之地，在那里看花，是很令人寂寞的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220631
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220631,
					"content": "最近这几天，我在玉京台附近办公时，都会把窗户关上，以免望见窗外的风景…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220632
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220632,
					"content": "唔…对不起，我不该提起这个话题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220633
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220633,
					"content": "不…是我自己没能整理好自己的心情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220634
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220634,
					"content": "两千年前魔神战争结束，最初的七神曾在璃月相聚，与帝君对饮…而今神位更迭，酒会上的七神已逝五神。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220635
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220635,
					"content": "也就是说…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220636
					]
				},
				{
					"id": 10220636,
					"content": "是的，既然帝君魂归高天，那最初的七神，就只剩蒙德的巴巴托斯大人尚在尘世了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220666
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220666,
					"content": "其余五位，包括稻妻的那位雷电将军，都已不是两千年前的故人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220637
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220637,
					"content": "现今的「尘世七执政」，须弥的草之神最年轻，只有五百岁。而岩王帝君在世最久，已有六千余年。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220638
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220638,
					"content": "所以，三千七百年历史的璃月，从建立之初就已是帝君统治，从未经历过与神灵的「辞行」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220639
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220639,
					"content": "那么，你对这场「辞行」，有何看法？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220640
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10220640,
					"content": "哎？突然这么问，我也…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220641
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220641,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220642
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220642,
					"content": "作为「人」，我至今也无法想象，失去了帝君的璃月会变成什么样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220643
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220643,
					"content": "但作为「仙」…我想，我迟早还是会接受事实的。既然帝君逝去，那么仙神与璃月立下「契约」的时代，在事实上就已走向终结了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220644
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220644,
					"content": "嗯？你说…作为「仙」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220645
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220645,
					"content": "我…我是人类与麒麟的混血，有一半仙人的血统，在魔神战争时也为帝君、为璃月出过一份力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220646
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220646,
					"content": "战争终结以后，我与帝君签下「契约」，开始担任历代七星的秘书，就这样一直到了今天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220647,
						10220648
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220647,
					"content": "怪不得你脑袋上有角！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220649
					]
				},
				{
					"id": 10220649,
					"content": "咳…咳咳。还是聊些其他的吧。你们刚才说，是来找琉璃百合…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220650
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220650,
					"content": "我也知道野生琉璃百合所藏的位置，刚好摘了一株。不嫌弃的话，请收下它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220651
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220651,
					"content": "那就恭敬不如从命了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220652
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10220652,
					"content": "欸？那你摘之前唱过歌了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220653
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220653,
					"content": "是的，这种传统我自然也很清楚。请放心，我唱的是璃月本地的民谣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220654
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220654,
					"content": "哇，你也很内行呢。谢谢你，甘雨！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220655
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220655,
					"content": "不，是我该感谢你们。若不是这次偶遇，我也没想到自己能为「辞行久远之躯」的仪式，送上一份心意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220656
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220656,
					"content": "我该回去工作了，祝你们一切顺利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220657
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220657,
					"content": "这样一来，「送仙典仪」所需的各种筹备，基本都完成了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220658
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10220658,
					"content": "摘花这件事，在各种意义上都很方便，做起来没有困难，所以才把它留在了最后。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220659
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10220659,
					"content": "钟离的性格，是适合开荒的类型。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220660
					]
				},
				{
					"id": 10220660,
					"content": "嗯，他要是在璃月做生意的话，应该会很享受创业的生活吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220661
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220661,
					"content": "哈哈…我也确实有过那种日子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220662
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10220662,
					"content": "创业、开荒…万事开头难，投注的情感也多。等到一切运转如常，久而久之，情感就会逐渐「磨损」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220663
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10220663,
					"content": "「磨损」得多了，就要重新审视自己。若不小心处理，灵魂就会留下裂纹，无法挽回。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220664
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10220664,
					"content": "看吧！这种语气，一听就是过来人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220665
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220665,
					"content": "好了，既然事情都搞定了，我们也该回璃月港啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220648,
					"content": "怪不得你会忘记说该说的事！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220649
					]
				},
				{
					"id": 10220622,
					"content": "我们不该走冤枉路，问一下就好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220623
					]
				},
				{
					"id": 10220614,
					"content": "你好啊，王小美。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220615
					]
				},
				{
					"id": 10220615,
					"content": "王小美？那、那是谁啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220616
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220616,
					"content": "甘雨和王小美，根本一个字都没记对吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220617
					],
					"speakerTitle": "甘雨"
				}
			]
		},
		{
			"id": 102208,
			"completionStepIds": [
				102208
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102208",
							"2"
						],
						"stepId": 102208,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"菲利克斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10220801,
					"content": "喔，是「往生堂」的客卿，钟离先生吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220802
					],
					"speakerTitle": "菲利克斯"
				},
				{
					"id": 10220802,
					"content": "千岩军正在对我们严加监视，现在是非常时期，你可别轻举妄动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220803
					],
					"speakerTitle": "菲利克斯"
				},
				{
					"id": 10220803,
					"content": "非常时期？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220804
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10220804,
					"content": "「绝云间」的仙人终于动身了。他们此来，恐怕来意不善。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220805
					],
					"speakerTitle": "菲利克斯"
				},
				{
					"id": 10220805,
					"content": "是为兴师问罪么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220806
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10220806,
					"content": "多半是这样。听说七星中的几位，早早地带人前去迎接…嘿，说是迎接，不如说想要把仙人阻拦在城外吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220807
					],
					"speakerTitle": "菲利克斯"
				},
				{
					"id": 10220807,
					"content": "但双方态度都很强硬，一时陷入了僵局。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220808
					],
					"speakerTitle": "菲利克斯"
				},
				{
					"id": 10220808,
					"content": "…事情走到这一步，也是必然。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220809
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10220809,
					"content": "仙人不认七星，只认与岩神的「契约」。如果他们决定强攻，这璃月港恐怕是挡不住的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220810
					],
					"speakerTitle": "菲利克斯"
				},
				{
					"id": 10220810,
					"content": "但「璃月七星」也不是坐以待毙的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220811
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10220811,
					"content": "哼，谁不知道他们态度强硬？但就因为这样，人和仙的矛盾才会一触即发！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220812
					],
					"speakerTitle": "菲利克斯"
				},
				{
					"id": 10220812,
					"content": "然后呢？怎么「愚人众」反倒成了众矢之的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220813
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10220813,
					"content": "呼…还不是因为那个凝光…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220814
					],
					"speakerTitle": "菲利克斯"
				},
				{
					"id": 10220814,
					"content": "说什么「在这山雨欲来的时刻，要千岩军彻底控制愚人众的动向」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220815
					],
					"speakerTitle": "菲利克斯"
				},
				{
					"id": 10220815,
					"content": "切！现在才想起来要限制我们的行动？七星也不过如此！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220816
					],
					"speakerTitle": "菲利克斯"
				},
				{
					"id": 10220816,
					"content": "总之，钟离先生，你是「公子」大人的合作者，你的态度也有一半是我们的态度，可别让人抓到把柄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220817
					],
					"speakerTitle": "菲利克斯"
				},
				{
					"id": 10220817,
					"content": "看来，璃月港里的各种矛盾，都已经彻底达到极限了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220818,
						10220819
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220818,
					"content": "我们能做些什么吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220820
					]
				},
				{
					"id": 10220820,
					"content": "你的意思是，想要凭特殊的中立身份出面调解？还是想要靠你个人的武力改变某些平衡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220821
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10220821,
					"content": "这两条路，恐怕都不那么容易吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220822
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10220822,
					"content": "啊，对了！钟离先生。我听说你们「往生堂」，好像也被卷进了冲突里，正在与找上门来的官军对峙呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220823
					],
					"speakerTitle": "菲利克斯"
				},
				{
					"id": 10220823,
					"content": "…这可不妙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220824
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10220824,
					"content": "我得先走一步，去往生堂看看了，希望胡堂主暂时应付得来…可别闹出什么大乱子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220825
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10220825,
					"content": "旅者，你也再思考一下吧。在我看来，想要阻止一触即发的爆炸，不如先想想「引信」在哪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220827
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10220827,
					"content": "呼…当「愚人众」的「道上朋友」，看来既有好处，也有麻烦呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220828
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220828,
					"content": "所以，刚才钟离说的「引信」，是指什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220829,
						10220830,
						10220831
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220829,
					"content": "「公子」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220832
					]
				},
				{
					"id": 10220832,
					"content": "原来如此！我…我好像也明白了。嗯，要说谁最盼着这种满城大乱的情况，我的第一反应也是他了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220833
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220833,
					"content": "这家伙，一定是趁着所有人都没空管他的时候，去做什么坏事了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220834
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220834,
					"content": "可是，现在该到哪里找他？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220835
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220835,
					"content": "在所有混乱都变得…特别混乱的时候，他会去哪里呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220836,
						10220837
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220836,
					"content": "跟我来。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 10220837,
					"content": "他会去的地方，只有一个。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 10220830,
					"content": "那个橙色头发的男人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220832
					]
				},
				{
					"id": 10220831,
					"content": "一路上给我们买单的冤大头。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220832
					]
				},
				{
					"id": 10220819,
					"content": "我不想袖手旁观。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220820
					]
				}
			]
		}
	]
}