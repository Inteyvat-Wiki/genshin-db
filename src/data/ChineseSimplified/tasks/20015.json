			"dialogs": [
				{
					"id": 200150301,
					"content": "Biat ye, ye pupu dada mosi! Plama ye upa dada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150302
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 200150302,
					"content": "Dala beru yo?! Kundala muhe, kucha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150303
					],
					"speakerTitle": "丘丘人"
				},
				{
					"id": 200150303,
					"content": "Kundala gusha! Hahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150304
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 200150304,
					"content": "Biat ye, plata ye pupu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150305
					],
					"speakerTitle": "丘丘人"
				},
				{
					"id": 200150305,
					"content": "Movo unta nye kucha, mi dada tiga mitono!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150306
					],
					"speakerTitle": "丘丘人"
				},
				{
					"id": 200150306,
					"content": "看来他听懂我说的话了，正在准备拿礼物给我们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150307
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 200150307,
					"content": "是，是武器！呜呜呜呜呜，旅行者！救救我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾拉·马斯克"
				}
			]
