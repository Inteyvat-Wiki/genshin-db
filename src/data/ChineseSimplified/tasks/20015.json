				"points": []
			},
			"dialogs": [
				{
					"id": 200150201,
					"content": "这里刚好有个丘丘人醒着。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150202
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 200150202,
					"content": "就这位了，我们快点过去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150203
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 200150203,
					"content": "小心点，过去的时候别吵醒其他丘丘人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150204
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 200150204,
					"content": "不然他们肯定会误会，以为我们是准备来攻击他们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150205
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 200150205,
					"content": "要是这样，肯定不能顺利地对话了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾拉·马斯克"
				}
			]
		},
