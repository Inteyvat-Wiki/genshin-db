				"points": []
			},
			"dialogs": [
				{
					"id": 200150101,
					"content": "旅行者，这里，过来这里！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150102
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 200150102,
					"content": "别惊动了那些丘丘人，你怎么总是直挺挺地往营地里面冲呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150103
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 200150103,
					"content": "算了，不管这些了，我一直在研究丘丘人的语言，但是比起记录，我更想要研究口语。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150104
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 200150104,
					"content": "好不容易在这里遇见了一个完整的丘丘人营地，我可不能放过这个机会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150105
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 200150105,
					"content": "所以，旅行者，你能和我一起去这营地里面，找个丘丘人来练习口语吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾拉·马斯克"
				}
			]
		},
		{
			"id": 2001502,
			"completionStepIds": [
				2001503
