			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730730101,
					"content": "哎呀，应该就在这附近的某个山洞里，难不成是我记错了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730102
					],
					"speakerTitle": "罗因贾"
				},
				{
					"id": 730730102,
					"content": "要不去问问维摩庄的村民呢？如果这里有山洞的话，他们应该会知道吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730730103,
					"content": "村民…还是算了吧，这可是秘密基地，他们怎么会知道。如果我没记错的话，洞口应该就在这些藤蔓的后面，我们分头找吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730104
					],
					"speakerTitle": "罗因贾"
				},
				{
					"id": 730730104,
					"content": "我和这位大学者去那边看看，这里就交给二位了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730105
					],
					"speakerTitle": "罗因贾"
				},
				{
					"id": 730730105,
					"content": "那我们就从这边的藤蔓开始调查吧。不过这里的藤蔓也太多了一点吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730730106,
					"content": "这些不是藤蔓，是「桓摩达」哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730107
					],
					"speakerTitle": "兰利遮"
				},
				{
					"id": 730730107,
					"content": "欸？兰利遮知道些什么吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730730108,
					"content": "嗯，这些是桓摩达，桓摩达是兰那罗做的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730109
					],
					"speakerTitle": "兰利遮"
				},
				{
					"id": 730730109,
					"content": "为什么兰那罗要做这个？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730730110
					]
				},
				{
					"id": 730730110,
					"content": "不想让那菈进去的地方，兰那罗就会做桓摩达，有了桓摩达，只有兰那罗才能进去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730111
					],
					"speakerTitle": "兰利遮"
				},
				{
					"id": 730730111,
					"content": "唔，虽然兰那罗是很小只啦，不过这里看上去已经完全被堵上了，就算是兰那罗也进不去吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730730112,
					"content": "那菈进不去，但是兰那罗可以唱歌，桓摩达听见歌声，就会转起来。桓摩达转起来就能进去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730113,
						730730114
					],
					"speakerTitle": "兰利遮"
				},
				{
					"id": 730730113,
					"content": "转起来？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730730115
					]
				},
				{
					"id": 730730115,
					"content": "#嗯！那菈{NICKNAME}是森林的朋友。那菈{NICKNAME}唱歌，桓摩达也能听见，兰利遮教你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰利遮"
				},
				{
					"id": 730730114,
					"content": "就像球一样？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730730115
					]
				}
			]
		},
