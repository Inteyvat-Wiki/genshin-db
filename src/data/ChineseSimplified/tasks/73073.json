			},
			"dialogs": [
				{
					"id": 730730501,
					"content": "哇！这个地方真的好大，小时候的罗因贾爷爷好厉害！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730730502,
					"content": "怎么样，不错吧！不过比起我印象中小了许多呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730503,
						730730505
					],
					"speakerTitle": "罗因贾"
				},
				{
					"id": 730730503,
					"content": "因为罗因贾爷爷长大了吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730730504
					]
				},
				{
					"id": 730730504,
					"content": "哈哈，何止是长大了，都是老头子啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730507
					],
					"speakerTitle": "罗因贾"
				},
				{
					"id": 730730507,
					"content": "不过这里真的一点都没变，就像是时间静止了一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730508
					],
					"speakerTitle": "罗因贾"
				},
				{
					"id": 730730508,
					"content": "连空气都还是那个时候的味道，光是闻到这个味道我就想起了好多好多事情…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730509
					],
					"speakerTitle": "罗因贾"
				},
				{
					"id": 730730509,
					"content": "事不宜迟，你想起「阿麦塔机关」在哪了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730510
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730730510,
					"content": "别着急嘛，年轻人。我们先四处看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730511
					],
					"speakerTitle": "罗因贾"
				},
				{
					"id": 730730511,
					"content": "刚才进来的时候就很在意了，这个巨大的机器零件是怎么回事呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730512
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730730512,
					"content": "喔，兰利遮知道，这个是从大铁山那里搬过来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730513
					],
					"speakerTitle": "兰利遮"
				},
				{
					"id": 730730513,
					"content": "大铁山…就是说是从之前那个遗迹巨像那里拆下来的咯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730514
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730730514,
					"content": "你也发现了吗？根据上面的纹案判断，虽然不知道为什么会被摆成这个样子，不过这些零件应该是属于那架遗迹巨像的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730515
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730730515,
					"content": "说不定你真的很有搞学术的天赋欸。等这个项目告一段落，要不要我帮忙推荐你去教令院学习呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730516
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730730516,
					"content": "在那里你肯定能交到很多朋友的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730517
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730730517,
					"content": "虽然不是这么回事啦…不过还是谢谢你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730518
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730730518,
					"content": "不过这么大的零件怎么看都不是小孩子能搬动的，到底是什么人把它堆成这个样子的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730519
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730730519,
					"content": "说不定是什么森林里的精灵干的呢…我开玩笑的，我也记不清了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730520
					],
					"speakerTitle": "罗因贾"
				},
				{
					"id": 730730520,
					"content": "知道了，是兰利遮搬的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730521
					],
					"speakerTitle": "兰利遮"
				},
				{
					"id": 730730521,
					"content": "这么大兰利遮怎么搬得动啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730522
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730730522,
					"content": "兰利遮，厉害，所以搬得动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730523
					],
					"speakerTitle": "兰利遮"
				},
				{
					"id": 730730523,
					"content": "哈哈，我记得那个时候我们两群孩子还围着这个大家伙玩打仗游戏呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730524,
						730730526
					],
					"speakerTitle": "罗因贾"
				},
				{
					"id": 730730524,
					"content": "这里以前有过这么多孩子吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730730525
					]
				},
				{
					"id": 730730525,
					"content": "最开始的时候是有过啦…当时我们这群孩子的据点应该就在前面…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730528
					],
					"speakerTitle": "罗因贾"
				},
				{
					"id": 730730528,
					"content": "啊，想起来了，我好像埋了什么东西在那边，我带你们过去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "罗因贾"
				},
				{
					"id": 730730526,
					"content": "所以最后谁赢了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730730527
					]
				},
				{
					"id": 730730527,
					"content": "当然是我啦，我可没输过！当时我们这群孩子的据点应该就在前面…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730528
					],
					"speakerTitle": "罗因贾"
				},
				{
					"id": 730730505,
					"content": "因为派蒙是小孩子吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730730506
					]
				},
				{
					"id": 730730506,
					"content": "那个时候我也是小孩子啊，现在都是老头子啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730507
					],
					"speakerTitle": "罗因贾"
				}
			]
		},
		{
			"id": 7307306,
			"completionStepIds": [
				7307305
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
