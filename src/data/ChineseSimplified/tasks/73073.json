			"dialogs": [
				{
					"id": 730730401,
					"content": "哇！真的像球一样转起来了欸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730730402,
					"content": "神秘的洞口出现了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730730403
					]
				},
				{
					"id": 730730403,
					"content": "这个洞口，兰利遮记得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730404
					],
					"speakerTitle": "兰利遮"
				},
				{
					"id": 730730404,
					"content": "欸？这个桓摩达该不会是兰利遮做的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730730405,
					"content": "兰利遮也不记得了，但是兰利遮知道，要保护小那菈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730406
					],
					"speakerTitle": "兰利遮"
				},
				{
					"id": 730730406,
					"content": "虽然不知道为什么这里会被兰那罗封印起来，不过这个应该就是通往秘密基地的入口了吧，去把他们两个也叫过来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730730407,
					"content": "哈哈，果然我没记错就在这边。从这里进去就是我们当初的秘密基地了，你们是怎么找到的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730408
					],
					"speakerTitle": "罗因贾"
				},
				{
					"id": 730730408,
					"content": "兰利遮，厉害。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730409
					],
					"speakerTitle": "兰利遮"
				},
				{
					"id": 730730409,
					"content": "既然找到了洞口我们就赶紧进去吧，接下来只要找到「阿麦塔机关」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730410
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730730410,
					"content": "里面还蛮大的哦，你们可不要被吓到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "罗因贾"
				}
			]
		},
		{
