			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730730601,
					"content": "让我来看看挖出了什么宝物…咦，是一本小册子呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730730602,
					"content": "哦哦，这个可是好东西呢，是我们当初的「冒险手册」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730603
					],
					"speakerTitle": "罗因贾"
				},
				{
					"id": 730730603,
					"content": "「冒险手册」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730730604,
					"content": "你们不知道冒险手册这种东西吗？看你们的样子，又是来找宝物什么的，我还以为你们是从外国来的冒险家呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730605,
						730730606
					],
					"speakerTitle": "罗因贾"
				},
				{
					"id": 730730605,
					"content": "我确实获得过冒险之证。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730730607
					]
				},
				{
					"id": 730730607,
					"content": "对吧，很多冒险家都会写的。像是冒险日志什么的，把自己的冒险经历、冒险计划甚至宝藏的线索记录下来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730608
					],
					"speakerTitle": "罗因贾"
				},
				{
					"id": 730730608,
					"content": "就像你们知道的，我的祖父是伟大的冒险家，虽然他的冒险日志我是看不懂啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730609
					],
					"speakerTitle": "罗因贾"
				},
				{
					"id": 730730609,
					"content": "不过因为从小就憧憬着成为冒险家，所以我也装模作样地搞了这本冒险手册呢，可以说是我梦想的起点一样的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730610
					],
					"speakerTitle": "罗因贾"
				},
				{
					"id": 730730610,
					"content": "虽然知道这个东西对你很重要啦，不过好像对我们要找的机关没有什么帮助哪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730611
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730730611,
					"content": "话可不能这么说，我不是说过我还计划过去找你们说的那个阿麦塔机关吗？不管最后怎么样，都记录在这个冒险手册里了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730612
					],
					"speakerTitle": "罗因贾"
				},
				{
					"id": 730730612,
					"content": "让我看看…我记得当初我们两个人…咦？这里面为什么画的会是三个人，我的记性已经这么差了吗？还是我的眼睛花了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730613
					],
					"speakerTitle": "罗因贾"
				},
				{
					"id": 730730613,
					"content": "需要我把眼镜借给你吗？我这可是教令院配发的最新款式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730614
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730730614,
					"content": "大学者你真的…算了，先让我仔细看看…现在我非常确定，阿麦塔机关应该就被我埋在这里了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730615
					],
					"speakerTitle": "罗因贾"
				},
				{
					"id": 730730615,
					"content": "太好了，接下来只要在这个山洞里搜寻就好了，虽然这里还…挺大的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730616
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730730616,
					"content": "用不着这么麻烦，这里面记录了机关埋藏的位置，应该就在…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "罗因贾"
				},
				{
					"id": 730730606,
					"content": "之前也见过这种冒险日志…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730730607
					]
				}
			]
		},
		{
			"id": 7307307,
