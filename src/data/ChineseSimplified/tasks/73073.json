			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"罗因贾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730731401,
					"content": "罗因贾爷爷，我们回来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730731402,
					"content": "哦哦，你们终于回来了，看你们的样子，应该见过那个老头子，也找到你们想要的机关碎片了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731403
					],
					"speakerTitle": "罗因贾"
				},
				{
					"id": 730731403,
					"content": "别的先不提，虽然我也不是很关心啦，不过那个老头子还是像以前一样无趣吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731404,
						730731405
					],
					"speakerTitle": "罗因贾"
				},
				{
					"id": 730731404,
					"content": "你好关心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730731406
					]
				},
				{
					"id": 730731406,
					"content": "嗯？是那个老家伙跟你们说了些什么吗，你们可别相信他的话，如果不是他在出海冒险的前一天晚上偷偷溜回了这个村子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731407
					],
					"speakerTitle": "罗因贾"
				},
				{
					"id": 730731407,
					"content": "我们现在说不定已经是历史上最伟大的冒险家之一了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731408,
						730731409
					],
					"speakerTitle": "罗因贾"
				},
				{
					"id": 730731408,
					"content": "感觉不太可能…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730731410
					]
				},
				{
					"id": 730731410,
					"content": "嘛，开玩笑的，其实还是当古董商人适合我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731411
					],
					"speakerTitle": "罗因贾"
				},
				{
					"id": 730731411,
					"content": "就算是像祖父那样伟大的冒险家，最后也在某次冒险中不知所踪了，更别说是我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731412
					],
					"speakerTitle": "罗因贾"
				},
				{
					"id": 730731412,
					"content": "我的话，只要还有冒险故事可听就行了。那么你们收集到了什么故事呢，按照约定，你们手上的机关碎片要用故事来换哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731413,
						730731416
					],
					"speakerTitle": "罗因贾"
				},
				{
					"id": 730731413,
					"content": "关于被水淹没的机关和死域…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730731414
					]
				},
				{
					"id": 730731414,
					"content": "和罗因贾爷爷讲述了寻找机关碎片的冒险故事。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730731415
					]
				},
				{
					"id": 730731415,
					"content": "哈哈，真是了不起的冒险啊，你们果然是不得了的冒险家。要是那个时候的我也能完成这样的冒险就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731419
					],
					"speakerTitle": "罗因贾"
				},
				{
					"id": 730731419,
					"content": "好了，算是给我带来了不错的故事呢。那么按照约定，这些机关碎片就交给你们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731420
					],
					"speakerTitle": "罗因贾"
				},
				{
					"id": 730731420,
					"content": "快去拿给那个大学者吧，在你们快乐冒险的时候，他都快急死了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731421
					],
					"speakerTitle": "罗因贾"
				},
				{
					"id": 730731421,
					"content": "那么，我也该回到我的铺子里去了，要是错过了什么大生意可就不好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731422
					],
					"speakerTitle": "罗因贾"
				},
				{
					"id": 730731422,
					"content": "等一下，我们还有件事情要做吧。那个花花…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731423
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730731423,
					"content": "这是阿玛兹亚爷爷交给你的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730731424
					]
				},
				{
					"id": 730731424,
					"content": "这是…一朵花？那个老头子一把年纪还搞这种吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731425
					],
					"speakerTitle": "罗因贾"
				},
				{
					"id": 730731425,
					"content": "不过等一下…这朵花，我好像有印象…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731426
					],
					"speakerTitle": "罗因贾"
				},
				{
					"id": 730731426,
					"content": "你终于想起什么来了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731427
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730731427,
					"content": "哈哈，好像想起来了什么，又好像什么都没想起来呢。不过算了，过去的事情，就留在过去好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731428
					],
					"speakerTitle": "罗因贾"
				},
				{
					"id": 730731428,
					"content": "不过我能感觉到，这朵花是不属于我的，请你们把它交到属于它的地方吧。看你们的样子肯定能看到什么我看不到的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731429
					],
					"speakerTitle": "罗因贾"
				},
				{
					"id": 730731429,
					"content": "不过阿玛兹亚那个家伙，好像比以前有趣一点了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731430
					],
					"speakerTitle": "罗因贾"
				},
				{
					"id": 730731430,
					"content": "那么，就此别过，如果有机会的话，请二位还要光临小店呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731431
					],
					"speakerTitle": "罗因贾"
				},
				{
					"id": 730731431,
					"content": "属于它的地方…兰利遮，这朵花花就交给你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731432
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730731432,
					"content": "花花，好珍贵，为什么要给兰利遮这个呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731433
					],
					"speakerTitle": "兰利遮"
				},
				{
					"id": 730731433,
					"content": "因为这个本来就是属于兰利遮的花花哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731434
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730731434,
					"content": "兰利遮不记得，不过花花，兰利遮喜欢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731435
					],
					"speakerTitle": "兰利遮"
				},
				{
					"id": 730731435,
					"content": "兰利遮珍惜花花，兰利遮要把花花种到园圃里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731436
					],
					"speakerTitle": "兰利遮"
				},
				{
					"id": 730731436,
					"content": "好哦，那我们就在大铁山的下面再见吧，等我们打开了那个大机器人后，再一起去对付坏东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731437
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730731437,
					"content": "嗯！兰利遮要和你们一起对付坏东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731438
					],
					"speakerTitle": "兰利遮"
				},
				{
					"id": 730731438,
					"content": "约定好了哦，兰利遮！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730731416,
					"content": "关于精灵和孩子的故事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730731417
					]
				},
				{
					"id": 730731417,
					"content": "和罗因贾爷爷讲述了兰那罗和孩子们一起冒险的故事。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730731418
					]
				},
				{
					"id": 730731418,
					"content": "森林里的精灵吗，虽然类似的传说我也听说过不少，不过你们说的这个格外有趣啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731419
					],
					"speakerTitle": "罗因贾"
				},
				{
					"id": 730731409,
					"content": "过去无法改变。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730731410
					]
				},
				{
					"id": 730731405,
					"content": "你们还真是一样。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730731406
					]
				}
			]
		},
