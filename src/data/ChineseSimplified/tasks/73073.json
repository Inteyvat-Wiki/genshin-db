			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"加扎里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730730901,
					"content": "没想到还有我没见过的巨像零件，关于那架遗迹巨像到底还有多少我不知道的东西呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730902
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730730902,
					"content": "你们找到阿麦塔机关的碎片了吗？为了学术事业，无论如何就拜托你们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "加扎里"
				}
			]
		},
		{
			"id": 7307310,
			"completionStepIds": [
				7307308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7307308",
							"2"
						],
						"stepId": 7307308,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿玛兹亚"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730731001,
					"content": "又是你们，拉娜带来的小客人。拉娜没和你们一起吗？怎么这次巡林这么久…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731002
					],
					"speakerTitle": "阿玛兹亚"
				},
				{
					"id": 730731002,
					"content": "不过你们特意过来找我，应该是遇到什么事了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731003
					],
					"speakerTitle": "阿玛兹亚"
				},
				{
					"id": 730731003,
					"content": "这个嘛，其实是因为…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731004
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730731004,
					"content": "和阿玛兹亚爷爷说了罗因贾、秘密基地和冒险手册的事情。\\n实在是很曲折。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730731005
					]
				},
				{
					"id": 730731005,
					"content": "原来是这样，你们去过那个秘密基地了啊，怎么样，是不是很厉害。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731006
					],
					"speakerTitle": "阿玛兹亚"
				},
				{
					"id": 730731006,
					"content": "罗因贾这个家伙，都已经跑到维摩庄来了还是不愿意见我一面，真是越老越顽固了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731007
					],
					"speakerTitle": "阿玛兹亚"
				},
				{
					"id": 730731007,
					"content": "不过确实也是他的性格，离上次见到他已经快有十年了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731008
					],
					"speakerTitle": "阿玛兹亚"
				},
				{
					"id": 730731008,
					"content": "那次还是因为要去奥摩斯港处理一些事情才碰到的。听到他还是老样子我就放心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731009
					],
					"speakerTitle": "阿玛兹亚"
				},
				{
					"id": 730731009,
					"content": "你们的关系还真是奇怪。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730731010
					]
				},
				{
					"id": 730731010,
					"content": "所以罗因贾爷爷为什么不愿意见你呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731011
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730731011,
					"content": "哎呀，说来话长，你们想听我这个老头子叨叨吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731012,
						730731014
					],
					"speakerTitle": "阿玛兹亚"
				},
				{
					"id": 730731012,
					"content": "挺好奇的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730731013
					]
				},
				{
					"id": 730731013,
					"content": "嗯！派蒙也很好奇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731016
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730731016,
					"content": "小的时候，因为祖父的原因，罗因贾那个家伙在维摩庄住过很长一段时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731017
					],
					"speakerTitle": "阿玛兹亚"
				},
				{
					"id": 730731017,
					"content": "因为是从繁华的奥摩斯港来的孩子，还有一个传奇的冒险家祖父，所以理所当然的，他很快就成了孩子们的焦点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731018
					],
					"speakerTitle": "阿玛兹亚"
				},
				{
					"id": 730731018,
					"content": "维摩庄的孩子们都被他从祖父那里听来的故事吸引了，我也是那些孩子中的一个。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731019
					],
					"speakerTitle": "阿玛兹亚"
				},
				{
					"id": 730731019,
					"content": "我们一起在那边的山洞里建造了秘密基地，用树枝和花朵把自己装扮成武士与英雄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731020
					],
					"speakerTitle": "阿玛兹亚"
				},
				{
					"id": 730731020,
					"content": "对还是孩子的我们而言，那个秘密基地就像是幻想的异世界。光是在这个山洞里面我们就能完成无数的传奇与冒险了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731021
					],
					"speakerTitle": "阿玛兹亚"
				},
				{
					"id": 730731021,
					"content": "现在想起来那些时光都仿佛是在梦里一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731022
					],
					"speakerTitle": "阿玛兹亚"
				},
				{
					"id": 730731022,
					"content": "好像罗因贾爷爷也提过，这个秘密基地以前有好多好多人。不过后来为什么会变成这样呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731023,
						730731024
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730731023,
					"content": "所有的梦都会醒。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730731025
					]
				},
				{
					"id": 730731025,
					"content": "嗯，小孩子本来做什么事情都是三分钟热度。传奇也好，冒险也好，本来也不过是无数件有趣的事情中的一件罢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731026
					],
					"speakerTitle": "阿玛兹亚"
				},
				{
					"id": 730731026,
					"content": "等到回过神来的时候，还在那个秘密基地里幻想着那些传奇的冒险的就只剩下我和罗因贾两个人了…还是三个来着。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731027
					],
					"speakerTitle": "阿玛兹亚"
				},
				{
					"id": 730731027,
					"content": "三个…罗因贾爷爷也说过那个时候是有三个人的来着，不过他已经记不起来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731028
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730731028,
					"content": "我也记不清了，都过去这么多年了，我们两个都老了。到底是谁呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731029
					],
					"speakerTitle": "阿玛兹亚"
				},
				{
					"id": 730731029,
					"content": "或许是「兰那罗」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730731030
					]
				},
				{
					"id": 730731030,
					"content": "「兰那罗」…又是「兰那罗」吗…这倒像是讲给小孩子的童话故事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731031
					],
					"speakerTitle": "阿玛兹亚"
				},
				{
					"id": 730731031,
					"content": "如果那个时候和他一起离开了维摩庄，现在肯定还会相信这些吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731032
					],
					"speakerTitle": "阿玛兹亚"
				},
				{
					"id": 730731032,
					"content": "和他一起…所以罗因贾爷爷是为什么会离开维摩庄的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731033
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730731033,
					"content": "当然是为了他的冒险呀。那个家伙，从那个时候开始就已经这么固执了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731034
					],
					"speakerTitle": "阿玛兹亚"
				},
				{
					"id": 730731034,
					"content": "那个时候我们约定要一起成为世界上最厉害的冒险家，就像他那个传奇的祖父一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731035
					],
					"speakerTitle": "阿玛兹亚"
				},
				{
					"id": 730731035,
					"content": "不过我们两个，谁都没有当冒险家的天赋呢。在最初的热情耗尽之后，我也有更重要的事情要去做了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731036
					],
					"speakerTitle": "阿玛兹亚"
				},
				{
					"id": 730731036,
					"content": "最后留下来的，就只剩下他一个人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731037
					],
					"speakerTitle": "阿玛兹亚"
				},
				{
					"id": 730731037,
					"content": "我们会变成这样，也是因为这个原因，在他看来，我更有冒险家的天赋，却比他更早的放弃了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731038
					],
					"speakerTitle": "阿玛兹亚"
				},
				{
					"id": 730731038,
					"content": "真是固执啊，不过最后他能成为奥摩斯港最厉害的古董商人，也是因为这种固执吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731039
					],
					"speakerTitle": "阿玛兹亚"
				},
				{
					"id": 730731039,
					"content": "好了，麻烦你们听我叨叨了这么久，都快忘记正事了。你们是为了那两个机关碎片的位置来的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731040
					],
					"speakerTitle": "阿玛兹亚"
				},
				{
					"id": 730731040,
					"content": "我年纪大了，眼神不太好，麻烦稍微等我一会吧，我给你们标出来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731041
					],
					"speakerTitle": "阿玛兹亚"
				},
				{
					"id": 730731041,
					"content": "这也算是那个家伙的委托吧。虽然我用了维摩庄传统的花体字，哼，明明那个时候他也是能看懂的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731042
					],
					"speakerTitle": "阿玛兹亚"
				},
				{
					"id": 730731042,
					"content": "阿玛兹亚爷爷对照着冒险笔记转写并标出了机关碎片相关的信息。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730731043
					]
				},
				{
					"id": 730731043,
					"content": "嘿嘿好了，你们按照这个去找就好了。没想到这么多年后那个东西还能有它的用处。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731044
					],
					"speakerTitle": "阿玛兹亚"
				},
				{
					"id": 730731044,
					"content": "哦，对了，刚才我在笔记里找到了这个。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731045
					],
					"speakerTitle": "阿玛兹亚"
				},
				{
					"id": 730731045,
					"content": "阿玛兹亚爷爷从发黄的纸张中找出一朵风干的花。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730731046
					]
				},
				{
					"id": 730731046,
					"content": "如果你们再见到罗因贾就把这个交给他吧，或许他能想起些什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731047
					],
					"speakerTitle": "阿玛兹亚"
				},
				{
					"id": 730731047,
					"content": "兰利遮，为什么你刚才一直都没说话呀。那个是阿玛兹亚爷爷，是很好的那菈，兰利遮不用害怕的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731048
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730731048,
					"content": "兰利遮没有害怕。你们说的事情，兰利遮好像听人说过，好熟悉，但是兰利遮想不起来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731049
					],
					"speakerTitle": "兰利遮"
				},
				{
					"id": 730731049,
					"content": "兰利遮搞不懂，所以兰利遮不说话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731050
					],
					"speakerTitle": "兰利遮"
				},
				{
					"id": 730731050,
					"content": "兰利遮，奇怪。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730731051
					]
				},
				{
					"id": 730731051,
					"content": "兰利遮，好奇怪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731052
					],
					"speakerTitle": "兰利遮"
				},
				{
					"id": 730731052,
					"content": "好累哦，不过总算有进展了。总之我们就按阿玛兹亚爷爷说的，去把另外两个碎片找出来交给加扎里先生吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730731024,
					"content": "所有的孩子都会长大。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730731025
					]
				},
				{
					"id": 730731014,
					"content": "如果不是很长的话…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730731015
					]
				},
				{
					"id": 730731015,
					"content": "哈哈，我会长话短说的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731016
					],
					"speakerTitle": "阿玛兹亚"
				}
			]
		},
		{
