			},
			"dialogs": [
				{
					"id": 730730701,
					"content": "唔…没错，这个的确是阿麦塔机关…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730702
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730730702,
					"content": "怎么样我没骗你们吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730703
					],
					"speakerTitle": "罗因贾"
				},
				{
					"id": 730730703,
					"content": "好耶，这样就能去打开那个大机器人了吧，已经开始期待了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730704
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730730704,
					"content": "呃，但是这个只是一块碎片，没有完整的阿麦塔机关，还是没办法打开遗迹巨像的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730705
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730730705,
					"content": "虽然只要没有被彻底毁坏的话我肯定是能修好的啦，不过得想办法找到剩下的碎片才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730706
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730730706,
					"content": "所以剩下的碎片…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730730707
					]
				},
				{
					"id": 730730707,
					"content": "哎呀你们别着急嘛，这个机关是被分成了三个部分来着。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730708
					],
					"speakerTitle": "罗因贾"
				},
				{
					"id": 730730708,
					"content": "不过祖父当初是怎么把它们丢在了三个不同的地方的…可惜，应该会是个很精彩的故事的，可是我一点也想不起来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730709
					],
					"speakerTitle": "罗因贾"
				},
				{
					"id": 730730709,
					"content": "三个不同的地方…就是说这里面记录了碎片所在的位置咯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730710
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730730710,
					"content": "嗯，没错，机关碎片埋藏的地点都记录在这本手册里了。埋在这里的这块碎片应该也是我们当时从不知道什么地方找到的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730711
					],
					"speakerTitle": "罗因贾"
				},
				{
					"id": 730730711,
					"content": "#这样的话，我们就根据这个去找齐剩下的两块碎片吧，我们最擅长找东西了。对吧，{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730712,
						730730714
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730730712,
					"content": "擅长找东西，不擅长找人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730730713
					]
				},
				{
					"id": 730730713,
					"content": "#嗯，我知道你的意思，没关系我们一定会找到{F#他}{M#她}的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730715
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730730715,
					"content": "话是这样说哪，不过…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730716
					],
					"speakerTitle": "罗因贾"
				},
				{
					"id": 730730716,
					"content": "不过？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730717
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730730717,
					"content": "不过我看不懂哪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730718
					],
					"speakerTitle": "罗因贾"
				},
				{
					"id": 730730718,
					"content": "欸，这个难道不是你自己写的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730719
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730730719,
					"content": "唔…怎么说呢，这个其实是我们两个…唉，或许是三个人共同的冒险笔记。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730720
					],
					"speakerTitle": "罗因贾"
				},
				{
					"id": 730730720,
					"content": "虽然第三个人我已经想不起来了，不过那个老头子我可忘不了。如果你们想要知道剩下机关碎片的位置，就去找他吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730721
					],
					"speakerTitle": "罗因贾"
				},
				{
					"id": 730730721,
					"content": "那个老头子应该还活着吧，如果还活着的话肯定就还在维摩庄了。毕竟是说要一辈子待在这个地方的家伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730722
					],
					"speakerTitle": "罗因贾"
				},
				{
					"id": 730730722,
					"content": "你说的老头子该不会是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730730723
					]
				},
				{
					"id": 730730723,
					"content": "阿玛兹亚爷爷吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730724
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730730724,
					"content": "哦？你们认识那个老头子吗，这样就好办了。你们把这本手册拿去给他看看吧，他应该会明白的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730725
					],
					"speakerTitle": "罗因贾"
				},
				{
					"id": 730730725,
					"content": "欸？你不和我们一起去吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730726
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730730726,
					"content": "哼，我可不想见到那个老家伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730727
					],
					"speakerTitle": "罗因贾"
				},
				{
					"id": 730730727,
					"content": "你们如果搞清楚了碎片埋藏的地点，就自己去找吧，虽然我也很想跟你们一起去啦，不过我这副老骨头已经折腾不动了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730728
					],
					"speakerTitle": "罗因贾"
				},
				{
					"id": 730730728,
					"content": "年轻的时候我也想要成为一个像祖父一样伟大的冒险家，如果不是因为那个家伙的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730729
					],
					"speakerTitle": "罗因贾"
				},
				{
					"id": 730730729,
					"content": "不过比起冒险，对我来说更重要的果然还是故事。如果你们收集到了什么故事的话，记得带回来给我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730730
					],
					"speakerTitle": "罗因贾"
				},
				{
					"id": 730730730,
					"content": "作为报酬，这个机关碎片就交给你们了，怎么样，很划算吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730731,
						730730732
					],
					"speakerTitle": "罗因贾"
				},
				{
					"id": 730730731,
					"content": "成交！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730730733
					]
				},
				{
					"id": 730730733,
					"content": "嗯…看上去我也帮不上什么忙，我不如还是留在这里等你们吧。而且这里还有很多零件需要研究，我可不能错过这个机会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730734
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730730734,
					"content": "总之就拜托二位了，请尽快把碎片带回来吧，要是错过结项的期限可就麻烦了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730730732,
					"content": "也没有别的办法。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730730733
					]
				},
				{
					"id": 730730714,
					"content": "没错！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730730715
					]
				}
			]
		},
