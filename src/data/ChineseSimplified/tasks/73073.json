						730731502
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730731502,
					"content": "剩下的两块碎片…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730731503
					]
				},
				{
					"id": 730731503,
					"content": "啊啊，没错，就是这个，真是辛苦你们了，剩下的事情就交给我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731504
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730731504,
					"content": "加扎里修好了「阿麦塔机关」。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730731505
					]
				},
				{
					"id": 730731505,
					"content": "嗯，这样应该就能用了，不愧是我啊。就算是教令院的诃般荼，也做不到不查阅任何资料就修好这个东西吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731506
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730731506,
					"content": "多亏你们碰到了我，这下我们终于能进到那台遗迹巨像里面了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731507
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730731507,
					"content": "这话应该我们来说才对吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730731508
					]
				},
				{
					"id": 730731508,
					"content": "啊，不知道都有几百年没有人进去过了，这下我肯定会在学术史上留名的！哎呀，不好意思，我太激动了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731509
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730731509,
					"content": "派蒙也开始激动了呢！不管是经费还是宝藏，我们可要来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
