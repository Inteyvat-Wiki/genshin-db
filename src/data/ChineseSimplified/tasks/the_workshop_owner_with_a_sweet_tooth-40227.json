			},
			"dialogs": [
				{
					"id": 402270101,
					"content": "嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270102
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 402270102,
					"content": "你们好啊，爱诺，伊涅芙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402270103,
					"content": "#你们好，{NICKNAME}，派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270104
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402270104,
					"content": "我们接了奈芙尔的委托，负责与参展方接洽，叮铃哐啷蛋卷工坊也参加了这次展会吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402270105,
					"content": "是的，爱诺正在对「噼里啪啦守卫团」进行最后一次调试。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270106
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402270106,
					"content": "噼里啪啦…哦，这就是工坊准备的参展货物吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402270107,
					"content": "总有鼹鼠之类的动物来工坊偷东西，爱诺就仿照它们的形象制作了一套防卫机关，用来保护工坊的资产。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270108
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402270108,
					"content": "爱诺之前进行过一次测试，测试结果为「非常有效」，于是爱诺将它们全面升级，准备用来参展。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270109
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402270109,
					"content": "爱诺准备交易自己的作品？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402270110,
					"content": "除了直接来自工坊外的订单，爱诺极少直接出售自己的作品，她准备在展会上交易的是设计图纸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270111
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402270111,
					"content": "原来是这样…对了，你们准备好去展会那边了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402270112,
					"content": "#雅珂达专门拜托我和{NICKNAME}来催你们，她给你们预留了一个很好的展位，一直空着的话会出问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402270113,
					"content": "不是已经跟她说过了吗？必须全部调试好才能搬过去！再着急也没有用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270114
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 402270114,
					"content": "哇，难得见到爱诺这么认真。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402270115,
					"content": "最近工坊确实遭遇了重大的资金短缺问题，爱诺希望能通过这次展会改善经济状况，这种谨慎是合乎逻辑的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270116
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402270116,
					"content": "资金短缺？难道爱诺在搞什么耗资巨大的研究？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402270117,
					"content": "短缺的并不是「研究资金」，是「甜品资金」。在过往的记录中，共有47次因超额采购甜品而导致研究资金出现缺口的情况。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270118
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402270118,
					"content": "后来，从工坊运营的角度考虑，我将「研究资金」与「甜品资金」进行了区分，并禁止爱诺随意挪用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270119
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402270119,
					"content": "而就在不久前，爱诺把整整一个月份额的「甜品资金」都用完了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270120,
						402270121
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402270120,
					"content": "好吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402270122
					]
				},
				{
					"id": 402270122,
					"content": "完工！噼里啪啦守卫团，好好表现！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270123
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 402270123,
					"content": "请带我们去会场吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402270121,
					"content": "我不意外。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402270122
					]
				}
			]
		},
