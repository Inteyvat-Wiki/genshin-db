			"dialogs": [
				{
					"id": 402270201,
					"content": "爱诺和伊涅芙在你们的带领下来到展会现场。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402270202
					]
				},
				{
					"id": 402270202,
					"content": "唔…演示平台就放在这里吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270203
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 402270203,
					"content": "爱诺新设计的防卫机关…说实话，我挺好奇的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402270204,
					"content": "#{NICKNAME}和派蒙随时都可以过来玩，我的作品绝不会让你们失望的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270205
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 402270205,
					"content": "辛苦你们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270206
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402270206,
					"content": "不客气！对了，工坊这边的参展人员就登记爱诺和伊涅芙喽？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402270207,
					"content": "嗯…爱诺并不能被界定为参展人员，她不喜欢太热闹的氛围，等展会正式开始后就会返回工坊，我会在这里帮她盯着展位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270208
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402270208,
					"content": "想来也是呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
