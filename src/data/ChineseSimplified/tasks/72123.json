					"阿幸"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721230901,
					"content": "说起来，雷樱树的位置你应该都知道吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230902
					],
					"speakerTitle": "阿幸"
				},
				{
					"id": 721230902,
					"content": "…看你的反应，我明白了，你应该还不清楚雷樱树的位置。也难怪，你毕竟是外来的旅行者，是我想当然了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230903
					],
					"speakerTitle": "阿幸"
				},
				{
					"id": 721230903,
					"content": "那五棵雷樱树并不难找，只要沿着<color=#00E1FFFF>西侧的海岸线</color>，从九条阵屋所在岛屿的<color=#00E1FFFF>最北端</color>一路走到<color=#00E1FFFF>踏鞴砂的最北端</color>，就能发现其中三棵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230904
					],
					"speakerTitle": "阿幸"
				},
				{
					"id": 721230904,
					"content": "另外两棵雷樱树，一棵长在<color=#00E1FFFF>踏鞴砂西北面</color>的山崖上，一棵长在<color=#00E1FFFF>踏鞴砂西南面</color>的山崖上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230905
					],
					"speakerTitle": "阿幸"
				},
				{
					"id": 721230905,
					"content": "现在我给你指明了方向，事情应该容易些了。那么，雷樱树的事情就拜托你了，路上还请小心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿幸"
				}
			]
		}
	]
