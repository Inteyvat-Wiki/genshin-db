							"2"
						],
						"stepId": 7212306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿幸"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721230301,
					"content": "你有什么发现吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230302
					],
					"speakerTitle": "阿幸"
				},
				{
					"id": 721230302,
					"content": "关于秀秋…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230303
					]
				},
				{
					"id": 721230303,
					"content": "居然有这么一回事？但盗宝团动的那点小手脚真能引起这么严重的后果吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230304
					],
					"speakerTitle": "阿幸"
				},
				{
					"id": 721230304,
					"content": "雷樱树的凋零说不定还有其他原因…我有些猜想，不知道准不准确…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230305
					],
					"speakerTitle": "阿幸"
				},
				{
					"id": 721230305,
					"content": "什么意思？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230306
					]
				},
				{
					"id": 721230306,
					"content": "这里是神无冢啊，不论是稻妻人的信仰，还是珊瑚宫人的信仰，都无法照耀的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230307
					],
					"speakerTitle": "阿幸"
				},
				{
					"id": 721230307,
					"content": "眼狩令颁布之后，幕府军和叛军经常在这里发生冲突，军队的人可不会在乎是否波及到了雷樱树。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230308
					],
					"speakerTitle": "阿幸"
				},
				{
					"id": 721230308,
					"content": "用神子大人的话来说，那都是些「满脑子只有功勋的家伙」，没法讲道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230309
					],
					"speakerTitle": "阿幸"
				},
				{
					"id": 721230309,
					"content": "我们神社对这一点早就有心理准备，但是没想到，雷樱树的状况已经糟到这个地步了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230310
					],
					"speakerTitle": "阿幸"
				},
				{
					"id": 721230310,
					"content": "总之，当务之急是把盗宝团动的那些小手脚清理掉，旅行者，我能再次拜托你吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230311,
						721230313
					],
					"speakerTitle": "阿幸"
				},
				{
					"id": 721230311,
					"content": "没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230312
					]
				},
				{
					"id": 721230312,
					"content": "请千万不要掉以轻心，正因为雷樱树变得脆弱了情况才会变危险，毕竟树下还镇守着那位大人的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230315
					],
					"speakerTitle": "阿幸"
				},
				{
					"id": 721230315,
					"content": "啊，我不该多嘴的，你、你就当没听见吧。总之，一定要小心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230316
					],
					"speakerTitle": "阿幸"
				},
				{
					"id": 721230316,
					"content": "我也需要点时间整理状况，毕竟这件事现在还有疑点：到底是谁在背后指点盗宝团？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230317
					],
					"speakerTitle": "阿幸"
				},
				{
					"id": 721230317,
					"content": "事情变得复杂起来了，真是棘手…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿幸"
				},
				{
					"id": 721230313,
					"content": "清理应该很容易吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230314
					]
				},
				{
					"id": 721230314,
					"content": "恐怕没那么简单，正因为雷樱树变得脆弱了情况才会变危险，毕竟树下还镇守着那位大人的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230315
					],
					"speakerTitle": "阿幸"
				}
			]
		},
