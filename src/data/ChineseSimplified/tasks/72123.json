					"阿幸"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721230602,
					"content": "晦气，我这是碰上了什么硬骨头。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230603
					],
					"speakerTitle": "秀秋"
				},
				{
					"id": 721230603,
					"content": "你们这些无耻的家伙，居然跟愚人众相互勾结，鸣神大人的惩罚早晚会降到你们头上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230604
					],
					"speakerTitle": "阿幸"
				},
				{
					"id": 721230604,
					"content": "别、别以为你们能唬住我，搅了我的买卖还想把我人也折进去，没门！我还有最后一招。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "秀秋"
				}
			]
		},
		{
			"id": 7212307,
			"completionStepIds": [
				7212319
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
