	"talks": [
		{
			"id": 7212302,
			"completionStepIds": [
				7212305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7212305",
							"2"
						],
						"stepId": 7212305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"秀秋"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721230204,
					"content": "别、别杀我，雷樱树的事情跟我一点关系都没有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230205
					],
					"speakerTitle": "秀秋"
				},
				{
					"id": 721230205,
					"content": "你怎么知道我们是为了雷樱树的事情来的？你果然做了亏心事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721230206,
					"content": "恐怕这个和无相之雷一样的东西，也是你们从不正当渠道弄来的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721230207,
					"content": "我…你们…这关你们什么事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230208
					],
					"speakerTitle": "秀秋"
				},
				{
					"id": 721230208,
					"content": "我受人之托。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230209
					]
				},
				{
					"id": 721230209,
					"content": "对，我们受人之托，代行正义！盗宝团到底对雷樱树做了什么，这东西是哪里来的，快老实交待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721230210,
					"content": "不乖乖交待的话，哼哼，旅行者的剑可是很厉害的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721230211,
					"content": "我说我说！那什么，这几棵树反正也没人管，我带弟兄几个借它们的力量赚一笔也没什么吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230212
					],
					"speakerTitle": "秀秋"
				},
				{
					"id": 721230212,
					"content": "有个厉害的买家对雷樱树有点兴趣，而且对方连导出雷樱树力量的方法和工具都提供好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230213
					],
					"speakerTitle": "秀秋"
				},
				{
					"id": 721230213,
					"content": "只要我们按照买家说的，在树上开个口子，嘿嘿，要用工具汲取雷樱树的力量就轻轻松松了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230214
					],
					"speakerTitle": "秀秋"
				},
				{
					"id": 721230214,
					"content": "然后再把力量导入到这座结晶里去，咱就赚到了能抵三座天领奉行大宅的宝贝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230215
					],
					"speakerTitle": "秀秋"
				},
				{
					"id": 721230215,
					"content": "买家可是提供了一大笔报酬，你这种小角色一辈子也花不完。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230216
					],
					"speakerTitle": "秀秋"
				},
				{
					"id": 721230216,
					"content": "你愿意放过我的话，我还能勉为其难算你一份，到时候一九分账，你一我们九。怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230217,
						721230218
					],
					"speakerTitle": "秀秋"
				},
				{
					"id": 721230217,
					"content": "太少了吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230219
					]
				},
				{
					"id": 721230219,
					"content": "什么？可恶，我可是好心给你们提供生路，等买主到了，你们都得哭着来求我秀秋大爷的原谅！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230220
					],
					"speakerTitle": "秀秋"
				},
				{
					"id": 721230220,
					"content": "口气也太大了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721230221,
					"content": "小东西，你嚣张什么，我的兄弟们马上就会找到帮手回来救我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230222
					],
					"speakerTitle": "秀秋"
				},
				{
					"id": 721230222,
					"content": "哪怕你们再叫一百个人来，也碰不到派蒙我的一根头发，旅行者会把你们统统打跑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721230223,
					"content": "山田，这小东西说你们根本伤不着她，你还不出手？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230224
					],
					"speakerTitle": "秀秋"
				},
				{
					"id": 721230224,
					"content": "山田？那是谁呀…不好！旅行者快！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721230225,
					"content": "欸？根本什么人都没有嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721230218,
					"content": "在做梦吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230219
					]
				}
			]
		},
		{
			"id": 7212303,
			"completionStepIds": [
				7212306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
