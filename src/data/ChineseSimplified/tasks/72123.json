			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿幸"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721230401,
					"content": "雷樱树怎么样了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230402
					],
					"speakerTitle": "阿幸"
				},
				{
					"id": 721230402,
					"content": "「小手脚」已经全被清理掉了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230403
					]
				},
				{
					"id": 721230403,
					"content": "太好了，这样雷樱树的状况也会稳定下来，神子大人应该也能安心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230404
					],
					"speakerTitle": "阿幸"
				},
				{
					"id": 721230404,
					"content": "这些胆大妄为的家伙，竟敢盗窃雷樱树的力量用来牟利，简直罪无可恕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230405
					],
					"speakerTitle": "阿幸"
				},
				{
					"id": 721230405,
					"content": "而且你提到，盗宝团营地里有一颗聚集雷樱树力量的结晶？那也太危险了，一定要尽快处理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230406
					],
					"speakerTitle": "阿幸"
				},
				{
					"id": 721230406,
					"content": "之前麻烦你帮了我那么多，这次我实在不好意思再让你一个人行动了，我也会去一起处理的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230407
					],
					"speakerTitle": "阿幸"
				},
				{
					"id": 721230407,
					"content": "事不宜迟，我们现在就走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿幸"
				}
			]
		},
		{
			"id": 7212305,
			"completionStepIds": [
				7212315
			],
