			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"秀秋"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721230501,
					"content": "哼，原来是你这个女人要妨碍我赚钱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230502
					],
					"speakerTitle": "秀秋"
				},
				{
					"id": 721230502,
					"content": "你们真是不知好歹，雷樱树的主意也敢打，神子大人不会让你们好过的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230503
					],
					"speakerTitle": "阿幸"
				},
				{
					"id": 721230503,
					"content": "少说大话了，你们也不看看惹到的是谁！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230504
					],
					"speakerTitle": "秀秋"
				},
				{
					"id": 721230504,
					"content": "大爷，妨碍您生意的就是那边那个旅行者，您不出手咱们的买卖就悬了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230505
					],
					"speakerTitle": "秀秋"
				},
				{
					"id": 721230505,
					"content": "呵呵，就凭这弱不禁风的身板，也敢在我面前逞威风？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "愚人众先遣队"
				}
			]
		},
		{
			"id": 7212306,
			"completionStepIds": [
				7212317
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
