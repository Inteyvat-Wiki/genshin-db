				"objectNames": [
					"阿幸"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721230701,
					"content": "别…别追了，已经绕了三圈又绕回原地了，我实在跑不动了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230702
					],
					"speakerTitle": "秀秋"
				},
				{
					"id": 721230702,
					"content": "为了利益不惜与外人勾结，你这家伙十恶不赦！就算让我再跑十圈我也绝对不会饶了你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230703
					],
					"speakerTitle": "阿幸"
				},
				{
					"id": 721230703,
					"content": "呼…旅行者，看你一脸轻松，刚才的麻烦已经都解决掉了吧，感谢你帮了我这么多忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230704
					],
					"speakerTitle": "阿幸"
				},
				{
					"id": 721230704,
					"content": "雷樱树的力量绝对不能落入这种家伙的手里，更何况这件事背后还有愚人众作祟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230705
					],
					"speakerTitle": "阿幸"
				},
				{
					"id": 721230705,
					"content": "很难说愚人众到底打了什么鬼主意，我既然逮住了这家伙，就一定会问个明白。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230706
					],
					"speakerTitle": "阿幸"
				},
				{
					"id": 721230706,
					"content": "后续的处理就交给我吧，幕府军驻扎的地方我也认识，这家伙是跑不掉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿幸"
				}
			]
		},
