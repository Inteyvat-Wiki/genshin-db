			"dialogs": [
				{
					"id": 4842201,
					"content": "居然跑到这里来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4842202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4842202,
					"content": "前面已经没有元素痕迹了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4842203
					]
				},
				{
					"id": 4842203,
					"content": "文物上面的元素力要耗尽了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4842204
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4842204,
					"content": "原来是这样，怪鸟一伙知道自己没法处理元素的痕迹，才让手下拖住我们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4842205
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4842205,
					"content": "是想等元素的痕迹自然消失吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4842206
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4842206,
					"content": "他不会得逞的，我们赶紧追上去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安柏"
				}
