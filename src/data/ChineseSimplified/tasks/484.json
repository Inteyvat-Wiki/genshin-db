					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4841104
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4841104,
					"content": "#{NICKNAME}，我们顺着痕迹追下去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4841105
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4841105,
					"content": "咦，前面好像有什么动静…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4841106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4841106,
					"content": "好像是战斗的声音，难道是怪鸟？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4841107
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4841107,
					"content": "快，我们赶紧过去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安柏"
				}
			]
