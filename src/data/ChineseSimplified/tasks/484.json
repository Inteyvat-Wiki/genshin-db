				"points": []
			},
			"dialogs": [
				{
					"id": 4843101,
					"content": "太好了，是西风骑士团的人！丘丘人应该不敢追过来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843102
					],
					"speakerTitle": "法拉"
				},
				{
					"id": 4843102,
					"content": "发生什么了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843103
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4843103,
					"content": "真是倒霉…我们的车队被丘丘人袭击了，还好我们跑得比较快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843104
					],
					"speakerTitle": "法拉"
				},
				{
					"id": 4843104,
					"content": "丘丘人袭击？可周围的丘丘人营地，几乎都已经被骑士团清理干净了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843105
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4843105,
					"content": "是一个很小的丘丘人营地，和镇里隔着不远，我平时进货摆摊的时候也会特意绕开。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843106
					],
					"speakerTitle": "法拉"
				},
				{
					"id": 4843106,
					"content": "但是今天，突然从天上飞下来一个人，正好落在那个丘丘人营地里面！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843107
					],
					"speakerTitle": "法拉"
				},
				{
					"id": 4843107,
					"content": "嗯…总感觉是某人经常做的事情呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4843108,
					"content": "丘丘人一下子就炸了锅了，跟着那个逃跑的怪人就追了出来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843109
					],
					"speakerTitle": "法拉"
				},
				{
					"id": 4843109,
					"content": "我是跑了，可我运水果的车全都被砸了！明天商队来的时候，我可怎么开张啊——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843110
					],
					"speakerTitle": "法拉"
				},
				{
					"id": 4843110,
					"content": "怪人？是什么样子的怪人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843111
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4843111,
					"content": "抱着个什么东西，飞得歪歪扭扭的…嗯，一定是因为抱着这东西他才掉下来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843112
					],
					"speakerTitle": "法拉"
				},
				{
					"id": 4843112,
					"content": "真是的，没考过飞行执照吗？不许带重物懂不懂？！我一定要去举报，吊销他的飞行执照！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843113
					],
					"speakerTitle": "法拉"
				},
				{
					"id": 4843113,
					"content": "抱着重物…说不定就是带着文物逃跑的怪鸟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843114
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4843114,
					"content": "你看见那个怪人往哪里跑了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843115
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4843115,
					"content": "我跑的时候就来得及看了一眼，他们好像…是往前面跑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843116
					],
					"speakerTitle": "法拉"
				},
				{
					"id": 4843116,
					"content": "#总算抓住线索了，{NICKNAME}，我们快点追上去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843117
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4843117,
					"content": "哦对了，别担心，我回去也会报告骑士团，把残留的丘丘人营地尽快处理掉的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安柏"
				}
			]
		},
