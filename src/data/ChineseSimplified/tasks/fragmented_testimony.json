			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"兰丘",
					"皮雅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130200101,
					"content": "你那个课题，最近还顺利吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200102
					],
					"speakerTitle": "兰丘"
				},
				{
					"id": 130200102,
					"content": "下个月应该就能见刊了。呼…前几天还以为要被叫停了，好在是虚惊一场。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200103
					],
					"speakerTitle": "皮雅"
				},
				{
					"id": 130200103,
					"content": "毕竟你课题的导师中有阿扎尔挂名，原来还以为会被牵连。后来是怎么解决的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200104
					],
					"speakerTitle": "兰丘"
				},
				{
					"id": 130200104,
					"content": "不是新来了一位代理贤者吗？他重新审阅了我们的项目，允许我们继续研究。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200105
					],
					"speakerTitle": "皮雅"
				},
				{
					"id": 130200105,
					"content": "代理贤者？以前有过这种职位吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200106
					],
					"speakerTitle": "兰丘"
				},
				{
					"id": 130200106,
					"content": "我听人说，其实是因为新贤者还在选拔，但暂时没有结果…就让那个人暂代一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200107
					],
					"speakerTitle": "皮雅"
				},
				{
					"id": 130200107,
					"content": "也多亏他帮我们说了话，大家的研究成果才能保住。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200108
					],
					"speakerTitle": "皮雅"
				},
				{
					"id": 130200108,
					"content": "等论文见刊后，我一定要给自己放个长假，好好休息一下。到时候我想去蒙德旅游…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200109
					],
					"speakerTitle": "皮雅"
				},
				{
					"id": 130200109,
					"content": "那些人真是昏了头，竟然会请艾尔海森做代理贤者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200110
					],
					"speakerTitle": "拉库马尔"
				},
				{
					"id": 130200110,
					"content": "消消气，老师。我也纳闷，按资历您才是学术泰斗，怎么轮得到他一个毛头小子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200111
					],
					"speakerTitle": "雷汉"
				},
				{
					"id": 130200111,
					"content": "愚蠢！你以为我是气自己没当上贤者？我是不理解为何偏偏是艾尔海森。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200112
					],
					"speakerTitle": "拉库马尔"
				},
				{
					"id": 130200112,
					"content": "当初他选修我的课，一学期我就没见过他几次。问他，他居然敢顶撞我，说听我讲课还不如自己在家看书——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200113
					],
					"speakerTitle": "拉库马尔"
				},
				{
					"id": 130200113,
					"content": "狂妄！刺头！这样的人竟然成了代理贤者，简直就是教令院的不幸！咳咳咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200114
					],
					"speakerTitle": "拉库马尔"
				},
				{
					"id": 130200114,
					"content": "冷静啊老师，我、我去给您接点水！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200115
					],
					"speakerTitle": "雷汉"
				},
				{
					"id": 130200115,
					"content": "嘘…告诉你们一个秘密。听说新的代理贤者，是我们知论派的学长！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200116
					],
					"speakerTitle": "雷萨哈尼"
				},
				{
					"id": 130200116,
					"content": "真的吗？是谁啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200117
					],
					"speakerTitle": "法莉巴"
				},
				{
					"id": 130200117,
					"content": "他叫艾尔海森，我是没见过啦，最近有关他的说法不少，也不知道哪些是真的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200118
					],
					"speakerTitle": "罗珊"
				},
				{
					"id": 130200118,
					"content": "比起这个，最近因论派有个风头正盛的学者，听人说他很可能是下任贤者之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200119
					],
					"speakerTitle": "罗珊"
				},
				{
					"id": 130200119,
					"content": "哦？他有开课吗，我们要不要早点去拜访一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200120
					],
					"speakerTitle": "法莉巴"
				},
				{
					"id": 130200120,
					"content": "唔…看来艾尔海森要当代理贤者这件事传得很广呢。不过居然也有人不认识他，他似乎不是那么有名？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130200121,
					"content": "关于他的评价也是有好有坏，特别是刚刚那个老人，看上去对他很不满…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130200122,
					"content": "咦，你怎么了，身体不舒服吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130200123,
					"content": "风纪官…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200124
					],
					"speakerTitle": "伊利亚斯"
				},
				{
					"id": 130200124,
					"content": "风纪官？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130200125,
					"content": "我是伊利亚斯。我要见风纪官，我有很重要的事情…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200126
					],
					"speakerTitle": "伊利亚斯"
				},
				{
					"id": 130200126,
					"content": "呜哇，你都这样了，还是不要勉强自己了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130200127,
					"content": "要不你把事情告诉我们，我们帮你转告给风纪官怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130200128,
					"content": "不行。我必须亲自见到风纪官，只有风纪官可以信任…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200129
					],
					"speakerTitle": "伊利亚斯"
				},
				{
					"id": 130200129,
					"content": "拜托你们扶我一把，这件事很重要，绝对不能出差错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200130
					],
					"speakerTitle": "伊利亚斯"
				},
				{
					"id": 130200130,
					"content": "既然你都这么说了…好吧，我们带你去找风纪官！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 1302003,
			"completionStepIds": [
				1302003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1302003",
							"2"
						],
						"stepId": 1302003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿拉夫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130200301,
					"content": "你好！我们想打听一下，赛诺在教令院吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130200302,
					"content": "两位看着眼熟，莫非是赛诺大人的朋友？赛诺大人正在外面执行任务。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200303
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200303,
					"content": "有什么事可以先和我说，我会帮你们转告赛诺大人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200304
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200304,
					"content": "我们在教令院门口遇到了这家伙，他吵着要见风纪官，好像有什么要紧的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130200305,
					"content": "哦？不介意的话，可否先跟我聊一聊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200306
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200306,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200307
					],
					"speakerTitle": "伊利亚斯"
				},
				{
					"id": 130200307,
					"content": "西拉杰…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200308
					],
					"speakerTitle": "伊利亚斯"
				},
				{
					"id": 130200308,
					"content": "西拉杰？这个名字听上去很耳熟，是因论派那位学者吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200309
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200309,
					"content": "因论派的学者？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130200310,
					"content": "嗯。因论派风头鼎盛的学者，听说是一位敢想敢做的天才。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200311
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200311,
					"content": "也有消息说他可能会代表因论派成为下任贤者之一…你接着说，西拉杰怎么了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200312
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200312,
					"content": "我要揭发…西拉杰正在做一个危险的实验。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200313
					],
					"speakerTitle": "伊利亚斯"
				},
				{
					"id": 130200313,
					"content": "他绑架了我。把我绑到那个可怕的山洞里…到处都是实验器材…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200314
					],
					"speakerTitle": "伊利亚斯"
				},
				{
					"id": 130200314,
					"content": "我拼命地跑…只差一点，我就被他抓住了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200315
					],
					"speakerTitle": "伊利亚斯"
				},
				{
					"id": 130200315,
					"content": "别紧张，慢慢说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200316
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200316,
					"content": "他在做什么实验？那个山洞在哪里？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200317
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200317,
					"content": "我不记得了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200318
					],
					"speakerTitle": "伊利亚斯"
				},
				{
					"id": 130200318,
					"content": "欸？这么重要的事，你竟然不记得了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130200319,
					"content": "我只记得西拉杰朝我走来，之后我的脑袋就开始变得不正常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200320
					],
					"speakerTitle": "伊利亚斯"
				},
				{
					"id": 130200320,
					"content": "我忘了很多东西，就像做了一场噩梦。但我知道那里很危险，必须立刻阻止他们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200321
					],
					"speakerTitle": "伊利亚斯"
				},
				{
					"id": 130200321,
					"content": "对了，我还听说他们会在酒馆做交易，得快一点…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200322
					],
					"speakerTitle": "伊利亚斯"
				},
				{
					"id": 130200322,
					"content": "就算你这么说…好吧，我会让我的同事去查西拉杰的情况。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200323
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200323,
					"content": "不过在那之前，我希望你接受风纪官的「测谎」调查。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200324
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200324,
					"content": "你在怀疑我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200325
					],
					"speakerTitle": "伊利亚斯"
				},
				{
					"id": 130200325,
					"content": "不要误会，只是惯例而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200326
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200326,
					"content": "劳烦两位在这稍等一会儿，我们很快就会回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200327
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200327,
					"content": "等待的时间似乎比预期中更长一些…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130200328
					]
				},
				{
					"id": 130200328,
					"content": "咦，艾尔海森？你怎么在这？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200329
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130200329,
					"content": "我来解释一下吧，刚刚我带伊利亚斯去测谎，他顺利通过了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200330
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200330,
					"content": "这意味着他说的话有很高的可信度，我们决定围绕他提供的线索展开调查。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200331
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200331,
					"content": "这件事按惯例汇报给了艾尔海森大人，他听完之后先是给赛诺大人留了封信，然后提出要和我们一起行动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200332
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200332,
					"content": "奇怪，艾尔海森居然会和风纪官一起行动，莫非有什么特别的原因？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200333
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130200333,
					"content": "想多了，只是有点兴趣而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200334
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 130200334,
					"content": "是吗？你还有这种闲暇呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200335
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130200335,
					"content": "#{NICKNAME}，不如我们也一起去看看吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200336
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130200336,
					"content": "艾尔海森大人参与我们的行动已经是违规情况了，你们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200337
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200337,
					"content": "算了，毕竟伊利亚斯是你们带来的。我可以允许你们一起来，前提是你们必须对一切计划保密。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200338
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200338,
					"content": "放心，我们的嘴巴可是很严的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200339
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130200339,
					"content": "那我先说一下目前掌握的线索吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200340
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200340,
					"content": "伊利亚斯声称西拉杰会与某位妙论派学者在酒馆进行交易。这是他为数不多的清醒回忆，似乎是在逃跑的时候偶然听到的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200341
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200341,
					"content": "顺便一提，西拉杰目前并不在教令院，他在一个月前就申请了长期外出调研。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200342
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200342,
					"content": "距离伊利亚斯提供的交易时间很近了，我们决定立刻赶往酒馆，搜查可疑人员。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200343
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200343,
					"content": "就是这样。准备出发，你们随意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200344
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 130200344,
					"content": "都说了我们要一起去啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 1302005,
			"completionStepIds": [
				1302005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1302005",
							"2"
						],
						"stepId": 1302005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"艾尔海森"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130200501,
					"content": "我们到了，艾尔海森大人。接下来该怎么做？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200502
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200502,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200503
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 130200503,
					"content": "艾尔海森大人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200504
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200504,
					"content": "看来你最近没看任何文书。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200505
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 130200505,
					"content": "新颁布的教令明确提出，对于已经确立的调查案，即便是贤者出面也无权干预风纪官行动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200506
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 130200506,
					"content": "如果你们的上司在，他不会问我该做什么，反而会警告我「不要指手画脚」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200507
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 130200507,
					"content": "…您说得没错，我明白了。那请您在这里稍等，我们立刻封锁周边区域，搜查可疑人员！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200508
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200508,
					"content": "伊利亚斯就留在这里吧，也劳烦艾尔海森大人保护主要证人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200509
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200509,
					"content": "可以。他要是能保护好自己就更好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200510
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 130200510,
					"content": "果然还是老样子…之前在阿如村的时候就是这样，动不动就不理人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200511
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130200511,
					"content": "回答没水平的问题，是对发问者的纵容，而且我需要让他清楚地明白我的态度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200512
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 130200512,
					"content": "什么意思？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130200513
					]
				},
				{
					"id": 130200513,
					"content": "和你们一样，阿拉夫也疑惑我为什么会跟来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200514
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 130200514,
					"content": "但和你们不同的是，他把这个问题想得更复杂，比如「代理贤者想要染指风纪官的权力 」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200515
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 130200515,
					"content": "他向我提问，明显是在试探。风纪官早先受到贤者影响，难免被卷入这种官僚陷阱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200516
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 130200516,
					"content": "但他根本不需要那样说，我希望他了解，这一次我不会插手他们的工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200517
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 130200517,
					"content": "好复杂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200518
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130200518,
					"content": "所以我起初一直反对当什么代理贤者。头衔会让很多事变得麻烦，在所难免。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200519
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 130200519,
					"content": "打扰一下…艾尔海森大人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200520
					],
					"speakerTitle": "伊利亚斯"
				},
				{
					"id": 130200520,
					"content": "我有个问题，无论如何都想问——我们以前，见过面吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200521
					],
					"speakerTitle": "伊利亚斯"
				},
				{
					"id": 130200521,
					"content": "没有，我对你毫无印象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200522
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 130200522,
					"content": "哈哈…我想也是，我跟您这样的人应该没什么交集才对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200523
					],
					"speakerTitle": "伊利亚斯"
				},
				{
					"id": 130200523,
					"content": "那又为什么要问？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200524
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 130200524,
					"content": "因为第一次见到您时，不知道为什么总有一种…熟悉的感觉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200525
					],
					"speakerTitle": "伊利亚斯"
				},
				{
					"id": 130200525,
					"content": "是吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200526
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 130200526,
					"content": "错觉？或者是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200527
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 130200527,
					"content": "艾尔海森大人，我们抓到嫌疑人了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200528
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200528,
					"content": "西拉杰？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200529
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 130200529,
					"content": "不，是和他做交易的妙论派学者，名叫纳兰德拉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200530
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200530,
					"content": "艾、艾尔海森大人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200531
					],
					"speakerTitle": "纳兰德拉"
				},
				{
					"id": 130200531,
					"content": "等等，有人能跟我解释一下吗？我承认我确实从实验室偷了些机械零件往外卖，这是需要代理贤者亲自过问的案件吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200532
					],
					"speakerTitle": "纳兰德拉"
				},
				{
					"id": 130200532,
					"content": "我的天，我该不会卷入什么大麻烦里了吧？我，我只是一时利欲熏心，还请各位手下留情…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200533
					],
					"speakerTitle": "纳兰德拉"
				},
				{
					"id": 130200533,
					"content": "我想问他几个问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200534
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 130200534,
					"content": "当然可以。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200535
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200535,
					"content": "你认识西拉杰？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200536
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 130200536,
					"content": "听过，买家的名字。他约我在酒馆做交易，不过迟迟未到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200537
					],
					"speakerTitle": "纳兰德拉"
				},
				{
					"id": 130200537,
					"content": "交易的内容是什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200538
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 130200538,
					"content": "他不知道在做什么实验，好像需要很多能源与电路元件，只有我们项目有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200539
					],
					"speakerTitle": "纳兰德拉"
				},
				{
					"id": 130200539,
					"content": "他私下联系我，让我假借「淘汰损毁」之名昧下来一些，他会高价收购。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200540
					],
					"speakerTitle": "纳兰德拉"
				},
				{
					"id": 130200540,
					"content": "本来我们约好今天在酒馆交易，谁想到我先是被放了鸽子，又遇到了你们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200541
					],
					"speakerTitle": "纳兰德拉"
				},
				{
					"id": 130200541,
					"content": "也许是西拉杰察觉到伊利亚斯有可能会透露消息，所以故意没来赴约？不管怎么说，线索到这里似乎就断掉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200542
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200542,
					"content": "好消息是不管西拉杰想做什么，没有这批能源与电路，他的进度肯定会受到阻碍。我们还有时间慢慢调查。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200543
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200543,
					"content": "您还有什么问题吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200544
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200544,
					"content": "没有了，纳兰德拉交给你们带走。另外，我还想再「借」伊利亚斯一段时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200545
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 130200545,
					"content": "哦，这个没关系。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200546
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200546,
					"content": "我们对伊利亚斯进行了全方位的测谎，他确实不记得更多事情，我们也不打算从他这里寻找突破。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200547
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200547,
					"content": "不过顺便问下，您留下他的理由是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200548
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200548,
					"content": "我以前看过一些关于失忆的论文，想尝试引导他恢复记忆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200549
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 130200549,
					"content": "原来如此…那我们先回教令院，伊利亚斯就拜托您了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200550
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200550,
					"content": "跟我来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾尔海森"
				}
			]
		},
