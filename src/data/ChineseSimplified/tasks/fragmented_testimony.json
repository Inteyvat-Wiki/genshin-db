				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"纳比尔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130201001,
					"content": "(test)在风纪官的压力下，学者坦白说自己确实是从教令院偷了些器材往外卖，不过买家迟迟未到，他正准备溜的时候被抓了。\\n艾尔海森询问对方是否认识西拉杰，对方说听过，是买家的名字。艾尔海森又问你卖的是什么，对方说是一些妙论派最新的研制成果，主要是用于搭建复杂机械的电路元件与能源。艾尔海森听完摆摆手，让风纪官去处理这个人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "纳比尔"
				}
			]
		},
		{
			"id": 1302012,
			"completionStepIds": [
				1302012
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1302012",
							"2"
						],
						"stepId": 1302012,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"艾尔海森"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130201201,
					"content": "结果西拉杰根本没来酒馆，纳兰德拉也没有什么线索…好像陷入僵局了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130201202,
					"content": "艾尔海森，你真的打算管到底吗？总觉得你对这件事格外有兴趣，我都有点意外了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130201203,
					"content": "我还以为你已经猜到原因了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201204
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 130201204,
					"content": "#欸？我没猜到呀，{NICKNAME}，你猜到了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130201205,
					"content": "你认识西拉杰？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130201206
					]
				},
				{
					"id": 130201206,
					"content": "嗯，同届的同学。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201207
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 130201207,
					"content": "原来是这样！所以阿拉夫跟你汇报的时候，你才提出要跟来看看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130201208,
					"content": "你对这个案子感兴趣不是因为内容，而是因为嫌疑犯是认识的人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130201209,
					"content": "你的描述跟事实相差甚远，不过我并没有寄希望于你能得出更准确的答案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201210
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 130201210,
					"content": "你暂时这么理解就可以了。我跟他是同届入学，后来我当了书记官，而他继续在学术上深造。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201211
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 130201211,
					"content": "一年前，他提交了一份课题申请。当时的大贤者看后问我意见，我并不怎么看好，因为从结果来说，它触及了六宗根源之罪中的「人类进化之事」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201212
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 130201212,
					"content": "从「人类进化之事」到「慢言奥秘而心无惧怕之事」，六宗根源之罪是此世万般罪责的开端，也是贤者们制定和修正教令的参照。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201213
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 130201213,
					"content": "西拉杰的研究在我看来过于天真，但结果上他确实触犯了底线。大贤者参考了各种意见，那份报告最终被驳回。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201214
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 130201214,
					"content": "所以他购买能源和电路元件…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130201215,
					"content": "多半是想在不被允许的情况下，私自进行实验。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201216
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 130201216,
					"content": "听上去好可疑，还是阻止他比较好吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130201217,
					"content": "伊利亚斯，你再努力想想，看看会不会有什么新发现？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130201218,
					"content": "抱歉。我试过很多次，但无论我怎么回忆，那些事都像是隔着厚厚的迷雾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201219
					],
					"speakerTitle": "伊利亚斯"
				},
				{
					"id": 130201219,
					"content": "人在受到强烈的刺激后，可能会下意识割舍部分记忆，以此达到自我保护的目的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201220
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 130201220,
					"content": "但这些记忆并不是真的消失，只是暂时被封存了。给予适当刺激，仍然有恢复的可能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201221
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 130201221,
					"content": "试着回忆一下你在意的事情吧，不必非要和案件有关。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201222
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 130201222,
					"content": "其实，我感觉我忘掉的事情有很多，不仅仅只有被抓去做实验的部分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201223
					],
					"speakerTitle": "伊利亚斯"
				},
				{
					"id": 130201223,
					"content": "我是一个什么样的人、做过些什么事，有些我能记起来，有些不管怎么想都没有头绪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201224
					],
					"speakerTitle": "伊利亚斯"
				},
				{
					"id": 130201224,
					"content": "不过我隐约记得，自己有两件「不得不做的事」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201225
					],
					"speakerTitle": "伊利亚斯"
				},
				{
					"id": 130201225,
					"content": "说来听听。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201226
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 130201226,
					"content": "第一件事是「从教令院领取薪水，送给在化城郭的妹妹」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201227
					],
					"speakerTitle": "伊利亚斯"
				},
				{
					"id": 130201227,
					"content": "我不清楚详情…只记得以前我似乎每个月都会把钱给妹妹，让她补贴家用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201228
					],
					"speakerTitle": "伊利亚斯"
				},
				{
					"id": 130201228,
					"content": "那第二件呢？第二件事是什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201229
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130201229,
					"content": "想不起来。抱歉，我真的忘了太多东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201230
					],
					"speakerTitle": "伊利亚斯"
				},
				{
					"id": 130201230,
					"content": "不意外。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201231
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 130201231,
					"content": "目前只有你见过西拉杰，只有你知道那个山洞的具体位置。所以，我们会提供一切必要支持，帮助你恢复记忆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201232
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 130201232,
					"content": "失去记忆…一定很痛苦吧，不过我们会帮你想起来的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201233
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130201233,
					"content": "多谢。不仅仅是「痛苦」，我不知道该如何形容这种感觉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201234
					],
					"speakerTitle": "伊利亚斯"
				},
				{
					"id": 130201234,
					"content": "丢失了太多记忆，让我对自己的认知都变得模糊。脑袋嗡嗡作响，好像下一刻就要失去意识。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201235
					],
					"speakerTitle": "伊利亚斯"
				},
				{
					"id": 130201235,
					"content": "但在这种令人作呕的感觉中，我又像是得到了解脱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201236
					],
					"speakerTitle": "伊利亚斯"
				},
				{
					"id": 130201236,
					"content": "不管怎么说，多亏了你们，我变得稍微清醒一些了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201237
					],
					"speakerTitle": "伊利亚斯"
				},
				{
					"id": 130201237,
					"content": "我记得我在教令院中一个叫做「调研筹备处」的地方兼职，每个月也是在那里领取薪水的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201238
					],
					"speakerTitle": "伊利亚斯"
				},
				{
					"id": 130201238,
					"content": "我明白了。那就先去找那边的负责人，走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾尔海森"
				}
			]
		},
