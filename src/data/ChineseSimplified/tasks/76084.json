			"dialogs": [
				{
					"id": 760840101,
					"content": "你们来了？今天月灵们又在玩琴。能像上次一样弹一首给它们听吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760840102
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760840102,
					"content": "我正好也想听些不一样的曲调。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760840103
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760840103,
					"content": "（弹什么好呢…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
