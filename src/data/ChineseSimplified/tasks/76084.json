			"dialogs": [
				{
					"id": 760840601,
					"content": "演奏他国的音乐…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490801
					]
				},
				{
					"id": 760490801,
					"content": "演奏他国的音乐…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490802
					]
				},
				{
					"id": 760490802,
					"content": "奇妙的感觉。以前偶尔也听过类似的旋律，但听你弹的感受很不一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490803
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490803,
					"content": "#可能其中包含了{M#他}{F#她}对那个国家的感情吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490804
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760490804,
					"content": "奇妙的是，我能够从乐调中想象出风景…不知道现实和我的想象会有多少区别呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490805
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490805,
					"content": "想看还不简单？到时候就让我们来当你的导游吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490806
					],
					"speakerTitle": "派蒙"
				},
				{
