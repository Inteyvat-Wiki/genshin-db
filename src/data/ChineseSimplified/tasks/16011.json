						160111103
					],
					"speakerTitle": "安德留斯"
				},
				{
					"id": 160111103,
					"content": "「法尔伽，我，名字的意义…已经知道了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111104
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 160111104,
					"content": "「…给大家添了这么多麻烦，等回来，要好好道谢啊。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111105
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 160111105,
					"content": "「哟，虽然有很多事想报告，不过嘛…回来了就好。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111106
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 160111106,
					"content": "「我不打算回骑士团，所以…还是请您自己撑着吧。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111107
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 160111107,
					"content": "「…大团长，我们都在等您。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111108
					],
					"speakerTitle": "琴"
				},
				{
					"id": 160111108,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111109
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 160111109,
					"content": "嗯？…呵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111110
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 160111110,
					"content": "我这大团长，当得应该还不赖吧？…各位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111111
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 160111111,
					"content": "…那我就当你们是默认咯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111112
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 160111112,
					"content": "你们那时誓死拯救下来的事物…现在也都好好在那呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111113
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 160111113,
					"content": "嗯，骑士团、蒙德…还有骑士的誓言，我都会守护好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111114
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 160111114,
					"content": "所以…那封信，我会替你们送到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111115
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 160111115,
					"content": "…虽然只是「他」的倒影，但还有空的话，就替「他」读一读吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111116
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 160111116,
					"content": "——鲁斯坦和艾伦德林，都没忘记过你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111117
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 160111117,
					"content": "哈…这一趟走得还真远啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111118
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 160111118,
					"content": "剩下的就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111119
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 160111119,
					"content": "…「听凭风引」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111122
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 160111122,
					"content": "……！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111130
					],
					"speakerTitle": "诺艾尔"
				},
				{
					"id": 160111130,
					"content": "…哟，好久不见，诸位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111131
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 160111131,
					"content": "…能再见到你们，真是太好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111132
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 160111132,
					"content": "欢迎凯旋——大团长。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111133
					]
				},
				{
					"id": 160111133,
					"content": "…嗯，我回来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111123
					],
					"speakerTitle": "法尔伽"
