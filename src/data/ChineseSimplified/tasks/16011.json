			},
			"dialogs": [
				{
					"id": 160110201,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110202
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 160110202,
					"content": "…剑还完好无损？但感知不到上面的狼灵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110203
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 160110203,
					"content": "（…看来这里已经不是「现实」了，而是「北风」混杂「罗兰」的意识，构筑出的空间吧。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110204
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 160110204,
					"content": "后面没有退路，前面又是「狼口」…嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110205
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 160110205,
					"content": "——哈，就往里头走一遭吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "法尔伽"
				}
			]
		},
		{
			"id": 1601107,
			"completionStepIds": [
				1601107
