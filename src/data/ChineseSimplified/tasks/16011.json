					}
				]
			},
			"dialogs": [
				{
					"id": 160110701,
					"content": "这里…就是狼的「心」中？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110702
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 160110702,
					"content": "……！「罗兰」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "法尔伽"
				}
			]
		},
		{
			"id": 1601109,
			"completionStepIds": [
				1601109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1601109",
							"2"
						],
						"stepId": 1601109,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"罗兰"
				],
				"points": [
					{
						"sceneId": 20336,
						"position": [
							387.989,
							123.18,
							197.075
						],
						"pointId": 1
					},
					{
						"sceneId": 20336,
						"position": [
							387.824,
							111.946,
							237.497
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 160110901,
					"content": "…如你所愿，「北风骑士」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110902
					],
					"speakerTitle": "罗兰"
				},
				{
					"id": 160110902,
					"content": "哈，跟我想象的不太一样，你看起来好像没有「碎片」里记忆得那么疯狂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110903
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 160110903,
					"content": "我从未偏离过正确的道路。而你，现在的你不像是能屠龙的英雄，倒像个落魄骑士…流浪了太久。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110904
					],
					"speakerTitle": "罗兰"
				},
				{
					"id": 160110904,
					"content": "彼此彼此。看来咱们都不在自己最强的时刻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110905
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 160110905,
					"content": "「猎月人」的军势已经被击败，由深渊拟造出的「我」，自然也只是不完整的倒影。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110906
					],
					"speakerTitle": "罗兰"
				},
				{
					"id": 160110906,
					"content": "力量已臻「罗兰」的极致，心境却依然停滞于染血的时刻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110907
					],
					"speakerTitle": "罗兰"
				},
				{
					"id": 160110907,
					"content": "因此，「我」也同样不正确…而骑士不能容忍自身止步不前。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110908
					],
					"speakerTitle": "罗兰"
				},
				{
					"id": 160110908,
					"content": "将你从不公中救赎、引领你投效深渊后，我便会将自身匡正，继续践行骑士之道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110909
					],
					"speakerTitle": "罗兰"
				},
				{
					"id": 160110909,
					"content": "哈，这外头可经不起你继续折腾了…你的这份偏执倒是跟我想象的一样，看来我是没机会说服你了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110910
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 160110910,
					"content": "骑士信奉的美德不会为言语玷染，无论那言语多么高贵。你我都无法说服彼此，你也早已知晓这一点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110911
					],
					"speakerTitle": "罗兰"
				},
				{
					"id": 160110911,
					"content": "否则，你们又何必将一切希望，都系在玻瑞亚斯的「一念」之间？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110912
					],
					"speakerTitle": "罗兰"
				},
				{
					"id": 160110912,
					"content": "但如今你用以承载狼灵的剑刃早已崩毁，手中所执的不过是徒具其形的幻影。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110913
					],
					"speakerTitle": "罗兰"
				},
				{
					"id": 160110913,
					"content": "你已没有手段改变一切，也再无援军可以期待…此地即是你的「末路」，孤独的远征者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110914
					],
					"speakerTitle": "罗兰"
				},
				{
					"id": 160110914,
					"content": "呵，手段姑且不论，援军的话…这里不是还有一位吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110915
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 160110915,
					"content": "…什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110916
					],
					"speakerTitle": "罗兰"
				},
				{
					"id": 160110916,
					"content": "——我要说服的对象，从始至终就只有那一位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110917
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 160110917,
					"content": "这里是北风之魔神——安德留斯的「心」中，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110918
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 160110918,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110919
					],
					"speakerTitle": "安德留斯"
				},
				{
					"id": 160110919,
					"content": "——喂！听见了吗！安德留斯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110920
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 160110920,
					"content": "快醒醒吧！堂堂北风之魔神，还要被深渊控制多久！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110921
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 160110921,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110922
					],
					"speakerTitle": "安德留斯"
				},
				{
					"id": 160110922,
					"content": "如果这就是你最后的挣扎，那我很失望，「北风骑士」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110923
					],
					"speakerTitle": "罗兰"
				},
				{
					"id": 160110923,
					"content": "气势和愿望唤不来奇迹，这世界从不会那样仁慈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110924
					],
					"speakerTitle": "罗兰"
				},
				{
					"id": 160110924,
					"content": "…归去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110925
					],
					"speakerTitle": "安德留斯"
				},
				{
					"id": 160110925,
					"content": "…归于…地脉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110926
					],
					"speakerTitle": "安德留斯"
				},
				{
					"id": 160110926,
					"content": "……！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110927
					],
					"speakerTitle": "罗兰"
				},
				{
					"id": 160110927,
					"content": "…这就是「我」的选择…「我」的记忆…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110928
					],
					"speakerTitle": "安德留斯"
				},
				{
					"id": 160110928,
					"content": "…是「我」在旅途终点…找到的答案吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110929
					],
					"speakerTitle": "安德留斯"
				},
				{
					"id": 160110929,
					"content": "「安德{RUBY#[D]玻瑞亚斯}留斯」…你的信，我可好好送回到「你」心里了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110930
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 160110930,
					"content": "呵…「北风骑士」吗，看着吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110931
					],
					"speakerTitle": "安德留斯"
				},
				{
					"id": 160110931,
					"content": "…这就是「狼{RUBY#[S]我}」…唯一能为「人{RUBY#[S]你们}」做的事了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110932
					],
					"speakerTitle": "安德留斯"
				},
				{
					"id": 160110932,
					"content": "…代表地上的人类，向您致谢，群狼的领主。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110933
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 160110933,
					"content": "玻瑞亚斯…正在回归地脉。为什么？你的剑已经破碎，你明明已经没有任何承载灵魂的手段了。不，莫非…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110934
					],
					"speakerTitle": "罗兰"
				},
				{
					"id": 160110934,
					"content": "气势和愿望唤不来奇迹…这种事情我当然知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110935
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 160110935,
					"content": "…但从一开始，寄托灵魂的手段——就不止有「剑」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110936
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 160110936,
					"content": "…奔狼的领主，曾将灵魂的力量赋予麾下的群狼，强壮它们的心脏，锋利它们的爪牙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110937
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 160110937,
					"content": "…即便「我」无意于此，凡人的「心」，也将会被王狼的灵魂撕咬、吞噬、同化…一如强行混合的人群与狼群。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110938
					],
					"speakerTitle": "玻瑞亚斯"
				},
				{
					"id": 160110938,
					"content": "…以凡人的心脏，承载魔神的灵魂…这将会是一条无法回还的道路，但我不会劝阻一名骑士，踏上自己的征途。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110939
					],
					"speakerTitle": "「队长」"
				},
				{
					"id": 160110939,
					"content": "你的心脏、你的灵魂…也在一同崩解？…原来如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110940
					],
					"speakerTitle": "罗兰"
				},
				{
					"id": 160110940,
					"content": "「羔羊怎么将铃铛系到狼的心口」…你曾经这么问过对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110941
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 160110941,
					"content": "这就是我的答案——让狼自行吞下这颗「心脏」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110942
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 160110942,
					"content": "托付于剑上那部分狼灵不过是佯攻，真正的念想与记忆，是由你的心脏承载…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110943
					],
					"speakerTitle": "罗兰"
				},
				{
					"id": 160110943,
					"content": "为了不被我察觉，故意让王狼的灵魂与你同化，再被我吞噬…迄今为止，你都是承受着这样的重荷在战斗的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110944
					],
					"speakerTitle": "罗兰"
				},
				{
					"id": 160110944,
					"content": "比起王狼的决意…这点付出可算不了什么啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110945
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 160110945,
					"content": "顽强的意志，优秀的策略…但这不是骑士应有的战斗方式。正因如此，你的选择是错误的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110946
					],
					"speakerTitle": "罗兰"
				},
				{
					"id": 160110946,
					"content": "你的灵魂已同安德留斯融为一体。待它彻底将自身汇入地脉，你也会与它一同坠入其中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110947
					],
					"speakerTitle": "罗兰"
				},
				{
					"id": 160110947,
					"content": "届时，无论是巴巴托斯，还是你身边那位旅人，都已无法从地脉中锚定你的灵魂，更遑论将你救出。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110948
					],
					"speakerTitle": "罗兰"
				},
				{
					"id": 160110948,
					"content": "你输了，我也是。很遗憾，现在我已经无法拯救你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110949
					],
					"speakerTitle": "罗兰"
				},
				{
					"id": 160110949,
					"content": "…愿你的灵魂随北风安息，孤独的远征者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110950
					],
					"speakerTitle": "罗兰"
				},
				{
					"id": 160110950,
					"content": "…哈哈，孤独吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110951
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 160110951,
					"content": "抱歉啊——虽然我也曾经想过，和你同归于地脉的结局，是不是已经挺圆满了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110952
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 160110952,
					"content": "但可惜呀，跟当年的罗兰不一样，外面可还有美酒跟朋友，在盼着我凯旋呢，所以…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110953
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 160110953,
					"content": "——我还没打算认命！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110954
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 160110954,
					"content": "叮铃——有你的来信~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "温迪"
				}
			]
		},
