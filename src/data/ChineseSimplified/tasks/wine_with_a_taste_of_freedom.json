					"德贵"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223030101,
					"content": "生意真是越来越难做了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030102
					],
					"speakerTitle": "德贵"
				},
				{
					"id": 223030102,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223030103
					]
				},
				{
					"id": 223030103,
					"content": "嗯？哦，我说我这家酒馆的生意越来越难做了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030104
					],
					"speakerTitle": "德贵"
				},
				{
					"id": 223030104,
					"content": "我们这种管吃喝的店，开的时间长了有好有不好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030105
					],
					"speakerTitle": "德贵"
				},
				{
					"id": 223030105,
					"content": "好的是，时间长了总有名声，名声大了，自然有钱赚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030106
					],
					"speakerTitle": "德贵"
				},
				{
					"id": 223030106,
					"content": "坏的就是，吃喝总是会腻的，要是铺子大，品类多倒也没问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030107
					],
					"speakerTitle": "德贵"
				},
				{
					"id": 223030107,
					"content": "可是我这小酒馆，又不是什么大铺面的大店子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030108
					],
					"speakerTitle": "德贵"
				},
				{
					"id": 223030108,
					"content": "主顾们吃太长时间渐渐觉着腻味，来得也越来越少，唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030109
					],
					"speakerTitle": "德贵"
				},
				{
					"id": 223030109,
					"content": "我听说，蒙德城的酒业也很发达。他们用蒲公英酿造的「蒲公英酒」很有名。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030110
					],
					"speakerTitle": "德贵"
				},
				{
					"id": 223030110,
					"content": "虽然不知道蒲公英到底能不能用来酿酒，但我也只能试试看了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030111
					],
					"speakerTitle": "德贵"
				},
				{
					"id": 223030111,
					"content": "你能帮我去蒙德一趟，带点蒲公英回来吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030112,
						223030114
					],
					"speakerTitle": "德贵"
				},
				{
					"id": 223030112,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223030113
					]
				},
				{
					"id": 223030113,
					"content": "那就拜托你了，我会付你报酬的。我们璃月人，说到做到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "德贵"
				},
				{
					"id": 223030114,
					"content": "蒲公英酒吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223030115
					]
				},
				{
					"id": 223030115,
					"content": "怎么？是酒的口味很怪吗？我听说，这种酒很受蒙德人欢迎啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030116
					],
					"speakerTitle": "德贵"
				},
				{
					"id": 223030116,
					"content": "不过，我要只是照搬蒲公英酒的方子，肯定也卖不动…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030117
					],
					"speakerTitle": "德贵"
				},
				{
					"id": 223030117,
					"content": "您先把<color=#00E1FFFF>蒲公英</color>拿来吧，我再看看怎么用璃月的法子来酿造酿造。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "德贵"
				}
			]
		},
