	"talks": [
		{
			"id": 7066401,
			"completionStepIds": [
				7066401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7066401",
							"2"
						],
						"stepId": 7066401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"宏朗"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706640101,
					"content": "每次都派我来解决这种麻烦事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640102,
						706640103
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640102,
					"content": "咦？你是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706640104
					]
				},
				{
					"id": 706640104,
					"content": "是你啊！这可真是太巧了，没想到会在这里遇见你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640105
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640105,
					"content": "你在这里做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706640106
					]
				},
				{
					"id": 706640106,
					"content": "唉，别提了。你还记得上次那个奇怪的秘境吧？就是…就是那个内部结构会随人心意变化的秘境。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640107
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640107,
					"content": "多亏了你帮我进入那个秘境探索，我才获得了不少的情报。在那个秘境消失之后，我就回去向岚姐复命了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640108
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640108,
					"content": "我反复和她说，这件事都是多亏了你帮忙，我只是做了一点微不足道的辅助工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640109
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640109,
					"content": "但岚姐根本不听我的，还说什么她很认可我的工作，然后要我带一队人继续负责探索这类未知的秘境。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640110,
						706640111
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640110,
					"content": "听上去不错啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706640112
					]
				},
				{
					"id": 706640112,
					"content": "好什么啊。我原本就是一个普普通通的冒险家，无拘无束，爱干嘛就干嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640113
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640113,
					"content": "虽然之前是赚得少了点，但胜在自由啊。现在岚姐给我安了这么个头衔，我推也推不掉，唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640114
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640114,
					"content": "先不说这些，我们说正事。你看见我旁边这道门了吗？门后也是一个奇怪的秘境。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640115
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640115,
					"content": "这个秘境里面，布满了「风场」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640116
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640116,
					"content": "是我理解的那种「风场」吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706640117
					]
				},
				{
					"id": 706640117,
					"content": "对，就是野外那种…呼呼呼吹来吹去的风场，冒险家们使用风之翼的时候，经常借助它们飞得更高。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640118
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640118,
					"content": "不过这座秘境里的「风场」的分布十分混乱，有些风场发出的风甚至会彼此冲撞，形成一个阻飞区。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640119
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640119,
					"content": "我请了几位擅长操控风之翼的冒险家进去探索，但他们都没有探索多远就被迫退了回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640120
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640120,
					"content": "据他们说，这座秘境里还分布着一些机关。在启动这些机关后，一些风场的状态好像也发生了变化…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640121
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640121,
					"content": "但还没等他们弄清楚那些机关的具体用途，大量的魔物就突然出现，他们只能撤退了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640122
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640122,
					"content": "我们讨论之后认为，如果能活用这些机关，也许就能更加顺利地探索这座秘境…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640123,
						706640124
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640123,
					"content": "你进去探索过吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706640125
					]
				},
				{
					"id": 706640125,
					"content": "哎呀，你又不是不知道，我那个…身体素质不太行，也不太会操纵风之翼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640126
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640126,
					"content": "一般的飞行行动我倒是能够应付，但以这座秘境里的风场分布情况…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640127
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640127,
					"content": "如果我进去探索，大概只会被吹得漫天乱飞，然后再一头扎进魔物堆里吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640128
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640128,
					"content": "旅行者，我上次见识过你的实力。你的体力不错，头脑也很灵活…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640129
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640129,
					"content": "如果你愿意的话，能再帮忙我探索一下这座秘境吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640130
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640130,
					"content": "报酬的话你不用担心，和上次一样，我保证给你备足报酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640131,
						706640133
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640131,
					"content": "那我试试。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706640132
					]
				},
				{
					"id": 706640132,
					"content": "太好了，那就拜托你了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640133,
					"content": "里面有宝物吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706640134
					]
				},
				{
					"id": 706640134,
					"content": "这我可说不准，毕竟我们还没有在这秘境里探索多远…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640135
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640135,
					"content": "呃…放心！如果你在探索的过程里发现了任何宝物，都可以直接收下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640136
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640136,
					"content": "那就拜托你了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640124,
					"content": "你没有打头阵吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706640125
					]
				},
				{
					"id": 706640111,
					"content": "这应该是好事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706640112
					]
				},
				{
					"id": 706640103,
					"content": "又见面了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706640104
					]
				}
			]
		}
	]
}