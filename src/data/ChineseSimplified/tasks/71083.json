			"dialogs": [
				{
					"id": 710830101,
					"content": "没想到你们真的破坏了「七星阵法」，看来我必须要写进周报了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830102
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710830102,
					"content": "写帅气一点。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830103
					]
				},
				{
					"id": 710830103,
					"content": "咳…你们严肃一点，这件事情很严重。具体严重程度，最后可是会由「七星」来亲自定夺的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830104
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710830104,
					"content": "也就是说，等我的报告交上去了，说不定会惊动「七星」的老人家们亲自来这里阻止你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830105
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710830105,
					"content": "哼，到那时候，就算我也没办法保你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830106
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710830106,
					"content": "（提示也太明显了…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830107
					]
				},
				{
					"id": 710830107,
					"content": "哼…被吓住了吧？好了好了，还有人在等你呢，快走吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "沐宁"
				}
			]
		},
