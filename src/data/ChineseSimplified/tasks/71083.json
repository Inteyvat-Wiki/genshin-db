			"dialogs": [
				{
					"id": 710830201,
					"content": "下面情况如何了？有遇到什么危险吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830202,
						710830210
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710830202,
					"content": "（向沐宁描述一番）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830203
					]
				},
				{
					"id": 710830203,
					"content": "原来是这样，听起来还挺危险的。瑾武姐还有志琼，可就拜托你多费心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830204
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710830204,
					"content": "你不是应该阻止我吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830205
					]
				},
				{
					"id": 710830205,
					"content": "我当然有义务阻止你，只不过你每次都跑得太快，我追不上，所以没法阻止。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830206
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710830206,
					"content": "我没有跑很快。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830207
					]
				},
				{
					"id": 710830207,
					"content": "不，你就是跑得很快，周报里就是这么写的，这就是事实。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830208
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710830208,
					"content": "好的，我跑得很快。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830209
					]
				},
				{
					"id": 710830209,
					"content": "嗯，所以，还请一切小心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710830210,
					"content": "一切顺利。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830211
					]
				},
				{
					"id": 710830211,
					"content": "那就好，那就好，只要没出事，「七星」也不会怪罪得太厉害吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "沐宁"
