			"dialogs": [
				{
					"id": 207040401,
					"content": "(test) 姥姥现在种璃月百合是为什么什么嘛？$UNRELEASED",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207040402
					]
				},
				{
					"id": 207040402,
					"content": "(test) 也许有一天，我的那些离开璃月港很久的老朋友会从远方回来$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207040403
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 207040403,
					"content": "(test) 那时候，他们也会想看看他们熟悉的花吧$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "萍姥姥"
				}
			]
