						"position": [
							3521.644,
							207.707,
							-346.917
						],
						"pointId": 16317
					}
				]
			},
			"dialogs": [
				{
					"id": 700820101,
					"content": "奥多夫！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700820102,
					"content": "#嘿，派蒙，还有{NICKNAME}…感谢你们帮的忙，这下温斯洛再也不会嚷嚷着要把那些对抗深渊的骑士们的墓迁走啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820103
					],
					"speakerTitle": "奥多夫"
				},
				{
					"id": 700820103,
					"content": "说起这件事，我还觉得奇怪呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700820104,
					"content": "那些弄出风来的只是狂风之核，结果你非在温斯洛面前说是骑士团的幽灵作祟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700820105,
					"content": "「幽灵」其实不是别人…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700820106
					]
				},
				{
					"id": 700820106,
					"content": "「幽灵」就是你，奥多夫。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700820107
					]
				},
				{
					"id": 700820107,
					"content": "咦，是这样吗，可是他刚刚还喝了一口啤酒，幽灵能喝啤酒吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700820108,
					"content": "此「幽灵」非彼幽灵，啊呀，我以为我藏得很好呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820109
					],
					"speakerTitle": "奥多夫"
				},
				{
					"id": 700820109,
					"content": "…欸，难道说…其实一开始就没有什么幽灵，其实都是奥多夫搞的鬼吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700820110,
					"content": "我第一次觉得「搞的鬼」这个修辞很贴切。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820111
					],
					"speakerTitle": "奥多夫"
				},
				{
					"id": 700820111,
					"content": "我调整过了机关，然后弄了点能够引诱元素生物的诱导素，我一开始只是想稍微吓吓温斯洛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820112
					],
					"speakerTitle": "奥多夫"
				},
				{
					"id": 700820112,
					"content": "如果只是来了些风史莱姆，过个几天就自己跑光了…正好至冬那边来了生意，我以为我回来的时候这事儿说不定都结束了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820113
					],
					"speakerTitle": "奥多夫"
				},
				{
					"id": 700820113,
					"content": "结果引来了狂风之核…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700820114
					]
				},
				{
					"id": 700820114,
					"content": "对，这就让问题复杂了很多，我只是不想让他迁那些墓，并不想让他变成那样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820115
					],
					"speakerTitle": "奥多夫"
				},
				{
					"id": 700820115,
					"content": "所以我…看到你们出现的时候真是感谢风神保佑了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820116
					],
					"speakerTitle": "奥多夫"
				},
				{
					"id": 700820116,
					"content": "咦，那如果我们没来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700820117,
					"content": "那我会去试试赶跑那个狂风之核，或者把真相告诉骑士团的人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820118
					],
					"speakerTitle": "奥多夫"
				},
				{
					"id": 700820118,
					"content": "但知道真相的温斯洛可能会大发雷霆，说不定会把墓碑都砸了，他就是那样性格的人，这么多年了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820119
					],
					"speakerTitle": "奥多夫"
				},
				{
					"id": 700820119,
					"content": "#所以帮了大忙了，{NICKNAME}和派蒙，我代表那些抗击深渊时牺牲在这里的西风骑士感谢你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820120
					],
					"speakerTitle": "奥多夫"
				},
				{
					"id": 700820120,
					"content": "唔，虽然感觉很奇怪，但是从结果上来说也还是做了好事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700820121,
					"content": "哈哈哈，是的，啊呀，要怪就怪我吧…「能挡住一切鬼祟的其实只有宽阔的胸怀和坦荡的心灵」…但我也没能做到这一点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820122
					],
					"speakerTitle": "奥多夫"
				},
				{
					"id": 700820122,
					"content": "知道道理和践行总归是两码事嘛，不过我也有在反省了。风神在上如有所知，就饶过我这一回吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奥多夫"
				}
			]
		}
	]
}