			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙",
					"艾方索"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730800101,
					"content": "（一起揪出维摩庄的「坏人」吧。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800102
					]
				},
				{
					"id": 730800102,
					"content": "你好，艾方索！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730800103,
					"content": "#是你们啊。{NICKNAME}，有什么事吗？如果是找拉娜的话，她已经走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800104
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800104,
					"content": "想和你讨论一下——",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800105
					]
				},
				{
					"id": 730800105,
					"content": "潜伏在维摩庄的「坏人」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800106
					]
				},
				{
					"id": 730800106,
					"content": "#毕竟，{NICKNAME}答应了拉娜，会处理坏人，她才安心去旅行的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730800107,
					"content": "…这样啊。我明白了，虽然我没什么头绪，但想问什么，就尽管问吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800108
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800108,
					"content": "首先，一起整理一下情况吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800109
					]
				},
				{
					"id": 730800109,
					"content": "那么…维摩庄里，第一个走失的孩子是谁来着？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800110,
						730800111,
						730800113,
						730800116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730800110,
					"content": "素达蓓。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800119
					]
				},
				{
					"id": 730800119,
					"content": "嗯，我想起来了，应该是素达蓓！她听人说森林里有药草，对阿玛兹亚爷爷的眼睛好，就偷偷跑到森林里去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730800120,
					"content": "确实是这样。当时，我们都很担心，所以组织了搜救队进入森林。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800121
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800121,
					"content": "啊，想起来了！拉娜说过，搜救队是你组织的！而且，还带着咖喱去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730800122,
					"content": "药草的事情，是谁跟素达蓓说的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800123
					]
				},
				{
					"id": 730800123,
					"content": "…是我。素达蓓是好孩子，很关心阿玛兹亚爷爷的事情。有一次，和她聊天的时候，我记得提过这件事情。但是我也说了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800124
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800124,
					"content": "嗯，我知道！素达蓓说过，你要她别随便到森林里去。只能说，素达蓓真的很关心阿玛兹亚爷爷…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730800125,
					"content": "…还有什么要问的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800126
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800126,
					"content": "唔…接下来，第二个走失的是谁来着？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800127,
						730800128,
						730800130,
						730800132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730800127,
					"content": "卡乌斯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800135
					]
				},
				{
					"id": 730800135,
					"content": "卡乌斯…他说要去森林里找「朋友」商量妹妹失踪的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800136
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800136,
					"content": "对，跟卡乌斯讲故事的时候，他好像也说过！艾方索，你知道卡乌斯的朋友是谁吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800137
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730800137,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800138
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800138,
					"content": "我怎么会知道。在森林里，我没找到卡乌斯和卡乌斯的朋友。如你们所知，他也和素达蓓一样，突然回来了，什么都不记得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800139
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800139,
					"content": "还有什么问题吗？之后，就没有孩子失踪了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800140
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800140,
					"content": "派蒙，你来说吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800141
					]
				},
				{
					"id": 730800141,
					"content": "欸？好的…咳咳，应该这么说，接下来要走丢的，本来是优丹。但我们和拉娜碰巧遇到他，所以把他救回来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800142
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730800142,
					"content": "事情是怎么发生的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800143
					]
				},
				{
					"id": 730800143,
					"content": "嗯…我记得，按照他的说法是…他听艾方索说，森林的洞窟里有很大的蘑菇，就想要采给拉娜吃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800144
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730800144,
					"content": "结果，路上有愚人众的坏蛋跟踪他，他很害怕，就一直逃跑，结果被困在了死域里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800145
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730800145,
					"content": "啊？他竟然到死域里去了…这种事情，他都没跟我说过！真是太危险了，怎么会这样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800146
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800146,
					"content": "#不对…既然他误入死域，又是怎么平安回来的？即使{NICKNAME}没有神之眼也能驱使元素的力量，也…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800147
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800147,
					"content": "（嗯…兰拉娜的事情，能跟艾方索说吗？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800148,
						730800149
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730800148,
					"content": "（没关系。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800150
					]
				},
				{
					"id": 730800150,
					"content": "…艾方索，虽然你可能很难相信，不过森林里有一种叫「兰那罗」的精灵。优丹他们和兰那罗是朋友，所以兰那罗帮助了他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800151
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730800151,
					"content": "兰那罗啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800152
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800152,
					"content": "不过，愚人众真的好可恶，居然连小孩子都不放过！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800153
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730800153,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800154
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800154,
					"content": "唔…这样梳理下来，也不知道潜伏在维摩庄的坏人是谁呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800155
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730800155,
					"content": "派蒙，那边好像有人在监视我们。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800156
					]
				},
				{
					"id": 730800156,
					"content": "欸？在哪？该不会就是我们要找的坏人吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800157
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730800157,
					"content": "你帮忙看看吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800158
					]
				},
				{
					"id": 730800158,
					"content": "我自己去…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800159,
						730800160
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730800159,
					"content": "如果发现什么，就大喊。我马上来。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800161
					]
				},
				{
					"id": 730800161,
					"content": "#哼，好吧。总是什么事都交给{NICKNAME}也不是办法，这回我也要帮忙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800162
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730800162,
					"content": "派蒙很有干劲地离开了。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730800163
					]
				},
				{
					"id": 730800163,
					"content": "何必多此一举？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800164,
						730800165
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800164,
					"content": "她不知道的话，会开心一点。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800166
					]
				},
				{
					"id": 730800166,
					"content": "我们换个地方说话吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800165,
					"content": "有的事情，没必要让她知道。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800166
					]
				},
				{
					"id": 730800160,
					"content": "你又能飞，身材又小，适合侦察。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800161
					]
				},
				{
					"id": 730800149,
					"content": "（应该让他知道。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800150
					]
				},
				{
					"id": 730800128,
					"content": "素达蓓。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800129
					]
				},
				{
					"id": 730800129,
					"content": "不对不对，我们不是刚刚才聊完素达蓓的事情吗？我记得，是她的哥哥…是叫卡乌斯对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730800130,
					"content": "优丹。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800131
					]
				},
				{
					"id": 730800131,
					"content": "不对吧？优丹走失的时候，是我们一起救了他…我记得，第二个应该是素达蓓的哥哥，卡乌斯吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730800132,
					"content": "畅畅。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800133
					]
				},
				{
					"id": 730800133,
					"content": "等等，畅畅不是在璃月吗…？这和畅畅有什么关系啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730800134,
					"content": "#…你没问题吧，{NICKNAME}？我记得，第二个应该是素达蓓的哥哥，应该是叫卡乌斯，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730800111,
					"content": "卡乌斯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800112
					]
				},
				{
					"id": 730800112,
					"content": "是素达蓓吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800119
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800113,
					"content": "优丹。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800114
					]
				},
				{
					"id": 730800114,
					"content": "不对吧！优丹是最后一个走失的才对…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730800115,
					"content": "是素达蓓吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800119
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800116,
					"content": "提米。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800117
					]
				},
				{
					"id": 730800117,
					"content": "提米？不对，这和提米没有关系吧！他不是在蒙德吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730800118,
					"content": "提米是谁呀…第一个走失的，是素达蓓才对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800119
					],
					"speakerTitle": "艾方索"
				}
			]
		},
		{
			"id": 7308002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7308002",
							"2"
						],
						"stepId": 7308002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"艾方索"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730800201,
					"content": "你是从什么时候开始怀疑我的？是因为素达蓓和优丹提到我的事情吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800202
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800202,
					"content": "你知道我的名字。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800203
					]
				},
				{
					"id": 730800203,
					"content": "拉娜没有对你介绍过我的名字。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800204
					]
				},
				{
					"id": 730800204,
					"content": "或许存在着这样的可能性：我的耳朵很好，拉娜向阿玛兹亚爷爷介绍你的时候，我听见了你的名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800205
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800205,
					"content": "她没有对阿玛兹亚爷爷介绍过名字。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800206
					]
				},
				{
					"id": 730800206,
					"content": "…我大意了。但是，在整个提瓦特，信息流通率高的组织除了愚人众，还有冒险家协会。为什么你不认为我是个冒险家呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800207,
						730800210
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800207,
					"content": "你似乎对我的情况也很了解。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800208
					]
				},
				{
					"id": 730800208,
					"content": "知道我没有神之眼也能驱使元素。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800209
					]
				},
				{
					"id": 730800209,
					"content": "你在各地冒险的事迹很有名。不一定非得是愚人众，才知道吧…归根到底，你还是没有实际的证据，证明我是愚人众。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800212
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800212,
					"content": "没错。但这不重要。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800213
					]
				},
				{
					"id": 730800213,
					"content": "你说得对。只有律法重视「证据」。而机敏的猎犬，明白只要追踪可疑的气味，就能找到猎物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800214
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800214,
					"content": "当然，聪明的猎犬，会避开自己不该闻的气味，以免在踪迹的末尾遇见恶龙。但是，从你的事迹来看，你不是明哲保身的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800215
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800215,
					"content": "你特地警告过拉娜，请她不要巡林…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800216
					]
				},
				{
					"id": 730800216,
					"content": "是希望她不要阻挠愚人众的行动。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800217
					]
				},
				{
					"id": 730800217,
					"content": "…这是一方面。但更重要的是，我不希望她因此受伤。别的愚人众和我不同，对她、对维摩庄没有感情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800218
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800218,
					"content": "「艾方索」，你究竟是谁？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800219
					]
				},
				{
					"id": 730800219,
					"content": "我的血亲为我起的名字，已经失落在冰雪之中。「壁炉之家」赋予我的名字是特洛芬·雪奈茨维奇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800220
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800220,
					"content": "壁炉之家的雪奈茨维奇…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800221
					]
				},
				{
					"id": 730800221,
					"content": "…看你的反应，似乎有些眉目。你应该遇到过我的「兄弟姐妹」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800222
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800222,
					"content": "啊，不要告诉我遇见了谁，也不要告诉我他们的情况。既然他们对你暴露了身份…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800223
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800223,
					"content": "如果如今情况安好，那他们想必已经背叛了陛下。如果已经殒命…我不想听到这样的消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800224
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800224,
					"content": "壁炉之家是「仆人」大人设立的福利院。生活在壁炉之家的孩子，是没有血亲的。但是，我们有更加宝贵的「兄弟姐妹」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800225
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800225,
					"content": "到岁数后，有资质的孩子就会被训练成特务，然后潜伏在各个地方，等待命令。不幸的是，我被认为是「有资质的孩子」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800226
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800226,
					"content": "你的命令是什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800227
					]
				},
				{
					"id": 730800227,
					"content": "捕获「兰那罗」。这是「博士」大人的命令，为了研究兰那罗与梦境、死域的联系。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800228
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800228,
					"content": "将「梦」与「死域」兵器化，似乎是他的研究课题之一。当然了，我和你所击败的愚人众同士，则是他的「研究资源」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800229
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800229,
					"content": "我们是见不到兰那罗的。但卡乌斯、素达蓓、优丹他们…他们有与兰那罗成为朋友的资格。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800230
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800230,
					"content": "你让愚人众拐走孩子，引出兰那罗。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800231
					]
				},
				{
					"id": 730800231,
					"content": "没错。兰那罗确实出现了。但兰那罗的力量果真神奇，竟然能从看守严密的营地里，在不惊动任何人的情况下，将他们救走…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800232
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800232,
					"content": "「博士」大人真是，看上了不得了的东西呢。哈哈哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800233
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800233,
					"content": "#我也有问题想要问你，{NICKNAME}。为什么兰那罗要将卡乌斯和素达蓓被拐走、又被救走的记忆消除？是害怕暴露自己吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800234
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800234,
					"content": "兰拉娜不希望孩子们记住这些事情。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800235
					]
				},
				{
					"id": 730800235,
					"content": "不希望他们长大后成为施暴的一方。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800236
					]
				},
				{
					"id": 730800236,
					"content": "这样啊…那个兰那罗，原来是叫「兰拉娜」吗？和拉娜的名字很像，是个好名字。有机会的话，请帮我传达一句「谢谢」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800237
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800237,
					"content": "为什么要道谢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800238
					]
				},
				{
					"id": 730800238,
					"content": "维摩庄就像真正的家一样。拉娜和优丹，在我看来，就像我本应拥有的亲人…卡乌斯和素达蓓，也是我宝贵的弟弟妹妹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800239
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800239,
					"content": "我希望他们能健康长大，变成正直而善良的大人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800240
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800240,
					"content": "所以，虽然在我的「工作」上，给我增添了许多困扰，但我很感谢兰拉娜所作的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800241
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800241,
					"content": "…啊，我终于明白了。就像你支开派蒙一样，孩子们不应该知道这些阴暗龌龊的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800242
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800242,
					"content": "「少年人，你在孩童时应当快乐，使你的心欢畅，行你所愿行的，见你所乐见的。然而也应当记住黑暗的时日…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800243
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800243,
					"content": "…这是壁炉之家的教导。因为大人一定会面对黑暗，所以在幼年时就应当有所准备。这样，才能保护好自己与珍惜的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800244
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800244,
					"content": "或许你们的做法也有其道理。假如我没有在壁炉之家长大，成为驻维摩庄的特务…假如我出生在维摩庄，那就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800245
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800245,
					"content": "说这些没有任何意义。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800246
					]
				},
				{
					"id": 730800246,
					"content": "我明白，我只是感到遗憾。我希望我一直都是「艾方索」，而不是「特洛芬·雪奈茨维奇」。我希望我能成为优丹真正的哥哥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800247
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800247,
					"content": "我想当一个好人，但我是属于组织的人。我想成为拉娜的家人、孩子们的家人，但我已经有一个无法背叛的「家」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800248
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800248,
					"content": "有许多同伴，有足以匹敌执行官大人的实力，又不属于任何一城一国，连身为骑士也只是自由的荣誉骑士的你，是不能理解吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800249,
						730800251
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800249,
					"content": "我理解你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800250
					]
				},
				{
					"id": 730800250,
					"content": "但你所作的，不会被原谅。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800253
					]
				},
				{
					"id": 730800253,
					"content": "那么，该说的都说完了。你要怎么处置我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800254,
						730800262
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800254,
					"content": "别再靠近维摩庄，别再让我见到你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800255
					]
				},
				{
					"id": 730800255,
					"content": "…这样吗。我明白了，我不会再出现在你面前。我也不会回到愚人众的势力内，因为我的任务失败了，会为「兄弟姐妹」蒙羞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800256
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800256,
					"content": "优丹会一直等着「艾方索哥哥」回来吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800257,
						730800259
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800257,
					"content": "你走吧。派蒙该来找我们了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800258
					]
				},
				{
					"id": 730800258,
					"content": "再见。不，永别了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800259,
					"content": "（战斗）我改变主意了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800260
					]
				},
				{
					"id": 730800260,
					"content": "#适合恶徒的结局，我已经看到了…但我不会坐以待毙的。就算你是{NICKNAME}，就算我没有任何胜算，我也会放手一战。因为…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800261
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800261,
					"content": "我是善中之恶、药中之毒、羔羊中的狼、金杯中的水银…我名为雪奈茨维奇。来吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800262,
					"content": "（战斗）我与兰拉娜有一个约定…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800263
					]
				},
				{
					"id": 730800263,
					"content": "一定要惩罚恶徒。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800264
					]
				},
				{
					"id": 730800264,
					"content": "#适合恶徒的结局，我已经看到了…但我不会坐以待毙的。就算你是{NICKNAME}，就算我没有任何胜算，我也会放手一战。因为…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800265
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800265,
					"content": "我是善中之恶、药中之毒、羔羊中的狼、金杯中的水银…我名为雪奈茨维奇。来吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾方索"
				},
				{
