			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741520101,
					"content": "#{NICKNAME}，你是不是想到什么了？$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741520102,
						741520104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741520102,
					"content": "这对夫妇不对劲。$UNRELEASED",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741520103
					]
				},
				{
					"id": 741520103,
					"content": "我也觉得有点奇怪，他们一个话特别多，一个话特别少。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741520104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741520104,
					"content": "他们出现的时机太巧合了。$UNRELEASED",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741520105,
						741520107,
						741520108,
						741520109,
						741520116,
						741520122
					]
				},
				{
					"id": 741520105,
					"content": "你的意思是，就在伯努瓦想要招募钟点工照顾自己的时候，他们出现了。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741520106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741520106,
					"content": "记得欧芙小姐说过，大半年之前伯努瓦还需要招募钟点工照顾自己，仅仅是半年时间…$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741520107,
						741520108,
						741520109,
						741520116,
						741520122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741520107,
					"content": "这对夫妇出现并成为了他的养女和女婿。$UNRELEASED",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741520107,
						741520108,
						741520109,
						741520116,
						741520122
					]
				},
				{
					"id": 741520108,
					"content": "你说的对。一切都好刻意，这么一想，这对夫妇很有问题欸！$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741520123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741520123,
					"content": "#{NICKNAME}，你说，伯努瓦他是不是陷入了什么危险？$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741520124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741520124,
					"content": "没错。$UNRELEASED",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741520125
					]
				},
				{
					"id": 741520125,
					"content": "我感觉很不好，我们要不要去报案啊？去和执律庭说一说吧。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741520126,
						741520127,
						741520128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741520126,
					"content": "没有证据。$UNRELEASED",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741520129
					]
				},
				{
					"id": 741520129,
					"content": "这样啊，你说的也有道理。总之，我们是要帮助伯努瓦的对吧？$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741520130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741520130,
					"content": "小茉莉拜托过我们，要告诉伯努瓦，他给的点心非常好吃，我们答应过她的。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741520131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741520131,
					"content": "我们会做到的。$UNRELEASED",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741520132
					]
				},
				{
					"id": 741520132,
					"content": "我就知道你说到做到，而且脑子好使，那我们接下来怎么做？$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741520133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741520133,
					"content": "去调查一番吧。$UNRELEASED",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741520134
					]
				},
				{
					"id": 741520134,
					"content": "就由我们来弄清楚到底发生了什么吧！唔…具体来说，我们要调查些什么啊？$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741520135,
						741520136,
						741520137
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741520135,
					"content": "这对夫妇的身份。$UNRELEASED",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741520138
					]
				},
				{
					"id": 741520138,
					"content": "#对对对，真相就由我们来揭穿吧！名侦探派蒙、{NICKNAME}出动！$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741520136,
					"content": "这对夫妇的目的。$UNRELEASED",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741520138
					]
				},
				{
					"id": 741520137,
					"content": "伯努瓦对他们的态度。$UNRELEASED",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741520138
					]
				},
				{
					"id": 741520127,
					"content": "事情还不明朗。$UNRELEASED",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741520129
					]
				},
				{
					"id": 741520128,
					"content": "不知道伯努瓦的态度。$UNRELEASED",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741520129
					]
				},
				{
					"id": 741520109,
					"content": "这对夫妇和伯努瓦的关系不对劲。$UNRELEASED",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741520110
					]
				},
				{
					"id": 741520110,
					"content": "前些天遇到的时候他们还和和睦睦的呢，今天看他们交谈的时候总觉得哪里有点便扭…$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741520111,
						741520113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741520111,
					"content": "伯努瓦在被女婿胁迫。$UNRELEASED",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741520112
					]
				},
				{
					"id": 741520112,
					"content": "是因为他才说了两句话，那个女婿就使眼色让他进去吗？$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741520115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741520115,
					"content": "听你这么分析，我有点明白心里那个困惑的感觉是怎么回事了。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741520123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741520113,
					"content": "伯努瓦在被女儿胁迫。$UNRELEASED",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741520114
					]
				},
				{
					"id": 741520114,
					"content": "我是没你想得这么远啦，只是觉得那个女儿说话的时候，我有点起鸡皮疙瘩…$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741520115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741520116,
					"content": "这对夫妇对待外人的态度不对劲。$UNRELEASED",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741520117
					]
				},
				{
					"id": 741520117,
					"content": "就是就是，明明刚见面的时候他们都可亲切了，怎么没过多久就变成这副凶巴巴的样子了。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741520118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741520118,
					"content": "他们只在父亲面前对我们友善。$UNRELEASED",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741520119
					]
				},
				{
					"id": 741520119,
					"content": "唔…我回忆一下。是哦，第一次见面的时候，伯努瓦刚进门，那个女婿就凶巴巴地让我们不要再来了。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741520120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741520120,
					"content": "他们在伪装。$UNRELEASED",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741520121
					]
				},
				{
					"id": 741520121,
					"content": "他们为什么要在自己的父亲面前装出这副善良的样子呢？总得有个原因吧，为什么啊，想不明白。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741520123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741520122,
					"content": "暂时能想到的就是这些。$UNRELEASED",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741520123
					]
				}
			]
		},
