			"dialogs": [
				{
					"id": 721700101,
					"content": "这可下不去啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700102
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 721700102,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700103
					]
				},
				{
					"id": 721700103,
					"content": "旅行者，又见面了。我们正在想怎么…潜进前面的水里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700104
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 721700104,
					"content": "然后，去里面取一点新鲜的海草来，做一种叫做「饭团」的食物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700105,
						721700107
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 721700105,
					"content": "在海边取就好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700106
					]
				},
				{
					"id": 721700106,
					"content": "那种在海边的海草都不太新鲜，用来做菜总感觉少点味道啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700109
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 721700109,
					"content": "我向城里的人打听过了，这里底下生长着一些品质很不错的海草。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700110
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 721700110,
					"content": "不过今天一来…就看见这里完全被海水淹没了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700111
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 721700111,
					"content": "而且我们三个都…完全不会潜水，只能在这里傻傻看着…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700112
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 721700112,
					"content": "周围有什么机关吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700113
					]
				},
				{
					"id": 721700113,
					"content": "那边有一个机关喔！不过…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700114
					],
					"speakerTitle": "朱莉"
				},
				{
					"id": 721700114,
					"content": "不过那个机关，又被罩在那种屏障里面了，根本进不去啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700115
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 721700115,
					"content": "唉，我们继续在这里琢磨一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700116
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 721700116,
					"content": "旅行者，要是你知道怎么解决这个问题，就请快点过来告诉我们吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700117
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 721700117,
					"content": "当然啦，如果你能直接把那些海草拿过来的话就更好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700118
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 721700118,
					"content": "旭东先生？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700119
					],
					"speakerTitle": "芭尔瓦涅"
				},
				{
					"id": 721700119,
					"content": "咳！要是你能直接把那些海草拿来的话，那报酬肯定少不了你的，还有一顿饭团大餐奉上！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700120
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 721700120,
					"content": "饭团到底怎么能称得上是「大餐」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700121
					],
					"speakerTitle": "芭尔瓦涅"
				},
				{
					"id": 721700121,
					"content": "哎呀，只要数量够多就行了…咳，我们还是接着琢磨吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "旭东"
				},
				{
					"id": 721700107,
					"content": "一定要潜进去吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700108
					]
				},
				{
					"id": 721700108,
					"content": "那种在海边就能采到的海草都不太新鲜，用来做菜总感觉少点味道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700109
					],
					"speakerTitle": "旭东"
				}
			]
		},
