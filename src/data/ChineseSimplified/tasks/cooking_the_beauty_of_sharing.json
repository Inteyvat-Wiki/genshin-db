			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"兰非拉",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730220601,
					"content": "唔…这就开始用「鲜嫩无朋之果」来做料理吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220602
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220602,
					"content": "这个「鲜嫩无朋之果」，到底和普通的果子有什么区别呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220603
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220603,
					"content": "我知道的。在那菈看来，果实都一样。但其实，是不同的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220604
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220604,
					"content": "「鲜嫩无朋之果」，是强壮的树才能结出来的。强壮的树，当风吹来的时候，会率先唱歌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220605
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220605,
					"content": "强壮的树生出的孩子，就是给我们的恩惠。也就是「鲜嫩无朋之果」。那菈朋友说，这种果子在肚子里就像会唱歌一样好吃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220606
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220606,
					"content": "好期待啊，用这个果子，能做出什么样的美味！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220607
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220607,
					"content": "兰非拉立刻进行了烹饪…\\n他将手中的果子分成数份…\\n随后，兰非拉将其中的几份交给你们品尝。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730220608
					]
				},
				{
					"id": 730220608,
					"content": "一起品尝了新鲜的果实。\\n应该说是符合预期吧，确实是新鲜水果的滋味。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730220609
					]
				},
				{
					"id": 730220609,
					"content": "真好。谢谢你，强壮的树。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220610
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220610,
					"content": "等等，这也算是烹饪吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220611
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220611,
					"content": "「鲜嫩无朋之果」自身就是最高级的「至上珍馐」，不需要任何加工，就有最完美的味道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220612
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220612,
					"content": "多说无益，只要进行品尝就能够清楚了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220613
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220613,
					"content": "虽然确实好吃，就像、就像在吃水果一样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220614
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220614,
					"content": "这本来就是水果啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220615
					]
				},
				{
					"id": 730220615,
					"content": "倒也没错…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220616
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220616,
					"content": "你们那菈不也有那种，只把果子切开，摆在盘子里，就放在木头平台上的菜肴嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220617
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220617,
					"content": "咦，有吗…等等，你说的是果盘吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220618
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220618,
					"content": "果盘算是菜吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220619,
						730220621
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220619,
					"content": "应该算是吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220620
					]
				},
				{
					"id": 730220620,
					"content": "总觉得把果盘当做菜有点奇怪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220623
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220623,
					"content": "唔…不要拘泥于这样的形式嘛，寻找更好的食材，本身也是一种烹饪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220624
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220624,
					"content": "寻找食材的过程中，就可以到森林的各个地方去，亲近森林，这才是「烹饪修行」的真义嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220625
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220625,
					"content": "是这样吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220626
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220626,
					"content": "就是这样吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220627
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220627,
					"content": "这下摘到了「鲜嫩无朋之果」，我也做出了「至上珍馐」，这次「烹饪修行」也结束了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220628
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220628,
					"content": "就能正大光明回桓那兰那了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220629
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220629,
					"content": "#唔…被大怪物堵在山洞里，要是没有那菈{NICKNAME}和派蒙，肯定会错过这次无忧节。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220630
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220630,
					"content": "好啦，你也快点回桓那兰那吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220631
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220631,
					"content": "确实确实…错过无忧节，一定会被妹妹训斥…想想就害怕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220621,
					"content": "应该不算吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220622
					]
				},
				{
					"id": 730220622,
					"content": "就是说呀，感觉都没有经过什么…工序，被叫做菜很奇怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220623
					],
					"speakerTitle": "派蒙"
				}
			]
		},
