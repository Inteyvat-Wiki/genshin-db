							"73022"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙",
					"兰非拉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730220301,
					"content": "嗯？是你啊。好久不见了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220302
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220302,
					"content": "哎呀，这里是哪里，是什么山洞里吗…唔，感觉有点晕晕的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220303
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220303,
					"content": "你是谁，你怎么睡在这里啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220304,
					"content": "我是谁…唔，头晕乎乎的，让我想想…我的名字…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220305
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220305,
					"content": "我的名字是兰非拉，嘿嘿，我想起来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220306
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220306,
					"content": "原来你就是兰非拉呀！我们还说你跑到哪里去了，原来躲在这个山洞里睡觉呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220307,
					"content": "兰非拉…你们居然知道我的名字…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220308
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220308,
					"content": "咦，是那菈！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220309
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220309,
					"content": "完全醒过来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220310,
					"content": "完全醒过来了呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220311
					]
				},
				{
					"id": 730220311,
					"content": "呜呜，我还没有准备好，不要把我煮成粥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220312
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220312,
					"content": "啊？怎么会有人想要把你煮成粥？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220313,
					"content": "妹、妹妹说过，如果我老是迷迷糊糊，就会被坏那菈抓走，煮成杂烩粥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220314,
						730220317
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220314,
					"content": "你看起来很好吃！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220315
					]
				},
				{
					"id": 730220315,
					"content": "呜哇啊啊啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220316
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220316,
					"content": "#喂！{NICKNAME}，不要开这种玩笑！兰非拉，没有人会把你煮成粥的啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220318,
					"content": "…真的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220319
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220319,
					"content": "真的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220320,
					"content": "真的是真的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220321
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220321,
					"content": "#不骗你啦。我叫派蒙，这位高高的那菈是{NICKNAME}。是兰帕卡提叫我们来找你的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220322
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220322,
					"content": "兰帕卡提？她还好吗？我在这里呆了多久…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220323
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220323,
					"content": "多久来着？我记得好像是说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220324
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220324,
					"content": "我想想…很多很多个月亮以前，幼苗钻出土，长成了大树，有多少个兰帕卡提高来着…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220325,
						730220327
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220325,
					"content": "七个。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220326
					]
				},
				{
					"id": 730220326,
					"content": "#喔！不愧是{NICKNAME}，记忆力真好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220329
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220329,
					"content": "哎呀，已经过了这么久了吗。糟糕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220330
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220330,
					"content": "总之，事情是这样的。无忧节要开始了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220331
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220331,
					"content": "向兰非拉述说事情的经过。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730220332
					]
				},
				{
					"id": 730220332,
					"content": "啊，原来要过无忧节了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220333
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220333,
					"content": "是啊，所以兰帕卡提要你回桓那兰那。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220334
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220334,
					"content": "哎呀…可是我现在还没完成我的「烹饪修行」呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220335
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220335,
					"content": "咦？你不是在睡觉吗，我还以为…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220336
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220336,
					"content": "「睡觉」？啊，只是在想以前的事情。没到那么严重的地步啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220337
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220337,
					"content": "对兰那罗来说，睡觉是很严重的事情喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220338
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220338,
					"content": "嗯…该怎么说呢。在性命垂危的时候，我们会「休眠」。然后，把所有的记忆和梦都压缩成一颗「种子」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220339
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220339,
					"content": "如果危机过去了。如果有缘分，那种子就能回到森林中。然后，在机缘合适的时候，再度长成兰那罗吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220340,
						730220341,
						730220342
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220340,
					"content": "听起来很严苛…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220344
					]
				},
				{
					"id": 730220344,
					"content": "不过，我知道。那菈是要睡觉的。以前，我也有一个那菈朋友。和你一样，金灿灿的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220345
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220345,
					"content": "#以前，我和{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}也到过这里，为了摘到「鲜嫩无朋之果」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220346
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220346,
					"content": "#所以，我一直来这里采果实。如果{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}回来了，或者是，遇到了新的那菈朋友，就可以一起吃果实。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220347
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220347,
					"content": "这次，我也摘到了好多「鲜嫩无朋之果」…咦，怎么就剩这么点了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220348
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220348,
					"content": "原来我们看到，散在路上的日落果，全是你掉的呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220349
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220349,
					"content": "掉了好多吗…唔，不过没有关系，嘿嘿，最鲜嫩，最好吃的果子还留在我身上呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220350
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220350,
					"content": "唔…到底是为什么掉了那么多果子呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220351
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220351,
					"content": "我记得我和几个哥哥们一起出来进行「烹饪修行」，但是他们都不知道，其实鲜嫩的果子就是最好的食材…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220352
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220352,
					"content": "不过就在我摘果子的时候…对，就在我摘果子的时候，突然出现了一个好大好大的怪物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220353
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220353,
					"content": "大怪物，有着五个兰非拉那么高，尾巴长长，走起路来连大地都在震颤。而且，里面还有有点像「无留陀」的气息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220354
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220354,
					"content": "而且，好硬好硬。可能，就连兰罗摩、兰百梨迦，都要用一点力气才能拆掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220355
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220355,
					"content": "什么？他们有这么强吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220356
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220356,
					"content": "嗯。但是，我没有那么强。所以，我只好躲在这里。一边想着过去的事情，一边等它走。回过神来，就看到你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220357
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220357,
					"content": "有这样可怕的大怪物在外，我可不想出去。对不起，「妹妹」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220358
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220358,
					"content": "不行，无忧节快开了，你得回去才行呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220359
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220359,
					"content": "无忧节无忧，而走出山洞就有性命之忧…呼呼…不能因为无忧节而有忧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220360
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220360,
					"content": "呼呼——呼呼——那菈法留纳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220361
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220361,
					"content": "啊，这个家伙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220362
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220362,
					"content": "#{NICKNAME}，这下该怎么办呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220363,
						730220364
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220363,
					"content": "解决大怪物吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220365
					]
				},
				{
					"id": 730220365,
					"content": "…再可怕应该不会有风魔龙可怕吧。不知道兰那罗见到风魔龙的话，会怎么形容呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220366
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220366,
					"content": "「有一百万个兰非拉高！」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220367
					]
				},
				{
					"id": 730220367,
					"content": "「从尾巴走到头，要从月亮升起，到月亮落下！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220368
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220368,
					"content": "总之，去解决外面的怪物吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220364,
					"content": "哎吔，大怪物，好可怕。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220365
					]
				},
				{
					"id": 730220341,
					"content": "听起来真方便！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220344
					]
				},
				{
					"id": 730220342,
					"content": "派蒙，你能变成种子吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220343
					]
				},
				{
					"id": 730220343,
					"content": "你对我有什么不满吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220344
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220327,
					"content": "派蒙记忆力真好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220328
					]
				},
				{
					"id": 730220328,
					"content": "嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220329
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220317,
					"content": "没有人会把你煮成粥的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220318
					]
				}
			]
		},
