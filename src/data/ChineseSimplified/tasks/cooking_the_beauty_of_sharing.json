			"trigger": {
				"objectNames": [
					"兰非拉",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730220101,
					"content": "你好呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220102,
					"content": "呼呼——呼呼——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220103
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220103,
					"content": "喂！你好——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220104,
					"content": "唔嗯。好果子。呼呼——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220105
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220105,
					"content": "可恶，睡得好沉。唔…对了，兰帕卡提说过，用<color=#00E1FFFF>草元素的力量</color>，应该可以让他恢复正常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220106,
					"content": "#{NICKNAME}，就交给你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7302202,
			"completionStepIds": [
				7302207
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302207",
							"2"
						],
						"stepId": 7302207,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_VAR_EQUAL",
						"rawParams": [
							"0",
							"1",
							"73022"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙",
					"兰非拉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730220201,
					"content": "嗯？是你啊。好久不见了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220202
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220202,
					"content": "哎呀，这里是哪里，是什么山洞里吗…唔，感觉有点晕晕的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220203
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220203,
					"content": "你是谁，你怎么睡在这里啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220204,
					"content": "我是谁…唔，头晕乎乎的，让我想想…我的名字…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220205
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220205,
					"content": "我的名字是兰非拉，嘿嘿，我想起来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220206
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220206,
					"content": "原来你就是兰非拉呀！我们还说你跑到哪里去了，原来躲在这个山洞里睡觉呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220207,
					"content": "兰非拉…你们居然知道我的名字…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220208
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220208,
					"content": "咦，是那菈！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220209
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220209,
					"content": "完全醒过来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220210,
					"content": "完全醒过来了呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220211
					]
				},
				{
					"id": 730220211,
					"content": "呜呜，我还没有准备好，不要把我煮成粥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220212
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220212,
					"content": "啊？怎么会有人想要把你煮成粥？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220213,
					"content": "妹、妹妹说过，如果我老是迷迷糊糊，就会被坏那菈抓走，煮成杂烩粥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220214,
						730220217
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220214,
					"content": "你看起来很好吃！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220215
					]
				},
				{
					"id": 730220215,
					"content": "呜哇啊啊啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220216
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220216,
					"content": "#喂！{NICKNAME}，不要开这种玩笑！兰非拉，没有人会把你煮成粥的啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220218,
					"content": "…真的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220219
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220219,
					"content": "真的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220220,
					"content": "真的是真的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220221
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220221,
					"content": "#不骗你啦。我叫派蒙，这位高高的那菈是{NICKNAME}。是兰帕卡提叫我们来找你的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220222,
					"content": "兰帕卡提？她还好吗？我在这里呆了多久…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220223
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220223,
					"content": "多久来着？我记得好像是说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220224,
					"content": "我想想…很多很多个月亮以前，幼苗钻出土，长成了大树，有多少个兰帕卡提高来着…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220225,
						730220227
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220225,
					"content": "七个。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220226
					]
				},
				{
					"id": 730220226,
					"content": "#喔！不愧是{NICKNAME}，记忆力真好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220229
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220229,
					"content": "哎呀，已经过了这么久了吗。糟糕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220230
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220230,
					"content": "总之，事情是这样的。无忧节要开始了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220231
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220231,
					"content": "向兰非拉述说事情的经过。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730220232
					]
				},
				{
					"id": 730220232,
					"content": "啊，原来要过无忧节了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220233
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220233,
					"content": "是啊，所以兰帕卡提要你回桓那兰那。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220234
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220234,
					"content": "哎呀…可是我现在还没完成我的「烹饪修行」呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220235
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220235,
					"content": "咦？你不是在睡觉吗，我还以为…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220236
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220236,
					"content": "「睡觉」？啊，只是在想以前的事情。没到那么严重的地步啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220237
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220237,
					"content": "对兰那罗来说，睡觉是很严重的事情喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220238
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220238,
					"content": "嗯…该怎么说呢。在性命垂危的时候，我们会「休眠」。然后，把所有的记忆和梦都压缩成一颗「种子」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220239
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220239,
					"content": "如果危机过去了。如果有缘分，那种子就能回到森林中。然后，在机缘合适的时候，再度长成兰那罗吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220240,
						730220241,
						730220242
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220240,
					"content": "听起来很严苛…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220244
					]
				},
				{
					"id": 730220244,
					"content": "不过，我知道。那菈是要睡觉的。以前，我也有一个那菈朋友。和你一样，金灿灿的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220245
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220245,
					"content": "#以前，我和{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}也到过这里，为了摘到「鲜嫩无朋之果」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220246
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220246,
					"content": "#所以，我一直来这里采果实。如果{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}回来了，或者是，遇到了新的那菈朋友，就可以一起吃果实。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220247
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220247,
					"content": "这次，我也摘到了好多「鲜嫩无朋之果」…咦，怎么就剩这么点了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220248
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220248,
					"content": "原来我们看到，散在路上的日落果，全是你掉的呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220249
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220249,
					"content": "掉了好多吗…唔，不过没有关系，嘿嘿，最鲜嫩，最好吃的果子还留在我身上呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220250
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220250,
					"content": "唔…到底是为什么掉了那么多果子呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220251
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220251,
					"content": "我记得我和几个哥哥们一起出来进行「烹饪修行」，但是他们都不知道，其实鲜嫩的果子就是最好的食材…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220252
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220252,
					"content": "不过就在我摘果子的时候…对，就在我摘果子的时候，突然出现了一个好大好大的怪物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220253
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220253,
					"content": "大怪物，有着五个兰非拉那么高，尾巴长长，走起路来连大地都在震颤。而且，里面还有有点像「无留陀」的气息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220254
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220254,
					"content": "而且，好硬好硬。可能，就连兰罗摩、兰百梨迦，都要用一点力气才能拆掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220255
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220255,
					"content": "什么？他们有这么强吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220256
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220256,
					"content": "嗯。但是，我没有那么强。所以，我只好躲在这里。一边想着过去的事情，一边等它走。回过神来，就看到你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220257
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220257,
					"content": "这么说来，在我们来的路上，确实遇到了「遗迹龙兽」，你说的大怪物是它吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220258
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220258,
					"content": "那菈是这样称呼它的吗…？或许是吧。应该是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220259,
						730220260
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220259,
					"content": "已经处理掉了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220264
					]
				},
				{
					"id": 730220264,
					"content": "#哦哦。没想到，看上去没有大怪物大的那菈{NICKNAME}，居然有这样的力量。好强。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220265
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220265,
					"content": "嗯。那我们出发吧。好那菈，我们一起吃果实。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220260,
					"content": "哎吔，大怪物，好可怕。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220261
					]
				},
				{
					"id": 730220261,
					"content": "…有这么可怕吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220262
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220262,
					"content": "嗯嗯。看来那菈也明白，是可怕的怪物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220263
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220263,
					"content": "#不用担心啦。见到你之前，{NICKNAME}已经把那个大怪物打败啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220264
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220241,
					"content": "听起来真方便！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220244
					]
				},
				{
					"id": 730220242,
					"content": "派蒙，你能变成种子吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220243
					]
				},
				{
					"id": 730220243,
					"content": "你对我有什么不满吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220244
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220227,
					"content": "派蒙记忆力真好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220228
					]
				},
				{
					"id": 730220228,
					"content": "嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220229
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220217,
					"content": "没有人会把你煮成粥的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220218
					]
				}
			]
		},
		{
			"id": 7302203,
			"completionStepIds": [
				7302207
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302207",
							"2"
						],
						"stepId": 7302207,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_VAR_EQUAL",
						"rawParams": [
							"0",
