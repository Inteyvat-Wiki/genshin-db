			},
			"dialogs": [
				{
					"id": 730220501,
					"content": "呼呼——呼呼——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220502
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220502,
					"content": "兰非拉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220503,
					"content": "嗯？原来是派蒙啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220504
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220504,
					"content": "#对啊，我们是来告诉你，外面的「大怪物」，{NICKNAME}已经处理掉啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220505,
					"content": "#哦哦。没想到，看上去没有大怪物大的那菈{NICKNAME}，居然有这样的力量。好强。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220506,
						730220507
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220506,
					"content": "还好啦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220508
					]
				},
				{
					"id": 730220508,
					"content": "嗯。那我们出发吧。好那菈，我们一起吃果实。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730220507,
					"content": "挺棘手的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220508
					]
				}
			]
		},
		{
			"id": 7302206,
			"completionStepIds": [
				7302204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
