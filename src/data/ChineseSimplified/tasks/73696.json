			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"巴哈尔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736960101,
					"content": "你好，旅行者，看你样子…应该是来这里参加学院游乐会的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960102
					],
					"speakerTitle": "巴哈尔"
				},
				{
					"id": 736960102,
					"content": "有兴趣的话，要不要来体验一下我们室罗婆耽学院举办的活动？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960103
					],
					"speakerTitle": "巴哈尔"
				},
				{
					"id": 736960103,
					"content": "我记得室罗婆耽学院研究的是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736960104
					]
				},
				{
					"id": 736960104,
					"content": "用一个词组不严谨概括的话，就是…「语言」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960105
					],
					"speakerTitle": "巴哈尔"
				},
				{
					"id": 736960105,
					"content": "这就是我们室罗婆耽学院所研究的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960106
					],
					"speakerTitle": "巴哈尔"
				},
				{
					"id": 736960106,
					"content": "怎么样？是不是一听就和学院游乐会欢乐轻松的氛围不搭？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960107
					],
					"speakerTitle": "巴哈尔"
				},
				{
					"id": 736960107,
					"content": "我们学院里的不少同学也是这么想的，大家都在热热闹闹地玩，我们总不可能出去让人猜谜吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960108
					],
					"speakerTitle": "巴哈尔"
				},
				{
					"id": 736960108,
					"content": "而且猜谜这种小游戏，实在也无法引起大家的兴趣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960109
					],
					"speakerTitle": "巴哈尔"
				},
				{
					"id": 736960109,
					"content": "在经过很多天的…友好讨论后，我们研究出了这种名为「追溯求真」的小游戏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960110
					],
					"speakerTitle": "巴哈尔"
				},
				{
					"id": 736960110,
					"content": "这个小游戏也不需要太多道具，只要你调整好自己的思维就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960111
					],
					"speakerTitle": "巴哈尔"
				},
				{
					"id": 736960111,
					"content": "在这个游戏的开始，我会向你讲一个小故事。这个小故事也许听起来没头没尾，有些地方甚至有悖常理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960112
					],
					"speakerTitle": "巴哈尔"
				},
				{
					"id": 736960112,
					"content": "而你可以向我「提问」。对于你的提问，我会做出<color=#00E1FFFF>「是」</color>，<color=#00E1FFFF>「否」</color>和<color=#00E1FFFF>「没有关系」</color>三种回答。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960113
					],
					"speakerTitle": "巴哈尔"
				},
				{
					"id": 736960113,
					"content": "你所要做的，就是用你的「提问」来找出这个故事的「真相」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960114
					],
					"speakerTitle": "巴哈尔"
				},
				{
					"id": 736960114,
					"content": "但你也不用太紧张，这个故事的真相不会太复杂的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960115
					],
					"speakerTitle": "巴哈尔"
				},
				{
					"id": 736960115,
					"content": "怎么样？如果有兴趣的话，我们现在就开始吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960116,
						736960118
					],
					"speakerTitle": "巴哈尔"
				},
				{
					"id": 736960116,
					"content": "那就开始吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736960117
					]
				},
				{
					"id": 736960117,
					"content": "没问题，请你听好第一个故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "巴哈尔"
				},
				{
					"id": 736960118,
					"content": "还有别的事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736960119
					]
				},
				{
					"id": 736960119,
					"content": "这段时间，我会一直在这里，你想玩的话可以随时来找我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "巴哈尔"
				}
			]
		}
	]
}