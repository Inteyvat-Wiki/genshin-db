			"dialogs": [
				{
					"id": 715100101,
					"content": "怎么样，「普尔希娜光钉」成功运作了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715100102,
						715100103
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715100102,
					"content": "成功了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715100104
					]
				},
				{
					"id": 715100104,
					"content": "成功就好，成功就好，虽然「普尔希娜光钉」不能一次性就将喷口全部封闭，但是只要成功一次，就能够持续运行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715100105
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715100105,
					"content": "这样，将所有喷口全部封闭也只是时间问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715100106
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715100106,
					"content": "这问题总算解决了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715100107
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715100107,
					"content": "我想想，得把这些记录下来，等关于「普尔希娜光钉」的完全研究报告上交之后，说不定我…我还能成为院内的风云人物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715100108
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715100108,
					"content": "#嗯，这些都可以写进我将来的自传里，「我曾与身手超凡的{NICKNAME}于『层岩巨渊』经过一番实验…」这样记录好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715100109
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715100109,
					"content": "那我就等着那一天了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715100110
					]
				},
				{
					"id": 715100110,
					"content": "哈哈，不过我写研究报告很熟练，写传记啊，故事啊这种文体恐怕就有些拙劣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715100111
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715100111,
					"content": "希望到时候你不要介意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715100103,
					"content": "大部分黑泥都清理干净了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715100104
					]
				}
			]
		}
