			"trigger": {
				"objectNames": [
					"泽维尔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721190101,
					"content": "呃！旅行者，我觉得…事情好像不太妙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190102
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721190102,
					"content": "里面的愚人众们突然把人都聚集到了核心附近，好像是有什么发现。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190103
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721190103,
					"content": "他们不会真的能攻破核心的防御吧…不行，我们不能再拖下去了，必须马上开始进行功能性测试。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190104
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721190104,
					"content": "功能性测试？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721190105
					]
				},
				{
					"id": 721190105,
					"content": "就是测试一下这位新伙计的净化能力，我可不想把它运进去之后再发现它没法干活。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190106
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721190106,
					"content": "所以，我想请您帮我去找三只「鬼兜虫」来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190107
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721190107,
					"content": "我想要将这些小家伙们放入现在的「御影炉心」周围，让它们沾染上「祟神」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190108
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721190108,
					"content": "然后再将它们拿出来，用净化装置尝试净化它们所沾染的「祟神」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190109
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721190109,
					"content": "这，就是我所设计的「功能性测试」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190110
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721190110,
					"content": "在哪能找到「鬼兜虫」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721190111
					]
				},
				{
					"id": 721190111,
					"content": "嗯…它们一般都栖息在雷元素富集区域…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190112
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721190112,
					"content": "而且我还听说，它们在「御影炉心」附近也能生存…真是一群厉害的小家伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190113
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721190113,
					"content": "那我不如直接去「御影炉心」里抓…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721190114
					]
				},
				{
					"id": 721190114,
					"content": "虽然这样也可以…但是，如果直接从「御影炉心」里面抓「鬼兜虫」来测试的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190115
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721190115,
					"content": "说实话，我真有些担心我们这位新伙计的…可靠性。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190116
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721190116,
					"content": "做测试，最好还是讲一个「循序渐进」嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190117
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721190117,
					"content": "咳，总之，请您拿三只「鬼兜虫」过来吧，我就在这等着您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190118,
						721190120
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721190118,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721190119
					]
				},
				{
					"id": 721190119,
					"content": "那就拜托您了，只要三只「鬼兜虫」就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721190120,
					"content": "不如我直接进去转一圈…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721190121
					]
				},
				{
					"id": 721190121,
					"content": "呃…就测试本身而言，您直接进去转一圈，沾满「祟神」再出来，确实也可以作为测试对象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190122
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721190122,
					"content": "但我之前也说了，这个装置的可靠性有些…不达预期。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190123
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721190123,
					"content": "如果在净化过程中，真的发生了什么预期之外的情况，您可能也会…呃，面临一些预期之外的问题…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190124
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721190124,
					"content": "咳，总之，我们还是就用「鬼兜虫」来测试吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190125
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721190125,
					"content": "只要三只「鬼兜虫」就好，您抓到了之后，就拿回来给我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "泽维尔"
				}
			]
		},
