						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"7303201",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"斯露莎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736970601,
					"content": "第一天的终点就是这里吗？这里我们已经很熟悉了，毕竟都来过好多次了嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970602,
					"content": "哦？既然白飘飘这么有自信，那不如我们身份对调，我来扮演听众，由你来讲述。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970603
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970603,
					"content": "好啊，试试就试试，瞧我的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970604,
					"content": "我们眼前这片有花有水的地方就是甘露花海，这里没有…对了，没有「迪弗诸魔」的侵扰，是花灵的家乡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970605,
					"content": "在这里有很多花灵，其中最了不起的那一个叫祖尔宛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970606,
					"content": "斯露莎也是在这里诞生的吧？不过斯露莎跟其他的花灵不一样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970607
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970607,
					"content": "如果说其他花灵说话只是有五分怪，那我们一开始见到的斯露莎说话有十分怪！唉，明明是一样的水，为什么只有斯露莎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970608
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970608,
					"content": "喂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970609
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970609,
					"content": "我可不是乱说的，一开始斯露莎跟矫论团的人说话的时候的确很怪嘛，唔，虽然矫论团的人说话也很怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970610
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970610,
					"content": "本来还以为其他花灵也和斯露莎一样，到甘露花海来找祖尔宛之前还很担心呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970611
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970611,
					"content": "最后发现只有斯露莎是这样…应该说，斯露莎跟矫论团的人说话的时候才会这样，欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970612
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970612,
					"content": "看来是受矫论团的人影响太深了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736970613
					]
				},
				{
					"id": 736970613,
					"content": "唔…这一点我不否认。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970614
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970614,
					"content": "既然斯露莎没问题，那我接着讲。甘露花海里的大树桩子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970615
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970615,
					"content": "白飘飘，你这家伙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970616
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970616,
					"content": "是甘露花海里的「万种母树」！花灵的词汇都好难记，而且，它本来就是大树桩子嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970617
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970617,
					"content": "我记得斯露莎说过，大树桩子其实是神明大人，而花灵一族也和这位神明大人有着不浅的关系。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970618
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970618,
					"content": "虽然事实是这样没错…但总觉得继续让白飘飘讲下去就太不敬了，还是由我来讲吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970619
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970619,
					"content": "好吧…亏我还觉得自己讲得很简单易懂呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970620
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970620,
					"content": "哼…总之，五百年前，神明大人为了镇压此处的灾厄而牺牲了全部，此处的甘露活水便是神明大人最后的遗赠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970621
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970621,
					"content": "受甘露活水的滋养，诞生了万种母树与吾辈花灵。而花灵之中的最古者，便是前辈…也就是祖尔宛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970622
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970622,
					"content": "我的诞生要晚许多，因此未能亲历那些事件。过去听前辈说过一些，但是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970623
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970623,
					"content": "明明矫论团建立之初，前辈也是有参与的，但是在我诞生之后，他们之间已经没什么往来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970624
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970624,
					"content": "虽然前辈也说花灵的传承是很重要的，但却不常对我说起过去的细节。反倒是矫论团的人类…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970625
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970625,
					"content": "不仅非常热心地同我分享他们对历史的研究，还认同我效法神鸟的愿望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970626
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970626,
					"content": "欸？所以之后斯露莎就渐渐疏远花灵同族，还跟矫论团的人学会了那些怪话吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970627
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970627,
					"content": "唔…从事实上来说，是这样没错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970628
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970628,
					"content": "听起来像叛逆期…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736970629
					]
				},
				{
					"id": 736970629,
					"content": "「叛逆期」…以前听矫论团的人类说起过，森林里的学者有什么「林居狂语期」之类的阶段，「叛逆期」也是类似的阶段吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970630,
						736970632
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970630,
					"content": "对，和那个差不多。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736970631
					]
				},
				{
					"id": 736970631,
					"content": "不对，根本不是一回事吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970634
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970634,
					"content": "简单说，叛逆期的人类小孩会反抗平日照顾自己的大人，并且提出一些自己的主张。我是这么听说的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970635
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970635,
					"content": "嘿嘿，就跟之前的斯露莎一样嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970636
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970636,
					"content": "哼，过去的我和现在的我可不一样。不管怎么说，现在的我已经回归花海，并且得到了灵光的认可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970637
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970637,
					"content": "斯露莎可真了不起！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970638
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970638,
					"content": "明明白飘飘也只是个小不点而已…罢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970639
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970639,
					"content": "今日要讲的就是这些了，「谒颂主」和白飘飘还有什么想问的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970640
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970640,
					"content": "说起来，花灵和兰那罗有关系吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970641
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970641,
					"content": "…为什么会有这样的疑问？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970642
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970642,
					"content": "因为花灵和兰那罗都小小的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736970643
					]
				},
				{
					"id": 736970643,
					"content": "但是做的事情却很伟大呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970644
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970644,
					"content": "为斯露莎讲述了与兰罗摩等许多兰那罗一同冒险的经历…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						736970645
					]
				},
				{
					"id": 736970645,
					"content": "唔…无忧节居然是这么重要的节日。听前辈提起的时候，还以为只是兰那罗聚在一起玩闹而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970646
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970646,
					"content": "不过，既然兰那罗都有自己的节日，为什么我们花灵却没有呢？应该去跟前辈提一下这件事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970647
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970647,
					"content": "那斯露莎为什么想要花灵的节日呢？是因为节日可以吃好吃的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970648
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970648,
					"content": "当然不是！花灵的节日…应该让人类来唱颂诗，由我来选出其中唱得最好的那一个。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970649
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970649,
					"content": "这听起来一点都不像是节日…对来参加的人类来说，根本就是压力十足的竞赛吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970650
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970650,
					"content": "可是对我来说就是很快乐的节日呀？我想前辈一定也会喜欢这样的节日的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970651
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970651,
					"content": "唔…也许祖尔宛说得对，斯露莎要成为称职的花灵勇者还需要一些磨练…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970632,
					"content": "该说是成长途中的必经之路吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736970633
					]
				},
				{
					"id": 736970633,
					"content": "和学者才会有的林居狂语期不一样，的确，听说很多人类小孩都会有这个阶段呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970634
					],
					"speakerTitle": "派蒙"
				}
			]
		},
