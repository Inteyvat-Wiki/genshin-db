	"talks": [
		{
			"id": 7369701,
			"completionStepIds": [
				7369701
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7369701",
							"2"
						],
						"stepId": 7369701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"斯露莎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736970101,
					"content": "说起来，看习惯了斯露莎现在的样子，都快想不起来没有花冠时的斯露莎是什么模样了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970102,
					"content": "唔…印象里好像是头顶光溜溜，说话还总是一副了不起的样子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970103,
					"content": "没想到能这么顺利地获得花冠…虽然都是多亏了我们帮忙，嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970104,
					"content": "咳！过去的琐事就不必再提了。白飘飘，你可别弄错了重点，之所以能顺利地获得花冠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970105
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970105,
					"content": "那是因为我是配得上「双角的花冠」的花灵，所以一切都顺理成章，就好像我从诞生之日起就拥有它…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970106
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970106,
					"content": "身后传来了熟悉的声音…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						736970107
					]
				},
				{
					"id": 736970107,
					"content": "呵呵，语气倒是不小嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970108
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 736970108,
					"content": "前、前辈？！你怎么会在这里？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970109
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970109,
					"content": "当然是关心新任的花灵勇者有没有履行勇者的职责。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970110
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 736970110,
					"content": "勇、勇者的职责…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970111
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970111,
					"content": "啊呀，斯露莎该不会以为只要拿到名号就万事大吉了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970112
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 736970112,
					"content": "怎么会！我可不是那么天真的花灵。勇者的职责…并没有怠慢，那些值得称颂的伟业我也是有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970113
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970113,
					"content": "一瞬的光焰固然夺目，如涓涓细流的持久奉献也未必不值得称颂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970114
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 736970114,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970115
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970115,
					"content": "在斯露莎疏远我们反而亲近人类的这些年月里，可是有不少花灵即便与勇者之名无缘，却也默默做着奉献呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970116
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 736970116,
					"content": "唔唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970117
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970117,
					"content": "原本以为斯露莎当然会做些「名副其实」的符合「勇者」身份的事呢，原来只是在无所事事地闲逛呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970118
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 736970118,
					"content": "#说什么无所事事也太过分了，斯露莎还是很了不起的！对吧，{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970119,
						736970120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970119,
					"content": "确实。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736970122
					]
				},
				{
					"id": 736970122,
					"content": "我也不是有意怠慢，只是勇者的职责具体指什么…矫论团也没有这方面的记载…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970123
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970123,
					"content": "毕竟是花灵的传统，想从人类那里了解未免舍近求远。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970124
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 736970124,
					"content": "虽说得到了灵光的认可，但毕竟还是年轻的花灵。这种时候就该率直一些，向我请教便好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970125
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 736970125,
					"content": "直接向前辈请教？可是…不，花冠包蕴了许多智慧，只要我稍后思忖一阵应该就能获得答案吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970126
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970126,
					"content": "可是祖尔宛就在眼前，而且都说了只要问她她就会回答…居然不用自己去找答案了欸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970127,
					"content": "#以我和{NICKNAME}丰富的旅行经验来看，这样的机会一旦错过，之后一定会后悔的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970128,
					"content": "我可不是担心前辈会编些话来打发我，只是，唔…我听矫论团的人类说过，只有自己找到的答案才是有意义的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970129,
						736970131
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970129,
					"content": "那这句话不也是别人告诉你的吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736970130
					]
				},
				{
					"id": 736970130,
					"content": "对啊，难道矫论团的人说的话比祖尔宛的话更可信吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970133,
					"content": "…嗯，「谒颂主」和白飘飘的话的确有几分道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970134
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970134,
					"content": "我已经不是从前的斯露莎了，既然获得了灵光的认可，行事也该更成熟一些，至少要不愧对勇者的名号。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970135
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970135,
					"content": "咳，祖尔宛…前辈。关于勇者的职责具体指什么内容，还望您不吝赐教。虽然过去疏忽了，但今后我一定会尽力补救的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970136
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970136,
					"content": "哇，斯露莎居然会乖乖说出这些话，怎么回事，我居然觉得有点感动！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970137
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970137,
					"content": "噗嗤…既然你这样说了，那我就放心了。勇者的职责细说起来可能几天几夜都说不完…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970138
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 736970138,
					"content": "不过考虑到斯露莎这些年来与人类在一起的时间可是要远远超过与同族相伴的时间，还是先从简单的内容说起吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970139
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 736970139,
					"content": "对于称职的花灵勇者来说，出众的行动力和敏锐的洞察力都是必须的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970140
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 736970140,
					"content": "我已经准备好了六项训练内容，其中三项考验飞行能力，另外三项嘛，需要斯露莎清除一些安全隐患。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970141
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 736970141,
					"content": "训练内容听起来有些熟悉…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736970142
					]
				},
				{
					"id": 736970142,
					"content": "哪里是有些熟悉，简直太熟悉啦，这不就是杂…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970143
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970143,
					"content": "白飘飘不要多话，只要我顺利完成这些任务，前辈就会认可我是独当一面的花灵勇者了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970144
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970144,
					"content": "虽然听起来都很简单，但这可是前辈给我的考验，这时候就该拿出狮子搏兔的精神来应对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970145
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970145,
					"content": "呵呵，很好很好。正巧「谒颂主」与同伴也在，有一项任务希望两位能协助斯露莎完成。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970146
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 736970146,
					"content": "并不是什么难事，只是正如两位所知，近年来斯露莎与矫论团的人类走得很近，对于我们花灵的传统反而疏远。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970147
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 736970147,
					"content": "此次想拜托两位扮演听众，见证斯露莎回顾过往。能够正确讲述历史对于无愧勇者之名的花灵来说也是理所当然的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970148
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 736970148,
					"content": "当然。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970149
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970149,
					"content": "只是听斯露莎讲故事的话，好像还挺简单的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970150
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970150,
					"content": "那么，见证的工作，就交给两位了。关于需要由斯露莎自行完成的训练，我稍后讲与她听，两位只要跟随她便好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 736970131,
					"content": "那可是文献典籍都会出错的矫论团…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736970132
					]
				},
				{
					"id": 736970132,
					"content": "对啊，去找拉沙鲁的时候，实际情况跟他们的文献典籍上的记载根本不一样嘛，而且就连他们自己也搞不清到底是怎么回事呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970120,
					"content": "该如何评价呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736970121
					]
				},
				{
					"id": 736970121,
					"content": "#{NICKNAME}不要那么严格嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970122
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7369706,
