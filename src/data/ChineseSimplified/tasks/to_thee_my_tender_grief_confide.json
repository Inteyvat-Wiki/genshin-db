					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726610501,
					"content": "怎么都是些都是矿渣，感觉里面有东西被人取走了一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726610502,
					"content": "咦？！那个人是...盗宝团？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726610503,
					"content": "不会是他们拿走了矿石里的东西吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726610504,
					"content": "快跟上他们，周围肯定有他们的营地，矿石里的东西一定都在那里！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726610505,
					"content": "我们走。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610506
					]
				},
				{
					"id": 726610506,
					"content": "我们要偷偷的，偷偷的，别被发现了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
