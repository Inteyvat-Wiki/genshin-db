			"trigger": {
				"objectNames": [
					"鲸井椛",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726610601,
					"content": "你们终于回来了，欸？嘉玮没来吗?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610602
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726610602,
					"content": "他掉进了温柔乡。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610603
					]
				},
				{
					"id": 726610603,
					"content": "啊？他成家了？哈哈！确实像他会做的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610604
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726610604,
					"content": "毕竟之前他的愿望就是这个…好吧，既然是这个理由就原谅他了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610605
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726610605,
					"content": "那楠塔克呢？你们找到了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610606
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726610606,
					"content": "他写了本畅销书。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610607
					]
				},
				{
					"id": 726610607,
					"content": "欸？没想到他真的成了作家啊？还挺能的啊这老小子，写了什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610608
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726610608,
					"content": "我知道我知道！书名叫作《关于「海中月」的真身其实是大海龟这件事》。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610609
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726610609,
					"content": "哦，挺长的名字啊，是轻小说吗？不错…我也去买一本看看…嗯？等等。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610610
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726610610,
					"content": "关于「海中月」的真身…「海中月」的真身？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610611
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726610611,
					"content": "嗯…其实是大海龟。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610612
					]
				},
				{
					"id": 726610612,
					"content": "这家伙在说什么呢？怎么可能是大海龟？他忘了我们当年亲眼看到了「海中月」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610613
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726610613,
					"content": "我们开始也不相信啦…然后就去雪山上找来了「海中月」的化石… 这本书，还有化石，喏，给你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610614
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726610614,
					"content": "不，我不相信，这不是真的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610615
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726610615,
					"content": "你们不知道，我们「鲸井」家是渔师世家，我的父亲也是稻妻闻名的渔师。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610616
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726610616,
					"content": "他曾花费了数十年在大海上追捕「海中月」，有一次，他差点就成功了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610617
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726610617,
					"content": "虽然最后还是功亏一篑，但我父亲没有放弃，如果能够捕上传说中的「海中月」，对渔师来说是无上的荣耀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610618
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726610618,
					"content": "但就在下一次出海后…他就再没有回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610619
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726610619,
					"content": "…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610620
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726610620,
					"content": "所以，我不会轻易相信这种话的，请你帮我一把！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610621
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726610621,
					"content": "那你打算怎么办？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610622
					]
				},
				{
					"id": 726610622,
					"content": "我现在回去找父亲留下的物品，他追逐「海中月」一生，留下了很多资料。一定能在里面找到办法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610623
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726610623,
					"content": "我为你准备了一些钓鱼训练，请等我的好消息吧，到时候还要拜托你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鲸井椛"
				}
			]
		},
