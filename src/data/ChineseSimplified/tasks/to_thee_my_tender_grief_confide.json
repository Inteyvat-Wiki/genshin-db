			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"楠塔克",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726610101,
					"content": "哦，年轻的钓鱼家，见到你可真高兴啊。怎么，遇上了麻烦吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610102
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 726610102,
					"content": "来来来，我可是你的钓鱼领路人了，有什么事说给我听听。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610103
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 726610103,
					"content": "居然是「海中月」啊，鲸井还在执着这件事，也难怪，毕竟她的愿望是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610104
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 726610104,
					"content": "唉，她要是知道了「海中月」的真相，一定会很失望吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610105
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 726610105,
					"content": "什么真相？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610106
					]
				},
				{
					"id": 726610106,
					"content": "其实当年返航之后，我也没有停止关于「海中月」的调查，后来终于在一本古籍中找到了线索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610107
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 726610107,
					"content": "根据那些线索，我又去实地调研，终于发现了一些惊人的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610108
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 726610108,
					"content": "我把这些发现都写进了我的作品里，最近似乎销路还不错呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610109
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 726610109,
					"content": "来，刚好手边有编辑留下的赠本，给你们看看，关于「海中月」的真相全在里面了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610110
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 726610110,
					"content": "我也要看，让我也看看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726610111,
					"content": "《关于「海中月」的真身其实是大海龟这件事》…好长的书名啊… 欸？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726610112,
					"content": "大海龟？「海中月」是大海龟？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726610113,
					"content": "没错，「海中月」就是一只大海龟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610114
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 726610114,
					"content": "当年那个晚上，我们看见的，就是一只背后长满了类似小灯草这种发光植物的大海龟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610115
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 726610115,
					"content": "它是一位怀孕的母亲，正在上岸产卵的路上，因此我们才得以找到回家的路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610116
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 726610116,
					"content": "所以，请回去把我的话转告鲸井吧。不论如何，人终究要面对现实。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610117
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 726610117,
					"content": "可是，虽然这也能说通...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610118
					]
				},
				{
					"id": 726610118,
					"content": "看你的表情，还有点不相信吧？但我的研究是有证据的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610119
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 726610119,
					"content": "古籍中提到，「海中月」是一种古老的生物，在很久很久以前，很多生物还在陆地上生活的时候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610120
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 726610120,
					"content": "它们的祖先，就活跃在如今的龙脊雪山地区，现在还能够找到一些化石。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610121
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 726610121,
					"content": "我上次就在<color=#00E1FFFF>眠龙谷西侧</color>的矿堆里发现了一些，你们如果还不相信，可以去找找看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "楠塔克"
				}
			]
		},
