			"dialogs": [
				{
					"id": 726610701,
					"content": "嘿，你们说，这破石头值钱吗？居然藏在矿石里，真稀罕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610702
					],
					"speakerTitle": "老黑七"
				},
				{
					"id": 726610702,
					"content": "笑死了，什么叫破石头，你读过书吗？这叫化石，化石懂吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610703
					],
					"speakerTitle": "林逃山"
				},
				{
					"id": 726610703,
					"content": "值钱死了，光这一颗就能买下半个璃月港！快回去多读点书吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610704
					],
					"speakerTitle": "林逃山"
				},
				{
					"id": 726610704,
					"content": "真的吗？有这么值钱吗？那加上营地里的这些，我们岂不是要平步乌云了？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610705
					],
					"speakerTitle": "巴子"
				},
				{
					"id": 726610705,
					"content": "是平步青云！你也回去多读点书吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610706
					],
					"speakerTitle": "林逃山"
				},
				{
					"id": 726610706,
					"content": "喂！那边的家伙，把化石交出来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610707
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726610707,
					"content": "啊！是谁？！该死…被发现了，兄弟们上！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "林逃山"
				}
			]
		}
