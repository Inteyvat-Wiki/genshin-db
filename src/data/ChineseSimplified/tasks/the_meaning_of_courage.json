			"dialogs": [
				{
					"id": 150310101,
					"content": "首领阿卡特将「沃陆之邦」的众人召集到了一起，瓦雷莎简要地说明了蘑菇的调查进展。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150310102
					]
				},
				{
					"id": 150310102,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310103
					],
					"speakerTitle": "阿卡特"
				},
				{
					"id": 150310103,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310104
					],
					"speakerTitle": "阿托力"
				},
				{
					"id": 150310104,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310105
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 150310105,
					"content": "我们在调查的时候感觉还好，现在从旁听者的角度听了一遍，感觉确实有点荒唐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150310106,
					"content": "这种难以言述的沉默…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310107
					]
				},
				{
					"id": 150310107,
					"content": "原来如此，果园里的蘑菇居然有自己的意识，这可是个不得了的发现啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310108
					],
					"speakerTitle": "阿卡特"
				},
				{
					"id": 150310108,
					"content": "是啊，要是没有你们调查，说不定会酝酿出很可怕的危机。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310109
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 150310109,
					"content": "幸亏你们察觉到了，还收集了这么多线索！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310110
					],
					"speakerTitle": "豪特利"
				},
				{
					"id": 150310110,
					"content": "太好了，你们没觉得我讲的故事很奇怪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310111
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150310111,
					"content": "哈哈哈，奇怪是奇怪，毕竟和蘑菇说话这种事，我们谁都没经历过啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310112
					],
					"speakerTitle": "阿卡特"
				},
				{
					"id": 150310112,
					"content": "但是瓦雷莎你从来都不是会骗人的孩子，这我们也都知道，再加上绿蘑菇对我们来说本来就是个谜题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310113
					],
					"speakerTitle": "阿卡特"
				},
				{
					"id": 150310113,
					"content": "现在既然发现了不好的苗头，我们大家当然都很愿意支持你们的调查！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310114
					],
					"speakerTitle": "阿卡特"
				},
				{
					"id": 150310114,
					"content": "有什么需要帮忙的，尽管说就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310115
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 150310115,
					"content": "你们接受得好快！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150310116,
					"content": "太谢谢你们了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310117
					]
				},
				{
					"id": 150310117,
					"content": "刚刚说，需要用高温烹饪这种蘑菇对吧，稍等，我现在就去准备。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310118
					],
					"speakerTitle": "阿托力"
				},
				{
					"id": 150310118,
					"content": "来了来了，我直接用铁盘煎了一下，这个温度应该够高！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310119
					],
					"speakerTitle": "阿托力"
				},
				{
					"id": 150310119,
					"content": "哇，果然是很香的味道呢，我的食欲全都回来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150310120,
					"content": "那、那我们就不客气了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310121
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150310121,
					"content": "嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310122
					],
					"speakerTitle": "比夫茏"
				},
				{
					"id": 150310122,
					"content": "听到了吗，是它的声音！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150310123,
					"content": "哈哈哈哈，看来你们是摸到了一点窍门，可是这种温度完全——展现不出丝毫的诚意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310124
					],
					"speakerTitle": "比夫茏"
				},
				{
					"id": 150310124,
					"content": "你们以为用家常的火，家常的工具，随便做一做，就能得到「蕈之贤主」的赏识？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310125
					],
					"speakerTitle": "比夫茏"
				},
				{
					"id": 150310125,
					"content": "人类真是让我失望，有提示的时候，还能用智慧解决我留下的难题…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310126
					],
					"speakerTitle": "比夫茏"
				},
				{
					"id": 150310126,
					"content": "结果没有提示，马上就原形毕露，采用的办法真是愚不可及。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310127
					],
					"speakerTitle": "比夫茏"
				},
				{
					"id": 150310127,
					"content": "再去想想办法吧，嘻嘻嘻嘻——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310128
					],
					"speakerTitle": "比夫茏"
				},
				{
					"id": 150310128,
					"content": "怎、怎么样，听到它的声音了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310129
					],
					"speakerTitle": "阿托力"
				},
				{
					"id": 150310129,
					"content": "可恶，这家伙果然很讨厌！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150310130,
					"content": "它说温度还不够高，达不到它的要求，太难伺候了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310131,
						150310132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150310131,
					"content": "但是要弄清楚它想搞什么…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310133
					]
				},
				{
					"id": 150310133,
					"content": "温度不够高，那看来得用更厉害的手段才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310134
					],
					"speakerTitle": "阿卡特"
				},
				{
					"id": 150310134,
					"content": "听到了吗，各位，麻烦大家去收集一些高温的东西，什么都行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310135
					],
					"speakerTitle": "阿卡特"
				},
				{
					"id": 150310135,
					"content": "我去想想办法！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310136
					],
					"speakerTitle": "阿托力"
				},
				{
					"id": 150310136,
					"content": "交给我吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310137
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 150310137,
					"content": "那我们也去找找？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310138
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150310138,
					"content": "好啊，但这附近我们还不是很熟，你有什么想法吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150310139,
					"content": "嗯…目前还没有眉目，但我们可以去火山附近看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310140
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150310140,
					"content": "火山总是吐各种各样的东西出来，说不定就会有很好的素材。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310141
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150310141,
					"content": "没问题，走吧！要是有机会的话，我要把找到的烫烫素材，甩到这个坏蘑菇的脸上！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150310132,
					"content": "也只能继续配合它了吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310133
					]
				}
			]
		},
