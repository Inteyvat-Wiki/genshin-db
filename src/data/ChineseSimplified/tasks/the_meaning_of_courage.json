			"dialogs": [
				{
					"id": 150310301,
					"content": "顺利解决！这个好像很不错，你们看，里面的燃素还很活跃呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310302
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150310302,
					"content": "我摸摸看…哇，好烫！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150310303,
					"content": "像这样的再多找上几块应该就够了，走，我们再往上看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
