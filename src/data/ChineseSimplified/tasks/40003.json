				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"星火"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400030401,
					"content": "好了，这里的怪物痕迹已经调查完毕，该收工了——嗯？$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030402
					],
					"speakerTitle": "星火"
				},
				{
					"id": 400030402,
					"content": "你们是什么人？$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030403
					],
					"speakerTitle": "星火"
				},
				{
					"id": 400030403,
					"content": "是嘉义让我们来找你的，他说…$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400030404,
					"content": "原来如此。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030405
					],
					"speakerTitle": "星火"
				},
				{
					"id": 400030405,
					"content": "感谢你们对总务司工作的支持，这件事我们记下了，很快就会提上日程。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030406
					],
					"speakerTitle": "星火"
				},
				{
					"id": 400030406,
					"content": "那么，我们在璃月港有缘再见吧，热心的旅行者。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030407
					],
					"speakerTitle": "星火"
				},
				{
					"id": 400030407,
					"content": "#{NICKNAME}，你有没有觉得…$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030408,
						400030413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400030408,
					"content": "总务司的态度不太上心。$UNRELEASED",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400030409
					]
				},
				{
					"id": 400030409,
					"content": "派蒙我也这么认为！$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400030410,
					"content": "本地人估计习惯了那些好吃的。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400030411,
					"content": "但流落荒野、在最惨的时候只能吃奇怪蘑菇维持生活的旅行者…$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400030412,
					"content": "对你来说，海灯节，意，义，非，凡！$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030416
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400030416,
					"content": "所以我们再去昨天目击的地点看看吧。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030417
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400030417,
					"content": "听巡捕大爷说，罪犯都喜欢回案发地点看看。罪犯的心理就是这样。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030418
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400030418,
					"content": "还没「案发」呢…$UNRELEASED",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400030419
					]
				},
				{
					"id": 400030419,
					"content": "所以说要抓紧时间啊，如果易燃品被人动了手脚，那案发的时候一切就都晚了！$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400030413,
					"content": "还是需要我们来解决问题。$UNRELEASED",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400030414
					]
				},
				{
					"id": 400030414,
					"content": "我也这么认为！$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400030415,
					"content": "根据我们四处冒险的经验，这件事还是负责到底比较好。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030416
					],
					"speakerTitle": "派蒙"
				}
			]
		},
