			"trigger": {
				"objectNames": [
					"嘉义"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400030201,
					"content": "你们…哦，对了，是昨天来提醒险情的二位。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030202
					],
					"speakerTitle": "嘉义"
				},
				{
					"id": 400030202,
					"content": "唉…实不相瞒，海灯节期间，总务司事务繁杂，暂时抽不出人手来排查。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030203
					],
					"speakerTitle": "嘉义"
				},
				{
					"id": 400030203,
					"content": "欸？怎么这样——$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400030204,
					"content": "真对不住，难得你们这么热心提供情报…容我想想…也许…$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030205
					],
					"speakerTitle": "嘉义"
				},
				{
					"id": 400030205,
					"content": "也许，我们有一个小队能帮上忙。他们手上的任务，今天只剩最后一个了。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030206
					],
					"speakerTitle": "嘉义"
				},
				{
					"id": 400030206,
					"content": "他们在归离原清剿怪物，如果你们能联系上他们的话…$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嘉义"
				}
			]
		},
		{
			"id": 4000304,
			"completionStepIds": [
				4000304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4000304",
							"2"
						],
						"stepId": 4000304,
						"stateName": "QUEST_STATE_UNFINISHED"
