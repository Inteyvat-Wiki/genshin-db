					"nextDialogs": [
						400030926
					]
				},
				{
					"id": 400030924,
					"content": "是那人留下的符号。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030925
					],
					"speakerTitle": "魈"
				},
				{
					"id": 400030926,
					"content": "并没有什么印象呢。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030927
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400030927,
					"content": "那就努力向我展示，你们能做到哪一步吧。$UNRELEASED",
