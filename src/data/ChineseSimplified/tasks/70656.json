			"dialogs": [
				{
					"id": 706560101,
					"content": "你好，你是来挑战面前这个秘境的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706560102,
						706560103
					],
					"speakerTitle": "卜劳恩"
				},
				{
					"id": 706560102,
					"content": "有点兴趣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706560104
					]
				},
				{
					"id": 706560104,
					"content": "那正好，就由我来介绍一下吧，我是冒险家协会的卜劳恩，负责看护这个秘境的入口。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706560105
					],
					"speakerTitle": "卜劳恩"
				},
				{
					"id": 706560105,
					"content": "根据冒险家协会的记录，它好像只会在特定的时间出现。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706560106
					],
					"speakerTitle": "卜劳恩"
				},
				{
					"id": 706560106,
					"content": "正好现在是风花节，我们把里面稍加改造，变成了一项特别的挑战，向所有人开放。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706560107
					],
					"speakerTitle": "卜劳恩"
				},
				{
					"id": 706560107,
					"content": "不会有危险吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706560108
					]
				},
				{
					"id": 706560108,
					"content": "没事，这是以庆祝节日为目的举办的特别活动，如果是没有冒险经验的人参加的话，会有资深冒险家全程陪同。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706560109
					],
					"speakerTitle": "卜劳恩"
				},
				{
					"id": 706560109,
					"content": "不过，你们的冒险经验如此丰富，应该不需要我们帮忙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706560110
					],
					"speakerTitle": "卜劳恩"
				},
				{
					"id": 706560110,
					"content": "你可以独自深入秘境探索，也可以邀请你的朋友，总之，只要最终通过，就可以获得一些奖励。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706560111,
						706560112
					],
					"speakerTitle": "卜劳恩"
				},
				{
					"id": 706560111,
					"content": "明白了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706560113
					]
				},
				{
					"id": 706560113,
					"content": "那我就不耽误时间了，祝你们在里面玩得愉快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卜劳恩"
				},
				{
					"id": 706560112,
					"content": "有奖励的话可以试试。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706560113
					]
				},
				{
					"id": 706560103,
					"content": "好像是个特殊的秘境。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706560104
					]
				}
			]
		}
	]
