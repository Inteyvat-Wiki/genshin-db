			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"禁闭室"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 102020401,
					"content": "猜猜我是谁？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102020402,
					"content": "啊，是小派蒙的声音！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020403,
						102020404
					],
					"speakerTitle": "禁闭室"
				},
				{
					"id": 102020403,
					"content": "要不要我们放你出去？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020405
					]
				},
				{
					"id": 102020405,
					"content": "好呀那就——不，不对，可莉是真心在反省的，不要诱惑我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020406
					],
					"speakerTitle": "禁闭室"
				},
				{
					"id": 102020406,
					"content": "禁闭期间，我会留在这里，做羽球节特制版的「宝物」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020407
					],
					"speakerTitle": "禁闭室"
				},
				{
					"id": 102020407,
					"content": "「宝物」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102020408,
					"content": "嘿嘿…我专门做成了羽球的形状呢！很可爱的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020409,
						102020410
					],
					"speakerTitle": "禁闭室"
				},
				{
					"id": 102020409,
					"content": "羽球形状的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020411
					]
				},
				{
					"id": 102020411,
					"content": "等到了羽球节的时候，嗯！大家一定会喜欢的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020412
					],
					"speakerTitle": "禁闭室"
				},
				{
					"id": 102020412,
					"content": "唉，要是这段话被琴团长听见了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102020413,
					"content": "她的禁闭时间，估计又要加长了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102020410,
					"content": "其实还是炸弹吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020411
					]
				},
				{
					"id": 102020404,
					"content": "要给你带点吃的吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020405
					]
				}
			]
		}
	]
}