			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"琴"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 102020101,
					"content": "啊，可莉也在这里！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102020102,
					"content": "我…呜呜呜，我自首。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020103
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 102020103,
					"content": "欸？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102020104,
					"content": "我…我的炸弹…炸弹炸伤了人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020105
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 102020105,
					"content": "呜呜…违反了生存守则，我肯定看不到明天的太阳了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020106
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 102020107,
					"content": "等等，这里有误会。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020108
					]
				},
				{
					"id": 102020106,
					"content": "可莉，你先回答我。伤员呢，伤员人在哪里？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020107
					],
					"speakerTitle": "琴"
				},
				{
					"id": 102020109,
					"content": "可莉炸飞的，是深渊法师。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020110
					]
				},
				{
					"id": 102020108,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020109
					],
					"speakerTitle": "琴"
				},
				{
					"id": 102020110,
					"content": "但…但是毛茸茸只是偷了东西而已，我的炸弹却把他给…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020111
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 102020111,
					"content": "啊…我之前说深渊法师是「坏人」，只是一种比喻啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102020112,
					"content": "深渊法师不是人类。它们是…唔，与人类为敌的坏家伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102020113,
					"content": "毛茸茸…与人类为敌？是坏家伙？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020114
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 102020114,
					"content": "欸，欸？！脑…脑袋跟不上了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020115
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 102020115,
					"content": "嗯，这是我的疏忽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020116
					],
					"speakerTitle": "琴"
				},
				{
					"id": 102020116,
					"content": "因为你还太小，我之前从没有把这些告诉过你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020117
					],
					"speakerTitle": "琴"
				},
				{
					"id": 102020118,
					"content": "难道是因为「最强的宝物」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020119
					]
				},
				{
					"id": 102020117,
					"content": "实际上，深渊教团的怪物们，是侵扰着蒙德的威胁，最近格外活跃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020118
					],
					"speakerTitle": "琴"
				},
				{
					"id": 102020119,
					"content": "对哦，我明白了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102020120,
					"content": "它们就是听到了宝物的流言，才盯上可莉的呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102020121,
					"content": "就像，就像我最初也会想得到…啊不，想知道这宝贝一样！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102020122,
					"content": "所以…所以说！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020123
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 102020123,
					"content": "看在你这次的功劳上，下次的羽球节，就允许你一起参加吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020124
					],
					"speakerTitle": "琴"
				},
				{
					"id": 102020125,
					"content": "真是歪打正着。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020127
					]
				},
				{
					"id": 102020126,
					"content": "真为你高兴。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020127
					]
				},
				{
					"id": 102020124,
					"content": "羽球节！！哇！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020125,
						102020126
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 102020127,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}到时候也一定要来哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020128
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 102020128,
					"content": "欸嘿，圆满的结局！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102020129,
					"content": "不过…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020131
					],
					"speakerTitle": "琴"
				},
				{
					"id": 102020130,
					"content": "不过？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102020131,
					"content": "可莉，你原先的「宝物」，藏在了哪里？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020132
					],
					"speakerTitle": "琴"
				},
				{
					"id": 102020132,
					"content": "唔唔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020133
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 102020133,
					"content": "是不是又想去炸星落湖的鱼了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020134
					],
					"speakerTitle": "琴"
				},
				{
					"id": 102020134,
					"content": "我，我不是！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020135
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 102020136,
					"content": "（可是琴团长也看得见啊…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020137
					]
				},
				{
					"id": 102020135,
					"content": "（她在拼命给我们使眼色呢…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020136
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102020137,
					"content": "可——莉——？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020138
					],
					"speakerTitle": "琴"
				},
				{
					"id": 102020138,
					"content": "呀！可莉这就去<color=#00E1FFFF>禁闭室</color>报到…呜呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020139
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 102020139,
					"content": "不知道可莉一个人关禁闭，会不会无聊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
