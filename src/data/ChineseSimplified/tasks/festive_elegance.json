	"talks": [
		{
			"id": 4005401,
			"completionStepIds": [
				4005401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4005401",
							"2"
						],
						"stepId": 4005401,
						"stateName": "QUEST_STATE_UNFINISHED"
