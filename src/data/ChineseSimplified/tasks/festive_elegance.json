				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凯瑟琳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400540101,
					"content": "凯瑟琳，听说有新委托需要我们出马啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400540102,
					"content": "没错，这里现在有一项委托人「指名」的工作要交给你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540103
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 400540103,
					"content": "「指名」？听起来还有点紧张，是和什么有关的工作呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400540104,
					"content": "呵呵，请放心吧，这次的工作并不危险。二位或许已经有所耳闻，近期，稻妻将举办一场名为「光华容彩祭」的盛大祭典。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540105
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 400540105,
					"content": "好耶，是祭典！说起来，我们之前还没在稻妻参加过节日呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400540106,
					"content": "此次祭典由社奉行与八重神子大人筹备，请求二位进行协助的，正是八重大人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540107
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 400540107,
					"content": "原来是神子。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400540108
					]
				},
				{
					"id": 400540108,
					"content": "嘻嘻，神子的脑袋里有许多稀奇古怪的主意，办祭典一定会很有意思的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400540109,
					"content": "我们不如这就去鸣神大社找她，看看她到底想给我们什么任务吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400540110,
					"content": "二位不必跑那么远，八重大人现在就在花见坂的八重堂。她之前交代过，让我请你们到那里与她会合。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540111
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 400540111,
					"content": "原来她就在附近，那我们走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4005402,
			"completionStepIds": [
				4005402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4005402",
							"2"
						],
						"stepId": 4005402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"八重神子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400540201,
					"content": "荒谷，黑田，你们那边情况如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540202
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540202,
					"content": "报告八重大人，八重堂的书籍与个人委托印刷物，昨天下午已经全部装订完毕发出了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540203
					],
					"speakerTitle": "荒谷"
				},
				{
					"id": 400540203,
					"content": "嗯，不错。村田呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540204
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540204,
					"content": "天顶屋与远航之风发来了联络，《转生成为雷电将军，然后天下无敌》与《拜托了我的狐仙宫司》的相关物料都已经就位！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540205
					],
					"speakerTitle": "村田"
				},
				{
					"id": 400540205,
					"content": "很好。小野寺？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540206
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540206,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540207
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 400540207,
					"content": "小、野、寺？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540208
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540208,
					"content": "啊，在…我在！报告八重大人，新刊发售会的准备一切正常！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540209
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 400540209,
					"content": "小野寺，这次发售会的企划是你提出的，换言之你就是我们的「大将」，你可要拿出点自信来啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540210
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540210,
					"content": "放心吧，这个企划一定能大获成功，我可是非常看好它的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540211
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540211,
					"content": "这两天我特批你假期，你就抓紧时间好好休息一下吧，毕竟发售会当天可有你忙的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540212
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540212,
					"content": "八重大人，非常感谢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540213
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 400540213,
					"content": "好了，大家都清楚自己的任务了吧。时间紧急，立刻行动起来，解散！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540215
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540215,
					"content": "你们好啊，小家伙们，看样子是已经接到我的委托咯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540216
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540216,
					"content": "好你个神子，都要举办祭典了你也不回鸣神大社，竟然还有功夫在这儿折腾你的轻小说事业。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400540217,
					"content": "你找我们来，该不会是想把筹备祭典的事扔给我们代劳吧？哼，这种委托我是不会接的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400540218,
					"content": "对，不会接的！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400540219
					]
				},
				{
					"id": 400540219,
					"content": "哎呀呀，我真是好伤心啊，明明人家就正在为祭典的事操劳，却被你们当成了不务正业。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540220
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540220,
					"content": "小家伙们，是谁告诉你们，祭典就一定会和鸣神大社有关呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540221
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540221,
					"content": "咦，难道不是这样吗？毕竟这里可是稻妻呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400540222,
					"content": "虽说这话是没错，不过现在，解除锁国令的稻妻，已经不是从前那个渴望一成不变的国度了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540223
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540223,
					"content": "所以，比起循规蹈矩的传统祭典，这次我与社奉行决定另辟蹊径，打造一场既有稻妻风格，又与众不同的国际化文化盛会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540224,
						400540225
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540224,
					"content": "国际化的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400540226
					]
				},
				{
					"id": 400540226,
					"content": "呵呵，这件事就要从容彩祭的来历说起了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540227
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540227,
					"content": "传说在古代稻妻，曾经活跃着五位能歌善赋的诗人，世人称他们为「五歌仙」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540228
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540228,
					"content": "每年，五歌仙都会派出其中一位，将五人所作的诗集呈给将军品鉴，此事一时传为雅谈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540229
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540229,
					"content": "托他们的福，稻妻的文化也在当时极为繁荣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540230
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540230,
					"content": "后来人们以他们为原型，创作了许多风格各异的五歌仙故事，还发展出了「容彩祭」，感谢创作为我们的生活增添乐趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540231
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540231,
					"content": "果然是个文化气息浓郁的节日呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540232
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400540232,
					"content": "嗯，用古话讲就是「风雅」吧。只可惜随着时间流逝，五歌仙与这一祭典已经逐渐被人们淡忘了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540233
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540233,
					"content": "所以这次，我决心重振容彩祭——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540234
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540234,
					"content": "举办一场以轻小说创作为核心的文化交流展！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540235
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540235,
					"content": "欸，等一下…轻小说？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540236
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400540236,
					"content": "说好的「风雅」呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400540237
					]
				},
				{
					"id": 400540237,
					"content": "不要露出这种难以置信的表情。在古代，诗歌也是一种流行的载体，只不过在今天，这种流行变成了「轻小说」而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540238
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540238,
					"content": "重要的不是形式，而是「创作」本身。如果一味盯着过去，拘泥于固定的形式或内容，可是写不出好作品的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540239
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540239,
					"content": "说起来，你不觉得「关注当下」这个内核也很符合现在的稻妻吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540240
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540240,
					"content": "而且还能借此机会，让提瓦特通过轻小说重新认识稻妻，可谓一举两得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540241,
						400540242
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540241,
					"content": "这大概就是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400540243
					]
				},
				{
					"id": 400540243,
					"content": "呜哇，好险…要不是你提醒，我就要被神子绕进去了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540244
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400540244,
					"content": "哼，神子，你可骗不了我们，凭我们对你的了解，这绝对是你基于个人趣味做出的决定！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540245
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400540245,
					"content": "呵呵，我从不否认自己的爱好。不过，无论小说还是祭典，以新颖的概念抓人眼球都是必须的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540246
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540246,
					"content": "怎么样，你们就不好奇，在容彩祭上能见到什么有趣的东西吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540247
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540247,
					"content": "唔…好奇！老实说非常好奇！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540248
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400540248,
					"content": "呵呵，走，你们这就跟我到离岛的会场去看看吧，保证能让人耳目一新。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540249
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540249,
					"content": "而且在那边，还有专人要讲解这次的任务呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540242,
					"content": "一本正经地胡说八道？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400540243
					]
				},
				{
					"id": 400540225,
					"content": "文化盛会？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400540226
					]
				}
			]
		},
		{
			"id": 4005403,
			"completionStepIds": [
				4005404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4005404",
							"2"
						],
						"stepId": 4005404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"八重神子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400540301,
					"content": "…在容彩祭期间，远国监司周围将会承担轻小说的主展区功能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540302
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540302,
					"content": "届时不仅有大量官方与同人作品参展，还有限定赠品、抽奖、新刊发售会等丰富的活动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540303
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540303,
					"content": "万国商会前的这个小广场，祭典期间会被称作「五歌仙广场」，附近的店铺将贩售与轻小说联动的特别商品，请一定不要错过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540304
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540304,
					"content": "哇，该怎么说呢，虽然和普通的祭典感觉不太一样，但感到了另一种层面的厉害…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400540305,
					"content": "嗯，「轻小说浓度过高」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400540306
					]
				},
				{
					"id": 400540306,
					"content": "咦，神子，广场中心这些空白的板子是什么呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400540307,
					"content": "嗯，这些呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540308
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540308,
					"content": "八重大人此前说会有可靠的帮手前来协助，果然是指你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540309
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 400540309,
					"content": "旅行者，派蒙，有段时间没见了，你们最近可好？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540310
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 400540310,
					"content": "是绫人！这次的容彩祭，连你这个大忙人也亲自出马了呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400540311,
					"content": "筹备祭典是社奉行分内之事，容彩祭又倾注了八重大人的心血，我也自当亲力亲为。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540312
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 400540312,
					"content": "呵呵，绫人，大家都是熟人了，干嘛这么客气呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540313
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540313,
					"content": "我们刚好说到这里的展板，它们跟小家伙们的任务也有些关系，你就来仔细讲讲吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540314
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540314,
					"content": "你们两个应该已经知道容彩祭来源于五歌仙，这五块展板，正是为了绘制他们的画像设置的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540315
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 400540315,
					"content": "此次容彩祭，不仅是稻妻解除锁国令后的第一次大型祭典，并且还与文化艺术相关。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540316
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 400540316,
					"content": "因此社奉行出面，邀请了数位他国的文化名人前来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540317
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 400540317,
					"content": "比如应邀绘制这几幅画像的，就是一位从蒙德远道而来的画家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540318
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 400540318,
					"content": "各位嘉宾在稻妻的食宿社奉行会帮忙安排，但客人远到异乡，难免会不习惯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540319
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 400540319,
					"content": "这时候如果能有一位既熟悉稻妻，又了解提瓦特其他国家的人作为接引向导，就再好不过了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540320,
						400540321
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 400540320,
					"content": "我明白了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400540322
					]
				},
				{
					"id": 400540322,
					"content": "正是。我们希望二位能从港口接引嘉宾们到万国商会下榻，并提供适当的帮助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540323
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 400540323,
					"content": "这份「到港时刻表」上，写明了嘉宾们乘坐船只的详细信息，只要按照上面的时间到港口便可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540324
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 400540324,
					"content": "好啦，时候不早了，我还要和编辑们开会，就先走一步咯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540325
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540325,
					"content": "祭典期间，八重堂的编辑大多都会待在远国监司附近，你们如果有事就过去找他们吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540326
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540326,
					"content": "二位，这次祭典需三奉行通力合作，有许多琐事需要处理，我也先失陪了。接引嘉宾一事，就拜托你们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 400540321,
					"content": "这就是我们的任务。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400540322
					]
				}
			]
		}
	]
}