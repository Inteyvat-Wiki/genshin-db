			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿祇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400510101,
					"content": "阿祇，我们做到了哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400510102,
					"content": "我已经看到你们的成果了。三座塔确实都处理完了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510103
					],
					"speakerTitle": "阿祇"
				},
				{
					"id": 400510103,
					"content": "伤员和军士们因为渊下宫环境的恢复，都已经加速撤离了。呃，大部分都撤离了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510104
					],
					"speakerTitle": "阿祇"
				},
				{
					"id": 400510104,
					"content": "不过似乎发生了一些没有预料到的事情。两位请随我来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿祇"
				}
			]
		},
		{
			"id": 4005102,
			"completionStepIds": [
				4005102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4005102",
							"2"
						],
						"stepId": 4005102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿祇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400510201,
					"content": "大日御舆内部出现了翻涌的黑暗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400510202,
					"content": "本来按照常理，现在渊下宫应该全境都恢复如初了才对…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510203
					],
					"speakerTitle": "阿祇"
				},
				{
					"id": 400510203,
					"content": "很遗憾，现在这里变成了最危险的地方。我也不知道为什么会这样，应该怎么办了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510204
					],
					"speakerTitle": "阿祇"
				},
				{
					"id": 400510204,
					"content": "不过我能告诉你幕后黑手现在正在何处。只能麻烦你前去对付那个幕后黑手，让他把计划全盘托出了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510205
					],
					"speakerTitle": "阿祇"
				},
				{
					"id": 400510205,
					"content": "这是怎么办到的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400510206,
					"content": "我一直在观察黑雾的流动，大概还是能看出一些异样的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510207
					],
					"speakerTitle": "阿祇"
				},
				{
					"id": 400510207,
					"content": "有一个微弱的涡旋，之前在持续吸引黑雾。应该是他对深渊之力有所需求引发的微弱流动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510208
					],
					"speakerTitle": "阿祇"
				},
				{
					"id": 400510208,
					"content": "那个家伙很危险，一般龙蜥可能都不是他的对手…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510209,
						400510210
					],
					"speakerTitle": "阿祇"
				},
				{
					"id": 400510209,
					"content": "放心吧，本来就准备揍他。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400510211
					]
				},
				{
					"id": 400510211,
					"content": "如此甚好，那么就麻烦你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510212
					],
					"speakerTitle": "阿祇"
				},
				{
					"id": 400510212,
					"content": "如果推测没错的话，他应该就在<color=#00E1FFFF>图书馆</color>一带。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿祇"
				},
				{
					"id": 400510210,
					"content": "放心吧，那家伙本来就喜欢挨揍。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400510211
					]
				}
			]
		},
		{
			"id": 4005103,
			"completionStepIds": [
				4005103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4005103",
							"2"
						],
						"stepId": 4005103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"自称「渊上」之物"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400510301,
					"content": "嚯，该说意外呢，还是说毫不意外呢。在这种黑暗之中，仍然要执意前行，破开雾霾，来到我的面前。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510302
					],
					"speakerTitle": "自称「渊上」之物"
				},
				{
					"id": 400510302,
					"content": "如果还有人能做到这点，那恐怕就只有你了。但是，你居然会和它们联手？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510303
					],
					"speakerTitle": "自称「渊上」之物"
				},
				{
					"id": 400510303,
					"content": "你又想靠着聊天拖延时间了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400510304,
					"content": "…这样啊，看起来你们是真的不知道啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510305
					],
					"speakerTitle": "自称「渊上」之物"
				},
				{
					"id": 400510305,
					"content": "见到我血气上涌可以理解，但是跑了这么久还这么精力充沛，还真的有点麻烦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510306
					],
					"speakerTitle": "自称「渊上」之物"
				},
				{
					"id": 400510306,
					"content": "陪你们运动一下吧。直到你能停下来听我说话为止。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "自称「渊上」之物"
				}
			]
		},
		{
			"id": 4005105,
			"completionStepIds": [
				4005105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4005105",
							"2"
						],
						"stepId": 4005105,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"自称「渊上」之物"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400510501,
					"content": "停一下停一下！再打我要死了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510502
					],
					"speakerTitle": "自称「渊上」之物"
				},
				{
					"id": 400510502,
					"content": "冲着这个来的！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400510503
					]
				},
				{
					"id": 400510503,
					"content": "那个女人，细长瞳孔的女人，她自称的名字是什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510504
					],
					"speakerTitle": "自称「渊上」之物"
				},
				{
					"id": 400510504,
					"content": "欸，你为什么知道？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400510505,
					"content": "她叫什么名字？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510506
					],
					"speakerTitle": "自称「渊上」之物"
				},
				{
					"id": 400510506,
					"content": "她自称，阿祇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400510507,
					"content": "哼，明明只是条蜥蜴，学人学得有模有样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510508
					],
					"speakerTitle": "自称「渊上」之物"
				},
				{
					"id": 400510508,
					"content": "蜥蜴…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400510509
					]
				},
				{
					"id": 400510509,
					"content": "你也想到了，对吧。深海龙蜥可是很聪明，而且进化很快的族群。早在千年之前，就有过这种传说了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510510
					],
					"speakerTitle": "自称「渊上」之物"
				},
				{
					"id": 400510510,
					"content": "——龙蜥人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510511
					],
					"speakerTitle": "自称「渊上」之物"
				},
				{
					"id": 400510511,
					"content": "龙蜥…人？听起来像是我会取的外号。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510512
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400510512,
					"content": "很久以前，渊下宫就有这样的传说了。深海龙蜥被击退之后，为了生存开始了新的进化。他们开始模仿胜者的姿态。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510513
					],
					"speakerTitle": "自称「渊上」之物"
				},
				{
					"id": 400510513,
					"content": "最后出现了除了瞳孔之外，和人类别无二致的龙蜥族群——龙蜥人。传说他们渗透进了渊下宫，替换掉了要人们的位置。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510514
					],
					"speakerTitle": "自称「渊上」之物"
				},
				{
					"id": 400510514,
					"content": "怎么样，有想起谁吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510515
					],
					"speakerTitle": "自称「渊上」之物"
				},
				{
					"id": 400510515,
					"content": "阿祇的瞳孔，好像听说确实是竖着的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510516
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400510516,
					"content": "蜥蜴在光线充足的地方，眼瞳就是细长的一条竖线哦。这个可是她背叛你们的铁证。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510517
					],
					"speakerTitle": "自称「渊上」之物"
				},
				{
					"id": 400510517,
					"content": "但是她一直在帮助我们啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510518
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400510518,
					"content": "她只是在利用你们对我复仇罢了，毕竟我也背叛了它们啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510519
					],
					"speakerTitle": "自称「渊上」之物"
				},
				{
					"id": 400510519,
					"content": "我之前与龙蜥结成过同盟。我可以用黑雾笼罩整个渊下宫，方便它们的精锐潜下大日御舆，拯救被囚禁的同族。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510520
					],
					"speakerTitle": "自称「渊上」之物"
				},
				{
					"id": 400510520,
					"content": "作为协助，它们许可深渊教团在它们领地上通行，并且出功出力同我一起改造了三塔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510521
					],
					"speakerTitle": "自称「渊上」之物"
				},
				{
					"id": 400510521,
					"content": "但是它们没有预料到，深渊的黑雾对元素生物来说是更加可怕的剧毒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510522
					],
					"speakerTitle": "自称「渊上」之物"
				},
				{
					"id": 400510522,
					"content": "所以，龙蜥们认为这是背叛？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510523
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400510523,
					"content": "我自己都认为这个是背叛啊。毕竟要是龙蜥能在深渊力量下活蹦乱跳，深渊教团岂不是很没面子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510524
					],
					"speakerTitle": "自称「渊上」之物"
				},
				{
					"id": 400510524,
					"content": "你这家伙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510525
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400510525,
					"content": "现在的情况就是那个女人利用完你们，转手就自己利用大日御舆的力量压制珊瑚虫，制造黑暗掩护龙蜥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510526
					],
					"speakerTitle": "自称「渊上」之物"
				},
				{
					"id": 400510526,
					"content": "它们估计现在正在潜下深处，准备拯救那些被囚禁的同伴吧。如此一来，血枝珊瑚的来源就断绝了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510527
					],
					"speakerTitle": "自称「渊上」之物"
				},
				{
					"id": 400510527,
					"content": "虽然那些深海龙蜥确实很可怜，但是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510528
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400510528,
					"content": "如果你们还打算保护海祇岛的未来，就得赶快咯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510529
					],
					"speakerTitle": "自称「渊上」之物"
				},
				{
					"id": 400510529,
					"content": "使用我之前留下的机关，引导光路去驱散大日御舆的黑暗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510530
					],
					"speakerTitle": "自称「渊上」之物"
				},
				{
					"id": 400510530,
					"content": "你这个人说话我们再也不会相信了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510531
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400510531,
					"content": "真是的，现在难道你们还有的选吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510532
					],
					"speakerTitle": "自称「渊上」之物"
				},
				{
					"id": 400510532,
					"content": "反正我这次来依旧是一无所获。不过无所谓了，我在教团之中也不过是边缘人物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510533
					],
					"speakerTitle": "自称「渊上」之物"
				},
				{
					"id": 400510533,
					"content": "和那些围着殿下团团转的家伙不同，我总是执着于一些无所谓的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510534
					],
					"speakerTitle": "自称「渊上」之物"
				},
				{
					"id": 400510534,
					"content": "啊，时间差不多拖延到位了。这次我也先走一步了，应该不会再见了吧。这个东西就作为临别赠礼给你吧，我之前在大日御舆拿到的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510535
					],
					"speakerTitle": "自称「渊上」之物"
				},
				{
					"id": 400510535,
					"content": "这个东西，似乎和心海给我们的是一套欸。不对，不是在意这个的时候了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510536
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400510536,
					"content": "真是生气啊，这家伙又跑了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510537
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400510537,
					"content": "我觉得他说的再有道理我们也不能相信，先回去找阿祇问问吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4005111,
			"completionStepIds": [
				4005111
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4005111",
							"2"
						],
						"stepId": 4005111,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400511101,
					"content": "震惊，居然真的能解决问题！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400511102,
					"content": "这一次那个家伙没有骗我们呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400511103,
					"content": "严格来说，他没怎么骗过我们。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400511104
					]
				},
				{
					"id": 400511104,
					"content": "按照他那套诡辩来说是这样啦，你怎么感觉有点和他互相理解了！这可不行啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400511105,
					"content": "现在大日御舆的通路应该被再次打开了，我们赶紧下去看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4005115,
			"completionStepIds": [
				4005115
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4005115",
							"2"
						],
						"stepId": 4005115,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿祇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400511501,
					"content": "是，是阿祇！她在大日御舆面前想干什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400511502,
					"content": "既然你们返回了这里，那我想问问，我们的营救成功了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511503
					],
					"speakerTitle": "阿祇"
				},
				{
					"id": 400511503,
					"content": "有一些年幼的龙蜥已经被救走了。但是老弱的龙蜥在我们打败精英之后，躲回了水里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400511504,
					"content": "阿祇，你真的是龙蜥吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400511505,
					"content": "我不准备和你多解释什么。虽然我有和你们沟通的能力，但是我已经明白了，和人的交流只能以背叛作结。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511506
					],
					"speakerTitle": "阿祇"
				},
				{
					"id": 400511506,
					"content": "我们两个物种，只能够一直厮杀下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511507
					],
					"speakerTitle": "阿祇"
				},
				{
					"id": 400511507,
					"content": "在我离开之前，我要摧毁这个灯塔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511508
					],
					"speakerTitle": "阿祇"
				},
				{
					"id": 400511508,
					"content": "凭你做得到吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400511509
					]
				},
				{
					"id": 400511509,
					"content": "你不要靠近了，也不要妄图偷袭我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511510
					],
					"speakerTitle": "阿祇"
				},
				{
					"id": 400511510,
					"content": "这座高塔…似乎能听到我的愿望。只要我想，它就可以为了我变化光暗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511511
					],
					"speakerTitle": "阿祇"
				},
				{
					"id": 400511511,
					"content": "甚至，只要我想，它就可以在我面前崩毁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511512
					],
					"speakerTitle": "阿祇"
				},
				{
					"id": 400511512,
					"content": "只需要差不多捏紧拳头程度的念想，我就可以摧毁这个给龙蜥带来痛苦的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511513
					],
					"speakerTitle": "阿祇"
				},
				{
					"id": 400511513,
					"content": "但是，为什么…无法动手…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511514
					],
					"speakerTitle": "阿祇"
				},
				{
					"id": 400511514,
					"content": "#呜啊，这可比失去血枝珊瑚要严重多了！{NICKNAME}，你有什么办法吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511515,
						400511516
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400511515,
					"content": "阿祇，你认得这个吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400511517
					]
				},
				{
					"id": 400511517,
					"content": "这是…啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511518
					],
					"speakerTitle": "阿祇"
				},
				{
					"id": 400511518,
					"content": "阿祇想到了自己的挂坠，并将其与碎片拼合在了一起。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400511519
					]
				},
				{
					"id": 400511519,
					"content": "这是，三条蛇纠缠在一起样式的…挂坠？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511520
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400511520,
					"content": "这条挂坠，自我记事起就在我的身边。为什么能和你的两块挂坠拼合？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511521
					],
					"speakerTitle": "阿祇"
				},
				{
					"id": 400511521,
					"content": "你心里应该有自己的答案了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400511522
					]
				},
				{
					"id": 400511522,
					"content": "笑话，你是想说…想说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511523
					],
					"speakerTitle": "阿祇"
				},
				{
					"id": 400511523,
					"content": "我不太明白…这块是心海的挂坠，这一块来自大日御舆，阿祇的那块从小就伴在身边…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511524
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400511524,
					"content": "你属于海祇岛。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400511525
					]
				},
				{
					"id": 400511525,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511526
					],
					"speakerTitle": "阿祇"
				},
				{
					"id": 400511526,
					"content": "我从小就和龙蜥一起长大。除了这个挂坠伴身之外，还有几箱子书卷。我通过它们学习了人类语言和文字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511527
					],
					"speakerTitle": "阿祇"
				},
				{
					"id": 400511527,
					"content": "但是渊下宫在不久之后，就一个人类都没有了。空空如也。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511528
					],
					"speakerTitle": "阿祇"
				},
				{
					"id": 400511528,
					"content": "直到最近，我才有机会和人类接触。直到最近，我才知道书卷里的内容和意义。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511529
					],
					"speakerTitle": "阿祇"
				},
				{
					"id": 400511529,
					"content": "阿祇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511530
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400511530,
					"content": "你们人类书上有句俗话，我一直不明白。不过我刚才理解了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511531
					],
					"speakerTitle": "阿祇"
				},
				{
					"id": 400511531,
					"content": "「人属于他出生的地方，畜生属于它吃饱的地方。」我是龙蜥，我不是人。所以我要回去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511532
					],
					"speakerTitle": "阿祇"
				},
				{
					"id": 400511532,
					"content": "大日御舆，就随便了吧。总有一天，我们还会回来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511534
					],
					"speakerTitle": "阿祇"
				},
				{
					"id": 400511534,
					"content": "阿祇，走掉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511535
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400511535,
					"content": "所以最后为什么她突然改变心意了啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511536
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400511536,
					"content": "或许心海能明白。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400511537
					]
				},
				{
					"id": 400511537,
					"content": "嗯嗯，没错。如果是那个心海的话，应该预料到了这个情况，才会把碎片挂坠给我们吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511538
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400511538,
					"content": "现在问题也算是圆满解决了。我们回去告诉她吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400511516,
					"content": "阿祇，请收下这个。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400511517
					]
				}
			]
		},
		{
			"id": 4005116,
			"completionStepIds": [
				4005116
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4005116",
							"2"
						],
						"stepId": 4005116,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"珊瑚宫心海"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400511601,
					"content": "喂，心海！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400511602,
					"content": "啊，你们回来了。刚才撤回的军士们和我说了一下前情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511603
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 400511603,
					"content": "你和那个名叫阿祇的巫女合作，成功清除了黑雾，但是大日御舆却突发了异变。是吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511604
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 400511604,
					"content": "是这样的。后面发生了一些很离奇的事情哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400511605,
					"content": "和心海讲述了之后发生的事情。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400511606
					]
				},
				{
					"id": 400511606,
					"content": "这样吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511607
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 400511607,
					"content": "唔，有点对不起心海。我们把你给我们的挂坠送出去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511608
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400511608,
					"content": "不用介意。就像我之前说的，海祇岛已经不再需要它了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511609
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 400511609,
					"content": "它是最初海祇大御神在渊下宫整顿朝官，改革制度时留下的东西。三枚挂坠分别留给大日御舆、珊瑚宫一脉和海祇御使。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511610
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 400511610,
					"content": "本意也是想让乡人、地走官和神使之间能互相监督。但是如今除去乡人后代兴旺，其他两系凋敝。这个挂坠也没什么用处了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511611
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 400511611,
					"content": "你说海祇御使…似乎也有士兵认为阿祇是海祇神的使者来着？可惜竖眼瞳其实是蜥蜴的特征，我们都被骗了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511612
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400511612,
					"content": "并不是哦。海祇御使的造像通常半人半蛇，用以象征他们乃是蛇神的眷属。但是后期海祇御使除去瞳孔，确实与人无异。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511613
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 400511613,
					"content": "反而龙蜥人、地底蜥蜴人的故事…从来就是小说里才会有的设定吧。珊瑚宫的机密文件里都没有这种东西存在的证据哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511614
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 400511614,
					"content": "啊，所以说，阿祇其实不是龙蜥？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511615
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400511615,
					"content": "海祇大御神耗尽力量创造海祇岛之后，力量逐渐衰弱。因此海祇御使不再诞生了。最后有记录的一位御使…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511616
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 400511616,
					"content": "被寄予厚望，能沟通龙蜥与人类的御使——她在婴孩时代，随同其监护巫女，在渊下宫边陲被龙蜥袭击，自此下落不明。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511617
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 400511617,
					"content": "很多人都认为她死了，不过也有一部分人认为她被龙蜥们抚养长大了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511618
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 400511618,
					"content": "御使一族对海祇民恩重如山。如今龙蜥和海祇岛不再有生存领土的争端，我真心地祝愿那位能找到自己的归处。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511619
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 400511619,
					"content": "原来阿祇的身世是这样的啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511620
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400511620,
					"content": "不过，如果血枝珊瑚的原理是这样的话，我作为珊瑚宫的现人神巫女，可能需要思考一个新的方法来对抗「圣土化」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511621
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 400511621,
					"content": "说回眼前。这次托你们的福，「圣土化」问题得到了解决。接下来的数十年里，海祇岛得到了太平。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511622
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 400511622,
					"content": "十分感谢你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚宫心海"
				}
			]
		},
