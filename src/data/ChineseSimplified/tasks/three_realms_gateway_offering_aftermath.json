					"nextDialogs": [
						400511705
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400511705,
					"content": "往好里想，海祇岛的军士大部分都撤走了。如果刚才真的有龙蜥来过这里，至少没人因此受伤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511706
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400511706,
					"content": "虽然想到那个家伙就生气，但是我们只能试一试了。去把光路引导到这里吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
