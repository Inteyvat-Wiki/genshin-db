			},
			"dialogs": [
				{
					"id": 741920201,
					"content": "呜呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920202
					],
					"speakerTitle": "夏诺蒂拉"
				},
				{
					"id": 741920202,
					"content": "夏诺蒂拉…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920203
					]
				},
				{
					"id": 741920203,
					"content": "#咦？{M#哥哥}{F#姐姐}…你是谁？我还以为，这里除了我谁也进不来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920204
					],
					"speakerTitle": "夏诺蒂拉"
				},
				{
					"id": 741920204,
					"content": "你为什么知道我的名字？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920205,
						741920207
					],
					"speakerTitle": "夏诺蒂拉"
				},
				{
					"id": 741920205,
					"content": "我们认识。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920206
					]
				},
				{
					"id": 741920206,
					"content": "骗人！你肯定也和那些怪物一样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夏诺蒂拉"
				},
				{
					"id": 741920207,
					"content": "（撒谎）是瑟琳让我来找你的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920208
					]
				},
				{
					"id": 741920208,
					"content": "是喔…老是让她这么担心，我真是个坏孩子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920209
					],
					"speakerTitle": "夏诺蒂拉"
				},
				{
					"id": 741920209,
					"content": "#我是{NICKNAME}，你还记得吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920210
					]
				},
				{
					"id": 741920210,
					"content": "#{NICKNAME}{M#哥哥}{F#姐姐}，我想起来了…虽然是个一口能吞下世界的大怪兽，但是很善良。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920211,
						741920213
					],
					"speakerTitle": "夏诺蒂拉"
				},
				{
					"id": 741920211,
					"content": "真没礼貌。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920212
					]
				},
				{
					"id": 741920212,
					"content": "对不起喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920214
					],
					"speakerTitle": "夏诺蒂拉"
				},
				{
					"id": 741920214,
					"content": "发生什么事情了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920215
					]
				},
				{
					"id": 741920215,
					"content": "我看到，有几个人，他们慢慢融化、变成了怪物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920216
					],
					"speakerTitle": "夏诺蒂拉"
				},
				{
					"id": 741920216,
					"content": "啊啊，好可怕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夏诺蒂拉"
				},
				{
					"id": 741920213,
					"content": "谢谢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920214
					]
				}
			]
		},
		{
