			"dialogs": [
				{
					"id": 741920401,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920402
					],
					"speakerTitle": "夏诺蒂拉"
				},
				{
					"id": 741920402,
					"content": "夏诺蒂拉？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920403
					]
				},
				{
					"id": 741920403,
					"content": "咦？你终于回来了！呜呜，我好担心，要是你一直回不来要怎么办…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920404
					],
					"speakerTitle": "夏诺蒂拉"
				},
				{
					"id": 741920404,
					"content": "你进去以后，我一直在外面等，等了好久、好久。我去找别的美露莘帮忙，但大家都不知道怎么办…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920405
					],
					"speakerTitle": "夏诺蒂拉"
				},
				{
					"id": 741920405,
					"content": "（…看来我也在这里待得够久了。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920406
					]
				},
				{
					"id": 741920406,
					"content": "我该走了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920407
					]
				},
				{
					"id": 741920407,
					"content": "#咦？{NICKNAME}，你要去哪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920408
					],
					"speakerTitle": "夏诺蒂拉"
				},
				{
					"id": 741920408,
					"content": "别担心。我找到夏诺蒂拉就回来。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920409
					]
				},
				{
					"id": 741920409,
					"content": "再稍微等我一下，好吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920410
					]
				},
				{
					"id": 741920410,
					"content": "虽然我知道，对你说这些也没用。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920411,
						741920412
					]
				},
				{
					"id": 741920411,
					"content": "不过，相信我。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920413
					]
				},
				{
					"id": 741920413,
					"content": "#{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夏诺蒂拉"
				},
				{
					"id": 741920412,
					"content": "毋须担心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920413
					]
				}
