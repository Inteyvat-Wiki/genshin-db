				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741920301,
					"content": "既然记忆能被制作成书，那么反过来，书本中的内容，应该也能被直接写入记忆…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920302
					],
					"speakerTitle": "夏诺蒂拉"
				},
				{
					"id": 741920302,
					"content": "夏诺蒂拉？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920303
					]
				},
				{
					"id": 741920303,
					"content": "#啊，是奇奇怪怪的{NICKNAME}{M#哥哥}{F#姐姐}。怎么了，找我有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920304
					],
					"speakerTitle": "夏诺蒂拉"
				},
				{
					"id": 741920304,
					"content": "你在说什么…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920305
					]
				},
				{
					"id": 741920305,
					"content": "嗯，不管怎么想，将「记忆」制作成书本都是相当不可思议的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920306
					],
					"speakerTitle": "夏诺蒂拉"
				},
				{
					"id": 741920306,
					"content": "制作这本书的人，一定将「记{RUBY#[D]妄想}忆」中的心情当作最为珍贵的事物，才能做出这样的书吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920307
					],
					"speakerTitle": "夏诺蒂拉"
				},
				{
					"id": 741920307,
					"content": "不过这样子的书，确实很难懂…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920308
					],
					"speakerTitle": "夏诺蒂拉"
				},
				{
					"id": 741920308,
					"content": "…而且，会对「读者」产生什么样的影响，也不知道。这可真是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夏诺蒂拉"
				}
			]
		},
