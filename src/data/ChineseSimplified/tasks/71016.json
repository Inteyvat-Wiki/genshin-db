			"dialogs": [
				{
					"id": 710160301,
					"content": "关于无名的宝藏",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160302
					]
				},
				{
					"id": 710160302,
					"content": "如果我的猜测没错，您上次拿来的那份东西，应该总共有三份。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160303
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710160303,
					"content": "将三份合起来，才是一个完整的物件。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160304
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710160304,
					"content": "如果您真能找齐，那我非常愿意出个好价钱收下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160305
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710160305,
					"content": "不过这东西年代实在太过久远，想要找齐…还是有些难度的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "琳琅"
				}
			]
		},
