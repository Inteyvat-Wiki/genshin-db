			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"琳琅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710160501,
					"content": "我找齐三份了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160502
					]
				},
				{
					"id": 710160502,
					"content": "您居然真的把这个搜集齐了？请让我看一看…确实，这三份的纹饰连在一起，确实是在描述「若陀龙王」的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160503
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710160503,
					"content": "看起来，这只鹤应该就是「理水叠山真君」了，这只鹿…也许是「削月筑阳真君」，但是剩下的这一个…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160504
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710160504,
					"content": "咦？最后的这个上面的纹饰好像…被人特意磨掉了形象，一点细节都看不出来。这第三位仙人到底是谁？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160505
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710160505,
					"content": "算了，这些事已经超出了我的知识范围了。但不管怎么说，这份「宝藏」已经完整了，应该能卖个好价钱了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160506
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710160506,
					"content": "怎么样，您是想要留个纪念，还是把这份「宝藏」出给我，卖个好价钱？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160507
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710160507,
