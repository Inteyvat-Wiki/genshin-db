			"dialogs": [
				{
					"id": 710160401,
					"content": "我去试试看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160402
					]
				},
				{
					"id": 710160402,
					"content": "好吧，如果您真的搜集齐全了，记得一定要拿来我看看。",
					"roleType": "TALK_ROLE_NPC",
