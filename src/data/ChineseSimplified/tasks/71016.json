				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"琳琅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710160201,
					"content": "关于无名的宝藏",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160202
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710160202,
					"content": "您拿的这东西…看起来倒不错，这些纹饰应该也有些年头了。请您稍等，我打开来看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160203
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710160203,
					"content": "这里的东西虽然有缺损，但如果您急着脱手，我倒是可以出个价收了。只不过价钱高不了太多就是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160204
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710160204,
					"content": "我刚才看了看这东西。这纹路的样式确实是璃月的，而且，这上面所记载的也正是和「若陀龙王」有关的轶事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160205
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710160205,
					"content": "传说，若陀龙王是凝聚了璃月的岩元素神髓所生的魔龙，即使是岩王帝君摩拉克斯也无法轻易镇压它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160206
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710160206,
					"content": "为了将其镇压，岩王帝君先召集三位仙人，让他们齐力营造洞天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160207
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710160207,
					"content": "然后，岩王帝君亲自与其交战，将其打入洞天之中，又命仙人齐力封锁通路，这才将若陀龙王镇住。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160208
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710160208,
					"content": "而您拿来的这个东西上的纹饰，应该就是在描述在这场大战时，三位仙人齐力营造洞天的场景。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160209
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710160209,
					"content": "所以我猜测，这东西应该至少有三份，将这三个部分合起来，才是一个完整的物件。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160210,
						710160212
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710160210,
					"content": "这你也知道…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160211
					]
				},
				{
					"id": 710160211,
					"content": "毕竟我是做这个买卖的，什么方面的知识都要知道一点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160215
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710160215,
					"content": "啊，说得有些远了。如我所说，这个物件一共有三份，单拿出来，恐怕价值不高。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160216
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710160216,
					"content": "但如果能将三份找齐，那就另当别论了。不过，看这东西的样子也颇有年份，想要把三份都搜集齐全，只怕是难上加难",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710160212,
					"content": "璃月可真神奇…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160213
					]
				},
				{
					"id": 710160213,
					"content": "这个我就不清楚了，但一位前辈曾经和我说，璃月实在是太大，历史也实在是太悠久了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160214
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710160214,
					"content": "在璃月，无论发现了什么奇怪的古物都不要惊讶。和璃月漫长的历史相比，我们所知的东西只是沧海一粟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160215
					],
					"speakerTitle": "琳琅"
				}
			]
		},
		{
			"id": 7101603,
