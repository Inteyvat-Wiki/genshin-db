			"dialogs": [
				{
					"id": 740540801,
					"content": "拉动拉杆。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740540802
					]
				},
				{
					"id": 740540802,
					"content": "#呜哇！{NICKNAME}，你在干什么啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740540803
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740540803,
					"content": "你毫不犹豫地拉动了拉杆。\\n下一个瞬间，伴随着宛若雷霆的震耳轰鸣，整座高塔开始剧烈地晃动起来，仿佛天为之崩、地为之裂…",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740540804
					]
				},
				{
					"id": 740540804,
					"content": "然后…噗地一声，机器吐出了一叠纸带，正好掉在你的手中。\\n一切重归沉寂。",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740540805
					]
				},
				{
					"id": 740540805,
					"content": "就…就这？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740540806
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740540806,
					"content": "唔…完全看不懂上面刻了什么东西，但看上去好像挺重要的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740540807
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740540807,
					"content": "#{NICKNAME}，我们还是先留着这些纸带吧？说不定之后会在什么地方用上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
