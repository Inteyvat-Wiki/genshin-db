			"dialogs": [
				{
					"id": 762070201,
					"content": "啊…我曾是语言，如今却沦为了错觉破碎的主体，再度回归这不完美的「象征」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762070202
					],
					"speakerTitle": "托萨利斯"
				},
				{
					"id": 762070202,
					"content": "呜哇！奇怪的家伙说着奇怪的话从奇怪的书里出现了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762070203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762070203,
					"content": "「奇怪」是一种不严谨的表达。它意味着无法被描述、无法被书写、无法被表征的特殊性主体，而我显然不符合这个定义。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762070204
					],
					"speakerTitle": "托萨利斯"
				},
				{
					"id": 762070204,
					"content": "我不过是试图在书页中寻找通往「实在」的入口，却不慎滑入了无限延宕的隐喻中…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762070205
					],
					"speakerTitle": "托萨利斯"
				},
				{
					"id": 762070205,
					"content": "我成为了无法被象征化的剩余，多亏你的介入，我才得以从语言的暴政中被剥离，可以重新开始误认我自己了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762070206
					],
					"speakerTitle": "托萨利斯"
				},
				{
					"id": 762070206,
					"content": "说人话。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762070207
					]
				},
				{
					"id": 762070207,
					"content": "…我不小心掉进书页里出不来了，谢谢你把我拉出来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "托萨利斯"
				}
			]
		}
	]
