			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"纳杰特"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230400501,
					"content": "唉，哈巴奇先生什么时候才能稍微休息一下呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400502
					],
					"speakerTitle": "纳杰特"
				},
				{
					"id": 230400502,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400503
					]
				},
				{
					"id": 230400503,
					"content": "旅行者，你来得正好，请你帮我们一个忙吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400504
					],
					"speakerTitle": "纳杰特"
				},
				{
					"id": 230400504,
					"content": "刚才有一批风干的食物从外面送进村里，哈巴奇先生准备去把它们接入仓库里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400505
					],
					"speakerTitle": "纳杰特"
				},
				{
					"id": 230400505,
					"content": "但一群赤鹫闻到了食物的气味，突然成群结队地冲了下来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400506
					],
					"speakerTitle": "纳杰特"
				},
				{
					"id": 230400506,
					"content": "虽然其他守卫很快赶过来打跑了这些赤鹫，但那批风干的食物也被赤鹫们啄得到处都是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400507
					],
					"speakerTitle": "纳杰特"
				},
				{
					"id": 230400507,
					"content": "其他人已经去警告其他运货的队伍了，哈巴奇先生也忙着去回收还完好的食物…旅行者，你能帮帮我们吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400508,
						230400510
					],
					"speakerTitle": "纳杰特"
				},
				{
					"id": 230400508,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400509
					]
				},
				{
					"id": 230400509,
					"content": "那就拜托你了，真是不好意思，我等会还要去帮忙接收货物，实在是忙不过来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "纳杰特"
				},
				{
					"id": 230400510,
					"content": "哈巴奇先生还好吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400511
					]
				},
				{
					"id": 230400511,
					"content": "唉，我让他休息一下他也不肯，说搜集完食物之后，还要再清点一遍仓库，这样下去，他的身体怎么撑得住啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400512
					],
					"speakerTitle": "纳杰特"
				},
				{
					"id": 230400512,
					"content": "那些货物应该就在白之梯附近。旅行者，请你帮我们回收一下那些货物吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "纳杰特"
				}
			]
		},
