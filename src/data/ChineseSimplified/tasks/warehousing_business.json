			"dialogs": [
				{
					"id": 230401002,
					"content": "…呼…呼…多谢你了，旅行者。要不是你出手，这些货物肯定保不住。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230401003,
						230401005
