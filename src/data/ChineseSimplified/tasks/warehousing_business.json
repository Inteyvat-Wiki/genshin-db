			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"纳杰特"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230400201,
					"content": "唉…这些赤鹫，真是没完没了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400202
					],
					"speakerTitle": "纳杰特"
				},
				{
					"id": 230400202,
					"content": "发生什么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400203
					]
				},
				{
					"id": 230400203,
					"content": "你是…旅行者，对吧？我听奥贝德那孩子提起过你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400204
					],
					"speakerTitle": "纳杰特"
				},
				{
					"id": 230400204,
					"content": "呵呵，居然会有旅行者造访我们这村子，我倒是真没想到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400205
					],
					"speakerTitle": "纳杰特"
				},
				{
					"id": 230400205,
					"content": "喔，你见过哈巴奇了吗？他一直都很严肃…要是他和你说话时态度有些冲，还请你理解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400206
					],
					"speakerTitle": "纳杰特"
				},
				{
					"id": 230400206,
					"content": "毕竟…我们村的许多物资都放在这个仓库里，不仅是粮食，还有衣物，武器，甚至一些财货…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400207
					],
					"speakerTitle": "纳杰特"
				},
				{
					"id": 230400207,
					"content": "村子里就那么些年轻人，既要守卫村子，又要帮村里人处理各种事…一直都只有哈巴奇一个人守着仓库。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400208
					],
					"speakerTitle": "纳杰特"
				},
				{
					"id": 230400208,
					"content": "我这除了记账和清点之外，也帮不上什么忙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400209
					],
					"speakerTitle": "纳杰特"
				},
				{
					"id": 230400209,
					"content": "你刚才说赤鹫…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400210
					]
				},
				{
					"id": 230400210,
					"content": "唉，别提了，前段时间刚有一批干肉运进了仓库…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400211
					],
					"speakerTitle": "纳杰特"
				},
				{
					"id": 230400211,
					"content": "不知道是哪里漏出了气味，隔三差五就有几只赤鹫飞过来，停在仓库旁边的山上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400212
					],
					"speakerTitle": "纳杰特"
				},
				{
					"id": 230400212,
					"content": "它们没法啄走仓库里的干肉，但只要有人在它们面前吃饭，这群赤鹫就会突然飞下来发动袭击。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400213
					],
					"speakerTitle": "纳杰特"
				},
				{
					"id": 230400213,
					"content": "村子里的守卫没空去解决掉它们，哈巴奇先生也抽不出身…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400214
					],
					"speakerTitle": "纳杰特"
				},
				{
					"id": 230400214,
					"content": "旅行者，如果你有空的话，能帮我们去解决掉那些赤鹫吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400215,
						230400217
					],
					"speakerTitle": "纳杰特"
				},
				{
					"id": 230400215,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400216
					]
				},
				{
					"id": 230400216,
					"content": "那就拜托你了，那些赤鹫很凶猛，最好不要靠近…如果你会用弓箭的话，应该能安全地解决掉它们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "纳杰特"
				},
				{
					"id": 230400217,
					"content": "它们袭击过什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400218
					]
				},
				{
					"id": 230400218,
					"content": "路过的货物，晾晒的干肉，还有哈巴奇先生的饭盒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400219
					],
					"speakerTitle": "纳杰特"
				},
				{
					"id": 230400219,
					"content": "哈巴奇先生在站岗中吃饭时，习惯把菜放在一旁，那群赤鹫经常瞅准这个机会，飞下去把肉全都叼走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400220
					],
					"speakerTitle": "纳杰特"
				},
				{
					"id": 230400220,
					"content": "因为还要站岗，他也不能去教训赤鹫，只能看着它们飞走，然后就着剩下的菜赶紧把饭吃完…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400221
					],
					"speakerTitle": "纳杰特"
				},
				{
					"id": 230400221,
					"content": "拜托你了，旅行者，快去把那些赤鹫都解决掉吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "纳杰特"
				}
			]
		},
