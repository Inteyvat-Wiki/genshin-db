					"纳杰特"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230400401,
					"content": "怎么样，你把那些赤鹫都解决掉了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400402,
						230400403
					],
					"speakerTitle": "纳杰特"
				},
				{
					"id": 230400402,
					"content": "都搞定了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400404
					]
				},
				{
					"id": 230400404,
					"content": "太感谢你了，这样哈巴奇先生总算能正常吃一顿饭了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400405
					],
					"speakerTitle": "纳杰特"
				},
				{
					"id": 230400405,
					"content": "对了，这些报酬给你，请收下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400406
					],
					"speakerTitle": "纳杰特"
				},
				{
					"id": 230400406,
					"content": "唔，今天还要入库什么货物来着…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "纳杰特"
				},
				{
					"id": 230400403,
					"content": "它们应该会消停一段时间了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400404
					]
				}
			]
		},
		{
			"id": 2304005,
			"completionStepIds": [
				2304005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
