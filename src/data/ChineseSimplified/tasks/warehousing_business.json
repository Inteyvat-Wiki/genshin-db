			"dialogs": [
				{
					"id": 230400801,
					"content": "旅行者！你来得正好，请你快去帮帮哈巴奇先生吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400802,
						230400803
					],
					"speakerTitle": "纳杰特"
				},
				{
					"id": 230400802,
					"content": "发生什么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400804
					]
				},
				{
					"id": 230400804,
					"content": "唉，有一批货物在村外被盗宝团截住，能出动的守卫都已经出去支援了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400805
					],
					"speakerTitle": "纳杰特"
				},
				{
					"id": 230400805,
					"content": "哈巴奇说人手还是太少，所以他自己也抓着武器出了村子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400806
					],
					"speakerTitle": "纳杰特"
				},
				{
					"id": 230400806,
					"content": "但据说那群盗宝团人数很多，哈巴奇先生一个人说不定对付不来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400807
					],
					"speakerTitle": "纳杰特"
				},
				{
					"id": 230400807,
					"content": "旅行者，我把他要去的地方标在你的地图上，请你快去帮帮他吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400808,
						230400810
					],
					"speakerTitle": "纳杰特"
				},
				{
					"id": 230400808,
					"content": "我立即出发。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400809
					]
				},
				{
					"id": 230400809,
					"content": "拜托你了旅行者，希望哈巴奇先生不要出事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "纳杰特"
				},
				{
					"id": 230400810,
					"content": "他的武艺怎么样？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400811
					]
				},
				{
					"id": 230400811,
					"content": "对付一两个盗宝团，对于哈巴奇先生来说应该不在话下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400812
					],
					"speakerTitle": "纳杰特"
				},
				{
					"id": 230400812,
					"content": "但据说这次是有一整支盗宝团埋伏了运货队，要不是运货队里有个人腿脚快跑回村里报信，也许都没人能知道运货队被袭击了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400813
					],
					"speakerTitle": "纳杰特"
				},
				{
					"id": 230400813,
					"content": "唉，要是坎蒂丝小姐没有外出的话，那些盗宝团一定不敢造次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400814
					],
					"speakerTitle": "纳杰特"
				},
				{
					"id": 230400814,
					"content": "他们一定是看准了空档，才敢突然动手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400815
					],
					"speakerTitle": "纳杰特"
				},
				{
					"id": 230400815,
					"content": "旅行者，拜托你了，请快去帮帮哈巴奇先生吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "纳杰特"
				},
				{
					"id": 230400803,
					"content": "你怎么这么紧张？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400804
					]
				}
			]
		},
