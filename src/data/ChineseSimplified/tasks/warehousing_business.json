					"content": "旅行者，你拿到那些货物了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400702
					],
					"speakerTitle": "纳杰特"
				},
				{
					"id": 230400702,
					"content": "拿到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400703
					]
				},
				{
					"id": 230400703,
					"content": "太好了，就把货物放在那里吧，多谢你帮忙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400704
					],
