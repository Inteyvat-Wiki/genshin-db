			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"北斗",
					"凝光"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705080101,
					"content": "#哦！这不是{NICKNAME}嘛，来得正好，坐下喝两杯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080102
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 705080102,
					"content": "能在这里见到你，真叫人高兴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080103
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 705080103,
					"content": "两位怎么会来这里？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705080104
					]
				},
				{
					"id": 705080104,
					"content": "等等，你们俩该不会是结伴来的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705080105,
					"content": "这位大人心血来潮说要好好休个假，就决定来这一带旅游了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080106
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 705080106,
					"content": "不过嘛，我俩对旅游的理解好像不太一样。山都没上几座，就到这里歇着了，真是富贵病啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080107
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 705080107,
					"content": "这话说的，真叫人难过。我可是投你所好，特意挑了能喝酒的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080108
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 705080108,
					"content": "只可惜大船长见多识广，对这座小酒馆意见颇多呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080109
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 705080109,
					"content": "好吧，这顿我请，行了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080110
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 705080110,
					"content": "北斗要请客？那我们有份吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705080111,
					"content": "派蒙，我们是酒保啦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705080112
					]
				},
				{
					"id": 705080112,
					"content": "对哦，习惯性蹭上了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705080113,
					"content": "两位贵客，喝点什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705080114
					]
				},
				{
					"id": 705080114,
					"content": "给我来一小杯桦树吧。最好能酸一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080115
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 705080115,
					"content": "大杯的暮色，谢啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080116
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 705080116,
					"content": "明白了，请稍等片刻。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7050802,
