			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凝光",
					"北斗"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705080201,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080202
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 705080202,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080203
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 705080203,
					"content": "怎、怎么样？你们别不说话呀，我好紧张！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705080204,
					"content": "嗯…忆苦思甜的味道呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080205
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 705080205,
					"content": "白手起家的味道？得是什么味儿啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080206
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 705080206,
					"content": "呵呵…酸中带甜，余味很足。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080207
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 705080207,
					"content": "唔…做小本生意却发现卖水果赚不到钱的味道？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080208
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 705080208,
					"content": "何必说得那么明白呢。过去的事，就随它去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080209
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 705080209,
					"content": "哈哈，谁能想到高高在上的天权星也有沿街兜售水果的岁月啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080210
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 705080210,
					"content": "就像我，看着也不像渔民出身对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080211
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 705080211,
					"content": "怎么会呢。要我说的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080212
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 705080212,
					"content": "北斗船长这双一眼看透海水的眼睛，这副乘风破浪勇往直前的热心肠，向来是像极了依海而生的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080213
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 705080213,
					"content": "喂喂，这话可不是损我的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080214
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 705080214,
					"content": "损你又没有什么好处。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080215
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 705080215,
					"content": "知道你嘴巴厉害了。今天我请客，你给我点到为止。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080216
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 705080216,
					"content": "嗯…那我想多喝几杯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080217,
						705080218
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 705080217,
					"content": "是要续杯吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705080219
					]
				},
				{
					"id": 705080218,
					"content": "竭诚为您服务！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705080219
					]
				},
				{
					"id": 705080219,
					"content": "酒保，安排起来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705080220,
					"content": "气势不错嘛！那我也再来一杯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080221
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 705080234,
					"content": "立刻为二人续杯…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 705080221,
					"content": "蒙德的果汁真不错，要是每天都能喝到该多好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080222
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 705080222,
					"content": "嗯？开玩笑吗？别告诉我你想开通日落果贸易专线…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080223
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 705080223,
					"content": "听着有趣得很呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080224
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 705080224,
					"content": "当真？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080225
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 705080225,
					"content": "玩笑而已。相关贸易早就有一定规模了，不用我出手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080226
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 705080226,
					"content": "#{NICKNAME}，今天多谢了。哪天你要是想找份闲差，不妨来我身边做专职酒保。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080227
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 705080227,
					"content": "也可以来「死兆星」号上。我们大伙都爱喝酒，你要是过来，就能一起喝酒吃肉了，保证过瘾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080228
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 705080228,
					"content": "北斗船长这是在跟我竞争人才吗？你这又是何必，想喝旅行者亲自调制的饮品，来群玉阁上就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080229
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 705080229,
					"content": "（我真受欢迎！）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705080230
					]
				},
				{
					"id": 705080230,
					"content": "她们好像偷偷把你卖了呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080231,
						705080232
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705080231,
					"content": "有机会的话…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 705080232,
					"content": "一定都去，一定都去…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		}
	]
}