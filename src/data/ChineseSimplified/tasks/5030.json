			"dialogs": [
				{
					"id": 50300801,
					"content": "是你们，太好了！谢谢你们一直鼓励我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300802
					],
					"speakerTitle": "乌图伦库"
				},
				{
					"id": 50300802,
					"content": "纳塔有很多人都把对抗深渊视为荣耀，但他们也会被热血冲昏头脑，不知不觉就陷入险境之中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300803
					],
					"speakerTitle": "乌图伦库"
				},
				{
					"id": 50300803,
					"content": "你们说得很对，战斗很重要，生命也很重要，我们为所爱之人战斗，所以我们还要去和所爱之人重逢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300804
					],
					"speakerTitle": "乌图伦库"
				},
				{
					"id": 50300804,
					"content": "我转告了你们的想法之后，战友们都很认可，在战斗中也变得稳重了很多，我们取得了非常好的成果！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300805
					],
					"speakerTitle": "乌图伦库"
				},
				{
					"id": 50300805,
					"content": "真的要谢谢你们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "乌图伦库"
				}
			]
		},
