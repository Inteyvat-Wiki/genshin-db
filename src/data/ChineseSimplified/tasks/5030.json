			"dialogs": [
				{
					"id": 50300101,
					"content": "天啊，人也不够，东西也不够，就我这三脚猫的技术，很多伤口根本处理不了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300102
					],
					"speakerTitle": "琪丝佩"
				},
				{
					"id": 50300102,
					"content": "要是有更专业的人在就好了…不行不行，还不是叹气的时候，我得打起精神！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "琪丝佩"
				}
			]
		},
		{
			"id": 503002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
