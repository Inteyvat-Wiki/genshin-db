			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"奥希娜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 50300201,
					"content": "我看到你们把葵可女士送回来了…对此我很遗憾，葵可女士真的是一位前途无限光明的医生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300202
					],
					"speakerTitle": "奥希娜"
				},
				{
					"id": 50300202,
					"content": "我们在业务上有很多合作，她对于药物的品质有很高的要求，有时候为了给别人治病，还会自掏腰包。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300203
					],
					"speakerTitle": "奥希娜"
				},
				{
					"id": 50300203,
					"content": "她和我说，比起赚钱，她更看重经验的积累。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300204
					],
					"speakerTitle": "奥希娜"
				},
				{
					"id": 50300204,
					"content": "只有掌握最精湛的医术，才能让她救最多的人，同时，也让她不会错过她最想救的那个人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300205
					],
					"speakerTitle": "奥希娜"
				},
				{
					"id": 50300205,
					"content": "可惜，可惜，医者难自医，纳塔失去了如此杰出的一位英才…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奥希娜"
				}
			]
		},
