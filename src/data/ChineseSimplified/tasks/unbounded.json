				]
			},
			"dialogs": [
				{
					"id": 150380601,
					"content": "咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380602
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380602,
					"content": "清醒点了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380603
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150380603,
					"content": "看出我的身体已达极限，将力量反过来传导给我，从内部破坏了我的外壳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380604
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380604,
					"content": "这份力量，这种对战斗的敏锐嗅觉…果然，你就是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380605
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380605,
					"content": "丝柯克，苏尔特洛奇的弟子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380606
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150380606,
					"content": "现在是什么时候，他离开提瓦特多久了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380607
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380607,
					"content": "几百年了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380608
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150380608,
					"content": "几百年…！哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380609
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380609,
					"content": "抱歉，情绪激动，差点忘了自报家门。我名斯克弗努格，是你师父苏尔特洛奇的朋友，也是他的追随者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380610
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380610,
					"content": "丝柯克…这是我第一次听到你的名字。但数百年前，我就知道你的存在，知道你会来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380611
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380611,
					"content": "数百年前？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380612
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150380612,
					"content": "可以讲讲吗？你，还有师父的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380613
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150380613,
					"content": "当然可以，趁我现在还能保持理智。那是很久…很久以前了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380614
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380614,
					"content": "我是坎瑞亚贵族出身，是家中长子，有资格承袭爵位。但我从小就患上了不治之症，因此也没人对我有什么期待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380615
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380615,
					"content": "我努力地练剑，打败了所有的同龄人。但是没有用，我见到的都是同情或幸灾乐祸的目光，就连父母也在等待我咽气的那天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380616
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380616,
					"content": "慢慢地我的心也冷了，整日浑浑噩噩。在这时候，我遇到了你的师父，苏尔特洛奇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380617
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380617,
					"content": "当时我们都年龄尚小。他是死囚的孩子，在牢狱内出生，从小混迹街头，受过的批评比深秘院的巨著还多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380618
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380618,
					"content": "但他整日里脸上都带着笑容，仿佛对一切友好与恶意都视若无睹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380619
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380619,
					"content": "我还记得初次见面他对我说的话：「人要为自己挣命。哪怕挣不到，也应该像一团火一样烧起来，哪能就这样麻木地死去呢？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380620
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380620,
					"content": "…这确实是师父会说的话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380621
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150380621,
					"content": "是他承认了我的天赋，是他鼓舞了我的精神。我与他一同切磋，那是我第一次从战斗中体会到快乐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380622
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380622,
					"content": "十岁那年，他偷来了禁忌的研究资料，治好了我的病。世界上似乎就没有他做不到的事情…他不断地以人类的身躯挑战不可能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380623
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380623,
					"content": "我却在这个过程中掉队了。我的天赋与他相比不值一提，不知从什么时候开始，他远远地走在我前面，我甚至无颜再找他对练。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380624
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380624,
					"content": "「事变」成功后，苏尔特洛奇找到我，对我说——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380625
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380625,
					"content": "这颗星球上已经没有我感兴趣的东西，我就要离开了。在那之前，要不要我用刚刚炼就的力量，帮你打破不死诅咒？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380626
					],
					"speakerTitle": "苏尔特洛奇"
				},
				{
					"id": 150380626,
					"content": "虽然我们曾竭尽全力避免你的死亡，但若是陷入「不死」，那就是另一种痛苦了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380627
					],
					"speakerTitle": "苏尔特洛奇"
				},
				{
					"id": 150380627,
					"content": "算了，不死对我来说也挺好的。无限的生命，意味着我能不断地变强——也许有一天，我们能再次如过去那般交手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380628
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380628,
					"content": "想好了？我这一去可不知道要多久才会回来，你的身体…或者说你的灵魂可未必吃得消。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380629
					],
					"speakerTitle": "苏尔特洛奇"
				},
				{
					"id": 150380629,
					"content": "总要试试才行。人要为自己挣命，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380630
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380630,
					"content": "说得好。不过，如果有一天你受够了永生带来的痛苦，想在临走前痛痛快快地打一架，就去找我的徒弟吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380631
					],
					"speakerTitle": "苏尔特洛奇"
				},
				{
					"id": 150380631,
					"content": "徒弟？从你嘴里说出来，真是个新鲜词儿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380632
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380632,
					"content": "是啊，维瑟弗尼尔说我会在宇宙中收个徒弟，并且送她来提瓦特。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380633
					],
					"speakerTitle": "苏尔特洛奇"
				},
				{
					"id": 150380633,
					"content": "你也认识维瑟弗尼尔，他的预言一向很靠谱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380634
					],
					"speakerTitle": "苏尔特洛奇"
				},
				{
					"id": 150380634,
					"content": "那我倒有点好奇了，什么样的徒弟？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380635
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380635,
					"content": "维瑟弗尼尔没说，只告诉我未来某一天，「群星会向她致意」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380636
					],
					"speakerTitle": "苏尔特洛奇"
				},
				{
					"id": 150380636,
					"content": "听起来是个了不起的人啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380637
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380637,
					"content": "那当然。不是了不起的人，有资格做我的徒弟吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380638
					],
					"speakerTitle": "苏尔特洛奇"
				},
				{
					"id": 150380638,
					"content": "你还是和以前一样自信。不过嘛，倒也确实如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380639
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380639,
					"content": "走了。另外，如果你真的执意变强，原始胎海有我留给你的礼物。还是那句话，想走什么路随你喜欢，恶人有恶人的自由。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380640
					],
					"speakerTitle": "苏尔特洛奇"
				},
				{
					"id": 150380640,
					"content": "于是我来到原始胎海，见到了被苏尔特洛奇打得奄奄一息的吞星之鲸。趁它正虚弱，我切下它的部分身体，缝进了我的心脏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380641
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380641,
					"content": "心、心脏？听上去好疼…这种事真的能办到吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380642
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150380642,
					"content": "可以，因为我的身上有「不死诅咒」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380643
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380643,
					"content": "你反过来利用了不死诅咒，让自己成为了力量的容器。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380644
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150380644,
					"content": "纵然有吞星之鲸的权柄，人类的身躯也无法承受吞噬而来的力量，是不死诅咒维系了你时刻都在崩溃的肉身与灵魂…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380645
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150380645,
					"content": "但是这不是通向强者的路。力量应当是浸透心血与梦想的杰作，抢来的财富终归不属于你，所以才会出现反噬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380646
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150380646,
					"content": "你说得一点都没错。我本该知晓这个道理，但…我已经触摸到了自己的极限，却还是离他太远，只能放手一搏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380647
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380647,
					"content": "我很想念你的师父，想念那些无家可归的恶徒欢聚在一起的时光。我不后悔做这个选择，但是——请允许我向你、向你们道歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380648
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380648,
					"content": "揍了你一顿，算扯平了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380649
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150380649,
					"content": "哈…你也是个有趣的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380650
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380650,
					"content": "「苏尔特洛奇的弟子」…名头挺唬人，不过当那个人的弟子应该很辛苦吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380651
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380651,
					"content": "以他的性格，一定会带给你绝望和恐惧，逼迫你不断追赶他的脚步，但他偏偏又站在很高的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380652
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380652,
					"content": "我们就像夜晚中的登山客，不知道山有多高，也不知道太阳什么时候出来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380653
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380653,
					"content": "如你所说。但我早已打定主意，无论是怎样的绝望，我都会跨过它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380654
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150380654,
					"content": "而且，听你说完之后，我的心里隐约有种感觉。师父他渴望的或许并不是「酣畅淋漓的战斗」，而是「不留遗憾的失败」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380655
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150380655,
					"content": "哦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380656
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380656,
					"content": "你是师父的朋友，对吧？朋友之间，一定有相似的特质。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380657
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150380657,
					"content": "第一次来这里时，你在浓雾中刺伤了我，夺走了我的力量。但是从那枚尖刺上，我感受不到任何情绪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380658
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150380658,
					"content": "反倒是第二次，当你用出全力想要击败我的时候，你的剑上传来的是热情与喜悦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380659
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150380659,
					"content": "那种喜悦，就像是执着研究的人发现了世界的真相，就像是渴求艺术的人来到了宏伟的殿堂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380660
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150380660,
					"content": "有趣，我确信自己并未表露出这些情感，你竟能从剑上读出我的内心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380661
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380661,
					"content": "你的直觉是对的。和你们交手让我发自内心地喜悦，甚至输掉也没有任何遗憾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380662
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380662,
					"content": "所以我想，也许师父和你一样，也盼望着这样一场战斗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380663
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150380663,
					"content": "他的对手能够逼迫他使出浑身解数，甚至连体内的潜能都全部燃尽。他会在战斗中突破自我，拼上此身此心的全部力气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380664
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150380664,
					"content": "然后，让自己与这场盛大的决斗一同落幕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380665
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150380665,
					"content": "正因如此，善与恶对他来说才都不重要，他唯一要做的就是「完成自我」。这也是他强大的秘密之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380666
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150380666,
					"content": "你说得对，或许他确实有这样的想法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380667
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380667,
					"content": "那会是多么宏大的战斗啊，连我都心驰神往——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380668
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380668,
					"content": "咳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380669
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380669,
					"content": "你的身体…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380670
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150380670,
					"content": "不同的力量在我的身体中横冲直撞，不死诅咒虽然能将它们捏合，但疼痛不会消失。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380671
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380671,
					"content": "很快我的理智就会再次被磨掉…真是可惜，没办法见证那场战斗了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380672
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380672,
					"content": "丝柯克，能拜托你完成苏尔特洛奇没有做的事，给我一个解脱吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380673
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380673,
					"content": "可以，但死亡不是唯一的解脱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380674
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150380674,
					"content": "你的罪不至死，我可以换个方式。将你的意识，连同你吞噬来的各种力量一同打碎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380675
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150380675,
					"content": "杂质消散，而你的身心在不死诅咒的影响下重新凝聚。到那时你可以回到过去纯净的样子，不再受失控的力量折磨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380676
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150380676,
					"content": "这需要很长时间，也伴随着很大的痛苦，一切看你的选择。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380677
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150380677,
					"content": "这样也不错。说不定等我醒来，还来得及目睹你与苏尔特洛奇之间的那场战斗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380678
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380678,
					"content": "我愿意相信，有一天你真的能和他一较高下。当然，想必那会是一条充满艰辛的荆棘之路吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380679
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380679,
					"content": "我的夜晚结束了，而你那漫长的征程仍要继续。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380680
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380680,
					"content": "（好在——你看上去并不孤独。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380681
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380681,
					"content": "我会爬上那座山，无论路有多难走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380682
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150380682,
					"content": "斯克弗努格，你就在一切的尽头见证吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "丝柯克"
				}
			]
		},
