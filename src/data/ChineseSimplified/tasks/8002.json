			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"戴因斯雷布"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80020501,
					"content": "原来如此，深渊教团已经展开新的行动了么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020502
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80020502,
					"content": "很可能与「污秽逆位神像」有关，我们也去看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020503
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80020503,
					"content": "说起来，深渊教团去奔狼领干嘛？难道又要重演特瓦林事件？啊——重复的灾难就别再来啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020504,
					"content": "不，应该不会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020505
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80020505,
					"content": "与被镇压的奥赛尔不同，魔神「安德留斯」早就死了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020506
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80020506,
					"content": "如今守护奔狼领的，只是它的残魂而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020507
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80020507,
					"content": "深渊使徒将那缕残魂当作目标，或许只是想要从风神眷属的口中，挖出些有用的信息…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "戴因斯雷布"
				}
			]
		},
		{
			"id": 800206,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800202",
							"2"
						],
						"stepId": 800202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
