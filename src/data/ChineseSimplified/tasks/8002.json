				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"芭芭拉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80020101,
					"content": "荣誉骑士！你好，最近过得如何？今天有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020102
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 80020102,
					"content": "啊…不过，先说好，想再借天空之琴，是不可以的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020103
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 80020103,
					"content": "（看来她还没有发现幻术的事…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020104,
					"content": "我们是来打听事情的。芭芭拉听说过「世上第一座耕地机」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020105,
					"content": "嗯？那是什么？「耕地机」…是用来做什么的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020106
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 80020106,
					"content": "唔，果然不知道啊。那换个问题吧，教会有没有弄丢过七天神像呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020107,
					"content": "欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020108
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 80020108,
					"content": "你们是来问那个「老故事」的吗？好意外，因为是很久以前的事，现在已经没有什么人再提起了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020109
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 80020109,
					"content": "很久以前，确实有座七天神像一夜之间突然消失，没有留下任何痕迹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020110
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 80020110,
					"content": "当时，几乎所有教会成员都参与了搜索，但最后也没有找到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020111
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 80020111,
					"content": "在教会的记载里，这件怪事被称为「失落的七天神像」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020112
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 80020112,
					"content": "唔…果然。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020113,
					"content": "果然？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020114
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 80020114,
					"content": "啊，没什么。还有别的什么线索吗？呃，我是说…还有别的什么怪事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020115,
					"content": "（对不起了，芭芭拉，暂时不能告诉你我们见过神像的事…这也是商量过的结果，为了你的安全…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020116,
					"content": "别的怪事？不太清楚，我想想教会记录过的怪事…「暴君的遗怨」？不对，时间上应该关联不大…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020117
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 80020117,
					"content": "「暴君的遗怨」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020118,
					"content": "哦，这件怪事指的是，现在被称作「风龙废墟」的「旧蒙德」，有一段时间变得非常危险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020119
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 80020119,
					"content": "在很多年前的某段时间里，只要有人接近那里，就会引来从天而降的火球。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020120
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 80020120,
					"content": "从天而降的火球？！好可怕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020121,
					"content": "当时，人们认为那是「龙卷之魔神」的诅咒，所以把它叫做「暴君的遗怨」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020122
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 80020122,
					"content": "这个诡异的现象持续了一年，最后也没能解决，后来是自己慢慢停息的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020123,
						80020124
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 80020123,
					"content": "这也太古怪了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020125
					]
				},
				{
					"id": 80020125,
					"content": "嗯，后来教会认为，「暴君遗怨」的说法站不住脚。龙卷之魔神，按理说不会发射火球…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020126
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 80020126,
					"content": "恐怕，是有别的什么原因引发了灾祸吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020127
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 80020127,
					"content": "总之，这件事和「失落的神像」可能没有关系。但其它的怪事，我也联想不到什么了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020128
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 80020128,
					"content": "没关系，还是很谢谢你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020129,
					"content": "「谢谢」？我好像又听到了麻烦的词…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020130
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 80020130,
					"content": "啊，是你啊，罗莎莉亚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020131
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 80020131,
					"content": "如果要找骑士团，他们现在没时间，「那群魔物」又回来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020132
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 80020132,
					"content": "「那群魔物」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020133
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 80020133,
					"content": "就是那些曾经借风魔龙之乱，试图进攻蒙德城的怪物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020134
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 80020134,
					"content": "那不就是深渊教团吗？！它们又有动作了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020135,
					"content": "嗯，它们正在<color=#00E1FFFF>奔狼领</color>集结，狼群躁动不安。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020136
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 80020136,
					"content": "深渊教团，或许是…盯上了「北风王狼的残魂」？至于是为了什么，我还不能确定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020137
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 80020137,
					"content": "琴团长已经去了<color=#00E1FFFF>奔狼领</color>，我也要开始暗中行动了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020138
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 80020138,
					"content": "那、那我也要去！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020139
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 80020139,
					"content": "琴团长说，要你留在教会，做好神职人员的本职工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020140
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 80020140,
					"content": "可、可你也是神职人员啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020141
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 80020141,
					"content": "不用担心，我也会去帮忙的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020142
					]
				},
				{
					"id": 80020142,
					"content": "对，我们也会去帮助琴团长的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020143
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020143,
					"content": "唔…好吧，有「荣誉骑士」在的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020144
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 80020144,
					"content": "但还是请务必小心行事。愿风神保佑大家都安然无恙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 80020124,
					"content": "未必和暴君有关吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020125
					]
				}
			]
		},
		{
			"id": 800202,
			"completionStepIds": [
				800205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800205",
							"2"
						],
						"stepId": 800205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"琴"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80020201,
					"content": "呼——这一带敌人可真不少！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020202,
					"content": "越靠近目标，敌人就越多。哼，符合教团的作风。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020203
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80020203,
					"content": "我们得快点找到「王狼」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020204
					]
				},
				{
					"id": 80020204,
					"content": "嗯！走吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020205,
					"content": "我…就不去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020206
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80020206,
					"content": "哎？为什么呀？难道你害怕毛茸茸的生物？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020207,
						80020208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020207,
					"content": "应该不是这种原因。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020209
					]
				},
				{
					"id": 80020209,
					"content": "与「狼」无关。是因为它作为昔日的魔神，却效力于如今的七神。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020210
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80020210,
					"content": "我无法认可它的行为，更不想和它打交道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020211
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80020211,
					"content": "再说，讨人喜欢是你的本事，我可做不到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020212,
						80020214
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80020212,
					"content": "你真的很讨厌七神呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020213
					]
				},
				{
					"id": 80020213,
					"content": "神明本就不值得期待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020216
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80020216,
					"content": "就当是我私人的建议好了，记住，随时都要对神明保持警惕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020217
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80020217,
					"content": "不要太过信任他们，但，也不要走上…「推翻」或「猎杀」的道路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020218
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80020218,
					"content": "即使，对于你当年那个「仇敌」，也是如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020219
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80020219,
					"content": "不要信任，也不要猎杀…好别扭的想法。戴因究竟是在仇恨七神，还是维护七神呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020220,
					"content": "为什么会有如此矛盾的观点？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020221
					]
				},
				{
					"id": 80020221,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020222
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80020222,
					"content": "前车之鉴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020223
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80020223,
					"content": "我…就最后告诉你们一个事实吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020224
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80020224,
					"content": "欸？什么事实？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020225,
					"content": "「坎瑞亚是被神覆灭的国度，而这就是…深渊教团想要覆灭七神国度的原因。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020226
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80020226,
					"content": "闲聊到此为止，先办正事。我去解决剩余的深渊教团，你们也快去快回。事情都解决后，我们在奔狼领的入口见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020227
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80020227,
					"content": "啊…他走了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020228
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020228,
					"content": "真是个怪人呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020229
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020229,
					"content": "我稍微能理解他一点。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020230
					]
				},
				{
					"id": 80020230,
					"content": "嗯，这么说来，你也很提防「陌生的神灵」呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020231
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020231,
					"content": "那时在璃月，请仙典仪上，你的选择和戴因很类似…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020232
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020232,
					"content": "因为缺乏信任。无从交涉，只能回避。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020233
					]
				},
				{
					"id": 80020233,
					"content": "唉…真是不容易啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020234
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020234,
					"content": "荣誉骑士，派蒙！你们怎么在这里？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020235
					],
					"speakerTitle": "琴"
				},
				{
					"id": 80020235,
					"content": "呀，琴团长！太好了，找到你啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020236
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020236,
					"content": "我们听罗莎莉亚说，你来这里作战，所以就过来支援你啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020237
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020237,
					"content": "那真是非常感谢。这次暴动非常诡异，深渊教团将奔狼领层层包围，我正准备调动兵力对抗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020238
					],
					"speakerTitle": "琴"
				},
				{
					"id": 80020238,
					"content": "我刚在奔狼领侦察了一番…没想到遇见了你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020239
					],
					"speakerTitle": "琴"
				},
				{
					"id": 80020239,
					"content": "听罗莎莉亚说，他们的目标可能是「玻瑞亚斯」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020240
					],
					"speakerTitle": "琴"
				},
				{
					"id": 80020240,
					"content": "但深渊教团…与「玻瑞亚斯」…会有什么关联？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020241
					],
					"speakerTitle": "琴"
				},
				{
					"id": 80020241,
					"content": "单纯的找麻烦，应该不需要理由吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020242
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020242,
					"content": "你看，深渊教团已经找过特瓦林的麻烦，再去找另一个风神眷属的麻烦，也不奇怪呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020243
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020243,
					"content": "也、也有道理…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020244
					],
					"speakerTitle": "琴"
				},
				{
					"id": 80020244,
					"content": "总之，这附近的威胁，无论是明面的，还是潜伏的，都交给我来处理吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020245
					],
					"speakerTitle": "琴"
				},
				{
					"id": 80020245,
					"content": "荣誉骑士，请你赶去确认一下「王狼」是否遭遇危机。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020246
					],
					"speakerTitle": "琴"
				},
				{
					"id": 80020246,
					"content": "魔神的残魂…不常见人。但我听说你与它有过一面之缘，由你出面，或许是最合适的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020247
					],
					"speakerTitle": "琴"
				},
				{
					"id": 80020247,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020248
					]
				},
				{
					"id": 80020248,
					"content": "嗯，多加小心。前方的任务就拜托你了，「西风的荣誉骑士」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "琴"
				},
				{
					"id": 80020214,
					"content": "你真的很不喜欢交际呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020215
					]
				},
				{
					"id": 80020215,
					"content": "与人打交道当然没问题，与神…就不好说了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020216
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80020208,
					"content": "毛茸茸不可爱吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020209
					]
				}
			]
		},
		{
			"id": 800203,
			"completionStepIds": [
				800211
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
