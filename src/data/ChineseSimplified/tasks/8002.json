			]
		},
		{
			"id": 800207,
			"completionStepIds": [
				800208
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800208",
							"2"
						],
						"stepId": 800208,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"玻瑞亚斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80020701,
					"content": "哼…短暂的仪式被打断了，你们真是好运。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020702
					],
					"speakerTitle": "深渊使徒"
				},
				{
					"id": 80020702,
					"content": "没想到，仅仅是一缕残魂，也有这么坚强的意志…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020703
					],
					"speakerTitle": "深渊使徒"
				},
				{
					"id": 80020703,
					"content": "但这种微小的变数，不足以影响全局。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020704
					],
					"speakerTitle": "深渊使徒"
				},
				{
					"id": 80020704,
					"content": "又消失了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020705,
						80020706
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020705,
					"content": "至少阻止了它的行动。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020707
					]
				},
				{
					"id": 80020707,
					"content": "谢谢你们，来得，及时。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020708
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 80020708,
					"content": "人类中的「卢皮卡」…让你们见到我如此姿态，见笑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020709
					],
					"speakerTitle": "玻瑞亚斯"
				},
				{
					"id": 80020709,
					"content": "但深渊的使徒，终究是太小看我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020710
					],
					"speakerTitle": "玻瑞亚斯"
				},
				{
					"id": 80020710,
					"content": "王狼，不拒绝，试炼。但，阴森的外来者，不遵守，试炼的规矩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020711
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 80020711,
					"content": "我也，注意不到，布下的陷阱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020712
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 80020712,
					"content": "也就是说，是深渊教团先做好了腐蚀的准备，再以试炼的名义，把「王狼」唤醒？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020713,
						80020714
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020713,
					"content": "这不是你的错，雷泽。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020715
					]
				},
				{
					"id": 80020715,
					"content": "#谢谢你，{NICKNAME}。以后，我的爪子，需要，更锋利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020716
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 80020716,
					"content": "你们，闻到了危险，来这里？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020717
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 80020717,
					"content": "不，我们是听说的，我们的鼻子没有这么好用啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020718
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020718,
					"content": "除了来帮忙之外，我们还有一件事要请教。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020719
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020719,
					"content": "请问…这位魔神大人，你知道「世上第一座耕地机」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020720
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020720,
					"content": "我不关心人类的造物，不知道「耕地机」是什么。但只说印象深刻的机械，曾经倒是有一座。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020721
					],
					"speakerTitle": "玻瑞亚斯"
				},
				{
					"id": 80020721,
					"content": "它误闯了我的试炼场地，我将它视为参与试炼的勇士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020722
					],
					"speakerTitle": "玻瑞亚斯"
				},
				{
					"id": 80020722,
					"content": "可它没有智能，只想要战斗。它从头到脚，都是为了杀戮而铸造。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020723
					],
					"speakerTitle": "玻瑞亚斯"
				},
				{
					"id": 80020723,
					"content": "最终，我的攻击损坏了它。在倒下之前，它离开了这块试炼场。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020724
					],
					"speakerTitle": "玻瑞亚斯"
				},
				{
					"id": 80020724,
					"content": "唔…听这些描述，好像不排除是「世上第一座耕地机」的可能？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020725,
						80020727
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020725,
					"content": "它会旋转吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020726
					]
				},
				{
					"id": 80020726,
					"content": "是的，它会旋转，跳得很高，还会发射火球。力量虽不比魔神，但比很多持有「神之眼」的人都强。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020730
					],
					"speakerTitle": "玻瑞亚斯"
				},
				{
					"id": 80020730,
					"content": "火球…？咦，最近是不是在哪听到过这个词来着。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020731
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020731,
					"content": "总之，这个消息是不是能说明，「世上第一座耕地机」，确实来过蒙德？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020732
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020732,
					"content": "听起来，「世上第一座」的力量，比后来那些量产的遗迹守卫强了很多呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020733
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020733,
					"content": "但在这个故事里，它好像在「狼的试炼」里被打坏了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020734
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020734,
					"content": "不知道。那么，帮上忙了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020735
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 80020735,
					"content": "帮大忙了，谢谢你们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020736
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020736,
					"content": "我们要继续去追查一件很重要的事了。虽然深渊使徒离开了，但教团的进攻还没结束，你们也要小心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020737
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020737,
					"content": "嗯，我能闻到，更加危险的，东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020738
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 80020738,
					"content": "你们，也，保护自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雷泽"
				},
				{
					"id": 80020727,
					"content": "它会发射导弹吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020728
					]
				},
				{
					"id": 80020728,
					"content": "「导弹」？不…我已经说了，我不关心人类的造物，不懂这些奇怪的词。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020729
					],
					"speakerTitle": "玻瑞亚斯"
				},
				{
					"id": 80020729,
					"content": "它会旋转，跳得很高，还会发射火球。力量虽不比魔神，但比很多持有「神之眼」的人都强。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020730
					],
					"speakerTitle": "玻瑞亚斯"
				},
				{
					"id": 80020714,
					"content": "别沮丧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020715
					]
				},
				{
					"id": 80020706,
					"content": "跑得倒是挺快。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020707
					]
				}
			]
		}
	]
}