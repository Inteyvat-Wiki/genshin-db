					"nextDialogs": [
						718110502
					],
					"speakerTitle": "阿山婆"
				},
				{
					"id": 718110502,
					"content": "关于「留影机」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718110503
					]
				},
				{
					"id": 718110503,
					"content": "「留影机」…哦，前几天我是去飞云商会，拜托他们过来给我留个影的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110504
					],
					"speakerTitle": "阿山婆"
				},
				{
					"id": 718110504,
					"content": "你是特意来把印出来的画送过来的吗？真是谢谢你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿山婆"
				}
			]
