			"dialogs": [
				{
					"id": 718110412,
					"content": "关于「留影机」的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718110401
					]
				},
				{
					"id": 718110401,
					"content": "你把东西都送到了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110402
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 718110402,
					"content": "都送到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718110403
					]
				},
				{
					"id": 718110403,
					"content": "谢谢谢谢，真是劳烦您了，我真是要忙晕头了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110404
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 718110404,
					"content": "哦对了，这架「留影机」送给您，谢谢您帮忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110405,
						718110406
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 718110405,
					"content": "这怎么好意思…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718110407
					]
				},
				{
					"id": 718110407,
					"content": "没事，没事，您不是给我们帮了忙吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110408
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 718110408,
					"content": "这也不是什么贵重的东西，是我们去进货的时候，枫丹那边给我们的试用装。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110409
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 718110409,
					"content": "虽然和正式装的还是有点区别…但基本功能都有，您随便玩玩肯定是够的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110410
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 718110410,
					"content": "然后…您要是觉着用得不错，您也帮我们四处宣传宣传…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110411
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 718110411,
					"content": "咳…总之谢谢您帮忙！这「留影机」您收好，收好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿旭"
				},
				{
					"id": 718110406,
					"content": "这东西挺贵吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718110407
					]
				}
			]
		},
