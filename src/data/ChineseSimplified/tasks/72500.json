				"points": []
			},
			"dialogs": [
				{
					"id": 725000101,
					"content": "出事了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000102
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 725000102,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725000103
					]
				},
				{
					"id": 725000103,
					"content": "老大又进去了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000104
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 725000104,
					"content": "就在刚才，天领奉行派人过来，在留言板上贴了一张告示，说是要暂停我们的祭典。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000105
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 725000105,
					"content": "不知道怎么回事，老大他好像把宣传广告发进了天守阁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000106
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 725000106,
					"content": "还说将军大人一定想要参加荒泷极上盛世豪鼓大祭典！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000107
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 725000107,
					"content": "欸？这么说的话，我觉得老大说的没错呀。我也觉得将军大人肯定想参加。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000108
					],
					"speakerTitle": "阿晃"
				},
				{
					"id": 725000108,
					"content": "对呀，难道你不是这么认为的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000109
					],
					"speakerTitle": "元太"
				},
				{
					"id": 725000109,
					"content": "哎呀，谁会管我们怎么觉得呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000110
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 725000110,
					"content": "总之老大就是被看守的奥诘众当场抓获，送去了天领奉行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000111
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 725000111,
					"content": "那要怎么办呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725000112
					]
				},
				{
					"id": 725000112,
					"content": "忍姐应该已经在处理了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000113
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 725000113,
					"content": "据说奥诘众对老大的指控是涉嫌扰乱军事禁区。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000114
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 725000114,
					"content": "后来被九条裟罗大人改成了涉嫌妨碍公共秩序。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000115
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 725000115,
					"content": "呀呀呀呀呀，这个可恶的九条天狗，居然给老大定了这种重罪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000116
					],
					"speakerTitle": "元太"
				},
				{
					"id": 725000116,
					"content": "哎呀，你傻啦！这是变成了轻罪，一般在所里教育教育就好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000117
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 725000117,
					"content": "至于祭典这边，就只能等老大出来之后再说啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000118
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 725000118,
					"content": "旅行者，您也不用担心，有忍姐在那边处理，肯定不会有大问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000119
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 725000119,
					"content": "您对我们的祭典这么支持，等老大出来，他一定会来当面感谢你的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000120
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 725000120,
					"content": "希望您的旅途和我们的祭典一样，都能越来越好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000121
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 725000121,
					"content": "越来越好！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿守"
				}
			]
		}
	]
}