	"talks": [
		{
			"id": 2007301,
			"completionStepIds": [
				2007301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2007301",
							"2"
						],
						"stepId": 2007301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"里瑟"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200730101,
					"content": "旅行者！你来得正好，能帮我个忙吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730102
					],
					"speakerTitle": "里瑟"
				},
				{
					"id": 200730102,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200730103
					]
				},
				{
					"id": 200730103,
					"content": "你也看到了，雪山上的环境很恶劣，即使是经验丰富的冒险家，也不敢说自己能完全应付里面的情况。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730104
					],
					"speakerTitle": "里瑟"
				},
				{
					"id": 200730104,
					"content": "我奉代理团长大人的命令在这里驻守，警告蒙德的居民不要上雪山。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730105
					],
					"speakerTitle": "里瑟"
				},
				{
					"id": 200730105,
					"content": "不过，我是劝住了不少想要上山的蒙德居民，但是那些冒险家嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730106
					],
					"speakerTitle": "里瑟"
				},
				{
					"id": 200730106,
					"content": "你也知道的，就算是劝他们不能轻易上去，他们也不会听，就是要往雪山里走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730107
					],
					"speakerTitle": "里瑟"
				},
				{
					"id": 200730107,
					"content": "我都不知道我处理了多少件和冒险家有关的事了…但想要上雪山的冒险家数量，就是有增无减。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730108
					],
					"speakerTitle": "里瑟"
				},
				{
					"id": 200730108,
					"content": "想要管到每个冒险家是不可能的…所以，我们计划在雪山的一些地点上投放些补给。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730109
					],
					"speakerTitle": "里瑟"
				},
				{
					"id": 200730109,
					"content": "这样的话，那些吃到了苦头，准备往回走的冒险家们，还能多些退出雪山的机会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730110
					],
					"speakerTitle": "里瑟"
				},
				{
					"id": 200730110,
					"content": "不过…要是有运气好过头的楞头冒险家走得太里面，那就只能靠他们自己了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730111
					],
					"speakerTitle": "里瑟"
				},
				{
					"id": 200730111,
					"content": "总之，能请你帮忙去把这些补给放在雪山里吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730112,
						200730114
					],
					"speakerTitle": "里瑟"
				},
				{
					"id": 200730112,
					"content": "交给我了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200730113
					]
				},
				{
					"id": 200730113,
					"content": "那就拜托你了。唉，要是那些冒险家都像你这样，有实力又知道进退，那该多好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730117
					],
					"speakerTitle": "里瑟"
				},
				{
					"id": 200730117,
					"content": "三个地点我已经标在你的地图上了，每个地方放<color=#00E1FFFF>一份火腿</color>就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730118
					],
					"speakerTitle": "里瑟"
				},
				{
					"id": 200730118,
					"content": "唉，希望那些冒险家们能有些自知之明…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "里瑟"
				},
				{
					"id": 200730114,
					"content": "这样有用吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200730115
					]
				},
				{
					"id": 200730115,
					"content": "有用没用的…总之有总比没有好嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730116
					],
					"speakerTitle": "里瑟"
				},
				{
					"id": 200730116,
					"content": "在雪山这种恶劣的环境里，能多一份补给总是好事，总之就拜托你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730117
					],
					"speakerTitle": "里瑟"
				}
			]
		},
		{
			"id": 2007302,
			"completionStepIds": [
				2007306
			],
