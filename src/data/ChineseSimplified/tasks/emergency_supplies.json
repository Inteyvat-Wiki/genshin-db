				"points": []
			},
			"dialogs": [
				{
					"id": 200730201,
					"content": "补给都放好了么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730202
					],
					"speakerTitle": "里瑟"
				},
				{
					"id": 200730202,
					"content": "都放好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200730203
					]
				},
				{
					"id": 200730203,
					"content": "太好了，这下我能放心些了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730204
					],
					"speakerTitle": "里瑟"
				},
				{
					"id": 200730204,
					"content": "不过，我还是希望所有上雪山的人都做好充分的准备，不要动用到这些应急食品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730205
					],
					"speakerTitle": "里瑟"
				},
				{
					"id": 200730205,
					"content": "话说回来，你身上这些衣服也有点单薄了，难道这就是蒙德城里最新的时尚？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730206
					],
					"speakerTitle": "里瑟"
				},
				{
					"id": 200730206,
					"content": "请拿上这些报酬，赶快回去多添点衣服吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "里瑟"
				}
			]
		},
