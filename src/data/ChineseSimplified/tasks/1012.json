					"nextDialogs": [
						10120511
					],
					"speakerTitle": "莺儿"
				},
				{
					"id": 10120511,
					"content": "莫非你迷上我的体香了？那可就让人为难了呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120512
					],
					"speakerTitle": "莺儿"
				},
				{
					"id": 10120512,
					"content": "#欸…你们在说什么奇怪的话？{NICKNAME}，快把那三种霓裳花拿出来吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120513
					],
					"speakerTitle": "派蒙"
				}
			]
