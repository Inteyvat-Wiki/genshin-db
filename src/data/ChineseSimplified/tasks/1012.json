	"talks": [
		{
			"id": 101202,
			"completionStepIds": [
				101202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101202",
							"2"
						],
						"stepId": 101202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"博来"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10120201,
					"content": "老板，你们这里有霓裳花吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10120202,
					"content": "霓裳花？当然有，要哪一种？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120203
					],
					"speakerTitle": "博来"
				},
				{
					"id": 10120203,
					"content": "唔…哪一种？就、就是，最好的那种？原来霓裳花还有很多种的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10120204,
					"content": "哼，没见过世面的外国人，还问这种问题…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120205
					],
					"speakerTitle": "博来"
				},
				{
					"id": 10120205,
					"content": "「金屋藏娇」、「山阴锦簇」、「缥缈仙缘」，这三种霓裳花，麻烦老板各拿一株来看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120206
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10120206,
					"content": "——喔！这位老爷，是大行家啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120207
					],
					"speakerTitle": "博来"
				},
				{
					"id": 10120207,
					"content": "身边两个，是仆人吧。仆人就别抢在老爷之前开口了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120208,
						10120209,
						10120210
					],
					"speakerTitle": "博来"
				},
				{
					"id": 10120208,
					"content": "终于有一天，轮到我了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10120212
					]
				},
				{
					"id": 10120212,
					"content": "请，请，贵客看看吧，还有什么想法，也请说道说道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120213
					],
					"speakerTitle": "博来"
				},
				{
					"id": 10120213,
					"content": "嗯，根据生长环境与祖先亲族的不同，霓裳花会呈现出不同的性状…老板这几株都不错，保存得很新鲜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120214
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10120214,
					"content": "比如这种，枝繁叶茂，花蕊如金屋藏娇。绿叶长存，多生于有复杂水文条件之地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120215
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10120215,
					"content": "而山阴或者潮湿之地，霓裳花多生得瓣大而蕊密，香气扑鼻，堪称花团锦簇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120216
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10120216,
					"content": "最后这类则是孤傲清冷，枝、叶、花排布极疏，开花时香气寡淡，却极为持久，是古人登山访仙时偶然发现。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120217
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10120217,
					"content": "不过时至今日，大多野生的霓裳花都在璃月地理变迁的过程中绝迹了，现在多是依靠人工培育…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120218
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10120218,
					"content": "哎，先生确实是行家，连我自己都不知道有这么多讲究…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120219
					],
					"speakerTitle": "博来"
				},
				{
					"id": 10120219,
					"content": "略通一二而已。我这位旅行家朋友才是不容小觑，是终将踏遍大陆各处之人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120220,
						10120221
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10120220,
					"content": "其实也没那么厉害…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10120222
					]
				},
				{
					"id": 10120222,
					"content": "钟离先生太客气了…那么这三种霓裳花，我们该选哪种呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10120223,
					"content": "老板，我全要了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120224
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10120224,
					"content": "又来？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10120225,
					"content": "呵，听戏时要点最红的名伶，遛鸟时要买最名贵的画眉——此即人生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120226
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10120226,
					"content": "不过，这次买三种霓裳花，倒不是出于我的人生信条。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120227
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10120227,
					"content": "你有所不知，根据传统，若将不同的霓裳花分别做成香膏，供奉在「七天神像」前，岩王帝君便会自己作出选择。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120228
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10120228,
					"content": "不过这种古早时期的讲究，和一些过于复杂的传统，都已经逐渐被简化了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120229
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10120229,
					"content": "但这是三千七百年来，唯一属于七神之一的「送仙典仪」。我们还是遵照传统，逐一供奉这些香膏吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120230
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10120230,
					"content": "嗯，所以…嗯…你们有带钱么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120231
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10120231,
					"content": "你又没带钱吗——！钟离——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120232,
						10120233
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10120232,
					"content": "好像已经习惯了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10120234
					]
				},
				{
					"id": 10120234,
					"content": "…呃，客官们，不好意思，插一句嘴。你们是要把这些花，献给岩王爷？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120235
					],
					"speakerTitle": "博来"
				},
				{
					"id": 10120235,
					"content": "这么说也没错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120236
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10120236,
					"content": "唉，你们应该早说…那次「请仙典仪」之后，我也听到了不好的消息…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120237
					],
					"speakerTitle": "博来"
				},
				{
					"id": 10120237,
					"content": "不吉利的话，就不说了。总之我也一直很担心岩王爷，担心那个消息是真的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120238
					],
					"speakerTitle": "博来"
				},
				{
					"id": 10120238,
					"content": "如果是为了岩王爷的话，这些花就不收你们的钱了，替我带一份心意就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120239
					],
					"speakerTitle": "博来"
				},
				{
					"id": 10120239,
					"content": "这、真的合适吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120240
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10120240,
					"content": "瞧你这话说的，没有岩王爷，就没有我这种小民的栖身之地呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120241
					],
					"speakerTitle": "博来"
				},
				{
					"id": 10120241,
					"content": "若不是当年岩王爷题诗，这些珍品霓裳花的身价，哪能这么金贵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120242
					],
					"speakerTitle": "博来"
				},
				{
					"id": 10120242,
					"content": "哇…一路上听到的璃月风土人情，很多都是在某个时期，受到过神灵本人的直接关怀呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120243
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10120243,
					"content": "…总之，要谢谢老板了，解了我们的燃眉之急。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120244
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10120244,
					"content": "忘带钱还不是钟离的错！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120245
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10120245,
					"content": "唉，不过是一点小意思罢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "博来"
				},
				{
					"id": 10120233,
					"content": "他带了的话可能更奇怪。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10120234
					]
				},
				{
					"id": 10120221,
					"content": "我确实对霓裳花很无知…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10120222
					]
				},
				{
					"id": 10120209,
					"content": "这是喊派蒙应急食品的报应吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10120212
					]
				},
				{
					"id": 10120210,
					"content": "不，你不觉得我有点眼熟吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10120211
					]
				},
				{
					"id": 10120211,
					"content": "嗯？我们好像见过…哦，是旅者吧，不好意思了，刚才语气不太好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120212
					],
					"speakerTitle": "博来"
				}
			]
		},
		{
			"id": 101203,
			"completionStepIds": [
				101203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101203",
							"2"
						],
						"stepId": 101203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"岚姐"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10120301,
					"content": "岚姐，我们想请你帮个忙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10120302,
					"content": "我已经很长时间不接委托了，不好意思二位，请找其他冒险家吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120303
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 10120303,
					"content": "不用挂委托啦，只是很小很小的一件事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120304,
						10120307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10120304,
					"content": "岚姐会熬香膏吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10120305
					]
				},
				{
					"id": 10120305,
					"content": "…唔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120306
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 10120306,
					"content": "我看上去像是会用那种东西的人吗，总感觉被你小瞧了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120311
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 10120311,
					"content": "可是岚姐身上确实很香呀，不是香膏的话，会是什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10120312,
					"content": "这么说来，确实好像有一股香味，我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120313
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 10120313,
					"content": "哦，莫非是我上次回来时采摘的「清心」？原来我一直带在身上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120314
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 10120314,
					"content": "欸，原来是这样啊…岚姐竟然还有在路边摘花的雅兴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10120315,
					"content": "…唔，不过是药用而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120316
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 10120316,
					"content": "不要继续这种无意义的话题了，香膏的话…你们不如去找<color=#00E1FFFF>绮命</color>问问。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120317
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 10120317,
					"content": "是那位占卜师姐姐吧？嗯，确实给人香香的印象…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10120318,
					"content": "那我们先走啦，谢谢岚姐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10120307,
					"content": "岚姐闻起来很香。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10120308
					]
				},
				{
					"id": 10120308,
					"content": "…唔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120309
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 10120309,
					"content": "让我确定一下你们是不是在捉弄我，或者说什么反话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120310
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 10120310,
					"content": "我常年在外奔走，虽然也很注意打理自己，但要说「闻起来很香」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120311
					],
					"speakerTitle": "岚姐"
				}
			]
		},
