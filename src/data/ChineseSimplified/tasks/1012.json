			},
			"dialogs": [
				{
					"id": 10120501,
					"content": "欸，终于找到我了么？我可是等你们好久了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120502
					],
					"speakerTitle": "莺儿"
				},
				{
					"id": 10120502,
					"content": "嗯？你怎么会知道我们要过来？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10120503,
					"content": "我刚听说有两个人在满城找身上很香的人下手…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120504
					],
					"speakerTitle": "莺儿"
				},
				{
					"id": 10120504,
					"content": "我还担心你们不会来呢，某种意义上讲，这也是对我魅力的考验呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120505
					],
					"speakerTitle": "莺儿"
				},
				{
					"id": 10120505,
					"content": "「下手」？怎么说得我们好像是危险人物的样子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10120506,
					"content": "以讹传讹，三人成虎，言行最好谨慎一些哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120507
					],
					"speakerTitle": "莺儿"
				},
				{
					"id": 10120507,
					"content": "放心，我知道你们的来意，是想我帮忙做香膏吧？需要什么样的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120508,
						10120509
					],
					"speakerTitle": "莺儿"
				},
				{
					"id": 10120508,
					"content": "想用这三种霓裳花…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10120513
					]
				},
				{
					"id": 10120513,
					"content": "欸~居然要同时做三份…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120514
					],
					"speakerTitle": "莺儿"
				},
				{
					"id": 10120514,
					"content": "想不到明明这么年轻，胃口却不小呢，呵呵。该不会之前的传言是真的吧？是在物色可以送香膏的目标吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120515,
						10120518
					],
					"speakerTitle": "莺儿"
				},
				{
					"id": 10120515,
					"content": "是要献给「岩王帝君」的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10120516
					]
				},
				{
					"id": 10120516,
					"content": "噗…情急之下编了个这样的借口么？就算是献给神明，也不需要这么多种类吧？漏洞百出呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120517
					],
					"speakerTitle": "莺儿"
				},
				{
					"id": 10120517,
					"content": "唔…好像钟离也说过，这种传统已经被遗忘很久了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120520
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10120520,
					"content": "总之，「花开堪折直须折，莫待无花空折枝」…谁又能说你做得不对呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120521
					],
					"speakerTitle": "莺儿"
				},
				{
					"id": 10120521,
					"content": "咦，派蒙又听不懂了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120522
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10120522,
					"content": "好了，我帮你做就是了。来当我的助手吧。在熬香膏的这段时间里，你可得把心思放在我一个人身上呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120523
					],
					"speakerTitle": "莺儿"
				},
				{
					"id": 10120523,
					"content": "好吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10120524
					]
				},
				{
					"id": 10120524,
					"content": "那么，去哪里熬香膏比较好呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120525,
						10120528
					],
					"speakerTitle": "莺儿"
				},
				{
					"id": 10120525,
					"content": "达达乌帕谷里…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10120526
					]
				},
				{
					"id": 10120526,
					"content": "那是哪里…是蒙德吗？熬制香膏而已，不用那么大动干戈吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120527
					],
					"speakerTitle": "莺儿"
				},
				{
					"id": 10120527,
					"content": "不如选个近一点的地方，就去借用一下<color=#00E1FFFF>「万民堂」</color>的厨房吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莺儿"
				},
				{
					"id": 10120528,
					"content": "香菱家的厨房…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10120529
					]
				},
				{
					"id": 10120529,
					"content": "哦，你说的是<color=#00E1FFFF>「万民堂」</color>？不错的选择，那我们一起过去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莺儿"
				},
				{
					"id": 10120518,
					"content": "有什么不好呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10120519
					]
				},
				{
					"id": 10120519,
					"content": "欸呀！出人意料的坦荡呢。不过你长得这么俊，也确实有拈花惹草的资本。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120520
					],
					"speakerTitle": "莺儿"
				},
				{
					"id": 10120509,
					"content": "就想要你用的那种。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10120510
					]
				},
				{
					"id": 10120510,
					"content": "呵呵，我根本没用什么香膏哦。",
