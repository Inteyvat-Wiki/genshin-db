			"dialogs": [
				{
					"id": 10120401,
					"content": "嗯？有什么事吗，二位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120402
					],
					"speakerTitle": "绮命"
				},
				{
					"id": 10120402,
					"content": "绮命小姐有空的话，想问你件事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120403,
						10120405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10120403,
					"content": "绮命小姐会熬香膏吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10120404
					]
				},
				{
					"id": 10120404,
					"content": "香膏啊…我平时不用的，也没想过自己去熬制。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120411
					],
					"speakerTitle": "绮命"
				},
				{
					"id": 10120411,
					"content": "不过我的身上应该会有一些脂粉的味道，可能让你们误会了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120412
					],
					"speakerTitle": "绮命"
				},
				{
					"id": 10120412,
					"content": "我平常在码头附近摆摊，可不希望香膏引来更多色眯眯的水手…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120413
					],
					"speakerTitle": "绮命"
				},
				{
					"id": 10120413,
					"content": "这样呀，好遗憾哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10120414,
					"content": "不过，说起香膏，你们居然没听说过「莺儿的手工香膏」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120415
					],
					"speakerTitle": "绮命"
				},
				{
					"id": 10120415,
					"content": "莺儿，是…「春香窑」的那位<color=#00E1FFFF>莺儿</color>？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120416
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10120416,
					"content": "是的，许多人家的千金小姐，都会拜托她熬香膏来用。据说她手工自制的品质，比市面上贩卖的还要好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120417
					],
					"speakerTitle": "绮命"
				},
				{
					"id": 10120417,
					"content": "太好了，谢谢你的情报！这下应该不会再扑个空啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10120405,
					"content": "绮命小姐闻起来很香。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10120406
					]
				},
				{
					"id": 10120406,
					"content": "啊…唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120407
					],
					"speakerTitle": "绮命"
				},
				{
					"id": 10120407,
					"content": "…抱歉，没想到你会这么直白。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120408
					],
					"speakerTitle": "绮命"
				},
				{
					"id": 10120408,
					"content": "不过我对你其实还不是十分了解…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120409
					],
					"speakerTitle": "绮命"
				},
				{
					"id": 10120409,
					"content": "嗯？我们的意思是想问你平时用不用香膏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10120410,
					"content": "啊，咳咳…香膏的话，我没有在用哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120411
					],
					"speakerTitle": "绮命"
				}
			]
