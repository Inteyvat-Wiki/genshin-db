					"nextDialogs": [
						10120828
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10120828,
					"content": "接下来…希望二位可以代我去借一下「涤尘铃」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120829
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10120829,
					"content": "「涤尘铃」？",
