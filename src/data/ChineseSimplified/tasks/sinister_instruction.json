				{
					"id": 721410605,
					"content": "「他」很欣慰，而喜悦「他」的人，必获得奖赏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410606
					],
					"speakerTitle": "鹫津"
				},
				{
					"id": 721410606,
					"content": "「他」的奖赏不在彼岸，就在明天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410607,
						721410608
					],
					"speakerTitle": "鹫津"
				},
				{
					"id": 721410607,
					"content": "你知道自己在说什么吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410609
					]
				},
				{
					"id": 721410609,
					"content": "下次再来此处，自见分晓。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鹫津"
				},
				{
					"id": 721410608,
					"content": "恕我浅薄，道理尚有不明。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410609
					]
				},
				{
					"id": 721410603,
					"content": "福分浅薄，无缘一听。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410604
					]
				}
			]
		},
