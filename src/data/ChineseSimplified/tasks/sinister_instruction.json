			},
			"dialogs": [
				{
					"id": 721411701,
					"content": "必须平息「他」的怒火，必须安抚「他」的愤怒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411702
					],
					"speakerTitle": "鹫津"
				},
				{
					"id": 721411702,
					"content": "你做的很好，你做的很好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411703
					],
					"speakerTitle": "鹫津"
				},
				{
					"id": 721411703,
					"content": "切记，有的人会戴着面具，欺骗你，但「他」会帮助你，「他」永远襄助你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411704,
						721411705
					],
					"speakerTitle": "鹫津"
				},
				{
					"id": 721411704,
					"content": "呃…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411706
					]
				},
				{
					"id": 721411706,
					"content": "那个女人就像传说中的狐狸妖怪，我放跑了她，「他」很生气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411707
					],
					"speakerTitle": "鹫津"
				},
				{
					"id": 721411707,
					"content": "「他」现在又生气了…这是我的罪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411708
					],
					"speakerTitle": "鹫津"
				},
				{
					"id": 721411708,
					"content": "请原谅我…我会再次献祭，我会为您寻找下一个「回归」的祭品…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411709
					],
					"speakerTitle": "鹫津"
				},
				{
					"id": 721411709,
					"content": "请原谅我，请原谅我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411710
					],
					"speakerTitle": "鹫津"
				},
				{
