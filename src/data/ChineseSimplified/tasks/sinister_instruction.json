			"dialogs": [
				{
					"id": 721411201,
					"content": "「他」要来了！不要停止拜祭！不能停止拜祭！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411202,
						721411203
					],
					"speakerTitle": "鹫津"
				},
				{
					"id": 721411202,
					"content": "你还好吗…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411204
					]
				},
				{
					"id": 721411204,
					"content": "「他」在愠怒，「他」要发怒了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411205,
						721411206
					],
					"speakerTitle": "鹫津"
				},
				{
					"id": 721411205,
					"content": "什么…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411207
					]
				},
				{
					"id": 721411207,
					"content": "因为什么！因为那个女人！那个拒绝恩赏的邪佞之人！邪佞之人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411208,
						721411209
					],
					"speakerTitle": "鹫津"
				},
				{
					"id": 721411208,
					"content": "女人…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411210
					]
				},
				{
					"id": 721411210,
					"content": "她在逃跑，但她怎么逃得过「他」！十八双血色的眼睛！千千万万锋利的毒牙！永远渴求鲜血的、数不清的口与舌！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411211
					],
					"speakerTitle": "鹫津"
				},
				{
					"id": 721411211,
					"content": "她躲不过的，躲不过的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411212
					],
					"speakerTitle": "鹫津"
				},
				{
					"id": 721411212,
					"content": "啊，沙的寡情的国度，龟缩雨林自称智慧的愚昧乞丐，你们统统庇护不了她！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411213,
						721411214
					],
					"speakerTitle": "鹫津"
				},
				{
					"id": 721411213,
					"content": "请你冷静一点！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411215
					]
				},
				{
					"id": 721411215,
					"content": "你拿到了恩赏，速去拜祭！速去拜祭！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鹫津"
				},
				{
					"id": 721411214,
					"content": "哦哦，说得好！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411215
					]
				},
				{
					"id": 721411209,
					"content": "哦哦，真该死！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411210
					]
				},
				{
					"id": 721411206,
					"content": "哦哦，要发怒了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411207
					]
				},
				{
					"id": 721411203,
					"content": "哦哦，「他」要来了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411204
					]
				}
			]
		},
