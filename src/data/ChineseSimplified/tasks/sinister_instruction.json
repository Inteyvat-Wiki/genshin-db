				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721411101,
					"content": "拜祭，倾听…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411102
					],
					"speakerTitle": "鹫津"
				},
				{
					"id": 721411102,
					"content": "「他」因倾听而强大，因强大而能见一切，能听一切。由是而无所不见，无所不听…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411103
					],
					"speakerTitle": "鹫津"
				},
				{
					"id": 721411103,
					"content": "珊瑚宫的愚人也好，鸣神岛的妄人也好，对此毫无理解，毫无感受。所以他们只知道互相厮杀，让血蒙蔽双眼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411104
					],
					"speakerTitle": "鹫津"
				},
				{
					"id": 721411104,
					"content": "但你要理解这一点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411105,
						721411106
					],
					"speakerTitle": "鹫津"
				},
				{
					"id": 721411105,
					"content": "什么乱七八糟的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411107
					]
				},
				{
					"id": 721411107,
					"content": "答案就在拜祭中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411108
					],
					"speakerTitle": "鹫津"
				},
				{
					"id": 721411108,
					"content": "切记，每日拜祭三番，必有回赐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鹫津"
				},
				{
					"id": 721411106,
					"content": "大概能理解。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411107
					]
				}
			]
		},
