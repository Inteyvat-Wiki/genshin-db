					],
					"speakerTitle": "鹫津"
				},
				{
					"id": 721411802,
					"content": "你还好吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411803
					]
				},
				{
					"id": 721411803,
					"content": "谢谢你宽恕我的罪恶，请让我回归于你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411804
					],
					"speakerTitle": "鹫津"
				},
				{
					"id": 721411804,
					"content": "你在和我说话吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411805
					]
				},
				{
					"id": 721411805,
					"content": "什么…但为什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411806
					],
					"speakerTitle": "鹫津"
				},
				{
					"id": 721411806,
					"content": "我主持了每一次祭献，我接受了你的每一场恩典！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411807
					],
					"speakerTitle": "鹫津"
				},
				{
					"id": 721411807,
					"content": "而她，被你所标记，为你所成就，却逃离你的恩赐，背叛了我们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411808
					],
					"speakerTitle": "鹫津"
				},
				{
					"id": 721411808,
					"content": "你在说什么…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411809
					]
				},
				{
					"id": 721411809,
					"content": "呀啊！唔呃…对不起…对不起…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411810
					],
					"speakerTitle": "鹫津"
				},
				{
					"id": 721411810,
					"content": "不应该怀疑「他」的选择，继续隐忍，继续拜祭…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411811
					],
					"speakerTitle": "鹫津"
				},
				{
					"id": 721411811,
					"content": "听得到我说话吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411812
					]
				},
				{
					"id": 721411812,
					"content": "继续隐忍…继续拜祭…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411813
					],
					"speakerTitle": "鹫津"
