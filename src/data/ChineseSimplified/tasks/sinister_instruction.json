			"trigger": {
				"objectNames": [
					"鹫津"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721410101,
					"content": "…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410102,
						721410103
					],
					"speakerTitle": "鹫津"
				},
				{
					"id": 721410102,
					"content": "你好？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410105
					]
				},
				{
					"id": 721410105,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410106
					],
					"speakerTitle": "鹫津"
				},
				{
					"id": 721410106,
					"content": "你在听我讲话吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410107
					]
				},
				{
					"id": 721410107,
					"content": "…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410108,
						721410109
					],
					"speakerTitle": "鹫津"
				},
				{
					"id": 721410108,
					"content": "你好…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410110
					]
				},
				{
					"id": 721410110,
					"content": "…请你不要打扰我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410111
					],
					"speakerTitle": "鹫津"
				},
				{
					"id": 721410111,
					"content": "「他」很不悦，不悦于口舌之语的扰乱，遮蔽了「心之语」的智慧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410112
					],
					"speakerTitle": "鹫津"
				},
				{
					"id": 721410112,
					"content": "口舌之语…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410113
					]
				},
				{
					"id": 721410113,
					"content": "口舌之语就像骤雨，敲振耳膜，搅扰心智。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410114
					],
					"speakerTitle": "鹫津"
				},
				{
					"id": 721410114,
					"content": "而「心之语」则像雾气，自然而来，氤氲而入…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410116
					],
					"speakerTitle": "鹫津"
				},
				{
					"id": 721410116,
					"content": "嘘…！「他」在听着，「他」在说话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410117
					],
					"speakerTitle": "鹫津"
				},
				{
					"id": 721410117,
					"content": "不要用口舌，不要用耳朵，用心来听…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410118
					],
					"speakerTitle": "鹫津"
				},
				{
					"id": 721410118,
					"content": "来这里，拜祭，祈祷，然后倾听。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410119
					],
					"speakerTitle": "鹫津"
				},
				{
					"id": 721410119,
					"content": "要拜祭三番，记住，三番。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410120,
						721410121
					],
					"speakerTitle": "鹫津"
				},
				{
					"id": 721410120,
					"content": "（试试好了。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 721410121,
					"content": "还是不了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 721410109,
					"content": "如果能说话就点点头吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410110
					]
				},
				{
					"id": 721410103,
					"content": "你在做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410105
					]
				}
			]
		},
