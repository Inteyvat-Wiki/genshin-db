			},
			"dialogs": [
				{
					"id": 721410701,
					"content": "与「他」的莫大福泽相比，这只不过是一点小小赏赐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410702
					],
					"speakerTitle": "鹫津"
				},
				{
					"id": 721410702,
					"content": "祈祷吧，拜祭吧，倾听「他」，并且让「他」倾听你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410703
					],
					"speakerTitle": "鹫津"
				},
				{
					"id": 721410703,
					"content": "然后，你将同我一样，听到「他」的话语，从你的心内传出。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410704
					],
					"speakerTitle": "鹫津"
				},
				{
					"id": 721410704,
					"content": "然后，「他」将引你脱离苦痛，得大恩赏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410705,
						721410706
					],
					"speakerTitle": "鹫津"
				},
				{
					"id": 721410705,
					"content": "唔…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410707
					]
				},
				{
					"id": 721410707,
					"content": "记住，每日拜祭三番，必有回赐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410708
					],
					"speakerTitle": "鹫津"
				},
				{
					"id": 721410708,
					"content": "切记，切记。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鹫津"
				},
				{
					"id": 721410706,
					"content": "随便你怎么说吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410707
					]
				}
			]
		},
