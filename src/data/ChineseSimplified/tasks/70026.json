			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凯瑟琳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700260101,
					"content": "你好，旅行者，我们又见面了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260102
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 700260102,
					"content": "你最近的委托接取和完成记录都非常漂亮，说是冒险家协会的明星会员也不为过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260103,
						700260105
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 700260103,
					"content": "哪里哪里。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260104
					]
				},
				{
					"id": 700260104,
					"content": "我们冒险家协会稻妻分会和其他分会平时就有交流，你在蒙德和璃月的事迹我们都听说了，你就不用谦虚了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260107
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 700260107,
					"content": "这次请你过来，其实是想请你考虑一份比较简单的调查委托，需要调查的区域位于鹤观。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260108
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 700260108,
					"content": "虽说鹤观地区的天气比较特别，经常有大雾笼罩，但只是进行调查任务的话，应该不会有太大危险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260109
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 700260109,
					"content": "协会曾经将这份委托分派给一位比较有经验的冒险家，但这位冒险家前往鹤观后，很快就回来取消了委托。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260110
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 700260110,
					"content": "他也未做过多说明，只是匆忙说明自己能力有限，放弃了这个委托。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260111
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 700260111,
					"content": "可是在他之后，这份委托挂了很久也没有人接，委托人也来问了很多次…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260112
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 700260112,
					"content": "所以我想，如果请一位生存能力优更优秀、冒险经验也更丰富的冒险家，应该能完美解决这份委托。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260113
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 700260113,
					"content": "于是我想到了你。旅行者，你觉得怎么样呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260114,
						700260117
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 700260114,
					"content": "感觉有些可疑。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260115
					]
				},
				{
					"id": 700260115,
					"content": "你这么想我也能够理解，那位冒险家的放弃也在我们意料之外…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260116
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 700260116,
					"content": "鹤观向来人迹罕至，协会对那里的情况了解的不多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260120
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 700260120,
					"content": "嗯，既然如此，我们可以变通一下，稍微降低一下要求。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260121
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 700260121,
					"content": "你在调查区域遇到难以处理的危险时，可以立即返回协会要求协助，不必执着于完整地调查。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260122
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 700260122,
					"content": "说起来，委托人是一位从须弥「教令院」来的学者，据说原本是想来研究鹤观的气候的，但在调研过程中遇到了一些困难。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260123
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 700260123,
					"content": "所以才会在这里发布调查任务，这位学者似乎是拿出了一大半的研究经费，委托的报酬是很丰厚的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260124,
						700260125
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 700260124,
					"content": "我接了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260126
					]
				},
				{
					"id": 700260126,
					"content": "你愿意接受委托真是太好了，我现在就来帮你把调查地点标记出来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260127
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 700260127,
					"content": "调查的时候请务必注意安全，那么，祝你一切顺利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260128
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 700260128,
					"content": "向着星辰与深渊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 700260125,
					"content": "要试试也不是不行…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260126
					]
				},
				{
					"id": 700260117,
					"content": "我想想…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260118
					]
				},
				{
					"id": 700260118,
					"content": "你犹豫的理由是委托有未知的危险吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260119
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 700260119,
					"content": "实话说，其实也有其他的冒险家以相同的原因拒绝过…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260120
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 700260105,
					"content": "有话直说。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260106
					]
				},
				{
					"id": 700260106,
					"content": "你果然和传说中的一样，是个爽快的人呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260107
					],
					"speakerTitle": "凯瑟琳"
				}
			]
		},
		{
			"id": 7002602,
			"completionStepIds": [
				7002603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7002603",
							"2"
						],
						"stepId": 7002603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凯瑟琳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700260201,
					"content": "旅行者，你回来了啊，情况怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260202
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 700260202,
					"content": "关于「会复活的遗迹重机」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260203
					]
				},
				{
					"id": 700260203,
					"content": "出现在调查区域的奇怪遗迹重机，不管打倒多少次都会重新站起来…这个情况委托人完全没有提过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260204
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 700260204,
					"content": "难怪之前那位冒险家一副不想多提的样子，应该是在那个奇怪的遗迹重机那里吃了亏吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260205
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 700260205,
					"content": "这种严重影响冒险家生命安全的事，应该早点跟我们说明才是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260206
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 700260206,
					"content": "明明在填写委托内容说明的时候还特别讲了要坦诚清晰的，胡塞尼先生怎么能这样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260207
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 700260207,
					"content": "语焉不详、内容错漏，最近越来越多委托内容说明都是这样，这样叫协会怎么给冒险家分配任务呢，真是的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260208,
						700260210
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 700260208,
					"content": "你辛苦了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260209
					]
				},
				{
					"id": 700260209,
					"content": "我倒还好了，只是希望委托人在前期发布委托时，能够跟协会沟通清楚吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260212
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 700260212,
					"content": "不好意思，没忍住就说了这些多余的话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260213
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 700260213,
					"content": "总之，我认为合理的处理办法是由你直接和委托人沟通，直接把「会复活的遗迹重机」的情况告诉他本人，降低沟通成本。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260214
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 700260214,
					"content": "看看他是否能接受这样的调查结果，这样还要继续调查的话，委托人本人也应该一起想想解决办法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260215
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 700260215,
					"content": "我这里也会做好情况登记工作，如果这个委托还要继续的话，协会随时都可以为你提供援助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260216
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 700260216,
					"content": "我明白了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260217
					]
				},
				{
					"id": 700260217,
					"content": "那就辛苦你去和委托人胡塞尼先生谈一谈了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 700260210,
					"content": "这也是冒险的一部分吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260211
					]
				},
				{
					"id": 700260211,
					"content": "代表协会和委托人们沟通毕竟是我的工作内容之一，这也是冒险的一部分…吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260212
					],
					"speakerTitle": "凯瑟琳"
				}
			]
		},
		{
			"id": 7002603,
			"completionStepIds": [
				7002604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7002604",
							"2"
						],
						"stepId": 7002604,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"胡塞尼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700260301,
					"content": "鹤观的研究工作…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260302,
						700260303
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260302,
					"content": "你好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260304
					]
				},
				{
					"id": 700260304,
					"content": "哦哦，我刚收到冒险家协会的情况说明时，就在猜接委托的是不是你，果然是你啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260305
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260305,
					"content": "这次的调查委托…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260306
					]
				},
				{
					"id": 700260306,
					"content": "唉，我知道你要说什么，凯瑟琳小姐刚刚跟我发了好大一通牢骚，我已经大致明白情况了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260307
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260307,
					"content": "在我委托你们调查的区域，出现了「会复活的遗迹重机」对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260308,
						700260309
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260308,
					"content": "没错。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260310
					]
				},
				{
					"id": 700260310,
					"content": "我的确是见过那台遗迹重机，但我真的不知道它能够「复活」呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260311
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260311,
					"content": "我来到稻妻之后，对传闻中大雾弥漫的鹤观产生了兴趣，曾经自己去调查过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260312
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260312,
					"content": "鹤观的迷雾诚不我欺，非常有研究价值。不过，我每次深入鹤观的尝试都失败了，完全没有取得任何进展…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260313
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260313,
					"content": "正当我这么想的时候，我发现了这个不被雾气笼罩的岛屿，以及那台遗迹重机。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260314
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260314,
					"content": "不过因为准备不足，我匆匆登岛之后没能停留太久就离开了，虽然看到过那台遗迹重机，但是没能仔细观察。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260315
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260315,
					"content": "的确不是我故意隐瞒，说实话，冒险和研究一样，总是会有你意料之外的情况出现，不是吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260316
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260316,
					"content": "不过，我想了想，我对这次的意外情况并不是完全没有头绪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260317
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260317,
					"content": "我的推测是：这台遗迹重机搭载有自我修复功能模块，并且有充足的外部能源供应保证它各项功能运转正常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260318
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260318,
					"content": "它和常见的遗迹重机相比先进了不少，应该是遗迹重机中的特异型号。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260319
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260319,
					"content": "遗迹重机一类的自律机关是通过混沌炉心提供能源的，混沌炉心一旦受损，机体动力不足自然就无法运转了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260320
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260320,
					"content": "但这台特异体不同，它的能源供应来自外部…这个外部能源我认为极有可能是地脉能量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260321
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260321,
					"content": "我在古代文明对能源的应用方面还是有些研究的，据文献记载，曾经有能够永远行动下去的自律机关存在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260322
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260322,
					"content": "如果这个记载可靠，这台特异体很有可能就是古代文明在能源研究方面的重要产物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260323
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260323,
					"content": "我们得想办法让它停下来，对它进行详细的研究才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260324
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260324,
					"content": "你有办法吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260325
					]
				},
				{
					"id": 700260325,
					"content": "解决办法有…嗯，至少三种，不过其中两种效率太低。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260326
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260326,
					"content": "我想想，啊，对了，这不是正好吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260327
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260327,
					"content": "在来稻妻之前，我新开了几个课题，从院里申请了几件文物作为研究材料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260328
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260328,
					"content": "这不，你来之前，我的同乡刚刚帮忙把它们送到我手上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260329
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260329,
					"content": "这其中有几组叫做「普尔希娜光钉」的古代仪器，理论上能够释放扰乱地脉的力量，正好可以用来切断这台特异体的能源供应。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260330
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260330,
					"content": "不过不知道怎么回事，这组「普尔希娜光钉」的功能好像都有点问题，不知道是不是在运输过程中被磕碰了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260331,
						700260332
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260331,
					"content": "那怎么办？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260333
					]
				},
				{
					"id": 700260333,
					"content": "搞科研就是会遇到这种意外情况嘛…哈哈，习惯就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260334
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260334,
					"content": "所以我想，既然我们都需要用「普尔希娜光钉」，我们可以尝试合作，一起修好它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260335,
						700260338
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260335,
					"content": "感觉被利用了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260336
					]
				},
				{
					"id": 700260336,
					"content": "话可不能这么说呀，我们这是恰好目的一致不是吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260337
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260337,
					"content": "而且，损人利己的事我是不会干的，有辱「教令院」的名声。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260341
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260341,
					"content": "好吧，我相信你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260342
					]
				},
				{
					"id": 700260342,
					"content": "太好了，那我们的合作就成立了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260343
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260343,
					"content": "「普尔希娜光钉」的维修难点在于维修所需的元件材质特殊，很难大量生产。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260344
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260344,
					"content": "一般采取的办法都是以旧修旧，也就是说我们需要收集使用同种元件的古代遗物，利用其中的元件去修复光钉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260345
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260345,
					"content": "好在这种元件在古代遗物中非常常见，哪里的地下埋藏有古代遗物群，哪里就能找到这种元件。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260346
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260346,
					"content": "当然，你也不用担心找不到古代遗物群，我们有现成的工具来提升效率。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260347
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260347,
					"content": "我交给你的这件工具叫做「阿叶夏混沌勘探器」，具体的运作原理比较复杂，我就不一一解释了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260348
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260348,
					"content": "总之，「阿叶夏混沌勘探器」会在探测到古代遗物群或者地脉能量异常点时发出提示，勘测准确率…还是比较高的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260349
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260349,
					"content": "我们的当务之急就是借它来寻找埋藏于地下深处的元件，找到了足够数量的元件我就可以开始维修校准了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260350
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260350,
					"content": "这项收集工作可能会花费几天时间，但我们要有耐心，要有稳扎稳打的科研精神。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260351
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260351,
					"content": "好了，你理解了的话就可以尝试使用一下这件伟大的工具了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260338,
					"content": "真的会有用吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260339
					]
				},
				{
					"id": 700260339,
					"content": "虽然我还没有实际使用过「普尔希娜光钉」，但驱动它运行的基本原理是经过学术界验证的，理论上不会出错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260340
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260340,
					"content": "你可以不相信我，但你要相信科技的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260341
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260332,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260333
					]
				},
				{
					"id": 700260309,
					"content": "你完全不知情吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260310
					]
				},
				{
					"id": 700260303,
					"content": "我们又见面了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260304
					]
				}
			]
		}
	]
}