						221030202
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 221030202,
					"content": "还没有…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221030203
					]
				},
				{
					"id": 221030203,
					"content": "请您快些吧，那位来无影去无踪的…指不定什么时候就会回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030204
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 221030204,
					"content": "要是他真动起手来，这客栈又要歇业了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菲尔戈黛特"
				}
			]
