			},
			"dialogs": [
				{
					"id": 221030101,
					"content": "真麻烦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030102
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 221030102,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221030103
					]
				},
				{
					"id": 221030103,
					"content": "咦？是客人吗？抱歉，最近客栈周围很奇怪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030104
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 221030104,
					"content": "有好几位客人在附近被怪物袭击，弄得有些客人都不敢来做生意了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030105
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 221030105,
					"content": "这样下去，迟早会惹出大麻烦来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030106
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 221030106,
					"content": "唔，看你的打扮，是旅行者吧…您愿意帮忙去周围看看吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030107,
						221030108
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 221030107,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221030109
					]
				},
				{
					"id": 221030109,
					"content": "谢谢您愿意帮忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030113
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 221030113,
					"content": "总之，就拜托您了，我会准备好报酬的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 221030108,
					"content": "是怪物很危险吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221030110
					]
				},
				{
					"id": 221030110,
					"content": "怪物危险？不，怪物倒是次要的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030111
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 221030111,
					"content": "主要是…怕哪个怪物触了那位的霉头…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030112
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 221030112,
					"content": "他对付怪物，可从来不看场合和在场的人等…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030113
					],
					"speakerTitle": "菲尔戈黛特"
				}
			]
		},
