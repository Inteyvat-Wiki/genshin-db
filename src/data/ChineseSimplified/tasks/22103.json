				{
					"id": 221030302,
					"content": "处理好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221030303
					]
				},
				{
					"id": 221030303,
					"content": "太好了…总算能安心做会生意了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030304
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 221030304,
					"content": "这是给您的报酬，收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030305
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 221030305,
					"content": "「那位」是谁？嗯…你没见过他吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030306
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 221030306,
					"content": "他有时候会在客栈顶上休息，您说不定看见过呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030307
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 221030307,
					"content": "不过，就算您见到他了，最好也别轻易去打扰他，他喜欢一个人呆着。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菲尔戈黛特"
				}
