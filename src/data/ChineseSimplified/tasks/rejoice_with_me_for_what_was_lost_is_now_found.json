					"id": 732441901,
					"content": "「充能转化容器」，希望拿到那个东西以后，就能够让奔奔恢复过来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441902
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732441902,
					"content": "如果实在不安心的话，我也一起去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441903,
						732441904
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732441903,
					"content": "你在这里陪奔奔吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441905
					]
				},
				{
					"id": 732441905,
					"content": "嗯，那我就在这里等你的好消息，一定要安全回来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "婕德"
				},
				{
					"id": 732441904,
					"content": "我们马上就会回来的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441905
					]
				}
			]
