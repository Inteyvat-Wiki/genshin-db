			"trigger": {
				"objectNames": [
					"婕德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732440101,
					"content": "怎么会…我居然忘记了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440102
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732440102,
					"content": "希望还来得及，至少，得去他的帐篷里先找一找…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440103
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732440103,
					"content": "婕德！咦，怎么了，你现在正要去哪吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732440104,
					"content": "#派蒙，还有{NICKNAME}…你们倒是来的正好，嗯，我现在得立刻去办件事情，我要去…阿德菲住的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440105
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732440105,
					"content": "阿德菲？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732440106,
					"content": "那个家伙不是和愚人众勾搭在一起的叛徒吗…哦！我懂了，你是想去搜刮他的帐篷！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732440107,
					"content": "不，我对那家伙留下来的东西毫无兴趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440108
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732440108,
					"content": "部族对这些叛徒遗留的东西应当如何处置有特定的规矩，哼…要不是因为这个，我恨不得把那家伙留下的东西全部烧光。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440109
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732440109,
					"content": "我要去他的帐篷是因为…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440110
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732440110,
					"content": "是因为奔奔吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440111
					]
				},
				{
					"id": 732440111,
					"content": "啊，对哦！奔奔在阿德菲那里，这可怎么办！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732440112,
					"content": "呜，婕德，你怎么把奔奔交给了那样的家伙呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732440113,
					"content": "唉，在、在那之前，我也不知道他是叛徒啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440114
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732440114,
					"content": "总之，得快点去阿德菲那里看看才行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440115
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732440115,
					"content": "#{NICKNAME}，我们也一起去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440116,
						732440117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732440116,
					"content": "事不宜迟…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440118
					]
				},
				{
					"id": 732440118,
					"content": "嗯，奔奔可千万别出事呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732440117,
					"content": "现在就出发吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440118
					]
				}
			]
		},
		{
			"id": 7324403,
			"completionStepIds": [
				7324403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324403",
							"2"
						],
						"stepId": 7324403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"婕德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732440301,
					"content": "快看，这里好像有点东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732440302,
					"content": "不过看上去不像是一份什么检查记录，而是一封信…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732440303,
					"content": "什么信，快打开看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440304
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732440304,
					"content": "看这封信上的意思，奔奔原来只是没有能量了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732440305,
					"content": "这么一想，不管是打开赤王陵的大门，还是为我们激活了权限，奔奔在一路上帮我们做了很多事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732440306,
					"content": "就算是奔奔，也会觉得累吧…可能就是因为为我们做了那么多事，所以它才失去了能量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440307
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732440307,
					"content": "上面提到有什么特殊的「充能转化容器」，可是帐篷里好像没有看到类似的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440308
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732440308,
					"content": "难道说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440309,
						732440312
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732440309,
					"content": "藏在某个地方？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440310
					]
				},
				{
					"id": 732440310,
					"content": "不太像，只是用来维修奔奔的话，也不用特地藏起来，直接使用不就好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440311
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732440311,
					"content": "我明白了！一定是这场交易还没发生！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440314
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732440314,
					"content": "所以奔奔没被阿德菲带到交易现场，当然也没有「充能转化容器」…那剩下的问题只有一个了，阿德菲交易的对象是谁？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440315
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732440315,
					"content": "哈，真是问了个蠢问题，会和他在部落外做这种交易的恐怕只有一类人了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440316,
						732440318
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732440316,
					"content": "是须弥的学者？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440317
					]
				},
				{
					"id": 732440317,
					"content": "是愚人众啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440320
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732440320,
					"content": "那我们现在怎么办？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440321
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732440321,
					"content": "还能怎么办，跟那群愚人众还有什么好话可说，当然是到了交易地点，把那些「充能转化容器」抢过来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440322
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732440322,
					"content": "好欸，抢过来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732440323,
					"content": "可是奔奔…奔奔现在的状态，没法携带在身上，当然也不可能带去交易现场…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440324
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732440324,
					"content": "如果放在别的地方，也并不安全。把它独自留在别处这种事…有一次就够了。",
