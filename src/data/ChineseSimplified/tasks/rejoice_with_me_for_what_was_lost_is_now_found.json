				},
				{
					"id": 732441705,
					"content": "快说！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441706
					]
				},
				{
					"id": 732441706,
					"content": "我说我说，你们想知道什么我都说！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441707
					],
					"speakerTitle": "愚人众交易人员"
				},
				{
					"id": 732441707,
					"content": "先说说你知道什么！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441708
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732441708,
					"content": "我、我们只是一直和阿德菲做一些交易而已…据说塔尼特的主母偏爱什么阿萨里格…还有那个新来的小姑娘…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441709
					],
					"speakerTitle": "愚人众交易人员"
				},
				{
					"id": 732441709,
					"content": "哼，虽说不知怎么回事，阿萨里格似乎也失踪了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441710
					],
					"speakerTitle": "愚人众交易人员"
				},
				{
					"id": 732441710,
					"content": "那个女人心狠手辣，不会容留对部族失去价值的人…所以，阿德菲为了保证自己的地位联系了我们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441711
					],
					"speakerTitle": "愚人众交易人员"
				},
				{
					"id": 732441711,
					"content": "之前我们在沙漠里的工作开展一直不是很顺利，这下倒是、倒是有点一拍即合的意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441712,
						732441716
					],
					"speakerTitle": "愚人众交易人员"
				},
				{
					"id": 732441712,
					"content": "失去价值…你是什么意思？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441713
					]
				},
				{
					"id": 732441713,
					"content": "我不知道…我真的不知道！那是他们沙漠人内部的事务…不过要我猜的话，可能是因为那个女人认为我们不可信任了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441714
					],
					"speakerTitle": "愚人众交易人员"
				},
				{
					"id": 732441714,
					"content": "…所以她才会疏远我们，而经常与我们联络的阿德菲也为此不安…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441715
					],
					"speakerTitle": "愚人众交易人员"
				},
				{
					"id": 732441715,
					"content": "毕竟我们还能撤离这个鬼地方，而他只能被榨干价值，然后任部落处置…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441724
					],
					"speakerTitle": "愚人众交易人员"
				},
				{
					"id": 732441724,
					"content": "只是阿德菲这个人异常狡猾，他要的东西我们给了不少，我们要的东西却一点眉目没有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441725
					],
					"speakerTitle": "愚人众交易人员"
				},
				{
					"id": 732441725,
					"content": "不过听说他出事了…虽然不知道出了什么事，但我们想，这不正好是个好机会…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441726
					],
					"speakerTitle": "愚人众交易人员"
				},
				{
					"id": 732441726,
					"content": "好机会？什么好机会？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441727
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732441727,
					"content": "我们估计之后也没有什么和阿德菲做交易的机会，所以就让他带上前几次信里说的什么特殊元能构装体…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441728
					],
					"speakerTitle": "愚人众交易人员"
				},
				{
					"id": 732441728,
					"content": "如果可以就夺过来，等过几天我们完全撤离了以后，也不算毫无所得…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441729
					],
					"speakerTitle": "愚人众交易人员"
				},
				{
					"id": 732441729,
					"content": "什么，原来你们也想来抢东西，怪不得，既没有货物也没看见那些「充能转化容器」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441730
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732441730,
					"content": "啊？「也」想来抢东西？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441731,
						732441732
					],
					"speakerTitle": "愚人众交易人员"
				},
				{
					"id": 732441731,
					"content": "对，快把「充能转化容器」交出来。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441733
					]
				},
				{
					"id": 732441733,
					"content": "唔，不会那个什么「充能转化容器」也是你们编的吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441734
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732441734,
					"content": "不，「充能转化容器」倒是真的，不过因为也是古代的东西，有很多，但不知道其中有没有能用的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441735
					],
					"speakerTitle": "愚人众交易人员"
				},
				{
					"id": 732441735,
					"content": "那这些「充能转化容器」在什么地方？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441736
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732441736,
					"content": "派蒙的气势真不错。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441737
					]
				},
				{
					"id": 732441737,
					"content": "#嘿嘿，是嘛…{NICKNAME}不要转移话题啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441738
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732441738,
					"content": "快，快把你们放东西的地点说出来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441739
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732441739,
					"content": "…就在附近的一个据点，这个就是据点的钥匙…我知道的我全告诉你们了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441740,
						732441741
					],
					"speakerTitle": "愚人众交易人员"
				},
				{
					"id": 732441740,
					"content": "走吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441742
					]
				},
				{
					"id": 732441742,
					"content": "好好好，我这就消失。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "愚人众交易人员"
				},
				{
					"id": 732441741,
					"content": "别让我们再看见你！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441742
					]
				},
				{
					"id": 732441732,
					"content": "遇上我们算你运气不好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441733
					]
				},
				{
					"id": 732441716,
					"content": "你们在沙漠里的工作…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441717
					]
				},
				{
					"id": 732441717,
					"content": "…机密。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441718
					],
					"speakerTitle": "愚人众交易人员"
				},
				{
					"id": 732441718,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441719
					]
				},
				{
					"id": 732441719,
					"content": "#你瞧，你惹{NICKNAME}生气啦！{M#他}{F#她}生气的后果很严重哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441720
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732441720,
					"content": "唔…！好吧，好吧！请别生气，我说就是了！虽然…虽然我知道的也不多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441721
					],
					"speakerTitle": "愚人众交易人员"
				},
				{
					"id": 732441721,
					"content": "我们的任务是调查沙漠住民各部落现状，以贸易的方式拉拢和渗透他们，吸引贤者注意…为须弥城内的执行官大人提供方便。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441722
					],
					"speakerTitle": "愚人众交易人员"
				},
				{
					"id": 732441722,
					"content": "另外…佛罗德洛克教授也在沙漠里寻找活体样本，他一向不服从「博士」大人的领导…要我说，这就是嫉妒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441723
					],
					"speakerTitle": "愚人众交易人员"
				},
				{
					"id": 732441723,
					"content": "咳咳，扯多了、扯多了…总之，阿德菲是我们的联络人，我们的物资交易一直由他负责。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441724
					],
					"speakerTitle": "愚人众交易人员"
				}
			]
		},
