			"dialogs": [
				{
					"id": 150200101,
					"content": "欸，恰斯卡？是阿尔帕长老让你来的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200102
					],
					"speakerTitle": "因卡纳克"
				},
				{
					"id": 150200102,
					"content": "嗯，她还有其他事要做，这边的情况怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200103
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150200103,
					"content": "唔…根据调查结果，应该是过去的几次深渊入侵，导致了地脉紊乱，在试炼场地里形成了各种各样的「阻塞」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200104
					],
					"speakerTitle": "因卡纳克"
				},
				{
					"id": 150200104,
					"content": "理论上只要清理掉这些阻塞，就能让气态燃素再次充盈，但实际操作起来却各有各的问题…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200105
					],
					"speakerTitle": "因卡纳克"
				},
				{
					"id": 150200105,
					"content": "具体情况，你们可以直接下去看看？也可以问问在场的工作人员。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "因卡纳克"
				}
			]
		},
