			"dialogs": [
				{
					"id": 150200801,
					"content": "#嗯？恰斯卡、{NICKNAME}，你们也来了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200802
					],
					"speakerTitle": "阿尔帕"
				},
				{
					"id": 150200802,
					"content": "阿尔帕长老？咦？他们说的绒翼龙呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200803
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150200803,
					"content": "已经先我们一步飞走了，看来是知道救兵要到，率先撤退了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200804
					],
					"speakerTitle": "阿尔帕"
				},
				{
					"id": 150200804,
					"content": "那它突然袭击人类的目的…是商队运送的食物吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200805
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150200805,
					"content": "不，这支商队运送的不是食物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200806
					],
					"speakerTitle": "阿尔帕"
				},
				{
					"id": 150200806,
					"content": "——哦！谢天谢地！「燃素翼」都还没事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200807
					],
					"speakerTitle": "年轻的行商"
				},
				{
					"id": 150200807,
					"content": "…「燃素翼」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200808
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150200808,
					"content": "哎呀，太感谢了。这批「燃素翼」是我们最重要的货物，万一有什么闪失，可真不知道该怎么办！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200809
					],
					"speakerTitle": "伊西多尔"
				},
				{
					"id": 150200809,
					"content": "…你们就是之前瓦尔米说的，要来跟我们谈合作的商队？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200810
					],
					"speakerTitle": "阿尔帕"
				},
				{
					"id": 150200810,
					"content": "啊，没错没错，那…您就是阿尔帕长老咯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200811
					],
					"speakerTitle": "伊西多尔"
				},
				{
					"id": 150200811,
					"content": "是我。各位舟车劳顿，又受了惊吓，就先跟我一起回花羽会好好休息吧，有什么事，可以之后再谈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200812
					],
					"speakerTitle": "阿尔帕"
				},
				{
					"id": 150200812,
					"content": "阿尔帕长老，那绒翼龙袭击的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200813
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150200813,
					"content": "唔，我看这些朋友并没有受重伤，货物也没什么损失…或许只是那只绒翼龙，偶然间受到了什么刺激吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200814
					],
					"speakerTitle": "阿尔帕"
				},
				{
					"id": 150200814,
					"content": "这附近的绒翼龙那么多，出现一两次意外也不奇怪，就不用费心去追查了…倒是飞行试炼那边，修整得怎么样了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200815,
						150200816
					],
					"speakerTitle": "阿尔帕"
				},
				{
					"id": 150200815,
					"content": "修理得差不多了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150200817
					]
				},
				{
					"id": 150200817,
					"content": "哦？飞行试炼？——那可真是巧了！阿尔帕长老，我们的「燃素翼」一定能在试炼上给您一个惊喜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200818
					],
					"speakerTitle": "伊西多尔"
				},
				{
					"id": 150200818,
					"content": "是吗？…听起来倒是挺有趣的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200819
					],
					"speakerTitle": "阿尔帕"
				},
				{
					"id": 150200819,
					"content": "嘿嘿，那绒翼龙的事就放一边…我们快回去谈谈「燃素翼」的合作吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200820
					],
					"speakerTitle": "伊西多尔"
				},
				{
					"id": 150200820,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200821
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150200821,
					"content": "问题好像都解决了？还怪顺利的嘛…那我们也走吧…咦？恰斯卡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200822
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150200822,
					"content": "你在看什么呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150200823
					]
				},
				{
					"id": 150200823,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200824
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150200824,
					"content": "染血的…羽毛？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200825
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150200825,
					"content": "这起风波最终不了了之，花羽会再次恢复了往日的平静。\\n在波澜不惊的日常中，飞行试炼也在紧锣密鼓地筹备…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 150200816,
					"content": "很快就能重启了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150200817
					]
				}
			]
		},
