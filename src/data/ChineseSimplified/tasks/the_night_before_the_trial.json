			"dialogs": [
				{
					"id": 150200401,
					"content": "居然用这么短的时间就清理完了…真不愧是你们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200402
					],
					"speakerTitle": "因卡纳克"
				},
				{
					"id": 150200402,
					"content": "接下来只要等气态燃素逐渐充盈，飞行试炼就能正常举办了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200403
					],
					"speakerTitle": "因卡纳克"
				},
				{
					"id": 150200403,
					"content": "唔…因卡纳克，我想先试飞一下，看看还有没有遗漏，能帮我安排一下吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200404
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150200404,
					"content": "欸？可是场地才刚刚清理完，万一有什么危险没发现…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200405
					],
					"speakerTitle": "因卡纳克"
				},
				{
					"id": 150200405,
					"content": "所以才更应该由我来检查吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200406
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150200406,
					"content": "啊…也对，以你的飞行技巧，就算有什么遗漏，也不会是致命的危险…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200407
					],
					"speakerTitle": "因卡纳克"
				},
				{
					"id": 150200407,
					"content": "这片区域里的环境还不稳定，不亲自试飞一下，很难检查出问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200408
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150200408,
					"content": "那我这就去安排。你准备好的话，就随时跟我说一声吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "因卡纳克"
				}
			]
