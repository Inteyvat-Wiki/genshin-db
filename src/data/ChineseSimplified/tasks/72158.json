				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721580101,
					"content": "雷暴…平息了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580102
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 721580102,
					"content": "看来四座「镇石」都封印好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580103
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 721580103,
					"content": "是的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580104
					]
				},
				{
					"id": 721580104,
					"content": "你、你回来了！你刚才是怎么上去的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580105
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 721580105,
					"content": "大祐说，你是穿过了一个和门一样的东西，然后就消失了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580106
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 721580106,
					"content": "那个门到底是什么东西？真是奇怪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580107
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 721580107,
					"content": "不过，上面到底发生了什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580108
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 721580108,
					"content": "我和悦子在下面的时候，听见上面突然出现了很大的动静，就和打雷一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580109
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 721580109,
					"content": "但是，明明雷暴都已经平息了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580110
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 721580110,
					"content": "是这样的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580111
					]
				},
				{
					"id": 721580111,
					"content": "石头飘在空中，拼出一个平台…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580112
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 721580112,
					"content": "这还真是…闻所未闻，我从来没听说过，清籁岛有这种自然现象…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580113
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 721580113,
					"content": "这怎么可能是…自然现象…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580114
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 721580114,
					"content": "无论怎么想都是一种…呃，非自然的…现象…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580115,
						721580116
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 721580115,
					"content": "确实。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580117
					]
				},
				{
					"id": 721580117,
					"content": "不过，不管这到底是什么现象，总之现在清籁岛的雷暴已经平息，协会委托给我们的任务也已经完成了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580118
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 721580118,
					"content": "关于奇怪的羽毛…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580119
					]
				},
				{
					"id": 721580119,
					"content": "这羽毛是…大祐，你来看看这根羽毛吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580120
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 721580120,
					"content": "我看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580121
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 721580121,
					"content": "抱歉，我分辨不出来这根羽毛的来历。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580122
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 721580122,
					"content": "这根羽毛的纹路和触感，都和我知道的那些鸟类对不上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580123
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 721580123,
					"content": "而且你看这根羽毛的尺寸，如果按照比例计算的话，这只鸟几乎要和天上那个石台一样大了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580124
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 721580124,
					"content": "这根羽毛很重要吗？如果你真想弄清楚这根羽毛的来历，不如就去冒险家协会挂个委托吧，说不定能找到些线索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580125,
						721580126
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 721580125,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580127
					]
				},
				{
					"id": 721580127,
					"content": "嗯，那么…再次谢谢你帮忙，冒险家。我和大祐这就回协会报告了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580128
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 721580128,
					"content": "对了，这些东西给你，就当做是报酬吧。虽然不多…但怎么也不能让你白帮我们这个忙嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580129
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 721580129,
					"content": "大祐，准备一下，我们要回协会了喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580130
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 721580130,
					"content": "那个，悦子…我们还是先去那个神社，看看「寝子」大人吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580131
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 721580131,
					"content": "我说你啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580132
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 721580132,
					"content": "那可是一只会说话的猫啊！会说话的猫！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580133
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 721580133,
					"content": "你这家伙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "悦子"
				},
				{
					"id": 721580126,
					"content": "我自己再想想…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580127
					]
				},
				{
					"id": 721580116,
					"content": "你说得对。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580117
					]
				}
			]
		}
	]
}