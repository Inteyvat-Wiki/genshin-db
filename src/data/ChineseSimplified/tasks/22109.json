			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"岚姐"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221090201,
					"content": "怎么样，消灭它们了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090202
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 221090202,
					"content": "还没有。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221090203
					]
				},
				{
					"id": 221090203,
					"content": "你到底是在谨慎地准备，还是在磨磨蹭蹭地偷懒？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090204
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 221090204,
					"content": "或者…两者皆有？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "岚姐"
				}
			]
		},
