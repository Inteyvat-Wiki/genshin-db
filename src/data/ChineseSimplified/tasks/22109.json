			"dialogs": [
				{
					"id": 221090301,
					"content": "怎么样，消灭它们了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090302
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 221090302,
					"content": "已经全部消灭了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221090303
					]
				},
				{
					"id": 221090303,
					"content": "干得不错，那群丘丘人没给你造成多大麻烦吧？没关系，我只是随口问问。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090304
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 221090304,
					"content": "依然没有发现和「剑」有关的东西？哼，又是意料之中的一无所获…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090305
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 221090305,
					"content": "好了，这是你的报酬，拿好，辛苦你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090306
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 221090306,
					"content": "为什么这么在意「剑」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221090307
					]
				},
				{
					"id": 221090307,
					"content": "…告诉你也没关系。那把叫做「藏锋」的剑，是我大哥的佩剑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090308
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 221090308,
					"content": "但是我大哥去世时，这把剑却没有被他带在身边。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090309
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 221090309,
					"content": "到底发生了什么，会让他连随身的武器都丢掉了呢，我一直想不明白…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090310
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 221090310,
					"content": "但是，到现在我也没有头绪，既没有找到剑，也不知道大哥到底遭遇了什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090311
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 221090311,
					"content": "好了，就说到这里，拿好你的报酬，去忙你自己的事情吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "岚姐"
				}
			]
		}
	]
