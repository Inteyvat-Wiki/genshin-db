			"trigger": {
				"objectNames": [
					"岚姐"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221090101,
					"content": "还是没有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090102
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 221090102,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221090103
					]
				},
				{
					"id": 221090103,
					"content": "又是你们，看来协会的任务确实越来越轻松了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090104
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 221090104,
					"content": "有兴趣的话，愿不愿意再接受一个我个人的委托？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090105
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 221090105,
					"content": "有很多拿着弓箭的丘丘人聚集在「归离原」中的一处地方，正威胁着过路的行人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090106
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 221090106,
					"content": "虽然只是丘丘人，但它们数量众多，又占据着制高点，一般的冒险家也拿它们没什么好办法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090107
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 221090107,
					"content": "你要做的，就是把它们利落地消灭掉。消灭之后，我会给你足够的报酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090108
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 221090108,
					"content": "还有，如果发现了什么与「剑」有关的东西，记得拿回来给我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090109,
						221090110
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 221090109,
					"content": "没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221090111
					]
				},
				{
					"id": 221090111,
					"content": "该说你年轻，还是该说你勇敢呢，这么果断就接下来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090112
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 221090112,
					"content": "不过，别的不说，倒是很像一个冒险家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090115
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 221090115,
					"content": "好了，闲话就不说了。好好准备之后，就去消灭那些魔物吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "岚姐"
				},
				{
					"id": 221090110,
					"content": "丘丘人和剑有关系吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221090113
					]
				},
				{
					"id": 221090113,
					"content": "没有关系。你只需要稍微留意一下。如果有，就带回来，如果没有，也没关系。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090114
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 221090114,
					"content": "这个委托的目标是消灭丘丘人，消灭它们，我就会正常付给你报酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090115
					],
					"speakerTitle": "岚姐"
				}
			]
		},
		{
