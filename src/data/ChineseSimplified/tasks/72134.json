						721340105
					]
				},
				{
					"id": 721340105,
					"content": "是无明砦！无明砦升出海面了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721340106
					],
					"speakerTitle": "梶"
				},
				{
