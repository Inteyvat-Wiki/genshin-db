						],
						"stepId": 7303711,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙",
					"兰拉娜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730370401,
					"content": "取得了「惟耶之实」。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730370402
					]
				},
				{
					"id": 730370402,
					"content": "终于拿到手了，珍贵的惟耶之实…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370403,
						730370405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730370403,
					"content": "真不容易。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730370404
					]
				},
				{
					"id": 730370404,
					"content": "嗯。之后，带给拉娜就行了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730370406,
					"content": "…你们是谁？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730370405,
					"content": "带给拉娜就行了吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730370406
					]
				}
			]
		},
		{
			"id": 7303705,
			"completionStepIds": [
				7303708
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7303708",
							"2"
						],
						"stepId": 7303708,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"302821",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"兰罗摩",
					"兰拉娜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730370201,
					"content": "#我们消灭了无留陀的化身。森林也会安宁一些吧。虽说「我们」，但主要依靠的是你的努力、你的勇气。谢谢你，那菈{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370202,
						730370205
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730370202,
					"content": "多亏了花冠和大家的支持…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730370203,
						730370204
					]
				},
				{
					"id": 730370205,
					"content": "不用客气。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730370206
					]
				},
				{
					"id": 730370203,
					"content": "让我有不放弃的勇气。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730370207
					]
				},
				{
					"id": 730370204,
					"content": "让我有站起来的力量。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730370207
					]
				},
				{
					"id": 730370206,
					"content": "#刚刚真是千钧一发…{NICKNAME}戴着花冠，真是太好了！这个花冠好神奇呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730370207,
					"content": "每一朵花，都连接着一颗兰那罗小小的心；而将所有的花朵编制成的花冠，说它是「玛哈桓那{RUBY#[D]兰那罗的宇宙}兰那薜那」的门扉也不过分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370208
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730370208,
					"content": "所以，我们能与你心意相通，在你感到痛苦时为你声援，将力量借给你，抵挡噩梦，帮助你战胜黑暗的时日，填补心中的虚空。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370209
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730370209,
					"content": "不再梦想、见不到我们的人；接受命运，不再前进的人；沉醉于恐惧与痛苦的人；他们内心已经变得坚硬，无法获得花的帮助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370210
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730370210,
					"content": "#正因为那菈{NICKNAME}是正直而善良的人，正因为那菈{NICKNAME}是那菈{NICKNAME}，花冠才能发挥作用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370211
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730370211,
					"content": "#那菈{NICKNAME}是兰那罗的友人。所以，我们不会让你独自承担面对无留陀、消灭邪恶，让世界变得明亮而纯洁的责任。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370212
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730370512,
					"content": "#毕竟，{NICKNAME}是我最好的伙伴，当然是最好的人！这么说来，之前提纳里也说过死域不会再出现了呢！死域的问题终于解决了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370513
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730370513,
					"content": "嗯。不要再见了，无留陀。在森林中仍有许多细小的无留陀，但我们已经战胜了最大的敌人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370514
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730370514,
					"content": "我能感受到，沙恒当中关于无留陀的记忆，已经彻底消除了。这么一来，即使是万物对「死」的记忆与畏怖，也无法让它再度复苏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370515
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730370515,
					"content": "#世界上仍然有许多觊觎生命的事物。但无论何时，都一定会有像那菈{NICKNAME}与那菈法留纳那样，像太阳一样金灿灿的人，我不担心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370516
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730370516,
					"content": "如今的森林有着明媚的未来。森林的孩子们会获得充足的阳光与雨露，只要消灭残存的无留陀就可以了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370517
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730370217,
					"content": "唔…不管怎么说，既然消灭了无留陀的化身，那接下来应该就是种下觉王树与惟耶之实了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730370218,
					"content": "嗯。你们等我片刻，我去将兰拉娜叫来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370219
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730370219,
					"content": "兰拉娜…对喔，要用兰拉娜的记忆，才能结出惟耶之实…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730370220,
					"content": "不过，兰拉娜不是在维摩庄附近吗？要怎么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730370221,
					"content": "消失了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730370222,
					"content": "哇！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730370223,
					"content": "#那菈{NICKNAME}、派蒙。兰拉娜感觉到，你们和无留陀的化身战斗。你们和兰罗摩，充满了勇气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370224,
						730370227
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730370224,
					"content": "你们是怎么从这么远的地方过来的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730370225
					]
				},
				{
					"id": 730370227,
					"content": "接下来…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730370228
					]
				},
				{
					"id": 730370225,
					"content": "我获得了兰穆护昆达的记忆，所以也明白怎么利用沙恒在森林中快速旅行。这个兰迦拉梨就叫「传送」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370226
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730370226,
					"content": "兰罗摩好厉害，兰穆护昆达的记忆交给你，一定也很开心。兰拉娜好久好久没有「传送」过了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370228
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730370228,
					"content": "接下来应该是种出新的觉王树吧？记得兰罗摩提到过「种子」的事情…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370229
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730370229,
					"content": "种子会明白要茁壮成长，变成大树，然后结出饱满的果实…谢谢你，兰罗摩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370230
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730370230,
					"content": "嗯。我会长成新的觉王树，然后将你的回忆与梦结成惟耶之实，用我的树根，将被无留陀侵蚀的梦之间的桥梁重新连上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370231
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730370231,
					"content": "你们在说什么呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370232,
						730370234
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730370232,
					"content": "兰罗摩就是种子。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730370233
					]
				},
				{
					"id": 730370234,
					"content": "你们在说什么呀？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730370235
					]
				},
				{
					"id": 730370233,
					"content": "我吸收了恒素果、觉王树与兰穆护昆达的记忆与力量，现在森林里没有比我更强壮的「种子」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370236
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730370235,
					"content": "我就是觉王树的种子。我吸收了恒素果、觉王树与兰穆护昆达的记忆与力量，现在森林里没有比我更强壮的「种子」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370236
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730370236,
					"content": "咦？我不明白…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370237
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730370237,
					"content": "原本我打算通过自己的眼睛、自己的身体，去积累只属于自己的记忆，过几十年、几百年以后，再回归土地，长成美丽的莎兰树。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370238
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730370238,
					"content": "如果不是你们，我就也不会有此殊荣，能一同消灭无留陀的化身、治愈森林，也无法积累如此多的记忆，成为莎兰树中的王者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370239
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730370239,
					"content": "啊，难道…觉树之堂的莎兰树，也是兰那罗变成的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370240
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730370240,
					"content": "他们是兰拉吉、兰雅玛、兰玛哈。而恒素果则是他们的记忆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370241
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730370241,
					"content": "那，兰罗摩变成树的话，就不能跑来跑去，也不能说话、不能唱歌了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370242
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730370242,
					"content": "虽然身为种子在地上行走的时间有些短暂，不过与你们一同度过的时间，比过往要充实数十倍，不，数百倍吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370243
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730370243,
					"content": "怎么会这样…我还想和兰罗摩一起玩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370244
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730370244,
					"content": "#这样啊。我明白，派蒙，你和那菈{NICKNAME}是我的朋友，这点永远也不会变…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370245
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730370245,
					"content": "获得了如此的记忆与力量后，我能够从沙恒中见到许多景象、听到许多故事。让我跟你说个故事吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370246
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730370246,
					"content": "嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370247
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730370247,
					"content": "隐蔽在金色的沙暴当中的永恒绿洲，其中没有任何生命。没有兰那罗有幸面见的，一切草木最古老的主宰，蛰伏在黄沙之中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370248
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730370248,
					"content": "曾经覆盖它的绿植也全都枯死，变成了无法把握的细沙。正如无留陀所悄声说的：一切美好的，终于会死去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370249
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730370249,
					"content": "但是，你要知道，尽管夜晚如此黑暗，其中也总会有星星闪耀；太阳也一定会升起。就算死渴求着主宰一切，生命也不会消失。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370250
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730370250,
					"content": "正如落入大地的黄叶将会成为萃华树的养料，而它的果实将养活驮兽、狐狸、林猪，而它们又将养活长鬓虎。森林中充满了生命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370251
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730370551,
					"content": "毒血曾经染黑大地。兰那罗与那菈一样，以为一切都将要结束，但现在关于它的记忆已经消失了。今天的森林比昨天更加繁茂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370552
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730370252,
					"content": "最终留下的都是美好的；就算别离，也终将会在沙恒中相会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370253
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730370253,
					"content": "终有一天，我的梦与你的梦、我的记忆与你的记忆，我们将会交错在一起，在沙恒的无数枝杈上开花，这又何尝不是一件好事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370254
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730370254,
					"content": "嗯…但是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370255
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730370255,
					"content": "派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730370256
					]
				},
				{
					"id": 730370256,
					"content": "嗯。嗯…我知道啦！兰罗摩，你是最好的「种子」，所以一定能长成又大又漂亮的树！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370257
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730370257,
					"content": "#所以、所以，就算变成了树，也不要忘记我、不要忘记{NICKNAME}，不要忘记我们一起的冒险哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370258,
						730370259,
						730370260
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730370258,
					"content": "谢谢你，兰罗摩。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730370261
					]
				},
				{
					"id": 730370259,
					"content": "再见，兰罗摩。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730370261
					]
				},
				{
					"id": 730370260,
					"content": "这样就结束了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730370261
					]
				},
				{
					"id": 730370261,
					"content": "#嗯。谢谢你们，派蒙、那菈{NICKNAME}。很高兴认识你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370262
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730370262,
					"content": "兰拉娜，我一定会将你的记忆，结成最美丽最饱满的惟耶之实。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370263
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730370263,
					"content": "我相信你，兰罗摩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰拉娜"
				}
			]
		},
		{
			"id": 7303708,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
