			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙",
					"兰拉娜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730370301,
					"content": "兰罗摩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730370302,
					"content": "兰罗摩已经长成了新的觉王树。虽然现在还很小，但根扎得很深，很强壮。过很多很多个月亮，一定会变得又大、又漂亮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370303
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730370303,
					"content": "兰拉娜说过，回忆和梦是兰那罗的力量，是最珍贵的东西。放弃记忆，就会忘记拉娜吧？还有维摩庄的孩子们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730370304,
					"content": "嗯。但朋友比回忆更珍贵。无论失去多少记忆，都能再累积。如果失去了朋友，就回不来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370305
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730370305,
					"content": "我想要帮助那菈拉娜。她的名字和兰拉娜一样，是兰拉娜的朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370306
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730370306,
					"content": "而且，就算兰拉娜忘记了，你也记得。只要你记得，你的记忆终有一天也会长成饱满的果实…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370307
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730370307,
					"content": "…我明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730370308,
					"content": "我们要怎么做？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730370309
					]
				},
				{
					"id": 730370309,
					"content": "#兰拉娜教你的「大梦的曲调」，那菈{NICKNAME}还记得吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370310
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730370310,
					"content": "对兰拉娜和兰罗摩，唱这个歌就可以了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰拉娜"
				}
			]
		},
		{
			"id": 7303704,
			"completionStepIds": [
				7303711
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7303711",
