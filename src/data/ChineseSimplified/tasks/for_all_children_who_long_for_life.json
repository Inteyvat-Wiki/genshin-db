			},
			"dialogs": [
				{
					"id": 730370801,
					"content": "#那菈{NICKNAME}，快一点。不然，兰拉娜留在那菈拉娜身边的兰迦拉梨，不能维持很久。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370802
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730370802,
					"content": "准备好了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730370803
					]
				},
				{
					"id": 730370803,
					"content": "嗯。不用担心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰拉娜"
				}
			]
		},
		{
			"id": 7303711,
			"completionStepIds": [
				7303703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7303703",
							"2"
						],
						"stepId": 7303703,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_PLAYER_CHOOSE_MALE",
						"rawParams": [
							"0"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙",
					"兰罗摩"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730370101,
					"content": "这到底是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730370102,
					"content": "那就是上一次战争结束的地方。我们…他们在这里压制了无留陀的化身，然后设下四重的封印，将它囚禁在这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370103
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730370103,
					"content": "真可怕…无留陀的化身，就在这里面吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730370104,
