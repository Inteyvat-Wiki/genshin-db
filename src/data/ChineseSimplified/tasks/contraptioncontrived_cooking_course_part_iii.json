			"dialogs": [
				{
					"id": 705000701,
					"content": "嗯…味道真是不错，不愧是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000702,
						705000703
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 705000702,
					"content": "不愧是您。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705000704
					]
				},
				{
					"id": 705000704,
					"content": "正是。这三道菜做下来，本仙亲自制作的这台「机关烹饪神机」，其可靠性已完全得到验证。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000705
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 705000705,
					"content": "只要解决控制火候与自动取回食材这两大问题，这台机关便能「一键烹饪」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000706
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 705000706,
					"content": "对了，这份「红烩兽肉」的食谱你收好。食谱中所写的肉类，特指寻常兽肉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000707
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 705000707,
					"content": "雪山天寒地冻，不能让你总来此地寻材觅食…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000708
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 705000708,
					"content": "平日里下厨做这道菜，用寻常兽肉便可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000709
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 705000709,
					"content": "好了，多谢你帮本仙搜罗食材，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000710
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 705000710,
					"content": "本仙也该带着「机关烹饪神机」回洞府去，再好好琢磨一番了。就此别过吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000711
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 705000711,
					"content": "噢，本仙若还有什么事需要帮忙的话…说不定还会再找你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000712
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 705000712,
					"content": "到时候，你可千万不要推辞啊。毕竟本仙信得过你，最是认可你的实力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 705000703,
					"content": "不愧是您的「机关烹饪神机」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705000704
					]
				}
			]
