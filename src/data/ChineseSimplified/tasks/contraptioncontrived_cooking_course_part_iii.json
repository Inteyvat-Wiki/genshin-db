				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705000501,
					"content": "这是…什么肉？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000502
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 705000502,
					"content": "冷鲜肉。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705000503
					]
				},
				{
					"id": 705000503,
					"content": "冷鲜肉…名字倒是贴切。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000504
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 705000504,
					"content": "唔…品质不错。但看肉的状态，还需要稍加小火，化冻才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000505
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 705000505,
					"content": "幸好，本仙设计的「机关烹饪神机」兼有解冻之能…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000506,
						705000512
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 705000506,
					"content": "这机关好像什么功能都不缺。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705000507
					]
				},
				{
					"id": 705000507,
					"content": "怎么会呢？要说功能缺失，自然也有。例如，自动取回食材啊，自动控制火候…之类的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000508
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 705000508,
					"content": "这机关，还是需要多多改进。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000509
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 705000509,
					"content": "好了，闲话不多说。既然食材备齐，本仙马上就去开启机关。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000510
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 705000510,
					"content": "照看火候的事，依然交给你负责，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000511
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 705000511,
					"content": "你准备好之后，速来知会本仙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 705000512,
					"content": "仙人，果然很强大。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705000513
					]
				},
				{
					"id": 705000513,
					"content": "与其赞赏仙力，本仙更希望你赞赏「机关烹饪神机」的巧能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000509
					],
					"speakerTitle": "留云借风真君"
				}
			]
		},
