					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"留云借风真君"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705000101,
					"content": "冰天雪地，玉树琼枝…寂寞又冷冽之地啊。本仙这第三道菜，倒是应景得很。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000102
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 705000102,
					"content": "这次又要做什么菜？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705000103
					]
				},
				{
					"id": 705000103,
					"content": "唔…本仙问你，你有没有听说过一种名为「烩」的烹饪手法？这种手法也是本仙翻阅食谱时偶然发现的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000104
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 705000104,
					"content": "本仙深感有趣，特意以这种烹饪手法为核心，写出了一份名为「红烩兽肉」的新食谱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000105
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 705000105,
					"content": "虽然对本仙的「机关烹饪神机」来说，这道菜并不麻烦，但「红烩兽肉」这道菜重点在肉，所用的兽肉必须是优品…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000106
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 705000106,
					"content": "因此，本仙开启机关，一路追寻着食材的气息来到这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000107
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 705000107,
					"content": "此处风雪弥漫，实难办事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000108
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 705000108,
					"content": "旅行者，本仙知道你见识广阔又精于冒险，区区雪山，对你而言，肯定不在话下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000109
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 705000109,
					"content": "就请你再为本仙跑一趟，寻些食材回来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000110,
						705000116
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 705000110,
					"content": "第三份食谱我也要哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705000111
					]
				},
				{
					"id": 705000111,
					"content": "自然忘不了你的。那这件事就交给你了，本仙就在这里等着你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000112
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 705000112,
					"content": "呃，机关怎么突然停了，难不成是周遭太冷…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000113
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 705000113,
					"content": "待本仙重启一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000114
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 705000114,
					"content": "机关烹饪神机…启！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000115
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 705000115,
					"content": "这下应该好了…旅行者，你快循着气息的踪迹，去把本仙要的食材拿回来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 705000116,
					"content": "您冷得飞不动了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705000117
					]
				},
				{
					"id": 705000117,
					"content": "笑话！本仙威能，岂容你小觑！本仙只是、只是…需要在此修缮机关罢了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000118
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 705000118,
					"content": "你且快去快回吧，莫要让本仙等待太久。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000112
					],
					"speakerTitle": "留云借风真君"
				}
			]
		},
