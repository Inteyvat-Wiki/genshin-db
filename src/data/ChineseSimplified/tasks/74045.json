					"nextDialogs": [
						740450604,
						740450607,
						740450609
					],
					"speakerTitle": "芙佳"
				},
				{
					"id": 740450604,
					"content": "关于珍贵的宝石…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450605
					]
				},
				{
					"id": 740450605,
					"content": "虽然附近的矿脉有很多亮闪闪的、好看的石头，但是距离真正的宝石还有很大的差距…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450606
					],
					"speakerTitle": "芙佳"
				},
				{
					"id": 740450606,
					"content": "如果我也能够找到真正的宝石的话，说不定就能像希露艾姐姐一样拥有自己的宝石工坊了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芙佳"
				},
				{
					"id": 740450607,
					"content": "关于矿石的用途…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450608
					]
				},
				{
					"id": 740450608,
					"content": "欸？芙佳从来没有想过这些…我只是觉得好看才会收集各种各样的石头的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芙佳"
				},
				{
					"id": 740450609,
					"content": "没问题了。",
