			"dialogs": [
				{
					"id": 740450201,
					"content": "芙佳，我们回来啦！你的信物已经找到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740450202,
					"content": "将找到的信物交给了芙佳。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740450203
					]
				},
				{
					"id": 740450203,
					"content": "嗯嗯，就是这个没错，谢谢你们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450204
					],
					"speakerTitle": "芙佳"
				},
				{
					"id": 740450204,
					"content": "不过，我们在找信物的时候还发现了这个…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740450205,
					"content": "是之前从来没有见过的矿石，想着说不定会是什么珍贵的宝石呢，所以就一起带回来啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740450206,
					"content": "我记得芙佳说自己以前经常在这附近捡好看的石头回来，应该也有见过这样的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740450207,
					"content": "让我看看…确实很好看！不过…不是什么珍贵的石头，只是普通的石头而已…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450208
					],
					"speakerTitle": "芙佳"
				},
				{
					"id": 740450208,
					"content": "虽然在其它地方可能没有这样的矿石，不过在这里的矿脉附近到处都是！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450209
					],
					"speakerTitle": "芙佳"
				},
				{
					"id": 740450209,
					"content": "什么嘛，原来只是普通的石头啊，我还以为会很值钱呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740450210,
					"content": "看起来也没有什么其它用途，我们就找个地方把它丢掉好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450211,
						740450212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740450211,
					"content": "不过外面的人说不定没见过…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450213
					]
				},
				{
					"id": 740450213,
					"content": "哦哦，你的意思是说，如果拿到外面去卖的话，说不定可以卖个好价钱？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740450214,
					"content": "#的确外面的人肯定不会想到来美露莘的村子里面采矿，他们应该也没见过这种矿石…好聪明啊，{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740450215,
					"content": "既然这样，我们就把这个石头拿去枫丹廷，给那里的商人看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740450216,
					"content": "嗯，你们要是想知道更多关于矿石的事情的话，也欢迎随时来这里找我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450217
					],
					"speakerTitle": "芙佳"
				},
				{
					"id": 740450217,
					"content": "虽然我不像姐姐一样拥有自己的宝石工坊，鉴定处理之类的事情我也不太懂…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450218
					],
					"speakerTitle": "芙佳"
				},
				{
					"id": 740450218,
					"content": "比起那些珍贵的宝石，我更喜欢收集各种各样有趣的石头…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450219
					],
					"speakerTitle": "芙佳"
				},
				{
					"id": 740450219,
					"content": "所以这附近矿脉的情况我还是很了解的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450220
					],
					"speakerTitle": "芙佳"
				},
				{
					"id": 740450220,
					"content": "嗯嗯，知道啦，芙佳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740450212,
					"content": "不过如果只在这里有的话…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450213
					]
				}
			]
		},
