			"dialogs": [
				{
					"id": 740450101,
					"content": "芙佳你怎么又跑到这里来了啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740450102,
					"content": "虽然附近应该不会再出现什么魔物了，但也不知道还会不会有其它危险…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740450103,
					"content": "一个人的话还是不要到处乱跑会比较好吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740450104,
					"content": "#派蒙和{NICKNAME}{M#哥哥}{F#姐姐}，我没有乱跑啦…其实我是过来找我的「信物」的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450105
					],
					"speakerTitle": "芙佳"
				},
				{
					"id": 740450105,
					"content": "欸？你的「信物」弄丢了嘛？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740450106,
					"content": "嗯…应该是在我之前捡石头的那个地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450107
					],
					"speakerTitle": "芙佳"
				},
				{
					"id": 740450107,
					"content": "唔…该不会是上次被困住的时候，一不小心丢在那里的吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740450108,
					"content": "呜呜…应该就是那个时候弄丢的没错…当时因为太害怕了，完全没顾得上这些…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450109
					],
					"speakerTitle": "芙佳"
				},
				{
					"id": 740450109,
					"content": "虽然现在想起来也有点可怕，但是「信物」很重要，必须得找回来才行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450110
					],
					"speakerTitle": "芙佳"
				},
				{
					"id": 740450110,
					"content": "唔…不过要是芙佳一个人过去找的话也太危险了，既然这样的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740450111,
					"content": "#{NICKNAME}，我们就再去一趟之前那个地方，帮芙佳把「信物」找回来吧，芙佳就先回家等我们好啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450112,
						740450113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740450112,
					"content": "交给我们吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450114
					]
				},
				{
					"id": 740450114,
					"content": "#谢谢你们，{NICKNAME}{M#哥哥}{F#姐姐}，派蒙！我会乖乖待在家里等你们的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芙佳"
				},
				{
					"id": 740450113,
					"content": "正好趁机探索一番。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450114
					]
				}
			]
		},
