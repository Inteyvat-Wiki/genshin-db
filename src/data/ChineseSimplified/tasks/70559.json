			"dialogs": [
				{
					"id": 705590101,
					"content": "大家好呀！看起来，你们的精神都不错呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705590102,
					"content": "多谢关心，这几天收获很大，还要多多感谢米卡教官、埃洛雯，还有荣誉骑士和派蒙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590103
					],
					"speakerTitle": "特雷斯"
				},
				{
					"id": 705590103,
					"content": "唔，好像有点在发表什么获奖感言？不过好像也可以这么说，毕竟特雷斯的成果可算是大获成功！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590104
					],
					"speakerTitle": "埃洛雯"
				},
				{
					"id": 705590104,
					"content": "没错…从骑士团任务的角度考虑，特雷斯目前的测绘技巧，已经足以应对九成以上的情景了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590105
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 705590105,
					"content": "当然，要不是荣誉骑士前辈挑战「测绘寻物」的思路带给了我们启发，这次的训练可能还需要三倍的时间…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590106
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 705590106,
					"content": "#说明我们配合得好，有默契，对不对？{NICKNAME}觉得呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590107,
						705590108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705590107,
					"content": "本次体验相当新奇。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705590109
					]
				},
				{
					"id": 705590108,
					"content": "寻物挑战也给了我灵感。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705590109
					]
				},
				{
					"id": 705590109,
					"content": "真、真的吗？荣誉骑士前辈这么说了之后，不知道为什么，好像紧张都消散一些了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590110
					],
					"speakerTitle": "特雷斯"
				},
				{
					"id": 705590110,
					"content": "我总是担心如果我做不好，就会出现像米卡教官说那种情况——「结果往往影响的不仅仅是你自己」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590111
					],
					"speakerTitle": "特雷斯"
				},
				{
					"id": 705590111,
					"content": "可恶！但你已经获得了荣誉骑士的认可…如果我能等到这一句…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590112
					],
					"speakerTitle": "埃洛雯"
				},
				{
					"id": 705590112,
					"content": "埃洛雯也很棒！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705590113
					]
				},
				{
					"id": 705590113,
					"content": "欸…欸？！真的吗？我吗？我、我会好好记住的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590114
					],
					"speakerTitle": "埃洛雯"
				},
				{
					"id": 705590114,
					"content": "…让我好好想想，要用什么方式来庆祝这一天呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590115
					],
					"speakerTitle": "埃洛雯"
				},
				{
					"id": 705590115,
					"content": "说到庆祝。我倒是有个想法…有什么比一顿热气腾腾的美食更适合庆祝呢？听说埃洛雯的手艺…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590116
					],
					"speakerTitle": "特雷斯"
				},
				{
					"id": 705590116,
					"content": "嗯？想尝尝我的手艺吗…之前我只在行军路上做过饭，因为我总是倒霉抽到坏签…当然，如果你们不嫌难吃的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590117
					],
					"speakerTitle": "埃洛雯"
				},
				{
					"id": 705590117,
					"content": "怎么会？埃洛雯的手艺在骑士团里也算是远近闻名了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590118
					],
					"speakerTitle": "特雷斯"
				},
				{
					"id": 705590118,
					"content": "确实…目前还没有听到过一句差评呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590119
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 705590119,
					"content": "呜哇！那我更好奇了！埃洛雯，让我们尝尝你的手艺嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705590120,
					"content": "既然大家都这么说了，那就没问题！我想，我只需要一些准备…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590121
					],
					"speakerTitle": "埃洛雯"
				},
				{
					"id": 705590121,
					"content": "众人一起预处理食材、搭建临时灶台后，埃洛雯烹饪了许多看起来平平无奇，但香气却很诱人的美食…",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						705590122
					]
				},
				{
					"id": 705590123,
					"content": "呼…吃饱了！真是吃了以后…又满足又暖洋洋的料理！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705590124,
					"content": "我什么都尝了一口，现在马上快要飞不动了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705590125,
					"content": "这就是骑士的营地餐吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705590126
					]
				},
				{
					"id": 705590126,
					"content": "连我都很久没吃这么撑过了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705590127
					]
				},
				{
					"id": 705590127,
					"content": "毕竟是为了在雪山附近长期执勤而设计的料理，用料扎实，热量也不能少…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590128
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 705590128,
					"content": "荣誉骑士前辈和派蒙，休息一下后，可以适当做做运动哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590129
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 705590129,
					"content": "百闻不如一尝，这次，真是没有遗憾了！希望以后还能多和游击小队这样合作！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590130
					],
					"speakerTitle": "特雷斯"
				},
				{
					"id": 705590130,
					"content": "但吃饱了，就要到了要说再见的时间呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590131
					],
					"speakerTitle": "特雷斯"
				},
				{
					"id": 705590131,
					"content": "之前收到了同僚的信，队里建议我尽早返程，下轮定期训练又快来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590132
					],
					"speakerTitle": "特雷斯"
				},
				{
					"id": 705590132,
					"content": "现在想想，认真学点什么的时候，时间真得过得好快…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590133
					],
					"speakerTitle": "特雷斯"
				},
				{
					"id": 705590133,
					"content": "也正是验证学习成果的时候了，放轻松，你可以做得很好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590134
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 705590134,
					"content": "恭喜特雷斯，从米卡这里毕业啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705590135,
					"content": "课程大成功！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705590136
					]
				},
				{
					"id": 705590136,
					"content": "我一定会拿出全力，充分运用米卡教官传授给我的所有知识！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590137
					],
					"speakerTitle": "特雷斯"
				},
				{
					"id": 705590137,
					"content": "等你也变得赫赫有名的时候，我就可以和别人说——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590138
					],
					"speakerTitle": "埃洛雯"
				},
				{
					"id": 705590138,
					"content": "欸，你知道那个骑士团里的特雷斯吗？他是我测绘课的同学哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "埃洛雯"
				}
			]
		}
	]
}