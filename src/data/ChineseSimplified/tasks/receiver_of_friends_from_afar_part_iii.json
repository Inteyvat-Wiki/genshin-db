						"sceneId": 3,
						"position": [
							924.166,
							258.971,
							362.661
						],
						"pointId": 310400536
					}
				]
			},
			"dialogs": [
				{
					"id": 401480201,
					"content": "菜…菜来咯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401480202,
					"content": "嚯嚯，这就是「知足常乐」？果然量大管饱，很不错！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480203
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 401480203,
					"content": "来来来，挚友你也坐。在座的都是朋友，谁都不要跟谁客气！我先来一块…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480204
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 401480204,
					"content": "咳！老大，所谓「入乡随俗」，根据璃月的餐桌礼仪，这里应该让客人先尝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480205
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 401480205,
					"content": "嗯？阿忍你不是最讨厌这些条条框框吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480206,
						401480207
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 401480206,
					"content": "我现在也算客人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480208
					]
				},
				{
					"id": 401480208,
					"content": "哦？连挚友也…哦哦，一定是太香了对不对？行，既然你们都这么说的话，本大爷就最后一个吃吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480209
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 401480209,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480210
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 401480210,
					"content": "你与派蒙、绫人、阿忍依次吃了一圈，盘中的「肉块」也少了许多…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401480211
					]
				},
				{
					"id": 401480211,
					"content": "…呵，原来如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480212
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 401480212,
					"content": "——可算轮到本大爷啦，现在就来一块最大的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480213
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 401480213,
					"content": "等、等一下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401480214,
					"content": "嗯？又有什么事啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480215,
						401480216
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 401480215,
					"content": "派蒙，这里就交给你了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480217
					]
				},
				{
					"id": 401480217,
					"content": "我…我尽力吧…呃，刚刚我忘了给你们介绍这道菜的来历！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401480218,
					"content": "菜的来历？这有什么好听的，吃不就完了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480219
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 401480219,
					"content": "呃呃…不听介绍就吃菜，就像不带导游去旅游！听完介绍再吃菜，口味一定更精彩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401480220,
					"content": "确实，就像不同的茶有不同的品法，不听介绍就品尝，岂不是浪费了厨师的一片心意？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480221
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 401480221,
					"content": "挚友的心意？那确实不能辜负…那就来吧，你说，我在听！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480222
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 401480222,
					"content": "对！我们先说它的原料…啊不，先讲讲望舒客栈…讲讲荻花洲的历史…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401480223,
					"content": "#（{NICKNAME}，趁现在！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480224
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 401480224,
					"content": "（收到！）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480225
					]
				},
				{
					"id": 401480225,
					"content": "趁着派蒙吸引住一斗注意，你与阿忍开始风卷残云…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401480226
					]
				},
				{
					"id": 401480226,
					"content": "…荻花洲…居然还发生过这么感人的故事…能有现在的生活，是该「知足常乐」啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480227
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 401480227,
					"content": "（糟糕，不能提到「豆腐」，不知不觉就跑偏了…还好只剩一点了！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480228
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401480228,
					"content": "（可是我们已经吃不下了…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480229
					]
				},
				{
					"id": 401480229,
					"content": "啊！阿忍，挚友！你们什么时候开始吃的？居然就剩最后几块了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480230
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 401480230,
					"content": "——现在我可说什么都不会再让了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480231
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 401480231,
					"content": "等等！老大，那其实是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480232
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 401480232,
					"content": "且慢，一斗兄，其实…我有一个不情之请，想请你割爱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480233
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 401480233,
					"content": "我这趟出门仓促，未能带上家眷。他们常闻你的大名，对荒泷派神往已久，可惜这次无缘同席…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480234
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 401480234,
					"content": "不过你若是能将剩下的…「知足常乐」打包送给他们，嗯，他们一定会很开心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480235
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 401480235,
					"content": "这个…不太好吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480236
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 401480236,
					"content": "老大，璃月还讲究「成人之美」…而且你等上菜的时候，不都吃了好几份烤鱼吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480237
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 401480237,
					"content": "——连我跟绫人先生的份也吃了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480238
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 401480238,
					"content": "什么？那个原来是你们的份吗…故事讲得太投入，完全没有注意到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480239
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 401480239,
					"content": "…咳咳，那就有劳绫人兄，代我向他们问好了！店家，麻烦打包一下——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 401480216,
					"content": "能不能再表演一次那个…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480217
					]
				},
				{
					"id": 401480207,
					"content": "我也想先吃一块。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480208
					]
				}
			]
		},
