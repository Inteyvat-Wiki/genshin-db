			"dialogs": [
				{
					"id": 401480101,
					"content": "#早，今天也有劳你咯，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480102
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401480102,
					"content": "有了前几次的经验，你们越发得心应手…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401480103
					]
				},
				{
					"id": 401480103,
					"content": "嗯…你越来越适应在店里掌勺了嘛，这下不管来再怎么麻烦的客人，都不成问题…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480104
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401480104,
					"content": "——打住！我总感觉每次你一说这话，就会出现麻烦的事情！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401480105,
					"content": "嘿，哪有这回事儿！我又不是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480106
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401480106,
					"content": "——啊哈哈哈哈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480107
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 401480107,
					"content": "哎呀，没想到能在璃月见到兄弟你啊！欸，那句俗话是怎么说的来着…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480108
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 401480108,
					"content": "「他乡遇故知」，老大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480109
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 401480109,
					"content": "对对对，就是这个！你说是吧——绫人兄！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480110
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 401480110,
					"content": "呵呵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480111
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 401480111,
					"content": "——放牛的？怎么又是你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401480112,
					"content": "嗯？飞行…「破空白铁小堇瓜」？还有挚友！怎么今天这么走运，能遇上这么多老朋友？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480113
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 401480113,
					"content": "你前阵子不是还说要回去好好攒钱吗…怎么又跑来了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401480114,
					"content": "哈哈，以本大爷的身手，想赚钱还不是手到擒来的事？这趟出来，当然是吃香的喝辣的了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480115
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 401480115,
					"content": "咳…顺便再看看玉将在璃月过得怎么样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480116
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 401480116,
					"content": "（阿忍在用眼神示意…现在先不要深究吧…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480117
					]
				},
				{
					"id": 401480117,
					"content": "那绫人你又是？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480118
					]
				},
				{
					"id": 401480118,
					"content": "…我听说前阵子有人在璃月举办「斗虫试合」，所以特意赶来看看。只可惜，似乎错过了时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480119
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 401480119,
					"content": "什么？居然错过了那场大会！哎，那真是太可惜了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480120
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 401480120,
					"content": "是啊，幸好这趟出行遇见了一斗兄弟，可以听你讲讲那时的盛况。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480121
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 401480121,
					"content": "哈哈，好说好说，我们边吃边聊。这店里的厨师呢？快喊厨师出来，我要给挚友们整顿硬菜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480122
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 401480122,
					"content": "我就是厨师。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480123
					]
				},
				{
					"id": 401480123,
					"content": "…啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480124
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 401480124,
					"content": "喂，放牛的是在学书里的情节啦，那种大手一挥，就有人跑出来的桥段…这里还是给他点面子吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401480125,
					"content": "…不过还有主厨。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480126
					]
				},
				{
					"id": 401480126,
					"content": "啊…哈哈，挚友真会开玩笑，那就快请那位主厨出来吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480127
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 401480127,
					"content": "你与派蒙回到后厨，向言笑说明原委，请他出面圆场…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401480128
					]
				},
				{
					"id": 401480128,
					"content": "呃…那客官是要点什么？要宴请贵客的话，我们这儿有「金玉满堂」、「繁弦急管」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480129
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401480129,
					"content": "…老大，注意预算。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480130
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 401480130,
					"content": "嗯…嗯…那个…有没有更…实在一点儿的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480131
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 401480131,
					"content": "实在？呃…倒是有一道「知足常乐」，卤香四溢，回味无穷，是大快朵颐，物美价廉的首选…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480132
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401480132,
					"content": "「知足常乐」？好名字！一听就知道是道硬菜，就选它了！在座的都是朋友，就不整那些花里胡哨的了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480133
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 401480133,
					"content": "一斗兄好眼光，我也向来不喜欢过于精致的菜。嗯…这就是知己吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480134
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 401480134,
					"content": "知己？哈哈，对，就是知己！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480135
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 401480135,
					"content": "真的假的…算了，你们俩开心就好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
