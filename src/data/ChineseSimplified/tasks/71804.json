			},
			"dialogs": [
				{
					"id": 718040301,
					"content": "你找到关于新版经营许可证的公告了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040302
					],
					"speakerTitle": "伊凡诺维奇"
				},
				{
					"id": 718040302,
					"content": "已经抄下来了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040303
					]
				},
				{
					"id": 718040303,
					"content": "太好了，我来仔细看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040304
					],
					"speakerTitle": "伊凡诺维奇"
				},
				{
					"id": 718040304,
					"content": "出海申请批复件，经营场所证明及经营安全许诺书和…还有旧的经营许可证…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040305
					],
					"speakerTitle": "伊凡诺维奇"
				},
				{
					"id": 718040305,
					"content": "还好，还好，这几份文件我前几天刚刚跑去签好了，可把我跑得够呛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040306
					],
					"speakerTitle": "伊凡诺维奇"
				},
				{
					"id": 718040306,
					"content": "旅行者，麻烦你再帮我跑一趟，把这些文件分别交上去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040307
					],
					"speakerTitle": "伊凡诺维奇"
				},
				{
					"id": 718040307,
					"content": "咳咳…可能要交的人有点多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040308
					],
					"speakerTitle": "伊凡诺维奇"
				},
				{
					"id": 718040308,
					"content": "呃，首先，<color=#00E1FFFF>出海申请批复件</color>交给小安，<color=#00E1FFFF>经营场所证明及经营安全许诺书</color>交给千岩军嘉义…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040309
					],
					"speakerTitle": "伊凡诺维奇"
				},
				{
					"id": 718040309,
					"content": "还有<color=#00E1FFFF>旧的经营许可</color>，去交给小昭就可以了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040310
					],
					"speakerTitle": "伊凡诺维奇"
				},
				{
					"id": 718040310,
					"content": "旅行者，就拜托你再帮我跑跑了，我一定会准备好足够的报酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040311
					],
					"speakerTitle": "伊凡诺维奇"
				},
				{
					"id": 718040311,
					"content": "好吧，好吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040312
					]
				},
				{
					"id": 718040312,
					"content": "希望跑完这些手续之后，我就不用再跑了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040313
					],
					"speakerTitle": "伊凡诺维奇"
				},
				{
					"id": 718040313,
					"content": "希望以后不用跑了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040314
					]
				},
				{
					"id": 718040314,
					"content": "你之后应该不用跑这种手续了，但是我嘛…在这里做生意，之后免不了还得跑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040315
					],
					"speakerTitle": "伊凡诺维奇"
				},
				{
					"id": 718040315,
					"content": "唉，虽然这种办事方式确实让人安心，但如果能再简化一些就更好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊凡诺维奇"
				}
			]
		},
