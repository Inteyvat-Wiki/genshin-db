						718040403
					]
				},
				{
					"id": 718040403,
					"content": "伊凡诺维奇…哦，之前他来过几趟，我有印象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040404
					],
					"speakerTitle": "小安"
				},
				{
					"id": 718040404,
					"content": "他是在跑新版经营许可证的手续吗？哈哈…那他估计跑得够呛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040405
					],
					"speakerTitle": "小安"
				},
				{
					"id": 718040405,
					"content": "你是来帮他代办的吧，<color=#00E1FFFF>出海申请批复件</color>带来了吗？我上次和他说了，他的手续不全，得去其他地方补一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小安"
