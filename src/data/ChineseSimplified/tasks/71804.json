			"dialogs": [
				{
					"id": 718040201,
					"content": "此乃绯云坡公告板，街区新闻、店铺广告，无论大小，皆以公示。闲人如无要事，请勿擅自张贴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040202,
						718040205,
						718040208
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 718040202,
					"content": "关于总务司人事调动的说明…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040203
					]
				},
				{
					"id": 718040203,
					"content": "「总务司人事调动公示如下…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040204
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 718040204,
					"content": "等一下，总务司的人事调动应该跟经营许可证没有关系吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040201
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 718040205,
					"content": "关于绯云坡水源污染问题的情况通报…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040206
					]
				},
				{
					"id": 718040206,
					"content": "「关于绯云坡近来水源污染一事…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040207
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 718040207,
					"content": "伊凡诺维奇先生急着办事呢，我们没有时间关心水源污染问题啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040201
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 718040208,
					"content": "关于新版经营许可证的申请…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040209
					]
				},
				{
					"id": 718040209,
					"content": "「如需申请新版经营许可证，需有如下手续…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040210
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 718040210,
					"content": "这应该就是伊凡诺维奇先生想要申请的新版经营许可证了，我们赶快抄下来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
