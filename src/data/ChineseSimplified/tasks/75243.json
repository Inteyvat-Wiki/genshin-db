			"dialogs": [
				{
					"id": 752430101,
					"content": "哎呀！客人，多亏您赶走了那些不讲理的愚人众啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752430102
					],
					"speakerTitle": "阿罗哈"
				},
				{
					"id": 752430102,
					"content": "那帮家伙不知道从哪来的，一句话不说，手就直接往我口袋里伸！简直是强盗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752430103
					],
					"speakerTitle": "阿罗哈"
				},
				{
					"id": 752430103,
					"content": "还好有您阻止了他们！不然今天一定会损失惨重了…请一定要收下我的感谢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752430104
					],
					"speakerTitle": "阿罗哈"
				},
				{
					"id": 752430104,
					"content": "对了，差点忘了跟您介绍，这里是阳光五彩绵驮园，专门给客人们展出温顺的绵驮兽，当然，还有很多相关玩具售卖。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752430105
					],
					"speakerTitle": "阿罗哈"
				},
				{
					"id": 752430105,
					"content": "不过刚才那些人把我的员工和客人们都吓跑了，我要赶紧去处理一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752430106
					],
					"speakerTitle": "阿罗哈"
				},
				{
					"id": 752430106,
					"content": "要是您也想来参观绵驮园，请明天再来看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿罗哈"
				}
			]
		},
