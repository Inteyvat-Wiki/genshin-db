					{
						"sceneId": 3,
						"position": [
							-2156.834,
							174.01,
							5993.106
						],
						"pointId": 3965
					}
				]
			},
			"dialogs": [
				{
					"id": 735120101,
					"content": "哦哦，感谢你！勇敢的冒险家啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120102
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735120102,
					"content": "还好还好，没过多长时间，零件还没怎么被糟蹋…只要再修整一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120103
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735120103,
					"content": "维纳亚克开始埋头鼓捣机械…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						735120104
					]
				},
				{
					"id": 735120104,
					"content": "…维纳亚克？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120105
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735120105,
					"content": "嗯嗯，快了快了！马上就好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120106
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735120106,
					"content": "——维、纳、亚、克！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120107
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735120107,
					"content": "呜哇！施芮娅？你是什么时候来的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120108
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735120108,
					"content": "就在你摆弄零件的时候…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735120109
					]
				},
				{
					"id": 735120109,
					"content": "你不是说，这里有魔物，很危险吗？怎么连你自己也过来了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120110
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735120110,
					"content": "…我只是在担心我们的零件而已，免得到时候交不上差，连我都回不了教令院！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120111
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735120111,
					"content": "哈，我就说嘛——你看，全都收集完了，等回去做完进一步的调试，就能开始组装了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120112
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735120112,
					"content": "话说，这些都是什么的零件呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735120113,
					"content": "啊，忘了向你们介绍了——这是「对沙虫用杀虫炮」，我们当年的毕业设计项目！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120114
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735120114,
					"content": "——为什么会有这么偏门的选题啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735120115,
					"content": "你要是也为了毕业开过题，就知道为什么了…咳，总之这些不重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120116
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735120116,
					"content": "正式自我介绍一下，我是从阿弥利多学院毕业的学者施芮娅，主修沙漠生物学与环境学。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120117
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735120117,
					"content": "…这边这个机械笨蛋是刹诃伐罗学院的，主修的是应用机关术。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120118
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735120118,
					"content": "——我叫维纳亚克，之前真是多谢啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120119
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735120119,
					"content": "学的方向完全不同欸…这也能合作起来吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735120120,
					"content": "别提了…当初为了成功开题跟这家伙合作做毕设，绝对是我在学生时代犯的最大错误…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120121
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735120121,
					"content": "也不能这么说吧，你看我们俩不还是照样毕业了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120122
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735120122,
					"content": "是啊！你算算看比同届入学的人晚了多少年？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120123
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735120123,
					"content": "那好歹也算毕业了吧？我听说有些人去年才过的开题呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120124
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735120124,
					"content": "啊啊…够了！这种无意义的争论留在学生时代就够了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120125
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735120125,
					"content": "可每次不都是你先开始的吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120126
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735120126,
					"content": "哪有？就说我们第一次造原型机的时候…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120127,
						735120128
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735120127,
					"content": "停停停！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735120129
					]
				},
				{
					"id": 735120129,
					"content": "唔…关系好差，教令院怎么会想到派你们俩来处理这件事啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735120130,
					"content": "唉，倒也不能说是教令院让我们来的…其实这事本来是由我们院的库纳尔全权负责。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120160
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735120160,
					"content": "他算是我导师的导师吧，当初我们毕业答辩的时候也有来旁听。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120161
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735120161,
					"content": "大概就是那时候，给他留下了「院里的年轻人做过什么沙虫炮」的印象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120162
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735120162,
					"content": "所以这次，他说着什么「要多让年轻人发光发热！」然后硬是把我们抓到一起，派来解决这件事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120163
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735120163,
					"content": "明明我们毕业之后就没怎么来往了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120131
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735120131,
					"content": "就连我的导师也被他说动了…咳，不过借这机会，我才能让这门「对沙虫用杀虫炮」重见天日！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120132
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735120132,
					"content": "——等到组装完成，就能让那些虫子见识一下它的厉害了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120133
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735120133,
					"content": "这个机械笨蛋又开始了…不过从我的角度来说，也想研究一下这些沙虫作乱的原因，维护沙漠的生态平衡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120134
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735120134,
					"content": "#冒险家{M#先生}{F#小姐}，您的身手看起来很不错。请问在我们留居沙漠的这段时间里，能聘请您来保护我们的安全吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120135,
						735120136
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735120135,
					"content": "摩拉到位一切好说。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735120137
					]
				},
				{
					"id": 735120137,
					"content": "请放心，这趟出来教令院别的援助不多，经费倒是给得挺充足…虽然某人已经花掉了大半来升级机械配置。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120138
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735120138,
					"content": "都、都是必要的提升！…话说你这不是能好好说话吗，怎么一拐到我身上就带刺了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120139
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735120139,
					"content": "——那要看说话的对象有没有让人好好说话的价值！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120140
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735120140,
					"content": "欸，这两个人又要开始了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120141,
						735120142
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735120141,
					"content": "要吵架你们后边随意…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735120143
					]
				},
				{
					"id": 735120143,
					"content": "唉…抱歉，学生时代留下的老毛病了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120144
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735120144,
					"content": "这批零件还得拉回阿如村去做进一步的调整，算起来，怎么也得到明天才能开始组装了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120145
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735120145,
					"content": "我们之前计划在附近有沙虫出没过的地方，安设「对沙虫用杀虫炮」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120146
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735120146,
					"content": "到时候，可能还会有其它魔物被我们弄出的动静吸引过来——那就得拜托你出手了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120147,
						735120148
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735120147,
					"content": "没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735120149
					]
				},
				{
					"id": 735120149,
					"content": "那现在，施芮娅，我们可以继续辩论了，我花掉的经费绝对有理有据。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120150
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735120150,
					"content": "你…！好啊！算账是吧？奉陪到底！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735120148,
					"content": "明天见。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735120149
					]
				},
				{
					"id": 735120142,
					"content": "能不能先说下工作安排。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735120143
					]
				},
				{
					"id": 735120136,
					"content": "区区小事不足挂齿。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735120137
					]
				},
				{
					"id": 735120128,
					"content": "没完了要。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735120129
					]
				}
			]
		}
	]
}