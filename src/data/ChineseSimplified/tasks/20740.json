			"dialogs": [
				{
					"id": 207400401,
					"content": "关于那些花…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207400402
					]
				},
				{
					"id": 207400402,
					"content": "你采到那些花了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400403
					],
					"speakerTitle": "芙萝拉"
				},
				{
					"id": 207400403,
					"content": "都采到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207400404
					]
				},
				{
					"id": 207400404,
					"content": "都是很新鲜的花…谢谢你，这些花摆在店外，一定能吸引到很多客人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400405
					],
					"speakerTitle": "芙萝拉"
				},
				{
					"id": 207400405,
					"content": "然后，我还有一个小小的请求…风刮起来的时候，店里的蒲公英也都被吹走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400406
					],
					"speakerTitle": "芙萝拉"
				},
				{
					"id": 207400406,
					"content": "虽然蒲公英籽被风带走不是件坏事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400407
					],
					"speakerTitle": "芙萝拉"
				},
				{
					"id": 207400407,
					"content": "但是蒙德城的花店里没有蒲公英，感觉还是有点说不过去呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400408
					],
					"speakerTitle": "芙萝拉"
				},
				{
					"id": 207400408,
					"content": "蒲公英就不能直接摘掉带回来了，要从头种起才行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400409
					],
					"speakerTitle": "芙萝拉"
				},
				{
					"id": 207400409,
					"content": "所以，能拜托你帮我去找一份蒲公英籽回来吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400410,
						207400412
					],
					"speakerTitle": "芙萝拉"
				},
				{
					"id": 207400410,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207400411
					]
				},
				{
					"id": 207400411,
					"content": "那就拜托你啦，在蒙德城外，我记得就有很多蒲公英。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芙萝拉"
				},
				{
					"id": 207400412,
					"content": "到哪里采？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207400413
					]
				},
				{
					"id": 207400413,
					"content": "蒙德城外就有很多蒲公英，很容易就能采到啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芙萝拉"
				}
			]
		},
