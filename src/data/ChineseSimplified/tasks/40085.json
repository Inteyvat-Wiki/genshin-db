				"points": []
			},
			"dialogs": [
				{
					"id": 400850901,
					"content": "「咚咚小圆帽」！你不要紧吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850902
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850902,
					"content": "以一敌三太勉强了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850903
					]
				},
				{
					"id": 400850903,
					"content": "不对劲，明明对那只浮游水蕈兽发动了三次后门指令，为什么它还在听从旅行者的指挥？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850904
					],
					"speakerTitle": "埃尔欣根"
				},
				{
					"id": 400850904,
					"content": "考特里亚的设备失灵了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850905
					],
					"speakerTitle": "埃尔欣根"
				},
				{
					"id": 400850905,
					"content": "啊呀，看来你还没有意识到呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850906
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400850906,
					"content": "「意智宝珠」所用的技术确实可以让蕈兽听令于驯兽师，可不过是压制本能，增强蕈兽作为「生物」与驯兽师的沟通效果罢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850907
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400850907,
					"content": "这四只蕈兽对驯兽师的认可，他们之间的情感和默契，已经凌驾于「意智宝珠」的影响之上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850908
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400850908,
					"content": "八重神子…你能破除封锁秘境的术法？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850909
					],
					"speakerTitle": "埃尔欣根"
				},
				{
					"id": 400850909,
					"content": "只凭那些拙劣的模仿品，就想把我拦在外边？我似乎被小看了呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850910
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400850910,
					"content": "还有东拼西凑出来的「后门指令」，你们还真以为自己完全没露出过破绽？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850911
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400850911,
					"content": "真麻烦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850912
					],
					"speakerTitle": "埃尔欣根"
				},
				{
					"id": 400850912,
					"content": "神子，莱依拉！海妮耶也来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850913
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850913,
					"content": "埃尔欣根…原来你才是主谋？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850914
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400850914,
					"content": "相比蕈兽的威胁，你的野心更不可饶恕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850915
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400850915,
					"content": "八重小姐…我们赶快去帮忙吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850916
					],
					"speakerTitle": "莱依拉"
				},
				{
					"id": 400850916,
					"content": "别心急嘛，小莱依拉。这种时候就要好好看着哦，伙伴之间的默契，绝不会被世俗的阴谋和技术破坏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850917
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400850917,
					"content": "「百雷遮罗」，你的任务还没完成，怎么能屈服呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850918
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400850918,
					"content": "咦？快看，「百雷遮罗」好像恢复神智了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850919
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850919,
					"content": "莫非，八重小姐所说的时机已经来了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850920
					],
					"speakerTitle": "莱依拉"
				},
				{
					"id": 400850920,
					"content": "「转转悠悠兽」，我相信你！打败那个骗子吧…呃咳咳咳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850921
					],
					"speakerTitle": "莱依拉"
				},
				{
					"id": 400850921,
					"content": "后门指令对蕈兽伙伴们的影响…正在消退！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850922
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850922,
					"content": "还在犹豫吗，海妮耶？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850923
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400850923,
					"content": "你害怕看到…你一直想要当成「棋子」的蕈兽，始终坚信着你，让你不得不正视自己逃避的情感？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850924
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400850924,
					"content": "但你的蕈兽似乎等不及了。脱离了「意智宝珠」的控制后，它也在等待你的命令呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850925
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400850925,
					"content": "「火一」…你真的在等我吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850926
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400850926,
					"content": "对不起，我一直对你这么苛刻，你还相信着我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850927
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400850927,
					"content": "去做你该做的事吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850928
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400850928,
					"content": "虽然不知道是什么原理，但蕈兽们全都清醒过来了！太好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850929
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850929,
					"content": "埃尔欣根！你这个卑鄙的家伙，准备好迎接我们的怒火了吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850930
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850930,
					"content": "有序迎战，不要慌。对方只是蕈兽罢了，优势依然在我们这边。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "埃尔欣根"
				}
			]
		},
		{
			"id": 4008510,
			"completionStepIds": [
				4008510
