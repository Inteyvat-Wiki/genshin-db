					"nextDialogs": [
						400851506
					]
				},
				{
					"id": 400851506,
					"content": "说得对！我们和「咚咚小圆帽」，还有其他伙伴的默契绝对不会输！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
