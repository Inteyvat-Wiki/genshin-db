					"nextDialogs": [
						400851254
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400851254,
					"content": "嘿嘿，早点露出这种表情就好了嘛！这才是我们希望交朋友的，超级厉害的海妮耶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
