					"八重神子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400851001,
					"content": "居然败给了一群蕈兽…实在太荒唐了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851002
					],
					"speakerTitle": "埃尔欣根"
				},
				{
					"id": 400851002,
					"content": "哪里逃！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400851003
					]
				},
				{
					"id": 400851003,
					"content": "神子，你怎么不拦住他啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851004
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400851004,
					"content": "嗯？作为游客，我似乎没有在须弥境内逮捕谁的权力。你们不也一样吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851005
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400851005,
					"content": "不过，你们放心好了，他逃不掉的。回到赛场后，你们就明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851006
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400851006,
					"content": "来不及多想了，我们赶快追上去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4008512,
			"completionStepIds": [
				4008512
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4008512",
							"2"
						],
						"stepId": 4008512,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"西达",
					"埃尔欣根",
					"八重神子",
					"莱依拉",
					"海妮耶",
					"风速枣椰",
					"左右加"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400851201,
					"content": "你们是…「三十人团」的佣兵？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400851202,
					"content": "你们总算出手了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400851203
					]
				},
				{
					"id": 400851203,
					"content": "受大风纪官赛诺所托，我们前来逮捕重犯埃尔欣根，和学术罪犯考特里亚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851204
					],
					"speakerTitle": "西达"
				},
				{
					"id": 400851204,
					"content": "大风纪官盯上考特里亚很久了，只是他最近事务繁忙，暂时无法抽身应对这些宵小。多亏几位提供的证据，我们才能顺利收网。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851205
					],
					"speakerTitle": "西达"
				},
				{
					"id": 400851205,
					"content": "这里是大风纪官特意写给两位的信件，请过目。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851206
					],
					"speakerTitle": "西达"
				},
				{
					"id": 400851206,
					"content": "原来赛诺一直在关注这场比赛，我们调查的时候，他也在暗中收集线索，正好给我们准备了一份保险！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851207,
						400851208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400851207,
					"content": "及时的配合。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400851209
					]
				},
				{
					"id": 400851209,
					"content": "那么，我就将疑犯们带走了。有你们在这里，赛场秩序也无需我们操心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851210
					],
					"speakerTitle": "西达"
				},
				{
					"id": 400851210,
					"content": "别急着庆祝，这事还没完…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851211
					],
					"speakerTitle": "埃尔欣根"
				},
				{
					"id": 400851211,
					"content": "我还会来找你们的，为了多托雷大人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851212
					],
					"speakerTitle": "埃尔欣根"
				},
				{
					"id": 400851212,
					"content": "还嘴硬什么！好好在监狱里忏悔吧，愚人众的大骗子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400851213,
					"content": "不过，赛诺的信里还提到了证据。这么说来，十六强赛以后，神子原来是去报案了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400851214,
					"content": "干嘛这样看着我？我也很苦恼嘛，明明是出来度假的，却总被各种各样的人找上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851215
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400851215,
					"content": "我只不过是带着编辑们在须弥城里转悠了几圈，和偶然遇见的大风纪官闲聊几句罢了，一切的关键还是你们搜集的线索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851216
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400851216,
					"content": "噫…总觉得你越是轻描淡写，背后的过程就越复杂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400851217,
					"content": "话说回来，主办方和赞助商都被逮捕了，蕈兽们和这场比赛又该怎么办呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851218
					],
					"speakerTitle": "莱依拉"
				},
				{
					"id": 400851218,
					"content": "规则就是规则，小家伙们夺得了冠军，也通过了最终考验，等于取代了埃尔欣根和考特里亚的地位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851219
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400851219,
					"content": "从今以后，大赛的一切都由小家伙们说了算哦。相信经历了这么多以后，他们肯定能作出最合理的决定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851220,
						400851221
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400851220,
					"content": "首先要向海妮耶公开真相。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400851222
					]
				},
				{
					"id": 400851222,
					"content": "你们提到的真相，狐狸小姐已经告诉过我了。当年袭击我祖辈的蕈兽，正处于失控后的暴走状态。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851223
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400851223,
					"content": "我对蕈兽的印象建立在误解之上，最初就太过极端…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851224
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400851224,
					"content": "欸？我们还没开口呢！神子你怎么抢先一步啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400851225,
					"content": "哎呀，你们不应该感谢我吗？要让消沉的海妮耶振作起来，跟着我们去声援你，总得给她一点动力吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851226
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400851226,
					"content": "不劳你们多说了…之前的我，的确在向自己重复一些固执的观念，欺骗自己，直到完全麻木…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851227
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400851227,
					"content": "可刚才，我见识到了真相。即便没有「意智宝珠」，「火一」也还愿意听我的话。它一直相信着我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851228
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400851228,
					"content": "愿赌服输，我接受你们的指正和惩罚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851229
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400851229,
					"content": "惩罚这样的词也太夸张了啦，毕竟你除了说过一些吓人的话，还有对「火一」太严格，又没做错什么事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851230
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400851230,
					"content": "正好说到这里，我觉得我想好该怎么办了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851231
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400851231,
					"content": "我也有个好点子。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400851232
					]
				},
				{
					"id": 400851232,
					"content": "和大家一起商量了最终的决定，确定了措辞。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400851233
					]
				},
				{
					"id": 400851233,
					"content": "好了！我完全明白了！现在我们就去向大家公布这个结果吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851234,
						400851235
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400851234,
					"content": "冠军演讲就交给派蒙了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400851236
					]
				},
				{
					"id": 400851236,
					"content": "呃咳咳，我还是第一次站在这种舞台上向这么多人讲话呢，有点紧张。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851237
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400851237,
					"content": "#这次我和{NICKNAME}有幸拿到了冠军，还揭发了一场阴谋，我们非常开心！办好这场大赛的责任，也落到了我们的肩上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851238
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400851238,
					"content": "就算主办方和赞助商被抓走了，给各位选手的奖励还是会照常发放的，请大家放一万个心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851239
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400851239,
					"content": "好！等的就是这句话！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851240
					],
					"speakerTitle": "风速枣椰"
				},
				{
					"id": 400851240,
					"content": "英明的决定！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851241
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 400851241,
					"content": "不过，现在的「意智宝珠」有个缺点，它会影响周围的环境，给人们带来健康问题，所以蕈兽伙伴还不能长期待在大家身边。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851242
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400851242,
					"content": "为了大家的健康着想，我们希望，各位选手和蕈兽伙伴相处一段时间后，可以将它们交给最可靠的驯兽师海妮耶来照顾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851243
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400851243,
					"content": "但大家不会和伙伴们分开很久的！在海妮耶照顾蕈兽期间，我们会向教令院提出改进「意智宝珠」的请求，尽快解决这个问题！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851244
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400851244,
					"content": "而且，这次的比赛很有趣，只开一次就太可惜了嘛，大家也没有尽兴吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851245
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400851245,
					"content": "等到技术的问题被解决了，我们就能和蕈兽伙伴们团聚了！到时候再来较量一番吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851246
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400851246,
					"content": "这就是对我的惩罚吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851247
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400851247,
					"content": "说是给亚军的奖励，或许更合适哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851248
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400851248,
					"content": "放松一点，海妮耶小姐。其实与蘑菇伙伴相处是很开心的事。没错吧，「转转悠悠兽」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851249
					],
					"speakerTitle": "莱依拉"
				},
				{
					"id": 400851249,
					"content": "我还有点舍不得呢，以后「转转悠悠兽」就要交给你来照顾了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851250
					],
					"speakerTitle": "莱依拉"
				},
				{
					"id": 400851250,
					"content": "#{NICKNAME}和派蒙…还有莱依拉和狐狸小姐，你们真是奇妙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851251
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400851251,
					"content": "海妮耶，我们都在所有人面前宣布这个决定了，你可要打起精神来啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851252
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400851252,
					"content": "不必多说，我明白你们的意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851253
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400851253,
					"content": "作为一名驯兽师，我接受你们的安排。我会尽到自己的责任，好好照顾这些蕈兽，照顾大家珍贵的伙伴。",
