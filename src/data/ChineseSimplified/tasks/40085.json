	"talks": [
		{
			"id": 4008504,
			"completionStepIds": [
				4008504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4008504",
							"2"
						],
						"stepId": 4008504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"海妮耶"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400850401,
					"content": "为什么会这样…「火一」？为什么不尽全力战斗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850402,
						400850403
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400850402,
					"content": "下命令的是你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850404
					]
				},
				{
					"id": 400850404,
					"content": "不要责怪「火一」，也不要勉强自己嘛，海妮耶。半决赛的时候，你明明因为「火一」受伤而犹豫过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850405,
					"content": "除了我们和神子，你大概没有碰到能和你较量的对手吧？也没有让「火一」和其他伙伴陷入过苦战。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850406,
					"content": "真正看到「火一」和其他同伴受伤的时候，你还是不忍心的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850407,
					"content": "勉强自己？事到如今，你们还觉得我会因为蕈兽受伤而动情？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850408,
						400850409
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400850408,
					"content": "并非我们的揣测。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850410
					]
				},
				{
					"id": 400850410,
					"content": "海妮耶…你听着可怕的故事长大，对蕈兽有了不好的看法，我们完全能理解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850411,
					"content": "可是，只凭一个模糊的印象，就把眼前的伙伴也当成凶恶的敌人…时间一长，还是骗不过你自己的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850412,
					"content": "我们经常讨伐凶恶的蕈兽，以前我们也把蕈兽当成纯粹的魔物。就连我们参赛的目的，都是防止这些蕈兽惹出乱子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850413,
					"content": "但遇见了「咚咚小圆帽」后，我们发现，只要不断努力，以真情实感对待温和的蕈兽，它们也会作出回应，和我们友善地交流！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850414,
					"content": "至少这些温和的蕈兽是你的伙伴，而不是棋子或敌人！我们希望你信任「火一」，信任你的其他蕈兽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850415,
						400850416
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850415,
					"content": "然后放弃的激进想法。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850417
					]
				},
				{
					"id": 400850417,
					"content": "够了，比赛还没结束呢！现在就摆出一副获胜者的姿态，想要对我说教吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400850416,
					"content": "理智地对待蕈兽这个物种。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850417
					]
				},
				{
					"id": 400850409,
					"content": "而是你不想承认。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850410
					]
				},
				{
					"id": 400850403,
					"content": "你已经心软了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850404
					]
				}
			]
		},
		{
			"id": 4008505,
			"completionStepIds": [
				4008505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4008505",
							"2"
						],
						"stepId": 4008505,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"海妮耶",
					"埃尔欣根"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400850501,
					"content": "失败了…我还没能走出最重要的一步，居然就失败了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850502
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400850502,
					"content": "结果你们两个，还是成了最大的变数…但只凭那种幼稚的想法，为什么能赢过我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850503,
						400850504
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400850503,
					"content": "我们会向你展示原因。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850505
					]
				},
				{
					"id": 400850505,
					"content": "海妮耶，按照约定，我们赢了你之后，你会好好听我们讲道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850506,
					"content": "道理之后再说，先让「火一」跟着我们去接受最终考验，可以吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850507,
					"content": "「火一」？你们要带上它？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850508
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400850508,
					"content": "嗯！「咚咚小圆帽」、「转转悠悠兽」、「百雷遮罗」和你的「火一」，我们要用大家的蕈兽一起通过最终考验。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850509,
						400850510
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850509,
					"content": "然后取得大赛的最高权限。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850511
					]
				},
				{
					"id": 400850511,
					"content": "那天拿到了你的记事簿，和你谈话后，我们确定了很多事——关于蕈兽的安全性，你的看法也有可取之处。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850512
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850512,
					"content": "「意智宝珠」可能影响人的健康。大赛不该被过度宣传，蕈兽和人们也不能亲密无隙地生活在一起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850513
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850513,
					"content": "但是，不断改进「意智宝珠」，用它们和蕈兽好好沟通，找出善良的蕈兽，慢慢了解这个群体，应该是可行的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850514
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850514,
					"content": "…那就依你们好了。反正我输了，败者没有固执和嘴硬的资本…「火一」大概也更喜欢…一个总是为它着想的主人吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850515
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400850515,
					"content": "海妮耶，振作一点，不要轻视自己在伙伴心中的地位啊…等到我们赢得了最终考验，还有更重要的事要和你说呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850516,
						400850517
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850516,
					"content": "有关你的祖辈…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850518
					]
				},
				{
					"id": 400850518,
					"content": "对哦！你要是知道了当时发生了什么，肯定会改变想法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850519
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850519,
					"content": "精彩，精妙绝伦的一场对决！观点的交锋也令人感慨万千！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850520
					],
					"speakerTitle": "埃尔欣根"
				},
				{
					"id": 400850520,
					"content": "埃尔欣根？你怎么进到赛场来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850521
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850521,
					"content": "当然是为了亲自见证决赛中双方的角逐，和冠军在最终考验里的英姿了！对于大赛而言，这可是历史性的时刻，我怎么能缺席！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850522
					],
					"speakerTitle": "埃尔欣根"
				},
				{
					"id": 400850522,
					"content": "来吧，旅行者和派蒙，向我证明你们的意志。你们一定能成为升华这场大赛的关键人物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "埃尔欣根"
				},
				{
					"id": 400850517,
					"content": "那次袭击的真相…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850518
					]
				},
				{
					"id": 400850510,
					"content": "妥当地安排这些蕈兽伙伴。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850511
					]
				},
				{
					"id": 400850504,
					"content": "你肯定能理解的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850505
					]
				}
			]
		},
		{
			"id": 4008508,
			"completionStepIds": [
				4008508
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4008508",
							"2"
						],
						"stepId": 4008508,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"埃尔欣根",
					"埃尔欣根"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400850801,
					"content": "怎么回事…怎么到处都是愚人众？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850802
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850802,
					"content": "埃尔欣根！赛场被坏人入侵了！你快逃，我们来对付他们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850803
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850803,
					"content": "等等，说起来，出口在哪？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850804,
						400850805
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850804,
					"content": "不是赛场被坏人入侵…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850806
					]
				},
				{
					"id": 400850806,
					"content": "不愧是旅行者，看得很通透。对于这种绝境，你也准备了应对方案吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850807
					],
					"speakerTitle": "埃尔欣根"
				},
				{
					"id": 400850807,
					"content": "我不明白…现在不是在最终考验吗？幕后黑手不应该是考特里亚吗！他想利用这场比赛取得成就，所以骗你给他出钱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850808
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850808,
					"content": "只差一点就抵达真相了。考特里亚的动机确实如此，他发掘的失落技术，有着绝佳的潜力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850809
					],
					"speakerTitle": "埃尔欣根"
				},
				{
					"id": 400850809,
					"content": "所以我才买下了他，举办了这场比赛，扩大这项技术的影响力。当然，我没想到，你这样的高价值目标居然会主动咬钩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850810,
						400850811
					],
					"speakerTitle": "埃尔欣根"
				},
				{
					"id": 400850810,
					"content": "你也主动暴露了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850812
					]
				},
				{
					"id": 400850812,
					"content": "也就是说…你没有被考特里亚欺骗，而是在利用考特里亚？ 你原本就是个愚人众的坏家伙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850813
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850813,
					"content": "气死我了！亏我们还想着警告你别被骗！「咚咚小圆帽」，揍他！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850814
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850814,
					"content": "气势不错，可惜太自信了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850815
					],
					"speakerTitle": "埃尔欣根"
				},
				{
					"id": 400850815,
					"content": "「转转悠悠兽」？「百雷遮罗」…还有「火一」？你们都怎么了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850816
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850816,
					"content": "考特里亚在「意智宝珠」中加入了后门指令，一旦我启动这条指令，所有被宝珠控制的蕈兽都会听令于我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850817
					],
					"speakerTitle": "埃尔欣根"
				},
				{
					"id": 400850817,
					"content": "后门指令？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850818
					]
				},
				{
					"id": 400850818,
					"content": "难不成…你大张旗鼓地举办比赛，是想鼓励人们去捕捉更多蕈兽，然后接管它们，用它们来干坏事吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850819
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850819,
					"content": "一点即通，很不错。等到比赛多次举办后，民间就会保有一支庞大的蕈兽部队，能在须弥制造混乱，为我创造机会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850820
					],
					"speakerTitle": "埃尔欣根"
				},
				{
					"id": 400850820,
					"content": "等到我取得其他同事难以企及的成就，我所敬爱的主人，因为你们而离开的多托雷大人，也会重新意识到，我还有着价值…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850821,
						400850822
					],
					"speakerTitle": "埃尔欣根"
				},
				{
					"id": 400850821,
					"content": "多托雷…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850823
					]
				},
				{
					"id": 400850823,
					"content": "不过现在看来，我还能做得更出色。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850824
					],
					"speakerTitle": "埃尔欣根"
				},
				{
					"id": 400850824,
					"content": "只要除掉你们，我就能为长官们和众多同事一雪前耻，取得组织里数一数二的成就，多托雷大人会给予我最高的重视…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850825
					],
					"speakerTitle": "埃尔欣根"
				},
				{
					"id": 400850825,
					"content": "我会将你们的死宣传成一场意外——你们太过相信蕈兽，试图突破极限，结果引发赛场崩毁，不幸遇难。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850826
					],
					"speakerTitle": "埃尔欣根"
				},
				{
					"id": 400850826,
					"content": "封锁这个秘境后，谁都查不出你们的下落。我会让考特里亚接下全部责任和罪名，给教令院一个交待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850827
					],
					"speakerTitle": "埃尔欣根"
				},
				{
					"id": 400850827,
					"content": "随后，我会以缅怀你们的名义，投入更多资金，加大宣传比赛的力度，缩短赛事的周期…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850828
					],
					"speakerTitle": "埃尔欣根"
				},
				{
					"id": 400850828,
					"content": "你怎么睁着眼乱编谎话？还要出卖同伙？未免也太阴险了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850829
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850829,
					"content": "可恶啊…光是听着你胡说，我就好憋屈！绝不能让你得逞！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850830
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850830,
					"content": "不过，我们该怎么办？现在你没有武器，其他蕈兽伙伴又不听我们的话了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850831,
						400850832
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850831,
					"content": "先保护好自己！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850833
					]
				},
				{
					"id": 400850833,
					"content": "#不必急着出手。蕈兽对蕈兽，战士对战士。等到旅行者的伙伴被击溃，信念彻底崩塌后，你们再去给{M#他}{F#她}一个痛快的死法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850834
					],
					"speakerTitle": "埃尔欣根"
				},
				{
					"id": 400850834,
					"content": "之前我们的手段不算光彩，至少在送旅行者上路这件事上，我们需要保留尊重和仪式感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "埃尔欣根"
				},
				{
					"id": 400850832,
					"content": "我相信「咚咚小圆帽」！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850833
					]
				},
				{
					"id": 400850822,
					"content": "你是博士的旧部…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850823
					]
				},
				{
					"id": 400850811,
					"content": "到了牢里再自白吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850812
					]
				},
				{
					"id": 400850805,
					"content": "而是埃尔欣根的安排。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850806
					]
				}
			]
		},
		{
			"id": 4008509,
