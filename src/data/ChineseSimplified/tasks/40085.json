			"dialogs": [
				{
					"id": 400851501,
					"content": "#终于等到这一天了，{NICKNAME}，派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851502
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400851502,
					"content": "我早就告诫过你们，不要对蕈兽抱有多余的情感，要将它们当成棋子指挥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851503
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400851503,
					"content": "现在看来，你们并没有改观。所以，这场比赛会毫无悬念地结束。",
