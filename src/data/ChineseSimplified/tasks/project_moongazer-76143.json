						761430514
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 761430514,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430515
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761430515,
					"content": "我有点不明白了，黑蛋的使命到底是什么呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430516
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761430516,
					"content": "在黑蛋读取信息的同时，你们将一切告诉了派蒙。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761430517
					]
				},
				{
					"id": 761430517,
					"content": "向星空中发送信息？原来这就是望月者计划的内容…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430518
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761430518,
					"content": "所以风险是…这可能会让提瓦特暴露？怎么会这样…好为难！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430519
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761430519,
					"content": "黑蛋…你还好吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430520
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761430520,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430521
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761430521,
					"content": "哎呀，你先别伤心呀。我们还可以再商量一下对不对？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430522
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761430522,
					"content": "给你零食，我们五五开！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430523
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761430523,
					"content": "不，我没有伤心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430524
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761430524,
					"content": "你都流眼泪了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430525
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761430525,
					"content": "我不伤心，眼泪也没有流，这只是…这只是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430526
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761430526,
					"content": "是敬给前辈们的酒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430527
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761430527,
					"content": "#哥伦比娅，{NICKNAME}，派蒙。谢谢你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430528
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761430528,
					"content": "你们是我的朋友，我不想让朋友为难，所以我愿意…放弃这个使命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430529
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761430529,
					"content": "黑蛋…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430530
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761430530,
					"content": "没关系，派蒙。我不是第一个执行望月者计划的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430531
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761430531,
					"content": "我的前辈，早就向星空发出了属于我们的声音。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430532
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761430532,
					"content": "那些充满勇气的声音，一定已经传递到很远很远的星空深处了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430533
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761430533,
					"content": "只要有那些声音在，星空就不会是一片死寂，那样就足够了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430534
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761430534,
					"content": "#{NICKNAME}…你考虑好了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430535,
						761430546
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 761430535,
					"content": "也许可以最后执行一次望月者计划。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761430536
					]
				},
				{
					"id": 761430536,
					"content": "嗯，我也这么想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430537
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 761430537,
					"content": "真、真的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430538
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761430538,
					"content": "我们真的可以冒一次险吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430539
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761430539,
					"content": "迄今为止，望月者计划已经执行了不止一次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430540
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 761430540,
					"content": "用来隐藏提瓦特的虚假之天，也已经被打开了不止一次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430541
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 761430541,
					"content": "霜月曾在虚假之天外存在了数千年。现在月球上也并没有出现深渊污染的痕迹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430542
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 761430542,
					"content": "哦？你是说，也许并没有想象中那么危险？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430543
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761430543,
					"content": "可能性有很多，也许深渊不是每时每刻都盯着这里，也许是高天的主宰做了其它措施…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430544
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 761430544,
					"content": "而为了把风险降到最低，我也会用月神的力量，掩护宁宁发出的信息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430545
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 761430545,
					"content": "欸？那是什么意思？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430549
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761430549,
					"content": "月矩力和古月之力本质上都是光界力，我可以将我的力量融入宁宁发出的信息中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430550
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 761430550,
					"content": "等到那些信息穿越虚假之天后，我还可以通过那些力量，监测附近的情况。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430551
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 761430551,
					"content": "一旦有危险，我可以将信息抹除。这样一来，我们就不会被发现。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430552
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 761430552,
					"content": "哦？这好像是个好办法！但你的力量…可以一直维持吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430553
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761430553,
					"content": "唔，我的力量也有极限，只能坚持到一定距离。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430554
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 761430554,
					"content": "我会尽全力，把它送去我能抵达的极限。届时它的来源也不会被轻易定位了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430555
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 761430555,
					"content": "这样听起来比较可行。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761430556
					]
				},
				{
					"id": 761430556,
					"content": "可是…这会让你受伤吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430557
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761430557,
					"content": "放心。支持着我们的，是一整个月亮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430558
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 761430558,
					"content": "那黑蛋你做好准备了吗？一旦决定，可就无法回头了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430559
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761430559,
					"content": "…我能再问一个问题吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430560
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761430560,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430561
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 761430561,
					"content": "为什么你们愿意为我做这些？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430562
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761430562,
					"content": "我们可是朋友啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430563
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 761430563,
					"content": "就这个？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430564
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761430564,
					"content": "足够了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430565,
						761430566
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 761430565,
					"content": "望月者…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761430567
					]
				},
				{
					"id": 761430567,
					"content": "我、我也是！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430568
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761430568,
					"content": "我明白了，那么，我做好准备了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430569
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761430569,
					"content": "我的诞生，就是为了这一刻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430570
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761430570,
					"content": "嗯，向星空发出你的声音吧，提瓦特的月光会送你远航。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430571
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 761430571,
					"content": "呃…你好…你们好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430572
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761430572,
					"content": "很高兴…能够向神秘又浩瀚的星空送出这条讯息…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430573
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761430573,
					"content": "我不知道，它能否被接收…但我想，它至少能为冰冷的宇宙驱散一些死寂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430574
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761430574,
					"content": "如果真有一个你听见了，那说明一定存在着某种特别的引力，像月亮一样，捕捉了我们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430575
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761430575,
					"content": "所以，我希望你们的文明知道…在这片无垠的星空下，你们并不孤单。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430576
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761430576,
					"content": "我们的时代快要落幕了…但我们的勇气、信念、智慧会和这道渺小的讯息一起回荡在星海间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430577
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761430577,
					"content": "它微不足道，但它是我们的光…我希望它能鼓舞你们——在这片星空下，你们不是在独自地迎接未知与黑暗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430578
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761430578,
					"content": "请继续向星空发出属于你们的声音吧，让它也成为你们的光。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430579
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761430579,
					"content": "一束光很微弱，很容易会被黑暗吞没，但只要在它消失前有另一束光亮起…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430580
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761430580,
					"content": "那么总有一天，总有一束光，会成为刺破夜幕的曙光。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430581
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761430581,
					"content": "最后…我们是…宇宙中一个不起眼角落里的… 望月{RUBY#[S]星空}者…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430582
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761430582,
					"content": "我们的名字是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430583
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761430583,
					"content": "伊比尼伯龙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430584
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761430584,
					"content": "乌吉恩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430585
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761430585,
					"content": "玛歌洁蒂…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430586
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761430586,
					"content": "卢沙里姆…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430587
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761430587,
					"content": "宁希基娅…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430588
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761430588,
					"content": "向所有能听见的你…致意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430589
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761430589,
					"content": "朋友们…谢谢…我们在星空下…再见吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430590
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761430590,
					"content": "黑蛋完成了她的使命…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430591
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761430591,
					"content": "她的帽子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430592
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761430592,
					"content": "你还好吗？哥伦比娅。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761430593
					]
				},
				{
					"id": 761430593,
					"content": "我没问题。不过接下来，我需要集中注意力，直到我的力量达到极限。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430594
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 761430594,
					"content": "那我们快去找一个安静的地方吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430595
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761430595,
					"content": "再见了，黑蛋，我会永远记得你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430596
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761430596,
					"content": "（…一阵信号的杂音…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430597
					],
					"speakerTitle": "终端"
				},
				{
					"id": 761430597,
					"content": "（…似乎因为望月者模块的激活，无意间开启了一段尘封的数据…）",
