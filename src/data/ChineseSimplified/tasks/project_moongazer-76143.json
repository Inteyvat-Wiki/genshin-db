				]
			},
			"dialogs": [
				{
					"id": 761430101,
					"content": "旅程的终点到了，她就是开启望月者计划的钥匙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430102
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 761430102,
					"content": "她是谁？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761430103
					]
				},
				{
					"id": 761430103,
					"content": "是望月者计划的最后继承者，留在这里的印迹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430104
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 761430104,
					"content": "她会解释一切。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430105
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 761430105,
					"content": "嘿！你好啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430106
					],
					"speakerTitle": "宁希姬娅的印迹"
				},
				{
					"id": 761430106,
					"content": "你好？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761430107
					]
				},
				{
					"id": 761430107,
					"content": "我是宁希姬娅，你也可以叫我宁宁，是我的小名。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430108
					],
					"speakerTitle": "宁希姬娅的印迹"
				},
				{
					"id": 761430108,
					"content": "你叫什么名字？伊比尼伯龙？乌吉恩？玛歌？还是卢沙里姆？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430109
					],
					"speakerTitle": "宁希姬娅的印迹"
				},
				{
					"id": 761430109,
					"content": "#我是{NICKNAME}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761430110
					]
				},
				{
					"id": 761430110,
					"content": "嘿嘿，不用回答我，因为很遗憾，我已经不在了，这只是一段留言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430111
					],
					"speakerTitle": "宁希姬娅的印迹"
				},
				{
					"id": 761430111,
					"content": "但反过来想，其实一点也不遗憾，因为你来到了这里，这说明计划成功了，你继承了我们的使命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430112
					],
					"speakerTitle": "宁希姬娅的印迹"
				},
				{
					"id": 761430112,
					"content": "你一定还有很多疑惑，比如——「我到底是谁？」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430113
					],
					"speakerTitle": "宁希姬娅的印迹"
				},
				{
					"id": 761430113,
					"content": "让我告诉你，你是由月球意志创生的新生命，你是望月者计划的重要一环。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430114
					],
					"speakerTitle": "宁希姬娅的印迹"
				},
				{
					"id": 761430114,
					"content": "「那这个计划究竟是什么呢？」，你肯定又在这么想…别着急，听我说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430115
					],
					"speakerTitle": "宁希姬娅的印迹"
				},
				{
					"id": 761430115,
					"content": "首先，请感谢三月女神，她们容许了我们的僭越，借用了月球本源的创生之力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430116
					],
					"speakerTitle": "宁希姬娅的印迹"
				},
				{
					"id": 761430116,
					"content": "其次，感谢我的老师卢沙里姆。他继承了所有人的研究成果，还成功搜集了大家的古月力信息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430117
					],
					"speakerTitle": "宁希姬娅的印迹"
				},
				{
					"id": 761430117,
					"content": "这样一来，我才能把信息汇聚于这片月心之海，当本源的创生之力被激发时，「砰」的一下——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430118
					],
					"speakerTitle": "宁希姬娅的印迹"
				},
				{
					"id": 761430118,
					"content": "一只可爱的黑色月灵，也就是你，诞生了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430119
					],
					"speakerTitle": "宁希姬娅的印迹"
				},
				{
					"id": 761430119,
					"content": "你可能会继承信息海洋中某位前辈的名字，也可能不会，但大概你能想起你有一个使命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430120
					],
					"speakerTitle": "宁希姬娅的印迹"
				},
				{
					"id": 761430120,
					"content": "原来这就是黑蛋的诞生…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761430121
					]
				},
				{
					"id": 761430121,
					"content": "接下来，还要感谢玛歌前辈，她揭开了那位星空访客的本质——一种信息生命，她的研究是你诞生的基石。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430122
					],
					"speakerTitle": "宁希姬娅的印迹"
				},
				{
					"id": 761430122,
					"content": "还有乌吉恩前辈，他付出生命，传递了那位访客所代表的文明最后向星空传递的消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430123
					],
					"speakerTitle": "宁希姬娅的印迹"
				},
				{
					"id": 761430123,
					"content": "然后，是最初的望月者，伊比尼伯龙，他带着我们登上月亮，睁大了我们的眼睛，永不疲倦地望向璀璨星空。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430124
					],
					"speakerTitle": "宁希姬娅的印迹"
				},
				{
					"id": 761430124,
					"content": "最后，继承者，还要感谢你，因为你即将献出自己，去望月者高塔启动计划的最后一环。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430125
					],
					"speakerTitle": "宁希姬娅的印迹"
				},
				{
					"id": 761430125,
					"content": "你的使命，就是继续向宇宙发送我们曾经接收到的信息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430126
					],
					"speakerTitle": "宁希姬娅的印迹"
				},
				{
					"id": 761430126,
					"content": "「一束光很微弱，很容易被黑暗吞没，但只要在它消失前有另一束光亮起…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430127
					],
					"speakerTitle": "宁希姬娅的印迹"
				},
				{
					"id": 761430127,
					"content": "「那么总有一天，总有一束光，会成为刺破夜幕的曙光。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430128
					],
					"speakerTitle": "宁希姬娅的印迹"
				},
				{
					"id": 761430128,
					"content": "说到这里，你应该理解了吧？刚好，我的时间差不多也要到了…但没关系，我马上就来加入大家了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430129
					],
					"speakerTitle": "宁希姬娅的印迹"
				},
				{
					"id": 761430129,
					"content": "这样一想，搞不好，你继承的可能会是我的名字呢，哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430130
					],
					"speakerTitle": "宁希姬娅的印迹"
				},
				{
					"id": 761430130,
					"content": "该说再见了，去完成你的使命吧。最后…向你和所有的望月{RUBY#[S]星空}者致意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430131
					],
					"speakerTitle": "宁希姬娅的印迹"
				},
				{
					"id": 761430131,
					"content": "#就是这样。{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430132
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 761430132,
					"content": "所有探寻过星空的学者，他们的信息都被融入了这片海洋，借着月球的意志，在未来的某天以黑蛋的模样再次诞生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430133
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 761430133,
					"content": "它们会本能地互相吞噬，来获取更多信息，直到脑海中的使命变清晰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430134
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 761430134,
					"content": "然后再走一遍我们所走过的路，来到这里，得知一切。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430135
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 761430135,
					"content": "它们会用自己当作钥匙，打开伊比尼伯龙之眼的望月者模块。向宇宙重新发送消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430136
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 761430136,
					"content": "最后回归生命的循环…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761430137
					]
				},
				{
					"id": 761430137,
					"content": "嗯，这个循环可能已经不止发生过一次了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430138
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 761430138,
					"content": "但是，向未知的星空发出声音，未必是一件安全的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430139
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 761430139,
					"content": "龙族的学者一定也意识到了这点，所以开始研究月幕工程。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430140
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 761430140,
					"content": "而在宁宁的年代，世界因为两位至高者的争斗，已是将要毁灭的样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430141
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 761430141,
					"content": "可现在，提瓦特已经恢复了平静，至少现在如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430142
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 761430142,
					"content": "（如果这次发出的信号，最后却让星空中的黑暗注意到这里…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761430143
					]
				},
				{
					"id": 761430143,
					"content": "我会依照承诺，把钥匙和信息交给宁宁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430144
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 761430144,
					"content": "但你觉得我们应该阻止宁宁完成她的使命，还是支持她？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430145
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 761430145,
					"content": "我需要一点时间考虑。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761430146
					]
				},
				{
					"id": 761430146,
					"content": "嗯，我理解。那我们就返回那座最初的望月者高塔吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430147
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 761430147,
					"content": "派蒙和宁宁呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761430148
					]
				},
				{
					"id": 761430148,
					"content": "放心，玛歌会接上她们的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430149
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 761430149,
					"content": "去那里还有不短的路程。我们可以多考虑一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430150
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 761430150,
					"content": "走吧。该离开这了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "哥伦比娅"
				}
			]
		},
