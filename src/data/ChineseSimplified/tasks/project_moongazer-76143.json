					"nextDialogs": [
						761430206
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 761430206,
					"content": "而月心中的月亮本源力量，就成了射向提瓦特的炮火。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430207
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 761430207,
					"content": "不过，那位原初之主最终还是败于天理手中。现在这里已经不会再有威胁了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430208
					],
					"speakerTitle": "哥伦比娅"
