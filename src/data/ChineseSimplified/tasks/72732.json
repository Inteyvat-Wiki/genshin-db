				"points": []
			},
			"dialogs": [
				{
					"id": 727320101,
					"content": "荒泷派，我来和你们决斗了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320102
					],
					"speakerTitle": "「怪力三十三」"
				},
				{
					"id": 727320102,
					"content": "怎么回事？「花角玉将」那家伙又派了个小孩来出战？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320103
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 727320103,
					"content": "该不会是人手不够了，想要草草应付我们了事吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320104
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 727320104,
					"content": "…你不重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320105
					],
					"speakerTitle": "「怪力三十三」"
				},
				{
					"id": 727320105,
					"content": "吵吵闹闹的人，一般都是杂鱼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320106
					],
					"speakerTitle": "「怪力三十三」"
				},
				{
					"id": 727320106,
					"content": "#这位金发的{M#大哥哥}{F#大姐姐}很沉稳，有一股强者的气势。{M#他}{F#她}才是你们荒泷派的老大吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320107
					],
					"speakerTitle": "「怪力三十三」"
				},
				{
					"id": 727320107,
					"content": "#嘿嘿嘿，这位朋友的眼光很毒辣嘛！多夸{NICKNAME}几句！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727320108,
					"content": "啊？你在胡说八道什么！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320109
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 727320109,
					"content": "#我的挚友确实强得没边，但这次，{M#他}{F#她}只是我们荒泷派的外援！帮派的名字写得清清楚楚，老大当然永远是我荒泷一斗了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320110,
						727320111
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 727320110,
					"content": "那我就给名字加上限时前缀。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727320112
					]
				},
				{
					"id": 727320112,
					"content": "对哦，荒泷派的实力先放在一边，当老大究竟是什么感觉呢？我也有点好奇了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727320113,
					"content": "如果你答应我们，我也可以是「荒泷（三天后到期）派蒙」，或者「荒泷派派蒙（临时老大）」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727320114,
					"content": "喂喂喂！你们两个！不要被对手带偏了啊！她明显是…想让我们起内讧！她在耍阴谋！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320115
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 727320115,
					"content": "等到本大爷战胜了她的老大，她就要为这番大话后悔，慌慌张张收回它了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320116
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 727320116,
					"content": "拉倒吧…你们荒泷派内部的事，我可不关心，我只想和厉害的对手较量一番！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320117
					],
					"speakerTitle": "「怪力三十三」"
				},
				{
					"id": 727320117,
					"content": "#先让我领教一下这位{M#大哥哥}{F#大姐姐}的斗虫本领吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「怪力三十三」"
				},
				{
					"id": 727320111,
					"content": "老大的位置借我坐几天？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727320112
					]
				}
			]
		}
	]
}