	"talks": [
		{
			"id": 7351001,
			"completionStepIds": [
				7351001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7351001",
							"2"
						],
						"stepId": 7351001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"哈贾娜德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735100101,
					"content": "哈贾娜德，大功告成啦，来听我们的好消息吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735100102,
					"content": "稍等，让我感受一下，你们身上「震沸装置」的信号。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100103
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 735100103,
					"content": "啊，这炽热的余温和充满磁性的回响，就像是炼金药剂在火中的合奏，让我兴奋得战栗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100104
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 735100104,
					"content": "简直无懈可击！利用你们提供的数据，我一定能写出最完美的报告！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100105
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 735100105,
					"content": "真的吗？我怎么什么都没感觉到？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735100106,
					"content": "「白色高智能浮游助手单元」，你应该阅读一些…教令院学生深夜语录，拓展你的语言多样性机能！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100107
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 735100107,
					"content": "这样一来，你就能理解各种精妙的比喻了，幽默力和抗压力都能超级加倍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100108
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 735100108,
					"content": "#才不要！根本听不懂啦，我哪来的什么压力，{NICKNAME}又不会要求我搞奇怪的研究！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735100109,
					"content": "你不要支开话题哦，我们按照约定，帮你测试了装置。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735100110,
					"content": "现在，快乐的发薪时间到了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735100111,
					"content": "给你们给你们！难道你们还信不过我吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100112
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 735100112,
					"content": "咦？这就是五十人份的薪水吗？总感觉和想象的有点出入呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735100113,
					"content": "唔…倒也不是嫌弃太少…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100114,
						735100115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735100114,
					"content": "算不上「一大笔摩拉」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735100116
					]
				},
				{
					"id": 735100116,
					"content": "咦？难道我攒了大半年的这笔钱还不够夸张吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100117
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 735100117,
					"content": "是我低估了佣兵们的赚钱能力？我给佣兵们计划的日薪，和导师每天给我的资金一样多呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100118
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 735100118,
					"content": "我的新导师出手超阔绰，跟着她以后，我每天都能享受一份烤肉卷大餐，资金还有盈余！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100119
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 735100119,
					"content": "如果在商店买一袋面粉，去野外摘些墩墩桃，打几桶河水一起煮成面糊…一天的资金就够我生活两周。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100120
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 735100120,
					"content": "余下的钱都可以投入到「震沸合剂」的研究里，这次雇佣佣兵的预算就是这么来的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100121,
						735100122
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 735100121,
					"content": "你对食物的要求好低。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735100123
					]
				},
				{
					"id": 735100123,
					"content": "哈贾娜德，你到底是怎么撑到今天的…这种日子未免过得也太苦了，要对自己好一点！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735100124,
					"content": "一顿大餐，至少是吃烤肉卷到撑才行吧，一份怎么能算数！每天只吃这种面糊的话，也会把身体搞坏的啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735100125,
					"content": "我明白我明白，我已经过得很好了！有的学生还要倒贴摩拉来完成学业哦，就像我以前那样，更顾不上好好吃饭了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100126
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 735100126,
					"content": "我现在有了导师批准的预算，每天都能填饱肚子，已经超幸福了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100127
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 735100127,
					"content": "完全没明白吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735100128
					]
				},
				{
					"id": 735100128,
					"content": "想到了！我们就带哈贾娜德去吃顿豪华的饭菜，让她把自己的标准定高一点，至少不要每天都应付了事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735100129,
					"content": "不用不用！哪有让委托人请雇主吃饭的道理！感谢你们对我的关心啦，真的不用担心我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100130
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 735100130,
					"content": "只要能取得学术进展，证明我的能力，迟早能出人头地！老是吃大餐的生活，可不是我这个阶段该想的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100131
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 735100131,
					"content": "不能浪费时间了，我这就回去写报告！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100132
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 735100132,
					"content": "那你也可以拿一点水果和蔬菜回去补充营养，我们经常能找到日落果和卷心菜，包里还有不少！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735100133,
					"content": "嘿嘿…呵呵…啊哈哈哈哈哈…我已经能想象导师下巴脱臼的表情了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100134
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 735100134,
					"content": "哈贾娜德根本不听派蒙的话，傻笑着跌跌撞撞地离开了…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						735100135
					]
				},
				{
					"id": 735100135,
					"content": "呃，自顾自地走掉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100136
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735100136,
					"content": "总觉得哈贾娜德这样下去，说不定哪天就会营养不良，饿晕过去呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100137,
						735100138
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735100137,
					"content": "她的导师应该会注意到的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735100139
					]
				},
				{
					"id": 735100139,
					"content": "嗯…按照哈贾娜德的说法，她的导师应该很重视她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100140
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735100140,
					"content": "只能祝她能顺利完成研究，挣到更多摩拉了，然后过上正常的生活…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100141
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735100141,
					"content": "没准之后还会碰见她，到时候，我们从她那里拿到再多报酬，也不用担心她营养不良！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735100138,
					"content": "希望科研狂人别轻易倒下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735100139
					]
				},
				{
					"id": 735100122,
					"content": "你的生活标准好危险。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735100123
					]
				},
				{
					"id": 735100115,
					"content": "和期待的有点出入。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735100116
					]
				}
			]
		}
	]
}