			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"申鹤"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110150401,
					"content": "哇哦…大家都落座了呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110150402,
					"content": "我还是第一次在群玉阁上参加凝光小姐的宴会呢！感觉有好多好吃的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110150403,
					"content": "诸位都是我凝光的贵客。今日来此，可要尽兴而归。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150404
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150404,
					"content": "不能喝酒的客人，请以饮品代替。美酒宜人，宜人的却不只是美酒。相信群玉阁上的美景也能醉人心脾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150405
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150405,
					"content": "听说了吗？今天好像有云先生登台。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150406
					],
					"speakerTitle": "永业"
				},
				{
					"id": 110150406,
					"content": "呵，实不相瞒，我就是冲着这个来的！云先生的戏，我可是一场不落。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150407
					],
					"speakerTitle": "朱陶"
				},
				{
					"id": 110150407,
					"content": "这次据说唱的是《神女劈观》，云先生的父亲写的戏。我期待得两三个晚上没睡好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150408
					],
					"speakerTitle": "朱陶"
				},
				{
					"id": 110150408,
					"content": "哎，你们看，云先生上台了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150409
					],
					"speakerTitle": "诗羽"
				},
				{
					"id": 110150409,
					"content": "怎么样，我唱得还不错吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150410
					],
					"speakerTitle": "云堇"
				},
				{
					"id": 110150410,
					"content": "太好听了！有机会的话，派蒙也想学！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110150411,
					"content": "很好听。而且…谢谢你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150412
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 110150412,
					"content": "不客气，多亏有你，《神女劈观》才能变得更加完整。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150413
					],
					"speakerTitle": "云堇"
				},
				{
					"id": 110150413,
					"content": "戏会落幕，人生却不会。相信今后，你一定可以顺利融入璃月港。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150414
