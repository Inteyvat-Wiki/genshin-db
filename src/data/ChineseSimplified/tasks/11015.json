	"talks": [
		{
			"id": 1101501,
			"completionStepIds": [
				1101501
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101501",
							"2"
						],
						"stepId": 1101501,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"百闻"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110150101,
					"content": "凝光小姐的小秘书，我们把材料找齐啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110150102,
					"content": "哦？这么快？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150103
					],
					"speakerTitle": "百闻"
				},
				{
					"id": 110150103,
					"content": "而且三位是一起找齐的吗…原来如此，我懂了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150104
					],
					"speakerTitle": "百闻"
				},
				{
					"id": 110150104,
					"content": "千奇核心和仙家符箓都没什么问题。看来这场比赛，要分出胜负了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150105
					],
					"speakerTitle": "百闻"
				},
				{
					"id": 110150105,
					"content": "#我宣布，这次材料筹备竞赛的三位优胜者，分别是{NICKNAME}、云堇和北斗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150106
					],
					"speakerTitle": "百闻"
				},
				{
					"id": 110150106,
					"content": "不是，这就结束了？我浮生石还没找到呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150107
					],
					"speakerTitle": "宏飞"
				},
				{
					"id": 110150107,
					"content": "我不能接受…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150108
					],
					"speakerTitle": "昌贵"
				},
				{
					"id": 110150108,
					"content": "唉，紧赶慢赶，还是慢人一步…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150109
					],
					"speakerTitle": "志成"
				},
				{
					"id": 110150109,
					"content": "那就有请三位优胜者，先移步到群玉阁，凝光大人已经在上面等着了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150110
					],
					"speakerTitle": "百闻"
				},
				{
					"id": 110150110,
					"content": "咦？北斗哪去了，刚刚还看见她在这里的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110150111,
					"content": "北斗小姐有些事情，可能会晚一点到。几位先随我来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150112
					],
					"speakerTitle": "百闻"
				},
				{
					"id": 110150112,
					"content": "好吧，那我们先到群玉阁上看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110150113,
					"content": "上次登上群玉阁，好像还是很久之前呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 1101502,
			"completionStepIds": [
				1101506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101506",
							"2"
						],
						"stepId": 1101506,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凝光"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110150201,
					"content": "将仙家符箓与千奇核心相结合，放入群玉阁控制仓内。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150202
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150202,
					"content": "如此一来，群玉阁就算正式重建完毕。之后收起铁索，它便会升入高空。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150203
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150203,
					"content": "辛苦几位。现在该由我兑现承诺，给你们奖励了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150204
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150204,
					"content": "好耶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110150205,
					"content": "云先生的来意，我稍有耳闻。你正在为新的戏曲寻找合适的舞台，对吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150206
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150206,
					"content": "正是。不知道凝光小姐有什么建议吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150207
					],
					"speakerTitle": "云堇"
				},
				{
					"id": 110150207,
					"content": "既然是云先生隆重准备的新戏，想必极有分量，初演不如就选在这新建成的群玉阁上，如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150208
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150208,
					"content": "群玉阁地势极高，由此向外，能一览众山小。高处知风劲，又可观人间众相，我想，天下怕是没有比这里更适合先生的戏台了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150209
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150209,
					"content": "多谢凝光小姐。稍后我会备好戏曲道具，劳烦凝光小姐一并带上群玉阁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150210
					],
					"speakerTitle": "云堇"
				},
				{
					"id": 110150210,
					"content": "名戏佳曲，值得如此。不必客气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150211
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150211,
					"content": "#{NICKNAME}、申鹤，还有小派蒙，我先告辞了。记得来听我的戏哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150212
					],
					"speakerTitle": "云堇"
				},
				{
					"id": 110150212,
					"content": "#你呢？{NICKNAME}，你想问我什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150213
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150213,
					"content": "#事先说明，你{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTER]}的行踪我也不清楚，就不要浪费这个问题了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150214
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150214,
					"content": "唔…凝光小姐总是未卜先知的样子呢…既然这样，就轮到派蒙来问了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110150215,
					"content": "…经商可没有你们想的那么容易。资金、人脉、对风向的感知、对机遇的嗅觉…凡此种种，缺一不可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150216
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150216,
					"content": "你们若是想问怎么赚钱，我自会按照约定回答。但对现在的你们来说，未必有效。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150217
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150217,
					"content": "哇——明明我还什么都没有问呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110150218,
					"content": "心思都写在脸上了，一看便知。当然，你们帮我重建群玉阁，恩情重大，我绝不会亏待你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150219
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150219,
					"content": "我可以许诺，若有一天你们急需接济，可以来我这里寻个差使。至于薪水待遇，我当然会按最高规格来给。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150220
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150220,
					"content": "太好啦！下次摩拉用完的时候，我们来找凝光小姐就行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110150221,
					"content": "那我们俩都没有问题了，申鹤有什么想问的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110150222,
					"content": "我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150223
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 110150223,
					"content": "是呀！因为材料是大家一起找齐的呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110150224,
					"content": "多谢…但我实在没有什么问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150225
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 110150225,
					"content": "是吗？那这个千载难逢的提问机会，怕是要浪费了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150226
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150226,
					"content": "怎么可以这样，不可以浪费！唔，让我们再想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150227
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110150227,
					"content": "…凝光小姐，你觉得我能融入璃月港吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150228
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 110150228,
					"content": "这倒是一个有趣的问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150229
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150229,
					"content": "璃月港是一座包容的城市，只要你遵守这里的规章制度，它就不会拒绝你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150230
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150230,
					"content": "所以，重要的是，你能否对璃月港产生「归属感」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150231
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150231,
					"content": "归属感？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150232
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 110150232,
					"content": "是啊。喜欢一个地方，融入一个地方…总是要有理由的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150233
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150233,
					"content": "或许是在这里遇见过什么人、经历过什么事，也或许只是享受璃月的氛围，习惯了这样去生活。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150234
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150234,
					"content": "总之，每个人都需要一个留下来的理由，希望你也能早日找到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150235
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150235,
					"content": "…我明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150236
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 110150236,
					"content": "哟，几位正聊着呢？刚刚去了趟船队，来晚了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150237
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 110150237,
					"content": "快来快来，正好轮到北斗啦！北斗有什么想问的问题吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150238
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110150238,
					"content": "我？我没什么想问的。本来就是被她强拉来帮忙，顺便参赛而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150239
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 110150239,
					"content": "凝光，上次跟你说的事，你可别忘了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150240
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 110150240,
					"content": "那东西不好对付，光靠我的船队，很难摆平。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150241
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 110150241,
					"content": "放心吧，我准备好了。伤药准备妥当，千岩军也提前赶过去埋伏了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150242
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150242,
					"content": "那就好。你自己当心点，不要掉以轻心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150243
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 110150243,
					"content": "北斗，凝光小姐，你们在聊什么呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150244
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110150244,
					"content": "等群玉阁升空，你们自会明白。但…不是什么愉快的事，不知道或许更好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150245
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150245,
					"content": "第一次登上群玉阁的时候，我站在高台边缘，从空中遥望着璃月港。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150246
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150246,
					"content": "那时我想，终有一日我会让群玉阁的影子覆盖七国。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150247
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150247,
					"content": "时至今日，我的愿望依然未变。不过，这次重修群玉阁，却不只是为了我自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150248
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150248,
					"content": "我希望，无论何时群玉阁都能一直浮在璃月港上空，见证人间的繁荣安宁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150249
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150249,
					"content": "…也希望各位，与我一同见证。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150250
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150250,
					"content": "升空仪式，开始！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凝光"
				}
			]
		},
		{
			"id": 1101503,
			"completionStepIds": [
				1101503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101503",
							"2"
						],
						"stepId": 1101503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凝光"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110150301,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150302,
						110150303
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 110150302,
					"content": "没事吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110150304
					]
				},
				{
					"id": 110150304,
					"content": "只是力量有些消耗过度，没关系的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150305
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 110150305,
					"content": "本来想一个人把那家伙处理掉，没想到你还是追下来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150306
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 110150306,
					"content": "放心，她暂时不敢来了。受了那么严重的伤，应该已经遁逃到别处了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150307
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 110150307,
					"content": "方才在水下，情况如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150308
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150308,
					"content": "解决掉了。她在潜入水下前就受了伤，我们没费太大力气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150309
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 110150309,
					"content": "那就好。无论如何，总算是平安度过本次危机了。之后请到群玉阁来，我会好好招待你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150310
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150310,
					"content": "凝光大人，船队传来消息，那只水怪已经离开了孤云阁附近，周围海域恢复正常！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150311
					],
					"speakerTitle": "正茂"
				},
				{
					"id": 110150311,
					"content": "辛苦你们了，千岩军情况如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150312
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150312,
					"content": "多亏了凝光大人准备的伤药，以及刻晴大人的临阵指挥，我们尽可能将损伤控制到了最低。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150313
					],
					"speakerTitle": "正茂"
				},
				{
					"id": 110150313,
					"content": "当然，也要感谢这位小姐出手相助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150314
					],
					"speakerTitle": "正茂"
				},
				{
					"id": 110150314,
					"content": "我替千岩军所有的兄弟们，向你表示感谢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150315
					],
					"speakerTitle": "正茂"
				},
				{
					"id": 110150315,
					"content": "我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150316,
						110150317
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 110150316,
					"content": "申鹤主动保护了我们。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110150318
					]
				},
				{
					"id": 110150318,
					"content": "太好了。下次听云先生唱戏，我应该可以对那些赞美感到坦然了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150319
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 110150319,
					"content": "虽然我并未想做英雄，只是想保护你而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150320
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 110150320,
					"content": "让士兵们好好休养。但不可过于懈怠，严防她卷土重来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150321
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150321,
					"content": "是！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150322
					],
					"speakerTitle": "正茂"
				},
				{
					"id": 110150322,
					"content": "暗中观察这么久，可有结论？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150323
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150323,
					"content": "哼，你问本仙的意见？若非申鹤出手，绝不会如此顺利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150324
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 110150324,
					"content": "这一点我不否认。不过，无非是过程艰辛一些罢了，最终的胜利仍属于我们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150325
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150325,
					"content": "大不了，我可以再砸一个群玉阁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150326
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150326,
					"content": "…本仙看过了你们仿制和改造的归终机，你们确实有一些新奇的想法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150327
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 110150327,
					"content": "从失败中吸取经验，提前布局应对危机，相比上次有了长足的进步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150328
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 110150328,
					"content": "姑且算你们勉强过关吧，今后想必还有更多考验，本仙会一直看着你们的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150329
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 110150329,
					"content": "只要我还身居天权之位，我就会守护好璃月的安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150330
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150330,
					"content": "申鹤，几年前我看着你偷溜下山，又面色难过地悄悄回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150331
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 110150331,
					"content": "这次来璃月港，你的心境可有所不同？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150332
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 110150332,
					"content": "有。虽然说不清楚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150333
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 110150333,
					"content": "不过，比想象的开心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150334
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 110150334,
					"content": "那就好。旅行者，申鹤这孩子，就有劳你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150335
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 110150335,
					"content": "说来，本仙记得许多她小时候的趣事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150336
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 110150336,
					"content": "这个就不必了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150337
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 110150337,
					"content": "是吗？哼，一个两个都这样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150338
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 110150338,
					"content": "不爱听也罢，本仙不说就是。本仙回去了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150339
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 110150339,
					"content": "两位先好好休息一番。等疲惫消失，就到群玉阁上来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150340
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150340,
					"content": "既要庆祝群玉阁建成，也要庆祝璃月顺利度过危机。这次的宴会，一定空前热闹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150317,
					"content": "就像戏曲中的英雄一样。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110150318
					]
				},
				{
					"id": 110150303,
					"content": "你还好吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110150304
					]
				}
			]
		},
		{
			"id": 1101504,
			"completionStepIds": [
				1101505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
