			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"自称「唐无仇」者",
					"老何",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710820201,
					"content": "你这盗宝团余孽，呼呼…要不是我最近没能吃蘑菇，全身不得劲…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820202
					],
					"speakerTitle": "老何"
				},
				{
					"id": 710820202,
					"content": "我早就把你打得生活不能自理了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820203
					],
					"speakerTitle": "老何"
				},
				{
					"id": 710820203,
					"content": "你这老贼，上来指着我种的琉璃…我种的清心，说是蘑菇，摘了就往嘴里送！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820204
					],
					"speakerTitle": "自称「唐无仇」者"
				},
				{
					"id": 710820204,
					"content": "咳咳…哪有，哪有这样的道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820205
					],
					"speakerTitle": "自称「唐无仇」者"
				},
				{
					"id": 710820205,
					"content": "啊，老何，大侠，你们怎么打起来了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710820206,
					"content": "我、我在寻找蘑菇肉，蘑菇肉。但是他们不让我再下矿，所以我就找到这里来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820207
					],
					"speakerTitle": "老何"
				},
				{
					"id": 710820207,
					"content": "我好不容易发现这里种着蘑菇啊，刚伸手，这人就打过来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820208
					],
					"speakerTitle": "老何"
				},
				{
					"id": 710820208,
					"content": "#他竟敢冒犯我古华派传人的修炼之地，这花除了我，还有英雄{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820209
					],
					"speakerTitle": "自称「唐无仇」者"
				},
				{
					"id": 710820209,
					"content": "还有英雄派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710820210,
					"content": "还有英雄派蒙，除了我们三位之外，岂能容他人染指。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820211
					],
					"speakerTitle": "自称「唐无仇」者"
				},
				{
					"id": 710820211,
					"content": "盗宝团余孽！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820212
					],
					"speakerTitle": "老何"
				},
				{
					"id": 710820212,
					"content": "老贼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820213
					],
					"speakerTitle": "自称「唐无仇」者"
				},
				{
					"id": 710820213,
					"content": "好了好了，老何，唐无仇已经金盆洗手，不干盗宝团的事啦，而且他种的是花，也不是蘑菇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710820214,
					"content": "嗯？是嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820215
					],
					"speakerTitle": "老何"
				},
				{
					"id": 710820215,
					"content": "你仔细看，这不是清心嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710820216,
					"content": "欸，好像还真的是清心啊，看来头还是有点晕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820217
					],
					"speakerTitle": "老何"
				},
				{
					"id": 710820217,
					"content": "还有唐无仇，你还想着要开什么琉璃百合大花园嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710820218,
					"content": "哎呀，在这里，要有一大片琉璃百合大花园，不也是一番美景嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820219
					],
					"speakerTitle": "自称「唐无仇」者"
				},
				{
					"id": 710820219,
					"content": "不要再打了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710820220,
					"content": "唉，没有蘑菇，走了走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820221
					],
					"speakerTitle": "老何"
				},
				{
					"id": 710820221,
					"content": "这闹事的老头终于走了，这下我终于可以认真研究研究种花的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "自称「唐无仇」者"
				}
			]
		}
	]
}