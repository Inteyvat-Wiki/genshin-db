			"dialogs": [
				{
					"id": 230120301,
					"content": "你们已经把小猫带回来了啊，真是辛苦你们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120302
					],
					"speakerTitle": "莎莉"
				},
				{
					"id": 230120302,
					"content": "看样子，你们的「猫语」学得也不错嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120303
					],
					"speakerTitle": "莎莉"
				},
				{
					"id": 230120303,
					"content": "这些报酬给你，请收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120304
					],
					"speakerTitle": "莎莉"
				},
				{
					"id": 230120304,
					"content": "能这么快学会「猫语」的人可真难得，说不定我下次还要麻烦你帮忙呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120305
					],
					"speakerTitle": "莎莉"
				},
				{
					"id": 230120305,
					"content": "喵！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120306
					]
				},
				{
					"id": 230120306,
					"content": "可以说人话啦！莎莉小姐又不是猫！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230120307,
					"content": "我可以从你的表情里看出来，你想说的话是「没问题」，不过…这次你的发音可不对喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120308
					],
					"speakerTitle": "莎莉"
				},
				{
					"id": 230120308,
					"content": "不过没关系，我以后会继续教你「猫语」的，就让我们一起来学习吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莎莉"
				}
			]
		},
