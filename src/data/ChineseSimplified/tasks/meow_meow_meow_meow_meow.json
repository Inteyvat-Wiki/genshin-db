			"dialogs": [
				{
					"id": 230121101,
					"content": "我之前和猫也正经交流过…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230121102
					]
				},
				{
					"id": 230121102,
					"content": "你是说「寝子」吗？不过寝子可是能说人话的猫啊，应该也不算「猫语」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230121103,
					"content": "没错，但作为交换，你得去帮我把一只小猫带回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121104,
						230121105
					],
					"speakerTitle": "莎莉"
				},
				{
					"id": 230121104,
					"content": "没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230121108
					]
				},
				{
					"id": 230121108,
					"content": "那么，你们是答应我了？那就太感谢你们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121109
					],
					"speakerTitle": "莎莉"
				},
				{
					"id": 230121109,
					"content": "咳，咳咳…那就请你们听好了，这是我总结了很长时间才总结出的「猫的定型语」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莎莉"
				},
				{
					"id": 230121105,
					"content": "每个城市的找猫方式都不一样啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230121106
					]
				},
				{
					"id": 230121106,
					"content": "哈哈，哈…没错呢，这么一想，我们在好多城市里都帮人找过猫…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230121107,
					"content": "是该说每个人都喜欢小猫呢，还是该说…每个养猫的人都会遇见一样的烦恼呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121108
					],
					"speakerTitle": "派蒙"
				}
			]
		},
