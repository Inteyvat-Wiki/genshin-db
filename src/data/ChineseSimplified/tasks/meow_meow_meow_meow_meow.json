			},
			"dialogs": [
				{
					"id": 230120101,
					"content": "喵——咳咳，咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120102
					],
					"speakerTitle": "莎莉"
				},
				{
					"id": 230120102,
					"content": "你在做什么呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120103
					]
				},
				{
					"id": 230120103,
					"content": "我正在找我家的小猫呢，平时我这么叫一下，它们就会回应我的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120104
					],
					"speakerTitle": "莎莉"
				},
				{
					"id": 230120104,
					"content": "难道是我今天的发音不对吗？叫了好久都没回应，真奇怪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120105,
						230120109
					],
					"speakerTitle": "莎莉"
				},
				{
					"id": 230120105,
					"content": "不能直接叫它们的名字吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120106
					]
				},
				{
					"id": 230120106,
					"content": "对啊，一般来说找小猫的话，都应该直接叫它们的名字吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230120107,
					"content": "可是，用我们人的语言来呼唤它们的名字，小猫们肯定也听不懂吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120108
					],
					"speakerTitle": "莎莉"
				},
				{
					"id": 230120108,
					"content": "咦？这，这么说倒是有些道理…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230120113,
					"content": "不过，再这么喊下去也不是个办法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120114
					],
					"speakerTitle": "莎莉"
				},
				{
					"id": 230120114,
					"content": "旅行者，我想问你一个严肃的问题…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120115,
						230120116
					],
					"speakerTitle": "莎莉"
				},
				{
					"id": 230120115,
					"content": "就交给…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120117
					]
				},
				{
					"id": 230120117,
					"content": "…你想学「猫语」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120118
					],
					"speakerTitle": "莎莉"
				},
				{
					"id": 230120118,
					"content": "欸？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120119
					]
				},
				{
					"id": 230120119,
					"content": "咦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230120120,
					"content": "你是说，要教我们学猫说话吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230120116,
					"content": "报酬不能…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120117
					]
				},
				{
					"id": 230120109,
					"content": "什么叫做「今天的发音」不对？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120110
					]
				},
				{
					"id": 230120110,
					"content": "因为我现在发出的这些喵喵声，其实就是那些小猫们的名字喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120111
					],
					"speakerTitle": "莎莉"
				},
				{
					"id": 230120111,
					"content": "毕竟，如果直接用人的语言来呼唤小猫们的名字，它们肯定也听不懂吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120112
					],
					"speakerTitle": "莎莉"
				},
				{
					"id": 230120112,
					"content": "咦？这，这么说倒是有些道理…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120113
					],
					"speakerTitle": "派蒙"
				}
			]
		},
