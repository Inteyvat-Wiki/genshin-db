			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"迪希雅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130240301,
					"content": "看样子就在这里，我们先藏起来，等待时机。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240302
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240302,
					"content": "估计届时难免会有冲突，我们都要小心一点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240303
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240303,
					"content": "#放心啦，{M#他}{F#她}很能打的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130240304,
					"content": "哈哈哈，我当然不担心这个。我说「小心」的意思，是下手轻一点，还得了解情报呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240305
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240305,
					"content": "他们好像来了，准备好了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240306
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240306,
					"content": "速战速决，别给他们反应的时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "迪希雅"
				}
			]
		},
		{
			"id": 1302405,
			"completionStepIds": [
				1302405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1302405",
							"2"
						],
						"stepId": 1302405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"萨塔尔",
					"迪希雅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130240501,
					"content": "可…可恶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240502
					],
					"speakerTitle": "萨塔尔"
				},
				{
					"id": 130240502,
					"content": "你、你是？「炽鬃之狮」？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240503
					],
					"speakerTitle": "萨塔尔"
				},
				{
					"id": 130240503,
					"content": "看来不用多费口舌了，快交代吧，你们和「阿赫玛尔之须」是什么关系，他们要干什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240504
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240504,
					"content": "哼，佣兵拿钱办事。保护雇佣者的情报是最基本的原则，你觉得我会说？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240505
					],
					"speakerTitle": "萨塔尔"
				},
				{
					"id": 130240505,
					"content": "你这种话唬外行人或许还有用，说到底这不就是为了捍卫你赚摩拉的信誉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240506
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240506,
					"content": "但做生意还需要很多其他的东西，比如你的手，你的腿，你的眼睛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240507
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240507,
					"content": "我给你五秒，仔细考虑一下，雇佣者的情报是不是真的这么重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240508
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240508,
					"content": "喂、喂…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240509,
						130240510
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130240509,
					"content": "没事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130240511
					]
				},
				{
					"id": 130240511,
					"content": "我没跟你开玩笑，我很明白轻重，怎么做才最能让人痛苦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240512
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240512,
					"content": "你还有最后两秒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240513
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240513,
					"content": "哼，不劳你动手…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240514
					],
					"speakerTitle": "萨塔尔"
				},
				{
					"id": 130240514,
					"content": "喂？！你疯了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240515
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240515,
					"content": "他咬了自己的舌头！快，找找货物里面有没有药品！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240516
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240516,
					"content": "迪希雅紧急处理之后，萨塔尔嘴里的鲜血止住了。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130240517
					]
				},
				{
					"id": 130240517,
					"content": "唉，真是没想到。幸好舌头受伤不重，他是痛晕过去的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240518
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240518,
					"content": "他怎么会做这种事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240519
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130240519,
					"content": "我本来只是想和他斗斗狠，还以为和某些佣兵一样，不花力气就能撬开他的嘴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240520
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240520,
					"content": "没想到即便选这么痛苦的方式，他也不愿意告诉我们情报。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240521
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240521,
					"content": "现在怎么办，他已经晕过去了…虽然能等他醒过来，但…还是不要继续了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240522
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130240522,
					"content": "嗯，放心好了，像他这样再问一次也是浪费时间，还可能逼他继续伤害自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240523
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240523,
					"content": "这里有这么多货物，我们从这里着手查查看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240524
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240524,
					"content": "——我很抱歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240510,
					"content": "她会有分寸。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130240511
					]
				}
			]
		},
		{
			"id": 1302411,
