	"talks": [
		{
			"id": 1302401,
			"completionStepIds": [
				1302401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1302401",
							"2"
						],
						"stepId": 1302401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"迪希雅",
					"迪娜泽黛"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130240101,
					"content": "让我想想，按之前的计划，我们还需要买什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130240102,
					"content": "哦，好香的味道，是「兽米香香」！我们买一点吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130240103,
					"content": "应该不在计划内？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130240104
					]
				},
				{
					"id": 130240104,
					"content": "那…那现在加上去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130240105,
					"content": "#这不是{NICKNAME}和派蒙嘛，我们居然会在这里碰到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240106
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240106,
					"content": "你们好啊，好久不见了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240107
					],
					"speakerTitle": "迪娜泽黛"
				},
				{
					"id": 130240107,
					"content": "欸？居然又是你们两个人的组合，迪希雅你不是已经回沙漠了嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130240108,
					"content": "哈哈，只是贴身保镖的工作不做了而已，又不是闹翻了。我和迪娜泽黛还是很好的朋友啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240109
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240109,
					"content": "呼玛伊家也还会招工，报酬优厚，我和兄弟们自然没有拒绝的理由。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240110
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240110,
					"content": "这几天她接了我家的工作，我就让她直接在家里住下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240111
					],
					"speakerTitle": "迪娜泽黛"
				},
				{
					"id": 130240111,
					"content": "父亲和母亲都很开心，说之前迪希雅不在，就像家里少了个人似的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240112
					],
					"speakerTitle": "迪娜泽黛"
				},
				{
					"id": 130240112,
					"content": "他们太夸张了，总是那么热情…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240113
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240113,
					"content": "我工作已经完成了，本来打算买点东西就回团里，老爷却硬要再留我一天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240114
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240114,
					"content": "多待两三天也没什么关系呀，我父亲还没来得及给你做他的拿手菜呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240115
					],
					"speakerTitle": "迪娜泽黛"
				},
				{
					"id": 130240115,
					"content": "你知道我安静不下来，小姐。没关系的，下次还有机会啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240116
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240116,
					"content": "真佩服你，听到「拿手菜」三个字也毫不动摇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130240117,
					"content": "啊，对了，之前你说下次再带我去沙漠，要不然就今天出发吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240118
					],
					"speakerTitle": "迪娜泽黛"
				},
				{
					"id": 130240118,
					"content": "还有好多地方我没看过呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240119
					],
					"speakerTitle": "迪娜泽黛"
				},
				{
					"id": 130240119,
					"content": "不好意思，这次还不行，我们团还有些事要处理，最近沙漠那边也不太平。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240120
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240120,
					"content": "你都拖了多久了，上次也是，上上次也是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240121
					],
					"speakerTitle": "迪娜泽黛"
				},
				{
					"id": 130240121,
					"content": "抱歉，抱歉，再给我点时间，我好好地帮你安排一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240122
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240122,
					"content": "好吧，知道了。其实我不是在任性地提要求，而是…某种直觉之类的东西吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240123
					],
					"speakerTitle": "迪娜泽黛"
				},
				{
					"id": 130240123,
					"content": "这次从你到我们家开始，我就觉得你行色匆匆，心神不宁的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240124
					],
					"speakerTitle": "迪娜泽黛"
				},
				{
					"id": 130240124,
					"content": "是不是你遇到了什么棘手的事，才把我们的约定一拖再拖？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240125
					],
					"speakerTitle": "迪娜泽黛"
				},
				{
					"id": 130240125,
					"content": "没有啦，你想多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240126
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240126,
					"content": "那你能保证吗？朋友之间不应该互相欺骗，只要你点头，我就不再追问了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240127
					],
					"speakerTitle": "迪娜泽黛"
				},
				{
					"id": 130240127,
					"content": "但如果真有什么事，你大可和我说实话，我会想办法帮你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240128
					],
					"speakerTitle": "迪娜泽黛"
				},
				{
					"id": 130240128,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240129
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240129,
					"content": "是不是被迪娜泽黛说中了啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130240130,
					"content": "唉，小姐你真是太难缠了，什么事都瞒不过你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240131
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240131,
					"content": "我本来觉得佣兵圈子里的事，小姐你没必要知道，知道了也只有坏处。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240132
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240132,
					"content": "那是个弱肉强食，趋利避害的世界，和这边太不一样了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240133
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240133,
					"content": "可还是那句话，我们是好朋友，不了解你的顾虑，我又要怎么支持和帮助你呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240134
					],
					"speakerTitle": "迪娜泽黛"
				},
				{
					"id": 130240134,
					"content": "小姐…你也没必要这么固执啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240135
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240135,
					"content": "好吧，实在拗不过你。我们换个地方吧，这里不太合适。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240136
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240136,
					"content": "就在这里吧，尽量不要引人注目。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240137
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240137,
					"content": "镀金旅团人数众多，组成复杂，其中有很多像我一样的佣兵，四处寻找工作，赚取摩拉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240138
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240138,
					"content": "我的团名叫「炽光猎兽」，规模不大，但团里接纳的都是有血性，讲义气的好人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240139
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240139,
					"content": "但还有另一种旅团，为了摩拉可以放弃所有的道德底线。其中最臭名昭著的，名叫「神王之遗」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240140
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240140,
					"content": "神…王？对镀金旅团的人来说，又是神，又是王的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240141,
						130240142
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130240141,
					"content": "就是赤王吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130240143
					]
				},
				{
					"id": 130240143,
					"content": "没错，我听说你们曾经和「阿赫玛尔之眼」打过交道，他们就是「神王之遗」的附属团之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240144
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240144,
					"content": "哦，是那个卖神明罐装知识的团！确实感觉不像好人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240145
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130240145,
					"content": "「神王之遗」由诸多类似的团组合而成，再由总部从上而下统一管理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240146
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240146,
					"content": "本来平时我对他们都避之不及，但这次兴风作浪的那个团，名叫「阿赫玛尔之须」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240147
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240147,
					"content": "…须？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240148
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130240148,
					"content": "就是胡须啦，大概吧。名字很蠢我知道，以前我就很嫌弃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240149
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240149,
					"content": "但重点在于——这是库塞拉，我父亲的团。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240150
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240150,
					"content": "欸？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240151
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130240151,
					"content": "我有点理解你的难言之隐了…不过他们到底做了什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240152
					],
					"speakerTitle": "迪娜泽黛"
				},
				{
					"id": 130240152,
					"content": "细节我还是不描述了，小姐。总之就是大量的暴力事件，应该有上百起吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240153
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240153,
					"content": "这么多？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240154
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130240154,
					"content": "嗯，现场往往会非常惨烈，他们会把钱财洗劫一空，然后再灭口。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240155
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240155,
					"content": "受害者不只是商队和普通人，还包括了其他的佣兵团。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240156
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240156,
					"content": "这已经敌我不分了，就算再没底线也…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240157
					],
					"speakerTitle": "迪娜泽黛"
				},
				{
					"id": 130240157,
					"content": "我不知道「神王之遗」内部对这件事是什么态度，但近几年他们越来越猖獗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240158
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240158,
					"content": "如果我再坐视不管的话，我现在的团，还有阿如村的人，不知道什么时候也会被选为目标。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240159
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240159,
					"content": "唉，那家伙这几年到底在想什么啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240160
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240160,
					"content": "你的父亲，原来是这么可怕的人吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240161
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130240161,
					"content": "人都是会变的，以前的他在我印象里，虽然没什么出息，但做事还有底线。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240162
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240162,
					"content": "这评价好像也不高啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240163
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130240163,
					"content": "唉，不然我怎么会离开「阿赫玛尔之须」，和他一刀两断呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240164
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240164,
					"content": "他大大咧咧的，特别吵闹，性子也很随便。成天不干正事不说，总是酗酒，还很好色。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240165
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240165,
					"content": "团员们也会跟他一起折腾，经常一闹就是一整晚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240166
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240166,
					"content": "哇，就像噩梦一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240167
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130240167,
					"content": "那你的母亲呢，没有阻止他们吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240168
					],
					"speakerTitle": "迪娜泽黛"
				},
				{
					"id": 130240168,
					"content": "…很遗憾，我不知道我的母亲是谁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240169
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240169,
					"content": "啊，对不起，迪希雅，我不是故意的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240170
					],
					"speakerTitle": "迪娜泽黛"
				},
				{
					"id": 130240170,
					"content": "没事啦，小姐，很多佣兵都这样。我不是说我父亲很好色吗？我就是这么生下来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240171
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240171,
					"content": "他说他也搞不清楚我母亲是谁，母亲她也从来没有来看过我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240172
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240172,
					"content": "他虽然总说「只要有爸爸在就够了」，但基本上所有事他都丢给团员去做，只给我讲讲故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240173
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240173,
					"content": "关键是他的品味又很差劲，会的故事没几个，还都是老掉牙过时的那种。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240174
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240174,
					"content": "沙城的勇者战胜了林中的巨龙，佣兵克服万难终于救出了叛军手中的公主什么的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240175
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240175,
					"content": "都是很标准的童话啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240176
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130240176,
					"content": "嗯，听一两次可能还比较新鲜，十几二十次之后怎么都腻了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240177
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240177,
					"content": "但他完全不觉得腻，反而越来越投入，还把团里的兄弟们叫来一起表演。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240178
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240178,
					"content": "给我准备的玩具，也全都是故事里的道具，盔甲，盾牌，玩具剑什么的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240179
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240179,
					"content": "后来我才有点明白，根本不是讲给我听，是他自己喜欢这么玩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240180
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240180,
					"content": "哇，这个人…好奇怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240181
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130240181,
					"content": "但感觉本质并不坏？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130240182
					]
				},
				{
					"id": 130240182,
					"content": "嗯，小时候我觉得他很幼稚，但这最多只能让我无奈，还称不上是厌恶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240183
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240183,
					"content": "——长大了之后，我偶然得知了「神王之遗」的所作所为。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240184
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240184,
					"content": "掳掠，威胁，暴力，欺诈，这些邪恶的行为在组织里竟然都是吹嘘的资本。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240185
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240185,
					"content": "他，还有团里的人，根本就不是什么英雄，而是故事里应该被打倒的反派。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240186
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240186,
					"content": "他们不会以为不让我看见，我就永远不知道吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240187
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240187,
					"content": "我好像能明白你的心情。现实让你感受到了落差…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240188
					],
					"speakerTitle": "迪娜泽黛"
				},
				{
					"id": 130240188,
					"content": "嗯，不过没关系啦，小姐，都是过去的事了。我和他大吵一架之后就离开了，再也没回去过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240189
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240189,
					"content": "这次我要介入调查，也不是对他有什么多余的感情，只是想保护我身边的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240190,
						130240191
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240190,
					"content": "所以问题就在于…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130240192
					]
				},
				{
					"id": 130240192,
					"content": "是的，我的兄弟们正在收集各路情报。绝大多数的报告都是暴力事件，此外还涉及非法贸易。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240193
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240193,
					"content": "我懂了…但这肯定会很危险吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240194
					],
					"speakerTitle": "迪娜泽黛"
				},
				{
					"id": 130240194,
					"content": "嗯，但佣兵的一生就是不断地和危险博弈，我很享受这样的生活方式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240195
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240195,
					"content": "这对关心你的人来说，是一种很沉重的负担啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240196
					],
					"speakerTitle": "迪娜泽黛"
				},
				{
					"id": 130240196,
					"content": "所以说，才没打算告诉你啊，小姐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130241101
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130241101,
					"content": "怎、怎么办？两个人的想法都有道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130241102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130241102,
					"content": "我跟迪希雅一起去吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130241103
					]
				},
				{
					"id": 130241103,
					"content": "欸？没必要把你卷进来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130241104
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130241104,
					"content": "#{M#他}{F#她}很厉害的哦，迪娜泽黛，这种事如果{M#他}{F#她}和迪希雅联手，肯定「哐当」一下就解决了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130241105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130241105,
					"content": "#这…好吧，有{M#他}{F#她}在，我确实会放心一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130241106,
						130241107
					],
					"speakerTitle": "迪娜泽黛"
				},
				{
					"id": 130241106,
					"content": "放心好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130241108
					]
				},
				{
					"id": 130241108,
					"content": "那我在城里等你们的消息，你们一定要安然无恙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130241109
					],
					"speakerTitle": "迪娜泽黛"
				},
				{
					"id": 130241109,
					"content": "谢谢你，小姐，能这么关心我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130241110
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130241110,
					"content": "那走吧，先去喀万驿见见「炽光猎兽」，我的兄弟们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130241107,
					"content": "我…我尽量。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130241108
					]
				},
				{
					"id": 130240191,
					"content": "为什么他们突然开始大干坏事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130240192
					]
				},
				{
					"id": 130240142,
					"content": "阿赫玛尔。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130240143
					]
				}
			]
		},
		{
			"id": 1302402,
			"completionStepIds": [
				1302402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1302402",
							"2"
						],
						"stepId": 1302402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"哈伦",
					"希沙姆",
					"哈拉夫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130240201,
					"content": "嘿，迪希雅，你回来了啊。这两位是你的朋友吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240202,
						130240204
					],
					"speakerTitle": "哈伦"
				},
				{
					"id": 130240202,
					"content": "你好，幸会。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130240203
					]
				},
				{
					"id": 130240203,
					"content": "哈哈，你好你好，随意点就好，我们没什么讲究。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240206
					],
					"speakerTitle": "哈伦"
				},
				{
					"id": 130240206,
					"content": "既然有新人在，「阿赫玛尔之须」的事我简单讲讲吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240207
					],
					"speakerTitle": "哈伦"
				},
				{
					"id": 130240207,
					"content": "他们的路子很野，直接把搞钱的目标放在了自己人身上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240208
					],
					"speakerTitle": "哈伦"
				},
				{
					"id": 130240208,
					"content": "不仅是一般的佣兵团，就连同属「神王之遗」的团都会被他们袭击。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240209
					],
					"speakerTitle": "哈伦"
				},
				{
					"id": 130240209,
					"content": "就算是凶猛残暴的野兽，也会保护自己的骨肉和族群，但他们根本不管不顾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240210
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240210,
					"content": "是的。从佣兵的手上抢了财物，他们会交给别的团或者黑市商人去转卖。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240211
					],
					"speakerTitle": "哈伦"
				},
				{
					"id": 130240211,
					"content": "一部分摩拉直接换成食物和武器，马上投入下一场暴力行动中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240212
					],
					"speakerTitle": "哈伦"
				},
				{
					"id": 130240212,
					"content": "太过分了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130240213,
					"content": "是啊，这也让我们好奇，他们如此渴望摩拉的原因是什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240214
					],
					"speakerTitle": "哈伦"
				},
				{
					"id": 130240214,
					"content": "前两天我和希沙姆去跟踪，还伪装成商人和他们交易，果然有不得了的发现。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240215
					],
					"speakerTitle": "哈伦"
				},
				{
					"id": 130240215,
					"content": "——与其说是「夺财」，不如说是「内斗」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240216
					],
					"speakerTitle": "哈伦"
				},
				{
					"id": 130240216,
					"content": "等等，「内斗」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240217
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240217,
					"content": "嗯，因为在受害者中，「神王之遗」附属团的占比特别高。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240218
					],
					"speakerTitle": "哈伦"
				},
				{
					"id": 130240218,
					"content": "如果只是为了摩拉，对方应该是谁都行，不会表现出像这样的目的性。但如果解读成内斗，就能说通了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240219
					],
					"speakerTitle": "哈伦"
				},
				{
					"id": 130240219,
					"content": "不过可惜的是，对方的口风很紧，我们没能拿到更进一步的情报。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240220
					],
					"speakerTitle": "哈伦"
				},
				{
					"id": 130240220,
					"content": "只是听说「阿赫玛尔之须」活跃的这几年，「神王之遗」一直在被削弱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240221,
						130240222
					],
					"speakerTitle": "哈伦"
				},
				{
					"id": 130240221,
					"content": "他们能有这么大本事…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130240223
					]
				},
				{
					"id": 130240223,
					"content": "确实很奇怪，接下来交给我们继续调查吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240224
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240224,
					"content": "但我没想到我不在的这几天，你们就直接跑去套情报，这是不是太危险了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240225
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240225,
					"content": "哎，这有什么，那是你老爹的团啊，我们比你还着急。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240226
					],
					"speakerTitle": "哈伦"
				},
				{
					"id": 130240226,
					"content": "是啊，再说了，你做的危险事可多了去了，我们这算什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240227
					],
					"speakerTitle": "希沙姆"
				},
				{
					"id": 130240227,
					"content": "他们去交易的时候，我去确认了一下遇难者的营地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240228
					],
					"speakerTitle": "哈拉夫"
				},
				{
					"id": 130240228,
					"content": "没有幸存者，活下来的人都跑了，营地里什么值钱的东西都没剩下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240229
					],
					"speakerTitle": "哈拉夫"
				},
				{
					"id": 130240229,
					"content": "希沙姆和哈拉夫，你们也来了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240230
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240230,
					"content": "看见你回来，我俩马上就过来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240231
					],
					"speakerTitle": "希沙姆"
				},
				{
					"id": 130240231,
					"content": "#这里的新朋友看上去有点稚嫩，但我一下子就感觉到{M#他}{F#她}身上有种不寻常的气场。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240232
					],
					"speakerTitle": "希沙姆"
				},
				{
					"id": 130240232,
					"content": "你有了厉害的帮手，我们也放心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240233
					],
					"speakerTitle": "希沙姆"
				},
				{
					"id": 130240233,
					"content": "那我呢，那我呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240234
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130240234,
					"content": "呃，你、你也要一起去啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240235
					],
					"speakerTitle": "希沙姆"
				},
				{
					"id": 130240235,
					"content": "#当然了！我是{M#他}{F#她}最重要的向导，{M#他}{F#她}不管去哪儿我都会跟着！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240236
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130240236,
					"content": "那…那迪希雅你最好照顾她一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240237
					],
					"speakerTitle": "希沙姆"
				},
				{
					"id": 130240237,
					"content": "你是看不起我吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240238
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130240238,
					"content": "哈哈哈，别看她这个样子，她曾经也去过很多危险的地方，最后都安然无恙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240239
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240239,
					"content": "就算都是偶然，所有偶然叠加起来，也可以说很有本事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240240
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240240,
					"content": "原来如此，是我以貌取人了，哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240241
					],
					"speakerTitle": "希沙姆"
				},
				{
					"id": 130240241,
					"content": "哦对了，迪希雅，等你有空了去和副团长说说你的日程安排吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240242
					],
					"speakerTitle": "哈拉夫"
				},
				{
					"id": 130240242,
					"content": "前两天我们招新，大家都是冲「炽鬃之狮」的名头来的，结果你正好不在，只有一群臭男人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240243
					],
					"speakerTitle": "哈拉夫"
				},
				{
					"id": 130240243,
					"content": "副团长忙里忙外，最后效果却很差，没几个人留下来，他可伤心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240244
					],
					"speakerTitle": "哈拉夫"
				},
				{
					"id": 130240244,
					"content": "抱歉抱歉，到时候我给他带两瓶好酒，之前走得比较急，专门回来一趟不太顺路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240245
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240245,
					"content": "不过，他们的选择也没错啊。要是迪希雅不在，这里确实没什么特别的吸引力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240246
					],
					"speakerTitle": "希沙姆"
				},
				{
					"id": 130240246,
					"content": "要是副团长能想想办法，再招几个大帅哥或者大美人进来就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240247
					],
					"speakerTitle": "希沙姆"
				},
				{
					"id": 130240247,
					"content": "得了吧，之前我邀请了两个女佣兵来团里，你们一个个像冬瓜一样坐在那儿，气都不会喘了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240248
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240248,
					"content": "那种沉默很诡异的啊，本来她们都打算加入的，一顿饭之后就被吓跑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240249
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240249,
					"content": "那、那种事别再提了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240250
					],
					"speakerTitle": "希沙姆"
				},
				{
					"id": 130240250,
					"content": "还有这种事？我怎么不知道？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240251
					],
					"speakerTitle": "哈拉夫"
				},
				{
					"id": 130240251,
					"content": "你当时不在吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240252
					],
					"speakerTitle": "哈伦"
				},
				{
					"id": 130240252,
					"content": "我不在吗？我错过了百年一遇的大好事？然后你们还不告诉我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240253
					],
					"speakerTitle": "哈拉夫"
				},
				{
					"id": 130240253,
					"content": "哎哎哎，行了行了，等会儿再给你讲，你别闹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240254
					],
					"speakerTitle": "哈伦"
				},
				{
					"id": 130240254,
					"content": "不是，你可别想应付过去啊。希沙姆，还有你，赶紧过来，讲清楚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240255
					],
					"speakerTitle": "哈拉夫"
				},
				{
					"id": 130240255,
					"content": "你们…一直都这样吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240256
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130240256,
					"content": "哈哈，是的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240257
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240257,
					"content": "佣兵之间没那么多弯弯绕绕的规矩，一般都是想到什么就说什么，特别随意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240258
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240258,
					"content": "要是对方惹你生气，那就骂回去，如果不解气，还可以直接动手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240259
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240259,
					"content": "但大家也不会往心里去，很快就过去了，这总比把意见憋在心里，永远不沟通好吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240260
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240260,
					"content": "所以跟他们说话我也不会留情，该笑就笑，该骂就骂，挺过瘾的，在呼玛伊家可不能这样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240261
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240261,
					"content": "喂，你们几个等会儿再吵，先把情报给我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240262
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240262,
					"content": "听见没，哈拉夫，先干正事。我绘制了一张路线图，你们在这里就能拦下帮他们销赃的商队。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240263
					],
					"speakerTitle": "哈伦"
				},
				{
					"id": 130240263,
					"content": "先藏起来，等到晚上，保证人赃俱获。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240264
					],
					"speakerTitle": "哈伦"
				},
				{
					"id": 130240264,
					"content": "好的，谢谢你们，顺便帮我和其他人问声好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240265
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240265,
					"content": "放心吧，你也要小心哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "哈伦"
				},
				{
					"id": 130240222,
					"content": "好像更不理解了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130240223
					]
				},
				{
					"id": 130240204,
					"content": "是过命的交情。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130240205
					]
				},
				{
					"id": 130240205,
					"content": "哦？那和我们一样了，哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240206
					],
					"speakerTitle": "哈伦"
				}
			]
		},
		{
			"id": 1302403,
			"completionStepIds": [
				1302403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
