			"dialogs": [
				{
					"id": 130241101,
					"content": "怎、怎么办？两个人的想法都有道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130241102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130241102,
					"content": "我跟迪希雅一起去吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130241103
					]
				},
				{
					"id": 130241103,
					"content": "欸？没必要把你卷进来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130241104
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130241104,
					"content": "#{M#他}{F#她}很厉害的哦，迪娜泽黛，这种事如果{M#他}{F#她}和迪希雅联手，肯定「哐当」一下就解决了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130241105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130241105,
					"content": "#这…好吧，有{M#他}{F#她}在，我确实会放心一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130241106,
						130241107
					],
					"speakerTitle": "迪娜泽黛"
				},
				{
					"id": 130241106,
					"content": "放心好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130241108
					]
				},
				{
					"id": 130241108,
					"content": "那我在城里等你们的消息，你们一定要安然无恙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130241109
					],
					"speakerTitle": "迪娜泽黛"
				},
				{
					"id": 130241109,
					"content": "谢谢你，小姐，能这么关心我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130241110
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130241110,
					"content": "那走吧，先去喀万驿见见「炽光猎兽」，我的兄弟们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130241107,
					"content": "我…我尽量。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130241108
					]
				}
			]
		},
