			"dialogs": [
				{
					"id": 711271101,
					"content": "听大山这么讲，我感觉枫丹的「歌剧」和我们这边的戏好像也差不多呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271102
					],
					"speakerTitle": "小茂"
				},
				{
					"id": 711271102,
					"content": "骑士呀，巫师呀，勇士呀，恶龙呀，你杀我，我杀你的，最后大家都死了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271103
