			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"小茂",
					"灵渊"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711270901,
					"content": "阿蓝，阿蓝，你上次给我讲的那个故事，还没有结尾呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270902
					],
					"speakerTitle": "小茂"
				},
				{
					"id": 711270902,
					"content": "嗯。我记得。不过，我改变主意了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270903
					],
					"speakerTitle": "灵渊"
				},
				{
					"id": 711270903,
					"content": "「改变主意」是什么意思呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270904
					],
					"speakerTitle": "小茂"
				},
				{
					"id": 711270904,
					"content": "这个故事的结尾，就交给你来讲吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270905
					],
					"speakerTitle": "灵渊"
				},
				{
					"id": 711270905,
					"content": "欸？！阿蓝也太耍赖啦！明明说好的，我给你讲一个故事，你给我讲一个故事，怎么现在两个故事全都变成我来讲啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270906
					],
					"speakerTitle": "小茂"
				},
				{
					"id": 711270906,
					"content": "我只是愚钝的野兽。想不出好的结局。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270907
					],
					"speakerTitle": "灵渊"
				},
				{
					"id": 711270907,
					"content": "我想出的结局是坏结局，故事也是没有人会欢笑的坏故事。所以，你来讲故事的结局。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270908
					],
					"speakerTitle": "灵渊"
				},
				{
					"id": 711270908,
					"content": "可这还是在耍赖嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270909
					],
					"speakerTitle": "小茂"
				},
				{
					"id": 711270909,
					"content": "我不否认。作为补偿，我可以带你去看灵濛山中隐藏的绝景。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270910
					],
					"speakerTitle": "灵渊"
				},
				{
					"id": 711270910,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270911
					],
					"speakerTitle": "灵渊"
				},
				{
					"id": 711270911,
					"content": "不要露出那种表情。我特别允许你…坐在我背上，五分钟左右。十分钟也可以。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270912
					],
					"speakerTitle": "灵渊"
				},
				{
					"id": 711270912,
					"content": "那…那就这样说好了，我想想这个故事该怎么结尾…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小茂"
				}
			]
		},
		{
			"id": 7112710,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7112710",
							"2"
						],
						"stepId": 7112710,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"灵渊"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711271001,
					"content": "欸，这不是灵渊吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271002
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711271002,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271003
					],
					"speakerTitle": "灵渊"
				},
				{
					"id": 711271003,
					"content": "啊，对不起！难道说你是在狩猎，我们不小心打扰了你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271004
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711271004,
					"content": "我没有在狩猎。你们也没有打扰我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271005
					],
					"speakerTitle": "灵渊"
				},
				{
					"id": 711271005,
					"content": "呃，那你这是在…发呆？比方说，在想好吃的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271006
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711271006,
					"content": "我也没在想你的事情。我在思考。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271007
					],
					"speakerTitle": "灵渊"
				},
				{
					"id": 711271007,
					"content": "思考…不对，你前半句话是什么意思啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271008
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711271008,
					"content": "#我在思考{NICKNAME}之前的问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271009
					],
					"speakerTitle": "灵渊"
				},
				{
					"id": 711271009,
					"content": "「如果人类活动也是自然法则的一部分，该如何看待人类。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271010
					],
					"speakerTitle": "灵渊"
				},
				{
					"id": 711271010,
					"content": "浮锦和蛇，她们离开后，我太久没有接触过组成聚落的人类了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271011
					],
					"speakerTitle": "灵渊"
				},
				{
					"id": 711271011,
					"content": "你这话说的，小茂不也是人类嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271012
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711271012,
					"content": "#小茂是属于聚落的人类，而不是组成聚落的人类。你和{NICKNAME}「组成」了旅行的同伴，而不「属于」{NICKNAME}。这就是区别。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271013,
						711271015
					],
					"speakerTitle": "灵渊"
				},
				{
					"id": 711271013,
					"content": "你认为小茂不是社会秩序的一部分？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711271014
					]
				},
				{
					"id": 711271014,
					"content": "还没有完全成为这种秩序的一部分。人类的幼崽几乎都是这样，直到他们被这种秩序彻底涂抹，就像是自然那样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271017
					],
					"speakerTitle": "灵渊"
				},
				{
					"id": 711271017,
					"content": "我太久没有接触过组成聚落的人类了。或许是出于厌恶，或许是出于恐惧，或许两者皆有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271018,
						711271019
					],
					"speakerTitle": "灵渊"
				},
				{
					"id": 711271018,
					"content": "因为他们侵占了属于自然的土地？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711271020
					]
				},
				{
					"id": 711271020,
					"content": "我不知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271021
					],
					"speakerTitle": "灵渊"
				},
				{
					"id": 711271021,
					"content": "也许不存在明显的区别，划分「我们」和「他们」，但我无法确定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271022
					],
					"speakerTitle": "灵渊"
				},
				{
					"id": 711271022,
					"content": "人类的幼崽会与我同行，我也有年幼的同族，出于好奇选择与人类同行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271023
					],
					"speakerTitle": "灵渊"
				},
				{
					"id": 711271023,
					"content": "欸？年幼的同族？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271024
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711271024,
					"content": "那孩子在山中遇到了烟火气的人类，",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271025
					],
					"speakerTitle": "灵渊"
				},
				{
					"id": 711271025,
					"content": "所以，我现在依然没办法回答你的问题。我需要继续观察人类。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271026
					],
					"speakerTitle": "灵渊"
				},
				{
					"id": 711271026,
					"content": "许多事情，我不理解。我会试着理解，直到我能够按照约定，回答你的问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "灵渊"
				},
				{
					"id": 711271019,
					"content": "因为浮锦为了他们选择牺牲自己？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711271020
					]
				},
				{
					"id": 711271015,
					"content": "这可不好说…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711271016
					]
				},
				{
					"id": 711271016,
					"content": "喂！不要说这么奇怪的话啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271017
					],
					"speakerTitle": "派蒙"
				}
			]
		},
