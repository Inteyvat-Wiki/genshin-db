						],
						"pointId": 311600084
					}
				]
			},
			"dialogs": [
				{
					"id": 711270501,
					"content": "#欸？{NICKNAME}和派蒙，还有灵渊…为什么会到这里来呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270502
					],
					"speakerTitle": "浮锦"
				},
				{
					"id": 711270502,
					"content": "哇啊，是浮锦的声音！好像是…从这下面传上来的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270503,
						711270505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711270503,
					"content": "我有些担心你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270504
					]
				},
				{
					"id": 711270504,
					"content": "是呀，我们都很担心你的身体状况，所以没打招呼就来了——不过，浮锦一开始不也没打招呼就把我们拉过来了嘛，这样我们就算是扯平啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270509
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711270509,
					"content": "欸？啊！抱歉！我回锦落庭休息的时候，好像忘了解除门口的封锁了…！对不起，你们明明是来探望我的，却给你们添了那么多麻烦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270510
					],
					"speakerTitle": "浮锦"
				},
				{
					"id": 711270510,
					"content": "也算不上是添麻烦啦。不过，为什么你要躲在这个…呃，水坑里呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270511
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711270511,
					"content": "怎么说呢…因为我现在还没能恢复我最喜欢的形态，总是让你们看到鲤鱼的样子，稍微觉得有些…不好意思…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270512,
						711270513
					],
					"speakerTitle": "浮锦"
				},
				{
					"id": 711270512,
					"content": "明明之前已经见过好多次了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270514
					]
				},
				{
					"id": 711270514,
					"content": "啊哈哈…因为之前能随时变回人的样子，所以觉得用鲤鱼的形态行动起来会更方便；现在只剩下滑溜溜的样子了，反而觉得有点…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270515
					],
					"speakerTitle": "浮锦"
				},
				{
					"id": 711270515,
					"content": "呜哇，还真是奇怪的执着…总之，浮锦你没事就好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270516
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711270516,
					"content": "不过，按照灵渊之前的说法，浮锦的力量其实不是直接消耗掉了，而是逸散到了沉玉谷的山林河川之间，所以才会变得虚弱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270517
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711270517,
					"content": "那要是像我们在药蝶谷找金色的鲤鱼一样，把逸散的仙力收集起来，浮锦就能恢复了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270518
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711270518,
					"content": "嗯…理论上来说是这样没错啦，不过…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270519
					],
					"speakerTitle": "浮锦"
				},
				{
					"id": 711270519,
					"content": "对吧对吧？那我们之后要是发现了类似的鲤鱼，就把它带回这里来吧！这样一来，浮锦也能早日恢复啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270520
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711270520,
					"content": "这、这种事情也太麻烦你们了！小仙我的力量还没有耗尽到那种程度，只要在这里稍稍静养一段时间，就可以…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270521
					],
					"speakerTitle": "浮锦"
				},
				{
					"id": 711270521,
					"content": "倒也不算是麻烦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270522
					]
				},
				{
					"id": 711270522,
					"content": "…只是遇到的话会留神一下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270523
					]
				},
				{
					"id": 711270523,
					"content": "谢谢你们。不过，我真的不想因为自己的事情再给你们添麻烦了，你们为我做过的已经太多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270524
					],
					"speakerTitle": "浮锦"
				},
				{
					"id": 711270524,
					"content": "要是二位在旅途中寻到了更多逸散的仙力，就将它们直接汇入这里的祀珑吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270525
					],
					"speakerTitle": "浮锦"
				},
				{
					"id": 711270525,
					"content": "虽然水土的调理已经完成，但若是能向祀珑中注入更多力量，就能保证沉玉谷风调雨顺、年登岁稔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270526
					],
					"speakerTitle": "浮锦"
				},
				{
					"id": 711270526,
					"content": "…那你呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270527
					],
					"speakerTitle": "灵渊"
				},
				{
					"id": 711270527,
					"content": "真是的，我都说了，我只要在这里休养一段时间就好啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270528
					],
					"speakerTitle": "浮锦"
				},
				{
					"id": 711270528,
					"content": "#{NICKNAME}和派蒙，真的非常感谢你们能来探望我。我真的真的好开心。自从药君离开，还是第一次有人到这里来呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270529
					],
					"speakerTitle": "浮锦"
				},
				{
					"id": 711270529,
					"content": "也谢谢你，灵渊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270530
					],
					"speakerTitle": "浮锦"
				},
				{
					"id": 711270530,
					"content": "我没做什么值得你感谢的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270531
					],
					"speakerTitle": "灵渊"
				},
				{
					"id": 711270531,
					"content": "#哎呀，好啦！就当我是在感谢你把{NICKNAME}和派蒙带到这里吧，真是的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270532
					],
					"speakerTitle": "浮锦"
				},
				{
					"id": 711270532,
					"content": "#最后…让我再说一次谢谢吧，{NICKNAME}和派蒙。谢谢你们做过的一切。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "浮锦"
				},
				{
					"id": 711270513,
					"content": "那也没必要躲起来吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270514
					]
				},
				{
					"id": 711270505,
					"content": "灵渊有些担心你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270506
					]
				},
				{
					"id": 711270506,
					"content": "我没有。我只是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270507
					],
					"speakerTitle": "灵渊"
				},
				{
					"id": 711270507,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270508
					],
					"speakerTitle": "灵渊"
				},
				{
					"id": 711270508,
					"content": "你看，灵渊这都担心得说不出话了，所以我们没打招呼就来了——不过，浮锦一开始不也没打招呼就把我们拉过来了嘛，这样我们就算是扯平啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270509
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7112709,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
