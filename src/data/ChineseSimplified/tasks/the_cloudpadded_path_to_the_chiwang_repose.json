					{
						"sceneId": 3,
						"position": [
							1493.036,
							443.555,
							2842.422
						],
						"pointId": 311600077
					}
				]
			},
			"dialogs": [
				{
					"id": 711270401,
					"content": "#{NICKNAME}，还有派蒙。你们来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270402
					],
					"speakerTitle": "灵渊"
				},
				{
					"id": 711270402,
					"content": "欸，灵渊？为什么你会在这里？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711270403,
					"content": "因为我进不去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270404
					],
					"speakerTitle": "灵渊"
				},
				{
					"id": 711270404,
					"content": "进不去？是说进不去什么地方呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711270405,
					"content": "锦落庭。浮锦现在休息的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270406
					],
					"speakerTitle": "灵渊"
				},
				{
					"id": 711270406,
					"content": "锦落庭…唔，就是浮锦一开始把我们拉进去的那个地方吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711270407,
					"content": "那里是她用仙力封锁的居所。我没有她的仙力，去不到她的身边。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270408
					],
					"speakerTitle": "灵渊"
				},
				{
					"id": 711270408,
					"content": "啊？可是她之前回去休息的时候，你也没提这件事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711270409,
					"content": "我没想起来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270410,
						711270412
					],
					"speakerTitle": "灵渊"
				},
				{
					"id": 711270410,
					"content": "需要帮忙吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270411
					]
				},
				{
					"id": 711270411,
					"content": "你们拥有她的仙力，能够开启锦落庭的大门。是的，希望你们帮助我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270416
					],
					"speakerTitle": "灵渊"
				},
				{
					"id": 711270416,
					"content": "欸？等一下，所以你是一直在这里等我们吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270417
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711270417,
					"content": "我不是在等你们。我是在寻找进入锦落庭的办法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270418
					],
					"speakerTitle": "灵渊"
				},
				{
					"id": 711270418,
					"content": "好像没什么区别…总、总之，我们也有些在意浮锦的身体状况，那灵渊，我们一起去探望她吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270419
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711270419,
					"content": "好。谢谢你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270420
					],
					"speakerTitle": "灵渊"
				},
				{
					"id": 711270420,
					"content": "跟我来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "灵渊"
				},
				{
					"id": 711270412,
					"content": "阿蓝，好笨。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270413
					]
				},
				{
					"id": 711270413,
					"content": "就是就是！为什么连这么重要的事情都能忘啦！真是的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711270414,
					"content": "因为我只是愚钝的野兽。见到她，想了很多事情，忘了很多事情。是我的错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270415
					],
					"speakerTitle": "灵渊"
				},
				{
					"id": 711270415,
					"content": "你们拥有她的仙力，能够开启锦落庭的大门。希望你们帮助我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270416
					],
					"speakerTitle": "灵渊"
				}
			]
		},
		{
			"id": 7112705,
			"completionStepIds": [
				7112704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
