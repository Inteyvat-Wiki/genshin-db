			"trigger": {
				"objectNames": [
					"扎卡"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752640401,
					"content": "你们抓错人了…你们看，我师傅叫卡内，我叫扎卡…你们应该去抓他才对…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640402
					],
					"speakerTitle": "扎卡"
				},
				{
					"id": 752640402,
					"content": "我根本做不出我师傅那种等级的玩偶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640403
					],
					"speakerTitle": "扎卡"
				},
				{
					"id": 752640403,
					"content": "你是被人抓来的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752640404
					]
				},
				{
					"id": 752640404,
					"content": "欸？你们和他们不是一伙的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640405
					],
					"speakerTitle": "扎卡"
				},
				{
					"id": 752640405,
					"content": "当然不是，你没看见吗？我们把他们都打跑啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752640406,
					"content": "原来是这样？太好了！我终于自由了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640407
					],
					"speakerTitle": "扎卡"
				},
				{
					"id": 752640407,
					"content": "当然，你可以回家咯。不过…这里到底是怎么回事啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752640408,
					"content": "这帮家伙不知道是哪里的，跑来伪造度假村的玩偶。但是他们的水平很差，所以密谋把我的师傅卡内抓来当顾问。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640409
					],
					"speakerTitle": "扎卡"
				},
				{
					"id": 752640409,
					"content": "但是不知道哪里出了问题，居然把我抓了过来…老天，我才跟师傅学了三天颜料的手艺…根本达不到要求…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640410
					],
					"speakerTitle": "扎卡"
				},
				{
					"id": 752640410,
					"content": "不管怎么说，太感谢你们了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640411
					],
					"speakerTitle": "扎卡"
				},
				{
					"id": 752640411,
					"content": "阿扎卡，我们回家！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640412
					],
					"speakerTitle": "扎卡"
				},
				{
					"id": 752640412,
					"content": "~~~！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿扎卡"
				}
			]
		}
	]
