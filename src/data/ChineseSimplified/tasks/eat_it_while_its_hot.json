			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"哈里斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205210101,
					"content": "还是吃点热菜热饭比较好吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210102
					],
					"speakerTitle": "哈里斯"
				},
				{
					"id": 205210102,
					"content": "什么热菜热饭？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205210103
					]
				},
				{
					"id": 205210103,
					"content": "哦，我是说去雪山里探险的玉霞，她要是能吃点热菜热饭就好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210104
					],
					"speakerTitle": "哈里斯"
				},
				{
					"id": 205210104,
					"content": "因为玉霞又想要组织一次探险队进雪山探险，为了这次的探险，她说要自己先进山扎营，具体观察一下情况再制定计划。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210105
					],
					"speakerTitle": "哈里斯"
				},
				{
					"id": 205210105,
					"content": "她的观察营地设得倒是不远，补给送过去也不难…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210106
					],
					"speakerTitle": "哈里斯"
				},
				{
					"id": 205210106,
					"content": "但毕竟是在雪山里扎着营，我想，她要是能吃到热菜热饭的话，也许会更有精神吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210107
					],
					"speakerTitle": "哈里斯"
				},
				{
					"id": 205210107,
					"content": "但我也不敢自己进雪山…你愿意帮我把这份「白汁时蔬烩肉」送给玉霞吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210108,
						205210110
					],
					"speakerTitle": "哈里斯"
				},
				{
					"id": 205210108,
					"content": "交给我了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205210109
					]
				},
				{
					"id": 205210109,
					"content": "那就拜托你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210113
					],
					"speakerTitle": "哈里斯"
				},
				{
					"id": 205210113,
					"content": "这菜我刚刚做好，还热乎着，你可得抓紧时间送到玉霞手上，周围这么冷，菜凉了就没法吃了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210114
					],
					"speakerTitle": "哈里斯"
				},
				{
					"id": 205210114,
					"content": "不过…要真遇上意外情况，菜不能吃了，你就回来找我吧，我再重做一份给你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "哈里斯"
				},
				{
					"id": 205210110,
					"content": "她具体在哪里？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205210111
					]
				},
				{
					"id": 205210111,
					"content": "她说自己的观察营地就设在雪山山腰附近。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210112
					],
					"speakerTitle": "哈里斯"
				},
				{
					"id": 205210112,
					"content": "她这种冒险老手可是很谨慎的，不会随便就远离营地往雪山深处乱跑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210113
					],
					"speakerTitle": "哈里斯"
				}
			]
		},
