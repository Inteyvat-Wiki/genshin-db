			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"玉霞"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205210301,
					"content": "这份「白汁时蔬烩肉」给你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205210302
					]
				},
				{
					"id": 205210302,
					"content": "是哈里斯让你送过来的吧，谢谢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210303
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 205210303,
					"content": "吃惯了这种好菜，之后要啃干粮的时候，说不定我还吃不惯了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210304
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 205210304,
					"content": "哈哈哈，开玩笑的，既然我是一名冒险家，那该吃苦的时候还是会吃苦的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210305
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 205210305,
					"content": "你还会继续向前走吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205210306
					]
				},
				{
					"id": 205210306,
					"content": "那是当然，这个营地只是做中转用，等到了合适的时候，我会试试在更前面一些地方设立营地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210307
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 205210307,
					"content": "到时候，肯定就没机会吃到热菜热饭了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210308
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 205210308,
					"content": "不过，我也不会贸然前进，再观察一段时间，我就会回大本营了，等制定了详细计划之后再做打算。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210309
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 205210309,
					"content": "谢谢你专门送这份菜给我，这些东西就当做是报酬了，收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玉霞"
				}
			]
		},
