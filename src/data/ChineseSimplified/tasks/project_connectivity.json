				"points": []
			},
			"dialogs": [
				{
					"id": 736900101,
					"content": "你好，我是刹诃伐罗学院的达雅！你也是来参加学院游乐会的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900102
					],
					"speakerTitle": "达雅"
				},
				{
					"id": 736900102,
					"content": "这是我们学院推出的游玩项目：「通路计划」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900103
					],
					"speakerTitle": "达雅"
				},
				{
					"id": 736900103,
					"content": "怎么样？要不要试着玩一玩呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900104
					],
					"speakerTitle": "达雅"
				},
				{
					"id": 736900104,
					"content": "我记得刹诃伐罗学院是研究…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736900105
					]
				},
				{
					"id": 736900105,
					"content": "我们学院的研究很多都与机关和建筑有关。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900107
					],
					"speakerTitle": "达雅"
				},
				{
					"id": 736900107,
					"content": "咳，说远了…为了参与这次学院游乐会，我们学院里的很多学生群策群力…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900108
					],
					"speakerTitle": "达雅"
				},
				{
					"id": 736900108,
					"content": "最终，研究出了「通路计划」这个游玩项目！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900109
					],
					"speakerTitle": "达雅"
				},
				{
					"id": 736900109,
					"content": "简单来说，游玩者需要用我们已经准备好的各种物件搭建道路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900110
					],
					"speakerTitle": "达雅"
				},
				{
					"id": 736900110,
					"content": "无论是架桥啦，铺梯啦…最终的目标，就是搭建出一条可以供人通行，并且直达终点的道路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900111
					],
					"speakerTitle": "达雅"
				},
				{
					"id": 736900111,
					"content": "在搭建完毕后，我们还会进行一次最终检验…就像是验收搭建好的建筑一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900112
					],
					"speakerTitle": "达雅"
				},
				{
					"id": 736900112,
					"content": "总之，只要能搭建出一条安全的道路，就算是获胜啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900113,
						736900114
					],
					"speakerTitle": "达雅"
				},
				{
					"id": 736900113,
					"content": "听上去很复杂…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736900115
					]
				},
				{
					"id": 736900115,
					"content": "哈哈哈，不用担心，这又不是在现实里建设建筑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900116
					],
					"speakerTitle": "达雅"
				},
				{
					"id": 736900116,
					"content": "就算是搭建失误，道路垮塌了也没关系，只要重新搭建就好，我们也不会限定尝试次数的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900117
					],
					"speakerTitle": "达雅"
				},
				{
					"id": 736900117,
					"content": "只要发挥想象力，搭出一条漂亮的道路就好啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900118,
						736900120
					],
					"speakerTitle": "达雅"
				},
				{
					"id": 736900118,
					"content": "我想试试看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736900119
					]
				},
				{
					"id": 736900119,
					"content": "没问题，那么就请看向这边…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "达雅"
				},
				{
					"id": 736900120,
					"content": "还有别的事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736900121
					]
				},
				{
					"id": 736900121,
					"content": "这样啊…没关系，我们的摊位在学院游乐会期间会一直开设。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900122
					],
					"speakerTitle": "达雅"
				},
				{
					"id": 736900122,
					"content": "不管什么时候，只要你想试玩，直接过来就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "达雅"
				},
				{
					"id": 736900114,
					"content": "我没什么建筑天赋…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736900115
					]
				}
			]
		}
	]
}