			},
			"dialogs": [
				{
					"id": 752130601,
					"content": "你好，你的饮料到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752130607
					]
				},
				{
					"id": 752130607,
					"content": "噢！噢！原来你们是送饮料的啊，我说怎么这么半天没有收到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130608
					],
					"speakerTitle": "阿考"
				},
				{
					"id": 752130608,
					"content": "都怪你啦，在订单上留下「送给沙滩上蓝裤子客人」的备注，却偷偷躲在沙子里，害我们找了蓝裤子大半天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130609
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752130609,
					"content": "你应该给我们加倍的外送费！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130610
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752130610,
					"content": "啊，实在对不起，我忘记了这件事，我应该把裤子摆在一边，这样可能方便你们找到我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130611
					],
					"speakerTitle": "阿考"
				},
				{
					"id": 752130611,
					"content": "你为什么要埋在沙子里？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752130612
					]
				},
				{
					"id": 752130612,
					"content": "因为很有趣啊，我听说很多人度假的时候都会这么干，所以也想试试。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130613
					],
					"speakerTitle": "阿考"
				},
				{
					"id": 752130613,
					"content": "可你的姿势不太对吧，你看起来像是萝卜扎在地里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130614
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752130614,
					"content": "欸？这样会有什么坏处吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130615
					],
					"speakerTitle": "阿考"
				},
				{
					"id": 752130615,
					"content": "容易绊倒别人，自己也会受伤。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752130617
					]
				},
				{
					"id": 752130617,
					"content": "明白了，我会考虑的，噢，这是你们的加倍外送费，谢谢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿考"
				}
			]
		},
