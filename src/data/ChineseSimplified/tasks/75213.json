			"dialogs": [
				{
					"id": 752130201,
					"content": "需要帮忙吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752130202
					]
				},
				{
					"id": 752130202,
					"content": "欸？可以吗？小店的员工已经全派出去了，现在还有一份加急的外送订单。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130203
					],
					"speakerTitle": "哈雅库"
				},
				{
					"id": 752130203,
					"content": "订单上备注了送给一位<color=#00E1FFFF>沙滩上的蓝裤子客人</color>，只要及时送到就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130204
					],
					"speakerTitle": "哈雅库"
				},
				{
					"id": 752130204,
					"content": "实在感谢，除了这笔订单的外送费以外，小店的饮料配方也送给你当作酬金，就拜托了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "哈雅库"
				}
			]
		},
