			"dialogs": [
				{
					"id": 240010501,
					"content": "难道是巴里亚不喜欢我新写的小说？唉，明明其他人都评价不错…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010502
					],
					"speakerTitle": "诗黛"
				},
				{
					"id": 240010502,
					"content": "唉，下次我得挑一篇更好的念给它听了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "诗黛"
