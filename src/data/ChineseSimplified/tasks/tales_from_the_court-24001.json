				]
			},
			"dialogs": [
				{
					"id": 240010401,
					"content": "巴里亚！我的宝贝，天哪，你去哪里了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010402
					],
					"speakerTitle": "诗黛"
				},
				{
					"id": 240010402,
					"content": "它只是找了个清净的地方待了一会，给自己稍微放了个假。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010403
					],
					"speakerTitle": "布蕾莘"
				},
				{
					"id": 240010403,
					"content": "我真是担心得要命，谢谢你，布蕾莘警官，我的下一部小说一定会提到您！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010404
					],
					"speakerTitle": "诗黛"
				},
				{
					"id": 240010404,
					"content": "感谢您的好意，但还是请您省下这些笔墨吧，没人会对一名警官的日常生活感兴趣的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010405
					],
					"speakerTitle": "布蕾莘"
				},
				{
					"id": 240010405,
					"content": "那我就将您的故事写得跌宕起伏…保证有趣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010406
					],
					"speakerTitle": "诗黛"
				},
				{
					"id": 240010406,
					"content": "您这句有趣的承诺就足够让我的心情跌宕起伏了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010407
					],
					"speakerTitle": "布蕾莘"
				},
				{
					"id": 240010407,
					"content": "结尾还得发人深省！让我想想，给您安排个什么队友好呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "诗黛"
				}
			]
		},
