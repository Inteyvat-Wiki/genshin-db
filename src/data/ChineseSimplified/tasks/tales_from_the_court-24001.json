			"dialogs": [
				{
					"id": 240010301,
					"content": "果然在这里，看来它的情况还不错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010302
					],
					"speakerTitle": "布蕾莘"
				},
				{
					"id": 240010302,
					"content": "诗黛小姐什么时候才能意识到，小狗不喜欢歌剧，也不喜欢听她的小说呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010303
					],
					"speakerTitle": "布蕾莘"
				},
				{
					"id": 240010303,
					"content": "我们回去吧，诗黛小姐肯定等急了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "布蕾莘"
				}
