			"dialogs": [
				{
					"id": 240010101,
					"content": "请您帮帮忙吧，我刚才正在想着小说的情节，一个不留神，巴里亚就跑没影了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010102
					],
					"speakerTitle": "诗黛"
				},
				{
					"id": 240010102,
					"content": "您确定巴里亚没有被您留在歌剧院的席位上，或者是拴在卫生间门口吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010103
					],
					"speakerTitle": "布蕾莘"
				},
				{
					"id": 240010103,
					"content": "这些地方我都找过了。就连座位底下我都找了个遍，可就是没见着巴里亚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010104
					],
					"speakerTitle": "诗黛"
				},
				{
					"id": 240010104,
					"content": "我的小巴里亚，不会是被谁给拐走，或者是和谁一见钟情，懵懵懂懂地就跟着走了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010105
					],
					"speakerTitle": "诗黛"
				},
				{
					"id": 240010105,
					"content": "诗黛小姐，我很确信巴里亚不会在这种事情上犯第二次错误。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010106
					],
					"speakerTitle": "布蕾莘"
				},
				{
					"id": 240010106,
					"content": "但巴里亚还那么小…年纪小就会不断地犯相同的错误，说不定巴里亚还会以此为乐啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010107
					],
					"speakerTitle": "诗黛"
				},
				{
					"id": 240010107,
					"content": "巴里亚的年纪一定没有您认知中的那么小。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010108,
						240010109
					],
					"speakerTitle": "布蕾莘"
				},
				{
					"id": 240010108,
					"content": "巴里亚是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240010110
					]
				},
				{
					"id": 240010110,
					"content": "诗黛小姐的小狗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010111
					],
					"speakerTitle": "布蕾莘"
				},
				{
					"id": 240010111,
					"content": "我的家人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010112
					],
					"speakerTitle": "诗黛"
				},
				{
					"id": 240010112,
					"content": "她的家人，刚刚走失了，她正在寻求我的帮助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010113
					],
					"speakerTitle": "布蕾莘"
				},
				{
					"id": 240010113,
					"content": "…诗黛小姐，这周围已经被咱们找了个遍，巴里亚大概已经跑去了野外。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010114
					],
					"speakerTitle": "布蕾莘"
				},
				{
					"id": 240010114,
					"content": "那咱们就去野外吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010115
					],
					"speakerTitle": "诗黛"
				},
				{
					"id": 240010115,
					"content": "我请求您待在城里，看看您的裙子，就算找到了巴里亚，您也是追不上它的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010116
					],
					"speakerTitle": "布蕾莘"
				},
				{
					"id": 240010116,
					"content": "胡说，只要听见我说话，巴里亚准会马上跑过来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010117
					],
					"speakerTitle": "诗黛"
				},
				{
					"id": 240010117,
					"content": "那咱们之前围着歌剧院嚷嚷了那么久，想必它是没听见了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010118
					],
					"speakerTitle": "布蕾莘"
				},
				{
					"id": 240010118,
					"content": "让巴里亚乖乖回到诗黛小姐身边，不是我一个人能做到的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010119
					],
					"speakerTitle": "布蕾莘"
				},
				{
					"id": 240010119,
					"content": "考虑到我的工作职责，我不可能离开岗位太久，也不可能让另外一位同事和我一起暂时离岗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010120
					],
					"speakerTitle": "布蕾莘"
				},
				{
					"id": 240010120,
					"content": "旅行者，如果您愿意的话，可以帮助一下我和诗黛小姐吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010121,
						240010122
					],
					"speakerTitle": "布蕾莘"
				},
				{
					"id": 240010121,
					"content": "倒是没问题…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240010124
					]
				},
				{
					"id": 240010124,
					"content": "那这件事就这么定了，请您和我一起去野外找找吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010125
					],
					"speakerTitle": "布蕾莘"
				},
				{
					"id": 240010125,
					"content": "考虑到巴里亚的体重和体力，它想必跑不太远。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010126
					],
					"speakerTitle": "布蕾莘"
				},
				{
					"id": 240010126,
					"content": "巴里亚可是很健康的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010127
					],
					"speakerTitle": "诗黛"
				},
				{
					"id": 240010127,
					"content": "如果您是指巴里亚的精神生活的话，我十分赞同。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010128
					],
					"speakerTitle": "布蕾莘"
				},
				{
					"id": 240010128,
					"content": "那我们就出发吧，如果让巴里亚体会到了在野外的好处，它说不定就要跑得更远了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010129
					],
					"speakerTitle": "布蕾莘"
				},
				{
					"id": 240010129,
					"content": "喂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "诗黛"
				},
				{
					"id": 240010122,
					"content": "警官还管这事啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240010123
					]
				},
				{
					"id": 240010123,
					"content": "枫丹廷的市民向我请求帮助，我没有拒绝的理由。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010124
					],
					"speakerTitle": "布蕾莘"
				},
				{
					"id": 240010109,
					"content": "有什么麻烦事吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240010110
					]
				}
			]
		},
