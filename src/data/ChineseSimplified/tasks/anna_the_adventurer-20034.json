			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"班尼特",
					"菲谢尔",
					"安娜",
					"奥兹"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200340201,
					"content": "菲谢尔，你刚才跑得太快了，很危险的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340202
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 200340202,
					"content": "本皇女的圣裁之雷，绝不会放任邪孽滋长…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340203
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 200340203,
					"content": "是菲谢尔前辈，还有班尼特前辈，你们好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340204
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200340204,
					"content": "是安娜啊，还有旅行者，你们是在这里执行协会的委托吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340205
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 200340205,
					"content": "喔！本皇女的祝圣之人啊，想来是命运的丝线，将你引至此地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340206
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 200340206,
					"content": "小姐很意外会在这种地方见到你，她很高兴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340207
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 200340207,
					"content": "我是陪着安娜出来执行委托的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200340208
					]
				},
				{
					"id": 200340208,
					"content": "是的，我和旅行者正在这里护送货运热气球呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340209
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200340209,
					"content": "可是，突然看见有一群盗宝团朝我们冲了过来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340210
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200340210,
					"content": "抱歉抱歉，这都要怪我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340211
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 200340211,
					"content": "原本我和菲谢尔接了委托，要追查一群盗宝团的下落…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340212
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 200340212,
					"content": "奥兹好不容易捕捉了对方的去向，我们正准备去捉拿的时候…我被路上的树枝绊倒，一下子就摔了出去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340213
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 200340213,
					"content": "这伙盗宝团发现动静，掉头就跑，我们只能在后面一直追、一直追…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340214
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 200340214,
					"content": "无须烦忧。苍紫的罚罪之光，注定裁断恶徒的命运。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340215
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 200340215,
					"content": "但小姐，真正出手抓住恶徒的，是旅行者…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340216
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 200340216,
					"content": "奥，奥兹！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340217
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 200340217,
					"content": "话，话说回来，这次真要好好谢谢你们了，多亏有你们在前面拦着！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340218
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 200340218,
					"content": "看来，我今天的运气还是挺好的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340219
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 200340219,
					"content": "能帮上忙就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200340220
					]
				},
				{
					"id": 200340220,
					"content": "嘿嘿，那我们先带着这群盗宝团回协会去了，你们执行委托路上也要小心啊，尤其是注意脚下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "班尼特"
				}
			]
		},
