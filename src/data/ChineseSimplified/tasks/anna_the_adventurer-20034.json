			"dialogs": [
				{
					"id": 200340301,
					"content": "班尼特前辈，还是一如既往地可靠呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340302
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200340302,
					"content": "菲谢尔前辈…她说的话也一如既往地很有气势！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340303,
						200340308
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200340303,
					"content": "关于班尼特。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200340304
					]
				},
				{
					"id": 200340304,
					"content": "你说班尼特前辈？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340305
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200340305,
					"content": "我刚进入协会的时候，班尼特前辈给我解答了很多问题，也帮了我不少忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340306
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200340306,
					"content": "但我听说，班尼特前辈的运气一直很差。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340307
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200340307,
					"content": "真是不公平啊，明明是那么好的人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340313
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200340313,
					"content": "呼…这样子委托也完成了，谢谢你旅行者，我这就回去协会报告啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340314
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200340314,
					"content": "不过，为什么我连续几天都是在护送热气球…协会里没有别的委托了吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安娜"
				},
				{
					"id": 200340308,
					"content": "关于菲谢尔。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200340309
					]
				},
				{
					"id": 200340309,
					"content": "菲谢尔前辈…嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340310
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200340310,
					"content": "她、她也很可靠喔！箭法很好，也执行过很多委托。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340311
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200340311,
					"content": "虽然她说的那些话…我不太能听懂…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340312
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200340312,
					"content": "但她也是一位…一位很有经验的冒险家！不、不对，调查员！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340313
					],
					"speakerTitle": "安娜"
				}
			]
		},
		{
