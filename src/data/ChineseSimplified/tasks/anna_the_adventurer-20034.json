			"dialogs": [
				{
					"id": 200340101,
					"content": "好…今天也要努力完成委托！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340102,
						200340106
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200340102,
					"content": "真是有干劲啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200340103
					]
				},
				{
					"id": 200340103,
					"content": "那是当然了，做冒险家可是很有趣的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340104
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200340104,
					"content": "不过…嘿嘿，我执行委托的时候，还是有很多事不熟悉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340105
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200340105,
					"content": "旅行者，能请你再陪我去执行一下委托吗？我还有事想要请教你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340108
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200340108,
					"content": "那我们就快出发吧，今天的委托是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340109
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200340109,
					"content": "嗯…又是护送货运热气球…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安娜"
				},
				{
					"id": 200340106,
					"content": "要我陪你去吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200340107
					]
				},
				{
					"id": 200340107,
					"content": "可以吗？嘿嘿，我正好有很多事想要请教你呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340108
					],
					"speakerTitle": "安娜"
				}
			]
		},
		{
