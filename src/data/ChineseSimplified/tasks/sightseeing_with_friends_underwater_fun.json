			"dialogs": [
				{
					"id": 737130101,
					"content": "锵锵！就是这里了，从一片浅滩下水，应该会有画卷慢慢展开的感觉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737130102,
					"content": "咦，是你们…还带了新伙伴？这个是…蕈兽吗？以前只在书上看到过…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130103
					],
					"speakerTitle": "玛因"
				},
				{
					"id": 737130103,
					"content": "真巧，还有美露莘在这里玩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130104,
						737130105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737130104,
					"content": "又见面啦，玛因。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737130106
					]
				},
				{
					"id": 737130106,
					"content": "不是玩哦，是在采汐藻，准备制作今年份的腌制汐藻，许多姐姐妹妹都回到了村里帮忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130107
					],
					"speakerTitle": "玛因"
				},
				{
					"id": 737130107,
					"content": "昂吉安妮大姐头和小萝克珊都请假回来了，现在正忙活呢，待会儿我也要下水了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130108
					],
					"speakerTitle": "玛因"
				},
				{
					"id": 737130108,
					"content": "说起来，昂吉安妮大姐头没说错，蓝色的蕈兽还真的有点像汐藻…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130109
					],
					"speakerTitle": "玛因"
				},
				{
					"id": 737130109,
					"content": "我的意思是，很招人喜欢，没有想吃的意思…嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130110
					],
					"speakerTitle": "玛因"
				},
				{
					"id": 737130110,
					"content": "♫♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130111
					],
					"speakerTitle": "咚咚小圆帽"
				},
				{
					"id": 737130111,
					"content": "嘿嘿，你很有眼光嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130112,
						737130113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737130112,
					"content": "蕈兽伙伴确实可爱。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737130114
					]
				},
				{
					"id": 737130114,
					"content": "总而言之，很高兴遇见你们，我要去干活了，也祝你们在附近玩得开心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130115
					],
					"speakerTitle": "玛因"
				},
				{
					"id": 737130115,
					"content": "那我们也出发吧？和蕈兽伙伴们好好拍拍枫丹水下的漂亮景观！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737130113,
					"content": "美露莘们也都不赖。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737130114
					]
				},
				{
					"id": 737130105,
					"content": "你好呀，没见过的美露莘。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737130106
					]
				}
			]
		}
	]
