			"dialogs": [
				{
					"id": 50220701,
					"content": "（穿过光墙的那一刹那，身体仿佛被冻结了一样。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220702
					]
				},
				{
					"id": 50220702,
					"content": "（夜神的庇护似乎无法触达这里，冰冷与黑暗钻入五官，耳边全都是疲惫而痛苦的叹息。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220703
					]
				},
				{
					"id": 50220703,
					"content": "（他们不知道已经走了多久，不知道还要走多久…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220704
					]
				},
				{
					"id": 50220704,
					"content": "（欸，那个人是…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220705
					]
				},
				{
					"id": 50220705,
					"content": "故乡迢远，战火肆燃，我等已流尽最后的鲜血。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50220706
					],
					"speakerTitle": "「队长」"
				},
				{
					"id": 50220706,
					"content": "再等一等，战士们啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50220707
					],
					"speakerTitle": "「队长」"
				},
				{
					"id": 50220707,
					"content": "（为什么「队长」会在这里？他在说什么…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220708
					]
				},
				{
					"id": 50220708,
					"content": "终有一日，我会将你们带到约定的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「队长」"
				}
			]
		},
