			},
			"dialogs": [
				{
					"id": 50220401,
					"content": "（这里是什么地方？难道说…是夜神之国？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220402
					]
				},
				{
					"id": 50220402,
					"content": "（我为什么会在这里？刚才我分明是在…呃…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220403
					]
				},
				{
					"id": 50220403,
					"content": "（头昏沉沉的，没办法正常思考。先到附近走一走吧。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
