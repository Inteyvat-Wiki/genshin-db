			"dialogs": [
				{
					"id": 700200102,
					"content": "Odomu! Ya dala?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200103
					],
					"speakerTitle": "丘丘人"
				},
				{
					"id": 700200103,
					"content": "等等，让我来处理吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200104
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 700200104,
					"content": "Mimi tomo, Odomu nye! Muhe mani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200105
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 700200105,
					"content": "Mani? Mani! Yoyo mani mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200106
					],
					"speakerTitle": "丘丘人"
				},
				{
					"id": 700200106,
					"content": "Dada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200107
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 700200107,
					"content": "Dada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200108,
						700200109
					],
					"speakerTitle": "丘丘人"
				},
				{
					"id": 700200108,
					"content": "好像很顺利呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700200110
					]
				},
				{
					"id": 700200110,
					"content": "我在问它是否需要帮助，看样子它果然需要我们帮忙呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200111
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 700200111,
					"content": "Dada odomu! Kundala dada! Kundala zido, mi dada! Muhe yeye!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200112
					],
					"speakerTitle": "丘丘人"
				},
				{
					"id": 700200112,
					"content": "呃…它的意思大概是，需要我们去帮助它打败…强大的敌人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200113
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 700200113,
					"content": "Ya zido? Ye? Mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200114
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 700200114,
					"content": "Mi! Mi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200115
					],
					"speakerTitle": "丘丘人"
				},
				{
					"id": 700200115,
					"content": "好的，那家伙的位置已经标在地图上了，接下来看你的咯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200116
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 700200116,
					"content": "Dada, Valo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "丘丘人"
				},
				{
					"id": 700200109,
					"content": "你们在说什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700200110
					]
				}
			]
		},
