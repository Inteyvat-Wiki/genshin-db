			"dialogs": [
				{
					"id": 700200208,
					"content": "似乎它想要告诉我们什么东西的样子…是有关那个奇怪的丘丘人的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200201
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700200201,
					"content": "Yeye dada! Mosi mita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200202
					],
					"speakerTitle": "丘丘人"
				},
				{
					"id": 700200202,
					"content": "Odomu tomo zido mi! Mi mani yeye! <color=#00E1FFFF>Unta nunu</color>！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200203
					],
					"speakerTitle": "丘丘人"
				},
				{
					"id": 700200204,
					"content": "呃…谢谢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700200206
					]
				},
				{
					"id": 700200205,
					"content": "Tomo, valo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700200206
					]
				},
				{
					"id": 700200203,
					"content": "<color=#00E1FFFF>Unta nunu</color>…好像和时间什么的有关系…别忘了查查手册吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200204,
						700200205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700200206,
					"content": "Valo, tomo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200207
					],
					"speakerTitle": "丘丘人"
				},
				{
