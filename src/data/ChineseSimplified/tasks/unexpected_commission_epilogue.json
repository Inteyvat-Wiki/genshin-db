				"points": []
			},
			"dialogs": [
				{
					"id": 706900301,
					"content": "嗯？居然这么快就把所有书都整理好了，超出我的预期了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900302
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 706900302,
					"content": "小可爱想要什么奖励吗？多亏了你们，才空出来了一整个下午，用来陪你的话也不错呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900303,
						706900305
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 706900303,
					"content": "关于我的报酬…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706900304
					]
				},
				{
					"id": 706900304,
					"content": "只想要这个？别着急，报酬我不会忘的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900306
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 706900306,
					"content": "你们也发现了吧，这批书从名字到内容都很奇怪呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900307
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 706900307,
					"content": "而且按理来说，这里作为北陆最大的图书馆，不可能会收到这么多连名字都没听过的新书。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900308
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 706900308,
					"content": "除非…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900309
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 706900309,
					"content": "其实刚才我们遇到了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706900310,
					"content": "呵呵，看起来是一些我不太想知道的麻烦事呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900311
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 706900311,
					"content": "不管怎么说，既然是已经存在于这个世界上的书籍，就有将其收藏在图书馆的必要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900312
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 706900312,
					"content": "放在这里，总比让它们流传在外面，落入什么奇怪的人手里要好得多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900313
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 706900313,
					"content": "报酬在这里，这次也辛苦你们啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "丽莎"
				},
				{
					"id": 706900305,
					"content": "关于这些书…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706900306
					]
				}
			]
		}
	]
}