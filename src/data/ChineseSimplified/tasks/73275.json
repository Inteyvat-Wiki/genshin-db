			"dialogs": [
				{
					"id": 732750102,
					"content": "种出了金蔷薇花苗。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732750103
					]
				},
				{
					"id": 732750103,
					"content": "这些…嘿哟，你这小娃娃是在哪里找到这些花种的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750104
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732750104,
					"content": "在很远的地方捡到的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732750105
					]
				},
				{
					"id": 732750105,
					"content": "沙法卡特叔叔撒下的种子还真是去到了沙漠的各个角落，不过最后兜兜转转又回到这里来喽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750107
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732750107,
					"content": "这些花苗可得小心保存啊，我都要留给赛芭那孩子的。等到我也不在了，这些花就交给她了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750108
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732750108,
					"content": "孩子，谢谢你，我没什么好东西给你，就把这些果子和花送给你吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿凡"
				}
			]
		},
