						732750308
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732750308,
					"content": "你帮了我老头的大忙，虽然你这孩子没跟我要报酬，但我要是不给心里可过意不去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750309
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732750309,
					"content": "这株花苗最近刚刚破土，赛芭提议把它送给你，还费心把它装了起来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750310
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732750310,
					"content": "我们把它当作纪念送给你，希望你像它一样坚韧，永远不丧失信心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿凡"
