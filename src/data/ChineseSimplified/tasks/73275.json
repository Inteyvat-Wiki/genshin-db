			"dialogs": [
				{
					"id": 732750501,
					"content": "关于歌谣…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732750502
					]
				},
				{
					"id": 732750502,
					"content": "你还记得这首歌谣啊…又有一个年轻人记住了它，呵呵，是好事啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750503
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732750503,
					"content": "「蔷薇啊蔷薇，实现我的愿望。花从石头中绽放，金蔷薇对我歌唱。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750504
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732750504,
					"content": "「没有土地承载我，唯有歌谣承载我。歌谣战胜敌视我的命运，战胜我的结局。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750505
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732750505,
					"content": "「战胜我战胜时间，战胜永不消逝的消逝…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿凡"
				}
			]
		},
