			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790461101,
					"content": "来自喇叭的旁白继续描述着眼前的神奇景象——\\n两位智者将药剂轻轻滴在水形幻灵的石像上，奇妙的现象发生了…\\n时间仿佛发生了倒转，石化的水形幻灵恢复如初…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						790461102
					]
				},
				{
					"id": 790461102,
					"content": "呜…原来彻底变成石头是这样的感觉…好难受好难受，不能让同伴们继续忍受这种委屈了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461103
					],
					"speakerTitle": "落单的水形幻灵"
				},
				{
					"id": 790461103,
					"content": "「小水珠」，你怎么一声不吭就冲了上去，吓死我了啦！还好我们马上就拿到了解药…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790461104,
					"content": "刚才那些幽魂一直在怪叫，我好害怕，完全不敢说话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461105
					],
					"speakerTitle": "落单的水形幻灵"
				},
				{
					"id": 790461105,
					"content": "而且你们是智者，我觉得，根本不用我来提醒你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461106
					],
					"speakerTitle": "落单的水形幻灵"
				},
				{
					"id": 790461106,
					"content": "就算我彻底变成了石头，拿到解药后，你们也会第一时间救我的，和之前没什么区别，不用这么焦急！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461107
					],
					"speakerTitle": "落单的水形幻灵"
				},
				{
					"id": 790461107,
					"content": "呃啊…难道，难道是我太投入了吗？只顾着担心「小水珠」了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461108,
						790461109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790461108,
					"content": "投入也是好事哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790461110
					]
				},
				{
					"id": 790461110,
					"content": "噫！明明是来玩的游客，自己却演上头了，有点难为情…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790461111,
					"content": "总之…我们已经成功了，接下来，你就拿着这份解药，去拯救你的同伴吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790461112,
					"content": "谢谢，太谢谢你们了，我…无比感激你们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461113
					],
					"speakerTitle": "落单的水形幻灵"
				},
				{
					"id": 790461113,
					"content": "我和伙伴们会一直牢记你们的恩情的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461114,
						790461115
					],
					"speakerTitle": "落单的水形幻灵"
				},
				{
					"id": 790461114,
					"content": "没事没事！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790461116
					]
				},
				{
					"id": 790461116,
					"content": "也不知道那些坏家伙会不会继续捣乱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790461117,
					"content": "你们以后在森林里玩的时候，还要小心一点，不要再到这个古堡来了哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790461118,
					"content": "可喜可贺，可喜可贺！两位智者无懈可击的计策与水形幻灵的勇气形成了完美的配合，幽魂魔咒的危机即将被彻底解除！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461119
					],
					"speakerTitle": "来自喇叭的旁白"
				},
				{
					"id": 790461119,
					"content": "智者们的到来让幽魂们不敢再肆意妄为，落单的水形幻灵和伙伴们又可以无忧无虑地玩耍了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461120
					],
					"speakerTitle": "来自喇叭的旁白"
				},
				{
					"id": 790461120,
					"content": "原本阴森诡异的密林，渐渐展现出了寂静与祥和的一面…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461121
					],
					"speakerTitle": "来自喇叭的旁白"
				},
				{
					"id": 790461121,
					"content": "「瞳孔里的固形魔咒」全剧终，感谢您的观看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461122
					],
					"speakerTitle": "来自喇叭的旁白"
				},
				{
					"id": 790461122,
					"content": "好了，我们完成了「瞳孔里的固形魔咒」！代入感还不错嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790461123,
					"content": "这样看来，如果台词和旁白合适，确实能影响观众的情绪呢…黛依阿究竟是从哪些地方学到的这些手法？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790461124,
					"content": "如果有机会见到黛依阿，我们仔细问问她吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790461115,
					"content": "不用客气！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790461116
					]
				},
				{
					"id": 790461109,
					"content": "说明派蒙很享受！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790461110
					]
				}
			]
		},
