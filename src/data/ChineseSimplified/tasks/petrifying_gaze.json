			"dialogs": [
				{
					"id": 790460101,
					"content": "参演人员已就位，所有机关运转正常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460102
					],
					"speakerTitle": "乐园告示喇叭"
				},
				{
					"id": 790460102,
					"content": "「黛依阿的三日遐想」之「瞳孔里的固形魔咒」，正式开幕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460103
					],
					"speakerTitle": "乐园告示喇叭"
				},
				{
					"id": 790460103,
					"content": "在幽深诡异的密林边缘，两位兼具学识与胆量的智者，发现了一位落单的水形幻灵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460104
					],
					"speakerTitle": "来自喇叭的旁白"
				},
				{
					"id": 790460104,
					"content": "谁来帮帮我…我不想抛弃我的伙伴…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460105
					],
					"speakerTitle": "落单的水形幻灵"
				},
				{
					"id": 790460105,
					"content": "「小水珠」？「小水珠」居然说话了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460106,
						790460107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790460106,
					"content": "其实是喇叭在代它说话吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460108
					]
				},
				{
					"id": 790460108,
					"content": "原来如此，这位「小水珠」就是话剧里的关键演员了，要和我们配合？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790460109,
					"content": "真是万幸，两位智者对于水形幻灵的言语早有研究，听懂了水形幻灵的求助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460110
					],
					"speakerTitle": "来自喇叭的旁白"
				},
				{
					"id": 790460110,
					"content": "这简直是命运的安排！如此令人感动的相逢，岂有不帮水形幻灵的道理？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460111
					],
					"speakerTitle": "来自喇叭的旁白"
				},
				{
					"id": 790460111,
					"content": "我们也有新的设定吗？听起来蛮厉害的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460112,
						790460113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790460112,
					"content": "还是言归正传吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460114
					]
				},
				{
					"id": 790460114,
					"content": "我们…我们在森林里迷路时，找到了一座古堡，不小心吵醒了古堡里的幽魂…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460115
					],
					"speakerTitle": "落单的水形幻灵"
				},
				{
					"id": 790460115,
					"content": "两个幽魂头领对我们降下了…魔咒，只要被幽魂们看见，就会变成石头！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460116
					],
					"speakerTitle": "落单的水形幻灵"
				},
				{
					"id": 790460116,
					"content": "我好不容易才逃出来，但其他同伴都…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460117
					],
					"speakerTitle": "落单的水形幻灵"
				},
				{
					"id": 790460117,
					"content": "呜…他们一定很痛苦…这是我们的错吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460118
					],
					"speakerTitle": "落单的水形幻灵"
				},
				{
					"id": 790460118,
					"content": "当然不是了，就算有起床气，也不能这样欺负人家吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790460119,
					"content": "可恶…把迷路的「小水珠」变成石头这种事，已经不是欺负的程度了，那些幽魂都是超级坏家伙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460120,
						790460121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790460120,
					"content": "把它们狠狠修理一顿的话…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460122
					]
				},
				{
					"id": 790460122,
					"content": "不行的，两个幽魂头领从来不露面，古堡又很大，本领再强的人都没法找到它们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460123
					],
					"speakerTitle": "落单的水形幻灵"
				},
				{
					"id": 790460123,
					"content": "但我听其中一个幽魂说，古堡深处的宝箱里，有着破除魔咒的古老药剂，那是唯一的希望…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460124
					],
					"speakerTitle": "落单的水形幻灵"
				},
				{
					"id": 790460124,
					"content": "宝箱被锁在一间密室里，还需要找到附近的钥匙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460125
					],
					"speakerTitle": "落单的水形幻灵"
				},
				{
					"id": 790460125,
					"content": "可是，我已经中了魔咒，独自回到古堡的话，肯定会被其他幽魂盯上，慢慢石化，最后永远被固定住…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460126
					],
					"speakerTitle": "落单的水形幻灵"
				},
				{
					"id": 790460126,
					"content": "那也没什么难的嘛！就由我们来护送你，回到古堡里去寻找钥匙，拿到最关键的药剂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790460127,
					"content": "只要帮你避开那些什么…幽魂的视线，应该就没问题了吧？听起来不算难嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790460128,
					"content": "没错，你们是…智者，你们应该有办法…求求你们了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460129,
						790460130
					],
					"speakerTitle": "落单的水形幻灵"
				},
				{
					"id": 790460129,
					"content": "派蒙很快就进入了角色嘛。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460131
					]
				},
				{
					"id": 790460131,
					"content": "嘿嘿，听起来还挺简单的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790460132,
					"content": "虽然不能把幕后黑手揍一顿，但你可以打趴所有幽魂，帮「小水珠」救出同伴还不是轻轻松松！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790460133,
					"content": "放心吧，「小水珠」，我们一起出发，找到那个药剂，解除你身上的魔咒，救出你的伙伴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790460130,
					"content": "准确猜到了剧情的走向哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460131
					]
				},
				{
					"id": 790460121,
					"content": "是不是就能救出你的同伴？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460122
					]
				},
				{
					"id": 790460113,
					"content": "你的同伴怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460114
					]
				},
				{
					"id": 790460107,
					"content": "当成「小水珠」的台词就行。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460108
					]
				}
			]
		},
