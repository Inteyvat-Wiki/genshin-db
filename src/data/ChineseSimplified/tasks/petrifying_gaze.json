					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790461001,
					"content": "可恶，根本不可能躲开这一大片视线，这是耍赖，耍赖！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461002
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790461002,
					"content": "好想把那些幽魂的机关一脚踢翻！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461003
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790461003,
					"content": "等等，「小水珠」，你要干什么？那边是幽魂的视野，危险！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461004
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790461004,
					"content": "吵闹的家伙，你疯了吗？还是你已经放弃希望了，想要和你的同伴在另一个世界相见？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461005
					],
					"speakerTitle": "愤怒的幽魂头领"
				},
				{
					"id": 790461005,
					"content": "不对，它要用身体遮挡视线…怎么会有这么古典的献身思想！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461006
					],
					"speakerTitle": "愉悦的幽魂头领"
				},
				{
					"id": 790461006,
					"content": "事态出现了转机！落单的水形幻灵拦在了幽魂前方，慢慢化为了石像，用自己的身体挡住了致命的视线！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461007
					],
					"speakerTitle": "来自喇叭的旁白"
				},
				{
					"id": 790461007,
					"content": "「小水珠」…主动变成石头了…全都是为了让我们拿到钥匙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461008,
						790461009
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790461008,
					"content": "「小水珠」还能恢复！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790461010
					]
				},
				{
					"id": 790461010,
					"content": "对，对哦！只要被幽魂盯住的时间不长，应该没有问题的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461011
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790461011,
					"content": "难道「小水珠」反过来利用了这一点？好聪明，好勇敢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461012
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790461012,
					"content": "#{NICKNAME}，我们赶快去找钥匙，拿回解药，不要让「小水珠」难受太久！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790461009,
					"content": "我们要抓紧时间！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790461010
					]
				}
			]
		},
		{
			"id": 7904611,
			"completionStepIds": [
				7904612
			],
