					"夏萝·努伊"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250270301,
					"content": "哇！又有新唱片了，龙宝宝们肯定会很开心的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270302
					],
					"speakerTitle": "夏萝·努伊"
				},
				{
					"id": 250270302,
					"content": "关于米卢·努伊的唱片…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270303
					]
				},
				{
					"id": 250270303,
					"content": "我很喜欢米卢叔叔作的曲子，而且，我家的龙宝宝比我更喜欢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270304
					],
					"speakerTitle": "夏萝·努伊"
				},
				{
					"id": 250270304,
					"content": "每次它闹腾的时候，妈妈就放米卢叔叔的歌，它一听见曲子就会马上安静下来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270305
					],
					"speakerTitle": "夏萝·努伊"
				},
				{
					"id": 250270305,
					"content": "唔，可是那些歌都好长好长，我都记不住歌词，没法唱歌给我家的龙宝宝听…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270306
					],
					"speakerTitle": "夏萝·努伊"
				},
				{
					"id": 250270306,
					"content": "嘿嘿，要是米卢叔叔能把歌词写短一点就好了，这样我天天都能唱歌给它听！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夏萝·努伊"
				}
			]
		},
