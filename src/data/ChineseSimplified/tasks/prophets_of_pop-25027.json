						250271602
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250271602,
					"content": "你的音乐理想怎么样了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250271603
					]
				},
				{
					"id": 250271603,
					"content": "#{NICKNAME}，很高兴再见到你。您问我的音乐理想，我只能说…我正在努力寻求突破。",
