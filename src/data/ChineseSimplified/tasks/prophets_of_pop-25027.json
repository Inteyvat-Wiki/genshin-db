			"dialogs": [
				{
					"id": 250270401,
					"content": "瞧瞧前面那群鸟，太棒了！它的叫声…说不定能用作素材。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270402
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250270402,
					"content": "但是，只有几只的话…它们的叫声还是太过单薄。如果之后能找到一整个族群，录下它们的整体叫声就好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270403
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250270403,
					"content": "等等，前面是鳍游龙群。听见它用爪子抓挠石头的声音了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270404
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250270404,
					"content": "…它很敏感，咱们不能靠近。之后我会请部族里的专业人士来帮我取材。他们肯定能搞定这件事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270405
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250270405,
					"content": "那是…正在比试的部族战士啊。不错，不错，这种真实的打斗声听起来非常好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270406
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250270406,
					"content": "喂！旁边的是谁，要干什么！讨打是吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270407
					],
					"speakerTitle": "暴躁的部族战士"
				},
				{
					"id": 250270407,
					"content": "我们正在取…材…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270408
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250270408,
					"content": "取材？那我就让你取个痛快！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270409
					],
					"speakerTitle": "暴躁的部族战士"
				},
				{
					"id": 250270409,
					"content": "#救，救命啊！{NICKNAME}，快拦住他！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "米卢·努伊"
				}
			]
		},
