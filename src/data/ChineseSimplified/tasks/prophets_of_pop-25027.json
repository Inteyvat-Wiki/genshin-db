				"objectNames": [
					"马西娜·努伊"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250270201,
					"content": "米卢先生又发出新唱片了。到底买不买呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270202
					],
					"speakerTitle": "马西娜·努伊"
				},
				{
					"id": 250270202,
					"content": "关于米卢·努伊的唱片…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270203
					]
				},
				{
					"id": 250270203,
					"content": "欸？他的唱片很好呀。夏萝和龙宝宝都很喜欢听呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270204
					],
					"speakerTitle": "马西娜·努伊"
				},
				{
					"id": 250270204,
					"content": "每当她们淘气不愿意睡觉的时候，我都会放米卢先生的那首《颂春日》给她们听。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270205
					],
					"speakerTitle": "马西娜·努伊"
				},
				{
					"id": 250270205,
					"content": "她们听着听着，就会乖乖睡着，而且睡得可好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270206
					],
					"speakerTitle": "马西娜·努伊"
				},
				{
					"id": 250270206,
					"content": "哎呀…但夏萝一直说，自己喜欢更激烈一些的曲子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270207
					],
					"speakerTitle": "马西娜·努伊"
				},
				{
					"id": 250270207,
					"content": "要是米卢先生能创作出几首更热闹的歌就好了。那样她肯定会玩得更开心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "马西娜·努伊"
				}
			]
		},
		{
