			"trigger": {
				"objectNames": [
					"米卢·努伊"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250270101,
					"content": "帕卡这小子…真是没法交流！他就不理解我的音乐理想！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270102,
						250270103
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250270102,
					"content": "发生什么事了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270104
					]
				},
				{
					"id": 250270104,
					"content": "嚯，看起来你是一位…旅行者？向您问好，我是米卢·努伊，一名音乐家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270105
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250270105,
					"content": "如果你去过「花歌唱片店」的话，一定在流行区见到过我所创作的唱片。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270106
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250270106,
					"content": "那份唱片里，包含着我对于「流行」的理解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270107
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250270107,
					"content": "只有帕卡那小子没法理解我，非要说我的音乐比起「流行乐」更像是「儿歌」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270108
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250270108,
					"content": "无论我怎么坚持，他都要把我的唱片放进儿歌区！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270109
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250270109,
					"content": "虽然…孩子们确实很喜欢啦，也有一些父母买回去给他们做礼物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270110
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250270110,
					"content": "但，但是孩子们是最敏锐的听众！整个部族里也有不少孩子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270111
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250270111,
					"content": "我的唱片在那么多孩子里流行，我认为！完全可以把它放进流行区！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270112,
						250270113
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250270112,
					"content": "你说的…有点道理…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270114
					]
				},
				{
					"id": 250270114,
					"content": "对吧？哼，我就知道是帕卡不识货。等我创作好这首新歌，他一定会被我折服！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270115
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250270115,
					"content": "我是不相信他对音乐的品味了…这位旅行者，请问您对音乐了解如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270116
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250270116,
					"content": "呃…音乐的话…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270117
					]
				},
				{
					"id": 250270117,
					"content": "您会操作乐器吗？会唱歌也行，会哼哼也算！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270118,
						250270120
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250270118,
					"content": "我都很擅长。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270119
					]
				},
				{
					"id": 250270119,
					"content": "那太好了！您一定能理解我的音乐理念！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270122
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250270122,
					"content": "我正需要一个像您这样的人，来帮助我制作全新的歌曲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270123
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250270123,
					"content": "放心，我会为您准备充分的报酬，绝对不会让您白做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270124
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250270124,
					"content": "来吧，用您的直觉告诉我。您认为，我首先应该怎么做，才能制作出一首优秀的音乐？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250270120,
					"content": "根本不会啦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270121
					]
				},
				{
					"id": 250270121,
					"content": "没关系！像您这样的人，才能真正地用心享受音乐。您评判音乐的时候，一定能够更加客观公正。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270122
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250270113,
					"content": "确实能算是「儿童流行乐」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270114
					]
				},
				{
					"id": 250270103,
					"content": "你的音乐理想是什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270104
					]
				}
			]
		},
		{
			"id": 2502702,
