					"阿瑠"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722270101,
					"content": "#{NICKNAME}{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}战斗的样子，好帅气！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270102
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722270102,
					"content": "原来阿瑠在这里啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270103,
						722270104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722270103,
					"content": "没事吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270105
					]
				},
				{
					"id": 722270105,
					"content": "我没事喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270106
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722270106,
					"content": "那些魔物…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270108
					]
				},
				{
					"id": 722270108,
					"content": "不知道这些怪物是什么地方来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270109
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722270109,
					"content": "的确，看起来不像是这里的生物呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722270110,
					"content": "嗯。以前，我们这里是没有这些东西的，也没有那些身上很多毛的人和大机器人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270111
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722270111,
					"content": "以前，我们这里有一种叫「鹈猿兽」的动物。但是它很温顺，而且也很好吃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270112
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722270112,
					"content": "没听说过。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270113
					]
				},
				{
					"id": 722270113,
					"content": "我想也是呢。在我们这里，从什么时候开始，鹈猿兽都消失了，这些家伙却出现了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270114
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722270114,
					"content": "不知道是不是从「雾海」外面来的呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270115
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722270115,
					"content": "外面也有丘丘人之类的魔物。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270116
					]
				},
				{
					"id": 722270116,
					"content": "听起来好危险…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270117,
						722270119
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722270117,
					"content": "确实很危险。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270118
					]
				},
				{
					"id": 722270118,
					"content": "不过，冒险的经历也很有趣呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722270120,
					"content": "我也好想冒险哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270121
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722270121,
					"content": "那阿瑠要好好长大，然后变成了不起的冒险家！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722270122,
					"content": "嗯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270123
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722270123,
					"content": "那这座栖木也交给我们吧。毕竟有魔物，阿瑠到处乱跑的话会很危险的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722270124,
					"content": "交给我们吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 722270119,
					"content": "不过，冒险很有趣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270120
					]
				},
				{
					"id": 722270104,
					"content": "没受伤吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270105
					]
				}
			]
		},
		{
			"id": 7222702,
