			},
			"dialogs": [
				{
					"id": 722270201,
					"content": "#我要快点长大，然后变成像{NICKNAME}{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}一样的冒险家！",
					"roleType": "TALK_ROLE_NPC",
