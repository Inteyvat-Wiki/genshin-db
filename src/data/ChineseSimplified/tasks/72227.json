			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿瑠"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722270301,
					"content": "这座栖木也好了呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722270302,
					"content": "太厉害了！这就是真正的冒险家吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270303
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722270303,
					"content": "唔…之前也有别人来过这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270304
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722270304,
					"content": "#但是，都不如{NICKNAME}{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}和派蒙这么厉害！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270305
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722270305,
					"content": "别人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722270306,
					"content": "嗯，他们是来找木簧笛的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270307,
						722270308
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722270307,
					"content": "难道是墨田…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270309
					]
				},
				{
					"id": 722270309,
					"content": "不过，木簧笛到底是什么呀？虽然之前听说是鹤观人的乐器…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722270310,
					"content": "嗯~的确是一种能发出声音的装置哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270311
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722270311,
					"content": "因为雾海，我们这不是很难看清楚东西吗？所以大家就会用木簧笛来传达自己的位置。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270312
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722270312,
					"content": "毕竟靠喊的太吵啦！而且对嗓子不好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270313
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722270313,
					"content": "确实什么都看不见呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722270314,
					"content": "对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270315
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722270315,
					"content": "爸…又爷爷还说，木簧笛的声音可以让迷失在雾里的灵魂找到回家的路。所以是很重要的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270316
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722270316,
					"content": "嗯？原来这么重要吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722270317,
					"content": "难怪祭典会需要。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270318
					]
				},
				{
					"id": 722270318,
					"content": "#嗯，祭典一定能让{NICKNAME}{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}和派蒙开心的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270319
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722270319,
					"content": "你们先走吧！我还想在树下待一会儿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270320
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722270320,
					"content": "没问题吗？外面可能有魔物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270321
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722270321,
					"content": "没问题的哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722270308,
					"content": "难怪凯瑟琳小姐说是高难度委托…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270309
					]
				}
			]
		},
