			"dialogs": [
				{
					"id": 730030501,
					"content": "#优丹？为什么你会…还有{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030502
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730030502,
					"content": "事情紧急，我们长话短说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730030503,
					"content": "简要说明了事情原委。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730030504
					]
				},
				{
					"id": 730030504,
					"content": "…我明白了。优丹，你好好休息一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030505
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730030505,
					"content": "嗯。对不起，艾方索哥哥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030506
					],
					"speakerTitle": "优丹"
				},
				{
					"id": 730030506,
					"content": "#没关系，你没事就好…{NICKNAME}，你等我一下。我准备一些药物，马上跟你们去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030507
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730030507,
					"content": "没时间了。位置在这，你自己去。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030508
					]
				},
				{
					"id": 730030508,
					"content": "嗯，我们得赶快回去看着拉娜才行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030509
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730030509,
					"content": "哎，等等…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾方索"
				}
			]
