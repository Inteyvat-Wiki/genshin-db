					"content": "拉娜，真的不要紧吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030803
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730030803,
					"content": "我们去找人帮忙…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030804
