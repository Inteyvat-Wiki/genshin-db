					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730030301,
					"content": "呼…呼…总算好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030302
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730030302,
					"content": "拉娜姐姐…呜呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030303
					],
					"speakerTitle": "优丹"
				},
				{
					"id": 730030303,
					"content": "优丹…你是男子汉，不要哭哦。你看……姐姐可以把在死域里的感觉…告诉他们…教令院的学者，然后，他们就能解决死域…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030304
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730030304,
					"content": "#而且…你看到了吗…拉娜姐姐战斗的样子，不…{NICKNAME}{M#哥哥}{F#姐姐}战斗的样子，你要谢谢{M#他}{F#她}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030305
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730030305,
					"content": "拉娜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030306,
						730030308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730030306,
					"content": "别说了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030307
					]
				},
				{
					"id": 730030307,
					"content": "拉娜，你先休息一下吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730030309,
					"content": "哈…哈哈…没关系，我只是觉得有点头晕，有点累…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030310
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730030310,
					"content": "拉娜姐姐…对不起…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030311
					],
					"speakerTitle": "优丹"
				},
				{
					"id": 730030311,
					"content": "说…说什么呢，你可是我的小老虎呀，别哭！倒是你没关系吧？优丹…有没有不舒服…？会不会觉得头晕、没力气…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030312
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730030312,
					"content": "我没事，但是拉娜姐姐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030313
					],
					"speakerTitle": "优丹"
				},
				{
					"id": 730030313,
					"content": "嗯！没关系…拉娜姐姐没关系的，毕竟我是身经百战的巡林官！我们走吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730030308,
					"content": "我去找人来帮忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030309
					]
				}
			]
		},
