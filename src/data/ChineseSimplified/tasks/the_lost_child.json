				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730030201,
					"content": "优丹…怎么会这样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030202
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730030202,
					"content": "#呜呜，拉娜姐姐…还有{M#大哥哥}{F#大姐姐}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030203
					],
					"speakerTitle": "优丹"
				},
				{
					"id": 730030203,
					"content": "欸？优丹为什么会在…死域里…而且，魔物好多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730030204,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030205,
						730030206
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730030205,
					"content": "这里就交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030207
					]
				},
				{
					"id": 730030207,
					"content": "不行…没时间了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030208
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730030208,
					"content": "#可恶，{NICKNAME}，拜托你了！我们一起上！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030209
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730030209,
					"content": "优丹你乖乖待着别动！我们来救你了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730030206,
					"content": "那个绿色的是什么…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030207
					]
				}
			]
		},
		{
			"id": 7300303,
			"completionStepIds": [
				7300306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
