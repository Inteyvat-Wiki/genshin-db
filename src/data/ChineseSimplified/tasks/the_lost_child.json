						730030705,
						730030708
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730030705,
					"content": "「兰迦拉梨」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030706
					]
				},
				{
					"id": 730030706,
					"content": "啊，对对对！就是这个！好像是说能抵抗无留陀侵蚀什么的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030707
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730030707,
					"content": "嗯。那菈聪明。兰迦拉梨，能抵御无留陀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030711
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730030711,
					"content": "哇！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030712
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730030712,
					"content": "哇！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030713,
						730030715
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730030713,
					"content": "是不是之前看到的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030714
					]
				},
				{
					"id": 730030714,
					"content": "呼…吓死我了！我还以为蔬菜在说话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030716
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730030716,
					"content": "才不是蔬菜，是兰拉娜。兰拉娜是朋友，是兰那罗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030717,
						730030722
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730030717,
					"content": "「兰那罗」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030718
					]
				},
				{
					"id": 730030718,
					"content": "欸？是说兰那罗吗？这么一看，确实是之前我们看到的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030719
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730030719,
					"content": "「兰拉娜」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030720
					]
				},
				{
					"id": 730030720,
					"content": "之前跟优丹讲故事的时候，好像听过这个名字…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030721
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730030721,
					"content": "嗯。那菈优丹是兰拉娜的朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030727
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730030727,
					"content": "#兰那罗是森林的孩子，和树生活在一起。和你，那菈{NICKNAME}不一样。你像是蒲公英的孩子，一直在旅行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030728
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730030728,
					"content": "#为什么你知道{NICKNAME}的名字？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030729
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730030729,
					"content": "兰拉娜为什么知道，不重要。但是，兰拉娜要帮助那菈拉娜，很重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030730,
						730030732
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730030730,
					"content": "那菈拉娜…好拗口…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030731
					]
				},
				{
					"id": 730030731,
					"content": "是要帮助拉娜吗？你需要我们做什么吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030733
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730030733,
					"content": "谢谢你们。你们是好那菈。她是兰拉娜的，很重要的好朋友。所以，兰拉娜会保护她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030734
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730030734,
					"content": "#但是，只是这样不够。要治好那菈拉娜，需要「惟耶之实」。那菈{NICKNAME}去「桓那兰那」，叫大家帮忙弄「惟耶之实」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030735,
						730030736
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730030735,
					"content": "「惟耶之实」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030737
					]
				},
				{
					"id": 730030737,
					"content": "那菈拉娜被无留陀侵蚀，很重。有坏虫噬咬树木的根。树会枯死、果实会腐败。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030738
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730030738,
					"content": "那菈的生命就像树木，坏虫就像无留陀。只有「惟耶之实」，能够让那菈拉娜恢复。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030739
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730030739,
					"content": "呃…总之，我们是要去一个叫「桓那兰那」的地方，想办法弄「惟耶之实」来是吧。然后，我们就能治好拉娜？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030740
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730030740,
					"content": "嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030741,
						730030744
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730030741,
					"content": "那拉娜现在的状况…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030742
					]
				},
				{
					"id": 730030742,
					"content": "不用担心。兰拉娜会在这里，抵抗无留陀的侵蚀。所以，不会变坏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030743
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730030743,
					"content": "但是，没有「惟耶之实」，也不会变好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030745
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730030745,
					"content": "顺着「森林的轨迹」，顺着水来的地方一直走，就能到达「桓那兰那」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030746
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730030746,
					"content": "然后，唱歌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030747,
						730030748
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730030747,
					"content": "唱歌？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030750
					]
				},
				{
					"id": 730030750,
					"content": "（脑海中浮现出了一段旋律…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030751
					]
				},
				{
					"id": 730030751,
					"content": "这是「大梦的曲调」。只要唱大梦的曲调，就能进入「桓那兰那」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030752
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730030752,
					"content": "进入我们的梦、我们的世界。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730030748,
					"content": "会招来骗骗花…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030749
					]
				},
				{
					"id": 730030749,
					"content": "#那菈{NICKNAME}，真风趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030750
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730030744,
					"content": "我明白了。要怎么走？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030745
					]
				},
				{
					"id": 730030736,
