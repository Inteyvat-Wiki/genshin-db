					"nextDialogs": [
						730030716
					]
				},
				{
					"id": 730030708,
					"content": "什么来着？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030709
					]
				},
				{
					"id": 730030709,
					"content": "好像是说能抵抗无留陀侵蚀什么的…名字很怪的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030710
					],
					"speakerTitle": "派蒙"
				},
				{
