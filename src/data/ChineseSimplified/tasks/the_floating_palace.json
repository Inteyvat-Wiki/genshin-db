			},
			"dialogs": [
				{
					"id": 10200101,
					"content": "看！天上那个就是「群玉阁」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200102,
						10200103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200102,
					"content": "好高啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200104
					]
				},
				{
					"id": 10200104,
					"content": "唔…唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200105,
					"content": "失策了！作为向导的我，好像并不知道通往「天上」的路在哪里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200106,
						10200107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200106,
					"content": "现在才发现这一点吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200108
					]
				},
				{
					"id": 10200108,
					"content": "呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200109,
					"content": "不过，既然要去群玉阁，那直接在地图上找群玉阁的位置，也是很合理的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200110,
					"content": "一定是在附近就有上去的办法吧？我们找找！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200107,
					"content": "当时应该问问那位叫做甘雨的使者。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200108
					]
				},
				{
					"id": 10200103,
					"content": "要怎么上去呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200104
					]
				}
			]
		},
		{
			"id": 102002,
			"completionStepIds": [
				102002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102002",
							"2"
						],
						"stepId": 102002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10200201,
					"content": "快看，这里有机关！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200202,
					"content": "既然出现在对应的位置，那肯定是跟群玉阁有关。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200203,
						10200205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200203,
					"content": "会是通往群玉阁的路吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200204
					]
				},
				{
					"id": 10200204,
					"content": "错不了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200205,
					"content": "会是普通的陷阱吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200206
					]
				},
				{
					"id": 10200206,
					"content": "怎么会？要相信我的直觉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 102004,
			"completionStepIds": [
				102004
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102004",
							"2"
						],
						"stepId": 102004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"华清"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10200401,
					"content": "站住！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200402
					],
					"speakerTitle": "华清"
				},
				{
					"id": 10200402,
					"content": "什么人，竟敢私闯重地！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200403,
						10200404
					],
					"speakerTitle": "华清"
				},
				{
					"id": 10200403,
					"content": "私闯？我们只是路过…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200405
					]
				},
				{
					"id": 10200405,
					"content": "是啊是啊，真不懂你们在说什么！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200406,
					"content": "我们是受邀来这里的，是贵客！凭什么这样对我们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200407,
					"content": "不…等一下…难道凝光…她是故意的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200408,
					"content": "她假装请我们上群玉阁，其实在这里埋伏了千岩军，想要把我们抓起来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200409,
						10200410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200409,
					"content": "我觉得不是这样…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200411
					]
				},
				{
					"id": 10200411,
					"content": "呜啊——我生气了！那边的士兵，你们这是钓鱼执法！无耻！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200412,
					"content": "什么…正常的守卫任务，怎么就无耻了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200413
					],
					"speakerTitle": "华清"
				},
				{
					"id": 10200413,
					"content": "一派胡言，总之，先把可疑人士控制起来再说！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200414
					],
					"speakerTitle": "阿阳"
				},
				{
					"id": 10200414,
					"content": "要来了，把他们统统打趴下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200410,
					"content": "还没跟他们解释邀请的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200411
					]
				},
				{
					"id": 10200404,
					"content": "重地？这里只是天衡山的野外…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200405
					]
				}
			]
		},
		{
			"id": 102006,
			"completionStepIds": [
				102006
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102006",
							"2"
						],
						"stepId": 102006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10200601,
					"content": "住手！何事喧哗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200602
					],
					"speakerTitle": "华清"
				},
				{
					"id": 10200602,
					"content": "刻晴大人，这两个怪人突然出现，似乎对归终机有所图谋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200603
					],
					"speakerTitle": "华清"
				},
				{
					"id": 10200603,
					"content": "你、你说谁是怪人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200604,
					"content": "我只是在找前往群玉阁的路。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200605
					]
				},
				{
					"id": 10200605,
					"content": "嗯？你们要上「群玉阁」？你们是谁？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200606
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200606,
					"content": "我们是受邀请的客人，想找「璃月七星」！你又是谁呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200607
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200607,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200608
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200608,
					"content": "真巧，我就是「璃月七星」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200609
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200609,
					"content": "？？？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200610
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200610,
					"content": "我是刻晴，璃月七星之一的「玉衡星」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200611
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200611,
					"content": "我知道你的事，旅行者，你是凝光的客人吧？没想到会在山间偶遇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200612
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200612,
					"content": "哇——我也没想到会在荒郊野岭遇见有钱的大人物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200613
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200613,
					"content": "天衡古城垣的归终机损坏，却在一夜之间修复完好。我在这里，原本是想调查一番。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200614
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200614,
					"content": "这些千岩军只是负责守卫现场，不是来抓人的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200615
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200615,
					"content": "原来是误会啊？嗯…真是完全没想到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200616
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200616,
					"content": "还是很容易想到的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200617
					]
				},
				{
					"id": 10200617,
					"content": "话说回来，仙人所造的机关，居然有凡人能修好。这即使对「七星」来说，也算一件奇事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200618
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200618,
					"content": "嘿嘿，那个是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200619,
						10200620
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200619,
					"content": "（嘘…别节外生枝了，派蒙。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200621
					]
				},
				{
					"id": 10200621,
					"content": "咦？啊，哦…对了，这位「玉衡」大人，你知道「天权」大人为什么要邀请我们去群玉阁吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200622
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200622,
					"content": "叫我刻晴就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200623
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200623,
					"content": "凝光约你见面，我想，无非是希望「拯救蒙德的英雄」中立一些。至少…不要完全站在仙人一方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200624
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200624,
					"content": "我们可没有站边！我们和那些仙人聊过，他们也是准备庇佑璃月的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200625
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200625,
					"content": "你说的「庇佑」，就是指那种居高临下的傲慢吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200626
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200626,
					"content": "欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200627
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200627,
					"content": "因为你们是凡民，是他们庇佑的对象，所以他们不会把你当做「有能力刺杀神明的刺客」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200628
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200628,
					"content": "所以他们一定也觉得，凝光封锁现场、盘问凡民、追捕刺客…这些命令全都是无用功，甚至是在掩盖什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200629
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200629,
					"content": "我直说了吧：这是在小看人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200630
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200630,
					"content": "你这么说，确实也有点道理…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200631
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200631,
					"content": "不过，像你这样「不敬仙神」的璃月人，我还是第一次遇见呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200632
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200632,
					"content": "哈…我是要敬他们时间观念淡薄，又对凡人心存傲慢，所以暂时还不会对我们「七星」出手吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200633
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200633,
					"content": "算了，我不该这样谈论仙人。「不敬仙神」只是我个人的态度，凝光就绝对不会说这种话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200634
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200634,
					"content": "总之，我也承认，这一次仙人们的行事，已经足够克制。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200635
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200635,
					"content": "帝君遇害，实在非比寻常。面对如此超出常理的事态，他们仍然愿意召集众仙商议、没有直接打来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200636
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200636,
					"content": "这还挺文明的，真叫人意外。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200637,
						10200638
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200637,
					"content": "所以，会有和谈的可能吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200639
					]
				},
				{
					"id": 10200639,
					"content": "凝光那个人呐…在她眼里，最好万事都能坐下商量——但这是不可能的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200640
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200640,
					"content": "「仙人」的时代已经过去了，如果连「璃月七星」都不敢正视这一点，那璃月的未来要怎么办啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200641
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200641,
					"content": "唔…又是一句非常大胆的发言呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200642
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200642,
					"content": "呼…那就言尽于此吧。其实我本来没必要说这么多，但你是很好的听众呢，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200643
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200643,
					"content": "好了，你们该去群玉阁了。要准时喔？因为求见凝光的预约，都已经排到明年了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200644
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200644,
					"content": "璃月的顶级富商们，都把「登上群玉阁」当作从商生涯的无上荣耀。人人都带着豪礼，只为从凝光手中换取些许好处。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200645
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200645,
					"content": "好、好处？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200646,
						10200647
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200646,
					"content": "派蒙，那不是重点。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200648
					]
				},
				{
					"id": 10200648,
					"content": "可是…可是！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200649
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200649,
					"content": "对了！「见面礼」也是璃月的珍贵文化，我们不是为了好处，是为了尊重璃月的传统文化…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200650
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200650,
					"content": "瞧这个派蒙殷勤的样子…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200651
					]
				},
				{
					"id": 10200651,
					"content": "好了好了，要送什么见面礼你们慢慢想，我先把去群玉阁的方法告诉你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200652
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200652,
					"content": "其实你们不必来天衡山的。回璃月港去吧，到月海亭找「引路人」，然后如此这般…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200653
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200653,
					"content": "那么，我们有缘再见吧，旅者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200654
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200654,
					"content": "嗯…那位「玉衡星」虽然不敬仙神，但我觉得她是个相当飒爽的人呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200655,
						10200656
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200655,
					"content": "我对她的印象也不错。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200657
					]
				},
				{
					"id": 10200657,
					"content": "对了，要给凝光送什么见面礼呢…我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200658
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200658,
					"content": "派蒙的重点真的变成送礼了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200659
					]
				},
				{
					"id": 10200659,
					"content": "对了！昨天我睡觉的时候，梦见了一道无比尊贵的点心——<color=#00E1FFFF>「糖霜史莱姆」</color>！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200660
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200660,
					"content": "我有预感，它很适合凝光这种身份的大富豪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200661
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200661,
					"content": "我们就用这个当作礼物吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200662,
						10200664
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200662,
					"content": "所以，有食谱吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200663
					]
				},
				{
					"id": 10200663,
					"content": "没有！但只要用「噼咔」的感觉去做就好啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200666
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200666,
					"content": "快去搜集材料！事不宜迟，荣华富贵在等着我们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200664,
					"content": "梦到的东西要怎么做啊？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200665
					]
				},
				{
					"id": 10200665,
					"content": "用「噼咔」的感觉去做就好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200666
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200656,
					"content": "我认同她说的一部分话。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200657
					]
				},
				{
					"id": 10200647,
					"content": "派蒙，我们在谈正事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200648
					]
				},
				{
					"id": 10200638,
					"content": "凝光也想和仙人谈判吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200639
					]
				},
				{
					"id": 10200620,
					"content": "（我们只是做了一些小小的工作…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200621
					]
				}
			]
		},
		{
			"id": 102007,
			"completionStepIds": [
				102007
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102007",
							"2"
						],
						"stepId": 102007,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10200701,
					"content": "哎哎？只能飞到这里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200702
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200702,
					"content": "都怪风场不够厉害，不然就能直接上到顶啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200703
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200703,
					"content": "回璃月港吧…找千岩军打听一下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200704
					]
				},
				{
					"id": 10200704,
					"content": "嗯？为什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200705
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200705,
					"content": "上去的方法应该不是秘密，否则…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200706
					]
				},
				{
					"id": 10200706,
					"content": "否则？…喔，我明白了，否则甘雨让我们自己拜访群玉阁，就说不通了，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200707
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200707,
					"content": "好吧，那就按你说的办吧，我们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200708
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200708,
					"content": "啊！先等一等，你看下面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200709
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200709,
					"content": "原来我们已经走到<color=#00E1FFFF>「归终机」</color>附近了呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200710
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200710,
					"content": "这样的话…唔…我有个新点子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200711
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200711,
					"content": "——不如，用「归终机」把你发射上去吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200712,
						10200714
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200712,
					"content": "不了，会死的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200713
					]
				},
				{
					"id": 10200713,
					"content": "唔呃…这么说来，确实没有考虑到安全细节…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200716
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200716,
					"content": "不过我记得，归终机有望远的功能。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200717
					]
				},
				{
					"id": 10200717,
					"content": "啊，对哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200718
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200718,
					"content": "这么说来，确实可以利用…那就靠归终机来找找看，附近还有没有上去的路吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200714,
					"content": "难道你很恨我吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200715
					]
				},
				{
					"id": 10200715,
					"content": "唔呃…只是没有考虑到安全细节而已…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200716
					],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}