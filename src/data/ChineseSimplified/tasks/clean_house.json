			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"思鹤"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722320501,
					"content": "有趣…他们竟然不惜牺牲掉任何知道这件事内情的人。「愚人众」是这样的组织吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320502
					],
					"speakerTitle": "思鹤"
				},
				{
					"id": 722320502,
					"content": "这一点也不有趣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722320503
					]
				},
				{
					"id": 722320503,
					"content": "和我们想法不同的外人，我都觉得是有趣的。只不过有的在好的意义上有趣，有的就不那么妙咯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320504
					],
					"speakerTitle": "思鹤"
				},
				{
					"id": 722320504,
					"content": "啊，感谢您百忙之中抽出时间，帮现人神巫女大人解决这件小事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320505
					],
					"speakerTitle": "思鹤"
				},
				{
					"id": 722320505,
					"content": "这位「内森」的把柄已经被我们完全掌握了，对「愚人众」的作战，我们算是扳下了一城。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320506
					],
					"speakerTitle": "思鹤"
				},
				{
					"id": 722320506,
					"content": "关于「内森」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722320507
					]
				},
				{
					"id": 722320507,
					"content": "那家伙自称蒙德人…或许真的是生在蒙德的愚人众成员也说不定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320508
					],
					"speakerTitle": "思鹤"
				},
				{
					"id": 722320508,
					"content": "他就是「愚人众」可怕之处的最佳例证——并非通过正面作战，而是通过精明的内部分化来搅乱局面，从乱局中攫取利益。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320509
					],
					"speakerTitle": "思鹤"
				},
				{
					"id": 722320509,
					"content": "他们深知我们最急需克服的障碍就在我们自己之中…即使再有意抑制，以血复仇的恶念也是难以消灭的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320510
					],
					"speakerTitle": "思鹤"
				},
				{
					"id": 722320510,
					"content": "于是，借着「义军」的伪装，容易引人共情的口号…和一颗冷酷的心，这位内森把军中最激进的圈子引向了绝路…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320511
					],
					"speakerTitle": "思鹤"
				},
				{
					"id": 722320511,
					"content": "而他自己却全身而退…我是说，险些。那家伙终究还是受到了惩罚…哼，就我个人而言，仅仅把他扔进暗牢里，这惩罚还太轻了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320512
					],
					"speakerTitle": "思鹤"
				},
				{
					"id": 722320512,
					"content": "还有八酝岛的住民…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722320513
					]
				},
				{
					"id": 722320513,
					"content": "还有八酝岛的住民。您也看过内森的报告了。在他眼中，住民的性命只是报表里简单的数据而已…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320514
					],
					"speakerTitle": "思鹤"
				},
				{
					"id": 722320514,
					"content": "这场灾难…说来惭愧，打乱了现人神巫女大人的规划，也让加剧冲突变得不可避免。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320515
					],
					"speakerTitle": "思鹤"
				},
				{
					"id": 722320515,
					"content": "但我们还是想办法挽回了人心，赢得了和平，幸存的我们所有人，都没有辜负那些牺牲者的意志…并且得以站在坚实的地面上亡羊补牢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320516
					],
					"speakerTitle": "思鹤"
				},
				{
					"id": 722320516,
					"content": "「战争是苦泪之川，无舟可渡，纵横奔流。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320517
					],
					"speakerTitle": "思鹤"
				},
				{
					"id": 722320517,
					"content": "这是我们氏族岛歌中的一句…现人神巫女大人之所以不喜欢战争，或许也是因为如此吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320518
					],
					"speakerTitle": "思鹤"
				},
				{
					"id": 722320518,
					"content": "可惜呀，哲平那小子没有福气同我们一起来见证这些…太可惜了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320519
					],
					"speakerTitle": "思鹤"
				},
				{
					"id": 722320519,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320520
					],
					"speakerTitle": "思鹤"
				},
				{
					"id": 722320520,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722320521
					]
				},
				{
					"id": 722320521,
					"content": "咳咳…愚人众短期内或许还会来调查他们失踪的前哨，但应该不会蠢到随随便便来找珊瑚宫的麻烦了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320522
					],
					"speakerTitle": "思鹤"
				},
				{
					"id": 722320522,
					"content": "当然，这种事情，还是现人神巫女大人比我看得更远些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320523
					],
					"speakerTitle": "思鹤"
				},
				{
					"id": 722320523,
					"content": "总之…不说那些伤心事了，愚人众残党事件解决！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320524
					],
					"speakerTitle": "思鹤"
				},
				{
					"id": 722320524,
					"content": "啊，我知道有一处蒲烧鳗鱼不错，有时间一起去尝尝如何…「剑鱼」二番队的「长官」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "思鹤"
				}
			]
		},
