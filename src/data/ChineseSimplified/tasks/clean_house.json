			"dialogs": [
				{
					"id": 722320601,
					"content": "「…请务必尽快撤离，将寻回『内森』秘密报告的稻妻新兵交予首席执行官大人。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320602
					],
					"speakerTitle": "鲍连卡的「指令」"
				},
				{
					"id": 722320602,
					"content": "「以此断绝后患，不可将八酝岛事件之内幕向任何方面透露。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320603
					],
					"speakerTitle": "鲍连卡的「指令」"
				},
				{
					"id": 722320603,
					"content": "「新兵本身于『愚人众』之共同目标或无价值，亦无甚培养必要。但作为活体样本，于科学研究甚为方便。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鲍连卡的「指令」"
				}
			]
