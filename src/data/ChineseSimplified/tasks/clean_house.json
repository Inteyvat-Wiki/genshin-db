	"talks": [
		{
			"id": 7223201,
			"completionStepIds": [
				7223201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7223201",
							"2"
						],
						"stepId": 7223201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"思鹤"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722320101,
					"content": "#您好，{NICKNAME}。请问方便谈一些事情吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320102
					],
					"speakerTitle": "思鹤"
				},
				{
					"id": 722320102,
					"content": "实在抱歉打扰您，但事关重大…现人神巫女大人吩咐我一定要找到您才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320103,
						722320105
					],
					"speakerTitle": "思鹤"
				},
				{
					"id": 722320103,
					"content": "毕竟我是「剑鱼」二番队队长嘛。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722320104
					]
				},
				{
					"id": 722320104,
					"content": "是这样没错，所以这件事情，相信您一定也能够漂亮完成。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320106
					],
					"speakerTitle": "思鹤"
				},
				{
					"id": 722320106,
					"content": "多亏了您的倾力帮助，我们在与幕府的战争中逆转了劣势…按照当前的局面，长期停战应该是大势所趋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320107
					],
					"speakerTitle": "思鹤"
				},
				{
					"id": 722320107,
					"content": "我们赢回了和平，扫除了「眼狩令」，而一直盘剥我们的恶奉行终于倒台…大御神的遗骨也获得了宁静，这些都多亏了您的努力。请容我再次感谢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320108
					],
					"speakerTitle": "思鹤"
				},
				{
					"id": 722320108,
					"content": "但残余的愚人众势力仍然没有放弃在八酝岛四处探查。尽管他们在战争中失去了一个「执行官」，另一个「执行官」也不知所踪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320109
					],
					"speakerTitle": "思鹤"
				},
				{
					"id": 722320109,
					"content": "关于愚人众…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722320110
					]
				},
				{
					"id": 722320110,
					"content": "海祇岛长期信息闭塞，这场战争可以说制造了我们与这些家伙接触的缘由。以这样的方式相识，还真是糟糕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320111
					],
					"speakerTitle": "思鹤"
				},
				{
					"id": 722320111,
					"content": "他们似乎是想要将这场战争拖成持久战，并且意图煽动起双方民众的仇恨，以此提升战争烈度…相比起幕府军，他们是更加危险的敌人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320112
					],
					"speakerTitle": "思鹤"
				},
				{
					"id": 722320112,
					"content": "假如战争迁延日久，它所造成的严重经济匮乏与社会紧张，就会极大地方便「愚人众」在两方的夹缝中扩张自己的影响力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320113
					],
					"speakerTitle": "思鹤"
				},
				{
					"id": 722320113,
					"content": "幸好现人神巫女大人及时发觉了他们的阴谋，以及您和许许多多将士们的奋战…我们才得以及时制止愚人众的计划。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320114
					],
					"speakerTitle": "思鹤"
				},
				{
					"id": 722320114,
					"content": "我需要做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722320115
					]
				},
				{
					"id": 722320115,
					"content": "根据我们的情报，仍有一些被愚人众渗透的幕府军军士潜伏在八酝岛，正搜集信息、密谋着什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320116
					],
					"speakerTitle": "思鹤"
				},
				{
					"id": 722320116,
					"content": "向您提出这样的请求实在是迫不得已，但现人神巫女大人认为您是处理此事最为保险的人选…所以还得劳烦您随我一同前往大御神殉身之处找那些家伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320117
					],
					"speakerTitle": "思鹤"
				},
				{
					"id": 722320117,
					"content": "首先由我进行言语沟通劝阻。如果他们仍执意挑起纷争、不愿悔改，那便烦请您使用武力说服。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320118
					],
					"speakerTitle": "思鹤"
				},
				{
					"id": 722320118,
					"content": "就这么简单？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722320119
					]
				},
				{
					"id": 722320119,
					"content": "简单么？啊…不愧是您，对您而言，这或许就是举手之劳吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320120
					],
					"speakerTitle": "思鹤"
				},
				{
					"id": 722320120,
					"content": "但唯一的难点是…您太出名了，对方可能一眼就能认出来。事出突然，我们也没时间易容了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320121
					],
					"speakerTitle": "思鹤"
				},
				{
					"id": 722320121,
					"content": "我有这个。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722320122
					]
				},
				{
					"id": 722320122,
					"content": "好平直的伪装！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320123
					],
					"speakerTitle": "思鹤"
				},
				{
					"id": 722320123,
					"content": "#唔…不过不知为什么，我也险些没认出来您呢。和作为「剑鱼」二番队队长的{NICKNAME}相比，确实在气质上有明显的不同…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320124
					],
					"speakerTitle": "思鹤"
				},
				{
					"id": 722320124,
					"content": "那就这样吧，准备好了就请随我出发。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "思鹤"
				},
				{
					"id": 722320105,
					"content": "发生什么事了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722320106
					]
				}
			]
		},
		{
			"id": 7223202,
			"completionStepIds": [
				7223202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7223202",
							"2"
						],
						"stepId": 7223202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"蛮横的武士",
					"思鹤"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722320201,
					"content": "留步，庶民！幕府辖地，无关人士速速离去！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320202
					],
					"speakerTitle": "蛮横的武士"
				},
				{
					"id": 722320202,
					"content": "庶民？...我是珊瑚宫特使思鹤，来此巡查大御神殉身之所的现状。你的上司没有通知过你吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320203
					],
					"speakerTitle": "思鹤"
				},
				{
					"id": 722320203,
					"content": "珊瑚宫的人…？没有，我从来没有接到过通知。请你们立刻离开！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320204
					],
					"speakerTitle": "蛮横的武士"
				},
				{
					"id": 722320204,
					"content": "这与我们双方先前的停战协定不符，武士先生。请你报上名来，我会让你的上司知道你的无理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320205
					],
					"speakerTitle": "思鹤"
				},
				{
					"id": 722320205,
					"content": "抱歉，我不觉得有那个必要，珊瑚宫的小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320206
					],
					"speakerTitle": "蛮横的武士"
				},
				{
					"id": 722320206,
					"content": "倒是你，最好不要再靠近矿洞了，如若继续挑衅…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320207
					],
					"speakerTitle": "蛮横的武士"
				},
				{
					"id": 722320207,
					"content": "那么，破坏停战的罪名不是一般人能承受的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320208
					],
					"speakerTitle": "蛮横的武士"
				},
				{
					"id": 722320208,
					"content": "没错，破坏停战的罪名不是一般人能承受得了的…正因如此，我才希望你们能停止亵渎神体，体面且安全地离开大御神殉身之地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320209
					],
					"speakerTitle": "思鹤"
				},
				{
					"id": 722320209,
					"content": "哈！「神体」！「殉身之地」！呸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320210
					],
					"speakerTitle": "蛮横的武士"
				},
				{
					"id": 722320210,
					"content": "没错。我们已经给了你们足够的时间，可以有组织地逐步撤离这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320211
					],
					"speakerTitle": "思鹤"
				},
				{
					"id": 722320211,
					"content": "呵，你们海祇岛的人，说话太好笑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320212
					],
					"speakerTitle": "蛮横的武士"
				},
				{
					"id": 722320212,
					"content": "这就是你们打仗的目的吗？为了死去的神？但是你们的大蛇早就成了矿洞里那些亮晶晶的石头，成了我们的剑了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320213
					],
					"speakerTitle": "蛮横的武士"
				},
				{
					"id": 722320213,
					"content": "曾经你们俯首大蛇，后来你们俯首在它的遗骨熔炼打造成的剑下，两种命运不都是差不多嘛？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320214
					],
					"speakerTitle": "蛮横的武士"
				},
				{
					"id": 722320214,
					"content": "请注意你的言辞，武士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320215
					],
					"speakerTitle": "思鹤"
				},
				{
					"id": 722320215,
					"content": "既然不乐意追随将军殿下，我们也给了你们选择，对吧？作为听话的庶民活下去不好吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320216
					],
					"speakerTitle": "蛮横的武士"
				},
				{
					"id": 722320216,
					"content": "当年是将军殿下一时怜悯才留你们存活的，如此大恩不谢，如今居然还要对抗幕府…你们真的以为一时反逆能给你们带来什么好下场？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320217
					],
					"speakerTitle": "蛮横的武士"
				},
				{
					"id": 722320217,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320218
					],
					"speakerTitle": "思鹤"
				},
				{
					"id": 722320218,
					"content": "哼，瞧瞧你们干的好事吧…借推翻「眼狩令」，你们夺去了多少人的生路？夺去了多少税源！没有了税源，你们又让我们吃什么！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320219
					],
					"speakerTitle": "蛮横的武士"
				},
				{
					"id": 722320219,
					"content": "如果不是柊大人因为你们而被废黜，我们这些体面武士怎会沦落至此！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320220
					],
					"speakerTitle": "蛮横的武士"
				},
				{
					"id": 722320220,
					"content": "我和你说这么多干什么…你们这些小岛上的穷酸乡巴佬，什么也不懂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320221
					],
					"speakerTitle": "蛮横的武士"
				},
				{
					"id": 722320221,
					"content": "总之，我见到你们就烦，赶紧滚吧…除非你成心挑事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320222
					],
					"speakerTitle": "蛮横的武士"
				},
				{
					"id": 722320222,
					"content": "「柊大人」，是么…呵呵，我是不会破坏停战协议的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320223
					],
					"speakerTitle": "思鹤"
				},
				{
					"id": 722320223,
					"content": "相反，现人神巫女大人交给我的任务，是清理掉企图破坏和平的家伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320224
					],
					"speakerTitle": "思鹤"
				},
				{
					"id": 722320224,
					"content": "#{NICKNAME}，您可以动手了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320225,
						722320227
					],
					"speakerTitle": "思鹤"
				},
				{
					"id": 722320225,
					"content": "没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722320226
					]
				},
				{
					"id": 722320226,
					"content": "什么…你怎么…敌袭！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蛮横的武士"
				},
				{
					"id": 722320227,
					"content": "可是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722320228
					]
				},
				{
					"id": 722320228,
					"content": "就是他了，总之请先将他制服！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320229
					],
					"speakerTitle": "思鹤"
				},
				{
					"id": 722320229,
					"content": "果然，你…敌袭、敌袭！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蛮横的武士"
				}
			]
		},
