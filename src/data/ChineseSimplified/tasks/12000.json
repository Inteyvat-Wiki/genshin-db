			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120000201,
					"content": "「万文集舍」…这里是璃月港的书店吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120000202,
					"content": "要不要问问这里有没有《提瓦特游览指南》的璃月篇？那书超有意思的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 1200003,
			"completionStepIds": [
				1200003
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200003",
							"2"
						],
						"stepId": 1200003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"纪芳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120000301,
					"content": "啊，随便看看吧，不买也行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000302
					],
					"speakerTitle": "纪芳"
				},
				{
					"id": 120000302,
					"content": "我们是来找书的，这里有没有《提瓦特游览指南》的璃月篇呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120000303,
					"content": "哦，这本书很久以前就不卖了，没什么人气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000304
					],
					"speakerTitle": "纪芳"
				},
				{
					"id": 120000304,
					"content": "欸？！明明蒙德篇那么有趣…太可惜了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120000305,
					"content": "这书的作者太有个性了，说是指南，但其实起不到什么指南的作用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000306
					],
					"speakerTitle": "纪芳"
				},
				{
					"id": 120000306,
					"content": "不仅卖不出去，我曾经还因为这书被游客投诉过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000307,
						120000308
					],
					"speakerTitle": "纪芳"
				},
				{
					"id": 120000307,
					"content": "个人风格太强烈了吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000309
					]
				},
				{
					"id": 120000309,
					"content": "但我还是觉得很可惜，蒙德篇当成冒险日记来读也很有趣啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120000310,
					"content": "反正我这里现在已经没有了，如果实在想看，可以去常九爷那儿碰碰运气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000311
					],
					"speakerTitle": "纪芳"
				},
				{
					"id": 120000311,
					"content": "常九爷？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120000312,
					"content": "他住在轻策庄，收藏各种书籍。虽然脾气不太好，但聊到藏书还是很健谈的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000313
					],
					"speakerTitle": "纪芳"
				},
				{
					"id": 120000313,
					"content": "他还在璃月港的时候就是我的老主顾了，现在我有时也会给他寄两本绝版藏书…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000324
					],
					"speakerTitle": "纪芳"
				},
				{
					"id": 120000324,
					"content": "不过他住的地方很难找，要先沿着轻策庄后山的栈道一路爬上去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000314
					],
					"speakerTitle": "纪芳"
				},
				{
					"id": 120000314,
					"content": "你说，绝版藏书？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000315
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000315,
					"content": "那已经绝版的《神霄折戟录》第六卷，也可能在他的收藏之中？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000316,
						120000317
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000316,
					"content": "你是谁啊？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000318
					]
				},
				{
					"id": 120000318,
					"content": "失礼了，在下行秋，只是一个偶然路过的爱书人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000319
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000319,
					"content": "既然你我都在寻书，那何不一同前往轻策山，拜访这位常九爷呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000320,
						120000322
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000320,
					"content": "有道理，那就麻烦你带路了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000321
					]
				},
				{
					"id": 120000321,
					"content": "都是爱书之人，不必客气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000322,
					"content": "其实我没想跑这么远…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000323
					]
				},
				{
					"id": 120000323,
					"content": "别这么说嘛，这璃月港分外嘈杂，偶尔也要去清静之地透透气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000317,
					"content": "神出鬼没的，吓死了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000318
					]
				},
				{
					"id": 120000308,
					"content": "是某些条目在教唆犯罪吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000309
					]
				}
			]
		},
		{
			"id": 1200005,
			"completionStepIds": [
				1200005
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200005",
							"2"
						],
						"stepId": 1200005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"常九爷"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120000501,
					"content": "唉，天要亡我啊…天要…亡我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000502
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 120000502,
					"content": "请问你就是常九爷吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000503
					]
				},
				{
					"id": 120000503,
					"content": "嗯，有事吗？有事快说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000504
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 120000504,
					"content": "听说你这里有很多绝版的藏书，我们想借《提瓦特游览指南》的璃月篇看一看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120000505,
					"content": "唉，别跟我提书的事了，我都快烦死了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000506
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 120000506,
					"content": "层岩巨渊封锁以后，我家矿石生意很不好做，「愚人众」还在下黑手…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000507
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 120000507,
					"content": "为了筹货款，我只能把我的爱书都拿去当了…！你知道这意味什么吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000508,
						120000509
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 120000508,
					"content": "…没书看了很难过？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000510
					]
				},
				{
					"id": 120000510,
					"content": "不对！是我的人生！我倾尽一生收藏的！保护的！我的藏书，没了！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000511
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 120000511,
					"content": "唉…算了，冲着你们大吼大叫也没什么意义。早点筹钱把书赎回来才是真的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000512
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 120000512,
					"content": "没其他事的话，我也没心情聊天。走吧走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000513
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 120000513,
					"content": "莫非，连《神霄折戟录》的第六卷，也当掉了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000514
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000514,
					"content": "哦？想不到会听到这个名字…你还挺有品味的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000515
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 120000515,
					"content": "意思是我们没有品味吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000516
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120000516,
					"content": "这可是具有时代意义的一本奇书，当年刚推出的时候不被任何人看好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000517
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 120000517,
					"content": "但它改变了很多人对武侠小说的印象，之后也出现了大批的模仿者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000518
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 120000518,
					"content": "最初的一版数量非常少，几乎一下子就绝版了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000519
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 120000519,
					"content": "在后来的加印版本中，作为补充故事的第六卷，不知为何并没有再版的机会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000520
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000520,
					"content": "对对对，就是这样！因为存世数量非常之少，无论我再怎么缺钱，也舍不得当掉啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000521
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 120000521,
					"content": "这么说，这本书还在你的手上？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000522
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000522,
					"content": "嗯，这是我剩下的唯一一本爱书了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000523
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 120000523,
					"content": "喂，老常！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000524
					],
					"speakerTitle": "昌虎"
				},
				{
					"id": 120000524,
					"content": "磨磨蹭蹭的，是我家老爷给你脸了？那批石珀，究竟是卖还是不卖？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000525
					],
					"speakerTitle": "昌虎"
				},
				{
					"id": 120000525,
					"content": "惹恼了茂才公，就等于惹恼了「愚人众」，这道理总该明白吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000526
					],
					"speakerTitle": "昌虎"
				},
				{
					"id": 120000526,
					"content": "啊，又是你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000527
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 120000527,
					"content": "可我也不能三折来卖这一批石珀啊，那样的话…我可能再也赎不回我的书了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000528
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 120000528,
					"content": "那我不管，你是要看书还是要吃饭？还是想带着书进棺材提前躺好？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000529
					],
					"speakerTitle": "昌虎"
				},
				{
					"id": 120000529,
					"content": "呃，你…唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000530
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 120000530,
					"content": "话不能这么讲，这位兄台。买卖讲究一个你情我愿，哪里有强买强卖的道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000531
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000531,
					"content": "你又是从哪儿冒出来的？关你什么事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000532
					],
					"speakerTitle": "昌虎"
				},
				{
					"id": 120000532,
					"content": "在下路见不平行侠仗义之人，古华派，行秋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000533
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000533,
					"content": "噗…噗哈哈哈——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000534
					],
					"speakerTitle": "昌虎"
				},
				{
					"id": 120000534,
					"content": "古华派，他说古华派！哈哈哈——！听见了吗？这年头还有人提古华派！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000535
					],
					"speakerTitle": "昌虎"
				},
				{
					"id": 120000535,
					"content": "不过是个断了香火、摇摇欲坠的小门派吧？就这还敢行侠仗义？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000536
					],
					"speakerTitle": "昌虎"
				},
				{
					"id": 120000536,
					"content": "正义和身份可没什么关系，你只不过是个狐假虎威的小家丁，不是一样在作恶吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000537
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000537,
					"content": "你…你！行啊，你给我等着！看我有没有本事收拾你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000538
					],
					"speakerTitle": "昌虎"
				},
				{
					"id": 120000538,
					"content": "还有你，老常！这批矿你不卖也得卖！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000539
					],
					"speakerTitle": "昌虎"
				},
				{
					"id": 120000539,
					"content": "唉，虎落平阳被犬欺。这日子是过不下去了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000540
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 120000540,
					"content": "那话说回来吧，究竟能否将书借给我呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000541,
						120000542
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000541,
					"content": "你这也太漠不关心了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000543
					]
				},
				{
					"id": 120000543,
					"content": "算了算了，我也不指望别人能操心我。看你刚刚帮我说了话的份儿上，拿着书快滚吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000544
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 120000544,
					"content": "非常感谢！我盼这书三载有余，予书之恩，行秋必报。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000545
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000545,
					"content": "行了行了，记得把书还给我就行。我对古华派弟子可没什么期待…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000546
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 120000546,
					"content": "喂喂！你这就走了？什么都还没搞清楚呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120000542,
					"content": "稍微看一下现场气氛啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000543
					]
				},
				{
					"id": 120000509,
					"content": "…没书看了很无聊？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000510
					]
				}
			]
		},
		{
			"id": 1200006,
			"completionStepIds": [
				1200006
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
