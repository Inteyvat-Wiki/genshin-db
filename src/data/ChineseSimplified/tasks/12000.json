			"dialogs": [
				{
					"id": 120001001,
					"content": "还以为腰上那个只是普通的玉石…没想到居然是「神之眼」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001002
					],
					"speakerTitle": "昌虎"
				},
				{
					"id": 120001002,
					"content": "今、今天就先放过你！咱们走着瞧！这事没完！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001022
					],
					"speakerTitle": "昌虎"
				},
				{
					"id": 120001022,
					"content": "唉，指望他们吸取教训，是不可能的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001003,
						120001005
					],
