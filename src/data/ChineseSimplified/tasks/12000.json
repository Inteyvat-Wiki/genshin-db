					"行秋"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120000601,
					"content": "站在这里看书就是你行侠仗义的方式吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120000602,
					"content": "有意思，有意思，原来还发生了这样的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000603
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000603,
					"content": "喂，听我说话啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120000604,
					"content": "原来如此，备受追捧果然是有原因的啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000608
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000608,
					"content": "喂——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000605,
						120000606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120000605,
					"content": "刚才来势汹汹的那帮人…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000607
					]
				},
				{
					"id": 120000607,
					"content": "是啊，不能以超低价买到矿石，就要让常九爷吃苦头，他们简直和强盗没区别！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000609,
						120000611
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120000609,
					"content": "我们得想办法帮帮常九爷。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000610
					]
				},
				{
					"id": 120000610,
					"content": "可别把我排除在外。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000613
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000613,
					"content": "你这不是听得到我们说话吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000614
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120000614,
					"content": "借来这书，只是我觉得常九爷走投无路，最后还是会当掉它，那就太可惜了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000615
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000615,
					"content": "对常九爷说的话，我可不只是说说而已，既然他有恩于我，那我必定报答，此乃侠义。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000616
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000616,
					"content": "这书由我代为保管，而他的其他藏书，我也会帮他赎回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000617,
						120000618
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000617,
					"content": "你想到办法了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000619
					]
				},
				{
					"id": 120000619,
					"content": "当然有办法，我已经有头绪了，现在只需要考虑考虑细节。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000620
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000620,
					"content": "嗯，容我思考一番，不需要太长的时间…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000621
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000621,
					"content": "居然还敢待在这儿，你以为我真的只是吓唬吓唬你？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000622
					],
					"speakerTitle": "昌虎"
				},
				{
					"id": 120000622,
					"content": "豆花派要人没人，要本事没本事，就胆子还不小。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000623
					],
					"speakerTitle": "昌虎"
				},
				{
					"id": 120000623,
					"content": "哦，搞错了，古华派！古华派，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000624
					],
					"speakerTitle": "昌虎"
				},
				{
					"id": 120000624,
					"content": "有道是「蚍蜉撼大树，可笑不自量」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000625
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000625,
					"content": "啊？拽什么文辞呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000626
					],
					"speakerTitle": "昌虎"
				},
				{
					"id": 120000626,
					"content": "请回吧，强买强卖的事我是不容的，何况还是于我有恩的常九爷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000627
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000627,
					"content": "你小子，看来又想帮老常出头？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000628
					],
					"speakerTitle": "昌虎"
				},
				{
					"id": 120000628,
					"content": "那你可找错时候了，看，今天有「愚人众」的大人为我撑腰，几十个古华派加起来也得罪不起！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000629
					],
					"speakerTitle": "昌虎"
				},
				{
					"id": 120000629,
					"content": "在下虽年少，也行走江湖数年，面对恶者又何曾惧过？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000630
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000630,
					"content": "那就给你点教训吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "昌虎"
				},
				{
					"id": 120000618,
					"content": "我不觉得你有办法…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000619
					]
				},
				{
					"id": 120000611,
					"content": "看来璃月篇是看不成了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000612
					]
				},
				{
					"id": 120000612,
					"content": "同是求书，你们这么轻易就要放弃了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000613
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000606,
					"content": "那帮人自称是帮茂才公做事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000607
					]
				}
			]
		},
