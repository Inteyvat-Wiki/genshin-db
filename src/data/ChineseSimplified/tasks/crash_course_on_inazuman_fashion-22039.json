			},
			"dialogs": [
				{
					"id": 220390101,
					"content": "这样做生意长久不了啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390102
					],
					"speakerTitle": "小仓澪"
				},
				{
					"id": 220390102,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220390103
					]
				},
				{
					"id": 220390103,
					"content": "抱歉抱歉，想事情一时走了神。你是来买成衣的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390104
					],
					"speakerTitle": "小仓澪"
				},
				{
					"id": 220390104,
					"content": "虽然璃月的高档绸缎仍然断货…但新款的着物还是应有尽有的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390105
					],
					"speakerTitle": "小仓澪"
				},
				{
					"id": 220390105,
					"content": "之前你会从璃月进货？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220390106
					]
				},
				{
					"id": 220390106,
					"content": "是的，之前我们店总能进到璃月的高档绸缎，比如「飞云商会」那些用霓裳花制成的丝绸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390107
					],
					"speakerTitle": "小仓澪"
				},
				{
					"id": 220390107,
					"content": "可是，现在稻妻这个情况…店里已经有一段时间没有进过那种绸缎了。现在也只能靠之前的存货维持经营。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390108
					],
					"speakerTitle": "小仓澪"
				},
				{
					"id": 220390108,
					"content": "店里的这些丝绸，可以说是用一段少一段…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390109
					],
					"speakerTitle": "小仓澪"
				},
				{
					"id": 220390109,
					"content": "我本来是想自己设计些新纹样，或者是用些新染料，做出一些新样式的布料和成衣来吸引客人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390110
					],
					"speakerTitle": "小仓澪"
				},
				{
					"id": 220390110,
					"content": "但是，我却始终没找到什么能称得上是有「新意」的染料…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390111
					],
					"speakerTitle": "小仓澪"
				},
				{
					"id": 220390111,
					"content": "旅行者，你四处旅行，一定见多识广…你见过什么能称得上是有「新意」的染料吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390112,
						220390116
					],
					"speakerTitle": "小仓澪"
				},
				{
					"id": 220390112,
					"content": "我见得多了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220390113
					]
				},
				{
					"id": 220390113,
					"content": "真、真的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390114
					],
					"speakerTitle": "小仓澪"
				},
				{
					"id": 220390114,
					"content": "如果可以的话，能请你帮我长长见识，拿一些能制成新颖染料的原料给我看看吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390115
					],
					"speakerTitle": "小仓澪"
				},
				{
					"id": 220390115,
					"content": "我会准备好报酬的，拜托你了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小仓澪"
				},
				{
					"id": 220390116,
					"content": "只要染料吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220390117
					]
				},
				{
					"id": 220390117,
					"content": "现在这个情况，我也暂时只能在染料这方面想想办法了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390118
					],
					"speakerTitle": "小仓澪"
				},
				{
					"id": 220390118,
					"content": "如果你知道有什么原料能制成富有「新意」的染料，就请拿来给我吧，我会准备好报酬的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小仓澪"
				}
			]
		},
