			},
			"dialogs": [
				{
					"id": 752540509,
					"content": "我们好像在哪见过？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752540501
					]
				},
				{
					"id": 752540501,
					"content": "朋友，这是命运给不凡之人打上的标记，让您与我初次相遇，也如同久别重逢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540502
					],
					"speakerTitle": "泰克胡"
				},
				{
					"id": 752540502,
					"content": "看到我这恶狼般的眼罩，想必就已经意识到了我的不凡了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "泰克胡"
				}
			]
		},
		{
			"id": 7525406,
			"completionStepIds": [],
