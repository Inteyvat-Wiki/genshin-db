			},
			"dialogs": [
				{
					"id": 752540409,
					"content": "再见。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752540410
					]
				},
				{
					"id": 752540410,
					"content": "你还没问我的眼睛是怎么回事呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "泰克胡"
				}
			]
		},
