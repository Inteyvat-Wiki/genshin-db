			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"泰克胡"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752540101,
					"content": "嚯，朋友！欢迎来到梦中的帕依提提——提提岛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540102
					],
					"speakerTitle": "泰克胡"
				},
				{
					"id": 752540102,
					"content": "往前走就是「醅蜜」酒吧和「尝露」酒吧，我是酒吧的迎宾泰克胡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "泰克胡"
				}
			]
		},
		{
			"id": 7525402,
			"completionStepIds": [
				7525403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7525403",
							"2"
						],
						"stepId": 7525403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"泰克胡"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752540201,
					"content": "亲爱的朋友，既然你喝了我的欢迎果汁，那让我给你一个忠告。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540202
					],
					"speakerTitle": "泰克胡"
				},
				{
					"id": 752540202,
					"content": "要是你只是个过来享受假期的普通人，那就别靠近提提岛的最北边，那里没有能让你放松的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "泰克胡"
				}
			]
		},
		{
			"id": 7525403,
			"completionStepIds": [
				7525401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7525401",
							"2"
						],
						"stepId": 7525401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"泰克胡"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752540309,
					"content": "好吧，那你的眼睛是怎么回事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752540310
					]
				},
				{
					"id": 752540310,
					"content": "哼哼，是一个光头干的，他在我身上留下了这印迹…他现在也在这个岛上，哼，我会好好「感谢」他的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540311
					],
					"speakerTitle": "泰克胡"
				},
				{
					"id": 752540311,
					"content": "我知道听了我的故事，您一定也想为我复仇吧？但不必了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540312
					],
					"speakerTitle": "泰克胡"
				},
				{
					"id": 752540312,
					"content": "亲爱的朋友，在这个如此美丽的夏日，没有人应该感到悲伤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540313
					],
					"speakerTitle": "泰克胡"
				},
				{
					"id": 752540313,
					"content": "请享用我为每位客人准备的欢迎果汁，尽情挥霍这段休闲的时光吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540314
					],
					"speakerTitle": "泰克胡"
				},
				{
					"id": 752540314,
					"content": "果汁就在那边的橱柜上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "泰克胡"
				}
			]
		},
		{
			"id": 7525404,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
