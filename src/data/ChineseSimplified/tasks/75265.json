			},
			"dialogs": [
				{
					"id": 752650301,
					"content": "嘿！朋友，我这有好东西…又是你们？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650302
					],
					"speakerTitle": "玛纳奥"
				},
				{
					"id": 752650302,
					"content": "说了不卖，听不懂？一边去，别在这里碍事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650303
					],
					"speakerTitle": "玛纳奥"
				},
				{
					"id": 752650303,
					"content": "你这家伙…现在跟我们道歉还来得及！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752650304,
					"content": "你们有什么毛病？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650305
					],
					"speakerTitle": "玛纳奥"
				},
				{
					"id": 752650305,
					"content": "你在卖假货吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752650306
					]
				},
				{
					"id": 752650306,
					"content": "哈？是又怎么样？我劝你们少管闲事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玛纳奥"
