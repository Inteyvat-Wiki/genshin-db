			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"玛纳奥"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752650101,
					"content": "嘿！朋友，我这有好东西，价格也美丽，要看看吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650102
					],
					"speakerTitle": "玛纳奥"
				},
				{
					"id": 752650102,
					"content": "欸？这不是那些鳍游龙玩偶吗？好像在悠悠集市见过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752650103,
					"content": "真有眼光，但我这货便宜，五折就卖。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650104
					],
					"speakerTitle": "玛纳奥"
				},
				{
					"id": 752650104,
					"content": "为什么这么便宜？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752650105
					]
				},
				{
					"id": 752650105,
					"content": "嘿嘿，朋友，这你就别管了，我有我的渠道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650106
					],
					"speakerTitle": "玛纳奥"
				},
				{
					"id": 752650106,
					"content": "虽然便宜了很多，但是感觉这些玩偶的颜色有点怪怪的，不会是假货吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752650107,
					"content": "假货？你这个不识货的小东西…一边去！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650108
					],
					"speakerTitle": "玛纳奥"
				},
				{
					"id": 752650108,
					"content": "快走快走！我不卖给你们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玛纳奥"
				}
			]
		},
		{
			"id": 7526502,
			"completionStepIds": [],
