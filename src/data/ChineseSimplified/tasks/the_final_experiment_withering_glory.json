			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿贝多"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110450101,
					"content": "想必在旅行的过程中，你也遇到过很多的谜题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450102
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110450102,
					"content": "和体能测试类似，我想通过实验观察你的智能水平。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450103,
						110450104
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110450103,
					"content": "没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450105
					]
				},
				{
					"id": 110450105,
					"content": "我希望你能探索一番这里的遗迹，之后给我你所得到的答案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450106
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110450106,
					"content": "在这遗迹的两侧，各有一处谜题，完成之后，应该就可以启动中央的机关了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450107
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110450107,
					"content": "还是像体能测试那样，不限制方式，你所做的一切都是我想要观察的内容。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450108,
						110450110
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110450108,
					"content": "这种事很熟悉了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450109
					]
				},
				{
					"id": 110450109,
					"content": "不愧是经验老道的冒险家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450112
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110450112,
					"content": "那么，就看你表现了。先去哪一边，都由你来决定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110450110,
					"content": "试试看总会有办法。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450111
					]
				},
				{
					"id": 110450111,
					"content": "别忘了这是智能测试，运气并不在测试内容中哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450112
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110450104,
					"content": "这种说法是不是怪怪的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450105
					]
				}
			]
		},
		{
			"id": 1104504,
			"completionStepIds": [
				1104504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104504",
							"2"
						],
						"stepId": 1104504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿贝多"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110450461,
					"content": "这是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450462,
						110450463
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110450462,
					"content": "不认识的图案。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450401
					]
				},
				{
					"id": 110450401,
					"content": "据我所知，这个是一种文字，虽然遍布提瓦特大陆，但又谜团重重。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450402
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110450402,
					"content": "无法理解的地方还有很多，而且，为什么要将这几个符文留在这里，也很奇怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450403
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110450403,
					"content": "总之，我先将它抄录下来，等对你的研究结束之后，我会抽时间看看的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450404
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110450404,
					"content": "唉，又是看不懂的东西。我完全不知道这些很奇怪的问题和实验，能得到什么结果…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110450405,
					"content": "但看来想要赚取报酬，都要付出与之对应的代价啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110450406,
					"content": "这次我实在是收获了很多很多，相较于此，提供微不足道的报酬，实在是不足挂齿的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450407
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110450407,
					"content": "我先回之前的营地去了，等你们回来的时候，我应该能让你们见证一个奇妙的瞬间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450408,
						110450409
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110450408,
					"content": "那就待会儿见了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450410
					]
				},
				{
					"id": 110450410,
					"content": "其实我还是挺期待这么折腾一番之后，能有什么样的结果…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110450411,
					"content": "如果没有什么事的话，我们也回营地去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110450412,
					"content": "(test)阿贝多离场",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110450413,
					"content": "别着急离开，在我排除掉所有危险之前。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450414
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 110450414,
					"content": "啊？是你！原来你没有离开雪山吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110450415,
					"content": "当然，你们和阿贝多做的一切，我都看在眼里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450416
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 110450416,
					"content": "该说你是没有戒备心好呢，还是被他独特的思维模式，还有友善的态度欺骗了呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450417,
						110450418
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 110450417,
					"content": "出什么事了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450419
					]
				},
				{
					"id": 110450419,
					"content": "听从陌生人的指示行动，喝下完全来历不明的药水，参加了诸多结果不明的实验。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450420
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 110450420,
					"content": "比起单纯，我更愿意相信你是被欺骗，或者说…从一开始就串通好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450421
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 110450421,
					"content": "果然是戒备心很强的修女啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450422,
						110450423
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110450422,
					"content": "我只是在帮助他的研究。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450424
					]
				},
				{
					"id": 110450424,
					"content": "无所谓，阿贝多的事怎么都好，我对他的了解，还是比你这样的外乡人要多一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450425
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 110450425,
					"content": "我关心的只有一件事，就是你是否已经被炼金术改造，变成了无法理解的怪物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450426
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 110450426,
					"content": "不会吧？！我完全没有察觉到！而且，一路上他好像就没有怎么用过炼金术…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450427
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110450427,
					"content": "像他这种级别的炼金术士，想要动点手脚，你当然察觉不到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450428
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 110450428,
					"content": "总之，我是不会把任何的威胁放回蒙德的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450429
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 110450429,
					"content": "那、那你想怎么办？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450430
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110450430,
					"content": "你是来确定的，你就有办法确定。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450431
					]
				},
				{
					"id": 110450431,
					"content": "这方面脑子倒是挺灵光的。只要能确定你们接触过的所有东西都没有危险，你们也就没有危险了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450432
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 110450432,
					"content": "其他东西的调查我已经完成了，现在唯独没有确认的，就是这些符文。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450433
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 110450433,
					"content": "这些符文，我们连看都看不懂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450451
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110450451,
					"content": "我知道，而且…嗯，似乎也只是符文，并不是机关。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450452
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 110450452,
					"content": "但保险起见，还是抄录下来…唔，还要把这里作为重要地点，定期巡视。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450434
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 110450434,
					"content": "行吧，既然这样，你们就应该没有危险了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450435
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 110450435,
					"content": "这也是我希望的情况，要是因为你们让我加班，我就亏大了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450436
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 110450436,
					"content": "加、加班？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450437
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110450437,
					"content": "再见之前，忠告你一句，外乡人。别太信任阿贝多了，至少别像这次一样，干这么多不经考虑的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450439
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 110450439,
					"content": "她走了，真我行我素啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450440
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110450440,
					"content": "在蒙德，像她这样的人还真是少见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450441,
						110450442
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110450441,
					"content": "或许只是没有安全感吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450443
					]
				},
				{
					"id": 110450443,
					"content": "嗯，不管她了，我们回去见阿贝多吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110450442,
					"content": "或许只是有点敏感吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450443
					]
				},
				{
					"id": 110450423,
					"content": "我不认为他是坏人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450424
					]
				},
				{
					"id": 110450418,
					"content": "他别有所图？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450419
					]
				},
				{
					"id": 110450409,
					"content": "看来我的智能没出什么问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450410
					]
				},
				{
					"id": 110450463,
					"content": "总觉得在什么地方见过。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450401
					]
				}
			]
		},
		{
			"id": 1104505,
			"completionStepIds": [
				1104505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104505",
							"2"
