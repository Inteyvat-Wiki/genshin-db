			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿贝多"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110450501,
					"content": "你们回来了，正好这里差不多有结论了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450502
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110450502,
					"content": "不过你们好像花了挺多时间的，难道是路上发生了什么吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450503,
						110450504
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110450503,
					"content": "没什么。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450506
					]
				},
				{
					"id": 110450506,
					"content": "还是来说结论吧，今天获得了海量的数据，很难一次性将研究全部完成。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450507
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110450507,
					"content": "但可以给你一个整体性的初步结论，那就是——你非常像这个世界的人类。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450508,
						110450509
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110450508,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450510
					]
				},
				{
					"id": 110450510,
					"content": "这一眼就能看出来的吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450511
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110450511,
					"content": "我们辛辛苦苦跟你做了这么多，结果换来的就是这个吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450512
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110450512,
					"content": "别急，别急，可能对你们来说，觉得是理所当然，但其实这个世界上没有理所当然的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450513
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110450513,
					"content": "你们有考虑过这种可能吗？提瓦特这个世界，对外来者持有天然的拒绝态度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450514,
						110450515
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110450514,
					"content": "答案在神那里。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450516
					]
				},
				{
					"id": 110450516,
					"content": "我提起过这个世界的法则，你能安然无恙地在这里与我对话，看起来平常，但其实是奇迹也说不定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450517
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110450517,
					"content": "因为，和你一样远道而来的生命，就是我之前提到过的种子，在提瓦特的法则作用下，甚至没办法正常地生长开花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450518
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110450518,
					"content": "可是，在观察过你之后，我有了其他的想法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450519
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110450519,
					"content": "模仿你的生命，为炼金术加入我的新灵感，然后——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450520
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110450520,
					"content": "哇，好像，好像有什么要出来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450521
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110450521,
					"content": "从无到有，从萌芽到繁盛，再到终结。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450522
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110450522,
					"content": "培育不属于这个世界的生命，难道不是在培育世界吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450523
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110450523,
					"content": "啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450524,
						110450525
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110450524,
					"content": "好漂亮。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450526
					]
				},
				{
					"id": 110450526,
					"content": "唉，看来这就是极限了。只能盛开一瞬却无比美丽的花朵，生命的极致也在于此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450527
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110450527,
					"content": "我以为我们付出了那么多，它可以永远盛开下去。而且好像也没结出什么果子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450528
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110450528,
					"content": "生命是多种多样的自由之物，不应以长短定义优劣，哪怕只绽放一刹那…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450529
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110450529,
					"content": "短暂的生命也未必是坏事。高效，完美，意味着不会被孤独所困扰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450530
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110450530,
					"content": "所以，你能明白吗？我刚刚说的，「我们的交谈说不定是奇迹」这件事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450531,
						110450532
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110450531,
					"content": "至少我现在还没有凋零。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450533
					]
				},
				{
					"id": 110450533,
					"content": "欸？为什么突然气氛变成这样了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450534
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110450534,
					"content": "#嘿嘿，别没精打采的了，{NICKNAME}，你还有我啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450535
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110450535,
					"content": "还有阿贝多，我很愿意跟你当朋友啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450536
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110450536,
					"content": "…谢谢你们。虽然我不认为排解孤独是生命的必要之举…但，也不坏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450537
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110450537,
					"content": "#{NICKNAME}，是你提供的帮助让我找到了灵感，发现了让它开花的可能性。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450538
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110450538,
					"content": "作为「实验品」的帮助吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450539
					]
				},
				{
					"id": 110450539,
					"content": "不，与你们在雪山上同行的时光，也是一段很有价值的旅途。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450540
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110450540,
					"content": "以后…如果还有需要的话，我还能请你们帮忙吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450541
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110450541,
					"content": "不需要帮忙的时候，也可以找我。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450542
					]
				},
				{
					"id": 110450542,
					"content": "那…就拜托你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450543
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110450543,
					"content": "(test)主角离开，镜头切回阿贝多",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450544
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110450544,
					"content": "#虽然一直在告诉{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}，说实验结果是「平凡」的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450545
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110450545,
					"content": "但这不该出现在瓶底的沉淀，又是怎么一回事呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450546
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110450546,
					"content": "呼吸黑土则污秽，呼吸白垩则无垢。你与我一样，都是未来尚未完全确定的「质料」吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450547
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110450547,
					"content": "如果有一天，失控的我要把蒙德…把一切都毁灭的话——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450548
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110450548,
					"content": "可以期待你来阻止我吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110450532,
					"content": "#（不知道{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTER]}现在怎么样了…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450533
					]
				},
				{
					"id": 110450525,
					"content": "好短暂。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450526
					]
				},
				{
					"id": 110450515,
					"content": "或许吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450516
					]
				},
				{
					"id": 110450509,
					"content": "就只是这样吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450510
					]
				},
				{
					"id": 110450504,
					"content": "被修女拦住了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450505
					]
				},
				{
					"id": 110450505,
					"content": "那没关系，她只是在完成工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450506
					],
					"speakerTitle": "阿贝多"
				}
			]
		},
