			"dialogs": [
				{
					"id": 740812401,
					"content": "要回收的就是这些打孔纸带对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740812402,
					"content": "向瑟维妮出示了回收的打孔纸带…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740812403
					]
				},
				{
					"id": 740812403,
					"content": "没错，就是这些。你们办事可真干练，一点也不拖泥带水。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812404
					],
					"speakerTitle": "瑟维妮"
				},
				{
					"id": 740812404,
					"content": "这么简单的工作，当然是咻咻地就完成啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740812405,
					"content": "那也很了不起了。毫不夸张地说，有些同事真的会花费整整一天的时间，就为了找到一份材料…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812406
					],
					"speakerTitle": "瑟维妮"
				},
				{
					"id": 740812406,
					"content": "不说这些了。这些打孔纸带就麻烦两位送回给希塞蕾前辈了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812407
					],
					"speakerTitle": "瑟维妮"
				},
				{
					"id": 740812407,
					"content": "告诉她我暂时还不会回去。哦，还有，请她联系梅雅德前辈尽快回收这里的试验机。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812408
					],
					"speakerTitle": "瑟维妮"
				},
				{
					"id": 740812408,
					"content": "#好哦。那{NICKNAME}，我们原路返回？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740812409,
					"content": "啊，那倒不必了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812410
					],
					"speakerTitle": "瑟维妮"
				},
				{
					"id": 740812410,
					"content": "两位应该能够潜水吧？其实这边有条水路应该可以出去，之前为了防止踩空暂时封上了，我来帮你们打开通路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812411
					],
					"speakerTitle": "瑟维妮"
				},
				{
					"id": 740812411,
					"content": "#那太好了！{NICKNAME}，我们就从水路回去吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740812412,
					"content": "打开通路的终端在里间，我去就好了。你们自行离开应该没问题吧？不会迷路吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812413
					],
					"speakerTitle": "瑟维妮"
				},
				{
					"id": 740812413,
					"content": "#那你就太小瞧我们了！我可是提瓦特最好的向导，有我在，{NICKNAME}怎么会迷路呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740812414,
					"content": "真可靠呀。那捎信和打孔纸带的事就拜托两位了，我就不远送了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑟维妮"
				}
			]
		},
