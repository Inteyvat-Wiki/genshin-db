			"dialogs": [
				{
					"id": 740813101,
					"content": "你好！关于瑟维妮小姐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740813102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740813102,
					"content": "向希塞蕾说明了情况，并交付了回收的三份打孔纸带…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740813103
					]
				},
				{
					"id": 740813103,
					"content": "我正担心她，在考虑要不要去看看她的情况呢，原来发生了这样的事。谢谢你们带回了她的消息…还有打孔纸带。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740813104
					],
					"speakerTitle": "希塞蕾"
				},
				{
					"id": 740813104,
					"content": "没想到梅雅德的试验机居然还能运作，瑟维妮居然在这样危险的环境中继续工作，我得去找事务员商量回收事宜了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740813105
					],
					"speakerTitle": "希塞蕾"
				},
				{
					"id": 740813105,
					"content": "正好也可以打听一下报销的问题…还是瑟维妮脑子灵光。不过是否合规还得看事务员的判断，所以费用暂且由我垫付吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740813106
					],
					"speakerTitle": "希塞蕾"
				},
				{
					"id": 740813106,
					"content": "不管怎么说，感谢你们的协助，完成委托的报酬还请两位收好。",
