					},
					{
						"sceneId": 3,
						"position": [
							4411.186,
							372.68,
							3834.401
						],
						"pointId": 6386
					}
				]
			},
			"dialogs": [
				{
					"id": 740811701,
					"content": "呃…我们、我们该不会闯大祸了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811702
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740811702,
					"content": "真奇怪，刚才感到一阵晃动…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811703,
						740811704
					],
					"speakerTitle": "瑟维妮"
				},
				{
					"id": 740811703,
					"content": "我也感觉到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811705
					]
				},
				{
					"id": 740811705,
					"content": "唔，可能是因为我们刚才动了上层的装置…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811706
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740811706,
					"content": "这里的门原本是锁上的吧？还特意放了一些发条机关在门口看守…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811707,
						740811708
					],
					"speakerTitle": "瑟维妮"
				},
				{
					"id": 740811707,
					"content": "我请它们休息之后把门打开了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811709
					]
				},
				{
					"id": 740811709,
					"content": "这、这也没办法嘛，是它们先攻击我们的，我们这算是正当防卫？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811710
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740811710,
					"content": "梅雅德前辈的试验机…原本应该是停机状态吧。毕竟前辈自从在伊黎耶岛觅得了一块好场地，就几乎不回来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811711
					],
					"speakerTitle": "瑟维妮"
				},
				{
					"id": 740811711,
					"content": "想想也是，如果能在花园舞池那样风景优美的地方向众人展示研究成果，又有谁会愿意回到这种阴湿破败的研究室来呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811712
					],
					"speakerTitle": "瑟维妮"
				},
				{
					"id": 740811712,
					"content": "博絮埃先生卸任之后，大家就像这里的资材一样四散去了枫丹科学院的各处，就连沙发也没留下一个。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811713
					],
					"speakerTitle": "瑟维妮"
				},
				{
					"id": 740811713,
					"content": "只有试验机还留在这里，等那些不会回来的人。原本只是站在这里待机，对它们来说应该也不算什么吧，不过现在可好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811714
					],
					"speakerTitle": "瑟维妮"
				},
				{
					"id": 740811714,
					"content": "瞧瞧，给打得七零八落，发条都快掉出来啦。要是梅雅德前辈知道了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811715,
						740811716
					],
					"speakerTitle": "瑟维妮"
				},
				{
					"id": 740811715,
					"content": "是我干的，对不起。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811718
					]
				},
				{
					"id": 740811718,
					"content": "对不起…这、这个试验机很贵吗？如果要赔偿的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811719
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740811719,
					"content": "不用紧张。我是想说，梅雅德前辈要是知道了，一定会笑出声的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811720
					],
					"speakerTitle": "瑟维妮"
				},
				{
					"id": 740811720,
					"content": "毕竟他自己以前就常主动打断试验机的舞蹈，被打倒后又坐在原地哈哈大笑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811721
					],
					"speakerTitle": "瑟维妮"
				},
				{
					"id": 740811721,
					"content": "对了，说了这么久，还没自我介绍呢。我是枫丹科学院的研究员，你们可以叫我瑟维妮。两位是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811722
					],
					"speakerTitle": "瑟维妮"
				},
				{
					"id": 740811722,
					"content": "#我是派蒙，{M#他}{F#她}是{NICKNAME}，我们是…呃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811723,
						740811725
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740811723,
					"content": "只是路过而已，绝对没有别的意思。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811724
					]
				},
				{
					"id": 740811724,
					"content": "对！我们只是路过而已，绝对不是以为这里有什么宝藏所以才…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811726
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740811726,
					"content": "哦，你们是说会安排一些寻宝环节的废墟旅游？那你们可找错地方了，这里虽然看起来像废墟…不，实际上也是废墟吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811727
					],
					"speakerTitle": "瑟维妮"
				},
				{
					"id": 740811727,
					"content": "但是这里还没有被纳入废墟旅游的推荐地点哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811728
					],
					"speakerTitle": "瑟维妮"
				},
				{
					"id": 740811728,
					"content": "好吧，那我们现在就走…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811729
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740811729,
					"content": "…等等，你们知道新枫丹科学院吧？要走的话正好帮我一个忙，去新枫丹科学院找到希塞蕾前辈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811730,
						740811731
					],
					"speakerTitle": "瑟维妮"
				},
				{
					"id": 740811730,
					"content": "可是我们不去新枫丹科学院。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811732
					]
				},
				{
					"id": 740811732,
					"content": "这可怎么办呢，我还有工作没处理完，梅雅德前辈的试验机又被打坏了，需要尽快找人回收…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811733
					],
					"speakerTitle": "瑟维妮"
				},
				{
					"id": 740811733,
					"content": "#唔唔…{NICKNAME}，不然我们还是帮她这个忙吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811734
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740811734,
					"content": "太好了！既然你们同意帮忙捎话，那回收打孔纸带的工作也拜托你们好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811735,
						740811736
					],
					"speakerTitle": "瑟维妮"
				},
				{
					"id": 740811735,
					"content": "早知道不乱动外边的装置了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811746
					]
				},
				{
					"id": 740811746,
					"content": "别这么说嘛，反正不是什么难事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811737
					],
					"speakerTitle": "瑟维妮"
				},
				{
					"id": 740811737,
					"content": "有了帮忙回收研究资料的名头，委托的报酬就可以报销了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811738
					],
					"speakerTitle": "瑟维妮"
				},
				{
					"id": 740811738,
					"content": "欸？这么做真的没问题吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811739
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740811739,
					"content": "毕竟确实协助了研究工作，名正言顺，当然没问题啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811740
					],
					"speakerTitle": "瑟维妮"
				},
				{
					"id": 740811740,
					"content": "而且如果真的不合规的话，会被事务员驳回的。那时就只好我自行承担委托的费用了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811741
					],
					"speakerTitle": "瑟维妮"
				},
				{
					"id": 740811741,
					"content": "你们经常做这种事吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811742
					]
				},
				{
					"id": 740811742,
					"content": "我本人是没有啦。其他人的话我就不知道了，以前确实听过一些传闻，不过…哎呀，这也不是值得和外人讲的消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811743
					],
					"speakerTitle": "瑟维妮"
				},
				{
					"id": 740811743,
					"content": "要回收的打孔纸带有三份。应该说，书架上只有三份打孔纸带了。应该很容易就能找到的，就麻烦两位了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811744
					],
					"speakerTitle": "瑟维妮"
				},
				{
					"id": 740811744,
					"content": "在此期间，我得再检查一下试验机，毕竟很久都没人维护过它们了…如果失控了就不好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811745
					],
					"speakerTitle": "瑟维妮"
				},
				{
					"id": 740811745,
					"content": "好吧，那我们回收完打孔纸带再来找你确认。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740811736,
					"content": "没问题，交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811737
					]
				},
				{
					"id": 740811731,
					"content": "我们还有别的宝藏要找。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811732
					]
				},
				{
					"id": 740811725,
					"content": "请问这里有宝藏吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811726
					]
				},
				{
					"id": 740811716,
					"content": "有考虑对试验机的强度进行升级吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811717
					]
				},
				{
					"id": 740811717,
					"content": "梅雅德前辈的确这样做了。或许最终的成品能够符合你对强度的预期。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811718
					],
					"speakerTitle": "瑟维妮"
				},
				{
					"id": 740811708,
					"content": "是啊，真奇怪，门怎么打开了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811709
					]
				},
				{
					"id": 740811704,
					"content": "是你的错觉吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811705
					]
				}
			]
		},
