			},
			"dialogs": [
				{
					"id": 761260101,
					"content": "雅珂达？还有…祖潘科先生，请问您有什么事么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260102
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 761260102,
					"content": "我…呃…那个…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260103
					],
					"speakerTitle": "祖潘科"
				},
				{
					"id": 761260103,
					"content": "他想去「霜月之子」里玩一玩，但又不好意思，所以想要拜托你帮忙啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260104
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761260104,
					"content": "是！是，就是这样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260105
					],
					"speakerTitle": "祖潘科"
				},
				{
					"id": 761260105,
					"content": "您好，莉莉希小姐！很高兴见到您，呃…这是我从纳塔带来的…化石标本！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260106
					],
					"speakerTitle": "祖潘科"
				},
				{
					"id": 761260106,
					"content": "谢谢您，可…祖潘科先生，我早就认识您了呀，您真的不用这么客气的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260107
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 761260107,
					"content": "啊？您又是怎么发现我的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260108
					],
					"speakerTitle": "祖潘科"
				},
				{
					"id": 761260108,
					"content": "我之前发放餐食的时候，您不是在旁边看吗？转悠来，转悠去，但就是不站进队里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260109
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 761260109,
					"content": "我还以为您也想拿，但又不好意思上前，所以还特意悄悄留了一份给您了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260110
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 761260110,
					"content": "但…您从来也没来拿过餐。要是您今天不来，我也要拜托人去问问您，有什么需要帮助的了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260111
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 761260111,
					"content": "这…这…真是抱歉，我是在犹豫，到底怎么打招呼呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260112
					],
					"speakerTitle": "祖潘科"
				},
				{
					"id": 761260112,
					"content": "所以，莉莉希小姐，我能去「霜月之子」看看么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260113
					],
					"speakerTitle": "祖潘科"
				},
				{
					"id": 761260113,
					"content": "可以呀，我们「霜月之子」里本来也有几位外来的客人。但您要去做什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260114
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 761260114,
					"content": "留个影，查查资料，如果可能的话…再找人询问一下传说故事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260115
					],
					"speakerTitle": "祖潘科"
				},
				{
					"id": 761260115,
					"content": "我是纳塔「龙遗物研究协会」的成员，如果能搜集到一些和我的研究方向有关的资料，那就最好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260116
					],
					"speakerTitle": "祖潘科"
				},
				{
					"id": 761260116,
					"content": "喔…那你就是要去看书喽？我想想啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260117
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 761260117,
					"content": "你们聊的这么开心，那这趟委托就算结束喽，我也要回去给老板汇报了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260118
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761260118,
					"content": "谢谢你，雅珂达小姐！那个…费用我还是会付的，怎么能让您白跑一趟呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260119
					],
					"speakerTitle": "祖潘科"
				},
				{
					"id": 761260119,
					"content": "回去的时候，也请务必向奈芙尔老板转达我的谢意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260120
					],
					"speakerTitle": "祖潘科"
				},
				{
					"id": 761260120,
					"content": "好说好说，那我就先走了，两位聊得开心啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雅珂达"
				}
			]
		},
