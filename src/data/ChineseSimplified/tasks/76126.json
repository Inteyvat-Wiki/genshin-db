							9492.938
						],
						"pointId": 14110
					}
				]
			},
			"dialogs": [
				{
					"id": 761260201,
					"content": "啊…雅珂达？你怎么来了？呃…奈芙尔老板现在有空吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260202
					],
					"speakerTitle": "祖潘科"
				},
				{
					"id": 761260202,
					"content": "（果然想去找奈姐…哼哼，这么点小事，我自己就能搞定。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260203
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761260203,
					"content": "不用这么麻烦啦，就是老板派我来帮你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260204
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761260204,
					"content": "欸？您、您说什么，难道奈芙尔老板已经…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260205
					],
					"speakerTitle": "祖潘科"
				},
				{
					"id": 761260205,
					"content": "你一直想要去「霜月之子」那边拜访，没错吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260206
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761260206,
					"content": "所以，你想先和莉莉希搞好关系，再拜托她把你带去「霜月之子」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260207
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761260207,
					"content": "啊？！奈芙尔老板都知道了？我明明都把这事憋在心里，没怎么和人说呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260208
					],
					"speakerTitle": "祖潘科"
				},
				{
					"id": 761260208,
					"content": "（这个时候就要说那句特别帅的话！奈姐怎么说的来着…嗯…噢！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260209
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761260209,
					"content": "哼哼，祖潘科先生，人在保守秘密时，也要学会隐瞒「正在保守秘密」这件事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260210
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761260210,
					"content": "不然的话，你在心里竖起的那道墙，迟早会开始漏风。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260211
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761260211,
					"content": "唉，我在家乡的时候，就不怎么会隐瞒心思…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260212
					],
					"speakerTitle": "祖潘科"
				},
				{
					"id": 761260212,
					"content": "（说出来了！不亏我练了那么久，嘿嘿嘿嘿嘿——）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260213
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761260213,
					"content": "算了，既然您都知道了，那您能帮我引荐一下吗？我是外乡人，贸然去打扰莉莉希小姐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260214
					],
					"speakerTitle": "祖潘科"
				},
				{
					"id": 761260214,
					"content": "放心啦，莉莉希可好了，别说来访者是外乡人，就算不是人，她都会温柔地接待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260215
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761260215,
					"content": "啊？真的假的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260216
					],
					"speakerTitle": "祖潘科"
				},
				{
					"id": 761260216,
					"content": "但无论如何，贸然打搅总是不太礼貌…呃，您要是认识她的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260217
					],
					"speakerTitle": "祖潘科"
				},
				{
					"id": 761260217,
					"content": "当然认识喽，现在她们应该刚好发放完了餐食，我们现在就去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260218
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761260218,
					"content": "啊…老板还说，这一次就不用收费了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260219
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761260219,
					"content": "谢谢您！我这就去收拾东西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "祖潘科"
				}
			]
		}
	]
}