	"talks": [
		{
			"id": 4113101,
			"completionStepIds": [
				4113122
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4113101",
							"2"
						],
						"stepId": 4113101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"伊凡诺维奇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411310101,
					"content": "嗯…不错，这生意准能大赚一笔。但是还有个小问题…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310102
					],
					"speakerTitle": "伊凡诺维奇"
				},
				{
					"id": 411310102,
					"content": "什么问题？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310103
					]
				},
				{
					"id": 411310103,
					"content": "嗯？哦…旅行者，是你啊，你来得正好！你有兴趣参与一场…一场…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310107
					],
					"speakerTitle": "伊凡诺维奇"
				},
				{
					"id": 411310107,
					"content": "一场…神奇的…伟大的…前所未有，必定能大赚特赚的生意吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310108
					],
					"speakerTitle": "伊凡诺维奇"
				},
				{
					"id": 411310108,
					"content": "只需要你帮我一个小小的忙。我们俩必然都能赚得盆满钵满。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310104,
						411310109
					],
					"speakerTitle": "伊凡诺维奇"
				},
				{
					"id": 411310104,
					"content": "北国银行守卫森严。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310105
					]
				},
				{
					"id": 411310105,
					"content": "啊，那是当然，连守卫都是至冬国人，我…不！不，您在想什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310106
					],
					"speakerTitle": "伊凡诺维奇"
				},
				{
					"id": 411310106,
					"content": "看来四处旅行确实让您的思维开阔了不少，您的想法实在是颇富想象力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310112
					],
					"speakerTitle": "伊凡诺维奇"
				},
				{
					"id": 411310112,
					"content": "但我这次的生意计划，绝对是脚踏实地的扎实计划。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310113
					],
					"speakerTitle": "伊凡诺维奇"
				},
				{
					"id": 411310113,
					"content": "您知道最近从天而降的那些陨石吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310114
					],
					"speakerTitle": "伊凡诺维奇"
				},
				{
					"id": 411310114,
					"content": "我想要去找到一块陨石，从上面敲下来几块带回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310115
					],
					"speakerTitle": "伊凡诺维奇"
				},
				{
					"id": 411310115,
					"content": "然后，再找个能工巧匠，将它雕刻琢磨，制成首饰…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310116
					],
					"speakerTitle": "伊凡诺维奇"
				},
				{
					"id": 411310116,
					"content": "一副由陨石制成的首饰…无论是戒指、项链、手环还是耳环，准能让那些有钱人们爽快掏钱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310117
					],
					"speakerTitle": "伊凡诺维奇"
				},
				{
					"id": 411310117,
					"content": "旅行者，你要做的事很简单，只要保证我不受怪物干扰就行了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310118
					],
					"speakerTitle": "伊凡诺维奇"
				},
				{
					"id": 411310118,
					"content": "怎么样，我们俩就此成交？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310119
					],
					"speakerTitle": "伊凡诺维奇"
				},
				{
					"id": 411310119,
					"content": "绝不能接近陨石。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310120
					]
				},
				{
					"id": 411310120,
					"content": "什么？为什么，这笔大生意我绝不会放过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊凡诺维奇"
				},
				{
					"id": 411310109,
					"content": "法典里有什么新发现？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310110
					]
				},
				{
					"id": 411310110,
					"content": "唔，老实说，璃月的法典颇为严谨，几乎没有漏洞，但…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310111
					],
					"speakerTitle": "伊凡诺维奇"
				},
				{
					"id": 411310111,
					"content": "呃，不！不，我做的事，绝对是在法典允许的范围内。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310106
					],
					"speakerTitle": "伊凡诺维奇"
				}
			]
		},
		{
			"id": 4113102,
			"completionStepIds": [
				4113102
			],
