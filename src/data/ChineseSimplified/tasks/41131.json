				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411310201,
					"content": "那里有很多魔物。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310202
					]
				},
				{
					"id": 411310202,
					"content": "这正是我想要雇佣你的原因，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊凡诺维奇"
				}
			]
		},
		{
			"id": 4113103,
			"completionStepIds": [
				4113103
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4113101",
							"2"
						],
						"stepId": 4113101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"伊凡诺维奇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411310301,
					"content": "别人也会想到做这个生意…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310302
					]
				},
				{
					"id": 411310302,
					"content": "哦，当然，所以我们才要尽快到那边去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310303
					],
					"speakerTitle": "伊凡诺维奇"
				},
				{
					"id": 411310303,
					"content": "旅行者，如果你愿意，我们尽快出发。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310304
					],
					"speakerTitle": "伊凡诺维奇"
				},
				{
					"id": 411310304,
					"content": "我们在这里多磨嘴皮子一秒，我说不定就会少赚一摩拉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310305
					],
					"speakerTitle": "伊凡诺维奇"
				},
				{
					"id": 411310305,
					"content": "…呜哇…这样应该没法说服他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411310306,
					"content": "如果能让他知道，这笔生意赚不了钱，或者…陨石真的很危险就好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4113104,
			"completionStepIds": [
				4113104
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4113101",
							"2"
						],
						"stepId": 4113101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"伊凡诺维奇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411310401,
					"content": "摸到陨石就会昏睡过去…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310402
					]
				},
				{
					"id": 411310402,
					"content": "嗯？啊…我倒是对这传闻有所耳闻，这可是个问题…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310403
					],
					"speakerTitle": "伊凡诺维奇"
				},
				{
					"id": 411310403,
					"content": "但是，我相信一定有器械能解决这个问题，呃…应该有吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310404
					],
					"speakerTitle": "伊凡诺维奇"
				},
				{
					"id": 411310404,
					"content": "…哎，他好像有点动摇了，难道…是在权衡做这笔生意的成本吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411310405,
					"content": "就这样说服他，告诉他这笔生意绝对赚不了钱，还有…那个陨石真的很危险。",
					"roleType": "TALK_ROLE_NPC",
