					"content": "我知道了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411311110
					]
				},
				{
					"id": 411311110,
					"content": "那就拜托你了，这么大的商机，我可不能完全放过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊凡诺维奇"
				},
				{
					"id": 411311111,
