			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"爱拉尼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718100101,
					"content": "呜…这压根就没办法写论文嘛，怎么办才好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100102
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 718100102,
					"content": "你怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100103
					]
				},
				{
					"id": 718100103,
					"content": "我…咦？是你啊！你还记得我吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100104
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 718100104,
					"content": "就是那个，在灵矩关被盗宝团关在笼子里…的人…哈哈…总之，谢谢你救了我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100105
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 718100105,
					"content": "你怎么在这？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100106
					]
				},
				{
					"id": 718100106,
					"content": "哎呀，上次被你救了之后，我就去望舒客栈找索拉雅小姐了，我运气还不错，正好找到她了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100107
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 718100107,
					"content": "索拉雅小姐真是个好人呐，不仅请我吃了东西，还帮我整理了我搜集到的资料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100108
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 718100108,
					"content": "不过…整理到最后她告诉我，我选的这个课题，在教令院里已经有好多人写过了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100109
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 718100109,
					"content": "除非我写得非常出彩，不然肯定没法顺利过关…她建议我换个切入角度来写，比如元素力什么的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100110
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 718100110,
					"content": "但我又没有「神之眼」，没法使用元素力，完全不知道怎么切入…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100111
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 718100111,
					"content": "所以我只能先来城里碰碰运气，看能不能再找到点资料什么的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100112
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 718100112,
					"content": "等等…之前，你在救我的时候，战斗方式好像很特别…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100113
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 718100113,
					"content": "你拥有「神之眼」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100114
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 718100114,
					"content": "我没有「神之眼」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100115
					]
				},
				{
					"id": 718100115,
					"content": "咦？你没有「神之眼」都可以用那种方式战斗吗？这到底是什么原理…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100116
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 718100116,
					"content": "不，先不管是什么原理，肯定是非常复杂的原理…总之，我有件事要拜托你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100117
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 718100117,
					"content": "你可以再向我展示一下你的战斗方式吗？说不定，我能找到一些有用的细节，完善我的那篇论文…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100118
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 718100118,
					"content": "拜托、拜托，我再不完成这篇论文，回去教令院我一定会完蛋的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100119,
						718100122
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 718100119,
					"content": "好吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100120
					]
				},
				{
					"id": 718100120,
					"content": "谢谢你！那我们就去野外吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100121
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 718100121,
					"content": "我之前注意到了一个丘丘人的聚落，你就以它们为目标，向我展示一下你的战斗方式吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 718100122,
					"content": "教令院…有这么可怕吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100123
					]
				},
				{
					"id": 718100123,
					"content": "非常可怕喔，非常的可怕…如果做梦梦到的话，我一定会哭着醒过来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100124
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 718100124,
					"content": "我宁愿被盗宝团关在笼子里，也不想再去做论文答辩和改论文。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100125
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 718100125,
					"content": "好了好了，不要再说教令院了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100126
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 718100126,
					"content": "我之前注意到了一个丘丘人的聚落，你就以它们为目标，向我展示一下你的战斗方式吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "爱拉尼"
				}
			]
		},
		{
			"id": 7181002,
			"completionStepIds": [
				7181003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181003",
							"2"
						],
						"stepId": 7181003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"爱拉尼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718100201,
					"content": "哇…你的战斗方式还真特别。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100202
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 718100202,
					"content": "对了，我听说「神之眼」的持有者还能感知到元素的痕迹，说是叫「元素视野」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100203
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 718100203,
					"content": "虽然你没有「神之眼」，但上次我看见你使用了元素的力量…你应该也有这种能力吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100204
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 718100204,
					"content": "嘿嘿，我刚才发现这周围有一些史莱姆，拜托你，再向我展示一下「元素视野」…用「元素视野」来找到它们吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "爱拉尼"
				}
			]
		},
		{
			"id": 7181003,
			"completionStepIds": [
				7181009
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181009",
							"2"
						],
						"stepId": 7181009,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"爱拉尼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718100301,
					"content": "哈哈哈…在我这种没有「神之眼」的人看来，你开启「元素视野」的时候和平时也没什么不同…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100302
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 718100302,
					"content": "唔，也许只有拥有「神之眼」的人才能看出不同来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100303
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 718100303,
					"content": "不过，还是谢谢你展示了这么多东西给我看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100304
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 718100304,
					"content": "唉，我真想要个「神之眼」啊…最好是「雷」属性的那种，又帅气又能防身。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100305
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 718100305,
					"content": "不对，雷属性的「神之眼」，应该最不可能了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100306
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 718100306,
					"content": "只要努力的话就会有的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100307
					]
				},
				{
					"id": 718100307,
					"content": "不可能的啦，雷属性的「神之眼」就算努力也拿不到的啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100308
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 718100308,
					"content": "咦？你，你不知道吗？从大概一年前开始，好像就再没有人获授雷属性的「神之眼」了喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100309
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 718100309,
					"content": "据说教令院还专门为这个事研究了很久，最后的结论是…不再向人授予「神之眼」这件事，是那位「雷之神」的意志。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100310
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 718100310,
					"content": "而且我听人说，那位统御着稻妻的「雷之神」，还颁布了一条「眼狩令」。说是要把稻妻里大部分「神之眼」持有者的「神之眼」都收上去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100311
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 718100311,
					"content": "要是「神之眼」持有者拒不上交的话，好像还会被重重责罚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100312
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 718100312,
					"content": "虽然我曾经想去稻妻以这个为主题写一篇论文。但，但是…稻妻听起来好危险，我还是有点不敢去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100313
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 718100313,
					"content": "你没有「神之眼」，没关系。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100314
					]
				},
				{
					"id": 718100314,
					"content": "别这么说我啦！而且你想，有「神之眼」的人都这么惨，没「神之眼」的人，那不就会更惨了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100315
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 718100315,
					"content": "我还是安心在璃月把论文搞定，然后赶紧回须弥去教令院交差吧，再拖久一点，我又不知道要听多少唠叨了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100316
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 718100316,
					"content": "对了，还得谢谢你专门为我展示这么多东西，这些给你，就当是谢礼啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100317
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 718100317,
					"content": "这次，我一定能把论文给完全搞定！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "爱拉尼"
				}
			]
		}
	]
}