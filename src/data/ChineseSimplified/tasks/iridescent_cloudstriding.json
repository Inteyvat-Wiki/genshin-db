					}
				]
			},
			"dialogs": [
				{
					"id": 715320101,
					"content": "两位，说书人学徒卷舒恳请你们留步——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320102
					],
					"speakerTitle": "卷舒"
				},
				{
					"id": 715320102,
					"content": "你们可曾听说过这样一则传闻？「海灯节的良宵之时，曾有蹈跃的焰光在夜空中挥笔作画，描绘盛美的图卷…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320103
					],
					"speakerTitle": "卷舒"
				},
				{
					"id": 715320103,
					"content": "没，没听懂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715320104,
					"content": "焰光？在天空中作画？一般人根本做不到这种事吧…就算坐着那什么飞艇，也没有可以浮在天上的神奇颜料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715320105,
					"content": "听起来像是很夸张的比方！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320106,
						715320107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715320106,
					"content": "感觉不是一般的画？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715320108
					]
				},
				{
					"id": 715320108,
					"content": "#总之！这则传闻的主角就是你们两位，闻名遐迩的旅行者{NICKNAME}和{M#他}{F#她}的伙伴派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320109
					],
					"speakerTitle": "卷舒"
				},
				{
					"id": 715320109,
					"content": "咦？怎么话题突然转向了我们？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715320110,
					"content": "也许你们已经忘记了，去年你们接受了冒险家甜甜的委托，参与了一场特别的竞速挑战。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320111
					],
					"speakerTitle": "卷舒"
				},
				{
					"id": 715320111,
					"content": "那场竞速挑战被漂亮的烟花点缀，蔚为壮观，成了难得一见的美景。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320112
					],
					"speakerTitle": "卷舒"
				},
				{
					"id": 715320112,
					"content": "这么说来，我隐约记得，当时我们只是举手之劳，帮了帮那位冒险家协会的宣传员…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715320113,
					"content": "她说要借助那场活动来吸引新的成员，也不知道她后来有没有成功。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320114,
						715320115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715320114,
					"content": "好像有这事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715320116
					]
				},
				{
					"id": 715320116,
					"content": "当时我在望舒客栈附近喝闷酒，仰望到了你们被烟花点亮的身影…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320117
					],
					"speakerTitle": "卷舒"
				},
				{
					"id": 715320117,
					"content": "一瞬间，考试落榜的哀愁，对前路的迷茫，都被你们那充满朝气、光芒万丈的身姿给驱散了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320118
					],
					"speakerTitle": "卷舒"
				},
				{
					"id": 715320118,
					"content": "所以我才打起精神，继续我的民俗研究，来到这沉玉谷，深入探索我热爱的课题…感谢你们的鼓励！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320119
					],
					"speakerTitle": "卷舒"
				},
				{
					"id": 715320119,
					"content": "除了我以外，还有不少被你们的身影吸引，加入冒险家协会的人，他们也找到了人生的新方向！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320120
					],
					"speakerTitle": "卷舒"
				},
				{
					"id": 715320120,
					"content": "完，完全没想到！我们当时都没注意到远处有人在看，也没想过，我们只是参与了竞速挑战，就能给别人加油打气！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715320121,
					"content": "你说得这么夸张，我们都有点不好意思了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320122,
						715320123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715320122,
					"content": "打起精神就好啦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715320124
					]
				},
				{
					"id": 715320124,
					"content": "今天偶遇两位，实属三生有幸。我想麻烦两位一件事，并对两位表示真挚的感谢——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320125
					],
					"speakerTitle": "卷舒"
				},
				{
					"id": 715320125,
					"content": "请两位将你们的光辉传递下去，继续鼓舞更多人吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320126
					],
					"speakerTitle": "卷舒"
				},
				{
					"id": 715320126,
					"content": "虽然我们好像没有你说得那么伟大啦，但你的想法很好很好，能让更多人心情变好的话，我们当然超级乐意！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715320127,
					"content": "话说回来，我们要怎么做呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715320128,
					"content": "遵循惯例，我参考了甜甜规划的竞速挑战，联合被你们鼓舞的冒险家们，共同规划了一种全新的活动「熠光云行」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320129
					],
					"speakerTitle": "卷舒"
				},
				{
					"id": 715320129,
					"content": "在这沉玉谷之中，也有着诸多奇妙之物，其中就有一种奇妙的鲤鱼，能让人借助它的力量快速穿行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320130
					],
					"speakerTitle": "卷舒"
				},
				{
					"id": 715320130,
					"content": "两位只需要像往常那样，尽情在山间与空中穿梭，将你们的利落身姿和朝气展示给更多人就好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320131,
						715320132
					],
					"speakerTitle": "卷舒"
				},
				{
					"id": 715320131,
					"content": "举手之劳！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715320133
					]
				},
				{
					"id": 715320133,
					"content": "当然，除了我这份摩拉的谢礼，我们还给两位准备了各种酬劳，聊表我们的心意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320134
					],
					"speakerTitle": "卷舒"
				},
				{
					"id": 715320134,
					"content": "对于两位传递希望，令人振奋的事迹而言，这些谢礼或许并不丰厚，但并不是全部。我们以后还会找机会报答两位的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320135
					],
					"speakerTitle": "卷舒"
				},
				{
					"id": 715320135,
					"content": "#嘿嘿，你也太客气啦！就算拿不到多少好处，我和{NICKNAME}也会一直旅行下去，尽量帮助每个迷茫的人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320136
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715320136,
					"content": "听卷舒小姐这么一说，总觉得冒险都更有干劲了！我们就试试她说的「熠光云行」吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715320132,
					"content": "非常乐意！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715320133
					]
				},
				{
					"id": 715320123,
					"content": "恭喜你振作起来。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715320124
					]
				},
				{
					"id": 715320115,
					"content": "那么重点是？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715320116
					]
				},
				{
					"id": 715320107,
					"content": "难不成说的是烟花？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715320108
					]
				}
			]
		}
	]
}