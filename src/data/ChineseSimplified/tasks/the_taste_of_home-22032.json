					"汤雯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220320101,
					"content": "唔…要是能吃到璃月菜就好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320102
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220320102,
					"content": "你怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320103
					]
				},
				{
					"id": 220320103,
					"content": "你是？这身打扮…你就是旅行者吧。抱歉，我就是有点想家了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320104,
						220320105
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220320104,
					"content": "你刚刚说想吃璃月菜？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320118
					]
				},
				{
					"id": 220320118,
					"content": "欸？莫非...你会做璃月菜吗？那太好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320119
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220320119,
					"content": "那、那就请你快点帮帮我，做点正宗的璃月菜给我吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320120
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220320120,
					"content": "让我想想...我现在的最想吃的就是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320121
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220320121,
					"content": "嗯…我想要吃鱼！想起小时候妈妈做的鱼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320122
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220320122,
					"content": "鱼身洗净，两边打上花刀，塞入香料和老酒稍加腌制，入锅煎至两面金黄…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320123
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220320123,
					"content": "再加热水和酱料炖煮，最后大火调味收汁，勾芡装盘…啊！那可是真真正正的色香味俱全！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320124
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220320124,
					"content": "还小的弟弟在旁边闻着，都拍手跳着直叫：「正好！正好！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320125
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220320125,
					"content": "呜…我妈妈可会烧鱼了，但我什么时候才能回去吃呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220320105,
					"content": "遇到什么麻烦了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320106
					]
				},
				{
					"id": 220320106,
					"content": "先自我介绍一下，我叫汤雯，是来自璃月的历史学者，之前正在实地调研稻妻的特色风俗与民话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320107
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220320107,
					"content": "本来资料已经搜集的差不多了，正准备返回璃月。但是因为稻妻的锁国令结被迫滞留在这里，已经有一段时间了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320108
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220320108,
					"content": "其实，我觉得这对我来说也算是好事。因为我感觉，此刻的稻妻正处于一个历史性的时刻！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320109
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220320109,
					"content": "我很确信，这段特殊的时期，必然会在提瓦特的史册上留下浓墨重彩的一笔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320110
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220320110,
					"content": "亲眼见证这样的历史，然后真实、完整、清晰地将这一切记录成册，留给后人，就是历史学者所要做的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320111
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220320111,
					"content": "不过…虽然这样的事业很让我振奋，但它可没法满足我的肚子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320112
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220320112,
					"content": "你是饿了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320113
					]
				},
				{
					"id": 220320113,
					"content": "也不能说…是饿啦…哈哈哈，稻妻的食物都还挺好吃的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320114
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220320114,
					"content": "我特别喜欢这边的「天妇罗」，虽然感觉…就是裹上面衣炸一切啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320115
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220320115,
					"content": "但是吃久了稻妻菜，我还是想要再吃点璃月菜。不过，我一直都找不到能做出正宗璃月菜的餐馆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320116
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220320116,
					"content": "我前几天都狠下心来，去冒险家协会挂了一道「烹饪委托」，但到现在也没回音…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320117
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220320117,
					"content": "我可以试试吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320118
					]
				}
			]
		},
		{
