			"dialogs": [
				{
					"id": 220320501,
					"content": "欸？这、这应该还是稻妻的菜吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320502
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220320502,
					"content": "我记得我要的好像不是这道菜来着…唔，算了，这道菜也能填饱肚子就是了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320503
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220320503,
					"content": "还是谢谢你了，旅行者，这些东西请收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "汤雯"
