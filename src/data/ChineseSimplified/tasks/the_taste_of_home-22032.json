			"dialogs": [
				{
					"id": 220320601,
					"content": "咦？这、这道菜的味道怎么…这么…这么微妙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320602
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220320602,
					"content": "也不能说是微妙…应该是说…奇异，还是什么的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320603
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220320603,
					"content": "居然能做出这样的菜，你的厨艺还真是…另辟蹊径呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320604
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220320604,
					"content": "辛苦你了！旅行者，这些东西请收下吧，这道菜我稍后…稍后再细细品尝…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "汤雯"
				}
			]
		},
		{
