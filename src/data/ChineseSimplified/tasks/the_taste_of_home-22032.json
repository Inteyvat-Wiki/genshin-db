			"trigger": {
				"objectNames": [
					"汤雯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220320801,
					"content": "唔…要是能吃到璃月菜就好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320802
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220320802,
					"content": "你怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320803
					]
				},
				{
					"id": 220320803,
					"content": "你是？这身打扮…你就是旅行者吧。抱歉，我就是有点想家了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320804,
						220320805
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220320804,
					"content": "你刚刚说想吃璃月菜？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320818
					]
				},
				{
					"id": 220320818,
					"content": "欸？莫非...你会做璃月菜吗？那太好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320819
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220320819,
					"content": "那、那就请你快点帮帮我，做点正宗的璃月菜给我吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320820
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220320820,
					"content": "让我想想...我现在的最想吃的就是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320821
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220320821,
					"content": "嗯…我想要吃鱼！想起小时候妈妈做的鱼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320822
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220320822,
					"content": "鱼身洗净，两边打上花刀，塞入香料和老酒稍加腌制，入锅煎至两面金黄…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320823
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220320823,
					"content": "再加热水和酱料炖煮，最后大火调味收汁，勾芡装盘…啊！那可是真真正正的色香味俱全！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320824
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220320824,
					"content": "还小的弟弟在旁边闻着，都拍手跳着直叫：「正好！正好！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320825
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220320825,
					"content": "呜…我妈妈可会烧鱼了，但我什么时候才能回去吃呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220320805,
					"content": "遇到什么麻烦了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320806
					]
				},
				{
					"id": 220320806,
					"content": "先自我介绍一下，我叫汤雯，是来自璃月的历史学者，之前正在实地调研稻妻的特色风俗与民话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320807
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220320807,
					"content": "本来资料已经搜集的差不多了，正准备返回璃月。但是因为最近稻妻发生了很多大事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320808
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220320808,
					"content": "我感觉，此刻的稻妻正处于一个历史性的时刻！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320809
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220320809,
					"content": "这段特殊的时期，必然会在提瓦特的史册上留下浓墨重彩的一笔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320810
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220320810,
					"content": "亲眼见证这样的历史，然后真实、完整、清晰地将这一切记录成册，留给后人，就是历史学者所要做的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320811
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220320811,
					"content": "不过…虽然这样的事业很让我振奋，但它可没法满足我的肚子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320812
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220320812,
					"content": "你是饿了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320813
					]
				},
				{
					"id": 220320813,
					"content": "也不能说…是饿啦…哈哈哈，稻妻的食物都还挺好吃的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320814
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220320814,
					"content": "我特别喜欢这边的「天妇罗」，虽然感觉…就是裹上面衣炸一切啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320815
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220320815,
					"content": "但是吃久了稻妻菜，我还是想要再吃点璃月菜。不过，我一直都找不到能做出正宗璃月菜的餐馆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320816
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220320816,
					"content": "我前几天都狠下心来，去冒险家协会挂了一道「烹饪委托」，但到现在也没回音…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320817
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220320817,
					"content": "我可以试试吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320818
					]
				}
			]
		}
	]
