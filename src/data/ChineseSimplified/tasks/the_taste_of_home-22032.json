			},
			"dialogs": [
				{
					"id": 220320301,
					"content": "啊！没错！这、这就是我梦寐以求的家乡味道啊…真是…呜呜…真是令人感动…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320302
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220320302,
					"content": "谢谢你！有了这些好吃的，我也能提起劲了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320303
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220320303,
					"content": "这些送给你，祝你往后的旅程顺遂无忧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "汤雯"
				}
			]
		},
		{
