			"dialogs": [
				{
					"id": 220320201,
					"content": "这么快就回来了？你不会是个隐藏身份的大厨吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320202
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220320202,
					"content": "嗯...我都快要等不及了，请让我尝一尝！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320203,
						220320204
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220320203,
					"content": "请享用。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220320204,
					"content": "我想想...刚刚讨论了哪些菜？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320205
					]
				},
				{
					"id": 220320205,
					"content": "唔…是松鼠鱼，水煮黑背鲈，还有蒙德烤鱼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220320206,
					"content": "决定好就交给汤雯小姐吧!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
