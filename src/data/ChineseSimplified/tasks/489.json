			"trigger": {
				"objectNames": [
					"莎拉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4890101,
					"content": "我知道啦，我马上就出发！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890102
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4890102,
					"content": "是安柏！你是来处理委托的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4890103,
					"content": "哇，是你们。我正准备去呢，清理商路上的丘丘人什么的，交给侦察骑士再合适不过了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890104
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4890104,
					"content": "唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890105
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 4890105,
					"content": "莎拉小姐…为什么还是很苦恼的样子？放心啦，侦察骑士的实力不会让你失望的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890106
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4890106,
					"content": "哦、哦不是这样的，我没有怀疑你的实力，只是眼下的订单实在太多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890107
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 4890107,
					"content": "就在刚才，又新来了一份奇怪的订单，看起来好像是要准备一整场宴会的量…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890108
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 4890108,
					"content": "咳咳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890109
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4890109,
					"content": "还有什么可以帮忙的吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4890110
					]
				},
				{
					"id": 4890110,
					"content": "其实我也可以帮忙做饭！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4890111
					]
				},
				{
					"id": 4890111,
					"content": "真的吗！你愿意帮忙吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890112
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 4890112,
					"content": "太好了，你简直就是「猎鹿人」的恩人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890113
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 4890113,
					"content": "唔…我怎么觉得我的风头被抢了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890114
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4890114,
					"content": "那这份新的订单就交给你了，先从收集食材开始吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890115
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 4890115,
					"content": "#可是…{NICKNAME}真的可以吗，料理的口味什么的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4890116,
					"content": "顾不上那么多啦，这可是事关「猎鹿人」声誉的战斗，挑三拣四什么的是不行的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890117
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 4890117,
					"content": "战、战斗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4890118,
					"content": "料理需要<color=#00E1FFFF>三份甜甜花和三份禽肉</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890119
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 4890119,
					"content": "好了快去准备吧，还有安柏小姐那边也是，我在这里等你们哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890120
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 4890120,
					"content": "哦…哦、哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安柏"
				}
			]
		},
