						4890203
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 4890203,
					"content": "然后…7号订单的一份<color=#00E1FFFF>甜甜花酿鸡</color>，谢谢啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890204
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 4890204,
					"content": "真把人家当厨子呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4890205,
					"content": "都说好要给「猎鹿人」帮忙了嘛，做好趁热送过来哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
