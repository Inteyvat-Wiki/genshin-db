						731050804
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731050804,
					"content": "你认识她吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050805
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731050805,
					"content": "嗯…也谈不上认识，但我听人提起过，她是一个很奇怪的盗宝团成员。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050806
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731050806,
					"content": "据说，她劫掠行人的时候，会向被劫掠的人提一个问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050807
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731050807,
					"content": "问题的范围从文学到元素，乱七八糟的什么都有，甚至…甚至还有那种「头脑急转弯」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050808
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731050808,
					"content": "无论如何，只要能解出娜赞的问题，那她不仅会把劫掠的东西全部奉还，还会亲自护送你回城里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050809
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731050809,
					"content": "她原来是这种怪人吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050810,
						731050811
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731050810,
					"content": "这是什么谜语大盗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050812
					]
				},
				{
					"id": 731050812,
					"content": "没人知道她是什么目的。我之所以知道这件事，也是因为我的导师曾经在野外遇见过娜赞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050813
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731050813,
					"content": "当时娜赞的问题是：「用什么东西能够迅速填满一间空荡荡的屋子。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050814
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731050814,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050815
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731050815,
					"content": "风！对吗？肯定对吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050816
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731050816,
					"content": "呃…烛光？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050817
					]
				},
				{
					"id": 731050817,
					"content": "我导师的回答是：「元素力始终无处不在。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050818
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731050818,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050819
					]
				},
				{
					"id": 731050819,
					"content": "耍赖！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050820
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731050820,
					"content": "哈哈哈…总之，娜赞是把我的导师送回了城里，还和他礼貌地道别。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050821
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731050821,
					"content": "如果是她和爱拉尼在一起，我反倒不那么担心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050822
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731050822,
					"content": "但爱拉尼那孩子一直待在那里也不行，我得想个办法，帮她把论文的问题解决了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731050811,
					"content": "她到底是什么目的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050812
					]
				}
			]
		},
