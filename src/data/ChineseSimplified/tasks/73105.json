			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"妮露法",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731050101,
					"content": "爱拉尼…你到底跑到哪里去了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050102
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731050102,
					"content": "爱拉尼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050103
					]
				},
				{
					"id": 731050103,
					"content": "欸？这名字…我记得，是那个总是在写论文的大姐姐？我们在海祇岛见过的那位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731050104,
					"content": "对喔！她说过她是从教令院出去取材的，现在应该已经回去了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731050105,
					"content": "不过…那个人好像很焦急的样子…我们过去问问她发生了什么吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731050106,
					"content": "如果爱拉尼真的回了教令院，我们也正好过去打个招呼呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731050107,
					"content": "你好，关于爱拉尼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050108
					]
				},
				{
					"id": 731050108,
					"content": "你是冒险家协会派来的冒险家吗？！请问你找到爱拉尼的下落了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050109
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731050109,
					"content": "我知道我催了好多次，真的很不好意思，但我真的很担心她，我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050110
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731050110,
					"content": "呜哇，你冷静点，我们不是冒险家协会派来的啦，我们只是路过…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731050111,
					"content": "请问您是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050112
					]
				},
				{
					"id": 731050112,
					"content": "你们不是冒险家吗？抱歉，因为协会那边一直没消息，我…我太着急了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050149
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731050149,
					"content": "讲述了至今为止与爱拉尼一同经历的事…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731050113
					]
				},
				{
					"id": 731050113,
					"content": "原来您就是爱拉尼一直提到的那位旅行者…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050114
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731050114,
					"content": "我叫妮露法，是教令院的学者…你们应该也能看出来，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050115
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731050115,
					"content": "虽然说是学者，但我现在大部分精力都放在了领着学生做研究上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050116
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731050116,
					"content": "爱拉尼就是我的学生之一，这孩子的论文一直都写得很艰难…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050117
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731050117,
					"content": "你，你就是爱拉尼的那位导师？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050118
					]
				},
				{
					"id": 731050118,
					"content": "爱拉尼小姐说，她的好多篇论文都被导师说不合格，不得不重写…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731050119,
					"content": "不对不对，现在不是说这些的时候，爱拉尼小姐怎么了呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731050120,
					"content": "这孩子…这孩子失踪了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050121
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731050121,
					"content": "前段时间，爱拉尼从稻妻带着一篇论文兴冲冲地回来，论文的内容是研究海祇岛的民俗文化…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050122,
						731050123
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731050122,
					"content": "爱拉尼研究得很认真。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050124
					]
				},
				{
					"id": 731050124,
					"content": "我能看出来，这篇论文写得很好，各方面都是高水准…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050125
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731050125,
					"content": "但是…但是她回来得太晚了啊！之前我让她把初稿提前寄给我，却一直都没收到回信。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050126
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731050126,
					"content": "等她带着全版论文回来的时候，早就有人提交了和她研究内容一模一样的论文，都已经通过预审了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050127
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731050127,
					"content": "我虽然拼命去帮她争取机会，但她的论文还是…还是没通过…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050128
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731050128,
					"content": "不对啊，爱拉尼小姐很早就开始取材了呀？怎么可能拖到现在才…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731050129,
					"content": "等等，说到稻妻…难道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731050130,
					"content": "锁，锁国令！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050131
					]
				},
				{
					"id": 731050131,
					"content": "怎么这样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731050132,
					"content": "我根本不知道怎么告诉她这个消息…本来打算过几天，想个委婉的方式和她沟通。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050133
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731050133,
					"content": "结果不知道哪个大嘴巴，直接把这个消息告诉她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050134
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731050134,
					"content": "然后她就不见了，我找遍了教令院也没有找到，只能去冒险家协会发布了委托。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050135
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731050135,
					"content": "但冒险家也只是在一个地方发现了爱拉尼的笔记本，没有发现她的人影。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050136
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731050136,
					"content": "现在，冒险家们应该还在到处找爱拉尼的下落…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050137
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731050137,
					"content": "我，我真的不知道怎么办才好，呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050138,
						731050140
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731050138,
					"content": "我也去帮忙找爱拉尼。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050139
					]
				},
				{
					"id": 731050139,
					"content": "对，我们也来帮忙！先从…先从那个笔记本的位置开始找好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050142
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731050142,
					"content": "您愿意帮忙吗？太感谢您了，真是太感谢您了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050143
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731050143,
					"content": "我这就把发现笔记本的位置给您标在地图上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050144
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731050144,
					"content": "对了，还有报酬…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050145,
						731050146
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731050145,
					"content": "这个之后再说吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050147
					]
				},
				{
					"id": 731050147,
					"content": "欸？那就拜托您了，我在这里接着等冒险家协会的消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050148
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731050148,
					"content": "爱拉尼，你可千万要平安啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731050146,
					"content": "我去找爱拉尼要。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050147
					]
				},
				{
					"id": 731050140,
					"content": "笔记本的位置在哪？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050141
					]
				},
				{
					"id": 731050141,
					"content": "我们也来帮忙找爱拉尼小姐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050142
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731050123,
					"content": "爱拉尼研究得很拼命。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050124
					]
				}
			]
		},
		{
			"id": 7310505,
			"completionStepIds": [
				7310505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7310505",
							"2"
						],
						"stepId": 7310505,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"戈布利",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731050501,
					"content": "英雄！好汉，别打了，别打了！都是误会啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050502,
						731050505
					],
					"speakerTitle": "戈布利"
				},
				{
					"id": 731050502,
					"content": "没什么误会。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050503
					]
				},
				{
					"id": 731050503,
					"content": "你们对爱拉尼小姐做了什么？老实交代！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731050504,
					"content": "不然…不然我们就揍你喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731050507,
					"content": "别，别别别，英雄您听我说完，这真的是误会…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050508
					],
					"speakerTitle": "戈布利"
				},
				{
					"id": 731050508,
					"content": "那位小姑奶奶我们哪敢惹啊，我们根本就折腾不过她啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050509,
						731050510
					],
					"speakerTitle": "戈布利"
				},
				{
					"id": 731050509,
					"content": "什么意思？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050511
					]
				},
				{
					"id": 731050511,
					"content": "您听我慢慢说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050512
					],
					"speakerTitle": "戈布利"
				},
				{
					"id": 731050512,
					"content": "前段时间，我们兄弟正好缺了点钱，就跟着大姐去周围想找点发财的路子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050513
					],
					"speakerTitle": "戈布利"
				},
				{
					"id": 731050513,
					"content": "呸！肯定又是抢劫偷东西这种事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050514
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731050514,
					"content": "那…那我们都做了盗宝团，日常发财还不就靠那几样事物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050515
					],
					"speakerTitle": "戈布利"
				},
				{
					"id": 731050515,
					"content": "我们正在营地里做计划的时候，突然看见旁边有一个小姑娘背着一个大包往营地这边走了过来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050516
					],
					"speakerTitle": "戈布利"
				},
				{
					"id": 731050516,
					"content": "她一副失魂落魄的样子，把我们都吓了一跳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050517
					],
					"speakerTitle": "戈布利"
				},
				{
					"id": 731050517,
					"content": "我们正准备抄家伙的时候，那个小姑娘突然一屁股坐在篝火旁边，一边哭一边噼里啪啦地把一堆书都甩进火里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050518
					],
					"speakerTitle": "戈布利"
				},
				{
					"id": 731050518,
					"content": "兄弟们是真的被这丫头给吓住了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050519,
						731050520
					],
					"speakerTitle": "戈布利"
				},
				{
					"id": 731050519,
					"content": "你们还能被她给吓住…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050521
					]
				},
				{
					"id": 731050521,
					"content": "哎哟，我们虽然是盗宝团，但我们也没真正害过人命啊，顶多就是偷点东西，拿点宝物什么的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050522
					],
					"speakerTitle": "戈布利"
				},
				{
					"id": 731050522,
					"content": "我们还没反应过来，她突然又甩过来一袋摩拉，让我们把她给关起来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050523
					],
					"speakerTitle": "戈布利"
				},
				{
					"id": 731050523,
					"content": "欸，欸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050524,
						731050525
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731050524,
					"content": "这都是什么乱七八糟的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050526
					]
				},
				{
					"id": 731050526,
					"content": "一开始…也没人敢上去碰她啊。但她一直不吃不喝，就一个劲要被关起来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050527
					],
					"speakerTitle": "戈布利"
				},
				{
					"id": 731050527,
					"content": "最后还是大姐让我们去削了几根树枝，做了个笼子让她坐进去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050528,
						731050529
					],
					"speakerTitle": "戈布利"
				},
				{
					"id": 731050528,
					"content": "你们的这位大姐还挺好的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050530
					]
				},
				{
					"id": 731050530,
					"content": "谁叫我们大姐一直就尊敬有学问的人呢，她一直说，要是有机会她也想上学…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050531
					],
					"speakerTitle": "戈布利"
				},
				{
					"id": 731050531,
					"content": "咳，您要是不信…那位姑奶奶就在那边，您自己去看看吧，大姐现在肯定还在劝她…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050532
					],
					"speakerTitle": "戈布利"
				},
				{
					"id": 731050532,
					"content": "您要是能把那位姑奶奶劝走，我们绝对有大礼奉上！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "戈布利"
				},
				{
					"id": 731050529,
					"content": "你们对爱拉尼还挺好的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050530
					]
				},
				{
					"id": 731050525,
					"content": "那你们把她关起来了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050526
					]
				},
				{
					"id": 731050520,
					"content": "你们不是盗宝团吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050521
					]
				},
				{
					"id": 731050510,
					"content": "爱拉尼果然在你们那。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050511
					]
				},
				{
					"id": 731050505,
					"content": "你们把爱拉尼怎么了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050506
					]
				},
				{
					"id": 731050506,
					"content": "老实交代！不然…不然我们就揍你喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050507
					],
					"speakerTitle": "派蒙"
				}
			]
		},
