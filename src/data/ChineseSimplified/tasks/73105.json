			"dialogs": [
				{
					"id": 731053101,
					"content": "还有什么事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053102,
						731053108
					],
					"speakerTitle": "娜赞"
				},
				{
					"id": 731053102,
					"content": "你为什么对她这么…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731053103
					]
				},
				{
					"id": 731053103,
					"content": "对爱拉尼这么「好」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053104
					],
					"speakerTitle": "娜赞"
				},
				{
					"id": 731053104,
					"content": "你误会了。我这么做理由很简单。第一，爱拉尼付过钱了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053105
					],
					"speakerTitle": "娜赞"
				},
				{
					"id": 731053105,
					"content": "第二，我从来只取财，不害人，如果我把她拽出来，丢去荒郊野岭，那我在道上的名声就要坏透了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053106
					],
					"speakerTitle": "娜赞"
				},
				{
					"id": 731053106,
					"content": "第三，她是一个有知识的人，有着远大的未来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053107
					],
					"speakerTitle": "娜赞"
				},
				{
					"id": 731053107,
					"content": "能帮上她的忙，我这个在泥巴里打滚的盗宝团，也许…算是能沾点光了？哼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "娜赞"
				},
				{
					"id": 731053108,
					"content": "她付了你多少钱？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731053109
					]
				},
				{
					"id": 731053109,
					"content": "不是一个小数目。她说是帮人做什么「肥料」赚来的钱，我不明白，也懒得管。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053110
					],
					"speakerTitle": "娜赞"
				},
				{
					"id": 731053110,
					"content": "总归她付了钱，我就会暂时帮她的忙，就这么简单。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "娜赞"
				}
			]
		},
