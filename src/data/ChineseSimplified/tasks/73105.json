				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731050701,
					"content": "爱拉尼！你到底出不出来！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050702
					],
					"speakerTitle": "娜赞"
				},
				{
					"id": 731050702,
					"content": "就是不出来！我不做学者了！我也不想上学了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050703
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 731050703,
					"content": "反正我都付给你那么多钱了，你就让我一个人待着不行吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050704
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 731050704,
					"content": "死丫头，油盐不进是吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050705,
						731050706
					],
					"speakerTitle": "娜赞"
				},
				{
					"id": 731050705,
					"content": "那个…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050707
					]
				},
				{
					"id": 731050707,
					"content": "你，你们好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050708
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731050708,
					"content": "嗯？你们是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050709
					],
					"speakerTitle": "娜赞"
				},
				{
					"id": 731050709,
					"content": "旅，旅行者！呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050710
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 731050710,
					"content": "爱拉尼小姐，你真的在这里呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050711,
						731050712
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731050711,
					"content": "你没事就好…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050713
					]
				},
				{
					"id": 731050713,
					"content": "呜…呜…他们…他们欺负人！那篇论文明明是我先写的！我先写的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050714
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 731050714,
					"content": "要不是在稻妻耽误那么久，我的论文早就通过了！呜呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050715
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 731050715,
					"content": "冷静一点啦…那你现在还要继续写论文吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050716
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731050716,
					"content": "呼…呼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050717
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 731050717,
					"content": "我，我才不写了呢…傻子才写论文！我不要上学了！教令院爱怎么样就怎么样！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050718
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 731050718,
					"content": "反正我付钱雇了娜赞保护我，谁也别想把我再抓回去写论文！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050719
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 731050719,
					"content": "哼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050720
					],
					"speakerTitle": "娜赞"
				},
				{
					"id": 731050720,
					"content": "您是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050721
					]
				},
				{
					"id": 731050721,
					"content": "我就是娜赞，我的本职工作…哼，你应该也已经知道了，我就不说废话了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050722
					],
					"speakerTitle": "娜赞"
				},
				{
					"id": 731050722,
					"content": "我知道你，最近在这周围很活跃的「旅行者」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050723
					],
					"speakerTitle": "娜赞"
				},
				{
					"id": 731050723,
					"content": "如果你是接到了谁的委托，要把这丫头带回去的话，你可以先试试说服她，我不会阻止你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050724
					],
					"speakerTitle": "娜赞"
				},
				{
					"id": 731050724,
					"content": "喂！我可是付了钱的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050725
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 731050725,
					"content": "你付的那么点钱够干什么的？再买几天吃喝就要花光了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050726
					],
					"speakerTitle": "娜赞"
				},
				{
					"id": 731050726,
					"content": "反正…反正我不回去，回去了之后又要想论文的题目，又要到处去田野调查，吃不好睡不好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050727
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 731050727,
					"content": "说不定，还会被莫名其妙的人抓起来，或者是遇见乱七八糟的魔物。最后论文一个字没动，答辩日又过了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050728
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 731050728,
					"content": "呜呜呜…我不要…我不要…我还不如被盗宝团抓起来…呜呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050729
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 731050729,
					"content": "旅行者，你…你帮我给妮露法老师带个话…我…我给你写个便签…我真的不想回去了，饶了我吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050738
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 731050738,
					"content": "爱拉尼抽泣着开始写起了便签…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731050730
					]
				},
				{
					"id": 731050730,
					"content": "给你…呜呜呜…呜呜…为什么世界上有论文这种东西…呜呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050731
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 731050731,
					"content": "…行了，冷静点，没人带得走你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050732
					],
					"speakerTitle": "娜赞"
				},
				{
					"id": 731050732,
					"content": "爱拉尼小姐…现在的情绪好像很不稳定…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050733
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731050733,
					"content": "就让她先待在这里，我们先把便签带回去给妮露法小姐吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050734,
						731050735
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731050734,
					"content": "但是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050736
					]
				},
				{
					"id": 731050736,
					"content": "不用担心我会对爱拉尼不利，就如她所说，她已经付过钱了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050737
					],
					"speakerTitle": "娜赞"
				},
				{
					"id": 731050737,
					"content": "而且…哼，总算是找到了一个懂点学问的人了，我留着她可有大用处。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "娜赞"
				},
				{
					"id": 731050735,
					"content": "盗宝团…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050736
					]
				},
				{
					"id": 731050712,
					"content": "事情我都听妮露法说了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050713
					]
				},
				{
					"id": 731050706,
					"content": "打扰了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050707
					]
				}
			]
