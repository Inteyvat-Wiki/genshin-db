			"dialogs": [
				{
					"id": 731053001,
					"content": "爱拉尼，你可千万要平安啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053002,
						731053005
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731053002,
					"content": "爱拉尼在教令院怎么样？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731053003
					]
				},
				{
					"id": 731053003,
					"content": "爱拉尼是一个很勤奋的孩子，虽然有时候…总是会在奇怪的地方钻牛角尖…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053004
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731053004,
					"content": "但她绝对是一个合格的学生，我也相信她绝对会成为一个合格的学者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731053005,
					"content": "教令院论文很难通过吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731053006
					]
				},
				{
					"id": 731053006,
					"content": "老实说，是的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053007
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731053007,
					"content": "论文的审核是一件…很复杂的事，除了考虑自己的研究方向，文献的充足程度…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053008
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731053008,
					"content": "还要注意同类型论文的数量，研究课题有没有和别人冲突。开题之后，也会遇见各种各样的困难。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053009
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731053009,
					"content": "唉，但爱拉尼那孩子的运气也太差了点…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "妮露法"
				}
			]
		},
