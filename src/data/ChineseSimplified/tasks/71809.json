				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"范二爷"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718090301,
					"content": "现在这戏啊，我真是越听越不明白…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090302
					],
					"speakerTitle": "范二爷"
				},
				{
					"id": 718090302,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090303
					]
				},
				{
					"id": 718090303,
					"content": "是旅行者啊，这「和裕茶馆」又有几出新戏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090304
					],
					"speakerTitle": "范二爷"
				},
				{
					"id": 718090304,
					"content": "不过这些新戏啊…热闹倒是热闹，但我都有些听不懂了，年轻人倒是都很喜欢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090305
					],
					"speakerTitle": "范二爷"
				},
				{
					"id": 718090305,
					"content": "您觉得这样好吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090306
					]
				},
				{
					"id": 718090306,
					"content": "这个嘛…就我来说，当然是乐意听那些老戏的，这么多年也听习惯了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090307
					],
					"speakerTitle": "范二爷"
				},
				{
					"id": 718090307,
					"content": "但是，现在整座璃月港都在变，变几场新戏出来倒也应景。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090308
					],
					"speakerTitle": "范二爷"
				},
				{
					"id": 718090308,
					"content": "唉，但这变化也太快了，老戏也好久没开，也不知道岩王爷他…算了，不说了，不说了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "范二爷"
				}
			]
		},
		{
			"id": 7180904,
			"completionStepIds": [
				7180909
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
