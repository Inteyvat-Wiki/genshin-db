			"trigger": {
				"objectNames": [
					"清昼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718090401,
					"content": "您可有收获？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090402
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 718090402,
					"content": "有不少。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090403
					]
				},
				{
					"id": 718090403,
					"content": "哦？请说来听听。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090404
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 718090404,
					"content": "南码头上有很多狗。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090405
					]
				},
				{
					"id": 718090405,
					"content": "哦，不错不错，颇有生活气息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090406
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 718090406,
					"content": "「不卜庐」附近有很多团雀。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090407
					]
				},
				{
					"id": 718090407,
					"content": "团雀，唔…也能算是宁和之象，入诗正好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090408
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 718090408,
					"content": "有人只在意吃…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090409
					]
				},
				{
					"id": 718090409,
					"content": "这样也没错，吃当然是头等要务，特别…是在这座璃月港里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090410
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 718090410,
					"content": "这倒也有些趣味，我先记下，说不定也能入诗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090411
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 718090411,
					"content": "有人觉得变化太快。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090412
					]
				},
				{
					"id": 718090412,
					"content": "嗯…有人这么觉得倒也正常，如今的璃月港里的变化可以称得上是日新月异，有些东西就连我都有点接受不了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090413
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 718090413,
					"content": "但这题目有些太大，只怕一首诗容纳不下…我还是先记下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090414
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 718090414,
					"content": "这样就可以了，拜托你帮忙果然不错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090415
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 718090415,
					"content": "如此一来，我的下一部诗集中说不定又可以添几首新作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090416
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 718090416,
					"content": "啊对了，除了一些财帛俗物外…还有一份小小心意，还请收下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090417
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 718090417,
					"content": "等我的下一本诗集出版，便可以凭此签名换得一册。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "清昼"
				}
			]
		},
