			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"浩仔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718090201,
					"content": "还好，还好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090202
					],
					"speakerTitle": "浩仔"
				},
				{
					"id": 718090202,
					"content": "什么还好？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090203
					]
				},
				{
					"id": 718090203,
					"content": "哦，是旅行者啊。之前城里不是出了那么大的事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090204
					],
					"speakerTitle": "浩仔"
				},
				{
					"id": 718090204,
					"content": "还好，那件事之后也没出什么大乱子。最主要的是…城里的饭馆也都开得好好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090205
					],
					"speakerTitle": "浩仔"
				},
				{
					"id": 718090205,
					"content": "要不然，那么多好菜我都吃不着了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090206
					],
					"speakerTitle": "浩仔"
				},
				{
					"id": 718090206,
					"content": "原来是因为吃的啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090207
					]
				},
				{
					"id": 718090207,
					"content": "你可别小看了吃啊。要判断一个地方的好坏，最直接的方法，就是看这地方吃的东西怎么样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090208
					],
					"speakerTitle": "浩仔"
				},
				{
					"id": 718090208,
					"content": "啊…说着说着肚子又饿了，我得再去吃点什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "浩仔"
				}
			]
		},
		{
			"id": 7180903,
			"completionStepIds": [
				7180906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
