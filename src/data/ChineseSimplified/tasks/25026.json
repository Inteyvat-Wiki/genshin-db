			"trigger": {
				"objectNames": [
					"特阿墨"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250260101,
					"content": "可怜的小匿叶龙…这帮恶棍，我一定得教训他们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260102
					],
					"speakerTitle": "特阿墨"
				},
				{
					"id": 250260102,
					"content": "恶棍们，你们可以逃，但绝对无处可藏…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260103
					],
					"speakerTitle": "特阿墨"
				},
				{
					"id": 250260103,
					"content": "发生什么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260104
					]
				},
				{
					"id": 250260104,
					"content": "你是…外来的旅行者，对吧？向你致意，很抱歉，现在我没办法招待你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260105
					],
					"speakerTitle": "特阿墨"
				},
				{
					"id": 250260105,
					"content": "那群不识好歹的盗宝团恶棍，又想抓住那只小匿叶龙，还好我去的及时，把他们都赶跑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260106
					],
					"speakerTitle": "特阿墨"
				},
				{
					"id": 250260106,
					"content": "那只小匿叶龙一定是吓坏了，无论我怎么招呼，它都不肯过来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260107
					],
					"speakerTitle": "特阿墨"
				},
				{
					"id": 250260107,
					"content": "但现在，我已经找到了那群盗宝团的所在地，等会就去教训这帮恶棍。再把他们捆在树上，拿树藤狠狠地抽一顿！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260108
					],
					"speakerTitle": "特阿墨"
				},
				{
					"id": 250260108,
					"content": "而且，还要找点好吃的，去安慰一下那只小匿叶龙才行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "特阿墨"
				}
			]
		},
		{
			"id": 2502602,
			"completionStepIds": [
				2502601,
				2502606
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2502601",
							"2"
						],
						"stepId": 2502601,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"特阿墨"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250260201,
					"content": "还是先去安慰小匿叶龙吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260202
					]
				},
				{
					"id": 250260202,
					"content": "唔…你说得也有道理，那孩子一定被吓得够呛。还是先去安慰一下它比较好啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260203
					],
					"speakerTitle": "特阿墨"
				},
				{
					"id": 250260203,
					"content": "那就跟我来吧，看你的模样，想必也是位经验丰富的冒险家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260204
					],
					"speakerTitle": "特阿墨"
				},
				{
					"id": 250260204,
					"content": "我们两个一起过去，那群不怀好意的人肯定不敢再来。不用担心报酬，我会按照冒险家的规矩准备好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260206
					],
					"speakerTitle": "特阿墨"
				},
				{
					"id": 250260206,
					"content": "我想想，那孩子很喜欢吃新鲜的烛伞蘑菇…我记得那边的树下长着很多,请你先去采一些吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260205
					],
					"speakerTitle": "特阿墨"
				},
				{
					"id": 250260205,
					"content": "我去另一边采烛伞蘑菇，等你采好了，我们在竞技场那边的悬崖上集合。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260207
					],
					"speakerTitle": "特阿墨"
				},
				{
					"id": 250260207,
					"content": "那孩子平时经常在那边休息。也许我们可以去那边找到它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "特阿墨"
				}
			]
		},
		{
			"id": 2502603,
			"completionStepIds": [
				2502603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2502603",
							"2"
