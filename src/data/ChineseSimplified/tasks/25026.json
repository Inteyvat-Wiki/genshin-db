			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"特阿墨"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250260301,
					"content": "平时那孩子经常呆在这里。但今天，怎么没见到它留下的痕迹…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260302
					],
					"speakerTitle": "特阿墨"
				},
				{
					"id": 250260302,
					"content": "也许是被吓坏了，特意藏起来了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260303
					],
					"speakerTitle": "特阿墨"
				},
				{
					"id": 250260303,
					"content": "我们要去找到它吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260304
					]
				},
				{
					"id": 250260304,
					"content": "…不必了。先让那孩子安静一会吧。咱们把烛伞蘑菇放在这里就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260305
					],
					"speakerTitle": "特阿墨"
				},
				{
					"id": 250260305,
					"content": "你还挺熟练的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260306
					]
				},
				{
					"id": 250260306,
					"content": "我已经照顾这孩子一段时间了。它的性格很敏感，就算是遇见陌生人都会吓一跳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260307
					],
					"speakerTitle": "特阿墨"
				},
				{
					"id": 250260307,
					"content": "我喂了这只小匿叶龙很长时间，这孩子才愿意靠近我…唉，可是被那群恶棍一闹，它肯定又不愿意出来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260308
					],
					"speakerTitle": "特阿墨"
				},
				{
					"id": 250260308,
					"content": "没办法，只能让它先自己安静一会了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260309
					],
					"speakerTitle": "特阿墨"
				},
				{
					"id": 250260309,
					"content": "多谢你陪我一起来。这是报酬，请收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260310,
						250260311
					],
					"speakerTitle": "特阿墨"
				},
				{
					"id": 250260310,
					"content": "没看见它，有点遗憾。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260312
					]
				},
				{
					"id": 250260312,
					"content": "放心。那孩子会记住对它好的人。等到时机成熟，它一定会来见我们的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "特阿墨"
				},
				{
					"id": 250260311,
					"content": "还是想见见那只小匿叶龙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260312
					]
				}
			]
		},
