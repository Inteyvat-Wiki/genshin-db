			},
			"dialogs": [
				{
					"id": 250260501,
					"content": "哼，这下他们应该不敢随便去伤害小匿叶龙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260502
					],
					"speakerTitle": "特阿墨"
				},
				{
					"id": 250260502,
					"content": "总感觉，有什么误会…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260503
					]
				},
				{
					"id": 250260503,
					"content": "别听他们的花言巧语。我可是亲眼看着，他们想要把绳子捆在小匿叶龙的尾巴上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260504
					],
					"speakerTitle": "特阿墨"
				},
				{
					"id": 250260504,
					"content": "要不是我过去的及时，真不知道会出什么事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260505
					],
					"speakerTitle": "特阿墨"
				},
				{
					"id": 250260505,
					"content": "再次感谢你帮忙，这些报酬给你，请收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260506
					],
					"speakerTitle": "特阿墨"
				},
				{
					"id": 250260506,
					"content": "可惜，那群盗宝团跑得太快了。要是能抓住他们，我一定要把这群恶徒斩草除根！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "特阿墨"
				}
			]
		},
