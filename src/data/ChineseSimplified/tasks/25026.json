			"dialogs": [
				{
					"id": 250260401,
					"content": "我们一起去教训盗宝团吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260402
					]
				},
				{
					"id": 250260402,
					"content": "你愿意和我一起去？那太好了，看你这副模样…想必也是位经验丰富的冒险家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260403
					],
					"speakerTitle": "特阿墨"
				},
				{
					"id": 250260403,
					"content": "我会按冒险家的规矩准备好报酬的。那我们立即出发吧，给那群恶棍一点颜色瞧瞧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "特阿墨"
				}
			]
		},
