				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20050401,
					"content": "怎么只有你一个人在这里呀，刚刚缠住你的那两个人呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20050402,
					"content": "我对他们说，再不走的话，我就拔刀了。他们就走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050403
					],
					"speakerTitle": "黑泽京之介"
				},
				{
					"id": 20050403,
					"content": "果然，这比用言语说服他们方便多了。或许，今后我也应该…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050404
					],
					"speakerTitle": "黑泽京之介"
				},
				{
					"id": 20050404,
					"content": "盗宝团的事情查清楚了？我没有骗你们吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050405
					],
					"speakerTitle": "黑泽京之介"
				},
				{
					"id": 20050405,
					"content": "其实…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050406
					]
				},
				{
					"id": 20050406,
					"content": "大概就是这样。其实你真的有发「救济粮」，只不过这些粮食是你自己掏钱买的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20050407,
					"content": "怎么会…以前的我是这样的人吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050408
					],
					"speakerTitle": "黑泽京之介"
				},
				{
					"id": 20050408,
					"content": "我完全没有印象了。就算你告诉我了这些事情，我也想不起来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050409
					],
					"speakerTitle": "黑泽京之介"
				},
				{
					"id": 20050409,
					"content": "以前的我为什么要做这种事？这不是自讨苦吃吗？真是难以理解…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050410
					],
					"speakerTitle": "黑泽京之介"
				},
				{
					"id": 20050410,
					"content": "不过确实，刚刚握住这把刀，对他们两个施加威胁的时候，我也感受到了身体在本能地抗拒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050411,
						20050412
					],
					"speakerTitle": "黑泽京之介"
				},
				{
					"id": 20050411,
					"content": "这把刀…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050413
					]
				},
				{
					"id": 20050413,
					"content": "这把刀，曾经是我老爹的佩刀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050414
					],
					"speakerTitle": "黑泽京之介"
				},
				{
					"id": 20050414,
					"content": "我记得小时候有一次，我从老爹那里偷出来了这把刀，想要在邻居家的孩子面前炫耀一番，结果被老爹狠狠地教训了一顿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050415
					],
					"speakerTitle": "黑泽京之介"
				},
				{
					"id": 20050415,
					"content": "他跟我说…说什么来着…奇怪，我又记不清了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050416
					],
					"speakerTitle": "黑泽京之介"
				},
				{
					"id": 20050416,
					"content": "「神之眼」被夺走之后，我好像忘记了很多重要的事情。记忆里是大段大段的空白，不管怎么想都想不起来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050417
					],
					"speakerTitle": "黑泽京之介"
				},
				{
					"id": 20050417,
					"content": "只记得老爹好像说过，这把刀上面，有他一生的信条。而他在离开这个世界之前，亲手把刀交到了我的手里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050418
					],
					"speakerTitle": "黑泽京之介"
				},
				{
					"id": 20050418,
					"content": "还对我说，拿着这把刀，就应该…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050419
					],
					"speakerTitle": "黑泽京之介"
				},
				{
					"id": 20050419,
					"content": "嗯…仔细看看的话，这个刀柄上是不是刻着字？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050420
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20050420,
					"content": "旅行者，你能看出来上面刻着什么吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050421
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20050421,
					"content": "是「仁义」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050422
					]
				},
				{
					"id": 20050422,
					"content": "「仁义」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050423
					],
					"speakerTitle": "黑泽京之介"
				},
				{
					"id": 20050423,
					"content": "这么说的话，好像就能解释得通了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050424
					],
					"speakerTitle": "黑泽京之介"
				},
				{
					"id": 20050424,
					"content": "不惜负债累累，也要让他人获得幸福，这就是我曾经最大的愿望吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050425
					],
					"speakerTitle": "黑泽京之介"
				},
				{
					"id": 20050425,
					"content": "但「仁义」，有什么用？我践行此道，用自己的钱买粮食救济他们，可结果呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050426
					],
					"speakerTitle": "黑泽京之介"
				},
				{
					"id": 20050426,
					"content": "天领奉行夺走了我的神之眼，而那些被我救济的人也不愿意理解我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050427
					],
					"speakerTitle": "黑泽京之介"
				},
				{
					"id": 20050427,
					"content": "最讽刺的是，我朝他们拔刀的时候，还会感受到心痛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050428
					],
					"speakerTitle": "黑泽京之介"
				},
				{
					"id": 20050428,
					"content": "我做不了好人，连坏人都当不了！我到底…到底该怎么办啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050429
					],
					"speakerTitle": "黑泽京之介"
				},
				{
					"id": 20050429,
					"content": "又是一个好可怜的人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050430
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20050430,
					"content": "关于他欠钱的事，有空我们和托马他们说一下吧，社奉行应该会支援他一下的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050431
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20050431,
					"content": "总不能真的让他把自己珍视的刀也卖掉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050432,
						20050433
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20050432,
					"content": "失去神之眼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050434
					]
				},
				{
					"id": 20050434,
					"content": "嗯…原来失去愿望是这么可怕的一件事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050435
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20050435,
					"content": "好在你没有神之眼，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050436
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20050436,
					"content": "我们还是去下一个失去神之眼的人那里吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20050433,
					"content": "好像确实很可怕。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050434
					]
				},
				{
					"id": 20050412,
					"content": "能让我们看一下吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050413
					]
				}
			]
		},
