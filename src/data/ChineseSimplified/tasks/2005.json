					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙",
					"大森",
					"悠也",
					"黑泽京之介"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20050101,
					"content": "奇怪，据说「天领奉行」直属于将军管辖，统管稻妻治安方面的事宜，眼狩令就是他们在执行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20050102,
					"content": "可为什么他们要对自己的同伴下手呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20050103,
					"content": "想不明白…等等，那边似乎发生了争吵，我们先过去看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20050104,
					"content": "我说，这个月的救济粮，你是打算不给了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050105
					],
					"speakerTitle": "大森"
				},
				{
					"id": 20050105,
					"content": "我们一家人可都等着这些粮食养活呢！今天不给我们一个说法，你就别想走！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050106
					],
					"speakerTitle": "悠也"
				},
				{
					"id": 20050106,
					"content": "说了多少遍，我不知道什么救济粮…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050107
					],
					"speakerTitle": "黑泽京之介"
				},
				{
					"id": 20050107,
					"content": "还在骗人，那可是救命的粮食，不是给你们这些武士中饱私囊用的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050108
					],
					"speakerTitle": "大森"
				},
				{
					"id": 20050108,
					"content": "武士就能为所欲为了吗！我要去天领奉行所告你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050109
					],
					"speakerTitle": "悠也"
				},
				{
					"id": 20050109,
					"content": "「救济粮」指的是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050110
					]
				},
				{
					"id": 20050110,
					"content": "你是谁？跟黑泽是一伙的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050111
					],
					"speakerTitle": "大森"
				},
				{
					"id": 20050111,
					"content": "不不不，我们只是路过的普通人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20050112,
					"content": "听到你们在争吵，就想过来看看情况。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20050113,
					"content": "原来是这样。正好，你来帮我们评评理——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050114
					],
					"speakerTitle": "大森"
				},
				{
					"id": 20050114,
					"content": "这个叫黑泽的武士，是幕府军的人。幕府军在这附近派发救济粮，他就是负责人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050115
					],
					"speakerTitle": "大森"
				},
				{
					"id": 20050115,
					"content": "以前我们只要找到他就可以领到粮食，但现在他突然不给了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050116
					],
					"speakerTitle": "大森"
				},
				{
					"id": 20050116,
					"content": "一定是他起了贪念，打算自己吞掉这批粮食！可是没有这批粮食，我们就要饿肚子了啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050117
					],
					"speakerTitle": "大森"
				},
				{
					"id": 20050117,
					"content": "根本就没人考虑我们的感受…以前还觉得他是个有良心的人，现在看来他和别的武士一样坏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050118
					],
					"speakerTitle": "悠也"
				},
				{
					"id": 20050118,
					"content": "怪不得连「神之眼」都被收回去了，雷电将军治理国家也不想要这样的人协助吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050119
					],
					"speakerTitle": "悠也"
				},
				{
					"id": 20050119,
					"content": "原来这个人就是绫华说的人呀，可绫华为什么要我们帮助这种人呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20050120,
					"content": "我们还是问问这位叫黑泽的武士是怎么想的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 200502,
			"completionStepIds": [
				200503
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200503",
							"2"
						],
						"stepId": 200503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿贤",
					"忠夫",
					"派蒙",
					"阿豪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20050201,
					"content": "可恶，怎么会这样…我的钱，那可是我们辛辛苦苦偷来的啊……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050202
					],
					"speakerTitle": "阿贤"
				},
				{
					"id": 20050202,
					"content": "老大，快想想办法啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050203
					],
					"speakerTitle": "阿贤"
				},
				{
					"id": 20050203,
					"content": "咳咳，这个…我看你身手不错，不知道有没有兴趣加入盗宝团，与我们共谋大事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050204,
						20050205
					],
					"speakerTitle": "忠夫"
				},
				{
					"id": 20050204,
					"content": "先把黑泽的事情告诉我。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050206
					]
				},
				{
					"id": 20050206,
					"content": "黑泽？哦哦…我想起来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050207
					],
					"speakerTitle": "忠夫"
				},
				{
					"id": 20050207,
					"content": "你们原来是他派来的？晦气，真是晦气，我就不应该顺路去他家…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050208
					],
					"speakerTitle": "忠夫"
				},
				{
					"id": 20050208,
					"content": "黑泽的家里怎么样？有很多粮食吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20050209,
					"content": "粮食？没有没有，而且家里乱糟糟的，倒是…有个盒子挺别致的，我猜里面准有宝贝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050210
					],
					"speakerTitle": "忠夫"
				},
				{
					"id": 20050210,
					"content": "本想回去再打开的，担心被什么其他人盯上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050211
					],
					"speakerTitle": "忠夫"
				},
				{
					"id": 20050211,
					"content": "但既然被你们抓了，干脆就拿这盒子来赎我们自己吧，你看成不？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050212
					],
					"speakerTitle": "忠夫"
				},
				{
					"id": 20050212,
					"content": "算你们有诚意，快打开看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20050213,
					"content": "啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050214
					],
					"speakerTitle": "阿贤"
				},
				{
					"id": 20050214,
					"content": "这是！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050215
					],
					"speakerTitle": "忠夫"
				},
				{
					"id": 20050215,
					"content": "欠、欠条？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050216
					],
					"speakerTitle": "阿豪"
				},
				{
					"id": 20050216,
					"content": "还有好多的样子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20050217,
					"content": "好像是写给杂货店葵小姐的欠条，哇…欠了好多钱呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20050218,
					"content": "究竟是怎么回事呢…我们去杂货店问问吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20050219,
					"content": "喂，你们走吧！当心下次不要再被我们逮到！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20050220,
					"content": "好！好！谢谢小老爷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050221
					],
					"speakerTitle": "阿贤"
				},
				{
					"id": 20050221,
					"content": "拿欠条赎了我们的身…是不是算我们赚钱了呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050222
					],
					"speakerTitle": "阿豪"
				},
				{
					"id": 20050222,
					"content": "快走吧你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "忠夫"
				},
				{
					"id": 20050205,
					"content": "听说你们洗劫了黑泽的家。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050206
					]
				}
			]
		},
		{
			"id": 200503,
			"completionStepIds": [
				200504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200504",
							"2"
						],
						"stepId": 200504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"葵"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20050301,
					"content": "「九十九物」，无所不有。客人想要买点什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050302
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050302,
					"content": "还是说…想要打听些什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050303
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050303,
					"content": "这欠条…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050304
					]
				},
				{
					"id": 20050304,
					"content": "呵呵，原来是黑泽先生的朋友，客人是来替黑泽先生偿还债务的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050305
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050305,
					"content": "不不不，我们只是想打听一下「欠条」的来历…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20050306,
					"content": "黑泽为什么会欠这么多钱，他在这里买了什么贵重的东西吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20050307,
					"content": "让我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050308
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050308,
					"content": "黑泽先生会定期在我们这里购买大量粮食，不过用的是他自己的薪水。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050309
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050309,
					"content": "但是最近粮价上涨，黑泽先生自己的薪水已经不够了。他就开始向我们打欠条，通过赊账来换取等量的粮食。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050310
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050310,
					"content": "原来「救济粮」是这么来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20050311,
					"content": "可是黑泽为什么一定要买「等量」的粮食呢？粮价上涨的话，少买一些不就可以了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20050312,
					"content": "客人不妨想一下。领取「救济粮」的民众，在拿到这些粮食之前，一定会反复思考这些粮食能支撑多久。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050313
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050313,
					"content": "他们精打细算，日夜核对，拿到手的时候却发现数量比预想中要少…黑泽先生认为，这会让他们感到很失望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050314
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050314,
					"content": "为了照顾他们的感受，黑泽先生宁愿通过赊账来换取等量的粮食。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050315
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050315,
					"content": "这些粮食，实际上是黑泽自己买下来的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20050316,
					"content": "他们没有感谢黑泽，反而还在不停地责怪他…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20050317,
					"content": "人的态度往往取决于他们的处境，在生存问题面前，大多数人是不会顾虑那么多的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050318
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050318,
					"content": "在我看来，如果黑泽从一开始就公布「救济粮」的来源，现在面临的麻烦应该会少一点…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050319
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050319,
					"content": "当然，也只是少一点而已。他所做的，本来就是一件出力不讨好的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050320
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050320,
					"content": "至于他为什么要花钱购买粮食救灾，又为什么不愿留下姓名供人感激…这些我就不清楚了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050321
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050321,
					"content": "如果你们好奇的话，直接去问问黑泽先生如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050322
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050322,
					"content": "他也不记得了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050323
					]
				},
				{
					"id": 20050323,
					"content": "哦…说起来，他好像刚刚被收缴了「神之眼」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050324
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050324,
					"content": "这就有点麻烦了…如果黑泽先生还不清欠款的话，他大概就只能卖掉那把他很珍视的刀了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050325
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050325,
					"content": "刀？那是什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050326
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20050326,
					"content": "黑泽先生没有跟你们说吗？他有一把很宝贝的刀，常年带在身上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050327
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050327,
					"content": "我也曾向他询问过刀的来历，黑泽先生说是他的父亲送的，再高的价格都不会卖掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050328
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050328,
					"content": "当时我还感到有些遗憾，毕竟在我看来，世间万物都有价格，只要能开出相应的价码，应该什么都买得到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050329
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050329,
					"content": "你们也可以问问黑泽先生关于刀的事情。说不定你们要找的答案，就在那把刀上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050330
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050330,
					"content": "当然，在那之前，也请客人先结清一下这次的账单…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050331
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050331,
					"content": "但我们明明什么也没有买呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050332
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20050332,
					"content": "呵呵，「情报」也是货物的一种，不是吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050333
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050333,
					"content": "不过，关于黑泽先生的情报倒是并不贵，毕竟黑泽先生也没有特别叮嘱我们要保守秘密。让我想想…两千摩拉就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050334
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050334,
					"content": "好吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050335
					]
				},
				{
					"id": 20050335,
					"content": "至少我们知道了「救济粮」的来历，还有黑泽一直带着的那把刀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050336
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20050336,
					"content": "再去找黑泽问问吧，看看他能不能想起来什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 200504,
			"completionStepIds": [
				200505
			],
