			"dialogs": [
				{
					"id": 20050501,
					"content": "什么救济粮，我听都没听说过这种事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050502
					],
					"speakerTitle": "黑泽京之介"
				},
				{
					"id": 20050502,
					"content": "不知道这些人从哪听说了一些传闻，就想跑过来讹诈我。可笑，我要是有救济粮可以私吞，还会穷成现在这个样子？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050503
					],
					"speakerTitle": "黑泽京之介"
				},
				{
					"id": 20050503,
					"content": "我自己家都揭不开锅了…没什么事就让开吧，我还有事要做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050504
					],
					"speakerTitle": "黑泽京之介"
				},
				{
					"id": 20050504,
					"content": "听说你失去了神之眼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050505
					]
				},
				{
					"id": 20050505,
					"content": "这倒是真的。幕府军的人说我对眼狩令不满，一直在消极怠工，还说我对不起雷电将军，就把我的神之眼收走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050506
					],
					"speakerTitle": "黑泽京之介"
				},
				{
					"id": 20050506,
					"content": "奇怪，你是眼狩令的执行者呀，为什么会对眼狩令不满呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20050507,
					"content": "这个…说实话，我也记不清了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050508
					],
					"speakerTitle": "黑泽京之介"
				},
				{
					"id": 20050508,
					"content": "我只记得，那时候我好像每个月都会做些什么事情，不过现在完全不想做了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050509
					],
					"speakerTitle": "黑泽京之介"
				},
				{
					"id": 20050509,
					"content": "不仅不记得了，还隐约觉得心里不太舒服…好像谁欠了我什么东西一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050510
					],
					"speakerTitle": "黑泽京之介"
				},
				{
					"id": 20050510,
					"content": "跟「救济粮」有关吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050511
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20050511,
					"content": "我没有私吞救济粮！还是那句话，如果有救济粮可以拿，谁愿意像我现在这样过苦日子？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050512
					],
					"speakerTitle": "黑泽京之介"
				},
				{
					"id": 20050512,
					"content": "而且我家刚刚还被盗宝团洗劫了…对了，我刚刚是追着盗宝团来这里，突然被拦下来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050513
					],
					"speakerTitle": "黑泽京之介"
				},
				{
					"id": 20050513,
					"content": "你们要是不信的话，去教训一下盗宝团，问问他们，我家到底有没有「救济粮」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050514
					],
					"speakerTitle": "黑泽京之介"
				},
				{
					"id": 20050514,
					"content": "唔…感觉他看上去不像是在说谎呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050515
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20050515,
					"content": "但是也不能确定…我们还是抓个盗宝团的人问问看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050516
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20050516,
					"content": "顺着盗宝团留下的痕迹，应该就可以找到他们了。趁盗宝团还没有跑远，我们快追上去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
