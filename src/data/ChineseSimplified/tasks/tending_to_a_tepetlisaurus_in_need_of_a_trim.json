	"talks": [
		{
			"id": 2502101,
			"completionStepIds": [
				2502101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
