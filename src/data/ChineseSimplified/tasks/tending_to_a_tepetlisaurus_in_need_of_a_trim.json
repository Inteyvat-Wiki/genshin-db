				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"卡兹加"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250210101,
					"content": "霍莱，这次你可不能乱跑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210102
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250210102,
					"content": "呜，呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210103
					],
					"speakerTitle": "霍莱"
				},
				{
					"id": 250210103,
					"content": "今天霍莱很听话啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210104
					]
				},
				{
					"id": 250210104,
					"content": "是啊。多亏了你帮我做的那个「漂流球」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210105
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250210105,
					"content": "有了这个球，我也能引导霍莱去做各种事。不管是洗澡，吃东西，睡觉还是训练，都方便了很多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210106
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250210106,
					"content": "特别是修剪指甲这件事！要是放在之前，我光是追霍莱都能追到累瘫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210107
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250210107,
					"content": "现在只要把球放在霍莱面前，这小伙子就会乖乖坐下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210108
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250210108,
					"content": "呜呜，呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210109
					],
					"speakerTitle": "霍莱"
				},
				{
					"id": 250210109,
					"content": "#霍莱，你记得{M#他}{F#她}吗？这可是帮你做玩具的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210110
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250210110,
					"content": "呜呜，呜呜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210111,
						250210112
					],
					"speakerTitle": "霍莱"
				},
				{
					"id": 250210111,
					"content": "乖乖喔。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210113
					]
				},
				{
					"id": 250210113,
					"content": "喔！霍莱记得你啊，看起来还挺开心的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210114
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250210114,
					"content": "你要试试给它剪指甲吗？顺便再擦擦它的角。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210115
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250210115,
					"content": "这对小嵴锋龙来说可是一件很重要的事，毕竟它们可是要挖岩掘土，爪子必须要时常打磨，并且修剪那些长歪，或者被撞坏的指甲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210116
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250210116,
					"content": "只有这样，才能保证小嵴锋龙在长大之后拥有一对最完美的爪子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210117
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250210117,
					"content": "来，拿着这个！咱们正好趁这个修剪指甲的机会，把霍莱的全身都收拾一下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210118,
						250210119
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250210118,
					"content": "你说得真详细…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210120
					]
				},
				{
					"id": 250210120,
					"content": "呜呜，呜——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210121
					],
					"speakerTitle": "霍莱"
				},
				{
					"id": 250210121,
					"content": "咳…难得看见霍莱这么听话。一想到今天我不用追着霍莱跑遍整个部族，我就不由自主地高兴…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210122
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250210122,
					"content": "…真是辛苦你了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210123
					]
				},
				{
					"id": 250210123,
					"content": "没什么！那我们就开始吧，我会在旁边指导你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210124
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250210124,
					"content": "为了让霍莱放松，你首先得用大刷子轻轻清理它的后背…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210130
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250210130,
					"content": "再用细毛刷清理它的角，这个时候要用点力道，否则就会漏掉一些缝隙中的污渍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210125
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250210125,
					"content": "然后呢，拿毛巾擦洗霍莱的全身…这样，它就会慢慢放松，四足上的爪子也会伸出来，这个时候，就可以为它修剪指甲了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210126,
						250210127
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250210126,
					"content": "这也太详细了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210128
					]
				},
				{
					"id": 250210128,
					"content": "那当然。霍莱可是我一手带大的。整个部族…不，整个纳塔也找不到比我更了解它的人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210129
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250210129,
					"content": "好了，你就按照我刚才说的，帮霍莱修剪一下指甲吧。我就在旁边，不明白的话来问我就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250210127,
					"content": "你真是了解霍莱…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210128
					]
				},
				{
					"id": 250210119,
					"content": "你怎么突然变兴奋了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210120
					]
				},
				{
					"id": 250210112,
					"content": "（摸摸霍莱。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210113
					]
				}
			]
		},
