			"dialogs": [
				{
					"id": 250213701,
					"content": "（霍莱歪了歪脑袋，挠了挠自己的肚子，迷茫地看着你。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213702
					],
					"speakerTitle": "霍莱"
				},
				{
					"id": 250213702,
					"content": "你可不能一直光顾着和霍莱玩呀。还有正事要做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213703
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250213703,
					"content": "咳！还是我来吧。让我给你示范一下，正确的刷洗方法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213704
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250213704,
					"content": "（卡兹加及时接手了工作。在又一阵细致的打理后，终于还是为霍莱修剪了指甲…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213705
					],
					"speakerTitle": "霍莱"
				},
				{
					"id": 250213705,
					"content": "你可不能光顾着和霍莱玩啊，还是先做正事比较好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213706
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250213706,
					"content": "呜！呜呜呜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213707
					],
					"speakerTitle": "霍莱"
				},
				{
					"id": 250213707,
					"content": "哈哈哈哈，但霍莱看起来还挺喜欢和你玩的，难怪这次刷洗的时候它这么听话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213708
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250213708,
					"content": "无论如何，这次还是多谢你了。这些东西给你，就当做是谢礼吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213709
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250213709,
					"content": "唔，要不然…我之后也试试，先陪霍莱玩个痛快，再给它刷洗…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213710
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250213710,
					"content": "霍莱，你觉得这个主意怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213711
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250213711,
					"content": "咦？霍莱去哪了？不，不会是又跑了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213712
					],
