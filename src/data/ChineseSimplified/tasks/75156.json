			"dialogs": [
				{
					"id": 751560101,
					"content": "呜呜，终于能从这个运龙车里出来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560102
					],
					"speakerTitle": "科奴拉芙"
				},
				{
					"id": 751560102,
					"content": "哎呀，这个运龙车实在是又闷又热，还一股臭味，只是坐进去这么小半天的功夫，就感觉折了两三年的寿啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560103
					],
					"speakerTitle": "科奴拉芙"
				},
				{
					"id": 751560103,
					"content": "是你？这次又是怎么回事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751560104
					]
				},
				{
					"id": 751560104,
					"content": "哎呀，原来是您呀，恩人，在旅途中我们居然再次又碰见…不，是又被您救了一次啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560105
					],
					"speakerTitle": "科奴拉芙"
				},
				{
					"id": 751560105,
					"content": "哎呀恩人啊，上次我不是说过，我的名字叫科奴拉芙，是「烟谜主」的实习祭司…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560106
					],
					"speakerTitle": "科奴拉芙"
				},
				{
					"id": 751560106,
					"content": "现在正在祭司的修行途中，嗯…部族的长辈告诉我，纳塔各地都留有先祖的宝藏，「去寻找宝藏吧，科奴拉芙！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560107
					],
					"speakerTitle": "科奴拉芙"
				},
				{
					"id": 751560107,
					"content": "于是就以进行修行为名把我一脚踢出了部族的大门——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560108
					],
					"speakerTitle": "科奴拉芙"
				},
				{
					"id": 751560108,
					"content": "哎呀，我动用灵巧的耳朵，探听到了这附近有宝藏的线索…说是跟着什么兽的步伐就可以找到宝藏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560109
					],
					"speakerTitle": "科奴拉芙"
				},
				{
					"id": 751560109,
					"content": "那不就是在说驮兽嘛！大概是驮兽吧…难不成还是绵驮兽？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560110
					],
					"speakerTitle": "科奴拉芙"
				},
				{
					"id": 751560110,
					"content": "总之，恩人啊…我跟踪了一只驮兽，结果跟到了这些人的营地里，以为我是偷驮兽的贼，当场关了起来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560111
					],
					"speakerTitle": "科奴拉芙"
				},
				{
					"id": 751560111,
					"content": "埋藏的宝藏没有找到，自己差点就要被埋藏起来了呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560112
					],
					"speakerTitle": "科奴拉芙"
				},
				{
					"id": 751560112,
					"content": "线索信息都不全…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751560113
					]
				},
				{
					"id": 751560113,
					"content": "您说的对，下次小女子我啊，不会再贸然行事了…或许这就是被关起来这件事得到的最好的宝藏——一个教训。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560114
					],
					"speakerTitle": "科奴拉芙"
				},
				{
					"id": 751560114,
					"content": "哎，这浑身的味儿，得找个地方好好洗个澡才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560115
					],
					"speakerTitle": "科奴拉芙"
				},
				{
					"id": 751560115,
					"content": "这次多谢恩人了，哎呀，为表感谢，小女子就从不是很多的盘缠里分出一些当做谢礼吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "科奴拉芙"
				}
			]
		},
