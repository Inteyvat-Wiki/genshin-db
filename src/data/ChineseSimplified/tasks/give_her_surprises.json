			"dialogs": [
				{
					"id": 401660201,
					"content": "咦？那边不是提纳里和柯莱吗？还有迪希雅和坎蒂丝！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401660202,
					"content": "我们过去和他们打个招呼吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401660203,
					"content": "…分工都清楚了吧？接下来就是分头行动了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660204
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 401660204,
					"content": "另外我还是再提醒一次，大家多留个心眼，千万别被她发现了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660205
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 401660205,
					"content": "哎呀这你就放心吧，对我们佣兵来说，秘密可是比生命还重要的东西！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660206
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 401660206,
					"content": "我认为，应该还不至于发生这类情况。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660207
					],
					"speakerTitle": "坎蒂丝"
				},
				{
					"id": 401660207,
					"content": "打比方啦打比方，你懂我的意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660208
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 401660208,
					"content": "唔…我还是有些担心。倒不是怕自己说漏嘴，是怕她如果冷不丁出现在身后，而我又没来得及发现…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660209
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 401660209,
					"content": "大家好呀！你们在这里聊什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401660210,
					"content": "唔啊啊！我不是我不知道什么都没聊，我绝对没藏什么秘密！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660211,
						401660212
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 401660211,
					"content": "绝对藏了什么秘密…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401660213
					]
				},
				{
					"id": 401660213,
					"content": "…冷静点，柯莱，至少也先看清是谁来了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660214
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 401660214,
					"content": "#{NICKNAME}和派蒙！没想到会在这里见到你们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660215
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 401660215,
					"content": "我也很高兴见到大家。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401660216
					]
				},
				{
					"id": 401660216,
					"content": "欸？是你们？啊…吓死我了，简直比上课开小差发现提纳里师父站在我身后还吓人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660217
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 401660217,
					"content": "二位是回须弥来参加花神诞祭的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660218
					],
					"speakerTitle": "坎蒂丝"
				},
				{
					"id": 401660218,
					"content": "嗯！一想到节日期间会很热闹，就回来找朋友们一起玩玩啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401660219,
					"content": "的确，听老师说，教令院今年也做了许多筹备，打算给草神大人过一个空前盛大的生日。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660220
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 401660220,
					"content": "也算是对曾经教令院种种过错的一个微不足道的补偿吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660221
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 401660221,
					"content": "嘿嘿，那我们算来对了呢，这下好玩好吃的肯定少不了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401660222,
					"content": "不过话说回来，你们刚才在偷偷摸摸说什么呀？什么秘密不秘密的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401660223,
					"content": "来，你俩过来，我悄悄跟你们说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660224
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 401660224,
					"content": "我们打算为草神大人准备一个惊喜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660225
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 401660225,
					"content": "哇！生日惊喜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401660226,
					"content": "这还是迪希雅提出来的呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660227
					],
					"speakerTitle": "坎蒂丝"
				},
				{
					"id": 401660227,
					"content": "欸？我也是和迪娜泽黛聊天时偶然想到的。每一届花神诞祭的活动都比较类似，总觉得该来些不一样的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660228
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 401660228,
					"content": "迪娜泽黛听完觉得这主意很棒，我就找上其他人，大家一拍即合，立刻组织起来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660229
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 401660229,
					"content": "既然是惊喜，知道的人自然越少越好。更何况对方是那位智慧之神，稍不注意，恐怕就会被她发现端倪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660230
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 401660230,
					"content": "哦！有道理。所以我们要一直这么小声地说话吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660231
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401660231,
					"content": "噗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660232
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 401660232,
					"content": "咳咳！总之，我们只通知了近期恰有空闲的几位朋友来准备这事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660233
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 401660233,
					"content": "具体要做些什么呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660234
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401660234,
					"content": "听说草神大人喜欢糖果，我们打算从这里入手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660235
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 401660235,
					"content": "还准备在花车巡游之后请她吃顿生日晚宴呢！所以七鲜桌什么的肯定也少不了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660236
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 401660236,
					"content": "具体的设计交给卡维了，现阶段我们只需要购置些食材和装饰就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660237
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 401660237,
					"content": "有什么我们能帮忙的吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401660238
					]
				},
				{
					"id": 401660238,
					"content": "对呀对呀，听都听到了，我们也想为这份生日惊喜出一份力呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660239
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401660239,
					"content": "咦？我记得坎蒂丝你刚才说想要个人帮忙一起采购，这不正好吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660240
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 401660240,
					"content": "嗯，我担心自己在沙漠待久了，对这边商品的价格和品相会有些生疏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660241
					],
					"speakerTitle": "坎蒂丝"
				},
				{
					"id": 401660241,
					"content": "我们可以和你一起。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401660242
					]
				},
				{
					"id": 401660242,
					"content": "若是不麻烦你们的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660243
					],
					"speakerTitle": "坎蒂丝"
				},
				{
					"id": 401660243,
					"content": "不麻烦不麻烦！不如说恰好能帮上大家的忙，对我们来说才是惊喜呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660244
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401660244,
					"content": "哟，派蒙真是越来越会说话了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660245
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 401660245,
					"content": "那我就承蒙二位的好意了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660246
					],
					"speakerTitle": "坎蒂丝"
				},
				{
					"id": 401660246,
					"content": "那就这么定了！装饰交给我和迪娜泽黛就行，宴会场地拜托提纳里操办。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660247
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 401660247,
					"content": "听得我都激动起来了，快开始吧！一起为纳西妲准备份了不得的生日惊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660248
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401660248,
					"content": "嘘…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660249
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 401660249,
					"content": "哦…对，兴奋得差点忘了…保密要紧，保密要紧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401660212,
					"content": "老实交代吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401660213
					]
				}
			]
		},
