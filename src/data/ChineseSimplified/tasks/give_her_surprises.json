			"dialogs": [
				{
					"id": 401660401,
					"content": "我记得水果摊就在那边…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401660402,
					"content": "呃…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660403
					],
					"speakerTitle": "坎蒂丝"
				},
				{
					"id": 401660403,
					"content": "咦？坎蒂丝你没事吧…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401660404,
					"content": "…！危险！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660405
					],
					"speakerTitle": "坎蒂丝"
				},
				{
					"id": 401660405,
					"content": "…欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660406
					],
					"speakerTitle": "哈蒂丝"
				},
				{
					"id": 401660406,
					"content": "坎蒂丝飞身一跃，救下了差点被箱子砸到的孩子…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401660407
					]
				},
				{
					"id": 401660407,
					"content": "没受伤吧孩子？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660408
					],
					"speakerTitle": "坎蒂丝"
				},
				{
					"id": 401660408,
					"content": "没…没事…谢谢大姐姐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660409
					],
					"speakerTitle": "哈蒂丝"
				},
				{
					"id": 401660409,
					"content": "发生什么了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660410
					],
					"speakerTitle": "夏姆"
				},
				{
					"id": 401660410,
					"content": "那边的箱子突然倒了下来，还好坎蒂丝护住了这孩子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401660411,
					"content": "你父母呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660412
					],
					"speakerTitle": "夏姆"
				},
				{
					"id": 401660412,
					"content": "我…他们在港口的酒馆，我一个人无聊，才…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660413
					],
					"speakerTitle": "哈蒂丝"
				},
				{
					"id": 401660413,
					"content": "已经没事了，亲爱的孩子，下次玩耍时注意安全就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660414
					],
					"speakerTitle": "坎蒂丝"
				},
				{
					"id": 401660414,
					"content": "…快回去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660415
					],
					"speakerTitle": "夏姆"
				},
				{
					"id": 401660415,
					"content": "好的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660416
					],
					"speakerTitle": "哈蒂丝"
				},
				{
					"id": 401660416,
					"content": "这是谁家的箱子？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660417
					],
					"speakerTitle": "夏姆"
				},
				{
					"id": 401660417,
					"content": "是…是我的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660418
					],
					"speakerTitle": "库特比"
				},
				{
					"id": 401660418,
					"content": "都说了不要在道路周围堆放重物！怎么还在犯这种错误？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660419
					],
					"speakerTitle": "夏姆"
				},
				{
					"id": 401660419,
					"content": "抱歉！最近…最近货物稍微多了些，仓库不够放…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660420
					],
					"speakerTitle": "库特比"
				},
				{
					"id": 401660420,
					"content": "嗯？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660421
					],
					"speakerTitle": "夏姆"
				},
				{
					"id": 401660421,
					"content": "我这就处理！下次再也不放了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660422
					],
					"speakerTitle": "库特比"
				},
				{
					"id": 401660422,
					"content": "哎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660423
					],
					"speakerTitle": "夏姆"
				},
				{
					"id": 401660423,
					"content": "谢谢你们，都怪我监督不周。要不是坎蒂丝小姐，还真不知道事情会变成什么样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660424
					],
					"speakerTitle": "夏姆"
				},
				{
					"id": 401660424,
					"content": "举手之劳罢了，夏姆先生也不必过于自责，我很能理解守护一片区域的不易。只是节日在即，各处还需要您多多留神。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660425
					],
					"speakerTitle": "坎蒂丝"
				},
				{
					"id": 401660425,
					"content": "唉，这花神诞祭期间，还真是有几只眼睛都看不过来。哦，请别误会，坎蒂丝小姐的提醒我已经记下了，一定注意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660426
					],
					"speakerTitle": "夏姆"
				},
				{
					"id": 401660426,
					"content": "几位是来采购的吗？那我也不再叨扰了。祝你们节日愉快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660427
					],
					"speakerTitle": "夏姆"
				},
				{
					"id": 401660427,
					"content": "坎蒂丝你动作也太快了吧！总感觉那箱子还没掉下来的时候你就冲过去了呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660428
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401660428,
					"content": "简直像知道箱子会掉一样…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401660429
					]
				},
				{
					"id": 401660429,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660430
					],
					"speakerTitle": "坎蒂丝"
				},
				{
					"id": 401660430,
					"content": "其实…我当时的确看到了那箱子掉下的「未来」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660431
					],
					"speakerTitle": "坎蒂丝"
				},
				{
					"id": 401660431,
					"content": "欸？你的意思是，你预知了未来？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660432
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401660432,
					"content": "嗯…包括刚才炉火的意外也是，我看到了将要发生的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660433,
						401660434
					],
					"speakerTitle": "坎蒂丝"
				},
				{
					"id": 401660433,
					"content": "「预示之眼」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401660435
					]
				},
				{
					"id": 401660435,
					"content": "我不觉得我的琥珀色左眼有何特殊之处，以前，它从未让我看到过什么奇怪的异象…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660436
					],
					"speakerTitle": "坎蒂丝"
				},
				{
					"id": 401660436,
					"content": "但从今早开始，我时常看见某些画面，它们与现实不符，却在几秒后真真切切地发生了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660437
					],
					"speakerTitle": "坎蒂丝"
				},
				{
					"id": 401660437,
					"content": "你有告诉其他人吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660438
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401660438,
					"content": "还没有…我尚且无法确定这是否真是「预示」，也不想让大家担心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660439,
						401660440
					],
					"speakerTitle": "坎蒂丝"
				},
				{
					"id": 401660439,
					"content": "为什么是今早开始？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401660441
					]
				},
				{
					"id": 401660441,
					"content": "回忆起来…并没有太过特殊的。我同往常一样安排好一日事务，向神明做完祷告，就来见朋友了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660442
					],
					"speakerTitle": "坎蒂丝"
				},
				{
					"id": 401660442,
					"content": "实在要挑出些不寻常的话，大概就是我在路上买了一块好看的宝石吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660443
					],
					"speakerTitle": "坎蒂丝"
				},
				{
					"id": 401660443,
					"content": "的确挺好看的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660444
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401660444,
					"content": "但总感觉…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401660445
					]
				},
				{
					"id": 401660445,
					"content": "你也察觉到了？这宝石中似乎蕴藏着些微特殊的元素痕迹，我也是对此感到好奇才买下的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660446
					],
					"speakerTitle": "坎蒂丝"
				},
				{
					"id": 401660446,
					"content": "难道说这些「预示」，是宝石的作用？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660447
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401660447,
					"content": "#有这种可能。来，{NICKNAME}，你拿这宝石试试，看看能不能感觉到什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660448
					],
					"speakerTitle": "坎蒂丝"
				},
				{
					"id": 401660448,
					"content": "（……）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401660449
					]
				},
				{
					"id": 401660449,
					"content": "好像没什么感觉。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401660450
					]
				},
				{
					"id": 401660450,
					"content": "嗯…看来也不是对每个人都有效果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660451
					],
					"speakerTitle": "坎蒂丝"
				},
				{
					"id": 401660451,
					"content": "难道需要某种条件来触发吗…还是说，与我身为阿赫玛尔大人的子民有关…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660452
					],
					"speakerTitle": "坎蒂丝"
				},
				{
					"id": 401660452,
					"content": "要不要去找其他人问问？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660453
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401660453,
					"content": "最近大家都忙于置办花神诞祭，不到万不得已，我可不能因为这种小事打扰朋友们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660454
					],
					"speakerTitle": "坎蒂丝"
				},
				{
					"id": 401660454,
					"content": "刚好这两天分配给我的任务不多，我自行调查就好。这也是一位「守护者」该做的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660455
					],
					"speakerTitle": "坎蒂丝"
				},
				{
					"id": 401660455,
					"content": "我们也可以帮忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401660456
					]
				},
				{
					"id": 401660456,
					"content": "那就再好不过了，有你在身边，总能让人感到安心，就像夜晚的篝火旁有人陪伴一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660457
					],
					"speakerTitle": "坎蒂丝"
				},
				{
					"id": 401660457,
					"content": "先将采购的工作做完吧，再之后就去打听打听关于这块石头的情报。至少得从商人口中知道它的来源。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660458
					],
					"speakerTitle": "坎蒂丝"
				},
				{
					"id": 401660458,
					"content": "说到「商人」的话，我们不是正好认识一位消息灵通的大商人吗？虽然从她嘴里要情报，可能会花掉包里不少摩拉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660459
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401660459,
					"content": "是说那位「多莉」大商人吧？我在阿如村也早有耳闻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660460
					],
					"speakerTitle": "坎蒂丝"
				},
				{
					"id": 401660460,
					"content": "没错，就是她！呃，不过多莉那家伙对摩拉可是很敏感的哦！坎蒂丝你和她谈价格时，最好下手轻点…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660461
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401660461,
					"content": "与坎蒂丝一起购置了清单上的水果…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401660462
					]
				},
				{
					"id": 401660462,
					"content": "同时还从商贩们那里打听到了多莉的下落…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 401660440,
					"content": "今早发生了什么吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401660441
					]
				},
				{
					"id": 401660434,
					"content": "真的应验了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401660435
					]
				}
			]
		},
