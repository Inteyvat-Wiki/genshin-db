			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"薇尔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411240201,
					"content": "哎呀，你总算来了，我都等你好久了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240202
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 411240202,
					"content": "你等我做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240203
					]
				},
				{
					"id": 411240203,
					"content": "不要这么冷冰冰的嘛，我可是有很重要的事情想要拜托你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240204
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 411240204,
					"content": "那些陨石你也看到了，虽然没有陨石砸进蒙德城，但现在蒙德城内外为了处理和陨石相关的事，已经全都乱成一团了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240205
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 411240205,
					"content": "既然蒙德城的这池子水已经被搅浑了，那么某些想要浑水摸鱼的家伙，一定也不会放过这次机会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240206,
						411240208
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 411240206,
					"content": "你说的是…盗宝团？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240207
					]
				},
				{
					"id": 411240207,
					"content": "哦呀，果然是身经百战的冒险家，很敏锐嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240212
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 411240212,
					"content": "虽然西风骑士们已经提高了警惕，但为了支援周围，蒙德城的城防多多少少还是有一些漏洞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240213
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 411240213,
					"content": "那群为了钱什么都愿意做的盗宝团，一定已经开始做打算，准备钻空子进城来「大捞一笔」了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240214,
						411240217
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 411240214,
					"content": "那我能做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240215
					]
				},
				{
					"id": 411240215,
					"content": "哎呀，你居然这么爽快就答应了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240216
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 411240216,
					"content": "哈哈哈，看样子，那位先生告诉我的应对方法完全用不上了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240222
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 411240222,
					"content": "好了，简单来说…之前来蒙德城周围侦察的盗宝团成员，已经被那位先生亲自拿下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240223
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 411240223,
					"content": "据他们说，有大概三支盗宝团在打浑水摸鱼的主意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240224
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 411240224,
					"content": "所以我们就将计就计，帮盗宝团们设计好了「最佳入侵地点」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240225,
						411240226
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 411240225,
					"content": "我要怎么做？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240231
					]
				},
				{
					"id": 411240231,
					"content": "你要做的事很简单。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240232
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 411240232,
					"content": "为了保证不被一网打尽，前来侦察的盗宝团并不会直接回去报告。而是会把侦察到的情报用信的方式放在特定的接头点上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240233
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 411240233,
					"content": "而且为了防止出问题，他们还专门派了三个人来侦察，并且在三个不同的地点分别交付情报。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240234
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 411240234,
					"content": "不过，他们肯定没想到，这三个人全被那位先生拿下了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240235
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 411240235,
					"content": "在接到情报后，盗宝团的其他成员才会开始制订计划，选定最佳的入侵地点…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240236
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 411240236,
					"content": "但是这次不劳他们费心，那位先生已经帮他们把计划全部详细地制订好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240237
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 411240237,
					"content": "这三封信给你，你去把它们分别放在盗宝团的三个接头点上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240238
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 411240238,
					"content": "放好之后，就回来告诉我吧，剩下的事…唔，我们之后再说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "薇尔"
				},
				{
					"id": 411240226,
					"content": "盗宝团说的话能信吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240227
					]
				},
				{
					"id": 411240227,
					"content": "哈哈哈，你想得还挺周全嘛。放心啦，盗宝团的人可不会有什么骨气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240228
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 411240228,
					"content": "那群家伙，说到底只是一群只为求财的毛贼而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240229
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 411240229,
					"content": "「和我们合作会有更多的赚头，耍滑头的话就会赔到倾家荡产。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240230
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 411240230,
					"content": "只要让他们意识到这一点，他们就会乖乖和我们合作了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240231
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 411240217,
					"content": "西风骑士们会处理好的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240218
					]
				},
				{
					"id": 411240218,
					"content": "哈哈哈，你果然这么说了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240219
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 411240219,
					"content": "放心啦，那位先生这次给了我不少预算，报酬不会少你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240220
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 411240220,
					"content": "你在帮忙的途中要是有什么收获，也可以自己收着。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240221
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 411240221,
					"content": "而且，这件事非你不可哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240222
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 411240208,
					"content": "你说的是…丘丘人？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240209
					]
				},
				{
					"id": 411240209,
					"content": "哈哈哈，你想到哪里去了，丘丘人可没机会浑水摸鱼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240210
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 411240210,
					"content": "只要它们靠近城边，西风骑士们就会马上把它们击退啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240211
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 411240211,
					"content": "我说的那群想要浑水摸鱼的家伙，是盗宝团哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240212
					],
					"speakerTitle": "薇尔"
				}
			]
		},
		{
			"id": 4112406,
			"completionStepIds": [
				4112406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4112406",
							"2"
						],
						"stepId": 4112406,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"薇尔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411240601,
					"content": "放好信件了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240602
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 411240602,
					"content": "都放好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240603
					]
				},
				{
					"id": 411240603,
					"content": "这样就可以了，那群盗宝团一定会根据那三份情报制订入侵计划。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240604
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 411240604,
					"content": "而他们那份计划中的「最佳入侵时间」，一定是从入夜到凌晨之间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240605
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 411240605,
					"content": "还有「最佳入侵地点」…当然也只有一个啦。唔，我来标注在你的地图上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240606
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 411240606,
					"content": "这样就可以了，我们就等着那群盗宝团来自投罗网吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240607,
						411240610
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 411240607,
					"content": "如果被西风骑士发现…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240608
					]
				},
				{
					"id": 411240608,
					"content": "嗯…你的担心也有点道理。毕竟我们使用这种非常规的手段，要是被西风骑士们发现，免不了会带来一堆麻烦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240609
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 411240609,
					"content": "不过，那位先生向我保证不会出现这样的问题，我们就…相信他吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240612
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 411240612,
					"content": "好了，等到入夜之后，你就去把那群自投罗网的盗宝团们全都打倒吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "薇尔"
				},
				{
					"id": 411240610,
					"content": "要是没出现的话…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240611
					]
				},
