			},
			"dialogs": [
				{
					"id": 751780701,
					"content": "何等「冰冷」！这是何等的「冰冷」啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780702
					],
					"speakerTitle": "马范"
				},
				{
					"id": 751780702,
					"content": "欸、欸？！冷？哪里冷了？你不是在温泉里吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780703
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751780703,
					"content": "不够！还不够！如此冰冷，如何堪称「最强」！要成为「沃陆之邦」，不对「纳塔最强」，这「烈度」还远远不够！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780704
					],
					"speakerTitle": "马范"
				},
				{
					"id": 751780704,
					"content": "欸？为什么又坐下了？为什么啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780705,
						751780707
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751780705,
					"content": "看来「烈度」还是不够！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780706
					]
				},
				{
					"id": 751780706,
					"content": "「烈度」到底是什么啊？怎么你说的话我也听不懂了啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780709
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751780709,
					"content": "#太棒了，想必两位就是著名的冒险家{NICKNAME}和派蒙了，这下有救了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780710
					],
					"speakerTitle": "尤鲁赫"
				},
				{
					"id": 751780710,
					"content": "什、什么？发生了什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780711
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751780711,
					"content": "实不相瞒两位，按照大师本人的话来说，他正在向着「最强」之路前进，沉浸在温泉修行之中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780712
					],
					"speakerTitle": "尤鲁赫"
				},
				{
					"id": 751780712,
					"content": "修、修行？在温泉里吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780713
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751780713,
					"content": "对、对啊…虽、虽然我也不是很敢相信。但这方法，是大师从一本名为《烈泉道》的武道书上看来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780714
					],
					"speakerTitle": "尤鲁赫"
				},
				{
					"id": 751780714,
					"content": "书上说，如果按照烈泉之道修炼，有朝一日可以只凭自己的「烈度」，让<color=#00E1FFFF>冷水沸腾</color>！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780715
					],
					"speakerTitle": "尤鲁赫"
				},
				{
					"id": 751780715,
					"content": "不仅如此，这书上还记录了好多强者，有的人可以一夜徒手打穿山体，还有的人可以空手将石头捏成宝石！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780716
					],
					"speakerTitle": "尤鲁赫"
				},
				{
					"id": 751780716,
					"content": "#没想到世界上还有这么神奇的武道！要是{NICKNAME}也能学会的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780717,
						751780718
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751780717,
					"content": "哇，是小说才会有的设定。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780719
					]
				},
				{
					"id": 751780719,
					"content": "也许你们会觉得这书荒唐，但这毕竟是大师从「烟谜主」的书堆里淘回的珍本，而且最重要的是，大师本人对它深信不疑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780720
					],
					"speakerTitle": "尤鲁赫"
				},
				{
					"id": 751780720,
					"content": "为了实践烈泉道，大师特意挑了这个特殊的温泉，不，是「冷泉」。要将极致的「冷泉」靠纯粹的「烈度」，化作极致的「温泉」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780721
					],
					"speakerTitle": "尤鲁赫"
				},
				{
					"id": 751780721,
					"content": "真、真的欸，温泉里的水真的一点都不热！不过…一直泡在这样的水里，就算再怎么厉害的人也会生病的吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780722
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751780722,
					"content": "唉，就算不会生病也不行啊！「勇士挑战」那边已经停了好几天了，都等着大师他回去呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780723
					],
					"speakerTitle": "尤鲁赫"
				},
				{
					"id": 751780723,
					"content": "但大师说，半途而废是没有「烈度」的行为。因此，除非泉水沸腾，不然他绝不离开。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780724
					],
					"speakerTitle": "尤鲁赫"
				},
				{
					"id": 751780724,
					"content": "旁边的管理员也没找到温泉变冷的原因。唉，这个时候要是有熟练的冒险家在就好了…我连报酬都准备好了，你看有这么多呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780725,
						751780726
					],
					"speakerTitle": "尤鲁赫"
				},
				{
					"id": 751780725,
					"content": "这事你应该找「流泉之众」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780727
					]
				},
				{
					"id": 751780727,
					"content": "（不要着急拒绝啦，我们先看看他的报酬有多少嘛。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780728
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751780728,
					"content": "咳咳，你放心我们肯定会让温泉变热的。再说啦，我们也不能看着他因为冷掉的温泉生病吧，毕竟好冒险家总是助人为乐的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780729
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751780729,
					"content": "太好了，那就拜托你们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780730
					],
					"speakerTitle": "尤鲁赫"
				},
				{
					"id": 751780730,
					"content": "你就在这里等我们的好消息吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751780726,
					"content": "你是打算用报酬来收买我么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780727
					]
				},
				{
					"id": 751780718,
					"content": "你不会真信了吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780719
					]
				},
				{
					"id": 751780707,
					"content": "因为站起来会更冷吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780708
					]
				},
				{
					"id": 751780708,
					"content": "原来是这样，怪不得他全身正在发抖呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780709
					],
					"speakerTitle": "派蒙"
				}
			]
		},
