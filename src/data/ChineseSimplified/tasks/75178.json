			"dialogs": [
				{
					"id": 751780901,
					"content": "#{NICKNAME}{M#哥哥}{F#姐姐}，你们好啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780902,
						751780903
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 751780902,
					"content": "怎么无精打采的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780904
					]
				},
				{
					"id": 751780904,
					"content": "其实…相比之前，温泉的水温好像还是有点冷…这次我闯了好大的祸，回去以后该怎么办啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780905
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 751780905,
					"content": "别担心，再等等看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780906
					]
				},
				{
					"id": 751780906,
					"content": "嗯，我知道了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "？？？"
				},
				{
					"id": 751780903,
					"content": "再见。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780907
					]
				},
				{
					"id": 751780907,
					"content": "#唔…路上小心，{NICKNAME}{M#哥哥}{F#姐姐}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "？？？"
				}
			]
		},
