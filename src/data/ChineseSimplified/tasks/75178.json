			"dialogs": [
				{
					"id": 751781001,
					"content": "——唔，虽然先答应下来帮忙了。但…应该从哪里开始呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781002,
						751781005
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751781002,
					"content": "要不使用神奇的燃素？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751781003
					]
				},
				{
					"id": 751781003,
					"content": "呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781004
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751781004,
					"content": "这范围太大了！怎么想都不可能吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781009
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751781009,
					"content": "唉…就没有什么更实际的办法吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781010
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751781010,
					"content": "呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781011
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751781011,
					"content": "#等等！{REALNAME[ID(2)|SHOWHOST(true)]}，不要乱跑啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751781005,
					"content": "火山里应该有很多熔岩…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751781006
					]
				},
				{
					"id": 751781006,
					"content": "哦！我懂了，让小家伙帮忙挖个洞，然后用火山的熔岩来加热温泉对不？是个不错的办法呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781007
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751781007,
					"content": "呀！呀！呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781008
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751781008,
					"content": "#才怪呢！用熔岩是会闹出人命来的！认真一点啦！你看{REALNAME[ID(2)|SHOWHOST(true)]}都信了啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781009
					],
					"speakerTitle": "派蒙"
				}
			]
