			"dialogs": [
				{
					"id": 751781401,
					"content": "咦，小鳍游龙？怎么会在这里？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751781402,
					"content": "——奇欧奇欧！你果然在这里…如、如果你们再不出来的话，我、我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781403
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 751781403,
					"content": "万一受伤了怎么办？下次可不许乱跑了，呜呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781404
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 751781404,
					"content": "别、别哭了，你看，小龙不是好好的吗？很有精神的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751781405,
					"content": "呀！呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781406
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751781406,
					"content": "嗯，没、没问题的。我、我叫莉娜夏，是「流泉之众」那边的…平时都是我负责照看小鳍游龙的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781407
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 751781407,
					"content": "负责照看小鳍游龙？真了不起！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751781408,
					"content": "没、没有啦…我要是能像派蒙姐姐一样的话，它们肯定就不会跑丢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781409
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 751781409,
					"content": "刚刚我就在想，是不是大家都跑去喷口玩了，所以才找不到。现在来看，果然是这样的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781410
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 751781410,
					"content": "原来温泉变冷，是因为小鳍游龙们把燃素喷口堵住了啊。怪不得管理员都没发现呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751781411,
					"content": "派、派蒙姐姐！其实…我还有两只龙伙伴没找到，估计它们也是躲在燃素喷口里玩了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781412
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 751781412,
					"content": "没问题，你放心吧！我们在调节水温的时候，会顺便把小鳍游龙们帮你找回来的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751781413,
					"content": "嗯，有派蒙姐姐在，我就放心啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781414
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 751781414,
					"content": "啊哈哈，那当然，我可是传说中的冒险家，这等小事肯定是手到擒来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751781415,
					"content": "哇！派蒙姐姐好厉害！我也要成为跟派蒙姐姐一样的人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781416,
						751781417
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 751781416,
					"content": "确实，派蒙姐姐好厉害呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751781418
					]
				},
