			},
			"dialogs": [
				{
					"id": 751780501,
					"content": "异邦的勇士，如何？你们找到通向「最强」的道路了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780502,
						751780503
					],
					"speakerTitle": "卢施"
				},
				{
					"id": 751780502,
					"content": "关于「最强」的位置…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780504
					]
				},
				{
					"id": 751780504,
					"content": "往山上走，有一片充满「烈度之水」的山地。在那里，你们或许能找到「最强」的身影…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卢施"
				},
				{
					"id": 751780503,
					"content": "还在努力…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780505
					]
				},
				{
					"id": 751780505,
					"content": "甚好，甚好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卢施"
