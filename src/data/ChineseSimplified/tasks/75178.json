				"points": []
			},
			"dialogs": [
				{
					"id": 751780201,
					"content": "有、有没有人帮忙搭把手！有人晕过去了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780202
					],
					"speakerTitle": "尤鲁赫"
				},
				{
					"id": 751780202,
					"content": "#完、完蛋了！大师好像晕过去了！我们也快去帮忙吧，{NICKNAME}！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780203
					]
				},
				{
					"id": 751780203,
					"content": "大师似乎只是热晕了过去，身体并没有大碍。在你们的帮助下，晕倒的大师被尤鲁赫接走了…\\n看起来，大师本人的「烈度」，或许还有待进一步的提升…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
