					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 400661401,
					"content": "不对，虽然样子没什么区别…可他都听不到我们说话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400661402,
					"content": "看来这只是个幻影，不是跟我们一起来的那个万叶。",
