						],
						"stepId": 4006611,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"枫原万叶",
					"枫原景春"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400661101,
					"content": "请恕我无法理解！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661102
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400661102,
					"content": "万叶，你忘了我们之间的约定吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661103
					],
					"speakerTitle": "枫原景春"
				},
				{
					"id": 400661103,
					"content": "您真的要放弃这一切吗？就算…就算我们过得艰苦，可您还有我在身边啊，我难道不能帮助您吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661104
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400661104,
					"content": "您像我这么大的时候，已经在为爷爷分忧了吧。是我太无能，让您失望，还是说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661105
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400661105,
					"content": "万叶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661106
					],
					"speakerTitle": "枫原景春"
				},
				{
					"id": 400661106,
					"content": "…唉，你会为这些事自责，正是我作为父亲失败的证明啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661107
					],
					"speakerTitle": "枫原景春"
				},
				{
					"id": 400661107,
					"content": "枫原家为过去的错误付出了太多太多。从你曾祖父那一辈开始，直到现在，我们都没能真正走出阴霾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661108
					],
					"speakerTitle": "枫原景春"
				},
				{
					"id": 400661108,
					"content": "锻刀是我们一族的事业，可你记住，家族的事业，未必就要是你的全部。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661109
					],
					"speakerTitle": "枫原景春"
				},
				{
					"id": 400661109,
					"content": "受伤的野兽想要走出陷阱，就要忍痛舍弃被钳制的后腿。你觉得这是损失，可不离开陷阱，后果更为致命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661110
					],
					"speakerTitle": "枫原景春"
				},
				{
					"id": 400661110,
					"content": "已经够了，万叶。我身为一家之主，却没能振兴家族让你当上贵族少爷。你不埋怨我，我就挺高兴了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661111
					],
					"speakerTitle": "枫原景春"
				},
				{
					"id": 400661111,
					"content": "几代人的痛苦…就到今天为止吧。从今往后，卸下担子生活。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661112
					],
					"speakerTitle": "枫原景春"
				},
				{
					"id": 400661112,
					"content": "至于舍弃家族产业的恶名，我来背负就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661113
					],
					"speakerTitle": "枫原景春"
				},
				{
					"id": 400661113,
					"content": "…父亲…请别这样，当不起家的恶名，可不能落在您头上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661114
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400661114,
					"content": "要是真有那么一天，我也要为您分担。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661115
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400661115,
					"content": "再等等吧。枫原家迟早会传到我手中，等那时，再由我来处理这些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "枫原万叶"
				}
			]
		},
		{
			"id": 4006614,
			"completionStepIds": [
				4006614
			],
