			},
			"dialogs": [
				{
					"id": 400660301,
					"content": "哇，是新的空间！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400660302,
					"content": "与上次一样，只有万叶卿不在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660303
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 400660303,
					"content": "好，这里就交给我们几个啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "辛焱"
				}
			]
		},
		{
			"id": 4006606,
			"completionStepIds": [
				4006606
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4006606",
							"2"
						],
						"stepId": 4006606,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"枫原景春",
					"枫原万叶"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400660601,
					"content": "…好，这样就可以了。万叶，来得正好，你看我这块石头雕得如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660602
					],
					"speakerTitle": "枫原景春"
				},
				{
					"id": 400660602,
					"content": "灵巧有趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660603
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400660603,
					"content": "呵呵，这是我从书上看来的山景。别国有许多高耸入云的名山，如有机会，真想外出看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660604
					],
					"speakerTitle": "枫原景春"
				},
				{
					"id": 400660604,
					"content": "您若想去，随时都能出发。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660605
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400660605,
					"content": "话不能这么说。我是如今的家主，虽说枫原家远不比从前，可该做的事，一件都没少啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660606
					],
					"speakerTitle": "枫原景春"
				},
				{
					"id": 400660606,
					"content": "但…像这样坚持父辈的道路，为一度陨落的家族事业倾尽所有，当真值得吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660607
					],
					"speakerTitle": "枫原景春"
				},
				{
					"id": 400660607,
					"content": "父亲，我…不明白。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660608
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400660608,
					"content": "…万叶，我希望你记得一件事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660609
					],
					"speakerTitle": "枫原景春"
				},
				{
					"id": 400660609,
					"content": "家族固然重要，人却也不能拘泥于此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660610
					],
					"speakerTitle": "枫原景春"
				},
				{
					"id": 400660610,
					"content": "家因人而存在。要是我们自己过得苦闷，又谈何让家人快乐幸福呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660611
					],
					"speakerTitle": "枫原景春"
				},
				{
					"id": 400660611,
					"content": "从前的事，影响家族甚多。可它不应是让子孙背负的重担。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660612
					],
					"speakerTitle": "枫原景春"
				},
				{
					"id": 400660612,
					"content": "…如果有一天，你厌倦了无趣的生活，就丢下一切出去走走。切记，不要让生活束缚了你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660613
					],
					"speakerTitle": "枫原景春"
				},
				{
					"id": 400660613,
					"content": "是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "枫原万叶"
				}
			]
		},
		{
			"id": 4006611,
			"completionStepIds": [
				4006611
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4006611",
