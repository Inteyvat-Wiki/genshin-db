			"trigger": {
				"objectNames": [
					"好奇的帕琪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200410101,
					"content": "冒险不可能有完美的方案！这么拖下去，什么时候才能有进展？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410102
					],
					"speakerTitle": "好奇的帕琪"
				},
				{
					"id": 200410102,
					"content": "就算没有完美的方案，也要做好万全的准备！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410103
					],
					"speakerTitle": "杜兰"
				},
				{
					"id": 200410103,
					"content": "你们在吵什么呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200410104
					]
				},
				{
					"id": 200410104,
					"content": "我是研究古代遗迹的学者，想要去千风神殿里考察。但我不太擅长对付需要战斗的场合。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410105
					],
					"speakerTitle": "好奇的帕琪"
				},
				{
					"id": 200410105,
					"content": "杜兰先生说自己是个冒险家，把调查神殿的任务都揽了下来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410106
					],
					"speakerTitle": "好奇的帕琪"
				},
				{
					"id": 200410106,
					"content": "我，我并不是说杜兰先生怎么样，我也知道那个遗迹守卫很麻烦，但是他说要制订一个完美的冒险方案，不停地拉着我开会研究…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410107
					],
					"speakerTitle": "好奇的帕琪"
				},
				{
					"id": 200410107,
					"content": "研究…调查…调整，然后再调查…研究…调整…我已经受不了了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410108
					],
					"speakerTitle": "好奇的帕琪"
				},
				{
					"id": 200410108,
					"content": "他刚才又找到了一条线索，说是神殿旁边有一片怪物营地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410109
					],
					"speakerTitle": "好奇的帕琪"
				},
				{
					"id": 200410109,
					"content": "拜托你，去把那片营地给清理掉吧！就算不能进神殿，把他的嘴堵住也好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410110,
						200410111
					],
					"speakerTitle": "好奇的帕琪"
				},
				{
					"id": 200410110,
					"content": "我，我知道了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 200410111,
					"content": "我来和杜兰先生开会。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200410112
					]
				},
				{
					"id": 200410112,
					"content": "谢谢你的好意，但是相信我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410113
					],
					"speakerTitle": "好奇的帕琪"
				},
				{
					"id": 200410113,
					"content": "比起开会，你会更愿意对付魔物的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "好奇的帕琪"
				}
			]
		},
