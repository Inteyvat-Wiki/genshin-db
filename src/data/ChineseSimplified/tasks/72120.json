			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"泽维尔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721200301,
					"content": "怎么样？您把道路都检查过了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200302
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721200302,
					"content": "道路已经很通畅了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721200303
					]
				},
				{
					"id": 721200303,
					"content": "好。那、那我们过段时间就出发…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200304
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721200304,
					"content": "你是在…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721200305
					]
				},
				{
					"id": 721200305,
					"content": "我是在…思考！思考可能发生的各种情况，您明白吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200306
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721200306,
					"content": "比如进去的时候，发现核心已经被那群疯子掏出来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200307
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721200307,
					"content": "然后那群疯子还把核心塞进了遗迹守卫里，然后这个遗迹守卫失去控制，把我们全都打飞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200308
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721200308,
					"content": "或者是我们在净化「御影炉心」的时候，突然蹦出来一个什么元素生物，一口气把核心吃下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200309
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721200309,
					"content": "最、最糟糕的就是，要是那个传说中的大蛇借此复活，那我们可就彻底完蛋了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200310,
						721200311
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721200310,
					"content": "你冷静一点…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721200312
					]
				},
				{
					"id": 721200312,
					"content": "呃…唔，抱歉，我老毛病又犯了，每次都会不由自主地把事情往最坏的那方面想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200313
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721200313,
					"content": "我会好好做一份计划，等时候到了，我们就正式出发去搞定这件事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200314
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721200314,
					"content": "希望一切顺利，希望一切顺利，希望一切顺利…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721200311,
					"content": "应该不会那么夸张…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721200312
					]
				}
			]
		},
