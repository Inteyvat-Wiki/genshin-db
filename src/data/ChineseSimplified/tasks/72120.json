					"泽维尔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721200101,
					"content": "很好！上次的试验很顺利，「鬼兜虫」上的「祟神」被干净利落地净化了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200102
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721200102,
					"content": "那我们现在…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721200103
					]
				},
				{
					"id": 721200103,
					"content": "我们现在只需要规划好前进路线，就可以正式开工了。但这条路线必须得绕开那些愚人众才行…看来得绕点远路了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200104
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721200104,
					"content": "毕竟这家伙…还挺大的，我们两个人想要把它搬进去的话，可先得保证运送道路的通畅才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200105
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721200105,
					"content": "所以，我想拜托您再去「御影炉心」附近调查一下，如果遇见坏掉的道路，最好能稍微维修一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200106
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721200106,
					"content": "虽然我还没规划好路线…但我们最好能保证大部分道路都是通畅的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200107
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721200107,
					"content": "我可不会修路。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721200108
					]
				},
				{
					"id": 721200108,
					"content": "不用修得特别…可靠，只需要在上面铺一层木板，让我们能搬着这伙计过去就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200109
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721200109,
					"content": "啊，您可以先去旁边拿点木板。我在这里继续摆弄这家伙，尽量让它更可靠点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "泽维尔"
				}
			]
		},
