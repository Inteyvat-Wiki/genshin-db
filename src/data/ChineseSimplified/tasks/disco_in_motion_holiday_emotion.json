			"dialogs": [
				{
					"id": 756740101,
					"content": "如此如此…这般这般…小贼们肯定会跪地哭号…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740102
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 756740102,
					"content": "这种时候「失误放跑」一个小贼，他肯定会惊恐地回去通风报信，你再悄悄尾随…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740103
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 756740103,
					"content": "就能在小贼们商量对策的时候，踹开他们老巢的大门，给他们恐怖映影般的惊吓！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740104
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 756740104,
					"content": "您说得很有道理，昂吉安妮小姐。对付油盐不进的恶人，的确要用超出常理的手段。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740105
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 756740105,
					"content": "纳塔不像枫丹，有那么繁琐…咳，「严格的执法程序」！我会好好利用这个优势。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740106
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 756740106,
					"content": "之前我抓到了几个漏网的龙贩子，就用您说的办法，再把北边的走私犯也一窝端掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740107
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 756740107,
					"content": "到时候记得给我捷报哦，我超期待的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740108
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 756740108,
					"content": "嗨呀…现在我不再是执律庭的成员了，按照保密条例，蒂蕾娜也不能向我汇报她的工作情况。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740109
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 756740109,
					"content": "总感觉，自己还有一些本领没和有需要的人分享…要不要，干脆写一本回忆录？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740110
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 756740110,
					"content": "嗯，只对各国执法人员发售的回忆录！我这150年的工作经验应该能帮上忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740111
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 756740111,
					"content": "我支持！等你好好享受这次派对，玩得身心舒畅，创作起来肯定也必定更顺利…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740112
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 756740112,
					"content": "到时候请给我留一本签名版的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740113
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 756740113,
					"content": "第一个送你！这次跳舞跳个尽兴，我回去就租一台打字机，立刻开写！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740114
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 756740114,
					"content": "美露莘和…努斯妲？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756740115,
					"content": "又一对没想过的组合，在聊什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740116,
						756740117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756740116,
					"content": "听起来是很有趣的内容？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756740118
					]
				},
				{
					"id": 756740118,
					"content": "好呀，我们的「杜麦尼」登场了！领舞者就位，派对进入正题！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740119
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 756740119,
					"content": "当务之急是告诉你们特大好消息——我们第二次「舞力聚会」已经开始了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740120
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 756740120,
					"content": "还有全新的参与者：来自枫丹旅游团的昂吉安妮小姐，和她的三位伙伴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740121
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 756740121,
					"content": "另外，多亏「乌沙博蒂」卡齐娜和蒙德的偶像小姐，枫丹客人和这边的阿夏都学会了全新的舞步！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740122
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 756740122,
					"content": "等等等等，信息一下子接受得太多了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756740123,
					"content": "意思是，除了之前跳舞的大家和小龙，还有美露莘和…阿夏？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756740124,
					"content": "对哦！所以我们能在更新更欢快的音乐里，跳出更尽兴的舞蹈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740125
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 756740125,
					"content": "作为领舞的「杜麦尼」也能展现自己对所有节拍的适应力！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740126,
						756740127
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 756740126,
					"content": "热闹点确实更好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756740128
					]
				},
				{
					"id": 756740128,
					"content": "#等等，努斯妲叫你「杜麦尼」…{NICKNAME}就是「杜麦尼」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740129
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 756740129,
					"content": "教我跳舞的那位「回声之子」小勇士说，她的师父是纳塔最最厉害的「杜麦尼」，也很会跳舞…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740130
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 756740130,
					"content": "绕了半天，原来就是你啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740131,
						756740135
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 756740131,
					"content": "那现在我是你的师祖了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756740132
					]
				},
				{
					"id": 756740132,
					"content": "噗…那我也是昂吉安妮师祖那一辈的啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756740133,
					"content": "不行不行，怎么感觉地位降了两档…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740134
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 756740134,
					"content": "各论各的，各论各的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740139
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 756740139,
					"content": "话说回来，跳舞这种事情很看天分的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740140
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 756740140,
					"content": "说不定我就是小说主角级别的天才，练了两天就跳得和你差不多呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740141
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 756740141,
					"content": "当然，也没必要比个高下，我的意思是…最好摇的节奏，最时髦的舞步，我都能跟上！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740142
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 756740142,
					"content": "对的对的，跳舞这种事，开心就好！就算只能卡准节奏摇摆摇摆，也是好好参与！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740143
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756740143,
					"content": "看来，一切都准备就绪了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740144
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 756740144,
					"content": "如果「杜麦尼」想先和朋友们聊聊天，她们都在那边等着你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740145
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 756740145,
					"content": "这边也随时可以让大家聚集起来，奏响音乐，开启派对的正题！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 756740135,
					"content": "特巡队警官的情报不够广呀。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756740136
					]
				},
				{
					"id": 756740136,
					"content": "就是就是，看来你这个教官也有大意的时候嘛，怎么能不收集邻国的重要信息呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740137
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756740137,
					"content": "话不能这么说，我又没有在境外行动的需求。和我无关的事情，干嘛要去管？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740138
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 756740138,
					"content": "知道的事情越多，有时候越容易心乱，明白吗？这个叫做情报集中度的管理！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740139
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 756740127,
					"content": "人多的派对更欢乐。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756740128
					]
				},
				{
					"id": 756740117,
					"content": "听起来是很危险的内容？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756740118
					]
				}
			]
		}
	]
}