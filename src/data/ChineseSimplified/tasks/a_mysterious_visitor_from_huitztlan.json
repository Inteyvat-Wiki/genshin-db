				]
			},
			"dialogs": [
				{
					"id": 150000401,
					"content": "嗷呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000402
					],
					"speakerTitle": "波奇奇",
					"speakerSubtitle": "匿叶龙宝宝"
				},
				{
					"id": 150000402,
					"content": "龙宝宝在这里！咦？旁边有一个…阿乔？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150000403,
					"content": "这不是吾那仆从的两位劣友吗？是在山下窥见了吾的英姿，特地爬上来供奉的吧？看来日前一见，吾的伟岸已深嵌汝等心灵了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000404
					],
					"speakerTitle": "阿乔"
				},
				{
					"id": 150000404,
					"content": "真是拿下人没办法，来吧，亲吻吾的脚背，伟大圣龙库胡勒阿乔允许汝等献上朝拜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000405
					],
					"speakerTitle": "阿乔"
				},
				{
					"id": 150000405,
					"content": "你…你不是基尼奇的那个小跟班吗？在自说自话什么？居然比上次更讨厌了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150000406,
					"content": "胡言乱语！什么小跟班？吾乃无上之龙！烈焰之国的至高领主！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000407
					],
					"speakerTitle": "阿乔"
				},
				{
					"id": 150000407,
					"content": "上次要不是基尼奇三拜九叩，吾才不会恩施汝等丝毫言语的仁慈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000408
					],
					"speakerTitle": "阿乔"
				},
				{
					"id": 150000408,
					"content": "什么嘛，明明就是被基尼奇关起来了吧，你还挺会装模做样的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000409,
						150000411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150000409,
					"content": "领主大人，你在这山上干嘛？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150000410
					]
				},
				{
					"id": 150000410,
					"content": "哼哼，这还差不多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000413
					],
					"speakerTitle": "阿乔"
				},
				{
					"id": 150000413,
					"content": "近日吾应许了吾那仆从的祈求，为其调查维茨特兰附近的深渊事件。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000414
					],
					"speakerTitle": "阿乔"
				},
				{
					"id": 150000414,
					"content": "深渊事件？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150000415,
					"content": "看见这小爬虫了吗？它的母亲——一只中爬虫，被深渊力量侵蚀，错乱地攻击了吾那仆从的族人，甚至还攻击了自己的后裔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000416
					],
					"speakerTitle": "阿乔"
				},
				{
					"id": 150000416,
					"content": "天哪…那它现在怎么样了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000417
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150000417,
					"content": "低等的爬虫如何能与深渊久斗？自然是去了夜神之国。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000418
					],
					"speakerTitle": "阿乔"
				},
				{
					"id": 150000418,
					"content": "弱小的生灵啊…听说是自我了断，从高崖上一跃而下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000419
					],
					"speakerTitle": "阿乔"
				},
				{
					"id": 150000419,
					"content": "跳崖…？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000420
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150000420,
					"content": "白色小飞蚁，别再露出还有一百个问题的愚蠢表情，伟大的圣龙库胡勒阿乔可不是谁人的许愿灵泉啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000421
					],
					"speakerTitle": "阿乔"
				},
				{
					"id": 150000421,
					"content": "谁是白色小飞蚁？！你…我一定要给你想个难听的绰号！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000422
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150000422,
					"content": "哼，吾探查到附近有微弱的深渊气息，必有擅于隐藏的邪恶术士存在。要是遇见了可疑的外地人，汝等需细细盘问。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000423
					],
					"speakerTitle": "阿乔"
				},
				{
					"id": 150000423,
					"content": "可疑的外地人…你不是在指深渊骂我们吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000424
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150000424,
					"content": "呸！下人之心度领主之腹！汝等若非吾那仆从的劣友，吾早就打打打打打打！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000425
					],
					"speakerTitle": "阿乔"
				},
				{
					"id": 150000425,
					"content": "既然不是来朝拜，就速速退去！伟大的圣龙库胡勒阿乔要去办正事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿乔"
				},
				{
					"id": 150000411,
					"content": "小跟班，你在这山上干嘛？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150000412
					]
				},
				{
					"id": 150000412,
					"content": "是领主大人！你想气死伟大圣龙库胡勒阿乔吗？你的罪行将遭回火焚烧千年！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000413
					],
					"speakerTitle": "阿乔"
				}
			]
		},
		{
			"id": 1500005,
