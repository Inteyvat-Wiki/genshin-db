					},
					{
						"sceneId": 3,
						"position": [
							-2375.592,
							259.064,
							8479.979
						],
						"pointId": 9114
					},
					{
						"sceneId": 3,
						"position": [
							-2374.284,
							259.103,
							8478.566
						],
						"pointId": 9115
					},
					{
						"sceneId": 3,
						"position": [
							-2374.395,
							259.072,
							8482.007
						],
						"pointId": 9116
					}
				]
			},
			"dialogs": [
				{
					"id": 150000501,
					"content": "#哇！{M#哥哥姐姐}{F#两位姐姐}好厉害！这么快就回来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000502
					],
					"speakerTitle": "多巴"
				},
				{
					"id": 150000502,
					"content": "#龙宝宝没事真是太好了，这下我们可以放心地回家啦。谢谢{M#哥哥姐姐}{F#两位姐姐}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000503
					],
					"speakerTitle": "胡妮"
				},
				{
					"id": 150000503,
					"content": "不用客气啦，我们根本没费什么工夫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150000504,
					"content": "#你们爬了好高的山呢，肯定很辛苦，看{M#哥哥姐姐}{F#两位姐姐}的打扮，应该也不是本地人吧？来我家歇歇脚吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000505
					],
					"speakerTitle": "胡妮"
				},
				{
					"id": 150000505,
					"content": "没错，给个机会吧，让我们展现一下悬木人的热情好客！你们这么好心，跟之前那个眼镜仔完全不一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000506
					],
					"speakerTitle": "多巴"
				},
				{
					"id": 150000506,
					"content": "听你们说的，那家伙也是外地人吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150000507,
					"content": "他的衣服不是纳塔款式…现在想想，真是可疑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000508
					],
					"speakerTitle": "胡妮"
				},
				{
					"id": 150000508,
					"content": "可疑的外地人？该不会是阿乔说的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000509
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150000509,
					"content": "能详细说说那个人的情况吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150000510
					]
				},
				{
					"id": 150000510,
					"content": "#{M#哥哥姐姐}{F#两位姐姐}对那个叔叔感兴趣吗？那我想想，事情是这样的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000511
					],
					"speakerTitle": "胡妮"
				},
				{
					"id": 150000511,
					"content": "这位叔叔，我已经讲了好几个故事了…什么时候才能帮我去找龙宝宝啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000512
					],
					"speakerTitle": "胡妮"
				},
				{
					"id": 150000512,
					"content": "再讲一个吧，再讲讲那团火的故事吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000513
					],
					"speakerTitle": "渊上"
				},
				{
					"id": 150000513,
					"content": "叔叔听说，有一团巨大的透明的火，燃烧在过去五百年、一千年甚至更多不计其数的时间里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000514
					],
					"speakerTitle": "渊上"
				},
				{
					"id": 150000514,
					"content": "那个叫回火！古名「马{RUBY#[D]回火}力卜」就是从这个传说里诞生的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000515
					],
					"speakerTitle": "多巴"
				},
				{
					"id": 150000515,
					"content": "哇哦，是古名的起源吗？这么厉害？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000516
					],
					"speakerTitle": "渊上"
				},
				{
					"id": 150000516,
					"content": "嗯呢，所有的古名都有起源传说。在传说里，回火出现在纳塔大联盟的年代，被暴君奥奇坎拿来统治纳塔，镇压反对他的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000517
					],
					"speakerTitle": "胡妮"
				},
				{
					"id": 150000517,
					"content": "回火和普通火焰最不同的就是，被它点燃的人虽然会觉得背后灼痛难忍，但不会马上死掉，这时候千万不能回头检查！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000518
					],
					"speakerTitle": "胡妮"
				},
				{
					"id": 150000518,
					"content": "不可以回头？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000519
					],
					"speakerTitle": "渊上"
				},
				{
					"id": 150000519,
					"content": "一回头就完蛋了，立刻就会被烧成灰！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000520
					],
					"speakerTitle": "多巴"
				},
				{
					"id": 150000520,
					"content": "哇哦，烧衣服烧行头就算了，烧人可真是残暴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000521
					],
					"speakerTitle": "渊上"
				},
				{
					"id": 150000521,
					"content": "是吧，怎么可以烧人家后背还不许人家回头看呢？奥奇坎真是个暴君。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000522
					],
					"speakerTitle": "胡妮"
				},
				{
					"id": 150000522,
					"content": "按照传说的惯例，接着该有人挺身而出了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000523
					],
					"speakerTitle": "渊上"
				},
				{
					"id": 150000523,
					"content": "眼镜大叔，你还挺懂行的嘛。确实是这样，那个人就是我们悬木人的祖先，尤潘基大人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000524
					],
					"speakerTitle": "多巴"
				},
				{
					"id": 150000524,
					"content": "嗯，尤潘基大人和暴君奥奇坎还有最初的火神希巴拉克大人都是朋友，他是当时大联盟的军械官。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000525
					],
					"speakerTitle": "胡妮"
				},
				{
					"id": 150000525,
					"content": "他不认同奥奇坎的残酷统治，就为人们偷出了回火，并把它抛向了暴君的军队。没有人能抵挡，士兵们全被烧成了灰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000526
					],
					"speakerTitle": "胡妮"
				},
				{
					"id": 150000526,
					"content": "就这样，祖先解放了人们，但就在逃出城的时候，他好像听到奥奇坎的呼唤从背后传来，于是鬼使神差地回了头。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000527
					],
					"speakerTitle": "胡妮"
				},
				{
					"id": 150000527,
					"content": "但他却只看到了焦黑的城市、枯萎的士兵、冲天的火焰…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000528
					],
					"speakerTitle": "多巴"
				},
				{
					"id": 150000528,
					"content": "再下一刻，映在眼底的火舌突然从他瞳孔中钻出来，把祖先吞没了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000529
					],
					"speakerTitle": "胡妮"
				},
				{
					"id": 150000529,
					"content": "只回头看了一眼哦！就也被烧成了灰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000530
					],
					"speakerTitle": "多巴"
				},
				{
					"id": 150000530,
					"content": "这是窃火…还是回头的代价呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000531
					],
					"speakerTitle": "渊上"
				},
				{
					"id": 150000531,
					"content": "不知道，但尤潘基大人身上的火比别处的都要凶，烧了整整一百天，最后连地脉都被烧开了个大洞！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000532
					],
					"speakerTitle": "多巴"
				},
				{
					"id": 150000532,
					"content": "然后火光「噼咻」一下就掉进了黑黢黢的夜神之国，一直烧到现在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000533
					],
					"speakerTitle": "多巴"
				},
				{
					"id": 150000533,
					"content": "大人都说，它照亮了往生之路，但也要亡者接受它的灼烧，这样才能纯净地迎接来世。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000534
					],
					"speakerTitle": "胡妮"
				},
				{
					"id": 150000534,
					"content": "就像是对一生的回顾与审问…所以人们就叫它尤潘基的回火。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000535
					],
					"speakerTitle": "胡妮"
				},
				{
					"id": 150000535,
					"content": "噢…多么富有诗意的故事！所以在夜神之国真的可以见到这团火吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000536
					],
					"speakerTitle": "渊上"
				},
				{
					"id": 150000536,
					"content": "不知道欸…这只是个传说吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000537
					],
					"speakerTitle": "胡妮"
				},
				{
					"id": 150000537,
					"content": "所以后来你们有人继承了这个古名吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000538
					],
					"speakerTitle": "渊上"
				},
				{
					"id": 150000538,
					"content": "当然，比如「回火夜」祭祀的英雄布基纳，不过他是五百年前的人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000539
					],
					"speakerTitle": "多巴"
				},
				{
					"id": 150000539,
					"content": "嗯，现在这个古名属于基尼奇哥哥…「马{RUBY#[D]回火}力卜」的基尼奇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000540
					],
					"speakerTitle": "胡妮"
				},
				{
					"id": 150000540,
					"content": "基尼奇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000541
					],
					"speakerTitle": "渊上"
				},
				{
					"id": 150000541,
					"content": "好了，眼镜大叔，我们已经说了很多故事了，你该去找龙宝宝了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000542
					],
					"speakerTitle": "多巴"
				},
				{
					"id": 150000542,
					"content": "啊…但回火的传说不是教导我们不要回头看吗？所以，不要再提前面说过的部分了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000543
					],
					"speakerTitle": "渊上"
				},
				{
					"id": 150000543,
					"content": "请再讲一讲这个基尼奇吧，从现在开始的才算数。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000544
					],
					"speakerTitle": "渊上"
				},
				{
					"id": 150000544,
					"content": "咦？多巴，你怎么露出了那种想要骂人的眼神？不可以哦，那是大人的特权。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000545
					],
					"speakerTitle": "渊上"
				},
				{
					"id": 150000545,
					"content": "叔叔…要是你骗我们…死了之后会被回火烧得很惨的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000546
					],
					"speakerTitle": "胡妮"
				},
				{
					"id": 150000546,
					"content": "本地火怎么会烧外地人呢？叔叔可不是你们的老乡啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000547
					],
					"speakerTitle": "渊上"
				},
				{
					"id": 150000547,
					"content": "啊…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000548
					],
					"speakerTitle": "胡妮"
				},
				{
					"id": 150000548,
					"content": "等等…那是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000549
					],
					"speakerTitle": "渊上"
				},
				{
					"id": 150000549,
					"content": "#好了孩子们，叔叔不会白听故事的，叔叔派了两个朋友过来，嗯…{M#他们}{F#她们}会来付报酬的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000550
					],
					"speakerTitle": "渊上"
				},
				{
					"id": 150000550,
					"content": "#你们一定要狠狠使唤{M#他们}{F#她们}。千万别顾忌叔叔我的面子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000551
					],
					"speakerTitle": "渊上"
				},
				{
					"id": 150000551,
					"content": "真的吗？那眼镜大叔，你叫什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000552
					],
					"speakerTitle": "多巴"
				},
				{
					"id": 150000552,
					"content": "我们在这山崖下相遇，大叔自然叫「山下」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000553
					],
					"speakerTitle": "渊上"
				},
				{
					"id": 150000553,
					"content": "真的假的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000554
					],
					"speakerTitle": "胡妮"
				},
				{
					"id": 150000554,
					"content": "#不信回头看看，{M#他们}{F#她们}已经来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000555
					],
					"speakerTitle": "渊上"
				},
				{
					"id": 150000555,
					"content": "嗯？哪有啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000556
					],
					"speakerTitle": "胡妮"
				},
				{
					"id": 150000556,
					"content": "叔叔…你人呢？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000557
					],
					"speakerTitle": "胡妮"
				},
				{
					"id": 150000557,
					"content": "听下来这家伙真的有点可疑呢…他好像在打听关于古名的事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000558
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150000558,
					"content": "是吧！这个可恶的眼镜仔，他背叛了我们！他会付出代价的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000559
					],
					"speakerTitle": "多巴"
				},
				{
					"id": 150000559,
					"content": "但也只是听走了一些故事，应该不会怎么样吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000560
					],
					"speakerTitle": "胡妮"
				},
				{
					"id": 150000560,
					"content": "#唔…{NICKNAME}，我们是不是该让基尼奇知道一下？虽然那个臭屁阿乔已经在调查了，但总觉得它不怎么靠谱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000561
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150000561,
					"content": "欸？你们也认识基尼奇哥哥吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000562
					],
					"speakerTitle": "胡妮"
				},
				{
					"id": 150000562,
					"content": "其实也不算很熟，我们只是见过面，还一起吃过饭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000563
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150000563,
					"content": "好羡慕！我都没有和基尼奇哥哥说过话。他是族里的猎龙人，还有很厉害的古名，真是太酷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000564
					],
					"speakerTitle": "多巴"
				},
				{
					"id": 150000564,
					"content": "我也是！不过我爸爸不太喜欢他，还叫我跟他少接触…肯定是因为他身边那个自大又恶毒的伙伴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000565
					],
					"speakerTitle": "胡妮"
				},
				{
					"id": 150000565,
					"content": "啊！是那个自称库胡勒阿乔的坏东西！我们也领教过了，真是生怕别人不讨厌它的样子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000566
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150000566,
					"content": "就是！真不知道基尼奇哥哥怎么会选中那家伙当伙伴，怎么不选我呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000567
					],
					"speakerTitle": "胡妮"
				},
				{
					"id": 150000567,
					"content": "哎呀！不好，胡妮，我们出来太久，再不回家要挨骂了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000568
					],
					"speakerTitle": "多巴"
				},
				{
					"id": 150000568,
					"content": "#对哦，那…{M#哥哥姐姐}{F#两位姐姐}，沿着这条路往前走就能到我们族里，要是你们打算过去，要记得来我家做客哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000569
					],
					"speakerTitle": "胡妮"
				},
				{
					"id": 150000569,
					"content": "有什么需要的，我都会让爸爸帮你们的，一定要来哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000570
					],
					"speakerTitle": "胡妮"
				},
				{
					"id": 150000570,
					"content": "#{M#哥哥姐姐}{F#两位姐姐}再见，我们先走啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "多巴"
				}
			]
		},
