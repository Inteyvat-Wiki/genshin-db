					{
						"sceneId": 11,
						"position": [
							1539.275,
							-493.738,
							3566.402
						],
						"pointId": 84
					}
				]
			},
			"dialogs": [
				{
					"id": 741960701,
					"content": "什么？！怎么会…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960702
					],
					"speakerTitle": "波爱修斯"
				},
				{
					"id": 741960702,
					"content": "为什么我会无法控制这具身体…卡西奥多，是你吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960703
					],
					"speakerTitle": "波爱修斯"
				},
				{
					"id": 741960703,
					"content": "终于抓住你了，波爱修斯！你所有的意志，「福波斯」都在这里，这次你跑不掉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960704
					],
					"speakerTitle": "波爱修斯"
				},
				{
					"id": 741960704,
					"content": "为什么？！我是调律师，「乐章」的指挥者是我，你怎么可能…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960705
					],
					"speakerTitle": "波爱修斯"
				},
				{
					"id": 741960705,
					"content": "你忘了，在至尊将我从大乐章中分离之前，我也曾是调律师！现在我回到了「乐章」之中，你不再是唯一的演奏者了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960706
					],
					"speakerTitle": "波爱修斯"
				},
				{
					"id": 741960706,
					"content": "哈，原来你答应加入我的计划，只是为了使我放下戒备。最后，你再次背叛了我，背叛了雷穆利亚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960707
					],
					"speakerTitle": "波爱修斯"
				},
				{
					"id": 741960707,
					"content": "想想那些被囚禁在深水之下的可悲的同族，想想他们遭受的数千年的折磨…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960708
					],
					"speakerTitle": "波爱修斯"
				},
				{
					"id": 741960708,
					"content": "你却要为了那些低贱的地上之人，毁了我们的事业，浇灭我们唯一的希望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960709
					],
					"speakerTitle": "波爱修斯"
				},
				{
					"id": 741960709,
					"content": "背叛了雷穆利亚的是你，囚禁他们的也是你。正是你的背叛，才使我们的国家遭致灭亡的命运。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960710
					],
					"speakerTitle": "波爱修斯"
				},
				{
					"id": 741960710,
					"content": "至尊…王上所赐予我们的正义，那个金色的理想，乃是希望我们能够遵从内心的旋律，掌握命运的自由。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960711
					],
					"speakerTitle": "波爱修斯"
				},
				{
					"id": 741960711,
					"content": "我们不愿接受「法图纳」的审判，更不应成为你的奴仆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960712
					],
					"speakerTitle": "波爱修斯"
				},
				{
					"id": 741960712,
					"content": "「福波斯」破碎后，人们原本应当获得自由的机会。如果不是因为你当初的欺骗，他们的噩梦早就该结束了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960713
					],
					"speakerTitle": "波爱修斯"
				},
				{
					"id": 741960713,
					"content": "雷穆利亚没有灭亡！在「福波斯」的指引下，它还会再度崛起…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960714
					],
					"speakerTitle": "波爱修斯"
				},
				{
					"id": 741960714,
					"content": "「无论这顽石与金属的重击如何轰鸣，没有了水和土，人类就没办法生存。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960715
					],
					"speakerTitle": "波爱修斯"
				},
				{
					"id": 741960715,
					"content": "不管拥有多么强大的力量，但倘若因此便肆意践踏生命的价值，那这种力量也就毫无意义可言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960716
					],
					"speakerTitle": "波爱修斯"
				},
				{
					"id": 741960716,
					"content": "波爱修斯，你不也是人类吗？所有的雷穆利亚人曾经都是普通的枫丹人啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960717
					],
					"speakerTitle": "波爱修斯"
				},
				{
					"id": 741960717,
					"content": "即便我们抛弃了苦弱的肉身，拥有了不朽的躯体，但我们仍然有着凡人的灵魂，也有着凡人的感情与弱点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960718
					],
					"speakerTitle": "波爱修斯"
				},
				{
					"id": 741960718,
					"content": "而我们却忘记了这一点，忘记了自己的出身，自以为高踞于其他人之上，雷穆利亚就是因此才会灭亡的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960719
					],
					"speakerTitle": "波爱修斯"
				},
				{
					"id": 741960719,
					"content": "#{NICKNAME}，还记得我说过的话吗，就是现在了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "波爱修斯"
				}
			]
		},
