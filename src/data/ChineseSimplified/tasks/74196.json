			"dialogs": [
				{
					"id": 741960401,
					"content": "呼，终于进来了，真不容易啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741960402,
					"content": "说是黄金的宫殿，不过看起来倒不像是宫殿，更像是某个巨大机器的内部呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741960403,
					"content": "这个地方…很熟悉。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741960404
					]
				},
				{
					"id": 741960404,
					"content": "嗯，是你之前在雷穆斯的记忆里见到的地方吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741960405,
					"content": "所以那个没礼貌的坏蛋才想在这里…要是让他得逞的话可就糟糕了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741960406,
					"content": "而且也不知道呜斯先生现在怎么样了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741960407,
					"content": "无论如何，我们也只能继续前进了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
