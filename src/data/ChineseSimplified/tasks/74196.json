			"dialogs": [
				{
					"id": 741961501,
					"content": "呜喵？！喵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741961502
					],
					"speakerTitle": "小呜斯"
				},
				{
					"id": 741961502,
					"content": "哇！大家伙！你吓到小呜斯了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741961503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741961503,
					"content": "卡西奥多？不…熟悉的气息消失了，卡西奥多去哪儿了？难道是又回到哪具石头躯体当中了吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741961504,
						741961505
					],
					"speakerTitle": "斯库拉"
				},
				{
					"id": 741961504,
					"content": "卡西奥多他…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741961506
					]
				},
				{
					"id": 741961506,
					"content": "卡西奥多…呜斯先生他，已经和波爱修斯，和「福波斯」一起消失了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741961507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741961507,
					"content": "向斯库拉说明了事情的原委后，花了一段时间安抚小呜斯…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741961508
					]
				},
				{
					"id": 741961508,
					"content": "就是这样，现在只有「小呜斯」…它还和我们一起…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741961509
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741961509,
					"content": "喵喵？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741961510
					],
					"speakerTitle": "小呜斯"
				},
				{
					"id": 741961510,
					"content": "太好了，看来刚才只是被突然出现的大家伙吓了一跳，小呜斯说不定原本就是很胆大的猫咪呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741961511
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741961511,
					"content": "不管怎么说，你们打败了那个妖鬼，而卡西奥多…至少他实现了自己的愿望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741961512
					],
					"speakerTitle": "斯库拉"
				},
				{
					"id": 741961512,
					"content": "想必他的灵魂，也已经回到了深水之中，和他的同胞们在一起了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741961513
					],
					"speakerTitle": "斯库拉"
				},
				{
					"id": 741961513,
					"content": "只要我们完成雷穆斯留下的最后的乐章，便能将他们的灵魂带去现世，带回高海之上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741961514
					],
					"speakerTitle": "斯库拉"
				},
				{
					"id": 741961514,
					"content": "生命如水流般循环不息，他们也会化为激流，并且迟早有一天，再度作为凡人诞生吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741961515
					],
					"speakerTitle": "斯库拉"
				},
				{
					"id": 741961515,
					"content": "那么，我们开始吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741961516
					],
					"speakerTitle": "斯库拉"
				},
				{
					"id": 741961516,
					"content": "奏响这最后的乐章，最后的「安魂曲」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "斯库拉"
				},
				{
					"id": 741961505,
					"content": "他已经不在这里了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741961506
					]
				}
			]
		},
