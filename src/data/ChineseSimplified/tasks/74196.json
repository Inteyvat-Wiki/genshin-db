			"dialogs": [
				{
					"id": 741960501,
					"content": "真是纠缠不休的杂碎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960502
					],
					"speakerTitle": "波爱修斯"
				},
				{
					"id": 741960502,
					"content": "修好破碎的水道，是想以此庆贺我作为旧日之神的诞生吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960503
					],
					"speakerTitle": "波爱修斯"
				},
				{
					"id": 741960503,
					"content": "不过在我的新世界，是不需要水道，也不需要航船的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960504
					],
					"speakerTitle": "波爱修斯"
				},
				{
					"id": 741960504,
					"content": "因为所有人都会在我的「乐章」中得到永恒的幸福。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960505
					],
					"speakerTitle": "波爱修斯"
				},
				{
					"id": 741960505,
					"content": "我们是来为你的乐章画上休止符的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741960506
					]
				},
				{
					"id": 741960506,
					"content": "没错，你最好老实认输，释放镇上大家的灵魂…还有，快把呜斯先生交出来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741960507,
					"content": "哼，卡西奥多他已经同意参与这伟大的仪式，重归雷穆利亚的怀抱了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960508
					],
					"speakerTitle": "波爱修斯"
				},
				{
					"id": 741960508,
					"content": "属于雷穆利亚的全部意志都将融为一体，所谓友谊难道不是你们的自以为是吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960509
					],
					"speakerTitle": "波爱修斯"
				},
				{
					"id": 741960509,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960510
					],
					"speakerTitle": "小呜斯"
				},
				{
