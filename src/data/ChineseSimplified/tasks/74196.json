			"dialogs": [
				{
					"id": 741962091,
					"content": "一切结束之后，你们回到了最初的起点，佩特莉可镇…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741962001
					]
				},
				{
					"id": 741962001,
					"content": "是雷穆斯留给我们的乐章，终于结束了吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741962002
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741962002,
					"content": "我们完成了「安魂曲」，被禁锢在海底的灵魂看起来也全都离开了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741962003
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741962003,
					"content": "镇上的大家应该也已经恢复正常了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741962004
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741962004,
					"content": "谢谢你们，完成了这最后的乐章，这延续数千年的愿望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741962005
					],
					"speakerTitle": "斯库拉"
				},
				{
					"id": 741962005,
					"content": "不论是老夫的，还是雷穆斯的，又或是所有守护现世安定之人的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741962006
					],
					"speakerTitle": "斯库拉"
				},
				{
					"id": 741962006,
					"content": "说到这个就想起来呜斯先生…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741962007
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741962007,
					"content": "喵呜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741962008
					],
					"speakerTitle": "小呜斯"
				},
				{
					"id": 741962008,
					"content": "你也很喜欢这个名字吗？不过现在不是在说你哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741962009
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741962009,
					"content": "他的灵魂已经回归高海…终于得享宁静了，对他来说这也是一种解脱吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741962010
					],
					"speakerTitle": "斯库拉"
				},
				{
					"id": 741962010,
					"content": "而老夫的族裔们，看起来也已经有了新的、真正的龙诞生了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741962011
					],
					"speakerTitle": "斯库拉"
				},
				{
					"id": 741962011,
					"content": "虽然作为曾经水龙蜥的亲王，老夫也应该前去觐见…不过现在的老夫，究竟还能不能算作龙裔也很难说了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741962012
					],
					"speakerTitle": "斯库拉"
				},
				{
					"id": 741962012,
					"content": "时间已经过去太久了，久到这个世界也已经与老夫无关了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741962013
					],
					"speakerTitle": "斯库拉"
				},
				{
					"id": 741962013,
					"content": "那么接下来大家伙要怎么办呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741962014
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741962014,
					"content": "这个嘛，好不容易重获自由，老夫可得在水里好好畅游一番呢！",
