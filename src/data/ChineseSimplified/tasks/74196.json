			"dialogs": [
				{
					"id": 741960901,
					"content": "呜啊，感觉晕乎乎的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960902
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741960902,
					"content": "卡西奥多…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741960903
					]
				},
				{
					"id": 741960903,
					"content": "#{NICKNAME}，还有派蒙，没想到我们还能像这个样子见面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960904
					],
					"speakerTitle": "卡西奥多"
				},
				{
					"id": 741960904,
					"content": "你是…是呜斯先生！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960905
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741960905,
					"content": "哇，还有波爱修斯也在…这家伙该不会又想耍什么花招吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960906
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741960906,
					"content": "等等，不对！是我眼花了吗，飘在那里的是什么东西啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960907
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741960907,
					"content": "你们也看到了吗？隐藏在「波爱修斯」的幻象之后的家伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960908
					],
					"speakerTitle": "卡西奥多"
				},
				{
					"id": 741960908,
					"content": "哎呀，你发现我了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960909
					],
					"speakerTitle": "「福波斯」"
				},
				{
					"id": 741960909,
					"content": "可那并不是幻象，你们所见到的确实就是「波爱修斯」，因为，我就是「波爱修斯」啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960910
					],
					"speakerTitle": "「福波斯」"
				},
				{
					"id": 741960910,
					"content": "当然，我并不只是「波爱修斯」，我也是「你」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960911
					],
					"speakerTitle": "「福波斯」"
				},
				{
					"id": 741960911,
					"content": "我是一切旋律，一切乐章，一切思绪…我是一切灵魂的总和！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960912
					],
					"speakerTitle": "「福波斯」"
				},
				{
					"id": 741960912,
					"content": "我就是「福波斯」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960913
					],
					"speakerTitle": "「福波斯」"
				},
				{
					"id": 741960913,
					"content": "不过不包括你们这些外面来的孩子呢，你们可不属于「我们」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960914
					],
					"speakerTitle": "「福波斯」"
				},
				{
					"id": 741960914,
					"content": "「福波斯」…统辖一切的大乐章，竟然拥有人格？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960915
					],
					"speakerTitle": "卡西奥多"
				},
				{
					"id": 741960915,
					"content": "「福波斯」，或者说原来的那个「西比尔」，原本是上一次洪水吞没大地后的幸存者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960916
					],
					"speakerTitle": "「福波斯」"
				},
				{
					"id": 741960916,
					"content": "「西比尔」的愿望是为世界上所有被称为人类的存在送去幸福，但她没有人格，也没有足够的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960917
					],
					"speakerTitle": "「福波斯」"
				},
				{
					"id": 741960917,
					"content": "为此，她将自己的智慧交给了雷穆斯，加上雷穆斯所拥有的力量，便创造出了「乐{RUBY#[D]福波斯}章」，也就是我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960918
					],
					"speakerTitle": "「福波斯」"
				},
				{
					"id": 741960918,
					"content": "怎么会…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960919
					],
					"speakerTitle": "卡西奥多"
				},
				{
					"id": 741960919,
					"content": "我们一直以来所演奏的乐章，所接受的命运，都是来自于你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960920
					],
					"speakerTitle": "卡西奥多"
				},
				{
					"id": 741960920,
					"content": "是「我」，但也是「你们」呀！因为「我」就是「你们」，是你们所有人的愿望的集合啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960921
					],
					"speakerTitle": "「福波斯」"
				},
				{
					"id": 741960921,
					"content": "排除异己，肆意地消灭其他生命，毁灭城镇与乡村，这些难道也是我们的愿望吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960922
					],
					"speakerTitle": "卡西奥多"
				},
				{
					"id": 741960922,
					"content": "是呀！因为「你们」这样希望，「我」才会如此回应。掠夺、仇恨、杀戮…这些也是「你们」愿望的一部分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960923
					],
					"speakerTitle": "「福波斯」"
				},
				{
					"id": 741960923,
					"content": "要为「所有人」送去幸福，难道不应该实现这些愿望吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960924
					],
					"speakerTitle": "「福波斯」"
				},
				{
					"id": 741960924,
					"content": "不可理喻…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741960925
					]
				},
				{
					"id": 741960925,
					"content": "这根本就是强词夺理吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960926
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741960926,
					"content": "…不，那并不是我们真正的愿望！我们之中滋生的傲慢与仇恨扭曲了你，把你变成了可怕的怪物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960927
					],
					"speakerTitle": "卡西奥多"
				},
				{
					"id": 741960927,
					"content": "没有人会因此获得幸福，不管是我们，还是我们之外的其他生灵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960928
					],
					"speakerTitle": "卡西奥多"
				},
				{
					"id": 741960928,
					"content": "怪不得你会把我们引向毁灭的结局。就是因为察觉到了这一点，王上才会…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960929
					],
					"speakerTitle": "卡西奥多"
				},
				{
					"id": 741960929,
					"content": "雷穆斯…他的确曾试图消灭我。可是为什么呢？如果没有了我，「你们」一定会再度陷入迷茫与痛苦之中…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960930
					],
					"speakerTitle": "「福波斯」"
				},
				{
					"id": 741960930,
					"content": "啊啊…为了大家的幸福，我只好将他…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960931
					],
					"speakerTitle": "「福波斯」"
				},
				{
					"id": 741960931,
					"content": "什么？！难道说那个时候，波爱修斯就已经…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960932
					],
					"speakerTitle": "卡西奥多"
				},
				{
					"id": 741960932,
					"content": "没错，一定是这样…我们是不可能违抗至尊的命令的，除非背叛他的是「乐章」本身…波爱修斯怎么了，你到底对他做了什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960933
					],
					"speakerTitle": "卡西奥多"
				},
				{
					"id": 741960933,
					"content": "唔，他当然已经变成「我们」了啊，用你们能理解的说法：他被我吃掉了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960934
					],
					"speakerTitle": "「福波斯」"
				},
				{
					"id": 741960934,
					"content": "吃掉…好可怕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960935
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741960935,
					"content": "嗯？但是这也是他的愿望哦，而只有我才能实现他的愿望…他一定也因此获得幸福了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960936
					],
					"speakerTitle": "「福波斯」"
				},
				{
					"id": 741960936,
					"content": "所以从那之后，波爱修斯就变成你的傀儡了…所以他才会想尽办法，要让你重新降临于世。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960937
					],
					"speakerTitle": "卡西奥多"
				},
				{
					"id": 741960937,
					"content": "这都是为了「你们」的…为了「所有人」的幸福啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960938
					],
					"speakerTitle": "「福波斯」"
				},
				{
					"id": 741960938,
					"content": "哈哈…不！不！是时候该结束这一切了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960939
					],
					"speakerTitle": "卡西奥多"
				},
				{
					"id": 741960939,
					"content": "你已经被我困在了这副躯体里无法逃脱，而我会将你彻底消灭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960940
					],
					"speakerTitle": "卡西奥多"
				},
				{
					"id": 741960940,
					"content": "「你」的愿望是和「我」一同消失吗？这就是「你」的幸福吗？但是…我不能实现你的愿望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960941
					],
					"speakerTitle": "「福波斯」"
				},
				{
					"id": 741960941,
					"content": "我既已不是雷穆利亚人，也做不了枫丹人。早在我答应要帮至尊实现他的愿望之时，便已经选择了自己的命运。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960942
					],
					"speakerTitle": "卡西奥多"
				},
				{
					"id": 741960942,
					"content": "所以，这就是我的愿望了，我之所以在世上徘徊了数千年，就是为了这一刻…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960943
					],
					"speakerTitle": "卡西奥多"
				},
				{
					"id": 741960943,
					"content": "为了终结这千年的噩梦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960944
					],
					"speakerTitle": "卡西奥多"
				},
				{
					"id": 741960944,
					"content": "#{NICKNAME}，就是现在，把我和「福波斯」一同消灭掉吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960945
					],
					"speakerTitle": "卡西奥多"
				},
				{
					"id": 741960945,
					"content": "但是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741960946
					]
				},
				{
					"id": 741960946,
					"content": "#{NICKNAME}，我很开心啊！至尊曾经的计划与愿望，就在刚才我也已经知道了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960947
					],
					"speakerTitle": "卡西奥多"
				},
				{
					"id": 741960947,
					"content": "王上想要通过自己的牺牲，将所有人从乐章中，也从仇恨与隔阂中解放出来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960948
					],
					"speakerTitle": "卡西奥多"
				},
				{
					"id": 741960948,
					"content": "他直到最后一刻都想要拯救他的臣民…如今我将完成他未竟的心愿。这是我们最后的机会了，而这只有你才能做到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741960949
					],
					"speakerTitle": "卡西奥多"
				},
				{
					"id": 741960949,
					"content": "也就是因此，我的朋友，王上…命运才会让你来到这里的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡西奥多"
				}
			]
		},
