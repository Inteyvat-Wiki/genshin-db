			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"安",
					"卡特皮拉",
					"西摩尔",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741220301,
					"content": "这里依旧什么都没有欸…$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741220302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741220302,
					"content": "所以卡特皮拉你能告诉我们，我们究竟要找什么吗？$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741220303
					],
					"speakerTitle": "安"
				},
				{
					"id": 741220303,
					"content": "我们是在寻找锻铸水仙十字圣剑的材料。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741220304
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741220304,
					"content": "水仙十字结社依据地下之国与古枫丹的神秘哲学，在物质世界重现了必要的四种架空物质。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741220305
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741220305,
					"content": "无法理解。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741220306
					],
					"speakerTitle": "西摩尔"
				},
				{
					"id": 741220306,
					"content": "神秘的东西本身只作用于体验，可以说比元素力还要跳脱常理呢。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741220307
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741220307,
					"content": "几十年前我录入过教令院的素论派入门至中级教材，元素力也没有那么神奇。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741220308
					],
					"speakerTitle": "西摩尔"
				},
				{
					"id": 741220308,
					"content": "是吗。那反正结论上来说，这是枫丹古法与地下古国技术的交汇。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741220309
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741220309,
					"content": "世界上出现了「记忆」、「愿望」、「灵魂」与「人格」这四种物质。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741220310
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741220310,
					"content": "为了防止歧义，我们把它们叫做「记忆」之块、「愿望」之块、「灵魂」之块与「人格」之块好了。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741220311
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741220311,
					"content": "为什么这些东西会用来打造圣剑啊？$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741220312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741220312,
					"content": "水仙十字的神秘哲学里，神殿是宇宙的缩影，社员是众神的代行，圣油是锤炼的意志。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741220313
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741220313,
					"content": "圣剑，则是破开一切的「理性」。它需由完整的人之意志诞生而出。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741220314
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741220314,
					"content": "好玄乎。$UNRELEASED",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741220315
					]
				},
				{
					"id": 741220315,
					"content": "哎呀，神秘哲学是这样的。看着相似就可以攀附。当这种东西变成魔法了就假成真的了。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741220316
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741220316,
					"content": "总之我们赶紧去最后一处地方吧。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡特皮拉"
				}
			]
		},
