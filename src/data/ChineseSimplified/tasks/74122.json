			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"卡特皮拉",
					"西摩尔",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741220201,
					"content": "这里的东西…被人拿走了吗？$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741220202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741220202,
					"content": "看起来是这样。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741220203
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741220203,
					"content": "究竟是谁会…$UNRELEASED",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741220204
					]
				},
				{
					"id": 741220204,
					"content": "是雅各布。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741220205
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741220205,
					"content": "我们之前在厄里那斯曾经与其发生冲突。补充订正，是最近一段时间的厄里那斯。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741220206
					],
					"speakerTitle": "西摩尔"
				},
				{
					"id": 741220206,
					"content": "看到大门口那个悲剧的受害者我就知道是他的手笔了。他果然还在活动啊。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741220207
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741220207,
					"content": "那他拿走这里的东西是想要干什么呢？$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741220208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741220208,
					"content": "很简单啊。他也想要重铸水仙十字的圣剑。因为水仙十字的事业还未竟呢。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741220209
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741220209,
					"content": "我们还是赶紧去下一处吧。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡特皮拉"
				}
			]
		},
		{
			"id": 7412203,
			"completionStepIds": [
				7412206
			],
