				"points": []
			},
			"dialogs": [
				{
					"id": 741220101,
					"content": "结果最后这里什么都没有吗？$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741220102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741220102,
					"content": "并不是，看起来是已经被人拿走了。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741220103
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741220103,
					"content": "那岂不是我们的计划已经失败了？$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741220104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741220104,
					"content": "「理性」的诞生需要四个象限合一。只要我们能拿到剩下的几个，我们就还有机会。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741220105
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741220105,
					"content": "既然如此，我们就快点去接下来的地方吧。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安"
				}
			]
		},
		{
			"id": 7412202,
			"completionStepIds": [
				7412204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
