				"points": []
			},
			"dialogs": [
				{
					"id": 701440101,
					"content": "关于那股寒流…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701440102
					]
				},
				{
					"id": 701440102,
					"content": "怎么样，调查出什么结果了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440103
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701440103,
					"content": "有这些发现。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701440104
					]
				},
				{
					"id": 701440104,
					"content": "这种东西是什么时候出现在雪山里的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440105
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701440105,
					"content": "谢谢你帮忙调查，我会向协会报告这件事的，这些报酬给你，辛苦了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玉霞"
				}
			]
		},
		{
			"id": 7014402,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"99902",
							"3"
						],
						"stepId": 99902,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"玉霞"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701440201,
					"content": "有什么委托吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701440202
					]
				},
				{
					"id": 701440202,
					"content": "委托？唔，你来得正好，我正好想要找一位经验丰富的冒险家，帮我去调查一股奇怪的寒流。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440203
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701440203,
					"content": "寒流？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701440204
					]
				},
				{
					"id": 701440204,
					"content": "是这样的。之前有一支小队进山考察，有几位经验丰富的冒险家同行。走的路线也是最安全的，绕开了一切危险的区域。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440205
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701440205,
					"content": "但是，不知道发生了什么，他们在考察的途中突然遭到了一阵猛烈的寒流，被迫撤回了营地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440206
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701440206,
					"content": "据回来的冒险家说，他们走的那条路根本不可能出现那种强度的寒流，而且，那股寒流来得毫无征兆，感觉根本不像什么自然现象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440207
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701440207,
					"content": "之后，又有好几个在山里考察或者勘探的人报告了这种情况，在组织了几次调查行动后，我们总算确定了那股寒流的来源。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440208
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701440208,
					"content": "但是，在那么多次调查后，调查队里的冒险家们要么冻伤，要么脱力，必须在营地里休息，我们暂时也抽调不出能继续深入调查的人手…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440209
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701440209,
					"content": "旅行者，如果你愿意帮忙的话，可以代我们去那股严寒的源头看一看吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440210,
						701440212
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701440210,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701440211
					]
				},
				{
					"id": 701440211,
					"content": "那就拜托你了，那股严寒十分诡异，请一定要做好准备。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440215
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701440215,
					"content": "那么，就请你快去那里调查一下吧，拜托你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701440212,
					"content": "关于报酬…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701440213
					]
				},
				{
					"id": 701440213,
					"content": "喔？你倒是很直接嘛。放心吧，协会可不会亏待冒险家，我会准备好报酬，在营地等着你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440214
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701440214,
					"content": "至于具体的数目…那就要视你带回来的调查结果而定了，规矩你懂的，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440215
					],
					"speakerTitle": "玉霞"
				}
			]
		},
