				]
			},
			"dialogs": [
				{
					"id": 750761201,
					"content": "啊，终于…异邦的勇士啊，若不是你相助，恐怕此处早已被漆黑的大敌占据…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750761202
					],
					"speakerTitle": "虚弱的大灵显化身"
				},
				{
					"id": 750761202,
					"content": "…许久之前，此处的部族住民受到漆黑大敌显化的造型的蛊惑，诸多夜魂亦被深渊纠缠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750761203
					],
					"speakerTitle": "虚弱的大灵显化身"
				},
				{
					"id": 750761203,
					"content": "受封之处，即便是夜之化身的力量也被一点点蚕食…此处的封印隔绝了外界，也隔绝了部族之人信念的来源。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750761204
					],
					"speakerTitle": "虚弱的大灵显化身"
				},
				{
					"id": 750761204,
					"content": "唯有揭开封印，才有一战之力…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750761205
					],
					"speakerTitle": "虚弱的大灵显化身"
				},
				{
					"id": 750761205,
					"content": "多谢你啊，异邦的勇士…夜魂得以回归迷梦的故土，避免污秽的瘤瘿占据夜神的国度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750761206
					],
					"speakerTitle": "虚弱的大灵显化身"
				},
				{
					"id": 750761206,
					"content": "啊，终于，可以回归夜的静谧之处了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "虚弱的大灵显化身"
				}
			]
		}
	]
}