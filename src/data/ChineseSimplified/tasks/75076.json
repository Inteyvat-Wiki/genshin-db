			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"萨卡乌"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750760401,
					"content": "海上的迷雾最近越发深重了，啊…真是让人忧心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760404
					],
					"speakerTitle": "萨卡乌"
				},
				{
					"id": 750760404,
					"content": "难道那个传说是真的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760405
					],
					"speakerTitle": "萨卡乌"
				},
				{
					"id": 750760405,
					"content": "什么传说？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750760406
					]
				},
				{
					"id": 750760406,
					"content": "呃…啊，这就要看异邦的勇士你要听什么样的传说了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760407
					],
					"speakerTitle": "萨卡乌"
				},
				{
					"id": 750760407,
					"content": "关于海面上浮岛与巨大涂鸦的故事，有两个来由，一个更像故事，一个更像真实的传说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760402
					],
					"speakerTitle": "萨卡乌"
				},
				{
					"id": 750760402,
					"content": "异邦的勇士，你想要听哪一个呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760408,
						750760411
					],
					"speakerTitle": "萨卡乌"
				},
				{
					"id": 750760408,
					"content": "关于故事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750760409
					]
				},
				{
					"id": 750760409,
					"content": "嗯，更像故事的那边总是比较浪漫啦…迷雾浮岛中涂鸦的来源，是一部名为《奎伊露和乌库库的故事》中的一部分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760403
					],
					"speakerTitle": "萨卡乌"
				},
				{
					"id": 750760403,
					"content": "据说名叫奎伊露的少女为了与她的太阳父亲联系，而在那海滨之处留下了巨大的涂鸦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760410
					],
					"speakerTitle": "萨卡乌"
				},
				{
					"id": 750760410,
					"content": "她的太阳父亲在天上看到涂鸦，于是将她从地上接走…大致就是这样的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760417
					],
					"speakerTitle": "萨卡乌"
				},
				{
					"id": 750760417,
					"content": "那看上去令人不安的迷雾，据说是太阳父亲给予地上部族民的惩罚，因为部族民夺去了他女儿的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760415
					],
					"speakerTitle": "萨卡乌"
				},
				{
					"id": 750760415,
					"content": "唉，不管是传说还是故事，迷雾自海上升起，都不是什么吉兆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760416
					],
					"speakerTitle": "萨卡乌"
				},
				{
					"id": 750760416,
					"content": "异邦的勇士啊…那里现在说不定很危险，一定要小心，最好不要靠近啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "萨卡乌"
				},
				{
					"id": 750760411,
					"content": "关于真实的传说…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750760412
					]
				},
				{
					"id": 750760412,
					"content": "关于真实的传说嘛…据说很久以前，有很邪恶的巫师扮作大灵的样子，蛊惑了部族的勇士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760413
					],
					"speakerTitle": "萨卡乌"
				},
				{
					"id": 750760413,
					"content": "后来，部族的勇士们不得不用巨大的涂鸦，将那个黑漆漆的邪恶巫师关在了涂鸦的封印之下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760414
					],
					"speakerTitle": "萨卡乌"
				},
				{
					"id": 750760414,
					"content": "海面之所以会变成这个样子，据说是因为邪恶的巫师会突破封印，从封印中跑出来为非作歹的预兆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760415
					],
					"speakerTitle": "萨卡乌"
				}
			]
		},
