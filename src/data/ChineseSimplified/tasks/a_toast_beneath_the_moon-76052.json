						],
						"pointId": 360300006
					}
				]
			},
			"dialogs": [
				{
					"id": 760520101,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520102
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520102,
					"content": "哥伦比娅，你还好吗？看上去有点没精打采呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760520103,
					"content": "是你们啊。我没事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520104
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520104,
					"content": "（是又在思考关于「月亮」的问题了吗…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520105
					]
				},
				{
					"id": 760520105,
					"content": "有什么能为你做的吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520106
					]
				},
				{
					"id": 760520106,
					"content": "我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520107
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520107,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520108
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520108,
					"content": "没关系，就算只是些小烦恼，说出来也会好些哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760520109,
					"content": "我有点…想喝酒馆里的饮品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520110
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520110,
					"content": "欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760520111,
					"content": "…唔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520112
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520112,
					"content": "抱歉！刚才我有点惊讶。因为你很少会提你自己想要什么东西嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760520113,
					"content": "而且，居然只是…饮品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760520114,
					"content": "是觉得太简单了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520115
					]
				},
				{
					"id": 760520115,
					"content": "可能我以为至少也得是「为我摘下月亮吧」这种级别的愿望…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760520116,
					"content": "啊，不过我似乎可以理解。现在哥伦比娅无法随心所欲地行动，去酒馆说不定和摘月亮差不多难呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760520117,
					"content": "不只是现在。以前在「愚人众」的时候没人要抓我，但出门散步的时候，大家还是躲得远远的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520118
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520118,
					"content": "（执行官第三席…这个名号的确会让不了解她的人害怕吧…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520119
					]
				},
				{
					"id": 760520119,
					"content": "咦？不过…我突然觉得这愿望也不是那么难！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760520120,
					"content": "#只要求酒馆水平的饮品的话，{NICKNAME}，你不是就会做嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760520121,
					"content": "…真的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520122
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520122,
					"content": "看你那么期待的样子，我反倒要紧张起来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760520123,
					"content": "口味上有要求吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520124
					]
				},
				{
					"id": 760520124,
					"content": "口味…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520125
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520125,
					"content": "我没怎么尝试过外面的饮品，反而给不出具体的方向…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520126
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520126,
					"content": "不要太厚重的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520127
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520127,
					"content": "厚重是什么意思？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760520128,
					"content": "像「愚人众」的大衣一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520129
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520129,
					"content": "怎么越比喻还越模糊了啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520130,
						760520131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760520130,
					"content": "大概是想要清香淡雅的饮品…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520132
					]
				},
				{
					"id": 760520132,
					"content": "好啊。交给你定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520131,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520132
					]
				}
			]
		},
		{
			"id": 7605202,
