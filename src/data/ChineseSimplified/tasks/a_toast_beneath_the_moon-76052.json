			"dialogs": [
				{
					"id": 760520401,
					"content": "我闻过这个气味。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520402
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520402,
					"content": "噢？在哪里？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760520403,
					"content": "桑多涅的房间。她看我好像对散发这种香味的饮品很感兴趣，故意拿在手上好半天都没喝完。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520404
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520404,
					"content": "就像…在等我提问一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520405
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520405,
					"content": "那你问了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520406
					]
				},
				{
					"id": 760520406,
					"content": "嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520407
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520407,
					"content": "问的什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760520408,
					"content": "「你不应该喝机油吗？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520409
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520409,
					"content": "她…怎么说？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520410
					]
				},
				{
					"id": 760520410,
					"content": "嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520411
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520411,
					"content": "很难听的话。不要学。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520412
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520412,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520413
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520413,
					"content": "才喝一口就不感兴趣了呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760520414,
					"content": "对不起，有点苦，不好喝。难怪桑多涅脸色那么难看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520415
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520415,
					"content": "我觉得那个是因为别的原因…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
