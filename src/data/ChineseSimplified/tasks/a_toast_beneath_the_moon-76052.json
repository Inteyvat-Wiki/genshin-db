			"dialogs": [
				{
					"id": 760520501,
					"content": "咕嘟…咕嘟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520502
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520502,
					"content": "一口气全喝完了！太好了，她看起来是很喜欢的样子呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760520503,
					"content": "没什么味道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520504
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520504,
					"content": "没…没什么味道？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760520505,
					"content": "嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520506,
						760520507
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520506,
					"content": "是不是喝太快了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520508
					]
				},
				{
					"id": 760520508,
					"content": "噢，不用了，谢谢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520509
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520509,
					"content": "曾经，我无法理解人们所说的那种丰收的喜悦，直到有天，我亲手触碰了枝头成熟的果实…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520510
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520510,
					"content": "我能从果皮的纹理中感受到它的生命力，它将来自阳光、水土和空气的养分转化成了这种形式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520511
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520511,
					"content": "伴随着咀嚼时的脆响，鲜甜的滋味像沁凉白浪一般层层翻涌而来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520512
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520512,
					"content": "于是我明白了，香气是一种谁也逃不开的引力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520513
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520513,
					"content": "哦！不错的感想呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520514
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760520514,
					"content": "我们以夺走这种生命力的方式完成了自然的转化。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520515
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520515,
					"content": "突然就变得残酷了起来？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520516
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760520516,
					"content": "所以我更喜欢新鲜的水果，它让我知道我从这个世界原原本本地取走了什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520517
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520517,
					"content": "这也是我应当回报这个世界的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520507,
					"content": "要不我再调一杯？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520508
					]
				}
			]
		},
