			},
			"dialogs": [
				{
					"id": 250340501,
					"content": "#{M#大哥哥}{F#大姐姐}，谢谢你救了我们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340502
					],
					"speakerTitle": "特拉忒"
				},
				{
					"id": 250340502,
					"content": "呜，呜呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340503
					],
					"speakerTitle": "奇卡"
				},
				{
					"id": 250340503,
					"content": "这里离部族太远，我都没办法通知伊莱帕姐姐。要是你没来，奇卡肯定会被抓走的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340504
					],
					"speakerTitle": "特拉忒"
				},
				{
					"id": 250340504,
					"content": "你来这里做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340505
					]
				},
				{
					"id": 250340505,
					"content": "我们还是来这里训练爬山。但训练到一半的时候，我们肚子都饿了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340506
					],
					"speakerTitle": "特拉忒"
				},
				{
					"id": 250340506,
					"content": "所以，我就和奇卡去摘果子。没想到一边摘果子，一边走了太远…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340507
					],
					"speakerTitle": "特拉忒"
				},
				{
					"id": 250340507,
					"content": "等到我们吃饱的时候，已经走了好远。回去肯定又要被妈妈念叨了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340508
					],
					"speakerTitle": "特拉忒"
				},
				{
					"id": 250340508,
					"content": "#再次谢谢你救了我，{M#大哥哥}{F#大姐姐}，这些「苦种」给你，都是我刚摘下来的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340509
					],
					"speakerTitle": "特拉忒"
				},
				{
					"id": 250340509,
					"content": "我们快点回去吧，奇卡，走吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340510
					],
					"speakerTitle": "特拉忒"
				},
				{
					"id": 250340510,
					"content": "呜！呜呜！呜呜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奇卡"
				}
			]
		}
	]
