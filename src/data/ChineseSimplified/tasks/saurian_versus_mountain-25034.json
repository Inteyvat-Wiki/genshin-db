			"dialogs": [
				{
					"id": 250340101,
					"content": "它不喜欢你们，走开！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340102
					],
					"speakerTitle": "特拉忒"
				},
				{
					"id": 250340102,
					"content": "臭小子…你认识这只龙吗？它和你什么关系？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340103
					],
					"speakerTitle": "不耐烦的贼匪"
				},
				{
					"id": 250340103,
					"content": "呜…呜呜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340104
					],
					"speakerTitle": "奇卡"
				},
				{
					"id": 250340104,
					"content": "瞧瞧，这只龙都不耐烦了。小子，滚一边去，我们不打小孩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340105
					],
					"speakerTitle": "不耐烦的贼匪"
				},
				{
					"id": 250340105,
					"content": "哥几个，把袋子拿过来。哼哼，这只小龙肯定能卖个好价钱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340106
					],
					"speakerTitle": "不耐烦的贼匪"
				},
				{
					"id": 250340106,
					"content": "不许过来！再过来我可要动手了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340107
					],
					"speakerTitle": "特拉忒"
				},
				{
					"id": 250340107,
					"content": "动，动手？你？哈哈哈哈哈哈，哥几个，他要和我们动手！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340108
					],
					"speakerTitle": "不耐烦的贼匪"
				},
				{
					"id": 250340108,
					"content": "我好怕啊，小子。但既然你都放出话了，那可别怪我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340109
					],
					"speakerTitle": "不耐烦的贼匪"
				},
				{
					"id": 250340109,
					"content": "呜！呜呜！呜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340110
					],
					"speakerTitle": "奇卡"
				},
				{
					"id": 250340110,
					"content": "啧，这小龙还挺凶的…小子，你就好好睡一觉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340111,
						250340112
					],
					"speakerTitle": "不耐烦的贼匪"
				},
				{
					"id": 250340111,
					"content": "要睡一觉的是你们。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340113
					]
				},
				{
					"id": 250340113,
					"content": "#{M#大哥哥}{F#大姐姐}！他们是坏蛋！想要抢走奇卡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340114
					],
					"speakerTitle": "特拉忒"
				},
				{
					"id": 250340114,
					"content": "呜呜！呜呜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340115
					],
					"speakerTitle": "奇卡"
				},
				{
					"id": 250340115,
					"content": "…过路的好汉。只要你不管这件事，哥们承你的情，事成后分你一份钱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340116,
						250340117
					],
					"speakerTitle": "不耐烦的贼匪"
				},
				{
					"id": 250340116,
					"content": "不许伤害奇卡。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340118
					]
				},
				{
					"id": 250340118,
					"content": "那就是没得谈了。行啊，那还是道上规矩。咱们手上见真章。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340119
					],
					"speakerTitle": "不耐烦的贼匪"
				},
				{
					"id": 250340119,
					"content": "嘿嘿…兄弟们给我上！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "不耐烦的贼匪"
				},
				{
					"id": 250340117,
					"content": "谁要你的情？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340118
					]
				},
				{
					"id": 250340112,
					"content": "那你们也别怪我了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340113
					]
				}
			]
		},
