			"dialogs": [
				{
					"id": 722430102,
					"content": "我有宝物想要出售。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722430103
					]
				},
				{
					"id": 722430103,
					"content": "出售宝物？真是令人意外。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430104
					],
					"speakerTitle": "玛乔丽"
				},
				{
					"id": 722430104,
					"content": "像您这样强大的冒险家，想要出售的东西一定很罕见吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430105
					],
					"speakerTitle": "玛乔丽"
				},
				{
					"id": 722430105,
					"content": "快请让我看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430106
					],
					"speakerTitle": "玛乔丽"
				},
				{
					"id": 722430106,
					"content": "将龙骨花凝珠的故事告诉了玛乔丽。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722430107
					]
				},
				{
					"id": 722430107,
					"content": "啊，这不是就像是吟游诗人的故事里说的忘忧果吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430108
					],
					"speakerTitle": "玛乔丽"
				},
				{
					"id": 722430108,
					"content": "居然真的有这种东西存在吗…原来它叫龙骨花凝珠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430109
					],
					"speakerTitle": "玛乔丽"
				},
				{
					"id": 722430109,
					"content": "如果它的效果真的和您所说的一样，我愿意花80000摩拉加一些特色料理买下它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430110
					],
					"speakerTitle": "玛乔丽"
				},
				{
					"id": 722430110,
					"content": "嗯…80000摩拉加上5个月亮派，您觉得怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430111,
						722430114,
						722430120
					],
					"speakerTitle": "玛乔丽"
				},
				{
					"id": 722430111,
					"content": "你会拿它做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722430112
					]
				},
				{
					"id": 722430112,
					"content": "嘻嘻，多么独特的宝物呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430113
					],
					"speakerTitle": "玛乔丽"
				},
				{
					"id": 722430113,
					"content": "童话一般的神奇功效，我相信那些炼金术士们不会吝惜自己的钱包。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430110
					],
					"speakerTitle": "玛乔丽"
				},
				{
					"id": 722430114,
					"content": "公道的价格，成交。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722430115
					]
				},
				{
					"id": 722430115,
					"content": "那我就收下这件宝物了，多谢惠顾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430116
					],
					"speakerTitle": "玛乔丽"
				},
				{
					"id": 722430116,
					"content": "对了，通常来说，这种凝珠类的物品会在风中缓慢挥发。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430117
					],
					"speakerTitle": "玛乔丽"
				},
				{
					"id": 722430117,
					"content": "所以，最好将它覆上隔膜或者放进容器密封起来，这样成色会更好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430118
					],
					"speakerTitle": "玛乔丽"
				},
				{
					"id": 722430118,
					"content": "这是一点附送您的小技巧，希望对您的冒险有帮助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430119
					],
					"speakerTitle": "玛乔丽"
				},
				{
					"id": 722430119,
					"content": "如果今后您又找到了类似的宝物，别忘了，这儿有您忠实的买家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玛乔丽"
				},
				{
					"id": 722430120,
					"content": "我再考虑一下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722430121
					]
				},
				{
					"id": 722430121,
					"content": "哈哈，没问题，但是我相信我的价格是最合适的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430122
					],
					"speakerTitle": "玛乔丽"
				},
				{
					"id": 722430122,
					"content": "如果您考虑好了，可以再来找我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玛乔丽"
				}
			]
