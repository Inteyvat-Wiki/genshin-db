			"dialogs": [
				{
					"id": 760310101,
					"content": "哥伦比娅？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760310102,
					"content": "呼…呼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310103
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760310103,
					"content": "#啊！她在睡午觉呢，{NICKNAME}，要不我们待会儿再来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760310104,
					"content": "……！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310105
					],
					"speakerTitle": "帔髦獾"
				},
				{
					"id": 760310105,
					"content": "欸！你别去呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760310106,
					"content": "…唔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310107
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760310107,
					"content": "疼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310108
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760310108,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310109
					],
					"speakerTitle": "帔髦獾"
				},
				{
					"id": 760310109,
					"content": "脚滑了一下？唔，没关系，我没事。嗯？你们也来了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310110
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760310110,
					"content": "原来「月神」还会被动物撞疼的吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760310111,
					"content": "动物们散发的月矩力中没有「恶意」，我就没在意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310112
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760310112,
					"content": "你怎么了？为什么这么害怕？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310113
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760310113,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310114
					],
					"speakerTitle": "帔髦獾"
				},
				{
					"id": 760310114,
					"content": "嗯，嗯嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310115
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760310115,
					"content": "原来你也能听懂它们说了什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760310116,
					"content": "挪德卡莱是月亮升起的地方，只要是在月矩力下长大的动物，都可以算「月神的眷属」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310117
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760310117,
					"content": "那它说了什么呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760310118,
					"content": "它生活的地方出现了魔物，本来想找菈乌玛…但一路被魔物追到了这附近…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310119
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760310119,
					"content": "哦，怪不得会那么害怕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760310120,
					"content": "要送它回去吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760310121
					]
				},
				{
					"id": 760310121,
					"content": "嗯，送去菈乌玛那里好了。她会处理的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310122
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760310122,
					"content": "好呀，看来又要出一趟门了呢。不过这次去的是「霜月之子」那边，你可真的要藏好啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
