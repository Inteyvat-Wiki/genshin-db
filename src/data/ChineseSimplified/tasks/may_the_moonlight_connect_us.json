			"dialogs": [
				{
					"id": 760310301,
					"content": "…这样就好。辛苦你们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310302
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 760310302,
					"content": "月光联系着你我，不论日夜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310303
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 760310303,
					"content": "…嗯？这和我以前听到的不一样了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310304
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760310304,
					"content": "啊！那人走了！我们上吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760310305,
					"content": "菈乌玛大人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310306
					],
					"speakerTitle": "马西捷"
				},
				{
					"id": 760310306,
					"content": "怎么没完了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760310307,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310308
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 760310308,
					"content": "…辛苦了。我稍微出去一会儿，马上回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310309
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 760310309,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310310
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 760310310,
					"content": "几位，周围没人了，可以出来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310311
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 760310311,
					"content": "原来你早就发现我们了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760310312,
					"content": "我怎么可能遗漏「库塔{RUBY#[S]月之少女}尔」散发出的月矩力呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310313
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 760310313,
					"content": "你们…怎么一直跟着我？简直像在…视察我的工作一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310314
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 760310314,
					"content": "呃…抱…抱歉，只是有件事需要找你，但一直找不到时机…没给你不必要的压力就好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760310315,
					"content": "这样吗…明白了，我会处理的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310316
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 760310316,
					"content": "老实说，看完你一天的工作，我都有些不好意思再给你添麻烦了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760310317,
					"content": "这没什么，都是身为「咏月使」应该做的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310318
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 760310318,
					"content": "……",
