			"dialogs": [
				{
					"id": 760310201,
					"content": "…没错，之后再让库涅贡妲拿些水果过去，这两天她需要静养。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310202
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 760310202,
					"content": "哦，菈乌玛好像在忙欸。我们稍等一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760310203,
					"content": "很久以前我就知道，「咏月使」是「霜月之子」中非常重要的存在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310204
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760310204,
					"content": "我有时会觉得，她们说不定比真正的「神明」还辛苦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310205
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760310205,
					"content": "哦！她闲下来了！快趁现在…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760310206,
					"content": "菈乌玛大人，这边有些工事需要您安排一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310207
					],
					"speakerTitle": "瓦娜莫"
				},
				{
					"id": 760310207,
					"content": "好，我这就来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310208
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 760310208,
					"content": "又被叫走了吗！真的一点空隙都不给欸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760310209,
					"content": "我们小心地跟上去吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
