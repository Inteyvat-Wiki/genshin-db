				]
			},
			"dialogs": [
				{
					"id": 741850301,
					"content": "嘿嘿，「小呜斯」，以后这里就是你的家啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741850302,
					"content": "呜喵？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850303
					],
					"speakerTitle": "小呜斯"
				},
				{
					"id": 741850303,
					"content": "不过还是感觉有点奇怪呢，卡西奥多应该已经离开这里了没错吧，那现在的「小呜斯」又是谁呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741850304,
					"content": "是原来那只没被卡西奥多凭依的猫，还是和我们一起经历了冒险的呜斯先生呢…唔，脑子乱乱的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850305,
						741850307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741850305,
					"content": "派蒙不适合思考这种问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850306
					]
				},
				{
					"id": 741850306,
					"content": "我是完全搞不明白啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741850309,
					"content": "总之，也给小呜斯找到了新家。以后有时间的话，我们也可以经常来找小呜斯一起玩呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741850310,
					"content": "喵呜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小呜斯"
				},
				{
					"id": 741850307,
					"content": "「小呜斯」就是「小呜斯」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850308
					]
				},
				{
					"id": 741850308,
					"content": "虽然搞不懂，但是也很有道理呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850309
					],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
