			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"安柏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3560101,
					"content": "容我正式介绍，风与蒲公英的牧歌之城，自由之都——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560102
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3560102,
					"content": "受西风骑士团庇护的旅人们，欢迎来到蒙德城！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560103
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3560103,
					"content": "终于不用在荒野露宿啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3560104,
					"content": "不过城里的大家…精神都不太好的样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3560105,
					"content": "因为最近全城都在烦恼风魔龙的事吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560106
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3560106,
					"content": "但有琴在的话，一切都不会有问题的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560107
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3560107,
					"content": "琴？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3560108,
					"content": "西风骑士团代理团长——琴。蒙德的守护者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560109
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3560109,
					"content": "与琴同在的我们，即使是风魔龙这种级别的灾害，也一定能够战胜的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560110,
						3560111
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3560110,
					"content": "（看来是一位大人物…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3560112
					]
				},
				{
					"id": 3560112,
					"content": "#对了，在一起去骑士团总部之前，我有礼物要送给{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560113
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3560113,
					"content": "是刚才帮我清理丘丘人营地的酬谢喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560114
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3560114,
					"content": "见，见者有份！为什么我没有礼物？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3560115,
					"content": "嗯…因为那是小派蒙没法用的东西吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560116
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3560116,
					"content": "但我今晚会请你吃蒙德特色的蜜酱胡萝卜煎肉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560117
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3560117,
					"content": "蜜酱胡萝卜煎肉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3560118,
					"content": "现在就先跟我来吧，我们要去城区的…<color=#00E1FFFF>高处</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安柏"
				},
				{
					"id": 3560111,
					"content": "（希望她能知道关于风神的事…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3560112
					]
				}
			]
		},
		{
			"id": 35604,
			"completionStepIds": [
				35604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"35604",
							"2"
						],
						"stepId": 35604,
						"stateName": "QUEST_STATE_UNFINISHED"
