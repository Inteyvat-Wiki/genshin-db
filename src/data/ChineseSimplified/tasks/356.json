				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"安柏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3560401,
					"content": "那么，说好的礼物就是——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560402
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3560402,
					"content": "<color=#00E1FFFF>风之翼</color>！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560403
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3560403,
					"content": "侦察骑士靠它在天空中行动，蒙德的市民们也很喜欢用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560404
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3560404,
					"content": "我特地把你叫到这里来，就是为了让你第一时间感受到它的好处！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560405
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3560405,
					"content": "是正在热心推荐的语气呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3560406,
					"content": "因为「风」是蒙德的灵魂嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560407
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3560407,
					"content": "好了，赶快来试试风之翼的性能吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560408
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3560408,
					"content": "虽然操作起来很简单，但你一定要听我指示。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安柏"
				}
			]
		}
	]
