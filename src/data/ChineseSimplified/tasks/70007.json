			"dialogs": [
				{
					"id": 700070801,
					"content": "关于图书馆的吵闹声…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070802
					]
				},
				{
					"id": 700070802,
					"content": "原来如此，那应该可以用「那个办法」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070803
					],
					"speakerTitle": "威拉格"
				},
				{
					"id": 700070803,
					"content": "丽莎小姐说过，如果有人违反了图书馆的规定，就必须要受到惩罚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070804
					],
					"speakerTitle": "威拉格"
				},
				{
					"id": 700070804,
					"content": "麻烦你们去图书馆里，传达一下丽莎小姐的意思吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070805
					],
					"speakerTitle": "威拉格"
				},
				{
					"id": 700070805,
					"content": "折坏书页、塞玫瑰花进书里、把书倒着插进书架…肯定算是违反了图书馆的规则吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070806
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700070806,
					"content": "我们走，去向那些来图书馆却不读书的人传达一下丽莎小姐的意思吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
