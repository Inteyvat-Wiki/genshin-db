			"dialogs": [
				{
					"id": 700070401,
					"content": "你所主张的「情感波动会影响研究分析的准确性」，还是没有确切的论据。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070402
					],
					"speakerTitle": "看似理性的女性"
				},
				{
					"id": 700070402,
					"content": "唉，我明白，我现在可能是陷入了一种奇怪的瓶颈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070403
					],
					"speakerTitle": "看似理性的男性"
				},
				{
					"id": 700070403,
					"content": "你们来得正好，我有一个困扰需要听听看外人的意见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070404
					],
					"speakerTitle": "看似理性的男性"
				},
				{
					"id": 700070404,
					"content": "如果我要证明我理论的正确性，就要保证我没有情感的波动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070405
					],
					"speakerTitle": "看似理性的男性"
				},
				{
					"id": 700070405,
					"content": "但我总是做不到这件事，尤其是和她在讨论的时候，我总是不能冷静下来好好思考。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070406
					],
					"speakerTitle": "看似理性的男性"
				},
				{
					"id": 700070406,
					"content": "我也觉得有点奇怪，难道是睡眠不足吗？还是昨天酒精摄入过头了呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070407,
						700070408
					],
					"speakerTitle": "看似理性的女性"
				},
				{
					"id": 700070407,
					"content": "总之，图书馆不可以大声讲话。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070408
					]
				},
				{
					"id": 700070408,
					"content": "总之，先压低音量吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070409
					]
				},
				{
					"id": 700070409,
					"content": "抱歉，但在弄明白这件事之前，我就是不甘心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070410
					],
					"speakerTitle": "看似理性的男性"
				},
				{
					"id": 700070410,
					"content": "完、完全听不明白…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700070411,
					"content": "呃，总之，不能打扰别人，还有，看过的书不能倒着塞进书架！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700070412,
					"content": "好吧…他们好像不搭理我们了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
