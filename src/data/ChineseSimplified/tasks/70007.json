			"trigger": {
				"objectNames": [
					"艾拉·马斯克"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700070101,
					"content": "Ye ika gusha mosi！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070102,
						700070103
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 700070102,
					"content": "感觉你心情不太好…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070104
					]
				},
				{
					"id": 700070104,
					"content": "不好意思，因为最近图书馆实在非常吵闹，我很难安静下来研究丘丘人语。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070105
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 700070105,
					"content": "风花节开始之后，有很多人到这里来约会。他们一开始还能保持安静地看看书，后来就聊起来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070106
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 700070106,
					"content": "而且…而且他们还做了各种可怕的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070107
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 700070107,
					"content": "把书的书角折坏…在书页里塞各种奇奇怪怪的东西…甚至、甚至他们还把书倒着插进书架！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070108
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 700070108,
					"content": "图书馆可不是谈情说爱的地方！这样只会打扰到真正在这里看书做研究的人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070109,
						700070111
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 700070109,
					"content": "威拉格应该来维持秩序。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070110
					]
				},
				{
					"id": 700070110,
					"content": "他也没什么好办法，把人赶走也只是治标不治本。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070113
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 700070113,
					"content": "总之，麻烦你帮帮忙，让这里的人都安静下来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070114,
						700070115
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 700070114,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070116
					]
				},
				{
					"id": 700070116,
					"content": "谢谢你，最吵闹的就是那边的三对，只要让他们注意到影响，我就能继续研究了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070117
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 700070117,
					"content": "不过当心点，他们都没那么好对付…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 700070115,
					"content": "我试试看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070116
					]
				},
				{
					"id": 700070111,
					"content": "可以找丽莎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070112
					]
				},
				{
					"id": 700070112,
					"content": "但我听说，她现在正在陪代理团长巡逻，暂时不在。如果她在的话，这些情侣肯定会收敛很多的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070113
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 700070103,
					"content": "语气比平常更凶了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070104
					]
				}
			]
		},
		{
