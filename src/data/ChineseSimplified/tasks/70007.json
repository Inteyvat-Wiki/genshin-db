					"变魔术的男性",
					"陷入爱河的女性"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700070301,
					"content": "嗯？请问有是什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070302,
						700070303
					],
					"speakerTitle": "陷入爱河的女性"
				},
				{
					"id": 700070302,
					"content": "图书馆应该保持安静。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070304
					]
				},
				{
					"id": 700070304,
					"content": "抱歉，我会注意的，但有时候，这都属于不可抗力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070305
					],
					"speakerTitle": "陷入爱河的女性"
				},
				{
					"id": 700070305,
					"content": "比如，在你没注意到的时候，我从书页的背后取出了一朵玫瑰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070306
					],
					"speakerTitle": "变魔术的男性"
				},
				{
					"id": 700070306,
					"content": "从书中诞生的玫瑰，就像你一样，充满了温柔和知性美…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070307
					],
					"speakerTitle": "变魔术的男性"
				},
				{
					"id": 700070307,
					"content": "哇？！好厉害！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070308
					],
					"speakerTitle": "陷入爱河的女性"
				},
				{
					"id": 700070308,
					"content": "声音太大了！还有，不能用书本来变魔术！会折坏的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700070309,
					"content": "派蒙你的声音也大起来了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070310
					]
				},
				{
					"id": 700070310,
					"content": "哦，对不起，一不小心就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700070311,
					"content": "你也明白了吧，有时候这就是不可抗力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070312
					],
					"speakerTitle": "陷入爱河的女性"
				},
				{
					"id": 700070312,
					"content": "我会注意控制我的声音的，实在不好意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070313
					],
					"speakerTitle": "陷入爱河的女性"
				},
				{
					"id": 700070313,
					"content": "看起来，他们完全没听进去呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700070303,
					"content": "有人说你们太吵了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070304
					]
				}
			]
