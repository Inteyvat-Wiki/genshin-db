			"dialogs": [
				{
					"id": 700071001,
					"content": "欸——什么？丽莎小姐马上就要回来了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700071002
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700071002,
					"content": "要是她知道，有人把书乱用乱放的话，还折页损坏，一定会很生气吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700071003
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700071003,
					"content": "是啊，怎么办呢，真是糟糕啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700071004
					]
				},
				{
					"id": 700071004,
					"content": "要怎么办呢？如果现在开始收拾，还有机会补救吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700071005
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700071005,
					"content": "没想到你们能想到这么好的办法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700071006
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 700071006,
					"content": "都是威拉格的主意…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700071007
					]
				},
				{
					"id": 700071007,
					"content": "还是多亏了丽莎小姐…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700071008
					]
				},
				{
					"id": 700071008,
					"content": "不过要是丽莎小姐看到刚刚的场面，确实会生气吧，这可是图书馆，是学习的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700071009
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 700071009,
					"content": "我终于可以安心做研究了，这是给你们的报酬，谢谢你们。",
