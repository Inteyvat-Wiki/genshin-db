			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"热恋中的青年",
					"热恋中的少女"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700070201,
					"content": "真是感人的故事啊，可惜最后没有一个圆满的结局。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070202
					],
					"speakerTitle": "热恋中的青年"
				},
				{
					"id": 700070202,
					"content": "我们以后不会变成那样的，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070203
					],
					"speakerTitle": "热恋中的少女"
				},
				{
					"id": 700070203,
					"content": "那是当然的，就算我们天各一方，我也会想办法把你带回我的身边。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070204,
						700070205
					],
					"speakerTitle": "热恋中的青年"
				},
				{
					"id": 700070204,
					"content": "图书馆应该保持安静。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070206
					]
				},
				{
					"id": 700070206,
					"content": "欸？我应该很克制我的声音了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070207
					],
					"speakerTitle": "热恋中的少女"
				},
				{
					"id": 700070207,
					"content": "唉，或许这也是恋爱的阻碍吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070208
					],
					"speakerTitle": "热恋中的青年"
				},
				{
					"id": 700070208,
					"content": "看过的故事书，也应该放回正确的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700070209,
					"content": "像现在这样随便乱放，负责整理书架的人会很头疼的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700070210,
					"content": "知道了，知道了，请不要再打扰我们了，正在关键的时候呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070211
					],
					"speakerTitle": "热恋中的青年"
				},
				{
					"id": 700070211,
					"content": "关键的时候…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700070212,
					"content": "不管有多少阻碍，你都会像现在这样，永远不变吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070213
					],
					"speakerTitle": "热恋中的少女"
				},
				{
					"id": 700070213,
					"content": "是的，我以我的生命起誓。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070214
					],
					"speakerTitle": "热恋中的青年"
				},
				{
					"id": 700070214,
					"content": "也不用这么夸张…生命什么的，我会心疼的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070215
					],
					"speakerTitle": "热恋中的少女"
				},
				{
					"id": 700070215,
					"content": "啊，就是你这样的温柔，令人沉醉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070216
					],
					"speakerTitle": "热恋中的青年"
				},
				{
					"id": 700070216,
					"content": "我觉得，他们完全没听进去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700070205,
					"content": "有人说你们太吵了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070206
					]
				}
			]
		},
