			"dialogs": [
				{
					"id": 710500401,
					"content": "关于这种蘑菇…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500402
					]
				},
				{
					"id": 710500402,
					"content": "该说真不愧是经验丰富的冒险家吗，这么快就有所发现了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500403
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500403,
					"content": "嗯？这确定是在这里采摘的菌类吗，这可有点奇怪啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500404
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500404,
					"content": "地下不能长蘑菇吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500405
					]
				},
				{
					"id": 710500405,
					"content": "也不是不能长的问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500406
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500406,
					"content": "只是因为这个菌和生长在须弥的一种菌很像…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500407
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500407,
					"content": "只有一种不太够啊…如果有足够多的样本，说不定就能看出些什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500408
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500408,
					"content": "足够多的样本啊…这个既然也是你拿回来的，肯定知道在哪里还有…不如你帮我采点吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500409
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500409,
					"content": "你帮我采足够多的蘑菇，我给你足够多的钱作为报酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500410
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500410,
					"content": "足够多是多少蘑菇？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500411
					]
				},
				{
					"id": 710500411,
					"content": "嗯…我想想，那就先采8个吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500412
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500412,
					"content": "没关系，只要你带过来，钱不会少你的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "海迪夫"
				}
			]
		},
		{
