				"points": []
			},
			"dialogs": [
				{
					"id": 710500701,
					"content": "蘑菇采回来了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500702
					]
				},
				{
					"id": 710500702,
					"content": "嗯嗯，多谢多谢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500703
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500703,
					"content": "有了你的帮助，我的调查就像是…有句璃月话是怎么说的来着，「就像猛虎插上了翅膀一样顺利」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500704
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500704,
					"content": "如虎添翼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500705
					]
				},
				{
					"id": 710500705,
					"content": "对，简直就是如虎添翼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500706
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500706,
					"content": "这些菌类，怎么会这样呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500707
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500707,
					"content": "这可奇怪了，这种菌类和须弥的一种菌类简直就是一模一样，但怎么会发光呢，在黑暗中生长所以长出了荧光素？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500708
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500708,
					"content": "但是既然已经进化出荧光素，为什么菌类的本体什么变化都没有？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500709,
						710500710
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500709,
					"content": "完全听不懂…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500711
					]
				},
				{
					"id": 710500711,
					"content": "嗯…简单来说，菌类会适应环境进化，但是这种真菌的本体，显然是更适合生长在森林环境的品种。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500712
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500712,
					"content": "所以，这种真菌本来是生长在须弥的，这点毋庸置疑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500713
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500713,
					"content": "那发光是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500714
					]
				},
				{
					"id": 710500714,
					"content": "真菌不是层岩巨渊的原生种，就说明发光不是进化产物，而是非正常生态影响导致的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500715
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500715,
					"content": "大概因为那个天上掉下来的碎块吧，吸收了它的能量…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500716,
						710500717
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500716,
					"content": "碎块？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500718
					]
				},
				{
					"id": 710500718,
					"content": "咳咳…嗯？你刚才说什么，碎块？啊，我是说，肯定是因为真菌的碎块从天上飘下来的时候产生了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500719
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500719,
					"content": "产生了偶发性的变异。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500720
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500720,
					"content": "一定是这样的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500721
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500721,
					"content": "嗯，能采集这些真菌真是感谢你，辛苦了辛苦了，先去好好休息一下吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500722
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500722,
					"content": "我要对这些真菌再做些研究，旁边有人会打扰到我的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500717,
					"content": "什么碎块？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500718
					]
				},
				{
					"id": 710500710,
					"content": "有什么问题吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500711
					]
				}
			]
		}
	]
