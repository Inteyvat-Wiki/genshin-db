				"points": []
			},
			"dialogs": [
				{
					"id": 200660101,
					"content": "伤脑筋…这里要怎么解决啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660102
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200660102,
					"content": "你在做什么呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200660103
					]
				},
				{
					"id": 200660103,
					"content": "为了下一次的骑士选拔，我正在训练呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660104
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200660104,
					"content": "唔…不过，我可没有琴大人那样的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660105
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200660105,
					"content": "比起锻炼「力量」，我觉得学习「技巧」更适合我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660106
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200660106,
					"content": "比如，一口气把这些木桩全部破坏掉的方法…虽然看上去这些木桩不太结实…但是，好歹也是老爸辛苦找给我的，可不能辜负了他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660107
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200660107,
					"content": "你有空的话，也和我一起来想一想吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660108,
						200660109
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200660108,
					"content": "我想一想。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200660110
					]
				},
				{
					"id": 200660110,
					"content": "没关系，好好想喔，木桩不会自己跑掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660111
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200660111,
					"content": "唯一会自己跑掉的只有被消耗的时间和生命，唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660114
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200660114,
					"content": "这种距离，自己对付一边，丢个炸弹炸掉另外一边就是最好的选择啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660115
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200660115,
					"content": "哈哈哈我开玩笑的，炸弹这种东西，怎么可能这么轻松找到啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200660109,
					"content": "我们两个一起上…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200660112
					]
				},
				{
					"id": 200660112,
					"content": "你习惯团体作战吗？真羡慕啊…随时都能叫到帮手的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660113
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200660113,
					"content": "像我这样的，只能学习独自作战啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660114
					],
					"speakerTitle": "艾琳"
				}
			]
		},
