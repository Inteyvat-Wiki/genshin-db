			"dialogs": [
				{
					"id": 730691801,
					"content": "这就是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730691802
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730691802,
					"content": "嗯。这就是恒素果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730691803
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730691803,
					"content": "恒素果是莎兰树积聚梦想和记忆，结出来的。对于我们来说，是能让我们恢复力量的宝贵果实。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730691804
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730691804,
					"content": "要让「觉王之树」长出惟耶之实，需要消耗大量的力量。所以，我们要拿恒素果去供养他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730691805
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730691805,
					"content": "#那菈{NICKNAME}，要好好保管恒素果喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730691806
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730691806,
					"content": "嗯…既然如此，我们教兰罗摩「宝藏」的意思吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730691807
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730691807,
					"content": "宝藏就是很珍贵的东西的意思。你看，恒素果有很多梦想和记忆，而且能让兰那罗恢复力量，很厉害、很稀有对吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730691808
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730691808,
					"content": "像恒素果这样，很珍贵、很重要的东西，这就是宝藏喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730691809
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730691809,
					"content": "哦哦！原来宝藏是这样的意思…我知道了！谢谢派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730691810,
						730691812
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730691810,
					"content": "接下来要做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730691811
					]
				},
				{
					"id": 730691811,
					"content": "唔…记得之前兰拉迦说了，好像要不止一个恒素果。这样的话，我们还要找别的觉树之堂吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730691814
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730691814,
					"content": "#嗯。我会努力！那菈{NICKNAME}、派蒙，我们之后再见吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730691815
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730691815,
					"content": "嗯！之后再见啦，兰罗摩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730691812,
					"content": "谢谢派蒙！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730691813
					]
				},
				{
					"id": 730691813,
					"content": "真是的，你在说什么呀…记得之前兰拉迦说了，好像要不止一个恒素果。这样的话，我们还要找别的觉树之堂吧？",
