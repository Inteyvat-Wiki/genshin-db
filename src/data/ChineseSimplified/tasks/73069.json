			"dialogs": [
				{
					"id": 730690501,
					"content": "哦哦…这就是兰拉吉的歌…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690502
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730690502,
					"content": "啊啊…能够再一次听到你的歌，我与你的约定终于能够履行。兰拉吉，我会带着你的歌，一直唱下去的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690503
					],
					"speakerTitle": "兰耶娑"
				},
				{
					"id": 730690503,
					"content": "谢谢，好那菈。兰耶娑不会忘记的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690504
					],
					"speakerTitle": "兰耶娑"
				},
				{
					"id": 730690504,
					"content": "兰耶娑说话的风格变得正常了…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730690505,
					"content": "#谢谢你们，那菈{NICKNAME}、派蒙！他和兰拉吉是好朋友，所以一直在寻找这一首歌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690506
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730690506,
					"content": "兰拉吉是个…胆小的朋友，喜欢躲在安静的地方，悄悄地唱歌。所以，他的歌能开启未知的通路。既然明白了这首歌…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690507
					],
					"speakerTitle": "兰耶娑"
				},
				{
					"id": 730690507,
					"content": "你们就能开启前往这边的觉树之堂的道路了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690508
					],
					"speakerTitle": "兰耶娑"
				},
				{
					"id": 730690508,
					"content": "嗯！接下来就交给我们吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690509
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730690509,
					"content": "#好。在无忧节相会吧，{M#英俊}{F#美丽}的那菈{M#先生}{F#小姐}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰耶娑"
				}
			]
