			"trigger": {
				"objectNames": [
					"兰耶娑"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730690301,
					"content": "我们又见面啦！兰罗摩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730690302,
					"content": "#喔！那菈{NICKNAME}和派蒙，你们好呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690303
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730690303,
					"content": "嗯。他是兰耶娑。我们寻找觉树之堂的时候，在这里遇到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690304
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730690304,
					"content": "兰耶娑你好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730690305,
					"content": "你好！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730690306
					]
				},
				{
					"id": 730690306,
					"content": "#「接下来唱的是…一位{M#小姐}{F#少年}，追寻至珍之物的诗。在旅途开始时，{M#她}{F#他}双眸的颜色是没有一丝阴霾的琥珀…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690307
					],
					"speakerTitle": "兰耶娑"
				},
				{
					"id": 730690307,
					"content": "…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690308,
						730690309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730690308,
					"content": "感觉怪怪的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730690310
					]
				},
				{
					"id": 730690310,
					"content": "嗯。兰耶娑是「采歌者」，经常去收集各种各样的歌曲。兰耶娑他是采歌的兰那罗里胆子最大的，所以会经常学到那菈的诗歌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690311
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730690311,
					"content": "「我们的宿命，是一同诞生的珍珠…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690312,
						730690313
					],
					"speakerTitle": "兰耶娑"
				},
				{
					"id": 730690312,
					"content": "完全没办法交流…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730690316
					]
				},
				{
					"id": 730690316,
					"content": "言归正传…这里就是觉树之堂吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730690317,
					"content": "啊。不是的，但这也是很厉害的发现。在这里，沉睡着很多年没有兰那罗找到的歌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690318
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730690318,
					"content": "兰那罗的采歌者，会一直一直追求歌的美丽。所以，在时间的最后，会把只属于自己的歌留下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690319,
						730690321
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730690319,
					"content": "那和觉树之堂有关吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730690320
					]
				},
				{
					"id": 730690320,
					"content": "嗯！这边似乎是兰拉吉留下的歌。如果是这样的话，附近应该就有莎兰树了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690323
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730690323,
					"content": "莎兰树…之前兰拉迦好像说过，就是那个什么来着，我看看森林书…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690324
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730690324,
					"content": "#莎兰树！就是能结出恒素果的莎兰树！我们也帮忙吧，{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690325
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730690325,
					"content": "「啊啊，这份思念，会结出像石榴一样血红的果实。即使命运将你的双眼蒙上…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690326,
						730690327
					],
					"speakerTitle": "兰耶娑"
				},
				{
					"id": 730690326,
					"content": "既然是帮助拉娜所需要的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730690331
					]
				},
				{
					"id": 730690331,
					"content": "嗯，总之，在那些玫瑰当中，隐藏着歌曲。唔…但是，我和兰耶娑看了好久好久，都没找到。那些玫瑰，也不和我们说话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690332
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730690332,
					"content": "#原来如此…{NICKNAME}，我们也调查一下看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690333,
						730690335
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730690333,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730690334
					]
				},
				{
					"id": 730690334,
					"content": "嗯！找东西嘛，我们很擅长的，对吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730690335,
					"content": "「我会点亮你的诗。」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730690336
					]
				},
				{
					"id": 730690336,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730690327,
					"content": "「也无法夺走唇边的歌…」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730690328
					]
				},
				{
					"id": 730690328,
					"content": "#噫——{NICKNAME}，你在干什么啦！好奇怪喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690329
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730690329,
					"content": "#那菈{NICKNAME}应该和兰耶娑很合得来呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690330
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730690330,
					"content": "#不要鼓励{M#他}{F#她}啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690331
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730690321,
					"content": "祝你们好运。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730690322
					]
				},
				{
					"id": 730690322,
					"content": "#嗯！谢谢那菈{NICKNAME}。这边似乎是兰拉吉留下的歌。如果是这样的话，附近应该就有莎兰树了。运气很好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690323
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730690313,
					"content": "「啊啊，那罪恶般甜蜜的宿命。」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730690314
					]
				},
				{
					"id": 730690314,
					"content": "#噫——{NICKNAME}，快停下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730690315,
					"content": "#那菈{NICKNAME}好厉害！和兰耶娑的歌一样，完全听不懂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690316
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730690309,
					"content": "是吟游诗人？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730690310
					]
				}
			]
		},
