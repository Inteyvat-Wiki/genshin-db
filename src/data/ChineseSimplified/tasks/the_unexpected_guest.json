			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"烟绯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10190201,
					"content": "#{NICKNAME}和派蒙？真没想到会在这种地方遇到你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190202
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10190202,
					"content": "竟然是烟绯？你一般不是在璃月港里工作吗？怎么跑到这种鸟不拉屎的地方来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190203,
					"content": "嗯，说实话，这趟工作确实有点特别…层岩巨渊最下面原来长这样，我也是第一次见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190204
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10190204,
					"content": "啊不对！两位帮我个忙吧，有人在找我，如果他们问起，你就说没见过我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190205
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10190205,
					"content": "哎？什么意思？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190206,
						10190207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190206,
					"content": "烟绯，难道你…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190208
					]
				},
				{
					"id": 10190208,
					"content": "那可不是，这件事说来话长了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190209
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10190209,
					"content": "总之，搪塞的事就交给你们啦，一会儿见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190210
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10190210,
					"content": "喂，烟绯她真的走了…怎么办呀，我突然好害怕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190211,
					"content": "你说，她该不会是犯了什么法，才逃到这里来的吧？会不会是…什么很恐怖的事情…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190212,
					"content": "不会吧，烟绯可是律法咨询师。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190213
					]
				},
				{
					"id": 10190213,
					"content": "不要太天真哦！这个社会可是很复杂的，先做好最坏打算，万一真有什么事，我们就成她的共犯了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190214,
					"content": "唔唔，要不要袒护她呢…好纠结…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190215,
					"content": "派蒙，真是又复杂又天真。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190216
					]
				},
				{
					"id": 10190216,
					"content": "喂！喂那边的家伙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190217
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10190217,
					"content": "啊！来了，有人来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190218,
					"content": "不过这个声音，好像在哪里听过…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190219,
					"content": "哈哈，居然是你们俩，跑到这种地方来度假吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190220
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10190220,
					"content": "居然是一斗。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190221
					]
				},
				{
					"id": 10190221,
					"content": "噢！看你们的样子，最近应该过得不错吧？我也是哦，哈哈哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190222
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10190222,
					"content": "你后面那个人是…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190223,
					"content": "你们好啊，我是荒泷派成员久岐忍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190224
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10190224,
					"content": "啊哈哈，差点忘了，来来给你们介绍一下，这位是我们荒泷派最厉害的人，阿忍！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190225
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10190225,
					"content": "哦哦！原来也是荒泷派的人呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190226,
					"content": "在花见坂混的厉害人物，肯定要加入我们荒泷派啊。平时帮里的事都是阿忍摆平，也让她罩着你们好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190227
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10190227,
					"content": "#老大的朋友就是我的朋友，很高兴认识二位，{NICKNAME}，派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190228
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10190228,
					"content": "很上道嘛！那我就叫你阿忍啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190229
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190229,
					"content": "很高兴认识你，阿忍。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190230
					]
				},
				{
					"id": 10190230,
					"content": "嗯，以后请多关照。其实我有预感…说不定最近就要你们关照了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190231
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10190231,
					"content": "不过一斗，你刚才说，你们帮派的事都是她在摆平？那其实她才是老大吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190232
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190232,
					"content": "派蒙，你在说什么傻话，老大是我啊。天上地下花见坂荒泷派，从来只有我一个老大！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190233
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10190233,
					"content": "我懂了，是没用的老大和厉害的部下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190234
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190234,
					"content": "喂！唉，算了，凭你这个小脑瓜想不明白也正常，本大爷不跟你一般见识。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190235
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10190235,
					"content": "言归正传，你们有没有见过一个粉色的律…律什么什么法师？反正就是个懂很多的人，个子不高，戴着顶怪帽子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190236
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10190236,
					"content": "咿…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190237
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190237,
					"content": "是一位来自璃月的律法咨询师，名叫烟绯。我猜，二位或许认识。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190238
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10190238,
					"content": "没、没见过哦！也从来不认识！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190239,
						10190240
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190239,
					"content": "派蒙…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190241
					]
				},
				{
					"id": 10190241,
					"content": "嗯，看来你们见过她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190242
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10190242,
					"content": "我没说，我什么都没说啊！你不要瞎猜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190243
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190243,
					"content": "紧张了，看来是被我说中了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190244
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10190244,
					"content": "人在撒谎的时候会下意识眼神游移呢，派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190245
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10190245,
					"content": "不过别担心，我们没有任何恶意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190246
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10190246,
					"content": "你们认识烟绯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190247
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190247,
					"content": "认识认识。她啊，已经是我的救命恩人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190248
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10190248,
					"content": "什么救命恩人？哎…哎等一下，你们两个怎么会出现在层岩巨渊啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190249
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190249,
					"content": "抱歉，派蒙反应有点慢有点笨…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190250
					]
				},
				{
					"id": 10190250,
					"content": "稻妻锁国令最近解除了，这事你们知道吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190251
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10190251,
					"content": "阿忍来璃月拿她的毕业证，我怕她一个人出远门不安全，就跟过来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190252
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10190252,
					"content": "毕业证？你在璃月上过学？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190253
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190253,
					"content": "我在璃月同文学塾进修过法学，可惜毕业前夕回家探亲刚巧碰上锁国令…这张毕业证拿晚了好几年。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190254
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10190254,
					"content": "我们到璃月港办事，老大排队时跟千岩军士兵起了冲突，险些被拘捕，幸亏烟绯小姐路过出手相助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190255
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10190255,
					"content": "要不是恩人帮了大忙，我恐怕要进璃月大牢了，所以，就想帮她做点什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190256
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10190256,
					"content": "但她说没什么需要我们帮忙的事，那可不行，出门在外哪会不遇到麻烦？干脆跟着她，等有需要时，我立刻一跃而出。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190257,
						10190260
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10190257,
					"content": "也是一种强买强卖呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190258
					]
				},
				{
					"id": 10190258,
					"content": "不不，真的只是想保护她！因为她行色匆忙，感觉是去做一件重要的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190259
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10190259,
					"content": "在这世上想做点伟大重要的事，难免要遇到什么麻烦，你懂的吧？我是好心啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190264
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10190264,
					"content": "#{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190265
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10190265,
					"content": "（阿忍在给我使眼色？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190266
					]
				},
				{
					"id": 10190266,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190267
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10190267,
					"content": "（难道是暗示我把一斗支开…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190268
					]
				},
				{
					"id": 10190268,
					"content": "烟绯刚才往那里走了哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190269
					]
				},
				{
					"id": 10190269,
					"content": "哦，谢谢啦，我这就去找她！喂阿忍，走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190270
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10190270,
					"content": "恩人，等着本大爷来助你一臂之力！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190271
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10190271,
					"content": "谢谢，下次见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190272
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10190272,
					"content": "你刚刚是故意骗一斗的对吧？其实我觉得阿忍没有相信你说的话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190273
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190273,
					"content": "或者说，她也觉得一斗太缠人了，不希望他给烟绯添麻烦呢…这个阿忍，很有眼力嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190274
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190274,
					"content": "这样一来就没人找她啦。之后要是遇到烟绯，记得把这个好消息告诉她！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190275
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190275,
					"content": "那我们先去上次那个被砸过的地方看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190260,
					"content": "鬼也会报恩吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190261
					]
				},
				{
					"id": 10190261,
					"content": "婆婆说了，男人一定要知恩图报。不管是上刀山下火海，这位律法咨询师的事我荒泷一斗都帮定了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190262
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10190262,
					"content": "那万一她用不着你帮忙，你怎么办？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190263
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190263,
					"content": "这…这…哈哈，不可能，这种事绝对不可能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190264
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10190240,
					"content": "你刚刚那个「咿」已经不打自招了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190241
					]
				},
				{
					"id": 10190207,
					"content": "你可不要知法犯法呀…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190208
					]
				}
			]
		},
		{
			"id": 101903,
			"completionStepIds": [
				101903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101903",
							"2"
						],
						"stepId": 101903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"烟绯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10190301,
					"content": "你看，烟绯正好也在那里！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190302,
					"content": "烟绯，那些追你的人被我们支开了哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190303,
					"content": "太好了，多亏你们。那位打扮花哨的大哥可真热情，要是平时应该能交个朋友，可惜我今天有正事要办。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190304
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10190304,
					"content": "唔…什么正事需要在这种怪地方办啊，该不会你也想转行当冒险家了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190305,
					"content": "我是律法咨询师，偶尔也会遇到这种不得不亲自出远门的情况。这次来层岩巨渊，是因为一份「遗嘱」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190306
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10190306,
					"content": "遗嘱…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190307,
					"content": "嗯。我在一本古书中找到一份遗嘱，应该是从前的某位高人所留。他有一件法宝失踪了，想找回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190308
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10190308,
					"content": "这种事竟然也要律法咨询师做啊，真辛苦呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190309,
					"content": "代为执行遗嘱也是律法咨询师工作的一环，当然啦，像这样的情况确实不多见。层岩巨渊也不是想来就来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190310
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10190310,
					"content": "哦？原来你知道啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190311
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10190311,
					"content": "噫！谁呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190312,
					"content": "哎呀，你在啊？果然被我猜对了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190313
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10190313,
					"content": "大律法咨询师到层岩巨渊来办事，哪里需要请示我的意见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190314
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10190314,
					"content": "有夜兰在的地方，我说话可不算数，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190315
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10190315,
					"content": "她、她是谁啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190316,
					"content": "这位是夜兰，璃月的…唔，我能说你就职于总务司吗？总之，是我的一位朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190317
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10190317,
					"content": "可以啊。刚巧，最近我也在这一带有事要办，与各位算是小有缘分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190318
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10190318,
					"content": "旅行者和派蒙或许不认识我，我对你们倒是有所耳闻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190319
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10190319,
					"content": "见笑了，我在璃月朋友太多…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190320
					]
				},
				{
					"id": 10190320,
					"content": "几位来这里办事，我的工作则是监察层岩巨渊。依照规章，我理应陪同。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190321
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10190321,
					"content": "但这次我另有要务在身，怕是无法全程跟随了，几位自便，不要搞出什么大动作就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190322
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10190322,
					"content": "糟糕，我还想请你帮忙的呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190323
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10190323,
					"content": "看在往日交情的份上，你能不能稍微抽点时间帮我搞定这份遗嘱？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190324
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10190324,
					"content": "求我可是要拿出诚意的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190325
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10190325,
					"content": "好说，请导游也要付钱的嘛，刚巧萍姥姥给了我一些好茶叶，不嫌弃的话，让我请你喝杯茶吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190326
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10190326,
					"content": "呵呵，不如先说说你来此地的详情，我才…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190327
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10190327,
					"content": "喂！你们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190328
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10190328,
					"content": "一斗怎么回来了啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190329
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190329,
					"content": "#好啊你们，故意支开我是吧！我说{NICKNAME}，你怎么不向着你的兄弟我了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190330
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10190330,
					"content": "因为这边也是我的朋友嘛…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190331
					]
				},
				{
					"id": 10190331,
					"content": "留步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190332
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10190332,
					"content": "嗯？你谁啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190333
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10190333,
					"content": "抱歉，这一带都属于层岩重地，外人还请止步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190334
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10190334,
					"content": "开什么玩笑，你这里又没个告示围栏，还不让人走路了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190335
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10190335,
					"content": "真正危险的地方，不会有任何引起注意的告示。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190336
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10190336,
					"content": "原来这里是这么重要的地方啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190337
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190337,
					"content": "的确是个特殊的地方…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190338
					]
				},
				{
					"id": 10190338,
					"content": "这里确实不是能随便出入的地方，我也是因为这一点，才不想让两位跟着。只可惜，我的拒绝没什么用…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190339
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10190339,
					"content": "旅行者帮过璃月许多，烟绯是璃月知名的律法咨询师，我信得过二位的立场和行为，没有阻拦你们在这一带活动。至于这两位…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190340
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10190340,
					"content": "你什么意思？觉得我没名气，还是觉得我不怀好意？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190341
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10190341,
					"content": "正因为不清楚你的底细，才不能让你随便行动。再说烟绯的态度怎么看都不像是需要你帮忙，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190342
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10190342,
					"content": "哈！你怎么知道？你是她肚子里的蛔虫？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190343
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10190343,
					"content": "哦？这不是一目了然的事吗？倒是你，身为稻妻来客，还是入乡随俗，按当地规矩办事比较好哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190344
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10190344,
					"content": "你…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190345
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10190345,
					"content": "别冲动，她说的是实话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190346
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10190346,
					"content": "呃啊，怎么吵起来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190347
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190347,
					"content": "麻烦了…他不该跟夜兰硬碰硬的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190348
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10190348,
					"content": "我们不知道这里性质特殊，既然您这么说，我们会尽快离开。不过要真是危险地区，最好还是立个告示牌吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190349
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10190349,
					"content": "感谢你的意见，我会考虑的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190350
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10190350,
					"content": "如果我们不打算马上就走呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190351
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10190351,
					"content": "老大！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190352
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10190352,
					"content": "那恐怕就会发生不愉快的事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190353
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10190353,
					"content": "啊？意思是你能打赢我们两个？你很自信嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190354
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10190354,
					"content": "二位虽是旅行者和烟绯的朋友，最好也能听懂我的警告。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190355
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10190355,
					"content": "哈哈…有意思，只可惜本大爷不服管。既然你这么厉害，就让本大爷见识见识你的本事啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190356
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10190356,
					"content": "等等，没必要在这里起冲突！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190357
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10190357,
					"content": "不，我就是要往里走，她能把我怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190358
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10190358,
					"content": "呵呵…觉得我喜欢开玩笑？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190359
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10190359,
					"content": "糟了，他们两个要打起来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190360
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190360,
					"content": "二位稍等一下。此事因我而起，不如给我一个面子…哎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190361
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10190361,
					"content": "（地面…在摇晃？！）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190362
					]
				},
				{
					"id": 10190362,
					"content": "不好，这里似乎…啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190363
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10190363,
					"content": "别扯开话题！我可是…嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "荒泷一斗"
				}
			]
		},
		{
			"id": 101904,
			"completionStepIds": [
				101904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101904",
							"2"
						],
						"stepId": 101904,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"烟绯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10190401,
					"content": "痛痛痛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190402,
					"content": "#怎么搞的啊！喂，{NICKNAME}，你没事吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190403,
						10190404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190403,
					"content": "我没事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190405
					]
				},
				{
					"id": 10190405,
					"content": "呃…把书垫在屁股底下也不抗摔呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190406
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10190406,
					"content": "这是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190407
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10190407,
					"content": "这、这是什么地方啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190408,
					"content": "疼疼疼…喂阿忍！还有我的兄弟！恩人！没事吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190409
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10190409,
					"content": "呼…真是飞来横祸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190410
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10190410,
					"content": "喂，我们到底是掉到多深的地方来了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190411,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190412
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10190412,
					"content": "看来在刚才的对峙中，地面坍塌了。难道是因为催动了元素力…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190413
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10190413,
					"content": "可不是本大爷的错啊。你说话这么不客气，谁听了都会发火。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190414
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10190414,
					"content": "我的工作就是阻止外人乱闯重地。假如实话实说也算不客气…你的心智未免有些脆弱了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190415
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10190415,
					"content": "你…人活一口气，我就是不喜欢让步！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190416
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10190416,
					"content": "老大，你根本说不过她，干嘛非要跟她吵？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190417
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10190417,
					"content": "阿忍，你帮哪头的啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190418
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10190418,
					"content": "点明现状而已。虽然理解你的心情，但你没事就跟人起冲突也是在给我添麻烦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190419
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10190419,
					"content": "我发现了，一斗既吵不过夜兰，也说不过阿忍，他在这里很弱势…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190420
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190420,
					"content": "一斗和阿忍就像你和我。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190421
					]
				},
				{
					"id": 10190421,
					"content": "呜哇好生气啊！不要把我跟一斗相提并论！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190422
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190422,
					"content": "喂喂喂这话是什么意思啊，找茬是吧你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190423
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10190423,
					"content": "我、我说的可是实话，你是笨蛋大家都知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190424
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190424,
					"content": "我是笨蛋？那你是飞行矮堇瓜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190425
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10190425,
					"content": "飞行矮堇瓜？！呜，气死我了…我要给你起个难听的外号…就叫你放牛的！哼，放牛的，你很狂嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190426
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190426,
					"content": "我们离掉下来的破洞似乎很远，根本看不到顶上的情况。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190427
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10190427,
					"content": "这种距离，看来是没法直接上去了，得另外找出路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190428
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10190428,
					"content": "各位，抱歉打扰你们聊天的雅兴，有些事你们或许得知道一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190429
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10190429,
					"content": "层岩巨渊在璃月算得上神秘地区，前些年因矿区事故而被封锁。在这里行动，最好学会不看、不听，不问，以免涉及太多各位不该了解的秘密。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190430
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10190430,
					"content": "原则上我不会与大家为敌，也希望大家别在保密问题上为难我。至于出路，我会尽力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190431
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10190431,
					"content": "欸？她怎么走了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190432
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10190432,
					"content": "是去找出口了吧。夜兰她可能是我们之中最懂得应对危机的人，就让她去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190433
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10190433,
					"content": "非常抱歉，一般来说我不会向无关人士透露委托人遗嘱的内容，所以没能跟二位说实话…对不起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190434
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10190434,
					"content": "我来层岩巨渊，是想找回遗嘱中提到的太威仪盘。许多年前，我的委托人将这一法宝交给有志之士，希望这件宝贝能在需要它的地方发挥作用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190435
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10190435,
					"content": "而据目击者说，那个接收法宝的人带着它往层岩巨渊去了，此后便下落不明。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190436
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10190436,
					"content": "历史上，层岩巨渊一带曾发生过多次战争，可就算那个人在战争中死去，我也希望能竭我所能寻回法宝，圆委托人一个心愿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190437
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10190437,
					"content": "至于先前夜兰说的，也都是实话，层岩巨渊暗藏危机…你们应该也体会到了。现在遇到这种麻烦，我想，我们就一起想办法出去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190438
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10190438,
					"content": "既然恩人这么说…好，这个面子我卖了。现在开始大家都是同伴，至于那个臭屁的家伙…哼，也算上好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190439
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10190439,
					"content": "夜兰不是在总务司工作吗？总觉得她是个很厉害的人…没想到做这行需要这么大本事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190440
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190440,
					"content": "唔，对外好像是这么说没错…关于她的身份，我不便透露太多，只能说，这份工作非她莫属。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190441
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10190441,
					"content": "什么工作啊，竟然要在这种鸟不拉屎的地方上班？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190442
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10190442,
					"content": "这个我熟！冒险家呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190443
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190443,
					"content": "？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190444
					]
				},
				{
					"id": 10190444,
					"content": "怎么了那副表情？我又没说错，你我不就是这样的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190445
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190445,
					"content": "冒险家是我，不是派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190446
					]
				},
				{
					"id": 10190446,
					"content": "你最近变得小气了呢，让我蹭蹭名头怎么了嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190447
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190447,
					"content": "#对啊{NICKNAME}，你是派蒙的老大，老大要有气量，应该多让小弟沾光。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190448
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10190448,
					"content": "我们不是这种关系！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190449
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190449,
					"content": "派蒙，老大说的话听听就好，不用往心里去哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190450
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10190450,
					"content": "哼，看在阿忍的份上…好吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190451
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190451,
					"content": "我…唉，我是老大，我让着你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190452
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10190452,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190453
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10190453,
					"content": "我们所在的，难道是没有卷宗记录的另一处封印……这里会有什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190454
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10190454,
					"content": "我这里带了些食物和饮用水，各位需要就说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190455
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10190455,
					"content": "真好！放牛的，虽然你不太聪明，但你的下属好能干好可靠呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190456
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190456,
					"content": "嘿嘿，我也觉……不是！本大爷也很聪明啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190457
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10190457,
					"content": "前方有个入口，里面似乎有路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190458
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10190458,
					"content": "会是什么呢？去看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190404,
					"content": "这里…我们是掉下来了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190405
					]
				}
			]
		},
		{
			"id": 101905,
