			"dialogs": [
				{
					"id": 10190501,
					"content": "这种地方竟然有秘境入口，不可思议…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190502,
					"content": "有进路，应该也有出路，进去看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190503
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10190503,
					"content": "周围这些似乎是有点年头的璃月山岩，跟我在书上看到的类似。这里的秘境应该已经存在很久了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190504
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10190504,
					"content": "……！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190505
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10190505,
					"content": "（有声音？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190506
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10190506,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190507
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10190507,
					"content": "……！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190508
					]
				},
				{
					"id": 10190508,
					"content": "呀！是魈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190509
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190509,
					"content": "降魔大圣？你怎么会在这里？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190510
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10190510,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190511
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10190511,
					"content": "我也刚从上面下来。听见有响声，一路追至此地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190512
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10190512,
					"content": "是不小心掉下来的吗？要不要跟我们一起走？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190513
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190513,
					"content": "不必，我另有要事在身。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190514
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10190514,
					"content": "是什么重要的事吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190515
					]
				},
				{
					"id": 10190515,
					"content": "…找人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190516
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10190516,
					"content": "这里不是你们该来的地方，尽快回去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190517
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10190517,
					"content": "还是那么来无影去无踪呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190518
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190518,
					"content": "刚刚那位小哥很有气势嘛，跟本大爷有得一拼，看来是个厉害角色啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190519
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10190519,
					"content": "放牛的，你哪来的自信呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190520
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190520,
					"content": "放那位先生单独行动，真的好吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190521
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10190521,
					"content": "那个人啊，就算你不让他单独行动，他也不会听别人的…不过他很厉害，所以随他去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190522
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190522,
					"content": "各位，从这里开始请你们多留意四周。谁都不知道前面的路上会有什么，随时做好准备。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190523
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10190523,
					"content": "虽然已经承认你们为同伴，可是…凭本大爷的战斗天赋，不需要她提醒，也不需要她带队。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190524
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10190524,
					"content": "老大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190525
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10190525,
					"content": "啊——知道了知道了啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190526
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10190526,
					"content": "我倒是觉得夜兰给人一种安全感呢。放牛的，你这外宾要好好跟大家相处哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190527
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190527,
					"content": "飞行堇瓜，不要把自己当本地人行不行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "荒泷一斗"
				}
			]
		}
	]
