			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙",
					"凯瑟琳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120090101,
					"content": "凯瑟琳，我们来了，有什么事找我们帮忙吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120090102,
					"content": "不好意思，又要麻烦你们了。这次是天领奉行直接交给冒险家协会的委托，很重要，也很危险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090103
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 120090103,
					"content": "协会在评估后认为，这份委托只能交给最资深的冒险家，于是我就想到了你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090104
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 120090104,
					"content": "嘿嘿，也没有那么厉害啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090105,
						120090106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120090105,
					"content": "听上去有点危险？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090107
					]
				},
				{
					"id": 120090107,
					"content": "先由我来说明一下吧。天领奉行近日下发了通缉令，他们想要找一个名叫「荒泷一斗」的鬼族青年。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090108
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 120090108,
					"content": "鬼族？我好像听说过，就是头上长角，看起来很凶的人吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120090109,
					"content": "是的，这个人很张扬很吵闹，所以在町街有点名气。但话虽如此，他以前也没有闯过什么大祸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090110
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 120090110,
					"content": "没想到，最近他竟然做起了抢劫和掳掠的勾当…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090111
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 120090111,
					"content": "不只是做了坏事，在天领奉行众打算逮捕他的时候，他还袭击了执行抓捕的同心，带着身边的人逃走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090112
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 120090112,
					"content": "感觉很恶劣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090113
					]
				},
				{
					"id": 120090113,
					"content": "总而言之，就是想让我们去把坏人抓回来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120090114,
					"content": "#放心放心，{NICKNAME}{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}可厉害了，什么对手都不在话下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120090115,
					"content": "嗯，不过还是不要鲁莽行动为好，这个人是神之眼的持有者，手下还管理着一个名为「荒泷派」的组织。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090116,
						120090118
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 120090116,
					"content": "我不那么擅长打群架…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090117
					]
				},
				{
					"id": 120090117,
					"content": "也对，毕竟我们完全不了解他。听你的吧，还是谨慎一点好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120090120,
					"content": "有关荒泷一斗这个人，他为什么要做这样的事，现在又逃到了什么地方去，这些信息我们都还没有掌握。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090121
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 120090121,
					"content": "町街的各位应该比我更熟悉他，你们应该能从他们那里获得有用的情报。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090122
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 120090122,
					"content": "嗯，我会去打听看看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090123
					]
				},
				{
					"id": 120090123,
					"content": "感谢你的协助，我在这里等待你的好消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 120090118,
					"content": "我手下有派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090119
					]
				},
				{
					"id": 120090119,
					"content": "对不起，对不起啦！别让我去打架，我不该夸下海口的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120090106,
					"content": "天领奉行自己解决不了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090107
					]
				}
			]
		},
		{
			"id": 1200902,
			"completionStepIds": [
				1200902
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200902",
							"2"
						],
						"stepId": 1200902,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"小仓澪",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120090201,
					"content": "荒泷一斗？啊，他的事我知道，我一直觉得是天领奉行的人搞错了，他不可能为恶啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090202
					],
					"speakerTitle": "小仓澪"
				},
				{
					"id": 120090202,
					"content": "欸？为什么这么肯定，你很信任他吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120090203,
					"content": "你误会了，我的意思是，他可能并没有为恶的「能力」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090204,
						120090205
					],
					"speakerTitle": "小仓澪"
				},
				{
					"id": 120090204,
					"content": "是指…力气？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090206
					]
				},
				{
					"id": 120090206,
					"content": "听我讲一个他的故事你们就明白了，他以前经常和町街的小孩子玩猜拳和捉迷藏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090207
					],
					"speakerTitle": "小仓澪"
				},
				{
					"id": 120090207,
					"content": "小孩子单纯又好懂，你们肯定明白。但就算是和他们做游戏，荒泷一斗有时候也输得很惨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090208
					],
					"speakerTitle": "小仓澪"
				},
				{
					"id": 120090208,
					"content": "是他故意的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120090209,
					"content": "不不不，有一次我亲眼见到他赢了一个小孩子，他开心地跳了起来，喊着什么「终于赢了！」…「本大爷无敌！」之类的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090210
					],
					"speakerTitle": "小仓澪"
				},
				{
					"id": 120090210,
					"content": "还赢走了这个孩子手里的硬糖，当着他的面吃掉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090211
					],
					"speakerTitle": "小仓澪"
				},
				{
					"id": 120090211,
					"content": "呜哇，好差劲！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120090212,
					"content": "那次确实有点过分了，所以我帮那个快哭出来的小孩子教训了他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090213
					],
					"speakerTitle": "小仓澪"
				},
				{
					"id": 120090213,
					"content": "他认错的速度很快，态度也很坦率，所以孩子马上又笑了出来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090214
					],
					"speakerTitle": "小仓澪"
				},
				{
					"id": 120090214,
					"content": "因为他「愿赌服输，从不放水」，有些孩子还挺喜欢找他玩的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090215
					],
					"speakerTitle": "小仓澪"
				},
				{
					"id": 120090215,
					"content": "但这样一个经常输给小孩子的人…要怎么去作恶呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090216,
						120090217
					],
					"speakerTitle": "小仓澪"
				},
				{
					"id": 120090216,
					"content": "我懂你的意思了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090218
					]
				},
				{
					"id": 120090218,
					"content": "这么听起来，他好像不是个坏人啊，而且是个有原则的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120090219,
					"content": "嗯，原本我也这样想，但听说天领奉行的人已经掌握了确凿的证据。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090220
					],
					"speakerTitle": "小仓澪"
				},
				{
					"id": 120090220,
					"content": "我不想为他辩解，他如果真的犯了错，那就该乖乖受罚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090221
					],
					"speakerTitle": "小仓澪"
				},
				{
					"id": 120090221,
					"content": "嗯，谢谢你！我们再去打听一下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120090217,
					"content": "挺意外的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090218
					]
				},
				{
					"id": 120090205,
					"content": "是指…心智？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090206
					]
				}
			]
		},
		{
			"id": 1200903,
			"completionStepIds": [
				1200903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200903",
							"2"
						],
						"stepId": 1200903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"古谷升",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120090301,
					"content": "你想问荒泷一斗？嗯，我听说他最近犯了事，已经逃走了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090302
					],
					"speakerTitle": "古谷升"
				},
				{
					"id": 120090302,
					"content": "刚听说的时候，我有点意外，但…也不算非常意外。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090303
					],
					"speakerTitle": "古谷升"
				},
				{
					"id": 120090303,
					"content": "是因为他以前名声就不好吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120090304,
					"content": "不，怎么说呢…咳咳，他无论干什么事都声势浩大，给人一种血气方刚，又有点聒噪的感觉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090305
					],
					"speakerTitle": "古谷升"
				},
				{
					"id": 120090305,
					"content": "这样的人，说好听一点叫爽朗，说不好听的话，就是情绪不安定，开心的时候很开心，愤怒的时候很愤怒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090306
					],
					"speakerTitle": "古谷升"
				},
				{
					"id": 120090306,
					"content": "我对荒泷一斗这个人的印象并不差，但他冲动起来会不会失控，我也说不好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090307,
						120090308
					],
					"speakerTitle": "古谷升"
				},
				{
					"id": 120090307,
					"content": "他平时是做什么的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090309
					]
				},
				{
					"id": 120090309,
					"content": "这个我也不清楚，咳咳…我平时还算比较注意城里发生的事，但荒泷一斗好像就只是在混日子而已…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090310
					],
					"speakerTitle": "古谷升"
				},
				{
					"id": 120090310,
					"content": "有人需要帮忙的话，他会帮忙，其他时候，就是在和手下或者小孩子胡闹了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090311
					],
					"speakerTitle": "古谷升"
				},
				{
					"id": 120090311,
					"content": "唉，是不是因为没有收入，日子过不下去了，才想要做坏事呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090312
					],
					"speakerTitle": "古谷升"
				},
				{
					"id": 120090312,
					"content": "好奇怪的人啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120090313,
					"content": "抱歉了，其他的情况我也不清楚，他更喜欢和精神好一点的人待在一起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090314
					],
					"speakerTitle": "古谷升"
				},
				{
					"id": 120090314,
					"content": "或许你们可以找其他人再打听一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090315
					],
					"speakerTitle": "古谷升"
				},
				{
					"id": 120090315,
					"content": "好的，谢谢你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120090308,
					"content": "他有什么稳定的工作吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090309
					]
				}
			]
		},
		{
			"id": 1200904,
			"completionStepIds": [
				1200904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200904",
							"2"
						],
						"stepId": 1200904,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"上杉",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120090401,
					"content": "荒泷一斗？啊，我知道，我们正在抓捕他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090402
					],
					"speakerTitle": "上杉"
				},
				{
					"id": 120090402,
					"content": "他已经逃离稻妻城了，因为没有进一步的线索，我们才会委托其他人协同搜寻，包括冒险家们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090403
					],
					"speakerTitle": "上杉"
				},
				{
					"id": 120090403,
					"content": "凯瑟琳和我们说，荒泷一斗以前没有闯过大祸，这次好像事出突然…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120090404,
					"content": "所谓的掳掠和抢劫，这些都是有证据的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120090405,
					"content": "那是当然，不然也不会因为他，动用这么多人手了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090406
					],
					"speakerTitle": "上杉"
				},
				{
					"id": 120090406,
					"content": "虽然抢劫的人都会想办法隐藏自己的身份，但是鬼族的角太显眼了，一下就能认出来是他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090407
					],
					"speakerTitle": "上杉"
				},
				{
					"id": 120090407,
					"content": "不可能是别的鬼吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090408
					]
				},
				{
					"id": 120090408,
					"content": "起初我们只是怀疑他，但去调查的时候，他直接亲口承认了罪行，还挑衅了我们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090409
					],
					"speakerTitle": "上杉"
				},
				{
					"id": 120090409,
					"content": "最可气的是，最后居然还让他带着身边的人逃掉了…这家伙一定是早有准备！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090410
					],
					"speakerTitle": "上杉"
				},
				{
					"id": 120090410,
					"content": "他有作恶动机吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090411
					]
				},
				{
					"id": 120090411,
					"content": "当然，无论是现实动机还是心理动机，都很充足。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090412
					],
					"speakerTitle": "上杉"
				},
				{
					"id": 120090412,
					"content": "他的生活一直都很拮据，也没做什么正经工作，听说他还要照顾一个帮派的人，负担相当大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090413
					],
					"speakerTitle": "上杉"
				},
				{
					"id": 120090413,
					"content": "与其一直受苦，他可能觉得，作恶能让他过得更轻松。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090414
					],
					"speakerTitle": "上杉"
				},
				{
					"id": 120090414,
					"content": "至于心理上的动机，虽然现在有点难以启齿，在实施「眼狩令」的时候，他的神之眼被我们夺走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090415
					],
					"speakerTitle": "上杉"
				},
				{
					"id": 120090415,
					"content": "原来是想报复天领奉行啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090416
					]
				},
				{
					"id": 120090416,
					"content": "那个时候，荒泷一斗反抗得很厉害，我们费了非常大的力气，还求助了九条裟罗大人，这才成功。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090417
					],
					"speakerTitle": "上杉"
				},
				{
					"id": 120090417,
					"content": "…这件事确实是我们的错，但没想到他为了报复，采取了如此过激的手段。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090418
					],
					"speakerTitle": "上杉"
				},
				{
					"id": 120090418,
					"content": "听起来，好像确实是个情绪很不稳定的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090419,
						120090420
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120090419,
					"content": "动机上也能够说通。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090421
					]
				},
				{
					"id": 120090421,
					"content": "嗯，如果你们能制服荒泷一斗，就直接把他带到我这里来，我们会依规处置他的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090422
					],
					"speakerTitle": "上杉"
				},
				{
					"id": 120090422,
					"content": "好的，谢谢你的情报。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120090420,
					"content": "看来证据确凿。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090421
					]
				}
			]
		},
		{
			"id": 1200905,
			"completionStepIds": [
				1200905
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200905",
							"2"
						],
						"stepId": 1200905,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙",
					"珊瑚"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120090501,
					"content": "你好，我们想打听关于荒泷一斗的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120090502,
					"content": "又是他啊…当然没问题，之前我已经帮天领奉行做过一些调查了。不过更重要的，你们的咨询费带够了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090503
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 120090503,
					"content": "你们的名号我也听过，见过那么多大风大浪，自然每一行每一路的规矩都是明白的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090504
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 120090504,
					"content": "这、这个…要多少钱啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120090505,
					"content": "三十九万七千摩拉，先行一次性支付，若成功将荒泷一斗捉拿归案，我还要收取协会报酬的百分之五作为提成。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090506
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 120090506,
					"content": "太贵了！这个数字是怎么算出来的啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120090507,
					"content": "呵呵，听我说完嘛——这笔咨询费之前天领奉行已经付过了，所以你们只需要支付提成就行啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090508
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 120090508,
					"content": "而提成的部分，到时候我会直接和冒险家协会结算的。你们可是捡了个大便宜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090509
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 120090509,
					"content": "那么，要了解这件事的原委，就不得不提到，在稻妻很有名的童话故事——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090510
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 120090510,
					"content": "青鬼呢？青鬼后来怎么样了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090511
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120090511,
					"content": "后来青鬼就消失了吧，再也没见过了，现在留下来的也只有赤鬼了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090512
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 120090512,
					"content": "呜呜呜，怎么这样…青鬼真是个好孩子啊——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090513
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120090513,
					"content": "童话故事和现实有关系吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090514
					]
				},
				{
					"id": 120090514,
					"content": "当然，不然我也不会讲了。有一种说法是…这个童话就是由历史改编而来，而荒泷一斗就是故事里赤鬼的后代。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090515
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 120090515,
					"content": "我想告诉你们的是，鬼族当年牺牲了很多，最后才能融入人类，但鬼族的性格里仍然有不安定的要素。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090516
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 120090516,
					"content": "这种不安定是从血脉中传承下来的，荒泷一斗以前并没有做过什么坏事，但说不定有一天会性情大变呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090517
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 120090517,
					"content": "但这样的话，赤鬼不就背叛了青鬼的愿望嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090518
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120090518,
					"content": "那都是很久远的事了。青鬼已经不知道多久没有出现过，估计早就消亡了，背叛自然也无从谈起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090519
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 120090519,
					"content": "而且…既然当事人都已经承认了，那还有什么可怀疑的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090520
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 120090520,
					"content": "根据我的调查，他一直朝着西南方向走，很有可能已经到了<color=#00E1FFFF>八酝岛</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090521
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 120090521,
					"content": "天领奉行众没办法到珊瑚宫军的控制范围去抓人，所以荒泷一斗逃去那里也有足够的理由。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090522
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 120090522,
					"content": "我明白了，谢谢你的情报。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090523
					]
				},
				{
					"id": 120090523,
					"content": "没关系，这是我应该做的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090524
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 120090524,
					"content": "等等，我还有个问题，如果这个叫荒泷一斗的人性情大变，那是不是就会很凶恶，很暴躁？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090525
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120090525,
					"content": "应该是吧，从他之前和别人交手的情况看，他很擅长打架，有一股蛮力，光凭你们不知道能不能制服他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090526
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 120090526,
					"content": "那…故事里面说对鬼族撒豆子的事，也是有用的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090527
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120090527,
					"content": "哦，你这么一说我想起来了，荒泷一斗他好像对豆子过敏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090528
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 120090528,
					"content": "鬼族都有点害怕豆子，他尤其害怕，据说连碰一下都不行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090529
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 120090529,
					"content": "能让他过敏，变得虚弱的话，就能很顺利地把他带回来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090530,
						120090532
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 120090530,
					"content": "只能这样了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090531
					]
				},
				{
					"id": 120090531,
					"content": "对吧，能找到弱点就方便多啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090534
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120090534,
					"content": "我这里正好有一袋豆子，本来是煮粥用的，交给你们好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090535
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 120090535,
					"content": "——豆子的钱，我会找协会以实惠的价格结算的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090536
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 120090536,
					"content": "果然你在打这样的主意！不过，还是谢谢你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090537
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120090537,
					"content": "那我们就去<color=#00E1FFFF>八酝岛</color>找人了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
