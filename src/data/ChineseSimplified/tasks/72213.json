			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"大岛纯平"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722130301,
					"content": "唉，这没锤子，没凿子，怎么干活呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130302
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 722130302,
					"content": "遇见什么难题了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130303
					]
				},
				{
					"id": 722130303,
					"content": "喔，是你们啊。哎呀…真是大意了，来的时候没检查工具，结果工作的时候太入神，不小心把锤子和凿子都弄坏了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130304
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 722130304,
					"content": "虽然我也想回去鸣神岛买点工具，但是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130305
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 722130305,
					"content": "怎么说呢…雕刻雕像这种事情，我习惯一口气做好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130306
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 722130306,
					"content": "虽然锤子和凿子坏了，但我还能稍微比划一下，想一想后面怎么雕刻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130307
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 722130307,
					"content": "要是现在离开这座雕像，去鸣神岛买工具的话…回来之后，我又要从头回忆雕刻的手感了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130308
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 722130308,
					"content": "而且，这块石头的质地也太硬了，用一般的工具雕刻的话，工具肯定还是会很快坏掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130309
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 722130309,
					"content": "唔…没办法了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130310
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 722130310,
					"content": "旅行者，能请你们去帮我找三份铁块回来吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130311
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 722130311,
					"content": "我得想个办法，自己亲手造几份可靠的工具才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130312,
						722130314
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 722130312,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130313
					]
				},
				{
					"id": 722130313,
					"content": "喔！那就拜托你们了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 722130314,
					"content": "你…自己开始铸造？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130315
					]
				},
				{
					"id": 722130315,
					"content": "我好歹也是在踏鞴砂做工的，锻冶当然也会一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130316
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 722130316,
					"content": "不过，我可不能在神社开炉，不然代宫司大人准会生气…嘿嘿，毕竟它是猫嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130317
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 722130317,
					"content": "总之，请你先找三份铁块给我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大岛纯平"
				}
			]
		},
