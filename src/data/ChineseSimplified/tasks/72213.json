			},
			"dialogs": [
				{
					"id": 722130501,
					"content": "太好了，有这些铁块就足够了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130502
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 722130502,
					"content": "等会我就去外面找个合适的位置搭炉，然后制作工具。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130503
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 722130503,
					"content": "请你们代我去向代宫司大人说一声吧，我先在这里收拾收拾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大岛纯平"
				}
			]
		},
		{
