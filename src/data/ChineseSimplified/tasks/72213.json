			"trigger": {
				"objectNames": [
					"「寝子」",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722130101,
					"content": "「抱愁」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130102
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722130102,
					"content": "雕像如何了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130103
					]
				},
				{
					"id": 722130103,
					"content": "那个石头人类可真厉害啊，喵喵喵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130104
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722130104,
					"content": "已经做好了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130105
					]
				},
				{
					"id": 722130105,
					"content": "不是，只是转眼间就弄来了一块好大好大的石头。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130106
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722130106,
					"content": "然后念叨着，「宫前」、「抱愁」之类的东西，然后一边对着石头咚咚咚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130107
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722130107,
					"content": "说起来，请汝回答奴家吧。「宫前」、「抱愁」到底是什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130108
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722130108,
					"content": "是「工钱」、「报酬」吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130109
					]
				},
				{
					"id": 722130109,
					"content": "也就是为了报答他的劳动，给他的好东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722130110,
					"content": "是这样吗？人类原来讲究这个啊…那好吧，奴家就恩准他摸奴家的耳朵好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130111
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722130111,
					"content": "可、可能不太够…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722130112,
					"content": "不够吗？那，汝给他…吃的东西好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130113
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722130113,
					"content": "可能他想要的是钱…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130114
					]
				},
				{
					"id": 722130114,
					"content": "钱？这种东西不是用来放进「塞钱箱」的吗？真奇怪，人类竟然中意这个。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130115
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722130115,
					"content": "工钱是很重要的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130116
					]
				},
				{
					"id": 722130116,
					"content": "哼，汝姑且也帮奴家做了不少事，奴家相信汝便是。回头，奴家再跟他谈谈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130117
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722130117,
					"content": "不过，石头人类现在没有咚咚咚了。看他拿着好短的木头棍子，不知道在做什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130118
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722130118,
					"content": "木头棍子？雕塑不是要用锤子、凿子之类的东西吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722130119,
					"content": "难不成工具坏了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130120
					]
				},
				{
					"id": 722130120,
					"content": "#那{NICKNAME}，我们去找大岛先生吧！说不定我们能帮上什么忙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
