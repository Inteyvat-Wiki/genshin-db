				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722130601,
					"content": "喵喵喵，有什么事吗？奴家会准备充足的「抱愁」的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130602,
						722130603
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722130602,
					"content": "是「报酬」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130605
					]
				},
				{
					"id": 722130605,
					"content": "总之，石头人…大岛先生的工具坏了。不过我们已经给他维修的材料了，应该没什么问题！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722130606,
					"content": "问题？有什么问题吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130607,
						722130608
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722130607,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130609
					]
				},
				{
					"id": 722130609,
					"content": "那就好。奴家很期待哪，那个奴家的石头。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130610
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722130610,
					"content": "阿响说，那个石头的奴家做好了以后，一定会发生什么好事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130611
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722130611,
					"content": "奴家很期待哪。到底是什么好事呢…难道，阿响会回来么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「寝子」"
				},
				{
