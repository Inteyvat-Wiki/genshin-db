					],
					"speakerTitle": "戚楠"
				},
				{
					"id": 710550607,
					"content": "那，你怎么到层岩巨渊下面来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550608
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710550608,
					"content": "我…我想我的爸爸了，他工作忙，每次下矿都要一个月才能回一次家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550609
					],
					"speakerTitle": "戚楠"
				},
				{
					"id": 710550609,
					"content": "他不在家的时候，家里就只有我一个人…「要是发生了什么事，我该多么寂寞和害怕呀。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550610
					],
					"speakerTitle": "戚楠"
				},
				{
					"id": 710550610,
					"content": "但你看，如果我能到矿下就好了。「在营地里，爸爸就能每天都见到我了，就能天天照顾我，保护我。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550611,
						710550612
					],
					"speakerTitle": "戚楠"
				},
				{
					"id": 710550611,
					"content": "可是这里很危险。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710550613
					]
				},
				{
					"id": 710550613,
					"content": "#嗯…{NICKNAME}说得对，这里可危险了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550614
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710550614,
					"content": "我们把你带回营地吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550615
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710550615,
					"content": "那可不行，我偷偷来这里，要是让他知道，他一定会生气的，那样我就再也没法出来玩了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550616
					],
					"speakerTitle": "戚楠"
				},
				{
					"id": 710550616,
					"content": "对了，你们不是要找那个娃娃吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550617
					],
					"speakerTitle": "戚楠"
				},
				{
					"id": 710550617,
					"content": "我知道那个娃娃在哪里…嘻嘻，跟我来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "戚楠"
				},
				{
					"id": 710550612,
					"content": "还是先回去吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710550613
					]
				}
			]
		},
		{
			"id": 7105507,
			"completionStepIds": [
				7105511
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105511",
							"2"
						],
						"stepId": 7105511,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"戚楠"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710550701,
					"content": "爸爸不在家的时候，如果有人欺负我，我都不知道该怎么办。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550702
					],
					"speakerTitle": "戚楠"
				},
				{
					"id": 710550702,
					"content": "每次爸爸回家的时间长一点就好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550703
					],
					"speakerTitle": "戚楠"
				},
				{
					"id": 710550703,
					"content": "如果爸爸能够一直在身边的话，我也不用那样「乖巧懂事」，就会是个常常和爸爸撒娇的，天真的小孩了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550704
					],
					"speakerTitle": "戚楠"
				},
				{
					"id": 710550704,
					"content": "嗯…玩具？那个玩具娃娃就在前面哦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550705
					],
					"speakerTitle": "戚楠"
				},
				{
					"id": 710550705,
					"content": "丢了那个玩具爸爸一定很着急很着急，一定要…找到那个玩具才行啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "戚楠"
				}
			]
		},
		{
			"id": 7105508,
			"completionStepIds": [
				7105513
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105513",
							"2"
						],
						"stepId": 7105513,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙",
					"戚定"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710550801,
					"content": "戚定！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550802
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710550802,
					"content": "#啊…咦，这不是大名鼎鼎的{NICKNAME}和…身边的小飞人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550803
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550803,
					"content": "身边的小飞人是什么奇怪的称呼啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550804
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710550804,
					"content": "我也是有名字的，我叫派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550805
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710550805,
					"content": "#抱歉抱歉，派蒙，{NICKNAME}，找我…是有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550806
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550806,
					"content": "咦，你怎么忘了呢，我们当时受你所托去找东西，但是那地方只有一箱潮湿的火药…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550807
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710550807,
					"content": "唉…实在不好意思，我之前在层岩巨渊底下，被什么东西影响了，脑袋一直昏昏沉沉，到了上面才…才稍微清醒了一点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550808
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550808,
					"content": "听瑾武说我在下面大哭大闹，还、还真是丢脸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550809
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550809,
					"content": "不过你们说起火药我就想起来了，我确实是打算拿那些火药…去炸掉那个「许愿石」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550810,
						710550811
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550810,
					"content": "「许愿石」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710550812
					]
				},
				{
					"id": 710550812,
					"content": "当年封矿的时候，就有几个兄弟下矿，说矿里挖出了许愿石，说只要在许愿石周围，不管什么愿望都能实现。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550813
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550813,
					"content": "还有这样的东西…我只是随口问问，那个许愿石现在还在吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550814
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710550814,
					"content": "应该还在吧，就是一块非常大的石头，悬在几块巨岩之间，还散发着幽光…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550815
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550815,
					"content": "唔…这描述听上去怎么这么像…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550816
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710550816,
					"content": "之前和志琼看到的大晶石。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710550817
					]
				},
				{
					"id": 710550817,
					"content": "啊？你们也看到「许愿石」啦，可得小心，那可不能随便靠近啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550818
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550818,
					"content": "那些兄弟，都是被那个许愿石弄得精神失常，七星也不得不封矿，结果…结果工作就耽搁了好几年。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550819
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550819,
					"content": "这次下矿，我也遇到了那个石头，要是那石头作祟，这边再被封，不就又没活了…没活干就只能去港口打短工，赚不到什么摩拉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550820
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550820,
					"content": "所以我决定把那个石头炸了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550821
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550821,
					"content": "但是…下去之后，越靠近那个石头，就越是头痛，脑袋也越是乱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550822
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550822,
					"content": "我还依稀见到…不，应该只是产生了幻觉。总之我也听说，要不是你们，我可就危险了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550823
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550823,
					"content": "真是太谢谢你们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550824
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550824,
					"content": "不用谢不用谢，这都是应该做的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550825
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710550825,
					"content": "哦，对了，我们还找到了这个娃娃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550826
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710550826,
					"content": "看上去破破烂烂的，也不知道和你丢的是不是一个。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550827
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710550827,
					"content": "这、这个娃娃？！这个娃娃怎么会在你们手里，你们是在哪里找到的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550828
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550828,
					"content": "这个就是你托我们找的娃娃啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550829
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710550829,
					"content": "我托你们找这个娃娃？这也太奇怪了，这个娃娃是我以前从飞云商会买的，那个时候买这样一个娃娃还得花上不少钱呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550830
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550830,
					"content": "送女儿的礼物嘛，不过后来我女儿也不玩这个娃娃了，我又舍不得扔，就带在身边，当作个护身符。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550831
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550831,
					"content": "几年前封矿，紧急撤离的时候就不知道落在哪了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550832
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550832,
					"content": "怎么…又被你们找出来了呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550833,
						710550834
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550833,
					"content": "有点奇怪…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710550835
					]
				},
				{
					"id": 710550835,
					"content": "唉，本来还想着，靠身板还硬，再赚两年钱，现在看来，层岩巨渊这地方比我想的还要危险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550836
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550836,
					"content": "以后还是不来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550837
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550837,
					"content": "对了，你们帮我和沐宁说下吧，这次我是再也不敢下矿了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550838
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550838,
					"content": "没有问题，你就带着戚楠好好回家吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550839
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710550839,
					"content": "戚楠？戚楠住在璃月，每天为总务司的事忙得不可开交，不可能到层岩巨渊这里来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550840
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550840,
					"content": "不过你说得对，戚楠都已经长大了，我也老了，还是回家多陪陪她比较好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550841
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550841,
					"content": "不对，我是说那边的小女孩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550842
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710550842,
					"content": "什么小女孩？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550843
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550843,
					"content": "那边有什么人在吗…哎呀，你可别吓唬我啦，这玩笑可不好笑啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550844
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550844,
					"content": "好了好了，我这就回家，我不下矿的事，记得帮我和沐宁说一声啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550834,
					"content": "有点邪门…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710550835
					]
				},
				{
					"id": 710550811,
					"content": "那是什么东西？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710550812
					]
				}
			]
		},
