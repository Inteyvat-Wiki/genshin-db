					"speakerTitle": "戚定"
				},
				{
					"id": 710550424,
					"content": "当然了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710550426
					]
				},
				{
					"id": 710550426,
					"content": "我下矿的时候，就去了这么个地方…",
