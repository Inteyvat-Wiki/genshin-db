			"trigger": {
				"objectNames": [
					"沐宁",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710551201,
					"content": "是你们帮忙找到戚定的吧，我都听瑾武说了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710551202
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710551202,
					"content": "他说不想下矿了？那也好，就让他回去休息一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710551203
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710551203,
					"content": "你说「许愿石」作祟？哪有这种东西，不过就是矿坑下面环境太压抑，正常人待久了都会精神失常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710551204
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710551204,
					"content": "如果没有你，这次戚定还不知道会怎么样。那些精神失常的矿工，后来都花了很久才恢复。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710551205
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710551205,
					"content": "他们甚至都不清楚自己身上发生了什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710551206
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710551206,
					"content": "你这段时间常在层岩巨渊跑，自己也要小心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710551207
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710551207,
					"content": "你没看到戚定刚被送上来的样子，一边哭，一边还大声叫着女儿、女儿什么的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710551208
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710551208,
					"content": "啊，说起他的女儿，我们还碰到戚楠了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710551209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710551209,
					"content": "戚楠？哦，不就是戚定的女儿嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710551210
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710551210,
					"content": "怎么了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710551211
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710551211,
					"content": "他的女儿，那个小女孩，之前在下面跟我们一起找那个玩具娃娃，幸好后来她平安无事从层岩巨渊里出来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710551212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710551212,
					"content": "戚定的女儿戚楠？小女孩？你在说什么呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710551213
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710551213,
					"content": "戚定的女儿今年都考进总务司，是个大姑娘了，而且总务司最近正在准备找专家重新查探层岩巨渊的事，怎么可能有空到这儿来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710551214
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710551214,
					"content": "可是我们明明看见…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710551215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710551215,
					"content": "我不管你们看见了什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710551216
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710551216,
					"content": "这样，你们就当什么也没看见吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710551217
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710551217,
					"content": "好了好了，戚定已经平安无事回来了，你们也…也好好休息一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "沐宁"
				}
			]
		},
