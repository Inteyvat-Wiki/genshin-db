						710550312
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550312,
					"content": "这不是刚托认识的人从飞云商会那里买了一个，送到矿里，贴身带着，可不敢弄丢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550313
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550313,
					"content": "结果还是弄丢了嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710550314,
					"content": "唉…我们这些下矿的，本来就赚得少，大部分也都用来补贴家用了，存下来的不多，买这个娃娃还花了不少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550315
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550315,
					"content": "不过钱嘛，总是可以再赚，但是、但是我上次写信跟女儿说，说爸爸已经买到了你想要的玩偶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550316
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550316,
					"content": "这个月回家该怎么办呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550317
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550317,
					"content": "她从来不说，就算我两手空空回去，她肯定也不会说啥，但是…呜呜，你怎么能看那双失望的眼睛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550318
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550318,
					"content": "听上去好可怜啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710550319,
					"content": "不如我们帮他找找那个玩偶吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710550320,
					"content": "只能尽力找找吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710550321
					]
				},
				{
					"id": 710550321,
					"content": "不过，层岩巨渊这里还是太危险了。先一起回营地，我们再下来帮你找找吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550322
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710550322,
					"content": "真的吗？那真是太感谢你们了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550307,
					"content": "带着娃娃下矿？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710550308
					]
				}
			]
