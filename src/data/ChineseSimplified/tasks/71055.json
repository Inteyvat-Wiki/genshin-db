			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"戚定"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710550201,
					"content": "在…在哪里啊，丢在哪儿了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550202
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550202,
					"content": "要是找不到的话…唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550203
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550203,
					"content": "这人身上怎么这么重的火药味…你是谁啊？为什么出现在这里？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710550204,
					"content": "我的名字叫戚定。我、我丢了东西在这，一定要找回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550205
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550205,
					"content": "戚定？这不就是沐宁说的，那个失踪了的矿工的名字吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710550206,
					"content": "得把他带回营地里去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710550207,
					"content": "不行！我不回营地！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550208
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550208,
					"content": "我东西没找着，不回去！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550209
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550209,
					"content": "那、那你在找什么东西呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710550210,
					"content": "我、我在找一个玩具，就一个娃娃，手掌那么大的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550211
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550211,
					"content": "下了一次矿，就不见了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550212,
						710550213
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550212,
					"content": "随身带玩具？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710550214
					]
				},
				{
					"id": 710550214,
					"content": "我知道听上去有点奇怪，但是我是怕那个娃娃丢了嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550215
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550215,
					"content": "你们是不知道那个娃娃有多难买到，价钱高得吓人，而且飞云商会每次新上一批的时候我都在矿里…想买都买不到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550216
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550216,
					"content": "但是我女儿上次看到别家小孩抱着一个就走不动道嘞。我这个女儿呀，知道家里情况不好，想要什么从来不说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550217
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550217,
					"content": "可是做父亲的怎么不知道孩子想要什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550218
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550218,
					"content": "这不是刚托认识的人从飞云商会那里买了一个，送到矿里，贴身带着，可不敢弄丢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550219
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550219,
					"content": "结果还是弄丢了嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710550220,
					"content": "唉…我们这些下矿的，本来就赚得少，大部分也都用来补贴家用了，存下来的不多，买这个娃娃还花了不少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550221
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550221,
					"content": "不过钱嘛，总是可以再赚，但是、但是我上次写信跟女儿说，说爸爸已经买到了你想要的玩偶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550222
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550222,
					"content": "这个月回家该怎么办呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550223
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550223,
					"content": "她从来不说，就算我两手空空回去，她肯定也不会说啥，但是…呜呜，你怎么能看那双失望的眼睛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550224
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550224,
					"content": "听上去好可怜啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710550225,
					"content": "不如我们帮他找找那个玩偶吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710550226,
					"content": "只能尽力找找吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710550227
					]
				},
				{
					"id": 710550227,
					"content": "不过，层岩巨渊这里还是太危险了。先一起回营地，我们再下来帮你找找吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550228
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710550228,
					"content": "真的吗？那真是太感谢你们了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550213,
					"content": "带着娃娃下矿？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710550214
					]
				}
			]
		},
