					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710551101,
					"content": "这个娃娃，怎么看上去破破烂烂的…不过还是先还给戚定吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710551102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710551102,
					"content": "对了，还要带上戚楠，他看见自己的女儿肯定也会高兴的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710551103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710551103,
					"content": "戚楠，咦，戚楠怎么不见了…突然消失了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710551104,
						710551106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710551104,
					"content": "…先回营地吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710551105
					]
				},
				{
					"id": 710551105,
					"content": "唔…确实感觉挺奇怪的，不如我们把娃娃带给戚定，然后问问他吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710551109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710551109,
					"content": "希望戚楠别遭遇什么危险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710551106,
					"content": "…有点奇怪。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710551107
					]
				},
				{
					"id": 710551107,
					"content": "是啊，戚楠到底什么时候不见的？我一点声音都没听到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710551108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710551108,
					"content": "真是奇怪，不如我们把娃娃带给戚定，然后再跟他说说他女儿的事吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710551109
					],
					"speakerTitle": "派蒙"
				}
			]
		},
