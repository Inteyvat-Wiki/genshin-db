				"points": []
			},
			"dialogs": [
				{
					"id": 710551001,
					"content": "哎呀，你们怎么把它们全都打跑了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710551002
					],
					"speakerTitle": "戚楠"
				},
				{
					"id": 710551002,
					"content": "它们刚才还在跟我玩呢，嘻嘻，它们想要抓住我，但是每次都扑了个空，可好玩了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710551003
					],
					"speakerTitle": "戚楠"
				},
				{
					"id": 710551003,
					"content": "要是它们扑中了，可就不好玩了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710551004
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710551004,
					"content": "没关系的…它们扑不中我的，对了，你们不是想找那个娃娃吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710551005
					],
					"speakerTitle": "戚楠"
				},
				{
					"id": 710551005,
					"content": "嘻嘻，那个娃娃就在这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "戚楠"
				}
			]
		},
		{
			"id": 7105511,
