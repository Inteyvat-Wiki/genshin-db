	"talks": [
		{
			"id": 7151601,
			"completionStepIds": [
				7151601
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7151601",
							"2"
						],
						"stepId": 7151601,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"应公"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715160101,
					"content": "这出戏算是完美落幕了，年轻人，你做得不错。感觉怎么样，演纸映剧难不难？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160102,
						715160104
					],
					"speakerTitle": "应公"
				},
				{
					"id": 715160102,
					"content": "轻轻松松。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715160103
					]
				},
				{
					"id": 715160103,
					"content": "纸映剧和璃月戏不同，一个人也能演，的确是轻松不少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160106
					],
					"speakerTitle": "应公"
				},
				{
					"id": 715160106,
					"content": "#我觉得{NICKNAME}做得够好啦，纸映剧本身也很有意思，我还想看新的故事，应公大叔，你什么时候再演？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715160107,
					"content": "哈哈，有人喜欢就好。至于什么时候再演，我还真说不好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160108
					],
					"speakerTitle": "应公"
				},
				{
					"id": 715160108,
					"content": "本来嘛，演纸映剧给孩子们看算是我的业余爱好。这一出演完了，我就回云翰社去管行头了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160109
					],
					"speakerTitle": "应公"
				},
				{
					"id": 715160109,
					"content": "欸？大叔你是云翰社的人吗？那你一定也会唱璃月戏吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715160110,
					"content": "唱是会唱，常年泡在云翰社里，谁不会哼几句？但要跟我们云老板比还是差远咯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160111
					],
					"speakerTitle": "应公"
				},
				{
					"id": 715160111,
					"content": "我啊，属于幕后忙活的那拨人。戏台上用的枪杆子、大旗、各式各样的戏服、配饰、道具…都归我管。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160112
					],
					"speakerTitle": "应公"
				},
				{
					"id": 715160112,
					"content": "云翰社现在用的行头，一部分是以前留下来的，一部分是我去购置的，还有的是我亲手做的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160113
					],
					"speakerTitle": "应公"
				},
				{
					"id": 715160113,
					"content": "要唱一出全本璃月戏，台上台下忙活的人有一大堆，只有几个演员那肯定不行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160114
					],
					"speakerTitle": "应公"
				},
				{
					"id": 715160114,
					"content": "今年海灯节，云老板给我们几个幕后干活的人放了假，我那几个老朋友又都回老家过节去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160115
					],
					"speakerTitle": "应公"
				},
				{
					"id": 715160115,
					"content": "我一个人没什么事干，就干脆带着家伙物事给大家演纸映剧来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160116
					],
					"speakerTitle": "应公"
				},
				{
					"id": 715160116,
					"content": "不回家吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715160117
					]
				},
				{
					"id": 715160117,
					"content": "哦，我没成家，前年我家老爷子和老娘走了，就剩我一个人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160118,
						715160119
					],
					"speakerTitle": "应公"
				},
				{
					"id": 715160118,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715160120
					]
				},
				{
					"id": 715160120,
					"content": "哎呀，这有什么好对不起的，我不介意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160121
					],
					"speakerTitle": "应公"
				},
				{
					"id": 715160121,
					"content": "我一个人过海灯节也挺快活，你看到了吧，那几个孩子很喜欢我演的纸映剧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160122
					],
					"speakerTitle": "应公"
				},
				{
					"id": 715160122,
					"content": "我们也很喜欢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715160123,
					"content": "别说你们喜欢，我自己也喜欢，否则就不会费那么多功夫做这些纸人纸布景咯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160124
					],
					"speakerTitle": "应公"
				},
				{
					"id": 715160124,
					"content": "故事是大叔自己编写的吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715160125
					]
				},
				{
					"id": 715160125,
					"content": "倒不能这样说，璃月戏也好，纸映剧也好，甚至是茶博士的说书，都提到过「虬髯公」的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160126
					],
					"speakerTitle": "应公"
				},
				{
					"id": 715160126,
					"content": "只要人们需要，只要大家发出呼唤，就会有这样的英雄诞生，去拯救处在危难中的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160127
					],
					"speakerTitle": "应公"
				},
				{
					"id": 715160127,
					"content": "璃月一直都不缺少这种英雄，只要把他们的故事稍加演绎一番，就有了大家喜闻乐见的戏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160128
					],
					"speakerTitle": "应公"
				},
				{
					"id": 715160128,
					"content": "以前也听过很多这样的事情，这算是璃月传统文化的一部分吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715160129,
					"content": "哈哈，这样说也算没错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160130
					],
					"speakerTitle": "应公"
				},
				{
					"id": 715160130,
					"content": "不过呢，虽说总会有英雄在危难的时候出手相助，但平时还是不能总依赖别人，得自己照顾好自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160131
					],
					"speakerTitle": "应公"
				},
				{
					"id": 715160131,
					"content": "#{M#小伙子}{F#小姑娘}，要照顾好自己，海灯节快乐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160132
					],
					"speakerTitle": "应公"
				},
				{
					"id": 715160132,
					"content": "我会的，海灯节快乐！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715160133
					]
				},
				{
					"id": 715160133,
					"content": "海灯节快乐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715160134,
					"content": "有空多来云翰社听戏啊，说不定以后咱们还能见得着。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "应公"
				},
				{
					"id": 715160119,
					"content": "对、对不起！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715160120
					]
				},
				{
					"id": 715160104,
					"content": "不太容易。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715160105
					]
				},
				{
					"id": 715160105,
					"content": "你不是行内人，第一次尝试当然会犯些错误，这是在所难免的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160106
					],
					"speakerTitle": "应公"
				}
			]
		}
	]
}