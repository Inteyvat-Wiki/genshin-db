			"dialogs": [
				{
					"id": 200130201,
					"content": "原来是旅行者，实在是太感谢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130202
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 200130202,
					"content": "你能再帮我一个小忙吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130203
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 200130203,
					"content": "这个路障竖在这里，把我的冒险之路给截断了…。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130204
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 200130204,
					"content": "你能帮我把这个路障清理掉吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130205,
						200130206
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 200130205,
					"content": "没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200130207
					]
				},
				{
					"id": 200130207,
					"content": "唉，要是能像你一样，我早就成为个伟大的冒险家了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "杰克"
				},
				{
					"id": 200130206,
					"content": "还有别的事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200130208
					]
				},
				{
					"id": 200130208,
					"content": "别啊，我伟大的冒险之旅可不能终结在此，拜托你帮帮我吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "杰克"
				}
			]
		},
		{
			"id": 2001303,
