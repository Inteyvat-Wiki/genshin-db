			},
			"dialogs": [
				{
					"id": 200130301,
					"content": "太感谢你了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130302
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 200130302,
					"content": "我本来是想去斯坦利先生冒险过的地方看看，但是没想到半路上遇见了这群家伙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130303
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 200130303,
					"content": "我的实力还是太弱了，假如是斯坦利先生，肯定能把这群家伙全部消灭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130304
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 200130304,
					"content": "要是你愿意和我一起去冒险…还是算了，不能事事都依靠别人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130305
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 200130305,
					"content": "我要接着往前走了，这个给你，我在路上摘了好多做干粮…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130306
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 200130306,
					"content": "不过，这也不能叫「干粮」，对吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "杰克"
				}
			]
		}
