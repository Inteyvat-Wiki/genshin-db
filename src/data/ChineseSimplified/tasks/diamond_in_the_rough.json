			"trigger": {
				"objectNames": [
					"石头"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223050101,
					"content": "客官，哎，客官！您要不要来块石头，试试手气？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050102,
						223050104,
						223050108
					],
					"speakerTitle": "石头"
				},
				{
					"id": 223050102,
					"content": "来一块试试。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223050103
					]
				},
				{
					"id": 223050103,
					"content": "好嘞！客官，我看您今天气色不错，看上去就要赚钱哪，哈哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050116
					],
					"speakerTitle": "石头"
				},
				{
					"id": 223050116,
					"content": "客官，您这边上眼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "石头"
				},
				{
					"id": 223050104,
					"content": "什么石头？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223050105
					]
				},
				{
					"id": 223050105,
					"content": "当然是我店里这些上好的璞石。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050106
					],
					"speakerTitle": "石头"
				},
				{
					"id": 223050106,
					"content": "只要开石后能出玉，我就付给您摩拉，当然，如果什么也没有，那自然也没有摩拉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050107
					],
					"speakerTitle": "石头"
				},
				{
					"id": 223050107,
					"content": "客官，您自己来一块石头玩玩，就什么都明白了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050102,
						22305108
					],
					"speakerTitle": "石头"
				},
				{
					"id": 223050108,
					"content": "这些石头从哪来？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223050109
					]
				},
				{
					"id": 223050109,
					"content": "我们店里这些璞石，个个那都是从「层岩巨渊」里凿出来的顶尖货…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050110
					],
					"speakerTitle": "石头"
				},
				{
					"id": 223050110,
					"content": "嘿嘿，您别不信，我们「解翠行」做了好几辈的玉器生意。看石头的眼光，那是独一无二！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050111
					],
					"speakerTitle": "石头"
				},
				{
					"id": 223050111,
					"content": "嗨，不过这些风光都是原来，现在…总务司不是把「层岩巨渊」给封了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050112
					],
					"speakerTitle": "石头"
				},
				{
					"id": 223050112,
					"content": "这原料地一封，卖一块石头少一块，这么一来二去，这些石头反而比做好的玉器更值钱了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050113
					],
					"speakerTitle": "石头"
				},
				{
					"id": 223050113,
					"content": "我一想，那不如直接把店里的璞石拿来卖算了，不仅省了道工序，开石的时候，还有股刺激感，嘿嘿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050114
					],
					"speakerTitle": "石头"
				},
				{
					"id": 223050114,
					"content": "客官，您来一块石头玩玩，自己体验体验吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050115
					],
					"speakerTitle": "石头"
				},
				{
					"id": 223050115,
					"content": "来一块试试。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223050116
					]
				}
			]
		},
