					"nextDialogs": [
						223050302
					]
				},
				{
					"id": 223050302,
					"content": "您这还挺谨慎的哈…也行，您看那边，选一块吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050303
					],
					"speakerTitle": "石头"
				},
				{
					"id": 223050303,
					"content": "您可看仔细了，200摩拉呢，好歹也是钱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050304
					],
					"speakerTitle": "石头"
				},
				{
					"id": 223050304,
					"content": "看上哪一块您和我说，我来把璞石给开了。",
					"roleType": "TALK_ROLE_NPC",
