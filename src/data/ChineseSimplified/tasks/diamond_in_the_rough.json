						223050502
					]
				},
				{
					"id": 223050502,
					"content": "好！大气，瞧您这风姿仪态，那是要赚大钱！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050503
					],
					"speakerTitle": "石头"
				},
				{
					"id": 223050503,
					"content": "您这边请，这几块璞石您上眼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050504
					],
					"speakerTitle": "石头"
				},
				{
					"id": 223050504,
					"content": "您慢慢看，这可都是上好的璞石，绝不会亏了您的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050505
					],
					"speakerTitle": "石头"
				},
				{
					"id": 223050505,
					"content": "挑好了您和我说，我来开石，不劳您动手。",
