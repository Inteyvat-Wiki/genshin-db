				},
				{
					"id": 223050403,
					"content": "您来这边。这几块璞石，您自己挑一块。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050404
					],
					"speakerTitle": "石头"
				},
				{
					"id": 223050404,
