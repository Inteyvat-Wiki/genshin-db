			"trigger": {
				"objectNames": [
					"阿芷"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718230201,
					"content": "唔，药材还是有点不够了呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230202
					],
					"speakerTitle": "阿芷"
				},
				{
					"id": 718230202,
					"content": "你要去采药吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718230203
					]
				},
				{
					"id": 718230203,
					"content": "嗯，我正准备再去采点药呢。每年的这几天，我都会特意多准备一些药。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230204
					],
					"speakerTitle": "阿芷"
				},
				{
					"id": 718230204,
					"content": "也不是什么很厉害的药…只是一些治疗伤寒，或者帮助消化的药。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230205
					],
					"speakerTitle": "阿芷"
				},
				{
					"id": 718230205,
					"content": "为什么不直接去不卜庐抓药？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718230206
					]
				},
				{
					"id": 718230206,
					"content": "因为不卜庐离这里很远啊，从这里去璃月港可要走很长时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230207
					],
					"speakerTitle": "阿芷"
				},
				{
					"id": 718230207,
					"content": "而且轻策庄里也都是老人小孩居多，可不比你这样的冒险家，他们可走不动那么远的路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230208
					],
					"speakerTitle": "阿芷"
				},
				{
					"id": 718230208,
					"content": "所以，我才会提前预备着这些药来治疗一些小毛病。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230209
					],
					"speakerTitle": "阿芷"
				},
				{
					"id": 718230209,
					"content": "不过，如果真是那种很严重的病，需要正经的药方，那也只能去不卜庐了…唉，希望不会发生这种事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230210
					],
					"speakerTitle": "阿芷"
				},
				{
					"id": 718230210,
					"content": "先不和你们聊了，我还要去采药呢，等会采完了还得拿回去处理一下才行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230211
					],
					"speakerTitle": "阿芷"
				},
				{
					"id": 718230211,
					"content": "我来帮忙吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718230212
					]
				},
				{
					"id": 718230212,
					"content": "咦？你愿意帮忙吗？那太好了，我正发愁一个人要采到什么时候呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230213
					],
					"speakerTitle": "阿芷"
				},
				{
					"id": 718230213,
					"content": "我看看啊…我还需要三味药材…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230214
					],
					"speakerTitle": "阿芷"
				},
				{
					"id": 718230214,
					"content": "嗯…一味是生长在山顶上的清心，用来养气消食最好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230215
					],
					"speakerTitle": "阿芷"
				},
				{
					"id": 718230215,
					"content": "另外一味是生长在河滩上的新鲜嘟嘟莲，入药后可以祛湿散淤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230216
					],
					"speakerTitle": "阿芷"
				},
				{
					"id": 718230216,
					"content": "在那边河滩上生长的嘟嘟莲质量最好，我一般只在那里采需要入药的嘟嘟莲，其他地方生长的嘟嘟莲，药效会差很多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230217
					],
					"speakerTitle": "阿芷"
				},
				{
					"id": 718230217,
					"content": "最后一味是旁边水塘里的莲蓬，入药后可以用来强心安神，不过采摘的时间有些讲究，要在午夜时分至清晨六点之间采摘为好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿芷"
				}
			]
		},
		{
			"id": 7182307,
