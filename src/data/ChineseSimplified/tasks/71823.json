			},
			"dialogs": [
				{
					"id": 718230801,
					"content": "这样就可以了，我们把莲蓬带回去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
