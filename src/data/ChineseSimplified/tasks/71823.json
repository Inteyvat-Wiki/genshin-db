			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿芷"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718230901,
					"content": "你回来啦，药材都采到了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230902
					],
					"speakerTitle": "阿芷"
				},
				{
					"id": 718230902,
					"content": "都采到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718230903
					]
				},
				{
					"id": 718230903,
					"content": "谢谢你帮忙，我也请了小白来帮我处理药材，我们去磨坊那边，把这几份药材也送过去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿芷"
				}
			]
		},
		{
			"id": 7182310,
			"completionStepIds": [
				7182310
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182310",
							"2"
						],
						"stepId": 7182310,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"小白"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718231001,
					"content": "…唔，这些药材我就一起处理了吧，处理好了之后，你也能快点拿去做药了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231002
					],
					"speakerTitle": "小白"
				},
				{
					"id": 718231002,
					"content": "嗯，谢谢你啦，我得再想想办法把药做得甜一些，不然那些孩子肯定又不肯吃了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231003
					],
					"speakerTitle": "阿芷"
				},
				{
					"id": 718231003,
					"content": "你们每年这时候都这么忙吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718231004
					]
				},
				{
					"id": 718231004,
					"content": "嗯…差不多吧，毕竟轻策庄里的年轻人实在没多少，那些能帮忙的事，我们还是尽量帮忙比较好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231005
					],
					"speakerTitle": "小白"
				},
				{
					"id": 718231005,
					"content": "其实每年也就忙这么几天，没什么关系的，而且今年有你帮忙，我们也轻松了不少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231006
					],
					"speakerTitle": "阿芷"
				},
				{
					"id": 718231006,
					"content": "之前几年，我每次采药都要花很多天，更别提做药了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231007
					],
					"speakerTitle": "阿芷"
				},
				{
					"id": 718231007,
					"content": "好啦，谢谢你们帮忙，我们也要快点把药材处理好，然后去准备霄灯了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231008
					],
					"speakerTitle": "阿芷"
				},
				{
					"id": 718231008,
					"content": "去年我就差点忘了放霄灯，今年可不能忘了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231009
					],
					"speakerTitle": "阿芷"
				},
				{
					"id": 718231009,
					"content": "你想许什么愿望？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718231010
					]
				},
				{
					"id": 718231010,
					"content": "唔…轻策庄里的人都身体健康？嘿嘿，差不多是类似的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231011
					],
					"speakerTitle": "阿芷"
				},
				{
					"id": 718231011,
					"content": "不过，愿望说出来就不灵了，就不说给你听了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231012
					],
					"speakerTitle": "阿芷"
				},
				{
					"id": 718231012,
					"content": "这些东西给你，今天谢谢你帮忙啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿芷"
				}
			]
		},
