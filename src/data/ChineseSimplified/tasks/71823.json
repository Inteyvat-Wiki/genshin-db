			"dialogs": [
				{
					"id": 718230701,
					"content": "等一下，现在采莲蓬的时间好像不太对呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230702
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 718230702,
					"content": "我想想…阿芷小姐让我们午夜时分至清晨六点采莲蓬来着，现在的时间不太对呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7182308,
			"completionStepIds": [
				7182306,
				7182308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
