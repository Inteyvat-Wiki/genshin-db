				"points": []
			},
			"dialogs": [
				{
					"id": 205060101,
					"content": "你好，我是炼金术的研究者蒂玛乌斯，欢迎来到蒙德城。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060102
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 205060102,
					"content": "炼金术？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060103
					]
				},
				{
					"id": 205060103,
					"content": "这是一种从古代流传下来的技术，目前我们还对它了解甚少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060104
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 205060104,
					"content": "它的规则神秘而奇妙，和我们所知的创造物体的原理完全不同。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060105
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 205060105,
					"content": "要是能掌握这门技术，我们应该就能造出很不得了的东西了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060106
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 205060106,
					"content": "这边的这个就是炼金术用的台子吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 205060107,
					"content": "没错。对了，要不亲自使用一下炼金术试试？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060108,
						205060109
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 205060108,
					"content": "听上去很复杂，没问题吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060110
					]
				},
				{
					"id": 205060110,
					"content": "没事的，至少操作上并不复杂。你有兴趣的话我可以教你最基础的部分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060111
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 205060111,
					"content": "炼金合成",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 205060109,
					"content": "会爆炸吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060110
					]
				}
			]
		},
		{
			"id": 2050602,
			"completionStepIds": [
				2050602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
