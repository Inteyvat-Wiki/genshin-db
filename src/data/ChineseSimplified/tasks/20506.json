						"stepId": 2050602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"蒂玛乌斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205060201,
					"content": "好神奇啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 205060202,
					"content": "我们现在所使用的炼金术，都还只是在模仿古代人留下来的方法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060203
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 205060203,
					"content": "会使用风之翼的人是不需要知道它是怎么制作出来的，炼金术也是一个道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060204
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 205060204,
					"content": "但每当我觉得好像摸到了一点原理，它又马上会让人出乎意料，唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060205,
						205060207
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 205060205,
					"content": "炼金术还能用来干什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060206
					]
				},
				{
					"id": 205060206,
					"content": "说实话我也不知道，但就是不知道才引人好奇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060210
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 205060210,
					"content": "有很多神奇的配方我也还在研究。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060211
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 205060211,
					"content": "在你冒险的途中，应该能见到一些古代文明留下的关于炼金术的记录。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060212
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 205060212,
					"content": "随着你「冒险等阶」的提高，你掌握的配方也会更多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060213,
						205060215
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 205060213,
					"content": "谢谢你的解释。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060214
					]
				},
				{
					"id": 205060214,
					"content": "不用谢，也别忘了跟我分享你的见识与成果哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060218
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 205060218,
					"content": "那么，我们回头见。祝你们的前路永远有风吹拂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 205060215,
					"content": "到那时就能造派蒙了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060216
					]
				},
				{
					"id": 205060216,
					"content": "还在考虑这件事，我是哪里让你不满意了吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 205060217,
					"content": "哈哈，你们两位是很有趣的人啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060218
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 205060207,
					"content": "能造出派蒙吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060208
					]
				},
				{
					"id": 205060208,
					"content": "有一个我还不够吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 205060209,
					"content": "哈哈哈，很可惜现在还不行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060210
					],
					"speakerTitle": "蒂玛乌斯"
				}
			]
		}
	]
}