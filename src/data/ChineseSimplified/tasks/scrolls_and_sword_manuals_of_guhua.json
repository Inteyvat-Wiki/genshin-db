			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 711080301,
					"content": "「…修习刺明之法。木人不慎尽毁…无钱资…自思一良策，何不束草为人…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080302
					],
					"speakerTitle": "《古华手记》"
				},
				{
					"id": 711080302,
					"content": "「收揽稻草。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080303
					],
					"speakerTitle": "《古华手记》"
				},
				{
					"id": 711080303,
					"content": "「束草。甚疲。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080304
					],
					"speakerTitle": "《古华手记》"
				},
				{
					"id": 711080304,
					"content": "「…修习刺明之法。草人不慎尽毁…不妨先习剑。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080305,
						711080306
					],
					"speakerTitle": "《古华手记》"
				},
				{
					"id": 711080305,
					"content": "继续阅读。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711080307
					]
				},
				{
					"id": 711080307,
					"content": "「…无事。闲坐庭前观雨，腹中稍饥…思悟前日所见，忽得启感，若以剑…（模糊不清）自名『裁雨』，改日当试。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080308
					],
					"speakerTitle": "《古华手记》"
				},
				{
					"id": 711080308,
					"content": "「…修习裁雨之法，不慎跌坠，所幸伤不甚重…自思一良策，不妨凿地浚池于桩下，既可使不复跌伤，又可养鱼以为食…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080309
					],
					"speakerTitle": "《古华手记》"
				},
				{
					"id": 711080309,
					"content": "「…往见渔者，市数十鱼…试烹之，甚肥美，众鱼莫可与比…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080310
					],
					"speakerTitle": "《古华手记》"
				},
				{
					"id": 711080310,
					"content": "（此后十余页均为鱼肉的各种烹饪方法，记载无比详细，有些甚至还搭配了插图。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080311
					],
					"speakerTitle": "《古华手记》"
				},
				{
					"id": 711080311,
					"content": "「…修习裁雨之法，不慎跌坠。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080312
					],
					"speakerTitle": "《古华手记》"
				},
				{
					"id": 711080312,
					"content": "「…成。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080313,
						711080314
					],
					"speakerTitle": "《古华手记》"
				},
				{
					"id": 711080313,
					"content": "继续阅读。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711080315
					]
				},
				{
					"id": 711080315,
					"content": "「…使枪剑当如使（模糊不清，旁有第三代掌门批注：当如使指）…所止，即是妙理之相…然彼无…何以予之？何以告之？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080316
					],
					"speakerTitle": "《古华手记》"
				},
				{
					"id": 711080316,
					"content": "「…改修藏书阁。设…于内，待…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080317
					],
					"speakerTitle": "《古华手记》"
				},
				{
					"id": 711080317,
					"content": "「…以<color=#00E1FFFF>目</color>视之，使<color=#00E1FFFF>四方之卷</color>合于<color=#00E1FFFF>四方之阁</color>，便可…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080318
					],
					"speakerTitle": "《古华手记》"
				},
				{
					"id": 711080318,
					"content": "（此后数页均被涂抹，无法阅读。旁有第三代掌门批注：此为劝诫后世之人博览四方书卷。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080319,
						711080320
					],
					"speakerTitle": "《古华手记》"
				},
				{
					"id": 711080319,
					"content": "继续阅读。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711080321
					]
				},
				{
					"id": 711080321,
					"content": "「…伤愈。白小三烹羊脍鲤来见。肥美无膻。遂问其术…传以生克之法…于此记之。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080322
					],
					"speakerTitle": "《古华手记》"
				},
				{
					"id": 711080322,
					"content": "（此后数页详细记录了羊肉的各种烹饪方法。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "《古华手记》"
				},
				{
					"id": 711080320,
					"content": "不读了，涂得乱七八糟的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 711080314,
					"content": "不读了，完全没写练习过程…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 711080306,
					"content": "不读了，什么乱七八糟的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
