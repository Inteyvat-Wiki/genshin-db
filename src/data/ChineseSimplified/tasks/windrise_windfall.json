					"speakerTitle": "埃泽"
				},
				{
					"id": 207431002,
					"content": "旅行者，如果你看见迪卢克老爷了，能帮我给他说说吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207431003
					],
					"speakerTitle": "埃泽"
				},
				{
					"id": 207431003,
					"content": "他老这么不管酒庄的生意，也不是个事啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "埃泽"
				}
			]
		},
