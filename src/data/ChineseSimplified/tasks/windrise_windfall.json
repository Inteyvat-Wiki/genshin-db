			"dialogs": [
				{
					"id": 207432001,
					"content": "您已经把商路清理完了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207432002
					],
					"speakerTitle": "埃泽"
				},
				{
					"id": 207432002,
					"content": "已经清理完了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207432003
					]
				},
				{
					"id": 207432003,
					"content": "太好了，这样酒庄的生意也能慢慢恢复了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207432004
					],
					"speakerTitle": "埃泽"
				},
				{
					"id": 207432004,
					"content": "其实这件事，我应该先向迪卢克老爷报告的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207432005
					],
					"speakerTitle": "埃泽"
				},
				{
					"id": 207432005,
					"content": "但是迪卢克老爷又不见了，我问遍了酒庄上下，没有一个人知道迪卢克老爷去哪了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207432006
					],
					"speakerTitle": "埃泽"
				},
				{
					"id": 207432006,
					"content": "爱德琳还是说什么「迪卢克老爷去办自己的私事去了」，其余的一句也不肯说，一点也没有担心的样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207432007
					],
					"speakerTitle": "埃泽"
				},
				{
					"id": 207432007,
					"content": "唉，算了。等迪卢克老爷回来了，我一定要和他好好谈谈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "埃泽"
				}
			]
		}
