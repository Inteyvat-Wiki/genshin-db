					}
				]
			},
			"dialogs": [
				{
					"id": 711140401,
					"content": "…这么调整应该没问题了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140402
					],
					"speakerTitle": "斡流"
				},
				{
					"id": 711140402,
					"content": "旅行者，你们把仪器都安置好了？真是太感谢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140403
					],
					"speakerTitle": "斡流"
				},
				{
					"id": 711140403,
					"content": "等我把这台仪器也安置好，就把报酬结给你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140404
					],
					"speakerTitle": "斡流"
				},
				{
					"id": 711140404,
					"content": "刚才直接让我一起安置就好啦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140405
					]
				},
				{
					"id": 711140405,
					"content": "多谢你的好意。不过，这台仪器有些特殊，需要调试的地方有些多，要是你来操作的话，实在太麻烦你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140406
					],
					"speakerTitle": "斡流"
				},
				{
					"id": 711140406,
					"content": "我们先去那边的悬崖上把这台仪器安置好，然后我就可以和你们结清报酬了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140407
					],
					"speakerTitle": "斡流"
				},
				{
					"id": 711140407,
					"content": "听起来好复杂…你一直都这样工作的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711140408,
					"content": "现在我只用把仪器安置在陆地上…在有一次考察里，我还不得不想办法把仪器浸到一条大江的中央呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140409
					],
					"speakerTitle": "斡流"
				},
				{
					"id": 711140409,
					"content": "不能直接坐船过去吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140410
					]
				},
				{
					"id": 711140410,
					"content": "唉，如果只用把仪器沉进江水里，那我当然可以坐着船，过去把仪器丢进水里，然后就离开…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140411
					],
					"speakerTitle": "斡流"
				},
				{
					"id": 711140411,
					"content": "但那次考察我要勘测的是水流强度，所以必须把勘测用的特型仪器持续置于水流的中央，不能浮到顶，也不能沉到底…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140412
					],
					"speakerTitle": "斡流"
				},
				{
					"id": 711140412,
					"content": "还好那条河上面有一座吊桥，要是没吊桥的话，我就只能求人在两座山之间拉一条绳索…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140413
					],
					"speakerTitle": "斡流"
				},
				{
					"id": 711140413,
					"content": "再把这台仪器用绳索吊起来，用另一条绳索拉着，一直送到河流中心再放下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140414
					],
					"speakerTitle": "斡流"
				},
				{
					"id": 711140414,
					"content": "咳…先不说这些了，现在我们也不用处理这种情况…虽然我们等会也要路过一座吊桥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140415
					],
					"speakerTitle": "斡流"
				},
				{
					"id": 711140415,
					"content": "这边走吧，那座吊桥离我们不远。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "斡流"
				}
			]
		},
