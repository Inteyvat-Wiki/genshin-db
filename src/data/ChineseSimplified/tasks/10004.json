			"dialogs": [
				{
					"id": 100040101,
					"content": "莫娜莫娜，我们来给你送东西来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100040102,
					"content": "#是派蒙和{NICKNAME}啊，看起来挺精神的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040103
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 100040103,
					"content": "要送我什么？如果是那种简单又来钱快的工作委托就最好不过了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040104
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 100040104,
					"content": "好像是，你老师给你的「课题」来着。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100040105,
					"content": "那种东西根本不想要！不对，似乎也不能这么说。人还是应该保留进取心的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040106
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 100040106,
					"content": "不过我觉得多半是什么折腾人的东西。我太懂老太婆了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040107
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 100040107,
					"content": "不论怎么样，你先看看？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100040108,
					"content": "这本书…好像也没什么特殊的地方啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040109
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 100040109,
					"content": "啊，掉下来几封信。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040110
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 100040110,
					"content": "是和解信吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100040111,
					"content": "有三封标记了序号的信。嗯，先拆第一封吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040112
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 100040112,
					"content": "如果这个是课题的话，那应该没什么见不得人的内容。一起看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040113
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 100040113,
					"content": "「许久没见到你，腿脚都日渐不便了…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040114
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 100040114,
					"content": "哼，想打感情牌。至少再多点真情实感吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040115
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 100040115,
					"content": "「以前追着你打，你一边跑一边还用水元素虚影吸引我注意力的情景还历历在目。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040116
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 100040116,
					"content": "「如今你不在了，我整天就躺在摇椅上。现在确实是缺乏运动。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040117
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 100040117,
					"content": "老——太——婆——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040118
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 100040118,
					"content": "要不咱们还是别看了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100040119
					]
				},
				{
					"id": 100040119,
					"content": "「闲话不说了。你想要知道怎么测算王国甚至是世界的命运吗？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040120
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 100040120,
					"content": "「前去须弥，去寻找地底王国的大门吧。在那里打开第二封信。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040121
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 100040121,
					"content": "看来老太婆的理论框架又进一步完善了，这是要教我看家本领了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040122
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 100040122,
					"content": "她还真的是老了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040123
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 100040123,
					"content": "你们师徒感情好奇怪啊。谈感情就吵架，谈学术就伤感…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100040124,
					"content": "不过这个位于须弥的地下王国大门…难道是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100040125,
					"content": "怎么，你们有什么线索吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040126
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 100040126,
					"content": "我们应该知道你老师说的地方是哪里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100040127,
					"content": "那太好了，这下省去了我调查的时间。相当于间接省去了导游费、食宿费，这可是一笔巨款。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040128
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 100040128,
					"content": "我可一刻都等不了了。我们快出发吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040129
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 100040129,
					"content": "你刚才没有提到交通费，难道是说？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100040130,
					"content": "没错，就是用老办法。一起走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莫娜"
				}
			]
		},
