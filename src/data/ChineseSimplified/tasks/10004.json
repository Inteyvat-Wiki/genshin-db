			"dialogs": [
				{
					"id": 100040601,
					"content": "呼，总算是解决了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100040602,
					"content": "老太婆倒是提到了，结束之后打开第三封信。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040603
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 100040603,
					"content": "但是我没有成功，要不要打开呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040604
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 100040604,
					"content": "我感觉我已经理解你们师徒相处的脑回路了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100040605,
					"content": "你看，她只说结束，没有说成功结束。所以我觉得可以打开。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100040606,
					"content": "确实。我感觉老太婆应该没写什么好话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040607
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 100040607,
					"content": "「如果你看到这句话，说明你真的尝试了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040608
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 100040608,
					"content": "「不是，你真敢尝试打开啊？哈哈哈哈哈哈。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040609
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 100040609,
					"content": "老——太——婆——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040610
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 100040610,
					"content": "「坎瑞亚因为存在过许多星海之湖，所以空间上相对不稳定，故非物理穿透天盖障更容易成功。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040611
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 100040611,
					"content": "「而且那里保密性比较好，加之位于人迹罕至的地底。如果失败了，不良影响传播比较小。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040612
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 100040612,
					"content": "「作为我的徒弟，我相信你还是能处理在虚假之天外界游弋的深渊生物的。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040613
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 100040613,
					"content": "「打不过你肯定跑得掉吧。你跑路本事这么不错。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040614
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 100040614,
					"content": "「唉，我真是天才啊。水占术氛围上对应了缓解『渴』的智慧。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040615
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 100040615,
					"content": "「实际应用上水占盘也减小了虚假之天的扰动。真不知道艾莉丝拿什么赢我——」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040616
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 100040616,
					"content": "莫娜说不用看了，后面几千字都是老太婆的自吹。\\n\\n在整理好观测结果后，大家回到了蒙德。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		}
	]
