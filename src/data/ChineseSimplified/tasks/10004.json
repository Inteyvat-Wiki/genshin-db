							452.578,
							52.995,
							6035.06
						],
						"pointId": 6
					}
				]
			},
			"dialogs": [
				{
					"id": 100040201,
					"content": "呼，用这种充满夏日回忆的方法过来，人都清爽了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100040202,
					"content": "这里就是地下古国——坎瑞亚的大门吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040203
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 100040203,
					"content": "背后一定有着许多秘密和悲伤吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040204
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 100040204,
					"content": "我们来看看第二封信吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100040205,
					"content": "嗯嗯，我看看。标记序号二的信封…啊，是这个。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040206
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 100040206,
					"content": "「须弥有古语：解经诵卷非见道，终须智水解干慧。这片土地上有一种现象叫做『焚真之天象』。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040207
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 100040207,
					"content": "「然而『焚真之天象』只是因为对真理过于苦渴，最终燃烧了起来。叫它『渴真』或许更贴合本质。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040208
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 100040208,
					"content": "「地下古国的记载里说，坎瑞亚的几大地底镜湖都倒映着真实宇宙星海。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040209
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 100040209,
					"content": "「这正是因为水开启的『渴真天象』越过了虚假之天，联系着外部宇宙。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040210
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 100040210,
					"content": "居然是这样！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040211
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 100040211,
					"content": "「只有穿透虚假之天，宇宙星体的引力与影响才能被观测。只有拥有这些世界外的参数，才能推算世界命运。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040212
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 100040212,
					"content": "「现在，我给你的课题就是：在坎瑞亚的大门前，打开一次『渴真天象』。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040213
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 100040213,
					"content": "后面就是老太婆推算出来的仪式和方法了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040214
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 100040214,
					"content": "确实呢。这些行星轨迹和符文我就完全看不懂了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100040215,
					"content": "莫娜现在就要试试吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100040216,
					"content": "虽然不想承认，但是我脑袋里快速演算了一下老太婆开发的仪式参数，似乎真的可行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040217
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 100040217,
					"content": "现在我情绪激动，斗志昂扬。而且就这样回去又是一天住宿费。此时不做，更待何时。我要开始了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040218
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 100040218,
					"content": "连达一切恒星的使者、君临黄赤的漫游者们，以及天上光辉的众兄啊——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040219
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 100040219,
					"content": "空虚之洞，弯折的路径。我，阿斯托洛吉斯·莫娜·梅姬斯图斯，于此以水调配平衡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040220
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 100040220,
					"content": "以智慧、以真理缓解苦渴。我，阿斯托洛吉斯·莫娜·梅姬斯图斯，命那群星现前。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040221
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 100040221,
					"content": "成、成功了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100040222,
					"content": "呜啊，怎么冒出来了这么多怪物！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100040223,
					"content": "看样子没完全成功。就结果而言只打开了一瞬间，然后这些怪物就穿越「渴真天象」过来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040224
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 100040224,
					"content": "啊啊，真生气。真实星空一眼都没看上，就拿你们撒气好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莫娜"
				}
			]
		},
