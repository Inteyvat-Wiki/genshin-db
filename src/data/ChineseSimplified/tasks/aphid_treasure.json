					},
					{
						"sceneId": 3,
						"position": [
							-1372.812,
							169.291,
							7665.692
						],
						"pointId": 350400242
					},
					{
						"sceneId": 3,
						"position": [
							-1373.609,
							169.233,
							7665.231
						],
						"pointId": 350400243
					}
				]
			},
			"dialogs": [
				{
					"id": 755050101,
					"content": "是希诺宁！你居然在这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755050102,
					"content": "嗨，是派蒙和旅行者啊。怎么？在家门口见到我很奇怪吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050103
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755050103,
					"content": "不是啦，因为刚刚解决了那么大的问题，我以为你会找一棵漂亮的树，使劲躺个几天呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755050104,
					"content": "哈哈，我倒是那么想过，但这时候大家还忙着重建工作呢。这时候偷懒可不太像话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050105
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755050105,
					"content": "所以你在这干活吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050106
					]
				},
				{
					"id": 755050106,
					"content": "喏，给你们看个东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050107
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755050107,
					"content": "哇！好漂亮的宝石！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050108,
						755050110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755050108,
					"content": "看起来很珍贵。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050109
					]
				},
				{
					"id": 755050109,
					"content": "确实，但不止这样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050112
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755050112,
					"content": "这是最近才开始在市场流通的异纹燃素蜜珠。燃素蜜珠原本只是燃素蜜虫产的小玩意，那些很常见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050113
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755050113,
					"content": "但这种异纹的燃素蜜珠却很新奇，数量也不多，所以价格不菲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050114
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755050114,
					"content": "这个我懂…我们在野外找宝箱的时候，也喜欢那种花纹看起来很厉害的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755050115,
					"content": "呵呵，所以我也稍微买了几枚回来收藏，结果没过几天，我养在旁边的盆栽却枯萎了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050116
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755050116,
					"content": "开始我没在意，我本来就搞不懂怎么养绿植。可后来我听卡齐娜说，族里一些人生了病。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050117
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755050117,
					"content": "病人大多是夏温宝石店的顾客，老板夏温自己也不例外…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050118
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755050118,
					"content": "啊？这样想的话…难道和这颗宝石有关？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755050119,
					"content": "我也这么猜测，所以我砸碎了一颗蜜珠，发现里面居然包裹着一些深渊能量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050120
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755050120,
					"content": "这些深渊能量的浓度非常低，又被蜜珠外壳隔绝，所以几乎察觉不到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050121
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755050121,
					"content": "那病人现在怎么样了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050122
					]
				},
				{
					"id": 755050122,
					"content": "安心，因为浓度实在不高，所以大家的病情普遍不严重，多是一些嗜睡、易疲劳的症状。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050123
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755050123,
					"content": "像我和卡齐娜这样身体素质稍好的，完全没影响。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050124
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755050124,
					"content": "噢…还好是史级危险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755050125,
					"content": "史级？史诗级？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050126
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755050126,
					"content": "我猜是史莱姆级。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050127
					]
				},
				{
					"id": 755050127,
					"content": "嘿嘿，还是你懂我。就是像史莱姆那样只能威胁到普通人的等级。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755050128,
					"content": "哈哈，你们两个，真有默契。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050129
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755050129,
					"content": "话说回来，我们也遇到过不少被史莱姆吓到瑟瑟发抖的人，所以这种危险也不能放着不管吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755050130,
					"content": "不错，我已经向首领说明情况，请他把市场上的异纹蜜珠收集起来集中销毁了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050131
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755050131,
					"content": "还有源头也得处理干净。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050132
					]
				},
				{
					"id": 755050132,
					"content": "我和你的想法一样。前面说过，燃素蜜珠是燃素蜜虫产的东西，所以我猜测问题的源头就在它们身上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050133
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755050133,
					"content": "我去找了基尼奇，他在调查这方面比较在行。昨天他传来消息，确实发现了被深渊污染的蜜虫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050134
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755050134,
					"content": "除了这里，「悬木人」和「流泉之众」附近也有它们的踪迹。嗯，他也顺便通知了玛拉妮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050135
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755050135,
					"content": "不过他们的族人对宝石不怎么热衷，所以影响更小。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050136
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755050136,
					"content": "原来是这样…看来深渊带来的衍生问题还没有都解决，要耐心处理才行呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050137
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755050137,
					"content": "那你们打算怎么处理蜜虫？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050138
					]
				},
				{
					"id": 755050138,
					"content": "先把它们捉起来，这种程度的深渊污染我们有办法净化，不至于伤及蜜虫的性命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050139
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755050139,
					"content": "基尼奇标记了蜜虫集中出现的地方，我现在正打算去部族附近的那一处。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050140
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755050140,
					"content": "话说，你们有没有兴趣一起来？捉蜜虫，还挺有意思的对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050141
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755050141,
					"content": "我本来想叫上卡齐娜，可惜她还有别的活要忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050142,
						755050146,
						755050148
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755050142,
					"content": "你就是想偷懒吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050143
					]
				},
				{
					"id": 755050143,
					"content": "哪里的话，我可不打算躺在树上旁观，我会和你们一起干活的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050144
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755050144,
					"content": "开玩笑的，我们出发吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050145
					]
				},
				{
					"id": 755050145,
					"content": "很高兴你们愿意来，这样我就不会很无聊了。我们出发吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755050146,
					"content": "乐意奉陪。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050147
					]
				},
				{
					"id": 755050147,
					"content": "很高兴你们愿意来，这样我就不会很无聊了。我们出发吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755050148,
					"content": "感觉不怎么有意思，算了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050149
					]
				},
				{
					"id": 755050149,
					"content": "那我要无聊死了…真的不来吗？我还打算送你们个小玩意呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050150
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755050150,
					"content": "哦！原来还有报酬吗！是什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050151
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755050151,
					"content": "闪闪发光的小玩意，可好看了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050152
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755050152,
					"content": "#哦！是摩拉！{NICKNAME}，我们可别错过赚摩拉的机会呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050153,
						755050155
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755050153,
					"content": "前面是开玩笑，现在出发吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050154
					]
				},
				{
					"id": 755050154,
					"content": "哈哈，那我们走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755050155,
					"content": "看在摩拉的份上，陪你跑一趟吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050156
					]
				},
				{
					"id": 755050156,
					"content": "哈哈，那我们走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755050110,
					"content": "看起来不太对劲。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050111
					]
				},
				{
					"id": 755050111,
					"content": "还是你敏锐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050112
					],
					"speakerTitle": "希诺宁"
				}
			]
		},
