			"trigger": {
				"objectNames": [
					"阿贝多"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412130601,
					"content": "龙的力量…龙的生命力，能让枯死的植物复活到这种地步…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130602
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412130602,
					"content": "不可思议。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130603
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412130603,
					"content": "还以为是一截枯树桩，没想到是这种怪物呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412130604,
					"content": "差一点就被吞下去了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412130605,
					"content": "不过，为什么只有今天发生了这种情况呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412130606,
					"content": "多半是因为剑落到地上遭受了撞击，导致力量外泄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130607
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412130607,
					"content": "我错了，不要赶我走，千万不要赶我走啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130608
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 412130608,
					"content": "我保证绝不乱动！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130609
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 412130609,
					"content": "啊，帕拉德先生…也不用抱着膝盖蹲到地上变成蘑菇呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130610
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130610,
					"content": "唉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130611
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412130611,
					"content": "这棵急冻树会枯死在这种地方，难道是因为它无法吸收被污染过的力量？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130612
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412130612,
					"content": "旅行者能够净化污秽，净化后的纯净元素力不仅能让它复活，甚至强化了它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130613
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412130613,
					"content": "纯粹的生命之力会迫使它不断重生…看来，之后还会有持续不断的战斗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130614,
						412130615
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412130614,
					"content": "发生了比想象中还麻烦的事呀…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130616
					]
				},
				{
					"id": 412130616,
					"content": "我也从没遇到过类似事件。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130617
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412130617,
					"content": "如此罕见的情况，不得不说，也是一种意外收获。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130618
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412130618,
					"content": "砂糖。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130619
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412130619,
					"content": "啊、是！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130620
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130620,
					"content": "看好那个冒险家，把他送回营地去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130621
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412130621,
					"content": "好的先生！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130622
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130622,
					"content": "至于这里，虽然很不好意思…但还是要麻烦你了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130623
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412130623,
					"content": "我会尽力解决它。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130624
					]
				},
				{
					"id": 412130624,
					"content": "预料之外的麻烦事，却只有我们能解决。果然还是因为我们越来越厉害了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412130615,
					"content": "真没想到，是我太厉害了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130616
					]
				}
			]
		}
	]
