				"points": []
			},
			"dialogs": [
				{
					"id": 412130101,
					"content": "阿贝多！我们又——来啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412130102,
					"content": "嗯？阿贝多好像不在？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412130103,
					"content": "是出去调查了吗，还是又去画神秘写生了呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412130104,
					"content": "啊！是你们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130105
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130105,
					"content": "这不是砂糖吗，你怎么在这里？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412130106,
					"content": "我的研究刚告一段落，今天有五小时二十六分左右的空闲时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130107
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130107,
					"content": "所以，就来找你们打听之前委托的事了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130108
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130108,
					"content": "好精确的时间，你是人型钟表吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412130109,
					"content": "不不不，这没什么值得夸奖的，你太客气了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130110
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130110,
					"content": "人家没有在夸你啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412130111,
					"content": "旅行者，我、我可以问吗？之前拜托你去调查阿贝多先生隐瞒的事，进展得还顺利吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130112
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130112,
					"content": "如果我的感官没有出问题，那已经是一个多星期前的事了哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412130113,
					"content": "还以为你已经忘了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130114
					]
				},
				{
					"id": 412130114,
					"content": "什么…！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130115
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130115,
					"content": "一、一个多星期？！我明明…啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130116
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130116,
					"content": "呜，我太沉迷实验，完全忽略了这件事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130117
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130117,
					"content": "该说她的时间观念太强呢，还是太弱呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412130118,
					"content": "所、所以！你已经知道答案了对吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130119,
						412130120
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130119,
					"content": "嗯，可以这么说哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130121
					]
				},
				{
					"id": 412130121,
					"content": "太好了，能说给我听吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130122
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130122,
					"content": "派蒙，你觉得呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130123
					]
				},
				{
					"id": 412130123,
					"content": "唔…告诉她应该不要紧吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412130124,
					"content": "看看也行，只要不是触摸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412130125,
					"content": "等一下，你们在说什么呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130126
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130126,
					"content": "这是…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130127,
						412130128
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130127,
					"content": "这就是阿贝多隐瞒的事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130129
					]
				},
				{
					"id": 412130129,
					"content": "是一把非常厉害的剑哦，不能用手碰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412130130,
					"content": "嗯…这是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130131
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130131,
					"content": "！！这、这是！！我从未见过的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130132
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130132,
					"content": "哼哼，尽情欣赏吧！不知为什么，连我都有一种奇怪的成就感！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412130133,
					"content": "太厉害了，我还是第一次见到这么神奇的武器。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130134
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130134,
					"content": "我能隐约感到有力量在剑的内部徐徐流动…它就像活着的生物一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130135
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130135,
					"content": "这么具体的感觉吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130136
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412130136,
					"content": "也许是我学习过炼金术的缘故吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130137
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130137,
					"content": "我不敢用太绝对的说辞，但确实有「流动」的感觉。虽然这说法很不严谨…本、本来我是不会用的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130138
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130138,
					"content": "请相信我，我平时绝不会用这么模棱两可的说法！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130139
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130139,
					"content": "好好好，知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130140
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412130140,
					"content": "旅行者，请问…你可以使用这把剑战斗吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130141
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130141,
					"content": "我想多了解一些，但我不能使用它，只能拜托你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130142,
						412130143
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130142,
					"content": "偷偷地，别让阿贝多知道哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130144
					]
				},
				{
					"id": 412130144,
					"content": "那就到附近找合适的地点吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412130143,
					"content": "找个不容易被发现的地方比较好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130144
					]
				},
				{
					"id": 412130128,
					"content": "这就是你想知道的答案。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130129
					]
				},
				{
					"id": 412130120,
					"content": "完全调查清楚了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130121
					]
				}
			]
		},
