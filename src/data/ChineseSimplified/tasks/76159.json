				]
			},
			"dialogs": [
				{
					"id": 761590101,
					"content": "这就走掉了？喂，芭比！你是不是还有很多东西没有交给…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590102
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590102,
					"content": "…我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590103,
						761590104
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590103,
					"content": "我们是不是来的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590105
					]
				},
				{
					"id": 761590105,
					"content": "没有，你们来的时间差不多符合芭比对我做出的「预言」…我还以为会再晚点呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590106
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590106,
					"content": "不过，在谈正事之前，你们不如…先吃点东西？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590107,
						761590108
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590107,
					"content": "是、是芭比洛斯女士的预言吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590109
					]
				},
				{
					"id": 761590109,
					"content": "没有啦。只是我的听力比较好，听见了小派蒙的肚子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590110
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590110,
					"content": "（咕噜噜…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761590111,
					"content": "#呜哇！我…我的肚子是替{NICKNAME}响的，我们的肚子都很饿呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590112,
						761590113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761590112,
					"content": "谁知道肉排卖光了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590114
					]
				},
				{
					"id": 761590114,
					"content": "放心吧，魔女可不会让远道而来的客人饿肚子，来，饼干和蛋糕都给你们准备好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590115
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590115,
					"content": "你和派蒙开心地吃起了蛋糕和饼干，也咕咚咕咚地喝了很多茶，但奇怪的是，无论你们怎么吃喝，茶壶却永远都是半满，盘子里也永远盛着一块新的饼干和蛋糕…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						761590116
					]
				},
				{
					"id": 761590116,
					"content": "我…我不能吃了，怎么吃都吃不完，呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590117,
						761590120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761590117,
					"content": "这就是…魔女的茶会吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590118
					]
				},
				{
					"id": 761590118,
					"content": "是啊。开茶会嘛，桌上肯定要有充足的甜点和茶水供应。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590119
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590119,
					"content": "当然，吃太多不利于大家展现魔女的优雅气质，在大多数情况下，茶壶只是半满，盘子里只有一块饼干或一块蛋糕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590123
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590123,
					"content": "不吃了不吃了，我真的饱了…我们还是聊正事吧。嗝…呜哇，不好意思…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761590124,
					"content": "嗯，你们这次来，是为了传达芭比为我预知的「课业」，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590125,
						761590126
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590125,
					"content": "你这不是已经都知道了嘛…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590127
					]
				},
				{
					"id": 761590127,
					"content": "没有，我刚才和芭比在谈另外一件事。她说因为月亮的巨大异动，导致自己的水占术出现了偏差，必须回去静修一段时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590128
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590128,
					"content": "在她静修的期间，就由我来替她看护诸位的「课业」，顺便也帮她把新一轮的「课业」写进辞典里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590129
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590129,
					"content": "欸？这种事情还能临时换负责人的啊？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590130,
						761590131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761590130,
					"content": "不愧是尼可。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590132
					]
				},
				{
					"id": 761590132,
					"content": "我一点也不想办到！但芭比和艾莉丝在告诉我这件事之前，就已经把我的那一份特别「课业」嵌入进辞典里了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590133
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590133,
					"content": "虽然我很想把它给抹去，然后继续悠闲地观测世界…但艾莉丝还要去维护提瓦特的边界，芭比则要去静修水占术…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590134
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590134,
					"content": "欧科塔维亚压根没回来，更别提莱茵多特了…魔女们各有各的事务，也只能暂时由我担起监督「课业」的职责了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590135,
						761590136
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590135,
					"content": "原来魔女会这么忙啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590137
					]
				},
				{
					"id": 761590137,
					"content": "是啊，我都不知道大家有多久没有好好办一场茶会了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590138
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590138,
					"content": "但总而言之，只要我完成那一份特别「课业」，我的故事也就会正式嵌入辞典之内。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590139
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590139,
					"content": "#在那之后，我就能切实地观测和引导大家了…所以，{NICKNAME}，派蒙，把「课业」告诉我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590140
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590140,
					"content": "对了，因为这不算是预言，纯粹是芭比和艾莉丝在十分钟前编出来的故事，所以你们应该在那本辞典里找不到什么有效信息…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590141
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590141,
					"content": "确实欸，我们从那本辞典里看见的，的确不是什么超复杂的「课业」。准确来说就只有两句话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590142,
						761590143,
						761590144
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761590142,
					"content": "「尼可将履行自己的职责。」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590145
					]
				},
				{
					"id": 761590145,
					"content": "好吧。前面的话应该是芭比写的，但后面那一句一定是艾莉丝加的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590146
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590146,
					"content": "那我们就开始履行这次的「课业」吧，让我想想，先去哪里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590147,
						761590148
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590147,
					"content": "等会，你已经弄明白了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590149
					]
				},
				{
					"id": 761590149,
					"content": "刚才芭比已经把我要做的事都顺便告诉我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590150
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590150,
					"content": "——所谓的「履行职责」，就是要我去各个课业的地点看看情况，进行一下「实地考察」嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590151
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590151,
					"content": "等一下！这样也可以吗，完全没有「预言」的感觉了呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590152
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761590152,
					"content": "没有啊，芭比对我说的话，当然也相当于「预言」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590153
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590153,
					"content": "我的这篇「课业」由芭比执笔，她只不过是提前将故事翻到了最后一页，把结尾告诉我而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590154,
						761590156
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590154,
					"content": "听着完全就是剧透啊！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590155
					]
				},
				{
					"id": 761590155,
					"content": "哎呀，预言和剧透本来就没什么区别啦，走吧走吧，跟着我，我们先去…唔，先去这里应该不要紧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590159
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590159,
					"content": "咦？现在就去？等一下，我们要怎么去啊——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590160
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761590160,
					"content": "只是一眨眼的功夫，你们就来到了一处悬崖的边上…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 761590156,
					"content": "那我不是白跑一趟…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590157
					]
				},
				{
					"id": 761590157,
					"content": "这可不算白跑！「课业」必须由你传达，这种「形式」可是很重要的，如果缺了这一环，「课业」本身说不定都不成立了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590158
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590158,
					"content": "先不说这些，走吧走吧，跟着我，我们先去…唔，先去这里应该不要紧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590159
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590148,
					"content": "我都没完全读懂这句话…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590149
					]
				},
				{
					"id": 761590143,
					"content": "「肯定不会让你打白工的！」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590145
					]
				},
				{
					"id": 761590144,
					"content": "书里是这么写的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590145
					]
				},
				{
					"id": 761590136,
					"content": "仔细一算还挺多人的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590137
					]
				},
				{
					"id": 761590131,
					"content": "就连这种事情也能办到。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590132
					]
				},
				{
					"id": 761590126,
					"content": "难道刚才芭比洛斯女士也是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590127
					]
				},
				{
					"id": 761590120,
					"content": "下次一定要把瓦雷莎带来…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590121
					]
				},
				{
					"id": 761590121,
					"content": "是纳塔「沃陆之邦」的那位很能吃的女孩？艾莉丝倒是和我提起过她，是一位很有趣的小姑娘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590122
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590122,
					"content": "如果她来做客的话，那必须要在她面前摆上三个…哦不，七个盘子才行了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590123
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590113,
					"content": "总不能吃一肚子沙拉吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590114
					]
				},
				{
					"id": 761590108,
					"content": "居然连这种事都能预言到…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590109
					]
				},
				{
					"id": 761590104,
					"content": "不太是时候…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590105
					]
				}
			]
