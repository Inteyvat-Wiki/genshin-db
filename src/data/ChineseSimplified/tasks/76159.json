					"nextDialogs": [
						761590323
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590323,
					"content": "「另：门内有惊喜！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590324
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590324,
					"content": "回家？等一下，我说这门怎么看起来这么熟悉，这后面不会通往…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590325
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590325,
					"content": "尼可一把推开了门，带着你们大步跨入其中。随后，你们发现自己身处在一间屋子里…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
