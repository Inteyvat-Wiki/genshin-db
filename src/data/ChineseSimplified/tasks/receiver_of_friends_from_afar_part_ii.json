					},
					{
						"sceneId": 3,
						"position": [
							924.154,
							258.972,
							367.775
						],
						"pointId": 310400535
					},
					{
						"sceneId": 3,
						"position": [
							924.166,
							258.971,
							362.661
						],
						"pointId": 310400536
					}
				]
			},
			"dialogs": [
				{
					"id": 401470201,
					"content": "菜来咯！各位慢用——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401470202,
					"content": "哦哦，闻着很香呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470203
					],
					"speakerTitle": "珐露珊"
				},
				{
					"id": 401470203,
					"content": "#…啊，对了对了，派蒙跟{NICKNAME}也没吃早餐吧，干脆一块坐下？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470204
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 401470204,
					"content": "咦，多莉什么时候这么好心了…居然会有免费的早餐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401470205,
					"content": "嚯嚯，大生意都是在宴席上谈成的嘛…来来来坐坐坐！大家都不用客气！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470206
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 401470206,
					"content": "（这道菜看起来平平无奇，我又事先做过调查，应该不会花很多摩拉吧！不怕一万，就怕三万…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470207
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 401470207,
					"content": "#（这道菜，能抵得过一晚上的熬夜吗？…能不能吃回本，可就看你了啊，{NICKNAME}！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470208
					],
					"speakerTitle": "珐露珊"
				},
				{
					"id": 401470208,
					"content": "（好累…好困…好想睡…快点吃完回去睡…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470209
					],
					"speakerTitle": "莱依拉"
				},
				{
					"id": 401470209,
					"content": "几人各怀心事，各自动筷…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401470210
					]
				},
				{
					"id": 401470210,
					"content": "这是…鸡腿肉？不对，又好像是蕈猪的口感…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470211
					],
					"speakerTitle": "莱依拉"
				},
				{
					"id": 401470211,
					"content": "每嚼一口都是不同的滋味…仔细尝起来，还有点烟熏的风味…真是不可思议，到底是怎么做出来的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470212
					],
					"speakerTitle": "珐露珊"
				},
				{
					"id": 401470212,
					"content": "是火腿，我加了火腿。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401470213
					]
				},
				{
					"id": 401470213,
					"content": "火腿？可是这盘菜里哪里有——啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470214
					],
					"speakerTitle": "珐露珊"
				},
				{
					"id": 401470214,
					"content": "嘿嘿，已经有人发现了？没错，每根肉条都是用不同的肉丝揉成的！费了我跟言笑好大的劲呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401470215,
					"content": "可是，虽然我也不太清楚…不同的肉类，熟透的时间应该也不一样吧？可这道菜搭配得却很和谐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470216
					],
					"speakerTitle": "莱依拉"
				},
				{
					"id": 401470216,
					"content": "#呃…呃…这就是{NICKNAME}的商业机密了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470217,
						401470218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401470217,
					"content": "没别的，只是熟练了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401470219
					]
				},
				{
					"id": 401470219,
					"content": "没想到这还是你的独门菜式呢，算是没白来一趟。对了，这道菜有名字吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470220
					],
					"speakerTitle": "珐露珊"
				},
				{
					"id": 401470220,
					"content": "啊，我都忘了介绍了，这道菜的名字叫「繁弦急管」——既是在描述丝条交错的外观，也是在…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401470221,
					"content": "…描述复杂多变的口感？是从璃月的俗语里起的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470222
					],
					"speakerTitle": "珐露珊"
				},
				{
					"id": 401470222,
					"content": "原意应该是多种乐器同时演奏，热闹纷呈…嗯，放到这里也算贴切。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470223
					],
					"speakerTitle": "珐露珊"
				},
				{
					"id": 401470223,
					"content": "欸…原来你知道啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401470224,
					"content": "每个年轻人在毕业前都该学会至少二十种语言吧。咦…难道现在没这要求了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470225
					],
					"speakerTitle": "珐露珊"
				},
				{
					"id": 401470225,
					"content": "——欸？以前有过的吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470226
					],
					"speakerTitle": "莱依拉"
				},
				{
					"id": 401470226,
					"content": "差点忘了你也是知论派的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470227
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401470227,
					"content": "那…那个…这道菜的价格是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470228
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 401470228,
					"content": "嘿嘿——不多不多，承惠摩拉三万！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470229
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401470229,
					"content": "三…三万！哈…哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470230
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 401470230,
					"content": "#话说回来…派蒙、{NICKNAME}，我之前是让你们「一块坐下」…没说要连你们一起请客吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470231
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 401470231,
					"content": "…所以这是不是得算…拼桌？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470232
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 401470232,
					"content": "——果然没有免费的早餐啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470233,
						401470236
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401470233,
					"content": "三万而已，对你来说不算破费吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401470234
					]
				},
				{
					"id": 401470234,
					"content": "就是就是！商人要重信誉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470235
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401470235,
					"content": "呜…一枚摩拉也是钱啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470239
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 401470239,
					"content": "唉，成吧…就当作交学费了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470240
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 401470240,
					"content": "…等回了须弥，我一定要请人把这菜复现出来，再狠狠地赚一笔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "多莉"
				},
				{
					"id": 401470236,
					"content": "打八折吧，回头我跟掌柜说一声。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401470237
					]
				},
				{
					"id": 401470237,
					"content": "你啊…行吧，反正贵的也是你的出场费。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470238
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401470238,
					"content": "三万打八折…呜，还是有点心疼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470239
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 401470218,
					"content": "我有独特的烹饪手法。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401470219
					]
				}
			]
		},
