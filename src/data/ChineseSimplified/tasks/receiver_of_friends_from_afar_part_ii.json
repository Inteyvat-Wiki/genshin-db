					{
						"sceneId": 3,
						"position": [
							924.166,
							258.971,
							362.661
						],
						"pointId": 310400536
					}
				]
			},
			"dialogs": [
				{
					"id": 401470101,
					"content": "#早啊，{NICKNAME}！掌柜的跟我说了，上回来的新老顾客，对你的评价都非常好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470102
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401470102,
					"content": "我之前还担心你适应不了呢，现在看起来以你的本事，日常工作是足够应付了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470103
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401470103,
					"content": "除非来位口味又挑剔，要求又严苛的客人，否则还真难不倒你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470104
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401470104,
					"content": "哇，还会有这种客人吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401470105,
					"content": "那可不，尤其是那些菜没做几道，书读了一堆的老学究！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470106
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401470106,
					"content": "没事就来挑你哪里做的不合古法、哪里做的跟几百年前的老味道有区别…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470107
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401470107,
					"content": "——这里就是望舒客栈？也算是一家老字号了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470108
					],
					"speakerTitle": "珐露珊"
				},
				{
					"id": 401470108,
					"content": "这声音是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401470109
					]
				},
				{
					"id": 401470109,
					"content": "店家！有什么招牌名菜，就快点招待上来吧！要最贵的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470110
					],
					"speakerTitle": "珐露珊"
				},
				{
					"id": 401470110,
					"content": "珐露珊！…前！前辈好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401470111,
					"content": "#呀！{NICKNAME}，派蒙？你们怎么在这儿？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470112
					],
					"speakerTitle": "珐露珊"
				},
				{
					"id": 401470112,
					"content": "我们还想问呢，你怎么突然就有经费来旅游了？还直接点了最贵的菜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401470113,
					"content": "哼哼，这可不是旅游哦。像我这样的学者，受邀成为「随船顾问」满世界出差，也只是家常便饭而已…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470114
					],
					"speakerTitle": "珐露珊"
				},
				{
					"id": 401470114,
					"content": "珐露珊前辈…请…请慢一点…呼…明明昨晚大家都在熬夜，怎么就前辈还这么精神？她真有一百来岁了吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470115
					],
					"speakerTitle": "莱依拉"
				},
				{
					"id": 401470115,
					"content": "哈…哈…从我说要请客开始，她就一直这样了…真是失策…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470116
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 401470116,
					"content": "莱依拉！还有多莉？真是少见的组合…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401470117,
					"content": "总之先歇一会儿吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401470118
					]
				},
				{
					"id": 401470118,
					"content": "你们招待三人入座，并说明了自己正在望舒客栈帮忙的事情…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401470119
					]
				},
				{
					"id": 401470119,
					"content": "原来是这样…你还真是个大忙人呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470120
					],
					"speakerTitle": "珐露珊"
				},
				{
					"id": 401470120,
					"content": "不过既然连这里的主厨都认可你的话，也不用担心吃不上正宗的招牌菜了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470121
					],
					"speakerTitle": "珐露珊"
				},
				{
					"id": 401470121,
					"content": "所以你们又是为什么来璃月的啊？刚才好像听到了什么「随船顾问」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401470122,
					"content": "嚯嚯，我前阵子从枫丹弄了一条新船，上面装了最先进的导航机关！如果能推广出去，那可是大大的商机！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470123
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 401470123,
					"content": "最近几天正在试行呢：从奥摩斯港到离岛，从离岛到璃月港，后面还打算去荆夫港…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470124
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 401470124,
					"content": "我跟前辈就是受雇来帮忙调试罗盘、调整机关的。昨晚为了压力测试，还在云来海上漂了一整夜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470125
					],
					"speakerTitle": "莱依拉"
				},
				{
					"id": 401470125,
					"content": "这是非法加班吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401470126
					]
				},
				{
					"id": 401470126,
					"content": "会…会有加班补贴的！两位也都是自愿的，签合同的时候特意提过的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470127
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 401470127,
					"content": "你还真是滴水不漏…所以「请客」也算是补贴之一吗？难怪一上来就点贵的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401470128,
					"content": "哼哼，「想吃什么就吃什么！」——这种机会可不多见！那就先来一份…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470129
					],
					"speakerTitle": "珐露珊"
				},
				{
					"id": 401470129,
					"content": "咳！珐露珊…前辈，我当然也很想用最~贵的菜慰劳你们啦，但贵，不一定就是好嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470130
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 401470130,
					"content": "我听说璃月菜里最贵的几样，不是要用很多海鲜，就是要费很长的功夫…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470131
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 401470131,
					"content": "可是我们都在海上晃了这么多天，再吃什么鱼啊虾啊，也尝不出好味道来吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470132
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 401470132,
					"content": "呃，你这么一说，还真是这样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470133
					],
					"speakerTitle": "珐露珊"
				},
				{
					"id": 401470133,
					"content": "——而且莱依拉小姐，看着都快饿晕了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470134
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 401470134,
					"content": "欸？我不是因为饿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470135
					],
					"speakerTitle": "莱依拉"
				},
				{
					"id": 401470135,
					"content": "…想必年高德劭的珐露珊前辈，一定不忍心让后辈继续饿着肚子等吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470136
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 401470136,
					"content": "唔，要照顾后辈的话，我是没意见…不过怎么总觉得上套了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470137
					],
					"speakerTitle": "珐露珊"
				},
				{
					"id": 401470137,
					"content": "#所以，需要花大把时间来熬的菜也别上了！除此以外，有什么贵就上什么吧。交给你咯，{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "多莉"
				}
			]
		},
		{
			"id": 4014702,
