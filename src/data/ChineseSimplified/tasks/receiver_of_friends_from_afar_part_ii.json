			},
			"dialogs": [
				{
					"id": 401470301,
					"content": "今早算是开了个好头啊，接下来也拜托你们了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470302
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401470302,
					"content": "你与派蒙忙里忙外，直到打烊。来客纷纭，口味众多，留下的好评却出奇一致。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 4014704,
			"completionStepIds": [
				4014706
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
