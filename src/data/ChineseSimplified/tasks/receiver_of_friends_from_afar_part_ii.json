						],
						"pointId": 310400533
					}
				]
			},
			"dialogs": [
				{
					"id": 401470401,
					"content": "…既要贵，又不能见海鲜，还不能花时间…这大半的老菜就都被排除了吧？究竟是谁提的要求，居然这么刁钻？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470402
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401470402,
					"content": "多莉这家伙！该不会是故意的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401470403,
					"content": "估计就是故意的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401470404
					]
				},
				{
					"id": 401470404,
					"content": "我们客栈跟琉璃亭、新月轩也不一样，不会常备什么名贵的食材，一般都是有客人预定才会去准备。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470405
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401470405,
					"content": "要用寻常食材，在短时间内做一道货真价实的高价菜…那贵的就只能是厨师的「功夫」跟菜肴的「创意」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470406
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401470406,
					"content": "#{NICKNAME}，我知道一道叫做「繁弦急管」的菜，用现成的食材就能做，出菜也不费时，一盘售价…三万摩拉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470407
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401470407,
					"content": "——三万！不是说用料普通，也不费时间吗？为什么会那么贵？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401470408,
					"content": "这道菜的「功夫」不在于时间，而在于厨师对刀工跟火候的把控。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470409
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401470409,
					"content": "要用多种不同的肉类切作细丝，揉制成条，最后再下锅煎炒，主打口味多变，层层递进。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470410
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401470410,
					"content": "如何令几种不同的肉凝而不散，一起达到各自合适的熟度，味道又不相互冲突，才是这道菜真正可贵的地方！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470411
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401470411,
					"content": "做好了，就是一等一的名菜；做糟了，可就成一盘肉末了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470412
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401470412,
					"content": "哦——我懂了，所以这道菜贵的不是菜，而是你的出场费啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401470413,
					"content": "说得我都不太自信了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401470414
					]
				},
				{
					"id": 401470414,
					"content": "没事，揉条之类的琐碎工序，我可以帮你搞定。你专心对付最紧要的环节就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470415
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401470415,
					"content": "放心大胆地去试吧，就算做糟了，你做的肉末我也喜欢吃！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
