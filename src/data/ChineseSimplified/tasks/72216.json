			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"「寝子」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722160101,
					"content": "来了啊。石头人类说，他马上就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160102
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722160102,
					"content": "汝等，快随奴家去看看吧，石头人类就在那边。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「寝子」"
				}
			]
		},
		{
			"id": 7221602,
			"completionStepIds": [
				7221602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221602",
							"2"
						],
						"stepId": 7221602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"大岛纯平",
					"「寝子」",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722160201,
					"content": "呼，总算是要完成了，真是个大工程…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160202
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 722160202,
					"content": "是你们啊，还有代宫司大人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160203
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 722160203,
					"content": "怎么样，好了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160204
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722160204,
					"content": "喔！那是当然了，嘿嘿，为了有点仪式感，我可是专门留了最后一个角，等着代宫司大人过来再敲掉呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160205
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 722160205,
					"content": "真是有心了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160206
					]
				},
				{
					"id": 722160206,
					"content": "嘿嘿，那是当然了，制作雕像这种重要的事，当然要严肃对待了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160207
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 722160207,
					"content": "喵喵…敲石头，很重要吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160208
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722160208,
					"content": "嗯…怎么说呢，一般来说，做成雕像的东西，都是很重要的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160209
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 722160209,
					"content": "那派蒙应该给吃的做雕像。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160210
					]
				},
				{
					"id": 722160210,
					"content": "喂！真没礼貌！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722160211,
					"content": "也就是好东西？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160212
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722160212,
					"content": "哈哈哈，那应该…嗯…比好东西还好！毕竟雕像这种东西，可以称得上是「永恒的留念」嘛，哈哈哈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160213
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 722160213,
					"content": "不是哦。不是「永恒的留念」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160214
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722160214,
					"content": "奴家是为了，阿响回来的时候，如果找不到路，可以看到石头奴家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160215
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722160215,
					"content": "然后就知道，自己要到这里来，而不会走错，走到别的地方去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160216
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722160216,
					"content": "是、是这样啊。代宫司大人真是对那位「阿响」有心了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160217
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 722160217,
					"content": "寝子…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160218
					]
				},
				{
					"id": 722160218,
					"content": "阿响随时都会回来的。而且她和百目鬼说过，石头奴家做好的时候，就会发生好事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160219
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722160219,
					"content": "话说回来，石头人类，汝还需要奴家干什么吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160220
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722160220,
					"content": "倒也没啥…那么闲话不说了，既然代宫司大人已经在这里了，那我可要敲掉这最后一角了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160221
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 722160221,
					"content": "三…二…一！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160222
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 722160222,
					"content": "这、这云，到底是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160223,
						722160224
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 722160223,
					"content": "变成猫的模样了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160225
					]
				},
				{
					"id": 722160225,
					"content": "是阿响。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160226
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722160226,
					"content": "欸？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160227
					]
				},
				{
					"id": 722160227,
					"content": "阿响？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160228
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 722160228,
					"content": "喵喵喵！一定是阿响！这就是阿响说的！一定会出现的好事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160229
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722160229,
					"content": "她说过的，她和奴家说过的，只要敲好那块石头，就一定会出现好事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160230
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722160230,
					"content": "太好了，太好了！阿响说的是真的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160231
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722160231,
					"content": "她肯定会回来的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160232
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722160232,
					"content": "喔…喔！哈哈哈，虽然不知道是什么情况，但看代宫司大人的模样，这肯定是一件好事啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160233
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 722160233,
					"content": "寝子…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160234
					]
				},
				{
					"id": 722160234,
					"content": "有了汝等，神社也变得漂亮了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160235
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722160235,
					"content": "「塞钱箱」也修好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160236
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722160236,
					"content": "「绘马架」也修好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160237
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722160237,
					"content": "还造了石头奴家。这样一来，阿响一定会回来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160238
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722160238,
					"content": "还有，百目鬼、蛇目，还有好多好多阿响的朋友，都会和阿响一起回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160239
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722160239,
					"content": "汝啊，是好人！比饭还好！阿响会喜欢你的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160240
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722160240,
					"content": "奴家得去把小家伙们叫来，跟他们交代一下，阿响的事情。然后，还有，会有很多人过来拜拜。不好好叮嘱他们可不行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160241
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722160241,
					"content": "在那之前，奴家必须要把所有事情都打理好才行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160242
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722160242,
					"content": "阿响…喵喵喵！太好了，太好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722160224,
					"content": "这到底是怎么回事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160225
					]
				}
			]
		},
		{
			"id": 7221603,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221602",
							"3"
						],
						"stepId": 7221602,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"大岛纯平"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722160301,
					"content": "代宫司大人居然这么高兴，看来那个对它来说，真的是很重要的人啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160302
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 722160302,
					"content": "但是，不知道她到底在哪…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7221604,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221602",
							"3"
						],
						"stepId": 7221602,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"悦子",
					"大祐"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722160401,
					"content": "确实，「阿响」…「浅濑神社」和「百目鬼」，都很让人在意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160402,
						722160407
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722160402,
					"content": "你们是什么时候冒出来的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160403
					]
				},
				{
					"id": 722160403,
					"content": "岛上闹出那么大的动静，我们自然就过来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160404
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722160404,
					"content": "不过，有些事我觉得，必须要和你们说一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160405
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722160405,
					"content": "大祐，说明一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160406
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722160406,
					"content": "啊…好的，悦子小姐。是这样的，我要说的是一些…有关这座清籁岛的事情…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160408
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722160408,
					"content": "清籁岛的历史实在是太久远了，虽然协会已经特意搜罗过了资料，但还是几乎没找到什么有用的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160409
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722160409,
					"content": "根据协会给的资料，几百年前，这里似乎曾经是一处「海贼」的聚集点，当时，是由幕府出面扫清了所有海贼，并且把岛上的居民都迁移到了别处…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160410
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722160410,
					"content": "那个「百目鬼」，如果不出意外的话，也许正是当时和幕府正面冲突过的海贼头目「赤穗百目鬼」，卷宗里明确记录着他的名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160411
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722160411,
					"content": "据协会给我们的那些资料里记载，这位「赤穗百目鬼」指挥着海贼的船队，和幕府在海上作战。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160412
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722160412,
					"content": "虽然他的船队很快被幕府压制了下去，被迫向清籁岛逃窜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160413
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722160413,
					"content": "但是，幕府的船队在追击他的时候，清籁岛上突然爆发了一阵不知来由的雷暴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160414
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722160414,
					"content": "赤穗百目鬼的船队和幕府的船队一起被雷暴击中…就这样全部失去了踪迹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160415
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722160415,
					"content": "雷暴…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160416
					]
				},
				{
					"id": 722160416,
					"content": "接下来的我来说吧…这件事里最大的疑点，就是那场突然出现的雷暴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160417
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722160417,
					"content": "虽然赤穗百目鬼的船队也被雷暴波及，几乎全灭…但幕府派来清籁岛的船队也几乎全军覆没，被迫退回鸣神岛，过了一段时间才重整好了船队。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160418
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722160418,
					"content": "那场雷暴实在来得太过恰到好处，简直就像是…有人特意操控的一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160419
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722160419,
					"content": "你还记得，这座岛上被特意解开封印的那些「镇石」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160420
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722160420,
					"content": "还有，我们封印了这些「镇石」之后，岛上的雷暴也平息了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160421
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722160421,
					"content": "我不想妄下推断，但是…我感觉这一切多多少少有些关联。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160422
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722160422,
					"content": "不然，我们去问问寝子大人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160423
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722160423,
					"content": "…算了吧。资料记载那位百目鬼失踪了。说是失踪，但被那种雷暴击中，也许已经…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160424
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722160424,
					"content": "我们会继续在这座岛上探索，也继续搜集关于这件事的线索，等过段时间，我们就会回去向协会报告。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160425
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722160425,
					"content": "呵呵，旅行者，说不定到时候我们还会继续合作呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160426
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722160426,
					"content": "到时候请多多关照。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160427
					]
				},
				{
					"id": 722160427,
					"content": "彼此彼此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160428
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722160428,
					"content": "大祐，准备一下，我们继续制订探索计划。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160429
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722160429,
					"content": "呃…悦子小姐，那寝子大人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160430
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722160430,
					"content": "你之前怎么和那只猫相处，以后也怎么和那只猫相处。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160431
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722160431,
					"content": "但是记住，不要说任何不该说的话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160432
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722160432,
					"content": "它…现在应该很开心，不要说任何煞风景的话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160433
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722160433,
					"content": "我知道了！悦子小姐，嘿嘿，你果然还是很…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160434
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722160434,
					"content": "…只不过是为了更好地完成委托而已，快点去工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160435
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722160435,
					"content": "清籁岛…看来这座岛上，还有很多秘密…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "悦子"
				},
				{
					"id": 722160407,
					"content": "你们知道什么吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160408
					]
				}
			]
		}
	]
}