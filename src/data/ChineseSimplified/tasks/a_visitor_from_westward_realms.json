				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"娜扎法琳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716630101,
					"content": "你好。遇到什么麻烦了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716630102,
					"content": "噢，我的小吉祥草王啊。我确实遇到了一些棘手的问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630103
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 716630103,
					"content": "草王在上，二位大人一定是来拯救可怜的娜扎法琳的大英雄吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630104
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 716630104,
					"content": "对了，这就是所谓的那个什么来着…呃？天冷有人送被子？呃？雨、雨中送炭？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630105
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 716630105,
					"content": "呃…这是什么须弥人特有的说话方式吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630106,
						716630107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716630106,
					"content": "恐怕只是她特有的说话方式…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716630108
					]
				},
				{
					"id": 716630108,
					"content": "也是呢。而且是雪中送炭吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716630109,
					"content": "对对对，雪中送炭，这可真是雪中送炭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630110
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 716630110,
					"content": "咳…先不管这些，总之你叫做娜扎法琳对吧？那么娜扎法琳，有什么我们可以帮忙的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716630111,
					"content": "您可真是机灵，总能说到点子上！事实上，娜扎法琳我正遇到我人生中最大的困难！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630112
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 716630112,
					"content": "#叫我派蒙就好了，这是{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716630113,
					"content": "#那个，我是{NICKNAME}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716630114
					]
				},
				{
					"id": 716630114,
					"content": "很高兴认识二位大人！我叫娜扎法琳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630115
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 716630115,
					"content": "你之前已经说过名字了啦…所以，你遇到了什么困难呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716630116,
					"content": "是这样子的，我有个志向远大的好朋友叫做芭尔瓦涅。她曾经和我说，她要制作一种让大家都变得幸福的调料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630117
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 716630117,
					"content": "欸，能让大家都变幸福的调料？调料…怎么能让人变得幸福呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716630118,
					"content": "嗯…娜扎法琳也不清楚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630119
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 716630119,
					"content": "不过芭尔瓦涅说，只要加入那种调料，无论是什么菜都会变得格外美味！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630155
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 716630155,
					"content": "只要人们能吃到格外美味的菜，一定就会感觉到幸福了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630120
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 716630120,
					"content": "唔喔！很有道理！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716630121,
					"content": "一下子就被说服了啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716630122
					]
				},
				{
					"id": 716630122,
					"content": "她之所以要出发去旅行，也是为了找到制作那种调料的方法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630123
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 716630123,
					"content": "不过，她边旅行边研究，就像一只忙碌的小蜜蜂。我身为她最好的朋友，却只能留在须弥帮不上什么忙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630124
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 716630124,
					"content": "多么可怜。所以我想为她做点什么，根据她之前和我聊过的思路，我想了又想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630156
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 716630156,
					"content": "一连茶不思饭不想地想了好几天，我终于知道我能做什么了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630125
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 716630125,
					"content": "嗯？茶不思饭不想好像不是这么用的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716630126,
					"content": "噢，谢谢您的提醒。璃月的熟语真的是很难运用呢，我要多多学习才是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630127
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 716630127,
					"content": "我们回到话题上来吧，然后你想出了什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716630128,
					"content": "对！我想出了一个办法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630157
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 716630157,
					"content": "那就是…我也可以依照芭尔瓦涅的思路想一些调料配方，然后再把这些调料加入菜里，听听人们对于这些菜的看法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630129
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 716630129,
					"content": "就这样帮芭尔瓦涅做一些市场调研，再把搜集到的信息整理起来交给她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630130
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 716630130,
					"content": "您也是知道的，实际的调查也在研究中非常重要。这是我唯一能为我那忙碌的好朋友做的事情了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630131
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 716630131,
					"content": "虽然我想出来的这种调料配方，肯定不是她想要的那种调料…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630132
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 716630132,
					"content": "但大家对于这种调料的反馈，一定能给聪明的芭尔瓦涅帮助，让她快快地做出那种很厉害的调料！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630133
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 716630133,
					"content": "所以我来了七国之中，以饮食文化出名的璃月！据说这里民以食为天，一定能给我非常多的灵感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630134
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 716630134,
					"content": "所以，其实配方你还没有想出来？要我们帮忙想配方？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716630135,
					"content": "噢不，草王在上，想配方这件事情，还是让身为须弥人的我来做吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630136
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 716630136,
					"content": "须弥人非常擅长在料理里使用调料，您瞧，和二位大人谈话间我已经想好一个配方了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630137
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 716630137,
					"content": "所以，我要再次谢谢二位大人！二位大人真的是来拯救可怜的娜扎法琳的大英雄！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630138
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 716630138,
					"content": "呃？不客气…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716630139,
					"content": "所、所以我们到底要帮你什么…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716630140
					]
				},
				{
					"id": 716630140,
					"content": "事实上，嗯…虽然我想出了一些调料的配方，但是可怜的娜扎法琳在璃月一个人都不认识。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630141
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 716630141,
					"content": "而且我不是专业的冒险家，收集这么多的原料对我来说，难度实在太高，不亚于手无缚鸡之力的菜鸟独闯镀金旅团的老巢了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630142
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 716630142,
					"content": "镀金旅团？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716630143
					]
				},
				{
					"id": 716630143,
					"content": "噢，那是须弥的雇佣兵组织，只要给钱他们什么都干。有些成员甚至还能役使一些诡异的力量，非常难缠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630144
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 716630144,
					"content": "光是想想就觉得可怕，让我们回到之前的话题上来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630145
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 716630145,
					"content": "#现在，娜扎法琳想要拜托派蒙阁下和{NICKNAME}阁下，按照配方收集原料，再制作出调料！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630146
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 716630146,
					"content": "再把调料加到料理里，请二位大人熟悉的人试吃，最后把感想记录下来给娜扎法琳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630147,
						716630148
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 716630147,
					"content": "原来是这样…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716630149
					]
				},
				{
					"id": 716630149,
					"content": "原来如此！你早说呀。就交给我们吧，我们认识的人可多了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630150
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716630150,
					"content": "草王在上，感谢二位大人的热心肠！这段时间我也会陆续想点配方，等新的配方想出来之后，会直接告诉二位大人的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630151
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 716630151,
					"content": "请收下这口锅，这是我请须弥工匠特制的，用它一定能做出让大家都幸福的调料的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630152
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 716630152,
					"content": "#太好了！{NICKNAME}快行动起来吧！我给你当第一位试吃员，嘿嘿！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630153
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716630153,
					"content": "怪不得你这么积极想帮忙…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716630154
					]
				},
				{
					"id": 716630154,
					"content": "嘿嘿…快点快点！我们该行动啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716630148,
					"content": "就是找人试吃啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716630149
					]
				},
				{
					"id": 716630107,
					"content": "以前遇到的须弥人都不是这样的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716630108
					]
				}
			]
		}
	]
}