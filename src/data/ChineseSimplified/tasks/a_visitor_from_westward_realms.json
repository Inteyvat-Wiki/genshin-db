	"talks": [
		{
			"id": 7166301,
			"completionStepIds": [
				7166302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7166302",
							"2"
						],
						"stepId": 7166302,
						"stateName": "QUEST_STATE_UNFINISHED"
