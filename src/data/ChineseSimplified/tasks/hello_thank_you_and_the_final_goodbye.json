			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"兰拉娜",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730380101,
					"content": "觉王树…奇怪。觉王树不应该在这里。金色的那菈、白毛飞飞…兰拉娜不认识。但是，有熟悉的感觉。你们是谁？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380102
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730380102,
					"content": "兰拉娜，真的忘记了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730380103,
					"content": "#我叫派蒙，{M#他}{F#她}是{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730380104,
					"content": "我们是兰拉娜的朋友。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380105
					]
				},
				{
					"id": 730380105,
					"content": "嗯。兰拉娜相信你们。你们有善良的气味…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380106
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730380106,
					"content": "兰拉娜明白了。本来，心里就像有一个洞一样，重要的记忆都溜走了。但是，看到觉王树、看到你们，又明白了很多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380107
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730380107,
					"content": "刚刚看到了，你们拿了「惟耶之实」吗？为了帮助朋友，所以兰拉娜忘记了很多，然后请觉王树结出了果子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380108
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730380108,
					"content": "兰拉娜很聪明呢…「朋友」的事情，你还记得吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730380109,
					"content": "不记得。不过，没关系。既然惟耶之实在你们手中，你们一定也是兰拉娜相信的朋友，也是觉王树认可的那菈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380110
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730380110,
					"content": "拜托你们，把惟耶之实，带给兰拉娜需要帮助的朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380111,
						730380113
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730380111,
					"content": "我明白了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380112
					]
				},
				{
					"id": 730380112,
					"content": "兰拉娜，我们一起去吧！你的朋友，一定也想再见到你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730380114,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380115
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730380115,
					"content": "兰拉娜不要。兰拉娜已经忘记了。如果朋友看到兰拉娜忘记了自己，那一定会伤心，觉得兰拉娜不爱惜朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380116
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730380116,
					"content": "兰拉娜想要帮助的那个朋友，她是很好的人…很好的那菈。就算兰拉娜不记得她了，她也愿意重新当你的朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730380117,
					"content": "所以，我们一起去，好吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730380118,
					"content": "…嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380119
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730380119,
					"content": "知道了。兰拉娜相信你们，你们是朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730380113,
					"content": "我们一起去吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380114
					]
				}
			]
		},
