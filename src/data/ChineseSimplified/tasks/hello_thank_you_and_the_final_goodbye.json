			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"拉娜",
					"派蒙",
					"兰拉娜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730380301,
					"content": "呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380302
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730380302,
					"content": "醒过来了吗…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380303,
						730380304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730380303,
					"content": "听得到我说话吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380305
					]
				},
				{
					"id": 730380305,
					"content": "#咦？我又睡着了吗…这里是？{NICKNAME}、派蒙，你们没事真是太好了！我好担心，你们有没有受到死域的伤害。还有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380306
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730380306,
					"content": "兰拉娜？是你吗，兰拉娜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380307
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730380307,
					"content": "你好，那菈朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380308
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730380308,
					"content": "我等了你好久好久…我做了一个好长、好长的梦，梦见我遇见你的时候了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380309
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730380309,
					"content": "我梦见，我在森林里迷路了，找不到家，也找不到爸爸妈妈。我一直哭。你听见哭声，就过来找我，唱歌给我听…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380310
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730380310,
					"content": "后来，我们成为了最好的朋友。我经常到森林里找你玩。你送了一朵花给我，还教了我好多好多东西，很多森林的秘密。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380311
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730380311,
					"content": "像是，星蕈是天上的星星落在地上的倒影。像是，见到月莲开放的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380312
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730380312,
					"content": "见到月莲开放的话，到月亮再次升起为止都会变得幸运。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380313
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730380313,
					"content": "没错！就是这个！然后，我梦见…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380314
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730380314,
					"content": "我梦见，为了维摩庄的大家，我快快地长大，成了可靠的大人，成了巡林官。可靠的大人，是不相信森林中的精灵童话的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380315
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730380315,
					"content": "我梦见，我把你给忘了。我以为兰那罗的故事，都是优丹他们小孩子的童话。我梦见，森林不过是很多树的土地，并没有魔法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380316
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730380316,
					"content": "刚刚醒来的时候，我真的好害怕，我害怕要是我真的忘了你，那该怎么办才好…幸好只是做梦而已！能再见到你，我好高兴喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380317
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730380317,
					"content": "兰拉娜，你到哪去了呀！我等了你好久好久，等你把我带到森林里去…和你一起时才有的，充满秘密的神奇的森林…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380318
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730380318,
					"content": "对不起。兰拉娜不记得了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380319
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730380319,
					"content": "欸…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380320
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730380320,
					"content": "嗯…拉娜，你不要怪兰拉娜。事情是这样的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380321
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730380321,
					"content": "「…在寻找你的时候，我们遇到了兰拉娜。兰拉娜说…」",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730380322
					]
				},
				{
					"id": 730380322,
					"content": "无郁稠林的菌冠、雨的尽头的战斗。遗迹巨像的内部，蔷薇中的小曲。扮演兄妹的兰那罗，无忧节的欢快景象…\\n慢慢地将这些时日里，与兰那罗们一起的故事，告诉了拉娜与兰拉娜。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730380323
					]
				},
				{
					"id": 730380323,
					"content": "原来，忘记了的是我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380324
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730380324,
					"content": "惟耶之实是由记忆凝结成的…或许与你一起的记忆对兰拉娜而言太过珍贵，所以在治愈你的时候，让你也想起了以前的事呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380325
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730380325,
					"content": "#谢谢你们…{NICKNAME}、派蒙…为了帮助我，竟然经历了这么多辛苦的事情…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380326,
						730380328
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730380326,
					"content": "没关系，我们也收获了许多。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380327
					]
				},
				{
					"id": 730380327,
					"content": "嗯，是呀！而且，拉娜更应该感谢兰拉娜和兰罗摩才对…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380329
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730380329,
					"content": "谢谢…对不起，兰拉娜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380330
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730380330,
					"content": "呜呜…我竟然，把你给忘了…你一定很讨厌我吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380331
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730380331,
					"content": "不知道。兰拉娜已经忘记了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380332
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730380332,
					"content": "但是，没关系。既然，以前还记得的兰拉娜，愿意放弃记忆，现在的兰拉娜就明白，你是最重要的那菈，比回忆更宝贵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380333
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730380333,
					"content": "嗯…不知道我这样说，对兰拉娜会不会不公平…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380334
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730380334,
					"content": "#兰拉迦他们说过，兰那罗的生命很漫长！我觉得，你们还可以一起去创造好多好多宝贵的回忆，就像我和{NICKNAME}那样！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380335
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730380335,
					"content": "嗯，对喔…我们还有很长的时间，一起重新认识森林的大、世界的大、未来的无限。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380336
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730380336,
					"content": "嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380337
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730380337,
					"content": "#无留陀…死域的问题，在我沉睡的时候，也解决得差不多了。真的很感谢你们，{NICKNAME}、派蒙，还有许许多多的兰那罗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380338
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730380338,
					"content": "虽然这样有些任性，我想和兰拉娜一起去旅行。但是，我担心维摩庄的孩子们会再遇到危险…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380339
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730380339,
					"content": "我都快忘了，还有坏人的问题没解决…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380340
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730380340,
					"content": "坏人的身份，我已经有眉目了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380341
					]
				},
				{
					"id": 730380341,
					"content": "什么？是谁？呜哇，我怎么不知道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380342
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730380342,
					"content": "是喔！是谁干的？离开之前，我要狠狠地揍他们一顿！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380343,
						730380344
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730380343,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380345
					]
				},
				{
					"id": 730380345,
					"content": "是喔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380346
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730380346,
					"content": "#我相信你，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380347
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730380347,
					"content": "虽然这么说很奇怪…我觉得啊，那个坏人，带来的也不全是坏事。如果不是孩子们走失，我就不会增加巡林的次数——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380348
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730380348,
					"content": "如果没有增加巡林的次数，我就不会在那个时间、那个地点遇到蕈兽。而你和派蒙又正直、又善良，不会放着需要帮助的人不管…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380349
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730380349,
					"content": "#所以，我认识了{NICKNAME}和派蒙。你们帮了我好多好多，救了我，而且，还让我和宝贵的朋友再次相遇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380350
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730380350,
					"content": "#谢谢你，{NICKNAME}。谢谢，派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380351
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730380351,
					"content": "没关系啦！不过，「拉娜姐姐」要走，优丹、卡乌斯和素达蓓，会很难过吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380352
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730380352,
					"content": "#他们其实很坚强哦。而且，他们也认识了{NICKNAME}{M#哥哥}{F#姐姐}。再说，我又不是不回来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380353
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730380353,
					"content": "#我一定会回来，跟他们说好多好多故事，把兰拉娜介绍给他们认识，就像我把{NICKNAME}介绍给他们一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380354
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730380354,
					"content": "是喔…那就好，我还怕你不会回来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380355
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730380355,
					"content": "你愿意和我一起旅行吗，兰拉娜？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380356
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730380356,
					"content": "兰拉娜愿意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380357
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730380357,
					"content": "你为了我，忘记了好多好多东西。不过，就像派蒙说的，我们可以一起创造好多好多回忆，把你心里空落落的部分重新填满。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380358
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730380358,
					"content": "我叫拉娜，你愿意当我的朋友吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380359
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730380359,
					"content": "嗯。那菈拉娜，我们以前是好朋友，以后也是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380360
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730380360,
					"content": "咦，这是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380361
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730380361,
					"content": "从拉娜的胸口，散发出如同心跳般温暖、细微而明亮的光芒。\\n她试着用手遮挡、试探，光源却如同有意识一般钻进了她的手中。\\n光芒慢慢褪去后，出现在她手中的是一枚精致的饰品。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730380362
					]
				},
				{
					"id": 730380362,
					"content": "神之眼。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380363
					]
				},
				{
					"id": 730380363,
					"content": "这种情况，还是第一次亲眼见到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380364
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730380364,
					"content": "这样的话，我的愿望，也得到神的许可了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380365
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730380365,
					"content": "#哎呀，有了这个，旅行的时候就更不用担心了！就算遇到残留的死域，我也能解决了。希望我战斗的样子，也能像{NICKNAME}那么利落！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380366
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730380366,
					"content": "要做的事情还有很多，要去跟大家打个招呼才行。还有提纳里前辈，要跟他说旅行的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380367
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730380367,
					"content": "#谢谢你们，派蒙、兰拉娜。谢谢你，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380368
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730380368,
					"content": "#谢谢，金色的那菈{NICKNAME}、派蒙。兰拉娜不记得了，但你们一定都很好。你们让兰拉娜认识了那菈拉娜，很开心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380369,
						730380372
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730380369,
					"content": "很高兴认识你们。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380370,
						730380371
					]
				},
				{
					"id": 730380370,
					"content": "要注意安全。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380373
					]
				},
				{
					"id": 730380373,
					"content": "拉娜，兰拉娜…祝你们路途顺利。而且，一定不要忘记我们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380374
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730380374,
					"content": "「不要输给风，不要输给雨。不输给冬雪，也不输给炎夏…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380375
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730380375,
					"content": "#以前，我听过这么一首诗。等我们再见的时候，我一定要变得更加坚强。{NICKNAME}、派蒙，我们一定会再见的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380376
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730380376,
					"content": "我们一定会再见！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730380371,
					"content": "希望你在旅途中，收获许多。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380373
					]
				},
				{
					"id": 730380372,
					"content": "再见。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380373
					]
				},
				{
					"id": 730380344,
					"content": "现在还没有实际根据…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380345
					]
				},
				{
					"id": 730380328,
					"content": "你应该感谢兰拉娜和兰罗摩。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380329
					]
				},
				{
					"id": 730380304,
					"content": "看上去没有大碍。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380305
					]
				}
			]
		}
	]
}