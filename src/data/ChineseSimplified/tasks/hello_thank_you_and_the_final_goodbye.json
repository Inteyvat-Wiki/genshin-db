					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730380201,
					"content": "这是，兰拉娜的兰迦拉梨…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380202
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730380202,
					"content": "她就是，兰拉娜的那菈朋友吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380203
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730380203,
					"content": "#嗯。那么，{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730380204,
					"content": "（使用惟耶之实。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7303803,
			"completionStepIds": [
				7303803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
