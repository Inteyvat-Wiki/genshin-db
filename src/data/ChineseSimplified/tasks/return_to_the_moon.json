			"dialogs": [
				{
					"id": 60280201,
					"content": "这里就是…亥珀波瑞亚时期，人们与「月亮」沟通的地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280202
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60280202,
					"content": "恒月、霜月、虹月…当三个月亮的力量汇聚时…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280203
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 60280203,
					"content": "通往月亮的门就会打开。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280204
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60280204,
					"content": "嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280205
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 60280205,
					"content": "月髓已经准备就绪，只差最后一步了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280206
					],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 60280206,
					"content": "现在的那夏镇，应该是最热闹的时候吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280207
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60280207,
					"content": "是啊，可惜我们不得不在这种时候送你回去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60280208,
					"content": "没关系的，作为最后一份，也是唯一一份行李，我很满意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280209
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60280209,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280210
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60280210,
					"content": "我已经感受到了，来自月亮的召唤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280211
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60280211,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280212
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60280212,
					"content": "你的家就在这束光的彼岸，哥伦比娅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280213
					],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 60280213,
					"content": "以后终于有对真正的月亮祈祷的理由了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280214
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 60280214,
					"content": "哥伦比娅。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280215
					]
				},
				{
					"id": 60280215,
					"content": "嗯，我听着呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280216
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60280216,
					"content": "如果有机会，就多回来看看吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280217
					]
				},
				{
					"id": 60280217,
					"content": "哈…当然。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280218
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60280218,
					"content": "如果没有…也请记得，在这个星球上有一群想念着「哥伦比娅」的朋友们。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280219
					]
				},
				{
					"id": 60280219,
					"content": "嗯，一定会的，谢谢你们为我做那么多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280220
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60280220,
					"content": "也请你们记得，月光永远联系着我们，不论日夜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280221
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60280221,
					"content": "呼…那么…再见了，我的朋友们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				}
			]
		},
