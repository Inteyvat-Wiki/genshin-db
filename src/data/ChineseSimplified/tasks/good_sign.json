			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"志华"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221071101,
					"content": "我看见有店主今天生意兴隆…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071102
					]
				},
				{
					"id": 221071102,
					"content": "嗯，生意兴隆，财源广进？这个不错，这个不错啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071103
					],
					"speakerTitle": "志华"
				},
				{
					"id": 221071103,
					"content": "只要耐心守候，用心经营，必然会有所收获。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071104
					],
					"speakerTitle": "志华"
				},
				{
					"id": 221071104,
					"content": "这个征兆一定是在告诉我，无论是人生还是爱情，都是如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071105
					],
					"speakerTitle": "志华"
				},
				{
					"id": 221071105,
					"content": "咳！咳咳…那个，太感谢你们了，我得好好想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071106
					],
					"speakerTitle": "志华"
				},
				{
					"id": 221071106,
					"content": "绮命姐！总有一天我会…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志华"
				}
			]
		},
		{
			"id": 2210712,
			"completionStepIds": [
				2210712
			],
			"beginWay": "TALK_BEGIN_NONE",
