			"dialogs": [
				{
					"id": 221070901,
					"content": "怎么样，你们找到什么征兆了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志华"
				}
			]
		},
		{
			"id": 2210710,
			"completionStepIds": [
				2210710
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2210710",
							"2"
						],
						"stepId": 2210710,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"志华"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221071001,
					"content": "我看见屋上有鸟成双对…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071002
					]
				},
				{
					"id": 221071002,
					"content": "嗯…嗯！好，这个好啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071003
					],
					"speakerTitle": "志华"
				},
				{
					"id": 221071003,
					"content": "两只相爱的鸽子远离族群，眼中只有彼此，只愿和对方比翼天涯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071004
					],
					"speakerTitle": "志华"
				},
				{
					"id": 221071004,
					"content": "这个征兆是在暗示…我一定会遇见那位只认定我一人的爱人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071005
					],
					"speakerTitle": "志华"
				},
				{
					"id": 221071005,
					"content": "然后与她克服艰难险阻，脱离纷扰的人群，一起比翼天涯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071006
					],
					"speakerTitle": "志华"
				},
				{
					"id": 221071006,
					"content": "咳！那个，辛苦你们了…我得找个时间，再去问问绮命姐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志华"
				}
			]
		},
		{
			"id": 2210711,
			"completionStepIds": [
				2210711
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
