					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071812
					],
					"speakerTitle": "志华"
				},
				{
					"id": 221071812,
					"content": "算了，麻烦你让我一个人待一会，我想静一静。",
					"roleType": "TALK_ROLE_NPC",
