				"objectNames": [
					"志华"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221071201,
					"content": "关于落叶…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071202
					]
				},
				{
					"id": 221071202,
					"content": "嗯…这个和爱情，应该没什么关系吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 221071203,
					"content": "落叶？当然有关系了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071204
					],
					"speakerTitle": "志华"
				},
				{
					"id": 221071204,
					"content": "这些落叶，虽然看似凋零无用，但是只要有一点契机…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071205
					],
					"speakerTitle": "志华"
				},
				{
					"id": 221071205,
					"content": "有一点火星，它们就会热烈燃烧，有一缕微风，它们就会翩然而起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071206
					],
					"speakerTitle": "志华"
