			"dialogs": [
				{
					"id": 221071901,
					"content": "有一群围在一起的小狗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071902
					]
				},
				{
					"id": 221071902,
					"content": "这，这是什么坏征兆，这是在说我的爱情已经到了尽头吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071903
					],
					"speakerTitle": "志华"
				},
				{
					"id": 221071903,
					"content": "咦？可是那群小狗的关系看起来很好啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071904
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 221071904,
					"content": "那几只小狗我知道，确实关系不错，而且常年都在一起玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071905
					],
					"speakerTitle": "志华"
				},
				{
					"id": 221071905,
					"content": "看起来确实不错，但是事实上…它们谁都没有找到另一半。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071906
					],
					"speakerTitle": "志华"
				},
				{
					"id": 221071906,
					"content": "而且因为有同伴可以一起玩，它们也根本不在意这件事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071907
					],
					"speakerTitle": "志华"
				},
				{
					"id": 221071907,
					"content": "它们现在有机会去找另一半了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071908
					]
				},
				{
					"id": 221071908,
					"content": "什么意思？难道…你去把它们赶开了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071909
					],
					"speakerTitle": "志华"
				},
				{
					"id": 221071909,
					"content": "这，这样的话，倒也不错…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071910
					],
					"speakerTitle": "志华"
				},
				{
					"id": 221071910,
					"content": "能借助外力从迷惘中脱身，去追寻自己的真爱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071911
					],
					"speakerTitle": "志华"
				},
				{
					"id": 221071911,
					"content": "太谢谢你了！我明白这个征兆是什么意思了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071912
					],
					"speakerTitle": "志华"
				},
