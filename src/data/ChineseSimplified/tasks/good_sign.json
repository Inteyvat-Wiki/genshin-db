	"talks": [
		{
			"id": 2210701,
			"completionStepIds": [
				2210701
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
