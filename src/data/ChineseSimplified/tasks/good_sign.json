				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"志华"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221070101,
					"content": "「爱情这种东西，远在天边，近在眼前。不需强求，总有一天会自己送到你眼前…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070102
					],
					"speakerTitle": "志华"
				},
				{
					"id": 221070102,
					"content": "你在说什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221070103
					]
				},
				{
					"id": 221070103,
					"content": "当然是在说我的爱情运势啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070104
					],
					"speakerTitle": "志华"
				},
				{
					"id": 221070104,
					"content": "这句话，可是绮命姐为我指点的爱情运势，远在天边，近在眼前…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070105
					],
					"speakerTitle": "志华"
				},
				{
					"id": 221070105,
					"content": "她一定是在暗示我什么，但是到底在暗示什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070106
					],
					"speakerTitle": "志华"
				},
				{
					"id": 221070106,
					"content": "我听说书的人说，当人的「运势」到来时，身边的各种事物都会显出征兆来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070107
					],
					"speakerTitle": "志华"
				},
				{
					"id": 221070107,
					"content": "我觉得我的「爱情运」已经到了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070108
					],
					"speakerTitle": "志华"
				},
				{
					"id": 221070108,
					"content": "你能帮我去周围看看，有什么特别的「征兆」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070109,
						221070110
					],
					"speakerTitle": "志华"
				},
				{
					"id": 221070109,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221070111
					]
				},
				{
					"id": 221070111,
					"content": "那就拜托你了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志华"
				},
				{
					"id": 221070110,
					"content": "你为什么不自己去…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221070112
					]
				},
				{
					"id": 221070112,
					"content": "所谓「当局者迷，旁观者清」，要是我自己去看的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070113
					],
					"speakerTitle": "志华"
				},
				{
					"id": 221070113,
					"content": "无论看见什么，我都会觉得是在暗示我的「爱情运」到来啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070114
					],
					"speakerTitle": "志华"
				},
				{
					"id": 221070114,
					"content": "所以，一切都拜托你了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志华"
				}
			]
		},
