			"dialogs": [
				{
					"id": 402200201,
					"content": "马上比赛就要开始了，大家准备得怎么样？我们一路过来看到好多人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402200202,
					"content": "我准备好了毛巾、热汤还有保暖的毛毯，嗯…应该已经不缺什么了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200203
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 402200203,
					"content": "按我们之前商量好的安排，队长她们现在应该正在热身。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200204
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 402200204,
					"content": "等大家正式开跑之后，我就去终点守着，随时准备递上水和毛毯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200205
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 402200205,
					"content": "我刚从家里过来，比赛很快就要开始了，大家的热身还没结束吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200206
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402200206,
					"content": "的确是有点久了啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200207
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 402200207,
					"content": "按理说，瓦雷莎和希诺宁都不是拖拉的人呀…我们过去看看情况好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402200208,
					"content": "那就拜托你们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "明妮"
				}
			]
		},
