			"dialogs": [
				{
					"id": 402200501,
					"content": "各位选手，各位观众，大家好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200502
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 402200502,
					"content": "我，杜拉夫，受组委会任命，担任本次龙脊雪山国际越野赛的裁判。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200503
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 402200503,
					"content": "希望各支队伍在遵守比赛规则的同时，超越自我，跑出好成绩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200504
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 402200504,
					"content": "同时也提醒大家，雪山地形崎岖，为了防止意外，大家应当尽量保持在赛道上行走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200505
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 402200505,
					"content": "组委会已经提前清理过赛道，但雪山环境复杂，赛道之外依然会有危险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200506
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 402200506,
					"content": "选手们注意：一旦身体不适，无法坚持跑完全程，或者意外受伤，请到赛道一侧休息。组委会工作人员会尽快赶到并救助伤者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200507
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 402200507,
					"content": "队长，义刚呢，怎么没看到他？这马上就要开跑了呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200508
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402200508,
					"content": "明妮，义刚发烧了，现在人还昏着，没法来参赛了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200509
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 402200509,
					"content": "什么？怎么会？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200510,
						402200511
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402200510,
					"content": "别担心，有我。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402200512
					]
				},
				{
					"id": 402200512,
					"content": "#放轻松，明妮，{M#他}{F#她}很强的，有我们在你们说不定能拿到第一名呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200513
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402200513,
					"content": "我…我放心，谢谢你们帮忙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200514
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402200514,
					"content": "…接下来，由我来介绍各支参赛队伍：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200515
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 402200515,
					"content": "来自须弥的「沙之行者」，来自稻妻的「飞雷稻光」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200516
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 402200516,
					"content": "来自璃月的「夕阳」，以及枫丹的「灰手」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200517
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 402200517,
					"content": "由冒险家组成的队伍「向山」，还有清泉镇镇民们组成的队伍「神行猎手」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200518
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 402200518,
					"content": "最后，由各国参赛者组成的混合队伍——「炽魂斗士」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200519
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 402200519,
					"content": "其他队伍的选手看起来都很厉害啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200520
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402200520,
					"content": "不要慌，不要紧张！现在该想想菲耶蒂娜了，各位，拿出勇气来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200521
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402200521,
					"content": "有我们在一起，什么阻碍都能翻越！翻不过去的就用冲撞顶开！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200522
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402200522,
					"content": "不是谁都像你…算了，我同意，这种时候可不能说丧气话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200523
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 402200523,
					"content": "看我的吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402200524
					]
				},
				{
					"id": 402200524,
					"content": "我也会努力，相信大家，相信自己！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200525
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402200525,
					"content": "接下来，请选手们各就位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200526
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 402200526,
					"content": "准备，开跑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 402200511,
					"content": "我来跑义刚这段。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402200512
					]
				}
			]
		},
