			"dialogs": [
				{
					"id": 402201601,
					"content": "欸，瓦雷莎她们终于从帐篷里出来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402201602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402201602,
					"content": "大家怎么了，一脸沉重的样子？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402201603
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402201603,
					"content": "义刚发烧了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402201604
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 402201604,
					"content": "呜…怪我没有留心…之前听到义刚打喷嚏，问了他几次，他总是说自己没事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402201605
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402201605,
					"content": "他一定是不想影响比赛才硬撑着，直到今天发现自己发了烧，完全没力气动弹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402201606
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 402201606,
					"content": "我们跟组委会联系过了，药品和保暖方面目前都跟上了，他们还派了专人看护，不用太过担心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402201607
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402201607,
					"content": "可是…马上就要比赛了吧？这下是不是直接少了一位参赛队员…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402201608
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402201608,
					"content": "是啊，怎么办呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402201609
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402201609,
					"content": "这个比赛对大家都很重要，更何况明妮的父母也在终点看着…除非…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402201610,
						402201611
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402201610,
					"content": "我上吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402201612
					]
				},
				{
					"id": 402201612,
					"content": "我们想过。毕竟大家一起训练过，你了解赛道，身体素质和户外经验也都足够…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402201613
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 402201613,
					"content": "但在这种时候拉你入伙，就像紧要关头给你派了个不可推脱的工作，让人不太忍心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402201614
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 402201614,
					"content": "#最重要的是，{NICKNAME}你愿意吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402201615,
						402201616,
						402201617
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402201615,
					"content": "比赛对明妮很重要吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402201618
					]
				},
				{
					"id": 402201618,
					"content": "呜…不愧是「杜麦尼」，不管到了哪里，你都是我们的英雄，骄傲和希望！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402201619
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402201619,
					"content": "好了，时间有限，晚点再感动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402201620
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 402201620,
					"content": "#简单说明一下，我们四个的接力顺序是：我、{NICKNAME}、瓦雷莎，最后是明妮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402201621
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 402201621,
					"content": "你的越野路线是一段上坡路，记得保留体力，不要一口气冲太猛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402201622
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 402201622,
					"content": "和我交接后，沿指示向前跑，瓦雷莎会在神像处等你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402201623
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 402201623,
					"content": "嗯！我们一定可以的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402201624
					],
					"speakerTitle": "瓦雷莎"
				},
