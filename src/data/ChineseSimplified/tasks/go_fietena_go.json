			"dialogs": [
				{
					"id": 402200101,
					"content": "别自责了，明妮，这不能怪你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200102
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 402200102,
					"content": "你已经做得很好了…咳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200103
					],
					"speakerTitle": "汤义刚"
				},
				{
					"id": 402200103,
					"content": "义刚，不用安慰我了。你身体要紧，强撑着过来已经很不容易了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200104,
						402200105
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402200104,
					"content": "比赛结果怎么样？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402200106
					]
				},
				{
					"id": 402200106,
					"content": "#{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402200107,
					"content": "我来吧。抱歉，荣誉骑士，我带着伤员走到终点的时候，其他队伍的选手都已经跑完很久了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200108
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402200108,
					"content": "救生员已经把人带走检查了，我们队…没有拿到一个像样的成绩，对不起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200109
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402200109,
					"content": "明明你们在前面跑得那么快，却因为我被拖累了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200110
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402200110,
					"content": "明妮…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200111
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 402200111,
					"content": "看到那个人受伤的时候，其实我很犹豫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200112
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402200112,
					"content": "大家已经努力了这么多天，如果我没有回去拉他的话，我们的成绩就不是现在这样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200113
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402200113,
					"content": "救生员和安柏小姐就在附近，你们也离得不远，如果我不去拉他，他也不会有生命危险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200114
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402200114,
					"content": "但我没办法忍住…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200115
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402200115,
					"content": "没关系的，明妮，我们明白。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200116
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402200116,
					"content": "面对受伤的人，怎么可能置之不理呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200117
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402200117,
					"content": "「是炽魂斗士的话，一定会握上那双渴求帮助的手。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200118
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402200118,
					"content": "欸，这句话的出处是哪里？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200119
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 402200119,
					"content": "是我刚编的，嘿嘿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200120
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402200120,
					"content": "…队长，谢谢你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200121
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402200121,
					"content": "明妮！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200122
					],
					"speakerTitle": "雪琳"
				},
				{
					"id": 402200122,
					"content": "还好没出大事，刚才吓死我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200123
					],
					"speakerTitle": "雪琳"
				},
				{
					"id": 402200123,
					"content": "孩子，什么东西都没你的生命重要…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200124
					],
					"speakerTitle": "莫里茨"
				},
				{
					"id": 402200124,
					"content": "下次别这样吓唬我们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200125
					],
					"speakerTitle": "雪琳"
				},
				{
					"id": 402200125,
					"content": "爸爸妈妈，对不起…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200126
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402200126,
					"content": "因为一个小小插曲，你们并没有获得理想的成绩。虽然有些不甘心，但现实就是这样，汗水未必能浇灌出花朵。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402200127
					]
				},
				{
					"id": 402200127,
					"content": "不过你们的欢笑与付出都真实地存在过，在未来某一天它或许可以结出别的成果。\\n明妮的表情有些苦涩，但也有些释然。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402200128
					]
				},
				{
					"id": 402200128,
					"content": "明妮选手，你的身体怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200129
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 402200129,
					"content": "啊，裁判先生，我还好，没什么问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200130
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402200130,
					"content": "…您是刚才的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200131
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402200131,
					"content": "您好，我是「飞雷稻光」队的谦三，受您关照我没受什么大伤，非常感谢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200132
					],
					"speakerTitle": "晕头转向的稻妻选手"
				},
				{
					"id": 402200132,
					"content": "几位，「飞雷稻光」全队和我们组委会协商了一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200133
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 402200133,
					"content": "明妮选手回身救助他人的行为值得赞赏，组委会一致认为如果不是这个意外，你们的成绩会更好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200134
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 402200134,
					"content": "目前，「炽魂斗士」队的排名不足以拿到奖牌，但我们评估之后认为你们应当获得一项荣誉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200135
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 402200135,
					"content": "在前几名的奖牌之外，组委会将为你们颁发一块特别奖牌，鼓励你们以生命为先的行动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200136
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 402200136,
					"content": "谢谢你，杜拉夫叔叔。爸爸，妈妈，我会按照约定的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200137
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402200137,
					"content": "行，那就按照我们之间的约定来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200138
					],
					"speakerTitle": "莫里茨"
				},
				{
					"id": 402200138,
					"content": "…在保证安全的情况下，你可以去外面旅行了，明妮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200139
					],
					"speakerTitle": "莫里茨"
				},
				{
					"id": 402200139,
					"content": "欸？爸爸，但是我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200140
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402200140,
					"content": "在我看来，你已经拿到一个足够好的「名次」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200141
					],
					"speakerTitle": "莫里茨"
				},
				{
					"id": 402200141,
					"content": "呵呵，是啊。喏，还有奖牌为证呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200142
					],
					"speakerTitle": "雪琳"
				},
				{
					"id": 402200142,
					"content": "依我看，不如我们全家一起出去旅游一趟吧，就去你最喜欢的八重堂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200143
					],
					"speakerTitle": "莫里茨"
				},
				{
					"id": 402200143,
					"content": "我倒要看看，能不能找到适合你老爸老妈看的漫画。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200144
					],
					"speakerTitle": "莫里茨"
				},
				{
					"id": 402200144,
					"content": "太好了，明妮，这是一个好开始。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200145
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402200145,
					"content": "我…我太开心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200146
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402200146,
					"content": "这么值得纪念的时刻，怎么能忘记留影呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200147
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 402200147,
					"content": "有道理啊，大家一起来合影吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200148
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402200148,
					"content": "我建议咱们模仿「炽魂斗士战记」第二册里菲耶蒂娜第一次和玛薇卡并肩作战的场面，一起拍一张！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 402200105,
					"content": "明妮身体怎么样？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402200106
					]
				}
			]
		},
