			"dialogs": [
				{
					"id": 40090601,
					"content": "这里就是「禁区」？藏得那么隐蔽，进来一看倒没什么特别的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40090602,
					"content": "那是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40090603
					]
				},
				{
					"id": 40090603,
					"content": "门好大啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40090604,
					"content": "类似的隔离门总共有三道，一般来说没人能进入门内，除了我。顾名思义，「禁区」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090605
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090605,
					"content": "不过你们肯定会把信息共享给愚人众那几位对吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090606
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090606,
					"content": "确实没想过要瞒着他们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090607
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40090607,
					"content": "哈哈，该不该这么做，还是等你们看完再决定吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莱欧斯利"
				}
			]
		},
