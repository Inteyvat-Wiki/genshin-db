				]
			},
			"dialogs": [
				{
					"id": 40090801,
					"content": "（这间房间十分空旷，什么都没放，本身就已经很奇怪了。房间正中还有一个装置，像一道巨大的闸门。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40090802
					]
				},
				{
					"id": 40090802,
					"content": "接管梅洛彼得堡后我一直很在意这道门后面是什么。贸然开启很不明智，但不探查它背后究竟有什么，也是在放任隐患。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090803
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090803,
					"content": "我接手梅洛彼得堡至今，闸门上那道仪表盘就没有变化过，但最近一年，它的指针悄然转动，恐怕是某个数据变化了一丁点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090804
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090804,
					"content": "放在平时应该会被忽视，不过那段时间我比较闲，就花了点时间调查。你们觉得它会是什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090805,
						40090806
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090805,
					"content": "水压？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40090807
					]
				},
				{
					"id": 40090807,
					"content": "很合理的猜想，我也考虑过。它不是那么常规。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090808
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090808,
					"content": "温度会根据气候变化，相比温度，水压的可能性更高。我们从外部做了些测试，尝试增加压力，可它不受影响。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090809
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090809,
					"content": "后来，我想到另一些可能，与原始胎海有关。基于这种猜想，我开始做准备。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090810
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090810,
					"content": "这两天指针又转了，加上那位潜水员回来时的症状，如今我已经完全确定，这个指数代表的是原始胎海水浓度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090811
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090811,
					"content": "浓度？！可这里是海底…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090812
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40090812,
					"content": "问题就在这里。我们在海底，而海水悄悄变质了，胎海水混杂其中，浓度还在不断升高。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090813
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090813,
					"content": "…胎海水在不断混入海水？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40090814
					]
				},
				{
					"id": 40090814,
					"content": "嗯，可能性很大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090815
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090815,
					"content": "可是，别说我们俩了，就连那维莱特他们都不知道原始胎海在哪，胎海水又是从哪里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090816
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40090816,
					"content": "啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090817
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40090817,
					"content": "你们似乎明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090818
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090818,
					"content": "没错，我认为，这道闸门下方就是原始胎海。出于某些原因，闸门后的胎海水开始大幅上涨，已经很接近我们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090819
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090819,
					"content": "仪表盘现在是红色。闸门虽然还在，胎海水已经透过部分海底泄漏出来，混入大海。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090820
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090820,
					"content": "…这样下去它很快就没法阻挡底下的水了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090821,
						40090822
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090821,
					"content": "假如原始胎海在泄漏…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40090823
					]
				},
				{
					"id": 40090823,
					"content": "是啊，胎海水来自原始胎海，这是枫丹的传说。如果这里彻底失守，整个枫丹的人一夜之间都会化成水。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090824
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090824,
					"content": "太奇怪了吧，为什么梅洛彼得堡会建在原始胎海闸门的正上方？这里是谁造的…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090825
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40090825,
					"content": "你的表情像在猜这件事有多复杂。说真的，它可能比你想的还单一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090826
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090826,
					"content": "只不过是因为，在我重新发觉这个秘密之前，枫丹早就没人知道禁区的秘密了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090827
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090827,
					"content": "梅洛彼得堡没有传统意义上的设立者。这些传闻也都是从前聚集在这里的人留下的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090828
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090828,
					"content": "前代水神厄歌莉娅在任时，犯了罪的枫丹人会被流放。人们像狼群驱逐某一匹狼那样赶走犯罪者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090829
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090829,
					"content": "罪犯通常不会得到任何形式的同情，他们被流放到荒芜的海边，经历磨难、寒冷和痛苦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090830
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090830,
					"content": "一些人开始改过，向天祈祷，询问水神还有没有自己能做的事。水神怜悯他们的渴求，便说：去海底看守我的秘密吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090831
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090831,
					"content": "于是，借由水神的力量，他们聚集到海底，开始建造一座多人共筑的堡垒。他们居住在此，渐渐又吸纳更多人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090832
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090832,
					"content": "随着被流放者增加，更多人走上他们的老路。最初一批成员去世前，将当时还不完善的梅洛彼得堡留给其他被流放者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090833
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090833,
					"content": "前代水神从远方送来助力，帮助被流放者的堡垒不断壮大。位于海底，远离阳光的梅洛彼得堡成为了罪人唯一的栖息地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090834
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090834,
					"content": "所以这里的人不把梅洛彼得堡称为监狱，他们相信自己正在赎罪，而罪孽终有一日偿还完，他们就能重获自由。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090835
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090835,
					"content": "可后来的人渐渐发觉，梅洛彼得堡是孤独之地。他们习惯了这里的生活，变得渐渐不再适应水上世界。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090836
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090836,
					"content": "刑满后，有人离开，有人依然留下，在这里混个闲职，放任自己枯萎的灵魂与古老秘密一同逝去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090837
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090837,
					"content": "…几百年过去，没多少人还记得梅洛彼得堡为何出现。他们只会觉得这里自古就存在，是犯罪者应去的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090838
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090838,
					"content": "偶尔会有老研究员，犯了事，在这里终老。我从一个老历史学家那知道这些，其他人总觉得这些全是他幻想出来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090839
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090839,
					"content": "但现在你知道，这些都是真的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090840
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40090840,
					"content": "没错。就像那则预言，如果有一天闸门被冲破，所有人都将溶进水里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090841
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090841,
					"content": "你相信预言吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40090842
					]
				},
				{
					"id": 40090842,
					"content": "非要说的话，我不太信。但很可惜，一切正在与预言重合。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090843
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090843,
					"content": "预言是种麻烦东西。光是听说就会带来第一次恐慌，发现征兆是第二次，应验是第三次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090844
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090844,
					"content": "那作为这里的老大，你怎么办？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40090845
					]
				},
				{
					"id": 40090845,
					"content": "换个地方，我带你看一件东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090822,
					"content": "一旦闸门失守，枫丹就完了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40090823
					]
				},
				{
					"id": 40090806,
					"content": "温度？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40090807
					]
				}
			]
		},
