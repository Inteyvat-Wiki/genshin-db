			"dialogs": [
				{
					"id": 40090201,
					"content": "打扰了哟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090202
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 40090202,
					"content": "看来菲米尼先生情况稳定下来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090203
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090203,
					"content": "当然，否则我不会离开医务室的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090204
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 40090204,
					"content": "那两位过来很正常，但护士长是有何贵干？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090205
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090205,
					"content": "我来看看克洛琳德小姐。你感觉还好吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090206
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 40090206,
					"content": "嗯，没什么问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090207
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 40090207,
					"content": "可以的话，我想帮你再做个检查，很快的，请给我几分钟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090208
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 40090208,
					"content": "好吧，谢谢。那我就先告辞了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090209
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 40090209,
					"content": "该向我们解释了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40090210,
					"content": "哈哈，解释，我不太喜欢这个说法。「说明」如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090211
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090211,
					"content": "愿闻其详。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40090212
					]
				},
				{
					"id": 40090212,
					"content": "不过要从哪里说起呢？烦请你们提问吧，从最想知道答案的问题开始好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090213
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090213,
					"content": "唔…那我问了哦，你从一开始就知道林尼他们的目的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40090214,
					"content": "不，我只知道他们隶属愚人众，受「仆人」命令进入梅洛彼得堡，具体目的嘛，随着你们行动推进才查清。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090215
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090215,
					"content": "都不知道目的，却能仔细地防着他们？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40090216,
					"content": "他们来意不善，我很擅长分辨这类信号。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090217
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090217,
					"content": "为什么不阻止他们的行动？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40090218
					]
				},
				{
					"id": 40090218,
					"content": "一开始，我认为他们的目的是查清「公子」为什么失踪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090219
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090219,
					"content": "林尼猜测是我故意放走他，实际上，我们并没有特意阻拦或是纵容他的行为。他只是就那样自然地找到帮手，自然地离开了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090220
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090220,
					"content": "至冬执行官在枫丹境内失踪，这件事肯定会被「仆人」拿来大做文章。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090221
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090221,
					"content": "我也有点好奇这位执行官去了哪里，反正一样要查，就让愚人众自己的人来查吧。我只等结果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090222
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090222,
					"content": "你想坐收渔翁之利啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40090223,
					"content": "有什么不可以的呢？可惜，后来情况有变，菲米尼应该告诉你了，梅洛彼得堡周围的海水正在变化。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090224
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090224,
					"content": "「禁区」一直是林尼的调查目标，你来了之后也被牵扯其中。为了你们的安全，也为了不让梅洛彼得堡摊上更多麻烦事，我开始着手干涉你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090225
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090225,
					"content": "传闻是真的吗？你以前真的是罪犯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40090226,
					"content": "什么话？都当梅洛彼得堡的管理者了，天天待在这里，不就是变相坐牢吗？只是这里的人比较服我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090227
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090227,
					"content": "对了，谁找克洛琳德来的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090228
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40090228,
					"content": "当然是我。我花钱请她来梅洛彼得堡出外勤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090229
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090229,
					"content": "克洛琳德小姐是决斗代理人，相当于第三方势力。我需要请一个实力超群的帮手应对接下来的危机。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090230
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090230,
					"content": "比如救起菲米尼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090231
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40090231,
					"content": "你就这么理解好了。那位先生确实是个好手，要是条件不那么苛刻，他可能已经追上失踪的人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090232,
						40090233
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090232,
					"content": "「禁区」真实存在？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40090234
					]
				},
				{
					"id": 40090234,
					"content": "这不是你该打听的事，那维莱特委托你的工作也只是探查「公子」的去向。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090235
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090235,
					"content": "我只需向你证明「禁区」与公子的失踪无关，这一点上菲米尼就是人证。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090236
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090236,
					"content": "可是，我们都查到医务室了，你刚才也问了一堆事…反而是我们问的最后一个问题你还没回答呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090237
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40090237,
					"content": "噢，说得我都不好意思了。你们真那么想知道答案啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090238
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090238,
					"content": "对！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090239
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40090239,
					"content": "哪怕说出真相也未必能让你高兴？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090240
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090240,
					"content": "…是的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40090241
					]
				},
				{
					"id": 40090241,
					"content": "跟我来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090233,
					"content": "里面有什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40090234
					]
				}
			]
		},
