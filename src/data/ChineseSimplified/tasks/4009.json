			"dialogs": [
				{
					"id": 40091201,
					"content": "就送你们到这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40091202
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40091202,
					"content": "噢！呃…谢谢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40091203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40091203,
					"content": "别客气。不过记住了，要不要将信息分享出去取决于你。你的举动很可能影响那几个人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40091204
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40091204,
					"content": "（他的意思是，我说不说出梅洛彼得堡的秘密，将直接决定林尼他们的下一步行动。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40091205
					]
				},
				{
					"id": 40091205,
					"content": "（…也就是说，如果我要将真相告诉林尼，就必须让他明白现在不能有太多纷争。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40091206
					]
				},
				{
					"id": 40091206,
					"content": "我们会认真考虑的，嗯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40091207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40091207,
					"content": "嗯，会的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40091208
					]
				},
				{
					"id": 40091208,
					"content": "好，容我期待之后的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莱欧斯利"
				}
			]
		}
