			"dialogs": [
				{
					"id": 40090901,
					"content": "到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090902
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090902,
					"content": "公爵！您来得正好，最新一次试做的数据已经…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090903
					],
					"speakerTitle": "朱里厄"
				},
				{
					"id": 40090903,
					"content": "等等朱里厄，有别的人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090904
					],
					"speakerTitle": "露尔薇"
				},
				{
					"id": 40090904,
					"content": "咦？朱里厄和露尔薇？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090905
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40090905,
					"content": "不用紧张，这两位已经知道我们的计划了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090906
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090906,
					"content": "什么？亏您还说不能向任何人透露我们的计划！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090907
					],
					"speakerTitle": "露尔薇"
				},
				{
					"id": 40090907,
					"content": "我也抱有同样的疑问。您确定他们可信吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090908
					],
					"speakerTitle": "朱里厄"
				},
				{
					"id": 40090908,
					"content": "你已经看到结果了不是吗？这两位知道的事可能比你们想的还多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090909
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090909,
					"content": "…好吧，如果您坚持的话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090910
					],
					"speakerTitle": "朱里厄"
				},
				{
					"id": 40090910,
					"content": "我从他们身上感觉不到恶意…应该是可信的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090911
					],
					"speakerTitle": "露尔薇"
				},
				{
					"id": 40090911,
					"content": "重新介绍一下，这位是朱里厄，枫丹科学院最高级研究人才之一，曾在艾德温手下工作。你们知道艾德温吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090912,
						40090914
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090912,
					"content": "知道。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40090913
					]
				},
				{
					"id": 40090913,
					"content": "很好，省去了解释的功夫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090916
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090916,
					"content": "艾德温主攻研究方向是始基矿和重力仪，朱里厄作为助手，也了解相关技术。我聘请他担任我的技术顾问。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090917
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090917,
					"content": "你…你要把梅洛彼得堡炸上天？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090918
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40090918,
					"content": "啊，这句话很美妙。我开始想象了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090919
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090919,
					"content": "我也有些心动…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090920
					],
					"speakerTitle": "朱里厄"
				},
				{
					"id": 40090920,
					"content": "先生们，注意分寸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090921
					],
					"speakerTitle": "露尔薇"
				},
				{
					"id": 40090921,
					"content": "正直的露尔薇小姐同样是我请来的技术顾问，很巧，朱里厄以前是艾德温的助手，而她以前是朱里厄的助手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090922
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090922,
					"content": "还能这样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090923
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40090923,
					"content": "有什么必要？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40090924
					]
				},
				{
					"id": 40090924,
					"content": "你看，大家都这么问。你们其实是借职务之便谈恋爱吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090925
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090925,
					"content": "什…公爵，我们没在谈恋爱！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090926
					],
					"speakerTitle": "露尔薇"
				},
				{
					"id": 40090926,
					"content": "除非我疯了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090927
					],
					"speakerTitle": "朱里厄"
				},
				{
					"id": 40090927,
					"content": "噢，当我没说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090928
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090928,
					"content": "跟我来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090929
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090929,
					"content": "哇，又是一扇会升起来的门！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090930
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40090930,
					"content": "你这样称赞会让我对梅洛彼得堡产生不必要的自信。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090931
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090931,
					"content": "嘿嘿…我是真的觉得很厉害嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090932
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40090932,
					"content": "普通的房间？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40090933
					]
				},
				{
					"id": 40090933,
					"content": "再来一些小把戏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090934
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090934,
					"content": "请看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090935
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090935,
					"content": "这是…？！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40090936
					]
				},
				{
					"id": 40090936,
					"content": "这么大的…船？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090937
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40090937,
					"content": "而且这里是没见过的工厂区…这是怎么回事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090938
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40090938,
					"content": "不知道你们对枫丹历史了解多少？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090939
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090939,
					"content": "呃…了解得很少…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090940
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40090940,
					"content": "那你们或许还不知道雷穆利亚的故事。简单来说，古代枫丹受雷穆利亚王朝统治。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090941
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090941,
					"content": "传说雷穆利亚的帝王雷穆斯受天启感召而来，寻到化身为金蜂的先知西比尔。带着金蜂与大船法图纳号，在海上建立自己的国家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090942
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090942,
					"content": "他以雷穆利亚称呼这个国家，并靠法图纳号继续不断寻找新的岛屿和部落，号召他们归入帝国统治。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090943
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090943,
					"content": "这个故事里也有船…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090944
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40090944,
					"content": "与水有关的地方总会有船。人们相信船能带领大家找到希望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090945
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090945,
					"content": "你也信吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090946
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40090946,
					"content": "我的话，半信半疑。但你也看到了，我拥有一整座工厂的材料、技术和人力，试一试没什么不好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090947
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090947,
					"content": "所以，第一次猜想那扇闸门下可能是胎海时，我就想到要做这件事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090948
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090948,
					"content": "是传说中的法图纳号启发了你吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090949
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40090949,
					"content": "天灾在即，枫丹人需要这样的手段。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090950,
						40090951
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090950,
					"content": "这是一个伟大的计划…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40090952
					]
				},
				{
					"id": 40090952,
					"content": "如果让这里的犯人知道大船背后我们要面临的灾难，那在真正的灾难到来前，暴乱会先毁掉梅洛彼得堡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090953
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090953,
					"content": "身为管理者，我不能认可这种莽撞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090954
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090954,
					"content": "好了，我说得足够多，需要再喝三杯茶。你们还有什么疑问？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090955
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090955,
					"content": "看来没有了。那请吧，我送你们回去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40090951,
					"content": "为什么要偷偷进行？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40090952
					]
				},
				{
					"id": 40090914,
					"content": "不知道。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40090915
					]
				},
				{
					"id": 40090915,
					"content": "艾德温，就是炸飞了整个枫丹科学院的家伙。他是公认的脑袋有问题，不过你不是本地人，不知道也没什么奇怪的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090916
					],
					"speakerTitle": "朱里厄"
				}
			]
		},
