			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"菲米尼",
					"琳妮特",
					"林尼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 40090101,
					"content": "林尼…呃，对不起…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090102
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 40090102,
					"content": "我也很抱歉，哥哥。我应该更谨慎一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090103
					],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 40090103,
					"content": "别说这种话。都是我的错…该谨慎的人是我。你们差点就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090104
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 40090104,
					"content": "如果我实力更强一点，也许现在已经找到「公子」大人了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090105
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 40090105,
					"content": "不对，你怎么能这么说？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090106
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 40090106,
					"content": "欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090107
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 40090107,
					"content": "…抱歉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090108
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 40090108,
					"content": "也就是说，我们都不够谨慎，对吗？共同责任。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090109
					],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 40090109,
					"content": "啊，对！共同责任！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090110
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 40090110,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090111
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 40090111,
					"content": "哥哥，你担心我们，我们也担心现在的你。不要露出这种表情…请你打起精神来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090112
					],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 40090112,
					"content": "…嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "林尼"
				}
			]
		},
