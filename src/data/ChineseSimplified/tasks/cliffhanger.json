			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"茶博士刘苏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223010101,
					"content": "完了，我讲到哪了来着…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010102
					],
					"speakerTitle": "茶博士刘苏"
				},
				{
					"id": 223010102,
					"content": "讲什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223010103
					]
				},
				{
					"id": 223010103,
					"content": "您好，您这是来听书的？还是来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010104
					],
					"speakerTitle": "茶博士刘苏"
				},
				{
					"id": 223010104,
					"content": "我？我在这说书，赚点喝茶的小钱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010105
					],
					"speakerTitle": "茶博士刘苏"
				},
				{
					"id": 223010105,
					"content": "只是我说的书太多，太杂，说着说着就容易记混…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010106
					],
					"speakerTitle": "茶博士刘苏"
				},
				{
					"id": 223010106,
					"content": "这不，前几天一帮客人闹着要听讲南十字船队的《海山履云记》，另一帮闹着要听讲古华派的《裁雨声》。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010107
					],
					"speakerTitle": "茶博士刘苏"
				},
				{
					"id": 223010107,
					"content": "我也是为了赚钱，就每本书挑了段记得的讲了点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010108
					],
					"speakerTitle": "茶博士刘苏"
				},
				{
					"id": 223010108,
					"content": "没想到客人听上了心，闹着非要听后续，不给听就闹，你说这…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010109
					],
					"speakerTitle": "茶博士刘苏"
				},
				{
					"id": 223010109,
					"content": "这两本书都是我几年前讲过的，我这回去淘了半天，才淘出来重新看了看，准备开书。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010110
					],
					"speakerTitle": "茶博士刘苏"
				},
				{
					"id": 223010110,
					"content": "但是，我忘了我上次这两本书分别讲到哪了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010111
					],
					"speakerTitle": "茶博士刘苏"
				},
				{
					"id": 223010111,
					"content": "您能帮我去问问外面的人我上次讲到哪了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010112,
						223010114
					],
					"speakerTitle": "茶博士刘苏"
				},
				{
					"id": 223010112,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223010113
					]
				},
				{
					"id": 223010113,
					"content": "那您受累。我去问的话，那就是砸我自个的招牌…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010118
					],
					"speakerTitle": "茶博士刘苏"
				},
				{
					"id": 223010118,
					"content": "我寻思了一下，您能问的人有三位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010119
					],
					"speakerTitle": "茶博士刘苏"
				},
				{
					"id": 223010119,
					"content": "一位是<color=#00E1FFFF>茂才公</color>，这位爷是一场书都没落过。一位是<color=#00E1FFFF>范二爷</color>，也就是这茶楼的老板。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010120
					],
					"speakerTitle": "茶博士刘苏"
				},
				{
					"id": 223010120,
					"content": "还有一位是<color=#00E1FFFF>江舟</color>小姐，我上次说书的时候，看见她停下来听了一会，但是没多久又走了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "茶博士刘苏"
				},
				{
					"id": 223010114,
					"content": "你干脆从头讲…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223010115
					]
				},
				{
					"id": 223010115,
					"content": "我也想啊，那不也能赚双份钱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010116
					],
					"speakerTitle": "茶博士刘苏"
				},
				{
					"id": 223010116,
					"content": "但是这范二爷，不得把我赶出去嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010117
					],
					"speakerTitle": "茶博士刘苏"
				},
				{
					"id": 223010117,
					"content": "您受累，帮我去问一嘴吧，问到了回来告诉我，我掂量着开书…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010118
					],
					"speakerTitle": "茶博士刘苏"
				}
			]
		},
		{
			"id": 2230102,
