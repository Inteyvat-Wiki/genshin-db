				},
				{
					"id": 223011707,
					"content": "不过我去得太晚，到的时候前面已经讲完了，后面好像讲到了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011708
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 223011708,
					"content": "好像是主角本来是要赢了，但是突然被人偷袭，一下子就陷入了劣势。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011709
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 223011709,
					"content": "但是，我那时候又被人叫去工作了，真想知道后面是怎么发展啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "江舟"
				}
			]
		},
