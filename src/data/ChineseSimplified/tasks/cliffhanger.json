				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223010201,
					"content": "您回来了啊，您受累，您辛苦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010202
					],
					"speakerTitle": "茶博士刘苏"
				},
				{
					"id": 223010202,
					"content": "我这书越说越多，也越忘越多，也是没办法的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010203
					],
					"speakerTitle": "茶博士刘苏"
				},
				{
					"id": 223010203,
					"content": "那，您问到了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "茶博士刘苏"
				}
			]
		},
		{
			"id": 2230104,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
