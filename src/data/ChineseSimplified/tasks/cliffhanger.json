						"rawParams": [
							"2230108",
							"2"
						],
						"stepId": 2230108,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"99902",
							"3"
						],
						"stepId": 99902,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"茶博士刘苏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223010401,
					"content": "您还在这呢，哈哈哈，我这书…您觉着怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010402,
						223010405
					],
					"speakerTitle": "茶博士刘苏"
				},
				{
					"id": 223010402,
					"content": "还有呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223010403
					]
				},
				{
					"id": 223010403,
					"content": "您看您，《裁雨声》和《海山履云记》，那可都是大部头。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010404
					],
					"speakerTitle": "茶博士刘苏"
				},
				{
					"id": 223010404,
					"content": "简简单单三言两语可讲不完，您想听，之后您掐着时间来就成。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010407
					],
					"speakerTitle": "茶博士刘苏"
				},
				{
					"id": 223010407,
					"content": "这书还是多谢您帮忙，这些您拿好了，以后还请您来多多捧场。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "茶博士刘苏"
				},
				{
					"id": 223010405,
					"content": "只记得且听下回分解了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223010406
					]
				},
				{
					"id": 223010406,
					"content": "哈哈，您想听下回分解，那您得常来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010407
					],
					"speakerTitle": "茶博士刘苏"
				}
			]
		},
