					],
					"speakerTitle": "茂才公"
				},
				{
					"id": 223011402,
					"content": "请问，您听过刘苏说书吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223011403
					]
				},
				{
					"id": 223011403,
					"content": "那当然了，只不过这个刘博士真是气人，上次我去和裕茶馆听他讲<color=#00E1FFFF>《裁雨声》</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011404
					],
					"speakerTitle": "茂才公"
				},
				{
					"id": 223011404,
					"content": "刚刚讲到古华派山门凋敝，上门挑战者络绎不绝，山门的弟子却不断出走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011405
					],
					"speakerTitle": "茂才公"
				},
				{
					"id": 223011405,
					"content": "留下的弟子有心护山，无力回天，古华派的招牌都被人砸了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011406
					],
					"speakerTitle": "茂才公"
				},
				{
					"id": 223011406,
					"content": "就在古华派掌门心灰意冷，准备散去门人就此归隐的时候，一个年轻人进了山门，一手剑术举世无双…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011407
					],
					"speakerTitle": "茂才公"
				},
				{
					"id": 223011407,
					"content": "然后他就不讲了！哎哟，说什么且听下回分解，分解了多少天了，连个水花都没起…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011408
					],
					"speakerTitle": "茂才公"
				},
				{
					"id": 223011408,
					"content": "我下次要见到他，非要他讲出个所以然来不可！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "茂才公"
				}
