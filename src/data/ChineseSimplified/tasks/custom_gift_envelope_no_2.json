			"dialogs": [
				{
					"id": 715340101,
					"content": "唔，还是先参考一下其他「祝柬」吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340102
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 715340102,
					"content": "#{NICKNAME}，许久未见……你为什么一副惊讶的表情？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340103
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 715340103,
					"content": "不，就是没想到…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715340104
					]
				},
				{
					"id": 715340104,
					"content": "没想到我一介武人，也有来海灯节的雅致？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340105
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 715340105,
					"content": "平时都没见你怎么放松过…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715340106
					]
				},
				{
					"id": 715340106,
					"content": "「天领奉行」责任重大，我身为其中一员，平时容不得一丝一毫的放松。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340107
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 715340107,
					"content": "在旁人看来，我或许的确是一位不懂雅致的武人…与花见坂里的那些舞乐之声格格不入。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340108
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 715340108,
					"content": "但是，如果我在平日里随意放松心神，让宵小之徒有可乘之机，那…只怕不仅是我，整个花见坂的舞乐声都会沉寂下去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340109
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 715340109,
					"content": "最多，就像这样见缝插针，勉强抽出些空闲来四处走走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340110
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 715340110,
					"content": "抱歉，佳节当前，不该说这些严肃的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340111
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 715340111,
					"content": "我正在试着做一封「祝柬」，但始终不得其法，如果你愿意的话，能给我一些制作的建议么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340112
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 715340112,
					"content": "好啊，让我想想…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
