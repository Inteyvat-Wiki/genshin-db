				{
					"id": 715340301,
					"content": "原来如此。这样做出来的「祝柬」的确好看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340302
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 715340302,
					"content": "谢谢你帮我做了这份「祝柬」。这样我也算是有了份纪念品，不算白来一趟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340303
					],
					"speakerTitle": "九条裟罗"
				},
				{
