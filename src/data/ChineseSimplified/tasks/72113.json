			},
			"dialogs": [
				{
					"id": 721131001,
					"content": "你究竟是什么人？想要干什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131002
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131002,
					"content": "我们才要问呢！玄冬小姐你想干什么，为什么突然袭击我们？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131003
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721131003,
					"content": "无礼。回答我的问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131004
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131004,
					"content": "#我是{NICKNAME}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131005
					]
				},
				{
					"id": 721131005,
					"content": "我知道你的名字，给我老实说，暗号是从哪听来的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131006,
						721131008
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131006,
					"content": "是、是派蒙告诉我…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131007
					]
				},
				{
					"id": 721131007,
					"content": "喂！你要干什么呀？赶快把实情说出来呀，玄冬小姐已经在瞪我们了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131010
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721131010,
					"content": "…原来如此，手记只是你们两个偶然得到的。这样看来，百华她应该已经…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131011
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131011,
					"content": "「百华」是谁？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131012
					]
				},
				{
					"id": 721131012,
					"content": "是手记的主人，也是我的同僚。不过她现在已经无法履行自己对稻妻的职责了，真是可悲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131013
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131013,
					"content": "哼，我知道你们还有很多疑问，都告诉你们也无妨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131014
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131014,
					"content": "我和百华都是「终末番」的忍者。我们「终末番」会为稻妻扫清有害的异物，而「纸片儿」是我们沟通任务的方式之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131015
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131015,
					"content": "因此，我们也承受了很多怨恨与危险。比如说，潜伏在稻妻境内那些奇怪又危险的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131016,
						721131018
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131016,
					"content": "蒙德人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131017
					]
				},
				{
					"id": 721131017,
					"content": "哪来的蒙德人啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131020
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721131020,
					"content": "如果知道暗号，就可以分辨出同侪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131021
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131021,
					"content": "但是，每个人的暗号都是独一无二的。看来百华故意写出自己的暗号，是留了一手呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131022
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131022,
					"content": "…为了引出想要利用这一暗号的敌人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131023
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131023,
					"content": "这么说…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131024
					]
				},
				{
					"id": 721131024,
					"content": "玄冬小姐看见来接头的人不是百华，马上就知道事情不对了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131025
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721131025,
					"content": "那当然，所以我必须查明情况。但真的很奇怪。我无论如何也想不通。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131026
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131026,
					"content": "如果你是至冬国的探子，为什么没有把这件事汇报给愚人众，反而老老实实去把任务完成了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131027
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131027,
					"content": "…所以，我相信你所说的废弃营地的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131028
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131028,
					"content": "因为从实际行动来看，虽然一开始你们只是出于好奇对上了暗号，但你们于稻妻而言，是友非敌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131029
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131029,
					"content": "虽然还了我们清白，可想想这么长时间里，玄冬小姐都把我们当免费劳动力，还是有点不高兴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131030
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721131030,
					"content": "…但那个人，真的是玄冬小姐吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131031
					]
				},
				{
					"id": 721131031,
					"content": "哼，果然意识到了吗，后续给你们任务的玄冬，是冒充的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131032
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131032,
					"content": "咦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131033
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721131033,
					"content": "在我跟踪你的路上，被几个愚人众的密探袭击了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131034
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131034,
					"content": "因为我姑且也会一两式忍法，所以用假死蒙混过去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131035
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131035,
					"content": "之后不久他们就派人乔装成我的模样，去顶替我的位置了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131036,
						721131037
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131036,
					"content": "难怪感觉她很不对劲。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131038
					]
				},
				{
					"id": 721131038,
					"content": "欸？也就是说，那个比较亲切的玄冬小姐是冒牌货？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131039
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721131039,
					"content": "「亲切」？哼，那家伙听起来挺受欢迎啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131040
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131040,
					"content": "总之，估计他们以为，你是正牌的终末番成员，想通过这种方式来渗透我们的组织。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131041
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131041,
					"content": "对我而言，这也是很好的机会。趁冒牌货今天不在，我用「自己的方式」把你带到了这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131042
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131042,
					"content": "你听好了。现在我给你一个选择。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131043
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131043,
					"content": "作为外部成员，为我们工作。现在他们不知道我还活着，所以我们占了上风。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131044,
						721131047,
						721131048
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131044,
					"content": "要是我拒绝…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131045
					]
				},
				{
					"id": 721131045,
					"content": "哦，试试看？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131046
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131046,
					"content": "#不管怎么说，{NICKNAME}，愚人众也是我们的敌人。我们不如合作吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131049
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721131049,
					"content": "贤明的选择。这个「安全屋」的物资，姑且也交给你自由支配吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131050
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131050,
					"content": "那么，日后有新的动向时，我会联络你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131051
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131051,
					"content": "希望我们能够愉快合作。再见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131052
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131047,
					"content": "有道理。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131049
					]
				},
				{
					"id": 721131048,
					"content": "好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131049
					]
				},
				{
					"id": 721131037,
					"content": "难怪她知道「御神签」这个词。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131038
					]
				},
				{
					"id": 721131018,
					"content": "愚人众。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131019
					]
				},
				{
					"id": 721131019,
					"content": "没错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131020
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131008,
					"content": "你听我解释，事情是这样的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131009
					]
				},
				{
					"id": 721131009,
					"content": "我们在一座山头上，找到了一个废弃营地…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131052
					],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}