			},
			"dialogs": [
				{
					"id": 721130101,
					"content": "你要求签？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130102
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721130102,
					"content": "呜哇，好冷淡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721130103,
					"content": "我想求签…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130104
					]
				},
				{
					"id": 721130104,
					"content": "明白了。流程是这样的。首先请你用力摇晃这个什么东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130105
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721130105,
					"content": "记得是叫「御神签箱」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130106
					]
				},
				{
					"id": 721130106,
					"content": "没错。从里面会掉出一根竹签。把这根竹签给我，我会给你对应的纸片儿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130107
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721130107,
					"content": "好像叫「御神签」来着…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130108
					]
				},
				{
					"id": 721130108,
					"content": "这种事情怎样都好吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130109
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721130109,
					"content": "我有问题！如果说，如果说我们抽到了凶签，要怎么办呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721130110,
					"content": "是命运让你抽到凶签，你还想怎样？啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130111
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721130111,
					"content": "欸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721130112,
					"content": "外头那个像架子的东西…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130113
					]
				},
				{
					"id": 721130113,
					"content": "啧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130114
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721130114,
					"content": "她很露骨地「啧」了耶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721130115,
					"content": "我看看…是这样的。「把凶签捆到『御签挂』上，就可以逢凶化吉」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130116
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721130116,
					"content": "啊，对哦！如果你抽到凶签，把它捆到那个架子上就行了嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130117
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721130117,
					"content": "他们还真是…不对，我们「鸣神大社」很温柔的。所以就算抽到了凶签，也会给你们转运的机会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130118
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721130118,
					"content": "虽然感觉哪里好像怪怪的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721130119,
					"content": "#{NICKNAME}，我们求签吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
