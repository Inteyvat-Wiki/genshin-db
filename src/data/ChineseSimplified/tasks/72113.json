			"dialogs": [
				{
					"id": 721130201,
					"content": "我瞧瞧我瞧瞧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721130202,
					"content": "哇！写着「大吉」耶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721130203,
					"content": "看来今天是派蒙的幸运日！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721130204,
					"content": "你的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130205
					]
				},
				{
					"id": 721130205,
					"content": "没错！你的幸福就是派蒙的幸福呀！所以反过来说，派蒙幸福，你也幸福。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721130206,
					"content": "我吃到好吃的就会幸福。所以，为了你自己的幸福，请给我吃好吃的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
