			},
			"dialogs": [
				{
					"id": 722250301,
					"content": "栖木焕发生机了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250302
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722250302,
					"content": "供奉栖木，总算是完成了呢。真不容易。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250303
					],
					"speakerTitle": "阿久"
				},
				{
					"id": 722250303,
					"content": "哼哼，我们可是处理这种问题的专家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722250304,
					"content": "和「导光仪式」差不多。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250305
					]
				},
				{
					"id": 722250305,
					"content": "为了处理一件事，需要解决分散在三个地点的三个问题…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722250306,
					"content": "总感觉，和你一起，总会遇到这种事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722250307,
					"content": "虽然别的事情我不是很明白，但大人中有这样的说法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250308
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722250308,
					"content": "就是「万事皆三」喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250309
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722250309,
					"content": "万事皆三…是什么意思？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722250310,
					"content": "嗯…大概就是，任何事情都要经历三次以后，才能迎来结果吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250311
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722250311,
					"content": "比如说，吉兆要发生三次，好运才会真正降临。然后，如果凶兆发生了三次，那一定会发生坏事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250312
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722250312,
					"content": "做事情的时候，也会遇到三次困难，第四次才会成功。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250313
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722250313,
					"content": "但是，那样的话，不应该是「万事皆四」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722250314,
					"content": "也是呢！派蒙的数学真好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250315
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722250315,
					"content": "哼哼，那当然了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250316,
						722250318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722250316,
					"content": "重点是数学？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250317
					]
				},
				{
					"id": 722250317,
					"content": "话说回来，阿久的伤没问题吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722250319,
					"content": "不用担心哦。阿久哥总是这样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250320
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722250320,
					"content": "真是难堪…希望不会影响祭典。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250321
					],
					"speakerTitle": "阿久"
				},
				{
					"id": 722250321,
					"content": "不然的话，就太对不起阿瑠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250322
					],
					"speakerTitle": "阿久"
				},
				{
					"id": 722250322,
					"content": "怎么会呢。阿久哥一直都对我很好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250323
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722250323,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250324
					],
					"speakerTitle": "阿久"
				},
				{
					"id": 722250324,
					"content": "#{NICKNAME}{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}、派蒙，你们先走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250325
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722250325,
					"content": "我陪阿久哥多坐一会。然后，再为供奉收尾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722250318,
					"content": "阿久受的伤…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250319
					]
				}
			]
