			"dialogs": [
				{
					"id": 722250101,
					"content": "好疼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250102
					],
					"speakerTitle": "阿久"
				},
				{
					"id": 722250102,
					"content": "#{NICKNAME}{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}、派蒙！你们来得正好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250103
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722250103,
					"content": "发生什么事了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250104
					]
				},
				{
					"id": 722250104,
					"content": "脚崴着了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250105
					],
					"speakerTitle": "阿久"
				},
				{
					"id": 722250105,
					"content": "阿久哥又受伤了，能请你们供奉栖木吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250106,
						722250108
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722250106,
					"content": "这样的发展也不是没猜到…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250107
					]
				},
				{
					"id": 722250107,
					"content": "没问题，那就交给我们吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722250109,
					"content": "太感谢了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250110
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722250110,
					"content": "对了，阿瑠你不是也对「元素」很敏感吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722250111,
					"content": "为什么你不自己去供奉栖木呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722250112,
					"content": "唔…以前我也在祭典里做过各种各样的事情，但最后的结果好像不太好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250113,
						722250115,
						722250116
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722250113,
					"content": "为什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250114
					]
				},
				{
					"id": 722250114,
					"content": "我也不知道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250117
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722250117,
					"content": "真没办法，那栖木就交给我们吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722250115,
					"content": "那就交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250117
					]
				},
				{
					"id": 722250116,
					"content": "受伤的人就交给你了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250117
					]
				},
				{
					"id": 722250108,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250109
					]
				}
			]
		},
