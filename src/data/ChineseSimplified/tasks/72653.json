			"dialogs": [
				{
					"id": 726530101,
					"content": "旅行者，你回来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530102
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726530102,
					"content": "你之前带回的那些晶片，我在船上研究了一番。看起来它们还很…「年轻」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530103
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726530103,
					"content": "这说明它们来自于新形成的元素结团…嗯，打个比方说，就像不久前才留在雪地上的、更深些的脚印。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530104
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726530104,
					"content": "而现在呢，我希望你能帮我调查一下那些更「浅」的脚印…逆着它们的方向，往源头追查！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530105
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726530105,
					"content": "所谓「更浅的脚印」呢，就是指那些已经凝结到一定程度，在地面附近沉积的雷元素聚合体。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530106
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726530106,
					"content": "如果能够取得一定量的样本加以分类对比，或许能够画出大致的路线图…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530107
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726530107,
					"content": "什么…深浅脚印、路线图的…没听懂呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726530108,
					"content": "唔…确实难懂呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726530109
					]
				},
				{
					"id": 726530109,
					"content": "哈哈，我打的比方可能有点不太贴切，不过你到了报告地点，自然就会知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530110
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726530110,
					"content": "好了，闲话不多说，快点出发吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "慕珍"
				}
			]
		}
	]
