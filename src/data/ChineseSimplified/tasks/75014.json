					"nextDialogs": [
						750141030
					]
				},
				{
					"id": 750141030,
					"content": "就算为了让自己看起来帅气一点你也应该配合我的说法吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141031
					],
					"speakerTitle": "派蒙"
				},
				{
