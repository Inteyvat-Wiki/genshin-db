					"content": "很有活力，看起来很健康。角上有特别的花纹…真不错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141204
					],
					"speakerTitle": "葵莉娅"
				},
				{
					"id": 750141204,
					"content": "不过你们为什么会一起出现在这里？是我的管教出了问题？不，这不可能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141205
					],
					"speakerTitle": "葵莉娅"
				},
				{
					"id": 750141205,
					"content": "唔？呀呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141206
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750141206,
					"content": "嗯？它怎么了？是它带你来的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141207
					],
					"speakerTitle": "葵莉娅"
				},
