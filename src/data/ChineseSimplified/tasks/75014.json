					"nextDialogs": [
						750141024
					]
				},
				{
					"id": 750141024,
					"content": "你的目标也太低了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141025
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750141013,
					"content": "什么，他居然小看我。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141014
					]
				},
				{
					"id": 750141014,
					"content": "哪里哪里，不敢不敢！这情况如果是特马乔会怎么说…对了，是训练赛道没有给你提供足够发挥的空间！",
