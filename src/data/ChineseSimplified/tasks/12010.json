			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"松坂",
					"彩香",
					"岩夫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120100101,
					"content": "#大{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}，我们在找「大貉妖」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100102
					],
					"speakerTitle": "松坂"
				},
				{
					"id": 120100102,
					"content": "你知道「大貉妖」住在哪里吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100103
					],
					"speakerTitle": "彩香"
				},
				{
					"id": 120100103,
					"content": "「大貉妖」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120100104,
					"content": "欸，你们没有听过吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100105
					],
					"speakerTitle": "松坂"
				},
				{
					"id": 120100105,
					"content": "就是一种很厉害又很狡猾的妖怪，能变成各种各样的东西，神出鬼没，喜欢骗人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100106
					],
					"speakerTitle": "松坂"
				},
				{
					"id": 120100106,
					"content": "我们家的稻米就被「大貉妖」偷吃过，有一次我爸爸还被「大貉妖」踹进了河里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100107
					],
					"speakerTitle": "岩夫"
				},
				{
					"id": 120100107,
					"content": "好调皮的家伙啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120100108,
					"content": "你们为什么要找它呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100109
					]
				},
				{
					"id": 120100109,
					"content": "因为我们终于有能打跑它的办法了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100110
					],
					"speakerTitle": "彩香"
				},
				{
					"id": 120100110,
					"content": "我爸爸说，「大貉妖」最喜欢捉弄那些老是不回家的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100111
					],
					"speakerTitle": "岩夫"
				},
				{
					"id": 120100111,
					"content": "只要打跑了「大貉妖」，我们就随时都可以出门玩啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100112
					],
					"speakerTitle": "岩夫"
				},
				{
					"id": 120100112,
					"content": "但如果是厉害的妖怪，你们不会害怕吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120100113,
					"content": "你们的爸爸妈妈也会担心你们的安全吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120100114,
					"content": "不会啊？今天我告诉爸爸，说我们几个人要去找「大貉妖」，他什么都没说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100115
					],
					"speakerTitle": "岩夫"
				},
				{
					"id": 120100115,
					"content": "说不定是现在的「大貉妖」很弱，只能躲起来休息！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100116
					],
					"speakerTitle": "松坂"
				},
				{
					"id": 120100116,
					"content": "嗯！只要在「大貉妖」恢复妖力之前回家，就不会有危险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100117
					],
					"speakerTitle": "彩香"
				},
				{
					"id": 120100117,
					"content": "唔，怎么听起来怪怪的？但好像又说不清楚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100118,
						120100119,
						120100120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120100118,
					"content": "如果被盯上，躲在家也无济于事吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100121
					]
				},
				{
					"id": 120100121,
					"content": "嗯，我感觉「大貉妖」像故事里才有的妖怪，现实里并不存在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100122,
						120100123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120100122,
					"content": "我也觉得是传说。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100124
					]
				},
				{
					"id": 120100124,
					"content": "那就告诉他们吧，这样就不用白费工夫到处找了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120100125,
					"content": "听我说哦，你们不用再找「大貉妖」了，因为它是不存在的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120100126,
					"content": "欸——？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100127
					],
					"speakerTitle": "松坂"
				},
				{
					"id": 120100127,
					"content": "不会吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100128
					],
					"speakerTitle": "彩香"
				},
				{
					"id": 120100128,
					"content": "不可能，我爸爸不会骗我的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100129
					],
					"speakerTitle": "岩夫"
				},
				{
					"id": 120100129,
					"content": "你们的家里人只是担心你们啦，到处乱跑的话是很危险的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120100130,
					"content": "不对，不对，肯定有「大貉妖」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100131
					],
					"speakerTitle": "岩夫"
				},
				{
					"id": 120100131,
					"content": "对啊，宵宫姐姐还给我们准备了武器！要教我们怎么炸妖怪呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100132
					],
					"speakerTitle": "松坂"
				},
				{
					"id": 120100132,
					"content": "欸，宵宫…？宵宫姐姐？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120100133,
					"content": "「大貉妖」的故事，我们讲给了宵宫姐姐听。她就叫我们不要害怕，要学会怎么把它赶走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100134
					],
					"speakerTitle": "彩香"
				},
				{
					"id": 120100134,
					"content": "我们等了好久，终于宵宫姐姐说，今天是个好机会，所以我们就出来找「大貉妖」了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100135
					],
					"speakerTitle": "松坂"
				},
				{
					"id": 120100135,
					"content": "就是就是，宵宫姐姐经常陪我们玩，给我们讲故事，她绝对不会骗人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100136
					],
					"speakerTitle": "岩夫"
				},
				{
					"id": 120100136,
					"content": "但、但是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100137
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120100137,
					"content": "哼，我们走！去找宵宫姐姐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100138
					],
					"speakerTitle": "岩夫"
				},
				{
					"id": 120100138,
					"content": "等等，别走啊，别走！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120100139,
					"content": "唉，惹他们生气了。可是，我也是担心他们才…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100140
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120100140,
					"content": "不知道为什么还听到了宵宫的名字，我们还是追上去看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120100123,
					"content": "只是不想让孩子到处乱跑吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100124
					]
				},
				{
					"id": 120100119,
					"content": "我们从来没有见过这种妖怪。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100121
					]
				},
				{
					"id": 120100120,
					"content": "爸爸的态度有点奇怪…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100121
					]
				}
			]
		},
		{
			"id": 1201002,
			"completionStepIds": [
				1201002
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201002",
							"2"
						],
						"stepId": 1201002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"宵宫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120100201,
					"content": "#别伤心，别这么伤心啦，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_MALE_PRONOUN_SHE]}和你们开玩笑的，「大貉妖」怎么会不存在呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100202
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100202,
					"content": "可、可是，我们确实没有见过「大貉妖」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100203
					],
					"speakerTitle": "松坂"
				},
				{
					"id": 120100203,
					"content": "那是因为「大貉妖」很厉害啊，就是因为它这么厉害，才需要你们出手对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100204
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100204,
					"content": "嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100205
					],
					"speakerTitle": "松坂"
				},
				{
					"id": 120100205,
					"content": "不用着急，也不用灰心，要成为很厉害的英雄，耐心和智慧也是不能少的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100206
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100206,
					"content": "就算现在没找到它，烟花会开始之前，它一定会出现的。在那之前，记得来宵宫姐姐家领武器，知道了嘛？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100207
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100207,
					"content": "点燃我特制的烟花，无论「大貉妖」有多厉害，都能把它吓走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100208
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100208,
					"content": "家里的东西，田里的庄稼，还有爸爸妈妈，都轮到你们来保护了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100209
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100209,
					"content": "知道了！既然宵宫姐姐都这么说了，我们就再耐心一点！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100210
					],
					"speakerTitle": "松坂"
				},
				{
					"id": 120100210,
					"content": "对了对了，别着急走。我这里还有几张纸条，你们一人一张，记得带回去给爸爸妈妈，让他们好好保管。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100211
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100211,
					"content": "只要说是宵宫姐姐给的，他们就明白是什么意思啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100212
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100212,
					"content": "知道啦！谢谢宵宫姐姐！那我们就先回去了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100213
					],
					"speakerTitle": "岩夫"
				},
				{
					"id": 120100213,
					"content": "谢谢宵宫姐姐！你也要早点回来陪我们玩哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100214
					],
					"speakerTitle": "彩香"
				},
				{
					"id": 120100214,
					"content": "好的好的，路上小心，待会儿我们再见啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100215
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100215,
					"content": "那、那个…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100216,
						120100217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120100216,
					"content": "好久不见。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100218
					]
				},
				{
					"id": 120100218,
					"content": "果然是你们，听孩子们的描述我就猜到了。没关系，不怪你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100219
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100219,
					"content": "「大貉妖」在孩子中的人气很高，草率地否定它的存在，当然会让孩子伤心啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100220
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100220,
					"content": "那么，「大貉妖」的确是不存在的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120100221,
					"content": "嗯，第一次听到它的故事，我就觉得，多半只是孩子们的父母编出来的妖怪，为了让孩子们不要乱跑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100222
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100222,
					"content": "不过孩子们来问我的时候，我没有拆穿，而是说，「大貉妖」外貌可爱，喜欢恶作剧，但不喜欢伤人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100223
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100223,
					"content": "他们现在相信的，大概都是我编出来的形象啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100224
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100224,
					"content": "原来都是你的创意啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120100225,
					"content": "像这样延续谎言，是不对的吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100226
					]
				},
				{
					"id": 120100226,
					"content": "或许吧，但不管怎么样，也轮不到我去当这个拆穿谎言的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100227
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100227,
					"content": "他们的父母可能只是为了让孩子不要乱跑，但也可能有其他的考虑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100228
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100228,
					"content": "在我不了解的情况下，我就草率地说「『大貉妖』什么的，不存在的哦？」很可能会害了他们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100229
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100229,
					"content": "而且，对孩子来说，相信并且喜欢就好，真真假假什么的，不是那么重要的事啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100230
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100230,
					"content": "我心里也有很多很多憧憬啊，点燃之后会旋转喷出七彩虹光的「火钻」，隐居深山为仙境指路的「雾灵」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100231
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100231,
					"content": "我知道都是不存在的，但是我还是愿意相信。别人要是在我面前说，「别傻了，不存在的」——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100232
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100232,
					"content": "我就会朝他做鬼脸，扔石头！因为很讨人厌！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100233,
						120100235
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100233,
					"content": "我大概明白这种感觉了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100234
					]
				},
				{
					"id": 120100234,
					"content": "对吧！就算是假的，但是很帅气，很浪漫啊，轮不到别人来否定吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100237
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100237,
					"content": "童年曾经相信过的东西，经历过的事，慢慢都会变成无可替代的宝物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100238
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100238,
					"content": "你们小时候也相信过战胜恶龙的勇者，斩破黑暗的圣剑吧，我觉得其实是一样的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100239
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100239,
					"content": "拆穿了童话，又要告诉孩子们什么呢？说稻妻现在锁国了？或者，「眼狩令」的故事？都太早了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100240
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100240,
					"content": "唔…对！太早了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100241,
						120100242
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120100241,
					"content": "你只记得最后一句了吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100243
					]
				},
				{
					"id": 120100243,
					"content": "哈哈，不管有没有听懂，总之放心吧，我会注意孩子们的安全，好好保护他们的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100244
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100244,
					"content": "好了，我差不多也该回去了，「长野原烟花会」就在眼前，还有好多事情要忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100245
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100245,
					"content": "「长野原烟花会」？是你们家举办的活动吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100246
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120100246,
					"content": "对啊，毕竟挂了我们家的名字嘛，这个活动在稻妻很有名。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100247
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100247,
					"content": "对了对了，你们接下来有什么事吗？没事的话，就一起来参加吧，我来给你们准备一个超好看的烟花！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100248,
						120100249
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100248,
					"content": "早就想看了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100250
					]
				},
				{
					"id": 120100250,
					"content": "嘿嘿，那我先带你们去长野原，见见我的老爹吧！烟花会之前，还有几个烟花没做完呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100249,
					"content": "那我就不客气了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100250
					]
				},
				{
					"id": 120100242,
					"content": "不用太勉强去捧场啦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100243
					]
				},
				{
					"id": 120100235,
					"content": "为什么和孩子一样…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100236
					]
				},
				{
					"id": 120100236,
					"content": "因为真假无所谓啊，很帅气，很浪漫，就值得相信，轮不到别人来否定吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100237
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100217,
					"content": "又见面了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100218
					]
				}
			]
		},
		{
			"id": 1201003,
			"completionStepIds": [
				1201003
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201003",
							"2"
						],
						"stepId": 1201003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"长野原龙之介"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120100301,
					"content": "老爹，我回来啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100302
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100302,
					"content": "马上就到烟花会了吧，各家各户的烟花，都张罗得差不多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100303
					],
					"speakerTitle": "长野原龙之介"
				},
				{
					"id": 120100303,
					"content": "这两个人，没见过呢。是新朋友？还是客人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100304
					],
					"speakerTitle": "长野原龙之介"
				},
				{
					"id": 120100304,
					"content": "#都算吧，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_MALE_PRONOUN_SHE]}们是前不久才到这里来的，既然来了稻妻，不看烟花怎么行呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100305
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100305,
					"content": "哈哈哈，不管怎么样，找个地方歇歇脚吧。我长野原龙之介，给你们讲讲长野原家的悠久历史。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100306
					],
					"speakerTitle": "长野原龙之介"
				},
				{
					"id": 120100306,
					"content": "这个先等会儿，老爹，我有事情问你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100307
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100307,
					"content": "很久很久以前…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100308
					],
					"speakerTitle": "长野原龙之介"
				},
				{
					"id": 120100308,
					"content": "唉，老爹又自顾自地开始讲故事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100309
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100309,
					"content": "不好意思啊，老爹以前受了伤，那之后耳朵就不太好用了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100310
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100310,
					"content": "但刚刚的对话，好像微妙地成立了呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120100311,
					"content": "然后呢，人们又花了好长时间才明白，有一种矿石，它的粉末，能燃出很漂亮很漂亮的颜色。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100312
					],
					"speakerTitle": "长野原龙之介"
				},
				{
					"id": 120100312,
					"content": "老爹，老爹，先等等！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100313
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100313,
					"content": "啊？怎么了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100314
					],
					"speakerTitle": "长野原龙之介"
				},
				{
					"id": 120100314,
					"content": "之前订购的那些做烟花的材料，已经送过来了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100315
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100315,
					"content": "昨天的烟花都发出去啦，前天的也是，大前天的也是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100316
					],
					"speakerTitle": "长野原龙之介"
				},
				{
					"id": 120100316,
					"content": "不是，老爹，我是说材料，之前订购的材料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100317
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100317,
					"content": "今天的也做得差不多啦，不用担心，你老爹的手艺还没退步呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100318
					],
					"speakerTitle": "长野原龙之介"
				},
				{
					"id": 120100318,
					"content": "不是，是材料！做烟花需要用到的材料，矿石！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100319
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100319,
					"content": "什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100320
					],
					"speakerTitle": "长野原龙之介"
				},
				{
					"id": 120100320,
					"content": "矿石材料！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100321
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100321,
					"content": "哦哦，矿石材料？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100322
					],
					"speakerTitle": "长野原龙之介"
				},
				{
					"id": 120100322,
					"content": "对对对，矿石材料！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120100323,
					"content": "啊，对不起…终于传达到了，我有点激动，嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100324
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120100324,
					"content": "材料的话，还没送过来呢，具体原因，好像过来说了一下，但我没听清…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100325
					],
					"speakerTitle": "长野原龙之介"
				},
				{
					"id": 120100325,
					"content": "没关系，没关系，知道这个就行了，那就晚点再做。等他们送过来，老爹记得要收一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100326
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100326,
					"content": "嗯嗯，放心吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100327
					],
					"speakerTitle": "长野原龙之介"
				},
				{
					"id": 120100327,
					"content": "不好意思，可能有点吵到你们了，如果有什么事要问老爹，就会像现在这样有点麻烦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100328,
						120100330
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100328,
					"content": "但感觉他很热情好客。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100329
					]
				},
				{
					"id": 120100329,
					"content": "嘿嘿，对啊，老爹是很好的人，大家也都很尊重他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100332
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100332,
					"content": "老爹因为听不清，所以从不和别人争论，也不否认别人的话，总是乐呵呵地听着。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100333
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100333,
					"content": "小的时候，我以为是老爹他特别理解我，觉得我说什么都是对的，所以我什么话都会和老爹说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100334
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100334,
					"content": "后来我知道了，老爹乐呵呵的，只是因为他听不清楚，不过我还是每天都给他讲故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100335
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100335,
					"content": "欸？这又是为什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100336
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120100336,
					"content": "光是看到老爹笑，我就很开心啊。这样他也不会寂寞吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100337
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100337,
					"content": "不过，话说回来，既然材料还没送到，烟花会又近在眼前了，我们得想想别的办法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100338
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100338,
					"content": "那个，宵宫，是你回来了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100339
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120100339,
					"content": "呜哇？！你别吓唬人啊，不是让你别随便说话吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100340
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100340,
					"content": "对、对不起…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100341
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120100341,
					"content": "你等我一下，我现在过来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100330,
					"content": "但感觉他的性格和你很像。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100331
					]
				},
				{
					"id": 120100331,
					"content": "嘿嘿，经常有人这么说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100332
					],
					"speakerTitle": "宵宫"
				}
			]
		},
		{
			"id": 1201004,
			"completionStepIds": [
				1201004
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201004",
							"2"
						],
						"stepId": 1201004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 120100401,
					"content": "没有人在看这边，出来吧，到侧面来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100402
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100402,
					"content": "幸好刚刚没有惊动天领奉行的人，不然我们就都有危险了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100403
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100403,
					"content": "是我太心急了，但我听到你回来了，我就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100404
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120100404,
					"content": "放心吧，朔次郎，至少目前一切都在计划之中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100405
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100405,
					"content": "我们等下会去找做烟花的材料，顺便也会搞定船的事，就是之前答应过你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100406
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100406,
					"content": "谢谢你，能帮我这么多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100407,
						120100408
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120100407,
					"content": "这位是？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100409
					]
				},
				{
					"id": 120100409,
					"content": "他是我们家以前的顾客，前段时间刚刚从外面逃回稻妻，结果在偷渡的时候被发现了，现在正在被天领奉行通缉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100410
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100410,
					"content": "通缉？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120100411,
					"content": "你也小点声啦，别引起不必要的注意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100412
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100412,
					"content": "被抓到的话，朔次郎不知道会被判什么罪，为了让他避开这个风头，只能想办法找艘船，把他送出去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100413
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100413,
					"content": "可是外海不是有雷暴吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100414
					]
				},
				{
					"id": 120100414,
					"content": "是啊，这也是非常危险的办法，但现在没那么多选择可以挑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100415
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100415,
					"content": "要是一不小心翻了船，那就…唔唔！溺水很可怕的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100416
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120100416,
					"content": "这么危险的话，当初不回来不就好了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100417
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120100417,
					"content": "因为，有不得不做的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100418
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120100418,
					"content": "可是我一回来，就听说了很多难以置信的变化。本来我下定了决心，但现在又不知道该怎么办了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100419
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120100419,
					"content": "我也不想多给宵宫和龙之介先生添麻烦，他们能收留我，我就很感激了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100420
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120100420,
					"content": "没关系没关系，不用客气。还记得我说的话吧，「只要有我们家的纸条，就一直是长野原的客人。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100421
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100421,
					"content": "纸条…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100422,
						120100423
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120100422,
					"content": "有点印象。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100424
					]
				},
				{
					"id": 120100424,
					"content": "嗯，之前孩子们拿到的也是同样的东西。只要是想要纪念某件事而来定做烟花的客人，我们家就会附赠一张纸条。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100425
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100425,
					"content": "纸条的内容只有我们家的人能看懂，是制作这种烟花的具体配方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100426
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100426,
					"content": "只要看了这个纸条，无论是过了十年还是一百年，长野原都能保证做出和当年一模一样的烟花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100427
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100427,
					"content": "哇，感觉很帅的样子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100428
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120100428,
					"content": "家里的老传统了，只要是老顾客都知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100429
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100429,
					"content": "嗯，那时候还是我的爸妈找龙之介先生做的烟花，现在想来，也有二十年了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100430
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120100430,
					"content": "唉，实在想不到现在会变成这样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100431
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120100431,
					"content": "没关系啦。只有实在迫不得已，才需要乘船逃离稻妻。我还会帮你想其他办法的，如果能留下来那当然更好啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100432
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100432,
					"content": "不管是什么原因，只要是客人找上门来有事相求，就不能让他失望而归。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100433
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100433,
					"content": "谢谢你，这样我就还能有点时间，再考虑考虑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100434
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120100434,
					"content": "好啦，也不要在外面站太长时间，快进屋去吧。等我有了消息，再回来告诉你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100435
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100435,
					"content": "嗯，太麻烦你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100436
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120100436,
					"content": "唉，明明是土生土长的稻妻人，却得不到回来的许可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100437
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100437,
					"content": "对了，你们也是最近才来稻妻的吧，是怎么获得许可的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100438
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100438,
					"content": "我办理了很麻烦的离岛手续。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100439
					]
				},
				{
					"id": 120100439,
					"content": "再靠勘定奉行的大小姐柊千里的帮忙，才顺利到了这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100440
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120100440,
					"content": "原来如此，有大人物帮忙啊。那看来对朔次郎也没什么参考价值了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100441
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100441,
					"content": "唉，要是我们的奉行众能通融一点就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100442
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100442,
					"content": "你们去过的地方，应该都不像稻妻这样吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100443,
						120100444
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100443,
					"content": "确实。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100445
					]
				},
				{
					"id": 120100445,
					"content": "唉，不管怎么样，还是要想办法帮他的忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100446
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100446,
					"content": "不好意思，本来是邀请你们来看烟花的，结果现在不得不东跑西跑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100447
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100447,
					"content": "如果你们觉得麻烦，可以过一会儿再来我家找我，我一个人去搞定材料和船的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100448,
						120100449
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100448,
					"content": "我不介意陪你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100450
					]
				},
				{
					"id": 120100450,
					"content": "那太好了，我们先去帮朔次郎准备船！边走边聊吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120100449,
					"content": "我也想看看烟花会是怎么准备的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100450
					]
				},
				{
					"id": 120100444,
					"content": "神也有神的想法。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100445
					]
				},
				{
					"id": 120100423,
					"content": "是不是就是交给孩子的那个？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100424
					]
				},
				{
					"id": 120100408,
					"content": "为什么藏在宵宫的家里？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100409
					]
				}
			]
		},
		{
			"id": 1201005,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201004",
							"2"
						],
						"stepId": 1201004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"长野原龙之介"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120100501,
					"content": "你们有事就先忙，忙完再回来听故事也不迟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100502
					],
					"speakerTitle": "长野原龙之介"
				},
				{
					"id": 120100502,
					"content": "我的时间很多，故事嘛，也有很多很多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "长野原龙之介"
				}
			]
		}
	]
