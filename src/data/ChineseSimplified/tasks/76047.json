				]
			},
			"dialogs": [
				{
					"id": 760470201,
					"content": "哟，这不是老主顾吗，今天也来买投资券吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470202
					],
					"speakerTitle": "萨维特"
				},
				{
					"id": 760470202,
					"content": "听说你这儿的投资券是骗人的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760470203
					]
				},
				{
					"id": 760470203,
					"content": "瞧你这话说的，该不会是因为这阵子都在亏损，所以才胡思乱想的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470204
					],
					"speakerTitle": "萨维特"
				},
				{
					"id": 760470204,
					"content": "这世上哪能有稳赚不赔的买卖呢，有人输就有人赢，想当初我在须弥城…咳，不过是这阵子运气不好，运气这事儿可说不准。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470205
					],
					"speakerTitle": "萨维特"
				},
				{
					"id": 760470205,
					"content": "「希望」啊就是得坚持下去才能抓到的。只要继续投资，肯定有获得回报的那一天的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470206,
						760470208
					],
					"speakerTitle": "萨维特"
				},
				{
					"id": 760470206,
					"content": "好吧。我还会再来的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760470207
					]
				},
				{
					"id": 760470207,
					"content": "喂！你怎么这么轻易就被打发了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760470209,
					"content": "#骗我们是不会有好下场的！我们…对了，我们可是大名鼎鼎的{NICKNAME}和派蒙！在那夏镇也有不少朋友的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760470210,
					"content": "「朋友」？什么朋友…难、难道是那种「朋友」？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470211
					],
					"speakerTitle": "萨维特"
				},
				{
					"id": 760470211,
					"content": "…嗯？呃，对！就是那种「朋友」，不仅有，而且还很多呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760470212,
					"content": "哎呀！你们怎么不早说，惹不起，真的惹不起。这些全都给你们，我不会再卖投资券给你们了，你们快些走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "萨维特"
				},
				{
					"id": 760470208,
					"content": "别想再唬我。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760470209
					]
				}
			]
		}
	]
