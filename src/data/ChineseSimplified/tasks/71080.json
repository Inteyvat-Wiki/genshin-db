					"nextDialogs": [
						710800619
					]
				},
				{
					"id": 710800619,
					"content": "「…天与水的颜色重又在晶石表面流动，紫红色的溃斑就此褪去…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800620
					],
					"speakerTitle": "塔列辛"
				},
				{
					"id": 710800620,
					"content": "#「…古老遗迹中的构装巨兽，其头上正挨了{NICKNAME}的铁拳，昏昏沉沉之时…利箭救星顷刻而至！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800621
					],
					"speakerTitle": "塔列辛"
				},
				{
					"id": 710800621,
					"content": "「…那相助旅者的神秘客消失无踪，再看蛇行的构装巨兽，却已被晶石砸得七零八落…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "塔列辛"
				}
