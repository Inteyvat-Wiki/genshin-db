				]
			},
			"dialogs": [
				{
					"id": 761150301,
					"content": "只知重复昨日之我的可悲之人，和预想的一样，不得不说也有些无趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150302
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 761150302,
					"content": "他明明都坚持不做坏事那么久了，最后却还是…还是说，他天生就是坏人，坏人是不会变好的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150303,
						761150304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761150303,
					"content": "坚持做好事显然更难。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761150305
					]
				},
				{
					"id": 761150305,
					"content": "选择的权利始终都在，哪怕是刚才，他也可以选择认错忏悔。只是他又一次选错了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150306
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 761150306,
					"content": "落子皆错，方有今日这盘死局。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150307
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 761150307,
					"content": "#不说这些了，总归是又了结了一桩工作。悬赏的证物就依约定，由{NICKNAME}交给勒塞克吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150308
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 761150308,
					"content": "#有老板和{NICKNAME}出马就是叫人放心！这次我真的放假啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150309
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761150309,
					"content": "呵呵，既然休息的一回合已经结束，雅珂达也该开始新的工作了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150310
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 761150310,
