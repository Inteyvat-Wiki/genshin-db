			"dialogs": [
				{
					"id": 761150201,
					"content": "…我没招惹过你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150202
					],
					"speakerTitle": "德文特"
				},
				{
					"id": 761150202,
					"content": "看来你很清楚我们为什么来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150203
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 761150203,
					"content": "…那都是过去的事，现在我只想过平静的生活。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150204
					],
					"speakerTitle": "德文特"
				},
				{
					"id": 761150204,
					"content": "靠夺取他人的身份吗？先是朱亚尼，但没有成功，之后又是德文特。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150205
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 761150205,
					"content": "不过拙劣的扮演迟早被揭穿，不会再有下一个受害者了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150206
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 761150206,
					"content": "…朱亚尼？我想要夺取他的身份？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150207
					],
					"speakerTitle": "德文特"
				},
				{
					"id": 761150207,
					"content": "那不是他的…那凭什么是他的？就因为他长得更讨人喜欢，说话更会奉承吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150208
					],
					"speakerTitle": "德文特"
				},
				{
					"id": 761150208,
					"content": "我们明明是一样的！…被他拿走的东西，本来就是属于我的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150209
					],
					"speakerTitle": "德文特"
				},
				{
					"id": 761150209,
					"content": "那德文特先生和游商呢？他们又对你做了什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150210
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761150210,
					"content": "…他们？他们问了不该问的问题，就像你们一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150211
					],
					"speakerTitle": "德文特"
				},
				{
					"id": 761150211,
					"content": "受死吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "德文特"
				}
			]
		},
