	"talks": [
		{
			"id": 1102902,
			"completionStepIds": [
				1102902
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102902",
							"2"
						],
						"stepId": 1102902,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"嘉良"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110290201,
					"content": "此地…似乎有不祥的气息，连我也能感觉到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290202
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110290202,
					"content": "我对这里，有点印象…呃…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290203
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290203,
					"content": "嘉良！你还好吧？要不然，你先在这里休息，我们下去找找？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110290204,
					"content": "不行…江蓠她，一定还在等我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290205
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290205,
					"content": "呼…快点出发吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嘉良"
				}
			]
		},
		{
			"id": 1102903,
			"completionStepIds": [
				1102903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102903",
							"2"
						],
						"stepId": 1102903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"白术"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110290301,
					"content": "哇…好阴森的感觉，不知道前面会有什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110290302,
					"content": "这里的开凿痕迹很粗糙，年代也有些久远，看着像是个盗洞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290303
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110290303,
					"content": "盗洞？说起来，这附近确实有关于宝藏的传说，会不会是盗宝团的人挖的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110290304,
					"content": "看四处遗落的工具，确实有这可能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290305
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110290305,
					"content": "…不过他们为什么连工具也不收拾，就将这里荒废了呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290306
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110290306,
					"content": "…我想起来了，她带我来过这里，说是在洞里发现了救我的方子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290307
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290307,
					"content": "但是…但是她说，这种方法会让我…可恶，怎么想不起来了！可恶…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290308
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290308,
					"content": "不必勉强自己，先往前探索吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "白术"
				}
			]
		},
		{
			"id": 1102904,
			"completionStepIds": [
				1102904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102904",
							"2"
						],
						"stepId": 1102904,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"嘉良",
					"白术",
					"阿雩"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110290401,
					"content": "白先生，怎么样？江蓠她…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290402
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290402,
					"content": "还有脉象，但绝对谈不上乐观。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290403
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110290403,
					"content": "与你身上的毒素一样，盘踞此地的魔神残渣，已经侵蚀了她的神志…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290404
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110290404,
					"content": "若不尽快祛除，即使暂留一命，恐怕…也再难醒觉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290405
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110290405,
					"content": "那我们还等什么？赶快把魔神残渣除掉吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110290406,
					"content": "…事情没有那么简单，还记得白术在上面说过的话吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290407
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110290407,
					"content": "嘉良身上的毒，跟这里的魔神残渣遥相联系。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290408
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110290408,
					"content": "…一旦祛除了魔神残渣，他身上的毒，也会一并失效。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290409
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110290409,
					"content": "唔…嘉良身上的毒，不是用来压制心病的吗？那要是失效的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110290410,
					"content": "欸！难不成——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110290411,
					"content": "不错，如果祛除此地的魔神残渣，你的命数…也就到了尽头。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290412
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110290412,
					"content": "…果然，会这样吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290413
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290413,
					"content": "等等！我们忙活这么久，不就是为了给嘉良治病吗！怎么能…怎么能这样！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110290414,
					"content": "白术你见多识广，一定还有别的办法…对吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110290415,
					"content": "…或者，你可以继续服用此毒，多争取一点时间。师姐的情况…我们另外再想办法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290416
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110290416,
					"content": "看江蓠的样子，恐怕一直到昏迷前，都一心在为你炼药吧——或许她也希望你这么做？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290417
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110290417,
					"content": "…白先生，请你如实告诉我，江蓠她…还能撑多久？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290418
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290418,
					"content": "魔神残渣已经侵入肺腑，正常来说，不足三日，但如果我以秘法施救…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290419,
						110290420
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110290419,
					"content": "……！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110290421
					]
				},
				{
					"id": 110290421,
					"content": "…可那又有什么意义呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290422
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290422,
					"content": "白先生，来之前，已经有人向我说过魔神残渣的危害。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290423
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290423,
					"content": "如果继续靠这种东西活着，不仅江蓠要继续冒着危险给我炼药，将来要是失控，还会殃及周围，伤到江蓠跟阿雩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290424
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290424,
					"content": "…反正我这条命，十几年前就该交代了。能活到现在，看见阿雩长大，都算是岩王爷保佑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290425
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290425,
					"content": "如果最后能换江蓠回来…我就算是…就算是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290426
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290426,
					"content": "嘉良…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290427
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110290427,
					"content": "…哈，果然人该走的时候没走，就越来越贪心了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290428
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290428,
					"content": "#白先生、{NICKNAME}，请再给我一点时间，让我…多看江蓠一眼吧，一眼就够了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290429
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290429,
					"content": "…好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290430
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110290430,
					"content": "谢谢…抱歉，各位的恩情…得来世再报了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290431
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290431,
					"content": "嘉良他…白术、长生，真的连你们也没有办法了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290432
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110290432,
					"content": "寻常手段，只怕师姐这些年里都已试遍了。别的方法，我也没有几成把握…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290433
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110290433,
					"content": "生老病死，本就是凡人逃不开的宿命。若是轻易能救，江蓠也不必向非人之物伸手了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290434
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110290434,
					"content": "怎么会…江蓠好不容易才救了嘉良，嘉良又要牺牲自己去救江蓠…这、这到底有什么意义啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290435,
						110290436
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110290435,
					"content": "眼下我们唯一能做的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110290437
					]
				},
				{
					"id": 110290437,
					"content": "我还是习惯不了生离死别…不管见过多少次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290438
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110290438,
					"content": "凡人之间终有一别，死得其所，或许也是个不错的落幕？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290439
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110290439,
					"content": "…至少你的师父他们，都是这么想的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290440
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110290440,
					"content": "他们的选择确实令人动容，可那些「死得其所」的生命…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290441
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110290441,
					"content": "…往往，才是最不该逝去的生命啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290442
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110290442,
					"content": "…当初我们说好，只要阿雩长大到能帮你采药，就让我上路…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290443
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290443,
					"content": "你看现在，他都能带我上璃月港看病了，还去帮你挂了委托…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290444
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290444,
					"content": "…就算我不在，你们俩，也能好好活啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290445
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290445,
					"content": "……！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290446
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290446,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290447
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110290447,
					"content": "已经不需要更多时间了，请你们…送我上路吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290448
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290448,
					"content": "嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290449
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110290449,
					"content": "…唔…呃啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290450
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290450,
					"content": "…你的心智、记忆都会被它侵蚀…到最后，就跟死了没有两样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290451
					],
					"speakerTitle": "江蓠"
				},
				{
					"id": 110290451,
					"content": "…用吧，至少…我还能守着你们，看着阿雩长大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290452
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290452,
					"content": "…哈…哈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290453
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290453,
					"content": "…妈！爹的样子不太对…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290454
					],
					"speakerTitle": "阿雩"
				},
				{
					"id": 110290454,
					"content": "…没事的，没事的，妈妈这就去采药。我们一家人，谁都不会有事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290455
					],
					"speakerTitle": "江蓠"
				},
				{
					"id": 110290455,
					"content": "哈…都到这时候了，还想这些做什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290456
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290456,
					"content": "……！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290457
					],
					"speakerTitle": "江蓠"
				},
				{
					"id": 110290457,
					"content": "人啊，真是越活越贪心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290458
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290458,
					"content": "——！——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290459
					],
					"speakerTitle": "江蓠"
				},
				{
					"id": 110290459,
					"content": "真想…再听听你的声音啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290436,
					"content": "就是见证嘉良的觉悟。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110290437
					]
				},
				{
					"id": 110290420,
					"content": "你难道又想…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110290421
					]
				}
			]
		},
		{
			"id": 1102905,
