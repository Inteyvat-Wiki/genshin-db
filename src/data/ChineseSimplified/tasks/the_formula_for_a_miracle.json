			},
			"dialogs": [
				{
					"id": 110290501,
					"content": "…良…嘉良…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290502
					],
					"speakerTitle": "江蓠"
				},
				{
					"id": 110290502,
					"content": "——嘉良！嘉良！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290503
					],
					"speakerTitle": "江蓠"
				},
				{
					"id": 110290503,
					"content": "——爹！你醒了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290504
					],
					"speakerTitle": "阿雩"
				},
				{
					"id": 110290504,
					"content": "唔…江蓠…阿雩？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290505
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290505,
					"content": "…我不是…嗯？这些东西是…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290506
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290506,
					"content": "——死而复生的感觉如何呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290507
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110290507,
					"content": "若有什么不适或者异样…可否详细说与我听听？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290508
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110290508,
					"content": "白先生！我…我不是应该…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290509
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290509,
					"content": "呵呵，你确实已经死过一回了。如今的你，比起人类，更接近一具僵尸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290510
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110290510,
					"content": "…僵尸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290511
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290511,
					"content": "不错，在我们出发之前，我托七七准备了一帖…「不死之药」，将你的身体维系于生死的狭缝间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290512
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110290512,
					"content": "虽然距离真正的仙家之术还差得远，估计只能为你延续一点寿命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290513
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110290513,
					"content": "至于具体是几日、几月还是几年…我也想借此机会，再观察一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290514
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110290514,
					"content": "但无论时间多久，应该都够你好好道完别，再安心上路了——不知胡堂主，可还接受这样的安排？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290515
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110290515,
					"content": "「不死之药」…你究竟在背地里鼓捣了多久？居然连这种东西都给炼出来了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290516
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 110290516,
					"content": "名不副实的半成品罢了，如果不是嘉良的意志坚定，恐怕也发挥不了几分效用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290517
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110290517,
					"content": "说到底，我只是一名医师而已，不懂那么多生死循环、阴阳守常的大道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290518
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110290518,
					"content": "只知道眼前既然有一条值得拯救的生命，就没有理由不去拯救。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290519
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110290519,
					"content": "——何况在我们出发之前，不就是胡堂主，让嘉良来帮忙引路的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290520
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110290520,
					"content": "——唔，果然暴露了吗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290521
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 110290521,
					"content": "若非胡堂主特意提点，我们后来恐怕也不能及时找到师姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290522,
						110290523
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110290522,
					"content": "总觉得那时候还有人在…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110290524
					]
				},
				{
					"id": 110290524,
					"content": "难怪当时没提不死药的事，居然连那种时候都还在提防我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290525
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 110290525,
					"content": "呃…哈哈，胡堂主还嘱咐我不要随便乱说，结果，还是瞒不过白先生啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290526
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290526,
					"content": "哼哼，可不要小瞧了我的鼻子啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290527
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110290527,
					"content": "…我不过是看嘉良一直记挂着失踪的家人，想让他了却心愿，尽早上路而已，免得回头徘徊不去，还得费心超度…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290528
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 110290528,
					"content": "——就是没想到这单生意，最后还是被不卜庐截了胡！算了算了，就当作订单延期吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290529
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 110290529,
					"content": "唉，原本有个七七就已经够头疼了，现在居然又多了一个…早知道一开始就把他拉去往生堂该多好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290530
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 110290530,
					"content": "我…我一定会成为比白先生和妈更好的药师，再治好老爹的！你…别再打我爹的主意了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290531
					],
					"speakerTitle": "阿雩"
				},
				{
					"id": 110290531,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290532
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290532,
					"content": "哦？想跟往生堂抢生意的人，两个云来海都装不下，那你可得多多努力咯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290533
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 110290533,
					"content": "#{NICKNAME}，派蒙——我们改日再会啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290534
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 110290534,
					"content": "呼…终于，走了吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290535
					],
					"speakerTitle": "七七"
				},
				{
					"id": 110290535,
					"content": "总算告一段落了呢！为了难得的重聚，是不是该做点什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290536,
						110290537
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110290536,
					"content": "既然是派蒙提的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110290538
					]
				},
				{
					"id": 110290538,
					"content": "——嘿嘿，这种时候，就要做顿好吃的来庆祝一下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290539
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110290539,
					"content": "哈哈，上次在饭桌上跟江蓠阿雩聊天，都好像是上辈子的事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290540,
						110290541
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290540,
					"content": "来之不易的一餐呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110290542
					]
				},
				{
					"id": 110290542,
					"content": "哦哦——听上去很值得期待呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290543
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110290543,
					"content": "首先，得去集市上选最新鲜的食材——出发出发！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290544
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110290544,
					"content": "#{M#大哥哥}{F#大姐姐}！我、我也来帮忙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290545
					],
					"speakerTitle": "阿雩"
				},
				{
					"id": 110290545,
					"content": "白术，这次…真是多谢你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290546
					],
					"speakerTitle": "江蓠"
				},
				{
					"id": 110290546,
					"content": "师姐哪里的话，我不过是做了该做的事而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290547
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110290547,
					"content": "该做的事吗…白术、长生，要是方便的话，我们到外面叙叙旧吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "江蓠"
				},
				{
					"id": 110290541,
					"content": "我也久违地露一手吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110290542
					]
				},
				{
					"id": 110290537,
					"content": "我大概能猜到是什么。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110290538
					]
				},
				{
					"id": 110290523,
					"content": "原来是胡桃也在边上。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110290524
					]
				}
			]
		},
		{
			"id": 1102907,
			"completionStepIds": [
				1102907
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102907",
							"2"
						],
						"stepId": 1102907,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"江蓠",
					"白术",
					"阿雩",
					"七七"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110290701,
					"content": "…我已看过你的不死药，其中药理，与我所炼之毒，有几分相似。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290702
					],
					"speakerTitle": "江蓠"
				},
				{
					"id": 110290702,
					"content": "…以毒素维系生前的状态，的确是个绝妙的构思。师姐不会是要怪我擅自效仿了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290703
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110290703,
					"content": "怎么会，以你的资质，即便没有先例，假以时日，也能自行推演出来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290704
					],
					"speakerTitle": "江蓠"
				},
				{
					"id": 110290704,
					"content": "但从你与嘉良相遇至今，不过区区数日，就能将这毒研究得如此透彻…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290705
					],
					"speakerTitle": "江蓠"
				},
				{
					"id": 110290705,
					"content": "甚至还借它改进了原有的药方——这就不是资质可以解释的了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290706
					],
					"speakerTitle": "江蓠"
				},
				{
					"id": 110290706,
					"content": "白术，你如实告诉我，你…可是亲自试过毒了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290707
					],
					"speakerTitle": "江蓠"
				},
				{
					"id": 110290707,
					"content": "哈，我就说你藏不了多久。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290708
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110290708,
					"content": "长生的契约，能转移的…恐怕不只是生机吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290709
					],
					"speakerTitle": "江蓠"
				},
				{
					"id": 110290709,
					"content": "…果然还是瞒不过师姐啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290710
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110290710,
					"content": "不错，除了生机，长生的秘法，还能转移毒素与疾病。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290711
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110290711,
					"content": "第二次为嘉良治疗时，我就向自己转移了部分毒素，聊以减轻他的负担，也利于深研其毒性…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290712
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110290712,
					"content": "不过眼下所有余毒，皆已随魔神残渣而去，师姐也不必再担心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290713
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110290713,
					"content": "…这也太冒险了。如果那时候没有除掉魔神残渣，就连你自己的身体也——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290714
					],
					"speakerTitle": "江蓠"
				},
				{
					"id": 110290714,
					"content": "…哈，我又有什么资格说你呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290715
					],
					"speakerTitle": "江蓠"
				},
				{
					"id": 110290715,
					"content": "当年我之所以远离师门、避而不见，就是不想让时日无多的师父继续折损寿命，来医治嘉良。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290716
					],
					"speakerTitle": "江蓠"
				},
				{
					"id": 110290716,
					"content": "却没想到最后，我冒险炼毒，一样是以命换命。而你以身试毒…一个两个，全走上了师父他们的老路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290717
					],
					"speakerTitle": "江蓠"
				},
				{
					"id": 110290717,
					"content": "难道这就是我们这一脉的宿命吗？为了救人的执念短寿而终，执着于忤逆生死的奇迹…不可自拔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290718
					],
					"speakerTitle": "江蓠"
				},
				{
					"id": 110290718,
					"content": "…宿命一说，可不该从一名医者口中讲出来啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290719
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110290719,
					"content": "白术，我看得出来，这些年里，你已经用契约向自己转移了许多病与毒，其中有不少已经连我都看不透了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290720
					],
					"speakerTitle": "江蓠"
				},
				{
					"id": 110290720,
					"content": "你…还可以收手吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290721
					],
					"speakerTitle": "江蓠"
				},
				{
					"id": 110290721,
					"content": "师姐，你是知道的，我们这一脉，个个都是这性格…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290722
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110290722,
					"content": "喂——开饭啦——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290723
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110290723,
					"content": "妈！来吃饭啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290724
					],
					"speakerTitle": "阿雩"
				},
				{
					"id": 110290724,
					"content": "#{M#大哥哥}{F#大姐姐}教我做了好多菜，说是连爹也能尝出味道！你也来试试吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290725
					],
					"speakerTitle": "阿雩"
				},
				{
					"id": 110290725,
					"content": "好好好，妈这就来…欸，慢点跑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290726
					],
					"speakerTitle": "江蓠"
				},
				{
					"id": 110290726,
					"content": "…白术，我知道自己劝不动你，但…还请不要忘了，如果你不在…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290727
					],
					"speakerTitle": "江蓠"
				},
				{
					"id": 110290727,
					"content": "七七、阿桂…所有亲近你的朋友，都会为你伤心的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290728
					],
					"speakerTitle": "江蓠"
				},
				{
					"id": 110290728,
					"content": "师姐不必挂心，我自有分寸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290729
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110290729,
					"content": "唉…但愿如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290730
					],
					"speakerTitle": "江蓠"
				},
				{
					"id": 110290730,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290731
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110290731,
					"content": "白术…江蓠她刚刚说，你不在了，是什么意思？你、你该不会有事吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290732,
						110290733
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110290732,
					"content": "还有长生之前说的「宿命」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110290734
					]
				},
				{
					"id": 110290734,
					"content": "…包括他们的师父在内，我的历代契约者，无不短寿而终——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290735
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110290735,
					"content": "怎——怎么会这样！长生你不是能让人延年益寿的吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290736
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110290736,
					"content": "这就是，一个很长、很长的故事了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290737
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110290737,
					"content": "…继承契约，对心性也有要求。历代契约者，心性皆至纯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290738
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110290738,
					"content": "然而至善之人得此秘法，却比常人，更容易被这忤逆生死的奇迹吸引。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290739
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110290739,
					"content": "即便他们比谁都清楚结果会如何，但面对芸芸众生的悲呼哀鸣，至亲挚友的生老病死，终究还是会动用非人的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290740
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110290740,
					"content": "…就如扑火的飞蛾，在众生皆苦的长夜中，追寻超脱生死的希望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290741
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110290741,
					"content": "那…白术你岂不是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290742
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110290742,
					"content": "呵呵…至于我，大概就是那只既想追寻光明，又不想被烧着的蛾子了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290743
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110290743,
					"content": "长生的秘法，只是转移了病痛，却无法减少世间疾苦——就像嘉良会为师姐的危情慌乱，师姐也会为嘉良的牺牲悲恸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290744
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110290744,
					"content": "…我尊敬那些为了理想献上生命的师长们，但我并不打算成为他们，也不希望这份契约，继续流传于后人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290745
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110290745,
					"content": "欸…可是，你都往身上转移了那么多病…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290746
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110290746,
					"content": "——毒是什么？病又是什么？本质上，不都是一种影响人体的方式吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290747
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110290747,
					"content": "如果说不同于「平常」的表现，就能被称之为「病」。那么「不死药」…会不会也是一种「毒」呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290748
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110290748,
					"content": "穷究百毒百病，以达不死之境…即便在常人看来有悖天理，但于我而言，这跟先人们遍尝百草，克服百病并无区别。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290749
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110290749,
					"content": "我既不想让后来者继续因契约而短寿，也不想让长生失去契约而逝…那么答案，不就只有一个了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290750
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110290750,
					"content": "不死之药…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110290751
					]
				},
				{
					"id": 110290751,
					"content": "长生不老…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110290752
					]
				},
				{
					"id": 110290752,
					"content": "不错——我会成为最后一任契约者，让契约的传承，在我身上终结。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290753
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110290753,
					"content": "…真正的不死，就连当年的魔神们都难以企及。既想救人、又想救己，最后连我也想救，可真是太贪心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290754
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110290754,
					"content": "呵，若不贪心，还是凡人吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290755
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110290755,
					"content": "…畏惧烛火，却又向往光明，如此自私的蛾子——就只能往月亮上飞了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290756
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110290756,
					"content": "欸…我都不知道该说你什么好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290757
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110290757,
					"content": "#白先生！{M#大哥哥}{F#大姐姐}！你们还在聊什么呢？快来吃饭啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290758
					],
					"speakerTitle": "阿雩"
				},
				{
					"id": 110290758,
					"content": "还有，长生、派蒙，可以来喝，椰奶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290759
					],
					"speakerTitle": "七七"
				},
				{
					"id": 110290759,
					"content": "唔唔…算了，还是吃饭要紧！别的事情，就等吃饱了再想吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290760,
						110290761
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110290760,
					"content": "你啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110290762
					]
				},
				{
					"id": 110290762,
					"content": "唉，有时候真羡慕派蒙，吃饱喝足，就能常乐知足…",
