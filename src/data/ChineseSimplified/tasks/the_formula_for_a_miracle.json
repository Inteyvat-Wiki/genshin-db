					"nextDialogs": [
						110291010
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110291010,
					"content": "就是在这里…我让江蓠…是我让她…对我下了…咳！咳咳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110291011
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110291011,
					"content": "——嘉良！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110291012
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110291012,
					"content": "我没事…继续往下吧。我能感觉到，她…就在下面等我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嘉良"
				},
