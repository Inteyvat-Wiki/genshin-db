			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「海乱鬼」",
					"朝仓"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728040206,
					"content": "哎哟！好汉，好汉留手！你这是从哪里找来的帮手…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040207
					],
					"speakerTitle": "「海乱鬼」"
				},
				{
					"id": 728040207,
					"content": "恶徒！现在就把武器还给我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040208
					],
					"speakerTitle": "朝仓"
				},
				{
					"id": 728040208,
					"content": "你、你居然还惦记着那把武器…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040209
					],
					"speakerTitle": "「海乱鬼」"
				},
				{
					"id": 728040209,
					"content": "我只为取回我的武器，你告诉我那把武器在哪，我留你一条生路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040210
					],
					"speakerTitle": "朝仓"
				},
				{
					"id": 728040210,
					"content": "这…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040211,
						728040212
					],
					"speakerTitle": "「海乱鬼」"
				},
				{
					"id": 728040211,
					"content": "别和他废话了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040213
					]
				},
				{
					"id": 728040213,
					"content": "啊哟！好汉留手！怎得如此暴躁，我也没说我不说啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040214
					],
					"speakerTitle": "「海乱鬼」"
				},
				{
					"id": 728040214,
					"content": "那…那把武器，被我们老大留着当藏品了，你们要是想拿，去那边的营地里找他就可以了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040215
					],
					"speakerTitle": "「海乱鬼」"
				},
				{
					"id": 728040215,
					"content": "哼，算你识相。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040216
					],
					"speakerTitle": "朝仓"
				},
				{
					"id": 728040216,
					"content": "那二位好汉，在下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040217
					],
					"speakerTitle": "「海乱鬼」"
				},
				{
					"id": 728040217,
					"content": "滚！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040218
					]
				},
				{
					"id": 728040218,
					"content": "是！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040219
					],
					"speakerTitle": "「海乱鬼」"
				},
				{
					"id": 728040219,
					"content": "武艺不怎么样，逃跑倒是挺在行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040220
					],
					"speakerTitle": "朝仓"
				},
				{
					"id": 728040220,
					"content": "卖同伴卖得这么果断…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040221
					]
				},
				{
					"id": 728040221,
					"content": "海乱鬼终归只是一群为利而聚的乌合之众，谈不上什么忠诚，也谈不上什么信念。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040222
					],
					"speakerTitle": "朝仓"
				},
				{
					"id": 728040222,
					"content": "遇见了麻烦事，第一反应是拍屁股走人，这实在是太正常不过了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040223
					],
					"speakerTitle": "朝仓"
				},
				{
					"id": 728040223,
					"content": "不过，还是多亏了阁下在一旁以声势压人，不然他可不会这么容易就服软。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040224
					],
					"speakerTitle": "朝仓"
				},
				{
					"id": 728040224,
					"content": "但接下来，我们就必须直奔海乱鬼的大本营了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040225
					],
					"speakerTitle": "朝仓"
				},
				{
					"id": 728040225,
					"content": "还是依照之前的计划，阁下，我会直接去斩了那个头领，剩下的杂鱼就交给阁下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040226,
						728040227
					],
					"speakerTitle": "朝仓"
				},
				{
					"id": 728040226,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040228
					]
				},
				{
					"id": 728040228,
					"content": "那就拜托阁下了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "朝仓"
				},
				{
					"id": 728040227,
					"content": "我一个打十个。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040228
					]
				},
				{
					"id": 728040212,
					"content": "我们还是找下一个人…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040213
					]
				}
			]
		},
		{
			"id": 7280403,
			"completionStepIds": [
				7280405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280405",
							"2"
						],
						"stepId": 7280405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「海乱鬼」头领"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728040301,
					"content": "你？哈哈哈，不是上次的那个毛头小子吗？怎么，又来给我送藏品了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040302
					],
					"speakerTitle": "「海乱鬼」头领"
				},
				{
					"id": 728040302,
					"content": "我是来取回我的武器的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040303
					],
					"speakerTitle": "朝仓"
				},
				{
					"id": 728040303,
					"content": "嗯…不错，倒是有点胆色。但只找了一个帮手就敢闯到这里来，你未免也太看不起我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040304
					],
					"speakerTitle": "「海乱鬼」头领"
				},
				{
					"id": 728040304,
					"content": "不过，看在你到这里的这份胆色上，我就给你这个机会，上前来！我们去旁边玩玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040305
					],
					"speakerTitle": "「海乱鬼」头领"
				},
				{
					"id": 728040305,
					"content": "#但是嘛…我的这些手下，当然也不能闲着，你不是带了个帮手来吗？就让{M#他}{F#她}来陪他们玩玩吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040306,
						728040307
					],
					"speakerTitle": "「海乱鬼」头领"
				},
				{
					"id": 728040306,
					"content": "尽管放马过来。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040308
					]
				},
				{
					"id": 728040308,
					"content": "哈哈哈，口气倒是挺大。小的们，给我好好…折腾一下这愣头青！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040309
					],
					"speakerTitle": "「海乱鬼」头领"
				},
				{
					"id": 728040309,
					"content": "至于你，我们去旁边吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040310
					],
					"speakerTitle": "「海乱鬼」头领"
				},
				{
					"id": 728040310,
					"content": "那就交给你了，阁下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040311
					],
					"speakerTitle": "朝仓"
				},
				{
					"id": 728040311,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040312
					]
				},
				{
					"id": 728040312,
					"content": "不胜感激。我会马上把他斩掉，然后回来帮您的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040313
					],
					"speakerTitle": "朝仓"
				},
				{
					"id": 728040313,
					"content": "你的口气也不小啊，想要斩我的话，就自己来试试吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「海乱鬼」头领"
				},
				{
					"id": 728040307,
					"content": "只怕我玩不尽兴。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040308
					]
				}
			]
		},
		{
			"id": 7280404,
			"completionStepIds": [
				7280407
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280407",
							"2"
						],
						"stepId": 7280407,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"朝仓"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728040406,
					"content": "阁下，看你气息平稳，那些海乱鬼对你而言，果然不算什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040407
					],
					"speakerTitle": "朝仓"
				},
				{
					"id": 728040407,
					"content": "看起来你也赢了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040408
					]
				},
				{
					"id": 728040408,
					"content": "没错，但是很惭愧…最后那家伙居然虚晃一招，拼着被我刺了一枪后逃跑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040409
					],
					"speakerTitle": "朝仓"
				},
				{
					"id": 728040409,
					"content": "但是他伤得很重，我想，几年内他应该不可能再出来作乱了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040410
					],
					"speakerTitle": "朝仓"
				},
				{
					"id": 728040410,
					"content": "最主要的是，我亲手击败了他，也夺回了武器，彻底洗刷了耻辱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040411
					],
					"speakerTitle": "朝仓"
				},
				{
					"id": 728040411,
					"content": "恭喜你，朝仓。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040412
					]
				},
				{
					"id": 728040412,
					"content": "实在感谢，但我还不能松懈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040413
					],
					"speakerTitle": "朝仓"
				},
				{
					"id": 728040413,
					"content": "这一切的起因，都是我的武艺还不够精湛，以后我会继续加倍刻苦修炼，精进武艺的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040414
					],
					"speakerTitle": "朝仓"
				},
				{
					"id": 728040414,
					"content": "所以…还请阁下多多关照，常来和我对练了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040415
					],
					"speakerTitle": "朝仓"
				},
				{
					"id": 728040415,
					"content": "哦，对了，这些东西还请阁下收下。虽然不算太多…但也是我的一份心意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040416
					],
					"speakerTitle": "朝仓"
				},
				{
					"id": 728040416,
					"content": "再次谢谢您，阁下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "朝仓"
				}
			]
		}
	]
}