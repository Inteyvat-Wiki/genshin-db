			"trigger": {
				"objectNames": [
					"澜阳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 191320401,
					"content": "你好，请问有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191320402
					],
					"speakerTitle": "澜阳"
				},
				{
					"id": 191320402,
					"content": "我是来帮凝光取衣服的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191320403
					]
				},
				{
					"id": 191320403,
					"content": "哦，我之前听说了，那请你稍等片刻，我进去取一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191320404
					],
					"speakerTitle": "澜阳"
				},
				{
					"id": 191320404,
					"content": "在等待了很长时间之后，澜阳终于回来了。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						191320405
					]
				},
				{
					"id": 191320405,
					"content": "就是这个，麻烦你将这个交给凝光大人吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191320406
					],
					"speakerTitle": "澜阳"
				},
				{
					"id": 191320406,
					"content": "你好像花了挺长时间。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191320407
					]
				},
				{
					"id": 191320407,
					"content": "嗯，因为这个房间里放了很多凝光大人的收藏品，不只是衣服，还有各种文玩，玉器…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191320408
					],
					"speakerTitle": "澜阳"
				},
				{
					"id": 191320408,
					"content": "最近正在按照凝光大人的意思调整布局，所以房间比较杂乱，目前并不方便随意出入。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191320409,
						191320410
					],
					"speakerTitle": "澜阳"
				},
				{
					"id": 191320409,
					"content": "（听起来藏品确实很多…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191320411
					]
				},
				{
					"id": 191320411,
					"content": "总之谢谢你，这个衣服就交给你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "澜阳"
				},
				{
					"id": 191320410,
					"content": "（这也算有钱人的烦恼吧。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191320411
					]
				}
			]
		},
