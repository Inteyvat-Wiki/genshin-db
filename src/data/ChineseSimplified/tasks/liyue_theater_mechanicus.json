			},
			"dialogs": [
				{
					"id": 400000201,
					"content": "你好！你也想试玩一下「机关棋谭」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000202
					],
					"speakerTitle": "瑞锦"
				},
				{
					"id": 400000202,
					"content": "什么…「机关棋谭」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400000203
					]
				},
				{
					"id": 400000203,
					"content": "唔，看来你不太了解呢…「机关棋谭」是我发明的一种能在桌子上玩的「游戏」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000204
					],
					"speakerTitle": "瑞锦"
				},
				{
					"id": 400000204,
					"content": "你看到桌子上的这些摆件了吗？这些都是「机关棋谭」里要用到的道具。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000205
					],
					"speakerTitle": "瑞锦"
				},
				{
					"id": 400000205,
					"content": "看起来好复杂…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400000206
					]
				},
				{
					"id": 400000206,
					"content": "只是看起来复杂啦，其实很容易上手的，只要玩几局就熟悉规则了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000207
					],
					"speakerTitle": "瑞锦"
				},
				{
					"id": 400000207,
					"content": "怎么样，你想试试看吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000208,
						400000209
					],
					"speakerTitle": "瑞锦"
				},
				{
					"id": 400000208,
					"content": "这得…多少钱玩一局？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400000210
					]
				},
				{
					"id": 400000210,
					"content": "没有没有，这不是海灯节嘛，刚好我也想要看看大家对于这个「机关棋谭」的态度…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000211
					],
					"speakerTitle": "瑞锦"
				},
				{
					"id": 400000211,
					"content": "所以，现在只需要一盏「霄灯」就能玩一局。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000212
					],
					"speakerTitle": "瑞锦"
				},
				{
					"id": 400000212,
					"content": "如果你想玩的话，拿着「霄灯」来找我就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000213
					],
					"speakerTitle": "瑞锦"
				},
				{
					"id": 400000213,
					"content": "怎么样，来试试吧，第一局我就不收你霄灯啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑞锦"
				},
				{
					"id": 400000209,
					"content": "这玩一局挺贵的吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400000210
					]
				}
			]
		},
