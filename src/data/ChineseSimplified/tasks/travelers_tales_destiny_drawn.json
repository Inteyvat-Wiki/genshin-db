				]
			},
			"dialogs": [
				{
					"id": 727380101,
					"content": "嗯，差不多就这样吧。简单清扫一下就好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380102
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 727380102,
					"content": "哎呀？小家伙，你来得可真巧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380103,
						727380104
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 727380103,
					"content": "来得巧？哪里巧了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380105
					]
				},
				{
					"id": 727380105,
					"content": "瞧瞧你，脑子里肯定在想：「唉，这女人肯定又要把什么麻烦事推给我了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380106
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 727380106,
					"content": "放心吧，只是本社刚刚做好整修，正准备推出全新的业务。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380107
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 727380107,
					"content": "还没来得及对外公布呢，你就过来了。这不是巧了么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380108
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 727380108,
					"content": "喏，看到我旁边的赛钱箱了没？以后啊，这里就要多一个许愿的地方了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380109
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 727380109,
					"content": "不是已经有御神签了么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380110
					]
				},
				{
					"id": 727380110,
					"content": "那可不一样。御神签那边是看运势，而这边嘛…则是用来「许愿」的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380111
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 727380111,
					"content": "只需要闭上眼想着自己的愿望，再把愿望写上绘马，再挂在旁边的架子上，说不定愿望就会实现喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380112
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 727380112,
					"content": "什么愿望都可以？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380113
					]
				},
				{
					"id": 727380113,
					"content": "当然了。不过，究竟能实现哪些，就只能看护佑着咱们的神明啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380114
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 727380114,
					"content": "我这个没用的宫司，最多也只能帮你在人缘上想想办法了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380115,
						727380116
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 727380115,
					"content": "能遇见新朋友的话很好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380117
					]
				},
				{
					"id": 727380117,
					"content": "如果这就是你的心愿，那就去试试吧，来，拿着这些「签文簿纸」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380118
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 727380118,
					"content": "这是我在写「御神签」的时候剩下的，送给你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380119
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 727380119,
					"content": "把愿望写在上面再许愿，也许会更灵验喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380120
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 727380120,
					"content": "真的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380121
					]
				},
				{
					"id": 727380121,
					"content": "哎呀，我什么时候骗过你？快去许愿吧，小家伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380122
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 727380122,
					"content": "记住了，先把愿望写在「签文簿纸」上，再把簿纸贴在绘马上，最后把绘马挂在架子上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380123
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 727380123,
					"content": "这样，许愿就完成了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380124
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 727380124,
					"content": "嗯，很诚心嘛，不错不错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380125
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 727380125,
					"content": "这真的有用吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380126
					]
				},
				{
					"id": 727380126,
					"content": "好啦，继续忙去吧小家伙。但记得要竖起耳朵，瞪大眼睛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380127
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 727380127,
					"content": "说不定，你想要遇见的那个人，就在某个拉面摊上吃拉面呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "八重神子"
				},
				{
					"id": 727380116,
					"content": "和老朋友们见面也不错…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380117
					]
				},
				{
					"id": 727380104,
					"content": "等一会，这个开场白…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380105
					]
				}
			]
		}
	]
}