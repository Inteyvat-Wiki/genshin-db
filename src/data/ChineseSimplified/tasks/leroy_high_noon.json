			"dialogs": [
				{
					"id": 741530501,
					"content": "那个箱子怎么看都不像是该在这里出现的东西，而且好臭…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741530502,
					"content": "恐怕是灰河来的东西。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530503
					]
				},
				{
					"id": 741530503,
					"content": "也就是说，最近伯努瓦家有人去过灰河，而且伯努瓦又曾经住在灰河…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741530504,
					"content": "#所有的线索都和灰河有关，{NICKNAME}，我们要不要去灰河看看，应该能了解更多有用的信息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741530505,
					"content": "走吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530506
					]
				},
				{
					"id": 741530506,
					"content": "我们去灰河！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
