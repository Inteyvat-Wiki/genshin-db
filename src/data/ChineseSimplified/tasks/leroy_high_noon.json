					{
						"sceneId": 3,
						"position": [
							3504.077,
							283.082,
							4528.295
						],
						"pointId": 7525
					}
				]
			},
			"dialogs": [
				{
					"id": 741530701,
					"content": "啊，好无聊啊…不想工作…我什么时候能暴富…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530702
					],
					"speakerTitle": "史诺德格拉斯"
				},
				{
					"id": 741530702,
					"content": "关于伯努瓦·勒鲁瓦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530703
					]
				},
				{
					"id": 741530703,
					"content": "…勒鲁瓦？这名字似乎在哪儿听过，让我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530704
					],
					"speakerTitle": "史诺德格拉斯"
				},
				{
					"id": 741530704,
					"content": "哦，我想起来了，伯努瓦·勒鲁瓦，杂货摊的摊主大叔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530705
					],
					"speakerTitle": "史诺德格拉斯"
				},
				{
					"id": 741530705,
					"content": "怎么了？你们是谁？打听这个做什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530706
					],
					"speakerTitle": "史诺德格拉斯"
				},
				{
					"id": 741530706,
					"content": "其实我们只是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530707,
						741530708
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741530707,
					"content": "他的情况比较复杂。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530709
					]
				},
				{
					"id": 741530709,
					"content": "啊，这…难道…他是不是犯什么事了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530710
					],
					"speakerTitle": "史诺德格拉斯"
				},
				{
					"id": 741530710,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530711
					]
				},
				{
					"id": 741530711,
					"content": "懂了懂了…但我还是忍不住想多问一句，你们是刺玫会来的还是执律庭来的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530712
					],
					"speakerTitle": "史诺德格拉斯"
				},
				{
					"id": 741530712,
					"content": "你有权保持沉默…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530713
					]
				},
				{
					"id": 741530713,
					"content": "你的每句话将作为呈堂证供…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530714
					]
				},
				{
					"id": 741530714,
					"content": "#（{NICKNAME}也太会演了，不愧是你。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530715
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741530715,
					"content": "好好好，明白了，我不问了。他发财的手段又不光彩，枫丹法条那么多，他肯定违反其中某一条了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530716
					],
					"speakerTitle": "史诺德格拉斯"
				},
				{
					"id": 741530716,
					"content": "长官，你们找对了人。我告诉你们，这家人我再熟不过了，伯努瓦这个坏东西烂事没少干。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530717
					],
					"speakerTitle": "史诺德格拉斯"
				},
				{
					"id": 741530717,
					"content": "哦，我都到了结婚成家的年纪，他应该已经老了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530718
					],
					"speakerTitle": "史诺德格拉斯"
				},
				{
					"id": 741530718,
					"content": "我记得他的女儿小秋很漂亮，嘿嘿，可惜他从来不让我们跟小秋说话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530719
					],
					"speakerTitle": "史诺德格拉斯"
				},
				{
					"id": 741530719,
					"content": "小秋？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530720
					]
				},
				{
					"id": 741530720,
					"content": "没错，秋·勒鲁瓦，伯努瓦·勒鲁瓦的养女。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530721
					],
					"speakerTitle": "史诺德格拉斯"
				},
				{
					"id": 741530721,
					"content": "你仔细想一想，他本来只是一个卖杂货的，赚点小钱而已，怎么可能突然暴富，搬到上面住？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530722
					],
					"speakerTitle": "史诺德格拉斯"
				},
				{
					"id": 741530722,
					"content": "还不是靠他的女儿小秋，那么漂亮的年轻女孩，他硬是让她嫁给了一个有钱的老头。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530723
					],
					"speakerTitle": "史诺德格拉斯"
				},
				{
					"id": 741530723,
					"content": "才几年老头就死啦，老头的房子当然就归小秋了，小秋的就是他的，这下他不就一口气成为「上面人」了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530724
					],
					"speakerTitle": "史诺德格拉斯"
				},
				{
					"id": 741530724,
					"content": "啧啧，这种一夜暴富的好事怎么就落在他头上了，啊呸，我是说这个老东西吸自己女儿的血，太坏了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530725
					],
					"speakerTitle": "史诺德格拉斯"
				},
				{
					"id": 741530725,
					"content": "（怎么还有这种事情？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530726
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741530726,
					"content": "（我们继续问他。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530727
					]
				},
				{
					"id": 741530727,
					"content": "长官，你们就是来打探这些事的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530728
					],
					"speakerTitle": "史诺德格拉斯"
				},
				{
					"id": 741530728,
					"content": "我是说，要是这些破事对你们有用的话，我是不是也为枫丹的社会安全做出了贡献？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530729
					],
					"speakerTitle": "史诺德格拉斯"
				},
				{
					"id": 741530729,
					"content": "作为一个对社会有贡献的市民，执律庭会不会有嘉奖我的打算？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530730,
						741530732
					],
					"speakerTitle": "史诺德格拉斯"
				},
				{
					"id": 741530730,
					"content": "这些事我们已经知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530731
					]
				},
				{
					"id": 741530731,
					"content": "别急别急，我还有其他的事情可以说。毕竟住在灰河，要是不知道别人一两个秘密，睡觉都不安稳，嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530734
					],
					"speakerTitle": "史诺德格拉斯"
				},
				{
					"id": 741530734,
					"content": "小秋的第二个丈夫，是的，她很快就再嫁了，这次嫁得比较远，我们都没有再见过她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530735
					],
					"speakerTitle": "史诺德格拉斯"
				},
				{
					"id": 741530735,
					"content": "等到我们再听说小秋的消息，她已经犯了那种事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530736
					],
					"speakerTitle": "史诺德格拉斯"
				},
				{
					"id": 741530736,
					"content": "那种事是哪种事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530737
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741530737,
					"content": "长官不知道吗？小秋杀了她的第二任丈夫，被判到梅洛彼得堡去了啊。你们来查伯努瓦却不知道这事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530738,
						741530739
					],
					"speakerTitle": "史诺德格拉斯"
				},
				{
					"id": 741530738,
					"content": "这里有涉案人员记录，派蒙队员。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530740
					]
				},
				{
					"id": 741530740,
					"content": "#啊…啊抱歉，{NICKNAME}队长，下次我不会再这样了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530741,
						741530742
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741530741,
					"content": "继续说。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530743
					]
				},
				{
					"id": 741530743,
					"content": "对对，我正要说。我也是听别人说的，据说审判小秋的时候，小秋申请让伯努瓦出庭，但他拒绝了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530744
					],
					"speakerTitle": "史诺德格拉斯"
				},
				{
					"id": 741530744,
					"content": "伯努瓦没结婚，只有小秋这一个女儿，哦对了，我记得她是过继来的女儿，跟伯努瓦还算有那么点血缘的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530745
					],
					"speakerTitle": "史诺德格拉斯"
				},
				{
					"id": 741530745,
					"content": "反正唯一的父亲都没有出庭作证，小秋会直接被判梅洛彼得堡也很正常嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530746
					],
					"speakerTitle": "史诺德格拉斯"
				},
				{
					"id": 741530746,
					"content": "这老坏蛋是为了独吞房产，还是因为跟女儿有什么冲突才没有出庭，我就不乱猜了，嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530747
					],
					"speakerTitle": "史诺德格拉斯"
				},
				{
					"id": 741530747,
					"content": "他平时看起来很和善吧？我记得他还给过我点心吃，谁知道他私底下这么冷血。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530748
					],
					"speakerTitle": "史诺德格拉斯"
				},
				{
					"id": 741530748,
					"content": "长官您真镇定，听这么半天眉头都不皱，这你们都不觉得冷血吗？我以为我还挺冷血的，你们比我厉害多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530749
					],
					"speakerTitle": "史诺德格拉斯"
				},
				{
					"id": 741530749,
					"content": "公事公办。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530750
					]
				},
				{
					"id": 741530750,
					"content": "太专业了，令人肃然起敬。所以长官们，伯努瓦犯的罪严重吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530751
					],
					"speakerTitle": "史诺德格拉斯"
				},
				{
					"id": 741530751,
					"content": "无可奉告。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530752
					]
				},
				{
					"id": 741530752,
					"content": "哈，严重到无可奉告…那他的房子会被收走吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530753,
						741530754
					],
					"speakerTitle": "史诺德格拉斯"
				},
				{
					"id": 741530753,
					"content": "或许吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530755
					]
				},
				{
					"id": 741530755,
					"content": "啊哈，我就知道，老鼠就是老鼠，爬到上面还是老鼠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530756
					],
					"speakerTitle": "史诺德格拉斯"
				},
				{
					"id": 741530756,
					"content": "谢谢两位长官给我带来美好的一天，期待下次在灰河再看见两位，嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530757
					],
					"speakerTitle": "史诺德格拉斯"
				},
				{
					"id": 741530757,
					"content": "怎么说呢…我现在心情有点复杂，本来我对伯努瓦的印象还挺好的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530758,
						741530760
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741530758,
					"content": "人不可貌相。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530759
					]
				},
				{
					"id": 741530759,
					"content": "唉，我是不是太笨了，完全没看出来他是这样的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530763
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741530763,
					"content": "这些复杂的事情够我们消化一阵子了，我总感觉心里怪怪的，不想在灰河再呆下去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530764
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741530764,
					"content": "走吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530765
					]
				},
				{
					"id": 741530765,
					"content": "嗯，去晒晒太阳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741530760,
					"content": "不用听信路人一面之词。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530761
					]
				},
				{
					"id": 741530761,
					"content": "你说的对，但我现在也没法完全相信伯努瓦了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530762
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741530762,
					"content": "好讨厌这种感觉，不过幸好我还能相信你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530763
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741530754,
					"content": "有可能。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530755
					]
				},
				{
					"id": 741530742,
					"content": "秘密呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530743
					]
				},
				{
					"id": 741530739,
					"content": "你没有仔细研究卷宗，我很失望。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530740
					]
				},
				{
					"id": 741530732,
					"content": "要看你能提供些什么。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530733
					]
				},
				{
					"id": 741530733,
					"content": "那我能说的可就太多了，毕竟住在灰河，要是不知道别人一两个秘密，睡觉都不安稳，嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530734
					],
					"speakerTitle": "史诺德格拉斯"
				},
				{
					"id": 741530708,
					"content": "请配合我们工作。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530709
					]
				}
			]
		},
