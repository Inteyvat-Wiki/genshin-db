					},
					{
						"sceneId": 3,
						"position": [
							3594.91,
							435.073,
							4531.89
						],
						"pointId": 7522
					},
					{
						"sceneId": 3,
						"position": [
							3594.826,
							435.073,
							4532.51
						],
						"pointId": 7523
					}
				]
			},
			"dialogs": [
				{
					"id": 741530101,
					"content": "有没有人啊，报纸不要了吗？喂，应下门啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530102
					],
					"speakerTitle": "皮普"
				},
				{
					"id": 741530102,
					"content": "你好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530103
					]
				},
				{
					"id": 741530103,
					"content": "伯努瓦不在家吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530104
					]
				},
				{
					"id": 741530104,
					"content": "我哪儿知道，怪得很，自己订的报纸自己不来拿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530105
					],
					"speakerTitle": "皮普"
				},
				{
					"id": 741530105,
					"content": "以前我送报到门口，勒鲁瓦先生至少会应一声，最近完全看不到他人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530106
					],
					"speakerTitle": "皮普"
				},
				{
					"id": 741530106,
					"content": "我这儿已经堆了好几份他订的蒸汽鸟报了，你们认识他是吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530107
					],
					"speakerTitle": "皮普"
				},
				{
					"id": 741530107,
					"content": "对，对，我们是伯努瓦的好朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741530108,
					"content": "好朋友？…行吧，要不我把报纸交给你们，你们见到他的时候帮我转交？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530109,
						741530110
					],
					"speakerTitle": "皮普"
				},
				{
					"id": 741530109,
					"content": "好的，给我们吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530111
					]
				},
				{
					"id": 741530111,
					"content": "我也算尽力了，别回头怪我没送报纸上门，我还有其他事要忙呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530112
					],
					"speakerTitle": "皮普"
				},
				{
					"id": 741530112,
					"content": "但最近我们也几乎见不到他本人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741530113,
					"content": "你们也找不到他？勒鲁瓦先生到底在忙些什么啊，难道回老房子住去了？没听说啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530114
					],
					"speakerTitle": "皮普"
				},
				{
					"id": 741530114,
					"content": "老房子？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530115
					]
				},
				{
					"id": 741530115,
					"content": "对啊，他在灰河的老房子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530116
					],
					"speakerTitle": "皮普"
				},
				{
					"id": 741530116,
					"content": "伯努瓦以前是住在灰河的啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741530117,
					"content": "他是从灰河搬上来的你们都不知道，你们真是他的朋友吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530118
					],
					"speakerTitle": "皮普"
				},
				{
					"id": 741530118,
					"content": "呃…我们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741530119,
					"content": "行了行了，不用解释，你们跟他怎么回事我一点都不关心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530120
					],
					"speakerTitle": "皮普"
				},
				{
					"id": 741530120,
					"content": "只要把报纸送到我就谢谢你们了，好了，你们拿着吧，我走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530121
					],
					"speakerTitle": "皮普"
				},
				{
					"id": 741530121,
					"content": "感觉伯努瓦身上还有很多我们完全不了解的事，你觉得这会和我们要调查的事情有关吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530122,
						741530123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741530122,
					"content": "很可能有关。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530124
					]
				},
				{
					"id": 741530124,
					"content": "好，那接下来我们在伯努瓦家附近稍微调查一下吧，说不定能了解更多关于伯努瓦的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741530125,
					"content": "不过我们的动静得小点儿，不然会引起那对夫妻的警觉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741530123,
					"content": "信息越多越好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530124
					]
				},
				{
					"id": 741530110,
					"content": "派蒙拿着吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530111
					]
				}
			]
		},
