				"objectNames": [
					"志琼",
					"克里托夫",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710410401,
					"content": "就是这里了，前辈。咳咳…真不巧，大门锁上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410402
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710410402,
					"content": "必须要同时拿到两个钥匙才能开门…唉，你们璃月人呀，总是在这种不知所谓的地方如此用心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410403
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710410403,
					"content": "少说些没用的话啦…你看大门旁贴的通知单，好歹我们还是知道，炮弹确实在库房里的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410404
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710410404,
					"content": "炮弹是一回事，我们还不知道引信的保存状况呢？我看还是从长计议比较好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410405
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710410405,
					"content": "好啦…你这家伙不要说丧气话了。什么事都不做，只会乌鸦嘴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410406
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710410406,
					"content": "况且我们何必要听从一个盗宝团的质疑？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410407,
						710410408
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710410407,
					"content": "克里托夫说的不是没有道理…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410409
					]
				},
				{
					"id": 710410409,
					"content": "对呀，你们两个就不要吵架啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710410410,
					"content": "哼…就听前辈的。我们先继续吧，说不定瑾武姐知道该如何打开库房大门。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410411
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710410411,
					"content": "而且在那之后，我们还需要忙活好一阵子呢…解锁炮闩还需要激活信号装置才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410412
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710410412,
					"content": "听瑾武姐说，在能俯瞰大炮的高处应该设置着爆破组的观测点…从那边可以调节信号，用来在安全距离外解锁大炮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志琼"
				},
				{
					"id": 710410408,
					"content": "总之，我们先得打开大门才行。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410409
					]
				}
			]
		}
	]
}