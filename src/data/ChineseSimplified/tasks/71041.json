			"trigger": {
				"objectNames": [
					"克里托夫",
					"志琼",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710410101,
					"content": "呼…谢谢各位英雄，谢谢你们救了我一命…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410102
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710410102,
					"content": "等等…我认得你，你就是之前在矿上那个托克里夫吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410103
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710410103,
					"content": "啊，不…那个不是我，我不卖假药的。我是克里托夫，不卖药的克里托夫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410104
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710410104,
					"content": "原来你卖的是假药？！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410105
					]
				},
				{
					"id": 710410105,
					"content": "不是…怎么可能！我卖的药可都是货真价实的大汉药水！你看，矿工们喝了不也很有精神吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410106
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710410106,
					"content": "你不是不卖药的克里托夫吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410107
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710410107,
					"content": "啊…对，那是在我的卖药生涯结束之后了…因为那个…对，都怪那个托克里夫，取了个假名招摇撞骗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410108
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710410108,
					"content": "他用假名卖假药，臭了我的名声！所以我从此以后发誓，再也不卖药了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410109
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710410109,
					"content": "结果刚改行没多久，就让这帮盗宝团的贼人给抓住了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410110
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710410110,
					"content": "这么说，那个卖假药的真是可恨…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410111
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710410111,
					"content": "对呀对呀，连卖药的同行都骗，真是个坏人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710410112,
					"content": "「托克里夫」的假名是什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410113
					]
				},
				{
					"id": 710410113,
					"content": "克里托夫！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410114
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710410114,
					"content": "…啊，不是…克里托夫不是假名，是真名…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410115
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710410115,
					"content": "那托克里夫就是假名咯…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710410116,
					"content": "没…是、是他冒用我的名字，所以克里托夫就成了假名，明白了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410117
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710410117,
					"content": "哦…所以「托克里夫」，就成了真名。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710410118,
					"content": "真可惜…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410119
					]
				},
				{
					"id": 710410119,
					"content": "可惜什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410120
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710410120,
					"content": "可惜你差点就不打自招咯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410121
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710410121,
					"content": "我们带他上去吧，让千岩军的大哥们问问他到底怎么回事好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410122
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710410122,
					"content": "或者我们就在这里解决掉他。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410123
					]
				},
				{
					"id": 710410123,
					"content": "啥？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410124
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710410124,
					"content": "喂，不要突然开这种玩笑呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410125
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710410125,
					"content": "哈，哈，笑死我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710410126,
					"content": "你都没在笑吧！这一点也不好笑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410127,
						710410130
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710410127,
					"content": "确实不好笑，因为我们要来真的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410128
					]
				},
				{
					"id": 710410128,
					"content": "请你冷静点，前辈，现在不是拷问时间！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410129
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710410129,
					"content": "我可不想背着一个被你们吓晕的盗宝团跑来跑去…不管怎样，先把他带回营地吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410131
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710410131,
					"content": "等等，我对你们很有用的！请带上我一起探险吧！毕竟…你看，我已经被盗宝团扫地出门了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410132
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710410132,
					"content": "现在我也多少算是…清白之身了嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410133
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710410133,
					"content": "原来这就算清白之身了呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710410134,
					"content": "你都会些什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410135
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710410135,
					"content": "唔…比如说…调配炸药？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410136
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710410136,
					"content": "还是假药嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410137
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710410137,
					"content": "是炸药，不是假药。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410138
					]
				},
				{
					"id": 710410138,
					"content": "不是假炸药？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410139
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710410139,
					"content": "这次是真的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410140
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710410140,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410141
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710410141,
					"content": "…我可没权力让你轻易入队，怎么处置你这样的家伙，得让瑾武姐定夺。不过我猜她也只会把你移交千岩军的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410142
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710410142,
					"content": "但是我们会好好盯着你的。盗宝团的家伙，怎么看都觉得不应该信任。更何况是卖假药的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410143
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710410143,
					"content": "都说过我不卖假药了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410144
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710410144,
					"content": "哎呀知道啦！我们快走吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710410130,
					"content": "很有道理。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410131
					]
				}
			]
		},
		{
			"id": 7104103,
			"completionStepIds": [
				7104109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
