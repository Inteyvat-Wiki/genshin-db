			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"克里托夫",
					"派蒙",
					"志琼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710410301,
					"content": "…闭锁机构还没有生锈，有润滑油的痕迹…似乎在封矿之后也有人护理过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410302
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710410302,
					"content": "炮闩也是完好的…只是保险机处于闭锁状态。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410303
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710410303,
					"content": "听不懂…那是什么呀，咒语吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710410304,
					"content": "前方的矿道先前撤离矿工时被人用巨石封堵了…看起来这门炮又要派上用场咯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410305
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710410305,
					"content": "没有炮弹的话，大炮就形同虚设。我们还需要找到炮弹才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410306
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710410306,
					"content": "哼…别说得好像我不知道一样，聪明鬼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410307
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710410307,
					"content": "附近有一处库房，那里大概储存着炮弹…希望当年撤离的时候没有把炮弹也都搬走…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410308
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710410308,
					"content": "我们出发吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410309
					]
				},
				{
					"id": 710410309,
					"content": "我们走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "克里托夫"
				}
			]
		},
