			},
			"dialogs": [
				{
					"id": 700500501,
					"content": "…你看，都说了只是一只普通的小猫啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700500502,
					"content": "居然…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500503
					],
					"speakerTitle": "吉雅罗"
				},
				{
					"id": 700500503,
					"content": "喵？喵…喵喵？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500504,
						700500506
					],
					"speakerTitle": "陷入迷惑的小猫"
				},
				{
					"id": 700500504,
					"content": "请问，你认识玄文兽吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500505
					]
				},
				{
					"id": 700500505,
					"content": "喵…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500508
					],
					"speakerTitle": "陷入迷惑的小猫"
				},
				{
					"id": 700500508,
					"content": "小猫无奈地转身离开了…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						700500509
					]
				},
				{
					"id": 700500509,
					"content": "不过…你们说，这只小猫会不会就是玄文兽的幼体？它就这么潜伏在翘英庄里，等到成年，就把所有的茶树席卷一空…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500510
					],
					"speakerTitle": "吉雅罗"
				},
				{
					"id": 700500510,
					"content": "吉雅罗小姐，怎么又是你…我都和你说过了，玄文兽不是这种温和的野兽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500511
					],
					"speakerTitle": "洪分"
				},
				{
					"id": 700500511,
					"content": "哎呀，洪分小姐，真是太巧了，您怎么也来了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500512
					],
					"speakerTitle": "吉雅罗"
				},
				{
					"id": 700500512,
					"content": "唉…请不要总是在我们这里念叨什么「罪案事件」，孩子们要是当真了可怎么办？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500513
					],
					"speakerTitle": "洪分"
				},
				{
					"id": 700500513,
					"content": "你们俩认识？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500514
					]
				},
				{
					"id": 700500514,
					"content": "是啊，我来这里的时候，正是请这位小姐帮忙搬运行李的呢。还请教了很多有关民俗传说的问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500515
					],
					"speakerTitle": "吉雅罗"
				},
				{
					"id": 700500515,
					"content": "我都说了很多次，玄文兽是不会在庄里出现，但吉雅罗小姐却总是不信，还说什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500516
					],
					"speakerTitle": "洪分"
				},
				{
					"id": 700500516,
					"content": "不出现，也有不出现的取材方式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500517
					],
					"speakerTitle": "吉雅罗"
				},
				{
					"id": 700500517,
					"content": "又来了…唉，吉雅罗小姐，我是劝不动你了。但无论如何，请你一定不要离开庄里到处乱跑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500518
					],
					"speakerTitle": "洪分"
				},
				{
					"id": 700500518,
					"content": "玄文兽是真实存在的猛兽，如果遇见它的话…唉，请您一定，务必不要独自离开庄里！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500519
					],
					"speakerTitle": "洪分"
				},
				{
					"id": 700500519,
					"content": "洪分无奈地离去了，看起来比刚才的小猫更疲惫一些…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						700500520
					]
				},
				{
					"id": 700500520,
					"content": "好啦，既然洪分小姐都这么说了，我们也只能去另外一个地方取材了，走，跟着我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "吉雅罗"
				},
				{
					"id": 700500506,
					"content": "抱歉，我们认错猫了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500507
					]
				},
				{
					"id": 700500507,
					"content": "喵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500508
					],
					"speakerTitle": "陷入迷惑的小猫"
				}
			]
		},
		{
			"id": 7005006,
			"completionStepIds": [
				7005006
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7005006",
							"2"
						],
						"stepId": 7005006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"吉雅罗"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2276.275,
							287.313,
							1542.857
						],
						"pointId": 311400058
					}
				]
			},
			"dialogs": [
				{
					"id": 700500601,
					"content": "怎么样？这个…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500602
					],
					"speakerTitle": "吉雅罗"
				},
				{
					"id": 700500602,
					"content": "茶釜。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500603
					]
				},
				{
					"id": 700500603,
					"content": "没错！就是茶…茶什么？总之…是一个很别致的东西啦！而且还在庄里的最中央，我觉得，它肯定有着特别的意义。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500604
					],
					"speakerTitle": "吉雅罗"
				},
				{
					"id": 700500604,
					"content": "唔…你们说，玄文兽会不会就住在这里面？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500605,
						700500606
					],
					"speakerTitle": "吉雅罗"
				},
				{
					"id": 700500605,
					"content": "这么写的话，会写成传奇小说喔。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500607
					]
				},
				{
					"id": 700500607,
					"content": "如果这么写的话，总感觉你的小说里还会出现仙人之类的元素呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500608
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700500608,
					"content": "这种主题的罪案小说，总觉得…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500609
					]
				},
				{
					"id": 700500609,
					"content": "…喔！你们的表情不错，是不是感觉，如果以玄文兽为主题写罪案小说的话，这份罪案会十分「荒谬」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500610
					],
					"speakerTitle": "吉雅罗"
				},
				{
					"id": 700500610,
					"content": "欸？是、是有一点点这个感觉。无论如何，罪案小说都不可能以这种主题来发展剧情的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500611
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700500611,
					"content": "等等，难道你…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500612
					]
				},
				{
					"id": 700500612,
					"content": "#嗯，很敏锐嘛{NICKNAME}。不愧于你的大名。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500613
					],
					"speakerTitle": "吉雅罗"
				},
				{
					"id": 700500613,
					"content": "没错，我想要写的正是一篇「荒谬到不可能发生的罪案」。洪分小姐和你们的反应很有趣，我会写进小说里的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500614
					],
					"speakerTitle": "吉雅罗"
				},
				{
					"id": 700500614,
					"content": "至于玄文兽嘛…它是我设计中的「犯案者」。一种传说中会吞噬庄内的恶人，却从未有人真正见过的「玄文兽」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500615
					],
					"speakerTitle": "吉雅罗"
				},
				{
					"id": 700500615,
					"content": "在某一次节日中，有一位庄内人被人发现在野外遇害，看起来像是被猛兽袭击…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500616
					],
					"speakerTitle": "吉雅罗"
				},
				{
					"id": 700500616,
					"content": "但在第二天的庆典里，我的主角却再次遇见了本该死去的那位遇害者，随后，又一位死者出现了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500617
					],
					"speakerTitle": "吉雅罗"
				},
				{
					"id": 700500617,
					"content": "之后呢？之后呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500618
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700500618,
					"content": "没想好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500619
					],
					"speakerTitle": "吉雅罗"
				},
				{
					"id": 700500619,
					"content": "…我要离开了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500620
					]
				},
				{
					"id": 700500620,
					"content": "别呀，等我写完之后，肯定给你们寄两本。我还要有一个大忙想请你们帮我呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500621
					],
					"speakerTitle": "吉雅罗"
				},
				{
					"id": 700500621,
					"content": "洪分小姐不是一直说，我绝对不能独自离开庄里吗？这句话我可是好好听进去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500622
					],
					"speakerTitle": "吉雅罗"
				},
				{
					"id": 700500622,
					"content": "但现在嘛…既然你们来了，那我就不算是「独自一人」，也可以去庄外逛逛了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500623
					],
					"speakerTitle": "吉雅罗"
				},
				{
					"id": 700500623,
					"content": "当然，我也不会去太远的地方！你们愿意帮我这个忙吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500624,
						700500625
					],
					"speakerTitle": "吉雅罗"
				},
				{
					"id": 700500624,
					"content": "好吧…为了看到小说的结尾…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500627
					]
				},
				{
					"id": 700500627,
					"content": "那么！我们就往那边走吧，我有一个很想去的地方！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "吉雅罗"
				},
				{
					"id": 700500625,
