			"dialogs": [
				{
					"id": 700500801,
					"content": "这些东西是「灯笼」吗？看起来像是鱼的灯笼，真有意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500802
					],
					"speakerTitle": "吉雅罗"
				},
				{
					"id": 700500802,
					"content": "这些把手，是用来抬起这只灯笼的吗？嗯…这种拆卸式结构，只要设计的合理，悄悄加上一两节也不会被人发现…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500803
					],
					"speakerTitle": "吉雅罗"
				},
				{
