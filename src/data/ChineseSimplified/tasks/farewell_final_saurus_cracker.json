					"nextDialogs": [
						750870729
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870729,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870730
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870730,
					"content": "感谢你们的宽容，飞行学校…呃虽然没有大门，但是还请意会一下，大门随时向你们敞开。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870731
					],
					"speakerTitle": "拉密萨纳"
				},
				{
					"id": 750870731,
					"content": "#嗯，看到你们和{REALNAME[ID(2)|SHOWHOST(true)]}关系这么好，我也想要请教和小龙融洽相处的诀窍呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870732
					],
					"speakerTitle": "塔卢加"
				},
				{
					"id": 750870732,
					"content": "嘿嘿，好喔，如果之后有空的话，我们会再来的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870724,
					"content": "#让{REALNAME[ID(2)|SHOWHOST(true)]}踢你脚趾。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870725
					]
				},
				{
					"id": 750870725,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
