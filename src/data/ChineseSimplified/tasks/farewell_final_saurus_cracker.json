			"dialogs": [
				{
					"id": 750870501,
					"content": "既然你们都找到这里了，那我也不用再扮演什么善良的商人了吧？我已经受够了和笨蛋打交道，是时候透透气了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870502
					],
					"speakerTitle": "葵莉娅"
				},
				{
					"id": 750870502,
					"content": "你这家伙，居然把自己干的坏事说成是别人干的！害我们被白白误会！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870503,
					"content": "我是坏人，当然要干坏事。再说了，你们被那三个笨蛋误会，不正说明我的坏事干得不错？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870504
					],
					"speakerTitle": "葵莉娅"
				},
				{
					"id": 750870504,
					"content": "呵呵，现在我要干更坏的事了，你们可别逃跑哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870505
					],
					"speakerTitle": "葵莉娅"
				},
				{
					"id": 750870505,
					"content": "上吧！毛球！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870506
					],
					"speakerTitle": "葵莉娅"
				},
				{
					"id": 750870506,
					"content": "吼——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870507
					],
					"speakerTitle": "毛球"
				},
				{
					"id": 750870507,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870508
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870508,
					"content": "#上吧！{REALNAME[ID(2)|SHOWHOST(true)]}！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870509
					]
				},
				{
					"id": 750870509,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}！居然要挑战比自己大得多的对手！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870510
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870510,
					"content": "呜呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870511
					],
					"speakerTitle": "奥伯龙"
				},
				{
					"id": 750870511,
					"content": "呀！呀呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870512
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870512,
					"content": "奥伯龙没什么精神的样子，也不知道是因为和塔卢加分开而感到不安，还是单纯的龙龙饼干吃得太多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870513
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870513,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}会不会是想给它打气，所以才勇敢地站出来保护我们？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870514
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870514,
					"content": "这世上多得是光靠勇气无可奈何的事，比起那些虚无缥缈的东西，还是绝对的支配力更可靠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870515
					],
					"speakerTitle": "葵莉娅"
				},
				{
					"id": 750870515,
					"content": "攻击！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870516
					],
					"speakerTitle": "葵莉娅"
				},
				{
					"id": 750870516,
					"content": "#居然！{REALNAME[ID(2)|SHOWHOST(true)]}躲过了对方的攻击！这正是嵴锋龙的特长，就算是天空的王者也拿它没有办法！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870517,
						750870519,
						750870522,
						750870526
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870517,
					"content": "攻击。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870518
					]
				},
				{
					"id": 750870518,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}摆出了进攻的架势！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870530
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870530,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870531
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870531,
					"content": "攻击命中了！并且造成了…造成了微量伤害？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870532
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870532,
					"content": "呀呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870533
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870533,
					"content": "好好，没有被对方闪避而是成功命中已经很了不起了！呼——虽然才进行了一回合，但是已经觉得很累了，怎么回事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870534
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870534,
					"content": "那么接下来轮到我的回合了吧？攻击！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870535
					],
					"speakerTitle": "葵莉娅"
				},
				{
					"id": 750870535,
					"content": "#面对对手凌厉的进攻，{REALNAME[ID(2)|SHOWHOST(true)]}紧急采取防御态势！它防住了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870536
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870536,
					"content": "居然在进攻之后又自主选择了防御，可恶的规则破坏者…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870537
					],
					"speakerTitle": "葵莉娅"
				},
				{
					"id": 750870537,
					"content": "回合制取胜的方法就是不要回合制！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870538
					]
				},
				{
					"id": 750870538,
					"content": "接下来该怎么做呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870539
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870539,
					"content": "…呜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870540
					],
					"speakerTitle": "奥伯龙"
				},
				{
					"id": 750870540,
					"content": "欸？奥伯龙好像振作起来了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870541
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870541,
					"content": "呀！呀呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870542
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870542,
					"content": "虽然听不懂这是在说什么，但是看样子，它们之间好像达成了某种默契…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870543,
						750870545,
						750870547,
						750870550
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870543,
					"content": "协同攻击。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870544
					]
				},
				{
					"id": 750870544,
					"content": "哦！也让我们见识一下飞行学校明日之星的本领吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870552
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870552,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870553
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870553,
					"content": "#哦！奥伯龙封住了向空中躲避的路线，再由{REALNAME[ID(2)|SHOWHOST(true)]}发起主动进攻，一次漂亮的协同攻击！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870554
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870554,
					"content": "对毛球造成了不小的伤害！是打到脚了吗？想象一下脚趾撞到桌角的感受！对手看起来陷入了动摇状态，无法继续行动！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870555,
						750870557,
						750870560,
						750870562
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870555,
					"content": "攻击，但是由我发起。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870556
					]
				},
				{
					"id": 750870556,
					"content": "#虽然也是一种选择…但是难得有{REALNAME[ID(2)|SHOWHOST(true)]}表现的机会，就让给它嘛！别这么小孩子气了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870565
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870565,
					"content": "呜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870566
					],
					"speakerTitle": "奥伯龙"
				},
				{
					"id": 750870566,
					"content": "呀呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870567
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870567,
					"content": "#嗯？{REALNAME[ID(2)|SHOWHOST(true)]}和奥伯龙好像有什么计划的样子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870568
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870568,
					"content": "龙龙饼干！哪里来的龙龙饼干！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870569
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870569,
					"content": "呜！啊呜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870570
					],
					"speakerTitle": "奥伯龙"
				},
				{
					"id": 750870570,
					"content": "难、难道是藏在翅膀下带出来的？真是只狡猾小龙…塔卢加要应付你也真的很不容易呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870571
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870571,
					"content": "呜呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870572
					],
					"speakerTitle": "奥伯龙"
				},
				{
					"id": 750870572,
					"content": "现在还不是时候！喂！停下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870573
					],
					"speakerTitle": "葵莉娅"
				},
				{
					"id": 750870573,
					"content": "嗯？毛球无视了指令，径直朝龙龙饼干走去！恢复5点体力的诱惑实在太大了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870574
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870574,
					"content": "它没有察觉到！真正被放上餐碟的龙龙就是它自己！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870575
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870575,
					"content": "#总而言之，之后也进行了如此这般你来我往的战斗。\\n{REALNAME[ID(2)|SHOWHOST(true)]}自然是表现得十分英勇，像是要证明自己，虽然不能在飞行学校取得优秀学员的称号，也能靠其他本领为伙伴派上用场。\\n令人意外的是，就连奥伯龙在体重上的意外成长也并非没有作用，靠着较普通小绒翼龙稍大的体型，成功封锁了空中的战场，并且对毛球进行了沉重的打击…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750870576
					]
				},
				{
					"id": 750870576,
					"content": "葵莉娅本人似乎并没有任何战斗能力，在毛球丧失战意后，她也不得不退场。\\n「可恶的规则破坏者，下次…下次我不会让你赢得这么轻松！给我洗干净脖子等着吧！」\\n说完廉价反派退场时一定要说的台词后，带着负伤的毛球逃跑了。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750870577
					]
				},
				{
					"id": 750870577,
					"content": "哎呀！刚才忘记问她塔卢加在哪里了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870578
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870578,
					"content": "呜呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870579
					],
					"speakerTitle": "奥伯龙"
				},
				{
					"id": 750870579,
					"content": "哇，你先别难过，塔卢加那么聪明，肯定不会有事的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870580
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870580,
					"content": "呀！呀呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870581
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870581,
					"content": "#嗯嗯，{REALNAME[ID(2)|SHOWHOST(true)]}也是这么觉得的，对不对？现在我们先把奥伯龙送回飞行学校吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870557,
					"content": "说服对方投降。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870558
					]
				},
				{
					"id": 750870558,
					"content": "如果光靠对话就能解决问题，这个世界上为什么还会有这么多纷争？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870559
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870559,
					"content": "咳…我的意思是，成功的概率应该很低啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870565
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870560,
					"content": "使用神奇道具收服。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870561
					]
				},
				{
					"id": 750870561,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870565
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870562,
					"content": "趁现在逃跑吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870563
					]
				},
				{
					"id": 750870563,
					"content": "呜…呜呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870564
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870564,
					"content": "#哇，{REALNAME[ID(2)|SHOWHOST(true)]}都泄气了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870565
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870545,
					"content": "防御。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870546
					]
				},
				{
					"id": 750870546,
					"content": "明明是二对一却选择防御，对方应该也不能同时攻击到两个对象，这不是会浪费掉一个回合吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870552
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870547,
					"content": "道具。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870548
					]
				},
				{
					"id": 750870548,
					"content": "使用龙龙饼干恢复了5点体力！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870549
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870549,
					"content": "…根本没这种必要吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870552
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870550,
					"content": "逃跑。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870551
					]
				},
				{
					"id": 750870551,
					"content": "现在明明形势大好，你怎么还惦记着逃跑啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870552
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870519,
					"content": "防御。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870520
					]
				},
				{
					"id": 750870520,
					"content": "呜…呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870521
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870521,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}似乎认为防御的策略太过保守，会浪费大好机会，于是摆出了进攻的架势！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870530
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870522,
					"content": "道具。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870523
					]
				},
				{
					"id": 750870523,
					"content": "我们哪有可以现在用的道具啊！就算是想要设置捕兽夹也太晚了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870524
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870524,
					"content": "呜…呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870525
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870525,
					"content": "#哦！{REALNAME[ID(2)|SHOWHOST(true)]}摆出了进攻的架势！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870530
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870526,
					"content": "逃跑。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870527
					]
				},
				{
					"id": 750870527,
					"content": "现在不是逃跑的时候吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870528
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870528,
					"content": "呜呜…呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870529
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870529,
					"content": "#就连{REALNAME[ID(2)|SHOWHOST(true)]}都知道呢，看，它摆出了进攻的架势！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870530
					],
					"speakerTitle": "派蒙"
				}
			]
		},
