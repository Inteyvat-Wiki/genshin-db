			"dialogs": [
				{
					"id": 750870701,
					"content": "欸？塔卢加！你已经回来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870702
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870702,
					"content": "#{NICKNAME}{M#哥哥}{F#姐姐}！幸好你们也没事…我已经向姐姐他们说明情况了，拉密萨纳就跟我想的一样，是个笨蛋…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870703
					],
					"speakerTitle": "塔卢加"
				},
				{
					"id": 750870703,
					"content": "啊呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870704
					],
					"speakerTitle": "奥伯龙"
				},
				{
					"id": 750870704,
					"content": "是啊，比你还要笨呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870705
					],
					"speakerTitle": "塔卢加"
				},
				{
					"id": 750870705,
					"content": "呜呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870706
					],
					"speakerTitle": "奥伯龙"
				},
				{
					"id": 750870706,
					"content": "#好啦好啦，它和你分开这么久肯定也很不安。而且刚才它和{REALNAME[ID(2)|SHOWHOST(true)]}的配合也很不错呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870707
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870707,
					"content": "还有教化的余地。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870708
					]
				},
				{
					"id": 750870708,
					"content": "嗯，它还是只小龙嘛，只要塔卢加好好和它相处，之后肯定能成长为一只出色的绒翼龙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870709
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870709,
					"content": "呜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870710
					],
					"speakerTitle": "奥伯龙"
				},
				{
					"id": 750870710,
					"content": "说起来你是怎么回来的？是其他人找到你，先把你救出来了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870711
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870711,
					"content": "我是自己逃出来的。本来想带奥伯龙一起走，但它贪吃龙龙饼干，怎么劝都不肯动，我太生气了就自己一个人走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870712
					],
					"speakerTitle": "塔卢加"
				},
				{
					"id": 750870712,
					"content": "欸？这么容易吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870713
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870713,
					"content": "摸清看守龙的行动路线之后，我发现还是有可趁之机，很顺利就逃出来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870714
					],
					"speakerTitle": "塔卢加"
				},
				{
					"id": 750870714,
					"content": "搞不好塔卢加才是这里最可靠的一个…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870715
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870715,
					"content": "你们怎么来了！我正准备去找那个骗子算账…还有、还有向你们正式道歉…是我太武断了，险些诬陷了好人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870716,
						750870718
					],
					"speakerTitle": "拉密萨纳"
				},
				{
					"id": 750870716,
					"content": "太晚了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870717
					]
				},
				{
					"id": 750870717,
					"content": "就是！事情都结束了才现身，不是抢功又是什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870720
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870720,
					"content": "我无话可说。之前约定的报酬也好现在的赔偿也好，我都不会吝啬。对了，如果这样能让你们解气，给我一拳也行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870721
					],
					"speakerTitle": "拉密萨纳"
				},
				{
					"id": 750870721,
					"content": "我也是个男子汉，该负责任的时候不会推脱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870722,
						750870724
					],
					"speakerTitle": "拉密萨纳"
				},
				{
					"id": 750870722,
					"content": "#让{REALNAME[ID(2)|SHOWHOST(true)]}给你一拳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870723
					]
				},
				{
					"id": 750870723,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870726
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870726,
					"content": "好痛！还没挨到但是已经觉得很痛了！唯独这点还请高抬贵手…也请高抬贵脚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870727
					],
					"speakerTitle": "拉密萨纳"
				},
				{
					"id": 750870727,
					"content": "刚才还说自己是男子汉不会推脱呢，真是没出息啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870728
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870728,
					"content": "#算了，我们也不是这么小心眼的人物，对吧，{NICKNAME}，{REALNAME[ID(2)|SHOWHOST(true)]}？",
