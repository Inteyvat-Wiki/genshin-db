			"trigger": {
				"objectNames": [
					"温迪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101121001,
					"content": "谢谢你们，谢谢你们！我找到我要的东西了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121002
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 101121002,
					"content": "爸爸妈妈！看看我找到的神器吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121003
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 101121003,
					"content": "哎？等等！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121004
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101121004,
					"content": "说好的酒呢！我帮这么多忙也是很累的吧——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121005
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101121005,
					"content": "嗯？这不是斯坦利么，你到这里来散步吗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121006
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101121006,
					"content": "啊、啊哈哈哈哈，这不是吟游诗人吗！真巧，你也来这里散步？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121007
					],
					"speakerTitle": "斯坦利"
				},
				{
					"id": 101121007,
					"content": "是啊，吃完饭出来走走，陪朋友找点东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121008
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101121008,
					"content": "（我越来越觉得，斯坦利先生可能是骗子了…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121009,
						101121010
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101121009,
					"content": "（我也这么想…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101121011
					]
				},
				{
					"id": 101121011,
					"content": "（所以斯坦利是为了不伤害杰克的感情，才故意提前一步，到这里布置剑和盾吗？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121012
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101121012,
					"content": "大冒险家一定很熟悉达达乌帕谷吧？毕竟，这里是你战斗过的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121013
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101121013,
					"content": "当然，当然，我闭着眼睛都能把这里走遍！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121014
					],
					"speakerTitle": "斯坦利"
				},
				{
					"id": 101121014,
					"content": "原来如此，真佩服你的记性和毅力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121015
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101121015,
					"content": "我是大冒险家嘛，应该的！倒是你们，这里有很多丘丘人，可别掉以轻心啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121016
					],
					"speakerTitle": "斯坦利"
				},
				{
					"id": 101121016,
					"content": "那、那就再见了，年轻人们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121017
					],
					"speakerTitle": "斯坦利"
				},
				{
					"id": 101121017,
					"content": "他果然非常心虚啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121018
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101121018,
					"content": "没办法，谁让他对杰克夸下海口了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121019
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101121019,
					"content": "不过…再看一次，果然有意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121020
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101121020,
					"content": "不愿遗忘「过去」，而抛弃「现在」的人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121021
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101121021,
					"content": "如果他被迫迈出「向未来」的第一步，又会踏在什么方向呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121022
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101121022,
					"content": "嗯？什么意思？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121023
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101121023,
					"content": "哈哈，自言自语而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121024
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101121024,
					"content": "#对了，{NICKNAME}。今晚，我们去<color=#00E1FFFF>「天使的馈赠」</color>看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "温迪"
				},
				{
					"id": 101121010,
					"content": "（不是可能，是一定。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101121011
					]
				}
			]
