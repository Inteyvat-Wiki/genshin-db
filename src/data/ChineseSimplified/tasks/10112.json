			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"温迪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101120401,
					"content": "看，<color=#00E1FFFF>「辉煌勇气之剑」</color>！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120402
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101120402,
					"content": "不会吧？就是一把超普通的旧剑而已啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101120403,
					"content": "丘丘人为什么要围着这种东西膜拜呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101120404,
					"content": "（恐怕只是，有人把剑扔进了丘丘人本来就在膜拜的战利品堆里吧…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120405
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101120405,
					"content": "这、这也太旧了！而且…该怎么说呢，普通到让人说不出话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120406
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 101120406,
					"content": "不，杰克，你有没有见过蒙德城外飞舞的风晶蝶？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120407
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101120407,
					"content": "这种蝴蝶在白天毫不起眼，到了漆黑的夜晚却会光彩夺目，简直就像是会飞的宝石。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120408
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101120408,
					"content": "勇气不也是这样吗？一帆风顺的人不会明白它的可贵，可当你身处绝境，勇气就是令你奋起抗争、走出绝境的唯一之光。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120409,
						101120410,
						101120411
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101120409,
					"content": "巧舌如簧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120412
					]
				},
				{
					"id": 101120412,
					"content": "你、你说得太对了！没错就是这样，这一定就是「辉煌勇气之剑」啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120413
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 101120413,
					"content": "嗯，那么，剑已经找到，只差盾了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120414
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101120414,
					"content": "在附近转转吧！东西一定就在<color=#00E1FFFF>达达乌帕谷</color>里——嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120415
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101120415,
					"content": "哎呀？那边好像有个人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120416
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101120416,
					"content": "斯坦利？他怎么在这儿？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120417
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101120417,
					"content": "他的样子有点奇怪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120418
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101120418,
					"content": "出什么事了吗？为什么突然停下？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120419
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 101120419,
					"content": "没什么，刚才有只会撒金币的「盗宝鼬」跑过去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120420
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101120420,
					"content": "什么？在哪儿！我也要看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120421
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 101120421,
					"content": "你不是来找神器的吗？就别看啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "温迪"
				},
				{
					"id": 101120410,
					"content": "令人震撼。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120412
					]
				},
				{
					"id": 101120411,
					"content": "我都快信了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120412
					]
				}
			]
		},
		{
			"id": 1011206,
			"completionStepIds": [
				1011206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
