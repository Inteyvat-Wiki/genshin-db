			"trigger": {
				"objectNames": [
					"丘丘人"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101120601,
					"content": "看，<color=#00E1FFFF>「光耀意志之盾」</color>！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120602
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101120602,
					"content": "骗人！那根本就是块普通木板吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120603
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101120603,
					"content": "破破烂烂的，还带着桶箍！谁会把这种东西当成盾牌啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101120604,
					"content": "而且上面还有酒渍…像是从酒桶上随便拆下来的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120605
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 101120605,
					"content": "可按我吟游诗人的直觉，这就是「光耀意志之盾」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120606
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101120606,
					"content": "战士以身上的疤痕为荣，盾牌也是一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120607
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101120607,
					"content": "一面盾牌越是完整，越说明它远离战场。盾牌的破旧，不正是它身经百战的证明吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120608
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101120608,
					"content": "即使身躯残破，也要在战场上拼杀到最后一刻，要战斗到流干最后一滴血为止。这样的意志，难道不珍贵吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120609,
						101120610,
						101120611
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101120609,
					"content": "温迪说得对！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120612
					]
				},
				{
					"id": 101120612,
					"content": "说得也是…哪有干干净净的盾牌啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120613
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101120613,
					"content": "那我们…想办法问问它，能不能把「光耀意志之盾」转让给我们？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120614
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101120614,
					"content": "你好，丘丘人先生？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120615
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101120615,
					"content": "Dala？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120616
					],
					"speakerTitle": "丘丘人"
				},
				{
					"id": 101120616,
					"content": "#哇，{NICKNAME}还是你来吧。试试平时听过的那些丘丘语音节？或者用肢体语言交流吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120617,
						101120618,
						101120619
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101120617,
					"content": "我用摩拉和你换盾牌。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120622
					]
				},
				{
					"id": 101120622,
					"content": "Biadam！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120623
					],
					"speakerTitle": "丘丘人"
				},
				{
					"id": 101120623,
					"content": "呃…它好像<color=#00E1FFFF>不太开心</color>的样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120624,
						101120625,
						101120626
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101120624,
					"content": "这朵甜甜花，送给你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120627
					]
				},
				{
					"id": 101120627,
					"content": "Mosi mita！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120628
					],
					"speakerTitle": "丘丘人"
				},
				{
					"id": 101120628,
					"content": "嗯，看起来它的情绪还挺<color=#00E1FFFF>稳定</color>，也许可以继续谈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120631,
						101120633
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101120631,
					"content": "温迪，唱歌。盾牌，给我。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120632
					]
				},
				{
					"id": 101120632,
					"content": "嗯？好吧，那我就稍微弹一段…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120634
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101120634,
					"content": "Mosi mita！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120635
					],
					"speakerTitle": "丘丘人"
				},
				{
					"id": 101120635,
					"content": "嗯，看起来它的情绪还挺<color=#00E1FFFF>稳定</color>，也许可以继续谈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101120633,
					"content": "mani nini Biaodomu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120636
					]
				},
				{
					"id": 101120636,
					"content": "Biadam！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120637
					],
					"speakerTitle": "丘丘人"
				},
				{
					"id": 101120637,
					"content": "呃…它好像<color=#00E1FFFF>不太开心</color>的样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101120625,
					"content": "我收缴的丘丘面具，送给你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120629
					]
				},
				{
					"id": 101120629,
					"content": "Biadam！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120630
					],
					"speakerTitle": "丘丘人"
				},
				{
					"id": 101120630,
					"content": "呃…它好像<color=#00E1FFFF>不太开心</color>的样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120631,
						101120633
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101120626,
					"content": "Kucha pupu gusha ye!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120629
					]
				},
				{
					"id": 101120618,
					"content": "请把盾牌送给我们。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120622
					]
				},
				{
					"id": 101120619,
					"content": "Vin plata dada！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120620
					]
				},
				{
					"id": 101120620,
					"content": "Mosi mita！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120621
					],
					"speakerTitle": "丘丘人"
				},
				{
					"id": 101120621,
					"content": "嗯，看起来它的情绪还挺<color=#00E1FFFF>稳定</color>，也许可以继续谈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120624,
						101120625,
						101120626
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101120610,
					"content": "我也觉得这就是那面盾牌。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120612
					]
				},
				{
					"id": 101120611,
					"content": "不愧是你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120612
					]
				}
			]
