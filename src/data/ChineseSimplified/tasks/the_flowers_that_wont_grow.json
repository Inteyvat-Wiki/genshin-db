			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"瓦尔坦",
					"古尔根"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230230601,
					"content": "呼…差不多了，土壤的水分暂时应该足够了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230602
					],
					"speakerTitle": "瓦尔坦"
				},
				{
					"id": 230230602,
					"content": "谢谢你，旅行者。要是没你帮忙，我们非得累趴下不可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230603
					],
					"speakerTitle": "古尔根"
				},
				{
					"id": 230230603,
					"content": "真奇怪，这次怎么浇了这么多水才把土壤给浇透了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230604
					],
					"speakerTitle": "瓦尔坦"
				},
				{
					"id": 230230604,
					"content": "我感觉，这次浇水的量至少是平时的两倍还多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230605
					],
					"speakerTitle": "瓦尔坦"
				},
				{
					"id": 230230605,
					"content": "是你太累了，才出现了这种错觉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230606
					],
					"speakerTitle": "古尔根"
				},
				{
					"id": 230230606,
					"content": "要是浇两倍的水，那整片土壤都会泡在水里了，现在土壤的湿润程度还很正常啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230607
					],
					"speakerTitle": "古尔根"
				},
				{
					"id": 230230607,
					"content": "话是这么说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230608
					],
					"speakerTitle": "瓦尔坦"
				},
				{
					"id": 230230608,
					"content": "希望蔷薇能好好生长。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230609
					]
				},
				{
					"id": 230230609,
					"content": "请放心吧，为了「健康之家」的病人和医生们，我们也一定会照顾好这一株蔷薇的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230610
					],
					"speakerTitle": "瓦尔坦"
				},
				{
					"id": 230230610,
					"content": "这是一些谢礼，请收下吧，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230611
					],
					"speakerTitle": "瓦尔坦"
				},
				{
					"id": 230230611,
					"content": "唉，可我真觉得这次浇的水格外多啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瓦尔坦"
				}
			]
		},
