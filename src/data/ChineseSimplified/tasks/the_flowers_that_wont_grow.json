			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"瓦尔坦"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230230301,
					"content": "这些应该就足够了，实在感谢你，旅行者！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230302
					],
					"speakerTitle": "瓦尔坦"
				},
				{
					"id": 230230302,
					"content": "有了这种特制肥料，土壤的肥力就不成问题了，这株蔷薇一定能生长得很好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230303
					],
					"speakerTitle": "瓦尔坦"
				},
				{
					"id": 230230303,
					"content": "希望别和之前那些肥料一样，洒下去之后一点作用都没有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230304
					],
					"speakerTitle": "古尔根"
				},
				{
					"id": 230230304,
					"content": "你们之前用过肥料？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230305
					]
				},
				{
					"id": 230230305,
					"content": "用过一些很普通的，但效果并不好…不如说，是一点效果都没有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230306
					],
					"speakerTitle": "瓦尔坦"
				},
				{
					"id": 230230306,
					"content": "但那些肥料用在另外几片地里效果就非常好，也不知道这里到底出了什么问题…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230307
					],
					"speakerTitle": "古尔根"
				},
				{
					"id": 230230307,
					"content": "先不说这些了，这是一些谢礼，请收下吧，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瓦尔坦"
				}
			]
		},
		{
