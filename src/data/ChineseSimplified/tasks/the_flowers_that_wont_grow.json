			"dialogs": [
				{
					"id": 230230201,
					"content": "我们需要不少特制的肥料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230202
					],
					"speakerTitle": "瓦尔坦"
				},
				{
					"id": 230230202,
					"content": "这种特制肥料的其他原料我们还有一些储备，但「香辛果」已经用光了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230203
					],
					"speakerTitle": "瓦尔坦"
				},
				{
					"id": 230230203,
					"content": "旅行者，能请你帮我们去拿一些「香辛果」回来吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瓦尔坦"
				}
			]
		},
		{
			"id": 2302303,
			"completionStepIds": [
				2302303
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
