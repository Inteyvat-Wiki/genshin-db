					"id": 760830401,
					"content": "去吧，月灵们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830402
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760830402,
					"content": "猜猜看这是什么图案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830403,
						760830407,
						760830412
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760830403,
					"content": "月亮。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760830404
					]
				},
				{
					"id": 760830404,
					"content": "！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830405
					],
					"speakerTitle": "月灵"
				},
				{
					"id": 760830405,
					"content": "哼哼，这次还是挺明显的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760830406,
					"content": "对我们来说，这个谜底有些过于简单了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760830407,
					"content": "陆鳗鳗。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760830408
					]
				},
				{
					"id": 760830408,
					"content": "这次的这位是腰部出了问题？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760830409,
					"content": "你们的见闻真的非常丰富呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830410
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760830410,
					"content": "正确答案是月亮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830411
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760830411,
					"content": "回来吧，做得很好哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760830412,
					"content": "圆弧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760830413
					]
				},
				{
					"id": 760830413,
					"content": "谁都看得出来是圆弧吧！那么简单的结论怎么可能是正确答案啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760830414,
					"content": "的确不能说有错，可惜这并不是月灵们的本意。",
