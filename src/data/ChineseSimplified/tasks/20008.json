			"dialogs": [
				{
					"id": 200080101,
					"content": "谢谢，谢谢你救了我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200080102
					],
					"speakerTitle": "阿瑟尔"
				},
				{
					"id": 200080102,
					"content": "这些史莱姆突然冒出来，我没想到史莱姆会在这里出现，没来得及跑就被它们围住了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200080103
					],
					"speakerTitle": "阿瑟尔"
				},
				{
					"id": 200080103,
					"content": "你们千万别告诉我爸。我爸本来要我一直呆在家里。他说最近这周围的史莱姆都特别凶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200080104
					],
					"speakerTitle": "阿瑟尔"
				},
				{
					"id": 200080104,
					"content": "而且史莱姆都开始出现在蒙德城周围了，我已经闷在家里好几天了，今天是偷跑出来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200080105
					],
					"speakerTitle": "阿瑟尔"
				},
				{
					"id": 200080105,
					"content": "如果你们愿意的话，能去前面看看吗，如果有史莱姆的话，就请消灭它们吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200080106,
						200080107
					],
					"speakerTitle": "阿瑟尔"
				},
				{
					"id": 200080106,
					"content": "没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200080108
					]
				},
				{
					"id": 200080108,
					"content": "太好了！我总算能安心去玩了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿瑟尔"
				},
				{
					"id": 200080107,
					"content": "还有别的急事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200080109
					]
				},
				{
					"id": 200080109,
					"content": "可，可是，我不敢告诉我爸…能处理这事的只有你，拜托你了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿瑟尔"
				}
			]
		}
	]
