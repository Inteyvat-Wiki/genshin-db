			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"兰修提袈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730700401,
					"content": "兰罗摩！我们又见面啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730700402,
					"content": "#嗯！那菈{NICKNAME}、派蒙，你们好。这位是兰修提袈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700403
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730700403,
					"content": "#哇！那菈{NICKNAME}、派蒙，很高兴认识你们！和诗歌里说的一样，金色的那菈，又高又强壮！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700404
					],
					"speakerTitle": "兰修提袈"
				},
				{
					"id": 730700404,
					"content": "我也很高兴！兰修提袈是兰罗摩的朋友吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730700405,
					"content": "嗯！兰修提袈是「采歌者」，经常去收集各种各样的歌曲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700406
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730700406,
					"content": "在种子变成树苗之前，我们还一起藏在树叶里，到草王的大树里去，看那菈一边喝会让他们变笨的水，一边唱歌！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700407
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730700407,
					"content": "#那菈{NICKNAME}、派蒙，有诗歌吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700408
					],
					"speakerTitle": "兰修提袈"
				},
				{
					"id": 730700408,
					"content": "诗歌吗…如果是那个绿色的家伙，应该知道不少吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730700409,
					"content": "绿色的家伙？暝彩鸟？蕈猪？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700410
					],
					"speakerTitle": "兰修提袈"
				},
				{
					"id": 730700410,
					"content": "不是不是！他是蒙德的风神，是吟游诗人哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730700411,
					"content": "哇！那一定知道很多歌！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700412
					],
					"speakerTitle": "兰修提袈"
				},
				{
					"id": 730700412,
					"content": "好厉害！风神一定能把诗歌用风吹到很远很远的地方！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700413
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730700413,
					"content": "嗯！不过话说回来，这里是觉树之堂吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730700414,
					"content": "啊。不是的，但这也是很厉害的发现。在这里，沉睡着很多年没有兰那罗找到的歌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700415
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730700415,
					"content": "兰那罗的采歌者，会一直一直追求歌的美丽。所以，在时间的最后，会把只属于自己的歌留下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700416,
						730700418
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730700416,
					"content": "那和觉树之堂有关吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730700417
					]
				},
				{
					"id": 730700417,
					"content": "这边似乎是有兰玛哈留下的歌。如果是这样的话，附近应该就有莎兰树了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700420
					],
					"speakerTitle": "兰修提袈"
				},
				{
					"id": 730700420,
					"content": "莎兰树…之前兰拉迦好像说过，就是那个什么来着，我看看森林书…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700421
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730700421,
					"content": "#莎兰树！就是能结出恒素果的莎兰树！我们也帮忙吧，{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700422
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730700422,
					"content": "太好了！能和那菈一起研究过去的歌！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700423
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730700423,
					"content": "兰玛哈很喜欢这种玫瑰，但用玫瑰将诗歌藏起来的办法是兰雅玛发现的！因为兰雅玛很骄傲，所以他的玫瑰也很骄傲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700424
					],
					"speakerTitle": "兰修提袈"
				},
				{
					"id": 730700424,
					"content": "所以，玫瑰不会自己告诉我们。只有聪明的兰那罗，或者聪明的那菈，才能够找到隐藏的歌。但是兰修提袈不够聪明…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700425
					],
					"speakerTitle": "兰修提袈"
				},
				{
					"id": 730700425,
					"content": "#不用担心！哼哼，{NICKNAME}可是很聪明的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700426,
						730700427
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730700426,
					"content": "既然是为了帮助拉娜…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730700428
					]
				},
				{
					"id": 730700428,
					"content": "嗯！找东西嘛，我们很擅长的，对吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730700427,
					"content": "哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730700428
					]
				},
				{
					"id": 730700418,
					"content": "祝你们好运。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730700419
					]
				},
				{
					"id": 730700419,
					"content": "#嗯！谢谢那菈{NICKNAME}。这边似乎是兰玛哈留下的歌。如果是这样的话，附近应该就有莎兰树了。运气很好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700420
					],
					"speakerTitle": "兰罗摩"
				}
			]
		},
