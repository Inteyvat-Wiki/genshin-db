				},
				{
					"id": 730700502,
					"content": "#嗯！那菈{NICKNAME}、派蒙，你们好。这位是兰修提袈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700503
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730700503,
					"content": "#哇！那菈{NICKNAME}、派蒙，很高兴认识你们！和诗歌里说的一样，金色的那菈，又高又强壮！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700504
					],
					"speakerTitle": "兰修提袈"
				},
				{
					"id": 730700504,
					"content": "我也很高兴！兰修提袈是兰罗摩的朋友吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730700505,
					"content": "嗯！兰修提袈也是「采歌者」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700506
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730700506,
					"content": "在种子长成树苗之前，我们还一起藏在树叶里，到过草王的大树里！看那菈一边喝会让他们变笨的水，一边唱歌！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700507
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730700507,
					"content": "#那菈{NICKNAME}、派蒙，有诗歌吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700508
					],
					"speakerTitle": "兰修提袈"
				},
				{
					"id": 730700508,
					"content": "诗歌吗…如果是那个绿色的家伙，应该知道不少吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700509
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730700509,
					"content": "绿色的家伙？暝彩鸟？蕈猪？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700510
					],
					"speakerTitle": "兰修提袈"
				},
				{
					"id": 730700510,
					"content": "不是不是！他是蒙德的风神，是吟游诗人哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700511
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730700511,
					"content": "哇！那一定知道很多歌！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700512
					],
					"speakerTitle": "兰修提袈"
				},
				{
					"id": 730700512,
					"content": "好厉害！风神一定能把诗歌用风吹到很远很远的地方！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700513
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730700513,
					"content": "嗯！不过话说回来，这里也有隐藏的歌吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700514
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730700514,
					"content": "这边似乎是兰玛哈留下的歌。所以，附近应该有莎兰树了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700515
					],
					"speakerTitle": "兰修提袈"
				},
				{
					"id": 730700515,
					"content": "#所以，那就能得到恒素果…我们也帮忙吧，{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700516
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730700516,
					"content": "太好了！能和那菈一起研究过去的歌！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700517
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730700517,
					"content": "兰玛哈很喜欢这种玫瑰，但用玫瑰将诗歌藏起来的办法是兰雅玛发现的！因为兰雅玛很骄傲，所以他的玫瑰也很骄傲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700518
					],
					"speakerTitle": "兰修提袈"
				},
				{
					"id": 730700518,
					"content": "所以，玫瑰不会自己告诉我们。只有聪明的兰那罗，或者聪明的那菈，才能够找到隐藏的歌。但是兰修提袈不够聪明…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700519
					],
					"speakerTitle": "兰修提袈"
				},
				{
					"id": 730700519,
					"content": "#不用担心！哼哼，{NICKNAME}可是很聪明的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700520,
						730700521
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730700520,
					"content": "既然是为了帮助拉娜…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730700522
					]
				},
				{
					"id": 730700522,
					"content": "嗯！交给我们吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730700521,
					"content": "我可真是太聪明了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730700522
					]
				}
			]
		},
		{
			"id": 7307006,
			"completionStepIds": [
				7307006
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
