			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"兰修提袈",
					"兰罗摩",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730700601,
					"content": "「来呀，来呀，苗圃的梦想，树叶的记忆…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700602
					],
					"speakerTitle": "兰修提袈"
				},
				{
					"id": 730700602,
					"content": "「看，宝石一般的石榴，余晖色的日落果…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700603
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730700603,
					"content": "原来如此，兰纳迦他们的歌，和兰玛哈的歌是同源的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700604
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730700604,
					"content": "同源是指…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730700605,
					"content": "歌就像河川一样。他们一开始，都在一起，那就是「源之歌」，她是所有歌的故乡、大河的源头。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700606
					],
					"speakerTitle": "兰修提袈"
				},
				{
					"id": 730700606,
					"content": "后来，又因为不同的记忆、不同的故事，所以唱出来以后，发生变化。就像河流变成小溪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700607
					],
					"speakerTitle": "兰修提袈"
				},
				{
					"id": 730700607,
					"content": "但所有的小溪都会流入大海，所有的歌最终也会汇聚成同一首，回归成源之歌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700608
					],
					"speakerTitle": "兰修提袈"
				},
				{
					"id": 730700608,
					"content": "#所以，采歌的兰那罗，要找到所有的歌。这样的话，就能找到源之歌。谢谢你，那菈{NICKNAME}、派蒙，找到了兰玛哈的歌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700609,
						730700612
					],
					"speakerTitle": "兰修提袈"
				},
				{
					"id": 730700609,
					"content": "真是了不起的愿望。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730700610
					]
				},
				{
					"id": 730700610,
					"content": "#谢谢那菈{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700611
					],
					"speakerTitle": "兰修提袈"
				},
				{
					"id": 730700611,
					"content": "嗯…歌一直会变多，还会改变，那要怎样才能找到所有的歌呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700613
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730700613,
					"content": "兰那罗也会增加。所以，只要一直努力，一定没问题的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700614
					],
					"speakerTitle": "兰修提袈"
				},
				{
					"id": 730700614,
					"content": "兰玛哈的歌，能够吸引健壮的草种子。他的觉树之堂，应该也是这样封印的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700615
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730700615,
					"content": "#既然那菈{NICKNAME}找到了他的歌，我们就能到觉树之堂了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700616
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730700616,
					"content": "#嗯！祝你们好运，那菈{NICKNAME}、派蒙，还有兰罗摩！我先去为无忧节做准备啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700617
					],
					"speakerTitle": "兰修提袈"
				},
				{
					"id": 730700617,
					"content": "交给我们吧！无忧节再见，兰修提袈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700618
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730700618,
					"content": "再见！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰修提袈"
				},
				{
					"id": 730700612,
					"content": "歌是会不断增加的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730700613
					]
				}
			]
		},
