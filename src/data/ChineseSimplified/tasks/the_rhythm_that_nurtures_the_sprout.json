			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙",
					"兰罗摩"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730702101,
					"content": "第三颗恒素果到手！按照兰拉迦之前说的，记得是三个就够了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730702102,
					"content": "#嗯！应该够了。谢谢你们，那菈{NICKNAME}、派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702103,
						730702105
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730702103,
					"content": "不用谢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730702104
					]
				},
				{
					"id": 730702104,
					"content": "…这么说来，明明是兰罗摩在帮我们，为什么要感谢我们呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730702106,
					"content": "嗯。我想想，应该要这样说。因为你们也在帮助兰拉娜，兰拉娜是我的朋友，所以谢谢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702107
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730702107,
					"content": "#然后，那菈{NICKNAME}帮助兰耶娑、兰陀娑和兰修提袈，找到了古老的歌。他们也是我的朋友，所以谢谢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702108
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730702108,
					"content": "#最后，和那菈{NICKNAME}、派蒙一起冒险，我很开心，所以谢谢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702109
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730702109,
					"content": "我也很开心！谢谢你，兰罗摩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730702110,
					"content": "这么说来，觉树之堂附近感觉好像都曾经有人活动的痕迹…这边有什么故事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730702111,
					"content": "那是很久很久以前的故事，那时候我连种子都还不是。在很久很久以前，那菈都能看到兰那罗，兰那罗也不害怕那菈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702112
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730702112,
					"content": "#在那时候，那菈帮助兰那罗，兰那罗帮助那菈，我们一起玩，就像我和那菈{NICKNAME}一样，还经常一起唱歌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702113
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730702113,
					"content": "像兰耶娑他们那样的采歌者，原本也是兰那罗学习那菈得来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702114
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730702114,
					"content": "觉树之堂，原本是兰那罗和那菈一起玩的地方。但那是很久很久以前的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702115
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730702115,
					"content": "在发生了很可怕很可怕的灾难以后，桓那兰那毁灭了，觉树之堂也荒废了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702116
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730702116,
					"content": "原来是这样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730702117,
					"content": "嗯。那是很可怕的故事。但幸好，那只是故事，不是我的记忆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702118
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730702118,
					"content": "#别担心！以后会越来越好的，对吧，{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702119,
						730702120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730702119,
					"content": "嗯，没错。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730702122
					]
				},
				{
					"id": 730702122,
					"content": "已经找到了觉树之堂，也得到了三个恒素果。接下来，我要去帮忙准备无忧节，去把一些森林里的同伴叫回去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702123
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730702123,
					"content": "嗯！兰罗摩，加油！我好期待无忧节！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730702124,
					"content": "我也好期待！那就再见啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702125
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730702125,
					"content": "兰罗摩，再见！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730702120,
					"content": "这可不好说…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730702121
					]
				},
				{
					"id": 730702121,
					"content": "#…{NICKNAME}，你是不是累了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730702105,
					"content": "明明是你在帮我们…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730702106
					]
				}
			]
		},
