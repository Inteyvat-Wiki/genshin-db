			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"言笑"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718170201,
					"content": "不行了，我已经手酸到提不起锅了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170202
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718170202,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718170203
					]
				},
				{
					"id": 718170203,
					"content": "哎，旅行者，我刚才还在想要是有个人来帮忙就好了…你愿意给我帮帮忙吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170204
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718170204,
					"content": "什么忙…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718170205
					]
				},
				{
					"id": 718170205,
					"content": "海灯节期间，客栈里的人差不多都回去过节了，没多少能干活的人手，我们都忙得不可开交，多一个人来帮忙都是好事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170206
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718170206,
					"content": "你也不用太担心，不用你帮什么重活，只要你帮忙上上菜、采购点材料就行了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170207
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718170207,
					"content": "你等会啊，我瞧瞧，现在有什么可以叫你帮忙的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "言笑"
				}
			]
		},
		{
			"id": 7181703,
			"completionStepIds": [
				7181702
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
