			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"言笑"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718170301,
					"content": "哎哟，都给我忙忘了，楼下那桌客人的菜还没点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170302
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718170302,
					"content": "这样吧，你来给楼下两个外国客人那桌点单，就是荷尔德林和卡斯帕那桌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170303
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718170303,
					"content": "他们应该已经等了好一会儿了，可能有些等烦了，你记得先给他们上<color=#00E1FFFF>两份</color>小菜，<color=#00E1FFFF>美味的野菇鸡肉串</color>就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170304
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718170304,
					"content": "上完小菜之后再问问他们想吃些什么主菜，免得再跑一趟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170305
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718170305,
					"content": "快去吧，别让客人等急了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "言笑"
				}
			]
		},
