				"points": []
			},
			"dialogs": [
				{
					"id": 718170101,
					"content": "这下糟糕了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170102
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718170102,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718170103
					]
				},
				{
					"id": 718170103,
					"content": "海灯节啊，客栈里一堆人回去过节了，干活的人少了一堆，忙得要命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170104
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718170104,
					"content": "现在我没闲功夫跟你说话，得赶紧准备着，等晚上客人都来点菜了，我估计水都赶不上喝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170105
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718170105,
					"content": "你既然这么热心来关心我，那干脆晚上来帮忙吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170106
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718170106,
					"content": "唉，能抓一个帮工是一个，毓华跑哪儿去了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "言笑"
				}
			]
		},
		{
			"id": 7181702,
			"completionStepIds": [
				7181701
			],
