			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿万",
					"雅丝敏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230280401,
					"content": "雅丝敏？你怎么在这，呃…你是不是又要来撒你那个药水了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280402
					],
					"speakerTitle": "阿万"
				},
				{
					"id": 230280402,
					"content": "那段根系看着一切正常，没有什么问题啊，不需要再撒那种药水了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280403
					],
					"speakerTitle": "阿万"
				},
				{
					"id": 230280403,
					"content": "就算是这样，也应该细心照料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280404
					],
					"speakerTitle": "雅丝敏"
				},
				{
					"id": 230280404,
					"content": "如果等到问题出现后才想办法，那就像是做鱼卷时，明明卷好了饼，却发现鱼肉没有煮熟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280405
					],
					"speakerTitle": "雅丝敏"
				},
				{
					"id": 230280405,
					"content": "无论是重新做，还是拆开卷好的饼，都是一件很麻烦的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280406
					],
					"speakerTitle": "雅丝敏"
				},
				{
					"id": 230280406,
					"content": "我真是说不过你…但我上次也和你提到过那个药水的味道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280407
					],
					"speakerTitle": "阿万"
				},
				{
					"id": 230280407,
					"content": "我就住在这附近，可不想闻着那股怪味入睡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280408
					],
					"speakerTitle": "阿万"
				},
				{
					"id": 230280408,
					"content": "放心吧，我已经让拉德普修改过药水的配方了，味道不会很刺激的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280409
					],
					"speakerTitle": "雅丝敏"
				},
				{
					"id": 230280409,
					"content": "唉，好吧。我先走了啊，你可别来我家院子里撒那种药水，我可受不了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280410
					],
					"speakerTitle": "阿万"
				},
				{
					"id": 230280410,
					"content": "好啦，我知道了。旅行者，把那个箱子里的药水递给我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280411
					],
					"speakerTitle": "雅丝敏"
				},
				{
					"id": 230280411,
					"content": "和雅丝敏一起播撒了药水…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230280412
					]
				},
				{
					"id": 230280412,
					"content": "这药水的味道可真是难闻…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230280413,
					"content": "你好像没什么感觉？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230280414
					]
				},
				{
					"id": 230280414,
					"content": "如果你说的是气味方面的话…我接触过很多比这药水还难闻的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280415
					],
					"speakerTitle": "雅丝敏"
				},
				{
					"id": 230280415,
					"content": "这样就可以了，我也记录了很多数据，法尔希一定会很高兴的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280416
					],
					"speakerTitle": "雅丝敏"
				},
				{
					"id": 230280416,
					"content": "这些报酬给你，旅行者，谢谢你一路帮忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280417
					],
					"speakerTitle": "雅丝敏"
				},
				{
					"id": 230280417,
					"content": "也不知道拉德普和法尔希工作得怎么样了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雅丝敏"
				}
			]
		},
