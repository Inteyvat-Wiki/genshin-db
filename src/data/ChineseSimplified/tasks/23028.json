			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"雅丝敏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230280501,
					"content": "雅丝敏姐姐！呜哇！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280502
					]
				},
				{
					"id": 230280502,
					"content": "我，我要呼吸不过来了，我们快离开这里！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280503
					]
				},
				{
					"id": 230280503,
					"content": "这是什么…咳，咳咳！什么气味…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230280504,
					"content": "看来拉德普的工作做得不错嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280505
					],
					"speakerTitle": "雅丝敏"
				},
				{
					"id": 230280505,
					"content": "这里已经播撒完了，我们去下一个地方吧。就在附近，不用走多远。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雅丝敏"
				}
			]
		}
	]
