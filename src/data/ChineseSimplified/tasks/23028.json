			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"雅丝敏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230280101,
					"content": "旅行者，你们来得正好，我正在找人帮忙呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280102
					],
					"speakerTitle": "雅丝敏"
				},
				{
					"id": 230280102,
					"content": "是圣树根系出问题了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230280103
					]
				},
				{
					"id": 230280103,
					"content": "圣树现在的情况一切正常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280104
					],
					"speakerTitle": "雅丝敏"
				},
				{
					"id": 230280104,
					"content": "而我所要做的工作，就是让它继续正常下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280105
					],
					"speakerTitle": "雅丝敏"
				},
				{
					"id": 230280105,
					"content": "具体来说，我所要做的就是把这些药水播撒到圣树根系的周围。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280106
					],
					"speakerTitle": "雅丝敏"
				},
				{
					"id": 230280106,
					"content": "但这么多药水，我一个人搬不动，拉德普和法尔希也被工作缠住不能来帮忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280107
					],
					"speakerTitle": "雅丝敏"
				},
				{
					"id": 230280107,
					"content": "所以，我就想要请你帮我搬运一下这些药水。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280108,
						230280112
					],
					"speakerTitle": "雅丝敏"
				},
				{
					"id": 230280108,
					"content": "拉德普和法尔希是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230280109
					]
				},
				{
					"id": 230280109,
					"content": "他们和我一样是学生，不过拉德普属于悉般多摩学院，而法尔希属于刹诃伐罗学院。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280110
					],
					"speakerTitle": "雅丝敏"
				},
				{
					"id": 230280110,
					"content": "我们有一个共同的课题，虽然我们之间的理念不同，但目前正在合作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280111
					],
					"speakerTitle": "雅丝敏"
				},
				{
					"id": 230280111,
					"content": "这些药水，就是我们合作的成果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280113
					],
					"speakerTitle": "雅丝敏"
				},
				{
					"id": 230280113,
					"content": "嗯，我搬着这一罐，其余的就拜托你帮忙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280114
					],
					"speakerTitle": "雅丝敏"
				},
				{
					"id": 230280114,
					"content": "搬运的时候可要小心了，拉德普说，为了防止人误食这种药水，他特意把药水做得很难闻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280115
					],
					"speakerTitle": "雅丝敏"
				},
				{
					"id": 230280115,
					"content": "要是让药水沾在衣服上，那个难闻的气味可是很久都洗不掉的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雅丝敏"
				},
				{
					"id": 230280112,
					"content": "那我们就出发吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230280113
					]
				}
			]
		},
		{
			"id": 2302804,
			"completionStepIds": [
				2302804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
