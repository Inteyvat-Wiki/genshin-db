			"dialogs": [
				{
					"id": 722761001,
					"content": "怎么…怎么会这样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761002
					],
					"speakerTitle": "小柳"
				},
				{
					"id": 722761002,
					"content": "发生了什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761003
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722761003,
					"content": "我居然对我的朋友下手了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761004
					],
					"speakerTitle": "小柳"
				},
				{
					"id": 722761004,
					"content": "一定是文谷布下的怨灵上了我的身，控制了我的神智…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761005
					],
					"speakerTitle": "小柳"
				},
				{
					"id": 722761005,
					"content": "这么点秘宝，如何能比得上我和他的友谊。我、我绝对不会因为这么点财宝就动了歹念的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761006
					],
					"speakerTitle": "小柳"
				},
				{
					"id": 722761006,
					"content": "他那么信任我，找到了文谷之宝都会约我一同前来见证…我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761007
					],
					"speakerTitle": "小柳"
				},
				{
					"id": 722761007,
					"content": "我不是这样的人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761008
					],
					"speakerTitle": "小柳"
				},
				{
					"id": 722761008,
					"content": "唔，所以最后一块碎片掩盖了这个真相吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761009
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722761009,
					"content": "让他自己静一静吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722761010
					]
				},
				{
					"id": 722761010,
					"content": "说的也是呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761011
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722761011,
					"content": "我们回去和矢部说一声吧。",
					"roleType": "TALK_ROLE_NPC",
