				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"矢部"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722760101,
					"content": "#嘿，你是叫{NICKNAME}对吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760102
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722760102,
					"content": "不知道你有没有记住我的名字。我叫做矢部。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760103
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722760103,
					"content": "你好，矢部。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760104
					]
				},
				{
					"id": 722760104,
					"content": "你好你好，嘿嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760105
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722760105,
					"content": "说来，你应该身手挺厉害的吧。又是直面雷电将军又是纵横渊下宫的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760106
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722760106,
					"content": "确有其事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760107
					]
				},
				{
					"id": 722760107,
					"content": "那太好了。我这里有个关于宝藏的线索，但是可能很危险。你有兴趣吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760108
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722760108,
					"content": "我虽然天生喜欢一些神神叨叨的东西，但是终究还是爱惜这条小命的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760109
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722760109,
					"content": "有兴趣，讲讲。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760110
					]
				},
				{
					"id": 722760110,
					"content": "我在大日御舆趁着巡查之便，找到了这个。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760111
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722760111,
					"content": "看起来只是一个石板。但是我觉得它应该就是找到「文谷秘宝」的关键。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760112
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722760112,
					"content": "文谷秘宝？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760113
					]
				},
				{
					"id": 722760113,
					"content": "白夜国具体的历史在海祇岛是不怎么流传的。我也不是很清楚啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760114
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722760114,
					"content": "有个故事说，文谷是第二任宰相，和「太阳之子」一起横征暴敛。然后他把财宝藏在了大日御舆的秘密房间里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760115
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722760115,
					"content": "最后他利用阳炎幻法把宝藏密室藏起来了，还召唤了地脉里的秽鬼和怨念看守财宝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760116
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722760116,
					"content": "照理来说，文谷应该也有个什么忒什么斯的古代名字。但是小人和佞臣的故事也没谁去记录得这么清楚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760117
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722760117,
					"content": "说回石板吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760118
					]
				},
				{
					"id": 722760118,
					"content": "这个石板应该就是解锁文谷藏宝室的关键。我对怪谈传说、神秘案件之类的事情，可是有着长年累月的积累——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760119
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722760119,
					"content": "这一块石板上面的…呃…就是那个…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760120
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722760120,
					"content": "说实话。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760121
					]
				},
				{
					"id": 722760121,
					"content": "其实我在大日御舆储藏间找到这块石板的时候，旁边就有双语写的说明纸条。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760122
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722760122,
					"content": "过渡时期归档的文物好像都会用双语进行说明登记。而说明就写了，这个石板和「文谷案」直接相关。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760123
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722760123,
					"content": "说明还提到了石板的总数是八块，目前只回收了这一个。文谷密室根据记载也就在附近的那个位置。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760124
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722760124,
					"content": "那就麻烦你们过去看看了。宝藏我倒是真的无所谓，能见证「文谷案」的结局我就很开心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "矢部"
				}
			]
		},
		{
			"id": 7227602,
