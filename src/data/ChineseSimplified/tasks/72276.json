					"nextDialogs": [
						722761203
					]
				},
				{
					"id": 722761203,
					"content": "矢部啊矢部！我叫矢部！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761204
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722761204,
					"content": "唉，好好把我名字记住啊。我说，你该不会把我委托的事情忘了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761205
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722761205,
					"content": "#{NICKNAME}在开玩笑啦。我们已经找到了文谷秘宝的真相了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722761206,
					"content": "和矢部讲述了整个事情的经过…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722761207
					]
				},
				{
					"id": 722761207,
					"content": "所以说，阳炎幻法和宝藏密室确有其事？但是中途还发生过别的故事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761208
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722761208,
					"content": "怨灵和污秽也确有其事，还能控制人的心智。哎哟，吓坏我了。还好没和你们一起去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761209
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722761209,
					"content": "害怕伤害我们？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722761210
					]
				},
				{
					"id": 722761210,
					"content": "害怕被你们摁在地上打。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761211
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722761211,
					"content": "总之有点满足又有点遗憾，谢谢你们啦。虽然确实很玄乎，但是好像也都是元素力能解释的，有点不带劲儿啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761212
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722761212,
					"content": "文谷的迷案终于可以结掉了，我回去就让全世界知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "矢部"
				}
			]
