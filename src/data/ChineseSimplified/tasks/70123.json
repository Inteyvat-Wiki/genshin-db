				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"乔尔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701230101,
					"content": "爸爸到底去哪了……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230102
					],
					"speakerTitle": "乔尔"
				},
				{
					"id": 701230102,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701230103
					]
				},
				{
					"id": 701230103,
					"content": "啊…你好，我…我找不到我爸爸了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230104
					],
					"speakerTitle": "乔尔"
				},
				{
					"id": 701230104,
					"content": "他说好了要接我来雪山看雪的，不过约定的日子到了，他却一直没有来接我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230105
					],
					"speakerTitle": "乔尔"
				},
				{
					"id": 701230105,
					"content": "我猜，他一定是发现了什么珍贵秘宝的藏宝图之类的，所以才没来找我的，一定是这样的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230106
					],
					"speakerTitle": "乔尔"
				},
				{
					"id": 701230106,
					"content": "我就一个人来雪山了。既然他没法来找我，我就来找他好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230107
					],
					"speakerTitle": "乔尔"
				},
				{
					"id": 701230107,
					"content": "但是到了这里，我也没找到他。那位西风骑士叔叔说，他往山顶上走了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230108
					],
					"speakerTitle": "乔尔"
				},
				{
					"id": 701230108,
					"content": "我想自己去找爸爸，但西风骑士叔叔又不让我去，我就只能留在这里等爸爸回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230109
					],
					"speakerTitle": "乔尔"
				},
				{
					"id": 701230109,
					"content": "但是…但是他一直没回来，我还是很担心他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230110
					],
					"speakerTitle": "乔尔"
				},
				{
					"id": 701230110,
					"content": "如果你要进雪山的话，能帮我去找找他吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230111,
						701230112
					],
					"speakerTitle": "乔尔"
				},
				{
					"id": 701230111,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701230113
					]
				},
				{
					"id": 701230113,
					"content": "你是答应我了吧，太好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230114
					],
					"speakerTitle": "乔尔"
				},
				{
					"id": 701230114,
					"content": "我想想…那位西风骑士叔叔说，爸爸曾经提到过，他要先沿着<color=#00E1FFFF>「覆雪之路」一直往上走</color>…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230115
					],
					"speakerTitle": "乔尔"
				},
				{
					"id": 701230115,
					"content": "然后，再去<color=#00E1FFFF>雪山西面的山坡</color>附近看看，最后爸爸说他还想试试<color=#00E1FFFF>登上山顶</color>…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230116
					],
					"speakerTitle": "乔尔"
				},
				{
					"id": 701230116,
					"content": "请你先去这些地方找找看吧，爸爸说不定会在附近。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230117
					],
					"speakerTitle": "乔尔"
				},
				{
					"id": 701230117,
					"content": "他和我约好了一起看雪的，他一定会遵守约定的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "乔尔"
				},
				{
					"id": 701230112,
					"content": "去哪找呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701230113
					]
				}
			]
		}
	]
}