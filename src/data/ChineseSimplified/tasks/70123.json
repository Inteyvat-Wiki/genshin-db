			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"乔尔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701230501,
					"content": "怎么样？有我爸爸的消息了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230502,
						701230511
					],
					"speakerTitle": "乔尔"
				},
				{
					"id": 701230502,
					"content": "关于山顶洞窟里的发现…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701230503
					]
				},
				{
					"id": 701230503,
					"content": "爸爸他…不，爸爸是个很厉害的冒险家，这么点小问题，他一定能解决好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230504
					],
					"speakerTitle": "乔尔"
				},
				{
					"id": 701230504,
					"content": "爸爸的笔记里也说了，他已经找到办法下山了…他肯定已经安全下山了…你说对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230505
					],
					"speakerTitle": "乔尔"
				},
				{
					"id": 701230505,
					"content": "他应该已经安全下山了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701230506
					]
				},
				{
					"id": 701230506,
					"content": "对…他肯定已经安全下山了，现在正在休息呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230507
					],
					"speakerTitle": "乔尔"
				},
				{
					"id": 701230507,
					"content": "或者…或者他是在山顶的其他地方建了个新营地休息…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230508
					],
					"speakerTitle": "乔尔"
				},
				{
					"id": 701230508,
					"content": "总之，等爸爸休息好了…他就会回来这里找我了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230509
					],
					"speakerTitle": "乔尔"
				},
				{
					"id": 701230509,
					"content": "我会继续在这里等他的，谢谢你帮我忙，这些东西请你收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "乔尔"
				},
				{
					"id": 701230511,
					"content": "什么也没找到。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701230512
					]
				},
				{
					"id": 701230512,
					"content": "是…这样吗？但那位西风骑士叔叔说，爸爸确实进雪山了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230513
					],
					"speakerTitle": "乔尔"
				},
				{
					"id": 701230513,
					"content": "也许是他看错了？或者说…爸爸又去另外的地方建了个新营地…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230514
					],
					"speakerTitle": "乔尔"
				},
				{
					"id": 701230514,
					"content": "好吧，那我还是在这里等着吧…要是爸爸回来的时候找不到我，他准要着急了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230515
					],
					"speakerTitle": "乔尔"
				},
				{
					"id": 701230515,
					"content": "谢谢你帮我忙，这些东西给你，请收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230516
					],
					"speakerTitle": "乔尔"
				},
				{
					"id": 701230516,
					"content": "爸爸…你到底在哪啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "乔尔"
				}
			]
		},
