					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 701230201,
					"content": "到现在为止都很顺利，天气不错，补给充足，魔物也很安分…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230202
					],
					"speakerTitle": "字迹端正的笔记"
				},
				{
					"id": 701230202,
					"content": "还有，我居然在背包里发现了一本《野猪公主》第六卷，肯定是乔尔悄悄塞进来的，这孩子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230203
					],
					"speakerTitle": "字迹端正的笔记"
				},
				{
					"id": 701230203,
					"content": "不过这本书讲的是一位勇敢的野猪公主和她的朋友登上雪山的故事…正好我也在登雪山，登山的过程这么顺利，说不定就是这本书给我带来了好运，多谢啦，乔尔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230204
					],
					"speakerTitle": "字迹端正的笔记"
				},
				{
					"id": 701230204,
					"content": "总之，我准备接着往下一个营地进发，在那里补充补给，并且记录好情况后，我就会下山了，乔尔还在城里等着我呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "字迹端正的笔记"
				}
			]
		},
		{
			"id": 7012303,
			"completionStepIds": [
				7012303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7012302",
							"3"
						],
						"stepId": 7012302,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 701230301,
					"content": "这一路上没有出现任何意外，天气依然很不错，看来我运气终于好了一回。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230302
					],
					"speakerTitle": "字迹端正的笔记"
				},
				{
					"id": 701230302,
					"content": "说不定，我可以试试冲击山顶了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230303
					],
					"speakerTitle": "字迹端正的笔记"
				},
				{
					"id": 701230303,
					"content": "只是稍微试试看，如果出现任何问题，我会马上退下来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "字迹端正的笔记"
				}
			]
		},
		{
			"id": 7012304,
			"completionStepIds": [
				7012304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7012303",
							"3"
						],
						"stepId": 7012303,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 701230401,
					"content": "山顶上的暴风雪来得太快，我只来得及逃进这个洞穴里，补给也丢了大半…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230402
					],
					"speakerTitle": "字迹潦草的笔记"
				},
				{
					"id": 701230402,
					"content": "而且不知道什么原因…洞口上面的石头突然碎了，落下来的碎石把洞口也封死了，这回真糟糕了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230403
					],
					"speakerTitle": "字迹潦草的笔记"
				},
				{
					"id": 701230403,
					"content": "但我觉得…还有一条生路。洞口另一边虽然是悬崖，但下面都是厚厚的雪，如果我能先爬下去一段距离，再往下跳的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230404
					],
					"speakerTitle": "字迹潦草的笔记"
				},
				{
					"id": 701230404,
					"content": "补给已经支持不了几天了，我必须尽快行动…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230405
					],
					"speakerTitle": "字迹潦草的笔记"
				},
				{
					"id": 701230405,
					"content": "我已经和乔尔约好了要带他看雪，我不会毁约的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230406
					],
					"speakerTitle": "字迹潦草的笔记"
				},
				{
					"id": 701230406,
					"content": "对了，如果有人看到这本笔记的话，就帮我再往那个食盆里放点吃的，喂喂那群狐狸吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230407
					],
					"speakerTitle": "字迹潦草的笔记"
				},
				{
					"id": 701230407,
					"content": "我被困在这里的时候，是那群小家伙一直陪着我，如果有机会的话，我真想带着乔尔再来看看它们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "字迹潦草的笔记"
				}
			]
		},
		{
			"id": 7012305,
			"completionStepIds": [
				7012305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
