			"dialogs": [
				{
					"id": 230190401,
					"content": "怎么样，你检查完那艘船了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190402
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230190402,
					"content": "已经检查完了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230190403
					]
				},
				{
					"id": 230190403,
					"content": "在描述了船只情况之后…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230190404
					]
				},
				{
					"id": 230190404,
					"content": "原来如此，那些为了省钱而用了取巧功夫的结构果然出问题了啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190405
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230190405,
					"content": "但维修这种结构要花不少钱，那个船主人，我记得手头一直很拮据…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190406
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230190406,
					"content": "唉，我还是去和他谈谈吧，和钱相比，肯定是命更重要啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "拉菲克"
				}
			]
		}
	]
