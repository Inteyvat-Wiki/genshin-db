			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"拉菲克"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230190101,
					"content": "果然，这样做会更花钱啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190102
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230190102,
					"content": "你在说什么呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230190103
					]
				},
				{
					"id": 230190103,
					"content": "啊，你好，我正在研究一艘船只的设计问题呢，现在…遇到了一些瓶颈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190104
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230190104,
					"content": "简单来说，就是我想在不提高造价的情况下，让船能装更多的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190105
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230190105,
					"content": "一旦重量大了，结构会变得更容易破损，重量不均匀的情况下平衡也会出现问题…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190106
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230190106,
					"content": "解决这些问题的最好方法，就是用更好的材料，但这样…问题就又回到了造价问题上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190107
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230190107,
					"content": "唉，其实说白了就是我没钱，但又想要造出一艘好船。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190108
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230190108,
					"content": "所以某些用钱就能砸通的问题，我只能想办法用一些技术性的手段绕过去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190109
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230190109,
					"content": "真的能这么做吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230190110
					]
				},
				{
					"id": 230190110,
					"content": "哈哈哈，说出来你可能不信，但其实有很多人都这么做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190111
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230190111,
					"content": "毕竟我们造的船也都是不会遇见什么风浪的近海渔船。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190112
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230190112,
					"content": "大家都秉承着能省则省，修修补补的原则造船…凑合凑合，能用就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190113
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230190113,
					"content": "拜这原则所赐，我们修船的生意每天都好得不行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190114
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230190114,
					"content": "旅行者，如果你愿意的话，就帮我去那边检查一下那艘刚回港的船吧，它貌似因为经常运载重物出了点问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190115
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230190115,
					"content": "我刚好就在研究这方面的问题，说不定能从它身上找到点灵感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190116,
						230190118
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230190116,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230190117
					]
				},
				{
					"id": 230190117,
					"content": "那就拜托你了！我得赶紧去修另外一艘船去了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230190118,
					"content": "你自己怎么不去？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230190119
					]
				},
				{
					"id": 230190119,
					"content": "我也想自己去，但我还被人拜托去维修另外一艘急着要再出海收网的船…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190120
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230190120,
					"content": "所以就只能拜托你了，旅行者！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "拉菲克"
				}
			]
		},
