				}
			]
		},
		{
			"id": 7415101,
			"completionStepIds": [
				7415101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7415101",
							"2"
						],
						"stepId": 7415101,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7415104",
							"3"
						],
						"stepId": 7415104,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"茉莉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741510101,
					"content": "#{M#哥哥姐姐}{F#大姐姐，小姐姐}，你们来啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510102
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741510102,
					"content": "#我叫派蒙，{M#他}{F#她}叫{NICKNAME}，以后称呼我们的名字就好啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741510103,
					"content": "茉莉来找伯努瓦吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510104
					]
				},
				{
					"id": 741510104,
					"content": "对，但我和勒鲁瓦先生都说不上话…唉，这下我的作文写不成了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510105
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741510105,
					"content": "作文？哦哦，我记起来了，茉莉是为了写家庭作业才做好人好事的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741510106,
					"content": "才不是呢，我本来就很喜欢伯努瓦先生，他很…嗯…滑滑的！对，就是滑滑的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510107
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741510107,
					"content": "噗，这是什么形容，这里该说擅长交际之类的才对吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741510108,
					"content": "好派蒙姐姐，可不可以帮我想想办法？我的文章写不出来了呜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510109
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741510109,
					"content": "家庭教师小姐说我帮勒鲁瓦先生喂猫的文章「质噗又充满真情实感」，要我接着再写一篇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510110
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741510110,
					"content": "什么「质噗」啊，是质朴吧。哦，我懂了，难怪你要到伯努瓦家门口来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741510111,
					"content": "虽然我是为了家庭作业，但我真的也很喜欢勒鲁瓦先生！他要我向爸爸妈妈问好，我也问了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510112
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741510112,
					"content": "爸爸妈妈听到伯努瓦先生的名字很不开心，不让我来，我也不知道为什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510113
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741510113,
					"content": "茉莉需要写作文的素材还不简单。就像上次一样，帮忙喂一喂猫就好了呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741510114,
					"content": "这样只够写一行，太少了，不行的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510115
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741510115,
					"content": "我们陪你一起。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510116
					]
				},
				{
					"id": 741510116,
					"content": "对，对，就像之前那样。你喂猫，我们来把门口和屋后的污迹清理干净。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741510117,
					"content": "好了之后我们一起敲门找伯努瓦说话，你不就有内容可以写了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741510118,
					"content": "对哦，可以这样！派蒙姐姐真聪明，我现在就去喂猫猫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "茉莉"
				}
			]
		},
		{
