			"dialogs": [
				{
					"id": 741510901,
					"content": "这对夫妇不对劲。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510902
					]
				},
				{
					"id": 741510902,
					"content": "我也觉得有点奇怪，他们一个话特别多，一个话特别少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510903
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741510903,
					"content": "他们出现的时机太巧合了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510904
					]
				},
				{
					"id": 741510904,
					"content": "你的意思是，就在伯努瓦想要招募钟点工照顾自己的时候，他们出现了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
