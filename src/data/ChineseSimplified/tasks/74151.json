			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"茉莉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741510301,
					"content": "#派蒙姐姐，{NICKNAME}{M#哥哥}{F#姐姐}，我喂过娜娜了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510302
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741510302,
					"content": "好了，我们一起去敲门找勒鲁瓦先生吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741510303,
					"content": "但是我有点担心，他会不会不出来呢？最近我来找勒鲁瓦先生，他都不和我说话了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510304
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741510304,
					"content": "你们来之前我去敲过门，他刚出来，那个凶凶的女婿叔叔就把他拉回去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510305
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741510305,
					"content": "很凶的叔叔给了我一点糖，让我回家找爸爸妈妈，然后就把门关上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510306
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741510306,
					"content": "伯努瓦明明是很和气的人，他的家人怎么这么冷漠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741510307,
					"content": "女婿叔叔说勒鲁瓦先生生病了，不方便，但是我看他很健康啊，为什么不能跟我说话呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510308
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741510308,
					"content": "派蒙姐姐，我觉得我的作文不写也没有关系，我更担心勒鲁瓦先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510309
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741510309,
					"content": "他生病了的话，一定很难受的，我妈妈说人生病很可怜，要多关心生病的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510310
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741510310,
					"content": "你们可不可以跟我一起问问女婿叔叔，勒鲁瓦先生得了什么病。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510311
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741510311,
					"content": "是蛋糕吃太多还是睡觉没有盖好被子？我可以回家去问爸爸妈妈该怎么办。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510312,
						741510313
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741510312,
					"content": "一起去敲门吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510314
					]
				},
				{
					"id": 741510314,
					"content": "我就是有点怕女婿叔叔，你们帮我跟他说话好不好？他好凶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510315
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741510315,
					"content": "别怕，小茉莉，我们帮你问。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741510313,
					"content": "本来就约好了的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510314
					]
				}
			]
		},
