			},
			"dialogs": [
				{
					"id": 741500501,
					"content": "爸爸，你最近睡得怎么样？还失眠吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500502
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741500502,
					"content": "我好多了，最近几乎不做噩梦了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500503
					],
					"speakerTitle": "伯努瓦·勒鲁瓦"
				},
				{
					"id": 741500503,
					"content": "（勒鲁瓦一家的闲聊逐渐听不清了）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
