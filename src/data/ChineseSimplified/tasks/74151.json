							3591.538,
							435.092,
							4530.267
						],
						"pointId": 7521
					}
				]
			},
			"dialogs": [
				{
					"id": 741510501,
					"content": "先前见过的阿托斯打开大门，走了出来。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741510502
					]
				},
				{
					"id": 741510502,
					"content": "又是你们？你们到底有什么事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510503
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741510503,
					"content": "请问伯努瓦在家吗？我们听说他生病了，有点担心他的身体。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741510504,
					"content": "我父亲在家，但他身体不舒服，不适合出门见客人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510505
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741510505,
					"content": "可以告诉我他生了什么病吗？我可以请爸爸妈妈帮忙，给勒鲁瓦先生带药来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510506
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741510506,
					"content": "不用了，药我们自己会买，更何况我父亲不缺药。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510507
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741510507,
					"content": "我们只是想关心一下病人，干嘛这么冷淡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741510508,
					"content": "（这个阿托斯完全不让我们见伯努瓦！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510509,
						741510510
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741510509,
					"content": "（冷淡得有点过分…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510511
					]
				},
				{
					"id": 741510511,
					"content": "别人的事情，你们关心得过多了。好了，你们还有别的事吗？没有我就回去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510512
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741510512,
					"content": "等一下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510513
					]
				},
				{
					"id": 741510513,
					"content": "你要说什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510514,
						741510516
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741510514,
					"content": "伯努瓦真的生病了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510515
					]
				},
				{
					"id": 741510515,
					"content": "当然生病了，他病得很严重，我和莫蒂西娅正在想办法。这一点用不着别人操心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510518
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741510518,
					"content": "阿托斯，外面在吵什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510519
					],
					"speakerTitle": "莫蒂西娅"
				},
				{
					"id": 741510519,
					"content": "没什么，莫蒂西娅，有几个孩子说要探望爸爸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510520
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741510520,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510521
					],
					"speakerTitle": "莫蒂西娅"
				},
				{
					"id": 741510521,
					"content": "爸爸，你在小孩子中的人缘真好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510522
					],
					"speakerTitle": "莫蒂西娅"
				},
				{
					"id": 741510522,
					"content": "既然有孩子想来看你，那你要不要出面打个招呼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510523
					],
					"speakerTitle": "莫蒂西娅"
				},
				{
					"id": 741510523,
					"content": "…我去看看…可以吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510524
					],
					"speakerTitle": "伯努瓦·勒鲁瓦"
				},
				{
					"id": 741510524,
					"content": "当然可以，你说了算，爸爸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510525
					],
					"speakerTitle": "莫蒂西娅"
				},
				{
					"id": 741510525,
					"content": "大门打开，伯努瓦从屋内缓缓走了出来。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741510526
					]
				},
				{
					"id": 741510526,
					"content": "小客人们，你们又来了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510527
					],
					"speakerTitle": "伯努瓦·勒鲁瓦"
				},
				{
					"id": 741510527,
					"content": "勒鲁瓦先生，你还好吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510528
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741510528,
					"content": "我？…咳咳，我的身体状况不是很好。但你们不用担心，我正在尽力休养。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510529
					],
					"speakerTitle": "伯努瓦·勒鲁瓦"
				},
				{
					"id": 741510529,
					"content": "我的女儿和女婿待我很好，一切都好，你们回家去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510530
					],
					"speakerTitle": "伯努瓦·勒鲁瓦"
				},
				{
					"id": 741510530,
					"content": "爸爸，你的身体没问题吗？觉得勉强的话，就回家去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510531
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741510531,
					"content": "伯努瓦看着阿托斯的眼色，默默进了门。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741510532
					]
				},
				{
					"id": 741510532,
					"content": "好了，你们看到了吧，我父亲确实身体不舒服，这下你们满意了吧？没事我就回去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510533
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741510533,
					"content": "我们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510534
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741510534,
					"content": "阿托斯无视了你们。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741510535
					]
				},
				{
					"id": 741510535,
					"content": "这次和勒鲁瓦先生说了两句话，唉，希望他的身体快点好起来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510536
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741510536,
					"content": "派蒙姐姐，我好像给别人带来麻烦了，其实我不想这样的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510537
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741510537,
					"content": "茉莉怎么会这么想？你才没有给别人带来麻烦呢，要我说，有问题的是那个阿托斯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510538
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741510538,
					"content": "哼…什么嘛，他从头到尾…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510539,
						741510540
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741510539,
					"content": "茉莉先回家去吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510541
					]
				},
				{
					"id": 741510541,
					"content": "#欸，{NICKNAME}你怎么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510542
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741510542,
					"content": "嗯，我是该回去了。其实爸爸妈妈很不喜欢我到这里来，要是给他们知道我今天去哪儿了，他们会生气的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510543
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741510543,
					"content": "不知道还有没有机会见到勒鲁瓦先生了，我其实很想告诉他点心特别特别好吃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510544
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741510544,
					"content": "等他身体好了，如果你们能见到他，替我告诉他好吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510545,
						741510546
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741510545,
					"content": "没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510547
					]
				},
				{
					"id": 741510547,
					"content": "我也答应你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510548
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741510548,
					"content": "#好，谢谢你，{NICKNAME}{M#哥哥}{F#姐姐}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510549
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741510549,
					"content": "#我回家去啦，{M#哥哥姐姐}{F#姐姐们}再见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510550
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741510550,
					"content": "#{NICKNAME}，你是不是想到什么了？从刚才开始看你就是一副有话要说的样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510551,
						741510552
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741510551,
					"content": "我们到一边去聊吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510553
					]
				},
				{
					"id": 741510553,
					"content": "好吧，那我们到别处说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741510552,
					"content": "别在这里大声说这些。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510553
					]
				},
				{
					"id": 741510546,
					"content": "我答应你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510547
					]
				},
				{
					"id": 741510540,
					"content": "我和派蒙也要回去了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510541
					]
				},
				{
					"id": 741510516,
					"content": "为什么阻止我们见伯努瓦？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510517
					]
				},
				{
					"id": 741510517,
					"content": "我为什么非要允许不相干的人跑去探望父亲呢？我都说了，他的身体状况不适合见客人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510518
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741510510,
					"content": "（冷淡得有点突然…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510511
					]
				}
			]
		},
