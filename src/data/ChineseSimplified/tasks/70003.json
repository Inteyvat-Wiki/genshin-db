			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿拉米"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700030601,
					"content": "实在抱歉，我好像没见到，如果真的看见的话，我应该有印象才对…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030602
					],
					"speakerTitle": "阿拉米"
				},
				{
					"id": 700030602,
					"content": "是吗，那孩子一直很喜欢花瓣，我还以为它会追着花瓣跑到这来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030603
					],
					"speakerTitle": "玛格丽特"
				},
				{
					"id": 700030603,
					"content": "你们是在找猫吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030604
					]
				},
				{
					"id": 700030604,
					"content": "喵…喵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030605
					],
					"speakerTitle": "迷路的小猫"
				},
				{
					"id": 700030605,
					"content": "这声音是…小蝴蝶？真是的，你跑到哪儿去了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030606
					],
					"speakerTitle": "玛格丽特"
				},
				{
					"id": 700030606,
					"content": "它跑到屋顶上去了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030607
					]
				},
				{
					"id": 700030607,
					"content": "果然和我想的一样…多谢你了。小蝴蝶总喜欢追着花瓣到处跑，在这个满城都飘着花瓣的风花节，也格外让人头疼，幸好有你帮忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030608
					],
					"speakerTitle": "玛格丽特"
				},
				{
					"id": 700030608,
					"content": "下次你来「猫尾酒馆」的话，我可以请你喝一杯哦，啊，当然是不含酒的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030609,
						700030610
					],
					"speakerTitle": "玛格丽特"
				},
				{
					"id": 700030609,
					"content": "果然是这样…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030611
					]
				},
				{
					"id": 700030611,
					"content": "呵呵，总之谢谢你了，那就回头再见啦。祝你风花节快乐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030612
					],
					"speakerTitle": "玛格丽特"
				},
				{
					"id": 700030612,
					"content": "没想到连猫也会被花瓣吸引，风花节还真是热闹…不过，还好是让你给找到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030613
					],
					"speakerTitle": "阿拉米"
				},
				{
					"id": 700030613,
					"content": "要是让我爬上城墙去找猫，我这膝盖可真的就吃不消了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030614
					],
					"speakerTitle": "阿拉米"
				},
				{
					"id": 700030614,
					"content": "真是麻烦你了，这些谢礼请你收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿拉米"
				},
				{
					"id": 700030610,
					"content": "还是留到将来吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030611
					]
				}
			]
		}
	]
}