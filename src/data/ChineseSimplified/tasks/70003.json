			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"迷路的小猫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700030501,
					"content": "真的有只小猫呢，为什么会跑到这里来呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700030502,
					"content": "喵…喵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030503,
						700030504
					],
					"speakerTitle": "迷路的小猫"
				},
				{
					"id": 700030503,
					"content": "喵喵喵？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030505
					]
				},
				{
					"id": 700030505,
					"content": "喵，喵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030506
					],
					"speakerTitle": "迷路的小猫"
				},
				{
					"id": 700030506,
					"content": "嗯…我觉得它听不懂你在说什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700030507,
					"content": "还是先把它抱下去吧，说不定阿拉米先生会知道它的主人是谁呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700030504,
					"content": "你迷路了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030505
					]
				}
			]
		},
		{
			"id": 7000306,
			"completionStepIds": [
				7000308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7000308",
							"2"
						],
						"stepId": 7000308,
						"stateName": "QUEST_STATE_UNFINISHED"
