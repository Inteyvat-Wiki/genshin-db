			"trigger": {
				"objectNames": [
					"阿拉米"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700030101,
					"content": "唉，该怎么办呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030102
					],
					"speakerTitle": "阿拉米"
				},
				{
					"id": 700030102,
					"content": "你遇到什么麻烦了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030103
					]
				},
				{
					"id": 700030103,
					"content": "风花节一到，总有人到这里向神像献上各种花卉，风一吹，那些花卉散落的花瓣就会飞向全城。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030104
					],
					"speakerTitle": "阿拉米"
				},
				{
					"id": 700030104,
					"content": "为了清理这些枯花，我们也没少花力气，但是，广场上的花瓣和落叶我还能帮着清理一下，吹到屋顶和城墙上的我可就没辙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030105
					],
					"speakerTitle": "阿拉米"
				},
				{
					"id": 700030105,
					"content": "特别是我这个膝盖，真是越来越顶不住了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030106
					],
					"speakerTitle": "阿拉米"
				},
				{
					"id": 700030106,
					"content": "我可以帮忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030107
					]
				},
				{
					"id": 700030107,
					"content": "你愿意帮忙吗？那太好了，那些枯萎的花瓣堆很明显，你爬上屋顶之后，应该就能很容易看到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿拉米"
				}
			]
		},
		{
