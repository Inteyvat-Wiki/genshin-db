			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿尔伯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731850101,
					"content": "呼…呼…谢谢你旅行者…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850102,
						731850103
					],
					"speakerTitle": "阿尔伯"
				},
				{
					"id": 731850102,
					"content": "没事就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850104
					]
				},
				{
					"id": 731850104,
					"content": "我叫阿尔伯，是个商人，本来只是在这里休息一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850105
					],
					"speakerTitle": "阿尔伯"
				},
				{
					"id": 731850105,
					"content": "但没想到，却被那些丘丘人突然袭击了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850106,
						731850107
					],
					"speakerTitle": "阿尔伯"
				},
				{
					"id": 731850106,
					"content": "你没有护卫吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850108
					]
				},
				{
					"id": 731850108,
					"content": "对呀，我们在城里听说，外出运货的商人们一般都会雇佣「镀金旅团」的人来帮忙呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731850109,
					"content": "哎呀，我…我不是舍不得那些钱吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850110
					],
					"speakerTitle": "阿尔伯"
				},
				{
					"id": 731850110,
					"content": "那些「镀金旅团」的人出价时个个都是狮子大开口，要的数目一个比一个夸张。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850111
					],
					"speakerTitle": "阿尔伯"
				},
				{
					"id": 731850111,
					"content": "我本来做的就是小本生意，可付不起那么多钱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850112
					],
					"speakerTitle": "阿尔伯"
				},
				{
					"id": 731850112,
					"content": "我就想，反正我也会一点武艺，运货的路程也不远，干脆直接出发算了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850113
					],
					"speakerTitle": "阿尔伯"
				},
				{
					"id": 731850113,
					"content": "但没想到，那些丘丘人袭击的时候，把我的两只驮兽惊到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850114
					],
					"speakerTitle": "阿尔伯"
				},
				{
					"id": 731850114,
					"content": "我还没反应过来，就先被一只驮兽撞到了地上，站起来之后，又挨了另外一只驮兽一蹄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850115
					],
					"speakerTitle": "阿尔伯"
				},
				{
					"id": 731850115,
					"content": "呜哇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731850116,
					"content": "然后，两只驮兽夺路而跑，我则被那群丘丘人围攻…还好有你们帮忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850117
					],
					"speakerTitle": "阿尔伯"
				},
				{
					"id": 731850117,
					"content": "但我的全部身家都在那两头驮兽的身上…旅行者，能不能请你去帮我把它们带回来？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850118,
						731850119
					],
					"speakerTitle": "阿尔伯"
				},
				{
					"id": 731850118,
					"content": "我，我不想被踢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850120
					]
				},
				{
					"id": 731850120,
					"content": "没事，没事，不用担心。它们的性情本来很温和的，只是那些丘丘人把它们的食物给打翻了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850121
					],
					"speakerTitle": "阿尔伯"
				},
				{
					"id": 731850121,
					"content": "它们驮着货物走了这么远，已经非常饿了，被打翻食物之后就变得格外暴躁…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850122
					],
					"speakerTitle": "阿尔伯"
				},
				{
					"id": 731850122,
					"content": "原来如此…在吃饭的时候被打扰，吃的东西还都被打翻了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731850123,
					"content": "唔唔唔，光是想想都很生气了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731850124,
					"content": "派蒙理解得可真快啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850125
					]
				},
				{
					"id": 731850125,
					"content": "这样好了…来，这些食物给你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850126
					],
					"speakerTitle": "阿尔伯"
				},
				{
					"id": 731850126,
					"content": "你找到驮兽之后，就把这些食物喂给它们吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850127
					],
					"speakerTitle": "阿尔伯"
				},
				{
					"id": 731850127,
					"content": "只要有吃的，它们就不会乱发脾气了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850128
					],
					"speakerTitle": "阿尔伯"
				},
				{
					"id": 731850128,
					"content": "我之前留意到，有一只驮兽撞开了那些丘丘人，自顾自地跑远…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850129
					],
					"speakerTitle": "阿尔伯"
				},
				{
					"id": 731850129,
					"content": "另外一只好像被那些丘丘人抓住带走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850130
					],
					"speakerTitle": "阿尔伯"
				},
				{
					"id": 731850130,
					"content": "我把那两只驮兽离开的方向大致给你标记一下…这件事就交给你了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850131
					],
					"speakerTitle": "阿尔伯"
				},
				{
					"id": 731850131,
					"content": "只要能把货物找回来，我一定会付给你一笔丰厚报酬的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿尔伯"
				},
				{
					"id": 731850119,
					"content": "我，我担心被撞…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850120
					]
				},
				{
					"id": 731850107,
					"content": "没有人保护你？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850108
					]
				},
				{
					"id": 731850103,
					"content": "小事而已。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850104
					]
				}
			]
		},
		{
