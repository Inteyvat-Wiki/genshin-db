					}
				]
			},
			"dialogs": [
				{
					"id": 731850501,
					"content": "这只驮兽…好像心情不太好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731850502,
					"content": "呜哇，你看它的蹄子，感觉好结实的样子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731850503,
					"content": "要是被踢上一下，一般人应该会直接昏过去吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731850504,
					"content": "派蒙把这些食物送过去吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850505
					]
				},
				{
					"id": 731850505,
					"content": "你，你去啦！快点快点！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850506,
						731850507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731850506,
					"content": "请您慢用…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850508
					]
				},
				{
					"id": 731850507,
					"content": "我无意冒犯您的蹄子…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850516
					]
				},
				{
					"id": 731850510,
					"content": "驮兽缓缓地吞下了食物，蹄子似乎安分了一些…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731850511
					]
				},
				{
					"id": 731850508,
					"content": "它看起来好像没那么生气了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850509
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731850509,
					"content": "我们快把它带回去吧，小心啊！可别被踢到了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850510
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731850511,
					"content": "和驮兽一同回到了阿尔伯身边…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731850512
					]
				},
				{
					"id": 731850512,
					"content": "太好了…我还以为这只驮兽真跑丢了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850513
					],
					"speakerTitle": "阿尔伯"
				},
				{
					"id": 731850513,
					"content": "谢谢你旅行者，真是太谢谢你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850514
					],
					"speakerTitle": "阿尔伯"
				},
				{
					"id": 731850514,
					"content": "我得赶紧检查一下这只驮兽的状况，希望它没有受什么伤…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850515
					],
					"speakerTitle": "阿尔伯"
				},
				{
					"id": 731850515,
