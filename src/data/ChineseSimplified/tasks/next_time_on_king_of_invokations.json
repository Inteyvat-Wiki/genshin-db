			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"福本"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230350301,
					"content": "嘘…那，那是不是赛诺先生？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350302
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350302,
					"content": "看他的装扮，看他的发型，还有那个发色…简直是卡牌游戏小说的最佳主角啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350303,
						230350305
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350303,
					"content": "完全没有道理…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350304
					]
				},
				{
					"id": 230350304,
					"content": "哎呀，你就相信我在小说市场里的直觉吧。但现在不是说这个的时候…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350309
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350309,
					"content": "旅行者，请赛诺先生为我做模特的事…就拜托你了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "福本"
				},
				{
					"id": 230350305,
					"content": "那我还认识蛮多这种主角的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350306
					]
				},
				{
					"id": 230350306,
					"content": "真的吗？那正好啊，我正在筹备《召唤王》的第三部小说，这次我不打算根据「七圣召唤」的玩法写了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350307
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350307,
					"content": "我决定要完全原创一种对战方式，比如…所有卡牌都悬浮在场地里，牌手要一边对战一边不断搜集卡牌，同时还要阻止对手搜集卡牌…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350308
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350308,
					"content": "哈哈哈！光是想想就觉得很有意思！但现在不是说这个的时候…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350309
					],
					"speakerTitle": "福本"
				}
			]
		},
		{
			"id": 2303504,
			"completionStepIds": [
				2303504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2303504",
							"2"
						],
						"stepId": 2303504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"赛诺"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230350401,
					"content": "…唔，这样的卡牌组合也许不错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350402
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 230350402,
					"content": "但这些卡牌，应对快速进攻的能力是不是太弱了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350403
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 230350403,
					"content": "赛诺，你在做什么呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350404
					]
				},
				{
					"id": 230350404,
					"content": "#{NICKNAME}？没想到会在这里遇见你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350405
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 230350405,
					"content": "我正在试着构筑一套进攻速度偏慢的「七圣召唤」卡组呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350406
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 230350406,
					"content": "在我的设想里，使用这套卡牌的牌手会拥有丰富的资源，和各类强大的卡牌…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350407
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 230350407,
					"content": "但说实话，这样的卡组还挺难构筑的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350408
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 230350408,
					"content": "现在「七圣召唤」的玩家群体里，一部分玩家喜欢使用进攻速度偏快的卡组。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350409
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 230350409,
					"content": "在游戏刚开始的时候，就一口气打出大量的卡牌发动攻击，用最快的速度击败对手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350410
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 230350410,
					"content": "不过我却不喜欢这种战术。我喜欢的对决战术，是不断用各种方式积蓄资源…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350411
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 230350411,
					"content": "把握住每一个时机，不断累积优势，稳稳地取得最后的胜利…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350412
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 230350412,
					"content": "没错！就是这样！太好了，太好了！您简直和我小说里的主角一模一样！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350413
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350413,
					"content": "抱歉！呃…我是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350414,
						230350415
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350414,
					"content": "这位是福本。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350416
					]
				},
				{
					"id": 230350415,
					"content": "这位是小说《召唤王》的作者。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350416
					]
				},
				{
					"id": 230350416,
					"content": "您好，大风纪官，那个…我猜您应该没听说过我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350417
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350417,
					"content": "我看过你写的小说，很不错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350418
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 230350418,
					"content": "那真是荣幸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350419
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350419,
					"content": "这部小说最让我印象深刻的是，小说主角每次陷入劣势的时候，总是会通过各种方式取得并不存在于卡组里的卡，然后再克敌制胜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350420
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 230350420,
					"content": "我理解这是情节需要，但这种获胜方式无疑有些背离了「七圣召唤」的游戏本质。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350421
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 230350421,
					"content": "哎呀，这个…我虽然经常玩「七圣召唤」，但玩的水平也并不高…而且，如果真的用竞技思维来写小说里的卡牌对决，那写出来也不会太好看啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350422
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350422,
					"content": "唔，这样吗？那么正好，我刚刚组好了两套卡组，我们可以在这里打几盘「七圣召唤」，你说不定能找到一些灵感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350423,
						230350424
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 230350423,
					"content": "（突然就开始要打牌了…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350425
					]
				},
				{
					"id": 230350424,
					"content": "（这人不会就是单纯想打牌了吧…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350425
					]
				},
				{
					"id": 230350425,
					"content": "欸？和，和您打牌？我十分乐意，但其实…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350426,
						230350427
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350426,
					"content": "我来说吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230350427,
					"content": "关于福本的请求…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230350428,
					"content": "旅行者叙述了福本的请求…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 230350429,
					"content": "要请我做《召唤王》插画的模特？那当然没有问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350430
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 230350430,
					"content": "太好了！旅行者，快，快帮我多拍几张画片！",
					"roleType": "TALK_ROLE_NPC",
