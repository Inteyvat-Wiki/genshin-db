				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"福本"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230350101,
					"content": "唉，好想回稻妻…我怎么会遇见这种事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350102,
						230350103
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350102,
					"content": "你怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350104
					]
				},
				{
					"id": 230350104,
					"content": "旅行者？唉，别提小说了，我觉得那群做「七圣召唤」的人都要撑不住了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350105
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350105,
					"content": "据那个和我关系还可以的学者说，做「七圣召唤」的时候，他们遇见了各种各样堪称莫名其妙的问题…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350106
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350106,
					"content": "比如，一个室罗婆耽学院的学者有一天突然提出了一个问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350107
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350107,
					"content": "他说，卡面上的卡牌效果描述太长，也许会让不习惯阅读长文本的人不想玩「七圣召唤」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350108
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350108,
					"content": "学者们都习惯阅读长文本，对这个问题不敏感。但也许会有玩家不喜欢读长文本，甚至因此不玩「七圣召唤」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350109
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350109,
					"content": "所以他建议，能不能把部分卡牌上的文本字数缩减一半，以方便玩家阅读。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350110,
						230350111
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350110,
					"content": "需，需要这么做吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350112
					]
				},
				{
					"id": 230350112,
					"content": "我是觉得这根本就不是问题…但学者们还在认真研究这个问题。毕竟事关玩家们的体验，他们是一点问题都不想出。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350113
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350113,
					"content": "唉，不说这些了…现在更大的问题是，他们之前承诺帮我找模特这件事也出问题了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350114
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350114,
					"content": "之前我不是和你说过，有一位学者说，他们会帮我联系提纳里先生和赛诺先生，并且拜托这两位当模特吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350115
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350115,
					"content": "但他们忙成这样，我觉得暂时不能指望他们了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350116,
						230350117
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350116,
					"content": "那怎么办？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350118
					]
				},
				{
					"id": 230350118,
					"content": "接待我的那个学者虽然也没法帮我办这件事，但他给我出了一个主意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350119
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350119,
					"content": "他说，赛诺先生有时候会去普斯帕咖啡馆打牌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350120
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350120,
					"content": "如果我愿意的话…可以先去那家咖啡馆碰碰运气。或者，是等他们有空之后再帮我联系。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350121
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350121,
					"content": "那你…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350122
					]
				},
				{
					"id": 230350122,
					"content": "唉，等他们有空的时候，我小说正文都要写完了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350123
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350123,
					"content": "所以，我还是自力更生，看能不能自己找到那位赛诺先生吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350124
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350124,
					"content": "但就算我运气好，在咖啡馆遇见了赛诺先生，又怎么才能和赛诺先生搭上话呢？真是头疼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350128,
						230350129
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350128,
					"content": "我能帮忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350130
					]
				},
				{
					"id": 230350130,
					"content": "真的？！太好了！但你是怎么…呃，算了，我就不问这些问题了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350131
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350131,
					"content": "那事不宜迟，咱们赶紧去普斯帕咖啡馆吧。希望能遇见赛诺先生…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "福本"
				},
				{
					"id": 230350129,
					"content": "我和赛诺很熟啦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350130
					]
				},
				{
					"id": 230350117,
					"content": "那要怎么联系？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350118
					]
				},
				{
					"id": 230350111,
					"content": "其实也长不到哪去吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350112
					]
				},
				{
					"id": 230350103,
					"content": "小说写得不顺利吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350104
					]
				}
			]
		},
		{
			"id": 2303503,
			"completionStepIds": [
				2303503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
