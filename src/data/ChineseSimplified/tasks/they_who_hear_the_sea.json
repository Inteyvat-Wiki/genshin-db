			"dialogs": [
				{
					"id": 790000401,
					"content": "找到啦！宝藏，宝藏，里面会有什么呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790000402,
					"content": "咦？上面怎么有锁。还、还是密码锁…需要密码才能打开吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000403,
						790000404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790000403,
					"content": "这锁应该能直接砸开…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790000405
					]
				},
				{
					"id": 790000405,
					"content": "等一下！直接砸的话，要是里面的东西也被砸坏了怎么办？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790000406,
					"content": "我们还是想想打开锁的方法吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790000410,
					"content": "但既然这个箱子装着的东西是「传家宝」，而且这箱子还是用「密码」的形式锁住的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790000411,
					"content": "那就是说，锁住这个箱子的人认为，自己所留下的「密码」能很容易就被记住…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790000412,
					"content": "看来我们唯一的希望，就只有那些保存着声音的海螺了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790000413,
					"content": "再好好听一下那些海螺里的声音吧，希望那些声音里真的有「密码」的线索…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790000404,
					"content": "要想想开锁的方法。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790000407
					]
				},
				{
					"id": 790000407,
					"content": "不过，周围也没有石碑、壁画、纸条、刻字和笔记本的样子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790000408,
					"content": "而且也没有学者、盗宝团或者冒险家。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790000409
					]
				},
				{
					"id": 790000409,
					"content": "是呢，唔唔，真是前所未有的大考验。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000410
					],
					"speakerTitle": "派蒙"
				}
