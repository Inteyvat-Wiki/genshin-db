			"dialogs": [
				{
					"id": 402260201,
					"content": "娜维娅和克洛琳德在你们的带领下来到展会现场。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402260202
					]
				},
				{
					"id": 402260202,
					"content": "比我想象的大多了，不过人还不多，不够热闹啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260203
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 402260203,
					"content": "应该是因为展会还没有正式开始吧，看来雅珂达那边要帮忙的事还不少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402260204,
					"content": "那这边就交给我和克洛琳德吧，等你们空闲了，也欢迎来体验我们的展品哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "娜维娅"
				}
			]
		}
	]
