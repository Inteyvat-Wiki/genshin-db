			"dialogs": [
				{
					"id": 402260101,
					"content": "旗舰…这个参展方的人应该是在办理住宿吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402260102,
					"content": "搭档！还有派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260103
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 402260103,
					"content": "是娜维娅，好久不见！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260104,
						402260105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402260104,
					"content": "如果我没猜错…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402260106
					]
				},
				{
					"id": 402260106,
					"content": "对啊，刺玫会也是参展方之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260107
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 402260107,
					"content": "哦…那位主宰地下世界的黑道大佬！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402260108,
					"content": "哦…那位主宰地下世界的黑道大佬！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402260109,
					"content": "哈哈，这是对我的新称呼吗？听上去蛮酷的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260110
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 402260110,
					"content": "我们接受了一项委托，具体就是帮忙登记参展人员还有核实参展货物之类的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402260111,
					"content": "是这样啊，坐下聊吧，我正好点了一桌好吃的，克洛琳德和夏沃蕾放完东西也会出来会合。噢！刚说到她们就来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260112
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 402260112,
					"content": "在介绍我们吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260113
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 402260113,
					"content": "克洛琳德和夏沃蕾也来了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402260114,
					"content": "挪德卡莱秩序混乱，十分危险，考虑到刺玫会对于枫丹的意义，我可不希望它的现任会长在这里出事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260115
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 402260115,
					"content": "凭我的身手，我可想象不到自己能出什么事，不过和朋友们一起出来旅行还是很有趣的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260116
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 402260116,
					"content": "我就说你的心态太松弛了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260117
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 402260117,
					"content": "好吧，重新向各位介绍，我现在的保镖是全枫丹最厉害的决斗代理人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260118
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 402260118,
					"content": "黑道大佬和她的保镖…登记好了，夏沃蕾呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402260119,
					"content": "就不用登记我了，我是来处理公务的，最近的很多大案都与挪德卡莱有关。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260120
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 402260120,
					"content": "噢噢，那我就不多问了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402260121,
					"content": "对了，刺玫会用来参展的货物也需要登记一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402260122,
					"content": "就是这个——枫丹科学院新研究出来的一种荒芒中继系统，通过控制它，就可以使用荒芒能量进行战斗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260123
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 402260123,
					"content": "这么说…是一种武器？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402260124,
					"content": "在一个没有法律限制的市场里，武器自然是最抢手的货物之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260125
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 402260125,
					"content": "确实是这个道理，不过这种话当着夏沃蕾的面说，总感觉怪怪的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402260126,
					"content": "无妨，我在犯罪小说里读到过很多有关「法外之地」的描写。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260127
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 402260127,
					"content": "作为一名警探，如果想在这种地方办事，最重要的一点就是暂时放下成规。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260128
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 402260128,
					"content": "那么，我就先告辞了，队员们还在等我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260129
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 402260129,
					"content": "如果接下来方便的话，我们可以带你们去会场。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402260130,
					"content": "好呀，那现在就去吧，我也想看看有没有自己想买的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 402260105,
					"content": "…你们也是来参展的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402260106
					]
				}
			]
		},
