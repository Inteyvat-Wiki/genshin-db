			"trigger": {
				"objectNames": [
					"弗莱琪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413430101,
					"content": "可是霄灯到底怎么做啊…姐姐，你知道吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430102
					],
					"speakerTitle": "杰里"
				},
				{
					"id": 413430102,
					"content": "我不知道啊，唔…能不能拜托人帮我们去做呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430103
					],
					"speakerTitle": "弗莱琪"
				},
				{
					"id": 413430103,
					"content": "你们也想放霄灯吗。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413430104
					]
				},
				{
					"id": 413430104,
					"content": "啊，是旅行者吗。嗯…放霄灯吗，我是挺好奇的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430105
					],
					"speakerTitle": "弗莱琪"
				},
				{
					"id": 413430105,
					"content": "我们本来是打算先去试试海灯节特色小吃的，但杰里说，他还是想要先放盏霄灯，感受一下海灯节的氛围。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430106
					],
					"speakerTitle": "弗莱琪"
				},
				{
					"id": 413430106,
					"content": "是…是这样！要先融入节日的氛围，再尝试节日的美食，这样才能有最全面的感受嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430107
					],
					"speakerTitle": "杰里"
				},
				{
					"id": 413430107,
					"content": "而且我听说放霄灯还可以许愿什么…可是我们俩谁都不知道怎么做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430108
					],
					"speakerTitle": "弗莱琪"
				},
				{
					"id": 413430108,
					"content": "旅行者，能麻烦你帮我们做一盏霄灯吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430109
					],
					"speakerTitle": "弗莱琪"
				},
				{
					"id": 413430109,
					"content": "交给我了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413430110
					]
				},
				{
					"id": 413430110,
					"content": "那就拜托你了，我们就在这等着你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "弗莱琪"
				}
			]
		},
