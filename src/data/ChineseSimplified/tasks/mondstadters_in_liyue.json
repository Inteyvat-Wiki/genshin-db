			},
			"dialogs": [
				{
					"id": 413430701,
					"content": "你好，旅行者，你已经把蒲公英籽播撒出去了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430702
					],
					"speakerTitle": "弗莱琪"
				},
				{
					"id": 413430702,
					"content": "已经播撒出去了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413430703
					]
				},
				{
					"id": 413430703,
					"content": "太好了，希望那些蒲公英能被风带回蒙德城…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430704
					],
					"speakerTitle": "弗莱琪"
				},
				{
					"id": 413430704,
					"content": "不过，说是要融入璃月…结果姐姐你也还是忘不了在蒙德的习惯嘛，不如我们今天去找点蒙德的小吃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430709
					],
					"speakerTitle": "杰里"
				},
				{
					"id": 413430709,
					"content": "那可不行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430710
					],
					"speakerTitle": "弗莱琪"
				},
				{
					"id": 413430710,
					"content": "欸…欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430705
					],
					"speakerTitle": "杰里"
				},
				{
					"id": 413430705,
					"content": "——忘不掉蒙德习俗和融入璃月氛围是两码事嘛，我们赶紧去放飞霄灯吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430706
					],
					"speakerTitle": "弗莱琪"
				},
				{
					"id": 413430706,
					"content": "你写好愿望了吗？等放完霄灯…我们就去尝试海灯节的特色小吃吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430707
					],
					"speakerTitle": "弗莱琪"
				},
				{
					"id": 413430707,
					"content": "写，写是写好了，但还要接着吃吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430708
					],
					"speakerTitle": "杰里"
				},
				{
					"id": 413430708,
					"content": "哼哼，那当然了，璃月海灯节的特色小吃…绝对不能错过！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "弗莱琪"
				}
			]
		}
	]
