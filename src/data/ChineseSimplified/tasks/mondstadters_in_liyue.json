					"弗莱琪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413430501,
					"content": "谢谢你，明明离开蒙德没多久，但我就是想家…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430502
					],
					"speakerTitle": "杰里"
				},
				{
					"id": 413430502,
					"content": "也不知道家里人现在怎么样了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430503
					],
					"speakerTitle": "弗莱琪"
				},
				{
					"id": 413430503,
					"content": "唔，那我们正好趁这个机会…姐姐，你有什么心愿吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430504
					],
					"speakerTitle": "杰里"
				},
				{
					"id": 413430504,
					"content": "我？我想一想啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430505
					],
					"speakerTitle": "弗莱琪"
				},
				{
					"id": 413430505,
					"content": "这样应该就可以了，旅行者，我还有件事想拜托你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430506
					],
					"speakerTitle": "弗莱琪"
				},
				{
					"id": 413430506,
					"content": "蒲公英籽要在高处播撒才好，可是璃月的建筑和蒙德区别好大，而且我和杰里也不知道怎么去高处…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430507
					],
					"speakerTitle": "弗莱琪"
				},
				{
					"id": 413430507,
					"content": "可以请你帮我们去高处播撒这些蒲公英吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430508
					],
					"speakerTitle": "弗莱琪"
				},
				{
					"id": 413430508,
					"content": "交给我了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413430509
					]
				},
				{
					"id": 413430509,
					"content": "那就拜托你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "弗莱琪"
				}
			]
		},
