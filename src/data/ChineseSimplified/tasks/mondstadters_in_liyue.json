					"弗莱琪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413430301,
					"content": "谢谢你，接下来是不是就该把愿望写在霄灯上了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430302
					],
					"speakerTitle": "弗莱琪"
				},
				{
					"id": 413430302,
					"content": "嗯…原来如此，让我想想该写点什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430303
					],
					"speakerTitle": "弗莱琪"
				},
				{
					"id": 413430303,
					"content": "这样应该就可以了。说起来，让霄灯带着愿望飞上天空…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430304
					],
					"speakerTitle": "弗莱琪"
				},
				{
					"id": 413430304,
					"content": "我们在蒙德的时候，也会把心事说给蒲公英听，然后把蒲公英籽撒在风中…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430305
					],
					"speakerTitle": "弗莱琪"
				},
				{
					"id": 413430305,
					"content": "这么一说，我还挺想蒙德的，也好久都没看见蒲公英了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430306
					],
					"speakerTitle": "杰里"
				},
				{
					"id": 413430306,
					"content": "旅行者，能再麻烦你帮我们找些蒲公英籽来吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430307
					],
					"speakerTitle": "弗莱琪"
				},
				{
					"id": 413430307,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413430308
					]
				},
				{
					"id": 413430308,
					"content": "那太好了，谢谢你愿意帮忙。找到蒲公英籽直接拿给我们就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "弗莱琪"
				}
			]
		},
