			"dialogs": [
				{
					"id": 741540201,
					"content": "太不对劲了，太不对劲了，连我都能看出来不对劲了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741540202,
					"content": "#{NICKNAME}，你脑子好，你说接下来怎么办？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540203,
						741540204,
						741540205,
						741540206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741540203,
					"content": "伯努瓦想求救却又说别救他…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540207
					]
				},
				{
					"id": 741540207,
					"content": "那我们再去伯努瓦家附近看看？他家后窗那里不是有一个奇怪的箱子吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741540208,
					"content": "那里面一定藏了什么东西，说不定能证明你的推测。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741540204,
					"content": "这对夫妻可能来自灰河…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540207
					]
				},
				{
					"id": 741540205,
					"content": "看他们的反应，可能另有隐情…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540207
					]
				},
				{
					"id": 741540206,
					"content": "我有一些推测，尽管缺少证据。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540207
					]
				}
			]
		},
