				]
			},
			"dialogs": [
				{
					"id": 741540701,
					"content": "我想按照你们的执着程度，应该不会就这么回去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540702
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741540702,
					"content": "我还以为你们会直接报告执律庭，结果没有，看来你们有些自己的想法啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540703,
						741540704
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741540703,
					"content": "你们为什么要困住伯努瓦？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540705
					]
				},
				{
					"id": 741540705,
					"content": "说实话，我已经有点佩服你们了。如果把这股劲头用对地方，你们可能会成为相当了不起的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540706
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741540706,
					"content": "只可惜，这件事上不行。唉，你们真是不怕死啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540707
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741540707,
					"content": "你吓错人了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540708
					]
				},
				{
					"id": 741540708,
					"content": "哦？是因为完全没有弄清楚自己身处的状况，还是因为自以为在执行正义呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540709
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741540709,
					"content": "说起来刚才那条新闻提到的溺死的商人，他叫布拉德特。嗯，是一个极其能说会道的家伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540710
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741540710,
					"content": "你知道吗？新闻上说他其实不是溺死的，而是被人谋杀之后再沉湖的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540711
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741540711,
					"content": "逐影庭的人调查了半天，只查出来他是被人谋杀的，谋杀他的人罪该万死这样的结果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540712
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741540712,
					"content": "于是新闻报道就也这样写，实际情况到底怎么样，是杀人者更该死，还是他本人更该死呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540713
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741540713,
					"content": "嗯…这是个复杂的问题，我暂时还没有想出答案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540714
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741540714,
					"content": "哦，扯远了，这跟我们要聊的事情没什么关系。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540715
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741540715,
					"content": "你到底想说什么啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540716
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741540716,
					"content": "我想说的是，在没有全然了解一件事之前，就贸然行动是愚蠢的，可能招致恶果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540717,
						741540718
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741540717,
					"content": "对不正义的事无动于衷才愚蠢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540719
					]
				},
				{
					"id": 741540719,
					"content": "哈哈，如果是在不同的场合下相遇，我们说不定能成为朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540720
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741540720,
					"content": "虽然你的想法合我胃口，但我有我要做的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540721
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741540721,
					"content": "这是我最后的耐心了，下一次再让我看到你们在我家附近转悠，我一定会动手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540722
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741540722,
					"content": "阿托斯撂下了一些莫名其妙的话之后，离开了这里。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741540723
					]
				},
				{
					"id": 741540723,
					"content": "他离奇的态度让你觉得意外，你正思索在这件事里，自己究竟该持何种立场…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741540724
					]
				},
				{
					"id": 741540724,
					"content": "后窗传来轻轻的敲击玻璃声，随着极轻的一声「吱呀」，一张纸条被从后窗丢了出来…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741540725
					]
				},
				{
					"id": 741540725,
					"content": "纸条上有褐色的字迹，似乎是在十分仓促的情况下，蘸着咖啡写出来的…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741540726
					]
				},
				{
					"id": 741540726,
					"content": "快看看，上面写了什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540727
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741540727,
					"content": "是伯努瓦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540728
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741540728,
					"content": "嘘。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540729
					]
				},
				{
					"id": 741540729,
					"content": "…对不起，总之我们小心留意猫食盆，等他的讯号吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741540718,
					"content": "面对不正义的事我会积极行动。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540719
					]
				},
				{
					"id": 741540704,
					"content": "伯努瓦到底和你们有什么关系？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540705
					]
				}
			]
		},
		{
			"id": 7415408,
