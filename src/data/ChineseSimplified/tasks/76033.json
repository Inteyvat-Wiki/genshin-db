			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"执着于食物的幽影"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760330301,
					"content": "肉切得足够厚，厚切的同时煎得又很熟，不错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330302
					],
					"speakerTitle": "执着于食物的幽影"
				},
				{
					"id": 760330302,
					"content": "但是我要提醒你一点，做煎肉要注意配菜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330303
					],
					"speakerTitle": "执着于食物的幽影"
				},
				{
					"id": 760330303,
					"content": "本来肉吃多了就容易腻，所以才会放浆果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330304
					],
					"speakerTitle": "执着于食物的幽影"
				},
				{
					"id": 760330304,
					"content": "在岛上，我们负责管理所有人的饮食健康，一定要注意蔬菜和肉食的平衡搭配。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330305
					],
					"speakerTitle": "执着于食物的幽影"
				},
				{
					"id": 760330305,
					"content": "这盘煎肉里的配菜放得太少了，这点很不好，不够周全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330306
					],
					"speakerTitle": "执着于食物的幽影"
				},
				{
					"id": 760330306,
					"content": "你还得练，下次再来做白灵果酿鸡试试吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "执着于食物的幽影"
				}
			]
		},
