			},
			"dialogs": [
				{
					"id": 760330401,
					"content": "鸡肉足够入味，配菜量也放得够多，你这样我很难挑毛病啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330402
					],
					"speakerTitle": "执着于食物的幽影"
				},
				{
					"id": 760330402,
					"content": "算了，本来就不是为了难为人才盯着你们这些新人的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330403
					],
					"speakerTitle": "执着于食物的幽影"
				},
				{
					"id": 760330403,
					"content": "我只是个厨子，做好厨子该做的事就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330404
					],
					"speakerTitle": "执着于食物的幽影"
				},
				{
					"id": 760330404,
					"content": "就算狂猎真的来了，我也做好了准备。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330405
					],
					"speakerTitle": "执着于食物的幽影"
				},
				{
					"id": 760330405,
					"content": "只是可惜，来不及把做好的菜送给他们了…饭菜都洒了…洒了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "执着于食物的幽影"
				}
			]
		}
