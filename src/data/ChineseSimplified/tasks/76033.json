			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"执着于食物的幽影"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760330101,
					"content": "喂，新来的，菜不能这么做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330102
					],
					"speakerTitle": "执着于食物的幽影"
				},
				{
					"id": 760330102,
					"content": "我们做出来的食物要供给岛上执灯士，得以他们的口味为准。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330103
					],
					"speakerTitle": "执着于食物的幽影"
				},
				{
					"id": 760330103,
					"content": "这些菜完全不行，一欠火候，二不符合我们的伙食标准，得改。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330104
					],
					"speakerTitle": "执着于食物的幽影"
				},
				{
					"id": 760330104,
					"content": "你还得练，从我们挪德卡莱的本土菜做起吧，比如挪德卡莱热狗，做好了再拿给我看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "执着于食物的幽影"
				}
			]
		},
		{
			"id": 7603302,
			"completionStepIds": [
				7603304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
