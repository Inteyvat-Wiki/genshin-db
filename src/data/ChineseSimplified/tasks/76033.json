			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"执着于食物的幽影"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760330201,
					"content": "嗯，热狗里的香肠烤得不错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330202
					],
					"speakerTitle": "执着于食物的幽影"
				},
				{
					"id": 760330202,
					"content": "如果你是在外面的餐厅工作，这个水平够你做帮厨了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330203
					],
					"speakerTitle": "执着于食物的幽影"
				},
				{
					"id": 760330203,
					"content": "但是！我们是要为岛上的所有执灯士供餐，重要的不是菜有多精致，重要的是够吃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330204
					],
					"speakerTitle": "执着于食物的幽影"
				},
				{
					"id": 760330204,
					"content": "面包做厚一点，现在的蔬菜种类太少，除了香肠之外，还可以放点别的肉类。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330205
					],
					"speakerTitle": "执着于食物的幽影"
				},
				{
					"id": 760330205,
					"content": "你还得练，下次再来做浆果煎肉试试吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "执着于食物的幽影"
				}
			]
		},
		{
			"id": 7603303,
			"completionStepIds": [
				7603306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7603306",
