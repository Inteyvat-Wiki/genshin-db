			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙",
					"手岛"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040101,
					"content": "让我看看，绫华所说的人在哪里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20040102,
					"content": "您这是干什么，这么多年了，为什么突然要离开啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040103
					],
					"speakerTitle": "真昼"
				},
				{
					"id": 20040103,
					"content": "是啊是啊。我们一点心理准备也没有，突然就听到了这个消息…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040104
					],
					"speakerTitle": "健次郎"
				},
				{
					"id": 20040104,
					"content": "孩子们还盼着您再带他们出去玩呢…拜托您了，请您务必再考虑一下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040105
					],
					"speakerTitle": "健次郎"
				},
				{
					"id": 20040105,
					"content": "那位想必就是绫华所说的人了，我们快过去看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 200402,
			"completionStepIds": [
				200402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200402",
							"2"
						],
						"stepId": 200402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040201,
					"content": "这个似乎就是手岛先生的日志了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20040202,
					"content": "让我看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20040203,
					"content": "「今天和村子里的大家一起做了干烧香鱼，我的手比较笨，不小心把锅烧糊了，只好假装自己做的是干烧黑鱼。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20040204,
					"content": "「今天救了村里落水的小孩，他说自己的好朋友邦布还在水里。我捞了一下午，才知道邦布原来是他养的小螃蟹。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20040205,
					"content": "「今天去放风筝，线突然断了。我追啊追，发现追不到，就找了个地方坐下来，看着它越飘越远。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20040206,
					"content": "唔…好像都是一些日常的小事呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20040207,
					"content": "哦？等等，快看这个！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20040208,
					"content": "「今天又去了附近的神龛祈祷，在那里坐了许久。你送的御守有些褪色了，但依然是我最珍贵的东西…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20040209,
					"content": "感觉是有用的信息呢，我们去神龛那边看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 200403,
			"completionStepIds": [
				200403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200403",
							"2"
						],
						"stepId": 200403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040301,
					"content": "这就是手岛先生说的御守呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20040302,
					"content": "看上去像是女孩子的东西呢，不管是颜色，还是图案…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20040303,
					"content": "如果手岛先生一直拿着它的话，上面或许会残留手岛先生的元素力，能不能靠这个做些什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 200404,
			"completionStepIds": [
				200404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200404",
							"2"
						],
						"stepId": 200404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040401,
					"content": "找到了！这里应该就是手岛先生经常来的地方了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20040402,
					"content": "土壤有被动过的痕迹…难道说手岛先生是在这里埋藏了什么宝贝，才一直留在这里的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20040403,
					"content": "值得手岛先生在这里守了三十年的宝贝，一定很了不起。快点挖出来看看吧~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20040404,
					"content": "这个是…一封信？信纸都已经泛黄了，看上去像是很久之前写的了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20040405,
					"content": "绀田村，好熟悉的名字，是哪里来着？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20040406,
					"content": "就是这里。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040407
					]
				},
				{
					"id": 20040407,
					"content": "欸？所以那位手岛先生，其实是在这里等人吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20040408,
					"content": "但是已经过去三十年了啊，还是没有等到吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20040409,
					"content": "总之，先把这些东西交还给手岛先生吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 200405,
			"completionStepIds": [
				200405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200405",
							"2"
						],
						"stepId": 200405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"手岛",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040501,
					"content": "不错，这日志上确实是我的笔迹，御守与信…应该也是我的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040502
					],
					"speakerTitle": "手岛"
				},
				{
					"id": 20040502,
					"content": "虽然上面所写的东西，我已经忘记了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040503
					],
					"speakerTitle": "手岛"
				},
				{
					"id": 20040503,
					"content": "但是，我应该确确实实地在这里等过一个人，等了三十年。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040504
					],
					"speakerTitle": "手岛"
				},
				{
					"id": 20040504,
					"content": "在这期间，我每天把有趣的事情记录下来，为的是今后重逢的时候，能够把这三十年的岁月一一讲给她听。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040505
					],
					"speakerTitle": "手岛"
				},
				{
					"id": 20040505,
					"content": "期间真是发生了很多事情…时间过的好快，一转眼都这么久了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040506
					],
					"speakerTitle": "手岛"
				},
				{
					"id": 20040506,
					"content": "为什么我会把这么重要的事情忘掉呢？仔细想想，神之眼被夺走后，我感觉自己好像被抽空了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040507
					],
					"speakerTitle": "手岛"
				},
				{
					"id": 20040507,
					"content": "爱也好，遗憾也好，与她有关的一切，全部都消失了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040508
					],
					"speakerTitle": "手岛"
				},
				{
					"id": 20040508,
					"content": "你会难过吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040509
					]
				},
				{
					"id": 20040509,
					"content": "好像，也没那么难过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040510
					],
					"speakerTitle": "手岛"
				},
				{
					"id": 20040510,
					"content": "毕竟我已经忘记她是谁了。她的容貌、她的声音、她和我经历过的事情，我都已经记不清了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040511
					],
					"speakerTitle": "手岛"
				},
				{
					"id": 20040511,
					"content": "就好像她从未出现在我的身边…就好像这些年不过是一场模糊的梦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040513
					],
					"speakerTitle": "手岛"
				},
				{
					"id": 20040513,
					"content": "那你还要离开吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040514
					]
				},
				{
					"id": 20040514,
					"content": "不了吧…都已经等了大半辈子，还是继续等下去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040516
					],
					"speakerTitle": "手岛"
				},
				{
					"id": 20040516,
					"content": "只是，如果等到了她，却连她的名字都叫不出来的话，会不会让她感到难过呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040517
					],
					"speakerTitle": "手岛"
				},
				{
					"id": 20040517,
					"content": "一旦想到这一点，我的心里就确实有些难过了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040518
					],
					"speakerTitle": "手岛"
				},
				{
					"id": 20040518,
					"content": "奇怪，我明明都不记得她，为什么还会有这样的想法？之前也是，总觉得心里空落落的，好像缺了什么一样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040519
					],
					"speakerTitle": "手岛"
				},
				{
					"id": 20040519,
					"content": "不管怎么说，谢谢你们帮我找回了留在这里的理由。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040520
					],
					"speakerTitle": "手岛"
				},
				{
					"id": 20040520,
					"content": "我会继续留在这里等她的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040522
					],
					"speakerTitle": "手岛"
				},
				{
					"id": 20040522,
					"content": "尽管手岛先生说他不怎么难过，但是不知道为什么，我感觉好难过啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040523,
						20040524
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20040523,
					"content": "我也一样…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040525
					]
				},
				{
					"id": 20040525,
					"content": "果然如同绫华和托马先生他们所说…失去神之眼的话，愿望有关的一切也会同时失去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040526
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20040526,
					"content": "这就是手岛先生之前那种状态的原因吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040527
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20040527,
					"content": "至少我们也算帮到了他…吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040528
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20040528,
					"content": "唉…我们去找下一个人吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20040524,
					"content": "失去难过的理由才是更难过的事吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040525
					]
				}
			]
		},
		{
			"id": 200406,
			"completionStepIds": [
				200406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
