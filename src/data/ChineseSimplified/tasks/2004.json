				"objectNames": [
					"派蒙",
					"手岛"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040801,
					"content": "你就是手岛先生吧，为什么突然要从这里离开呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040802
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20040802,
					"content": "我吗？与其说为什么要离开…不如说，我不知道自己为什么要留在这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040803
					],
					"speakerTitle": "手岛"
				},
				{
					"id": 20040803,
					"content": "你在这里生活了很久。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040804
					]
				},
				{
					"id": 20040804,
					"content": "大家也很依赖你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040805
					]
				},
				{
					"id": 20040805,
					"content": "是啊，但这并不是我留下来的理由。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040806
					],
					"speakerTitle": "手岛"
				},
				{
					"id": 20040806,
					"content": "三十年前，我为什么要来这里？三十年来，我又为什么不愿意从这里离开？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040807
					],
					"speakerTitle": "手岛"
				},
				{
					"id": 20040807,
					"content": "这些我都不记得了。自从「神之眼」被夺走后，我好像忘记了很多事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040808
					],
					"speakerTitle": "手岛"
				},
				{
					"id": 20040808,
					"content": "以前的我想留在这里，现在这种执念没了，就觉得出去走走也好。虽然心里还是空落落的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040809
					],
					"speakerTitle": "手岛"
				},
				{
					"id": 20040809,
					"content": "原来是这样…也就是说，我们只要帮你找到留下来的理由，你就不会走了对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040810
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20040810,
					"content": "嗯…不过，连你本人都已经忘了，这可怎么办啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040811
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20040811,
					"content": "要不你再努力回忆一下，看看能不能「咻」地一下想起来？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040812
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20040812,
					"content": "说起来，上次给手岛先生送水果的时候，好像见到手岛先生正在写日志？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040813
					],
					"speakerTitle": "真昼"
				},
				{
					"id": 20040813,
					"content": "我有这样的习惯吗？说实话…我已经不记得了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040814
					],
					"speakerTitle": "手岛"
				},
				{
					"id": 20040814,
					"content": "有的有的！当时手岛先生还说，要把一些有趣的事记下来，之后有重要的用途来着。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040815
					],
					"speakerTitle": "真昼"
				},
				{
					"id": 20040815,
					"content": "太好了！感觉只要找到日志，就可以留住这位手岛先生呢。我们去附近看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040816
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20040816,
					"content": "那就拜托你们了…我们先回村子里，把手岛先生的情况告诉其他人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "真昼"
				}
			]
		},
