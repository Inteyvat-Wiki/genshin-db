				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"健次郎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040701,
					"content": "唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040702
					],
					"speakerTitle": "健次郎"
				},
				{
					"id": 20040702,
					"content": "发生什么事了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040703
					]
				},
				{
					"id": 20040703,
					"content": "要我说，这事说不定跟「眼狩令」有关。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040704
					],
					"speakerTitle": "健次郎"
				},
				{
					"id": 20040704,
					"content": "手岛先生明明什么都没做错，却被收缴了「神之眼」。然后他就像是…变了一个人一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040705
					],
					"speakerTitle": "健次郎"
				},
				{
					"id": 20040705,
					"content": "我说不上来，但感觉他好像失去了什么重要的东西，独自一人绕着村子转了几圈之后，突然就说要出去云游四海。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040706
					],
					"speakerTitle": "健次郎"
				},
				{
					"id": 20040706,
					"content": "我们其实也不知道该不该挽留他，但总觉得…不能让他像这样失魂落魄地离开。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040707
					],
					"speakerTitle": "健次郎"
				},
				{
					"id": 20040707,
					"content": "看来附近的人都很尊敬他呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 200408,
			"completionStepIds": [
				200408
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
