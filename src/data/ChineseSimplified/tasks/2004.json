			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"真昼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040601,
					"content": "你是…你也是来挽留手岛先生的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040602
					],
					"speakerTitle": "真昼"
				},
				{
					"id": 20040602,
					"content": "发生什么事了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040603
					]
				},
				{
					"id": 20040603,
					"content": "手岛先生他啊，自从三十年前来到这里之后，就一直守在这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040604
					],
					"speakerTitle": "真昼"
				},
				{
					"id": 20040604,
					"content": "赶走盗宝团、击退附近的魔物、调解村里的争吵…他为这里付出了许多心血，我们也将他视为最尊敬的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040605
					],
					"speakerTitle": "真昼"
				},
				{
					"id": 20040605,
					"content": "但现在他却突然要离开这里，难道…是我们哪里做错了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040606
					],
					"speakerTitle": "真昼"
				},
				{
					"id": 20040606,
					"content": "如果可以的话，我们愿意向手岛先生道歉，只求手岛先生能继续留在这里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "真昼"
				}
			]
		},
		{
			"id": 200407,
			"completionStepIds": [
				200407
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
