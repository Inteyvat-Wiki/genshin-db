			},
			"dialogs": [
				{
					"id": 750210301,
					"content": "呼——我一个人肯定下不来，谢谢你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210302
					],
					"speakerTitle": "奥尔科"
				},
				{
					"id": 750210302,
					"content": "这个就是天上掉下来的星星吗？这么凑近看的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210303,
						750210306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750210303,
					"content": "啊啊体内涌出了神秘的力量！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210304
					]
				},
				{
					"id": 750210304,
					"content": "欸？！真的吗？不对，不是还没找到失散的碎片吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750210305,
					"content": "话说回来，这里真的有碎片的线索吗？一点头绪也没有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750210308,
					"content": "那我们接下来该怎么办呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750210309,
					"content": "只有靠大力了吧。<color=#00E1FFFF>用嵴锋龙那么大的力气拍拍它</color>说不定就能知道失散的碎片在哪里了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210310
					],
					"speakerTitle": "奥尔科"
				},
				{
					"id": 750210310,
					"content": "#大部分的问题都可以靠蛮力解决，爸爸是这么说的。但我还没有觉醒力量，也没有自己的龙…就拜托{M#哥哥姐姐}{F#姐姐们}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奥尔科"
				},
				{
					"id": 750210306,
					"content": "好怪的石头。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210307
					]
				},
				{
					"id": 750210307,
					"content": "的确很独特…不过是我太迟钝了吗？并没有感受到神秘的力量…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210308
					],
					"speakerTitle": "派蒙"
				}
			]
		},
