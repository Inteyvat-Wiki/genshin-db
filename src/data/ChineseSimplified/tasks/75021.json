			"dialogs": [
				{
					"id": 750210701,
					"content": "哇！好厉害，你们找到全部的星星碎片了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210702
					],
					"speakerTitle": "奥尔科"
				},
				{
					"id": 750210702,
					"content": "我平时给卡卡妈妈帮忙，攒下不少零花钱，这些摩拉全给你们，把星星碎片卖给我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210703
					],
					"speakerTitle": "奥尔科"
				},
				{
					"id": 750210703,
					"content": "星星碎片？你知道它们是做什么用的吗？呃，在这之前，你一个小孩子为什么独自在这种地方呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210704
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750210704,
					"content": "…别人都叫我奥尔科，你们也可以这样叫我。虽然现在的名字不过是个代号罢了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210705
					],
					"speakerTitle": "奥尔科"
				},
				{
					"id": 750210705,
					"content": "我就是为了收集星星碎片才到这里来的，你们也看到下面的大石头了吧，那就是从天上掉下来的星星。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210706
					],
					"speakerTitle": "奥尔科"
				},
				{
					"id": 750210706,
					"content": "#只要把失散的碎片交还给它，就能获得失去的力量…拜托了，{M#哥哥姐姐}{F#姐姐}，我真的很需要这些星星碎片…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210707,
						750210709
					],
					"speakerTitle": "奥尔科"
				},
				{
					"id": 750210707,
					"content": "听起来好可疑…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210708
					]
				},
				{
					"id": 750210708,
					"content": "嗯…不过也算是线索吧，要不就我们一起试试看？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210711
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750210711,
					"content": "话说回来，什么星星碎片、失去的力量…听起来就像是小说里的情节呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210712
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750210712,
					"content": "你们都没听说过奎伊露和乌库库的故事吗？这个就送给你们好了，爸爸给我讲过很多遍，我已经倒背如流了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210713
					],
					"speakerTitle": "奥尔科"
				},
				{
					"id": 750210713,
					"content": "但现在要紧的是，我们先一起下去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210714
					],
					"speakerTitle": "奥尔科"
				},
				{
					"id": 750210714,
					"content": "和奥尔科一起来到「坠落的星星」前…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						750210715
					]
				},
				{
					"id": 750210715,
					"content": "#{M#哥哥}{F#姐姐}，快把失散的碎片放回星星上吧。哇…我会觉醒什么力量呢？说不定能去到天上…嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奥尔科"
				},
				{
					"id": 750210709,
					"content": "还有这种好事？那更不能给你了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210710
					]
				},
				{
					"id": 750210710,
					"content": "对方只是个小孩子而已，不用这么较真吧。而且他说的话也不知道是真是假，不如就我们一起试试看？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210711
					],
					"speakerTitle": "派蒙"
				}
			]
		},
