			"dialogs": [
				{
					"id": 101100101,
					"content": "#{NICKNAME}，看那边看那边！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101100102,
					"content": "她、她是一个人站着的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101100103,
					"content": "可她明明在跟别人说话啊！你看、你看她还笑了！呜呜呜，好吓人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101100104,
					"content": "我小时候也会和「幻想朋友」玩。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100105
					]
				},
				{
					"id": 101100105,
					"content": "#呜哇？{NICKNAME}，你以前也会做这种事吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101100106,
					"content": "难道是出现了幻觉？还是说，真的有那种看不见的朋友在陪你玩？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100107,
						101100109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101100107,
					"content": "幻觉就是幻想朋友。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100108
					]
				},
				{
					"id": 101100108,
					"content": "幻想朋友…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101100111,
					"content": "哦，那就是…「想象出来的朋友」啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101100112,
					"content": "你的「幻想朋友」长什么样子，给我看看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100113,
						101100114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101100113,
					"content": "现在不太出现了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100115
					]
				},
				{
					"id": 101100115,
					"content": "哎？难道「幻想朋友」，在人长大以后就会消失吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100116,
						101100117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101100116,
					"content": "是啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100118
					]
				},
				{
					"id": 101100118,
					"content": "#唔…本来还想见识一下的…对了，你的{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTER]}也有幻想朋友吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101100119,
					"content": "是有的喔。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100120
					]
				},
				{
					"id": 101100120,
					"content": "居然也有！这也太方便了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101100121,
					"content": "你有没有听过一种来自璃月的牌戏？一般是四个人玩，你们两个人就能玩了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101100122,
					"content": "旅行者！真巧啊，你们也在这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100123
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101100123,
					"content": "卖唱的，怎么又是你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101100124,
					"content": "哈哈，是因为丽莎最近做了些有趣的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100125
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101100125,
					"content": "丽莎说的「有趣」，让我感觉怕怕的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101100126,
					"content": "嘿，别这样评价一位淑女嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100127
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101100127,
					"content": "为了做这件有趣的东西，她可是特地从须弥弄来了一批危险材料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100128
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101100128,
					"content": "你刚刚说「危险」了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100129,
						101100131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101100129,
					"content": "这是眼镜型探测仪吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100130
					]
				},
				{
					"id": 101100130,
					"content": "没错，虽然长得像单片眼镜，但它是一台探测仪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100133
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101100133,
					"content": "可惜丽莎自己用不了，所以我就把它借来玩啦，顺便也帮她做做实验。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100134
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101100134,
					"content": "咦？为什么丽莎用不了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101100135,
					"content": "这个嘛…该说是缺了一些自由自在的童心呢？还是因为别的什么原因呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100136
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101100136,
					"content": "下次你们自己问问她就知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100137
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101100137,
					"content": "那么，温迪你能看见的吧？快告诉我，这家伙的幻想朋友长什么样！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100138
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101100138,
					"content": "嗯，这个嘛…保密^_^",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100139
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101100139,
					"content": "总之东西已经给你了，你来试试，看诺拉的「幻想朋友」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100140
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101100140,
					"content": "怎么样怎么样？能看见吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100141,
						101100142
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101100141,
					"content": "真的有！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100143
					]
				},
				{
					"id": 101100143,
					"content": "果然，你戴上这个以后，也能看见…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100144
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101100144,
					"content": "可恶，我也想看！——但这个探测仪的尺寸我没法戴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100145
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101100145,
					"content": "#{NICKNAME}，就靠你了！我们去看看<color=#00E1FFFF>其他人</color>的幻想朋友都长什么样吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101100142,
					"content": "是个和她很合得来的孩子。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100143
					]
				},
				{
					"id": 101100131,
					"content": "长得好像一副单片眼镜。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100132
					]
				},
				{
					"id": 101100132,
					"content": "对吧？我也这么觉得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100133
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101100117,
					"content": "很遗憾，但确实是这样。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100118
					]
				},
				{
					"id": 101100114,
					"content": "已经看不见了呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100115
					]
				},
				{
					"id": 101100109,
					"content": "幻想朋友就是幻觉。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100110
					]
				},
				{
					"id": 101100110,
					"content": "幻觉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100111
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 1011002,
			"completionStepIds": [
				1011002
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1011002",
							"2"
						],
						"stepId": 1011002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"芙萝拉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101100203,
					"content": "你看，那就是她的幻想朋友。嗯，一株轻飘飘的植物…是蓬蓬果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100204
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101100204,
					"content": "幻想朋友也可以是植物吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101100205,
					"content": "呼呼，旅行者，诗人，你们好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100206,
						101100207
					],
					"speakerTitle": "芙萝拉"
				},
				{
					"id": 101100206,
					"content": "你好，可以问你一些事吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100208
					]
				},
				{
					"id": 101100208,
					"content": "好啊，找芙萝拉有什么事呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100209,
						101100212
					],
					"speakerTitle": "芙萝拉"
				},
				{
					"id": 101100209,
					"content": "你身边那个是…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100210
					]
				},
				{
					"id": 101100210,
					"content": "咦？你能看到蓬蓬？别人都看不到蓬蓬的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100211
					],
					"speakerTitle": "芙萝拉"
				},
				{
					"id": 101100211,
					"content": "蓬蓬是我最好的朋友了，我们从小一起长大的哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100216
					],
					"speakerTitle": "芙萝拉"
				},
				{
					"id": 101100216,
					"content": "（呃…这种只有我被排除在外的感觉…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101100217,
					"content": "芙萝拉，为什么你的朋友会是一株蓬蓬果呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100218
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101100218,
					"content": "为什么不可以呢？我一直很想跟会飞的植物做朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100219
					],
					"speakerTitle": "芙萝拉"
				},
				{
					"id": 101100219,
					"content": "会飞的植物？朋友？为什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100220
					],
					"speakerTitle": "派蒙"
				},
