				"points": []
			},
			"dialogs": [
				{
					"id": 190602901,
					"content": "旅行者，我相信你一定能查出真相，绝对是鹿野院在搞鬼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190602902
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 190602902,
					"content": "唉…明明社长和平藏先生都是很好的人，怎么碰到一起就要坏事呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190602903
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 190602903,
					"content": "龙二，麻烦你成熟一点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚"
				}
			]
		},
