			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"上杉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190603001,
					"content": "嗨，旅行者，查案很头痛吧，你们听我的准没错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603002
					],
					"speakerTitle": "上杉"
				},
				{
					"id": 190603002,
					"content": "关于珊瑚社长…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190603003
					]
				},
				{
					"id": 190603003,
					"content": "哎呀！你说这个珊瑚社长，鹰司家真是请了个了不起的侦探啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603004
					],
					"speakerTitle": "上杉"
				},
				{
					"id": 190603004,
					"content": "隔三差五她就跑来提交申请，要重查「龙二案」，但每次都被平藏前辈挡了回去，没想到这次居然去写投诉信了，真厉害。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603005
					],
					"speakerTitle": "上杉"
				},
				{
					"id": 190603005,
					"content": "至于平藏前辈为什么不让，大概是怕珊瑚社长遇到危险吧，毕竟这是个大人物的命案，水很深呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603006
					],
					"speakerTitle": "上杉"
				},
				{
					"id": 190603006,
					"content": "珊瑚虽然是侦探社的社长，但说到底也只是个普通人啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603007
					],
					"speakerTitle": "上杉"
				},
				{
					"id": 190603007,
					"content": "他们关系很好吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190603008
					]
				},
				{
					"id": 190603008,
					"content": "唔…不算好，我看他们每次见面讲话都夹枪带棒的。不过平藏前辈应该还是念及旧情吧，听说他以前和珊瑚一起工作的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603009
					],
					"speakerTitle": "上杉"
				},
				{
					"id": 190603009,
					"content": "他有时会吩咐我，把一些无关紧要的案件交给侦探社去做，我猜是想让他们多点收入。",
					"roleType": "TALK_ROLE_NPC",
