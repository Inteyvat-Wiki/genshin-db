			"dialogs": [
				{
					"id": 210080401,
					"content": "归离原的道路？$UNRELEASED",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210080402
					]
				},
				{
					"id": 210080402,
					"content": "归璃原是岩层平原，所以有些地方山路崎岖，比如西边的瞭望坡。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080403
					],
					"speakerTitle": "星火"
				},
				{
					"id": 210080403,
					"content": "但是东边靠海口的位置却很平坦，有空去瑶光滩看看也不错呢。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "星火"
				}
			]
		},
		{
			"id": 2100805,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"星火"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210080501,
					"content": "你的同伴呢？$UNRELEASED",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210080502
					]
				},
				{
					"id": 210080502,
					"content": "事情是这样的。同伴负责给火盆加燃料，我负责点火。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080503
					],
					"speakerTitle": "星火"
				},
				{
					"id": 210080503,
					"content": "虽然听起来很琐碎，但明确的分工是最重要的！$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "星火"
				}
			]
		},
