			},
			"dialogs": [
				{
					"id": 740680301,
					"content": "#好了，{NICKNAME}，其实就是这里了…这就是我们觉得需要讨论的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680302
					],
					"speakerTitle": "梅亚"
				},
				{
					"id": 740680302,
					"content": "按照剧情呢，这里其实就有两个方向，一个是女主角朱莉叶特放弃了复仇，拿剩余的宝藏环游世界，逍遥快活。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680303
					],
					"speakerTitle": "梅亚"
				},
				{
					"id": 740680303,
					"content": "还有一个走向呢，是朱莉叶特完成了复仇，但是果然内心空虚，将钱财捐助散尽之后，自己在与未婚夫相遇之处孤独终老。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680304
					],
					"speakerTitle": "梅亚"
				},
				{
					"id": 740680304,
					"content": "怎么样，作为观众的话你会喜欢哪一种结局呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680305,
						740680312
					],
					"speakerTitle": "梅亚"
				},
				{
					"id": 740680305,
					"content": "放弃复仇也是一种解脱…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740680306
					]
				},
				{
					"id": 740680306,
					"content": "欸，真的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680307
					],
					"speakerTitle": "梅亚"
				},
				{
					"id": 740680307,
					"content": "你看，我说什么来着，观众是能够理解的。因为杰罗姆作为一个复仇成功但并未获得幸福的例子就在眼前。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680308
					],
					"speakerTitle": "富尔蒙"
				},
				{
					"id": 740680308,
					"content": "「把仇人解决掉，自己就能够获得幸福」这种想法对当事人来说不能算错。但幸福需要创造，无法以复仇这一毁灭的方式得到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680309
					],
					"speakerTitle": "富尔蒙"
				},
				{
					"id": 740680309,
					"content": "复仇是没有办法获得幸福的，只能获得带有罪恶的快感，但在这种快感消失，找不到其他的方向的话，就会变得相当空虚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680310
					],
					"speakerTitle": "富尔蒙"
				},
				{
					"id": 740680310,
					"content": "要在复仇的同时，找到复仇之外的救赎之道，这点很重要！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680311
					],
					"speakerTitle": "富尔蒙"
				},
				{
					"id": 740680311,
					"content": "唔…这么说倒是也有道理啦，虽然还是有点不服气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680318
					],
					"speakerTitle": "梅亚"
				},
				{
					"id": 740680318,
					"content": "#哎…多谢{NICKNAME}，你的建议非常关键！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680319
					],
					"speakerTitle": "梅亚"
				},
				{
					"id": 740680319,
					"content": "嗯，确实，而且经过这样的讨论，感觉最后的结局也有调整的空间，要是能表达出来就好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680320
					],
					"speakerTitle": "富尔蒙"
				},
				{
					"id": 740680320,
					"content": "#嘿嘿，等正式公演的时候，{NICKNAME}一定要来看啊，到时候一定会有个超乎你想象的结局的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680321,
						740680322
					],
					"speakerTitle": "梅亚"
				},
				{
					"id": 740680321,
					"content": "真、真的吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740680323
					]
				},
				{
					"id": 740680323,
					"content": "哈哈…因为没改出来，所以我也不知道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680324
					],
					"speakerTitle": "梅亚"
				},
				{
					"id": 740680324,
					"content": "#那就别这样跟{NICKNAME}说啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680325
					],
					"speakerTitle": "富尔蒙"
				},
				{
					"id": 740680325,
					"content": "#这也是一种宣传嘛，对了对了，{NICKNAME}，感谢你的建议，这些就送给你了，要常来玩哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "梅亚"
				},
				{
					"id": 740680322,
					"content": "是褒义的超乎想象吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740680323
					]
				},
				{
					"id": 740680312,
					"content": "当然是要先完成复仇！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740680313
					]
				},
				{
					"id": 740680313,
					"content": "#你看，你看，{NICKNAME}和我的想法一致。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680314
					],
					"speakerTitle": "梅亚"
				},
				{
					"id": 740680314,
					"content": "杰罗姆作为整个剧情渲染的复仇的「节点」，如果不能好好地完成复仇，就会给人一种没有达成「节点」的不满足感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680315
					],
					"speakerTitle": "梅亚"
				},
				{
					"id": 740680315,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680316
					],
					"speakerTitle": "富尔蒙"
				},
				{
					"id": 740680316,
					"content": "让角色通过敌人的现状假想复仇后的痛苦与空虚，和角色真的复仇完成后再去感受痛苦与空虚，对观众的说服力也有差别！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680317
					],
					"speakerTitle": "梅亚"
				},
				{
					"id": 740680317,
					"content": "说的也是啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680318
					],
					"speakerTitle": "富尔蒙"
				}
			]
		}
	]
