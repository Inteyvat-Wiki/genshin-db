			"dialogs": [
				{
					"id": 401960101,
					"content": "几位好！我们没来晚吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401960102,
					"content": "不，刚刚好。休息得如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960103
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 401960103,
					"content": "忙碌使人精神焕发。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960104
					]
				},
				{
					"id": 401960104,
					"content": "的确是保持活力的好方法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960105
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 401960105,
					"content": "各位已经在着手准备了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960106
					]
				},
				{
					"id": 401960106,
					"content": "昨天从阿让托先生处得到消息，确定了交易的时间与地点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960107
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 401960107,
					"content": "说起来，是大家都知道的地方呢。「今日下午，映影欢乐城餐厅见。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960108
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 401960108,
					"content": "欸？他还真是对那个地方情有独钟呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401960109,
					"content": "这…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960110
					]
				},
				{
					"id": 401960110,
					"content": "#看来{NICKNAME}和我们产生了同样的担忧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960111
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 401960111,
					"content": "是的，比起空旷的地段，人流量高的活动场地会给抓捕行动造成额外的困难。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960112
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 401960112,
					"content": "犯人可能会混入人群，甚至利用人质逃脱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960113
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 401960113,
					"content": "为此我们需要做更多的提前准备，所以从昨天接到消息起，这边就已经开始安排逐影庭与特巡队的工作了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960114
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 401960114,
					"content": "嗯，现场会安插很多便衣人员。如果事情进展不顺，我们会优先保障市民的人身安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960115
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 401960115,
					"content": "当然，还是祝我们一切顺利比较好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960116
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 401960116,
					"content": "参与人员中有不少我在上起案件中见过的熟悉面孔，比如特巡队队长夏沃蕾小姐。所以，我持乐观态度哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960117
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 401960117,
					"content": "那就借纳塔的大英雄吉言了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960118
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 401960118,
					"content": "哦，乐平波琳小姐和娜维娅小姐那边，我们也都进行了沟通与安排。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960119
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 401960119,
					"content": "刺玫会会在可控范围内进行支援，不必担心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960120
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 401960120,
					"content": "唯一的问题…可能就是爱可菲小姐那边吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960121,
						401960123
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 401960121,
					"content": "她不想接待犯过罪的顾客吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960122
					]
				},
				{
					"id": 401960123,
					"content": "她想给犯罪分子喂叉子吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960124
					]
				},
				{
					"id": 401960122,
					"content": "哈哈，要是这样反而简单了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960125
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 401960124,
					"content": "哦，你别说，是个不错的思路…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960125
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 401960125,
					"content": "咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960126
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 401960126,
					"content": "不开玩笑了。爱可菲小姐提出，希望自己的餐厅不要因为本次行动蒙受任何损失。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960127
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 401960127,
					"content": "哈哈…我有种预感，肯定不会如愿的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960128
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 401960128,
					"content": "需要我做些什么吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960129
					]
				},
				{
					"id": 401960129,
					"content": "说实话，这件事本就与你无关，发展到这一步已经给你添了很多麻烦。剩下的应该全权交由枫丹官方处理即可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960130
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 401960130,
					"content": "不过我猜，你应该也想知道事件的结局吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960131
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 401960131,
					"content": "请务必。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960132
					]
				},
				{
					"id": 401960132,
					"content": "嗯，那就请你在现场见机行事吧。不一定需要你出手，只是以防万一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960133
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 401960133,
					"content": "我会尽量不让事情发展到那一步的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960134
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 401960134,
					"content": "基尼奇也要加入？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960135
					]
				},
				{
					"id": 401960135,
					"content": "当然。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960136
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 401960136,
					"content": "虽然我心中还有很多疑问，但从已有信息来看，犯人来自纳塔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960137
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 401960137,
					"content": "再说，我也算是证人之一，不能放任不管。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960138
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 401960138,
					"content": "很有基尼奇的风范呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401960139,
					"content": "众人又就行动细节和注意事项进行了一些讨论。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401960140
					]
				},
				{
					"id": 401960142,
					"content": "那么，闲话就说到这里吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960143
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 401960143,
					"content": "行动时间选在下午。只要动作够快，出发前还能喝几杯茶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960144
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 401960144,
					"content": "#对哦，{NICKNAME}，我们也去吃点东西吧？吃饱肚子才有力气干活嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960145
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401960145,
					"content": "派蒙就只是看着吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960146
					]
				},
				{
					"id": 401960146,
					"content": "陪伴也很重要哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960147
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401960147,
					"content": "那我就先一步去会场了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960148
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 401960148,
					"content": "阿乔这几天一直吵着要吃活动限定的套餐，还是尽快满足它吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960149
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 401960149,
					"content": "那么一会儿见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960150
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 401960150,
					"content": "嗯，等各位的好消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "那维莱特"
				}
			]
		},
