			"dialogs": [
				{
					"id": 401960301,
					"content": "#喔，{NICKNAME}，基尼奇，你们回来啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401960302,
					"content": "刚刚看夏沃蕾带着犯人离开了，好像心情不错的样子呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960303,
						401960304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401960303,
					"content": "比预想的顺利。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960305
					]
				},
				{
					"id": 401960305,
					"content": "嘿嘿，让我们绕了好大的圈子，结果也只是一个没什么战斗力，只会逃跑的家伙嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401960306,
					"content": "哦对了，莱欧斯利让我告诉你们，他已经去沫芒宫汇报结果了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401960307,
					"content": "他说接下来，逐影庭将深入调查灰色赌博产业，有得忙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401960308,
					"content": "但无论如何，那些都是沫芒宫的工作，和我们关系不大啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401960309,
					"content": "我看这位公爵大人跑得这么快，是为了躲避记者的镜头吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960310
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 401960310,
					"content": "哎，不过也习惯了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960311
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 401960311,
					"content": "竟然这么轻易地放弃了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401960312,
					"content": "哼哼，反正刚刚已经拍到了超多精彩瞬间，足够我出一篇头条新闻了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960313
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 401960313,
					"content": "所以说，由于公务缠身，忙碌的记者先行告退，回去冲洗画片啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960314
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 401960314,
					"content": "要给派蒙选最帅的角度哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401960315,
					"content": "啊，跑得好快，希望她听到了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401960316,
					"content": "相信专业摄影师的审美吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960317
					]
				},
				{
					"id": 401960317,
					"content": "嘿嘿，也是哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401960318,
					"content": "不过刚刚你们怎么花了这么久才过来，是遇到什么问题了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960319,
						401960324
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401960319,
					"content": "阿乔撞到了头，在哭鼻子。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960320
					]
				},
				{
					"id": 401960320,
					"content": "什么？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960321
					],
					"speakerTitle": "阿乔"
				},
				{
					"id": 401960321,
					"content": "你这家伙，怎么张嘴就来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960322
					],
					"speakerTitle": "阿乔"
				},
				{
					"id": 401960322,
					"content": "我伟大圣龙，「库胡勒阿乔」，何时有过此等丑态！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960323
					],
					"speakerTitle": "阿乔"
				},
				{
					"id": 401960323,
					"content": "还少吗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960329
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 401960329,
					"content": "接下来有什么打算？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960330
					]
				},
				{
					"id": 401960330,
					"content": "嗯…说实话，还没想好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960331
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 401960331,
					"content": "也没什么急事，搞不好审判庭还要再叫我去作证。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960332
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 401960332,
					"content": "至于那把来自纳塔的枪，作为关键物证，可能也得等案件审理完成后再带回纳塔了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960333
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 401960333,
					"content": "总之，就让我再享受一阵沙滩与大海吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 401960324,
					"content": "基尼奇磕到了头，在哭鼻子。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960325
					]
				},
				{
					"id": 401960325,
					"content": "你说是就是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960326
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 401960326,
					"content": "啊哈哈哈哈哈，小小基尼奇，没人给他摸摸头，只好自己哭鼻子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960327
					],
					"speakerTitle": "阿乔"
				},
				{
					"id": 401960327,
					"content": "真的假的？总觉得阿乔哭鼻子倒是更有可能…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960328
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401960328,
					"content": "喂——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960329
					],
					"speakerTitle": "阿乔"
				},
				{
					"id": 401960304,
					"content": "敌人很弱欸。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960305
					]
				}
			]
		}
	]
}