			]
		},
		{
			"id": 1201705,
			"completionStepIds": [
				1201705
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201705",
							"2"
						],
						"stepId": 1201705,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"影"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120170501,
					"content": "拍好啦，你看，这就是刚刚为你拍出来的画片。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120170502,
					"content": "这…好神奇。是某种法术吗？这里面的…是又复制出了一个我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170503
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170503,
					"content": "可她又似乎不会动，不会说话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170504,
						120170505
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170504,
					"content": "这只是一种记录。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170506
					]
				},
				{
					"id": 120170506,
					"content": "刚刚还觉得拍得不好看，身体有点僵硬，可是现在看上去，比我想象中自然多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170507
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170507,
					"content": "动作一模一样，后面的风景也一模一样…这是怎么做到的呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170508
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170508,
					"content": "这就是它厉害的地方啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170509
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120170509,
					"content": "等等，我还是不太能理解其中原理，多解释一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170510
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170510,
					"content": "就是说，这个里面的，不是我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170511
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170511,
					"content": "如果不是我，那么为什么可以和我一模一样。如果是我，那么现在的我是什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170512
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170512,
					"content": "#这…超出我的解答能力了，交给你，{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170513
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120170513,
					"content": "可能就像将军与你的区别吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170514
					]
				},
				{
					"id": 120170514,
					"content": "对哦，你觉得将军算不算是你呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170515
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120170515,
					"content": "那当然算，我从来都没有把稻妻交给别人管理的意愿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170516
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170516,
					"content": "那现在的你是什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170517
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120170517,
					"content": "这么说的话，我也是我，这是无需置疑的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170518
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170518,
					"content": "「你」的存在不一定是单一的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170519
					]
				},
				{
					"id": 120170519,
					"content": "「我」的存在…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170520
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170520,
					"content": "我好像明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170521
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170521,
					"content": "我就是我，仅有一个，但可能有无数种存在的形式。我以什么形式存在，其实并不重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170522
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170522,
					"content": "比如将军，就是我的某一种存在形式，她究竟是不是我，这个问题绝不会被她身上的某个零件决定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170523
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170523,
					"content": "这么说的话，这个画片也是你的一种存在形式啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170524
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120170524,
					"content": "嗯，就连追求「永恒」的我，存在形式都在不断变化…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170525
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170525,
					"content": "那我怎么能要求稻妻，还有生活在稻妻的每个人，都保持不变呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170526,
						120170527
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170526,
					"content": "稻妻的本质没那么容易改变。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170528
					]
				},
				{
					"id": 120170528,
					"content": "和你们这一路走下来，见识到的全是我认知之外的内容。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170529
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170529,
					"content": "唉，让你们见识到我笨拙的一面了。你们可能感受不到，这些东西的确冲击了我的认知。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170530
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170530,
					"content": "如果用这些东西来定义，那如今的稻妻已经与我的印象大相径庭了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170531
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170531,
					"content": "但是，绝不能因此就说，现在的稻妻已经不是稻妻了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170532
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170532,
					"content": "没错。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170533
					]
				},
				{
					"id": 120170533,
					"content": "眼狩令，千手百眼神像，这些都是为了催生「永恒」，但如果我离「永恒」真的越来越近的话，一切的故事都不会发生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170534
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170534,
					"content": "哈啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170535
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170535,
					"content": "我是否…将一切都抓得太紧了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170536
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170536,
					"content": "看来影是想通了呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170537
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120170537,
					"content": "那我觉得，我们这一段导游做得非常有价值！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170538
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120170538,
					"content": "二少爷，二少爷！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170539
					],
					"speakerTitle": "一平"
				},
				{
					"id": 120170539,
					"content": "咦，为什么下面那么吵？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170540
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120170540,
					"content": "好像是一平，他怎么了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170541
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120170541,
					"content": "那是天领奉行的人吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170542
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170542,
					"content": "对，我们去问问看发生了什么吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120170527,
					"content": "人类的本质没那么容易改变。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170528
					]
				},
				{
					"id": 120170505,
					"content": "这并不是真正的你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170506
					]
				}
			]
		},
		{
			"id": 1201707,
			"completionStepIds": [
				1201707
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201707",
							"2"
						],
						"stepId": 1201707,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"一平"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120170701,
					"content": "一平，发生什么事了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170702
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120170702,
					"content": "啊，是你们，我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170703
					],
					"speakerTitle": "一平"
				},
				{
					"id": 120170703,
					"content": "欸？将、将军大人？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170704
					],
					"speakerTitle": "一平"
				},
				{
					"id": 120170704,
					"content": "您是要见九条镰治少爷吗？抱歉，他现在还没有回来。如果方便的话，可以由小人代为传达吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170705
					],
					"speakerTitle": "一平"
				},
				{
					"id": 120170705,
					"content": "不必多礼，并不是专程来访，只是听到了你呼喊的声音。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170706
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170706,
					"content": "你在找你家的二少爷吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170707
					]
				},
				{
					"id": 120170707,
					"content": "是的，不瞒你说，二少爷他去谈判迟迟没有回来，我很担心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170708
					],
					"speakerTitle": "一平"
				},
				{
					"id": 120170708,
					"content": "他平时有在外面闲逛不回来的习惯，可能只是在什么地方入迷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170709
					],
					"speakerTitle": "一平"
				},
				{
					"id": 120170709,
					"content": "但不知道为什么，今天我特别不安。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170710
					],
					"speakerTitle": "一平"
				},
				{
					"id": 120170710,
					"content": "九条镰治，听起来像是九条家的后人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170711
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170711,
					"content": "是的，实在抱歉。由于家主身体抱恙，大少爷常年在外，现在九条家是由九条镰治少爷作为九条家的名代。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170712
					],
					"speakerTitle": "一平"
				},
				{
					"id": 120170712,
					"content": "天领奉行陷入混乱，这我也略有耳闻。这件事和九条镰治有关吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170713
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170713,
					"content": "抱歉，将军大人，这也是九条家的失职。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170714
					],
					"speakerTitle": "一平"
				},
				{
					"id": 120170714,
					"content": "由于九条家名誉大损、势力衰微，将军您…呃，天领奉行后续的安排，将军您又并未给出决策…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170715
					],
					"speakerTitle": "一平"
				},
				{
					"id": 120170715,
					"content": "所以二少爷才前去商量，是否能请到「鹰司家」主持大局…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170716
					],
					"speakerTitle": "一平"
				},
				{
					"id": 120170716,
					"content": "那应该是在奉行所谈吧，为什么要到这里来找呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170717
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120170717,
					"content": "啊，不是的，这次会面的地点比较特殊。其实我也有点疑惑，但大人物的事，我也不敢多问。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170718
					],
					"speakerTitle": "一平"
				},
				{
					"id": 120170718,
					"content": "地点在鸣神大社附近的山上，那里好像有「鹰司家」的特殊营地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170719
					],
					"speakerTitle": "一平"
				},
				{
					"id": 120170719,
					"content": "「鹰司」…也是熟悉的名字，这么多年，他们应该都在忠心辅佐九条吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170720
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170720,
					"content": "是的是的，就是因为这样，二少爷才会去谈判。可无论有多少事需要谈，这花费的时间也太多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170721
					],
					"speakerTitle": "一平"
				},
				{
					"id": 120170721,
					"content": "城里我都找了个遍，如果他还没回来的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170722,
						120170723
					],
					"speakerTitle": "一平"
				},
				{
					"id": 120170722,
					"content": "还没有结束吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170724
					]
				},
				{
					"id": 120170724,
					"content": "是啊，我也想到了这种可能…但以我的身份，可不能冒冒失失地独闯「鹰司家」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170725
					],
					"speakerTitle": "一平"
				},
				{
					"id": 120170725,
					"content": "我们去帮你看看吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170726
					]
				},
				{
					"id": 120170726,
					"content": "不用不用，应该只是我多心了。要是打扰了谈判，我反而没法交代。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170727
					],
					"speakerTitle": "一平"
				},
				{
					"id": 120170727,
					"content": "虽然我只是二少爷的小跟班，但其实我从小就跟他一起长大，我只是…很怕他出事而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170728
					],
					"speakerTitle": "一平"
				},
				{
					"id": 120170728,
					"content": "我不如二少爷聪明伶俐，也没办法帮二少爷分担太多压力，但我不想因为我的失职而让二少爷遭遇危险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170729
					],
					"speakerTitle": "一平"
				},
				{
					"id": 120170729,
					"content": "唔，将军大人怎么看？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170730
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120170730,
					"content": "我们亲自走一趟吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170731
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170731,
					"content": "以我的身份，就算妨碍了谈判，应该也不会影响到你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170732
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170732,
					"content": "而且，本就是我未能及时决策的缘故，应该由我来出面解决。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170733,
						120170734
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170733,
					"content": "很有担当。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170735
					]
				},
				{
					"id": 120170735,
					"content": "感激不尽，感谢将军大人能出手相助！我也会再去其他地方找找看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170736
					],
					"speakerTitle": "一平"
				},
				{
					"id": 120170736,
					"content": "那我现在就把那个营地的位置为你们标记出来，希望一路顺利！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "一平"
				},
				{
					"id": 120170734,
					"content": "很帅气。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170735
					]
				},
				{
					"id": 120170723,
					"content": "可能遇到突发情况了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170724
					]
				}
			]
		},
