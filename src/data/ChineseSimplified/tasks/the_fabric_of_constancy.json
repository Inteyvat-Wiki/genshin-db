			},
			"dialogs": [
				{
					"id": 120170201,
					"content": "所以，现在我们要干什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170202
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170202,
					"content": "为你留下画片，具体操作交给我们，你只需要在那边站好，摆好姿势就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120170203,
					"content": "简单来说，画片可以把此时此刻的你记录下来，很适合作为纪念。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120170204,
					"content": "那摆姿势又是怎么一回事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170205
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170205,
					"content": "要记录的是画面。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170206
					]
				},
				{
					"id": 120170206,
					"content": "原来如此，也就是说，要对着你们摆出一个好看的动作，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170207
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170207,
					"content": "仔细想想，有点难为情啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170208
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170208,
					"content": "要怎么做才好呢？帮我出出主意吧，好看一点，但不要太夸张，我觉得我会放不开。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170209,
						120170211,
						120170213
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170209,
					"content": "摆一个端庄的姿势吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170210
					]
				},
				{
					"id": 120170210,
					"content": "那…就这样吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170215,
						120170216
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170215,
					"content": "就这样吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170218
					]
				},
				{
					"id": 120170218,
					"content": "好，那就开始吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170219
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170219,
					"content": "我们挑一个好的角度，为她记录吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120170216,
					"content": "或许可以再试试其他的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170217
					]
				},
				{
					"id": 120170217,
					"content": "好吧，这里就交给你来决定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170208
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170211,
					"content": "摆一个严肃的姿势吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170212
					]
				},
				{
					"id": 120170212,
					"content": "不太习惯，这样可以吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170215,
						120170216
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170213,
					"content": "摆一个随意的姿势吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170214
					]
				},
				{
					"id": 120170214,
					"content": "随意的话，这样吧，挺自在的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170215,
						120170216
					],
					"speakerTitle": "影"
				}
			]
		},
		{
			"id": 1201704,
