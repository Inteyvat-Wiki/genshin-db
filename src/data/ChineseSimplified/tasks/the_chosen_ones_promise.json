			"dialogs": [
				{
					"id": 751380101,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}，你没事吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751380102,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380103
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751380103,
					"content": "#真是太好了，{NICKNAME}在那个…呃，好难解释，总之就是{M#他}{F#她}在梦里看到你和奇怪的人在一起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751380104,
					"content": "你在天蛇船上有遇到什么奇怪的人吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751380105,
					"content": "呀…呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380106
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751380106,
					"content": "欸？那到底是有还是没有啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751380107,
					"content": "呜…呀！呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380108
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751380108,
					"content": "哇，完全搞不懂你想说什么啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751380109,
					"content": "#既然{REALNAME[ID(2)|SHOWHOST(true)]}没事就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751380110
					]
				},
				{
					"id": 751380110,
					"content": "是哦，不过玻娜呢，玻娜去哪啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751380111,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380112
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751380112,
					"content": "难道你们走散了吗？还是说玻娜她真的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751380113,
					"content": "或许玻娜只是故事中的角色。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751380114
					]
				},
				{
					"id": 751380114,
					"content": "嗯…你说的也是呢，普通人是没办法活几百年的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751380115,
					"content": "但至少我们完成了她未完的冒险。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751380116
					]
				},
				{
					"id": 751380116,
					"content": "是哦，我们也答应了她，要好好宣传这段冒险经历。等大伙都知道我们找到了天蛇船，玻娜也会成为大名鼎鼎的冒险家吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751380117,
					"content": "接下来就该…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751380118
					]
				},
				{
					"id": 751380118,
					"content": "接下来就该去火山找「那个人」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751380119
					]
				},
				{
					"id": 751380119,
					"content": "把事情弄清楚了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751380120,
					"content": "这样说来，那个家伙该不会就是「盗火贤者」吧？一路上都是他留下来的讯息，我是越来越好奇了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751380121,
					"content": "而且那家伙还说自己会假扮成不同的身份，就算遇到了我们也不一定能认得出来吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751380122,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380123
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751380123,
					"content": "#果然你也很好奇吧，{REALNAME[ID(2)|SHOWHOST(true)]}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751380124,
					"content": "#既然信物也已经找齐了，接下来我们就和{REALNAME[ID(2)|SHOWHOST(true)]}一起去火山吧，解开所有的秘密，然后帮{REALNAME[ID(2)|SHOWHOST(true)]}解除诅咒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751380125,
					"content": "对不起喔，玻娜，「通牒金盘」我们要先带走咯。等到我们把所有事情都搞清楚之后，再把一切告诉你吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
