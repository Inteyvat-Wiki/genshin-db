				"points": []
			},
			"dialogs": [
				{
					"id": 10210801,
					"content": "多谢阁下出手相救，否则我就要烂在牢里了！那些盗宝团，心情好就修剪一下那几盆甜甜花，心情不好就修理一下我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210802
					],
					"speakerTitle": "孟丹"
				},
				{
					"id": 10210802,
					"content": "小事一桩~小事一桩~千万~不要太感谢我们哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210803
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10210803,
					"content": "哈哈…我明白我明白，谢礼自当备上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210804
					],
					"speakerTitle": "孟丹"
				},
				{
					"id": 10210804,
					"content": "真的不用了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210805
					]
				},
				{
					"id": 10210805,
					"content": "别这么说！多亏了您，我才能逃过一劫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210806
					],
					"speakerTitle": "孟丹"
				},
				{
					"id": 10210806,
					"content": "我是璃月港内「明星斋」的供货商，孟丹，平时常在山里走动，四处搜集古董。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210807
					],
					"speakerTitle": "孟丹"
				},
				{
					"id": 10210807,
					"content": "没想到这回跟盗宝团看上了同一座遗迹，一不小心…就被抓住关起来了，唉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210808
					],
					"speakerTitle": "孟丹"
				},
				{
					"id": 10210808,
					"content": "这位恩人，您手头还缺什么吗？古董、珍玩、各色摆件…只要您要，只要我有！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210809
					],
					"speakerTitle": "孟丹"
				},
				{
					"id": 10210809,
					"content": "好意我心领了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210810
					]
				},
				{
					"id": 10210810,
					"content": "等等，我们确实在找一件东西！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210811
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10210811,
					"content": "哦？是什么东西？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210812
					],
					"speakerTitle": "孟丹"
				},
				{
					"id": 10210812,
					"content": "你有没有可以装礼物的盒子？要漂亮一些的…嗯，用来放点心的那种。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210813
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10210813,
					"content": "这当然有，做古玩的怎么能不备礼盒？<color=#00E1FFFF>「明星斋」</color>里自有七国第一流的送礼包装。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210814
					],
					"speakerTitle": "孟丹"
				},
				{
					"id": 10210814,
					"content": "您等着，我去跟老板打个招呼。您什么时候需要，到店里直接找她就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210815
					],
					"speakerTitle": "孟丹"
				},
				{
					"id": 10210815,
					"content": "太好了，我们的「糖霜史莱姆」有豪华包装盒啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
