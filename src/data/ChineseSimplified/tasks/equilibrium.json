			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10210201,
					"content": "嗯？空气里有强烈的甜香味…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10210202,
					"content": "而且…你有没有听到什么声音？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210203,
						10210205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10210203,
					"content": "好像有人呼救。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210204
					]
				},
				{
					"id": 10210204,
					"content": "听起来，是从那个遗迹里发出的声音…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10210207,
					"content": "…啊，是那些盗宝团把什么人关起来了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10210205,
					"content": "好像有人在唱歌。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210206
					]
				},
				{
					"id": 10210206,
					"content": "不对，是呼救声！是从那个遗迹里发出来的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210207
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 102103,
			"completionStepIds": [
				102103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102103",
							"2"
						],
						"stepId": 102103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"步云"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10210301,
					"content": "（按照刻晴教的，现在应该这样说…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10210302,
					"content": "你好，这里卖月亮吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10210303,
					"content": "是的，要几个？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210304
					],
					"speakerTitle": "步云"
				},
				{
					"id": 10210304,
					"content": "数量不方便透露。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10210305,
					"content": "答得好，二位请由此登阁。对了，二位就是凝光大人今天安排的客人吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210306
					],
					"speakerTitle": "步云"
				},
				{
					"id": 10210306,
					"content": "没错！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10210307,
					"content": "（但这不是「客人」的暗号，而是「玉衡特许」的暗号。这又是怎么回事呢…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "步云"
				}
			]
		},
		{
			"id": 102104,
			"completionStepIds": [
				102104
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102104",
							"2"
						],
						"stepId": 102104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凝光"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10210401,
					"content": "恭候多时了，绝云间归来之人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210402
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210402,
					"content": "呀，是凝光！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10210403,
					"content": "初次见面，我们准备了一份礼物，希望你能喜欢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10210404,
					"content": "给我的？真是多谢。我请二位来，反倒让二位费心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210405
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210405,
					"content": "不费心，不费心，嘿嘿~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210406,
						10210408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10210406,
					"content": "「群玉阁」很漂亮。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210407
					]
				},
				{
					"id": 10210407,
					"content": "哈哈，很高兴你也喜欢它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210409
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210409,
					"content": "这座宫殿浮空的位置，高于一切山脉，从这里能清楚地看见璃月港的全貌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210410
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210410,
					"content": "从学做生意的年纪起，我就开始为它积攒建造资金了。成为「天权」以后，我更是邀请顶级工匠，不断扩建…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210411
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210411,
					"content": "起初，它只有房间大小，如今已能遮蔽璃月上空真正的银月了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210412
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210412,
					"content": "我相信终有一日…它的影子会笼罩七国。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210413
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210413,
					"content": "（这位「天权」大人，很有野心…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210414
					]
				},
				{
					"id": 10210414,
					"content": "有资格登上「群玉阁」的外客不多，但西风骑士团的代理团长与我有书信往来，对你赞赏有加。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210415
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210415,
					"content": "所以，从你到璃月的第一天起，我就开始散出眼线…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210416
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210416,
					"content": "什么？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210417
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10210417,
					"content": "终于在你们前往望舒客栈时，大致掌握了你们的动向。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210418
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210418,
					"content": "难道菲尔戈黛特老板，是你们的人？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210419
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10210419,
					"content": "不是的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210420
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210420,
					"content": "整座望舒客栈里，全都是我们的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210421
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210421,
					"content": "##%^%*&……！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210422
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10210422,
					"content": "不久前，还遇到了「玉衡星」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210423
					]
				},
				{
					"id": 10210423,
					"content": "在归终机旁见了一面，对么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210424
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210424,
					"content": "你该不会一直在天上偷看吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210425
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10210425,
					"content": "哈哈…这么远的距离，偷看有些难吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210426
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210426,
					"content": "…凭借「耳目」即可。我对你们很感兴趣，关注也是理所应当。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210427
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210427,
					"content": "刻晴说，七星不会暗害帝君。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210428
					]
				},
				{
					"id": 10210428,
					"content": "嗯，你与仙人往来颇多，对我们不信任，也是理所当然。这次请你来，就是想要解开一些误会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210408,
					"content": "第一次到这么高的地方…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210409
					]
				}
			]
		},
		{
			"id": 102106,
			"completionStepIds": [
				102106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102106",
							"2"
						],
						"stepId": 102106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凝光"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10210601,
					"content": "呜哇——！好、好大的客厅啊！从来没见过这么豪华的房间…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10210602,
					"content": "二位随意，把这里当成自己家也可以。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210603
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210603,
					"content": "真的可以吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10210604,
					"content": "我请你们来，自然是把你们当成朋友。朋友来玩，当然是开心第一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210605
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210605,
					"content": "那里是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210606
					]
				},
				{
					"id": 10210606,
					"content": "哎？这就是「传说中的那面墙」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210607
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10210607,
					"content": "哦？你的消息很灵通嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210608
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210608,
					"content": "因为连说书先生都在说…好多人都在求购墙上的纸张，可有名了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210609
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10210609,
					"content": "因为那面墙上记录着璃月的秘密。商人对秘密，总是充满热情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210610
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210610,
					"content": "但旅行者，璃月的商业秘密对你来说并无意义，你很特别，你自己也很清楚这一点吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210611
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210611,
					"content": "如果可能，我想获取你的信任。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210612
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210612,
					"content": "但假如要你在我和刻晴当中，选择一个更值得信任的人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210613,
						10210614
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210613,
					"content": "凝光的敬神和刻晴的不敬神…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210615
					]
				},
				{
					"id": 10210615,
					"content": "…哈哈，你会选刻晴吧？这种程度的直觉，我还是有的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210616
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210616,
					"content": "我原本觉得，过刚易折。以她那样的性格当上七星，有些事还需要我在背后打点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210617
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210617,
					"content": "但在她说出「仙人的时代已经过去了，如果连璃月七星都不敢正视这一点，那璃月的未来要怎么办」这句话以后…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210618
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210618,
					"content": "我心中的一些疑虑，倒是被打消了不少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210619
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210619,
					"content": "不错，我不否认帝君的逝去看似对七星有利。但为了璃月，我也不能被「七星篡位」的流言束缚住应有的行动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210620
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210620,
					"content": "这些流言的背后，也有愚人众的身影？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210621
					]
				},
				{
					"id": 10210621,
					"content": "嗯…看来你从刚才开始，就已经完全明白我要说什么了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210622
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210622,
					"content": "我下令封锁消息、藏匿仙体，一来是为暂时稳定局面，二来也是为了避免…在蒙德发生过的那种事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210623
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210623,
					"content": "愚人众借帝君之死，已经有了太多超出外交底线的暗中行动。我身为对璃月负责的「天权」，对抗时也顾不得姿态优雅了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210624
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210624,
					"content": "批准「送仙典仪」的筹办，也只是为七星全面接管璃月，争取一些缓冲时间…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210625
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210625,
					"content": "唔…果然和钟离说的一样，七星提供了仪式场地，只是因为可以利用我们达成自己的目的呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210626
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10210626,
					"content": "对了！说到「达成目的」…还有一件事，我可以说吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210627
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10210627,
					"content": "但说无妨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210628
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210628,
					"content": "听说，送了见面礼的客人，都能得到一些好处…那我们有份吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210629
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10210629,
					"content": "派蒙，你就不能说些别的吗！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210630
					]
				},
				{
					"id": 10210630,
					"content": "哈哈哈…没关系，我很喜欢直白的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210631
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210631,
					"content": "最近这段时间，麻烦你们的事情也算是不少。这样吧，作为赔礼，你可以从我这里任选一件喜欢的东西带走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210632
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210632,
					"content": "好！就等着这句了——我早就想好了！我想要的是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210633
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10210633,
					"content": "那面墙上的<color=#00E1FFFF>纸片</color>！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210634
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10210634,
					"content": "？？？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210635
					]
				},
				{
					"id": 10210635,
					"content": "别用那种眼神看着我！你不明白吗？这面墙上的纸，哪怕只有指甲盖大小，也能卖出天价！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210636
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10210636,
					"content": "要是…要是没有撕碎的一整张…唔！我都不敢想象它值多少摩拉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10210614,
					"content": "还是刻晴的「不敬」更可信一些。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210615
					]
				}
			]
		},
