			"dialogs": [
				{
					"id": 10213101,
					"content": "怎么，挑完了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10213102
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10213102,
					"content": "啊，决定了的话也不用问我，直接拿走就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10213103
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10213103,
					"content": "然后，就在「群玉阁」坐一会、逛一逛吧。旅途当中的休息，也是很重要的一环。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10213104,
						10213106
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10213104,
					"content": "多谢款待。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10213105
					]
				},
				{
					"id": 10213105,
					"content": "别这么客气，请随意些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凝光"
				},
				{
					"id": 10213106,
					"content": "是时候动身了，再见…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10213107
					]
				},
				{
					"id": 10213107,
					"content": "要走了么？也好。希望我们下次相遇时，你已经做了正确的事…或者将要作出正确的选择。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凝光"
				}
			]
		}
