				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凝光"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10211301,
					"content": "你应该听说过「魔神战争」吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211302,
						10211303
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10211302,
					"content": "不太清楚…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211304
					]
				},
				{
					"id": 10211304,
					"content": "世上曾有诸多魔神，也曾有旷日持久的战争，直到两千年前方才终结。期间生灵涂炭，流血无数。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211305
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10211305,
					"content": "最终，提瓦特大陆上只剩下七位胜利者。他们在败者的残骸上建立国度与城邦，开始了七神的时代。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211306
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10211306,
					"content": "看见「孤云阁」了吗？那并不是天然的地貌，而是战争期间，帝君投下的巨大岩枪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211307
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10211307,
					"content": "在岩枪之下，镇压着帝君当年的手下败将：未能取得七神之位的昔日魔神。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211308
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10211308,
					"content": "不仅魔神会死，即使是「尘世七执政」，两千年来亦有更迭。帝君的逝去是璃月无法想象的灾难，但提瓦特的七神体系…不会崩溃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211309
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10211309,
					"content": "下一位岩神迟早会出现，但我们又怎会遗忘帝君？到那时，璃月人与仙神的关系，必定会与过往不同。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211310
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10211310,
					"content": "即使在新的时代，「璃月七星」也是帝君的旧日子民。向帝君举刀的罪名…你认为，我们担得起吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211311
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10211311,
					"content": "可是，你们为什么要藏起「仙祖法蜕」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211312
					]
				},
				{
					"id": 10211312,
					"content": "呵呵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211313
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10211313,
					"content": "那天在玉京台，事出突然，我也毫无防备。你当时在现场，应该都看见了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211314
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10211314,
					"content": "七星的敌人，早已潜伏在璃月港内。若不采取行动，就会落于下风。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211315
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10211315,
					"content": "藏起仙祖法蜕是必要之举，借此，我才能转明为暗，以静制动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211316
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10211316,
					"content": "你说的「敌人」是谁呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10211317,
					"content": "旅者，你觉得呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211318,
						10211319
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10211318,
					"content": "难道是他？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211320
					]
				},
				{
					"id": 10211320,
					"content": "嗯？你和凝光在打什么哑谜？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211321
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10211321,
					"content": "正确的答案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211322
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10211322,
					"content": "唔——？？？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10211323,
					"content": "哈…外面景致虽好，但高空的风还是略大了些。二位，殿内已经做好了待客的准备，请随我进来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凝光"
				},
				{
					"id": 10211319,
					"content": "就是他吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211320
					]
				},
				{
					"id": 10211303,
					"content": "只对这个词语有点印象。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211304
					]
				}
			]
		},
