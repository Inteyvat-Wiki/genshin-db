					"胡塞尼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715050101,
					"content": "#{NICKNAME}，你总算来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050102
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715050102,
					"content": "调试得还顺利吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715050103
					]
				},
				{
					"id": 715050103,
					"content": "已经调试完毕，虽然有些担心，不过现在也只能暂时把光钉放在矿道深处。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050104
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715050104,
					"content": "我还拜托海迪夫做了药，会给老图和阿昊也送过去的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050105
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715050105,
					"content": "#{NICKNAME}，启动光钉，然后封闭掉地脉喷涌黑泥的出口…一定要做到啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050106
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715050106,
					"content": "原本只是海迪夫叫我过来帮个忙而已，那个时候我心里想着，要是我解决不了这个问题，大不了就带着光钉直接回须弥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050107
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715050107,
					"content": "反正关于「普尔希娜光钉」的实验也已经做得够多，要完成一篇数据详实的报告根本就是绰绰有余。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050108
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715050108,
					"content": "但是老图和阿昊呢，这些生活在这里的人…他们可就只能终身和这些危险的黑泥为伴了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050109
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715050109,
					"content": "如果我的研究无法真的帮助到他们，只是为了一篇报告的话，我想，恐怕这研究也意义不大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050110
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715050110,
					"content": "所以我才决定，要想办法解决地脉喷涌黑泥的问题，更何况，接触这些黑泥…对作为须弥学者的我来说也是一种警醒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050111
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715050111,
					"content": "#我相信你的实力，但是黑泥涌出的地方还是很危险，要小心啊，{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050112,
						715050113
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715050112,
					"content": "知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715050114
					]
				},
				{
					"id": 715050114,
					"content": "哈哈哈呃咳、咳咳…咳咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050115
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715050115,
					"content": "#我是说你，{NICKNAME}，「普尔希娜光钉」在喷口处启动，虽然能够减轻黑泥对怪物的影响。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050116
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715050116,
					"content": "但那里之前被黑泥招来的怪物数量还是太多了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050117
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715050117,
					"content": "你一定要小心自己的安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715050113,
					"content": "我会小心光钉的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715050114
					]
				}
			]
		}
	]
}