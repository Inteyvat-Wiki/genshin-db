				},
				{
					"id": 150480303,
					"content": "做得好，阿夏！你的运动能力超级棒啊，看得我目瞪口呆！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480304
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150480304,
					"content": "接下去轮到班尼特测试了对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150480305,
					"content": "对！我已经做好热身运动，活动开全身的筋骨和肌肉了，包在我身上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480306
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150480306,
					"content": "也要注意安全。",
