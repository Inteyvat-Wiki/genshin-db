			"dialogs": [
				{
					"id": 150480101,
					"content": "…我们不能让您承担这种风险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480102
					],
					"speakerTitle": "高恩"
				},
				{
					"id": 150480102,
					"content": "可您刚才还不是这么说的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480103
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150480103,
					"content": "实在抱歉，虽然时间很紧张，但我们更需要考虑游客的人身安全，请您谅解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480104
					],
					"speakerTitle": "高恩"
				},
				{
					"id": 150480104,
					"content": "#{NICKNAME}，你来得正好，请帮我说服这位先生吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480105
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150480105,
					"content": "他们急着等人测试，我好不容易向对方证明了我的冒险经验，也表明我愿意承担测试后果，本来很顺利…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480106
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150480106,
					"content": "但一听到我的「过往危机经历」，这位先生就说什么都不肯了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480107
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150480107,
					"content": "这位游客，我理解您的热心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480108
					],
					"speakerTitle": "高恩"
				},
				{
					"id": 150480108,
					"content": "但如果您过桥的时候都会失足掉进水里，最好还是去参与更温和一点的项目…那边的沙滩躺椅怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480109
					],
					"speakerTitle": "高恩"
				},
				{
					"id": 150480109,
					"content": "唉，可是，可是我确实是符合测试条件的冒险家！那只是因为…运气不好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480110
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150480110,
					"content": "我是真的很想帮上忙，请您相信我的实力是值得信任的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480111,
						150480112
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150480111,
					"content": "我可以证明。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150480113
					]
				},
				{
					"id": 150480113,
					"content": "既然拯救纳塔的大英雄都这么说了…这样吧，可否先让这位阿夏搭档完成第一轮测试呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480114
					],
					"speakerTitle": "高恩"
				},
				{
					"id": 150480114,
					"content": "您可以在一旁观看，提前熟悉整体路线。一切顺利无误的话，再来请您参与第二轮测试。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480115
					],
					"speakerTitle": "高恩"
				},
				{
					"id": 150480115,
					"content": "阿夏，你愿意吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480116
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150480116,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480117
					],
					"speakerTitle": "阿夏"
				},
				{
					"id": 150480117,
					"content": "好，那就交给你了哦，我的好搭档。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150480112,
					"content": "我为他担保。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150480113
					]
				}
			]
		},
