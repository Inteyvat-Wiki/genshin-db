			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿贝多"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412110101,
					"content": "阿贝多——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412110102,
					"content": "回来啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110103
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412110103,
					"content": "我们可是努力了好久，快看看剑的进展如何！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412110104,
					"content": "你看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110105
					]
				},
				{
					"id": 412110105,
					"content": "唔…果然。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110106
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412110106,
					"content": "和我想的一样，这把剑会随着战斗成长。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110107
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412110107,
					"content": "它又不是人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412110108,
					"content": "所以这就是它的特殊之处了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110109
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412110109,
					"content": "对了，先说一件比较重要的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110110
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412110110,
					"content": "我调查了附近的雪地，发现有不同寻常的痕迹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110111
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412110111,
					"content": "呀，不会是小偷吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110112,
						412110113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412110112,
					"content": "不是说我们才是小偷吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110114
					]
				},
				{
					"id": 412110114,
					"content": "也对哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412110115,
					"content": "我认为那些痕迹并不寻常，有调查的必要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110116
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412110116,
					"content": "是小偷，还是别的东西，调查完自然会有结论。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412110113,
					"content": "盗宝团应该不这么想。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110114
					]
				}
			]
		},
		{
			"id": 4121102,
			"completionStepIds": [
				4121109
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4121109",
							"2"
						],
						"stepId": 4121109,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿贝多"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412110201,
					"content": "居然是愚人众？而且还选在盗宝团的营地里袭击我们…莫非他们是跟着我们来的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110202
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412110202,
					"content": "可是，为什么要跟着我们呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412110203,
					"content": "啊！该不会是你背着我去犯了什么事吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412110204,
					"content": "你犯事了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110205,
						412110206
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412110205,
					"content": "怎么可能！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110207
					]
				},
				{
					"id": 412110207,
					"content": "唔…那就不是我们的错了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412110208,
					"content": "我猜愚人众也在找这把剑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110209
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412110209,
					"content": "哎哎？可你不是把这把剑藏得很好吗，愚人众怎么会知道它的存在呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412110210,
					"content": "或许是你在雪山战斗的样子被他们看到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110211
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412110211,
					"content": "如果愚人众的人眼光够好，就会发现这把剑的与众不同之处。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110212
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412110212,
					"content": "愚人众怎么什么都要啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412110213,
					"content": "这可不是什么都要哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110214
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412110214,
					"content": "我记得我有听说过相关信息。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110215
					]
				},
				{
					"id": 412110215,
					"content": "愚人众在搜集与神有关的东西，你们应该已经知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110216
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412110216,
					"content": "呀，这么一说，确实听迪卢克老爷提起过呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412110217,
					"content": "杜林是风神的仇敌，具有相当的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110218
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412110218,
					"content": "说它是「能匹敌神的存在」也好，「与神有关的存在」也好，都不为过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110219
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412110219,
					"content": "难怪这把剑会被愚人众当成目标。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110220
					]
				},
				{
					"id": 412110220,
					"content": "原来是这样啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412110221,
					"content": "不久前来附近写生，我有个新发现。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110222
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412110222,
					"content": "从这里向前，有一处较为特殊的土地。它的地脉流向与别处都不一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110223
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412110223,
					"content": "周边的怪物被它吸引，又受它影响，久而久之，身体素质会比同类更强。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110224
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412110224,
					"content": "还有这种好事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412110225,
					"content": "我们是要帮助这把剑成长对吧？来都来了，不如去试试手！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412110226,
					"content": "没错。顺便还能观察不同敌人对这把剑造成的影响。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412110206,
					"content": "我绝不可能做这种事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110207
					]
				}
			]
		},
		{
			"id": 4121103,
			"completionStepIds": [
				4121112
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4121112",
							"2"
						],
						"stepId": 4121112,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿贝多"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412110301,
					"content": "有什么感觉吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110302,
						412110303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412110302,
					"content": "剑上的力量更强了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110304
					]
				},
				{
					"id": 412110304,
					"content": "我有一个推测。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110305
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412110305,
					"content": "这把剑从敌人身上吸收力量后，会与这座雪山深处暗藏的杜林亡骸发生共鸣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110306
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412110306,
					"content": "哇…好像很厉害呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412110307,
					"content": "如果这一猜想成立，那么这座雪山上的怪物也可能与杜林的亡骸共鸣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110308
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412110308,
					"content": "为什么会跟龙的亡骸共鸣呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110309
					]
				},
				{
					"id": 412110309,
					"content": "恐怕与这一带怪物的力量来源有关。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110310
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412110310,
					"content": "杜林不是一般的怪物。哪怕在它已经死亡的现在，整座雪山也依然受到它亡骸的影响。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110311
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412110311,
