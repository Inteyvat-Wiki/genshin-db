					"nextDialogs": [
						732201510
					]
				},
				{
					"id": 732201510,
					"content": "嗯…稍微再给我一点时间…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201511
					],
					"speakerTitle": "婕德"
				},
