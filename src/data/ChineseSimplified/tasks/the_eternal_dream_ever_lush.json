	"talks": [
		{
			"id": 7322006,
			"completionStepIds": [
				7322006
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7322006",
							"2"
						],
						"stepId": 7322006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"婕德",
					"利露帕尔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732200601,
					"content": "抱歉…我一时有点不知该说什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200602
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732200602,
					"content": "时间就像忘记流动了一样，一切都是静止的。不知为什么，我甚至忘记了惊叹这里的奇异景色…只感到了平静。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200603
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732200603,
					"content": "在这种地方，伴着已死的神长眠…唉，虽然我宁愿他们从没有离开过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200604
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732200604,
					"content": "真希望他们能永远留驻这里，不再被时间遗忘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200605
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732200605,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200606
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 732200606,
					"content": "起初进来时，我们搅扰了碎片的力量，也破坏了维持稳定的机关…这里早晚会崩毁，被黄沙吞没。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200607
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 732200607,
					"content": "到那时候，女主人维持这片绿洲静止的残力也会回归诸天…这是无可挽回的结局。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200608
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 732200608,
					"content": "嗯…我知道。但至少在那之前，至少在那之前…我的父母终于重聚了，就像他们从没离开彼此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200609
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732200609,
					"content": "或许终有一天，我也会回到这里吧…等到我厌倦了所有冒险，离开了所有能称之为「家」的地方之后。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200610
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732200610,
					"content": "到那时候，再从容地说一句「我回来咯！」然后，躺在父母中间沉沉睡去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200611
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732200611,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200612
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732200612,
					"content": "婕德…那一天一定还很远呢！现在…唔…现在哲伯莱勒肯定很高兴，虽然板着脸，但是肯定很高兴的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200613
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732200613,
					"content": "谢谢你，派蒙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200614
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732200614,
					"content": "#还有{NICKNAME}，很感谢你愿意一路陪我，完成这个小小的任性心愿…但现在我一个人想多陪父母一会…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200615,
						732200617
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732200615,
					"content": "我理解的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732200616
					]
				},
				{
					"id": 732200616,
					"content": "嗯…谢谢你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "婕德"
				},
				{
					"id": 732200617,
					"content": "别忘了回去。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732200618
					]
				},
				{
					"id": 732200618,
					"content": "不用管我…我随后会跟上来的。哈，现在还不是在这里定居的好时候呢，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "婕德"
				}
			]
		},
		{
			"id": 7322008,
			"completionStepIds": [
				7322008
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7322008",
							"2"
						],
						"stepId": 7322008,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"婕德",
					"芭别尔",
					"利露帕尔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732200801,
					"content": "我们安全回来了，芭别尔主母。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200802
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732200802,
					"content": "我们探明了「永恒绿洲」的秘密，为部族打开了通道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200803
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732200803,
					"content": "感谢您给我这次机会，让我得以完成父母的夙愿…即使他们并不受塔尼特的祜佑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200804
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732200804,
					"content": "请不要这么说，孩子。你的夙愿，我一直记在心里。满足孩子们的愿望，也是我作为主母的职责。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200805
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732200805,
					"content": "谢谢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200806
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732200806,
					"content": "很好，婕德。那么，阿萨里格的事情…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200807
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732200807,
					"content": "您的判断是正确的…他是叛徒无疑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200808
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732200808,
					"content": "欸，所以你们早就知道阿萨里格会反水了吗…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200809
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732200809,
					"content": "不，之前还只是怀疑而已，一路上我都在监视着他…但我没想到阿萨里格会这么快摊牌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200810
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732200810,
					"content": "芭别尔主母警告过我，但我那时宁愿选择相信他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200811
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732200811,
					"content": "请看，这里是有关他与愚人众勾结的证据。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200812
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732200812,
					"content": "婕德将阿德菲的信件交给了芭别尔主母。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732200813
					]
				},
				{
					"id": 732200813,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200814
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732200814,
					"content": "请不要悲伤，芭别尔主母…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200815
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732200815,
					"content": "嗯…我早就察觉到他怀有异心，只可惜没能亲手处决他…我曾经那么看重他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200816
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732200816,
					"content": "但现在，部族的环境愈发凶险…我失去了两个曾精心培养的人物，以后部族的大事小情，就要多多要你承担了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200817
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732200817,
					"content": "欸…所以说，婕德是晋升了呀？恭喜你啦，婕德！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200818
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732200818,
					"content": "晋升？哈哈…这个词在沙漠里可不多见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200819
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732200819,
					"content": "在我们沙漠人眼中可没有什么官僚层级。只是谁负责的事情更多了，谁就更有可能在未来掌握更多权力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200820
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732200820,
					"content": "婕德…塔尼特的未来在你身上，请不要辜负族人们的希望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200821
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732200821,
					"content": "族人…所以，您也承认我是塔尼特真正的族人了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200822
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732200822,
					"content": "别犯傻，我一直这样认为。不论之前发生过什么，你是塔尼特的女儿，你的身上永远流着与我们相同的血。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200823
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732200823,
					"content": "嗯…谢谢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200824
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732200824,
					"content": "唔，总觉得有什么不太对劲的东西没有提到呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200825
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732200825,
					"content": "#{NICKNAME}，我们之前遇到过什么可疑的东西来着？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200826,
						732200845
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732200826,
					"content": "关于峡谷里的那些废弃营地…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732200827
					]
				},
				{
					"id": 732200827,
					"content": "你曾往绿洲派出过其他族人，并且任由他们死在了那里，然后以「禁忌」的借口禁止后来人进入，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200828
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 732200828,
					"content": "但你却鼓励我们深入险地，对这些东西只字不提，这是怎么回事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200829
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 732200829,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200830
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732200830,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200831
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732200831,
					"content": "尊敬的利露帕尔，此前的种种不便与误会，请容我向您致歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200832
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732200832,
					"content": "但塔尼特部族的确并非最近才开始探索居尔城的遗迹，以及「永恒绿洲」之所在…我此前已经派出过许多族人前往。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200833
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732200833,
					"content": "今人之所以能够确定这几处地点的位置与地形情况，也是多亏了他们的探险…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200834
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732200834,
					"content": "只是由于风险巨大，人员往往十不存一，而考察结果寥寥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200835
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732200835,
					"content": "我才要求停止这种行动，将这些地方划为部族的禁忌区域。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200836
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732200836,
					"content": "阿萨里格那个叛徒…也曾经带队考察过那些峡谷与遗迹，我以为我能信任他给你们开路…但却没想到他…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200837
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732200837,
					"content": "但你没跟我们说过这些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200838
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732200838,
					"content": "因为我从一开始就知道，你们会安然无恙地回来。你是我所信托的后辈，婕德。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200839
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732200839,
					"content": "你的勇敢无畏，你的凶猛和机智，你对待族人和朋友的真诚和温柔，我都看在眼里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200840
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732200840,
					"content": "如果我的女儿未曾被沙漠带走，我想她一定也会长成你的样子。任何危险都打不倒她，任何沙暴都无法吞没她…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200841
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732200841,
					"content": "所以，我也这样相信着你，一直在默默为你祈祷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200842
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732200842,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200843
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732200843,
					"content": "…抱歉，芭别尔主母，是我顶撞您了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200844
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732200844,
					"content": "不，引起了你们的误解和疑虑，应该是我要请求你们的原谅才对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200864
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732200864,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200865
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 732200865,
					"content": "抱歉，我的大人，是我多虑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200866
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 732200866,
					"content": "#那么，很高兴大家都能解开误会。{NICKNAME}，作为贵客，塔尼特部族永远欢迎你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200867
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732200867,
					"content": "尊贵的「镇灵主人」，无论您提出什么样的要求，请尽管与我相谈，我将尽全力满足。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200868
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732200868,
					"content": "任何要求吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732200869
					]
				},
				{
					"id": 732200869,
					"content": "任何要求。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200870,
						732200873,
						732200876
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732200870,
					"content": "我想要摩拉做报酬。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732200871
					]
				},
				{
					"id": 732200871,
					"content": "这才对嘛！摩拉、摩拉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200872
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732200872,
					"content": "很好，这是你应得的报酬。还有…感谢你为我照顾婕德。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200881
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732200881,
					"content": "好了，不要让我留你们太长时间了。再次感谢你们的帮助，「镇灵主人」…还望您能够多多光顾塔尼特部族…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200882
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732200882,
					"content": "毕竟，我们仰仗着您与利露帕尔的引导。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732200873,
					"content": "我想要一件纪念物。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732200874
					]
				},
				{
					"id": 732200874,
					"content": "欸，我们不要摩拉吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200875
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732200875,
					"content": "你与塔尼特的友谊当然值得留下纪念，请收下我们的薄礼，希望你不要嫌弃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200881
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732200876,
					"content": "在婕德生日的宴会上替我敬杯酒吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732200877
					]
				},
				{
					"id": 732200877,
					"content": "嗯嗯，那也别忘了我的份！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200878
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732200878,
					"content": "欸…？谢谢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200879
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732200879,
					"content": "噗…这是你们外人的传统吗？那好吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200880
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732200880,
					"content": "我就为你们留着这个人情好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200881
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732200845,
					"content": "关于叛徒的书信…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732200846
					]
				},
				{
					"id": 732200846,
					"content": "阿萨里格和阿德菲的信里提及，他们反叛的原因是你将婕德这个「叛徒的女儿」当做掌中宝和继承人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200847
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 732200847,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200848
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732200848,
					"content": "另外，你也在部族中刻意清理「外人」的党羽，即使之前你曾依赖他们和「北方人」交流？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200849
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 732200849,
					"content": "我听不懂你们的黑话，但方才这些话是什么意思…我很好奇呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200850
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 732200850,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200851
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732200851,
					"content": "尊敬的利露帕尔，此前的种种不便与误会，请容我向您致歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200852
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732200852,
					"content": "但塔尼特部族的经营与生存，必须依赖多方贸易才能维持。这之中就包括那些来自北方的家伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200853
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732200853,
					"content": "纵我忙于处理部落事务的方方面面，也难以料定他们居心叵测…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200854
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732200854,
					"content": "但后来，我逐渐发现他们带来的风险多于益处…也就只能先从内部下手清理叛徒了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200855
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732200855,
					"content": "这也正是我需要婕德的原因，她总能够坚定迅速地为部族排除叛徒，我欣赏她的忠诚和能力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200856
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732200856,
					"content": "但你没跟我们说过这些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200857
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732200857,
					"content": "因为我从一开始就知道，你们会安然无恙地回来。你是我所信托的后辈，婕德。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200858
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732200858,
					"content": "你的勇敢无畏，你的凶猛和机智，你对待族人和朋友的真诚和温柔，我都看在眼里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200859
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732200859,
					"content": "如果我的女儿未曾被沙漠带走，我想她一定也会长成你的样子。任何危险都打不倒她，任何沙暴都无法吞没她…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200860
					],
					"speakerTitle": "芭别尔"
				},
				{
