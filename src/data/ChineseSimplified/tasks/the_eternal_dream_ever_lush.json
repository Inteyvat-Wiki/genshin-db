						732201404
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 732201404,
					"content": "…嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201405
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732201405,
					"content": "危机四伏的沙漠，背叛和阴谋…无法原谅的事情，无法释怀的事情，明明刚发生了不久…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201406
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732201406,
					"content": "但在这里，我却很平静…很开心。我不知道…为什么会这样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201407
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732201407,
					"content": "因为这里是花的女主人最后的领域…天空的馈赠在地下深处维持着它的静止，这里保存了她最后的精魄…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201408
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 732201408,
					"content": "所以即使她已经死去，这里依然平静如初，就像从未有人来过。所以，进入这片领域的人…只会感受到平静与快乐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201409
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 732201409,
					"content": "因为女主人是疯癫僧人与歧途旅客的保护者…这里对于他们来说，曾是归宿的乐园。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201410
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 732201410,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201411
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732201411,
					"content": "婕德没有说话，默默上前放下母亲的笔记，又将哲伯莱勒的大斧斜倚在一旁…\\n就仿佛他们从未走远一样。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
