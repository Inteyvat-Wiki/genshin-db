			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"婕德",
					"利露帕尔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732201301,
					"content": "随着闪光的碎片汇入利露帕尔的魔瓶，你感到自身的力量也被抽离了少许…但很快，一股温暖的感觉充实了你。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732201302
					]
				},
				{
					"id": 732201302,
					"content": "从镇灵恍惚的目光中，你看到了红玉堆砌的宫阙与花园…千万种花儿盛开，万千鸟儿鸣啭。\\n镇灵们是女主人富有灵性的仆从，是她的乐师与斟酒者。\\n她的花园中，发疯的僧人与破落的旅人伴着萨吉的水仙旋舞，啜饮着葡萄藤女儿的鲜血…\\n这是世上无二的花园，曾是花之女主人的居所，如今是她长眠的陵墓…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732201303
					]
				},
				{
					"id": 732201303,
					"content": "「玫瑰绽放如火，将夜莺的生命点燃。蜡烛灿然微笑，却给飞蛾带来灾难。」",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732201304
					]
				},
				{
					"id": 732201304,
					"content": "你看见她伸出手来，肤色如月光般透明。你望见她的脸庞，难以言喻的美丽。仿佛每一个美妙的镇灵都是她的花瓣，每一缕馨香都来自她一般…\\n然后，你对上了她的目光——",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732201305
					]
				},
				{
					"id": 732201305,
					"content": "那里什么都没有。\\n只有无垠的虚空，令你坠落其中，恐惧不已…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732201306
					]
				},
				{
					"id": 732201306,
					"content": "你的意识逐渐恢复，婕德正握着你的手，神情担忧。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732201307
					]
				},
				{
					"id": 732201307,
					"content": "你醒了…你还好吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201308
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732201308,
					"content": "你刚刚…唉，算了。你没事就好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201309
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732201309,
					"content": "你都看到了什么呀…就像做了一个长梦一样，看起来蛮吓人的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201310,
						732201311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732201310,
					"content": "是「花的女主人」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732201312
					]
				},
				{
					"id": 732201312,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201313
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 732201313,
					"content": "她已经不在这里了，他骗了我们，骗了我们所有人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201314
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 732201314,
					"content": "你说什么…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201315
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732201315,
					"content": "没什么，一个很久以前的契约取消了。我想…我自由了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201316
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 732201316,
					"content": "沙海的王曾向我们承诺，花的女主人沉眠在此处，终有一日会从这里醒来…但…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201317
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 732201317,
					"content": "真是奇怪…女主人已经死去了，他骗了我…骗了我的族人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201318
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 732201318,
					"content": "我本应该发了疯般地恨他，为了这片沙漠，为了女主人的死去…就像我曾爱他和仰视他…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201319
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 732201319,
					"content": "但…我却失去了憎恨的动力…为什么会这样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201320,
						732201321
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 732201320,
					"content": "或许这就是「自由」吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732201322
					]
				},
				{
					"id": 732201322,
					"content": "这样吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201323
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 732201323,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201324
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732201324,
					"content": "哼，少卖乖了…我的主人仍旧是您，我们的契约还没有结束呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201325
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 732201325,
					"content": "我们走吧，婕德还在这里等着你呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201326
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 732201326,
					"content": "嗯…我看到有一片好地方，就在那边。我先过去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201327
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732201327,
					"content": "你也别忘了过来呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "婕德"
				},
				{
					"id": 732201321,
					"content": "你不用依赖「爱人」或「仇人」了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732201322
					]
				},
				{
					"id": 732201311,
					"content": "是这里很久以前的样子…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732201312
					]
				}
			]
		},
