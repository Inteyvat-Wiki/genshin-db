				{
					"id": 732201801,
					"content": "她是个好孩子，我的大人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201802
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 732201802,
					"content": "这孩子是一头天生的猛兽。她可能头脑不是很聪明，但生存直觉却敏锐无比…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201803
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 732201803,
					"content": "她知道谁想让她受伤流血，而一旦她嗅到这一点…就会拼命反击，毫不留情，无论对方有着多么亲密的掩饰…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201804
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 732201804,
					"content": "唉…但她还不知道，有什么样的罗网在等着她呢。她还不知道，她想要争取的那个家园…究竟是个多么虚伪的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201805
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 732201805,
					"content": "我的大人，如果您在乎她，请好好保护她吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201806
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 732201806,
					"content": "我的小小建议，您就当作是…我不知道，就当是身为母亲，一点小小的补偿吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "利露帕尔"
				}
