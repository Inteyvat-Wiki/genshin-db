			"dialogs": [
				{
					"id": 730151601,
					"content": "兰那库拉，我们回来了！不过之后就得靠你啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730151602,
					"content": "#谢谢派蒙，谢谢那菈{NICKNAME}，兰那库拉知道该怎么做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151603
					],
					"speakerTitle": "兰那库拉"
				},
				{
					"id": 730151603,
					"content": "喔！看样子这里应该也没问题了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730151604,
					"content": "希望森林能快点恢复正常。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151605
					]
				},
				{
					"id": 730151605,
					"content": "治好法留纳神机，一定可以。不过无留陀…必须清除，为了桓那，为了沙恒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151606
					],
					"speakerTitle": "兰那库拉"
				},
				{
					"id": 730151606,
					"content": "就像为了那菈法留纳而造的「纪念碑」被坏种子盖住。因为无留陀，「觉树之堂」也受到影响。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151607
					],
					"speakerTitle": "兰那库拉"
				},
				{
					"id": 730151607,
					"content": "那是比那菈法留纳来到桓那兰那更早的时候，那菈和兰那罗一起建造的苗圃。但是现在…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151608
					],
					"speakerTitle": "兰那库拉"
				},
				{
					"id": 730151608,
					"content": "除了维摩庄的孩子们还能看见，兰那罗对大人们来说不过是故事里的存在…曾经的苗圃也因为无留陀而一度变得荒芜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151609
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730151609,
					"content": "兰那库拉想要在苗圃里种满花朵，那菈忘记了兰那罗，但是没关系，因为那菈会看到花朵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151610
					],
					"speakerTitle": "兰那库拉"
				},
				{
					"id": 730151610,
					"content": "兰那库拉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151611
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730151611,
					"content": "#那菈{NICKNAME}，派蒙，谢谢，兰那库拉不会忘记。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151612
					],
					"speakerTitle": "兰那库拉"
				},
				{
					"id": 730151612,
					"content": "现在，兰那库拉要回「歇脚处」，兰般度知道「纪念碑」被清理干净了，一定很高兴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151613
					],
					"speakerTitle": "兰那库拉"
				},
				{
					"id": 730151613,
					"content": "#那菈{NICKNAME}和派蒙要不要和兰那库拉一起回「歇脚处」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151614,
						730151616
					],
					"speakerTitle": "兰那库拉"
				},
				{
					"id": 730151614,
					"content": "好呀。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151615
					]
				},
				{
					"id": 730151615,
					"content": "有金色的那菈同行，非常安心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰那库拉"
				},
				{
					"id": 730151616,
					"content": "还有其他事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151617
					]
				},
				{
					"id": 730151617,
					"content": "#兰穆护昆达看顾那菈{NICKNAME}和派蒙，小心不要被坏家伙吞掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰那库拉"
				}
			]
