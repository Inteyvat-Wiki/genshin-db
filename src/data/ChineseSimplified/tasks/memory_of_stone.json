			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙",
					"兰那库拉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730150301,
					"content": "你一定就是兰那库拉了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730150302,
					"content": "呜哇！被、被那菈发现了！该、该怎么办…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150303
					],
					"speakerTitle": "兰那库拉"
				},
				{
					"id": 730150303,
					"content": "你先别逃跑！是兰般度告诉我们你在这里的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730150304,
					"content": "既、既然是兰般度告诉你们的，那一定是好那菈了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150305
					],
					"speakerTitle": "兰那库拉"
				},
				{
					"id": 730150305,
					"content": "#嗯？兰那库拉是不是太轻信了？万一{NICKNAME}是坏那菈，用兰般度的名字来骗你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730150306,
					"content": "呀！那、那金色的那菈，其实是在骗兰那库拉？金色的那菈，其实是坏那菈？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150307
					],
					"speakerTitle": "兰那库拉"
				},
				{
					"id": 730150307,
					"content": "感觉突然涌出了罪恶感…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730150308,
					"content": "别听派蒙的，我是好那菈。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150309
					]
				},
				{
					"id": 730150309,
					"content": "#太好了，感谢兰穆护昆达，金色的那菈果然是好那菈。虽然那菈{NICKNAME}比兰那库拉高很多，但是不害怕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150310
					],
					"speakerTitle": "兰那库拉"
				},
				{
					"id": 730150310,
					"content": "派蒙…派蒙小只，也不害怕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150311
					],
					"speakerTitle": "兰那库拉"
				},
				{
					"id": 730150311,
					"content": "喂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150312,
						730150314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730150312,
					"content": "派蒙的确很小只…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150313
					]
				},
				{
					"id": 730150313,
					"content": "小瞧我可是要吃大亏的！哼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730150316,
					"content": "不过说回正事，我们是来治好法留纳神机的，这片「桓那」应该也有法留纳神机的「枝」和「叶」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730150317,
					"content": "兰般度让我们来看看情况，如果你遇到了困难，也好帮帮你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730150318,
					"content": "啊！很多坏家伙在桓那…有安全的路，但是要小心。而且到处都是坏种子，就连为了那菈法留纳而造的…呜呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150319
					],
					"speakerTitle": "兰那库拉"
				},
				{
					"id": 730150319,
					"content": "#那菈{NICKNAME}又高又大，说不定和兰百梨迦一样强…那菈{NICKNAME}，说不定有办法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150320
					],
					"speakerTitle": "兰那库拉"
				},
				{
					"id": 730150320,
					"content": "#…那菈{NICKNAME}，说不定能够帮忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150321
					],
					"speakerTitle": "兰那库拉"
				},
				{
					"id": 730150321,
					"content": "#我们本来就是来帮忙的呀，对吧，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150322
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730150322,
					"content": "交给我们吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150323
					]
				},
				{
					"id": 730150323,
					"content": "兰那库拉有别的请求，在治好法留纳神机以前…想要先去找回石头的记忆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150324
					],
					"speakerTitle": "兰那库拉"
				},
				{
					"id": 730150324,
					"content": "…「石头的记忆」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150325
					]
				},
				{
					"id": 730150325,
					"content": "桓那不会忘记，兰那罗不会忘记，但是兰那罗留下看得到的记忆。坏家伙来了以后，四处都是坏种子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150326
					],
					"speakerTitle": "兰那库拉"
				},
				{
					"id": 730150326,
					"content": "和兰那罗说话就像猜谜一样呢…不过，实际见到之后应该就明白了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150327
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730150327,
					"content": "总之，我们先和兰那库拉一起过去吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150328
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730150328,
					"content": "好那菈，好派蒙！我们不要惊动坏家伙，有安全的路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150329
					],
					"speakerTitle": "兰那库拉"
				},
				{
					"id": 730150329,
					"content": "欸？兰那库拉说的「坏家伙」应该就是蕈兽吧，那完全不用担心呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150330
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730150330,
					"content": "#哼哼，兰那库拉，你听好了，那菈{NICKNAME}可是很强的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150331
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730150331,
					"content": "而且不是一般的强！是非——常——强！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150332
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730150332,
					"content": "我们之前已经和兰般度一起打败了好多蕈兽呢！就连兰般度也认可了我们的实力！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150333
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730150333,
					"content": "#知道了，那菈{NICKNAME}一定和兰百梨迦一样厉害。可是派蒙呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150334
					],
					"speakerTitle": "兰那库拉"
				},
				{
					"id": 730150334,
					"content": "我？我怎么了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150335
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730150335,
					"content": "发生过这样的事…兰那库拉被坏家伙追赶，钻进了土里，但是被刨出来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150336
					],
					"speakerTitle": "兰那库拉"
				},
				{
					"id": 730150336,
					"content": "欸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150337
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730150337,
					"content": "坏家伙的大口里滴出来，湿的、热的，还有果实坏掉的味道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150338
					],
					"speakerTitle": "兰那库拉"
				},
				{
					"id": 730150338,
					"content": "呜哇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150339
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730150339,
