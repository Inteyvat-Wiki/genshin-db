					"孙宇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210360401,
					"content": "呼…呼…真是难以对付…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360402
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210360402,
					"content": "抱歉，让你见笑了。看来我还是没多少长进…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360403
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210360403,
					"content": "我还是需要多多锻炼…多谢了旅行者，这些报酬给你，请收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360404
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210360404,
					"content": "你要怎么离开璃月？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360405
					]
				},
				{
					"id": 210360405,
					"content": "唔…我现在打算的是，搭那位客商的船，从水路向外旅行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360406
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210360406,
					"content": "第一站…我想先去枫丹看看，然后在那里待一段时间，之后再做打算。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360407
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210360407,
					"content": "唉，也不知道我能不能说服师妹和我同行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孙宇"
				}
			]
		},
		{
