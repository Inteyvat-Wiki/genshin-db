					"nextDialogs": [
						210360803
					]
				},
				{
					"id": 210360803,
					"content": "甘拜下风…甘拜下风…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360806
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210360806,
					"content": "呼…总算是把气喘匀了。没想到「越野」居然这么累人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360807
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210360807,
					"content": "谢谢你给我做示范，旅行者，这些报酬请你收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210360804,
