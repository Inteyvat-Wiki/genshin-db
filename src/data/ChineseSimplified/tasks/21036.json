				"points": []
			},
			"dialogs": [
				{
					"id": 210360301,
					"content": "越野训练。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360302
					]
				},
				{
					"id": 210360302,
					"content": "那就太好了，那位冒险家帮我规划了一条越野路线…唉，我能进来这里锻炼，也是托了她的福。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360303
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210360303,
					"content": "她说我只要尽快到达终点就好…但我每次用的时间都实在太长…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360304
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210360304,
					"content": "所以，我想拜托你为我示范一下如何快速「越野」，我会在后面努力跟上的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360305,
						210360306
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210360305,
					"content": "没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360308
					]
				},
				{
					"id": 210360308,
					"content": "那就拜托你了，我们先去训练地点吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210360306,
					"content": "你可别被我甩远了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360307
					]
				},
				{
					"id": 210360307,
					"content": "咳…我…我努力跟上，但说实话，我的脚力实在是有限啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360308
					],
					"speakerTitle": "孙宇"
				}
			]
		},
		{
