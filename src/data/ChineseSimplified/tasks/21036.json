			"dialogs": [
				{
					"id": 210360201,
					"content": "对抗敌人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360202
					]
				},
				{
					"id": 210360202,
					"content": "好！我早就想要把我学习的剑术用在实处了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360203
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210360203,
					"content": "只怕你看不清我的动作。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360204
					]
				},
				{
					"id": 210360204,
					"content": "这…阁下武艺竟如此高强？哈哈哈，那就只能请阁下把动作稍稍放慢些啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360205
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210360205,
					"content": "我看看…附近就有一处魔物的聚集地，咱们就先去那里好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孙宇"
				}
			]
		},
		{
			"id": 2103603,
			"completionStepIds": [
				2103601,
				2103606
