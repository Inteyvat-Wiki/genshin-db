			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"孙宇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210360601,
					"content": "旅行者，我们又见面了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360602,
						210360604
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210360602,
					"content": "你还在锻炼吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360603
					]
				},
				{
					"id": 210360603,
					"content": "是的，只不过…实在是有些辛苦。也不知道我是真的实力不济，还是用错了锻炼方法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360608
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210360608,
					"content": "先不说这些了。上次和你同行时，你的招式和动作都给了我很大启发。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360609
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210360609,
					"content": "旅行者，请你今天再陪我出去锻炼一次吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360610,
						210360611
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210360610,
					"content": "你之前在这里锻炼过？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360613
					]
				},
				{
					"id": 210360613,
					"content": "还好我偶然遇见了一位好心的冒险家，她愿意帮我一把，以「一同执行协会委托」为理由把我带进这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360614
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210360614,
					"content": "她还帮我规划锻炼计划，给我各种建议…但同时，我也得和她一起处理各种冒险家协会的委托。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360615
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210360615,
					"content": "咳，我们还是先说正事吧，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360616
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210360616,
					"content": "是这样，我初步给自己拟定了一个训练的计划，其中包括了「对抗敌人」和「越野训练」两项。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360617
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210360617,
					"content": "旅行者，你看你方便陪我进行哪一项训练？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210360611,
					"content": "你居然能到这里锻炼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360612
					]
				},
				{
					"id": 210360612,
					"content": "唉，说来惭愧。我听说此处地势颇险，魔物众多，觉得很适合作为锻炼的场所。但没想到，这里却不是那么容易进来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360613
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210360604,
					"content": "你师妹还不理你？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360605
					]
				},
				{
					"id": 210360605,
					"content": "咳…师妹她…最近总是说城里有事要处理，一直也没回来过…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360606
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210360606,
					"content": "我去找她说过几次，但她都只是让芷若出来挡住我，始终也不肯见我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360607
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210360607,
					"content": "唉，我也不知道怎么劝好她…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360615
					],
					"speakerTitle": "孙宇"
				}
			]
		},
