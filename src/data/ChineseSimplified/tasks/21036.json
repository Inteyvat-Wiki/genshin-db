			},
			"dialogs": [
				{
					"id": 210360101,
					"content": "旅行者，我们又见面了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360102,
						210360104
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210360102,
					"content": "你还在锻炼吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360103
					]
				},
				{
					"id": 210360103,
					"content": "是的，只不过…实在是有些辛苦。也不知道我是真的实力不济，还是用错了锻炼方法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360108
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210360108,
					"content": "先不说这些了。上次和你同行时，你的招式和动作都给了我很大启发。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360109
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210360109,
					"content": "旅行者，请你今天再陪我出去锻炼一次吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360110
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210360110,
					"content": "还是和上次一样，「对抗敌人」和「越野训练」两项，你方便陪我进行哪项锻炼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210360104,
					"content": "你师妹还不理你？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360105
					]
				},
				{
					"id": 210360105,
					"content": "咳…师妹她…最近总是说城里有事要处理，一直也没回来过…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360106
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210360106,
					"content": "我去找她说过几次，但她都只是让芷若出来挡住我，始终也不肯见我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360107
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210360107,
					"content": "唉，我也不知道怎么劝好她…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360108
					],
					"speakerTitle": "孙宇"
				}
			]
		},
