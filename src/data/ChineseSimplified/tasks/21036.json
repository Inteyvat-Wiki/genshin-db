			"dialogs": [
				{
					"id": 210360701,
					"content": "呼…呼…真是难以对付…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360702
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210360702,
					"content": "抱歉，让你见笑了。没想到正式对敌时，我会这么紧张…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360703
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210360703,
					"content": "总之我…我还是需要多多锻炼。多谢了旅行者，这些报酬给你，请收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360704
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210360704,
					"content": "你真的要离开璃月？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360705
					]
				},
				{
					"id": 210360705,
					"content": "我还没有完全想好，我还得再想想，顺便…再尝试说服一下师妹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
