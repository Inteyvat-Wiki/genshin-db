					"孙宇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210360501,
					"content": "呼…呼…呼…你怎么…怎么能跑得这么快…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360502,
						210360504
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210360502,
					"content": "是你跑得太慢了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360503
					]
				},
				{
					"id": 210360503,
					"content": "甘拜下风…甘拜下风…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360506
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210360506,
					"content": "谢谢你给我做示范，旅行者，这些报酬请你收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360507,
						210360510
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210360507,
					"content": "关于小雀儿…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360508
					]
				},
				{
					"id": 210360508,
					"content": "师妹她…唉，依然不肯理我。我，我也不知怎么劝她…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360509
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210360509,
					"content": "唉…此事，怎么会如此难以两全…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210360510,
					"content": "关于那位冒险家…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360511
					]
				},
				{
					"id": 210360511,
					"content": "她？呃…我是在冒险家协会遇见她的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360512
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210360512,
					"content": "她说自己接受了协会的委托，来层岩巨渊这里办事，听说我想进来，就把我顺便带上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360513
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210360513,
					"content": "不过作为交换…我得帮她一起执行委托，不过大部分都是寻物的委托，倒也不繁重。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360514
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210360514,
					"content": "只是她…实在太爱说话了，我实在是不擅应付啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210360504,
					"content": "你还得多多锻炼啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360505
					]
				},
				{
					"id": 210360505,
					"content": "你说得…说得对…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360506
					],
					"speakerTitle": "孙宇"
				}
			]
		},
