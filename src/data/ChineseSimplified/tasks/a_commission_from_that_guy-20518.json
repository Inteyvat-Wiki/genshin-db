			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"薇尔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205180201,
					"content": "你回来了，哎呀，效率可真高，我也算是知道为什么那位先生这么喜欢你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180202,
						205180204
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 205180202,
					"content": "报酬拿来。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180203
					]
				},
				{
					"id": 205180203,
					"content": "冷冰冰的…好啦，我这就把报酬给你。你就理解我一下嘛，我也只是个跑腿的人而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "薇尔"
				},
				{
					"id": 205180204,
					"content": "那真是谢谢厚爱了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180205
					]
				},
				{
					"id": 205180205,
					"content": "不客气，不客气，这些报酬请拿好，还有…合作愉快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "薇尔"
				}
			]
		},
		{
