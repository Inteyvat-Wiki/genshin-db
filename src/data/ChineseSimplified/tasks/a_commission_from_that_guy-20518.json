			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"霍夫曼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205180301,
					"content": "这帮盗宝团…继续藏吧，千万别让我知道…你们到底藏在哪了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180302
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 205180302,
					"content": "我知道盗宝团藏在哪。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180303
					]
				},
				{
					"id": 205180303,
					"content": "您？您怎么…咦，这份地图上的标记真详细…你是从哪拿到的？薇尔？居然是她…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180304
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 205180304,
					"content": "…居然和我们之前确定的地点相距这么远，这群盗宝团的目标到底是什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180305
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 205180305,
					"content": "抱歉，请让我记一下…好了，我知道了，我们会马上派人去核实，如果情况属实的话，我们马上就会前往击退他们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180306
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 205180306,
					"content": "再次感谢您！谢谢您为蒙德城做出的贡献！这些盗宝团，这次绝对跑不了了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "霍夫曼"
				}
			]
		},
		{
			"id": 2051804,
			"completionStepIds": [
				2051806
			],
