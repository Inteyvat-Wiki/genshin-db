				"objectNames": [
					"薇尔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205180501,
					"content": "你还在做准备吗？嗯，做好准备再出发吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180502,
						205180506
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 205180502,
					"content": "那位先生到底是谁？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180503
					]
				},
				{
					"id": 205180503,
					"content": "无论你怎么追问，我都不会告诉你的啦，这可是干我们这行的基本素质。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180504
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 205180504,
					"content": "即便是透露…那些所透露的消息，也是因为「需要被透露」而被透露的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180505
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 205180505,
					"content": "啊，对了，你可以再想一想，我以上所说的话，又有哪些是属于「需要被透露」的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "薇尔"
				},
				{
					"id": 205180506,
					"content": "你们到底是什么目的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180507
					]
				},
				{
					"id": 205180507,
					"content": "目的…那位先生的目的，我可猜不到。不过，想必他也是为了保护这座蒙德城吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180508
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 205180508,
					"content": "唔…应该是，在这种大事上，他应该也不会再遵从着他的「趣味」而行动了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180509
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 205180509,
					"content": "哦呀，不好不好，这种事情可不是我应该揣测的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "薇尔"
				}
			]
		},
