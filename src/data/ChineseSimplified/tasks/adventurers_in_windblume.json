						700100702
					]
				},
				{
					"id": 700100702,
					"content": "你回来了，怎么去了这么久，是不是那小子又让你去做什么多余的事了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100703
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 700100703,
					"content": "帮塞琉斯先生打听了一下消息…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100704
					]
				},
				{
					"id": 700100704,
					"content": "这小子又在搞什么…嗯？这封信是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100705
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 700100705,
					"content": "这封信里写着协会的近况。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100706
					]
				},
				{
					"id": 700100706,
					"content": "我知道了。居然这么厚，看来…他确实做了很多事，居然风花节也没休息…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100707
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 700100707,
					"content": "不过，既然他都这么努力了，蒙德城冒险家协会肯定能招到很多新人吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100708
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 700100708,
					"content": "等有了足够的新人，那小子说不定也能从那些琐事里抽身，再次和我一起去探险了…嗯，这样也挺不错的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100709
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 700100709,
					"content": "我会好好看这封信的。但你被那小子差使了多余的事，我也得给你多算点报酬才是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100710
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 700100710,
					"content": "这是报酬，收下吧，这一趟辛苦你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玉霞"
				}
			]
		},
