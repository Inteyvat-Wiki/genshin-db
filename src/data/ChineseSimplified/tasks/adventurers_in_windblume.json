			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"玉霞"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700100101,
					"content": "关于委托…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100102
					]
				},
				{
					"id": 700100102,
					"content": "你是看见了我的委托之后过来的吗？嗯，我确实有一些事想让你帮忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100103
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 700100103,
					"content": "具体地说，我是想拜托你帮我去雪山里跑一趟，给两个地方留个影，具体地点我会在地图上给你标记出来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100104
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 700100104,
					"content": "报酬的话，当然也会按照冒险家协会的规矩付给你一个合理的价钱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100105
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 700100105,
					"content": "怎么样？你意下如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100106
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 700100106,
					"content": "为什么要在这两个地方留影？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100107
					]
				},
				{
					"id": 700100107,
					"content": "嗯…这件事说到底，也和塞琉斯那小子有关。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100108
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 700100108,
					"content": "他上次拜托我，要我弄点雪山的特产给他，他要用这些东西做做协会的招新宣传，他要在风花节用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100109
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 700100109,
					"content": "这已经是风花节了，但塞琉斯那小子不知道是不是也忙着过风花节，最近一直没联系我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100110
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 700100110,
					"content": "唔…这么一想，他确实也到了那个年纪了，确实该忙着过风花节呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100111
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 700100111,
					"content": "他应该已经超出那个年纪很多了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100112
					]
				},
				{
					"id": 700100112,
					"content": "是吗？我倒是没什么感觉，总感觉…呃，算了，不说这个了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100113
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 700100113,
					"content": "我已经搜集了些矿石，还整理了几本地形图和魔物记录，还想要给雪山里的好景色留个影。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100114
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 700100114,
					"content": "旅行者，能请你帮我去雪山里跑一趟，给那两个地方留个影吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100115
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 700100115,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100116
					]
				},
				{
					"id": 700100116,
					"content": "嗯，那就拜托你了。我已经把那两个地方给你标注在地图上了，直接过去就行，搞定了之后，就回来找我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100117
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 700100117,
					"content": "你不回去看看吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100118
					]
				},
				{
					"id": 700100118,
					"content": "城里的气氛太热烈了，我可有点受不了，对我来说，待在这里反而会更舒服一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100119
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 700100119,
					"content": "而且我在这里还有很多事要做，暂时就不回去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100120
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 700100120,
					"content": "我已经把最佳取景点给你标注在地图上了，直接过去就行，搞定了之后，就回来找我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玉霞"
				}
			]
		},
		{
			"id": 7001002,
			"completionStepIds": [
				7001008
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7001008",
