				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700100501,
					"content": "嗯？你有事吗？我正想开始弹唱呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100502
					],
					"speakerTitle": "海伦"
				},
				{
					"id": 700100502,
					"content": "关于冒险家协会的招募…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100503
					]
				},
				{
					"id": 700100503,
					"content": "那个啊，我看见过告示。不过我可对那个没有兴趣，再说了，我不用加入冒险家协会，光用歌声就能守护蒙德了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100504
					],
					"speakerTitle": "海伦"
				},
				{
					"id": 700100504,
					"content": "而且就算是加入冒险家协会，大部分情况下也是在做杂活吧，这可对我没什么帮助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100505
					],
					"speakerTitle": "海伦"
				},
				{
					"id": 700100505,
					"content": "所以，我对冒险家协会也没什么兴趣，谢谢你特意来问我，抱歉啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100506
					],
					"speakerTitle": "海伦"
				},
				{
					"id": 700100506,
					"content": "这是相关的招募资料。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100507
					]
				},
				{
					"id": 700100507,
					"content": "咦？这是雪山吧，这尊雪中的七天神像还挺有…意境的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100508
					],
					"speakerTitle": "海伦"
				},
				{
					"id": 700100508,
					"content": "对了，这里是不是很高？我听人家说，雪山是很高的，要是在那里弹唱的话，声音肯定能传得更远吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100509
					],
					"speakerTitle": "海伦"
				},
				{
					"id": 700100509,
					"content": "我等会去冒险家协会问问好了，我记得，那边好像能雇佣冒险家来着…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100510
					],
					"speakerTitle": "海伦"
				},
				{
					"id": 700100510,
					"content": "不过，冒险家居然能到这里地方去，感觉还挺有趣的嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "海伦"
				}
			]
		},
