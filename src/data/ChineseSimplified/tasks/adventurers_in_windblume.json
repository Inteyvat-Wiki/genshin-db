					"六指乔瑟"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700100401,
					"content": "嘿，朋友你好！愿意听听我的新作吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100402
					],
					"speakerTitle": "六指乔瑟"
				},
				{
					"id": 700100402,
					"content": "关于冒险家协会的招募…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100403
					]
				},
				{
					"id": 700100403,
					"content": "冒险家协会的招募？抱歉，我对这个不太感兴趣，到处东奔西跑可对写诗没有帮助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100404
					],
					"speakerTitle": "六指乔瑟"
				},
				{
					"id": 700100404,
					"content": "而且，在这座蒙德城里，就算要谱写史诗…当然也是以骑士团为蓝本最好啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100405
					],
					"speakerTitle": "六指乔瑟"
				},
				{
					"id": 700100405,
					"content": "抱歉，我对冒险家协会的招募不感兴趣，成为一名帮人家抓猫的冒险家，对于写诗可没什么帮助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100406
					],
					"speakerTitle": "六指乔瑟"
				},
				{
					"id": 700100406,
					"content": "这是相关的招募资料。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100407
					]
				},
				{
					"id": 700100407,
					"content": "这是…雪山里的景色吗？这看着倒还真不错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100408
					],
					"speakerTitle": "六指乔瑟"
				},
				{
					"id": 700100408,
					"content": "如果能在这种地方游览一番，我说不定就能找到新灵感。而且这周围看着，似乎也不太危险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100409
					],
					"speakerTitle": "六指乔瑟"
				},
				{
					"id": 700100409,
					"content": "嗯…我等会去冒险家协会问问吧，就算不加入协会，雇佣一位冒险家陪我去那边看看也行啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100410
					],
					"speakerTitle": "六指乔瑟"
				},
				{
					"id": 700100410,
					"content": "游览雪山…感觉上应该还不错啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "六指乔瑟"
				}
			]
		},
