			"dialogs": [
				{
					"id": 700100601,
					"content": "怎么样，你已经问过大家的意见了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100602
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 700100602,
					"content": "问到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100603
					]
				},
				{
					"id": 700100603,
					"content": "你看我说什么来着…总之情况就是这么个情况，我早就习惯了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100604
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 700100604,
					"content": "唉，不管是什么方法，只要能够奏效我就谢天谢地了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100605
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 700100605,
					"content": "你等会是要回去雪山那边，向玉霞回报委托的情况吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100606
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 700100606,
					"content": "那你顺便帮我把这封信带给她吧，她肯定也想知道协会最近的情况，拜托你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100607
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 700100607,
					"content": "唉，希望这次能招到新人…不过这样子招过来的新人，真的能成为靠谱的冒险家吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "塞琉斯"
				}
			]
		},
