			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"玉霞"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700100201,
					"content": "关于委托…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100202
					]
				},
				{
					"id": 700100202,
					"content": "怎么，你已经把事情搞定了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100203
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 700100203,
					"content": "都搞定了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100204
					]
				},
				{
					"id": 700100204,
					"content": "辛苦了。我也已经把要送给那小子的东西包好了，请你再帮我跑一趟吧，把东西送过去之后，记得再回来，我会把报酬结给你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100205
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 700100205,
					"content": "虽然不知道这些东西够不够用，但如果是要招募新人的话，魔物记录和矿石肯定最有吸引力吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玉霞"
				}
			]
		},
		{
			"id": 7001003,
			"completionStepIds": [
				7001009
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7001009",
							"2"
						],
						"stepId": 7001009,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"塞琉斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700100301,
					"content": "唉，这个招募计划看起来没什么用啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100302
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 700100302,
					"content": "关于玉霞送过来的东西…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100303
					]
				},
				{
					"id": 700100303,
					"content": "呃，她送给我东西？哦对…我上次拜托她来着，我自己都忙忘了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100304
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 700100304,
					"content": "你真在忙着过风花节吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100305
					]
				},
				{
					"id": 700100305,
					"content": "风花节？我可没时间，之前那版招募计划里的方法已经没用了，我正忙着制订全新的招募计划…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100306
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 700100306,
					"content": "我先看看玉霞给我寄来什么了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100307
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 700100307,
					"content": "矿石…没用没用…现在没有年轻人喜欢这个…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100308
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 700100308,
					"content": "地形图…唉，这个给协会里的人用用还行，用来招新的话，估计没人会看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100309
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 700100309,
					"content": "魔物调查笔记…这个也应该给协会里的冒险家抄几份…用来招新就算了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100310
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 700100310,
					"content": "哦？还有这两张图，这两张图看着还不错，景色又好，看着也很安全，肯定有人会感兴趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100311
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 700100311,
					"content": "为什么要选这个？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100312
					]
				},
				{
					"id": 700100312,
					"content": "感觉和冒险家有关的东西，反而被剔出去了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700100313,
					"content": "你是不知道现在协会里的现状，现在的年轻人，对什么魔物啦，矿石啦，地形图啦已经没兴趣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100314
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 700100314,
					"content": "想要吸引他们的注意力，必须要用一些更加…「现实」的东西才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100315
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 700100315,
					"content": "现在正值风花节，年轻人们肯定都想着，用一个不那么寻常，但又不那么危险的方式展示自己的魅力…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100316
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 700100316,
					"content": "进入雪山探险，就是这样一个方式，只要有人对此感兴趣，就可能来协会询问相关事宜，也就有可能加入协会…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100317
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 700100317,
					"content": "呃…就算他们这样也不想加入协会，那…那给我们一些委托也好啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100319
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 700100319,
					"content": "而且你看这两张画的位置，都在大路旁边，只要小心谨慎，一般都不会遇见危险…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100320
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 700100320,
					"content": "已经要用这种方式了吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100321
					]
				},
				{
					"id": 700100321,
					"content": "但这就是现状，要不是真没办法了，我也不会想出这种主意来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100322
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 700100322,
					"content": "唔，要是你还是不相信，那你就拿上这两张画片，去找周围的人问问吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100323
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 700100323,
					"content": "你先和他们说冒险家协会招募的事，然后再拿出这两张画片，就说是「招募资料」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100324
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 700100324,
					"content": "然后，你就知道我为什么会想出这种主意了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "塞琉斯"
				}
			]
		},
		{
