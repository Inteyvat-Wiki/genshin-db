			"dialogs": [
				{
					"id": 752570701,
					"content": "哎呀，总算是忙完了。两位客人，多亏有你们帮忙，不然我可能要被投诉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570702
					],
					"speakerTitle": "伊斯特莉"
				},
				{
					"id": 752570702,
					"content": "不用客气，嘿嘿，我们可是最热心的冒险家。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752570703
					]
				},
				{
					"id": 752570703,
					"content": "冒险家吗？那不如我来给你们留一张影吧？把你们热心的身姿记录下来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570704
					],
					"speakerTitle": "伊斯特莉"
				},
				{
					"id": 752570704,
					"content": "来，笑一笑！悠悠纳塔，悠悠夏天！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570705
					],
					"speakerTitle": "伊斯特莉"
				},
				{
					"id": 752570705,
					"content": "谢谢你们，这些也请收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊斯特莉"
				}
			]
		},
