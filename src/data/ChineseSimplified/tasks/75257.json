			"dialogs": [
				{
					"id": 752570301,
					"content": "上一场拍得很好，下面是这位愚人众的大哥，您想拍点什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570302
					],
					"speakerTitle": "伊斯特莉"
				},
				{
					"id": 752570302,
					"content": "请把我拍成神枪手的样子，一看就是百发百中的那种。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570303
					],
					"speakerTitle": "韦涅季克特"
				},
				{
					"id": 752570303,
					"content": "这样我就不用为连队的射击比赛排名倒数而烦恼了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570304
					],
					"speakerTitle": "韦涅季克特"
				},
				{
					"id": 752570304,
					"content": "没问题，那我们开始吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊斯特莉"
				}
			]
		},
