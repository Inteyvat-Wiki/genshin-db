			"dialogs": [
				{
					"id": 752570101,
					"content": "年轻人啊，这场地不是好好的吗？为什么不能营业？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570102
					],
					"speakerTitle": "苏玛"
				},
				{
					"id": 752570102,
					"content": "真抱歉，客人，本项目的造景助手昨晚喝多了，今天没法来上班，请明天再来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570103
					],
					"speakerTitle": "伊斯特莉"
				},
				{
					"id": 752570103,
					"content": "老婆子我年纪大了，明天再走这么远的路过来可能吃不消咯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570104
					],
					"speakerTitle": "苏玛"
				},
				{
					"id": 752570104,
					"content": "没错，大家明天也有别的安排。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570105
					],
					"speakerTitle": "因提"
				},
				{
					"id": 752570105,
					"content": "对不起，我们「夏日留影角」的特色就是可以为客人搭建心仪的留影背景。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570106
					],
					"speakerTitle": "伊斯特莉"
				},
				{
					"id": 752570106,
					"content": "现在造景助手不在，实在没法进行下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570107
					],
					"speakerTitle": "伊斯特莉"
				},
				{
					"id": 752570107,
					"content": "需要帮忙吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752570108
					]
				},
				{
					"id": 752570108,
					"content": "欸？你们两位愿意来帮忙吗？我真的很需要。内容也不复杂，只要按照各位客人的要求布置留影的背景就可以了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊斯特莉"
				}
			]
		},
		{
			"id": 7525702,
			"completionStepIds": [
				7525701
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
