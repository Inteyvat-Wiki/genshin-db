			"trigger": {
				"objectNames": [
					"伊斯特莉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752570201,
					"content": "听上去挺有趣的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752570202
					]
				},
				{
					"id": 752570202,
					"content": "太好了！那么几位客人，谁先来？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570203
					],
					"speakerTitle": "伊斯特莉"
				},
				{
					"id": 752570203,
					"content": "本人建议，女士优先。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570204
					],
					"speakerTitle": "因提"
				},
				{
					"id": 752570204,
					"content": "没意见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570205
					],
					"speakerTitle": "韦涅季克特"
				},
				{
					"id": 752570205,
					"content": "哎呀，多么绅士的小伙子啊，我就想和你们这种年轻人合影。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570206
					],
					"speakerTitle": "苏玛"
				},
				{
					"id": 752570206,
					"content": "欸？也…也不是不行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570207
					],
					"speakerTitle": "因提"
				},
				{
					"id": 752570207,
					"content": "咳咳，没意见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570208
					],
					"speakerTitle": "韦涅季克特"
				},
				{
					"id": 752570208,
					"content": "嗯…不，还不够，再来三个小伙子吧，应该可以办到吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570209
					],
					"speakerTitle": "苏玛"
				},
				{
					"id": 752570209,
					"content": "唔…最好还能来点烟花，我年轻的时候，最喜欢那样的氛围了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570210
					],
					"speakerTitle": "苏玛"
				},
				{
					"id": 752570210,
					"content": "没问题，那我们开始吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊斯特莉"
				}
			]
		},
