			"dialogs": [
				{
					"id": 752570801,
					"content": "上一场拍得很好，最后是这位翩翩公子，您想拍点什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570802
					],
					"speakerTitle": "伊斯特莉"
				},
				{
					"id": 752570802,
					"content": "说得不错，本人出生至今，向来将仪态与气质放在人生的首要位置。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570803
					],
					"speakerTitle": "因提"
				},
				{
					"id": 752570803,
					"content": "人无仪态，则不优雅；无气质，则不富贵。懂我的要求吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570804
					],
					"speakerTitle": "因提"
				},
				{
					"id": 752570804,
					"content": "唔…让我思考思考…嗯，我们开始吧！",
					"roleType": "TALK_ROLE_NPC",
