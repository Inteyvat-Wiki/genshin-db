					"露子",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722330301,
					"content": "接下来就是解封之刻了，请你拿好之前的「月浴渊之钥」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330302
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330302,
					"content": "你再说一遍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722330303,
					"content": "「月浴渊之钥」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330304
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330304,
					"content": "你再说三遍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722330305,
					"content": "「月浴渊之钥」、「月浴渊之钥」、「哕浴腌之浴」…切，咬舌头了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330306
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330306,
					"content": "所以你们这个命名肯定有问题啊。改个名字吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722330307,
					"content": "就算要改也是几百年后的人受益啦。这次你就忍一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330308
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330308,
					"content": "咳咳，总、总之，我就要施行仪式了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330309
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330309,
					"content": "十分可惜，我们并没有渊下宫试炼的具体细节，接下来您只能依赖自己了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330310
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330310,
					"content": "这种保持神秘感的传统真是坏东西。所以我也只能祝您好运了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330311
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330311,
					"content": "另外，请您千万不要逞强。您的安全是最重要的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "露子"
				}
			]
		},
