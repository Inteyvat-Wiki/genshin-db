						722330502
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330502,
					"content": "关于白夜国…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330503
					]
				},
				{
					"id": 722330503,
					"content": "渊下宫曾经的名字就叫做白夜国。因为地下之国并无日月，只有白夜和常夜两种天象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330504
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330504,
					"content": "我的家系之中曾有一位名叫乌帽子的巫女，在白夜国历史里也算个人物，所以才让我负责「海祇御灵祭」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "露子"
				}
			]
		}
	]
}