			"dialogs": [
				{
					"id": 722330401,
					"content": "#{NICKNAME}，还有什么想问的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330402,
						722330406
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330402,
					"content": "关于键纹…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330403
					]
				},
				{
					"id": 722330403,
					"content": "键纹被我们放在了「海神之鳍」与「海神之心」处。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330404
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330404,
					"content": "其实我们也就是就近移开了一点。毕竟两处海神之伤也还算是比较隐秘的地方了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330405
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330405,
					"content": "尽力了，真的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "露子"
				},
				{
					"id": 722330406,
					"content": "关于祭坛…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330407
					]
				},
				{
					"id": 722330407,
					"content": "祭坛在北方和正东边。就在下面月浴渊的第二重山之垣上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330408
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330408,
					"content": "如果你从珊瑚宫到「海神之鳍」与「海神之心」连两条线…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330409
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330409,
					"content": "再和二重垣的弧线取两个交点。就是这两处啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "露子"
				}
			]
		},
