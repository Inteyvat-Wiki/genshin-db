				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722330101,
					"content": "#{NICKNAME}，你们好啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330102
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330102,
					"content": "露子小姐，取珊瑚的事情准备的怎么样了啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722330103,
					"content": "哎呀，这不是又遇到了难处嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330104
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330104,
					"content": "虽然露子小姐你看起来悲伤地低下了头…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722330105,
					"content": "但这样不停地给我们使眼色，未免也太露骨了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722330106,
					"content": "呜，果然你们也发现了情况危急。那我也不隐瞒了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330107
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330107,
					"content": "你根本就没想隐瞒吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722330108,
					"content": "之前虽然初步取得了「月浴渊之钥」，渊下宫正在缓慢苏醒。但是因为人手不足的原因，调查推进还是很慢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330109
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330109,
					"content": "毕竟最近还是特殊时期嘛，和鸣神岛的关系不知能不能缓和。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330110
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330110,
					"content": "那，多我一个也不多…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330111
					]
				},
				{
					"id": 722330111,
					"content": "那可不一样哦。要知道根据传统，取珊瑚最需要的人，就是「勇者」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330112
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330112,
					"content": "先建立根据地，然后协助「勇者」沿着先人足迹探索，最后迎来试炼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330113
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330113,
					"content": "所谓稳扎稳打的策略就是这样了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330114
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330114,
					"content": "但是因为最近人手不足，所以没办法探索咯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722330115,
					"content": "正是如此，最关键的「勇者」现在连根头发丝都看不到呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330116
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330116,
					"content": "现在好像看到了。似乎是一缕…一缕金发！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330117
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330117,
					"content": "呜啊，听起来好麻烦的样子。根本不想趟这趟水。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722330118,
					"content": "不过探索通常都会发现一些奇珍异宝。按照惯例，拿到了都是要上缴珊瑚宫家的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330119
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330119,
					"content": "如果这次你下去找到点什么的话，咱们睁一只眼闭一只眼也不是不可以…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330120,
						722330121
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330120,
					"content": "要不两只眼一起闭上吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330122
					]
				},
				{
					"id": 722330122,
					"content": "英雄，大侠，好汉，救世主！这么说您是同意咯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330123
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330123,
					"content": "我们怎么能对珊瑚宫的危险视而不见呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722330124,
					"content": "您这么说是最好不过了。看来按照心海大人教的话术，确实能哄到人啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330125
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330125,
					"content": "珊瑚宫大人甚至连你们会回来找我也预料到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330126
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330126,
					"content": "你说什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722330127,
					"content": "没什么没什么。那么请随我来，我来向您展示一个东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330128
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330128,
					"content": "我们就在前方下面的祭台那里见面吧。如果你看不到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330129
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330129,
					"content": "如果看不到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722330130,
					"content": "就在东南方向，眯起眼睛看就看到啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "露子"
				},
				{
					"id": 722330121,
					"content": "我和心海大人关系很好的！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330122
					]
				}
			]
		},
		{
			"id": 7223302,
			"completionStepIds": [
				7223303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7223302",
							"3"
						],
						"stepId": 7223302,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7223303",
							"2"
						],
						"stepId": 7223303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"露子",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722330201,
					"content": "这个叫做「键纹」，是曾经渊下宫的通行纹章。只有当通路打开之时，它才会在地上浮现。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330202
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330202,
					"content": "据说是渊下宫苏醒之时，为海祇岛之民递送的另一组钥匙。而这种键纹在珊瑚宫的记载里，一共有五种。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330203
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330203,
					"content": "目前我们在海祇岛找到了其中的三种。如此操作之后就可以将其归位，解开封禁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330204
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330204,
					"content": "我们之前特地将这三个从键纹孔上拔了下来，并且放置到了海祇岛的其他地方。这样可以让屏障重新生效。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330205
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330205,
					"content": "就是为了防止不懂事的熊孩子帮、愚人众间谍、鸣神岛居民和外乡人之类的家伙，偷偷潜下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330206
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330206,
					"content": "哦，外乡人当然不包括您啦。哈哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330207
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330207,
					"content": "现阶段没有办法和冒险家协会取得联系，所以冒险家都不给放下去哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330208
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330208,
					"content": "你们还会放冒险家下去的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722330209,
					"content": "历史上有这样的记录啦，合作共赢嘛。毕竟探索是他们和您的强项。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330210
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330210,
					"content": "哦豁，也就是说这次没有别人抢跑的意思吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722330211,
					"content": "注意点吃相…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330212
					]
				},
				{
					"id": 722330212,
					"content": "这怎么说呢…这种临时保护屏障挺不可靠的。因为从调查键纹位置到取出键纹的时间用得太久了，期间可能溜下去过几个人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330213
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330213,
					"content": "毕竟人手不够嘛…所以您在下面如果遇到愚人众、盗宝团、海乱鬼之类的，请毫不犹豫地把他们教训一顿吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330214
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330214,
					"content": "如果他们这么容易就下去了，那之前我们拿到的月什么钥是为了什么啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722330215,
					"content": "只有取走「月浴渊之钥」，渊下宫才会转醒。同时只有用「月浴渊之钥」开门，试炼系统才会运作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330216
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330216,
					"content": "如果不是为了海祇御灵祭前往渊下宫，或许确实可以靠着外道邪法溜进去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330217
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330217,
					"content": "所以就希望你们能尽快动身，请去将海祇岛其他「键纹」取回吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330218
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330218,
					"content": "键纹被我们放在了「海神之鳍」与「海神之心」处。而两座祭坛则在它们与珊瑚宫的连线里，坐落于月浴渊的第二重山垣上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330219
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330219,
					"content": "那么我就回到老地方静候您的消息了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "露子"
				}
			]
		},
		{
			"id": 7223303,
			"completionStepIds": [
				7223308
			],
