			"dialogs": [
				{
					"id": 4630001,
					"content": "这下谜团都解开啦，真是花了很多功夫呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630014
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630014,
					"content": "不过话说回来，这张藏宝图画的还真是潦草呢…确实像是出自海盗之手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630002
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630002,
					"content": "那么现在…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630003,
						4630005
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630003,
					"content": "先去向凯亚汇报一下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630004
					]
				},
				{
					"id": 4630004,
					"content": "嗯…？派蒙觉得，不，需，要，哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630006
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630006,
					"content": "不愧是派蒙的伙伴！和派蒙想的…完，全，一，样！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630007
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630007,
					"content": "不直接过去的话，万一被别人抢先可就麻烦啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630008
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630008,
					"content": "比如凯亚…嗯，凯亚说过的「盗宝团」之类的家伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630009
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630009,
					"content": "总之，我最多只是想借来那把剑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630010
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630010,
					"content": "不、不，只是想去看一眼而已！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630011
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630011,
					"content": "绝不是想着什么天下无敌、高枕无忧吃喝玩乐…之类的事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630012
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630012,
					"content": "好了，闲话就等到找到宝藏以后再说吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630013
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630013,
					"content": "阿卡狄亚寻宝之旅——正式启程！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630005,
					"content": "直奔藏宝地点吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630006
					]
				}
			]
		},
