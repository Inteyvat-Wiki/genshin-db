			"dialogs": [
				{
					"id": 4630301,
					"content": "呼…这里就是尽头了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630302,
					"content": "宝藏~宝藏~藏在哪里呀~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630303,
					"content": "#{NICKNAME}，一起在附近找找吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630304,
					"content": "哈哈哈…这就不用麻烦你们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630305
					],
					"speakerTitle": "???"
				},
				{
					"id": 4630305,
					"content": "剩下的，由我来接手就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630306,
						4630308
					],
					"speakerTitle": "???"
				},
				{
					"id": 4630306,
					"content": "盗宝团的人？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630307
					]
				},
				{
					"id": 4630307,
					"content": "真是机灵，不过现在才发现是不是有点太晚了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630311
					],
					"speakerTitle": "???"
				},
				{
					"id": 4630311,
					"content": "你们好，我是伊扎德。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630312
					],
					"speakerTitle": "伊扎德"
				},
				{
					"id": 4630312,
					"content": "替盗宝团说声谢谢吧，感谢两位好心人为我带路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630313
					],
					"speakerTitle": "伊扎德"
				},
				{
					"id": 4630313,
					"content": "唔啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630314,
					"content": "真是奇怪，我们明明一直都在暗中行动，宝藏的秘密是怎么泄露的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630315,
					"content": "我倒是完全不觉得奇怪。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630316
					]
				},
				{
					"id": 4630316,
					"content": "哼！我可不会甘心的。喂，盗宝贼！你以为我们不会反抗吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630317,
					"content": "你要是这么瞧不起我们的实力，一会就别太吃惊了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630318
					],
					"speakerTitle": "伊扎德"
				},
				{
					"id": 4630318,
					"content": "只要我一声令下，外面埋伏的兄弟们就会来和你们打招呼了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630319
					],
					"speakerTitle": "伊扎德"
				},
				{
					"id": 4630319,
					"content": "可惜啊，他们不会像我这么好说话的，哈哈哈哈……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630320
					],
					"speakerTitle": "伊扎德"
				},
				{
					"id": 4630320,
					"content": "（凯亚和西风骑士登场）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630321
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4630321,
					"content": "在阁下这么开心的时候来打搅，真是不好意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630322
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4630322,
					"content": "至于你的那些兄弟嘛，他们已经没法回应你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630323
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4630323,
					"content": "恐怕你…只能去蒙德的监狱里探访他们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630324
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4630324,
					"content": "或者，与他们做个狱友，也不错吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630325
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4630325,
					"content": "骑士团的人…？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630326
					],
					"speakerTitle": "伊扎德"
				},
				{
					"id": 4630326,
					"content": "哇，是凯亚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630327
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630327,
					"content": "——凯亚，他在打你的宝藏的主意！快点把他抓起来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630328
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630328,
					"content": "嘁，糟心啊，明明就快到手了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630329
					],
					"speakerTitle": "伊扎德"
				},
				{
					"id": 4630329,
					"content": "哦呵，宝藏？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630330
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4630330,
					"content": "不好意思了，这里根本没有什么宝藏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630331
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4630331,
					"content": "辛苦你们白跑一趟。那么现在，束手就擒吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630332
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4630332,
					"content": "咦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630333
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630333,
					"content": "没有…宝藏？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630334
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630334,
					"content": "凯亚刚才是不是说…没有…宝藏？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630335
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630335,
					"content": "哈哈。被算计了…没想到骑士也会用这种下作手段…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630336
					],
					"speakerTitle": "伊扎德"
				},
				{
					"id": 4630336,
					"content": "身为盗贼就不要随便评论骑士的智慧…喂，等等，你想干什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630337
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4630337,
					"content": "谁要被你们抓住啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630338
					],
					"speakerTitle": "伊扎德"
				},
				{
					"id": 4630338,
					"content": "这…这是什么？我不是故意的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊扎德"
				},
				{
					"id": 4630308,
					"content": "…是情报交易所的人吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630309
					]
				},
				{
					"id": 4630309,
					"content": "哈哈哈，情报交易所。我倒是和他们打过交道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630310
					],
					"speakerTitle": "???"
				},
				{
					"id": 4630310,
					"content": "都是些守规矩的商人，发不了大财的家伙们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630311
					],
					"speakerTitle": "???"
				}
			]
		},
		{
			"id": 46305,
