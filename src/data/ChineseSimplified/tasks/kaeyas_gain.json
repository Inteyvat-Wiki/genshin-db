					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4630501,
					"content": "呼…没想到居然混到了被骑士团救命的地步，真是丢脸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630502
					],
					"speakerTitle": "伊扎德"
				},
				{
					"id": 4630502,
					"content": "别忘了你承诺过什么，否则刚才的东西绝对不会是你见过最可怕的东西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630503
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4630503,
					"content": "这…喂！你们骑士团都是这样对待嫌犯的吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630504
					],
					"speakerTitle": "伊扎德"
				},
				{
					"id": 4630504,
					"content": "开玩笑的。好了，把他带回蒙德城吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630505
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4630505,
					"content": "是！凯亚队长。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630506
					],
					"speakerTitle": "西风骑士"
				},
				{
					"id": 4630506,
					"content": "队长，这两个人也要一并带走吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630507
					],
					"speakerTitle": "西风骑士"
				},
				{
					"id": 4630507,
					"content": "什么？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630508,
					"content": "哈哈，不用了。这两位可是本次行动的功臣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630509
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4630510,
					"content": "果然是假情报。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630513
					]
				},
				{
					"id": 4630511,
					"content": "果然根本没有什么宝藏。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630513
					]
				},
				{
					"id": 4630512,
					"content": "原来我被骗了！震惊！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630513
					]
				},
				{
					"id": 4630509,
					"content": "没有他们散布<color=#00E1FFFF>假情报</color>，我们也没那么容易搞定盗宝团。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630510,
						4630511,
						4630512
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4630513,
					"content": "呜呜呜…骗子！喜欢说谎的坏人！骑士团的败类！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630514
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630514,
					"content": "停，停——好啦，好啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630515
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4630515,
					"content": "尽管宝藏是假的，但至少有那么一瞬间你是想要独吞的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630516
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4630516,
					"content": "不然，你们为什么不通知我，而是自己过来了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630517
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4630517,
					"content": "啊！…唔嗯嗯嗯嗯…哼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630518
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630518,
					"content": "#{NICKNAME}，我们走！谁有空和这家伙理论啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630519
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630519,
					"content": "哈哈，稍等一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630520
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4630520,
					"content": "二位帮了我这么大的忙，谢礼总是少不了的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630521
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4630521,
					"content": "这柄剑名为「斩开黎明指向胜利的拂晓神剑」，如它的名字一样，是象征光明与胜利之剑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630533
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4630533,
					"content": "不嫌弃的话，这柄我珍藏已久的「黎明神剑」就作为给两位的谢礼吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630522
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4630522,
					"content": "「黎明神剑」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630523
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630523,
					"content": "没错。与通情达理的派蒙阁下很相称吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630524
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4630524,
					"content": "嗯…如果谢礼是这柄「黎明神剑」的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630525
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630525,
					"content": "你们会理解我的，对吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630526
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4630526,
					"content": "有你们这样温柔又懂得体谅他人的朋友，是我凯亚的荣幸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630527
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4630527,
					"content": "嗯…嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630528
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630529,
					"content": "…派蒙已经完全被掌控了呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630531
					]
				},
				{
					"id": 4630530,
					"content": "…不同的伎俩就可以继续用吗。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630531
					]
				},
				{
					"id": 4630528,
					"content": "这次的事实在抱歉，但请派蒙阁下放心，同样的伎俩我是不会用两次的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630529,
						4630530
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4630531,
					"content": "真是愉快的一天。那么，我还要回去审讯嫌犯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4630532,
					"content": "今天就先告辞了。以后也欢迎来骑士团找我，我们下次再见吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凯亚"
				}
			]
		},
