			"dialogs": [
				{
					"id": 4630101,
					"content": "「阿卡狄亚遗迹」就是这里了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630102,
					"content": "怎么说…感觉稍微有些普通？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630103,
					"content": "我明白了，正所谓越是普通的地方，越容易被人忽视。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630104,
					"content": "真是深刻，凯亚的爷爷果然厉害。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630105,
					"content": "——沙沙，咯噔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630106
					],
					"speakerTitle": "???"
				},
				{
					"id": 4630106,
					"content": "嗯？派蒙，你听…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630107
					]
				},
				{
					"id": 4630107,
					"content": "是老鼠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630108,
					"content": "回答得太轻易了吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630109
					]
				},
				{
					"id": 4630109,
					"content": "唔…别疑神疑鬼了，不会有什么问题的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630110,
					"content": "动作要快！宝藏已经在里面等我们很久啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
