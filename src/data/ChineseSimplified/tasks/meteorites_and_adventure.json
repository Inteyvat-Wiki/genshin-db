			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"杰克"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411250101,
					"content": "唉…要是我也能去看看就好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250102
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 411250102,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250103
					]
				},
				{
					"id": 411250103,
					"content": "是你啊。倒也没发生什么特别的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250104
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 411250104,
					"content": "呃，其实也算挺特别的吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250105,
						411250108
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 411250105,
					"content": "是陨石的事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250106
					]
				},
				{
					"id": 411250106,
					"content": "对，你也看见了吧，最近一段时间，不断有陨石从天而降。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250107
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 411250107,
					"content": "不过…该说是风神护佑，还是单纯运气好呢，陨石一直没有砸进城里来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250113
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 411250113,
					"content": "但还有不少的陨石坠落在了野外，而且据说…只要摸到了陨石的人，都会陷入沉睡，怎么样都叫不醒的那种。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250114
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 411250114,
					"content": "塞琉斯先生已经发布委托召集了一些冒险家，一部分去通知那些还留在野外的人进城避难…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250115
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 411250115,
					"content": "另外一部分，则是帮助西风骑士团去确认各处陨石的落点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250116
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 411250116,
					"content": "然后以落点为中心，向四周搜索援救。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250117
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 411250117,
					"content": "至于我嘛…塞琉斯先生说，我最好还是留在城里，帮助照顾那些陷入昏睡的人比较好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250118
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 411250118,
					"content": "也许是因为我实力没达标吧…但总是负责这些小事，我也一点变强的机会都没有嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250119
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 411250119,
					"content": "唉，但不管怎么说，我也得先把分内的事处理好才行…不过旅行者，能请你帮我个忙吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250120
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 411250120,
					"content": "我想请你帮我去野外看看，搜集一下和那些陨石相关的信息…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250121,
						411250126
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 411250121,
					"content": "搜集这些做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250122
					]
				},
				{
					"id": 411250122,
					"content": "塞琉斯先生总是说，在开始冒险前，一定要做好万全的准备…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250123
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 411250123,
					"content": "如果我能说服塞琉斯先生，我已经对现在的情况十分了解，也做好了充足的准备…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250124
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 411250124,
					"content": "那么，说不定他就能让我也去野外加入调查了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250125
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 411250125,
					"content": "但我现在还得去帮忙照顾那些人，没机会出去搜集信息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250133
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 411250133,
					"content": "所以，只能拜托你了，旅行者！请你帮我去野外调查一下吧，就…去低语森林附近就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250134
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 411250134,
					"content": "有收获的话，就快回来告诉我吧。我能不能去野外加入调查…就全靠你了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "杰克"
				},
				{
					"id": 411250126,
					"content": "你想偷偷地…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250127
					]
				},
				{
					"id": 411250127,
					"content": "啊？我偷偷地…没有！没有，绝对没有！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250128
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 411250128,
					"content": "虽然我确实很想去野外调查…但城里也需要有人帮忙，城里的事也很重要！我可不能擅离职守…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250129
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 411250129,
					"content": "哎呀，就是…塞琉斯先生总说，在开始冒险前，一定要做好万全的准备…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250130
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 411250130,
					"content": "如果我能说服塞琉斯先生，我已经对现在的情况十分了解，也做好了充足的准备…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250131
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 411250131,
					"content": "那么，说不定他就能让我也去野外加入调查了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250132
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 411250132,
					"content": "但我现在还得去帮忙照顾那些人，没机会出去搜集信息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250133
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 411250108,
					"content": "是「猎鹿人」店庆活动菜品半价？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250109
					]
				},
				{
					"id": 411250109,
					"content": "什么？！我怎么不知道！「猎鹿人」今天还有活动吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250110
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 411250110,
					"content": "哎！不对不对…我要说的不是这个…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250111
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 411250111,
					"content": "你也看见了吧，最近一段时间，不断有陨石从天而降。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250112
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 411250112,
					"content": "不过…该说是风神护佑，还是单纯运气好呢，陨石一直没有砸进城里来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250113
					],
					"speakerTitle": "杰克"
				}
			]
