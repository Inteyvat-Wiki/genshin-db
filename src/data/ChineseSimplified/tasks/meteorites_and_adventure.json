			"dialogs": [
				{
					"id": 411250201,
					"content": "可算甩掉了，这到底是怎么回事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250202
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 411250202,
					"content": "你是来调查陨石的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250203
					]
				},
				{
					"id": 411250203,
					"content": "是的，我从协会里接受了委托，来野外调查和陨石相关的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250204
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 411250204,
					"content": "但陨石落点附近的魔物不知道为什么，突然变得和平时不一样了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250205
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 411250205,
					"content": "无论是攻击的力度、行动的状态，还是其他的方面都格外异常，而且数量也格外多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250206
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 411250206,
					"content": "我不小心被它们发现，不敢在那边多逗留，就抄了几条小路，把它们全给甩开了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250207
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 411250207,
					"content": "这种魔物的异常情况，我得赶紧回去城里向塞琉斯先生报告才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250208
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 411250208,
					"content": "还有其他什么情况吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250209
					]
				},
				{
					"id": 411250209,
					"content": "其他的情况？这个嘛…非要说的话，那就是还有很多学者不肯进城避难吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250210
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 411250210,
					"content": "不管我怎么劝他们，他们都坚持要继续待在野外研究。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250211
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 411250211,
					"content": "现在能到野外调查的冒险家又不多，也不可能隔几天就去提醒他们一次…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250212
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 411250212,
					"content": "这拨人真是够让人头疼的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250213
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 411250213,
					"content": "好了旅行者，如果没有什么重要的事，你也赶紧回城里避难吧，现在可不是在野外逗留的时候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "冒失的帕拉德"
				}
			]
