			"dialogs": [
				{
					"id": 140110101,
					"content": "要是没记错的话，他就住在这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110102
					],
					"speakerTitle": "劳维克"
				},
				{
					"id": 140110102,
					"content": "请问是谁？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110103
					],
					"speakerTitle": "波洛"
				},
				{
					"id": 140110103,
					"content": "是我，你的本子写完了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110104
					],
					"speakerTitle": "劳维克"
				},
				{
					"id": 140110104,
					"content": "你怎么都追到这里来了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110105
					],
					"speakerTitle": "波洛"
				},
				{
					"id": 140110105,
					"content": "哎呀，这个你别管，先出来，有好消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110106
					],
					"speakerTitle": "劳维克"
				},
				{
					"id": 140110106,
					"content": "啧，谁信你。等我一会儿，已经在收尾了，写完了就出来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110107
					],
					"speakerTitle": "波洛"
				},
				{
					"id": 140110107,
					"content": "行吧，期待你的大作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110108
					],
					"speakerTitle": "劳维克"
				},
				{
					"id": 140110108,
					"content": "看来不出所料，是拖稿了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110109
					],
					"speakerTitle": "芙宁娜"
				},
				{
					"id": 140110109,
					"content": "毕竟结局是这个剧目里非常重要的一环。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110110
					],
					"speakerTitle": "迪尔菲"
				},
				{
					"id": 140110110,
					"content": "在他写好之后，我们所有演员都要看一遍，只有大家都赞成，它才能成为最后的结局。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110111
					],
					"speakerTitle": "迪尔菲"
				},
				{
					"id": 140110111,
					"content": "刚刚有人告诉我，我还以为他看错了呢。居然是你们，还有芙宁娜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110112
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140110112,
					"content": "果然还是会碰到她啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110113
					],
					"speakerTitle": "芙宁娜"
				},
				{
					"id": 140110113,
					"content": "看来你们是来找波洛的，如果还需要时间的话，可以在镇上随意逛逛，我都安排好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110114
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140110114,
					"content": "啊，没事，我们等在这里也…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110115
					],
					"speakerTitle": "劳维克"
				},
				{
					"id": 140110115,
					"content": "那就恭敬不如从命，我们先去逛逛啦，谢谢你的招待！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110116
					],
					"speakerTitle": "迪尔菲"
				},
				{
					"id": 140110116,
					"content": "给我过来，注意一下气氛行吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110117
					],
					"speakerTitle": "迪尔菲"
				},
				{
					"id": 140110117,
					"content": "最近，白淞镇的情况好点了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110118
					],
					"speakerTitle": "芙宁娜"
				},
				{
					"id": 140110118,
					"content": "只能说在慢慢恢复吧，但很多人内心的创伤或许一辈子都无法痊愈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110119
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140110119,
					"content": "对不起。我也很想做些什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110120
					],
					"speakerTitle": "芙宁娜"
				},
				{
					"id": 140110120,
					"content": "好啦，难道我们每次见面都要聊这些沉重的话题吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110121
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140110121,
					"content": "我们都有沉重而痛苦的回忆，但我们不一定要被它们压得喘不过气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110122
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140110122,
					"content": "既然你也有打算重新开始，就不要总把过去的事挂在嘴边啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110123
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140110123,
					"content": "谢谢你的安慰，说的很有道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110124
					],
					"speakerTitle": "芙宁娜"
				},
				{
					"id": 140110124,
					"content": "不过至少现在，还是让我保持郑重的心情吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110125
					],
					"speakerTitle": "芙宁娜"
				},
				{
					"id": 140110125,
					"content": "没关系，我知道真正要实践起来，也没有像我说的那么轻松。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110126
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140110126,
					"content": "我来也是为了告诉你们一声，至今为止，也不是所有人都原谅了水神在灾难中的毫无作为。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110127
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140110127,
					"content": "为了避免不必要的麻烦，我和镇上的人说你们都是剧团成员，而你是扮演芙宁娜的演员。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110128
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140110128,
					"content": "虽然不能说这样就万无一失，但应该就可以自由活动啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110129
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140110129,
					"content": "原来你还有这么细心的一面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140110130,
					"content": "你这话说的，刺玫会的会长从来都是胆大又心细。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110131
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140110131,
					"content": "好啦，那我先走了。你们好好陪陪她哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110132,
						140110133
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140110132,
					"content": "嗯，知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140110134
					]
				},
				{
					"id": 140110134,
					"content": "那我们走吧，去上面看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110135
					],
					"speakerTitle": "芙宁娜"
				},
				{
					"id": 140110135,
					"content": "我也没有能说心里话的朋友，可能就像她说的，你们就是最适合的对象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芙宁娜"
				},
				{
					"id": 140110133,
					"content": "谢谢你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140110134
					]
				}
			]
		},
