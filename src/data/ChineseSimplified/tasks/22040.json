					"小仓澪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220400101,
					"content": "这样做生意长久不了啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400102
					],
					"speakerTitle": "小仓澪"
				},
				{
					"id": 220400102,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220400103
					]
				},
				{
					"id": 220400103,
					"content": "抱歉抱歉，想事情一时走了神。你是来买成衣的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400104
					],
					"speakerTitle": "小仓澪"
				},
				{
					"id": 220400104,
					"content": "虽然璃月的高档绸缎仍然断货，但新款的着物还是应有尽有的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400105
					],
					"speakerTitle": "小仓澪"
				},
				{
					"id": 220400105,
					"content": "之前你会从璃月进货？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220400106
					]
				},
				{
					"id": 220400106,
					"content": "是的，之前我们店总能进到璃月的高档绸缎，比如「飞云商会」那些用霓裳花制成的丝绸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400107
					],
					"speakerTitle": "小仓澪"
				},
				{
					"id": 220400107,
					"content": "可是，现在稻妻这个情况…店里已经有一段时间没有进过那种绸缎了。现在也只能靠之前的存货维持经营。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400108
					],
					"speakerTitle": "小仓澪"
				},
				{
					"id": 220400108,
					"content": "店里的这些丝绸，可以说是用一段少一段…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400109
					],
					"speakerTitle": "小仓澪"
				},
				{
					"id": 220400109,
					"content": "我本来是想自己设计些新纹样，或者是用些新染料，做出一些新样式的布料和成衣来吸引客人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400110
					],
					"speakerTitle": "小仓澪"
				},
				{
					"id": 220400110,
					"content": "但是，我却想不出什么能称得上是有「新意」的纹样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400111
					],
					"speakerTitle": "小仓澪"
				},
				{
					"id": 220400111,
					"content": "旅行者，你见多识广，你见过什么能称得上是有「新意」的纹样吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400112
					],
					"speakerTitle": "小仓澪"
				},
				{
					"id": 220400112,
					"content": "这就不清楚了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220400113
					]
				},
				{
					"id": 220400113,
					"content": "这样啊，我明白了。这么说或许有些冒昧，但是…能不能请你帮我向外国人士打听打听关于纹样的事呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400114
					],
					"speakerTitle": "小仓澪"
				},
				{
					"id": 220400114,
					"content": "「小仓屋」如今只有我操持，所以我平时没办法离铺子太久，想四处打听就只有拜托别人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400115
					],
					"speakerTitle": "小仓澪"
				},
				{
					"id": 220400115,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220400116
					]
				},
				{
					"id": 220400116,
					"content": "那太好了，我想想…请你直接去问问汤雯小姐和拉姆齐先生吧，也许他们会有什么新想法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小仓澪"
				}
			]
		},
