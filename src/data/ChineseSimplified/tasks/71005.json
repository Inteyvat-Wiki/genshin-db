				{
					"id": 710050401,
					"content": "我卖了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050402
					]
				},
				{
					"id": 710050402,
					"content": "好！爽快，这是钱，您拿好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050403
					],
					"speakerTitle": "博来"
				},
				{
					"id": 710050403,
					"content": "哎哟，这戒指可是个宝贝…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050404
					],
					"speakerTitle": "博来"
				},
				{
					"id": 710050404,
					"content": "那片遗迹里面，肯定还有其他宝贝…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "博来"
				}
			]
		},
		{
