			},
			"dialogs": [
				{
					"id": 710050501,
					"content": "我再想想。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050502
					]
				},
				{
					"id": 710050502,
					"content": "您…也行吧，您再想想，要论价钱，我说不定不是开价最高的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050503
					],
					"speakerTitle": "博来"
				},
				{
					"id": 710050503,
					"content": "但要是论生意，您把戒指卖我，我绝不会亏您的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050504
					],
					"speakerTitle": "博来"
				},
				{
					"id": 710050504,
					"content": "您想，这宝贝戒指哪能是一锤子买卖，您把戒指卖我，要是以后有什么后续买卖，我还不得先来告诉您？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050505
					],
					"speakerTitle": "博来"
				},
				{
					"id": 710050505,
					"content": "再说了，我不还会搭您点东西嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050506
					],
					"speakerTitle": "博来"
				},
				{
					"id": 710050506,
					"content": "您好好想，好好想啊，要是愿意把戒指卖给我，您尽管来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "博来"
				}
			]
		},
