			},
			"dialogs": [
				{
					"id": 710051201,
					"content": "「贪心、眷恋、凝视、妒忌、嗔怒、恶欲、自矜、竞夺、动乱…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710051202
					],
					"speakerTitle": "铭文"
				},
				{
					"id": 710051202,
					"content": "「此凡心九种，既可助世，又可乱世，不褪不灭，绵延不绝…故立九柱以靖世，镇世间纷战于此。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710051203
					],
					"speakerTitle": "铭文"
				},
				{
					"id": 710051203,
					"content": "「若有后世者破靖世九柱入内，世间必刀兵又起。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710051204
					],
					"speakerTitle": "铭文"
				},
				{
					"id": 710051204,
					"content": "「正读此碑者，可自取室内宝器，镇守璃月八方。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "铭文"
				}
			]
		},
