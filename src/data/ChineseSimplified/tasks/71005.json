			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710050201,
					"content": "这个遗迹里的氛围，总感觉让人不是很舒服，不过，这应该就是这个遗迹的尽头了",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710050202,
					"content": "这一趟也算是有所收获啦，嘿嘿，还拿到了那枚戒指。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710050203,
					"content": "我们快出去，找一些<color=#00E1FFFF>懂古玩的人</color>来看看，这个宝物到底能卖多少钱吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7100503,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
