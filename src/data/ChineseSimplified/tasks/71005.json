			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"琳琅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710050901,
					"content": "想请你看样古玩…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050902
					]
				},
				{
					"id": 710050902,
					"content": "古玩？嗯，你算是找对人了，这璃月港里，我对古玩的估价最公道了，拿出来看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050903
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710050903,
					"content": "嗯，玉石和戒身都是不错的材质。年代似乎也很久远了…唔，戒指保存得也很完好，真是难得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050904
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710050904,
					"content": "不过，「世间纷难，众生皆苦」这句铭文我倒是没听过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050905
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710050905,
					"content": "算了，你是从哪里拿到这枚戒指的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050906
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710050906,
					"content": "翠玦坡旁的遗迹。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050907
					]
				},
				{
					"id": 710050907,
					"content": "翠玦坡旁的遗迹…居然敢去那里寻宝，那你的身手还挺不错的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050908
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710050908,
					"content": "那片遗迹，周围是不是有九根柱子，中间还有一块石碑？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050909
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710050909,
					"content": "别这么惊讶，我经常听来我这里做生意的人提起那片遗迹，说是那么大的阵仗，里面一定埋着好宝贝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050910
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710050910,
					"content": "有些人还说，这些柱子和里面的那个遗迹，都是璃月先民们为了镇压战乱而建造…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050911
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710050911,
					"content": "不过，这大概也就是传说罢了，九根石头柱子就能镇压战乱的话，那这个世界早就太平了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050912
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710050912,
					"content": "但无论这些传说到底是真是假，这枚戒指既然是那片遗迹里的，自然也和这些传说有关系。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050913
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710050913,
					"content": "既能套上名头，又有来历可说，本身品质也不错，自然也能卖个好价钱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050914
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710050914,
					"content": "…放心，我不会追问你是怎么打开那片遗迹的。我只是做生意而已，其余的事，和我没关系。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050915
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710050915,
					"content": "总之，这枚戒指，我出<color=#00E1FFFF>200000摩拉</color>，怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "琳琅"
				}
			]
		},
