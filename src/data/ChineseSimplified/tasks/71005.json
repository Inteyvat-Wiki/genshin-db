			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"博来"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710050301,
					"content": "想请你看样古玩…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050302
					]
				},
				{
					"id": 710050302,
					"content": "古玩啊，我可不太了解…不过，还是先拿出来看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050303
					],
					"speakerTitle": "博来"
				},
				{
					"id": 710050303,
					"content": "这枚戒指…我看看，粗琢的玉石，哟呵，这玉石的料子还不错，光是这颗玉石就能值点钱了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050304
					],
					"speakerTitle": "博来"
				},
				{
					"id": 710050304,
					"content": "这戒托…里头还刻着字，「世间纷难，众生皆苦」…这戒指，您是从哪拿出来的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050305
					],
					"speakerTitle": "博来"
				},
				{
					"id": 710050305,
					"content": "翠玦坡旁的遗迹。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050306
					]
				},
				{
					"id": 710050306,
					"content": "翠玦坡，翠玦坡…啧啧，可惜了，旁边就是绝云间…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050307
					],
					"speakerTitle": "博来"
				},
				{
					"id": 710050307,
					"content": "要是这戒指是从绝云间里的哪个遗迹中带出来的，那准能卖个好价钱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050308
					],
					"speakerTitle": "博来"
				},
				{
					"id": 710050308,
					"content": "可惜了，没点来头，这价钱得低不少。不过这戒指的品相不错，单卖出去也肯定有人要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050309
					],
					"speakerTitle": "博来"
				},
				{
					"id": 710050309,
					"content": "这样，我出<color=#00E1FFFF>180000摩拉</color>，再搭您点东西，您看，愿意把这戒指出给我吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "博来"
				}
			]
		},
