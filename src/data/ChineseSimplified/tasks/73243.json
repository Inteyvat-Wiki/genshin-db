					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732432001,
					"content": "「在读过伟大的塔巴里贤者编制的『星表』之后，我才终于意识到，魔神的战争也好，古国的覆灭也罢，不过都是群星运行在大地上的投影。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432002
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732432002,
					"content": "「唯一永恒的只有我们头上的星空。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432003
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732432003,
					"content": "「唔…抛去在严谨的学术研究中加入不知所谓的抒情元素不谈，原来明论派的研究就是把前后上千年的事情都混为一谈吗？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432004
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732432004,
					"content": "「真希望你们能学会从历史的角度看问题，而不是整天盯着星星神神叨叨的。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432005
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732432005,
					"content": "「你懂什么！这叫探究世界的法则，怪不得说你们伐护末那都是书呆子。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "留言板"
				}
			]
		},
		{
			"id": 7324321,
			"completionStepIds": [
