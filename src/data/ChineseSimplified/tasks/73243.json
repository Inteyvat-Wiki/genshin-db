			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732432101,
					"content": "「作为留学生，在教令院学习的每一天都让我更加感受到草神的伟大。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432102
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732432102,
					"content": "「在蒙德的时候，再简单的问题都要翻上十几本书才刚刚能把不同的说法整理出来。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432103
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732432103,
					"content": "「但有了「虚空终端」之后，只要思考特定的内容就能获得正确的知识。我想世上绝不会有比虚空更伟大的造物了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "留言板"
				}
			]
		},
		{
			"id": 7324322,
			"completionStepIds": [
				7324312
