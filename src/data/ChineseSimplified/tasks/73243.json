			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430101,
					"content": "教令院相关通知及内外法令公告现已全面转由虚空内投放，此公告板现仅保留供院内师生课外交流使用，院外人士请勿随意留言！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "留言板"
				}
			]
		},
		{
			"id": 7324302,
			"completionStepIds": [
				7324302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324302",
							"2"
						],
						"stepId": 7324302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430201,
					"content": "「为了更加宽松的学术环境，为了更加友好的学术交流，为了大家能够笑着写出论文！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430202
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732430202,
					"content": "「我们支持维克拉姆成为下一任大掌书！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430203
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732430203,
					"content": "「欢迎加入『维克拉姆之友联谊会』，我们将会见证一位年轻、亲民、有趣的大掌书的诞生。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "留言板"
				}
			]
		},
		{
			"id": 7324303,
			"completionStepIds": [
				7324303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324303",
							"2"
						],
						"stepId": 7324303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430301,
					"content": "「切不可忘记教令院的三善六罪。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430302
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732430302,
					"content": "「诤言、巧思、笃行。是每一位学者都应当追求的美德。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430303
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732430303,
					"content": "「而里法特，数十年来，一直亲身践行着这三点。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430304
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732430304,
					"content": "「欢迎加入『三善书友会』，与智慧同行，与未来的大掌书同行。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "留言板"
				}
			]
		},
		{
			"id": 7324304,
			"completionStepIds": [
				7324304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324304",
							"2"
						],
						"stepId": 7324304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430401,
					"content": "「『三善书友会』的成员们，我敬佩你们对于美德的追求。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430402
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732430402,
					"content": "「不过，我可听说，里法特的论文，可有一半以上是代笔之作。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430403
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732430403,
					"content": "「这也是他为什么明明学术成果众多，却还这么低调的原因。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430404
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732430404,
					"content": "「留言板虽然不像论文那样需要充分的论据，但是也不能恶意攻击他人。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430405
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732430405,
					"content": "「我看上面的留言只是嫉妒罢了！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430406
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732430406,
					"content": "「并且，我也有听说，维克拉姆可是借着他的口才，赢得了不少女孩子的芳心。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430407
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732430407,
					"content": "「这些女孩子，可都不知道他是有妇之夫哦。怎么样，你要不要也嫉妒一下他的艳福？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430408
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732430408,
					"content": "「禁止无端恶意攻击教令院学者，如有再犯，风纪官将会追查谣言来源。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "留言板"
				}
			]
		},
		{
			"id": 7324305,
			"completionStepIds": [
				7324305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324305",
							"2"
						],
						"stepId": 7324305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430501,
					"content": "「此留言板尚未纳入虚空权限系统管辖，无需虚空即可直接阅览。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430502
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732430502,
					"content": "「请大家务必提高知识安全意识，严禁通过此留言板进行公共传播领域外的知识资源交流。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "留言板"
				}
			]
		},
		{
			"id": 7324306,
			"completionStepIds": [
				7324306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324306",
							"2"
						],
						"stepId": 7324306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430601,
					"content": "「温馨提醒，各位同学课余时间在院外也不要忘记谨守院纪。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430602
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732430602,
					"content": "「对于知识的统一管理是『智慧之国』赖以存在的基石，不要因为无心之失而失去在教令院学习的机会。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "留言板"
				}
			]
		},
		{
			"id": 7324307,
			"completionStepIds": [
				7324307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324307",
							"2"
						],
						"stepId": 7324307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430701,
					"content": "「近期连续发生数起罐装知识走私案件。详细情况将在调查完成后在下一次识藏日前通过虚空投放给相关学院的师生。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430702
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732430702,
					"content": "「也请各位导师加强与学生的沟通交流，避免学生因论文压力过大而铤而走险。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "留言板"
				}
			]
		},
		{
			"id": 7324308,
			"completionStepIds": [
				7324308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324308",
							"2"
						],
						"stepId": 7324308,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430801,
					"content": "「现在学院对于虚空的应用推广，与其说是太激进，我看不如说是太保守了。大量教令官的工作冗繁低效，某些方面甚至还不如以前。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430802
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732430802,
					"content": "「试想，如果我们能用虚空直接给大家分配工作，交易所的商品交换也由虚空直接管理。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430803
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732430803,
					"content": "「等到那个时候，我们起码能裁撤掉一半的教令官。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430804
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732430804,
					"content": "「你说的很有道理，所以我想或许这就是我们没办法这么做的原因。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "留言板"
				}
			]
		},
		{
			"id": 7324309,
			"completionStepIds": [
				7324309
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324309",
							"2"
						],
						"stepId": 7324309,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430901,
					"content": "「众所周知，探求深秘的智慧才是学者的本职。但现在的教令院，实在过多的牵涉到行政事务当中了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430902
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732430902,
					"content": "「如今很多同学在匆匆完成学业后，就不得不停下手中的研究，被委派去各地负担教令官的工作，这是否已经背离了教令院的初衷呢？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430903
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732430903,
					"content": "「这个问题不是早在虚空里就已经有结论了吗？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430904
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732430904,
					"content": "「在百姓还陷于迷信之中，唯有我们最为接近真理的光辉。我们又怎能卸下用火光照亮世人这样的重责呢。我们要是不管的话，须弥还不知道要乱成什么样子呢！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "留言板"
				}
			]
		},
		{
			"id": 7324310,
			"completionStepIds": [
				7324310
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324310",
							"2"
						],
						"stepId": 7324310,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431001,
					"content": "「作为留学生，在教令院学习的每一天都让我更加感受到树王的伟大。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431002
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732431002,
					"content": "「在蒙德的时候，再简单的问题都要翻上十几本书才刚刚能把不同的说法整理出来。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431003
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732431003,
					"content": "「但有了『虚空终端』之后，只要思考特定的内容就能获得正确的知识。我想世上绝不会有比虚空更伟大的造物了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "留言板"
				}
			]
		},
		{
			"id": 7324311,
			"completionStepIds": [
				7324311
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324311",
							"2"
						],
						"stepId": 7324311,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431101,
					"content": "「自迦毗鸠师之后，教令院每年划拨给刹诃伐罗学院的经费就没有涨过。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431102
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732431102,
					"content": "「上面的人只会说什么为了大家稳定安宁的生活，必须严格控制机械技术的研发和推广。要真按这么说，我看干脆把虚空也关了算了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431103
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732431103,
					"content": "「如果不是有像桑歌玛哈巴依老爷这样有慧眼的商人长期投资，我们妙论派早就关门大吉了！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "留言板"
				}
			]
		},
		{
			"id": 7324312,
			"completionStepIds": [
				7324312
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324312",
							"2"
						],
						"stepId": 7324312,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431201,
					"content": "「虽然我完全信任贤者和导师们的判断，但如今的教令院是否太依赖虚空了呢。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431202
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732431202,
					"content": "「习惯于通过虚空获取知识后，我们外派出的游学者学术能力的下降是有目共睹的。我认为有必要通过法令限制初入学的学生对虚空的使用。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431203
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732431203,
					"content": "「怎么能这么说，你不知道那些隐遁沙漠之中，未能接受虚空教导的学派早已陷入无知与迷狂之中，乃至于用生吞毒蛇的愚行来接近智慧了吗？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431204
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732431204,
					"content": "「在大慈树王身后，恰恰是虚空保证了我们知识的纯洁。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "留言板"
				}
			]
		},
		{
			"id": 7324313,
			"completionStepIds": [
				7324313
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324313",
							"2"
						],
						"stepId": 7324313,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431301,
					"content": "本周由巡林官提纳里大人主讲的「植物学讲座」将照常于禅那园举办，欢迎大家报名。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431302
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732431302,
					"content": "不管是什么人，只要对植物感兴趣都可以来参加！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431303
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732431303,
					"content": "非常抱歉，由于本次讲座报名人数太多，为方便知识管理，经教令院讨论决定，将仅限生论派的同学及巡林工作人员参加，特此公告。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "留言板"
				}
			]
		},
		{
			"id": 7324314,
			"completionStepIds": [
				7324314
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324314",
							"2"
						],
						"stepId": 7324314,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431401,
					"content": "「有人看了最新的八重堂小说吗？这次有我们须弥的作者哦，好像是叫…普尔希娜什么的吧，一看就是你们生论派的人。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431402
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732431402,
					"content": "「唉…我要是当初也能考进阿弥利多学院就好了，不仅天天能游山玩水，还有空写小说。结果进了这个室罗婆耽，每天除了读文献就是写论文，连出去考察的机会都没有。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431403
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732431403,
					"content": "「什么，竟然有人抢在老夫之前在八重堂出版了小说，这下本人轻小说研究权威的身份岂不是…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "留言板"
				}
			]
		},
		{
			"id": 7324315,
			"completionStepIds": [
				7324315
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324315",
							"2"
						],
						"stepId": 7324315,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431501,
					"content": "「果然生意和书本上的事情是两码事，要是当初留在大巴扎好好做生意就好了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431502
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732431502,
					"content": "「结果现在论文也写不出来，钱也没了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431503
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732431503,
					"content": "「实在不行，干脆退学去镀金旅团算了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "留言板"
				}
			]
		},
		{
			"id": 7324316,
			"completionStepIds": [
				7324316
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324316",
							"2"
						],
						"stepId": 7324316,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431601,
					"content": "「不是说我对沙漠来的人有什么意见，但是我看大风纪官还是得德高望重的学者来担任才是，特别是学术的问题可不是靠打架能解决的。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431602
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732431602,
					"content": "「呵呵，我看至少比你们明论派的人管的时候要好多了，至少不会偏袒哪个学院。真以为没人知道你们以前每年的发表率是怎么回事？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431603
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732431603,
					"content": "「喂！妙论派的家伙，你说话可要拿出证据，不然我可要找风纪官评理了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "留言板"
				}
			]
		},
		{
			"id": 7324317,
			"completionStepIds": [
				7324317
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324317",
							"2"
						],
						"stepId": 7324317,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431701,
					"content": "「开放其他国家的人来留学也就算了，现在连虚空也要开放给外国人…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431702
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732431702,
					"content": "「且不说外国人的脑袋会不会给虚空造成什么不好的影响，光是不可避免的知识外流问题，就不知道会对须弥的外贸经济造成多大影响。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431703
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732431703,
					"content": "「竟然有学者会关心经济问题，还真是少见…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431704
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732431704,
					"content": "「所以说你们知论派就是不食人间烟火，要不是为了能合成出更好的漆器涂料，我才不会考来教令院呢！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "留言板"
				}
			]
		},
		{
			"id": 7324318,
			"completionStepIds": [
				7324318
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324318",
							"2"
						],
						"stepId": 7324318,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431801,
					"content": "「最近好久没看到那个沙漠矮子了，看来总算可以放松一会了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431802
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732431802,
					"content": "「这帮管风纪的家伙也不知道闻了什么香这么积极，害得我上个学年的考核都没过。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431803
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732431803,
					"content": "「我记得那个考核不是光靠出勤都能过吗，你自己不好好学习还要赖别人。而且虽然最近风纪官人手短缺，不过你这样乱说还是小心被找上门吧。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431804
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732431804,
					"content": "「什么风纪官，说白了还不是上面的人装装样子的。等一下，虚空给我发了个消息…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431805
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732431805,
					"content": "「看来大家还是谨慎一点比较好。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "留言板"
				}
			]
		},
