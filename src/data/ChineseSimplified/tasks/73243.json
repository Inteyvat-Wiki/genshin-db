			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732432201,
					"content": "「虽然我完全信任贤者和导师们的判断，但如今的教令院是否太依赖虚空了呢。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432202
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732432202,
					"content": "「习惯于通过虚空获取知识后，我们外派出的游学者学术能力的下降是有目共睹的。我认为有必要通过法令限制初入学的学生对虚空的使用。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432203
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732432203,
					"content": "「怎么能这么说，你不知道那些隐遁沙漠之中，未能接受虚空教导的学派早已陷入无知与迷狂之中，乃至于用生吞毒蛇的愚行来接近智慧了吗？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432204
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732432204,
					"content": "「人们没有意识到的是，恰恰是虚空保证了我们知识的纯洁。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "留言板"
				}
			]
		},
