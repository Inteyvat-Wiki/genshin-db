			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431901,
					"content": "「…关于『赞迪克』其人其事的调查结果…陀裟多…死亡原因…谋害可能…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431902
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732431902,
					"content": "「…『赞迪克』…除名后…对于魔鳞症…但缺乏证据…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431903
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732431903,
					"content": "「…记录突然消失…不明年份…魔鳞症开始传播…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431904
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732431904,
					"content": "「…失踪前…『法留纳传说』…执着于…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431905
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732431905,
					"content": "【以下的内容被污损得很彻底，完全看不到有意义的文字了。】",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "留言板"
				}
			]
		},
		{
			"id": 7324320,
			"completionStepIds": [
				7324320
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
