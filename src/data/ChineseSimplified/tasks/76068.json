			"dialogs": [
				{
					"id": 760680101,
					"content": "艾莉亚。看来，你也已经为自己选好了属于「人」的姿态。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680102
					],
					"speakerTitle": "卡侬"
				},
				{
					"id": 760680102,
					"content": "呵呵，你的模样也很符合我的预想呢，卡侬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680103
					],
					"speakerTitle": "艾莉亚"
				},
				{
					"id": 760680103,
					"content": "不过，我没有想到的是，你居然也会为那些可爱的小生命，主动创造出这样的形体。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680104
					],
					"speakerTitle": "艾莉亚"
				},
				{
					"id": 760680104,
					"content": "这是理所应当的，艾莉亚。那些脆弱的生命信任我、呼唤我，我便会回应他们的声音。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680105
					],
					"speakerTitle": "卡侬"
				},
				{
					"id": 760680105,
					"content": "我们为维系世界而诞生。若是名为「人」的生命愿意在我们的世界定居，聆听他们的呼求，便也是王赋予我们的使命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680106
					],
					"speakerTitle": "卡侬"
				},
				{
					"id": 760680106,
					"content": "嗯，毕竟王说过，凡是星海间的生命，都是与我们共同对抗漆黑的盟友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680107
					],
					"speakerTitle": "艾莉亚"
				},
				{
					"id": 760680107,
					"content": "不过我要说的倒不是那个。我是说，没想到「霜月」居然也会表现出这样感性的一面。很可爱呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680108
					],
					"speakerTitle": "艾莉亚"
				},
				{
					"id": 760680108,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680109
					],
					"speakerTitle": "卡侬"
				},
				{
					"id": 760680109,
					"content": "…我能看出你的语言已经开始被那些小小的人类影响了，艾莉亚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680110
					],
					"speakerTitle": "卡侬"
				},
				{
					"id": 760680110,
					"content": "他们的词语总是像这般含混。不要用。我完全无法理解你说的「可爱」究竟想要表达什么含义。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680111
					],
					"speakerTitle": "卡侬"
				},
				{
					"id": 760680111,
					"content": "哎呀，好啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680112
					],
					"speakerTitle": "桑娜妲"
				},
				{
					"id": 760680112,
					"content": "艾莉亚姐姐，卡侬姐姐，为自己捏出这样的形体，第一件事难道不应该是偷偷溜出去，和那些地上的人们一起玩吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680113
					],
					"speakerTitle": "桑娜妲"
				},
				{
					"id": 760680113,
					"content": "要不然不是白捏了嘛！快点快点，趁着没人发现——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680114
					],
					"speakerTitle": "桑娜妲"
				},
				{
					"id": 760680114,
					"content": "呵呵，看来我们亲爱的妹妹已经等不及了，卡侬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680115
					],
					"speakerTitle": "艾莉亚"
				},
				{
					"id": 760680115,
					"content": "他们刚开始在地上建起文明的时候，你还说「那个外来者不是什么好东西，它的造物当然也一样」，看都不愿意看一眼呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680116
					],
					"speakerTitle": "艾莉亚"
				},
				{
					"id": 760680116,
					"content": "那、那是不一样的事情！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680117
					],
					"speakerTitle": "桑娜妲"
				},
				{
					"id": 760680117,
					"content": "我现在也觉得姐姐们不该把那个外来者放进来，但地上的人们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680118
					],
					"speakerTitle": "桑娜妲"
				},
				{
					"id": 760680118,
					"content": "哈…你们玩得开心就好。去吧，记得跟紧艾莉亚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680119
					],
					"speakerTitle": "卡侬"
				},
				{
					"id": 760680119,
					"content": "嗯？卡侬姐姐不和我们一起去吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680120
					],
					"speakerTitle": "桑娜妲"
				},
				{
					"id": 760680120,
					"content": "那位降临者的从者说是要找我谈些事。关于这个世界的引力势与度规{RUBY#[D]时间规则}张量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680121
					],
					"speakerTitle": "卡侬"
				},
				{
					"id": 760680121,
					"content": "伊斯塔露？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680122
					],
					"speakerTitle": "艾莉亚"
				},
				{
					"id": 760680122,
					"content": "应该是这个名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680123
					],
					"speakerTitle": "卡侬"
				},
				{
					"id": 760680123,
					"content": "要好好记住别人的名字啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680124
					],
					"speakerTitle": "艾莉亚"
				},
				{
					"id": 760680124,
					"content": "不过，也许是我的错觉，但我总觉得，她对那位降临者似乎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680125
					],
					"speakerTitle": "艾莉亚"
				},
				{
					"id": 760680125,
					"content": "我不会过早判断，艾莉亚。但我会留意的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680126
					],
					"speakerTitle": "卡侬"
				},
				{
					"id": 760680126,
					"content": "嗯，那就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680127
					],
					"speakerTitle": "艾莉亚"
				},
				{
					"id": 760680127,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680128
					],
					"speakerTitle": "桑娜妲"
				},
				{
					"id": 760680128,
					"content": "呵呵，没什么。那我们就先走啦，卡侬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680129
					],
					"speakerTitle": "艾莉亚"
				},
				{
					"id": 760680129,
					"content": "放心吧，我和桑娜妲妹妹会给你带礼物回来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680130
					],
					"speakerTitle": "艾莉亚"
				},
				{
					"id": 760680130,
					"content": "…我不需要礼物。你们当心别被认出来就够了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡侬"
				}
			]
		}
	]
}