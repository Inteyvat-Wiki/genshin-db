			"dialogs": [
				{
					"id": 790550101,
					"content": "此处为短剧《断船遗梦》片场的弃用场景",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790550102
					],
					"speakerTitle": "片场备注"
				},
				{
					"id": 790550102,
					"content": "原本构想的，是在一艘漂浮的断船上，两只水形幻灵坠入爱河的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790550103
					],
					"speakerTitle": "片场备注"
				},
				{
					"id": 790550103,
					"content": "在它们互相表明心迹之后，于夕阳的余晖之中立于船头的场景想必相当浪漫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790550104
					],
					"speakerTitle": "片场备注"
				},
				{
					"id": 790550104,
					"content": "然而，之所以该片场被弃用，是因为…作为演员的两只水形幻灵性格过于活泼，根本无法停止行动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790550105
					],
					"speakerTitle": "片场备注"
				},
				{
					"id": 790550105,
					"content": "唔，如果能够捕捉到<color=#00E1FFFF>两只同时出现在船头</color>的场景就好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790550106
					],
					"speakerTitle": "片场备注"
				},
				{
					"id": 790550106,
					"content": "——「导演」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "片场备注"
				}
			]
