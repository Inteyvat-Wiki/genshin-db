			"dialogs": [
				{
					"id": 100060101,
					"content": "你好呀，杜林，原来你在这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100060102,
					"content": "#是{NICKNAME}和派蒙，你们怎么来了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060103
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 100060103,
					"content": "嘿嘿，外面天气这么好，你怎么一个人在这里看书啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100060104,
					"content": "是这样的，自从在蒙德和大家「社交」的机会变多了之后，我就经常会把大家说的玩笑话当真。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060105
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 100060105,
					"content": "比如上次我在花店看到了一束非常美丽的花，告诉店主之后，她说：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060106
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 100060106,
					"content": "「呼呼，你要是看上了这些杂草，那不如拿薄荷和甜甜花跟它一起插个花束好了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060107
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 100060107,
					"content": "结果，等我按照她的说法，把做好的花束拿去给她看的时候，她却露出了非常可怕的表情…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060108,
						100060109
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 100060108,
					"content": "杜林的眼光很独特呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060110
					]
				},
				{
					"id": 100060110,
					"content": "后来阿贝多说，这是因为我还没办法听懂大家话语中的「言外之意」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060111
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 100060111,
					"content": "在学会蒙德的文字后，他就跟我说可以多看看这里的书。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060112
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 100060112,
					"content": "因为我是从故事书里诞生的，所以应该也能从这些书中学到这个世界的「规则」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060113
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 100060113,
					"content": "结果我不知不觉就看到了现在…对了，还没问你们找我有什么事情呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060114,
						100060117
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 100060114,
					"content": "朋友之间应该经常互相拜访。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060115
					]
				},
				{
					"id": 100060115,
					"content": "原来是这样，这也是「规则」的一部分吧，又学到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060116
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 100060116,
					"content": "虽然是这样没错，不过我们还有正事要说吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100060118,
					"content": "是这样的，其实我们带来了莱茵多特要交给你的「口信」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100060119,
					"content": "居然是…莱茵多特阿姨吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060120,
						100060121
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 100060120,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060122
					]
				},
				{
					"id": 100060122,
					"content": "嗯，我只是有些意外…莱茵多特是妈妈的朋友，也是曾经存在于这个世界的「魔龙」的母亲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060123
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 100060123,
					"content": "而我取代了原本属于它的命运。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060124
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 100060124,
					"content": "所以如果她讨厌我的话…我也不知道该怎么办才好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060125,
						100060126
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 100060125,
					"content": "她应该没那么小气。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060127
					]
				},
				{
					"id": 100060127,
					"content": "嗯嗯，杜林你别担心，一定不会是什么坏事的。而且还有我们在呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100060128,
					"content": "听到你们这样说，我就安心多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060129
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 100060129,
					"content": "既然如此，那我就拆开来看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "杜林"
				},
				{
					"id": 100060126,
					"content": "有我们在呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060127
					]
				},
				{
					"id": 100060121,
					"content": "别紧张。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060122
					]
				},
				{
					"id": 100060117,
					"content": "我们是为了魔女…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060118
					]
				},
				{
					"id": 100060109,
					"content": "总感觉是她的问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060110
					]
				}
			]
		},
