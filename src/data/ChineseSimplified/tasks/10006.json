					"speakerTitle": "赛巴斯"
				},
				{
					"id": 100060902,
					"content": "嗯？什么飘浮灵？总感觉这家伙话里有话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060903
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100060903,
					"content": "我知道，这就是「言外之意」对吧？所以赛巴斯应该是想说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060904
					],
