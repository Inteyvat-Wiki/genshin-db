					"nextDialogs": [
						100060907
					],
					"speakerTitle": "赛巴斯"
				},
				{
					"id": 100060907,
					"content": "能让莱茵多特主人多虑的机会可不多，小哥我很看好你啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
