			"dialogs": [
				{
					"id": 740370101,
					"content": "唉，厄代尔怎么还没修好这个喷泉啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370102
					],
					"speakerTitle": "勒莫迪埃"
				},
				{
					"id": 740370102,
					"content": "再修不好，柯蕾特莉一定会让全世界的人都知道这个消息…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370103
					],
					"speakerTitle": "勒莫迪埃"
				},
				{
					"id": 740370103,
					"content": "这个喷泉坏掉了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370104
					]
				},
				{
					"id": 740370104,
					"content": "唉，明明前段时间它还是好好的，突然就不再喷水了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370105
					],
					"speakerTitle": "勒莫迪埃"
				},
				{
					"id": 740370105,
					"content": "而且…它还是刚好在我给柯蕾特莉变魔术的时候坏掉的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370106
					],
					"speakerTitle": "勒莫迪埃"
				},
				{
					"id": 740370106,
					"content": "当时爸妈正好去歌剧院看歌剧了，就叮嘱我在家里带着妹妹看书玩游戏…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370107
					],
					"speakerTitle": "勒莫迪埃"
				},
				{
					"id": 740370107,
					"content": "但柯蕾特莉一个劲地嚷着要出去玩。我拗不过柯蕾特莉，只能陪着她出去闲逛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370108
					],
					"speakerTitle": "勒莫迪埃"
				},
				{
					"id": 740370108,
					"content": "等我们逛到喷泉这里的时候，柯蕾特莉突然说要在这里等爸妈看完歌剧出来，然后和爸妈一起回家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370109
					],
					"speakerTitle": "勒莫迪埃"
				},
				{
					"id": 740370109,
					"content": "感觉也没什么不好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370110
					]
				},
				{
					"id": 740370110,
					"content": "对啊，反正都逛到这边了。等你们爸妈出来，说不定还能带你们去吃好吃的呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740370111,
					"content": "当时夜很深了…要是爸妈知道我偷偷带妹妹出门，在外面晃到这个时候，非骂我不可！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370112
					],
					"speakerTitle": "勒莫迪埃"
				},
				{
					"id": 740370112,
					"content": "所以，我就骗柯蕾特莉说，我会一种魔术，能让正在喷水的喷泉停下来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370113
					],
					"speakerTitle": "勒莫迪埃"
				},
				{
					"id": 740370113,
					"content": "其实我只是算好了喷泉的涌水间隔，想要逗柯蕾特莉开心，然后哄她回家罢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370114
					],
					"speakerTitle": "勒莫迪埃"
				},
				{
					"id": 740370114,
					"content": "喷泉确实按照我算的时间停了下来，柯蕾特莉也被我的「魔术」骗到了，一个劲地要我回家教她怎么变这个魔术。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370115
					],
					"speakerTitle": "勒莫迪埃"
				},
				{
					"id": 740370115,
					"content": "于是我就带着她回到家，搪塞了她几句，哄她去床上睡下，我也回了房间，爸妈过了一会之后也回了家，一切看上去都很正常…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370116
					],
					"speakerTitle": "勒莫迪埃"
				},
				{
					"id": 740370116,
					"content": "但第二天，在我出门帮老爸买报纸的时候，却发现这个喷泉还是没有工作…它直接坏掉了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370117,
						740370118
					],
					"speakerTitle": "勒莫迪埃"
				},
				{
					"id": 740370117,
					"content": "你的魔术威力挺大啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370119
					]
				},
				{
					"id": 740370119,
					"content": "拜托，不要笑我了！要是柯蕾特莉向爸妈提起这件事，我就彻底完蛋了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370120
					],
					"speakerTitle": "勒莫迪埃"
				},
				{
					"id": 740370120,
					"content": "「欸呀？广场上的喷泉突然坏掉了，老公，这是怎么回事？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370121
					],
					"speakerTitle": "勒莫迪埃"
				},
				{
					"id": 740370121,
					"content": "「真的…怪了，我们那天晚上去看歌剧的时候，这喷泉还是好好的呀。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370122
					],
					"speakerTitle": "勒莫迪埃"
				},
				{
					"id": 740370122,
					"content": "「我知道！是哥哥用魔术把喷泉停下了！是吧？哥哥！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370123,
						740370124
					],
					"speakerTitle": "勒莫迪埃"
				},
				{
					"id": 740370123,
					"content": "演得好！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370125
					]
				},
				{
					"id": 740370125,
					"content": "然后我带着妹妹深夜出去逛街的事就暴露了啊，爸妈会大骂我一顿，接下来两个月我都别想好过了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370126
					],
					"speakerTitle": "勒莫迪埃"
				},
				{
					"id": 740370126,
					"content": "不过，这个喷泉应该有管理人员吧。既然它坏掉了，叫人来修不就好了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740370127,
					"content": "我和管理这个喷泉的厄代尔说过了，他也承诺我会尽快修好，但…他直到今天也没来修好这个喷泉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370128
					],
					"speakerTitle": "勒莫迪埃"
				},
				{
					"id": 740370128,
					"content": "马上就要瞒不住了，我马上就要完蛋了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370129,
						740370130
					],
					"speakerTitle": "勒莫迪埃"
				},
				{
					"id": 740370129,
					"content": "我帮你去问问吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370131
					]
				},
				{
					"id": 740370131,
					"content": "真的吗？你愿意帮我？那我也愿意把我…省下来的零花钱都给你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370132
					],
					"speakerTitle": "勒莫迪埃"
				},
				{
					"id": 740370132,
					"content": "厄代尔就在那边，请你快点帮我去问问吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "勒莫迪埃"
				},
				{
					"id": 740370130,
					"content": "哎呀，这没什么，我来帮忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370131
					]
				},
				{
					"id": 740370124,
					"content": "活灵活现，完全理解了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370125
					]
				},
				{
					"id": 740370118,
					"content": "不愧是一位魔术师呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370133
					]
				},
				{
					"id": 740370133,
					"content": "在观察喷泉时，似乎有另外一个人来到了喷泉旁边…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
