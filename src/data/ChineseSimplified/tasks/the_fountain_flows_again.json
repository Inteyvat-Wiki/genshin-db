			},
			"dialogs": [
				{
					"id": 740370501,
					"content": "你好，请问有什么…欸，厄代尔？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370502
					],
					"speakerTitle": "伊丝黛莱"
				},
				{
					"id": 740370502,
					"content": "我来拿阀门和喷口了，再不修好那个喷泉，勒莫迪埃那小子非得急死不可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370503
					],
					"speakerTitle": "厄代尔"
				},
				{
					"id": 740370503,
					"content": "阀…阀门啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370504
					],
					"speakerTitle": "伊丝黛莱"
				},
				{
					"id": 740370504,
					"content": "你…怎么支支吾吾的？伊丝黛莱…你不会压根就没做吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370505
					],
					"speakerTitle": "厄代尔"
				},
				{
					"id": 740370505,
					"content": "不是！我已经做好了，只不过…因为之前一位客人需要紧急维修另外一些东西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370506
					],
					"speakerTitle": "伊丝黛莱"
				},
				{
					"id": 740370506,
					"content": "我就…我就把一些通用的附属部件给了她…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370507
					],
					"speakerTitle": "伊丝黛莱"
				},
				{
					"id": 740370507,
					"content": "别急！我现在正在打造新的，马上就好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370508
					],
					"speakerTitle": "伊丝黛莱"
				},
				{
					"id": 740370508,
					"content": "伊丝黛莱小姐，我可是提前了很久订做的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370509
					],
					"speakerTitle": "厄代尔"
				},
				{
					"id": 740370509,
					"content": "我知道啦！但是那位客人也很急，说是要拿去修污水阀门什么的，我禁不住她求…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370510
					],
					"speakerTitle": "伊丝黛莱"
				},
				{
					"id": 740370510,
					"content": "没关系，等我…等我买的铁块到了，就能打造好！应该马上就到了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370511
					],
					"speakerTitle": "伊丝黛莱"
				},
				{
					"id": 740370511,
					"content": "你什么时候订的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370512
					],
					"speakerTitle": "厄代尔"
				},
				{
					"id": 740370512,
					"content": "今…今天早上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370513,
						740370514
					],
					"speakerTitle": "伊丝黛莱"
				},
				{
					"id": 740370513,
					"content": "铁块的事交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370515
					]
				},
				{
					"id": 740370515,
					"content": "真的吗？太好了！那就拜托你了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370516
					],
					"speakerTitle": "伊丝黛莱"
				},
				{
					"id": 740370516,
					"content": "对不起，对不起！真的非常不好意思，只要三块铁块就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370517
					],
					"speakerTitle": "伊丝黛莱"
				},
				{
					"id": 740370517,
					"content": "唉，也只能交给你了，旅行者。放心吧，我会付报酬给你的，不会让你白跑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "厄代尔"
				},
				{
					"id": 740370514,
					"content": "还是由我去拿点铁块来吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370515
					]
				}
			]
		},
