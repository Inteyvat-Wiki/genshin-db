		{
			"id": 7403703,
			"completionStepIds": [
				7403703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7403703",
							"2"
						],
						"stepId": 7403703,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"厄代尔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740370301,
					"content": "这里的管道需要更换…阀门…还有清洁问题…真是问题一大堆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370302
					],
					"speakerTitle": "厄代尔"
				},
				{
					"id": 740370302,
					"content": "咦？你们找我有事吗？看样子…你们也不像伊丝黛莱派过来修喷泉的人啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370303
					],
					"speakerTitle": "厄代尔"
				},
				{
					"id": 740370303,
					"content": "关于勒莫迪埃的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370304
					]
				},
				{
					"id": 740370304,
					"content": "你说他啊。嘿…他的魔术可太厉害啦，直接把那座喷泉底层管道的一个阀门给变废了，还顺便把喷口给弄坏了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370305
					],
					"speakerTitle": "厄代尔"
				},
				{
					"id": 740370305,
					"content": "哈哈哈，开个玩笑。其实是那个变形的阀门卡住了整个出水系统，为了安全起见，我们只能暂时把整座喷泉给关上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370306
					],
					"speakerTitle": "厄代尔"
				},
				{
					"id": 740370306,
					"content": "不过喷口为什么会坏掉，我还真不清楚…真奇怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370307
					],
					"speakerTitle": "厄代尔"
				},
				{
					"id": 740370307,
					"content": "勒莫迪埃一直说，如果喷泉修不好，他就要挨骂…但我之前实在是顾不过来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370308
					],
					"speakerTitle": "厄代尔"
				},
				{
					"id": 740370308,
					"content": "今天我总算有了点空，找伊丝黛莱订了一个新阀门和新喷口，正准备去城里拿过来呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370309
					],
					"speakerTitle": "厄代尔"
				},
				{
					"id": 740370309,
					"content": "要是你愿意的话，就和我一起去吧，东西还挺多的，我都有点担心我一个人拿不动了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "厄代尔"
				}
			]
		},
		{
