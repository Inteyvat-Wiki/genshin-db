					"nextDialogs": [
						740370702
					],
					"speakerTitle": "伊丝黛莱"
				},
				{
					"id": 740370702,
					"content": "伊丝黛莱热火朝天地工作了起来…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740370703
					]
				},
				{
					"id": 740370703,
					"content": "这样就好了，喷泉阀门和喷口，还有附属的通用机关零件，全都准备好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370704
					],
					"speakerTitle": "伊丝黛莱"
				},
				{
					"id": 740370704,
					"content": "厄代尔，旅行者，我们出发去伊黎耶岛吧，有我在，那座喷泉一定能很快修好的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370705
					],
					"speakerTitle": "伊丝黛莱"
				},
				{
					"id": 740370705,
					"content": "那我真是要拜托你了…这些东西我拿着，旅行者，我们快点出发吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "厄代尔"
				}
			]
		},
