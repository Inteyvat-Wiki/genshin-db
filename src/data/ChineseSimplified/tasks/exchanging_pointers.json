				"points": []
			},
			"dialogs": [
				{
					"id": 191079801,
					"content": "康纳，你做得不错，继续保持这样，我们一定能把小迪奥娜请来晨曦酒庄做常驻调酒师！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079802
					],
					"speakerTitle": "埃泽"
				},
				{
					"id": 191079802,
					"content": "希望能够真的成功，我连着好几周蹲守，才换来了这么一次巧遇…一定要把握住这次机会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079803
					],
					"speakerTitle": "康纳"
				},
				{
					"id": 191079803,
					"content": "真是辛苦你了，康纳。但只要能把小迪奥娜请来，我们付出的一切努力都是值得的，现在我们才迈出第一步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079804
					],
					"speakerTitle": "埃泽"
				},
				{
					"id": 191079804,
					"content": "记住，一定要让小迪奥娜感受到我们的诚意，我们的热情！但记住，千万不要过于猛烈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079805
					],
					"speakerTitle": "埃泽"
				},
				{
					"id": 191079805,
					"content": "没问题，埃泽先生，这些我们俩都练过好多次了，这次一定…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079806
					],
					"speakerTitle": "康纳"
				},
				{
					"id": 191079806,
					"content": "你们在说什么呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191079807
					]
				},
				{
					"id": 191079807,
					"content": "啊？！没、没什么，我们正…讨论一些和酒庄生意相关的事，哈哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079808
					],
					"speakerTitle": "埃泽"
				},
				{
					"id": 191079808,
					"content": "是…对啊，我们正讨论酒庄生意的事呢，那个埃泽先生，我们再讨论一下最近酒庄的各项支出吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "康纳"
				}
			]
