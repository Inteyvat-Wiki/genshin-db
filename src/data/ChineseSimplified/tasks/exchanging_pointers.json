			"dialogs": [
				{
					"id": 191079701,
					"content": "埃泽先生，可这样真的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079702
					],
					"speakerTitle": "康纳"
				},
				{
					"id": 191079702,
					"content": "康纳，现在最重要的，是让小迪奥娜感受到我们的诚意，你明白吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079703
					],
					"speakerTitle": "埃泽"
				},
				{
					"id": 191079703,
