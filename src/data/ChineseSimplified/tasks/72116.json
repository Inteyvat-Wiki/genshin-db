					"泽维尔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721160101,
					"content": "还是要再等一段时间啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160102
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721160102,
					"content": "数据搜集好了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721160103
					]
				},
				{
					"id": 721160103,
					"content": "是您啊，真是幸会。数据暂时还没搜集好，我想应该还需要一点时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160104
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721160104,
					"content": "不过，我也正好趁着这段时间思考了一下应急净化器的结构…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160105,
						721160107
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721160105,
					"content": "应急净化器是什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721160106
					]
				},
				{
					"id": 721160106,
					"content": "只是我的一点应急小技巧而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160109
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721160109,
					"content": "按照我们之前商量的计划，我们得同时对付愚人众和「祟神」两个大麻烦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160110
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721160110,
					"content": "我相信您一定能搞定那些愚人众，而我，当然就要负责搞定那些「祟神」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160111
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721160111,
					"content": "这个应急净化器，就是我搞定那些「祟神」的装置。但要制作出这种装置，还需要您再来搭把手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160112,
						721160113
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721160112,
					"content": "需要我帮什么忙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721160117
					]
				},
				{
					"id": 721160117,
					"content": "为了让这个装置能在「御影炉心」里头顺利运转，我需要一些特殊的材料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160118
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721160118,
					"content": "「晶化骨髓」这种含有惰性化「祟神」力量的晶体就十分合适。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160119
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721160119,
					"content": "事实上，著名的「玉钢」的秘密，就是在于冶炼钢铁时，以特殊的方式加入这种材料，来提高钢铁的强度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160120
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721160120,
					"content": "当然啦，这种「特殊的方式」就属于商业机密了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160121
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721160121,
					"content": "我记得，附近应该就有这种晶体矿物。请您帮忙搜集三份给我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160122
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721160122,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721160123
					]
				},
				{
					"id": 721160123,
					"content": "那这件事就拜托您了，三份「晶化骨髓」，您搜集好之后就拿回来给我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721160113,
					"content": "我还以为它有个正式名…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721160114
					]
				},
				{
					"id": 721160114,
					"content": "正式名不就是「应急净化器」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160115
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721160115,
					"content": "啊…您是说，标明产品编号和出厂日期的正式编码吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160116
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721160116,
					"content": "这种纯应急装置，那种东西就不用了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160117
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721160107,
					"content": "这也是「应急措施」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721160108
					]
				},
				{
					"id": 721160108,
					"content": "算是吧，但这种技巧，我一般不会在客户服务的时候提供…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160109
					],
					"speakerTitle": "泽维尔"
				}
			]
		},
