					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750101613,
					"content": "#她要是知道{REALNAME[ID(2)|SHOWHOST(true)]}交上绵驮兽朋友了，肯定也会替{REALNAME[ID(2)|SHOWHOST(true)]}高兴的！",
