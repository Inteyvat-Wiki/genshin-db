						],
						"pointId": 350200447
					},
					{
						"sceneId": 3,
						"position": [
							-2258.041,
							232.919,
							8748.558
						],
						"pointId": 350200448
					},
					{
						"sceneId": 3,
						"position": [
							-2258.06,
							233.033,
							8746.803
						],
