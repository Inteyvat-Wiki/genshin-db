			"dialogs": [
				{
					"id": 750100101,
					"content": "「我没有必须达成的目标，也没有迫切的渴望，我是个快乐的牧民，我只关心绵驮兽，关心日月花草、清风雨露…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100102
					],
					"speakerTitle": "瓦达娜"
				},
				{
					"id": 750100102,
					"content": "这是我最喜欢的小曲，怎么样？还不错吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瓦达娜"
