			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"留云借风真君"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10091401,
					"content": "居然能闯过洞府，你们倒是有几分本事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091402
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 10091402,
					"content": "本仙乃是留云借风真君，你们所为何事，速速报来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091403,
						10091405
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 10091403,
					"content": "这个洞府是您自己建的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10091404
					]
				},
				{
					"id": 10091404,
					"content": "那是自然，除了洞府之外，那些机关也是本仙自己所建。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091407
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 10091407,
					"content": "本仙的「机关术」，就是连「归终」和岩王帝君见了，也是要称赞的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091408
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 10091408,
					"content": "这么大的洞府，您就一个人住吗？而且还有这么多机关…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10091409,
					"content": "您是不是为了研究「机关术」，才独自住在这的呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10091410,
					"content": "就和传说里的一样，仙人们离开凡世，在什么地方隐居，自己研究着很多厉害的东西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10091411,
					"content": "本仙…只是觉着交际太过烦琐，想寻个清静。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091412
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 10091412,
					"content": "但清净了没多久，你们就拿着这「百无禁忌箓」来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091413
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 10091413,
					"content": "算了，算了！你们所为何事，速速报来，莫要打扰了本仙休憩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091414
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 10091414,
					"content": "帝君…帝君遇刺了！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091415
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 10091415,
					"content": "怎…怎会如此！居然有人敢犯下如此滔天大罪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091416
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 10091416,
					"content": "如此荒诞，难以相信，本仙要去查证…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091417
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 10091417,
					"content": "不…不如本仙这就去先镇压了璃月港，再等群仙并至——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091418
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 10091418,
					"content": "…咦？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10091419
					]
				},
				{
					"id": 10091419,
					"content": "咦？！等，等一下！什么叫「镇压」璃月港？您是要把整座璃月港给毁掉吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091420
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10091420,
					"content": "只是要使些雷霆手段，免得再多生事端。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091421,
						10091423
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 10091421,
					"content": "您可是守护璃月港的仙人…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10091422
					]
				},
				{
					"id": 10091422,
					"content": "正是，承帝君律令，我等守护璃月港三千七百余年。但如今恶徒当道，也不得不用一些非常手段。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091425
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 10091425,
					"content": "本仙正是不愿看见生灵涂炭，才在此非常关头，使出非常手段。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091426
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 10091426,
					"content": "呜啊！快想想办法，这位仙人是认真的！她真要去镇压整座璃月港了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091427
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10091427,
					"content": "我奉上了贡品，按照「契约」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10091428
					]
				},
				{
					"id": 10091428,
					"content": "对啊！我们做了那么多好吃的，全都给您了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091429
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10091429,
					"content": "我们是来请您去保护璃月港的，不是请您去「镇压」的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091430
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10091430,
					"content": "至少…您也应该，先听听大家的想法吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091431
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10091431,
					"content": "…「契约」。契约之神都已遇刺，这两个字听来真是讽刺至极。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091432
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 10091432,
					"content": "璃月港里的凡人，时常会将「契约」抛之脑后，又极善混淆黑白…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091433
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 10091433,
					"content": "不过…你们既然是以「契约」之名前来请我，本仙也不能视「契约」于无物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091434
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 10091434,
					"content": "而且你们还拿着这「百无禁忌箓」…唉，帝君铸此神箓时，曾经封入仙力，助凡人征战。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091435
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 10091435,
					"content": "然而如今此箓仙力少存，只余信物之效…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091436
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 10091436,
					"content": "不过，信物可证明不了你们本身的可信…刚才我听到的那些话，我也都会查证。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091437
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 10091437,
					"content": "想必削月筑阳真君延请我等，也是为此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091438
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 10091438,
					"content": "好了，你们速速离去吧，莫要再滋扰本仙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 10091423,
					"content": "您不是应该守护凡人…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10091424
					]
				},
				{
					"id": 10091424,
					"content": "正是。但如今帝君遇害，璃月港也处在危急关头，假若不尽快镇压，只怕灾厄会再进一步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091425
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 10091405,
					"content": "洞府里的机关是您建的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10091406
					]
				},
				{
					"id": 10091406,
					"content": "那是自然。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091407
					],
					"speakerTitle": "留云借风真君"
				}
			]
		},
