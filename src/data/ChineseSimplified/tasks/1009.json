			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 10090401,
					"content": "这里好干净，应该是在这里做菜的人细心收拾过了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10090402,
					"content": "说不定，正是为了供奉仙人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10090403,
					"content": "这些材料是…「松茸」和「兽肉」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10090404,
					"content": "菜谱就摊在旁边，在这里做菜的人，真的很有条理啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
