					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 10090301,
					"content": "呜哇，好多面粉都撒在地上了，在这里做菜的人真马虎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10090302,
					"content": "锅里的东西好像是肉…但具体是什么肉就不知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10090303,
					"content": "这道菜，会不会是为了供奉仙人才做的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10090304,
					"content": "嗯…要用到「肉类」和「面粉」的菜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10090305,
					"content": "咦？地上怎么丢着一页纸…呃，还有个占了半页的脚印…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10090306,
					"content": "不过，说不定它和这道菜有关…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 100904,
			"completionStepIds": [
				100904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
