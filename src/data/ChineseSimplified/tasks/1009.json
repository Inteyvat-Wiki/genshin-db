			"dialogs": [
				{
					"id": 10090201,
					"content": "好像是有人在这里做过菜，是用来供奉仙人的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10090202,
					"content": "这旁边还有没用完的食材呢。金鱼草…莲蓬…还有豆腐，这道菜可真复杂…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10090203,
					"content": "哎，看那里，好像是…笔记。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10090204,
					"content": "这么复杂的菜，也难怪要把做菜的方法用纸记下来…我们仔细看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 100903,
			"completionStepIds": [
				100903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"100903",
