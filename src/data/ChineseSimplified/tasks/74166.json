			"dialogs": [
				{
					"id": 741660301,
					"content": "怎么样，两位商量好了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660302
					],
					"speakerTitle": "奇怪的人"
				},
				{
					"id": 741660302,
					"content": "说好了，一定是免费的哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741660303,
					"content": "那当然，那当然，肯定是「免费」的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660304
					],
					"speakerTitle": "奇怪的人"
				},
				{
					"id": 741660304,
					"content": "来来来，接下来就跟着我一起熟悉梅洛彼得堡吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奇怪的人"
