			"dialogs": [
				{
					"id": 741660601,
					"content": "这里是...前往梅洛彼得堡生产区的升降机。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660602
					],
					"speakerTitle": "奇怪的人"
				},
				{
					"id": 741660602,
					"content": "这里不会也有什么奇怪的传闻吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660603
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741660603,
					"content": "不，这倒没有。只是我非常不喜欢这个地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660604
					],
					"speakerTitle": "奇怪的人"
				},
				{
					"id": 741660604,
					"content": "嗯？为什么呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741660605,
					"content": "因为...",
					"roleType": "TALK_ROLE_NPC",
