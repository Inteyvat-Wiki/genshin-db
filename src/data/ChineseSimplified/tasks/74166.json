				},
				{
					"id": 741660606,
					"content": "因为？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660607
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741660607,
					"content": "因为我不想工作！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660608
					],
					"speakerTitle": "奇怪的人"
				},
				{
					"id": 741660608,
					"content": "我只是因为不想工作，所以在饿肚子的时候偷了一块面包被判了罪，来到这里。",
