			"dialogs": [
				{
					"id": 741660501,
					"content": "这里是三枚券剧团的所在地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660502
					],
					"speakerTitle": "奇怪的人"
				},
				{
					"id": 741660502,
					"content": "嗯？这就介绍完了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741660503,
					"content": "你们难道没有联想到什么吗？说到剧团那就是戏剧！说到戏剧那就是浪漫！说到浪漫那就是爱情！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660504
					],
					"speakerTitle": "奇怪的人"
				},
				{
					"id": 741660504,
					"content": "有传闻说，只要每天都来这里观看表演，就能找到此生的挚爱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660505
					],
					"speakerTitle": "奇怪的人"
				},
				{
					"id": 741660505,
					"content": "还有这种传闻？那大家不是应该都聚在这里么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741660506,
					"content": "话是这么说没错，但前提要求你既不能是梅洛彼得堡的犯人，也不能是梅洛彼得堡的看守。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660507
					],
					"speakerTitle": "奇怪的人"
				},
				{
					"id": 741660507,
					"content": "那根本就没有人能遇到挚爱了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741660508,
					"content": "或许这就是问题所在了。不管怎样，我们先向下一个目标进发吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奇怪的人"
				}
			]
		},
