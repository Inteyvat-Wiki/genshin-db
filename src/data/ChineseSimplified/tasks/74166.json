					"nextDialogs": [
						741660609
					],
					"speakerTitle": "奇怪的人"
				},
				{
					"id": 741660609,
					"content": "但是为什么来了梅洛彼得堡也要工作啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660610
					],
					"speakerTitle": "奇怪的人"
				},
				{
					"id": 741660610,
					"content": "「一切的工作都可以击倒我！」这可是我的人生格言。",
