			},
			"dialogs": [
				{
					"id": 741660201,
					"content": "#那边的{M#小哥}{F#小妹}，对对，就是你，就是你，来来来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660202
					],
					"speakerTitle": "奇怪的人"
				},
				{
					"id": 741660202,
					"content": "嗯？你在叫我们吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741660203,
					"content": "哦，两位朋友，我一看就知道你们是新来的，对梅洛彼得堡还不太熟悉对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660204
					],
					"speakerTitle": "奇怪的人"
				},
				{
					"id": 741660204,
					"content": "恭喜你们今天能遇到我，我是梅洛彼得堡里心地最善良的「住民」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660205
					],
					"speakerTitle": "奇怪的人"
				},
				{
					"id": 741660205,
					"content": "今天就让我来带领你们熟悉一下梅洛彼得堡吧。当然，这一切都是「免费」的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660206
					],
					"speakerTitle": "奇怪的人"
				},
				{
					"id": 741660206,
					"content": "其实我很熟悉这里了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741660207
					]
				},
				{
					"id": 741660207,
					"content": "哎，别这么说嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660208
					],
					"speakerTitle": "奇怪的人"
				},
				{
					"id": 741660208,
					"content": "或许你觉得你很熟悉这里，但是在我的导览下，我相信你能发现不一样的景色。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660209
					],
					"speakerTitle": "奇怪的人"
				},
				{
					"id": 741660209,
					"content": "天下竟然有免费的午餐？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741660210
					]
				},
				{
					"id": 741660210,
					"content": "当然当然，我说了，我可是梅洛彼得堡里心地最善良的「住民」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660211
					],
					"speakerTitle": "奇怪的人"
				},
				{
					"id": 741660211,
					"content": "唔，总觉得这个人怪怪的，怎么一见面就这么热情？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741660212,
					"content": "哈哈，我的朋友，不要多想。这样，要不然你们先商量一下，我就这里，等你们做决定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660213
					],
					"speakerTitle": "奇怪的人"
				},
				{
					"id": 741660213,
					"content": "等你们商量好了，就来找我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奇怪的人"
				}
			]
		},
