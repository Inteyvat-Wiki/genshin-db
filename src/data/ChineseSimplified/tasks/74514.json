				]
			},
			"dialogs": [
				{
					"id": 745140101,
					"content": "好…好冷，果然不该随便吹风的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140102
					],
					"speakerTitle": "朝雾"
				},
				{
					"id": 745140102,
					"content": "#欸？{NICKNAME}！派蒙！你们…阿嚏！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140103
					],
					"speakerTitle": "朝雾"
				},
				{
					"id": 745140103,
					"content": "朝雾？你怎么会在这里？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745140104
					]
				},
				{
					"id": 745140104,
					"content": "你的身体好了吗？居然能一个人来这么远的地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745140105,
					"content": "我…那个…好，好得差不多啦！你看，我都不咳嗽了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140106
					],
					"speakerTitle": "朝雾"
				},
				{
					"id": 745140106,
					"content": "哈哈…哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140107,
						745140108
					],
					"speakerTitle": "朝雾"
				},
				{
					"id": 745140107,
					"content": "真的吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745140109
					]
				},
				{
					"id": 745140109,
					"content": "呜哇！别啊！我承认了，我是自己偷偷跑出来的啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140110
					],
					"speakerTitle": "朝雾"
				},
				{
					"id": 745140110,
					"content": "我…我也没办法啊，老是窝在稻妻，怎么可能画出好看的画。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140111
					],
					"speakerTitle": "朝雾"
				},
				{
					"id": 745140111,
					"content": "就算有你帮我到处去留影，但说到底，画片肯定比不过实景啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140112
					],
					"speakerTitle": "朝雾"
				},
				{
					"id": 745140112,
					"content": "所以，我就拜托之前合作过的一个老师帮忙联系了一支商队，悄悄地出来旅行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140113
					],
					"speakerTitle": "朝雾"
				},
				{
					"id": 745140113,
					"content": "亏你还把画具都背过来了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745140114
					]
				},
				{
					"id": 745140114,
					"content": "那当然。画板可是我的灵魂，怎么能随便丢下它们呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140115
					],
					"speakerTitle": "朝雾"
				},
				{
					"id": 745140115,
					"content": "而且我的画在枫丹也卖得很好呀，还有几个枫丹的作家，请我给他们的小说画封面了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140116
					],
					"speakerTitle": "朝雾"
				},
				{
					"id": 745140116,
					"content": "不过…他们居然没有在小说中间插入插画的习惯呢。真没想到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140117
					],
					"speakerTitle": "朝雾"
				},
				{
					"id": 745140117,
					"content": "#对了，{NICKNAME}，刚巧你在这里…你愿意再帮我去取材吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140118,
						745140120
					],
					"speakerTitle": "朝雾"
				},
				{
					"id": 745140118,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745140119
					]
				},
				{
					"id": 745140119,
					"content": "好欸！有你帮忙我就放心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140123
					],
					"speakerTitle": "朝雾"
				},
				{
					"id": 745140123,
					"content": "好嘞…让我看看喔。正好我又接到了几个作家的约稿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "朝雾"
				},
				{
					"id": 745140120,
					"content": "行吧。你可别乱跑。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745140121
					]
				},
				{
					"id": 745140121,
					"content": "我知道啦。我可对付不了那些机关铁疙瘩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140122
					],
					"speakerTitle": "朝雾"
				},
				{
					"id": 745140122,
					"content": "论起对付各类奇奇怪怪的魔物，当然还是你最在行啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140123
					],
					"speakerTitle": "朝雾"
				},
				{
					"id": 745140108,
					"content": "我可要写信回去问了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745140109
					]
				}
			]
		}
	]
}