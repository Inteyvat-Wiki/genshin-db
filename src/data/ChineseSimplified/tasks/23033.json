			"dialogs": [
				{
					"id": 230330801,
					"content": "就是这里了，让我看看…首先，我需要一个…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330802
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330802,
					"content": "角色陷入困境中的姿势…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330803
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330803,
					"content": "这描述也太模糊了，完全不知道要摆出什么样的姿势啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330804
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230330804,
					"content": "这个…就按照你的第一反应来摆姿势就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330805
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330805,
					"content": "旅行者，当你遇见困境的时候，你会做出什么样的反应？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330806,
						230330812
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330806,
					"content": "那当然是战斗了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230330807
					]
				},
				{
					"id": 230330807,
					"content": "嚯，很有气势的回答，面对困境的第一反应是战斗…那就请你摆出一个有力的战斗姿态来吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330808
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330808,
					"content": "就是那种…你已经陷入困境，必须要开始挣扎了的感觉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330809
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330809,
					"content": "这场战斗就是你为了活下去而做出的挣扎！为了活下去而不得不做出的选择！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330810
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330810,
					"content": "咳！这都是我为角色设计的台词…但总之，差不多就是这样的一种感觉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330811
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330811,
					"content": "唔唔…真有角色会说出这种话来吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230330812,
					"content": "我不会让自己陷入困境。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230330813
					]
				},
				{
					"id": 230330813,
					"content": "喔！你这个回答很有傲气啊，很不错，正好能和我小说里的一个人对上！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330814
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330814,
					"content": "那就拜托你摆出一个，很有傲气的姿势吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "福本"
				}
			]
		},
