			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"福本"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230330101,
					"content": "旅行者！又见面了，上次多亏你帮忙，朝雾小姐的插画创作得很顺利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330102,
						230330103
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330102,
					"content": "能帮上忙就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230330104
					]
				},
				{
					"id": 230330104,
					"content": "是啊，教令院的那帮学者还在讨论一些制作细节呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330105
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330105,
					"content": "有的学者说，既然是新版，那玩法就要有创意，游戏的资源系统也要有创意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330106
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330106,
					"content": "有的学者说，卡牌游戏一定要有精美的卡面，所以他要求把预算拨去雇更多的画家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330107
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330107,
					"content": "还有一位就更离谱了…他希望在所有参与制作「七圣召唤」的学者之间举办一场对战比赛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330108
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330108,
					"content": "谁能赢得冠军，谁的意见就更有份量。我看这个人就是单纯地想要玩「七圣召唤」而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330109
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330109,
					"content": "他们的讨论我几乎都听不懂，所以就借口取材跑了出来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330110
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330110,
					"content": "旅行者，你能再给我当一回模特吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330111
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330111,
					"content": "这次我没什么特别的要求，只需要你为我展示一下你的战斗技巧就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330112,
						230330113
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330112,
					"content": "你写的不是卡牌游戏小说吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230330114
					]
				},
				{
					"id": 230330114,
					"content": "你这就有所不知了，单纯地打牌已经没有市场了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330115
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330115,
					"content": "说实话，打牌变打架我都觉得有点俗气了，我都已经想让角色骑着马一边竞速一边打牌了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330116
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330116,
					"content": "不过我还没想好他们骑马打牌的原因…所以我决定还是先写一段打牌变打架的戏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330117
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330117,
					"content": "取景地我已经选好了，我们赶紧出发吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "福本"
				},
				{
					"id": 230330113,
					"content": "打牌和战斗有什么关系？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230330114
					]
				},
				{
					"id": 230330103,
					"content": "你今天还是来取材吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230330104
					]
				}
			]
		},
		{
			"id": 2303303,
			"completionStepIds": [
				2303303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
