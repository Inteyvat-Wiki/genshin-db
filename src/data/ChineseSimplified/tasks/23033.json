			"dialogs": [
				{
					"id": 230338101,
					"content": "唉，这群学者的身体，真的没问题吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230338102
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230338102,
					"content": "学者怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230338103
					]
				},
				{
					"id": 230338103,
					"content": "咳，别提了。还不是「七圣召唤」的事，那群学者成天不眠不休的研究，我真担心「七圣召唤」的规则没出来，他们自己的身体先垮了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230338104
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230338104,
					"content": "不过，他们似乎已经设计出了游戏规则的大框架，我总算是有能参考的东西了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230338105
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230338105,
					"content": "我是不懂他们的工作…只能让学者们自己努力了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230338106
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230338106,
					"content": "至于我嘛…还是得接着解决小说的插画问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230338107
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230338107,
					"content": "上次多亏了你帮忙，朝雾小姐已经画了几张不错的插画。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230338108
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230338108,
					"content": "旅行者，如果你愿意帮忙的话，能再来做一次模特吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230338109,
						230338110
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230338109,
					"content": "好吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230338113
					]
				},
				{
					"id": 230338113,
					"content": "那做模特的事就拜托你了，旅行者。我会准备好报酬的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230338114
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230338114,
					"content": "我已经找到了一个不错的取景地，就在附近。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230338115
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230338115,
					"content": "等我收拾一下留影机，咱们就出发。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "福本"
				},
				{
					"id": 230338110,
					"content": "你还要取多少材？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230338111
					]
				},
				{
					"id": 230338111,
					"content": "哎呀，好不容易来一趟须弥，我当然得多取一点材。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230338112
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230338112,
					"content": "顺便…还能躲一下我的编辑…咳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230338113
					],
					"speakerTitle": "福本"
				}
			]
