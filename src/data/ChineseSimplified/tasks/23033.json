			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"福本"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230330601,
					"content": "坏了，这下真的被这帮须弥人给骗惨了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330602
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330602,
					"content": "你被骗钱了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230330603
					]
				},
				{
					"id": 230330603,
					"content": "哎哟！你…你吓我一跳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330604
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330604,
					"content": "唉，我倒是没有被骗钱，就是被教令院里的那群人给骗来了须弥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330605
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330605,
					"content": "还没自我介绍…我叫福本，是一个稻妻的小说家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330606
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330606,
					"content": "你说你被骗了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230330607
					]
				},
				{
					"id": 230330607,
					"content": "这事情说来话长…你听说教令院研发出的卡牌游戏「七圣召唤」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330608,
						230330609
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330608,
					"content": "七…七圣召唤？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230330610
					]
				},
				{
					"id": 230330610,
					"content": "你没听说过？不应该啊，你没看过我写的那本《召唤王》吗？在「八重堂」里可是卖得很好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330611
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330611,
					"content": "呃…《召唤王》也没看过？没，没问题，不用管这些！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330612
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330612,
					"content": "总之，就是须弥教令院里的人研发了一种名为「七圣召唤」的卡牌游戏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330613
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330613,
					"content": "为了推广，他们就通过「八重堂」来拜托我，以「七圣召唤」这种卡牌游戏的规则为蓝本，写一本轻小说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330614
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330614,
					"content": "因为那群学者自己都没把「七圣召唤」的规则梳理清楚，加上须弥和稻妻离得太远，我们难以沟通，所以写起来非常艰难…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330615
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330615,
					"content": "不过在「八重堂」内诸位老师的帮助下，我还是完成了《召唤王》，不仅销量不错，而且还和计划中一样带动了「七圣召唤」的销量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330616
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330616,
					"content": "然后，重点来了…那群学者说，他们要重新梳理一遍「七圣召唤」的规则，再对外推出一版全新的「七圣召唤」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330617
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330617,
					"content": "他们也再次拜托我以新版的「七圣召唤」为蓝本续写《召唤王》，并且邀请我来须弥教令院面对面沟通。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330618
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330618,
					"content": "我从稻妻长途跋涉来了须弥，但学者们说…新版「七圣召唤」的规则他们还没有确定下来，请我先在须弥暂住一段时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330619
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330619,
					"content": "他们说为了致歉，还会帮我介绍几个教令院里的名人作为我取材的对象，比如那位赛诺先生，还有提纳里先生…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330620
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330620,
					"content": "我本来有点生气，但是那群学者…每个人都是一副严重睡眠不足的样子，接待我的那位学者简直站都站不稳了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330621
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330621,
					"content": "唉，我想了想，本来我的大纲就还没有确定，再等一段时间也没什么大问题，就答应了他们暂时住在须弥，等他们把新规则确定下来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330622
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330622,
					"content": "这不，我今天就是出来取材的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330623
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330623,
					"content": "旅行者，你愿意帮我一个忙吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330624,
						230330625
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330624,
					"content": "你先说是什么…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230330626
					]
				},
				{
					"id": 230330626,
					"content": "是这样，为了让《召唤王》这本小说更有吸引力，我特意去拜托朝雾小姐来绘制插画。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330627
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330627,
					"content": "我已经想好了几个关键的情节，但除了文字描述外，我还要给朝雾小姐一点具体的姿势参考…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330628
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330628,
					"content": "但我可没什么战斗的经验，摆出来的几个姿势都软塌塌的，看起来一点精神都没有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330629
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330629,
					"content": "旅行者，我看你肯定有丰富的战斗经验，能拜托你来做模特吗？你瞧，我还借了架「留影机」来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330630,
						230330631
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330630,
					"content": "好吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230330633
					]
				},
				{
					"id": 230330633,
					"content": "谢谢你愿意帮忙，旅行者。我已经找到了一个不错的取景地，我们去那边吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "福本"
				},
				{
					"id": 230330631,
					"content": "拍得好看点喔。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230330632
					]
				},
				{
					"id": 230330632,
					"content": "没问题，你就放心吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330633
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330625,
					"content": "我不太会打牌…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230330626
					]
				},
				{
					"id": 230330609,
					"content": "卡牌游戏？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230330610
					]
				}
			]
		},
