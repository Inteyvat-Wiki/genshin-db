							"2303303",
							"2"
						],
						"stepId": 2303303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"福本"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230330301,
					"content": "就是这里了！你看前面，有几个零星的史莱姆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330302
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330302,
					"content": "旅行者，请你用你认为最帅气的方式，一口气打倒它们吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330303
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330303,
					"content": "这真的能用在卡牌游戏小说里吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230330304
					]
				},
				{
					"id": 230330304,
					"content": "哎呀，放心吧，虽然我写的小说里大部分事情都能靠打牌解决。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330305
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330305,
					"content": "但总有一些不能靠打牌解决的事，需要角色们运用一些「现实性」手段。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330306
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330306,
					"content": "那就拜托你了，旅行者。我会在这边看着的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "福本"
				}
			]
		},
		{
			"id": 2303305,
			"completionStepIds": [
				2303305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2303305",
							"2"
						],
						"stepId": 2303305,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"7066502",
							"0"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"福本"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230330501,
					"content": "太好了，非常好！这些画片肯定够朝雾再画好几张了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330502,
						230330503
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330502,
					"content": "想玩「七圣召唤」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230330504
					]
				},
				{
					"id": 230330504,
					"content": "哈哈哈…我会把你的愿望转达给学者们的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330505
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330505,
					"content": "不过，这群学者们的研究似乎进行得很顺利，现在他们讨论的时候都能打打趣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330506
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330506,
					"content": "不像最开始，咳…剑拔弩张的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "福本"
				},
				{
					"id": 230330503,
					"content": "期待「七圣召唤」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230330504
					]
				}
			]
		},
		{
