			"dialogs": [
				{
					"id": 766550101,
					"content": "菲林斯，你也上来了啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766550102,
					"content": "两位辛苦了，有人维护之后，这座灯塔的状态好了很多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550103
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 766550103,
					"content": "嘿嘿，举手之劳。不过就算我们再怎么维护灯塔，这里还是那么黑，总有灯塔照不到的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766550104,
					"content": "是的，和外面不同，坟场里的时间仿佛永远停在了夜晚，停在了那场战斗结束的晚上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550105
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 766550105,
					"content": "我原本无意改变这里的环境，是你们点亮了灯塔，推动了这里的时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550106,
						766550108
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 766550106,
					"content": "会影响你的生活吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766550107
					]
				},
				{
					"id": 766550107,
					"content": "如果你想问这样是否会给我带来不便，答案是否定的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550110
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 766550110,
					"content": "生命是轮回，即便没有我们，这座岛上的鬼魂们也会逐渐消散，回到地脉中去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550111
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 766550111,
					"content": "所以不用担心灯塔无法照亮整座岛，随着鬼魂逐渐消失，笼罩这里的雾气也会变淡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550112
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 766550112,
					"content": "太阳总要升起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 766550108,
					"content": "这是意外，抱歉。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766550109
					]
				},
				{
					"id": 766550109,
					"content": "请不要道歉，我并不厌恶这种改变。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550110
					],
					"speakerTitle": "菲林斯"
				}
			]
		}
	]
}