			"trigger": {
				"objectNames": [
					"安东尼",
					"安娜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200140101,
					"content": "安娜，你再好好想想，这件事我认为要从长计议才好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140102
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 200140102,
					"content": "哎呀，你就别担心我了，我肯定没问题的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140103,
						200140104
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200140103,
					"content": "安娜，你的身体还好吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140105
					]
				},
				{
					"id": 200140105,
					"content": "旅行者！你来得正好，快帮我劝劝安娜吧，她要去做冒险家！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140106
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 200140106,
					"content": "我为什么不能做冒险家？我现在身体很健康，塞琉斯叔叔也说我脑子很灵活，很适合做冒险家！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140107
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200140107,
					"content": "你病才好了多久？如果你去做冒险家，又折腾出病来怎么办？而且，爸妈也不会同意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140108
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 200140108,
					"content": "我和爸爸妈妈已经说过了，他们说，只要我能通过冒险家协会的考试，他们就同意我做冒险家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140109
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200140109,
					"content": "啊…啊？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140110,
						200140111
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 200140110,
					"content": "冷静…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140112
					]
				},
				{
					"id": 200140112,
					"content": "塞琉斯叔叔前几天刚帮我制订好了训练计划，我已经训练了好几天了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140113
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200140113,
					"content": "不过，那些计划上都是一些侦察啦，寻找应急食物啦，野外求生啦之类的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140114
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200140114,
					"content": "但我听说，冒险家也经常和野外的那些魔物搏斗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140115
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200140115,
					"content": "我很想学习这方面的事，但又找不到人教我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140116
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200140116,
					"content": "而且，我哥哥他也…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140117
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200140117,
					"content": "当然不行！那些魔物都很危险，就算要去，你也要找一个经验丰富的冒险家和你同行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140118
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 200140118,
					"content": "我之前不是找过杰克吗？他都答应我啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140119
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200140119,
					"content": "杰克那家伙我又不是不认识…他在野外连自己都照顾不好，怎么可能照顾得了你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140120
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 200140120,
					"content": "那协会里一时半会也找不到有经验的冒险家，我也没钱挂委托…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140121,
						200140122
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200140121,
					"content": "不如我陪你去吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140123
					]
				},
				{
					"id": 200140123,
					"content": "欸？你愿意帮我吗？太好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140124
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200140124,
					"content": "哥！这下你总可以放心了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140125
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200140125,
					"content": "这…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140126
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 200140126,
					"content": "#呼…好吧，旅行者的实力我是知道的，有{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}陪着，我可以稍微放心点了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140127
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 200140127,
					"content": "不过！你去野外的时候也要注意安全…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140128
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 200140128,
					"content": "…就是这些，你记住了没有？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140129
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 200140129,
					"content": "记住了，记住了…哥，你说得我头都要晕了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140130
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200140130,
					"content": "旅行者，我们快点出发吧，那个营地的位置我已经找杰克打听好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安娜"
				},
				{
					"id": 200140122,
					"content": "我对战斗也算有些心得。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140123
					]
				},
				{
					"id": 200140111,
					"content": "那你训练得怎么样了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140112
					]
				},
				{
					"id": 200140104,
					"content": "安东尼，你们在做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140105
					]
				}
			]
		},
