			"dialogs": [
				{
					"id": 250250101,
					"content": "拜托啦，稍微上岸来一下好不好？我要打扫这边的池子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250102
					],
					"speakerTitle": "佩蕾·努伊"
				},
				{
					"id": 250250102,
					"content": "呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250103
					],
					"speakerTitle": "懒懒的鳍游龙"
				},
				{
					"id": 250250103,
					"content": "乖孩子，上来啦。不然我可要把你抱上来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250104
					],
					"speakerTitle": "佩蕾·努伊"
				},
				{
					"id": 250250104,
					"content": "呜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250105
					],
					"speakerTitle": "懒懒的鳍游龙"
				},
				{
					"id": 250250105,
					"content": "呜哇…一下子就游走了，这怎么能抱住它呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250106
					],
					"speakerTitle": "佩蕾·努伊"
				},
				{
					"id": 250250106,
					"content": "你在做什么呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250250107
					]
				},
				{
					"id": 250250107,
					"content": "欸？你是来泡温泉的吗？不好意思，我正在清理这边的池子，可能你要稍等一会了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250108
					],
					"speakerTitle": "佩蕾·努伊"
				},
				{
					"id": 250250108,
					"content": "而且，这孩子说什么也不肯上岸来。唉…我还有很多池子要清理啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250109
					],
					"speakerTitle": "佩蕾·努伊"
				},
				{
					"id": 250250109,
					"content": "难道是我前几天强行把它抱出来，让这孩子生气了吗？真是难搞…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "佩蕾·努伊"
				}
			]
