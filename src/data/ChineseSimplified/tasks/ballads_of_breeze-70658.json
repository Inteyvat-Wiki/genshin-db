			"dialogs": [
				{
					"id": 706580101,
					"content": "你好，有尽情享受风花节吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706580102,
						706580103
					],
					"speakerTitle": "莉兹"
				},
				{
					"id": 706580102,
					"content": "多谢你的推荐。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706580104
					]
				},
				{
					"id": 706580104,
					"content": "嘿嘿，那我这里还有一项很轻松的活动，它的名字叫「风物之歌」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706580105
					],
					"speakerTitle": "莉兹"
				},
				{
					"id": 706580105,
					"content": "想必你在蒙德城见过了吟游诗人吧，参加这次的活动，你就能像他们一样演奏出好听的曲子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706580106
					],
					"speakerTitle": "莉兹"
				},
				{
					"id": 706580106,
					"content": "高山上，湖水边，感受着风的气息，全神贯注地演奏一曲，一定能让你把烦心事都忘光。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706580107,
						706580108
					],
					"speakerTitle": "莉兹"
				},
				{
					"id": 706580107,
					"content": "没有这方面的经验…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706580109
					]
				},
				{
					"id": 706580109,
					"content": "不用担心，这个活动就是为了让没有演奏经验的人也能享受到音乐的乐趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706580110
					],
					"speakerTitle": "莉兹"
				},
				{
					"id": 706580110,
					"content": "只要跟上提示，跟上节拍，接下来的都不是什么问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706580111,
						706580112
					],
					"speakerTitle": "莉兹"
				},
				{
					"id": 706580111,
					"content": "那我放心了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706580113
					]
				},
				{
					"id": 706580113,
					"content": "嗯嗯，祝你能度过一个快快乐乐的风花节！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莉兹"
				},
				{
					"id": 706580112,
					"content": "我这就去试试看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706580113
					]
				},
				{
					"id": 706580108,
					"content": "真的会好听吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706580109
					]
				},
