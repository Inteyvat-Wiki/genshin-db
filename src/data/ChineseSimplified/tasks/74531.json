			"dialogs": [
				{
					"id": 745310101,
					"content": "#{NICKNAME}大人，派蒙，你们回来啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310102,
						745310103
					],
					"speakerTitle": "妮内特"
				},
				{
					"id": 745310102,
					"content": "这回拍了不少画片。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745310104
					]
				},
				{
					"id": 745310104,
					"content": "太好了！这次真的非常感谢你们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310105
					],
					"speakerTitle": "妮内特"
				},
				{
					"id": 745310105,
					"content": "在你们帮忙留影的时候，我想着，我不能什么都不做，要不然，就会一直原地踏步了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310106
					],
					"speakerTitle": "妮内特"
				},
				{
					"id": 745310106,
					"content": "所以，我鼓起勇气，去拜托了一些路人。然后，我也努力拍了很多画片哦！测试数据应该这样就足够了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310107
					],
					"speakerTitle": "妮内特"
				},
				{
					"id": 745310107,
					"content": "#哼哼，不愧是我的徒弟！也多亏了{NICKNAME}愿意出手相助啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310108
					],
					"speakerTitle": "乐平波琳"
				},
				{
					"id": 745310108,
					"content": "乐平波琳！你什么时候回来的？妮内特说你最近在忙别的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745310109,
					"content": "那当然是能让我赚到盆满钵满的大——生——意——了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310110
					],
					"speakerTitle": "乐平波琳"
				},
				{
					"id": 745310110,
					"content": "前阵子实在是抽不开身，妮内特多亏有你们关照了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310111
					],
					"speakerTitle": "乐平波琳"
				},
				{
					"id": 745310111,
					"content": "这孩子，技术和审美都没得说，就是胆子小了点。有你们帮忙，她也算是踏出重要的一步了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310112
					],
					"speakerTitle": "乐平波琳"
				},
				{
					"id": 745310112,
					"content": "所以你到底在忙什么大生意啦？神神秘秘的。不会又听说了什么奇怪的新闻，要把全部身家砸进去了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745310113,
					"content": "怎么可能！我乐平波琳也是会吸取教训的好吧！这次可是千真万确、稳赚不赔的超级大项目！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310114
					],
					"speakerTitle": "乐平波琳"
				},
				{
					"id": 745310114,
					"content": "（总觉得有点不放心…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745310115
					]
				},
				{
					"id": 745310115,
					"content": "哼哼，现在说出来就没意思了。等成品出来，我会第一时间邀请你们来体验的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "乐平波琳"
				},
				{
					"id": 745310103,
					"content": "「瞬影」镜头的效果很不错。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745310104
					]
				}
			]
		}
	]
