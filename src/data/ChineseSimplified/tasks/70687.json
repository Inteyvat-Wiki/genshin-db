			},
			"dialogs": [
				{
					"id": 706870101,
					"content": "客人客人，请到这边来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706870102
					],
					"speakerTitle": "小狼"
				},
				{
					"id": 706870102,
					"content": "魔女小姐的朋友，也是会占卜魔法的魔女小姐，为两位带来了一份新的礼物！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706870103
					],
					"speakerTitle": "小狼"
				},
				{
					"id": 706870103,
					"content": "哇啊，好漂亮的水晶球！而且看上去好贵的样子，要是卖给玛格丽特小姐，说不定能卖出一千万，不，是两千万摩拉——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706870104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706870104,
					"content": "咳…开玩笑的，开玩笑的啦。所以，这个是做什么用的呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706870105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706870105,
					"content": "会占卜的魔女小姐说，「既然有巫师，那就要有像样的玻璃球才行」。有了它，客人说不定会看到过去看不到的，超厉害的舞台…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706870106
					],
					"speakerTitle": "小狼"
				},
				{
					"id": 706870106,
					"content": "我也不是太清楚她的意思啦，毕竟我只是普通的「礼宾员」，就算盯着玻璃球看，也只能看到自己的模样，呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706870107
					],
					"speakerTitle": "小狼"
				},
				{
					"id": 706870107,
					"content": "啊，对了对了，这个盒子也是魔女小姐送给两位客人的礼物！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706870108
					],
					"speakerTitle": "小狼"
				},
				{
					"id": 706870108,
					"content": "「要是能在隐秘的舞台上，为观众奉上如命运般无法预测的精彩表演，就可以找到装进这个盒子的珍贵藏品」…她是这么说的喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706870109
					],
					"speakerTitle": "小狼"
				},
				{
					"id": 706870109,
					"content": "珍、珍贵的藏品？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706870110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706870110,
					"content": "「礼宾员」要是说太多，就会破坏故事的神秘感啦。那么，就请两位客人和往常一样，向着新的舞台勇敢前进吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小狼"
				}
			]
		}
	]
}