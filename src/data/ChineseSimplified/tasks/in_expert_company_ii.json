			"dialogs": [
				{
					"id": 741140201,
					"content": "唉，那些映影画片不会被水泡坏吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140202
					],
					"speakerTitle": "邱老板"
				},
				{
					"id": 741140202,
					"content": "放心吧老板，这个箱子可牢靠了，水渗不进去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140203
					],
					"speakerTitle": "弈丰"
				},
				{
					"id": 741140203,
					"content": "还好我们的映影机没有掉进水里，不然可就完蛋了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兴晔"
