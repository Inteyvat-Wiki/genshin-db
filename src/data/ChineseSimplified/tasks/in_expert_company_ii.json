			"dialogs": [
				{
					"id": 741140401,
					"content": "这锅还真是奇特，唔…但用法应该和璃月的一样吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140402
					],
					"speakerTitle": "邱老板"
				},
				{
					"id": 741140402,
					"content": "老板，菜都买回来了，但那家店里的茉洁草都卖光了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140403
					],
					"speakerTitle": "兴晔"
				},
				{
					"id": 741140403,
					"content": "我一时半会也找不到其他店卖这个…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140404
					],
					"speakerTitle": "兴晔"
				},
				{
					"id": 741140404,
					"content": "#这…就差这一份食材。那个，{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140405,
						741140406
					],
					"speakerTitle": "邱老板"
				},
				{
					"id": 741140405,
					"content": "我去拿点回来吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140407
					]
				},
				{
					"id": 741140407,
					"content": "多谢您帮忙。放心，我懂冒险家的规矩，绝不会让你白跑的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "邱老板"
				},
				{
					"id": 741140406,
					"content": "一起算进报酬里。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140407
					]
				}
			]
		},
