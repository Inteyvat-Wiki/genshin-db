			},
			"dialogs": [
				{
					"id": 741140601,
					"content": "#{NICKNAME}，向您介绍，这就是那位映影大师，热塞尔先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140602
					],
					"speakerTitle": "邱老板"
				},
				{
					"id": 741140602,
					"content": "#热塞尔先生，这是{NICKNAME}，一位身手高强的冒险家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140603
					],
					"speakerTitle": "邱老板"
				},
				{
					"id": 741140603,
					"content": "#您要是以后准备拍武打类的映影，{NICKNAME}绝对能做一号演员！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140604
					],
					"speakerTitle": "邱老板"
				},
				{
					"id": 741140604,
					"content": "呵呵，邱老板也说得太夸张了，我并不是什么映影大师。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140605
					],
					"speakerTitle": "热塞尔"
				},
				{
					"id": 741140605,
					"content": "我只不过是对映影中的光影运用方式略有研究罢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140606
					],
					"speakerTitle": "热塞尔"
				},
				{
					"id": 741140606,
					"content": "哎呀，您太谦虚了。您那些映影里的光影，简直都能开口说话啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140607,
						741140609
					],
					"speakerTitle": "邱老板"
				},
				{
					"id": 741140607,
					"content": "映影中的光影运用方式？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140608
					]
				},
				{
					"id": 741140608,
					"content": "是的。在我的映影理论中，光影的运用，即是情绪的运用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140611
					],
					"speakerTitle": "热塞尔"
				},
				{
					"id": 741140611,
					"content": "但是…怎么说呢，现在枫丹的映影界里，我的这种理论暂时没有受到重视。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140612
					],
					"speakerTitle": "热塞尔"
				},
				{
					"id": 741140612,
					"content": "大部分导演还是更喜欢用直接的动作，或者场景来表达映影故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140613
					],
					"speakerTitle": "热塞尔"
				},
				{
					"id": 741140613,
					"content": "我拍摄了好几部用纯粹的光影变化叙事的映影，几乎没有人感兴趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140614
					],
					"speakerTitle": "热塞尔"
				},
				{
					"id": 741140614,
					"content": "但是现在，总算有一位导演认为我的光影理论有价值了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140615
					],
					"speakerTitle": "热塞尔"
				},
				{
					"id": 741140615,
					"content": "导演？我？哈哈哈，您别开玩笑了，我之前只是个卖茶叶的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140616
					],
					"speakerTitle": "邱老板"
				},
				{
					"id": 741140616,
					"content": "谁说卖茶叶的商人不能做导演？我之前还只是一位记者呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140617
					],
					"speakerTitle": "热塞尔"
				},
				{
					"id": 741140617,
					"content": "记者…那您之前，肯定也很擅长写报道？就是报纸上的那种。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140618
					],
					"speakerTitle": "邱老板"
				},
				{
					"id": 741140618,
					"content": "算是吧。怎么了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140619
					],
					"speakerTitle": "热塞尔"
				},
				{
					"id": 741140619,
					"content": "嗯…那正好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140620
					],
					"speakerTitle": "邱老板"
				},
				{
					"id": 741140620,
					"content": "啊！没什么！没什么！咱们之后合作的时间还多的是啊，哈哈哈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140621
					],
					"speakerTitle": "邱老板"
				},
				{
					"id": 741140621,
					"content": "在邱老板爽朗的笑声中，大家都入了座。",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741140622
					]
				},
				{
					"id": 741140622,
					"content": "吃完饭后，邱老板又额外做了一份食物，打包完后，塞进了你的包里…",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 741140609,
					"content": "光影在映影里很重要吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140610
					]
				},
				{
					"id": 741140610,
					"content": "当然了。在我的映影理论中，光影是表达画面情绪的重要方式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140611
					],
					"speakerTitle": "热塞尔"
				}
			]
