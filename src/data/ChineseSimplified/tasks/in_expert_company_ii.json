			"dialogs": [
				{
					"id": 741140101,
					"content": "没关系，我们的那个箱子是防水的。现在我们只需要潜下去，把箱子捞上来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140102
					],
					"speakerTitle": "邱老板"
				},
				{
					"id": 741140102,
					"content": "老板，但我们三个人里谁都不会潜水啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140103
					],
					"speakerTitle": "兴晔"
				},
				{
					"id": 741140103,
					"content": "我倒是会游泳，但潜水真的一窍不通啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140104
					],
					"speakerTitle": "弈丰"
				},
				{
					"id": 741140104,
					"content": "我们…上次去冒险家协会发布的委托，还挂在委托板上吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140105
					],
					"speakerTitle": "邱老板"
				},
				{
					"id": 741140105,
					"content": "老板，你上次不是说要我们赶紧去把那委托给撤了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140106
					],
					"speakerTitle": "弈丰"
				},
				{
					"id": 741140106,
					"content": "我们昨天才把这件事给办了，协会那边说，今天就能把我们预付的委托费给退回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140107
					],
					"speakerTitle": "兴晔"
				},
				{
					"id": 741140107,
					"content": "呃…如果我们想重新发布委托，要交额外的手续费吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140108,
						741140109
					],
					"speakerTitle": "邱老板"
				},
				{
					"id": 741140108,
					"content": "你们拍好映影了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140110
					]
				},
				{
					"id": 741140110,
					"content": "#冒险家…{NICKNAME}，您真是我们的及时雨啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140111
					],
					"speakerTitle": "邱老板"
				},
				{
					"id": 741140111,
					"content": "您会潜水吗？或者说，您能帮忙找一位有空来帮忙的潜水员吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140112
					],
					"speakerTitle": "邱老板"
				},
				{
					"id": 741140112,
					"content": "你们要…到水下拍映影？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140113
					]
				},
				{
					"id": 741140113,
					"content": "我们可没那个本事，也买不起防水的映影设备。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140114
					],
					"speakerTitle": "弈丰"
				},
				{
					"id": 741140114,
					"content": "只是单纯因为，我们装映影画片的箱子掉进水里了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140115
					],
					"speakerTitle": "兴晔"
				},
				{
					"id": 741140115,
					"content": "#好了，你们俩可少说两句吧！{NICKNAME}，请您务必帮帮忙啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140116
					],
					"speakerTitle": "邱老板"
				},
				{
					"id": 741140116,
					"content": "报酬的事您不用担心，和上次一样，当面给您结清。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "邱老板"
				},
				{
					"id": 741140109,
					"content": "你们怎么在这里？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140110
					]
				}
			]
		},
