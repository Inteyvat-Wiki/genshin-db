			"dialogs": [
				{
					"id": 741140301,
					"content": "#哎哟，还是您靠谱，{NICKNAME}。还是您靠谱！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140302
					],
					"speakerTitle": "邱老板"
				},
				{
					"id": 741140302,
					"content": "要是没您帮忙，这一整箱的映影画片全得泡汤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140303
					],
					"speakerTitle": "邱老板"
				},
				{
					"id": 741140303,
					"content": "我们得先回城里，把这些映影画片交给热塞尔先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140304
					],
					"speakerTitle": "邱老板"
				},
				{
					"id": 741140304,
					"content": "#然后…再顺便吃顿饭。{NICKNAME}，如果您有兴趣的话，也请一起来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140305
					],
					"speakerTitle": "邱老板"
				},
				{
					"id": 741140305,
					"content": "等吃完了饭，我再把报酬给您结清。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140306,
						741140307
					],
					"speakerTitle": "邱老板"
				},
				{
					"id": 741140306,
					"content": "好啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140308
					]
				},
				{
					"id": 741140308,
					"content": "行！那事情就这么定了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140309
					],
					"speakerTitle": "邱老板"
				},
				{
					"id": 741140309,
					"content": "弈丰，等会你去把这箱子映影画片带去交给热塞尔先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140310
					],
					"speakerTitle": "邱老板"
				},
				{
					"id": 741140310,
					"content": "兴晔，你…去周围买点好菜。我最近研究了一下那道白淞鲜汤，今天正好给热塞尔先生露一手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140311
					],
					"speakerTitle": "邱老板"
				},
				{
					"id": 741140311,
					"content": "老板，我们都去饭馆吃饭了。您为什么非得自己上手？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140312
					],
					"speakerTitle": "兴晔"
				},
				{
					"id": 741140312,
					"content": "这不是…便宜吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140313
					],
					"speakerTitle": "邱老板"
				},
				{
					"id": 741140313,
					"content": "咳！事情就这么定了，赶紧出发。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140314
					],
					"speakerTitle": "邱老板"
				},
				{
					"id": 741140314,
					"content": "#{NICKNAME}，您就跟着我走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "邱老板"
				},
				{
					"id": 741140307,
					"content": "正好饿了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140308
					]
				}
			]
		},
