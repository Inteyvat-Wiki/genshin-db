			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"笼钓瓶一心"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120370401,
					"content": "嗯？原来你没有神之眼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370402
					],
					"speakerTitle": "笼钓瓶一心"
				},
				{
					"id": 120370402,
					"content": "看来是我认错人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370403
					],
					"speakerTitle": "笼钓瓶一心"
				},
				{
					"id": 120370403,
					"content": "至少先看清楚了再动手啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120370404,
					"content": "不对…不管你要找谁，突然攻击别人就很危险了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120370405,
					"content": "你们见过吗？一个叫枫原万叶的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370406
					],
					"speakerTitle": "笼钓瓶一心"
				},
				{
					"id": 120370406,
					"content": "和你一样，都用单手剑。我还听说他有风元素力的神之眼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370407
					],
					"speakerTitle": "笼钓瓶一心"
				},
				{
					"id": 120370407,
					"content": "你找他干什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370408
					]
				},
				{
					"id": 120370408,
					"content": "和你没关系。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370409
					],
					"speakerTitle": "笼钓瓶一心"
				},
				{
					"id": 120370409,
					"content": "算了，看你也不知道，浪费时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370410
					],
					"speakerTitle": "笼钓瓶一心"
				},
				{
					"id": 120370410,
					"content": "这人到底怎么回事，就知道拿怪怪的刀乱挥，还莫名其妙的，连句道歉都不讲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120370411,
					"content": "怎么可能随便就把万叶的消息告诉这种人啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370412,
						120370414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120370412,
					"content": "说得没错。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370413
					]
				},
				{
					"id": 120370413,
					"content": "是吧，虽然我觉得如果是堂堂正正的对决，他也不能拿万叶怎么样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370416
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120370416,
					"content": "以防万一，我们还是要赶快通知万叶，让他小心提防。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370417
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120370417,
					"content": "其实我有点想法。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370418
					]
				},
				{
					"id": 120370418,
					"content": "嗯？什么想法？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370419
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120370419,
					"content": "他可能和万叶有特殊的关系。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370420
					]
				},
				{
					"id": 120370420,
					"content": "特殊的关系？你是想说他认识万叶吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370421,
						120370422
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120370421,
					"content": "虽然只是很模糊的感觉…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370423
					]
				},
				{
					"id": 120370423,
					"content": "嗯，好像是有点。但大家的招数看起来都差不多吧，这也说明不了什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370424
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120370424,
					"content": "总之我们快去给万叶提个醒吧，免得他遇到危险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370425
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120370425,
					"content": "我听说「南十字」船队最近在离岛补充货物，他应该就在那边。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120370422,
					"content": "他的招式和万叶有点像。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370423
					]
				},
				{
					"id": 120370414,
					"content": "难得机灵了一次。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370415
					]
				},
				{
					"id": 120370415,
					"content": "喂，这我就不开心了，我一直都很机灵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370416
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 1203705,
			"completionStepIds": [
				1203705
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1203705",
							"2"
						],
						"stepId": 1203705,
						"stateName": "QUEST_STATE_UNFINISHED"
