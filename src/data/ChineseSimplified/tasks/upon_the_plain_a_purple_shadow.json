				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"潮哥"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120370501,
					"content": "嘿，你好，你知道万叶在哪里吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120370502,
					"content": "你们也是来找万叶的啊，看来他真的做了很了不起的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370503
					],
					"speakerTitle": "潮哥"
				},
				{
					"id": 120370503,
					"content": "「也」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370504
					]
				},
				{
					"id": 120370504,
					"content": "哈哈哈，这次我们驾着小船来补充物资。结果刚进港，就来了好多好多稻妻人，和我们打听万叶的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370505
					],
					"speakerTitle": "潮哥"
				},
				{
					"id": 120370505,
					"content": "要说之前名椎滩那场战斗，大姐头也出了很多风头啊，我也没见大姐头有这么高的人气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370506
					],
					"speakerTitle": "潮哥"
				},
				{
					"id": 120370506,
					"content": "在船队里，万叶的存在感不算强。有时候他还不听大姐头的话，但大姐头也不在意，唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370507
					],
					"speakerTitle": "潮哥"
				},
				{
					"id": 120370507,
					"content": "原来你还不知道他做了什么啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120370508,
					"content": "稍微听到了一些，比如挡下了雷电将军「无想的一刀」之类的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370509
					],
					"speakerTitle": "潮哥"
				},
				{
					"id": 120370509,
					"content": "那个很厉害吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370510
					],
					"speakerTitle": "潮哥"
				},
				{
					"id": 120370510,
					"content": "就像北斗斩灭海山的那一下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370511
					]
				},
				{
					"id": 120370511,
					"content": "哦，这么解释的话我一下子就理解了。哈哈哈，那他这么受人追捧，也是应该的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370512
					],
					"speakerTitle": "潮哥"
				},
				{
					"id": 120370512,
					"content": "他早些时候被天领奉行的人叫走了，说是有重要的事情要和他谈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370513
					],
					"speakerTitle": "潮哥"
				},
				{
					"id": 120370513,
					"content": "一开始我还以为是来抓人的呢。结果对方的态度特别友好，感觉他很受尊敬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370514
					],
					"speakerTitle": "潮哥"
				},
				{
					"id": 120370514,
					"content": "放在不久之前，根本完全无法想象…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370515,
						120370516
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120370515,
					"content": "幕府也想表示友好吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370517
					]
				},
				{
					"id": 120370517,
					"content": "谢谢你啦，那我们去天领奉行府看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370518
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120370518,
					"content": "嗯，我就在这边继续应付围观的人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "潮哥"
				},
				{
					"id": 120370516,
					"content": "毕竟雷电将军的态度变了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370517
					]
				}
			]
		},
		{
			"id": 1203706,
			"completionStepIds": [
				1203706
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1203706",
							"2"
						],
						"stepId": 1203706,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"枫原万叶",
					"九条镰治"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120370601,
					"content": "#哦？是你啊，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370602
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 120370602,
					"content": "你们好。我们刚刚聊到之前废除「眼狩令」的事，既然你们来了，就一起听一听吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370603
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 120370603,
					"content": "这次请枫原万叶先生来，主要是想表达幕府这边的友好态度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370604
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 120370604,
					"content": "正因有你们的努力，才促成了如今光明的局面。我也有机会纠正家族曾犯下的错误，对此我非常感激。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370605
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 120370605,
					"content": "将军大人正在从很多方面入手，消解或柔化过去积攒的矛盾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370606
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 120370606,
					"content": "三奉行提议，希望借此契机恢复枫原家的名誉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370607
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 120370607,
					"content": "有关枫原家的事，你应该也略知一二吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370608,
						120370609
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 120370608,
					"content": "有所耳闻。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370610
					]
				},
				{
					"id": 120370610,
					"content": "简而言之，稻妻过去有一批御用刀匠，继承了将军大人的锻刀技术并发扬光大，枫原家便是其中一族。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370611
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 120370611,
					"content": "但某个时期，有部分刀匠叛逃去了至冬国，枫原家与神里家均因管理不力被追责，经历了剧烈的动荡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370612
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 120370612,
					"content": "不过后来我们得知，此事的幕后主导是愚人众。将过错全都归咎于枫原与神里两家的做法并不妥当，也很不公平。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370613
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 120370613,
					"content": "此番枫原万叶先生又立下重大功劳，将军大人认为不只应给予奖励，还要为曾经的过当处置进行补偿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370614
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 120370614,
					"content": "但为了避免刀匠家族再度受到愚人众的迫害，我们并没有公开此事的调查结果，还请见谅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370615
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 120370615,
					"content": "言重了，能有机会接受将军大人和幕府的好意，我很高兴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370616
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 120370616,
					"content": "只不过，这份好意应该不是免费的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370617
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 120370617,
					"content": "你多虑了，这是「补偿」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370618
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 120370618,
					"content": "恢复名誉之后，枫原家便可重兴锻刀之业，你也不用继续四处漂泊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370619
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 120370619,
					"content": "在将军大人的庇护与幕府的支持下，你可以在稻妻城过上安稳富足的生活。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370620
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 120370620,
					"content": "我常年行走于风雨之中，恐怕会不习惯高宅大院中的日子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370621
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 120370621,
					"content": "不过我的祖先们，一直都为枫原之名和他们传承的锻刀技术而骄傲，我的确有为他们正名的责任。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370622
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 120370622,
					"content": "听起来你还有点犹豫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370623
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 120370623,
					"content": "若你能答应，我想最近流传在市井之中很多关于你的谣言中伤也会消失。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370624
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 120370624,
					"content": "谣言中伤？一路上只听到好话，都快把他吹到天上去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370625
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120370625,
					"content": "对有些人来说，「无想的一刀」是无法战胜的存在，他们不能接受枫原先生就这么接下了那一刀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370626
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 120370626,
					"content": "那时有人目击了他除了风还使用了雷元素力，于是「枫原万叶使用了邪眼」的消息不胫而走…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370627
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 120370627,
					"content": "啊？可是，使用邪眼的人会飞快地衰老，万叶他又没有变成那个样子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370628
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120370628,
					"content": "嗯，但对他们来说，还是一个人同时使用两种元素力这件事更难以理解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370629
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 120370629,
					"content": "与此类似的传闻还有很多，我很不适应处于舆论的中心，被人追逐或是猜忌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370630
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 120370630,
					"content": "但若幕府愿意支持我，这件事的风浪或许会更快平静下去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370631
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 120370631,
					"content": "所以你可以积极地考虑一下，对我们来说应该都是一件好事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370632
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 120370632,
					"content": "嗯，容我考虑一番吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370633
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 120370633,
					"content": "此事的讨论先告一段落。你们两位为什么会找到这里来？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370634
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 120370634,
					"content": "啊，差点就把重要的事忘记了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370635
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120370635,
					"content": "将野外袭击者的事告诉了枫原万叶。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						120370636
					]
				},
				{
					"id": 120370636,
					"content": "这样危险的人物在找我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370637,
						120370638
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 120370637,
					"content": "你有兄弟姐妹吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370639
					]
				},
				{
					"id": 120370639,
					"content": "没有，现在我也很困惑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370640
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 120370640,
					"content": "我的武技是家人教给我的，原本用于试刀。为了在试斩的时候斩出端正的刀路，公平地验证每一把刀的质量，我们会进行大量训练。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370641
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 120370641,
					"content": "久而久之，也就形成了一套家族内的试刀术，也诞生了相应的技巧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370642
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 120370642,
					"content": "这与实用的战场武技很不一样，很难想象只是巧合…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370643
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 120370643,
					"content": "那你就更要小心了，感觉这个人莫名其妙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370644
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120370644,
					"content": "嗯，他攻击性如此之强，如果对他人动手，很容易引起不好的后果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370645
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 120370645,
					"content": "既然如此，我马上派人去搜查一番。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370646
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 120370646,
					"content": "嗯，麻烦你了。我对这件事也比较好奇，这样吧，关于你方才的提议，正巧我也需要一段时间考虑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370647
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 120370647,
					"content": "#我和{M#他们}{F#她们}先去调查袭击者的事，之后再给你一个明确的答复。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370648
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 120370648,
					"content": "好的，那你们也要注意安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370649
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 120370649,
					"content": "走吧，我们去把那个袭击者找出来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 120370638,
					"content": "你有同门师兄弟吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370639
					]
				},
				{
					"id": 120370609,
					"content": "没印象了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370610
					]
				}
			]
		},
