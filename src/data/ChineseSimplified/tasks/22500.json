				"objectNames": [
					"莺儿"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 225000201,
					"content": "哎呀，又是你，这次来找我是想做什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000202
					],
					"speakerTitle": "莺儿"
				},
				{
					"id": 225000202,
					"content": "来取璐璐的东西。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000203
					]
				},
				{
					"id": 225000203,
					"content": "那孩子的东西啊…我记起来了，她确实让我帮她做一份香膏…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000204
					],
					"speakerTitle": "莺儿"
				},
				{
					"id": 225000204,
					"content": "不过，你们来得有些不巧…不知道为什么，自从那天你们来找我之后，突然有很多人来找我预定香膏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000205
					],
					"speakerTitle": "莺儿"
				},
				{
					"id": 225000205,
					"content": "那么多订单，我还得打理店里的生意，一个人都要处理不来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000206
					],
					"speakerTitle": "莺儿"
				},
				{
					"id": 225000206,
					"content": "而且璐璐还是个孩子，平常我们大人用的香膏如果直接给她用的话，未免有些不太合适。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000207
					],
					"speakerTitle": "莺儿"
				},
				{
					"id": 225000207,
					"content": "我之前在想怎么调整香膏的配方，才刚刚想出个方案来，还没开始做呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000208
					],
					"speakerTitle": "莺儿"
				},
				{
					"id": 225000208,
					"content": "如果要加急的话，倒也不是不行，可是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000209
					],
					"speakerTitle": "莺儿"
				}
			]
		},
		{
