				"points": []
			},
			"dialogs": [
				{
					"id": 225000301,
					"content": "三千摩拉够了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000302
					]
				},
				{
					"id": 225000302,
					"content": "你可真是个急性子…好吧，就当看在我们情谊的份儿上，我会先做璐璐的那份香膏的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000303
					],
					"speakerTitle": "莺儿"
				},
				{
					"id": 225000303,
					"content": "不过，白天我还得看店，只有晚上才能做些私事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000304
					],
					"speakerTitle": "莺儿"
				},
				{
					"id": 225000304,
					"content": "请你晚上再来找我吧，我会先把准备工作做好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莺儿"
				}
			]
		},
		{
			"id": 2250004,
			"completionStepIds": [
				2250002
			],
