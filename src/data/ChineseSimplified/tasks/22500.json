			},
			"dialogs": [
				{
					"id": 225000401,
					"content": "我来帮你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000402
					]
				},
				{
					"id": 225000402,
					"content": "嗯，这样也好，你在这种事上的丰富经验…我再清楚不过了，呵呵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000403
					],
					"speakerTitle": "莺儿"
				},
				{
					"id": 225000403,
					"content": "我这边还有之前没用完的原料，我会去卯师傅的厨房处理一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000404
					],
					"speakerTitle": "莺儿"
				},
				{
					"id": 225000404,
					"content": "你先去采三株薄荷，再把薄荷拿到合成台上去制成精油吧，制作的手法你应该很了解了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000405
					],
					"speakerTitle": "莺儿"
				},
				{
					"id": 225000405,
					"content": "把薄荷精油拿给我，我来帮忙把璐璐的香膏做好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莺儿"
				}
			]
		},
		{
