					"莺儿"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 225000501,
					"content": "香膏已经做好了，是我用薄荷精油特别制作的喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000502
					],
					"speakerTitle": "莺儿"
				},
				{
					"id": 225000502,
					"content": "来，拿好了，带回去给璐璐吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000503,
						225000504
					],
					"speakerTitle": "莺儿"
				},
				{
					"id": 225000503,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 225000504,
					"content": "为什么是薄荷精油？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000505
					]
				},
				{
					"id": 225000505,
					"content": "稀释一些刺激性的成分…略微中和一下气味…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000506
					],
					"speakerTitle": "莺儿"
				},
				{
					"id": 225000506,
					"content": "话说回来，当时也真是没想到会收到璐璐的订单呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000507
					],
					"speakerTitle": "莺儿"
				},
				{
					"id": 225000507,
					"content": "情窦初开的年纪，回想一下真是令人脸红心跳啊，要是当时懂得再多一点的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000508
					],
					"speakerTitle": "莺儿"
				},
				{
					"id": 225000508,
					"content": "咳…好了，快点拿回去给璐璐吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莺儿"
				}
			]
		},
