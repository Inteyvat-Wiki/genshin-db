					"璐璐"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 225000101,
					"content": "什么时候才能做好呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000102
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 225000102,
					"content": "今天没玩游戏吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000103
					]
				},
				{
					"id": 225000103,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，是你呀，最近不适合玩游戏呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000104
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 225000104,
					"content": "小蒙好像有点不开心，老是一个人发呆，阿飞也时不时就找不到人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000105
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 225000105,
					"content": "我问小蒙怎么了，小蒙也不和我说…总觉得，大家最近都有点奇怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000106,
						225000110
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 225000106,
					"content": "长大了就会这样。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000107
					]
				},
				{
					"id": 225000107,
					"content": "人长大了，就会不开心吗？但是小蒙和阿飞都很想长大…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000108
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 225000108,
					"content": "如果是这样的话，那我还是先不长大比较好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000109
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 225000109,
					"content": "#先不说这个了，我有点小事，想请{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}帮忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000112
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 225000112,
					"content": "你能帮我去莺儿姐姐那里拿点东西吗？我和她已经说好了，那里应该已经把东西留给我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000113,
						225000115
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 225000113,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000114
					]
				},
				{
					"id": 225000114,
					"content": "#那就拜托{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "璐璐"
				},
				{
					"id": 225000115,
					"content": "从莺儿那里…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000116
					]
				},
				{
					"id": 225000116,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}可不要瞎想喔，我只是拜托莺儿姐姐帮忙做了点东西而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000117
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 225000117,
					"content": "#总之，就拜托{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "璐璐"
				},
				{
					"id": 225000110,
					"content": "你也不开心吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000111
					]
				},
				{
					"id": 225000111,
					"content": "#我？我还好喔，不过…还是有点小事想请{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}帮忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000112
					],
					"speakerTitle": "璐璐"
				}
			]
		},
		{
