					"content": "奴家累了。以后再说吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500508
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220500508,
					"content": "还有以后喔！",
