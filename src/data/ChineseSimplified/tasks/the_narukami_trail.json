					"「寝子」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220500201,
					"content": "「鸣神大社」…就是这里吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500202
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220500202,
					"content": "红色的门有好多。人类很喜欢红色的门吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500203
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220500203,
					"content": "这个叫「鸟居」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500204
					]
				},
				{
					"id": 220500204,
					"content": "浅濑神社也有呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220500205,
					"content": "哦哦奴家明白了，原来那就是「鸟居」啊。也就是鸟居住的地方对吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500206
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220500206,
					"content": "所以鸟居越多，鸟就越多吧。鸟，那可是好东西。人类也挺聪明的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500207
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220500207,
					"content": "汝等，看见阿响在哪了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500208
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220500208,
					"content": "没发现人的踪迹…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500209
					]
				},
				{
					"id": 220500209,
					"content": "这周围，好像都没有人的样子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220500210,
					"content": "不如，我们上去「鸣神大社」，问问里面的那些巫女小姐吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220500211,
					"content": "那位「阿响」应该也是巫女…说不定，她们会知道些什么呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 2205003,
			"completionStepIds": [
				2205003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2205003",
							"2"
						],
						"stepId": 2205003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「寝子」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220500301,
					"content": "喵喵，这神社可真大，也有很多人类呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500302
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220500302,
					"content": "喔！塞钱箱和架子也很气派，怪不得有这么多人来这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500303
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220500303,
					"content": "汝等好好学。以后，浅濑神社也要变成这样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500304,
						220500305
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220500304,
					"content": "应该不是这方面的原因啦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500306
					]
				},
				{
					"id": 220500306,
					"content": "不过，还是没看到阿响哪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500307
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220500307,
					"content": "总、总之，我们找人问问关于「阿响」的事吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220500305,
					"content": "为什么是我要好好学？！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500306
					]
				}
			]
		},
		{
			"id": 2205004,
			"completionStepIds": [
				2205004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2205004",
							"2"
						],
						"stepId": 2205004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"稻城萤美",
					"「寝子」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220500401,
					"content": "你好，远道而来的旅者，欢迎来到「鸣神大社」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500402
					],
					"speakerTitle": "稻城萤美"
				},
				{
					"id": 220500402,
					"content": "如果有烦恼或者心愿，可以来这里求签，雷神会保佑你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500403
					],
					"speakerTitle": "稻城萤美"
				},
				{
					"id": 220500403,
					"content": "我们不是来求签的，是有一件事想要请问你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220500404,
					"content": "问我？喔…那请说吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500405
					],
					"speakerTitle": "稻城萤美"
				},
				{
					"id": 220500405,
					"content": "是这样的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500406
					]
				},
				{
					"id": 220500406,
					"content": "浅濑神社的…阿响？难道是「浅濑响」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500407
					],
					"speakerTitle": "稻城萤美"
				},
				{
					"id": 220500407,
					"content": "对！阿响就是「浅濑响」，人类！汝认识阿响吗？知道她在哪里吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500408
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220500408,
					"content": "嗯…咦？！这只猫怎么会说话，是我听错了吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500409
					],
					"speakerTitle": "稻城萤美"
				},
				{
					"id": 220500409,
					"content": "人类真是喜欢大惊小怪啊…奴家会说话是件很奇怪的事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500410
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220500410,
					"content": "汝，认识阿响吗？知道她在哪里吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500411
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220500411,
					"content": "被一只猫这么追问，感觉还真是奇怪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500412
					],
					"speakerTitle": "稻城萤美"
				},
				{
					"id": 220500412,
					"content": "不过，如果你们问的真的是那位「浅濑响」的话，那你们找错地方了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500413
					],
					"speakerTitle": "稻城萤美"
				},
				{
					"id": 220500413,
					"content": "欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220500414,
					"content": "找错了…地方？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500415
					]
				},
				{
					"id": 220500415,
					"content": "我之前在神社少数保存完整的典籍里读到过她的名字。她是浅濑神社最后一代…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500416
					],
					"speakerTitle": "稻城萤美"
				},
				{
					"id": 220500416,
					"content": "大约四五百年前，曾经有「影向役者三人组」的说法。浅濑响、惟神晴之介、御舆长正曾经在影向山上，向影向天狗求学。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500417
					],
					"speakerTitle": "稻城萤美"
				},
				{
					"id": 220500417,
					"content": "期间浅濑在我们神社见习过，也与狐斋宫大人结交。不过，最后…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500418
					],
					"speakerTitle": "稻城萤美"
				},
				{
					"id": 220500418,
					"content": "三人最终似乎是在一场记事中语焉不详的「灾难」后分道扬镳了。据说，惟神渡海去了璃月，想要学习更强大的「仙家道法」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500419
					],
					"speakerTitle": "稻城萤美"
				},
				{
					"id": 220500419,
					"content": "御舆回到了稻妻城，为幕府效力。浅濑则…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500420,
						220500421
					],
					"speakerTitle": "稻城萤美"
				},
				{
					"id": 220500420,
					"content": "回到了清籁岛…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500422
					]
				},
				{
					"id": 220500422,
					"content": "嗯，没错。不过因为可考的史料太少，所以具体的情况也不太清楚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500423
					],
					"speakerTitle": "稻城萤美"
				},
				{
					"id": 220500423,
					"content": "等一下…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500424
					]
				},
				{
					"id": 220500424,
					"content": "唔…她说四五百年前，也就是说，阿响是很久前的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500425
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220500425,
					"content": "那寝子也是有四五百岁的猫？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500426
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220500426,
					"content": "喵喵？奴家不清楚。「四五百岁」是什么意思？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500427
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220500427,
					"content": "奴家又不是人。没有那么多要计较的事情，只知道太阳升起、月亮升起。如果心情不好，那睡一觉就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500428
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220500428,
					"content": "好羡慕啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500429,
						220500431
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220500429,
					"content": "派蒙也差不多吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500430
					]
				},
				{
					"id": 220500430,
					"content": "#喂！真没礼貌，派蒙可是天天为了{NICKNAME}，担心得不得了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500433
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220500433,
					"content": "汝等说了很多奴家不懂的事情。所以，阿响呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500434
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220500434,
					"content": "恕我直言，浅濑响的话，恐怕已经…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500435
					],
					"speakerTitle": "稻城萤美"
				},
				{
					"id": 220500435,
					"content": "阿响不在这里。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500436
					]
				},
				{
					"id": 220500436,
					"content": "对、对啊，阿响应该是去别的地方了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500437
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220500437,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500438
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220500438,
					"content": "也是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500439
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220500439,
					"content": "真没办法哪。阿响怎么还跟小家伙似的。到处乱跑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500440
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220500440,
					"content": "不管怎么说，谢谢巫女小姐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500441
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220500441,
					"content": "那么，我们先走了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500442
					]
				},
				{
					"id": 220500442,
					"content": "唉…请慢走。如果需要我帮忙的话，就请尽管来找我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "稻城萤美"
				},
				{
					"id": 220500431,
