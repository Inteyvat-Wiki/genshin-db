				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130320101,
					"content": "我刚刚就想问了，准备是什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130320102,
					"content": "那菈艾文还没有完全想起来，回忆与梦想，都不可或缺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320103
					],
					"speakerTitle": "兰浮婆"
				},
				{
					"id": 130320103,
					"content": "梦想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320104
					],
					"speakerTitle": "艾文"
				},
				{
					"id": 130320104,
					"content": "可是我，再也站不起来了。就算是恢复，也不知道能不能好，需要多久。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320105
					],
					"speakerTitle": "艾文"
				},
				{
					"id": 130320105,
					"content": "不需要有这样的担心。那菈艾文要记住，梦想关联的是你的心，而不是身体。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320106
					],
					"speakerTitle": "兰浮婆"
				},
				{
					"id": 130320106,
					"content": "心…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320107
					],
					"speakerTitle": "艾文"
				},
				{
					"id": 130320107,
					"content": "老身就送到这里了。宝贵的东西，就靠那菈艾文自己去找回来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320108
					],
					"speakerTitle": "兰浮婆"
				},
				{
					"id": 130320108,
					"content": "欸？他就这样不见了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320109
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 130320109,
					"content": "周围的天色，好像也有点改变了的样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320110
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 130320110,
					"content": "心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320111
					],
					"speakerTitle": "艾文"
				},
				{
					"id": 130320111,
					"content": "……！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320112
					],
					"speakerTitle": "艾文"
				},
				{
					"id": 130320112,
					"content": "欸——？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130320113,
					"content": "我…站起来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320114
					],
					"speakerTitle": "艾文"
				},
				{
					"id": 130320114,
					"content": "毫不费力，也没有奇怪的感觉，一切都和生病之前一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320115
					],
					"speakerTitle": "艾文"
				},
				{
					"id": 130320115,
					"content": "喂，难道说我们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130320116,
					"content": "进入梦里了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320117
					]
				},
				{
					"id": 130320117,
					"content": "嗯，之前也有过这种事，怪不得他说不需要担心，在梦里艾文就是可以自由活动的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130320118,
					"content": "你们看，我站起来了！嘿嘿，我站起来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320119
					],
					"speakerTitle": "艾文"
				},
				{
					"id": 130320119,
					"content": "那不是太好了嘛，这样我们就能一起去找兰莎妮了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320120
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 130320120,
					"content": "我们来赛跑吧，正好也让我看看你究竟有多么厉害。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320121
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 130320121,
					"content": "我可能还没恢复好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320122
					],
					"speakerTitle": "艾文"
				},
				{
					"id": 130320122,
					"content": "算了，不管了，来跑吧！就算是大人我也完全不害怕！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320123
					],
					"speakerTitle": "艾文"
				},
				{
					"id": 130320123,
					"content": "啊，跑出去了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130320124,
					"content": "没想到这么顺利，还以为她需要再适应适应呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320125,
						130320126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130320125,
					"content": "这就是天赋吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320127
					]
				},
				{
					"id": 130320127,
					"content": "嘿嘿，是啊，我们也追上去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130320126,
					"content": "这就是愿望吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320127
					]
				}
			]
		},
