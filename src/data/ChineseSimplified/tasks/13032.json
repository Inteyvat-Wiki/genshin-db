				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130321105,
					"content": "须弥真是个好地方，下次我还要来玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321106
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 130321106,
					"content": "随时欢迎你过来，艾文也会很开心的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321107
					],
					"speakerTitle": "妮欧莎"
				},
				{
					"id": 130321107,
					"content": "一言为定哦，我会一直等你过来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321108
					],
					"speakerTitle": "艾文"
				},
				{
					"id": 130321108,
					"content": "哈哈哈，没问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321109
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 130321109,
					"content": "姐姐，在你回去之前，我还想告诉你——我有了一个新的梦想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321110
					],
					"speakerTitle": "艾文"
				},
				{
					"id": 130321110,
					"content": "我要靠自己去稻妻，见识一下稻妻的烟花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321111
					],
					"speakerTitle": "艾文"
				},
				{
					"id": 130321111,
					"content": "哦，很了不起嘛！呵呵，我也没想到出来玩还能给家里的烟花店拉到客人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321112
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 130321112,
					"content": "放心吧，我会专门为你设计一个烟花，让你过目不忘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321113
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 130321113,
					"content": "你们也是，不管冒险再忙，也要常来稻妻看看，无论什么时候，大家都很欢迎你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321114
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 130321114,
					"content": "这次旅行的成果，说什么也要在你们的见证之下，让它升上天空！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321115
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 130321115,
					"content": "好的，一言为定！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321116,
						130321118,
						130321120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130321116,
					"content": "路上保重。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130321117
					]
				},
				{
					"id": 130321117,
					"content": "会的会的，你还是这么稳重，嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321122
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 130321122,
					"content": "对了对了，你看这是什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321123
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 130321123,
					"content": "兰那罗木刻…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130321124
					]
				},
				{
					"id": 130321124,
					"content": "对哦，是你帮我挑的那个款式，你和派蒙都说觉得有点像我。刚刚我也去买了一个，送给你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321125
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 130321125,
					"content": "不开心的时候就看看这个，说不定就能让你打起精神，觉得至少还有我在支持你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321126
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 130321126,
					"content": "当然，最好还是来见我本人啦，嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321127,
						130321128
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 130321127,
					"content": "谢谢你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130321129
					]
				},
				{
					"id": 130321129,
					"content": "嗯，那我回去啦，我相信我们很快又能再见的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321130
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 130321130,
					"content": "我很喜欢你们为我准备的旅行，嗯，不如说，是很钦佩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321131
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 130321131,
					"content": "这份友善与温柔，无论你们走到哪里，都会成为支撑你们后背的强大力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321132
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 130321132,
					"content": "就像这样，走到旅途的终点，世界的尽头吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321133
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 130321133,
					"content": "再见咯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宵宫"
				},
				{
					"id": 130321128,
					"content": "我会珍惜的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130321129
					]
				},
				{
					"id": 130321118,
					"content": "天天开心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130321119
					]
				},
				{
					"id": 130321119,
					"content": "天天开心，永远开心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321122
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 130321120,
					"content": "烟花易逝，人情长存！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130321121
					]
				},
				{
					"id": 130321121,
					"content": "你、你突然喊出来干什么啦，怪不好意思的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321122
					],
					"speakerTitle": "宵宫"
				}
			]
		}
	]
}