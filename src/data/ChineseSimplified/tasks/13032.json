				"objectNames": [
					"艾文",
					"宵宫",
					"兰莎妮"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130320501,
					"content": "这里，就是终点了吧，可是没看见兰那罗，只有这块很大的石头。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130320502,
					"content": "太开心了，这种感觉我几乎都已经忘掉了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320503
					],
					"speakerTitle": "艾文"
				},
				{
					"id": 130320503,
					"content": "你们知道吗？如果不跑起来，我觉得我的世界只有那么一点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320504
					],
					"speakerTitle": "艾文"
				},
				{
					"id": 130320504,
					"content": "但只要不断往前跑，眼前就会不断出现新的景色，世界会无限地在我眼前展开。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320505
					],
					"speakerTitle": "艾文"
				},
				{
					"id": 130320505,
					"content": "#虽然我不知道我是怎么做到的，但一定是{M#哥哥姐姐们}{F#姐姐们}的功劳吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320506
					],
					"speakerTitle": "艾文"
				},
				{
					"id": 130320506,
					"content": "哎呀，这个不重要。关键是你想起了很多事啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320507
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 130320507,
					"content": "记忆不止象征过去，同样拥有照亮未来的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320508
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 130320508,
					"content": "只要养好了病，这些快乐就都会回到你的身边。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320509
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 130320509,
					"content": "嗯，谢谢姐姐，也谢谢你们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320510
					],
					"speakerTitle": "艾文"
				},
				{
					"id": 130320510,
					"content": "那我们继续去找兰莎妮吧，他好像不在这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320511
					],
					"speakerTitle": "艾文"
				},
				{
					"id": 130320511,
					"content": "是啊，但为什么会把我们引到这里来呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320512
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130320512,
					"content": "我也觉得这个石头很显眼。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320513
					]
				},
				{
					"id": 130320513,
					"content": "我也说不好，不知道它是什么，但总有一种很熟悉的感觉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320514
					],
					"speakerTitle": "艾文"
				},
				{
					"id": 130320514,
					"content": "就好像「它」本来就是我的一部分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320515
					],
					"speakerTitle": "艾文"
				},
				{
					"id": 130320515,
					"content": "我知道了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320516
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 130320516,
					"content": "这个石头，是不是就是属于她的「苍松石」啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320517
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 130320517,
					"content": "苍、苍松石？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320518,
						130320519
					],
					"speakerTitle": "艾文"
				},
				{
					"id": 130320518,
					"content": "（宵宫真是会编。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320520
					]
				},
				{
					"id": 130320519,
					"content": "（我都快把这事忘了。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320520
					]
				},
				{
					"id": 130320520,
					"content": "那是一种很稀有的矿石，象征的正是一个人的初心与梦想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320521
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 130320521,
					"content": "你能见到它，就说明你已经把你失去的东西找回来了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320522
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 130320522,
					"content": "原来是这样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320523
					],
					"speakerTitle": "艾文"
				},
				{
					"id": 130320523,
					"content": "怎么和童话故事一样，本来我都不相信童话了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320524
					],
					"speakerTitle": "艾文"
				},
				{
					"id": 130320524,
					"content": "但是，真好啊，我找回来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320525
					],
					"speakerTitle": "艾文"
				},
				{
					"id": 130320525,
					"content": "欸，穿、穿过去了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320526
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130320526,
					"content": "我们也过去！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320527
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 130320527,
					"content": "#喂，喂，宵宫！唉，没办法了，{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320528
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130320528,
					"content": "穿过来了，但周围好像没什么变化…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320529
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130320529,
					"content": "好久不见，那菈艾文。好久不见了，对吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320530
					],
					"speakerTitle": "兰莎妮"
				},
				{
					"id": 130320530,
					"content": "兰莎妮…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320531
					],
					"speakerTitle": "艾文"
				},
				{
					"id": 130320531,
					"content": "为什么要露出悲伤的样子，哦，兰莎妮明白了，这是开心的样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320532
					],
					"speakerTitle": "兰莎妮"
				},
				{
					"id": 130320532,
					"content": "兰莎妮！呜哇哇啊啊啊——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320533
					],
					"speakerTitle": "艾文"
				},
				{
					"id": 130320533,
					"content": "哈哈哈，兰那罗为我们准备的旅程，真是浪漫啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320534
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 130320534,
					"content": "不仅是让她找回了最重要的朋友，也让我们知道了「苍松石」究竟是什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320535
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 130320535,
					"content": "等会儿我们也要去找属于我们的「苍松石」哦，我一定要做出最纯净的透镜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320536
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 130320536,
					"content": "嗯！不知道为什么，我也有一种能做到的感觉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320537,
						130320538
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130320537,
					"content": "这就是冒险吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320539
					]
				},
				{
					"id": 130320538,
					"content": "我也乐在其中。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320539
					]
				},
				{
					"id": 130320539,
					"content": "不过首先还是得先把她送回须弥城，不要让她的母亲太担心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宵宫"
				},
				{
					"id": 130320540,
					"content": "眼前的场景如梦似幻，恍惚之间，你们又回到了原处。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
