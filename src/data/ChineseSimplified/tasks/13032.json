				]
			},
			"dialogs": [
				{
					"id": 130320201,
					"content": "哈啊，哈啊，还是姐姐比较厉害…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320202
					],
					"speakerTitle": "艾文"
				},
				{
					"id": 130320202,
					"content": "嘿嘿，距离长一点还真不好说，我还以为我会被追上呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320203
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 130320203,
					"content": "艾文好像完全不落下风。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130320204,
					"content": "我以前也跑赢过很多大人，腿长可不一定跑得就快，锻炼也很重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320205
					],
					"speakerTitle": "艾文"
				},
				{
					"id": 130320205,
					"content": "再过几年，我就不是对手啦，哈哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320206
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 130320206,
					"content": "唔，我看看，接下来应该往哪个方向走呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320207
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 130320207,
					"content": "欸，快看，前面好像有个东西飘起来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130320208,
					"content": "像是…星星？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320209
					]
				},
				{
					"id": 130320209,
					"content": "难道是让我们跟上去吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320210
					],
					"speakerTitle": "艾文"
				},
				{
					"id": 130320210,
					"content": "嗯，有可能，跟上去看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宵宫"
				}
			]
		},
