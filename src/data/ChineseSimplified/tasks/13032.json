			"dialogs": [
				{
					"id": 130320601,
					"content": "这、这是…结束了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320602
					],
					"speakerTitle": "艾文"
				},
				{
					"id": 130320602,
					"content": "做了个非常非常好的梦啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320603
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 130320603,
					"content": "不用露出寂寞的表情哦，他就在你的旁边。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320604
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 130320604,
					"content": "兰莎妮！太好了，你还在…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320605
					],
					"speakerTitle": "艾文"
				},
				{
					"id": 130320605,
					"content": "兰莎妮想道歉，不是兰莎妮不想去找那菈，只是兰莎妮记不清时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320606
					],
					"speakerTitle": "兰莎妮"
				},
				{
					"id": 130320606,
					"content": "兰莎妮不敢去城里，没见到那菈，兰莎妮以为那菈艾文交到了新的朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320607
					],
					"speakerTitle": "兰莎妮"
				},
				{
					"id": 130320607,
					"content": "这是常有的事，也是没办法的事，并不是遗憾的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320608
					],
					"speakerTitle": "兰浮婆"
				},
				{
					"id": 130320608,
					"content": "没关系，我明白，都是因为我没能振作起来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320609
					],
					"speakerTitle": "艾文"
				},
				{
					"id": 130320609,
					"content": "但是现在我已经想明白了，姐姐说得很对，坏运气谁都会遇到，重要的是互相搀扶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320610
					],
					"speakerTitle": "艾文"
				},
				{
					"id": 130320610,
					"content": "谢谢大家的帮助，我不会辜负大家帮我找回的记忆和梦想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320611
					],
					"speakerTitle": "艾文"
				},
				{
					"id": 130320611,
					"content": "嘿嘿，你也帮了姐姐很多哦，不用客气。本来我们对「苍松石」还一头雾水呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320612
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 130320612,
					"content": "按现在这样的思路，我觉得我们也很快就能找到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320613
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 130320613,
					"content": "姐姐是想看一场流星雨对吧，是因为这个需要「苍松石」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320614
					],
					"speakerTitle": "艾文"
				},
				{
					"id": 130320614,
					"content": "嗯，对了，到时候我们找到了，你也来一起看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320615
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 130320615,
					"content": "如果是这样的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320616
					],
					"speakerTitle": "艾文"
				},
				{
					"id": 130320616,
					"content": "我愿意把「苍松石」借给你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320617
					],
					"speakerTitle": "艾文"
				},
				{
					"id": 130320617,
					"content": "欸？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320618
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130320618,
					"content": "这、这是怎么回事啊？从胸口里拿出了一个…眼镜？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320619
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130320619,
					"content": "我也不知道。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320620
					]
				},
				{
					"id": 130320620,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320621
					],
					"speakerTitle": "兰浮婆"
				},
				{
					"id": 130320621,
					"content": "哈哈哈，你怎么知道我需要这个？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320622
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 130320622,
					"content": "我也不知道，我只是觉得你帮我找回来了最好的朋友，我也要用最珍贵的东西帮你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320623
					],
					"speakerTitle": "艾文"
				},
				{
					"id": 130320623,
					"content": "然后光就变成了这个样子，这是你需要的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320624
					],
					"speakerTitle": "艾文"
				},
				{
					"id": 130320624,
					"content": "谢谢你，没想到这样就解决了，那我现在就试试看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320625
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 130320625,
					"content": "虽然不太清楚用法，姑且就凭直觉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320626
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 130320626,
					"content": "在哪里呢，在哪里呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320627
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 130320627,
					"content": "哦！我好像看到了，还挺明显的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320628
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 130320628,
					"content": "走吧，我来带路。我们看完流星雨之后再送你回家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320629
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 130320629,
					"content": "也谢谢你愿意帮我们，客套的话就不多说了，我有一句由衷的夸奖——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320630
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 130320630,
					"content": "你们真的很会讲故事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320631
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 130320631,
					"content": "哎呀，真是巧合。老身对你也有相同的评价，红色的那菈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰浮婆"
				}
			]
