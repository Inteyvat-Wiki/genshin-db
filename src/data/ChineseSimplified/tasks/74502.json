			"dialogs": [
				{
					"id": 745020201,
					"content": "你们来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020202
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745020202,
					"content": "老板的心情看起来挺不错嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745020203,
					"content": "还是多亏两位的帮助。话说回来，卡隆这趟蒙德之旅，也给了我不小启发。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020204
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745020204,
					"content": "我在想，是不是也该出门转一转，找找关于玩具制作的灵感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020205
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745020205,
					"content": "二位走南闯北，应该认识不少班尼特那样的朋友吧，有什么好建议吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020206
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745020206,
					"content": "虽然朋友有不少，但关于玩具的灵感，有点被难住了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745020207,
					"content": "为什么不找找第三人呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745020208
					]
				},
				{
					"id": 745020208,
					"content": "第三人？我们不就是第三人嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745020209,
					"content": "您的意思难道是指…北国银行？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020210
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745020210,
					"content": "原来是前任第三人！噢，让我想想，北国银行属于愚人众…愚人众属于…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745020211,
					"content": "莫非是…愚人众里的执行官？以执行官为题材的玩具？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020212
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745020212,
					"content": "#…哦！{NICKNAME}，你的意思该不会是？我明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745020213,
					"content": "嘿嘿，利弗老板，你知不知道，愚人众里有一位特别的执行官，他有个很厉害的名号，叫作——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745020214,
					"content": "「至冬国最棒的玩具销售员」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745020215,
					"content": "哦？至冬国最棒的玩具销售员？有这种人物？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020216
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745020216,
					"content": "当然啦，这个人很懂行哦！说不定他会给你带来一大堆灵感，而且在推广上，玩具商和销售员一定也可以强强联手对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745020217,
					"content": "非常感谢两位贵客的建议，这对我很有帮助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020218
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745020218,
					"content": "虽然想要搭上执行官的线估计不轻松，但我在北国银行略有一些人脉，我会去尽力试试的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020219
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745020219,
					"content": "嘿嘿，如果到时候做出来新玩具，记得找我们试玩哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745020220,
					"content": "一定不会忘记两位，请等我的好消息吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "利弗"
				}
			]
		},
