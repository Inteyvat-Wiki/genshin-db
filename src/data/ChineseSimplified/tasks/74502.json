				]
			},
			"dialogs": [
				{
					"id": 745020101,
					"content": "卡隆，生意不错啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020102
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745020102,
					"content": "大、大哥？！你怎么来了？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020103
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745020103,
					"content": "这么久没见，结果第一句话就问这个吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020104
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745020104,
					"content": "我、我只是没想到大哥会来见我，毕竟店就开在不远的地方，却一次都没有来过。我以为你还在生气…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020105
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745020105,
					"content": "我不是来和你说以前的事的，今天我就开门见山了。我问你，你那个冒险家玩具，是因为我才做的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020106
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745020106,
					"content": "啊？唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020107
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745020107,
					"content": "我就知道什么都瞒不过大哥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020108
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745020108,
					"content": "等、等一下，我有点糊涂了，那个玩具不是因为班尼特制作的吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745020109,
					"content": "原来两位客人也来了啊…说来惭愧，之前没有说明，是因为总觉得有点难以启齿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020110
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745020110,
					"content": "虽然那位冒险家朋友给了我最重要的灵感，但让我坚定要做出这个玩具的人，其实是大哥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020111,
						745020170
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745020111,
					"content": "理解，确实挺难开口。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745020112
					]
				},
				{
					"id": 745020112,
					"content": "卡隆，你这婆婆妈妈的样子真是一点都没变。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020113
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745020113,
					"content": "大哥也没变啊。我越来越觉得大哥和那位冒险家是同样的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020114
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745020114,
					"content": "我可没有神之眼，也不是冒险家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020115
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745020115,
					"content": "但你们拥有同样的冒险精神，区别只是班尼特在冒险里生活，大哥是在生活中冒险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020116
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745020116,
					"content": "说好听话的本事是跟我学的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020117
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745020117,
					"content": "怎么可能，大哥说话就没好听过，总是说我缺乏拼搏的精神，虽然很烦人，但其实也没什么错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020118
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745020118,
					"content": "到今天为止，大哥都在为了成为最好的玩具商而打拼，我却早就听从家里的安排，过上了一格一格循环的钟表生活。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020119
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745020119,
					"content": "只有大哥和班尼特这样的人才敢把热爱的东西当做事业吧？那样我绝对做不到，大哥的勇气足够一百个我用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020120
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745020120,
					"content": "卡隆老板，你也不用把自己说成这样嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745020121,
					"content": "有件事不怕你们笑话，最初大哥打算把他的店开在我隔壁，我得知消息后的第一个念头居然是搬店，真是愧对父亲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020122
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745020122,
					"content": "还好最后是北国银行拿下了那个店址，把我和大哥隔开，我才松了一口气，真是救命的刚好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020123
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745020123,
					"content": "哦哦我知道这个，阿尔邦他们说过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745020124,
					"content": "哼，你不想想，世上真有那么多的刚好？北国银行偏偏这么巧，不早不晚刚好插在我们中间？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020125
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745020125,
					"content": "利弗老板的意思是？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745020126
					]
				},
				{
					"id": 745020126,
					"content": "那个店址我早预定在手了，只是后来有了新的想法，才低价转让给了北国银行，他们可不是天上掉下来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020127
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745020127,
					"content": "呜哇，原来北国银行是利弗老板找来的！没想到会是这样…看来利弗老板也觉得自己的想法太冲动了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745020128,
					"content": "从离家到现在，我的目标都是「成为最好的玩具商」，如果变成了「和家里置气，把弟弟吓到搬店」，那算什么回事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020129
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745020129,
					"content": "嘿嘿嘿，我听出了一些关心的味道哦！那我猜，之前说要让卡隆老板道歉也是面子话吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745020130,
					"content": "道、道歉？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020131
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745020131,
					"content": "什么道歉？我有说过吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020132
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745020132,
					"content": "怎么会有人这么理直气壮地否认自己说过的话啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745020133,
					"content": "哼，卡隆，其实我今天是来恭喜你的，你那个玩具…做得不错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020134
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745020134,
					"content": "上一次听到大哥的称赞已经是很久以前了，没想到现在还能…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020135
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745020135,
					"content": "不光是这个，我还给你带了贺礼，是这些天我拜托这两位冒险家收集的数据。有了这些，你能做出更有趣的东西吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020136
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745020136,
					"content": "啊？但大哥不是在做「决斗代理人」的玩具企划吗？这些数据很重要啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020137
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745020137,
					"content": "不，那个企划我决定暂停了。市场的变动比我想的还要快，我要及时调整方向了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020138
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745020138,
					"content": "但…这些数据…这怎么行呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020139
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745020139,
					"content": "给你你就拿着，废什么话！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020140
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745020140,
					"content": "唉…那、那我就先帮大哥保管，如果有需要，可以随时拿回去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020141
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745020141,
					"content": "原来利弗老板说的另有打算，其实是送给弟弟呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020142
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745020142,
					"content": "两位贵客，事先没有征求你们的意见，擅自做主，其实有点过意不去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020143
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745020143,
					"content": "#没关系啦，利弗老板本来就付了报酬，怎么用那是老板的事。而且如果能让你们关系变好，也很值哦！对吧？{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020144,
						745020145
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745020144,
					"content": "派蒙的意思就是我的意思。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745020146
					]
				},
				{
					"id": 745020146,
					"content": "嘿嘿，好像我们也当了一次成功的第三人呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020147
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745020147,
					"content": "对了，卡隆老板，利弗老板，既然都到这里了，我还有个想法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020148
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745020148,
					"content": "不如你们就趁热打铁，以后一起合作怎么样？卡隆老板擅长制作，利弗老板擅长推广，你们一起做事一定能行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020149
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745020149,
					"content": "…多谢好意，但我觉得不必了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020150
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745020150,
					"content": "嗯…我和大哥的想法一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020151
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745020151,
					"content": "哎呀，你们就非得在这种时候统一意见嘛？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020152
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745020152,
					"content": "那位叫做班尼特的冒险家说过这样的话吧？「世上就是有各种各样的人。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020153
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745020153,
					"content": "果然大哥也记住了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020154
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745020154,
					"content": "「世上就是有各种各样的人，所以就有独属于各种人的风景。」如果说我从他身上学到了什么，那就是这个了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020155
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745020155,
					"content": "我和卡隆就是不一样的人，所以才走上了不同的路。也许他认为我的路太冒险，但他选择的平淡生活，在我眼里却难以应付。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020156
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745020156,
					"content": "没错，如果让时针来干分针的工作，第二天就会被开除，还拿不到补偿金。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020157
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745020157,
					"content": "面对激烈的挑战是冒险，甘于平淡的生活其实也是吧？在各自的路上大家都在冒险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020158
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745020158,
					"content": "所以，既然已经选好了方向，就好好走下去，各自寻找各自的风景吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020159
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745020159,
					"content": "嗯，我会偶尔去找大哥碰头的，毕竟你的路比较难走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020160
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745020160,
					"content": "臭小子，少担心我，至少我知道遇到难题找第三人帮忙，北国银行和这两位冒险家都不是我坐在店里等来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020161
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745020161,
					"content": "那要是遇到第三人都解决不了的难题怎么办？大哥知道吧，齿轮的刚度越高，韧度就越差，我担心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020162
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745020162,
					"content": "真遇到了就遇到了，还能怎么办？生活有时候就是这样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020163
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745020163,
					"content": "不行，不管怎么说，大哥绝不能被生活打倒，就像班尼特那样。不然…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020164
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745020164,
					"content": "不然？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020165
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745020165,
					"content": "不然我就一拳把大哥打飞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020166
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745020166,
					"content": "臭小子，翅膀硬了是吧，当弟弟的人可以这样跟大哥说话吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020167
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745020167,
					"content": "唔…既然审判桌都可以给芙宁娜大人坐坐，那哥哥的台词应该也可以给弟弟说说吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020168
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745020168,
					"content": "哈哈哈，两位贵客，没想到短短几天你们就很了解枫丹人了啊。我刚好还有点事想要请教，方便的话等会来店门口见吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020169
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745020169,
					"content": "卡隆，那今天就这样，我要说的都说完了，先回去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "利弗"
				},
				{
					"id": 745020145,
					"content": "对，我们做生意也讲诚信。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745020146
					]
				},
				{
					"id": 745020170,
					"content": "不理解，这有什么好难为情的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745020171
					]
				},
				{
					"id": 745020171,
					"content": "因为我这弟弟从小就是这么婆婆妈妈拧拧巴巴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020113
					],
					"speakerTitle": "利弗"
				}
			]
		},
