			"dialogs": [
				{
					"id": 230020301,
					"content": "太好了，这些就足够了。这些蘑菇看起来就不错…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020302
					],
					"speakerTitle": "范兵卫"
				},
