				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230020101,
					"content": "这家店的蘑菇质量看来还可以，先放在采购名单上好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020102
					],
					"speakerTitle": "范兵卫"
				},
				{
					"id": 230020102,
					"content": "范兵卫？这个名字好熟悉啊，好像在哪听人提起过…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020103,
						230020104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230020103,
					"content": "难、难道是之前踏鞴砂那个…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020105
					]
				},
				{
					"id": 230020105,
					"content": "呜哇！他是那个拖拖拉拉，把「御影炉心」弄得一团糟的家伙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020106,
						230020107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230020106,
					"content": "他应该是来做「远国御用」的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020108
					]
				},
				{
					"id": 230020108,
					"content": "原来他真的来须弥了啊，我还以为那个「远国御用」是开玩笑的呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230020109,
					"content": "咦？金发…旁边飘着一个小东西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020110
					],
					"speakerTitle": "范兵卫"
				},
				{
					"id": 230020110,
					"content": "您难道就是那位「旅行者」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020111,
						230020112
					],
					"speakerTitle": "范兵卫"
				},
				{
					"id": 230020111,
					"content": "没错，就是我。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020114
					]
				},
				{
					"id": 230020114,
					"content": "哈哈，果然是您，阳介写信过来的时候提到过您。他说是您和泽维尔先生一起处理了「御影炉心」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020115
					],
					"speakerTitle": "范兵卫"
				},
				{
					"id": 230020115,
					"content": "唉，我真是惭愧啊，在您和泽维尔先生修理「御影炉心」的时候，我居然被文书工作给绊住了手脚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020116
					],
					"speakerTitle": "范兵卫"
				},
				{
					"id": 230020116,
					"content": "文书工作比「御影炉心」还重要吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020117
					]
				},
				{
					"id": 230020117,
					"content": "你工作的重点完全就错了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230020118,
					"content": "您看您说的，如果不做好文书工作，怎么有序推进「御影炉心」的维修工作呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020119
					],
					"speakerTitle": "范兵卫"
				},
				{
					"id": 230020119,
					"content": "您瞧，疏散周边人员、准备修理物资、调动修理人员，还要协调各方的生产需求…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020120
					],
					"speakerTitle": "范兵卫"
				},
				{
					"id": 230020120,
					"content": "如果没有文书支持，这些事都会乱成一锅粥了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020121
					],
					"speakerTitle": "范兵卫"
				},
				{
					"id": 230020121,
					"content": "果然和虎之助说的一样…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020122
					]
				},
				{
					"id": 230020122,
					"content": "真是名不虚传啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230020123,
					"content": "虎之助…那位先生就是那种根本不在意文书工作的人，和他一起工作，总是会有很多额外的工作量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020124
					],
					"speakerTitle": "范兵卫"
				},
				{
					"id": 230020124,
					"content": "不过，现在我已经不再分管「御影炉心」了，现在我正在须弥做「远国御用」，主管蘑菇贸易啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020125
					],
					"speakerTitle": "范兵卫"
				},
				{
					"id": 230020125,
					"content": "嗯…旅行者，您的事迹我已经听阳介说过了，我觉得…您是一个非常可靠的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020126
					],
					"speakerTitle": "范兵卫"
				},
				{
					"id": 230020126,
					"content": "如果您愿意的话，能帮我一个忙吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020127
					],
					"speakerTitle": "范兵卫"
				},
				{
					"id": 230020127,
					"content": "我目前正在寻找一个稳定可靠的蘑菇供应商，也在这里找了很多商家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020128
					],
					"speakerTitle": "范兵卫"
				},
				{
					"id": 230020128,
					"content": "他们给我拿来的蘑菇样本都是一些特意挑选出来的好货…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020129
					],
					"speakerTitle": "范兵卫"
				},
				{
					"id": 230020129,
					"content": "我觉得，必须要去他们的蘑菇产地直接看看蘑菇质量，以此来衡量他们供货时的货物质量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020130
					],
					"speakerTitle": "范兵卫"
				},
				{
					"id": 230020130,
					"content": "但如您所见，我实在是没有野外勘察的经验，独自进林的话，只怕凶多吉少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020131
					],
					"speakerTitle": "范兵卫"
				},
				{
					"id": 230020131,
					"content": "所以，我想请您帮我去林子里采集一下蘑菇，然后拿回来给我。您看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020132,
						230020133
					],
					"speakerTitle": "范兵卫"
				},
				{
					"id": 230020132,
					"content": "倒也不是不行…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020134
					]
				},
				{
					"id": 230020134,
					"content": "您答应我了？太好了！报酬的事您放心，我已经准备好了文书。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020135
					],
					"speakerTitle": "范兵卫"
				},
				{
					"id": 230020135,
					"content": "您看这里，对，先看这份文书，这是雇佣文书，还有酬劳计算，这份是义务告知和保密协议，噢对了，还有那片蘑菇产地的地图…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020136
					],
					"speakerTitle": "范兵卫"
				},
				{
					"id": 230020136,
					"content": "和范兵卫一起细致地查看了所有文书，深感疲惫…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230020137
					]
				},
				{
					"id": 230020137,
					"content": "很好，这样所有文书您都已经知悉了，我会先送报幕府，得到回执之后，再和您达成正式雇佣关系。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020138
					],
					"speakerTitle": "范兵卫"
				},
				{
					"id": 230020138,
					"content": "但在那之前，我会先自掏腰包支付您的酬劳。毕竟采购蘑菇这件事不能耽搁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020139
					],
					"speakerTitle": "范兵卫"
				},
				{
					"id": 230020139,
					"content": "当然啦，这件事我也会总结成文书向幕府备案，毕竟您的酬劳也需要报税。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020140
					],
					"speakerTitle": "范兵卫"
				},
				{
					"id": 230020140,
					"content": "我、我先去采蘑菇了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020141
					]
				},
				{
					"id": 230020141,
					"content": "咦？噢…那就拜托您了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020142
					],
					"speakerTitle": "范兵卫"
				},
				{
					"id": 230020142,
					"content": "我们不会再次被卷入麻烦里吧，真担心啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020143,
						230020145
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230020143,
					"content": "我就是来盯着他的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020144
					]
				},
				{
					"id": 230020144,
					"content": "是这样吗？好吧，你说得也有点道理…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020147
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230020147,
					"content": "咦？您怎么这么一副不相信我的表情…放心吧，我准备工作都做得很完善了，绝不会让您面对什么流程问题的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020148
					],
					"speakerTitle": "范兵卫"
				},
				{
					"id": 230020148,
					"content": "我们不是在说这种问题啦…唉，总之我们先去林子里帮他采蘑菇吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230020145,
					"content": "想看这家伙能整出什么新乱子。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020146
					]
				},
				{
					"id": 230020146,
					"content": "喂！要是真有什么新乱子，我们在这里可找不到人来帮忙了啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020147
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230020133,
					"content": "报酬先谈好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020134
					]
				},
				{
					"id": 230020112,
					"content": "这位是派蒙…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020113
					]
				},
				{
					"id": 230020113,
					"content": "是派蒙，不是什么「飘着的小东西」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230020107,
					"content": "他应该是来管蘑菇贸易的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020108
					]
				},
				{
					"id": 230020104,
					"content": "虎之助和阳介都提过的那个…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020105
					]
				}
			]
		},
