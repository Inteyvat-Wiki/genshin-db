			"dialogs": [
				{
					"id": 191170106,
					"content": "汪！汪呜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170107
					],
					"speakerTitle": "忍犬"
				},
				{
					"id": 191170107,
					"content": "好凶！差点又被咬到了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170108
					],
					"speakerTitle": "托马"
				},
				{
					"id": 191170108,
					"content": "我说你啊，肚子都饿瘪了，差不多也该吃点东西了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170109
					],
					"speakerTitle": "托马"
				},
				{
					"id": 191170109,
					"content": "就算你没有和我回去的想法，也没必要一点东西都不吃吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170110
					],
					"speakerTitle": "托马"
				},
				{
					"id": 191170110,
					"content": "难道是担心食物中有毒吗？我亲自替你尝一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170121
					],
					"speakerTitle": "托马"
				},
				{
					"id": 191170121,
					"content": "看，完全没问题吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170111,
						191170112
					],
					"speakerTitle": "托马"
				},
				{
					"id": 191170111,
					"content": "托马…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191170113
					]
				},
				{
					"id": 191170113,
					"content": "来，稍微吃一点。少吃两口，我今天就不来打扰你了，怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170114
					],
					"speakerTitle": "托马"
				},
				{
					"id": 191170114,
					"content": "汪！汪汪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170115
					],
					"speakerTitle": "忍犬"
				},
				{
					"id": 191170115,
					"content": "完全不打算吃我们的食物呢…总觉得它看上去很焦躁不安。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170116
					],
					"speakerTitle": "托马"
				},
				{
					"id": 191170116,
					"content": "海里有什么东西吗？还是周围有什么让它警惕的东西呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170117
					],
					"speakerTitle": "托马"
				},
				{
					"id": 191170117,
					"content": "会不会是那些怪物？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191170118
					]
				},
				{
					"id": 191170118,
					"content": "你是说它被周围的怪物攻击了吗…倒也有可能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170119
					],
					"speakerTitle": "托马"
				},
				{
					"id": 191170119,
					"content": "人在危险的环境下也吃不下饭吧，我们帮它把周围清理一下好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170120
					],
					"speakerTitle": "托马"
				},
				{
					"id": 191170120,
					"content": "#辛苦你陪我一起了，{NICKNAME}。至少让这里清净一些吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "托马"
				},
				{
					"id": 191170112,
					"content": "好拼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191170113
					]
				}
			]
		}
	]
