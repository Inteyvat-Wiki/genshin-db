					"nextDialogs": [
						708020302
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 708020302,
					"content": "关于乔瑟夫先生…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020303
					]
				},
				{
					"id": 708020303,
					"content": "唉，我刚才也没发现什么新线索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020304
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 708020304,
					"content": "不过，既然这周围都安全了，那我也会继续搜索的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020305
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 708020305,
					"content": "请你先回协会一趟，告诉塞琉斯先生我已经开始搜索工作了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "冒失的帕拉德"
				}
			]
		},
