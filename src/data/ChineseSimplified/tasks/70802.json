			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"塞琉斯",
					"冒失的帕拉德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708020201,
					"content": "居然在这个区域…帕拉德，你确定吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020202
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 708020202,
					"content": "我很确定，塞琉斯先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020203
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 708020203,
					"content": "你们在讨论乔尔父亲的事吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020204
					]
				},
				{
					"id": 708020204,
					"content": "这不是旅行者吗？看来你是从乔尔那边过来的啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020205
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 708020205,
					"content": "那孩子，每天都要拜托人从我这里打听消息…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020206
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 708020206,
					"content": "不过，这次我可是要带给他一个大大的好消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020207
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 708020207,
					"content": "前段时间，我们冒险家协会刚刚组织了一场「雪山特训」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020208
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 708020208,
					"content": "接下来的就由我说吧，塞琉斯先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020209
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 708020209,
					"content": "在参加那场特训的途中，我因为风雪太大而偏离了预定的路线。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020210
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 708020210,
					"content": "当我摸索着准备回到路线上时，突然在一处山崖上，看见了一个模糊的人影。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020211
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 708020211,
					"content": "我最开始还以为是一个和我一样迷路的冒险家，就大声喊他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020212
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 708020212,
					"content": "但是，在吸引到那个人的注意力之前…我的喊声先引来了魔物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020213
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 708020213,
					"content": "在雪山的那种环境里，我没有打倒那些魔物的自信，只能先撤退了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020214
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 708020214,
					"content": "回来之后，我就把这件事和塞琉斯先生说了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020215,
						708020217
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 708020215,
					"content": "那个人影就是乔尔的父亲？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020216
					]
				},
				{
					"id": 708020216,
					"content": "我们也不能确定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020218
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 708020218,
					"content": "无论如何，至少我们知道了有人被困在雪山里，必须要组织营救行动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020219
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 708020219,
					"content": "至于那个人到底是不是乔尔的父亲乔瑟夫先生…就只能看运气了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020220
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 708020220,
					"content": "总之，我已经让协会里有能力进入雪山的人都去展开搜救了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020221
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 708020221,
					"content": "我也准备一下，等会就去雪山里参加搜救。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020222,
						708020223
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 708020222,
					"content": "我和你一起去。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020224
					]
				},
				{
					"id": 708020224,
					"content": "你愿意帮忙吗？太好了，那我们就一起出发吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 708020223,
					"content": "我去打倒那些魔物。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020224
					]
				},
				{
					"id": 708020217,
					"content": "也许是另外哪位迷路的冒险家…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020218
					]
				}
			]
		},
