				"points": []
			},
			"dialogs": [
				{
					"id": 708020101,
					"content": "这次，真的能找到爸爸吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020102
					],
					"speakerTitle": "乔尔"
				},
				{
					"id": 708020102,
					"content": "你爸爸有消息了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020103
					]
				},
				{
					"id": 708020103,
					"content": "#大{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}，是你呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020104
					],
					"speakerTitle": "乔尔"
				},
				{
					"id": 708020104,
					"content": "帕拉德哥哥和我说，塞琉斯叔叔好像找到了和我爸爸有关的消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020105
					],
					"speakerTitle": "乔尔"
				},
				{
					"id": 708020105,
					"content": "虽然他还不能确定…但帕拉德哥哥说，这次他们找到的线索很有力，说不定真能找到我爸爸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020106
					],
					"speakerTitle": "乔尔"
				},
				{
					"id": 708020106,
					"content": "我想要和他们一起进雪山去，但塞琉斯叔叔要我留在营地里，有了消息他们自然会告诉我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020107
					],
					"speakerTitle": "乔尔"
				},
				{
					"id": 708020107,
					"content": "#大{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}，如果可以的话，你能帮我去向塞琉斯叔叔打听一下消息吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020108,
						708020109
					],
					"speakerTitle": "乔尔"
				},
				{
					"id": 708020108,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020110
					]
				},
				{
					"id": 708020110,
					"content": "我、我害怕听到…不好的消息…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020111
					],
					"speakerTitle": "乔尔"
				},
				{
					"id": 708020111,
					"content": "#总之，拜托你了！大{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "乔尔"
				},
				{
					"id": 708020109,
					"content": "你为什么不自己去问？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020110
					]
				}
			]
		},
		{
			"id": 7080202,
			"completionStepIds": [
				7080203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
