						708020402,
						708020404
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 708020402,
					"content": "帕拉德已经开始搜索了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020403
					]
				},
				{
					"id": 708020403,
					"content": "嗯，那家伙偶尔还是能干点正事的嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020406
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 708020406,
					"content": "等我整理一下手上的情报之后，也会去雪山那边见见乔尔那孩子，把事情详细地讲给他听。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020407
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 708020407,
					"content": "旅行者，请你先去告诉乔尔，我等一下就会过去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020408
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 708020408,
					"content": "我整理情报还要些时间，可别让那孩子等急了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 708020404,
					"content": "真的能找到那个人吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020405
					]
				},
				{
					"id": 708020405,
					"content": "这我…不能保证。只能说，我们会尽最大的努力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020406
					],
					"speakerTitle": "塞琉斯"
				}
			]
