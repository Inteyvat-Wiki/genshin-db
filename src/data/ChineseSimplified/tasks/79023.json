			"dialogs": [
				{
					"id": 790230301,
					"content": "不过，他说的徽记不会就是我们之前在海边捡到的那个吧…就是那枚看上去有点破旧的那个！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790230302,
					"content": "不如把那枚徽记给他看看吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790230303,
					"content": "嗯，把徽记给他看…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7902305,
			"completionStepIds": [
				7902307
