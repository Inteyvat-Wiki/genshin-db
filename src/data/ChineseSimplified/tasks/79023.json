			"dialogs": [
				{
					"id": 790231101,
					"content": "一定得找到那个徽记…一定得找到那个徽记才行啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231102
					],
					"speakerTitle": "叶夫卡"
				},
				{
					"id": 790231102,
					"content": "（找到徽记再和他搭话吧…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7902312,
			"completionStepIds": [
				7902313
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7902313",
							"2"
						],
						"stepId": 7902313,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"叶夫卡"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790231201,
					"content": "这个…对，就是这个，这上面的划痕我记得一清二楚…嗯，这里怎么多了个缺口…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231202
					],
					"speakerTitle": "叶夫卡"
				},
				{
					"id": 790231202,
					"content": "对了，那时候雅科夫把这个徽记往下扔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231203
					],
					"speakerTitle": "叶夫卡"
				},
				{
					"id": 790231203,
					"content": "是嘛，怪不得这个徽记在那么奇怪的地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790231204,
					"content": "原来是这样，哈哈哈，没想到在海边，终于找到了…真是谢谢你们啊，这世上这么好心的人可不多了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231205
					],
					"speakerTitle": "叶夫卡"
				},
				{
					"id": 790231205,
					"content": "#不对，你们是…你们是{NICKNAME}和派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231206
					],
					"speakerTitle": "叶夫卡"
				},
				{
					"id": 790231206,
					"content": "#对，我就是{NICKNAME}！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790231207
					]
				},
				{
					"id": 790231207,
					"content": "对，我就是派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790231208,
					"content": "我明白了…既然落到了你们的手里，那也没有什么办法了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231209
					],
					"speakerTitle": "叶夫卡"
				},
				{
					"id": 790231209,
					"content": "我的父亲曾这样教导我，「如若落在敌手受辱，还不如慷慨就义，为家族赢得荣誉」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231210
					],
					"speakerTitle": "叶夫卡"
				},
				{
					"id": 790231210,
					"content": "呜哇，听上去有点可怕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231211,
						790231212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790231211,
					"content": "居然说这样的话…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790231213
					]
				},
				{
					"id": 790231213,
					"content": "不过我们只是好奇你出现在这里的目的而已啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790231214,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231215
					],
					"speakerTitle": "叶夫卡"
				},
				{
					"id": 790231215,
					"content": "我的父亲曾这样教导我，「向敌人说出情报，那就和背叛没什么两样，我们家族没有为了苟活而背叛的人！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231216
					],
					"speakerTitle": "叶夫卡"
				},
				{
					"id": 790231216,
					"content": "严厉过头了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790231217,
					"content": "严厉过头了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790231218
					]
				},
				{
					"id": 790231218,
					"content": "所以按照父亲的教导，不仅落在你们手上，还接受了你们的帮助，实在是让人感到羞愧的一件事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231219
					],
					"speakerTitle": "叶夫卡"
				},
				{
					"id": 790231219,
					"content": "实不相瞒，我现在，羞愧得想要大哭一场！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231220
					],
					"speakerTitle": "叶夫卡"
				},
				{
					"id": 790231220,
					"content": "知道了，这又不是什么值得自豪的事，没必要说那么大声啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790231221,
					"content": "但是父亲也曾这样教导我，「受人恩惠，就该好好回报。」父亲的教导，在现在的情况里，产生了矛盾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231222
					],
					"speakerTitle": "叶夫卡"
				},
				{
					"id": 790231222,
					"content": "所以我决定…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231223
					],
					"speakerTitle": "叶夫卡"
				},
				{
					"id": 790231223,
					"content": "你决定？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790231224,
					"content": "就按照我的意思来吧，我会告诉你们的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231225
					],
					"speakerTitle": "叶夫卡"
				},
				{
					"id": 790231225,
					"content": "突然就变得随意了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790231226,
					"content": "我的名字是叶夫卡，原本是在做装置信号的测试工作…唔，这段记忆有点不清楚，总之，我记得我们一路来到这座岛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231227
					],
					"speakerTitle": "叶夫卡"
				},
				{
					"id": 790231227,
					"content": "哦，对了，雅科夫，我是和雅科夫一起行动的，这之间还和他大吵了一架，导致他扔掉了这枚徽记…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231228
					],
					"speakerTitle": "叶夫卡"
				},
				{
					"id": 790231228,
					"content": "后来我…眼睁睁地看着雅科夫走进一个奇怪的东西里，然后他就和那个东西一起消失了。我不会从此以后都见不到他了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231229
					],
					"speakerTitle": "叶夫卡"
				},
				{
					"id": 790231229,
					"content": "所以我才在这里，找能重新见到他的方法…然后不知道为什么脑袋「嗡」了一下，就变成了刚才那样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231230
					],
					"speakerTitle": "叶夫卡"
				},
				{
					"id": 790231230,
					"content": "走进去就会消失的奇怪的东西…是什么金苹果群岛的怪谈吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231231,
						790231232
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790231231,
					"content": "是恐怖的扭曲陷阱！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790231233
					]
				},
				{
					"id": 790231233,
					"content": "应该不是那样的东西吧…说不定其实就跟我们以前见过的那些奇怪的机关道路一样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231234
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790231234,
					"content": "说不定确实有重新打开的办法呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231235
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790231235,
					"content": "你们，你们能打开那个吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231236
					],
					"speakerTitle": "叶夫卡"
				},
				{
					"id": 790231236,
					"content": "可以是可以啦，不过我们为什么要帮你呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231237
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790231237,
					"content": "明明是愚人众呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790231238
					]
				},
				{
					"id": 790231238,
					"content": "如果你们能打开，找到雅科夫，你们要我说什么我都会说的…啊，执行官大人们的坏话除外。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231239
					],
					"speakerTitle": "叶夫卡"
				},
				{
					"id": 790231239,
					"content": "哇，答应得好快，弄得我都觉得自己是反派了…而且，这个时候就遗忘你父亲的教导了吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231240
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790231240,
					"content": "本来就是因为我的过错所以雅科夫才…有些事情，是比所谓的原则和教导更重要的…我是这么认为的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231241
					],
					"speakerTitle": "叶夫卡"
				},
				{
					"id": 790231241,
					"content": "#好吧！{NICKNAME}，我们就试试看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790231232,
					"content": "是无形的吃人魔物！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790231233
					]
				},
				{
					"id": 790231212,
					"content": "不是合格的父亲会说的话！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790231213
					]
				}
			]
		},
