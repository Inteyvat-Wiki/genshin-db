			},
			"dialogs": [
				{
					"id": 790232001,
					"content": "（留声机里播放着，让人能回想起温暖过去的话语……）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232002
					],
					"speakerTitle": "雅科夫"
				},
				{
					"id": 790232002,
					"content": "啊…为什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232003
					],
					"speakerTitle": "雅科夫"
				},
				{
					"id": 790232003,
					"content": "雅科夫，雅科夫你醒醒啊！你怎么，怎么变成了这个样子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232004
					],
					"speakerTitle": "叶夫卡"
				},
				{
					"id": 790232004,
					"content": "你之前也是这个样子啦，而且还念叨着那个徽记呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232005
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790232005,
					"content": "哦，对哦，那个徽记…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232006
					],
					"speakerTitle": "叶夫卡"
				},
				{
					"id": 790232006,
					"content": "雅科夫，你看，这是你的徽记。虽然你一气之下把它扔了，但是现在已经找到了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232007
					],
					"speakerTitle": "叶夫卡"
				},
				{
					"id": 790232007,
					"content": "这是你和你父亲一起获得的荣誉，现在已经重新回到你的手中了…怎么样，雅科夫，你醒过来了吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232030
					],
					"speakerTitle": "叶夫卡"
				},
				{
					"id": 790232030,
					"content": "为什么…为什么…为什么要抛下我一个人...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232008
					],
					"speakerTitle": "雅科夫"
				},
				{
					"id": 790232008,
					"content": "还是没有恢复呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232009
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790232009,
					"content": "难道这不是能唤醒他的东西吗…那他到底想要的是什么呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232010
					],
					"speakerTitle": "叶夫卡"
				},
				{
					"id": 790232010,
					"content": "他想要的是什么，你居然不知道吗…你们不是队友嘛？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232011
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790232011,
					"content": "我…我一直以为他最重要的就是这份荣誉，不对，我错了，是「我以为」他觉得最重要的就是这个…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232012
					],
					"speakerTitle": "叶夫卡"
				},
				{
					"id": 790232012,
					"content": "那是他和他父亲一起出一个紧急任务得来的，只不过他的父亲牺牲了，再也没有回来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232013
					],
					"speakerTitle": "叶夫卡"
				},
				{
					"id": 790232013,
					"content": "他的母亲在他出生的时候就去世了…失去父亲以后，他就变成了孤伶伶的一个人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232014
					],
					"speakerTitle": "叶夫卡"
				},
				{
					"id": 790232014,
					"content": "唉，他年纪比我小，得过的荣誉却比我多，说不定我只是一直在嫉妒他，也不知道如何和他相处，我唯一能够参照的就是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232015
					],
					"speakerTitle": "叶夫卡"
				},
				{
					"id": 790232015,
					"content": "不会是你父亲跟你相处的方式吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232016
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790232016,
					"content": "说来惭愧，但是确实如此…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232017
					],
					"speakerTitle": "叶夫卡"
				},
				{
					"id": 790232017,
					"content": "这样不出问题才怪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232018
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790232018,
					"content": "我们这支小队的休整处在海域中央的岛屿，现在雅科夫这个样子，我必须得先把他送到那边去才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232019
					],
					"speakerTitle": "叶夫卡"
				},
				{
					"id": 790232019,
					"content": "哦，对了，我们…我们是受佩尔西科夫研究员指派，过来进行信号测试的成员。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232020
					],
					"speakerTitle": "叶夫卡"
				},
				{
					"id": 790232020,
					"content": "据说是某位执行官大人在须弥得到了什么新的知识，可以通过一些技术，连接他人的意识，影响到一整片区域…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232021
					],
					"speakerTitle": "叶夫卡"
				},
				{
					"id": 790232021,
					"content": "虽然不被看好，但是佩尔西科夫研究员还是强行开始了这次的实验，而我们则被指派前往海域各处进行装置的信号测试…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232022
					],
					"speakerTitle": "叶夫卡"
				},
				{
					"id": 790232022,
					"content": "对了，不知道佩尔西科夫研究员的实验进行的如何了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232023
					],
					"speakerTitle": "叶夫卡"
				},
				{
					"id": 790232023,
					"content": "那还用问，我们出现在了这里，愚人众的实验…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232024
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790232024,
					"content": "当然是失败了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790232025
					]
				},
				{
					"id": 790232025,
					"content": "是嘛，嘿嘿，这下那个佩尔西科夫研究员恐怕要吃苦头了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232026
					],
					"speakerTitle": "叶夫卡"
				},
				{
					"id": 790232026,
					"content": "我知道的也只有这么多了，我之前就跟别的队员约好，完成测试任务，就要回海域中心岛屿的营地…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232027
					],
					"speakerTitle": "叶夫卡"
				},
				{
					"id": 790232027,
					"content": "啊，是之前碰到的愚人众！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232028
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790232028,
					"content": "是嘛，原来你们已经见过她们了呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232029
					],
					"speakerTitle": "叶夫卡"
				},
				{
					"id": 790232029,
					"content": "唉…要是让阿加霞看到雅科夫这个样子，非得生我的气不可…不过无论如何，我得赶紧把雅科夫带回去才行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "叶夫卡"
				}
			]
		},
