			"trigger": {
				"objectNames": [
					"叶夫卡"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790230101,
					"content": "都是因为我…都是因为我他才会那样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230102
					],
					"speakerTitle": "叶夫卡"
				},
				{
					"id": 790230102,
					"content": "不行，我得把…我得把徽记找回来给他…得把徽记找回来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230103
					],
					"speakerTitle": "叶夫卡"
				},
				{
					"id": 790230103,
					"content": "这个愚人众的家伙在念叨着什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790230104,
					"content": "喂，你在这里干什么呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790230105,
					"content": "徽记，徽记…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230106,
						790230107
					],
					"speakerTitle": "叶夫卡"
				},
				{
					"id": 790230106,
					"content": "状态不太对…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790230108
					]
				},
				{
					"id": 790230108,
					"content": "唔，稍微有点在意呢，为什么一个雷锤前锋军会在这里，不会在做什么坏事吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790230109,
					"content": "#{NICKNAME}，你觉得呢，这个雷锤前锋军…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790230110,
					"content": "只有冲锋攻击需要注意…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790230111
					]
				},
				{
					"id": 790230111,
					"content": "确实，雷锤前锋军冲刺的时候可让人害怕了…不对，我没在说这个啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790230112,
					"content": "我是说，我们是不是应该让他清醒过来，问问他在这里干什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790230113,
					"content": "确实有点好奇…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790230114
					]
				},
				{
					"id": 790230114,
					"content": "对吧，一个愚人众在这里，说着什么「徽记，徽记…」之类的话，像是要找什么东西似的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790230115,
					"content": "这可不是平常走在路上能见到的事呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790230116,
					"content": "可是，他到底为什么变成了现在这样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790230117,
					"content": "因为那个装置吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790230118
					]
				},
				{
					"id": 790230118,
					"content": "是哦，愚人众也受到了那个装置的影响，不过到底有什么办法能够让他变得清醒过来呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790230119,
					"content": "一定得找到那个徽记…一定得找到那个徽记才行啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230120
					],
					"speakerTitle": "叶夫卡"
				},
				{
					"id": 790230120,
					"content": "#看来他好像一直在找什么徽记的样子…{NICKNAME}，看来得把他在找的徽记给他呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790230107,
					"content": "没法沟通呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790230108
					]
				}
			]
		},
