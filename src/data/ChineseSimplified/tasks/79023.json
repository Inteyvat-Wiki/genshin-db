			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"叶夫卡"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790230801,
					"content": "都是因为我…都是因为我他才会那样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230802
					],
					"speakerTitle": "叶夫卡"
				},
				{
					"id": 790230802,
					"content": "不行，我得把…我得把徽记找回来给他…得把徽记找回来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230803
					],
					"speakerTitle": "叶夫卡"
				},
				{
					"id": 790230803,
					"content": "喂，你在这里做什么呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230804
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790230804,
					"content": "徽记，徽记…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230805
					],
					"speakerTitle": "叶夫卡"
				},
				{
					"id": 790230805,
					"content": "完全不理我们呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230806
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790230806,
					"content": "派蒙再叫大声一点吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790230807
					]
				},
				{
					"id": 790230807,
					"content": "这明显是听不到我们的话啦，喊再大声也没用…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230808
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790230808,
					"content": "根本就和阿加菲娅一开始的时候一模一样嘛，那个时候把带着合照的怀表给阿加菲娅以后，她就醒过来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230809
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790230809,
					"content": "这个雷锤前锋军，难道也有什么能让他从装置的影响里醒过来的东西吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230810
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790230810,
					"content": "#看来他好像一直在找什么徽记的样子…{NICKNAME}，看来得把他在找的徽记给他呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
