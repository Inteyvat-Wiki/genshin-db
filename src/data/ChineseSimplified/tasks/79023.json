					"叶夫卡"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790230501,
					"content": "原来这里还有这样的一座岛…还真是奇怪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230502
					],
					"speakerTitle": "叶夫卡"
				},
				{
					"id": 790230502,
					"content": "之前，我们在进行调查的时候，不记得有这样一座岛啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230503
					],
					"speakerTitle": "叶夫卡"
				},
				{
					"id": 790230503,
					"content": "叶夫卡…怎么了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790230504,
					"content": "不，没什么事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230505
					],
					"speakerTitle": "叶夫卡"
				},
				{
					"id": 790230505,
					"content": "嗯，看来雅科夫肯定也来到了这个岛上！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790230506,
					"content": "对，雅科夫，得赶紧找到雅科夫才行。雅科夫——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230507
					],
					"speakerTitle": "叶夫卡"
				},
				{
					"id": 790230507,
					"content": "哇，都说了，别突然叫这么大声啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790230508,
					"content": "抱歉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230509
					],
					"speakerTitle": "叶夫卡"
				},
				{
					"id": 790230509,
					"content": "#没必要那么紧张，这里应该是很安全的地方，好，{NICKNAME}，我们就先去找找雅科夫在哪吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
