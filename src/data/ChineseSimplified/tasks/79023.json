					"叶夫卡"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790231501,
					"content": "还没有找到打开机关的办法吗…啊，不是在催你们的意思，怎么了，有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231502,
						790231504,
						790231508
					],
					"speakerTitle": "叶夫卡"
				},
				{
					"id": 790231502,
					"content": "你们为什么会来群岛…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790231503
					]
				},
				{
					"id": 790231503,
					"content": "我们当然是为了完成光荣的使命，不过具体是什么…找到雅科夫之后，我再跟你说吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "叶夫卡"
				},
				{
					"id": 790231504,
					"content": "那枚徽记…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790231505
					]
				},
				{
					"id": 790231505,
					"content": "你是说，那枚徽记明明不是我的，但是对它很熟悉，觉得很奇怪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231506
					],
					"speakerTitle": "叶夫卡"
				},
				{
					"id": 790231506,
					"content": "那枚徽记是雅科夫的，他以前和自己的父亲一起去执行一项任务，但是回来的时候就只有他自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231507
					],
					"speakerTitle": "叶夫卡"
				},
				{
					"id": 790231507,
					"content": "那枚徽记就是那次任务之后得到的…我很羡慕他能够获得这样的荣誉，所以曾经借过来看过很多次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "叶夫卡"
				},
				{
					"id": 790231508,
					"content": "再见…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
