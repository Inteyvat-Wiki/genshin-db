			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"萍姥姥"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10140101,
					"content": "世事无常，世事无常…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140102,
						10140105
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140102,
					"content": "您好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140103
					]
				},
				{
					"id": 10140103,
					"content": "咦？年轻人，你是来赏花的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140104
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140104,
					"content": "可惜啊，你来得不是时候，这「琉璃百合」，都要谢完了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140107
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140107,
					"content": "这些花…为什么都谢了呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10140108,
					"content": "在我那个年头，人们说「琉璃百合」通人性。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140109
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140109,
					"content": "如果它们听见了好声音，比如笑声啦，歌声啦…它们就会很高兴，会长得很好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140110
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140110,
					"content": "但如果反过来，听了太多不好的声音…比如乱七八糟的流言蜚语，它们就会枯萎得很快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140111
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140111,
					"content": "…所以，现在璃月港里的状况，这些花也感觉到了呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10140112,
					"content": "是啊，岩王帝君之死的传言，可不是小事。这大街小巷里，说什么的都有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140113
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140113,
					"content": "有人说是愚人众的阴谋，有人说是「海里的东西」要镇不住了，还有人说，这些都是七星自导自演的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140114
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140114,
					"content": "这座港口，就和柴火堆一样。只要一点火星，火就要止不住了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140115
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140115,
					"content": "唉，话头就到这打住吧，我老婆子年纪大了，就喜欢唠叨…年轻人，你们找我有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140116,
						10140121
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140116,
					"content": "想借您的「涤尘铃」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140117
					]
				},
				{
					"id": 10140117,
					"content": "喔，那个老物件啊…我记得。确实在我这，但是具体放在哪…我老婆子就记不清啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140118
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140118,
					"content": "那是我年轻的时候，一个老朋友身上戴着的小玩意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140119
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140119,
					"content": "他看我老是眼巴巴地看着，就把铃铛送给我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140120
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140120,
					"content": "但他当年就和我说，假如以后有人来借这个铃铛，我可不能舍不得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140127
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140127,
					"content": "这么多年了，这铃铛也不知道被借走了多少次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140128
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140128,
					"content": "但是，不知道从什么时候开始，已经很久没人再来借这个铃铛啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140129
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140129,
					"content": "唉，我这个老身子骨，找起东西来慢吞吞的，你们怕是等不得哟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140130,
						10140133
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140130,
					"content": "我们自己来找就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140131
					]
				},
				{
					"id": 10140131,
					"content": "对，婆婆，我们陪您回家，然后我们自己来找。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10140132,
					"content": "还能…还能帮您收拾屋子呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10140135,
					"content": "好啦，孩子们，那个铃铛我也没有放多远，你们也别太操心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140136
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140136,
					"content": "咦？婆婆，您家就在这附近吗？呜哇…这可是玉京台呀，真有钱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140137
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10140137,
					"content": "呵呵，我老婆子可置办不起城里的房子——看看这个壶，我的全部家当都放在里面啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140138
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140138,
					"content": "全部家当…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140139,
						10140140,
						10140143
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10140139,
					"content": "您是指，把屋子钥匙放里面了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140146
					]
				},
				{
					"id": 10140146,
					"content": "呵呵呵…孩子们，总之铃铛就放在这个壶里。想找铃铛的话，就自己去看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140140,
					"content": "您的家当就一个铃铛吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140141
					]
				},
				{
					"id": 10140141,
					"content": "这么说很不礼貌！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140142
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10140142,
					"content": "就，就算是这样，那…那也是个很珍贵的铃铛！对吧，婆婆？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140146
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10140143,
					"content": "派蒙进壶里看看吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140144
					]
				},
				{
					"id": 10140144,
					"content": "进不去！怎么想我都进不去吧？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140145
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10140145,
					"content": "而且你为什么要让我进去，掀开盖子看看不就好了吗！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140146
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10140133,
					"content": "我跟西风骑士团长学过找东西。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140134
					]
				},
				{
					"id": 10140134,
					"content": "唔…突然在意外的地方自豪起来了？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10140121,
					"content": "想找您借个东西…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140122
					]
				},
				{
					"id": 10140122,
					"content": "东西？喔…你们是要来借「涤尘铃」的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140123
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140123,
					"content": "除了这个老物件，我也没什么值得你们年轻人来求的了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140124
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140124,
					"content": "不过，这铃铛本来也不是我的，本来是我一个老朋友戴着的小玩意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140125
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140125,
					"content": "我年轻的时候爱漂亮，喜欢那个铃铛，所以就黏着他，一个劲地央求…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140126
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140126,
					"content": "他拗不过我，所以就把铃铛送给我了。不过他和我说，假如以后有人来借铃铛，我可不能舍不得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140127
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140105,
					"content": "您怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140106
					]
				},
				{
					"id": 10140106,
					"content": "没事，没事，我只不过看见「琉璃百合」谢了太多，觉得太可惜了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140107
					],
					"speakerTitle": "萍姥姥"
				}
			]
		},
		{
			"id": 101402,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101406",
							"2"
						],
						"stepId": 101406,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"萍姥姥"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10140201,
					"content": "孩子们，你们不是急着要铃铛吗？还不快去找？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140202
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140202,
					"content": "不过这壶我很久没打扫，你们可要当心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140203
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140203,
					"content": "穿着这么漂亮的衣服，弄脏的话，洗干净可要花功夫喽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "萍姥姥"
				}
			]
		},
		{
			"id": 101403,
			"completionStepIds": [
				101403
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101403",
							"2"
						],
						"stepId": 101403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"萍姥姥"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10140301,
					"content": "年轻人手脚就是利索，这么一会，就拿到了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140302,
						10140305,
						10140308
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140302,
					"content": "您是仙人吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140303
					]
				},
				{
					"id": 10140303,
					"content": "仙人…这两个字，我老婆子可很久没有听人正经提起了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140304
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140304,
					"content": "至于我是不是仙人，孩子，你心里难道不明白吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140312
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140312,
					"content": "唔…好像懂了，又好像没全懂。不过婆婆，您…就这么把铃铛给我们了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10140313,
					"content": "您不奇怪吗？岩王帝君刚出事，我们就急匆匆地找您来要铃铛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10140314,
					"content": "傻孩子，璃月港古往今来，不知道有多少仙人离开，也不知道折腾出了多少风浪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140315
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140315,
					"content": "但无论是哪一次，都是按规矩先把「送仙典仪」办体面了，再去安排后面的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140316
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140316,
					"content": "一个劲地喊着「抓凶手」，却耽误了「送仙典仪」，在我看来，才是本末倒置。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140317
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140317,
					"content": "现在你们来借铃铛，我揣摩着，大概是哪位老朋友终于看不过眼，出来主持大局了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140318
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140318,
					"content": "所以，我又怎么会不肯借铃铛给你们呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140319,
						10140322
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140319,
					"content": "要是您的「老朋友」借了不还呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140320
					]
				},
				{
					"id": 10140320,
					"content": "不还？哈哈哈，要是他们真腆着脸这么干了，那我老婆子说不得就要走一趟了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140321
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140321,
					"content": "正好很久没见，去找他们喝喝茶，聊聊天，也是很好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140326
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140326,
					"content": "好了，既然拿到了东西，就快点回去吧，可别误事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140327
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140327,
					"content": "再帮我给那位差遣你们的人带句话，就说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140328
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140328,
					"content": "有空的话，过来喝喝茶也是可以的。老婆子我没什么家当，但总归还是有盏茶壶的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140329
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140329,
					"content": "嗯！我们记住啦，谢谢婆婆！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10140322,
					"content": "这铃铛能送我吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140323
					]
				},
				{
					"id": 10140323,
					"content": "喂！你这个人，这可是婆婆的东西呀！用完了就要还给人家！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140324
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10140324,
					"content": "送你？你这孩子还真直白，哈哈哈，你想拿就拿着吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140325
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140325,
					"content": "不过这铃铛很恋家，指不定什么时候啊，它就溜回我老婆子这来咯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140326
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140305,
					"content": "您是「璃月七星」的人吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140306
					]
				},
				{
					"id": 10140306,
					"content": "「璃月七星」…那些孩子，很久之前就不愿意让我这老婆子…还有我的老伙计们…去帮工喽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140307
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140307,
					"content": "不过，这些年他们做得也不错。我们这些老家伙，也乐得个清闲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140312
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140308,
					"content": "难道您是愚人众的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140309
					]
				},
				{
					"id": 10140309,
					"content": "愚人众？哈哈哈，你这孩子，心思倒是多得很，成天都在想些什么歪门故事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140310
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140310,
					"content": "我老婆子一把年纪了，可懒得和这些外人折腾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140311
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 10140311,
					"content": "不过，他们的手要是再伸长一点，该劳碌的，还是要劳碌的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140312
					],
					"speakerTitle": "萍姥姥"
				}
			]
		},
