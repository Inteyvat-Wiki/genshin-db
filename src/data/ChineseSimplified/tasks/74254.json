			"dialogs": [
				{
					"id": 742540601,
					"content": "真是平静惬意的日子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540602,
						742540603
					],
					"speakerTitle": "玛丽安"
				},
				{
					"id": 742540602,
					"content": "（再这么坐一会儿吧。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540604
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 742540604,
					"content": "嗯，感谢你的邀请。桑多涅…妹妹？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玛丽安"
				},
				{
					"id": 742540603,
					"content": "茶会时间该结束了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540604
					],
					"speakerTitle": "「木偶」"
				}
			]
		}
