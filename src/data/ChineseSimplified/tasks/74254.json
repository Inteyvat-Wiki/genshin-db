			"dialogs": [
				{
					"id": 742540501,
					"content": "西摩尔！好久不见！还有玛梅赫也是！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540502
					],
					"speakerTitle": "安"
				},
				{
					"id": 742540502,
					"content": "哈哈，西摩尔在旅途中也经常和我说他很想你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540503
					],
					"speakerTitle": "玛梅赫"
				},
				{
					"id": 742540503,
					"content": "肯定。我无时不在思念着玛丽安小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540504
					],
					"speakerTitle": "西摩尔"
				},
				{
					"id": 742540504,
					"content": "也多谢桑多涅小姐愿意举办这样一场茶会，让我们有机会重新聚在一起，聊聊旅途的见闻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540505
					],
					"speakerTitle": "玛丽安"
				},
				{
					"id": 742540505,
					"content": "没什么。我只是觉得大家多少也算是有历史渊源的一家人。呃，应该能算吧。所以有空就聚聚没什么不好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540506
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 742540506,
					"content": "一家人？不知道为什么，听到这样的说法我好高兴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540507
					],
					"speakerTitle": "安"
				},
				{
					"id": 742540507,
					"content": "那桑多涅小姐算是家里的…妹妹？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540508
					],
					"speakerTitle": "玛丽安"
				},
				{
					"id": 742540508,
					"content": "呃…虽说是「一家人」，但算辈分这种事要不还是免了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540509
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 742540509,
					"content": "肯定。作为阿兰先生创造的原型机，桑多涅小姐应该称呼我为「大哥」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540510
					],
					"speakerTitle": "西摩尔"
				},
				{
					"id": 742540510,
					"content": "啧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540511
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 742540511,
					"content": "真好呀。我也能算是你们的家庭成员吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540512
					],
					"speakerTitle": "玛梅赫"
				},
				{
					"id": 742540512,
					"content": "当然可以，这个「家庭」看起来什么都有了，再来一只美露莘也没什么奇怪的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540513
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 742540513,
					"content": "肯定。玛梅赫小姐就是我的家人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540514
					],
					"speakerTitle": "西摩尔"
				},
				{
					"id": 742540514,
					"content": "嘿嘿。真开心。那不如，我来为这个「家庭」画一幅画吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540515
					],
					"speakerTitle": "玛梅赫"
				},
				{
					"id": 742540515,
					"content": "全家福？真是好久没有过了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540516
					],
					"speakerTitle": "玛丽安"
				},
				{
					"id": 742540516,
					"content": "可要把我画得看起来厉害一点哦！就像家里的姐姐一样！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540517
					],
					"speakerTitle": "安"
				},
				{
					"id": 742540517,
					"content": "嗯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540518
					],
					"speakerTitle": "玛梅赫"
				},
				{
					"id": 742540518,
					"content": "哈…随你们便吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「木偶」"
				}
			]
		},
