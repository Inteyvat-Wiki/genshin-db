			},
			"dialogs": [
				{
					"id": 701060201,
					"content": "关于冷鲜肉…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060202
					]
				},
				{
					"id": 701060202,
					"content": "这些「冷鲜肉」看起来还不错啊…嗯，这样就只差一种食材了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060203
					],
					"speakerTitle": "哈里斯"
				},
				{
					"id": 701060203,
					"content": "你听说过「大雪猪王」吗？据说，它是生活在雪山深处的猛兽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060204
					],
					"speakerTitle": "哈里斯"
				},
				{
					"id": 701060204,
					"content": "我看有些食谱上说，「大雪猪王」的肉品质极佳，无论是煎炸烹煮都很不错…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060205
					],
					"speakerTitle": "哈里斯"
				},
				{
					"id": 701060205,
					"content": "旅行者，还得麻烦你帮忙跑一趟了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060206
					],
					"speakerTitle": "哈里斯"
				},
				{
					"id": 701060206,
					"content": "报酬的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060207
					]
				},
				{
					"id": 701060207,
					"content": "别担心，报酬我已经给你准备好了。那么就拜托你了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "哈里斯"
				}
			]
		},
