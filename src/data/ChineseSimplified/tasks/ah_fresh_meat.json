			"dialogs": [
				{
					"id": 701060401,
					"content": "关于「大雪猪王」的肉…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060402
					]
				},
				{
					"id": 701060402,
					"content": "哦，你已经拿到「大雪猪王」的肉了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060403
					],
					"speakerTitle": "哈里斯"
				},
				{
					"id": 701060403,
					"content": "都搜集齐了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060404
					]
				},
				{
					"id": 701060404,
					"content": "这样的话…食材就齐全了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060405
					],
					"speakerTitle": "哈里斯"
				},
				{
					"id": 701060405,
					"content": "我趁着你去搜集食材的功夫，也把食谱整理好了。和那道「古代食谱」还差得挺多的…哈哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060406
					],
					"speakerTitle": "哈里斯"
				},
				{
					"id": 701060406,
					"content": "不过嘛，不管做法怎么样，只要好吃就行了。我把这道菜命名为「稠汁蔬菜炖肉」，做起来倒也方便…唔，你要不要自己来试试看？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060407
					],
					"speakerTitle": "哈里斯"
				},
				{
					"id": 701060407,
					"content": "你自己来试试看吧，如果学会了的话，以后你也可以自己做着吃了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "哈里斯"
				}
			]
		},
