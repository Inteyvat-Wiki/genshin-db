			"trigger": {
				"objectNames": [
					"哈里斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701060101,
					"content": "就差这些食材了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060102
					],
					"speakerTitle": "哈里斯"
				},
				{
					"id": 701060102,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060103
					]
				},
				{
					"id": 701060103,
					"content": "啊？是旅行者啊，我正在琢磨一道「古代食谱」呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060104
					],
					"speakerTitle": "哈里斯"
				},
				{
					"id": 701060104,
					"content": "不久之前，有一队探险队进入雪山探索，我认识的一位冒险家也在里面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060105
					],
					"speakerTitle": "哈里斯"
				},
				{
					"id": 701060105,
					"content": "虽然他们因为恶劣的气候也没有探索多远，但那位冒险家说，他们在躲避风雪的时候，意外撞进了一处遗迹里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060106
					],
					"speakerTitle": "哈里斯"
				},
				{
					"id": 701060106,
					"content": "里面都是书籍一类的东西，他们还从里面发现了一份…食谱，居然保存地还算完好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060107
					],
					"speakerTitle": "哈里斯"
				},
				{
					"id": 701060107,
					"content": "那位冒险家把这份食谱交给了我，拜托我试试复原这道「古代美食」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060108
					],
					"speakerTitle": "哈里斯"
				},
				{
					"id": 701060108,
					"content": "说实话，那份食谱上的很多材料我都没听说过，一些做法我也是闻所未闻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060109
					],
					"speakerTitle": "哈里斯"
				},
				{
					"id": 701060109,
					"content": "所以，我就自己改造了一下那份食谱，只保留了最核心的几道特殊食材…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060118
					],
					"speakerTitle": "哈里斯"
				},
				{
					"id": 701060118,
					"content": "如果你愿意的话，能帮我搜集一下那些特殊食材吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060110,
						701060112
					],
					"speakerTitle": "哈里斯"
				},
				{
					"id": 701060110,
					"content": "交给我吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060111
					]
				},
				{
					"id": 701060111,
					"content": "哦，很有气势嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060113
					],
					"speakerTitle": "哈里斯"
				},
				{
					"id": 701060113,
					"content": "我听人说，一些小猪误入雪山后，也被冻在了冰里，我想…这些猪肉的味道，也许会有些新奇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060114
					],
					"speakerTitle": "哈里斯"
				},
				{
					"id": 701060114,
					"content": "所以，我想请你去找到那些被冻住的小猪，搜集十份「冷鲜肉」来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060115
					],
					"speakerTitle": "哈里斯"
				},
				{
					"id": 701060115,
					"content": "冷鲜肉是什么…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060116
					]
				},
				{
					"id": 701060116,
					"content": "啊，是我给那些小猪的肉取的名字。被冷冻在冰里保持着鲜美的猪肉，不就是「冷鲜肉」吗？哈哈哈，这个名字是不是很不错？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060117
					],
					"speakerTitle": "哈里斯"
				},
				{
					"id": 701060117,
					"content": "那就拜托你了，找齐食材之后就拿来给我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "哈里斯"
				},
				{
					"id": 701060112,
					"content": "需要什么食材？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060113
					]
				}
			]
		},
