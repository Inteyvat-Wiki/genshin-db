				]
			},
			"dialogs": [
				{
					"id": 402250101,
					"content": "这艘船…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402250102,
					"content": "死兆星号？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402250103
					]
				},
				{
					"id": 402250103,
					"content": "这是舰队里的二号舰，死兆星号还在孤云阁巡逻呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250104
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 402250104,
					"content": "是北斗！嗯…是纵横远海的佣兵巨头！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402250105,
					"content": "哈哈，又不是第一次见面，用这么恭维的称呼，生分了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250106
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 402250106,
					"content": "说来话长…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402250107,
					"content": "别干站着，坐下谈吧，我让兄弟们招待一下客人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250108
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 402250108,
					"content": "原来是这样，没想到你和那位秘闻馆的主人也有交情。足迹遍及提瓦特的人，果然会攒下不得了的人脉啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250109
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 402250109,
					"content": "嘿嘿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402250110,
					"content": "对了，登记的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402250111
					]
				},
				{
					"id": 402250111,
					"content": "差点忘了，我们需要登记你这边的参展人员，还有你准备交易什么货物？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402250112,
					"content": "参展人员的话，记上我和几名看管货柜的兄弟就行，其他人都会留在船上。至于用来交易的货物…喏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250113
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 402250113,
					"content": "这是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402250114,
					"content": "很早之前，凝光就着手改良归终机，我这二号舰上装备的就是她改良后的一种型号。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250115
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 402250115,
					"content": "这种型号的归终机可以通过远程引导精准攻击目标，威力也十分惊人，在这个展会上肯定会很抢手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250116
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 402250116,
					"content": "这种东西可以拿来卖吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402250117,
					"content": "哈哈，不用担心，千岩军现在装备的最新型号比这个先进多了，这已经算是被淘汰下来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250118
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 402250118,
					"content": "…算了，就像奈芙尔说的那样，这里的交易「无所禁忌」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402250119,
					"content": "不过，谁会买这个？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402250120
					]
				},
				{
					"id": 402250120,
					"content": "不用担心，挪德卡莱贸易展会汇聚了来自提瓦特各地的买家，肯定能钓到大客户的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250121
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 402250121,
					"content": "夜兰？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402250122,
					"content": "怪我，一直忙着卸货的事，忘了告诉你们她也在船上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250123
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 402250123,
					"content": "没关系啦，话说夜兰也是参展人员吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402250124,
					"content": "我只是搭顺风船来挪德卡莱处理一些情报工作，就不用登记我的名字了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250125
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 402250125,
					"content": "#有段时间没见了，{NICKNAME}。如果有机会的话，请代我向秘闻馆的主人问好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250126
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 402250126,
					"content": "你这次来准备做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402250127
					]
				},
				{
					"id": 402250127,
					"content": "工作需要，不便多讲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250128
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 402250128,
					"content": "那是「不要继续问了」的表情吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402250129,
					"content": "我也这么认为…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402250130
					]
				},
				{
					"id": 402250130,
					"content": "那我就先下船了，等事情办完后，我请大家喝一杯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250131
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 402250131,
					"content": "哈哈，那我可要好好尝尝挪德卡莱的味道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250132
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 402250132,
					"content": "这边已经帮你们登记好了，跟我们走吧，接下来带大家去会场。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
