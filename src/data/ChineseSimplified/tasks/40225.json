			"dialogs": [
				{
					"id": 402250201,
					"content": "北斗指挥船员卸下了货物，并跟随你们来到了展会现场",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402250202
					]
				},
				{
					"id": 402250202,
					"content": "就是这里了吧？好位置！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250203
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 402250203,
					"content": "#{NICKNAME}，你有空的时候来帮我测试一下远程引导吧。很刺激的，你肯定喜欢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "北斗"
