					"nextDialogs": [
						220020303
					]
				},
				{
					"id": 220020303,
					"content": "#谢谢{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020304
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220020304,
					"content": "小蒙，阿飞，快点过来吃莲蓬啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020305
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220020305,
					"content": "喂…喂，我们还是在抢劫吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220020306,
					"content": "喔，对啊。那这些钱和东西给你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020307
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220020307,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}扮海盗真厉害，从一个小孩子手里抢走了这么多东西呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020308
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220020308,
					"content": "总感觉这孩子…话里有话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220020309,
					"content": "#这次辛苦{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}啦，下次也要陪我们一起玩呀。",
					"roleType": "TALK_ROLE_NPC",
