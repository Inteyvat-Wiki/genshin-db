			"dialogs": [
				{
					"id": 220020101,
					"content": "璐璐，怎么又是我做船长啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020102
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 220020102,
					"content": "因为小蒙做船长的时候，我们才玩得最开心呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020103
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220020103,
					"content": "璐璐觉得没问题，那我…那我也没问题…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020104
					],
					"speakerTitle": "阿飞"
				},
				{
					"id": 220020104,
					"content": "你们在做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220020105
					]
				},
				{
					"id": 220020105,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，我们正准备玩游戏呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020106
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220020106,
					"content": "小蒙是船长，阿飞是服务员，我是个有钱的商人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020107
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220020107,
					"content": "只缺一个海盗来抢劫我们啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020108
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220020108,
					"content": "你愿意扮海盗，来陪我们玩吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020109,
						220020111
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220020109,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220020110
					]
				},
				{
					"id": 220020110,
					"content": "#谢谢{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020113
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220020113,
					"content": "#好啦，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}准备好了，就来找我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220020111,
					"content": "我想做个好人…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220020112
					]
				},
				{
					"id": 220020112,
					"content": "#只是玩个游戏啦，我知道{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}一定是个好人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020113
					],
					"speakerTitle": "璐璐"
				}
			]
		},
		{
			"id": 2200202,
			"completionStepIds": [
				2200202
