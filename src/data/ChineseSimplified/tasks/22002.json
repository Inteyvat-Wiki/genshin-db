			},
			"dialogs": [
				{
					"id": 220020201,
					"content": "准备好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220020202
					]
				},
				{
					"id": 220020202,
					"content": "那我们就开始玩吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020203
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220020203,
					"content": "#那么，就请{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}开始吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020204
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220020204,
					"content": "你好，抢劫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020205
					]
				},
				{
					"id": 220020205,
					"content": "哼，大白天的就来抢劫，千岩军的叔叔们就在旁边！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020206
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 220020206,
					"content": "璐璐，快过来，我们快点跑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020207
					],
					"speakerTitle": "阿飞"
				},
				{
					"id": 220020207,
					"content": "你好，你是来抢什么的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020208,
						220020209
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220020208,
					"content": "呃，应该是钱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020212
					]
				},
				{
					"id": 220020212,
					"content": "可是我没多少钱可以抢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020213
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220020213,
					"content": "爸爸说，在船上，最值钱的东西是商人们运的货。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020214
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220020214,
					"content": "#唔，这样吧。{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，你帮我去找点值钱的东西回来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020215
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220020215,
					"content": "这样子，我就有能被抢走的东西啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020216
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220020216,
					"content": "我想想…那么，你就找点莲蓬回来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020217
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220020217,
					"content": "#我们三个人都很喜欢吃莲蓬，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}作为一个大坏蛋海盗，抢莲蓬最合适不过啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220020209,
					"content": "来抢你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020210
					]
				},
				{
					"id": 220020210,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，虽然是玩游戏，但是也要注意喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020211
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220020211,
					"content": "你看，旁边千岩军的叔叔们，都往这边看啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020212
					],
					"speakerTitle": "璐璐"
				}
			]
		},
