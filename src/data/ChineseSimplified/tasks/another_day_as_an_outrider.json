			"dialogs": [
				{
					"id": 4520101,
					"content": "#啊，派蒙和{NICKNAME}，找我有什么事情吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520102
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4520102,
					"content": "你好啊，安柏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520103,
						4520124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4520103,
					"content": "安柏，有件事情……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4520104
					]
				},
				{
					"id": 4520104,
					"content": "安柏，你认识奔狼领的男孩吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4520105,
					"content": "啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520106
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4520106,
					"content": "就是和你关系很好的那位啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4520107,
					"content": "你在说什么啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520108
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4520108,
					"content": "奇怪了，他说在老地方等你。难道你已经把他忘记了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4520109,
					"content": "小派蒙你才是，该不会吃错了蘑菇产生幻觉了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520110
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4520110,
					"content": "我完全不明白啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520111
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4520111,
					"content": "呃……不能吃的蘑菇是什么颜色的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4520112,
					"content": "紫色的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520113
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4520113,
					"content": "……好像前两天真的吃过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4520114,
					"content": "这不是重点！我现在没傻——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4520115,
					"content": "你不会真的不认识那个和狼群一起生活的男孩子吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4520116,
					"content": "你在说什么啊——不明白——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520117
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4520117,
					"content": "不过，说到狼。 我最近在调查一件事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520118
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4520118,
					"content": "本来只在「奔狼领」活动的狼群，最近胆子变大了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520119
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4520119,
					"content": "据说，袭击了「醉汉峡」附近的车队…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520120
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4520120,
					"content": "如果有空的话，来协助我调查一下，可以吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520121,
						4520122
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4520121,
					"content": "没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4520123
					]
				},
				{
					"id": 4520123,
					"content": "哼哼，真可靠。 那我们出发吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安柏"
				},
				{
					"id": 4520122,
					"content": "还是正事要紧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4520123
					]
				},
				{
					"id": 4520124,
					"content": "你好啊，最近怎么样？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4520125
					]
				},
				{
					"id": 4520125,
					"content": "啊，你看起来挺闲的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520126
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4520126,
					"content": "呃，一般说了这句话之后——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4520127,
					"content": "我最近很忙哦。毕竟侦察骑士责任重大嘛——你要来帮忙吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520129
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4520129,
					"content": "果然是这句话！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520130,
						4520131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4520130,
					"content": "没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4520132
					]
				},
				{
					"id": 4520132,
					"content": "最近狼群开始袭击「醉汉峡」沿线的车队了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520133
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4520133,
					"content": "你知道吧？狼群虽然很危险，但是有自己原则的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520134
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4520134,
					"content": "蒙德的狼基本不会离开明冠山和奔狼领。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520135
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4520135,
					"content": "嗯嗯，听说虽然那里生态很原始，但也是有独特规则的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520136
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4520136,
					"content": "没错。所以狼群跑到醉汉峡袭击人，这就很奇怪了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520137
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4520137,
					"content": "说到狼，安柏你认识奔狼领的男孩吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520138
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4520138,
					"content": "不认识啊，蒙德还有这样的人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520139
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4520139,
					"content": "欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520140
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4520140,
					"content": "「红色的，看起来很烫的女孩子」，难道不是安柏吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520141
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4520141,
					"content": "你在说什么啊？那是什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520142
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4520142,
					"content": "总之，我马上就要赶去醉汉峡调查了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520143
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4520143,
					"content": "你们也一起来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安柏"
				},
				{
					"id": 4520131,
					"content": "是什么事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4520132
					]
				}
			]
		},
