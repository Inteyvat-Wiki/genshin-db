				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4520301,
					"content": "谢，谢谢你们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520302
					],
					"speakerTitle": "齐格芙丽雅"
				},
				{
					"id": 4520302,
					"content": "小事一桩啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4520303,
					"content": "最近借着狼群的威风，丘丘人都嚣张跋扈了起来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520304
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4520304,
					"content": "是这样的。但是我觉得相比丘丘人，还是狼群更肆无忌惮一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520305
					],
					"speakerTitle": "齐格芙丽雅"
				},
				{
					"id": 4520305,
					"content": "它们…上午刚袭击了清泉镇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520306
					],
					"speakerTitle": "齐格芙丽雅"
				},
				{
					"id": 4520306,
					"content": "什么？袭击镇上？！这也太嚣张了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520307
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4520307,
					"content": "是啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520308
					],
					"speakerTitle": "齐格芙丽雅"
				},
				{
					"id": 4520308,
					"content": "我心想狼群闹够了，兴许可以上路，没想到就遇到了丘丘人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520309
					],
					"speakerTitle": "齐格芙丽雅"
				},
				{
					"id": 4520309,
					"content": "那我们现在赶过去，说不定还能看到残留的现场。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520310
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4520310,
					"content": "先走一步了！你就赶快检查一下损失吧。货车还能动吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520311
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4520311,
					"content": "啊，好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "齐格芙丽雅"
				}
			]
		},
