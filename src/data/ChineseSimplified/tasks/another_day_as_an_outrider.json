					"id": 4520201,
					"content": "前方有骚乱！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520202
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4520202,
					"content": "不是狼群，好像是丘丘人部落在袭击货车！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4520203,
					"content": "唔…这倒不是什么罕见的情况呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520204
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4520204,
					"content": "好啦，闲话少说，我们赶快去帮忙吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安柏"
				}
			]
		},
