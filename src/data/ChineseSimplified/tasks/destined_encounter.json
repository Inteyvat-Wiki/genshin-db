		},
		{
			"id": 800903,
			"completionStepIds": [
				800903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800903",
							"2"
						],
						"stepId": 800903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凯亚"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80090301,
					"content": "…老板，再来杯我没喝过的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090302
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 80090302,
					"content": "呃…先生，我这店里的酒，您早就喝遍了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090303
					],
					"speakerTitle": "艾依曼"
				},
				{
					"id": 80090303,
					"content": "是么，好吧好吧，今天就先这样吧，正好我一会儿还有事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090304
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 80090304,
					"content": "凯亚！你果然在这儿，我还担心你会不会耍我们呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80090305,
					"content": "#哟，派蒙，{NICKNAME}，看来神明还是眷顾我的嘛。我这么想见你们，怎么可能耍你们呢，哈哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090306,
						80090307
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 80090306,
					"content": "这句我就当是真的好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090308
					]
				},
				{
					"id": 80090308,
					"content": "话说你不是出差吗，天天下午泡在酒馆里，不怕回去被琴团长教训吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80090309,
					"content": "呵呵呵…我那么害怕琴团长，怎么敢做出令她不开心的事呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090310,
						80090311
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 80090310,
					"content": "我怎么没看出来。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090312
					]
				},
				{
					"id": 80090312,
					"content": "其实我这趟来须弥，就是来考察须弥酒业的。我泡在迪亚法饭店，做的可是正事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090313
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 80090313,
					"content": "人们都知道，须弥的香料很有名气，而在之前的传闻中，这里发明了一种加入香辛料的鸡尾酒，广受好评。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090314
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 80090314,
					"content": "所以骑士团派了我这个对酒品味最好的人来，尝尝是否有传闻中那样惊艳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090315
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 80090315,
					"content": "那么结果如何呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80090316,
					"content": "结果…我已经在跟奥摩斯港的几位香料商人谈合作的事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090317
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 80090317,
					"content": "唔，听起来是不错的商业机会，晨曦酒庄和迪卢克老爷没准也可以借机大赚一笔了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80090318,
					"content": "这个嘛…这笔买卖最终能不能落在晨曦酒庄的头上，还要看我的心情，哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090319
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 80090319,
					"content": "喂！公报私仇是不允许的呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80090320,
					"content": "凯亚以前来过须弥吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090321
					]
				},
				{
					"id": 80090321,
					"content": "哦？怎么突然问这种问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090322
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 80090322,
					"content": "看你独自来考察，可能很熟悉这里。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090323
					]
				},
				{
					"id": 80090323,
					"content": "真是敏锐啊。熟悉…倒还谈不上，只是在我很小的时候偷偷来过一次…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090324
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 80090324,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090325
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 80090325,
					"content": "嗯？然后呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090326
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80090326,
					"content": "唔…我还有必要讲下去吗？虽说是找你们来「叙旧」，但这只是我一个人的「旧事」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090327,
						80090328
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 80090327,
					"content": "没关系的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090329
					]
				},
				{
					"id": 80090329,
					"content": "好吧，既然你们有兴趣听…那时的我年纪还非常小，刚被晨曦酒庄收养不久。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090330
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 80090330,
					"content": "在一次义父的商业洽谈中，我偷听到了他们要派商队前往须弥的消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090331
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 80090331,
					"content": "你知道的，所有人都不可能不对自己血脉中的故乡感兴趣。而我的故乡…坎瑞亚，据说曾存在于须弥附近的地底深处。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090332
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 80090332,
					"content": "坎瑞亚…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090333
					]
				},
				{
					"id": 80090333,
					"content": "于是我偷偷潜伏进货物里，随商队一起来到了须弥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090334
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 80090334,
					"content": "不过很快，我失踪的消息便从酒庄传到了我在的商队，领头人将我搜出来以后，义父亲手把我揪了回去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090335
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 80090335,
					"content": "真是抱歉，不是什么惊心动魄的故事，呵呵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090336
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 80090336,
					"content": "说起来…你对坎瑞亚了解多少？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090337
					]
				},
				{
					"id": 80090337,
					"content": "实话实说，了解的并不多。就连坎瑞亚离须弥很近这样的情报，都是年幼的我自己查阅资料获知的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090338
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 80090338,
					"content": "不过随着年龄的增长，我的生活也跟坎瑞亚再没有了交集，渐渐地对坎瑞亚也没那么在意了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090339
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 80090339,
					"content": "曾经我总觉得，我或许是从亲生父亲那里继承了某种「责任」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090340
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 80090340,
					"content": "但后来又想，父亲之所以将我放在蒙德这样自由和平的城邦，可能真的只是希望我好好活下去而已…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090341
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 80090341,
					"content": "让我隔绝于「某些事物」之外，当然，如果能活得快乐就更好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090342
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 80090342,
					"content": "…这些都只是我的想法，总而言之，没法给你提供什么有效的情报了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090343
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 80090343,
					"content": "我现在能谈得上与坎瑞亚还有关联的东西，恐怕只有「亚尔伯里奇」这一个姓氏而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090344
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 80090344,
					"content": "…老板，一杯「午后之死」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090345
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80090345,
					"content": "…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090346
					]
				},
				{
					"id": 80090346,
					"content": "不知这位先生是否清楚…「亚尔伯里奇」意味着什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090347
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80090347,
					"content": "戴因…戴因斯雷布！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090348
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80090348,
					"content": "…终于不只是在一旁偷听，而是愿意赏光加入我们了么？我似乎在蒙德就见过你，戴因斯雷布…是么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090349
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 80090349,
					"content": "既然你对我有印象，那我们也算旧识了，凯亚·亚尔伯里奇先生…深渊教团创始者的后人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090350
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80090350,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090351
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 80090351,
					"content": "深渊教团…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090352
					]
				},
				{
					"id": 80090352,
					"content": "居然！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090353
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80090353,
					"content": "你之前应该不清楚这件事吧，凯亚先生，不然也不会这么坦然地公开提起这个姓氏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090354
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80090354,
					"content": "欸呀欸呀，这个姓氏原来这么「麻烦」，也算验证了我之前的猜想，这就是父亲把我留在蒙德的原因么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090355
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 80090355,
					"content": "没想到你这么容易就接受了，而且没有丝毫怀疑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090356
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80090356,
					"content": "可能这个说法刚好解释了我记忆中的一些疑问吧，而且…我认得出你的眼睛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090357
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 80090357,
					"content": "你是血统最纯正的坎瑞亚人，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090358
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 80090358,
					"content": "聪明的家伙，恕我直言，我只愿你保守本心，别违背了你刚才对旅行者说过的那些话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090359
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80090359,
					"content": "凯亚…你应该不会和深渊教团的人有什么牵连吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090360
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80090360,
					"content": "喂，我们的话题是不是突然间有些太过严肃了，我一个蒙德人可不习惯这种氛围…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090361
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 80090361,
					"content": "#知道了血脉的来源又怎么样？{NICKNAME}，我像是那种会被血脉这种事束缚住的人么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090362
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 80090362,
					"content": "放心好了，跟以前一样，但凡有机会，我都会很乐意教训那些深渊教团的家伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090363,
						80090364
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 80090363,
					"content": "我相信你，凯亚。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090365
					]
				},
				{
					"id": 80090365,
					"content": "我看时间也差不多了，我还约了个香料商人谈合作的事，你们先聊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090366
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 80090366,
					"content": "这样呀…那你去忙吧，凯亚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090367
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80090367,
					"content": "嗯，几位回头见。还有戴因斯雷布先生，下次来酒馆我可以请客，不用只是站在一旁听人聊天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090368
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 80090368,
					"content": "哼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090369
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80090369,
					"content": "你还是不相信凯亚吗，戴因…你们两个同为坎瑞亚人，但反而有些水火不容的样子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090370
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80090370,
					"content": "我对他这个人的确还不了解，妄下定论也没有意义。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090371
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80090371,
					"content": "血脉…真的能够对人毫无影响么，我只是对此持怀疑态度而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090372,
						80090373
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80090372,
					"content": "话说，亚尔伯里奇创立了深渊教团？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090374
					]
				},
				{
					"id": 80090374,
					"content": "#你的血亲被深渊教团称为{M#公主}{F#王子}，正是因为这是种「继承」关系吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090375
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80090375,
					"content": "唔，不然的话，就应该叫深渊教团的「王」了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090376
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80090376,
					"content": "你这次来须弥有什么打算？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090377
					]
				},
				{
					"id": 80090377,
					"content": "追查「命运的织机」。你还记得这个名字吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090378
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80090378,
					"content": "当然，就是在蒙德的时候，我们发现的深渊教团的计划！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090379
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80090379,
					"content": "有什么新的线索？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090380
					]
				},
				{
					"id": 80090380,
					"content": "不能说是新线索，只是…我一直无奈于记忆的磨损，而在之前的养伤期间，偶然回想起了些事情…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090381
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80090381,
					"content": "#当初和你的血亲一起旅行的时候，{M#她}{F#他}曾提起过这个词…「命运的织机」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090382,
						80090383
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80090382,
					"content": "那么早？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090384
					]
				},
				{
					"id": 80090384,
					"content": "嗯，记忆匹配上的时候，我也有些惊讶。印象里，正是当初我们一起旅行至须弥时候的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090385
					],
