					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80091124,
						80091125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80091124,
					"content": "瞧着吧，天理！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80091126
					]
				},
				{
					"id": 80091126,
					"content": "欸嘿，都怪我提了这些让你伤心的事，还是开心一点吧，你不开心的话…我也要难过了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80091127,
						80091128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80091127,
					"content": "没关系，派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80091129
					]
				},
				{
					"id": 80091129,
					"content": "好啦好啦，天色这么晚了，要不你先休息吧？今天晚上我来放哨，不会让魔物把你吃了的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80091130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80091130,
					"content": "真难得，居然不是你先睡。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80091131
					]
				},
				{
					"id": 80091131,
					"content": "哎呀，别这么说嘛…我偶尔也想照顾照顾你的心情啦，嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80091132,
						80091133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80091132,
					"content": "好吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80091134
					]
				},
				{
					"id": 80091134,
					"content": "晚安晚安！快睡吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80091133,
					"content": "那就晚安，派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80091134
					]
				},
				{
					"id": 80091128,
					"content": "谢谢你，派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80091129
					]
				},
				{
					"id": 80091125,
					"content": "瞧着吧，提瓦特！",
