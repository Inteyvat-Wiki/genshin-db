			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"马斯鲁尔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80090101,
					"content": "哦？你就是那位正在各个国家旅行的金发旅者吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090102
					],
					"speakerTitle": "马斯鲁尔"
				},
				{
					"id": 80090102,
					"content": "怎么啦？找我们有什么事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80090103,
					"content": "太好了，我正愁去哪里找你。正巧我手上有封你的信，是个外国人邮寄的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090104
					],
					"speakerTitle": "马斯鲁尔"
				},
				{
					"id": 80090104,
					"content": "那家伙钻了我们邮寄系统的空子，拿到了「信必送达」的承诺后，填了个极度模糊的地址。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090105
					],
					"speakerTitle": "马斯鲁尔"
				},
				{
					"id": 80090105,
					"content": "想给我们寄信还的确挺难的，毕竟我们一直四处晃荡，除非是我们自己去信箱里翻…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80090106,
					"content": "所以那个人填的地址究竟是哪里？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80090107,
					"content": "呃…他写的是「一只白发会说话的小精灵旁边」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090108
					],
					"speakerTitle": "马斯鲁尔"
				},
				{
					"id": 80090108,
					"content": "什么！是我吗！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80090109,
					"content": "唉，就是说啊，而且我们如果送不到信的话，按照条例还要赔给他钱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090110
					],
					"speakerTitle": "马斯鲁尔"
				},
				{
					"id": 80090110,
					"content": "可真是被那位先生给算计了，不过好在运气站在我这边，能跟你们这样偶遇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090111,
						80090112
					],
					"speakerTitle": "马斯鲁尔"
				},
				{
					"id": 80090111,
					"content": "那就把信给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090113
					]
				},
				{
					"id": 80090113,
					"content": "好好好，快请拿去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090114
					],
					"speakerTitle": "马斯鲁尔"
				},
				{
					"id": 80090114,
					"content": "让我也看看，到底是谁的来信呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80090115,
					"content": "凯亚！原来是他到须弥来了呀…唔，我就觉得「诡计多端的外国先生」很有可能是他呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090116,
						80090117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80090116,
					"content": "的确不是很意外。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090118
					]
				},
				{
					"id": 80090118,
					"content": "从信的内容来看，他也没怎么指望这封信可以寄到呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80090119,
					"content": "哦，倒不如说他的意思是，如果这封信真的寄到了，那就是命运的安排，我们就不好意思不去找他了，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090120,
						80090121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80090120,
					"content": "信里信外都是算计…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090122
					]
				},
				{
					"id": 80090122,
					"content": "好吧，见见老朋友总归是件令人开心的事呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80090123,
					"content": "信里说的是他每天下午会在迪亚法饭店，那我们就找个下午的时间过去吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80090121,
					"content": "也好，本来就想去见见他。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090122
					]
				},
				{
					"id": 80090117,
					"content": "应该说不愧是凯亚吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090118
					]
				},
				{
					"id": 80090112,
					"content": "给我看看信，我很好奇那个人是谁…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090113
					]
				}
			]
		},
