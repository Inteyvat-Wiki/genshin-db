			"dialogs": [
				{
					"id": 402170301,
					"content": "你好呀，安柏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402170302,
					"content": "啊，是荣誉骑士和派蒙，又见面啦！抱歉，刚才忙着说话，都没注意到你们来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170303,
						402170304
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 402170303,
					"content": "你好，安柏。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170305
					]
				},
				{
					"id": 402170305,
					"content": "我正和海因茨先生说比赛的事呢。对了，你们怎么到雪山来了，该不会还有委托要做吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170306
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 402170306,
					"content": "没有没有，我们收到了比赛的宣传单，有点好奇，就来看看啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170307,
						402170308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402170307,
					"content": "凑热闹我等不到明天。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170309
					]
				},
				{
					"id": 402170309,
					"content": "那你们可找对人了！正巧，我和海因茨先生都是大赛组委会的工作人员。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170310
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 402170310,
					"content": "你好，荣誉骑士，这位想必就是派蒙了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170311
					],
					"speakerTitle": "海因茨"
				},
				{
					"id": 402170311,
					"content": "我是骑士团第一小队的佐官海因茨，很荣幸见到你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170312
					],
					"speakerTitle": "海因茨"
				},
				{
					"id": 402170312,
					"content": "比赛还没有正式开始，现在正是发放观众票和嘉宾票的阶段。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170313
					],
					"speakerTitle": "海因茨"
				},
				{
					"id": 402170313,
					"content": "来，请两位收下，这是给你们预留的嘉宾票。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170314
					],
					"speakerTitle": "海因茨"
				},
				{
					"id": 402170314,
					"content": "谢谢你们。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170315
					]
				},
				{
					"id": 402170315,
					"content": "不客气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170317
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 402170317,
					"content": "我记得传单上提到过一个「龙脊雪山国际越野赛组委会」，安柏说的组委会就是它吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402170318,
					"content": "没错，这届组委会由西风骑士团成员和清泉镇镇民代表共同组成。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170319
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 402170319,
					"content": "具体来说，我和海因茨先生负责管理报名流程和赛场安全，清泉镇的各位负责裁判和后援管理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170320
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 402170320,
					"content": "要是遇到问题，尽管找我们！我们会保障所有参赛者和观众开心享受比赛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170321,
						402170322
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 402170321,
					"content": "安柏一如既往可靠。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170323
					]
				},
				{
					"id": 402170323,
					"content": "这届比赛的规模比以往都要大，来了不少外国选手，甚至还有纳塔人，肯定很精彩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170324
					],
					"speakerTitle": "海因茨"
				},
				{
					"id": 402170324,
					"content": "哦，我知道你想到谁了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170325
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 402170325,
					"content": "是那支队伍吧…其中一位成员的头发是粉色的，头上还有一对气派的白色大角。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170326
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 402170326,
					"content": "她的胃口尤其惊人呢！有位工作人员跟我说，他们特别喜欢和这位朋友同桌吃饭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170327
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 402170327,
					"content": "哈哈，她吃起饭来特别香，看得别人都想多添一碗饭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170328
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 402170328,
					"content": "还有一位成员身上有一条黄黑斑纹的尾巴，一看就很好摸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170329
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 402170329,
					"content": "不过她的样子酷酷的，我没好意思提这个要求。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170330
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 402170330,
					"content": "这个描述…我怎么觉得是认识的人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170331,
						402170332
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402170331,
					"content": "像瓦雷莎和希诺宁。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170333
					]
				},
				{
					"id": 402170333,
					"content": "噢噢，是熟人啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170334
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 402170334,
					"content": "要去找她们的话，那支队伍的营地在那里，就是那个画着特别图案的帐篷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170335
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 402170335,
					"content": "她们的营地挺漂亮的，还放了不少漫画书。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170336
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 402170336,
					"content": "看到了看到了，我们一会儿就去瞧瞧，谢啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170337
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402170337,
					"content": "对了，如果方便的话，能帮我向她们借一本漫画书吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170338
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 402170338,
					"content": "那支队伍里的选手总是在聊漫画，听得我特别好奇，但我有事要忙，又走不开。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170339
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 402170339,
					"content": "没问题，包在我们身上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402170332,
					"content": "我们去打个招呼吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170333
					]
				},
				{
					"id": 402170322,
					"content": "我们会来观赛的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170323
					]
				},
				{
					"id": 402170308,
					"content": "来看看有没有老朋友。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170309
					]
				},
				{
					"id": 402170304,
					"content": "在忙什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170305
					]
				}
			]
		},
