			},
			"dialogs": [
				{
					"id": 402170501,
					"content": "瓦雷莎，我们来看你们训练啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402170502,
					"content": "#欸，是派蒙的声音？派蒙——{NICKNAME}——好想你们呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170503
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402170503,
					"content": "和希诺宁一起解释了与众人相遇的前后经过。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402170504
					]
				},
				{
					"id": 402170504,
					"content": "啊哈哈！爱拉尼和义刚，怎么用了漫画里的台词来开场哇？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170505
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402170505,
					"content": "就是就是，连我都接不上话！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402170506,
					"content": "如果是我，开头应该会说「力量啊，爆开吧！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170507
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402170507,
					"content": "你这话也挺不好接的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170508
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 402170508,
					"content": "而且，其他人和你见面的时候，谁都还没来得及说话，就见到你把明妮举起来转了好几圈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170509
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 402170509,
					"content": "呜啊，现在想想怪不好意思的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170510
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402170510,
					"content": "毕竟这是我们第一次见面，之前只停留在互相写信、寄插画的环节。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170511
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402170511,
					"content": "这回认出明妮的时候，我一不小心就激动了，嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170512
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402170512,
					"content": "不过，既然你俩是一起来的，为什么刚才介绍大家的时候，希诺宁说的是「『炽魂斗士特战队』和我」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170513
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402170513,
					"content": "听着好像不是一队的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170514
					]
				},
				{
					"id": 402170514,
					"content": "因为我本来就不是这个兴趣小组的成员，妮佩卡才是，这一趟我也算是替她来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170515,
						402170516
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 402170515,
					"content": "妮佩卡？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170517
					]
				},
				{
					"id": 402170517,
					"content": "一切正常。能吃能睡，学习的进度也没落下，不仅迷上了看漫画书，甚至还认识了明妮这位笔友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170518
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 402170518,
					"content": "妮佩卡时不时地就来我耳朵旁边念叨，说明妮既能画画又会做漫画道具，还挺擅长开导人，是个很好很好的人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170519
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 402170519,
					"content": "听她的描述，我还一度怀疑过明妮的年龄。但这次过来一看，没想到明妮的年纪真的这么小。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170520
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 402170520,
					"content": "听说明妮提议大家参加「雪山越野赛」，妮佩卡也想来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170521
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 402170521,
					"content": "但…她也知道自己的身体状况，所以就拜托我替她参加，也向明妮问好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170522
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 402170522,
					"content": "欸嘿嘿，我之前就做好了旅行的准备，所以我和希诺宁就正好同行了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170523
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402170523,
					"content": "是啊，还莫名其妙给我冠了个副队长的名号…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170524
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 402170524,
					"content": "当，当然了！希诺宁的实力，绝对是队长级的！就是那种…队长级的副队长！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170525
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402170525,
					"content": "既然是有队长的实力，到底为什么还要做副队长？算了算了，我差点被你绕进去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170526
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 402170526,
					"content": "反正这次过来，我也主要是为了给妮佩卡买点《炽魂斗士战记》的…呃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170527
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 402170527,
					"content": "周边！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170528
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402170528,
					"content": "好吧，周边。大概就是一些徽章、画着角色的纸、漫画的复制稿、画着漫画角色的硬木板…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170529
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 402170529,
					"content": "瓦雷莎，你为什么用这种疑惑的表情看我，哪里错了么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170530
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 402170530,
					"content": "没错，完全没问题。只不过，听希诺宁这么一本正经地介绍周边，总感觉有点奇妙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170531
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402170531,
					"content": "全能大工匠希诺宁，抱着成箱成箱的周边回去的画面…哇啊，想不出来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170532
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402170532,
					"content": "这么多，都是妮佩卡要的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170533
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402170533,
					"content": "没有。以妮佩卡的性格，她并不会开口要什么礼物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170534
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 402170534,
					"content": "但以我对妮佩卡的了解，她收到这些…周边的时候，会很高兴的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170535
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 402170535,
					"content": "那是当然啦，能拿到这种礼物，妮佩卡肯定会特别开心的！嘿嘿，希诺宁这么懂妮佩卡，简直就是妮佩卡的姐姐呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170536
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402170536,
					"content": "这么说也没错，我们本来就是家人。至于了解…我和妮佩卡相处时间不长，算略微了解吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170537
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 402170537,
					"content": "呼啊…俯卧撑…瓦雷莎…我做完俯卧撑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170538
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402170538,
					"content": "好，那就是做完第四组了，嗯，稍微休息一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170539
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402170539,
					"content": "#明妮，我来给你介绍，这两位是我和希诺宁在纳塔认识的朋友：{NICKNAME}和派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170540
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402170540,
					"content": "金色头发…飞着的白色…简直就像…蒙德的荣誉骑士？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170541,
						402170542
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402170541,
					"content": "正是在下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170543
					]
				},
				{
					"id": 402170543,
					"content": "真的是本人！我哥哥在酒馆工作，经常带回来一些小道消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170544
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402170544,
					"content": "酒客们说，你们走到哪个国家名声就响到哪个国家。感觉就像漫画里画的那样，特别厉害。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170545
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402170545,
					"content": "我能问问你们印象最深的冒险经历吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170546
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402170546,
					"content": "你沉思片刻，看着身边的两位纳塔友人，你决定讲述一部分在纳塔所经历的事。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402170547
					]
				},
				{
					"id": 402170547,
					"content": "太震撼了，原来菲耶蒂娜生活过的国家真有那么奇妙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170548
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402170548,
					"content": "还有还有哦，我们「沃陆之邦」旁边还有一座大火山，时不时地就会往外喷出火球！虽然很危险，但特别适合英雄的试炼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170549
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402170549,
					"content": "瓦雷莎你知道的，我一直都很想离开蒙德去外面的世界看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170550
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402170550,
					"content": "可以的哦！我听说，蒙德人是很自由的，应该…去哪里都没事吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170551
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402170551,
					"content": "可是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170552
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402170552,
					"content": "如果要像荣誉骑士这样，一路坚持走下去，碰到什么危险都不退缩，得有很坚韧的内心才能做到吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170553
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402170553,
					"content": "#确实，很少有人像{NICKNAME}这么厉害…但我们也可以在自己的路上努力嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170554
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402170554,
					"content": "别忘了，保持韧性，坚定向前，这也是菲耶蒂娜的精神之一！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170555
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402170555,
					"content": "也对。嗯，我要加油！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170556
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402170556,
					"content": "而且为了和父母的约定，我也得努力练习，跑出成绩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170557
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402170557,
					"content": "约定？之前没有听你提起过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170558
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 402170558,
					"content": "啊…那个啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170559
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402170559,
					"content": "没事的，每次赛前，我也会和伊安珊老师约好，这次的表现一定要比上次更好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170560
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402170560,
					"content": "虽然不好说最后能发挥到什么程度，但有的时候，有一点压力才会有动力嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170561
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402170561,
					"content": "不过，也不能忘了要「玩得开心」喔！最开始，就是为了和大家一起高高兴兴地玩，才有了这次的雪山聚会！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170562
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402170562,
					"content": "我知道的！瓦雷莎姐姐，不过…怎么说也是比赛，嘿嘿，我还是想要拿个好成绩的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170563
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402170563,
					"content": "好！既然你那么想，我来陪你继续练习吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170564
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402170564,
					"content": "好的！瓦雷莎姐姐，我会跟上你的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170565
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402170565,
					"content": "行了。你们不是刚刚练习完么，瓦雷莎也许无所谓，但明妮还是先歇着吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170566
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 402170566,
					"content": "我还可…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170567
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402170567,
					"content": "咕噜噜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170568
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402170568,
					"content": "听这声响，是该吃饭的时候了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170569
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 402170569,
					"content": "对啊，要先吃好，才能练好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170570,
						402170571
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402170570,
					"content": "得合理膳食。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170572
					]
				},
				{
					"id": 402170572,
					"content": "没错，饮食也是训练里的重要环节！我把伊安珊老师的特别食谱分享给你，保证你明天精力满满！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170573
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402170573,
					"content": "真的？瓦雷莎姐姐知道蒙德有哪些菜适合训练后吃吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170574
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402170574,
					"content": "不太清楚欸，但吃东西这种事…相信肚子的直觉就好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170575
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402170575,
					"content": "先从兽肉旋风开始好了…然后吃薄荷酱烤鱼、塔塔可、夹心土豆泥、粒果肉汤还有苹果卷卷！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170576
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402170576,
					"content": "欸——这些全都要吃完吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170577
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402170577,
					"content": "嗯嗯，放开肚子，享受食物的美味，不知不觉就会吃完的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402170571,
					"content": "保持适量训练。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170572
					]
				},
				{
					"id": 402170542,
					"content": "你也认识我？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170543
					]
				},
				{
					"id": 402170516,
