			},
			"dialogs": [
				{
					"id": 402170401,
					"content": "你好，请问瓦雷莎和希诺宁在这里吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402170402,
					"content": "哦，是找队长和副队长的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170403
					],
					"speakerTitle": "汤义刚"
				},
				{
					"id": 402170403,
					"content": "#…{NICKNAME}？我还差点以为自己认错了，真的是你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170404,
						402170408
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 402170404,
					"content": "爱拉尼，你的论文怎么样了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170405
					]
				},
				{
					"id": 402170405,
					"content": "拜托你不要一见面就说这么残忍的话，现在是难得的假期时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170406
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 402170406,
					"content": "再怎么为论文头疼，我也是血肉做的人，是会被反复折磨人的现实打倒的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170407
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 402170407,
					"content": "我已经被论文打倒了，让我在地上躺一会儿再重新面对吧，在这里就不要提这事了，我求你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170412
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 402170412,
					"content": "哎呀，到处都是熟人，提瓦特真小。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402170413,
					"content": "既然大家都认识瓦雷莎和希诺宁，那就好解释了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402170414,
					"content": "我们听说她们来雪山这里比赛了，就来打招呼了，嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402170415,
					"content": "瓦雷莎和希诺宁现在不在，不介意的话，可以先在营地里等等看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170416
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 402170416,
					"content": "好啊，你们的帐篷很有特色呢…喔，这里果然有好多漫画。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170417,
						402170418
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402170417,
					"content": "安柏没说错。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170419
					]
				},
				{
					"id": 402170419,
					"content": "对了，有个朋友跟我们说，她听见你们聊漫画聊得热火朝天，觉得很有意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170420
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402170420,
					"content": "不知道你们在聊的是什么漫画，能告诉我们吗？我也有点好奇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170421
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402170421,
					"content": "漫画？原来你们也对漫画感兴趣吗？呵呵，果然。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170422
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 402170422,
					"content": "所谓「烈度」与「烈度」终会相互吸引，「最强」与「最强」定会相遇，就是这个意思吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170423
					],
					"speakerTitle": "汤义刚"
				},
				{
					"id": 402170423,
					"content": "那么，既然你诚心诚意地问了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170424
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 402170424,
					"content": "我汤义刚就大发慈悲地告诉你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170425
					],
					"speakerTitle": "汤义刚"
				},
				{
					"id": 402170425,
					"content": "这部漫画就是我们「炽魂斗士特战队」的圣典——《炽魂斗士战记》。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170426
					],
					"speakerTitle": "汤义刚"
				},
				{
					"id": 402170426,
					"content": "你接下来会问，炽魂斗士是一群什么人？「炽魂斗士特战队」又是一个什么样的组织？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170427,
						402170428
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 402170427,
					"content": "谁问了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170429
					]
				},
				{
					"id": 402170429,
					"content": "义刚，告诉我，炽魂斗士的原则是什么！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170430
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 402170430,
					"content": "「第一：认为用眼泪和劝诫足以维持和平的话，就太天真了！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170431
					],
					"speakerTitle": "汤义刚"
				},
				{
					"id": 402170431,
					"content": "「第二：就算耗尽了生命，永恒的黑暗也不会为我俯首，但我依然坚持战斗！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170432
					],
					"speakerTitle": "汤义刚"
				},
				{
					"id": 402170432,
					"content": "我们「特战队」誓死追随炽魂斗士，我们的宣言是——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170433
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 402170433,
					"content": "绝不畏惧失败与痛苦，永远守护爱与想象！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170434
					],
					"speakerTitle": "汤义刚"
				},
				{
					"id": 402170434,
					"content": "顺带一提，刚才说到的两条炽魂斗士原则，出自《炽魂斗士战记》第六册·暗域魔影篇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170435
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 402170435,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170436
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402170436,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170437
					]
				},
				{
					"id": 402170437,
					"content": "怎…怎么一点反应都没有？你们难道不觉得，自己内心深处的热情被点燃了那么一瞬？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170438
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 402170438,
					"content": "说实话，没有。你的解释有点抽象，我没听懂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170439
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402170439,
					"content": "这是何等的挫败。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170440
					],
					"speakerTitle": "汤义刚"
				},
				{
					"id": 402170440,
					"content": "别再点燃「热情」了，燃烧过头的话，你们一个个都要化成灰了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170441
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 402170441,
					"content": "太好了，副队长回来了。你听我说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170442
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 402170442,
					"content": "#好了，我看{NICKNAME}和派蒙的表情，就知道是什么情况了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170443,
						402170444
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 402170443,
					"content": "谁给我解释一下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170445
					]
				},
				{
					"id": 402170445,
					"content": "刚才爱拉尼和汤义刚，一定是对你说了一些…不太好理解的话，对吧？你就理解成是开玩笑吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170446
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 402170446,
					"content": "他们刚才所说的「台词」，都是出自一部由八重堂出版的长篇战斗漫画《炽魂斗士战记》。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170447
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 402170447,
					"content": "而那个「炽魂斗士特战队」，你可以简单理解为「漫画兴趣小组」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170448
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 402170448,
					"content": "哦…喔！这下清楚多了，那你们这个兴趣小组，为什么会在蒙德聚会呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170449
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402170449,
					"content": "我不知道。但他们肯定会用氛围啦，热血啦之类的话回答你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170450
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 402170450,
					"content": "斩钉截铁地说出来了呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170451
					]
				},
				{
					"id": 402170451,
					"content": "爱拉尼肯定也不知道，如果你问的话，他们肯定会用…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170452
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 402170452,
					"content": "我们是炽魂斗士嘛！蓬勃的青春热血，就要搭配最有挑战性的场地，才能绽放出光彩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170453
					],
					"speakerTitle": "汤义刚"
				},
				{
					"id": 402170453,
					"content": "…这样的话来回答你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170454
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 402170454,
					"content": "实际上，是他们的一位队员明妮推荐了这次聚会的举办场地，也提议了这次「雪山越野赛」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170455
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 402170455,
					"content": "在多方考虑之后，他们认为这个方案很不错，就按照明妮的建议继续推进了下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170456
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 402170456,
					"content": "所以最后，「炽魂斗士特战队」和我，就来到了这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170457,
						402170458
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 402170457,
					"content": "那我们能借漫画书吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170459
					]
				},
				{
					"id": 402170459,
					"content": "能的能的，我来之前想着说不定能遇到对漫画感兴趣的人，特意多带了几本。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170460
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 402170460,
					"content": "你的朋友是哪一位，在这附近吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170461
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 402170461,
					"content": "其实我们是替组委会的朋友安柏来借的，就是那个扎着红色蝴蝶结，性格很活泼的骑士，你们有印象吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170462
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402170462,
					"content": "噢，我记得她，她可热心了！那我直接把漫画拿去给她好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170463
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 402170463,
					"content": "我和你一起去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170464
					],
					"speakerTitle": "汤义刚"
				},
				{
					"id": 402170464,
					"content": "#那正好，就辛苦你们了。{NICKNAME}，你还想和瓦雷莎打招呼对吧？她正在训练场地那边呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170465
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 402170465,
					"content": "希诺宁不一起来吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170466
					]
				},
				{
					"id": 402170466,
					"content": "…我才想歇一会。行吧，既然你都说了，那就走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 402170458,
					"content": "我的朋友能来看漫画吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170459
					]
				},
				{
					"id": 402170444,
					"content": "（疑惑地挠头）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170445
					]
				},
				{
					"id": 402170428,
					"content": "不是，我没问。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170429
					]
				},
				{
					"id": 402170418,
					"content": "看来是漫画迷。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170419
					]
				},
				{
					"id": 402170408,
					"content": "我们见过吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170409
					]
				},
				{
					"id": 402170409,
					"content": "不记得我吗…倒也正常，经历过那么多大事，人的记性早晚会麻木。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170410
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 402170410,
					"content": "我是爱拉尼，教令院诃般荼…下面一点点的帝利耶悉哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170411
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 402170411,
					"content": "不过只要我完成了毕业论文，早晚能成为诃般荼的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170412
					],
					"speakerTitle": "爱拉尼"
				}
			]
		},
