			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"法尔博"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736910101,
					"content": "希望大家能够喜欢这个玩具啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736910102
					],
					"speakerTitle": "法尔博"
				},
				{
					"id": 736910102,
					"content": "这边有什么玩的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736910103
					]
				},
				{
					"id": 736910103,
					"content": "你是…旅行者对吧？我是梨多梵谛学院的学生法尔博。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736910104
					],
					"speakerTitle": "法尔博"
				},
				{
					"id": 736910104,
					"content": "呃…你知道我们学院是研究什么的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736910105
					],
					"speakerTitle": "法尔博"
				},
				{
					"id": 736910105,
					"content": "唔…我记得应该是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736910106
					]
				},
				{
					"id": 736910106,
					"content": "我们梨多梵谛学院专注于研究星象啦，当然，这么说不太准确，学院里还细分了很多研究领域…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736910107
					],
					"speakerTitle": "法尔博"
				},
				{
					"id": 736910107,
					"content": "但很遗憾的是，我们研究的很多东西就算拿出来说，一般人也不一定听得懂，或者是…有兴趣听。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736910108
					],
					"speakerTitle": "法尔博"
				},
				{
					"id": 736910108,
					"content": "如果直接摆出一个占星摊，我又怕负责摊位的各位同学会不由自主陷入学术讨论中，完全没心思管摊位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736910109
					],
					"speakerTitle": "法尔博"
				},
				{
					"id": 736910109,
					"content": "所以，在多方讨论之后，我们决定出了一个折中的方案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736910110
					],
					"speakerTitle": "法尔博"
				},
				{
					"id": 736910110,
					"content": "你看见这个特制星盘了吗？上面分布着很多星星，你所要做的，就是把这些星星拼成一个特定的图案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736910111
					],
					"speakerTitle": "法尔博"
				},
				{
					"id": 736910111,
					"content": "这些图案也不会特别复杂，更不会涉及某些尚未有结论的学术争端。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736910112
					],
					"speakerTitle": "法尔博"
				},
				{
					"id": 736910112,
					"content": "咳，总之就是…一个简单而快乐，不会引起学术争执的拼图游戏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736910113
					],
					"speakerTitle": "法尔博"
				},
				{
					"id": 736910113,
					"content": "你看起来好像挺紧张的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736910114
					]
				},
				{
					"id": 736910114,
					"content": "毕竟这个游戏和星星有关嘛…咱们学院的部分学生只要听见星星两个字就会十分紧张。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736910115
					],
					"speakerTitle": "法尔博"
				},
				{
					"id": 736910115,
					"content": "你是不知道，在设计这个玩具的时候，我和多少同学解释过这只是一个玩具，和学术研究一点关系都没有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736910116
					],
					"speakerTitle": "法尔博"
				},
				{
					"id": 736910116,
					"content": "不说了不说了，如果你有兴趣的话，就来试玩一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736910117,
						736910119
					],
					"speakerTitle": "法尔博"
				},
				{
					"id": 736910117,
					"content": "想要试玩看看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736910118
					]
				},
				{
					"id": 736910118,
					"content": "没问题，星盘就在这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "法尔博"
				},
				{
					"id": 736910119,
					"content": "还有别的事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736910120
					]
				},
				{
					"id": 736910120,
					"content": "唔，反正在学院游乐会期间，我会一直在这边开着摊位，你想玩的话直接过来就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "法尔博"
				}
			]
		}
	]
}