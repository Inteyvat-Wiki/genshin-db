			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"奥拉夫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110030201,
					"content": "好…好冷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030202
					],
					"speakerTitle": "奥拉夫"
				},
				{
					"id": 110030202,
					"content": "他的身子好冷！得赶快帮他暖暖才行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030203
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110030203,
					"content": "那在这里生火吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110030204,
					"content": "嗯，最好还能有一碗热汤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030205
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110030205,
					"content": "#{NICKNAME}，我在这里照顾他，能麻烦你去准备一份<color=#00E1FFFF>美味的热汤</color>吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030206
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110030206,
					"content": "我记得来的路上有个丘丘人营地，那里多半就有能做汤的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030207
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110030207,
					"content": "没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110030208
					]
				},
				{
					"id": 110030208,
					"content": "好的，准备好了就尽快回来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "香菱"
				}
			]
		},
		{
			"id": 1100304,
			"completionStepIds": [
				1100304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1100304",
							"2"
						],
						"stepId": 1100304,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_PACK_HAVE_ITEM",
						"rawParams": [
							"108021",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"奥拉夫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110030401,
					"content": "哈啊…哈啊…好多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030402
					],
					"speakerTitle": "奥拉夫"
				},
				{
					"id": 110030402,
					"content": "谢谢你们，这碗汤真好喝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030403
					],
					"speakerTitle": "奥拉夫"
				},
				{
					"id": 110030403,
					"content": "怎么会冻成这个样子？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110030404
					]
				},
				{
					"id": 110030404,
					"content": "我本来在追一只野猪，追了好远，它逃进了那边的地下遗迹里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030405
					],
					"speakerTitle": "奥拉夫"
				},
				{
					"id": 110030405,
					"content": "我追进去，却遇到了一棵好大好大的急冻树。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030406
					],
					"speakerTitle": "奥拉夫"
				},
				{
					"id": 110030406,
					"content": "我被冻僵了，清醒之后就跑了出来，但跑到这里身子就使不上劲了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030407
					],
					"speakerTitle": "奥拉夫"
				},
				{
					"id": 110030407,
					"content": "急冻树？一棵树，还会攻击人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030408
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110030408,
					"content": "是啊，我以前只是听别人说过，亲眼见到还是头一次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030409
					],
					"speakerTitle": "奥拉夫"
				},
				{
					"id": 110030409,
					"content": "听起来好危险…我们还是不要靠近那个遗迹吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110030410,
					"content": "说不定会很好吃！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030411,
						110030412
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110030411,
					"content": "…啊？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110030413
					]
				},
				{
					"id": 110030413,
					"content": "就是这个！一锤定音的食材，肯定会很好吃的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030414
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110030414,
					"content": "冷静啊，这么凶猛的植物真的能吃吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110030415,
					"content": "不试试看怎么知道，快，我们出发吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030416
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110030416,
					"content": "又跑掉了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030417,
						110030418
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110030417,
					"content": "我们要先走一步了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110030419
					]
				},
				{
					"id": 110030419,
					"content": "没事，不用管我，但一定要阻止她，很危险的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奥拉夫"
				},
				{
					"id": 110030418,
					"content": "你先回清泉镇吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110030419
					]
				},
				{
					"id": 110030412,
					"content": "这也能联想到吃的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110030413
					]
				}
			]
		},
