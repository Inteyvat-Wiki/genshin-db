	"talks": [
		{
			"id": 2502801,
			"completionStepIds": [
				2502801
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2502801",
							"2"
						],
						"stepId": 2502801,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"米卢·努伊"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250280101,
					"content": "完了，完了！我的流行大作…要被吃光了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280102
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250280102,
					"content": "早知道这样，我还不如让帕卡把它放在儿童歌曲区…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280103
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250280103,
					"content": "发生什么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250280104
					]
				},
				{
					"id": 250280104,
					"content": "#你是…等等，{NICKNAME}！太好了，你来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280105
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250280105,
					"content": "我有重要的事情要委托给你！纳塔的…不对，世界流行音乐的未来！就等着你去拯救了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280106,
						250280107
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250280106,
					"content": "你，你慢慢说！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250280109
					]
				},
				{
					"id": 250280109,
					"content": "请您快点去拯救我的唱片！不然他们就要被那群小鳍游龙吃掉…或者被那些不懂音乐的家伙毁掉了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250280107,
					"content": "欸？你怎么看出来我擅长唱歌的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250280108
					]
				},
				{
					"id": 250280108,
					"content": "呃…那个…我很高兴您有这种特长，之后我们也许可以合作…但现在…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280109
					],
					"speakerTitle": "米卢·努伊"
				}
			]
		},
		{
			"id": 2502802,
			"completionStepIds": [
				2502807
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2502807",
							"2"
						],
						"stepId": 2502807,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"2502802",
							"0"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"米卢·努伊",
					"利洛"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250280201,
					"content": "好，利洛老兄。咱们今天的目标就是那群家伙了，做好准备！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280202
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250280202,
					"content": "没问题，都准备好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280203,
						250280204
					],
					"speakerTitle": "利洛"
				},
				{
					"id": 250280203,
					"content": "又在忙着做唱片？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250280205
					]
				},
				{
					"id": 250280205,
					"content": "您好啊，居然能在这里见到您。没错，咱们正在为新的歌曲取材呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280206
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250280206,
					"content": "上次的事情之后，我和利洛老兄仔细谈了谈有关唱片的问题，收获了不少新的灵感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280207
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250280207,
					"content": "您说得太夸张了。我只是建议米卢·努伊先生换一个方法，或者是找其他素材来制作音乐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280208
					],
					"speakerTitle": "利洛"
				},
				{
					"id": 250280208,
					"content": "我之前在部族中所听到的音乐，有些甚至把武器的碰撞声、战斗的呐喊声、人奔跑的脚步声加进了歌曲之中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280209
					],
					"speakerTitle": "利洛"
				},
				{
					"id": 250280209,
					"content": "这样子做出的歌曲很受欢迎，传播的速度也很快…我想，也许这就是米卢·努伊先生想要的「流行感」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280210
					],
					"speakerTitle": "利洛"
				},
				{
					"id": 250280210,
					"content": "没错！所以我们一直在寻找战士，想要瞧瞧他们是如何战斗的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280211
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250280211,
					"content": "那你们找到取材对象了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250280212
					]
				},
				{
					"id": 250280212,
					"content": "找到了！就是前面那几位。我们在部族里打听到，这群人一直在外面寻找对手，实力也很强…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280213
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250280213,
					"content": "咳。简单来说，这群人成天在外面惹事，遇见人就上去问「要不要切磋」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280214
					],
					"speakerTitle": "利洛"
				},
				{
					"id": 250280214,
					"content": "只要输给了他们，还会被逼着拿出东西作为输掉的赌注。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280215
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250280215,
					"content": "我也有好几位音乐家朋友被他们劫掠…真是不可原谅！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280216
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250280216,
					"content": "没错，部族里的人也快受不了了。想要找人去教训一下他们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280217
					],
					"speakerTitle": "利洛"
				},
				{
					"id": 250280217,
					"content": "听着不像是什么正常人…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250280218
					]
				},
				{
					"id": 250280218,
					"content": "谁知道他们怎么想的？说真的，我从来都不理解这种人的想法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280219
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250280219,
					"content": "要是您愿意的话，就和利洛老兄一起去教训他们吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280220
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250280220,
					"content": "您的身手我早有见识。如果能看见您施展拳脚，我肯定能找到更多，更好的灵感！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280221
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250280221,
					"content": "但…我请您注意！如果那群家伙手里有唱片的话，您可千万别弄坏了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280222
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250280222,
					"content": "不然我那些音乐家朋友，一定会再晕过去一次…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280223,
						250280224
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250280223,
					"content": "没问题，你看好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250280225
					]
				},
				{
					"id": 250280225,
					"content": "好啊！哈哈哈，那就太好了，有您帮忙，我一定能做出最优秀的歌曲！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250280224,
					"content": "让你见识一下我的身手。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250280225
					]
				},
				{
					"id": 250280204,
					"content": "你们在取材吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250280205
					]
				}
			]
		},
		{
			"id": 2502803,
