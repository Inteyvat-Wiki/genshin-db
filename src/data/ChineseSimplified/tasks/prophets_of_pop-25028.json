					{
						"sceneId": 3,
						"position": [
							-3024.413,
							200.891,
							8663.825
						],
						"pointId": 9241
					}
				]
			},
			"dialogs": [
				{
					"id": 250280301,
					"content": "啊…箱子好像被打坏了…上面的唱片也…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 250280302,
					"content": "应该是那家伙把我们往那边引的。唉，他到底是从哪学的这一身毛病。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280303
					],
					"speakerTitle": "利洛"
				},
				{
					"id": 250280303,
					"content": "你们是被米卢·努伊先生拜托来取唱片的吧？我之前看见你们在和他谈话，能猜出你们的来意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280304
					],
					"speakerTitle": "利洛"
				},
				{
					"id": 250280304,
					"content": "我们都是「流泉之众」的人。那家伙…之前还算是好人，最近不知道从哪学来了一身坏毛病。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280305
					],
					"speakerTitle": "利洛"
				},
				{
					"id": 250280305,
					"content": "抱歉，忘了自我介绍。我是利洛，再次替我的…同伴，向您道歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280306
					],
					"speakerTitle": "利洛"
				},
				{
					"id": 250280306,
					"content": "…这谈话场面实在不太讲究。如果是在部族里的话，我至少能请您喝上一杯水。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280307,
						250280309
					],
					"speakerTitle": "利洛"
				},
				{
					"id": 250280307,
					"content": "作为冒险家。我已经习惯了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250280308
					]
				},
				{
					"id": 250280308,
					"content": "是吗？看您的模样，和刚才的身手，确实也像是一位经验丰富的冒险家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280313
					],
					"speakerTitle": "利洛"
				},
				{
					"id": 250280313,
					"content": "…咳。先不说这些，我们先收拾一下周围吧。我会把唱片碎片搜集好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280314
					],
					"speakerTitle": "利洛"
				},
				{
					"id": 250280314,
					"content": "我和你们一起去见米卢·努伊先生。必须要向他当面道歉才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "利洛"
				},
				{
					"id": 250280309,
					"content": "你曾经和璃月人一起工作？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250280310
					]
				},
				{
					"id": 250280310,
					"content": "是的。我曾经被一位璃月的先生雇佣，陪着他一起进山去探查矿脉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280311
					],
					"speakerTitle": "利洛"
				},
				{
					"id": 250280311,
					"content": "在和他一起工作的那段时间里，我受益良多。他在离开纳塔时，还送给我了一个璃月的名字，「逸扬」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280312
					],
					"speakerTitle": "利洛"
				},
				{
					"id": 250280312,
					"content": "据他说，这是代表着「在空中飘逸飞扬」的意思。呃…虽然我是不太明白…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280313
					],
					"speakerTitle": "利洛"
				}
			]
		},
