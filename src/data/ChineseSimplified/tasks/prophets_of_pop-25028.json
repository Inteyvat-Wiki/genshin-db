			"dialogs": [
				{
					"id": 250280501,
					"content": "我的唱片！太好了，这些唱片没有损坏…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280502
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250280502,
					"content": "非常抱歉。米卢·努伊先生，我的同伴抢走了您的唱片，我替他向您道歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280503
					],
					"speakerTitle": "利洛"
				},
				{
					"id": 250280503,
					"content": "唱片没事就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250280504
					]
				},
				{
					"id": 250280504,
					"content": "呼。你说得没错，这可是原型唱片，要是损坏的话，我非去跳崖不可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280505
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250280505,
					"content": "…这位叫利洛的老兄，你也别垂着头了。既然唱片没事，我也不会太计较这件事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280506
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250280506,
					"content": "你只需要回答我一个问题。今天的事，就可以一笔勾销。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280507
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250280507,
					"content": "请您说吧，我一定会尽力回答。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280508
					],
					"speakerTitle": "利洛"
				},
				{
					"id": 250280508,
					"content": "你们在听我的唱片时，觉得它好听吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280509
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250280509,
					"content": "不是那种会吸引孩子和龙宝宝们的「好听」，而是那种…有流行感的「好听」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280510
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250280510,
					"content": "你明白吗？在你们听这个唱片时，有这种感觉吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280511
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250280511,
					"content": "流行感？那个…您稍微等一会…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280512
					],
					"speakerTitle": "利洛"
				},
				{
					"id": 250280512,
					"content": "你们之所以派龙宝宝来抢走唱片，就是因为喜欢里面的流行感，对不对！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280513
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250280513,
					"content": "那个，您听我解释…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280514
					],
					"speakerTitle": "利洛"
				},
				{
					"id": 250280514,
					"content": "我们…从来没有「指使」过龙宝宝们去拿您的唱片…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280515
					],
					"speakerTitle": "利洛"
				},
				{
					"id": 250280515,
					"content": "是它们，被您唱片里的歌曲吸引，才自己跑了过去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280516
					],
					"speakerTitle": "利洛"
				},
				{
					"id": 250280516,
					"content": "什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280517
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250280517,
					"content": "您的歌曲非常优秀啊！相信我，每次我放您的唱片时，龙宝宝们都围着我们疯跑，开心的要命！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280518
					],
					"speakerTitle": "利洛"
				},
				{
					"id": 250280518,
					"content": "什么？可恶…我的唱片…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280519
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250280519,
					"content": "我明白您的心情。如此珍贵的唱片居然会遭到威胁…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280520
					],
					"speakerTitle": "利洛"
				},
				{
					"id": 250280520,
					"content": "但我愿意做您的无偿护卫，直到您做出一张新唱片为止！有我在，没人能再抢走您的唱片了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280521
					],
					"speakerTitle": "利洛"
				},
				{
					"id": 250280521,
					"content": "我的唱片！不是这种儿歌啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "米卢·努伊"
				}
			]
		},
