			"dialogs": [
				{
					"id": 250281301,
					"content": "好，利洛老兄。咱们今天的目标就是那群家伙了，做好准备！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250281302
					],
