						250280703,
						250280704
					],
					"speakerTitle": "利洛"
				},
				{
					"id": 250280703,
					"content": "至少不是孤本…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250280705
					]
				},
				{
					"id": 250280704,
					"content": "至少没有失传…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250280705
					]
				},
				{
					"id": 250280705,
					"content": "算了。都碎成这样…也没有办法再修复了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280706
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250280706,
					"content": "事到如今，我只想问你一个问题…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280707
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250280707,
					"content": "…你们在听我的唱片时，觉得它好听吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280708
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250280708,
					"content": "不是那种会吸引孩子和龙宝宝们的「好听」，而是那种…有流行感的「好听」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280709
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250280709,
					"content": "你明白吗？在你们听这个唱片时，有这种感觉吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280710
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250280710,
					"content": "流行感？那个…您稍微等一会…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280711
					],
					"speakerTitle": "利洛"
				},
				{
					"id": 250280711,
					"content": "你们之所以派龙宝宝来抢走唱片，就是因为喜欢里面的流行感，对不对！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280712
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250280712,
					"content": "那个，您听我解释…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280713
					],
					"speakerTitle": "利洛"
				},
				{
					"id": 250280713,
					"content": "我们…从来没有「指使」过龙宝宝们去拿您的唱片…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280714
					],
					"speakerTitle": "利洛"
				},
				{
					"id": 250280714,
					"content": "是它们，被您唱片里的歌曲吸引，才自己跑了过去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280715
					],
					"speakerTitle": "利洛"
				},
				{
					"id": 250280715,
					"content": "什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280716
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250280716,
					"content": "您的歌曲非常优秀啊！相信我，每次我放您的唱片时，龙宝宝们都围着我们疯跑，开心的要命！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280717
					],
					"speakerTitle": "利洛"
				},
				{
					"id": 250280717,
					"content": "什么？可恶…我的唱片…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280718
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250280718,
					"content": "我明白您的心情。这么优秀的唱片被毁，我很抱歉。但我愿意和您一起再次制作唱片！有我在，没人能再抢走您的唱片了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280719
					],
					"speakerTitle": "利洛"
				},
				{
					"id": 250280521,
					"content": "我的唱片！不是这种儿歌啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "米卢·努伊"
				}
			]
		},
		{
			"id": 2502808,
			"completionStepIds": [],
