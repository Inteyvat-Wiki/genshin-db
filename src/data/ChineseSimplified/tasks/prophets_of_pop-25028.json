			"dialogs": [
				{
					"id": 250280401,
					"content": "很好！二位战斗的英姿真是让人印象深刻！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280402
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250280402,
					"content": "不仅很有力，而且非常有节奏，简直就像是拿着指挥棒在指挥这场战斗啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280403
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250280403,
					"content": "最重要的是…唱片也非常完整！感谢您，我的那些朋友们总算能睡个好觉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280404
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250280404,
					"content": "咦，等等…节奏？没错，我要找的就是这种节奏感！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280405
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250280405,
					"content": "用这种节奏作为基础旋律…不对，要选用声音更沉的乐器…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280406
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250280406,
					"content": "这些东西给您，请您收下吧！利洛老兄，我们快回部族去，我有灵感了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280407
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250280407,
					"content": "见鬼，我得把那些节奏记下来…对了，衣服，我要把它们记在衣服上！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "米卢·努伊"
				}
			]
		},
