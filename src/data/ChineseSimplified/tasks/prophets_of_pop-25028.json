			"dialogs": [
				{
					"id": 250281201,
					"content": "很好！二位战斗的英姿真是让人印象深刻！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250281202
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250281202,
					"content": "不仅很有力，而且非常有节奏，简直就像是拿着指挥棒在指挥这场战斗啊！但是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250281203
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250281203,
					"content": "…那些碎成不知道多少片的唱片。实在是这场演奏中的，不和谐音符。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250281204
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250281204,
					"content": "愿大灵保佑我那些倒霉的朋友们…无论如何，我至少能把一部分唱片带回去给他们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250281205
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250281205,
					"content": "这些东西给您，请您收下吧！利洛老兄，我们回部族去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250281206
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250281206,
					"content": "希望我的好朋友们不会晕倒。唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "米卢·努伊"
				}
