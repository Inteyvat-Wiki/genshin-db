					"米卢·努伊"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250280801,
					"content": "您把我的唱片拿回来了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280802
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250280802,
					"content": "你的唱片为什么会被它们抢走？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250280803
					]
				},
				{
					"id": 250280803,
					"content": "这个，说来话长…我本来刚刚做出一首全新的歌曲。主题是歌颂春天和动物之类的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280804
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250280804,
					"content": "结果帕卡那小子听完之后，伸手就把我的歌又放到了儿童区！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280805
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250280805,
					"content": "还说什么，这种有趣又简洁的曲调，孩子们和龙宝宝们一定会喜欢的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280806
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250280806,
					"content": "可恶！我做的可是正经的流行乐，不是什么儿童歌曲！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280807
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250280807,
					"content": "我气不过，就带着唱片来这里，想要自己享受一下自己做的音乐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280808
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250280808,
					"content": "结果…听着听着，一群小鳍游龙就聚集了过来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280809
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250280809,
					"content": "还没等我反应过来，它们就一下子窜了过去，一口咬起唱片跑掉了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280810
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250280810,
					"content": "我本来想要追着它们过去。但追到一半，却发现有一群看起来很暴躁的人聚在一起…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280811
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250280811,
					"content": "说不定，就是这群家伙指使小鳍游龙抢走了我的唱片，他们一定在觊觎我的音乐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280812
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250280812,
					"content": "啊啊啊——不能再说了！冒险家，算我米卢·努伊求求你了，快去把我的唱片拿回来吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280813
					],
					"speakerTitle": "米卢·努伊"
				},
				{
					"id": 250280813,
					"content": "如，如果可以的话…还请您尽量让我的唱片保持完整。不然，我这些天的努力…全都白费了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "米卢·努伊"
				}
			]
		},
