					"speakerTitle": "贝拉特"
				},
				{
					"id": 738010902,
					"content": "那边的，什么人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010903
					],
					"speakerTitle": "贝拉特"
				},
				{
					"id": 738010903,
					"content": "尼卡…还有旅行者，你们怎么跑到这里来了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010904,
						738010905
					],
					"speakerTitle": "贝拉特"
				},
				{
					"id": 738010904,
					"content": "请照顾一下尼卡！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010906
					]
				},
				{
					"id": 738010906,
					"content": "我，我们在赶时间！尼卡就拜托你啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010907
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 738010907,
					"content": "哈？什么乱七八糟的，你给我等会！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "贝拉特"
				},
				{
					"id": 738010905,
					"content": "前面有人遇袭了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010906
					]
				}
