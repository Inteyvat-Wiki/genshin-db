			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"普热瓦"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 738010501,
					"content": "就是这里了。旅行者，计划很简单。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010502
					],
					"speakerTitle": "普热瓦"
				},
				{
					"id": 738010502,
					"content": "我们是两个…呵呵，不怀好意的愚人众，前来这片树林里做一些不怀好意的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010503
					],
					"speakerTitle": "普热瓦"
				},
				{
					"id": 738010503,
					"content": "而你，无论是出于义愤，还是出于维护正义的态度，出手试图制止我们行恶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010504
					],
					"speakerTitle": "普热瓦"
				},
				{
					"id": 738010504,
					"content": "在交手的过程中，我和亚历山德拉准备逃跑，但突然有一群魔物闯入，而我们也被那群魔物给打倒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010505
					],
					"speakerTitle": "普热瓦"
				},
				{
					"id": 738010505,
					"content": "而你因为魔物的数量太多，也只好撤退，等带人过来的时候，我和亚历山德拉也已经不见了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010506
					],
					"speakerTitle": "普热瓦"
				},
				{
					"id": 738010506,
					"content": "故事就是这样，你觉得怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010507,
						738010509
					],
					"speakerTitle": "普热瓦"
				},
				{
					"id": 738010507,
					"content": "你可真是熟练啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010508
					]
				},
				{
					"id": 738010508,
					"content": "为了把这个故事讲圆，同时让我们被打倒得更自然一点，我可是花了很大的功夫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010512
					],
					"speakerTitle": "普热瓦"
				},
				{
					"id": 738010512,
					"content": "不过，亚历山德拉怎么还没回来，就是布设一点魔物诱饵，至于用这么长时间吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010513
					],
					"speakerTitle": "普热瓦"
				},
				{
					"id": 738010513,
					"content": "亚历山德拉姐姐！亚历山德拉姐姐！呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010514
					],
					"speakerTitle": "尼卡"
				},
				{
					"id": 738010514,
					"content": "那，那边有人的声音！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010515
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 738010515,
					"content": "糟了，亚历山德拉出事了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010516
					],
					"speakerTitle": "普热瓦"
				},
				{
					"id": 738010516,
					"content": "喂！等等！你干什么去啊？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010517
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 738010517,
					"content": "快追上去！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010518
					]
				},
				{
					"id": 738010518,
					"content": "到底发生了什么事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 738010509,
					"content": "很像是愚人众会有的下场。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010510
					]
				},
				{
					"id": 738010510,
					"content": "没错，愚人众里在外做情报的「钉子」，一般都会落到这种下场。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010511
					],
					"speakerTitle": "普热瓦"
				},
				{
					"id": 738010511,
					"content": "我们正是不想就这么消失，才做的这次计划。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010512
					],
					"speakerTitle": "普热瓦"
				}
			]
		},
		{
			"id": 7380108,
