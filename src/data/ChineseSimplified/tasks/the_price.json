			},
			"dialogs": [
				{
					"id": 738010801,
					"content": "抱歉…咳咳…普热瓦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010802
					],
					"speakerTitle": "亚历山德拉"
				},
				{
					"id": 738010802,
					"content": "少说废话。我先给你包扎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010803
					],
					"speakerTitle": "普热瓦"
				},
				{
					"id": 738010803,
					"content": "呜呜…呜…对不起…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010804
					],
					"speakerTitle": "尼卡"
				},
				{
					"id": 738010804,
					"content": "你来这里做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010805
					]
				},
				{
					"id": 738010805,
					"content": "我…我是来这里摘蘑菇的…呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010806
					],
					"speakerTitle": "尼卡"
				},
				{
					"id": 738010806,
					"content": "因为亚历山德拉姐姐最近…最近好像很难过…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010807
					],
					"speakerTitle": "尼卡"
				},
				{
					"id": 738010807,
					"content": "所以我们就商量，要给亚历山德拉姐姐做好吃的，给她一个惊喜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010808
					],
					"speakerTitle": "尼卡"
				},
				{
					"id": 738010808,
					"content": "之前亚历山德拉姐姐带我们来这里，摘了很多好吃的蘑菇，我就想要自己过来摘一点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010809
					],
					"speakerTitle": "尼卡"
				},
				{
					"id": 738010809,
					"content": "但是，但是进了树林我就迷路了，然后就被好多蘑菇围住。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010810
					],
					"speakerTitle": "尼卡"
				},
				{
					"id": 738010810,
					"content": "亚历山德拉姐姐…亚历山德拉姐姐为了救我…呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010811
					],
					"speakerTitle": "尼卡"
				},
				{
					"id": 738010811,
					"content": "咳…没…没事的，尼卡…姐姐没事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010812
					],
					"speakerTitle": "亚历山德拉"
				},
				{
					"id": 738010812,
					"content": "…旅行者，看来计划要变更了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010813
					],
					"speakerTitle": "普热瓦"
				},
				{
					"id": 738010813,
					"content": "亚历山德拉伤势太重，我们擅自离城应该已经被其他的愚人众发现了，现在我带着负伤的她回去，只怕会被抓着盘查。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010814,
						738010815
					],
					"speakerTitle": "普热瓦"
				},
				{
					"id": 738010814,
					"content": "那你们的计划…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010816
					]
				},
				{
					"id": 738010816,
					"content": "呵呵…只能将计就计了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010817
					],
					"speakerTitle": "普热瓦"
				},
				{
					"id": 738010817,
					"content": "我刚才在过来的时候，看见有一支镀金旅团的队伍正在往这边走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010818
					],
					"speakerTitle": "普热瓦"
				},
				{
					"id": 738010818,
					"content": "旅行者，你把这个小鬼先送出树林，交给镀金旅团的人，我会带着亚历山德拉离开。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010819
					],
					"speakerTitle": "普热瓦"
				},
				{
					"id": 738010819,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010820
					],
					"speakerTitle": "普热瓦"
				},
				{
					"id": 738010820,
					"content": "还记得我们商量好的话术吗？看来这次我们得假戏真做了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010821
					],
					"speakerTitle": "普热瓦"
				},
				{
					"id": 738010821,
					"content": "镀金旅团的那个人一定会认为，我们这两个不怀好意的愚人众，是在这里进行某种不怀好意的计划，搭救尼卡只是一种掩饰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010822
					],
					"speakerTitle": "普热瓦"
				},
				{
					"id": 738010822,
					"content": "至于我们被魔物群起攻之…那就是我们罪有应得了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010823
					],
					"speakerTitle": "普热瓦"
				},
				{
					"id": 738010823,
					"content": "呜…亚历山德拉姐姐…我再也不淘气了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010824
					],
					"speakerTitle": "尼卡"
				},
				{
					"id": 738010824,
					"content": "…好在这小鬼头现在应该也没有心思听我们说的话，不用担心他了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010825,
						738010826
					],
					"speakerTitle": "普热瓦"
				},
				{
					"id": 738010825,
					"content": "但你们是为了救人…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010827
					]
				},
				{
					"id": 738010827,
					"content": "相信我，比起「愚人众英勇牺牲」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010828
					],
					"speakerTitle": "普热瓦"
				},
				{
					"id": 738010828,
					"content": "他们更容易接受「不怀好意的愚人众们自食其果」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010829
					],
					"speakerTitle": "普热瓦"
				},
				{
					"id": 738010829,
					"content": "还记得你初次偷听我和亚历山德拉讲话的地方吗？如果…我们成功逃脱了，我会留一封信在那里的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010830
					],
					"speakerTitle": "普热瓦"
				},
				{
					"id": 738010830,
					"content": "从一开始，你们就…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010831
					]
				},
				{
					"id": 738010831,
					"content": "我们只有这么一次机会，不得不谨慎一点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010832
					],
					"speakerTitle": "普热瓦"
				},
				{
					"id": 738010832,
					"content": "现在应该先救亚历山德拉！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010833
					]
				},
				{
					"id": 738010833,
					"content": "没关系的，旅行者…咳…我还撑得住。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010834
					],
					"speakerTitle": "亚历山德拉"
				},
				{
					"id": 738010834,
					"content": "…要是错过了这次机会，让我再回去做愚人众，我宁愿…咳…咳咳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010835
					],
					"speakerTitle": "亚历山德拉"
				},
				{
					"id": 738010835,
					"content": "亚历山德拉姐姐，你要去哪？我们一起回去吧！大家都在找你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010836
					],
					"speakerTitle": "尼卡"
				},
				{
					"id": 738010836,
					"content": "尼卡…听话，这位旅行者会带你出去…咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010837
					],
					"speakerTitle": "亚历山德拉"
				},
				{
					"id": 738010837,
					"content": "姐姐…要在这里休息一会，休息好了就会回去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010838
					],
					"speakerTitle": "亚历山德拉"
				},
				{
					"id": 738010838,
					"content": "可…可是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010839
					],
					"speakerTitle": "尼卡"
				},
				{
					"id": 738010839,
					"content": "姐姐什么时候骗过你？咳咳…听话，好吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010840
					],
					"speakerTitle": "亚历山德拉"
				},
				{
					"id": 738010840,
					"content": "呜…呜呜…好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010841
					],
					"speakerTitle": "尼卡"
				},
				{
					"id": 738010841,
					"content": "旅行者，就拜托你了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010842,
						738010843
					],
					"speakerTitle": "亚历山德拉"
				},
				{
					"id": 738010842,
					"content": "我马上回来。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010844
					]
				},
				{
					"id": 738010844,
					"content": "那就拜托你了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "普热瓦"
				},
				{
					"id": 738010843,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010844
					]
				},
				{
					"id": 738010826,
					"content": "但你们没有不怀好意…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010827
					]
				},
				{
					"id": 738010815,
					"content": "那你们怎么办？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010816
					]
				}
			]
		},
