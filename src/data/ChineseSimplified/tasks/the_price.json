			},
			"dialogs": [
				{
					"id": 738010101,
					"content": "…新生意谈好了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010102
					],
					"speakerTitle": "普热瓦"
				},
				{
					"id": 738010102,
					"content": "旧货船刚刚卸好了货，放心吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010103
					],
					"speakerTitle": "亚历山德拉"
				},
				{
					"id": 738010103,
					"content": "船没漏吧？<color=#00E1FFFF>上面的货…</color>都藏好了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010104
					],
					"speakerTitle": "普热瓦"
				},
				{
					"id": 738010104,
					"content": "都藏好了，藏得严严实实的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010105
					],
					"speakerTitle": "亚历山德拉"
				},
				{
					"id": 738010105,
					"content": "但是…换下来的老物件怎么办？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010106
					],
					"speakerTitle": "亚历山德拉"
				},
				{
					"id": 738010106,
					"content": "今天就作废掉。新货到了手…老物件就可以丢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010107
					],
					"speakerTitle": "普热瓦"
				},
				{
					"id": 738010107,
					"content": "真，真的没问题吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "亚历山德拉"
				}
			]
		},
