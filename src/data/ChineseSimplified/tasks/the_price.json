			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 738010201,
					"content": "喔！箱子打开了！意外地不算困难呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010202,
						738010203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 738010202,
					"content": "我来看看…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010204
					]
				},
				{
					"id": 738010204,
					"content": "唔唔唔，总之…先看看里面装着什么东西吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 738010205,
					"content": "这里面…看起来都是一些旧衣服，还有一摞信纸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 738010206,
					"content": "上面写着…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 738010207,
					"content": "「降诸魔山南，旧船离港。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 738010208,
					"content": "这都是什么呀？明明是在山里，怎么会有船呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010209,
						738010210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 738010209,
					"content": "也许是什么密语…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010211
					]
				},
				{
					"id": 738010211,
					"content": "唔…那我们也只能去看看了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 738010210,
					"content": "愚人众在谋划着什么。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010211
					]
				},
				{
					"id": 738010203,
					"content": "这箱子难道和那两个愚人众有关…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010204
					]
				}
			]
		},
		{
			"id": 7380103,
			"completionStepIds": [
				7380103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
