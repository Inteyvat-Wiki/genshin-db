			},
			"dialogs": [
				{
					"id": 738010401,
					"content": "呵呵，终于还是有人来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010402
					],
					"speakerTitle": "普热瓦"
				},
				{
					"id": 738010402,
					"content": "你发现我了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010403
					]
				},
				{
					"id": 738010403,
					"content": "你听的时间太久，一直没有动过位置。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010404
					],
					"speakerTitle": "普热瓦"
				},
				{
					"id": 738010404,
					"content": "刚才有一阵风吹过，你藏身的那丛灌木摆动的样子，明显和旁边的灌木不同。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010405
					],
					"speakerTitle": "普热瓦"
				},
				{
					"id": 738010405,
					"content": "不，不愧是愚人众…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 738010406,
					"content": "金发…还有旁边的奇异仙灵。看来你就是报告上提到的那位「旅行者」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010407,
						738010408
					],
					"speakerTitle": "普热瓦"
				},
				{
					"id": 738010407,
					"content": "没错，就是我。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010410
					]
				},
				{
					"id": 738010410,
					"content": "你既然来了这里，那就证明你已经看过了箱子里的东西了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010411
					],
					"speakerTitle": "普热瓦"
				},
				{
					"id": 738010411,
					"content": "真没想到，亚历山德拉的小机灵居然真能派上用场。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010412,
						738010413
					],
					"speakerTitle": "普热瓦"
				},
				{
					"id": 738010412,
					"content": "你们到底想做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010414
					]
				},
				{
					"id": 738010414,
					"content": "就和你听到的一样，我和亚历山德拉两个人，想要脱离愚人众。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010415
					],
					"speakerTitle": "普热瓦"
				},
				{
					"id": 738010415,
					"content": "别这么看着我，我们俩可不是大权在握的高层，也不是驻扎在前线的战斗人员。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010416
					],
					"speakerTitle": "普热瓦"
				},
				{
					"id": 738010416,
					"content": "充其量…只能算是被随便丢在一个地方等候调遣的「钉子」而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010417
					],
					"speakerTitle": "普热瓦"
				},
				{
					"id": 738010417,
					"content": "和我们一样身份的人有很多，但是…他们大部分都不会等到任何命令。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010418
					],
					"speakerTitle": "普热瓦"
				},
				{
					"id": 738010418,
					"content": "就这样抱着「愚人众」的身份，在人们的提防里度过余生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010419
					],
					"speakerTitle": "普热瓦"
				},
				{
					"id": 738010419,
					"content": "我们可不想这样。与其待在这里浪费生命，不如拼上一把，从此离开愚人众。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010420
					],
					"speakerTitle": "普热瓦"
				},
				{
					"id": 738010420,
					"content": "但愚人众可不是那么好脱离的，如果被人知道了这件事，我们一定…不会有什么好下场。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010421
					],
					"speakerTitle": "亚历山德拉"
				},
				{
					"id": 738010421,
					"content": "所以，我们就制订了一份「假死」的计划，希望能以此脱身。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010422
					],
					"speakerTitle": "亚历山德拉"
				},
				{
					"id": 738010422,
					"content": "但我们的「死亡」，需要一个说话足够有说服力的人来作证才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010423
					],
					"speakerTitle": "亚历山德拉"
				},
				{
					"id": 738010423,
					"content": "旅行者，你在愚人众里可以说是大名鼎鼎，而且…呵呵，你也和愚人众有很大的过节。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010424
					],
					"speakerTitle": "普热瓦"
				},
				{
					"id": 738010424,
					"content": "让你见证两个「愚人众」的死亡，实在是再适合不过了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010425,
						738010428
					],
					"speakerTitle": "普热瓦"
				},
				{
					"id": 738010425,
					"content": "你就这么确定我会来？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010426
					]
				},
				{
					"id": 738010426,
					"content": "我并不确定你会来，但我会等到你来为止。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010427
					],
					"speakerTitle": "普热瓦"
				},
				{
					"id": 738010427,
					"content": "耐心，是我为数不多的优点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010431
					],
					"speakerTitle": "普热瓦"
				},
				{
					"id": 738010431,
					"content": "旅行者，现在我们已经把事情都告诉你了，帮不帮忙，就由你来选择。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010432
					],
					"speakerTitle": "普热瓦"
				},
				{
					"id": 738010432,
					"content": "如果你愿意帮忙，我们也会给你一大笔报酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010433
					],
					"speakerTitle": "普热瓦"
				},
				{
					"id": 738010433,
					"content": "这些报酬是我和普热瓦去正经工作赚来的钱，你也不用有什么顾虑的，真的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010434
					],
					"speakerTitle": "亚历山德拉"
				},
				{
					"id": 738010434,
					"content": "我…我去给那些孩子们做晚饭，帮他们缝衣服，讲故事，领她们出去玩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010435
					],
					"speakerTitle": "亚历山德拉"
				},
				{
					"id": 738010435,
					"content": "普热瓦去帮人家打猎，还有处理猎物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010436
					],
					"speakerTitle": "亚历山德拉"
				},
				{
					"id": 738010436,
					"content": "我们离开愚人众之后，也准备用这些手艺来谋生呢！还有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010437
					],
					"speakerTitle": "亚历山德拉"
				},
				{
					"id": 738010437,
					"content": "亚历山德拉！少说几句！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010438
					],
					"speakerTitle": "普热瓦"
				},
				{
					"id": 738010438,
					"content": "喔…哦！好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010439
					],
					"speakerTitle": "亚历山德拉"
				},
				{
					"id": 738010439,
					"content": "总之，选择权在你，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010440,
						738010442
					],
					"speakerTitle": "普热瓦"
				},
				{
					"id": 738010440,
					"content": "我会帮忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010441
					]
				},
				{
					"id": 738010441,
					"content": "谢谢你，旅行者，你会拿到丰厚的报酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010447
					],
					"speakerTitle": "普热瓦"
				},
				{
					"id": 738010447,
					"content": "那我们就说定了，事不宜迟，我们现在就去分头准备。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010448
					],
					"speakerTitle": "普热瓦"
				},
				{
					"id": 738010448,
					"content": "亚历山德拉，那边就拜托你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010449
					],
					"speakerTitle": "普热瓦"
				},
				{
					"id": 738010449,
					"content": "旅行者，请你随我过来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "普热瓦"
				},
				{
					"id": 738010442,
					"content": "你们不怕我翻脸吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010443
					]
				},
				{
					"id": 738010443,
					"content": "那我们也会尽力抵抗，最后…不敌身亡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010444
					],
					"speakerTitle": "普热瓦"
				},
				{
					"id": 738010444,
					"content": "听上去差不多，对不对？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010445
					],
					"speakerTitle": "普热瓦"
				},
				{
					"id": 738010445,
					"content": "你们的报酬最好够多。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010446
					]
				},
				{
					"id": 738010446,
					"content": "放心吧，绝对是一个足够丰厚的数额。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010447
					],
					"speakerTitle": "普热瓦"
				},
				{
					"id": 738010428,
					"content": "如果今天不是我来…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010429
					]
				},
				{
					"id": 738010429,
					"content": "那我们就会回去。直到你来为止，计划才会继续推进。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010430
					],
					"speakerTitle": "普热瓦"
				},
				{
					"id": 738010430,
					"content": "我们已经筹备了很久，不差这么一点时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010431
					],
					"speakerTitle": "普热瓦"
				},
				{
					"id": 738010413,
					"content": "刚才那些话，也是说给我听的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010414
					]
				},
				{
					"id": 738010408,
					"content": "你们是设下陷阱等我吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010409
					]
				},
				{
					"id": 738010409,
					"content": "放心吧，我们可没有那个时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010410
					],
					"speakerTitle": "普热瓦"
				}
			]
		},
		{
			"id": 7380105,
			"completionStepIds": [
				7380105
			],
