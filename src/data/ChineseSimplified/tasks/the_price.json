			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 738010301,
					"content": "降诸魔山的南方…这范围也太远了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 738010302,
					"content": "这里视野不错，我们就在这里先等等，看会不会有人过来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 738010303,
					"content": "和派蒙在此等待…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						738010304
					]
				},
				{
					"id": 738010304,
					"content": "看，那边有人来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 738010305,
					"content": "怎么来得这么晚，是遇见什么麻烦了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010306
					],
					"speakerTitle": "普热瓦"
				},
				{
					"id": 738010306,
					"content": "…抱歉，箱子好像被人翻过了，我们的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010307
					],
					"speakerTitle": "亚历山德拉"
				},
				{
					"id": 738010307,
					"content": "啧，难道是被发现了？不对…最近上面也没来过人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010308
					],
					"speakerTitle": "普热瓦"
				},
				{
					"id": 738010308,
					"content": "也许…也许是尼卡翻的呢？那群孩子最近总是过来央求我带他们出去玩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010309
					],
					"speakerTitle": "亚历山德拉"
				},
				{
					"id": 738010309,
					"content": "唉…所以我说，除了必要的交际之外，不要和那些居民走太近。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010310
					],
					"speakerTitle": "普热瓦"
				},
				{
					"id": 738010310,
					"content": "可是，他们的父母总是不在家，我实在是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010311
					],
					"speakerTitle": "亚历山德拉"
				},
				{
					"id": 738010311,
					"content": "算了，先不管这些，无论如何，今天我们都要离开这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010312
					],
					"speakerTitle": "普热瓦"
				},
				{
					"id": 738010312,
					"content": "离开？他们的意思是…要离开须弥吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 738010313,
					"content": "我们没有帮手，那个计划…真的会成功吗？要是被上面的人知道了的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010314
					],
					"speakerTitle": "亚历山德拉"
				},
				{
					"id": 738010314,
					"content": "管不了那么多了…你是还没有受够吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010315
					],
					"speakerTitle": "普热瓦"
				},
				{
					"id": 738010315,
					"content": "天天提心吊胆，时时刻刻都被人提防…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010316
					],
					"speakerTitle": "普热瓦"
				},
				{
					"id": 738010316,
					"content": "想要从愚人众里脱身，今天就是最后的机会！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010317
					],
					"speakerTitle": "普热瓦"
				},
				{
					"id": 738010317,
					"content": "我，我知道，但是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010318
					],
					"speakerTitle": "亚历山德拉"
				},
				{
					"id": 738010318,
					"content": "这两个人…想要脱离愚人众？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 738010319,
					"content": "出去看看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010320
					]
				},
				{
					"id": 738010320,
					"content": "嗯，不过还是要小心，他们可是愚人众啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
