			"dialogs": [
				{
					"id": 738011001,
					"content": "亚历山德拉应该就在这附近啊，他们…他们去哪了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738011002,
						738011003
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 738011002,
					"content": "亚历山德拉！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738011004
					]
				},
				{
					"id": 738011004,
					"content": "你们在哪呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738011005
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 738011005,
					"content": "别叫了，再叫就把魔物引来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738011006
					],
					"speakerTitle": "贝拉特"
				},
				{
					"id": 738011006,
					"content": "我都听尼卡说了，真没想到，亚历山德拉和普热瓦居然是愚人众。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738011007
					],
					"speakerTitle": "贝拉特"
				},
				{
					"id": 738011007,
					"content": "平时我和他们打交道的时候，还觉得他们是好人呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738011008
					],
					"speakerTitle": "贝拉特"
				},
				{
					"id": 738011008,
					"content": "亚历山德拉姐姐就是好人！普热瓦哥哥很凶…但也是好人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738011009
					],
					"speakerTitle": "尼卡"
				},
				{
					"id": 738011009,
					"content": "哎呀，但他们可是愚人众啊，谁知道是不是装成一副好人样，背地里打什么鬼主意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738011010
					],
					"speakerTitle": "贝拉特"
				},
				{
					"id": 738011010,
					"content": "愚人众的那些著名「事迹」，我可是听了不少啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738011011
					],
					"speakerTitle": "贝拉特"
				},
				{
					"id": 738011011,
					"content": "说不定，他们就是在这里盘算着什么阴谋，搭救尼卡只不过是一种掩护呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738011012,
						738011013
					],
					"speakerTitle": "贝拉特"
				},
				{
					"id": 738011012,
					"content": "他们…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738011014
					]
				},
				{
					"id": 738011014,
					"content": "那可不好说。不过，现在也找不到这两个人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738011015
					],
					"speakerTitle": "贝拉特"
				},
				{
					"id": 738011015,
					"content": "他们还带着一个伤员…以我的经验，大概已经被魔物给…呃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738011016
					],
					"speakerTitle": "贝拉特"
				},
				{
					"id": 738011016,
					"content": "贝拉特哥哥！求求你了，再找找吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738011017
					],
					"speakerTitle": "尼卡"
				},
				{
					"id": 738011017,
					"content": "尼卡，如果我不是一个人过来，我保证会带着人搜遍森林。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738011018
					],
					"speakerTitle": "贝拉特"
				},
				{
					"id": 738011018,
					"content": "但现在我只有一个人啊，先不说魔物，如果有其他的愚人众…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738011019
					],
					"speakerTitle": "贝拉特"
				},
				{
					"id": 738011019,
					"content": "咳，总之…旅行者，我们先回去城里吧，我会向团长报告这件事，等他做出判断后，我会根据命令行事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738011020
					],
					"speakerTitle": "贝拉特"
				},
				{
					"id": 738011020,
					"content": "贝拉特带着尼卡离开了…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						738011021
					]
				},
				{
					"id": 738011021,
					"content": "他的反应和普热瓦说的一模一样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738011022
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 738011022,
					"content": "但他们…真的成功离开了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738011023
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 738011023,
					"content": "没办法，我们也回去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738011024
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 738011024,
					"content": "普热瓦说，如果他们成功离开了，就会在他们原来在的位置留下一封信。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738011025
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 738011025,
					"content": "有时间的话，我们就过去看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 738011013,
					"content": "他们…不是坏人…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738011014
					]
				},
