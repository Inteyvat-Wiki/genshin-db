	"talks": [
		{
			"id": 1502201,
			"completionStepIds": [
				1502201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1502201",
							"2"
						],
						"stepId": 1502201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"希诺宁"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-1350.876,
							161.634,
							7851.647
						],
						"pointId": 350400213
					}
				]
			},
			"dialogs": [
				{
					"id": 150220101,
					"content": "按阿尔帕之前说的…特帕尔就是从回声之子来的吧？要怎么找到他呢？挨个找人问吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150220102,
					"content": "直接找回声之子里的熟人帮忙会快些。在这个时间这个地点，最容易找到的人选是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220103
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150220103,
					"content": "——希诺宁，该起床了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220104
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150220104,
					"content": "哈…是你们啊…唔…你们等等…我先从树上下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220105
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150220105,
					"content": "啊…呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220106
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150220106,
					"content": "你俩都很喜欢待在树上呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220107
					]
				},
				{
					"id": 150220107,
					"content": "我上树是为了飞得更久看得更远，一般不会在树上休息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220108
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150220108,
					"content": "不是每个人都跟你一样，到处折腾一整天都不嫌累的…所以，这次是为什么事，来打扰我宝贵的休息时间？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220109
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150220109,
					"content": "抱歉了，希诺宁，但这件事很紧急——你认识一位名叫特帕尔的工匠吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220110
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150220110,
					"content": "特帕尔？好像有点印象…应该是普玛家的孩子吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220111
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150220111,
					"content": "那他现在就在回声之子吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220112
					]
				},
				{
					"id": 150220112,
					"content": "不，起码好几年前就不在了…说起来，你们又为什么要找他？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220113
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150220113,
					"content": "说来话长…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220114
					]
				},
				{
					"id": 150220114,
					"content": "你们尽量简明扼要地说明了事情的经过…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150220115
					]
				},
				{
					"id": 150220115,
					"content": "「燃素翼」？特帕尔这小子，居然真能鼓捣出这么不得了的东西…看来今天的休息时间是要没了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220116
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150220116,
					"content": "「真能」？难道他以前就研究过类似的东西？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150220117,
					"content": "是，差不多就是从花羽会回来之后，他开始研究用人造物飞向天空的方法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220118
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150220118,
					"content": "是在成为「失翼者」之后…人造物…就跟你帮我造的那把枪一样吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220119
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150220119,
					"content": "你的那把「枪」可比最高傲的绒翼龙还要难驯服——而他想要的，是让没有天赋的普通人也能自由飞行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220120
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150220120,
					"content": "不过他那时候总是失败，炸过好几回工坊，连自己的小命都差点丢了。至于后面的事，我没太关注过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220121
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150220121,
					"content": "特帕尔的父母早年曾在外游历，后来有了特帕尔才回到部族，但也选在了偏僻处定居，不怎么与人交流。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220122
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150220122,
					"content": "部族里的人跟他们都不算很熟…要了解特帕尔的详细情况，还是去找他的家里人比较好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220123
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150220123,
					"content": "我现在去把普玛约出来，你们就先在我的工坊前面等一会吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "希诺宁"
				}
			]
		},
		{
			"id": 1502202,
			"completionStepIds": [
				1502202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1502202",
							"2"
						],
						"stepId": 1502202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"普玛",
					"希诺宁"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-1374.526,
							169.17,
							7678.847
						],
						"pointId": 350400214
					}
				]
			},
			"dialogs": [
				{
					"id": 150220201,
					"content": "在希诺宁的工坊前稍等了一会…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150220202
					]
				},
				{
					"id": 150220202,
					"content": "久等了，这位就是特帕尔的母亲，普玛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220203
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150220203,
					"content": "您好，我们是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150220204,
					"content": "寒暄的话就免了吧，我不想多谈那个人的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220205
					],
					"speakerTitle": "普玛"
				},
				{
					"id": 150220205,
					"content": "欸…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150220206,
					"content": "他早就已经跟我们没关系了…我可没有那样的孩子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220207
					],
					"speakerTitle": "普玛"
				},
				{
					"id": 150220207,
					"content": "他心里就只有飞上天去的白日梦…不管我们怎么劝都执迷不悟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220208
					],
					"speakerTitle": "普玛"
				},
				{
					"id": 150220208,
					"content": "哼…最后一走了之的时候，还说什么要在天上造工坊，省得被地上的人指指点点…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220209
					],
					"speakerTitle": "普玛"
				},
				{
					"id": 150220209,
					"content": "这是他留下没带走的手记，你们有什么问题，就自己翻吧。我不想再多说了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220210
					],
					"speakerTitle": "普玛"
				},
				{
					"id": 150220210,
					"content": "我从来就没有过这个儿子…反正他也从没认过我这个妈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220211
					],
					"speakerTitle": "普玛"
				},
				{
					"id": 150220211,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220212
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150220212,
					"content": "没…没想到他们的关系会这么差啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150220213,
					"content": "她的丈夫…特帕尔的父亲不久前刚刚去世。但就算是在父亲的葬礼上，特帕尔也没有回来露面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220214
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150220214,
					"content": "或许就是因为这样，普玛才会对特帕尔彻底死心吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220215
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150220215,
					"content": "我先去安抚她了，有事回头再聊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220216
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150220216,
					"content": "麻烦你们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220217
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150220217,
					"content": "那现在的线索…就只剩下这本手记了？上面都写了什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150220218,
					"content": "嗯…「燃素翼」的早期构思…还有…「空中工坊」的设想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220219
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150220219,
					"content": "「烬城」奥奇卡纳塔…看来「燃素翼」的技术原型，就是从那来的了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220220
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150220220,
					"content": "他居然真想造出一个飞在天上的工坊？光凭他一个人…真的做得到吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220221,
						150220222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150220221,
					"content": "话说图纸上的气球…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220223
					]
				},
				{
					"id": 150220223,
					"content": "——啊！是试炼场地上面的那个！飞得特别高的气球！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150220224,
					"content": "那个气球出现有一段时间了，谁都不知道是怎么飞上去的…但如果它不是被谁放「上去」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220225
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150220225,
					"content": "而是因为什么故障，从更高的云层之上…「降落」到现在的高度呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220226
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150220226,
					"content": "难道说它是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220227
					]
				},
				{
					"id": 150220227,
					"content": "——空中工坊的一部分？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220228
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150220228,
					"content": "很有可能。难怪连伊西多尔都不知道特帕尔的据点在哪里…原来是藏在了云层之上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220229
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150220229,
					"content": "居然还真是藏在天上…那我们要怎么上去呢？恰斯卡你…能飞那么高吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220230
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150220230,
					"content": "#很有难度，要是再带{NICKNAME}上去，就更不可能了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220231
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150220231,
					"content": "就算用了「燃素翼」应该也飞不了那么高…除非是用上手记里说的「遗物」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220232
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150220232,
					"content": "「遗物」应该还在特帕尔手里…估计是指望不上了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220233
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150220233,
					"content": "派蒙能飞那么高吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220234
					]
				},
				{
					"id": 150220234,
					"content": "飞不了！怎么想都飞不了吧！再说了你就忍心让我一个人上去打特帕尔吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220235
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150220235,
					"content": "放心吧，我们没想出办法，不代表别人也想不出。花羽会里的「飞行高手」可不只有我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220236
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150220236,
					"content": "欸…对哦！还能去找阿尔帕长老呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220237
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150220237,
					"content": "穆托塔当年也是飞行队的一把好手，回花羽会去咨询一下他们的建议吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150220222,
					"content": "好像在哪里见过？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220223
					]
				}
			]
		},
