			"dialogs": [
				{
					"id": 150220301,
					"content": "恰斯卡，你们可算回来了，部族里的氛围越来越严峻了，调查有什么进展吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220302
					],
					"speakerTitle": "穆托塔"
				},
				{
					"id": 150220302,
					"content": "还有人怀疑我们控制住商队的人，是不是偏袒飞行队，想要打压「燃素翼」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220303,
						150220304
					],
					"speakerTitle": "阿尔帕"
				},
				{
					"id": 150220303,
					"content": "控制住了商队矛盾却还在扩大…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220305
					]
				},
				{
					"id": 150220305,
					"content": "我们已经找到了一些线索。但要找到确凿的证据，还有一道难关…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220306
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150220306,
					"content": "恰斯卡说明了特帕尔的情况与空中工坊的猜想…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150220307
					]
				},
				{
					"id": 150220307,
					"content": "来自烬城的「遗物」？过去这么多年，奥奇坎的遗毒居然还在激起矛盾…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220308
					],
					"speakerTitle": "穆托塔"
				},
				{
					"id": 150220308,
					"content": "空中工坊…试炼场地上空的热气球…这就是你们接下来的目的地吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220309
					],
					"speakerTitle": "阿尔帕"
				},
				{
					"id": 150220309,
					"content": "有办法上去吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220310
					]
				},
				{
					"id": 150220310,
					"content": "不管是靠绒翼龙还是用「燃素翼」都飞不了那么高…特帕尔真的会在那儿吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220311
					],
					"speakerTitle": "阿尔帕"
				},
				{
					"id": 150220311,
					"content": "唔…方法…倒也不是没有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220312
					],
					"speakerTitle": "穆托塔"
				},
				{
					"id": 150220312,
					"content": "——还真有啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150220313,
					"content": "你们还记得试炼场地内的那些喷口吗？之前的地脉异常跟阻塞，导致了气态燃素匮乏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220314
					],
					"speakerTitle": "穆托塔"
				},
				{
					"id": 150220314,
					"content": "但如果在气态燃素充盈的现在，反过来重新堵住它们的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220315
					],
					"speakerTitle": "穆托塔"
				},
				{
					"id": 150220315,
					"content": "你的意思…是只留下最高处的喷口，把所有压力都集中到那里？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220316
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150220316,
					"content": "这么一来，聚集的气态燃素就会在最高处形成极强的风压…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220317
					],
					"speakerTitle": "穆托塔"
				},
				{
					"id": 150220317,
					"content": "——然后我们就能乘着风飞上去了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150220318,
					"content": "嗯，虽然会有些冒险，但以恰斯卡的技术，应该不成问题？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220319
					],
					"speakerTitle": "穆托塔"
				},
				{
					"id": 150220319,
					"content": "真是有够冒险的…但确实有可行性。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220320
					],
					"speakerTitle": "阿尔帕"
				},
				{
					"id": 150220320,
					"content": "封堵喷口的技术细节，可以去试炼场地找因卡纳克问问。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220321
					],
					"speakerTitle": "穆托塔"
				},
				{
					"id": 150220321,
					"content": "恰斯卡…能不能抓住飞在天上的证据，就看你们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "穆托塔"
				},
				{
					"id": 150220304,
					"content": "难道不只有商队的人在作乱…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220305
					]
				}
			]
