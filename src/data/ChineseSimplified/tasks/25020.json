			"dialogs": [
				{
					"id": 250201001,
					"content": "就是这个，多谢你了，我这就…嘶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250201002
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250201002,
					"content": "抱歉，我…我刚才在捆骨架的时候，不小心把手指弄破了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250201003
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250201003,
					"content": "这种精细活对我来说，果然还是太难了啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250201004
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250201004,
					"content": "稍等啊，我把这些烬芯花的花茎捆在骨架上，然后蒙一层布…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250201005
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250201005,
					"content": "卡兹加和「漂流球」继续搏斗了起来…当他的手上又添了三道新伤口后，「漂流球」总算是做好了…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						250201006
					]
				},
				{
					"id": 250201006,
					"content": "好了！我们这就去找霍莱吧，它肯定又在那棵树下面挖土了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250201007
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250201007,
					"content": "先包扎一下手吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250201008
					]
				},
				{
					"id": 250201008,
					"content": "喔，不用担心这个，都是小伤口，之后我随便拿个布条包一包就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250201009
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250201009,
					"content": "我们还是先去找霍莱吧，别让这小子玩太疯了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡兹加"
				}
			]
