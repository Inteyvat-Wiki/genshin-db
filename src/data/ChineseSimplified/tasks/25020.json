					}
				]
			},
			"dialogs": [
				{
					"id": 250200101,
					"content": "霍莱！听话，别动！就是稍微擦洗一下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200102
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250200102,
					"content": "呜呜，呜呜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200103
					],
					"speakerTitle": "霍莱"
				},
				{
					"id": 250200103,
					"content": "唉，小伙子，咱们先去洗个澡怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200104
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250200104,
					"content": "你瞧，那个水塘离这里不远，洗好了之后，我们能马上回来接着玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200105
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250200105,
					"content": "呜呜，呜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200106
					],
					"speakerTitle": "霍莱"
				},
				{
					"id": 250200106,
					"content": "欸！等会！别乱跑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200107,
						250200108
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250200107,
					"content": "刚，刚才是不是什么冲过去了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200109
					]
				},
				{
					"id": 250200109,
					"content": "你是来部族做客的客人吗？真不好意思，霍莱最近有点活力过剩了，总是跑个没完。没吓着你吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200110
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250200110,
					"content": "你刚才在劝它去洗澡？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200111
					]
				},
				{
					"id": 250200111,
					"content": "劝？唉，我这是在「求」霍莱去洗澡了。这几天下了好几场雨，它每次出去玩都会弄的满身是泥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200112
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250200112,
					"content": "我是想要把霍莱弄干净。但它一心只想着玩，每时每刻都在到处乱跑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200113
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250200113,
					"content": "而我…作为一个普通人，完全跟不上这小伙子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200114
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250200114,
					"content": "用好吃的引诱一下？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200115
					]
				},
				{
					"id": 250200115,
					"content": "我用过了。但这小子就像是知道我在想什么一样，只要看见我在旁边，就根本不去吃东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200116
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250200116,
					"content": "我只要一挪开目光，它就从地下钻过去，把东西吃光，再钻进地里跑掉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200117
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250200117,
					"content": "不愧是嵴锋龙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200118
					]
				},
				{
					"id": 250200118,
					"content": "是啊。等这小子长大，我都不敢想它会惹出什么麻烦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200119
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250200119,
					"content": "只希望它别拱翻夏温的店面…不然我可赔不起那些宝石啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200120
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250200120,
					"content": "唉，现在也只能试试巴茨之前给我出的那个主意了。但这个球…真的能招嵴锋龙喜欢吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200121
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250200121,
					"content": "巴茨是谁？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200122
					]
				},
				{
					"id": 250200122,
					"content": "喔，他是部族里负责照顾嵴锋龙的人。这家伙可聪明了，对音乐也很精通，龙和人都很喜欢他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200123
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250200123,
					"content": "很久之前…我和巴茨说过这个问题，那家伙马上就给了我一张制作「漂流球」的图纸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200124
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250200124,
					"content": "这是他从马陶霍那边搞来的东西，小龙们可喜欢了。让我也试试做一个给霍莱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200125
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250200125,
					"content": "我刚搜集好材料，正准备开始做呢，霍莱就又折腾个不停，根本安静不下来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200126
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250200126,
					"content": "没办法了，现在只能指望「漂流球」了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200127,
						250200128
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250200127,
					"content": "我能帮什么忙吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200129
					]
				},
				{
					"id": 250200129,
					"content": "你愿意帮忙？那太好了，我运气真是够好，能碰上你这么热心的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200130
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250200130,
					"content": "那就请你去那边的箱子里，帮我拿些烬芯花茎过来吧。我会在这里先把那个「漂流球」的骨架做出来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250200128,
					"content": "需要帮忙尽管说。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200129
					]
				},
				{
					"id": 250200108,
					"content": "呜哇！差点被撞倒了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200109
					]
				}
			]
		},
