				]
			},
			"dialogs": [
				{
					"id": 250200501,
					"content": "呜？呜呜，呜…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200502
					],
					"speakerTitle": "霍莱"
				},
				{
					"id": 250200502,
					"content": "呜呜，呜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200503
					],
					"speakerTitle": "霍莱"
				},
				{
					"id": 250200503,
					"content": "霍莱开心地抱起了「漂流球」，在水塘里打起了滚。水波翻涌之间，它身上的污泥也都被洗干净了…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						250200504
					]
				},
				{
					"id": 250200504,
					"content": "哈哈哈，这小子看来很喜欢这个球啊。居然在水塘里直接玩起来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200505
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250200505,
					"content": "我们过去吧。它这也算是好好洗一顿了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200506
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250200506,
					"content": "呜呜？呜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200507
					],
					"speakerTitle": "霍莱"
				},
				{
					"id": 250200507,
					"content": "小伙子，喜欢这个礼物吗？送你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200508
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250200508,
					"content": "呜呜，呜呜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200509
					],
					"speakerTitle": "霍莱"
				},
				{
					"id": 250200509,
					"content": "给你洗个澡可真不容易…不过嘛，哈哈哈，我也算是知道怎么对付你啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200510
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250200510,
					"content": "呜呜…呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200511
					],
					"speakerTitle": "霍莱"
				},
				{
					"id": 250200511,
					"content": "你碰我手做什么？这些伤口…都是小伤，不用担心的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200512
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250200512,
					"content": "呜，呜…呜呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200513
					],
					"speakerTitle": "霍莱"
				},
				{
					"id": 250200513,
					"content": "你这小伙子，怎么一下子消沉起来了，刚才不是还玩得很开心吗？难道是玩累了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200514
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250200514,
					"content": "也多谢你了，朋友。这些东西给你，就当做是报酬吧。里面没什么值钱的玩意，你放心收下就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200515
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250200515,
					"content": "呜，呜呜！呜——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200516
					],
					"speakerTitle": "霍莱"
				},
				{
					"id": 250200516,
					"content": "等等！别回去水塘啊！霍莱！我刚刚把你擦干的啊！",
