				]
			},
			"mark": "TALK_MARK_BILLBOARD_ONLY",
			"trigger": {
				"objectNames": [
					"露子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721430101,
					"content": "您好，自外而来的客人。我叫露子，是珊瑚宫的巫女。请问客人是来帮忙的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430102
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430102,
					"content": "帮忙…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721430103
					]
				},
				{
					"id": 721430103,
					"content": "这个人怎么一见面就要人帮忙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721430104,
					"content": "哈哈，抱歉失礼了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430105
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430105,
					"content": "只是此前我求过愿。根据签文，我所苦恼之事、困扰之事，必定有人相助而得以圆满。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430106
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430106,
					"content": "现在命中的贵人果然来帮助我了，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430107,
						721430109
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430107,
					"content": "这是借口吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721430108
					]
				},
				{
					"id": 721430108,
					"content": "真是没办法呢，姑且先听听露子姐姐怎么说吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721430111,
					"content": "非常感谢。那么，就请允许我为您稍事介绍吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430112
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430112,
					"content": "珊瑚宫正对的深潭便是「渊下宫」的入口，传说也是海祇人的起源。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430113
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430113,
					"content": "在古代，曾经有「海祇美人」的说法，并且说海祇人肤质细嫩，可以令七种难隐的污痕都不再显眼呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430114
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430114,
					"content": "这种说法的来由呢，是因为我们的祖先在渊下宫得不到日照…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430115,
						721430116
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430115,
					"content": "咳咳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721430117
					]
				},
				{
					"id": 721430117,
					"content": "啊，抱歉。以前日子和平时，我经常担任向导，向旅人介绍海祇岛，不小心就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430118
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430118,
					"content": "为了纪念海祇大御神与先人，我们传统上会将祭品沉入渊下宫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430119
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430119,
					"content": "先前有说，我们的祖先起源于「白夜国」，仰赖着文献记载中的大日御舆的微薄光亮，在深海龙嗣的利爪下苟且生存。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430120
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430120,
					"content": "直至数千年前，海祇大御神降临，击败深海龙嗣，最终又带领我们回到地面上，建立珊瑚宫，以脚下的海祇岛为新的故乡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430121
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430121,
					"content": "而海面下的白夜国，从此被称为渊下宫，与海面上的珊瑚宫相对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430122
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430122,
					"content": "当然…传说只是传说，正如鸣神人的魔神征服论之于幕府军一样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430123
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430123,
					"content": "牺牲与铭记的主题也是我们捍卫自身的武器之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430124
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430124,
					"content": "这是巫女该说的话吗…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721430125,
					"content": "巫女的确不应该说这样的话，但是生而为人，我认为应当用批判的眼光看待历史与民俗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430126
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430126,
					"content": "抱歉，我又离题了…如今，海祇岛的「圣土」问题愈发严重了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430127
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430127,
					"content": "「圣土」…那是什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721430128
					]
				},
				{
					"id": 721430128,
					"content": "正如人心与水总往低处流，海祇岛的「灵」被渊下宫的深邃吸引…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430129
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430129,
					"content": "所以土地也渐渐白化，也就是圣土化。这么下去海祇岛终有一天会沦为和月光一般苍白的荒漠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430130,
						721430132
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430130,
					"content": "听起来很可怕…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721430131
					]
				},
				{
					"id": 721430131,
					"content": "是吗？在我看来，不过是老人们骇人听闻的说法罢了。虽然其中有一定的道理，但依然缺乏可信的逻辑联系。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430133
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430133,
					"content": "依照传统的教导，每隔数百年，就需要在灵脉流淌合适时，解开阻断渊下宫与珊瑚宫连接的结界…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430134
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430134,
					"content": "潜入渊下宫，取出一株大御神留下的，镇压深海龙嗣的珊瑚玉枝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430135
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430135,
					"content": "借玉枝进行海祇御灵祭，就可以使沉下去的「灵」归还，遏制圣土侵蚀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430136
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430136,
					"content": "镇压深海龙嗣的东西被取走…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721430137
					]
				},
				{
					"id": 721430137,
					"content": "您有着敏锐的洞察力呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430138
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430138,
					"content": "镇压用的珊瑚玉枝有许多，但这样下去，深海的龙嗣恐怕总有一天能突破镇压，进而入侵海祇地表。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430139
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430139,
					"content": "所以说，我想拜托您…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430140,
						721430142
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430140,
					"content": "取回珊瑚玉枝？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721430141
					]
				},
				{
					"id": 721430141,
					"content": "#{NICKNAME}很擅长找东西的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430144
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721430144,
					"content": "现阶段而言，还不是这些…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430145
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430145,
					"content": "之后还要帮忙喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430146
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721430146,
					"content": "之后的话…嗯…看情况吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430147
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430147,
					"content": "…是看求签的结果吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430148
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721430148,
					"content": "咳咳，我需要麻烦您造访海祇岛上的「五伤岩」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430149
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430149,
					"content": "五伤岩是隔断珊瑚宫与渊下宫的结界的五处节点，由珊瑚宫初代的神人们同大御神设下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430150
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430150,
					"content": "如果要解除结界，进入渊下宫，就要解除这五处封印。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430151
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430151,
					"content": "听起来很危险的样子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430152
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721430152,
					"content": "确实，贸然打开封印的话风险很大。毕竟已经过了很多年，我们这一代人谁也不知道下面隐藏着怎样的危险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430153
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430153,
					"content": "值得仰赖的记录很少，大多都是语焉不详、没有多少参考价值的古文。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430154
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430154,
					"content": "或许深海龙嗣正在下面蓄势待发，抑或是有比龙嗣更危险的魔物潜入其中，等待着封印松动之刻？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430155
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430155,
					"content": "或许过去的城墟已经被掩埋在珊瑚与海绵之下无处找寻？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430156
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430156,
					"content": "或者最差劲的结果——下面什么都没有，只是空洞与海水？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430157
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430157,
					"content": "无论如何，我们只在这里胡思乱想是没办法得知这些结果的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430158
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430158,
					"content": "虽然说得好像很有道理，但出力的还是我们嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430159
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721430159,
					"content": "不过既然渊下宫这么多年无人造访，或许祖先留下的宝藏也还在其中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430160
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430160,
					"content": "#宝…咳咳。{NICKNAME}，我觉得帮当地人解决问题，是能充实阅历的好事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430161
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721430161,
					"content": "…露子小姐真会说话。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721430162
					]
				},
				{
					"id": 721430162,
					"content": "您过奖了。那么，就进入正题吧。五伤岩有五处，分别是「眼」、「牙」、「鳍」、「尾」，与「心」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430163
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430163,
					"content": "首先是<color=#00E1FFFF>西边的岛</color>上，被称为「眼」的封印。你看，就在那边。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430164
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430164,
					"content": "那你自己去不就好啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430165
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721430165,
					"content": "嘿嘿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430166
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430166,
					"content": "给我严肃点啦！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430167
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721430167,
					"content": "封印本身维持已久，如今解除封印的仪式对大多数人而言都是未知的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430168
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430168,
					"content": "再加上现人神巫女大人因为现在的形势，很难腾出时间及时举行盛大仪式解除五重封印。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430169
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430169,
					"content": "告知外人这些，实在是令人羞赧难当。呜呼，能够仰赖的，只有像您这样见多识广、博闻强记的远国异人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430170
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430170,
					"content": "就是万一搞砸了，也可以借您异人的身份…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430171
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430171,
					"content": "顶罪？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721430172
					]
				},
				{
					"id": 721430172,
					"content": "不…您想多了，只不过是「不知者不罪」嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430173
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430173,
					"content": "如果以<color=#00E1FFFF>珊瑚宫</color>为方位基点的话，则「牙」位于<color=#00E1FFFF>西北方</color>，「鳍」位于<color=#00E1FFFF>正北方</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430174
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430174,
					"content": "最后，是<color=#00E1FFFF>东面浅滩</color>上的「尾」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430175
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430175,
					"content": "这四处封印附近，各有一座石碑，记录着仪式相关事宜…只是年代已久，字迹已经难以辨认。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430176
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430176,
					"content": "取得这四处封印中的「御灵珠」，就能解开第五重的「心」之封印。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430177
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430177,
					"content": "听起来很复杂…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721430178
					]
				},
				{
					"id": 721430178,
					"content": "没关系的，如果怕忘记的话就请来珊瑚宫找我，我再逐一为您提示就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430179
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430179,
					"content": "最后…这次将您拦下，私自委托如此重要的事情，实在有违礼节，我在此深切致歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430180
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430180,
					"content": "但无论如何，这件事情对海祇岛来说事关重大…如果您能够帮忙，珊瑚宫将对此感激不尽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "露子"
				},
				{
					"id": 721430142,
					"content": "解决深海龙嗣？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721430143
					]
				},
				{
					"id": 721430143,
					"content": "#{NICKNAME}很擅长战斗呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430144
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721430132,
					"content": "那要怎么解决呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721430133
					]
				},
				{
					"id": 721430116,
					"content": "关于要帮忙的事情…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721430117
					]
				},
				{
					"id": 721430109,
					"content": "没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721430110
					]
				},
				{
					"id": 721430110,
					"content": "这都是什么求人帮忙的理由…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430111
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7214302,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7214301",
							"3"
						],
						"stepId": 7214301,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7214302",
							"2"
						],
						"stepId": 7214302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"露子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721430201,
					"content": "您回来了。请问有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430202,
						721430206,
						721430211
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430202,
					"content": "关于「五伤岩」的位置…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721430203
					]
				},
				{
					"id": 721430203,
					"content": "<color=#00E1FFFF>「眼」</color>在<color=#00E1FFFF>正西边的岛屿</color>上；<color=#00E1FFFF>「牙」</color>在<color=#00E1FFFF>西北方的海岸</color>上；<color=#00E1FFFF>「鳍」</color>在<color=#00E1FFFF>正北方的海岸</color>上，而<color=#00E1FFFF>「尾」</color>则在<color=#00E1FFFF>东南方的浅滩</color>上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430204
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430204,
					"content": "这四处封印附近，各有一座石碑，记录着仪式相关事宜…只是年代已久，字迹已经难以辨认。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430205
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430205,
					"content": "从这四处封印中取得四枚「御灵珠」，才能解开「心」之封印。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430214
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430214,
					"content": "然后在必要的时刻，再解开封印取玉枝，行海祇御灵祭…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430215
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430215,
					"content": "但我在教令院学到的知识告诉我，所谓的圣土化是海祇岛的地质结构决定的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430216
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430216,
					"content": "随着海水的浸入，土地变得干硬，盐碱会排除掉原有的养分，让土壤中的元素反应惰化，不再适合耕种。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430217
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430217,
					"content": "而玉枝中蕴含的大御神的力量，可以为土地补充元素，抵消白化的影响。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430218
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430218,
					"content": "咳咳，抱歉，又说了离题的话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "露子"
				},
				{
					"id": 721430206,
					"content": "关于「五伤岩」的名字…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721430207
					]
				},
				{
					"id": 721430207,
					"content": "啊，你是想问为什么这几处封印这样称呼是吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430208
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430208,
					"content": "大御神大人有一神使，神人们在它的骸骨上设置了封印，用它的力量屏断了海祇与渊下的联系。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430209
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430209,
					"content": "不信的话您可以自己看看地图，左边突出鼓泡的便是「眼」，右下角伸展而出的便是「尾」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430210
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430210,
					"content": "好啦，别这样看着我！同行的解释就是这样的！我也很难接受啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "露子"
				},
				{
					"id": 721430211,
					"content": "关于「圣土化」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721430212
					]
				},
				{
					"id": 721430212,
					"content": "通行的说法是，土地白化是海祇土地的「灵」被白夜国吸引、下沉所致，最终会使海祇沦为荒漠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430213
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430213,
					"content": "而多亏了珊瑚宫的镇压作用，以及现人神巫女大人所继承的大御神之神力，「圣土化」才没有扩散至全岛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "露子"
				}
			]
		}
	]
}