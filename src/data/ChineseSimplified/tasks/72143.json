	"talks": [
		{
			"id": 7214301,
			"completionStepIds": [
				7214301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7214301",
							"2"
						],
						"stepId": 7214301,
						"stateName": "QUEST_STATE_UNFINISHED"
