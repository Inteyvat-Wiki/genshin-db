				"objectNames": [
					"婕德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732120401,
					"content": "#{NICKNAME}！你好呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120402
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732120402,
					"content": "很感谢你能陪我一起去冒险，关于我父母的事…谢谢你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120403
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732120403,
					"content": "请不用这么客气。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120404
					]
				},
				{
					"id": 732120404,
					"content": "嘿嘿，如果不是芭别尔主母还委托了其他任务，我就也陪你一起去沙漠里探险啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120405
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732120405,
					"content": "我还知道好多好玩的地方，等我有时间就带你们一起去！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120406
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732120406,
					"content": "不过现在怕是不方便咯，那些勾结北方人的叛徒一直在觊觎着我们的领地，我还要侦察他们的动向才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "婕德"
				}
			]
		},
