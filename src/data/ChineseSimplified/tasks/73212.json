			"dialogs": [
				{
					"id": 732120801,
					"content": "（一卷完好的毛毯，其上缝制着塔尼特部族的标志，沾染着点点不祥的污迹…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120802
					],
					"speakerTitle": "调查"
				},
				{
					"id": 732120802,
					"content": "这卷毛毯…真奇怪…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120803
					]
				},
				{
					"id": 732120803,
					"content": "唔…昂贵的毛毯，为什么会被丢在这里呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120804
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732120804,
					"content": "或许是因为发生了抢夺和打斗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120805
					]
				},
				{
					"id": 732120805,
					"content": "嗯…有道理哦…这样的话，就能说明白啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120806
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732120806,
					"content": "商队和劫匪在这里发生了打斗，一些物资在打斗过程中被破坏掉了，还有一些完好的物资没有顾得上整理就被丢弃掉了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120807
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732120807,
					"content": "派蒙的推理很靠谱呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120808
					]
				},
				{
					"id": 732120808,
					"content": "哼哼！毕竟是我派蒙嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120809
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732120809,
					"content": "于是，商队和劫匪一路打、一路跑！一路打、一路跑！一路打、一路跑…所以路上会散落着破碎的箱子和罐子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120810
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732120810,
					"content": "嗯，这样就能说得通啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120811
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732120811,
					"content": "完全说不通吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120812
					]
				},
				{
					"id": 732120812,
					"content": "欸——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120813,
						732120814
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732120813,
					"content": "那些垃圾应该是劫匪得手后丢弃的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120815
					]
				},
				{
					"id": 732120815,
					"content": "这样吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120816
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732120816,
					"content": "因为沿途没有发现争斗痕迹。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120817
					]
				},
				{
					"id": 732120817,
					"content": "这样呀…哼哼，那我的推理也差的不远啦…八九不离十嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120818
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732120818,
					"content": "唔…但我总觉得哪里不太对劲…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120819,
						732120820
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732120819,
					"content": "是哪里呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120821
					]
				},
				{
					"id": 732120821,
					"content": "那个…你不觉得这些线索太刻意了吗？就像为专门引导我们而排列的一样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120822,
						732120823
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732120822,
					"content": "唔…是你太多疑了吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120824
					]
				},
				{
					"id": 732120824,
					"content": "欸！你看，马车不就在那边吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120825
					],
					"speakerTitle": "派蒙"
				},
				{
