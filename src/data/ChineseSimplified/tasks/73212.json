			"dialogs": [
				{
					"id": 732121601,
					"content": "唔…没有什么完整的东西留下来呢…哼，气死我啦！这些丘丘人太糟蹋东西啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121602,
						732121604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732121602,
					"content": "等等，这些应该不是丘丘人破坏的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121603
					]
				},
				{
					"id": 732121603,
					"content": "欸…？可是…丘丘人就在这里扎营呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121606,
						732121608
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732121606,
					"content": "因为我们还没有看到马车…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121607
					]
				},
				{
					"id": 732121607,
					"content": "嗯…对哦！马车残骸不在这里…丘丘人搭建的棚子上也没有看到像是马车零件的东西…奇怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121610
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732121610,
					"content": "我们再顺路往前走走看吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121611
					]
				},
				{
					"id": 732121611,
					"content": "嗯…好吧。既然不是丘丘人干的，那又会是谁呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732121608,
					"content": "你看，营地里没有马车。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121609
					]
				},
				{
					"id": 732121609,
					"content": "对哦！如果是丘丘人抢劫了商队，应该会把马车留在原地慢慢拆解，但是我们既没看到马车，也没看到马车的零件…真是奇怪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121610
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732121604,
					"content": "等等，抢劫应该没有发生在这里…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121605
					]
				},
				{
					"id": 732121605,
					"content": "可是丘丘人在路中间扎下了营地呀？你看，挡在这里不是正好可以拦路抢劫吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121606,
						732121608
					],
					"speakerTitle": "派蒙"
				}
			]
