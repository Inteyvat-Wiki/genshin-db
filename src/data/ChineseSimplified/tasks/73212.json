					"content": "怎么，有、有、有何进展？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120302
					],
					"speakerTitle": "尤夫腾"
				},
				{
					"id": 732120302,
					"content": "我们还在调查失踪的商队。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120303
					]
				},
				{
					"id": 732120303,
					"content": "请、请、请尽快调查吧，我请求您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "尤夫腾"
