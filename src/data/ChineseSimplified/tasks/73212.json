			},
			"dialogs": [
				{
					"id": 732121701,
					"content": "你好，尊贵的镇灵主人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121702
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732121702,
					"content": "关于你们上次遇袭的事情，我还正在追查，请你们一定放心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121703
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732121703,
					"content": "我保证你们在塔尼特部族内的安全，但如果进入沙漠…还请万分小心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121704,
						732121711,
						732121714,
						732121721
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732121704,
					"content": "关于「永恒绿洲」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121705
					]
				},
				{
					"id": 732121705,
					"content": "请容我代表塔尼特部族再次感谢你们和婕德的付出…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121706
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732121706,
					"content": "「永恒绿洲」不仅对那孩子有重要的意义，对于塔尼特部族，它也是信仰的中心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121707
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732121707,
					"content": "拥有它，就是拥有了「绿洲女王」娜布·玛莉卡塔的王座…对于曾属于她的子民之后代来说，意义重大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121708
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732121708,
					"content": "我不太明白…它究竟有什么价值？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121709
					]
				},
				{
					"id": 732121709,
					"content": "哈哈，毫无价值…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121710
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732121710,
					"content": "…价值非凡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732121711,
					"content": "婕德最近很忙吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121712
					]
				},
				{
					"id": 732121712,
					"content": "是啊，既然我们已经控制了「永恒绿洲」，就要阻止其他怀有非分之想的家伙靠近。塔尼特如今是「永恒绿洲」的卫士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121713
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732121713,
					"content": "而最适合完成这等任务的，我想是婕德无疑了。她也是在守护自己的父母，不是吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732121714,
					"content": "关于叛徒们…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121715
					]
				},
				{
					"id": 732121715,
					"content": "我猜是因为我们打开了通往「永恒绿洲」的道路，那些叛徒们才又开始蠢蠢欲动起来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121716
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732121716,
					"content": "我们的女神，对于他们来说是至高权力的标志，也能给他们带来无数财源…我无法容忍这种亵渎，不论她是睡着，还是醒着。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121717,
						732121719
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732121717,
					"content": "你还相信她会醒来？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121718
					]
				},
				{
					"id": 732121718,
					"content": "我当然相信…或早或晚，她会重聚神形，她会引导我们进入花的国度。但在那之前，我…塔尼特会代她的意志行事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732121719,
					"content": "我们去过了，她不在那里。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121720
					]
				},
				{
					"id": 732121720,
					"content": "她「在」那里，你们只是没「看到」。但她「在」，她永远都「在」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732121721,
					"content": "再见。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121722
					]
				},
				{
					"id": 732121722,
					"content": "保重，尊贵的「镇灵主人。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芭别尔"
				}
			]
		}
