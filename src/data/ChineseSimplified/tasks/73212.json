			"dialogs": [
				{
					"id": 732120601,
					"content": "（空空如也的破木箱，被人随意地丢弃在这里，无力地倒在路边。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120602
					],
					"speakerTitle": "调查"
				},
				{
					"id": 732120602,
					"content": "咦，这个木箱一定是车队的吧，上面有部落的标志呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120603
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732120603,
					"content": "这里的地形很适合伏击。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120604
					]
				},
				{
					"id": 732120604,
					"content": "说得是呢…这个位置，一看就很凶险！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732120605,
					"content": "就连大件物资也被抢夺一空了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120606
					]
				},
				{
					"id": 732120606,
					"content": "他们搬走了物资，但是留下了空箱子…嗯，他们的人数应该不少，而且缺少搬运木箱的工具。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120607
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732120607,
					"content": "或者，这是他们的计谋…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120608
					]
				},
				{
					"id": 732120608,
					"content": "欸…？计谋？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120609
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732120609,
					"content": "难道这些空箱是他们故意留下来的…为了引人上钩吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120610
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732120610,
					"content": "为了引我们上钩。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120611
					]
				},
				{
					"id": 732120611,
					"content": "呜哇…我汗毛都要起来了！那我们还要不要继续往前探查呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120612,
						732120614
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732120612,
					"content": "派蒙害怕的话，可以先回去呀。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120613
					]
				},
				{
					"id": 732120613,
					"content": "我不要，谁说我害怕啦！哼…况且你也一定离不开我呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732120614,
					"content": "打劫车队的人，也许还埋伏在附近。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120615
					]
				},
				{
					"id": 732120615,
					"content": "唔，你说的好可怕…哼，但既然你都不怕，我们就继续顺着道路探查吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
