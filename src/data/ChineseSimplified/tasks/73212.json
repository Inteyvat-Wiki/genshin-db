			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"尤夫腾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732120101,
					"content": "啊，「镇灵主人」，您、您、您来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120102
					],
					"speakerTitle": "尤夫腾"
				},
				{
					"id": 732120102,
					"content": "我正好有一件事要拜托您，一件、一件…急事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120103,
						732120105
					],
					"speakerTitle": "尤夫腾"
				},
				{
					"id": 732120103,
					"content": "请别着急，我在听着。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120104
					]
				},
				{
					"id": 732120104,
					"content": "嗯嗯，你慢慢说，我们会帮忙的啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732120107,
					"content": "是我的一批、一批、一批货物…丢失了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120108
					],
					"speakerTitle": "尤夫腾"
				},
				{
					"id": 732120108,
					"content": "居然丢了三批货物呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732120109,
					"content": "不，是一、一、一批…货物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120110
					],
					"speakerTitle": "尤夫腾"
				},
				{
					"id": 732120110,
					"content": "外人运进来的「丰沃之惠」，已经很、很久了，但没、没有到货…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120111
					],
					"speakerTitle": "尤夫腾"
				},
				{
					"id": 732120111,
					"content": "可能是那些北、北方人搞的鬼…因为芭别尔主母一直在针对他们，搜、搜捕叛徒什么的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120112
					],
					"speakerTitle": "尤夫腾"
				},
				{
					"id": 732120112,
					"content": "自从、自从阿德菲和阿萨里格不在了以后…他们的活动也多起来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120113
					],
					"speakerTitle": "尤夫腾"
				},
				{
					"id": 732120113,
					"content": "好、好了，不多说别、别的闲话。运送「丰沃之惠」的商队最后是在、在这片区域被哨兵发现的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120114
					],
					"speakerTitle": "尤夫腾"
				},
				{
					"id": 732120114,
					"content": "希望您能帮助我找、找、找到货物，或者至少、至少、至少…将商队留下的线索告知我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120115
					],
					"speakerTitle": "尤夫腾"
				},
				{
					"id": 732120115,
					"content": "好的，我会帮忙的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120116
					]
				},
				{
					"id": 732120116,
					"content": "商队自己就不见了？听起来是被坏家伙打劫了呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732120117,
					"content": "十分、十分、十分感谢，这些肉请您收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120118
					],
					"speakerTitle": "尤夫腾"
				},
				{
					"id": 732120118,
					"content": "你太客气啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732120105,
					"content": "有什么事情需要我帮忙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120106
					]
				},
				{
					"id": 732120106,
					"content": "慢慢说啦，不要着急！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120107
					],
					"speakerTitle": "派蒙"
				}
			]
		},
