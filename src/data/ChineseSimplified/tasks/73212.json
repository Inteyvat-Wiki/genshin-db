			"dialogs": [
				{
					"id": 732120501,
					"content": "（一个破损的空罐，尚未完全被沙子掩埋。看起来它是在不久前被人丢弃的。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120502
					],
					"speakerTitle": "调查"
				},
				{
					"id": 732120502,
					"content": "你看！这个罐子还没有被沙子掩埋呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120503,
						732120505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732120503,
					"content": "物资散落在商道上了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120504
					]
				},
				{
					"id": 732120504,
					"content": "看起来很不妙呢…说不定他们顺路还遗落了其他东西，我们再往前找找看吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732120505,
					"content": "我们再顺路寻找一番吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120506
					]
				},
				{
					"id": 732120506,
					"content": "嗯…他们应该还沿途丢弃了其他东西，我们继续往前走走看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
