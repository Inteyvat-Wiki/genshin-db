					"nextDialogs": [
						732120906
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732120906,
					"content": "你相信他们说的话吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120907
					],
					"speakerTitle": "派蒙"
				},
				{
