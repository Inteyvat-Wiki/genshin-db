			},
			"dialogs": [
				{
					"id": 708150401,
					"content": "唉，本来我算着日子，再值个两三天班就能回去了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150402
					],
					"speakerTitle": "嘉义"
				},
				{
					"id": 708150402,
					"content": "加上我之前攒的假，这次回去少说能陪小六一个多星期。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150403
					],
					"speakerTitle": "嘉义"
				},
				{
					"id": 708150403,
					"content": "结果一声命令全体千岩军取消休假，正在休假的也全部召回。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150404
					],
					"speakerTitle": "嘉义"
				},
				{
					"id": 708150404,
					"content": "按照我的经验，至少一个月内我都别想回轻策庄。这都叫什么事嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嘉义"
				}
			]
		},
		{
			"id": 7081505,
			"completionStepIds": [
				7081502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
