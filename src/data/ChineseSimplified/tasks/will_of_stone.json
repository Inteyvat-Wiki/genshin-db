				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"小六"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708150801,
					"content": "你们跟着我到底有什么事？我说了我要去璃月港。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150802
					],
					"speakerTitle": "小六"
				},
				{
					"id": 708150802,
					"content": "这些魔物我自己会绕着走，它们发现不了我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150803
					],
					"speakerTitle": "小六"
				},
				{
					"id": 708150803,
					"content": "别老是把我当小孩子，我已经长大了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150804
					],
					"speakerTitle": "小六"
				},
				{
					"id": 708150804,
					"content": "这是你爸爸给你的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150805
					]
				},
				{
					"id": 708150805,
					"content": "我爸爸给我的？是他要你们送过来的吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150806
					],
					"speakerTitle": "小六"
				},
				{
					"id": 708150806,
					"content": "准又是些小孩子玩的东西…不是风筝就是娃娃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150807
					],
					"speakerTitle": "小六"
				},
				{
					"id": 708150807,
					"content": "你不喜欢这些？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150808
					]
				},
				{
					"id": 708150808,
					"content": "…喜欢啊，我爸爸送给我的东西，我怎么可能不喜欢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150809
					],
					"speakerTitle": "小六"
				},
				{
					"id": 708150809,
					"content": "但我要是一直只喜欢这些东西的话，不就一直是小孩子了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150810
					],
					"speakerTitle": "小六"
				},
				{
					"id": 708150810,
					"content": "老是玩这些，我什么时候能成为冒险家，拿到「神之眼」啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150811
					],
					"speakerTitle": "小六"
				},
				{
					"id": 708150811,
					"content": "你要「神之眼」做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150812
					]
				},
				{
					"id": 708150812,
					"content": "有了「神之眼」，我就能做到很多事了啊，无论是赚钱还是其他什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150813
					],
					"speakerTitle": "小六"
				},
				{
					"id": 708150813,
					"content": "然后，爸爸就不用天天在璃月港里工作，可以回来陪我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150814
					],
					"speakerTitle": "小六"
				},
				{
					"id": 708150814,
					"content": "你看，现在我没有「神之眼」…连自己去璃月港都做不到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150815
					],
					"speakerTitle": "小六"
				},
				{
