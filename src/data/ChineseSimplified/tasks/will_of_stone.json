					"小六"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708150701,
					"content": "你们是来抓我回轻策庄的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150702,
						708150704
					],
					"speakerTitle": "小六"
				},
				{
					"id": 708150702,
					"content": "若心奶奶很担心你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150703
					]
				},
				{
					"id": 708150703,
					"content": "哼，果然是来抓我回去的，我才不回去呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150706
					],
					"speakerTitle": "小六"
				},
				{
					"id": 708150706,
					"content": "你们回去告诉村里的人，我要去璃月港找我爸爸去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150707
					],
					"speakerTitle": "小六"
				},
				{
					"id": 708150707,
					"content": "找到了之后，我和我爸爸说会话就回去，让他们别操心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小六"
				},
				{
					"id": 708150704,
					"content": "我们有东西给你…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150705
					]
				},
				{
					"id": 708150705,
					"content": "我才不要你们的东西，又是那些哄小孩的东西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150706
					],
					"speakerTitle": "小六"
				}
			]
		},
		{
			"id": 7081508,
			"completionStepIds": [
				7081508
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7081508",
							"2"
						],
						"stepId": 7081508,
						"stateName": "QUEST_STATE_UNFINISHED"
