			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"若心"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708150501,
					"content": "这孩子，跑到哪里去了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150502
					],
					"speakerTitle": "若心"
				},
				{
					"id": 708150502,
					"content": "关于小六…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150503
					]
				},
				{
					"id": 708150503,
					"content": "你们是来找小六的？唉，你们来得不巧，那孩子不知道跑到哪里去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150504
					],
					"speakerTitle": "若心"
				},
				{
					"id": 708150504,
					"content": "前几天，她爸爸从璃月港里托人带了封信回来，说很快就能回来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150505
					],
					"speakerTitle": "若心"
				},
				{
					"id": 708150505,
					"content": "小六很开心，说要给她爸爸准备礼物，拉着几个孩子到处采花采野果…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150506
					],
					"speakerTitle": "若心"
				},
				{
					"id": 708150506,
					"content": "结果前几天，她爸爸又说临时要执勤，回不来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150507
					],
					"speakerTitle": "若心"
				},
				{
					"id": 708150507,
					"content": "这孩子就赌了气，怎么劝也不好，非说她爸爸不回来，她就自己去璃月港。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150508
					],
					"speakerTitle": "若心"
				},
				{
					"id": 708150508,
					"content": "我们还当她是开玩笑，结果今天一起来，小六人就不见了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150509
					],
					"speakerTitle": "若心"
				},
				{
					"id": 708150509,
					"content": "唉，能去找她的人已经都出去找她了，要是你们愿意的话，就也去找找她吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150510,
						708150512
					],
					"speakerTitle": "若心"
				},
				{
					"id": 708150510,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150511
					]
				},
				{
					"id": 708150511,
					"content": "那就麻烦你了，唉，这孩子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "若心"
				},
				{
					"id": 708150512,
					"content": "她会去哪？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150513
					]
				},
				{
					"id": 708150513,
					"content": "这孩子也跑不太远，应该就在附近，但荒郊野外的太危险了…你们快去找找她吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "若心"
				}
			]
		},
		{
			"id": 7081506,
