			"dialogs": [
				{
					"id": 708150601,
					"content": "嘉义也是，怎么说不回来就不回来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150602
					],
					"speakerTitle": "若心"
				},
				{
					"id": 708150602,
					"content": "这孩子一年都见不到他几次，这天下哪里有这么当爸爸的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150603,
						708150605
					],
					"speakerTitle": "若心"
				},
				{
					"id": 708150603,
					"content": "他也是为了璃月港…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150604
					]
				},
				{
					"id": 708150604,
					"content": "嘉义年年也都这么说，我都记不清他说了多少次了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "若心"
				},
				{
					"id": 708150605,
					"content": "这也是为了工作…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150606
					]
				},
				{
					"id": 708150606,
					"content": "那他也要顾顾自己的女儿吧，小六可是看着看着长大了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150607
					],
					"speakerTitle": "若心"
				},
				{
					"id": 708150607,
					"content": "可别到时候，他是不工作了回庄里住着了，结果小六又要去工作了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150608
					],
					"speakerTitle": "若心"
				},
				{
					"id": 708150608,
					"content": "这父女俩啊，反正就凑不到一块去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "若心"
				}
			]
		},
		{
			"id": 7081507,
