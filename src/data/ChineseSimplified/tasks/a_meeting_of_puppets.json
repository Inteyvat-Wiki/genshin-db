			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿帽"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733560201,
					"content": "各有各的路要走，不必多言。茶倒是不错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560202,
						733560203
					],
					"speakerTitle": "阿帽"
				},
				{
					"id": 733560202,
					"content": "（再这么坐一会儿吧。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560204
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 733560204,
					"content": "行，再见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿帽"
				},
				{
					"id": 733560203,
					"content": "茶会时间该结束了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560204
					],
					"speakerTitle": "「木偶」"
				}
			]
		}
	]
