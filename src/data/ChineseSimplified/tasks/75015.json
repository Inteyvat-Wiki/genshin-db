			"dialogs": [
				{
					"id": 750150501,
					"content": "呼，总算清理完了，那、那我就要开始钓鱼了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750150502,
					"content": "唔，我一定要钓上条大鱼给你们看看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750150503,
					"content": "但可惜水面一动不动，没有波澜。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750150504
					]
				},
				{
					"id": 750150504,
					"content": "唔…是不是这里的水质太好了？鱼儿根本不想从里面出来嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150505,
						750150508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750150505,
					"content": "胜利就在眼前，嘿嘿~",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750150506
					]
				},
				{
					"id": 750150506,
					"content": "就是这样，「胜利就在眼前！」…不对，这才刚开始，离胜利还早着呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750150507,
					"content": "不要在这种时候胡乱鼓励啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150511
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750150511,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150512
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150512,
					"content": "要成功了，要成功了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750150513
					]
				},
				{
					"id": 750150513,
					"content": "哎呀，你别在这个时候说话啦…真是的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150514
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750150514,
					"content": "怎么了怎么了？哇！鱼竿动了，让我看看是什么好东西？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150515
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750150515,
					"content": "#什么嘛，不是鱼，是个漂流瓶，而且还用线绑在了钓点的木板上…说起来，{NICKNAME}也经常钓上来奇怪的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150516
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750150516,
					"content": "钓鱼的什么都能钓到，除了鱼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750150517
					]
				},
				{
					"id": 750150517,
					"content": "#{NICKNAME}不也经常钓到些奇怪的东西嘛，毕竟是钓上来的，让我看看里面塞了什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150518
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750150518,
					"content": "沉迷钓鱼的人，好可怕，难道刚才那堆乱七八糟的东西都是这两个人留下的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150519
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750150519,
					"content": "我们还是把这个瓶子扔回去吧，看来这就是他们互相联络的工具了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150520
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750150520,
					"content": "唔，我有预感，下次肯定能够钓到鱼的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150521
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750150521,
					"content": "鱼竿猛地一沉，剧烈地抖动了起来，\\n水底下是个分量不轻的「大家伙」，恶狠狠地咬上了钩。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750150522
					]
				},
				{
					"id": 750150522,
					"content": "终于吃钩了！这回一定是大鱼，给我上来——啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150523
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750150523,
					"content": "给我上来——啊！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750150524
					]
				},
				{
					"id": 750150524,
					"content": "呀呀！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150525
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150525,
					"content": "#看到派蒙很吃力。\\n你和{REALNAME[ID(2)|SHOWHOST(true)]}一起抱住了派蒙…\\n但是，钓竿对面传来了巨大的拉力！",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750150526
					]
				},
				{
					"id": 750150526,
					"content": "「砰」的一声，鱼脱钩了…",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750150527
					]
				},
				{
					"id": 750150527,
					"content": "呜呜！这一定是一条好大的鱼，鱼钩才会脱钩啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150528
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750150528,
					"content": "真是气死了…啊，它居然还在水面上游来游去，岂有此理！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150529
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750150529,
					"content": "呀呀——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150530
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150530,
					"content": "不行不行，海里太危险了，你游得也没有鱼快啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150531
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750150531,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150532
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150532,
					"content": "#要是有什么办法抓住那条鱼就好了，{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750150508,
					"content": "快了快了，沉住气哦！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750150509
					]
				},
				{
					"id": 750150509,
					"content": "嗯嗯，鱼儿吃钩的时机，像甜甜花里蹿出来一朵骗骗花一样突然，完全没法预测…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150510
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750150510,
					"content": "只能专注地等待——再等待——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
