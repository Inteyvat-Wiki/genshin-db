			"dialogs": [
				{
					"id": 750150401,
					"content": "#锵锵！真不愧是{NICKNAME}，把这条嚣张的鱼抓到咯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750150402,
					"content": "说起来，如果一次把饵全部洒进去，让鱼吃到翻肚皮，自动漂上来，是不是也算一种「钓鱼」呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750150403,
					"content": "啊…啊呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150404
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150404,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}也觉得这样可以吗？看你的眼神很期待呢！嘿嘿，下次我们一起试试呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750150405,
					"content": "啊呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150406
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150406,
					"content": "#哇！还没有烤呢，得等{NICKNAME}做好才能吃啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750150407,
					"content": "做完了烤鱼，大家一起饱餐了一顿。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750150408
					]
				},
				{
					"id": 750150408,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150409
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150409,
					"content": "总觉得这顿烤鱼格外的香呢，不愧是我钓起来的鱼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750150410,
					"content": "不愧是派蒙，以后都交给你了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750150411
					]
				},
				{
					"id": 750150411,
					"content": "哎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750150412,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150413
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150413,
					"content": "#别想着不劳而获，如果要吃到鱼，那{REALNAME[ID(2)|SHOWHOST(true)]}你下次也得帮忙才行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750150414,
					"content": "唔嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150415
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150415,
					"content": "这种时候就开始装傻了，你这家伙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
