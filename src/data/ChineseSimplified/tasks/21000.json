				"points": []
			},
			"dialogs": [
				{
					"id": 210000101,
					"content": "唉，我真的能做到吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000102
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210000102,
					"content": "小蒙，你怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000103
					]
				},
				{
					"id": 210000103,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，是你啊…你好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000104
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210000104,
					"content": "小蒙，你怎么看着有些不开心呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 210000105,
					"content": "怎么了？是他们不和你玩那个…海盗游戏了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 210000106,
					"content": "欸？不是，璐璐和阿飞他们是回家去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000107
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210000107,
					"content": "我…是想要自己出去逛逛，所以才暂时没回家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000108
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210000108,
					"content": "这样你父母不会担心吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 210000109,
					"content": "现在这个时间，我爸妈应该还在工作没回家呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000110
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210000110,
					"content": "#不说这个，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，我能问你个问题吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000111,
						210000112
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210000111,
					"content": "什么问题？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000114
					]
				},
				{
					"id": 210000114,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，我听很多人说起过你的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000115
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210000115,
					"content": "我觉得，你去过很多地方，也经历过很多事…说不定能告诉我这个问题的答案…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000116
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210000116,
					"content": "呜哇…小蒙突然这么严肃了，到底是什么问题呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 210000117,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，我想问你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000118
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210000118,
					"content": "一个人到底怎么样，才能变得「成熟」呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000119,
						210000122
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210000119,
					"content": "需要用时间来成长。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000120
					]
				},
				{
					"id": 210000120,
					"content": "你是说，只要长大了，人就会自然而然地变成熟吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000121
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210000121,
					"content": "可是，长大了之后再成熟，会不会有点太晚了呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000124
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210000124,
					"content": "唔…如果你是想要出城看看的话，我们可以陪你出去逛逛呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 210000125,
					"content": "那也太麻烦你们了，而且…只是出城的话，我应该也不会有什么特别的收获吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000126
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210000126,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，我想请你们帮我另一个忙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000127
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210000127,
					"content": "我听人家说，如果有解决不了的烦恼，可以把烦恼写下来放进漂流瓶里，让烦恼随着河水飘出去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000128
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210000128,
					"content": "这样子，说不定烦恼就会得到解决。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000129
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210000129,
					"content": "但我听说，外面有很多魔物，我一个人去有些不太安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000130
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210000130,
					"content": "#所以，我想要拜托{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}保护一下我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000131,
						210000132
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210000131,
					"content": "没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000133
					]
				},
				{
					"id": 210000133,
					"content": "#谢谢{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}。我会付你报酬的，都是我自己攒的钱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000134
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210000134,
					"content": "那我们出发吧，先去碧水河边看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210000132,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000133
					]
				},
				{
					"id": 210000122,
					"content": "需要经历特别的事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000123
					]
				},
				{
					"id": 210000123,
					"content": "要经历特别的事…可我到现在，连璃月港都没踏出去过…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000124
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210000112,
					"content": "我暂时没空陪你玩…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000113
					]
				},
				{
					"id": 210000113,
					"content": "哈哈哈，那个游戏我也是陪着璐璐和阿飞玩啦，他们不在，我也不会特意去玩的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000114
					],
					"speakerTitle": "小蒙"
				}
			]
		},
