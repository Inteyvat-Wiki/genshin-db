			"dialogs": [
				{
					"id": 100120401,
					"content": "果然，骑士团已经行动起来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120402
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120402,
					"content": "前面围了这么多人？气氛好像有些不对劲…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120403
					],
					"speakerTitle": "希奥多"
				},
				{
					"id": 100120403,
					"content": "那是…阿多诺！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120404
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120404,
					"content": "数小时前…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						100120405
					]
				},
				{
					"id": 100120405,
					"content": "哈…可算找到你咯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120406
					],
					"speakerTitle": "阿多诺"
				},
				{
					"id": 100120406,
					"content": "喵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120407
					],
					"speakerTitle": "北地猫"
				},
				{
					"id": 100120407,
					"content": "好好看住它吧，别再让它跑到这么远的地方了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120408
					],
					"speakerTitle": "阿多诺"
				},
				{
					"id": 100120408,
					"content": "谢谢…谢谢阿多诺爷爷！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120409
					],
					"speakerTitle": "莫里兹提尔"
				},
				{
					"id": 100120409,
					"content": "也别再一个人跑到城外找它了，你担心它，汉娜洛蕾也会担心你呀。这次我就先替你保密了，下不为例啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120410
					],
					"speakerTitle": "阿多诺"
				},
				{
					"id": 100120410,
					"content": "嗯…我知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120411
					],
					"speakerTitle": "莫里兹提尔"
				},
				{
					"id": 100120411,
					"content": "喵…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120412
					],
					"speakerTitle": "北地猫"
				},
				{
					"id": 100120412,
					"content": "咕…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120413
					],
					"speakerTitle": "魔物"
				},
				{
					"id": 100120413,
					"content": "啊！那…那是…魔物？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120414
					],
					"speakerTitle": "莫里兹提尔"
				},
				{
					"id": 100120414,
					"content": "魔物？怎么会跑到这里…样子也不太对劲…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120415
					],
					"speakerTitle": "阿多诺"
				},
				{
					"id": 100120415,
					"content": "啊…啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120416
					],
					"speakerTitle": "莫里兹提尔"
				},
				{
					"id": 100120416,
					"content": "不要怕！有我在呢！站起来！跑回去！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120417
					],
					"speakerTitle": "阿多诺"
				},
				{
					"id": 100120417,
					"content": "可…可是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120418
					],
					"speakerTitle": "莫里兹提尔"
				},
				{
					"id": 100120418,
					"content": "快回去——爷爷我…可是骑士啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿多诺"
				}
			]
		},
