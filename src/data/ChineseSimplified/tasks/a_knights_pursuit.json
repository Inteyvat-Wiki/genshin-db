			},
			"dialogs": [
				{
					"id": 100120501,
					"content": "…随后赶到的骑士们，解决了闯入近郊的魔物…它的力量远超寻常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120502
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 100120502,
					"content": "而阿多诺为了拖延时间，拼命跟它缠斗到了最后。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120503
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 100120503,
					"content": "阿多诺…阿多诺！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120504
					],
					"speakerTitle": "希奥多"
				},
				{
					"id": 100120504,
					"content": "哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120505
					],
					"speakerTitle": "阿多诺"
				},
				{
					"id": 100120505,
					"content": "…没事的，我的身体你也知道…要不是有你，早就撑不到今天了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120506
					],
					"speakerTitle": "阿多诺"
				},
				{
					"id": 100120506,
					"content": "能为了救人再拼一把，可比躺在床上…更像个骑士！…咳咳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120507
					],
					"speakerTitle": "阿多诺"
				},
				{
					"id": 100120507,
					"content": "就是可惜…你帮我调理了那么久…辛苦了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120508
					],
					"speakerTitle": "阿多诺"
				},
				{
					"id": 100120508,
					"content": "呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120509
					],
					"speakerTitle": "希奥多"
				},
				{
					"id": 100120509,
					"content": "洛恩…「仁蔼骑士」的名号，还有第五小队的队长…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120510
					],
					"speakerTitle": "阿多诺"
				},
				{
					"id": 100120510,
					"content": "我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120511
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120511,
					"content": "——要是不喜欢，就都别管啦。你没必要…活成任何人的样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120512
					],
					"speakerTitle": "阿多诺"
				},
				{
					"id": 100120512,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120513
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120513,
					"content": "…洛恩，跟我来一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120514
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 100120514,
					"content": "调查小队的分析结果已经出来了：袭击阿多诺的魔物，身上带着乌萨的气息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120515
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 100120515,
					"content": "……！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120516
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120516,
					"content": "事到如今，你还打算保持沉默吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120517
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 100120517,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120518
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120518,
					"content": "这不是审讯，你可以继续沉默，但我希望你能好好坦白。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120519
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 100120519,
					"content": "——我说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120520
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120520,
					"content": "…我会交代一切，也会接受任何处置。但…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120521
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120521,
					"content": "请再给我一晚上的时间吧。等到明天，我会去骑士团说明一切。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120522
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120522,
					"content": "…这是一个骑士的誓言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120523
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120523,
					"content": "唉——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120524
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 100120524,
					"content": "…跟你共事了这么久，还是头一次听你用骑士之名起誓。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120525
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 100120525,
					"content": "哈，我知道自己的骑士之名没多少信用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120526
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120526,
					"content": "但如果算上「仁蔼骑士」的愿望，就够分量了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120527
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 100120527,
					"content": "这一次，就请你信守这个承诺吧，洛恩骑士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120528
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 100120528,
					"content": "…抱歉啊，希奥多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120529
					],
					"speakerTitle": "阿多诺"
				},
				{
					"id": 100120529,
					"content": "我本来想把队长的位置交给洛恩，把「仁蔼」的名号留给你…我知道你从小就憧憬这个称号…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120530
					],
					"speakerTitle": "阿多诺"
				},
				{
					"id": 100120530,
					"content": "这不是您的错，阿多诺先生…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120531
					],
					"speakerTitle": "希奥多"
				},
				{
					"id": 100120531,
					"content": "我没有洛恩那样的天分，轻而易举就能通过骑士团的考核…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120532
					],
					"speakerTitle": "希奥多"
				},
				{
					"id": 100120532,
					"content": "努力了那么多年，都还只是个见习医师…又怎么继承骑士的名号呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120533
					],
					"speakerTitle": "希奥多"
				},
				{
					"id": 100120533,
					"content": "咳…医师也好，骑士也罢，不都一样是在保护大家吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120534
					],
					"speakerTitle": "阿多诺"
				},
				{
					"id": 100120534,
					"content": "在我心里，你一直配得上「仁蔼」的称号…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120535
					],
					"speakerTitle": "阿多诺"
				},
				{
					"id": 100120535,
					"content": "…不，我其实做过很多错事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120536
					],
					"speakerTitle": "希奥多"
				},
				{
					"id": 100120536,
					"content": "接下来…还要去做一件更大的错事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120537
					],
					"speakerTitle": "希奥多"
				},
				{
					"id": 100120537,
					"content": "…这么轻易就答应他了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120538
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 100120538,
					"content": "不然呢？难道还要他打份报告让我批准？这可饶了我们吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120539
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 100120539,
					"content": "我知道阿多诺在他心里的分量，所以也相信这句誓言的重量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120540
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 100120540,
					"content": "从前也有个家伙，用骑士的名义向我父亲承诺过许多事，却在最后背叛了他们的友情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120541
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 100120541,
					"content": "「歪曲的执念和时间的变迁，会让朋友变成敌人，就像风改变它的方向那样简单。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120542
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 100120542,
					"content": "…是克利普斯说过的话？真让人怀念。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120543
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 100120543,
					"content": "你们从前…都互相认识？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120544
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100120544,
					"content": "三个意气风发的年轻人，曾一起畅想过各自的未来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120545
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 100120545,
					"content": "一名想成为骑士的富家{RUBY#[D]克利普斯}少爷，最后继承了酒庄的生意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120546
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 100120546,
					"content": "一个总是坏规矩的愣头{RUBY#[S]法尔伽}青，最后统领了整个骑士团。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120547
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 100120547,
					"content": "最后那一{RUBY#[S]伊洛克}位…既没有获得向往的财富，也没有获得憧憬的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120548
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 100120548,
					"content": "只有执念，日复一日，堆积成塔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120549,
						100120550
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 100120549,
					"content": "向往变成了执念…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100120551
					]
				},
				{
					"id": 100120551,
					"content": "这就是伊洛克…被「博士」趁虚而入的原因吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120552
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100120552,
					"content": "不管那个家伙对他说了什么，做出选择的都是伊洛克自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120553
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 100120553,
					"content": "理解他的想法不代表怜悯他，更不代表，我会重蹈什么覆辙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120554
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 100120554,
					"content": "这一次，我一定会看住我的部下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120555
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 100120555,
					"content": "不——不好啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120556
					],
					"speakerTitle": "列兹伯格"
