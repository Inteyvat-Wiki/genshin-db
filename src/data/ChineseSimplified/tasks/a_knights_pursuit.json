					}
				]
			},
			"dialogs": [
				{
					"id": 100120201,
					"content": "嘿！阿多诺爷爷！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100120202,
					"content": "哦哦，是小派蒙和荣誉骑士呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120203
					],
					"speakerTitle": "阿多诺"
				},
				{
					"id": 100120203,
					"content": "您已经没事了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100120204
					]
				},
				{
					"id": 100120204,
					"content": "哈哈，没事了，昨天本来就没真受伤，请希奥多帮我看了看，就更没事了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120205
					],
					"speakerTitle": "阿多诺"
				},
				{
					"id": 100120205,
					"content": "我这把老骨头现在还能到处乱跑，也多亏了他平时帮忙调理呀。要不然，怕是早就埋进土里咯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120206
					],
					"speakerTitle": "阿多诺"
				},
				{
					"id": 100120206,
					"content": "希奥多…就是那位第八小队的见习医师？看不出来他居然这么厉害…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100120207,
					"content": "虽然他曾经立志成为在前线奋战的骑士，但或许医师，才是更适合他的道路吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120208
					],
					"speakerTitle": "阿多诺"
				},
				{
					"id": 100120208,
					"content": "嗨，先不说这个了，你们过来是想找洛恩吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120209
					],
					"speakerTitle": "阿多诺"
				},
				{
					"id": 100120209,
					"content": "嗯，他昨天试过「模拟训练泡」之后就没影了，在哪都找不到他…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100120210,
					"content": "他有回来过吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100120211
					]
				},
				{
					"id": 100120211,
					"content": "嗯，他早上确实丢了张字条过来…说是想为昨天的事道歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120212
					],
					"speakerTitle": "阿多诺"
				},
				{
					"id": 100120212,
					"content": "他承认昨天都是在演戏，也无法忍受枯燥的日常，但作为代替…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120213
					],
					"speakerTitle": "阿多诺"
				},
				{
					"id": 100120213,
					"content": "「…我会去把那些碍事的魔物都杀干净。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120214
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120214,
					"content": "这么个道歉法吗？还真有他的风格。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120215,
						100120216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100120215,
					"content": "洛恩自己去找魔物了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100120217
					]
				},
				{
					"id": 100120217,
					"content": "嗯…寻常魔物对他构不成什么威胁，但我有些担心，他像昨天那样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120218
					],
					"speakerTitle": "阿多诺"
				},
				{
					"id": 100120218,
					"content": "能有你们照看一下，就再好不过了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120219
					],
					"speakerTitle": "阿多诺"
				},
				{
					"id": 100120219,
					"content": "嗯，我会留意的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 100120216,
					"content": "需不需要我们去看看他？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100120217
					]
				}
			]
		},
		{
			"id": 1001203,
