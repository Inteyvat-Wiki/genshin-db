						],
						"pointId": 16758
					}
				]
			},
			"dialogs": [
				{
					"id": 100120301,
					"content": "稍早之前…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						100120302
					]
				},
				{
					"id": 100120302,
					"content": "最后一只…可要让我好好尽兴呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120303
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120303,
					"content": "——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120304
					],
					"speakerTitle": "魔物"
				},
				{
					"id": 100120304,
					"content": "…嗯？谁！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120305
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120305,
					"content": "……！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120306
					],
					"speakerTitle": "魔物"
				},
				{
					"id": 100120306,
					"content": "嘁…逃跑了吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120307
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120307,
					"content": "——没想到一位酒庄老板，居然对猎杀魔物这么上心？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120308
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120308,
					"content": "还是说你追猎的目标，不只是魔物？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120309
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120309,
					"content": "那你想清除的，难道也只有「魔物」而已吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120310
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 100120310,
					"content": "以之前现场被清理的程度来看，可「什么」都没被留下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120311
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 100120311,
					"content": "哦，这我还是头一次听说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120312
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120312,
					"content": "那我们不妨一起检查一下这里的魔物，看看它们究竟有什么异常，值得这么多人关注。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120313
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 100120313,
					"content": "…算啦，我还是去追剩下那头漏网之鱼吧。调查什么的，还是不太适合我呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120314
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120314,
					"content": "再会了，迪卢克…「前辈」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120315
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120315,
					"content": "…在你们来之前发生的事，差不多就是这些了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120316
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 100120316,
					"content": "洛恩那家伙…葫芦里到底卖的什么药？我都有点想把「扛揍骑士」给升级成「欠揍骑士」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120317,
						100120318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100120317,
					"content": "所以这些魔物怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100120319
					]
				},
				{
					"id": 100120319,
					"content": "对呀！昨天听阿多诺说…它们虽然有点古怪，但到现在也没出现过什么伤人记录？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100120320,
					"content": "一方面可能是有人一直在暗中清理它们；另一方面…似乎是因为它们在饥饿时，会优先攻击自己的同伴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120321
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 100120321,
					"content": "攻击…自己的同伴？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100120322
					]
				},
				{
					"id": 100120322,
					"content": "嗯，之前只能收到少量的目击情报，还不能确信。但留在这里的魔物残骸，身上确实有大量彼此攻击的痕迹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120323
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 100120323,
					"content": "明明结伴成群、却又自相残杀…这不像是自然产生的魔物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120324
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 100120324,
					"content": "确实诡异…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100120325
					]
				},
				{
					"id": 100120325,
					"content": "欸？可是如果这些魔物会彼此攻击，那等它们自生自灭不就行了吗？为什么还要这么提防？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120326
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100120326,
					"content": "因为这种身具「乌萨血肉」的魔物，不止出现过一次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120327
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 100120327,
					"content": "——法尔伽！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120328
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100120328,
					"content": "哟，真巧啊，荣誉骑士，派蒙，还有迪卢克。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120329
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 100120329,
					"content": "…看来骑士团对这次的异常，并非一无所知。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120330
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 100120330,
					"content": "嗯…伊洛克的悲剧，决不能、也不会再上演一次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120331
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 100120331,
					"content": "你刚才说的…是「乌萨血肉」？这也跟那个伊洛克有关吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120332
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100120332,
					"content": "为了谋取超凡的力量，伊洛克曾经跟多托雷的切片合谋，从魔龙乌萨的血肉中提取蕴含其力量的血清。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120333
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 100120333,
					"content": "在我们决定清算伊洛克的时候，他跟他的党羽都注射了那种血清…给骑士团造成过不小的麻烦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120334
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 100120334,
					"content": "力量大增、嗜血成性，陷入疯狂之时，甚至会彼此攻击。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120335
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 100120335,
					"content": "讽刺的是，伊洛克最后没能控制住那份力量，不仅向着自己的党羽挥剑，也在疯狂中走向了自毁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120336
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 100120336,
					"content": "魔龙乌萨…究竟是什么来头？能有这么可怕的力量？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120337,
						100120338
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100120337,
					"content": "听说它从千年前就已存在…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100120339
					]
				},
				{
					"id": 100120339,
					"content": "不错，是有这么回事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120340
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 100120340,
					"content": "那…那当初为什么只是把它封印了？难道连当初的大团长也杀不死它吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120341
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100120341,
					"content": "不，这是因为…传说中的魔龙乌萨，曾是一位「天使」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120342
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 100120342,
					"content": "——啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120343
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100120343,
					"content": "——啊？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100120344
					]
				},
				{
					"id": 100120344,
					"content": "听说在很久很久以前…众天使都曾面临一道两难的选择…而乌萨在那时做出的选择，是留下自己的「力量」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120345
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 100120345,
					"content": "失去心智，空余力量的天使，仍向往着人类的城邦。却已不知道自己只是靠近，就会毁灭无数生命…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120346
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 100120346,
					"content": "所以，当初的温妮莎才做出了将它封印的决定？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120347
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 100120347,
					"content": "嗯。但乌萨又在「博士」的诱导下再度苏醒…这确实是骑士团的失察，我不会回避这一点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120348
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 100120348,
					"content": "比起追究往日的责任…还是尽早根除眼前的祸患更重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120349
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 100120349,
					"content": "——魔龙乌萨的血肉，为什么会再次出现在这些魔物身上？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120350
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 100120350,
					"content": "…必须承认，伊洛克曾是被我们寄予厚望的骑士，很清楚骑士团的手段。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120351
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 100120351,
					"content": "他在伏诛之前，就已经销毁了所有关于实验地点的情报。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120352
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 100120352,
					"content": "我们至今都没能找到实验材料的所在。这其中，恐怕也少不了那个切片的协助吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120353
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 100120353,
					"content": "#但现在，多托雷所有的后手，都已在须弥被{NICKNAME}解决，我相信这你也有所耳闻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120354
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 100120354,
					"content": "据我们推测，他的切片当初留在蒙德的某些「隐蔽手段」，也随之失效了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120355
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 100120355,
					"content": "啊，所以那些魔物，都是从那个什么实验地点里跑出来的吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120356
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100120356,
					"content": "恐怕不止如此——还有人重启了过去的实验吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120357
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 100120357,
					"content": "（过去的实验…乌萨的血肉…天使的力量…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100120358
					]
				},
				{
					"id": 100120358,
					"content": "（难道说…昨天在洛恩身上感觉到的力量…就是…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100120359
					]
				},
				{
					"id": 100120359,
					"content": "你也有所察觉了吧？就在昨天那场风波里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120360
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 100120360,
					"content": "嗯，那时候…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100120361
					]
				},
				{
					"id": 100120361,
					"content": "所以，洛恩有可能为了非凡的力量，染指了禁忌的实验？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120362
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 100120362,
					"content": "他…应该不是这么坏的人吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120363
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100120363,
					"content": "力量、财富、权力…有太多理由，能让一个「好人」，变成「坏人」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120364
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 100120364,
					"content": "不管是乌萨还是伊洛克…在他们做出那个选择之前，都不是你想象中的「坏人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120365
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 100120365,
					"content": "但无论洛恩的出发点是什么，我都有义务在他彻底走远之前，把他给拉回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120366
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 100120366,
					"content": "那…现在怎么办，要继续暗中调查吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120367
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100120367,
					"content": "不必这么麻烦，这就是我今天来荆夫港的目的——直接去找他问个清楚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120368
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 100120368,
					"content": "…狡猾的家伙，还挺能逃呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120369
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120369,
					"content": "现在…还能再往哪跑？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120370
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120370,
					"content": "喂——洛恩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120371
					],
					"speakerTitle": "希奥多"
				},
				{
					"id": 100120371,
					"content": "现在不是清理实验体的时候了！骑士团已经有动作了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120372
					],
					"speakerTitle": "希奥多"
				},
				{
					"id": 100120372,
					"content": "…哼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120373
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120373,
					"content": "今天荆夫港里出现了好多我不认识的骑士…是昨天的测试暴露了？还是有被抓到的实验体？难道说他们已经发现…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120374
					],
					"speakerTitle": "希奥多"
				},
				{
					"id": 100120374,
					"content": "迟早的事而已，不如说能拖上这么久，已经算我们走运了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120375
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120375,
					"content": "呵…平时作为队友有多可靠，作为对手就有多棘手啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120376
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120376,
					"content": "那现在怎么办！得快点躲起来吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120377
					],
					"speakerTitle": "希奥多"
				},
				{
					"id": 100120377,
					"content": "…现在躲起来的话，回头就再难接近我们的目标了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120378
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120378,
					"content": "既然你还能跑过来报信，就说明骑士团没彻底确定我们的嫌疑，趁这机会放手一搏吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120379
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120379,
					"content": "就趁现在，再拿我做一次实验。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120380
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120380,
					"content": "现在？但之前的问题都还…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120381
					],
					"speakerTitle": "希奥多"
				},
				{
					"id": 100120381,
					"content": "有什么好犹豫的？我从一开始就说了，我跟你可不一样，我做这些都是为了自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120382
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120382,
					"content": "想要掌握超凡的力量，就必须承担超凡的风险…我早就做好这个觉悟了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120383
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120383,
					"content": "可是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120384
					],
					"speakerTitle": "希奥多"
				},
				{
					"id": 100120384,
					"content": "还可是什么？动作快点。别告诉我，你忘了自己的目标。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120385
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120385,
					"content": "……！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120386
					],
					"speakerTitle": "希奥多"
				},
				{
					"id": 100120386,
					"content": "——咳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120387
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120387,
					"content": "不行！还是不行！…是剂量不够？还是浓度不足？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120388
					],
					"speakerTitle": "希奥多"
				},
				{
					"id": 100120388,
					"content": "难道说…根本就不存在完美的结果…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120389
					],
					"speakerTitle": "希奥多"
				},
				{
					"id": 100120389,
					"content": "洛恩！还是先躲起来吧！我们再收集一些魔物来做实验…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120390
					],
					"speakerTitle": "希奥多"
				},
				{
					"id": 100120390,
					"content": "…不行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120391
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120391,
					"content": "躲？你以为骑士团还会给我们多少时间？我们从一开始…就只能赌这点时间差。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120392
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120392,
					"content": "现在逃跑就坐实了我们的嫌疑，往后只要一露面就会被骑士团盯上，那还怎么接近目标？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120393
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120393,
					"content": "那…现在还能怎么办？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120394
					],
					"speakerTitle": "希奥多"
				},
				{
					"id": 100120394,
					"content": "…趁今晚，把目标给劫出来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120395
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120395,
					"content": "就让那个目标…陪着我们一起下「地狱」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120338,
					"content": "还跟初代大团长交过手？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100120339
					]
				},
				{
					"id": 100120318,
					"content": "值得你们这么在意？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100120319
					]
				}
			]
		},
