			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿多诺"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 100120101,
					"content": "唉，可惜，我已经提不动剑了，就算跟着你们去，恐怕也只会跟昨天一样碍事吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120102
					],
					"speakerTitle": "阿多诺"
				},
				{
					"id": 100120102,
					"content": "看来今天的日常工作，只有我一个人来干了呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿多诺"
				}
			]
		},
		{
			"id": 1001202,
			"completionStepIds": [
				1001202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1001202",
							"2"
						],
						"stepId": 1001202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿多诺"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							3502.762,
