				"points": []
			},
			"dialogs": [
				{
					"id": 722700101,
					"content": "我乃末代地走官·大门。珊瑚宫之勇者，我认可你挑战的荣誉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722700102
					],
					"speakerTitle": "大门"
				},
				{
					"id": 722700102,
					"content": "勇武即是不择手段战胜一切敌人的能力。你只要打败所有敌人解放「高门之火」就可以了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722700103
					],
					"speakerTitle": "大门"
				},
				{
					"id": 722700103,
					"content": "顺带一提，此处的敌人皆是虚像。乃是阳炎幻法与你自己内心所知晓的强敌之印象互摄而成的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722700104
					],
					"speakerTitle": "大门"
				},
				{
					"id": 722700104,
					"content": "尽管如此，稍有不慎还是会受伤甚至被打垮的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722700105
					],
					"speakerTitle": "大门"
				},
				{
					"id": 722700105,
					"content": "我将在上方三界塔处等候你完成挑战。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大门"
				}
			]
		},
