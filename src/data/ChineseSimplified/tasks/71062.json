			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"安东",
					"拉多米尔",
					"达尼拉",
					"提莫尔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710621101,
					"content": "你们回来了，怎么样，有什么新的消息吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621102
					],
					"speakerTitle": "安东"
				},
				{
					"id": 710621102,
					"content": "补给站已经废弃了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621103
					]
				},
				{
					"id": 710621103,
					"content": "这样吗…那么，你们有找到什么东西吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621104
					],
					"speakerTitle": "安东"
				},
				{
					"id": 710621104,
					"content": "璃月港不再欢迎你们了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621105
					]
				},
				{
					"id": 710621105,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621106
					],
					"speakerTitle": "安东"
				},
				{
					"id": 710621106,
					"content": "除此之外，还有什么消息吗…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621107
					],
					"speakerTitle": "安东"
				},
				{
					"id": 710621107,
					"content": "唔…我们还找到了一封信，好像是留给你的呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710621108,
					"content": "在这里…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621109
					]
				},
				{
					"id": 710621109,
					"content": "信件在愚人众成员之间传递了一会…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710621110
					]
				},
				{
					"id": 710621110,
					"content": "啊，是彦博老弟。我明白了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621111
					],
					"speakerTitle": "安东"
				},
				{
					"id": 710621111,
					"content": "怎么了？千岩军都撤走了？给我也看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621112
					],
					"speakerTitle": "拉多米尔"
				},
				{
					"id": 710621112,
					"content": "唉，这些家伙是怎么回事…我们是在为他们而战的！我们应该是盟友才对！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621113
					],
					"speakerTitle": "达尼拉"
				},
				{
					"id": 710621113,
					"content": "现在没有「盟友」了！我们已经断交了…准确来说是作为「愚人众」的我们，已经和璃月断交了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621131
					],
					"speakerTitle": "拉多米尔"
				},
				{
					"id": 710621131,
					"content": "这是背叛！我们被璃月人背叛了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621132
					],
					"speakerTitle": "提莫尔"
				},
				{
					"id": 710621132,
					"content": "或许对璃月人来说恰恰相反呢？是我们，作为「愚人众」的我们背叛了他们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621114
					],
					"speakerTitle": "拉多米尔"
				},
				{
					"id": 710621114,
					"content": "开什么玩笑…我们是来保护璃月人的！还记得大尉在出发前说的话吗？这次远征无关任何小算盘和阴谋诡计！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621115
					],
					"speakerTitle": "达尼拉"
				},
				{
					"id": 710621115,
					"content": "但是拦不住小算盘和阴谋诡计上了我们的身…这事不是我们能控制得了的，达尼拉兄弟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621116
					],
					"speakerTitle": "提莫尔"
				},
				{
					"id": 710621116,
					"content": "好了，我明白了。呼…我决定了，我们需要撤离这里，越快越好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621117
					],
					"speakerTitle": "安东"
				},
				{
					"id": 710621117,
					"content": "没关系，责任全由我承担就好。如果我们之中存在逃兵…如果有逃兵让第九连队蒙羞，那个逃兵就是我，只有我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621118
					],
					"speakerTitle": "安东"
				},
				{
					"id": 710621118,
					"content": "达尼拉说得对，我们是来保护璃月人免遭黑灾侵染的，我们不能就这么灰溜溜离开。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621119
					],
					"speakerTitle": "拉多米尔"
				},
				{
					"id": 710621119,
					"content": "现在是谈个人自尊的时间吗，米尔卡？你还没看出来吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621120
					],
					"speakerTitle": "安东"
				},
				{
					"id": 710621120,
					"content": "璃月人不需要我们保护，璃月人也不欢迎我们！他们甚至击败了我们那些自鸣得意的战友！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621121,
						710621122
					],
					"speakerTitle": "安东"
				},
				{
					"id": 710621121,
					"content": "没错，是你们辜负了璃月的信任。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621123
					]
				},
				{
					"id": 710621123,
					"content": "我们准备撤离吧，一定要尽可能悄无声息地走，不要惊动了本地的千岩军。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621124
					],
					"speakerTitle": "安东"
				},
				{
					"id": 710621124,
					"content": "大尉说我们是抱着不再回家的觉悟来的。我们至少也要…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621125
					],
					"speakerTitle": "拉多米尔"
				},
				{
					"id": 710621125,
					"content": "大尉一样说过，他不会让任何人的牺牲毫无意义！大尉一样说过，他不希望我把连队断送掉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621126
					],
					"speakerTitle": "安东"
				},
				{
					"id": 710621126,
					"content": "至少我们还活着，就意味着第九连队的番号还存在，明白了吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621127
					],
					"speakerTitle": "安东"
				},
				{
					"id": 710621127,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621128
					],
					"speakerTitle": "拉多米尔"
				},
				{
					"id": 710621128,
					"content": "明白，连长。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621129
					],
					"speakerTitle": "拉多米尔"
				},
				{
					"id": 710621129,
					"content": "好了，还有人有任何问题吗？我不想听到任何反对意见。解散！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621130
					],
					"speakerTitle": "安东"
				},
				{
					"id": 710621130,
					"content": "#无论如何，{NICKNAME}，感谢你们的帮忙。这些摩拉和物资请你收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安东"
				},
				{
					"id": 710621122,
					"content": "你们还是考虑一下自己的后路吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621123
					]
				}
			]
		},
