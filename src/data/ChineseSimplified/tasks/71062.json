			"dialogs": [
				{
					"id": 710620128,
					"content": "然后呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620131
					]
				},
				{
					"id": 710620131,
					"content": "之后我们会撤离这里，秋毫无犯，我保证。我…以第九特种连队的名誉，以捍卫至冬国土的祖先之名保证。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620132
					],
					"speakerTitle": "安东"
				},
				{
					"id": 710620132,
					"content": "唉…这个小可怜蛋，都饿成什么样了…真可怜呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620133
					],
					"speakerTitle": "提莫尔"
				},
				{
					"id": 710620133,
					"content": "别说了，你也好不到哪里去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620134
					],
					"speakerTitle": "拉多米尔"
				},
				{
					"id": 710620134,
					"content": "我们进来的时候是六十四人，六十四个人！现在只剩下了四个饿鬼，我们还能密谋什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620135
					],
					"speakerTitle": "达尼拉"
				},
				{
					"id": 710620135,
					"content": "哇…你们是怎么把自己搞到这么惨的呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620136
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710620136,
					"content": "那是后话了…但如果没有食物，第九连队最后的编制成员就危在旦夕了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安东"
				}
			]
		},
