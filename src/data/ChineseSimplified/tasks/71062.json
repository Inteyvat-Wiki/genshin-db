			"dialogs": [
				{
					"id": 710620137,
					"content": "先告诉我你们的目的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620140
					]
				},
				{
					"id": 710620140,
					"content": "这么说吧，不论你们怀着怎样的疑虑…我们的任务只针对层岩巨渊的灾难之源。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620141
					],
					"speakerTitle": "安东"
				},
				{
					"id": 710620141,
					"content": "什么灾难呀…层岩巨渊不是还好好的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620142
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710620142,
					"content": "五百年前的灾变，只是战争的前奏而已。对抗漆黑大敌的战争一直持续着，而战场之一就在我们的脚下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620143
					],
					"speakerTitle": "安东"
				},
				{
					"id": 710620143,
					"content": "唉，我们的上士连长都饿到说大话了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620144
					],
					"speakerTitle": "达尼拉"
				},
				{
					"id": 710620144,
					"content": "他一直都爱说大话…可说胡话还是第一次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620145
					],
					"speakerTitle": "提莫尔"
				},
				{
					"id": 710620145,
					"content": "算啦，算啦…安托哈说的是这个道理。简单来说就是…你们，璃月人，不是我们的敌人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620146
					],
					"speakerTitle": "拉多米尔"
				},
				{
					"id": 710620146,
					"content": "至少不是我们第九连队在这场行动中的敌人…不过，另一些被打散的弟兄就不一定了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620147
					],
					"speakerTitle": "安东"
				},
				{
					"id": 710620147,
					"content": "出于人道我会帮你，但下不为例。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620148
					]
				},
				{
					"id": 710620148,
					"content": "谢谢…谢谢你们，我们是不会忘记的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安东"
				}
			]
		},
