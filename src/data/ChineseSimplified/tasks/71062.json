					"安东"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710620118,
					"content": "我们什么时候是「朋友」了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620121
					]
				},
				{
					"id": 710620121,
					"content": "物资，武器，情报，或者摩拉？我们都不缺。只要你愿意帮忙，这些都可以作为报酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620122
					],
					"speakerTitle": "安东"
				},
				{
					"id": 710620122,
					"content": "瞧瞧，我们的乞丐连长大人亲自揽了最丢人的活儿…真是太好了。我们所剩无几的脸面呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620123
					],
					"speakerTitle": "提莫尔"
				},
				{
					"id": 710620123,
					"content": "你也少说几句风凉话吧，讽刺可填不饱肚子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620124
					],
					"speakerTitle": "达尼拉"
				},
				{
					"id": 710620124,
					"content": "「加入我等的行列，让军靴如雷撼动大地吧。愿随我等走向白夜极星者，我等绝对不会抛弃…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620125
					],
					"speakerTitle": "提莫尔"
				},
				{
					"id": 710620125,
					"content": "来个人让他闭嘴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620126
					],
					"speakerTitle": "安东"
				},
				{
					"id": 710620126,
					"content": "唔…虽然他们都是坏东西，但看着也蛮可怜的。都饿成这样了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710620127,
					"content": "说来丢人…但如你所见，我们这些人已经失去了战斗能力，只是想讨要些食物而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安东"
				}
			]
		},
