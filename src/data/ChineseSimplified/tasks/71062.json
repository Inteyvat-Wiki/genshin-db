						"rawParams": [
							"7106203",
							"2"
						],
						"stepId": 7106203,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_ITEM_GIVING_ACTIVED",
						"rawParams": [
							"7106202"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙",
					"安东",
					"达尼拉",
					"提莫尔",
					"拉多米尔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710620701,
					"content": "这群家伙好弱呀，三拳两脚就解决了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620702
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710620702,
					"content": "请你们停下！求你们不要再打了！只要给我们分一点食物，我们愿意听从你们任意处置！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620703
					],
					"speakerTitle": "安东"
				},
				{
					"id": 710620703,
					"content": "哼…这些家伙看起来是真的饿得受不了了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620704,
						710620705
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710620704,
					"content": "先告诉我你们的目的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620706
					]
				},
				{
					"id": 710620706,
					"content": "这么说吧，不论你们怀着怎样的疑虑…我们的任务只是针对层岩巨渊的灾难之源的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620707
					],
					"speakerTitle": "安东"
				},
				{
					"id": 710620707,
					"content": "什么灾难呀…层岩巨渊不是还好好的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620708
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710620708,
					"content": "五百年前的灾变，只是战争的前奏而已。对抗漆黑大敌的战争一直持续着，战场之一就在我们的脚下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620709
					],
					"speakerTitle": "安东"
				},
				{
					"id": 710620709,
					"content": "唉，我们的上士连长都饿到说大话了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620710
					],
					"speakerTitle": "达尼拉"
				},
				{
					"id": 710620710,
					"content": "他一直都爱说大话…可说胡话还是第一次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620711
					],
					"speakerTitle": "提莫尔"
				},
				{
					"id": 710620711,
					"content": "算啦，算啦…安托哈说的不是没有道理，你们，璃月人，不是我们的敌人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620712
					],
					"speakerTitle": "拉多米尔"
				},
				{
					"id": 710620712,
					"content": "至少不是我们这支部队的敌人…另一些被打散的弟兄就不一定了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620713
					],
					"speakerTitle": "安东"
				},
				{
					"id": 710620713,
					"content": "好吧…我会帮你，但下不为例。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 710620705,
					"content": "我该怎么信任你们？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620706
					]
				}
			]
		},
		{
			"id": 7106209,
			"completionStepIds": [
				7106205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7106205",
							"2"
						],
						"stepId": 7106205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"安东",
					"达尼拉",
					"提莫尔",
					"拉多米尔",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710620901,
					"content": "唉…真是抱歉。我们的指挥网络发生了一点小小的…故障…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620902
					],
					"speakerTitle": "安东"
				},
				{
					"id": 710620902,
					"content": "「小小的」！「故障」？！我们在手足相残了！我们在眼睁睁看着外人把自己的战友打跑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620903
					],
					"speakerTitle": "达尼拉"
				},
				{
					"id": 710620903,
					"content": "否则呢？我们要让他们把我们打跑，抢走我们的食物吗？我建议你把嘴里的东西都咽下去再说话！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620904
					],
					"speakerTitle": "提莫尔"
				},
				{
					"id": 710620904,
					"content": "安托哈，不要轻描淡写了…我们的指挥网络被摧毁了，完蛋了。尉官以上的所有军官都牺牲或失踪了…除了撤退别无选择。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620905
					],
					"speakerTitle": "拉多米尔"
				},
				{
					"id": 710620905,
					"content": "但很多人还不愿意撤退…他们宁愿守着长官的遗物战到最后一人倒下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620906
					],
					"speakerTitle": "安东"
				},
				{
					"id": 710620906,
					"content": "是饿到最后一人…按照合作协议，上面给我们输送食物和命令，但我们很久没有接到上面的消息了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620907
					],
					"speakerTitle": "达尼拉"
				},
				{
					"id": 710620907,
					"content": "我们对愚人众和执行官大人的忠诚不容质疑是没错，但我们也不是傻子…至于现在这种情况，唯有撤离才是上策。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620908
					],
					"speakerTitle": "提莫尔"
				},
				{
					"id": 710620908,
					"content": "所以你们有何打算？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620909
					]
				},
				{
					"id": 710620909,
					"content": "嗯…我知道，这事可能与你无关。如果你想转头就走也悉听尊便，但我们确实陷入了绝境，急需你的帮助…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620910,
						710620912
					],
					"speakerTitle": "安东"
				},
				{
					"id": 710620910,
					"content": "我需要考虑一下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620911
					]
				},
				{
					"id": 710620911,
					"content": "好吧…前路请注意安全。还留在周围的其他战友们就不会像我们这样友好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620913
					],
					"speakerTitle": "安东"
				},
				{
					"id": 710620913,
					"content": "虽然告知你很不合适，但…在靠近地面的地方有一处补给站。负责为我们转运物资，有时也负责传送命令。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620914
					],
					"speakerTitle": "安东"
				},
				{
					"id": 710620914,
					"content": "此前派出了几位战友上去请求调拨食物，但他们一直没有回来…我担负不起再一次冒险了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620915
					],
					"speakerTitle": "安东"
				},
				{
					"id": 710620915,
					"content": "而补给站那边也很久没有下来过人了…我们希望你能替我们前去侦查一下他们的情况。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620916,
						710620917
					],
					"speakerTitle": "安东"
				},
				{
					"id": 710620916,
					"content": "请让我稍事考虑。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620918
					]
				},
				{
					"id": 710620918,
					"content": "拜托你这种事情实在抱歉，但我们需要了解地面节点的情况…否则不好擅自行动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620919
					],
					"speakerTitle": "安东"
				},
				{
					"id": 710620919,
					"content": "好啦！不要说那么多难懂的话啦！我们路过的时候会注意的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710620917,
					"content": "我会帮忙的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620918
					]
				},
				{
					"id": 710620912,
					"content": "你需要我帮什么忙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620913
					]
				}
			]
		},
		{
			"id": 7106210,
