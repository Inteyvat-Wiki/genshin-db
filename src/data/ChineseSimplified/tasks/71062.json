			"dialogs": [
				{
					"id": 710621001,
					"content": "无论如何，多谢你分享食物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621002
					],
					"speakerTitle": "安东"
				},
				{
					"id": 710621002,
					"content": "我们会想办法离开这里的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安东"
