				"points": []
			},
			"dialogs": [
				{
					"id": 710620119,
					"content": "我凭什么帮你们？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620121
					]
				},
				{
					"id": 710620121,
					"content": "物资，武器，情报，或者摩拉？我们都不缺。只要你愿意帮忙，这些都可以作为报酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620122
					],
					"speakerTitle": "安东"
				},
				{
					"id": 710620122,
					"content": "瞧瞧，我们的乞丐连长大人亲自揽了最丢人的活儿…真是太好了。我们所剩无几的脸面呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620123
					],
					"speakerTitle": "提莫尔"
				},
				{
					"id": 710620123,
					"content": "你也少说几句风凉话吧，讽刺可填不饱肚子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620124
					],
					"speakerTitle": "达尼拉"
				},
