	"talks": [
		{
			"id": 7106201,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7106201",
							"2"
						],
						"stepId": 7106201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"安东"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710620101,
					"content": "呼…如果你们在赶路的话抱歉打扰，我是安东·梅利尼科夫上士，第九连队的…代理连长。叫我安东就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620102
					],
					"speakerTitle": "安东"
				},
				{
					"id": 710620102,
					"content": "这几位，分别是达尼拉、提莫尔、拉多米尔和…呃，罗曼斯基，他现在不在这里，他在…卫生营地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620103
					],
					"speakerTitle": "安东"
				},
				{
					"id": 710620103,
					"content": "没有罗曼斯基了，也没有卫生营地了，安托哈…他没撑过今早。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620104
					],
					"speakerTitle": "达尼拉"
				},
				{
					"id": 710620104,
					"content": "达尼拉，达尼拉…我说过多少次了，我是连长，叫我安东上士！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620105
					],
					"speakerTitle": "安东"
				},
				{
					"id": 710620105,
					"content": "哈！连长！上士！安托哈你这家伙…自从大尉失踪以后，你这狐假虎威的家伙倒是把大尾巴竖起来了！哈！哈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620106
					],
					"speakerTitle": "提莫尔"
				},
				{
					"id": 710620106,
					"content": "够了，提莫尔老弟…你饿坏脑子了。省省体力吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620107
					],
					"speakerTitle": "拉多米尔"
				},
				{
					"id": 710620107,
					"content": "是「代理连长」，安托哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620149
					],
					"speakerTitle": "达尼拉"
				},
				{
					"id": 710620149,
					"content": "「代理连长」！「代理连长」！我们还要跟着这个拿鸡毛当令箭的绣花枕头多久？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620150
					],
					"speakerTitle": "提莫尔"
				},
				{
					"id": 710620150,
					"content": "我说，提莫尔你是饿坏脑子了，何不吃点拳头清醒一下呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620151
					],
					"speakerTitle": "拉多米尔"
				},
				{
					"id": 710620151,
					"content": "好呀，来啊！也让我喂你几脚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620152
					],
					"speakerTitle": "提莫尔"
				},
				{
					"id": 710620152,
					"content": "太好了，现在轮到把理智和耐心咽下肚子里消化殆尽了…真是太好了。耗尽了这点精神，我们剩下的能量可真的不多咯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620108
					],
					"speakerTitle": "达尼拉"
				},
				{
					"id": 710620108,
					"content": "咳咳…！给我安静！你们要打架吗？想打架的话就下去打！和黑泥巴里面冒出来的那些东西打！饿着肚子去啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620109
					],
					"speakerTitle": "安东"
				},
				{
					"id": 710620109,
					"content": "我们想要活下去，想要撤离这里，就必须团结一致！不要，再让我，重复，明白？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620110
					],
					"speakerTitle": "安东"
				},
				{
					"id": 710620110,
					"content": "一、二、口号！舍我其谁！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620111
					],
					"speakerTitle": "安东"
				},
				{
					"id": 710620111,
					"content": "舍我其谁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620112
					],
					"speakerTitle": "达尼拉"
				},
				{
					"id": 710620112,
					"content": "舍我其谁…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620113
					],
					"speakerTitle": "拉多米尔"
				},
				{
					"id": 710620113,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620153
					],
					"speakerTitle": "提莫尔"
				},
				{
					"id": 710620153,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620114
					],
					"speakerTitle": "安东"
				},
				{
					"id": 710620114,
					"content": "呃，呵呵…朋友，你也看到了，我们稍微有点…咳咳，不在战斗状态。毕竟…最近遇到了一点小小的挫折。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620115
					],
					"speakerTitle": "安东"
				},
				{
					"id": 710620115,
					"content": "哼…「小小的挫折」！倒是跟大尉学得挺像…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620116
					],
					"speakerTitle": "拉多米尔"
				},
				{
					"id": 710620116,
					"content": "大尉不在这里，我就是连长！省省你的力气，给我闭嘴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620117
					],
					"speakerTitle": "安东"
				},
				{
					"id": 710620117,
					"content": "抱歉…朋友，我们现在急需你的帮助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安东"
				}
			]
		},
