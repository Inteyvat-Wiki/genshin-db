			"dialogs": [
				{
					"id": 750360401,
					"content": "嗯，这个深度应该就可以了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750360402,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360403
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750360403,
					"content": "让我想想，要说纳塔和别的国家不一样的地方…那就是燃素了！给种子补充一下燃素说不定会有用？我们试试看吧！",
					"roleType": "TALK_ROLE_NPC",
