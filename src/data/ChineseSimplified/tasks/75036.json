			"dialogs": [
				{
					"id": 750360801,
					"content": "出来吧出来吧，小小的种子~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360802
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750360802,
					"content": "出来吧出来吧，开漂亮的小花~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360803
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750360803,
					"content": "…欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360804
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750360804,
					"content": "唔…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750360805
					]
				},
				{
					"id": 750360805,
					"content": "#啊，{NICKNAME}，燃素的能量没有了，一定是被种子好好吸收了，只是…怎么一点反应都没有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360806
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750360806,
					"content": "唔？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360807,
						750360811
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750360807,
					"content": "说不定种子只是需要时间成长。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750360808
					]
				},
				{
					"id": 750360808,
					"content": "是嘛！不过想想也是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360809
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750360809,
					"content": "蒲公英只要「呼——」地一吹就能飞出好多白色的小伞，钩钩果会挂在小狼的身上，一直跑到很远的地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360810
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750360810,
					"content": "种子的生命力都是很顽强的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360815
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750360815,
					"content": "那我们先不要打扰它了，过些时候再来看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360816
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750360816,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750360811,
					"content": "说不定种子只是被吓到了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750360812
					]
				},
				{
					"id": 750360812,
					"content": "真、真的吗？也对哦！是不是我太心急了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360813
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750360813,
					"content": "#种子又是被{REALNAME[ID(2)|SHOWHOST(true)]}挖出来，又是被飞虫偷取养分，还被怪物「轰隆隆」地打扰了一番…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360814
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750360814,
					"content": "听到有人在花田上打架，对于埋在土里的种子来说，就像听到暴风和雷声一样吓人。然后它就悄悄地缩在土里，一动也不敢动了…嗯！一定是这样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360815
					],
					"speakerTitle": "派蒙"
				}
			]
