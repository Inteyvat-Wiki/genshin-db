			},
			"dialogs": [
				{
					"id": 710890101,
					"content": "唔…好长的一封信，是志琼留下来的呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710890102,
					"content": "没错，是志琼的信…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710890103
					]
				},
				{
					"id": 710890103,
					"content": "可恶…还是找不到她人在哪里，我们先回去跟瑾武说一声吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7108902,
			"completionStepIds": [
				7108903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7108903",
							"2"
						],
						"stepId": 7108903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"瑾武"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710890201,
					"content": "瑾武姐，我们找到了这个！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710890202,
					"content": "好了，好了，不要着急。你们找到了什么？和志琼的下落有关吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890203
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710890203,
					"content": "是她留下的信，她去了层岩巨渊的更深处。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710890204
					]
				},
				{
					"id": 710890204,
					"content": "…谢谢，请让我看看她写了什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890205
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710890205,
					"content": "瑾武仔细地阅读了志琼的信。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710890206
					]
				},
				{
					"id": 710890206,
					"content": "这个孩子…我从没有想过这么宏大的问题，也不好评价她的选择。但或许…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890207
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710890207,
					"content": "或许我没能来得及重视她的发现，没能给她足够的尊重和理解吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890208
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710890208,
					"content": "明明没有她的地图的话，后续的勘察根本难以完成…但我一直只顾着担心她的身体情况，却无视了她的努力与拼命达成的成就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890209
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710890209,
					"content": "毕竟她与我们这些矿工从一开始就是不同的，我怎么就没有想过这点呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890210
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710890210,
					"content": "她只是不想被遗忘。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710890211
					]
				},
				{
					"id": 710890211,
					"content": "对我们这些从未被神审视的普通人来说，谁又不是呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890212
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710890212,
					"content": "谁又不是呢…但谁像她这样执着呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890213
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710890213,
					"content": "但一旦想到自己曾在某一刻放弃了想让自己变得伟大的执着…一旦意识到自己习惯了日复一日的平凡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890214
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710890214,
					"content": "也就更无颜面评判志琼这样的年轻人了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑾武"
				}
			]
		}
	]
}