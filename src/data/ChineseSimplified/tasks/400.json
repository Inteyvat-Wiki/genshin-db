	"talks": [
		{
			"id": 39607,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"40001",
							"2"
						],
						"stepId": 40001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"温迪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3960701,
					"content": "想多聊些什么的话，就趁现在聊吧。因为吟游诗人，可不会总在一个地方驻唱的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960702,
						3960707,
						3960715,
						3960727,
						3960741
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960702,
					"content": "关于特瓦林…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960703
					]
				},
				{
					"id": 3960703,
					"content": "特瓦林…到最后也还记得「四风守护」的职责。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960704
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960704,
					"content": "所以，我也并不打算强行卸下他身上的责任、把我理解的「自由」强塞给他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960705
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960705,
					"content": "——而是希望，特瓦林能自己选择、自己理解，何为自由。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960706
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960706,
					"content": "因为我在成神之前，也是这样被一个朋友…教导了「何为自由」的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960701
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960707,
					"content": "关于深渊教团…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960708
					]
				},
				{
					"id": 3960708,
					"content": "嗯？你说凯亚的情报…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960709
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960709,
					"content": "#…原来如此，深渊教团里有一位「{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYD|INFO_FEMALE_PRONOUN_GIRLD]}」，主导了腐化特瓦林的计划？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960710
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960710,
					"content": "#看来是想把特瓦林改造成深渊的战争兵器吧。话说回来，我可从没听说过，深渊教团里有什么「{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYD|INFO_FEMALE_PRONOUN_GIRLD]}」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960711,
						3960712
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960711,
					"content": "看来那不是教团的古老传承。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960713
					]
				},
				{
					"id": 3960713,
					"content": "我想也是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960714
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960714,
					"content": "#但最近才出现的「{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYD|INFO_FEMALE_PRONOUN_GIRLD]}」，又为什么能走上统领深渊教团的位置呢…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960701
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960712,
					"content": "看来是最近才出现的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960713
					]
				},
				{
					"id": 3960715,
					"content": "关于「女士」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960716
					]
				},
				{
					"id": 3960716,
					"content": "刚才的愚人众执行官，抢走「神之心」以后，马上就离开了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960717
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3960717,
					"content": "这是为了避免出现「骑士团的目击证人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960718
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960718,
					"content": "毕竟这种事要是留下把柄，就等于公开毁灭与西风骑士团的外交关系了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960719
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960719,
					"content": "做出这种事来，却还好意思继续当蒙德的盟友吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960720
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3960720,
					"content": "唉…面对深渊教团的威胁，人类的七国本该结成联盟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960721
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960721,
					"content": "「愚人众」拥有七国最强的武力，却用来盗窃天空之琴、觊觎神力、借龙灾对骑士团施压…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960722
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960722,
					"content": "啊，说到「天空之琴」…那时，好像听迪卢克提过这个名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960723
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3960723,
					"content": "他说，「愚人众」能够横行七国、威胁西风骑士团，完全是由于这十一位执行官的存在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960724
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3960724,
					"content": "是的，就像我刚才说的，他们被冰之神赐予了权柄，获得了超越凡人的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960725
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960725,
					"content": "「冰之女皇」…五百年没见了，她究竟在想什么呢？又在计划着什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960726
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960726,
					"content": "这件事的答案，或许也会对你寻找七神的旅途，产生未知的影响吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960701
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960727,
					"content": "关于神灵…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960728
					]
				},
				{
					"id": 3960728,
					"content": "刚才说过，「神之眼」的拥有者，被世界称作「原神」，拥有登上天空岛的资格。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960729
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960729,
					"content": "「神之心」是更高位的元素控制中枢，是七神之座的象征。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960730
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960730,
					"content": "#对不起，我不知道是七神中的哪一位，带走了你的{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTER]}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960731
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960731,
					"content": "呀，话说回来，身为七神之一，我自己的嫌疑都还没洗清…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960732,
						3960734
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960732,
					"content": "你长得和那个神一点都不像。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960733
					]
				},
				{
					"id": 3960733,
					"content": "可是，「卖唱的」只是化身形象，不能作为判断依据——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960734
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3960734,
					"content": "相处这么久，不用继续怀疑了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960735
					]
				},
				{
					"id": 3960735,
					"content": "#啊哈哈，我们确实是很好的搭档呢。等你找回{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTER]}，有没有兴趣来当新的「四风守护」啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960736
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960736,
					"content": "也许…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960737
					]
				},
				{
					"id": 3960737,
					"content": "#嗯？{NICKNAME}，你好像不太热衷的样子？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960738
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3960738,
					"content": "那么卖唱的！如果当了「四风守护」就有民众供奉好吃的话，不如考虑一下…我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960739
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3960739,
					"content": "哈哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960701
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960741,
					"content": "没别的事了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960742
					]
				},
				{
					"id": 3960742,
					"content": "那么，就往<color=#00E1FFFF>璃月</color>去吧。错过今年的「请仙典仪」的话，就要再等一整年咯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "温迪"
				}
			]
		}
	]
}