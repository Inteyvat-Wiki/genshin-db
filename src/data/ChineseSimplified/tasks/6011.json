			"dialogs": [
				{
					"id": 60110501,
					"content": "老板，那个…就是那个…我还是需要探探你的口风…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110502
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 60110502,
					"content": "如果以后我们又要和其他人合作，那「秘闻馆」究竟应该出几成的力啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110503
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 60110503,
					"content": "呵呵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110504
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 60110504,
					"content": "一成？！是不是太低了点…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110505
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 60110505,
					"content": "再猜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110506
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 60110506,
					"content": "不出力？！那不就成了挂名的嘛？还不如散伙呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110507
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 60110507,
					"content": "唉，雅珂达。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110508
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 60110508,
					"content": "我的意思是，不设上限，不设下限。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110509
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 60110509,
					"content": "噢！不愧是老板，想的就是深远…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110510
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 60110510,
					"content": "不对啊，这不是说了跟没说一样嘛！所以到底是几成啦，老板！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雅珂达"
				}
			]
