							1547.907,
							258.402,
							9321.152
						],
						"pointId": 13088
					}
				]
			},
			"dialogs": [
				{
					"id": 60110201,
					"content": "这位先生，就像是一座灯塔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110202
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60110202,
					"content": "他理所当然地存在于这里，为周围的人提供光亮，施予恩惠。但人们习惯了光，就会忽视这盏灯的存在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110203
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60110203,
					"content": "渐渐地，渐渐地，他自己也这么认为。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110204
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60110204,
					"content": "「我做的事没什么大不了的，我做的还不够好，我还需要保持耐心，继续等待…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110205
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60110205,
					"content": "或许这是个悲伤的结局，但我依然为他曾照亮过他人的前路而骄傲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110206
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60110206,
					"content": "每一道由光而生的影，都会铭记它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110207
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60110207,
					"content": "真是太可惜了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60110208,
					"content": "我曾听过一个灯之妖精的故事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110209
					]
				},
				{
					"id": 60110209,
					"content": "哦，那个我也有所耳闻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110210,
						60110211
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60110210,
					"content": "对他我也想说同样的话。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110212
					]
				},
				{
					"id": 60110212,
					"content": "这样吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110213
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60110213,
					"content": "你说得对，即便是这次，我们的努力看上去也是徒劳的，猎月人还是达成了自己的目的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110214
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60110214,
					"content": "但我们依然会追逐他到最后一刻，哪怕结果仍非我们所愿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110215
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60110215,
					"content": "这就像是守墓人的工作——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110216
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60110216,
					"content": "绝非是为了令逝者复生，只是为了死地安宁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110217
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60110217,
					"content": "你能这么想那就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110218
					]
				},
				{
					"id": 60110218,
					"content": "嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110219
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60110219,
					"content": "你、你们在说什么，能解释一下吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60110220,
					"content": "气氛不太好，回去再讲给你听。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110221
					]
				},
				{
					"id": 60110221,
					"content": "好吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60110222,
					"content": "毕竟这次送葬的主角，并不是那个什么灯之妖精呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110223
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60110223,
					"content": "「执光之人，以鲜血践行荣光与正义。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110224
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60110224,
					"content": "「行迹匆匆，你我即便满身疮痍，也请片刻驻足，回望爱憎。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110225
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60110225,
					"content": "「直至深夜世界阖眼，那盏无人可见的，只为你一人的灯缓缓亮起。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110226
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60110226,
					"content": "承蒙关照，索西军士长。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60110211,
					"content": "不必对结果如此执着。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110212
					]
				}
			]
		},
