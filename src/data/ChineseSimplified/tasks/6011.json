					}
				]
			},
			"dialogs": [
				{
					"id": 60110601,
					"content": "哥伦比娅！你怎么到这里来了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60110602,
					"content": "嗯？不是你们推荐我出来走走的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110603
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60110603,
					"content": "是倒是啦，你不怕被「愚人众」发现吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60110604,
					"content": "桑多涅没兴趣抓我，其他「愚人众」现在也不会冒险来找我。他们有更棘手的问题需要解决。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110605
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60110605,
					"content": "（是指「猎月人」吗…他现在是威胁着挪德卡莱所有人的问题。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110606
					]
				},
				{
					"id": 60110606,
					"content": "好吧，出来走走总是好事，感觉怎么样？喜欢那夏镇吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110607
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60110607,
					"content": "唔…月矩力的流动有些紊乱，人们心中很不安。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110608
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60110608,
					"content": "不过…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110609
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60110609,
					"content": "不过什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110610
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60110610,
					"content": "你们上次「请客」的菜，是在这边买的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110611
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60110611,
					"content": "（在意的居然是这个吗！她该不是为了吃浆果煎肉才来的吧！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110612
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60110612,
					"content": "呃，你，你喜欢的话我们下次带你去吃就是了，还有很多在家里吃不到的好东西哟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110613
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60110613,
					"content": "…嗯？你从刚才开始就很沉默呢。是心中有什么疑问吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110614,
						60110620,
						60110625,
						60110630
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60110614,
					"content": "关于「猎月人」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110615
					]
				},
				{
					"id": 60110615,
					"content": "唔…我当时没能洞悉他的计划。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110616
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60110616,
					"content": "如今他取得了形体，力量不容小觑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110617
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60110617,
					"content": "但那力量中有一股「执念」，近乎疯狂的「执念」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110618
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60110618,
					"content": "我不清楚那执念是为月亮而来，还是为别的什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110619
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60110619,
					"content": "或许弄清这股执念的所指，也是今后对抗他的关键…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110620,
						60110625,
						60110630
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60110620,
					"content": "关于「愚人众」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110621
					]
				},
				{
					"id": 60110621,
					"content": "桑多涅的生活作息很不规律，「博士」经常使唤人，阿蕾奇诺她…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110622
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60110622,
					"content": "嗯？你想听的不是这些？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110623
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60110623,
					"content": "你去过那个试验设计局了？嗯…那个「武器」是女皇未来计划中重要的一部分。至少听起来是那样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110624
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60110624,
					"content": "你问具体是什么计划？我不关心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110614,
						60110625,
						60110630
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60110625,
					"content": "关于「飞船」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110626
					]
				},
				{
					"id": 60110626,
					"content": "若是你希望的话，我可以帮你在恒月的「月髓」中寻找。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110627
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60110627,
					"content": "但上次看过之后，我觉得你的飞船更像被刻意隐瞒起来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110628
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60110628,
					"content": "或许是有人不想让某些真相被你，被其他人知道吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110629
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60110629,
					"content": "能做到这种事的人，想必不多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110614,
						60110620,
						60110630
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60110630,
					"content": "没什么要问的了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110631
					]
				},
				{
					"id": 60110631,
					"content": "我…依旧想回到那个属于我的月亮上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110632
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60110632,
					"content": "那里是埋藏着答案的地方，那里…才是我的「家」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				}
			]
		},
