						],
						"pointId": 13576
					}
				]
			},
			"dialogs": [
				{
					"id": 60110801,
					"content": "菲林斯？难得你会到我的蛋卷工坊来。感兴趣的话你就自由参观吧，我忙着呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110802
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 60110802,
					"content": "我是来探望您的，可敬的爱诺小姐。我给您带了些镇上的点心，传统黄油口味，您看放在哪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110803
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60110803,
					"content": "嘘！…别给伊涅芙听见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110804
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 60110804,
					"content": "…你找我有什么事？该不会想说…我的大炮做了坏事，从今往后的狂猎问题都要由执灯人接管了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110805
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 60110805,
					"content": "用我们谁都没有提前预料到的结果，来苛责您这样的天才技术人员？实在太失礼了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110806
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60110806,
					"content": "如果真有人这么做，我敢说这世上再也不会有技术突破了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110807
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60110807,
					"content": "哼，你这话倒挺中听…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110808
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 60110808,
					"content": "能让您感到宽心是我的荣幸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110809
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60110809,
					"content": "所以，到底有什么事嘛？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110810
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 60110810,
					"content": "您愿意抽空帮我修理这盏灯吗？上次我拿去那夏镇修过一回，但不幸在刚才的战斗中又坏了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110811
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60110811,
					"content": "修一盏灯？就这点事要我天才爱诺来做？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110812
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 60110812,
					"content": "哦，失礼了，这么看来我应该去委托伊涅芙小姐，那个点心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110813
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60110813,
					"content": "呃呃呃，我…我是说这点小事费不了什么功夫，坐着等吧，马上就好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110814
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 60110814,
					"content": "有劳您了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110815
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60110815,
					"content": "下次再有这种事，你记得一开始就来找我哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "爱诺"
				}
			]
		},
