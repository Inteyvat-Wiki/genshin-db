					"content": "…有趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110702
					],
					"speakerTitle": "猎月人"
				},
				{
					"id": 60110702,
					"content": "都跟到这里了，不如亮明身份吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
