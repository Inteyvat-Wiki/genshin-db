			"dialogs": [
				{
					"id": 60111101,
					"content": "#{NICKNAME}，竟然能在这里见到你。大战之后，我觉得应该进行一次深度维修与保养。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60111102
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60111102,
					"content": "——感谢你知道那么多，还愿意为我保守秘密。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60111103,
						60111104
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60111103,
					"content": "之前没机会问…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60111105
					]
				},
				{
					"id": 60111105,
					"content": "因为不想被执灯长找麻烦。如果没办法被感应到，估计上面会硬塞给我一盏执灯士的灯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60111106
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60111106,
					"content": "会手提两盏灯的执灯士，实在是太怪异了。审美上实在难以容忍呢，呵呵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60111104,
					"content": "你的灯怎么会被执灯人感应到呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60111105
					]
				}
			]
		}
