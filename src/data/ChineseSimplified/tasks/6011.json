			"dialogs": [
				{
					"id": 60110901,
					"content": "哎哟？你们怎么来了？没想到我们还有机会见面啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110902
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 60110902,
					"content": "之前你去哪儿了啊，不会是跑掉了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110903
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60110903,
					"content": "哎呀，怎么会呢，我只是去别的地方谈生意了嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110904
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 60110904,
					"content": "多亏了你们，才保住了我桑歌玛哈巴依老爷的小店，呜呜呜呜，我好欣慰呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110905
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 60110905,
					"content": "演的也太夸张了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110906
					]
				},
				{
					"id": 60110906,
					"content": "这哪有半点演的成分在呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110907
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 60110907,
					"content": "早告诉过你们我这儿的价格经济又实惠，可你们还是去了那个什么「秘闻馆」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110908
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 60110908,
					"content": "哎，连熟客都一个个离我而去，我不就只能去别处谋生了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110909
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 60110909,
					"content": "你也太在意「秘闻馆」了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110910
					]
				},
				{
					"id": 60110910,
					"content": "那能不在意吗！在国外做小生意本就不容易，现在又遇到了那么厉害的竞争对手…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110911
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 60110911,
					"content": "哎，算了，富贵有命，我也不抱怨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110912
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 60110912,
					"content": "真要说的话，奈芙尔这位老乡在我刚来的时候也帮过我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110913
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 60110913,
					"content": "要怪，就怪我这么久都没找到机会给她卖个天大的人情吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110914
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 60110914,
					"content": "你们要是打听到了那位老板娘想要什么的话，千万要记得第一个来找我啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "多莉"
				}
			]
		},
