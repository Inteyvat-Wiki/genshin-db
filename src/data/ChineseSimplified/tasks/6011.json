			"dialogs": [
				{
					"id": 60110401,
					"content": "蛋卷制作完毕，请趁热享用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110402
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 60110402,
					"content": "感谢你一直将这些事情放在心上，伊涅芙小姐。这份美味是可贵友谊的见证，愿它经年而不变。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110403
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 60110403,
					"content": "收到。但蛋卷的保质期很短，可能一周即变。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110404
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 60110404,
					"content": "哦，我说的「经年不变」是…咦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110405
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 60110405,
					"content": "嗯？那边似乎藏着一些客人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110406
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 60110406,
					"content": "大家循着蛋卷香气而来…没关系，靠近些吧，无须顾忌，伊涅芙小姐是我们的朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110407
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 60110407,
					"content": "没错。我可以依照各位的喜好，制作一份谷物蛋饼，碾碎成屑分享给大家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110408
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 60110408,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110409
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 60110409,
					"content": "它们怎么说？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110410
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 60110410,
					"content": "它们…在谈论你的住址，说想和你回家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菈乌玛"
				}
			]
