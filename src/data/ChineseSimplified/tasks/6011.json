			"dialogs": [
				{
					"id": 60111001,
					"content": "修灯，修灯，那可太简单了，三两下的工夫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60111002
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 60111002,
					"content": "要是每个人都能知道自己在干什么就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60111003
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 60111003,
					"content": "就像辛查那家伙，别人拿什么零件过来他都修，最后修出来一个集成控制器，又是大炮又是屏障，搞出一堆麻烦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60111004
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 60111004,
					"content": "我骂过他了，他以后会按期给我提交报告，我要检查他最近都在干什么。唉，也、也算我有不对的地方啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "爱诺"
				}
			]
		},
