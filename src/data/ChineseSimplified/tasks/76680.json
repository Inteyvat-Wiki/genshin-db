				"points": []
			},
			"dialogs": [
				{
					"id": 766800101,
					"content": "#哦呦，{NICKNAME}和派蒙，你们好啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800102
					],
					"speakerTitle": "青霆"
				},
				{
					"id": 766800102,
					"content": "既然巧遇了，要不要来看看我青霆的鼬鼬？它叫洋葱尾巴，很可爱的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800103
					],
					"speakerTitle": "青霆"
				},
				{
					"id": 766800103,
					"content": "…喵？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800104
					],
					"speakerTitle": "洋葱尾巴"
				},
				{
					"id": 766800104,
					"content": "喂喂，洋葱尾巴，你不是这样叫的！这两位应该不懂阿舍鲁老师的语言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800105
					],
					"speakerTitle": "青霆"
				},
				{
					"id": 766800105,
					"content": "…咕？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800106
					],
					"speakerTitle": "洋葱尾巴"
				},
				{
					"id": 766800106,
					"content": "也不能用团雀语哦，拜希麦小姐已经回须弥去休养了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800107
					],
					"speakerTitle": "青霆"
				},
				{
					"id": 766800107,
					"content": "对不起啊，我家洋葱尾巴和别的动物交流太多，一时错乱了，暂时找不回自己的频道，哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800108
					],
					"speakerTitle": "青霆"
				},
				{
					"id": 766800108,
					"content": "先让它休息一下好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800109,
						766800110
					],
					"speakerTitle": "青霆"
				},
				{
					"id": 766800109,
					"content": "你也是动物专家？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766800111
					]
				},
				{
					"id": 766800111,
					"content": "唔，怎么感觉你和我们很熟，说话很自然的样子…难道以前调查过我们吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766800112,
					"content": "放松，放松，我是你们的自己人——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800113
					],
					"speakerTitle": "青霆"
				},
				{
					"id": 766800113,
					"content": "我为夜兰老板工作，而你们是夜兰老板最最重要的宾客，咱们关系有多铁，不用多说了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800114,
						766800115
					],
					"speakerTitle": "青霆"
				},
				{
					"id": 766800114,
					"content": "那确实是自己人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766800116
					]
				},
				{
					"id": 766800116,
					"content": "哎呀，早说嘛！害我紧张了一小下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766800117,
					"content": "话说回来，你和洋葱尾巴在这荒郊野岭呆站着，是在忙什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766800118,
					"content": "忙着看大门…或者说，检验我的「看大门军团」能不能好好上工。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800119,
						766800120
					],
					"speakerTitle": "青霆"
				},
				{
					"id": 766800119,
					"content": "看大门？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766800121
					]
				},
				{
					"id": 766800121,
					"content": "都是自己人，我悄悄告诉你们——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800122
					],
					"speakerTitle": "青霆"
				},
				{
					"id": 766800122,
					"content": "这附近的地下藏着我的一座物资据点，但最近，据点老是被各种魔物撬开大门。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800123
					],
					"speakerTitle": "青霆"
				},
				{
					"id": 766800123,
					"content": "于是我花费重金，请叮铃哐啷蛋卷工坊的天才机械师为我打造了看门的机关军团。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800124
					],
					"speakerTitle": "青霆"
				},
				{
					"id": 766800124,
					"content": "咳咳，准确描述，应该是安防系统。能够自行选择部署地点，多种功能组合搭配的防御体系。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800125
					],
					"speakerTitle": "青霆"
				},
				{
					"id": 766800125,
					"content": "我运气不错，再过不久，那位大师就要带着她的作品参加展会，卖给我的这套，就当成前期验证的款式了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800126
					],
					"speakerTitle": "青霆"
				},
				{
					"id": 766800126,
					"content": "所以我在据点前方打造了一条复合防线，请君…不对，是请魔物入瓮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800127
					],
					"speakerTitle": "青霆"
				},
				{
					"id": 766800127,
					"content": "这样，不仅能试出多个保护据点的方案，还能给大师提供许多数据，一举两得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800128,
						766800129
					],
					"speakerTitle": "青霆"
				},
				{
					"id": 766800128,
					"content": "原来你买到了爱诺的杰作。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766800130
					]
				},
				{
					"id": 766800130,
					"content": "要来试试看吗？我已经借助它们搞定许多魔物了，感觉非常解压。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800131
					],
					"speakerTitle": "青霆"
				},
				{
					"id": 766800131,
					"content": "你们也来解压一下，顺带，让我参考参考你们的思路！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800132
					],
					"speakerTitle": "青霆"
				},
				{
					"id": 766800132,
					"content": "当然，酬劳好说。都是自己人，开价得是一般顾问的两倍才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800133,
						766800134
					],
					"speakerTitle": "青霆"
				},
				{
					"id": 766800133,
					"content": "的确，都自己人，多给点！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766800135
					]
				},
				{
					"id": 766800135,
					"content": "嗯…嗯嗯！考虑到帮你也是变相帮了夜兰，这事对大家都有好处…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800136
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766800136,
					"content": "就让经验丰富的我们露两手好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766800134,
					"content": "哎呀，这怎么好意思呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766800135
					]
				},
				{
					"id": 766800129,
					"content": "听起来还挺有意思的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766800130
					]
				},
				{
					"id": 766800120,
					"content": "军团？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766800121
					]
				},
				{
					"id": 766800115,
					"content": "夜兰的朋友也是我们的朋友。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766800116
					]
				},
				{
					"id": 766800110,
					"content": "你也是动物朋友？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766800111
					]
				}
			]
		}
	]
}