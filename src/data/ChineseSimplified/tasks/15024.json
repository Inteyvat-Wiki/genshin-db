						],
						"pointId": 10239
					}
				]
			},
			"dialogs": [
				{
					"id": 150240501,
					"content": "哇，刚刚那是什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240502,
					"content": "那是我们祭司的日常工作之一，我们尝试与先祖的灵魂获得联系，并寻求启示。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240503
					],
					"speakerTitle": "卡胡鲁"
				},
				{
					"id": 150240503,
					"content": "首领就在那边，容我先禀报一下，请两位在此稍候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240504
					],
					"speakerTitle": "卡胡鲁"
				},
				{
					"id": 150240504,
					"content": "该怎么说呢，烟谜主这个部族果然好神秘啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240505,
					"content": "我已向首领禀明情况，两位请随我去面见首领吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240506
					],
					"speakerTitle": "卡胡鲁"
				},
				{
					"id": 150240506,
					"content": "两位就是谕示所指向的人选吧？我是烟谜主的现任首领庇兰，有失远迎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240507
					],
					"speakerTitle": "庇兰"
				},
				{
					"id": 150240507,
					"content": "好高…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240508,
					"content": "我生来就拥有异于常人的体型，请勿见怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240509
					],
					"speakerTitle": "庇兰"
				},
				{
					"id": 150240509,
					"content": "当然不会！我刚刚只是有些惊讶，抱歉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240510
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240510,
					"content": "请问「谕示」是什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240511
					]
				},
				{
					"id": 150240511,
					"content": "具体情况卡胡鲁已经向我说明，我能理解两位的疑惑。两位是外来的客人，自然不了解这种「谕示」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240512
					],
					"speakerTitle": "庇兰"
				},
				{
					"id": 150240512,
					"content": "在之前漫长的历史中，这项「谕示」所选中的都是烟谜主内部的族人。外族人被选中的情况，这还是第一次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240513
					],
					"speakerTitle": "庇兰"
				},
				{
					"id": 150240513,
					"content": "哦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240514
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240514,
					"content": "请容我说明一下，我们烟谜主有一个古老的传统，那就是制作织物来记载纳塔的历史。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240515
					],
					"speakerTitle": "庇兰"
				},
				{
					"id": 150240515,
					"content": "并且我们不只记录本族的历史，其他部族的传说故事和英雄事迹也会被纳入记录的范围。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240516
					],
					"speakerTitle": "庇兰"
				},
				{
					"id": 150240516,
					"content": "上千年来都是如此，我们将此视为自己的一项使命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240517
					],
					"speakerTitle": "庇兰"
				},
				{
					"id": 150240517,
					"content": "不过，如果是那种影响了整个纳塔的大事件，就需要一种极为特殊的织物来记录。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240518
					],
					"speakerTitle": "庇兰"
				},
				{
					"id": 150240518,
					"content": "而这种织物只有暝视龙大长老指定的人才能完成。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240519
					],
					"speakerTitle": "庇兰"
				},
				{
					"id": 150240519,
					"content": "当暝视龙大长老观测到地脉的重大变化后，它就会发出一种谕示，指定制作这种织物的人选。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240520
					],
					"speakerTitle": "庇兰"
				},
				{
					"id": 150240520,
					"content": "也就是说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240521
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240521,
					"content": "现任的特拉波长老很早就察觉到了地脉的变化，但两位到来后，它才指定了制作织物的人选。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240522
					],
					"speakerTitle": "庇兰"
				},
				{
					"id": 150240522,
					"content": "#原来是这样…但是，我和{NICKNAME}根本不知道如何制作这种织物啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240523
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240523,
					"content": "对于这一点，我并不惊讶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240524
					],
					"speakerTitle": "庇兰"
				},
				{
					"id": 150240524,
					"content": "欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240525
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240525,
					"content": "特拉波长老在大约两百年前继任，同时也接过了这个确定人选的职责，而它选中的人都不了解如何制作这种织物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240526
					],
					"speakerTitle": "庇兰"
				},
				{
					"id": 150240526,
					"content": "那这两百年来的历史大事件都没有记录吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240527
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240527,
					"content": "不，那些人都按时交出了成果，只是他们大多声称那不是自己制作的，而是得到了「神灵的馈赠」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240528
					],
					"speakerTitle": "庇兰"
				},
				{
					"id": 150240528,
					"content": "这…烟谜主这个部族果然好神秘啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240529
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240529,
					"content": "不过，这正是让我困扰的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240530
					],
					"speakerTitle": "庇兰"
				},
				{
					"id": 150240530,
					"content": "记录历史这么重要的事情，如果只能寄希望于「神灵的馈赠」这种谜一样的事物，实在无法令人安心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240531
					],
					"speakerTitle": "庇兰"
				},
				{
					"id": 150240531,
					"content": "呃，听到烟谜主的首领这么说，真的有些意外啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240532
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240532,
					"content": "我理解两位的想法，想必在两位看来，烟谜主的人都充满了神秘感，他们推崇的肯定都是难以言明的事物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240533
					],
					"speakerTitle": "庇兰"
				},
				{
					"id": 150240533,
					"content": "而我确实是个异类，虽然身为烟谜主的首领，但我主张针对这些传统做出变革。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240534
					],
					"speakerTitle": "庇兰"
				},
				{
					"id": 150240534,
					"content": "我致力于解析各种神秘的事物，因为这样就可以建立明确的规则，进而更长久地维护部族的传承。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240535
					],
					"speakerTitle": "庇兰"
				},
				{
					"id": 150240535,
					"content": "哇，听上去好厉害…那你解析了「神灵的馈赠」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240536
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240536,
					"content": "不…我调查了很久，也没有查清「神灵的馈赠」指的是什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240537
					],
					"speakerTitle": "庇兰"
				},
				{
					"id": 150240537,
					"content": "需要用那种织物来记录的大事件屈指可数，彼此之间的时间间隔都在几十年以上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240538
					],
					"speakerTitle": "庇兰"
				},
				{
					"id": 150240538,
					"content": "等到下一个谕示被发出的时候，首领已经换了一代人，根本没机会针对此事进行深入的调查。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240539
					],
					"speakerTitle": "庇兰"
				},
				{
					"id": 150240539,
					"content": "那…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240540
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240540,
					"content": "我虽然没有查清事情的全貌，但还是获得了一些进展。只是，我需要被选中的人配合我验证一些猜测。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240541
					],
					"speakerTitle": "庇兰"
				},
				{
					"id": 150240541,
					"content": "所以我们要接受测试…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240542
					]
				},
				{
					"id": 150240542,
					"content": "正是如此。不过两位无需担忧，这个测试只是为了验证我的猜测，既不会过多耗费两位的心力，也不会带来任何危险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240543
					],
					"speakerTitle": "庇兰"
				},
				{
					"id": 150240543,
					"content": "那具体是什么样的测试？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240544
					]
				},
				{
					"id": 150240544,
					"content": "我可以带领两位前往测试地点并进行说明，但请两位稍候，容我先脱下这件「覆魂之羽」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240545
					],
					"speakerTitle": "庇兰"
				},
				{
					"id": 150240545,
					"content": "这是历代首领传承下来的圣物，只有在主持祭祀时才能穿着。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240546
					],
					"speakerTitle": "庇兰"
				},
				{
					"id": 150240546,
					"content": "哦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240547
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240547,
					"content": "庇兰脱下了身上的羽织，小心地交予一名祭司收存。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150240548
					]
				},
				{
					"id": 150240548,
					"content": "请随我来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240549
					],
					"speakerTitle": "庇兰"
				},
				{
					"id": 150240549,
					"content": "两位看到这面织物了吗？接触它，两位就可以进入一个秘密的空间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240550
					],
					"speakerTitle": "庇兰"
				},
				{
					"id": 150240550,
					"content": "而两位要接受的测试，就是想办法从那个空间中脱身。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240551
					],
					"speakerTitle": "庇兰"
				},
				{
					"id": 150240551,
					"content": "这样就行？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240552
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240552,
					"content": "请不要小看这个测试，如果实在找不到脱身之法，我会亲自帮助两位回到这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240553
					],
					"speakerTitle": "庇兰"
				},
				{
					"id": 150240553,
					"content": "只是那样的话，这个谕示就仍旧是一道难解的谜题…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240554
					],
					"speakerTitle": "庇兰"
				},
				{
					"id": 150240554,
					"content": "先让我们试试吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240555
					]
				},
				{
					"id": 150240555,
					"content": "好，两位可以主动接触那面织物来开始测试。",
