			"dialogs": [
				{
					"id": 150240101,
					"content": "欸？好像有什么东西躲在神像后面！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240102,
					"content": "这是幼年的暝视龙？还蛮可爱的…不过，它为什么要这样盯着我们看？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240103,
					"content": "#{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240104,
					"content": "（这里是…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240105
					]
				},
				{
					"id": 150240105,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240106
					],
					"speakerTitle": "特拉波"
				},
				{
					"id": 150240106,
					"content": "（你是…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240107
					]
				},
				{
					"id": 150240107,
					"content": "！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240108
					],
					"speakerTitle": "特拉波"
				},
				{
					"id": 150240108,
					"content": "唔…到底过去了多久…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240109,
					"content": "#{NICKNAME}，刚刚我和那只幼年暝视龙对视了一眼，就被拉进了一个奇怪的空间，还见到了好大的一只暝视龙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240110,
					"content": "我也是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240111
					]
				},
				{
					"id": 150240111,
					"content": "怎么会发生这种事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240112,
					"content": "#{NICKNAME}，又怎么了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240113,
						150240114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240113,
					"content": "它就在那边…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240115
					]
				},
				{
					"id": 150240115,
					"content": "看！是那只幼年的暝视龙，它好像也想带我们去那边。从冒险者的角度来说，必须一探究竟了呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240116,
					"content": "我们走，派蒙！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 150240114,
					"content": "好像在呼唤我们…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240115
					]
				}
			]
		},
