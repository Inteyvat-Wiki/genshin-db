			"dialogs": [
				{
					"id": 150240301,
					"content": "你好，请问…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240302,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240303
					],
					"speakerTitle": "特拉波"
				},
				{
					"id": 150240303,
					"content": "它听得懂我们讲话吗？看上去呆呆的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240304,
					"content": "！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240305
					],
					"speakerTitle": "特拉波"
				},
				{
					"id": 150240305,
					"content": "如果说错了什么，对不起！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240306,
					"content": "是谁在那里？不得对长老无礼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240307
					],
					"speakerTitle": "卡胡鲁"
				},
				{
					"id": 150240307,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240308
					],
					"speakerTitle": "特拉波"
				},
				{
					"id": 150240308,
					"content": "您的意思是…我明白了。刚刚是我冒昧了，两位既然是受邀而来的客人，我本该热情接待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240309
					],
					"speakerTitle": "卡胡鲁"
				},
				{
					"id": 150240309,
					"content": "正式介绍一下，在下名为卡胡鲁，烟谜主的祭司之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240310
					],
					"speakerTitle": "卡胡鲁"
				},
				{
					"id": 150240310,
					"content": "这位是现任的暝视龙大长老，伟大的特拉波波克提兹特利，我们烟谜主活着的图腾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240311
					],
					"speakerTitle": "卡胡鲁"
				},
				{
					"id": 150240311,
					"content": "好长的名字…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240312,
					"content": "我们族人平时都称呼它为特拉波长老，两位客人也可以使用这个称呼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240313
					],
					"speakerTitle": "卡胡鲁"
				},
				{
					"id": 150240313,
					"content": "它邀请人的方式真特别。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240314
					]
				},
				{
					"id": 150240314,
					"content": "哦，这位客人是指长老的能力吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240315
					],
					"speakerTitle": "卡胡鲁"
				},
				{
					"id": 150240315,
					"content": "特拉波长老已经活过数百年的岁月，它身上的秘密就连我这个祭司也难以说清楚，客人感到困惑自然是情有可原。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240316
					],
					"speakerTitle": "卡胡鲁"
				},
				{
					"id": 150240316,
					"content": "不过有一点我可以确认，特拉波长老对两位发出了重要的谕示，因此我希望能邀请两位接受一项测试。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240317
					],
					"speakerTitle": "卡胡鲁"
				},
				{
					"id": 150240317,
					"content": "谕示？测试？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240318,
					"content": "如果可以的话，请两位随我去见部族首领。比起我，他更有能力来解答两位的疑问。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240319
					],
					"speakerTitle": "卡胡鲁"
				},
				{
					"id": 150240319,
					"content": "嗯…好吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240320,
					"content": "如果两位准备好了，就请随我来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240401
					],
					"speakerTitle": "卡胡鲁"
				},
				{
					"id": 150240401,
					"content": "使用这面织物，就可以直接抵达首领所在的「曜石祭场」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240402
					],
					"speakerTitle": "卡胡鲁"
				},
				{
					"id": 150240402,
					"content": "无需惊讶，这是我们部族使用的诸多秘术之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡胡鲁"
				}
			]
		},
