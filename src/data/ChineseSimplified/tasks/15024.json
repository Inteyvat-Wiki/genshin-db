			"dialogs": [
				{
					"id": 150240701,
					"content": "呼…终于出来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240702
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240702,
					"content": "看来两位果然是有能力肩负这项使命的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240703
					],
					"speakerTitle": "庇兰"
				},
				{
					"id": 150240703,
					"content": "你的猜测被验证了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240704
					]
				},
				{
					"id": 150240704,
					"content": "是的，两位在那里见到了很多特殊的织物吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240705
					],
					"speakerTitle": "庇兰"
				},
				{
					"id": 150240705,
					"content": "嗯，确实…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240706
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240706,
					"content": "我仔细研究了先祖留下的这类织物，发现它们上面都有一种普通织物所不具备的「色彩」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240707
					],
					"speakerTitle": "庇兰"
				},
				{
					"id": 150240707,
					"content": "这种「色彩」十分神奇，甚至就连我也必须依靠特殊的手段才能确认它的存在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240708
					],
					"speakerTitle": "庇兰"
				},
				{
					"id": 150240708,
					"content": "但存在一类人，他们天生就拥有分辨这种「色彩」的能力——而这也正是我测试两位的初衷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240709
					],
					"speakerTitle": "庇兰"
				},
				{
					"id": 150240709,
					"content": "这么说的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240710
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240710,
					"content": "两位刚刚进入的空间，就是用来存放这些织物的陈列室。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240711
					],
					"speakerTitle": "庇兰"
				},
				{
					"id": 150240711,
					"content": "数百年前，有一位名为维奇琳的大萨满曾为这座陈列室设下过禁制，如果外人未经允许就闯入，便会被困在里面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240712
					],
					"speakerTitle": "庇兰"
				},
				{
					"id": 150240712,
					"content": "这种禁制如今依旧存在，虽然我尚不了解它的具体原理，但我找到了开启和关闭它的办法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240713
					],
					"speakerTitle": "庇兰"
				},
				{
					"id": 150240713,
					"content": "#一旦被困，没有外界的帮助几乎不可能脱身，除非{M#他}{F#她}和那位大萨满一样拥有辨别这种「色彩」的能力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240714,
						150240715
					],
					"speakerTitle": "庇兰"
				},
				{
					"id": 150240714,
					"content": "我想起来了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240716
					]
				},
				{
					"id": 150240716,
					"content": "看来阁下果然拥有这种能力…所以暝视龙长老应该可以直接辨别出拥有这种能力的人，并依此来确定每次的人选。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240717
					],
					"speakerTitle": "庇兰"
				},
				{
					"id": 150240717,
					"content": "你身上到底还有多少我不知道的秘密啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240718
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240718,
					"content": "不过，就算拥有这种能力，要是让我们来制作织物，还是不知道该从何做起啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240719
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240719,
					"content": "两位不用担心，我做过对比，这种织物的编织技艺与普通织物相差不大，最核心的差别可能在染料与染色这两点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240720
					],
					"speakerTitle": "庇兰"
				},
				{
					"id": 150240720,
					"content": "如果我的推测正确，那么制作这种织物的关键就是一种特殊的染料，而获得它必须仰仗两位的能力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240721
					],
					"speakerTitle": "庇兰"
				},
				{
					"id": 150240721,
					"content": "至于染色…只要能拿到染料，应该就没有问题，这部分工作可以由我来指导两位完成。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240722
					],
					"speakerTitle": "庇兰"
				},
				{
					"id": 150240722,
					"content": "…嗯，那就听首领安排！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240723
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240723,
					"content": "那就先麻烦两位使用这种能力找到所需的染料，同时我会找人准备一些用来测试染料的织物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240724
					],
					"speakerTitle": "庇兰"
				},
				{
					"id": 150240724,
					"content": "我们先制作一些样品来验证我的猜测，只要成功，就可以正式开始了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240725
					],
					"speakerTitle": "庇兰"
				},
				{
					"id": 150240725,
					"content": "事成之后，我愿意提供丰厚的报酬作为答谢，两位意下如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240726
					],
					"speakerTitle": "庇兰"
				},
				{
					"id": 150240726,
					"content": "有能力就有责任。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240727
					]
				},
				{
					"id": 150240727,
					"content": "嗯嗯，何况还有报酬！对了，报酬里可以有好吃的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240728
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240728,
					"content": "此事对于我们烟谜主来说意义重大，我愿意奉上重金作为答谢，何况只是一顿美餐？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240729
					],
					"speakerTitle": "庇兰"
				},
				{
					"id": 150240729,
					"content": "好耶！话说回来，我们要去哪里找那种染料呢？总不能把纳塔都逛一遍吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240730
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240730,
					"content": "当然不需要，在先前筹备的过程中，我已经调查到了一处可能存在这种染料的地点，并为两位安排了领路人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240731
					],
					"speakerTitle": "庇兰"
				},
				{
					"id": 150240731,
					"content": "如果两位准备好了，现在就可以出发，领路人就在外面等候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "庇兰"
				},
				{
					"id": 150240715,
					"content": "是那种「色彩」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240716
					]
				}
			]
		},
