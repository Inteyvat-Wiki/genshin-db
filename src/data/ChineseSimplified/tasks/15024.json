				]
			},
			"dialogs": [
				{
					"id": 150240201,
					"content": "不知道这里允不允许外人进去…门怎么自己打开了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240202,
					"content": "哇，之前看到的那只暝视龙真的在这里！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240203,
					"content": "就是它在呼唤我…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240204
					]
				},
				{
					"id": 150240204,
					"content": "那我们过去打个招呼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
