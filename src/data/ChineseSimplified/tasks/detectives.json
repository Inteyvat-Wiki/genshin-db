				]
			},
			"dialogs": [
				{
					"id": 191851101,
					"content": "这些袋子的材质，相当少见啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851102
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 191851102,
					"content": "[知识]（协助林尼判断材质…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851103
					]
				},
				{
					"id": 191851103,
					"content": "是不是跟你的「魔术口袋」很像？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851104
					]
				},
				{
					"id": 191851104,
					"content": "…嗯，都是海露花纤维做的，不过做了更加细致的处理，不仅能防水，还能防酸蚀、防泄漏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851105
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 191851105,
					"content": "连系绳都是特制的，可以紧紧扎住袋口。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851106
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 191851106,
					"content": "我刚刚还发现了一些材质相同的口袋，不过个头都很小，厚度也很薄，看起来要容易坏得多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851107
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 191851107,
					"content": "有点像…密封袋？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851108
					]
				},
				{
					"id": 191851108,
					"content": "…确实有点像。「仿制乐斯」会被卫兵犬闻出来，密封起来说不定能躲过一时。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851109
					],
