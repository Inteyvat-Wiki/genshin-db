			"dialogs": [
				{
					"id": 191851001,
					"content": "…逐影庭在皮埃尔的住所里，好像没有见到过这些木桶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851002
					],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 191851002,
					"content": "直接抱着这些桶过来也太显眼了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851003
					]
				},
				{
					"id": 191851003,
					"content": "嗯，不像是皮埃尔的行动模式…那会是怎么运来的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851004
					],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 191851004,
					"content": "（仔细观察木桶…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851005
					]
				},
				{
					"id": 191851005,
					"content": "（木桶外壁有浸泡过的痕迹，桶身一周都留下了干涸后的水渍…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851006
					],
					"speakerTitle": "调查"
				},
				{
					"id": 191851006,
					"content": "（这些水渍显得异常「规矩」，木桶的上半部分几乎没有任何水渍。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851007
					],
					"speakerTitle": "调查"
				},
				{
					"id": 191851007,
					"content": "（桶盖似乎不是很严实，边缘处留有不小的缝隙，但内部并没有进水的痕迹。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851008
					],
					"speakerTitle": "调查"
				},
				{
					"id": 191851008,
					"content": "只有下半部分泡过水吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "琳妮特"
				}
			]
		},
