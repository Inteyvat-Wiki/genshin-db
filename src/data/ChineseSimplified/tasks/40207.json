			"dialogs": [
				{
					"id": 402070201,
					"content": "你好啊，伊涅芙——雅珂达这次又在这里？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402070202,
					"content": "辛苦了这么多天，至少应该让我分一块蛋糕吃吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070203
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 402070203,
					"content": "有蛋糕吃！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402070204,
					"content": "#嗯，{NICKNAME}和派蒙来得刚好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070205
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402070205,
					"content": "爱诺一直想感谢大家，正好铛铛七分甜也被救回来了，所以就想让大家尝尝它的厨艺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070206
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402070206,
					"content": "嘎吱…嘎吱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070207
					],
					"speakerTitle": "铛铛七分甜"
				},
				{
					"id": 402070207,
					"content": "哇， 这就是铛铛七分甜原本的样子吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402070208,
					"content": "好在核心相对完整，爱诺为它重新制作了一副身躯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070209
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402070209,
					"content": "哼哧…哼哧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070210
					],
					"speakerTitle": "铛铛七分甜"
				},
				{
					"id": 402070210,
					"content": "新鲜的甜品要出炉了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402070211,
					"content": "嘎吱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070212
					],
					"speakerTitle": "铛铛七分甜"
				},
				{
					"id": 402070212,
					"content": "自己吃下去了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402070213,
					"content": "厨子上菜之前总会偷吃两口的，不稀奇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070214
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 402070214,
					"content": "不用担心，铛铛七分甜吃完后就可以为大家烤制甜品了，稍等片刻就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070215
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402070215,
					"content": "好吧…话说要吃甜品的时候，爱诺怎么不在？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402070216,
					"content": "爱诺刚刚想到了一个制作机器人的新点子，就立刻钻进了工作室。从我来到工坊起，她就一直这样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070217
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402070217,
					"content": "爱诺为什么这么喜欢制作机器人啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402070218,
					"content": "嗯…要回答这个问题的话，需要从数据库中检索许多历史记录。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070219
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402070219,
					"content": "最初，爱诺可能只是惊讶于这世界上还存在一种比甜食更吸引她的事物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070220
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402070220,
					"content": "爱诺是幸运的，她对这种事物的爱好得到了同伴们的尊重，即便维持生计本身就快要耗光他们每天的活动时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070221
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402070221,
					"content": "直到一位优秀的老师出现之后，爱诺的爱好才被定义成天赋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070222
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402070222,
					"content": "正如爱诺曾经的那些伙伴那样，她终于找到了自己最想做，也最擅长做的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070223
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402070223,
					"content": "而当一位天才找到了自己真正想做的事，她就很难再停下自己的脚步了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070224
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402070224,
					"content": "所以爱诺最终还是离开了儿时的伙伴，创建了最初的叮铃哐啷蛋卷工坊，开始制作各种各样的机器人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070225
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402070225,
					"content": "这一切对于那时的爱诺来说，或许都是身为天才的「本能」，她渴望将自己的奇思妙想化为现实。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070226
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402070226,
					"content": "哦…所以才那么喜欢制作机器人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070227
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402070227,
					"content": "不过，结合我自身的经历，我并不认为那就是答案的全部。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070228
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402070228,
					"content": "早在收留我之前，爱诺就开始穷尽她的技术手段，尝试为每个被制作的机器人赋予独特的个性，把它们当成伙伴…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070229
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402070229,
					"content": "我并没有因为自己的出身，而成为工坊中的特例。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070230
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402070230,
					"content": "分析原因，或许是她在这条名为天才的道路上走出了太远，回望空无一人的身侧，不由得感受到了孤独。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070231
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402070231,
					"content": "所以，我、铛铛七分甜、还有其他所有经爱诺之手得以加入工坊的机器人，都不单单是一种「天才的证明」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070232
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402070232,
					"content": "我们还是爱诺的家人，是她渴求的陪伴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070233
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402070233,
					"content": "这就是我所理解的，爱诺和机器人之间的关系。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070234
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402070234,
					"content": "原来是这样啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070235
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402070235,
					"content": "正因如此，爱诺并不关心铛铛七分甜是否拥有令各方势力忌惮的威能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070236
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402070236,
					"content": "它已经被确定为工坊的一员，这就足够让爱诺做出那一切了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070237
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402070237,
					"content": "嗯嗯，我也这么觉得！所以我也很奇怪爱诺这样的人竟然会留在挪德卡莱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070238
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402070238,
					"content": "…派蒙的这句发言，我的逻辑单元无法理解呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070239
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402070239,
					"content": "我的意思是，在我看来，挪德卡莱这个地方，鱼龙混杂，到处都是算计，能在这里立足的肯定都是很不好惹的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070240
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402070240,
					"content": "如果其他人得到了爱诺那样的技术，肯定会把机器人都改造成强大的兵器，驱使它们，用来威胁别人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070241
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402070241,
					"content": "但爱诺…她是能把大杀器造成烤蛋糕机的人，把她放到挪德卡莱，完全格格不入啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070242
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402070242,
					"content": "不，我的逻辑单元持完全相反的看法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070243
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402070243,
					"content": "我在挪德卡莱接触过很多人，但其中的绝大多数都不能被定义为「挪德卡莱人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070244
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402070244,
					"content": "偏偏是让派蒙感到惊讶的爱诺，最符合我的逻辑单元对「挪德卡莱人」的定义呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070245
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402070245,
					"content": "叮铃…叮铃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070246
					],
					"speakerTitle": "铛铛七分甜"
				},
				{
					"id": 402070246,
					"content": "甜品烤好了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070247
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 402070247,
					"content": "嗯，不要急，先让我来分一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070248
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402070248,
					"content": "我要奶油最多的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070249
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 402070249,
					"content": "好了，大家品尝一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070250
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402070250,
					"content": "…真好吃！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}