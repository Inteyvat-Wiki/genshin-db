			"dialogs": [
				{
					"id": 120340501,
					"content": "你看，勘定奉行柊家的大小姐，还有天领奉行九条家的二少爷，这两个人要结婚了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340502
					],
					"speakerTitle": "柚子"
				},
				{
					"id": 120340502,
					"content": "咳咳…没有比这更门当户对的情况了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340503
					],
					"speakerTitle": "古谷升"
				},
				{
					"id": 120340503,
					"content": "我也觉得，只是这消息来得有点突然，之前一直没听说呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340504
					],
					"speakerTitle": "柚子"
				},
				{
					"id": 120340504,
					"content": "祝福他们吧，能迈出这一步，我想也很不容易。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "古谷升"
				}
			]
		},
