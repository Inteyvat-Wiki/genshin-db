				"objectNames": [
					"九条镰治"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120340801,
					"content": "几位，欢迎。实际上，我刚刚听说…我和千里的婚事被公布出来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340802
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 120340802,
					"content": "怎么会这么突然？我还没做好准备…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340803
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 120340803,
					"content": "关于这个，背后比较复杂…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340804
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120340804,
					"content": "向九条镰治简单说明了事件背后的复杂情况…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						120340805
					]
				},
				{
					"id": 120340805,
					"content": "这样啊…原来有人想利用我们的婚姻…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340806
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 120340806,
					"content": "顺势结婚，对您的影响或许不大，但我们必须考虑柊小姐的处境。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340807
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 120340807,
					"content": "我不是没有考虑过现在这种可能性，但我们结婚是真心的，我也已经跟她说好，会竭尽全力保护她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340808
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 120340808,
					"content": "您的心意我能理解，但恕我直言，她本可以不借助您的保护。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340809
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 120340809,
					"content": "换句话说，假如连您也潜意识认为，柊小姐必须受您保护才能渡过困境，那是否意味着她已经失去了某些东西呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340810
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 120340810,
					"content": "这…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340811
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 120340811,
					"content": "我并非苛责您，想保护重要的人是人之常情。我也知道您如此聪慧温柔，若不是关心则乱，一定能想得再周全一点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340812
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 120340812,
					"content": "您喜欢的柊小姐，是独立自主，温柔坚强，充满决心的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340813
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 120340813,
					"content": "然而就是这样的她，从今往后，为了与您的婚姻…即将变得只能依托您而活了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340814
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 120340814,
					"content": "即使如此也没关系吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340815
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 120340815,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340816
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 120340816,
					"content": "我用心爱着她，愿意尽我所能给她幸福。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340817
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 120340817,
					"content": "正因如此，我不愿意见她痛苦，更不愿意看她被人利用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340818
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 120340818,
					"content": "社奉行大人，您说得对，我之前的想法…太过简单自私。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340819
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 120340819,
					"content": "但，现在一切都晚了吧，公告都已经贴得到处都是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340820
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 120340820,
					"content": "我有一计，不过…这个计划需要「坏人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340821
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 120340821,
					"content": "九条大人，如果实行这个计划，那么您和我都需要扮演坏人，承担一定风险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340822
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 120340822,
					"content": "您意下如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340823
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 120340823,
					"content": "请讲讲您的计划吧，只要还有办法挽回。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340824
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 120340824,
					"content": "我已经告诉勘定奉行的人，结婚一事并不能让勘定奉行和天领奉行站在一起。相反，它是个令勘定奉行遭到孤立的决策。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340825
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 120340825,
					"content": "这种说辞指向的隐情在于，他们想要利用结婚一事架空柊家，而此事成功的关键是天领奉行对这场婚事没有任何想法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340826
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 120340826,
					"content": "但如果我们假设，「眼狩令」一事后，天领奉行早就想对势力薄弱的勘定奉行下手…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340827
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 120340827,
					"content": "您接任天领奉行之后迟迟没有动作，不过是顾虑柊小姐的感受。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340843
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 120340843,
					"content": "对您来说，最好的办法就是在社奉行的支持下尽快办妥婚事，迎娶柊小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340828
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 120340828,
					"content": "——那样一来，身为天领奉行掌权者的您就再也没有后顾之忧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340829
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 120340829,
					"content": "原来如此！的确合乎形势，也很巧妙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340830
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 120340830,
					"content": "这会让柊千里显得不可或缺。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120340831
					]
				},
				{
					"id": 120340831,
					"content": "没错，我们的目的是改变柊小姐的立场。让她从「尽快送走的累赘」，变成「不可或缺的保护伞」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340832
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 120340832,
					"content": "如此举措，还能稳固柊小姐在勘定奉行府中的地位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340833
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 120340833,
					"content": "一旦那些人意识到整件事背后的关系网，就会全力阻止这场婚姻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340834
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 120340834,
					"content": "至于那些他们亲手制造的麻烦，就请他们自己去摆平吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340835
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 120340835,
					"content": "我明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340836
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 120340836,
					"content": "#呃…关系网…好绕啊，听不懂！你还是直接点明我和{M#他}{F#她}需要做什么吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340837
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120340837,
					"content": "我们需要保证，「背后的故事」能顺利地传入勘定奉行那帮人耳中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340838
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 120340838,
					"content": "跟我聊过天的那位松浦大人，等他缓过神来，应该已经开始胡思乱想，提防各种危机了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340839
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 120340839,
					"content": "那么他一定会在稻妻城内布设许多眼线，我们要做的，就是让这些眼线成为假情报潜滋暗长的温床。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340840
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 120340840,
					"content": "九条大人，有些具体的工作需要您去完成。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340841
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 120340841,
					"content": "神里绫人为九条镰治说明了具体安排，之后又过了一段时间…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						120340842
					]
				},
				{
					"id": 120340842,
					"content": "时候差不多了。我的忍者已经定位到其中一名眼线，各位，一起去看看他会不会中计吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "神里绫人"
				}
			]
		},
		{
			"id": 1203409,
			"completionStepIds": [
				1203414
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1203414",
							"2"
						],
						"stepId": 1203414,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"秀夫",
					"冈林"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120340901,
					"content": "哇，怎么有这么多天领奉行的人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340902
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120340902,
					"content": "请问各位，这条路上是发生什么了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340903
					],
					"speakerTitle": "秀夫"
				},
				{
					"id": 120340903,
					"content": "我是做生意的商人，这条路被重兵把守，我有点怕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340904
					],
					"speakerTitle": "秀夫"
				},
				{
					"id": 120340904,
					"content": "啊，不用担心，相信你也听说了，九条镰治大人和柊千里小姐将于近日成婚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340905
					],
					"speakerTitle": "冈林"
				},
				{
					"id": 120340905,
					"content": "九条大人的想法是，将柊小姐提前接到稻妻城来住。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340906
					],
					"speakerTitle": "冈林"
				},
				{
					"id": 120340906,
					"content": "这、这样啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340907
					],
					"speakerTitle": "秀夫"
				},
				{
					"id": 120340907,
					"content": "我们这里的人，都会为柊小姐开路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340908
					],
					"speakerTitle": "冈林"
				},
				{
					"id": 120340908,
					"content": "不只是我们，你往前走会遇到更多天领奉行众，我们的职责都相同。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340909
					],
					"speakerTitle": "冈林"
				},
				{
					"id": 120340909,
					"content": "…这会不会太隆重了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340910
					],
					"speakerTitle": "秀夫"
				},
				{
					"id": 120340910,
					"content": "这样才显得九条大人很重视柊小姐，他希望从始至终都维持最高的规格。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340911
					],
					"speakerTitle": "冈林"
				},
				{
					"id": 120340911,
					"content": "我、我知道了…不好意思，打扰了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340912
					],
					"speakerTitle": "秀夫"
				},
				{
					"id": 120340912,
					"content": "糟了，糟了，和老爷的猜想完全一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340913
					],
					"speakerTitle": "秀夫"
				},
				{
					"id": 120340913,
					"content": "这些人说是在路上护卫，要是老爷不打算让柊小姐离开，这些人迟早会冲进离岛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340914
					],
					"speakerTitle": "秀夫"
				},
				{
					"id": 120340914,
					"content": "不对，柊小姐离开，这帮人更有理由冲进来了…跟天领奉行作对，现在老爷怎么有胜算啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340915
					],
					"speakerTitle": "秀夫"
				},
				{
					"id": 120340915,
					"content": "马上回去，得马上告诉老爷才行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340916
					],
					"speakerTitle": "秀夫"
				},
				{
					"id": 120340916,
					"content": "他跑掉了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340917,
						120340918
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120340917,
					"content": "吓得脸色苍白。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120340919
					]
				},
				{
					"id": 120340919,
					"content": "这样就差不多了，种子已经种下。如今的氛围，此起彼伏的猜忌，都会成为滋养恐惧的养分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340920
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 120340920,
					"content": "之后，就静待它的成长与发酵吧。最令人不安的，永远都是暴风雨前的宁静。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340921
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 120340921,
					"content": "他们真的会乖乖知错吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340922
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120340922,
					"content": "好奇的话，两天之后，你们去离岛看看柊家的情况。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340923
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 120340923,
					"content": "我还有许多事务要处理，就先不为这件事费神了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340924
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 120340924,
					"content": "——何况，该布的棋子已经落下，他们迟早会缴械投降。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340925
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 120340925,
					"content": "你这么自信吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120340926
					]
				},
				{
					"id": 120340926,
					"content": "也不是第一次处理这样的事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340927
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 120340927,
					"content": "那么，各位再会吧。我由衷希望柊千里能因此受益。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340928
					],
