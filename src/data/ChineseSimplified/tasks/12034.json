				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"新之丞"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120340401,
					"content": "谢谢你们，谢谢你们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340402
					],
					"speakerTitle": "新之丞"
				},
				{
					"id": 120340402,
					"content": "吓死我了，他们说要把我连人带笼子扔到海里去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340403
					],
					"speakerTitle": "新之丞"
				},
				{
					"id": 120340403,
					"content": "啊不对，小姐结婚…听我说，有人想利用小姐结婚的机会做坏事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340404
					],
					"speakerTitle": "新之丞"
				},
				{
					"id": 120340404,
					"content": "冷静点，新之丞，这个我们已经知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120340405,
					"content": "欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340406
					],
					"speakerTitle": "新之丞"
				},
				{
					"id": 120340406,
					"content": "关于这件事，我们有所察觉。迄今为止的发展，也与我想的相差不多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340407
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 120340407,
					"content": "想出这个计划的人不愿就此放弃，他们马上就会展开进一步行动，我们也要找到对策。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340408
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 120340408,
					"content": "社奉行大人，要亲自参与进来吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340409
					],
					"speakerTitle": "新之丞"
				},
				{
					"id": 120340409,
					"content": "这件事影响到三大奉行，事关整个稻妻的稳定，我的中立态度到此为止了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340410
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 120340410,
					"content": "将军大人向来厌恶无聊的权谋游戏。我作为将军麾下的奉行，有义务为她解决琐事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340411
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 120340411,
					"content": "也、也有道理…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340412
					],
					"speakerTitle": "新之丞"
				},
				{
					"id": 120340412,
					"content": "新之丞，你暂时不要回去，找个地方躲起来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340413
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 120340413,
					"content": "旅行者，派蒙，我们也离开这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340414
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 120340414,
					"content": "刚走了不久…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						120340415
					]
				},
				{
					"id": 120340415,
					"content": "哦，这不是社奉行大人嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340416
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340416,
					"content": "听说您无缘无故来到这个地方，还打伤了我的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340417
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340417,
					"content": "该不会，您正在秘密地进行什么行动吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340418
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340418,
					"content": "恰好听说有人滥用私刑，我身为富有责任心的稻妻官员，不愿坐视不理罢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340419
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 120340419,
					"content": "就算新之丞是您的家臣，律法也没有赋予您随意处置他的权力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340420
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 120340420,
					"content": "私刑？这怎么能算私刑，这只是管教而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340421
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340421,
					"content": "一个小卒，莫名其妙冲到小姐面前，张嘴就是一大堆自以为是又失礼的话，成何体统？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340422
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340422,
					"content": "小姐她啊，可是被吓得不轻呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340423
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340423,
					"content": "按您的意思，是全然不知道背后的缘由了？否则，又怎么会说这件事「莫名其妙」呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340424
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 120340424,
					"content": "两家联姻原是喜事，偏偏被自作聪明的小卒想得那么复杂。这般无中生有，不是莫名其妙，又是什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340425
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340425,
					"content": "柊小姐嫁去了九条家，也依然是柊家的大小姐，是勘定奉行最为尊贵的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340426
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340426,
					"content": "我们当然会忠心耿耿地侍奉她左右，为她扫清后顾之忧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340427
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340427,
					"content": "尽忠职守，本就是我们的原则。那小卒非但没有这般觉悟，反而挑拨小姐，是何用心？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340428
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340428,
					"content": "姑且算他是一腔热血好了，可高贵如您，不该有跟那小卒一样的想法啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340429
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340429,
					"content": "可恶，说起话来一套一套的…好叫人生气！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340430,
						120340431
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120340430,
					"content": "（阴阳怪气。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120340432
					]
				},
				{
					"id": 120340432,
					"content": "您这么一说，我倒是想起些事。自我出任社奉行以来，每天都能遇到不少有趣的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340433
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 120340433,
					"content": "外国的商贩告诉我，有一种鸟，舌头特别的长，能扯到嘴巴外面打上两个结。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340434
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 120340434,
					"content": "您也是有见识的人，要不要猜猜，这么珍奇的鸟类一般会拿来做什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340435
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 120340435,
					"content": "这…这…当成观赏用的宠物？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340436
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340436,
					"content": "呵呵，说来有趣，这种鸟啊，既不能当成宠物，也没有任何用处，哪怕抓到了，也只能剪掉它的舌头扔出窗外。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340437
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 120340437,
					"content": "因为大家都说：「舌头这么长，又爱强词夺理，叫得喳喳响，实际上嘛…却只是虚张声势而已。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340438
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 120340438,
					"content": "您…！社奉行大人，您来这里，就是为了对我们勘定奉行冷嘲热讽吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340439
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340439,
					"content": "怎么会呢。在我心中，勘定奉行的各位向来是刚正不阿，恪尽职守的良善之人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340440
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 120340440,
					"content": "这样的人，本不该像您这样，故弄玄虚，避重就轻，只为找一个理由把柊小姐拉下勘定奉行之位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340441
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 120340441,
					"content": "社奉行大人，说话要讲证据啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340442
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340442,
					"content": "证据不就在您和我的眼前吗？比如那位有力的人证，您见他说到了重点，可是急着要消灭他呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340443
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 120340443,
					"content": "哎呀呀，堂堂松浦家，也算名门大户了，没想到论起忠心，竟连一位普通役人都比不上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340444
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 120340444,
					"content": "读了书，做了官，到头来也只是耍些不上台面的小把戏。该说您是聪明，还是愚昧呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340445
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 120340445,
					"content": "您为将军办事，非但没能学到周围人一星半点的优秀，反倒被几分利益蒙蔽了双眼，自毁前程…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340468
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 120340468,
					"content": "我并不生气，松浦大人，我是在替您难过啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340446
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 120340446,
					"content": "…哈哈哈！是吗？那聪明的您，又能把我怎么样呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340447
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340447,
					"content": "这充其量是勘定奉行的家事，我们内部自有处理的方式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340448
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340448,
					"content": "您的手伸得这么长，连别人的家事也要管，那我是不是也可以擅自揣度一番大人您的用心呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340449
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340449,
					"content": "您只是不希望勘定奉行与天领奉行站到一起，三方关系失去平衡以至于威胁了社奉行的地位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340469
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340469,
					"content": "——才找了个光鲜的理由，来拆散我们两家联姻吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340450
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340450,
					"content": "嗯？原来在您看来是这样的啊。不得不说，您对三方利益的关注，实在是强过我太多太多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340451
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 120340451,
					"content": "实话告诉您吧，这个婚，现在是结也得结，不结也得结。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340452
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340452,
					"content": "现在公告已经贴出去了，消息飞满了整座稻妻城！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340453
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340453,
					"content": "市民本不知道九条镰治和柊千里的恋情，现在肯定到处都在讨论。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340454
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340454,
					"content": "自从消息公布的那一刻起，就算这件事还没成真，它也必须成真！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340455
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340455,
					"content": "嗯。原来是这样，看来我还是错了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340456
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 120340456,
					"content": "哈！您也知道啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340457
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340457,
					"content": "我原本觉得您再怎么说也比普通人聪明些，现在看来，却是大错特错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340458
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 120340458,
					"content": "神里绫人，你…！你居然！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340459
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340459,
					"content": "您这步棋已经下完，应该轮到我了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340460
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 120340460,
					"content": "…什么意思？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340461
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340461,
					"content": "难道您真心认为，结婚这件事是让勘定奉行和天领奉行站在一起吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340462
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 120340462,
					"content": "有没有可能，被孤立的反而是勘定奉行呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340463
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 120340463,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340464
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340464,
					"content": "嗯，和您聊天很长见识，我的话也说完了，就先告辞啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340465
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 120340465,
					"content": "喂，喂，我完全没搞懂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340466
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120340466,
					"content": "他们有他们的算计，幸好我事先也有所准备。如我所言，他们果然走到了台前。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340467
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 120340467,
					"content": "先回稻妻城看看现状，然后我把计划详细地告诉你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 120340431,
					"content": "（但确实难以找出破绽…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120340432
					]
				}
			]
		},
