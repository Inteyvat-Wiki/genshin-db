			"dialogs": [
				{
					"id": 120340701,
					"content": "九条家和柊家居然要办婚礼，这可真是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340702
					],
					"speakerTitle": "小百合"
				},
				{
					"id": 120340702,
					"content": "我有个亲戚在勘定奉行内部工作，我等会儿找她打听一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340703
					],
					"speakerTitle": "真理"
				},
				{
					"id": 120340703,
					"content": "她都从来没和我讲过这件事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "真理"
				}
