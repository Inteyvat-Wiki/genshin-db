				"points": []
			},
			"dialogs": [
				{
					"id": 120340201,
					"content": "可恶，我们走！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340202
					],
					"speakerTitle": "久保"
				},
				{
					"id": 120340202,
					"content": "得马上告诉老爷！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340203
					],
					"speakerTitle": "久保"
				},
				{
					"id": 120340203,
					"content": "喂，不准跑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120340204,
					"content": "不用追。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340205
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 120340205,
					"content": "有饵才有鱼，随他们去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340206
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 120340206,
					"content": "刚才战斗中他们似乎把钥匙掉在了地上，我们先把新之丞救出来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340207
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 120340207,
					"content": "不过，战斗中一片混乱，是被踢到哪里去了呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340208
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 120340208,
					"content": "欸？是狸猫，不会被狸猫拿走了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120340209,
					"content": "追上去看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "神里绫人"
				}
			]
		},
