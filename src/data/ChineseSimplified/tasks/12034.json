			},
			"dialogs": [
				{
					"id": 120340101,
					"content": "你们在干什么，放了新之丞！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120340102,
					"content": "马上停止你们的暴行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340103
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 120340103,
					"content": "居然是社奉行大人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340104
					],
					"speakerTitle": "久保"
				},
				{
					"id": 120340104,
					"content": "哼，我们只听命于老爷，也只为老爷负责。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340105
					],
					"speakerTitle": "久保"
				},
				{
					"id": 120340105,
					"content": "是吗…那就恕我失礼了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "神里绫人"
				}
			]
		},
		{
			"id": 1203402,
			"completionStepIds": [
				1203406
			],
