					"nextDialogs": [
						150170434
					]
				},
				{
					"id": 150170434,
					"content": "是啊，特别是我让她吃蔬菜的时候，她跑得可快了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170435
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150170435,
					"content": "跳过椅子，躲在桌子下面…在屋里绕啊绕，我怎么都追不上她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170436
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150170436,
					"content": "看着妮赫佳如今的样子，我已经满足了，再别无他求…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170437
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150170411,
					"content": "事情可真巧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170412
					]
				},
				{
					"id": 150170412,
					"content": "总而言之，我们还是先下去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150170403,
					"content": "他好像是自己跑上来的…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170404
					]
				}
