			"dialogs": [
				{
					"id": 150170101,
					"content": "喔！你们来得挺早啊，看来很期待那份礼物嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170102,
						150170105
					],
					"speakerTitle": "夏温"
				},
				{
					"id": 150170102,
					"content": "想探望特拉佐莉和妮赫佳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170103
					]
				},
				{
					"id": 150170103,
					"content": "对呀。妮赫佳生了那么一场大病，特拉佐莉女士还失去了那么重要的工作…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150170104,
					"content": "虽然情况好转了，但不知道她们能不能打起精神来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150170109,
					"content": "哈哈哈，我已经托人去给特拉佐莉打过招呼了，她应该已经做好了所有准备。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170110
					],
					"speakerTitle": "夏温"
				},
				{
					"id": 150170110,
					"content": "我们赶紧出发吧，伊蜜，麻烦你照顾好店，等会我就回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夏温"
				},
				{
					"id": 150170105,
					"content": "所以，那份礼物到底是什么…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170106
					]
				},
				{
					"id": 150170106,
					"content": "我也很在意…不过，我们也是想去看看妮赫佳的情况啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150170107,
					"content": "她生了那么重的病，不知道恢复得怎么样了，还有特拉佐莉女士…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150170108,
					"content": "失去了那么重要的工作，也不知道她能不能重新打起精神来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170109
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
