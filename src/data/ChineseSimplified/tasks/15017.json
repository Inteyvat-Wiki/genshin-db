			},
			"dialogs": [
				{
					"id": 150170401,
					"content": "真有一只嵴锋龙在上面，不知道是不是特拉佐莉女士养的那一只…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170402,
						150170403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150170402,
					"content": "看起来，不像是遇见危险。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170404
					]
				},
				{
					"id": 150170404,
					"content": "唔…不对不对，我们是来找特拉佐莉女士的，这周围也没看见她呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150170405,
					"content": "#喂——{NICKNAME}——派蒙——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170406
					],
					"speakerTitle": "夏温"
				},
				{
					"id": 150170406,
					"content": "夏温小姐在喊什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150170407,
					"content": "旁边多了一个人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170408
					]
				},
				{
					"id": 150170408,
					"content": "快下来吧——特拉佐莉在这里——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170409
					],
					"speakerTitle": "夏温"
				},
				{
					"id": 150170409,
					"content": "欸？我们刚上来，特拉佐莉女士就回来了？这叫什么事啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170410,
						150170411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150170410,
					"content": "总之先下去吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170413
					]
				},
				{
					"id": 150170413,
					"content": "这只嵴锋龙怎么跟上来了？呜啊，别突然冲过来呀，要撞到啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150170414,
					"content": "和嵴锋龙一起下到了山底…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150170415
					]
				},
				{
					"id": 150170415,
					"content": "延古，过来，你怎么又调皮了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170416
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150170416,
					"content": "呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170417
					],
					"speakerTitle": "延古"
				},
				{
					"id": 150170417,
					"content": "好孩子。是不是饿了？抱歉…等会就给你做好吃的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170418
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150170418,
					"content": "去吧，先去玩吧，等会我来陪你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170419
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150170419,
					"content": "呜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170420
					],
					"speakerTitle": "延古"
				},
				{
					"id": 150170420,
					"content": "抱歉二位。我本来是在家等着你们，但没想到妮赫佳却一个人偷偷跑了出去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170421
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150170421,
					"content": "我找到妮赫佳的时候，这孩子说，想要给客人做一份礼物，所以就想去采几束漂亮的花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170422
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150170422,
					"content": "她一边采花一边走，到最后居然迷了路…呼，幸好我及时找到了她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170423
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150170423,
					"content": "妮赫佳的身体没问题吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170424
					]
				},
				{
					"id": 150170424,
					"content": "我们听夏温小姐说，她的病才刚刚好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170425
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150170425,
					"content": "那孩子身体还是太虚弱了，先是受了惊，又吹了凉风，现在有些低烧。刚吃过药后，就回去睡着了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170426
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150170426,
					"content": "不是什么大问题，只要休息一晚上应该就能好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170427
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150170427,
					"content": "可是…她今天应该没办法和二位见面了，实在抱歉，让你们白跑了一趟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170428
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150170428,
					"content": "没有没有，不用道歉啦。我们之前听夏温小姐说，妮赫佳生了好严重的病，好不容易才痊愈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170429
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150170429,
					"content": "所以，我们今天想来看看妮赫佳的情况…无论如何，还是养好身体最重要啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170430,
						150170433
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150170430,
					"content": "她之前的病，已经痊愈了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170431
					]
				},
				{
					"id": 150170431,
					"content": "…至少，现在这孩子能和我说话，也能正常生活了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170432
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150170432,
					"content": "我已经满足了，再别无他求…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170437
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150170437,
					"content": "好啦好啦，你们怎么把气氛聊得这么低落。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170438
					],
					"speakerTitle": "夏温"
				},
				{
					"id": 150170438,
					"content": "小妮赫佳的心意，我们是已经感受到了。但是特拉佐莉，我之前和你说的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170439,
						150170440
					],
					"speakerTitle": "夏温"
				},
				{
					"id": 150170439,
					"content": "是礼物！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170441
					]
				},
				{
					"id": 150170441,
					"content": "喔！到底是什么礼物呀，现在能够告诉我们了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170442
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150170442,
					"content": "这份礼物，就是我制作的「燃晶名刻」。用最纯净的矿石打造，几乎不会被磨损。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170443
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150170443,
					"content": "制作它的技术，也全都源自于打造「古名」的技艺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170444
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150170444,
					"content": "那，那这不就是「简易古名」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170445
					]
				},
				{
					"id": 150170445,
					"content": "噗…可不能这么说，大灵也许会怪罪我的。我只是采用了打造古名的技艺，以矿石为原料，制作出这样的结晶体。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170446
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150170446,
					"content": "刚做出这样的结晶体时，我还觉得它除了「好看」和「永不磨损」之外，也没什么实际用途…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170447
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150170447,
					"content": "还是夏温给我出了个主意。她建议我，把这个结晶体做成一种特殊的「首饰」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170448
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150170448,
					"content": "「由『古名工匠』所打造的『燃晶名刻』，在上面镌刻下永不磨损的字句。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170449
					],
					"speakerTitle": "夏温"
				},
				{
					"id": 150170449,
					"content": "怎么样，听起来是不是还挺有购买欲望的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170450
					],
					"speakerTitle": "夏温"
				},
				{
					"id": 150170450,
					"content": "加上这么多描述之后，突然觉得这个「燃晶名刻」好厉害…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170451,
						150170452
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150170451,
					"content": "你挺会做生意的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170453
					]
				},
				{
					"id": 150170453,
					"content": "哈哈哈，但特拉佐莉制作的「燃晶名刻」确实很有意义啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170454
					],
					"speakerTitle": "夏温"
				},
				{
					"id": 150170454,
					"content": "口口相传的话语总是不牢靠的。在转述的过程中，它会变得残缺，逐渐被遗忘，甚至被讹传。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170455
					],
					"speakerTitle": "夏温"
				},
				{
					"id": 150170455,
					"content": "但如果将话语刻在这枚「燃晶名刻」上，就可以让它恒久存在。而且意义明确，绝无半点扭曲的可能！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170456
					],
					"speakerTitle": "夏温"
				},
				{
					"id": 150170456,
					"content": "无论是送给自己重要的朋友，心上的恋人，或是家里的后辈，都再合适不过了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170457,
						150170460
					],
					"speakerTitle": "夏温"
				},
				{
					"id": 150170457,
					"content": "你是不是开始推销了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170458
					]
				},
				{
					"id": 150170458,
					"content": "#说得我都快要心动了。唔，{NICKNAME}，不然我们也买一个吧，把我们的名字都刻上去？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170459
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150170459,
					"content": "#等我们找到你的{M#妹妹}{F#哥哥}之后，再让{M#她}{F#他}亲手把名字也刻上去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170462
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150170462,
					"content": "这样子，我们的名字就能永远挨在一起了，嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170463,
						150170495
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150170463,
					"content": "派蒙已经被吸引住了啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170464
					]
				},
				{
					"id": 150170464,
					"content": "你们可别推辞啊，你们救了我，也救了小妮赫佳的生日礼物。这笔钱我还是愿意出的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170465
					],
					"speakerTitle": "夏温"
				},
				{
					"id": 150170465,
					"content": "夏温，我之前和你说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170466
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150170466,
					"content": "你也不许推辞，特拉佐莉。我知道做一枚「燃晶名刻」要费多少功夫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170467
					],
					"speakerTitle": "夏温"
				},
				{
					"id": 150170467,
					"content": "#谢谢你，夏温。还有{NICKNAME}。我会尽快做出来的，到时候，再请你们来亲自刻写。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170468
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150170468,
					"content": "那个时候，小妮赫佳应该也恢复好了。有你们来探望，她一定会很高兴的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170469,
						150170496
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150170469,
					"content": "好东西独享也不太好…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170470
					]
				},
				{
					"id": 150170470,
					"content": "喂！你想得也太远了，这东西搞不好会很贵的喔，我们的旅费真的还够吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170471
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150170471,
					"content": "等一下，难道这份礼物其实是夏温小姐的计划，想把我们拖进一个超大的花钱陷阱里？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170472
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150170472,
					"content": "说不定喔，毕竟…你们看起来也有不少积蓄…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170473
					],
					"speakerTitle": "夏温"
				},
				{
					"id": 150170473,
					"content": "#呜哇！不行不行，{NICKNAME}，你可不能乱花钱！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170474
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150170474,
					"content": "哈哈哈，那你们就自己商量吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170475
					],
					"speakerTitle": "夏温"
				},
				{
					"id": 150170475,
					"content": "呜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170476
					],
					"speakerTitle": "延古"
				},
				{
					"id": 150170476,
					"content": "#咦？！它怎么又出来了，{NICKNAME}快拦住它！我不想再被撞啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170477
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150170477,
					"content": "乖乖的喔！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170478
					]
				},
				{
					"id": 150170478,
					"content": "呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170479
					],
					"speakerTitle": "延古"
				},
				{
					"id": 150170479,
					"content": "特拉佐莉，我还要麻烦你，帮忙修一下我这枚「燃晶名刻」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170480
					],
					"speakerTitle": "夏温"
				},
				{
					"id": 150170480,
					"content": "之前被袭击的时候，我把它落在地上，系绳和接口全都坏掉了，没法时刻随身戴着。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170481
					],
					"speakerTitle": "夏温"
				},
				{
					"id": 150170481,
					"content": "我自己也尝试修过，但怎么修都不牢固，只能拜托你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170482
					],
					"speakerTitle": "夏温"
				},
				{
					"id": 150170482,
					"content": "没问题。交给我吧！保证修得和原来一模一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170483
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150170483,
					"content": "…谢谢你，夏温。谢谢你愿意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170484
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150170484,
					"content": "没关系，特拉佐莉。只要小妮赫佳健康就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170485
					],
					"speakerTitle": "夏温"
				},
				{
					"id": 150170485,
					"content": "…嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170486
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150170486,
					"content": "延古！乖乖的，稍后我就来喂你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170487
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150170487,
					"content": "#{NICKNAME}，等「燃晶名刻」做好后，我会请夏温告诉你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170488
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150170488,
					"content": "说不定，还能赶上妮赫佳的生日，到时候我们就好好办个聚会吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170489
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150170489,
					"content": "嘿嘿，肯定有很多好吃的，到时候我们可得空着点肚子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170490
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150170490,
					"content": "那就回头见啦，特拉佐莉女士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170491,
						150170492
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150170491,
					"content": "到时候再见。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170493
					]
				},
				{
					"id": 150170493,
					"content": "再见，也祝你们健康。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170494
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150170494,
					"content": "…妮赫佳，会很高兴的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150170492,
					"content": "祝妮赫佳健康。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170493
					]
				},
				{
					"id": 150170496,
					"content": "干脆多买几个送人好了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170470
					]
				},
				{
					"id": 150170495,
					"content": "听起来有点太珍贵了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170464
					]
				},
				{
					"id": 150170460,
					"content": "我都快被说动了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170461
					]
				},
				{
					"id": 150170461,
					"content": "#买一个也不错呀。把我们的名字都刻上去。等我们找到你{M#妹妹}{F#哥哥}之后，再让{M#她}{F#他}亲手把名字也刻上去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170462
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150170452,
					"content": "不愧是开店的老板…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170453
					]
				},
				{
					"id": 150170440,
					"content": "期待期待，礼物礼物。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170441
					]
				},
				{
					"id": 150170433,
					"content": "她都能乱跑了，看来状况不错。",
