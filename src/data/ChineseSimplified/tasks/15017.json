				]
			},
			"dialogs": [
				{
					"id": 150170201,
					"content": "就是这里了。这屋子看着还挺气派的吧？稍等，我过去敲门。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170202
					],
					"speakerTitle": "夏温"
				},
				{
					"id": 150170202,
					"content": "特拉佐莉，开门吧，我把那两位带来啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170203
					],
					"speakerTitle": "夏温"
				},
				{
					"id": 150170203,
					"content": "…特拉佐莉？你在吗？开开门啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170204
					],
					"speakerTitle": "夏温"
				},
				{
					"id": 150170204,
					"content": "怪了，这门…呃，怎么是锁死的。这个时间她应该不会出去啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170205
					],
					"speakerTitle": "夏温"
				},
				{
					"id": 150170205,
					"content": "妮赫佳，妮赫佳？我是夏温姐姐，给我们开开门吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170206,
						150170207
					],
					"speakerTitle": "夏温"
				},
				{
					"id": 150170206,
					"content": "一点反应也没有…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170210
					]
				},
				{
					"id": 150170210,
					"content": "真奇怪，我都和特拉佐莉说好了…难道是她临时带着小妮赫佳出去拿药了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170211
					],
					"speakerTitle": "夏温"
				},
				{
					"id": 150170211,
					"content": "咦？这旁边是什么地方，看着像是小嵴锋龙的窝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150170212,
					"content": "没错，特拉佐莉有一只嵴锋龙伙伴，我记得名字好像是叫…「延古」来着。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170213
					],
					"speakerTitle": "夏温"
				},
				{
					"id": 150170213,
					"content": "之前她还在做锻造工作时，经常让延古帮忙做些挖掘工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170214
					],
					"speakerTitle": "夏温"
				},
				{
					"id": 150170214,
					"content": "但自从妮赫佳生病之后，特拉佐莉就再也没让延古挖掘过什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170215
					],
					"speakerTitle": "夏温"
				},
				{
					"id": 150170215,
					"content": "等等，这周围怎么乱七八糟的？延古也不见了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170216
					],
					"speakerTitle": "夏温"
				},
				{
					"id": 150170216,
					"content": "呜哇！还有好多箱子碎掉了，不会是遇见了什么坏事吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170217,
						150170218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150170217,
					"content": "靠近点看看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 150170218,
					"content": "夏温小姐先呆在这。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170219
					]
				},
				{
					"id": 150170219,
					"content": "喔…喔！好的，我…我我我这就找个地方藏起来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170220
					],
					"speakerTitle": "夏温"
				},
				{
					"id": 150170220,
					"content": "伊蜜这孩子的嘴难道是被大灵祝福过，怎么每次说我别去危险的地方，我就会遇见危险…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夏温"
				},
				{
					"id": 150170207,
					"content": "要把门撞开吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170208
					]
				},
				{
					"id": 150170208,
					"content": "难道特拉佐莉女士和妮赫佳又出事了？还是妮赫佳的病情又…呜…我不敢想了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150170209,
					"content": "你别瞎想，昨天我来的时候，她们母女俩的情况很好，妮赫佳在自己的屋里睡得可安稳了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170210
					],
					"speakerTitle": "夏温"
				}
			]
		},
