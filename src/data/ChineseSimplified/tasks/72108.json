					"五百藏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721080901,
					"content": "嗯嗯。干得很好，他们都很开心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080902
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080902,
					"content": "…嗯？哦，没问题，吾辈帮你问问他们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080903
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080903,
					"content": "「刑部小判」想问你们：「你们明明是人类，为啥身上却有狸子的气息哩？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080904
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080904,
					"content": "…对啊！给吾辈交待清楚！你们身上为什么有吾等的气味？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080905
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080905,
					"content": "欸？现在才问吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080906,
						721080907
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721080906,
					"content": "面具巫女小姐…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080908
					]
				},
				{
					"id": 721080908,
					"content": "对了！是有这么回事呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080909
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721080909,
					"content": "之前面具巫女小姐给我们吃了一顿好丰盛的大餐，说是用从妖狸一族那偷学来的法术，做出来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080910
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721080910,
					"content": "什么？竟然敢偷学吾等的法术…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080911
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080911,
					"content": "唔，难道说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080912
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080912,
					"content": "什么嘛，那个臭狐狸。如果还活着的话，那早点来跟吾辈打个招呼嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080913
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080913,
					"content": "是个戴着面具的巫女，说你是「老朋友」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080914
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721080914,
					"content": "面具？吾辈不知道什么面具，也不认识什么巫女。狐狸倒晓得一匹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080915
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080915,
					"content": "说起来，那个臭狐狸倒也用巫女的形象示人过。你说的那个巫女，长什么样子？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080916
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080916,
					"content": "戴着白狐面具…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080917
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721080917,
					"content": "别的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080918,
						721080920
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080918,
					"content": "黑色短发。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080919
					]
				},
				{
					"id": 721080919,
					"content": "穿着巫女服装。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080922
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721080922,
					"content": "呶…不认识。没见过这样的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080923
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080923,
					"content": "这样啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080924
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721080924,
					"content": "…嗯？嗯，好，包在吾辈身上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080925
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080925,
					"content": "「证城」想跟你们说：「和你们玩得很开心哩，谢谢！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080926
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080926,
					"content": "派蒙也很开心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080927
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721080927,
					"content": "那关于梳子…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080928
					]
				},
				{
					"id": 721080928,
					"content": "吾辈是名震天下的妖狸五百藏，当然会信守诺言。这把梳子就交给你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080929
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080929,
					"content": "不过，你们要这把梳子干什么？梳头吗？上面说不定有狐骚味呶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080930
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080930,
					"content": "是这样的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721080920,
					"content": "穿着巫女服装。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080921
					]
				},
				{
					"id": 721080921,
					"content": "黑色短发。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080922
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721080907,
					"content": "吃了很奇怪的东西…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080908
					]
				}
			]
