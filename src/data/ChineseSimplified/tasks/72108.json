				{
					"id": 721080801,
					"content": "呜呶呶…好想挠肚皮…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080802
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080802,
					"content": "呶？你这小辈怎么又回来了。帮吾辈找到「证城」、「刑部小判」和「吉法师」这<color=#00E1FFFF>三个小狸子</color>，陪他们玩玩吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080803
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080803,
					"content": "好了好了，快去吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "五百藏"
				}
			]
		},
		{
			"id": 7210809,
			"completionStepIds": [
				7210807
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
