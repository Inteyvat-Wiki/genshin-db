					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721080101,
					"content": "终于到了，这里就是镇守之森了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721080102,
					"content": "面具巫女小姐说，她有一个老朋友在镇守之森的深处。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721080103,
					"content": "那我们就赶紧动身吧，往深处去！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7210804,
			"completionStepIds": [
				7210816
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7210816",
							"2"
						],
						"stepId": 7210816,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7210810",
							"3"
						],
						"stepId": 7210810,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721080401,
					"content": "保管镇物的天狐雕像…的里面是空的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721080402,
					"content": "说不定是被那位面女的「老朋友」藏起来了吧。去问问看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721080403,
					"content": "面…面女？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080404
					]
				},
				{
					"id": 721080404,
					"content": "刚刚给她想的绰号。怎么样，是不是很好记？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080405,
						721080406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721080405,
					"content": "一点也不好记。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080407
					]
				},
				{
					"id": 721080407,
					"content": "唔嗯，那还是算了…总之，我们先找找线索吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721080406,
					"content": "不知所谓。莫名其妙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080407
					]
				}
			]
		},
		{
			"id": 7210807,
			"completionStepIds": [
				7210814
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7210814",
							"2"
						],
						"stepId": 7210814,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"五百藏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721080701,
					"content": "噫——我…吾吾吾辈正是五百藏，要、要杀要剐悉听尊便！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080702
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080702,
					"content": "哇，石像在说话！还吓得话都说不清了耶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080703
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721080703,
					"content": "吾辈才不是什么石像！只是暂时被人封印，变成了这个样子罢了！吾辈乃是名震天下的妖狸五百藏！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080704,
						721080705
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080704,
					"content": "五百藏？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080706
					]
				},
				{
					"id": 721080706,
					"content": "什么嘛，现在的小辈连五百藏的名号都不知道了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080707
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080707,
					"content": "《御苑狸戏画》、《五百藏茶壶》、《隐神大囃子》、《影向山骚动狸合战》…这些故事没听过吗？嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080708
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080708,
					"content": "吾辈到底被那个混小子封印了多少年呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080709,
						721080711
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080709,
					"content": "我没有恶意…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080710
					]
				},
				{
					"id": 721080710,
					"content": "什么嘛，不是来「收拾」吾辈的吗，怎么不早说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080719
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080719,
					"content": "咳咳。说！你们来找贵为妖狸大王的吾辈，是来干啥的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080720,
						721080722
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080720,
					"content": "「神樱大祓」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080721
					]
				},
				{
					"id": 721080721,
					"content": "神鹰大斧？那是什么？是鬼族的宝具吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080726
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080726,
					"content": "真是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080727
					]
				},
				{
					"id": 721080727,
					"content": "欸，他真的是面具巫女小姐说的老朋友吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080728
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721080728,
					"content": "总之，我们在找藏在狐狸雕像里的一件物品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080729
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721080729,
					"content": "噫——找、找找那个东西干什么？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080730,
						721080731
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080730,
					"content": "哇。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080732
					]
				},
				{
					"id": 721080732,
					"content": "就是那把梳子，害得吾辈被封印了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080733
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080733,
					"content": "…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080734,
						721080735,
						721080736
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080734,
					"content": "一百年？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080737
					]
				},
				{
					"id": 721080737,
					"content": "吾辈也不知道多久！镇守之森这里整天看不到日月光，没办法算时间啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080738
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080738,
					"content": "当时呀，吾辈为了引出那个臭狐狸，到处大闹，也没有什么结果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080739
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080739,
					"content": "吾辈想把那个狐狸雕像拆了泄愤时，在里头发现了那把梳子，就心生妙计！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080740
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080740,
					"content": "那把梳子藏在狐狸雕像里，上面还有白辰的形象，又想到那一身白毛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080741
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080741,
					"content": "吾辈马上就察觉到，这把梳子肯定很重要。如果要把那个臭狐狸引出来，把梳子藏起来就好啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080742
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080742,
					"content": "嗯嗯，用宝藏吸引人确实很有用！结果呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080743
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721080743,
					"content": "结果来了个以前「影向役者三人组」里的人类，把吾辈和同族的小子们好生一顿修理，咔嚓咔嚓地全变成了石头。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080744
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080744,
					"content": "这就是五百藏怕人的原因嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080745
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721080745,
					"content": "哼！人这种东西，寿命又短，又不会变化，不知道那个臭狐狸为什么这么偏袒他们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080746
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080746,
					"content": "那个封印吾辈的家伙尤其过分，还说着什么「嗯嗯。封印的时候，摆出了好姿势哪。可以做个景观呢」之类的话，气死了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080747
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080747,
					"content": "确实是不错的景观…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080748
					]
				},
				{
					"id": 721080748,
					"content": "呶？你这小辈，怎么也…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080749
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080749,
					"content": "#（喂，{NICKNAME}，要是惹他生气，拿不到镇物怎么办…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080750,
						721080751
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721080750,
					"content": "意思是您魁梧豪放…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080752
					]
				},
				{
					"id": 721080752,
					"content": "就、就是呀，在这个黑黝黝的林子里，可是增添了不少光彩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080753
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721080753,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080754
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080754,
					"content": "再展开说说？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080755,
						721080756
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080755,
					"content": "宛如一尊神像…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080757
					]
				},
				{
					"id": 721080757,
					"content": "哎呀，所以说…被封印也不是那么坏的事嘛，人也没有恶意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080758
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721080758,
					"content": "虽然你说得好像有点道理，但又好像不是那么回事…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080759
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080759,
					"content": "那把梳子，能借来看看么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080760
					]
				},
				{
					"id": 721080760,
					"content": "也不是不行，不过你们得陪孩子们玩玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080761
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080761,
					"content": "#嗯，这个好办。{NICKNAME}最会陪小孩子玩了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080762,
						721080763
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721080762,
					"content": "其实我不擅长对付小孩子…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080765
					]
				},
				{
					"id": 721080765,
					"content": "「证城」、「刑部小判」和「吉法师」。在森林里找找他们<color=#00E1FFFF>三个小狸子</color>，陪他们玩玩吧。毕竟，吾辈也没办法自由行动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080766
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080766,
					"content": "因为封印他们的时候，那个混小子不太认真，所以前段时间，有些小家伙就跑出来啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080767
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080767,
					"content": "…不对，应该说是吾等妖狸法力强大，能挣脱区区人类的封印是再正常不过了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080768,
						721080770
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080768,
					"content": "那你自己…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080769
					]
				},
				{
					"id": 721080769,
					"content": "咳咳！法力强大！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080771
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721080771,
					"content": "虽然跟吾辈五百藏的法力不能比，但它们也会一点法术，能够隐藏自己的身形。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080772
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080772,
					"content": "好了好了，快去吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080770,
					"content": "法力强大！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080771
					]
				},
				{
					"id": 721080763,
					"content": "没错，我经常和派蒙玩。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080764
					]
				},
				{
					"id": 721080764,
					"content": "喂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080765
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721080756,
					"content": "七天神像都自愧弗如…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080757
					]
				},
				{
					"id": 721080751,
					"content": "意思是您俊朗健壮…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080752
					]
				},
				{
					"id": 721080735,
					"content": "一千年？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080737
					]
				},
				{
					"id": 721080736,
					"content": "一百万年？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080737
					]
				},
				{
					"id": 721080731,
					"content": "有反应了耶。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080732
					]
				},
				{
					"id": 721080722,
					"content": "这里的「镇物」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080723
					]
				},
				{
					"id": 721080723,
					"content": "蒸物？是吃的吗？我们妖狸对料理倒是颇有心得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080724
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080724,
					"content": "不是啦，是「神樱大祓」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080725
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721080725,
					"content": "大福？啊，好久没吃过大福了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080726
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080711,
					"content": "我是来讨债的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080712
					]
				},
				{
					"id": 721080712,
					"content": "咿，讨债？！在哪里，什么时候？我想想，我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080713
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080713,
					"content": "你这张脸，你这个人…唔…吾辈欠了什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080714
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080714,
					"content": "对方煞有其事地开始回忆了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080715
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721080715,
					"content": "喂，不要对陌生人开这种玩笑啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080716
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721080716,
					"content": "什么嘛，别开这种玩笑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080717
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080717,
					"content": "嗯，没有就好，没有就好…吾辈还是确认下，真的没欠你们什么东西吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080718
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080718,
					"content": "…你难道欠了很多债吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080719
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721080705,
					"content": "名震天下？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080706
					]
				}
			]
		},
		{
			"id": 7210808,
