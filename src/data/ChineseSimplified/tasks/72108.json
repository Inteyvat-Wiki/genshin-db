						721081106
					]
				},
				{
					"id": 721081106,
					"content": "这就是妖狸的法术吗！感觉很好玩的样子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721081107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721081107,
					"content": "谢谢你，「吉法师」！下次我们再一起玩捉迷藏吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721081108
