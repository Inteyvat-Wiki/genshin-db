			"dialogs": [
				{
					"id": 721080931,
					"content": "什么嘛，原来是这么重要的东西，早说嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080932
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080932,
					"content": "弄得吾辈被莫名其妙封印了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080933,
						721080934,
						721080935
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080933,
					"content": "一百年？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080936
					]
				},
				{
					"id": 721080936,
					"content": "呶！别说风凉话了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080937
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080937,
					"content": "算了算了，都是过去的事了。森林附近的结界的事情，吾辈也有点眉目。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080938
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080938,
					"content": "以前跟那个臭狐狸斗法的时候，吾辈曾在东方海边见到过。是棵雷樱树的模样，加上鸟居对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080939
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080939,
					"content": "以前因为看过那家伙在那和什么妖怪战斗，吾辈担心会有别的妖怪从里面跑出来害我的树林，就用法术把那个地方封起来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080940
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080940,
					"content": "我想想。封印在东边的崖壁下…「吉法师」，你去那边，帮他们把封印解开。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080941
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080941,
					"content": "谢谢你，五百藏。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080942
					]
				},
				{
					"id": 721080942,
					"content": "好了好了，别说这些。快去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080943
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080943,
					"content": "如果见到了那个臭狐狸，记得帮吾辈带个好。就说…我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080944
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080944,
					"content": "「混帐东西，气死我了。快回来跟吾辈斗法，我们之间的胜负还没分清呢！顺便帮吾辈解开封印！对了，倒不是吾辈自己不能解除封印，只是臭狐狸你还欠吾辈几个人情呢！『刑部小判』说他想你了！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080945
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080945,
					"content": "好长！太长啦！谁记得住啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721080934,
					"content": "一千年？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080936
					]
				},
				{
					"id": 721080935,
					"content": "一百万年？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080936
					]
				}
