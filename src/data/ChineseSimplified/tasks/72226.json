					"阿瑠"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722260301,
					"content": "#谢谢你们，{NICKNAME}{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}、派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260302
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722260302,
					"content": "栖木的状态很好，这回的祭典一定会很顺利的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260303,
						722260304
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722260303,
					"content": "轻轻松松。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722260305
					]
				},
				{
					"id": 722260304,
					"content": "非常可怕。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722260305
					]
				},
				{
					"id": 722260305,
					"content": "#哼哼。再怎么说，我和{NICKNAME}也是见识过很多东西的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722260306,
					"content": "#这么说来，{NICKNAME}{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}，你们是从哪里来的呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260307
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722260307,
					"content": "之前也有听来的人说过「稻妻」、「鸣神岛」之类的地方，你们也是稻妻人吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260308,
						722260312
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722260308,
					"content": "相对而言的话…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722260309
					]
				},
				{
					"id": 722260309,
					"content": "我们确实是从鸣神岛来的呢…啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722260310,
					"content": "我都快忘了我们是来找木簧笛的了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722260311,
					"content": "我们是从很远很远的地方来的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722260312
					]
				},
				{
					"id": 722260312,
					"content": "的确呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722260313,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260314
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722260314,
					"content": "好厉害！还可以爬到龙的头上！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260315,
						722260316
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722260315,
					"content": "虽然爬起来一点也不舒服就是了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722260317
					]
				},
				{
					"id": 722260316,
					"content": "还好啦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722260317
					]
				},
				{
					"id": 722260317,
					"content": "好厉害呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260318
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722260318,
					"content": "世界很大的哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722260319,
					"content": "没想到「雾海」外面还有这么多地方、这么多人。如果有一天能出去，去看看这些地方就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260320
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722260320,
					"content": "别人总说，只要离开雾气，灵魂就会迷失。因为有雾气，所以外面的黑暗才不会侵入鹤观。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260321
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722260321,
					"content": "不过，我认识了很多外面来的人哦。所以我知道，寂海里其实也是有人住的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260322
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722260322,
					"content": "有机会一起去看看吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722260323
					]
				},
				{
					"id": 722260323,
					"content": "嗯。那就说好了喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260324
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722260324,
					"content": "#{NICKNAME}{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}，你们先走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260325
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722260325,
					"content": "等祭典结束以后，我们就一起到鹤观以外的地方看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260326
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722260326,
					"content": "嗯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿瑠"
				}
			]
		},
