			"dialogs": [
				{
					"id": 221050101,
					"content": "真烦人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050102
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 221050102,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221050103
					]
				},
				{
					"id": 221050103,
					"content": "我总感觉这客栈周围怪怪的，又说不出来个所以然。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050104
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 221050104,
					"content": "而且我们这客栈里，又都是住着些格外敏感的人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050105
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 221050105,
					"content": "一有什么风吹草动，门窗总会掉几扇，说不定楼板都要破几块。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050106
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 221050106,
					"content": "虽然客人们都会自己出钱修，但是这东一块西一块的，太难看了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050107
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 221050107,
					"content": "您能帮我去客栈周围看看吗？有什么怪地方，就…处理一下，我还要在这接待客人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050108,
						221050109
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 221050108,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221050110
					]
				},
				{
					"id": 221050110,
					"content": "那就拜托您了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 221050109,
					"content": "这些客人…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221050111
					]
				},
				{
					"id": 221050111,
					"content": "客人？哎呀，不用在意，常年在野外摸爬滚打的人，免不了过度敏感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050112
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 221050112,
					"content": "那么就拜托您了，就是去周围看看，应该也不会出什么事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菲尔戈黛特"
				}
			]
		},
