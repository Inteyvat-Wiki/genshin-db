				"objectNames": [
					"阿创",
					"天目十五"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120110301,
					"content": "阿创，天目先生！我来啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110302
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120110302,
					"content": "啊，是宵宫啊，要是我没猜错，是烟花材料的事对吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110303
					],
					"speakerTitle": "阿创"
				},
				{
					"id": 120110303,
					"content": "看来大家都知道，宵宫你在烟花会之前会很忙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120110304,
					"content": "很抱歉，但能不能稍等一会儿，正好武器的订单也堆了好多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110305
					],
					"speakerTitle": "阿创"
				},
				{
					"id": 120110305,
					"content": "这个没关系，啊，不对，也不是完全没关系…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110306
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120110306,
					"content": "这样吧！你需要帮手吗？只要做完这些武器的订单，就可以帮我加工矿石了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110307
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120110307,
					"content": "这…得看师父是不是答应…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110308
					],
					"speakerTitle": "阿创"
				},
				{
					"id": 120110308,
					"content": "没关系的吧，天目先生！你也知道的，「长野原烟花会」马上要开始了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110309
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120110309,
					"content": "我到现在还有好多人的烟花没有做，如果没做好的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110310
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120110310,
					"content": "还是这么吵闹啊，小丫头。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110311
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 120110311,
					"content": "「天目流」的锻造，讲究耐心与全力以赴，倘若内心急躁，一定会反映在锻出的刀剑之上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110312
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 120110312,
					"content": "有人在旁边等待与催促，只会乱了阿创的心神。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110313
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 120110313,
					"content": "但、但是，这是很特殊的情况，「长野原烟花会」就在眼前…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110314
					],
					"speakerTitle": "阿创"
				},
				{
					"id": 120110314,
					"content": "所以，矿石交给我吧，我来加工。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110315
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 120110315,
					"content": "欸？！师父要亲自上手？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110316
					],
					"speakerTitle": "阿创"
				},
				{
					"id": 120110316,
					"content": "不要大惊小怪，这是唯一的办法了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110317
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 120110317,
					"content": "谢谢天目先生愿意帮忙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110318
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120110318,
					"content": "不客气，「长野原烟花会」是很重要的事，我也明白。再加上以前龙之介很关照我的生意，我没有理由不帮忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110319
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 120110319,
					"content": "不过宵宫啊，以后还是要更有计划，不要每次都搞得很匆忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110320
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 120110320,
					"content": "嘿嘿，我尽量。以后我会准备更多材料来应付突发情况的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110321
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120110321,
					"content": "唉，不过对你来说，就算准备再多，也不一定够用吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110322
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 120110322,
					"content": "总之，等我一会儿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110323
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 120110323,
					"content": "不愧是天目先生，看这颗粒的形状和粗细…不知道该怎么形容，太漂亮了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110324
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120110324,
					"content": "就算很久没有看你拿工具了，手艺还是这么精湛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110325
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120110325,
					"content": "那当然，从小学到大的东西，想忘掉都难。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110326
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 120110326,
					"content": "很久以前，天目流就和「长野原烟花会」在合作了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110327
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120110327,
					"content": "那时候是我的师父，和龙之介的爸爸。虽然人换了一代又一代，但烟花要的东西，都差不多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110328
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 120110328,
					"content": "阿创，以后就轮到你做出这样的东西了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110329
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 120110329,
					"content": "知道了，知道了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110330
					],
					"speakerTitle": "阿创"
				},
				{
					"id": 120110330,
					"content": "哈哈哈，那就不多打扰你们啦，别忘了去看烟花哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110331
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120110331,
					"content": "#好了，{NICKNAME}，我们走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110332
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120110332,
					"content": "现在耕一可能还没有回来，我们先过去等他好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宵宫"
				}
			]
		},
