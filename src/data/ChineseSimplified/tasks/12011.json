	"talks": [
		{
			"id": 1201101,
			"completionStepIds": [
				1201101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201101",
							"2"
						],
						"stepId": 1201101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"耕一"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120110101,
					"content": "耕一！我来啦，怎么样，船的事情还顺利吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110102
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120110102,
					"content": "嗯，还行吧，虽然免不了被人盘问…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110103
					],
					"speakerTitle": "耕一"
				},
				{
					"id": 120110103,
					"content": "等等，在外人面前讨论这个真的没事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110104
					],
					"speakerTitle": "耕一"
				},
				{
					"id": 120110104,
					"content": "#没关系，没关系，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}们是我的朋友，信得过！我们都是为了船的事来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110105
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120110105,
					"content": "嗯，我们都是一条船上的人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120110106,
					"content": "请多指教。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120110107
					]
				},
				{
					"id": 120110107,
					"content": "原来如此，抱歉，不是怀疑你们，只是以防万一。船我已经准备好了，但我不能大摇大摆地把它划到附近。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110108
					],
					"speakerTitle": "耕一"
				},
				{
					"id": 120110108,
					"content": "欸？这是为什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120110109,
					"content": "因为锁国令嘛，天领奉行现在对船过分敏感，就连很小的小船都要盘问用途，很麻烦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110110
					],
					"speakerTitle": "耕一"
				},
				{
					"id": 120110110,
					"content": "我明白，真的很抱歉，把你卷进来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110111
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120110111,
					"content": "哈哈，客气什么，你愿意找我帮忙，我高兴还来不及呢。这次又麻烦你们家做烟花了，这艘船就算是我的谢礼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110112
					],
					"speakerTitle": "耕一"
				},
				{
					"id": 120110112,
					"content": "那我这就去把船弄过来，你们稍微等一会儿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110113
					],
					"speakerTitle": "耕一"
				},
				{
					"id": 120110113,
					"content": "嗯，谢谢你！如果你顺路的话，就去我家取烟花吧，都是按纸条上的记录做的，非常完美，一点不差。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110114
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120110114,
					"content": "好嘞。正好烟花会很快就要开始了，也给你的新朋友们见识见识吧，这可是稻妻的特色。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110115
					],
					"speakerTitle": "耕一"
				},
				{
					"id": 120110115,
					"content": "#本来就是这么打算的。哎，要不然，干脆你给{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_MALE_PRONOUN_SHE]}们讲讲你的过去，就是你第一次来我们家定制烟花的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110116
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120110116,
					"content": "这个就说来话长了，我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110117
					],
					"speakerTitle": "耕一"
				},
				{
					"id": 120110117,
					"content": "啊！要不然，我先把船运到附近再说吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110118
					],
					"speakerTitle": "耕一"
				},
				{
					"id": 120110118,
					"content": "哦，对对对，哎呀，聊到兴头上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110119
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120110119,
					"content": "你先去忙吧，宵宫，等会儿还在这里见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110120
					],
					"speakerTitle": "耕一"
				},
				{
					"id": 120110120,
					"content": "嘿嘿，幸好被他提醒，不然又要因为聊天耽误事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110121
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120110121,
					"content": "前几天一直在赶工做烟花，没什么时间和别人聊天，都快憋死我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110122
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120110122,
					"content": "老爹虽然很喜欢听我说话，但因为耳朵不好嘛，很难给出一些让人惊喜的反应。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110123
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120110123,
					"content": "——又扯远了，我想说的是，趁耕一去准备船的时间，我们可以去找找看烟花的材料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110124
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120110124,
					"content": "不只是要帮你们做，还要帮找「大貉妖」的孩子们和朔次郎做，材料缺了很多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110125
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120110125,
					"content": "实在麻烦的话，不用为我们费心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120110126
					]
				},
				{
					"id": 120110126,
					"content": "那怎么行呢，不用在意我。其实每年的烟花会都是这样，会接到很多中途插进来的订单。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110127
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120110127,
					"content": "会放烟花的人，都是为了纪念某件事。这种纪念错过了说不定就没机会了，所以就算再忙，也要全部答应下来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110128
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120110128,
					"content": "所以，你是想说，你很享受这件事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120110129,
					"content": "享受是很享受啦，生在烟花世家，好像从小就迷恋了这种「砰」地炸出光来的感觉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110130
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120110130,
					"content": "但其实我想说的还是，不用担心我，没问题的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110131,
						120110132
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120110131,
					"content": "原来重点在这里…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120110133
					]
				},
				{
					"id": 120110133,
					"content": "不好意思不好意思，只是和烟花一样，感兴趣的话题也是稍纵即逝的东西，一定要在有兴致的时候说个痛快，不留遗憾！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110134
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120110134,
					"content": "接下来跟我去城里转两圈吧，我打算去找熟人碰碰运气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120110132,
					"content": "附加了好多信息。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120110133
					]
				}
			]
		},
		{
			"id": 1201102,
			"completionStepIds": [
				1201102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201102",
							"2"
						],
						"stepId": 1201102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"森彦"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120110201,
					"content": "你好啊，森彦，这几天的工作还顺利吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110202
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120110202,
					"content": "哈哈，宵宫，我就知道，你果然来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110203
					],
					"speakerTitle": "森彦"
				},
				{
					"id": 120110203,
					"content": "寒暄就不必了，是来找烟花材料的对吧，我专门给你留了一袋，数量肯定是够了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110204
					],
					"speakerTitle": "森彦"
				},
				{
					"id": 120110204,
					"content": "欸？真的吗？为什么你会知道？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110205
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120110205,
					"content": "每次临近烟花会，你就会到处打听有没有矿石材料，有急用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110206
					],
					"speakerTitle": "森彦"
				},
				{
					"id": 120110206,
					"content": "我都习惯啦，你总是要做计划之外的烟花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110207
					],
					"speakerTitle": "森彦"
				},
				{
					"id": 120110207,
					"content": "抱歉，每次都麻烦你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110208
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120110208,
					"content": "瞧你这话说的，就算手上的生意不做了，你提的要求我都不能拒绝啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110209
					],
					"speakerTitle": "森彦"
				},
				{
					"id": 120110209,
					"content": "这边的两位，难道就是这次的委托人吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110210,
						120110211
					],
					"speakerTitle": "森彦"
				},
				{
					"id": 120110210,
					"content": "你好，帮大忙了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120110212
					]
				},
				{
					"id": 120110212,
					"content": "哈哈，小事小事，用不着客气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110213
					],
					"speakerTitle": "森彦"
				},
				{
					"id": 120110213,
					"content": "之前我和我孩子吵架的时候，还是宵宫出面安慰他的呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110214
					],
					"speakerTitle": "森彦"
				},
				{
					"id": 120110214,
					"content": "我真是不擅长和他打交道，要不是宵宫，他说不定会离家出走…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110215
					],
					"speakerTitle": "森彦"
				},
				{
					"id": 120110215,
					"content": "不会的，他是个心思很细腻的孩子，很在乎你的感受，只是…他也不知道要怎么跟你表达。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110216
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120110216,
					"content": "如果你的表情不要那么凶，他可能也不会紧张。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110217
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120110217,
					"content": "嗯，大概是我平时对他太严肃了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110218
					],
					"speakerTitle": "森彦"
				},
				{
					"id": 120110218,
					"content": "明明和外面的人聊天，我觉得我没什么架子啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110219
					],
					"speakerTitle": "森彦"
				},
				{
					"id": 120110219,
					"content": "没关系没关系，人人都有不擅长的事嘛。以后要是还有类似的麻烦事，来找我就好啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110220
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120110220,
					"content": "就算不是烟花的委托也没关系，顾客至上嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110221
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120110221,
					"content": "嘿嘿，好的好的，怪不得大家都夸你是个好孩子，龙之介先生肯定也很欣慰吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110222
					],
					"speakerTitle": "森彦"
				},
				{
					"id": 120110222,
					"content": "那矿石就尽管拿去用，摩拉就不用付了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110223
					],
					"speakerTitle": "森彦"
				},
				{
					"id": 120110223,
					"content": "欸，不行不行，这肯定不行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110224
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120110224,
					"content": "没关系啦，就当是我给你的谢礼，不用客气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110225
					],
					"speakerTitle": "森彦"
				},
				{
					"id": 120110225,
					"content": "但人情是人情，做生意要讲规矩，可不要为难我啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110226
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120110226,
					"content": "有什么关系，你就收下吧，接下来你还有很多其他事要忙，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110227
					],
					"speakerTitle": "森彦"
				},
				{
					"id": 120110227,
					"content": "那，这样吧，就不用付摩拉了，我记在账本上。以后来我这里做烟花，都用这个抵扣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110228
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120110228,
					"content": "唉呀，你这孩子真是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110229
					],
					"speakerTitle": "森彦"
				},
				{
					"id": 120110229,
					"content": "行吧，这样也好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110230
					],
					"speakerTitle": "森彦"
				},
				{
					"id": 120110230,
					"content": "帮我给你老爹带个好，祝他身体健康，能一直乐乐呵呵的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110231
					],
					"speakerTitle": "森彦"
				},
				{
					"id": 120110231,
					"content": "嗯嗯，你也注意身体，别那么拼了，当心老伤复发。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110232
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120110232,
					"content": "宵宫很受欢迎呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110233,
						120110237
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120110233,
					"content": "像是有求必应的热心肠。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120110234
					]
				},
				{
					"id": 120110234,
					"content": "以前也有人这么说，而且真的会有人觉得我有求必应。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110235
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120110235,
					"content": "这时候我就会说，「喂，这不是烟花店该干的事啊！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110236
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120110236,
					"content": "但是，哎呀，很多时候他们都不听我的话。没办法，但也没什么所谓对吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110240
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120110240,
					"content": "总之，现在矿石材料到手了，接下来就去找人加工吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110241
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120110241,
					"content": "这样材料的问题就解决了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120110237,
					"content": "烟花对稻妻人这么重要吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120110238
					]
				},
				{
					"id": 120110238,
					"content": "想要纪念什么的时候，自然需要一些又热闹又漂亮的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110239
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120110239,
					"content": "但我觉得，是大家的信任更重要，要是没有客人的光顾，我家的生意就做不下去了呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110240
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120110211,
					"content": "给你添麻烦了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120110212
					]
				}
			]
		},
		{
			"id": 1201103,
