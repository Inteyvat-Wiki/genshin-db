				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"李丁"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10080201,
					"content": "仙人饶命！仙人饶命…求仙人网开一面，放我们兄弟一条生路，仙人饶命，仙人饶命…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080202
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10080202,
					"content": "你怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080203
					]
				},
				{
					"id": 10080203,
					"content": "你，你…你是谁？怎么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080204
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10080204,
					"content": "明明是我们在提问…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10080205,
					"content": "啊！您能在这绝云间安全行走…我知道了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080206
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10080206,
					"content": "您一定是…仙使吧！是仙人派您来解救我兄弟的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080207
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10080207,
					"content": "这个人到底在说什么呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10080208,
					"content": "仙使慈悲，求仙使搭救！我们两兄弟只因实在无钱供养家里，又听人说，琥牢山中的琥珀藏有宝物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080209
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10080209,
					"content": "一时间犯了糊涂，只想从山中琥珀里寻得几件宝物，卖了钱，再回去接济家里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080210
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10080210,
					"content": "我们<color=#00E1FFFF>顺着山路</color>一路往上，但不曾想，我兄弟李当就突然被琥珀给…给吃了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080211
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10080211,
					"content": "我一路奔逃到了这里，细细想来，只怕是我们冲撞了仙家府邸，这是仙人下的惩诫…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080212
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10080212,
					"content": "我不知道如何搭救我兄弟，只能在此求仙人开恩…恳求许久，才等来了二位仙使…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080213
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10080213,
					"content": "仙使？我们不是什么仙使，我们也是来找仙人的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10080214,
					"content": "不，不不不，你们肯定是仙使，你们肯定是仙使！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080215
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10080215,
					"content": "李当被关在山里不知道哪个琥珀里面，求仙使慈悲，求仙使搭救…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080216,
						10080218
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10080216,
					"content": "好吧…我去看看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080217
					]
				},
				{
					"id": 10080217,
					"content": "好，好！谢谢仙使慈悲，我等以后再也不敢了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "李丁"
				},
				{
					"id": 10080218,
					"content": "本仙知道了，此后莫再犯糊涂。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080219
					]
				},
				{
					"id": 10080219,
					"content": "呜哇…你还真的入戏了，而且还挺有「仙使」气势的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10080220,
					"content": "谢谢仙使，谢谢仙使，我等以后再也不敢了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "李丁"
				}
			]
		},
		{
			"id": 100806,
			"completionStepIds": [
				100806
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
