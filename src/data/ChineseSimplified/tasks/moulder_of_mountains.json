	"talks": [
		{
			"id": 100802,
			"completionStepIds": [
				100802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"100802",
							"2"
						],
						"stepId": 100802,
						"stateName": "QUEST_STATE_UNFINISHED"
