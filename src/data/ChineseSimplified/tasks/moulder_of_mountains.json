						"stepId": 100806,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"100802",
							"3"
						],
						"stepId": 100802,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"李丁"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10080601,
					"content": "谢谢仙使，谢谢仙使救我兄弟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080602
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10080602,
					"content": "你们见过仙人吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080603
					]
				},
				{
					"id": 10080603,
					"content": "啊？我们…我们也只是听说，这琥牢山是仙人府邸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080604
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10080604,
					"content": "但我们这种凡夫俗子，自然是无缘得见仙人的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080605
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10080605,
					"content": "不过您贵为仙使，肯定与我们不同。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080606
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10080606,
					"content": "啊，对了，可不能再叨扰仙府，我们这就下山，谢谢仙使…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080607
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10080607,
					"content": "谢谢仙使…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080608
					],
					"speakerTitle": "李当"
				},
				{
					"id": 10080608,
					"content": "…要是我们真是什么「仙使」就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080609
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10080609,
					"content": "总感觉，这位仙人的脾气不太好呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080610
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10080610,
					"content": "不过我们也没有做什么坏事，应该也不会…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089601
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10089601,
					"content": "擅扰山门，又私放受诫贼人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089602
					],
					"speakerTitle": "理水叠山真君"
				},
				{
					"id": 10089602,
					"content": "无知凡众，还不速速前来领诫！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "理水叠山真君"
				}
			]
		},
		{
			"id": 100807,
			"completionStepIds": [
				100807
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"100807",
							"2"
						],
						"stepId": 100807,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"理水叠山真君"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10080701,
					"content": "…不仅闯入「琥牢山」，毁坏山上琥珀，还擅放了正受诫的贼人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080702
					],
					"speakerTitle": "理水叠山真君"
				},
				{
					"id": 10080702,
					"content": "这帮贼人确是不晓仙威，但你们，也同样无礼至极。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080703
					],
					"speakerTitle": "理水叠山真君"
				},
				{
					"id": 10080703,
					"content": "呜啊！我们，我们是有理由的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080704,
						10080706
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10080704,
					"content": "请看这个…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080705
					]
				},
				{
					"id": 10080705,
					"content": "…「百无禁忌箓」，没想到世间还有此物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080708
					],
					"speakerTitle": "理水叠山真君"
				},
				{
					"id": 10080708,
					"content": "哦？这是「百无禁忌箓」？世间居然还有此物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080709
					],
					"speakerTitle": "理水叠山真君"
				},
				{
					"id": 10080709,
					"content": "昔日帝君铸此神箓，赐予凡人，本就数量稀少，千百年来也散失得差不多了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080710
					],
					"speakerTitle": "理水叠山真君"
				},
				{
					"id": 10080710,
					"content": "你们先陈明详情吧，我会听你们说的，稍后我会查证。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080711
					],
					"speakerTitle": "理水叠山真君"
				},
				{
					"id": 10080711,
					"content": "璃月港也并不远在天边，若有虚言，也骗不过我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080712
					],
					"speakerTitle": "理水叠山真君"
				},
				{
					"id": 10080712,
					"content": "帝君…遇刺了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080713
					],
					"speakerTitle": "理水叠山真君"
				},
				{
					"id": 10080713,
					"content": "还是在「请仙典仪」上？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080714
					],
					"speakerTitle": "理水叠山真君"
				},
				{
					"id": 10080714,
					"content": "璃月…凡间…谁敢如此！不…这世上又有多少力量，能刺杀帝君？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080715
					],
					"speakerTitle": "理水叠山真君"
				},
				{
					"id": 10080715,
					"content": "我等众仙遵帝君律令，护佑璃月。因人间兴盛，逐步退于山野，这本是对凡人的好意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080716
					],
					"speakerTitle": "理水叠山真君"
				},
				{
					"id": 10080716,
					"content": "但如今…帝君…帝君…唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080717
					],
					"speakerTitle": "理水叠山真君"
				},
				{
					"id": 10080717,
					"content": "旅者，你述之事我已知晓。削月筑阳真君延请我等的意思，也已经很明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080718
					],
					"speakerTitle": "理水叠山真君"
				},
				{
					"id": 10080718,
					"content": "待我将此山之事稍作处理，就去会见众仙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080719
					],
					"speakerTitle": "理水叠山真君"
				},
				{
					"id": 10080719,
					"content": "话说，那些琥珀是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080720
					]
				},
				{
					"id": 10080720,
					"content": "我知道！一定是这位仙人的仙力啦，就和小说里写的一样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080721
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10080721,
					"content": "羽毛就能化为草木，唾液也能化为瀑流。这些琥珀，一定也是类似的形成原理！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080722,
						10080723
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10080722,
					"content": "类似「燕窝」的原理吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080724
					]
				},
				{
					"id": 10080724,
					"content": "…这又是什么说法。这些琥珀，来自于我植下的花，名叫「踱山葵」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080725
					],
					"speakerTitle": "理水叠山真君"
				},
				{
					"id": 10080725,
					"content": "它本身大部分隐于地下，若被踩到，就会生出琥珀，将入侵者包裹在其中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080726
					],
					"speakerTitle": "理水叠山真君"
				},
				{
					"id": 10080726,
					"content": "我归隐到此处后，为了山门清静，将它种植在四周，这些年为我挡了不少滋扰，不过，也关了许多莫名的东西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080727
					],
					"speakerTitle": "理水叠山真君"
				},
				{
					"id": 10080727,
					"content": "所以，这些「琥珀」，其实都是…活的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080728
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10080728,
					"content": "正是如此。所以，若我离开此山，只怕害了无辜性命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080729
					],
					"speakerTitle": "理水叠山真君"
				},
				{
					"id": 10080729,
					"content": "我稍作处理后，就会动身。你们自行速速离去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "理水叠山真君"
				},
				{
					"id": 10080723,
					"content": "…呃，有点恶心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080724
					]
				},
				{
					"id": 10080706,
					"content": "是削月筑阳真君让我们来…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080707
					]
				},
				{
					"id": 10080707,
					"content": "削月筑阳真君…他托凡人带口信？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080708
					],
					"speakerTitle": "理水叠山真君"
				}
			]
		},
