					"李丁"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10089701,
					"content": "我都听我兄弟说了，谢谢你们，谢谢你们搭救我兄弟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089702
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10089702,
					"content": "唉，我们也是迫不得已，实在是无钱供养家庭，又听人说，琥牢山上的琥珀中藏有宝物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089703
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10089703,
					"content": "我们就鬼迷心窍，偷偷上山，想从琥珀里寻得几件宝物，拿回去卖点钱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089704
					],
					"speakerTitle": "李当"
				},
				{
					"id": 10089704,
					"content": "结果…您也看到了，仙人对我施以惩诫，我就被琥珀给吞了下去，如果没你们搭救，还不知道什么时候能出来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089705
					],
					"speakerTitle": "李当"
				},
				{
					"id": 10089706,
					"content": "仙，仙使？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10089707
					]
				},
				{
					"id": 10089709,
					"content": "本仙知道了，此后莫再犯糊涂。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10089710
					]
				},
				{
					"id": 10089705,
					"content": "还好仙人慈悲，派下你们这两位仙使搭救…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089706,
						10089709
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10089707,
					"content": "是啊，我刚在山上祈祷，你们就搭救了我兄弟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089708
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10089708,
					"content": "你们一定是仙人派下来的仙使。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089712
					],
					"speakerTitle": "李当"
				},
				{
					"id": 10089710,
					"content": "…呜哇，你怎么入戏这么快，不过…确实挺有「仙使」气势的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089711
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10089711,
					"content": "是，是，我们兄弟受教了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089712
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10089712,
					"content": "蒙仙使搭救，我们兄弟以后一定痛改前非，去寻个正路赚钱，哪怕是去码头卖点力气，也是个说法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089713
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10089713,
					"content": "啊，对了，可不能再叨扰仙府，我们这就下山，谢谢仙使…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089714
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10089714,
					"content": "谢谢仙使…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089715
					],
					"speakerTitle": "李当"
				},
				{
					"id": 10089715,
					"content": "…要是我们真是什么「仙使」就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089716
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10080609,
					"content": "总感觉，这位仙人的脾气不太好呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080610
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10080610,
					"content": "不过我们也没有做什么坏事，应该也不会…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089601
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10089601,
					"content": "擅扰山门，又私放受诫贼人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089602
					],
					"speakerTitle": "理水叠山真君"
				},
				{
					"id": 10089602,
					"content": "无知凡众，还不速速前来领诫！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "理水叠山真君"
				}
