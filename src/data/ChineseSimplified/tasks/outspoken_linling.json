				"objectNames": [
					"霖铃"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413360101,
					"content": "唔…还是去现场取材一下吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360102
					],
					"speakerTitle": "霖铃"
				},
				{
					"id": 413360102,
					"content": "你在做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360103
					]
				},
				{
					"id": 413360103,
					"content": "我正在帮人想一些适合写在霄灯上的话呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360104
					],
					"speakerTitle": "霖铃"
				},
				{
					"id": 413360104,
					"content": "海灯节期间，大家不是都要放霄灯吗，也会在上面写一些愿望啦，祝福语啦之类的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360105
					],
					"speakerTitle": "霖铃"
				},
				{
					"id": 413360105,
					"content": "为了显得有些节日的氛围，有的人就想要把那些愿望和祝福语，写得…嗯…怎么说呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360106
					],
					"speakerTitle": "霖铃"
				},
				{
					"id": 413360106,
					"content": "有「文采」一些…这样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360107
					],
					"speakerTitle": "霖铃"
				},
				{
					"id": 413360107,
					"content": "碧波，枭总管和德贵就拜托我，帮他们想一些有「文采」的祝福语，然后写在霄灯上送给他们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360108
					],
					"speakerTitle": "霖铃"
				},
				{
					"id": 413360108,
					"content": "但如果我只是在这闭门造车的话，肯定也想不出什么好词。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360109
					],
					"speakerTitle": "霖铃"
				},
				{
					"id": 413360109,
					"content": "所以，我想要先把霄灯准备好，然后再去观察一下那些拜托我的人，再为他们量身定做一份祝福语。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360110
					],
					"speakerTitle": "霖铃"
				},
				{
					"id": 413360110,
					"content": "但我可不怎么会编霄灯啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360111,
						413360112
					],
					"speakerTitle": "霖铃"
				},
				{
					"id": 413360111,
					"content": "我来帮忙吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360113
					]
				},
				{
					"id": 413360113,
					"content": "是吗？那就拜托你了，拜托你帮我做三盏霄灯来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360114
					],
					"speakerTitle": "霖铃"
				},
				{
					"id": 413360114,
					"content": "然后我们再去实地取取材，看看该写什么祝福语好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360115
					],
					"speakerTitle": "霖铃"
				},
				{
					"id": 413360115,
					"content": "嘿嘿，我差不多有思路了，只要再找到一点点灵感…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "霖铃"
				},
				{
					"id": 413360112,
					"content": "我还挺会编霄灯的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360113
					]
				}
			]
		},
