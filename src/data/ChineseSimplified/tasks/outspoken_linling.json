			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"霖铃"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413360401,
					"content": "枭总管在那边，我们先在这里观察一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360402
					],
					"speakerTitle": "霖铃"
				},
				{
					"id": 413360402,
					"content": "我想想啊，我对枭总管印象很深，给他的那幅字很快就写好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360403
					],
					"speakerTitle": "霖铃"
				},
				{
					"id": 413360403,
					"content": "我给你念一下啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360404
					],
					"speakerTitle": "霖铃"
				},
				{
					"id": 413360404,
					"content": "「臭脸老头没半点好脾气」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360405,
						413360406
					],
					"speakerTitle": "霖铃"
				},
				{
					"id": 413360405,
					"content": "啊？！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360407
					]
				},
				{
					"id": 413360407,
					"content": "「虽如此却有一幅热心肠」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360408,
						413360409
					],
					"speakerTitle": "霖铃"
				},
				{
					"id": 413360408,
					"content": "嗯？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360410
					]
				},
				{
					"id": 413360410,
					"content": "还有个题头呢。题头是…「确是好人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360411
					],
					"speakerTitle": "霖铃"
				},
				{
					"id": 413360411,
					"content": "怎么样，是不是很贴切，枭总管虽然看上去很凶，但实际上人挺好的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360412
					],
					"speakerTitle": "霖铃"
				},
				{
					"id": 413360412,
					"content": "还有其他备选方案吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360413
					]
				},
				{
					"id": 413360413,
					"content": "啊，倒是还有一个，主要是我想不到怎么接下去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360414
					],
					"speakerTitle": "霖铃"
				},
				{
					"id": 413360414,
					"content": "不然，你再帮我想想？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360415
					],
					"speakerTitle": "霖铃"
				},
				{
					"id": 413360415,
					"content": "前面那一句是「晚辈来，怒目金刚八面威风」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360416
					],
					"speakerTitle": "霖铃"
				},
				{
					"id": 413360416,
					"content": "「千帆去，无忧安眠鼾响震山」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360417
					]
				},
				{
					"id": 413360417,
					"content": "感觉还不错…还差个题头…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360418
					],
					"speakerTitle": "霖铃"
				},
				{
					"id": 413360418,
					"content": "呃…「久安如山」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360419
					]
				},
				{
					"id": 413360419,
					"content": "欸！看不出来，你还挺有天赋的嘛，这一幅真不错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360420
					],
					"speakerTitle": "霖铃"
				},
				{
					"id": 413360420,
					"content": "那我就把这幅字给写在霄灯上了，你等会…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360421
					],
					"speakerTitle": "霖铃"
				},
				{
					"id": 413360421,
					"content": "好了，写好了，我们把霄灯送去给枭总管吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "霖铃"
				},
				{
					"id": 413360409,
					"content": "你先别念了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360410
					]
				},
				{
					"id": 413360406,
					"content": "你，你先等一会！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360407
					]
				}
			]
		},
		{
			"id": 4133605,
