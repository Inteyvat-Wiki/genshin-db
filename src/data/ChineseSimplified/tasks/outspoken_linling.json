					"枭总管"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413360501,
					"content": "是霖铃啊，有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360502
					],
					"speakerTitle": "枭总管"
				},
				{
					"id": 413360502,
					"content": "上次你拜托我写的那幅字，我已经和这位旅行者一起写好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360503
					],
					"speakerTitle": "霖铃"
				},
				{
					"id": 413360503,
					"content": "喏，我已经帮你写在霄灯上了，给你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360504
					],
					"speakerTitle": "霖铃"
				},
				{
					"id": 413360504,
					"content": "那真是谢谢了，我看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360505
					],
					"speakerTitle": "枭总管"
				},
				{
					"id": 413360505,
					"content": "「晚辈来，怒目金刚八面威风」，「千帆去，无忧安眠鼾响震山」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360506
					],
					"speakerTitle": "枭总管"
				},
				{
					"id": 413360506,
					"content": "「久安如山」…呵呵，倒是还不错，多谢你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360507
					],
					"speakerTitle": "枭总管"
				},
				{
					"id": 413360507,
					"content": "不用谢，我这里还有一幅我自己写的呢，我念给…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360508,
						413360509
					],
					"speakerTitle": "霖铃"
				},
				{
					"id": 413360508,
					"content": "我们快去找下一个人吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360510
					]
				},
				{
					"id": 413360510,
					"content": "对哦，好吧…那我们先去找德贵吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360511
					],
					"speakerTitle": "霖铃"
				},
				{
					"id": 413360511,
