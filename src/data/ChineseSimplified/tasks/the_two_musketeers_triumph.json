			"dialogs": [
				{
					"id": 401360301,
					"content": "我宣布，获得首届千灵映影节「芙宁娜」奖的影片是——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360302
					],
					"speakerTitle": "会场主持人"
				},
				{
					"id": 401360302,
					"content": "《两个铳枪手》！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360303
					],
					"speakerTitle": "会场主持人"
				},
				{
					"id": 401360303,
					"content": "是我们耶！真的是我们耶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401360304,
					"content": "恭喜你，泽维尔先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360305
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 401360305,
					"content": "天哪，我…我…真是太谢谢各位了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360306
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 401360306,
					"content": "我对枫丹娱乐界的判断从不出错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360307
					],
					"speakerTitle": "芙宁娜"
				},
				{
					"id": 401360307,
					"content": "现在有请《两个铳枪手》的制片人，泽维尔先生，上台领奖！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360308
					],
					"speakerTitle": "会场主持人"
				},
				{
					"id": 401360308,
					"content": "谢谢…非常感谢大家对我们影片的认可。我在此，要特别感谢——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360309
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 401360309,
					"content": "时间过得真快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360310
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 401360310,
					"content": "嗯，就好像夏沃蕾你教我握枪只是几天前的事一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360311
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 401360311,
					"content": "还会来枫丹吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360312
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 401360312,
					"content": "当然！我喜欢这个城市，新奇的东西看都看不过来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360313
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 401360313,
					"content": "夏沃蕾会来稻妻吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360314
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 401360314,
					"content": "…以前从没有过这个打算。不过，现在可以考虑一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360315
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 401360315,
					"content": "我期待你的到来。到时候，还想邀请你来家里做客，给你尝尝我们家的茶点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360316
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 401360316,
					"content": "嗯，保持联系。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360317
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 401360317,
					"content": "如你所愿？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360318
					],
					"speakerTitle": "千织"
				},
				{
					"id": 401360318,
					"content": "你也该回稻妻看看了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360319
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 401360319,
					"content": "「小仓屋」怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360320
					],
					"speakerTitle": "千织"
				},
				{
					"id": 401360320,
					"content": "一切都好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360321
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 401360321,
					"content": "代我向她问好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360322
					],
					"speakerTitle": "千织"
				},
				{
					"id": 401360322,
					"content": "我会的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360323
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 401360323,
					"content": "听说岛上不下雷暴了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360324
					],
					"speakerTitle": "千织"
				},
				{
					"id": 401360324,
					"content": "也不打仗了。和平安治。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360325
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 401360325,
					"content": "听起来真好，是适合晒布料的天气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360326
					],
					"speakerTitle": "千织"
				},
				{
					"id": 401360326,
					"content": "——再次感谢我提到的所有人。是你们带我走上了领奖台，是你们铸就了这部映影。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360327
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 401360327,
					"content": "另外，经过团队成员的一致认可，我正式将泽维尔剧组，命名为「铳枪影业」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360328
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 401360328,
					"content": "嘿嘿，这么喊出来还真帅气！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360329
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401360329,
					"content": "那么，下面就有请「铳枪影业」的所有成员，上台合影！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360330
					],
					"speakerTitle": "会场主持人"
				},
				{
					"id": 401360330,
					"content": "哦！还有合影环节！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360331
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401360331,
					"content": "芙宁娜导演，我认为，你才是应该举起这个奖杯的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360332
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 401360332,
					"content": "欸？不、不要啦…好丢人的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360333
					],
					"speakerTitle": "芙宁娜"
				},
				{
					"id": 401360333,
					"content": "没人比导演您更合适。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360334
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 401360334,
					"content": "当之无愧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360335
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 401360335,
					"content": "非你莫属。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401360336
					]
				},
				{
					"id": 401360336,
					"content": "你就认命吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360337
					],
					"speakerTitle": "千织"
				},
				{
					"id": 401360337,
					"content": "准备好了吗？三、二、一…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360338
					],
					"speakerTitle": "会场主持人"
				},
				{
					"id": 401360338,
					"content": "铳枪影业！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
