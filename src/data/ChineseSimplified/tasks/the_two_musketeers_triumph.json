			"dialogs": [
				{
					"id": 401360201,
					"content": "…押送程序结束。他们三个，接下来就交给你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360202
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 401360202,
					"content": "看样子后边还有别的事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360203
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 401360203,
					"content": "嗯，得去赶一场派对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360204
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 401360204,
					"content": "真少见，在培养新爱好吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360205
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 401360205,
					"content": "只是这场比较特殊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360206
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 401360206,
					"content": "夏沃蕾，公爵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401360207,
					"content": "过节就是好，连我这都变热闹了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360208
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 401360208,
					"content": "这就是千灵节。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360209
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 401360209,
					"content": "是啊，护士长甚至准备了豪华版营养奶昔…健康程度也是豪华版的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360210
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 401360210,
					"content": "你们刚才在聊工作吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401360211,
					"content": "已经聊完了。我也向莱欧斯利先生打了「招呼」，对吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360212
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 401360212,
					"content": "我没有明确回应哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360213
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 401360213,
					"content": "但你也没拒绝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360214
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 401360214,
					"content": "我有个好主意，给他们每人发一份报纸吧，比如，一份头版印着一段二十年前往事的报纸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360215
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 401360215,
					"content": "那我猜有一个人要倒霉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360216
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 401360216,
					"content": "我猜有两个人要被当成英雄了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360217
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 401360217,
					"content": "说到英雄，你们两位是有什么事要找我吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360218
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 401360218,
					"content": "哦，我们是来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401360219,
					"content": "来邀请我去派对的，对吧？我可没忘记今天是什么日子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360220
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 401360220,
					"content": "嘿嘿，那我们赶快回去吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401360221,
					"content": "公爵再见！千灵节快乐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401360222,
					"content": "嗯，节日快乐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莱欧斯利"
				}
			]
		},
