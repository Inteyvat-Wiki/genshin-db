			"dialogs": [
				{
					"id": 100090101,
					"content": "嗯…根据之前的结果，调整一下实验计划吧，然后，得检查器材和实验用的素材…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090102
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 100090102,
					"content": "#对了，今天要做的炼金药…咦，{NICKNAME}和派蒙，你们怎么来了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090103
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 100090103,
					"content": "嘿嘿，我们是来帮助你完成「课题」的，想看看我们有什么能帮得上忙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100090104,
					"content": "「课题」…啊，你是说阿贝多先生曾经提过的，和魔女会相关的「课题」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090105
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 100090105,
					"content": "真巧，今天正好有周期性实验的安排。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090106
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 100090106,
					"content": "周期性？那岂不是说砂糖一直在做这个实验？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100090107,
					"content": "是的，不过因为跟我研究的其他内容有方向性的一致，所以对于持续这个「课题」的实验，并没有太大的负担。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090108
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 100090108,
					"content": "不过…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090109
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 100090109,
					"content": "怎么了，是实验遇到了什么困难吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100090110,
					"content": "嗯，实验一直「没能成功」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090111
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 100090111,
					"content": "啊，也就是说已经失败了很多次了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100090112,
					"content": "不能简单地认为那是「失败」，这个「课题」背后所蕴含的原理要比想象中复杂一些…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090113
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 100090113,
					"content": "所以到底是什么课题呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100090114
					]
				},
				{
					"id": 100090114,
					"content": "对哦，说了半天，具体到底是要做什么样的实验呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100090115,
					"content": "能令甜甜花变成「十六倍大甜甜花」的药剂配置的实验…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090116
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 100090116,
					"content": "也就是炼金药剂「肆式植株倍化剂柒型」的配置，顺便一提之所以是「柒型」，是因为今天是第七次进行这个实验。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090117
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 100090117,
					"content": "十、十六倍大！总之，听懂了，我们要做的就是「变大药」第七版！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100090118,
					"content": "「变大药」第七版…是、是的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090119
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 100090119,
					"content": "不过虽然是第七版，但是配方并没有做太多的调整，因为无论是原理还是实验过程的产物都证明没有问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090120
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 100090120,
					"content": "可是一直「没能成功」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100090121,
					"content": "嗯，所以我在想，是不是…需要别的要素介入。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090122
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 100090122,
					"content": "哼哼…很显然，这个别的要素…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090123,
						100090125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100090123,
					"content": "就让我们来帮忙实验吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100090124
					]
				},
				{
					"id": 100090124,
					"content": "嗯嗯，我们本来就是来看看能帮上什么忙的嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100090127,
					"content": "加入派蒙的话，原本的材料配比就得做出调整，效果说不定不如之前已经稳定的配方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090128
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 100090128,
					"content": "我才不要变成材料，快把正常的配方拿出来啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100090129,
					"content": "就在这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090130
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 100090130,
					"content": "不过，还缺少两个材料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090131
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 100090131,
					"content": "嘿嘿，那就包在我们身上了，是什么呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100090132,
					"content": "作为配置底料的清泉镇的泉水，还有有点麻烦的是，狂风之核的碎片。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090133
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 100090133,
					"content": "好，我们这就出发吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100090125,
					"content": "就让派蒙以身入药…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100090126
					]
				},
				{
					"id": 100090126,
					"content": "那肯定能做出了不起的炼金药剂…才不对！什么叫让我入药啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090127
					],
					"speakerTitle": "派蒙"
				}
			]
		},
