			"dialogs": [
				{
					"id": 100090601,
					"content": "材料也全都准备好了，炼制用的炼金釜就在那边…随时可以开始，嗯…不过…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090602
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 100090602,
					"content": "还有什么困难吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090603
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100090603,
					"content": "不不，只是，为了能够精确记录，所以能让我观看你们炼制的过程吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090604
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 100090604,
					"content": "其实有很多人做实验的时候不喜欢被看着…我就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090605
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 100090605,
					"content": "那当然没问题啦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100090606
					]
				},
				{
