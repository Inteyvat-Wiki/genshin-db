					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401970202
					]
				},
				{
					"id": 401970202,
					"content": "奶油味胡子吗…非常传统，但非常好吃。嗯，我准许了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970401
					],
					"speakerTitle": "芙宁娜"
				},
				{
					"id": 401970401,
					"content": "#好啦，既然这份纪念地图已经是{NICKNAME}的所有物，那你想画多少不同口味的胡子都可以。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970402
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 401970402,
					"content": "嘿嘿，听起来是很好吃的地图，我们会好好收藏的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401970403,
					"content": "你们喜欢就再好不过啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970404
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 401970404,
					"content": "乐园各方面的情况都已经很完善了，接下来就请忘记工作的疲惫，尽情游玩吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "娜维娅"
				}
			]
		},
