			"dialogs": [
				{
					"id": 401970101,
					"content": "我认为，当事情发展到如此地步，我们应当加入——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970102
					],
					"speakerTitle": "芙宁娜"
				},
				{
					"id": 401970102,
					"content": "盐？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970103
					],
					"speakerTitle": "爱可菲"
				},
				{
					"id": 401970103,
					"content": "不。胡椒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970104
					],
					"speakerTitle": "芙宁娜"
				},
				{
					"id": 401970104,
					"content": "哦！精妙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970105
					],
					"speakerTitle": "爱可菲"
				},
				{
					"id": 401970105,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401970106,
					"content": "二位这是在研究什么，新的甜品菜单吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401970107,
					"content": "甜品里不该有胡椒吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401970108
					]
				},
				{
					"id": 401970108,
					"content": "不是甜品哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970109
					],
					"speakerTitle": "爱可菲"
				},
				{
					"id": 401970109,
					"content": "是剧本。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970110
					],
					"speakerTitle": "芙宁娜"
				},
				{
					"id": 401970110,
					"content": "欸？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401970111
					]
				},
				{
					"id": 401970111,
					"content": "我亲爱的伙伴，摄影师，新人导演！在映影爱好者们满溢的爱中，创作永远不会停止。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970112
					],
					"speakerTitle": "芙宁娜"
				},
				{
					"id": 401970112,
					"content": "我的舞台上，平淡的剧本禁止登场。转折应如漫天落下的胡椒粉，让观众们连连打上喷嚏才对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970113
					],
					"speakerTitle": "芙宁娜"
				},
				{
					"id": 401970113,
					"content": "不只是映影，餐盘亦是舞台！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970114
					],
					"speakerTitle": "爱可菲"
				},
				{
					"id": 401970114,
					"content": "之前听艾梅莉埃小姐说过，胡椒是可以应用在调香技艺中的…那么，或许甜品也可以…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970115
					],
					"speakerTitle": "爱可菲"
				},
				{
					"id": 401970115,
					"content": "喔！胡椒的刺激，也许更能衬托奶油的甜美呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970116
					],
					"speakerTitle": "芙宁娜"
				},
				{
					"id": 401970116,
					"content": "呜哇，总觉得她们两个在创作上很合得来呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401970117,
					"content": "虽然我是想象不出胡椒蛋糕会是什么味道啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401970118,
					"content": "什么什么？爱可菲要做新蛋糕了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970119
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 401970119,
					"content": "胡椒蛋糕，糊糊焦焦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401970120
					]
				},
				{
					"id": 401970120,
					"content": "这么刺激！等做出来了，请务必给我尝尝！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970121
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 401970121,
					"content": "是我的错觉吗？总觉得工作完成之后，大家的热情反而更加高涨了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401970122,
					"content": "为什么不呢？努力有了成果，才正是最应该开心的时刻呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970123
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 401970123,
					"content": "就像新鲜出炉的马卡龙，不要因为畏惧甜度而不舍得加料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970124
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 401970124,
					"content": "马卡龙，就是要狠狠放糖！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970125
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 401970125,
					"content": "狠狠放糖！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970126
					],
					"speakerTitle": "芙宁娜"
				},
				{
					"id": 401970126,
					"content": "狠狠放糖！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970127
					],
					"speakerTitle": "乐平波琳"
				},
				{
					"id": 401970127,
					"content": "…呃，是要放什么糖？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970128
					],
					"speakerTitle": "乐平波琳"
				},
				{
					"id": 401970128,
					"content": "乐平波琳，你来啦！东西完成了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970129
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 401970129,
					"content": "当然当然，一切顺利！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970130
					],
					"speakerTitle": "乐平波琳"
				},
				{
					"id": 401970130,
					"content": "欸？乐平波琳是去做什么重要任务了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401970131,
					"content": "对的对的，这个给你，请务必收下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970132
					],
					"speakerTitle": "乐平波琳"
				},
				{
					"id": 401970132,
					"content": "这是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401970133
					]
				},
				{
					"id": 401970133,
					"content": "哇，好厉害！是展会的全景图，上面还有大家的图案呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401970134,
					"content": "嘿嘿，鉴于映影欢乐城大获成功，我们一起商量着，想要制作一份独特的纪念品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970135
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 401970135,
					"content": "这座欢乐城是由大家一砖一瓦搭建成功的，就像大家一笔一划画出的这份地图一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970136
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 401970136,
					"content": "虽然主要都是由擅长绘图的乐平波琳小姐完成的啦，但我们每个人也都尽力在上面加了自己的笔墨哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970137
					],
					"speakerTitle": "爱可菲"
				},
				{
					"id": 401970137,
					"content": "没错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970138
					],
					"speakerTitle": "芙宁娜"
				},
				{
					"id": 401970138,
					"content": "#而且不仅如此，{NICKNAME}，我要给你一份特权。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970139
					],
					"speakerTitle": "芙宁娜"
				},
				{
					"id": 401970139,
					"content": "——你将拥有给我的头像上添加胡子的权利！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芙宁娜"
				}
			]
		},
