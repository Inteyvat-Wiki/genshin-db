	"talks": [
		{
			"id": 39702,
			"completionStepIds": [
				39702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"39702",
							"2"
						],
						"stepId": 39702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"迪卢克"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3970201,
					"content": "深渊教团…这些与人类为敌的怪物，地下情报网也很少出现它们的消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970202
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3970202,
					"content": "但虽然麻烦，终归也还是被我找出一些线索了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970203
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3970203,
					"content": "这么快就有线索了吗？不愧是消息灵通的迪卢克老爷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970204
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3970204,
					"content": "不过说起来，风神巴巴托斯大人，为什么要借助人类的力量…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3970205,
					"content": "哈哈，怎么说呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970206
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3970206,
					"content": "人们所说的七神，更本源的称谓是「尘世七执政」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970207
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3970207,
					"content": "划分尘世、各自统治七分之一，这是我们作为神明的责任。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970208
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3970208,
					"content": "履行神职，才能积累神力。但我不喜欢统治…我觉得蒙德也不会喜欢的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970209
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3970209,
					"content": "「你们建立无人称王的自由城邦罢」——巴巴托斯大人的理念，我们牢记于心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970210
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3970210,
					"content": "真虔诚啊，琴团长！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3970211,
					"content": "完全没有想过可能是某人太过自由散漫、不想管事的原因呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3970212,
					"content": "咳咳。总之你们看，我都这么久没有回过蒙德了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970213
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3970213,
					"content": "所以现在的我，毫无疑问，正是七神中最弱的一个！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970214,
						3970215
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3970214,
					"content": "这话说得真是掷地有声啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970216
					]
				},
				{
					"id": 3970216,
					"content": "过奖过奖。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970217
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3970217,
					"content": "呵…我们有这样一位风神大人，该说是好还是坏呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970218
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3970218,
					"content": "不过现在就先抛开七国与七神的话题，重新关注一下人类共同的敌人吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970219
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3970219,
					"content": "这一次查出的<color=#00E1FFFF>深渊法师踪迹</color>，就在<color=#00E1FFFF>酒庄</color>附近。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970220
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3970220,
					"content": "不能让它全身而退。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970221
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3970221,
					"content": "开始追猎吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 3970215,
					"content": "不愧是「自由之都」的神。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970216
					]
				}
			]
		},
		{
			"id": 39704,
			"completionStepIds": [
				39704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"39704",
							"2"
						],
						"stepId": 39704,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"温迪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3970401,
					"content": "咦？这是什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970402
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3970402,
					"content": "深渊法师被击败以后，散逸出了某种能量…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970403
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3970403,
					"content": "它原本的用途，似乎是隔绝我和特瓦林之间的联系。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970404
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3970404,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970405
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3970405,
					"content": "#{NICKNAME}，你知道<color=#00E1FFFF>「风龙废墟」</color>吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970406,
						3970408
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3970406,
					"content": "不知道。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970407
					]
				},
				{
					"id": 3970407,
					"content": "嗯，但琴团长和迪卢克老爷想必都是知道的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970410
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3970410,
					"content": "特瓦林苏醒以后，把一片远古的废墟当作了它的巢穴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970411
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3970411,
					"content": "与先前封锁蒙德四方的暴风一样，废墟的入口也有特殊的障壁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970412
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3970412,
					"content": "但现在，从深渊法师散逸的能量里，我能读出编织魔力的韵律。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970413
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3970413,
					"content": "虽然那种韵律比丘丘人的合唱还要难听，但…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970414
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3970414,
					"content": "也足够让我们破除暴风障壁、抵达<color=#00E1FFFF>「风龙废墟」</color>内部了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970415
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3970415,
					"content": "那，就是要正面挑战风龙了么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970416
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3970416,
					"content": "我倒是没有意见…话说回来，琴才是那个想要避免开战的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970417
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3970417,
					"content": "不。在没有更好的选择时，就由我承担改变方针的责任。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970418
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3970418,
					"content": "如果讨伐风龙是唯一的方案，那我就会成为冲锋在前的骑士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970419
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3970419,
					"content": "——现在还没到那一步喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970420
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3970420,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970421
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3970421,
					"content": "温迪阁下的意思是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970422
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3970422,
					"content": "我的意思是，天空之琴不是我们的底牌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970423
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3970423,
					"content": "#真正的底牌——是{NICKNAME}呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970424
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3970424,
					"content": "#{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970425,
						3970427
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3970425,
					"content": "是因为我净化了泪滴结晶吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970426
					]
				},
				{
					"id": 3970426,
					"content": "没错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970430
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3970430,
					"content": "泪滴里的污秽杂质，和缠绕在特瓦林身上的诅咒，是同一种邪力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970431
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3970431,
					"content": "所以——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970432
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3970432,
					"content": "卖唱的，这太危险了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970433
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3970433,
					"content": "你看特瓦林发火的样子，动手前就会被特瓦林一口吞掉吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970434,
						3970435
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3970434,
					"content": "都说了我很能打。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970436
					]
				},
				{
					"id": 3970436,
					"content": "…嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970437
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3970437,
					"content": "有趣的计划，值得尝试。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970438
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3970438,
					"content": "我也当然会与你同在，荣誉骑士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970439
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3970439,
					"content": "敌人是…深渊的怪物，和龙！压迫感很强呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970440
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3970440,
					"content": "人类也有人类的底蕴。我们走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970441
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3970441,
					"content": "那么——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970442
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3970442,
					"content": "英雄的诗篇，终于进入决战的篇章啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "温迪"
				},
				{
					"id": 3970435,
					"content": "这一战需要借助大家的力量。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970436
					]
				},
				{
					"id": 3970427,
					"content": "是因为我很能打吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970428
					]
				},
				{
					"id": 3970428,
					"content": "#唔嗯…当然，{NICKNAME}的战力是很强的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970429
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3970429,
					"content": "但在你的身上，还有更珍贵的闪光点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970430
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3970408,
					"content": "似乎在蒙德城里听人提起过。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970409
					]
				},
				{
					"id": 3970409,
					"content": "嗯，同样来自蒙德的各位，想必都是知道的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
