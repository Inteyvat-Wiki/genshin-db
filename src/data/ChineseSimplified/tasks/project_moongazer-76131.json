			"dialogs": [
				{
					"id": 761310501,
					"content": "咦？重力好像变正常了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761310502,
					"content": "哥伦比娅！你回来了！是你解决了刚才的问题吗？真是太及时了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761310503,
					"content": "我们真是好担心，你去了哪里呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761310504,
					"content": "你还好吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761310505
					]
				},
				{
					"id": 761310505,
					"content": "很抱歉，我没想到，这个基地的深处居然通向了月心。那里凝聚了浓度极高的古月之力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310506
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 761310506,
					"content": "之前我用月矩力渗透这座基地的时候，无意中触碰到了，因此被那股力量卷入了月心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310507
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 761310507,
					"content": "果然是去了月心…我差点以为这座基地闹鬼了呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761310508,
					"content": "总之你没事就太好了，我们刚才发现了望月者计划的新线索，是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310509
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761310509,
					"content": "派蒙，我已经在月心知晓了真相…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310510
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 761310510,
					"content": "宁宁，我也知道你是谁了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310511
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 761310511,
					"content": "看来我的使命就在那里，请带我去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310512
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761310512,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310513
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 761310513,
					"content": "怎么了吗？哥伦比娅？你看起来不想让宁宁这么做…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310514
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761310514,
					"content": "宁宁她…无法在月心的环境中生存。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310515
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 761310515,
					"content": "但我必须完成使命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310516
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761310516,
					"content": "你的使命不在那里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310517
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 761310517,
					"content": "什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310518
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761310518,
					"content": "嗯，你的使命不在月心。你的使命在最初的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310519
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 761310519,
					"content": "是…「伊比尼伯龙之眼」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310520
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761310520,
					"content": "对，你的使命，是启动「伊比尼伯龙之眼」的望月者计划。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310521
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 761310521,
					"content": "那需要一把由古月之力构成的信息钥匙，我可以再次前往月心，为你取来它，但这需要一些时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310522
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 761310522,
					"content": "你是让我…回到「伊比尼伯龙之眼」等待吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310523
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761310523,
					"content": "你觉得这样可以吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310524
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 761310524,
					"content": "不，如果我不能亲自去拿钥匙…我就在这里等你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310525
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761310525,
					"content": "你不回来…我就不会离开。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310526
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761310526,
					"content": "我想在这里…等着我的朋友回来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310527
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761310527,
					"content": "我知道了，谢谢你，宁宁。我很快就回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310528
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 761310528,
					"content": "哥伦比娅，我和你一起去吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761310529
					]
				},
				{
					"id": 761310529,
					"content": "好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310530
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 761310530,
					"content": "那、那黑蛋怎么办？让她一个人呆在这里吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310531
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761310531,
					"content": "别担心，我呼唤了玛歌，她正在过来的路上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310532
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 761310532,
					"content": "只是留在这里的话，这座基地没有别的危险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310533
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 761310533,
					"content": "可是…我还是有点担心，干脆我留下来陪她吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310534
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761310534,
					"content": "嗯？派蒙不想去看看月心的样子吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310535
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 761310535,
					"content": "我觉得黑蛋一个人在这里会孤单的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310536
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761310536,
					"content": "她是那个卢沙里姆的女儿哦…这件事她刚刚知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310537
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761310537,
					"content": "这种消息一定需要好好消化一下吧？万一胡思乱想，跑到危险的地方去就不好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310538
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761310538,
					"content": "所以，我还是在这里陪她等玛歌来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310539
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761310539,
					"content": "你们在里面看见了什么，回来告诉我就好啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310540
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761310540,
					"content": "谢谢你，派蒙。我会再多给你一点尊重。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310541
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761310541,
					"content": "那我就再多给你一份零食吧，现在是你三我七了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310542
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761310542,
					"content": "派蒙这次有了姐姐的样子。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761310543
					]
				},
				{
					"id": 761310543,
					"content": "嘿嘿，怎么不是呢？我可算看着黑蛋长大的哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310544
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761310544,
					"content": "好啦，你们快去吧，早点去就早点回来，别让我们等太久。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310545
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761310545,
					"content": "#嗯，{NICKNAME}，跟我来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "哥伦比娅"
				}
			]
