					"nextDialogs": [
						761310703
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761310703,
					"content": "这就是那只星空生物传递给龙族的消息吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310704
					],
					"speakerTitle": "派蒙"
				},
				{
