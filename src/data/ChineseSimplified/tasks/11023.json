				{
					"id": 110231131,
					"content": "…这一路上的，都是什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231132
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110231132,
					"content": "他们，看到了什么…又做了什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231133
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110231133,
					"content": "然后…又发生了什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231134
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110231134,
					"content": "既然你无法信任我，那我们就继续向前吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231135
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110231135,
					"content": "那时候发生的一切，这扇门后留下的痕迹，都会如实记录。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "钟离"
				}
			]
		},
		{
