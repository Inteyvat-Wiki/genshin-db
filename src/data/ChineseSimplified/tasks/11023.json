				"points": []
			},
			"dialogs": [
				{
					"id": 110231101,
					"content": "这里就是现场，赫乌莉亚形骸溃散，只留下些许盐迹。临终的画面，也定格于此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231102
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110231102,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231103
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110231103,
					"content": "故事的后续是：她的子民中，有人终于意识到，这位仁善却柔弱的魔神，在战争中保护不了任何人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231104
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110231104,
					"content": "魔神战争是很残酷的。与其让她经受战败后的折磨，不如，赐予她相对轻松的解脱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231105
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110231105,
					"content": "可是，这些「雕像」…又是怎么回事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110231106,
					"content": "再怎么弱小的魔神，死亡时流失的力量，也非凡人之躯所能承受。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231107
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110231107,
					"content": "没能逃走的人，全都变成了这副模样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231108
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110231108,
					"content": "未经此灾的盐神子民离开了她的领地，前往璃月，请求岩王帝君的庇护。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231109
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110231109,
					"content": "他们的后代害怕赫乌莉亚留下的魔神残渣，害怕她施予他们永世的诅咒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231110
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110231110,
					"content": "于是，他们冒着危险回到这里，将剑折断、供奉，希望能够平息她留下的怒火。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231111
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110231111,
					"content": "但其实他们是多此一举了。这位直到最后都没有反抗过的魔神，又怎么会对自己的子民…心怀忿怒呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231112
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110231112,
					"content": "我…我…就算是这样，我不接受…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231113
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110231113,
					"content": "骗局…虚假的历史…一切…都…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231114
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110231114,
					"content": "别想动摇…我的信仰…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231115
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110231115,
					"content": "(test)（少女跑开）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231116
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110231116,
					"content": "这一次，钟离也真是不留情呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110231117,
					"content": "这就是她要付出的代价了，但…这也并不失为一件好事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231118
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110231118,
					"content": "看她的模样，恐怕还会继续动摇一阵…不过，即使不能马上解脱，只是认清现实，也还不错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231119,
						110231121
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110231119,
					"content": "你对盐之魔神的遭遇太熟悉了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110231120
					]
				},
				{
					"id": 110231120,
					"content": "嗯，在很久很久以前，赫乌莉亚的故事对我来说，也是一份告诫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231123
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110231123,
					"content": "信仰一位已经逝去的神，实在没有什么好处。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231124
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110231124,
					"content": "…不论是对赫乌莉亚的信仰，还是对摩拉克斯的信仰，都是一样的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231125
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110231125,
					"content": "璃月人总有一天也会明白的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110231126
					]
				},
				{
					"id": 110231126,
					"content": "好了。接下来，陪我去一趟「孤云阁」如何？",
