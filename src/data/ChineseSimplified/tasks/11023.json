				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"钟离"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110230301,
					"content": "这个里面，有装了一半的盐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230302
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110230302,
					"content": "不过就是个盐罐子而已，看来「盐之魔神」是个穷酸的魔神啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230303
					],
					"speakerTitle": "克列门特"
				},
				{
					"id": 110230303,
					"content": "据我了解，它并不普通。虽然只有一半，但永远都有一半——换句话说，就是无尽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230304
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110230304,
					"content": "什么？！我就算一直往外面倒，里面的盐也不会减少吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230305
					],
					"speakerTitle": "克列门特"
				},
				{
					"id": 110230305,
					"content": "正是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230306
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110230306,
					"content": "能够产生无穷无尽的盐，果然，「盐之魔神」所拥有的权能是很强大的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230307
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110230307,
					"content": "折腾了这么久，终于让我遇到宝贝了！这东西归我了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230308
					],
					"speakerTitle": "克列门特"
				},
				{
					"id": 110230308,
					"content": "我只需要把盐倒出来，搞个几千几万袋，靠卖盐都能发财了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230309
					],
					"speakerTitle": "克列门特"
				},
				{
					"id": 110230309,
					"content": "喂！「盐之魔神」的遗产，怎么可以用来做这么肤浅的事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230310
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110230310,
					"content": "如果克列门特先生想要这个盐盏，那么按照契约，下一件物品，就是属于宛烟女士的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230311
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110230311,
					"content": "没问题没问题，哼哼，怎么会有比这个还值钱的东西呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230312
					],
					"speakerTitle": "克列门特"
				},
				{
					"id": 110230312,
					"content": "既然有「契约」，我也没必要和他争抢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230313
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110230313,
					"content": "那么，我们继续前进吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "钟离"
				}
			]
		},
		{
			"id": 1102305,
			"completionStepIds": [
				1102305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102305",
							"2"
						],
						"stepId": 1102305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"钟离"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110230501,
					"content": "哼，一把尺子而已，看起来就没什么用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230502
					],
					"speakerTitle": "克列门特"
				},
				{
					"id": 110230502,
					"content": "这是…我记得没错的话，这个应该是一种量器？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230503
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110230503,
					"content": "确实如此。但「盐之魔神」亦有权能在此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230504
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110230504,
					"content": "这盐尺一旦插进地面，土壤之上就会像涨水那样，被盐覆盖。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230505
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110230505,
					"content": "越是深入，盐粒就会越多，换言之，就是盐的「丰收」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230506
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110230506,
					"content": "这、这…这不是比盐盏还要厉害？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230507
					],
					"speakerTitle": "克列门特"
				},
				{
					"id": 110230507,
					"content": "那么，按照契约，这盐尺就属于宛烟女士了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230508
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110230508,
					"content": "不行！我不同意！钱是我出的，这场探索也是我组织的，凭什么要我吃亏！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230509
					],
					"speakerTitle": "克列门特"
				},
				{
					"id": 110230509,
					"content": "而且这小姑娘一点用都没有，为什么要把东西送给她！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230510
					],
					"speakerTitle": "克列门特"
				},
				{
					"id": 110230510,
					"content": "他果然还是这么做了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230511,
						110230512
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110230511,
					"content": "唉…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230513
					]
				},
				{
					"id": 110230513,
					"content": "那也就是，你想破坏「契约」了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230514
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110230514,
					"content": "破坏又怎么样？这遗迹里的机关，我也差不多看明白了。所以，你已经没用了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230515
					],
					"speakerTitle": "克列门特"
				},
				{
					"id": 110230515,
					"content": "说到底，我是雇佣你的人。凭什么我要按照你的规矩来做事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230516
					],
					"speakerTitle": "克列门特"
				},
				{
					"id": 110230516,
					"content": "因为你立下了契约。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230517
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110230517,
					"content": "岩王帝君曾说，「契约既成，食言者当受食岩之罚。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230518
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110230518,
					"content": "那是你们璃月的神，我是至冬来的，我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230519
					],
					"speakerTitle": "克列门特"
				},
				{
					"id": 110230519,
					"content": "「食岩之罚」，你自己感受一下吧…可不会太轻松的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "钟离"
				},
				{
					"id": 110230512,
					"content": "既然说了这种话…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230513
					]
				}
			]
		},
		{
			"id": 1102307,
			"completionStepIds": [
				1102307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102307",
							"2"
						],
						"stepId": 1102307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"钟离"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110230701,
					"content": "你的收获，也由我没收了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230702
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110230702,
					"content": "你没有继续前进的资格了，就这样离开吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230703
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110230703,
					"content": "可恶…你给我等着！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230704
					],
					"speakerTitle": "克列门特"
				},
				{
					"id": 110230704,
					"content": "(test)（愚人众逃离）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230705
					],
					"speakerTitle": "克列门特"
				},
				{
					"id": 110230705,
					"content": "说是考古勘探，终于还是装不下去了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230706,
						110230708
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110230706,
					"content": "幸好早有提防。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230707
					]
				},
				{
					"id": 110230707,
					"content": "就是，幸好我已经有敏锐的嗅觉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230710
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110230710,
					"content": "克列门特的错误，在于贪欲。但在贪欲之外，也还有许多令人想要违背契约的诱惑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230711
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110230711,
					"content": "面对「渴望之物」，究竟有多少人能够克制欲望、遵循契约…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230712
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110230712,
					"content": "不如，就趁这个机会讲清楚吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230713
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110230713,
					"content": "嗯？要讲什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230714
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110230714,
					"content": "这一个临时的考古小队，其实没有人是来「考古」的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230715
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110230715,
					"content": "为、为什么这么说？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230716
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110230716,
					"content": "这位女士，你缺乏最基本的考古常识，文物也不识几件，但在「盐之魔神」上的知识，又特别精通。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230717
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110230717,
					"content": "比起考古与文物，还是「盐之魔神」本身，才更让你感兴趣吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230718
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110230718,
					"content": "你在珠钿舫提到的那些关于盐之魔神的传说，据我所知，是在「银原厅」流传得最多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230719
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110230719,
					"content": "别、别再说了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230720
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110230720,
					"content": "…先生你果然博学多才，我鼓起勇气向你提问，看来是正确的选择。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230721
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110230721,
					"content": "——没错，我不是什么考古学家。我来自璃月「七星八门」中的一门，主管盐业的「银原厅」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230722
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110230722,
					"content": "我们的祖辈，就是在魔神战争席卷大陆的苦难时期里，曾受「盐之魔神」庇护的子民。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230723,
						110230724
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110230723,
					"content": "说起来，从没听你喊过「帝君」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230725
					]
				},
				{
					"id": 110230725,
					"content": "对喔，这样一提醒的话，确实很少有璃月人会把「摩拉克斯」挂在嘴上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230726
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110230726,
					"content": "在战争中，摩拉克斯暗杀了我们的神！他嫉妒「盐之魔神」的权能，让我们流离失所！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230727
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110230727,
					"content": "我…我们恨他！但璃月是摩拉克斯的璃月，历史一定是任由他粉饰的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230728
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110230728,
					"content": "所以，我想要证明！摩拉克斯也有罪恶！他手上沾着血，他有残忍无情的一面！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230729
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110230729,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230730
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110230730,
					"content": "我们签过「契约」，要直面真相，对吧，钟离先生！对这件事，你要有公正的判断！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230731
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110230731,
					"content": "那是自然。而且，璃月已经不再是摩拉克斯的璃月了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230732
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110230732,
					"content": "跟我走吧，一切答案就在前方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "钟离"
				},
				{
					"id": 110230724,
					"content": "说起来，从没听你喊过「岩王爷」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230725
					]
				},
				{
					"id": 110230708,
					"content": "以后派蒙可别变成他那样。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230709
					]
				},
				{
					"id": 110230709,
					"content": "我喜欢摩拉，但我不干坏事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230710
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 1102309,
			"completionStepIds": [
				1102309
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102309",
							"2"
						],
						"stepId": 1102309,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"钟离"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110230901,
					"content": "这是…剑吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230902
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110230902,
					"content": "啊！是断裂的剑！这就是证据！证明「盐之魔神」曾经是反抗过的！只是没能抵挡摩拉克斯下的毒手！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230903
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110230903,
					"content": "相比「盐盏」和「盐尺」，这「剑」的力量，一定是远远超越它们的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230904
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110230904,
					"content": "如果能修好这把剑，就能向其他人展示「盐之魔神」曾经的权能了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230905
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110230905,
					"content": "看起来…确实很像战败之后留下的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230906
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110230906,
					"content": "两段断剑，以考古角度来看，是两件文物。按照「顺次取物，每次一件」的契约，你只能带走其中之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230907
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110230907,
					"content": "为、为什么？虽说是顺次取物，可是，克列门特已经…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230908
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110230908,
					"content": "是的，但是「每次一件」仍然有效。想要同时取走两件文物，是不可以的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230909
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110230909,
					"content": "这、这…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230910
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110230910,
					"content": "唔…钟离，她不是恶意，也没有争抢，是不是可以通融一下？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230911
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110230911,
					"content": "「契约」不可通融，若不遵守，就是破坏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230912
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110230912,
					"content": "不行！如果只带走一半，那、那就没办法修好，也没办法重现「盐之魔神」的权能…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230913
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110230913,
					"content": "无论如何，为了我对她的信仰…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230914
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110230914,
					"content": "即使是破坏契约，我也在所不惜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230915
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110230915,
					"content": "你已经下定决心了吗？那么，这是有代价的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230916
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110230916,
					"content": "钟离！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230917
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110230917,
					"content": "这就意味着，你要承受「食岩之罚」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230918
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110230918,
					"content": "那也…没关系。「盐之魔神」为保护她的信徒，连生命都愿意付出。我的牺牲，微不足道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230919
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110230919,
					"content": "你要怎样惩罚都没关系，只要让我带回…我信仰的证明！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230920
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110230920,
					"content": "不、不可以打女孩子啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230921
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110230921,
					"content": "…如果那样就能获得解脱，说不定是更轻松的方法。但…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230922
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110230922,
					"content": "作为「惩罚」，我会告诉你「真相」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230923
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110230923,
					"content": "什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230924
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110230924,
					"content": "真相？你说真相…是对我的惩罚？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230925
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110230925,
					"content": "是的。接下来你将听到的事实，就是你破坏了「契约」的代价。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230926
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110230926,
					"content": "——很遗憾，盐之魔神，赫乌莉亚，并不是一位权能强大的魔神。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230927
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110230927,
					"content": "相反，她过于弱小——过于迁就、过于柔弱，是绝无可能登上七神之位的…败者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230928
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110230928,
					"content": "你说什么…？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230929
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110230929,
					"content": "魔神战争时期，尘世间的魔神们为了争夺提瓦特大陆，拼尽了全部的力量与智慧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230930
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110230930,
					"content": "但赫乌莉亚选择了逃避。她认为只要在争斗发生之前就放弃，战争就永远不会波及到自己和子民。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230931
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110230931,
					"content": "可是，在漫长的战争岁月里，「退让」是不会有止境的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230932
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110230932,
					"content": "在无底线的退让中，赫乌莉亚失去了所有土地，只剩下最后的容身之所。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230933
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110230933,
					"content": "不…不…没可能的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230934
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110230934,
					"content": "在她最后的时刻，她连一把能举起来保护子民的兵刃，都没有了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230935
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110230935,
					"content": "连兵刃都没有？可是，这剑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230936
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110230936,
					"content": "是的，这把断剑并非「盐之魔神」的遗物，而是…杀死她的凶器。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230937
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110230937,
					"content": "凶器…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230938
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110230938,
					"content": "不！这是假的，你说的都是假的，你想要迷惑我对神明的信心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230939
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110230939,
					"content": "我说过，我只陈述事实。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230940
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110230940,
					"content": "岂有此理！你…你也是摩拉克斯的信徒，你别想骗我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230941
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110230941,
					"content": "(test)（少女向深处跑去）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230942
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110230942,
					"content": "喂！喂，别跑啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230943,
						110230945
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110230943,
					"content": "对她来说打击太大了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230944
					]
				},
				{
					"id": 110230944,
					"content": "毕竟，这是惩罚。若非如此，我也不想讲出这么残酷的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230947
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110230947,
					"content": "我们也继续往深处走吧。在那里…恐怕会有，令她无论如何都不得不接受「真相」的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "钟离"
				},
				{
					"id": 110230945,
					"content": "钟离说的，的确是「真相」吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230946
					]
				},
				{
					"id": 110230946,
					"content": "嗯，不然也不会把「真相」当作惩罚了。我也不想讲出这么残酷的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230947
					],
					"speakerTitle": "钟离"
				}
			]
		},
