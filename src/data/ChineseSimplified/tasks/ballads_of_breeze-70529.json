			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"莉兹"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705290201,
					"content": "您好！欢迎来到风花节，您来得可真是时候，我这里正在举办一项叫做「风物之歌」的小游戏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290202
					],
					"speakerTitle": "莉兹"
				},
				{
					"id": 705290202,
					"content": "在这项小游戏里，您能够像蒙德城里的吟游诗人一样，弹奏出动听的曲子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290203,
						705290204
					],
					"speakerTitle": "莉兹"
				},
				{
					"id": 705290203,
					"content": "能跟吟游诗人比吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705290205
					]
				},
				{
					"id": 705290205,
					"content": "放心吧！这项小游戏我可是…那个…找了很多人试玩过的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290206
					],
					"speakerTitle": "莉兹"
				},
				{
					"id": 705290206,
					"content": "就算是最不会弹奏乐器的人，也至少能弹出一首…呃…至少不难听的曲子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290207
					],
					"speakerTitle": "莉兹"
				},
				{
					"id": 705290207,
					"content": "相信我！相信西风骑士团！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290208
					],
					"speakerTitle": "莉兹"
				},
				{
					"id": 705290208,
					"content": "只要集中注意力跟上节拍和节奏，肯定能轻松弹奏出一首像样的旋律。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290209
					],
					"speakerTitle": "莉兹"
				},
				{
					"id": 705290209,
					"content": "在风中全神贯注地弹奏着优美动听的旋律…这样，您肯定能把烦心事都忘掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290210
					],
					"speakerTitle": "莉兹"
				},
				{
					"id": 705290210,
					"content": "那吟游诗人肯定最没烦心事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705290211
					]
				},
				{
					"id": 705290211,
					"content": "哈哈哈，那可不一定，毕竟他们会本能地担心，这首曲子是不是优美到让人愿意付钱呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290212
					],
					"speakerTitle": "莉兹"
				},
				{
					"id": 705290212,
					"content": "而您嘛…只需要弹得让自己开心就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290213
					],
					"speakerTitle": "莉兹"
				},
				{
					"id": 705290213,
					"content": "咳！我…我刚才啥都没说！您应该了解这个小游戏的玩法了吧？如果有兴趣的话，请您来试试看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290214
					],
					"speakerTitle": "莉兹"
				},
				{
					"id": 705290214,
					"content": "您可以用自己的乐器来弹奏曲子，如果您没带乐器的话，我们这边也可以借您一些…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290215
					],
					"speakerTitle": "莉兹"
				},
				{
					"id": 705290215,
					"content": "嘿嘿…我们这里可是有很多乐器的，每一种乐器弹奏时的手感都不一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290216
					],
					"speakerTitle": "莉兹"
				},
				{
					"id": 705290216,
					"content": "您想先用哪一把乐器来弹奏呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290217,
						705290218,
						705290219
					],
					"speakerTitle": "莉兹"
				},
				{
					"id": 705290217,
					"content": "风物之诗琴。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705290220
					]
				},
				{
					"id": 705290220,
					"content": "用这把乐器啊，没问题！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290221
					],
					"speakerTitle": "莉兹"
				},
				{
					"id": 705290221,
					"content": "对了！还有一件事，还有一件事！请您稍等一下，我看看笔记本…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290222
					],
					"speakerTitle": "莉兹"
				},
				{
					"id": 705290222,
					"content": "嗯…那个…为了保证大家能顺利弹奏出好听的曲子，我们这次还特别设置了一个「调校乐器」的环节。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290223
					],
					"speakerTitle": "莉兹"
				},
				{
					"id": 705290223,
					"content": "简单来说，就是帮您把乐器调整到最佳状态啦…很简单的，我看看啊，第一步是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290224
					],
					"speakerTitle": "莉兹"
				},
				{
					"id": 705290224,
					"content": "好！这样就可以了，乐器已经调整到最佳状态…乐谱也准备好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290225
					],
					"speakerTitle": "莉兹"
				},
				{
					"id": 705290225,
					"content": "只要您愿意，随时都可以开始弹奏啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莉兹"
				},
				{
					"id": 705290218,
					"content": "镜花之琴。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705290220
					]
				},
				{
					"id": 705290219,
					"content": "绮筵之鼓。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705290220
					]
				},
				{
					"id": 705290204,
					"content": "弹出来真的好听吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705290205
					]
				}
			]
		}
	]
}