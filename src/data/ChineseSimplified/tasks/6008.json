			"dialogs": [
				{
					"id": 60080201,
					"content": "「少女」看样子没精打采的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080202,
					"content": "打扰了，你、你还好吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080203,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080204
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080204,
					"content": "身体情况又恶化了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080205
					]
				},
				{
					"id": 60080205,
					"content": "…晕晕的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080206
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080206,
					"content": "…好像要回到月亮上去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080207
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080207,
					"content": "那倒也不至于吧？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080208,
					"content": "嗯？那是…我从你身体里…感受到了月亮的力量？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080209
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080209,
					"content": "我们从「愚人众」手中夺回了「月髓」，它能帮到你吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080210
					]
				},
				{
					"id": 60080210,
					"content": "嗯…这次你们需要什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080211
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080211,
					"content": "怎么还在说这些啦？现在是你的身体要紧吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080212,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080213
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080213,
					"content": "（难道说…这是她的某种习惯吗？因为一直生活在互相利用的环境中…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080214
					]
				},
				{
					"id": 60080214,
					"content": "或许你之后可以帮我个忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080215
					]
				},
				{
					"id": 60080215,
					"content": "…嗯，好啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080216
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080216,
					"content": "把你的手给我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080217
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080217,
					"content": "呼…谢谢你，我回到地面了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080218
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080218,
					"content": "你本来就在这里啦…现在怎么样？没问题了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080219,
					"content": "好多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080220,
						60080221
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080220,
					"content": "你做了什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080222
					]
				},
				{
					"id": 60080222,
					"content": "月亮在你体内安静得像个水面的倒影…真奇妙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080223
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080223,
					"content": "我不过从水中捧走了一束月光而已，足够我暂时回到地面的一束月光。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080224
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080224,
					"content": "我似乎还感受到了些其他变化…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080225
					]
				},
				{
					"id": 60080225,
					"content": "那是「月神的赐福」。只要同我相触之物，就会带上这种印记。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080226
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080226,
					"content": "这印记是无害的，过一段时间就会自己消去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080227
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080227,
					"content": "说到这个，既然你都恢复了力量，那要不要把「月髓」交给你保管呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080228
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080228,
					"content": "照理说这也是属于「神明」的东西吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080229
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080229,
					"content": "这是「恒月女神·艾莉亚」的遗骸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080230
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080230,
					"content": "果然是…欸？！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080231
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080231,
					"content": "你们之前不知道吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080232
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080232,
					"content": "菈乌玛只说它和其他碎片不一样，能从中感受到神明的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080233
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080233,
					"content": "她说得没错。刚才我捧走月光的时候，也捧回了一些月髓中的「记忆」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080234
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080234,
					"content": "这份「记忆」让我知道了，它属于曾经那位「恒月女神」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080235
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080235,
					"content": "菈乌玛应该也借「月髓」看过以前的历史，她怎么没发现呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080236
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080236,
					"content": "（菈乌玛说自己只能看到过去的片段，而且还很模糊…说不定这是只有「月神」才能感觉到的东西…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080237
					]
				},
				{
					"id": 60080237,
					"content": "曾经的天空有三月，又有三位女神执掌着属于自己的月亮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080238
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080238,
					"content": "但葬火之战后，三位女神均已逝去。三轮月亮则有两轮在战争中破碎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080239
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080239,
					"content": "恒月的「艾莉亚」死后，其力量凝聚为了这颗月髓…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080240
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080240,
					"content": "「虹月」的遗骸从未被找到，「霜月」女神虽亡，但月亮的身形不曾破碎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080241
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080241,
					"content": "正如预言所述，这样的月亮早晚将孕育出新的神明，也就是「霜月之子」口中的「库塔{RUBY#[S]月之少女}尔」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080242
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080242,
					"content": "我能感觉到自己的力量属于「霜月」。但它位于虚假之天外，离我太远。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080243
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080243,
					"content": "现在的我不说「操控」它，有时就连「感受」它都显得吃力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080244
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080244,
					"content": "我，我数数…我们拿到的是「恒月」，「虹月」的找不到…这么说的话，你身子里是有「霜月」的月髓吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080245
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080245,
					"content": "不，「月髓」是月神死后才会凝结而成的东西。其本质是一种力量核心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080246
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080246,
					"content": "就像你不该问月亮上有没有石头一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080247
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080247,
					"content": "哦！是说你本身就代表着「霜月」的力量，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080248
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080248,
					"content": "嗯。拥有「神之心」的魔神被称为神明，拥有「月髓」的你…是不是也能当「月神」了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080249
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080249,
					"content": "这不太一样吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080250
					]
				},
				{
					"id": 60080250,
					"content": "你不想当月神吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080251
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080251,
					"content": "问题不在这里啦！你好像真的很想把这个称呼让出去欸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080252
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080252,
					"content": "总之，抛开谁当月神的问题不谈，我们是不是应该把这颗「月髓」还给你呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080253
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080253,
					"content": "我不要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080254
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080254,
					"content": "啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080255
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080255,
					"content": "而且它看起来也不想到我这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080256
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080256,
					"content": "什么意思…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080257
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080257,
					"content": "刚才接触它力量的时候，我感受到的是一种「排斥」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080258
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080258,
					"content": "或许因为我也是「月神」吧，就像两轮月亮不会同时升起，更无法相互吞噬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080259
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080259,
					"content": "那看来还是只能我带着了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080260
					]
				},
				{
					"id": 60080260,
					"content": "真的吗？虽然菈乌玛说这力量在你体内藏得很好，但「少女」刚才不也感受到了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080261
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080261,
					"content": "「狂猎」看起来也不是一般的东西，如果被它察觉到的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080262
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080262,
					"content": "「狂猎」？你们描述这种现象的语气像在描述一个人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080263
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080263,
					"content": "因为它看起来就是有幕后黑手嘛，甚至像人一样有着明确的目的…之前就追着「月髓」不放。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080264
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080264,
					"content": "听起来有些耳熟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080265
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080265,
					"content": "欸？真的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080266
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080266,
					"content": "我还在「愚人众」的时候，听同僚们提起过一个人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080267
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080267,
					"content": "他来自坎瑞亚，在灾变时期获得了「深渊」的力量，而且对于「月亮」有很强的执念…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080268
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080268,
					"content": "坎瑞亚？虽然那个诡影和坎瑞亚有没有关系我们不知道，但其他听起来都对得上欸…那他的名字是什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080269
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080269,
					"content": "我只知道，别人称他为——「猎月人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080270
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080270,
					"content": "五大罪人？！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080271
					]
				},
				{
					"id": 60080271,
					"content": "哦，是还有这么一个称谓来着。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080272
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080272,
					"content": "欸？！是…是戴因提到过的那个？我们现在的对手…是传说中的五大罪人…「猎月人」雷利尔？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080273
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080273,
					"content": "但如果是五大罪人的话…他不该只有这些实力…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080274
					]
				},
				{
					"id": 60080274,
					"content": "听说「猎月人」在坎瑞亚灾变之后不久就消失了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080275
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080275,
					"content": "我问同僚他去了哪儿，他们却反问我说「你真的不知道？」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080276
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080276,
					"content": "为什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080277
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080277,
					"content": "因为据说猎月人最后的结局，是掉进了那个再也回不来的「月亮倒影」里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080278
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080278,
					"content": "等等等等…东西太多，我都反应不过来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080279
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080279,
					"content": "我那时也这样。他们总觉得，只要是和「月亮」有关的话题，我就一定知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080280
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080280,
					"content": "但我告诉过你们了…我的「序章」落在了虚假之天外，我连自己的名字都不知道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080281
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080281,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080282
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080282,
					"content": "总之在「猎月人」消失之后，挪德卡莱的「狂猎」现象急剧恶化，成了深渊灾难的代名词。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080283
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080283,
					"content": "现在的狂猎，只是传承了那个名字，有相似的现象，但规模和危险程度已经远超往日了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080284
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080284,
					"content": "我还是很难相信，我们现在的对手居然是传说中的「五大罪人」之一…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080285
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080285,
					"content": "这也太危险了吧！星砂滩那时感觉只是侥幸…或者是他没用出全力？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080286
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080286,
					"content": "即使这样…就连那个「木偶」也还是被他打败了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080221,
					"content": "或者说，我做了什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080222
					]
				}
			]
		},
		{
