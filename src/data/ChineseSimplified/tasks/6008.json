			"dialogs": [
				{
					"id": 60080401,
					"content": "嗯？你说什么，可以再说一遍吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080402
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080402,
					"content": "啊？就是你…呃，曾经的同僚？「木偶」和我们一起在星砂滩的时候，好像也被「狂猎」给打败了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080403,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080404
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080404,
					"content": "呃…你刚才是笑了一下吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080405,
					"content": "…没有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080406
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080406,
					"content": "（绝对是笑了吧！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080407,
					"content": "你和她关系不好吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080408,
					"content": "不，只是能想象到她不服气的表情，觉得很有意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080409
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080409,
					"content": "她当时好像很受挫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080410,
					"content": "那只是暂时性的，她很擅长自我调节。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080411
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080411,
					"content": "话题扯远了，既然我们已经知道盯上「月髓」的家伙这么危险，你真的还要随身携带它吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080412,
					"content": "若是「愚人众」的信息可靠。那当猎月人施展全力的时候，整个挪德卡莱加起来都不是他的对手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080413
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080413,
					"content": "现在…或许有什么原因限制了他吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080414
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080414,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080415
					]
				},
				{
					"id": 60080415,
					"content": "在决定之前，我有件事想拜托哥伦比娅。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080416
					]
				},
				{
					"id": 60080416,
					"content": "什么事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080417
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080417,
					"content": "#不知道你能否让我看到，我和{M#妹妹}{F#哥哥}的飞船刚降落到挪德卡莱时，发生的事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080418
					]
				},
				{
					"id": 60080418,
					"content": "可以哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080419
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080419,
					"content": "答应得好干脆！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080420
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080420,
					"content": "我说过，这对我来说不过是捧起一束月光而已，没什么难的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080421
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080421,
					"content": "手给我。做好准备。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080422
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080422,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080423
					]
				},
				{
					"id": 60080423,
					"content": "（和之前看到的一样，只不过更为清晰了…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080424
					]
				},
				{
					"id": 60080424,
					"content": "（还好当时安全迫降了…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080425
					]
				},
				{
					"id": 60080425,
					"content": "（……）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080426
					]
				},
				{
					"id": 60080426,
					"content": "（好像过了很久…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080427
					]
				},
				{
					"id": 60080427,
					"content": "#（{M#荧}{F#哥哥}和我应该还在里面，我们居然在飞船里待了这么长时间，{M#荧}{F#哥哥}究竟是什么时候出去的呢？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080428
					]
				},
				{
					"id": 60080428,
					"content": "#（咦？！那是…{M#荧}{F#哥哥}？！）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080429
					]
				},
				{
					"id": 60080429,
					"content": "（为什么…明明飞船迫降之后，根本没有人出去过！飞船的门在此之前也没被打开过！）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080430
					]
				},
				{
					"id": 60080430,
					"content": "这里是…哪儿？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080431
					]
				},
				{
					"id": 60080431,
					"content": "#{M#哥哥}{F#荧}！快走，我们离开这里！",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						60080432
					]
				},
				{
					"id": 60080432,
					"content": "…欸？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080433
					]
				},
				{
					"id": 60080433,
					"content": "你…你还好吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080434
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080434,
					"content": "我们的飞船…迫降后过了很长一段时间…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080435
					]
				},
				{
					"id": 60080435,
					"content": "#从没有人离开过飞船，但{M#荧}{F#哥哥}…却是从飞船外找到的我…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080436
					]
				},
				{
					"id": 60080436,
					"content": "欸？！这…这怎么可能！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080437
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080437,
					"content": "我不知道…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080438
					]
				},
				{
					"id": 60080438,
					"content": "回忆中隐藏的秘密就像是饼干，咬一口就会撒得到处都是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080439
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080439,
					"content": "（这件事…太蹊跷了，我必须要追查清楚。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080440
					]
				},
				{
					"id": 60080440,
					"content": "（但正如奈芙尔所说，如果挪德卡莱在这之前就遭遇毁灭性的灾难，那就无从查起了…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080441
					]
				},
				{
					"id": 60080441,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080442
					]
				},
				{
					"id": 60080442,
					"content": "「月髓」就交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080443
					]
				},
				{
					"id": 60080443,
					"content": "欸、欸？呃…好吧，既然你都这么说了。但这个东西…唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080444
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080444,
					"content": "需要我帮忙吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080445
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080445,
					"content": "你指的是？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080446
					]
				},
				{
					"id": 60080446,
					"content": "我可以帮你们隐藏「月髓」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080447
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080447,
					"content": "真的吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080448
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080448,
					"content": "本身它在你体内就不易察觉，我可以再教给你一些使用月矩力的办法，进一步隐蔽「月髓」的气息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080449
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080449,
					"content": "就像这样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080450
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080450,
					"content": "哦！就像是一个护盾呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080451
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080451,
					"content": "（这是…好轻柔的感觉…就像月光一样…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080452
					]
				},
				{
					"id": 60080452,
					"content": "感觉到了吗？现在试着维持它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080453
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080453,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080454
					]
				},
				{
					"id": 60080454,
					"content": "你学得很快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080455
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080455,
					"content": "好像还挺结实的，这关键时候都可以用来防身了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080456
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080456,
					"content": "谢谢你教我…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080457
					]
				},
				{
					"id": 60080457,
					"content": "哥伦比娅平时真的都在这里吗？也不出去走走？虽然现在出去可能有些危险…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080458
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080458,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080459
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080459,
					"content": "不喜欢陌生人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080460
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080460,
					"content": "我们算「熟人」了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080461
					]
				},
				{
					"id": 60080461,
					"content": "比陌生人好一点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080462,
						60080463
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080462,
					"content": "等「狂猎」的事告一段落…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080464
					]
				},
				{
					"id": 60080464,
					"content": "对呀对呀，现在「霜月之子」和以前也不一样了，你说不定会喜欢的呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080465
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080465,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080466
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080466,
					"content": "我会考虑的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080467
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080467,
					"content": "她看起来有些累了呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080468
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080468,
					"content": "好久没说这么多话了吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080469
					]
				},
				{
					"id": 60080469,
					"content": "总之，谢谢你愿意帮我们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080470
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080470,
					"content": "…这没什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080471
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080471,
					"content": "这里的花，喜欢你这样的客人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080463,
					"content": "一起出去走走吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080464
					]
				}
			]
		}
	]
}