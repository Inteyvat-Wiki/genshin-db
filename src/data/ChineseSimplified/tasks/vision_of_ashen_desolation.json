			"dialogs": [
				{
					"id": 401720101,
					"content": "嗨！各位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720102
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401720102,
					"content": "奶奶，你来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720103
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401720103,
					"content": "你这里没有好消息吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720104
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401720104,
					"content": "#一眼就被奶奶看出来了啊。{NICKNAME}收集了很多游灵，我一一分辨了，都没有勒拉的特征。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720105
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401720105,
					"content": "看你的样子就知道了。没关系，大海捞针本来就是很难的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720106
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401720106,
					"content": "虽然勒拉的情况还比较稳定，可这样下去也不是办法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720107
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401720107,
					"content": "我倒是有些进展，勒拉的父母告诉我，勒拉前阵子认识了一个朋友，经常一出门就好几天不回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720108
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401720108,
					"content": "他们有次悄悄跟了过去，发现勒拉和那个朋友在一个营地里鼓捣什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720109
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401720109,
					"content": "他们见到了那个人？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401720110
					]
				},
				{
					"id": 401720110,
					"content": "嗯，是个男人，名叫谷中，穿着似乎是稻妻的款式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720111
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401720111,
					"content": "谷中先生，用这个就可以了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720112
					],
					"speakerTitle": "勒拉"
				},
				{
					"id": 401720112,
					"content": "据我从古籍里学习的知识，大多数过敏的症状会使用相应的脱敏疗法，我想反过来也一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720113
					],
					"speakerTitle": "渊上"
				},
				{
					"id": 401720113,
					"content": "您是对灵性完全脱敏的可怜人，只能完全将自己浸泡在充满灵性的物质中。这样的方法，我称为过敏疗法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720114
					],
					"speakerTitle": "渊上"
				},
				{
					"id": 401720114,
					"content": "…会有问题吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720115
					],
					"speakerTitle": "勒拉"
				},
				{
					"id": 401720115,
					"content": "您才是灵性白痴，强行施法会怎么样，您应该比我更清楚。如何决定，还是看您自己了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720116
					],
					"speakerTitle": "渊上"
				},
				{
					"id": 401720116,
					"content": "好吧…但我还有一个问题，谷中先生为什么要帮助我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720117
					],
					"speakerTitle": "勒拉"
				},
				{
					"id": 401720117,
					"content": "毕竟像我这样的家伙，在族里根本说不上什么话，没有什么能回报的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720118
					],
					"speakerTitle": "勒拉"
				},
				{
					"id": 401720118,
					"content": "回报？请您好好看看我的脸吧，看看上面写了什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720119
					],
					"speakerTitle": "渊上"
				},
				{
					"id": 401720119,
					"content": "呃，写了什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720120
					],
					"speakerTitle": "勒拉"
				},
				{
					"id": 401720120,
					"content": "「乐于助人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720121
					],
					"speakerTitle": "渊上"
				},
				{
					"id": 401720121,
					"content": "呜哇！没想到是个稻妻人，居然还是为了给勒拉治病？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401720122,
					"content": "过敏疗法，真是天马行空的点子啊，真的有用吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720123
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401720123,
					"content": "看勒拉现在的样子，结果应该是失败了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401720124,
					"content": "哼，很久以前，族内是有过这种办法，但成功率很低，又太过冒险，渐渐就被禁止了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720125
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401720125,
					"content": "至于这个谷中的目的，我看也没那么简单，在勒拉出事后，他就消失了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720126
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401720126,
					"content": "我按照勒拉父母给的地址去了营地，那有明显的灵性残留，另外，我还发现了这个。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720127
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401720127,
					"content": "这是…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720128
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401720128,
					"content": "某种碎片…似乎是武器或者仪具上的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720129
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401720129,
					"content": "你也感觉到了吧，虽然看起来上了年份，但上面还是有很强大的灵性残留。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720130
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401720130,
					"content": "勒拉应该就是用这个东西做的媒介，这能解释他这个灵性白痴是怎么开始的暝视。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720131
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401720131,
					"content": "等等，我还有一种熟悉的感觉，它似乎与我的古名有关系…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720132
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401720132,
					"content": "欧洛伦的古名？难道这是古名碎片吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401720133,
					"content": "不…我觉得它可能是古名的前主人留下的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720134
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401720134,
					"content": "难道是桑哈杰的遗物？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401720135
					]
				},
				{
					"id": 401720135,
					"content": "奶奶我开始手痒了，这次的暝视就用这个来做媒介。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720136
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401720136,
					"content": "#那还是和上次一样吧？让{NICKNAME}用灵性织机把茜特菈莉看到的画面织下来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720137
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401720137,
					"content": "不，这次让欧洛伦来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720138
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401720138,
					"content": "为什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720139
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401720139,
					"content": "这是安全措施。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720140
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401720140,
					"content": "#你对灵性领域的认知比{NICKNAME}强，如果这是桑哈杰的遗物，万一出现意外状况，你能更好地应对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720141
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401720141,
					"content": "#噢…看见了吧，派蒙，我说奶奶很关注{NICKNAME}吧，一点都不肯让{M#他}{F#她}冒险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720142
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401720142,
					"content": "我这样的孙子就无所谓了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720143
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401720143,
					"content": "喂！你在说什么啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720144
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401720144,
					"content": "不好意思，奶奶，我准备好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720145
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401720145,
					"content": "那我们就开始吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720149
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401720146,
					"content": "按照计划，茜特菈莉以神秘碎片为媒介，开始了第二次暝视。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401720147
					]
				},
				{
					"id": 401720149,
					"content": "出来了！这次的织物…好像是一张碎掉的弓，在火焰里燃烧着…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720150
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401720150,
					"content": "你们看，其中一块是不是和这个碎片有点像啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720151
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401720151,
					"content": "真的！好像是弓身的位置…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720152
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401720152,
					"content": "我在奶奶家里的织卷上看到过跟这把弓很像的东西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720153
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401720153,
					"content": "…没错，它是桑哈杰征战烬寂海时使用的武器。看来这块碎片，是货真价实的桑哈杰遗物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720154
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401720154,
					"content": "#不愧是桑哈杰前辈，虽然遗物的灵性波动很强，但刚才并没有什么危险，如果是{NICKNAME}来的话，应该也没问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720155
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401720155,
					"content": "果然这就是英雄！留下来的东西都可以拿给后人治疗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720156
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401720156,
					"content": "仅仅是治疗吗？我总觉得，那个谷中还别有目的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720157
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401720157,
					"content": "让我想想，刚刚我们看见了完整的弓的样子…难道是…他想找到其他碎片的下落？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720158
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401720158,
					"content": "虽说是桑哈杰前辈的东西，但既然都已经碎掉了，就算找齐了也派不上什么用场了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720159
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401720159,
					"content": "而且为什么要找一个灵性白痴来做这件事？这只会什么也得不到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720160
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401720160,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720161
					],
					"speakerTitle": "勒拉"
				},
				{
					"id": 401720161,
					"content": "欸？勒拉的身体好像有反应了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720162
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401720162,
					"content": "让我看看。我感觉到有灵性在向碎片附着…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720163
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401720163,
					"content": "那就是说，奶奶的方向是正确的。勒拉的游离灵性正在被吸引过来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720164
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401720164,
					"content": "既然如此，我要再试一次，用勒拉的身体与这块碎片一起当作媒介。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720165
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401720165,
					"content": "加油，奶奶。我也会加油的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720166
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401720166,
					"content": "这次让我来操纵灵性织机吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401720167
					]
				},
				{
					"id": 401720167,
					"content": "你也手痒了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720168
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401720168,
					"content": "一人一次，这样比较公平嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720169
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401720169,
					"content": "安全性我也确认过了，应该不会有危险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720170
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401720170,
					"content": "嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720171
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401720171,
					"content": "#好，既然{NICKNAME}有这个想法，就这么来吧。准备好了就告诉我一声。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "茜特菈莉"
				}
