			"dialogs": [
				{
					"id": 752580101,
					"content": "欸？这里怎么有一个晕倒的人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752580102,
					"content": "喂！你听得见吗？你怎么啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752580103,
					"content": "你们扶起了地上的人，他慢慢醒了过来…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752580104
					]
				},
				{
					"id": 752580104,
					"content": "哎哟哟哟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580105,
						752580106
					],
					"speakerTitle": "晕倒的员工"
				},
				{
					"id": 752580105,
					"content": "你好，你喝多了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752580107
					]
				},
				{
					"id": 752580107,
					"content": "头好晕…这是怎么回事…让我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580108
					],
					"speakerTitle": "晕倒的员工"
				},
				{
					"id": 752580108,
					"content": "啊！想起来了！我好像是被人打晕了…但是我没见着是谁动手的。等等…不会就是你们动的手吧？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580109
					],
					"speakerTitle": "晕倒的员工"
				},
				{
					"id": 752580109,
					"content": "喂！我们可是好心扶你起来的人啊，你可不要碰瓷！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752580110,
					"content": "噢噢，对不起，呃…我是「醅蜜」酒吧的员工，本来要去北边的港口送货，嗯…挪德卡莱的商会跟我们采购了一些蜜酿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580111
					],
					"speakerTitle": "晕倒的员工"
				},
				{
					"id": 752580111,
					"content": "哎呀！完了，我的货呢？蜜酿没了！难道是被抢走了？等等…不会就是你们抢走的吧？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580112
					],
					"speakerTitle": "晕倒的员工"
				},
				{
					"id": 752580112,
					"content": "都说了我们是好心扶你起来的人啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752580113,
					"content": "哦对对对，对不起，我现在有点头晕。非常感谢你们，但我得立刻回酒吧报告一下情况…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580114
					],
					"speakerTitle": "晕倒的员工"
				},
				{
					"id": 752580114,
					"content": "如果真的有强盗，你们也不要往北边的港口去了，可能会有危险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "晕倒的员工"
				},
				{
					"id": 752580106,
					"content": "需要送你回家吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752580107
					]
				}
			]
		}
	]
