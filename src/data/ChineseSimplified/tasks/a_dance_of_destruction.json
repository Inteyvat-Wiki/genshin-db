			"dialogs": [
				{
					"id": 30301201,
					"content": "都是实话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301202
					],
					"speakerTitle": "古田"
				},
				{
					"id": 30301202,
					"content": "平日奉行大人用膳，托马大人总会陪伴左右。在旁服侍顺道听听他们闲聊，是我最放松的时刻之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301203
					],
					"speakerTitle": "古田"
				},
				{
					"id": 30301203,
					"content": "公务不由人，奉行大人有时不得不在外用餐，可若能回来，他还是比较喜欢在府内用膳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301204
					],
					"speakerTitle": "古田"
				},
				{
					"id": 30301204,
					"content": "据说是因为托马大人的料理能力比一般厨师更出众，呵呵，奉行大人心中总是有「家」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301205
					],
					"speakerTitle": "古田"
				},
				{
					"id": 30301205,
					"content": "您或许还不知道，他们也会聊到您。那种口气，像是说一个认识挺久，能谈得来的朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301206
					],
					"speakerTitle": "古田"
				},
				{
					"id": 30301206,
					"content": "大小姐偶尔也会陪着一起，而最近几次家族团聚的时刻，免不了说到有趣的人事与见闻。这其中，总是有您一份。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301207
					],
					"speakerTitle": "古田"
				},
				{
					"id": 30301207,
					"content": "…前代奉行大人与夫人过世至今，神里家也走过了许多个年头啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301208
					],
					"speakerTitle": "古田"
				},
				{
					"id": 30301208,
					"content": "老婆子我看着奉行大人与大小姐长大，像他们这般身份能结交到有趣又可靠的朋友，真是太好啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301209
					],
					"speakerTitle": "古田"
				},
				{
					"id": 30301209,
					"content": "所以，您若有时间，欢迎常来奉行府走走。就当是老婆子我冒昧的请求了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301210,
						30301211
					],
					"speakerTitle": "古田"
				},
				{
					"id": 30301210,
					"content": "非常感谢，我会的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30301212
					]
				},
				{
					"id": 30301212,
					"content": "那真是太好了，呵呵，谢谢您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301213
					],
					"speakerTitle": "古田"
				},
				{
					"id": 30301213,
					"content": "嘿嘿，我也很喜欢来这里哦，而且听婆婆刚才说的，社奉行府的饭菜是不是很棒？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30301214,
					"content": "说得我都心痒了，下次我们来蹭…啊不是不是，来拜访吧！最好挑个饭点！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30301215,
					"content": "当然好，欢迎呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301401
					],
					"speakerTitle": "古田"
				},
				{
					"id": 30301401,
					"content": "那我们就先不打扰啦，不过…呃，我们接下来要去哪里呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30301402,
					"content": "踏鞴砂。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30301403
					]
				},
				{
					"id": 30301403,
					"content": "好的好的，那婆婆再见！不用送我们啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30301404,
					"content": "哎哎，好，再会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301405
					],
					"speakerTitle": "古田"
				},
				{
					"id": 30301405,
					"content": "二位这就要走了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301406
					],
					"speakerTitle": "宏达"
				},
				{
					"id": 30301406,
					"content": "对对，事办完了，你不用担心哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30301407,
					"content": "好，祝二位旅途顺利。再见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宏达"
				},
				{
					"id": 30301211,
					"content": "神里家的人也是我的朋友，谢谢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30301212
					]
				}
			]
