				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30301001,
					"content": "到啦，这里是社奉行府，所以…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301002
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30301002,
					"content": "#{NICKNAME}，好久不见了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301003
					],
					"speakerTitle": "宏达"
				},
				{
					"id": 30301003,
					"content": "你好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30301004
					]
				},
				{
					"id": 30301004,
					"content": "如果阁下是来找奉行大人和大小姐，实在不巧，他们都不在府中…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301005
					],
					"speakerTitle": "宏达"
				},
				{
					"id": 30301005,
					"content": "是有公务吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301006
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30301006,
					"content": "奉行大人公务在身，大小姐则是替奉行大人出席一些会议，如有急事，可以到府内稍事休息，等候他们归来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301007
					],
					"speakerTitle": "宏达"
				},
				{
					"id": 30301007,
					"content": "怎么样？要进去吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301008
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30301008,
					"content": "那就打扰一下了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30301009
					]
				},
				{
					"id": 30301009,
					"content": "可以在院子里随便走走吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30301010
					]
				},
				{
					"id": 30301010,
					"content": "换作别人，当然是不可以的了。但您与奉行大人和大小姐关系甚佳，我想，应该没什么问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301011
					],
					"speakerTitle": "宏达"
				},
				{
					"id": 30301011,
					"content": "谢谢啦，那我们就进去了哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301012
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30301012,
					"content": "嗯？您这样看着我，是有什么话要问我吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301013
					],
					"speakerTitle": "古田"
				},
				{
					"id": 30301013,
					"content": "老婆婆，可以请教一些事吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30301014
					]
				},
				{
					"id": 30301014,
					"content": "#呵呵，可以啊。我知道您是{NICKNAME}，大小姐跟我说起过您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301015
					],
					"speakerTitle": "古田"
				},
				{
					"id": 30301015,
					"content": "您有什么想知道的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301016
					],
					"speakerTitle": "古田"
				},
				{
					"id": 30301016,
					"content": "奉行大人和大小姐最近好吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30301017
					]
				},
				{
					"id": 30301017,
					"content": "托您的福，他们二位一切都好。大小姐近日忙于出席各色会议，时而帮奉行大人走访一下民间组织…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301018
					],
					"speakerTitle": "古田"
				},
				{
					"id": 30301018,
					"content": "而奉行大人，您知道的，他总是忙得很，没什么变化。但要说的话，最近心情应是不错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301019
					],
					"speakerTitle": "古田"
				},
				{
					"id": 30301019,
					"content": "听起来一切如常，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301020
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30301020,
					"content": "是啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301021
					],
					"speakerTitle": "古田"
				},
				{
					"id": 30301021,
					"content": "（神里绫人依然担任社奉行，而神里绫华依然是奉行府的大小姐…与原先并无不同。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30301022
					]
				},
				{
					"id": 30301022,
					"content": "（社奉行眼下的情况，似乎也没有什么变化…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30301023
					]
				},
				{
					"id": 30301023,
					"content": "（虽然是意料中的结果，但听到他们兄妹一切都好的消息，还是觉得放心不少。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30301024
					]
				},
				{
					"id": 30301024,
					"content": "怎么样，还有其他要问的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301025
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30301025,
					"content": "暂时没有了，谢谢您。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30301026
					]
				},
				{
					"id": 30301026,
					"content": "您实在是太客气啦，要不是听说您也非常繁忙，我都想请您常来奉行府做客了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301027
					],
					"speakerTitle": "古田"
				},
				{
					"id": 30301027,
					"content": "大小姐她啊，经常提起您。她似乎很高兴能有您这样的朋友，还说您各方面都很厉害，令人钦佩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301028
					],
					"speakerTitle": "古田"
				},
				{
					"id": 30301028,
					"content": "总觉得，自从您来到稻妻之后，许多事都朝着好的方向转变了。我想，您也许就是俗语说的贵人与有缘人吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301029
					],
					"speakerTitle": "古田"
				},
				{
					"id": 30301029,
					"content": "您过奖了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
