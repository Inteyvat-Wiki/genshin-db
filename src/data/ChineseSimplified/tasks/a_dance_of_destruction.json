			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"天目十五"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30300201,
					"content": "到天目锻冶屋了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30300202,
					"content": "噢，许久不见了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300203
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300203,
					"content": "您好，我想打听一些消息。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30300204
					]
				},
				{
					"id": 30300204,
					"content": "当然可以啦，请说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300205,
						30300206
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300205,
					"content": "关于「雷电五传」的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30300207
					]
				},
				{
					"id": 30300207,
					"content": "噢，没想到你会问起这些…也好，想知道的话，我就再说说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300208
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300208,
					"content": "曾享誉稻妻的「雷电五传」，乃是这五支：天目、经津、一心、百目、千手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300209
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300209,
					"content": "五方所用的锻造技艺，最初是由将军大人亲自传下，经诸多天赋异禀的工匠改进后变得越发优异。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300210
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300210,
					"content": "后来，这些锻刀世家渐渐都没落了。流传至今的，原本只有我们「天目」一脉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300211
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300211,
					"content": "但好在近期枫原万叶回到稻妻，继承了「一心传」的技艺。如此一来，五传算是还剩两家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300212
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300212,
					"content": "要是我没记错，他锻刀那次，你也在场呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300213
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300213,
					"content": "这么一说我也想起来了，是有这回事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30300214,
					"content": "当时就听说了雷电五传没落的事，听得我好唏嘘呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30300215,
					"content": "那没落的原因是…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30300216
					]
				},
				{
					"id": 30300216,
					"content": "…唉。如此说起来，又是一段伤心事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300217
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300217,
					"content": "本来，那都不是我能知道的东西，但我多年来只听说各家衰落，至今不清楚缘由…在意之下，就请教了枫原万叶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300218
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300218,
					"content": "他告诉我，同为雷电五传后人，他认为我应当知道这些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300219
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300219,
					"content": "…告诉你也无妨。只不过，这个故事并不让人高兴就是了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300220
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300220,
					"content": "——雷电五传，是被一个杀红了眼的刀匠后人给报复了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300221
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300221,
					"content": "报复？为什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30300222,
					"content": "传说四百余年前踏鞴砂的炉心发生事故。某位刀匠当时在场，为救众人，不顾自己安危冲入炉中…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300223
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300223,
					"content": "踏鞴砂的锻造冶炼技术十分了得，而当年负责管理踏鞴砂的造兵司正姓丹羽，丹羽与枫原有姻亲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300224
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300224,
					"content": "造兵司正丹羽大人与那名刀匠一同跃入炉中，这之后，炉心似乎安稳下来，但他们二人也…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300225
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300225,
					"content": "刀匠家一落千丈，他的儿子因而成了无人照看的孤儿，每一天都活在憎恨之中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300226
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300226,
					"content": "他将此事归咎于整个稻妻，憎恨将军大人对父亲的死不闻不问，憎恨一切未能挽救他父亲的人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300227
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300227,
					"content": "他很无力，只能将落魄之恨传给子孙。这户人家便世世代代背负着恨意，过着苦闷的生活。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300228
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300228,
					"content": "原本，故事到这里就可以结束了。但百年前那代家主对现状极为不满，又无力翻身。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300229
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300229,
					"content": "最终…他做出一个极为偏激的决定——向雷电五传复仇，泄愤之余还能动摇稻妻的锻造业根基。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300230
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300230,
					"content": "那人来自百目家族，却连自家的其他匠人都杀。近百年前，就是他主导了一切攻击。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300231
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300231,
					"content": "然而，对付枫原家与神里家的后人与刀匠时，因有旁人在场，他遭到猛烈反击，当场死去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300232
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300232,
					"content": "也是因为这样，枫原所代表的「一心流」才未遭到灭绝，姑且能说是不幸中的万幸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300233
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300233,
					"content": "（有关雷电五传的传说变得不一样了，当时加害诸位刀匠的竟然另有其人？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30300234
					]
				},
				{
					"id": 30300234,
					"content": "（看来，散兵确实对世界树做了什么。但…丹羽似乎还是死去了。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30300235
					]
				},
				{
					"id": 30300235,
					"content": "#{NICKNAME}，你还有其他要问的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300236
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30300236,
					"content": "您这几天见过万叶吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30300237
					]
				},
				{
					"id": 30300237,
					"content": "枫原万叶啊，昨天还来我这坐了坐，聊了会儿天，喝了杯茶。看他的样子，精神还不错呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300238
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300238,
					"content": "（太好了，人还存在…而且没有什么异样，怎么说都比昨晚想的极端情况好得多。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30300239
					]
				},
				{
					"id": 30300239,
					"content": "我没有其他问题了，谢谢您。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30300240
					]
				},
				{
					"id": 30300240,
					"content": "不用客气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300241
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300241,
					"content": "看你的表情，是不是还要去其他地方呀？哼哼，我可是很会察言观色的哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300242
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30300242,
					"content": "那么出发吧，前往下一站！你走前面，我跟着就是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30300206,
					"content": "能再对我说一遍吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30300207
					]
				}
			]
		},
		{
			"id": 303006,
			"completionStepIds": [
				303006,
				303009
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"泽维尔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30300602,
					"content": "当然啦，我研究过这一带的炉心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300603
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 30300603,
					"content": "有什么要问的，尽管问吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300604
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 30300604,
					"content": "了解这里的历史吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30300605
					]
				},
				{
					"id": 30300605,
					"content": "了若指掌！要知道，我可是在附近来回走动过许多次的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300606
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 30300606,
					"content": "而且，我还在别处遇到过以前在踏鞴砂居住过的人的后代呢。亲属所说，均是真实历史啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300607
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 30300607,
					"content": "还请介绍一下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30300608
					]
				},
				{
					"id": 30300608,
					"content": "唔？突然这么说，三言两语可说不清啊，您应该知道吧？踏鞴砂这地方很有年头了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300609
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 30300609,
					"content": "据我所知，踏鞴砂作为锻造冶炼业的核心地区之一，已经有上千年历史，只不过炉心似乎出过两次问题…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300610
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 30300610,
					"content": "两次？哪两次呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300611
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30300611,
					"content": "最近这些年一次，几百年前还有一次。说到这个，我听稻妻人提过，踏鞴砂以前也有枫丹工匠来过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300612
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 30300612,
					"content": "看起来，两个国家交流技术由来已久了，那个枫丹工匠据说还是踏鞴砂的重要客人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300613
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 30300613,
					"content": "（是「博士」。看来「博士」故意毁坏炉心引发动乱的历史似乎也没有受到影响…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30300614
					]
				},
				{
					"id": 30300614,
					"content": "喂，你到踏鞴砂来是要打听什么，要不要直接问泽维尔？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300615
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30300615,
					"content": "已经在问了哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30300616
					]
				},
				{
					"id": 30300616,
					"content": "哦，原来二位是来研究历史的啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300617
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 30300617,
					"content": "对，这家伙今天不知道怎么了，一直在打听各种历史…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300618
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30300618,
					"content": "嗯？该不会是突然迸发了对历史的兴趣吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300619
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 30300619,
					"content": "是啊。所以，想再问一个问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30300620
					]
				},
				{
					"id": 30300620,
					"content": "好啊，请说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300621
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 30300621,
					"content": "你听说过踏鞴砂有一个「倾奇者」吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30300622
					]
				},
				{
					"id": 30300622,
					"content": "倾奇者？唔…好像没听过呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300623
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 30300623,
					"content": "我知道这个词在稻妻一般指那些特立独行、衣饰特殊的人，倒是一直想见见配得上这个说辞的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300624
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 30300624,
					"content": "但很可惜，既没见过这类人，也没在与踏鞴砂有关的说法里听过相关事宜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300625
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 30300625,
					"content": "（没有倾奇者…难道说散兵在世界树里做了什么，成功抹去了有关自己的记录？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30300626
					]
				},
				{
					"id": 30300626,
					"content": "（如果是那样，他应该是想改变世界，让一切回到原点吧。但是，目前看来所有影响只跟他自己有关？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30300627
					]
				},
				{
					"id": 30300627,
					"content": "谢谢你，泽维尔。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30300628
					]
				},
				{
					"id": 30300628,
					"content": "没什么，不用客气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300629
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 30300629,
					"content": "要走了吗？那再见啦泽维尔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300630
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30300630,
					"content": "噢！不必客气，我能帮上忙就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300631
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 30300631,
					"content": "那就再会了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300632
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 30300632,
					"content": "看来，你想问的事都打听到了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300633
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30300633,
					"content": "回去见小吉祥草王吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30300634
					]
				},
				{
					"id": 30300634,
					"content": "好啊，不过，不知道你今天到底怎么了…看上去心事重重的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300635
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30300635,
					"content": "打起精神来呀！无论发生什么我都会陪着你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300636,
						30300638
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30300636,
					"content": "…嗯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30300637
					]
				},
				{
					"id": 30300637,
					"content": "要振作哦，不行的话就吃点东西！空腹的人无法战胜生活！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300640
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30300640,
					"content": "那么，出发去见纳西妲吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30300638,
					"content": "谢谢你，派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30300639
					]
				},
				{
					"id": 30300639,
					"content": "我们之间客气什么嘛，嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300640
					],
					"speakerTitle": "派蒙"
				}
			]
