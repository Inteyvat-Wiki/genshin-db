			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿旭"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710490201,
					"content": "实在抱歉，家事繁忙，有什么事情还请您等一等再说吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710490202,
						710490207,
						710490212
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 710490202,
					"content": "关于层岩巨渊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710490203
					]
				},
				{
					"id": 710490203,
					"content": "哦哦，您瞧我这脑子…没给您介绍清楚层岩巨渊怎么回事，就把您给使唤了！真是不应该！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710490204
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 710490204,
					"content": "其实我也说不太明白，也就是前些年的事吧…说是那边的矿工挖到了什么怪东西…是什么咱也不知道，也不敢打听。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710490205
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 710490205,
					"content": "辉山厅上报七星以后，凝光大人的秘书派出了一支调查队，回来就说有什么重大安全隐患，非要关闭矿坑不行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710490206
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 710490206,
					"content": "结果呢，层岩巨渊就成了现在这样了。盛露厅的大人们天天打听什么时候重开，可七星就是不许，也只能干着急…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿旭"
				},
				{
					"id": 710490207,
					"content": "关于沐宁…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710490208
					]
				},
				{
					"id": 710490208,
					"content": "他呀，他家是瓷业大户，在盛露厅排得上号的那种。只不过他对家族生意没什么兴趣，只由着性子爱吃爱玩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710490209
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 710490209,
					"content": "这家伙也不懂经营理财，欠了不少的债…他家怕他坏了产业的名声，就送他去总务司作为代表历练一番…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710490210
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 710490210,
					"content": "而总务司也需要盛露厅有一个管事的专业人士来监察层岩巨渊，于是就起用了他做专员。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710490211
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 710490211,
					"content": "要我说呀，是好事。按我老爹的说法，层岩巨渊是能历练人的。他年轻时就在那里下过矿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿旭"
				},
				{
					"id": 710490212,
					"content": "再见。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710490213
					]
				},
				{
					"id": 710490213,
					"content": "好的，您慢走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿旭"
				}
			]
		}
	]
}