	"talks": [
		{
			"id": 7267401,
			"completionStepIds": [
				7267401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7267401",
							"2"
						],
						"stepId": 7267401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"五百藏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726740101,
					"content": "五百藏，你好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740102,
					"content": "咿！居然被识破了！你们究竟是…这个气味…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740103
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740103,
					"content": "原来是你们这些小辈啊。有些时日没见，气味我都认不得了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740104
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740104,
					"content": "五百藏倒是完全没变，还是看到人就害怕，而且还困在石头里呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740105,
					"content": "呶？！你这小辈，这话是什么意思？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740106,
						726740107
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740106,
					"content": "希望你的封印早点解除。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740108
					]
				},
				{
					"id": 726740108,
					"content": "区区人类的封印罢了！只要吾辈努力…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740109
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740109,
					"content": "咳咳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740110
					]
				},
				{
					"id": 726740110,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740111
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740111,
					"content": "#哼。不管怎么说，孩子们受了你不少照顾。小狸子们总说，有个闻起来很香的黄毛{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_UNCLE|INFO_FEMALE_PRONOUN_AUNT]}经常陪他们玩，可开心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740112,
						726740113,
						726740114
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740112,
					"content": "#黄毛{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_UNCLE|INFO_FEMALE_PRONOUN_AUNT]}…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740115
					]
				},
				{
					"id": 726740115,
					"content": "吾辈本来还以为，人类都跟把吾辈妖狸一族封印的家伙一样，又坏、又可怕。看来，还是有些好人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740116,
						726740117
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740116,
					"content": "大部分人都是好人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740118
					]
				},
				{
					"id": 726740118,
					"content": "#对呀，我和{NICKNAME}遇到的人，大部分都是好人。五百藏被封印还不是因为把梳子偷走了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740119,
					"content": "哼，现在梳子已经给你们了。如果你们遇到那个跟灵善坊学法术的家伙，跟他说一声，让他把吾辈从石头里弄出来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740120
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740120,
					"content": "吾辈在这里坐了这么久，都怪那个臭狐狸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740121
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740121,
					"content": "（五百藏抱怨起来好像老头子哦。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740122,
					"content": "（年纪确实应该很大吧。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740123
					]
				},
				{
					"id": 726740123,
					"content": "小辈，你们手也不是石头，脚也不是石头，一定去过不少地方吧…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740124
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740124,
					"content": "#哼哼，我和{NICKNAME}，可是从海对面来的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740125,
					"content": "向五百藏讲了一些璃月与蒙德的事情。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						726740126
					]
				},
				{
					"id": 726740126,
					"content": "…原来外面有这么多地方哪。真是了不得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740127
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740127,
					"content": "一直以来，都只有小狸子跟吾辈报告，所以根本不知道外面是什么样的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740128
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740128,
					"content": "以前在影向山上，吾等看到北边的海对面，有一座好高好高的山，可能比影向山还高，还一直想知道，那是什么地方呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740129,
						726740131
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740129,
					"content": "那边的话…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740130
					]
				},
				{
					"id": 726740130,
					"content": "从方位来看，应该是龙脊雪山吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740132,
					"content": "呜呶呶，雪山…听着就觉得肚皮冷。真不知道那个家伙怎么想去这样的地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740133
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740133,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740134
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740134,
					"content": "咳咳。之前也说了，你们是好人，所以…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740135
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740135,
					"content": "是请人帮忙的语气耶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740136
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740136,
					"content": "呶！吾辈好歹是得了大御所大人的令，守护镇守之森的隐神保生司正，如果不是被封在石头里，吾辈一定要用八叠大的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740137,
						726740138
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740137,
					"content": "有什么需要帮忙的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740143
					]
				},
				{
					"id": 726740143,
					"content": "虽然吾辈没办法自由行动，不过孩子们没问题。吾辈想要拜托小辈你们，带小狸子去外面「修行」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740144
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740144,
					"content": "就带「吉法师」去吧。上次和你们一起玩以后，他就一直念叨着，想要再见到你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740145,
						726740146
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740145,
					"content": "可以是可以…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740147
					]
				},
				{
					"id": 726740147,
					"content": "嗯，毕竟我们和吉法师语言不通，一同旅行的话，多少会遇到困难吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740148
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740148,
					"content": "怎么可能。吾等妖狸一族，自然是明白人类的语言的。只不过是你们人不明白一般妖狸说的话罢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740149
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740149,
					"content": "什么！居然还有这样的事情！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740150
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740150,
					"content": "不过作为旅伴…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740151
					]
				},
				{
					"id": 726740151,
					"content": "还是希望能一边旅行、一边聊天。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740152
					]
				},
				{
					"id": 726740152,
					"content": "#就像派蒙和{NICKNAME}那样！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740153
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740153,
					"content": "呶，真拿你没办法。之前不是有谁用吾等妖狸一族的法术，给你们做了吃食吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740154
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740154,
					"content": "别看吾辈现在是这个模样，做出让你们能听懂吉法师说话的「饭」，也不成问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740155
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740155,
					"content": "好耶！是好吃的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740156
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740156,
					"content": "也不算是好吃的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740157
					]
				},
				{
					"id": 726740157,
					"content": "哼，可别小看吾辈的手艺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740158
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740158,
					"content": "虽然很难形容五百藏是从哪变出来的…\\n总之，和派蒙一起吃了放在五百藏肚皮上的「看上去很美味」的大餐。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						726740159
					]
				},
				{
					"id": 726740159,
					"content": "真好吃！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740160
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740160,
					"content": "那当然了。吾辈可是曾经用泥团子和狸子毛做成的刺身拼盘，把绪方的四鬼骗得团团转的五百藏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740161
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740161,
					"content": "五百藏真厉害！不过，这么说来，刚刚给我们吃的到底是用什么做的呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740162
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740162,
					"content": "有的事情还是不问为好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740163
					]
				},
				{
					"id": 726740163,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740164
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740164,
					"content": "算了，我们去找吉法师聊聊看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740146,
					"content": "还有个问题…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740147
					]
				},
				{
					"id": 726740138,
					"content": "这个嘛…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740139
					]
				},
				{
					"id": 726740139,
					"content": "#嗯嗯，{NICKNAME}的意思我懂！有什么宝藏吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740140
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740140,
					"content": "宝藏？那当然了，吾辈可是五百五妖狸的统领，稻妻的宝藏，什么没见过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740141
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740141,
					"content": "那么，有什么需要帮忙的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740142
					]
				},
				{
					"id": 726740142,
					"content": "对，我们最会帮忙啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740143
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740131,
					"content": "从方位来看，应该是龙脊雪山。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740132
					]
				},
				{
					"id": 726740117,
					"content": "谢谢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740118
					]
				},
				{
					"id": 726740113,
					"content": "闻起来很香…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740115
					]
				},
				{
					"id": 726740114,
					"content": "#不是{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_UNCLE|INFO_FEMALE_PRONOUN_AUNT]}，是{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740115
					]
				},
				{
					"id": 726740107,
					"content": "派蒙的意思是，希望封印早点解除。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740108
					]
				}
			]
		},
		{
			"id": 7267402,
			"completionStepIds": [
				7267402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7267402",
							"2"
						],
						"stepId": 7267402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「吉法师」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726740201,
					"content": "吉法师，好久不见啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740202,
					"content": "呶！白毛黄毛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740203
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726740203,
					"content": "黄毛是指我…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740204
					]
				},
				{
					"id": 726740204,
					"content": "喂！你说谁是白毛呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740205,
					"content": "好强。能听懂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740206
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726740206,
					"content": "#我叫{NICKNAME}，这位是派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740207
					]
				},
				{
					"id": 726740207,
					"content": "要好好记住喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740208,
					"content": "咔嚓咔嚓菫瓜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740209
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726740209,
					"content": "咦，菫瓜？咔嚓咔嚓又是什么？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740210,
					"content": "无论如何，也算是勉强能说得上话吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740211,
					"content": "确实有够勉强的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740212
					]
				},
				{
					"id": 726740212,
					"content": "#不管怎么说，{NICKNAME}，我们去跟五百藏打声招呼吧！毕竟，要带吉法师一起远行了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740213,
					"content": "五百藏！耶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740214
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726740214,
					"content": "耶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7267403,
			"completionStepIds": [
				7267403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7267403",
							"2"
						],
						"stepId": 7267403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"五百藏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726740301,
					"content": "呶！如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740302
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740302,
					"content": "呶！见到白毛黄毛，喜欢。菫瓜砰砰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740303
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726740303,
					"content": "菫瓜砰砰…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740304
					]
				},
				{
					"id": 726740304,
					"content": "呶？想不到，你这小辈，还挺上道嘛…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740305
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740305,
					"content": "砰砰！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740306
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726740306,
					"content": "所以说，菫瓜砰砰是什么意思…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740307
					]
				},
				{
					"id": 726740307,
					"content": "砰砰是砰砰，菫瓜是菫瓜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740308
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726740308,
					"content": "看来你们交流没有任何问题了。吾辈的「烹饪」技术还是一样好哪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740309,
						726740311
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740309,
					"content": "…姑且算是没问题吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740310
					]
				},
				{
					"id": 726740310,
					"content": "不对！问题大着呢！吉法师说的话，基本都听不懂啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740312,
					"content": "是这样的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740313,
					"content": "向五百藏传达了交流的效果。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						726740314
					]
				},
				{
					"id": 726740314,
					"content": "唔唔，原来是这样啊。不用担心，那是因为你们还没有适应吉法师的气味。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740315
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740315,
					"content": "慢慢适应吧！越适应吉法师的气息，就越能听明白吉法师说的话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740316
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740316,
					"content": "「慢慢」是多久啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740317,
					"content": "这个啊，这个嘛…我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740318
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740318,
					"content": "呶！稍安勿躁就是了，真是急性子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740319
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740319,
					"content": "急性子不好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740320
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726740320,
					"content": "看来五百藏也不知道啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740321
					]
				},
				{
					"id": 726740321,
					"content": "哼！吾辈可是活了好久好久的妖狸大王隐神五百藏，怎么会像你们人类那样，对时间这么计较呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740322
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740322,
					"content": "（虽然大部分时间都被封印在石像里啦。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740323,
					"content": "不过，为什么五百藏可以和人对话？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740324
					]
				},
				{
					"id": 726740324,
					"content": "呶，真没礼貌。应该是，为什么你们人类可以和吾辈对话才对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740325
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740325,
					"content": "像吾辈这样活了好久好久、力量强大的妖狸，多少都和人类打过交道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740326
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740326,
					"content": "好久好久以前，吾等经常和天狗、狐、鬼、妖怪与人打交道。人的故事虽然总在说人，其实有一半是妖狸伪装成的人类的历史。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740327
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740327,
					"content": "剩下一半的一半是人类自己的故事，另一半是天狗、狐、鬼和其他妖怪的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740328
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740328,
					"content": "不过，这一半里面，也有一半是吾等妖狸伪装成他们的故事。然后，所有妖狸的故事里，有一半是吾辈五百藏的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740329
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740329,
					"content": "所以，哼，吾辈可是最厉害的呶，能够和你们这些小辈说话自然不在话下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740330
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740330,
					"content": "我懂了，十六分之五都是你的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740331
					]
				},
				{
					"id": 726740331,
					"content": "呶？「十六分之五」…是什么好吃的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740332
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740332,
					"content": "听起来，好吃。想吃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740333
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726740333,
					"content": "#{NICKNAME}是说，依照五百藏的说法，五百藏在故事里的占比啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740334
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740334,
					"content": "五百藏。厉害。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740335
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726740335,
					"content": "哼，那还用说。吾辈的厉害，你要好好学学。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740336
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740336,
					"content": "欸？仔细一想，好像能慢慢听明白吉法师说的话了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740337
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740337,
					"content": "白毛聪明。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740338
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726740338,
					"content": "呜哇，被吉法师这样夸了，心里感觉很不是滋味…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740339
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740339,
					"content": "那就好。这个孩子就拜托你们了，带他到外边去修行吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740340
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740340,
					"content": "吾辈还是个幼狸的时候，也曾经巡礼稻妻十八所，寻访过去大妖狸「九百九」的名迹，绝不偏离狸道，才能达到今天的高度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740341
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740341,
					"content": "欸！所以五百藏才被封印在石头里吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740342
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740342,
					"content": "呶哈哈，石头。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740343
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726740343,
					"content": "呶？！吉法师，连你也…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740344
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740344,
					"content": "回到正题！那我们先去什么地方好呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740345,
						726740347
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740345,
					"content": "刚刚五百藏提到了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740346
					]
				},
				{
					"id": 726740346,
					"content": "嗯嗯！就去龙脊雪山吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740348
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740348,
					"content": "「因为，山就在那里」——终于有机会帅气地说这样的台词了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740349
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740349,
					"content": "山就在那里！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740350
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726740350,
					"content": "呜呶呶，听起来好冷…吉法师，肚皮不要着凉。不然，会感冒的。感冒的话，就不能表演腹鼓了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740351
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740351,
					"content": "#然后，要好好吃饭，在外面要乖乖跟着黄毛{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_UNCLE|INFO_FEMALE_PRONOUN_AUNT]}走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740352
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740352,
					"content": "#知道了！我跟黄毛{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_UNCLE|INFO_FEMALE_PRONOUN_AUNT]}走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740353,
						726740354,
						726740355
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726740353,
					"content": "我们会照顾好吉法师。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740356
					]
				},
				{
					"id": 726740356,
					"content": "请多多关照啦，吉法师！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740357
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740357,
					"content": "呶，不用担心！吉法师关照你们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
