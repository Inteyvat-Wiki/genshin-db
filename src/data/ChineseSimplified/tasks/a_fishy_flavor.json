			"dialogs": [
				{
					"id": 220420301,
					"content": "汝等回来了，喂过那群小家伙了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420302
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220420302,
					"content": "喂过了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420303
					]
				},
				{
					"id": 220420303,
					"content": "这样就好了，谢谢汝等了，要不然这群小家伙肯定又会一直疯玩，然后在野外挨饿了，谢谢汝等帮忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420304
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220420304,
					"content": "唉，真是一群不听话的小家伙啊，这样子怎么能接待来神社的人类呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「寝子」"
				}
			]
