			"dialogs": [
				{
					"id": 220420401,
					"content": "汝等回来了啊。真奇怪，那群小家伙突然都跑回来了，还一副很害怕的样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420402
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220420402,
					"content": "难道，是在野外遇见了那种拿着棒子的毛茸茸人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420403
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220420403,
					"content": "不过，这群小家伙回来了也好…汝怎么了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420404
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220420404,
					"content": "其、其实是我…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420405
					]
				},
				{
					"id": 220420405,
					"content": "…真是难捉摸的人类啊！为什么会想做这件事呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420406
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220420406,
					"content": "想要和这群小家伙玩的话，就用普通的方式好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420407
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220420407,
					"content": "喵！怪不得那群小家伙被吓成这样…奴家还要去安慰一下它们才好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420408
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220420408,
					"content": "真是的，果然不能期望所有的人类都和阿响一样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「寝子」"
				}
			]
