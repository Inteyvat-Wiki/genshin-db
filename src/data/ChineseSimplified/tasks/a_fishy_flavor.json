			},
			"dialogs": [
				{
					"id": 220420101,
					"content": "真是群不听话的孩子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420102
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220420102,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420103
					]
				},
				{
					"id": 220420103,
					"content": "是汝等啊，那群小家伙们又跑出去玩了，真是越来越不听话了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420104,
						220420105
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220420104,
					"content": "要我帮什么忙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420106
					]
				},
				{
					"id": 220420106,
					"content": "有了挂在神社外面的那些铁球，那群小家伙们应该知道怎么回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420107
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220420107,
					"content": "那群小家伙们，在外面疯一疯也好，免得到时候神社里来了人类，它们在人类面前疯玩，掉了神社的风度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420108
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220420108,
					"content": "但它们要是玩得太过头…从太阳还在天上，一直饿到月亮到了天上就不好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420109
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220420109,
					"content": "汝等，帮奴家拿些鱼过去，给那群小家伙们吃吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420110,
						220420113
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220420110,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420111
					]
				},
				{
					"id": 220420111,
					"content": "接下来就把地图给寝子吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220420112,
					"content": "唔，汝还算是有点悟性…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420115
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220420115,
					"content": "好了，汝等快点去吧，奴家还得在这打理神社呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220420113,
					"content": "这是地图…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420114
					]
				},
				{
					"id": 220420114,
					"content": "唔，汝还算是有点悟性…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420115
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220420105,
					"content": "我去找它们回来吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420106
					]
				}
			]
		},
