					"nextDialogs": [
						102000612
					]
				},
				{
					"id": 102000612,
					"content": "嗯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000613
					],
					"speakerTitle": "可莉"
				},
