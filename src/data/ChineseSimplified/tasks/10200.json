		{
			"id": 1020002,
			"completionStepIds": [
				1020015
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1020015",
							"2"
						],
						"stepId": 1020015,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"巴顿"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 102000201,
					"content": "唉，只能从窗外听到大家的讨论，连发言的机会都没有，好想参加他们的话题啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000202
					],
					"speakerTitle": "巴顿"
				},
				{
					"id": 102000202,
					"content": "欸？什么什么？有什么好玩的事情吗？我也想听！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102000203,
					"content": "酒馆里的客人们，最近激烈地讨论起了一个话题——「谁，才是蒙德城最强战力」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000204
					],
					"speakerTitle": "巴顿"
				},
				{
					"id": 102000204,
					"content": "「最强」…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102000205,
					"content": "强到一拳能放倒几只丘丘人，算最强吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000206,
						102000208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102000206,
					"content": "应该没有那么简单吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102000207
					]
				},
				{
					"id": 102000207,
					"content": "唔…看来「最强」的称号，并不好拿啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102000210,
					"content": "对了，巴顿先生，关于这个话题，大家讨论出什么共识了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102000211,
					"content": "嗯…指望「自由之都」的人轻而易举达成共识，就像期待天上掉渔人吐司一样难。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000212
					],
					"speakerTitle": "巴顿"
				},
				{
					"id": 102000212,
					"content": "每个人都有自己的想法，但谁手里的信息都不全面，所以讨论才会变得激烈又有趣吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000213
					],
					"speakerTitle": "巴顿"
				},
				{
					"id": 102000213,
					"content": "现在市面上占据主流的提名…我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000214
					],
					"speakerTitle": "巴顿"
				},
				{
					"id": 102000214,
					"content": "应该是「蒲公英骑士派」和「暗夜英雄派」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000215,
						102000216
					],
					"speakerTitle": "巴顿"
				},
				{
					"id": 102000215,
					"content": "派蒙要把票投给谁？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102000217
					]
				},
				{
					"id": 102000217,
					"content": "我支持你哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102000218,
					"content": "不过，我们还是进<color=#00E1FFFF>酒馆</color>打听看看吧。说不定会有什么逸闻呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102000219,
					"content": "哈，这份悠闲真让人羡慕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000220
					],
					"speakerTitle": "巴顿"
				},
				{
					"id": 102000220,
					"content": "你们不用管我…呜呜，我也得…继续工作了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "巴顿"
				},
				{
					"id": 102000216,
					"content": "有人支持我吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102000217
					]
				},
				{
					"id": 102000208,
					"content": "我也可以。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102000209
					]
				},
				{
					"id": 102000209,
					"content": "好，那我要提名你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000210
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 1020003,
