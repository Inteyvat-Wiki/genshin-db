			"dialogs": [
				{
					"id": 102000301,
					"content": "果然就跟巴顿先生说得一样呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000302,
						102000303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102000302,
					"content": "大家都有自己的看法。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102000304
					]
				},
				{
					"id": 102000304,
					"content": "但是，如果像这样，谁都说服不了谁的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102000305,
					"content": "岂不是永远都不能知道「蒙德的最强战力」到底是谁了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102000306,
					"content": "啊，有了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102000307,
					"content": "我们去找<color=#00E1FFFF>琴团长</color>问问看吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102000308,
					"content": "说不定会有，「西风骑士团认证的官方排行榜」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000309,
						102000311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102000309,
					"content": "真会有那种东西吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102000310
					]
				},
				{
					"id": 102000310,
					"content": "走嘛走嘛，不试试怎么知道呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102000311,
					"content": "我也可以有名次吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102000312
					]
				},
				{
					"id": 102000312,
					"content": "那就要看他们有没有算上你的事迹了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102000313,
					"content": "放心，我还是很信得过你的实力的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102000303,
					"content": "还听到了一些特别的人选。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102000304
					]
				}
			]
		},
