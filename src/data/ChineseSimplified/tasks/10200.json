					"id": 102000615,
					"content": "你好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102000618
					]
				},
				{
					"id": 102000618,
					"content": "我知道你们的事情，是帮助了蒙德的荣誉骑士！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000619
