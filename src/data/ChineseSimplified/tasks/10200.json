			"dialogs": [
				{
					"id": 102000601,
					"content": "唔！我，我很好！对不起，撞到了你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000602
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 102000602,
					"content": "你有东西掉了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102000603
					]
				},
				{
					"id": 102000603,
					"content": "嗯唔…这上面写的是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102000604,
					"content": "「城里放炮禁闭室报到」、「炸弹伤人琴找上门」、「放火烧山可莉完蛋」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102000605,
					"content": "呀？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000606
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 102000606,
					"content": "这…这是凯亚哥哥帮我总结出的…总结出的…唔，生存守则！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000607
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 102000607,
					"content": "生存守则？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000608
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102000608,
					"content": "就…就是不论如何千万不能违反的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000609
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 102000609,
					"content": "不然会发生很可怕、很可怕的事情。",
