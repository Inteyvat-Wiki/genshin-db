				"points": []
			},
			"dialogs": [
				{
					"id": 102000401,
					"content": "琴团长！打扰你啦，我们在收集「蒙德最强战力」的情报。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102000402,
					"content": "有没有…那种…西风骑士团认证过的官方排名呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102000403,
					"content": "「蒙德最强战力」…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000404
					],
					"speakerTitle": "琴"
				},
				{
					"id": 102000404,
					"content": "抱歉，不能帮上忙了。我身边并没有这方面的资料…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000405
					],
					"speakerTitle": "琴"
				},
				{
					"id": 102000405,
					"content": "欸…好可惜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102000406,
					"content": "#我还希望看{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}排上前五呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102000407,
					"content": "哈哈。即使没有这方面的统计，我对这位荣誉骑士的实力也从未质疑过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000408
					],
					"speakerTitle": "琴"
				},
				{
					"id": 102000408,
					"content": "对了，说到这个…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000409
					],
					"speakerTitle": "琴"
				},
				{
