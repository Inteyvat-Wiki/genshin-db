					"content": "她看起来需要帮助…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102000627
					]
				},
				{
					"id": 102000627,
					"content": "没错，我也是这样想的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000631
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102000631,
					"content": "宝物失踪可是大事，要不我们帮你找回来吧！",
