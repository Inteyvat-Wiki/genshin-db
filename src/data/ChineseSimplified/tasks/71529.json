			"dialogs": [
				{
					"id": 716665101,
					"content": "漂亮，是我输了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665102
					],
					"speakerTitle": "「花里胡哨不如一刀」"
				},
				{
					"id": 716665102,
					"content": "#输给{NICKNAME}，未尝不是一种光荣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665103
					],
					"speakerTitle": "「花里胡哨不如一刀」"
				},
				{
					"id": 716665103,
					"content": "原来是用这种办法打赢的吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665104
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 716665104,
					"content": "没错，面对灵活的敌人，还是要多多变通。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716665105,
					"content": "#一种战术行不通的时候，就要换个思路，我和{NICKNAME}在其他地方旅行的时候，常常灵活思考！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716665106,
					"content": "只盯着一种方法做事的话，再用力也解决不了问题！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716665107,
					"content": "我记得，有时阿忍也说过差不多的话，这样看来还挺有道理的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665108
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 716665108,
					"content": "不过还是以后再想吧，先考虑眼前的正事，斗虫要紧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "荒泷一斗"
				}
			]
