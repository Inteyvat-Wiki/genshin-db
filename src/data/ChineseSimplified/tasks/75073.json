			"dialogs": [
				{
					"id": 750730301,
					"content": "呜呜，终于能从这个笼子里出来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730302
					],
					"speakerTitle": "科奴拉芙"
				},
				{
					"id": 750730302,
					"content": "这个热气球晃晃荡荡的，嘿，说不定来上一阵风，整个笼子都得被掀下去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730303
					],
					"speakerTitle": "科奴拉芙"
				},
				{
					"id": 750730303,
					"content": "那时候估计就连黑曜石奶奶都没办法救我啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730304
					],
					"speakerTitle": "科奴拉芙"
				},
				{
					"id": 750730304,
					"content": "你是谁，为什么在这？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750730305
					]
				},
				{
					"id": 750730305,
					"content": "啊，我还没做自我介绍，我啊，我的名字叫科奴拉芙，是「烟谜主」的实习祭司…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730306
					],
					"speakerTitle": "科奴拉芙"
				},
				{
					"id": 750730306,
					"content": "现在正在祭司的修行途中，嗯…之前一直待在部族里，所以部族里的长辈跟我说，「你总得出去见见世面吧！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730307
					],
					"speakerTitle": "科奴拉芙"
				},
				{
					"id": 750730307,
					"content": "于是就以进行修行为名把我一脚踢出了部族的大门——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730308
					],
					"speakerTitle": "科奴拉芙"
				},
				{
					"id": 750730308,
					"content": "不过，被丘丘人抓起来，这种「世面」还是不见为妙啊，你说对不对啊，恩人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730309,
						750730311
					],
					"speakerTitle": "科奴拉芙"
				},
				{
					"id": 750730309,
					"content": "独自冒险很危险…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750730310
					]
				},
				{
					"id": 750730310,
					"content": "就是就是，要不是遇到恩人，我还不知道要在这里被困到什么时候呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730313
					],
					"speakerTitle": "科奴拉芙"
				},
				{
					"id": 750730313,
					"content": "唔，总之，多谢恩人救了小女子…在这上面吹了这么多风，还是先下去，想想继续修行的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730314
					],
					"speakerTitle": "科奴拉芙"
				},
				{
					"id": 750730314,
					"content": "小女子身上的盘缠不多，不过家里人说，受人恩惠总要回报，这些就给恩人吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "科奴拉芙"
				},
				{
					"id": 750730311,
					"content": "只要足够强…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750730312
					]
				},
				{
					"id": 750730312,
					"content": "嘿…这你就骗不着小女子我啦，像恩人这么强的冒险者，这个世上也是少数吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730313
					],
					"speakerTitle": "科奴拉芙"
				}
			]
