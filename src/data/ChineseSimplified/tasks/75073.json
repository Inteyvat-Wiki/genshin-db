			},
			"dialogs": [
				{
					"id": 750730101,
					"content": "啊，恩人！哎呀，恩人，多谢你出手相助…清理了这些丘丘人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730102
					],
					"speakerTitle": "科奴拉芙"
				},
				{
					"id": 750730102,
					"content": "实不相瞒，我刚才只是站在山崖上看风景，一个不注意就被丘丘人敲晕了脑袋，醒来的时候就在这儿关着啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730103
					],
					"speakerTitle": "科奴拉芙"
				},
				{
					"id": 750730103,
					"content": "关着，对钥匙…啊，钥匙就在那边的箱子上，能不能请您再伸出您的贵手，帮我一个微不足道的小忙？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730104
					],
					"speakerTitle": "科奴拉芙"
				},
				{
					"id": 750730104,
					"content": "小女子我一定感激不尽…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "科奴拉芙"
				}
			]
		},
