			"dialogs": [
				{
					"id": 700270101,
					"content": "你来的正好，「普尔希娜光钉」的维修工作一切顺利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270102
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700270102,
					"content": "只要有了这些元件，我有把握以最快的速度修好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270103
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700270103,
					"content": "我收集了一些。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700270104
					]
				},
				{
					"id": 700270104,
					"content": "太好了，这真是帮了大忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270105
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700270105,
					"content": "只要有了这些元件，我有把握以最快的速度修好",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270106
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700270106,
					"content": "不过还有件小事，我想还是先跟你商量一下比较好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270107
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700270107,
					"content": "在你收集元件的这几天里，我仔细研究了一下「普尔希娜光钉」的内部结构。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270108
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700270108,
					"content": "它的结构非常巧妙，不愧是那位普尔希娜前辈制作出来的精妙仪器。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270109
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700270109,
					"content": "任何一处调整都有可能影响到整体功能，所以我有些担心调整是否能达到预期效果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270110
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700270110,
					"content": "保险起见，我希望能拜托你先试用数次，我会根据你试用期间的数据对它进行再校准。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270111
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700270111,
					"content": "这样才能保证「普尔希娜光钉」的最终效果，要不然，等到你在与特异体交手的时候，万一它出现了故障，那可就糟了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270112,
						700270113
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700270112,
					"content": "真是谨慎啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700270114
					]
				},
				{
					"id": 700270114,
					"content": "这也是我第一次实际操作「普尔希娜光钉」，我们还是谨慎些为好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270115
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700270115,
					"content": "那么，就拜托你多多试用了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700270113,
					"content": "我明白了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700270114
					]
				}
			]
		}
	]
