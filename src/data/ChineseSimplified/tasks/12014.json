			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"宵宫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120140101,
					"content": "我打算再待一会儿，我心中的烟花会还没有结束呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140102
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120140102,
					"content": "啊，不过如果想聊天的话，也没问题哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140103,
						120140108,
						120140115
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120140103,
					"content": "接下来打算去干什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120140104
					]
				},
				{
					"id": 120140104,
					"content": "松坂他们还在等我和他们一起去找「大貉妖」呢，宵宫姐姐可不能言而无信。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140105
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120140105,
					"content": "还有各家各户放完烟花之后的感想，我也要去了解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140106
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120140106,
					"content": "接下来的日子，还要承蒙大家关照。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140107
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120140107,
					"content": "你和派蒙的关照当然也少不了啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120140108,
					"content": "定做烟花很贵吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120140109
					]
				},
				{
					"id": 120140109,
					"content": "你们的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140110
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120140110,
					"content": "免费吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140111
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120140111,
					"content": "毕竟是我硬要送给你们的，一路上还给你们添了很多麻烦，嘿嘿，再收费我会不好意思的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140112
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120140112,
					"content": "那有点过意不去。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120140113
					]
				},
				{
					"id": 120140113,
					"content": "#别在意，不用这么客气。那这样吧，作为交换，等你找到了亲人，你要把「长野原烟花店」介绍给{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_SHE|INFO_MALE_PRONOUN_HE]}，这样我又能多一个客人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140114
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120140114,
					"content": "#我也想见{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_SHE|INFO_MALE_PRONOUN_HE]}一面啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120140115,
					"content": "天领奉行如果来找你的麻烦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120140116
					]
				},
				{
					"id": 120140116,
					"content": "那就再打一顿！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140117
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120140117,
					"content": "——哈哈哈，开玩笑，开玩笑啦。我不是说了，我家经常会和奉行众打交道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140118
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120140118,
					"content": "无非是认错，赔笑脸，交些罚款，要混过去很容易。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140119
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120140119,
					"content": "倒是你们要更小心一点，遇到事情，可不要像我一样鲁莽，嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宵宫"
				}
			]
		}
	]
}