				{
					"id": 761800801,
					"content": "和桑多涅玩游戏真开心。下次也一起玩吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800802,
						761800803
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761800802,
					"content": "（再这么坐一会儿吧。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800804
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761800804,
					"content": "要走了吗？好吧，那我们下次见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
