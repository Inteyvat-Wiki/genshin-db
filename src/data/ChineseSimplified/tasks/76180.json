					"「少女」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761800601,
					"content": "什…什么？怎么可能！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800602
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761800602,
					"content": "是你输了呢，桑多涅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800603
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761800603,
					"content": "我…我这是让你的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800604
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761800604,
					"content": "真的吗？你明明很不甘心的样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800605
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761800605,
					"content": "可恶…再来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800606
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761800606,
					"content": "哼，轻轻松松。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800607
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761800607,
					"content": "是我输了。你果然很厉害呢，桑多涅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800608
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761800608,
					"content": "下次带你玩些更有难度的吧。我知道很多好玩的数理游戏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800609
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761800609,
					"content": "好呀。哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800610
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761800610,
					"content": "你笑什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800611
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761800611,
					"content": "以前很少看到桑多涅这么开心的样子，你也不怎么邀请我玩游戏，还会把我赶走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800612
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761800612,
					"content": "喂…别把我说得像是经常欺负你一样好不好！我以后多找你开几次茶会总行了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800613
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761800613,
					"content": "嗯，好啊。我很喜欢这种和桑多涅你一起度过的茶会时光。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				}
			]
		},
