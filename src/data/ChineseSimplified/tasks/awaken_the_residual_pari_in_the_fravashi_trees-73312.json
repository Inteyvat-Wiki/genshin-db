				"points": []
			},
			"dialogs": [
				{
					"id": 733120201,
					"content": "没想到竟然变成这副模样了…还真是可怜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733120202
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733120202,
					"content": "咦，斯露莎在说什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733120203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733120203,
					"content": "没什么，不过是看到了一些同族终末的丑态罢了，不用在意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733120204
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733120204,
					"content": "唔，这种说法反而更让人在意了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733120205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733120205,
					"content": "让我看看…哦哦，那边有棵好奇怪的树呢，团成一圈感觉就像是个门一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733120206,
						733120207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733120206,
					"content": "要是穿过去的话…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733120208
					]
				},
				{
					"id": 733120208,
					"content": "这样一说，有点跃跃欲试起来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733120209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733120209,
					"content": "…这些「灵谷木」可不是什么门扉，若是冒冒失失地穿过去的话，可是会打扰到寄宿在其中的残灵的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733120210
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733120210,
					"content": "哦哦，原来是叫「灵谷木」吗？不过你说残灵…明明什么都看不到嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733120211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733120211,
					"content": "白飘飘当然看不到，毕竟这些残灵还停留在过去的执念当中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733120212
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733120212,
					"content": "虽说未必是其本心所愿，不过这般执着于世的样子，实在是目不忍视。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733120213
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733120213,
					"content": "明明看上去还很茂盛，感觉很亲切呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733120214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733120214,
					"content": "哼，白飘飘知道什么，这些「灵谷木」乃是那些与侵害大地的污秽战斗到最后一刻的花灵，用尽最后的力量所化而成的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733120215
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733120215,
					"content": "耗尽了力量而无法维持形体，又因为沾染了污秽而被花海所拒绝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733120216
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733120216,
					"content": "传说在古时矫论团会为她们举行净罪的仪式，使她们得以重回「甘露花海」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733120217
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733120217,
					"content": "不过如今矫论团早已无人能够主持这样的仪式，至多只能勉力维持这些「灵谷木」不至于枯死罢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733120218
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733120218,
					"content": "但这也不过是延长了她们的痛苦，看她们如今的样子，估计除了需要独自忍受的苦痛追忆外，早已什么都不剩了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733120219,
						733120220
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733120219,
					"content": "看来应该帮帮她们。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733120221
					]
				},
				{
					"id": 733120221,
					"content": "对啊，什么独自受苦，听上去也太可怜了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733120222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733120222,
					"content": "虽说是这样，不过这也算是吾辈花灵的命运，说不定用这种方式守护大地也正是她们的愿望呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733120223
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733120223,
					"content": "唔，虽然斯露莎是这样想的啦，不过说不定她们会有不同的想法呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733120224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733120224,
					"content": "毕竟如果是我的话，比起待在这种地方，还是更想回到花海和大家待在一起…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733120225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733120225,
					"content": "白飘飘还真是看轻我们花灵了啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733120226
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733120226,
					"content": "哼，也罢，就姑且以吾之力量将其唤醒，让你们听听她的终末之声好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733120220,
					"content": "这样说就是有解救的方法…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733120221
					]
				},
				{
					"id": 733120207,
					"content": "说不定会通往何处。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733120208
					]
				}
			]
		},
