			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"查耶维奇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 207000101,
					"content": "真是倒霉透了！西风骑士团真是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000102
					],
					"speakerTitle": "查耶维奇"
				},
				{
					"id": 207000102,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207000103
					]
				},
				{
					"id": 207000103,
					"content": "哼，西风骑士团办事真是没效率，说前头有魔物，不让我通过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000104
					],
					"speakerTitle": "查耶维奇"
				},
				{
					"id": 207000104,
					"content": "但是到现在他们也没传信过来给个准话，真是靠不住…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000105
					],
					"speakerTitle": "查耶维奇"
				},
				{
					"id": 207000105,
					"content": "我还有一堆事要处理，这折合下来，我得损失多少钱啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000106
					],
					"speakerTitle": "查耶维奇"
				},
				{
					"id": 207000106,
					"content": "不过…看你的样子倒像是个冒险家，这样吧…我付你钱，你帮我去办点事，你愿意不愿意？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000107,
						207000109
					],
					"speakerTitle": "查耶维奇"
				},
				{
					"id": 207000107,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207000108
					]
				},
				{
					"id": 207000108,
					"content": "很好，我就喜欢爽快的人，事情办好之后，我绝不会亏待你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000111
					],
					"speakerTitle": "查耶维奇"
				},
				{
					"id": 207000111,
					"content": "也不知道是不是我的错觉，这蒙德的丘丘人感觉是越来越多了，哼，西风骑士团，也不知道一天到晚在做什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000112
					],
					"speakerTitle": "查耶维奇"
				},
				{
					"id": 207000112,
					"content": "你既然答应了帮我办事，那你正好帮我去清理丘丘人。但你也只有一个人，嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000113
					],
					"speakerTitle": "查耶维奇"
				},
				{
					"id": 207000113,
					"content": "算了，你自己选一个地方去清理吧，山顶、山腰和山底下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000114
					],
					"speakerTitle": "查耶维奇"
				},
				{
					"id": 207000114,
					"content": "反正都是去清理丘丘人，没什么差别，赶紧选，别浪费我时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "查耶维奇"
				},
				{
					"id": 207000109,
					"content": "能给多少钱？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207000110
					]
				},
				{
					"id": 207000110,
					"content": "哼，那就要看你办事的样子了，只要事情办好，我绝不会亏待你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000111
					],
					"speakerTitle": "查耶维奇"
				}
			]
		},
