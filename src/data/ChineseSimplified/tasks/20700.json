			"dialogs": [
				{
					"id": 207000201,
					"content": "已经办好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207000202
					]
				},
				{
					"id": 207000202,
					"content": "这么快就回来了，还没到一分钟就全部解决了，身手不凡，身手不凡呐，哈哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000203
					],
					"speakerTitle": "查耶维奇"
				},
				{
					"id": 207000203,
					"content": "不错不错，5000摩拉，一分不少，拿好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000204
					],
					"speakerTitle": "查耶维奇"
				},
				{
					"id": 207000204,
					"content": "身手不凡也才5000摩拉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 207000205,
					"content": "可别嫌少，这酬劳可是我仔细算过的，和你们的工作刚好相称。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000206
					],
					"speakerTitle": "查耶维奇"
				},
				{
					"id": 207000206,
					"content": "想要赚大钱，就得办点大事，下次有机会的话，你们再努努力吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "查耶维奇"
				}
