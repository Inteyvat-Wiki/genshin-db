					{
						"sceneId": 51207,
						"position": [
							2193.858,
							230.219,
							-782.875
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705520301,
					"content": "根据优菈的喜好，全新配方的「浪花剑锋曲」，完成啦！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520302
					]
				},
				{
					"id": 705520302,
					"content": "呀，颜色很漂亮嘛！还加入了刚刚提到的海露花果实汁？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520303
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520303,
					"content": "香气也非常到位，既有烈性，又不缺果香…容我品一品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520304
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520304,
					"content": "等你仔细分析！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520305
					]
				},
				{
					"id": 705520305,
					"content": "呼…哇啊…等我想想夸赞的词，我得好好想想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520306
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520306,
					"content": "虽然淑女不该这样，作为合格的品酒人，也该慢慢喝才对…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520307
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520307,
					"content": "但…口感实在太棒了，失礼了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520308
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520308,
					"content": "能再来一杯吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520309,
						705520310
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520309,
					"content": "当然！喜欢就多喝！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520311
					]
				},
				{
					"id": 705520311,
					"content": "于是优菈开始尽情享用你的全新特调「浪花剑锋曲」，闲聊之余，不知不觉就喝掉了三杯…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705520312
					]
				},
				{
					"id": 705520312,
					"content": "完了，刚刚要怎么夸来着…忘词了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520313
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520313,
					"content": "#总之，我现在状态大好！{NICKNAME}的特调…是最棒的佳酿！",
					"roleType": "TALK_ROLE_NPC",
