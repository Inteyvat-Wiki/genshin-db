			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"优菈"
				],
				"points": [
					{
						"sceneId": 51207,
						"position": [
							2191.087,
							230.089,
							-781.388
						],
						"pointId": 1
					},
					{
						"sceneId": 51207,
						"position": [
							2193.858,
							230.219,
							-782.875
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705520101,
					"content": "#嗯？现在居然是{NICKNAME}在管理饮品小站…早知如此，我上午就过来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520102,
						705520103
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520102,
					"content": "感谢支持，感谢支持！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520104
					]
				},
				{
					"id": 705520104,
					"content": "#说实话，我已经开始好奇了——早就听说{NICKNAME}有着顶级的调饮才华。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520105
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520105,
					"content": "你能用格兰菲狄准备的材料，调出什么样的饮品？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520106,
						705520107
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520106,
					"content": "不过，优菈似乎也很忙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520108
					]
				},
				{
					"id": 705520108,
					"content": "没办法，大事一件连着一件…首先，骑士团全员即将迎来一年一度的战斗技巧考核，这次考核大幅提高了标准。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520109
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520109,
					"content": "作为游击小队的队长，我有必要起到带头作用，至少要在队长级的实战对抗中拿到前三…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520110
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520110,
					"content": "所以，最近一直在加强练习。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520111,
						705520112
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520111,
					"content": "优菈队长居然是这种作风…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520113
					]
				},
				{
					"id": 705520113,
					"content": "哼，罪人的后裔，想要在这个位置上稳稳坐着，也没那么容易吧？我可是没有失职过的哦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520114
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520114,
					"content": "另外，综务小队为了丰富骑士们的战斗经验，邀请了枫丹廷知名的决斗代理人，前来交流剑术。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520115
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520115,
					"content": "鉴于我在出勤率最高的几位队长中，使用双手剑的本事还算不错，也被选为了交流代表。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520116
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520116,
					"content": "我得好好准备一番，和那位决斗代理人认真过招，然后根据结果撰写至少六份报告…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520117
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520117,
					"content": "另外，之前和克洛琳德小姐的几次切磋，也让我投入了相当之多的精力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520118
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520118,
					"content": "面对迅捷剑和铳枪的双重打击，该如何防守反击，如何夺取主动权？直到现在，我还在回想一些细节…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520119
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520119,
					"content": "结果是乐观的，这次剑术交流让我们双方都获益匪浅，别说六份不同角度的报告了，二十四份我都能接受。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520120,
						705520121
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520120,
					"content": "看来要给你来杯够狠的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520122
					]
				},
				{
					"id": 705520122,
					"content": "的确如此，提神为主，什么种类的饮品都不限，请你随意发挥！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520123
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520123,
					"content": "（以优菈目前的状态，给她调一杯「星月闪亮饮」，应该比较合适。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 705520121,
					"content": "看来你需要补充能量喔？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520122
					]
				},
				{
					"id": 705520112,
					"content": "第一次了解你队长的这面…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520113
					]
				},
				{
					"id": 705520107,
					"content": "感觉你最近上班也挺勤快的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520108
					]
				},
				{
					"id": 705520103,
					"content": "无论何时，为您服务！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520104
					]
				}
			]
		},
		{
			"id": 7055202,
			"completionStepIds": [
				7055206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
