						"stepId": 7055206,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"优菈"
				],
				"points": [
					{
						"sceneId": 51207,
						"position": [
							2191.087,
							230.089,
							-781.388
						],
						"pointId": 1
					},
					{
						"sceneId": 51207,
						"position": [
							2193.858,
							230.219,
							-782.875
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705520201,
					"content": "优菈队长的特调「星月闪亮饮」完成了，请享用！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520202
					]
				},
				{
					"id": 705520202,
					"content": "嗯哼，这个语气，很有自信嘛？那我可要好好品味一番了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520203
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520203,
					"content": "唔？真不错！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520204
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520204,
					"content": "又甜又酥麻，空气感很棒，气泡水是点睛之笔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520205
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520205,
					"content": "身体里的活力都被唤醒了，一杯不过瘾…再给我来杯更有力道的，怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520206,
						705520207
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520206,
					"content": "这杯不够有劲？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520208
					]
				},
				{
					"id": 705520208,
					"content": "啊哈，可别束手束脚！我的酒量也不至于差到两杯就倒吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520209,
						705520210
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520209,
					"content": "那我们聊聊天，我再想想！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520211
					]
				},
				{
					"id": 705520211,
					"content": "好啊，今晚第一小队没给我安排文书工作，足够悠闲，就慢慢叙叙旧，试试你的新配方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520212
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520212,
					"content": "之前有段时间没见面了，你一直在雪山附近执勤吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520213
					]
				},
				{
					"id": 705520213,
					"content": "是啊，之前的情况很复杂，一群工程师贼匪团伙，居然捣鼓起什么机关劫持技术，妄想操纵遗迹重机打劫商队…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520214
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520214,
					"content": "偏偏有几位常驻荆夫港的老骑士调动到了我的队里，她们非常不服我这个「劳伦斯家的小姑娘」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520215
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520215,
					"content": "带着她们一起出这趟任务，也算是充满波折，在雪地里潜行三周，不能生火取暖，好不容易才找到对方的据点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520216
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520216,
					"content": "老前辈们挨了不少冻，差点被对方走私的战斗机关撂倒…万幸的是，最后战斗顺利收场，她们也都心服口服了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520217,
						705520218
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520217,
					"content": "委屈你了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520219
					]
				},
				{
					"id": 705520219,
					"content": "我？我倒完全没问题…多谢关心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520220
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520220,
					"content": "当时确实有点心累，好在这次行动也让她们累得够呛，现在她们不会再质疑我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520221
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520221,
					"content": "要是以后还有挑我刺的新人，就让这几位老前辈去指导好了。说是一劳永逸，好像也没什么问题？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520222
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520222,
					"content": "说起来，优菈带来的这瓶是…进口果汁？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520223
					]
				},
				{
					"id": 705520223,
					"content": "对哦，商人说它叫「海露花果实萃取原浆」…它的香味很特别，也送你一瓶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520224,
						705520225
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520224,
					"content": "最近经常喝这个吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520226
					]
				},
				{
					"id": 705520226,
					"content": "嗯…这是一种必要的礼节。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520227
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520227,
					"content": "梅姬斯图斯小姐借我的那本…《轻剑舞者的二十年后》提到——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520228
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520228,
					"content": "「枫丹的剑客们切磋剑法后，胜者会礼貌地宴请败者。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520229
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520229,
					"content": "为了体面地招待克洛琳德小姐，我找了好久，才在荆夫港找到一位奇货商人，买到这些绝版货。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520230
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520230,
					"content": "听起来像是小说情节…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520231
					]
				},
				{
					"id": 705520231,
					"content": "嗯…刚开始，我也这么怀疑过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520232
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520232,
					"content": "但安柏说，不管现实的枫丹有没有这个习俗，至少证明我们有好好了解过枫丹的文化作品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520233
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520233,
					"content": "再退一步，谁也不会讨厌新奇的美食，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520234
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520234,
					"content": "交流剑术后的聚餐上，我就请克洛琳德小姐喝这个好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520235
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520235,
					"content": "交流剑术后的聚餐上，克洛琳德小姐的确很喜欢这种果汁的风味！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520236
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520236,
					"content": "快要比试了，优菈是什么心情？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520237
					]
				},
				{
					"id": 705520237,
					"content": "啊呀…说实话，我跃跃欲试…但也有点紧张。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520238
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520238,
					"content": "经过上次比试，优菈是什么心情？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520239
					]
				},
				{
					"id": 705520239,
					"content": "啊呀…说实话，和克洛琳德小姐交手前，我跃跃欲试…但也有点紧张。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520240
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520240,
					"content": "克洛琳德小姐的战斗流派属于神秘的「逐影猎人」…图书馆里，上百年前的枫丹报纸，都提到过这个组织的强大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520241
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520241,
					"content": "前些年的报纸甚至说，克洛琳德小姐是某位海底王国的遗孤，战斗前会发动仪式，邀请魂灵附在她的剑上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520242
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520242,
					"content": "我不知道后续，但先当这些传闻属实，甚至…克洛琳德小姐的实力比这更夸张，做好万全的心理准备。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520243
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520243,
					"content": "我不知道报道的后续，但就我个人的感受而言，克洛琳德小姐的实力的确与这种描述相符。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520244,
						705520245
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520244,
					"content": "剑术史上的大战值得一杯特调…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520246
					]
				},
				{
					"id": 705520246,
					"content": "在饮品里融入「剑术」的元素？你还真有创意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520247
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520247,
					"content": "确实有必要提提气，不过…你想怎么用饮品来表达这种意象？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520248
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520248,
					"content": "不过，来上这么一杯纪念特调，的确很不错…你想怎么用饮品来表达这种意象？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520249
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520249,
					"content": "据我观察…使用迅捷剑的枫丹剑士，大多擅长刺击，专注于…精准而持续地施压。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520250
					]
				},
				{
					"id": 705520250,
					"content": "唔…的确符合书上的描写。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520251
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520251,
					"content": "要类比成饮品，就像是咖啡，泡泡桔冰酒…或是蒙德的果酿，入口并不刺激，但有着持续的回味。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520252
					]
				},
				{
					"id": 705520252,
					"content": "目前这杯特调的基底，用的正是果酿。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520253
					]
				},
				{
					"id": 705520253,
					"content": "还真有道理…不愧是行家，提瓦特应该没有第二个人能作出这种比喻了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520254
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520254,
					"content": "但优菈的剑术不一样，你像双手剑的领舞人，引导着宽阔的剑身，旋转翻飞，大开大合…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520255
					]
				},
				{
					"id": 705520255,
					"content": "只要斩中一次，就能发挥雪崩般的破坏力…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520256
					]
				},
				{
					"id": 705520256,
					"content": "似乎比较强调…接触瞬间的冲击？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520257
					]
				},
				{
					"id": 705520257,
					"content": "不…不用说得那么艺术化！只是宗室流派西风剑术的变体，加一点我个人的发挥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520258
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520258,
					"content": "所以，优菈的格调，更像…入口冲击强劲，一击致胜，但又如冰块般，回甘中不含多余味道的烈酒——",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520259
					]
				},
				{
					"id": 705520259,
					"content": "火水！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520260
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520260,
					"content": "最近几年，火水的确随着至冬商人的生意繁荣，在各地流行起来，几乎每个酒吧都有以它作为基底的作品…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520261
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520261,
					"content": "我们一起找到了最佳答案！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520262
					]
				},
				{
					"id": 705520262,
					"content": "真有你的！那就试试看，把基底的果酿换成火水？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520263
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520263,
					"content": "度数的问题…不成问题！虽然远征队的同僚们被火水放倒过，但我…我有信心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520264
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520264,
					"content": "忙的时候，一般都吃些什么呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520265
					]
				},
				{
					"id": 705520265,
					"content": "最近的伙食？那可得聊聊后勤小队的新成就了——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520266
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520266,
					"content": "他们发起了一项「骑士饮食改进计划」，开始给我们这种野外作战的小队配发标准化的罐头。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520267
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520267,
					"content": "以前我们只能拿到干货，需要吃饭的时候，才支起锅和篝火，投骰子选人做饭，其余骑士轮流值岗警戒…有点麻烦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520268
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520268,
					"content": "现在只需带上装着五个罐头和九个纸包的「标准战地配给」，把罐头放在篝火边烤热，就能开饭了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520269,
						705520270
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520269,
					"content": "听起来还挺方便的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520271
					]
				},
				{
					"id": 705520271,
					"content": "哈哈，你也说了是「听起来」，对吧？罐头供应商的风评有口皆碑，普通款的口味的确不错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520272
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520272,
					"content": "问题就是…给我们的军用款为了符合保存标准，实在太咸了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520273
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520273,
					"content": "第五小队那个喜欢缺德笑话的副队长评价：「这罐头一开，璃月那位灶神都要攻打过来了」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520274
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520274,
					"content": "总之，吃了一周新罐头，我的味觉已经麻木了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520275,
						705520276
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520275,
					"content": "这么恐怖吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520277
					]
				},
				{
					"id": 705520277,
					"content": "这也不怨后勤小队，毕竟众口难调嘛，反馈已经提交上去了，罐头的不足之处，应该很快就会被改善！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520278
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520278,
					"content": "当然，在营地里吃小队专职厨师制作的新鲜饭菜，还是最好的选择。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520279
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520279,
					"content": "嗯，一切顺利，我明白要怎么为你准备第二杯特调了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520280
					]
				},
				{
					"id": 705520280,
					"content": "好啊，那就开始你的第二段即兴表演吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "优菈"
				},
				{
					"id": 705520276,
					"content": "谁该对此负责…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520277
					]
				},
				{
					"id": 705520270,
					"content": "听起来没什么缺点？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520271
					]
				},
				{
					"id": 705520245,
					"content": "要用剑术主题的特调来纪念吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520246
					]
				},
				{
					"id": 705520225,
					"content": "为什么会随身携带？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520226
					]
				},
				{
					"id": 705520218,
					"content": "有没有着凉？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520219
					]
				},
				{
					"id": 705520210,
					"content": "加烈酒还不够，大改配方！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520211
					]
				},
				{
					"id": 705520207,
					"content": "要加更狂的酒？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520208
					]
				}
			]
		},
		{
			"id": 7055203,
			"completionStepIds": [
				7055210
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
