			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"比勒"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715220101,
					"content": "这种游戏可真是太具有灵感了，哈哈哈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220102
					],
					"speakerTitle": "比勒"
				},
				{
					"id": 715220102,
					"content": "有什么新游戏？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715220103
					]
				},
				{
					"id": 715220103,
					"content": "旅行者！你来得正好，我正好在找人来试玩我制作的这种游戏呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220104
					],
					"speakerTitle": "比勒"
				},
				{
					"id": 715220104,
					"content": "朝这边看，我把这种游戏命名为「灵感喷激」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220105
					],
					"speakerTitle": "比勒"
				},
				{
					"id": 715220105,
					"content": "它完美地复原了我们诗人创作诗歌时的全过程！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220106,
						715220110
					],
					"speakerTitle": "比勒"
				},
				{
					"id": 715220106,
					"content": "你是说喝酒，喝酒和喝酒吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715220107
					]
				},
				{
					"id": 715220109,
					"content": "你详细说说呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715220110
					]
				},
				{
					"id": 715220107,
					"content": "哈哈哈，您真幽默，用酒来刺激灵感的确是个好主意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220108
					],
					"speakerTitle": "比勒"
				},
				{
					"id": 715220108,
					"content": "但要是想创作出真正出色的诗歌，光喝酒可不够。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220110
					],
					"speakerTitle": "比勒"
				},
				{
					"id": 715220110,
					"content": "在一次诗歌创作中，最开始我们得四处寻找灵感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220111
					],
					"speakerTitle": "比勒"
				},
				{
					"id": 715220111,
					"content": "有些人喜欢到处旅行、有些人喜欢独自沉思，还有些人嘛…格外喜欢用酒来刺激自己的思维。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220112
					],
					"speakerTitle": "比勒"
				},
				{
					"id": 715220112,
					"content": "这是最艰难的阶段，因为在寻找灵感的过程中，我们几乎感受不到灵感究竟在何处。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220113
					],
					"speakerTitle": "比勒"
				},
				{
					"id": 715220113,
					"content": "在大部分时间里，我们会觉得一无所获，变得烦躁又忧郁…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220114
					],
					"speakerTitle": "比勒"
				},
				{
					"id": 715220114,
					"content": "但实际上，在我们不自觉的情况下，灵感其实已经悄悄在我们的头脑中累积。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220115
					],
					"speakerTitle": "比勒"
				},
				{
					"id": 715220115,
					"content": "当某个契机到来，这些灵感就会一口气喷发而出，形成一首优秀的诗歌…或者是一幅画，或者其他什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220116
					],
					"speakerTitle": "比勒"
				},
				{
					"id": 715220116,
					"content": "这也能做成游戏吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715220117
					]
				},
				{
					"id": 715220117,
					"content": "哈哈哈，当然！这诗歌的创作过程清晰明确，十分容易理解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220118
					],
					"speakerTitle": "比勒"
				},
				{
					"id": 715220118,
					"content": "恰好蒙德城里有好几位擅长制作桌面游戏的先生，他们对我的想法十分感兴趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220119
					],
					"speakerTitle": "比勒"
				},
				{
					"id": 715220119,
					"content": "我们进行了几次充分的讨论，在集思广益下，这个名为「灵感喷激」的游戏就完美出炉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220120
					],
					"speakerTitle": "比勒"
				},
				{
					"id": 715220120,
					"content": "您要是感兴趣的话，现在就可以试玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220121
					],
					"speakerTitle": "比勒"
				},
				{
					"id": 715220121,
					"content": "要是多玩几局，说不定您也能学会创作诗歌呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "比勒"
				}
			]
		}
	]
}