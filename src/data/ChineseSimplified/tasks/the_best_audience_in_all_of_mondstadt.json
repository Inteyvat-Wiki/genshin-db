			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"杰克"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200630301,
					"content": "真想到处去冒险啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630302
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 200630302,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630303
					]
				},
				{
					"id": 200630303,
					"content": "昨天斯坦利先生又给我讲了个故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630304
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 200630304,
					"content": "但是他喝得有点多，故事讲得颠三倒四，我回忆回忆…应该是在<color=#00E1FFFF>晨曦酒庄附近</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630305
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 200630305,
					"content": "他应该是这么说的…「…不祥在那怪物的身上结成了冰晶，恶意让那怪物的身躯更加硕大，很快，恐惧冻结了我的双腿，我胡乱挥舞着武器，砍下的冰屑却只是迷住了我的眼睛…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630306
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 200630306,
					"content": "到底是什么怪物，居然能让斯坦利先生都陷入苦战呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630307
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 200630307,
					"content": "真想去亲眼看看…但是如果我去的话，应该只顾得上逃跑吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630308
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 200630308,
					"content": "不过，如果是你，应该就没问题了，你愿意帮我去找一找吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630309,
						200630311
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 200630309,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630310
					]
				},
				{
					"id": 200630310,
					"content": "那就拜托你了！找到之后，回来详细和我说说吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "杰克"
				},
				{
					"id": 200630311,
					"content": "一起去吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630312
					]
				},
				{
					"id": 200630312,
					"content": "我是很想一起去啦，但是冒险家协会的情况…你也看到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630313
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 200630313,
					"content": "塞琉斯先生一副要退休的样子，老是说要去清泉镇悠闲度日。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630314
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 200630314,
					"content": "赫尔曼先生自从有了女儿，连蒙德城都不出了，亏他之前还是王牌冒险家…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630315
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 200630315,
					"content": "还有斯坦利先生，他已经休息了好久，一直没有再去冒险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630316
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 200630316,
					"content": "现在协会想筹措经费，只能通过各种杂活…不过，现在连能干杂活的人都不多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630317
					],
