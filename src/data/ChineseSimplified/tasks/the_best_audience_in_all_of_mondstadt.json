				{
					"id": 200631203,
					"content": "找到是找到了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200631204
					]
				},
				{
					"id": 200631204,
					"content": "只是火史莱姆而已？怎么可能，斯坦利先生给我讲的故事，完全不是这样啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631205
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 200631205,
					"content": "斯坦利先生正好也在…斯坦利先生，您再说说那段冒险故事吧。",
