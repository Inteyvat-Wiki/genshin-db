				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"杰克"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200630201,
					"content": "我到底什么时候才能成为伟大的冒险家啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630202
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 200630202,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630203
					]
				},
				{
					"id": 200630203,
					"content": "哦，是你啊…塞琉斯先生昨天和我讲了一个冒险故事…这回是在<color=#00E1FFFF>望风山地</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630204
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 200630204,
					"content": "他是这么说的：「…那面粗糙的盾牌就像是一场我无力抵抗的噩梦，无论我的剑如何敲打，那面盾牌都不为所动，而在盾牌后面，那个怪物轻蔑地瞪着我，它咿呀的笑声正讥讽着我的无力…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630205
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 200630205,
					"content": "无论是什么攻击都能抵抗的木盾…唉，我真想去亲眼看看哪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630206
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 200630206,
					"content": "但是这么多杂活，怎么想都抽不开身…到底是什么恐怖的怪物，才会拿着这种东西呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630207
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 200630207,
					"content": "嗯…如果你愿意的话，能帮我去找找那个怪物吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630208,
						200630210
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 200630208,
					"content": "没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630209
					]
				},
				{
					"id": 200630209,
					"content": "太谢谢你了，找到之后，就回来和我具体讲讲吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "杰克"
				},
				{
					"id": 200630210,
					"content": "我和你一起去。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630211
					]
				},
				{
					"id": 200630211,
					"content": "我？不行啦，冒险家协会里还有很多杂事等着我做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630212
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 200630212,
					"content": "现在冒险活动实在不怎么赚钱，所以虽然说是冒险家协会，实际大部分时候都在到处帮人忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630213
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 200630213,
					"content": "比如帮杜拉夫先生赶野猪啦，帮玛格丽特小姐找猫啦，芙萝拉小姐今天想要几朵新鲜的花啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630214
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 200630214,
					"content": "哈哈哈，加入冒险家协会的时候，我可没想到等着我的会是这些「冒险」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "杰克"
				}
			]
		},
		{
			"id": 2006303,
			"completionStepIds": [
				2006301
