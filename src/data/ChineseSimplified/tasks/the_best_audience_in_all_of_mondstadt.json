			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"杰克"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200630101,
					"content": "唉，真想亲眼看看哪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630102
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 200630102,
					"content": "看什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630103
					]
				},
				{
					"id": 200630103,
					"content": "呜哇，你是什么时候来的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630104
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 200630104,
					"content": "是这样，斯坦利先生昨天喝了顿好酒，给我讲了他经历过的一场冒险，就在<color=#00E1FFFF>达达乌帕谷</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630105
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 200630105,
					"content": "他是这么说的：「…那个怪物猛烈地燃烧着，无定型的庞大身躯缓慢地蠕动，无论我怎么攻击，如何怒吼，它只挪了挪它那恐怖的巨眼，仿佛是在对我投以最极致的蔑视…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630106
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 200630106,
					"content": "虽然我没有亲眼见过，但是连斯坦利先生都陷入了苦战，那肯定是一场十分伟大的冒险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630107
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 200630107,
					"content": "唉，真想去找找看那个让斯坦利先生都陷入苦战的怪物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630108
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 200630108,
					"content": "但是就凭我的实力，十有八九会被打得只顾逃跑了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630109
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 200630109,
					"content": "对了，如果你有兴趣的话…愿意帮我去找找那只怪物吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630110,
						200630112
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 200630110,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630111
					]
				},
				{
					"id": 200630111,
					"content": "真是可靠！那么就拜托你了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "杰克"
				},
				{
					"id": 200630112,
					"content": "我可以陪你去。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630113
					]
				},
				{
					"id": 200630113,
					"content": "如果可以的话，我也确实想跟着你去，但是还有很多杂活等着我去做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630114
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 200630114,
					"content": "什么杂活？蒙德城里的冒险家协会这个情况，只是进行冒险的话，收入完全不够用啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630115
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 200630115,
					"content": "所以还会帮居民们做各种事，比如找猫啦，拔草啦之类的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630116
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 200630116,
					"content": "这场伟大的冒险就交给你了，找到了之后，一定要回来详细地告诉我啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "杰克"
				}
			]
		},
		{
			"id": 2006302,
			"completionStepIds": [
				2006301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
