					}
				]
			},
			"dialogs": [
				{
					"id": 752780101,
					"content": "两、两位！请你们留步！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780102
					],
					"speakerTitle": "「希顿」"
				},
				{
					"id": 752780102,
					"content": "怎么啦，小妹妹，你有什么事儿吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752780103,
					"content": "「承载绽放刺梨的奇迹，用圣火点燃你的笑容！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780104
					],
					"speakerTitle": "「希顿」"
				},
				{
					"id": 752780104,
					"content": "欸、欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752780105,
					"content": "「以悠悠度假村之名，为你献上欢迎的舞蹈，闪耀吧！皮皮潘偶像！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780106
					],
					"speakerTitle": "「希顿」"
				},
				{
					"id": 752780106,
					"content": "啊！这句台词，又来了吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752780107,
					"content": "#嗯，是我，「希顿」。嘿嘿，好久不见啊！我又来了！{NICKNAME}{M#哥哥}{F#姐姐}，派蒙姐姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780108
					],
					"speakerTitle": "「希顿」"
				},
				{
					"id": 752780108,
					"content": "原、原来是你啊，「希顿」，我还以为又遇到了什么可怕的人呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780109,
						752780110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752780109,
					"content": "遇到什么开心事儿了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752780111
					]
				},
				{
					"id": 752780111,
					"content": "嘿嘿，我跟你们说，老爹准备亲自辅导我，要把我打造成合格的演员！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780112
					],
					"speakerTitle": "「希顿」"
				},
				{
					"id": 752780112,
					"content": "虽然他嘴上凶凶的，结果还是很关照你的嘛！当然，要是他没有教给你奇怪的东西就更好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752780113,
					"content": "对了，这个送给你们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780114
					],
					"speakerTitle": "「希顿」"
				},
				{
					"id": 752780114,
					"content": "这、这是你的演出服？可没有了这个的话，你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752780115,
					"content": "嘿嘿，不用担心，老爹他给我做了一套更适合我的体型的演出服！这次我肯定不会再在舞台上摔倒了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780116
					],
					"speakerTitle": "「希顿」"
				},
				{
					"id": 752780116,
					"content": "至于原来的演出服，我已经把它做成摆件，请你们收下，把它作为我们友谊的象征吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780117
					],
					"speakerTitle": "「希顿」"
				},
				{
					"id": 752780117,
					"content": "等到下次见面，我会穿上新的演出服，为你们献上欢迎的舞蹈的！所以请你们以后一定来捧场，我会等着你们的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780118
					],
					"speakerTitle": "「希顿」"
				},
				{
					"id": 752780118,
					"content": "嗯，我们一定会的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752780119,
					"content": "「希顿」！该回来训练了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752780120,
					"content": "#好啦，时间不早了，我准备去锻炼肌肉了！{NICKNAME}{M#哥哥}{F#姐姐}，派蒙姐姐，再见！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780121
					],
					"speakerTitle": "「希顿」"
				},
				{
					"id": 752780121,
					"content": "嗯嗯，再见哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752780122,
					"content": "（你真的会去吗？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752780123
					]
				},
				{
					"id": 752780123,
					"content": "一定会的！当然…如果那个时候能看到普通的「偶像」表演就更好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752780110,
					"content": "最近怎么样？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752780111
					]
				}
			]
		}
	]
}