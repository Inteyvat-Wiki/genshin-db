			"dialogs": [
				{
					"id": 760980301,
					"content": "「…欢迎来到（…）号避难所，远道而来的朋友…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980302
					],
					"speakerTitle": "古老的终端"
				},
				{
					"id": 760980302,
					"content": "「…如果您正在听这段录音，那便意味着<color=#FF5E41FF>末日</color>即将来临…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980303
					],
					"speakerTitle": "古老的终端"
				},
				{
					"id": 760980303,
					"content": "哇啊！吓我一跳，这个居然还会响喔…不对，比起那个，它刚才是不是说了什么虽然我没听懂但是好像很可怕的事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980304,
						760980305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760980304,
					"content": "好像在说什么末日的事情…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760980308
					]
				},
				{
					"id": 760980308,
					"content": "「…幸运的是，您找到了这里，而我们也有幸能与您…共同…<color=#FF5E41FF>末日</color>后的…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980309
					],
					"speakerTitle": "古老的终端"
				},
				{
					"id": 760980309,
					"content": "「…请…密钥卡…<color=#00E1FFF>升降梯</color>已接通至…安全后…搭乘…前往避难所…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980310
					],
					"speakerTitle": "古老的终端"
				},
				{
					"id": 760980310,
					"content": "呜啊，是机器坏掉了吗？杂音把她的声音盖过去了，听不清她后面在说什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760980311,
					"content": "#完全搞不懂这里是用来做什么的…{NICKNAME}，要不然我们还是进去看看吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760980305,
					"content": "没什么，只是末日要来了而已。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760980306
					]
				},
				{
					"id": 760980306,
					"content": "哦哦，原来只是末日啊，那我就放心了——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760980307,
					"content": "怎么可能放心啦！这种时候就别用那种像是在说「明天的早餐是野菇鸡肉串」一样理所当然的语气啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980308
					],
					"speakerTitle": "派蒙"
				}
			]
		},
