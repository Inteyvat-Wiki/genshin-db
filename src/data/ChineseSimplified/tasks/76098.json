						],
						"pointId": 361100003
					}
				]
			},
			"dialogs": [
				{
					"id": 760980201,
					"content": "检测到未登记居民。正在启动标准安全检查程序…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980202
					],
					"speakerTitle": "古老的终端"
				},
				{
					"id": 760980202,
					"content": "扫描完成。检测到您携带有<color=#FF5E41FF>多件危险品</color>。为了其他避难所居民的安全，请将所有武器及危险物品放入指定的收纳柜中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980203
					],
					"speakerTitle": "古老的终端"
				},
				{
					"id": 760980203,
					"content": "欸，要我们把武器交出去？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760980204,
					"content": "请谅解。收缴危险品是为确保避难所居民的绝对安全。您的所有物品将被妥善保管，待您离开时即可取回。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980205
					],
					"speakerTitle": "古老的终端"
				},
				{
					"id": 760980205,
					"content": "若是您存在安全顾虑，还请务必放心。避难所内部搭载了最先进的<color=#FF5E41FF>末日</color>净化系统，您不会遇到任何危险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980206
					],
					"speakerTitle": "古老的终端"
				},
				{
					"id": 760980206,
					"content": "以（…）教授的名誉担保，无论天幕之外有何种魔物侵扰，都绝不会渗入我们的乐园分毫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980207
					],
					"speakerTitle": "古老的终端"
				},
				{
					"id": 760980207,
					"content": "呃，天幕之外？我们不是在海底吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760980208,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980209
					],
					"speakerTitle": "古老的终端"
				},
				{
					"id": 760980209,
					"content": "哦哦，我懂了！就和那夏镇的小说里写的一样，这个所谓的「末日」，其实是打算侵略我们提瓦特的外星人——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980210,
						760980211,
						760980212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760980210,
					"content": "少看点便宜的娱乐小说吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760980213
					]
				},
				{
					"id": 760980213,
					"content": "我只是在开玩笑啦！就算真有天外来的侵略者，也不会跑到这种地方来…呃，应该不会吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760980214,
					"content": "不过话说回来，既然是避难所，为了安全考虑要求卸下武器也…还算合理吧？除非这里其实在做什么奇怪的坏事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760980215,
					"content": "比如故意只提供特别难吃的食物之类的，或者故意让净水装置隔段时间就坏一次之类的，又或者大门永远都打不开之类的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760980216,
					"content": "请不必担忧。本避难所旨在提供绝对安全的庇护环境，所有居民均可随时自由离开。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980217
					],
					"speakerTitle": "古老的终端"
				},
				{
					"id": 760980217,
					"content": "#呃，既然它都这么说了…那要不然我们先按照它说的做吧，{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760980218,
					"content": "感谢您的配合。危险品已收纳。扫描完成，未检测到其他威胁。标准安全检查程序结束。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980219
					],
					"speakerTitle": "古老的终端"
				},
				{
					"id": 760980219,
					"content": "欢迎来到<color=#FF5E41FF>末日</color>后的避难所。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "古老的终端"
				},
				{
					"id": 760980211,
					"content": "这个…也不是没有这种可能啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760980213
					]
				},
				{
					"id": 760980212,
					"content": "原来如此，那丝柯克说不定会知道…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760980213
					]
				}
			]
		},
