						760980105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760980105,
					"content": "唔，搞不懂。总之我们先回那个终端那里，看看这次的密钥卡能解锁什么东西吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
