						760981502
					],
					"speakerTitle": "避难所主控制终端"
				},
				{
					"id": 760981502,
					"content": "哦哦，看来刚才捡到的那张密钥卡还能用！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760981503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760981503,
					"content": "话说回来，这个叫格蕾兹娜的研究员权限好高啊，现在整个避难所的所有区域好像都已经解锁了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760981504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760981504,
					"content": "唔，仔细看看的话，我们应该只剩下<color=#00E1FFF>监督办公室</color>还没去了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760981505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760981505,
					"content": "要是那个什么「末日」还在的话，就只有可能在这个地方了。哼，名字这么唬人却东躲西藏的，说不定其实很弱呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760981506,
						760981507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760981506,
					"content": "还是要保持警惕，不能轻敌。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760981509
					]
				},
				{
					"id": 760981509,
					"content": "好，我们现在就去<color=#00E1FFF>监督办公室</color>调查一下吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760981507,
					"content": "是我们太强了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760981508
					]
				},
				{
					"id": 760981508,
					"content": "#嗯嗯，毕竟我们是经验丰富的冒险家嘛！就算不用武器，{NICKNAME}也能上去「砰砰」两拳把怪物全部解决掉！",
