			"dialogs": [
				{
					"id": 150290401,
					"content": "竟然已经完成了制作吗？看来阁下此行去调查「七彩之战」确实获得了很有用的线索，希望阁下能不吝赐教。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290402
					],
					"speakerTitle": "庇兰"
				},
				{
					"id": 150290402,
					"content": "这一次的织物已经制作好了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290403
					],
					"speakerTitle": "卡胡鲁"
				},
				{
					"id": 150290403,
					"content": "被特拉波长老选中的人果然不会出错！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290404
					],
					"speakerTitle": "阿依瓦丁"
				},
				{
					"id": 150290404,
					"content": "#呃…请仔细听{NICKNAME}讲哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150290405,
					"content": "你向庇兰详细讲述了与那种「色彩」有关的一切，但小心地隐藏了有关茜特菈莉的部分。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150290406
					]
				},
				{
					"id": 150290406,
					"content": "原来如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290407
					],
					"speakerTitle": "庇兰"
				},
				{
					"id": 150290407,
					"content": "你看上去一点也不惊讶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150290408,
					"content": "其实不难想到，历史是一个民族的记忆，也只有源自记忆的色彩才能用来描绘历史吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290409
					],
					"speakerTitle": "庇兰"
				},
				{
					"id": 150290409,
					"content": "接下来，就是想办法把这种秘术传承下去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290410
					],
					"speakerTitle": "庇兰"
				},
				{
					"id": 150290410,
					"content": "#从{NICKNAME}的描述来看，想要把这种秘术传承下去，似乎需要主动分享自己的记忆？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290411
					],
					"speakerTitle": "庇兰"
				},
				{
					"id": 150290411,
					"content": "这个嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150290412,
					"content": "#那我就只能想办法安排祭司根据{NICKNAME}描述的原理重新研发这种秘术了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290413
					],
					"speakerTitle": "庇兰"
				},
				{
					"id": 150290413,
					"content": "毕竟记忆如此宝贵，大部分人都只会分享给自己最珍视的人，我不能替阁下做这种决定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290414
					],
					"speakerTitle": "庇兰"
				},
				{
					"id": 150290414,
					"content": "阁下已经出色地完成了这份使命，传承的任务就由烟谜主自己完成吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290415
					],
					"speakerTitle": "庇兰"
				},
				{
					"id": 150290415,
					"content": "嗯，听首领的安排！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290416
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150290416,
					"content": "另外，如果两位最近能见到黑曜石奶奶，请代我向她致谢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290417
					],
					"speakerTitle": "庇兰"
				},
				{
					"id": 150290417,
					"content": "我们对她抓捕的那名枫丹商人进行了审讯，发现最近那些质疑「七彩之战」真实性的族民都是受他暗中煽动才这么做的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290418
					],
					"speakerTitle": "庇兰"
				},
				{
					"id": 150290418,
					"content": "他专门雇佣了人手在族民之间传播流言，人为制造了这些争端。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290419
					],
					"speakerTitle": "庇兰"
				},
				{
					"id": 150290419,
					"content": "我们记录了他犯下的所有罪行，不日就将通过外交手段和枫丹方面进行交涉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290420
					],
					"speakerTitle": "庇兰"
				},
				{
					"id": 150290420,
					"content": "对哦，如果不制造这种争议的话，他根本没办法钻空子进来调查呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290421
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150290421,
					"content": "我就说哪有人会怀疑自己民族的英雄事迹？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290422
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150290422,
					"content": "那我们就此别过了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290423
					]
				},
				{
					"id": 150290423,
					"content": "来日再会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "庇兰"
				}
			]
		},
