				]
			},
			"dialogs": [
				{
					"id": 150290501,
					"content": "你们仔细跟他讲了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290502
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290502,
					"content": "嗯，特意隐藏了茜特菈莉的贡献哦。不过，好像差点被拆穿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150290503,
					"content": "明明你们也说是「神明的馈赠」，就能应付过去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290504
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290504,
					"content": "庇兰的努力值得一份回报。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290505
					]
				},
				{
					"id": 150290505,
					"content": "…我知道，他跟之前的那些首领都不太一样。我只是害怕万一把我暴露了，又有一堆麻烦事找上门来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290506
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290506,
					"content": "我找了好久，原来你们在这里！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290507
					],
					"speakerTitle": "艾列尔"
				},
				{
					"id": 150290507,
					"content": "是那个枫丹研究员…怎么没和那个奸商在一起？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150290508,
					"content": "叫我艾列尔就好…我也接受了审讯，因为我并未犯下任何实质性的罪行，所以被放出来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290509
					],
					"speakerTitle": "艾列尔"
				},
				{
					"id": 150290509,
					"content": "失去了雇主，我就得尽快返回枫丹，毕竟没了经费来源。不过在离开纳塔之前，我想至少完成之前的调查。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290510
					],
					"speakerTitle": "艾列尔"
				},
				{
					"id": 150290510,
					"content": "请问您愿意帮我把维奇琳的故事补全，让纳塔以外的人也能了解到她的事迹吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290511
					],
					"speakerTitle": "艾列尔"
				},
				{
					"id": 150290511,
					"content": "采访？真麻烦…我为什么要关心纳塔以外的人是否了解我们的故事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290512
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290512,
					"content": "不要误会，我并非想曲解你们的历史，或者以此牟利，我只是单纯地对其他国家的历史感兴趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290513
					],
					"speakerTitle": "艾列尔"
				},
				{
					"id": 150290513,
					"content": "我觉得，真正精彩的故事就应该让全提瓦特都知道，文化也就是在这样的交流中才变得繁荣起来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290514
					],
					"speakerTitle": "艾列尔"
				},
				{
					"id": 150290514,
					"content": "我觉得很有道理。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290515
					]
				},
				{
					"id": 150290515,
					"content": "那你快问，再过一会儿，奶奶我就要有重要的安排了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290516
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290516,
					"content": "「重要的安排」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290517
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150290517,
					"content": "非常感谢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290518
					],
					"speakerTitle": "艾列尔"
				},
				{
					"id": 150290518,
					"content": "艾列尔详细询问了与维奇琳有关的各种往事，直到茜特菈莉有些生气了才不得不离开。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150290519
					]
				},
				{
					"id": 150290519,
					"content": "今天的社交份额又超标了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290520
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290520,
					"content": "看来也到我们告别的时候了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290521
					]
				},
				{
					"id": 150290521,
					"content": "嗯…等一下，你还欠我两本绝版书呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290522
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290522,
					"content": "哦，是那个啊…有关轻小说的事，茜特菈莉果然记得很清楚呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290523
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150290523,
					"content": "可是一时半会儿找不到啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290524
					]
				},
				{
					"id": 150290524,
					"content": "我知道，那两本绝版书的珍稀程度我比你更了解，可能要专门去一趟稻妻的八重堂总部…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290525
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290525,
					"content": "我不需要你马上给我找到，不过你最好惦记着。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290526
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290526,
					"content": "嗯嗯，找到了就立刻给茜特菈莉送过去！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290527
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150290527,
					"content": "送过来…我挺讨厌宿醉的时候听到有人敲门，这样吧，这个给你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290528
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290528,
					"content": "这是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290529
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150290529,
					"content": "我家的钥匙，下次来就不要敲门了，扰人清梦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "茜特菈莉"
				}
			]
		},
