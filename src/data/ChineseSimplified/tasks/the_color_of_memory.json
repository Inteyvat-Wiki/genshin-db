				]
			},
			"dialogs": [
				{
					"id": 150290101,
					"content": "制作那种织物本来不需要你动手，但是，要是为了传承那种秘术，就非你不可了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290102
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290102,
					"content": "你在说什么啊，茜特菈莉？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150290103,
					"content": "先跟我来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290104
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290104,
					"content": "这个房间…茜特菈莉平时也制作织物吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150290105,
					"content": "织物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290106
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290106,
					"content": "织物？你不是说要给我看你此生最得意的作品？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290107
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290107,
					"content": "我没有说谎哦，老友，这种秘术就与织物有关。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290108
					],
					"speakerTitle": "维奇琳"
				},
				{
					"id": 150290108,
					"content": "唉…你说吧，到底是什么秘术？它是能逆转一场战争，还是能阻止一场灾难？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290109
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290109,
					"content": "现在的你，再想跟我约架也没办法从床上爬起来，我允许你在口头上赢过我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290110
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290110,
					"content": "咳咳…老友，我能感觉到我就要离开，已经没有时间再和你决出胜负了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290111
					],
					"speakerTitle": "维奇琳"
				},
				{
					"id": 150290111,
					"content": "喂…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290112
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290112,
					"content": "不要担心，我们烟谜主不是有个说法吗？这片大陆上的人类并不会真的死去，而是前往了夜神之国，那个由记忆构成的世界。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290113
					],
					"speakerTitle": "维奇琳"
				},
				{
					"id": 150290113,
					"content": "所以，我们的祖先为什么坚持用这种彩色织物来记录历史，你大概也能猜到吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290114
					],
					"speakerTitle": "维奇琳"
				},
				{
					"id": 150290114,
					"content": "因为，「历史」就是一个民族的「记忆」啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290115
					],
					"speakerTitle": "维奇琳"
				},
				{
					"id": 150290115,
					"content": "希望他们到那个世界之后仍能感受到夕阳的温暖，所以为「历史」染上橘红的底色吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290116
					],
					"speakerTitle": "维奇琳"
				},
				{
					"id": 150290116,
					"content": "希望他们到那个世界之后仍能欢度丰收的季节，所以为「历史」点缀上颗粒果的花纹吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290117
					],
					"speakerTitle": "维奇琳"
				},
				{
					"id": 150290117,
					"content": "这一点我当然知道…听起来像是一种重要的部族事务，为什么不托付给你的那些学生呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290118
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290118,
					"content": "我专门找你过来，确实带了作为朋友的一点私心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290119
					],
					"speakerTitle": "维奇琳"
				},
				{
					"id": 150290119,
					"content": "咳咳…仅凭剩下的时间，我恐怕无法让你明白这个决定了，但我相信你总会明白的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290120
					],
					"speakerTitle": "维奇琳"
				},
				{
					"id": 150290120,
					"content": "请先答应我最后的这个请求，可以吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290121
					],
					"speakerTitle": "维奇琳"
				},
				{
					"id": 150290121,
					"content": "…只有这一次哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290122
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290122,
					"content": "现在，我确实明白你的决定了。小爪，帮我把它搬到室外，我要准备给它上色了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290123
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290123,
					"content": "！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290124
					],
					"speakerTitle": "特拉波"
				},
				{
					"id": 150290124,
					"content": "#{NICKNAME}和派蒙也请跟我来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "茜特菈莉"
				}
			]
		},
