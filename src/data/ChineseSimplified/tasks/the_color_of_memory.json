				]
			},
			"dialogs": [
				{
					"id": 150290201,
					"content": "我等皆是在时光中漫游的飞鸟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290203
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290203,
					"content": "（播片）",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150290204
					]
				},
				{
					"id": 150290204,
					"content": "你果然懂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290205
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290205,
					"content": "这…这该不会就是我们需要制作的那种织物吧？茜特菈莉怎么知道它的制作方法的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150290206,
					"content": "派蒙，想想那位「神明」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290207
					]
				},
				{
					"id": 150290207,
					"content": "茜特菈莉活了两百多年，茜特菈莉知道制作这种织物的方法…难道茜特菈莉就是馈赠织物的那位神明？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150290208,
					"content": "我可不想接触那些被谕示选中的人，所以每次都是使用幻术迷惑他们之后再把织物留下来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290209
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290209,
					"content": "这些人能把这当成是「神明的馈赠」，只能说水平太差，看不穿我的法术。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290210
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290210,
					"content": "为什么瞒着大家？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290211
					]
				},
				{
					"id": 150290211,
					"content": "对啊，茜特菈莉为什么要独自把这份使命背负两百年呢？就算不喜欢和其他人接触，也可以把这种方法传授给别人吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150290212,
					"content": "#…{NICKNAME}，你能看到那种「色彩」吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290213
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290213,
					"content": "是的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290214
					]
				},
				{
					"id": 150290214,
					"content": "那种「色彩」的本质是「记忆」，为这种织物上色的过程其实就是从记忆里寻找色彩的过程。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290215
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290215,
					"content": "如果要把这种秘术传承下去，首先要和另一个人分享记忆，在彼此的记忆中留下自己的颜色。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290216
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290216,
					"content": "虽然直到今天才完全明白这一点，但我之前已经或多或少地意识到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290217
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290217,
					"content": "而维奇琳离开以后，我一直都抗拒和别人产生这样的交集。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290218
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290218,
					"content": "是这样啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150290219,
					"content": "但这毕竟是她生前最后的委托，所以我确实想过，既然我的人生如此漫长，不如就让我一个人永久地背负这项使命吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290220
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290220,
					"content": "！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290221
					],
					"speakerTitle": "特拉波"
				},
				{
					"id": 150290221,
					"content": "可是，小爪这家伙明明知道这一点，却还是在不停地指定新的人选。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290222
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290222,
					"content": "它是向你推荐新的朋友吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290223
					]
				},
				{
					"id": 150290223,
					"content": "…我一开始就猜到了，让我愿意分享记忆的人，自然也能成为我的朋友，可是我一直拒绝它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290224
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290224,
					"content": "不过，这一次就算你成功了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290225
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290225,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290226
					],
					"speakerTitle": "特拉波"
				},
				{
					"id": 150290226,
					"content": "…收下这个，这也算是我给你的回复。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290227
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290227,
					"content": "这是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290228
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150290228,
					"content": "如果非要选一种颜色作为「我的颜色」，那它肯定是这个手帕的颜色。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290229
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290229,
					"content": "这几百年来一直是别人活在我的记忆里，但总有一天，我也会活在别人的记忆里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290230
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290230,
					"content": "你说你的寿命也很长，那你作为承载这份记忆的人选肯定很合适…我希望你的记忆里也会有我的颜色。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290231
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290231,
					"content": "看来我正式成为你的朋友了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290232
					]
				},
				{
					"id": 150290232,
					"content": "…收好它，到时候千万不要把颜色搞错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290233
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290233,
					"content": "才刚刚成为朋友，就要规划到生命结束的时候吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290234
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150290234,
					"content": "朋友不就是这样的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290235
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290235,
					"content": "#真是好严肃的约定啊…不过话说回来，要是{NICKNAME}想要在茜特菈莉的记忆里留下颜色，那肯定是金色吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290236
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150290236,
					"content": "已经留下了哦，记得那个还没有被处理掉的副作用吗？我现在总算找到原因了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290237
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290237,
					"content": "分享感官的秘术其实是一种意识层面上的交流，自然也会牵扯到「记忆」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290238
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290238,
					"content": "我没想到你和我一样，都能看到那种「记忆的色彩」，和你分享感官的时候，它就在我们的记忆里留下了联系。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290239
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290239,
					"content": "这种联系反过来作用到分享感官使用的秘术上，结果就变成了现在的样子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290240
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290240,
					"content": "#哦，所以是因为{NICKNAME}确实在茜特菈莉的记忆里留下了颜色，茜特菈莉才能听到{NICKNAME}的心声？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290241
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150290241,
					"content": "#那反过来也一样吧？所以之前{NICKNAME}也能听到茜特菈莉的心声！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290242
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150290242,
					"content": "想得轻巧，要做到这一点，首先得保证自己有很高的秘术造诣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290243
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290243,
					"content": "#所以{NICKNAME}身上的副作用也就持续了那么一段时间，而我身上的却持续到现在…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290244
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290244,
					"content": "不过不用担心啦，现在我搞明白了它背后的原理，很快就能把它处理掉的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290245
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290245,
					"content": "哦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290246
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150290246,
					"content": "（其实我是骗派蒙的，决定能不能听到对方心声的关键，应该是自己在对方记忆里留下的印象有多深刻。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290247
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290247,
					"content": "（经历了这一切，你恐怕又能听到我的心声了。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290248
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290248,
					"content": "（！）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290249
					]
				},
				{
					"id": 150290249,
					"content": "（果然已经能听到了啊…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290250
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290250,
					"content": "（那么有什么解决办法吗？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290251
					]
				},
				{
					"id": 150290251,
					"content": "（在记忆层面建立了这种联系之后，我唯一能想到的解决办法，就是你忘了我，或者我忘了你。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290252
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290252,
					"content": "（……）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290253
					]
				},
				{
					"id": 150290253,
					"content": "（吓唬你的啦，奶奶我可是烟谜主的传奇大萨满，现在我搞清楚了这种副作用的成因，有的是办法处理它。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290254
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290254,
					"content": "（只是估计要花费一段时间…最近的话，暂且先忍受一下这种副作用吧。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290255
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290255,
					"content": "（放心，奶奶我内心坦荡，也不怕被你听到什么…对了，喝酒之后的不算。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290256,
						150290259
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290256,
					"content": "（能处理掉？有点遗憾啊…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290257
					]
				},
				{
					"id": 150290257,
					"content": "（遗憾？你要是还想玩这种心灵感应，再找我使用一次共感的秘术就可以。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290258
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290258,
					"content": "（先说好了，我可不是在承诺什么啊。有些想法，还是藏在你的心里更好。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290261
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150290261,
					"content": "呃…嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150290259,
					"content": "（能处理掉？那就好。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290260
					]
				},
				{
					"id": 150290260,
					"content": "（我知道，有些想法还是藏在自己心里更好。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290261
					],
					"speakerTitle": "茜特菈莉"
				}
			]
		},
