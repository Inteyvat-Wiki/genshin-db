					"维多利亚"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190030601,
					"content": "咦？你好，还有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030602
					],
					"speakerTitle": "维多利亚"
				},
				{
					"id": 190030602,
					"content": "关于芭芭拉的假期…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030603
					]
				},
				{
					"id": 190030603,
					"content": "你说这个啊，没错，芭芭拉小姐刚才是向我请了半天假，说是要陪陪一位朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030604
					],
					"speakerTitle": "维多利亚"
				},
				{
					"id": 190030604,
					"content": "不过，这还真是罕见…芭芭拉小姐居然会专门为了一位朋友请假…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030605
					],
					"speakerTitle": "维多利亚"
				},
				{
					"id": 190030605,
					"content": "好了，还是先说正事吧，你找我有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030606
					],
					"speakerTitle": "维多利亚"
				},
				{
					"id": 190030606,
					"content": "关于「了不起的梦幻忧郁珊瑚气泡茶」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030607
					]
				},
				{
					"id": 190030607,
					"content": "欸？芭芭拉小姐要陪你去买这个…特别饮品？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030608
					],
					"speakerTitle": "维多利亚"
				},
				{
					"id": 190030608,
					"content": "难道芭芭拉小姐之前说的朋友就是你吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030609
					],
					"speakerTitle": "维多利亚"
				},
				{
					"id": 190030609,
					"content": "啊…如果是你这位「荣誉骑士」的话，倒也说得过去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030610
					],
					"speakerTitle": "维多利亚"
				},
				{
					"id": 190030610,
					"content": "好吧，情况我了解了。那芭芭拉小姐就麻烦你多多照顾了，「荣誉骑士」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030611
					],
					"speakerTitle": "维多利亚"
				},
				{
					"id": 190030611,
					"content": "为什么芭芭拉的假期要报备行程？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030612
					]
				},
				{
					"id": 190030612,
					"content": "这个啊…你也知道，因为各种原因，芭芭拉小姐在蒙德城里很受欢迎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030613
					],
					"speakerTitle": "维多利亚"
				},
				{
					"id": 190030613,
					"content": "虽然居民们都是出于好意，但好意太多了，芭芭拉小姐有时候也实在忙不过来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030614
					],
					"speakerTitle": "维多利亚"
				},
				{
					"id": 190030614,
					"content": "如果是在工作中，教会里的人可以及时出来为她解围。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030615
					],
					"speakerTitle": "维多利亚"
				},
				{
					"id": 190030615,
					"content": "但要是在假期中…那就只能靠芭芭拉小姐自己了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030616
					],
					"speakerTitle": "维多利亚"
				},
				{
					"id": 190030616,
					"content": "但她又太…温柔，对居民们的请求向来都会尽量满足，甚至会把自己弄得比工作日还疲惫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030617
					],
					"speakerTitle": "维多利亚"
				},
				{
					"id": 190030617,
					"content": "我们就想，让芭芭拉小姐把自己的假期行程报备一下，要真的需要我们出面解围，那我们也好及时赶过去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030618
					],
					"speakerTitle": "维多利亚"
				},
				{
					"id": 190030618,
					"content": "真希望芭芭拉小姐不要再勉强自己了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "维多利亚"
				}
			]
		},
