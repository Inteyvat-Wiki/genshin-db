			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"维多利亚"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190030301,
					"content": "你怎么又回来了，如果你还是来找芭芭拉小姐的话，她还没回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030302,
						190030303
					],
					"speakerTitle": "维多利亚"
				},
				{
					"id": 190030302,
					"content": "已经在奔狼领找到芭芭拉了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030304
					]
				},
				{
					"id": 190030304,
					"content": "是这样吗…她没什么事就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030305
					],
					"speakerTitle": "维多利亚"
				},
				{
					"id": 190030305,
					"content": "但一时半会她应该也回不来了吧，看来我得把教会的事情拜托给其他人做了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030306
					],
					"speakerTitle": "维多利亚"
				},
				{
					"id": 190030306,
					"content": "我来帮忙吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030307
					]
				},
				{
					"id": 190030307,
					"content": "你愿意帮忙的话那就最好了，真是不好意思，还要麻烦你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030308
					],
					"speakerTitle": "维多利亚"
				},
				{
					"id": 190030308,
					"content": "我想想…那请你帮我去教会周围打扫一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030309
					],
					"speakerTitle": "维多利亚"
				},
				{
					"id": 190030309,
					"content": "教会周围人来人往，地面总是很脏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030310
					],
					"speakerTitle": "维多利亚"
				},
				{
					"id": 190030310,
					"content": "这些事之前一直是芭芭拉小姐一个人负责，她一不在，周围就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030311
					],
					"speakerTitle": "维多利亚"
				},
				{
					"id": 190030311,
					"content": "这么大的地方，都是芭芭拉小姐一个人打扫吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030312
					]
				},
				{
					"id": 190030312,
					"content": "是的，芭芭拉小姐一直说自己没问题，也不让其他人帮忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030313
					],
					"speakerTitle": "维多利亚"
				},
				{
					"id": 190030313,
					"content": "但每次打扫结束后，她的样子都很疲惫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030314
					],
					"speakerTitle": "维多利亚"
				},
				{
					"id": 190030314,
					"content": "说实话，你愿意帮忙，或者说…芭芭拉小姐愿意让你来帮忙，还让我挺意外的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030315
					],
					"speakerTitle": "维多利亚"
				},
				{
					"id": 190030315,
					"content": "不过，这样她的负担也许会小一些吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030316
					],
					"speakerTitle": "维多利亚"
				},
				{
					"id": 190030316,
					"content": "总之，那清扫的事就拜托你了，「荣誉骑士」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "维多利亚"
				},
				{
					"id": 190030303,
					"content": "芭芭拉去晨曦酒庄给特纳看病了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030304
					]
				}
			]
		},
