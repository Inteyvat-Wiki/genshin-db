			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 726780401,
					"content": "呜呶呶…风好大…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780402
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726780402,
					"content": "这里的风墙，是过不去的喔！要绕路走才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726780403,
					"content": "吉法师，跟着我们慢慢从旁边绕上去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7267805,
			"completionStepIds": [
				7267807
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7267807",
							"2"
						],
						"stepId": 7267807,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 726780501,
					"content": "终于上来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726780502,
					"content": "这里的视线，比下面好多了。你看，那边就是我们来的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726780503,
					"content": "派蒙很喜欢高的地方？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780504,
						726780505
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726780504,
					"content": "在高的地方视野很好，滑翔也方便。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780507
					]
				},
				{
					"id": 726780507,
					"content": "风风龙睡在这个塔里面吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780508
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726780508,
					"content": "嗯，在里面睡了好久好久。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780509
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726780509,
					"content": "#虽然{NICKNAME}和「风魔龙」战斗，但是它不是坏龙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780510
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726780510,
					"content": "只是遇到了难过的事情，受了伤害，又被坏人骗了，所以以为，风神朋友不要它了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780511
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726780511,
					"content": "呶…后来呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780512
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726780512,
					"content": "#后来呀…{NICKNAME}，你还记得吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780513
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726780513,
					"content": "我们在战斗中，净化了「毒血」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780514
					]
				},
				{
					"id": 726780514,
					"content": "但是，战斗的平台也坍塌了。本来，我们，还有风神都要掉到好深好深、好黑好黑的地方去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780515
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726780515,
					"content": "#呶！好可怕…那么，派蒙和{NICKNAME}怎么办？飞出来？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780516,
						726780519
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726780516,
					"content": "特瓦林救了我们。载着我们飞走了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780517
					]
				},
				{
					"id": 726780517,
					"content": "特…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780518
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726780518,
					"content": "就是「风魔龙」啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780520
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726780520,
					"content": "#「风魔龙」是有自己的名字的喔，就像吉法师、派蒙和{NICKNAME}一样。它叫特瓦林。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780521
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726780521,
					"content": "开始，特瓦林受了伤害、又被坏人骗了，非常非常生气，还到蒙德城去大闹了一场。大家都觉得它是坏龙，所以叫它「风魔龙」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780522
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726780522,
					"content": "后来，我们打倒了坏人，又和风神一起净化了污染它的毒血，它才知道，风神其实没有抛弃它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780523
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726780523,
					"content": "喔！特…风风龙就变好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780524
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726780524,
					"content": "没错！所以说呀…派蒙今天带吉法师到这里来修行，就是想告诉吉法师特瓦林的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780525
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726780525,
					"content": "吉法师长大以后，也会遇到误解、遇到伤害、遇到难过的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780526
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726780526,
					"content": "但是，也一定不能变成坏人。因为，「风向是会转变的」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780527
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726780527,
					"content": "总有一天，会吹向更光明的方向。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780528
					]
				},
				{
					"id": 726780528,
					"content": "呶？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780529
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726780529,
					"content": "对吉法师来说，会不会太难懂？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780530
					]
				},
				{
					"id": 726780530,
					"content": "好像懂了，但又不太懂呶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780531
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726780531,
					"content": "#不过，吉法师知道是很重要的事情。派蒙和{NICKNAME}说的事情，不会忘记的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780532
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726780532,
					"content": "嗯！那就没辜负我花了好长好长时间想的故事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780533
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726780533,
					"content": "不过，吉法师也不要太贪玩、太调皮，被人封印起来喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780534,
						726780535
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726780534,
					"content": "吉法师这次的修行也告一段落了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780536
					]
				},
				{
					"id": 726780536,
					"content": "呜呶呶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780537
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726780537,
					"content": "别这么难过嘛！要笑着回去，这样五百藏才会高兴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780538
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726780538,
					"content": "#好啦，派蒙和{NICKNAME}也要完成好向导最后的职责啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780539
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726780539,
					"content": "那就是，把吉法师送回五百藏身边。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780540,
						726780541
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726780540,
					"content": "我们走吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780542
					]
				},
				{
					"id": 726780542,
					"content": "呶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726780541,
					"content": "我们走吧，吉法师。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780542
					]
				},
				{
					"id": 726780535,
					"content": "五百藏的委托也算是完成了吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780536
					]
				},
				{
					"id": 726780519,
					"content": "风魔龙救了我们。载着我们飞走了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780520
					]
				},
				{
					"id": 726780505,
					"content": "「笨蛋和烟…」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780506
					]
				},
				{
					"id": 726780506,
					"content": "喂！才不是这么回事啦。在高的地方，视野很好，而且空气也比较清新。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780507
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7267808,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
