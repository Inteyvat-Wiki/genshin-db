			"dialogs": []
		},
		{
			"id": 7267811,
			"completionStepIds": [
				7267811
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7267811",
							"2"
						],
						"stepId": 7267811,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"五百藏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726790101,
					"content": "五百藏，我们回来啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726790102,
					"content": "喔，回来啦！吉法师，修行的成果如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790103
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726790103,
					"content": "咔嚓咔嚓，砰砰！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790104
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726790104,
					"content": "呶哈哈哈，真不错！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790105
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726790105,
					"content": "呜哇，又听不懂吉法师说的话了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726790106,
					"content": "我们还拍了好多好多照片。五百藏，你看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726790107,
					"content": "将这段时间一同旅行时，为吉法师拍的照片，一张张交给了五百藏。\\n连同旅行中遇到的事情，也说给了五百藏听。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						726790108
					]
				},
				{
					"id": 726790108,
					"content": "…就这样，我们完成了五百藏「带吉法师去八个地方修行」的要求。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726790109,
					"content": "嗯！不愧是吾辈看上的人，真不错。假如你们这些小辈是狸子，那想必也能成为名震天下的大妖狸。可能加起来有吾辈一半强吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790110
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726790110,
					"content": "（听起来也没有很强嘛…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726790111,
					"content": "不过，既然任务完成了，我们也该走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726790112,
					"content": "呜呶呶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790113
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726790113,
					"content": "好啦好啦，别这样。派蒙再教吉法师一件事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726790114,
					"content": "和朋友告别的时候，要笑着告别！这样的话，下次再见的时候，会更加开心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726790115,
					"content": "…唔？好的，没问题。交给吾辈吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790116
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726790116,
					"content": "吉法师说，「知道了。白毛。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790117
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726790117,
					"content": "欸？难道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790118,
						726790119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726790118,
					"content": "吉法师又不能说话了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726790120
					]
				},
				{
					"id": 726790120,
					"content": "过了这么久时间，妖狸饭的效果也该消退了嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790121
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726790121,
					"content": "哼，吾辈要是没被封印在石头里的话，想要让你们一直都能听懂妖狸说的话，也是易如…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790122
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726790122,
					"content": "…嗯？好，吾辈帮你传达一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790123
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726790123,
					"content": "「吉法师要努力修行。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790124
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726790124,
					"content": "「变成像五百藏那样的大妖狸。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790125
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726790125,
					"content": "…呶？你这家伙，口气不小。呶哈哈哈，有吾辈当年的气魄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790126
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726790126,
					"content": "「那样，白毛、黄毛不用吃妖狸的饭，也可以听懂吉法师说话。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790127
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726790127,
					"content": "…嗯！我会等着，下次和吉法师一起修行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726790128,
					"content": "吉法师要加油。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726790129
					]
				},
				{
					"id": 726790129,
					"content": "不要被人封印了喔。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726790130
					]
				},
				{
					"id": 726790130,
					"content": "呶？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790131
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726790131,
					"content": "呶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790132
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726790132,
					"content": "算了，看你们这些人类带吉法师修行的份上，吾辈就不计较了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790133
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726790133,
					"content": "对了。之前有个叫歌麿的家伙，在镇守之森里画被封印的狸子，还留下了一些画稿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790134
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726790134,
					"content": "就给你们吧。如果想念我们妖狸一族的俊朗模样，就看看这些画像吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790135
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726790135,
					"content": "唉，如果你们是妖狸就好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790136
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726790136,
					"content": "…那我们早该变成石头了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726790137
					]
				},
				{
					"id": 726790137,
					"content": "哼，也对。没啥事就快走吧，吾辈，还要教吉法师法术呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726790119,
					"content": "我们又听不懂吉法师说的话了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726790120
					]
				}
			]
		}
	]
}