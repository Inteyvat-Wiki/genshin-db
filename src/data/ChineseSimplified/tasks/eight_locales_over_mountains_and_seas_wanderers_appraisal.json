			},
			"dialogs": [
				{
					"id": 726780301,
					"content": "呶…很好看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780302
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726780302,
					"content": "吉法师，你怎么啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726780303,
					"content": "这个城市很荒凉，感觉有点难过，不知道为什么。奇怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780304,
						726780305
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726780304,
					"content": "我也觉得。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780306
					]
				},
				{
					"id": 726780306,
					"content": "接下来，我们就向「城市」的中心前进吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726780305,
					"content": "吉法师真奇怪！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780306
					]
				}
			]
		},
		{
			"id": 7267804,
			"completionStepIds": [
				7267804
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
