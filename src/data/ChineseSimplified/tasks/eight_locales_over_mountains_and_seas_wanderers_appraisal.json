			},
			"dialogs": [
				{
					"id": 726780101,
					"content": "好大的城市，但是…感觉，好荒凉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780102
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726780102,
					"content": "#以前，我和{NICKNAME}、还有很多同伴一起，曾经在这里和「风魔龙」战斗呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726780103,
					"content": "是那种，身体大大，翅膀飞飞、牙齿尖尖，很可怕的龙吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780104,
						726780105
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726780104,
					"content": "其实没有那么可怕。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780106
					]
				},
				{
					"id": 726780106,
					"content": "吉法师还记得，之前我们在蒙德城看到的风神像吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726780107,
					"content": "风神像…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780108
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726780108,
					"content": "就是那个，好高好高的石头像啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726780109,
					"content": "呶！记得。风神的手好大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780110
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726780110,
					"content": "「风魔龙」是风神的好朋友呢！以前，风神也是从这个「城市」来的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726780111,
					"content": "喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780112
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726780112,
					"content": "但是，如果风风龙很大，那要怎么进来呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780113,
						726780114
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726780113,
					"content": "以前好像也有谁问过一样的问题…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780115
					]
				},
				{
					"id": 726780115,
					"content": "啊，这个派蒙知道！因为它不用像我们这样，从那边走…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726780116,
					"content": "吉法师想到了。风风龙会飞，所以不用走进来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780117
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726780117,
					"content": "可、可恶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726780118,
					"content": "呶？派蒙，好像有点不开心？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780119
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726780119,
					"content": "嗯…这些之后再说，先在这里拍照纪念吧！吉法师，不要乱动喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726780120,
					"content": "吉法师站好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726780114,
					"content": "是「风魔龙」啦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780115
					]
				},
				{
					"id": 726780105,
					"content": "其实也很漂亮。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780106
					]
				}
			]
		},
