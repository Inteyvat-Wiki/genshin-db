			"dialogs": [
				{
					"id": 710480201,
					"content": "你回来了，冒险家协会欢迎你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710480202,
						710480206,
						710480208,
						710480211
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 710480202,
					"content": "关于层岩巨渊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710480203
					]
				},
				{
					"id": 710480203,
					"content": "你是想问那里有什么吗？哈哈，谁知道呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710480204
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 710480204,
					"content": "有人说矿工挖出了许愿石，许下愿望却收获了适得其反的报应；也有人说挖出了老龙王的尾巴…都是些好笑的谣言而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710480205
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 710480205,
					"content": "好了，不必找我问层岩巨渊的事，我也不是很清楚那边发生过什么。去跟沐宁说就好。这是总务司的要求。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "岚姐"
				},
				{
					"id": 710480206,
					"content": "关于委托…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710480207
					]
				},
				{
					"id": 710480207,
					"content": "咳咳…大街上到处都是靠层岩巨渊吃饭的商户，你不怕惹麻烦，但我可是要养活冒险家协会的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "岚姐"
				},
				{
					"id": 710480208,
					"content": "关于沐宁…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710480209
					]
				},
				{
					"id": 710480209,
					"content": "啊，他呀…哼，把他调到层岩巨渊，恐怕也是因为总务司想要磨炼一下他吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710480210
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 710480210,
					"content": "像他这种出身优越的小子就是容易得意忘形，公务人员总这样飘飘的可不行…层岩巨渊会让他长大的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "岚姐"
				},
				{
					"id": 710480211,
					"content": "再见。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710480212
					]
				},
				{
					"id": 710480212,
					"content": "嗯，啊…向着星辰与深渊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "岚姐"
				}
			]
		}
	]
