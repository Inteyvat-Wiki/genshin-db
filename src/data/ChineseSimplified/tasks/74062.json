			},
			"dialogs": [
				{
					"id": 740620201,
					"content": "要是之前没惹恼卡兰萨就好了，说不定和他交涉反而更轻松呢。唉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "纳库尔"
				}
			]
		},
		{
			"id": 7406203,
			"completionStepIds": [
				7406203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
