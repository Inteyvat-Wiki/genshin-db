						"stepId": 7406203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"某人"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							4345.313,
							159.157,
							4639.87
						],
						"pointId": 4926
					},
					{
						"sceneId": 3,
						"position": [
							4345.289,
							158.024,
							4642.497
						],
						"pointId": 4927
					}
				]
			},
			"dialogs": [
				{
					"id": 740620301,
					"content": "（听纳库尔的说法，不是枫丹本地人的话，好像会受排斥？他会不会也不愿意理我们呀？有没有什么好办法…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620302,
					"content": "（敲门。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620303
					]
				},
				{
					"id": 740620303,
					"content": "谁啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620304,
						740620306,
						740620309
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620304,
					"content": "无名的旅人，周游各国的冒险家。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620305
					]
				},
				{
					"id": 740620305,
					"content": "…这儿什么时候变成观景点了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620312
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620312,
					"content": "#{NICKNAME}，认真一点啦，别忘了我们的目的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620313,
						740620378
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620313,
					"content": "我们受人委托有事与你商谈。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620314
					]
				},
				{
					"id": 740620314,
					"content": "事情是这样，我们受人委托和你商量，不知道你愿不愿意租借这个房间？当然，委托人会支付特许券的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620315,
					"content": "之前好像也发生过类似的事情…三番两次的，还真是不死心啊。就是那个说话拿腔拿调的家伙派你们来的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620316
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620316,
					"content": "算了，看在他锲而不舍的份上…你们开个价吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620317
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620317,
					"content": "（太好了，看来也不是完全没有沟通的余地嘛。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620318,
					"content": "（纳库尔已经告诉我们他的心理预期，我们开价的话，要一开始就老实报出底线吗？还是试试压价？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620319,
						740620356
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620319,
					"content": "（诚实报出底线吧。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620320
					]
				},
				{
					"id": 740620320,
					"content": "好喔，那我就实话实说了。委托人的心理预期就是五万四千特许券，我觉得是很划算啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620321
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620321,
					"content": "五万四千？和上次捶门的疯子的报价相比…只涨了一成。这也没涨多少嘛，真吝啬啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620322
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620322,
					"content": "这还少吗？我觉得已经很多了欸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620323,
					"content": "真没见识啊。你们知道卡兰萨吗？他出手可阔绰多了，他愿意出…出十万八！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620324
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620324,
					"content": "真的吗？这么多？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620325
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620325,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620326
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620326,
					"content": "…当、当然是真的。你看我像会说谎的人吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620327
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620327,
					"content": "隔着门我们根本什么都看不见啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620328
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620328,
					"content": "（听他说话不是很有底气的样子，说不定根本就是他编出来骗我们的。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620329
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620329,
					"content": "#（{NICKNAME}，我们接下来要怎么谈呢？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620330,
						740620340
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620330,
					"content": "（诚意就这么多，让他差不多得了。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620331
					]
				},
				{
					"id": 740620331,
					"content": "我们一开始就实话实说了，只有五万四千这么多。十万八也太夸张了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620332
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620332,
					"content": "如果你不愿意的话，我们…我们好像也没有别的好办法，只能放弃了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620333
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620333,
					"content": "只要再等等…再等等就会涨上去的。等你们下次，下下次来的时候，一定会带来更高的报价！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620334
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620334,
					"content": "我是不会看错走势的！一定会涨！所以我得忍住！不能这么轻易就同意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620335
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620335,
					"content": "你说得这么笃定，是有什么根据吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620336
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620336,
					"content": "那当然是经验！前两次的经验告诉我，只要我不打断，上升的趋势就会继续，这不是很简单的道理吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620337
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620337,
					"content": "这是哪门子的道理啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620338
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620338,
					"content": "你是小孩子，当然不懂。总之，现在还不是时候，我是不会松口的，你们走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620339
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620339,
					"content": "#呃…看来他是不会改变心意了。{NICKNAME}，我们回去告诉纳库尔吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620340,
					"content": "（他想算计我们，那就诈他一诈。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620341
					]
				},
				{
					"id": 740620341,
					"content": "呜呜…没想到有卡兰萨这么强的竞争对手，不管怎么想都比不过嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620342
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620342,
					"content": "#{NICKNAME}，我们这就走吧，回去告诉纳库尔，他的出价太低，人家根本看不上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620343
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620343,
					"content": "门那头的先生，祝你和卡兰萨聊得开心。我们先告辞了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620344
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620344,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620345
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620345,
					"content": "…欸？这就走了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620346
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620346,
					"content": "喂，你们还在吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620347
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620347,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620348
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620348,
					"content": "喂——先别着急走啊——你们回来一下——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620349
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620349,
					"content": "大老远就听到你喊我们，怎么啦，是想要让我们帮你把卡兰萨喊过来吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620350
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620350,
					"content": "那怎么好意思，太麻烦你们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620351
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620351,
					"content": "#不麻烦不麻烦，反正是顺路，对吧，{NICKNAME}？这点小忙只是举手之劳而已！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620352
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620352,
					"content": "咳咳…你这小家伙还挺坏心眼。说正经的，你们刚才的报价还算数吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620353
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620353,
					"content": "现在还算，但过会儿就不知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620354
					]
				},
				{
					"id": 740620354,
					"content": "好吧，我认了，那就这个数吧。不过，让你们的委托人亲自来谈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620355
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620355,
					"content": "#好欸！{NICKNAME}，我们回去告诉纳库尔吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620356,
					"content": "（狠狠地压价！）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620357
					]
				},
				{
					"id": 740620357,
					"content": "那…那就两万七！两万七特许券你看怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620358
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620358,
					"content": "两万七？！开什么玩笑，你们是特意来羞辱我的吗？怎么比之前还少了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620359
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620359,
					"content": "那个捶门的疯子带来的报价高得多了我都没答应，怎么可能答应你们？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620360
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620360,
					"content": "#（{NICKNAME}，怎么办，我们还要坚持这个数目吗？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620361,
						740620370
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620361,
					"content": "行情在跌，之后只会跌得更厉害。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620362
					]
				},
				{
					"id": 740620362,
					"content": "真的假的？纳库尔不是很想要这个房间吗？他肯定愿意出高价的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620363
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620363,
					"content": "这个嘛…毕竟人的耐心都是有限的！你之前都那么过分地拒绝两次了，说不定他心灰意冷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620364
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620364,
					"content": "这次是一半，说不定下次就…哦！说不定根本没有下次了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620365
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620365,
					"content": "…我考虑一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620366
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620366,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620367
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620367,
					"content": "喂喂，门那头的先生，你考虑好了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620368
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620368,
					"content": "好吧，我认了，那就这个数吧。不过，让你们的委托人亲自来谈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620369
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620369,
					"content": "#好欸！{NICKNAME}，我们回去告诉纳库尔吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620370,
					"content": "（抬到委托人的心理预期价位吧。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620371
					]
				},
				{
					"id": 740620371,
					"content": "嗯…那五万四特许券呢？比两万七整整多出一倍呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620372
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620372,
					"content": "五万四千？和上次捶门的疯子的报价相比…只涨了一成。这也没涨多少嘛，真吝啬啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620373
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620373,
					"content": "而且你们这帮人的开价忽高忽低的…我看肯定是还有上涨空间！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620374
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620374,
					"content": "只要再等等…再等等就会涨上去的。等你们下次，下下次来的时候，一定会带来更高的报价！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620375
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620375,
					"content": "我是不会看错走势的！一定会涨！所以我得忍住！不能这么轻易就同意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620376
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620376,
					"content": "你们走吧。我不会同意的，至少这次不会同意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620377
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620377,
					"content": "#呃…看来他是不会改变心意了。{NICKNAME}，我们回去告诉纳库尔吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620378,
					"content": "（尝试开门。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620379
					]
				},
				{
					"id": 740620379,
					"content": "…喂！你、你想干什么！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620380
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620380,
					"content": "想要开门？这样隔着门说话都看不到对方的表情欸，要谈事情的话，当然还是面对面说话比较好吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620381
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620381,
					"content": "而且梅洛彼得堡的房间不是谁的私有物吧？只是暂住的话，我们应该也能进去才对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620382
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620382,
					"content": "不行！当然不行！你们根本不懂…根本不懂门后隐藏着怎样的黑暗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620383
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620383,
					"content": "呃，我是说，我和人四目相对的话就会紧张得说不出话来。我们还是隔着门交流吧。你们到底有什么事来着？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620384,
						740620449
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620384,
					"content": "我们受人委托有事与你商谈。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620385
					]
				},
				{
					"id": 740620385,
					"content": "嗯，我们受人委托和你商量，不知道你愿不愿意租借这个房间？当然，委托人会支付特许券的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620386
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620386,
					"content": "之前好像也发生过类似的事情…三番两次的，还真是不死心啊。就是那个说话拿腔拿调的家伙派你们来的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620387
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620387,
					"content": "算了，看在他锲而不舍的份上…你们开个价吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620388
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620388,
					"content": "（太好了，看来也不是完全没有沟通的余地嘛。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620389
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620389,
					"content": "（纳库尔已经告诉我们他的心理预期，我们开价的话，要一开始就老实报出底线吗？还是试试压价？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620390,
						740620427
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620390,
					"content": "（诚实报出底线吧。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620391
					]
				},
				{
					"id": 740620391,
					"content": "好喔，那我就实话实说了。委托人的心理预期就是五万四千特许券，我觉得是很划算啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620392
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620392,
					"content": "五万四千？和上次捶门的疯子的报价相比…只涨了一成。这也没涨多少嘛，真吝啬啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620393
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620393,
					"content": "这还少吗？我觉得已经很多了欸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620394
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620394,
					"content": "真没见识啊。你们知道卡兰萨吗？他出手可阔绰多了，他愿意出…出十万八！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620395
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620395,
					"content": "真的吗？这么多？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620396
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620396,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620397
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620397,
					"content": "…当、当然是真的。你看我像会说谎的人吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620398
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620398,
					"content": "隔着门我们根本什么都看不见啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620399
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620399,
					"content": "（听他说话不是很有底气的样子，说不定根本就是他编出来骗我们的。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620400
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620400,
					"content": "#（{NICKNAME}，我们接下来要怎么谈呢？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620401,
						740620411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620401,
					"content": "（诚意就这么多，让他差不多得了。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620402
					]
				},
				{
					"id": 740620402,
					"content": "我们一开始就实话实说了，只有五万四千这么多。十万八也太夸张了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620403,
					"content": "如果你不愿意的话，我们…我们好像也没有别的好办法，只能放弃了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620404,
					"content": "只要再等等…再等等就会涨上去的。等你们下次，下下次来的时候，一定会带来更高的报价！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620405
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620405,
					"content": "我是不会看错走势的！一定会涨！所以我得忍住！不能这么轻易就同意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620406
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620406,
					"content": "你说得这么笃定，是有什么根据吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620407,
					"content": "那当然是经验！前两次的经验告诉我，只要我不打断，上升的趋势就会继续，这不是很简单的道理吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620408
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620408,
					"content": "这是哪门子的道理啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620409,
					"content": "你是小孩子，当然不懂。总之，现在还不是时候，我是不会松口的，你们走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620410
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620410,
					"content": "#呃…看来他是不会改变心意了。{NICKNAME}，我们回去告诉纳库尔吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620411,
					"content": "（既然他想算计我们，那就诈他一诈。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620412
					]
				},
				{
					"id": 740620412,
					"content": "呜呜…没想到有卡兰萨这么强的竞争对手，不管怎么想都比不过嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620413,
					"content": "#{NICKNAME}，我们这就走吧，回去告诉纳库尔，他的出价太低，人家根本看不上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620414,
					"content": "门那头的先生，祝你和卡兰萨聊得开心。我们先告辞了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620415,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620416
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620416,
					"content": "…欸？这就走了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620417
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620417,
					"content": "喂，你们还在吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620418
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620418,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620419
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620419,
					"content": "喂——先别着急走啊——你们回来一下——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620420
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620420,
					"content": "大老远就听到你喊我们，怎么啦，是想要让我们帮你把卡兰萨喊过来吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620421
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620421,
					"content": "那怎么好意思，太麻烦你们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620422
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620422,
					"content": "#不麻烦不麻烦，反正是顺路，对吧，{NICKNAME}？这点小忙只是举手之劳而已！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620423
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620423,
					"content": "咳咳…你这小家伙还挺坏心眼。说正经的，你们刚才的报价还算数吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620424
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620424,
					"content": "现在还算，但过会儿就不知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620425
					]
				},
				{
					"id": 740620425,
					"content": "好吧，我认了，那就这个数吧。不过，让你们的委托人亲自来谈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620426
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620426,
					"content": "#好欸！{NICKNAME}，我们回去告诉纳库尔吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620427,
					"content": "（狠狠地压价！）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620428
					]
				},
				{
					"id": 740620428,
					"content": "那…那就两万七！两万七特许券你看怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620429
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620429,
					"content": "两万七？！开什么玩笑，你们是特意来羞辱我的吗？怎么比之前还少了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620430
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620430,
					"content": "那个捶门的疯子带来的报价高得多了我都没答应，怎么可能答应你们？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620431
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620431,
					"content": "#（{NICKNAME}，怎么办，我们还要坚持这个数目吗？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620432,
						740620441
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620432,
					"content": "行情在跌，之后只会跌得更厉害。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620433
					]
				},
				{
					"id": 740620433,
					"content": "真的假的？纳库尔不是很想要这个房间吗？他肯定愿意出高价的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620434
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620434,
					"content": "这个嘛…毕竟人的耐心都是有限的！你之前都那么过分地拒绝两次了，说不定他心灰意冷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620435
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620435,
					"content": "这次是一半，说不定下次就…哦！说不定根本没有下次了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620436
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620436,
					"content": "…我考虑一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620437
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620437,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620438
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620438,
					"content": "喂喂，门那头的先生，你考虑好了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620439
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620439,
					"content": "好吧，我认了，那就这个数吧。不过，让你们的委托人亲自来谈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620440
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620440,
					"content": "#好欸！{NICKNAME}，我们回去告诉纳库尔吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620441,
					"content": "（那就抬到委托人的心理预期价位吧。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620442
					]
				},
				{
					"id": 740620442,
					"content": "嗯…那五万四特许券呢？比两万七整整多出一倍呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620443
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620443,
					"content": "五万四千？和上次捶门的疯子的报价相比…只涨了一成。这也没涨多少嘛，真吝啬啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620444
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620444,
					"content": "而且你们这帮人的开价忽高忽低的…我看肯定是还有上涨空间！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620445
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620445,
					"content": "只要再等等…再等等就会涨上去的。等你们下次，下下次来的时候，一定会带来更高的报价！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620446
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620446,
					"content": "我是不会看错走势的！一定会涨！所以我得忍住！不能这么轻易就同意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620447
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620447,
					"content": "你们走吧。我不会同意的，至少这次不会同意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620448
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620448,
					"content": "#呃…看来他是不会改变心意了。{NICKNAME}，我们回去告诉纳库尔吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620449,
					"content": "（继续尝试开门。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620450
					]
				},
				{
					"id": 740620450,
					"content": "天哪！你怎么还不停手？我都说了，你们根本不懂门后隐藏着怎样的黑暗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620451
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620451,
					"content": "不面对面交流我怎么知道你是真人？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620452
					]
				},
				{
					"id": 740620452,
					"content": "我当然是真人…而且，就算不是真人又有什么关系？就像我也不知道你们是不是真实存在的，我们不也一样交流。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620453,
						740620455
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620453,
					"content": "我可以捏派蒙的脸，她看起来很真。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620454
					]
				},
				{
					"id": 740620454,
					"content": "好吧，看来你们可以互相证明彼此为真。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620458
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620458,
					"content": "不管怎么说，我是不会开门的，劝你们也不要做这种事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620459
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620459,
					"content": "欸…可是我们受人委托和你商量，希望你能出借这个房间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620460
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620460,
					"content": "那只好请他放弃了。与黑暗为伍的人有我一个就够了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620461
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620461,
					"content": "从刚才开始就在说黑暗黑暗的，到底是说什么东西呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620462
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620462,
					"content": "听你说话的声音像小孩子，小孩子不会懂的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620463
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620463,
					"content": "哼，我觉得根本就是你在故弄玄虚，想糊弄我们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620464
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620464,
					"content": "哈哈，也有这种可能。不过我该说的已经说完了，门是不会打开的，出借房间的请求也是不会答应的。你们请回吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620465
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620465,
					"content": "门后的声音消失了。\\n等待了一阵，又敲了敲门，也没有任何回应。就好像一开始就没有任何人存在。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740620466
					]
				},
				{
					"id": 740620466,
					"content": "欸？他好像真的不理我们了…我们是不是把委托给搞砸了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620467
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620467,
					"content": "唔，不管怎么说，先回去告诉纳库尔吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620455,
					"content": "也许我只是某人梦里的角色。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620456
					]
				},
				{
					"id": 740620456,
					"content": "那会是我的梦吗？我听过你们的声音…我听到你们和一个活泼的小女孩交谈的声音。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620457
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620457,
					"content": "#也有可能是我的梦吧？那样的话…如果醒来之后发现{NICKNAME}还在身边就好了。唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620458
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620306,
					"content": "别问我是谁，也别问我从哪里来。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620307
					]
				},
				{
					"id": 740620307,
					"content": "啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620308
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620308,
					"content": "（你这是干什么呀，这么说只会让问题更复杂吧？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620309,
					"content": "是美露莘。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620310
					]
				},
				{
					"id": 740620310,
					"content": "#{M#就你这嗓音，你是美露莘？我还是膨膨兽呢，少来。}{F#我没病，我好得很，你不要过来。}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620311
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620311,
					"content": "（自称美露莘也太勉强了吧！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620312
					],
					"speakerTitle": "派蒙"
				}
			]
		},
