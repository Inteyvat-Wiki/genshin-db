					}
				]
			},
			"dialogs": [
				{
					"id": 740620101,
					"content": "两位，两位请留步。听说两位是有求必应的闲人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620102,
						740620103
					],
					"speakerTitle": "纳库尔"
				},
				{
					"id": 740620102,
					"content": "确有此事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620105
					]
				},
				{
					"id": 740620105,
					"content": "咳，其实是此前，穿紫裙的女童拜托我多多关照两位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620106
					],
					"speakerTitle": "纳库尔"
				},
				{
					"id": 740620106,
					"content": "我想两位既然有求必应，想必是本领高强，哪里有需要我来关照的道理。不如说，应该是两位多关照关照我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620107
					],
					"speakerTitle": "纳库尔"
				},
				{
					"id": 740620107,
					"content": "关照可以，打折不行。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620108
					]
				},
				{
					"id": 740620108,
					"content": "规矩我懂，这个好说。无论能不能成事，我都会按市场价支付报酬。此处摩拉无用，就以特许券计费。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620109
					],
					"speakerTitle": "纳库尔"
				},
				{
					"id": 740620109,
					"content": "不管结果如何都能拿到报酬？真的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620110,
					"content": "千真万确。事情就是这样难办，也怪尼扎米，拳头厉害，但用错地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620111
					],
					"speakerTitle": "纳库尔"
				},
				{
					"id": 740620111,
					"content": "我还要滞留一阵，想找个合适治学的场所。最好有书架，有桌椅，有可供书写和黏贴资料的板子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620112
					],
					"speakerTitle": "纳库尔"
				},
				{
					"id": 740620112,
					"content": "你应该猜到我心中所想的地方了，但这地方借不得，理由多问无益。我想对面的一间理应构造相同，可堪一用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620113
					],
					"speakerTitle": "纳库尔"
				},
				{
					"id": 740620113,
					"content": "但那间蹊跷得很，似乎是被某人霸占了，且鲜少开门。我从未见过这个某人，也未见过开门的情景。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620114
					],
					"speakerTitle": "纳库尔"
				},
				{
					"id": 740620114,
					"content": "于是我委派尼扎米作为代理，他原本是我雇佣的保镖，一向办事牢靠。可他也与这个某人话不投机，交涉失败。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620115
					],
					"speakerTitle": "纳库尔"
				},
				{
					"id": 740620115,
					"content": "嗯…感觉交涉和谈判应该不是他的长项呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620116,
					"content": "确实。那不是交涉与谈判的场景，他在外面用拳头捶门，从门里传出嚎叫。真叫我大开眼界。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620117,
						740620119
					],
					"speakerTitle": "纳库尔"
				},
				{
					"id": 740620117,
					"content": "哇哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620118
					]
				},
				{
					"id": 740620118,
					"content": "这跟交涉根本就不沾边了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620121,
					"content": "所以想要拜托两位作为代理，与这位某人交涉，让他同意出借他现在占用的空间。我的预期是…五万四千特许券以内。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620122
					],
					"speakerTitle": "纳库尔"
				},
				{
					"id": 740620122,
					"content": "不求成功，但求一试。有劳两位了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "纳库尔"
				},
				{
					"id": 740620119,
					"content": "真不专业啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620120
					]
				},
				{
					"id": 740620120,
					"content": "他本来也不是这方面的专家吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620103,
					"content": "你听谁说的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620104
					]
				},
				{
					"id": 740620104,
					"content": "这个嘛…风言风语，只是风言风语罢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620105
					],
					"speakerTitle": "纳库尔"
				}
			]
		},
