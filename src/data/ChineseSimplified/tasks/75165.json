			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"苏里奎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751650201,
					"content": "路过的勇士，既然会来到特特奥坎，你也是追寻力量的人吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650202
					],
					"speakerTitle": "苏里奎"
				},
				{
					"id": 751650202,
					"content": "或许你已经见过「沃陆之邦」的大力士们了，哼，多数都是些满身肌肉的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650203
					],
					"speakerTitle": "苏里奎"
				},
				{
					"id": 751650203,
					"content": "不过看你身材挺苗条的，应该还没有变成每天疯狂举重卧推的健身狂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650204
					],
					"speakerTitle": "苏里奎"
				},
				{
					"id": 751650204,
					"content": "我跟你说，那些都是骗局，不要上当。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650205,
						751650206
					],
					"speakerTitle": "苏里奎"
				},
				{
					"id": 751650205,
					"content": "你讨厌锻炼吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650207
					]
				},
				{
					"id": 751650207,
					"content": "也不能这么说，但鼓吹肌肉，认为勇士的力量来自于肌肉，这肯定是胡说八道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650208
					],
					"speakerTitle": "苏里奎"
				},
				{
					"id": 751650208,
					"content": "让我告诉你，古代英雄们的身上绝对不可能除了骨头就是肌肉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650209
					],
					"speakerTitle": "苏里奎"
				},
				{
					"id": 751650209,
					"content": "他们的生存环境比今天恶劣得多，在实战中更追求生存与防御，一定会保存适量的脂肪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650210
					],
					"speakerTitle": "苏里奎"
				},
				{
					"id": 751650210,
					"content": "他们的体型，应该就像我这样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650211
					],
					"speakerTitle": "苏里奎"
				},
				{
					"id": 751650211,
					"content": "我这样微胖的体型才是过去英雄们的体型，兼具冲击力与灵活性的体型。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650212
					],
					"speakerTitle": "苏里奎"
				},
				{
					"id": 751650212,
					"content": "但部族的大家都不能认识到这一点，唉，太愚蠢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650213
					],
					"speakerTitle": "苏里奎"
				},
				{
					"id": 751650213,
					"content": "看你的表情，好像不太相信的样子…嗯，这样好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650214
					],
					"speakerTitle": "苏里奎"
				},
				{
					"id": 751650214,
					"content": "来试试看我准备的击罐挑战吧！这片场地原本是我为了锻炼自己准备的，借你用用也没什么问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650215
					],
					"speakerTitle": "苏里奎"
				},
				{
					"id": 751650215,
					"content": "你试一试就知道，大体型在实战中是多么的有力了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "苏里奎"
				},
				{
					"id": 751650206,
					"content": "你讨厌肌肉吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650207
					]
				}
			]
		},
		{
			"id": 7516503,
