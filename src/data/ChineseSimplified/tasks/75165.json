				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751650801,
					"content": "你的成绩很不错嘛，但是呢，说实话…这不是我夸口，我的最佳记录确实在你之上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650802
					],
					"speakerTitle": "伊伊马尼"
				},
				{
					"id": 751650802,
					"content": "人嘛，总会有这么一两项自己做得好的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650803
					],
					"speakerTitle": "伊伊马尼"
				},
				{
					"id": 751650803,
					"content": "这下你相信了吧，我这种体型的战士未必不敏捷，所以饭一定要好好吃，不要胡乱减肥！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊伊马尼"
				}
			]
