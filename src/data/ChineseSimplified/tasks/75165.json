			"dialogs": [
				{
					"id": 751650901,
					"content": "伊伊马尼，你好像又胖了，恭喜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650902
					],
					"speakerTitle": "苏里奎"
				},
				{
					"id": 751650902,
					"content": "哈哈，谢谢你，苏里奎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650903
					],
					"speakerTitle": "伊伊马尼"
				},
				{
					"id": 751650903,
					"content": "好消息，我这些天又劝住了一个想减肥的瘦子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650904
					],
					"speakerTitle": "伊伊马尼"
				},
				{
					"id": 751650904,
					"content": "哦，很了不起啊，大好事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650905
					],
					"speakerTitle": "苏里奎"
				},
				{
					"id": 751650905,
					"content": "欸，是你，怎么样，这几天有好好吃饭吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650906,
						751650908
					],
					"speakerTitle": "苏里奎"
				},
				{
					"id": 751650906,
					"content": "吃饭很香。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650907
					]
				},
				{
					"id": 751650907,
					"content": "很好，就应该多吃饭，吃得胖胖的才对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650910
					],
					"speakerTitle": "伊伊马尼"
				},
				{
					"id": 751650910,
					"content": "伊伊马尼，我跟你说，这人的击罐记录很厉害，离我的最好成绩就差一点点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650911
					],
					"speakerTitle": "苏里奎"
				},
				{
					"id": 751650911,
					"content": "#{M#他}{F#她}也在我这里接受过挑战，成绩也不错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650912
					],
					"speakerTitle": "伊伊马尼"
				},
				{
					"id": 751650912,
					"content": "可以啊，没想到你这么厉害，居然差一点就超过我们两个。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650913
					],
					"speakerTitle": "苏里奎"
				},
				{
					"id": 751650913,
					"content": "#我觉得{M#他}{F#她}再长胖点，说不定真的能超过我们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650914
					],
					"speakerTitle": "伊伊马尼"
				},
				{
					"id": 751650914,
					"content": "嗯，很有可能。虽然从我的角度来看，你有点太苗条了，还有长胖的空间，不过嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650915
					],
					"speakerTitle": "苏里奎"
				},
				{
					"id": 751650915,
					"content": "我认可你了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650916
					],
					"speakerTitle": "苏里奎"
				},
				{
					"id": 751650916,
					"content": "我也认可你了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650917
					],
					"speakerTitle": "伊伊马尼"
				},
				{
					"id": 751650917,
					"content": "但我还是建议你每顿饭最好多吃点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650918
					],
					"speakerTitle": "伊伊马尼"
				},
				{
					"id": 751650918,
					"content": "不要节食，不要减肥，我们会失望的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "苏里奎"
				},
				{
					"id": 751650908,
					"content": "吃得不好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650909
					]
				},
				{
					"id": 751650909,
					"content": "这不好，没有什么事情比好好吃饭更重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650910
					],
					"speakerTitle": "苏里奎"
				}
			]
