			"dialogs": [
				{
					"id": 751650701,
					"content": "哼哼，你的成绩很不错，但比起我来，还差那么一点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650702
					],
					"speakerTitle": "苏里奎"
				},
				{
					"id": 751650702,
					"content": "长期保持微胖体型、但又从来没有疏于训练的我，论灵活性和冲击力，绝对不是那些愚蠢的健身狂能比的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650703
					],
					"speakerTitle": "苏里奎"
				},
				{
					"id": 751650703,
					"content": "放弃对肌肉的追求，和我一起赞美伟大的脂肪吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "苏里奎"
				}
			]
		},
