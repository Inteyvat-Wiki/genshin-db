				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"伊伊马尼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751650401,
					"content": "路过的勇士，对，没错，就是你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650402
					],
					"speakerTitle": "伊伊马尼"
				},
				{
					"id": 751650402,
					"content": "唉，太瘦了…你有好好吃饭吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650406,
						751650404
					],
					"speakerTitle": "伊伊马尼"
				},
				{
					"id": 751650406,
					"content": "饭都被向导派蒙吃了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650403
					]
				},
				{
					"id": 751650403,
					"content": "不论你有什么理由或者苦衷，首先，饭必须好好吃！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650408
					],
					"speakerTitle": "伊伊马尼"
				},
				{
					"id": 751650408,
					"content": "既然你已经进入了特特奥坎，大概已经见过「沃陆之邦」的大力士了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650409
					],
					"speakerTitle": "伊伊马尼"
				},
				{
					"id": 751650409,
					"content": "出于良心，我要给你一个忠告，绝对不要相信那些一个劲鼓吹肌肉的家伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650410
					],
					"speakerTitle": "伊伊马尼"
				},
				{
					"id": 751650410,
					"content": "神赐予我们的脂肪是宝贵的礼物，为了好看的肌肉，就戒掉所有好吃的东西，抛弃脂肪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650411
					],
					"speakerTitle": "伊伊马尼"
				},
				{
					"id": 751650411,
					"content": "这么做就是笨到家了，林猪都会同情你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650412
					],
					"speakerTitle": "伊伊马尼"
				},
				{
					"id": 751650412,
					"content": "而且要说什么是好看，吹捧肌肉好像也就是这几十年的事吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650413
					],
					"speakerTitle": "伊伊马尼"
				},
				{
					"id": 751650413,
					"content": "我爷爷说，他年轻的时候，大家还是比较喜欢微胖的身材。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650414
					],
					"speakerTitle": "伊伊马尼"
				},
				{
					"id": 751650414,
					"content": "所以，千万不要听人蛊惑，走上减肥的错误道路！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650415
					],
					"speakerTitle": "伊伊马尼"
				},
				{
					"id": 751650415,
					"content": "但如果有一天，你跟「沃陆之邦」里我那些亲戚们一样，为了追求力量而选择了减肥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650416
					],
					"speakerTitle": "伊伊马尼"
				},
				{
					"id": 751650416,
					"content": "那我还有一句话：论敏捷，体型微胖的战士也可以做到像鱼一样灵活，论力量，那些瘦家伙根本不是我们的对手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650417
					],
					"speakerTitle": "伊伊马尼"
				},
				{
					"id": 751650417,
					"content": "要问证据的话，这片训练场里的罐子就是证据。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650418
					],
					"speakerTitle": "伊伊马尼"
				},
				{
					"id": 751650418,
					"content": "以我的体型，要做到<color=#00E1FFFF>疾速通过而不打破罐子</color>轻而易举，这种程度的敏捷，就算是瘦子也未必做得到吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650419
					],
					"speakerTitle": "伊伊马尼"
				},
				{
					"id": 751650419,
					"content": "看你那要笑又不好意思笑的表情…没关系没关系，我就知道你不相信。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650420
					],
					"speakerTitle": "伊伊马尼"
				},
				{
					"id": 751650420,
					"content": "来试试吧，以你最快的速度通过这片训练场，但注意<color=#00E1FFFF>不要打破任何罐子</color>！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650421
					],
					"speakerTitle": "伊伊马尼"
				},
				{
					"id": 751650421,
					"content": "看看你的成绩有多好，是否能超过我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊伊马尼"
				},
				{
					"id": 751650404,
					"content": "哇，是要请我吃饭吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650407
					]
				},
				{
					"id": 751650407,
					"content": "倒不是这个意思…要是你肚子实在饿的话，我随身带的包里还有点烤肉。不过这个先放到一边…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650408
					],
					"speakerTitle": "伊伊马尼"
				}
			]
		},
