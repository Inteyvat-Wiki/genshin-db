			"dialogs": [
				{
					"id": 401650101,
					"content": "二位的魔水来啦——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650102
					],
					"speakerTitle": "柑橘"
				},
				{
					"id": 401650102,
					"content": "感谢你，美丽的女士。琴，不坐下来喝一杯吗？我帮你也点了一份。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650103
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 401650103,
					"content": "哎，是不是有些太松懈了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650104
					],
					"speakerTitle": "琴"
				},
				{
					"id": 401650104,
					"content": "在担心小可莉吗？没关系，不是还有阿贝多陪着吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650105
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 401650105,
					"content": "琴团长和凯亚！你们怎么在这里？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401650106,
					"content": "#瞧瞧谁来了？这不是{NICKNAME}和派蒙吗？原来艾莉丝女士说的「惊喜」就是这个！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650107
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 401650107,
					"content": "二位好，没想到能在这里相遇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650108
					],
					"speakerTitle": "琴"
				},
				{
					"id": 401650108,
					"content": "难道这里的人们交口称赞，拯救了世界的勇者就是你们二位？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650109
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 401650109,
					"content": "也不全是我们的功劳啦，要说的话，我们只是勇者小队的一员。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401650110,
					"content": "那也很了不起嘛！果然真正优秀的骑士到哪里都不失「荣誉」之名。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650111
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 401650111,
					"content": "刚才说到艾莉丝女士和可莉…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401650112
					]
				},
				{
					"id": 401650112,
					"content": "嗯，我们收到一封艾莉丝女士寄来的邀请函，她建议我们在空闲的时候，带可莉来童话世界度个假。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650113
					],
					"speakerTitle": "琴"
				},
				{
					"id": 401650113,
					"content": "原本还不知道她指的「童话世界」是什么意思呢，但现在看来，还真是个恰如其分的比喻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650114
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 401650114,
					"content": "可莉刚进来就激动得到处跑，我有些担心，但阿贝多说他会照顾好可莉，让我们自由活动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650115
					],
					"speakerTitle": "琴"
				},
				{
					"id": 401650115,
					"content": "此等美意，我们怎么好意思拒绝呢？于是我就拉上琴，到这个世界的酒馆来坐坐啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650116
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 401650116,
					"content": "我看你就是想趁机喝酒而已吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401650117,
					"content": "哈哈，都出来休假了，就该好好享受一下嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650118
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 401650118,
					"content": "…你说得对，我也该松松自己的弦。不然就辜负了艾莉丝女士的一番美意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650119
					],
					"speakerTitle": "琴"
				},
				{
					"id": 401650119,
					"content": "哎！等等…你和酒保是怎么说的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401650120,
					"content": "当然是来一杯这个酒馆最纯正的饮品喽，这才能感受到不同世界的风土人情嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650121
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 401650121,
					"content": "噗嗤…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401650122,
					"content": "欸？派蒙你这是什么表情？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650123
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 401650123,
					"content": "没…没什么，我很欣赏你的生活方式，你喝，你快喝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401650124,
					"content": "嗯？那我是不是应该小心一下呢？这酒看起来色泽倒挺不错，味道…噗咳…咳咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650125
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 401650125,
					"content": "嘻嘻嘻嘻…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401650126,
					"content": "…我那杯就不喝了吧。但不喝会不会有些浪费…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650127
					],
					"speakerTitle": "琴"
				},
				{
					"id": 401650127,
					"content": "好啊，派蒙，原来是这么回事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650128
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 401650128,
					"content": "我…我也是上过一次当的！不是在针对你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401650129,
					"content": "对了，接到邀请的也不止我们，刚才我还见到了柯莱呢。她往那棵大树的方向去了，我没来得及叫她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650130
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 401650130,
					"content": "是铃风王国那边吧？嘿嘿，这么多老朋友都来了，感觉就像聚会一样呢。我们去和她打个招呼吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401650131,
					"content": "嗯，也代我向她问个好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650132,
						401650133
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 401650132,
					"content": "没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401650134
					]
				},
				{
					"id": 401650134,
					"content": "也祝你旅途愉快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "琴"
				},
				{
					"id": 401650133,
					"content": "祝二位休假愉快。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401650134
					]
				}
			]
		},
