			"dialogs": [
				{
					"id": 401650201,
					"content": "原来魔水就是墨水…真是神奇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650202
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 401650202,
					"content": "柑橘女士，请问有没有不加魔水的饮品？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650203
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 401650203,
					"content": "当然有，要什么口味？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650204
					],
					"speakerTitle": "柑橘"
				},
				{
					"id": 401650204,
					"content": "日落果？琴，你感兴趣吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650205
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 401650205,
					"content": "…好，那我也要一杯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650206
					],
					"speakerTitle": "琴"
				},
				{
					"id": 401650206,
					"content": "好嘞，两杯日落果口味！马上就来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柑橘"
				}
			]
		},
