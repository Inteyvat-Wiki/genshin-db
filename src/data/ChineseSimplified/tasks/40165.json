				{
					"id": 401650401,
					"content": "折纸飞鼠们凭借轻盈的身体，能够利用风场在树木间移动…由此形成了独特的生态…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650402
					],
					"speakerTitle": "柯莱"
				},
				{
