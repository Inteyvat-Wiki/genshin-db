			"dialogs": [
				{
					"id": 401650701,
					"content": "奥兹华尔多·赫芙那梵茵斯…告诉我，此刻映照于我览遍三千世界断罪之眼中的景象绝非虚妄！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650702
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 401650702,
					"content": "小姐，你没看错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650703
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 401650703,
					"content": "那我将以幽夜净土的王室之礼向二位行以问候。千星之国的至高夜龙，以及他身侧冠帽的扈从。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650704
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 401650704,
					"content": "你说谁是扈从？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650705
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 401650705,
					"content": "小姐的意思是，二位好，很高兴认识你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650706
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 401650706,
					"content": "你们好！我也很高兴认识你们，但阿帽是我的朋友，不是扈从。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650707
					],
					"speakerTitle": "小杜林"
				},
				{
					"id": 401650707,
					"content": "…啧，没必要解释。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650708
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 401650708,
					"content": "阿帽！小杜林！终于找到你们了！哇，还有菲谢尔你们也在？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650709
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401650709,
					"content": "哦呵呵！受幽夜净土祝圣的异世旅人！汝于此星空下与本皇女相遇一定也是命运的选择！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650710,
						401650711
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 401650710,
					"content": "诚如皇女所言。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401650712
					]
				},
				{
					"id": 401650712,
					"content": "#荣誉骑士{M#哥哥}{F#姐姐}和小派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650713
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401650713,
					"content": "二位别来无恙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650714
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 401650714,
					"content": "嘿嘿，小可莉在这里玩得还开心吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650715
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401650715,
					"content": "开心！有好多好多可爱的小动物！好长好长的魔法小火车！还有好高好高的国王大城堡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650716
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401650716,
					"content": "我带可莉走过一圈，沿路收获不少，不愧是艾莉丝女士的魔法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650717
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 401650717,
					"content": "妈妈好厉害！可莉也想造大大的房子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650718
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401650718,
					"content": "可莉的妈妈，是我妈妈的朋友？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650719
					],
					"speakerTitle": "小杜林"
				},
				{
					"id": 401650719,
					"content": "嗯！妈妈以前经常念故事给我听，小杜林哥哥的妈妈写故事真好看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650720
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401650720,
					"content": "小杜林…哥哥？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650721
					],
					"speakerTitle": "小杜林"
				},
				{
					"id": 401650721,
					"content": "当哥哥了呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401650722
					]
				},
				{
					"id": 401650722,
					"content": "哇…谢谢可莉！阿帽，我能和可莉一起去玩吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650723
					],
					"speakerTitle": "小杜林"
				},
				{
					"id": 401650723,
					"content": "随你便。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650724
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 401650724,
					"content": "阿贝多哥哥，阿贝多哥哥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650725
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401650725,
					"content": "去吧，别跑太远，我会来接你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650726
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 401650726,
					"content": "嗯！我们走吧，小杜林！菲谢尔姐姐也来吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650727
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401650727,
					"content": "哼哼！本皇女接受你们的邀请。庆贺吧！即使你们藏身于迷雾之中，也将有幸一睹此断罪之眼的威姿！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650728
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 401650728,
					"content": "小姐说，大家可以一起玩捉迷藏，她来当鬼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650729
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 401650729,
					"content": "好耶！捉迷藏！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650730
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401650730,
					"content": "捉迷藏！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650731
					],
					"speakerTitle": "小杜林"
				},
				{
					"id": 401650731,
					"content": "说回刚才的话题，阿帽先生，你所说的预言一事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650732
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 401650732,
					"content": "我当时听到「B」对「M」这么说——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650733
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 401650733,
					"content": "看在你这么执着的份上，我就告诉你一个秘密吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650734
					],
					"speakerTitle": "魔女B"
				},
				{
					"id": 401650734,
					"content": "「R」的孩子，有朝一日会复活哟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650735
					],
					"speakerTitle": "魔女B"
				},
				{
					"id": 401650735,
					"content": "欸？那位观星的魔女说…龙脊雪山的杜林…会复活？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650736
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401650736,
					"content": "我也很惊讶…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401650737
					]
				},
				{
					"id": 401650737,
					"content": "都是记忆中的景象，错了也别赖到我头上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650738
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 401650738,
					"content": "我明白了。我最近在龙脊雪山的观察结果也佐证了这个预言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650739
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 401650739,
					"content": "相较以往，杜林的心脏正在慢慢活跃起来。虽然过程十分缓慢，但已显出趋势…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650740
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 401650740,
					"content": "唔…那我们该怎么做？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650741
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401650741,
					"content": "先制定应对各种情况的策略，当然也包括最坏的情况…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650742
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 401650742,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650743
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 401650743,
					"content": "我了解杜林的过去，并不希望事态发展到那一步。但凡事都需做好充足的准备。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650744
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 401650744,
					"content": "如果正如预言所说，杜林的心脏终将跳动如常，我会希望复活的并非「邪龙」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650745
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 401650745,
					"content": "你们能明白我的意思吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650746
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 401650746,
					"content": "隐隐约约…马马虎虎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650747
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401650747,
					"content": "为此…阿帽先生，届时能请你和希穆兰卡的杜林也助我们一臂之力吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650748
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 401650748,
					"content": "啊？还有我的事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650749
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 401650749,
					"content": "你在希穆兰卡的世界拯救了杜林，我认为这不是偶然。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650750
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 401650750,
					"content": "如果三位女神的此中作为存在意义，除去浪漫的解读之外，我可以做出大胆猜测…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650751
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 401650751,
					"content": "此片映射之天的命运，或许也能对彼处产生影响。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650752
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 401650752,
					"content": "如果龙脊雪山的杜林将要复活，我们会需要小杜林…以及与其命运交错的你的帮助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650753
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 401650753,
					"content": "啧…麻烦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650754
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 401650754,
					"content": "的确不会容易。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650755
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 401650755,
					"content": "阿贝多哥哥！那边有一个小纸船欸！能飘在空中的那种！要和可莉一起去看吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650756
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401650756,
					"content": "好，我这就来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650757
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 401650757,
					"content": "请再考虑一下我的建议，阿帽先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650758
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 401650758,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650759
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 401650759,
					"content": "阿帽，我回来了。嗯？你们刚才聊什么了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650760
					],
					"speakerTitle": "小杜林"
				},
				{
					"id": 401650760,
					"content": "没什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650761
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 401650761,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650762
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401650762,
					"content": "嗯？那我们也一起过去吧，大家都在我们新做的小船那里呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650763
					],
					"speakerTitle": "小杜林"
				},
				{
					"id": 401650763,
					"content": "…好，我这就来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650764,
						401650765
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 401650764,
					"content": "#{REALNAME[ID(1)]}…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401650766
					]
				},
				{
					"id": 401650766,
					"content": "干嘛？我像是那种会在乎别人破事的人吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650767
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 401650767,
					"content": "（拯救了希穆兰卡的杜林之后，他会不会同情起现实中的杜林呢…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401650768
					]
				},
				{
					"id": 401650768,
					"content": "别在这乱猜我的想法，走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650769
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 401650769,
					"content": "（就像阿贝多说的，留给以后再考虑吧…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401650770
					]
				},
				{
					"id": 401650770,
					"content": "哇！好可爱的小船！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650771
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401650771,
					"content": "是我们和森林仙子一起做的哟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650772
					],
					"speakerTitle": "小杜林"
				},
				{
					"id": 401650772,
					"content": "说起来，破碎之海的人似乎少了很多，看来大家都顺利回到王城了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650773
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401650773,
					"content": "这艘船有名字吗？可莉在哪里都没有找到！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650774
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401650774,
					"content": "欸？名字…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650775
					],
					"speakerTitle": "小杜林"
				},
				{
					"id": 401650775,
					"content": "嗯！可莉见到过的船都有自己的名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650776
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401650776,
					"content": "为了寄托美好的寓意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650777
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 401650777,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650778
					],
					"speakerTitle": "小杜林"
				},
				{
					"id": 401650778,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650779
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 401650779,
					"content": "就叫「杜林号」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650780
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 401650780,
					"content": "欸？我的名字？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650781
					],
					"speakerTitle": "小杜林"
				},
				{
					"id": 401650781,
					"content": "哦！是寓意小杜林的故事，能够驶向这个世界之外的新篇章吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650782
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401650782,
					"content": "嗯，以无上之夜龙尊贵的名字来命名，本皇女欣赏你的品味。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650783
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 401650783,
					"content": "「杜林号」…嘿嘿，那就叫这个吧！谢谢你，阿帽！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650784
					],
					"speakerTitle": "小杜林"
				},
				{
					"id": 401650784,
					"content": "那个…阿帽，能求你一件事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650785
					],
					"speakerTitle": "小杜林"
				},
				{
					"id": 401650785,
					"content": "…说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650786
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 401650786,
					"content": "之前妈妈的朋友不是说我能出去吗？我…我想去阿帽你生活的世界看看，看一下就回来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650787
					],
					"speakerTitle": "小杜林"
				},
				{
					"id": 401650787,
					"content": "…哈？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650788
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 401650788,
					"content": "不…不行吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650789
					],
					"speakerTitle": "小杜林"
				},
				{
					"id": 401650789,
					"content": "这不是挺好吗？希穆兰卡的人本来就可以出去，带小杜林出去转转也没什么吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650790
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401650790,
					"content": "…我还得在外面保护你的安全？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650791
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 401650791,
					"content": "我…我会保护好自己的，也会听你话，绝不乱飞！可以吗…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650792
					],
					"speakerTitle": "小杜林"
				},
				{
					"id": 401650792,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650793
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 401650793,
					"content": "…在外面我可不管你，自己跟紧了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650794
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 401650794,
					"content": "好！我知道了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650795
					],
					"speakerTitle": "小杜林"
				},
				{
					"id": 401650795,
					"content": "不如就乘「杜林号」出去吧，以命名后的初次航行开启新的旅程。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650796
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 401650796,
					"content": "小杜林哥哥现在就要走了吗？那…记得要来蒙德找可莉玩！可莉把来家里的路画给你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650797
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401650797,
					"content": "相处之刻虽如长夜虹光一般短暂，但幽夜净土将为重逢之刻高奏乐歌，我等定将于星辰的注视之下再会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650798
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 401650798,
					"content": "小姐说，她也随时欢迎你们到家里坐坐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650799
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 401650799,
					"content": "嗯！认识了这么多新朋友，我很开心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650800
					],
					"speakerTitle": "小杜林"
				},
				{
					"id": 401650800,
					"content": "啧…还有完没完？要走的话就赶紧上来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650801
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 401650801,
					"content": "一路顺风。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401650802
					]
				},
				{
					"id": 401650802,
					"content": "谢谢大家，谢谢你们所有人！你们给予我的祝福，比任何东西都要宝贵，比任何童话都要美丽！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650803
					],
					"speakerTitle": "小杜林"
				},
				{
					"id": 401650803,
					"content": "下次，就换我来实现你们的愿望吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小杜林"
				},
				{
					"id": 401650765,
					"content": "你在担心杜林吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401650766
					]
				},
				{
					"id": 401650711,
					"content": "我也很高兴见到你们。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401650712
					]
				}
			]
		}
	]
}