			},
			"dialogs": [
				{
					"id": 401650501,
					"content": "啊？我看错了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650502
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 401650502,
					"content": "怎么可能…真是难以置信…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650503
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 401650503,
					"content": "莫娜，你好呀！好远就听到你一个人嘀嘀咕咕的声音。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401650504,
					"content": "你的水占盘又出问题了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401650505,
					"content": "是你们啊，拯救了世界的英雄。我的水占盘好得很，出问题的可能是我的眼睛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650506
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 401650506,
					"content": "你们看，看这个女神像。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650507
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 401650507,
					"content": "怎么了吗？没见到哪里缺了个角呀？不就是「预言女神」，你的师父嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401650508,
					"content": "我才不信呢！那个老太婆哪长这个样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650509
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 401650509,
					"content": "说不定是年轻的时候？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401650510
					]
				},
				{
					"id": 401650510,
					"content": "年轻的时候…呃…这么说来，倒的确挺像她那本少女日记里写的爱赶时髦的样子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650511
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 401650511,
					"content": "这话不会被老太婆听见吧？总觉得背后阴嗖嗖的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650512
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 401650512,
					"content": "这么在人家雕像底下议论好像是不太好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650513
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401650513,
					"content": "不过，既然莫娜都没见过你师父年轻时的样子，你先前是怎么知道这雕像是她的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650514
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401650514,
					"content": "我进来时用水占盘算了算，结果星空的「倒影」却令我大为惊讶，像是将提瓦特作为了这个「希穆兰卡」世界命运的基底。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650515
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 401650515,
					"content": "现实命运的「映射」，真实世界的「虚像」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650516
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 401650516,
					"content": "嗯…通俗点说，你就理解成「创造者」是在一面镜子，或者一汪湖水的倒影中创造了这个世界。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650517
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 401650517,
					"content": "听着还是很了不起的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650518
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401650518,
					"content": "继续观测下去，那些占式就越来越熟悉，一看就是老太婆的手笔…但它们远比想象的复杂，现在的我光是解读就已经很费力了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650519
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 401650519,
					"content": "后来我就去找人打听了一下。「司掌星辰与轨迹」，她还真是演都不演，彻底陶醉在她的创作里了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650520
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 401650520,
					"content": "跟那本日记的风格倒也对得上…咳咳，不对！我们还是换个话题吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650521
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 401650521,
					"content": "啊，莫娜！你见到过一只小龙吗？差不多和我一样大，扇着小小的翅膀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650522
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401650522,
					"content": "曾经闯祸的那位是吧？我没亲眼见到，但听说他不久前来王城向人们道歉，还带了很多积木矿和植物油作为赔礼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650523
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 401650523,
					"content": "大多数人接受了他的赔罪，但也有些人说，要看他未来的行为再做判断。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650524
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 401650524,
					"content": "这样啊。那你知道要去哪儿找他吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650525
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401650525,
					"content": "稍等…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650526
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 401650526,
					"content": "哦，他现在在破碎之海那边，身边还有不少人在呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650527
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 401650527,
					"content": "那莫娜要一起来吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650528
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401650528,
					"content": "我就不凑热闹了吧，难得可以跟年轻的老太婆待一会儿，琢磨琢磨她布下的星轨。你们好好玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650529,
						401650531
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 401650529,
					"content": "那莫娜多加小心…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401650530
					]
				},
				{
					"id": 401650530,
					"content": "为什么是小心啦？这么说才会让人紧张吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650533
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 401650533,
					"content": "我们走啦！拜拜哦莫娜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401650531,
					"content": "谢谢莫娜的占星术…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401650532
					]
				},
				{
					"id": 401650532,
					"content": "哪里的话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650533
					],
					"speakerTitle": "莫娜"
				}
			]
		},
