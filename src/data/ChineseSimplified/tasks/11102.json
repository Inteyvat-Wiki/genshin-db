			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"魈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111020201,
					"content": "是你们…我还记得你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020202
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020202,
					"content": "我正在这一带清理沾染了「妖邪」的生物，看来，是妨碍到你们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020203
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020203,
					"content": "（咦，他的语气是不是有点太客气了…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111020204,
					"content": "你在这里降妖除魔，怎么能说是妨碍我们呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111020205,
					"content": "因为这些魔物的异变，也是由我而起——是沾染我的「业障」所致。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020206
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020206,
					"content": "异变、业障…啊，难道…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020207,
						111020208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111020207,
					"content": "在《护法仙众夜叉录》里提到过…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111020209
					]
				},
				{
					"id": 111020209,
					"content": "是呀，我好像还记得魈有着「护法夜叉」的称呼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111020210,
					"content": "原来是这样…呜、呜呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111020211,
					"content": "魈真是太可怜了哇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111020212,
					"content": "……？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020213,
						111020214
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020213,
					"content": "我们刚从书中了解了你的过去…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111020215
					]
				},
				{
					"id": 111020215,
					"content": "哦，是几百年前那些墨客，无意义的闲言碎语么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020216
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020216,
					"content": "诸行无常，一切皆苦。夜叉的意志，从不与同情和泪水为伴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020217
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020217,
					"content": "我那些已故的同僚，也不会喜欢后人如此评判。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020218
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020218,
					"content": "唔，唔…真是不好意思…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111020219,
					"content": "无妨。我正要去清剿一处妖邪气息浓厚的洞天，先就此别过了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020220
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020220,
					"content": "带、带上我们一起去吧，我们一定可以帮上忙的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111020221,
					"content": "不必，我习惯独来独往，更何况这些异变也是以我为源头…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020222
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020222,
					"content": "就当为我刚才的不礼貌赔罪！…可以吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111020223,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020224
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020224,
					"content": "…跟上来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "魈"
				},
				{
					"id": 111020214,
					"content": "我们刚读过《护法仙众夜叉录》。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111020215
					]
				},
				{
					"id": 111020208,
					"content": "魈就是「最后一位夜叉」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111020209
					]
				}
			]
		},
		{
			"id": 1110204,
			"completionStepIds": [
				1110204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1110204",
							"2"
						],
						"stepId": 1110204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111020401,
					"content": "这里邪恶的气息让人汗毛直立呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111020402,
					"content": "我会用「靖妖傩舞」之仪，断除此地的「业障」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020403
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020403,
					"content": "你们要尽量平心静气，当心不要被魔神邪念所扰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "魈"
				}
			]
		},
		{
			"id": 1110206,
			"completionStepIds": [
				1110205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1110205",
							"2"
						],
						"stepId": 1110205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111020601,
					"content": "沾染「妖邪」的生物如此之多，实属异常…若不是早来清剿，后果不堪设想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020602
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020602,
					"content": "方才你们提到的「掇星攫辰天君」，是怎么回事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020603
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020603,
					"content": "我来说给你听！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111020604,
					"content": "那些人…居然会被「实现愿望的仙人」这般诳语所骗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020605
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020605,
					"content": "那么作为仙人的魈，会有实现愿望的能力吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111020606,
					"content": "曾经的璃月，可不会对我们提出这种不劳而获的要求。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020607
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020607,
					"content": "数千年前璃月先民需要的，是可以守护这片栖身之地的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020608
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020608,
					"content": "可是对这个时代的人们来说，确实是实现愿望的仙人更有吸引力吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020609
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111020609,
					"content": "但，不论这个时代有多软弱，都与我无关。我只会尊奉帝君最初的意旨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020610
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020610,
					"content": "派蒙好像又说错话啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020611
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111020611,
					"content": "啊…啊对了！那个假仙人身上可是带着「百无禁忌箓」的，还用那个来驱魔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020612
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111020612,
					"content": "有这种事？哼…蠢材。驱魔而不除魔，怪不得妖异都来此聚集。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020613
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020613,
					"content": "如此下去，恐怕会超出我掌控的范畴…必须从他手中回收「百无禁忌箓」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020614,
						111020615
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020614,
					"content": "只「回收」还不够吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111020616
					]
				},
				{
					"id": 111020616,
					"content": "不愧是我的好伙伴！派蒙也是这么想的，一定要好好教训那个骗了我们的家伙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020617
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111020617,
					"content": "正巧我们这里有位真正的仙人…如果魈出手的话，他一定再也不敢假冒仙人之名！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020618
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111020618,
					"content": "不行。我只斩妖魔，不杀凡人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020619
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020619,
					"content": "没有叫你杀他啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020620
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111020620,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020621
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020621,
					"content": "若是能令他不再作奸为恶，确实对璃月有益。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020622
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020622,
					"content": "我有一法，曰「梦游诸境法」，本应用于睡梦之中，使魂魄离体修行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020623
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020623,
					"content": "但也可动用此法，招来他人魂魄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020624
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020624,
					"content": "哇，是真正的仙法！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020625,
						111020626
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111020625,
					"content": "类似于「托梦」吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111020627
					]
				},
				{
					"id": 111020627,
					"content": "此法需准备一番仪式。你们要去帮忙找来…一座香炉、七盏灯，还有一些能够降温之物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020628
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020628,
					"content": "降温之物…冰雾花应该就可以？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020629
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111020629,
					"content": "可是香炉和七盏灯，好像不是随地就能捡到的东西吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020630
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111020630,
					"content": "你们知道天衡山南部的商道旁，有两尊「夜叉石像」么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020631
					],
