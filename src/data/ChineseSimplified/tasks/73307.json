			},
			"dialogs": [
				{
					"id": 733070201,
					"content": "是斯露莎和她的「谒颂主」…嚯呀，连派蒙也在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070202
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 733070202,
					"content": "喂，我怎么就是「连」和「也」啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733070203,
					"content": "这个先不提，看你们的样子是发现了什么有趣的事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070204
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 733070204,
					"content": "也不算是有趣的事啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733070205,
					"content": "向祖尔宛转述了「灵谷木」的事情…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						733070206
					]
				},
				{
					"id": 733070206,
					"content": "嗯…该从哪说起呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070207
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 733070207,
					"content": "你们遇到的确实是花灵所化的「灵谷木」没错，不过寄宿在其中的，与其说是残存的魂灵，不如说是记忆的破片才对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070208
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 733070208,
					"content": "就像你们拿到的那个「净光翎」，其中可就蕴藏着未能回归大地的记忆呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070209,
						733070210,
						733070213
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 733070209,
					"content": "未能回归大地…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733070217
					]
				},
				{
					"id": 733070217,
					"content": "我们花灵从花海的甘露中诞生，最终也会回归到花海当中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070218
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 733070218,
					"content": "与镇护此处的神明一样，我们是被流淌在大地中的时轮之流所拒绝的种类。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070219
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 733070219,
					"content": "当然这也是我们的衷心所愿，不使漆黑之物同我们一起流入大地是我们的使命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070220
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 733070220,
					"content": "只要使「灵谷木」结出「净光翎」，那些流散在外的花灵便能重回花海的怀抱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070221
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 733070221,
					"content": "将「净光翎」供奉到「甘露池」中，那些污秽也能被洗净。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070222
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 733070222,
					"content": "哦哦，看来我们还真是做了件好事呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733070223,
					"content": "哼，白飘飘一副了不起的样子，其实还不是靠了我的伟力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070224
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733070224,
					"content": "嗯嗯，斯露莎也很厉害啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733070225,
					"content": "这还差不多…不对，我可不需要白飘飘的夸赞，我只要有「谒颂主」就够了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070226
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733070226,
					"content": "说到「谒颂主」，既然你也算是接受了这一名号，那倒还真是完成这一仪式的不二人选了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070227
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 733070227,
					"content": "在古时，与花灵同行的人类勇士，会为流散在沙漠中的花灵举行净罪的仪式，将她们带回花海。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070228
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 733070228,
					"content": "而这些与花灵建立起了特殊连结的人，便被称为「谒颂主」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070229
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 733070229,
					"content": "这跟斯露莎说的可完全不一样！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070230
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733070230,
					"content": "哎呀哎呀，这样也算是歪打正着了。作为「谒颂主」，你们可肩负着救助失落花灵的责任呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070231
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 733070231,
					"content": "若是再遇到那样的「灵谷木」，便拜托将其结出的「净光翎」带回花海来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070232
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 733070232,
					"content": "就算你不这样说，我们也是会帮助那些花灵的啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733070210,
					"content": "供奉到「甘露池」的也是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733070211
					]
				},
				{
					"id": 733070211,
					"content": "「净光翎」是神鸟「西摩格」的灵光所化，而我们花灵最初也是因着灵光与甘露的结合而诞生的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070212
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 733070212,
					"content": "也正因此我们才被称为灵光的后嗣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070217
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 733070213,
					"content": "听起来有些熟悉…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733070214
					]
				},
				{
					"id": 733070214,
					"content": "对哦，之前在森林得到的「惟耶之实」，就是兰那罗用记忆结出来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733070215,
					"content": "兰那罗…你们知道那些无忧无虑的生灵吗？那样解释起来就方便多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070216
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 733070216,
					"content": "不过与兰那罗不同，他们是从大地中生长出来的种类。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070217
					],
					"speakerTitle": "祖尔宛"
				}
			]
		},
