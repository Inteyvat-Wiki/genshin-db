			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"祖尔宛",
					"斯露莎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733070401,
					"content": "嗯，流散在大地上的花灵，似乎都已经回到花海来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070402
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 733070402,
					"content": "真是辛苦你们了，不愧是被斯露莎选定的「谒颂主」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070403
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 733070403,
					"content": "前辈这话我就当是夸我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070404
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733070404,
					"content": "嘿嘿，花海看起来也热闹了很多的样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733070405,
					"content": "接下来只要再解决掉那个大窟窿，这里就能恢复生机了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733070406,
					"content": "不过说起来还真是神奇，既然花灵本来都是从水里面诞生的，那样的话不是应该叫「水灵」才对吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733070407,
					"content": "白飘飘怎么还乱给我们起名字的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070408
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733070408,
					"content": "呵呵，不过说到「水灵」，我倒是想起了些过去的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070409,
						733070410
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 733070409,
					"content": "关于「水灵」的事情吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733070411
					]
				},
				{
					"id": 733070411,
					"content": "很久很久以前，曾有许多来自异乡的纯水之灵穿越重重阻隔来到这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070412
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 733070412,
					"content": "那时花海外除了黄沙之外，尚有不少魔物肆虐。对于这些水之亲眷而言，这番旅途想必也很辛苦吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070413
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 733070413,
					"content": "虽然她们似乎是为了那位已殁之神而来，但结果却并没有在这里找到她们想要的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070414
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 733070414,
					"content": "在看到万种母树的模样后，她们很快便四散离开了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070415
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 733070415,
					"content": "后来，纯水之灵的传说流传开来，又有很多异国之人，沿着她们所走过的道路行进，试图寻找她们的秘密。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070416
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 733070416,
					"content": "虽说最初不过是以讹传讹，不过久而久之，这条道路本身也被赋予了舍弃自我，寻找纯真之类的意义。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070417
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 733070417,
					"content": "即便后来花海不再对外开放，他们的朝圣之旅也持续了相当长的一段时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070418
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 733070418,
					"content": "或许对于他们而言，比起到达终点，旅途的过程可能更有意义吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070419
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 733070419,
					"content": "就像是比起一劳永逸的牺牲，为了使命而努力的过程才更有意义一样呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070420
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 733070420,
					"content": "怎么说到最后，结果又落到我头上了啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733070410,
					"content": "希望不会太长…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733070411
					]
				}
			]
		},
