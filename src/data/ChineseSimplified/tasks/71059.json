			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710590201,
					"content": "「…倒霉，卡佳老姐的巴拉莱卡琴坏掉了。行动事出紧急，不知道是怎么弄坏的，一定要抢在挨骂前修好…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590202
					],
					"speakerTitle": "尼古拉下士的日志残片"
				},
				{
					"id": 710590202,
					"content": "「…五百年前的祖先们就是这样对抗灾变的吗？大尉说，我们经历的苦战相比祖先而言，不过只是零头而已…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590203
					],
					"speakerTitle": "尼古拉下士的日志残片"
				},
				{
					"id": 710590203,
					"content": "（中间许多页被黑色的物质浸染，清除掉黑色物质后，墨水写下的字迹也被完全毁掉了。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590204
					],
					"speakerTitle": "尼古拉下士的日志残片"
				},
				{
					"id": 710590204,
					"content": "「…这里不能待下去了，那些家伙可以透过黑色的泥状物窥视我的行踪…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590205
					],
					"speakerTitle": "尼古拉下士的日志残片"
				},
				{
					"id": 710590205,
					"content": "「…接下来要继续往反方向前进，把它们再度引向远离小队主力的地方…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590206
					],
					"speakerTitle": "尼古拉下士的日志残片"
				},
				{
					"id": 710590206,
					"content": "「…东南方的堡垒遗迹旁边有一处洞口，或许可以走那条路…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590207
					],
					"speakerTitle": "尼古拉下士的日志残片"
				},
				{
					"id": 710590207,
					"content": "「…祝我好运吧，舍我其谁！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "尼古拉下士的日志残片"
				}
			]
		},
