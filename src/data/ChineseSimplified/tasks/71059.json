			"dialogs": [
				{
					"id": 710590301,
					"content": "你们回来了，我还有些火水可以分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590302
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710590302,
					"content": "哈哈…没有要你们陪我喝酒啦，如果你们受伤的话，火水也可以用来清洁伤口的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590303
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710590303,
					"content": "怎么样？有何收获？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590304
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710590304,
					"content": "我们找到了这些。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
