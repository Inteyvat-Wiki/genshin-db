			},
			"dialogs": [
				{
					"id": 710590401,
					"content": "你回来了。请问有什么发现吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590402
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710590402,
					"content": "没有的话也没关系的，请随便休息一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590403
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710590403,
					"content": "不用在乎我是否着急啦…反正我也有留在这里养老的计划，说不定还要拜托你替我申领退休金呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590404
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710590404,
					"content": "哇，你这家伙倒是悠闲！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710590405,
					"content": "哼，你们再没什么新发现的话，我可要在这里悠闲到老咯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡塔琳娜"
				}
			]
		},
		{
			"id": 7105906,
			"completionStepIds": [
				7105907
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105907",
							"2"
						],
						"stepId": 7105907,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710590603,
					"content": "咦…这个徽记…就是那个愚人众家伙留下的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590601
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710590601,
					"content": "唔…连个人影都没有，这下我们要怎么回去交差呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710590602,
					"content": "嗯，也没有别的办法啦，我们回去吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7105913,
			"completionStepIds": [
				7105909
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105909",
							"2"
						],
						"stepId": 7105909,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"卡塔琳娜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710591305,
					"content": "这些是…士官徽章，行动日志和…笔记？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591306
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591306,
					"content": "请告诉我，科利亚他人在哪里？他还活着吗…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591307,
						710591308
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591307,
					"content": "我们没有找到他，但他可能还活着。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591309
					]
				},
				{
					"id": 710591309,
					"content": "科利亚不可能丢下我去做逃兵的。你们…你们可以放心，我明白的，他是不会临阵脱逃的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591310
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591310,
					"content": "这些东西，你们是在哪里发现的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591311
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591311,
					"content": "东南方一处山洞，我为你标出来。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591312
					]
				},
				{
					"id": 710591312,
					"content": "是一个很邪门的地方，有很多奇怪的怪物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710591313,
					"content": "谢谢…谢谢你，我…抱歉……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591314
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591314,
					"content": "我…我希望科利亚牺牲了，我宁愿这样相信。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591315
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591315,
					"content": "科利亚，请不要让女皇陛下蒙羞，不要让我蒙羞……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591316
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591316,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591317
					]
				},
				{
					"id": 710591317,
					"content": "咳，咳…我没事的…抱歉，抱歉！把气氛搞得这么僵…才想起来，还没来得及好好感谢你们呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591318
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591318,
					"content": "对了，火水…啊，唉…你们不喝酒的，是吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591319
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591319,
					"content": "我还有些摩拉…还有就是…之前收集的一些物资，反正已经没有什么用了，请你收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591320,
						710591321
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591320,
					"content": "接下来有何打算？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591322
					]
				},
				{
					"id": 710591322,
					"content": "接下来吗？谢谢关心，不过我不需要再拜托你帮忙「做坏事」啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591323
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591323,
					"content": "嗯…也许我还是会去找我的科利亚吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591324
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591324,
					"content": "部队调防之前他寄给我的信，我还留在身上…对于我来说，这是他还在这世上的最后证据了…我会永远将它留在身边。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591325
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591325,
					"content": "如果他还活着…作为女皇陛下的愚人众，我会猎取那个叛徒的首级，无论他逃到哪里，藏到什么时候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591326
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591326,
					"content": "如果他已经牺牲了…作为他的姐姐，我也将迎向每一位愚人众必然面临的命运，并且为他而自豪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591327
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591327,
					"content": "所谓「舍我其谁」呢…就是这样的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591328,
						710591330
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591328,
					"content": "如果你在作恶，而我必须阻止你呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591329
					]
				},
				{
					"id": 710591329,
					"content": "…我们都有没得选择的时候，也都有不得不去做的事情，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591333
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591333,
					"content": "好啦…你真的太严肃了，没到喝酒年纪的孩子呀，总是有奇奇怪怪的烦恼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591334
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591334,
					"content": "到时候再说吧，到不得不选择的时候再说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591335
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591335,
					"content": "不过现在，我要休息了…你也要睡一会儿吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591336
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591336,
					"content": "只有一张草铺，你叫我们怎么睡呀？明明是在赶我们走吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591337
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710591337,
					"content": "哈哈哈哈哈！那是你们自己的问题…真可怜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591338
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591338,
					"content": "不过不管怎样，我真心感谢你们帮忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591330,
					"content": "你一定要拘泥于愚人众的立场吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591331
					]
				},
				{
					"id": 710591331,
					"content": "嗯？是呀，很奇怪吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591332
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591332,
					"content": "理念呀、立场呀，都是太无聊的问题了。噗…我的面具下面可不是只有理念，我是怕子弹的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591333
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591321,
					"content": "还需要我帮忙吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591322
					]
				},
				{
					"id": 710591308,
					"content": "他可能通过密道逃走了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591309
					]
				}
			]
		},
		{
			"id": 7105914,
			"completionStepIds": [
				7105908
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710591401,
					"content": "「…成功进入了这处暗室，巨大的机关怪物还在外面游荡，似乎在耐心地等待我逃出去，就像掠食者，居心叵测，险恶异常…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591402
					],
					"speakerTitle": "尼古拉下士的笔记"
				},
				{
					"id": 710591402,
					"content": "「…左腿受了重伤，草草包扎了一下，很痛，肿起来了。可能有感染…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591403
					],
					"speakerTitle": "尼古拉下士的笔记"
				},
				{
					"id": 710591403,
					"content": "「…岩穴里还有另一个出口，不敢确定通往何处。出口的结构很脆弱，如果没有支撑的话，遇到强大的外力很容易垮塌…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591404
					],
					"speakerTitle": "尼古拉下士的笔记"
				},
				{
					"id": 710591404,
					"content": "「…我被发现了，有人来了。来客是一个…浑身漆黑的…剑士…？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591405
					],
					"speakerTitle": "尼古拉下士的笔记"
				},
				{
					"id": 710591405,
					"content": "「…他，不，它…？似乎坚固的金属栅栏也拦不住它，看到它的模样我就知道了…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591406
					],
					"speakerTitle": "尼古拉下士的笔记"
				},
				{
					"id": 710591406,
					"content": "「…对不起，卡佳。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "尼古拉下士的笔记"
				}
			]
		}
	]
}