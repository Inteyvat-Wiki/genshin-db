				"points": []
			},
			"dialogs": [
				{
					"id": 710580601,
					"content": "我要休息了，旧伤还在痛…抱歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580602
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710580602,
					"content": "有事的话，请改天再来找我吧…我正好也有事要拜托你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡塔琳娜"
				}
			]
		},
		{
			"id": 7105901,
			"completionStepIds": [
				7105901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105901",
							"2"
						],
						"stepId": 7105901,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"卡塔琳娜",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710590101,
					"content": "你们来了！请随便坐坐吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590102
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710590102,
					"content": "抱歉，之前急匆匆把你们赶走，也没有说清楚要请你们帮什么忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590103,
						710590104
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710590103,
					"content": "没关系，你请说吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590107
					]
				},
				{
					"id": 710590107,
					"content": "放心吧，我不会让你们做坏事的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590108,
						710590109
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710590108,
					"content": "那你请说。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590113
					]
				},
				{
					"id": 710590113,
					"content": "是这样的…我的科利亚…我的队员尼古拉和我失散了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590114
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710590114,
					"content": "所以…我想拜托你寻找他留下的线索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590115
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710590115,
					"content": "如果他还活着，请带他回来见我。如果他牺牲了…也请让我知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590116
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710590116,
					"content": "实在抱歉，拜托你这样的事情…但希望你们能够考虑一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590117
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710590117,
					"content": "这样呀…我还以为你要找我们做什么坏事呢！比如说，给千岩军搞破坏…什么的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710590118,
					"content": "千岩军…为什么？和他们为敌对我们愚人众没有好处的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590119
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710590119,
					"content": "你是什么意思？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590120
					]
				},
				{
					"id": 710590120,
					"content": "我还想问你…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590121
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710590121,
					"content": "等等…我明白了…我们在地面上和璃月人闹翻了…？这就解释了为什么我们的补给会中断…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590122
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710590122,
					"content": "可恶…地面上到底发生了些什么啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590123,
						710590124
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710590123,
					"content": "说来话长…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590125
					]
				},
				{
					"id": 710590125,
					"content": "哼…那个之后再说。战争就是这样…敌友瞬息万变，这就是愚人众栖身其中的环境。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590126
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710590126,
					"content": "但我现在…至少是现在，我只关心科利亚一个人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590127
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710590127,
					"content": "在我们撤退的途中，他和小队失散了…后来，我回来找他，结果自己也和其他人失散了。唉，真是丢人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590128
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710590128,
					"content": "至于他最后出现的地点…我可以帮你在地图上标出位置。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590129
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710590129,
					"content": "他在那里和我们分开了，他想要引开追击的敌人…他是个优秀的战士，我知道他不会死在那里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590130
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710590130,
					"content": "希望他在那边留下了线索…希望如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710590124,
					"content": "事端是你们挑起的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590125
					]
				},
				{
					"id": 710590109,
					"content": "你当然不会让我们坏愚人众的事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590110
					]
				},
				{
					"id": 710590110,
					"content": "对啊，如果我们做的好事对于你们这些坏家伙来说是坏事的话，你可不许阻止我们呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710590111,
					"content": "什么好事…坏事…我阻止你们…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590112
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710590112,
					"content": "唉…你们好烦啊，听我把话说完好不好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590113
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710590104,
					"content": "没关系，我们还没答应你呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590105
					]
				},
				{
					"id": 710590105,
					"content": "对呀，你们是愚人众嘛！要是指使我们做坏事的话，我们可不干！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710590106,
					"content": "噗…你说的很有道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590107
					],
					"speakerTitle": "卡塔琳娜"
				}
			]
		},
		{
