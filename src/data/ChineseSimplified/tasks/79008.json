			"dialogs": [
				{
					"id": 790080101,
					"content": "应该就是这个了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080102
					],
					"speakerTitle": "调查"
				},
				{
					"id": 790080102,
					"content": "嗯？旁边还有一封信…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080103
					],
					"speakerTitle": "调查"
				},
				{
					"id": 790080103,
					"content": "致有缘来到这里的朋友，",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080104
					],
					"speakerTitle": "调查"
				},
				{
					"id": 790080104,
					"content": "你好呀，远方的人。如果你能看到这封信，应该是找到了我留下的羽球。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080105
					],
					"speakerTitle": "调查"
				},
				{
					"id": 790080105,
					"content": "金苹果群岛上有不少跟羽球有关的游戏，我和我的朋友们在这里度过了一个非常快乐的夏天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080106
					],
					"speakerTitle": "调查"
				},
				{
					"id": 790080106,
					"content": "所以我在这里留下我制作的羽球，但愿偶然发现这个羽球的你也能体验到与我相同的快乐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080107
					],
					"speakerTitle": "调查"
				},
				{
					"id": 790080107,
					"content": "请尽情享受阳光、海风与夏日游戏吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080108
					],
					"speakerTitle": "调查"
				},
				{
					"id": 790080108,
					"content": "——芭芭拉",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080109
					],
					"speakerTitle": "调查"
				},
				{
					"id": 790080109,
					"content": "不愧是芭芭拉，托她的福，我们也有羽球啦！走吧，让我们玩个痛快！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "调查"
				}
			]
		},
