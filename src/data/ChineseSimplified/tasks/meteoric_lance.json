			"dialogs": [
				{
					"id": 740740101,
					"content": "…不是，比起这个，你不更应该关注视野内还躺着一个人吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740102
					],
					"speakerTitle": "安"
				},
				{
					"id": 740740102,
					"content": "欸？哇！怎么回事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740740103,
					"content": "抱歉小姐，刚才把寻找石碑的优先级提到最高了。现在请让我来进行扫描…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740104
					],
					"speakerTitle": "西摩尔"
				},
				{
					"id": 740740104,
					"content": "…很抱歉，小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740105
					],
					"speakerTitle": "西摩尔"
				},
				{
					"id": 740740105,
					"content": "什么？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740740106,
					"content": "他虽然还活着，但是生命的气息已经从他的孔窍中溜走了。我认识这个手段…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740107
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740740107,
					"content": "呜呜，我不敢看了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740740108,
					"content": "赶紧去找人帮忙吧！可不能就这样放着不管！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740740109,
					"content": "一同将失去意识的人送到了柔灯港。\\n柔灯港的人立刻出发，将他送去救治。\\n随后才放下心来，与众人回到了原来的位置。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740740110
					]
				},
				{
					"id": 740740110,
					"content": "好啦，我们看看石碑吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740740111,
					"content": "「此处乃愿望之象限，愿望之神殿，愿望之间。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740112
					],
					"speakerTitle": "西摩尔"
				},
				{
					"id": 740740112,
					"content": "「常与相违」…「生于一瞬，伴你长眠，从不分离」…「有染罪果」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740113
					],
					"speakerTitle": "西摩尔"
				},
				{
					"id": 740740113,
					"content": "又是谜语。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740114
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740740114,
					"content": "为什么要在这里做这么可怕的事情…和谜底难道有关吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740740115,
					"content": "因为枫丹人是「罪人」，是「有染原罪」的生命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740116
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740740116,
					"content": "因此答案是「生命」。我已经猜出来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740117
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740740117,
					"content": "你能确定是这个答案吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740118
					],
					"speakerTitle": "安"
				},
				{
					"id": 740740118,
					"content": "我太熟悉水仙十字结社的那套语言符号系统了。不出意外就是这个答案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740119
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740740119,
					"content": "好了，让我们开始争分夺秒吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡特皮拉"
				}
			]
		},
