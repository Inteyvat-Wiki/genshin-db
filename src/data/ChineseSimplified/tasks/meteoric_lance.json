			"dialogs": [
				{
					"id": 740741901,
					"content": "仔细检查了机关顶部的空间，什么都没有发现。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740741902
					]
				},
				{
					"id": 740741902,
					"content": "结果最后这里什么都没有吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740741903
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740741903,
					"content": "并不是，看起来是已经被人拿走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740741904
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740741904,
					"content": "那岂不是我们的计划已经失败了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740741905
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740741905,
					"content": "「理性」的诞生需要四个象限合一。只要我们能拿到剩下的几个，我们就还有机会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740741906
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740741906,
					"content": "既然如此，我们就快点去接下来的地方吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安"
				}
			]
		},
