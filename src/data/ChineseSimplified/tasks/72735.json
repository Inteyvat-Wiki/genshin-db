			"trigger": {
				"objectNames": [
					"「千日喧哗大飞车」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 727350101,
					"content": "你们三个，谁是老大？站出来面对我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350102
					],
					"speakerTitle": "「千日喧哗大飞车」"
				},
				{
					"id": 727350102,
					"content": "我「千日喧哗大飞车」可是精锐中的精锐，代表「花角玉将」大人，来取你们荒泷派老大的首级！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350103
					],
					"speakerTitle": "「千日喧哗大飞车」"
				},
				{
					"id": 727350103,
					"content": "呜哇，好凶好凶！说话也好狠！这次好像真的来了个强人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727350104,
					"content": "什么乱七八糟的！还有，你的称号里居然也用了「大」字，是想和本大爷抢风头吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350105
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 727350105,
					"content": "本大爷揍的就是你这种精锐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350106
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 727350106,
					"content": "好，好高的男人，居然还是…鬼族！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350107
					],
					"speakerTitle": "「千日喧哗大飞车」"
				},
				{
					"id": 727350107,
					"content": "如此豪气飒爽的家伙，怎么会玩斗虫这种小孩喜欢的游戏…真是见了鬼了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350108
					],
					"speakerTitle": "「千日喧哗大飞车」"
				},
				{
					"id": 727350108,
					"content": "你说什么？你在小瞧斗虫吗？真是胆大包天！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350109
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 727350109,
					"content": "根本不懂斗虫精髓的家伙，必须由热爱斗虫的人来修正！本大爷就好好教训你一回！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350110,
						727350111
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 727350110,
					"content": "教训他！教训他！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727350112
					]
				},
				{
					"id": 727350112,
					"content": "对对对，可不能让他一直这么嚣张！就看你的了，放牛的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727350113,
					"content": "没办法了…来就来，谁怕谁！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「千日喧哗大飞车」"
				},
				{
					"id": 727350111,
					"content": "修正他！修正他！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727350112
					]
				}
			]
		}
	]
}