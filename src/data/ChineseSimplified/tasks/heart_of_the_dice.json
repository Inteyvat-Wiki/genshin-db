			"dialogs": [
				{
					"id": 705340101,
					"content": "真不知道为什么又要再做一个桌面游戏，唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705340102
					],
					"speakerTitle": "费恩"
				},
				{
					"id": 705340102,
					"content": "旅行者，你吓我一跳…你也是来参加「召唤王大奖赛」的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705340103,
						705340104
					],
					"speakerTitle": "费恩"
				},
				{
					"id": 705340103,
					"content": "你在做什么呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705340105
					]
				},
				{
					"id": 705340105,
					"content": "喔，这是协会里的一个冒险家自己设计的小游戏，说是一种…将七圣召唤和战斗结合起来的新型桌面游戏，叫做「妙骰战法」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705340106
					],
					"speakerTitle": "费恩"
				},
				{
					"id": 705340106,
					"content": "咱们不是正在协办「召唤王大奖赛」嘛，协会就看中了这家伙设计的「妙骰战法」，专门拿出来做了一个小活动…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705340107,
						705340108
					],
					"speakerTitle": "费恩"
				},
				{
					"id": 705340107,
					"content": "打牌和战斗也能结合起来？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705340109
					]
				},
				{
					"id": 705340109,
					"content": "哈哈哈，说实话，我也不太明白。但我这边有一本规则书…您瞧瞧，这都厚成什么样了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705340110
					],
					"speakerTitle": "费恩"
				},
				{
					"id": 705340110,
					"content": "但按照我的理解，「骰子」的使用方法应该就是「妙骰战法」的核心玩法了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705340111
					],
					"speakerTitle": "费恩"
				},
				{
					"id": 705340111,
					"content": "总之，如果您想玩的话，就请来这边体验一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "费恩"
				},
				{
					"id": 705340108,
					"content": "想象不出来结合的方法…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705340109
					]
				},
				{
					"id": 705340104,
					"content": "什么桌面游戏？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705340105
					]
				}
			]
		}
	]
