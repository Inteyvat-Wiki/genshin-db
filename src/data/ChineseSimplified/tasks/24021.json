				]
			},
			"dialogs": [
				{
					"id": 240210101,
					"content": "痛…这箱子怎么这么重…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210102
					],
					"speakerTitle": "沙尔梅"
				},
				{
					"id": 240210102,
					"content": "你没事吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240210103
					]
				},
				{
					"id": 240210103,
					"content": "荣誉高级研究员，又见到您了。真不好意思…我…我的腰好像受伤了，好痛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210104
					],
					"speakerTitle": "沙尔梅"
				},
				{
					"id": 240210104,
					"content": "我之前准备去把一个箱子搬过来，整理一下里面装着的资料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210105
					],
					"speakerTitle": "沙尔梅"
				},
				{
					"id": 240210105,
					"content": "我…我没想到那个箱子会有那么重，搬起来的时候一个没站住，所有的力量都吃在腰上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210106
					],
					"speakerTitle": "沙尔梅"
				},
				{
					"id": 240210106,
					"content": "我现在…感觉腰都要断了，哎哟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210107,
						240210108
					],
					"speakerTitle": "沙尔梅"
				},
				{
					"id": 240210107,
					"content": "要我背你去看医生吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240210109
					]
				},
				{
					"id": 240210109,
					"content": "不、不用…我之前也伤过腰，只要休息一下就好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210110
					],
					"speakerTitle": "沙尔梅"
				},
				{
					"id": 240210110,
					"content": "到底是装着多少文件，会有这么重啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 240210111,
					"content": "应该是…很多很多卷宗吧，之前院内曾经推广过一段时间的「留痕式办公」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210112
					],
					"speakerTitle": "沙尔梅"
				},
				{
					"id": 240210112,
					"content": "简单来说，就是院内所有的研究事务都必须留下纸质的办理证明。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210113
					],
					"speakerTitle": "沙尔梅"
				},
				{
					"id": 240210113,
					"content": "在这个办公方式推广之后，整个科学院的纸张消耗直接增长了五倍…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210114
					],
					"speakerTitle": "沙尔梅"
				},
				{
					"id": 240210114,
					"content": "因为文件太多，每一个办公室甚至被迫设立了一个「文材整理」的岗位，专门来将文件分门别类…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210115
					],
					"speakerTitle": "沙尔梅"
				},
				{
					"id": 240210115,
					"content": "也就说，所有事情都要记在纸上？听起来就好麻烦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 240210116,
					"content": "是啊。后来这个办公方式也渐渐淡化，只在小范围内实行了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210117
					],
					"speakerTitle": "沙尔梅"
				},
				{
					"id": 240210117,
					"content": "先不说这些…荣誉高级研究员，能请您帮我拿一下卷宗箱吗？虽然腰痛，但我还得快点整理好里面的卷宗才行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210118,
						240210119
					],
					"speakerTitle": "沙尔梅"
				},
				{
					"id": 240210118,
					"content": "好吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 240210119,
					"content": "你就好好休息吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240210120
					]
				},
				{
					"id": 240210120,
					"content": "没事，我整理卷宗只用手，不用腰。您就放心吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "沙尔梅"
				},
				{
					"id": 240210108,
					"content": "我可以叫人过来。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240210109
					]
				}
			]
		},
