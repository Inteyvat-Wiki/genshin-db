					"content": "！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230176
					],
					"speakerTitle": "长翎鹮"
				},
				{
					"id": 761230176,
					"content": "哥伦比娅还挺会准备礼物的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230177
					]
				},
				{
