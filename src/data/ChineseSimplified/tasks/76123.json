					"nextDialogs": [
						761230178
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761230178,
					"content": "噢！终于轮到我们了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230179
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761230179,
					"content": "欸？是糖果？我还以为会跟大家一样是蛋卷呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230180
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761230180,
					"content": "那个已经在试吃的时候尝过了吧？来点不一样的不是更好么？",
