			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"奥格劳",
					"基肖恩"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							1729.47,
							441.44,
							4935.436
						],
						"pointId": 6224
					},
					{
						"sceneId": 3,
						"position": [
							1730.136,
							441.44,
							4933.521
						],
						"pointId": 6226
					}
				]
			},
			"dialogs": [
				{
					"id": 741370101,
					"content": "「…经专家组核实认定，被告人贩售的商品『荧光紫水母』已经对本地生态造成影响，严重扰乱水下生物的正常活动。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370102
					],
					"speakerTitle": "奥格劳"
				},
				{
					"id": 741370102,
					"content": "「…『破坏生态罪』证据确凿，罪名成立。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370103
					],
					"speakerTitle": "奥格劳"
				},
				{
					"id": 741370103,
					"content": "等、等等…我真的什么都不知道哇！它们真不是我放的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370104
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741370104,
					"content": "「…鉴于被告无主观犯罪意识，今特许被告人将功补过。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370105
					],
					"speakerTitle": "奥格劳"
				},
				{
					"id": 741370105,
					"content": "「若能在时限内将指定水域中的『荧光紫水母』回收，将酌情免除部分处罚…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370106
					],
					"speakerTitle": "奥格劳"
				},
				{
					"id": 741370106,
					"content": "回收！这怎么回收啊？能、能不能再商量商量？多罚点款也行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370107
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741370107,
					"content": "「…时限详情参见附录说明。」——先生，跟我讨价还价也没用啊，再说讨价还价也算时间，你还是多想想怎么回收吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370108
					],
					"speakerTitle": "奥格劳"
				},
				{
					"id": 741370108,
					"content": "唉，那些人买了水母就到处放生，我的水性又不行…这该怎么回收啊…早知道就不该卖给他们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370109
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741370109,
					"content": "私自放生的那群人，警备队还会继续追查，不过不管怎么说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370110
					],
					"speakerTitle": "奥格劳"
				},
				{
					"id": 741370110,
					"content": "培育了这些水母的人是你，不经报备就进行贩售的人也是你，忘了提醒买家不能放生的人还是你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370111
					],
					"speakerTitle": "奥格劳"
				},
				{
					"id": 741370111,
					"content": "老实说，现在这个处理已经算从宽啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370112
					],
					"speakerTitle": "奥格劳"
				},
				{
					"id": 741370112,
					"content": "呜…早知道这样，我就该在和这群人做生意的时候跟他们签一份免责声明…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370113
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741370113,
					"content": "总而言之，希望你能抓住机会，好好补救——也希望我们下次见面，不是在梅洛彼得堡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370114
					],
					"speakerTitle": "奥格劳"
				},
				{
					"id": 741370114,
					"content": "基肖恩颓丧地目送奥格劳离开…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741370115
					]
				},
				{
					"id": 741370115,
					"content": "呜哇，你还好吗？脸色看起来一片灰欸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370116,
						741370117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741370116,
					"content": "「荧光紫水母」是什么东西？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741370118
					]
				},
				{
					"id": 741370118,
					"content": "…你们刚刚都听到了吗？很抱歉，我现在没时间聊天，得赶紧去冒险家协会挂个委托，或者雇一位潜水员…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370119
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741370119,
					"content": "…可是找协会要走流程，潜水员又不知道怎么请——啊啊，难不成我真得进梅洛彼得堡了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370120
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741370120,
					"content": "#{NICKNAME}，我有生意上门…不对，出手助人的预感！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370121,
						741370122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741370121,
					"content": "要找冒险家是吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741370123
					]
				},
				{
					"id": 741370123,
					"content": "对啊…等等，你…您不会刚好就是吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370124
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741370124,
					"content": "#嘿嘿，你算是问对人了，{NICKNAME}可是冒险家里最会潜水的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741370125,
					"content": "潜水员里最能冒险的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741370126
					]
				},
				{
					"id": 741370126,
					"content": "#谢天谢地！倒了那么久的霉，可算是让我撞上一回好运了！冒险家{M#先生}{F#小姐}，请您帮帮我吧，报酬绝对不成问题！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370127
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741370127,
					"content": "先说说是怎么回事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741370128
					]
				},
				{
					"id": 741370128,
					"content": "对哦，刚刚看你还被定了罪…该不会是什么坏事吧？那我们可不帮！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741370129,
					"content": "不会的不会的…其实我是个生物学者，在做实验的时候，凑巧培育出了一批会发光的水母。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370130
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741370130,
					"content": "原本这些水母在实验结束后就得处理掉，可我看它们的卖相还挺漂亮，就想当成宠物来卖一笔钱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370131
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741370131,
					"content": "毕竟学生物的，平时也没啥赚钱的机会…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370132
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741370132,
					"content": "欸…结果你赚到钱了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741370133,
					"content": "这个嘛，当商人确实比研究生物好赚钱…不过钱是赚到了，这麻烦也上门了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370134
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741370134,
					"content": "我头一次做宠物生意，也没想那么多，更没想到买家里，还有一群买了不养，专门拿去放生的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370135
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741370135,
					"content": "他们大概是觉得这些出生在实验室里的小生命太可怜了吧，一回头就把它们放生到了野外。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370136
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741370136,
					"content": "但这些经我特殊培育过的水母，跟本地的生态系统并不兼容。尤其是它们喜好聚集又会发光的特征…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370137
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741370137,
					"content": "…很容易改变水下的光照条件，干扰其他物种的正常活动，进而影响生态平衡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370138
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741370138,
					"content": "等、等等，又是聚集自发光又是水下光照的…能不能说的简单一点？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741370139,
					"content": "呃，不好意思，老毛病犯了…举例来说，你们应该见过那种只有白天或者晚上才会出来活动的鱼种吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370140
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741370140,
					"content": "一些水下生物的习性，跟所处水域中的光照息息相关，一旦引入非自然的光源，它们的行为就容易被干扰…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370141
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741370141,
					"content": "…以前也有同行，研究过用灯光来钓鱼的原理…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370142,
						741370143
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741370142,
					"content": "又扯远了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741370144
					]
				},
				{
					"id": 741370144,
					"content": "啊…抱歉抱歉，总而言之， 最近警备队发现各地水域都出现了反常的发光现象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370145
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741370145,
					"content": "仔细调查后，发现那些光源都是聚集成团一起发光的「荧光紫水母」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370146
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741370146,
					"content": "虽然不是我直接放生的，但也是从我手上卖出去的。现在他们责令我收拾这副烂摊子，至少也得把数量控制到安全线以内。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370147
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741370147,
					"content": "可我一个学者，哪有这身手下水？还好现在遇上了你们，要不然我这霉运，真得一口气倒到底咯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370148
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741370148,
					"content": "听起来确实是挺倒霉的…不过你也不算无辜吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370149
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741370149,
					"content": "#——冒险家{M#先生}{F#小姐}，我愿意出一大笔报酬，请您帮帮我吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370150
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741370150,
					"content": "#一大笔报酬…{NICKNAME}，我觉得他知错能改，是个好人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370151,
						741370152
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741370151,
					"content": "…好吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741370153
					]
				},
				{
					"id": 741370153,
					"content": "哦哦，太感谢了！警备队正在调查这些「荧光紫水母」被放生的位置。只要去那些区域，尽可能把它们都抓回来就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370154
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741370154,
					"content": "它们的活动范围不大，移动速度也不快…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370155
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741370155,
					"content": "对您这样的潜水好手来说，应该还挺好抓的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370156
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741370156,
					"content": "「荧光紫水母」在水里都挺醒目的，您循着光源游上一圈就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370157
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741370157,
					"content": "我会一直留在这里，如果还有什么不明白的，欢迎随时来问…呃，只要我还没被抓去梅洛彼得堡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741370152,
					"content": "具体要怎么做？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741370153
					]
				},
				{
					"id": 741370143,
					"content": "拣重点说。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741370144
					]
				},
				{
					"id": 741370122,
					"content": "要找潜水员是吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741370123
					]
				},
				{
					"id": 741370117,
					"content": "「破坏生态罪」是怎么回事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741370118
					]
				}
			]
		}
	]
}