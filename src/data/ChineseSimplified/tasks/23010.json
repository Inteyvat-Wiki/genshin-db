				"objectNames": [
					"贾法尔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230100101,
					"content": "朋友，你看起来很匆忙，有什么在让你忧心？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100102,
						230100105
					],
					"speakerTitle": "贾法尔"
				},
				{
					"id": 230100102,
					"content": "有很多事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230100103
					]
				},
				{
					"id": 230100103,
					"content": "喔…我发现你的神情很疲惫，但动作还是匆忙无比。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100104
					],
					"speakerTitle": "贾法尔"
				},
				{
					"id": 230100104,
					"content": "你准是在为某个问题而忧心忡忡，但这个问题你又不得不尽快找到解决方案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100109
					],
					"speakerTitle": "贾法尔"
				},
				{
					"id": 230100109,
					"content": "如果你愿意被我耽误一会的话，我希望你能坐下来，和我一同品尝一道美食。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100110
					],
					"speakerTitle": "贾法尔"
				},
				{
					"id": 230100110,
					"content": "四处奔波固然是人生常态…但我们常说，奔涌向前的汹涌河水，偶尔也会沉默地淌过寂静的小溪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100111
					],
					"speakerTitle": "贾法尔"
				},
				{
					"id": 230100111,
					"content": "再如何奔忙，总要留给自己一点时间来休憩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100112
					],
					"speakerTitle": "贾法尔"
				},
				{
					"id": 230100112,
					"content": "让我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100113
					],
					"speakerTitle": "贾法尔"
				},
				{
					"id": 230100113,
					"content": "不如我们一同来品尝一道「薄荷豆汤」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100114
					],
					"speakerTitle": "贾法尔"
				},
				{
					"id": 230100114,
					"content": "你无需付给我摩拉，只需要为我找到一株薄荷就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100115
					],
					"speakerTitle": "贾法尔"
				},
				{
					"id": 230100115,
					"content": "喔，对了，找薄荷的时候，记得不要太挑剔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100116
					],
					"speakerTitle": "贾法尔"
				},
				{
					"id": 230100116,
					"content": "记住，你只是在寻找一株普通的薄荷，不是在寻找任何问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "贾法尔"
				},
				{
					"id": 230100105,
					"content": "其实还好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230100106
					]
				},
				{
					"id": 230100106,
					"content": "喔，那样就最好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100107
					],
					"speakerTitle": "贾法尔"
				},
				{
					"id": 230100107,
					"content": "但你的脚步如此匆忙，想必是正在为解决某个问题而奔走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100108
					],
					"speakerTitle": "贾法尔"
				},
				{
					"id": 230100108,
					"content": "唔，虽然我不知道你要处理什么问题，但我有一个建议…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100109
					],
					"speakerTitle": "贾法尔"
				}
			]
		},
