			},
			"dialogs": [
				{
					"id": 230100801,
					"content": "朋友，你看起来很匆忙，有什么在让你忧心？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100802,
						230100805
					],
					"speakerTitle": "贾法尔"
				},
				{
					"id": 230100802,
					"content": "有很多事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230100803
					]
				},
				{
					"id": 230100803,
					"content": "喔…我发现你的神情很疲惫，但动作还是匆忙无比。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100804
					],
					"speakerTitle": "贾法尔"
				},
				{
					"id": 230100804,
					"content": "你准是在为某个问题而忧心忡忡，但这个问题你又不得不尽快找到解决方案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100809
					],
					"speakerTitle": "贾法尔"
				},
				{
					"id": 230100809,
					"content": "如果你愿意被我耽误一会的话，我希望你能坐下来，和我一同品尝一道美食。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100810
					],
					"speakerTitle": "贾法尔"
				},
				{
					"id": 230100810,
					"content": "四处奔波固然是人生常态…但我们常说，奔涌向前的汹涌河水，偶尔也会沉默地淌过寂静的小溪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100811
					],
					"speakerTitle": "贾法尔"
				},
				{
					"id": 230100811,
					"content": "再如何奔忙，总要留给自己一点时间来休憩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100812
					],
					"speakerTitle": "贾法尔"
				},
				{
					"id": 230100812,
					"content": "让我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100813
					],
					"speakerTitle": "贾法尔"
				},
				{
					"id": 230100813,
					"content": "不如我们一同来品尝一道「烤肉卷」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100814
					],
					"speakerTitle": "贾法尔"
				},
				{
					"id": 230100814,
					"content": "你无需付给我摩拉，只需要为我找到一份兽肉就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100815
					],
					"speakerTitle": "贾法尔"
				},
				{
					"id": 230100815,
					"content": "无论用什么方法找到兽肉都没有问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100816
					],
					"speakerTitle": "贾法尔"
				},
				{
					"id": 230100816,
					"content": "记住，你要找到的只是一份兽肉，而不是一个难关。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "贾法尔"
				},
				{
					"id": 230100805,
					"content": "其实还好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230100806
					]
				},
				{
					"id": 230100806,
					"content": "喔，那样就最好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100807
					],
					"speakerTitle": "贾法尔"
				},
				{
					"id": 230100807,
					"content": "但你的脚步如此匆忙，想必是正在为解决某个问题而奔走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100808
					],
					"speakerTitle": "贾法尔"
				},
				{
					"id": 230100808,
					"content": "唔，虽然我不知道你要处理什么问题，但我有一个建议…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100809
					],
					"speakerTitle": "贾法尔"
				}
			]
