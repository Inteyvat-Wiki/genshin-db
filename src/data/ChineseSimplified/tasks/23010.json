					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100704
					],
					"speakerTitle": "贾法尔"
				},
				{
					"id": 230100704,
					"content": "谢谢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230100705
					]
				},
				{
					"id": 230100705,
					"content": "不用客气。专心享受这道美味吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100706
					],
					"speakerTitle": "贾法尔"
				},
				{
					"id": 230100706,
					"content": "对我来说，在享受美食的时候，我会把那些让人疲倦的课题和研究统统抛在脑后…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100707
					],
					"speakerTitle": "贾法尔"
				},
				{
					"id": 230100707,
					"content": "就这么任我的思维沉默地流淌过那道寂静的小溪…这就是我的休憩方法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100708
					],
					"speakerTitle": "贾法尔"
				},
				{
					"id": 230100708,
					"content": "好了，还请你细细品尝这道美味。希望你的思维也能从中得到休憩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "贾法尔"
				}
			]
		},
