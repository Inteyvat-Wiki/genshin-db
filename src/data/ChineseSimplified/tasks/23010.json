			"dialogs": [
				{
					"id": 230100301,
					"content": "非常不错的薄荷。请稍等。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100303
					],
					"speakerTitle": "贾法尔"
				},
				{
					"id": 230100302,
					"content": "贾法尔拿出其它食材开始烹饪…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 230100303,
					"content": "这是用你带来的食材制作出的「薄荷豆汤」，请尝尝吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100304
					],
					"speakerTitle": "贾法尔"
				},
				{
					"id": 230100304,
					"content": "谢谢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230100305
					]
				},
				{
					"id": 230100305,
					"content": "不用客气。专心享受这道美味吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100306
					],
					"speakerTitle": "贾法尔"
				},
				{
					"id": 230100306,
					"content": "对我来说，在享受美食的时候，我会把那些让人疲倦的课题和研究统统抛在脑后…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100307
					],
					"speakerTitle": "贾法尔"
				},
				{
					"id": 230100307,
					"content": "就这么任我的思维沉默地流淌过那道寂静的小溪…这就是我的休憩方法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100308
					],
					"speakerTitle": "贾法尔"
				},
				{
					"id": 230100308,
					"content": "好了，还请你细细品尝这道美味。希望你的思维也能从中得到休憩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "贾法尔"
				}
			]
		},
