			"dialogs": [
				{
					"id": 401730101,
					"content": "各位好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730102
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730102,
					"content": "茜特菈莉，你来啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401730103,
					"content": "嗯，我去首领那里请来了一柄仪式剑，借用它的力量可以完成一些事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730104
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730104,
					"content": "都没忘记我们今天要干什么吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730105
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730105,
					"content": "当然啦，我们都等着勒拉醒来，好问问他到底是怎么回事呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401730106,
					"content": "按照奶奶说的，我也准备好了备用的物品，今天万无一失。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730107
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401730107,
					"content": "真不错，那我们就不多说了，现在就开始吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730108
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730108,
					"content": "茜特菈莉召出了一柄名为「厄水之祸」的仪式剑。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401730109
					]
				},
				{
					"id": 401730109,
					"content": "自秘烟中献上供奉。星星献予无月之夜，梦的花环献予风。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730110
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730110,
					"content": "向死之主献上供奉。褪落。褪落。褪落。往复三重又三重。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730111
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730111,
					"content": "呜哇——这是什么咒语吗？突然一下变得好凉！是不是有什么东西来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401730112,
					"content": "小声一点，现在不能吵到她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730113
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401730113,
					"content": "我等，祭司王之嗣，要遵循亘古的盟约，撕裂夜域的织帷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730114
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730114,
					"content": "茜特菈莉在此告谕。我为阿库乌波蒂尔，我为末地的养主。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730115
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730115,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730116
					],
					"speakerTitle": "勒拉"
				},
				{
					"id": 401730116,
					"content": "看！勒拉的灵性回来了，正在往他的身上跑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730117
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401730117,
					"content": "我要用燧石刀刺入夜的斗篷，逐弃一切不属于亡者之国的魂灵。\\n",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730118
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730118,
					"content": "勒拉！依从敕命，归来炎日下的地土，归来你应属的道途！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730119
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730119,
					"content": "成…成功了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401730120,
					"content": "欸…欸？这里是…？你们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730121
					],
					"speakerTitle": "勒拉"
				},
				{
					"id": 401730121,
					"content": "呜哇——黑曜石奶奶！不不…茜特菈莉大祭司！请手下留情！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730122
					],
					"speakerTitle": "勒拉"
				},
				{
					"id": 401730122,
					"content": "你这小鬼，看来很清楚自己干了什么嘛？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730123
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730123,
					"content": "知道自己差点回不来吗？把自己变成一具空壳很有趣吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730124
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730124,
					"content": "对、对不起…请惩罚我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730125
					],
					"speakerTitle": "勒拉"
				},
				{
					"id": 401730125,
					"content": "噢？你是真心的吗？那就快回家和父母告个别吧，就说：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730126
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730126,
					"content": "「再见了，爸爸妈妈，我喜欢空壳的人生，所以决定去黑曜石奶奶那里变成一块石像，替她看家一百年。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730127
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730127,
					"content": "不要啊，我知道错了！十分感谢茜特菈莉大祭司把我救回来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730128
					],
					"speakerTitle": "勒拉"
				},
				{
					"id": 401730128,
					"content": "哼哼，还是谢我孙子吧，要不是他察觉到异常，我是不想管这回事的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730129
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730129,
					"content": "不用客气，勒拉，奶奶只是嘴巴不饶人，我们都不会怪你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730130
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401730130,
					"content": "毕竟你受了别人的蛊惑吧？那个谷中才是罪魁祸首。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730131
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401730131,
					"content": "不…跟谷中先生没关系，是我要这么干的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730132
					],
					"speakerTitle": "勒拉"
				},
				{
					"id": 401730132,
					"content": "欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401730133,
					"content": "虽然是他告诉了我用强大灵物来做媒介的方法，但决定要这么做的人是我，他并没有蛊惑我什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730134
					],
					"speakerTitle": "勒拉"
				},
				{
					"id": 401730134,
					"content": "对不起，要怪也只能怪我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730135
					],
					"speakerTitle": "勒拉"
				},
				{
					"id": 401730135,
					"content": "呵呵，这小鬼被洗脑得不轻啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730136
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730136,
					"content": "呃…那那个媒介碎片是他带来的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730137
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401730137,
					"content": "没错，据他说是跟烬寂海相关的宝物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730138
					],
					"speakerTitle": "勒拉"
				},
				{
					"id": 401730138,
					"content": "那这一看就是在利用你吧！利用你帮他暝视！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401730139,
					"content": "可是，我只是一个灵性白痴，什么法术都学不会…我有什么利用价值呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730140
					],
					"speakerTitle": "勒拉"
				},
				{
					"id": 401730140,
					"content": "像我这样的家伙，如果只是打坐冥想，一辈子都没法感知到灵性的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730141
					],
					"speakerTitle": "勒拉"
				},
				{
					"id": 401730141,
					"content": "谷中先生说，如果用别的办法让我强行施展法术，把自己浸泡在大量灵性中，反而有机会抓住它们的踪影。所以…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730142
					],
					"speakerTitle": "勒拉"
				},
				{
					"id": 401730142,
					"content": "这简直就是破罐子破摔了啊！要不是茜特菈莉，你可真的就回不来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730143
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401730143,
					"content": "对不起…对不起…族里的大家都是很有才华的人，可我却是个白痴…我只是不想再当异类…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730144
					],
					"speakerTitle": "勒拉"
				},
				{
					"id": 401730144,
					"content": "我很理解你…勒拉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730145
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401730145,
					"content": "有些种子可以毫不费劲地长成漂亮的卷心菜，但也有些种子，怎么努力都没法发芽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730146
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401730146,
					"content": "我也不知道为什么会是这样，可能这就是人生吧？总有很多没办法的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730147
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401730147,
					"content": "虽然我说这些也没有用，但希望你能调整好自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730148
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401730148,
					"content": "总之，有什么事之后再说吧，现在先跟我去马塔拉那里检查身体。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "茜特菈莉"
				}
			]
		},
