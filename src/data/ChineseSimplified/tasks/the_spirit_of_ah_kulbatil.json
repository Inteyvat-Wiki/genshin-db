			"dialogs": [
				{
					"id": 401730301,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730302
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730302,
					"content": "（居然被那家伙跑了，这下糗大了…刚刚还一副自信满满的样子，哦天！我的形象…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730303
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730303,
					"content": "（虽然那个谷中出人意料地擅长逃跑，但我也得想个恰当的说辞…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730304
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730304,
					"content": "茜特菈莉！你抓住那个谷中了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401730305,
					"content": "从山洞里只有奶奶一个人来看，应该是没有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730306
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401730306,
					"content": "…我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730307
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730307,
					"content": "我暂时放了他一马。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730308
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730308,
					"content": "不过我在他身上留下了记号，如果他出现在附近，我就能追踪到他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730309
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730309,
					"content": "原来奶奶刚才是假装离开山洞，实际偷偷躲了起来，准备来个瓮中捉鳖。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730310
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401730310,
					"content": "噢！就跟一开始抓欧洛伦那样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401730311,
					"content": "不过茜特菈莉怎么知道那个家伙会过来呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401730312,
					"content": "因为我放了诱饵啊，那张烬寂海的地图和弓的碎片，我刻意把它们留在桌子上，因为它们可能就是谷中的目的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730313
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730313,
					"content": "果然我们离开没多久后，我留下的陷阱就被触发了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730314
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730314,
					"content": "什么？原来洞里真的有陷阱！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401730315,
					"content": "当然，只是会自动忽略你们而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730316
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730316,
					"content": "看，我之前没瞎说吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730317
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401730317,
					"content": "谷中先生，原来你真的在利用我…原来你的目的是烬寂海的情报…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730318
					],
					"speakerTitle": "勒拉"
				},
				{
					"id": 401730318,
					"content": "没错，我最初就在想，那家伙为什么会把碎片留在营地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730319
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730319,
					"content": "在我得到烬寂海位置的时候，我明白了，那个碎片是诱饵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730320
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730320,
					"content": "他知道勒拉一定会出问题，而部族又不会对勒拉视而不见，一定会有人来帮助勒拉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730321
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730321,
					"content": "噢！他在钓鱼！钓出真正有能力的人来帮他暝视这块碎片！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730322
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401730322,
					"content": "没错，而上钩的人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730323
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730323,
					"content": "对不起，是我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730324
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401730324,
					"content": "但还有奶奶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730325
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401730325,
					"content": "臭小子！我是因为你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730326
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730326,
					"content": "总之，这个谷中真狡猾，选择了风险最低的一种办法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730327
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401730327,
					"content": "是哦，如果那家伙直接找到茜特菈莉，应该一分钟就会被识破！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730328
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401730328,
					"content": "那话说回来，茜特菈莉，你为什么要放他一马呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730329
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401730329,
					"content": "咳…因为这里不方便施展出全力，那家伙又很擅长逃跑，强行留下他可能会出问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730330
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730330,
					"content": "难道是我选错了地方…抱歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730331
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401730331,
					"content": "一开始为了救勒拉，我想找一个灵性比较充足的区域，所以就找到了疯贤者的地盘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730332
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401730332,
					"content": "疯贤者？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730333
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401730333,
					"content": "没错，那家伙就在那堵墙后面，如果把他吵醒了也是个麻烦，所以我只能收着手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730334
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730334,
					"content": "不过现在还有一个好消息：我把地图和碎片都抢了回来。奶奶我也不是吃素的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730335
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730335,
					"content": "太好了！那家伙能带走的就只有他自己！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730336
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401730336,
					"content": "唔…可有一点坏的消息是：他大概已经看过了那地图，虽说烬寂海消失时的位置也不算什么秘辛吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730337
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730337,
					"content": "啊？真令人担忧，那家伙不会要做什么坏事吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730338
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401730338,
					"content": "不用太紧张，我会追踪那家伙的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730339
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730339,
					"content": "#另外，勒拉，如果你没意见，我想把地图和这块碎片送给{NICKNAME}，这或许对{M#他}{F#她}未来的旅途有帮助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730340
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730340,
					"content": "#当然！当然没意见！这是{NICKNAME}应得的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730341
					],
					"speakerTitle": "勒拉"
				},
				{
					"id": 401730341,
					"content": "有点太贵重了吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401730342
					]
				},
				{
					"id": 401730342,
					"content": "反正我们都没兴趣。如果它真的指向了烬寂海，你这样的冒险者肯定不愿意错过那里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730343
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730343,
					"content": "这是黑曜石奶奶的预感噢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730344
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730344,
					"content": "那个，黑曜石奶奶，还有一件事，我现在还是灵性白痴吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730345
					],
					"speakerTitle": "勒拉"
				},
				{
					"id": 401730345,
					"content": "什么傻问题？你不是察觉了奶奶我的幻影术吗？虽说是故意露的破绽，但也不是灵性白痴能识破的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730346
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730346,
					"content": "欧洛伦，之后你有空就好好教教这家伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730347
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730347,
					"content": "能学多少，勒拉，就全看你自己的本事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730348
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730348,
					"content": "真好啊，人生真是奇妙，只要一直向前走，说不定就会碰到肥料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730349
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401730349,
					"content": "勒拉，我为你高兴。以后要一起加油啊，希望我们都能成为一颗漂亮的卷心菜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "欧洛伦"
				}
			]
		},
