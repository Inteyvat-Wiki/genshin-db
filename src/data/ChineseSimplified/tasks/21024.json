			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"宝儿"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210240601,
					"content": "看起来没什么用…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240602
					],
					"speakerTitle": "宝儿"
				},
				{
					"id": 210240602,
					"content": "请问你见过一个盒子吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210240603
					]
				},
				{
					"id": 210240603,
					"content": "盒子？哦，我确实捡到了一个盒子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240604
					],
					"speakerTitle": "宝儿"
				},
				{
					"id": 210240604,
					"content": "我已经打开看过了，是一批货单呢，看起来还是一笔很大的生意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240605
					],
					"speakerTitle": "宝儿"
				},
				{
					"id": 210240605,
					"content": "哎呀，不知道这个盒子的主人，愿意付多少钱把盒子拿回去呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240606
					],
					"speakerTitle": "宝儿"
				},
				{
					"id": 210240606,
					"content": "…什么意思？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210240607
					]
				},
				{
					"id": 210240607,
					"content": "别这么一副紧张的样子，我就是和你开个玩笑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240608
					],
					"speakerTitle": "宝儿"
				},
				{
					"id": 210240608,
					"content": "这货单上记的货物价值可不低，也不知道是璃月港里哪位大老板的大手笔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240609
					],
					"speakerTitle": "宝儿"
				},
				{
					"id": 210240609,
					"content": "我可不是不识时务的人，既然知道大概是块铁板，那就没有还硬往上踢的理由。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240610
					],
					"speakerTitle": "宝儿"
				},
				{
					"id": 210240610,
					"content": "不过，我费心费力保管着这货单，你一句话就想要走，是不是…有点说不过去？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240611
					],
					"speakerTitle": "宝儿"
				},
				{
					"id": 210240611,
					"content": "这样好了，我们就用最传统的「以物易物」来解决这个问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240612
					],
					"speakerTitle": "宝儿"
				},
				{
					"id": 210240612,
					"content": "你去给我找三颗「夜泊石」来，我就把这货单给你，怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240613
					],
					"speakerTitle": "宝儿"
				},
				{
					"id": 210240613,
					"content": "毕竟，和这些货单上记着的大买卖相比…这三颗「夜泊石」可真算不上什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240614,
						210240616
					],
					"speakerTitle": "宝儿"
				},
				{
					"id": 210240614,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210240615
					]
				},
				{
					"id": 210240615,
					"content": "那你就快去找吧，找到了之后，我们再一手交石，一手交货。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宝儿"
				},
				{
					"id": 210240616,
					"content": "…这上面记了什么买卖？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210240618
					]
				},
				{
					"id": 210240618,
					"content": "你不知道吗？你只是来帮别人办事…哼，这样也好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240619
					],
					"speakerTitle": "宝儿"
				},
				{
					"id": 210240619,
					"content": "听我一句劝，这种规模的买卖，你还是不要多打听比较好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240620
					],
					"speakerTitle": "宝儿"
				},
				{
					"id": 210240620,
					"content": "好了，你去把「夜泊石」拿来给我，我把货单给你，你再把货单给那个托你办事的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240621
					],
					"speakerTitle": "宝儿"
				},
				{
					"id": 210240621,
					"content": "事情办完，干净利落，一点麻烦也不惹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宝儿"
				}
			]
		},
