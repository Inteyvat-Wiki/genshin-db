			"dialogs": [
				{
					"id": 210240901,
					"content": "您找到了货单了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240902
					],
					"speakerTitle": "兰达"
				},
				{
					"id": 210240902,
					"content": "全部找到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210240903
					]
				},
				{
					"id": 210240903,
					"content": "谢谢您，太感谢您了，太好了，总算没出大问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240904
					],
					"speakerTitle": "兰达"
				},
				{
					"id": 210240904,
					"content": "要是这些货单丢了，老板不知道会发多大火。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240905
					],
					"speakerTitle": "兰达"
				},
				{
					"id": 210240905,
					"content": "呃，您是想问「这些货单到底是什么生意」吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240906
					],
					"speakerTitle": "兰达"
				},
				{
					"id": 210240906,
					"content": "抱歉，我真的不能告诉您，这些都是机密。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240907
					],
					"speakerTitle": "兰达"
				},
				{
					"id": 210240907,
					"content": "这是您的报酬，请收…等会，这个盒子怎么被打开过？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240908
					],
					"speakerTitle": "兰达"
				},
				{
					"id": 210240908,
					"content": "…在野外遇见了一个人，她捡到盒子之后打开看了？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240909
					],
					"speakerTitle": "兰达"
				},
				{
					"id": 210240909,
					"content": "完了，完了，全完了！不行…得快点去告诉老板…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240910
					],
					"speakerTitle": "兰达"
				},
				{
					"id": 210240910,
					"content": "哦，您放心，我不会怀疑您的，毕竟您的事迹我已经…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240911
					],
					"speakerTitle": "兰达"
				},
				{
					"id": 210240911,
					"content": "咳！我，我得想办法和老板联系了，请您去忙自己的事吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰达"
				}
			]
		},
