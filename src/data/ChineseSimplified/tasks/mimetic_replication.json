				"points": []
			},
			"dialogs": [
				{
					"id": 736920101,
					"content": "啊…你好，旅行者，看样子，你也是来参加学院游乐会的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920102
					],
					"speakerTitle": "帕兹"
				},
				{
					"id": 736920102,
					"content": "如果有兴趣的话，您愿意来试玩一下我们阿弥利多学院推出的小游戏吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920103
					],
					"speakerTitle": "帕兹"
				},
				{
					"id": 736920103,
					"content": "是什么小游戏？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736920104
					]
				},
				{
					"id": 736920104,
					"content": "我们学院在学院游乐会期间推出了小游戏「仿生摹行」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920105
					],
					"speakerTitle": "帕兹"
				},
				{
					"id": 736920105,
					"content": "在这个游戏中，我会向您介绍一些动物的规律性行为。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920106
					],
					"speakerTitle": "帕兹"
				},
				{
					"id": 736920106,
					"content": "当然了，这些「规律性」都经过了我们的简化和概括，很容易理解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920107
					],
					"speakerTitle": "帕兹"
				},
				{
					"id": 736920107,
					"content": "您需要做的，就是用这个我们已经准备好的模型来模仿对应动物的行为。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920108,
						736920109
					],
					"speakerTitle": "帕兹"
				},
				{
					"id": 736920108,
					"content": "听着还蛮简单的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736920110
					]
				},
				{
					"id": 736920110,
					"content": "是的。「动物具有规律性的习性」是一句很容易理解和接受的话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920111
					],
					"speakerTitle": "帕兹"
				},
				{
					"id": 736920111,
					"content": "但在这句看似简单的话背后，却包含着探究不尽的谜题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920112
					],
					"speakerTitle": "帕兹"
				},
				{
					"id": 736920112,
					"content": "不过…这段时间内，我们就暂时放下学术性的观察眼光，轻松地体会一下动物们的习性吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920113,
						736920115
					],
					"speakerTitle": "帕兹"
				},
				{
					"id": 736920113,
					"content": "想要试玩一下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736920114
					]
				},
				{
					"id": 736920114,
					"content": "好的，请您到这边来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "帕兹"
				},
				{
					"id": 736920115,
					"content": "还有别的事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736920116
					]
				},
				{
					"id": 736920116,
					"content": "没关系，这段时间，我的摊位会一直开着，您可以随时来试玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "帕兹"
				},
				{
					"id": 736920109,
					"content": "感觉倒是不难。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736920110
					]
				}
			]
		}
	]
}