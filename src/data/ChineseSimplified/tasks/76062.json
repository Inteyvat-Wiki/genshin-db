			},
			"dialogs": [
				{
					"id": 760620501,
					"content": "乌吉好像安静下来了，所以…其实那些月光藤蔓才是罪魁祸首吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760620502,
					"content": "但他还在痛苦，我看得出来，他的思维很混乱，没办法与我交流。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620503
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760620503,
					"content": "是因为他体内的信息…我感觉到了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620504
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 760620504,
					"content": "我和他…是同类…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620505
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 760620505,
					"content": "黑蛋你要干什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760620506,
					"content": "他身体里…有乌吉恩圈终端的信息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620507
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 760620507,
					"content": "还记得吗？那个终端附近…也长了一样的月光藤蔓。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620508
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 760620508,
					"content": "你是说…是这家伙吸收了那里的信息？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620509
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760620509,
					"content": "嗯…那些信息里…也许保存着望月者计划的内容…那一定就是我的使命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620510
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 760620510,
					"content": "但是这也太危险了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620511
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760620511,
					"content": "派蒙，让宁宁去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620512
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760620512,
					"content": "她诞生在月亮上，是我因为担心，擅自将她送去了离家万里的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620513
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760620513,
					"content": "为了使命，她在你们的帮助下想尽办法回到了这里，回到了她的家乡。她的决心…很了不起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620514
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760620514,
					"content": "哪怕是出于善意被人保护起来，也不是她想要选择的事吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620515
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760620515,
					"content": "可是，哥伦比娅…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620516
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760620516,
					"content": "就是因为她这么努力，才更让人担心啊…就算她已经进入叛逆期，对我越来越不尊敬了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620517
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760620517,
					"content": "等叛逆期过去，成熟期就会到来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620518
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760620518,
					"content": "派蒙…如果你能放开我…我会给你比月亮还大的尊敬…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620519
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 760620519,
					"content": "但是这家伙这么大，万一你被他吞噬了怎么办？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620520
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760620520,
					"content": "如果真是那样…那一定也是使命的一部分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620521
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 760620521,
					"content": "你这家伙！也太固执了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620522
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760620522,
					"content": "也可以说这是她此刻心中最强烈的愿望，对吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620523
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760620523,
					"content": "没错！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620524
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 760620524,
					"content": "那么，去吧宁宁，我相信你，让这缕月光见证你的决定，并庇佑你的旅途。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620525
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760620525,
					"content": "欸？这是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620526,
						760620527
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760620526,
					"content": "我也相信你，黑蛋。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760620528
					]
				},
				{
					"id": 760620528,
					"content": "谢谢你们…那我开始了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620529
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 760620529,
					"content": "啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620530
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 760620530,
					"content": "黑蛋！你可要顺利度过叛逆期啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620531
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760620531,
					"content": "我可以的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620532
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 760620532,
					"content": "我…我成功了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620533
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 760620533,
					"content": "看来情况没有想得那么糟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620534
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760620534,
					"content": "这样真是太好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620535
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760620535,
					"content": "谢谢你们…我得到了非常重要的信息，我知道了乌吉恩圈和星空生物捕捉站发生了什么事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620536
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 760620536,
					"content": "发生了什么？我也很好奇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620537
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760620537,
					"content": "还是那个深空中的神秘信号，它终于再次出现了，虽然那已经是龙族先驱离世的多年，但是没关系…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620538
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 760620538,
					"content": "因为由他设计的望月者高塔——伊比尼伯龙之眼，精准地捕捉到了信号发出的坐标。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620539
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 760620539,
					"content": "终于做到了吗，真是令人振奋！那是从哪发过来的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620540
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760620540,
					"content": "从一片距离月球很远的星空深处…那个地方即使飞船勉强能抵达，也会因为能源不足而无法返回。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620541
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 760620541,
					"content": "但是生命领域的研究者乌吉恩，他还是驾驶着一艘名为望月者号的飞船，前往了那个坐标。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620542
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 760620542,
					"content": "他疯了？他不打算回来了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620543
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760620543,
					"content": "也许对他来说，能够解读信号的真相就足够了。而且那个距离，也许能够将他的发现传递回来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620544
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 760620544,
					"content": "那之后发生了什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620545
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760620545,
					"content": "他就此失踪在星海之中，龙族也没有接收到任何望月者号传递回来的讯息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620546
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 760620546,
					"content": "…结果还是失败了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620547
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760620547,
					"content": "不，在那之后，又过去了数年时间，直到一天，星空生物捕捉站突然遭到不明物体的撞击。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620548
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 760620548,
					"content": "紧急修理后学者们发现，撞击捕捉站的物体是一艘隐形飞船。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620549
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 760620549,
					"content": "隐形飞船？该不会是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620550
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760620550,
					"content": "嗯…就是不知为何隐藏了身形的…望月者号。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620551
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 760620551,
					"content": "乌吉恩的妻子玛歌率先进入了飞船，但她只在内部发现了一只黑色的球形带刺生物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620552
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 760620552,
					"content": "古月力频谱探测仪显示，那个生物…符合乌吉恩的信息特征。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620553
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 760620553,
					"content": "这、这是怎么回事？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620554
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760620554,
					"content": "玛歌进行了一系列检测，发现她的爱人，正在与某种神秘生物融合。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620555
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 760620555,
					"content": "好可怕！那就是发出信号的神秘星空生物吗？乌吉恩被它吃了？他还有救吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620556
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760620556,
					"content": "很遗憾，龙族学者们从来没见过这种状况，他们束手无策，只能眼睁睁地看着乌吉恩转变为一种全新的生命…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620557
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 760620557,
					"content": "而后，乌吉恩醒来了，他向龙族传递了一个消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620558
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 760620558,
					"content": "什么消息？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760620559
					]
				},
				{
					"id": 760620559,
					"content": "没有关于这方面的内容。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620560
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 760620560,
					"content": "真是的，怎么又缺少了内容？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620561
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760620561,
					"content": "这样看来，乌吉恩也太惨了…他还想捉人家，结果完全是被人家捉了啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620562
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760620562,
					"content": "并不是这样，飞船的日志显示，那个发出信号的生物并没有攻击乌吉恩，反而是他主动与那个生物融合…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620563
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 760620563,
					"content": "如此一来，那个生物才能突破语言的障碍…将消息传递给龙族…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620564
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 760620564,
					"content": "真是令人惊讶的情况…这样看，那则消息或许就是望月者计划的关键内容，我越来越好奇那是什么了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620565
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760620565,
					"content": "看来我们还得去其他地方找找看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760620566
					]
				},
				{
					"id": 760620566,
					"content": "那之后…乌吉恩还活着吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620567
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760620567,
					"content": "在传递消息之后，乌吉恩就开始死去。但玛歌是生命领域的专家，她使用了一种不成熟的技术。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620568
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 760620568,
					"content": "那种技术可以将生命体转化为，纯粹的古月之力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620569
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 760620569,
					"content": "哦！听起来很像龙族的生命燃素化！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620570
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760620570,
					"content": "那她成功了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620571
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760620571,
					"content": "只成功了一半。她挽救了躯体…创造出了月球上第一只非自然诞生的月灵，也就是月灵乌吉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620572
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 760620572,
					"content": "但是乌吉恩的意识，在这个过程中彻底消失了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620573
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 760620573,
					"content": "之后的日子，她将所有精力都投入对这种新生命的研究中，直到寿限到来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620574
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 760620574,
					"content": "然后她拜托学生卢沙里姆对她使用了同样的技术，最终转化为了新生命…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620575
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 760620575,
					"content": "和乌吉恩一样，她的意识也没有保留下来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620576
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 760620576,
					"content": "♪——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620577
					],
					"speakerTitle": "玛歌"
				},
				{
					"id": 760620577,
					"content": "原来这就是你们的故事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620578
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760620578,
					"content": "既然这样，我想那只星空生物向龙族传递的消息，或许被这位卢沙里姆继承了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620579
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760620579,
					"content": "他是否也在某个地方建立了研究设施呢？望月者计划的关键内容应该就保存在那里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620580
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760620580,
					"content": "他的研究设施恐怕已经不存在了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760620581
					]
				},
				{
					"id": 760620581,
					"content": "嗯？你们有过发现吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620582
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760620582,
					"content": "告诉了哥伦比娅关于卢沙里姆、月幕工程和天外降临者的事。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760620583
					]
				},
				{
					"id": 760620583,
					"content": "居然是…被天外而来的降临者毁灭了…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620584
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760620584,
					"content": "我不得不想到…那位高天的主宰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620585
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760620585,
					"content": "我也这么认为。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760620586
					]
				},
				{
					"id": 760620586,
					"content": "能够遮蔽月亮的天幕…听起来又和虚假之天很相似。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620587
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760620587,
					"content": "是哦…感觉就像是虚假之天的幼年期！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620588
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760620588,
					"content": "但是他的研究所已经被毁掉了，也许他自己都消失在那场爆炸里了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620589
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760620589,
					"content": "我有一个猜测，他或许没有死在那场意外里，他的研究也保留了下来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620590
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760620590,
					"content": "欸？为什么这么说？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620591
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760620591,
					"content": "你们看，除了月海以外，龙族的其它设施都没有被摧毁。伊比尼伯龙之眼，乌吉恩圈，星空生物捕捉站。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620592
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760620592,
					"content": "这看起来并不符合那位改造世界的规划。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620593
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760620593,
					"content": "你是说，是卢沙里姆保护了这些？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620594
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760620594,
					"content": "嗯，筹码或许就是他所掌握的研究成果，他带着这些…追随了那位高天的主宰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620595
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760620595,
					"content": "我觉得你说得很有道理！这样看，他后来很可能还在继续望月者计划，会在哪里呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620596
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760620596,
					"content": "我知道月亮上还有一个地方，如果望月者计划仍被保存在某处，也许就会是那里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620597
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760620597,
					"content": "不过…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620598
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760620598,
					"content": "宁宁…你有什么还没告诉我们的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620599
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760620599,
					"content": "…嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620801
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 760620801,
					"content": "你的同类中，只有你在寻找使命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620802
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760620802,
					"content": "对哦，感觉黑蛋的老乡们都很无忧无虑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620803
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760620803,
					"content": "别担心，我不是在强迫你回答。我只是…想更了解你一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620804
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760620804,
					"content": "因为在我们见到的终端中，似乎没有一座记录了你的信息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620805
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760620805,
					"content": "这…我也不知道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620806
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 760620806,
					"content": "没关系，我只是好奇，如果你不想说的话，也可以不说。我们相信你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620807
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760620807,
					"content": "如果我真的有事隐瞒了你们，会怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620808
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 760620808,
					"content": "这也只是…好奇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620809
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 760620809,
					"content": "唔…隐瞒不一定是坏事。这是我从一位朋友那里学到的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620810
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760620810,
					"content": "但如果我生气的话，或许会摘掉送你的小帽子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620811
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760620811,
					"content": "那我也要把留给你的零食丢进月海！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620812
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760620812,
					"content": "我明白了，我可以承诺，对你们没有半点隐瞒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620813
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 760620813,
					"content": "那我相信你的承诺了，宁宁。接下来就请跟我来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620814
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760620814,
					"content": "在月亮的背面，那里有一个基地，我的力量探查到那里非常庞大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620815
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760620815,
					"content": "我本来打算留到最后再处理，因为打扫起来大概会很累。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620816
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760620816,
					"content": "但是现在，清理日程必须要提前了。我有预感，剩下的问题一定都能在那里得到答案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620817
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760620817,
					"content": "谢谢你们，我…需要怎么回报这些？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620818
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 760620818,
					"content": "你看，派蒙，宁宁是不是又变成熟了一些？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620819
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760620819,
					"content": "真的哦…居然谈起回报了！但我们是朋友，不用谈这些啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620820
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760620820,
					"content": "#嗯，这一点，还是{M#他}{F#她}教我的，宁宁你也可以学一学。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620821
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760620821,
					"content": "是我的荣幸。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760620822
					]
				},
				{
					"id": 760620822,
					"content": "所以，准备好了就跟我来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760620527,
					"content": "我也相信你，宁宁。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760620528
					]
				}
			]
		}
	]
