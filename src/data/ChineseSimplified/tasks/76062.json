			"dialogs": [
				{
					"id": 760620101,
					"content": "你们还好吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760620102,
					"content": "玛歌受了一些伤…不过没有危及生命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620103
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760620103,
					"content": "为什么会这样…他们不是一对伴侣吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760620104,
					"content": "是「家庭暴力」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620105
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760620105,
					"content": "你从哪学来的词…总之我们得阻止那家伙…刚才你们看见了吗？乌吉身上是黑色的…和黑蛋一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760620106,
					"content": "但是他个头却有那么大，不会是因为吃了很多其它黑蛋吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760620107,
					"content": "派蒙…你等等我…等我长到他那么大的时候就来回答你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620108
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 760620108,
					"content": "可恶…好吧，那现在怎么办？乌吉已经回来了，我们要先撤回去，等下一次机会吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760620109,
					"content": "来不及了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760620110
					]
				},
				{
					"id": 760620110,
					"content": "嗯…古月风暴已经逼近了乌吉恩圈，那里还有很多小生灵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620111
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760620111,
					"content": "你照顾玛歌，我们去拿古月之源。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760620112
					]
				},
				{
					"id": 760620112,
					"content": "好，但小心一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620113
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760620113,
					"content": "我需要时间治疗玛歌，拜托你吸引乌吉的注意，坚持到我来就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620114
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760620114,
					"content": "月海里生活着一些小型的群游月灵，我也会让它们帮助你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620115
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760620115,
					"content": "好！交给我们吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760620116,
					"content": "我也来…帮忙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "黑蛋"
				}
			]
		},
