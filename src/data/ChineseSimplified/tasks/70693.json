			"dialogs": [
				{
					"id": 706930101,
					"content": "所以说呀，我们都看出来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706930102
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 706930102,
					"content": "优菈最讨厌的应该是那种…死板和迂腐写在眉毛之间，一股劲儿钻牛角尖，只知道在流程和细节上卡人的家伙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706930103
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 706930103,
					"content": "说不定，脸上还戴着单片眼镜，手里时常拿着一本书，但自己并没有完全读透，只是把它当成了装饰品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706930104
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 706930104,
					"content": "如此一来，就显得自己有股「老学派」的气质，好像对话刚开始，就能在气势上压人一头！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706930105
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 706930105,
					"content": "啊，实在太精准了，我的脑袋里都有画面了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706930106
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 706930106,
					"content": "烟绯和…安柏？是之前完全没见过的组合！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706930107,
						706930108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706930107,
					"content": "这是在聊什么呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706930109
					]
				},
				{
					"id": 706930109,
					"content": "啊呀，荣誉骑士和派蒙，你们来啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706930110
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 706930110,
					"content": "我正和烟绯商量方案呢，要不要给我们的游艺加几个「坏家伙雪人」，当成彩蛋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706930111
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 706930111,
					"content": "就像是魔物的靶子吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706930112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706930112,
					"content": "除了反派专业户魔物，也可以有些不那么传统的形象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706930113
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 706930113,
					"content": "在选角的方向上，我和烟绯不谋而合的点子太多了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706930114,
						706930115
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 706930114,
					"content": "在这里看到烟绯，有些惊喜。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706930116
					]
				},
				{
					"id": 706930116,
					"content": "说起来也挺神奇的，你们真的站在一起的时候，我才发现，你们一看就很合得来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706930117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706930117,
					"content": "#确实，能在蒙德遇见{NICKNAME}和派蒙，我也非常意外！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706930118
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 706930118,
					"content": "其实哦，我也不是第一次来蒙德了，之前在这边帮忙处理过不少民事诉讼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706930119
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 706930119,
					"content": "这回，我刚和瑶瑶忙完，就碰上了「龙脊雪山国际越野赛」开幕，正好来看点新鲜的场面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706930120
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 706930120,
					"content": "结果，到会场问路时，我遇见了安柏，和安柏聊得很投缘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706930121
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 706930121,
					"content": "于是就来体验一下安柏管理的游戏，也帮忙出出主意！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706930122
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 706930122,
					"content": "嘿嘿，优菈的朋友，也是我的朋友，有趣的游戏，当然要一起享受啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706930123
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 706930123,
					"content": "荣誉骑士和派蒙也来试试吧？为各国客人放松心情，施放压力的小游戏「飞玉趣掷」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706930124
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 706930124,
					"content": "嗯！练习一下打雪仗的本领，说不定以后能派上用场！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706930125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706930125,
					"content": "#而且，我和{NICKNAME}无聊的时候也可以玩，比一比谁更厉害，输了的负责做饭！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706930126,
						706930127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706930126,
					"content": "那我可不能错过。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706930128
					]
				},
				{
					"id": 706930128,
					"content": "投雪球，和扔火球…以至于各种元素的投掷物，都有共通之处。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706930129
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 706930129,
					"content": "对于你这位武艺天才来说，肯定不在话下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "烟绯"
				},
				{
					"id": 706930127,
					"content": "我丢雪球还蛮准的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706930128
					]
				},
				{
					"id": 706930115,
					"content": "以前没想过你们碰面的场景。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706930116
					]
				},
				{
					"id": 706930108,
					"content": "优菈讨厌的家伙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706930109
					]
				}
			]
		}
	]
}