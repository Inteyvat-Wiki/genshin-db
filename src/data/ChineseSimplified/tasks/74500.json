			"dialogs": [
				{
					"id": 745000101,
					"content": "真讨厌啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000102
					],
					"speakerTitle": "阿尔邦"
				},
				{
					"id": 745000102,
					"content": "就是，太讨厌了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000103
					],
					"speakerTitle": "阿尔贝"
				},
				{
					"id": 745000103,
					"content": "这岂不是芙宁娜大人坐审判桌？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000104
					],
					"speakerTitle": "阿尔邦"
				},
				{
					"id": 745000104,
					"content": "一点都没错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000105
					],
					"speakerTitle": "阿尔贝"
				},
				{
					"id": 745000105,
					"content": "芙宁娜大人坐审判桌？那是什么意思呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000106,
					"content": "哦！来客人了，看打扮，两位老爷是外地人吧？听不懂枫丹俗语很正常，且听小人问一句，审判桌该是给谁坐的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000107
					],
					"speakerTitle": "阿尔邦"
				},
				{
					"id": 745000107,
					"content": "当然是审判官大人咯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000108
					],
					"speakerTitle": "阿尔贝"
				},
				{
					"id": 745000108,
					"content": "那咱们的最高审判官是谁呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000109
					],
					"speakerTitle": "阿尔邦"
				},
				{
					"id": 745000109,
					"content": "当然是那维莱特大人咯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000110
					],
					"speakerTitle": "阿尔贝"
				},
				{
					"id": 745000110,
					"content": "哎呀，那维莱特大人的位置，怎么被水神芙宁娜大人坐了去啊？两位老爷，这让堂下被审判的可怜人该作何感想啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000111
					],
					"speakerTitle": "阿尔邦"
				},
				{
					"id": 745000111,
					"content": "要是我绝对会感到被欺骗了啊，水神大人哪里懂审判嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000112
					],
					"speakerTitle": "阿尔贝"
				},
				{
					"id": 745000112,
					"content": "呃…这样说，好像有种挂羊头卖狗肉的感觉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000113,
					"content": "一点都没错！挂羊头卖狗肉，就是这个意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000114
					],
					"speakerTitle": "阿尔贝"
				},
				{
					"id": 745000114,
					"content": "原来那句话是这个意思啊。欸？！等等，你们拿自己的神明这样开玩笑没关系吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000115,
					"content": "当然有关系啊，水神大人最喜欢这样的玩笑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000116
					],
					"speakerTitle": "阿尔邦"
				},
				{
					"id": 745000116,
					"content": "如果被她听见，一定会把小人绑上石头沉入深湖，然后兴致勃勃地在旁边观赏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000117
					],
					"speakerTitle": "阿尔邦"
				},
				{
					"id": 745000117,
					"content": "但两位老爷，你们猜怎么着，原来阿尔邦这下人的嘴皮子太油滑，最后根本沉不下去嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000118
					],
					"speakerTitle": "阿尔贝"
				},
				{
					"id": 745000118,
					"content": "「得救了！」水神大人肯定会激动地鼓起掌，兴许还会流下几滴眼泪，「真是太浪漫了！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000119
					],
					"speakerTitle": "阿尔贝"
				},
				{
					"id": 745000119,
					"content": "搞不好还给小人颁发「枫丹浪漫市民」的勋章呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000120,
						745000121
					],
					"speakerTitle": "阿尔邦"
				},
				{
					"id": 745000120,
					"content": "真是太浪漫了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745000122
					]
				},
				{
					"id": 745000122,
					"content": "我、我有点不知道该说什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000123,
					"content": "那么言归正传，两位老爷今天来小店有什么需要呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000124
					],
					"speakerTitle": "阿尔邦"
				},
				{
					"id": 745000124,
					"content": "话说回来，阿尔邦，你有没有觉得两位老爷的打扮…有点像是老板之前交代的著名冒险家啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000125
					],
					"speakerTitle": "阿尔贝"
				},
				{
					"id": 745000125,
					"content": "#哦！确实有点，如同金子和银子般耀眼的头发…哦哦哦哦——所以两位老爷是…{NICKNAME}{M#先生}{F#女士}，和派蒙女士？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000126
					],
					"speakerTitle": "阿尔邦"
				},
				{
					"id": 745000126,
					"content": "呜哇，你们认识我们吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000127,
					"content": "老板先前在冒险家协会打听了最近在枫丹活动的冒险家，协会告知了两位老爷的信息，言称是一对十分厉害的搭档。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000128
					],
					"speakerTitle": "阿尔邦"
				},
				{
					"id": 745000128,
					"content": "#嘿嘿，{NICKNAME}{M#先生}{F#女士}，看来我们名气越来越大了呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000129,
						745000131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000129,
					"content": "派蒙，你是托我的福。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745000130
					]
				},
				{
					"id": 745000130,
					"content": "哼，就算是这样，你也可以谦虚点嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000133,
					"content": "所以说，两位小哥，你们老板找我们有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000134,
					"content": "真不凑巧，老板他现在不在店里，就先由我们来讲讲吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000135
					],
					"speakerTitle": "阿尔邦"
				},
				{
					"id": 745000135,
					"content": "那就简单讲两句。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000136
					],
					"speakerTitle": "阿尔贝"
				},
				{
					"id": 745000136,
					"content": "一句话来说，老板的「决斗代理人企划」想请两位老爷来帮忙收集数据。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000137
					],
					"speakerTitle": "阿尔邦"
				},
				{
					"id": 745000137,
					"content": "「决斗代理人企划」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000138
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000138,
					"content": "就是以决斗代理人为故事主角、为研发重心、为宣传方向的一项全新发条玩具企划。哦，小店是买卖玩具的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000139
					],
					"speakerTitle": "阿尔邦"
				},
				{
					"id": 745000139,
					"content": "说起来，两位老爷听过「决斗代理人」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000140,
						745000141
					],
					"speakerTitle": "阿尔邦"
				},
				{
					"id": 745000140,
					"content": "我知道，请继续讲。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745000145
					]
				},
				{
					"id": 745000145,
					"content": "老板认为这是一个绝佳的枫丹文化符号，如果制作一款这个题材的玩具，说不定能够大火。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000146
					],
					"speakerTitle": "阿尔邦"
				},
				{
					"id": 745000146,
					"content": "万一火到了其他国家，还能提升国民荣誉感，一举两得！芙宁娜大人直接给我们发勋章！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000147
					],
					"speakerTitle": "阿尔贝"
				},
				{
					"id": 745000147,
					"content": "原来是这样…可是你们要做「决斗代理人」玩具，找我们冒险家干嘛呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000148
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000148,
					"content": "研发嘛，总需要一些数据来支撑。「决斗代理人」的强大，是通过深入各种危险的地方锤炼武艺得来的，拿到他们的数据可不简单。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000149
					],
					"speakerTitle": "阿尔邦"
				},
				{
					"id": 745000149,
					"content": "但是听说冒险家中的厉害角色，也会干类似的事，不如就请冒险家来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000150
					],
					"speakerTitle": "阿尔贝"
				},
				{
					"id": 745000150,
					"content": "啊！我好像有点听明白了…打着「决斗代理人」旗号的玩具，却让冒险家来提供数据，是这样吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000151,
						745000152
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000151,
					"content": "挂羊头卖狗肉！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745000153
					]
				},
				{
					"id": 745000153,
					"content": "哪有到那个地步嘛，顶多就是移朵海露花，接棵悬铃木。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000154
					],
					"speakerTitle": "阿尔邦"
				},
				{
					"id": 745000154,
					"content": "偷根木房梁，换条大石柱！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000155
					],
					"speakerTitle": "阿尔贝"
				},
				{
					"id": 745000155,
					"content": "那不都是差不多的意思嘛，明明你们自己一开始都在讨论，我们都听见啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000156
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000156,
					"content": "噢——那个啊，那是在说隔壁的隔壁的那家勒波特钟表店，他们可比我们过分多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000157
					],
					"speakerTitle": "阿尔邦"
				},
				{
					"id": 745000157,
					"content": "明明招牌写着钟表店，却偷偷卖起了玩具，大家说说，这像话吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000158
					],
					"speakerTitle": "阿尔邦"
				},
				{
					"id": 745000158,
					"content": "太不像话了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000159
					],
					"speakerTitle": "阿尔贝"
				},
				{
					"id": 745000159,
					"content": "钟表店卖玩具？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000160
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000160,
					"content": "对啊，您不觉得这很可恶吗？不如拿您来说好了，请问您最中意的是什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000161
					],
					"speakerTitle": "阿尔邦"
				},
				{
					"id": 745000161,
					"content": "#我最中意的…？那当然、那当然是我最好的伙伴{NICKNAME}啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000162
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000162,
					"content": "#那假如有一家店名叫「{NICKNAME}玩偶商店」，结果您跋山涉水跑去一看，发现店里卖的根本不是{NICKNAME}玩偶，只有一大堆阿尔邦玩偶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000163
					],
					"speakerTitle": "阿尔邦"
				},
				{
					"id": 745000163,
					"content": "一想到买到好伙伴的期待落空，是不是气从心来，大哭大闹，想要一拳把老板打飞？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000164
					],
					"speakerTitle": "阿尔邦"
				},
				{
					"id": 745000164,
					"content": "太生气啦！谁要买阿尔邦玩偶啦！是我就一拳把老板打进梅洛彼得堡啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000165
					],
					"speakerTitle": "阿尔贝"
				},
				{
					"id": 745000165,
					"content": "#啊呀呀，被你们这样一说，好像确实有点生气…怎么办，{NICKNAME}，我可不想你的玩偶突然就买不到了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000166,
						745000167
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000166,
					"content": "等等，他们是在偷换概念。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745000168
					]
				},
				{
					"id": 745000168,
					"content": "对哦！我差点被你们绕进去了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000169
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000169,
					"content": "哎呀，只是个比喻而已，比喻难免有点失真…而且我说的那种情况也不是没有，晶螺糕里不就没有晶螺吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000170
					],
					"speakerTitle": "阿尔邦"
				},
				{
					"id": 745000170,
					"content": "就是，这种事肯定会越来越多，钟表店不卖钟表迟早也会发生。除非改名成勒波特玩具工坊，否则绝不原谅他们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000171
					],
					"speakerTitle": "阿尔贝"
				},
				{
					"id": 745000171,
					"content": "这次又在预设立场了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745000172
					]
				},
				{
					"id": 745000172,
					"content": "你们可真是歪理大王！再聊这些肯定被越绕越远，还是说正事啦，我们要怎么帮你们收集数据呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000173
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000173,
					"content": "这个嘛，其实在这之前，还有一件小事想要拜托两位：能否移步隔壁的隔壁，去勒波特钟表店帮我们打探一下消息？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000174
					],
					"speakerTitle": "阿尔邦"
				},
				{
					"id": 745000174,
					"content": "虽说本业是发条钟表，但新品玩具却很热门，人气都被吸跑了。据说那玩具是他们老板在蒙德得到的灵感，真想知道是什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000175
					],
					"speakerTitle": "阿尔邦"
				},
				{
					"id": 745000175,
					"content": "搞不好是什么炼金术玩具呢，散发着比日落果还要甜蜜四倍的气味，让附近的人一下着迷，听说蒙德有这样的炼金术大师对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000176
					],
					"speakerTitle": "阿尔贝"
				},
				{
					"id": 745000176,
					"content": "四倍甜日落果？那不会是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000177
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000177,
					"content": "所以，请两位老爷帮我们去打听一下那个玩具，老板很在乎这个。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000178
					],
					"speakerTitle": "阿尔邦"
				},
				{
					"id": 745000178,
					"content": "你们为什么不自己去看？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745000179
					]
				},
				{
					"id": 745000179,
					"content": "老爷，生意人哪有不要面子的嘛，哪能这么光明正大地过去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000180
					],
					"speakerTitle": "阿尔邦"
				},
				{
					"id": 745000180,
					"content": "是面子啊！面子大过天！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000181
					],
					"speakerTitle": "阿尔贝"
				},
				{
					"id": 745000181,
					"content": "刚好两位老爷登门的事，我得去跟老板汇报下，所以这件事求您帮帮忙啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000182
					],
					"speakerTitle": "阿尔邦"
				},
				{
					"id": 745000182,
					"content": "#{NICKNAME}，这么说我也有点好奇，从蒙德得到灵感的枫丹玩具长什么样呢，难道真的和炼金术有关系？要不我们先去看看吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000183
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000183,
					"content": "真是太感谢了，我们就在这等着两位凯旋！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿尔邦"
				},
				{
					"id": 745000167,
					"content": "人家是多卖东西，不是少卖东西。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745000168
					]
				},
				{
					"id": 745000152,
					"content": "芙宁娜大人坐审判桌！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745000153
					]
				},
				{
					"id": 745000141,
					"content": "没听过，能解释下吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745000142
					]
				},
				{
					"id": 745000142,
					"content": "那是枫丹的一种特殊制度，假如您犯了什么事，面临审判时，您可以申请与「决斗代理人」进行「决斗」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000143
					],
					"speakerTitle": "阿尔邦"
				},
				{
					"id": 745000143,
					"content": "若是战胜了「决斗代理人」，您就能摆脱罪名，维护自己的名誉，无需再被审判。当然，想战胜「决斗代理人」可不是什么轻松的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000144
					],
					"speakerTitle": "阿尔邦"
				},
				{
					"id": 745000144,
					"content": "肯定比卖玩具难。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000145
					],
					"speakerTitle": "阿尔贝"
				},
				{
					"id": 745000131,
					"content": "派蒙女士，我是托您的福。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745000132
					]
				},
				{
					"id": 745000132,
					"content": "嘿嘿嘿，你说话也越来越好听了哦，以后我的福气都分你一份。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000121,
					"content": "这就是枫丹人的浪漫吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745000122
					]
				}
			]
		},
		{
			"id": 7450002,
