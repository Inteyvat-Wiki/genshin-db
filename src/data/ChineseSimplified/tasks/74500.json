					"卡隆"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							3627.395,
							446.263,
							4474.6
						],
						"pointId": 340100067
					},
					{
						"sceneId": 3,
						"position": [
							3627.172,
							446.167,
							4477.734
						],
						"pointId": 340100123
					},
					{
						"sceneId": 3,
						"position": [
							3556.893,
							446.167,
							4435.611
						],
						"pointId": 340100226
					}
				]
			},
			"dialogs": [
				{
					"id": 745000201,
					"content": "两位客人你们好啊，我是小店店主卡隆，请问有什么需要吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000202
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745000202,
					"content": "卡隆老板你好，我们听说这里有一个超级厉害的玩具，想要来了解一下啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000203,
					"content": "呵呵，当然可以，不过…两位是大哥请来打探情报的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000204
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745000204,
					"content": "欸？大哥？不对不对…你怎么一下就知道我们是来打探情报的？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000205,
					"content": "我刚才看到，你们从发条工坊那边过来，那家店的店主是我大哥，所以我立刻就知道怎么回事了，这完全是他会做的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000206
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745000206,
					"content": "怎么…一下就露馅了，这算什么，出师未捷什么来着…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000207,
					"content": "哎呀，我们应该做更多准备再来的，谁知道你们是兄弟啊，原本以为是同行相争，没想到是…是…是手足相残！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000208,
					"content": "派蒙，不要乱用词语。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745000209
					]
				},
				{
					"id": 745000209,
					"content": "不好意思老板…我卡脑壳了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000210,
					"content": "别在意，再好的玩具，零件偶尔也会卡住，人也是一样，所以要好好保养。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000211
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745000211,
					"content": "而且…在大哥眼里，我们大概就是那种情况吧。算了，不说这个耽误两位时间了，我来介绍一下玩具吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000212
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745000212,
					"content": "欸，老板不介意吗？我们…我们可算是商业间谍哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000213,
					"content": "哈哈，商业间谍，客人真有意思，小店真正的商品是那些钟表，是祖上传下来的手艺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000214
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745000214,
					"content": "但玩具只是我个人的爱好，这是带来快乐的东西，让更多人知道，不就相当于把快乐传递到更远的地方吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000215
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745000215,
					"content": "哇，老板的说法很温柔呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000216,
					"content": "哈哈，如果是我大哥，他一定会说这是缺乏冒险精神…言归正传，两位不如试试玩具吧，希望你们喜欢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000217
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745000217,
					"content": "我听说老板是在蒙德得到的灵感？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745000218
					]
				},
				{
					"id": 745000218,
					"content": "没错，我从小就向往蒙德，直到前段时间有机会过去旅游，果然收获不少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000219
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745000219,
					"content": "我把在蒙德遇见的一位冒险家的故事融入了里面。不过两位也不要有太高期待，说到底它也只是个简单的发条玩具而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000220
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745000220,
					"content": "冒险家？原来不是什么炼金术玩具啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000221,
					"content": "炼金术玩具？听起来很有意思。不过这位冒险家，也是一位让人印象深刻的朋友，有机会我再好好讲讲他的故事吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000222
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745000222,
					"content": "现在两位不如先试试这个玩具？说一千句不如亲手试一局。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000223
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745000223,
					"content": "#虽然很想，但是那边还等着我们回复呢，{NICKNAME}，要不我们快去快回吧！好想立刻体验到这个冒险家玩具！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000224,
					"content": "那也好，小店随时欢迎二位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡隆"
				}
			]
		},
