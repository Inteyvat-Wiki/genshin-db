			"dialogs": [
				{
					"id": 745000501,
					"content": "我得去和老板说一下，他请来的两位老爷上门了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000502
					],
					"speakerTitle": "阿尔邦"
				},
				{
					"id": 745000502,
					"content": "快点去快点回啦，我一个人看店会很无聊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿尔贝"
				}
			]
		},
		{
