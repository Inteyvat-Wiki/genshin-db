						"position": [
							3557.77,
							446.167,
							4435.818
						],
						"pointId": 340100225
					},
					{
						"sceneId": 3,
						"position": [
							3556.893,
							446.167,
							4435.611
						],
						"pointId": 340100226
					}
				]
			},
			"dialogs": [
				{
					"id": 745000301,
					"content": "老板，两位老爷回来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000302
					],
					"speakerTitle": "阿尔邦"
				},
				{
					"id": 745000302,
					"content": "不愧是冒险家协会大力推荐的人，二位办事果然迅速。我是店主利弗，欢迎欢迎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000303
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745000303,
					"content": "利弗老板，你好你好，原来那边的卡隆老板和你是兄弟啊，我们都不知道这个事，一下就被他认出来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000304,
					"content": "阿尔贝，你怎么回事？这么重要的事情都忘记和贵客交代了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000305
					],
					"speakerTitle": "阿尔邦"
				},
				{
					"id": 745000305,
					"content": "好你个阿尔邦！不是说你来说的吗？老板你要扣就扣这家伙的工资。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000306
					],
					"speakerTitle": "阿尔贝"
				},
				{
					"id": 745000306,
					"content": "喂，你们俩不会也是兄弟吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000307,
					"content": "我没有这样的兄弟！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000308
					],
					"speakerTitle": "阿尔邦"
				},
				{
					"id": 745000308,
					"content": "咳咳…两位的意思是…任务失败了？什么也没打探到？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000309
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745000309,
					"content": "没有没有，卡隆老板是个很温柔的人，即使知道了也不介意，还欢迎我们随时去试玩呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000310,
					"content": "呵呵，那小子…所以那真是炼金术玩具？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000311
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745000311,
					"content": "不是，是一个冒险家玩具。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745000312
					]
				},
				{
					"id": 745000312,
					"content": "哼，原来还是老掉牙的冒险家玩具。他是不是还说，把什么冒险家的故事融入了里面？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000313
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745000313,
					"content": "对对对，老板你怎么知道？你不会已经偷偷调查过吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000314,
					"content": "那小子我太了解了，他总是把一些感性的东西放进玩具里，一点都不考虑市场。冒险家故事已经不适合这个时代了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000315
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745000315,
					"content": "可是他们店人气很旺。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745000316
					]
				},
				{
					"id": 745000316,
					"content": "正常的经营波动而已，等我们的「决斗代理人」企划完成，绝对会打得他们人仰马翻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000317
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745000317,
					"content": "又不是真的「决斗代理人」，是我们这种「过时」的冒险家假扮的啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000318,
					"content": "这就是两位不懂了，这叫包装，市场就吃这套，没人管你们到底怎么做的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000319
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745000319,
					"content": "只要拿到数据，再把它放进一些热门的玩具原型，再宣称这是一段关于「决斗代理人」成长的故事，事情就成了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000320
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745000320,
					"content": "就这样吗？总觉得这种故事会有问题…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000321
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000321,
					"content": "故事有问题不重要，有噱头就可以了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000332
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745000332,
					"content": "如果我说，阿尔邦和阿尔贝其实就是以「双人喜剧」为题材制作的仿真玩具魔偶，您怎么想？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000322
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745000322,
					"content": "什么？！玩具魔偶？！真的…真的有这么逼真的玩具魔偶吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000323,
					"content": "当然，就是这么逼真。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000324
					],
					"speakerTitle": "阿尔邦"
				},
				{
					"id": 745000324,
					"content": "「双人喜剧」的世界，骗人也能骗得这么逼真哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000325
					],
					"speakerTitle": "阿尔贝"
				},
				{
					"id": 745000325,
					"content": "看到了吧？这就是包装的力量，即使是噱头，但只要这样说了，就会有人产生兴趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000326
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745000326,
					"content": "呜哇！原来是骗人的，你也太狡猾了吧…跟你弟弟之间的差别真大！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000327
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000327,
					"content": "那小子不好好经营自己的发条钟表，非要插手玩具这个行当，我这个当大哥的，当然要好好教育他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000328,
						745000329
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745000328,
					"content": "你确实有一手啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745000330
					]
				},
				{
					"id": 745000330,
					"content": "承蒙夸奖。那么，接下来就请二位贵客多多上心了，数据收集的事，由阿尔邦和阿尔贝具体负责。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000331
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745000331,
					"content": "哼哼，你们的兄弟之争我们才管不着啦，不要少了我们的摩拉哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000329,
					"content": "果然是无奸不商。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745000330
					]
				}
			]
		},
