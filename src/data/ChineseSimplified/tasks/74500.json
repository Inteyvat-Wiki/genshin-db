			},
			"dialogs": [
				{
					"id": 745000401,
					"content": "两位客人你们好啊，我是小店店主卡隆，请问有什么需要吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000402
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745000402,
					"content": "老板你们这里好多人哦，是在办什么活动吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000403,
					"content": "呵呵，算不上什么活动，只是小店最近新推出了一款新品玩具。就是店门口那个。两位如果有兴趣，可以随时过来体验。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡隆"
				}
			]
		},
		{
