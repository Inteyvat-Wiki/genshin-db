				"points": []
			},
			"dialogs": [
				{
					"id": 705170101,
					"content": "这一带看起来很普通呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705170102,
					"content": "好像找不到什么吃的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170103,
						705170104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705170103,
					"content": "说漏嘴了，派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705170105
					]
				},
				{
					"id": 705170105,
					"content": "咳咳，调查秘密的过程中也是要吃东西的，这是人之常情嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705170106,
					"content": "再说了，最近我们图省事，吃了好多好多烧烤，你也有点腻了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705170107,
					"content": "如果我们能在沙滩上捡到贝壳或海螺，就把它们和水果一起炖着吃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705170108,
					"content": "鲜鲜的，甜甜的，弹弹的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170109,
						705170111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705170109,
					"content": "听起来好黑暗，我才不要。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705170110
					]
				},
				{
					"id": 705170110,
					"content": "试试看嘛，说不定会打开新世界的大门！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705170113,
					"content": "#等等，{NICKNAME}，你看那边。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705170114,
					"content": "突然出现的机关…好像有蹊跷？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705170115,
					"content": "附近还有一些行李货物，是愚人众的东西吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705170116,
					"content": "还真被派蒙说中了，好耶。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705170117
					]
				},
				{
					"id": 705170117,
					"content": "我的预感果然很靠谱，好耶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705170118,
					"content": "什么好耶，呸呸呸！明明是我们有麻烦了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705170119,
					"content": "既然是和愚人众有关的东西，出现在这里，就很可能有阴谋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705170120,
					"content": "如果放着它们不管，说不定又会不停发展，变得很难办。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705170121,
					"content": "总之，先试着处理那个机关吧？如果你觉得有必要，再调查一下愚人众的货物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705170122,
					"content": "#{NICKNAME}，拿出以前的干劲，搞定它们以后，我们就能安心找食材了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705170111,
					"content": "听起来是派蒙会有的口感。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705170112
					]
				},
				{
					"id": 705170112,
					"content": "喂！人家可不是水产！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705170104,
					"content": "难怪你这么积极。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705170105
					]
				}
			]
		}
	]
}