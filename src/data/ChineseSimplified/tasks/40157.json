			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"鹿野院平藏"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-3615.737,
							201.872,
							-906.978
						],
						"pointId": 321000267
					}
				]
			},
			"dialogs": [
				{
					"id": 401570501,
					"content": "#哎呀呀！{NICKNAME}，派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570502
					],
					"speakerTitle": "鹿野院平藏"
				},
				{
					"id": 401570502,
					"content": "呜哇！是阿忍！还有平藏！你居然也来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401570503,
					"content": "真是意外又不那么意外之喜啊。我刚才还在和阿忍小姐说，感觉马上就会遇到你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570504
					],
					"speakerTitle": "鹿野院平藏"
				},
				{
					"id": 401570504,
					"content": "呵呵，鹿野院同心刚才一路提到你们好几次。这就叫念念不忘，必有回响吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570505
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 401570505,
					"content": "是直觉啦，直觉。我习惯在关键的时候想到关键的人呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570506
					],
					"speakerTitle": "鹿野院平藏"
				},
				{
					"id": 401570506,
					"content": "很高兴见到你们。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401570507
					]
				},
				{
					"id": 401570507,
					"content": "真没想到，平藏居然是我们之外第一个到的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401570508,
					"content": "老大叮嘱了我，给天领奉行的邀请函要尽快，他特别邀请了九条裟罗大人和鹿野院同心两位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570509
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 401570509,
					"content": "那…那裟罗怎么没来呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570510
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401570510,
					"content": "肯定是因为她完全不想见到一斗老兄吧，毕竟邀请函上最后写着：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570511
					],
					"speakerTitle": "鹿野院平藏"
				},
				{
					"id": 401570511,
					"content": "「九条天狗！跟本大爷在珊瑚宫之巅来一场热血燃情摇滚相扑吧！！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570512
					],
					"speakerTitle": "鹿野院平藏"
				},
				{
					"id": 401570512,
					"content": "如果我是九条裟罗大人，一定想要把老大从珊瑚宫顶上推下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570513
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 401570513,
					"content": "然后心海会把裟罗也推下去吧？在她头顶上叮呤哐啷的简直吵死了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570514
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401570514,
					"content": "哈哈哈，总之，我觉得九条裟罗大人脾气还是太好了点，她还给我们送了一筐堇瓜作为贺礼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570515
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 401570515,
					"content": "脾气好吗？嘿嘿，我怎么觉得，那个女人另有深意呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570516
					],
					"speakerTitle": "鹿野院平藏"
				},
				{
					"id": 401570516,
					"content": "什么深意啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570517
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401570517,
					"content": "「荒泷小鬼跟我一斗？奉行之所堇瓜管够。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570518
					],
					"speakerTitle": "鹿野院平藏"
				},
				{
					"id": 401570518,
					"content": "什么嘛，平藏，你也太有心眼了吧！我看你们带来了两筐堇瓜，另一筐是不是你送的？是不是也另有深意？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570519
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401570519,
					"content": "哈哈，另一筐是奉行所里的大家凑的啦。有我，有抓过一斗老兄的其它同心，还有一斗老兄的一些狱友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570520
					],
					"speakerTitle": "鹿野院平藏"
				},
				{
					"id": 401570520,
					"content": "所以这筐堇瓜的祝福大概就是「要常来找我们玩哦！」的意思吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570521
					],
					"speakerTitle": "鹿野院平藏"
				},
				{
					"id": 401570521,
					"content": "这种祝福还是不要让老大听见为好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570522
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 401570522,
					"content": "嗯，送到了堇瓜，还见到了想见的人，我也差不多该要先走一步了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570523
					],
					"speakerTitle": "鹿野院平藏"
				},
				{
					"id": 401570523,
					"content": "咦？平藏不参加活动了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570524
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401570524,
					"content": "放心，我不会错过最后的庆典，只是现在还要去离岛办点事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570525
					],
					"speakerTitle": "鹿野院平藏"
				},
				{
					"id": 401570525,
					"content": "还要去离岛啊，当侦探真忙…欸对了！平藏听过战场中的忍犬吗？好像就是在离岛流传起来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570526
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401570526,
					"content": "噢…那只狗啊。是不是这次音乐节的灵感来源？阿忍小姐倒是有跟我介绍过主题和故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570527
					],
					"speakerTitle": "鹿野院平藏"
				},
				{
					"id": 401570527,
					"content": "好吧，我以为奉行所会知道什么内情呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570528
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401570528,
					"content": "但按经验…我猜这只是个乡野传说，根本没有什么狗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570529
					],
					"speakerTitle": "鹿野院平藏"
				},
				{
					"id": 401570529,
					"content": "#怎么？{NICKNAME}，看你的表情，好像有点在意？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570530
					],
					"speakerTitle": "鹿野院平藏"
				},
				{
					"id": 401570530,
					"content": "有意思…不如我顺便打听打听吧，反正我要去趟离岛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570531,
						401570532
					],
					"speakerTitle": "鹿野院平藏"
				},
				{
					"id": 401570531,
					"content": "会不会影响你办事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401570533
					]
				},
				{
					"id": 401570533,
					"content": "这种话就太客气了。你在意的东西，我通常都很感兴趣哦。",
