				]
			},
			"dialogs": [
				{
					"id": 716663101,
					"content": "呼啊…还好没有失误！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716663102,
					"content": "吓，吓死我了！还…还挺生猛的，换我也不好对付！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663103
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 716663103,
					"content": "璃月的斗虫强者都是无师自通的鬼才吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663104
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 716663104,
					"content": "原来鬼兜虫之间，是这么一起玩的吗？畅畅完全明白了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663105
					],
					"speakerTitle": "「恐怖猫爪草」"
				},
				{
					"id": 716663105,
					"content": "你们有时间的话，可以和畅畅再玩几局嘛？我也会继续看你们一起玩，好好学一学的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663106
					],
					"speakerTitle": "「恐怖猫爪草」"
				},
				{
					"id": 716663106,
					"content": "看来…「恐怖猫爪草」的天分，确实很恐怖！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716663107,
					"content": "要是放牛的有这种天分，说不定只是听着锅巴和「水晶岛梆梆旋风」交流，就能明白甲壳生物的交流方式呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716663108,
					"content": "哈…哈哈哈…我也希望自己有那么强啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "荒泷一斗"
				}
			]
		},
