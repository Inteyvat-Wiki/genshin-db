					"content": "请收下这本曲谱集吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840202
					],
					"speakerTitle": "莎莎"
				},
				{
					"id": 706840202,
					"content": "（收下曲谱集。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706840203
					]
				},
				{
					"id": 706840203,
					"content": "想要试用不同乐器随时来找我。",
					"roleType": "TALK_ROLE_NPC",
