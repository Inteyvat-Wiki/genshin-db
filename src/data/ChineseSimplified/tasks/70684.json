				]
			},
			"dialogs": [
				{
					"id": 706840101,
					"content": "大、大家好！我、我…我是正在努力成为吟游诗人的莎莎。非、非常感谢大家来看我的演出，那么现在我要…我要开始演奏了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840102
					],
					"speakerTitle": "莎莎"
				},
				{
					"id": 706840102,
					"content": "「在摘星崖的山顶，一切皆已沉静。在一切树梢之顶…」一切…不，不对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840103
					],
					"speakerTitle": "莎莎"
				},
				{
					"id": 706840103,
					"content": "「在一切树梢之顶，不闻群风。也不见，不见小鸟的身影…」记得接下来应该是…勿…「勿要匆匆前行…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840104
					],
					"speakerTitle": "莎莎"
				},
				{
					"id": 706840104,
					"content": "真是不好意思，这次发挥得不太好…明明第四十二次和第九十次都没有口吃，可以流畅地念出来的，到底是哪里不对呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840105
					],
					"speakerTitle": "莎莎"
				},
				{
					"id": 706840105,
					"content": "第四十二次和第九十次…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706840106,
					"content": "嗯！为了给大家带来最完美的演出，这首曲子我已经练习过一百次了，刚才是第一百零一次，也是第一次正式演出…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840107
					],
					"speakerTitle": "莎莎"
				},
				{
					"id": 706840107,
					"content": "唉，本以为这次能成功，结果还是搞砸了，是准备得还不够吧…得对比一下第四十二次和第九十次的情况，加大练习量才行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840108,
						706840109
					],
					"speakerTitle": "莎莎"
				},
				{
					"id": 706840108,
					"content": "练习一百次已经够多了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706840110
					]
				},
				{
					"id": 706840110,
					"content": "对、对呀！你都练习过那么多次了，按理说不应该是刚才那样的表现…唔，说不定是练习的方法出了问题！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706840111,
					"content": "#说起来{NICKNAME}也懂演奏，不如你先讲讲你的练习方法，说不定{NICKNAME}能给你一些建议呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840112,
						706840113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706840112,
					"content": "哪里哪里，略懂一二。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706840114
					]
				},
				{
					"id": 706840114,
					"content": "至于我嘛…我是专业的观众！可以给出很专业的观众视角的建议！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706840115,
					"content": "呜…你们人真好，居然愿意帮助我这样的人。稍等一下！我看看之前的笔记…不，还是直接把笔记给你们看更快吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840116
					],
					"speakerTitle": "莎莎"
				},
				{
					"id": 706840116,
					"content": "欸？什么笔记？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706840117,
					"content": "每次练习我都做了记录，注意和反省点之类的…啊，后半部分是聆听他人演奏和尝试各种乐器的心得体会，不用太在意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840118
					],
					"speakerTitle": "莎莎"
				},
				{
					"id": 706840118,
					"content": "笔记的封皮已经磨损，内里如莎莎所说，详细记录了每一次练习的成果和反省。后半的所谓「心得体会」更是连篇累牍，与其说是心得，不如说更像是某种形式的论文或者研究报告…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						706840119
					]
				},
				{
					"id": 706840119,
					"content": "哇，这简直比蒙德图书馆里的百科全书还要厚！你就是音乐界的学者？收藏家？图书管理员？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706840120,
					"content": "嘿嘿，因为我的父母希望我能成为一名学者，一直让我接受这样的训练…但是现在我把这些经验都活用到吟游诗人的领域了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840121
					],
					"speakerTitle": "莎莎"
				},
				{
					"id": 706840121,
					"content": "好像有点道理但又感觉哪里不对…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706840122
					]
				},
				{
					"id": 706840122,
					"content": "#{NICKNAME}老师，我到底哪里做得不对呢？是我对音乐知识的理解有偏差，还是练习的方法不正确？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840123,
						706840124
					],
					"speakerTitle": "莎莎"
				},
				{
					"id": 706840123,
					"content": "以我的知识储备恐怕指导不了你…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706840125
					]
				},
				{
					"id": 706840125,
					"content": "成、成为吟游诗人居然是这么困难的事吗？唔…这么一想，卖唱的无论是弹琴还是唱歌，都是一副很轻松的样子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706840126,
					"content": "但是他的弹奏和演唱都挺好听的…该不会其实他在我们看不见的地方用功？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706840127,
					"content": "#呀嘿，{NICKNAME}，你在找我吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840128
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 706840128,
					"content": "温、温迪阁下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840129
					],
					"speakerTitle": "莎莎"
				},
				{
					"id": 706840129,
					"content": "呜哇，吓我一跳！卖唱的你怎么说来就来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706840130,
					"content": "是哪股风把你吹到这里来了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706840131
					]
				},
				{
					"id": 706840131,
					"content": "哎呀，当然是掺杂着异邦花草香气的思念之风啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840132
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 706840132,
					"content": "这家伙又在不正经了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706840133,
					"content": "嘿嘿，刚才我正在野外散步呢，突然灵感乍现，像被树上掉下来的苹果砸中了脑袋，我赶紧把想到的一段新诗记在了叶子上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840134
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 706840134,
					"content": "还没写完呢，就听到「呼啦」一声…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840135
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 706840135,
					"content": "「呼啦」一声？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840136
					],
					"speakerTitle": "莎莎"
				},
				{
					"id": 706840136,
					"content": "调皮的风非要当我的第一个读者，把我手里的叶子卷跑啦。我刚要追上去，一个黑影一闪而过，在我面前咬住了叶子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840137
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 706840137,
					"content": "我在原地打了好几个喷嚏…就在这个时候，我那段新诗的第二位读者已经跑没影喽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840138
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 706840138,
					"content": "唔，现在想起来都觉得鼻子有点痒痒的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840139
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 706840139,
					"content": "呃，听这个描述…咬走那片叶子的…是猫猫吗？不过你要自己去抓猫会不会太勉强了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840140,
						706840141
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706840140,
					"content": "我们来帮你吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706840142
					]
				},
				{
					"id": 706840142,
					"content": "我也来帮忙！温迪阁下的弹奏和演唱一直都是我学习的榜样！如果能帮到您，那将是我的荣幸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840143
					],
					"speakerTitle": "莎莎"
				},
				{
					"id": 706840143,
					"content": "就是…那个…等找到您的新诗之后，我能不能问您几个关于写诗的问题…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840144
					],
					"speakerTitle": "莎莎"
				},
				{
					"id": 706840144,
					"content": "对不起！我知道现在说这个太唐突了但我怕我等会就怕得说不出来了请您原谅！！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840145
					],
					"speakerTitle": "莎莎"
				},
				{
					"id": 706840145,
					"content": "哈哈哈，没关系，问题就像树叶上的脉纹，而灵感就是它传递的养分，当然应该以最快的速度抓在手里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840146
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 706840146,
					"content": "无论有什么问题，你就直接问吧。我会不做保留地向你分享我的想法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840147
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 706840147,
					"content": "真、真的？！我的笔记本…笔记本在哪…啊在这里…请您等一下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840148
					],
					"speakerTitle": "莎莎"
				},
				{
					"id": 706840148,
					"content": "莎莎飞快地翻阅起了自己的笔记本，在找到标有「疑问」的那一页时，她深深吸了一口气，开始讲述自己学习和练习的经历，以及遭遇的问题…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						706840149
					]
				},
				{
					"id": 706840149,
					"content": "原来如此…不过这么听下来，无论是理论知识还是演奏技巧，你都已经掌握得很好，应该不需要我的建议了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840150
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 706840150,
					"content": "欸？可是她明明都这么努力了却还是表现不好，肯定是有原因的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840151
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706840151,
					"content": "那就是因为我没有天分了…或许像我这样的人就不适合当吟游诗人吧，哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840152
					],
					"speakerTitle": "莎莎"
				},
				{
					"id": 706840152,
					"content": "你还记得自己为什么要成为一名吟游诗人吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840153
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 706840153,
					"content": "为什么想要成为吟游诗人…也许是因为羡慕吧。以前，当我被父母关在屋子里学习时，窗外传来了吟游诗人的歌声…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840154
					],
					"speakerTitle": "莎莎"
				},
				{
					"id": 706840154,
					"content": "那美妙的曲调，轻快的歌声，像一缕清风吹进了我的心里…要是我成为吟游诗人，我也能像他一样自由吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840155
					],
					"speakerTitle": "莎莎"
				},
				{
					"id": 706840155,
					"content": "我想像他一样自由，像他一样快乐，也想像他一样，把这份喜悦分享给所有人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840156
					],
					"speakerTitle": "莎莎"
				},
				{
					"id": 706840156,
					"content": "但一想到要在大家面前表演，我就紧张得不得了。为了不失败，我努力学习和练习，但是一到正式演出，就会结结巴巴…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840157
					],
					"speakerTitle": "莎莎"
				},
				{
					"id": 706840157,
					"content": "我认为你是一名很优秀的诗人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840158
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 706840158,
					"content": "欸？可、可是我…连歌都没法顺畅地唱下来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840159
					],
					"speakerTitle": "莎莎"
				},
				{
					"id": 706840159,
					"content": "你刚才不是说，是因为想要追求快乐与自由，才梦想成为一位吟游诗人吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840160
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 706840160,
					"content": "吟游诗人的歌声就像风一样，不会被任何东西束缚和阻拦。不然，那个时候你也不会在屋里听见那位诗人的歌声。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840161
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 706840161,
					"content": "你是一位优秀的诗人。只不过…你听到了太多杂音，自己为自己的想法挂上了枷锁，让它们限制了你的脚步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840162
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 706840162,
					"content": "不要担心别人的看法。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706840163
					]
				},
				{
					"id": 706840163,
					"content": "对呀，既然想把自由的快乐分享给大家，首先你就得比任何人都更自由、更快乐才行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840164
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706840164,
					"content": "喔，派蒙也很有当吟游诗人的潜力呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840165
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 706840165,
					"content": "比其他人更自由、更快乐…我懂了！谢谢各位老师，我会把你们的教导铭记在心的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840166
					],
					"speakerTitle": "莎莎"
				},
				{
					"id": 706840166,
					"content": "#那接下来就再试试看吧？机会难得，就由我和{NICKNAME}来为你伴奏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840167
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 706840167,
					"content": "乐意奉陪。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706840168
					]
				},
				{
					"id": 706840168,
					"content": "那观众的位置就交给我好了，我是最专业…也是最自由的观众！嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840169
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706840169,
					"content": "我、我、我第一次在这么多人面前顺利演出！啊，现在不是因为紧张才结巴，是太高兴了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840170
					],
					"speakerTitle": "莎莎"
				},
				{
					"id": 706840170,
					"content": "刚才在演奏时，我自己好像也变成了一缕清风，无论什么地方都能抵达…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840171
					],
					"speakerTitle": "莎莎"
				},
				{
					"id": 706840171,
					"content": "你的心情一定传达给大家了，你瞧，就连猫猫也被你的表演给吸引了呢！欸？猫猫？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840172
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706840172,
					"content": "哎呀，这不是我的第二位读者吗？我们快去问问它的读后…读…阿…阿…阿嚏！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840173
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 706840173,
					"content": "煤球，原来是你呀！抱歉，它是我的邻居养的猫，我在练习时它就常常跳到窗台上当我的观众…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840174
					],
					"speakerTitle": "莎莎"
				},
				{
					"id": 706840174,
					"content": "喵~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840175
					],
					"speakerTitle": "「煤球」"
				},
				{
					"id": 706840175,
					"content": "它刚才叼着的东西，该不会就是那片记着诗的叶子吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840176
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706840176,
					"content": "这是温迪阁下很重要的东西，能还给他吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840177
					],
					"speakerTitle": "莎莎"
				},
				{
					"id": 706840177,
					"content": "喵~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840178
					],
					"speakerTitle": "「煤球」"
				},
				{
					"id": 706840178,
					"content": "总觉得有些不好意思，您帮了我这么多，我却没什么可回报的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840179
					],
					"speakerTitle": "莎莎"
				},
				{
					"id": 706840179,
					"content": "你帮我找回了丢失的「灵感」，已经帮大忙啦，阿…阿嚏！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840180,
						706840181
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 706840180,
					"content": "问问它读后感。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706840182
					]
				},
				{
					"id": 706840182,
					"content": "喵~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840183
					],
					"speakerTitle": "「煤球」"
				},
				{
					"id": 706840183,
					"content": "欸，你喜欢我的诗吗？一下子凑那么近…阿嚏！别看啦，别看啦！我还没写完呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840184
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 706840184,
					"content": "咳，这位读者真热情…朋友们，下回记得来听我唱歌呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840185
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 706840185,
					"content": "他还真是来去如风…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840186
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706840186,
					"content": "居然能得到温迪阁下的指导…我得找个时间，专门去谢谢他…啊，也得谢谢两位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840187
					],
					"speakerTitle": "莎莎"
				},
				{
					"id": 706840187,
					"content": "作为小小的感谢，这本曲谱集就请你们收下吧。是我在学习时收集的各地曲谱，或许对你们有帮助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840188
					],
					"speakerTitle": "莎莎"
				},
				{
					"id": 706840188,
					"content": "除了各地的曲谱，其实我也收集了各种乐器！如果想要试用乐器，请随时来找我，我们也可以交流演奏的心得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840189
					],
					"speakerTitle": "莎莎"
				},
				{
					"id": 706840189,
					"content": "嘿嘿，那我们就不客气啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706840181,
					"content": "你喜欢那首诗吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706840182
					]
				},
				{
					"id": 706840141,
					"content": "正好问一下猫猫对这篇诗的读后感。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706840142
					]
				},
				{
					"id": 706840124,
					"content": "感觉你努力的方向有问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706840125
					]
				},
				{
					"id": 706840113,
					"content": "就当是爱好者交流感想吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706840114
					]
				},
				{
					"id": 706840109,
					"content": "也许问题不在练习量上…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706840110
					]
				}
			]
		},
		{
