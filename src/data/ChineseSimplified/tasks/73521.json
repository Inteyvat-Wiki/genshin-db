			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"瓦瑟迪瓦"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735210201,
					"content": "唉，看到这些年轻的孩子们，忍不住就会回忆起往事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210202
					],
					"speakerTitle": "瓦瑟迪瓦"
				},
				{
					"id": 735210202,
					"content": "学院争霸赛向来是年轻天才们的舞台。只可惜，不是每个天才最终都能成才…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210203
					],
					"speakerTitle": "瓦瑟迪瓦"
				},
				{
					"id": 735210203,
					"content": "为什么这么说？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735210204
					]
				},
				{
					"id": 735210204,
					"content": "天才大多固执冷漠，很难理解他人的痛苦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210205
					],
					"speakerTitle": "瓦瑟迪瓦"
				},
				{
					"id": 735210205,
					"content": "而有同理心的人，又往往会陷入自我怀疑与消沉当中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210206
					],
					"speakerTitle": "瓦瑟迪瓦"
				},
				{
					"id": 735210206,
					"content": "意志不坚定的人只能原地踏步，意志坚定却走错了路的人不肯回头。这里面的考验多着呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瓦瑟迪瓦"
				}
			]
		},
		{
			"id": 7352103,
			"completionStepIds": [
				7352103
