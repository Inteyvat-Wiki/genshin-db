			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"维卡斯"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-406.229,
							281.227,
							2791.158
						],
						"pointId": 330201342
					},
					{
						"sceneId": 3,
						"position": [
							-405.308,
							281.227,
							2791.237
						],
						"pointId": 330201343
					}
				]
			},
			"dialogs": [
				{
					"id": 735210401,
					"content": "…二十年前的事？为什么突然想问这个，你们听到了什么消息吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210402
					],
					"speakerTitle": "维卡斯"
				},
				{
					"id": 735210402,
					"content": "我们打听到二十年前冠冕好像丢过，而且好像还有参赛者性格发生了变化…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735210403,
					"content": "你们知道的还真不少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210404
					],
					"speakerTitle": "维卡斯"
				},
				{
					"id": 735210404,
					"content": "维卡斯，你是不是有什么瞒着我们？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735210405,
					"content": "也算不上隐瞒，二十年前我才五岁，我能知道什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210406
					],
					"speakerTitle": "维卡斯"
				},
				{
					"id": 735210406,
					"content": "但有些事我也确实没和别人说过。其实我加入学院庆典策划委员会，是受一位前辈的影响。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210407
					],
					"speakerTitle": "维卡斯"
				},
				{
					"id": 735210407,
					"content": "前辈和我是在旅游中认识的。他…胆子有点小，遇到什么突发情况总是第一时间躲起来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210408
					],
					"speakerTitle": "维卡斯"
				},
				{
					"id": 735210408,
					"content": "四年前的一天我跟他说，我想回教令院一趟，学院庆典要开始了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210409
					],
					"speakerTitle": "维卡斯"
				},
				{
					"id": 735210409,
					"content": "然后呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735210410,
					"content": "听到学院庆典，他像是吓了一跳，说什么「不关他的事」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210411
					],
					"speakerTitle": "维卡斯"
				},
				{
					"id": 735210411,
					"content": "当晚我找他告别的时候，他非要拉着我喝酒。喝多了，就开始说些乱七八糟的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210412
					],
					"speakerTitle": "维卡斯"
				},
				{
					"id": 735210412,
					"content": "我当时也喝了不少，意识模糊，听得不太清楚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210413
					],
					"speakerTitle": "维卡斯"
				},
				{
					"id": 735210413,
					"content": "只记得他说才识之冠曾经丢过一阵子。当时他主管才识之冠的发放与回收，差点没吓死，好在最后从树洞里找到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210414
					],
					"speakerTitle": "维卡斯"
				},
				{
					"id": 735210414,
					"content": "和我们之前看到的一样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735210415,
					"content": "他说才识之冠是非常贵重的宝物，许多典籍都有记载。传说它是由古代赫赫有名的工匠打造，有着不为人知的秘密。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210416
					],
					"speakerTitle": "维卡斯"
				},
				{
					"id": 735210416,
					"content": "萨齐因毕竟只是委托教令院保管，如果冠冕在那位前辈手上丢了，他倾家荡产也赔不起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210417
					],
					"speakerTitle": "维卡斯"
				},
				{
					"id": 735210417,
					"content": "哪怕只是暂时丢了，也不能让别人知道，不然教令院会判处他严重失职。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210418
					],
					"speakerTitle": "维卡斯"
				},
				{
					"id": 735210418,
					"content": "所以他隐瞒了这件事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210419
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735210419,
					"content": "是啊。当时他好像还说有不少人来问，其中甚至还有小孩子，但他一律声称冠冕从未丢过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210420
					],
					"speakerTitle": "维卡斯"
				},
				{
					"id": 735210420,
					"content": "但他还是太害怕了，于是等风头过去后，干脆辞掉了工作，从教令院离开了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210421
					],
					"speakerTitle": "维卡斯"
				},
				{
					"id": 735210421,
					"content": "当天晚上我也喝多了，第二天起来他已经不见了。后来我越想越觉得不是滋味，学院庆典交给这种人来搞，早晚会出大问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210422
					],
					"speakerTitle": "维卡斯"
				},
				{
					"id": 735210422,
					"content": "当时我也没有工作，干脆加入了学院庆典策划委员会。我也从内部查过当年的事情，不过没什么收获。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210423
					],
					"speakerTitle": "维卡斯"
				},
				{
					"id": 735210423,
					"content": "冠冕失而复得，传闻性格变化的人也已经去世，查无可查了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210424
					],
					"speakerTitle": "维卡斯"
				},
				{
					"id": 735210424,
					"content": "二十年还是太久了，久到当初的事情已经无人记得、也无人在意了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210425
					],
					"speakerTitle": "维卡斯"
				},
				{
					"id": 735210425,
					"content": "我只知道这么多了。如果你们好奇的话，可以继续调查下去，也许有一天能推测出真相…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210426
					],
					"speakerTitle": "维卡斯"
				},
				{
					"id": 735210426,
					"content": "说得轻巧，我们也没有更多线索啦。你就没有更多的线索了吗？比如那个前辈平时在哪活动？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210427
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735210427,
					"content": "那个前辈的消息我确实没有了。后来我也去沙漠找过他，但茫茫沙海，想偶遇几乎是不可能了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210428
					],
					"speakerTitle": "维卡斯"
				},
				{
					"id": 735210428,
					"content": "作为补偿，我这里倒是有个关于萨齐因的消息，你们要不要听？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210429
					],
					"speakerTitle": "维卡斯"
				},
				{
					"id": 735210429,
					"content": "嗯…也可以，说来听听？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210430
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735210430,
					"content": "我在外面旅游的时候，曾经与一位佣兵团长同行。聊天的时候，他说自己手上有一位教令院学者写的文章。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210431
					],
					"speakerTitle": "维卡斯"
				},
				{
					"id": 735210431,
					"content": "他似乎觉得这是什么宝贝，不肯轻易示人，在我的恳请下才让我看了一眼。我没看清内容，但看到署名是萨齐因。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210432
					],
					"speakerTitle": "维卡斯"
				},
				{
					"id": 735210432,
					"content": "当时我不知道萨齐因是谁，也不怎么关心。加入学院庆典策划委员会后，才知道他就是赞助学院庆典的因论派名宿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210433
					],
					"speakerTitle": "维卡斯"
				},
				{
					"id": 735210433,
					"content": "你们要是感兴趣，可以去沙漠找他，他平时在荼诃落谷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210434
					],
					"speakerTitle": "维卡斯"
				},
				{
					"id": 735210434,
					"content": "跟萨齐因有关的消息？好吧，我们去看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
