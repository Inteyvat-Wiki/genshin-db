			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"胡维斯卡"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-2009.721,
							274.996,
							4224.615
						],
						"pointId": 330800394
					}
				]
			},
			"dialogs": [
				{
					"id": 735210301,
					"content": "今年学院争霸赛，我最看好的就是赛诺了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210302
					],
					"speakerTitle": "胡维斯卡"
				},
				{
					"id": 735210302,
					"content": "抛开他大风纪官的身手不谈，回顾历届争霸赛，素论派夺冠比例是最高的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210303
					],
					"speakerTitle": "胡维斯卡"
				},
				{
					"id": 735210303,
					"content": "很多人说素论派盛产天才，居勒什、鲁奇卡、丽莎、赛诺…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210304
					],
					"speakerTitle": "胡维斯卡"
				},
				{
					"id": 735210304,
					"content": "天才越是耀眼，比赛也会越早失去悬念。要说打得最激烈的，还得是二十年前那一场。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210305
					],
					"speakerTitle": "胡维斯卡"
				},
				{
					"id": 735210305,
					"content": "当时我的朋友也参加了比赛，我专门去现场为他加油助威。最后一轮是在道成林打的，打到最后没人敢靠近，谁也不知道林子深处发生了什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210306
					],
					"speakerTitle": "胡维斯卡"
				},
				{
					"id": 735210306,
					"content": "后来听说教令院叫停了那场比赛。再之后，学院争霸赛就移除了许多生死相争的项目，不鼓励大家在比赛中「死斗」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210307
					],
					"speakerTitle": "胡维斯卡"
				},
				{
					"id": 735210307,
					"content": "你的朋友是一个什么样的人？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735210308
					]
				},
				{
					"id": 735210308,
					"content": "让我想想。他…正直善良，但也脆弱敏感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210309
					],
					"speakerTitle": "胡维斯卡"
				},
				{
					"id": 735210309,
					"content": "最重要的是，他很在乎我们这些朋友。我们一起喝酒，酒中满是欢声笑语。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210310
					],
					"speakerTitle": "胡维斯卡"
				},
				{
					"id": 735210310,
					"content": "只可惜往事一去不返了。当初一起喝酒的朋友们，有人过世，有人失踪，有人隐居…都说命运无常，真是所言非虚啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210311
					],
					"speakerTitle": "胡维斯卡"
				},
				{
					"id": 735210311,
					"content": "看来二十年前确实发生了什么事…对了，维卡斯不是跟我们说，让我们有什么问题可以去找他吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735210312,
					"content": "既然现在有时间，我们去找他问问怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7352104,
