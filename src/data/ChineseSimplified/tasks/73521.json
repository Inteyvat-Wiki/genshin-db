			},
			"dialogs": [
				{
					"id": 735210101,
					"content": "#哎呀哎呀，又看到{NICKNAME}和小派蒙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210102
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 735210102,
					"content": "我这里有一份最新的学院庆典情报哦，要不要了解一下呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210103
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 735210103,
					"content": "要钱吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735210104,
					"content": "免费赠送！桑歌玛哈巴依老爷真的是太慷慨了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210105
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 735210105,
					"content": "你们还记得萨齐因吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210106
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 735210106,
					"content": "是赞助学院庆典的那个人吧！听说奖金和才识之冠都来源于他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735210107,
					"content": "答对了！其实前不久，我在沙漠经商的时候，遇到了一位老商人呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210108
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 735210108,
					"content": "你猜我从他们手上买到了什么？一份行商记录！有了它，我就能避开沙漠中的危险区域，去更多地方了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210109
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 735210109,
					"content": "当然，最最重要的是，记录中竟然提到了萨齐因！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210110
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 735210110,
					"content": "原来萨齐因曾经到沙漠考察风土人情，还和沙漠中的旅行商人亲切交流过呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210111
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 735210111,
					"content": "虽然很多文字已经看不清了，但这可是关于学院庆典背后大赞助商的第一手资料！要看看吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210112
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 735210112,
					"content": "好吧，那我们就看看好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735210113,
					"content": "嗯…看不懂！多莉，你知道是什么意思吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735210114,
					"content": "是什么意思呢？很遗憾，如果需要分析的话，需要额外支付一百万摩拉哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210115
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 735210115,
					"content": "那还是算了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735210116,
					"content": "既然你们不肯付钱，那多莉的特别消息就到此为止了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210117
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 735210117,
					"content": "不过我还可以给你们一点提示！比赛现场应该有人参加过许多届学院庆典，找他们聊聊或许会有新的收获？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "多莉"
				}
			]
		},
		{
			"id": 7352102,
			"completionStepIds": [
				7352102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
