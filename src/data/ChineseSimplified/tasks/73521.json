					"素海卜"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-2712.056,
							67.739,
							4387.715
						],
						"pointId": 331000111
					}
				]
			},
			"dialogs": [
				{
					"id": 735210501,
					"content": "有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210502
					],
					"speakerTitle": "素海卜"
				},
				{
					"id": 735210502,
					"content": "呜哇…这个人看着好凶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735210503,
					"content": "有事就说，没事就走。我没空伺候你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210504
					],
					"speakerTitle": "素海卜"
				},
				{
					"id": 735210504,
					"content": "其实，我们听说你手里有萨齐因写的文章，所以想来看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735210505,
					"content": "…你们不会是在拿我寻开心吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210506
					],
					"speakerTitle": "素海卜"
				},
				{
					"id": 735210506,
					"content": "没有呀！为什么这么问？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735210507,
					"content": "看来你们确实不知道。我前段时间找人鉴定了，这篇文章只是感慨性质的游记，没什么价值。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210508
					],
					"speakerTitle": "素海卜"
				},
				{
					"id": 735210508,
					"content": "当初他曾雇我老爹保护他的安全，那个叫萨齐因的人经常边走、边问、边写，神神叨叨的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210509
					],
					"speakerTitle": "素海卜"
				},
				{
					"id": 735210509,
					"content": "有一次他的稿纸被风吹跑了。他说不要了，我爹却觉得文化人写的东西肯定值钱，于是在夜里打着火把四处寻找。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210510
					],
					"speakerTitle": "素海卜"
				},
				{
					"id": 735210510,
					"content": "我们一家都不识字。我爹把他写的东西当宝贝，还传给了我。没想到根本不值钱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210511
					],
					"speakerTitle": "素海卜"
				},
				{
					"id": 735210511,
					"content": "听上去有点倒霉…那篇文章还在你这里吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210512
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735210512,
					"content": "在。你们想看？那就让你们看看好了，既然不值钱，我也没必要当宝贝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210513
					],
					"speakerTitle": "素海卜"
				},
				{
					"id": 735210513,
					"content": "这就是萨齐因写的文章？呃…说实话，看不太懂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210514
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735210514,
					"content": "不过…看着这些模糊的笔迹，不知道为什么，好像感觉他有些难过？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210515
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735210515,
					"content": "总之，我们看完啦，多谢你了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210516
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735210516,
					"content": "不客气。虽然不值钱，但我还是会继续留着它，毕竟是我爹留给我的。想看的话就再来找我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "素海卜"
				}
			]
		},
