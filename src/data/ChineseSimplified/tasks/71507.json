			"dialogs": [
				{
					"id": 715070101,
					"content": "这效果比我想象的还要好，所有现象和数据都已经记录在册…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070102
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715070102,
					"content": "最关键的，这里的黑泥确实被清理一空了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070103
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715070103,
					"content": "只不过，嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070104
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715070104,
					"content": "怎么还是一脸不开心的样子啊，难道矿区被清空不是好事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715070105,
					"content": "让我想想，我和海迪夫之前分析的时候认为，涌出黑泥的地脉出口应该就在矿区。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070106
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715070106,
					"content": "地脉出口不会这么简单就被清理干净，所以地脉出口其实是在其他地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070107
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715070107,
					"content": "这次受到黑泥泛滥影响的区域除了矿区就是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070108
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715070108,
					"content": "前线矿道。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715070109
					]
				},
				{
					"id": 715070109,
					"content": "是的…说明涌出黑泥的地脉出口就在矿道的区域，矿道相较这里更加狭窄，黑泥容易堆积，更易招来怪物，造成的问题更严重。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070110
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715070110,
					"content": "不过我相信「普尔希娜光钉」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070111
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715070111,
					"content": "这可是普尔希娜前辈制造的相当伟大的仪器。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070112
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715070112,
					"content": "只不过我得先维修一下，之后就等约好的矿工们下来把光钉搬到矿道里去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "胡塞尼"
				}
			]
		}
	]
