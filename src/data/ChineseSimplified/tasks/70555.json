			"dialogs": [
				{
					"id": 705550101,
					"content": "#{NICKNAME}，收工啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705550102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705550102,
					"content": "听说，在我跟着格兰菲狄小姐捣鼓外送订单的时候，你把事情办得超漂亮嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705550103,
						705550104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705550103,
					"content": "这次我的灵感很多哦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705550105
					]
				},
				{
					"id": 705550105,
					"content": "…总之，荣誉骑士是目前蒙德最有才华的调饮师之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705550106
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705550106,
					"content": "#考虑到从业时间，我觉得，{M#他}{F#她}甚至有潜力追上猫尾酒馆的那位小小传说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705550107
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705550107,
					"content": "我无条件支持这个决策，大团长，这段时间实在有劳荣誉骑士了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705550108
					],
					"speakerTitle": "格兰菲狄"
				},
				{
					"id": 705550108,
					"content": "饮品小站还会营业一段时间，确保做好迎接远征队员的万全准备。找到合适的店面后，还会试点常态开放…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705550109
					],
					"speakerTitle": "格兰菲狄"
				},
				{
					"id": 705550109,
					"content": "好欸！骑士团的大家都要有美味饮料喝了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705550110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705550110,
					"content": "不愧是赫塔的亲传弟子，格兰菲狄考虑得很周到！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705550111
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705550111,
					"content": "还有，荣誉骑士开发的新品特调…如果您不介意，要留下配方，将它们作为正式饮品，加入小站的清单吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705550112,
						705550113
					],
					"speakerTitle": "格兰菲狄"
				},
				{
					"id": 705550112,
					"content": "完全没关系，大家一起喝！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705550114
					]
				},
				{
					"id": 705550114,
					"content": "#唔…嗯…感觉{NICKNAME}好像还有什么愿望没有说…我来猜猜看？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705550115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705550115,
					"content": "以你的性格，应该会要求…标注每一杯特调的来历！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705550116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705550116,
					"content": "让客人们知道，你是为了谁，受了谁的启发，才完成了这些厉害的作品！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705550117,
						705550118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705550117,
					"content": "完全正确！派蒙最懂我！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705550119
					]
				},
				{
					"id": 705550119,
					"content": "没有任何问题！如果你们还有需求，我可以请专人拟定文书，申请这些特调的专利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705550120
					],
					"speakerTitle": "格兰菲狄"
				},
				{
					"id": 705550120,
					"content": "哈哈哈哈，希望以后新招募的酒保，也能领会我们荣誉骑士的奇妙手法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705550121
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705550121,
					"content": "不说调出旗鼓相当的杰作，还原荣誉骑士的七成功力，就算顶尖高手！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705550118,
					"content": "这一点对大家都很重要！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705550119
					]
				},
				{
					"id": 705550113,
					"content": "介意的话…好像有点小气？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705550114
					]
				},
				{
					"id": 705550104,
					"content": "和大家聊天找到了点子…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705550105
					]
				}
			]
		}
	]
