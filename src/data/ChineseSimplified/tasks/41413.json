				"points": []
			},
			"dialogs": [
				{
					"id": 414130401,
					"content": "感谢你，风花节之星。我们已向风神巴巴托斯献上饱含敬爱的「风之花」，愿风护佑蒙德。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130402
					],
					"speakerTitle": "琴"
				},
				{
					"id": 414130402,
					"content": "不错的选择哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130403
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 414130403,
					"content": "你喜欢吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130404
					]
				},
				{
					"id": 414130404,
					"content": "嗯——你猜？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130405
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 414130405,
					"content": "又让人猜，这个坏家伙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414130406,
					"content": "啊哈哈哈哈！会告诉你的啦，不过不是在这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130407
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 414130407,
					"content": "人来人往的广场不方便聊这些，换个地方吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130408
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 414130408,
					"content": "去哪儿好呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414130409,
					"content": "我想邀请你和我一起到「风龙废墟」去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "温迪"
				}
			]
		},
		{
			"id": 4141307,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
