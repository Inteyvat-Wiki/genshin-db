				"points": []
			},
			"dialogs": [
				{
					"id": 414130201,
					"content": "琴团长，我们来啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414130202,
					"content": "旅行者！啊，不，这里或许该称呼你为荣誉骑士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130203
					],
					"speakerTitle": "琴"
				},
				{
					"id": 414130203,
					"content": "想必你已经听说了，你是本届的「风花节之星」，将代表全蒙德人向风神巴巴托斯献上「风之花」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130204
					],
					"speakerTitle": "琴"
				},
				{
					"id": 414130204,
					"content": "不过…这次似乎略有不同呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130205
					],
					"speakerTitle": "琴"
				},
				{
					"id": 414130205,
					"content": "有我们，还有卖唱的，这次风花节是不是格外热闹呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414130206,
					"content": "是的。感谢你们常驻蒙德，也希望你们今后继续享受在蒙德的生活。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130207
					],
					"speakerTitle": "琴"
				},
				{
					"id": 414130207,
					"content": "风花典礼快要开始了。风花节之星，选好属于你的「风之花」了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130208
					],
					"speakerTitle": "琴"
				},
				{
					"id": 414130208,
					"content": "我们必须选出一种花，把它献给风神，对吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414130209,
					"content": "没错，请你慎重考虑之后做出选择。别忘了，你的选择代表着全蒙德。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130210
					],
					"speakerTitle": "琴"
				},
				{
					"id": 414130210,
					"content": "温迪，你喜欢什么花？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130211
					]
				},
				{
					"id": 414130211,
					"content": "嗯？好狡猾呀，居然直接问我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130212
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 414130212,
					"content": "咳咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130213
					],
					"speakerTitle": "琴"
				},
				{
					"id": 414130213,
					"content": "不要在这种场合说悄悄话啦你们两个！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414130214,
					"content": "哈哈，被训了呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130215
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 414130215,
					"content": "不用在意我，选喜欢的就好。我相信你的品味。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130216
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 414130216,
					"content": "那么，荣誉骑士，你的选择是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130217,
						414130219,
						414130221,
						414130223,
						414130225,
						414130227
					],
					"speakerTitle": "琴"
				},
				{
					"id": 414130217,
					"content": "蒲公英",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130218
					]
				},
				{
					"id": 414130218,
					"content": "哦！支持者众多的热门选择，「风之花」一定就是蒲公英啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130229
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414130229,
					"content": "请代表蒙德人，向神像献上你的「风之花」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "琴"
				},
				{
					"id": 414130219,
					"content": "风车菊",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130220
					]
				},
				{
					"id": 414130220,
					"content": "哦！是支持者众多的热门选择，「风之花」一定就是风车菊啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130229
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414130221,
					"content": "塞西莉亚花",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130222
					]
				},
				{
					"id": 414130222,
					"content": "哦！与贝雅特丽奇意见一致，「风之花」是较为冷门却有着坚定拥护者的塞西莉亚花！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130229
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414130223,
					"content": "小灯草",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130224
					]
				},
				{
					"id": 414130224,
					"content": "哦！与宁禄意见一致，「风之花」是能照亮黑暗的小灯草！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130229
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414130225,
					"content": "甜甜花",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130226
					]
				},
				{
					"id": 414130226,
					"content": "哦！与砂糖意见一致，「风之花」是从古到今生生不息的甜甜花！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130229
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414130227,
					"content": "钩钩果",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130228
					]
				},
				{
					"id": 414130228,
					"content": "哦！与雷泽意见一致，「风之花」是刺刺的麻麻的钩钩果！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130229
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
