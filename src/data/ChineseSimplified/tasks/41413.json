			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"温迪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414130701,
					"content": "嗯！还是这里的景色最好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130702,
						414130703
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 414130702,
					"content": "好漂亮的风景。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130704
					]
				},
				{
					"id": 414130704,
					"content": "是啊，我很喜欢这个地方，闲暇时总会过来坐一会儿，看看风景。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130705
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 414130705,
					"content": "是来偷懒的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130706
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414130706,
					"content": "哈哈哈，被你发现了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130707
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 414130707,
					"content": "如此美景，手里要是有杯苹果酒该多好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130708
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 414130708,
					"content": "旅行者，蒙德的风花节，你喜欢吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130709,
						414130710
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 414130709,
					"content": "充满人情味，又很热闹。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130711
					]
				},
				{
					"id": 414130711,
					"content": "但还是有所疑问，对不对？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130712
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 414130712,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130713
					]
				},
				{
					"id": 414130713,
					"content": "我知道你想问什么。究竟什么是「风之花」？风神巴巴托斯眼中的「风之花」与「风花节」又意味着什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130714
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 414130714,
					"content": "如你所见，蒙德人民各有选择。有人从千万种花朵里选择了蒲公英，有人则挑选了风车菊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130715
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 414130715,
					"content": "每个人心中的「风之花」，好像都不一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130716
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414130716,
					"content": "是啊，本该如此。没有唯一的答案，也没有真实存在过的「风之花」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130717
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 414130717,
					"content": "咦…不存在吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130718
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414130718,
					"content": "「风之花」这个词语，最初只是旧蒙德时代，人民之间相互联络、共约反抗的暗语罢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130719
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 414130719,
					"content": "那时人们常说，风越大，「风之花」的根基就越稳固，花朵也绽放得越鲜艳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130720
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 414130720,
					"content": "要我说的话，它并不存在，也无处不在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130721
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 414130721,
					"content": "它是向往自由的灵魂、是追逐风向的勇气…一切美好、值得被祝福的事物，都可以是「风之花」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130722
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 414130722,
					"content": "看似不存在，却又无处不在的东西，就像风一样！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130723
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414130723,
					"content": "哈哈，你说得没错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130724
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 414130724,
					"content": "所以，风神巴巴托斯不会定义何为「风之花」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130725
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 414130725,
					"content": "祝福之花、敬爱之花、深爱之花。每个人都会有属于自己的「风之花」，每个人都有自由定义它的权利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130726
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 414130726,
					"content": "自由之都蒙德献给风神的花，果然非常自由呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130727
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414130727,
					"content": "我也喜欢自由的感觉。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130728
					]
				},
				{
					"id": 414130728,
					"content": "我知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130729
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 414130729,
					"content": "人们会因为共同的意志走到一起，牵引你我相遇的，想必是自由之风。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130730
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 414130730,
					"content": "它来自旅途的尽头、世界的边缘。来自你我心中，永不停歇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130731
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 414130731,
					"content": "「是谁轻抚你带伤却坚毅的面容\\n在小溪边\\n在巨岩旁」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130732
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 414130732,
					"content": "「是谁紧拥你疲惫而高贵的灵魂\\n在深梦里\\n在高天之上」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130733
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 414130733,
					"content": "「亲爱的朋友\\n我牵着你的手\\n带你走进夜晚华灯」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130734
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 414130734,
					"content": "「为你从头讲述\\n节日里那自由与梦的乐章」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "温迪"
				},
				{
					"id": 414130710,
					"content": "跟大家在一起，非常开心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130711
					]
				},
				{
					"id": 414130703,
					"content": "气氛真不错。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130704
					]
				}
			]
		},
