			"trigger": {
				"objectNames": [
					"八重神子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 745240401,
					"content": "哎呀，这不是小家伙吗？难道是打听到了我今天的行程，特意来这里见我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240402,
						745240403
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 745240402,
					"content": "神子刚去见过将军吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745240404
					]
				},
				{
					"id": 745240404,
					"content": "呵呵，鼻子还挺灵。不过是给某位不爱出门的友人带了些甜点，和时下最热门的轻小说罢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240405
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 745240405,
					"content": "影也开始追更了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745240406
					]
				},
				{
					"id": 745240406,
					"content": "她的说法是，想借此了解稻妻民众近来的娱乐生活和喜好变化。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240407
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 745240407,
					"content": "刚才，她还和我讨论了一番呢。一开始，她还只是一本正经地分析故事内容所体现出的读者偏好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240408
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 745240408,
					"content": "…可说着说着，就忽然很在意地问我：「所以，那个角色最后的结局究竟如何？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240409
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 745240409,
					"content": "呵呵，看来就算是影，也难免会被精彩的故事所吸引呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240410,
						745240411
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 745240410,
					"content": "神子刚才的表情…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745240412
					]
				},
				{
					"id": 745240412,
					"content": "哦？所以这才是你今天真正的来意吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240413
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 745240413,
					"content": "我知道了。一定是小家伙在旅途中时常会思念我，所以想要拍些画片留作念想，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240414
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 745240414,
					"content": "那就交给你了。可要用心挑选角度哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "八重神子"
				},
				{
					"id": 745240411,
					"content": "非常值得被记录下来。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745240412
					]
				},
				{
					"id": 745240403,
					"content": "我闻到了一股甜味…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745240404
					]
				}
			]
		}
	]
