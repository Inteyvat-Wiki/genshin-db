					"桥西"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210033001,
					"content": "这可怎么办…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033002
					],
					"speakerTitle": "桥西"
				},
				{
					"id": 210033002,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210033003
					]
				},
				{
					"id": 210033003,
					"content": "嗯？你是什么人？来往大桥者都需要接受盘查，你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033004
					],
					"speakerTitle": "桥西"
				},
				{
					"id": 210033004,
					"content": "不过，呃…看你穿得这么古怪，肯定也不是什么坏人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033005
					],
					"speakerTitle": "桥西"
				},
				{
					"id": 210033005,
					"content": "什么道理…你想想嘛，想做坏事的话，一定穿得越低调越好吧？哪里会像你穿得这么显眼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033015
					],
					"speakerTitle": "桥西"
				},
				{
					"id": 210033015,
					"content": "你在这里做什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033006
					],
					"speakerTitle": "桥西"
				},
				{
					"id": 210033006,
					"content": "我是负责这片区域的「千岩军」。因为这里是荻花洲的交通要道，无论是商货还是行人，都要从这里经过，所以我被派来做护卫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033007
					],
					"speakerTitle": "桥西"
				},
				{
					"id": 210033007,
					"content": "几天前，我在旁边发现了一群怪物…那群怪物看起来像是在那里扎了营，虽然它们目前没有什么动作，但安全起见，我还是要盯着它们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033008
					],
					"speakerTitle": "桥西"
				},
				{
					"id": 210033008,
					"content": "虽然我很想去把它们给清理掉…但我又担心，要是我离开了这里，会有其他的怪物趁机袭击过路人，所以只能一直这么干耗着…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033009
					],
					"speakerTitle": "桥西"
				},
				{
					"id": 210033009,
					"content": "我已经把那群怪物全部清理掉了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210033010
					]
				},
				{
					"id": 210033010,
					"content": "你已经清理掉了？啊，这…这可再好不过了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033011
					],
					"speakerTitle": "桥西"
				},
				{
					"id": 210033011,
					"content": "苦你了，真是不好意思，这本来是我的工作，反而麻烦了你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033012
					],
					"speakerTitle": "桥西"
				},
				{
					"id": 210033012,
					"content": "唉，也不知道上面是怎么想的，一直没有再派人来这里。我一个人，又怎么能面面俱到呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033013
					],
					"speakerTitle": "桥西"
				},
				{
					"id": 210033013,
					"content": "我一定要找个机会，再和上面好好报告一下这件事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033014
					],
					"speakerTitle": "桥西"
				},
				{
					"id": 210033014,
					"content": "谢谢你，这些给你，就算是答谢吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "桥西"
				}
			]
		},
