			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"佩科"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2260.9,
							200.7,
							9289.5
						],
						"pointId": 12118
					},
					{
						"sceneId": 3,
						"position": [
							2260.4,
							200.2,
							9293.5
						],
						"pointId": 13302
					}
				]
			},
			"dialogs": [
				{
					"id": 760220301,
					"content": "哎呀呀，感谢两位的救命之恩，我是游商佩科，之后两位若有机会关照我的生意，一定给两位最实惠的折扣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220302
					],
					"speakerTitle": "佩科"
				},
				{
					"id": 760220302,
					"content": "说起来今天真是倒霉，竟让我碰见这传说中的人物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220303
					],
					"speakerTitle": "佩科"
				},
				{
					"id": 760220303,
					"content": "传说中的人物？那家伙很有名吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760220304,
					"content": "恶名的话是有的。我也是听别的同行说的…当时他们也被吓得不行，说是再也不走这条路线了，我也是不信邪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220305
					],
					"speakerTitle": "佩科"
				},
				{
					"id": 760220305,
					"content": "那你还真是胆大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760220306,
					"content": "我们做游商的，什么没碰见过？而且，我们有时候坐在一起，讲讲自己的故事的时候，也总容易「夸大事实」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220307
					],
					"speakerTitle": "佩科"
				},
				{
					"id": 760220307,
					"content": "说偏了…他叫「权八」，听说是在稻妻犯了什么事，逃亡来了偏乡，对了，还带着他的相好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220308
					],
					"speakerTitle": "佩科"
				},
				{
					"id": 760220308,
					"content": "所以刚刚他提到的「阿紫」就是…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760220309
					]
				},
				{
					"id": 760220309,
					"content": "#对哦！刚刚那个怪人和{NICKNAME}打架的时候就念叨着这个名字呢，奇奇怪怪的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760220310,
					"content": "从前就不走正路的人，哪怕到了新的地方，想要金盆洗手也没那么容易吧。没个正经营生，最后只有重蹈覆辙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220311
					],
					"speakerTitle": "佩科"
				},
				{
					"id": 760220311,
					"content": "如果他就自己一个人的话，这么个活法倒也无所谓，但刀口舔血，谁知道会得罪什么人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220312
					],
					"speakerTitle": "佩科"
				},
				{
					"id": 760220312,
					"content": "听说他那相好也是因此才丧命…反正，自从那之后，他就疯疯癫癫的啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220313
					],
					"speakerTitle": "佩科"
				},
				{
					"id": 760220313,
					"content": "唉…大块头抢劫摩拉是可恶，但一想到他变成现在的样子，又觉得有那么一点点可怜啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220314,
						760220316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760220314,
					"content": "所以派蒙千万不要为了摩拉…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760220315
					]
				},
				{
					"id": 760220315,
					"content": "喂！重点根本不是这个啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760220318,
					"content": "好啦，我就不继续耽误两位的时间了，这份谢礼先请两位收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "佩科"
				},
				{
					"id": 760220316,
					"content": "如果有一天派蒙被抢劫了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760220317
					]
				},
				{
					"id": 760220317,
					"content": "#哼哼，那我身边不是还有你嘛！我的摩拉，{NICKNAME}守护！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220318
					],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}