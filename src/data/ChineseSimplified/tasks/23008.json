			"dialogs": [
				{
					"id": 230080101,
					"content": "也许马上就要成功了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080102
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230080102,
					"content": "旅行者！请你留步，旅行者！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080103,
						230080104
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230080103,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230080105
					]
				},
				{
					"id": 230080105,
					"content": "我要找史莱姆凝液！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080106
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230080106,
					"content": "事情是这样，我这几天一直在试验，把你之前帮我拿回来的泥土用各种比例混合。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080107
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230080107,
					"content": "虽然失败了很多次…但我最终还是找到了一个可用的混合比例！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080108
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230080108,
					"content": "用这种比例混合出来的「凝成泥土」虽然在凝固前没什么可塑性，但凝固后却坚固耐用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080109
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230080109,
					"content": "我猜，也许是那种混合了史莱姆凝液的泥土加入少了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080110
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230080110,
					"content": "旅行者，请你快去帮我再拿三份史莱姆凝液回来吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080111
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230080111,
					"content": "有了这些史莱姆凝液，我一定能做出我想要的泥土！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿金"
				},
				{
					"id": 230080104,
					"content": "你又要找什么东西？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230080105
					]
				}
			]
		},
