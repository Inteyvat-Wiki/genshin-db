				"points": []
			},
			"dialogs": [
				{
					"id": 230080301,
					"content": "太好了！就是这些，请稍等我一下，马上就好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080302
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230080302,
					"content": "等待了一段时间之后。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230080303
					]
				},
				{
					"id": 230080303,
					"content": "果然，我的猜想没错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080304
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230080304,
					"content": "潮湿的泥土粘合性好，凝固后却容易断裂，但和骗骗花的泥土样本混合之后，凝固后的泥土居然有了一些柔韧性。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080305
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230080305,
					"content": "但这种泥土在凝固前的可塑性很差…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080306
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230080306,
					"content": "但加上史莱姆栖息地的泥土之后，这种泥土在凝固前的可塑性突然好了起来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080307
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230080307,
					"content": "我也不知道为什么，硬要形容的话，就是这种泥土变成了史莱姆一样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080308,
						230080309
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230080308,
					"content": "「史莱姆土」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230080311
					]
				},
				{
					"id": 230080311,
					"content": "我猜是史莱姆的某种特质影响了泥土，所以就在想如果直接加入史莱姆凝液会不会更有效果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080312
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230080312,
					"content": "结果刚刚测试了一下，根据史莱姆凝液加入量的不同，泥土的可塑性与强度都会随之变化。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080313
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230080313,
					"content": "换句话说，不只是建筑材料，它还能用来做陶器，还有许多其他东西！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080314,
						230080315
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230080314,
					"content": "祝贺你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230080316
					]
				},
				{
					"id": 230080316,
					"content": "谢谢，这就是上面的聪明人常说的，「聚沙成塔」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080317
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230080317,
					"content": "别看这泥土很不起眼，现在也许它真的能造出一座通天高塔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080318
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230080318,
					"content": "我决定把这些混合型的泥土取名为「凝成泥土」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080319
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230080319,
					"content": "接下来我要做的，就是试验这种「凝成泥土」能用来做什么了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080320
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230080320,
					"content": "长时间困扰大家的房屋问题，现在也有解决的希望了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080321
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230080321,
					"content": "非常感谢你，旅行者，这些是报酬，请你收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿金"
				},
				{
					"id": 230080315,
					"content": "总算有成果了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230080316
					]
				},
				{
					"id": 230080309,
					"content": "派蒙会喜欢吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230080310
					]
				},
				{
					"id": 230080310,
					"content": "派蒙才不会去吃土嘞！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080311
					],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
