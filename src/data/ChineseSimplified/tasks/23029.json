			"dialogs": [
				{
					"id": 230290101,
					"content": "也差不多是时候了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290102
					],
					"speakerTitle": "雅丝敏"
				},
				{
					"id": 230290102,
					"content": "你还在研究圣树根系吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230290103
					]
				},
				{
					"id": 230290103,
					"content": "旅行者，每次你都来得这么巧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290104
					],
					"speakerTitle": "雅丝敏"
				},
				{
					"id": 230290104,
					"content": "非常感谢你之前的帮助，圣树的情况非常好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290105
					],
					"speakerTitle": "雅丝敏"
				},
				{
					"id": 230290105,
					"content": "我和拉德普讨论过后，认为这种好情况还会保持很长一段时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290106
					],
					"speakerTitle": "雅丝敏"
				},
				{
					"id": 230290106,
					"content": "这下我们终于可以腾出手来，为我们的论文做一些准备工作了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290107
					],
					"speakerTitle": "雅丝敏"
				},
				{
					"id": 230290107,
					"content": "瞧，我从法尔希那边借来了一部「留影机」，正准备去记录一下圣树的情况。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290108
					],
					"speakerTitle": "雅丝敏"
				},
				{
					"id": 230290108,
					"content": "旅行者，你也帮我去一个地方记录一下圣树的全貌吧，我把地点给你标在地图上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290109,
						230290110
					],
					"speakerTitle": "雅丝敏"
				},
				{
					"id": 230290109,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230290110,
					"content": "你怎么不自己去？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230290111
					]
				},
				{
					"id": 230290111,
					"content": "呃，那边…那边…太高了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290112
					],
					"speakerTitle": "雅丝敏"
				},
				{
					"id": 230290112,
					"content": "我每次一个人去到很高的地方都会很害怕…总觉得会有一股风把我…或者我的文稿给吹走…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290113
					],
					"speakerTitle": "雅丝敏"
				},
				{
					"id": 230290113,
					"content": "平时都是法尔希去那边记录，但今天他似乎有别的事要忙，所以就只能拜托你了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雅丝敏"
				}
			]
		},
