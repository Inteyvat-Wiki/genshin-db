			"dialogs": [
				{
					"id": 230290401,
					"content": "怎么样，你们记录到圣树的全貌了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290402
					],
					"speakerTitle": "雅丝敏"
				},
				{
					"id": 230290402,
					"content": "已经记录到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230290403
					]
				},
				{
					"id": 230290403,
					"content": "喔！让我看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290404
					],
					"speakerTitle": "雅丝敏"
				},
				{
					"id": 230290404,
					"content": "真不错，角度很好，记录得也很清晰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290405
					],
					"speakerTitle": "雅丝敏"
				},
				{
					"id": 230290405,
					"content": "这些报酬给你，谢谢你帮忙，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290406
					],
					"speakerTitle": "雅丝敏"
				},
				{
					"id": 230290406,
					"content": "主干没有问题…周围的枝干轮廓也没有变…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290407
					],
					"speakerTitle": "雅丝敏"
				},
				{
					"id": 230290407,
					"content": "剩下的就等拉德普和法尔希搜集好数据，我们就可以继续下一个课题了…",
