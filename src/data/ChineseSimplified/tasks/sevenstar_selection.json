			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"夜兰"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110181001,
					"content": "这么快就看完了？有什么感受吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181002
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 110181002,
					"content": "感觉大家都好认真…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181003
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110181003,
					"content": "那当然，毕竟涉及到天枢星的选拔，所有人都铆足了力气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181004
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 110181004,
					"content": "更何况，一旦他们上台，就要遵照规划来处理事务了，谁都不想留下什么遗憾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181005
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 110181005,
					"content": "夜兰的感受呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110181006
					]
				},
				{
					"id": 110181006,
					"content": "呵呵，暂时保密。等「现场问答」结束后，我们再好好聊聊吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181007
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 110181007,
					"content": "可以让候选人过来了。一个一个来吧，先从乾玮开始。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181008
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 110181008,
					"content": "是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181009
					],
					"speakerTitle": "礼安"
				},
				{
					"id": 110181009,
					"content": "礼安将乾玮带了过来…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						110181010
					]
				},
				{
					"id": 110181010,
					"content": "哦？你们两位就是这次的考察官吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181011
					],
					"speakerTitle": "乾玮"
				},
				{
					"id": 110181011,
					"content": "本来以为像这么重要的事情，会是凝光大人亲自来考察，没想到居然来了我不认识的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181012
					],
					"speakerTitle": "乾玮"
				},
				{
					"id": 110181012,
					"content": "我的规划你们应该看过了吧。要是有理解不了的地方，可以找我讲解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181013
					],
					"speakerTitle": "乾玮"
				},
				{
					"id": 110181013,
					"content": "好、好大的口气！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181014
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110181014,
					"content": "抱歉，我没有特别针对谁，只是在阐述一个事实而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181015,
						110181016
					],
					"speakerTitle": "乾玮"
				},
				{
					"id": 110181015,
					"content": "你的聊天水平…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110181017
					]
				},
				{
					"id": 110181017,
					"content": "留云借风，你认识那位仙人吗？哦…我想起来了，你应该就是人们口口相传的那位旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181018
					],
					"speakerTitle": "乾玮"
				},
				{
					"id": 110181018,
					"content": "既然你声名在外，想必有些才学，说不定能理解我的构想…哼，虽然我也没抱太大希望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181019
					],
					"speakerTitle": "乾玮"
				},
				{
					"id": 110181019,
					"content": "夜兰对乾玮进行一番询问后，让他去叫来了明博。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						110181020
					]
				},
				{
					"id": 110181020,
					"content": "啊…到我了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181021
					],
					"speakerTitle": "明博"
				},
				{
					"id": 110181021,
					"content": "嗯，简单介绍一下你自己吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181022
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 110181022,
					"content": "我是明博…隶属于总务司。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181023
					],
					"speakerTitle": "明博"
				},
				{
					"id": 110181023,
					"content": "我在总务司工作了九年…五个月…零三天。先后处理过…两千三百四十七宗事件。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181024
					],
					"speakerTitle": "明博"
				},
				{
					"id": 110181024,
					"content": "还有十二起正在处理…预计大概…十六天后会全部解决。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181025
					],
					"speakerTitle": "明博"
				},
				{
					"id": 110181025,
					"content": "目前我的工作与城市规划相关，也在负责账目验收与核对。准确来说是三部分账目，分别是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181026
					],
					"speakerTitle": "明博"
				},
				{
					"id": 110181026,
					"content": "感觉他讲话有些磕磕绊绊的，是我的错觉吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181027
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110181027,
					"content": "算了，先停下自我介绍吧，我直接问问题好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181028
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 110181028,
					"content": "啊…好。抱歉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181029
					],
					"speakerTitle": "明博"
				},
				{
					"id": 110181029,
					"content": "夜兰勉强对明博进行一番询问后，让他去叫来了知易。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						110181030
					]
				},
				{
					"id": 110181030,
					"content": "你们好。呼…说实话，我还真有点紧张。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181031
					],
					"speakerTitle": "知易"
				},
				{
					"id": 110181031,
					"content": "不知两位想问些什么？既然是考察，我会在我能力范围内予以回答。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181032
					],
					"speakerTitle": "知易"
				},
				{
					"id": 110181032,
					"content": "我看你的规划涉及各个领域，但你好像并未从事许多职业，你能保证自己的规划切实可行吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181033
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 110181033,
					"content": "毫不留情的提问…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110181034
					]
				},
				{
					"id": 110181034,
					"content": "两位有这样的疑问，我觉得很正常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181035
					],
					"speakerTitle": "知易"
				},
				{
					"id": 110181035,
					"content": "不过对于规划，我很有信心。我曾外出考察许多地方，与当地更为专业的人进行交流，最终得出结论。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181036
					],
					"speakerTitle": "知易"
				},
				{
					"id": 110181036,
					"content": "当然，不同问题之间错综复杂，对应的结论也有冲突。所以我想要的是「平衡」，也就是在所有问题中找到一个「最优解」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181037
					],
					"speakerTitle": "知易"
				},
				{
					"id": 110181037,
					"content": "那你怎么判断自己得出的「最优解」是真是假呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181038
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 110181038,
					"content": "规划施行前，有我的同僚以及月海亭的秘书们进行评估；规划施行后，一切以最终效果为主。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181039
					],
					"speakerTitle": "知易"
				},
				{
					"id": 110181039,
					"content": "如果真的是我判断失误，我会为此承担相应责任。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181040
					],
					"speakerTitle": "知易"
				},
				{
					"id": 110181040,
					"content": "回答得不错。那我们换下一个问题…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181041
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 110181041,
					"content": "夜兰对知易进行一番询问后，让他离开了。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						110181042
					]
				},
				{
					"id": 110181042,
					"content": "感觉是一个很好相处的人呢！说话也很有条理，让人听着很舒服！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181043,
						110181044
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110181043,
					"content": "没错…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110181045
					]
				},
				{
					"id": 110181045,
					"content": "现在可以简单地做个总结了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181046
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 110181046,
					"content": "就像你看到的一样，乾玮见识不凡，他在规划里写的许多策略都切中要害。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181047
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 110181047,
					"content": "但他为人很有傲气，非常固执，也不太愿意体察身边人的感受。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181048
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 110181048,
					"content": "明博的规划更加全面，也更加稳健。能看出他是一个很细腻的人，在细节处理上很出彩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181049
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 110181049,
					"content": "但他与乾玮似乎是两个极端。明博不善言辞，在与人交流中显得很弱势。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181050
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 110181050,
					"content": "总结得真好，好像的确是这样，不愧是夜兰！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181051
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110181051,
					"content": "最后是知易。他的规划详实、方略可靠，涉及领域十分广泛，颇为难得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181052
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 110181052,
					"content": "这可不是走马观花，不下苦工是做不到的。而且他性格谦和，待人接物也没什么问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181053
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 110181053,
					"content": "不过真正让我感兴趣的，是他的许多观点都与天叔不谋而合。如果知易顺利上位，天叔应该也能放心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181054
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 110181054,
					"content": "太好啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181055
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110181055,
					"content": "走，我们回去向天叔汇报吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夜兰"
				},
				{
					"id": 110181044,
					"content": "没什么感觉。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110181045
					]
				},
				{
					"id": 110181016,
					"content": "该不会是师从留云借风…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110181017
					]
				}
			]
		},
