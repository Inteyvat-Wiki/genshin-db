			"trigger": {
				"objectNames": [
					"乾玮",
					"明博",
					"知易",
					"夜兰"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110180401,
					"content": "站得我腿都麻了…真不知道那考察官在想些什么，这么重要的场合，连张椅子都没有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180402
					],
					"speakerTitle": "乾玮"
				},
				{
					"id": 110180402,
					"content": "我也曾和各种各样的人打交道，还是第一次站着等别人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180403
					],
					"speakerTitle": "乾玮"
				},
				{
					"id": 110180403,
					"content": "啊，我倒是…觉得还好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180404
					],
					"speakerTitle": "明博"
				},
				{
					"id": 110180404,
					"content": "你那是习惯了。总是像这样接受现状的话，将来也什么都改变不了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180405
					],
					"speakerTitle": "乾玮"
				},
				{
					"id": 110180405,
					"content": "你这个人，怎么这么…不讲道理…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180406
					],
					"speakerTitle": "明博"
				},
				{
					"id": 110180406,
					"content": "好了两位，为这点小事争吵，实在有些不值。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180407
					],
					"speakerTitle": "知易"
				},
				{
					"id": 110180407,
					"content": "乾玮，你刚刚的话有些重了。明博，你也别太计较…站了许久，谁都有些焦躁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180408
					],
					"speakerTitle": "知易"
				},
				{
					"id": 110180408,
					"content": "我看不如这样：既然没规定我们一定要站着等，那我们不如去附近商会借几张椅子？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180409
					],
					"speakerTitle": "知易"
				},
				{
					"id": 110180409,
					"content": "也好。虽然那些椅子材质一般，但非常之时，能用就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180410
					],
					"speakerTitle": "乾玮"
				},
				{
					"id": 110180410,
					"content": "跟着夜兰进到了考察现场…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						110180411
					]
				},
				{
					"id": 110180411,
					"content": "看来三位候选人都已经到齐了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180412
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 110180412,
					"content": "所以刚刚那三位就是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110180413
					]
				},
				{
					"id": 110180413,
					"content": "嗯，很快就会跟他们正式见面。在那之前，我先跟你讲解一下这次的考察流程。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180414
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 110180414,
					"content": "这次考察，我分成了两个环节，分别是「时事方略」与「现场问答」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180415
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 110180415,
					"content": "第一个环节是让他们提交璃月发展规划，第二个环节则是由我们进行现场询问。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180416
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 110180416,
					"content": "因为书写璃月发展规划需要时间，所以我已经提前布置下去了，这些就是收上来的报告书。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180417
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 110180417,
					"content": "呜哇，总觉得有一摞特别的厚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180418
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110180418,
					"content": "顺带一提，我对他们讲了一个要求：不管谁成为天枢星，都要将自己规划的内容悉数落实。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180419
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 110180419,
					"content": "除非发生什么重大变故，否则不能更改规划书上的内容。所以眼前这三摞文件，其实代表着他们三个人的「立场」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180420
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 110180420,
					"content": "还有点时间，你可以大致看一看，对他们有一个初步的印象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180421
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 110180421,
					"content": "我在旁边等你，看完之后，就来找我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夜兰"
				}
			]
		},
		{
