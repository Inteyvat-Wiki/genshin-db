				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"慧心"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110180101,
					"content": "#{NICKNAME}、派蒙，好久不见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180102
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110180102,
					"content": "咦？慧心，好久不见啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110180103,
					"content": "没想到在这里遇见你，最近工作还顺利吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110180104,
					"content": "多亏了你们和甘雨前辈的帮助，我已经越来越得心应手了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180105
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110180105,
					"content": "不过最近工作的时候总会分神，感觉静不下心来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180106
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110180106,
					"content": "发生什么事了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110180107
					]
				},
				{
					"id": 110180107,
					"content": "唉，说来话长。父亲他…因为身体原因，想要卸任「天枢星」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180108
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110180108,
					"content": "欸——天叔出什么事了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110180109,
					"content": "按父亲的说法，倒是没什么身体上的不适，只是感觉精力越来越匮乏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180110
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110180110,
					"content": "「每个人都有老去的一天」…虽然父亲常常这么说，但看到他脸上的皱纹越来越深，我心里还是有一种说不出的滋味。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180111
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110180111,
					"content": "对了，父亲他现在在岩上茶室二楼。要不要一起来探望一下？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180112
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110180112,
					"content": "父亲似乎很喜欢你们，能和你们聊聊天的话，他应该也会很开心的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180113
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110180113,
					"content": "好呀！那我们过去看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 1101803,
			"completionStepIds": [
				1101803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101803",
							"2"
						],
						"stepId": 1101803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"天叔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110180301,
					"content": "天叔！我们来找你聊天啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110180302,
					"content": "哦？这可真是稀客，欢迎。慧心，你去找楼下的掌柜，再加一壶新到的茶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180303
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 110180303,
					"content": "听说你们最近又去了不少地方，我也想听听你们的冒险故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180304,
						110180305
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 110180304,
					"content": "我们更担心天叔的身体。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110180306
					]
				},
				{
					"id": 110180306,
					"content": "看来你们已经听慧心说了…放心吧，我的身体没什么大碍，只是岁月不饶人罢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180307
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 110180307,
					"content": "随着年纪越来越大，我开始对许多事情感到力不从心。最近这段时间，更是感觉精力直线下滑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180308
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 110180308,
					"content": "虽然大家都说我德高望重，但我也想趁自己还没老糊涂，把天枢星的位置交接出去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180309
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 110180309,
					"content": "天枢星交接…会很麻烦吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110180310,
					"content": "在璃月七星中，天枢星的存在比较特殊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180311
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 110180311,
					"content": "历代天枢星很少公开露面，大多是在背后出谋划策，所以不适合公开选拔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180312
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 110180312,
					"content": "而且，我们希望天枢星的候选人尽量不要受各方势力影响，所以考核与委任也会相对隐秘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180313
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 110180313,
					"content": "基于这些原因，天枢星的更替，通常是上代天枢星给出意见，其余七星成员共同确认。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180314
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 110180314,
					"content": "也就是说…是由天叔推荐候选人，然后由刻晴、凝光小姐还有其他七星一起任命？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110180315,
					"content": "没错。只可惜以我现在的身体状况，来不及对候选人一一考校了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180316
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 110180316,
					"content": "不过没关系，我特地找来了一位能力很强的考官。说起来，听说你们已经和她见过面了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180317
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 110180317,
					"content": "咦？是谁呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110180318,
					"content": "真让人难过…这才多久不见，你们就把我忘了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180319
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 110180319,
					"content": "是夜兰！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110180320,
					"content": "没错，受天叔邀请，由我来对三位候选人进行调查。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180321
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 110180321,
					"content": "#{NICKNAME}，你跟我一起来如何？这可是能提前认识下一代天枢星的好机会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180322
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 110180322,
					"content": "#唔…{NICKNAME}，你觉得呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180323,
						110180325
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110180323,
					"content": "是个机会。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110180324
					]
				},
				{
					"id": 110180324,
					"content": "我也这么觉得！和七星搞好关系，总不是什么坏事吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180328
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110180328,
					"content": "那就这么说定了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180329
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 110180329,
					"content": "不过天叔，你平时喜欢在暗处谋划，我也习惯暗中活动。不觉得我也有成为天枢星的潜质吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180330
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 110180330,
					"content": "欸！夜兰也想当天枢星吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180331
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110180331,
					"content": "我倒是不介意，但你和凝光合作那么久，她恐怕不会轻易放人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180332
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 110180332,
					"content": "这样好了…如果考察的结果是无人胜任，我就推荐你来帮我干这个活。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180333
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 110180333,
					"content": "没问题。这事先不急，考察的内容我已经提前布置下去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180334
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 110180334,
					"content": "等下我们在一楼见面吧。在那之前…你们可以先把天聊完。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180335
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 110180335,
					"content": "茶就不用付账了，作为岩上茶室的「新主人」，一壶好茶还是请得起的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180336
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 110180336,
					"content": "向天叔讲述了最近的冒险故事后，回到了茶室门口…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						110180337
					]
				},
				{
					"id": 110180337,
					"content": "聊完了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180338
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 110180338,
					"content": "感觉天叔确实没什么精神，有些困恹恹的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180339
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110180339,
					"content": "嗯。虽然这么说很残酷，但以天叔现在的精神状态，确实不适合再担任繁重的工作了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180340
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 110180340,
					"content": "天叔推荐的候选人总共有三位，分别是：乾玮、明博和知易。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180341
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 110180341,
					"content": "其中乾玮是富商出身，明博在璃月总务司任职，知易正在求学游历。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180342
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 110180342,
					"content": "你可以大致记一下…当然，记不住也没关系，等下我们会到月海亭考察他们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180343
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 110180343,
					"content": "乾玮、明博还有知易…勉强记住了，不过「考察」又是什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180344
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110180344,
					"content": "这个我们到月海亭再说就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180345
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 110180345,
					"content": "打起精神来，这可是涉及七星更迭的大事，任何蛛丝马迹都不能放过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180346
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 110180346,
					"content": "#明白！{NICKNAME}，我们一定要擦亮眼睛才行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110180325,
					"content": "不感兴趣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110180326
					]
				},
				{
					"id": 110180326,
					"content": "确实，谁是下一代天枢星对我们好像没什么影响。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180327
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110180327,
					"content": "不过天叔会挑选什么样的候选人，真让人好奇！我们还是去看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180328
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110180305,
					"content": "天叔的身体不要紧吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110180306
					]
				}
			]
		},
		{
			"id": 1101804,
			"completionStepIds": [
				1101804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
