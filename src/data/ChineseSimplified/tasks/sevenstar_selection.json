			},
			"dialogs": [
				{
					"id": 110180601,
					"content": "跟天叔讲述了整个考核流程…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						110180602
					]
				},
				{
					"id": 110180602,
					"content": "咳咳…嗯，和我预想中的差不多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180603
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 110180603,
					"content": "那我就直接问了，天叔。知易的规划思路跟你很像，这里面有什么理由吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180604
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 110180604,
					"content": "给你们候选人名单的时候不方便说，担心干扰你们的判断，不过现在可以聊聊了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180605
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 110180605,
					"content": "那三位候选人，都曾跟我学习过一段时间，难免与我有些相似。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180606
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 110180606,
					"content": "不过乾玮忙于经商，明博有总务司的工作要做。相比之下，知易待在我身边的时间更久。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180607
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 110180607,
					"content": "哇！天叔是怎么和他们认识的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180608
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110180608,
					"content": "乾玮是一位老友推荐给我的，明博则是我在工作中注意到的。至于知易…哈哈，倒像是一个意外。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180609
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 110180609,
					"content": "刚开始我们只是偶然认识的钓友，后来慢慢熟络，才开始聊各种话题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180610
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 110180610,
					"content": "知易出身寒门，父母过世很早。但他天赋出众，学什么都很快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180611
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 110180611,
					"content": "看到他，我就想到年轻时的自己。于是经常在钓鱼的时候指点他几句，他也会很快领悟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180612,
						110180613
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 110180612,
					"content": "感觉更像是「朋友」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110180614
					]
				},
				{
					"id": 110180614,
					"content": "没错。不知不觉，他就成长到了这样的高度。现在想想，真是令人既欣慰又感慨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180615
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 110180615,
					"content": "年轻人一个个成长起来，我也老了。时间过得可真快，生老病死果然是人人都绕不开的坎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180616
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 110180616,
					"content": "我怎么觉得天叔的身体还很硬朗，能再为工作辛劳几年？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180617
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 110180617,
					"content": "你啊你，用不着安慰我。精力不够用也挺好的，卸下了担子，我终于能像个普通老头一样，自由自在地去钓鱼了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180618
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 110180618,
					"content": "天叔很喜欢钓鱼呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180619
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110180619,
					"content": "想要消磨时光，钓鱼绝对是不二之选。而且刚钓上的鱼非常新鲜，在水边处理一下，就能煮出一锅鲜美的鱼汤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180620
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 110180620,
					"content": "新鲜的鱼汤！唔，听上去就非常好喝！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180621
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110180621,
					"content": "是吧？而且前段时间，知易还从一位老渔夫手上买到了特别的食谱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180622
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 110180622,
					"content": "最近每次钓鱼，知易都会带一些处理好的辅料。加了辅料之后，味道比以前还要鲜美。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180623
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 110180623,
					"content": "真令人回味无穷…可惜我这把老骨头，恐怕喝不了几次啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180624
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 110180624,
					"content": "还能喝很多很多次的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110180625
					]
				},
				{
					"id": 110180625,
					"content": "下次能带上我吗？我也想尝尝看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180626
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110180626,
					"content": "言归正传，天叔。听完汇报之后，你有结论了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180627
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 110180627,
					"content": "既然委托你来考察，那我相信你的判断。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180628
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 110180628,
					"content": "若非你们问我，知易为何许多思路与我相似，我本不打算提起我与他们三位的私交。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180629
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 110180629,
					"content": "举贤讲求公正，请你们务必刨除这些外因，将候选人的才华与能力调查清楚再下结论。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180630
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 110180630,
					"content": "记住…一定要「调查清楚」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180631
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 110180631,
					"content": "我明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180632
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 110180632,
					"content": "#走吧，{NICKNAME}，我们换个地方说话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180633
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 110180633,
					"content": "那天叔，我们先告辞啦，一定要注意身体呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180634
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110180634,
					"content": "跟夜兰来到了茶室外…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						110180635
					]
				},
				{
					"id": 110180635,
					"content": "嗯…果然就决定是知易了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180636
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110180636,
					"content": "你看，他规划写得好，说话又好听…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180637
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110180637,
					"content": "不急，考察又没有时间限制。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180638
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 110180638,
					"content": "咦，难道夜兰还准备了什么测试吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180639
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110180639,
					"content": "那倒没有，对他们本人的考察已经结束了。不过给你们一个忠告：眼见未必为实。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180640
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 110180640,
					"content": "情报工作最忌讳的，就是只从当事人身上了解信息。真相外面总是蒙着层层迷雾，所以需要通过各种渠道去收集情报。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180641
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 110180641,
					"content": "文渊、商华。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180642
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 110180642,
					"content": "在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180643
					],
					"speakerTitle": "文渊"
				},
				{
					"id": 110180643,
					"content": "夜兰大人有何吩咐？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180644
					],
					"speakerTitle": "商华"
				},
				{
					"id": 110180644,
					"content": "突然就出现了不认识的人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180645
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110180645,
					"content": "吓到你了吗？这两位是我的手下，文渊和商华。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180646
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 110180646,
					"content": "作为我的得力助手，他们平时在附近警戒，必要时也会去执行各种任务。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180647
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 110180647,
					"content": "商华精通商务，喜欢以交易换取情报；文渊则多靠游说来获知消息。除了他们之外，还有目前不在场的武沛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180648
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 110180648,
					"content": "那大块头在海上盯梢有一段时间了吧，没问题吗？印象里他可不会游泳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180649
					],
					"speakerTitle": "文渊"
				},
				{
					"id": 110180649,
					"content": "嘿，那家伙命大着呢，这点小风小浪还不算什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180650
					],
					"speakerTitle": "商华"
				},
				{
					"id": 110180650,
					"content": "商华，你去各个商会，调查乾玮的背景；文渊，你去璃月总务司，查一下明博的工作档案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180651
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 110180651,
					"content": "是！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180652
					],
					"speakerTitle": "商华"
				},
				{
					"id": 110180652,
					"content": "欸？那知易呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180653
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110180653,
					"content": "知易？作为最有希望的候选人，知易当然是由我们亲自调查了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180654
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 110180654,
					"content": "先去港口看看吧，那里人多嘴杂，是各种消息传播的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180655
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 110180655,
					"content": "说到打听消息，不如我们去问问「万有铺子」的老板博来？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180656
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110180656,
					"content": "他一直在北码头做生意，说不定听说过什么消息…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180657
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110180657,
					"content": "嗯，这倒是个不错的选择。去问问看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夜兰"
				},
				{
					"id": 110180613,
					"content": "感觉更像是「家人」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110180614
					]
				}
			]
		},
