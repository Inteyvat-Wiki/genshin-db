			"dialogs": [
				{
					"id": 110180901,
					"content": "（知易的规划书，涉及到内政、外交、监察等各方各面，非常详实。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180902
					],
					"speakerTitle": "知易的规划书"
				},
				{
					"id": 110180902,
					"content": "（看上去以「解决问题」为核心，针对各种问题都给出了简洁明确的解决方案。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180903
					],
					"speakerTitle": "知易的规划书"
				},
				{
					"id": 110180903,
					"content": "（因为实在太厚，只来得及粗略翻阅…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "知易的规划书"
