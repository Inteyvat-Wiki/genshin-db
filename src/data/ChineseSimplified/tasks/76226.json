			"dialogs": [
				{
					"id": 762260201,
					"content": "欸？这不是梅拉吗？居然在月亮上碰面了，真是意想不到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762260202,
					"content": "一定是哥伦比娅带你来的吧？毕竟她说过要带你来月亮上办画展呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762260203,
					"content": "对了，说到画展…你的画呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762260204,
					"content": "！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260205
					],
					"speakerTitle": "梅拉"
				},
				{
					"id": 762260205,
					"content": "怎么了？难道…画丢了？",
					"roleType": "TALK_ROLE_NPC",
