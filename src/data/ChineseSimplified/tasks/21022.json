			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"索拉雅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210229501,
					"content": "找到了五座石碑。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210229502
					]
				},
				{
					"id": 210229502,
					"content": "太好了，让我来看看…呃，这些文字，顺序都乱了，我要捋捋…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220302
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210220302,
					"content": "…好像很多文字都缺失了，读起来断断续续的，而且，也不知道这种顺序对不对…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220303
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210220303,
					"content": "总之，我先大致排列了一下，这些文字连起来应该是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220304
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210220304,
					"content": "「…初，因农而兴，聚之为集…有神临，名『归终』，善扬尘，遮天不知几千里…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220305
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210220305,
					"content": "「…引诫四条，告以诸民…后又有神临，以岩为器，迁璃月族民于集，共护诸民…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220306
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210220306,
					"content": "「…取二神之名，号此集为『归离』…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220307
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210220307,
					"content": "唔，看起来，这是在讲述这片「归离集」的来历，还有一位护佑着「归离集」，善于操控「尘」的神明。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220308
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210220308,
					"content": "不过，上面还说，还有一位魔神曾经到过这里，甚至还把自己的子民迁过来了一部分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220309
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210220309,
					"content": "就连「归离集」这个名字，都是从这两位神的名字中各取了一个字，合起来之后得到的名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220310
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210220310,
					"content": "真是罕见，文献记载里，还没有两位魔神能这么和平相处，而且还互相合作…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220311
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210220311,
					"content": "与其说是两位魔神，不如说是两位关系很好的朋友呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220312
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210220312,
					"content": "不过，真奇怪，为什么后面突然没有了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220313
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210220313,
					"content": "而且，「归离集」又怎么会变为废墟的？有着两位魔神共同护佑，一般的天灾人祸，应该都不会毁灭整个「归离集」才对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220314
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210220314,
					"content": "一定是发生了什么连魔神都无法解决的灾难…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220315
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210220315,
					"content": "旅行者，你能再去周围找找线索吗？如果不出意外的话，这里应该还有更多你之前发现的那种石碑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220316
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210220316,
					"content": "也许，那些石碑上记载着后面的故事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220317
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210220317,
					"content": "但这些石碑上所记载的东西，和一些文献中所记载的好像又有所差别…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220318
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210220318,
					"content": "唉，这么多传说，这么多说法…到底哪一个才是真的呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "索拉雅"
				}
			]
		},
