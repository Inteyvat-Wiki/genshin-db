			},
			"dialogs": [
				{
					"id": 210229601,
					"content": "又找到两座石碑…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210229602
					]
				},
				{
					"id": 210229602,
					"content": "快给我看看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229603
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210229603,
					"content": "「…战于『归离原』，彼时黑尘漫天，千岩俱裂…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229604
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210229604,
					"content": "这是…好像是在说，在归离原上发生过一场大战，而且规模很大…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229605
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210229605,
					"content": "「归离集」应该就是毁于这次大战。但是另外一段话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229606
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210229606,
					"content": "…似乎是一位不愿意离开「归离集」的人所留下来的，这个人一直守在这里，而且…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229607
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210229607,
					"content": "而且还有宝藏。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210220502
					]
				},
				{
					"id": 210220502,
					"content": "…你对这个还真是敏感，不过，光是从字面上理解。在这片「归离原」上，确实有着一批宝藏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220503
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210220503,
					"content": "但是，上面还说「…引之以『归终四诫』…」，后面还说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220504
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210220504,
					"content": "「教之以智、律之以德、坚其筋骨，众志一心，四者汇之而成『归离集』。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220505
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210220505,
					"content": "唔…根本不知道从哪里理解起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220506
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210220506,
					"content": "我们回望舒客栈去吧。在那里稍作休整之后，我们再来解读这个「归终四诫」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "索拉雅"
				}
			]
		}
	]
}