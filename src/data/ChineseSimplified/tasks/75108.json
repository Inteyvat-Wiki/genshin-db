			"dialogs": [
				{
					"id": 751080101,
					"content": "说是要做料理，不过，选哪种料理才好呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751080102,
					"content": "我记得，以前我们给膨膨兽「呜呜葡萄」喂过鱼肉，那鱼料理应该很不错！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751080103,
					"content": "#要让膨膨兽和{REALNAME[ID(2)|SHOWHOST(true)]}吃得开心…感觉纳塔特色的「薄荷酱烤鱼」很不错呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080104,
						751080105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751080104,
					"content": "这个我拿手。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080106
					]
				},
				{
					"id": 751080106,
					"content": "好，那就开工吧，我也会在一边给你出主意的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080107,
						751080109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751080107,
					"content": "花刀打深一点。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080108
					]
				},
				{
					"id": 751080108,
					"content": "支持哦，深一点更容易入味。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080111,
						751080113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751080111,
					"content": "咸一点，吃得更开心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080112
					]
				},
				{
					"id": 751080112,
					"content": "#嗯，刚刚进嘴那一下的厚实味道，膨膨兽和{REALNAME[ID(2)|SHOWHOST(true)]}应该都喜欢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080115,
						751080117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751080115,
					"content": "薄荷酱，多多益善。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080116
					]
				},
				{
					"id": 751080116,
					"content": "清清凉凉的口感，肯定很不错！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080119,
						751080121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751080119,
					"content": "辣椒，必不可少。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080120
					]
				},
				{
					"id": 751080120,
					"content": "适当的辣味，一点点就开胃！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080123,
						751080125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751080123,
					"content": "猛火强烤，外酥里嫩！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080124
					]
				},
				{
					"id": 751080124,
					"content": "嘿嘿，听起来太香了，我都要流口水了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751080127,
					"content": "#经过一段精彩的烹饪过程，为膨膨兽和{REALNAME[ID(2)|SHOWHOST(true)]}特制的烤鱼完成了…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 751080125,
					"content": "文火慢烤，香软多汁！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080126
					]
				},
				{
					"id": 751080126,
					"content": "#呀哈，真不错，{NICKNAME}独门秘技之烤鱼…以后说不定能当成拿手料理，做给其他朋友吃！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751080121,
					"content": "枫丹生物有可能怕辣…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080122
					]
				},
				{
					"id": 751080122,
					"content": "可是，完全没有辣椒的话，好像缺了一点什么，我们就少放一点吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080123,
						751080125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751080117,
					"content": "水里的膨膨兽怕薄荷清凉吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080118
					]
				},
				{
					"id": 751080118,
					"content": "好像不是这个逻辑喔，水里的膨膨兽上岸应该会很干很热，加一点薄荷酱反而能让它降温吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080119,
						751080121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751080113,
					"content": "味够足，就无需多盐。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080114
					]
				},
				{
					"id": 751080114,
					"content": "没错，后边还有其他调料，不一定要放很多盐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080115,
						751080117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751080109,
					"content": "花刀打浅一点。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080110
					]
				},
				{
					"id": 751080110,
					"content": "也不错，说不定稍微淡一点，里边保留一部分鱼肉的原味，膨膨兽更习惯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080111,
						751080113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751080105,
					"content": "不是很熟练，但没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080106
					]
				}
			]
		},
