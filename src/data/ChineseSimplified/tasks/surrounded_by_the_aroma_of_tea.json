			"trigger": {
				"objectNames": [
					"钟离"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705070101,
					"content": "钟…钟离！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705070102,
					"content": "许久不见，近来可好？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070103
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 705070103,
					"content": "不不不对…钟离，你怎么会在这里啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705070104,
					"content": "既是闲游，就不该局限于眼前。风之国土自由丰饶，是一大好去处。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070105
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 705070105,
					"content": "能在这里遇见你们，实属意外之喜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070106,
						705070107
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 705070106,
					"content": "要来一杯什么吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070108
					]
				},
				{
					"id": 705070108,
					"content": "一杯烟霞蔽芾。茶浓些更好，有劳你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "钟离"
				},
				{
					"id": 705070107,
					"content": "可以边喝茶边聊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070108
					]
				}
			]
		},
		{
			"id": 7050702,
			"completionStepIds": [
				7050703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7050703",
							"2"
						],
						"stepId": 7050703,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"钟离"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705070201,
					"content": "久等啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705070202,
					"content": "请慢用。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070203
					]
				},
				{
					"id": 705070203,
					"content": "茶汤透亮，色泽宜人，入口甘醇，更伴有花果香。嗯，相当难得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070204
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 705070204,
					"content": "哇，钟离在喝茶方面也是行家呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705070205,
					"content": "像我「咕嘟」一口就喝下去了，只能说出好喝两个字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705070206,
					"content": "用心品尝，是对沏茶者的敬意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070207
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 705070207,
					"content": "好茶十分难得，能将好茶泡得怡景怡情的沏茶者，更是难得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070208,
						705070209
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 705070208,
					"content": "谬赞了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070210
					]
				},
				{
					"id": 705070210,
					"content": "好吧，我明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705070211,
					"content": "那…教教我你是怎么品茶的吧。我看是先闻再喝，对吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705070212,
					"content": "不错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070213
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 705070213,
					"content": "茶叶各有特征，喝得多了，自然有些心得。茶品好坏，闻香味便可略知一二了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070214
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 705070214,
					"content": "有些茶闻起来湿腻，焦香过重，应是次品。另有一些，闻起来甘醇典雅，幽香扑面，这类茶多为上品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070215
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 705070215,
					"content": "若想再讲究些，按璃月古时传统，还应备上「品香盏」。这件器皿能盛放茶汤，专用于品香。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070216
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 705070216,
					"content": "怎么办，感觉我之前都亏了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705070217,
					"content": "无妨。学问甚多，何时开始都不算迟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070218
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 705070218,
					"content": "初学者可以试着这样品鉴：先观察水色，再轻嗅茶香，最后才是品茗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070219
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 705070219,
					"content": "「由浅入深」，对万事万物的掌握皆是如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070220,
						705070221
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 705070220,
					"content": "收获不小…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070222
					]
				},
				{
					"id": 705070222,
					"content": "璃月西北的「翘英庄」，以茶业闻名。日后若有机会，不妨前去看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070223
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 705070223,
					"content": "今日所说种种，大多是我这个老派璃月人的习惯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070224
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 705070224,
					"content": "各地饮茶习惯与茶文化均有不同。身处不同国度，理应尊重当地风俗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070225
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 705070225,
					"content": "我完全理解了！但能不能记住就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705070226,
					"content": "意料之中…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070227
					]
				},
				{
					"id": 705070227,
					"content": "#{NICKNAME}，今日多谢你了。有幸喝到这等好茶，不虚此行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070228
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 705070228,
					"content": "他日你若坐镇茶馆，我定来捧场。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070229
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 705070229,
					"content": "但我们很忙，大概没有时间去茶馆打零工吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070230
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705070230,
					"content": "谁知道呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070231
					]
				},
				{
					"id": 705070231,
					"content": "总之，如有机会，我一定支持。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070232
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 705070232,
					"content": "今天就到这里吧。不多叨扰了，祝你工作顺利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070233,
						705070234
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 705070233,
					"content": "嗯，慢走。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070235
					]
				},
				{
					"id": 705070235,
					"content": "嗯，开销就按习惯，记在往生堂账上吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070236
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 705070236,
					"content": "慢走慢走，代我们跟堂主问好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705070234,
					"content": "那个，结账的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070235
					]
				},
				{
					"id": 705070221,
					"content": "还想学更多…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070222
					]
				},
				{
					"id": 705070209,
					"content": "有些不好意思…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070210
					]
				}
			]
		}
	]
}