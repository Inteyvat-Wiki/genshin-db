			"dialogs": [
				{
					"id": 200460301,
					"content": "旅行者，还请你多照顾一下安娜，这孩子最近好像兴奋过头了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460302
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 200460302,
					"content": "你不希望她做冒险家吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200460303
					]
				},
				{
					"id": 200460303,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460304
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 200460304,
					"content": "我尊重我妹妹的梦想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460305
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 200460305,
					"content": "她的病好不容易痊愈了，也得到了追逐自己梦想的机会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460306
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 200460306,
					"content": "作为她的哥哥，我…会全力支持她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460307
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 200460307,
					"content": "就这样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安东尼"
