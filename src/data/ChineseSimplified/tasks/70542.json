			"dialogs": [
				{
					"id": 705420101,
					"content": "喵…喵呜？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420102
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705420102,
					"content": "猫之间是这样打招呼的吗？发音会不会不够标准…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420103
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705420103,
					"content": "喵？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420104
					],
					"speakerTitle": "「雪糕」"
				},
				{
					"id": 705420104,
					"content": "结果「雪糕」完全没听懂嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705420105,
					"content": "莫娜在尝试猫语吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420106,
						705420107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705420106,
					"content": "莫娜老师，不是这样念的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705420108
					]
				},
				{
					"id": 705420108,
					"content": "喂！「嗷嗷呜呜」听起来像老虎狮子，完全是吓唬猫猫的发音嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705420109,
					"content": "#{NICKNAME}和派蒙！原来传说是真的，你们确实在「猫茸茸城堡」打工啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420110
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705420110,
					"content": "倒也不能说是打工啦，我们只是在帮瓦乐瑞娜和罗莎莉亚的忙而已，更像是…顾问！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705420111,
					"content": "没错，顾问这个称号听起来就很厉害，哼哼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705420112,
					"content": "话说回来，「伟大的占星术士莫娜」，你是想要领养一只猫猫，来辅佐你观察星象吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705420113,
					"content": "凭我对星象学的理解，教会猫猫看懂星象，似乎也不是难事，甚至还能…让猫猫帮我写稿？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420114
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705420114,
					"content": "（偷瞄雪糕）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420115
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705420115,
					"content": "（堂堂正正看向雪糕）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705420116,
					"content": "喵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420117
					],
					"speakerTitle": "「雪糕」"
				},
				{
					"id": 705420117,
					"content": "咳咳，还是算了，只是看懂星象，而不懂深入浅出地遣词造句，写出的稿子就不足以传达我的真知灼见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420118
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705420118,
					"content": "需要写稿的助手，不如再去趟枫丹，说服某位蒸汽鸟报的文员，或者找一位会用打字机的美露莘来蒙德…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420119
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705420119,
					"content": "要是我当真领养了猫猫，最多只是和猫猫们一起玩，好好放松，排解学术研究的劳累。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420120
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705420120,
					"content": "不能当个坏主人，自己累了，还要让猫猫一起累。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420121
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705420121,
					"content": "踏进这间屋子前，我还真没想到，和猫猫们交流是这么愉快的事…大家都要一直这样开开心心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420122
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705420122,
					"content": "嘿嘿，看来莫娜还是非常自觉的，把猫猫交给你，大家都放一万个心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705420123,
					"content": "不过我也听说，有的猫猫性格特别活泼，总是在屋里上蹿下跳，还喜欢抓挠啃咬家具…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420124
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705420124,
					"content": "万一把我的稿子，或者占星相关的资料咬坏，那可就麻烦了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420125
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705420125,
					"content": "咬坏贵重的书…这么恐怖的事，我也不敢想了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705420126,
					"content": "「雪糕」看起来非常乖，但好像不太能理解我的意思…或许我们不是特别默契。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420127
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705420127,
					"content": "所以我还要再观察一下，有没有听话的猫猫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420128
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705420128,
					"content": "然后计算一下猫窝，猫粮之类的开销。不能过分奢侈，也不能委屈了猫猫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420129,
						705420130
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705420129,
					"content": "没事没事，慢慢来就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705420131
					]
				},
				{
					"id": 705420131,
					"content": "对喔，瓦乐瑞娜小姐说过，以后还会收养更多流浪猫的，就算现在找不到合适的猫猫，也可以多来玩玩，多看看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705420132,
					"content": "喵~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「雪糕」"
				},
				{
					"id": 705420130,
					"content": "城堡里还会有更多猫的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705420131
					]
				},
				{
					"id": 705420107,
					"content": "尝试对它嗷嗷呜呜…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705420108
					]
				}
			]
		}
	]
}