			"dialogs": [
				{
					"id": 745290401,
					"content": "#哟，{NICKNAME}，你来啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290402,
						745290403
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 745290402,
					"content": "茜特菈莉，好久不见。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290404
					]
				},
				{
					"id": 745290404,
					"content": "瞧你说的，奶奶我偶尔也是会出门散散步的啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290405
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 745290405,
					"content": "而且，昨晚我卜算运势，预测今天如果出门，会遇到好事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290406
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 745290406,
					"content": "这不，刚走出家门，好事就送上门来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290407,
						745290408
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 745290407,
					"content": "那就让好事成双吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290409
					]
				},
				{
					"id": 745290409,
					"content": "也不是不行啦…不过，我前两天为了看完最新卷的轻小说，熬了个大夜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290410
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 745290410,
					"content": "快帮我看看，我现在看起来怎么样？黑眼圈应该消下去了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290411,
						745290412
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 745290411,
					"content": "和平时一样精神。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290413
					]
				},
				{
					"id": 745290413,
					"content": "真的吗？你可不许骗我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290414
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 745290414,
					"content": "先说好，要是拍出来不好看，那画片可就归我了…要留的话，只许留给你最好看的那张。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 745290412,
					"content": "简直容光焕发！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290413
					]
				},
				{
					"id": 745290408,
					"content": "请让我为你拍张画片！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290409
					]
				},
				{
					"id": 745290403,
					"content": "居然没在家里睡大觉，真难得。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290404
					]
				}
			]
		}
	]
