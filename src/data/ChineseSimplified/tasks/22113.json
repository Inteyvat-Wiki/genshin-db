					"nextDialogs": [
						221130203
					]
				},
				{
					"id": 221130203,
					"content": "请您快着点吧，您把木板拿回来，我就即刻开工。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "淮安"
