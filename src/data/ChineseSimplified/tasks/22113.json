			"dialogs": [
				{
					"id": 221130501,
					"content": "这下子全部都修好了，怎么样，我的手艺还不错吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130502
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221130502,
					"content": "这样客栈的客人们也方便多了。哈哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130503
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221130503,
					"content": "对了，这些您拿好，实在是辛苦您了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130504
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221130504,
					"content": "您有空的话，可以多来坐坐，喝杯茶，吃点点心，我们这厨子的手艺，还是不错的。",
					"roleType": "TALK_ROLE_NPC",
