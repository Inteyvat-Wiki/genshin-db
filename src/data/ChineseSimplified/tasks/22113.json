					"nextDialogs": [
						221130303
					]
				},
				{
					"id": 221130303,
					"content": "太好了，这些怪物真是烦人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130304
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221130304,
					"content": "这些就够了，实在是谢谢您，我这就开工。",
