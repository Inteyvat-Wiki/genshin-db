			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"淮安"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221130101,
					"content": "真是，坏事怎么就扎着堆来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130102
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221130102,
					"content": "还在修楼梯吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221130103
					]
				},
				{
					"id": 221130103,
					"content": "您来得正好。上次谢谢您了，然后…这次还得麻烦您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130104
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221130104,
					"content": "这断口有点大，木板不够用了，我又买了一批，本来是让客栈里的搬运工去接货。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130105
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221130105,
					"content": "但是没想到，他在路上被一群怪物袭击，慌里慌张地跑回来，木板全给丢路上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130106
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221130106,
					"content": "这个人被吓了个好歹，把丢木板的地方指出来之后，怎么说都不愿意回去了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130107
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221130107,
					"content": "我思来想去，只能麻烦您了，您能帮我去把那些木板拿回来吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130108,
						221130110
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221130108,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221130109
					]
				},
				{
					"id": 221130109,
					"content": "那就麻烦您了，我在这等着您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "淮安"
				},
				{
					"id": 221130110,
					"content": "这断口这么大…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221130111
					]
				},
				{
					"id": 221130111,
					"content": "您别这么看着我，这段不是怪物砸的，这得多大块头才能砸成这样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130112
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221130112,
					"content": "这断口是这么来的…客栈里呢，曾经先后来了两个客人，两人之间有点私怨，之前是一追一躲，一直没遇见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130113
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221130113,
					"content": "结果，这两位都准备在我们这客栈投宿，上楼梯的时候，互相遇见了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130114
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221130114,
					"content": "然后这两位就玩了命打呗…打了一阵，把楼梯都打断了这么大一截，我去分了半天才分开。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130115
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221130115,
					"content": "我这个气啊…当时就多收了他们三天房钱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130116
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221130116,
					"content": "好了，闲话就说到这，您快些帮我把木板拿回来吧，我赶紧把这给修了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130117
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221130117,
					"content": "要是再这么折腾一次，我也不收额外房钱了，谁砸断的，谁给我当场修好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "淮安"
				}
			]
		},
