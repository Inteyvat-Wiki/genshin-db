			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"志琼",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710360201,
					"content": "#你好！{NICKNAME}前辈，最近过得怎样！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360202,
						710360204
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710360202,
					"content": "还好吧，你好些了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360203
					]
				},
				{
					"id": 710360203,
					"content": "谢谢关心，我已经没什么问题了。实在抱歉之前让大家费心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360206
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710360206,
					"content": "哼，志琼你就不要到处乱跑啦！免得又像上次一样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710360207,
					"content": "不会的，不会的。多亏了前辈的努力，层岩巨渊已经安全了许多。地质特征也变得…唔，稳定了许多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360208
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710360208,
					"content": "不过瑾武姐和海迪夫还需要进一步分析那块神秘晶体的…那个…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360209
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710360209,
					"content": "唔，波长？海迪夫是这么说的，大概又是须弥的奇怪术语吧…总之，首先需要安置信标才能取得数据。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360210
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710360210,
					"content": "瑾武姐最近终于腾出空来把信标组装齐全了，我需要把它们安置在几个特定地点来读取读数。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360211
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710360211,
					"content": "隔一段时间后再前去回收，回收的数据就可以留给海迪夫去运算了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360212
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710360212,
					"content": "之前由于很多区域都不安全，我们只能局限在营地内进行读数测算…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360213
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710360213,
					"content": "但现在既然通路被前辈打开了，用信标进行实地测量也就能得到更准确的数据了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360214
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710360214,
					"content": "呼…有点事情做还是比闲着好。对了，前辈如果没有其他事情的话也请跟我一起来吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360215,
						710360217
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710360215,
					"content": "那么，我们出发吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360216
					]
				},
				{
					"id": 710360216,
					"content": "好的，那么我们出发！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志琼"
				},
				{
					"id": 710360217,
					"content": "有我们什么好处吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360218
					]
				},
				{
					"id": 710360218,
					"content": "你这也太直接了吧！虽然我也想知道就是啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710360219,
					"content": "哈哈，咱们这次只是简单的一趟来回而已，不过瑾武姐应该会感谢你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志琼"
				},
				{
					"id": 710360204,
					"content": "不怎么样，至少还活着。你呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360205
					]
				},
				{
					"id": 710360205,
					"content": "我还好啦…唔，也不怎么样就是了，冒险的风头都让前辈你出尽了，哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360206
					],
					"speakerTitle": "志琼"
				}
			]
		},
		{
			"id": 7103603,
			"completionStepIds": [
				7103610
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103610",
							"2"
						],
						"stepId": 7103610,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"志琼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710360301,
					"content": "这一趟辛苦前辈了，一点小心意请收下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360302
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710360302,
					"content": "太客气了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360303
					]
				},
				{
					"id": 710360303,
					"content": "呼…最近层岩巨渊似乎停止了地形上的异变，这也说明我只需要对已有的地图进行一点小小的增补就够了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360304
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710360304,
					"content": "多谢了前辈的冒险，我们的工作也相对轻松了很多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360305
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710360305,
					"content": "啊，我就不多留前辈啦。如果想要休息或者继续探险，就请自便吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360306
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710360306,
					"content": "呼…距离回收信标还有挺长时间的，如果下次冒险也能再叫上前辈就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志琼"
				}
			]
		},
		{
			"id": 7104116,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103713",
							"3"
						],
						"stepId": 7103713,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"志琼",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710411201,
					"content": "请问前辈有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411202,
						710411212,
						710411223,
						710411232
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710411202,
					"content": "关于地图…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710411203
					]
				},
				{
					"id": 710411203,
					"content": "前辈是说地图吗？没什么好提的啦…在加入冒险家协会之前，我曾经是矿上的制图员。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411204
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710411204,
					"content": "当然啦，我说的不是那些坐办公室画图的制图师…嘿嘿，我还差得远呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411234
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710411234,
					"content": "之前受过他们的委托，在翘英庄跑上跑下测绘地形…结果完事建筑计划却取消了…也都是他们一句话的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411205
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710411205,
					"content": "他们可以只用委托助手现场勘探，给他们收集地图信息，然后自己才动手工作…但我们这些制图员可不行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411206
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710411206,
					"content": "所以…身为半个矿工，我也早就习惯在危险的地下通道中穿梭了——工作要求如此，没办法嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411207
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710411207,
					"content": "而且…在异变发生后，层岩巨渊下层其实很…不稳定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411208
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710411208,
					"content": "欸…不稳定？很危险吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710411209,
					"content": "嗯，地质结构一直在缓慢地变化，今天的通路，可能到下个月就变成了石壁…就像…唔，我想想怎么说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411210
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710411210,
					"content": "就像层岩巨渊在随着自己的心思发生变化一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411211
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710411211,
					"content": "哇…这么邪门的吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710411212,
					"content": "关于冒险家生涯…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710411213
					]
				},
				{
					"id": 710411213,
					"content": "哈哈，这才哪到哪呀，就「生涯」了！前辈请不要太客气啦，我还只是个新人冒险家而已…跟前辈差得太远啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411214
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710411214,
					"content": "虽然之前完成过一些冒险家协会的委托，但我经验尚浅，也并没有独立探索过什么地点，更没有在哪里留下自己的故事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411215
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710411215,
					"content": "所以我一直在想，层岩巨渊这个地方，说不定能让我留下足迹，让后人记得，我这个人曾经来过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411216
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710411216,
					"content": "就像大冒险家艾莉丝曾经说的那样，层岩巨渊说不定会是「我的『卢比孔河』」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411217,
						710411220
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710411217,
					"content": "「鹿鼻孔河」…是丘丘语吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710411218
					]
				},
				{
					"id": 710411218,
					"content": "没听说过呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710411219,
					"content": "唔…我也不是很懂…艾莉丝毕竟是穿梭诸世界的大冒险家，或许也是她去过的地方之一吧…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志琼"
				},
				{
					"id": 710411220,
					"content": "是「露鼻孔盒」呀！真厉害！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710411221
					]
				},
				{
					"id": 710411221,
					"content": "喂，你自己也不知道那是什么东西吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710411222,
					"content": "哈哈，不管怎样，多谢前辈的鼓励！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志琼"
				},
				{
					"id": 710411223,
					"content": "关于克里托夫…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710411224
					]
				},
				{
					"id": 710411224,
					"content": "他呀…哼，他这个人我是信不过。我们在矿上和盗宝团不知道周旋过多久了，还能不知道他们的坏心眼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411225
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710411225,
					"content": "这些人呀…我劝你千万别信他们那套说辞，什么「改过自新」什么「金盆洗手」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411226
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710411226,
					"content": "如果你认真在听他们说话，他们一定已经把脏手伸到你的口袋里了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411227
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710411227,
					"content": "假如你相信了他们的鬼话，恐怕岩王爷他老人家也保不住你的钱包咯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411228
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710411228,
					"content": "哼，我当然不是对他们有偏见…我只是想提醒你小心一点，盗宝团是不可相信的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411229
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710411229,
					"content": "你这显然是偏见。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710411230
					]
				},
				{
					"id": 710411230,
					"content": "也许吧…你作为前辈比我更加见多识广，对盗宝团那些家伙也能更宽容。但我总还要留些心眼盯着他们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411231
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710411231,
					"content": "除非这家伙能证明，他和那群走私犯同伙没有关系。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志琼"
				},
				{
					"id": 710411232,
					"content": "再见。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710411233
					]
				},
