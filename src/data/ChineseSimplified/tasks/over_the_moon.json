			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"鲸井椛",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726630101,
					"content": "你们来了，很抱歉又来麻烦你们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630102
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726630102,
					"content": "你看起来气色不错。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726630103
					]
				},
				{
					"id": 726630103,
					"content": "哈哈，多谢夸奖，我也算是想明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630104
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726630104,
					"content": "有些事或许就是不能强求的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630105
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726630105,
					"content": "晚上能陪我去一趟西边的海滩吗？我有东西送给你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630106
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726630106,
					"content": "哇，是什么大海的宝藏吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726630107,
					"content": "去了就知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鲸井椛"
				}
			]
		},
		{
			"id": 7266302,
			"completionStepIds": [
				7266304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7266304",
							"2"
						],
						"stepId": 7266304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"鲸井椛",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726630201,
					"content": "就是这里了，当年父亲最后一次出海就在这里，也是这样的夜晚，之后我就再也没有见过他了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630202
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726630202,
					"content": "很想念他吧，鲸井小姐的愿望是不是再见到一次父亲？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726630203,
					"content": "哈哈，我确实很想念他，但是，大海的子民总有一天要回归大海的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630204
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726630204,
					"content": "但我的愿望，其实是要成为超越父亲的渔师啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630205
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726630205,
					"content": "小时候，我总想和父亲一起出海，但他只会让妈妈把我带回去，有时候甚至带上了邻居家的哥哥，都不愿带上我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630206
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726630206,
					"content": "他总是说着，「椛啊，别在海边晃来晃去，去做些女孩子该做的事。」，「拿着钱去买小裙子吧，不要总往船上跑。」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630207
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726630207,
					"content": "我很不服气，为什么？什么是女孩子该做的事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630208
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726630208,
					"content": "我可以去买糖果，去摘鲜花，当小公主。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630209
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726630209,
					"content": "但我不可以去冒险，去远洋，去遨游大海吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630210
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726630210,
					"content": "我偏不，我偏要做。父亲走后，我干起了渔师的行当。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630211
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726630211,
					"content": "他探索不了的海域，我来探索。他捕不了的大鱼，我来捕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630212
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726630212,
					"content": "「鲸井」流的钓鱼之法，我来继承。「鲸井」家的渔师名号，我来发扬光大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630213
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726630213,
					"content": "就算「海中月」的传说只是传说，我也不会止步不前的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630214
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726630214,
					"content": "嗯，你会成功的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726630215
					]
				},
				{
					"id": 726630215,
					"content": "谢谢你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630216
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726630216,
					"content": "既然神鱼不在，那我就把心愿投入大海吧。我想，父亲会看见的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630217
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726630217,
					"content": "你们有什么愿望吗？一起来吧，写下心愿，塞进漂流瓶，然后用力丢出去。它们总有一天会实现。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630218
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726630218,
					"content": "呜哇——这样可以吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726630219,
					"content": "可是我有好多愿望，要写哪一个呢…好纠结！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726630220,
					"content": "这段时间，辛苦你们了！我都不知道该如何感谢你们，只有一些礼物，希望不要嫌弃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630221
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726630221,
					"content": "哇——你们看，那是什么！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726630222,
					"content": "好大一群鱼哦！还在发光，它们好像很喜欢我们的漂流瓶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726630223,
					"content": "这些家伙聚在一起，倒是很像一颗海里的大月亮呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726630224,
					"content": "这…这些鱼，这些鱼是「月光鳍」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630225
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726630225,
					"content": "啊！我知道了…我知道了！原来如此，原来这就是「海中月」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630226
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726630226,
					"content": "欸？这就是「海中月」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630227
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726630227,
					"content": "没错，我不会忘记它的样子，这星星点点的月光啊…当年那只「海中月」，也是在嘉玮投下漂流瓶后出现的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630228
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726630228,
					"content": "难怪这么多年，都没有人真正捕上过「海中月」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630229
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726630229,
					"content": "原来是因为，它是由一群「月光鳍」汇聚组成啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630230
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726630230,
					"content": "这些「月光鳍」…居然会喜欢这种普普通通的漂流瓶？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630231
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726630231,
					"content": "嘿嘿，说不定它们是喜欢人们往瓶子里灌注的心愿呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630232
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726630232,
					"content": "哈哈！既然如此，那就看我鲸井椛把它们全部钓上来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630233
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726630233,
					"content": "我们也来！我们也来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630234
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726630234,
					"content": "既然如此，那请允许我把这根钓竿送给你们，这是我鲸井家为了追捕「海中月」特制的钓竿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630235
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726630235,
					"content": "虽然远不能表达对你们的感谢，但也是我的一点心意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630236
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726630236,
					"content": "就用它把「月光鳍」全部钓上来吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鲸井椛"
				}
			]
		}
	]
}