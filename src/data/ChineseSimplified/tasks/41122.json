				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"麦克"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411220201,
					"content": "你好，请问你找我有事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220202
					],
					"speakerTitle": "麦克"
				},
				{
					"id": 411220202,
					"content": "这份命令书…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220203
					]
				},
				{
					"id": 411220203,
					"content": "命令书？还真是，我看看…要我回城里协助处理各项事务…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220204
					],
					"speakerTitle": "麦克"
				},
				{
					"id": 411220204,
					"content": "哎呀，回城里倒也没问题，可是你看那两个孩子，他们一直不愿意回去城里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220205
					],
					"speakerTitle": "麦克"
				},
				{
					"id": 411220205,
					"content": "也不知道他们家大人去哪了，我也不好把他们给强行带回去，所以只能一直在这守着他们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220206
					],
					"speakerTitle": "麦克"
				},
				{
					"id": 411220206,
					"content": "现在这个情况，我要是回了城，这两个孩子出事了可怎么办。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220207
					],
					"speakerTitle": "麦克"
				},
				{
					"id": 411220207,
					"content": "唉，我去说了好几次，现在他们已经完全不听我说话了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220208
					],
					"speakerTitle": "麦克"
				},
				{
					"id": 411220208,
					"content": "呃，不然…你去帮我说说？说不定他们能听你的话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220209
					],
					"speakerTitle": "麦克"
				},
				{
					"id": 411220209,
					"content": "要是能把他们说动了，让他们乖乖回城去，那我也能安心回去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220210
					],
					"speakerTitle": "麦克"
				},
				{
					"id": 411220210,
					"content": "我去试试看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220211
					]
				},
				{
					"id": 411220211,
					"content": "那就拜托你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "麦克"
				}
			]
		},
		{
			"id": 4112203,
			"completionStepIds": [
				4112203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
