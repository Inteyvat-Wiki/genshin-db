			"dialogs": [
				{
					"id": 411220601,
					"content": "你好，有什么需要帮忙的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220602
					],
					"speakerTitle": "哈里"
				},
				{
					"id": 411220602,
					"content": "这份命令书…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220603
					]
				},
				{
					"id": 411220603,
					"content": "命令书？我看看，哦…是要我回城里吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220604
					],
					"speakerTitle": "哈里"
				},
				{
					"id": 411220604,
					"content": "抱歉，这份命令我得稍后再执行了，我还有更重要的事要做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220605
					],
					"speakerTitle": "哈里"
				},
				{
					"id": 411220605,
					"content": "似乎是因为陨石的关系，这附近的魔物也受到了影响，变得格外暴躁，也格外危险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220606
					],
					"speakerTitle": "哈里"
				},
				{
					"id": 411220606,
					"content": "为了保障这附近地区的安全，我得去把这些魔物解决掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220607
					],
					"speakerTitle": "哈里"
				},
				{
					"id": 411220607,
					"content": "这里压根没人…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220608
					]
				},
				{
					"id": 411220608,
					"content": "正是因为这附近没人，我才能放开手脚，把这群魔物彻底打倒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220609
					],
					"speakerTitle": "哈里"
				},
				{
					"id": 411220609,
					"content": "这件事可是很重要的，不处理好的话，我可不能离开这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220610,
						411220611
					],
					"speakerTitle": "哈里"
				},
				{
					"id": 411220610,
					"content": "我来帮忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220612
					]
				},
				{
					"id": 411220612,
					"content": "那太好了，这片区域里正好也有不止一个地方有魔物聚集。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220613
					],
					"speakerTitle": "哈里"
				},
				{
					"id": 411220613,
					"content": "我们分头行事，各自去解决一个地方的魔物，处理好之后，再来这里会合。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "哈里"
				},
				{
					"id": 411220611,
					"content": "我和你一起处理。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220612
					]
				}
			]
		},
