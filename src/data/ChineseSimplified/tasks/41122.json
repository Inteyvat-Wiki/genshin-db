			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"小吉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411220301,
					"content": "咦？有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220302
					],
					"speakerTitle": "小吉"
				},
				{
					"id": 411220302,
					"content": "关于现在的情况…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220303
					]
				},
				{
					"id": 411220303,
					"content": "陨石的事，我们知道哦。不过…我们都还没见过陨石落下来的样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220304
					],
					"speakerTitle": "小吉"
				},
				{
					"id": 411220304,
					"content": "小威说他知道个好位置看陨石，所以我们就来这里了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220305
					],
					"speakerTitle": "小吉"
				},
				{
					"id": 411220305,
					"content": "在城里也能看到。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220306
					]
				},
				{
					"id": 411220306,
					"content": "可是在城里的话，要去很高的地方才能看见吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220307
					],
					"speakerTitle": "小吉"
				},
				{
					"id": 411220307,
					"content": "城里的卫兵叔叔们肯定不会让我们爬太高的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220308
					],
					"speakerTitle": "小吉"
				},
				{
					"id": 411220308,
					"content": "旁边的那位叔叔愿意帮忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220309
					]
				},
				{
					"id": 411220309,
					"content": "咦？你说旁边那个奇怪的叔叔？可是他之前过来说话的时候，都好凶好凶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220310
					],
					"speakerTitle": "小吉"
				},
				{
					"id": 411220310,
					"content": "也不说其他的，就是一个劲地要我们回去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220311
					],
					"speakerTitle": "小吉"
				},
				{
					"id": 411220311,
					"content": "不过，如果他能答应带我们去很高的地方看陨石，那我觉得…回去也可以。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220312
					],
					"speakerTitle": "小吉"
				},
				{
					"id": 411220312,
					"content": "但还是请你和小威也说说吧，毕竟是他的主意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小吉"
				}
			]
		},
		{
