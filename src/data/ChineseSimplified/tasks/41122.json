					"麦克"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411220501,
					"content": "怎么样，你说服他们了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220502
					],
					"speakerTitle": "麦克"
				},
				{
					"id": 411220502,
					"content": "感觉上像是说服了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220503
					]
				},
				{
					"id": 411220503,
					"content": "那就好，说服了就好！实在是多亏你了，呃…等会，什么叫「感觉上」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220504
					],
					"speakerTitle": "麦克"
				},
				{
					"id": 411220504,
					"content": "只要你愿意帮忙…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220505
					]
				},
				{
					"id": 411220505,
					"content": "帮忙？帮什么忙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220506
					],
					"speakerTitle": "麦克"
				},
				{
					"id": 411220506,
					"content": "啊？去蒙德城的最高处看陨石，那，那也有点危险吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220507
					],
					"speakerTitle": "麦克"
				},
				{
					"id": 411220507,
					"content": "而且还是两个孩子，这件事我还得去向骑士团打个报告…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220508
					],
					"speakerTitle": "麦克"
				},
				{
					"id": 411220508,
					"content": "我可有命令书喔。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220509
					]
				},
				{
					"id": 411220509,
					"content": "命令书压根不是这么个用法吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220510
					],
					"speakerTitle": "麦克"
				},
				{
					"id": 411220510,
					"content": "算了，只要能让那两个孩子乖乖回城里去，去高处的事…我来想办法就是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220511
					],
					"speakerTitle": "麦克"
				},
				{
					"id": 411220511,
					"content": "你真要带他们…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220512
					]
				},
				{
					"id": 411220512,
					"content": "那当然，作为一名西风骑士，和一位，呃…成年人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220513
					],
					"speakerTitle": "麦克"
				},
				{
					"id": 411220513,
					"content": "不管承诺的对象是谁，只要答应了的事情就要做到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220514
					],
					"speakerTitle": "麦克"
				},
				{
					"id": 411220514,
					"content": "这次就麻烦你了，剩下的事交给我吧，待会我就去带他们回蒙德城。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220515
					],
					"speakerTitle": "麦克"
				},
				{
					"id": 411220515,
					"content": "然后…再想想怎么把他们带去蒙德城最高的地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "麦克"
				}
			]
		},
