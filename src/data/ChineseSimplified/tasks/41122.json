			"trigger": {
				"objectNames": [
					"霍夫曼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411220101,
					"content": "唉，看来也没什么好办法了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220102
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411220102,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220103
					]
				},
				{
					"id": 411220103,
					"content": "是你啊。是这样…最近从天而降的陨石，你应该也看见了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220104
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411220104,
					"content": "虽然城里运气好，一直没有被降落的陨石波及到，但是城外已经很混乱了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220105
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411220105,
					"content": "不少的人进城来避难，还有那些陷入莫名昏睡的人，城里的事务就快要忙不过来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220106
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411220106,
					"content": "我想把在外执行任务的西风骑士们都召回来，先把城里的事务处理周全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220107
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411220107,
					"content": "但他们都分散在野外，骑士团现在也没人手出去找他们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220108
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411220108,
					"content": "你能帮我个忙，把这份命令书带过去给他们看看吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220109
					],
					"speakerTitle": "霍夫曼"
				}
			]
		},
		{
			"id": 4112202,
			"completionStepIds": [
				4112202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4112202",
							"2"
						],
						"stepId": 4112202,
						"stateName": "QUEST_STATE_UNFINISHED"
