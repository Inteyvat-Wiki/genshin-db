			"trigger": {
				"objectNames": [
					"小威"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411220401,
					"content": "咦？你好，有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220402
					],
					"speakerTitle": "小威"
				},
				{
					"id": 411220402,
					"content": "关于现在的情况…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220403
					]
				},
				{
					"id": 411220403,
					"content": "我知道啊，我们就是出来看陨石的。只要看到了我们就回去了，不用担心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220404
					],
					"speakerTitle": "小威"
				},
				{
					"id": 411220404,
					"content": "在城里也能看到。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220405
					]
				},
				{
					"id": 411220405,
					"content": "那得去个很高的地方才行啦，我试过了好几次，都被卫兵给叫下来了，还被训了一顿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220406
					],
					"speakerTitle": "小威"
				},
				{
					"id": 411220406,
					"content": "所以我才带着小吉来这个地方啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220407
					],
					"speakerTitle": "小威"
				},
				{
					"id": 411220407,
					"content": "旁边的卫兵叔叔可以帮忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220408
					]
				},
				{
					"id": 411220408,
					"content": "帮忙？你是说，他能带我们去城里的高处看陨石吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220409
					],
					"speakerTitle": "小威"
				},
				{
					"id": 411220409,
					"content": "不可能吧…那个叔叔看着就很奇怪，还凶巴巴的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220410
					],
					"speakerTitle": "小威"
				},
				{
					"id": 411220410,
					"content": "我带着命令书呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220411
					]
				},
				{
					"id": 411220411,
					"content": "真的？给我看看。哇…真的是骑士团的命令书。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220412
					],
					"speakerTitle": "小威"
				},
				{
					"id": 411220412,
					"content": "有了这个命令书，那个叔叔就能带我们去高处看陨石了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220413
					],
					"speakerTitle": "小威"
				},
				{
					"id": 411220413,
					"content": "嘿嘿，能在城里看陨石，肯定是最好的了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220414
					],
					"speakerTitle": "小威"
				},
				{
					"id": 411220414,
					"content": "那你去和那个叔叔说一声吧，我也和小吉说一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220415
					],
					"speakerTitle": "小威"
				},
				{
					"id": 411220415,
					"content": "哎呀，这么一想…我还挺期待看到陨石落下来的场景呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小威"
				}
			]
		},
