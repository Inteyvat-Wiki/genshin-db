			"trigger": {
				"objectNames": [
					"内尔敏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230420101,
					"content": "这样一定可以给里夫一个惊喜…嘿嘿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420102
					],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 230420102,
					"content": "什么惊喜？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420103
					]
				},
				{
					"id": 230420103,
					"content": "呜哇！别吓我啊旅行者！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420104
					],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 230420104,
					"content": "我是从你正面走过来的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420105
					]
				},
				{
					"id": 230420105,
					"content": "我在想事情嘛，完全没有注意到你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420106
					],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 230420106,
					"content": "旅行者，我问你啊…你听说过「香水」这种东西吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420107
					],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 230420107,
					"content": "贾瓦希尔奶奶告诉我，她年轻的时候经常自制「香水」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420108
					],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 230420108,
					"content": "「香水」的气味不仅能够遮盖住人身上的汗味，而且某些特别的「香水」还有着提神的功效…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420109
					],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 230420109,
					"content": "里夫一直在村口做守卫，每天热得满身大汗，回来的时候也总是说自己被晒得头晕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420110
					],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 230420110,
					"content": "所以，我就想做一瓶「薄荷香水」送给他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420111
					],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 230420111,
					"content": "贾瓦希尔奶奶把制作香水的方法写给了我，还帮我去买了很多材料…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420112
					],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 230420112,
					"content": "但制作香水真是出乎意料的麻烦…光是悄悄处理材料我就花了好长时间，还做出了不少失败品…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420113
					],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 230420113,
					"content": "再这么拖下去，里夫就要发现我做香水的事了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420114
					],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 230420114,
					"content": "所以旅行者，能请你帮我去置办一些材料吗？一定要悄悄地，不能让里夫发现！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420115,
						230420117
					],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 230420115,
					"content": "告诉他也没问题吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420116
					]
				},
				{
					"id": 230420116,
					"content": "不行不行，这可是我准备了好久的惊喜，绝不能这么轻易就告诉他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420119
					],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 230420119,
					"content": "其实我想拜托你准备的材料也不多啦，你先去找阿扎莱先生，拿到我订的货，然后再帮我取一小桶水来就好啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420120
					],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 230420120,
					"content": "记住，一定要悄悄的喔，绝对不能让里夫察觉到！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 230420117,
					"content": "唉…交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420118
					]
				},
				{
					"id": 230420118,
					"content": "那就拜托你啦，放心，我一定会准备好报酬的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420119
					],
					"speakerTitle": "内尔敏"
				}
			]
		},
