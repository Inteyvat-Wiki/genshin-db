			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"内尔敏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230420501,
					"content": "太好了，之前的材料还剩下一些，加上你带来的这些，我可以再试做几次了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420502
					],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 230420502,
					"content": "呼…我再多看看笔记，这次一定要成功！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420503
					],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 230420503,
					"content": "对了，我还得去摘几片花瓣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420504
					],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 230420504,
					"content": "内尔敏开始紧张地制作起了「香水」…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230420505
					]
				},
				{
					"id": 230420505,
					"content": "完成了！气味闻起来还不错…也没有变得黏黏糊糊的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420506
					],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 230420506,
					"content": "这样应该就算是成功了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420507,
						230420508
					],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 230420507,
					"content": "感觉上算是成功了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420509
					]
				},
				{
					"id": 230420509,
					"content": "嗯！我还特意买了一个瓶子呢，先让我把香水装进去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420510
					],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 230420510,
					"content": "旅行者，我们一起去把香水送给里夫吧，希望他会喜欢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 230420508,
					"content": "至少不算是失败嘛。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420509
					]
				}
			]
		},
		{
