			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"里夫",
					"内尔敏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230420601,
					"content": "内尔敏，还有旅行者…你们怎么来了？是遇见什么麻烦了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420602
					],
					"speakerTitle": "里夫"
				},
				{
					"id": 230420602,
					"content": "不会是那盆花有什么问题吧？我还在值班呢，等我值完班之后，再…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420603
					],
					"speakerTitle": "里夫"
				},
				{
					"id": 230420603,
					"content": "内尔敏有东西送给你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420604
					]
				},
				{
					"id": 230420604,
					"content": "这瓶「香水」送给你！是薄荷味的喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420605
					],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 230420605,
					"content": "我本来想做「墩墩桃」味的，但不知道为什么，我只要加入墩墩桃，香水就会变得黏糊糊的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420606
					],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 230420606,
					"content": "谢…谢谢，但「香水」是用来做什么的？驱虫？还是做标记…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420607
					],
					"speakerTitle": "里夫"
				},
				{
					"id": 230420607,
					"content": "是帮你提神啦，还有盖住你身上的汗味，你每天闻着那么重的汗味不会头晕吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420608
					],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 230420608,
					"content": "这个，闻习惯了倒也还好，突然闻不到了反而有些不自在…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420609
					],
					"speakerTitle": "里夫"
				},
				{
					"id": 230420609,
					"content": "那「香水」我拿走了，你别用了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420610
					],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 230420610,
					"content": "欸！别啊，我开玩笑的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420611
					],
					"speakerTitle": "里夫"
				},
				{
					"id": 230420611,
					"content": "快，快把「香水」给我，我头现在就开始晕了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420612
					],
					"speakerTitle": "里夫"
				},
				{
					"id": 230420612,
					"content": "给你，涂在胳膊上就行了，贾瓦希尔奶奶是这么说的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420613
					],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 230420613,
					"content": "这气味闻起来还不错，确实很提神。涂上去还感觉冰凉凉的，挺舒服…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420614
					],
					"speakerTitle": "里夫"
				},
				{
					"id": 230420614,
					"content": "哼哼，这可是贾瓦希尔奶奶的秘方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420615
					],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 230420615,
					"content": "多亏了旅行者帮忙，我才能做出这么好的「香水」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420616
					],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 230420616,
					"content": "就是帮了点小忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420617
					]
				},
				{
					"id": 230420617,
					"content": "麻烦了你这么多次，真是不好意思…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420618
					],
					"speakerTitle": "里夫"
				},
				{
					"id": 230420618,
					"content": "这些东西给你，就当做是报酬吧，真是多谢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420619
					],
					"speakerTitle": "里夫"
				},
				{
					"id": 230420619,
					"content": "这「香水」用起来倒还真是不错…",
					"roleType": "TALK_ROLE_NPC",
