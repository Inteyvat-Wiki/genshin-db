			},
			"dialogs": [
				{
					"id": 230420301,
					"content": "欢迎，客人需要点什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420302
					],
					"speakerTitle": "阿扎莱"
				},
				{
					"id": 230420302,
					"content": "关于内尔敏的「货物」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420303
					]
				},
				{
					"id": 230420303,
					"content": "你说那个啊…已经准备好了。这些都是质量很不错的香料，价格也不贵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420304
					],
					"speakerTitle": "阿扎莱"
				},
				{
					"id": 230420304,
					"content": "内尔敏是准备拿这些香料制作「香水」，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420305
					],
					"speakerTitle": "阿扎莱"
				},
				{
					"id": 230420305,
					"content": "唉，虽然有活力是件好事，但内尔敏也得注意一下自己的身体啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿扎莱"
				}
			]
		},
		{
			"id": 2304205,
			"completionStepIds": [
				2304205
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2304205",
							"2"
						],
						"stepId": 2304205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
