			},
			"dialogs": [
				{
					"id": 790200101,
					"content": "我看看，嗯…这说不定是什么宝藏的地图！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790200102,
					"content": "真的吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790200103
					]
				},
				{
					"id": 790200103,
					"content": "哼，我闻到了宝藏的味道，肯定是这样的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790200116,
					"content": "你看，留下图的是「海盗赤穗百目鬼一众」，总觉得是在哪里听到过的名字！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790200104,
					"content": "而且你看，「秘宝所藏之处…」果然有秘宝！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790200105,
					"content": "嗯，接下来是…「其中隐秘…一分为四…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790200106,
					"content": "一分为四，是把什么东西分成了四个的意思吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200107,
						790200108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790200107,
					"content": "宝藏有四份？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790200109
					]
				},
				{
					"id": 790200109,
					"content": "不知道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790200110,
					"content": "不过这边说「置于四座大岛礁石之处」，应该是说藏在金苹果群岛上的四座岛的礁石…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790200111,
					"content": "啊，这里不就是礁石吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790200112,
					"content": "看来有四份的是藏宝线索…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790200113
					]
				},
				{
					"id": 790200113,
					"content": "而且还在四个岛的礁石附近！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790200114,
					"content": "说起金苹果群岛的四个岛，那就肯定是最大的四个了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790200115,
					"content": "我们就去其他三个岛的礁石附近找找看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
