			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"长野原龙之介"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120120601,
					"content": "丫头，不好了，刚刚天领奉行的人来过了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120602
					],
					"speakerTitle": "长野原龙之介"
				},
				{
					"id": 120120602,
					"content": "欸？为什么，他们这就知道了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120603
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120120603,
					"content": "老爹你没事吧？他们没对你做什么吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120604
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120120604,
					"content": "我说，烟花会，房子里都是烟花，不要随便进去看，免得火灾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120605
					],
					"speakerTitle": "长野原龙之介"
				},
				{
					"id": 120120605,
					"content": "但他们不听，就觉得朔次郎那小子藏在里面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120606
					],
					"speakerTitle": "长野原龙之介"
				},
				{
					"id": 120120606,
					"content": "不过幸好，朔次郎提前听到了动静，翻窗子跑掉了，天领奉行的人没有在这里抓到他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120607
					],
					"speakerTitle": "长野原龙之介"
				},
				{
					"id": 120120607,
					"content": "哎呀，这就麻烦了，朔次郎现在应该还在犹豫不决…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120608
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120120608,
					"content": "老爹，你看到他往哪儿跑了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120609
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120120609,
					"content": "我觉得天领奉行的人一定会追上去的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120610
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120120610,
					"content": "你听到那个人的名字了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120120611
					]
				},
				{
					"id": 120120611,
					"content": "对对对，名字，名字！这么突然地就来抓人，很有可能就是那个佳祐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120612
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120120612,
					"content": "不然只是因为偷渡，应该还不至于这么兴师动众。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120613
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120120613,
					"content": "不行啊，我耳朵不好，也没看到。你们想问方向是吧，他们出城去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120614
					],
					"speakerTitle": "长野原龙之介"
				},
				{
					"id": 120120614,
					"content": "名字我没听到，唉，真的没听到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120615
					],
					"speakerTitle": "长野原龙之介"
				},
				{
					"id": 120120615,
					"content": "名字的话，我好像听到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120616
					],
					"speakerTitle": "森彦"
				},
				{
					"id": 120120616,
					"content": "我刚刚又从朋友那里拿了点矿石，送过来的时候，刚好撞上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120617
					],
					"speakerTitle": "森彦"
				},
				{
					"id": 120120617,
					"content": "领头的那个，好像就是你们说的，叫作佳祐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120618
					],
					"speakerTitle": "森彦"
				},
				{
					"id": 120120618,
					"content": "果然是这样！谢谢你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120619
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120120619,
					"content": "如果朔次郎还是没有下定决心，两个人见面不仅不能解决问题，还会让事情变得不可挽回。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120620
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120120620,
					"content": "#这样肯定不行。{NICKNAME}，跟我来，我们沿路打听线索吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宵宫"
				}
			]
		},
