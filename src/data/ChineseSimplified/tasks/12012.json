			"dialogs": [
				{
					"id": 120120801,
					"content": "马上就是「长野原烟花会」了吧，我家孩子早就跑出去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120802
					],
					"speakerTitle": "聪"
				},
				{
					"id": 120120802,
					"content": "特别迫不及待，心思全写在脸上，谁不知道她是惦记城里的那个臭小子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120803
					],
					"speakerTitle": "聪"
				},
				{
					"id": 120120803,
					"content": "…唉，她开心就好吧。",
