	"talks": [
		{
			"id": 1201201,
			"completionStepIds": [
				1201201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201201",
							"2"
						],
						"stepId": 1201201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"今谷香里",
					"今谷三郎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120120101,
					"content": "欸，这不是宵宫嘛，快来快来，进屋坐坐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120102
					],
					"speakerTitle": "今谷香里"
				},
				{
					"id": 120120102,
					"content": "这边的是你的朋友吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120103
					],
					"speakerTitle": "今谷香里"
				},
				{
					"id": 120120103,
					"content": "对啊，是远道而来的旅行者，现在有外人到稻妻来很不容易。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120104
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120120104,
					"content": "是啊，现在情况特殊，不过既然来了，我们作为本地人，就要好好招待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120105
					],
					"speakerTitle": "今谷三郎"
				},
				{
					"id": 120120105,
					"content": "嗯。对了，你们两位之前定的烟花，我也带过来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120106
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120120106,
					"content": "哦，谢谢啊，每年都要麻烦你们家，先是你的爸爸，现在轮到你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120107
					],
					"speakerTitle": "今谷三郎"
				},
				{
					"id": 120120107,
					"content": "不知道有生之年，能不能等到「长野原烟花店」的下一任接班人啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120108
					],
					"speakerTitle": "今谷三郎"
				},
				{
					"id": 120120108,
					"content": "没问题的，两位现在身子骨这么硬朗，就别说不吉利的话啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120109
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120120109,
					"content": "唉，身子这东西，确实不如以前啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120110
					],
					"speakerTitle": "今谷香里"
				},
				{
					"id": 120120110,
					"content": "以前种田挑水什么的一点都不费劲，现在稍微干点活就腰酸背痛的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120111
					],
					"speakerTitle": "今谷香里"
				},
				{
					"id": 120120111,
					"content": "昨天本来想把杂草除一下，结果弯下腰去，就有点直不起来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120112
					],
					"speakerTitle": "今谷香里"
				},
				{
					"id": 120120112,
					"content": "这样啊，没关系，交给我们吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120113
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120120113,
					"content": "哎，别别别，好不容易来一趟，怎么能让你们干活呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120114
					],
					"speakerTitle": "今谷三郎"
				},
				{
					"id": 120120114,
					"content": "我去拿点心和茶，边吃边聊吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120115
					],
					"speakerTitle": "今谷三郎"
				},
				{
					"id": 120120115,
					"content": "没关系啦，我不是总来帮你们做家务的嘛。最近是因为烟花会的事在忙，之后我还会经常来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120116
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120120116,
					"content": "对我们来说是小事情啦，不用客气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120120117,
					"content": "哎呀，你们就是懂事，不像我家那孩子，也老大不小的了，还是一个人，也总是不回家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120118
					],
					"speakerTitle": "今谷香里"
				},
				{
					"id": 120120118,
					"content": "既然你都这么说了，我这里还腌了点咸萝卜，你能顺便带给村那边的小聪嘛？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120119
					],
					"speakerTitle": "今谷香里"
				},
				{
					"id": 120120119,
					"content": "好啊，我们去去就来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120120
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120120120,
					"content": "跟我来吧，爷爷奶奶腿脚不利索，我们帮帮忙吧，先<color=#00E1FFFF>除草</color>，再去<color=#00E1FFFF>送咸萝卜</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宵宫"
				}
			]
		},
		{
			"id": 1201204,
			"completionStepIds": [
				1201204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201204",
							"2"
						],
						"stepId": 1201204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"聪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120120401,
					"content": "聪叔叔你好，最近身体怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120402
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120120402,
					"content": "还是老样子啊，没什么变化。你看起来也还是那么活泼啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120403
					],
					"speakerTitle": "聪"
				},
				{
					"id": 120120403,
					"content": "托大家的福嘛，我家的生意越来越好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120404
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120120404,
					"content": "上次卖到璃月去的烟花，听说广受好评，估计之后的订单又要增加了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120405
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120120405,
					"content": "那你不是更辛苦了，和龙之介先生还忙得过来嘛？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120406
					],
					"speakerTitle": "聪"
				},
				{
					"id": 120120406,
					"content": "实在吃力的话，记得叫我帮忙哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120407
					],
					"speakerTitle": "聪"
				},
				{
					"id": 120120407,
					"content": "没问题啦，烟花的事情，可以自己解决。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120408
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120120408,
					"content": "对了对了，这是香里奶奶托我给你送过来的咸萝卜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120409
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120120409,
					"content": "哎呀，真是谢谢，本来我以前都吃不惯咸萝卜的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120410
					],
					"speakerTitle": "聪"
				},
				{
					"id": 120120410,
					"content": "尝了她的手艺可就忘不掉咯，现在都成我们家里人的习惯了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120411
					],
					"speakerTitle": "聪"
				},
				{
					"id": 120120411,
					"content": "家里现在都还好吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120412
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120120412,
					"content": "好啊，不过，偶尔也会闹闹脾气吧，家人不就是这样吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120413
					],
					"speakerTitle": "聪"
				},
				{
					"id": 120120413,
					"content": "我觉得，有亲人一直陪在身边，就算有矛盾，也比一直见不到面要好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120414
					],
					"speakerTitle": "聪"
				},
				{
					"id": 120120414,
					"content": "虽然叔叔阿姨的感情很好，但孩子总是不回来，也挺孤单的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120415
					],
					"speakerTitle": "聪"
				},
				{
					"id": 120120415,
					"content": "看上去其实也不会，他们好像已经习惯这样的日子了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120416
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120120416,
					"content": "不过你说得也很有道理，那我以后多来看看好了，至少有人能聊聊天什么的，就不会无聊了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120417
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120120417,
					"content": "好啊，绀田村的大家都希望你能多来看看呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120418
					],
					"speakerTitle": "聪"
				},
				{
					"id": 120120418,
					"content": "嘿嘿，谢谢啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宵宫"
				}
			]
		},
		{
			"id": 1201205,
			"completionStepIds": [
				1201205
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201205",
							"2"
						],
						"stepId": 1201205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"今谷香里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120120501,
					"content": "不愧是年轻人啊，干事情就是利索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120502
					],
					"speakerTitle": "今谷香里"
				},
				{
					"id": 120120502,
					"content": "年轻人的精神用不完，老人见多识广经验丰富，各有各的厉害之处嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120503
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120120503,
					"content": "说起来，今年就正好五十年了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120504
					],
					"speakerTitle": "今谷三郎"
				},
				{
					"id": 120120504,
					"content": "是啊，一年一年这么过去，其实没什么明显的感觉，但一晃眼，就五十年了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120505
					],
					"speakerTitle": "今谷香里"
				},
				{
					"id": 120120505,
					"content": "五十年？是什么重要的日子吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120120506,
					"content": "哈哈，那就要讲，五十年之前，这老婆子追我的时候…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120507
					],
					"speakerTitle": "今谷三郎"
				},
				{
					"id": 120120507,
					"content": "在外人面前乱讲什么，明明是你发了疯地追我好不好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120508
					],
					"speakerTitle": "今谷香里"
				},
				{
					"id": 120120508,
					"content": "那这一段略过去，不讲。总之，就是在那年的「长野原烟花会」上，我向老婆子求了婚，然后就一起过日子了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120509,
						120120510
					],
					"speakerTitle": "今谷三郎"
				},
				{
					"id": 120120509,
					"content": "祝贺你们。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120120511
					]
				},
				{
					"id": 120120511,
					"content": "其实本来也没下定决心的，抱着有点犹豫的心态找长野原做了烟花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120512
					],
					"speakerTitle": "今谷三郎"
				},
				{
					"id": 120120512,
					"content": "烟花升起来，就到那时候也不知道要怎么开口。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120513
					],
					"speakerTitle": "今谷三郎"
				},
				{
					"id": 120120513,
					"content": "结果声音砰砰砰的，烟花点亮了天空，再看她的侧脸，那眼睛啊，倒映出烟花的光，闪闪发亮…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120514
					],
					"speakerTitle": "今谷三郎"
				},
				{
					"id": 120120514,
					"content": "也不知道怎么回事，回过神来的时候，我好像已经开了口，她还答应了我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120515
					],
					"speakerTitle": "今谷三郎"
				},
				{
					"id": 120120515,
					"content": "五十年说长也长，说短也短，不是什么了不起的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120516
					],
					"speakerTitle": "今谷香里"
				},
				{
					"id": 120120516,
					"content": "但携手走过五十年，也值得纪念一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120517
					],
					"speakerTitle": "今谷香里"
				},
				{
					"id": 120120517,
					"content": "我之前不知道是五十年这么特殊的日子，早知道，应该给你们做一个特殊的，豪华版的烟花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120518
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120120518,
					"content": "不用不用，就是以前的那种就行，每次烟花会都看，看不到才会不习惯呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120519
					],
					"speakerTitle": "今谷香里"
				},
				{
					"id": 120120519,
					"content": "只要看了烟花，就能想起那段日子。哪怕是上了年纪，也不会觉得自己的过去有什么遗憾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120520
					],
					"speakerTitle": "今谷香里"
				},
				{
					"id": 120120520,
					"content": "他们的感情，真的很好呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120521
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120120521,
					"content": "对了，我们的事先不提，宵宫你现在应该忙着办烟花会吧，到我们这里来，是有什么要紧事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120522
					],
					"speakerTitle": "今谷三郎"
				},
				{
					"id": 120120522,
					"content": "哦，其实是个比较难以启齿的事，我先给你们讲讲吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120523
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120120523,
					"content": "朔次郎，他…回来了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120524
					],
					"speakerTitle": "今谷三郎"
				},
				{
					"id": 120120524,
					"content": "欸？你们认识他？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120525
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120120525,
					"content": "那是我家孩子，小时候最好的朋友啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120526
					],
					"speakerTitle": "今谷香里"
				},
				{
					"id": 120120526,
					"content": "唉，那时候他们一直一起玩，从小到大，无话不讲，到处跑，到处看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120527
					],
					"speakerTitle": "今谷香里"
				},
				{
					"id": 120120527,
					"content": "结果呢，有一天突然吵了一架，吵得很厉害…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120528
					],
					"speakerTitle": "今谷香里"
				},
				{
					"id": 120120528,
					"content": "我记得那时候的朔次郎，想要去外面的世界看看，他觉得稻妻太安稳了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120529
					],
					"speakerTitle": "今谷三郎"
				},
				{
					"id": 120120529,
					"content": "可是我们家那孩子佳祐，从小就和我们一样，觉得安安稳稳的没什么不好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120530
					],
					"speakerTitle": "今谷三郎"
				},
				{
					"id": 120120530,
					"content": "小孩子嘛，就是会因为对错而争论得很厉害，最后朔次郎就一气之下，独自离开了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120531
					],
					"speakerTitle": "今谷三郎"
				},
				{
					"id": 120120531,
					"content": "原来是这样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120532
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120120532,
					"content": "那之后佳祐虽然什么都没跟我和老婆子说，但能看出来，他很伤心，但心里的想法，又不愿和我们讲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120533
					],
					"speakerTitle": "今谷三郎"
				},
				{
					"id": 120120533,
					"content": "后来，不知道是赌气还是什么其他原因，他就去了天领奉行，很少回来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120534
					],
					"speakerTitle": "今谷三郎"
				},
				{
					"id": 120120534,
					"content": "其他的忙，我们跟佳祐好好说说，他应该是会帮的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120535
					],
					"speakerTitle": "今谷香里"
				},
				{
					"id": 120120535,
					"content": "但如果是朔次郎的事，我觉得…我们没有办法插手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120536
					],
					"speakerTitle": "今谷香里"
				},
				{
					"id": 120120536,
					"content": "没想到这么巧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120537
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120120537,
					"content": "我明白了。我问朔次郎他为什么回来的时候，他也不愿意细讲，只说是「以前犯了错」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120538
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120120538,
					"content": "我终于明白他为什么下不了决心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120539
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120120539,
					"content": "明明是童年挚友，现在一个是天领奉行的人，一个在被天领奉行通缉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120540,
						120120541
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120120540,
					"content": "这就是命运吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120120542
					]
				},
				{
					"id": 120120542,
					"content": "没关系，既然这样的话，就不打扰你们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120543
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120120543,
					"content": "我们会帮朔次郎想想办法的，两位也不用勉强，这件事，还是留给朔次郎和佳祐自己去处理吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120544
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 120120544,
					"content": "嗯，要是他们的关系能和好如初就好了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120545
					],
					"speakerTitle": "今谷香里"
				},
				{
					"id": 120120545,
					"content": "那么多年之前的争吵，现在也应该放下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "今谷三郎"
				},
				{
					"id": 120120541,
					"content": "我也没想到。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120120542
					]
				},
				{
					"id": 120120510,
					"content": "令人羡慕。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120120511
					]
				}
			]
		},
		{
			"id": 1201206,
			"completionStepIds": [
				1201206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
