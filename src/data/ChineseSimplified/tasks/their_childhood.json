			},
			"dialogs": [
				{
					"id": 240030901,
					"content": "#哥！你是不是把我藏的地方告诉{M#大哥哥}{F#大姐姐}了，{M#他}{F#她}怎么找到得这么快呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030902
					],
					"speakerTitle": "韦吕"
				},
				{
					"id": 240030902,
					"content": "我都说过了，是你藏的地方太明显了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030903,
						240030904
					],
					"speakerTitle": "奥雷勒"
				},
				{
					"id": 240030903,
					"content": "我经验很丰富的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030905
					]
				},
				{
					"id": 240030905,
					"content": "#是吗？那{M#大哥哥}{F#大姐姐}，你以后会不会经常来呀？我们一起玩好不好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030906
					],
					"speakerTitle": "韦吕"
				},
				{
					"id": 240030906,
					"content": "爸妈白天都不在家，哥哥又老是在看书…都没什么时间陪我玩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030907
					],
					"speakerTitle": "韦吕"
				},
				{
					"id": 240030907,
					"content": "你也可以和我一样，多看看书柜里的那些书，这可比玩捉迷藏好，也有用多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030908
					],
					"speakerTitle": "奥雷勒"
