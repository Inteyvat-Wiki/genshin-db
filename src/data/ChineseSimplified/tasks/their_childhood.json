					"奥雷勒"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240030701,
					"content": "韦吕什么时候能懂点事呢，唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030702
					],
					"speakerTitle": "奥雷勒"
				},
				{
					"id": 240030702,
					"content": "你不躲着吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030703
					]
				},
				{
					"id": 240030703,
					"content": "我本来就不怎么想玩。如果不是韦吕吵着要出来玩捉迷藏，我还想多看一会书呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030704
					],
					"speakerTitle": "奥雷勒"
				},
				{
					"id": 240030704,
					"content": "爸和妈工作很辛苦了，我要快点长大…这样才能为他们分担点压力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030705
					],
					"speakerTitle": "奥雷勒"
				},
				{
					"id": 240030705,
					"content": "但韦吕一直说很想妈妈…我只能陪他玩会游戏，这样他就不会哭了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030706
					],
					"speakerTitle": "奥雷勒"
				},
				{
					"id": 240030706,
					"content": "#抱歉，我说太多了，{M#大哥哥}{F#大姐姐}。我先去集合点等着了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030707
					],
					"speakerTitle": "奥雷勒"
				},
				{
					"id": 240030707,
					"content": "希望韦吕不要把衣服弄脏了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奥雷勒"
				}
			]
		},
