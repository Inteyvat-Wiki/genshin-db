			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"韦吕",
					"奥雷勒"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240030101,
					"content": "我这次藏的地方，你一定找不到！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030102
					],
					"speakerTitle": "韦吕"
				},
				{
					"id": 240030102,
					"content": "如果你藏在那些地方，去找你的人就不是我，而是爸和妈了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030103
					],
					"speakerTitle": "奥雷勒"
				},
				{
					"id": 240030103,
					"content": "你们在做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030104
					]
				},
				{
					"id": 240030104,
					"content": "我正在和哥哥捉迷藏呢！但是…我藏的每一个地方他都知道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030105
					],
					"speakerTitle": "韦吕"
				},
				{
					"id": 240030105,
					"content": "韦吕…我们都在这里玩多久了，每一个能藏的角落都被你藏过了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030106
					],
					"speakerTitle": "奥雷勒"
				},
				{
					"id": 240030106,
					"content": "至于那些不能藏的地方…我已经和你说过很多次不能藏那里的原因了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030107
					],
					"speakerTitle": "奥雷勒"
				},
				{
					"id": 240030107,
					"content": "那些地方又没什么危险，爸和妈总是说得那么夸张…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030108
					],
					"speakerTitle": "韦吕"
				},
				{
					"id": 240030108,
					"content": "但你藏到那种地方会把衣服和裤子弄脏或者弄破，爸和妈工作已经很辛苦了，别让他们再费这种心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030109
					],
					"speakerTitle": "奥雷勒"
				},
				{
					"id": 240030109,
					"content": "唔…好吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030110,
						240030111
					],
					"speakerTitle": "韦吕"
				},
				{
					"id": 240030110,
					"content": "不然…我陪你们玩玩？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030112
					]
				},
				{
					"id": 240030112,
					"content": "#真的吗？！{M#大哥哥}{F#大姐姐}，你愿意陪我玩吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030113
					],
					"speakerTitle": "韦吕"
				},
				{
					"id": 240030113,
					"content": "韦吕，别给人家添麻烦！抱歉，我弟弟满脑子都想着玩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030114,
						240030115
					],
					"speakerTitle": "奥雷勒"
				},
				{
					"id": 240030114,
					"content": "没关系，我正好有空。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030116
					]
				},
				{
					"id": 240030116,
					"content": "好欸！哥哥你看，人家都答应了！我一定躲得比你好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030117
					],
					"speakerTitle": "韦吕"
				},
				{
					"id": 240030117,
					"content": "#好吧…那就麻烦您了，{M#大哥哥}{F#大姐姐}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030118
					],
					"speakerTitle": "奥雷勒"
				},
				{
					"id": 240030118,
					"content": "韦吕，不要躲在我和你说过的那些地方，今天晚上爸妈会晚点回来，把衣服弄破了可没人帮你补。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030119
					],
					"speakerTitle": "奥雷勒"
				},
				{
					"id": 240030119,
					"content": "知道啦，哥哥真唠叨…我先去躲着了，哥哥也一起玩嘛，快点快点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030120
					],
					"speakerTitle": "韦吕"
				},
				{
					"id": 240030120,
					"content": "你先去吧，我已经想好躲在哪了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030121
					],
					"speakerTitle": "奥雷勒"
				},
				{
					"id": 240030121,
					"content": "#真的？哥哥又吹牛…肯定第一个被{M#大哥哥}{F#大姐姐}找到！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030122
					],
					"speakerTitle": "韦吕"
				},
				{
					"id": 240030122,
					"content": "奥雷勒和韦吕先分别去躲了起来…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 240030115,
					"content": "没关系，不算添麻烦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030116
					]
				},
				{
					"id": 240030111,
					"content": "我应该找不到你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030112
					]
				}
			]
		},
