			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"孙宇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210350101,
					"content": "唉，师妹…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350102,
						210350103
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210350102,
					"content": "咦？孙宇？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350104
					]
				},
				{
					"id": 210350104,
					"content": "旅行者？真是巧了，居然能在这里遇见你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350105
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210350105,
					"content": "我…正在这里做些锻炼，准备过段时间就离开璃月，外出游历。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350106,
						210350107
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210350106,
					"content": "你怎么突然要离开璃月？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350108
					]
				},
				{
					"id": 210350108,
					"content": "咳，说来惭愧。之前我虽然一直说着要复兴古华派，但平日里的行动…说是访仙，其实也就是在绝云间里闲逛罢了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350109
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210350109,
					"content": "虽然承蒙师妹不弃，但我内心深知，如此行为，对复兴古华派实无意义…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350110
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210350110,
					"content": "前段时间，当我回城里采买物资的时候，偶然和一个枫丹来的客商聊了两句。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350111
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210350111,
					"content": "这位枫丹人和我说：「你不可能在出现问题的地方找到解决问题的方案。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350112
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210350112,
					"content": "我想了好久…也许这位枫丹客商，是在建议我去璃月之外的地方游历一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350113,
						210350114
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210350113,
					"content": "出去看看也好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350115
					]
				},
				{
					"id": 210350115,
					"content": "我也是这么想，但…但师妹她却不愿意离开璃月。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350116
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210350116,
					"content": "平日里她耍小脾气的时候，我知道她是在和我逗乐，哄哄就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350117
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210350117,
					"content": "但这次她却像是真生气了，无论如何都不愿听我说话，还独自跑回了城里，唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350118
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210350118,
					"content": "先不说这些了，这些闲杂事情你听了也烦…旅行者，我能拜托你一件事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350119
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210350119,
					"content": "虽然我会一些防身的武术，但平日里几乎没怎么真的动过手。以后要外出游历，免不了要正经实战…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350120
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210350120,
					"content": "旅行者，我听说过许多你在外冒险的事迹，你一定知道不少应对魔物的方法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350121
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210350121,
					"content": "你能陪我一起去周围找些魔物练练手，顺便再指导指导我吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350122,
						210350123
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210350122,
					"content": "没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350125
					]
				},
				{
					"id": 210350125,
					"content": "我看看…附近就有一处魔物的聚集地，咱们就先去那里好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210350123,
					"content": "哼，就怕你看不清我的动作。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350124
					]
				},
				{
					"id": 210350124,
					"content": "这…阁下武艺竟如此高强？哈哈哈，那就只能请阁下把动作稍稍放慢些啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350125
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210350114,
					"content": "就当做是散心也好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350115
					]
				},
				{
					"id": 210350107,
					"content": "你不是要复兴古华派吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350108
					]
				},
				{
					"id": 210350103,
					"content": "你在做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350104
					]
				}
			]
		},
		{
			"id": 2103502,
			"completionStepIds": [
				2103503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2103503",
							"2"
						],
						"stepId": 2103503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"孙宇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210350201,
					"content": "呼…呼…真是难以对付…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350202
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210350202,
					"content": "抱歉，让你见笑了。没想到正式对敌时，我会这么紧张…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350203
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210350203,
					"content": "总之我…我还是需要多多锻炼。多谢了旅行者，这些报酬给你，请收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350204
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210350204,
					"content": "你真的要离开璃月？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350205
					]
				},
				{
					"id": 210350205,
					"content": "我还没有完全想好，我还得再想想，顺便…再尝试说服一下师妹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孙宇"
				}
			]
		}
	]
}