			"dialogs": [
				{
					"id": 4530701,
					"content": "这个爪印——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530702
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4530702,
					"content": "通过爪印，可以推断出来狼的数量和大小。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530703
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4530703,
					"content": "数量不止两条，大小的话，这一匹大概有——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530704
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4530704,
					"content": "大概有？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4530705
					]
				},
				{
					"id": 4530705,
					"content": "…嗯，呃，大概有两米高！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530706
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4530706,
					"content": "…派蒙，你，见过狼吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4530707
					]
				},
				{
					"id": 4530707,
					"content": "狼很神秘的，一般哪有机会看到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
