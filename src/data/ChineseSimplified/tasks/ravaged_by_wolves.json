			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"神奇的霍普金斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4530601,
					"content": "你们调查找到什么结果了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530602
					],
					"speakerTitle": "神奇的霍普金斯"
				},
				{
					"id": 4530602,
					"content": "呜啊，你站起来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530603
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4530603,
					"content": "我缓过来了。甚至可以说，我从地狱里爬回来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530604
					],
					"speakerTitle": "神奇的霍普金斯"
				},
				{
					"id": 4530604,
					"content": "所以骑士团调查有结果了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530605
					],
					"speakerTitle": "神奇的霍普金斯"
				},
				{
					"id": 4530605,
					"content": "从残留的毛发里能看出来狼群生活在奔狼领。除此以外都不太明朗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530606
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4530606,
					"content": "不过请你们放心，我马上就去奔狼领把事件调查清楚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530607
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4530607,
					"content": "骑士团绝对不会放任这么危险的事情继续发生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530608
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4530608,
					"content": "行吧。补救得晚了点，好过完全不作为。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530609
					],
					"speakerTitle": "神奇的霍普金斯"
				},
				{
					"id": 4530609,
					"content": "哇，这个人好没礼貌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530610
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4530610,
					"content": "我们现在就要去做该做的事情了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530611
					],
					"speakerTitle": "神奇的霍普金斯"
				},
				{
					"id": 4530611,
					"content": "喂，不要做蠢事啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530612
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4530612,
					"content": "笑话，我们和骑士团不一样。这仇必须算清楚了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530613
					],
					"speakerTitle": "神奇的霍普金斯"
				},
				{
					"id": 4530613,
					"content": "我们走！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530614
					],
					"speakerTitle": "神奇的霍普金斯"
				},
				{
					"id": 4530614,
					"content": "真是凄惨啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530615
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 4530615,
					"content": "你在说什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530616
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4530616,
					"content": "说他们的未来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530617
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 4530617,
					"content": "我同意你的意见。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4530618
					]
				},
				{
					"id": 4530618,
					"content": "年轻人容易火气上头。劳烦各位再照顾一下吧，别让他们做蠢事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530619
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 4530619,
					"content": "放心吧，这是我们职责所在——虽然这家伙真的很让人不爽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530620
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4530620,
					"content": "请交给我们吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530621
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4530621,
					"content": "那我们赶快去奔狼领吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
