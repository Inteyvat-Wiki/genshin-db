			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"安柏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4530501,
					"content": "这是狼的毛发。 据说璃月人会拿这个制作毛笔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530502
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4530502,
					"content": "毛色和书上说的蒙德狼毛色出入很大。说不定真的是外来的狼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530503
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4530503,
					"content": "狼身上有好几种毛发，颜色深浅都不同啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4530504,
					"content": "不过，你看看这个——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530505
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4530505,
					"content": "这是另一撮毛，不过，上面沾了什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530506,
						4530507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4530506,
					"content": "是种子。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4530508
					]
				},
				{
					"id": 4530508,
					"content": "哼哼，这是钩钩果的种子。看到了吗，种子上的这种钩子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530509
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4530509,
					"content": "蒙德境内，它只在奔狼领和明冠峡这种野地方才长。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530510
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4530510,
					"content": "那…果然还是奔狼领的狼群咯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530511
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4530511,
					"content": "嗯…同一地区，也可能会有多个狼群争夺领地的情况。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530512
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4530512,
					"content": "虽然不知道详情，但这也是个重要的线索，足够推进调查了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530513
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4530513,
					"content": "在出发之前，我去安抚一下村民的情绪吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安柏"
				},
				{
					"id": 4530507,
					"content": "有什么特殊的吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4530508
					]
				}
			]
		},
		{
			"id": 45306,
			"completionStepIds": [
				45306
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
