			},
			"dialogs": [
				{
					"id": 4530101,
					"content": "唉，真是凄惨啊。 站都站不起来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530102
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 4530102,
					"content": "什么？！真是太可恶了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530103
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4530103,
					"content": "可是……他没有受伤啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4530104,
					"content": "没错，太凄惨了。 他被吓得站不起来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530105
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 4530105,
					"content": "哦……那，那真是太凄惨了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530106
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4530106,
					"content": "刚才还有没有目击到什么有用的情报？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530107
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4530107,
					"content": "这，这还是我第一次见到狼，真是太吓人了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530108
					],
					"speakerTitle": "神奇的霍普金斯"
				},
				{
					"id": 4530108,
					"content": "…看来是没有什么有用的目击情报了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530109
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4530109,
					"content": "还是再去调查一下现场的痕迹吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安柏"
				}
			]
		},
		{
			"id": 45305,
			"completionStepIds": [
				45305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"45305",
							"2"
						],
						"stepId": 45305,
						"stateName": "QUEST_STATE_UNFINISHED"
