			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"多莉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765060101,
					"content": "#哎呀，这不是{NICKNAME}和派蒙嘛！想不到在这里也能和两位相遇，这一定是能带来好运的奇妙缘分啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060102
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 765060102,
					"content": "多莉！你怎么一个人在这里呀？难道是摆摊卖东西吗？欸，不过我怎么没看到你的商品…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765060103,
					"content": "真是不好意思，今天大名鼎鼎的旅行商人多莉暂时歇业哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060104
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 765060104,
					"content": "我现在啊，正学着那些挪德卡莱的本地人，在这座「乐园」里度过普普通通又自由自在的一天呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060105
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 765060105,
					"content": "哇，真的假的？没在忙着做买卖、赚摩拉的多莉，真是比沙漠里下雨还要少见啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765060106,
					"content": "哼哼，就算我本人在享受难得的假期，我那些店铺和勤劳能干的员工们，也依然在不停地为我赚取源源不断的摩拉呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060107
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 765060107,
					"content": "只要我账户上的数字还在蹭蹭地往上涨，那就没什么可担心的啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060108
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 765060108,
					"content": "这么说来，两位难道是遇到了什么难题吗？虽然我还在休假，但是对于送上门来的生意，我可是从来都不会拒绝的哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060109,
						765060110
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 765060109,
					"content": "我们正在四处参观。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765060111
					]
				},
				{
					"id": 765060111,
					"content": "哦哦，原来是想记录下挪德卡莱的独特风光啊！那你们可算是问对人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060112
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 765060112,
					"content": "我对这里的熟悉程度，虽然可能还比不上那些土生土长的地头蛇，但是说到风景独特的拍摄点，我还是能给你们推荐不少的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060113
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 765060113,
					"content": "看在咱们这么熟的份上，我亲自给你们当导游，费用就给你们打个骨折友情价，一天只收你们区区五十万摩拉！怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060114
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 765060114,
					"content": "呜哇…不愧是多莉，还是三句话离不开从我们的口袋里掏摩拉的事情呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765060115,
					"content": "哎呀呀，我这可都是为了让我最重要的客户，能在挪德卡莱留下一段最开心、最难忘的美好回忆嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060116,
						765060117
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 765060116,
					"content": "既然你如此盛情…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765060118
					]
				},
				{
					"id": 765060118,
					"content": "哎？为我拍照？这个提议听起来倒是有趣。不过嘛，这些画片可不能用于商业宣传哦，我的肖像权可是价值连城的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060119
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 765060119,
					"content": "放心好了，我们只是单纯想给老熟人拍个照，留作纪念而已啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765060120,
					"content": "#好好好，既然是{NICKNAME}亲自开口，我就破例给你们当一回模特。请务必把我拍得雍容华贵、气质非凡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060121
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 765060121,
					"content": "我想想啊…画片的题目嘛，就叫「多莉·桑歌玛哈巴依老爷的乐园假日」。是不是很棒？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "多莉"
				},
				{
					"id": 765060117,
					"content": "能否为你拍摄画片呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765060118
					]
				},
				{
					"id": 765060110,
					"content": "顺便寻找拍摄素材。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765060111
					]
				}
			]
		},
