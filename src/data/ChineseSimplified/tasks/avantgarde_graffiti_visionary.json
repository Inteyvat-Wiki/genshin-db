							7574.74
						],
						"pointId": 9216
					}
				]
			},
			"dialogs": [
				{
					"id": 755000101,
					"content": "呜哇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755000102,
					"content": "仔细看的时候才发现，台上这些「回声之子」跳的舞真厉害哇！人的身体居然能做出这么夸张的动作…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755000103,
					"content": "配合节奏感超强的音乐，还有刺激的火光，相比其他国家的艺术，有着完全不同的气质！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755000104,
					"content": "#这位容光焕发的{M#少年}{F#少女}，还有飘浮着的哇音玩偶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000105
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755000105,
					"content": "我看你们感官敏锐，气质不凡，肯定能成为前卫艺术的先锋，涂鸦画师的超新星！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000106
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755000106,
					"content": "要跟着我「炫彩呆子」一起混，把握最新潮的艺术理念吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000107
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755000107,
					"content": "哇啊，又是奇怪的外号！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000108,
						755000109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755000108,
					"content": "你还在哇。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755000110
					]
				},
				{
					"id": 755000110,
					"content": "这次我可不会被带偏了——重点不在于哇不哇，或者新外号，而是这个「炫彩呆子」说的话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755000111,
					"content": "「前卫的理念」，听起来好像是…纳塔艺术与众不同的关键点？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755000112,
					"content": "好悟性~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000113
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755000113,
					"content": "如你所见，富有张力的舞姿、律动跳脱的音乐、还有色彩鲜明的涂鸦，这些都离不开前卫理念的熏陶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000114
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755000114,
					"content": "在纳塔人的口中，时尚、潮流、新奇之类的说法，全都是前卫理念的同义词。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000115
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755000115,
					"content": "而我「炫彩呆子」作为「涂鸦联盟」的中流砥柱，正尝试让更多人理解前卫，践行前卫，用前卫把世界碾一遍…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000116
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755000116,
					"content": "从而让更多艺术不断进步，创造出非同凡响的美学产物，画出更狂猛的大尺寸涂鸦稿！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000117,
						755000118
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755000117,
					"content": "好难懂。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755000119
					]
				},
				{
					"id": 755000119,
					"content": "那就说点具体的，比如舞台背景的那幅大型涂鸦，我也参与了它的绘制。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000120
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755000120,
					"content": "假如背景换成一幅写实的风景画、枫丹的唯美油画，或是须弥的壁画…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000121
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755000121,
					"content": "你觉得搭调吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000122
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755000122,
					"content": "这个比方倒是很直白，我好像有点明白了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755000123,
					"content": "如果背景的图形和配色没现在的涂鸦这么夸张，音乐和舞蹈，好像确实也少了点劲头？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755000124,
					"content": "当然，我并不是说风景画、油画或壁画就不好。只是它们在需要强调张力和锐气的场合，不如前卫的涂鸦那么合适！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000125
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755000125,
					"content": "要我说，不管纳塔的哪个部族，都有一种向上冲击，追求锐势的气魄，因此，前卫也可以说是纳塔的主调！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000126
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755000126,
					"content": "明明名字里有「呆子」这个词，懂的道理却挺多的嘛，你好厉害！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000127,
						755000128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755000127,
					"content": "你要收我们为徒吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755000129
					]
				},
				{
					"id": 755000129,
					"content": "嘿！你这反应，挺老辣啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000130
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755000130,
					"content": "不用紧张，我们不拘泥于死板的师徒关系，不在乎钱和名分，我们注重的是分享经验，期待分享之物到处开花结果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000131
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755000131,
					"content": "只要你能洞察到前卫艺术的精髓，并创作出相应的涂鸦作品，我就非常满意了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000132
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755000132,
					"content": "甚至会大把大把倒贴你摩拉和物资，帮助你迅速成长为可靠的涂鸦高手…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000133
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755000133,
					"content": "然后来帮我画稿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000134,
						755000135
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755000134,
					"content": "啊？我来画稿？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755000136
					]
				},
				{
					"id": 755000136,
					"content": "或者帮我把涂鸦艺术宣传到其他地方，吸引更多人才加入涂鸦联盟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000137
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755000137,
					"content": "毕竟我们的目标是给纳塔的每座山画上无比前卫的涂鸦，只凭寥寥十几个人肯定忙不过来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000138
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755000138,
					"content": "我的背，我的腰…哎呀…成天举着染料罐画来画去，说不定骨头都歪了，肩膀和大腿都错位了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000139
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755000139,
					"content": "本来想说事出反常必有妖，换成其他人，我甚至有点担心是不是骗子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000140
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755000140,
					"content": "不过看你说得这么诚实，好像确实没什么可疑的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000141
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755000141,
					"content": "#学一手涂鸦的本领，说不定以后还能派上用场，比如…画一面「{NICKNAME}和派蒙领地之墙」，吓跑魔物和坏人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000142
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755000142,
					"content": "不愧是我看中的人选，痛快！那我们就进入正题了——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000143
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755000143,
					"content": "涂鸦这门手艺，对画技的要求并不严苛，在我看来，与其先练画，不如先去找准前卫理念的准绳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000144
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755000144,
					"content": "准绳？是…原则的意思吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000145
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755000145,
					"content": "差不多吧！总之要找到超脱拘束的灵感，并将其自由自在地表达出来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000146
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755000146,
					"content": "为此，你们可以像我一样，在竞速挑战中捕捉风景扭曲形变的样貌，在近身搏斗中找寻人体动作的极限…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000147
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755000147,
					"content": "如此一来，就能构思涂鸦所需要的夸张线条。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000148
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755000148,
					"content": "至于色彩方案，将多种自然界的物品混搭，综合它们的配色，往往能获得意想不到的惊喜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000149
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755000149,
					"content": "听起来有点熟悉…又不太对劲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000150,
						755000151
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755000150,
					"content": "在竞速和打架中观察线条。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755000152
					]
				},
				{
					"id": 755000152,
					"content": "这种研究「艺术理念」的方法还真不一样，果然，纳塔人思考的方式真的很特别…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000153
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755000153,
					"content": "那么，收下我的这份涂鸦指南，带上这台留影机，在纳塔各处大闹一番，顺带好好感受这个国家独特之气的熏陶吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000154
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755000154,
					"content": "等到你们归来的时候，我就能根据你们的见闻，帮你们总结出最能让你们理解的前卫理念！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755000151,
					"content": "收集各种物产，研究色彩。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755000152
					]
				},
				{
					"id": 755000135,
					"content": "吔？这样抓助手？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755000136
					]
				},
				{
					"id": 755000128,
					"content": "学你的本事多少摩拉？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755000129
					]
				},
				{
					"id": 755000118,
					"content": "太抽象了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755000119
					]
				},
				{
					"id": 755000109,
					"content": "哇音派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755000110
					]
				}
			]
		}
	]
}