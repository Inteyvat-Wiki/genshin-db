			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"方谨",
					"刻晴",
					"夜兰"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							1108.29,
							202.929,
							-9.85
						],
						"pointId": 300201064
					},
					{
						"sceneId": 3,
						"position": [
							975.844,
							260.604,
							-187.825
						],
						"pointId": 310500127
					}
				]
			},
			"dialogs": [
				{
					"id": 716700201,
					"content": "唔…不太对劲啊，远处那个地脉淤积的烟团，越看越邪门，它就是异常魔物的来源吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716700202,
					"content": "看起来，千岩军专门为它建造了一个营地，还有好多巡逻的士兵和工事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700203,
						716700204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716700203,
					"content": "以前好像见过类似的淤积点。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716700205
					]
				},
				{
					"id": 716700205,
					"content": "嗯！就按以前的惯例办事吧——我们和千岩军并肩作战，把所有魔物咚咚打翻，然后想办法处理掉淤积点！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716700206,
					"content": "两位旅人，前方危险，请止步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700207
					],
					"speakerTitle": "方谨"
				},
				{
					"id": 716700207,
					"content": "#等等…这种气势…莫非你是{NICKNAME}教头？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700208
					],
					"speakerTitle": "方谨"
				},
				{
					"id": 716700208,
					"content": "#咦？{NICKNAME}，你难道趁我睡着的时候去千岩军打工了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700209,
						716700210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716700209,
					"content": "我吗？不可思议…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716700211
					]
				},
				{
					"id": 716700211,
					"content": "我叫方谨，是这支千岩军分队的领队。我曾听苏定参谋提到你，苏定说，你是百年难遇的将才。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700212
					],
					"speakerTitle": "方谨"
				},
				{
					"id": 716700212,
					"content": "情报也显示，西风骑士团的荣誉骑士在紧急时刻享有队长级的指挥权，那于情于理，也要尊称你一声教头。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700213
					],
					"speakerTitle": "方谨"
				},
				{
					"id": 716700213,
					"content": "正事要紧，请两位跟我去见玉衡大人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700214
					],
					"speakerTitle": "方谨"
				},
				{
					"id": 716700214,
					"content": "刻晴居然也在？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716700215,
					"content": "那事情好像不简单了呢，看来不能直接抡拳头解决了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716700216,
					"content": "#玉衡大人，果然如您所料，{NICKNAME}与{M#他}{F#她}的副官派蒙来访了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700217
					],
					"speakerTitle": "方谨"
				},
				{
					"id": 716700217,
					"content": "有劳了，方谨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700218
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700218,
					"content": "#好久不见，{NICKNAME}，你果然还是老样子，得到消息就火速赶来前线。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700219,
						716700220
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700219,
					"content": "没错，本将来帮忙！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716700221
					]
				},
				{
					"id": 716700221,
					"content": "那我就长话短说了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700222
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700222,
					"content": "多年以来，这里的地脉淤积点一直很稳定，但不知为什么，最近它突然异常活跃，引发了数次魔物袭击事件。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700223
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700223,
					"content": "而且，清除外溢的魔物后，这个紊乱点不会消散，还能将接触它的人送往奇异的秘境，这种情况前所未见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700224
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700224,
					"content": "太古怪了，难不成，这个地脉淤积点…成了某种意义上的锚点？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716700225,
					"content": "那只凭目前的兵力？是不是有点不够？应该尽快呼叫增援吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716700226,
					"content": "这倒不用担心，目前的防线非常稳定，将士们都来自归离原方向的精锐部队，经验丰富，说句以一当百都不夸张。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700227
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700227,
					"content": "真正的麻烦之处在于，要是找不到地脉紊乱的根本原因，长期在此驻军作战，只会白白消耗人力物力，使部队疲惫磨损。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700228
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700228,
					"content": "用兵讲究精准节俭，直击要害，一味被动防御，永远无法赢得胜利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700229
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700229,
					"content": "说的有道理…总是挨了打才反击，让人感觉不踏实，很不爽！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700230
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716700230,
					"content": "夜兰已经领着部下进入秘境调查了，再过几个时辰，应该就能带着关键情报归来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700231
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700231,
					"content": "#啊呀，不好意思，我是不是应当适当放慢步调，让玉衡大人和{NICKNAME}先聊个尽兴…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700232
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 716700232,
					"content": "呜啊！什么时候出现的，夜兰！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700233
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716700233,
					"content": "这个速度，是进展不顺吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700234
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700234,
					"content": "悲喜参半吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700235
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 716700235,
					"content": "好消息是，大致的状况已有眉目——这次的异象，属于地脉紊乱的余威。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700236
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 716700236,
					"content": "通过调查已有样本，对照战史记载，我能确定，地脉正在秘境中重现它所记录的惨烈战局，外溢的魔物大抵也是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700237
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 716700237,
					"content": "地脉紊乱…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716700238
					]
				},
				{
					"id": 716700238,
					"content": "耳熟吗？那就对了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700239
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 716700239,
					"content": "我手头的情报显示，蒙德境内也发生过类似的异动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700240
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 716700240,
					"content": "好在当时的情况不算严重，荣誉骑士与某位暗夜英雄通力合作，不断清除地脉淤积点外放的魔物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700241
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 716700241,
					"content": "最终成功耗尽其中储存的「信息」，使地脉恢复了正常。可以说，无异于打赢了一场消耗战。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700242
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 716700242,
					"content": "原来这两个家伙属于同样的麻烦…难怪都红红的，看着像是一棵树上结出来的果子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700243,
						716700244
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716700243,
					"content": "哪位荣誉骑士啊？干得好喔！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716700245
					]
				},
				{
					"id": 716700245,
					"content": "#不错哦，{NICKNAME}。你还是擅长用轻松写意的态度，来给合作的对象暗示，为自己争取更好的价码。这一次，你绝不会失望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700246
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 716700246,
					"content": "欸？怎么开始听不懂了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700247
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716700247,
					"content": "接下来就是坏消息了吧，夜兰？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700248
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700248,
					"content": "嗯，显而易见，这次的地脉紊乱点与以往的孤例不同，仅仅处理外溢的魔物是不够的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700249
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 716700249,
					"content": "要是不直接抵达秘境的最深处，清除特定情境下的所有魔物，战局会不断重演，没有尽头。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700250
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 716700250,
					"content": "而且，紊乱点通向的秘境之中，似乎有着某种特殊规则，在提防我与其他将士，拒绝我们探查它的根源。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700251
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 716700251,
					"content": "起初，我们还能对其中的物品取样分析，但进入纵深区域后，将士们都感到身体虚弱，无法发挥正常力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700252
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 716700252,
					"content": "盘踞其中的魔物则加倍凶恶，甚至展现出全新的特质，相当棘手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700253
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 716700253,
					"content": "似乎只有很少受到地脉制约的人，才能摆脱干扰，洞察其中的独特规则…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700254
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 716700254,
					"content": "由这样的将才领兵，应当足以克服险恶的环境，直击地脉紊乱的要害。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700255,
						716700256
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 716700255,
					"content": "这下我听懂了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716700257
					]
				},
				{
					"id": 716700257,
					"content": "也就是说，要么选择在外防御魔物，直到紊乱点周期性停止活跃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700258
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700258,
					"content": "#要么由{NICKNAME}领兵，攻入其中，随机应变，压制异动的根源…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700259
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700259,
					"content": "明白了，我会做两手打算——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700260
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700260,
					"content": "稍后，我会联络凝光，为此地投入更多防务资金。同时，与开阳星商议，尽快安排后续的轮岗部队。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700261
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700261,
					"content": "#咦？我以为刻晴会直接拜托{NICKNAME}解决这个大麻烦呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700262
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716700262,
					"content": "守护璃月的安定，是千岩军和七星的使命；不让将士们无端冒险，是指挥者的职责。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700263
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700263,
					"content": "但于公于私，我都不希望你一人担下全部危险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700264
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700264,
					"content": "所以，如果你不愿意涉险，就由千岩军长期布防，安排多支部队轮换作战，以练兵的形式清剿魔物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700265
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700265,
					"content": "同时持续派出斥候，收集秘境中的情报，不断了解它的特性，争取在将来某天组织部队，一举将它平定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700266
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700266,
					"content": "当然，如果你有参战的想法，我也支持你，会让驻防部队全力支援你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700267
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700267,
					"content": "一旦有效遏制地脉的紊乱，我将以战功为依据，给你应得的酬劳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700268,
						716700269
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700268,
					"content": "于公于私，我都要帮忙才对！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716700270
					]
				},
				{
					"id": 716700270,
					"content": "没错哦，无论作为璃月人的好伙伴、王牌冒险家搭档，还是刻晴和夜兰的朋友，我们都不能坐视不管。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700271
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716700271,
					"content": "而且，我们完全不担心报酬的事，刻晴和夜兰无论如何都不会亏待我们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700272
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716700272,
					"content": "眼神认真起来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700273
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700273,
					"content": "气势很棒！那我们就这样达成合作吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700274
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700274,
					"content": "#夜兰，通知你的部下，准备协助{NICKNAME}深入秘境作战。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700275
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700275,
					"content": "稍等，我要分析片刻，地脉紊乱点的情况会周期性变化，还需谨慎入场。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700276
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 716700276,
					"content": "#{NICKNAME}也能趁此间隙调整状态，组建你的精锐小队，准备迎接此前少见的鏖战吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716701201
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 716701201,
					"content": "时机不错，抓准目前的窗口，应当能深入秘境的关键区域…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716701202
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 716701202,
					"content": "前提是找准沿途的「规则」，以得当的方式击败强敌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716701203
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 716701203,
					"content": "请保持谨慎和敏锐，时刻关注周围环境，还有己方的情况。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716701204
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716701204,
					"content": "状况不妙时，暂时撤退，重整态势也无妨，请别勉强自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716701205
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716701205,
					"content": "等你凯旋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716701206,
						716701207
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716701206,
					"content": "一定尽力而为！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716701208
					]
				},
				{
					"id": 716701208,
					"content": "嗯！刻晴和夜兰，等着我们的好消息哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716701207,
					"content": "我会努力战斗！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716701208
					]
				},
				{
					"id": 716700269,
					"content": "我也有很多并肩战斗的伙伴！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716700270
					]
				},
				{
					"id": 716700256,
					"content": "除了我好像确实没别人了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716700257
					]
				},
				{
					"id": 716700244,
					"content": "还有这一回事？想不起来！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716700245
					]
				},
				{
					"id": 716700220,
					"content": "没那么夸张，但也会尽力！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716700221
					]
				},
				{
					"id": 716700210,
					"content": "教头竟是我自己！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716700211
					]
				},
				{
					"id": 716700204,
					"content": "我们提高警惕，准备战斗吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716700205
					]
				}
			]
		},
