			"dialogs": [
				{
					"id": 716701101,
					"content": "看来，经过之前的一番波动，这个紊乱点暂时安定下来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716701102
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 716701102,
					"content": "不过，异象尚未完全消除，一段时间后，它必定会重归活跃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716701103
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716701103,
					"content": "但无论如何，也算是有了难得的空档期，趁这个功夫好好休憩一番，为下次战斗做好准备吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716701104
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716701104,
					"content": "好，我们会认认真真，做好功课的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716701105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716701105,
					"content": "#{NICKNAME}，借着这个机会，我们吃饱喝足，好好休息，养足精神！再仔细思考一下战术和对策！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
