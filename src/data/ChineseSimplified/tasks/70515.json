					"菲利斯·尤格"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705150201,
					"content": "完美，太美丽了！您的理解力和动手能力真不错，真是超乎我的预料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150202
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705150202,
					"content": "哈，《蒸汽鸟日报》还有几篇荒谬的稿件把您形容地就像是一个…一个…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150203,
						705150204
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705150203,
					"content": "一个…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705150205
					]
				},
				{
					"id": 705150205,
					"content": "呵…呵呵…一个…乐于用剑来说服人的…直爽勇者…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150206
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705150206,
					"content": "荒谬，愚蠢！写这几篇稿件的记者简直是无事生非！您明明是一位敏锐、聪慧、谦逊…又直爽的勇者！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150207
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705150207,
					"content": "等我有空了，我一定要写封信去狠狠驳斥他们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150208
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705150208,
					"content": "对了，这份机关就请您收下吧，无聊的时候，您可以用它来解闷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150209
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705150209,
					"content": "而我嘛…嗯…我得开始筹措去璃月的路费了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705150204,
					"content": "你接着说。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705150205
					]
				}
			]
