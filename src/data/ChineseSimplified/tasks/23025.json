			"trigger": {
				"objectNames": [
					"法伽尼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230250201,
					"content": "嘿——这位朋友，请问能否占用您一些时间？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250202,
						230250203
					],
					"speakerTitle": "法伽尼"
				},
				{
					"id": 230250202,
					"content": "有什么事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250208
					]
				},
				{
					"id": 230250208,
					"content": "您有没有想过这么一个问题：要是天塌下来该怎么办？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250209,
						230250210
					],
					"speakerTitle": "法伽尼"
				},
				{
					"id": 230250209,
					"content": "我觉得你多虑了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250212
					]
				},
				{
					"id": 230250212,
					"content": "或许是吧，但天空为什么不会坍塌？大地又为什么不会陷落？如果不经过准确的测量，这些问题就永远不会有答案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250213
					],
					"speakerTitle": "法伽尼"
				},
				{
					"id": 230250213,
					"content": "其实我已经有了一套完美的模型来解释这些问题，只是需要更多的观测数据来支撑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250214,
						230250215
					],
					"speakerTitle": "法伽尼"
				},
				{
					"id": 230250214,
					"content": "需要我帮忙吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250223
					]
				},
				{
					"id": 230250223,
					"content": "那您是愿意帮忙了吧，真是太感谢了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250224
					],
					"speakerTitle": "法伽尼"
				},
				{
					"id": 230250224,
					"content": "其实我已经选定了一个绝佳的观测地点，只是那附近的魔物有些活跃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250225
					],
					"speakerTitle": "法伽尼"
				},
				{
					"id": 230250225,
					"content": "拜托您驱离那些魔物，我好安心去做观测记录。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250226,
						230250228
					],
					"speakerTitle": "法伽尼"
				},
				{
					"id": 230250226,
					"content": "好的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250227
					]
				},
				{
					"id": 230250227,
					"content": "多谢了，我们这就上路吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "法伽尼"
				},
				{
					"id": 230250228,
					"content": "你也要到现场吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250229
					]
				},
				{
					"id": 230250229,
					"content": "毕竟有些数据还是得亲眼去见证，才能发现误差产生的原因啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250230
					],
					"speakerTitle": "法伽尼"
				},
				{
					"id": 230250230,
					"content": "埋头对着纸堆计算，可是会离正解越算越远的——我们快点上路吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "法伽尼"
				},
				{
					"id": 230250215,
					"content": "祝你好运，再见。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250216
					]
				},
				{
					"id": 230250216,
					"content": "等、等等啊！您再考虑一下吧，只要我的成果能够发表，那可是开天辟地的大事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250217
					],
					"speakerTitle": "法伽尼"
				},
				{
					"id": 230250217,
					"content": "到时候，您就是这篇伟大理论的协力者，我可以在文末的致谢列表里写上您的名字…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250218
					],
					"speakerTitle": "法伽尼"
				},
				{
					"id": 230250218,
					"content": "咕…要不然的话，第二作者的位置也不是不能…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250219
					],
					"speakerTitle": "法伽尼"
				},
				{
					"id": 230250219,
					"content": "有这么着急吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250220
					]
				},
				{
					"id": 230250220,
					"content": "要是再拿不出结果，我的研究经费怕是都要出问题…这可比天什么时候会塌要命得多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250221,
						230250222
					],
					"speakerTitle": "法伽尼"
				},
				{
					"id": 230250221,
					"content": "「第二作者」就算了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250223
					]
				},
				{
					"id": 230250222,
					"content": "报酬合理就可以。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250223
					]
				},
				{
					"id": 230250210,
					"content": "天应该塌不下来…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250212
					]
				},
				{
					"id": 230250203,
					"content": "我很忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250204
					]
				},
				{
					"id": 230250204,
					"content": "哦！请别这么说，有什么事情能比自己的居所坍圮在即还要严重？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250205
					],
					"speakerTitle": "法伽尼"
				},
				{
					"id": 230250205,
					"content": "你家屋子…要塌了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250206
					]
				},
				{
					"id": 230250206,
					"content": "咳咳，那当然不是。但如果您住在一座屋子里，却从没见过这屋子的全貌，也没人保证过屋子的结构强度…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250207
					],
					"speakerTitle": "法伽尼"
				},
				{
					"id": 230250207,
					"content": "那每天生活在这屋子里，也是会有不安的吧？那么住在这个世界里也是一个道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250208
					],
					"speakerTitle": "法伽尼"
				}
			]
		},
