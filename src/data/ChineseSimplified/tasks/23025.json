					"nextDialogs": [
						230250813
					]
				},
				{
					"id": 230250813,
					"content": "我也不是没有想过，加装回收装置啊、拓宽适用范围啊之类的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250814
					],
					"speakerTitle": "法伽尼"
				},
				{
