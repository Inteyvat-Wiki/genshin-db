			"dialogs": [
				{
					"id": 766600101,
					"content": "欢迎你，冒险家，需要我为您查看今天的委托吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766600102,
						766600103
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 766600102,
					"content": "果然还是这样最习惯…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766600104
					]
				},
				{
					"id": 766600104,
					"content": "咦，您是…急着办事么，我能为您做些什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766600105,
						766600106
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 766600105,
					"content": "没有没有。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766600107
					]
				},
				{
					"id": 766600107,
					"content": "我们就是单纯地很高兴见到你！嘿嘿，还是凯瑟琳最好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766600108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766600108,
					"content": "谢谢二位的热情…抱歉，可能我并没有理解您的幽默感…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766600109
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 766600109,
					"content": "但无论如何，欢迎您来到挪德卡莱，这里是一片充满机遇的土地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766600110
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 766600110,
					"content": "我相信，您一定能在这里经历伟大的冒险，取得举世无双的宝物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766600111
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 766600111,
					"content": "祝福您，冒险家，继续冒险吧，向着星辰与深渊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 766600106,
					"content": "我们就是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766600107
					]
				},
				{
					"id": 766600103,
					"content": "还好是你，凯瑟琳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766600104
					]
				}
			]
		}
	]
