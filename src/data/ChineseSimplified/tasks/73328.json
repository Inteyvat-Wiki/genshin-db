			"dialogs": [
				{
					"id": 733280101,
					"content": "是你，婕德——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733280102,
					"content": "#{NICKNAME}？！还有小派蒙！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280103
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733280103,
					"content": "哔哔——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280104
					],
					"speakerTitle": "奔奔"
				},
				{
					"id": 733280104,
					"content": "哈哈，我说什么来着！我们又见面了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280105
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733280105,
					"content": "你在这里做什么呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280106
					]
				},
				{
					"id": 733280106,
					"content": "嗯…成熟女人的小秘密？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280107
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733280107,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733280108,
					"content": "#{M#意思就是不要打听啦！我也是有隐私的…}{F#去找一家居酒屋，想办法让我开心，我说不定会告诉你…还要我教你吗？}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280109
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733280109,
					"content": "#{M#噗…是镖局的规定，我也不能说，抱歉啦。}{F#开、开玩笑啦，别当真呀！是镖局的规定…这一趟货要严格保密，抱歉啦。}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280110
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733280110,
					"content": "哼，神神秘秘的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733280111,
					"content": "所以…最近过得怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280112,
						733280113
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733280112,
					"content": "还不错。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280114
					]
				},
				{
					"id": 733280114,
					"content": "嗯…我也是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280115
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733280115,
					"content": "好啦，我不多留你了。唉…还有自己的事情要做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280116
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733280116,
					"content": "欸，婕德这么忙的吗…以前也不是这样子呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733280117,
					"content": "噗…这不是找到了「稳定」的工作了嘛，虽然工作内容和以前差不太多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280118
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733280118,
					"content": "在镖局找到了工作没多久，就又开始怀念以前无拘无束的日子了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280119
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733280119,
					"content": "虽然不知道你那边情况如何，但我一直在期待着你的故事，我也有很多故事要和你讲呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280120
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733280120,
					"content": "不过现在不着急啦，现在不着急…好的故事要多多积存，多多发酵嘛，曾经在沙漠里，旅人是要靠它来活命的！嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280121
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733280121,
					"content": "嗯…总之，请你保重。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280122
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733280122,
					"content": "你也保重。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280123
					]
				},
				{
					"id": 733280123,
					"content": "嗯，一千个拥抱，我会一直为你祈祷的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280124
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733280124,
					"content": "哔哔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280125
					],
					"speakerTitle": "奔奔"
				},
				{
					"id": 733280125,
					"content": "哈哈，奔奔也一样！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "婕德"
				},
				{
					"id": 733280113,
					"content": "一般般…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280114
					]
				}
