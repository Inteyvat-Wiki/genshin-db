					"nextDialogs": [
						733280203
					]
				},
				{
					"id": 733280203,
					"content": "谁知道呢？天空岛？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280204
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733280204,
					"content": "哈哈哈哈哈，开玩笑的！不过如果你想要在那里看到我，我也一定会在那里的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280205
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733280205,
					"content": "不要问为什么，我就是知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280208
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733280208,
					"content": "总之，期待下一次的相见吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "婕德"
				},
				{
					"id": 733280206,
					"content": "也给你一千个拥抱。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280207
					]
				},
				{
