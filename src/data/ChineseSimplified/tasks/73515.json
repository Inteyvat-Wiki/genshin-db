				"points": []
			},
			"dialogs": [
				{
					"id": 735150101,
					"content": "你来了啊，冒险家。我们正打算安装呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150102
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735150102,
					"content": "要是一切顺利的话，今天就能给那家伙来一记狠的了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150103
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735150103,
					"content": "在正式的充能过程中，可能也会有魔物过来侵扰。届时就得麻烦您多留意装置充能跟破损的情况了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150104,
						735150105
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735150104,
					"content": "交给我。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735150106
					]
				},
				{
					"id": 735150106,
					"content": "多谢你了，冒险家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150107
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735150107,
					"content": "啊——我想到一个好主意！你都为「对沙虫用杀虫炮」忙前忙后了这么久，这首次试射的荣耀…干脆就交给你吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150108,
						735150110
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735150108,
					"content": "你不打算自己来吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735150109
					]
				},
				{
					"id": 735150109,
					"content": "我只要看着它落地就已经心满意足啦！何况让别人去点火，我们才能欣赏到它开火时的全貌嘛…咳！总之！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150112
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735150112,
					"content": "你只需要从魔物手里保护好充能装置，等待能量蓄满之后，看准沙虫露出破绽的瞬间——再狠狠地往炮台上敲上一记就好啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150113
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735150113,
					"content": "剩下的事情，点火装置和自动修正机关会帮你搞定！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150114
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735150114,
					"content": "#听起来好厉害…{NICKNAME}！我也想看看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735150115,
					"content": "行吧，我来操作。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735150116
					]
				},
				{
					"id": 735150116,
					"content": "嘿嘿，那就这么说定了！我来给你讲讲具体的操作流程…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735150110,
					"content": "我不知道怎么操作…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735150111
					]
				},
				{
					"id": 735150111,
					"content": "你放心！我设计它的时候可是完美遵循了简单易用的交互原则。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150112
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735150105,
					"content": "没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735150106
					]
				}
			]
		}
	]
}