			"dialogs": [
				{
					"id": 711450101,
					"content": "#有劳两位了，{NICKNAME}顾问和这位才智出众的帮手！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711450102
					],
					"speakerTitle": "苏定"
				},
				{
					"id": 711450102,
					"content": "经过这段时间的推演，我们获得了充足的对抗案例，足以拆解出各种复杂战况的分析样本。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711450103
					],
					"speakerTitle": "苏定"
				},
				{
					"id": 711450103,
					"content": "接下来，只需根据推演兵种的特性，建立更宽泛的模型，就能撰写多种想定脚本，将它们交给多个单位的各级将士钻研。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711450104
					],
					"speakerTitle": "苏定"
				},
				{
					"id": 711450104,
					"content": "如果两位有兴趣，下次见面时，我也会为你们提供对应的想定脚本，以供你们在闲暇之时锻炼才思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711450105,
						711450107
					],
					"speakerTitle": "苏定"
				},
				{
					"id": 711450105,
					"content": "这就搞定了？好像还没玩几局…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711450106
					]
				},
				{
					"id": 711450106,
					"content": "我们深知两位事务繁忙，尽量排除了相似的推演，避免重复工作。当然，如果两位还没尽兴，再来多少次都没问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711450109
					],
					"speakerTitle": "苏定"
				},
				{
					"id": 711450109,
					"content": "总而言之，我代表千岩军的参谋部，以及其他参会单位的代表，向你们表示郑重的感谢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711450110
					],
					"speakerTitle": "苏定"
				},
				{
					"id": 711450110,
					"content": "希望以后还有机会与两位合作，进一步加强各单位清除魔物，改善治安状况的能力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711450111,
						711450112
					],
					"speakerTitle": "苏定"
				},
				{
					"id": 711450111,
					"content": "乐意至极！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711450113
					]
				},
				{
					"id": 711450113,
					"content": "哼哼，这次的进展真是超级顺利。感觉，我们和以前就认识的各种团队搞好了关系，还帮到了提瓦特各种地方的人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711450114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711450114,
					"content": "而且，看着你进行推演，我好像也学到了不少知识？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711450115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711450115,
					"content": "说不定，以后我们闲着无聊的时候，也可以来分析分析…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711450116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711450116,
					"content": "比如，唔…深渊法师和大雪猪王对对碰，谁会赢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711450117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711450117,
					"content": "或者…遗迹守卫和岩龙蜥，谁的脑袋更硬！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711450112,
					"content": "有空就来！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711450113
					]
				},
				{
					"id": 711450107,
					"content": "终于完成了！辛苦我和派蒙啦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711450108
					]
				},
				{
					"id": 711450108,
					"content": "嘿嘿，虽然我还没完全搞明白各种规则，但玩得还挺开心的！看起来结果也不错嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711450109
					],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
