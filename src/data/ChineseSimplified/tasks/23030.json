			},
			"dialogs": [
				{
					"id": 230300401,
					"content": "还好箱子里的药水罐没被打破，不然我们非得大吐特吐不可…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300402
					],
					"speakerTitle": "拉德普"
				},
				{
					"id": 230300402,
					"content": "你居然不习惯这种味道？这可都是你亲自做的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300403
					],
					"speakerTitle": "法尔希"
				},
				{
					"id": 230300403,
					"content": "我和你解释了多少次了，我加入的是生理催吐剂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300404
					],
					"speakerTitle": "拉德普"
				},
				{
					"id": 230300404,
					"content": "和习不习惯没关系，只要人一闻到，身体就会自行做出呕吐反应。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300405
					],
					"speakerTitle": "拉德普"
				},
				{
					"id": 230300405,
					"content": "我为什么要再重复一遍，你绝对听不懂…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300406
					],
					"speakerTitle": "拉德普"
				},
				{
					"id": 230300406,
					"content": "不过，雅丝敏到底跑哪里去了？药水也没播撒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300407
					],
					"speakerTitle": "拉德普"
				},
				{
					"id": 230300407,
					"content": "她一定又是发现了什么珍稀植物，忙着去采标本了。你还不知道她们阿弥利多的德行吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300408
					],
					"speakerTitle": "法尔希"
				},
				{
					"id": 230300408,
					"content": "好吧，这罐药物就由我们先看着，谢谢你帮忙，旅行者，这些东西请你收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300409
					],
					"speakerTitle": "拉德普"
				},
				{
					"id": 230300409,
					"content": "这群阿弥利多…真的是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "法尔希"
				}
			]
		},
		{
