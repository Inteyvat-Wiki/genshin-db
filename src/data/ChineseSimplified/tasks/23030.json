			"dialogs": [
				{
					"id": 230300201,
					"content": "喔！看那个箱子，里面应该装着那些药水吧，看来雅丝敏应该已经来过这里了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300202
					],
					"speakerTitle": "拉德普"
				},
				{
					"id": 230300202,
					"content": "咦？箱子上这些药水的盖子还没打开…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300203
					],
					"speakerTitle": "拉德普"
				},
				{
					"id": 230300203,
					"content": "别把盖子打开！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300204
					],
					"speakerTitle": "法尔希"
				},
				{
					"id": 230300204,
					"content": "呜啊！看后面，有蕈兽钻出来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230300205,
					"content": "啥？！之前还没有呢？这到底是怎么回事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300206
					],
					"speakerTitle": "拉德普"
				},
				{
					"id": 230300206,
					"content": "#别听他们唠叨了，{NICKNAME}，我们快点上吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
