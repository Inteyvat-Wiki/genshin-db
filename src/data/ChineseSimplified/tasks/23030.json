			},
			"dialogs": [
				{
					"id": 230300501,
					"content": "咳咳咳，咳咳…在这里应该可以了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300502
					],
					"speakerTitle": "拉德普"
				},
				{
					"id": 230300502,
					"content": "呜…呕…你…这都是你的手笔！你居然也会呕吐？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300503
					],
					"speakerTitle": "法尔希"
				},
				{
					"id": 230300503,
					"content": "呃…咳…咳咳…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230300504
					]
				},
				{
					"id": 230300504,
					"content": "我和你…和你…解释了多少次了，我加入的是生理催吐剂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300505
					],
					"speakerTitle": "拉德普"
				},
				{
					"id": 230300505,
					"content": "和习不习惯没关系，只要人一闻到，身体就会自行做出呕吐反应。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300506
					],
					"speakerTitle": "拉德普"
				},
				{
					"id": 230300506,
					"content": "我为什么要再重复一遍，你绝对听不懂…唔…呃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300507
					],
					"speakerTitle": "拉德普"
				},
				{
					"id": 230300507,
					"content": "咦？拉德普和法尔希，还有旅行者？你们怎么来了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300508
					],
					"speakerTitle": "雅丝敏"
				},
				{
					"id": 230300508,
					"content": "药水罐也破了…你们被魔物袭击了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300509
					],
					"speakerTitle": "雅丝敏"
				},
				{
					"id": 230300509,
					"content": "从表面上来看…确实是这样，你来的时候没看见魔物吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300510
					],
					"speakerTitle": "拉德普"
