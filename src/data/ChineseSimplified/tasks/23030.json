			},
			"dialogs": [
				{
					"id": 230300101,
					"content": "我们需要，更多的数据！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300102
					],
					"speakerTitle": "拉德普"
				},
				{
					"id": 230300102,
					"content": "你的这些装置没有数据支撑，怎么可能正常运行？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300103
					],
					"speakerTitle": "拉德普"
				},
				{
					"id": 230300103,
					"content": "你想把所有数据都搜集地尽善尽美了再动手？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300104
					],
					"speakerTitle": "法尔希"
				},
				{
					"id": 230300104,
					"content": "你捉鱼的时候需要看准每一道波浪吗？你只需要看准下面有鱼的那一条就行了 ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300105
					],
					"speakerTitle": "法尔希"
				},
				{
					"id": 230300105,
					"content": "这就是你永远也抓不上鱼的原因。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300106
					],
					"speakerTitle": "拉德普"
				},
				{
					"id": 230300106,
					"content": "你又没在室罗婆耽进修过！别掐字眼了，咱们必须得先干起来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300107
					],
					"speakerTitle": "法尔希"
				},
				{
					"id": 230300107,
					"content": "再拖下去，咱们和雅丝敏的论文说不定就要失去时效性了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300108
					],
					"speakerTitle": "法尔希"
				},
				{
					"id": 230300108,
					"content": "你们在吵什么呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230300109
					]
				},
				{
					"id": 230300109,
					"content": "你是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300110
					],
					"speakerTitle": "拉德普"
				},
				{
					"id": 230300110,
					"content": "这位一定是雅丝敏提到过的旅行者，您帮了我们不少忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300111
					],
					"speakerTitle": "法尔希"
				},
				{
					"id": 230300111,
					"content": "幸会！旅行者，真是幸会！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300112
					],
					"speakerTitle": "拉德普"
				},
				{
					"id": 230300112,
					"content": "我叫法尔希，现在正在刹诃伐罗学院求学。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300113
					],
					"speakerTitle": "法尔希"
				},
				{
					"id": 230300113,
					"content": "我是拉德普，是悉般多摩学院的学生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300114
					],
					"speakerTitle": "拉德普"
				},
				{
					"id": 230300114,
					"content": "旅行者，我们也想请你来帮一个忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300115
					],
					"speakerTitle": "法尔希"
				},
				{
					"id": 230300115,
					"content": "你知道雅丝敏最近正在这种「圣树」的根系周围播撒药水吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300116
					],
					"speakerTitle": "法尔希"
				},
				{
					"id": 230300116,
					"content": "不过…呃…最近雅丝敏撒的药水好像出了点问题…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300117
					],
					"speakerTitle": "法尔希"
				},
				{
					"id": 230300117,
					"content": "在她投药的区域周围，总是会出现各种各样的魔物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300118
					],
					"speakerTitle": "法尔希"
				},
				{
					"id": 230300118,
					"content": "我发誓，我绝对没有修改任何配方或者投药比例。一定是…呃，出现了什么预期外的情况。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300119
					],
					"speakerTitle": "拉德普"
				},
				{
					"id": 230300119,
					"content": "随你怎么说…总之，旅行者，请你和我们一同去雅丝敏播撒药物的地方看一看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300120
					],
					"speakerTitle": "法尔希"
				},
				{
					"id": 230300120,
					"content": "那边说不定又出现了不少魔物，我们可不敢自己过去…必须得找个武力高强的人同行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300121
					],
					"speakerTitle": "法尔希"
				},
				{
					"id": 230300121,
					"content": "更重要的是，就算那些蕈兽没什么太大危险性，但要是导师知道我们的药水出了这种问题…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300122
					],
					"speakerTitle": "拉德普"
				},
				{
					"id": 230300122,
					"content": "我们这篇论文的开题报告一定会被打回来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300123
					],
					"speakerTitle": "法尔希"
				},
				{
					"id": 230300123,
					"content": "特别是我们悉般多摩学院，如果提交上去的数据有错误，导师会骂死我们的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300124,
						230300125
					],
					"speakerTitle": "拉德普"
				},
				{
					"id": 230300124,
					"content": "交给我了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230300125,
					"content": "你们之前怎么解决这问题？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230300126
					]
				},
				{
					"id": 230300126,
					"content": "我们一般会雇佣冒险家，或者是去找我们的导师，请他出面，找几个信得过的镀金旅团成员帮忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300127
					],
					"speakerTitle": "法尔希"
				},
				{
					"id": 230300127,
					"content": "但我们导师的耐心也是有限的，现在这种情况，我们也不敢再去找他了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300128
					],
					"speakerTitle": "法尔希"
				},
				{
					"id": 230300128,
					"content": "所以，只能拜托你了！旅行者！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "拉德普"
				}
			]
		},
