			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"江雪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220040301,
					"content": "打，打倒了，完全没有看到动作…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220040302,
					"content": "你到底是谁呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220040303,
					"content": "一个钓鱼的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040304
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 220040304,
					"content": "可疑…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220040305
					]
				},
				{
					"id": 220040305,
					"content": "不错，我确实很可疑，但是这世界上有很多可疑的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040306
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 220040306,
					"content": "比如旁边那家客栈里有个厨子，之前很喜欢耍刀，现在很喜欢做菜，面颇狠，心很善。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040307
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 220040307,
					"content": "比如客栈里有一位老板，她说自己是蒙德人，却没有蒙德人认识她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040308
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 220040308,
					"content": "还有…比如你能用元素的力量，却没有神之眼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040309
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 220040309,
					"content": "但是有些「可疑」一看就不是「可怕」，所以不用担心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040310
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 220040310,
					"content": "这是给你的谢礼，拿好，我要继续钓鱼了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "江雪"
				}
			]
		}
	]
}