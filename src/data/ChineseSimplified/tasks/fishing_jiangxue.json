			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"江雪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220040101,
					"content": "到底什么时候才会上钩呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040102
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 220040102,
					"content": "你在做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220040103
					]
				},
				{
					"id": 220040103,
					"content": "我正在钓一条鱼，一条有点大的鱼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040104
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 220040104,
					"content": "我的一位朋友很喜欢做菜，我钓条大鱼给他，想必他会很高兴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040105
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 220040105,
					"content": "只不过，周围总是会有怪物过来捣乱，为了解决它们，那条鱼跑了又跑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040106
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 220040106,
					"content": "你身上的元素气息不错，愿意帮我解决一下那群怪物，让我能把那条鱼钓起来吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040107,
						220040109
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 220040107,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220040108
					]
				},
				{
					"id": 220040108,
					"content": "那就拜托你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040112
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 220040112,
					"content": "可是，你怎么知道什么时候会有怪物来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220040113,
					"content": "何须知道，抬眼一看就是，你看看你们后面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040114
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 220040114,
					"content": "后面…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220040109,
					"content": "你怎么知道…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220040110
					]
				},
				{
					"id": 220040110,
					"content": "我也曾经有过神之眼，虽然懒得再用，但是元素还是勉强能感觉到的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040111
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 220040111,
					"content": "既然有元素的力量傍身，那些怪物对你来说，想必也是小菜一碟吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040112
					],
					"speakerTitle": "江雪"
				}
			]
		},
		{
			"id": 2200403,
			"completionStepIds": [
				2200405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2200405",
							"2"
						],
						"stepId": 2200405,
						"stateName": "QUEST_STATE_UNFINISHED"
