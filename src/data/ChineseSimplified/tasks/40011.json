						400110207
					]
				},
				{
					"id": 400110207,
					"content": "啊…夏、夏装啊，那个是…是丽莎给我准备的惊喜。我猜，应该还有芭芭拉的建议。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110208
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400110208,
					"content": "刚才芭芭拉也说，难得来海岛，一定要换上夏装才有气氛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110209
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400110209,
					"content": "可是，我不太习惯这样的装扮…唉，但愿这身打扮不会太过奇怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "琴"
				}
			]
		},
