			"dialogs": [
				{
					"id": 400110501,
					"content": "怎么会有这种事，这片海域实在太神秘了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400110502,
					"content": "整片陆地都升了上来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110503
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 400110503,
					"content": "大魔王，大魔王，哇咿！我来抓你啦，嘎——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110504
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400110504,
					"content": "小可莉，永远这么有精神啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400110505,
					"content": "地面震动之前，我有听到类似机关的声音。依我看，这片海面下有着非常巨大的机关。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110506
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400110506,
					"content": "整片海岛位于机关构架出的底盘上，机关启动，将各个岛屿一并托出水面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110507
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400110507,
					"content": "这样的事情，堪称奇迹…难道这是风神巴巴托斯的力量吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110508
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 400110508,
					"content": "应该不是吧？我总觉得这更像是某个人刻意的作为…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110509
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400110509,
					"content": "怎么想都不可思议…用信件把我们引来这里，再以这样的机关挑战我们，所谓的嘟嘟大魔王绝非无能之辈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110510
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400110510,
					"content": "我也这么觉得。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110511
					]
				},
				{
					"id": 400110511,
					"content": "唉，假日的气氛一下就消失了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110512
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 400110512,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110513
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400110513,
					"content": "总之，我会打起精神做好最高级别的警戒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110514
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400110514,
					"content": "琴团长，雷厉风行的时候真帅气呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110515
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400110515,
					"content": "派蒙和我也会多加留心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110516
					]
				},
				{
					"id": 400110516,
					"content": "感谢你们的理解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110517
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400110517,
					"content": "找到了，大魔王！",
