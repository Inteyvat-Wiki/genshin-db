					"nextDialogs": [
						400110519
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400110519,
					"content": "既然要可莉来找你，那可莉就来啦！蹦蹦炸弹，预备——！我们一起跑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110520
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400110520,
					"content": "那是…<color=#00E1FFFF>海中央的平台</color>？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110521
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 400110521,
					"content": "确实有东西出现了。各位，可以靠近查看，但请务必保持警戒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "琴"
				}
			]
