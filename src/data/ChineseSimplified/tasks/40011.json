			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"琴"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400110201,
					"content": "海面上的浮标到底意味着什么呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110202,
						400110206
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400110202,
					"content": "关于群岛…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110203
					]
				},
				{
					"id": 400110203,
					"content": "这片群岛与世隔绝，就像一处自然形成的秘境。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110204
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400110204,
					"content": "我们来这里，既有信的指引，也有温迪和特瓦林的帮助…一切实在太过巧合，我有些担心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110205
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400110205,
					"content": "不过，我之所以会在这里，就是为了保护各位。所以请放心，不论发生什么事，我都会与你们一同面对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "琴"
				},
				{
					"id": 400110206,
					"content": "关于夏装…",
