					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110604
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 400110604,
					"content": "嘟嘟大魔王，可莉来见你啦！你可以…呃…判、判…嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110605
