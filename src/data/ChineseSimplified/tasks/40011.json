	"talks": [
		{
			"id": 4001101,
			"completionStepIds": [
				4001101
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
