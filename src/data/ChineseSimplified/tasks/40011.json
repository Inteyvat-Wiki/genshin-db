			},
			"dialogs": [
				{
					"id": 400110701,
					"content": "荣誉骑士，请看这里！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110702
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 400110702,
					"content": "唔…？这是什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110703
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400110703,
					"content": "叠放的石块和小小的花朵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110704
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 400110704,
					"content": "这种感觉，好像是在纪念某个人。",
