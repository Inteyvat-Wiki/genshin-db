			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙",
					"琴",
					"芭芭拉",
					"可莉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400110101,
					"content": "唔…天气真好，我都睡迷糊了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400110102,
					"content": "早上好！哇，你们这身打扮是？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400110103,
					"content": "嘿嘿，好看吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110104
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 400110104,
					"content": "我们都换了夏装哦！虽然来这里并不是为了玩…无论如何都不想错过美丽的夏日海景呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110105
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 400110105,
					"content": "不、不会很奇怪吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110106
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400110106,
					"content": "如此飘逸轻便的服装，肯定不适合我…咳！失礼了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110107,
						400110108
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400110107,
					"content": "没有这种事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110109
					]
				},
				{
					"id": 400110109,
					"content": "是吗…谢谢你，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110110
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400110110,
					"content": "不过琴团长会特意准备夏装，真叫人意外呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400110111,
					"content": "不不，按照姐姐的性格才不会自己准备呢，是我和丽莎小姐为她选的哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110112
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 400110112,
					"content": "直接脱口而出「姐姐」了…而且自己完全没有注意到，芭芭拉已经沉醉于夏日了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400110113,
					"content": "夏装…真是说来话长啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110114
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400110114,
					"content": "本以为丽莎给的口袋里是应急妙计，没想到，里面居然是一套夏装…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110115
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400110115,
					"content": "连配饰都带齐了，该说不愧是丽莎吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400110116,
					"content": "骑士团的各位无时无刻不想着让我休假…看来是我平时真的把自己逼得太紧了吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110117
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400110117,
					"content": "大家快来可莉这边！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110118
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400110118,
					"content": "是可莉的声音！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110119
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400110119,
					"content": "有奇怪的东西——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110120
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400110120,
					"content": "怎么了？奇怪的东西是指什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400110121,
					"content": "你们看海里！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110122
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400110122,
					"content": "有个奇怪的东西漂在上面哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110123
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400110123,
					"content": "细长的装置，应该是浮标。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110124
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400110124,
					"content": "可是，昨天在海上航行的时候，我们好像没有看到这个装置…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110125
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 400110125,
					"content": "一定是嘟嘟大魔王放的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110126
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400110126,
					"content": "一夜之间冒出来的奇怪装置，不简单哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400110127,
					"content": "他一直没来找我，是不承认我吗…还是说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110128
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400110128,
					"content": "他是不是在等我，要我去找他？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110129
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400110129,
					"content": "突然出现在海上的浮标，会有什么用意吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110130
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 400110130,
					"content": "靠近看看就知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110131
					]
				},
				{
					"id": 400110131,
					"content": "是啊，光在岸上猜测也解决不了问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400110132,
					"content": "可以吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110133
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 400110133,
					"content": "还是主动确认一下比较好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110134
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400110134,
					"content": "很难说海上究竟有什么在等着我们…以防万一，希望大家做好战斗的准备。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110135
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400110135,
					"content": "各自收拾妥当后，请到我这里集合，我们一起坐船过去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110136,
						400110137
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400110136,
					"content": "不愧是大家的琴团长！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110138
					]
				},
				{
					"id": 400110138,
					"content": "过、过奖了，这是我的职责所在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110139
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400110139,
					"content": "那么，准备工作就拜托各位了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "琴"
				},
				{
					"id": 400110137,
					"content": "即使穿着夏装也很可靠。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110138
					]
				},
				{
					"id": 400110108,
					"content": "琴穿得非常好看！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110109
					]
				}
			]
		},
		{
			"id": 4001102,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
