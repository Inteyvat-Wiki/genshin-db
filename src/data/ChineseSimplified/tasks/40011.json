					"nextDialogs": [
						400110725
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400110725,
					"content": "可莉，怎么了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110726
					],
					"speakerTitle": "芭芭拉"
				},
				{
