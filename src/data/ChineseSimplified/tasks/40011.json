					"speakerTitle": "可莉"
				},
				{
					"id": 400110605,
					"content": "「审判」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400110606,
					"content": "你可以「审判」可莉了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110607
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400110607,
					"content": "啊——！这孩子在说什么呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110608
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400110608,
					"content": "她根本不明白那句话的意思吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110609
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400110609,
					"content": "喂，大魔王——！你怎么不理我呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110610
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400110610,
					"content": "是不是可莉来得太慢，惹你生气了？那…对不起嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110611
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400110611,
					"content": "向对方道歉了？可莉这孩子，思维有点跳跃吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110612
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 400110612,
					"content": "大——魔——王——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110613
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400110613,
					"content": "看起来，对方没有要理睬可莉的意思呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110614
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 400110614,
					"content": "是人型的机械吧。没有反应，应该是已经损坏了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110615
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400110615,
					"content": "你认识那个吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110616
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 400110616,
					"content": "只是猜测。它跟海岛的整体气氛格格不入…看衣着，倒像是从稻妻漂流而来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110617
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400110617,
					"content": "稻妻？那不是很远的地方吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110618
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400110618,
					"content": "它也是异乡人吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110619
					]
				},
				{
					"id": 400110619,
					"content": "是的。这里是独立的海域，不跟任何国度接壤，对这片海洋而言，它也是异乡人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110620
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400110620,
					"content": "但以稻妻眼下的情况，又怎么会发生这种事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110621
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400110621,
					"content": "没反应的异乡人…好神奇，是有人把它带来这里吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110622
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400110622,
					"content": "呜哇——大魔王不动了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110623
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400110623,
					"content": "可莉…也许大魔王只是累了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110624
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400110624,
					"content": "对对，大魔王应该是睡着了吧？等你等得不耐烦，就呼——地睡过去了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110625
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400110625,
					"content": "嗯，我们陪可莉去别处玩，等大魔王睡醒再来找他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110626
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 400110626,
					"content": "…真的…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110627
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400110627,
					"content": "当然啦，你要相信我们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110628
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 400110628,
					"content": "唔…不对，可莉想到了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110629
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400110629,
					"content": "这个不是大魔王，真正的大魔王还在别的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110630
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400110630,
					"content": "欸？是、是吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110631
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400110631,
					"content": "可莉不会放弃，大魔王，等着吧，我们来找你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110632
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400110632,
					"content": "又跑掉了…小孩子的精神真好呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110633
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400110633,
					"content": "可莉，等等我们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芭芭拉"
				}
			]
		},
