			},
			"dialogs": [
				{
					"id": 752380201,
					"content": "#哼…看我下次怎么收拾{M#他}{F#她}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380202,
						752380203
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 752380202,
					"content": "（再这么坐一会儿吧。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380204
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 752380204,
					"content": "已经这么晚了？好吧，吉约丹小姐回去路上小心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 752380203,
					"content": "茶会时间该结束了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380204
					],
					"speakerTitle": "「木偶」"
				}
			]
		}
	]
