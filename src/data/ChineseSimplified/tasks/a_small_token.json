			"dialogs": [
				{
					"id": 752380101,
					"content": "茶的口味还满意吗？还是说我该准备些酒类饮料？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380102
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 752380102,
					"content": "不了，茶挺好。白天喝酒有些太罪恶了，那种事还是少干两次吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380103
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 752380103,
					"content": "倒是吉约丹小姐，怎么跑这么远到纳塔来？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380104
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 752380104,
					"content": "四处走走，看看过去的同伴而已。我也想感谢你在千灵节期间愿意接下那份工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380105
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 752380105,
					"content": "你也太客气了，就为了这跑一趟吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380106
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 752380106,
					"content": "另外，虽然你上次没提，但我知道曾经给你们增添过一些不愉快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380107
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 752380107,
					"content": "啊…你部下的那事是吧。和那个名叫伊涅芙的机器人有关的那次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380108
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 752380108,
					"content": "呵…这不正是生活奇妙的地方吗？曾经敌人的老板或许也会变为你的同伴，或是你的老板…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380109
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 752380109,
					"content": "希望你能收下这些。聊表心意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380110
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 752380110,
					"content": "这…这是…限定版，不对，珍藏版轻小说？！而且还是我喜欢的题材？你…你怎么会知道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380111
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 752380111,
					"content": "#我向{NICKNAME}询问你可能会喜欢的东西，并听取了{M#他}{F#她}的意见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380112
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 752380112,
					"content": "#{NICKNAME}…？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380113
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 752380113,
					"content": "（可恶…！这种又高兴又有些别扭的感觉是怎么回事？！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380114
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 752380114,
					"content": "#（虽然{M#他}{F#她}了解我喜欢什么自然是高兴啦，但能不能不要随便告诉别人，倒是来亲自送给我呀！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380115
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 752380115,
					"content": "还算中意吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380116
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 752380116,
					"content": "啊…谢谢谢谢。吉约丹小姐真的太客气了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380117
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 752380117,
					"content": "#喜欢的话，我下次也再给你带些。当然，到时候恐怕又得麻烦{NICKNAME}一起去选一选了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380118
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 752380118,
					"content": "一起？！你们是一起逛…逛书店选的吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380119
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 752380119,
					"content": "#嗯，{M#他}{F#她}很认真地为你挑选了这本。下次或许…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380120
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 752380120,
					"content": "不要再有下次了！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380121
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 752380121,
					"content": "啊…啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「木偶」"
				}
			]
		},
