			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"德鲁苏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735030401,
					"content": "这就是最后一个宝箱了，这次不用写谜语了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030402
					],
					"speakerTitle": "德鲁苏"
				},
				{
					"id": 735030402,
					"content": "不过，到底放什么比较好呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030403,
						735030406,
						735030409
					],
					"speakerTitle": "德鲁苏"
				},
				{
					"id": 735030403,
					"content": "够值钱的东西。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030404
					]
				},
				{
					"id": 735030404,
					"content": "有道理，这宝箱里东西的价值，至少要对得起解谜者一路的辛苦思辨啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030405
					],
					"speakerTitle": "德鲁苏"
				},
				{
					"id": 735030405,
					"content": "说到价值，那最直观的当然就是摩拉了，唔…我多放点摩拉好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030413
					],
					"speakerTitle": "德鲁苏"
				},
				{
					"id": 735030413,
					"content": "好了，这段「谜语」就算是布置完了，多谢你帮忙，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030414
					],
					"speakerTitle": "德鲁苏"
				},
				{
					"id": 735030414,
					"content": "这些东西给你，就当做是报酬吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030415
					],
					"speakerTitle": "德鲁苏"
				},
				{
					"id": 735030415,
					"content": "唉，我本来打算和你再深入讨论一下谜语的，但我还得回教令院处理一些事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030416
					],
					"speakerTitle": "德鲁苏"
				},
				{
					"id": 735030416,
					"content": "如果你以后在旅途中发现了新奇的谜语，或者被谜题难住了，一定要记得过来找我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030417
					],
					"speakerTitle": "德鲁苏"
				},
				{
					"id": 735030417,
					"content": "我们可以一起详细地讨论它们，然后…再把它们重新布置给冒险家们，哈哈哈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030418
					],
					"speakerTitle": "德鲁苏"
				},
				{
					"id": 735030418,
					"content": "那么我就先告辞了，旅行者，祝你接下来的旅途一路顺风。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030419
					],
					"speakerTitle": "德鲁苏"
				},
				{
					"id": 735030419,
					"content": "希望那个叫娜赞的盗宝团不要惹出什么大麻烦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "德鲁苏"
				},
				{
					"id": 735030406,
					"content": "有实用价值的东西。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030407
					]
				},
				{
					"id": 735030407,
					"content": "实用价值？呃…什么东西比较有实用价值？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030408
					],
					"speakerTitle": "德鲁苏"
				},
				{
					"id": 735030408,
					"content": "对了！我前几天刚从别人那里拿到了一份菜谱，就放在这宝箱里当做奖励吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030413
					],
					"speakerTitle": "德鲁苏"
				},
				{
					"id": 735030409,
					"content": "这段思辨的经历就是最好的宝物。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030410
					]
				},
				{
					"id": 735030410,
					"content": "哈哈哈哈哈，你说得没错！太对了！这段辛苦的思辨确实是无价的宝贵经历！和它相比，其他的东西几乎毫无价值。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030411
					],
					"speakerTitle": "德鲁苏"
				},
				{
					"id": 735030411,
					"content": "根本就不对！好好地放一点摩拉或者菜谱啊！实在不行放点蔬菜水果也可以，别什么都不放啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735030412,
					"content": "开个玩笑，开个玩笑，我肯定会放一些东西当做是奖励的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030413
					],
					"speakerTitle": "德鲁苏"
				}
			]
		},
