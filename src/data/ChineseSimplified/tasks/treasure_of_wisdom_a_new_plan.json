			"trigger": {
				"objectNames": [
					"德鲁苏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735030101,
					"content": "唔，这个地方不错…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030102
					],
					"speakerTitle": "德鲁苏"
				},
				{
					"id": 735030102,
					"content": "你又在研究谜语吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030103
					]
				},
				{
					"id": 735030103,
					"content": "旅行者！你来得正好，我正准备设计一段全新的连续谜题呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030104
					],
					"speakerTitle": "德鲁苏"
				},
				{
					"id": 735030104,
					"content": "这里的地形有点复杂。你看，港口的一侧有一根「圣树」的巨大根系入水。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030105
					],
					"speakerTitle": "德鲁苏"
				},
				{
					"id": 735030105,
					"content": "另一侧则是一片巨大的荷叶，和一堆待出港的船只。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030106
					],
					"speakerTitle": "德鲁苏"
				},
				{
					"id": 735030106,
					"content": "旅行者，你觉得这段谜语以哪一边的景物为主题最好？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030107,
						735030110,
						735030113
					],
					"speakerTitle": "德鲁苏"
				},
				{
					"id": 735030107,
					"content": "还是从根系入手吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030108
					]
				},
				{
					"id": 735030108,
					"content": "是吗？「圣树」的巨大根系确实很显眼，作为谜语的「切入点」也很容易被感知到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030109
					],
					"speakerTitle": "德鲁苏"
				},
				{
					"id": 735030109,
					"content": "好！那我就以根系为主题写一道谜语。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030115,
						735030116
					],
					"speakerTitle": "德鲁苏"
				},
				{
					"id": 735030115,
					"content": "嘿嘿嘿，我来写一段。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030115,
						735030116
					]
				},
				{
					"id": 735030116,
					"content": "嘿嘿嘿，交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030117
					]
				},
				{
					"id": 735030117,
					"content": "我说，你怎么笑得这么开心啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735030118,
					"content": "写好了，给你看看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030119
					]
				},
				{
					"id": 735030119,
					"content": "「有智归海处，宝藏侧帆间。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030120
					],
					"speakerTitle": "德鲁苏"
				},
				{
					"id": 735030120,
					"content": "读起来真不错！而且这道谜语也很容易让人联想到「港口」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030121
					],
					"speakerTitle": "德鲁苏"
				},
				{
					"id": 735030121,
					"content": "和「有智归海」相搭配，也不难解答出这个地点和教令院或者须弥城有关…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030122
					],
					"speakerTitle": "德鲁苏"
				},
				{
					"id": 735030122,
					"content": "没想到你还有这方面的才能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030123
					],
					"speakerTitle": "德鲁苏"
				},
				{
					"id": 735030123,
					"content": "稍等一下，我把这道谜语给贴在容易被发现的地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030124
					],
					"speakerTitle": "德鲁苏"
				},
				{
					"id": 735030124,
					"content": "欸？就贴在这附近？可谜语所说的位置也不远啊？说不定马上就会被发现的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735030125,
					"content": "哈哈哈，我这也是在给解谜的人划定解谜范围啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030126
					],
					"speakerTitle": "德鲁苏"
				},
				{
					"id": 735030126,
					"content": "要是不这么做，那解谜的范围可就太大了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030127
					],
					"speakerTitle": "德鲁苏"
				},
				{
					"id": 735030127,
					"content": "德鲁苏开始布置起了谜语…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						735030128
					]
				},
				{
					"id": 735030128,
					"content": "好了，这里的谜语就这样吧，我们去下一个地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030129
					],
					"speakerTitle": "德鲁苏"
				},
				{
					"id": 735030129,
					"content": "欸？还有下一个地方啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735030110,
					"content": "莲叶和船只很有意思。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030111
					]
				},
				{
					"id": 735030111,
					"content": "确实…把这两者联系起来的话，也许有着别样的趣味性。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030112
					],
					"speakerTitle": "德鲁苏"
				},
				{
					"id": 735030112,
					"content": "没问题，我就以这个主题来写一道谜语好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030115,
						735030116
					],
					"speakerTitle": "德鲁苏"
				},
				{
					"id": 735030113,
					"content": "这些都太简单了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030114
					]
				},
				{
					"id": 735030114,
					"content": "太简单了？那你有什么想法吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030115,
						735030116
					],
					"speakerTitle": "德鲁苏"
				}
			]
		},
		{
			"id": 7350302,
			"completionStepIds": [
				7350302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7350302",
							"2"
						],
						"stepId": 7350302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"德鲁苏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735030201,
					"content": "好！就在这里布置第二个谜题吧，只要解开这个谜题，就能找到最终的宝箱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030202
					],
					"speakerTitle": "德鲁苏"
				},
				{
					"id": 735030202,
					"content": "我准备把最终的宝藏设置在…那里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030203
					],
					"speakerTitle": "德鲁苏"
				},
				{
					"id": 735030203,
					"content": "欸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735030204,
					"content": "呃…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030205
					]
				},
				{
					"id": 735030205,
					"content": "这不就是一个普普通通的小山坡，旁边有个普普通通的小瀑布吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735030206,
					"content": "没错！但它马上就会因为我们的谜语而不普通了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030207
					],
					"speakerTitle": "德鲁苏"
				},
				{
					"id": 735030207,
					"content": "好了，旅行者，你对这一道谜语有什么建议呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030208,
						735030211,
						735030214
					],
					"speakerTitle": "德鲁苏"
				},
				{
					"id": 735030208,
					"content": "别折腾了，直接点吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030209
					]
				},
				{
					"id": 735030209,
					"content": "欸？是这样吗？唔…解谜的人翻山越岭到这里来，确实会感到疲惫啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030210
					],
					"speakerTitle": "德鲁苏"
				},
				{
					"id": 735030210,
					"content": "行，那就简单点吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030219,
						735030220
					],
					"speakerTitle": "德鲁苏"
				},
				{
					"id": 735030219,
					"content": "不能说是特别学过…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030219,
						735030220
					]
				},
				{
					"id": 735030220,
					"content": "只能说是熟能生巧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030221
					]
				},
				{
					"id": 735030221,
					"content": "原来如此，不愧是旅行者啊，真是博闻广识…好，我这就把你写的谜语给布置下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030222
					],
					"speakerTitle": "德鲁苏"
				},
				{
					"id": 735030222,
					"content": "德鲁苏开始布置起了谜语…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						735030223
					]
				},
				{
					"id": 735030223,
					"content": "好了！这个小告示牌应该够显眼了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030224
					],
					"speakerTitle": "德鲁苏"
				},
				{
					"id": 735030224,
					"content": "那我们现在就去布置最后的宝箱吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "德鲁苏"
				},
				{
					"id": 735030211,
					"content": "用瀑布为主题吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030212
					]
				},
				{
					"id": 735030212,
					"content": "唔…瀑布确实是一个很明确的主题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030213
					],
					"speakerTitle": "德鲁苏"
				},
				{
					"id": 735030213,
					"content": "没问题，就以它为主题好了。而且这最后一道谜题的难度…就稍微下调一点吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030219,
						735030220
					],
					"speakerTitle": "德鲁苏"
				},
				{
					"id": 735030214,
					"content": "嘿嘿嘿，我来写一段。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030215
					]
				},
				{
					"id": 735030215,
					"content": "喂！你笑得越来越开心了啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735030216,
					"content": "写好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030217
					]
				},
				{
					"id": 735030217,
					"content": "「青伞怀宝望珠帘。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030218
					],
					"speakerTitle": "德鲁苏"
				},
				{
					"id": 735030218,
					"content": "呃…这谜语，读起来还真是特别…你在哪里专门学过这方面的学问吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030219,
						735030220
					],
					"speakerTitle": "德鲁苏"
				}
			]
		},
