			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「小王子」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706660201,
					"content": "喵！「真是了不起，恭喜你突破了牌手等级的试炼，现在已经是高级牌手了！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660202
					],
					"speakerTitle": "「小王子」"
				},
				{
					"id": 706660202,
					"content": "喵？「只是完成一次试炼就成为了高级牌手？哎呀，因为世上大部分人把打牌视为玩乐，所以不太认真对待…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660203
					],
					"speakerTitle": "「小王子」"
				},
				{
					"id": 706660203,
					"content": "「也就是说，认真玩乐的人反倒才是少数，但是，就算是玩乐，也有认真投入的价值。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660204
					],
					"speakerTitle": "「小王子」"
				},
				{
					"id": 706660204,
					"content": "喵！「啊，对了，现在你获得了我的认可，也可以挑战酒馆里其他的家伙设下的牌局，嗯…他们应该会喜欢你的。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660205
					],
					"speakerTitle": "「小王子」"
				},
				{
					"id": 706660205,
					"content": "其他的家伙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706660206
					]
				},
				{
					"id": 706660206,
					"content": "喵。「嗯，当然和我一样，是酒馆里的猫…可别小看他们。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660207
					],
					"speakerTitle": "「小王子」"
				},
				{
					"id": 706660207,
					"content": "喵~「到时候就让恕筠为他们执牌吧，好了，按照惯例，得说一句那个！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660208
					],
					"speakerTitle": "「小王子」"
				},
				{
					"id": 706660208,
					"content": "#「{NICKNAME}，希望你能感受到『七圣召唤』的乐趣！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「小王子」"
				}
			]
		},
