					}
				]
			},
			"dialogs": [
				{
					"id": 790520201,
					"content": "如果轨道的倾斜度再大一点的话，说不定能带来更刺激的体验，空中旋转的角度…咳咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790520202
					],
					"speakerTitle": "哈多"
				},
				{
					"id": 790520202,
					"content": "啊，哈多！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790520203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790520203,
					"content": "是你们啊…咳咳，最近在琉形蜃境中度过的日子还愉快吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790520204,
						790520205
					],
					"speakerTitle": "哈多"
				},
				{
					"id": 790520204,
					"content": "还挺开心的！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790520206
					]
				},
				{
					"id": 790520206,
					"content": "那就好那就好，咳咳…看到你们玩得开心，那就放心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790520208
					],
					"speakerTitle": "哈多"
				},
				{
					"id": 790520208,
					"content": "啊，说起来…咳咳咳，要不要来试试实验用的小型飞车轨道？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790520209
					],
					"speakerTitle": "哈多"
				},
				{
					"id": 790520209,
					"content": "实验用的？难道飞车也得做实验吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790520210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790520210,
					"content": "对啦，看到我身后没有，这里就是「呼呼飞车」的实验场地，嘿嘿，还记得「激流轨道」吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790520211
					],
					"speakerTitle": "哈多"
				},
				{
					"id": 790520211,
					"content": "那条轨道的线路就是从这里诞生的…咳咳，就算有先成图和聚流映灯，轨道的设计如果不符合要求，也是没法正确成型的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790520212
					],
					"speakerTitle": "哈多"
				},
				{
					"id": 790520212,
					"content": "所以预先进行设计和实验，收集反馈进行修改很重要…只、只不过这里的多多少少会有些，按杰洛尼的说法：过度刺激。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790520213
					],
					"speakerTitle": "哈多"
				},
				{
					"id": 790520213,
					"content": "为了梯度测试，这个小型试验场里有三条轨道，咳咳…稍微比外面的「呼呼飞车」要快一些…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790520214
					],
					"speakerTitle": "哈多"
				},
				{
					"id": 790520214,
					"content": "分别是，咳咳…「还行轨道」、「有点晕轨道」和「太、太快了轨道」。啊，顺便这些轨道的名字由费迪南德倾情赞助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790520215
					],
					"speakerTitle": "哈多"
				},
				{
					"id": 790520215,
					"content": "呜哇，费迪南德他还好吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790520216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790520216,
					"content": "他好得很，只是需要一些，呃，新鲜空气…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790520217
					],
					"speakerTitle": "哈多"
				},
				{
					"id": 790520217,
					"content": "说回正题，鉴于每条轨道都比…咳咳，都比外面那些「呼呼飞车」的轨道要快上许多，所以推荐从「还行轨道」开始。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790520218
					],
					"speakerTitle": "哈多"
				},
				{
					"id": 790520218,
					"content": "怎么样，有勇气挑战一下吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790520219,
						790520220
					],
					"speakerTitle": "哈多"
				},
				{
					"id": 790520219,
					"content": "立刻开始吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790520221
					]
				},
				{
					"id": 790520221,
					"content": "嗯，很有气势，去找负责三条轨道的「水形幻灵」吧，它们肯定很乐意为您开启轨道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "哈多"
				},
				{
					"id": 790520220,
					"content": "不，我暂时有别的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790520222
					]
				},
				{
					"id": 790520222,
					"content": "那不急，咳咳…负责三条轨道的「水形幻灵」就在试验场地的旁边，如果你什么时候有空，过来试试看就好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "哈多"
				},
				{
					"id": 790520205,
					"content": "你的咳嗽好点没？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790520207
					]
				},
				{
					"id": 790520207,
					"content": "咳咳…大概是好不了了，不过没关系，区区咳嗽而已，阻挡不了我设计轨道的热情…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790520208
					],
					"speakerTitle": "哈多"
				}
			]
		}
	]
}