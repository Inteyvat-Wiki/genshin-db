				"points": []
			},
			"dialogs": [
				{
					"id": 4880001,
					"content": "丽莎小姐，难道是来送税收报表的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880002
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4880002,
					"content": "哦呀，小可爱。你说的没错。我听说了琴病倒的事，文书类的工作我就先代劳了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880003
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 4880003,
					"content": "这样呀，那看来这边已经没我们什么事了，那我们就先走啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880004
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4880004,
					"content": "啊，稍等一下，其实查尔斯先生这边…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880005
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 4880005,
					"content": "让我来说吧，丽莎小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880006
					],
					"speakerTitle": "查尔斯"
				},
				{
					"id": 4880006,
					"content": "就在刚才，我接到了一批订单。可店里的库存不够了，酒庄的进货又迟迟未到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880007
					],
					"speakerTitle": "查尔斯"
				},
				{
					"id": 4880007,
					"content": "方便的话，想麻烦你们<color=#00E1FFFF>去查看一下货物情况</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880008
					],
					"speakerTitle": "查尔斯"
				},
				{
					"id": 4880008,
					"content": "欸，是这么紧急的订单吗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880009
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4880009,
					"content": "没办法，毕竟是临时接到的，强人所难的订单——就，在，刚，才。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880010
					],
					"speakerTitle": "查尔斯"
				},
				{
					"id": 4880010,
					"content": "嗯~嗯~就是这样，如查尔斯先生所说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880011
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 4880011,
					"content": "好吧，我去看看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4880012
					]
				},
				{
					"id": 4880012,
					"content": "可以，但下次要记得请客。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4880013
					]
				},
				{
					"id": 4880013,
					"content": "呵呵，下次等迪卢克老板在的时候，他肯定会请你喝的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880014
					],
					"speakerTitle": "查尔斯"
				},
				{
					"id": 4880014,
					"content": "嗯，这还差不多！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 48801,
			"completionStepIds": [
				48801
