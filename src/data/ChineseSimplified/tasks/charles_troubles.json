				"points": []
			},
			"dialogs": [
				{
					"id": 4880101,
					"content": "原来货物在这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4880102,
					"content": "是来帮忙的吗？可算等到你们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880103
					],
					"speakerTitle": "恩内斯特"
				},
				{
					"id": 4880103,
					"content": "我在这酒庄干了这么久，头一次被丘丘人打劫…哎哟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880104
					],
					"speakerTitle": "恩内斯特"
				},
				{
					"id": 4880104,
					"content": "你们再来晚些，我可真不知道怎么办了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880105
					],
					"speakerTitle": "恩内斯特"
				},
				{
					"id": 4880105,
					"content": "#放心吧，丘丘人而已，{NICKNAME}很能打的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4880106,
					"content": "能打就好，那这个<color=#00E1FFFF>货运热气球</color>就交给你们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880107
					],
					"speakerTitle": "恩内斯特"
				},
				{
					"id": 4880107,
					"content": "可别光顾着收拾那些丘丘人，一定记得<color=#00E1FFFF>优先确保货物安全</color>，不然你我可都赔不起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880108
					],
					"speakerTitle": "恩内斯特"
				},
				{
					"id": 4880108,
					"content": "那就先这样了，我到前面等你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880109
					],
					"speakerTitle": "恩内斯特"
				}
			]
		},
