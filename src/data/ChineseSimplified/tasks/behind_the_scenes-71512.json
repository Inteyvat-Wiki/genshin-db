			"completionStepIds": [
				7151201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7151201",
							"2"
						],
						"stepId": 7151201,
						"stateName": "QUEST_STATE_UNFINISHED"
