			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"诏勤"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715120101,
					"content": "真是…这个地区清理过了吗？呃…应该清理过了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120102
					],
					"speakerTitle": "诏勤"
				},
				{
					"id": 715120102,
					"content": "哎哟，真是头疼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120103
					],
					"speakerTitle": "诏勤"
				},
				{
					"id": 715120103,
					"content": "呃…你是…旅行者！抱歉抱歉，我忙昏头了，没看见你来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120104
					],
					"speakerTitle": "诏勤"
				},
				{
					"id": 715120104,
					"content": "你这是在忙什么呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715120105
					]
				},
				{
					"id": 715120105,
					"content": "咳，是这样，今年海灯节，我们璃月港冒险家协会将在总务司的调度下，做一些协助工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120106
					],
					"speakerTitle": "诏勤"
				},
				{
					"id": 715120106,
					"content": "千岩军主要负责城内和一些重点区域的巡逻，而咱们嘛，就负责去野外清扫一些流窜的魔物…还有驱赶那些没事找事的贼匪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120107
					],
					"speakerTitle": "诏勤"
				},
				{
					"id": 715120107,
					"content": "对了…说起来，你也是在协会里注册过的冒险家啊，我可是听说过不少你的冒险事迹啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120108
					],
					"speakerTitle": "诏勤"
				},
				{
					"id": 715120108,
					"content": "如果愿意的话，你也来帮我们一把，怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120109,
						715120110
					],
					"speakerTitle": "诏勤"
				},
				{
					"id": 715120109,
					"content": "大过节的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715120111
					]
				},
				{
					"id": 715120111,
					"content": "咳，这个…因为是在节日期间协助总务司勤务，所以总务司也拨给了我们一批特别款项。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120112
					],
					"speakerTitle": "诏勤"
				},
				{
					"id": 715120112,
					"content": "愿意接受此类委托的冒险家，在完成委托后可以拿到更多的报酬…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120113,
						715120115
					],
					"speakerTitle": "诏勤"
				},
				{
					"id": 715120113,
					"content": "具体…有多少？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715120114
					]
				},
				{
					"id": 715120114,
					"content": "相信我，绝对亏待不了你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120123
					],
					"speakerTitle": "诏勤"
				},
				{
					"id": 715120123,
					"content": "那…我得先看看有多少活要干…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715120116
					]
				},
				{
					"id": 715120116,
					"content": "哈哈哈！好！我就知道你不会袖手旁观的，我先把协会确定下来的地点给你标记下来，还有这个小型烟花筒你拿好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120117
					],
					"speakerTitle": "诏勤"
				},
				{
					"id": 715120117,
					"content": "如果你真的愿意接受委托的话…清扫完一片区域后，记得用这个烟花筒发射一枚烟花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120118
					],
					"speakerTitle": "诏勤"
				},
				{
					"id": 715120118,
					"content": "你发射烟花之后，我们派出去的记录员就会把那块区域标注为「已扫除」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120119
					],
					"speakerTitle": "诏勤"
				},
				{
					"id": 715120119,
					"content": "然后，我们会根据整个地块内各个区域的扫除情况来实时调整计划。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120120
					],
					"speakerTitle": "诏勤"
				},
				{
					"id": 715120120,
					"content": "还挺有计划的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715120121
					]
				},
				{
					"id": 715120121,
					"content": "唉…这可是海灯节，可千万不能出问题啊。咱们啊…人人都绷紧着弦呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120122
					],
					"speakerTitle": "诏勤"
				},
				{
					"id": 715120122,
					"content": "先不说这些了，我得再去看看情况。等会还要去给岚姐报告呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "诏勤"
				},
				{
					"id": 715120115,
					"content": "你…你先给我看看有多少活要干…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715120116
					]
				},
				{
					"id": 715120110,
					"content": "海灯节呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715120111
					]
				}
			]
		}
	]
}