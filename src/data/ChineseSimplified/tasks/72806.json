			"trigger": {
				"objectNames": [
					"常九爷"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728060201,
					"content": "咦？旅行者，你今天过来是有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060202
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 728060202,
					"content": "关于「八重堂」的信件和礼物…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060203
					]
				},
				{
					"id": 728060203,
					"content": "「八重堂」的信？不会又是来让我改笔名的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060204
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 728060204,
					"content": "我都说了，我署原名就好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060205
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 728060205,
					"content": "算了，算了，我还是看看吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060206
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 728060206,
					"content": "小说比赛…评委，这…我也许没空去啊，但还是谢谢他们的好意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060207
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 728060207,
					"content": "咦？这后面怎么还有这么多，这是…创作建议…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060208
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 728060208,
					"content": "呃，我、我会好好看看的，谢谢你，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "常九爷"
				}
			]
		},
		{
			"id": 7280604,
			"completionStepIds": [
				7280604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280604",
							"2"
						],
						"stepId": 7280604,
						"stateName": "QUEST_STATE_UNFINISHED"
