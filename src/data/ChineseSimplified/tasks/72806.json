				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"行秋"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728060401,
					"content": "嗯…这里写得倒是不错，文笔颇为新颖…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060402
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 728060402,
					"content": "行秋。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060403
					]
				},
				{
					"id": 728060403,
					"content": "原来如此，原来如此…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060404
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 728060404,
					"content": "行秋！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060405
					]
				},
				{
					"id": 728060405,
					"content": "#欸？是你啊，{NICKNAME}，好久不见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060406
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 728060406,
					"content": "听你刚才打招呼的语气，你还挺精神的嘛，不错，不错…找我有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060407
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 728060407,
					"content": "其实，我们是想向你打听一个人，你读得书多，说不定会知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 728060408,
					"content": "一个人？你们莫不是要找哪位作者？唔…但说无妨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060409
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 728060409,
					"content": "关于「枕玉」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060410
					]
				},
				{
					"id": 728060410,
					"content": "「枕玉」？你、你是从哪听到这名字的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060411
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 728060411,
					"content": "这本《沉秋拾剑录》上写着呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060412
					]
				},
				{
					"id": 728060412,
					"content": "我们正在找这位「枕玉」，稻妻那边的「八重堂」拜托我们把一封信带给这位作者呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 728060413,
					"content": "你知道这位「枕玉」到底是谁吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 728060414,
					"content": "嗯…这位「枕玉」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060415
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 728060415,
					"content": "说来惭愧，其实正是…我的笔名。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060416
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 728060416,
					"content": "欸？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060417
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 728060417,
					"content": "之前没听你说过。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060418
					]
				},
				{
					"id": 728060418,
					"content": "这件事…这件事也没什么好提起的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060419
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 728060419,
					"content": "当初在璃月时，负责的编辑说我写的这本书「设定过于离谱，剧情却意外地俗套，没人会喜欢」，然后就把我的稿给拒了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060420
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 728060420,
					"content": "我听了之后…咳，不太服气，就自己印了几本，偷偷放在「万文集舍」里，看有没有人喜欢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060421
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 728060421,
					"content": "结果，取阅者依然寥寥，我就没再把心放在这上面了。没想到，这本书在稻妻居然能受到如此好评。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060422
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 728060422,
					"content": "但无论如何，我写的这书有人愿意看，自然是好事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060423
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 728060423,
					"content": "我会好好看看这封信的，谢谢你旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "行秋"
				}
			]
		},
		{
			"id": 7280605,
			"completionStepIds": [
