			"trigger": {
				"objectNames": [
					"荒谷"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728060501,
					"content": "哎，您终于回来了！怎么样？有见到两位老师吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060502
					],
					"speakerTitle": "荒谷"
				},
				{
					"id": 728060502,
					"content": "信都送到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060503
					]
				},
				{
					"id": 728060503,
					"content": "太好了！谢谢你旅行者，那两位老师怎么说？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060504
					],
					"speakerTitle": "荒谷"
				},
				{
					"id": 728060504,
					"content": "他们说会好好看信的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060505
					]
				},
				{
					"id": 728060505,
					"content": "那就好，那就好。唉…可惜这两位老师都远在璃月…平日里也没办法去拜访。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060506
					],
					"speakerTitle": "荒谷"
				},
				{
					"id": 728060506,
					"content": "特别是「枕玉」老师的那本《沉秋拾剑录》还不是他本人投的稿，是被一位客商带回的稻妻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060507
					],
					"speakerTitle": "荒谷"
				},
				{
					"id": 728060507,
					"content": "然后，我们「八重堂」中的一位编辑读到了这本书，感觉到了这本书的价值，就准备亲自去璃月一趟，向「枕玉」老师正式约稿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060508
					],
					"speakerTitle": "荒谷"
				},
				{
					"id": 728060508,
					"content": "但没想到…稻妻的局势骤变，我们没法派人去璃月，寄出去的信也始终杳无回音。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060509
					],
					"speakerTitle": "荒谷"
				},
				{
					"id": 728060509,
					"content": "我们就只能自己先印发了这本书，把稿酬都给「枕玉」老师记下，等取得联系之后，再一起付给他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060510
					],
					"speakerTitle": "荒谷"
				},
				{
					"id": 728060510,
					"content": "不过，都这么长时间了，《沉秋拾剑录》的销量始终居高不下，稿酬也越堆越多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060511
					],
					"speakerTitle": "荒谷"
				},
				{
					"id": 728060511,
					"content": "唉，「枕玉」老师可千万要出席这次比赛啊，这稿酬…这稿酬可不能再堆下去了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "荒谷"
				}
			]
		},
