				"points": []
			},
			"dialogs": [
				{
					"id": 4680201,
					"content": "有什么可以帮忙的吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4680202
					]
				},
				{
					"id": 4680202,
					"content": "你是…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680203
					],
					"speakerTitle": "特纳"
				},
				{
					"id": 4680203,
					"content": "…是旅行者啊，可真是个热心肠的好人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680204
					],
					"speakerTitle": "特纳"
				},
				{
					"id": 4680204,
					"content": "现在正是葡萄生长的关键时节，可不知道哪儿来的野猪，成群结队，盯上这块地盘啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680205
					],
					"speakerTitle": "特纳"
				},
				{
					"id": 4680205,
					"content": "我一个人赶又赶不走，儿子现在又不在身边，只能眼睁睁看着它们在地里横冲直撞…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680206
					],
					"speakerTitle": "特纳"
				},
				{
					"id": 4680206,
					"content": "你要是能帮忙给这些野猪一点儿教训的话，我特纳一定会好好答谢你的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "特纳"
				}
			]
		},
		{
			"id": 46803,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
