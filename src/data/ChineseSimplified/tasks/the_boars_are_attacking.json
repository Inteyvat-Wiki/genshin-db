			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"特纳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4680401,
					"content": "你好，客人。我儿子有没有从你那儿带来什么口信儿？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680601,
						4680701,
						4680801
					],
					"speakerTitle": "特纳"
				},
				{
					"id": 4680601,
					"content": "你是？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4680602
					]
				},
				{
					"id": 4680602,
					"content": "我啊？酒庄里的伙计们都叫我老特纳，是这晨曦酒庄的农夫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680603
					],
					"speakerTitle": "特纳"
				},
				{
					"id": 4680603,
					"content": "我们家祖祖辈辈都在耕这块地，如果你在这儿尝到过什么好葡萄酒，我敢说十有八九是这地里的葡萄酿的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680604
					],
					"speakerTitle": "特纳"
				},
				{
					"id": 4680604,
					"content": "所以这酒庄历代的大老板，总是待我们家不薄，少不了吃的穿的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680605
					],
					"speakerTitle": "特纳"
				},
				{
					"id": 4680605,
					"content": "可想到子子孙孙也都要这么种一辈子田，好像也不是什么好事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680601,
						4680701,
						4680801
					],
					"speakerTitle": "特纳"
				},
				{
					"id": 4680701,
					"content": "你的儿子？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4680702
					]
				},
				{
					"id": 4680702,
					"content": "盖伊！他叫盖伊，我的宝贝儿子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680703
					],
					"speakerTitle": "特纳"
				},
				{
					"id": 4680703,
					"content": "什么？你没听说过这名字？哈哈，没关系，你迟早会知道他的，全蒙德都会知道他的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680704
					],
					"speakerTitle": "特纳"
				},
				{
					"id": 4680704,
					"content": "他会成为全蒙德最优秀的西风骑士，他就是这么跟我说的，我当然相信自己的儿子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680705
					],
					"speakerTitle": "特纳"
				},
				{
					"id": 4680705,
					"content": "唉，想想他小时候，为了不让他也像我这样种一辈子田，我可把全部心血都花在他身上啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680706
					],
					"speakerTitle": "特纳"
				},
				{
					"id": 4680706,
					"content": "不过这小子果然很争气，十六岁就当上了见习骑士，我们家就要靠他翻身了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680601,
						4680701,
						4680801
					],
					"speakerTitle": "特纳"
				},
				{
					"id": 4680801,
					"content": "再见",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4680802
					]
				},
				{
					"id": 4680802,
					"content": "再见，如果见到我儿子盖伊，帮我跟他说，让他有空回来看看~！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "特纳"
				}
			]
		},
