			"dialogs": [
				{
					"id": 4680301,
					"content": "我还有事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4680302
					]
				},
				{
					"id": 4680302,
					"content": "这样啊，那我只能等儿子休假回来，再教训这些坏东西了",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "特纳"
				}
			]
		},
		{
			"id": 46804,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
