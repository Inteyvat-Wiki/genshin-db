					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790470439
					]
				},
				{
					"id": 790470439,
					"content": "嗯！希望不久以后，我们就可以遇见神奇的黛依阿！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790470438,
					"content": "这个项目的财务情况怎么样…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790470439
					]
				},
