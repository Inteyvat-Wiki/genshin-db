			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790470101,
					"content": "机关设备检查完成，「风之微粒」已部署到位…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470102
					],
					"speakerTitle": "乐园告示喇叭"
				},
				{
					"id": 790470102,
					"content": "喂喂？应该部署到位了吧？那些异常的风之微粒…都搞定了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470103
					],
					"speakerTitle": "乐园告示喇叭"
				},
				{
					"id": 790470103,
					"content": "咳！总之…「黛依阿的三日遐想」之「天空高城救守记」，即将开幕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470104
					],
					"speakerTitle": "乐园告示喇叭"
				},
				{
					"id": 790470104,
					"content": "故事发生在偏远的山区，这里的居民时常蒙受洪水和风暴的侵害，苦不堪言…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470105
					],
					"speakerTitle": "来自喇叭的旁白"
				},
				{
					"id": 790470105,
					"content": "为了及时对灾害作出预警，一群富有担当的勇士站了出来，在高耸入云的山崖上搭建了观察哨…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470106
					],
					"speakerTitle": "来自喇叭的旁白"
				},
				{
					"id": 790470106,
					"content": "时光流转，居住在高崖上的人们演化成了一支独特的部族——「高崖守望者」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470107
					],
					"speakerTitle": "来自喇叭的旁白"
				},
				{
					"id": 790470107,
					"content": "来自喇叭的旁白详细讲述着故事的背景—— \\n碍于物资运输的不便，守望者们的生活条件过于艰苦，甚至在最近失去了最后一座完好的房屋。\\n于是，守望者的长老找到了专攻建筑的「奇迹建筑师」，委托奇迹建筑师建造了一座悬浮在空中的小镇…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						790470108
					]
				},
				{
					"id": 790470108,
					"content": "奇迹建筑师为牢固的岩石地基构筑了绝妙的承重结构，在这之上搭建好所有的房屋。\\n随后，他在地基内部安装了上万个专门设计的货运热气球，并向其中注入「风之微粒」。\\n气球获得了无与伦比的升力，将整座小镇直接托起，悬浮至山顶。\\n奇迹建筑师根据计算好的高度，用锚索将小镇牢牢固定…\\n如此一来，守望者们便有了安定、温暖的住处…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						790470109
					]
				},
				{
					"id": 790470109,
					"content": "但随着时间流逝，货运热气球似乎遭遇了某些意外…\\n守望者一族发现，小镇的高度正在下降，似乎再过不久就会坠落至山顶，摔个粉碎…\\n巨大的危险正在降临，小镇损失高度的同时，小型地震般的颤动频频来袭，每位守望者都惶恐不安…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						790470110
					]
				},
				{
					"id": 790470110,
					"content": "呜啊，这个故事的开头居然这么郑重！一座浮在天空中的小镇…要坠落了？一听就是超大的危机！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470111,
						790470112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790470111,
					"content": "那我们也要认真一点了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790470113
					]
				},
				{
					"id": 790470113,
					"content": "嗯，好像还有另一个喇叭，那边才是话剧开始的地方，我们继续过去听听看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790470112,
					"content": "仔细了解故事的脉络…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790470113
					]
				}
			]
		},
		{
			"id": 7904702,
			"completionStepIds": [
				7904702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7904702",
							"2"
						],
						"stepId": 7904702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790470201,
					"content": "守望者的长老与奇迹建筑师见面后，详尽地介绍了空中小镇面临的危机…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470202
					],
					"speakerTitle": "来自喇叭的旁白"
				},
				{
					"id": 790470202,
					"content": "奇迹建筑师，如您所见，小镇的高度每天都在下降，我们都不想失去这座温暖、可靠的家园，但又束手无策…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470203
					],
					"speakerTitle": "守望者的长老"
				},
				{
					"id": 790470203,
					"content": "而且，最近小镇时常发生强烈的震动， 不妙的传闻正在散播，大家慢慢变得恐慌了起来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470204
					],
					"speakerTitle": "守望者的长老"
				},
				{
					"id": 790470204,
					"content": "要摔死啦，要摔死啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470205
					],
					"speakerTitle": "不太礼貌的学舌鸟"
				},
				{
					"id": 790470205,
					"content": "可敬的长老，我理解你们很心急，也听说了一些质疑工程质量的流言…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470206
					],
					"speakerTitle": "奇迹建筑师"
				},
				{
					"id": 790470206,
					"content": "但不必担心，我再次回到这里，就是为了将这次的危机彻底解决，消除你们的恐慌和疑虑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470207
					],
					"speakerTitle": "奇迹建筑师"
				},
				{
					"id": 790470207,
					"content": "刚才我绕着小镇转了一圈，看了看之前预留在地基里的监测装置，发现问题出在个别升力气球…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470208
					],
					"speakerTitle": "奇迹建筑师"
				},
				{
					"id": 790470208,
					"content": "一些升力气球中的风之微粒总量有所减少，似乎遭到了恶意破坏…所以，只需要将它们修好，就能防止小镇坠毁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470209
					],
					"speakerTitle": "奇迹建筑师"
				},
				{
					"id": 790470209,
					"content": "不过，为了让小镇回到原有的高度，还要提升一部分气球的升力，并且安装更多固定锚索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470210
					],
					"speakerTitle": "奇迹建筑师"
				},
				{
					"id": 790470210,
					"content": "这个嘛…得加钱…人为破坏一般是不保修的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470211
					],
					"speakerTitle": "奇迹建筑师"
				},
				{
					"id": 790470211,
					"content": "没问题，预算增加到当前报价的五倍，怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470212
					],
					"speakerTitle": "守望者的长老"
				},
				{
					"id": 790470212,
					"content": "五倍预算！五倍预算！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470213
					],
					"speakerTitle": "不太礼貌的学舌鸟"
				},
				{
					"id": 790470213,
					"content": "啊呀呀，您能同意加钱可真是太好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470214
					],
					"speakerTitle": "奇迹建筑师"
				},
				{
					"id": 790470214,
					"content": "慢着，五倍？这未免有点夸张了！最早建造这座小镇时，你给我的预算就比其他甲方多好几倍了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470215
					],
					"speakerTitle": "奇迹建筑师"
				},
				{
					"id": 790470215,
					"content": "上次忘了告诉你，以前曾有位贪心的工匠，看我们资金充裕，报价很夸张，是均价的二十来倍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470216
					],
					"speakerTitle": "守望者的长老"
				},
				{
					"id": 790470216,
					"content": "还好，我们好好调查了一番，才没上当受骗，现在我们对施工的费用也算是知道个大概了。而你的报价一直低于平均线很多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470217
					],
					"speakerTitle": "守望者的长老"
				},
				{
					"id": 790470217,
					"content": "原来你们这么阔绰吗？还真是…财不外露啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470218
					],
					"speakerTitle": "奇迹建筑师"
				},
				{
					"id": 790470218,
					"content": "我们吃苦，我们让大家发财！大家心里有数，大家总是给我们送钱！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470219
					],
					"speakerTitle": "不太礼貌的学舌鸟"
				},
				{
					"id": 790470219,
					"content": "正是如此，附近的村民们做了大生意，经常给我们大笔大笔捐赠财物。不过，我族生活勤俭，就把这些钱财积攒了下来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470220
					],
					"speakerTitle": "守望者的长老"
				},
				{
					"id": 790470220,
					"content": "天下居然还有这么民风淳朴的地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470221
					],
					"speakerTitle": "奇迹建筑师"
				},
				{
					"id": 790470221,
					"content": "咳咳，无论如何…我可是控制成本的高手，当前报价的两倍半就足够了，哪儿有必要那么夸张！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470222
					],
					"speakerTitle": "奇迹建筑师"
				},
				{
					"id": 790470222,
					"content": "没想到啊，没想到啊，不愧是有着「奇迹」之名的高尚建筑师…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470223
					],
					"speakerTitle": "守望者的长老"
				},
				{
					"id": 790470223,
					"content": "有钱不赚？有钱不赚！呆瓜！呆瓜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470224
					],
					"speakerTitle": "不太礼貌的学舌鸟"
				},
				{
					"id": 790470224,
					"content": "喂！你这笨鸟，我不能赚昧良心的摩拉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470225
					],
					"speakerTitle": "奇迹建筑师"
				},
				{
					"id": 790470225,
					"content": "建造这座小镇时，我的报价刚好超出材料和人工费一点点，可以给你们造出最好的房屋，还能余下我两个月的饭钱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470226
					],
					"speakerTitle": "奇迹建筑师"
				},
				{
					"id": 790470226,
					"content": "至于今天的维修服务，我本来也只能赚到路费和这几天的食宿费，难道对于甲方来说，这不是最好的方案吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470227
					],
					"speakerTitle": "奇迹建筑师"
				},
				{
					"id": 790470227,
					"content": "不久前还感动到落泪的长老有些生气，用力敲晕了肩头的学舌鸟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470228
					],
					"speakerTitle": "来自喇叭的旁白"
				},
				{
					"id": 790470228,
					"content": "咳咳，实在感激不尽！我们守望者一族会牢记你的恩情，并将你的事迹代代传颂下去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470229
					],
					"speakerTitle": "守望者的长老"
				},
				{
					"id": 790470229,
					"content": "话说回来，上次您雇了一支驮兽商队，运来了几百个特别的储藏罐，这次则是轻装来访，看起来没做什么准备…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470230
					],
					"speakerTitle": "守望者的长老"
				},
				{
					"id": 790470230,
					"content": "咳！您说到点子上了，现在最主要的问题，就是收集足够的风之微粒，补充气球损失的升力，得想个办法啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470231
					],
					"speakerTitle": "奇迹建筑师"
				},
				{
					"id": 790470231,
					"content": "那你大可不必担心，这次的风之微粒就交给我们了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470232
					],
					"speakerTitle": "守望者的长老"
				},
				{
					"id": 790470232,
					"content": "收集风之微粒正是我族擅长的领域——我们经常用这种方法分析暴风成形的可能性。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470233
					],
					"speakerTitle": "守望者的长老"
				},
				{
					"id": 790470233,
					"content": "就让这一行的好手来助你一臂之力吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470234
					],
					"speakerTitle": "守望者的长老"
				},
				{
					"id": 790470234,
					"content": "长老推选了两位勇敢的守望者——在一旁听候已久的你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470235
					],
					"speakerTitle": "来自喇叭的旁白"
				},
				{
					"id": 790470235,
					"content": "你们早就征服了重力与山风，能在高耸的地形来去自如，是守望者一族的新星。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470236
					],
					"speakerTitle": "来自喇叭的旁白"
				},
				{
					"id": 790470236,
					"content": "我懂啦，终于到我们出场了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470237
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790470237,
					"content": "这一回，我们两个是擅长飞来飞去的守望者，需要去各种地方收集「风之微粒」，听起来一点也不难嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470238,
						790470239
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790470238,
					"content": "经典科目！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790470240
					]
				},
				{
					"id": 790470240,
					"content": "那么，就拜托你们了！这次的工作可能比平时更累，我会额外给你们一笔奖励的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470241
					],
					"speakerTitle": "守望者的长老"
				},
				{
					"id": 790470241,
					"content": "高空作业不是小事，你们一定要注意安全啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470242
					],
					"speakerTitle": "奇迹建筑师"
				},
				{
					"id": 790470242,
					"content": "不用担心，老实的长老和诚实的建筑师，这件事就包在我们身上了！你们在镇子里修气球，我们去收集关键的微粒！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470243
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790470243,
					"content": "#我们走吧，{NICKNAME}，快快干活，早早收工！找齐足够的「风之微粒」，帮这些守望者保住小镇！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790470239,
					"content": "轻车熟路！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790470240
					]
				}
			]
		},
		{
			"id": 7904704,
			"completionStepIds": [
				7904704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
