			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790470401,
					"content": "欢迎回来！真是辛苦你们了，请先好好休息一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470402
					],
					"speakerTitle": "守望者的长老"
				},
				{
					"id": 790470402,
					"content": "厉害！厉害！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470403
					],
					"speakerTitle": "不太礼貌的学舌鸟"
				},
				{
					"id": 790470403,
					"content": "你们环顾四周，奇迹工程师已经修复了所有破损的升力气球。\\n只等「风之微粒」准备到位，就能彻底解决小镇坠落的危机。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470404
					],
					"speakerTitle": "来自喇叭的旁白"
				},
				{
					"id": 790470404,
					"content": "长老召来了其他守望者，为你们端来了热乎乎的饭菜和爽口的饮品。而奇迹建筑师掐表一算，对你们的效率啧啧称奇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470405
					],
					"speakerTitle": "来自喇叭的旁白"
				},
				{
					"id": 790470405,
					"content": "你们完成收集任务的时间，比我的预期快上了整整五天？不愧是有名的高手！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470406
					],
					"speakerTitle": "奇迹建筑师"
				},
				{
					"id": 790470406,
					"content": "既然「风之微粒」收集好了，那我就一鼓作气，为气球补充升力吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470407
					],
					"speakerTitle": "奇迹建筑师"
				},
				{
					"id": 790470407,
					"content": "来自喇叭的旁白开始描述此后的情景——\\n\\n 奇迹建筑师取出了独特的设备，四处奔走，通过预先设置好的接口，将你们收集到的「风之微粒」分发至地基各处的装置。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						790470408
					]
				},
				{
					"id": 790470408,
					"content": "随着升力恢复正常，异常的震动也完全停息。\\n小镇不再下坠，反而慢慢向原本所在的高度攀升，强烈的气流排开了大片云层…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						790470409
					]
				},
				{
					"id": 790470409,
					"content": "阴翳的天色也重归晴朗，小镇重新沐浴在明媚的阳光之下，守望者们开始欢庆叫好…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						790470410
					]
				},
				{
					"id": 790470410,
					"content": "太好了，小镇总算停止下坠了，危机圆满解除，鼓掌鼓掌！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790470411,
					"content": "可是，为什么我们两个要一直抬头看呢？ 明明是我们脑海里想象的情景，而且我们本来也站在小镇上吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790470412,
					"content": "脖子都酸了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790470413,
					"content": "要不然，等到有机会了，我们找一找这方面的专家，把这个故事画出来，或者…做成映影！我有预感，一定可以大卖的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470414,
						790470415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790470414,
					"content": "说不定黛依阿也是这么想的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790470416
					]
				},
				{
					"id": 790470416,
					"content": "感受着脚下的地基归于平静，长老长舒了一口气，感动得有些鼻酸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470417
					],
					"speakerTitle": "来自喇叭的旁白"
				},
				{
					"id": 790470417,
					"content": "小镇安全了！小镇安全了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470418
					],
					"speakerTitle": "不太礼貌的学舌鸟"
				},
				{
					"id": 790470418,
					"content": "太好了，太好了…这样一来，我们守望者一族就可以继续恪守职责！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470419
					],
					"speakerTitle": "守望者的长老"
				},
				{
					"id": 790470419,
					"content": "大功告成…这次的修复工程非常顺利，是能写进论文…哦不，是足以登上教科书的完美案例！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470420
					],
					"speakerTitle": "奇迹建筑师"
				},
				{
					"id": 790470420,
					"content": "今后两个月都不用为饭钱发愁了，下次的大工程，做点什么厉害的东西好呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470421
					],
					"speakerTitle": "奇迹建筑师"
				},
				{
					"id": 790470421,
					"content": "可是，容我一问，小镇好像…还一直在上升，如果超过了本来的高度…什么时候才会停下来呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470422
					],
					"speakerTitle": "守望者的长老"
				},
				{
					"id": 790470422,
					"content": "糟糕！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470423
					],
					"speakerTitle": "奇迹建筑师"
				},
				{
					"id": 790470423,
					"content": "我好像光顾着修复气球，忘记把抵消升力的锚索固定好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470424
					],
					"speakerTitle": "奇迹建筑师"
				},
				{
					"id": 790470424,
					"content": "不要慌…小镇上升的速度很慢，还可以用小型货运气球来施工！这点补救措施，花不了多少功夫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470425
					],
					"speakerTitle": "奇迹建筑师"
				},
				{
					"id": 790470425,
					"content": "原来如此，我还以为，您见识到两位新星的身姿后，觉得我们都能飞檐走壁，适应高空的生活…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470426
					],
					"speakerTitle": "守望者的长老"
				},
				{
					"id": 790470426,
					"content": "哈！我们守望者一族倒也没有那么神通广大…麻烦您尽快修复这个小小的瑕疵了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470427
					],
					"speakerTitle": "守望者的长老"
				},
				{
					"id": 790470427,
					"content": "要加钱吗？要加钱吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470428
					],
					"speakerTitle": "不太礼貌的学舌鸟"
				},
				{
					"id": 790470428,
					"content": "再赚一点？再赚一点？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470429
					],
					"speakerTitle": "不太礼貌的学舌鸟"
				},
				{
					"id": 790470429,
					"content": "假如长老打算建一个豪华鸟笼，把你关在里边，好好学习说话的礼仪，还有「生财有道」的道德观…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470430
					],
					"speakerTitle": "奇迹建筑师"
				},
				{
					"id": 790470430,
					"content": "那不用加钱，倒贴钱我也干！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470431
					],
					"speakerTitle": "奇迹建筑师"
				},
				{
					"id": 790470431,
					"content": "虽说最后还有一点小插曲，但并不影响结局的完满。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470432
					],
					"speakerTitle": "来自喇叭的旁白"
				},
				{
					"id": 790470432,
					"content": "如此一来，守望者一族心心念念的问题，便被奇迹建筑师彻底解决了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470433
					],
					"speakerTitle": "来自喇叭的旁白"
				},
				{
					"id": 790470433,
					"content": "这座天空中的小镇将继续支持着高崖守望者一族，为整个地区带来长久的安宁与繁荣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470434
					],
					"speakerTitle": "来自喇叭的旁白"
				},
				{
					"id": 790470434,
					"content": "「天空高城救守记」全剧终，感谢您的观看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470435
					],
					"speakerTitle": "来自喇叭的旁白"
				},
				{
					"id": 790470435,
					"content": "鼓掌鼓掌，这部话剧落幕啦！ 虽然还有一些遗憾，但故事本身还是很不错的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470436
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790470436,
					"content": "如果我是一个富商，就要给「黛依阿的三日遐思」投一大笔钱，把每件道具和每个场景都做到最好，来讲好这个故事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470437,
						790470438
					],
					"speakerTitle": "派蒙"
