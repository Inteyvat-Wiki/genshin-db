			},
			"dialogs": [
				{
					"id": 201020401,
					"content": "…一点消息也没有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020402,
						201020405
					],
					"speakerTitle": "提米"
				},
				{
					"id": 201020402,
					"content": "你在喂鸽子吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020403
					]
				},
				{
					"id": 201020403,
					"content": "今天我喂过了，而且已经让它们赶紧飞走，免得又被你祸害。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020404
					],
					"speakerTitle": "提米"
				},
				{
					"id": 201020404,
					"content": "现在我就只是在写信而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020407
					],
					"speakerTitle": "提米"
				},
				{
					"id": 201020407,
					"content": "葛瑞丝妈妈说，如果爸爸有空的话，就会用鸽子寄信过来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020408
					],
					"speakerTitle": "提米"
				},
				{
					"id": 201020408,
					"content": "但是我等到现在也没收到一封信…也许爸爸工作真的太忙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020409
					],
					"speakerTitle": "提米"
				},
				{
					"id": 201020409,
					"content": "我就想，既然爸爸太忙，那我就写一封信给他吧，里面再带上点礼物…可是，带什么礼物好呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020410
					],
					"speakerTitle": "提米"
				},
				{
					"id": 201020410,
					"content": "对了，用<color=#00E1FFFF>蒲公英</color>吧，葛瑞丝妈妈说蒙德人都喜欢蒲公英。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020411
					],
					"speakerTitle": "提米"
				},
				{
					"id": 201020411,
					"content": "如果你有空的话，就去帮我找点<color=#00E1FFFF>蒲公英</color>来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020412,
						201020414
					],
					"speakerTitle": "提米"
				},
				{
					"id": 201020412,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020413
					]
				},
				{
					"id": 201020413,
					"content": "哦！谢谢你啦…你偶尔还是挺好心的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "提米"
				},
				{
					"id": 201020414,
					"content": "不送点别的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020415
					]
				},
				{
					"id": 201020415,
					"content": "我倒是想送，可是太重的话，鸽子就飞不起来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020416
					],
					"speakerTitle": "提米"
				},
				{
					"id": 201020416,
					"content": "而且爸爸在很远的地方工作，鸽子应该也要飞很久吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "提米"
				},
				{
					"id": 201020405,
					"content": "你在做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020406
					]
				},
				{
					"id": 201020406,
					"content": "我在给我爸写信。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020407
					],
					"speakerTitle": "提米"
				}
			]
		},
