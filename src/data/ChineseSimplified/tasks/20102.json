			"dialogs": [
				{
					"id": 201020601,
					"content": "你找到蒲公英了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020602
					],
					"speakerTitle": "提米"
				},
				{
					"id": 201020602,
					"content": "找到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020603
					]
				},
				{
					"id": 201020603,
					"content": "太好了，这些就够了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020604
					],
					"speakerTitle": "提米"
				},
				{
					"id": 201020604,
					"content": "把蒲公英籽放进信里面…然后封好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020605
					],
					"speakerTitle": "提米"
				},
				{
					"id": 201020605,
					"content": "好啦！嘿嘿，爸爸收到这封信肯定很高兴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020606
					],
					"speakerTitle": "提米"
				},
				{
					"id": 201020606,
					"content": "不过…我听说送信要用专业的信鸽才行…而且，我也不知道爸爸的收信地址…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020607
					],
					"speakerTitle": "提米"
				},
				{
					"id": 201020607,
					"content": "对了！我听葛瑞丝妈妈说，清泉镇的杜拉夫先生养了一批信鸽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020608
					],
					"speakerTitle": "提米"
				},
				{
					"id": 201020608,
					"content": "而且她说，杜拉夫先生还认识我爸爸，他一定知道怎么把这封信寄出去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020609
					],
					"speakerTitle": "提米"
				},
				{
					"id": 201020609,
					"content": "那…就拜托你再帮我跑一趟，把这封信给杜拉夫先生，拜托他寄出去给我爸爸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020610
					],
					"speakerTitle": "提米"
				},
				{
					"id": 201020610,
					"content": "还有，不许偷看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "提米"
				}
			]
		},
