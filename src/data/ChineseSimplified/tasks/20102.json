						201020702
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 201020702,
					"content": "这是提米要寄给他爸爸的信。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020703
					]
				},
				{
					"id": 201020703,
					"content": "提米寄给他爸爸的信…你也应该从葛瑞丝修女那听说了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020704
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 201020704,
					"content": "这封信是…寄不出去的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020705,
						201020708,
						201020712
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 201020705,
					"content": "那就不寄了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020706
					]
				},
				{
					"id": 201020706,
					"content": "怎么想都没法寄出去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020707
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 201020707,
					"content": "没办法，还是暂且由我保管起来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020717
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 201020717,
					"content": "好了，这封信就放在我这里…就权当它已经寄出去了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020718
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 201020718,
					"content": "我的那位老朋友一定也会理解我的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020719
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 201020719,
					"content": "谢谢你，请务必向提米保密，你一定做得到，对吧？至少…看在这些谢礼的份上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 201020708,
					"content": "烧掉吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020709
					]
				},
				{
					"id": 201020709,
					"content": "哈哈哈，你已经很有冒险家的作风了，做起事果决高效…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020710
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 201020710,
					"content": "不过，我可不是冒险家，我只是个普通的猎人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020711
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 201020711,
					"content": "我不会把这封信烧掉的，也不会打开，我会把它好好保管起来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020717
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 201020712,
					"content": "我来保管。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020713
					]
				},
				{
					"id": 201020713,
					"content": "你保管来做什么？你不会是想，也许我的那位老朋友没死…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020714
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 201020714,
					"content": "…只要你游历的地方够多，也许还是会遇见他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020715
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 201020715,
					"content": "我也曾经和你想的一样，甚至还付诸了行动，但是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020716
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 201020716,
					"content": "最终我还是认清了现实，那就是我的老朋友已经永远离我而去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020717
					],
					"speakerTitle": "杜拉夫"
				}
			]
		},
