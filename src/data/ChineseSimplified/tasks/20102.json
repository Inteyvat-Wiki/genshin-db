	"talks": [
		{
			"id": 2010201,
			"completionStepIds": [
				2010201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2010201",
							"2"
						],
						"stepId": 2010201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"杜拉夫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201020101,
					"content": "唉，也不知道那孩子怎么样了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020102
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 201020102,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020103
					]
				},
				{
					"id": 201020103,
					"content": "嗯？哦，你来得正好，还记得上次那封信吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020104
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 201020104,
					"content": "如果你有空的话，就帮我把这封信带给葛瑞丝修女吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020105,
						201020107
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 201020105,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020106
					]
				},
				{
					"id": 201020106,
					"content": "那就拜托你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 201020107,
					"content": "为什么要我去？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020108
					]
				},
				{
					"id": 201020108,
					"content": "出了上次那种意外，我怎么敢继续用鸽子送信嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020109
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 201020109,
					"content": "而且，如果我自己送这封信去蒙德城，一定会遇见那孩子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020110
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 201020110,
					"content": "唉…你也别追问了，这封信就拜托你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "杜拉夫"
				}
			]
		},
		{
			"id": 2010202,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2010202",
							"2"
						],
						"stepId": 2010202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"杜拉夫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201020201,
					"content": "嗯？你怎么还没有去？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020202,
						201020205
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 201020202,
					"content": "关于那份信…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020203
					]
				},
				{
					"id": 201020203,
					"content": "…里面就写了些陈年旧事，你上次没有看吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020204
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 201020204,
					"content": "没看的话也别看了，都是些无聊的啰嗦话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 201020205,
					"content": "那孩子是谁？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020206
					]
				},
				{
					"id": 201020206,
					"content": "你关心这个做什么，那个一直在桥上喂鸽子的孩子，你还记得吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020207
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 201020207,
					"content": "就是他，提米。因为…一些原因，我不太好现在去见他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020208
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 201020208,
					"content": "满意了吗？快点去把信送过去吧，不然葛瑞丝修女又要想东想西了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "杜拉夫"
				}
			]
		},
		{
			"id": 2010203,
			"completionStepIds": [
				2010202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2010202",
							"2"
						],
						"stepId": 2010202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"葛瑞丝"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201020301,
					"content": "奇怪，怎么还没有来，难道是出什么事了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020302
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 201020302,
					"content": "这是杜拉夫给你的信。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020303
					]
				},
				{
					"id": 201020303,
					"content": "咦？怎么是你送来的，平时不都是鸽子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020304
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 201020304,
					"content": "鸽子出了意外？清泉镇真是…天天都在发生「意外」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020305
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 201020305,
					"content": "谢谢你们把信送来，请稍等一下，我去准备谢礼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020306
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 201020306,
					"content": "关于这封信…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020307
					]
				},
				{
					"id": 201020307,
					"content": "您看过了吗？没关系，不是什么重大的秘密。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020308
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 201020308,
					"content": "用杜拉夫先生的话来说，这是些「陈年旧事」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020309
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 201020309,
					"content": "只不过，这些「陈年旧事」，我们永远也忘不掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020310
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 201020310,
					"content": "这些「陈年旧事」到底是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020311
					]
				},
				{
					"id": 201020311,
					"content": "您想听吗？好吧，您是值得信赖的人…但是您也得保证，绝不能把这件事说出去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020312,
						201020313
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 201020312,
					"content": "我保证。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020316
					]
				},
				{
					"id": 201020316,
					"content": "…提米的父亲，和杜拉夫先生是很好的朋友，他们一起狩猎，一起喝酒，一起到处折腾…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020317
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 201020317,
					"content": "不知道被骑士团警告了多少次，也不知道被维多利亚修女训诫了多少次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020318
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 201020318,
					"content": "直到提米出生，提米的父亲才收敛了起来。他甚至还戒了酒，开始认真工作攒钱，说「老爹要给儿子做榜样才行」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020319
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 201020319,
					"content": "然后，他嚷嚷着不要给提米做坏榜样，磨得杜拉夫先生也把酒给戒了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020320
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 201020320,
					"content": "实在忍不住的时候，他们就一个劲地给自己灌苹果酿，偶尔我会去和他们一起喝一点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020321
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 201020321,
					"content": "但是，他们的一次狩猎出了意外，提米的父亲受了很重的伤…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020322
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 201020322,
					"content": "虽然马上就送了过来，我们也全力治疗，但是…很不幸，他还是去世了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020323
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 201020323,
					"content": "那之后，杜拉夫先生就拜托我照顾提米，他回去清泉镇继续做猎人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020324
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 201020324,
					"content": "他每个月都会寄信和钱过来，但却一直不肯见提米。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020325
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 201020325,
					"content": "不过，最近他一直在说，要把真相告诉提米，唉，到底他经历了什么呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020326,
						201020332,
						201020336
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 201020326,
					"content": "您不想告诉提米真相？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020327
					]
				},
				{
					"id": 201020327,
					"content": "是的，我不想告诉提米真相，他还是个孩子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020328
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 201020328,
					"content": "虽然他一直说自己已经是男子汉，还帮我照顾诺拉和葛罗丽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020329
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 201020329,
					"content": "但是…这种残酷的真相，他怎么可能承受得住呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020330
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 201020330,
					"content": "在他足够成熟，能够承受真相之前…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020331
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 201020331,
					"content": "就算是欺骗也好，我想要给他一个幸福的童年。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020341
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 201020341,
					"content": "不过提米也在长大，想的事，问的问题也越来越多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020342
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 201020342,
					"content": "我已经越来越难面对这孩子了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020343
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 201020343,
					"content": "诺拉说，之前提米一直拉着她到处跑，说是要给自己的父亲筹备礼物，还要寄信过去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020344
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 201020344,
					"content": "但最近，提米总是闷闷不乐的，还总是在发呆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020345
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 201020345,
					"content": "如果您有空的话，能帮我去看看提米吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020346,
						201020348
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 201020346,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020347
					]
				},
				{
					"id": 201020347,
					"content": "那就拜托您了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 201020348,
					"content": "为什么你不自己去？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020349
					]
				},
				{
					"id": 201020349,
					"content": "实在不好意思…虽然嘴上说我已经想清楚了，不会告诉提米真相。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020350
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 201020350,
					"content": "但每次听见那孩子说要给父亲写信的时候，我都会突然心软。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020351
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 201020351,
					"content": "我真怕我哪一天忍耐不住，把真相全部告诉他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020352
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 201020352,
					"content": "…但这样是绝对不行的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020353
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 201020353,
					"content": "所以，请您帮我去看看提米吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 201020332,
					"content": "不可能瞒一辈子。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020333
					]
				},
				{
					"id": 201020333,
					"content": "…是啊，我知道的。但提米还是个孩子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020334
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 201020334,
					"content": "但是我希望…我坚持，他应该有一个快乐的童年。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020335
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 201020335,
					"content": "这样的话，无论他以后会遭受怎样的痛苦折磨，至少还有美好的回忆能给他安慰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020341
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 201020336,
					"content": "知道真相有什么不好的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020337
					]
				},
				{
					"id": 201020337,
					"content": "呼…您这么想也正常，因为您经历了太多，已经足够勇敢，足够坚强了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020338
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 201020338,
					"content": "那些将您塑造得如此不凡的经历，想必也是十分痛苦的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020339
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 201020339,
					"content": "但提米还小，即使是出于我的私心，我也不希望他承受太多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020340
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 201020340,
					"content": "…至少，我想给他一个能够回忆的幸福童年。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020341
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 201020313,
					"content": "我尽量。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020314
					]
				},
				{
					"id": 201020314,
					"content": "唉，您这个人哪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020315
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 201020315,
					"content": "…不过，我相信您的品德。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020316
					],
					"speakerTitle": "葛瑞丝"
				}
			]
		},
