			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「公子」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10031801,
					"content": "你们终于回来了，绝云间之行成果如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031802
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10031802,
					"content": "…原来如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10031806,
					"content": "并没有见到所有仙人…按他们的话说就是「无缘得见」，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031807
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10031807,
					"content": "没关系！最近如果有空的话，再去碰碰运气也无妨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031808
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10031808,
					"content": "而且，降魔大圣的情报已经很珍贵了。作为回礼，我也有情报提供给你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031809
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10031809,
					"content": "对于神祇之死，璃月七星的反应，十分耐人寻味…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031810
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10031810,
					"content": "他们对外宣称，由于尚未寻获真凶，不允许任何人瞻仰「仙祖法蜕」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031811
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10031811,
					"content": "甚至还试图封锁消息…但毕竟请仙典仪人来人往，即使七星也难以禁绝流言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031812
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10031812,
					"content": "仙祖法蜕？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031813
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10031813,
					"content": "以璃月的常识而言，岩王帝君也是一位仙人嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031814
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10031814,
					"content": "岩神是契约之神，同时也被称作众仙之祖。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031815
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10031815,
					"content": "如今的所有「三眼五显仙人」，当年都曾立下守望璃月的契约。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031816
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10031816,
					"content": "这样啊…难怪他们对璃月的事这么上心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031817
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10031817,
					"content": "没错，他们既有责任，也有资格。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031818
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10031818,
					"content": "——如果掌管璃月的七星出了问题，他们就有兴师问罪的资格。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031819
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10031820,
					"content": "这对我也是很大的麻烦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10031822
					]
				},
				{
					"id": 10031821,
					"content": "我也不能接受这种做法。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10031822
					]
				},
				{
					"id": 10031819,
					"content": "岩神灵魂升入高天，留下的躯壳，为何会被七星藏匿？实在可疑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031820,
						10031821
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10031822,
					"content": "啊！没错，我们本来就是来找那位神灵的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031823
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10031823,
					"content": "如果璃月七星把「仙祖法蜕」藏起来、不让人接近的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031824
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10031824,
					"content": "#{NICKNAME}想要寻访全部七神的目标，就会完全落空了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031825
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10031826,
					"content": "与你无关。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10031828
					]
				},
				{
					"id": 10031827,
					"content": "无可奉告。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10031828
					]
				},
				{
					"id": 10031825,
					"content": "喔？你们正在寻访七神？是为了什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031826,
						10031827
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10031828,
					"content": "嘿…不错的回答。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031829
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10031829,
					"content": "轻易被「愚人众」套话的骑士，可不是一位好骑士，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031830
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10031830,
					"content": "不过…这一次，我还是可以帮助你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031831
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10031831,
					"content": "咦？真的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031832
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10031832,
					"content": "给我一点时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031833
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10031833,
					"content": "一点时间…用来找人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031834
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10031834,
					"content": "我会为你找到，能够突破这僵局的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031835
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10031835,
					"content": "啊…真有意思。布局阶段压抑得越平静，最终爆发出的混乱就越激烈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031836
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10031836,
					"content": "为了亲眼目睹暗流的决堤，一定要坚持到活着与我再相见哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「公子」"
				}
			]
		},
