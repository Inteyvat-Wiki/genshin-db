				"objectNames": [
					"大伴"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726910101,
					"content": "#{M#小哥}{F#姑娘}，我看你在这会场上徘徊了很久，应该也是懂得欣赏文艺的风雅之人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910102
					],
					"speakerTitle": "大伴"
				},
				{
					"id": 726910102,
					"content": "现在有件风雅之事想请你帮忙，不知道你意下如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910103
					],
					"speakerTitle": "大伴"
				},
				{
					"id": 726910103,
					"content": "请讲。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726910104
					]
				},
				{
					"id": 726910104,
					"content": "我和这位蒙德来的吟游诗人，莱内先生，一见如故。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910105
					],
					"speakerTitle": "大伴"
				},
				{
					"id": 726910105,
					"content": "大伴先生说的很对，虽然我和他认识才几天，但他的学识涵养让我非常钦佩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910106
					],
					"speakerTitle": "莱内"
				},
				{
					"id": 726910106,
					"content": "呵呵，莱内先生客气了。总之，我们二人决定以诗会友，趁着这段时间一起创作一些作品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910107
					],
					"speakerTitle": "大伴"
				},
				{
					"id": 726910107,
					"content": "既然风尘仆仆来到了稻妻，那么莱内先生也很想在作品中加入一些有稻妻特色的内容。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910108
					],
					"speakerTitle": "大伴"
				},
				{
					"id": 726910108,
					"content": "对，只可惜这次来稻妻的行程太紧，没有时间到处游览采风。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910109
					],
					"speakerTitle": "莱内"
				},
				{
					"id": 726910109,
					"content": "所以，我能做些什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726910110
					]
				},
				{
					"id": 726910110,
					"content": "朋友，我正在写一首主题是「乡愁」的诗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910111
					],
					"speakerTitle": "莱内"
				},
				{
					"id": 726910111,
					"content": "游子看到异乡的风景，往往不自觉地回忆起故乡，所以我想在诗里加入一些异乡独有的意象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910112
					],
					"speakerTitle": "莱内"
				},
				{
					"id": 726910112,
					"content": "不知道你能否用留影机拍摄一些画片，帮助我寻找创作灵感呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910113
					],
					"speakerTitle": "莱内"
				},
				{
					"id": 726910113,
					"content": "稻妻应该有许多独特的风物吧？比方说，一提到蒙德，大家就会想起「蒲公英」和「风车菊」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910114
					],
					"speakerTitle": "莱内"
				},
				{
					"id": 726910114,
					"content": "哦哦，我明白啦，既然这样，去拍摄一些稻妻区域特产的画片就可以了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726910115,
					"content": "嗯，那就拜托你们了！我把目前这首创作到一半的诗，也抄一份留给你们做参考。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910116
					],
					"speakerTitle": "莱内"
				},
				{
					"id": 726910116,
					"content": "至于拍摄数量，我想有<color=#00E1FFFF>四张</color>内容不同的画片就差不多了，我也会为你们提供相应的旅费报酬的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910117
					],
					"speakerTitle": "莱内"
				},
				{
					"id": 726910117,
					"content": "#{NICKNAME}，既然莱内先生的要求已经都清楚了，那我们就出发吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
