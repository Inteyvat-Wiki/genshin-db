					"speakerTitle": "莱内"
				},
				{
					"id": 726910302,
					"content": "已经拍好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726910303
					]
				},
				{
					"id": 726910303,
					"content": "太感谢了。让我看看…果然都是我之前从没见过的物产！噢，这张拍得真不错！这张似乎也很值得一写…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910304
					],
					"speakerTitle": "莱内"
				},
				{
					"id": 726910304,
					"content": "朋友，多亏了你们拍摄的画片，我一下子就有了灵感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910305
					],
					"speakerTitle": "莱内"
				},
				{
					"id": 726910305,
					"content": "根据你们提供的画片，我试着写了几种不同的诗句，要使用哪一句，还真是让人为难。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910306
					],
					"speakerTitle": "莱内"
				},
				{
					"id": 726910306,
					"content": "我有些好奇你的意见，如果是你会用哪句呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莱内"
				}
			]
		},
