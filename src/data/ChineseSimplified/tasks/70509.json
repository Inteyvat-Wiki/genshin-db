				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"申鹤"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705090101,
					"content": "#{NICKNAME}，你好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090102
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 705090102,
					"content": "你好呀！唉，要不是连续见了那么多朋友，我肯定会很惊讶，连你都来了呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705090103,
					"content": "不…不对，这不是申鹤嘛！我果然还是被惊讶到了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705090104,
					"content": "嗯…这里确实不好找。「天使的馈赠」…名字拗口。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090105
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 705090105,
					"content": "多亏热心的钟离先生帮忙指路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090106
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 705090106,
					"content": "还让人指路了啊…我猜猜看，你是专程赶来喝东西的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705090107,
					"content": "嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090108
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 705090108,
					"content": "因为是…朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090109
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 705090109,
					"content": "想喝点什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705090110
					]
				},
				{
					"id": 705090110,
					"content": "来，这里有菜单！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705090111,
					"content": "北风之望…北风，是凉嗖嗖的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090112
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 705090112,
					"content": "唔，这个名字里的北风应该是指北风狼吧？冷…的确挺冷的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705090113,
					"content": "焦糖松果…为什么能拿来喝？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090114
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 705090114,
					"content": "啊，这个我尝过。是焦糖味的咖啡，松果…松果说的应该是颜色！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705090115,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090116
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 705090116,
					"content": "看名字，完全无法理解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090117
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 705090117,
					"content": "交给你们吧。类似清心、琉璃袋…那种味道的就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090118
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 705090118,
					"content": "这里的土壤不长这些药材啦，想喝苦的东西，就只有咖啡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705090119,
					"content": "要不要试试甜味的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705090120
					]
				},
				{
					"id": 705090120,
					"content": "…好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090121
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 705090121,
					"content": "也对，修行久了是该换换口味！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705090122,
					"content": "我们给申鹤来一杯覆雪之吻吧！看名字就跟她很搭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7050902,
			"completionStepIds": [
				7050903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7050903",
							"2"
						],
						"stepId": 7050903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"申鹤"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705090201,
					"content": "很甜，口感顺滑，不苦涩。这是什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090202
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 705090202,
					"content": "它叫「覆雪之吻」！把牛奶打成细密的奶泡轻轻倒在果汁上，看起来就像是覆盖着积雪一样哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705090203,
					"content": "至于为什么要叫吻什么的…我也不懂…可能是商家的花招吧，为了让它更好卖！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705090204,
					"content": "更好卖？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090205
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 705090205,
					"content": "欸？不是吗？我、我乱说的…那、那它是一种…浪漫的形容！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705090206,
					"content": "浪漫…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090207
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 705090207,
					"content": "呜…好难解释啊！不要逼我编故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090208,
						705090209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705090208,
					"content": "奶泡没有太多味道…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705090210
					]
				},
				{
					"id": 705090210,
					"content": "是这样没错…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090211,
						705090212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705090211,
					"content": "喝到果汁的那一刻很甜…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705090213
					]
				},
				{
					"id": 705090213,
					"content": "…啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090214
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 705090214,
					"content": "这样啊…我似乎明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090215
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 705090215,
					"content": "欸？欸——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705090216,
					"content": "等一下，为什么啊！现在换我不明白了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705090217,
					"content": "我在山间走动时，偶尔会嚼食仙草，也曾亲眼目睹幼芽破土的刹那。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090218
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 705090218,
					"content": "心中那份悸动…的确，与此刻很是相似。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090219
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 705090219,
					"content": "#{NICKNAME}，谢谢你能让我明白这些…难懂的名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090220
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 705090220,
					"content": "往后，或许也要麻烦你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "申鹤"
				},
				{
					"id": 705090212,
					"content": "如同嫩芽破冰，亲吻了你…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705090213
					]
				},
				{
					"id": 705090209,
					"content": "就像山顶的积雪…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705090210
					]
				}
			]
		}
	]
}