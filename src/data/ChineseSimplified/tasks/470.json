						4700102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4700102,
					"content": "是<color=#00E1FFFF>渔人吐司</color>的香气！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4700103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4700103,
					"content": "嗯…嗯。是从「猎鹿人」餐馆的方向飘来的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4700104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4700104,
					"content": "松软的吐司面包切成厚片…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4700105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4700105,
					"content": "铺满洋葱，烤到微焦之后放进嘴里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4700106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4700106,
					"content": "好，我决定了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4700107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4700107,
					"content": "事不宜迟，就去<color=#00E1FFFF>「猎鹿人」</color>买一份<color=#00E1FFFF>渔人吐司</color>吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4700108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4700108,
					"content": "当然，是你请客。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
