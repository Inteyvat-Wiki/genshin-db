			"trigger": {
				"objectNames": [
					"拜希麦"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735280101,
					"content": "路过的客人，生论派的学者拜希麦恳求您，别急着离开…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280102
					],
					"speakerTitle": "拜希麦"
				},
				{
					"id": 735280102,
					"content": "请放松身体，放空思绪，听我说一件重要的事——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280103
					],
					"speakerTitle": "拜希麦"
				},
				{
					"id": 735280103,
					"content": "团雀最可爱！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280104
					],
					"speakerTitle": "拜希麦"
				},
				{
					"id": 735280104,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735280105,
					"content": "？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735280106
					]
				},
				{
					"id": 735280106,
					"content": "团雀确实很可爱，但拜希麦小姐是学者吧？一句话没有限制范围，不是会引发很激烈的争论吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735280107,
					"content": "我的印象里，学者的发言都很谨慎的，如果我是学者，那我也不敢随便说…唔…「金丝虾球最好吃！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735280108,
					"content": "只能加一些限定词，比如「最近，在璃月菜的范围里，我最想吃这道菜」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280109,
						735280110,
						735280111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735280109,
					"content": "那我就敢说！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735280112
					]
				},
				{
					"id": 735280112,
					"content": "#噫！{NICKNAME}，为什么这么突然啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735280113,
					"content": "就算不是开玩笑，也不要那么大声嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735280114,
					"content": "哈哈哈！就是这种状态！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280115
					],
					"speakerTitle": "拜希麦"
				},
				{
					"id": 735280115,
					"content": "正因为我是学者，我才不想把生活的每时每刻都变成辩论场，觉得自己一句话都不能说错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280116
					],
					"speakerTitle": "拜希麦"
				},
				{
					"id": 735280116,
					"content": "反正不会有人时时刻刻盯着我，说错话又不会少块肉，没必要一直心惊胆战！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280117
					],
					"speakerTitle": "拜希麦"
				},
				{
					"id": 735280117,
					"content": "但最重要的想法，一定要用力喊出来，大胆地直抒胸臆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280118
					],
					"speakerTitle": "拜希麦"
				},
				{
					"id": 735280118,
					"content": "如果你们来玩过我这款桌上游戏「哐哐当当雀雀球」，也会像我这样大声告诉别人，团雀最可爱！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280119
					],
					"speakerTitle": "拜希麦"
				},
				{
					"id": 735280119,
					"content": "哐哐…当当…雀雀球？就是你背后这张桌子上的东西吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735280120,
					"content": "没错哦，玩过这个游戏以后，你们就能深刻领会到团雀的可爱之处啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280121
					],
					"speakerTitle": "拜希麦"
				},
				{
					"id": 735280121,
					"content": "而且，作为「琉形蜃境」的正式游乐项目之一，如果在游戏里得到高分，还可以获得一些奖励哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280122
					],
					"speakerTitle": "拜希麦"
				},
				{
					"id": 735280122,
					"content": "说得这么夸张，我也有点好奇了，而且表现不错，还能拿到奖品…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735280123,
					"content": "#你觉得呢，{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280124,
						735280125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735280124,
					"content": "那我们就试试看！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735280126
					]
				},
				{
					"id": 735280126,
					"content": "哈哈哈哈，好干脆！那就请你们尽情体验吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "拜希麦"
				},
				{
					"id": 735280125,
					"content": "团雀究竟多可爱！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735280126
					]
				},
				{
					"id": 735280110,
					"content": "派蒙最可爱！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735280112
					]
				},
				{
					"id": 735280111,
					"content": "什么都不管！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735280112
					]
				}
			]
		}
	]
}