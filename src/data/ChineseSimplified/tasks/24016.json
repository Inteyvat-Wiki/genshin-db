			"dialogs": [
				{
					"id": 240160401,
					"content": "呼…多谢您帮忙。要是没您帮忙，我都不知道要收拾到什么时候去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160402
					],
					"speakerTitle": "沙尔梅"
				},
				{
					"id": 240160402,
					"content": "不过，要是您帮忙时用的力度能小一点的话，就更好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160403,
						240160404
					],
					"speakerTitle": "沙尔梅"
				},
				{
					"id": 240160403,
					"content": "不好意思…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160405
					]
				},
				{
					"id": 240160405,
					"content": "您别误会！我没有责怪的意思，这已经帮了我大忙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160406
					],
					"speakerTitle": "沙尔梅"
				},
				{
					"id": 240160406,
					"content": "这些东西给您，多谢您帮忙了，荣誉高级研究员。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "沙尔梅"
				},
				{
					"id": 240160404,
					"content": "我下次一定轻一点…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160405
					]
				}
			]
		}
