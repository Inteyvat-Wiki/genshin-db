			"dialogs": [
				{
					"id": 240160301,
					"content": "呼…多谢您帮忙。要是没您帮忙，我都不知道要收拾到什么时候去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160302
					],
					"speakerTitle": "沙尔梅"
				},
				{
					"id": 240160302,
					"content": "真不愧是荣誉高级研究员，无论做什么事都这么利落。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160303,
						240160304
					],
					"speakerTitle": "沙尔梅"
				},
				{
					"id": 240160303,
					"content": "我一向身手不凡。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160306
					]
				},
				{
					"id": 240160306,
					"content": "再次感谢您帮忙啦，荣誉高级研究员，这些东西请收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "沙尔梅"
				},
				{
					"id": 240160304,
					"content": "我对打扫略有心得。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160305
					]
				},
				{
					"id": 240160305,
					"content": "欸？那您还真是多才多艺。不愧是荣誉高级研究员！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160306
					],
					"speakerTitle": "沙尔梅"
				}
			]
