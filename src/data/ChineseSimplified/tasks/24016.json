			},
			"dialogs": [
				{
					"id": 240160101,
					"content": "这样就差不多了…希望这些资料真能派上用场。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160102
					],
					"speakerTitle": "沙尔梅"
				},
				{
					"id": 240160102,
					"content": "你还在这里整理资料？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160103
					]
				},
				{
					"id": 240160103,
					"content": "哎呀，很高兴见到您，荣誉高级研究员。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160104
					],
					"speakerTitle": "沙尔梅"
				},
				{
					"id": 240160104,
					"content": "没错，按照雷蒙多先生的指示，我还在继续整理资料和卷宗呢…欸，我之前是不是说过一遍了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160105
					],
					"speakerTitle": "沙尔梅"
				},
				{
					"id": 240160105,
					"content": "这地方这么大，就你一个人工作的话也太辛苦了，雷蒙多怎么都没派人来帮你呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 240160106,
					"content": "科学院现在诸事繁忙，分不出人来帮我也是情理之中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160107
					],
					"speakerTitle": "沙尔梅"
				},
				{
					"id": 240160107,
					"content": "亏你还是「主任」呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160108
					]
				},
				{
					"id": 240160108,
					"content": "您是说「枫丹科学院文材回收组主任」这个头衔吗？唉，还请您别笑话我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160109
					],
					"speakerTitle": "沙尔梅"
				},
				{
					"id": 240160109,
					"content": "我哪里是什么「主任」呀。从一开始，我就只是一个负责整理卷宗的普通职员。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160110
					],
					"speakerTitle": "沙尔梅"
				},
				{
					"id": 240160110,
					"content": "自从被雷蒙多先生指派来这里整理之后，就突然被告知，多了这么一个头衔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160111
					],
					"speakerTitle": "沙尔梅"
				},
				{
					"id": 240160111,
					"content": "有人告诉我，这是舒瓦瑟尔先生的意见，说他觉得我们工作很辛苦，这么做主要是方便给我们多发点补贴…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160112
					],
					"speakerTitle": "沙尔梅"
				},
				{
					"id": 240160112,
					"content": "哎呀！您可别告诉别人，我…我怎么说出来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160113
					],
					"speakerTitle": "沙尔梅"
				},
				{
					"id": 240160113,
					"content": "我不会告诉别人的，放心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160114
					]
				},
				{
					"id": 240160114,
					"content": "听起来像是好事呢。辛苦做了很多事的人，拿多一点报酬也没问题呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 240160115,
					"content": "不过，为什么要用这么绕的方法呢？直接把报酬发给大家不就好了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160116,
						240160117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 240160116,
					"content": "在科学院，倒也正常。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160118
					]
				},
				{
					"id": 240160118,
					"content": "唉，我是不能理解舒瓦瑟尔先生和雷蒙多先生在想什么呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160119
					],
					"speakerTitle": "沙尔梅"
				},
				{
					"id": 240160119,
					"content": "但无论如何，我都得继续工作才行，还有很多事要做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160120
					],
					"speakerTitle": "沙尔梅"
				},
				{
					"id": 240160120,
					"content": "荣誉高级研究员，如果您愿意的话，能帮帮我吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160121,
						240160122
					],
					"speakerTitle": "沙尔梅"
				},
				{
					"id": 240160121,
					"content": "责无旁贷。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160124
					]
				},
				{
					"id": 240160124,
					"content": "那么就请您帮我去清理一下周围的污渍吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160125
					],
					"speakerTitle": "沙尔梅"
				},
				{
					"id": 240160125,
					"content": "清理的时候，还请您尽量<color=#00E1FFFF>不要碰到旁边那些卷宗</color>。要是它们被污损的话，就糟糕了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160126
					],
					"speakerTitle": "沙尔梅"
				},
				{
					"id": 240160126,
					"content": "那就拜托您啦，我还得继续在这里整理卷宗。唉，平时我怎么没觉得院里有这么多卷宗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "沙尔梅"
				},
				{
					"id": 240160122,
					"content": "就再给我的荣誉多添一笔吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160123
					]
				},
				{
					"id": 240160123,
					"content": "哈哈哈，没问题，我会给您的好心肠做证的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160124
					],
					"speakerTitle": "沙尔梅"
				},
				{
					"id": 240160117,
					"content": "总之，只要能拿到手就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160118
					]
				}
			]
		},
