			"dialogs": [
				{
					"id": 722111101,
					"content": "你好，欢迎光临「木南料亭」，请问你们有什么需要的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111102
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722111102,
					"content": "你好…哎呀，是神里小姐的朋友！快请进，有什么我可以帮你们的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111103
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722111103,
					"content": "关于寝子的饭…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722111104
					]
				},
				{
					"id": 722111104,
					"content": "「寝子」？这个名字，难不成是猫吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111105
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722111105,
					"content": "你认识寝子吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722111106,
					"content": "哎呀，不是。我只是觉得，这个名字很适合猫呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111107
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722111107,
					"content": "真是强大的直觉…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722111108
					]
				},
				{
					"id": 722111108,
					"content": "先不说这些，事情是这样的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722111109,
					"content": "清籁岛上…有一座浅濑神社，神社里有一只会说话的猫？！那只猫还拜托你们做一道菜给它？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111110
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722111110,
					"content": "欸？欸！真的吗？我从来都没听说过！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111111,
						722111112
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722111111,
					"content": "是、是真的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722111113
					]
				},
				{
					"id": 722111113,
					"content": "在清籁岛上对吧？等有机会，我一定要自己去看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111114
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722111114,
					"content": "那个…寝子的饭…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722111115
					]
				},
				{
					"id": 722111115,
					"content": "啊…对哦，差点忘了正事…我想想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111116
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722111116,
					"content": "唔…猫也会喜欢的饭吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111117
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722111117,
					"content": "很难吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722111118,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111119
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722111119,
					"content": "很、很难吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722111120
					]
				},
				{
					"id": 722111120,
					"content": "这是对「木南」家名的挑战！我一定要克服！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111121
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722111121,
					"content": "用鱼肉、兽肉、海草、稻米做出能让猫趋之若鹜的美食，就交给我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111122
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722111122,
					"content": "我、我也想吃！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111123,
						722111124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722111123,
					"content": "我也想吃…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722111125
					]
				},
				{
					"id": 722111125,
					"content": "没问题！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111126
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722111126,
					"content": "我先构思一下食谱，你们先帮我准备三份海草。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111127,
						722111129
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722111127,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722111128
					]
				},
				{
					"id": 722111128,
					"content": "那就拜托你们了，只要三份海草就好，找到之后就拿来给我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722111129,
					"content": "你已经知道怎么做了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722111130
					]
				},
				{
					"id": 722111130,
					"content": "有了一点想法，但还没有完全想好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111131
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722111131,
					"content": "你先去帮我找三份海草过来吧，拜托你们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722111124,
					"content": "那就交给你了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722111125
					]
				},
				{
					"id": 722111112,
					"content": "你可以自己过去看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111113
					],
					"speakerTitle": "木南杏奈"
				}
			]
		}
