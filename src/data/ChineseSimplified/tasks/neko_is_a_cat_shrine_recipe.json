			"dialogs": [
				{
					"id": 722110501,
					"content": "汝等已经把饭带给那些小家伙了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110502
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722110502,
					"content": "都吃得很开心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110503
					]
				},
				{
					"id": 722110503,
					"content": "是吗？那样就好了，喵喵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110504
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722110504,
					"content": "奴家已经很久没有吃过这样好吃的饭了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110505
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722110505,
					"content": "喵喵喵…虽然奴家现在也不需要吃饭、不需要喝水了，但饭的滋味，真是让奴家欲罢不能呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110506
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722110506,
					"content": "有个小家伙叫「阿饭」，就是因为奴家想要用世界上最好的东西给她起名。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110507
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722110507,
					"content": "阿响做的饭叫什么名字？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110508
					]
				},
				{
					"id": 722110508,
					"content": "名字？饭还能有名字？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110509
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722110509,
					"content": "这个饭叫「活力喵饭」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110510
					]
				},
				{
					"id": 722110510,
					"content": "名字好复杂。不过奴家不讨厌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110511
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722110511,
					"content": "…汝说得也对。毕竟，饭是好东西。好东西都应该有名字才对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110512
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722110512,
					"content": "喵喵，等阿响回来了，奴家再问她吧。然后，汝也可以做汝的饭给她吃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110513
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722110513,
					"content": "然后，她再做她的饭给汝吃。然后，奴家可以吃两种不同的，又都很好吃的饭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110514
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722110514,
					"content": "所以说，奴家得把神社打理得更好。等她回来了，就一起吃饭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110515
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722110515,
					"content": "谢谢。很好吃。喵喵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「寝子」"
				}
			]
		},
