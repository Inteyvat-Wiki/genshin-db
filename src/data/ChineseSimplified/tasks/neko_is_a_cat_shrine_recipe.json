						722110706
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722110706,
					"content": "总之，这份饭你们拿好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110707
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722110707,
					"content": "对了，食谱我也抄一份给你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110708
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722110708,
					"content": "#太好了，那{NICKNAME}也能随时给我做…做「喵饭」了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110709,
						722110712
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722110709,
					"content": "你是猫吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110710
					]
				},
				{
					"id": 722110710,
					"content": "真没礼貌！美食是全世界共通的，是我和寝子的共同语言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110711
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722110711,
					"content": "对了！要感谢木南小姐才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110713
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722110713,
					"content": "不用谢啦，这道饭和食谱，就当做给那位寝子的礼物啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110714
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722110714,
					"content": "等我有空了，一定会去那座「浅濑神社」拜访的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110715
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722110715,
					"content": "好了，你们快回去吧，别让寝子等急啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722110712,
					"content": "谢谢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110713
					]
				}
			]
		},
