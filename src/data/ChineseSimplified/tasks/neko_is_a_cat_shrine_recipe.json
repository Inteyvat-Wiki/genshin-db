			"trigger": {
				"objectNames": [
					"大祐",
					"悦子",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722110101,
					"content": "悦子小姐，我们接着去哪里探索？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110102
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722110102,
					"content": "呼…先歇一歇吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110103
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722110103,
					"content": "嗯？是你们啊，你们找我们有事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110104
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722110104,
					"content": "关于可靠的厨师…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110105
					]
				},
				{
					"id": 722110105,
					"content": "在清籁岛的地方找厨师？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110106
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722110106,
					"content": "事情是这样的。寝子她…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722110107,
					"content": "你说…寝子大人拜托你们帮忙准备食物吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110108
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722110108,
					"content": "啊…可恶！要是我有烹饪的才能就好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110109
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722110109,
					"content": "这么说，你们是想要找一个能帮你们搞明白…「怎么用这些食材，做出猫会喜欢的饭」的厨师，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110110
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722110110,
					"content": "我想想…厨师…厨师…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110111
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722110111,
					"content": "喔，你们不如去稻妻城，去找「木南料亭」的木南杏奈小姐吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110112
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722110112,
					"content": "木南小姐人很好，厨艺也很不错，应该能帮你们这个忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110113
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722110113,
					"content": "谢谢，我们这就去看看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110114
					]
				},
				{
					"id": 722110114,
					"content": "不用谢，快点去吧，我和大祐还要继续制订探索计划。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110115
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722110115,
					"content": "呵呵，希望这个神社真的可以热闹起来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110116
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722110116,
					"content": "这样，也不枉你和那位寝子忙前忙后这么长时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "悦子"
				}
			]
		},
		{
			"id": 7221102,
			"completionStepIds": [
				7221103
			],
