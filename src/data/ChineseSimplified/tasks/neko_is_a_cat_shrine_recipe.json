						722110402
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722110402,
					"content": "做好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110403
					]
				},
				{
					"id": 722110403,
					"content": "喵喵！真厉害，快给奴家尝尝看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110404
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722110404,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110405
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722110405,
					"content": "看起来，和阿响做的饭有些不一样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110406
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722110406,
					"content": "应、应该很好吃的，我们先一起尝尝看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722110407,
					"content": "真好吃！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722110408,
					"content": "……喵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110409
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722110409,
					"content": "（寝子是因为饭和「阿响」做得不一样，不开心吗…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722110410,
					"content": "很好吃，汝等，很可靠呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110411
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722110411,
					"content": "那就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110412
					]
				},
				{
					"id": 722110412,
					"content": "虽然，汝等做的饭，和阿响做的饭味道不一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110413
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722110413,
					"content": "但是，和汝等一起吃饭时的感觉，和之前奴家和阿响一起吃饭时的感觉，一模一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110414
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722110414,
					"content": "人类啊，这是为什么呢？汝等人类，难道会什么妖法不成？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110415,
						722110416
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722110415,
					"content": "很久没人给你做饭了吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110417
					]
				},
				{
					"id": 722110417,
					"content": "…无论如何，谢谢汝等。好久没吃过这样好吃的饭了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110418
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722110418,
					"content": "小家伙们肯定会喜欢的。汝再跑一趟，把这饭带给它们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110419
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722110419,
					"content": "既然奴家喜欢，那它们肯定会喜欢。然后，吃了这么好吃的饭，一定也会愿意听奴家的了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722110416,
					"content": "因为做的人很热心吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110417
					]
				}
			]
		},
