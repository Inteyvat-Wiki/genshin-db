			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"木南杏奈",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722110201,
					"content": "你好，欢迎光临「木南料亭」，请问你们有什么需要的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110203
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722110203,
					"content": "关于寝子的饭…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110204
					]
				},
				{
					"id": 722110204,
					"content": "「寝子」？这个名字，难不成是猫吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110205
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722110205,
					"content": "你认识寝子吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722110206,
					"content": "哎呀，不是。我只是觉得，这个名字很适合猫呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110207
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722110207,
					"content": "真是强大的直觉…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110208
					]
				},
				{
					"id": 722110208,
					"content": "先不说这些，事情是这样的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722110209,
					"content": "清籁岛上…有一座浅濑神社，神社里有一只会说话的猫？！那只猫还拜托你们做一道菜给它？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110210
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722110210,
					"content": "欸？欸！真的吗？我从来都没听说过！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110211,
						722110212
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722110211,
					"content": "是、是真的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110213
					]
				},
				{
					"id": 722110213,
					"content": "在清籁岛上对吧？等有机会，我一定要自己去看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110214
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722110214,
					"content": "那个…寝子的饭…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110215
					]
				},
				{
					"id": 722110215,
					"content": "啊…对哦，差点忘了正事…我想想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110216
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722110216,
					"content": "唔…猫也会喜欢的饭吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110217
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722110217,
					"content": "很难吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722110218,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110219
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722110219,
					"content": "很、很难吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110220
					]
				},
				{
					"id": 722110220,
					"content": "这是对「木南」家名的挑战！我一定要克服！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110221
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722110221,
					"content": "用鱼肉、兽肉、海草、稻米做出能让猫趋之若鹜的美食，就交给我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110222
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722110222,
					"content": "我、我也想吃！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110223,
						722110224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722110223,
					"content": "我也想吃…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110225
					]
				},
				{
					"id": 722110225,
					"content": "没问题！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110226
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722110226,
					"content": "我先构思一下食谱，你们先帮我准备三份海草。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110227,
						722110229
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722110227,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110228
					]
				},
				{
					"id": 722110228,
					"content": "那就拜托你们了，只要三份海草就好，找到之后就拿来给我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722110229,
					"content": "你已经知道怎么做了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110230
					]
				},
				{
					"id": 722110230,
					"content": "有了一点想法，但还没有完全想好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110231
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722110231,
					"content": "你先去帮我找三份海草过来吧，拜托你们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722110224,
					"content": "那就交给你了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110225
					]
				},
				{
					"id": 722110212,
					"content": "你可以自己过去看看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110213
					]
				}
			]
		},
