					"nextDialogs": [
						700150105
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 700150105,
					"content": "Ya tomo mani, mani yaya tome nye… Mi muhe du, du <color=#00E1FFFF>lata boya sada</color> si.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700150106
					],
					"speakerTitle": "丘丘人"
				},
				{
					"id": 700150106,
					"content": "它应该是想要什么东西…唔，我的手册上应该有记录，不如查一查吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
