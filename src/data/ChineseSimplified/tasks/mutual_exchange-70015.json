					"nextDialogs": [
						700150103
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 700150103,
					"content": "Tomo tomo. Tomo dala si? domu nye, ika nye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700150104
					],
					"speakerTitle": "丘丘人"
				},
				{
					"id": 700150104,
					"content": "Ye muhe dala? Mimi mani ye.",
