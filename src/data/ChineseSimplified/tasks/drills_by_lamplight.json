			"completionStepIds": [
				7154101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7154101",
							"2"
						],
						"stepId": 7154101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"明澜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715410101,
					"content": "不会真的是那位教头负责吧…唉，只能祝他们好运了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410102
					],
					"speakerTitle": "明澜"
				},
				{
					"id": 715410102,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715410103
					]
				},
				{
					"id": 715410103,
					"content": "#啊！？是…是你啊，{NICKNAME}，呼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410104
					],
					"speakerTitle": "明澜"
				},
				{
					"id": 715410104,
					"content": "吓我一跳，还以为是教头过来了。要是被听见，我可就又要被丢去拉练了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410105,
						715410106
					],
					"speakerTitle": "明澜"
				},
				{
					"id": 715410105,
					"content": "你们…现在还在训练？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715410107
					]
				},
				{
					"id": 715410107,
					"content": "哎呀，节日越大，我们越忙嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410108
					],
					"speakerTitle": "明澜"
				},
				{
					"id": 715410108,
					"content": "璃月港这么大，从五湖四海来的游客又这么多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410109
					],
					"speakerTitle": "明澜"
				},
				{
					"id": 715410109,
					"content": "为了维持秩序，和保护大家的人身安全，千岩军在城里野外都新设了不少流动岗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410110
					],
					"speakerTitle": "明澜"
				},
				{
					"id": 715410110,
					"content": "你知道流动岗吗？嗯…你就简单理解成一队走到哪，帮到哪的千岩军吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410111
					],
					"speakerTitle": "明澜"
				},
				{
					"id": 715410111,
					"content": "只要有人需要帮助，只要冲到那一队人面前求助，他们就会帮你的忙啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410112
					],
					"speakerTitle": "明澜"
				},
				{
					"id": 715410112,
					"content": "无论是遇到了危险，丢了东西，甚至是迷了路都可以去求助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410113
					],
					"speakerTitle": "明澜"
				},
				{
					"id": 715410113,
					"content": "不过嘛…因为需要覆盖的区域很广，所以我们教头把原本作为后备的预备队伍也拉出来整训。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410114
					],
					"speakerTitle": "明澜"
				},
				{
					"id": 715410114,
					"content": "但那群预备队都是新兵，没有接受过多少训练，所以教头说，干脆举办个临时演武会，好好提升一下他们的个人能力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410115
					],
					"speakerTitle": "明澜"
				},
				{
					"id": 715410115,
					"content": "我听说…那位教头下手可狠了，只要是经过他训练的人，只要听到他的名字都会不由自主地一哆嗦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410116
					],
					"speakerTitle": "明澜"
				},
				{
					"id": 715410116,
					"content": "你…也接受过？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715410117
					]
				},
				{
					"id": 715410117,
					"content": "算…算是吧。那位教头的训练确实很有效，就是事后一想起来…腿还是会有点发软。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410118
					],
					"speakerTitle": "明澜"
				},
				{
					"id": 715410118,
					"content": "你想去试试吗？我在训练的时候，听教头经常提起你的名字，说你不仅精于战阵，也很擅长搏击…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410119
					],
					"speakerTitle": "明澜"
				},
				{
					"id": 715410119,
					"content": "如果是你在演武场里，成绩一定比我们都好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410120,
						715410122
					],
					"speakerTitle": "明澜"
				},
				{
					"id": 715410120,
					"content": "我想去试试！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715410121
					]
				},
				{
					"id": 715410121,
					"content": "行。这胆气…真不愧是璃月的大英雄，那就请跟我来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "明澜"
				},
				{
					"id": 715410122,
					"content": "我再想想…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715410123
					]
				},
				{
					"id": 715410123,
					"content": "没事，你想去试试的话，就和我说吧。放心，你要是想参加演武，教头肯定高兴得很。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "明澜"
				},
				{
					"id": 715410106,
					"content": "现在不是海灯节吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715410107
					]
				}
			]
		}
	]
}