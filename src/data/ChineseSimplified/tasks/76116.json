			"dialogs": [
				{
					"id": 761160101,
					"content": "这不是我们和博比克的生死之交嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761160102,
						761160105,
						761160108,
						761160110
					],
					"speakerTitle": "安妮兹卡"
				},
				{
					"id": 761160102,
					"content": "关于你们两个…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761160103
					]
				},
				{
					"id": 761160103,
					"content": "我们会留在这里一段时间，毕竟把德兹斯拉沃的实验室大门破坏了。我们得守在附近，免得再被那些坏蛋们乘虚而入了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761160104
					],
					"speakerTitle": "安妮兹卡"
				},
				{
					"id": 761160104,
					"content": "等我们修好了门，或是小德回家了，大概就会跟你们一样，带着博比克一起出门旅行吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安妮兹卡"
				},
				{
					"id": 761160105,
					"content": "关于德兹斯拉沃…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761160106
					]
				},
				{
					"id": 761160106,
					"content": "完全没有头绪他会在哪里…要是你们在旅行的时候遇到他了的话，请替我们问好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761160107
					],
					"speakerTitle": "安妮兹卡"
				},
				{
					"id": 761160107,
					"content": "真想和他一起再到「旗舰」喝上整整一晚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安妮兹卡"
				},
				{
					"id": 761160108,
					"content": "关于博比克…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761160109
					]
				},
				{
					"id": 761160109,
					"content": "你想博比克啦？只要你有空，可以随时来找它玩哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安妮兹卡"
				},
				{
					"id": 761160110,
					"content": "再见了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761160111
					]
				},
				{
					"id": 761160111,
					"content": "嗯嗯，一定会再见的，毕竟我们是生死之交嘛！",
