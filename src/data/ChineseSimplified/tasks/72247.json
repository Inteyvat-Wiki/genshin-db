			},
			"dialogs": [
				{
					"id": 722470201,
					"content": "看来汝等的实力完全足以…护送供奉之物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470202
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722470202,
					"content": "这样，吾也能够放心了…一定要将之送到，如此才能…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470203
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722470203,
					"content": "如此才能什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722470204,
					"content": "如此才能…如此才能…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470205
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722470205,
					"content": "完了，完全是一副坏掉了的样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722470206,
					"content": "不过他说的供奉品，就是这个吧…看上去也有点破破烂烂了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7224703,
