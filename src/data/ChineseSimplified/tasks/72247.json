					"阿倍良久"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722470301,
					"content": "有、有什么东西出来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722470302,
					"content": "看上去好像也是一个残影。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722470303,
					"content": "吾乃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470304
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722470304,
					"content": "吾乃赫利俄斯之建造者，名曰：阿倍良久！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470305
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722470305,
					"content": "这句话我听懂了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722470306,
					"content": "这句话的意思就是——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722470307,
					"content": "他说自己的名字是赫利俄斯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470308,
						722470309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722470308,
					"content": "根本就没懂吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722470310
					]
				},
				{
					"id": 722470310,
					"content": "是这样吗……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722470311,
					"content": "他的名字叫阿倍良久…真是奇怪的名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722470312,
					"content": "不过，既然他的名字是阿倍良久，那赫利俄斯又是什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722470313,
					"content": "赫利俄斯！赫利俄斯！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470314
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722470314,
					"content": "此乃吾亲手所造…赫利俄斯造成之日，万丈光芒自高天笼罩，如是众人不受龙兽侵扰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470315
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722470315,
					"content": "啊啊，正当时，诸民仰视，热泪盈眶，扬臂欢呼，难掩喜悦激动之情…可是现在怎么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470316
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722470316,
					"content": "不对，吾，吾为何在此…为何…为何吾魂迷梦土，不得安宁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470317
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722470317,
					"content": "派蒙听懂了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722470318
					]
				},
				{
					"id": 722470318,
					"content": "我懂了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722470319,
					"content": "这一定是个…精神不太正常的残魂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722470320,
					"content": "吾想起来了…吾魂魄不全，等吾魂归一处，即可重获安宁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470321
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722470321,
					"content": "转机就在汝身，吾且与汝言说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470322
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722470322,
					"content": "呃，我闻到了麻烦事的气息…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722470323,
					"content": "此处本应供奉吾一部分骨殖，但是早已朽坏…算是吾托命于汝…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470324
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722470324,
					"content": "将这些寄托吾念的供奉品拿去…不过，周围有困守吾魂的怪物，一旦吾魂魄寄寓之物离开…便会蜂拥而上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470325
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722470325,
					"content": "此事凶险，旅者啊，若汝准备好了，再与吾说吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722470309,
					"content": "他的名字叫阿倍良久。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722470310
					]
				}
			]
		},
