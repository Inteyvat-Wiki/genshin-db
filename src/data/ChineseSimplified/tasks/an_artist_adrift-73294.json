						732941207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732941205,
					"content": "（看来感情很好。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941206
					]
				},
				{
					"id": 732941206,
					"content": "（这样能算是感情好吗？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941244
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732941244,
					"content": "那个…于连！你丢的东西我们都找回来了，话说「胡椒」应该就是你的动物同伴吧？为什么刚才骗我们说没有呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732941209,
					"content": "跟这种恩将仇报的家伙？我宁可跟兽境猎犬当同伴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941210
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732941210,
					"content": "那你们可能当不了多久同伴…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941211
					]
				},
				{
					"id": 732941211,
					"content": "对呀，像于连这样光是肚饿都会昏倒的普通人，遇到兽境猎犬就不是一个提瓦特煎蛋能解决的问题了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732941212,
					"content": "说起来，它刚才在沙滩边上好像守着画板呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941213,
						732941215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732941213,
					"content": "可能是想把画板藏起来…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941214
					]
				},
				{
					"id": 732941214,
					"content": "哇，坏狗狗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732941217,
					"content": "（发出抗议的吠叫。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941218
					],
					"speakerTitle": "狗"
				},
				{
					"id": 732941218,
					"content": "你这家伙还有脸叫唤呢？要不是因为跟着你到了这条绝路，起码我还能原路回枫丹…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941219
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732941219,
					"content": "嗯？你之前不是说是因为想看水路的风景才选水路回去的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732941220,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941221
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732941221,
					"content": "好吧，其实是根本没看到什么须弥的风景，就被这家伙给引路引到这里了。这附近的路弯弯绕绕，想不迷路都难呐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941222
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732941222,
					"content": "原来是这样。那完全可以一开始就跟我们讲实话嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732941223,
					"content": "呃…为了…为了身为知名画家的面子？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941224
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732941224,
					"content": "怎么感觉你每次吞吞吐吐的时候都是在编瞎话糊弄我们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732941225,
					"content": "#不过说到须弥的风景，我跟{NICKNAME}倒是知道一些风景很不错的地方呢，我们可以带你去呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732941226,
					"content": "不、不用了吧，我是说，感谢你们的好意，不过，呃…我怎么说也是知名画家，我相信真正值得画的风景应该自己去发现…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941227
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732941227,
					"content": "对了，茶已经泡好了，还是来喝茶吧。顺便，如果还有煎蛋的话，可以再来点吗？就当配茶的点心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941228,
						732941230
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732941228,
					"content": "为什么是煎蛋配茶…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941229
					]
				},
				{
					"id": 732941229,
					"content": "#对呀，{NICKNAME}拿手的料理可多了！咱们可以吃点别的，嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941232
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732941232,
					"content": "和点心一道，享用了于连泡好的茶。\\n有种难以言喻的味道…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732941233
					]
				},
				{
					"id": 732941233,
					"content": "这茶…唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941234
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732941234,
					"content": "嗯，是朋友卖给我的，据说有激发潜在智慧的效果。我觉得还挺好喝的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941235,
						732941237
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732941235,
					"content": "幸好我没有这样的朋友。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941236
					]
				},
				{
					"id": 732941236,
					"content": "为什么这样说？有朋友是好事，我这次来须弥也是受了朋友的指点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941240
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732941240,
					"content": "今天的事真是多谢两位了，虽然不知道我能够提供的这点报酬是否能令两位满意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941241
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732941241,
					"content": "没关系啦，倒是采风景点…真的不需要我们帮忙吗？感觉你会迷路欸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941242
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732941242,
					"content": "朝圣之路…咳，我是说，旅途的意义在于自己走过…这件事就不用再劳两位费心了，我能应付得来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941243
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732941243,
					"content": "既然你都这样说了…那好吧。记得不要再饿昏在路上了哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732941237,
					"content": "能再给我一杯吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941238
					]
				},
				{
					"id": 732941238,
					"content": "#{NICKNAME}，你的舌头没事吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941239
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732941239,
					"content": "哈哈，倒不是我吝啬，不过我还得在须弥待一阵子，多少得给自己留一点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941240
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732941230,
					"content": "你想得美哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941231
					]
				},
				{
					"id": 732941231,
					"content": "唔…不过光喝茶好像少了点什么，还是做点好吃的吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941232
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732941215,
					"content": "可能是保护画板不被抢走。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941216
					]
				},
				{
					"id": 732941216,
					"content": "不过被我们找到之后它很快就跑走了呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732941207,
					"content": "（也没闻到酒味啊…？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941208
					]
				},
				{
					"id": 732941208,
					"content": "（难道他平时就这样吗？唔…想想都觉得麻烦。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941244
					],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
