					"nextDialogs": [
						732941006
					]
				},
				{
					"id": 732941006,
					"content": "（发出狺狺的低吼。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941007
					],
					"speakerTitle": "狗"
