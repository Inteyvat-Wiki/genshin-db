					"于连"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732940101,
					"content": "唔唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940102
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732940102,
					"content": "#他看起来不怎么好的样子…肯定是饿坏了！{NICKNAME}，要不要分给他一些食物？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940103,
						732940105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732940103,
					"content": "希望美食能给他力量。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940104
					]
				},
				{
					"id": 732940104,
					"content": "#可不是因为我偏心才这么说，{NICKNAME}做的料理是真的很美味！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732940107,
					"content": "让倒地者吃下了提瓦特煎蛋。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732940108
					]
				},
				{
					"id": 732940108,
					"content": "重！重获新生啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940109
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732940109,
					"content": "哇…看来他是真的饿得不行了，只是一个煎蛋而已嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732940110,
					"content": "真是让人复活的美味呀…唉，早知道煎蛋这样美味，就该从那个家伙手里买下那枚神奇鸟蛋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940111
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732940111,
					"content": "什么神奇鸟蛋？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732940112,
					"content": "据说只要吃下它就能抵消掉一天的厄运，要是当时就买下那枚神奇鸟蛋…不，要是能买十二枚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940113
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732940113,
					"content": "唔…听起来好可疑，像是什么骗人的买卖。不过，你怎么一个人到这种地方来呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732940114,
					"content": "我是…呃…我是来须弥采风的枫丹知名画家。你们可以叫我于连。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940115,
						732940117
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732940115,
					"content": "到这种地方采风？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940116
					]
				},
				{
					"id": 732940116,
					"content": "应该有其他更适合采风的地方吧？比如说，风景更好，也更安全的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732940119,
					"content": "而且，如果真的是从枫丹来的画家，那怎么两手空空？啊…该不会你其实是愚人众的卧底吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732940120,
					"content": "好激进的推理！很难想象是怎样的经历让你做出这样激进的推理。但是，我的确是画家，只是个画家，其他的什么也不是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940121
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732940121,
					"content": "我只是，呃，其实我已经在这里得到了足够多的灵感，准备结束采风返回枫丹了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940122
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732940122,
					"content": "没想到须弥的气候这么干燥，来时经过的沉玉谷还比较湿润，进入须弥地界之后风沙就多了起来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940123
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732940123,
					"content": "说来惭愧，我还是比较习惯湿润气候，所以本想回程走水路体验一下不同的风景，结果筏子给冲散了，再加上我又不会游泳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940124
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732940124,
					"content": "那你在枫丹生活应该很不容易吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940125
					]
				},
				{
					"id": 732940125,
					"content": "确实是这样，不光是会不会水的问题，唉，算了。我在水边找了块能休息的地方，应该还有些没被泡烂的茶叶，为了表示感谢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940126
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732940126,
					"content": "你要请我们喝茶吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732940127,
					"content": "呃，当然…当然！为了报答煎蛋的恩情，请两位…不知两位该怎么称呼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940128
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732940128,
					"content": "对哦，差点忘了自我介绍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940129,
						732940130,
						732940132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732940129,
					"content": "#{NICKNAME}和派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940134
					]
				},
				{
					"id": 732940134,
					"content": "嗯，响亮的名字。总之，请你们喝茶。营地就在附近，很快就到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "于连"
				},
				{
					"id": 732940130,
					"content": "#正义的使者和{M#他的}{F#她的}扈从。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940131
					]
				},
				{
					"id": 732940131,
					"content": "#是{NICKNAME}和最好的伙伴——派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732940132,
					"content": "金灿灿和银闪闪。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940133
					]
				},
				{
					"id": 732940133,
					"content": "#是金灿灿的{NICKNAME}和银闪闪的派蒙哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732940117,
					"content": "怎么会有人自称「知名」啊？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940118
					]
				},
				{
					"id": 732940118,
					"content": "就是就是！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732940105,
					"content": "哈哈，他又不是派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940106
					]
				},
				{
					"id": 732940106,
					"content": "什么嘛！不管是谁，总会有那么一两次因为饿昏而两眼一黑倒在地上的经历吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940107
					],
					"speakerTitle": "派蒙"
				}
			]
		},
