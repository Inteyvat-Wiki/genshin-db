				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732941201,
					"content": "我们回来啦…哦！果然是于连的动物同伴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732941202,
					"content": "（发出威胁的声音。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941203
					],
					"speakerTitle": "狗"
				},
				{
					"id": 732941203,
					"content": "…好哇，「胡椒」你这家伙…还吼我，你也不想想是谁在养这个家！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941204
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732941204,
					"content": "（原来它也有名字啊！不过这人没事吧？怎么在跟狗吵架…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
