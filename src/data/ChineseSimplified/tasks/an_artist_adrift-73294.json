		{
			"id": 7329405,
			"completionStepIds": [
				7329405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7329405",
							"2"
						],
						"stepId": 7329405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"于连"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732940501,
					"content": "好简陋的营地！这还能算是营地吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732940502,
					"content": "可是这里风景还不错，走到沙滩边会感觉很开阔，比在枫丹的时候舒畅很多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940503
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732940503,
					"content": "你在枫丹究竟过着怎样的生活啊…和想象中的知名画家会过的生活很不一样呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732940504,
					"content": "其实我在枫丹的住处很小，呃，因为我不是个贪图虚名的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940505
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732940505,
					"content": "野外的冒险家营地都比这里豪华多了呢。欸？这是…你的动物同伴呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732940506,
					"content": "呃…我可没有什么动物同伴，这大概是之前来这里的冒险家之类的留下的吧。话说回来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940507
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732940507,
					"content": "我是很想拿出点好东西招待和报答两位的，但是不巧大部分行李都在筏子散架的时候掉进水里了，我又不会游泳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940508
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732940508,
					"content": "如果两位能帮我把遗失在水上的行李找回来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940509
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732940509,
					"content": "都泡水了这行李还能要吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940510
					]
				},
				{
					"id": 732940510,
					"content": "我姑且都小心打包好了，但是里边有些东西…唉，没了就没了吧，没关系，我还能再画…还能…再画…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940511
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732940511,
					"content": "#唔…感觉有点可怜…{NICKNAME}，我们就帮帮他吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940512
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732940512,
					"content": "在这种地方实在无人可以依靠了…只能拜托两位，我在这儿泡好茶等你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "于连"
				}
			]
		},
