					"nextDialogs": [
						732941003,
						732941005
					],
					"speakerTitle": "狗"
				},
				{
					"id": 732941003,
					"content": "看着挺聪明的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941004
					]
				},
				{
					"id": 732941004,
					"content": "（短吠了一声。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941007
					],
					"speakerTitle": "狗"
				},
				{
					"id": 732941007,
					"content": "对了，之前不是在于连的营地看到过食盆吗？该不会是它的吧！奇怪，为什么于连说自己没有动物同伴呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941008
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732941008,
					"content": "呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941009
					],
					"speakerTitle": "狗"
				},
				{
					"id": 732941009,
					"content": "狗往营地的方向跑去了…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732941010
					]
				},
				{
					"id": 732941010,
					"content": "它跑掉了…我们待会儿问问于连吧。不过现在…不知道这个沙堆下埋了什么，我们检查看看？",
