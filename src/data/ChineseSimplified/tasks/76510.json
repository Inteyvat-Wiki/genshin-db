			"dialogs": [
				{
					"id": 765100101,
					"content": "…这下总能证明，这不是什么秘密军事武器了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100102
					],
					"speakerTitle": "埃德勒"
				},
				{
					"id": 765100102,
					"content": "唔，确实，设计得再难一点就不算是过家家了，加油。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100103
					],
					"speakerTitle": "维斯菈娃"
				},
				{
					"id": 765100103,
					"content": "哇！又是一样可怕的气氛，紧张得像是要…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765100104,
					"content": "马上打起来了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100105
					]
				},
				{
					"id": 765100105,
					"content": "#是啊…趁{NICKNAME}也在，不如现在，我们公平地切磋切磋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100106
					],
					"speakerTitle": "维斯菈娃"
				},
				{
					"id": 765100106,
					"content": "唉，真不知道你哪来的执念？不会是因为上次随随便便被我打翻了吧！如果是这个原因，那就切磋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100107
					],
					"speakerTitle": "埃德勒"
				},
				{
					"id": 765100107,
					"content": "#{NICKNAME}，您就瞧好了，看看谁先认输！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100108
					],
					"speakerTitle": "埃德勒"
				},
				{
					"id": 765100108,
					"content": "哼，空会说大话可没用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100109,
						765100110
					],
					"speakerTitle": "维斯菈娃"
				},
				{
					"id": 765100109,
					"content": "埃德勒看起来更有力…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100111
					]
				},
				{
					"id": 765100111,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100112
					],
					"speakerTitle": "埃德勒"
				},
				{
					"id": 765100112,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100113
					],
					"speakerTitle": "维斯菈娃"
				},
				{
					"id": 765100113,
					"content": "……！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100114
					]
				},
				{
					"id": 765100114,
					"content": "呜哇哇！她们不是只是切磋一下吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765100115,
					"content": "你现在认输还来得及，我会给你三秒钟的时间…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100116
					],
					"speakerTitle": "埃德勒"
				},
				{
					"id": 765100116,
					"content": "三，二，一…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100117
					],
					"speakerTitle": "埃德勒"
				},
				{
					"id": 765100117,
					"content": "哇呜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765100118,
					"content": "一声金属的「咔哒」脆响后，一切都归于了平静…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						765100119
					]
				},
				{
					"id": 765100119,
					"content": "好了，小派蒙，可以睁眼了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100120
					],
					"speakerTitle": "埃德勒"
				},
				{
					"id": 765100120,
					"content": "看来，全场最紧张的人在这儿了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100121
					],
					"speakerTitle": "维斯菈娃"
				},
				{
					"id": 765100121,
					"content": "什、什么？维斯菈娃居然是好好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100122,
						765100123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765100122,
					"content": "埃德勒在吓唬维斯菈娃。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100124
					]
				},
				{
					"id": 765100124,
					"content": "是啊，我可不想出来一趟，还被关到外地的监狱里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100125
					],
					"speakerTitle": "埃德勒"
				},
				{
					"id": 765100125,
					"content": "只好强装大胆，虚张声势，好让她瞧瞧，我不是那种能随意拿捏的懦弱行商。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100126
					],
					"speakerTitle": "埃德勒"
				},
				{
					"id": 765100126,
					"content": "这样下次见面，她就不敢随随便便找我麻烦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100127
					],
					"speakerTitle": "埃德勒"
				},
				{
					"id": 765100127,
					"content": "#可是，{NICKNAME}你又是怎么看出来的！我看你完全不紧张。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100128,
						765100129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765100128,
					"content": "埃德勒的表情看起来很放松。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100130
					]
				},
				{
					"id": 765100130,
					"content": "您真敏锐。恐吓的确是最快让人认输的办法。可惜，走捷径总归是没那么容易的，朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100131
					],
					"speakerTitle": "维斯菈娃"
				},
				{
					"id": 765100131,
					"content": "#更何况，{NICKNAME}还在这呢…总之，现在我还好好地站着。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100132
					],
					"speakerTitle": "维斯菈娃"
				},
				{
					"id": 765100132,
					"content": "只是下次遇见的时候，希望有机会…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100133
					],
					"speakerTitle": "维斯菈娃"
				},
				{
					"id": 765100133,
					"content": "可别，小的可没这么多机会和您这位大人遇上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100134
					],
					"speakerTitle": "埃德勒"
				},
				{
					"id": 765100134,
					"content": "如果，下次碰面在你的执勤期内，你要对我做些什么，我也只好正当防卫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100135
					],
					"speakerTitle": "埃德勒"
				},
				{
					"id": 765100135,
					"content": "若又在你的休假期内碰上了，那还是来盘兵棋推演算了，就当是照顾照顾我的生意好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "埃德勒"
				},
				{
					"id": 765100129,
					"content": "埃德勒说了，是看「谁先认输」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100130
					]
				},
				{
					"id": 765100123,
					"content": "铳枪里没有子弹。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100124
					]
				},
				{
					"id": 765100110,
					"content": "维斯菈娃看起来更高大…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100111
					]
				}
			]
		}
	]
}