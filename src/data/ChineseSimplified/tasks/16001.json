			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"温迪"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2368.205,
							227.884,
							-843.246
						],
						"pointId": 13952
					},
					{
						"sceneId": 3,
						"position": [
							2361.06,
							223.99,
							-843.051
						],
						"pointId": 14458
					}
				]
			},
			"dialogs": [
				{
					"id": 160010301,
					"content": "#好久不见啊，{NICKNAME}和派蒙，还有童话世界来的小龙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010302
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 160010302,
					"content": "我从风中听到了你们呼唤我的声音，你们似乎被一道谜语难住了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010303
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 160010303,
					"content": "抱歉打扰到您了，巴巴托斯大人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010304
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 160010304,
					"content": "不要这么说，我本身对这个谜语也很感兴趣，给我看下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010305
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 160010305,
					"content": "嗯…哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010306
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 160010306,
					"content": "看出什么来了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 160010307,
					"content": "三个谜题与三段曲谱…这种说法让我想起了一些往事，你们想要的谜底应该就藏在这些往事里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010308
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 160010308,
					"content": "来找卖唱的果然没错！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 160010309,
					"content": "很多年前，那几位魔女来到蒙德，想要和我一较高下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010310
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 160010310,
					"content": "而我说，不要比武，让我们唱歌弹琴，用诗来结束纷争。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010311
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 160010311,
					"content": "我拨动竖琴，向她们吟唱了这首诗——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010312
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 160010312,
					"content": "「风儿，风儿，请代我迎客。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010313
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 160010313,
					"content": "「于青葱之间穿行吧，在那里，来去无踪的你也可以拥有形状，正好为我的客人演舞一场。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010314
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 160010314,
					"content": "「于云海之畔跃动吧，在那里，好事之徒都会被你的歌声吓阻，正好替我的客人隔绝扰攘。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010315
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 160010315,
					"content": "「于星辰之下飞翔吧，在那里，尘世的喧嚣都能被你涤荡一空，正好让我的客人倾诉畅想。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010316
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 160010316,
					"content": "「去那里吧，那是我许诺给客人的地方。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010317
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 160010317,
					"content": "「那里没有争斗和较量，只有茶杯和惬意的时光。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010318
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 160010318,
					"content": "三段曲谱我已经为你们演奏了一遍，至于那三个谜题的答案，想必你们已经能猜出来了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010319
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 160010319,
					"content": "…树林里，悬崖边，天上？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010320
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 160010320,
					"content": "回答正确！说起来，当年面对这个谜语，你的母亲也是最先猜出答案的人呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010321
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 160010321,
					"content": "书写故事的人和吟唱故事的人之间，似乎存在某种默契。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010322
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 160010322,
					"content": "树林里，悬崖边，天上…哦，是那里！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 160010323,
					"content": "这个答案指向的地点，应该就是你们接下来要去的地方了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010324
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 160010324,
					"content": "魔女们猜对了我的谜语，也接受了我的提议。之后，她们就选择那里作为聚会地点了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010325
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 160010325,
					"content": "根据这本书给出的提示，或许你们可以试试去那里演奏我给的曲谱？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010326
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 160010326,
					"content": "你正经的时候果然很靠谱啊，风神巴巴托斯大人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010327
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 160010327,
					"content": "谢谢您，巴巴托斯大人，我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010328
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 160010328,
					"content": "看上去，你还有想让我解答的问题？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010329
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 160010329,
					"content": "嗯…您作为吟游诗人，肯定阅读过不计其数的故事。您觉得，一个什么样的故事会被它的作者认为是未完成的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010330
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 160010330,
					"content": "这个啊，故事里还有尚未达成的心愿，抑或是…未完待续！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010331
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 160010331,
					"content": "啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010332
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 160010332,
					"content": "我刚刚才说过你很靠谱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010333
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 160010333,
					"content": "你想要的答案应该就在这个故事里面，那是你母亲留给你的故事，我不应该过问太多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010334
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 160010334,
					"content": "嗯…我们出发吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "杜林"
				}
			]
