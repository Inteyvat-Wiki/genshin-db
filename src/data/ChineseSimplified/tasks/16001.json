			"trigger": {
				"objectNames": [
					"杜林"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2256.417,
							230.083,
							-808.091
						],
						"pointId": 14073
					}
				]
			},
			"dialogs": [
				{
					"id": 160010201,
					"content": "你好啊，杜林，后续的提示有了吗？我们准备好进入下一个篇章了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 160010202,
					"content": "准备好了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160010203
					]
				},
				{
					"id": 160010203,
					"content": "后续的提示已经有了，我正要去找你们，先一起看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010204
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 160010204,
					"content": "风儿携着乐声飞来，让故事的种子得以发芽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010205
					],
					"speakerTitle": "魔女M"
				},
				{
					"id": 160010205,
					"content": "乐声也随着风儿远去，消失在遥远的过去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010206
					],
					"speakerTitle": "魔女M"
				},
				{
					"id": 160010206,
					"content": "去风与故事相遇的地方吧，将三个谜题写成诗，将三段曲谱连成歌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010207
					],
					"speakerTitle": "魔女M"
				},
				{
					"id": 160010207,
					"content": "乐声中的诗与歌，就是这个故事最初的绿芽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010208
					],
					"speakerTitle": "魔女M"
				},
				{
					"id": 160010208,
					"content": "这是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010209
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 160010209,
					"content": "又是一个谜语吗？书里的声音还提到了风和乐章什么的，那谜底会是什么啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 160010210,
					"content": "派蒙，该想起那个老熟人了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160010211
					]
				},
				{
					"id": 160010211,
					"content": "唔…哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 160010212,
					"content": "所以是怎么回事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010213
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 160010213,
					"content": "说到风啊，音乐啊，诗歌啊之类的，找那个卖唱的肯定能问出东西来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 160010214,
					"content": "派蒙是指巴巴托斯大人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010215
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 160010215,
					"content": "你知道？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160010216
					]
				},
				{
					"id": 160010216,
					"content": "我刚来到蒙德时，阿贝多就把我引见给巴巴托斯大人了。我这样的存在，肯定会吸引到他的关注。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010217
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 160010217,
					"content": "其实这样也好…话说回来，我们现在该去哪里找他？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 160010218,
					"content": "巴巴托斯大人应该听到了，我们跟着风走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010219
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 160010219,
					"content": "有时候我真的忘了他还是个神明…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 1600103,
