						160011702
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 160011702,
					"content": "是故事中的杜林吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160011703
					]
				},
				{
					"id": 160011703,
					"content": "你好啊，小杜林！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160011704
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 160011704,
					"content": "…没有反应，是睡得太熟了吗？这可是他的庆生会啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160011705
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 160011705,
					"content": "龙孩子诞生自故事女巫笔下的魔法，每当笔尖在书页上划动，龙孩子就会快乐地玩耍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160011706
					],
					"speakerTitle": "魔女M"
				},
				{
					"id": 160011706,
					"content": "但是故事女巫并非时时都有执笔书写的闲暇，这次参加女巫之间的聚会，她不得不暂时放下手中的笔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160011707
					],
					"speakerTitle": "魔女M"
				},
				{
					"id": 160011707,
					"content": "「龙孩子甜甜地睡去了」，这是她停笔前在书页上留下的话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160011708,
						160011709
					],
					"speakerTitle": "魔女M"
				},
				{
					"id": 160011708,
					"content": "所以，因为没时间…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160011710
					]
				},
				{
					"id": 160011710,
					"content": "这种解释有些敷衍哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160011711
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 160011711,
					"content": "说起来有些奇怪，我印象中并没有参加过魔女阿姨们的聚会，这个庆生会是什么时候…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160011712
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 160011712,
					"content": "恐怕你当时也在呼呼大睡，所以不记得。",
					"roleType": "TALK_ROLE_NPC",
