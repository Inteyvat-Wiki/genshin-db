				"points": []
			},
			"dialogs": [
				{
					"id": 400690501,
					"content": "呜呜…小蒙，璐璐…为什么不跟我玩？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿飞"
				}
			]
		},
		{
			"id": 4006906,
			"completionStepIds": [
				4006906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4006906",
							"2"
						],
						"stepId": 4006906,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"莫娜",
					"辛焱",
					"阿飞"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400690601,
					"content": "咦，那是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400690602,
					"content": "又是「门」，该不会又有那样的人了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690603
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400690603,
					"content": "小意思，放着我来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690604
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400690604,
					"content": "大姐姐，你的发型好奇怪哟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690605
					],
					"speakerTitle": "阿飞"
				},
				{
					"id": 400690605,
					"content": "是吗？我觉得很酷啊，你再好好看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690606
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400690606,
					"content": "竖起来的辫子，尖尖的发饰，别人都不这样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690607
					],
					"speakerTitle": "阿飞"
				},
				{
					"id": 400690607,
					"content": "这话说得不对。我跟别人不一样，那你见了我就会印象深刻，怎么也忘不掉。以后见到我，还能认得我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690608
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400690608,
					"content": "嗯…对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690609
					],
					"speakerTitle": "阿飞"
				},
				{
					"id": 400690609,
					"content": "头发衣服，甚至脸皮身段，可不是只给别人看的。自己喜欢什么样，就打扮成什么样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690610
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400690610,
					"content": "真的吗？可我要是穿画着小狗的袍子，别人就会说：「阿飞像小狗」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690611
					],
					"speakerTitle": "阿飞"
				},
				{
					"id": 400690611,
					"content": "那你就不听他们的。你喜欢小狗对不对？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690612
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400690612,
					"content": "喜欢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690613
					],
					"speakerTitle": "阿飞"
				},
				{
					"id": 400690613,
					"content": "你朋友喜不喜欢小狗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690614
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400690614,
					"content": "也喜欢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690615
					],
					"speakerTitle": "阿飞"
				},
				{
					"id": 400690615,
					"content": "所以你的朋友肯定喜欢你那件袍子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690616
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400690616,
					"content": "…嗯。大姐姐，怎么不扎个讨人喜欢的辫子呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690617
					],
					"speakerTitle": "阿飞"
				},
				{
					"id": 400690617,
					"content": "没办法，我就喜欢这种有性格的。唉，扎这个之前，我也料不到大家这么不喜欢我的辫子啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690618
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400690618,
					"content": "那不改改吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690619
					],
					"speakerTitle": "阿飞"
				},
				{
					"id": 400690619,
					"content": "这种发型才符合我的音乐和生活。平日常见的那些都太普通了，不够精神，还妨碍我演出时摇头晃脑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690620
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400690620,
					"content": "不喜欢就不喜欢呗，不改了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690621
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400690621,
					"content": "那你的朋友也不喜欢吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690622
					],
					"speakerTitle": "阿飞"
				},
				{
					"id": 400690622,
					"content": "才不会。她们都说，我这辫子好看得很呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690623
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400690623,
					"content": "…朋友会帮你。真好。不像我的朋友…把我丢在这里。呜呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690624
					],
					"speakerTitle": "阿飞"
				},
				{
					"id": 400690624,
					"content": "哎呀怎么哭了！出什么事了？跟姐姐说说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690625
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400690625,
					"content": "璐璐和小蒙…不理我了，呜呜…说好今天约在码头，他们却一直不来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690626
					],
					"speakerTitle": "阿飞"
				},
				{
					"id": 400690626,
					"content": "小小年纪就学会放鸽子了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690627
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400690627,
					"content": "你待在这儿别乱跑，我去附近找找。找到了，就带他们来找你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690628
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400690628,
					"content": "…嗯！谢谢你，大姐姐。我再也不说你的辫子奇怪了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690629
					],
					"speakerTitle": "阿飞"
				},
				{
					"id": 400690629,
					"content": "哈，算你识相。那一会儿见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "辛焱"
				}
			]
		},
