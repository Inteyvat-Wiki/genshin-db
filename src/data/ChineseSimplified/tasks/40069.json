			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"璐璐",
					"阿飞",
					"小蒙",
					"枫原万叶",
					"辛焱",
					"莫娜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400690801,
					"content": "笨瓜笨瓜，我们给你准备惊喜呢，谁知道你都不来找我们，还、还哭了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690802
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 400690802,
					"content": "对不起，我是笨瓜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690803
					],
					"speakerTitle": "阿飞"
				},
				{
					"id": 400690803,
					"content": "不是啦！你不是笨瓜，是我们不好…不该吓唬你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690804
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 400690804,
					"content": "阿飞，今天是你生日，我们本来想给你个惊喜，让你吓一大跳，才故意躲着你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690805
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 400690805,
					"content": "咦？这是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690806
					],
					"speakerTitle": "阿飞"
				},
				{
					"id": 400690806,
					"content": "给你准备了很多莲蓬，好吃的。还有我和璐璐亲手写的祝福信…不能说我们字丑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690807
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 400690807,
					"content": "哼哼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690808
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 400690808,
					"content": "你们…嘿嘿，谢谢你们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690809
					],
					"speakerTitle": "阿飞"
				},
				{
					"id": 400690809,
					"content": "搞了半天是这么一回事呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690810
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400690810,
					"content": "虚惊一场。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690811
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400690811,
					"content": "朋友嘛，干出这种事也不奇怪。要是我朋友给我准备惊喜，我也会被吓一跳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690812
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400690812,
					"content": "是在暗示我们给你惊喜吗？好高明的话术…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690813
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400690813,
					"content": "欸？啊不是不是啦！我就是随口一说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690814
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400690814,
					"content": "我知道啦。我也是开玩笑，就想吓你一跳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690815
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400690815,
					"content": "啊…是我肚子饿了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690816
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400690816,
					"content": "声音未免太响了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400690817
					]
				},
				{
					"id": 400690817,
					"content": "确实快到饭点了，我想想…要不然，去我家吃饭吧？离这儿不远，一直走就到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690818
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400690818,
					"content": "幻境里也有家吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690819
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400690819,
					"content": "有啊。我刚看了，这条路和现实中一样，就通往我家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690820
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400690820,
					"content": "虽然是在幻境里，但不论是跟邻里意见不合，还是表演失败失望而归…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690821
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400690821,
					"content": "假如有什么非去不可的地方，我猜也就是那里了。因为…人嘛，总要回家的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "辛焱"
				}
			]
		},
		{
			"id": 4006911,
			"completionStepIds": [
				4006911
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
