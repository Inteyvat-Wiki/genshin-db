					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4006914",
							"2"
						],
						"stepId": 4006914,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"璐璐"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400691401,
					"content": "你好，你是璐璐吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691402
					],
					"speakerTitle": "辛焱"
				},
				{
