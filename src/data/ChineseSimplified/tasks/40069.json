				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"聆听"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400691101,
					"content": "那些鸟雀是喝过山顶的泉水，才能唱出悠扬的歌。你看咱家，从来就没人喜欢唱歌，你又怎么能唱得好呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691102
					],
					"speakerTitle": "辛焱的母亲"
				},
				{
					"id": 400691102,
					"content": "那我也去喝这种泉水就行了吧？妈妈，我出门一趟！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "辛焱"
				}
			]
		},
		{
			"id": 4006912,
			"completionStepIds": [
				4006912
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4006912",
							"2"
						],
						"stepId": 4006912,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"辛焱",
					"枫原万叶",
					"莫娜",
					"香菱",
					"云堇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400691201,
					"content": "到了到了，大家随意，进门不用换鞋！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691202
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400691202,
					"content": "抱歉打扰了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691203
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400691203,
					"content": "有椅子呢，正好可以坐一会儿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691204
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400691204,
					"content": "嗯？里面的屋子好像有声音…你们休息，我去看一眼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691205
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400691205,
					"content": "灯都没亮，没人在…哇啊？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691206
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400691206,
					"content": "噔噔噔！生日快乐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691207
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 400691207,
					"content": "你们干嘛啊！那么大两个人坐在屋里还不开灯，想吓死我呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691208
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400691208,
					"content": "云堇你说对了，她真的会被吓到！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691209
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 400691209,
					"content": "难得的生日，来点惊喜才好呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691210
					],
					"speakerTitle": "云堇"
				},
				{
					"id": 400691210,
					"content": "你们两个不要顶着可爱的脸做这种事行不行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691211
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400691211,
					"content": "哎？这话呀，我可是不爱听的。谁规定长得乖巧可爱就不能开恶作剧玩笑啦？是不是呀香菱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691212
					],
					"speakerTitle": "云堇"
				},
				{
					"id": 400691212,
					"content": "就是就是！锅巴长那样，不也很灵活嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691213
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 400691213,
					"content": "行行行，说不过你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691214
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400691214,
					"content": "北斗姐今天有事，托我们带话给你，她就不亲自过来啦，给你的礼物由我转交。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691215
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 400691215,
					"content": "来，这是北斗姐送你的外国乐谱和特制匕首！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691216
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 400691216,
					"content": "辛焱，我专程差家里人给你打了金发簪和铁发圈哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691217
					],
					"speakerTitle": "云堇"
				},
				{
					"id": 400691217,
					"content": "铁发圈？！你千年的打铁世家，就打这个？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691218
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400691218,
					"content": "怎么了？发圈这是麻雀虽小五脏俱全呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691219
					],
					"speakerTitle": "云堇"
				},
				{
					"id": 400691219,
					"content": "嘻嘻，我就不一样喽。不久前，我在路边看到个戴眼镜的铁匠，瞧他那样子，好像能看懂石头一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691220
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 400691220,
					"content": "我不信邪，请他帮我选石头，没想到真能开出翡翠来！嘿嘿，我当场拿去磨成吊坠大小，拿绳子串起来，给你当挂件用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691221
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 400691221,
					"content": "哇，你做了个翡翠吊坠给我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691222
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400691222,
					"content": "对呀，啊啊不是挂在脖子上的哦，挂琴上！天天看你宝贝你那把琴，我就想着，早晚也给它打扮起来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691223
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 400691223,
					"content": "这么宝贵的礼物我可不舍得用，得供起来！谢谢你香菱，你好细心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691224
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400691224,
					"content": "嘻嘻，香菱心细也不是一两天的事了。不过那人居然能看懂石头…你再说说这事。要是好玩，我得写进戏里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691225
					],
					"speakerTitle": "云堇"
				},
				{
					"id": 400691225,
					"content": "我也不晓得，听说他是病了一阵子，那期间浑浑噩噩的，什么都不记得，身体像是不属于自己一样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691226
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 400691226,
					"content": "再后来，砰地一下就好了！只是不知为什么，从那天起，看一眼就能分辨石头好坏了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691227
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 400691227,
					"content": "嗯…可真是怪事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691228
					],
					"speakerTitle": "云堇"
				},
				{
					"id": 400691228,
					"content": "噢噢，不说这些了，菜都要凉啦，开吃开吃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691229
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 400691229,
					"content": "且慢，辛焱，你不是从外国商人那里学了一招嘛？上回我生日时候，你教我的那个。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691230
					],
					"speakerTitle": "云堇"
				},
				{
					"id": 400691230,
					"content": "嗯？噢，你是说许生日愿望对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691231
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400691231,
					"content": "对对，就是那个。在外国还要点蜡烛切蛋糕，我们可没顾上这些，光忙着帮香菱把饭菜提过来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691232
					],
					"speakerTitle": "云堇"
				},
				{
					"id": 400691232,
					"content": "没事，我自己想像一下就有了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691233
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400691233,
					"content": "那我们数一二三，你来许愿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691234
					],
					"speakerTitle": "云堇"
				},
				{
					"id": 400691234,
					"content": "一——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691235
					],
					"speakerTitle": "云堇"
				},
				{
					"id": 400691235,
					"content": "二——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691236
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 400691236,
					"content": "三——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691237
					],
					"speakerTitle": "云堇"
				},
				{
					"id": 400691237,
					"content": "嗯~今年许个什么愿望好呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691238
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400691238,
					"content": "我的愿望是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "辛焱"
				}
			]
		},
		{
