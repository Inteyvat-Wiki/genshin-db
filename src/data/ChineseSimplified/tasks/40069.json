				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400691301,
					"content": "咦，回来了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691302
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400691302,
					"content": "怎么回事？我才刚凑到门缝里看了没多久啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400691303,
					"content": "既然是幻境，辛焱，你刚才在屋里遇到什么事了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691304
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400691304,
					"content": "我知道我知道，她见到了给她过生日的朋友！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400691305,
					"content": "那些我也听到了啦！我是说她自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691306
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400691306,
					"content": "我自己…啊！我许了个愿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691307
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400691307,
					"content": "说起来，这事也有点意思。我不是推门进去吗？屋里居然是香菱和云堇，我的两个好朋友！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691308,
						400691309
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400691308,
					"content": "认识认识。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400691310
					]
				},
				{
					"id": 400691310,
					"content": "这可是现实中发生过的事，上回生日，她俩跑我家给了我一个大惊喜，做了一桌好吃的，让我许生日愿望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691311
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400691311,
					"content": "辛焱，你的生日愿望是什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691312
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400691312,
					"content": "我的愿望是——「跟大家意想不到的人一起办演唱会」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691313
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400691313,
					"content": "意想不到的人，会是谁呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691314
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400691314,
					"content": "关于这件事，我在刚才一瞬间想通了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691315
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400691315,
					"content": "有答案了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691316
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400691316,
					"content": "嗯。不过，公布答案之前，我想先疏通那些贯穿山石的水脉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400691309,
					"content": "久仰久仰。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400691310
					]
				}
			]
		},
		{
			"id": 4006914,
			"completionStepIds": [
				4006914
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
