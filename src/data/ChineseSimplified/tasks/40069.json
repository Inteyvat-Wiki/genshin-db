			"dialogs": [
				{
					"id": 400690701,
					"content": "你好，你是小蒙吧？有个叫阿飞的孩子在码头上等你，等得太久，都哭了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690702
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400690702,
					"content": "啊！他、他怎么这么笨呀，都不知道来找我们…算了，我找他去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690703
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 400690703,
					"content": "跑掉了，我们快跟上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4006908,
			"completionStepIds": [
				4006908
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4006908",
							"2"
