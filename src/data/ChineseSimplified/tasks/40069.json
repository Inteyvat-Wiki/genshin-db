				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"莫娜",
					"枫原万叶",
					"辛焱"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400690301,
					"content": "哇啊我的帽子要掉了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690302
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400690302,
					"content": "嗯？这种气味…我们是在璃月附近的山上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690303
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400690303,
					"content": "可是这里好阴暗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400690304,
					"content": "等等。你们听…有声音。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "辛焱"
				}
			]
		},
		{
			"id": 4006904,
			"completionStepIds": [
				4006904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4006904",
							"2"
						],
						"stepId": 4006904,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"竹叔",
					"吉祥",
					"海伯",
					"莫娜",
					"枫原万叶",
					"辛焱"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400690401,
					"content": "我说辛焱啊，小姑娘家家，怎么又在玩那种粗鲁的乐器。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690402
					],
					"speakerTitle": "竹叔"
				},
				{
					"id": 400690402,
					"content": "辛焱呀，你妈妈说了，让我有空多教教你绣工。呵呵，这叫雅趣。什么时候到阿姨家里来？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690403
					],
					"speakerTitle": "吉祥"
				},
				{
					"id": 400690403,
					"content": "吵死了，别在路边弹琴啦！要是非弹不可，也弹点上得了台面的曲子行不行？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690404
					],
					"speakerTitle": "海伯"
				},
				{
					"id": 400690404,
					"content": "这、这说的都是什么话呀，根本不是人话吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400690405,
					"content": "唉，这些人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690406
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400690406,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690407
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400690407,
					"content": "啊——气死我了！你干嘛不骂回去呀，你的摇滚精神呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400690408,
					"content": "噗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690409
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400690409,
					"content": "都这样了，你还笑！不生气吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400690410,
					"content": "有些话听一次冒火气，听一百次可就气不起来了。不过还是谢谢你，派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690411
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400690411,
					"content": "欸…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400690412,
					"content": "吉祥阿姨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690413
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400690413,
					"content": "欸，阿姨等你回音呢。这个周末我刚好有空…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690414
					],
					"speakerTitle": "吉祥"
				},
				{
					"id": 400690414,
					"content": "阿姨，别光顾着我啦，你家炉子火没关，上头还炖着汤吧？唔…你看，都焦了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690415
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400690415,
					"content": "哎呀呀这怎么得了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690416
					],
					"speakerTitle": "吉祥"
				},
				{
					"id": 400690416,
					"content": "竹叔，小竹又在外头玩泥巴了，哎呀！你不是说了让他别这样吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690417
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400690417,
					"content": "啊？！这混小子，又背着我出去干这事！看我不给他一顿好打！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690418
					],
					"speakerTitle": "竹叔"
				},
				{
					"id": 400690418,
					"content": "嘻嘻…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690419
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400690419,
					"content": "海伯，对不住，我换个地方就是。不过您这听曲儿的品位，可得赶赶时髦喽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690420
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400690420,
					"content": "要知道，就连璃月港最有名的角儿，都喜欢听我这不上台面的曲子呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690421
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400690421,
					"content": "你说什么？还有这事？你…你可别骗我啊！…当真有这事？不成，我得出去问问。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690422
					],
					"speakerTitle": "海伯"
				},
				{
					"id": 400690422,
					"content": "消失了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690423
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400690423,
					"content": "你看，适当的话术，自然的笑容，就能解决大部分问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690424
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400690424,
					"content": "既然如此，摇滚精神又该用在什么地方？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690425
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400690425,
					"content": "我的摇滚精神可不是那么表面的东西，用来跟人吵架未免太浪费了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690426
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400690426,
					"content": "摇滚是革命！改革自我，改革命运，告别懦弱和退让。而且，不是在言语上，是在艺术里！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690427
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400690427,
					"content": "风雨中绝不熄灭的烛火，岩洞下永远沸腾的岩浆…无人可挡、无法停止的气魄，这才是我的摇滚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690428
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400690428,
					"content": "好了，走啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690429
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400690429,
					"content": "我看旁边有条小路，走那边吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "辛焱"
				}
			]
		},
		{
			"id": 4006905,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
