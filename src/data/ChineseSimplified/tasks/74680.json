	"talks": [
		{
			"id": 7468001,
			"completionStepIds": [
				7468001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7468001",
							"2"
						],
						"stepId": 7468001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"伊莲"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							3421.75,
							449.586,
							4453.235
						],
						"pointId": 340100476
					}
				]
			},
			"dialogs": [
				{
					"id": 746800101,
					"content": "「千灵映影节」…你做的好呀！干得漂亮！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800102
					],
					"speakerTitle": "伊莲"
				},
				{
					"id": 746800102,
					"content": "这样一来，想在截止日期前完成项目，根本就是痴人说梦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800103
					],
					"speakerTitle": "伊莲"
				},
				{
					"id": 746800103,
					"content": "呜呜呜…噫啊啊…这次老板不会痛骂我了…应该会直接干掉我吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800104
					],
					"speakerTitle": "伊莲"
				},
				{
					"id": 746800104,
					"content": "这位小姐怎么自顾自地哭起来了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746800105,
					"content": "我们需要帮她找位医生吗？不知道枫丹有没有专门治疗心情的医生？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746800106,
					"content": "唔姆…你们什么时候来的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800107
					],
					"speakerTitle": "伊莲"
				},
				{
					"id": 746800107,
					"content": "谢谢两位的关心，现在我更需要…能复活我即将死亡的职业生涯的医生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800108
					],
					"speakerTitle": "伊莲"
				},
				{
					"id": 746800108,
					"content": "这应该不属于医生的工作吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800109,
						746800111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746800109,
					"content": "不就是工作嘛！大不了换一个！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746800110
					]
				},
				{
					"id": 746800110,
					"content": "呀！换工作比死还折磨啊，所有熟悉的做事方法都不管用了，全都要重新学！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800113
					],
					"speakerTitle": "伊莲"
				},
				{
					"id": 746800113,
					"content": "这样聊下去也不是个办法，还是请你先说明一下吧，你现在遇见了什么困难？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746800114,
					"content": "有点难，这可是技术问题，我想想该怎么总结…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800115
					],
					"speakerTitle": "伊莲"
				},
				{
					"id": 746800115,
					"content": "简单来说，我是「千灵映影节」器材供应商的工程师伊莲，主要负责开发摄影器材。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800116
					],
					"speakerTitle": "伊莲"
				},
				{
					"id": 746800116,
					"content": "为了追求映影的效果，我们的甲方提出，需要一种能够载着映影机快速移动的「稳像平台」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800117
					],
					"speakerTitle": "伊莲"
				},
				{
					"id": 746800117,
					"content": "同时，这种「稳像平台」还需要搭载模仿演员的人偶或动物模型，扮演集群的远景。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800118
					],
					"speakerTitle": "伊莲"
				},
				{
					"id": 746800118,
					"content": "如此一来，他们就能在高速运动中稳定跟拍演员，或者省下雇佣大量演员的费用了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800119
					],
					"speakerTitle": "伊莲"
				},
				{
					"id": 746800119,
					"content": "而且，他们要求每个平台的采购价，不能高于一台留影机的三分之一，使用寿命不能低于三十年。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800120
					],
					"speakerTitle": "伊莲"
				},
				{
					"id": 746800120,
					"content": "哪有这么提要求的！就算是超级厉害的工匠，也不可能做出又便宜好用又耐用的道具吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746800121,
					"content": "我做完了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800122
					],
					"speakerTitle": "伊莲"
				},
				{
					"id": 746800122,
					"content": "毕竟甲方是不可忤逆之人，以前甲方提过更过分的需求，我也豁出半条命满足了他们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800123
					],
					"speakerTitle": "伊莲"
				},
				{
					"id": 746800123,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746800124
					]
				},
				{
					"id": 746800124,
					"content": "…那你在愁什么啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746800125,
					"content": "问题是我没有测试员！好不容易做出了产品，不经过全面检测，项目就不算完成！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800126
					],
					"speakerTitle": "伊莲"
				},
				{
					"id": 746800126,
					"content": "稍微懂一点机关原理，或是体力足够好的测试员，都被「千灵映影节」雇佣去检查更重要的东西了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800127
					],
					"speakerTitle": "伊莲"
				},
				{
					"id": 746800127,
					"content": "不经过测试的产品，交到甲方手里的话，要是被找出什么大问题，我还要倒赔钱，赔十倍！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800128
					],
					"speakerTitle": "伊莲"
				},
				{
					"id": 746800128,
					"content": "我只能在这里一边推销自家的产品，一边寻找外援…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800129
					],
					"speakerTitle": "伊莲"
				},
				{
					"id": 746800129,
					"content": "就算最后入不敷出也只能认了，毕竟和甲方的合同是老板签的，但要十倍赔钱的话，就是我个人来担责了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800130
					],
					"speakerTitle": "伊莲"
				},
				{
					"id": 746800130,
					"content": "事已至此，先说说测试内容…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746800131
					]
				},
				{
					"id": 746800131,
					"content": "#没错，如果不是特别困难的测试内容，说不定我和{NICKNAME}能替你做点简单的活。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746800132,
					"content": "听起来没什么难点，实践起来可不容易——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800133
					],
					"speakerTitle": "伊莲"
				},
				{
					"id": 746800133,
					"content": "为了确认「稳像平台」在极限速度下的运转情况，我将它们调成了「避开一切接近者」的被动运动模式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800134
					],
					"speakerTitle": "伊莲"
				},
				{
					"id": 746800134,
					"content": "测试员需要在特定场地内追逐「稳像平台」，尽可能在短时间内将更多平台驱赶至目标区域。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800135
					],
					"speakerTitle": "伊莲"
				},
				{
					"id": 746800135,
					"content": "像我这种体力差的人，稍微追着「稳像平台」跑两步，就完全没力气了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800136,
						746800137
					],
					"speakerTitle": "伊莲"
				},
				{
					"id": 746800136,
					"content": "这还不好办！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746800138
					]
				},
				{
					"id": 746800138,
					"content": "你这么一说，我们反而放心了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746800139,
					"content": "只不过是几个机关而已，看我们赶着它们呼呼跑，说不定还会被我们超过呢，测试极限什么的太简单了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800140
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746800140,
					"content": "当真？当真？你们认真的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800141
					],
					"speakerTitle": "伊莲"
				},
				{
					"id": 746800141,
					"content": "那我我我，我给你们钱！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800142
					],
					"speakerTitle": "伊莲"
				},
				{
					"id": 746800142,
					"content": "啊呀，辛苦费…我们也不会拒绝！不过，要是在这种情况下收你太多钱，我们的良心也会抗议的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800143
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746800143,
					"content": "你按照正常支付给测试员的费用，给我们适当的摩拉就行了哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800144
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746800144,
					"content": "神医！您们就是能让我即将死亡的职业生涯复活的神医！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800145
					],
					"speakerTitle": "伊莲"
				},
				{
					"id": 746800145,
					"content": "测试场就在城区附近的一座无人秘境中，那，那就交给您们两位了！我伊莲感激不尽！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800146
					],
					"speakerTitle": "伊莲"
				},
				{
					"id": 746800146,
					"content": "从业这么多年，终于走运了一回！明天我不用被老板干掉了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800147
					],
					"speakerTitle": "伊莲"
				},
				{
					"id": 746800147,
					"content": "呃啊…干完这一单以后，还是建议你换个老板比较好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746800137,
					"content": "不就是跑步！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746800138
					]
				},
				{
					"id": 746800111,
					"content": "工作很重要，我们要不帮帮忙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746800112
					]
				},
				{
					"id": 746800112,
					"content": "听她说得这么夸张，确实不能再袖手旁观了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800113
					],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}