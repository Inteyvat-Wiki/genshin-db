			},
			"dialogs": [
				{
					"id": 120190101,
					"content": "怎么了，还想聊点什么吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190102,
						120190105,
						120190109,
						120190113
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120190102,
					"content": "关于「团子牛奶」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120190103
					]
				},
				{
					"id": 120190103,
					"content": "她绝对特别喜欢那个饮料，心里估计都乐开花了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190104
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120190104,
					"content": "她的潜台词就是，「快，把这个铺子开到我的『一心净土』里去！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190101
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120190105,
					"content": "关于「雷电将军」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120190106
					]
				},
				{
					"id": 120190106,
					"content": "那个人偶是吧，修改人偶的规则很困难，这个我也听说过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190107
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120190107,
					"content": "这种困难可能是史无前例的，你们可以想象一下，能让神武英明的影也感到困难的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190108
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120190108,
					"content": "「无想的一刀」也不能解决的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190101
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120190109,
					"content": "关于「轻小说」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120190110
					]
				},
				{
					"id": 120190110,
					"content": "转生成为雷电将军，不是很有趣的想法吗？轻小说只要有趣就够了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190111
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120190111,
					"content": "但对她来说，嗯，有点太前卫了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190112
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120190112,
					"content": "唔，下次要不要以「转生为八重宫司」为题材征稿呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190101
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120190113,
					"content": "没什么了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		}
	]
}