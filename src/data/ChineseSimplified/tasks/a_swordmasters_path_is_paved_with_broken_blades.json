				"points": []
			},
			"dialogs": [
				{
					"id": 20060501,
					"content": "什么？你说师父他不是中邪？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060502
					],
					"speakerTitle": "菜菜子"
				},
				{
					"id": 20060502,
					"content": "难道师父是自己疯掉的？这怎么可能…我不信，这里面一定有问题！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060503
					],
					"speakerTitle": "菜菜子"
				},
				{
					"id": 20060503,
					"content": "师妹，别激动…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060504
					],
					"speakerTitle": "纯也"
				},
				{
					"id": 20060504,
					"content": "抱歉，以我的能力，确实看不出土门先生被附身了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060505
					],
					"speakerTitle": "稻城萤美"
				},
				{
					"id": 20060505,
					"content": "不过，这世上的邪祟千奇百怪，有很多我也未曾见过，倒也确实不能妄下定论。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060506
					],
					"speakerTitle": "稻城萤美"
				},
				{
					"id": 20060506,
					"content": "而且，事情未必没有转机。刚刚我得到消息，八重大人似乎有兴趣见一见你们的师父。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060507
					],
					"speakerTitle": "稻城萤美"
				},
				{
					"id": 20060507,
					"content": "八、八重大人？是我理解的那位八重大人吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060508
					],
					"speakerTitle": "纯也"
				},
				{
					"id": 20060508,
					"content": "「鸣神大社」的大巫女…八重大人？太好了，这下师父一定会没事的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060509
					],
					"speakerTitle": "菜菜子"
				},
				{
					"id": 20060509,
					"content": "没错，八重大人博古通今，亲手祓除过无数灾厄与邪祟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060510
					],
					"speakerTitle": "稻城萤美"
				},
				{
					"id": 20060510,
					"content": "你们的师父到底是不是被邪祟附身，我无法确定，但八重大人可以给出准确的答案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060511
					],
					"speakerTitle": "稻城萤美"
				},
				{
					"id": 20060511,
					"content": "请问巫女大人，我们面见八重大人，需要做什么准备吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060512
					],
					"speakerTitle": "纯也"
				},
				{
					"id": 20060512,
					"content": "不需要。唯一的要求，就是准时抵达「鸣神大社」，八重大人不喜欢无意义的等待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060513
					],
					"speakerTitle": "稻城萤美"
				},
				{
					"id": 20060513,
					"content": "我先走了，之后「鸣神大社」再见。祝土门先生早日恢复如常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060514
					],
					"speakerTitle": "稻城萤美"
				},
				{
					"id": 20060514,
					"content": "没想到八重大人竟然会注意到我们的师父…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060515
					],
					"speakerTitle": "纯也"
				},
				{
					"id": 20060515,
					"content": "师兄是觉得师父名气不大，不值得八重大人关注吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060516
					],
					"speakerTitle": "菜菜子"
				},
				{
					"id": 20060516,
					"content": "没有没有，绝对没有！师妹你误会了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060517
					],
					"speakerTitle": "纯也"
				},
				{
					"id": 20060517,
					"content": "只是，那可是八重大人啊！传闻中能跟将军大人关系密切的大巫女…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060518
					],
					"speakerTitle": "纯也"
				},
				{
					"id": 20060518,
					"content": "咳。总之，明天你也一起来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060519
					],
					"speakerTitle": "纯也"
				},
				{
					"id": 20060519,
					"content": "你千里迢迢地跑过来拜师，不论如何，我们「明镜止水流」也会给你一个结果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060520
					],
					"speakerTitle": "纯也"
				},
				{
					"id": 20060520,
					"content": "我会来的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20060521
					]
				},
				{
					"id": 20060521,
					"content": "是呀，我们也很好奇，那位「八重大人」到底是什么人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060522
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20060522,
					"content": "通过她，说不定也能打听到一些关于雷电将军的消息…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 200606,
			"completionStepIds": [
				200607
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
