				"objectNames": [
					"八重神子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20060601,
					"content": "那、那位就是「八重大人」吗…和纯也说的一样，好强的气场啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20060602,
					"content": "而且，她刚刚是不是往我们这边看了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060603
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20060603,
					"content": "也可能是我看错了…我们和她应该是第一次见面吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20060604,
					"content": "不要过来…不要再靠近我了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060605
					],
					"speakerTitle": "土门"
				},
				{
					"id": 20060605,
					"content": "我已经不练剑了，求求你们放过我吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060606
					],
					"speakerTitle": "土门"
				},
				{
					"id": 20060606,
					"content": "如您所见，八重大人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060607
					],
					"speakerTitle": "稻城萤美"
				},
				{
					"id": 20060607,
					"content": "土门先生一直都是这个状态。他似乎能看到曾经输给他的人，如今正围在他身旁破口大骂，让他感到非常痛苦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060608
					],
					"speakerTitle": "稻城萤美"
				},
				{
					"id": 20060608,
					"content": "八重大人，我师父他…是被邪祟附身了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060609
					],
					"speakerTitle": "菜菜子"
				},
				{
					"id": 20060609,
					"content": "师父他以前完全不是这个样子的…师父他曾经，无论发生什么都是笑着的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060610
					],
					"speakerTitle": "菜菜子"
				},
				{
					"id": 20060610,
					"content": "…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060611
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20060611,
					"content": "很遗憾。你师父身上，并没有什么邪祟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060612
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20060612,
					"content": "怎么会…那师父他…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060613
					],
					"speakerTitle": "菜菜子"
				},
				{
					"id": 20060613,
					"content": "没错，他是自己变成这个样子的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060614
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20060614,
					"content": "因为承受不住巨大的压力，内心出现了崩溃。心智受损，而后变得疯癫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060615
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20060615,
					"content": "就像落水的人一样，手忙脚乱地挣扎，还是坠入冰冷黑暗的深海。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060616
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20060616,
					"content": "至于「诱因」，我想应该是失去神之眼吧。被夺走了神之眼，也就意味着被夺走了「愿望」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060617
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20060617,
					"content": "「愿望」…可是八重大人，如果只是被剥夺了愿望，师父不应该变成普通人吗？为什么会疯掉呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060618
					],
					"speakerTitle": "纯也"
				},
				{
					"id": 20060618,
					"content": "你们的宗派，叫做「明镜止水流」，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060619
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20060619,
					"content": "名字是好名字，可是这世间啊，哪里有真正的「明镜止水」呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060620
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20060620,
					"content": "自称淡泊名利的人，被师弟击败后也会愤然离场。年迈的剑道家依旧心怀不平，想与自己教出来的弟子再比试一番。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060621
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20060621,
					"content": "那么看似心无杂念的人，在亲手击败自己的师父与师兄时，又是否真的毫无波澜？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060622
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20060622,
					"content": "八重大人的意思是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060623
					],
					"speakerTitle": "菜菜子"
				},
				{
					"id": 20060623,
					"content": "剑之一道，千变万化。想要夺取剑道的天下第一，对凡人来说谈何容易。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060624
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20060624,
					"content": "需要双手执剑，不断地击碎他人的梦想。这其中，也包括与他至亲至近之人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060625
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20060625,
					"content": "所以，唯有对「成为天下第一」的愿望心怀执着，他才能将痛苦暂时抛在脑后，继续向前。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060626
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20060626,
					"content": "当这个愿望消失的时候，他就会开始自我怀疑，在恐惧中挣扎，变成现在这副样子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060627
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20060627,
					"content": "呵呵，就好像我那位不成器的朋友一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060628
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20060628,
					"content": "原来，师父一直在承受这样的痛苦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060629
					],
					"speakerTitle": "菜菜子"
				},
				{
					"id": 20060629,
					"content": "对不起，都是我的错…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060630
					],
					"speakerTitle": "土门"
				},
				{
					"id": 20060630,
					"content": "父亲、师父、师兄…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060631
					],
					"speakerTitle": "土门"
				},
				{
					"id": 20060631,
					"content": "够了！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060632
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060632,
					"content": "欸？这不是我们之前遇到的，土门先生的师兄吗？他怎么来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060633
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20060633,
					"content": "是跟着我们，偷偷找到这里来的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060634
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20060634,
					"content": "安西…为什么会有两个安西…你到底是人是鬼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060635
					],
					"speakerTitle": "土门"
				},
				{
					"id": 20060635,
					"content": "你是来找我报仇的对吧…我知道…当初我不该…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060636
					],
					"speakerTitle": "土门"
				},
				{
					"id": 20060636,
					"content": "我对你确实没什么好感。但，我也不想听你的道歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060637
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060637,
					"content": "这么多年过去，我早就已经想通了。当初你没有做错什么，是我自己…是我自己抹不开面子，逃出了师门。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060638
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060638,
					"content": "我相信绝大部分被你击败的人，都没有责怪过你。相反，我们会将自己的愿望寄托给你，希望你可以走得更远。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060639
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060639,
					"content": "我知道，你的愿望已经被夺走了，所以你无法再回应我们的期待…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060640
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060640,
					"content": "但你不该夺走他们的愿望！「不停磨练剑道，成为天下第一」，这不是你教给他们的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060641
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060641,
					"content": "可是，说不定有一天，他们也会像我一样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060642
					],
					"speakerTitle": "土门"
				},
				{
					"id": 20060642,
					"content": "靠着一腔血勇，追逐天下第一，说不定一开始就是错误的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060643
					],
					"speakerTitle": "土门"
				},
				{
					"id": 20060643,
					"content": "如果有一天，他们也会变成我这个样子，我倒宁可他们一直停在那里，不要再往前走了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060644
					],
					"speakerTitle": "土门"
				},
				{
					"id": 20060644,
					"content": "…你有问过他们的想法吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060645
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060645,
					"content": "师父…当初师父把我从海盗手里救下来，我就决定此生要追随师父的脚步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060646
					],
					"speakerTitle": "菜菜子"
				},
				{
					"id": 20060646,
					"content": "我不知道自己将来，会不会像师父一样感到痛苦。但我知道，现在的我，还不想停下脚步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060647
					],
					"speakerTitle": "菜菜子"
				},
				{
					"id": 20060647,
					"content": "我想有一天，能够堂堂正正地挺起胸膛，告诉所有人，我是师父的弟子，是「明镜止水流」的传承者！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060648
					],
					"speakerTitle": "菜菜子"
				},
				{
					"id": 20060648,
					"content": "不光是师妹啦…我们大家，其实都是这么想的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060649
					],
					"speakerTitle": "纯也"
				},
				{
					"id": 20060649,
					"content": "你们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060650
					],
					"speakerTitle": "土门"
				},
				{
					"id": 20060650,
					"content": "看吧…你其实，可以把愿望托付给他们的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060651
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060651,
					"content": "「愿望被夺走」这种事，我没有经历过，也不懂。但当初被你轻松击败的时候，我也感受过愿望破裂的声音。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060652
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060652,
					"content": "但…就像我把自己的愿望托付给你一样，你也可以把愿望寄托在他们的身上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060653
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060653,
					"content": "你和我不同，当初我离开的时候一无所有，但至少你还有这么多优秀的弟子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060654
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060654,
					"content": "…我明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060655
					],
					"speakerTitle": "土门"
				},
				{
					"id": 20060655,
					"content": "抱歉，作为「明镜止水流」的宗家，让你们担心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060656
					],
					"speakerTitle": "土门"
				},
				{
					"id": 20060656,
					"content": "现在的我，对成为天下第一已无执着…内心的空虚与痛苦无法消解，很难再做到「心无杂念」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060671
					],
					"speakerTitle": "土门"
				},
				{
					"id": 20060671,
					"content": "但我作为你们的师父，仍然会把我毕生所学，尽数教给你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060657
					],
					"speakerTitle": "土门"
				},
				{
					"id": 20060657,
					"content": "这一点，请师兄监督。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060658
					],
					"speakerTitle": "土门"
				},
				{
					"id": 20060658,
					"content": "我自然会监督，不然谁知道你小子会不会哪天又疯了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060672
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060672,
					"content": "不过我已经习惯了闲云野鹤的生活，就不留在道场了。偶尔去你那溜达一圈，看看你有没有在偷懒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060659
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060659,
					"content": "愣着干什么，谢过八重大人，然后回家吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060660
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060660,
					"content": "嗯嗯，被夺走的愿望，就交给弟子们去继承…也算是顺利解决了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060661
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20060661,
					"content": "嗯，姑且算是告一段落了吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20060662
					]
				},
				{
					"id": 20060662,
					"content": "旅行者，请留步，八重大人有话想对你说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060663
					],
					"speakerTitle": "稻城萤美"
				},
				{
					"id": 20060663,
					"content": "…果然，并不是我的错觉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060664
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20060664,
					"content": "来自异乡的风，将为这片海域吹来新的生机…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060665
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20060665,
					"content": "我们的相遇，有些为时过早。但你踏上这片岛屿的时机，却刚刚合适。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060670
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20060670,
					"content": "…为了不辜负我的期待而努力吧，小家伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060666
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20060666,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20060667
					]
				},
				{
					"id": 20060667,
					"content": "嗯？那位八重大人，好像对你很感兴趣呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060668
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20060668,
					"content": "真是玄妙莫测的人，她的话又有什么深意呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060669
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20060669,
					"content": "唔还是下次再说，现在我们还是赶紧回去，向神里小姐汇报吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
