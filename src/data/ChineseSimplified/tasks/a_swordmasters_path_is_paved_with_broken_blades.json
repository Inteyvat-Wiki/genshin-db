			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"？？？",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20060401,
					"content": "你们…你们怎么跑得这么快…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060402
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060402,
					"content": "你们真的是土门的徒弟吗？怎么感觉速度比土门还快…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060403
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060403,
					"content": "还是说几年不见，土门的身法又精进了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060404
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060404,
					"content": "喂！现在应该我们问你吧，你到底是谁？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20060405,
					"content": "鬼鬼祟祟的，看上去就不像好人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20060406,
					"content": "不像好人？哼，当初我和土门一起学剑的时候，你们还不知道在哪呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060407
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060407,
					"content": "虽然已经不想再提起那段往事，但真要说起来，土门还得叫我一声师兄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060408
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060408,
					"content": "师兄？难道说你就是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20060409,
					"content": "没错，我就是安西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060410
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060410,
					"content": "那你为什么要跑？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20060411
					]
				},
				{
					"id": 20060411,
					"content": "…因为我不想再见到土门，也不想再见到跟他有关的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060412
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060412,
					"content": "当初，我与他一同学习「明镜止水流」，师从同一位剑道家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060413
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060413,
					"content": "我比他早五年拜入师门，是所有人眼中沉稳可靠的师兄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060414
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060414,
					"content": "明镜止水流追求「心无杂念」，所以绝大部分弟子都淡泊名利，我也不例外。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060430
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060430,
					"content": "但土门不一样，他拜入师门第一件事，就是笑着问师父，「如何才能成为天下第一」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060415
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060415,
					"content": "师父当时训斥了他，说剑道不是用来争夺虚名的。练剑几天就奢求最强之名，说明他内心浮躁，永远也学不好剑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060416
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060416,
					"content": "当时，我也是这么认为的…但后来，土门的剑术成长飞快，甚至逐渐追上了我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060417
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060417,
					"content": "那时候，我才意识到，土门其实早就已经做到了「心无杂念」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060418
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060418,
					"content": "他的内心中只有「成为天下第一」这一件事。他追求的是剑道的极致，无论遇到多少挫折，他都能重新振作起来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060419
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060419,
					"content": "感觉是一个很厉害的人…但为什么你不想再见到他呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060420
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20060420,
					"content": "因为在他到来之前，我曾对继承「明镜止水流」志在必得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060431
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060431,
					"content": "毕竟在师父的众多弟子中，我天赋最好，练剑时间最长，背负着所有人的期望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060421
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060421,
					"content": "但是他的到来改变了这一切。我在与他的比试中落败，丢尽了脸面与地位，从师门中落荒而逃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060422
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060422,
					"content": "后来听说，他又去找师父比试，而师父年事已高，在那场比试中耗尽了最后的元气…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060423
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060423,
					"content": "那之后，我再也不想跟他有任何交集。可扪心自问，我还是认可他的剑术，认可他追求剑道的心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060424
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060424,
					"content": "所以听到他疯了的消息时，我的第一反应就是假的。他怎么可能会疯呢？他是将「明镜止水」贯彻到极致的人啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060425
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060425,
					"content": "所以我想悄悄过来，看看他是不是真的疯了。但我没想到，他还会叫我的名字…我还以为他早就忘了我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060426
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060426,
					"content": "总之，我没有害他的想法，只是想来确认一下而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060427
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060427,
					"content": "回去吧，我的话说完了，驱邪仪式…估计也要结束了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060428
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060428,
					"content": "嗯…看来他并不是想破坏「驱邪仪式」呢，是我们误会他了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060429
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20060429,
					"content": "不过，也不知道应不应该带他回去…我们还是先去看看「驱邪仪式」进行的怎么样了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
