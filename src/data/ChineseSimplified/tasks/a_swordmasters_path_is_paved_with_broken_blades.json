					"菜菜子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20060101,
					"content": "第三位失去「神之眼」的人，好像是附近很有名的剑道家呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20060102,
					"content": "听说他是「明镜止水流」的现任掌门，感觉很厉害的样子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20060103,
					"content": "这里就是他的剑道馆了，正好有人在那里，我们过去问问吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20060104,
					"content": "师妹，不要太伤心了，师父一定会没事的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060105
					],
					"speakerTitle": "纯也"
				},
				{
					"id": 20060105,
					"content": "以前那些来踢馆的家伙，不管他们有多强，最后不是都被师父打跑了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060106
					],
					"speakerTitle": "纯也"
				},
				{
					"id": 20060106,
					"content": "但我还是有些担心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060107
					],
					"speakerTitle": "菜菜子"
				},
				{
					"id": 20060107,
					"content": "因为以前，不管局面多么危险，师父都不曾动摇过。但现在…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060108
					],
					"speakerTitle": "菜菜子"
				},
				{
					"id": 20060108,
					"content": "那是因为师父中邪了！等这次驱邪仪式之后，师父一定会顺利康复的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060109
					],
					"speakerTitle": "纯也"
				},
				{
					"id": 20060109,
					"content": "那个，发生什么事了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20060110,
					"content": "…你们是谁？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060111
					],
					"speakerTitle": "纯也"
				},
				{
					"id": 20060111,
					"content": "不管是闲杂人等，还是想趁师父中邪过来闹事的家伙，都给我闪开！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060112
					],
					"speakerTitle": "纯也"
				},
				{
					"id": 20060112,
					"content": "不然，别怪我手里的剑不客气！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060113
					],
					"speakerTitle": "纯也"
				},
				{
					"id": 20060113,
					"content": "不是啦，其实我们是来…嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20060114,
					"content": "我们是来拜师的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20060115
					]
				},
				{
					"id": 20060115,
					"content": "拜师？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060116
					],
					"speakerTitle": "纯也"
				},
				{
					"id": 20060116,
					"content": "对对对，我们听说「明镜止水流」的掌门非常厉害，所以特地从很远的地方赶过来拜师学艺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20060117,
					"content": "不过刚到这里，就听你们在说「中邪」什么的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20060118,
					"content": "看你们的服饰，确实不像是本地人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060119
					],
					"speakerTitle": "纯也"
				},
				{
					"id": 20060119,
					"content": "非常抱歉…因为最近上门找麻烦的人太多，我们也不得不小心防备。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060120
					],
					"speakerTitle": "纯也"
				},
				{
					"id": 20060120,
					"content": "你们来的有点不巧。师父他最近不幸中邪，身体还没恢复，暂时不能收你们为徒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060121,
						20060122
					],
					"speakerTitle": "纯也"
				},
				{
					"id": 20060121,
					"content": "我可以等他康复。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20060123
					]
				},
				{
					"id": 20060123,
					"content": "看来你拜师的心确实很虔诚。这样吧，我和师妹先介绍一下师父的情况，是走是留，之后由你自己决定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060124
					],
					"speakerTitle": "纯也"
				},
				{
					"id": 20060124,
					"content": "我们的师父叫做土门，这个名字你们应该听说过了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060125
					],
					"speakerTitle": "纯也"
				},
				{
					"id": 20060125,
					"content": "自学剑有成之后，师父他曾连续击败许多有名的剑道家，未尝一败。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060126
					],
					"speakerTitle": "纯也"
				},
				{
					"id": 20060126,
					"content": "师父曾说过，他的目标是成为「天下第一」的剑道家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060127
					],
					"speakerTitle": "纯也"
				},
				{
					"id": 20060127,
					"content": "在训练我们的同时，他仍在不停地磨练自己的剑道，我们也被师父的热情感染，拼命追赶着师父的脚步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060128
					],
					"speakerTitle": "纯也"
				},
				{
					"id": 20060128,
					"content": "可是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060129
					],
					"speakerTitle": "纯也"
				},
				{
					"id": 20060129,
					"content": "可是前段时间，师父的「神之眼」被夺走，整个人也突然性情大变。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060130
					],
					"speakerTitle": "菜菜子"
				},
				{
					"id": 20060130,
					"content": "他不但经常念叨一些奇怪的东西，还不准我们练剑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060131
					],
					"speakerTitle": "菜菜子"
				},
				{
					"id": 20060131,
					"content": "我和师兄商量了一下，感觉师父应该是被邪祟附身了。所以特地请了「鸣神大社」的巫女来帮忙驱邪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060132
					],
					"speakerTitle": "菜菜子"
				},
				{
					"id": 20060132,
					"content": "但说实话，我也不确定师父能不能好起来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060133
					],
					"speakerTitle": "菜菜子"
				},
				{
					"id": 20060133,
					"content": "「鸣神大社」，那是什么呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20060134,
					"content": "你们不知道鸣神大社吗？那是鸣神岛最大的神社，掌管神社的大巫女，据说与雷电将军大人关系匪浅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060135
					],
					"speakerTitle": "纯也"
				},
				{
					"id": 20060135,
					"content": "虽然我们没办法请动那位大巫女亲自出手…但即便是鸣神大社中普通的巫女，对驱邪一事也有着绝对的权威。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060136
					],
					"speakerTitle": "纯也"
				},
				{
					"id": 20060136,
					"content": "所以放心吧师妹，师父他一定不会有事的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060137
					],
					"speakerTitle": "纯也"
				},
				{
					"id": 20060137,
					"content": "驱邪仪式会在晚上举办，如果两位感兴趣的话，也可以过来看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060138
					],
					"speakerTitle": "纯也"
				},
				{
					"id": 20060138,
					"content": "邪祟附身…被夺去神之眼还会引发这样的问题吗？我们晚上再来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20060122,
					"content": "不拜师成功我就不回去。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20060123
					]
				}
			]
		},
		{
			"id": 200602,
			"completionStepIds": [
				200603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200603",
							"2"
						],
						"stepId": 200603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"纯也",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20060201,
					"content": "嘘…你来了？幸亏你来得晚，没有见到师父刚刚发疯的样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060202
					],
					"speakerTitle": "纯也"
				},
				{
					"id": 20060202,
					"content": "刚刚师妹搀扶着师父，偶然听到师父正小声念叨着一些名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060203
					],
					"speakerTitle": "纯也"
				},
				{
					"id": 20060203,
					"content": "师妹问他们是谁，师父突然就露出了惊恐的表情，一把将师妹推开。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060204
					],
					"speakerTitle": "纯也"
				},
				{
					"id": 20060204,
					"content": "师父他似乎很痛苦，捂着耳朵，一双眼睛通红通红的，不停地四下环顾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060205
					],
					"speakerTitle": "纯也"
				},
				{
					"id": 20060205,
					"content": "他一直在叫一些名字，有些我们认识，有些我们不认识，似乎都是师父曾经击败过的剑道家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060206
					],
					"speakerTitle": "纯也"
				},
				{
					"id": 20060206,
					"content": "其中一个名叫安西的，是师父曾经的师兄，不过早年被师父击败之后，就一直在居无定所地流浪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060207
					],
					"speakerTitle": "纯也"
				},
				{
					"id": 20060207,
					"content": "刚刚师父叫了好几声他的名字…唉，幸亏神社的巫女打昏了师父，驱邪仪式才能继续下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060208
					],
					"speakerTitle": "纯也"
				},
				{
					"id": 20060208,
					"content": "现在驱邪仪式已经开始了，我们还是安心等待结果吧。希望师父没事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060209
					],
					"speakerTitle": "纯也"
				},
				{
					"id": 20060209,
					"content": "你们在这等一会儿，我去拿点水来，万一师父等下醒过来，不能没有水喝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060210
					],
					"speakerTitle": "纯也"
				},
				{
					"id": 20060210,
					"content": "…嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20060211,
					"content": "刚刚好像有一个鬼鬼祟祟的家伙跑过去了，难道说是打算破坏「驱邪仪式」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20060212,
					"content": "不能让他得逞。旅行者，我们赶快跟上去看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 200604,
			"completionStepIds": [
				200605
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
