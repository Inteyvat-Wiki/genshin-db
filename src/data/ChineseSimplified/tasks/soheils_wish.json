			"dialogs": [
				{
					"id": 731100601,
					"content": "探索了「透明遗迹」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100602
					]
				},
				{
					"id": 731100602,
					"content": "啊，原来二位去了「透明遗迹」，有什么收获吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100603
					],
					"speakerTitle": "索赫尔"
				},
				{
					"id": 731100603,
					"content": "当然有！并且，一定会让你大吃一惊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731100604,
					"content": "向索赫尔讲述了探查透明遗迹的经历，并把三块石板交给了他。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731100605
					]
				},
				{
					"id": 731100605,
					"content": "喔…！果然，那股神秘的力量后面有着赤王不可告人的秘密，且待我一探究竟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100606
					],
					"speakerTitle": "索赫尔"
				},
				{
					"id": 731100606,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100607
					],
					"speakerTitle": "索赫尔"
				},
				{
					"id": 731100607,
					"content": "这是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100608
					],
					"speakerTitle": "索赫尔"
				},
				{
					"id": 731100608,
					"content": "怎么会这样…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100609
					],
					"speakerTitle": "索赫尔"
				},
				{
					"id": 731100609,
					"content": "哇，你的脸色变得好难看，是发现了什么可怕的事情吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100610
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731100610,
					"content": "啊…抱歉，倒也不是说可怕，而是…石板上的内容，看起来很复杂，不过本质上都是…请假记录…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100611
					],
					"speakerTitle": "索赫尔"
				},
				{
					"id": 731100611,
					"content": "并且，就连请假理由和现在的年轻学者们都没什么区别…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100612
					],
					"speakerTitle": "索赫尔"
				},
				{
					"id": 731100612,
					"content": "呼，还好当年没能找到进入透明遗迹的方法，否则可能会被气疯的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100613
					],
					"speakerTitle": "索赫尔"
				},
				{
					"id": 731100613,
					"content": "不过，还是谢谢你们带回了这几块石板，我再去打听一下蒙德人的请假理由，应该也能够写上一篇论文——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100614
					],
					"speakerTitle": "索赫尔"
				},
				{
					"id": 731100614,
					"content": "《忙里偷闲——浅论不同社会形态中休假观念的流变》。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "索赫尔"
				}
			]
		},
