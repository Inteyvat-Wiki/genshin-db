						731100802
					]
				},
				{
					"id": 731100802,
					"content": "原来二位去了饱饮之陵，果然和我说得一样，就是缩小版的赤王陵吧？那么，有什么收获吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100803
					],
					"speakerTitle": "索赫尔"
				},
				{
					"id": 731100803,
					"content": "向索赫尔讲述了探查饱饮之陵的经历，并把石板交给了他。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731100804
					]
				},
				{
					"id": 731100804,
					"content": "唔…听起来并没有什么非常特殊的发现啊…看来饱饮之陵和赤王陵的差别，并不仅仅是大小而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100805
					],
					"speakerTitle": "索赫尔"
				},
				{
					"id": 731100805,
					"content": "至于这块石板嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100806
					],
					"speakerTitle": "索赫尔"
				},
				{
					"id": 731100806,
					"content": "是什么？是什么？写了这么多字，一定很有研究价值吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100807
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731100807,
					"content": "唔…在我看来，好像只是很普通的以动物为原型的寓言故事而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100808
					],
					"speakerTitle": "索赫尔"
				},
				{
					"id": 731100808,
					"content": "欸…怎么会这样？",
					"roleType": "TALK_ROLE_NPC",
