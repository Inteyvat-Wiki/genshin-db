				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731100501,
					"content": "这样一来，三处遗迹都已经探索完成，我的心事也算是了结了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100502
					],
					"speakerTitle": "索赫尔"
				},
				{
					"id": 731100502,
					"content": "那么，为了庆祝我们友谊进一步加深，我会再准备一些礼物，表达对大英雄和小英雄的谢意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100503,
						731100505
					],
					"speakerTitle": "索赫尔"
				},
				{
					"id": 731100503,
					"content": "不用客气。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100504
					]
				},
				{
					"id": 731100504,
					"content": "这些都不算什么啦，并且我们也靠着你的笔记找到了不少宝藏呢！对了，你的论文怎么样了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731100507,
					"content": "论文啊…有点头疼…虽然能写出新的论文没错，但是我已经过了那个靠论文数量的年纪了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100508
					],
					"speakerTitle": "索赫尔"
				},
				{
					"id": 731100508,
					"content": "还是得要突破性成果…还是要进到赤王陵里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100509
					],
					"speakerTitle": "索赫尔"
				},
				{
					"id": 731100509,
					"content": "贤者大人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100510
					],
					"speakerTitle": "哈尔瓦尼"
				},
				{
					"id": 731100510,
					"content": "唉，知道知道，左一句贤者大人，右一句贤者大人，我也就是抱怨一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100511
					],
					"speakerTitle": "索赫尔"
				},
				{
					"id": 731100511,
					"content": "为什么这么想要成果？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100512
					]
				},
				{
					"id": 731100512,
					"content": "那当然是为了成为下一任贤者大人的候补。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100513
					],
					"speakerTitle": "索赫尔"
				},
				{
					"id": 731100513,
					"content": "在外人看来，贤者大人和学者的区别，可能也就是小一点的日落果和大一点的日落果的区别。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100514
					],
					"speakerTitle": "索赫尔"
				},
				{
					"id": 731100514,
					"content": "但实际上，贤者大人和我们普通学者的区别，比丘丘人和史莱姆的区别还大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100515,
						731100517
					],
					"speakerTitle": "索赫尔"
				},
				{
					"id": 731100515,
					"content": "完全不沾边…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100516
					]
				},
				{
					"id": 731100516,
					"content": "没错，就是这样，根本是两回事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100519
					],
					"speakerTitle": "索赫尔"
				},
				{
					"id": 731100519,
					"content": "贤者大人们掌握权力，就相当于扼住了所有学者们的喉管。一句话可以让学者生，同样一句话也可以让学者死。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100520
					],
					"speakerTitle": "索赫尔"
				},
				{
					"id": 731100520,
					"content": "那么多人为了论文拼死拼活，就连…我这么一大把年纪都顾不得体面，都是为了能够让贤者大人高看一眼而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100521
					],
					"speakerTitle": "索赫尔"
				},
				{
					"id": 731100521,
					"content": "所以，我一定要成为贤者大人，否则，过去受过的屈辱折磨和痛苦都毫无意义。如果你是学者的话，一定也能体会我的想法的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100522
					],
					"speakerTitle": "索赫尔"
				},
				{
					"id": 731100522,
					"content": "#不，我觉得{NICKNAME}也许会更像考古笔记里的那个你哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100523
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731100523,
					"content": "考古笔记？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100524
					],
					"speakerTitle": "索赫尔"
				},
				{
					"id": 731100524,
					"content": "嗯！「比起被嘲笑，更痛苦的是知识没有增长。」这可是你在考古笔记里的原话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100525
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731100525,
					"content": "啊？我还写过这样的话？我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100526
					],
					"speakerTitle": "索赫尔"
				},
				{
					"id": 731100526,
					"content": "嗯…确实是有过那样的日子，如果不是你们提醒，我的脑海里可能根本不会再浮现出这种想法吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100527,
						731100528
					],
					"speakerTitle": "索赫尔"
				},
				{
					"id": 731100527,
					"content": "原来已经忘记了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100529
					]
				},
				{
					"id": 731100529,
					"content": "#呼…{NICKNAME}，派蒙，虽然很突然，但是我又有了一个不情之请。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100530
					],
					"speakerTitle": "索赫尔"
				},
				{
					"id": 731100530,
					"content": "欸…？难道还想拜托我们去找什么石板吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100531
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731100531,
					"content": "不不不，石板已经很足够了…我只是…只是突然想重新读一读那本旧笔记。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100532
					],
					"speakerTitle": "索赫尔"
				},
				{
					"id": 731100532,
					"content": "请容我收回那本送给你们的考古笔记，我会为你们准备其他的礼物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100533
					],
					"speakerTitle": "索赫尔"
				},
				{
					"id": 731100533,
					"content": "没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100534
					]
				},
				{
					"id": 731100534,
					"content": "嗯，谢谢你们最近的奔波，祝你们旅途顺利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100535
					],
					"speakerTitle": "索赫尔"
				},
				{
					"id": 731100535,
					"content": "也谢谢你们让我回想起年轻的时候，这种感觉，并不算坏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "索赫尔"
				},
				{
					"id": 731100528,
					"content": "能回忆起来是好事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100529
					]
				},
				{
					"id": 731100517,
					"content": "他们的区别是什么…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100518
					]
				},
				{
					"id": 731100518,
					"content": "他们的区别是，根本就是两种事物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100519
					],
					"speakerTitle": "索赫尔"
				},
				{
					"id": 731100505,
					"content": "各取所需而已。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100506
					]
				},
				{
					"id": 731100506,
					"content": "没错！我们获得了宝藏，而你也能写出论文来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100507
					],
					"speakerTitle": "派蒙"
				}
			]
		},
