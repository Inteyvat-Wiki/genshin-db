		{
			"id": 7311002,
			"completionStepIds": [
				7311001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7311001",
							"2"
						],
						"stepId": 7311001,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302515",
							"3"
						],
						"stepId": 7302515,
						"stateName": "QUEST_STATE_FINISHED"
