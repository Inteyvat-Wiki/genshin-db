			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"索赫尔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731100101,
					"content": "呼…这里要凉快多了，拜托二位，把石板暂时借我一观。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100102
					],
					"speakerTitle": "索赫尔"
				},
				{
					"id": 731100102,
					"content": "索赫尔拿着石板看了又看，时而眉头紧锁，时而啧啧称奇。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731100103
					]
				},
				{
					"id": 731100103,
					"content": "喂…你看得也太久了吧！难道说是想把上面的内容记下来，不给我们报酬？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731100104,
					"content": "抱歉抱歉，只是实在是看入迷了，毕竟我是第一次见到这样的一次文献…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100105
					],
					"speakerTitle": "索赫尔"
				},
				{
					"id": 731100105,
					"content": "有什么发现吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100106
					]
				},
				{
					"id": 731100106,
					"content": "唔…有一些吧，看起来像是什么工程记录…里面提到了「阿如」，不知道和阿如村是什么关系。可惜没有更多记载了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100107
					],
					"speakerTitle": "索赫尔"
				},
				{
					"id": 731100107,
					"content": "不过，也是值得写上几笔的发现了，谢谢你们，这是说好的报酬！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100108,
						731100109
					],
					"speakerTitle": "索赫尔"
				},
				{
					"id": 731100108,
					"content": "不客气。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100112
					]
				},
				{
					"id": 731100112,
					"content": "那么下一步，就是找到更多的一次文献，可是不进沙漠的话又很难弄到手…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100113
					],
					"speakerTitle": "索赫尔"
				},
				{
					"id": 731100113,
					"content": "啊…我想到了！二位接下来要是有空的话，能不能听我一个不情之请…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100114
					],
					"speakerTitle": "索赫尔"
				},
				{
					"id": 731100114,
					"content": "索赫尔先生，莫非你是想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100115
					],
					"speakerTitle": "哈尔瓦尼"
				},
				{
					"id": 731100115,
					"content": "贤者大人吩咐过，任何学者都不得进入沙漠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100116
					],
					"speakerTitle": "哈尔瓦尼"
				},
				{
					"id": 731100116,
					"content": "哎，别误会，我可不敢不听从贤者大人的命令。不过贤者大人应该没有吩咐过，不允许随便赠送礼物吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100117
					],
					"speakerTitle": "索赫尔"
				},
				{
					"id": 731100117,
					"content": "赠送礼物？你要送我们什么好东西？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731100118,
					"content": "是非常珍贵的事物——我的考古笔记。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100119
					],
					"speakerTitle": "索赫尔"
				},
				{
					"id": 731100119,
					"content": "实不相瞒，我在十几年前，也曾经试图进入沙漠，不过没有什么特别的发现。只记录下了几处很可疑的遗迹的位置。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100120
					],
					"speakerTitle": "索赫尔"
				},
				{
					"id": 731100120,
					"content": "我想，在时隔多年我又回到这里的时候，和你们因为遗迹相识，这一定是某种宿命。所以我想把这本笔记送给你们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100121
					],
					"speakerTitle": "索赫尔"
				},
				{
					"id": 731100121,
					"content": "你是打算…？我明白了，确实没有违反贤者大人的吩咐，可是，这样的举动终究…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100122
					],
					"speakerTitle": "哈尔瓦尼"
				},
				{
					"id": 731100122,
					"content": "#举动？什么举动？赠送礼物单纯只是为了纪念我结识了大英雄{NICKNAME}和小英雄派蒙，难道不是非常合理？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100123
					],
					"speakerTitle": "索赫尔"
				},
				{
					"id": 731100123,
					"content": "合理…吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100124,
						731100125
					],
					"speakerTitle": "哈尔瓦尼"
				},
				{
					"id": 731100124,
					"content": "非常合理。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100130
					]
				},
				{
					"id": 731100130,
					"content": "呼，学者的世界真复杂！明明就是想让我们帮忙调查，却非要说是什么送礼物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731100131,
					"content": "要我说啊，他就是害怕在边上的那个大个子回去找贤者告状。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100132,
						731100134,
						731100136
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731100132,
					"content": "是派蒙的世界太简单了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100133
					]
				},
				{
					"id": 731100133,
					"content": "是吗？我觉得还挺复杂的，毕竟，要记住各种各样食物的味道…还要记住各种宝藏的获取方法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100141
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731100141,
					"content": "比起这些，我们快来看看索赫尔给的礼物里，到底记录着些什么吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100142
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731100142,
					"content": "唔…真是坎坷，在赤王陵附近探索了一个月没什么收获。但还是不死心，发现了一些「透明遗迹」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100143
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731100143,
					"content": "然后发现了一个比赤王陵小得多的「饱饮之陵」。最后还在一个叫做「吞羊岩」的地方，被佣兵们袭击。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100144
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731100144,
					"content": "哇，看他的记录，好像吃了不少苦头，却还说「比起被嘲笑，更痛苦的是知识没有增长。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100145
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731100145,
					"content": "和现在判若两人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100146
					]
				},
				{
					"id": 731100146,
					"content": "嗯，感觉那时候的索赫尔，真的很认真地在追求知识样子，我都被感动了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100147
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731100147,
					"content": "这么看来，他管这本笔记叫做贵重的礼物，好像也不是很夸张了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100148
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731100148,
					"content": "那么，我们分别去他提到的那些地方看看吧！要是发现了什么，就带回来，当做给他的回礼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731100134,
					"content": "派蒙居然听懂了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100135
					]
				},
				{
					"id": 731100135,
					"content": "那当然！他都快把「帮帮我」这几个字写在脸上了！这种时候帮他，一定会获得许多报酬的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100141
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731100136,
					"content": "他也有他的难处。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100137
					]
				},
				{
					"id": 731100137,
					"content": "话是这么说没错啦，但是总觉得这帮学者，把追求知识这四个字当做面具在用…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100138
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731100138,
					"content": "好像只要说出了这四个字以后，就变成了正义的化身，不管说什么做什么都有了什么不得了的内情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731100139,
					"content": "派蒙千万不要变成这样。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100140
					]
				},
				{
					"id": 731100140,
					"content": "不会的！我一直对知识没什么兴趣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100141
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731100125,
					"content": "不太合理…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100126
					]
				},
				{
					"id": 731100126,
					"content": "啊…是觉得这份薄礼太过简朴了吗？嗯…这只是见面礼！接下来，我会准备更体面的礼物的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100127
					],
					"speakerTitle": "索赫尔"
				},
				{
					"id": 731100127,
					"content": "唔，我觉得还…挺合理的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731100128,
					"content": "既然小英雄已经答应了，大英雄是不是也…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100129
					],
					"speakerTitle": "索赫尔"
				},
				{
					"id": 731100129,
					"content": "好吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100130
					]
				},
				{
					"id": 731100109,
					"content": "应该谢谢提尔扎德。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100110
					]
				},
				{
					"id": 731100110,
					"content": "没错，如果不是为了证明提尔扎德没有撒谎，我们也不会找到这块石板！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731100111,
					"content": "你说得对，谢谢提尔扎德，谢谢他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
