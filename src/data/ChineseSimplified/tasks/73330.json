			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"斯露莎",
					"马尔科佐夫",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733300701,
					"content": "喂，心怀不轨的人类，劝你们尽快离开此地。吾辈花灵的传承与隐秘可不是尔等可以轻易触达的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300702
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733300702,
					"content": "花灵？花灵！多么新奇的体验啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300703
					],
					"speakerTitle": "马尔科佐夫"
				},
				{
					"id": 733300703,
					"content": "#哦！还有{M#精干的少年}{F#小小的女士}和{M#他的}{F#她的}…宠物？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300704
					],
					"speakerTitle": "马尔科佐夫"
				},
				{
					"id": 733300704,
					"content": "#哇！你这家伙也太失礼了！我可是{M#他}{F#她}最好的伙伴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300705
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733300705,
					"content": "伙伴…当然，当然！最好的伙伴，多么动听的词汇！我从孩提时代起就盼望着能有这样一个「最好的伙伴」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300706
					],
					"speakerTitle": "马尔科佐夫"
				},
				{
					"id": 733300706,
					"content": "#{M#精干的少年}{F#小小的女士}，您应该不需要两个「最好的伙伴」吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300707,
						733300708
					],
					"speakerTitle": "马尔科佐夫"
				},
				{
					"id": 733300707,
					"content": "什么意思…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733300710
					]
				},
				{
					"id": 733300710,
					"content": "我的意思是…太奢侈了！即便是对您来说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300711
					],
					"speakerTitle": "马尔科佐夫"
				},
				{
					"id": 733300711,
					"content": "我无法原谅这样的不公…所以恳请您，将花灵交给我。关于花灵的待遇，您大可放心，我一定会物尽其用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300712
					],
					"speakerTitle": "马尔科佐夫"
				},
				{
					"id": 733300712,
					"content": "无礼的家伙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300713
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733300713,
					"content": "这也太不讲道理了，根本没办法沟通嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300714
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733300714,
					"content": "这世上有比语言更通行的道理…吾之「谒颂主」，聪慧如你，应该明白我的意思吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300715
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733300715,
					"content": "我猜斯露莎是说，给他点颜色瞧瞧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300716
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733300716,
					"content": "哼，不用白飘飘多话！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733300708,
					"content": "倒是不介意有更多伙伴。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733300709
					]
				},
				{
					"id": 733300709,
					"content": "那怎么行！不行不行，「最好的」伙伴只能是派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300710
					],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}