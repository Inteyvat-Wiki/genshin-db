			"dialogs": [
				{
					"id": 120420501,
					"content": "离开意识空间返回神社后，你们向八重神子讲述了一切…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						120420502
					]
				},
				{
					"id": 120420502,
					"content": "如今的影亲手在意识空间里种下神樱树，它在过去的稻妻发了芽…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
