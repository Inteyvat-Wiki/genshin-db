						"rawParams": [
							"1204206",
							"2"
						],
						"stepId": 1204206,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"雷电将军"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120420301,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420302
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120420302,
					"content": "为什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420303
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120420303,
					"content": "你们…怎么能再次来到这里？而且…你们的模样居然还和当年一样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420304
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120420304,
					"content": "当年？你的意思是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420305
					]
				},
				{
					"id": 120420305,
					"content": "这场对决，令人甚是怀念。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420306
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120420306,
					"content": "仿佛回到了永恒的法则刚刚订立之时，你如今这份意志，竟堪比那时。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420307
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120420307,
					"content": "无数场战斗，你一次都未落败，也丝毫没有犹豫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420308
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120420308,
					"content": "即便我将一切永恒之敌都展现在你的面前，你也不曾动摇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420309
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120420309,
					"content": "能如此坚定地执行规则，你也值得敬佩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420310
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120420310,
					"content": "你无愧「永恒的守护者」之名。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420311
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120420311,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}们再次回到这个空间，就像是命运的必然一般。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420312
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120420312,
					"content": "那就以这决战，为我们五百多年的宿命画上句号吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420313
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120420313,
					"content": "决战？难道你终于…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420314
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120420314,
					"content": "向后退，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420315
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120420315,
					"content": "你要结束一切吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420316
					]
				},
				{
					"id": 120420316,
					"content": "我会成为下一个「开始」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雷电将军"
				}
			]
		},
		{
			"id": 1204204,
			"completionStepIds": [
				1204208
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1204208",
							"2"
						],
						"stepId": 1204208,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"雷电将军"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120420401,
					"content": "到此为止。你赢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420402
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120420402,
					"content": "我原以为你无法超越过去，看来我还是太过武断，轻视了你的灵魂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420403
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120420403,
					"content": "永不磨损的意志，终究是无法拥抱未来啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420404
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120420404,
					"content": "你无需担忧未来，也无需独自前行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420405
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120420405,
					"content": "我最懂得你的强大，若只凭我一己之力，这场决斗的败者必然是我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420406
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120420406,
					"content": "然而出刀的理由，决定了武艺的格局与极限。我所背负的是投向天光的万千视线。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420407
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120420407,
					"content": "每思及此，我就能感觉到这把「梦想一心」中传来的异动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420408
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120420408,
					"content": "这把从真手里接过的刀，像是在试图提醒我…激励我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420409
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120420409,
					"content": "我也感觉到了，方才激战中，它似乎释放出了全新的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420410
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120420410,
					"content": "这份力量，甚至在我的认知之外。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420411
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120420411,
					"content": "这是真{RUBY#[D]前代雷神}的佩刀。可能在我真正理解并认同她的时候，刀才会全力回应我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420412
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120420412,
					"content": "握紧「梦想一心」，让我有了与她再次并肩的感觉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420413
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120420413,
					"content": "熟悉而又陌生…从不挥刀的她，始终在我身旁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420414
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120420414,
					"content": "我，认可了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420415
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120420415,
					"content": "你崭新的意志并非源于磨损。我不会再阻碍你试图修改法则的行为。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420416
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120420416,
					"content": "从今往后，此身依然是你的协助者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420417
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120420417,
					"content": "我不会再设下什么绝不容更改的法则了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420418
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120420418,
					"content": "你曾代表我的过去，但从今天起，你——就是我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420419
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120420419,
					"content": "真从没把我当成无惧无畏的武器，我也不该将你视为工具。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420420
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120420420,
					"content": "…呵，你真的变了。这就是人类常说的「成长」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420421
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120420421,
					"content": "我明白了，我会成为你的影子，就像你曾经是真的影子一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420422
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120420422,
					"content": "我将履行的职责不会改变。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420423
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120420423,
					"content": "但作为武者，我很期待以后还有像这样战斗的机会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420424
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120420424,
					"content": "单论胜负本身，你仍心有不甘，是吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420425
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120420425,
					"content": "只是从来没有过这样的感觉，很新奇，值得回味。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420426
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120420426,
					"content": "打完了？这就算，全部结束了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420427
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120420427,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420428
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120420428,
					"content": "「梦想一心」在发光？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420429
					]
				},
				{
					"id": 120420429,
					"content": "你们好啊，影，还有在此的见证者们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420430
					],
					"speakerTitle": "真"
				},
				{
					"id": 120420430,
					"content": "我是雷电真，没能尽到职责的前代雷神，为你们留下了无数的麻烦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420431
					],
					"speakerTitle": "真"
				},
				{
					"id": 120420431,
					"content": "真…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420432
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120420432,
					"content": "我很开心，我知道如果是你的话，一定能走到这一步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420433
					],
					"speakerTitle": "真"
				},
				{
					"id": 120420433,
					"content": "我在「梦想一心」中留下了些许微弱的意志，你发挥出它所有力量的那一刻，我也会被释放出来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420434
					],
					"speakerTitle": "真"
				},
				{
					"id": 120420434,
					"content": "至于为什么要用如此迂回的方法——因为那时的你深信自己的想法，什么都听不进去嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420435
					],
					"speakerTitle": "真"
				},
				{
					"id": 120420435,
					"content": "可我没有时间等待你回心转意。请原谅，我只能以这种方式等待你的归来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420436
					],
					"speakerTitle": "真"
				},
				{
					"id": 120420436,
					"content": "但你从未向我提起这些…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420437
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120420437,
					"content": "一切来得太过突然…抱歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420438
					],
					"speakerTitle": "真"
				},
				{
					"id": 120420438,
					"content": "我一直觉得很愧疚，突然就将稻妻托付给了你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420439
					],
					"speakerTitle": "真"
				},
				{
					"id": 120420439,
					"content": "这些道理，本应由我循序渐进地传授给你，让你不再执着于「无想」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420440
					],
					"speakerTitle": "真"
				},
				{
					"id": 120420440,
					"content": "那时你就感知到坎瑞亚即将发生的事了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420441
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120420441,
					"content": "嗯，多少有点吧。无论是对于哪位尘世执政来说，「那边」都是不容忽视的存在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420442
					],
					"speakerTitle": "真"
				},
				{
					"id": 120420442,
					"content": "现在的我已经无法感知到时间了。我不知道我们阔别多久才重逢，也不知道在此期间稻妻经历了什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420443
					],
					"speakerTitle": "真"
				},
				{
					"id": 120420443,
					"content": "但我知道，你一定走过了极其艰难的路，一定有许多次想要落泪，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420444
					],
					"speakerTitle": "真"
				},
				{
					"id": 120420444,
					"content": "…别小看我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420445
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120420445,
					"content": "你看，你承认了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420446
					],
					"speakerTitle": "真"
				},
				{
					"id": 120420446,
					"content": "我考虑到这种可能性，才特地为你留下一份礼物，以缓解稻妻的痛苦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420447
					],
					"speakerTitle": "真"
				},
				{
					"id": 120420447,
					"content": "来吧，在我最后的意识消逝前，收下它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420448
					],
					"speakerTitle": "真"
				},
				{
					"id": 120420448,
					"content": "不过，最重要的一步还是要由你亲手…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "真"
				}
			]
		},
