			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"八重神子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120420101,
					"content": "瞧你一脸焦急，该不会又有事求我了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420102
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420102,
					"content": "幸亏来的是你，换了别人，我可没心思一而再再而三地笑脸相迎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420103
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420103,
					"content": "可我看你一直在笑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120420104,
					"content": "刚才那是俗语，好吗？不许挑我的毛病。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420105
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420105,
					"content": "派蒙，说重点…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420106
					]
				},
				{
					"id": 120420106,
					"content": "啊对对，出大事了！影她…她…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120420107,
					"content": "为八重神子讲述了事件经过…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						120420108
					]
				},
				{
					"id": 120420108,
					"content": "哦——原来如此，影想把稻妻托付给人类，自己一个人面对这场不知何时才能结束的恶战…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420109
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420109,
					"content": "死板又极致，完全凭借自身意志行动，只要缺少一分实力都无法达成目的…确实是她的作风。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420110
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420110,
					"content": "我说，过去那么多年她都是这样，现在你又是为什么担心呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420111,
						120420112
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420111,
					"content": "这场对决严重性不同以往。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420113
					]
				},
				{
					"id": 120420113,
					"content": "操之过急…呵呵，这么说也没错。影啊，有时候像个小孩子似的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420114
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420114,
					"content": "所以，你觉得我能帮上忙？谁告诉你的呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420115
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420115,
					"content": "她是在装傻吧？她故意的吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120420116,
					"content": "小东西变聪明了嘛。不过这次我说的是实话，有关雷电真的意识空间，我也知之甚少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420117
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420117,
					"content": "我只知道它是神樱树的根基，也听说它和影的「一心净土」有些差别。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420118
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420118,
					"content": "是因为雷电真已经不在了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120420119,
					"content": "倒也不全是这样。空间本身的性质也有差别…比起我在这里纸上谈兵，你们这些亲身访问过的人应该更有体会吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420120,
						120420121
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420120,
					"content": "没看出来。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420122
					]
				},
				{
					"id": 120420122,
					"content": "总之，这些都是细节啦，只是待会儿解释起来比较麻烦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420123
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420123,
					"content": "先跟我到空间入口去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420121,
					"content": "没注意。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420122
					]
				},
				{
					"id": 120420112,
					"content": "她有些操之过急了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420113
					]
				}
			]
		},
		{
			"id": 1204202,
			"completionStepIds": [
				1204204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1204204",
							"2"
						],
						"stepId": 1204204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"八重神子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120420201,
					"content": "办法嘛，总是有的，虽然有些狡猾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420202
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420202,
					"content": "意识空间对外行来说非常抽象。好在我是影的眷属，多少能感应到她的所在之处。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420203
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420203,
					"content": "换句话说，我无法定位那个地点在空间里的具体位置，但能把你们送到影身边去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420204
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420204,
					"content": "抽象…？位置？什么跟什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120420205,
					"content": "你不用理解了。简单来说，现在她身旁的一切都很混沌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420206
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420206,
					"content": "如湍流一般无序…强行闯入也许会被巨浪卷走，彻底迷失在时间空间之中哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420207
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420207,
					"content": "正因如此，进入「一心净土」时把意识寄宿在物体上，才是比较保险的做法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420208
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420208,
					"content": "啊？那我不去了，你们去吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420209,
						120420210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120420209,
					"content": "想得美哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420211
					]
				},
				{
					"id": 120420211,
					"content": "不去也行，最坏的情况不就是失去影吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420212
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420212,
					"content": "#你、你们…唉讨厌啦！我陪你去吧，{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120420213,
					"content": "既然心意已决，那我就送你上路了哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420214
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420214,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420215
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420215,
					"content": "嗯？这是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420216
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420216,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420217
					]
				},
				{
					"id": 120420217,
					"content": "没什么。感觉很紊乱，证实了我心中的判断。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420218
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420218,
					"content": "对了，在进入空间时，记得不断在心中重复你的愿望哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420219
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420219,
					"content": "只有强大到一定地步的意识才能不被抽象空间里的巨浪吞没。你足够强，我才能将你送到最合适的位置。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420220
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420220,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420221
					]
				},
				{
					"id": 120420221,
					"content": "那么，门开了，请进吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420222
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420222,
					"content": "我会守在外侧随机应变，做你的最后一道保险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420223
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420223,
					"content": "#我的神明就交给你了，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420224
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420224,
					"content": "为了我，为了稻妻，你可要好好努力啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420225
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420225,
					"content": "神子，你靠得住吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120420226,
					"content": "我们一定会成功。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420227
					]
				},
				{
					"id": 120420227,
					"content": "好了好了，快去努力！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420210,
					"content": "派蒙，你不会不要我吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420211
					]
				}
			]
		},
		{
			"id": 1204203,
			"completionStepIds": [
				1204206
			],
