			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"茅葺一庆"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726820101,
					"content": "嗨！那边那位金发异乡人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820102,
						726820103
					],
					"speakerTitle": "茅葺一庆"
				},
				{
					"id": 726820102,
					"content": "又见面了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820104
					]
				},
				{
					"id": 726820104,
					"content": "嗯…你这头金发，越看越眼熟…难道是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820105
					],
					"speakerTitle": "茅葺一庆"
				},
				{
					"id": 726820105,
					"content": "啊，对了！是上次「百人一揆」中，表现无比亮眼的「黄金旋风」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820106
					],
					"speakerTitle": "茅葺一庆"
				},
				{
					"id": 726820106,
					"content": "黄、黄金旋风…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820107
					]
				},
				{
					"id": 726820107,
					"content": "上次，我在乱斗的场馆一隅，观察着参加者的活跃表现，想将其中最为精彩的场面收为素材。而你战斗的身姿，如刈草的黄金之风一般，横扫各路敌手…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820108,
						726820109
					],
					"speakerTitle": "茅葺一庆"
				},
				{
					"id": 726820108,
					"content": "奉承的话就免了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820113
					]
				},
				{
					"id": 726820113,
					"content": "无论如何，最近又有好事之徒举办「百人一揆」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820114,
						726820118
					],
					"speakerTitle": "茅葺一庆"
				},
				{
					"id": 726820114,
					"content": "「百人一揆」是什么来着？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820115
					]
				},
				{
					"id": 726820115,
					"content": "通过酣畅淋漓的打斗，来进行庆祝、或者消除晦气的乱斗大会。无论是武人还是魔物，都能摈弃成见不问身份，在其中为了纯粹的热血而混战的祭典。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820116
					],
					"speakerTitle": "茅葺一庆"
				},
				{
					"id": 726820116,
					"content": "在其中脱颖而出者，据说也能得到各种宝藏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820117
					],
					"speakerTitle": "茅葺一庆"
				},
				{
					"id": 726820117,
					"content": "虽然举办者、赞助者究竟是何许人也，至今都是谜团就是了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820119
					],
					"speakerTitle": "茅葺一庆"
				},
				{
					"id": 726820119,
					"content": "总之，这些事情不适合在人多口杂的地方讨论。跟我来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "茅葺一庆"
				},
				{
					"id": 726820118,
					"content": "原来如此，我明白了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820119
					]
				},
				{
					"id": 726820109,
					"content": "…再多说点？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820110
					]
				},
				{
					"id": 726820110,
					"content": "咳咳…「想必观众当中拥有剑豪般动态视力的人已经看出来了，这位金发异人所使用的正是在古武术中也被视为禁忌的『苟兰茄大龙卷』…！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820111
					],
					"speakerTitle": "茅葺一庆"
				},
				{
					"id": 726820111,
					"content": "？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820112
					]
				},
				{
					"id": 726820112,
					"content": "这是受你战斗的身影启发，而写的情节。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820113
					],
					"speakerTitle": "茅葺一庆"
				},
				{
					"id": 726820103,
					"content": "有什么委托吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820104
					]
				}
			]
		},
		{
			"id": 7268202,
			"completionStepIds": [
				7268202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7268202",
							"2"
						],
						"stepId": 7268202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"茅葺一庆"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726820201,
					"content": "我们到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820202
					],
					"speakerTitle": "茅葺一庆"
				},
				{
					"id": 726820202,
					"content": "只要踏入这扇看起来十分可疑的大门，就能进入这回的战斗场馆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820203,
						726820204
					],
					"speakerTitle": "茅葺一庆"
				},
				{
					"id": 726820203,
					"content": "好兴奋。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820205
					]
				},
				{
					"id": 726820205,
					"content": "这次的规则和上次应该差不多。来自世界各地，渴求争斗的魔物、冒险者、战士，在它的舞台上酣畅淋漓地大打出手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820206
					],
					"speakerTitle": "茅葺一庆"
				},
				{
					"id": 726820206,
					"content": "与之前一样，你可以和志同道合的同伴、战友一起去参战。毕竟，所谓「百人」，自然是人数越多越好啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820207
					],
					"speakerTitle": "茅葺一庆"
				},
				{
					"id": 726820207,
					"content": "我很期待你的表现。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820208
					],
					"speakerTitle": "茅葺一庆"
				},
				{
					"id": 726820208,
					"content": "这次你也不参加吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820209
					]
				},
				{
					"id": 726820209,
					"content": "我吗？我会以旁观者的身份参与，为你喝彩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820210
					],
					"speakerTitle": "茅葺一庆"
				},
				{
					"id": 726820210,
					"content": "毕竟，我的目标还是写出最精彩的格斗小说，而不是成为像你这样耀眼的战士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820211
					],
					"speakerTitle": "茅葺一庆"
				},
				{
					"id": 726820211,
					"content": "而我的直觉告诉我，你一定会是格斗场上最耀眼的明星。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820212,
						726820213
					],
					"speakerTitle": "茅葺一庆"
				},
				{
					"id": 726820212,
					"content": "我会尽力。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820214
					]
				},
				{
					"id": 726820214,
					"content": "嗯。想必这次你也能展现出耀眼无比的剑之舞吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "茅葺一庆"
				},
				{
					"id": 726820213,
					"content": "拭目以待吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820214
					]
				},
				{
					"id": 726820204,
					"content": "好麻烦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820205
					]
				}
			]
		}
	]
}