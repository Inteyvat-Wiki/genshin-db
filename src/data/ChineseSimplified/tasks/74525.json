			"dialogs": [
				{
					"id": 745250401,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745250402,
						745250403
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 745250402,
					"content": "你看起来表情有些严肃。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250404
					]
				},
				{
					"id": 745250404,
					"content": "是你啊。不，今天的调查任务已经结束了，附近暂时没有发现异常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745250405
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 745250405,
					"content": "我只是在想，刚才那群路过的镀金旅团，为什么看起来无精打采的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745250406,
						745250407
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 745250406,
					"content": "难道是因为旅途太累了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250408
					]
				},
				{
					"id": 745250408,
					"content": "我猜测，可能是经济原因。毕竟，一支「镀金」旅团，如果没有了「金」，那不就「没劲」了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745250409,
						745250410
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 745250409,
					"content": "…那来点「有劲」的事情如何？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250411
					]
				},
				{
					"id": 745250411,
					"content": "我明白了。不过，如果只是站着不动，画面可能会有些单调，缺乏冲击力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745250412
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 745250412,
					"content": "放心，我会调动雷元素力，让你的画面真正做到令人「眼前一亮」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745250413
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 745250413,
					"content": "…想法不错，我会抓拍好的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250414
					]
				},
				{
					"id": 745250414,
					"content": "嗯。交给你了。别错过了「决定性瞬间」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "赛诺"
				},
				{
					"id": 745250410,
					"content": "让我为你拍张画片吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250411
					]
				},
				{
					"id": 745250407,
					"content": "难道是因为任务失败了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250408
					]
				},
				{
					"id": 745250403,
					"content": "难道是在追捕犯人？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250404
					]
				}
			]
		}
	]
