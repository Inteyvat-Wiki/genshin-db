			"dialogs": [
				{
					"id": 710570133,
					"content": "背后突然传来话语声：\\n「嘿嘿嘿…蘑菇肉…嘿嘿嘿…」",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710570101
					]
				},
				{
					"id": 710570101,
					"content": "你们，嘿嘿嘿，怎么会出现在这里呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570102
					],
					"speakerTitle": "老何"
				},
				{
					"id": 710570102,
					"content": "呜哇！这人的脸色好奇怪啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710570103,
					"content": "#而且，{NICKNAME}，这个人从背后靠近的时候没发出一点声音…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710570104,
					"content": "不会是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710570105,
					"content": "应该不是吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570106
					]
				},
				{
					"id": 710570106,
					"content": "嘿嘿嘿…你们怎么…在这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570107
					],
					"speakerTitle": "老何"
				},
				{
					"id": 710570107,
					"content": "你们的吃的，也吃光了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570108
					],
					"speakerTitle": "老何"
				},
				{
					"id": 710570108,
					"content": "难道你就是老何？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570109
					]
				},
				{
					"id": 710570109,
					"content": "啊…什么呀？年轻人，你们说的啥呀，听不清。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570110
					],
					"speakerTitle": "老何"
				},
				{
					"id": 710570110,
					"content": "我们在问！你是老何吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710570111,
					"content": "哦哦，是啊，嘿嘿嘿，我就是老何。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570112
					],
					"speakerTitle": "老何"
				},
				{
					"id": 710570112,
					"content": "你们…不会是和我一样被困在下面，把吃的吃光了吧…欸呀，你的运气也不太好啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570113
					],
					"speakerTitle": "老何"
				},
				{
					"id": 710570113,
					"content": "嘿嘿嘿，不过没关系，我这里有吃的…饿了很久了吧…嘿嘿嘿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570114
					],
					"speakerTitle": "老何"
				},
				{
					"id": 710570114,
					"content": "这么说来确实有点饿了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570115,
						710570116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710570115,
					"content": "蘑菇肉可不能乱吃！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570117
					]
				},
				{
					"id": 710570117,
					"content": "对、对哦，他看上去精神恍惚，脸色还…那么奇怪，不会就是因为吃蘑菇肉导致的吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710570118,
					"content": "蘑菇肉？嘿嘿嘿，蘑菇肉可好吃了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570119
					],
					"speakerTitle": "老何"
				},
				{
					"id": 710570119,
					"content": "来，老何给你们一些蘑菇肉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570120
					],
					"speakerTitle": "老何"
				},
				{
					"id": 710570120,
					"content": "嘿嘿嘿蘑菇肉…咦，怎么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570121
					],
					"speakerTitle": "老何"
				},
				{
					"id": 710570121,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710570122,
					"content": "蘑菇肉，没了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570123
					],
					"speakerTitle": "老何"
				},
				{
					"id": 710570123,
					"content": "那就不要管什么蘑菇肉了，我们先一起回营地吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710570124,
					"content": "不行，没有蘑菇肉了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570125
					],
					"speakerTitle": "老何"
				},
				{
					"id": 710570125,
					"content": "没有蘑菇肉，就没力气走路，我哪也不去…没了蘑菇肉…这里其他地方都没有吃的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570126
					],
					"speakerTitle": "老何"
				},
				{
					"id": 710570126,
					"content": "有了蘑菇肉，哪都能去！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570127
					],
					"speakerTitle": "老何"
				},
				{
					"id": 710570127,
					"content": "那…哪里有这种蘑菇肉呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710570128,
					"content": "蘑菇肉…嘿嘿嘿…我知道哪里有蘑菇肉，我们来弄些蘑菇肉吃，这样就有力气做事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570129
					],
					"speakerTitle": "老何"
				},
				{
					"id": 710570129,
					"content": "就在这附近…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570130
					],
					"speakerTitle": "老何"
				},
				{
					"id": 710570130,
					"content": "#没办法了，{NICKNAME}，我们先找些蘑菇肉给他吃吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710570131,
					"content": "看来只能如此了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570132
					]
				},
				{
					"id": 710570132,
					"content": "蘑菇肉…嘿嘿嘿…大蘑菇肉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "老何"
				},
				{
					"id": 710570116,
					"content": "别乱吃危险的东西啦！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570117
					]
				}
			]
		},
