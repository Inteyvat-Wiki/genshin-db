				},
				{
					"id": 710570416,
					"content": "关于海迪夫…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570417
					]
				},
				{
					"id": 710570417,
					"content": "这家伙还在上面的营地，说是要把一些研究资料整理好带下来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570418
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710570418,
					"content": "只能等他下来以后再问问情况了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
