			"dialogs": [
				{
					"id": 710570201,
					"content": "一下子就全部解决了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710570202,
					"content": "老何…好强！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710570203,
					"content": "嘿嘿嘿…蘑菇肉，蘑菇肉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570204
					],
					"speakerTitle": "老何"
				},
				{
					"id": 710570204,
					"content": "自从吃了蘑菇肉，我腰也不疼了，手上也有劲了，嘿嘿嘿，感觉自己年轻了好几岁啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570205
					],
					"speakerTitle": "老何"
				},
				{
					"id": 710570205,
					"content": "蘑菇肉怪比蘑菇肉好吃，蘑菇肉，越大越好吃…嘿嘿嘿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570206
					],
					"speakerTitle": "老何"
				},
				{
					"id": 710570206,
					"content": "难道，老何是吃了这些蘑菇肉之后才变得那么厉害的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710570207,
					"content": "#{NICKNAME}，只要吃就能变强，我们也吃几个吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570208,
						710570210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710570208,
					"content": "你只是想吃蘑菇肉吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570209
					]
				},
				{
					"id": 710570209,
					"content": "我只是好奇是什么味道的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710570212,
					"content": "不过这下老何应该愿意跟我们一起回去了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710570213,
					"content": "蘑菇肉…嘿嘿，好吃！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570214
					],
					"speakerTitle": "老何"
				},
				{
					"id": 710570214,
					"content": "老何！我们一起回营地吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710570215,
					"content": "啊？一起？好啊，你们也来一起吃啊，这些蘑菇肉，嘿嘿嘿，风干之后可以吃很久…很久…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570216
					],
					"speakerTitle": "老何"
				},
				{
					"id": 710570216,
					"content": "是一起回营地啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710570217,
					"content": "回阴地？阴地是什么地方，不过好呀…嘿嘿嘿…吃了蘑菇肉，我哪都能去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570218
					],
					"speakerTitle": "老何"
				},
				{
					"id": 710570218,
					"content": "唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710570219,
					"content": "#{NICKNAME}，我们还是快点把老何带回去见瑾武姐吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710570210,
					"content": "不许乱吃！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570211
					]
				},
				{
					"id": 710570211,
					"content": "我、我知道啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570212
					],
					"speakerTitle": "派蒙"
				}
			]
		},
