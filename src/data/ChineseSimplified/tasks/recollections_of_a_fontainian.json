			"trigger": {
				"objectNames": [
					"奥古斯都·洛夫莱斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733500101,
					"content": "啊…阿嚏！这些香料的味道真是太…啊…阿嚏！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500102
					],
					"speakerTitle": "奥古斯都·洛夫莱斯"
				},
				{
					"id": 733500102,
					"content": "还是快点留个影，回去屋里待着吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500103
					],
					"speakerTitle": "奥古斯都·洛夫莱斯"
				},
				{
					"id": 733500103,
					"content": "旅行者，嗨，旅行者！请您留步！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500104,
						733500105
					],
					"speakerTitle": "奥古斯都·洛夫莱斯"
				},
				{
					"id": 733500104,
					"content": "你叫我？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500106
					]
				},
				{
					"id": 733500106,
					"content": "我想请您帮我在这里留个影，一张就好，不会花多长时间的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500109
					],
					"speakerTitle": "奥古斯都·洛夫莱斯"
				},
				{
					"id": 733500109,
					"content": "这地方的香料味道对我来说，实在是太刺激了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500110
					],
					"speakerTitle": "奥古斯都·洛夫莱斯"
				},
				{
					"id": 733500110,
					"content": "我在枫丹的时候，吃的菜里可是连一点辣味都不能有，最多放一点盐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500111
					],
					"speakerTitle": "奥古斯都·洛夫莱斯"
				},
				{
					"id": 733500111,
					"content": "在这里，我喷嚏打得连…阿嚏！连留影机都要拿不稳了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500112
					],
					"speakerTitle": "奥古斯都·洛夫莱斯"
				},
				{
					"id": 733500112,
					"content": "所以，我只能拜托…拜托其他人帮我留影。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500113
					],
					"speakerTitle": "奥古斯都·洛夫莱斯"
				},
				{
					"id": 733500113,
					"content": "您看上去就是个好心肠的人，所以…我就想请您来帮我这个忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500114
					],
					"speakerTitle": "奥古斯都·洛夫莱斯"
				},
				{
					"id": 733500114,
					"content": "你来自枫丹？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500115
					]
				},
				{
					"id": 733500115,
					"content": "没错，我都忘记自我介绍了，真是抱歉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500116
					],
					"speakerTitle": "奥古斯都·洛夫莱斯"
				},
				{
					"id": 733500116,
					"content": "我的名字是奥古斯都·洛夫莱斯，「枫丹动能工程科学研究院」的一名研究员。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500117,
						733500118
					],
					"speakerTitle": "奥古斯都·洛夫莱斯"
				},
				{
					"id": 733500117,
					"content": "「枫丹动能工程科学研究院」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500119
					]
				},
				{
					"id": 733500119,
					"content": "这串字是不是太长了？您也可以把它称作「枫丹科学院」，枫丹人也都这么叫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500120
					],
					"speakerTitle": "奥古斯都·洛夫莱斯"
				},
				{
					"id": 733500120,
					"content": "之前，枫丹科学院可以说是枫丹科研者的一座圣地，大部分的机关造物都出自我们院内。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500121
					],
					"speakerTitle": "奥古斯都·洛夫莱斯"
				},
				{
					"id": 733500121,
					"content": "但在天才的艾德温先生主持下，枫丹科学院的大部分建筑现在已经成了一片废墟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500122
					],
					"speakerTitle": "奥古斯都·洛夫莱斯"
				},
				{
					"id": 733500122,
					"content": "而雷蒙多和舒瓦瑟尔先生接手重建工作之后，院里的「研究精神」也正在坍塌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500123
					],
					"speakerTitle": "奥古斯都·洛夫莱斯"
				},
				{
					"id": 733500123,
					"content": "我是一个爱好整洁的人，不愿意在废墟堆里生活。所以就四处旅行，散散心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500124
					],
					"speakerTitle": "奥古斯都·洛夫莱斯"
				},
				{
					"id": 733500124,
					"content": "别皱眉，这些烦心事都和您无关。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500125
					],
					"speakerTitle": "奥古斯都·洛夫莱斯"
				},
				{
					"id": 733500125,
					"content": "来，请您快些给我拍一张画片吧。等泽维尔见识到须弥的风光，他肯定不会再待在稻妻了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500126
					],
					"speakerTitle": "奥古斯都·洛夫莱斯"
				},
				{
					"id": 733500126,
					"content": "提到泽维尔…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500127
					]
				},
				{
					"id": 733500127,
					"content": "泽维尔是枫丹科学院里的研究员。我曾与他在同一间研究室共事，他也曾经为我提供了许多指导。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500128
					],
					"speakerTitle": "奥古斯都·洛夫莱斯"
				},
				{
					"id": 733500128,
					"content": "他坚持要拍「映影」，还要做「映影导演」，在当时的枫丹科学院里，这个想法可不受欢迎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500129
					],
					"speakerTitle": "奥古斯都·洛夫莱斯"
				},
				{
					"id": 733500129,
					"content": "即使后来被赶到了其他项目，他仍借着记录项目研究过程的名头，不断地拍摄着「记录映影」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500132
					],
					"speakerTitle": "奥古斯都·洛夫莱斯"
				},
				{
					"id": 733500132,
					"content": "就这样，他在项目与研究室之间辗转，直到最终他被派到稻妻…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500130
					],
					"speakerTitle": "奥古斯都·洛夫莱斯"
				},
				{
					"id": 733500130,
					"content": "很有想法的人，假使他诞生在研究方向更为开明、经费更加充裕的过去，或者是美好的未来，想必能大有成就吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500131
					],
					"speakerTitle": "奥古斯都·洛夫莱斯"
				},
				{
					"id": 733500131,
					"content": "先不说这些了，请您来帮我拍一张画片吧，在这里就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奥古斯都·洛夫莱斯"
				},
				{
					"id": 733500118,
					"content": "那是什么地方？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500119
					]
				},
				{
					"id": 733500105,
					"content": "有什么事吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500106
					]
				}
			]
		},
		{
			"id": 7335002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
