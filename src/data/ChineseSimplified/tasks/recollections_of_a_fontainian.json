				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733500201,
					"content": "您帮我拍完画片了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500202
					],
					"speakerTitle": "奥古斯都·洛夫莱斯"
				},
				{
					"id": 733500202,
					"content": "还没有。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500203
					]
				},
				{
					"id": 733500203,
					"content": "唔，您慢慢来，拍摄画片确实不是一件简单的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奥古斯都·洛夫莱斯"
				}
			]
		},
		{
			"id": 7335003,
			"completionStepIds": [
				7335003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7335003",
							"2"
						],
						"stepId": 7335003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"奥古斯都·洛夫莱斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733500301,
					"content": "这画片真不错，您在留影方面很有天赋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500302
					],
					"speakerTitle": "奥古斯都·洛夫莱斯"
				},
				{
					"id": 733500302,
					"content": "自从开始旅行以来，对于构图与色彩把握有如此水准的人，我还是第一次见呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500303
					],
					"speakerTitle": "奥古斯都·洛夫莱斯"
				},
				{
					"id": 733500303,
					"content": "你都到过什么地方？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500304
					]
				},
				{
					"id": 733500304,
					"content": "这个啊，嗯…我本来可以直接从枫丹到须弥。毕竟枫丹有一条航线直通须弥的拜达港嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500312
					],
					"speakerTitle": "奥古斯都·洛夫莱斯"
				},
				{
					"id": 733500312,
					"content": "但俗话说，旅行最重要的是过程嘛，所以我还是选择了一条…更具有趣味性的旅游路线。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500313
					],
					"speakerTitle": "奥古斯都·洛夫莱斯"
				},
				{
					"id": 733500313,
					"content": "首先，我先通过柔灯港来到了沉玉谷，并途经轻策庄到达了分隔蒙德与璃月的石门。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500310
					],
					"speakerTitle": "奥古斯都·洛夫莱斯"
				},
				{
					"id": 733500310,
					"content": "在拜访晨曦酒庄以后，我还是决定南下到璃月港看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500305
					],
					"speakerTitle": "奥古斯都·洛夫莱斯"
				},
				{
					"id": 733500305,
					"content": "在璃月港我搭上了去奥摩斯港的渡船，再经河道北上，就来到了这里，遇到了您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500306
					],
					"speakerTitle": "奥古斯都·洛夫莱斯"
				},
				{
					"id": 733500306,
					"content": "毕竟，这次旅行的动机还是散心。倘若我是个热衷冒险的勇士…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500311
					],
					"speakerTitle": "奥古斯都·洛夫莱斯"
				},
				{
					"id": 733500311,
					"content": "或许我会乐意从海露港出发，走走古代的朝圣之路，向南深入沙漠吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500307
					],
					"speakerTitle": "奥古斯都·洛夫莱斯"
				},
				{
					"id": 733500307,
					"content": "…谁知道呢？或许返程时，我会试试穿越大沙漠。这么说来，现在经费还很充足，或许穿越沙漠去纳塔看看也不错…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500308
					],
					"speakerTitle": "奥古斯都·洛夫莱斯"
				},
				{
					"id": 733500308,
					"content": "好了，不耽误您的时间了。感谢您帮我留影，这些报酬请您收下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500309
					],
					"speakerTitle": "奥古斯都·洛夫莱斯"
				},
				{
					"id": 733500309,
					"content": "我得赶紧去给泽维尔写信了，他再不来须弥，我就要回枫丹了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奥古斯都·洛夫莱斯"
				}
			]
		},
