					"玄冬林檎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721123501,
					"content": "你要求签？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123502
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721123502,
					"content": "呜哇，好冷淡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721123503,
					"content": "我想求签…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721123504
					]
				},
				{
					"id": 721123504,
					"content": "明白了。流程是这样的。首先请你用力摇晃这个什么东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123505
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721123505,
					"content": "记得是叫「御神签箱」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721123506
					]
				},
				{
					"id": 721123506,
					"content": "没错。从里面会掉出一根竹签。把这根竹签给我，我会给你对应的纸片儿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123507
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721123507,
					"content": "好像叫「御神签」来着…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721123508
					]
				},
				{
					"id": 721123508,
					"content": "这种事情怎样都好吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123509
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721123509,
					"content": "我有问题！如果说，如果说我们抽到了凶签，要怎么办呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123510
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721123510,
					"content": "是命运让你抽到凶签，你还想怎样？啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123511
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721123511,
					"content": "欸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123512
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721123512,
					"content": "外头那个像架子的东西…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721123513
					]
				},
				{
					"id": 721123513,
					"content": "啧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123514
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721123514,
					"content": "她很露骨地「啧」了耶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123515
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721123515,
					"content": "我看看…是这样的。「把凶签捆到『御签挂』上，就可以逢凶化吉」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123516
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721123516,
					"content": "啊，对哦！如果你抽到凶签，把它捆到那个架子上就行了嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123517
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721123517,
					"content": "他们还真是…不对，我们「鸣神大社」很温柔的。所以就算抽到了凶签，也会给你们转运的机会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123518
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721123518,
					"content": "虽然感觉哪里好像怪怪的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123519
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721123519,
					"content": "#{NICKNAME}，我们求签吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
