					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721123602,
					"content": "好、好的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721123603
					]
				},
				{
					"id": 721123603,
					"content": "神社真是个不讲情面的地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721123604,
					"content": "给你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123605
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721123605,
					"content": "唔呣，看看运势吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721123606,
					"content": "对了。每天只能求一次签，这点请你记住。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123607
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721123607,
					"content": "不然我会很累…不对，不然御签挂会挂不下…也不是，应该怎么说来着？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123608
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721123608,
					"content": "「御神签是神明意志的体现。所以要尊重神明的意志，并且尽人所能及之力。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123609
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721123609,
					"content": "你看，写得真好。所以每天只能求一次签，记好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玄冬林檎"
				}
			]
		},
