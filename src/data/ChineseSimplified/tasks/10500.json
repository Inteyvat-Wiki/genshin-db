					"content": "那我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 105000314,
					"content": "那我就不客气了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000315,
						105000316
					],
					"speakerTitle": "莫娜"
