							"46622",
							"3"
						],
						"stepId": 46622,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"朱老板"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105000201,
					"content": "（客栈开在这种地方，生意当然不会好了…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 105000202,
					"content": "莫娜，你来得正好！你来的路上，看见了一个玉石戒指吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000203
					],
					"speakerTitle": "朱老板"
				},
				{
					"id": 105000203,
					"content": "玉石戒指？好像没什么印象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000204
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105000204,
					"content": "这可麻烦了…我的宝贝戒指一不留神就被史莱姆吞掉了，那可是我母亲留给我的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000205
					],
					"speakerTitle": "朱老板"
				},
				{
					"id": 105000205,
					"content": "嗯？这种事有莫娜在就不愁了吧。她的占星术那么厉害…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 105000206,
					"content": "那可不行，占星术是用来洞察真实、观测命运的严肃知识，可不是用来打杂的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000207
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105000207,
					"content": "但你之前不是说，老板很照顾你吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 105000208,
					"content": "这是尊严，也是心境的问题，占星术士如果认为占星术能解决一切，就会被星空放弃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000209
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105000209,
					"content": "占卜会失去指引的能力，再也看不透前方的迷雾，所以，原则就是原则。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000210
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105000210,
					"content": "有这么厉害的能力居然不用来赚钱，太可惜了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 105000211,
					"content": "唉，本来说如果你们愿意，我可以出两万摩拉作酬谢的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000212
					],
					"speakerTitle": "朱老板"
				},
				{
					"id": 105000212,
					"content": "两万…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000213,
						105000214
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105000213,
					"content": "你怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000215
					]
				},
				{
					"id": 105000215,
					"content": "没、没有啊？只是，觉得…能捡到戒指的人，运气真好啊，这样就能赚两万摩拉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000216,
						105000217
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105000216,
					"content": "你刚刚才说了占星术士的尊严。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000218
					]
				},
				{
					"id": 105000218,
					"content": "咳咳，是这样没错，不过呢…老板做生意这么辛苦，愿意花大钱去找这个戒指，它一定意义非凡吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000219
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105000219,
					"content": "就这么走了也不太好，我们努力找一下吧。就算不用占星术，或许也有另外的办法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000220
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105000220,
					"content": "她和我想到一起去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 105000221,
					"content": "#{NICKNAME}，这件事就交给你吧！这是师父交给你的第一个任务！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000222,
						105000223
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105000222,
					"content": "真没办法…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000224
					]
				},
				{
					"id": 105000224,
					"content": "嗯…既然是被史莱姆吞了，那可以用「元素诱饵」把附近的史莱姆全都引过来吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 105000225,
					"content": "还记得吗？就是帮迪卢克老爷提炼过的，那个「元素诱饵」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 105000226,
					"content": "其实…嘿嘿，我悄悄带了一点在身上！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000227,
						105000229
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 105000227,
					"content": "不愧是你！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000228
					]
				},
				{
					"id": 105000228,
					"content": "作为搭档，我很可靠吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000231
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 105000231,
					"content": "看起来，你们有好办法了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000232
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105000232,
					"content": "嗯，我们去去就来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 105000229,
					"content": "该不会是想嘴馋的时候…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000230
					]
				},
				{
					"id": 105000230,
					"content": "哎呀，细节就不用在意啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000231
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 105000223,
					"content": "又变成我的事了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000224
					]
				},
				{
					"id": 105000217,
					"content": "你刚刚才说了原则就是原则。",
