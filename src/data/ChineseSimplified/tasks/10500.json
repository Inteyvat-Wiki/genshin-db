			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"莫娜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105000101,
					"content": "为、为什么你会知道这件事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 105000102,
					"content": "因为我所掌握的，是真正的「占星术」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000103
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105000103,
					"content": "没什么疑问的话，我们就出发吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000104,
						105000105
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105000104,
					"content": "到处都是疑问！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000106
					]
				},
				{
					"id": 105000106,
					"content": "唉，真麻烦，那我耐心一点解释吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000107
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105000107,
					"content": "我的名字是阿斯托洛吉斯·莫娜·梅姬斯图斯，考虑到记错我的名字会非常失礼，通常我会允许别人叫我莫娜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000108
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105000108,
					"content": "我是占星术士，现在正要替我的师父，去蒙德城拿一个箱子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000109
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105000109,
					"content": "这是她和一位朋友，在五十年前定下的约定。但现在她上了年纪，行动很不方便，只能靠我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000110
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105000110,
					"content": "拿回箱子…这件事听起来和我们没什么关系？为什么要拉我们一起走呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 105000111,
					"content": "这个嘛…因为我还想和那个保管箱子的家伙较量较量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000112
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105000112,
					"content": "师父和她的朋友在神秘学方面斗了一辈子，也没能分出胜负。要是我能赢，那我不就比师父还厉害了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000113,
						105000115
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105000113,
					"content": "想证明自己的实力吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000114
					]
				},
				{
					"id": 105000114,
					"content": "咳咳，准确来说，是证明「占星术」的实力和地位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000117
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105000117,
					"content": "不过，通过我占星后的观察，现在师父的朋友离开了蒙德，保管箱子的是她的继承者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000118
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105000118,
					"content": "和我一样，那位继承者一定也是青出于蓝而胜于蓝嘛，可不能掉以轻心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000119
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105000119,
					"content": "这场较量，我想稳操胜券，考虑之后，我就想到了你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000120,
						105000122
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105000120,
					"content": "我…也不会占星啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000121
					]
				},
				{
					"id": 105000121,
					"content": "#话题是怎么突然跳到{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}身上的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 105000123,
					"content": "从师父那里传承下来的知识，是要一直传承下去的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000124
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105000124,
					"content": "假如我去见她的时候，已经带上了我的徒弟，那不就领先于她了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000125
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105000125,
					"content": "而你又是蒙德的大英雄，身份也配得上我。所以…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000126,
						105000127
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105000126,
					"content": "我拒绝。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000128
					]
				},
				{
					"id": 105000128,
					"content": "哎呀，不要你真的当我的徒弟，只需要你演一场戏就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000129
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105000129,
					"content": "再说了，跟我一起去拿箱子，这件事对你来说是有好处的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000130
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105000130,
					"content": "等我见到那个继承者，就有机会与她互相交流知识，你的命运我就能看得更清楚了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000131
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105000131,
					"content": "到时候更远的、更模糊的事，比如神明、血亲什么的，我都能给你答案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000132
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105000132,
					"content": "那、那确实是比我们一个一个国家找起来，要快多了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000133,
						105000134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 105000133,
					"content": "条件听起来很美好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000135
					]
				},
				{
					"id": 105000135,
					"content": "哼哼，明智之选，那我们就出发吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000136
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105000136,
					"content": "不过，在离开之前，我有个地方想去一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105000134,
					"content": "那…只能奉陪了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000135
					]
				},
				{
					"id": 105000127,
					"content": "怎么突然就变成你的徒弟了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000128
					]
				},
				{
					"id": 105000122,
					"content": "是怎么突然跳到我这里的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000123
					]
				},
				{
					"id": 105000115,
					"content": "简而言之，就是好面子吗。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000116
					]
				},
				{
					"id": 105000116,
					"content": "说什么呢！主要还是想借这个机会，证明「占星术」的实力和地位！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000117
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105000105,
					"content": "首先，请问你是？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000106
					]
				}
			]
		},
		{
			"id": 1050002,
			"completionStepIds": [
				1050003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
