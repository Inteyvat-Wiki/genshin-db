					"content": "出手好快！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000317
					]
				},
				{
					"id": 105000317,
					"content": "明明功劳和苦劳都是我们的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 105000318,
					"content": "弟子就要有弟子的样子，怎么能和师父邀功呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000319,
						105000321
					],
					"speakerTitle": "莫娜"
