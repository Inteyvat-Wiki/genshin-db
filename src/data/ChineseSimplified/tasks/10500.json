						105000309
					],
					"speakerTitle": "朱老板"
				},
				{
					"id": 105000309,
					"content": "加起来大概有五百多件吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000310
					],
					"speakerTitle": "朱老板"
				},
				{
					"id": 105000310,
					"content": "那你为什么还要在这里开客栈啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000311
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105000311,
					"content": "太早继承了家业，难免会觉得单调和枯燥嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000312
					],
					"speakerTitle": "朱老板"
				},
				{
					"id": 105000312,
					"content": "总之非常感谢你们，这是答应要给你们的摩拉，请一定收下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000313
					],
					"speakerTitle": "朱老板"
