			"dialogs": [
				{
					"id": 766530501,
					"content": "嗯…这个研究还要不要继续推进啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530502
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 766530502,
					"content": "这是什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766530503,
					"content": "咻咻咻间谍1号！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530504
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 766530504,
					"content": "还是不太懂…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766530505,
					"content": "确切来说，这里是咻咻咻间谍1号的测试平台，而咻咻咻间谍1号是爱诺最新设计的一种潜行机器人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530506
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 766530506,
					"content": "她不久前从黑市收购了一台废弃的清理单元，将其改造后，就得到了现在的咻咻咻间谍1号。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530507
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 766530507,
					"content": "这个平台模拟了很多种危险的敌对环境，可以用来测试咻咻咻间谍1号的潜行能力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530508
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 766530508,
					"content": "爱诺为什么要设计一种潜行机器人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530509
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766530509,
					"content": "发现铛铛七分甜被偷走后，爱诺就下定决心，「无论对方背后有多么强大的势力也要把伙伴救回来」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530510
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 766530510,
					"content": "然后她迅速完成了咻咻咻间谍1号的设计草案，并开始了研发。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530511
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 766530511,
					"content": "按照预期，一旦研发完成，就算是戒备森严的月矩力试验设计局，它也能轻松潜入进去并把伙伴救出来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530512
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 766530512,
					"content": "听上去好厉害啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530513
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766530513,
					"content": "可是爱诺很快就意识到完善方案需要很长时间，于是就又放弃了这个想法，她觉得还是直接掀翻整个挪德卡莱更快一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530514
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 766530514,
					"content": "我决定了！既然要冷静下来慢慢处理，那就继续推进咻咻咻间谍1号的开发，它肯定能为拯救同伴出力的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530515
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 766530515,
					"content": "#既然如此，能不能请{NICKNAME}和派蒙也帮忙测试一下？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530516
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 766530516,
					"content": "根据以往的统计结果，如果有其他测试者提供的数据作为参考，爱诺的开发速度至少可以提升30%。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530517
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 766530517,
					"content": "听上去很有趣，算我一个！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530518
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766530518,
					"content": "也算我一个。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766530519
					]
				},
				{
					"id": 766530519,
					"content": "那我就代爱诺先谢过两位了。我会把权限开放给你们，之后想要进行测试的话直接使用这个平台就可以。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊涅芙"
				}
			]
		}
	]
}