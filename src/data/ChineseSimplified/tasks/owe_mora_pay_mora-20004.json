				"points": []
			},
			"dialogs": [
				{
					"id": 200040501,
					"content": "你们回来了，租金交给歌德了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040502
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 200040502,
					"content": "已经都交给他了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040503
					]
				},
				{
					"id": 200040503,
					"content": "那就好。幸好这间屋子的租金也不算太贵…勉强能把钱凑齐了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040504
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 200040504,
					"content": "不过，看来我又得多吃几天沙拉了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莫娜"
				}
			]
		},
