			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"莫娜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200040301,
					"content": "是你啊，好久不见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040302
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 200040302,
					"content": "怎么一副急匆匆的样子，你找我有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040303
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 200040303,
					"content": "莫娜，你这几天去哪里了呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200040304,
					"content": "找你好几天了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040305
					]
				},
				{
					"id": 200040305,
					"content": "那可真不巧…前几天《蒸汽鸟报》刚向我约了一份新稿件。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040306
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 200040306,
					"content": "主题是「星相的运转变化和个人命运变迁的关系」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040307
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 200040307,
					"content": "为了写这篇稿件，我这几天基本上都在野外观测星象，很晚才回家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040308
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 200040308,
					"content": "为了赚钱，莫娜也真是努力呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200040309,
					"content": "毕竟枫丹廷那边的星象仪又推出了新版嘛，我都已经付了订货押金了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040310
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 200040310,
					"content": "等这篇稿件的稿酬到了，我就能结清尾款，正式拿到那台星象仪了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040311
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 200040311,
					"content": "你还有钱付歌德先生的房租吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040312
					]
				},
				{
					"id": 200040312,
					"content": "房租？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040313
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 200040313,
					"content": "喔…！我、我应该留了钱的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040314
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 200040314,
					"content": "你们等一会，我找找…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040315
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 200040315,
					"content": "（莫娜开始翻起了自己的钱包…）",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						200040316
					]
				},
				{
					"id": 200040316,
					"content": "这些…加上这些！应该够付房租了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040317
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 200040317,
					"content": "（莫娜是把身上的钱都掏光了吗…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040318
					]
				},
				{
					"id": 200040318,
					"content": "你们帮我把这些钱带给歌德先生吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莫娜"
				}
			]
		},
