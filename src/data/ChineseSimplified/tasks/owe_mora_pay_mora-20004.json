			},
			"dialogs": [
				{
					"id": 200040401,
					"content": "怎么样，你们找到那位…呃…你们的那位朋友了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040402
					],
					"speakerTitle": "歌德"
				},
				{
					"id": 200040402,
					"content": "这是租金。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040403
					]
				},
				{
					"id": 200040403,
					"content": "好，好，这些钱够了，谢谢你们啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040404
					],
					"speakerTitle": "歌德"
				},
				{
					"id": 200040404,
					"content": "不过，你们的那位朋友究竟是做什么的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040405
					],
					"speakerTitle": "歌德"
				},
				{
					"id": 200040405,
					"content": "明明看着那么有本事，却总是这么穷…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "歌德"
				}
			]
		},
		{
