			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"宇奈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722040301,
					"content": "唉…越来越不清楚了…越来越记不清事情了呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040302,
						722040303
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040302,
					"content": "您好？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040304
					]
				},
				{
					"id": 722040304,
					"content": "唉…记性越来越差了。人老了，越来越多的事情，记不住了呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040305
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040305,
					"content": "这样怎么可好呀…也不知道木户和木奈有没有饿着，在外面玩安不安全…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040306,
						722040307
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040306,
					"content": "他们不会有事的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040308
					]
				},
				{
					"id": 722040308,
					"content": "木户，木奈！你们怎么才来呀…在路上有没有摔着碰着？没有又去爬树吧…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040309
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040309,
					"content": "真是让奶奶担心坏了…唉，最近不知发生了什么，岛上的人越来越少了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040310
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040310,
					"content": "我还记得名字的人呢，更少了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040311
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040311,
					"content": "唉，要是什么时候，奶奶把你们也忘记了…那该怎么办呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040312
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040312,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040313
					]
				},
				{
					"id": 722040313,
					"content": "唉…这些花瓣给你们，什么时候呀，要是奶奶把你们忘了，就给我看这个吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040314
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040314,
					"content": "奶奶还有好多故事要给你们讲呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040307,
					"content": "我能帮得上忙吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040308
					]
				},
				{
					"id": 722040303,
					"content": "发生什么事了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040304
					]
				}
			]
		},
