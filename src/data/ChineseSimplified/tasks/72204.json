			"dialogs": [
				{
					"id": 722040401,
					"content": "去玩吧，去玩吧…奶奶不会离开的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040402
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040402,
					"content": "花瓣呀…花瓣哟…你的故乡，是什么样子呢…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宇奈"
				}
			]
		},
		{
			"id": 7220405,
			"completionStepIds": [
				7220403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7220403",
