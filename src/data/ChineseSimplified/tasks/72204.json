			"completionStepIds": [
				7220404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7220404",
							"2"
						],
						"stepId": 7220404,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7220410",
							"3"
						],
						"stepId": 7220410,
						"stateName": "QUEST_STATE_FINISHED"
