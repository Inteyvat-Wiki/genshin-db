					"宇奈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722040701,
					"content": "你好，你好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040702
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040702,
					"content": "唉，对不起呀，年纪大了头脑难免不清楚…请问你是谁呀…？我曾认识你吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040703,
						722040704
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040703,
					"content": "#我是{NICKNAME}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040705
					]
				},
				{
					"id": 722040705,
					"content": "没听说过的名字呢…是外面来的人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040706
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040706,
					"content": "奇怪，奇怪…没有雷鸟大人的准许，应该没有人能随随便便来到岛上呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040707,
						722040708
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040707,
					"content": "雷鸟早已不在了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040709
					]
				},
				{
					"id": 722040709,
					"content": "唉…看见你，就让我想起我可怜的丈夫…可现在，我却连他的样子都记不起来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040710
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040710,
					"content": "那时候我们都还年轻，脑子里都是些不切实际的幻想…但有些人，即使在一起过日子久了，也不会长大半点…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040711
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040711,
					"content": "他离我而去，扎了一条木筏想要渡海去另一边，外人的岛上…他说他想要在那里自由地捕猎，采摘没见过的花…好看的花…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040712
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040712,
					"content": "从小时候他就这样说…但他从来没有长大过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040713
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040713,
					"content": "后来，祭司大人的孩子在海滩上看见了他…卧在那里，贝壳一样安静，比海砂还要白…这些花瓣，就握在他的手里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040714
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040714,
					"content": "祭司大人哭了，和我说…先祖的船拒绝了他。他的「灵」此后只能徘徊在外人的土地上了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040715
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040715,
					"content": "那时我才刚刚生下我们的孩子…这种事情，我要怎么与他说才好呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040716
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040716,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040717
					]
				},
				{
					"id": 722040717,
					"content": "后来呀…我的孩子也有了孩子，再后来，我也送孩子们登上了银璨璨的船…但我依然在这个大地上活着…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040718
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040718,
					"content": "我的牵挂呀…也就只有了木户与木奈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040708,
					"content": "很难和您解释其中原因…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040709
					]
				},
				{
					"id": 722040704,
					"content": "#您好，叫我{NICKNAME}就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040705
					]
				}
			]
		},
