			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"宇奈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722040101,
					"content": "木户，木奈，你们来啦…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040102
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040102,
					"content": "真是的…又到处乱跑，我的腿脚可跟不上你们啦…要是遇到危险该怎么办呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040103,
						722040104
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040103,
					"content": "您好…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040105
					]
				},
				{
					"id": 722040105,
					"content": "欸哟！你们真是…你们还小，可不要说这种话呀，这样太伤老人家的心了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040106
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040106,
					"content": "既然来了，就先别乱跑乱玩啦…也来陪陪奶奶，好不好？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040107,
						722040108
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040107,
					"content": "抱歉，我…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040109
					]
				},
				{
					"id": 722040109,
					"content": "上次那个故事讲到哪里了…？啊，对了…那是你们的爷爷的爷爷年纪还小的时候咯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040110
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040110,
					"content": "在雾海之外、外人的岛屿上，有一支氏族叫做夷摩美氏…他们的主母，是一个狐狸样的女人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040111
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040111,
					"content": "他们说，那边的土地上，生满了雷色的花朵…夷摩美氏的族人们，就在那样的高山与田野间筑屋生活，相爱相乐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040112
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040112,
					"content": "然后呀…哈…他们的花呀…哈…呼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040113
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040113,
					"content": "呼…呼…雾海的外面呀…嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040114,
						722040115
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040114,
					"content": "老婆婆…？您还好吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040116
					]
				},
				{
					"id": 722040116,
					"content": "欸…木户？木奈？哦…你们要走了？唉…真不好意思，奶奶又自顾自地睡着了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040117
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040117,
					"content": "临走之前，别忘了这个呀…奶奶一直为你们珍藏着呢…这是雾海之外另一边来的好看的花…可不要丢了哟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040115,
					"content": "（还是不要打扰她了…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040116
					]
				},
				{
					"id": 722040108,
					"content": "好吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040109
					]
				},
				{
					"id": 722040104,
					"content": "可能您认错人了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040105
					]
				}
			]
		},
		{
			"id": 7220402,
