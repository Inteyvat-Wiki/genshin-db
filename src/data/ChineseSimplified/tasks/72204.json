			"trigger": {
				"objectNames": [
					"宇奈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722040501,
					"content": "是阿部呀。家里蘑菇收成如何？呵呵…你可不要再去打扰祭司大人咯，他再劝我也是不会同意的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040502
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040502,
					"content": "呵呵，对不起啦！一个人养家而已，我怎么就忙不过来了？呵呵，对不起啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040503
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040503,
					"content": "对不起啦…唉…对不起啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040504,
						722040505
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040504,
					"content": "您好，老婆婆。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040506
					]
				},
				{
					"id": 722040506,
					"content": "啊…！是你呀！真是的…羞不羞人！快进来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040507,
						722040508
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040507,
					"content": "呃…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040509
					]
				},
				{
					"id": 722040509,
					"content": "在外面的渔获如何…？没有打到鱼吗…没关系，没关系，靠家里的园垄也足够了。只是给雷鸟大人的奉献没办法足额了…嗯，怎么了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040510
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040510,
					"content": "你在犯什么傻！今年的祭典明明很顺利，接下来的年景一定都不错…祭司大人也说我们会有个强壮的孩子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040511
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040511,
					"content": "可为什么突然跟我说这种事！你忘了釜氏的下场吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040512,
						722040513
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040512,
					"content": "请您冷静一点！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040514
					]
				},
				{
					"id": 722040514,
					"content": "如果你也想要离弃雷鸟大人，被狂怒的海浪吞噬的话，那就随便你去吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040515
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040515,
					"content": "我的孩子…可怜的孩子…唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040513,
					"content": "「釜」…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040514
					]
				},
				{
					"id": 722040508,
					"content": "唔……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040509
					]
				},
				{
					"id": 722040505,
					"content": "请问您还好吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040506
					]
				}
			]
		},
