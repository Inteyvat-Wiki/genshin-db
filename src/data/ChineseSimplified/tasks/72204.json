			"dialogs": [
				{
					"id": 722040601,
					"content": "这样吗…你说他的手里握着…这些？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040602
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040602,
					"content": "究竟在想什么呀…你究竟在想些什么呢…",
					"roleType": "TALK_ROLE_NPC",
