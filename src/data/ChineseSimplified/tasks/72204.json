					"宇奈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722040201,
					"content": "好啦…好啦…也让奶奶睡一会吧…嗯…呼…呼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040202
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040202,
					"content": "你们可小心点…别跑太远了…呼…呼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宇奈"
				}
			]
		},
		{
			"id": 7220403,
			"completionStepIds": [
				7220402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7220402",
							"2"
