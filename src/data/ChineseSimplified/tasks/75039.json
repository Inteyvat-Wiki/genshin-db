				]
			},
			"dialogs": [
				{
					"id": 750390401,
					"content": "嗯…唔？呀，呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390402
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750390402,
					"content": "<color=#00E1FFFF>水…请给我水…</color>谢谢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390403
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750390403,
					"content": "我们还是快看看这个躺在地上的家伙吧！他看起来状态很不妙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7503917,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"99902",
							"3"
						],
						"stepId": 99902,
						"stateName": "QUEST_STATE_FINISHED"
					}
