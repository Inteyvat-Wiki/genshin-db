					}
				]
			},
			"dialogs": [
				{
					"id": 750390301,
					"content": "设法帮助了干渴的路人，你们注意到，浸水之后他的体型仿佛大了一圈。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						750390302
					]
				},
				{
					"id": 750390302,
					"content": "呼…哈…哈…咳咳…！谢谢，谢谢你们…差点就出人命了…呜呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390303
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750390303,
					"content": "所以说这家伙……差点守在水源边上把自己渴死吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750390304,
					"content": "欸？原来水源就在这么近的地方吗！唉呀呀…不管怎样，谢谢你们救了我一命！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390305
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750390305,
					"content": "马尼菲科·德·拉·马尼菲桑斯，叫我马尼菲科就好。正如你们所见，我出身枫丹贵胄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390306
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750390306,
					"content": "我的老朋友们有时叫我「警探」，有时叫我「布鲁图斯」，有时叫我「磁先生」…但你们的话，随便什么称呼都行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390307
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750390307,
					"content": "哇…好奇怪的家伙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750390308,
					"content": "哼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390309,
						750390314,
						750390325
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750390309,
					"content": "「警探」…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750390310
					]
				},
				{
					"id": 750390310,
					"content": "我曾经在逐影庭做过几年警探，跟随法兰克·德雷宾警督办过几件大案，后来他升任警司，而我退役了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390311
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750390311,
					"content": "那可真是让人难忘的时光…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390312
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750390312,
					"content": "是啊…男孩遇见女孩，男孩失去女孩，女孩寻找男孩，男孩忘记女孩，男孩记起女孩，女孩被千灵节的映影花车碾压了三遍…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390313
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750390313,
					"content": "那种乱七八糟的时光还是不要回顾啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390332
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750390332,
					"content": "咳咳，总之，从逐影庭退役以后，我无所事事了一段时间，最终决定还是做个摄影家，描摹人与物所固有的生命力…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390333
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750390333,
					"content": "所以我来到了这里，纳塔！诸元素生命力最为璀璨惊心的国度！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390334
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750390334,
					"content": "是挺惊心啦…你差点就干死在这里了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390335
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750390335,
					"content": "嘿嘿，实在是不好意思。我是不会忘记你们救我一命的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390336
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750390336,
					"content": "唔…对了，借你们的地图看一下。嗯…我看看接下来我的目的地在哪里来着？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390348
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750390348,
					"content": "对…这里、这里和…这里！不好意思…地图还给你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390337
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750390337,
					"content": "啊！对了…我的礼貌哪里去了！还不知道你们的名字？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390338
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750390338,
					"content": "#我是{NICKNAME}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750390339
					]
				},
				{
					"id": 750390339,
					"content": "#叫我派蒙就好！还有它，它叫{REALNAME[ID(2)|SHOWHOST(true)]}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390340
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750390340,
					"content": "嗯唔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390341
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750390341,
					"content": "#很好，{NICKNAME}和派蒙，我记住了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390342
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750390342,
					"content": "嗯？唔？吓——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390343
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750390343,
					"content": "#哈哈，别急别急！还有{REALNAME[ID(2)|SHOWHOST(true)]}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390344
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750390344,
					"content": "希望不久后我们能在旅途中再次相见，说不定下次我又要拜托你们帮忙，又说不定我能帮上你们的忙呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390345
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750390345,
					"content": "哇…你要去这么远的地方呀…那小心不要再把自己渴瘪了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390346
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750390346,
					"content": "哈哈，不会的！我们有机会再见咯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390347
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750390347,
					"content": "马尼菲科飞快地打包好行李与饮水，向你们摆手告别。\\n不一会儿，他矮小的身影便从你们的视野中消失了。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 750390314,
					"content": "「布鲁图斯」…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750390315
					]
				},
				{
					"id": 750390315,
					"content": "啊，你可能不知道，我曾在逐影庭做过几年警探，那时候是法兰克·德雷宾警督的部下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390316
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750390316,
					"content": "当时我们在公园里看到五个穿托加长袍的家伙在一百多人面前用刀袭击一个老头，于是「砰、砰、砰、砰、砰！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390317
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750390317,
					"content": "我们把他们全放倒了，地上没有一个喘气的。哈，你觉得自己很幸运吗，小贼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390318
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750390318,
					"content": "哇……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750390319,
					"content": "哇……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390320
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750390320,
					"content": "后来警长告诉我，那是一帮科学院的行政科员，正在排练《雷穆利亚》。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390321
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750390321,
					"content": "欸？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390322
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750390322,
					"content": "所以，「布鲁图斯」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390323
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750390323,
					"content": "呜嗷？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390324
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750390324,
					"content": "不过反正没什么关系，当时科学院正在裁撤冗员，他们早晚得下岗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390332
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750390325,
					"content": "「磁先生」…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750390326
					]
				},
				{
					"id": 750390326,
					"content": "当然是说我超凡的人格魅力，每个认识我的人都会不可避免地被我所吸引！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390327
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750390327,
					"content": "噫……！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390328
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750390328,
					"content": "以及…所有不起眼的金属小物件、零散摩拉、细小首饰什么的，都会莫名其妙被吸引到我的裤兜里！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390329
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750390329,
					"content": "那应该叫「盗窃癖」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390330
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750390330,
					"content": "没错，那正是我们家族的美德之一！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390331
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750390331,
					"content": "咿——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390332
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				}
			]
		},
