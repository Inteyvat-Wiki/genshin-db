			"dialogs": [
				{
					"id": 750390101,
					"content": "你好，黑暗，我的老朋友…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390102
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750390102,
					"content": "呜哇…是一个…说话像大人的小孩子，好奇怪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750390103,
					"content": "欸？等等，这不是「了不起的马尼菲科」吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390104,
						750390107,
						750390110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750390104,
					"content": "马…马什么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750390105
					]
				},
				{
					"id": 750390105,
					"content": "马…马尼菲科，了不起的马尼菲科！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390106
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750390106,
					"content": "呃…我知道我现在的样子有那么一点点落魄，但请给我点水，救救我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390119
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750390119,
					"content": "水…请给我水…谢谢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390120
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750390120,
					"content": "哇…这家伙又变回半死不活的样子了…我们救救他吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750390107,
					"content": "一点也不像是「了不起」的样子呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750390108
					]
				},
				{
					"id": 750390108,
					"content": "变得像小鱼干一样了，真可怜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750390109,
					"content": "喂！有点身为人类的同理心好吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390119
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750390110,
					"content": "你好，我是黑暗，你的老朋友。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750390111
					]
				},
				{
					"id": 750390111,
					"content": "什么…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750390112,
					"content": "哈！对，就是那首歌！我也喜欢那个！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390113
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750390113,
					"content": "啊…西梅翁和卡本克尔兄弟，怎么也听不倦…说起来，我上一个工作还是因为他们丢的。所以我才会到这里来，冒这该死的险…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390114
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750390114,
					"content": "呃…不过那就是后话啦，嘿嘿。现在要紧的是，给我整点水喝，好吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390115
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750390115,
					"content": "毕竟，嗯，嘿嘿…就是，呵呵，真不好意思，我要渴死了，嘿嘿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390116
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750390116,
					"content": "性命关天的事，你傻笑个什么劲啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750390117,
					"content": "不知道，回光返照吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390118
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750390118,
					"content": "哦…啊？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390119
					],
					"speakerTitle": "派蒙"
				}
			]
		},
