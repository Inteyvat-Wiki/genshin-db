			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"马尼菲科"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750391701,
					"content": "设法帮助了干渴的路人，你们注意到，浸水之后他的体型仿佛大了一圈。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						750391702
					]
				},
				{
					"id": 750391702,
					"content": "呼…咳咳！咳咳！谢谢你们…但是，咳咳…救人的方式可以少点攻击性啦…我可不会游泳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391703
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750391703,
					"content": "没关系，到时候我们再想办法把你捞回来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391704
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750391704,
					"content": "我宁愿你们不要到时候再想办法…不过不管怎么样，谢谢你们救了我一命！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391705
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750391705,
					"content": "马尼菲科·德·拉·马尼菲桑斯，叫我马尼菲科就好。正如你们所见，我出身枫丹贵胄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391706
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750391706,
					"content": "我的老朋友们有时叫我「警探」，有时叫我「布鲁图斯」，有时叫我「磁先生」…但你们的话，随便什么称呼都行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391707
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750391707,
					"content": "哇…好奇怪的家伙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391708
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750391708,
					"content": "哼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391709,
						750391714,
						750391725
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750391709,
					"content": "「警探」…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750391710
					]
				},
				{
					"id": 750391710,
					"content": "我曾经在逐影庭做过几年警探，跟随法兰克·德雷宾警督办过几件大案，后来他升任警司，而我退役了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391711
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750391711,
					"content": "那可真是让人难忘的时光…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391712
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750391712,
					"content": "是啊…男孩遇见女孩，男孩失去女孩，女孩寻找男孩，男孩忘记女孩，男孩记起女孩，女孩被千灵节的映影花车碾压了三遍…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391713
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750391713,
					"content": "那种乱七八糟的时光还是不要回顾啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391732
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750391732,
					"content": "咳咳，总之，从逐影庭退役以后，我无所事事了一段时间，最终决定还是做个摄影家，描摹人与物所固有的生命力…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391733
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750391733,
					"content": "所以我来到了这里，纳塔！诸元素生命力最为璀璨惊心的国度！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391734
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750391734,
					"content": "是挺惊心啦…你差点就干死在这里了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391735
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750391735,
					"content": "嘿嘿，实在是不好意思。我是不会忘记你们救我一命的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391736
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750391736,
					"content": "这样，我接下来要去的地方…让我在你的地图上标记出来…嗯，在这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391737
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750391737,
					"content": "啊！对了…我的礼貌哪里去了！还不知道你们的名字？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391738
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750391738,
					"content": "#我是{NICKNAME}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750391739
					]
				},
				{
					"id": 750391739,
					"content": "#叫我派蒙就好！还有它，它叫{REALNAME[ID(2)|SHOWHOST(true)]}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391740
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750391740,
					"content": "嗯唔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391741
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750391741,
					"content": "#很好，{NICKNAME}和派蒙，我记住了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391742
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750391742,
					"content": "嗯？唔？吓——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391743
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750391743,
					"content": "#哈哈，别急别急！还有{REALNAME[ID(2)|SHOWHOST(true)]}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391744
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750391744,
					"content": "希望不久后我们能在旅途中再次相见，说不定下次我又要拜托你们帮忙，又说不定我能帮上你们的忙呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391745
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750391745,
					"content": "哇…你要去这么远的地方呀…那小心不要再把自己渴瘪了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391746
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750391746,
					"content": "哈哈，不会的！我们有机会再见咯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391747
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750391747,
					"content": "马尼菲科飞快地打包好行李与饮水，向你们摆手告别。\\n不一会儿，他矮小的身影便从你们的视野中消失了。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 750391714,
					"content": "「布鲁图斯」…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750391715
					]
				},
				{
					"id": 750391715,
					"content": "啊，你可能不知道，我曾在逐影庭做过几年警探，那时候是法兰克·德雷宾警督的部下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391716
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750391716,
					"content": "当时我们在公园里看到五个穿托加长袍的家伙在一百多人面前用刀袭击一个老头，于是「砰、砰、砰、砰、砰！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391717
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750391717,
					"content": "我们把他们全放倒了，地上没有一个喘气的。哈，你觉得自己很幸运吗，小贼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391718
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750391718,
					"content": "哇……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391719
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750391719,
					"content": "哇……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391720
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750391720,
					"content": "后来警长告诉我，那是一帮科学院的行政科员，正在排练《雷穆利亚》。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391721
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750391721,
					"content": "欸？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391722
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750391722,
					"content": "所以，「布鲁图斯」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391723
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750391723,
					"content": "呜嗷？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391724
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750391724,
					"content": "不过反正没什么关系，当时科学院正在裁撤冗员，他们早晚得下岗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391732
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750391725,
					"content": "「磁先生」…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750391726
					]
				},
				{
					"id": 750391726,
					"content": "当然是说我超凡的人格魅力，每个认识我的人都会不可避免地被我所吸引！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391727
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750391727,
					"content": "噫……！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391728
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750391728,
					"content": "以及…所有不起眼的金属小物件、零散摩拉、细小首饰什么的，都会莫名其妙被吸引到我的裤兜里！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391729
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750391729,
					"content": "那应该叫「盗窃癖」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391730
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750391730,
					"content": "没错，那正是我们家族的美德之一！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391731
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750391731,
					"content": "咿——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391732
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				}
			]
		},
