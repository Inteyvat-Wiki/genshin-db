			"dialogs": [
				{
					"id": 413320301,
					"content": "「万民堂」的餐怎么还没送来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320302
					],
					"speakerTitle": "竺子"
				},
				{
					"id": 413320302,
					"content": "你的餐到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413320303
					]
				},
				{
					"id": 413320303,
					"content": "啊！谢谢你，我还以为再过一会才能送到呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320304
					],
					"speakerTitle": "竺子"
				},
				{
					"id": 413320304,
					"content": "璃月这个海灯节的氛围，我都有点想家了，但是…稻妻我应该暂时回不去了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320305
					],
					"speakerTitle": "竺子"
				},
				{
					"id": 413320305,
					"content": "不知道，稻妻那边现在是什么情况…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "竺子"
				}
			]
		},
