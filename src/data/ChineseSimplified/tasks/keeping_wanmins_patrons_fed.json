					"卯师傅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413321401,
					"content": "餐送到了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321402
					],
					"speakerTitle": "卯师傅"
				},
				{
					"id": 413321402,
					"content": "送到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413321403
					]
				},
				{
					"id": 413321403,
					"content": "好，请你帮忙果然没错，王扳子、观海还有志华想吃的菜也都问到了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321404
					],
					"speakerTitle": "卯师傅"
				},
				{
					"id": 413321404,
					"content": "王扳子和李锤子想吃腌笃鲜。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413321405
					]
				},
				{
					"id": 413321405,
					"content": "哦？这哥俩口味倒一致，不过腌笃鲜可是费工夫的菜，我得早些准备。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321407
					],
					"speakerTitle": "卯师傅"
				},
				{
					"id": 413321407,
					"content": "观海想吃松鼠鱼。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413321408
					]
				},
				{
					"id": 413321408,
					"content": "没问题，这菜我拿手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321409
					],
					"speakerTitle": "卯师傅"
				},
				{
					"id": 413321409,
					"content": "志华想吃莲花酥。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413321410
					]
				},
				{
					"id": 413321410,
					"content": "没想到志华喜欢吃这种小巧精致的点心，不过莲花酥也不难做，没问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321411
					],
					"speakerTitle": "卯师傅"
				},
				{
					"id": 413321411,
					"content": "谢谢你帮我去打听了，这点薄礼你可得收下，我得赶快去忙活了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321412
					],
					"speakerTitle": "卯师傅"
				},
				{
					"id": 413321412,
					"content": "你不挂霄灯吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413321413
					]
				},
				{
					"id": 413321413,
