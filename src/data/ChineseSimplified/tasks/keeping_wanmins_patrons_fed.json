					"卯师傅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413320201,
					"content": "还有几份来着…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320202
					],
					"speakerTitle": "卯师傅"
				},
				{
					"id": 413320202,
					"content": "在忙些什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413320203
					]
				},
				{
					"id": 413320203,
					"content": "哈哈，我还能忙些什么，当然是「万民堂」的生意嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320204
					],
					"speakerTitle": "卯师傅"
				},
				{
					"id": 413320204,
					"content": "最近赶上海灯节，出来下馆子的人特别多，还有不少凑热闹的外国游客。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320205
					],
					"speakerTitle": "卯师傅"
				},
				{
					"id": 413320205,
					"content": "虽然我闺女香菱也回来帮忙了，但她也是忙得脚后跟不沾地，这不，刚刚出去送菜去了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320206
					],
					"speakerTitle": "卯师傅"
				},
				{
					"id": 413320206,
					"content": "别人家早挂上霄灯过节去了，咱家「万民堂」可是忙得连霄灯都没空编啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320207
					],
					"speakerTitle": "卯师傅"
				},
				{
					"id": 413320207,
					"content": "对了旅行者，如果你愿意的话，能帮我个忙吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320208
					],
					"speakerTitle": "卯师傅"
				},
				{
					"id": 413320208,
					"content": "你认识竺子吧？就是那个在码头上的小姑娘，从稻妻来的那个。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320209
					],
					"speakerTitle": "卯师傅"
				},
				{
					"id": 413320209,
					"content": "她在我们这里订了份吃的，请你帮我送过去吧，大过节的，我特意给她做的分量大了些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320210
					],
					"speakerTitle": "卯师傅"
				},
				{
					"id": 413320210,
					"content": "还有总是在码头上忙的那几位，<color=#00E1FFFF>王扳子、李锤子、观海、志华…</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320211
					],
					"speakerTitle": "卯师傅"
				},
				{
					"id": 413320211,
					"content": "这几位总是照顾我们店的生意，这大过节的他们也还在码头上，估计也是因为工作吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320212
					],
					"speakerTitle": "卯师傅"
				},
				{
					"id": 413320212,
					"content": "我也想给他们几位都准备点好吃的，也算是过个节。但我这店里太忙了，实在是抽不开身…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320213
					],
					"speakerTitle": "卯师傅"
				},
				{
					"id": 413320213,
					"content": "旅行者，你就顺便帮我去问问他们最想吃什么吧，我好给他们准备菜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320214
					],
					"speakerTitle": "卯师傅"
				},
				{
					"id": 413320214,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413320215
					]
				},
				{
					"id": 413320215,
					"content": "那就拜托你了，问到了之后就赶紧回来告诉我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卯师傅"
				}
			]
		},
