			"dialogs": [
				{
					"id": 6070201,
					"content": "汝等无需惊恐，魔物已被消灭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070202
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 6070202,
					"content": "小姐的意思是，接下来也请不要随意外出，留在室内便好。我们会尽可能保证这一带居民的安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070203
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 6070203,
					"content": "非常感谢！非常感谢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070204
					],
					"speakerTitle": "帕斯里"
				},
				{
					"id": 6070204,
					"content": "不过，这只…这只大鸟竟然也会说话吗？哎呀…这…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070205
					],
					"speakerTitle": "帕斯里"
				},
				{
					"id": 6070205,
					"content": "噢，您不必多虑，我只是小姐的臣子，绝不是乡野魔物，更不会对各位造成任何威胁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070206
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 6070206,
					"content": "这两位都是好人，请放心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						6070207
					]
				},
				{
					"id": 6070207,
					"content": "啊、啊当然，我不是那个意思！抱歉，抱歉，都怪我口不择言的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070208
					],
					"speakerTitle": "帕斯里"
				},
				{
					"id": 6070208,
					"content": "嗯哼，无妨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070209
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 6070209,
					"content": "扈从，还有要事在身么？尽管去铲平余孽吧，光辉的皇女祝福你的前路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菲谢尔"
				}
			]
