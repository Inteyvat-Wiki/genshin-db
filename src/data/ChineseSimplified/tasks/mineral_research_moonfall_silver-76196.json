			},
			"dialogs": [
				{
					"id": 761960301,
					"content": "你看看，应该没有遗漏吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960302
					],
					"speakerTitle": "莉奈娅"
				},
				{
					"id": 761960302,
					"content": "嗯——没问题，不多也不少！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960303
					],
					"speakerTitle": "多洛妲"
				},
				{
					"id": 761960303,
					"content": "我看到你用月落银在地上摆出了有趣的图案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960304
					],
					"speakerTitle": "莉奈娅"
				},
				{
					"id": 761960304,
					"content": "是呀！花费了不少心思呢，我觉得这样更能激起大家对于月落银的喜爱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960305
					],
					"speakerTitle": "多洛妲"
				},
				{
					"id": 761960305,
					"content": "说起来，我听说纳塔的民间故事里有这么一条…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960306
					],
					"speakerTitle": "莉奈娅"
				},
				{
					"id": 761960306,
					"content": "说的是原本住在星星上的少女坠落大地后，为了重返上天而在大地之上留下了巨大的涂鸦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960307
					],
					"speakerTitle": "莉奈娅"
				},
				{
					"id": 761960307,
					"content": "之后，她在天上的太阳父亲果然看到了她的请求，将她带回了天上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960308
					],
					"speakerTitle": "莉奈娅"
				},
				{
					"id": 761960308,
					"content": "说不定他也能看到多洛妲摆出的图案，就此成为月落银的粉丝呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960309
					],
					"speakerTitle": "莉奈娅"
				},
				{
					"id": 761960309,
					"content": "哈哈哈！如果是这样，那我就是最了不起的月落银推广大使了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960310
					],
					"speakerTitle": "多洛妲"
				},
				{
					"id": 761960310,
					"content": "不过比起那个，我还是更担心被天上的飞鸟盯上，你也知道，乌鸦之类的不是很喜欢亮晶晶的东西嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960311
					],
					"speakerTitle": "多洛妲"
				},
				{
					"id": 761960311,
					"content": "说得也是，而且除了乌鸦，也得小心地上的嗅嗅鼹鼠和盗宝鼬之类的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960312
					],
					"speakerTitle": "莉奈娅"
				},
				{
					"id": 761960312,
					"content": "还有露米！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960313
					],
					"speakerTitle": "多洛妲"
				},
				{
