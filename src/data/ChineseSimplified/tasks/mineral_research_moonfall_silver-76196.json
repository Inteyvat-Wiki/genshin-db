			"dialogs": [
				{
					"id": 761960201,
					"content": "多洛妲！你怎么在这里？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960202
					],
					"speakerTitle": "莉奈娅"
				},
				{
					"id": 761960202,
					"content": "莉奈娅，你来得正好！我刚才在向大家说明月落银的美妙之处呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960203
					],
					"speakerTitle": "多洛妲"
				},
				{
					"id": 761960203,
					"content": "月落银啊月落银，月下世界还有比你更完美的宝石吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960204
					],
					"speakerTitle": "多洛妲"
				},
				{
					"id": 761960204,
					"content": "看！无可挑剔的造型，珠圆玉润的感触！还有它那五彩斑斓的白，无与伦比的元素亲和力！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960205
					],
					"speakerTitle": "多洛妲"
				},
				{
					"id": 761960205,
					"content": "在我心目中，只有天上的月亮能与你媲美！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960206
					],
					"speakerTitle": "多洛妲"
				},
				{
					"id": 761960206,
					"content": "月落银的确是很漂亮的矿石，我也收集了一些做标本。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960207
					],
					"speakerTitle": "莉奈娅"
				},
				{
					"id": 761960207,
					"content": "对吧对吧！我就知道你会懂我的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960208
					],
					"speakerTitle": "多洛妲"
				},
				{
					"id": 761960208,
					"content": "不过呢，最懂月落银的一定还是我！就算你是协会的顾问，这个第一的位置我也不会让给你的，哼哼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960209
					],
					"speakerTitle": "多洛妲"
				},
				{
					"id": 761960209,
					"content": "对了，平时都是你来给冒险家讲课，今天就让我考考你吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960210
					],
					"speakerTitle": "多洛妲"
				},
				{
					"id": 761960210,
					"content": "我这儿有三颗月落银，非常遗憾，其中两颗有些细微的瑕疵，而另一颗则是我的珍藏，是月落银中的月落银！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960211
					],
					"speakerTitle": "多洛妲"
				},
				{
					"id": 761960211,
					"content": "你能够分辨出哪一颗才是最完美的月落银吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960212
					],
					"speakerTitle": "多洛妲"
				},
				{
					"id": 761960212,
					"content": "让我看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960213,
						761960220,
						761960225
					],
					"speakerTitle": "莉奈娅"
				},
				{
					"id": 761960213,
					"content": "左边这个…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960214
					],
					"speakerTitle": "莉奈娅"
				},
				{
					"id": 761960214,
					"content": "（咦？露米这是在…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960215,
						761960231
					],
					"speakerTitle": "莉奈娅"
				},
				{
					"id": 761960215,
					"content": "就选这个了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960216
					],
					"speakerTitle": "莉奈娅"
				},
				{
					"id": 761960216,
					"content": "莉奈娅也会有看走眼的时候呀，其实这颗在很不起眼的地方有一点点微小的瑕疵呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960217
					],
					"speakerTitle": "多洛妲"
				},
				{
					"id": 761960217,
					"content": "唔，我认输了…不过下次，下次我可不会这么轻易输掉了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960218
					],
					"speakerTitle": "莉奈娅"
				},
				{
					"id": 761960218,
					"content": "好啊，随时奉陪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960232
					],
					"speakerTitle": "多洛妲"
				},
				{
					"id": 761960232,
					"content": "顺势参加了多洛妲主办的月落银鉴赏大会，度过了一段愉快的时光…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761960219
					]
				},
				{
					"id": 761960219,
					"content": "没想到大家都这么热情，可惜像这样美好的时光总是转瞬即逝…差不多该收拾收拾了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960233
					],
					"speakerTitle": "多洛妲"
				},
				{
					"id": 761960233,
					"content": "我来帮你吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960234
					],
					"speakerTitle": "莉奈娅"
				},
				{
					"id": 761960234,
					"content": "那太好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "多洛妲"
				},
				{
					"id": 761960231,
					"content": "我再想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960212
					],
					"speakerTitle": "莉奈娅"
				},
				{
					"id": 761960220,
					"content": "中间这个…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960221
					],
					"speakerTitle": "莉奈娅"
				},
				{
					"id": 761960221,
					"content": "（露米好像很喜欢这个呢。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960222,
						761960231
					],
					"speakerTitle": "莉奈娅"
				},
				{
					"id": 761960222,
					"content": "就选这个了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960223
					],
					"speakerTitle": "莉奈娅"
				},
				{
					"id": 761960223,
					"content": "啊，你也可以感受到吧！来自完美之物的不可抵抗的魅力…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960232
					],
					"speakerTitle": "多洛妲"
				},
				{
					"id": 761960225,
					"content": "右边这个…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960226
					],
					"speakerTitle": "莉奈娅"
				},
				{
					"id": 761960226,
					"content": "（咦？露米这是在…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960227,
						761960231
					],
					"speakerTitle": "莉奈娅"
				},
				{
					"id": 761960227,
					"content": "就选这个了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960228
					],
					"speakerTitle": "莉奈娅"
				},
				{
					"id": 761960228,
					"content": "莉奈娅也会有看走眼的时候呀，其实这颗在很不起眼的地方有一点点微小的瑕疵呢。",
					"roleType": "TALK_ROLE_NPC",
