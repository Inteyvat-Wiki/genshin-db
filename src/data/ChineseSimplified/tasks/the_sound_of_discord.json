			},
			"dialogs": [
				{
					"id": 700010401,
					"content": "嗯？怎么了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010402
					],
					"speakerTitle": "焦躁的市民"
				},
				{
					"id": 700010402,
					"content": "风花天上飘…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010403
					]
				},
				{
					"id": 700010403,
					"content": "风花？什么风花，你是说蒲公英吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010404
					],
					"speakerTitle": "焦躁的市民"
				},
				{
					"id": 700010404,
					"content": "那又怎么了，挺正常的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010405
					],
					"speakerTitle": "焦躁的市民"
				},
				{
					"id": 700010405,
					"content": "不好意思，打扰了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700010406,
					"content": "看起来好像是普通的市民，我们问问其他人吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7000105,
			"completionStepIds": [
				7000107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7000107",
							"2"
						],
