				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"失落的市民"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700010501,
					"content": "到底还有没有机会呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010502
					],
					"speakerTitle": "失落的市民"
				},
				{
					"id": 700010502,
					"content": "怎么了？有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010503
					],
					"speakerTitle": "失落的市民"
				},
				{
					"id": 700010503,
					"content": "风花天上飘…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010504
					]
				},
				{
					"id": 700010504,
					"content": "嗯，是啊，你是想说，「不管发生了什么，还是要好好享受风花节」吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010505
					],
					"speakerTitle": "失落的市民"
				},
				{
					"id": 700010505,
					"content": "也对，不能因为被拒绝了就灰心丧气啊，节日还没有结束呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010506
					],
					"speakerTitle": "失落的市民"
				},
				{
					"id": 700010506,
					"content": "谢谢你的鼓励，我会振作起来的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010507
					],
					"speakerTitle": "失落的市民"
				},
				{
					"id": 700010507,
					"content": "好像被误解了，不过这样的人，应该不会有嫌疑吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7000106,
			"completionStepIds": [
				7000111
			],
