				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"薇尔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700010201,
					"content": "啊呀，旅行者，又见面了，怎么样，还喜欢城里的气氛吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010202
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 700010202,
					"content": "挺喜欢的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010203
					]
				},
				{
					"id": 700010203,
					"content": "你喜欢就好。不过…虽然很不符合现在的氛围，但我还是有件和风花节有关的事要拜托你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010204
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 700010204,
					"content": "不对，准确地说，是「那位先生」又有事拜托你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010205
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 700010205,
					"content": "风花节期间不是不能随便拜托人做事吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010206
					]
				},
				{
					"id": 700010206,
					"content": "这个啊，这不用担心。因为我要拜托你的这件事，并不在风花节的这条规则内。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010207
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 700010207,
					"content": "你也注意到了吧，每年的风花节都非常热闹，市民来来往往，熙熙攘攘，差不多都沉醉在节日的气氛中，西风骑士因为要维持秩序，也忙得不可开交…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010208
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 700010208,
					"content": "毫无防备的拥挤人群、忙得不可开交的西风骑士，对于那群盗宝团来说，这当然是适合作案的好机会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010209
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 700010209,
					"content": "根据「那位先生」的情报，有些盗宝团成员已经趁乱混进了城，正在城门口的各家店铺附近假装庆祝节日，实际上是为后续的行动踩点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010210
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 700010210,
					"content": "如果骑士团大张旗鼓地搜寻，一方面会打草惊蛇，一方面也一定会坏了节日的气氛。但又不能放着他们不管…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010211
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 700010211,
					"content": "所以，你就又来找我了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010212
					]
				},
				{
					"id": 700010212,
					"content": "那是当然，这次可也是「那位先生」专门指名的你，根据他的说法，你可是解决这件事的不二人选。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010213
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 700010213,
					"content": "好了，我们说正事。据我打听来的情报，混进来的那群盗宝团为了彼此标记身份，都带着一个<color=#00E1FFFF>小包</color>，而且在确认同伴身份的时候，还会用到一组<color=#00E1FFFF>暗号</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010214
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 700010214,
					"content": "<color=#00E1FFFF>「风花天上飘，行人细细瞧。」</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010215,
						700010216
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 700010215,
					"content": "真是够好记的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010217
					]
				},
				{
					"id": 700010217,
					"content": "能对上暗号的就是混进城里的盗宝团了，而且从他们的口中，应该能套出野外营地的情报。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010218
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 700010218,
					"content": "套出情报后，就拜托你顺便将他们全部击退吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010219
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 700010219,
					"content": "为什么不直接交给骑士团？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010220
					]
				},
				{
					"id": 700010220,
					"content": "为了维持节日期间城内的秩序，骑士团一定已经忙得焦头烂额了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010221
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 700010221,
					"content": "在这个时候，能够为他们分一点忧，就分一点忧吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010222
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 700010222,
					"content": "那就拜托你了，「荣誉骑士」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "薇尔"
				},
				{
					"id": 700010216,
					"content": "是他们的风格。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010217
					]
				}
			]
		},
		{
			"id": 7000103,
			"completionStepIds": [
				7000103
