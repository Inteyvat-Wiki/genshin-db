	"talks": [
		{
			"id": 7000102,
			"completionStepIds": [
				7000102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7000102",
							"2"
						],
						"stepId": 7000102,
						"stateName": "QUEST_STATE_UNFINISHED"
