			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"小蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210280101,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}！你来得正好，我有事情想问你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280102,
						210280103
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210280102,
					"content": "有什么事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280105
					]
				},
				{
					"id": 210280105,
					"content": "爸爸说，去须弥的路程很远，需要准备一些药物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280106
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210280106,
					"content": "治疗头痛的、防止腹泻的，防止中暑的…还有解酒的，消食的…好多好多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280107
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210280107,
					"content": "为什么还要准备解酒的药啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 210280108,
					"content": "谈生意的时候要用吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280109
					]
				},
				{
					"id": 210280109,
					"content": "欸？谈生意和解酒药有什么关系，难道喝酒喝得多，生意就会做得好吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 210280110,
					"content": "总之，爸爸要我去「不卜庐」问问，那些药物准备得怎么样了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280111
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210280111,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，你能陪我去吗？有些事，我想要请你帮帮忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280112,
						210280113
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210280112,
					"content": "走吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280115
					]
				},
				{
					"id": 210280115,
					"content": "#我们走吧，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210280113,
					"content": "你…有什么事要我帮忙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280114
					]
				},
				{
					"id": 210280114,
					"content": "到那边再说吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280115
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210280103,
					"content": "旅行准备得怎么样了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280104
					]
				},
				{
					"id": 210280104,
					"content": "大部分都是我爸爸和那群叔叔在准备啦…但是爸爸也交给我了一些任务！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280105
					],
					"speakerTitle": "小蒙"
				}
			]
		},
		{
			"id": 2102802,
			"completionStepIds": [
				2102803
			],
