			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿桂",
					"小蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210280201,
					"content": "你好，请问是来抓药的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280202
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 210280202,
					"content": "咦？这不是小蒙吗？你怎么来了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280203
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 210280203,
					"content": "噢…我知道了，你是来问那些药物的事吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280204
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 210280204,
					"content": "放心吧，那些药物我基本上都准备好了，会分批送去给你爸爸的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280205
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 210280205,
					"content": "不过你爸爸要的药物量太大，店里囤的一些药材都快用完了，可能有一些药会做得慢一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280206
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 210280206,
					"content": "我看看啊，嗯…主要是薄荷没剩下多少，所以治疗中暑的药也没法做了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280207
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 210280207,
					"content": "毕竟，除了制作你爸爸的药物订单之外，我们也要给其他人看病啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280208
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 210280208,
					"content": "那…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280209,
						210280211
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210280209,
					"content": "轮到我出场了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280210
					]
				},
				{
					"id": 210280210,
					"content": "#嘿嘿，谢谢{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280213
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210280213,
					"content": "那药材的事就拜托你啦，我要留在这里仔细核查一下药物。这是爸爸特意叮嘱我的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280214
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210280214,
					"content": "这孩子还挺认真的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280215
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 210280215,
					"content": "那你和我进来吧，我把这一批的药物清单给你看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280216
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 210280216,
					"content": "呜啊…怎么这么多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280217
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210280217,
					"content": "你先看这些，我把另外一批拿过来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280218
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 210280218,
					"content": "欸？还有吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210280211,
					"content": "我可要收取报酬喔。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280212
					]
				},
				{
					"id": 210280212,
					"content": "#嘿嘿，没问题！谢谢{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280213
					],
					"speakerTitle": "小蒙"
				}
			]
		},
