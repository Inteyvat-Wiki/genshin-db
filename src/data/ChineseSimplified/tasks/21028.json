			"dialogs": [
				{
					"id": 210280401,
					"content": "#谢谢{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280402
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210280402,
					"content": "嗯，这些应该够我做一些药了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280403
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 210280403,
					"content": "那些治疗中暑的药物，我会放在下批药物里一起送过去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280404
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 210280404,
					"content": "那就辛苦你啦，阿桂哥哥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280405
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210280405,
					"content": "#这些东西给你，谢谢你帮忙，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，我们回去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280406
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210280406,
					"content": "嘿嘿，爸爸听到这个消息肯定会高兴…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280407
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210280407,
					"content": "小蒙，你等一会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280408
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 210280408,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280409
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210280409,
					"content": "你不是要核查药物吗？后面的清单你还没看完呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280410
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 210280410,
					"content": "欸…欸？我刚才不是核查了那么久…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280411
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210280411,
					"content": "那才核查了多少，来吧小蒙，我们继续核查。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280412
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 210280412,
					"content": "呜…好…好吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小蒙"
				}
			]
		},
