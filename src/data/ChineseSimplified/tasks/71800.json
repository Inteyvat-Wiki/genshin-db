					"萍姥姥"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718000301,
					"content": "哎呀，还真的荡出来了…$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718000302,
						718000305
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 718000302,
					"content": "婆婆，我衣服都湿透了…$UNRELEASED",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718000303
					]
				},
				{
					"id": 718000303,
					"content": "对不住啊孩子们，是我考虑少了，唉，我还以为没蓄多少水呢。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718000304
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 718000304,
					"content": "不过，这壶大体上应该也弄干净了，剩下的那些边边角角，就慢慢打扫吧。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718000307
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 718000307,
					"content": "婆婆，您是把整条碧水河的水都装进去了吗…$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718000308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 718000308,
					"content": "你这孩子，怎么可能，这城里的人还得用水呢…我就只装了半条河的水而已。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718000309
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 718000309,
					"content": "好了孩子们，这次让你们遭罪了。这些东西拿着，辛苦你们啦。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718000310
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 718000310,
					"content": "对了，我还得找个时间，把这壶里的水倒回河里去…$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 718000305,
					"content": "里面应该也打扫干净了。$UNRELEASED",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718000306
					]
				},
				{
					"id": 718000306,
					"content": "唔，但还有些边边角角，得进去细致打扫啊。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718000307
					],
					"speakerTitle": "萍姥姥"
				}
			]
		},
