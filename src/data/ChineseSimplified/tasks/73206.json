			},
			"dialogs": [
				{
					"id": 732050501,
					"content": "♪蔷薇啊蔷薇，实现我的愿望…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050502
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050502,
					"content": "嗯？你们还在啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050503,
						732050513
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050503,
					"content": "为什么住在这里？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050504
					]
				},
				{
					"id": 732050504,
					"content": "呵呵，反正我是个怪老头，「怪老头做事哪有为什么」，很少有人像你这样问我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050505
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050505,
					"content": "我啊，这一辈子总想出去闯荡，想抓住机会做点什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050506
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050506,
					"content": "刚结婚不久的时候差点儿跟着镀金旅团离开，但想想总觉得不能抛下老婆出去漂泊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050507
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050507,
					"content": "后来遇到行脚商，我又想跟着出去跑生意，最终因为本钱不够没走成。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050508
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050508,
					"content": "再后来老太婆不在了，我没牵挂了，可是年纪已经太老，没法离开了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050509
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050509,
					"content": "拖拖拉拉混到今天，我错过的事情太多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050510
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050510,
					"content": "回过头发现自己不属于这个村子，也不属于其他任何地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050511
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050511,
					"content": "最后结果么，就是我一个人搬到村子边上生活才舒服。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050512
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050512,
					"content": "几十年也就这么回事，算了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050525
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050525,
					"content": "这些花开了我就叫你们来看，明天或者后天，它们说不定就开了，你有空来看吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050526
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050526,
					"content": "没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050527
					]
				},
				{
					"id": 732050527,
					"content": "好好好，我知道了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050528
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050528,
					"content": "♪蔷薇啊蔷薇，实现我的愿望…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050513,
					"content": "关于鬼老头…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050514
					]
				},
				{
					"id": 732050514,
					"content": "也就只有外来的人会打听鬼老头的事了，我们村里的小孩可都知道这个名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050515
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050515,
					"content": "哪家孩子不听话，孩子的父母就吓唬他：马上鬼老头要来把你抓走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050516
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050516,
					"content": "这些年轻人啊，一个都不认识鬼老头，倒挺会把他的名头搬出来吓人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050517
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050517,
					"content": "我小的时候可是见过鬼老头本人的，他是讨厌小孩子没错，但长得也不恐怖。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050518
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050518,
					"content": "不知道怎么就被传成了鬼老头，我看都是一帮闲人在背后胡说八道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050519
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050519,
					"content": "你们不是朋友吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050520
					]
				},
				{
					"id": 732050520,
					"content": "我还小的时候，经常溜到他的小花园附近玩，他一发现，就会挥着锄头把我赶走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050521
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050521,
					"content": "他八成只把我当成去捣乱的调皮小子，哪里会记得我哟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050522
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050522,
					"content": "虽然他不一定认识我，但我还是一直记得他和他的小花园。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050523
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050523,
					"content": "我说他是我的朋友，也不算错，不是吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050524
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050524,
					"content": "就当是为了还原我记忆里的小花园，我也会把这些花种出来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050525
					],
					"speakerTitle": "阿凡"
				}
			]
		},
		{
			"id": 7320601,
			"completionStepIds": [
				7320601
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320601",
							"2"
						],
						"stepId": 7320601,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"阿凡"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732060101,
					"content": "你们来了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060102
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732060102,
					"content": "种子怎么样了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060103
					]
				},
				{
					"id": 732060103,
					"content": "所有的种子都还没有抽芽…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060104
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732060104,
					"content": "我检查过种子表面了，连一点点发芽的迹象都没有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060105
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732060105,
					"content": "这到底是为什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060106
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732060106,
					"content": "种子我肯定没认错，它们都是我照着鬼老头的手记从储藏室里翻出来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060107
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732060107,
					"content": "按照他的记录，种子的保存时间很长，只要保证干燥，它们就不会坏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060108
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732060108,
					"content": "栽培方式也不该有问题，该浇的水和该施的肥料我都没有落下，到底为什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060109
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732060109,
					"content": "别着急呀，阿凡爷爷，再等等看呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732060110,
					"content": "#每次我和{NICKNAME}去野外摘果子摘花，摘完之后也要等好几天它们才能重新长出来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060111,
						732060112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732060111,
					"content": "耐心点。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060113
					]
				},
				{
					"id": 732060113,
					"content": "唉，也只能等等看了，你们今天有空吗？能不能再帮我给它们浇点水？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060114
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732060114,
					"content": "我刚给苗圃松土，忙活了好半天，实在没力气跑回去打水了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060115
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732060115,
					"content": "我明白了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060116
					]
				},
				{
					"id": 732060116,
					"content": "谢谢你们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732060112,
					"content": "继续浇水试试。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060113
					]
				}
			]
		},
		{
			"id": 7320603,
			"completionStepIds": [
				7320603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320603",
							"2"
						],
						"stepId": 7320603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿凡"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732060301,
					"content": "水还是要浇，肥还是要施，有没有用…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060302
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732060302,
					"content": "我也不知道了，唉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060303
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732060303,
					"content": "我糊里糊涂活到今天，终于下定决心要做一件事，结果还是做不成。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060304
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732060304,
					"content": "鬼老头，辜负了你的嘱托，对不起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060305
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732060305,
					"content": "阿凡爷爷…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732060306,
