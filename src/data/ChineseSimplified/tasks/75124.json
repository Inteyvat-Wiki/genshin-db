				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-1640.235,
							200.011,
							10049.76
						],
						"pointId": 10055
					},
					{
						"sceneId": 3,
						"position": [
							-1639.219,
							200.16,
							10051.38
						],
						"pointId": 10424
					},
					{
						"sceneId": 3,
						"position": [
							-1640.835,
							200.051,
							10051.92
						],
						"pointId": 10425
					}
				]
			},
			"dialogs": [
				{
					"id": 751240101,
					"content": "唉，又跑出去了，我看看，在游泳圈里的不是只剩下一只了嘛…这下可怎么办…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240102
					],
					"speakerTitle": "容韦勒"
				},
				{
					"id": 751240102,
					"content": "这要套到什么时候去啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240103
					],
					"speakerTitle": "容韦勒"
				},
				{
					"id": 751240103,
					"content": "哦，居然有人在这里拍画片…是在拍浮流鸟吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751240104,
					"content": "浮流鸟确实很可爱呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240105,
						751240107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751240105,
					"content": "嗯，晃晃悠悠的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240106
					]
				},
				{
					"id": 751240106,
					"content": "对，走起路来晃晃悠悠的感觉十分可爱。而且，胀起身子，变成球，浮在水上时的样子，让人看着就觉得很开心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751240109,
					"content": "这位有着漂亮银色光泽秀发的小小女士说得对啊！创造出浮流鸟这一生物的创造者应该受到此世所有的赞美…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240110
					],
					"speakerTitle": "容韦勒"
				},
				{
					"id": 751240110,
					"content": "真是了不起，啊，抱歉，我还没有自我介绍，我是浮流鸟摄影爱好者，叫我容韦勒就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240111
					],
					"speakerTitle": "容韦勒"
				},
				{
					"id": 751240111,
					"content": "#嗯，我叫派蒙，这位是{NICKNAME}…不过，这里有这么多浮流鸟，容韦勒你为什么还唉声叹气的啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751240112,
					"content": "此事说来话长…不过就容我容韦勒长话短说吧，浮流鸟的摄影爱好者有很多，大家都希望拍出更有趣的照片…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240113
					],
					"speakerTitle": "容韦勒"
				},
				{
					"id": 751240113,
					"content": "而我在前几天诞生了个天才的想法——那就是让镜头中的所有浮流鸟套在游泳圈里！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240114,
						751240117
					],
					"speakerTitle": "容韦勒"
				},
				{
					"id": 751240114,
					"content": "有什么意义吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240115
					]
				},
				{
					"id": 751240115,
					"content": "当然了，意义就在于没有意义，明明自己能够漂浮在水面上的浮流鸟，却仍然套着游泳圈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240116
					],
					"speakerTitle": "容韦勒"
				},
				{
					"id": 751240116,
					"content": "就如同用摩拉赚取摩拉那般虚无！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240120
					],
					"speakerTitle": "容韦勒"
				},
				{
					"id": 751240120,
					"content": "浮流鸟身上背负的东西也太多了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751240121,
					"content": "这就是所谓的超现实拍摄，要从留影之内找到更深的意义…啊，但，遇到了麻烦的情况。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240122
					],
					"speakerTitle": "容韦勒"
				},
				{
					"id": 751240122,
					"content": "现实中的浮流鸟果然还是不会套着泳圈的…所以根本就拍不到这样的画面…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240123
					],
					"speakerTitle": "容韦勒"
				},
				{
					"id": 751240123,
					"content": "毕竟是「超现实」拍摄呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240124
					]
				},
				{
					"id": 751240124,
					"content": "#不过，听上去好像只要用游泳圈把所有的浮流鸟圈住就好？{NICKNAME}，同为浮流鸟爱好者，我们来帮忙吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240125,
						751240127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751240125,
					"content": "呼呼，浮流鸟爱好者应当互帮互助！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240126
					]
				},
				{
					"id": 751240126,
					"content": "说得对！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751240129,
					"content": "真的吗？你们愿意帮忙吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240130
					],
					"speakerTitle": "容韦勒"
				},
				{
					"id": 751240130,
					"content": "嘿嘿，只要事后你把好看的画片给我们几张就好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751240131,
					"content": "那、那就拜托你们两位了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "容韦勒"
				},
				{
					"id": 751240127,
					"content": "虽然我比较喜欢飞鼯啦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240128
					]
				},
				{
					"id": 751240128,
					"content": "这里就不要再说这种扫兴的话！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751240117,
					"content": "正常人确实想不到…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240118
					]
				},
				{
					"id": 751240118,
					"content": "浮流鸟明明自己能够漂浮在水面上，却仍然套着游泳圈。就能在画面中形成一种意义的过度堆叠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240119
					],
					"speakerTitle": "容韦勒"
				},
				{
					"id": 751240119,
					"content": "这其实展现了一类「过度使用」和「浪费」的主题…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240120
					],
					"speakerTitle": "容韦勒"
				},
				{
					"id": 751240107,
					"content": "其实我比较喜欢飞鼯啦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240108
					]
				},
				{
					"id": 751240108,
					"content": "飞鼯当然也很可爱，但是，「飞鼯比浮流鸟可爱」，你能够在这些游来游去的浮流鸟们面前说出这么残忍的话吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240109
					],
					"speakerTitle": "派蒙"
				}
			]
		},
