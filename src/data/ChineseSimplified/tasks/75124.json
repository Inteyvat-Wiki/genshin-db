			"dialogs": [
				{
					"id": 751240301,
					"content": "哎呀，正是好时机…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240302
					],
					"speakerTitle": "容韦勒"
				},
				{
					"id": 751240302,
					"content": "我忙了那么久都没有完成的画面，在两位的帮助下居然这么快就能够拍摄完毕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240303
					],
					"speakerTitle": "容韦勒"
				},
				{
					"id": 751240303,
					"content": "啊，浮流鸟，晃晃的滚滚的身子在游泳圈内…真是让人感动到落泪啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240304
					],
					"speakerTitle": "容韦勒"
				},
				{
					"id": 751240304,
					"content": "真的能那么感动吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240305
					]
				},
				{
					"id": 751240305,
					"content": "对于旁人来说无法理解，甚至觉得荒谬的东西，对于我们来说却是这段人生的追求…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240306
					],
					"speakerTitle": "容韦勒"
				},
				{
					"id": 751240306,
					"content": "不过我相信，如果我能拍出更多浮流鸟可爱的画片，最终，喜欢浮流鸟的人一定会越来越多的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240307
					],
					"speakerTitle": "容韦勒"
				},
				{
					"id": 751240307,
					"content": "我也完全相信这样的未来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751240308,
					"content": "啊，多谢你们的帮忙，哎，这些就给你们作为答谢吧，还请务必收下呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "容韦勒"
				}
			]
		},
