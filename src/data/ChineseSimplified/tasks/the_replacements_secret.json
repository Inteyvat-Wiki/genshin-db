			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"百代",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722651701,
					"content": "做的不错，有了这个东西，就能够挫败愚人众的阴谋了。我马上就去找人安排后续的行动，你们就不用担心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722651702
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722651702,
					"content": "那个，百代小姐，其实我们有一件事想求你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722651703
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722651703,
					"content": "把刚才发生的事详细告诉了百代。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722651704
					]
				},
				{
					"id": 722651704,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722651705
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722651705,
					"content": "呜，百代小姐，你不要这样盯着我嘛！你…你就说好不好嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722651706
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722651706,
					"content": "你们想救愚人众？这关我什么事？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722651707
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722651707,
					"content": "那个女人顶替了我的位置，如果不是因为你们之前误打误撞，终末番很可能就会遇到重大危机！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722651708
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722651708,
					"content": "#{NICKNAME}，你也想办法劝劝百代小姐吧，要不然柳达希卡小姐就性命难保了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722651709,
						722651710,
						722651711
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722651709,
					"content": "做出可怜巴巴的表情。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722651712
					]
				},
				{
					"id": 722651712,
					"content": "哼，没用的。我已经说过了，愚人众和我没关系！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722651713
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722651713,
					"content": "而且你们以为，伪造人体是这么轻松的事吗？这几天你们去探听情报的时候，我没日没夜地工作，才把他们要的假人做完。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722651714
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722651714,
					"content": "需要那么多<color=#00E1FFFF>兽肉</color>才能凑够一个人的重量！还要把<color=#00E1FFFF>白铁块</color>和其他许多材料烧在一起伪造成骨头！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722651715
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722651715,
					"content": "如果不放<color=#00E1FFFF>海灵芝</color>，脂肪含量不足，效果就不够逼真。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722651716
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722651716,
					"content": "啊啊，最烦的就是把<color=#00E1FFFF>衣服</color>套在拼出来的假人上烧的过程了。毕竟要小心别把衣服烧得面目全非了呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722651717
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722651717,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722651718
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722651718,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722651719
					]
				},
				{
					"id": 722651719,
					"content": "你们是听不懂人话吗？还愣着干嘛？！<color=#00E1FFFF>八块兽肉，四块白铁块，三颗海灵芝</color>，外加一件容易辨识身份的<color=#00E1FFFF>衣服</color>！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722651720
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722651720,
					"content": "呜呜呜！我就知道百代小姐你最好了！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722651721
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722651721,
					"content": "别烦我，快走快走！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "百代"
				},
				{
					"id": 722651710,
					"content": "做出特别可怜巴巴的表情。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722651712
					]
				},
				{
					"id": 722651711,
					"content": "做出特别可怜巴巴都要哭了的表情。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722651712
					]
				}
			]
		},
