			"dialogs": [
				{
					"id": 722651301,
					"content": "我会在这里一边做校对工作，一边为二位祈祷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722651302
					],
					"speakerTitle": "柳达希卡·雪奈茨芙娜"
				},
				{
					"id": 722651302,
					"content": "说起来，校对的工作怎么样了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722651303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722651303,
					"content": "还算顺利，不过这次要校对的内容非常多，加上八重堂这两天人手不足，可能要通宵吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722651304
					],
					"speakerTitle": "柳达希卡·雪奈茨芙娜"
				},
				{
					"id": 722651304,
					"content": "好辛苦呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722651305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722651305,
					"content": "呵呵，虽然辛苦，但我觉得非常有趣！能够提前看到喜欢的小说，偶尔还能接触到作者们的手稿，简直太棒了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柳达希卡·雪奈茨芙娜"
				}
			]
		},
