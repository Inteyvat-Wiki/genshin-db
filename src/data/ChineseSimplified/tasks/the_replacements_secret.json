			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"叶菲·雪奈茨维奇",
					"柳达希卡·雪奈茨芙娜",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722650501,
					"content": "应该还不到和老师例行会面的日期才对，一定是因为那件事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650502
					],
					"speakerTitle": "柳达希卡·雪奈茨芙娜"
				},
				{
					"id": 722650502,
					"content": "柳达希卡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650503
					],
					"speakerTitle": "叶菲·雪奈茨维奇"
				},
				{
					"id": 722650503,
					"content": "啊，老师您来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650504
					],
					"speakerTitle": "柳达希卡·雪奈茨芙娜"
				},
				{
					"id": 722650504,
					"content": "您辛苦了，我马上向您汇报近日的进展。关于您吩咐的渗透终末番一事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650505
					],
					"speakerTitle": "柳达希卡·雪奈茨芙娜"
				},
				{
					"id": 722650505,
					"content": "够了，柳达希卡，你那些拖延时间的说辞，我已经听够了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650506
					],
					"speakerTitle": "叶菲·雪奈茨维奇"
				},
				{
					"id": 722650506,
					"content": "什么「频繁发布假任务可能会引起对方怀疑」，「眼狩令废止后，终末番的行动方针可能会有变化，需要搜集情报」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650507
					],
					"speakerTitle": "叶菲·雪奈茨维奇"
				},
				{
					"id": 722650507,
					"content": "每次都是这样！我猜你根本就没有获得那两个终末番成员的信任，所以才不得不编出这些谎话来搪塞我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650508
					],
					"speakerTitle": "叶菲·雪奈茨维奇"
				},
				{
					"id": 722650508,
					"content": "不是的老师！我确实已经获得了他们的信任，只是还需要一点时间…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650509
					],
					"speakerTitle": "柳达希卡·雪奈茨芙娜"
				},
				{
					"id": 722650509,
					"content": "时间？我已经给了你很多时间了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650510
					],
					"speakerTitle": "叶菲·雪奈茨维奇"
				},
				{
					"id": 722650510,
					"content": "你要知道，我的耐心是有限的，「仆人」大人的耐心也是有限的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650511
					],
					"speakerTitle": "叶菲·雪奈茨维奇"
				},
				{
					"id": 722650511,
					"content": "真是万分抱歉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650512
					],
					"speakerTitle": "柳达希卡·雪奈茨芙娜"
				},
				{
					"id": 722650512,
					"content": "我辛辛苦苦在你身上花了这么多年时间，要的不是你的道歉！我要的是「结果」，「结果」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650513
					],
					"speakerTitle": "叶菲·雪奈茨维奇"
				},
				{
					"id": 722650513,
					"content": "…算了，我不想追究之前的事。不管是你没取得敌人的信任，还是现在的生活让你昏了头，都不重要了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650514
					],
					"speakerTitle": "叶菲·雪奈茨维奇"
				},
				{
					"id": 722650514,
					"content": "这张纸上是你的「最终指令」，拿着它。你给我一个字一个字地，好好看清楚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650515
					],
					"speakerTitle": "叶菲·雪奈茨维奇"
				},
				{
					"id": 722650515,
					"content": "是，老师！我一定会完成任务，不负您的信任！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650516
					],
					"speakerTitle": "柳达希卡·雪奈茨芙娜"
				},
				{
					"id": 722650516,
					"content": "…这、这是？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650517
					],
					"speakerTitle": "柳达希卡·雪奈茨芙娜"
				},
				{
					"id": 722650517,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650518
					],
					"speakerTitle": "叶菲·雪奈茨维奇"
				},
				{
					"id": 722650518,
					"content": "啊，不，没什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650519
					],
					"speakerTitle": "柳达希卡·雪奈茨芙娜"
				},
				{
					"id": 722650519,
					"content": "柳达希卡，你刚才那句「我一定会完成任务，不负您的信任」，我可以当作是你的承诺吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650520
					],
					"speakerTitle": "叶菲·雪奈茨维奇"
				},
				{
					"id": 722650520,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650521
					],
					"speakerTitle": "柳达希卡·雪奈茨芙娜"
				},
				{
					"id": 722650521,
					"content": "回答我，「是」还是「不是」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650522
					],
					"speakerTitle": "叶菲·雪奈茨维奇"
				},
				{
					"id": 722650522,
					"content": "老师！我当然支持您的决断，只是…只是您说过，「仆人」大人随时都可能让我们从稻妻撤离。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650523
					],
					"speakerTitle": "柳达希卡·雪奈茨芙娜"
				},
				{
					"id": 722650523,
					"content": "而且现在幕府和海祇岛已经停战，我们这样做，真的有必要吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650524
					],
					"speakerTitle": "柳达希卡·雪奈茨芙娜"
				},
				{
					"id": 722650524,
					"content": "呵呵，正因为如此，这个任务才有价值！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650525
					],
					"speakerTitle": "叶菲·雪奈茨维奇"
				},
				{
					"id": 722650525,
					"content": "虽然「女士」大人在稻妻遇害了，但现在，也正是我们回报「仆人」大人的恩情，为其建立威望的好时机。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650526
					],
					"speakerTitle": "叶菲·雪奈茨维奇"
				},
				{
					"id": 722650526,
					"content": "而且我也一直告诉你们，「混乱」才是最能让我们愚人众壮大的土壤！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650527
					],
					"speakerTitle": "叶菲·雪奈茨维奇"
				},
				{
					"id": 722650527,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650528
					],
					"speakerTitle": "柳达希卡·雪奈茨芙娜"
				},
				{
					"id": 722650528,
					"content": "柳达希卡，你还在犹豫什么？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650529
					],
					"speakerTitle": "叶菲·雪奈茨维奇"
				},
				{
					"id": 722650529,
					"content": "只是这样一来，一定又会有很多孤儿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650530
					],
					"speakerTitle": "柳达希卡·雪奈茨芙娜"
				},
				{
					"id": 722650530,
					"content": "那不是更好吗？我们也可以收留他们，让他们成为新的战力。当然前提是，你能顺利完成这个任务！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650531
					],
					"speakerTitle": "叶菲·雪奈茨维奇"
				},
				{
					"id": 722650531,
					"content": "柳达希卡，别再让我失望。我们有这么多年的情分，我也不想把事情做得太绝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650532
					],
					"speakerTitle": "叶菲·雪奈茨维奇"
				},
				{
					"id": 722650532,
					"content": "呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650533
					],
					"speakerTitle": "柳达希卡·雪奈茨芙娜"
				},
				{
					"id": 722650533,
					"content": "不好了，海祇岛要发生可怕的事了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650534
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722650534,
					"content": "#{NICKNAME}，现在只剩下柳达希卡一个人了，我们快去把她手里的最终指令抢过来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7226506,
			"completionStepIds": [
