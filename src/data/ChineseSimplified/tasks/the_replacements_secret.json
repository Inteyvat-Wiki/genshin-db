			"dialogs": [
				{
					"id": 722651601,
					"content": "柳达希卡小姐，你在里面吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722651602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722651602,
					"content": "#是{NICKNAME}和派蒙，怎么了，是不是因为行动进行得不顺利？别担心，我马上就离开这里，不会给你们添麻烦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722651603
					],
					"speakerTitle": "柳达希卡·雪奈茨芙娜"
				},
				{
					"id": 722651603,
					"content": "不是不是！我们来找你，只是因为目前计划里需要一套你的衣服，能一下子辨认出你身份的那种。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722651604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722651604,
					"content": "能辨认我身份的衣服？我明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722651605
					],
					"speakerTitle": "柳达希卡·雪奈茨芙娜"
				},
				{
					"id": 722651605,
					"content": "这是我在愚人众的服装。如果是认识我的人的话，应该能辨认出这套衣服。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722651606
					],
					"speakerTitle": "柳达希卡·雪奈茨芙娜"
				},
				{
					"id": 722651606,
					"content": "摸起来还有点温温的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722651607
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722651607,
					"content": "说来惭愧，因为我之前把它穿在其他衣服里面，以备不时之需。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722651608
					],
					"speakerTitle": "柳达希卡·雪奈茨芙娜"
				},
				{
					"id": 722651608,
					"content": "好，现在有了这套衣服，计划一定能顺利进行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722651609
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722651609,
					"content": "谢谢你们，祝你们好运。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柳达希卡·雪奈茨芙娜"
				}
			]
		},
		{
