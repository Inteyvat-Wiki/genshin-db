			},
			"dialogs": [
				{
					"id": 722650601,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650602
					],
					"speakerTitle": "柳达希卡·雪奈茨芙娜"
				},
				{
					"id": 722650602,
					"content": "柳达希卡。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722650603
					]
				},
				{
					"id": 722650603,
					"content": "谁？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650604
					],
					"speakerTitle": "柳达希卡·雪奈茨芙娜"
				},
				{
					"id": 722650604,
					"content": "#{NICKNAME}，您…您怎么会在这里？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650605
					],
					"speakerTitle": "柳达希卡·雪奈茨芙娜"
				},
				{
					"id": 722650605,
					"content": "那个…不，您误会了，我…我之所以在这里，其实…其实是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650606
					],
					"speakerTitle": "柳达希卡·雪奈茨芙娜"
				},
				{
					"id": 722650606,
					"content": "我觉得并没有什么误会。因为…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722650607,
						722650608
					]
				},
				{
					"id": 722650607,
					"content": "你回应了「柳达希卡」这个名字。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722650609
					]
				},
				{
					"id": 722650609,
					"content": "…哎呀哎呀，看来现在，再说什么都没有用了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650610
					],
					"speakerTitle": "柳达希卡·雪奈茨芙娜"
				},
				{
					"id": 722650610,
					"content": "既然你已经发现了我的真实身份，就别想活着离开！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柳达希卡·雪奈茨芙娜"
				},
				{
					"id": 722650608,
					"content": "你身上的衣服说明了一切。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722650609
					]
				}
			]
		},
		{
			"id": 7226508,
			"completionStepIds": [
				7226508
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7226507",
							"3"
						],
						"stepId": 7226507,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7226508",
							"2"
						],
						"stepId": 7226508,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"柳达希卡·雪奈茨芙娜",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722650801,
					"content": "咳…咳咳咳！呼…呼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650802
					],
					"speakerTitle": "柳达希卡·雪奈茨芙娜"
				},
				{
					"id": 722650802,
					"content": "喂，你还好吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650803
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722650803,
					"content": "抱歉，下手有点重。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722650804
					]
				},
				{
					"id": 722650804,
					"content": "呼…为什么，不干脆了结掉我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650805
					],
					"speakerTitle": "柳达希卡·雪奈茨芙娜"
				},
				{
					"id": 722650805,
					"content": "你们应该是想知道我身上那张「最终指令」的内容吧。只要干掉我，一切不就很简单了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650806
					],
					"speakerTitle": "柳达希卡·雪奈茨芙娜"
				},
				{
					"id": 722650806,
					"content": "对，那样确实很简单。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722650807
					]
				},
				{
					"id": 722650807,
					"content": "而且对你而言也是种「解脱」吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722650808
					]
				},
				{
					"id": 722650808,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650809
					],
					"speakerTitle": "柳达希卡·雪奈茨芙娜"
				},
				{
					"id": 722650809,
					"content": "#玄冬…不，柳达希卡小姐，我们其实已经发现了，你刚才虽然气势汹汹地冲了过来，但你和{NICKNAME}战斗的时候，根本就没有用全力吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650810,
						722650811
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722650810,
					"content": "而且气势也太假了一点。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722650812
					]
				},
				{
					"id": 722650812,
					"content": "欸！不…不至于吧，真的有那么假吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650813
					],
					"speakerTitle": "柳达希卡·雪奈茨芙娜"
				},
				{
					"id": 722650813,
					"content": "但你想要自我了断是真的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722650814
					]
				},
				{
					"id": 722650814,
					"content": "柳达希卡小姐，我们刚才听到了你和那个「老师」的谈话，你似乎有一些苦衷。能和我们讲讲吗？我们可以帮你的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650815
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722650815,
					"content": "但是我…我是愚人众啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650816,
						722650818
					],
					"speakerTitle": "柳达希卡·雪奈茨芙娜"
				},
				{
					"id": 722650816,
					"content": "派蒙说了，会帮你的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722650817
					]
				},
				{
					"id": 722650817,
					"content": "#哇，谢谢你{NICKNAME}，我好感动！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650819
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722650819,
					"content": "嗯，你放心吧，我们是不会对好人出手的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650820
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722650820,
					"content": "但其实，我的确不能算是什么好人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650821
					],
					"speakerTitle": "柳达希卡·雪奈茨芙娜"
				},
				{
					"id": 722650821,
					"content": "我一开始接到任务混进鸣神大社，只是为了接触终末番的成员，混进他们内部。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650822
					],
					"speakerTitle": "柳达希卡·雪奈茨芙娜"
				},
				{
					"id": 722650822,
					"content": "但我来到神社之后却发现，老师所说的那两个终末番成员，却是曾经在蒙德和璃月鼎鼎有名的旅行者和跟班…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650823
					],
					"speakerTitle": "柳达希卡·雪奈茨芙娜"
				},
				{
					"id": 722650823,
					"content": "派蒙不是跟班！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650824,
						722650825
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722650824,
					"content": "难怪你知道我的名字。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722650826
					]
				},
				{
					"id": 722650826,
					"content": "是的。所以，老师让我渗透进终末番，从根本上就是无法成立的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650827
					],
					"speakerTitle": "柳达希卡·雪奈茨芙娜"
				},
				{
					"id": 722650827,
					"content": "因为老师对这一行动寄予厚望，我不知道该如何向他汇报。他如果知道了真相，一定会大发雷霆，我不会有好下场的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650828
					],
					"speakerTitle": "柳达希卡·雪奈茨芙娜"
				},
				{
					"id": 722650828,
					"content": "不过，我能够来到稻妻，还能在神社里当巫女，简直像做梦一样！能够做这样一个梦，我已经非常满足了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650829
					],
					"speakerTitle": "柳达希卡·雪奈茨芙娜"
				},
				{
					"id": 722650829,
					"content": "所以，我就一直用各种理由搪塞老师，决定过一天是一天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650830
					],
					"speakerTitle": "柳达希卡·雪奈茨芙娜"
				},
				{
					"id": 722650830,
					"content": "我以为自己的谎言总有一天会穿帮，不过却没想到，老师并没有追究这件事，而是给了我新的任务。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650831
					],
					"speakerTitle": "柳达希卡·雪奈茨芙娜"
				},
				{
					"id": 722650831,
					"content": "老师到底给了你什么任务？刚才你一看见纸上的字，脸就变白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650832
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722650832,
					"content": "因为…我的任务是「投毒」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650833
					],
					"speakerTitle": "柳达希卡·雪奈茨芙娜"
				},
				{
					"id": 722650833,
					"content": "呀，投毒？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650834
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722650834,
					"content": "老师要我和其他几个人进入海祇岛，在那里投毒。然后故意暴露出我们鸣神大社巫女和天领奉行士兵的身份。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650835
					],
					"speakerTitle": "柳达希卡·雪奈茨芙娜"
				},
				{
					"id": 722650835,
					"content": "这样，幕府与海祇岛之间一定会再起冲突，愚人众也就能乘虚而入。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650836
					],
					"speakerTitle": "柳达希卡·雪奈茨芙娜"
				},
				{
					"id": 722650836,
					"content": "那个「老师」也太狠毒了！如果被他实行了这样的计划，许多人之前为了稻妻和平做出的努力就都白费了呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650837
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722650837,
					"content": "柳达希卡，你准备怎么做？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722650838
					]
				},
				{
					"id": 722650838,
					"content": "我…我不知道。我根本没有违抗老师命令的资格，但我并不想看见这样的事情发生！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650839
					],
					"speakerTitle": "柳达希卡·雪奈茨芙娜"
				},
				{
					"id": 722650839,
					"content": "因为你也是「雪奈茨芙娜」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722650840
					]
				},
				{
					"id": 722650840,
					"content": "#说起来我之前就经常听见这个词，它到底是什么意思呀？{NICKNAME}你好像已经完全知道了的样子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650841
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722650841,
					"content": "是代表孤儿的意思吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722650842
					]
				},
				{
					"id": 722650842,
					"content": "对，「雪奈茨维奇」和「雪奈茨芙娜」，是愚人众给予我们这些被收养的孤儿们的姓氏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650843
					],
					"speakerTitle": "柳达希卡·雪奈茨芙娜"
				},
				{
					"id": 722650843,
					"content": "我们从小在「仆人」大人设立的福利院里长大，我们不知道自己究竟是谁，顶多知道自己有哪里的血统。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650844
					],
					"speakerTitle": "柳达希卡·雪奈茨芙娜"
				},
				{
					"id": 722650844,
					"content": "我就是因为有稻妻的血统，所以从小就在学习关于这里的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650845
					],
					"speakerTitle": "柳达希卡·雪奈茨芙娜"
				},
				{
					"id": 722650845,
					"content": "其实我的老师，他也是一个「雪奈茨维奇」。所以，我才更不能理解他…不，是不能原谅他说的那些话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650846
					],
					"speakerTitle": "柳达希卡·雪奈茨芙娜"
				},
				{
					"id": 722650846,
					"content": "因为一直以来我都在思考着：我究竟是谁？我为什么是孤身一人？我的父母他们遭遇了不幸吗？还是他们抛弃了我呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650847
					],
					"speakerTitle": "柳达希卡·雪奈茨芙娜"
				},
				{
					"id": 722650847,
					"content": "但老师那些话，却无视了孤儿们的痛苦…让我忍不住去想，我的命运，难道是被愚人众…被老师这样的人创造出来的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650848
					],
					"speakerTitle": "柳达希卡·雪奈茨芙娜"
				},
				{
					"id": 722650848,
					"content": "确实不可原谅。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722650849
					]
				},
				{
					"id": 722650849,
					"content": "#{NICKNAME}，我们帮帮柳达希卡小姐吧。她虽然是愚人众，可她并不是坏人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650850
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722650850,
					"content": "谢谢你们的好意，但我觉得我的命运已经注定了。「老师」是个对背叛者毫不留情的人，只要我还活着，他就一定会把我找出来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650851
					],
					"speakerTitle": "柳达希卡·雪奈茨芙娜"
				},
				{
					"id": 722650851,
					"content": "可能被你们了结掉，才是我最好的归宿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650852
					],
					"speakerTitle": "柳达希卡·雪奈茨芙娜"
				},
				{
					"id": 722650852,
					"content": "难道只有死了才不会被他盯上吗？怎么会这样！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650853
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722650853,
					"content": "嗯？等一下，我总觉得好像想到了点什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650854
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722650854,
					"content": "是百代小姐吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722650855
					]
				},
				{
					"id": 722650855,
					"content": "百代小姐？…啊！我想起来了，对啊！她最近不就正在做假尸——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650856
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722650856,
					"content": "嘘。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722650857
					]
				},
				{
					"id": 722650857,
					"content": "嗯，咳咳，柳达希卡小姐，总之，我们已经有办法救你了！而且我们也会挫败「老师」的阴谋！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650858
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722650858,
					"content": "咦，真的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650859
					],
					"speakerTitle": "柳达希卡·雪奈茨芙娜"
				},
				{
					"id": 722650859,
					"content": "你就放心吧！不过这几天，你要先找个地方躲起来，等到我们把事情都办妥之后再出来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650860
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722650860,
					"content": "你有地方可去吗？最好是那种方便我们找到你，也不会被人怀疑的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650861
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722650861,
					"content": "让我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650862
					],
					"speakerTitle": "柳达希卡·雪奈茨芙娜"
				},
				{
					"id": 722650862,
					"content": "啊，有一个地方似乎可以！我之前曾经用过一个假名在八重堂打过工，做小说新刊的校对。因为我很喜欢读八重堂出版的小说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650863
					],
					"speakerTitle": "柳达希卡·雪奈茨芙娜"
				},
				{
					"id": 722650863,
					"content": "他们在稻妻城的书店后面有一间小屋，偶尔会给拖稿的作者或者校对员使用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650864
					],
					"speakerTitle": "柳达希卡·雪奈茨芙娜"
				},
				{
					"id": 722650864,
					"content": "听起来是个不错的地方！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650865
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722650865,
					"content": "嗯，大隐隐于市。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722650866
					]
				},
				{
					"id": 722650866,
					"content": "柳达希卡小姐，你就暂时躲在那里吧，我们如果有事就过去找你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650867
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722650867,
					"content": "我明白了。真不知道该如何感谢你们，我明明之前一直在欺骗你们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650868
					],
					"speakerTitle": "柳达希卡·雪奈茨芙娜"
				},
				{
					"id": 722650868,
					"content": "老师给我的这张纸上，写有任务的详细计划。海祇岛无辜众人的性命，就拜托你们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650869
					],
					"speakerTitle": "柳达希卡·雪奈茨芙娜"
				},
				{
					"id": 722650869,
					"content": "柳达离开了",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722650870
					]
				},
				{
					"id": 722650870,
					"content": "她走了。我们也赶快回百代小姐那去吧，接下来还有很多事情要做呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722650825,
					"content": "原来你知道我的事情。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722650826
					]
				},
				{
					"id": 722650818,
					"content": "如果你真的有苦衷的话。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722650819
					]
				},
				{
					"id": 722650811,
					"content": "而且笑声也太假了一点。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722650812
					]
				}
			]
		},
