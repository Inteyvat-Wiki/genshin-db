			},
			"dialogs": [
				{
					"id": 120240401,
					"content": "#呵欠…今天就是和谈的日子了，怎么样{NICKNAME}，做好准备了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240402
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120240402,
					"content": "来，这个给你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240403
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120240403,
					"content": "这是我昨晚写下的锦囊。这次谈判虽然错综复杂，但我仔细思考了一下，不外乎一百八十七种情况。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240404
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120240404,
					"content": "我将这些情况和对策全部写了下来，到时候你可以随机应变。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240405
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120240405,
					"content": "哇！好厚一本！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120240406,
					"content": "让我看看…「激烈争吵」、「出现械斗」、「放火作乱」、「分兵涌入」、「挟持人质」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240407
					],
					"speakerTitle": "派蒙"
				},
