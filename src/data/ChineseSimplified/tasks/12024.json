			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"珊瑚宫心海",
					"九条裟罗"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120240101,
					"content": "好久不见，九条裟罗。上次见面，还是在战场上吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240102
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120240102,
					"content": "是啊，当时我们在你手上吃了不小的亏…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240103
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 120240103,
					"content": "话说回来，你怎么也在这？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240104
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 120240104,
					"content": "来见证这次和谈。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120240105
					]
				},
				{
					"id": 120240105,
					"content": "#没错，{NICKNAME}是这次和谈的见证人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240106
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120240106,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}完整地经历了我们之间的战争，为现在的和平做出了巨大的贡献。我想，应该没有人比{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}更合适了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240107
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120240107,
					"content": "也是，那我们直接进入正题吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240108
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 120240108,
					"content": "首先是海域管辖权的问题。战争期间，我们限制了海祇岛的打渔人在鸣神岛海域活动…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240109
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 120240109,
					"content": "现在我们打算正式解除限制，但他们需要按照我们鸣神岛的税法进行纳税，才能将收获带回海祇岛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240110
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 120240110,
					"content": "可以。不过在鸣神岛附近捕鱼的人，需要受到天领奉行的保护。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240111
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120240111,
					"content": "如果他们因治安问题有任何损失，天领奉行必须要出面解决。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240112
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120240112,
					"content": "这一点我答应了，写到协约中吧。有天领奉行在，他们不会有事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240113
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 120240113,
					"content": "感觉她们之间的谈判还算顺利呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120240114,
					"content": "接下来是人员往来和常驻军的所属问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240115
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 120240115,
					"content": "以前不管是我们的人去海祇岛，还是海祇岛的人过来，都会遭受到重重盘问。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240116
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 120240116,
					"content": "最终的结果，就是彼此交流越来越少，很少有商人愿意跨岛屿经商。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240117
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 120240117,
					"content": "战争既然结束，那我提议由社奉行选出一些商人，主管两边的商务贸易。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240118
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 120240118,
					"content": "商务贸易，需要有来有往。双方的商人都要参与进来，不能完全交给社奉行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240119
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120240119,
					"content": "但据我了解，海祇岛现在急需各种物资。交由社奉行统一调配，对你们也是一件好事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240120
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 120240120,
					"content": "物资紧缺，我们自然有办法缓解。海祇岛物产丰富，也有许多外地的商人愿意过来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240121
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120240121,
					"content": "更何况这种事，应该由神里家与我们谈。天领奉行…应该没有这方面的权能吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240122
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120240122,
					"content": "既然这样，那我们聊聊治安吧。我想让海祇岛的治安部队，回归到天领奉行的管辖之下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240123
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 120240123,
					"content": "暂时来说，不可能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240124
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120240124,
					"content": "没有不可能的事情。天领奉行统管稻妻治安，不可能一直放任海祇岛处于例外…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240125
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 120240125,
					"content": "卑鄙的九条家，你们勾结愚人众，还想夺走我们海祇岛的一切！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240127
					],
					"speakerTitle": "忠胜"
				},
				{
					"id": 120240127,
					"content": "心海！这时候我们要用锦囊第几条呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120240128,
					"content": "最后一条…不过暂时不需要你们出手了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240129
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120240129,
					"content": "忠胜，如今情况有变，你们先在一旁待命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240130
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120240130,
					"content": "放心，你们的诉求我已了解，接下来就交给我来处理吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240131
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120240131,
					"content": "九条小姐，关于这件事，你是不是应该给我们海祇岛一个交代？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240132
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120240132,
					"content": "…稍等。所有人不要动手，等我调查完再说！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240133
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 120240133,
					"content": "你们两个，过来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240134
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 120240134,
					"content": "说吧，你们跟愚人众真的有什么勾结吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240135
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 120240135,
					"content": "这…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240136
					],
					"speakerTitle": "元助"
				},
				{
					"id": 120240136,
					"content": "就，其实也算不上勾结…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240137
					],
					"speakerTitle": "陶义隆"
				},
				{
					"id": 120240137,
					"content": "愚人众有些人找上我们，说可以跟我们合作，延续对海祇岛的战争。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240138
					],
					"speakerTitle": "元助"
				},
				{
					"id": 120240138,
					"content": "当时我寻思，反正试试也没什么坏处…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240139
					],
					"speakerTitle": "元助"
				},
				{
					"id": 120240139,
					"content": "但其实我们很谨慎，没答应他们，只说让他们可以先去海祇岛搞破坏，我们看看情况再说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240140
					],
					"speakerTitle": "陶义隆"
				},
				{
					"id": 120240140,
					"content": "九条大人，我们跟他们真的没什么勾结。只是不久之前谈过这么一次，谁知道海祇岛的人怎么知道的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240141
					],
					"speakerTitle": "陶义隆"
				},
				{
					"id": 120240141,
					"content": "够了…回去之后，自己领罚吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240142
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 120240142,
					"content": "那可是愚人众，他们对我们做了什么，你们都忘了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240143
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 120240143,
					"content": "别说合作，你们根本就不该和他们有任何牵扯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240144
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 120240144,
					"content": "他们的目的是什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240145
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 120240145,
					"content": "愚人众的主力应该已经从稻妻撤出了，找上我们的那些人，似乎是想给他们的老大报仇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240146
					],
					"speakerTitle": "陶义隆"
				},
				{
					"id": 120240146,
					"content": "那个女人的部下吗…看来是准备报复，想让稻妻继续乱起来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240147
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 120240147,
					"content": "早晚有一天，我会亲手把他们全部抓住。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240148
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 120240148,
					"content": "这件事，确实是我们的问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240149
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 120240149,
					"content": "非常抱歉，因为我的疏忽，才有这样的局面。请再给我们一个机会，让和谈继续下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240150
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 120240150,
					"content": "呵呵…我当然相信九条小姐能够处理好这件事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240151
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120240151,
					"content": "但既然天领奉行做不到上下齐心，我很难放心把海祇岛的治安交给你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240152
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120240152,
					"content": "无法反驳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240153
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 120240153,
					"content": "这个议题暂时搁置吧。等天领奉行整顿完毕之后，我们再好好讨论讨论。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240154
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 120240154,
					"content": "关于商人的问题，我也会和社奉行那边商量，让双方都能参与进来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240155
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 120240155,
					"content": "感觉裟罗的气势一下子弱了不少，这样和谈应该能够顺利进行了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240156
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120240156,
					"content": "没想到海祇岛的「军师」除了擅长作战，谈判也是一把好手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240157
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 120240157,
					"content": "希望下次见面，我们还能像这样坐下来谈话。毕竟在战场上见到你，太过棘手了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240158
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 120240158,
					"content": "今天就到这里吧，我也要回去彻查天领奉行内部的问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240159
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 120240159,
					"content": "愚人众的营地被我们击溃，再过不久，他们应该就会再和你们联络，想要从你们那里获得支持。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240160
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120240160,
					"content": "我建议你先不要放出风声，以免打草惊蛇。等他们现身，就可以将他们一网打尽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240161
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120240161,
					"content": "我会考虑的，非常感谢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240162
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 120240162,
					"content": "那我先回去了，下次再见吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240163
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 120240163,
					"content": "珊瑚宫大人，我们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240164
					],
					"speakerTitle": "忠胜"
				},
				{
					"id": 120240164,
					"content": "回海祇岛再说吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚宫心海"
				}
			]
		},
		{
			"id": 1202402,
			"completionStepIds": [
				1202406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1202406",
							"2"
						],
						"stepId": 1202406,
						"stateName": "QUEST_STATE_UNFINISHED"
