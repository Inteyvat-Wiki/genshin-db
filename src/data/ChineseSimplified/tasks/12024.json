				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"珊瑚宫心海"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120240201,
					"content": "珊瑚宫大人，您都知道了…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240202
					],
					"speakerTitle": "忠胜"
				},
				{
					"id": 120240202,
					"content": "你们闹事的理由，我已经听说了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240203
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120240203,
					"content": "你们觉得天领奉行信不过，所以不想要和谈，想要继续打下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240204
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120240204,
					"content": "虽然从结果来看，你们误打误撞地识破了他们的阴谋，但你们的做法我还是无法认可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240205
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120240205,
					"content": "可是珊瑚宫大人，我们牺牲了那么多同伴，如果就这样停下来，曾经的努力不是白费了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240206
					],
					"speakerTitle": "忠胜"
				},
				{
					"id": 120240206,
					"content": "我希望战争继续打下去，就算我牺牲了也没有关系，我希望我们能彻底赢下来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240207
					],
					"speakerTitle": "忠胜"
				},
				{
					"id": 120240207,
					"content": "我能够理解你们的想法…但你们不能强求别人为你们的想法买单。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240208
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120240208,
					"content": "战争期间，我们有过低谷，也打过胜仗。对你们来说，这是一段热血澎湃的经历。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240209
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120240209,
					"content": "但其实在战争期间，也有许多你们看不到的人，每天都活在煎熬之中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240210
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120240210,
					"content": "海祇岛的人向往和平，是因为每个人都为战争付出了太多。他们已经累了，不该被你们又一次拖下水。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240211
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120240211,
					"content": "我…可是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240212
					],
					"speakerTitle": "忠胜"
				},
				{
					"id": 120240212,
					"content": "我明白，这不完全是你们的错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240213
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120240213,
					"content": "是我考虑不周。我告诉你们要有战斗的意志，却没有告诉你们该如何放手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240214
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120240214,
					"content": "不是珊瑚宫大人的错！是我们…太过自私了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240215
					],
					"speakerTitle": "忠胜"
				},
				{
					"id": 120240215,
					"content": "不论如何，我们愿意接受军法处置。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240216
					],
					"speakerTitle": "忠胜"
				},
				{
					"id": 120240216,
					"content": "好。那我现在宣布…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240217
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120240217,
					"content": "从今天开始，成立一支秘密军队。负责保卫海祇岛的安全，清理一切危险之物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240218
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120240218,
					"content": "所有像你们一样的人，都可以加入其中，不过训练比较辛苦，希望你们可以咬牙坚持住。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240219
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120240219,
					"content": "珊瑚宫大人的意思是…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240220
					],
					"speakerTitle": "忠胜"
				},
				{
					"id": 120240220,
					"content": "从这次和谈来看，九条家短时间内不会太平。有人想要和平，就有人想要战争。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240221
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120240221,
					"content": "海祇岛向往和平，但也要有自保的能力。既然你们还有战斗意志，就从今天开始魔鬼训练。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240222
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120240222,
					"content": "直到每个人能在正面战场上，打赢两个幕府武士再说！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240223
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120240223,
					"content": "…多谢珊瑚宫大人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240224
					],
					"speakerTitle": "忠胜"
				},
				{
					"id": 120240224,
					"content": "好了，去找五郎报名吧。今后记着，无论发生什么事情，都不可以擅自行动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240225
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120240225,
					"content": "如果再有下次…不管是什么理由，都不会有商量的余地了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240226
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120240226,
					"content": "…明白。从今往后，我们一定好好训练。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240227
					],
					"speakerTitle": "忠胜"
				},
				{
					"id": 120240227,
					"content": "多谢珊瑚宫大人给我们这个机会，我们去找五郎大人报名了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240228
					],
					"speakerTitle": "忠胜"
				},
				{
					"id": 120240228,
					"content": "呼…这样终于妥善解决了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240229
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120240229,
					"content": "总觉得「能量」又开始下降了…我们到「秘密基地」附近休息一下吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚宫心海"
				}
			]
		},
