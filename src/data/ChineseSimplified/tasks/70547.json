			"trigger": {
				"objectNames": [
					"瓦乐瑞娜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705470101,
					"content": "呜啊，是猫猫救星和白猫魔法师！居然等来了你们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470102
					],
					"speakerTitle": "瓦乐瑞娜"
				},
				{
					"id": 705470102,
					"content": "咦？你刚刚叫我们什么来着？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470103,
						705470104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705470103,
					"content": "好像有点耳熟…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470105
					]
				},
				{
					"id": 705470105,
					"content": "唔…总感觉，我们之前应该见过？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705470106,
					"content": "哈哈！白猫魔法师对我还有印象，瓦乐瑞娜大成功！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470107
					],
					"speakerTitle": "瓦乐瑞娜"
				},
				{
					"id": 705470107,
					"content": "叙旧可以等到稍后，现在，要不要先试试我赞助的新游戏？让我最近开心整整一星期的——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470108
					],
					"speakerTitle": "瓦乐瑞娜"
				},
				{
					"id": 705470108,
					"content": "嘟嘟可爆轰大乱斗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470109
					],
					"speakerTitle": "瓦乐瑞娜"
				},
				{
					"id": 705470109,
					"content": "有…有好多种嘟嘟可！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470110,
						705470111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705470110,
					"content": "而且每种都很眼熟。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470112
					]
				},
				{
					"id": 705470112,
					"content": "你看，猫猫救星…咳咳，应该说，闪闪发光的！可敬的荣誉骑士！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470113
					],
					"speakerTitle": "瓦乐瑞娜"
				},
				{
					"id": 705470113,
					"content": "这个嘟嘟可玩偶就是以您为形象参考设计的哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470114
					],
					"speakerTitle": "瓦乐瑞娜"
				},
				{
					"id": 705470114,
					"content": "#真，真的欸，配色和花纹都是{NICKNAME}的风格！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705470115,
					"content": "在游戏中，火花嘟嘟可，闪光嘟嘟可，骑兵嘟嘟可，魔法嘟嘟可要默契合作，使用炸弹战胜前所未见的敌人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470116
					],
					"speakerTitle": "瓦乐瑞娜"
				},
				{
					"id": 705470116,
					"content": "我只负责游戏的赞助和运营，不懂开发的细节，也不知道这些敌人的原型在现实中长什么样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470117
					],
					"speakerTitle": "瓦乐瑞娜"
				},
				{
					"id": 705470117,
					"content": "但我相信，就算哪天真的碰面了，奇妙无比的嘟嘟可一定能打败它们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470118
					],
					"speakerTitle": "瓦乐瑞娜"
				},
				{
					"id": 705470118,
					"content": "那是当然，什么样的魔物都挡不住小可莉和她的好伙伴嘟嘟可，我们也这么觉得！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470119,
						705470120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705470119,
					"content": "那就来试试看吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470121
					]
				},
				{
					"id": 705470121,
					"content": "嘿嘿，你们肯定也能从中获得快乐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瓦乐瑞娜"
				},
				{
					"id": 705470120,
					"content": "新的嘟嘟可游戏！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470121
					]
				},
				{
					"id": 705470111,
					"content": "原型显而易见了呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470112
					]
				},
				{
					"id": 705470104,
					"content": "没听过的新外号…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470105
					]
				}
			]
		}
	]
}