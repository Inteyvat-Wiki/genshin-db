			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"扎卡里亚"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230380101,
					"content": "旅行者！旅行者，请快些过来，我有事情想请你帮忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380102
					],
					"speakerTitle": "扎卡里亚"
				},
				{
					"id": 230380102,
					"content": "发生什么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230380103
					]
				},
				{
					"id": 230380103,
					"content": "你还记得马鲁夫吗？就那位阿如村的医生，之前拜托你找我要过药方的那位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380104
					],
					"speakerTitle": "扎卡里亚"
				},
				{
					"id": 230380104,
					"content": "这家伙自己试吃了一碗自己熬的药，结果整个人上吐下泻了好几天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380105
					],
					"speakerTitle": "扎卡里亚"
				},
				{
					"id": 230380105,
					"content": "我一问才知道，因为病人喝了药汤之后没有效果，他就突发奇想，想要自己改造一下药方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380106
					],
					"speakerTitle": "扎卡里亚"
				},
				{
					"id": 230380106,
					"content": "真不知道这家伙往药汤里加入了什么药材，能把自己搞成现在这样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380107
					],
					"speakerTitle": "扎卡里亚"
				},
				{
					"id": 230380107,
					"content": "唉，如果他只是在原来药汤的基础上调整药材的比例和药汤做法，绝不会出现这种事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380108
					],
					"speakerTitle": "扎卡里亚"
				},
				{
					"id": 230380108,
					"content": "他也不是第一次吃这种亏了，怎么还是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380109
					],
					"speakerTitle": "扎卡里亚"
				},
				{
					"id": 230380109,
					"content": "算了，说不定他也有自己的苦衷吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380110
					],
					"speakerTitle": "扎卡里亚"
				},
				{
					"id": 230380110,
					"content": "旅行者，如果你愿意的话，能帮我去拿点药材回来吗？这回我亲自做一副药，请你直接带给马鲁夫吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380111,
						230380112
					],
					"speakerTitle": "扎卡里亚"
				},
				{
					"id": 230380111,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230380114
					]
				},
				{
					"id": 230380114,
					"content": "马鲁夫这次改的药方，是我上次开给他用来治疗头疼的药方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380115
					],
					"speakerTitle": "扎卡里亚"
				},
				{
					"id": 230380115,
					"content": "我的药方里还差三枚赤念果，拜托你帮我去采三枚回来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "扎卡里亚"
				},
				{
					"id": 230380112,
					"content": "他之前也这么做过吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230380113
					]
				},
				{
					"id": 230380113,
					"content": "是啊，我都忘了这是多少次了。还好他不经手那种药性猛烈的药方，不然…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380114
					],
					"speakerTitle": "扎卡里亚"
				}
			]
		},
