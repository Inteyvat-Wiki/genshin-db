			"dialogs": [
				{
					"id": 738050101,
					"content": "旅行者，稍等一下，这里有一封信给你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738050102
					],
					"speakerTitle": "玛亚姆"
				},
				{
					"id": 738050102,
					"content": "给我的信？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738050103
					]
				},
				{
					"id": 738050103,
					"content": "是那个叫「旭东」的璃月人留给你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738050104,
						738050105
					],
					"speakerTitle": "玛亚姆"
				},
				{
					"id": 738050104,
					"content": "他在哪里？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738050106
					]
				},
				{
					"id": 738050106,
					"content": "那我可就不知道了。前段时间，他匆匆忙忙地过来，交给我了这封信。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738050107
					],
					"speakerTitle": "玛亚姆"
				},
				{
					"id": 738050107,
					"content": "说什么…请务必转交给你，还给了我一笔钱呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738050108
					],
					"speakerTitle": "玛亚姆"
				},
				{
					"id": 738050108,
					"content": "旭东…匆匆忙忙的？有什么事会让他这么着急呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738050109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 738050109,
					"content": "难道…是那个坏蛋又捣乱了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738050110,
						738050111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 738050110,
					"content": "还是先看看信吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738050112
					]
				},
				{
					"id": 738050112,
					"content": "好吧…那我们就先读读这封信吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 738050111,
					"content": "也许他会在信里说明白。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738050112
					]
				},
				{
					"id": 738050105,
					"content": "他为什么要留信给我…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738050106
					]
				}
			]
		}
