					"博来"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223070201,
					"content": "喂，朋友，货要不要？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070202
					],
					"speakerTitle": "博来"
				},
				{
					"id": 223070202,
					"content": "要藏宝图。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223070203
					]
				},
				{
					"id": 223070203,
					"content": "藏宝图？哦…你是说张顺押在我这的那些是吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070204
					],
					"speakerTitle": "博来"
				},
				{
					"id": 223070204,
					"content": "嚯，你还真想去看看藏着什么宝贝？我还是权当收着玩玩呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070205
					],
					"speakerTitle": "博来"
				},
				{
					"id": 223070205,
					"content": "一看你就是个实打实的冒险家，听见宝藏两个字眼睛都在放光。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070206
					],
					"speakerTitle": "博来"
				},
				{
					"id": 223070206,
					"content": "反正这些藏宝图我要了也没用，给你也没关系。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070207
					],
					"speakerTitle": "博来"
				},
				{
					"id": 223070207,
					"content": "不过，你要是真找到了宝贝，咱们得匀一匀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070208
					],
					"speakerTitle": "博来"
				},
				{
					"id": 223070208,
					"content": "毕竟这藏宝图在我这放了这么久，仓储费那也得付点不是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "博来"
				}
			]
		},
		{
			"id": 2230703,
