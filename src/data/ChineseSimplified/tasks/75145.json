			"dialogs": [
				{
					"id": 751450101,
					"content": "受龙所选者…啊，受龙所选者啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751450102,
					"content": "圣山就在汝之身前…如若…就须清除…阴影之敌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751450103,
					"content": "啊，受龙所选者…进入…进入圣山吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751450104,
					"content": "呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450105
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751450105,
					"content": "刚才…火山喷发了…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450106
					]
				},
				{
					"id": 751450106,
					"content": "没有哦，刚才火山非常安静…你们看到火山喷发了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751450107,
					"content": "#怎么了，{NICKNAME}，还有{REALNAME[ID(2)|SHOWHOST(true)]}，怎么一副沉思的样子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751450108,
					"content": "简直就像是侦探小说里突然想到了事件真相的侦探一样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450109,
						751450112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751450109,
					"content": "看到的是别的「真相」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450110
					]
				},
				{
					"id": 751450110,
					"content": "（向派蒙说明了所看到的…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450111
					]
				},
				{
					"id": 751450111,
					"content": "#啊，你是说，看到了和刚进入纳塔遇到{REALNAME[ID(2)|SHOWHOST(true)]}时看到的相同的东西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751450118,
					"content": "还有一些奇怪的影像吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751450119,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450120
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751450120,
					"content": "#在那个时候{NICKNAME}就说看到了奇怪的话…唔，我没看到所以不知道啦，感觉上，像是一个人说的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751450121,
					"content": "应该是同一个人…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450122
					]
				},
				{
					"id": 751450122,
					"content": "不过，这次你们还看到…巨大的遗迹，以及深渊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751450123,
					"content": "还有「圣山」…唔，纳塔人好像也称那座火山为「圣山」，难道说，你们看到的东西和那座火山有关？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751450124,
					"content": "#总觉得那个把{REALNAME[ID(2)|SHOWHOST(true)]}交到我们手上的人好像很想让我们「进入圣山」的样子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751450125,
					"content": "#难道在那里就可以解开{REALNAME[ID(2)|SHOWHOST(true)]}的身世之谜…说不定还能见到它的家人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751450126,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450127
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751450127,
					"content": "总之…我们就留意一下火山相关的情报吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751450128,
					"content": "对了，纳塔六个部族中的「沃陆之邦」好像就在火山的一侧，说不定可以在那里打探消息！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751450112,
					"content": "蛋糕杀人的凶手…就是派蒙你！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450113
					]
				},
				{
					"id": 751450113,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450114
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751450114,
					"content": "可恶，怎么会，明明我偷吃小蛋糕小姐的时候没有被任何人看到…才怪啦，我偷吃的是火焰炖肉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751450115,
					"content": "所以你…不对，你们刚才看到了什么呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751450116,
					"content": "（向派蒙说明了所看到的…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450117
					]
				},
				{
					"id": 751450117,
					"content": "又看到了奇怪的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450118
					],
					"speakerTitle": "派蒙"
				}
			]
