				"points": []
			},
			"dialogs": [
				{
					"id": 790350101,
					"content": "#{NICKNAME}，派蒙，你们见过两只妖狸吗？一只背着紫色包袱，一只背着黄色包袱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790350102
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 790350102,
					"content": "啊！一定是豆助和柴助！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790350103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790350103,
					"content": "看来你们的确知道它们，太好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790350104
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 790350104,
					"content": "欸？难道它们出什么事了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790350105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790350105,
					"content": "那倒不是。只是它们手舞足蹈地比划了一阵以后交给我这个…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790350106
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 790350106,
					"content": "听说之前你们和稻妻的妖狸去过猎鹿人，我猜这两只妖狸或许也是你们的朋友，它们大概是想让我转交给你们吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790350107
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 790350107,
					"content": "哇！是豆助和柴助的礼物！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790350108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790350108,
					"content": "嘿嘿，看来它们的旅途有一个顺利的开始呢，不知道以后还有没有机会见到它们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
