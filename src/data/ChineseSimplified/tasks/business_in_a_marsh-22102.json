			"dialogs": [
				{
					"id": 221020101,
					"content": "真是麻烦哪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020102
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221020102,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221020103
					]
				},
				{
					"id": 221020103,
					"content": "您看我这黑眼圈，我已经多少天没睡过好觉了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020104
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221020104,
					"content": "您见过客栈里的客人吗？那真是，一个比一个会折腾，我们这客栈这么高，也真有人敢往下跳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020105
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221020105,
					"content": "算了，我刚从城里订了批菜，现在估计快要到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020106
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221020106,
					"content": "这路上的怪物啊，肯定也不会乖乖休息，能劳烦您帮我去清一清路吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020107,
						221020108
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221020107,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221020109
					]
				},
				{
					"id": 221020109,
					"content": "那就拜托您了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "淮安"
				},
				{
					"id": 221020108,
					"content": "这家客栈…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221020110
					]
				},
				{
					"id": 221020110,
					"content": "「广收天下客，遍听四海声」…我是这么想来着。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020111
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221020111,
					"content": "不过，其实也就是间客栈，就是地方偏了点，客人多了点，没什么了不起的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020112
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221020112,
					"content": "那么，就万事拜托您了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "淮安"
				}
			]
		},
