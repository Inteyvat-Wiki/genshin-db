			"dialogs": [
				{
					"id": 722030501,
					"content": "哈哈，又被你发现了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722030502
					],
					"speakerTitle": "音乃"
				},
				{
					"id": 722030502,
					"content": "那个，虽然有点舍不得，不过…这次我是来告别的。金色的叔叔说我们要走了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722030503
					],
					"speakerTitle": "音乃"
				},
				{
					"id": 722030503,
					"content": "不过请不要担心，我要去的地方会有好多人和我一起玩的！真希望你也能来呀…但是金色的叔叔说，还不到时候呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722030504
					],
					"speakerTitle": "音乃"
				},
				{
					"id": 722030504,
					"content": "不过没关系的，没关系的！我会等着你的。要是等不及了，我就会变成点点的光，落进你的梦里找你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722030505
					],
					"speakerTitle": "音乃"
				},
				{
					"id": 722030505,
					"content": "一路走好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722030506
					]
				},
				{
					"id": 722030506,
					"content": "嗯，我会的。和你一起玩很开心，谢谢你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722030507
					],
					"speakerTitle": "音乃"
				},
				{
					"id": 722030507,
					"content": "再也不会孤单一个人了，真好呀…",
