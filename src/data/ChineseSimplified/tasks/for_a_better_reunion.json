			"dialogs": [
				{
					"id": 730310101,
					"content": "兰拉迦、兰罗摩，我们回来啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730310102,
					"content": "#又见到那菈{NICKNAME}和派蒙了！真开心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310103
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730310103,
					"content": "#哎呀，你们回来了。大家都在说，有个好高大、好厉害的那菈{NICKNAME}，帮了他们很多很多。大家都很开心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310104
					],
					"speakerTitle": "兰拉迦"
				},
				{
					"id": 730310104,
					"content": "#有人帮忙干活确实很开心呢！对吧，{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310105,
						730310106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730310105,
					"content": "真开心！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310107
					]
				},
				{
					"id": 730310107,
					"content": "不是的。他们开心，是因为认识了新朋友。虽然兰纳真、兰纳迦和兰迦鲁都不记得了，但森林会记住一切。故事不会彻底失落。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310108
					],
					"speakerTitle": "兰拉迦"
				},
				{
					"id": 730310108,
					"content": "噢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730310109,
					"content": "无忧节的准备，应该差不多要好了。还要准备一段时间！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310110
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730310110,
					"content": "#嗯，多亏了那菈{NICKNAME}和派蒙帮忙。无忧节终于快要开始了。真期待呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰拉迦"
				},
				{
					"id": 730310106,
					"content": "哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310107
					]
				}
			]
