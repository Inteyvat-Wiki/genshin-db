					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730310316,
					"content": "嗯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310320
					]
				},
				{
					"id": 730310320,
					"content": "嗯。一会我也会去找兰拉娜。你们先去吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310321
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730310321,
					"content": "#那菈{NICKNAME}、派蒙，我们一会儿见！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730310317,
					"content": "希望如此吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310320
					]
				},
				{
					"id": 730310318,
					"content": "不抱太大期望…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310319
					]
				},
				{
					"id": 730310319,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730310311,
					"content": "我也很期待。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310312
					]
				},
				{
					"id": 730310312,
					"content": "嗯！不知道和别的地方的节日相比，是什么样的感觉呢？能和朋友们一起过节，好兴奋哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730310313,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730310314,
