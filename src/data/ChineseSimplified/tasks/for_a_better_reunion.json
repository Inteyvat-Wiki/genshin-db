					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310315
					]
				},
				{
					"id": 730310315,
					"content": "#嗯，我们去看看拉娜吧，{NICKNAME}。说不定有所好转了呢！哎呀，那我们就能把她带来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310316,
						730310317,
