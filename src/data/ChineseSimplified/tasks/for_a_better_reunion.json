			"dialogs": [
				{
					"id": 730310601,
					"content": "拉娜看起来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730310602,
					"content": "其实我想说「睡得好香」，但这么说好像不太好…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310603
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730310603,
					"content": "（从包裹拉娜的「气泡」当中隐约有什么景象浮现出来…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310604
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730310604,
					"content": "（沉浸到景象中去…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310605
					]
				},
				{
					"id": 730310605,
					"content": "你身处丛林当中，一切都是无比巨大，又无比幽深。但你在其中十分自在。\\n偶然透过树叶洒落的阳光如同金箔一般闪闪发亮，如同你一般高的野草低声地嬉笑着，在你走过时轻轻触碰你的手。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730310606
					]
				},
				{
					"id": 730310606,
					"content": "聆听风中树木的哼唱与流水的奏乐时，你注意到了不安的哭声。循着声音，你找到了一个小小的人儿。\\n似乎是因为哭得累了，她趴在草甸中睡着了。你走到她的身边，轻轻唱起了能令生灵平静的歌…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730310607
					]
				},
				{
					"id": 730310607,
					"content": "#…喂！{NICKNAME}，你怎么了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310608
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730310608,
					"content": "你没事就好…看你的样子，我还以为要晕过去了…担心死了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310609
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730310609,
					"content": "#那菈{NICKNAME}！你们来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310610
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730310610,
					"content": "哇！吓我一跳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310611
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730310611,
					"content": "哇！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310612,
						730310613
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730310612,
					"content": "哇！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310614
					]
				},
				{
					"id": 730310614,
					"content": "真是的，你们兰那罗怎么总是这样神出鬼没啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310615
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730310615,
					"content": "白毛飞飞才是，怎么突然「哇」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310616
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730310616,
					"content": "我叫派蒙，才不是什么白毛飞飞！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310617
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730310617,
					"content": "兰拉娜在地里面，维持兰迦拉梨的力量。这样的话，那菈拉娜就不会枯萎。但是，要重新变得强壮，还是需要惟耶之实。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310618
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730310618,
					"content": "#原来如此。不过，这么说来，{NICKNAME}之前怎么了来着…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310619
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730310619,
					"content": "（说明了感受到的景象…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310620
					]
				},
				{
					"id": 730310620,
					"content": "应该，是兰拉娜的回忆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310621
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730310621,
					"content": "回忆…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310622
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730310622,
					"content": "派蒙不知道。回忆和梦是兰那罗的力量，最珍贵的东西。有梦和回忆，兰拉娜就能用兰迦拉梨，帮助需要帮助的那菈和兰那罗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310623
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730310623,
					"content": "#有的那菈，能感觉到兰迦拉梨里的记忆。看来那菈{NICKNAME}能感觉到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310624
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730310624,
					"content": "这么一听，就感觉兰迦拉梨是很庄重的事情呢！之前，在那个洞窟里，用兰迦拉梨保护优丹的也是兰拉娜吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310625
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730310625,
					"content": "是兰拉娜。那菈优丹、那菈卡乌斯、那菈素达蓓都是兰拉娜的朋友。所以，兰拉娜保护他们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310626
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730310626,
					"content": "他们经常到森林里，和兰拉娜一起玩。兰拉娜教他们森林的知识、花草的语言。是很重要的朋友，和那菈拉娜一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310627
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730310627,
					"content": "关于孩子失踪的事情…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310628
					]
				},
				{
					"id": 730310628,
					"content": "对！说起这个，在优丹之前，卡乌斯和素达蓓也失踪过…但是，后来又被送回了维摩庄。这也是兰拉娜做的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310629
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730310629,
					"content": "嗯。兰拉娜发现，坏那菈和那菈巴螺迦带走他们。所以，兰拉娜就趁坏那菈不知道，帮助那菈卡乌斯和那菈素达蓓，带他们走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310630,
						730310632
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730310630,
					"content": "果然是这样…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310631
					]
				},
				{
					"id": 730310631,
					"content": "嗯…但是，为什么他们对这些事情都没记忆了呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310633
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730310633,
					"content": "兰拉娜让小那菈进入梦，然后在梦里，把不好的东西去掉。这样，他们像小树苗长成大树那样，长大的时候，就不会变坏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310634
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730310634,
					"content": "不然的话，小那菈一直害怕，害怕久了，就会相信「害怕」的力量。然后，等他们长大了，就变成会让别人害怕的坏那菈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310635
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730310635,
					"content": "他们是兰拉娜的好朋友，所以兰拉娜不想他们以后变成坏那菈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310636,
						730310638,
						730310640
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730310636,
					"content": "有道理。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310637
					]
				},
				{
					"id": 730310637,
					"content": "他们一定会长成了不起的大人的！这么说来，那兰拉娜对想要带走他们的坏那菈，有什么眉目吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310641
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730310641,
					"content": "兰拉娜绝不宽恕。那些坏那菈，都不是森林的孩子，他们会带那菈巴螺迦一起来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310642
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730310642,
					"content": "在维摩庄，有一个奇怪的那菈。那个那菈也不是森林的孩子，而是雪的孩子。但是，好像是好那菈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310643
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730310643,
					"content": "因为他经常和小那菈在一起，小那菈也经常说他的故事。但是，兰拉娜看到过他和坏那菈一起说话，还说兰那罗的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310644
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730310644,
					"content": "在维摩庄里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310645,
						730310646
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730310645,
					"content": "愚人众的同伙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310647
					]
				},
				{
					"id": 730310647,
					"content": "怎么会这样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310648
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730310648,
					"content": "呜哇…我不想去想这样的事情，维摩庄的人们，应该像一家人一样才对…而且，就是那个人，害得拉娜变成这样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310649,
						730310650
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730310649,
					"content": "要去逮住坏人才行。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310651
					]
				},
				{
					"id": 730310651,
					"content": "嗯。不管怎么说，我们一定要逮住那个人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310652
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730310652,
					"content": "#那菈{NICKNAME}、派蒙，你们保证。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310653
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730310653,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310654
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730310654,
					"content": "你们保证会惩罚坏那菈。这样，那菈优丹、那菈卡乌斯、那菈素达蓓，就再也不会害怕。就能像小树一样，健康长成大那菈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310655,
						730310656
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730310655,
					"content": "嗯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310657
					]
				},
				{
					"id": 730310657,
					"content": "那菈拉娜已经健康长大了。所以，她已经看不到兰拉娜了。不过，看不到兰拉娜也没关系，兰拉娜知道她好就很高兴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310658
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730310658,
					"content": "已经好久好久没有和那菈拉娜一起玩过了。好多太阳升起又落下，然后月亮出现在天上。好多果实长出来，又回到地里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310659
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730310659,
					"content": "那菈拉娜长得越来越高，一开始和兰拉娜差不多高。但后来就变得像小树一样高。然后她就没有来找兰拉娜玩过了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310660
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730310660,
					"content": "兰拉娜和她说很多森林的故事。星蕈是天上的星星落在地上的倒影。见到月莲开放的话，到月亮再次升起为止都会变得幸运。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310661
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730310661,
					"content": "这些事情，兰拉娜也会教那菈优丹他们。希望他们，能像那菈拉娜那样健康长大。啊，但不能像那菈拉娜那样，跑到无留陀里！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310662
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730310662,
					"content": "他们长大了，会忘记森林里的故事吗？就像拉娜一样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310663
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730310663,
					"content": "那菈优丹、那菈卡乌斯、那菈素达蓓也会长大。就算长大了、忘记了也不要紧…最终，森林会记住一切。一切都不会消失。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310664
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730310664,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310665
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730310665,
					"content": "一切都不会消失。一切美好的事物都不会消散。一切痛苦都会成为美好事物的养分…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310666
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730310666,
					"content": "#兰拉娜！那菈{NICKNAME}、派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310667
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730310667,
					"content": "兰罗摩！兰拉娜好久没看见兰罗摩了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310668,
						730310671
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730310668,
					"content": "派蒙怎么不「哇」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310669
					]
				},
				{
					"id": 730310669,
					"content": "真是的，我才没那么容易被吓到啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310670
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730310670,
					"content": "兰罗摩是要叫我们一起回桓那兰那，过无忧节了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310672
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730310672,
					"content": "#嗯！无忧节已经准备好了，大家都在等那菈{NICKNAME}和派蒙。一起！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310673
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730310673,
					"content": "好耶！无忧节！不过，兰拉娜不去吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310674
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730310674,
					"content": "嗯，兰拉娜不去。如果兰拉娜离去了太久，兰迦拉梨就会崩溃，那菈拉娜就有危险。所以，不能去无忧节。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310675
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730310675,
					"content": "怎么这样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310676
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730310676,
					"content": "#没关系。那菈{NICKNAME}和派蒙开心，兰拉娜、兰罗摩，还有桓那兰那的大家，就会开心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310677
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730310677,
					"content": "嗯。兰拉娜，惟耶之实需要你的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310678
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730310678,
					"content": "到时候兰拉娜会准备好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310679
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730310679,
					"content": "#对了。那菈{NICKNAME}，这个给你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310680
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730310680,
					"content": "是一朵小花…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310681
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730310681,
					"content": "嗯。要好好保护她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310682,
						730310683
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730310682,
					"content": "我会好好保管的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310684
					]
				},
				{
					"id": 730310684,
					"content": "#谢谢那菈{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310685
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730310685,
					"content": "#嗯。那我们回去吧，那菈{NICKNAME}、派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730310683,
					"content": "好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310684
					]
				},
				{
					"id": 730310671,
					"content": "我们要回去过无忧节了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310672
					]
				},
				{
					"id": 730310656,
					"content": "我尽量。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310657
					]
				},
				{
					"id": 730310650,
					"content": "我们会抓住那个人的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310651
					]
				},
