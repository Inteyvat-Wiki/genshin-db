			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿比德",
					"阿迪勒"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190780801,
					"content": "听说了吗？阿尔卡米找来了卡维当培训班的老师。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780802
					],
					"speakerTitle": "阿比德"
				},
				{
					"id": 190780802,
					"content": "嘿，这下他的生意肯定更好了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780803
					],
					"speakerTitle": "阿迪勒"
				},
				{
					"id": 190780803,
					"content": "真让人眼红。阿尔卡米那小子，干建筑设计师的时候就得过且过，论能力他根本当不了老师。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780804
					],
					"speakerTitle": "阿比德"
				},
				{
					"id": 190780804,
					"content": "他宣传得好呗…再加上教令院有入学考试，能进教令院学建筑的人毕竟还是少数。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780805
					],
					"speakerTitle": "阿迪勒"
				},
				{
					"id": 190780805,
					"content": "上不了教令院的人，以及那些追求「速成」的人，自然会汇聚到他的培训机构里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780806
					],
					"speakerTitle": "阿迪勒"
				},
				{
					"id": 190780806,
					"content": "真是生财有道啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿比德"
				}
			]
		},
