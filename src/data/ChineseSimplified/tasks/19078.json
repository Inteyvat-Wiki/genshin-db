			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿丹"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190780401,
					"content": "你好，找我有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780402,
						190780403
					],
					"speakerTitle": "阿丹"
				},
				{
					"id": 190780402,
					"content": "你认识阿尔卡米吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190780404
					]
				},
				{
					"id": 190780404,
					"content": "你说阿尔卡米？是最近很出名的那个有钱人吧？他之前找我定制家具，出手相当阔绰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780405
					],
					"speakerTitle": "阿丹"
				},
				{
					"id": 190780405,
					"content": "听说他以前是知名建筑师，攒下了富裕的家产。现在开设了培训机构，向大家分享自己的致富之路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780406
					],
					"speakerTitle": "阿丹"
				},
				{
					"id": 190780406,
					"content": "如果不是学费太贵，我也想给我的孩子报个名。做建筑师真赚钱啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿丹"
				},
				{
					"id": 190780403,
					"content": "想打听一下阿尔卡米。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190780404
					]
				}
			]
		},
		{
			"id": 1907808,
			"completionStepIds": [
				1907808
