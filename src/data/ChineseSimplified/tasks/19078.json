			"dialogs": [
				{
					"id": 190785001,
					"content": "卡维老师看起来很生气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190785002
					],
					"speakerTitle": "乌宰尔"
				},
				{
					"id": 190785002,
					"content": "管他呢。说不定他是担心，我们将来会抢了他的饭碗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190785003
					],
					"speakerTitle": "瓦伊兹"
				},
				{
					"id": 190785003,
					"content": "这…应该不至于吧？卡维老师那么有名…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190785004
					],
					"speakerTitle": "塔尼莎"
				},
				{
					"id": 190785004,
					"content": "谁知道呢？我爹说了，越有名的人越喜欢摆架子，像阿尔卡米老师那样的才是少数。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瓦伊兹"
				}
			]
		},
