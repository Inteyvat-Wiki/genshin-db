			"dialogs": [
				{
					"id": 412120301,
					"content": "嗯？似乎不在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120302
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412120302,
					"content": "怪物也会出去串门呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412120303,
					"content": "那么，在怪物出现之前，你想四处走走，还是休息一会儿？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120304,
						412120306
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412120304,
					"content": "休息一会儿，聊聊天怎么样？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120305
					]
				},
				{
					"id": 412120305,
					"content": "我也这么想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120309
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412120309,
					"content": "要聊天了吗？我也要听，给我留个位置！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412120310,
					"content": "我知道你对我、对这整件事都有不少问题。如先前所说，我会回答。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120311
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412120311,
					"content": "不过我也不打算欺骗你。有些还不能挑明的事，现阶段请容我略过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120312
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412120312,
					"content": "呜哇…意外地是个很坦率的人呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120313,
						412120314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412120313,
					"content": "比我想的还要真诚呢！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120315
					]
				},
				{
					"id": 412120315,
					"content": "Tiga plata！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120316
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 412120316,
					"content": "嗯嗯！…咦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412120317,
					"content": "Odomu Movo！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120318,
						412120320
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 412120318,
					"content": "是阿贝多在怪叫吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120319
					]
				},
				{
					"id": 412120319,
					"content": "你觉得可能吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120322
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412120322,
					"content": "啊！是丘丘人！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 412120320,
					"content": "是派蒙在怪叫吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120321
					]
				},
				{
					"id": 412120321,
					"content": "才不是！你怎么不说是阿贝多在怪叫呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120322
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412120314,
					"content": "比我想的还要潇洒呢！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120315
					]
				},
				{
					"id": 412120306,
					"content": "正好，我有话想问你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120307
					]
				},
				{
					"id": 412120307,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120308
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412120308,
					"content": "好吧，你想问什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120309
					],
					"speakerTitle": "阿贝多"
				}
			]
		},
