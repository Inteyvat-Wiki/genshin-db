			},
			"dialogs": [
				{
					"id": 412120501,
					"content": "你们看到了吗？那只丘丘人抓着一本书一样的东西跑掉了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412120502,
					"content": "麻烦了…是我的素描本。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120503,
						412120504
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412120503,
					"content": "它也想做绘画大师吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120505
					]
				},
				{
					"id": 412120505,
					"content": "我倒觉得它只是个普通的小偷啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412120506,
					"content": "竟敢偷我的素描本，哼，胆子不小。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120507
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412120507,
					"content": "阿贝多，以一种很平静的方式生气了呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412120508,
					"content": "我会帮忙的！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 412120504,
					"content": "它也想学习炼金术吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120505
					]
				}
			]
		},
