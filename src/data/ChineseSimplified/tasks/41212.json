						412121002
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412121002,
					"content": "（test）唔..这边还有冒险家协会的人留下来的暖源",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412121003
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412121003,
					"content": "（test）哇！该不会是丘丘人在这边埋伏我们吧",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412121004
					]
				},
				{
					"id": 412121004,
					"content": "（test）难道那个坏东西是故意勾引我们过来？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412121005
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412121005,
					"content": "（test）竟然有这种事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412121006
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412121006,
					"content": "（test）哇！他们从山洞里出来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412121007
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412121007,
					"content": "（test）准备迎战",
					"roleType": "TALK_ROLE_NPC",
