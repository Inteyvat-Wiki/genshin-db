			"trigger": {
				"objectNames": [
					"阿贝多"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412120101,
					"content": "阿贝多！我们回来啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412120102,
					"content": "哎呀，是有客人吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120103,
						412120104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412120103,
					"content": "有点眼熟的客人呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120105
					]
				},
				{
					"id": 412120105,
					"content": "让新人来雪山冒险，或许还是太心急了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120106
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 412120106,
					"content": "可是，冒险不就是挑战自我极限吗？没有磨难、没有刺激的旅途还有什么意思！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120107
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 412120107,
					"content": "哪怕这一带到处都有凶恶的丘丘人土匪与淹没到膝盖的积雪，冒险家们也绝不能停下脚步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120108
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 412120108,
					"content": "塞琉斯，说重点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120109
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412120109,
					"content": "哈哈哈，瞧你说的！聊天就跟探险一样，重在过程，哪有什么重点！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120110
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 412120110,
					"content": "嗯！被打劫到放弃据点，在冰冷的雪堆里生火做饭！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120111
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 412120111,
					"content": "雪山之旅对冒险家协会各位新人来说，一定是永生难忘的经历，哈哈哈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120112
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 412120112,
					"content": "嗯，对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120113
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412120113,
					"content": "哪怕此刻他们在心中埋怨我、憎恨我，未来也会为这份回忆感谢我，这就是冒险的传承啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120114
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 412120114,
					"content": "嗯，你接着说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120115
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412120115,
					"content": "呜哇…阿贝多老毛病又犯了，对不感兴趣的东西好冷淡呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412120116,
					"content": "看来他对冒险家的兴趣实在不怎么大。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120117
					]
				},
				{
					"id": 412120117,
					"content": "是吗？我看他对你就很有兴趣啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412120118,
					"content": "不过，该说是新人太弱，还是雪山太强呢？这次可真是损失惨重啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120119
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 412120119,
					"content": "为什么损失惨重？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412120120,
					"content": "哦…！你是…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120121
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 412120121,
					"content": "你好，塞琉斯先生。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120122
					]
				},
				{
					"id": 412120122,
					"content": "好久不见啦——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412120123,
					"content": "#啊~年轻的冒险家和{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}的好伙伴，真高兴在这里见到你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120124
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 412120124,
					"content": "希望这片严寒的山脉没有给你们造成太多麻烦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120125
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 412120125,
					"content": "能应付的都不是麻烦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412120126,
					"content": "哈哈哈，没错！我喜欢你自信的发言！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120127
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 412120127,
					"content": "特意顶着风雪到这里来，是有不得不办的工作吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120128
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 412120128,
					"content": "#我来这里采集丘丘人的最新数据，委托{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}做我的助手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120129,
						412120130
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412120129,
					"content": "（嗯？是这样吗？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120131
					]
				},
				{
					"id": 412120131,
					"content": "原来如此，都是为了理想汇聚在此的追梦者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120132
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 412120132,
					"content": "那就祝各位顺利完成计划。我得先去看看那帮新人，告辞了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120201
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 412120201,
					"content": "哼哼，我好像发现了什么哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412120202,
					"content": "阿贝多瞒着塞琉斯呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120203
					]
				},
				{
					"id": 412120203,
					"content": "毕竟是把魔剑嘛，不想让其他蒙德人知情也算是情有可原。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412120204,
					"content": "我都听见了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120205
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412120205,
					"content": "我是不是不该问？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120206
					]
				},
				{
					"id": 412120206,
					"content": "没有「应该」与「不该」之分。你想知道的事，我都可以说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120207
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412120207,
					"content": "——但不是现在。现在我手上还有些重要的事要办。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120208
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412120208,
					"content": "办事？唔，说是办你自己的事，但我猜…也不会放过我们，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412120209,
					"content": "派蒙，你似乎越来越聪明了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120210
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412120210,
					"content": "什么话！我一直都很聪明啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412120211,
					"content": "我在附近发现了一些新栖息地。不同属性的怪物，能为我们提供不同的数据。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120212
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412120212,
					"content": "你对实验的兴趣可真不小。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120213
					]
				},
				{
					"id": 412120213,
					"content": "实验本就是需要毅力才能做成的事。对炼金术士而言，坚持是最基础的素养。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120214
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412120214,
					"content": "准备好了吗？那就走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412120130,
					"content": "（他似乎不想让别人知道剑的事呢。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120131
					]
				},
				{
					"id": 412120104,
					"content": "我是不是见过这张脸？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120105
					]
				}
			]
		},
