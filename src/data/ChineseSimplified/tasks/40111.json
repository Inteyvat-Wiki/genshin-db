			},
			"dialogs": [
				{
					"id": 401111501,
					"content": "「西风骑兵队长对阵天才不败少年，湖中之城人才辈出」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111502
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 401111502,
					"content": "唔，用这个标题的话，面子倒是给足了，但少了些「爆点」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111503
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 401111503,
					"content": "「西风骑士团的顶尖头脑派，竟在五回合内输给桥头少年」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111504
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 401111504,
					"content": "「如麦穗般辉煌的逆转胜」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111505
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 401111505,
					"content": "嗯，要不，还是用回第一版？…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夏洛蒂"
				}
			]
		},
