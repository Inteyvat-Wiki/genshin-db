					"nextDialogs": [
						401113202
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 401113202,
					"content": "我的话…偶尔迎迎潮流无妨，但还是对棋戏更感兴趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113203
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 401113203,
					"content": "说到底，这些游艺只是形式不同。更珍贵的，还是朋友相聚这一事实。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
