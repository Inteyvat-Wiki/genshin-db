				"objectNames": [
					"凯亚"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401111301,
					"content": "哟，还有什么想聊的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111302,
						401111306,
						401111310
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 401111302,
					"content": "关于「七圣召唤」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401111303
					]
				},
				{
					"id": 401111303,
					"content": "最近这卡牌可真是火爆，简直像成了大家生活的一部分。到处都能看到有人玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111304
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 401111304,
					"content": "而且，还真有人为了保持清醒的头脑打牌，把酒都给戒了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111305
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 401111305,
					"content": "啧啧，迪奥娜听到后应该会很高兴吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111306,
						401111310
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 401111306,
					"content": "骑士团的大家…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401111307
					]
				},
				{
					"id": 401111307,
					"content": "放心放心，大家都挺好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111308
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 401111308,
					"content": "我曾经试过拉琴团长一起玩，结果刚打到一半她就被人喊走了，残局还是由我打完的，唉，真是没办法。只能说是「各司其职」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111309
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 401111309,
					"content": "不过看到这次大赛办得这么成功，大家都乐在其中，她恐怕也能松一口气吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111302,
						401111310
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 401111310,
					"content": "改天再聊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401111311
					]
				},
				{
					"id": 401111311,
					"content": "好呀，有机会还想和你也来一局「七圣召唤」呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凯亚"
				}
			]
		},
		{
