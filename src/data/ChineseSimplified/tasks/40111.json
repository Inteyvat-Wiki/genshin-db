			"dialogs": [
				{
					"id": 401113101,
					"content": "这么说来，北斗姐也会打「七圣召唤」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113102
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 401113102,
					"content": "嗯，大姐头的牌技在南十字船队称得上数一数二了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113103
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 401113103,
					"content": "要不万叶小哥帮我引荐引荐？我对北斗姐崇拜已久，早就想跟她交朋友啦，可一直没遇到机会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113104
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 401113104,
					"content": "好。到时候还请堂主手下留情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "枫原万叶"
				}
			]
		},
		{
