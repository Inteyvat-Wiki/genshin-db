					"content": "那就来一局。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401115105
					]
				},
				{
					"id": 401115105,
					"content": "挚友啊！你真的是我的挚友！我这熊熊燃烧的卡牌之魂，只有你才能懂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115106
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 401115106,
					"content": "…真拿你们没办法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 401115107,
					"content": "这次不打了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401115108
					]
				},
				{
					"id": 401115108,
					"content": "…好吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115109
					],
					"speakerTitle": "荒泷一斗"
