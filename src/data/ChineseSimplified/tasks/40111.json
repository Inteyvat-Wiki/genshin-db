			"trigger": {
				"objectNames": [
					"提米"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401111101,
					"content": "赢喽赢喽！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111102,
						401111106
					],
					"speakerTitle": "提米"
				},
				{
					"id": 401111102,
					"content": "恭喜提米！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401111103
					]
				},
				{
					"id": 401111103,
					"content": "谢谢你们。这样一来，妈妈一定也会开心的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111104
					],
					"speakerTitle": "提米"
				},
				{
					"id": 401111104,
					"content": "葛瑞丝妈妈一直鼓励我来参加比赛，我要把得到的奖品都送给妈妈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111105
					],
					"speakerTitle": "提米"
				},
				{
					"id": 401111105,
					"content": "真希望爸爸也能看到我现在的样子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "提米"
				},
				{
					"id": 401111106,
					"content": "再见。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401111107
					]
				},
				{
					"id": 401111107,
					"content": "再见，「七圣召唤」真好玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "提米"
				}
			]
		},
		{
			"id": 4011112,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4011101",
							"2"
						],
						"stepId": 4011101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"米卡",
					"霍夫曼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401111201,
					"content": "已经散场了吗？我、我来晚了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111202
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 401111202,
					"content": "米卡，真遗憾你没看到。凯亚队长…居然输了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111203
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 401111203,
					"content": "啊？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111204
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 401111204,
					"content": "哥哥，具体是怎么回事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111205
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 401111205,
					"content": "我对「七圣召唤」没什么研究，全靠大家的谈论来理解局势。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111206
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 401111206,
					"content": "一开始，凯亚队长很快拿下了对面的第一张牌，形势大优。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111207
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 401111207,
					"content": "但这似乎正是对方的策略？那位叫提米的孩子，靠着前几个回合囤积起手上的卡牌…最后爆发出了惊人的威力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111208
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 401111208,
					"content": "不…或许这场比赛的胜负，早在凯亚队长抽到「后手」的那一刻，就被决定了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111209
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 401111209,
					"content": "唉，我想去喝一杯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111210
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 401111210,
					"content": "哥哥，你冷静一点，现在不是借酒消愁的时候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111211
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 401111211,
					"content": "据我了解的凯亚队长，他应该也不想看到你为他难过才对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111212
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 401111212,
					"content": "倒不如我们也学学打牌吧？说不好下次还能跟凯亚队长亲自过招！哈哈…恐怕会输得很惨吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111213
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 401111213,
					"content": "哈，你说得对，米卡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "霍夫曼"
				}
			]
		},
		{
			"id": 4011113,
			"completionStepIds": [],
