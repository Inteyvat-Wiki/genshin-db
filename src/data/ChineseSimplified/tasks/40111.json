			},
			"dialogs": [
				{
					"id": 401113301,
					"content": "您好您好，我是来自枫丹「蒸汽鸟报社」的记者夏洛蒂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113302
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 401113302,
					"content": "请问方便抽点时间吗？我想对您做个简单采访。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113303
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 401113303,
					"content": "唉，你问吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113304
					],
					"speakerTitle": "小千"
				},
				{
					"id": 401113304,
					"content": "您一路过关斩将，最后关头不敌往生堂的胡桃胡堂主，与冠军失之交臂，看起来相当遗憾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113305
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 401113305,
					"content": "请问您会如何评价这场比赛呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113306
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 401113306,
					"content": "…这。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113307
					],
					"speakerTitle": "小千"
				},
				{
					"id": 401113307,
					"content": "记者小姐，你要的是能写上报纸的回答，还是我的真实想法？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113308
					],
					"speakerTitle": "小千"
				},
				{
					"id": 401113308,
					"content": "当然是真实想法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113309
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 401113309,
					"content": "唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113310
					],
					"speakerTitle": "小千"
				},
				{
					"id": 401113310,
					"content": "虽然打牌七分靠技术，三分靠运气…但这一次投出六个同色骰，别说我只是个冒险家，就算我是仙人也打不过啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小千"
				}
			]
		},
