			"dialogs": [
				{
					"id": 711200101,
					"content": "喂，离远点！这是老爷的地盘！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200102
					],
					"speakerTitle": "坐地虎"
				},
				{
					"id": 711200102,
					"content": "哇啊，好凶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200103,
						711200106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711200103,
					"content": "你们是什么人？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711200104
					]
				},
				{
					"id": 711200104,
					"content": "看你咯。你若客客气气的，我们便是朋友！你若打探太多，便别怪我们不客气啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200105
					],
					"speakerTitle": "盘枝蛇"
				},
				{
					"id": 711200105,
					"content": "劝你有点眼力见儿，哪里来的回哪里去！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200109
					],
					"speakerTitle": "坐地虎"
				},
				{
					"id": 711200109,
					"content": "你们也太可疑了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711200110,
					"content": "可疑？唉哟…我们就是看门的而已，你们这幅探头探脑的样子才更可疑吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200111
					],
					"speakerTitle": "盘枝蛇"
				},
				{
					"id": 711200111,
					"content": "行了，有什么好说！别打扰我们了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "坐地虎"
				},
				{
					"id": 711200106,
					"content": "这是哪位「老爷」的地盘？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711200107
					]
				},
				{
					"id": 711200107,
					"content": "哪位「老爷」？哼…说出来吓死你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200108
					],
					"speakerTitle": "坐地虎"
				},
				{
					"id": 711200108,
					"content": "为你自己好，朋友！不该知道的东西就别乱打听了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200109
					],
					"speakerTitle": "盘枝蛇"
				}
			]
		},
