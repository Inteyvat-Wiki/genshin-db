			"dialogs": [
				{
					"id": 711209101,
					"content": "怎么又是你们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209102
					],
					"speakerTitle": "坐地虎"
				},
				{
					"id": 711209102,
					"content": "收收好奇心，朋友。你们就当没看见我们，我们也当没看见你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209103,
						711209111
					],
					"speakerTitle": "盘枝蛇"
				},
				{
					"id": 711209103,
					"content": "你们在看守什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711209104
					]
				},
				{
					"id": 711209104,
					"content": "朋友，你猜我们领工钱为了什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209105
					],
					"speakerTitle": "盘枝蛇"
				},
				{
					"id": 711209105,
					"content": "为什么呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711209106,
					"content": "咳咳…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209107
					],
					"speakerTitle": "盘枝蛇"
				},
				{
					"id": 711209107,
					"content": "（我只告诉你两个，别让别人知道哦…来来，我告诉你…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209108
					],
					"speakerTitle": "盘枝蛇"
				},
				{
					"id": 711209108,
					"content": "（嗯嗯！我听着呢！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711209109,
					"content": "为了让你们这种闲人滚蛋！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209110
					],
					"speakerTitle": "盘枝蛇"
				},
				{
					"id": 711209110,
					"content": "哇啊！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711209111,
					"content": "山洞里有奇怪的声音…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711209112
					]
				},
				{
					"id": 711209112,
					"content": "我放屁了！",
