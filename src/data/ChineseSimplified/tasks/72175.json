			"dialogs": [
				{
					"id": 721750401,
					"content": "两位好！最近有什么收获吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750402,
						721750405
					],
					"speakerTitle": "罗尔德"
				},
				{
					"id": 721750402,
					"content": "没发现什么有趣的东西。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750403
					]
				},
				{
					"id": 721750403,
					"content": "不用急躁，我一直在这里的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750404
					],
					"speakerTitle": "罗尔德"
				},
				{
					"id": 721750404,
					"content": "顺便，谢谢你送的「幽灯蕈」。很新鲜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750407
					],
					"speakerTitle": "罗尔德"
				},
				{
					"id": 721750407,
					"content": "说的倒是轻松，你吃的蘑菇不还是我们采的吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721750408,
					"content": "哈哈，别在意那么多嘛，我一直在吃呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750409
					],
					"speakerTitle": "罗尔德"
				},
				{
					"id": 721750409,
					"content": "哇——这个健忘人！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721750405,
					"content": "还在努力奔走。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750406
					]
				},
				{
					"id": 721750406,
					"content": "累了的话也请休息一下，来点「幽灯蕈」吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750407
					],
					"speakerTitle": "罗尔德"
				}
			]
		},
		{
			"id": 7217506,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
