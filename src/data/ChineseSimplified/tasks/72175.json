			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"罗尔德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721750101,
					"content": "没想到你们也还在这座岛上，真是太好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750102
					],
					"speakerTitle": "罗尔德"
				},
				{
					"id": 721750102,
					"content": "你们近来如何？有没有什么惊人的发现？说来让我听听嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750103,
						721750105
					],
					"speakerTitle": "罗尔德"
				},
				{
					"id": 721750103,
					"content": "没什么发现。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750104
					]
				},
				{
					"id": 721750104,
					"content": "难免的，难免的！这样一座岛屿上从来不缺少秘密，相信你一定能有所发现的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750107
					],
					"speakerTitle": "罗尔德"
				},
				{
					"id": 721750107,
					"content": "话说回来，罗尔德先生在这里做什么呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721750108,
					"content": "嗯？我刚收拾好营地行李，正准备离开呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750109
					],
					"speakerTitle": "罗尔德"
				},
				{
					"id": 721750109,
					"content": "这座岛上的浓雾太邪门了…每次深入没多远就会迷失方向。然后不知不觉间就会回到起点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750110
					],
					"speakerTitle": "罗尔德"
				},
				{
					"id": 721750110,
					"content": "先前阿釜特意指引的道路让我给忘了个干净…结果想要再回去寻访那边的原住民，却再也找不到路了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750111
					],
					"speakerTitle": "罗尔德"
				},
				{
					"id": 721750111,
					"content": "身上的罗盘也好，地上的影子也好，都没法用来指明方向…甚至我连鞋子都试过了，可到最后也没能在雾中多前进半步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750112
					],
					"speakerTitle": "罗尔德"
				},
				{
					"id": 721750112,
					"content": "鞋子…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721750113,
					"content": "他说的是丢鞋指路。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750114
					]
				},
				{
					"id": 721750114,
					"content": "欸——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721750115,
					"content": "#哈！这种资深冒险家的小技巧果然难不住{NICKNAME}！小派蒙要多学学咯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750116
					],
					"speakerTitle": "罗尔德"
				},
				{
					"id": 721750116,
					"content": "派蒙还需要学习哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750117
					]
				},
				{
					"id": 721750117,
					"content": "根本是碰运气吧！这种东西有什么必要学啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721750118,
					"content": "总之就是这样，我的探索裹足不前。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750119
					],
					"speakerTitle": "罗尔德"
				},
				{
					"id": 721750119,
					"content": "唉…假如把绳索绑在附近的树上，紧握着另一端摸索前进的话，本来还可以再多试几次的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750120
					],
					"speakerTitle": "罗尔德"
				},
				{
					"id": 721750120,
					"content": "所以为什么不再试试了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721750121,
					"content": "用来分辨方向的备用鞋子丢完了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750122,
						721750124
					],
					"speakerTitle": "罗尔德"
				},
				{
					"id": 721750122,
					"content": "原来备用鞋子都是一次性的吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750123
					]
				},
				{
					"id": 721750123,
					"content": "嘿嘿，原本不是的。只是丢多了，就总是忘了回头捡回来，结果慢慢就都…消耗掉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750126
					],
					"speakerTitle": "罗尔德"
				},
				{
					"id": 721750126,
					"content": "啊！对了，我终于想起自己有什么事情要拜托你们了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750127
					],
					"speakerTitle": "罗尔德"
				},
				{
					"id": 721750127,
					"content": "哇，吓我一跳！还以为你要咬人了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721750128,
					"content": "抱歉，抱歉，呵呵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750129
					],
					"speakerTitle": "罗尔德"
				},
				{
					"id": 721750129,
					"content": "如你所知，我本来就有个丢脸的毛病…就是无论做什么都丢三落四的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750130
					],
					"speakerTitle": "罗尔德"
				},
				{
					"id": 721750130,
					"content": "生来记忆力不佳，给我造成了很多不便，尤其身为冒险家，很容易为此而陷入危险…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750131
					],
					"speakerTitle": "罗尔德"
				},
				{
					"id": 721750131,
					"content": "而我此次来到鹤观的目的之一，是采集一种名为「幽灯蕈」的菌类。听珊瑚小姐说，这种菌类能够增强记忆力，缓解大脑劳损，对视力也有好处。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750132
					],
					"speakerTitle": "罗尔德"
				},
				{
					"id": 721750132,
					"content": "上次与阿釜一同前来，因为对「遇见原住民」这件事太过上心…反倒忘了采集菌类…唉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750133
					],
					"speakerTitle": "罗尔德"
				},
				{
					"id": 721750133,
					"content": "又没能想到，自己一个人登岛之后就遇到了这样的困难…真是可惜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750134
					],
					"speakerTitle": "罗尔德"
				},
				{
					"id": 721750134,
					"content": "如果你们在这里还有冒险安排的话，不知可否请帮我采摘一些「幽灯蕈」回来？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750135,
						721750137
					],
					"speakerTitle": "罗尔德"
				},
				{
					"id": 721750135,
					"content": "没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750136
					]
				},
				{
					"id": 721750136,
					"content": "十分感谢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "罗尔德"
				},
				{
					"id": 721750137,
					"content": "到时候别忘了找我要就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750138
					]
				},
				{
					"id": 721750138,
					"content": "哈哈，这个不会忘的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "罗尔德"
				},
				{
					"id": 721750124,
					"content": "真是遗憾…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750125
					]
				},
				{
					"id": 721750125,
					"content": "唉，说的是呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750126
					],
					"speakerTitle": "罗尔德"
				},
				{
					"id": 721750105,
					"content": "我们还在探索途中。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750106
					]
				},
				{
					"id": 721750106,
					"content": "这样呀，哈哈，那就别让我耽误你们的路程了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750107
					],
					"speakerTitle": "罗尔德"
				}
			]
		},
		{
			"id": 7217503,
			"completionStepIds": [
				7217510
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7217517",
							"3"
						],
						"stepId": 7217517,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7217510",
							"2"
						],
						"stepId": 7217510,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"罗尔德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721750301,
					"content": "嗯…有这些的话应该足够了，谢谢你们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750302
					],
					"speakerTitle": "罗尔德"
				},
				{
					"id": 721750302,
					"content": "顺便，如果你们在岛上的「祭场」附近有什么发现的话，还望告知我一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750303
					],
					"speakerTitle": "罗尔德"
				},
				{
					"id": 721750303,
					"content": "啊…对了，你们随身带着「留影机」，枫丹货，对吧？那东西还挺贵的…如果经费有宽裕的话，我也得给自己采购一台。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750304
					],
					"speakerTitle": "罗尔德"
				},
				{
					"id": 721750304,
					"content": "听本地的历史作家所言，传说鹤观的古代原住民会用颜料将无法追忆的古老历史涂画在山洞内的岩壁上，往往存续超过千年…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750305
					],
					"speakerTitle": "罗尔德"
				},
				{
					"id": 721750305,
					"content": "此前的寻访中，我似乎也借着祭典的火光看到了些许图案…自此之后就难以忘怀，几天都没有睡好觉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750306
					],
					"speakerTitle": "罗尔德"
				},
				{
					"id": 721750306,
					"content": "这些壁画，据我所知从未有人目睹…假如能够借二位的口述得以证实的话，将会为「冒险家协会」在历史学术范畴带来又一大突破。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750307
					],
					"speakerTitle": "罗尔德"
				},
				{
					"id": 721750307,
					"content": "所以我希望二位能寻到传说中的壁画，尽可能完整清晰地拍摄下来。我会买下你们的照片作为日志素材所需，并且为你们支付足够的辛苦费。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750308
					],
					"speakerTitle": "罗尔德"
				},
				{
					"id": 721750308,
					"content": "不知两位意下如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750309,
						721750311
					],
					"speakerTitle": "罗尔德"
				},
				{
					"id": 721750309,
					"content": "没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750310
					]
				},
				{
					"id": 721750310,
					"content": "非常感谢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "罗尔德"
				},
				{
					"id": 721750311,
					"content": "只要你别再弄丢日志。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750312
					]
				},
				{
					"id": 721750312,
					"content": "我…我尽力而为。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "罗尔德"
				}
			]
		},
