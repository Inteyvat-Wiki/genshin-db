					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721751801,
					"content": "#又见面了，{NICKNAME}！还有…那个…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751802
					],
					"speakerTitle": "罗尔德"
				},
				{
					"id": 721751802,
					"content": "…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751803
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721751803,
					"content": "顺便一问，这个飞来飞去的小家伙怎么卖？看上去蛮有趣的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751804
					],
					"speakerTitle": "罗尔德"
				},
				{
					"id": 721751804,
					"content": "欸？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751805,
						721751807
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721751805,
					"content": "你还好吗…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751806
					]
				},
				{
					"id": 721751806,
					"content": "明显不太好吧！这家伙怎么突然失忆了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751809
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721751809,
					"content": "你们在说什…噗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751810
					],
					"speakerTitle": "罗尔德"
				},
				{
					"id": 721751810,
					"content": "噗…哈哈哈哈哈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751811
					],
					"speakerTitle": "罗尔德"
				},
				{
					"id": 721751811,
					"content": "？？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751812
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721751812,
					"content": "？？？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751813
					]
				},
				{
					"id": 721751813,
					"content": "哈哈哈哈…咳咳…哈哈哈哈哈！瞧瞧…瞧瞧你们那副表情！噗哈哈哈哈哈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751814
					],
					"speakerTitle": "罗尔德"
				},
				{
					"id": 721751814,
					"content": "完了…我笑岔气了…对不…对不起…这是…呵哈哈哈哈…这是我最喜欢的「健忘笑话」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751815
					],
					"speakerTitle": "罗尔德"
				},
				{
					"id": 721751815,
					"content": "一点也不好笑吧！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751816,
						721751817
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721751816,
					"content": "不是很懂你的幽默感…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751818
					]
				},
				{
					"id": 721751818,
					"content": "噗…好了，好了，不开玩笑了，抱歉抱歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751819
					],
					"speakerTitle": "罗尔德"
				},
				{
					"id": 721751819,
					"content": "真是的，我还以为你作为大冒险家，是个很严肃的人呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751820
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721751820,
					"content": "呵呵，可不要产生这样的刻板印象哦，冒险家协会可是有名的怪人圈子。我在里面算是比较正常的呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751821
					],
					"speakerTitle": "罗尔德"
				},
				{
					"id": 721751821,
					"content": "…也没有多正常吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751822
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721751822,
					"content": "还是谢谢你们的蘑菇。这东西到现在为止效果还不太明显…或许是需要长期服用，也许本身就不是什么药物…总之味道不差就是了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751823
					],
					"speakerTitle": "罗尔德"
				},
				{
					"id": 721751823,
					"content": "这些可不能全吃完了，我还要留一些给须弥的朋友，帮忙研究一下它的药用价值。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751824
					],
					"speakerTitle": "罗尔德"
				},
				{
					"id": 721751824,
					"content": "我猜你一转头就会把这事忘了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751825
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721751825,
					"content": "咳咳，正事正事。请问二位有没有去寻找壁画呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751826
					],
					"speakerTitle": "罗尔德"
				},
				{
					"id": 721751826,
					"content": "这里是你要的相片。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751827
					]
				},
				{
					"id": 721751827,
					"content": "哦哦，大恩不言谢！这个国家是这样表达感谢的，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751828
					],
					"speakerTitle": "罗尔德"
				},
				{
					"id": 721751828,
					"content": "唔嗯…有趣，非常有趣。只是…你们没有发现更多壁画了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751829,
						721751830
					],
					"speakerTitle": "罗尔德"
				},
				{
					"id": 721751829,
					"content": "这些是全部了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751831
					]
				},
				{
					"id": 721751831,
					"content": "那就更有意思了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751832
					],
					"speakerTitle": "罗尔德"
				},
				{
					"id": 721751832,
					"content": "咦…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751833
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721751833,
					"content": "鹤观的原住民曾以雷元素之魔鸟为信仰，以祭祀仪礼为核心组建起自己的文明。稍微了解历史的人对此应该并无异见…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751834
					],
					"speakerTitle": "罗尔德"
				},
				{
					"id": 721751834,
					"content": "但在你们提供的壁画上…却没有雷鸟的痕迹。人们所膜拜的是另一些东西——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751835
					],
					"speakerTitle": "罗尔德"
				},
				{
					"id": 721751835,
					"content": "日月星辰…和…奇怪的符号。或许…在雷鸟降临之前，鹤观原住民的先祖们就已经拥有了一定高度的文明…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751836
					],
					"speakerTitle": "罗尔德"
				},
				{
					"id": 721751836,
					"content": "除此之外…雾与月亮，群星与黑暗…唔，解释不通呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751837
					],
					"speakerTitle": "罗尔德"
				},
				{
					"id": 721751837,
					"content": "还是不要过度用脑了吧…你的记性已经很不行了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751838
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721751838,
					"content": "…啊，抱歉。思考太入迷，忘了你们还在场。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751839
					],
					"speakerTitle": "罗尔德"
				},
				{
					"id": 721751839,
					"content": "再次感谢你们的辛劳，我接下来的日志有了足够的素材…假如能有幸被历史学者重视的话，我是不会忘记署上二位的大名的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751840
					],
					"speakerTitle": "罗尔德"
				},
				{
					"id": 721751840,
					"content": "好了，我也该去冒险家协会报道了。实在抱歉打扰了你很长时间，希望下次有缘再见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751841
					],
					"speakerTitle": "罗尔德"
				},
				{
					"id": 721751841,
					"content": "真是个大忙人呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751842
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721751842,
					"content": "啊，顺便…还有一件事。虽然不是什么大事，但希望你能替我关注一下。先前提到的那个小孩子…叫…什么来着…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751843
					],
					"speakerTitle": "罗尔德"
				},
				{
					"id": 721751843,
					"content": "「阿瑠」…对，是这个名字。我这次顺便给那孩子带了些吃的…希望还新鲜。",
