			},
			"dialogs": [
				{
					"id": 721750601,
					"content": "#你好啊，{NICKNAME}，还有多话的小精灵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750602
					],
					"speakerTitle": "罗尔德"
				},
				{
					"id": 721750602,
					"content": "你好呀，健·忘·人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750603
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721750603,
					"content": "我·是·派·蒙！下次可不要忘记啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721750604,
					"content": "我知道呀，小·派·蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750605
					],
					"speakerTitle": "罗尔德"
				},
				{
					"id": 721750605,
					"content": "哇！原来你在耍我！你这人的礼貌哪里去啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721750606,
					"content": "#哼，{NICKNAME}快把那些鬼里鬼气的蘑菇给他吧，我不要和他说话了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750607
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721750607,
					"content": "这些足够吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
