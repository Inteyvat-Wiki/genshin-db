			"dialogs": [
				{
					"id": 721520101,
					"content": "「…此处曾是大海贼林藏的藏宝之地，兄弟们搬走了最后几箱…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520102
					],
					"speakerTitle": "盗宝团的笔记"
				},
				{
					"id": 721520102,
					"content": "「…但林藏生前诡计多端，在岛上多处留下了专属记号…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520103
					],
					"speakerTitle": "盗宝团的笔记"
				},
				{
					"id": 721520103,
					"content": "「…或许只是掩饰，或许确有宝藏，但只有前往一探究竟才能确定…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520104
					],
					"speakerTitle": "盗宝团的笔记"
				},
				{
					"id": 721520104,
					"content": "「…我们已经发现了一些标记，时不我待，该动身去发掘林藏的全部遗宝了！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520105
					],
					"speakerTitle": "盗宝团的笔记"
				},
				{
					"id": 721520105,
					"content": "唔…好长…除了「宝藏」两个字以外完全不想读…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721520106,
					"content": "欸…？宝藏？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721520107,
					"content": "既然有宝藏，我们也快点出发吧！别让盗宝团抢先啦！",
