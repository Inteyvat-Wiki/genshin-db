						110020202
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110020202,
					"content": "已经想到要找什么了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110020203,
					"content": "当然没有！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020204
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110020204,
					"content": "那为什么会这么理直气壮啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110020205,
					"content": "这是我的风格嘛，如果在做一道菜之前就想好了要做什么，那注定就是一份没有惊喜的料理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020206
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110020206,
					"content": "同样，如果在找到之前就想好了要找什么，那也是没有惊喜的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020207
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110020207,
					"content": "这也太粗放了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110020208,
					"content": "放心吧，「万民堂」的招牌菜都是这么来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020209
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110020209,
					"content": "先在周围随便看看吧，如果我看到中意的材料我会告诉你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "香菱"
				}
			]
		},
