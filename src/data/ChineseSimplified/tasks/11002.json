			"dialogs": [
				{
					"id": 110020701,
					"content": "总觉得还缺点什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020702,
						110020703
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110020702,
					"content": "什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110020704
					]
				},
				{
					"id": 110020704,
					"content": "嗯，少一种「噼咔」的感觉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020705
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110020705,
					"content": "这么一说确实不够「噼咔」呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020706,
						110020707
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110020706,
					"content": "「噼咔」？！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110020708
					]
				},
				{
					"id": 110020708,
					"content": "哼哼哼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020709
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110020709,
					"content": "布洛克虽然守规矩了点，但还是有很强的实力的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020710
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110020710,
					"content": "她一定会使用最得意的食材，想要取胜，就需要一道令人耳目一新的菜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020711
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110020711,
					"content": "比如凉拌海兽肉啊，干煸清心花啊，史莱姆滑野蘑菇之类的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020712
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110020712,
					"content": "史、史莱姆滑野蘑菇？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020713
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110020713,
					"content": "哈哈，我知道听着有点奇怪，但味道绝对是一级棒！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020714
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110020714,
					"content": "有机会做给你们尝尝吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020715,
						110020717
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110020715,
					"content": "好想吃。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110020716
					]
				},
				{
					"id": 110020716,
					"content": "嘿嘿，味道不会让你失望的，就是卖相稍微有一点点奇怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020719
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110020719,
					"content": "先不说这个了，我想起来上次有个地方我还没去过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020720
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110020720,
					"content": "我的直觉告诉我会有什么好东西，我们去找找看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "香菱"
				},
				{
					"id": 110020717,
					"content": "不、不用了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110020718
					]
				},
				{
					"id": 110020718,
					"content": "欸？明明就很好吃的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020719
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110020707,
					"content": "为什么派蒙能明白？！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110020708
					]
				},
				{
					"id": 110020703,
					"content": "不够印象深刻吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110020704
					]
				}
