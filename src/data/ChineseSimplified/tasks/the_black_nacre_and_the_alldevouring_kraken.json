			},
			"dialogs": [
				{
					"id": 790450101,
					"content": "人员与设施准备停当，机关预热完毕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450102
					],
					"speakerTitle": "乐园告示喇叭"
				},
				{
					"id": 790450102,
					"content": "「黛依阿的三日遐想」之「黑水晶号与吞金海怪」，正式开幕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450103
					],
					"speakerTitle": "乐园告示喇叭"
				},
				{
					"id": 790450103,
					"content": "距离藏宝地最近的海港中，海盗船「黑水晶」号正在补充人员与物资，为最后也是最关键的一段航行做准备…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450104
					],
					"speakerTitle": "来自喇叭的旁白"
				},
				{
					"id": 790450104,
					"content": "#经验丰富的冒险家们登上了「黑水晶」号的甲板。{M#他们}{F#她们}是杰出的战斗专家，但在航海领域尚且只是新人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450105
					],
					"speakerTitle": "来自喇叭的旁白"
				},
				{
					"id": 790450105,
					"content": "那边的新人，快过来快过来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450106
					],
					"speakerTitle": "大副"
				},
				{
					"id": 790450106,
					"content": "咦，喇叭里的声音变了，好像是个很严肃的人在朝我们这边呼喊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790450107,
					"content": "难道说，这个声音是在和我们互动？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790450108,
					"content": "当然了！你们是新人里的骨干，少了你们可不行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450109
					],
					"speakerTitle": "大副"
				},
				{
					"id": 790450109,
					"content": "我是这艘「黑水晶」号的大副。接下来这段时间，你们就要跟着我混了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450110
					],
					"speakerTitle": "大副"
				},
				{
					"id": 790450110,
					"content": "打起精神来！今天你们刚到任，厨师长会用上好的肉脯、奶油、硬饼干和蒲公英酒招待你们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450111
					],
					"speakerTitle": "大副"
				},
				{
					"id": 790450111,
					"content": "来自喇叭的旁白继续述说着你们眼前的场景——\\n\\n出现在新人眼前的大副衣衫褴褛，全身上下打满绷带。\\n显然，不久之前，他才经历过一场激烈的战斗。\\n而放眼望去，甲板上的水手们大多身受重伤…\\n但他们精神饱满，斗志昂扬，完全没有气馁或退缩…\\n水手们将你们围在中间，鼓掌欢迎你们的加入，递上了见面礼和各种食物。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						790450112
					]
				},
				{
					"id": 790450112,
					"content": "原来如此，还有详细的旁白，让我们想象现在的情景呢——我们刚到这艘「黑水晶」号来报到，就受到了大家的热烈欢迎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790450113,
					"content": "那我们是不是应该配合一下？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790450114,
					"content": "嘿嘿嘿，谢谢大家，谢谢大家！船上的肉脯和硬饼干，虽然没有尝过，但味道应该还不错？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450115,
						790450116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790450115,
					"content": "可惜看不见演员和道具。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790450117
					]
				},
				{
					"id": 790450117,
					"content": "确实呢，这个游乐项目取名「三日遐想」，难道真的是要我们充分发挥「遐想」的力量吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790450118,
					"content": "虽然出于节约成本的角度可以理解啦——真的搭建一艘海盗船，再准备好可以随意航行的场地，肯定要花很多摩拉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790450119,
					"content": "但完全只靠对白文字，未免也太勉强我们了嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450120,
						790450121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790450120,
					"content": "试试看就知道成色了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790450122
					]
				},
				{
					"id": 790450122,
					"content": "好吧，那就先试试看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790450123,
					"content": "一阵喧闹过后，壮硕的男子出现在露天舰桥上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450124
					],
					"speakerTitle": "来自喇叭的旁白"
				},
				{
					"id": 790450124,
					"content": "他的衣着与普通水手无异，只是戴着一顶粗糙的三角帽，左手手掌不见影踪，取而代之的是一根生锈的铁钩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450125
					],
					"speakerTitle": "来自喇叭的旁白"
				},
				{
					"id": 790450125,
					"content": "全体注意！船长威尔到岗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450126
					],
					"speakerTitle": "大副"
				},
				{
					"id": 790450126,
					"content": "时候到了，弟兄们！回到各自的部门，检查武备和给养，调整船舶的状态，准备出航！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450127
					],
					"speakerTitle": "威尔船长"
				},
				{
					"id": 790450127,
					"content": "喔！船长出现了， 声音好沉稳…听起来就是个很可靠的人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790450128,
					"content": "藏宝地就在不远外，接下来的一段航程，将是这次远航中最为重要的环节！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450129
					],
					"speakerTitle": "威尔船长"
				},
				{
					"id": 790450129,
					"content": "之前受伤的弟兄们、落水的物资、走失的暝彩鸟朋友、还有好不容易凑钱买来的上好酒桶…所有付出都不会白费！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450130
					],
					"speakerTitle": "威尔船长"
				},
				{
					"id": 790450130,
					"content": "只要找到了传说中的宝藏，我们就可以按时向海怪献上财宝，不用再苦苦寻找忘恩负义的商人，打劫商船凑钱！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450131
					],
					"speakerTitle": "威尔船长"
				},
				{
					"id": 790450131,
					"content": "拿出最强的气势来，水手们！为了让我们的镇子平平安安，让乡亲们再也不用受苦受难，我们要全速前进！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450132
					],
					"speakerTitle": "威尔船长"
				},
				{
					"id": 790450132,
					"content": "财宝！财宝！全速前进！平平安安！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450133
					],
					"speakerTitle": "众水手"
				},
				{
					"id": 790450133,
					"content": "迎接了善战的新人后，「黑水晶」号做好了起锚出航的准备，即将向着藏宝地进发。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450134
					],
					"speakerTitle": "来自喇叭的旁白"
				},
				{
					"id": 790450134,
					"content": "哦哦，很快就交待了重要的设定？这些海盗寻找财宝的目的很不一般…接下要发生的事，我倒是有点兴趣了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790450135,
					"content": "按照喇叭的说法，只要坐上了「呼呼飞车」，就能推进话剧的进度…这个节奏倒还不错！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450136
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790450136,
					"content": "#我们现在就出发吧，{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790450121,
					"content": "派蒙和我，堂堂开演！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790450122
					]
				},
				{
					"id": 790450116,
					"content": "不然代入感应该还不错。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790450117
					]
				}
			]
		},
		{
			"id": 7904508,
			"completionStepIds": [
				7904508
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7904508",
							"2"
						],
						"stepId": 7904508,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790450801,
					"content": "可喜可贺，可喜可贺！在两位新人水手的帮助下，威尔船长的老仇家落荒而逃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450802
					],
					"speakerTitle": "来自喇叭的旁白"
				},
				{
					"id": 790450802,
					"content": "所有的困难险阻都已被突破，再也没有什么可以阻挡「黑水晶」号的众人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450803
					],
					"speakerTitle": "来自喇叭的旁白"
				},
				{
					"id": 790450803,
					"content": "不愧是我的好弟兄，被那些家伙伏击，也临危不乱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450804
					],
					"speakerTitle": "威尔船长"
				},
				{
					"id": 790450804,
					"content": "当然，我们的新人也立下了大功！新人们一直在前方拔掉硬茬，才让我们顺顺利利地抵达终点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450805
					],
					"speakerTitle": "威尔船长"
				},
				{
					"id": 790450805,
					"content": "#那还用说！这样的坏海盗，再来两三船都不够我和{NICKNAME}打！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450806,
						790450807
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790450806,
					"content": "派蒙也入戏了嘛？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790450808
					]
				},
				{
					"id": 790450808,
					"content": "还，还行吧！毕竟这一路还挺惊险的，我们也算是和威尔船长他们共渡难关了，当然要认真一点！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450809
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790450809,
					"content": "根据调查，打碎那堵石墙，就能找到传说中的宝藏了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450810
					],
					"speakerTitle": "威尔船长"
				},
				{
					"id": 790450810,
					"content": "最关键的时候到了，这最重要的一步，就由我们的大功臣——两位新人来完成吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450811
					],
					"speakerTitle": "威尔船长"
				},
				{
					"id": 790450811,
					"content": "在这之后，我还有一个新的想法，要和大家谈一谈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450812
					],
					"speakerTitle": "威尔船长"
				},
				{
					"id": 790450812,
					"content": "#你看，{NICKNAME}！威尔船长越来越重视我们了，把这关键的一步都交给了我们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450813,
						790450814
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790450813,
					"content": "我们一起发射重炮！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790450815
					]
				},
				{
					"id": 790450815,
					"content": "庆祝的时刻到了！动手吧，新人们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大副"
				},
				{
					"id": 790450814,
					"content": "我们一起打开宝藏！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790450815
					]
				},
				{
					"id": 790450807,
					"content": "说明体验还不错？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790450808
					]
				}
			]
		},
		{
			"id": 7904510,
			"completionStepIds": [
				7904510,
				7904511
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7904511",
							"2"
						],
						"stepId": 7904511,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790451001,
					"content": "成功啦！找到传说中的宝藏了！真的满眼都是摩拉，可以在里面游泳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451002
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790451002,
					"content": "可是，怎么感觉这些摩拉和平常见到的有点不一样？该不会…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451003
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790451003,
					"content": "这是怎么回事？传说中的「摩拉浴池」中，居然都是一些装饰性的假金币？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451004
					],
					"speakerTitle": "来自喇叭的旁白"
				},
				{
					"id": 790451004,
					"content": "面对突如其来的意外，「黑水晶」号的众人会作何反应呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451005
					],
					"speakerTitle": "来自喇叭的旁白"
				},
				{
					"id": 790451005,
					"content": "船长！这和情报里说的不一样啊？传说中的宝藏，怎么全都是…假币？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451006
					],
					"speakerTitle": "大副"
				},
				{
					"id": 790451006,
					"content": "唉…不祥的预感应验了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451007
					],
					"speakerTitle": "威尔船长"
				},
				{
					"id": 790451007,
					"content": "传说中的宝藏可能是个幌子——某些别有用心的人将它当成了诱饵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451008
					],
					"speakerTitle": "威尔船长"
				},
				{
					"id": 790451008,
					"content": "幕后黑手的目标，是突破重重困难，前来寻找宝藏的人…这些人所携带的精锐武器，性能绝佳的船舶，全都价值不菲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451009
					],
					"speakerTitle": "威尔船长"
				},
				{
					"id": 790451009,
					"content": "俘获了这些筋疲力尽的战士后，幕后黑手也能将他们当成苦力贩卖。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451010
					],
					"speakerTitle": "威尔船长"
				},
				{
					"id": 790451010,
					"content": "可恶啊…所有人都被骗了！怎么会有这种骗局！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451011,
						790451012
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790451011,
					"content": "出于成本角度，可以理解。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790451013
					]
				},
				{
					"id": 790451013,
					"content": "呃，也对哦，你这么一说我差点都忘了，我们还在参演话剧呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451014
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790451014,
					"content": "虽然没有其他演员，布景也有点遗憾啦，但可以感觉到，幕后的工作人员还是非常努力的，我们也应该认真一点！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451015
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790451015,
					"content": "让我们听听「黑水晶」号的大家都有什么想法吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451016
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790451016,
					"content": "在虚假的宝藏前，威尔船长召集了沮丧的船员们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451017
					],
					"speakerTitle": "来自喇叭的旁白"
				},
				{
					"id": 790451017,
					"content": "船长，难道说，你的仇家就在干这种勾当…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451018
					],
					"speakerTitle": "大副"
				},
				{
					"id": 790451018,
					"content": "不，他们应该没有那种本事，要是我们不来，失望的就是他们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451019
					],
					"speakerTitle": "威尔船长"
				},
				{
					"id": 790451019,
					"content": "或许…幕后黑手正在赶来的路上。以我们目前的状态，迎击他们可不是个明智的选择。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451020
					],
					"speakerTitle": "威尔船长"
				},
				{
					"id": 790451020,
					"content": "打扫一下战场，看看有没有其他宝箱，然后准备撤离吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451021
					],
					"speakerTitle": "威尔船长"
				},
				{
					"id": 790451021,
					"content": "我们一向论功行赏，眼前的那个宝箱就是新人们的战利品了，哪怕空手而归，其他船员也不能和他们争抢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451022
					],
					"speakerTitle": "威尔船长"
				},
				{
					"id": 790451022,
					"content": "可恶，这样算下来，我们这次出海根本就没赚到一分钱，反而赔了不少…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451023
					],
					"speakerTitle": "众水手"
				},
				{
					"id": 790451023,
					"content": "怎么办，难道我们又要继续打劫那些不良商人，东拼西凑筹钱去给海怪了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451024
					],
					"speakerTitle": "众水手"
				},
				{
					"id": 790451024,
					"content": "我正想强调，这次出海，我们「黑水晶」号绝不是空手而归，我们其实找到了比摩拉更珍贵的宝藏——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451025
					],
					"speakerTitle": "威尔船长"
				},
				{
					"id": 790451025,
					"content": "穿越凶险海域的技巧，击败强大敌人的战法，还有克服困难的勇气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451026
					],
					"speakerTitle": "威尔船长"
				},
				{
					"id": 790451026,
					"content": "你们仔细想一想，就算我们真的拿到了宝藏，获得了不计其数的摩拉，难道就能从海怪那里换取镇子的和平了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451027
					],
					"speakerTitle": "威尔船长"
				},
				{
					"id": 790451027,
					"content": "…说来也是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451028
					],
					"speakerTitle": "众水手"
				},
				{
					"id": 790451028,
					"content": "凭海怪贪婪的性格，它大概会变本加厉，要求我们献上更多财物吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451029
					],
					"speakerTitle": "众水手"
				},
				{
					"id": 790451029,
					"content": "听说最富裕的几个小镇上缴的财物是我们的好几十倍，也没有让海怪满足。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451030,
						790451031
					],
					"speakerTitle": "众水手"
				},
				{
					"id": 790451030,
					"content": "问题就在于答应海怪…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790451032
					]
				},
				{
					"id": 790451032,
					"content": "你说的对哦，换成我们的话，肯定不会看着那个海怪肆意妄为。但威尔船长他们都是普通人，他们有那个胆量吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451033
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790451033,
					"content": "所以，我们需要解决最根源的问题，那就是上缴财物这件不合理的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451034
					],
					"speakerTitle": "威尔船长"
				},
				{
					"id": 790451034,
					"content": "经过这段时间的战斗，我可以肯定，我们有潜力解决海怪，干掉那个作威作福的家伙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451035
					],
					"speakerTitle": "威尔船长"
				},
				{
					"id": 790451035,
					"content": "弟兄们，你们相信我吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451036
					],
					"speakerTitle": "威尔船长"
				},
				{
					"id": 790451036,
					"content": "虽然有不少风险，但的确值得一试。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451037
					],
					"speakerTitle": "大副"
				},
				{
					"id": 790451037,
					"content": "除了这条路，我们好像没得选了。一直退缩的话，总有一天会没有退路…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451038
					],
					"speakerTitle": "众水手"
				},
				{
					"id": 790451038,
					"content": "听了船长的话，我越想越窝火，就算和海怪拼了，也不能再忍了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451039
					],
					"speakerTitle": "众水手"
				},
				{
					"id": 790451039,
					"content": "那么，接下来，我会带领着「黑水晶」号将这件事作为目标，好好锻炼一番。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451040
					],
					"speakerTitle": "威尔船长"
				},
				{
					"id": 790451040,
					"content": "尤其是现在，我们有了强而有力的新人，这些新人可以说是战无不胜的好手！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451041
					],
					"speakerTitle": "威尔船长"
				},
				{
					"id": 790451041,
					"content": "新人们，虽然现在我威尔没有什么钱财，但如果你们能献出自己的力量，「黑水晶」号的所有人必将倾尽全力报答你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451042
					],
					"speakerTitle": "威尔船长"
				},
				{
					"id": 790451042,
					"content": "你们愿意与「黑水晶」号同行，好好锻炼一番，然后惩治那头贪婪的海怪吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451043
					],
					"speakerTitle": "威尔船长"
				},
				{
					"id": 790451043,
					"content": "这样的态度才对嘛，鼓足勇气，反抗最初的坏蛋海怪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451044
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790451044,
					"content": "#{NICKNAME}，我们可要帮帮「黑水晶」号的大家！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451045,
						790451046
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790451045,
					"content": "乐意至极！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790451047
					]
				},
				{
					"id": 790451047,
					"content": "太棒了！新人们，以后你们就是「黑水晶」号的核心成员，我威尔船长、弟兄和乡亲们的好帮手和大恩人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451048
					],
					"speakerTitle": "威尔船长"
				},
				{
					"id": 790451048,
					"content": "接下来，「黑水晶」号要返回驻地，稍作休整，养精蓄锐，然后全力出战，给海怪狠狠一击！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451049
					],
					"speakerTitle": "威尔船长"
				},
				{
					"id": 790451049,
					"content": "来自喇叭的旁白开始进行终幕的总结——\\n\\n经历重重险阻，善战的新人们成为了「黑水晶」号的中流砥柱。\\n在威尔船长的带领下，「黑水晶」号开始筹备一场关键的反击…\\n敬请期待「黑水晶号与吞金海怪」的第二幕，「新人水手的反击号角」！",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						790451050
					]
				},
				{
					"id": 790451050,
					"content": "随着旁白结束，洞窟内的机关停止了运转，一切归于静寂…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						790451051
					]
				},
				{
					"id": 790451051,
					"content": "啊，居然就在这里结束了吗！我还才刚来劲呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451052,
						790451053
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790451052,
					"content": "说不定海怪的模型还没做完。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790451054
					]
				},
				{
					"id": 790451054,
					"content": "也对哦，如果这段话剧再长一点，一般的观众可能就很累了，去打海怪的时候根本拿不出力气…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451055
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790451055,
					"content": "之前的场景搭建的并不是很完善，不过战胜海怪这种激动人心的故事可马虎不得，还是需要好好准备的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451056
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790451056,
					"content": "感觉「黛依阿的三日遐想」的潜力还不错嘛！我开始好奇了，黛依阿是个什么样的创作者呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790451053,
					"content": "在这里「断章」也算节奏平稳了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790451054
					]
				},
				{
					"id": 790451046,
					"content": "揍翻海怪！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790451047
					]
				},
				{
					"id": 790451031,
					"content": "原本就不是最佳答案…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790451032
					]
				},
