			"dialogs": [
				{
					"id": 756750101,
					"content": "嘿！哈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750102
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 756750102,
					"content": "我的脑袋已经被音乐占满了，跳舞跳舞！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750103
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 756750103,
					"content": "摇摆摇摆~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750104
					],
					"speakerTitle": "瑟琪"
				},
				{
					"id": 756750104,
					"content": "快快乐乐——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750105
					],
					"speakerTitle": "梅内娅"
				},
				{
					"id": 756750105,
					"content": "呜啊呜啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750106
					],
					"speakerTitle": "莫乌"
				},
				{
					"id": 756750106,
					"content": "还赚了外快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750107
					],
					"speakerTitle": "玛因"
				},
				{
					"id": 756750107,
					"content": "咦？你这小妞，什么时候的事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750108
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 756750108,
					"content": "努斯妲小姐忙不过来，我就抽空去支援了她的学徒，清剿了几个魔物的巢穴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750109
					],
					"speakerTitle": "玛因"
				},
				{
					"id": 756750109,
					"content": "在纳塔，战斗和跳舞一样尽兴，喜欢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750110
					],
					"speakerTitle": "玛因"
				},
				{
					"id": 756750110,
					"content": "真是麻烦你了，玛因。我的本意是让新人们多多锻炼，没想到他们还是不能独立完成那一组任务。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750111
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 756750111,
					"content": "等我回去后，给他们狠狠加练！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750112
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 756750112,
					"content": "不麻烦，他们也打得很漂亮。只不过之前没想到，巢穴里有预估七倍的魔物罢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750113
					],
					"speakerTitle": "玛因"
				},
				{
					"id": 756750113,
					"content": "「花羽会」给的好多，我为爱贝尔买礼物的钱都凑够了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750114
					],
					"speakerTitle": "玛因"
				},
				{
					"id": 756750114,
					"content": "但你的假期时间好像也差不多了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750115
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 756750115,
					"content": "再玩几天，就可以预订船票琢磨返程的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750116
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 756750116,
					"content": "不急，还可以跳舞。小萝克珊、勒泰利埃，谢妮和弗雷瑞斯最近在争着任务做，我可不能和他们抢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750117
					],
					"speakerTitle": "玛因"
				},
				{
					"id": 756750117,
					"content": "那就继续跳舞，继续开心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750118
					],
					"speakerTitle": "瑟琪"
				},
				{
					"id": 756750118,
					"content": "跳累就吃，吃饱就睡，无忧无虑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750119
					],
					"speakerTitle": "梅内娅"
				},
				{
					"id": 756750119,
					"content": "咿啊——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750120
					],
					"speakerTitle": "莫乌"
				},
				{
					"id": 756750120,
					"content": "美露莘们和小鳍游龙排成一列，向着舞台蹦蹦跳跳过去了。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						756750121
					]
				},
				{
					"id": 756750121,
					"content": "真是一群可爱的客人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750122
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 756750122,
					"content": "嘿嘿，你也很享受嘛，努斯妲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750123,
						756750124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756750123,
					"content": "笑容更轻松畅快了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756750125
					]
				},
				{
					"id": 756750125,
					"content": "当真？那以后，每次「舞力聚会」，我都非来不可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750126
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 756750126,
					"content": "要让那些见面就喊我大姐，甚至是阿姨的后辈…有一天发现，我的精神面貌比他们都年轻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750127
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 756750127,
					"content": "以后的「舞力聚会」应该以这次为典范，办得越频繁越好！成为每个月都有的惯例，都在情理之中！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 756750124,
					"content": "好像整个人都年轻了不少。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756750125
					]
				}
			]
		}
	]
}