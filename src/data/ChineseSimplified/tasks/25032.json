	"talks": [
		{
			"id": 2503201,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2503201",
							"2"
						],
						"stepId": 2503201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"子澄"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250320101,
					"content": "唔。以画引诗…不对不对，应该是以诗入画…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320102
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320102,
					"content": "呃…好像也不对，这两句话好像是一个意思…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320103,
						250320104
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320103,
					"content": "你在说什么呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320105
					]
				},
				{
					"id": 250320105,
					"content": "您好啊。没错，我正在试着以纳塔的风光为主题写诗呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320106
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320106,
					"content": "但是…说实话，这里的风景和璃月大不相同，我也不了解纳塔的历史故事，完全没法下手写啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320107
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320107,
					"content": "而且我不是专业的诗人，韵也用得不好，打油诗也没法作…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320108
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320108,
					"content": "唉，但这么出来一趟，总不能空着手回去吧。那总务司的同事肯定要说我「采风采风，采了个空」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320109
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320109,
					"content": "你在总务司工作？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320110
					]
				},
				{
					"id": 250320110,
					"content": "算是吧。我前段时间刚被总务司雇去丈量土地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320111
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320111,
					"content": "嗨，其实就是带着人在璃月到处转，看看各处的水土是否有变化，是否需要修正地图。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320112
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320112,
					"content": "转完一趟，真是累个半死，鞋子也不知道磨破了多少双…所以我就请了个假，出来散散心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320113
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320113,
					"content": "就是…不知道我当时脑子里到底在想什么。在请假单上写「偶有诗兴，欲出采风」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320114
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320114,
					"content": "没想到，总务司负责批假的人居然认真地回复我，说什么「祝诗运亨通」…然后给我批了半个月的假…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320115,
						250320117
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320115,
					"content": "这不是挺好的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320116
					]
				},
				{
					"id": 250320116,
					"content": "好？好就好在，我的假条…整个总务司都知道了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320119
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320119,
					"content": "唉，虽然纳塔确实挺好玩的。风景不错，吃的也不错，还有各种有趣的生物，特别是那些龙宝宝也很可爱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320120
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320120,
					"content": "但是，我到现在也没写出来一句诗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320121
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320121,
					"content": "亏我还特意借了一台留影机来取材，结果根本用不好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320122
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320122,
					"content": "拍一些自然风光倒是还过得去，但只要一拍店铺或者人群，拍出来的画片就压根没法看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320123,
						250320124
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320123,
					"content": "那个，我帮帮你？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320125
					]
				},
				{
					"id": 250320125,
					"content": "真的？！谢天谢地，总算有人能帮我了…无论如何，我都得先搜集好写诗的素材啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320126
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320126,
					"content": "我想想啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320124,
					"content": "我最擅长拍画片了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320125
					]
				},
				{
					"id": 250320117,
					"content": "那你的诗运亨通了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320118
					]
				},
				{
					"id": 250320118,
					"content": "没有。但是…我的假条非常的「亨通」。整个总务司都知道我要去纳塔采风写诗了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320119
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320104,
					"content": "你在写诗吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320105
					]
				}
			]
		},
		{
			"id": 2503206,
