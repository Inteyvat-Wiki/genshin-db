			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"子澄"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250321001,
					"content": "对了！我听人家说，「流泉之众」那边的店铺招牌很特色，其中一家好像名为「金贝乐棚」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250321002
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250321002,
					"content": "拜托你，帮我去拍摄一下清晨的「金贝乐棚」吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "子澄"
