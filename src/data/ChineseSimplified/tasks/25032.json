			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"子澄"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250320601,
					"content": "你回来了，画片拍好了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320602
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320602,
					"content": "拍好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320603
					]
				},
				{
					"id": 250320603,
					"content": "嚯…你拍得可真好，比我的那个助手拍得好多了。他每次给勘测地点拍画片留证的时候，都要拍好几次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320604
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320604,
					"content": "要是你能和我一起去丈量土地，我肯定能少用坏几台留影机。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320605
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320605,
					"content": "这些画片真能用来写诗吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320606
					]
				},
				{
					"id": 250320606,
					"content": "应该…能吧。哎呀，如果我实在写不出来，就把这些画片当成明信片。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320607
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320607,
					"content": "在它们背面写上一些祝福的话，然后寄回总务司。那群家伙收到礼物之后，肯定也没什么话好说了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320608
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320608,
					"content": "咳…但是，这是没办法的办法。在那之前，我还是先想想怎么写一首好诗吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320609
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320609,
					"content": "激荡…不对，鼓荡五部风云…哎哟，等等，纳塔总共有几个部族来着？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "子澄"
				}
			]
		},
