			"dialogs": [
				{
					"id": 80070101,
					"content": "本以为会在一瞬间灰飞烟灭…哈夫丹的灵魂竟然如此强韧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
