				},
				{
					"id": 80070104,
					"content": "…戴因斯雷布！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070105
					],
					"speakerTitle": "深渊司铎"
				},
				{
					"id": 80070105,
					"content": "干掉他，关闭那个装置！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "戴因斯雷布"
