				},
				{
					"id": 80070902,
					"content": "烧灼感消失了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070903
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80070903,
					"content": "我们成功阻止了深渊的计划吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070904,
						80070905
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80070904,
					"content": "只是哈夫丹…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80070906
					]
				},
				{
					"id": 80070906,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070907
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80070907,
					"content": "我再确认一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070908
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80070908,
					"content": "戴因他…其实很难过吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070909
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80070909,
					"content": "昔日的战友，以这样的形式再会…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070910
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80070910,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070911
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80070911,
					"content": "…走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80070905,
					"content": "他似乎没有生命的气息了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
