			},
			"dialogs": [
				{
					"id": 80070301,
					"content": "怎么办，把那个深渊司铎解决了，装置却还是没有停下来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80070302,
					"content": "哈夫丹他…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070303,
						80070304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80070303,
					"content": "让我来代替他吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80070305
					]
				},
				{
					"id": 80070305,
					"content": "不行！只要装置还保持启动状态，我们这些受过诅咒的人就无法发挥出原本实力，只有你才是深渊的对手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070306
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80070306,
					"content": "如果你珍惜他的献身，就别在这里浪费时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070307
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80070307,
					"content": "看到周围那些光线和传送门了吗？他们一定把能源装置分散安置在别处了，过去确认情况，要快！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070308
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80070308,
					"content": "是要穿过那些深渊的传送门吗…喂等等我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80070304,
					"content": "我不会受到诅咒净化效果的影响。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80070305
					]
				}
			]
		},
