			"dialogs": [
				{
					"id": 80071001,
					"content": "刚才那是…哈夫丹的灵魂…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071002
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80071002,
					"content": "这里汇聚着不止一种诡异力量。就算见到魂魄也不奇怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071003
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80071003,
					"content": "不过，如果你们想继续前往深处探索，就要小心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071004
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80071004,
					"content": "咳咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071005
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80071005,
					"content": "嗯，我们会小心的。欸对了，戴因难道不跟我们一起走吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071006
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80071006,
					"content": "刚才那台装置同样给我造成了不小的创伤，我需要一点时间来恢复。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071007
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80071007,
					"content": "原来如此…不对，我其实早就看出来了，你一直是在硬撑而已！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071008
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80071008,
					"content": "也该休息了，戴因…比如说，给自己放个假什么的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071009
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80071009,
					"content": "放假？这不是该出现在我身上的词语。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071010
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80071010,
					"content": "我还有重要的事。「命运的织机」计划还在进行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071011
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80071011,
					"content": "我甚至怀疑，这里的增幅装置也跟那个计划有关。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071012,
						80071013
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80071012,
					"content": "我也会留意。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80071014
					]
				},
				{
					"id": 80071014,
					"content": "感谢你的体谅，「雇主」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071015
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80071015,
					"content": "只希望下次见面时，你不会站在「那边」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071016
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80071016,
					"content": "喂，戴因他是不是有点记仇呀，最后才那么说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071017
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80071017,
					"content": "#虽然还是没能再一次见到你的{PLAYERAVATAR#SEXPRO[INFO_FEMALE_PRONOUN_SISTER|INFO_MALE_PRONOUN_BROTHER]}，但也算是了解了很多有用的信息吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071018
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80071018,
					"content": "只要继续旅行，你们总会相遇，然后和好如初的，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071019
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80071019,
					"content": "哦对了，还记得我们一开始是为了调查丘丘人们的诡异行踪才过来的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071020
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80071020,
					"content": "这下应该可以找那位矿工大哥报告了吧，只是…好像有点不知道怎么说，这里发生的事对普通人来说有些太过复杂了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071021
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80071021,
					"content": "总之，别把那份委托给忘了就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80071013,
					"content": "等你恢复了，我会再和你好好聊聊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80071014
					]
				}
			]
		},
