			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790330301,
					"content": "哦，看上去像是两个人躺在地上呢…是在看天上的星星？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790330302,
					"content": "总觉得是有点奇怪的影像呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790330303,
					"content": "雅科夫，长官说了你些什么，你这么垂头丧气的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790330304,
					"content": "因为海浪颠簸，搬运仪器的时候摔了一跤，幸好我手快，仪器没事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790330305,
					"content": "但是长官还是训话说，要让我们小队去各个岛上做装置的信号接收测试，那可是最辛苦的任务…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790330306,
					"content": "没关系，不必这么伤心，咱们什么累活没干过啊。别伤心啦，先吃点东西吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790330307,
					"content": "他们指着那么高的地方，是想要吃什么啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790330308,
					"content": "难道这个海螺…放歪了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}