			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790330101,
					"content": "唔，影像居然正好放在舞台的中间…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790330102,
					"content": "这两个人在干嘛呢…看上去就像是一个人在说什么，另一个人坐在地上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790330103,
					"content": "我知道了，这个一定是在讲故事的画面！他们一定是快要睡觉了，所以影像里她正在为坐在地上的人讲睡前故事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790330104,
					"content": "愚人众也要听睡前故事吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790330105
					]
				},
				{
					"id": 790330105,
					"content": "说不定愚人众里也有人有这种需要的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790330106,
					"content": "阿加霞，佩尔西科夫大人让我们去做信号接收测试，是让我们四个一起去…叶夫卡要是听到这件事，又得生气不可…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790330107,
					"content": "雅科夫，不会的，这是上面大人的命令，叶夫卡肯定也不会责怪你的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790330108,
					"content": "唉，你要是真这么害怕，我陪你去跟叶夫卡说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790330109,
					"content": "什么嘛，原来不是在讲故事呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790330110,
					"content": "不过这段对话没头没尾的，根本什么都看不出来嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7903302,
			"completionStepIds": [
				7903307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
