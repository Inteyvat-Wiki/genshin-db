			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790330201,
					"content": "海螺居然能够从井中浮起来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330202,
						790330203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790330202,
					"content": "毕竟是被幻境影响的海螺…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790330204
					]
				},
				{
					"id": 790330204,
					"content": "#嗯，真是奇妙…啊，影像显示出来了，{NICKNAME}，你快看，那里有个弯腰的…哇！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790330205,
					"content": "#{NICKNAME}，你不要动，你的身后…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330206,
						790330207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790330206,
					"content": "是、是什么可怕的东西吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790330208
					]
				},
				{
					"id": 790330208,
					"content": "啊，仔细一看只是海螺产生的影像，突然出现在背后，真是吓了人一大跳呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790330209,
					"content": "信号测试器…两组…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790330210,
					"content": "唉，我还以为他被单独叫出去是要受什么严重的惩罚，结果只是布置了比较麻烦的任务，真是松了口气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790330211,
					"content": "他可害怕被你骂了，哈哈，看上去就像是害怕被「哥哥」骂的「弟弟」一样…你说，他是不是，其实怕的是我们对他失望…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790330212,
					"content": "明明大家只是小队成员而已…但有的时候，感觉就跟「家人」一样啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790330213,
					"content": "家人吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790330214,
					"content": "嗯…总有种偷听到了不该偷听到的话的感觉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790330215,
					"content": "影像里这几个人好像不是…「那么坏」的愚人众嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790330207,
					"content": "不许故意吓人哦！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790330208
					]
				},
				{
					"id": 790330203,
					"content": "大概壳中有空气…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790330204
					]
				}
			]
		},
		{
			"id": 7903303,
			"completionStepIds": [
				7903305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
