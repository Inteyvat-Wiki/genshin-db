					}
				]
			},
			"dialogs": [
				{
					"id": 750170701,
					"content": "七重燃{RUBY#[D]奇琴乌图}火之地的至高领主向你致以敬意，获选者，愿你的道途铺满永不凋谢的鲜花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170702
					],
					"speakerTitle": "伊蕾尔"
				},
				{
					"id": 750170702,
					"content": "声音好像是…从这个大雕像里传出来的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170703,
						750170704
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750170703,
					"content": "你是？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750170706
					]
				},
				{
					"id": 750170706,
					"content": "我名为圣龙伊·奎库叙·茨{RUBY#[D]L型自律监管机阵统合处理单元}博隆·库·雷尔，曾是统律奇琴乌图的主宰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170707
					],
					"speakerTitle": "伊蕾尔"
				},
				{
					"id": 750170707,
					"content": "伊…伊什么？呜哇，这名字也太过分啦！简直就像是莫名其妙的咒语一样！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170708
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750170708,
					"content": "算了，就叫你「伊蕾尔」吧，反正剩下的部分我也已经完全记不住了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170709
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750170709,
					"content": "依循命{RUBY#[D]库胡勒}定的神圣道途，汝等…不对，等一下！你这又白又圆的元素飘浮物，刚才叫我什么？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170710
					],
					"speakerTitle": "伊蕾尔"
				},
				{
					"id": 750170710,
					"content": "#谁是「又白又圆的元素飘浮物」啦！我是派蒙，{M#他}{F#她}是{NICKNAME}，然后…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170711
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750170711,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170712
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750170712,
					"content": "#这是{REALNAME[ID(2)|SHOWHOST(true)]}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750170713
					]
				},
				{
					"id": 750170713,
					"content": "还有，明明是你自己说的嘛！「我名为伊什么什么蕾尔」之类的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170714
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750170714,
					"content": "何、何等不敬！这神圣的名讳乃是出自尊荣的主宰，你这又白又圆的元素飘浮物，怎敢用你的舌头吐出如此僭越之言！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170715
					],
					"speakerTitle": "伊蕾尔"
				},
				{
					"id": 750170715,
					"content": "#高贵的{NICKNAME}啊！请恕我直言，您似乎有些过于放纵自己的侍仆了——它竟敢用这种语气称呼一位至高领主！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170716,
						750170719
					],
					"speakerTitle": "伊蕾尔"
				},
				{
					"id": 750170716,
					"content": "派蒙不是我的侍仆。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750170717
					]
				},
				{
					"id": 750170717,
					"content": "#哼，没错没错！{NICKNAME}和我可是最好的朋友！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170718
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750170718,
					"content": "您…和元素飘浮物是朋友？呃，真是…很有个性的选择呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170721
					],
					"speakerTitle": "伊蕾尔"
				},
				{
					"id": 750170721,
					"content": "#总之，请先容我向您道歉，高贵的{NICKNAME}。您一路来到这里，我却只能向您展现出这样的姿容，实在是…过于屈辱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170722
					],
					"speakerTitle": "伊蕾尔"
				},
				{
					"id": 750170722,
					"content": "若是我没有被困在这卑贱的雕像内，我本应向您呈现出更为优雅的仪态。无论是圣龙的形象，还是凡人的身姿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170723
					],
					"speakerTitle": "伊蕾尔"
				},
				{
					"id": 750170723,
					"content": "欸？被困在雕像里？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170724
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750170724,
					"content": "哼，不然呢？你难道以为我只是个会说话的雕像吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170725
					],
					"speakerTitle": "伊蕾尔"
				},
				{
					"id": 750170725,
					"content": "呃，这个…毕竟是这种地方，真的有「只是会说话的雕像」也不奇怪吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170726
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750170726,
					"content": "咕，何等不敬！我可是奇琴乌图的至高领主，尊荣的圣龙，你竟敢…你竟敢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170727
					],
					"speakerTitle": "伊蕾尔"
				},
				{
					"id": 750170727,
					"content": "若不是因为那可耻的背叛，我怎么可能会被困在这粗制滥造的雕像里！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170728
					],
					"speakerTitle": "伊蕾尔"
				},
				{
					"id": 750170728,
					"content": "#总、总之！高贵的{NICKNAME}呀，请允许我长话短说——我希望您帮我做一件事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170729,
						750170730
					],
					"speakerTitle": "伊蕾尔"
				},
				{
					"id": 750170729,
					"content": "什么事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750170732
					]
				},
				{
					"id": 750170732,
					"content": "我的心脏曾被背叛者撕碎，藏匿在了不同的机关中。我想要请求您，为我找回心脏的碎片。在那之后…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170733
					],
					"speakerTitle": "伊蕾尔"
				},
				{
					"id": 750170733,
					"content": "请您像剥开颗粒果的绿叶那般，剖开我的胸腔，挖出我的心脏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170734
					],
					"speakerTitle": "伊蕾尔"
				},
				{
					"id": 750170734,
					"content": "嗯…嗯？等等，你刚才是不是用特别轻松的语气说了什么特别可怕的事情？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170735
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750170735,
					"content": "可怕？是说颗粒果的事情吗？哼哼，还真是胆小的元素飘浮物呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170736
					],
					"speakerTitle": "伊蕾尔"
				},
				{
					"id": 750170736,
					"content": "什么乱七八糟的，谁会怕颗粒果啦！完全不知道你在得意些什么！我是说后面那个部分，「挖出心脏」什么的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170737
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750170737,
					"content": "#欸？这难道不是比颗粒果还常见的事情吗？高贵的{NICKNAME}，您祭祀的时候，难道从来都不带您的侍仆参加吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170738
					],
					"speakerTitle": "伊蕾尔"
				},
				{
					"id": 750170738,
					"content": "为什么要挖出你的心脏？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750170739
					]
				},
				{
					"id": 750170739,
					"content": "因为您是高贵之人，受龙所选者。除却那些早已不知所踪的、同为领{RUBY#[D]阿乔}主的同僚们，只有您有资格赐予我与身份相符的解脱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170740
					],
					"speakerTitle": "伊蕾尔"
				},
				{
					"id": 750170740,
					"content": "#如果您熟稔古老的道途，高贵的{NICKNAME}，您应该知道，在那受造于悠古之刻的心{RUBY#[D]集群存储阵列}脏中，有着曾经属于我的一切回忆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170741
					],
					"speakerTitle": "伊蕾尔"
				},
				{
					"id": 750170741,
					"content": "背叛者——愿他的名字被投入永不熄灭的火中，焚烧十三个千年——夺去了我的权柄，又用回忆将我束缚在这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170742
					],
					"speakerTitle": "伊蕾尔"
				},
				{
					"id": 750170742,
					"content": "呃，回忆也能束缚人吗？不对，回忆也能束缚龙吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170743
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750170743,
					"content": "哼，真是无知到了有些可爱的地步呢，又白又圆的元素飘浮物。要是还没有失去权柄，说不定我都有些想养你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170744
					],
					"speakerTitle": "伊蕾尔"
				},
				{
					"id": 750170744,
					"content": "对于生命短暂的种族而言，回忆自然是如同青蜜莓一般甜美的佳妙之物。对于生命漫长的种族而言，回忆只会是诅咒与束缚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170745
					],
					"speakerTitle": "伊蕾尔"
				},
				{
					"id": 750170745,
					"content": "唔，好难懂…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170746
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750170746,
					"content": "总之，那可鄙的背叛者正是用这种方式，强迫我为他的帝国歌唱，为他的妄想歌唱——因为他并不懂得如何让这座城市运作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170747
					],
					"speakerTitle": "伊蕾尔"
				},
				{
					"id": 750170747,
					"content": "他可怜的帝国与他那可笑的妄想一样化作了灰烬，而我却依然被困在这卑贱的雕像中，千年又千年。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170748
					],
					"speakerTitle": "伊蕾尔"
				},
				{
					"id": 750170748,
					"content": "呃，就算你这么说，让我们先找回你的心脏，再把它挖出来，还是感觉有些莫名其妙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170749
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750170749,
					"content": "呵…还是没听懂吗，又白又圆的元素飘浮物？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170750
					],
					"speakerTitle": "伊蕾尔"
				},
				{
					"id": 750170750,
					"content": "我的生命已经所剩无几了。即便不这样做，我的意识也会在接下来的三十个冬天内彻底耗尽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170751
					],
					"speakerTitle": "伊蕾尔"
				},
				{
					"id": 750170751,
					"content": "#我的尊严不容许我在奴役与拘束中死去。因此，高贵的{NICKNAME}呀，我才会请求您赐予我解脱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170752
					],
					"speakerTitle": "伊蕾尔"
				},
				{
					"id": 750170752,
					"content": "我无法自毁。但若是您能寻回那些碎片，我便能将残存的生{RUBY#[D]能量}命全部注入其中，将原本破碎的心脏修复如初。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170753
					],
					"speakerTitle": "伊蕾尔"
				},
				{
					"id": 750170753,
					"content": "这是<color=#00E1FFFF>自我保护</color>的一环，只有这样，才不会触犯命{RUBY#[D]库胡勒}定的神圣律则。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170754
					],
					"speakerTitle": "伊蕾尔"
				},
				{
					"id": 750170754,
					"content": "在那之后，请您将我的心挖出来吧。就是这颗心束缚了我，就是这颗心奴役了我，就是这颗心，数千年间无时无刻不在折磨着我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170755
					],
					"speakerTitle": "伊蕾尔"
				},
				{
					"id": 750170755,
					"content": "这是真正圣龙的心脏。人类的所有宝石都无法与它相提并论。这便是我能赠予您的报酬——您意下如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170756,
						750170759
					],
					"speakerTitle": "伊蕾尔"
				},
				{
					"id": 750170756,
					"content": "我明白了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750170757
					]
				},
				{
					"id": 750170757,
					"content": "谢谢您。那么，就让我在这里歌唱，等待您的好消息吧。除此之外，我现在也没有什么能做到的事情了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170758
					],
					"speakerTitle": "伊蕾尔"
				},
				{
					"id": 750170758,
					"content": "还请您…找回我的心，赐予我高贵的解脱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊蕾尔"
				},
				{
					"id": 750170759,
					"content": "没有别的办法了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750170760
					]
				},
				{
					"id": 750170760,
					"content": "呵呵…看来您从未遇到过我旧日的同僚们呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170761
					],
					"speakerTitle": "伊蕾尔"
				},
				{
					"id": 750170761,
					"content": "否则，他们应该告诉过您，毁灭便是我们命{RUBY#[D]库胡勒}定的道途。没有另寻道路的必要，也没有另寻道路的可能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170762
					],
					"speakerTitle": "伊蕾尔"
				},
				{
					"id": 750170762,
					"content": "无论如何，我会在这里歌唱，等待您的选择。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊蕾尔"
				},
				{
					"id": 750170730,
					"content": "报酬呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750170731
					]
				},
				{
					"id": 750170731,
					"content": "呵呵，请您不必担心。等您听我说完，自然就知晓报酬的价值了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170732
					],
					"speakerTitle": "伊蕾尔"
				},
				{
					"id": 750170719,
					"content": "说得没错，小派，今天我要说说你…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750170720
					]
				},
				{
					"id": 750170720,
					"content": "「小派」是谁啊！不要被吹捧两句就得意忘形啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170721
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750170704,
					"content": "获选者？是在说我吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750170705
					]
				},
				{
					"id": 750170705,
					"content": "是的。你是受龙所选之人，也是我所选择的高贵之人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170706
					],
					"speakerTitle": "伊蕾尔"
				}
			]
		},
