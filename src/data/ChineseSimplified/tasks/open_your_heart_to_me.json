					}
				]
			},
			"dialogs": [
				{
					"id": 750170901,
					"content": "喂，伊蕾尔！我们已经把你要的零件找齐啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170902
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750170902,
					"content": "谁、谁是伊蕾尔哇？！何等不敬！都说了，我的名字是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170903
					],
					"speakerTitle": "伊蕾尔"
				},
				{
					"id": 750170903,
					"content": "#算了，无所谓了！我已经等不及要去死了！高贵的{NICKNAME}，请您快些将我的心放入我的胸口…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170904
					],
					"speakerTitle": "伊蕾尔"
				},
				{
					"id": 750170904,
					"content": "然后，请您挖出我的心脏，让我死在您高贵的手中吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170905
					],
					"speakerTitle": "伊蕾尔"
				},
				{
					"id": 750170905,
					"content": "你也该高声欢呼，又白又圆的元素飘浮物！我也同样赋予你见证奇琴乌图之主死去的尊荣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170906
					],
					"speakerTitle": "伊蕾尔"
				},
				{
					"id": 750170906,
					"content": "呜哇，不要突然这么激动啦！总之，呃…先把这些零件放进去就好了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170907
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750170907,
					"content": "没错，没错！接下来，我会为您敞开心胸，您只需要将它取出来就好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170908
					],
					"speakerTitle": "伊蕾尔"
				},
				{
					"id": 750170908,
					"content": "不不不，这个词不是这么用的吧？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170909
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750170909,
					"content": "（放入零件。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750170910
					]
				},
				{
					"id": 750170910,
					"content": "唔，然后…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
