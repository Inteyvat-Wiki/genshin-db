					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750171602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750171602,
					"content": "（禁锢在雕像中的意志似乎已经散去了，回答你们的只有沉默。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊蕾尔"
				}
			]
		},
		{
			"id": 7501717,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
