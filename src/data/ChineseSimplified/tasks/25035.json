			"dialogs": [
				{
					"id": 250350801,
					"content": "两份…三份…齐了。太好了，那些丢失的快件都找回来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350802
					],
					"speakerTitle": "米齐卡"
				},
				{
					"id": 250350802,
					"content": "…等会，这份快件是不是归图达玛送来着？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350803
					],
					"speakerTitle": "米齐卡"
				},
				{
					"id": 250350803,
					"content": "这些报酬给你，谢谢你帮忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350804
					],
					"speakerTitle": "米齐卡"
				},
				{
					"id": 250350804,
					"content": "呼…我真是要找图达玛这小子好好聊一聊了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "米齐卡"
				}
