			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"米齐卡"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250350101,
					"content": "这群冒失鬼。怎么又丢失了好几份快件。都说了在送东西的时候不要玩那些花里胡哨的动作…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350102
					],
					"speakerTitle": "米齐卡"
				},
				{
					"id": 250350102,
					"content": "发生什么事了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250350103
					]
				},
				{
					"id": 250350103,
					"content": "有几个「讯使」又不听劝，把人家寄出去的快件弄丢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350104
					],
					"speakerTitle": "米齐卡"
				},
				{
					"id": 250350104,
					"content": "唉，他们都意识不到，这是在损坏我们「悬木人」的声誉吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350105
					],
					"speakerTitle": "米齐卡"
				},
				{
					"id": 250350105,
					"content": "送东西就好好送东西，遇见山坡就正常越过去，有什么必要半路突然开始玩滑行？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350106
					],
					"speakerTitle": "米齐卡"
				},
				{
					"id": 250350106,
					"content": "我说了好多次，但那群年轻人就是听不进去。成天就想着追求刺激…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350107
					],
					"speakerTitle": "米齐卡"
				},
				{
					"id": 250350107,
					"content": "唉，我还得托人去把那些快件找回来。谁有空呢？我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350108,
						250350111
					],
					"speakerTitle": "米齐卡"
				},
				{
					"id": 250350108,
					"content": "我可以帮忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250350109
					]
				},
				{
					"id": 250350109,
					"content": "你…愿意帮我？那就太好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350110
					],
					"speakerTitle": "米齐卡"
				},
				{
					"id": 250350110,
					"content": "我一时半会也找不到能帮忙的人，如果我自己去找，那「讯使长屋」就没人看店了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350117
					],
					"speakerTitle": "米齐卡"
				},
				{
					"id": 250350117,
					"content": "我也不会让你大海捞针的。我知道那群小子一般会从哪里走，也大概能猜到那些快件的丢失地点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350118
					],
					"speakerTitle": "米齐卡"
				},
				{
					"id": 250350118,
					"content": "我这就给你划出那些快件的丢失地点，就拜托你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "米齐卡"
				},
				{
					"id": 250350111,
					"content": "那些快件，很大吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250350112
					]
				},
				{
					"id": 250350112,
					"content": "不大。但就因为它们不大，每次找起来都很麻烦，唉，那群粗心的小子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350113
					],
					"speakerTitle": "米齐卡"
				},
				{
					"id": 250350113,
					"content": "…如果你有空的话。愿意帮我去找找那些快件吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350114
					],
					"speakerTitle": "米齐卡"
				},
				{
					"id": 250350114,
					"content": "现在「讯使长屋」里的人手也不够，如果我自己去找，那就没人看店了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350115
					],
					"speakerTitle": "米齐卡"
				},
				{
					"id": 250350115,
					"content": "没问题，我来帮忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250350116
					]
				},
				{
					"id": 250350116,
					"content": "那就太好了！真是多谢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350117
					],
					"speakerTitle": "米齐卡"
				}
			]
		},
