			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"莱依拉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 191530901,
					"content": "原来是这样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530902
					],
					"speakerTitle": "莱依拉"
				},
				{
					"id": 191530902,
					"content": "分析给我听听吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191530903
					]
				},
				{
					"id": 191530903,
					"content": "嗯，首先根据卡塔扬提供的信息，基本可以推断出仙灵的真实身份是梨多梵谛学院的学生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530904
					],
					"speakerTitle": "莱依拉"
				},
				{
					"id": 191530904,
					"content": "毕竟所有外来者的可能性已经被排除，也没办法绕过管理员拿走那两本书。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530905
					],
					"speakerTitle": "莱依拉"
				},
				{
					"id": 191530905,
					"content": "接下来，排除匪夷所思的超能力本身不提，所有目击地点皆为我们学院官方推荐的星相观测地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530906
					],
					"speakerTitle": "莱依拉"
				},
				{
					"id": 191530906,
					"content": "换句话说…它可能只是在做研究，而且研究内容与我很相似。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530907
					],
					"speakerTitle": "莱依拉"
				},
				{
					"id": 191530907,
					"content": "我向它提出的问题并不简单，但它可以在一天时间里给我答复，说明它掌握了相似的背景知识。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530908
					],
					"speakerTitle": "莱依拉"
				},
				{
					"id": 191530908,
					"content": "那么，只需要根据这个推测，去下一个星相观测地等待它就行了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530909,
						191530910
					],
					"speakerTitle": "莱依拉"
				},
				{
					"id": 191530909,
					"content": "思路很清楚嘛。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191530911
					]
				},
				{
					"id": 191530911,
					"content": "过、过奖啦…其实还有些别的理由，是一直以来的猜想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530912
					],
					"speakerTitle": "莱依拉"
				},
				{
					"id": 191530912,
					"content": "不过这不重要，我们先去吧，就算有了线索，能不能有结论还很难说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530913
					],
					"speakerTitle": "莱依拉"
				},
				{
					"id": 191530913,
					"content": "至于为什么我会这样想…如果它真的没有来的话，我就和你讲一讲吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莱依拉"
				},
				{
					"id": 191530910,
					"content": "有这样的推理能力，完成论文肯定没有问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191530911
					]
				}
			]
		}
	]
