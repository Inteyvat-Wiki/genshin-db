			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"温克尔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736840101,
					"content": "欸——各位冒险家们，有兴趣的请过来看看，协会正在开展新活动——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736840102
					],
					"speakerTitle": "温克尔"
				},
				{
					"id": 736840102,
					"content": "只要参与这个活动，不仅能拿到协会发放的奖励，还会有额外的礼品——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736840103,
						736840104
					],
					"speakerTitle": "温克尔"
				},
				{
					"id": 736840103,
					"content": "冒险家协会有活动？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736840105
					]
				},
				{
					"id": 736840105,
					"content": "你是…旅行者！幸会幸会，哎呀，没想到能遇见前辈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736840106
					],
					"speakerTitle": "温克尔"
				},
				{
					"id": 736840106,
					"content": "如您所见，我正在为协会里的一项活动招募参与人员呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736840107
					],
					"speakerTitle": "温克尔"
				},
				{
					"id": 736840107,
					"content": "这是我在协会里的第一项正式工作，我可得打起十二分的精神完成才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736840108
					],
					"speakerTitle": "温克尔"
				},
				{
					"id": 736840108,
					"content": "关于这次活动…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736840109
					]
				},
				{
					"id": 736840109,
					"content": "喔…哦！抱歉，前辈肯定还不知道这次活动的情况吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736840110
					],
					"speakerTitle": "温克尔"
				},
				{
					"id": 736840110,
					"content": "这次的活动被杰克前辈取名叫做「跨野寻踪」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736840111
					],
					"speakerTitle": "温克尔"
				},
				{
					"id": 736840111,
					"content": "用杰克前辈的话来说，是一场「既简单又有趣，同时还能检验冒险家自身实力」的活动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736840112
					],
					"speakerTitle": "温克尔"
				},
				{
					"id": 736840112,
					"content": "具体来说，我们会在各地布设一些「野踪气球」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736840113
					],
					"speakerTitle": "温克尔"
				},
				{
					"id": 736840113,
					"content": "参与的冒险家们需要做的，就是根据提示找到「野踪气球」，并且沿着这些气球的分布轨迹前进。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736840114
					],
					"speakerTitle": "温克尔"
				},
				{
					"id": 736840114,
					"content": "在限定时间内搜集到越多的「野踪气球」，就能获得越高的评价，奖励也会更加丰厚喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736840115,
						736840119
					],
					"speakerTitle": "温克尔"
				},
				{
					"id": 736840115,
					"content": "要是我把这些气球击破了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736840116
					]
				},
				{
					"id": 736840116,
					"content": "那些气球可都是特制的，能抵御住一般弓箭的射击，只能从近处击破。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736840117
					],
					"speakerTitle": "温克尔"
				},
				{
					"id": 736840117,
					"content": "毕竟之前举办这类活动的时候，冒险家们看见气球的第一反应就是举弓就射，说了很多次他们也不记得…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736840118
					],
					"speakerTitle": "温克尔"
				},
				{
					"id": 736840118,
					"content": "所以，这次协会使用了这种特制气球，希望会有用啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736840124
					],
					"speakerTitle": "温克尔"
				},
				{
					"id": 736840124,
					"content": "啊！我不能和您闲聊了，我还要接着去招募人员呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736840125
					],
					"speakerTitle": "温克尔"
				},
				{
					"id": 736840125,
					"content": "如果您有兴趣的话，也请来参与一下吧！如果您愿意加入这次活动，杰克前辈和塞琉斯会长一定也会很高兴的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "温克尔"
				},
				{
					"id": 736840119,
					"content": "感觉就是一场长跑啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736840120
					]
				},
				{
					"id": 736840120,
					"content": "唔…杰克前辈说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736840121
					],
					"speakerTitle": "温克尔"
				},
				{
					"id": 736840121,
					"content": "「寻找气球是检验冒险家们的『洞察力』，在各种环境中前进是检验冒险家们的『基本功』…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736840122
					],
					"speakerTitle": "温克尔"
				},
				{
					"id": 736840122,
					"content": "「而『按照提示行动』则是检验冒险家们的『纪律性』…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736840123
					],
					"speakerTitle": "温克尔"
				},
				{
					"id": 736840123,
					"content": "我刚进协会，对这方面的事不太懂啦…但杰克前辈既然这么说了，肯定有他的道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736840124
					],
					"speakerTitle": "温克尔"
				},
				{
					"id": 736840104,
					"content": "冒险家协会又在干什么…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736840105
					]
				}
			]
		}
	]
}