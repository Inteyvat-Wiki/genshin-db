				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"泽维尔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721540101,
					"content": "等等！士兵先生，您刚才念的词情绪不太对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540102
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721540102,
					"content": "「武士，如同席卷大地的清风。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540103
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721540103,
					"content": "你还记得我之前和你讲的戏吧，要有一种洒脱感，沧桑感，洒脱，洒脱明白吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540104
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721540104,
					"content": "这句话是整部戏的关键，您一定要完整地，饱满地，完美地把情绪表达出来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540105
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721540105,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540106
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721540106,
					"content": "而且挥剑的时候，不要那么快，一定要保证自己在镜头里面，不然「映影机」都要拍不到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540107
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721540107,
					"content": "先摆出架势，然后停顿，明白吗？停顿一下，然后猛地斩下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540108
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721540108,
					"content": "但与人对决的时候，可不能这么挥剑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540109
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721540109,
					"content": "这不是剧情和制作需要嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540110
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721540110,
					"content": "再准备准备，我们再来一次…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540111,
						721540112
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721540111,
					"content": "你们在干什么呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540114
					]
				},
				{
					"id": 721540114,
					"content": "#哎哟，是您呐！我亲爱的好{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYC|INFO_FEMALE_PRONOUN_GIRLC]}，准是一阵好风送您过来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540115
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721540115,
					"content": "如您所见，我正在和这位士兵先生拍摄一部「剑阵映影」，名字叫做《第七个武士》。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540116
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721540116,
					"content": "哦，「剑阵映影」是我为这一类的「映影」取的总称。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540117
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721540117,
					"content": "记录着刀剑搏击的画面，让观看者感觉自己如同在剑阵之中穿梭一般的「映影」…差不多就是这个意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540118,
						721540121
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721540118,
					"content": "虎之助先生居然有空…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540119
					]
				},
				{
					"id": 721540119,
					"content": "这也是上面的大人们准许过的行为，据大人说，这也有助于为幕府武士扬威。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540120
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721540120,
					"content": "虽然，我不知道泽维尔先生是如何说服上面的大人们的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540123
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721540123,
					"content": "但说真的，这位源次郎大人真是一位…非常严肃认真，但同时也非常善解人意的先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540124
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721540124,
					"content": "在我和他恳切地谈过之后，他十分愉快地答应了我的请求。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540125
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721540125,
					"content": "不过嘛…作为交换，我必须先制作一部和幕府有关的「映影」，最好是以武士为主角。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540126
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721540126,
					"content": "我对这种题材本来就感兴趣，当然就答应了下来，那位源次郎大人也很高兴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540127
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721540127,
					"content": "在亲自委派士兵先生和我同行之外，还额外指派了几位身手不错的士兵给我，然后他说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540128
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721540128,
					"content": "「以刀剑搏击的场面，展示武士和幕府的威严。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540129
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721540129,
					"content": "不得不说，这位源次郎大人的眼光真是颇为长远，居然想到用「映影」来做宣传…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540130
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721540130,
					"content": "但对我来说，一切对我制作「映影」有帮助的事，我都不会拒绝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540131,
						721540135
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721540131,
					"content": "你制作得还顺利吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540132
					]
				},
				{
					"id": 721540132,
					"content": "老实说…不太顺利…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540133
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721540133,
					"content": "虽然这几位士兵先生的武艺都很高强，但却不习惯这种「演艺式」的战斗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540134
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721540134,
					"content": "不仅挥剑快到「映影机」没法记录，而且有时候演着演着，就跑到了镜头外面…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540140
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721540140,
					"content": "旅行者，如果您有空的话，能按照我写的台本，上镜演一遍让士兵先生们看看吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540141
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721540141,
					"content": "我相信，以您的实力和理解力，演艺时一定能在镜头前收放自如。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540142
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721540142,
					"content": "从旁观者的角度看过演出后，他们一定能更好地理解这个剧情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540143
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721540143,
					"content": "来来来，你先看看台本，台词看看就好，这一段主要是打戏…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540144,
						721540145,
						721540146,
						721540156
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721540144,
					"content": "「这场仗，也算是输了。」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540147
					]
				},
				{
					"id": 721540147,
					"content": "啊，这些是另外场次的台词了…这一场戏主要是打戏，没什么台词。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540148
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721540148,
					"content": "我来看看台本…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540149
					]
				},
				{
					"id": 721540149,
					"content": "哦对了，您扮演的这个角色叫做「十三郎」，他和几名同伴一起，被一个村的村民们雇佣来保护村落…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540150
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721540150,
					"content": "呃，这一场还有一位叫做「久藏」的同伴有台词…这台词就由我说好了，先走一遍流程。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540151
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721540151,
					"content": "您一定要代入这个角色，理解这个角色！就把自己当做「十三郎」，明白了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540152,
						721540153
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721540152,
					"content": "明、明白了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540154
					]
				},
				{
					"id": 721540154,
					"content": "很好，非常好，好极了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540155
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721540155,
					"content": "您准备好了之后就告诉我，我还得去把「映影机」的机位调整一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721540153,
					"content": "我就是十三郎。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540154
					]
				},
				{
					"id": 721540145,
					"content": "「就算落难了，武士还是武士。」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540147
					]
				},
				{
					"id": 721540146,
					"content": "「你们都是合格的稻草人…」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540147
					]
				},
				{
					"id": 721540156,
					"content": "「…但敌人可不是团雀。」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540147
					]
				},
				{
					"id": 721540135,
					"content": "我能演个角色吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540136
					]
				},
				{
					"id": 721540136,
					"content": "#当然！当然！您可是我心中永远的{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HERO|INFO_FEMALE_PRONOUN_HEROINE]}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540137
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721540137,
					"content": "那部《踏鞴物语》我可一直记着呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540138
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721540138,
					"content": "而且…虽然这几位士兵先生的武艺都很高强，但却不太习惯这种「演艺式」的战斗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540139
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721540139,
					"content": "不仅挥剑快到「映影机」没法记录，而且有时候演着演着，就跑到了镜头外面…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540140
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721540121,
					"content": "你是怎么说服他的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540122
					]
				},
				{
					"id": 721540122,
					"content": "士兵先生早就理解了我，我主要的工作，还是说服那位御舆源次郎大人，请求他允许我在稻妻制作「映影」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540123
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721540112,
					"content": "「武士，如同席卷大地的清风。」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540113
					]
				},
				{
					"id": 721540113,
					"content": "您这句话的情绪太激昂了，应该是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540114
					],
					"speakerTitle": "泽维尔"
				}
			]
		},
		{
			"id": 7215402,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7215404",
							"2"
						],
						"stepId": 7215404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"泽维尔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721540201,
					"content": "哎呀，这样拍出来的「映影」可不太对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540202
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721540202,
					"content": "您再准备准备，我们再来一次吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "泽维尔"
				}
			]
		},
		{
