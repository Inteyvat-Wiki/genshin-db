			},
			"dialogs": [
				{
					"id": 721540301,
					"content": "#完美！不愧是我心中永远的{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HERO|INFO_FEMALE_PRONOUN_HEROINE]}！完美的示范！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540302,
						721540304
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721540302,
					"content": "什么…什么一号？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540303
					]
				},
				{
					"id": 721540303,
					"content": "一号演员，就是「映影」里最重要的演员。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540306
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721540306,
					"content": "士兵先生，您看清楚刚才旅行者的示范了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540307
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721540307,
					"content": "大致了解了。在挥剑的时候，我需要强调的其实并不是挥剑的「动作」，而是挥剑的「架势」，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540308
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721540308,
					"content": "如果只是「架势」的话…我倒是有些主意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540309
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721540309,
					"content": "哦？那太好了，请您去和其余的士兵先生们讲讲，稍后我们再来一次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540310
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721540310,
					"content": "旅行者，太谢谢你了，这些东西请你收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540311
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721540311,
					"content": "下一部「映影」的题材是？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540312
					]
				},
				{
					"id": 721540312,
					"content": "下一部「映影」的题材啊…唔…其实我也非常犹豫，有很多题材我都想要试一试。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540313
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721540313,
					"content": "比如鸣神大社里的各种传统啦，稻妻所流传的狸猫和狐狸的传说啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540314
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721540314,
					"content": "稻妻有这么多岛屿，可以制作的故事实在是太多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540315
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721540315,
					"content": "但无论如何，我都得先把这部《第七个武士》制作好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540316
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721540316,
					"content": "如果能让大人们满意的话，我之后在稻妻制作「映影」的时候，想必也会方便很多吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721540304,
					"content": "下次想换个新角色。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540305
					]
				},
				{
					"id": 721540305,
					"content": "没问题！等拍完了这一部「映影」之后，我就该筹划下一部全新「映影」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540306
					],
					"speakerTitle": "泽维尔"
				}
			]
		},
