					{
						"sceneId": 3,
						"position": [
							1502.263,
							-44.817,
							2746.826
						],
						"pointId": 311600092
					}
				]
			},
			"dialogs": [
				{
					"id": 711350201,
					"content": "哇啊！不知不觉间，我们已经收集到这么多仙力啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711350202,
						711350203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711350202,
					"content": "不愧是我！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711350205
					]
				},
				{
					"id": 711350205,
					"content": "按照浮锦之前的说法，这些仙力都用在「祀珑」上了。这样一来，翘英庄明年应该也会大丰收啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711350206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711350206,
					"content": "到了那时候，我要让罗叔给我准备好多好多好吃的！我想想，比如说茶糕，乳鸽，红烧肉圆，蜜汁叉烧，还有还有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711350207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711350207,
					"content": "茶露？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711350208
					],
					"speakerTitle": "浮锦"
				},
				{
					"id": 711350208,
					"content": "对对对，还有沉玉茶露！这个一定要记下来…欸？不对，什么人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711350209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711350209,
					"content": "浮、浮锦？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711350210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711350210,
					"content": "呵呵，抱歉，吓到你们了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711350211
					],
					"speakerTitle": "浮锦"
				},
				{
					"id": 711350211,
					"content": "你已经能变回人形啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711350212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711350212,
					"content": "是呀。咳咳，小仙我不是说过嘛，又不是受了什么严重的伤，只要稍微休养一段时间，就能恢复我最喜欢的模样啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711350213
					],
					"speakerTitle": "浮锦"
				},
				{
					"id": 711350213,
					"content": "#谢谢你们，在我休养的这段时间，为祀珑收集了这么多的仙力。来年的丰收，{NICKNAME}和派蒙是最大的功臣呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711350214,
						711350215
					],
					"speakerTitle": "浮锦"
				},
				{
					"id": 711350214,
					"content": "#哼哼，对本{M#少爷}{F#小姐}来说不过是举手之劳！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711350216
					]
				},
				{
					"id": 711350216,
					"content": "说到这个，既然浮锦现在已经恢复人形了，也不用再被关在这个黑漆漆的地方了，接下来有什么想做的事情吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711350217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711350217,
					"content": "嗯…具体的我还没有想好呢。说不定会先在附近走走看吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711350218
					],
					"speakerTitle": "浮锦"
				},
				{
					"id": 711350218,
					"content": "品一品现在的茶，听一听现在的戏，见一见现在的人…呵呵，抱歉，总是强调「现在」，感觉像是什么讨人厌的老古董一样呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711350219
					],
					"speakerTitle": "浮锦"
				},
				{
					"id": 711350219,
					"content": "不过，我真的很喜欢「现在」这个词。过去没办法做到的事情，「现在」也能做得到了。过去没办法实现的、好多好多的约定，「现在」也能实现了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711350220
					],
					"speakerTitle": "浮锦"
				},
				{
					"id": 711350220,
					"content": "之后，我想要到归离集去看一看，到璃月港去看一看，去见见她们所说的可爱的人们，也想要见见药君…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711350221
					],
					"speakerTitle": "浮锦"
				},
				{
					"id": 711350221,
					"content": "需要我带你去吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711350222
					]
				},
				{
					"id": 711350222,
					"content": "是呀，我记得浮锦好像说过，「没办法离开清水太长时间」、「需要依靠仙家的茶壶才能去很远的地方」什么的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711350223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711350223,
					"content": "呵呵…谢谢你还记得这件事，也谢谢你愿意帮我。不过，我还是希望先在沉玉谷停留一段时间，好好欣赏一下家中的风景。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711350224
					],
					"speakerTitle": "浮锦"
				},
				{
					"id": 711350224,
					"content": "至于远游，我想想…嗯，要不然等小茂长大吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711350225
					],
					"speakerTitle": "浮锦"
				},
				{
					"id": 711350225,
					"content": "这也太久了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711350226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711350226,
					"content": "开玩笑的啦！总之，我还是打算先在这边停留一段时间，也顺便试试看能不能劝灵渊和我一同出游。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711350227
					],
					"speakerTitle": "浮锦"
				},
				{
					"id": 711350227,
					"content": "#对了，{NICKNAME}！在你走之前，还有一件事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711350228
					],
					"speakerTitle": "浮锦"
				},
				{
					"id": 711350228,
					"content": "无论是灵渊还是我，都给你们添了太多太多的麻烦。我的仙力也稍稍恢复一些了，还请让我为你们献上真正的祝福，护佑你们接下来的旅途吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711350229
					],
					"speakerTitle": "浮锦"
				},
				{
					"id": 711350229,
					"content": "「采彼佳茗，酌我芳兰。白华凝露，翠叶垂烟。」\\n「时物向晚，岁聿其安。浮怀所思，永矢弗谖。」\\n「愿言相从，同此清欢。锦瑟在御，行与君还。」",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						711350230
					]
				},
				{
					"id": 711350230,
					"content": "呵呵，好了！这样一来，应该就没问题啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711350231,
						711350232
					],
					"speakerTitle": "浮锦"
				},
				{
					"id": 711350231,
					"content": "谢谢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711350234
					]
				},
				{
					"id": 711350234,
					"content": "#那么，再一次…谢谢你们，{NICKNAME}和派蒙，谢谢你们为我，为沉玉谷做的一切。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "浮锦"
				},
				{
					"id": 711350232,
					"content": "总觉得好像没什么变化…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711350233
					]
				},
				{
					"id": 711350233,
					"content": "毕竟「福运」也不是一下子就能看出来的呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711350234
					],
					"speakerTitle": "浮锦"
				},
				{
					"id": 711350215,
					"content": "能帮上忙就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711350216
					]
				},
				{
					"id": 711350203,
					"content": "#不愧是本{M#少爷}{F#小姐}！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711350204
					]
				},
				{
					"id": 711350204,
					"content": "喂！都过去那么久了，就别再用那种奇怪的说话方式啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711350205
					],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}