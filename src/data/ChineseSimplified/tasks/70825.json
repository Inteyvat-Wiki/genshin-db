			"dialogs": [
				{
					"id": 708250401,
					"content": "唉，要是能再多点人就好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250402,
						708250406
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 708250402,
					"content": "城里西风骑士们在做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708250403
					]
				},
				{
					"id": 708250403,
					"content": "保持城防、协助城内各种修缮事务，还有一些杂七杂八的事务。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250404
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 708250404,
					"content": "现在骑士团总部里每个人都忙得脚不沾地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250405
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 708250405,
					"content": "这么一比，在门口站岗反而算是个轻松的活了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 708250406,
					"content": "可以去找冒险家协会帮忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708250407
					]
				},
				{
					"id": 708250407,
					"content": "他们早就在帮忙了，最开始在城里不断搜索受灾的人们，之后又负责监视野外的魔物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250408
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 708250408,
					"content": "魔物向城边聚集时，也是冒险家协会的各位冒险家们不断外出确认魔物动向，再回来报告，我们才能制订出具体的迎击计划。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250409
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 708250409,
					"content": "现在他们也在全力协助城内的各种工作，没了他们，西风骑士团只怕会独木难支吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250410
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 708250410,
					"content": "这么一说，我得找个机会好好谢谢塞琉斯了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "霍夫曼"
				}
			]
		},
