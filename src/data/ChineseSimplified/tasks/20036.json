			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"葛罗丽"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200360201,
					"content": "您回来了，蒲公英搜集到了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360202
					],
					"speakerTitle": "葛罗丽"
				},
				{
					"id": 200360202,
					"content": "已经搜集好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360203
					]
				},
				{
					"id": 200360203,
					"content": "谢谢您，请您把蒲公英籽放在我手上，好吗？我看不见，怕把它们都弄撒了",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360204
					],
					"speakerTitle": "葛罗丽"
				},
				{
					"id": 200360204,
					"content": "这些够了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360205
					]
				},
				{
					"id": 200360205,
					"content": "请您先把蒲公英籽放在我手上吧，这样我才能感受一下它们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360206
					],
					"speakerTitle": "葛罗丽"
				},
				{
					"id": 200360206,
					"content": "这些就够了，我要把想和古德温说的话都告诉它们才行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360207
					],
					"speakerTitle": "葛罗丽"
				},
				{
					"id": 200360207,
					"content": "唔——请您捂住耳朵，别偷听，这是恋人之间的悄悄话哦。您肯定也…嘻嘻，您有过这种体验吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360208
					],
					"speakerTitle": "葛罗丽"
				},
				{
					"id": 200360208,
					"content": "好啦。请您带着这些蒲公英籽去风神像上，然后把它们洒在风中，让风神大人带走它们吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360209
					],
					"speakerTitle": "葛罗丽"
				},
				{
					"id": 200360209,
					"content": "希望风神大人，能够把它们带到古德温身边。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "葛罗丽"
				}
			]
		},
		{
			"id": 2003603,
			"completionStepIds": [
				2003606
			],
			"beginWay": "TALK_BEGIN_MANUAL",
