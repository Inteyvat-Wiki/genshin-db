			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"葛罗丽"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200360301,
					"content": "您已经做好了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360302
					],
					"speakerTitle": "葛罗丽"
				},
				{
					"id": 200360302,
					"content": "顶上的风真大…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360303
					]
				},
				{
					"id": 200360303,
					"content": "这样子才好，能让蒲公英飞得更远。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360304
					],
					"speakerTitle": "葛罗丽"
				},
				{
					"id": 200360304,
					"content": "这样子，古德温说不定就能收到，我对他说的话了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360305
					],
					"speakerTitle": "葛罗丽"
				},
				{
					"id": 200360305,
					"content": "您伸出手来吧，让我能碰到…请拿好了，这些谢礼是给您的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360306
					],
					"speakerTitle": "葛罗丽"
				},
				{
					"id": 200360306,
					"content": "我还有很多话想要和古德温说，之后，说不定也要多多麻烦您啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "葛罗丽"
				}
			]
		}
	]
