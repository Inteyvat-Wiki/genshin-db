			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"葛罗丽"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200360101,
					"content": "…古德温…到底什么时候能回来呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360102
					],
					"speakerTitle": "葛罗丽"
				},
				{
					"id": 200360102,
					"content": "你好…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360103
					]
				},
				{
					"id": 200360103,
					"content": "这个声音…是远方来的旅行者吗？感谢风神大人，一定是他的风将您带来的…请您听听我的请求吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360104
					],
					"speakerTitle": "葛罗丽"
				},
				{
					"id": 200360104,
					"content": "我的…唔，男朋友，西风骑士古德温离开蒙德城已经很久了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360105
					],
					"speakerTitle": "葛罗丽"
				},
				{
					"id": 200360105,
					"content": "这么久了，我一直没有收到他的消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360106
					],
					"speakerTitle": "葛罗丽"
				},
				{
					"id": 200360106,
					"content": "我很担心古德温。他要和那些难缠的丘丘人，还有他和我说过的深渊教团战斗，要是他受了伤怎么办，而且离开那么久，要是他遇见了哪位温柔的女骑士…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360107
					],
					"speakerTitle": "葛罗丽"
				},
				{
					"id": 200360107,
					"content": "抱，抱歉！我，我自顾自说太多了！我听我母亲说，蒲公英能够带着人们的思念，被风一直带到很远。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360108
					],
					"speakerTitle": "葛罗丽"
				},
				{
					"id": 200360108,
					"content": "所以我的请求是…能不能请您帮我去风起地搜集三份蒲公英籽？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360109,
						200360110
					],
					"speakerTitle": "葛罗丽"
				},
				{
					"id": 200360109,
					"content": "没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360111
					]
				},
				{
					"id": 200360111,
					"content": "太感谢您了，愿风神保佑您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "葛罗丽"
				},
				{
					"id": 200360110,
					"content": "还有别的事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360112
					]
				},
				{
					"id": 200360112,
					"content": "等一下！求您了，对您这样的旅行者来说，这肯定只是举手之劳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "葛罗丽"
				}
			]
		},
		{
