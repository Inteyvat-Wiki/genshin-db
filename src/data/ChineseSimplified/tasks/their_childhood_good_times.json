			"dialogs": [
				{
					"id": 240060601,
					"content": "不对，不对…这里的论证不严谨…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060602
					],
					"speakerTitle": "奥雷勒"
				},
				{
					"id": 240060602,
					"content": "#奥雷勒哥哥又不搭理人了…{M#大哥哥}{F#大姐姐}，谢谢你陪我们玩啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060603,
						240060604
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240060603,
					"content": "他…没关系吗？",
