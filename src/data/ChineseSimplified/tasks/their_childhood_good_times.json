				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240060101,
					"content": "这次轮到我来抓人了，我肯定能抓住洛薇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060102
					],
					"speakerTitle": "韦吕"
				},
				{
					"id": 240060102,
					"content": "那可说不准。有些地方你都爬不上去呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060103
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240060103,
					"content": "那是…那是因为我的鞋子不适合爬，要是换双鞋，肯定能抓住你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060104
					],
					"speakerTitle": "韦吕"
				},
				{
					"id": 240060104,
					"content": "那我们干脆把鞋子都脱掉好了，这样才公平！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060105
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240060105,
					"content": "好了！你们不许光脚到处跑，这里到处都是废弃的零件，要是划伤了怎么办？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060106
					],
					"speakerTitle": "奥雷勒"
				},
				{
					"id": 240060106,
					"content": "是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060107
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240060107,
					"content": "好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060108
					],
					"speakerTitle": "韦吕"
				},
				{
					"id": 240060108,
					"content": "那个…哥，你刚才抓我的时候，怎么一副走神的样子啊？我从你面前跑过去都没反应。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060109
					],
					"speakerTitle": "韦吕"
				},
				{
					"id": 240060109,
					"content": "咦？是这样吗？我刚才完全没注意到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060110
					],
					"speakerTitle": "奥雷勒"
				},
				{
					"id": 240060110,
					"content": "是啊，我刚才绕着跑一圈啦，但你就和没看见我一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060111
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240060111,
					"content": "#但…欸？{M#大哥哥}{F#大姐姐}，您怎么来了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060112,
						240060115
					],
					"speakerTitle": "奥雷勒"
				},
				{
					"id": 240060112,
					"content": "洛薇怎么在这？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060113
					]
				},
				{
					"id": 240060113,
					"content": "爸爸说他最近要去出差，妈妈也要出去工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060114
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240060114,
					"content": "正好奥雷勒哥哥来还书，爸爸就拜托奥雷勒哥哥来照顾我，所以我就来这里和他们一起玩啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060118
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240060118,
					"content": "不说这些了，继续玩吧，这次谁来抓人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060119,
						240060120
					],
					"speakerTitle": "奥雷勒"
				},
				{
					"id": 240060119,
					"content": "我还以为你不太喜欢捉迷藏。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060121
					]
				},
				{
					"id": 240060121,
					"content": "这个啊，咳…因为我最近正在写第一篇评论，需要思考一些问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060122
					],
					"speakerTitle": "奥雷勒"
				},
				{
					"id": 240060122,
					"content": "我发现…那个，在运动时我的思维会格外敏捷，所以…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060123
					],
					"speakerTitle": "奥雷勒"
				},
				{
					"id": 240060123,
					"content": "但就是容易走神，有时候还会站在原地自言自语，怎么叫都没反应。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060124
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240060124,
					"content": "#{M#大哥哥}{F#大姐姐}，你陪我们玩玩吧，你玩捉迷藏肯定比哥哥厉害多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060125,
						240060126
					],
					"speakerTitle": "韦吕"
				},
				{
					"id": 240060125,
					"content": "没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060127
					]
				},
				{
					"id": 240060127,
					"content": "嘿嘿，那可说不好，我和洛薇可都是捉迷藏大师。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060128
					],
					"speakerTitle": "韦吕"
				},
				{
					"id": 240060128,
					"content": "那就开始吧，快快快洛薇，我们去藏起来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060129
					],
					"speakerTitle": "韦吕"
				},
				{
					"id": 240060129,
					"content": "洛薇和韦吕飞快地跑开了，奥雷勒则沉思着缓步离开…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 240060126,
					"content": "我可不会让你们。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060127
					]
				},
				{
					"id": 240060120,
					"content": "你怎么突然这么想玩捉迷藏了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060121
					]
				},
				{
					"id": 240060115,
					"content": "你们还在玩捉迷藏吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060116
					]
				},
				{
					"id": 240060116,
					"content": "是的。因为德勒吕叔叔正巧要去出差，杜梅阿姨也要去工作，于是他们就拜托我来照顾洛薇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060117
					],
					"speakerTitle": "奥雷勒"
				},
				{
					"id": 240060117,
					"content": "所以我就带着洛薇来这里和我们一起玩了，希望她的裙子不会被弄得太脏…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060118
					],
					"speakerTitle": "奥雷勒"
				}
			]
		},
		{
			"id": 2400602,
