			"dialogs": [
				{
					"id": 240060401,
					"content": "不知道奥雷勒哥哥能不能找到思路…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060402
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240060402,
					"content": "#咦？！这个地方也能被找到吗？{M#大哥哥}{F#大姐姐}，你到底玩过多少次捉迷藏啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060403
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240060403,
					"content": "那我回集合点啦，下次一定藏得再好点。",
					"roleType": "TALK_ROLE_NPC",
