			},
			"dialogs": [
				{
					"id": 240060301,
					"content": "不行…这一段的逻辑不通顺，要从另外一个角度切入…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060302
					],
					"speakerTitle": "奥雷勒"
				},
				{
					"id": 240060302,
					"content": "这么…不对，还是不对…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060303
					],
					"speakerTitle": "奥雷勒"
				},
				{
					"id": 240060303,
					"content": "啊？我被找到了啊，我现在就去集合点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060304
					],
					"speakerTitle": "奥雷勒"
				},
				{
					"id": 240060304,
					"content": "嗯…这个观点对吗？不对，呃…对不对呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奥雷勒"
				}
			]
		},
		{
