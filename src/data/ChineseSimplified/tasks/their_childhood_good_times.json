					"韦吕"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240060201,
					"content": "#还是被找到啦，{M#大哥哥}{F#大姐姐}果然还是比我厉害。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060202
					],
					"speakerTitle": "韦吕"
				},
				{
					"id": 240060202,
					"content": "那我去集合点啦，希望哥哥能晚点被找到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060203
					],
					"speakerTitle": "韦吕"
				},
				{
					"id": 240060203,
					"content": "你为什么这么希望？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060204
					]
				},
				{
					"id": 240060204,
					"content": "哥哥说过呀，每次玩捉迷藏了之后，他都会找到很多新思路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060205
					],
					"speakerTitle": "韦吕"
				},
				{
					"id": 240060205,
					"content": "那些思路太多了，他每次都要蹲在地上记好久。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060206
					],
					"speakerTitle": "韦吕"
				},
				{
					"id": 240060206,
					"content": "洛薇和我说，那些思路可宝贵了，绝对不能打扰他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060207
					],
					"speakerTitle": "韦吕"
				},
				{
					"id": 240060207,
					"content": "所以我和洛薇在和哥哥玩捉迷藏的时候。如果轮到他被抓，那我们就会故意拖长时间，等他记好了再去找他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060208
					],
					"speakerTitle": "韦吕"
				},
				{
					"id": 240060208,
					"content": "就是…如果轮到哥哥抓人，那我们可就得等好长一段时间了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "韦吕"
				}
			]
		},
		{
			"id": 2400603,
