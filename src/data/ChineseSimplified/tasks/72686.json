			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"安彦太郎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726860101,
					"content": "请问阁下的名字是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860102
					],
					"speakerTitle": "安彦太郎"
				},
				{
					"id": 726860102,
					"content": "#我是{NICKNAME}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726860103
					]
				},
				{
					"id": 726860103,
					"content": "好，我记下了，请问阁下可有赌上武者荣誉的觉悟？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860104,
						726860105
					],
					"speakerTitle": "安彦太郎"
				},
				{
					"id": 726860104,
					"content": "什么？好突然！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726860106
					]
				},
				{
					"id": 726860106,
					"content": "嗯？难道阁下不是慕名前来参与这场决斗的武者？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860107
					],
					"speakerTitle": "安彦太郎"
				},
				{
					"id": 726860107,
					"content": "完全没听说过这回事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726860108
					]
				},
				{
					"id": 726860108,
					"content": "阁下难道没有听说过「孤剑争逐」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860109
					],
					"speakerTitle": "安彦太郎"
				},
				{
					"id": 726860109,
					"content": "这不应当，我明明已经张贴过公告了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860110
					],
					"speakerTitle": "安彦太郎"
				},
				{
					"id": 726860110,
					"content": "你贴在哪里了呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726860111,
					"content": "就在这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860112
					],
					"speakerTitle": "安彦太郎"
				},
				{
					"id": 726860112,
					"content": "贴在这里没有用啦，这样的宣传方式怎么会有人来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726860113,
					"content": "哼，还不是因为社奉行说「容彩祭不宜舞刀弄枪」，拒绝了我在离岛举办决斗，也禁止我张贴传单。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860114
					],
					"speakerTitle": "安彦太郎"
				},
				{
					"id": 726860114,
					"content": "因此，我只能把决斗场选在这里，把公告也贴在旁边。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860115
					],
					"speakerTitle": "安彦太郎"
				},
				{
					"id": 726860115,
					"content": "不过，实际上已经有四名武者前来参与比试了，如果连同阁下在内，那就有五人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860116
					],
					"speakerTitle": "安彦太郎"
				},
				{
					"id": 726860116,
					"content": "#这样还能有人来参加，真是神奇。话说{NICKNAME}来这里是为了什么来着，完全没有印象了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726860117,
					"content": "我看阁下能在不知此事的前提下，来到这小岛上，一定是位有着强烈武道精神的勇者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860118
					],
					"speakerTitle": "安彦太郎"
				},
				{
					"id": 726860118,
					"content": "痴迷于武道的人是会相互吸引的，这是常识，两位不必感到奇怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860119
					],
					"speakerTitle": "安彦太郎"
				},
				{
					"id": 726860119,
					"content": "这是哪个世界的常识啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726860120,
					"content": "呵呵，如何？阁下是否愿意前来比试？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860121
					],
					"speakerTitle": "安彦太郎"
				},
				{
					"id": 726860121,
					"content": "如果阁下能一一胜过那四位参赛者，届时自有礼金奉上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860122
					],
					"speakerTitle": "安彦太郎"
				},
				{
					"id": 726860122,
					"content": "让我考虑考虑。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726860123
					]
				},
				{
					"id": 726860123,
					"content": "好，那么就请阁下好好考虑一番。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安彦太郎"
				},
				{
					"id": 726860105,
					"content": "没有没有，打扰了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726860106
					]
				}
			]
		}
	]
}