			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"大岛纯平"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220430101,
					"content": "木头怎么又用完了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430102
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 220430102,
					"content": "哦！旅行者，你来得正好，你愿意帮我个忙吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430103,
						220430104
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 220430103,
					"content": "什么忙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220430105
					]
				},
				{
					"id": 220430105,
					"content": "我最近，正尝试着按照代宫司大人的模样雕刻一些尺寸很小的木雕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430106
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 220430106,
					"content": "我想，等我雕得好一些之后，就带着这些木雕回鸣神岛去，看看能不能卖出去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430107
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 220430107,
					"content": "如果真能卖出去的话，应该也能算是一份稳定的收入了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430108,
						220430111
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 220430108,
					"content": "应该能卖出去。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220430109
					]
				},
				{
					"id": 220430109,
					"content": "哈哈哈，那我就借你吉言了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430110
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 220430110,
					"content": "不过，我也对代宫司大人的魅力很有信心啦，嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430118
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 220430118,
					"content": "啊…先不说这些了，我们说正事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430119
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 220430119,
					"content": "其实，最近我手上用来练习木雕的木材有些不够用了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430120
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 220430120,
					"content": "旅行者，能请你帮我去外面搜集10份「御伽木」来吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430121,
						220430123
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 220430121,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220430122
					]
				},
				{
					"id": 220430122,
					"content": "那就拜托你了，旅行者，真是帮大忙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430126
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 220430126,
					"content": "你搜集到御伽木后，就快点带来给我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 220430123,
					"content": "要这么多吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220430124
					]
				},
				{
					"id": 220430124,
					"content": "毕竟我刚开始练习木雕不久…多备一些材料总是好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430125
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 220430125,
					"content": "那就拜托你了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430126
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 220430111,
					"content": "怎么突然开始做木雕了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220430112
					]
				},
				{
					"id": 220430112,
					"content": "你问这个啊…那个，你知道代宫司大人给我的「报酬」是什么吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430113
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 220430113,
					"content": "是一些…瓶瓶罐罐，杯杯盏盏之类的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430114
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 220430114,
					"content": "虽然看起来有点旧了，但我拿回去给人看了之后，发现这些东西居然还颇有些年头，而且也能卖一点钱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430115
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 220430115,
					"content": "不过把那些东西拿去卖钱的过程可折腾了，每次都把我累得够呛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430116
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 220430116,
					"content": "而且，这样子的收入也不稳定…要是代宫司大人哪一天找不出这些东西了，我不就又等于失业了吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430117
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 220430117,
					"content": "所以，我正想办法开辟一条新的生意路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430118
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 220430104,
					"content": "你在做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220430105
					]
				}
			]
		},
