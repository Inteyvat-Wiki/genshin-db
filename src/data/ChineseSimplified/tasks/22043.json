					"大岛纯平"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220430301,
					"content": "嗯，这些应该就够用了。抱歉啊，你好不容易过来神社，我还拜托你帮忙…这些东西你先收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430302
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 220430302,
					"content": "等我木雕的手艺练好了，我一定送你一座最好的木雕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430303
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 220430303,
					"content": "唔，接下来雕个什么样的代宫司大人好呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大岛纯平"
				}
			]
		}
	]
