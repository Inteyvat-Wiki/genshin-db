			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"莱妮"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736820101,
					"content": "可让我一阵好等啊，两位胆识卓绝的朋友！请抓紧这大好的机会，和我一起领略冒险的艺术，尝试超越本我吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820102,
						736820103
					],
					"speakerTitle": "莱妮"
				},
				{
					"id": 736820102,
					"content": "冒险艺术？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736820104
					]
				},
				{
					"id": 736820104,
					"content": "唔，虽然不知道你在说什么，但好像很厉害！能不能再解释一下？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736820105,
					"content": "当然没问题…慢着，我认识你…居然是您！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820106
					],
					"speakerTitle": "莱妮"
				},
				{
					"id": 736820106,
					"content": "抗击风魔龙的空战豪杰，不倦执勤的委托粉碎机，隐秘宝箱的寻踪人，未知迷雾的破除者…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820107
					],
					"speakerTitle": "莱妮"
				},
				{
					"id": 736820107,
					"content": "如果您带头参加这次活动，一定能拉动大家的热情，推进这项伟大的事业！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820108
					],
					"speakerTitle": "莱妮"
				},
				{
					"id": 736820108,
					"content": "好大一串称号？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736820109
					]
				},
				{
					"id": 736820109,
					"content": "从来没听过欸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736820110,
					"content": "这些称号通常出现酒桌上、篝火周围和孩子们的睡前故事里，只靠人们口口相传，您没听过也很正常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820111
					],
					"speakerTitle": "莱妮"
				},
				{
					"id": 736820111,
					"content": "总之，您活跃的身影鼓励着成百上千位冒险家，给了大家不断变强的动力！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820112
					],
					"speakerTitle": "莱妮"
				},
				{
					"id": 736820112,
					"content": "#原来{NICKNAME}在蒙德的冒险家协会已经这么有名了吗？那我呢，我有什么称号吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736820113,
					"content": "咳咳！我好像听朋友说过，有人称你为…「如鸟羽般轻灵，如北风般豪爽的派蒙大人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820114
					],
					"speakerTitle": "莱妮"
				},
				{
					"id": 736820114,
					"content": "「鸟羽般轻灵」形容的是你小巧敏捷的身姿，「北风般豪爽」说的是你和北风骑士不相上下的，令人羡慕的好胃口！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820115,
						736820116
					],
					"speakerTitle": "莱妮"
				},
				{
					"id": 736820115,
					"content": "怎么好像是在开玩笑…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736820117
					]
				},
				{
					"id": 736820117,
					"content": "有点听不明白…但都叫我派蒙大人了，应该很威风吧！我会牢牢记下来的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736820118,
					"content": "#我决定了！不管你有什么请求，我派蒙大人和…呃…和豪杰粉碎机、空战宝箱与委托破除人{NICKNAME}都会帮你到底的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736820119,
					"content": "刚才你好像提到了冒险，超越之类的词，我猜，是不是协会要举办一场特别的挑战活动？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736820120,
					"content": "完全正确！你们应该听说过，冒险家协会经常为新人开展特训。正好在佳酿节期间，渐强的西风捎来了特别的「风种子」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820121
					],
					"speakerTitle": "莱妮"
				},
				{
					"id": 736820121,
					"content": "这些「风种子」可以强化冒险家们的能力，让大家体验变强后的美妙感受，也算是给了冒险家们一个努力的目标。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820122
					],
					"speakerTitle": "莱妮"
				},
				{
					"id": 736820122,
					"content": "所以塞琉斯会长让我在这些「风种子」散落的区域周围探查一番，找出凶悍魔物和盗匪的所在地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820123
					],
					"speakerTitle": "莱妮"
				},
				{
					"id": 736820123,
					"content": "参加试炼的冒险家们需要谨慎运用特别的「风种子」，击败这些敌人。达成技艺的升华，精神的突破，以及对未来的展望！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820124
					],
					"speakerTitle": "莱妮"
				},
				{
					"id": 736820124,
					"content": "怎么样，有没有觉得很兴奋！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820125
					],
					"speakerTitle": "莱妮"
				},
				{
					"id": 736820125,
					"content": "哼哼，果然没错，我的直觉很准嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736820126,
					"content": "反正我们已经吃饱喝足了，不活动一下的话，也许会变胖呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736820127,
					"content": "对吧对吧！赶快卷起袖子来试试吧！如果你们参与了这场试炼，相信会有很多冒险家慕名而来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820128
					],
					"speakerTitle": "莱妮"
				},
				{
					"id": 736820128,
					"content": "接下来，我会给你们指出首个挑战区域。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820129
					],
					"speakerTitle": "莱妮"
				},
				{
					"id": 736820129,
					"content": "放手去干吧，我会记录你们的英姿，并向其他冒险家好好宣传的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莱妮"
				},
				{
					"id": 736820116,
					"content": "怎么好像是刚刚编的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736820117
					]
				},
				{
					"id": 736820103,
					"content": "超越本我？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736820104
					]
				}
			]
		}
	]
}