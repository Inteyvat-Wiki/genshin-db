			"completionStepIds": [
				7365101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7365101",
							"2"
						],
						"stepId": 7365101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"哈贾娜德",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736510101,
					"content": "嘿嘿嘿，哈哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510102
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 736510102,
					"content": "大功告成了！接下来就是论证环节了！我要向大家证明，这就是炼金药剂的最强形态！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510103
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 736510103,
					"content": "…这个人怎么站在悬崖边傻笑？还不停自言自语？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736510104,
					"content": "#我感觉心里毛毛的，{NICKNAME}，我们离这个怪人远一点吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510105,
						736510106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736510105,
					"content": "万一她有点想不开呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736510107
					]
				},
				{
					"id": 736510107,
					"content": "喂喂，你也太替别人着想了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736510108,
					"content": "嗯？你们什么时候过来的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510109
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 736510109,
					"content": "居然在背后议论别人，真没礼貌！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510110
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 736510110,
					"content": "我可是悉般多摩学院的明日之星哈贾娜德！等我成为知名的学者，一定要写篇文章来埋汰你们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510111
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 736510111,
					"content": "好凶！名字也好拗口！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736510112,
					"content": "等等？这个小家伙难道是…那篇奇闻上的「白色高智能浮游助手单元」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510113
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 736510113,
					"content": "什么胡说八道的奇闻，从没听过这种外号啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736510114,
					"content": "总之，带着「白色高智能浮游助手单元」的金发异乡人…不会错，我走运了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510115
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 736510115,
					"content": "呃咳！听我说，我可以让需要战斗的人变得更强。和我做个交易，怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510116,
						736510117
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 736510116,
					"content": "好耳熟的展开…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736510118
					]
				},
				{
					"id": 736510118,
					"content": "不奇怪，提瓦特各地有不少像我一样的炼金术士，致力于发掘炼金术的最高价值。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510119
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 736510119,
					"content": "辅助战斗是炼金术的重要功能。如果能将药剂的效力发挥到极致，就有机会改写战斗的规则。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510120
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 736510120,
					"content": "以你们的见闻，应该遇到过其他钻研药剂的炼金术士吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510121
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 736510121,
					"content": "不过和我相比，其他炼金术士大多还在摸索，只有少数人取得了一点进展。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510122
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 736510122,
					"content": "比如一位蒙德的炼金术士，他发表了「广域散布雾化液体药剂，改变战斗环境」的研究论文…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510123
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 736510123,
					"content": "太幼稚了！就算增加了辅助挥发的成分，散布药剂的速度和浓度也不可能合格！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510124
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 736510124,
					"content": "突然就变得滔滔不绝了，她好像要证明自己在这方面做得最好呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736510125,
					"content": "所以说，交易的内容…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736510126
					]
				},
				{
					"id": 736510126,
					"content": "对啊，哈贾娜德小姐，你做出了更强的药剂，打算特价卖给我们吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736510127,
					"content": "问得好！我正要向你展示我的最新研究成果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510128
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 736510128,
					"content": "我将两种高浓度的药剂制成片状的结晶，划分成许多小块，并将它们装入高压密封的炼金装置。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510129
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 736510129,
					"content": "需要使用药剂时，就点燃装置内的小型炸药，将两片药剂的一部分瞬间气化，充分混合。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510130
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 736510130,
					"content": "并且利用爆炸的压力，将药剂烟雾推出装置，散布在广阔的空间内，提供战斗的助力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510131
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 736510131,
					"content": "我称这个过程为「重熔效应」，装置为「重熔装置」，药剂则叫「重熔片剂」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510132
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 736510132,
					"content": "重…重熔？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736510133,
					"content": "爆…爆炸？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736510134
					]
				},
				{
					"id": 736510134,
					"content": "强而有力的爆炸后，空气中就充满了沁人心脾的芳香，使用者的力量也随之急速增长。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510135
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 736510135,
					"content": "怎么样？很诱人吧？不想试试吗？只需要在战斗中留意药剂的功效，帮我记录一些细节表现就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510136
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 736510136,
					"content": "当然，绝不是打白工，会有相当不错的佣金哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510137
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 736510137,
					"content": "原来只想让我们来当实验品吗？听起来好危险！我们才不干咧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510138
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736510138,
					"content": "要是出了意外，给我们一千倍佣金的赔偿，还勉强可以考虑考虑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736510139,
					"content": "没问题。反正我已经试验过很多次了，我的装置是绝对安全的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510140
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 736510140,
					"content": "这么干脆？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510141,
						736510142
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736510141,
					"content": "我们倒也不缺这点摩拉。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736510143
					]
				},
				{
					"id": 736510143,
					"content": "唔…想来也是，毕竟是登上过奇闻刊物的人，肯定也家缠万贯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510144
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 736510144,
					"content": "那就…那就…求求你嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510145
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 736510145,
					"content": "之前对你们态度恶劣，还想用这点小钱收买你们，真的很对不起！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510146
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 736510146,
					"content": "如果你们帮我完成试验，就是我的大恩人！等我成为了知名的学者，我一定不会亏待你们的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510147
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 736510147,
					"content": "噫！突然就变脸了，还敢做出这种承诺…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510148
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736510148,
					"content": "好势利。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736510149
					]
				},
				{
					"id": 736510149,
					"content": "说到底是我有求于人吧。需要依附别人的时候，最好端正姿态。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510150
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 736510150,
					"content": "我知道这副嘴脸很难看，但你们以后十有八九还会碰到我这样的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510151
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 736510151,
					"content": "起码我还会给你们报酬和承诺，有的人可能想着空手套白狼哦。这样一想，我还算挺实在的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510152
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 736510152,
					"content": "呃，虽然这样揣测别人不礼貌，但好像也不是危言耸听…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510153
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736510153,
					"content": "派蒙动摇了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736510154
					]
				},
				{
					"id": 736510154,
					"content": "话都说到这份上了，我也想看看她的炼金药剂究竟有多厉害啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510155
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736510155,
					"content": "而且，我感觉她也没什么坏心眼，可能只因为搞研究太心急了，才给人一种怪怪的感觉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510156
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736510156,
					"content": "完成研究以后，也许她会变成一个不错的人呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510157
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736510157,
					"content": "哦？你们在商量测试装置的方法？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510158
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 736510158,
					"content": "附近正好有一个秘境，根据其他冒险家的报告，很适合这次的战斗测试。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510159
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 736510159,
					"content": "你倒是一点也不客气…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736510160
					]
				},
				{
					"id": 736510160,
					"content": "我都把未来托付给你们两位了，你们也爽快点嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510161
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 736510161,
					"content": "唔…反正和普通的冒险委托也没太多区别，那就上吧，我们去秘境里试试这个装置。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510162
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736510162,
					"content": "好，一言为定！我就在附近等着你们的好消息哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 736510142,
					"content": "我不需要炼金术也能变强。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736510143
					]
				},
				{
					"id": 736510117,
					"content": "好像听到过这种话…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736510118
					]
				},
				{
