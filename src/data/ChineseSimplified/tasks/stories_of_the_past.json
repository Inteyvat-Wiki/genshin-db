				]
			},
			"dialogs": [
				{
					"id": 742510101,
					"content": "感谢你的邀请，吉约丹小姐。我想，这些纯净水应该是你为此次茶会特意准备的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510102
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 742510102,
					"content": "这没什么。身为枫丹最高审判官的那维莱特大人百忙中能够抽空来喝杯…水，是我的荣幸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510103
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 742510103,
					"content": "吉约丹小姐有什么和愚人众有关的公事要与我商谈吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510104
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 742510104,
					"content": "不，和愚人众无关，这次是私事。也没到什么商谈的程度。我就是想向你打听一位曾经的熟人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510105
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 742510105,
					"content": "曾经的熟人…哦，是说阿兰·吉约丹阁下吧？那位伟大的「奇械公」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510106
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 742510106,
					"content": "嗯，没错。他曾经是怎样一个人？我听闻他年轻时也算是你的部下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510107
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 742510107,
					"content": "嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510108
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 742510108,
					"content": "吉约丹先生为人真诚，脚踏实地。在获封「护国的白骑士」后也不曾见他露出过骄傲的神情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510109
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 742510109,
					"content": "他大多数时间都潜心于研究机械，不问身外之事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510110
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 742510110,
					"content": "唔…年轻时就这样吗？也不知这到底是年少老成还是不谙世事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510111
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 742510111,
					"content": "不过…这样的他在那次失去了家人和朋友之后，就变了不少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510112
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 742510112,
					"content": "格式塔吗…还有，厄里纳斯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510113
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 742510113,
					"content": "没错。与我一同签署搜查格式塔的命令时，他看起来很…无奈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510114
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 742510114,
					"content": "过往的隔阂与疏离导向了如今的境地，他一定也是在内疚吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510115
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 742510115,
					"content": "嗯，自那之后他变得更加沉默寡言。我们之间的来往也更少了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510116
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 742510116,
					"content": "在受封「奇械公」的称谓时，他对台下人说了一句话——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510117
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 742510117,
					"content": "「静谧而谦卑地生活，比一昧追求无止境的完美，更容易追寻到幸福。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510118
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 742510118,
					"content": "呵…他晚年也的确这么做了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510119
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 742510119,
					"content": "我猜，那句话他不只是说给台下的人听，也是说给自己听的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510120
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 742510120,
					"content": "吉约丹小姐对此怎么看？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510121
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 742510121,
					"content": "我吗？哼，我不会对他的领悟或他的生活方式做什么评价，就像他不曾要求我去过任何一种生活一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510122
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 742510122,
					"content": "我也无心去重走他的老路，去过他理想中的日子。我有我自己的人生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510123
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 742510123,
					"content": "哈…多谢。这让我更加了解了他一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510124
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 742510124,
					"content": "不必客气。我也很高兴能与吉约丹先生的后人分享过去的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "那维莱特"
				}
			]
		},
