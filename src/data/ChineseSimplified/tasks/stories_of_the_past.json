				"points": []
			},
			"dialogs": [
				{
					"id": 742510201,
					"content": "很高兴能一边品水一边与吉约丹小姐分享过去的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510202,
						742510203
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 742510202,
					"content": "（再这么坐一会儿吧。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510204
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 742510204,
					"content": "好。祝你前路顺利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 742510203,
					"content": "茶会时间该结束了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510204
					],
					"speakerTitle": "「木偶」"
				}
			]
		}
	]
}