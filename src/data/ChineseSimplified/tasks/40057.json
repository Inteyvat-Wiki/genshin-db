			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿贝多"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400570201,
					"content": "阿贝多，我们找到帮行秋的办法了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400570202,
					"content": "把刚才发生的事告诉了阿贝多。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400570203
					]
				},
				{
					"id": 400570203,
					"content": "五歌仙的故事果然又出现了，而且还来了这么一个办法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570204
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400570204,
					"content": "印章，嗯，让我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570205
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400570205,
					"content": "确实是个高效率的方案，这样一来行秋就不用苦于字迹问题了。不过…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570206,
						400570207
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400570206,
					"content": "「不过」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400570208
					]
				},
				{
					"id": 400570208,
					"content": "因为行秋的签名之前已经对读者公布过，如果这次的新刊上只有他使用印章，未免显得诚意不足。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570209
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400570209,
					"content": "我想到了另一个主意，当然印章也是其中一部分。我们现在就去乌有亭，和大家商量一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400570207,
					"content": "还有什么问题吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400570208
					]
				}
			]
		},
		{
			"id": 4005703,
			"completionStepIds": [
				4005706
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4005706",
							"2"
						],
						"stepId": 4005706,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"行秋"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400570301,
					"content": "加油啊枕玉老师，今天写出来的字已经很有进步了，说明昨天的特训很有效！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570302
					],
					"speakerTitle": "平山"
				},
				{
					"id": 400570302,
					"content": "唉，不行了，我的手已经酸得抬不起来了…早知道这样，之前就不在书法课上看小说了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570303
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 400570303,
					"content": "刚刚已经休息了十分钟了，再坚持一下啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570304
					],
					"speakerTitle": "平山"
				},
				{
					"id": 400570304,
					"content": "编辑长不愧是我们之中催稿最可怕的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570305
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 400570305,
					"content": "嗯，难怪一遇到麻烦的作者，八重大人最后总会派编辑长出马…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570306
					],
					"speakerTitle": "村田"
				},
				{
					"id": 400570306,
					"content": "太可怕了，才一阵子没见，行秋就已经要变成行尸走肉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400570307,
					"content": "编辑长，其实刚才我们找到了一个办法，或许可以解决大家的困境。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570308
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400570308,
					"content": "璃月和稻妻，印章使用都很广泛，印章也往往视作与签名等同之物。或许可以用这个思路，让签名变得容易些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570309
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400570309,
					"content": "当然，只有印章是不行的，签名需要由两部分组成。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570310
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400570310,
					"content": "首先是个人的图章，这部分以枕玉老师的签名为模板刻制就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570311
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400570311,
					"content": "同时，我会再为枕玉老师设计一个美观易写的图案，枕玉老师只需在每本书上签下这个图案即可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570312
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400570312,
					"content": "让我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570313
					],
					"speakerTitle": "平山"
				},
				{
					"id": 400570313,
					"content": "嗯，这办法可行！不仅出自作者亲笔，而且效果应该也会十分美观。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570314
					],
					"speakerTitle": "平山"
				},
				{
					"id": 400570314,
					"content": "真的吗，这么说来我终于得救了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570315
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 400570315,
					"content": "编辑长，我突然想到，之前我们之所以放弃了现场签售，是因为考虑到作者签名会花费比较长时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570316
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 400570316,
					"content": "但如果是这种形式的签名的话，是不是在现场签售也来得及？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570317
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 400570317,
					"content": "而且如果所有作者都采用类似的形式，也不会让枕玉老师的签名显得突兀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570318
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 400570318,
					"content": "如果你们觉得可行，我当然也很乐意为其他作者设计签名。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570319
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400570319,
					"content": "雕刻印章的事可以交给我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570320
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400570320,
					"content": "既然这样，我现在就去联络新刊发售会的其他两位作者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570321
					],
					"speakerTitle": "平山"
				},
				{
					"id": 400570321,
					"content": "不久后，两位作者赶来了…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400570322
					]
				},
				{
					"id": 400570322,
					"content": "竟然能获得白垩老师设计的签名，真是太荣幸了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570323
					],
					"speakerTitle": "聪美"
				},
				{
					"id": 400570323,
					"content": "因为我的笔名很复杂，不适合进行签售，这下终于可以实现心愿了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570324
					],
					"speakerTitle": "勘解由小路健三郎"
				},
				{
					"id": 400570324,
					"content": "太好啦，看来大家都同意这个提案呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570325
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400570325,
					"content": "让枕玉老师忙了这么多天，实在不好意思，接下来这几天就请您好好休息，后续事宜就交给我们吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570326
					],
					"speakerTitle": "平山"
				},
				{
					"id": 400570326,
					"content": "已经签好的这些书，将来也会作为八重堂活动的特殊奖品使用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570327
					],
					"speakerTitle": "平山"
				},
				{
					"id": 400570327,
					"content": "呼…得救了，终于得救了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570328
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 400570328,
					"content": "多亏大家相助，我和小野寺先生才能彻底摆脱困境。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570329
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 400570329,
					"content": "嘻嘻，行秋终于自由啦，出去好好呼吸一下新鲜空气吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
