			"dialogs": [
				{
					"id": 400570401,
					"content": "现在时间还早，我们接下来要去哪里？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400570402,
					"content": "各位，可算找到你们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570403
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 400570403,
					"content": "咦，是绫华和温迪…你们两个怎么会在一起？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400570404,
					"content": "其实是刚才，我去容彩祭会场安排插花课程的事，在花架上发现了一张神秘的纸片。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570405
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 400570405,
					"content": "当时刚好这位吟游诗人就在旁边，我听他说，这些天你们还发现过其他类似的东西，于是就和他一起来找你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570406
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 400570406,
					"content": "不过这位小姐发现的纸片，和我们之前找到的不太一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570407
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 400570407,
					"content": "东西在这里，请各位过目。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570408
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 400570408,
					"content": "之前的诗歌长度都差不多，但这次却只有两句。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400570409,
					"content": "明明只有短短两句话，却既没有挨着标题，也没有写在整张纸中间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570410
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400570410,
					"content": "字迹的位置简直就像是在告诉我们，除了这两句话之外，这张纸上还有其他内容似的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570411
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400570411,
					"content": "如果从字面意思来理解这句诗的话，就是「把纸张放在水中，真相自然会浮现」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570412
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 400570412,
					"content": "说起来我家中有本古籍，专讲古代的奇闻异事，书中提到过一种特殊的墨水，能够遇水则显，水干则消。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570413
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 400570413,
					"content": "那我们要不要去试试？刚好这附近就有水池。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "温迪"
				}
			]
		},
