				{
					"id": 400575101,
					"content": "小野寺，等会就由你把发售会的变化告诉八重大人吧，这个主意八重大人一定会喜欢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400575102
					],
					"speakerTitle": "平山"
				},
				{
					"id": 400575102,
					"content": "你的脑子动得很快，只要行事再稳妥一些，将来一定能有所作为。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400575103
					],
					"speakerTitle": "平山"
				},
				{
					"id": 400575103,
					"content": "非常感谢，编辑长。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400575104
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 400575104,
					"content": "这大概就是所谓的因祸得福吧？新刊发售会变成「签售会」，读者们也一定会高兴的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "村田"
				}
			]
		}
