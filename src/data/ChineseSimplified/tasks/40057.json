				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"枫原万叶"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400570701,
					"content": "万叶，你怎么了？从刚才开始就一直站在这幅空白的画布前，而且脸色也不太好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570702
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400570702,
					"content": "抱歉，虽然这只是我们的猜测，不过五歌仙故事，是不是让你联想到了什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570703
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400570703,
					"content": "我刚刚的确想到了一些事，只不过那些都是我家的一些陈年旧事罢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570704
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400570704,
					"content": "虽然我并不介意告诉大家，但我觉得不该再麻烦你们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570705
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400570705,
					"content": "万叶，我们都是你的朋友，没有麻烦不麻烦这一说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570706
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400570706,
					"content": "枫原，请恕我冒昧，你所想之事是否与「雷电五传」有关？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570707
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 400570707,
					"content": "「雷电五传」，那是什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570708
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400570708,
					"content": "看来我和神里小姐所想的是同一件事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570709
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400570709,
					"content": "这件事与社奉行也有不小的关系，不知道你是否同意，我把它告诉大家？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570710
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400570710,
					"content": "在场大家都是值得信赖的人，说出来也无妨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570711
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 400570711,
					"content": "只不过这件事要解释起来有些复杂，还是让我先从「雷电五传」讲起吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570712
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 400570712,
					"content": "各位知道，社奉行主要掌管祭祀活动与文化传承，而稻妻的「锻刀技艺」，也是其中极为重要的部分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570713
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 400570713,
					"content": "「雷电五传」曾经是稻妻最为顶尖的五个锻刀流派，这五个家族虽是刀匠世家，却也在社奉行有不小的官职。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570714
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 400570714,
					"content": "只可惜，现在雷电五传已经只剩下「天目流」仍有师徒传承，「一心传」虽然技艺失传，但所幸还有后人在世。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570715
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 400570715,
					"content": "而枫原家，就正是「一心」一脉的后人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570716
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 400570716,
					"content": "我们原来只知道万叶家曾经是贵族，没想到竟然还与社奉行和锻刀有关。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570717
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400570717,
					"content": "嗯，不过这都是很早以前的事了，「一心传」在我曾祖父那一代就没落了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570718
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400570718,
					"content": "我爷爷不满曾祖父的无所作为，在年轻时曾经游历提瓦特，寻找重振家业的办法，可惜最终没能成功。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570719
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400570719,
					"content": "而到我这里，更是连仅剩的祖宅都失去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570720
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400570720,
					"content": "之前我听兄长提起过，「雷电五传」的没落非常快，在短短数十年里，就有三家遭遇种种不幸，最终彻底消失。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570721
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 400570721,
					"content": "然后就有人猜测，这些不幸其实都是有人暗中操作的结果，有人想要灭绝「雷电五传」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570722
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 400570722,
					"content": "不过由于雷电五传并没有完全消失，这种说法最终也只是被当作坊间传闻而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570723
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 400570723,
					"content": "对，我之前也一直是这么认为的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570724
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400570724,
					"content": "不过我知道，曾祖父年轻时曾发生过「一件大事」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570725
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400570725,
					"content": "那件事不仅牵扯到我们枫原一族，甚至差点动摇了神里家在社奉行的地位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570726
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400570726,
					"content": "我读到五歌仙的故事后就隐约意识到，它似乎正在提示我那件事的真相。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570727
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400570727,
					"content": "万叶，当年到底发生过什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570728
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400570728,
					"content": "关于那件事的一些细节，我还需要找人求证，大家明天中午再到这里汇合吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570729
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400570729,
					"content": "到时候，我会把知道的一切都详细告诉你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "枫原万叶"
				}
			]
		},
