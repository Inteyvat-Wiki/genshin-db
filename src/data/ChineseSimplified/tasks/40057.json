			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"枫原万叶"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400570101,
					"content": "#{NICKNAME}，派蒙，你们好。我听说容彩祭会有向导，却没想到是你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570102
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400570102,
					"content": "嘻嘻，我们也没想到，万叶竟然会以容彩祭嘉宾的身份回到稻妻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400570103,
					"content": "接到邀请函时我也有些诧异，不过在外面漂泊久了，能借此机会回到故土，祭拜一下故人也不错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570104
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400570104,
					"content": "万叶，我们刚才远远地看见你好像正在找什么东西，发生什么事了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400570105,
					"content": "是这样的，刚才我跟着大家下船的时候，突然听到身边响起了很轻的脚步声。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570106
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400570106,
					"content": "那种脚步绝不是一般乘客，可我回过头时，那人已经不见了，只有栈桥下传来了「噗通」一声响。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570107
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400570107,
					"content": "我没找到对方的踪影，不过却在脚边发现了一张奇怪的纸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570108
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400570108,
					"content": "万叶，你捡到的纸上是不是写了一首诗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400570109,
					"content": "咦，你们怎么知道？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570110
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400570110,
					"content": "把之前几天发生的事告诉了万叶…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400570111
					]
				},
				{
					"id": 400570111,
					"content": "竟然还有这种事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570112
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400570112,
					"content": "万叶，能给我们看看那张纸吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400570113
					]
				},
				{
					"id": 400570113,
					"content": "在这里，请吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570114
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400570114,
					"content": "上次葵之翁的诗最后提到了「赤人」，果然这一篇就是赤人的故事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400570115,
					"content": "这次的故事大致是说：赤人因为喜欢用红色的印章才有了这个雅号，不过他却因为剽窃被将军发现，然后被流放了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400570116,
					"content": "怎么说呢，如果要评价的话，今天的故事听起来不是很吉利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400570117,
					"content": "其实之前的也好不到哪去…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400570118
					]
				},
				{
					"id": 400570118,
					"content": "我倒觉得这篇故事并无不妥，我之前也曾经是被幕府通缉的要犯，和故事里的赤人也差不多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570119
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400570119,
					"content": "这篇故事里的赤人做了坏事，被将军流放是咎由自取，和万叶一点都不一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400570120,
					"content": "喂，你在想什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570121,
						400570122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400570121,
					"content": "故事里的「印章」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400570123
					]
				},
				{
					"id": 400570123,
					"content": "对了，你们刚才提到，有位朋友最近正苦于签名太慢是吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570124
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400570124,
					"content": "在璃月和稻妻，的确都有「印章等同于签名」的说法，这说不定是个可行的主意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570125
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400570125,
					"content": "在海上航行时，我偶尔会雕刻些东西打发时光，如果要做印章，或许我也能出一份力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570126
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400570126,
					"content": "哇，那就太好了！我们现在，先去找阿贝多商量一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400570122,
					"content": "说不定能帮行秋？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400570123
					]
				}
			]
		},
		{
			"id": 4005702,
			"completionStepIds": [
				4005704
