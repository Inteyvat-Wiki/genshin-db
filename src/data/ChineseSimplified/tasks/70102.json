					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7010206",
							"3"
						],
						"stepId": 7010206,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"乌尔班"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701020201,
					"content": "关于这枚「牙齿」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701020202
					]
				},
				{
					"id": 701020202,
					"content": "牙齿？什么牙齿，你是在雪山上面捡到了什么乱七八糟的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020203
					],
					"speakerTitle": "乌尔班"
				},
				{
					"id": 701020203,
					"content": "咦？这枚牙齿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020204
					],
					"speakerTitle": "乌尔班"
				},
				{
					"id": 701020204,
					"content": "怎，怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701020205
					]
				},
				{
					"id": 701020205,
					"content": "这枚牙齿的质地，看起来很不错，韧性也很足…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020206
					],
					"speakerTitle": "乌尔班"
				},
				{
					"id": 701020206,
					"content": "还有这个断面…简直就像是「龙牙」嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020207
					],
					"speakerTitle": "乌尔班"
				},
				{
					"id": 701020207,
					"content": "龙牙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701020208
					]
				},
				{
					"id": 701020208,
					"content": "就是龙的牙齿。据说用龙牙打造的武器会格外坚硬锋利…而且还会有奇异的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020209
					],
					"speakerTitle": "乌尔班"
				},
				{
					"id": 701020209,
					"content": "不过，龙牙可不是能随便捡到的东西，传说里那些取得了龙牙，并且用龙牙锻造出武器的人，本身都是赫赫有名的大英雄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020210
					],
					"speakerTitle": "乌尔班"
				},
				{
					"id": 701020210,
					"content": "哈哈哈，就像那句话说的，如果手上没有能够击败巨龙的武器，又怎么能击败巨龙拿到龙牙呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020211
					],
					"speakerTitle": "乌尔班"
				},
				{
					"id": 701020211,
					"content": "那这枚「牙齿」是龙牙吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701020212
					]
				},
				{
					"id": 701020212,
					"content": "说实话，我没有经手过龙牙这种材料，也没法下判断。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020213
					],
					"speakerTitle": "乌尔班"
				},
				{
					"id": 701020213,
					"content": "我是觉得，这枚「牙齿」大概是什么巨兽的牙齿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020214
					],
					"speakerTitle": "乌尔班"
				},
				{
					"id": 701020214,
					"content": "但既然你费了这么大功夫把这枚「牙齿」拿过来，我们就权当它是一枚珍贵的「龙牙」好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020215
					],
					"speakerTitle": "乌尔班"
				},
				{
					"id": 701020215,
					"content": "唔…但这一枚应该不够打造武器。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020216
					],
					"speakerTitle": "乌尔班"
				},
				{
					"id": 701020216,
					"content": "你再去搜集大概…三枚这样的「牙齿」过来吧，我也会去查一下资料，看看处理它们的方法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020217
					],
					"speakerTitle": "乌尔班"
				},
				{
					"id": 701020217,
					"content": "对了，除了这些<color=#00E1FFFF>「牙齿」</color>之外，还得弄些好矿石来辅助…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020218
					],
					"speakerTitle": "乌尔班"
				},
				{
					"id": 701020218,
					"content": "唔，你去雪山上的时候，顺便再采五十份<color=#00E1FFFF>「星银矿石」</color>来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020220
					],
					"speakerTitle": "乌尔班"
				},
				{
					"id": 701020220,
					"content": "除了这些之外…我还需要一把<color=#00E1FFFF>「北陆长柄武器原胚」</color>…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020219
					],
					"speakerTitle": "乌尔班"
				},
				{
					"id": 701020219,
					"content": "把这些东西搜集好了之后，你就都拿来给我吧。",
