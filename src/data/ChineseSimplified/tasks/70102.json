			"trigger": {
				"objectNames": [
					"玉霞"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701020102,
					"content": "关于这枚「牙齿」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701020103
					]
				},
				{
					"id": 701020103,
					"content": "牙齿？请给我看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020104
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701020104,
					"content": "唔…这种形状和尺寸，确实有些不同寻常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020105
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701020105,
					"content": "我对这类材料并不是太了解…但乌尔班为了锻造武器经手过许多材料，也许他会知道些什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020106
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701020106,
					"content": "你可以去问问他，他就在旁边，很容易就能找到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玉霞"
				}
			]
		},
		{
			"id": 7010202,
			"completionStepIds": [
				7010207
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
