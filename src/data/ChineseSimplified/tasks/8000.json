			"trigger": {
				"objectNames": [
					"甘雨"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80000101,
					"content": "是的，是的。我知道他们什么都敢碰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000102
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 80000102,
					"content": "七神、魔神、恶龙…就连带上这些背景的古物，他们也没有不敢下手的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000103
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 80000103,
					"content": "但这一次，是谁给他们的胆子，去动深渊教团的东西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000104
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 80000104,
					"content": "啊，旅行者，是你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000105
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 80000105,
					"content": "咦？甘雨怎么在岚姐这里？是要发布什么委托吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80000106,
					"content": "#你好，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000107
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 80000107,
					"content": "我们刚才在聊盗宝团的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000108
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 80000108,
					"content": "嗯，我们刚才谈到，即使是什么都敢碰的盗宝团，原本也都知道，最好别去接触「深渊」——因为那实在太邪门了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000109
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 80000109,
					"content": "但我最近从总务司接到情报，蒙德璃月一带的盗宝团南北两大巨头，正准备联合起来做一件大事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000110
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 80000110,
					"content": "盗宝团…南北两大巨头？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80000111,
					"content": "嗯，江湖人称「南长姊」，「北怪鸟」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000112
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 80000112,
					"content": "啊，「怪鸟」！我有印象，他在蒙德和安柏交过手…但「南长姊」是谁呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000113,
						80000114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80000113,
					"content": "长姊的意思，是最大的姐姐吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000116
					]
				},
				{
					"id": 80000116,
					"content": "没错，璃月一带的盗宝团首领，据我所知，那伙人都称她为「大姐头」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000117
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 80000117,
					"content": "也有人说她的手艺得到过盗宝之神的恩赐，所以是「神之长姊」…但这大概只是以讹传讹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000118
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 80000118,
					"content": "总而言之，盗宝团发现一座无人发掘过的遗迹，这座遗迹暗中被深渊教团严密守护着。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000119
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 80000119,
					"content": "虽然这是非常危险的征兆，但以盗宝团的思维，只会觉得有宝物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000120
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 80000120,
					"content": "他们制定了计划，派一批炮灰引开深渊教团的兵力，然后只靠一位最精英的专家深入遗迹，取宝逃离。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000121
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 80000121,
					"content": "为此，据说「大姐头」和「怪鸟」从枫丹请来了一位「大盗宝家」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000122
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 80000122,
					"content": "「大盗宝家」？是个听起来很有气势的称号呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80000123,
					"content": "是的，那是一位非常传奇的人物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000124
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 80000124,
					"content": "所谓「大盗宝家」，在盗宝团的地位，等同于我们冒险家心目中的「大冒险家」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000125,
						80000127
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 80000125,
					"content": "比如大冒险家艾莉丝女士？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000126
					]
				},
				{
					"id": 80000126,
					"content": "你们也知道那位《提瓦特游览指南》的作者吗？没错，「大盗宝家」的地位和她一样，就是如此崇高。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000129
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 80000129,
					"content": "所以即使是附近一带的盗宝团南北两大巨头，也要千方百计把他请来，拜托他亲自坐镇整个盗宝计划。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000130
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 80000130,
					"content": "最近璃月遭逢巨变，总务司和千岩军都过于忙碌，没空应对这种道听途说的盗宝团行动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000131
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 80000131,
					"content": "但，以我的直觉，与「深渊」相关的事物，都潜藏着未知的威胁…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000132
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 80000132,
					"content": "所以，我就想来冒险家协会挂个委托。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000133,
						80000134
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 80000133,
					"content": "既然刚好路过…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000135
					]
				},
				{
					"id": 80000135,
					"content": "嗯，那这个委托我们就接下啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000136
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80000136,
					"content": "啊，非常感谢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000137
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 80000137,
					"content": "不错，真是可靠的协会会员。那么，一路顺风，委托的细节就由协会来处理吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "岚姐"
				},
				{
					"id": 80000134,
					"content": "我也明白「深渊」的危害。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000135
					]
				},
				{
					"id": 80000127,
					"content": "比如大冒险家斯坦利先生？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000128
					]
				},
				{
					"id": 80000128,
					"content": "哦？你们难道在蒙德见过那位前辈高人吗？没错，「大盗宝家」的地位和他一样，就是如此崇高。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000129
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 80000114,
					"content": "是盗宝团口中的「大姐头」吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000115
					]
				},
				{
					"id": 80000115,
					"content": "你知道得不少嘛，看来是和盗宝团打过很多交道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000116
					],
					"speakerTitle": "岚姐"
				}
			]
		},
		{
			"id": 800002,
			"completionStepIds": [
				800004
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800004",
							"2"
						],
						"stepId": 800004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"(test)大盗宝家",
					"(test)大盗宝家"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80000201,
					"content": "这…好像是个人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80000202,
					"content": "难道是…「大盗宝家」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80000203,
					"content": "这个姿势…他在对什么东西「祈祷」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80000204,
					"content": "？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80000205,
					"content": "那…那是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000206,
						80000207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80000206,
					"content": "是…七天神像？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000208
					]
				},
				{
					"id": 80000208,
					"content": "为，为什么七天神像…会被这样倒挂…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80000209,
					"content": "而且，神像手里…我记得…本来应该捧着一颗宝珠吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80000210,
					"content": "现在…神像手里捧着的…是什么…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80000211,
					"content": "呜…好压抑…感觉非常不妙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80000212,
					"content": "那个「大盗宝家」也是一动不动的样子，难，难道说，已经…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80000213,
					"content": "喂，你还好吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80000214,
					"content": "（没有一丝反应，也听不到呼吸声。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000215
					],
					"speakerTitle": "(test)大盗宝家"
				},
				{
					"id": 80000215,
					"content": "…他，他死了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80000216,
					"content": "#{NICKNAME}，我…感觉很不好。",
