				"points": []
			},
			"dialogs": [
				{
					"id": 230360101,
					"content": "凯万先生，你就再用新型的鱼饵试试吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360102
					],
					"speakerTitle": "荷贝特"
				},
				{
					"id": 230360102,
					"content": "我都试了多少次了，完全和之前一样嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360103
					],
					"speakerTitle": "凯万"
				},
				{
					"id": 230360103,
					"content": "咦？你们两个怎么又在一起钓鱼了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230360104,
					"content": "旅行者，又见面了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360105
					],
					"speakerTitle": "凯万"
				},
				{
					"id": 230360105,
					"content": "两位，你们好啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360106,
						230360107
					],
					"speakerTitle": "荷贝特"
				},
				{
					"id": 230360106,
					"content": "你找到钓不上鱼的原因了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230360108
					]
				},
				{
					"id": 230360108,
					"content": "哈哈，完全没有。我和那位学者先生尝试了改进鱼竿，改进鱼饵，改进手法各种方式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360109
					],
					"speakerTitle": "凯万"
				},
				{
					"id": 230360109,
					"content": "还换了不知道多少个水域，多少个角度…甚至还让我在一个全都是鱼的鱼池里下竿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360110
					],
					"speakerTitle": "凯万"
				},
				{
					"id": 230360110,
					"content": "但我无论如何，都只能钓起来那些不是鱼的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360111
					],
					"speakerTitle": "凯万"
				},
				{
					"id": 230360111,
					"content": "放心啦，凯万先生，那位学者不也承诺会继续研究下去吗？他一定会帮你找到原因的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360112
					],
					"speakerTitle": "荷贝特"
				},
				{
					"id": 230360112,
					"content": "你看，他都给你设计了新型鱼饵，还让我一直陪在你身边，记录你钓鱼的各种细节…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360113
					],
					"speakerTitle": "荷贝特"
				},
				{
					"id": 230360113,
					"content": "希望他真的能找到吧…但在那之前，我还是按照自己的方法来钓鱼好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360114
					],
					"speakerTitle": "凯万"
				},
				{
					"id": 230360114,
					"content": "旅行者，如果你有空的话，就再帮我去找点鱼饵材料吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凯万"
				},
				{
					"id": 230360107,
					"content": "去向学者请教后有收获了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230360108
					]
				}
			]
		},
