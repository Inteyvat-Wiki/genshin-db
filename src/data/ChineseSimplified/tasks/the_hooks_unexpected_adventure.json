			"dialogs": [
				{
					"id": 230360601,
					"content": "很不错，接下来我就要下竿了，这次一定能钓上大鱼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360602
					],
					"speakerTitle": "凯万"
				},
				{
					"id": 230360602,
					"content": "凯万制作了鱼饵，开始垂钓…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230360603
					]
				},
				{
					"id": 230360603,
					"content": "不久后，凯万钓到了一个湿漉漉的盒子…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230360604
					]
				},
				{
					"id": 230360604,
					"content": "这个…我来看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360605
					],
					"speakerTitle": "荷贝特"
				},
				{
					"id": 230360605,
					"content": "咦？里面的东西…好像又是失物之类的东西呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360606,
						230360607
					],
					"speakerTitle": "荷贝特"
				},
				{
					"id": 230360606,
					"content": "不愧是你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230360608
					]
				},
				{
					"id": 230360608,
					"content": "唔…自从上次陪着凯万先生去找那位学者改进鱼饵后，我们一直在外垂钓…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360609
					],
					"speakerTitle": "荷贝特"
				},
				{
					"id": 230360609,
					"content": "但每次垂钓…凯万先生还是一直钓起奇奇怪怪的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360610
					],
					"speakerTitle": "荷贝特"
				},
				{
					"id": 230360610,
					"content": "其中包括人的失物，河底的矿石，掉下船的包裹…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360611
					],
					"speakerTitle": "荷贝特"
				},
				{
					"id": 230360611,
					"content": "甚至还有一个不慎落水的冒险家抓着凯万先生的钓线爬上了岸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360612
					],
					"speakerTitle": "荷贝特"
				},
				{
					"id": 230360612,
					"content": "但是，我们就是没法钓起任何一条鱼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360613
					],
					"speakerTitle": "荷贝特"
				},
				{
					"id": 230360613,
					"content": "我的钓鱼生涯，已经彻底走到尽头了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360614
					],
					"speakerTitle": "凯万"
				},
				{
					"id": 230360614,
					"content": "凯，凯万先生！不要这么沮丧呀，你…你看，这东西的失主肯定很着急。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360615
					],
					"speakerTitle": "荷贝特"
				},
				{
					"id": 230360615,
					"content": "你能把这失物钓上来，他一定会很高兴的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360616
					],
					"speakerTitle": "荷贝特"
				},
				{
					"id": 230360616,
					"content": "我们把这些失物拿回去给冒险家协会，说不定还能拿到点报酬呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360617
					],
					"speakerTitle": "荷贝特"
				},
				{
					"id": 230360617,
					"content": "但是！我真的！只是想要——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360618
					],
					"speakerTitle": "凯万"
				},
				{
					"id": 230360618,
					"content": "钓上一条鱼啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凯万"
				},
