			},
			"dialogs": [
				{
					"id": 140240201,
					"content": "「仆人」…还有「公子」！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240202,
					"content": "喂，你不是回至冬养伤去了吗？怎么还在枫丹呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240203,
					"content": "噢，两位，没想到还能在这里再见面…咳咳、咳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240204
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 140240204,
					"content": "从原始胎海离开后，我昏迷了很久。再次醒来时，发现自己正被送往至冬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240205
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 140240205,
					"content": "这怎么行？我在枫丹还有没做完的事情。于是我强撑着爬起来，又一个人回来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240206
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 140240206,
					"content": "嗯？什么事情？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240207,
					"content": "关于「丝柯克」…我的师父。我很想见她一面，可惜等我回来的时候，她已经离开了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240208
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 140240208,
					"content": "我还有很多问题想问她。没办法，只好拜托「仆人」帮我查查师父的踪迹。她既然来了枫丹，应该会留下些蛛丝马迹才对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240209
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 140240209,
					"content": "原来如此，那你们找到什么线索了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240210,
					"content": "很遗憾。虽然壁炉之家可以搞定绝大部分情报，但面对那样的存在，我们也无可奈何。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240211
					],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 140240211,
					"content": "说到底，还是师父认为现在没有见我的必要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240212
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 140240212,
					"content": "不过这个问题也容易解决。只要我变得更强…咳咳、咳咳咳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240213
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 140240213,
					"content": "你还是先把伤养好再说吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240214,
					"content": "哈哈，我已经好得差不多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240215
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 140240215,
					"content": "多亏了壁炉之家。那个叫埃卢瓦尔的孩子配了些乱七八糟的药剂给我，喝了之后浑身都疼，但恢复速度确实快了不少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240216
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 140240216,
					"content": "这次真的要道别了。老爷子派人来催了，让我回去参加什么计划…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240217
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 140240217,
					"content": "「严冬计划」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240218
					],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 140240218,
					"content": "对对。唉，听说还有「富人」的事，我可不想回去听他的长篇大论。要不你想个办法，让我在枫丹多待一段时间？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240219
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 140240219,
					"content": "我还是觉得教林尼他们武艺比较有趣，如果你能和我切磋一下就更好了，我还没见过你全力以赴的样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240220
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 140240220,
					"content": "想多了。我也在接下来的计划中，用不了多久就会从这里离开。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240221
					],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 140240221,
					"content": "再说，那些留在至冬的富商政要点名要你回去，不也是一种「荣耀」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240222
					],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 140240222,
					"content": "哈哈…饶了我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240223
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 140240223,
					"content": "感觉这两个人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240224,
					"content": "一本正经地在背后议论同事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140240225
					]
				},
				{
					"id": 140240225,
					"content": "所以，两位壁炉之家的「客人」，来找我做什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240226
					],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 140240226,
					"content": "啊…这个…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240227
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240227,
					"content": "想多了解一下壁炉之家的「父亲」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140240228
					]
				},
				{
					"id": 140240228,
					"content": "没错！我们跟林尼他们已经很熟了，反倒是对你还不怎么了解呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240229
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240229,
					"content": "是吗？我记得自己做过自我介绍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240230
					],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 140240230,
					"content": "那种简短的自我介绍有什么用啦，起码告诉我们，为什么你要自称「父亲」吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240231
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240231,
					"content": "哦，好问题！我其实也想知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240232
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 140240232,
					"content": "既然你们都不知道，说明我们的情报工作做得很好，应该继续保持下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240233
					],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 140240233,
					"content": "不愧是外交官啊，轻易就化解了我们的进攻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240234
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 140240234,
					"content": "没事的话，我就先回去了，家里还有件麻烦事要处理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240235
					],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 140240235,
					"content": "欸…欸！等一下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240236
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240236,
					"content": "（如果「仆人」就这么回去的话，可能会正好撞上林尼和克雷薇…！）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140240237
					]
				},
				{
					"id": 140240237,
					"content": "（要放飞林尼的魔术飞鸟吗？不，在那之前，先试着寻找一些别的话题吧。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140240238,
						140240239
					]
				},
				{
					"id": 140240238,
					"content": "关于壁炉之家…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140240240
					]
				},
				{
					"id": 140240240,
					"content": "哦，这个问题我也有点好奇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240241
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 140240241,
					"content": "我和壁炉之家那些孩子们接触过，他们都是些好孩子。见到他们，我就会想起冬妮娅和托克。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240242
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 140240242,
					"content": "如果有一天你「背叛」了他们，我一定会找你打一架。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240243
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 140240243,
					"content": "我为什么会背叛他们？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240244
					],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 140240244,
					"content": "我听说你已经背叛过一次「壁炉之家」了，不知道是真是假。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240245
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 140240245,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240246
					],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 140240246,
					"content": "好吧，我承认，是老爷子…就是「公鸡」告诉我的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240247
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 140240247,
					"content": "（背叛…难道说克雷薇说的是真的吗？「仆人」她把壁炉之家的孩子当做实验品？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140240248
					]
				},
				{
					"id": 140240248,
					"content": "你，你真的对那些孩子做过什么坏事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240249
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240249,
					"content": "比起我做过什么，我更想听听伟大的「公鸡」先生是如何评价我的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240250
					],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 140240250,
					"content": "我想想啊，大致就是干掉了许多「同伴」、最后还对「亲人」动手之类的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240251
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 140240251,
					"content": "哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240252
					],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 140240252,
					"content": "看你的反应，这些传闻是假的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240253
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 140240253,
					"content": "不，虽然这种表述我不太喜欢，但也算是事实。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240254
					],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 140240254,
					"content": "严格来讲，算是某种偏见。我暂时不打算澄清，偏见会将真相包裹起来，对我来说是一件好事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240255
					],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 140240255,
					"content": "就像我经常自称「枫丹人」，但我只是在枫丹长大而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240256
					],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 140240256,
					"content": "啊？？你、你不是枫丹人吗？那你为什么要帮枫丹度过危机？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240257
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240257,
					"content": "在枫丹做事，这个身份比较好用，不会被怀疑是别有用心。谁不想拯救自己的家乡呢？我真正想要保护的，是那些出身枫丹的孩子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240258
					],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 140240258,
					"content": "原始胎海对我没有影响，但会给壁炉之家带来损失。希望我透露的信息可以满足你们的好奇心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240259
					],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 140240259,
					"content": "（仆人主动聊起自己的秘密，将话题从「背叛壁炉之家」上引开了。她似乎还不愿意提起自己的过去…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140240260
					]
				},
				{
					"id": 140240260,
					"content": "既然你为了他们留在枫丹，那我相信你不会背叛那些「孩子们」…抱歉，之前我对你的看法有些偏颇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240261
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 140240261,
					"content": "我说了，这是一件好事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240262
					],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 140240262,
					"content": "说起来，在壁炉之家养伤的时候，我还听说了一件很对我胃口的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240263
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 140240263,
					"content": "据说在壁炉之家，每次家人出现争执的时候就会打一场，输的一方要主动做出让步。那岂不是可以经常光明正大地切磋？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240264
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 140240264,
					"content": "你说的是近些年的事情，更早的时候可没有这么美好，输的一方会失去一切，包括自己的生命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240265
					],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 140240265,
					"content": "这么危险！幸亏改掉了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240266
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240266,
					"content": "现在的氛围我很喜欢，或者说有点羡慕。你有这么多家人，而且可以和他们生活在一起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240267
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 140240267,
					"content": "家人太多，就会开始吵闹，开始勾心斗角。等冬妮娅和托克都进入叛逆期，你就明白这种感受了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240268
					],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 140240268,
					"content": "想象一下：托克迷上了拔「公鸡」的胡子，冬妮娅把自己的头发染出四十二种颜色…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240269
					],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 140240269,
					"content": "停停，我完全能够理解了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240270
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 140240270,
					"content": "聊到冬妮娅和托克，「公子」立刻打开话匣子，滔滔不绝地讲起故事。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						140240271
					]
				},
				{
					"id": 140240271,
					"content": "往常听到最后可能会打瞌睡，这次却由衷地感谢他帮忙拖延了时间。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						140240272
					]
				},
				{
					"id": 140240272,
					"content": "一晃都到这个时间了，我该走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240273
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 140240273,
					"content": "#{NICKNAME}、派蒙，下次不知道会在哪里再见。到时候有机会的话，我们再比试一番…咳咳、咳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240274
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 140240274,
					"content": "都说啦，你还是先把伤养好再说吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240275
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240275,
					"content": "好、好。还有，这次多谢你了，阿蕾奇诺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240276
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 140240276,
					"content": "不客气，拿到神之心有你的一份贡献，我们互不相欠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240277
					],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 140240277,
					"content": "这样也不错。那我走了，下次再会，各位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240278
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 140240278,
					"content": "我们也走吧…你要跟我们一起回去吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240279
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240279,
					"content": "怎么，你们希望我现在就走？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240280
					],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 140240280,
					"content": "啊…这个…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240281
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240281,
					"content": "晚风很舒适，我留下来思考一些事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240282
					],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 140240282,
					"content": "招待不周，敬请谅解。希望你们住得开心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 140240239,
					"content": "你是怎么看待壁炉之家的呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140240240
					]
				}
			]
		},
		{
			"id": 1402403,
