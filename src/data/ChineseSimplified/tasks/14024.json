					{
						"sceneId": 3,
						"position": [
							2806.954,
							362.412,
							4146.17
						],
						"pointId": 340300431
					},
					{
						"sceneId": 3,
						"position": [
							2806.94,
							362.234,
							4147.252
						],
						"pointId": 340300432
					}
				]
			},
			"dialogs": [
				{
					"id": 140240301,
					"content": "林尼！怎么样，有什么进展吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240302,
					"content": "说来话长，我这边遇到了一点麻烦——克雷薇没办法去有阳光的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240303
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240303,
					"content": "什么意思？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140240304
					]
				},
				{
					"id": 140240304,
					"content": "我让她跟在我身旁，然后带她到地面上。最开始一切都很顺利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240305
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240305,
					"content": "但是当我领着她穿过阴影，走入阳光的时候，我突然发现她不见了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240306
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240306,
					"content": "回过头，就看到她停留在阴影的边缘，静静地望着我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240307
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240307,
					"content": "难道她害怕阳光吗？不对不对，如果是这样的话，她就不会提出「在阳光下生活」的愿望了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240308,
					"content": "呃…要不推她一下试试？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240309,
					"content": "能推的话就不叫「亡魂」了吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140240310
					]
				},
				{
					"id": 140240310,
					"content": "也对哦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240311,
					"content": "总之，我尝试了各种方法，都没能成功。眼见太阳落山，我只能先带着克雷薇回来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240312
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240312,
					"content": "琳妮特，你那边情况怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240313
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240313,
					"content": "我拿到名单了，在这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240314
					],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 140240314,
					"content": "真的吗？快让我看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240315,
					"content": "居然有这么多！要完整看完要花多长时间呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240316,
					"content": "我们分一分吧，每人看一部分，给。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240317
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240317,
					"content": "拉普亚德…朗杜瓦…让贝尔…奥尔内…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240318,
					"content": "呜哇，这个奥尔内脸上有好深的疤痕，看上去就是个很可怕的家伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240319,
					"content": "哦，我跟他接触过。他是某次执行任务的时候受的伤，当时他还跟我开玩笑，说以后要被爱人嫌弃了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240320
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240320,
					"content": "那你怎么说？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240321
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240321,
					"content": "我问他有爱人吗，他说没有，聊天到这里就结束了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240322
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240322,
					"content": "后来我听说他真的喜欢上了一个人，为了她不惜从家里逃跑，但没能成功。有一天他被「父亲」叫出去…之后我就再也没有见过他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240323
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240323,
					"content": "也就是说，他被「仆人」给…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240324
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240324,
					"content": "虽然残酷，但这就是家的规矩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240325
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240325,
					"content": "在壁炉之家，每个人都知道太多秘密，所以这里容不下背叛。想从家里离开，必须付出生命的代价。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240326
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240326,
					"content": "众人怀着沉重的心情看完了处刑名单，但里面并没有克雷薇的名字。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						140240327
					]
				},
				{
					"id": 140240327,
					"content": "没有啊…这也在预料之中。这份名单并不完整，只有近五年的记录。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240328
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240328,
					"content": "还是从别的地方入手吧，菲米尼，你打听到什么情报了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240329
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240329,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240330
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 140240330,
					"content": "菲米尼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240331
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240331,
					"content": "抱歉，我刚刚在想事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240332
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 140240332,
					"content": "我认真地跟其他人聊了聊，感觉家里的气氛有点奇怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240333
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 140240333,
					"content": "奇怪？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240334
					],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 140240334,
					"content": "嗯。其实以前，家里就有许多争吵。比如沙普洛和菲约尔之间…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240335
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 140240335,
					"content": "是我们分发物资的时候见过的那些人吗？他们看起来确实不太一样，聊的话题也完全不同…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240336
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240336,
					"content": "很简单。「父亲」将我们带到壁炉之家，教我们知识和武艺，但并非每个人都发自内心地想留在这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240337
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240337,
					"content": "在加入壁炉之家后，我们就带上了「愚人众」的标签。在很多人看来，这并非是一个光明正大的身份。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240338
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240338,
					"content": "随着年龄增长，一部分人的心里有了别的想法。只是囿于壁炉之家的规矩，不敢轻易开口。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240339
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240339,
					"content": "沙普洛、福尔茨他们更拥护和认可「父亲」，以身为愚人众为傲。而在菲约尔、南特伊心里，这种感情要平淡许多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240340
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240340,
					"content": "这种矛盾一直都存在，「父亲」应该也知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240341
					],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 140240341,
					"content": "但我觉得情况好像变严重了。菲约尔他们…似乎私下里会聚在一起聊什么东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240342
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 140240342,
					"content": "虽然只是我的猜测，但我觉得他们应该见过克雷薇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240343
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 140240343,
					"content": "你觉得克雷薇在煽动他们？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240344
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240344,
					"content": "不像，但克雷薇可能跟他们说了一些「家里不为人知的黑暗」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240345
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 140240345,
					"content": "她也跟我说过这些，比如拿孩子们做实验、强迫没有力量的人上战场…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240346
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 140240346,
					"content": "菲约尔他们相信了？这些事完全没有证据。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240347
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240347,
					"content": "我觉得他们未必相信，但克雷薇的话提供了一个借口。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240348
					],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 140240348,
					"content": "唉…根源还是在「严冬计划」上吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240349
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240349,
					"content": "等一下，你们讲慢点啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240350
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240350,
					"content": "「仆人」好像也提到了「严冬计划」，这个到底是什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240351
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240351,
					"content": "抱歉，具体内容我也不了解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240352
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240352,
					"content": "我只是听「父亲」说过，是由「公鸡」与「富人」两位执行官联手推动的计划，涉及到愚人众接下来的战略安排。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240353
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240353,
					"content": "因为顺利拿到了神之心，壁炉之家得到了嘉奖，并将在严冬计划中承担非常重要的工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240354
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240354,
					"content": "这对你们来说不是好事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240355
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240355,
					"content": "「重要」等同于「危险」，对我们来说是很大的麻烦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240356
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240356,
					"content": "「父亲」也很头疼，但又没法拒绝。他们的计划合情合理，甚至给我们调拨了大量经费。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240357
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240357,
					"content": "但是——按照这个计划执行，我们会牺牲很多人。这也算一种变相打压，他们对不受掌握的情报部门感到不安。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240358
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240358,
					"content": "（看来愚人众内部正在策划什么大事。不过林尼他们对此并不知情，打听不到太多情报。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140240359
					]
				},
				{
					"id": 140240359,
					"content": "（今后和愚人众接触的时候，仔细观察一下吧。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140240360
					]
				},
				{
					"id": 140240360,
					"content": "没想到愚人众内部这么复杂，不过这和你们家里的矛盾有什么关系吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240361
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240361,
					"content": "外界的压力会加速内部的分化。死亡的恐惧压在心头，可能会让一些人做出错误的举动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240362
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240362,
					"content": "我本来以为解决克雷薇的事情，一切就可以恢复正常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240363
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240363,
					"content": "现在看来情况比我预想的更麻烦。如果放任菲约尔他们不管，「父亲」迟早会对他们动手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240364
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240364,
					"content": "哥哥，我们只能做好眼前的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240365
					],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 140240365,
					"content": "也是。现在去找菲约尔他们，一时间也不会有什么结果，反倒会适得其反。还是先想办法送别克雷薇吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240366
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240366,
					"content": "今天很晚了，我们先各自去休息。明天太阳升起，立刻出发。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240367
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240367,
					"content": "琳妮特，这次你跟我一起去外面。菲米尼，拜托你盯着菲约尔他们，尽量不要让他们做错事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240368
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240368,
					"content": "今天辛苦大家了。晚安，明天再见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "林尼"
				}
			]
		},
