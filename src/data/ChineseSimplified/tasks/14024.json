						140240602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240602,
					"content": "嘘…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240603
					],
					"speakerTitle": "克雷薇"
				},
				{
					"id": 140240603,
					"content": "趁没有人盯着，我把窗户打开了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240604
					],
					"speakerTitle": "克雷薇"
				},
				{
					"id": 140240604,
					"content": "你们看，外面的景色很漂亮吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240605,
						140240606
					],
					"speakerTitle": "克雷薇"
				},
				{
					"id": 140240605,
					"content": "窗户？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140240607
					]
				},
				{
					"id": 140240607,
					"content": "只可惜，这就是我能做的极限了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240608
					],
					"speakerTitle": "克雷薇"
				},
				{
					"id": 140240608,
					"content": "在你们眼中，我所做的事情是不是很可笑呢？相较于这种看不到希望的反抗，还是生活在美好的梦里比较轻松。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240609
					],
					"speakerTitle": "克雷薇"
				},
				{
					"id": 140240609,
					"content": "克雷薇，你到底知道什么呀？能和我们具体说说吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240610
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240610,
					"content": "可以呀，虽然你们可能会后悔听到这些事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240611
					],
					"speakerTitle": "克雷薇"
				},
				{
					"id": 140240611,
					"content": "包括我在内，这个家里的所有人都只是「工具」与「消耗品」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240612
					],
					"speakerTitle": "克雷薇"
				},
				{
					"id": 140240612,
					"content": "有利用价值的人暂时留着，没有价值的人，被送给「博士」做实验。我亲眼见过许多人生不如死的模样，我已经受够了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240613
					],
					"speakerTitle": "克雷薇"
				},
				{
					"id": 140240613,
					"content": "你说的这些都是「仆人」做的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240614
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240614,
					"content": "我觉得不像吧。虽说她看起来很可怕，但好像也没坏到这个程度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240615
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240615,
					"content": "嗯，我知道你们不会相信我的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240616
					],
					"speakerTitle": "克雷薇"
				},
				{
					"id": 140240616,
					"content": "每个人都觉得她是个好人，都觉得她是一位真正的「母亲」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240617
					],
					"speakerTitle": "克雷薇"
				},
				{
					"id": 140240617,
					"content": "「母亲」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240618
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240618,
					"content": "可她玷污了这个称呼。如果可以，我永远都不想再见到她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240619
					],
					"speakerTitle": "克雷薇"
				},
				{
					"id": 140240619,
					"content": "假如佩佩在这里就好了，她一定能明白我的想法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240620
					],
					"speakerTitle": "克雷薇"
				},
				{
					"id": 140240620,
					"content": "佩佩…又是这个名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240621
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240621,
					"content": "#说起来，{NICKNAME}，你有没有一种奇怪的感觉？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240622
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240622,
					"content": "她和我们之间就好像隔着什么东西一样。她真的是在和我们说话吗，还是把我们错认成了别人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240623,
						140240624
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240623,
					"content": "我也想不明白。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140240625
					]
				},
				{
					"id": 140240625,
					"content": "好吧，不过我感觉她好像很愿意向我们倾诉，不如我们就多陪她一会儿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240626
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240626,
					"content": "她看起来年龄很小，不过心里好像藏着许多事呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240627
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240627,
					"content": "起风了，该关上窗了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240628
					],
					"speakerTitle": "克雷薇"
				},
				{
					"id": 140240628,
					"content": "月色很漂亮吧？悄悄告诉你们哦，据说至冬夜里的极光，比今晚的月亮还要美丽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240629
					],
					"speakerTitle": "克雷薇"
				},
				{
					"id": 140240629,
					"content": "真想看看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140240630
					]
				},
				{
					"id": 140240630,
					"content": "我跟佩佩约好了，长大后一起去看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240631
					],
					"speakerTitle": "克雷薇"
				},
				{
					"id": 140240631,
					"content": "可我最近找不到佩佩了。难道说她也被…不对，她是「特别」的，母亲很喜欢她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240632
					],
					"speakerTitle": "克雷薇"
				},
				{
					"id": 140240632,
					"content": "我得去找母亲大人谈谈。但我们刚吵了架，她不想见我，我也不敢见她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240633
					],
					"speakerTitle": "克雷薇"
				},
				{
					"id": 140240633,
					"content": "我到底该怎么做…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240634
					],
					"speakerTitle": "克雷薇"
				},
				{
					"id": 140240634,
					"content": "之后，克雷薇像是陷入思考。她静静地站在那里不再说话。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						140240635
					]
				},
				{
					"id": 140240635,
					"content": "许久后，克雷薇才回过神，虚弱地笑了一下，独自走了回去。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						140240636
					]
				},
				{
					"id": 140240636,
					"content": "呼…真是搞不懂她在想什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240637
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240637,
					"content": "我们也回去吧，明天还要早起呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240624,
					"content": "毕竟是难以理解的「亡魂」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140240625
					]
				},
				{
					"id": 140240606,
					"content": "这里什么也没有吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140240607
					]
				}
			]
		}
	]
}