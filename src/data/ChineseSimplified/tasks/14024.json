			"dialogs": [
				{
					"id": 140240413,
					"content": "各种各样的事情萦绕在心里，始终无法入眠…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 140240401,
					"content": "呼哇…说着要早点睡，结果完全睡不着…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240402,
					"content": "你说，「仆人」如果知道了林尼他们做的事，会不会很生气？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240403,
					"content": "她平时笑着的时候，我就觉得有点吓人。要是她发起火来…呜呜，到时候你一定要保护我呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240404,
						140240406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240404,
					"content": "其实我也有点怕…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140240405
					]
				},
				{
					"id": 140240406,
					"content": "放心躲在我身后就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140240407
					]
				},
				{
					"id": 140240405,
					"content": "你也有同样的感觉吗？那、那到时候我们一起逃跑吧！拉着林尼他们，有多快跑多快！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240407,
					"content": "嘿嘿，我就知道你靠得住！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240408,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240409,
					"content": "你你、你快看那边！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240410,
						140240411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240410,
					"content": "克雷薇？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140240412
					]
				},
				{
					"id": 140240411,
					"content": "她怎么跑出来了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140240412
					]
				},
				{
					"id": 140240412,
					"content": "要是被人发现就糟糕了…我们快跟上去看看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
