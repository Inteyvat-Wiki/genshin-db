			"dialogs": [
				{
					"id": 140232201,
					"content": "克雷薇，我想带你去个地方。你愿意跟我一起来吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140232202
					],
					"speakerTitle": "林尼"
				},
				{
