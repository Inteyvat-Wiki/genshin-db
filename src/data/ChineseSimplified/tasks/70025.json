				"points": []
			},
			"dialogs": [
				{
					"id": 700250101,
					"content": "您好，冒险家！关于委托的完成情况我都已经了解了，感谢您为冒险家协会的付出！这里是您应得的报酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250102
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 700250102,
					"content": "虽然没能捕获那个奇怪的丘丘人，也没能找到这次骚乱的原因…但野外的安全至少得到了保障，辛苦您了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250103
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 700250103,
					"content": "顺便一提，艾拉·马斯克小姐在图书馆等您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凯瑟琳"
				}
			]
		},
		{
