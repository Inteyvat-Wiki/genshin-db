				"points": []
			},
			"dialogs": [
				{
					"id": 700250201,
					"content": "Homu…mimi tomo…唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250202
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 700250202,
					"content": "你好？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700250203
					]
				},
				{
					"id": 700250203,
					"content": "Ya ika！！啊…是你们啊…吓我一跳…请不要打扰我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250204
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 700250204,
					"content": "欸，不是你叫我们来的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700250212,
					"content": "嗯？哦哦…是你们啊！多谢你们的帮助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250205
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 700250205,
					"content": "不过手册中的内容准确吗？能够用来与丘丘人和平交流吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250206,
						700250207
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 700250206,
					"content": "举手之劳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700250208
					]
				},
				{
					"id": 700250208,
					"content": "哼哼，我的词典工作又前进了一大步！人类能与丘丘人和平共存的论据又增加了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250209
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 700250209,
					"content": "只可惜没能和那个奇怪的丘丘人搭上话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250210
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 700250210,
					"content": "从我收集的语料来看，或许它也只是很想在这片陌生的大地上结交新朋友吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250213
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 700250213,
					"content": "没能好好交流，真是遗憾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250214
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 700250214,
					"content": "啊，顺便，这里是给你的谢礼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250215
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 700250215,
					"content": "先前麻烦了你们那么多，实在不好意思。有机会还希望能够一起合作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250211
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 700250211,
					"content": "什么嘛，原来这家伙还是会好好说话的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700250207,
					"content": "我还是更喜欢自己的方式。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700250208
					]
				}
			]
		}
	]
