					"泽维尔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721180101,
					"content": "终于！全部完成了，幸好我还记得那些制作规范…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180102
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721180102,
					"content": "要进去净化那些「祟神」了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721180103
					]
				},
				{
					"id": 721180103,
					"content": "我是很想直接进去彻底了结这件事，但对付「祟神」的时候可不能掉以轻心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180104
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721180104,
					"content": "而且，因为有些材料实在找不到，只能拿另外的材料临时替代，所以这架装置的可靠性有些…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180105
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721180105,
					"content": "呃…应该这么说，「在某些情况下，存在无法达到预期运行状态的情况」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180106
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721180106,
					"content": "虽然正常使用应该是没问题，但以这架装置的状态，应该不太经得起意外情况，要是遇见点颠簸，说不定连零件都会颠出来几个…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180107
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721180107,
					"content": "所以，在把这位新伙计运进去干活之前，我们还得做点准备工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180108
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721180108,
					"content": "我想请您先去「御影炉心」附近，记录一下数据。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180109,
						721180111
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721180109,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721180110
					]
				},
				{
					"id": 721180110,
					"content": "那就拜托您了，我就在这里等着您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721180111,
					"content": "这么谨慎的吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721180112
					]
				},
				{
					"id": 721180112,
					"content": "那当然了。我还是略过了很多步骤，要是弗洛瓦先生来，按他的流程，我们至少还得多花一周。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180113
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721180113,
					"content": "总之，这次我们就特事特办吧，反正我代表特别评议小组…现在我授权我们，依照现场状况见机行事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "泽维尔"
				}
			]
		},
