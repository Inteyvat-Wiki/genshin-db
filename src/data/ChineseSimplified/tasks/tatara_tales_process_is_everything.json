				"points": []
			},
			"dialogs": [
				{
					"id": 721180401,
					"content": "太好了，让我看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180402
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721180402,
					"content": "我们的运气还不错，「御影炉心」的状态很稳定，而且周围的「祟神」能量也不算太浓重。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180403
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721180403,
					"content": "这种浓度的话，我的那架装置应该还能撑得住。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180404
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721180404,
					"content": "是要净化掉所有「祟神」能量吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721180405
					]
				},
				{
					"id": 721180405,
					"content": "这台装置如果能做到这种程度的事情的话，我早该提交专利申请了。这位新伙计顶多只能降低局部区域的能量指标而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180406
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721180406,
					"content": "不过，「御影炉心」之所以停机，连自动重启程序也无法执行，就是因为被高浓度的「祟神」能量包裹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180407
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721180407,
					"content": "只要我们去找到「祟神」浓度最高的地方，净化掉它，让核心重新运行起来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180408
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721180408,
					"content": "然后，「御影炉心」应该就会重启。再之后，就没有我们需要操心的事情了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180409
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721180409,
					"content": "这就是我全部的计划，在那之前，我还得再做些准备。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "泽维尔"
				}
			]
		},
