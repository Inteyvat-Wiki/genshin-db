			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761650101,
					"content": "唔…看起来是执灯人的墓碑呢。难道是我们在峡谷里见到的那群执灯士们的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761650102,
					"content": "他们忽闪忽闪的，突然出现又消失。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761650103,
					"content": "唔，真是搞不懂。下次去皮拉米达城问问吧！说不定那边有人知道这件事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7616502,
			"completionStepIds": [
				7616502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7616502",
							"2"
						],
						"stepId": 7616502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"帕托利切夫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761650201,
					"content": "哦，您好，我是帕托利切夫，执灯人物资事务官。您有何贵干？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650202
					],
					"speakerTitle": "帕托利切夫"
				},
				{
					"id": 761650202,
					"content": "「凛风之马」的帕托利切夫？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761650203
					]
				},
				{
					"id": 761650203,
					"content": "「凛风之马」…啊，就是之前我们看到那些奇怪的影子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761650204,
					"content": "#是的，{M#先生}{F#小姐}，那是我从前隶属的分队。「凛风之马」，真是让人怀念的名字，没想到居然会从您口中说出…您是怎么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650205,
						761650208
					],
					"speakerTitle": "帕托利切夫"
				},
				{
					"id": 761650205,
					"content": "我们之前去过苦壑崖下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761650206
					]
				},
				{
					"id": 761650206,
					"content": "没错没错，我们清理了那边出现的狂猎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761650207,
					"content": "而且我们还看到了「凛风之马」的执灯士，和狂猎战斗留下的影子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761650210,
					"content": "没想到居然是真的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650211
					],
					"speakerTitle": "帕托利切夫"
				},
				{
					"id": 761650211,
					"content": "当然是真的，我们可是亲眼看到的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761650212,
					"content": "啊…这些年，时不时有人告诉我，在苦壑崖看到过我已然牺牲的那些同僚的身影。所以直到现在，我也经常会到那去…顺便给他们扫扫墓。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650213
					],
					"speakerTitle": "帕托利切夫"
				},
				{
					"id": 761650213,
					"content": "但是我一次也没有…我一次也没有看到过他们，已经很久了，我以为那些不过是为了宽慰我而编造的谎话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650214
					],
					"speakerTitle": "帕托利切夫"
				},
				{
					"id": 761650214,
					"content": "没想到你们真的见到了他们…可为什么我去的时候，他们都不愿意出来见我呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650215,
						761650217
					],
					"speakerTitle": "帕托利切夫"
				},
				{
					"id": 761650215,
					"content": "或许还未到相见的时刻…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761650216
					]
				},
				{
					"id": 761650216,
					"content": "也许吧…但我知道他们真的在那，哪怕只是一丝回忆，一抹虚影，对我来说也已经足够…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650219
					],
					"speakerTitle": "帕托利切夫"
				},
				{
					"id": 761650219,
					"content": "#总之，感谢您，{M#先生}{F#小姐}，感谢您愿意告诉我，这对我来说真的很重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650220
					],
					"speakerTitle": "帕托利切夫"
				},
				{
					"id": 761650220,
					"content": "托他们的福，我现在才能站在此处，但我无比希望我能再次跟他们一同站在苦壑崖下，并肩作战。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650221
					],
					"speakerTitle": "帕托利切夫"
				},
				{
					"id": 761650221,
					"content": "…总有一日，总有一日我会与他们再会的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "帕托利切夫"
				},
				{
					"id": 761650217,
					"content": "也许并不想让你回忆起痛苦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761650218
					]
				},
				{
					"id": 761650218,
					"content": "唉…与他们并肩作战直到最后的那段时间，怎么会是痛苦的呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650219
					],
					"speakerTitle": "帕托利切夫"
				},
				{
					"id": 761650208,
					"content": "我们看到了「凛风之马」的执灯士…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761650209
					]
				},
				{
					"id": 761650209,
					"content": "没错，虽然他们只留下了一些影子…不过那些影子也保留着他们和狂猎作战的样子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650210
					],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}