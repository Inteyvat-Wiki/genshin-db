			"dialogs": [
				{
					"id": 230310601,
					"content": "好极了，材料齐全了，看我制作独一无二的鱼饵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310602
					],
					"speakerTitle": "凯万"
				},
				{
					"id": 230310602,
					"content": "凯万熟练地制作了鱼饵",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230310603
					]
				},
				{
					"id": 230310603,
					"content": "好，开始钓鱼了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310604
					],
					"speakerTitle": "凯万"
				},
				{
					"id": 230310604,
					"content": "鱼钩入水深度合格…水流速度适中…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310605
					],
					"speakerTitle": "凯万"
				},
				{
					"id": 230310605,
					"content": "你们要保持安静，水里的鱼可是很敏感的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310606
					],
					"speakerTitle": "凯万"
				},
				{
					"id": 230310606,
					"content": "岸边的脚步声也有可能惊动到它们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310607,
						230310608
					],
					"speakerTitle": "凯万"
				},
				{
					"id": 230310607,
					"content": "我站着不动。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310609
					]
				},
				{
					"id": 230310609,
					"content": "那你们就沉住气，安心等待吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310610
					],
					"speakerTitle": "凯万"
				},
				{
					"id": 230310610,
					"content": "凯万钓到了一袋湿漉漉的东西",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230310611
					]
				},
				{
					"id": 230310611,
					"content": "这是什么嘛，根本不是鱼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310612
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230310612,
					"content": "确实没见过这种「鱼」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310613
					]
				},
				{
					"id": 230310613,
					"content": "果然还是这样啊，完全不意外。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310614
					],
					"speakerTitle": "凯万"
				},
				{
					"id": 230310614,
					"content": "咳咳，异乡人，心态放宽点，别太计较细节问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310615
					],
					"speakerTitle": "凯万"
				},
				{
					"id": 230310615,
					"content": "鱼钩带出水面的东西，都可以被看成是钓上来的「鱼」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310616
					],
					"speakerTitle": "凯万"
				},
				{
					"id": 230310616,
					"content": "不瞒你说，我这最厉害的渔师可不是自封的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310617
					],
					"speakerTitle": "凯万"
				},
				{
					"id": 230310617,
					"content": "毕竟每次都钓上这种不会咬钩的，不算活物的东西，也算是一种本事吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310618
					],
					"speakerTitle": "凯万"
				},
				{
					"id": 230310618,
					"content": "其他渔师也都赞叹过我，说我有着独一无二的才能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310619,
						230310620
					],
					"speakerTitle": "凯万"
				},
				{
					"id": 230310619,
					"content": "他们可能是在安慰你…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310621
					]
				},
				{
					"id": 230310621,
					"content": "简单来说，就是除了鱼之外什么都钓的上来吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310622
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230310622,
					"content": "咳！不管他们怎么想都没关系！至，至少我钓鱼永不走空车！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310623
					],
					"speakerTitle": "凯万"
				},
				{
					"id": 230310623,
					"content": "今天不成就明天再来，总有一天，我肯定能钓上来鱼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310624
					],
					"speakerTitle": "凯万"
				},
				{
					"id": 230310624,
					"content": "谢谢你们帮我去找材料，这些报酬给你，我要换个地方继续钓鱼了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310625
					],
					"speakerTitle": "凯万"
				},
				{
					"id": 230310625,
					"content": "下次…下次我一定能钓到一条大鱼！一定！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凯万"
				},
				{
					"id": 230310620,
					"content": "他们可能是在揶揄你…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310621
					]
				},
				{
					"id": 230310608,
					"content": "派蒙脚不着地。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310609
					]
				}
			]
		},
