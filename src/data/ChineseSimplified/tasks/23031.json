				"objectNames": [
					"凯万"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230310101,
					"content": "哟，看你的样子…是旅行者吧？居然会来这种地方闲逛，很有闲情雅致啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310102
					],
					"speakerTitle": "凯万"
				},
				{
					"id": 230310102,
					"content": "还是说，你也是钓鱼客，相中了这片水域？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310103
					],
					"speakerTitle": "凯万"
				},
				{
					"id": 230310103,
					"content": "眼光不错！这里是附近最好的钓鱼点了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310104
					],
					"speakerTitle": "凯万"
				},
				{
					"id": 230310104,
					"content": "可这附近好像没有其他人在钓鱼啊？你怎么这么肯定？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230310105,
					"content": "那当然是因为我眼光独到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310106
					],
					"speakerTitle": "凯万"
				},
				{
					"id": 230310106,
					"content": "身为这一带最厉害的渔师，选择钓鱼点的方法当然也有讲究。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310107
					],
					"speakerTitle": "凯万"
				},
				{
					"id": 230310107,
					"content": "真…真的吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310108
					]
				},
				{
					"id": 230310108,
					"content": "你好像没什么收获欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230310109,
					"content": "话都说到这份上了，就让你们见识一下「鱼钩上的绝景」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310110,
						230310111
					],
					"speakerTitle": "凯万"
				},
				{
					"id": 230310110,
					"content": "鱼钩上的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310112
					]
				},
				{
					"id": 230310112,
					"content": "你给我特别的材料，我手制鱼饵，钓出你从没见过的「鱼」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310113
					],
					"speakerTitle": "凯万"
				},
				{
					"id": 230310113,
					"content": "怎么感觉有点可疑？手制鱼饵真的靠谱吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230310114,
					"content": "试试也无妨。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310115
					]
				},
				{
					"id": 230310115,
					"content": "爽快，我就喜欢和这样的人打交道！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310116
					],
					"speakerTitle": "凯万"
				},
				{
					"id": 230310116,
					"content": "我的手制鱼饵除了作为基底的日落果和小麦以外，还有一种赋予其灵性的材料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凯万"
				},
				{
					"id": 230310111,
					"content": "绝景？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310112
					]
				}
			]
		},
