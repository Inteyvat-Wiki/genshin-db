			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"纳西妲"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30261705,
					"content": "嗯。有什么想知道的事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261706,
						30261717,
						30261729,
						30261735,
						30261743
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30261706,
					"content": "关于「虚空」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30261707
					]
				},
				{
					"id": 30261717,
					"content": "关于那天我入睡后发生的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30261718
					]
				},
				{
					"id": 30261729,
					"content": "关于「散兵」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30261730
					]
				},
				{
					"id": 30261735,
					"content": "关于旅途的下一站，枫丹…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30261736
					]
				},
				{
					"id": 30261790,
					"content": "#关于我的{M#妹妹}{F#哥哥}…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30261762
					]
				},
				{
					"id": 30261743,
					"content": "没什么了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30261744
					]
				},
				{
					"id": 30261707,
					"content": "那件事之后，虚空不再能像原来那样运作了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261708
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30261708,
					"content": "综合考虑之后，我选择关闭虚空。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261709
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30261709,
					"content": "不过，这绝对不是什么坏事。我原本也计划停止虚空的运作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261710
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30261710,
					"content": "由虚空统一管理知识，本来就会限制人们的好奇心并抹杀他们的可能性。我想这并不利于须弥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261711
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30261711,
					"content": "现在人们还会为失去虚空感到不适应，但不用多久，大家就会明白，这样的生活才更好、更适合他们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261712
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30261712,
					"content": "而关于须弥的未来…我正准备重新掌控教令院。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261713
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30261713,
					"content": "原本的贤者已经接受了属于他们的惩戒，新的贤者还没选出。这件事，我也会亲自监督。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261714
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30261714,
					"content": "我期望中的新一代六贤者会更偏学术，现在，须弥需要这样的领导者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261715
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30261715,
					"content": "另外，赤王子民乃至整个沙漠区域的居民，他们在过去很长的时间里遭到了不公待遇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261716
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30261716,
					"content": "我已经做出一些相应处理了，重建任何事物都需要时间，但不论是文化、友谊、信任…我们都会重新得到的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261705
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30261718,
					"content": "你是说「博士」令你昏睡之后，究竟发生了什么吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261719
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30261719,
					"content": "他夺走了神之心？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30261720
					]
				},
				{
					"id": 30261720,
					"content": "你猜得没错…第三席及之上的愚人众执行官都有着堪比神明的实力，那种情况下我并不是他的对手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261721
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30261721,
					"content": "不过，尽管形势恶劣，我也做到了跟「博士」对等交易。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261722
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30261722,
					"content": "你一定记得吧，那个改变了你命运的——「天理」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261723
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30261723,
					"content": "事实上，「天理」自从五百年前坎瑞亚灾变以后就沉寂至今了。而我利用这一点，威胁了博士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261724
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30261724,
					"content": "我告诉他，如果我毁灭这颗神之心，就有可能将「天理」唤醒，虽然只是猜测，也成功反制住了他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261725
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30261725,
					"content": "事关「法则」，这种级别的毁损，「天理」应该不会坐视不理吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261726
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30261726,
					"content": "至于我用神之心交换了什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261727
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30261727,
					"content": "我换到了对「博士」的惩罚，和我身为智慧之神难以拒绝的「知识」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261728
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30261730,
					"content": "他一直昏迷不醒，我像藏起一片羽毛那样，把他藏起来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261731
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30261731,
					"content": "我知道你对他充满顾虑，可是「曾经成神」的他，身上留有了一些很有用的特质。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261732
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30261732,
					"content": "不过别担心，我会看住他，不允许他作恶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261733
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30261733,
					"content": "另外，他身上还存在着一些谜团。有些事从我的视角看得很清楚，他自己却完全没弄明白呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261734
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30261734,
					"content": "未来的事，还得看他造化。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261705
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30261736,
					"content": "你们要去那里了啊，「正义」的国度，枫丹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261737
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30261737,
					"content": "据我了解，那个国家的运转是建立在一套关于正义的审判体系之上的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261738
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30261738,
					"content": "是由他们的神明来审判民众吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261739
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30261739,
					"content": "并不是，枫丹有一位最高审判官在，一般来说，神明「芙卡洛斯」并不会亲自参与审判。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261740
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30261740,
					"content": "但…几乎每一场审判，芙卡洛斯都不会缺席，她似乎只是沉醉于那种氛围而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261741
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30261741,
					"content": "作为神明的她，也依旧保留着影响最终判决的权力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261742
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30261742,
					"content": "总而言之，是一位…嗯…非常有个性的神明。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261705
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30261784,
					"content": "嗯。再过一段时间，你们也会启程，然后离开须弥了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261785
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30261785,
					"content": "我对你未来的命运很感兴趣。那将是无法被观测，也不会被这个世界所记录的旅程…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261786
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30261786,
					"content": "我曾说命运是终极的知识，而你的未来则是「终极的命运」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261787
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30261787,
					"content": "能认识你真好，纳西妲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261788
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30261788,
					"content": "我才应该好好感谢你们的到来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261789
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30261789,
					"content": "好啦，就先聊到这里吧。以后如果你们想我的话，说不定我会在你们的梦里出现哦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30261762,
					"content": "从我可以接触到的记录中，你的血亲是忽然出现在坎瑞亚的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261763
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30261763,
					"content": "#在坎瑞亚灾变以后，{M#她}{F#他}踏上了走遍提瓦特各国的旅行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261764
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30261764,
					"content": "#可是在{M#她}{F#他}的旅程即将结束的时候，世界树中有关{M#她}{F#他}的记录又忽然间模糊掉了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261765
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30261765,
					"content": "#模糊掉了？{M#她}{F#他}遇上了什么事么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261766
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30261766,
					"content": "#我能确定的是，似乎有人在为了某种理由而刻意掩盖{M#她}{F#他}的「命运」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261767
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30261767,
					"content": "既然能做到这一点…那个家伙必然有着非凡的能力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261768
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30261768,
					"content": "难道和「深渊」有关…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30261769
					]
				},
				{
					"id": 30261769,
					"content": "#但是，这些信息好像也没办法解释为什么{NICKNAME}的血亲会是这个世界的人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261770
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30261770,
					"content": "有一个值得注意的点，据我所知…在愚人众的情报体系中，他们也并未将你的血亲列入「降临者」的范畴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261771
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30261771,
					"content": "「降临者」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30261772
					]
				},
				{
					"id": 30261772,
					"content": "…降临者是什么？好像头一次听说这个概念…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261773
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30261773,
					"content": "你应该也会好奇我究竟用神之心与愚人众交换了什么情报吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261774
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30261774,
					"content": "其中非常重要的一部分，便是关于这个世界的「降临者」…不属于这个世界的外来存在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261775
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30261775,
					"content": "#{NICKNAME}，你是提瓦特的「第四降临者」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261776
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30261776,
					"content": "第四…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30261777
					]
				},
				{
					"id": 30261777,
					"content": "#啊？也就是说，按照愚人众所给出的情报，不算{NICKNAME}的血亲，居然还曾经有过三位「降临者」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
