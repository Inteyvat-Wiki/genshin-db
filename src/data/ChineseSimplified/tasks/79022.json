				},
				{
					"id": 790221804,
					"content": "扎哈尔是谁…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790221805
					]
				},
				{
					"id": 790221805,
					"content": "扎哈尔是我的队友，他身体有点不舒服…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790221806
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790221806,
					"content": "真不知道他有没有出什么事啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790221807,
					"content": "关于怀表里的合照…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790221808
					]
				},
				{
					"id": 790221808,
					"content": "不行，那个跟愚人众没什么关系，也没有什么好告诉你的。你帮我找回了怀表我很感激，可也不能说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790221809,
