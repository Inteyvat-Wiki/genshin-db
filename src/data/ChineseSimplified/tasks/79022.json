			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"7902303",
							"1"
						]
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7902201",
							"2"
						],
						"stepId": 7902201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"阿加菲娅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790220701,
					"content": "#{NICKNAME}，这个藏镜仕女给人感觉好奇怪啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220702
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220702,
					"content": "…要赶快回去…要赶快回去，他还在…可是，哥哥们不见了，哥哥们的照片…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220703
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790220703,
					"content": "喂，愚人众的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220704
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220704,
					"content": "哥哥们的照片…丢了照片，就回不去了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220705
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790220705,
					"content": "愚人众的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220706
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220706,
					"content": "不能，把他丢下…不能让他一个人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220707,
						790220708
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790220707,
					"content": "状态不太对呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790220709
					]
				},
				{
					"id": 790220709,
					"content": "总觉得看到过类似的场景啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220710
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220710,
					"content": "之前的愚人众…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790220711
					]
				},
				{
					"id": 790220711,
					"content": "是哦，之前碰到叶夫卡的时候，他也一直念叨着「徽记、徽记…」什么的，把徽记给他就清醒了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220712
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220712,
					"content": "愚人众在这里做实验，结果连自己的人都被影响了，这就叫「恶有恶报」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220713
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220713,
					"content": "派蒙说的对！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790220714
					]
				},
				{
					"id": 790220714,
					"content": "这么说来，这个藏镜仕女是不是就是叶夫卡说的，他们小队的成员啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220715
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220715,
					"content": "那我们是不是也要找到什么让她清醒过来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220716
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220716,
					"content": "哥哥们和我的合照…要是那个找不回来了，我就没法回去，可是…可是他还在那里，独自等着我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220717
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790220717,
					"content": "#我明白了…{NICKNAME}，看来得把她心心念念的那个合照给她，她才会醒过来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220708,
					"content": "没法沟通啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790220709
					]
				}
			]
		},
		{
			"id": 7902208,
			"completionStepIds": [
				7902208
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_A_AND_ETCOR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7902208",
							"2"
						],
						"stepId": 7902208,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"7902303",
							"0"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿加菲娅",
					"扎哈尔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790220801,
					"content": "扎哈尔，扎哈尔…你没事吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220802
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790220802,
					"content": "阿加霞，怎么了，出什么事了…我只是在这儿睡了一觉，不过身体已经舒服很多啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220803
					],
					"speakerTitle": "扎哈尔"
				},
				{
					"id": 790220803,
					"content": "唉…你没事就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220804
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790220804,
					"content": "嘿嘿，对了，阿加霞，你之前给我的果子，你给了我四个，我可一个都没吃呢，就等你回来一起吃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220805
					],
					"speakerTitle": "扎哈尔"
				},
				{
					"id": 790220805,
					"content": "真是的，本来就是给你摘的苹果…要是等太久饿了，就先吃嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220806
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790220806,
					"content": "可是你独自去做任务，更辛苦…虽然很饿，但是扎哈尔忍住了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220807
					],
					"speakerTitle": "扎哈尔"
				},
				{
					"id": 790220807,
					"content": "哦？独自去做任务呀，是做了什么任务呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220808
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220808,
					"content": "啊，不就是因为雅科夫差点弄坏了设备，所以…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220809
					],
					"speakerTitle": "扎哈尔"
				},
				{
					"id": 790220809,
					"content": "扎哈尔！你怎么什么词都敢往外捅啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220810
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790220810,
					"content": "#啊！你们，这不是内部文件上的，{NICKNAME}和…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220811
					],
					"speakerTitle": "扎哈尔"
				},
				{
					"id": 790220811,
					"content": "「小飞人」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790220812
					]
				},
				{
					"id": 790220812,
					"content": "对，是「小飞人」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220813
					],
					"speakerTitle": "扎哈尔"
				},
				{
					"id": 790220813,
					"content": "我已经说腻了，我的名字是「派蒙」啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220814
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220814,
					"content": "嘿嘿，我脑袋不太好使，我的名字是扎哈尔…不对，你们和我们愚人众不是…不是敌人吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220815
					],
					"speakerTitle": "扎哈尔"
				},
				{
					"id": 790220815,
					"content": "阿加菲娅，是你把敌人带到这里来的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220816
					],
					"speakerTitle": "扎哈尔"
				},
				{
					"id": 790220816,
					"content": "对，这两位就是把你从荆棘里救出来的好心…救出来的好敌人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220817
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790220817,
					"content": "对哦，你走了以后不久，这里突然长出了巨大的荆棘，把山洞封起来了…是你们把那个巨大荆棘消灭掉的吗，了不起啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220818
					],
					"speakerTitle": "扎哈尔"
				},
				{
					"id": 790220818,
					"content": "正是如此！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220819
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220819,
					"content": "可是我们不是敌人嘛，为什么要做帮助敌人的事呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220820
					],
					"speakerTitle": "扎哈尔"
				},
				{
					"id": 790220820,
					"content": "真是个让人有点答不上来的好问题…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220821
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220821,
					"content": "当然是因为她答应了，如果我们把你救出来，她就告诉我们，你们几个到底在干什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220822
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220822,
					"content": "阿加菲娅，你居然出卖愚人众的情报！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220823
					],
					"speakerTitle": "扎哈尔"
				},
				{
					"id": 790220823,
					"content": "没关系的，扎哈尔，到时候我们随便说些什么「愚人众在这片海域捕猎神秘花鳉」之类的话糊弄过去就是了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220824
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790220824,
					"content": "哇，居然光明正大地说要糊弄我们，真是被小瞧了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220825
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220825,
					"content": "好了，荆棘也打开了，扎哈尔也救出来了，该说出你们要做什么事了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220826
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220826,
					"content": "不能说呀，阿加菲娅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220827
					],
					"speakerTitle": "扎哈尔"
				},
				{
					"id": 790220827,
					"content": "唉，都到了这个时候了…不过说实话。其实我们也不太清楚，只是过来做测试的而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220828,
						790220829
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790220828,
					"content": "测试？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790220830
					]
				},
				{
					"id": 790220830,
					"content": "大概是什么信号测试吧…具体的我也不清楚，不过如果是小队里的另一组人，应该知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220831
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790220831,
					"content": "只有这些吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220832
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220832,
					"content": "我知道的也不多嘛…对了，情报也说了，你们可以放我们走了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220833
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790220833,
					"content": "虽然好像没有答应过会放你们走，不过看上去也没什么危险…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220834
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220834,
					"content": "那就算我们大发慈悲…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790220835
					]
				},
				{
					"id": 790220835,
					"content": "欸呀，那还真是感谢了。唉，也不知道<color=#00E1FFFF>另一组的家伙们</color>怎么样了，我们当时约好，说做完任务就回海域中间的营地…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220836
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790220836,
					"content": "另一组人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220837
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220837,
					"content": "对，也是两个人，说是要朝着<color=#00E1FFFF>南方的两个岛</color>的方向去了…啊，这可是额外的情报，可不是无意中被套话了哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220838
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790220838,
					"content": "南方的大岛上…那就是危危岛吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220839
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220839,
					"content": "好了好了，不能再说了，我们得快点回海域中央岛屿上的营地才行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790220829,
					"content": "什么测试？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790220830
					]
				}
			]
		},
