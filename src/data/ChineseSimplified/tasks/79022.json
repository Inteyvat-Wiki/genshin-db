			"trigger": {
				"objectNames": [
					"阿加菲娅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790220101,
					"content": "这里怎么有愚人众，这名藏镜仕女…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220102,
					"content": "他们留在这里，不会又在搞什么阴谋诡计吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220103,
					"content": "…要赶快回去…要赶快回去，他还在…可是，哥哥们不见了，哥哥们的照片…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220104
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790220104,
					"content": "喂，你是谁，在这里有什么企图！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220105,
					"content": "哥哥们的照片…丢了照片，就回不去了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220106
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790220106,
					"content": "愚人众的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220107,
					"content": "不能，把他丢下…不能让他一个人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220108,
						790220109
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790220108,
					"content": "状态不太对呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790220110
					]
				},
				{
					"id": 790220110,
					"content": "嗯…不过真有点在意为什么会有一个藏镜仕女在这儿呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220111,
					"content": "#{NICKNAME}，不如我们想办法让她清醒过来，然后好好问问这些散落在外的愚人众在做什么吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220112,
					"content": "确实不能放着不管…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790220113
					]
				},
				{
					"id": 790220113,
					"content": "嗯，虽然只是一个不太正常的愚人众…但是放任不管的话总觉得不是什么好事呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220114,
					"content": "不过，她到底为什么会变成现在这样啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220115,
					"content": "因为那个装置吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790220116
					]
				},
				{
					"id": 790220116,
					"content": "啊，是哦，那个装置影响了岛上所有的人…不过那个装置明明已经关闭了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220117,
					"content": "哥哥们和我的合照…要是那个找不回来了，我就没法回去，可是…可是他还在那里，独自等着我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220118
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790220118,
					"content": "#我明白了…{NICKNAME}，我们把她心心念念的什么合照找来吧，说不定就能让她清醒过来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220109,
					"content": "没法沟通啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790220110
					]
				}
			]
		},
		{
			"id": 7902206,
			"completionStepIds": [
				7902206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
