			},
			"dialogs": [
				{
					"id": 790222301,
					"content": "扎哈尔，扎哈尔…你没事吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222302
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790222302,
					"content": "阿加霞，怎么了，出什么事了…我只是在这儿睡了一觉，不过身体已经舒服很多啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222303
					],
					"speakerTitle": "扎哈尔"
				},
				{
					"id": 790222303,
					"content": "唉…你没事就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222304
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790222304,
					"content": "嘿嘿，对了，阿加霞，你之前给我的果子，你给了我四个，我可一个都没吃呢，就等你回来一起吃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222305
					],
					"speakerTitle": "扎哈尔"
				},
				{
					"id": 790222305,
					"content": "真是的，本来就是给你摘的苹果…要是等太久饿了，就先吃嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222306
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790222306,
					"content": "可是你独自去做任务，更辛苦…虽然很饿，但是扎哈尔忍住了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222307
					],
					"speakerTitle": "扎哈尔"
				},
				{
					"id": 790222307,
					"content": "哦？独自去做任务呀，是做了什么任务呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790222308,
					"content": "啊，不就是因为雅科夫差点弄坏了设备，所以…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222309
					],
					"speakerTitle": "扎哈尔"
				},
				{
					"id": 790222309,
					"content": "扎哈尔！你怎么什么词都敢往外捅啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222310
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790222310,
					"content": "#啊！你们，这不是内部文件上的，{NICKNAME}和…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222311
					],
					"speakerTitle": "扎哈尔"
				},
				{
					"id": 790222311,
					"content": "「小飞人」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790222312
					]
				},
				{
					"id": 790222312,
					"content": "对，是「小飞人」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222313
					],
					"speakerTitle": "扎哈尔"
				},
				{
					"id": 790222313,
					"content": "我已经说腻了，我的名字是「派蒙」啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790222314,
					"content": "嘿嘿，我脑袋不太好使，我的名字是扎哈尔…不对，你们和我们愚人众不是…不是敌人吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222315
					],
					"speakerTitle": "扎哈尔"
				},
				{
					"id": 790222315,
					"content": "阿加菲娅，是你把敌人带到这里来的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222316
					],
					"speakerTitle": "扎哈尔"
				},
				{
					"id": 790222316,
					"content": "对，这两位就是把你从荆棘里救出来的好心…救出来的好敌人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222317
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790222317,
					"content": "对哦，你走了以后不久，这里突然长出了巨大的荆棘，把山洞封起来了…是你们把那个巨大荆棘消灭掉的吗，了不起啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222318
					],
					"speakerTitle": "扎哈尔"
				},
				{
					"id": 790222318,
					"content": "正是如此！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790222319,
					"content": "可是我们不是敌人嘛，为什么要做帮助敌人的事呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222320
					],
					"speakerTitle": "扎哈尔"
				},
				{
					"id": 790222320,
					"content": "真是个让人有点答不上来的好问题…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222321
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790222321,
					"content": "当然是因为她答应了，如果我们把你救出来，她就告诉我们，你们几个到底在这个岛上干什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222322
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790222322,
					"content": "阿加霞，你居然出卖愚人众的情报！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222323
					],
					"speakerTitle": "扎哈尔"
				},
				{
					"id": 790222323,
					"content": "没关系的，扎哈尔，到时候我们随便说些什么「愚人众在这片海域捕猎神秘花鳉」之类的话糊弄过去就是了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222324
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790222324,
					"content": "哇，居然光明正大地说要糊弄我们，真是被小瞧了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222325
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790222325,
					"content": "好了，荆棘也打开了，扎哈尔也救出来了，该说出你们要做什么事了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222326
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790222326,
					"content": "不能说呀，阿加菲娅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222327
					],
					"speakerTitle": "扎哈尔"
				},
				{
					"id": 790222327,
					"content": "唉，都到了这个时候了…不过说实话。其实我们也不太清楚，只是过来做测试的而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222328,
						790222329
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790222328,
					"content": "测试？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790222330
					]
				},
				{
					"id": 790222330,
					"content": "大概是什么信号测试吧…具体的我也不清楚，不过如果是小队里的另一组人，应该知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222331
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790222331,
					"content": "他们确实说了一大堆，不过你们这边只有这些吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222332
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790222332,
					"content": "我知道的也不多嘛…对了，情报也说了，你们可以放我们走了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222333
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790222333,
					"content": "虽然好像没有答应过会放你们走，不过看上去也没什么危险…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222334
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790222334,
					"content": "那就算我们大发慈悲…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790222335
					]
				},
				{
					"id": 790222335,
					"content": "欸呀，那还真是感谢了。唉，也不知道另一组去其他两个岛的家伙们怎么样了，我们当时约好，做完任务就回海域中间的营地…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222336
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790222336,
					"content": "啊，你说的是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222337
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790222337,
					"content": "是之前碰到的其他愚人众呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790222338
					]
				},
				{
					"id": 790222338,
					"content": "原来你已经遇到过了吗？不行，扎哈尔，我们得尽快返回营地，到之前说好的汇合地点才行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790222329,
					"content": "什么测试？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790222330
					]
				}
			]
