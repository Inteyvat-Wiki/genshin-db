				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790221201,
					"content": "这…啊，这个是我的，这里面是哥哥们和我的合照…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790221202
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790221202,
					"content": "能够重新找回来真是太好了，之前到底是丢在哪了呢…唔，不对，头好痛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790221203
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790221203,
					"content": "我们是在丘丘人营地的旁边找到的啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790221204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790221204,
					"content": "真是，真是十分感谢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790221205
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790221205,
					"content": "#啊！是内部文件上看到过的…金发的{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOY|INFO_FEMALE_PRONOUN_GIRL]}和小飞人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790221206
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790221206,
					"content": "是「派蒙」啦…唉，我干脆改名叫「小飞人」算了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790221207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790221207,
					"content": "你们对我做了什么，记忆…记忆有一段空白，你们不会对我做了什么奇怪的实验吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790221208
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790221208,
					"content": "就算我们立场不同…这样的行为也是不能被接受的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790221209
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790221209,
					"content": "做奇怪实验的是你们啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790221210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790221210,
					"content": "居然对把合照还给你的好心人说这种话！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790221211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790221211,
					"content": "…原来是这样，可是，既然我清醒了过来就说明，佩尔西科夫研究员的实验失败了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790221212
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790221212,
					"content": "看到你们也大概猜到失败的原因…欸呀，从立场上我们暂时仍是敌对的，你们还把合照给我，你们对敌人也太好心了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790221213
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790221213,
					"content": "正确的做法应该是把别人的珍贵之物，比如对我来说，就是刚才怀表里的合照…应该把合照拿在手里，然后威胁我说出情报。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790221214
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790221214,
					"content": "居然反过来被教训了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790221215,
						790221217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790221215,
					"content": "好没有人情味的做法…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790221216
					]
				},
				{
					"id": 790221216,
					"content": "…确实，是很没有人情味的做法，但是我们进入愚人众之后就是这样被教导的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790221219
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790221219,
					"content": "对了，你们在这里到底在搞什么破坏，快说出来啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790221220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790221220,
					"content": "我…我们，我们一起到了这岛上…对了，扎哈尔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790221221
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790221221,
					"content": "他还一个人在那里，得快点回去！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790221222
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790221222,
					"content": "似乎想起了什么，刚清醒的愚人众转身就离开了…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 790221217,
					"content": "下次试试看吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790221218
					]
				},
				{
					"id": 790221218,
					"content": "不要学这种事啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790221219
					],
					"speakerTitle": "派蒙"
				}
			]
		},
