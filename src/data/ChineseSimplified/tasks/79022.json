			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿加菲娅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790220601,
					"content": "扎哈尔！扎哈尔！你能听见吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220602
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790220602,
					"content": "这里怎么会变成这样…我们来的时候这里明明就是个山洞，这荆棘是怎么回事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220603
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790220603,
					"content": "啊，这就是因为受到你们那个什么幻境实验的影响导致的啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220604,
					"content": "这个岛上有很多类似的荆棘呢，不过只要用一定的方法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220605,
					"content": "是放火吗？你们不会是想放火烧掉荆棘吧，不行，里面可还有人呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220606
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790220606,
					"content": "#虽说早就听闻{NICKNAME}和派蒙非常危险，有的时候只是走在执行公务的路上也会被突然袭击…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220607
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790220607,
					"content": "但是居然想放火慢慢烧一个大活人，天啊，就连最残忍的债务处理人都做不到这种程度…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220608
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790220608,
					"content": "当然不是啦…而且这种荆棘用火烧也没用…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220609
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220609,
					"content": "我们有将荆棘打开，但不会伤到里面的人的办法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220610
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220610,
					"content": "真的吗，我可不信你们有这么神通广大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220611
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790220611,
					"content": "#什么，{NICKNAME}，这就把荆棘打开给她看看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220612,
						790220613
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220612,
					"content": "上当受骗了哦，派蒙…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790220614
					]
				},
				{
					"id": 790220614,
					"content": "咦…好呀，你故意挑拨我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220615
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220615,
					"content": "居然被识破了，真是可惜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220616
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790220616,
					"content": "哼，真是奸诈狡猾的愚人众，我们差点就中了你的诡计！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220617
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220617,
					"content": "中计的只有你啦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790220618
					]
				},
				{
					"id": 790220618,
					"content": "呜…总之，总之我们可以救出里面的人，但是相对的，你也得说出一些情报来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220619
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220619,
					"content": "这就是用别人的珍贵之物作为威胁，让别人说出情报的方法！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220620
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220620,
					"content": "哇，真是好没有人情味的做法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220621
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790220621,
					"content": "好没有人情味的做法…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790220622
					]
				},
				{
					"id": 790220622,
					"content": "她说也就算了，为什么你也说我呀，你到底是哪一边的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220623
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220623,
					"content": "…情报吗，阿加菲娅，我的名字是阿加菲娅，现在能给的情报只有这样了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220624
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790220624,
					"content": "只有一个名字吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220625
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220625,
					"content": "我要是说出什么重要情报，你们就拉下脸来说什么「是嘛，你已经没用了…」之类的台词，然后把我解决掉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220626
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790220626,
					"content": "愚人众的教官说每年都会发生很多类似的事，所以一定不能外泄重要的情报。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220627
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790220627,
					"content": "我们才不会干这样的事呢！还有你们愚人众的教官真的很奇怪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220628
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220628,
					"content": "奇怪吗…我倒觉得还挺正常的。总之，我现在就一个人在这里，无论如何你们都能很轻松解决我不是吗，我又逃不掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220629
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790220629,
					"content": "#嗯…总觉得有点不甘心，唉，没办法，{NICKNAME}，那我们就先打开封住洞口的荆棘吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220613,
					"content": "别这么简单就被挑拨啦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790220614
					]
				}
			]
		},
		{
			"id": 7902207,
