					"nextDialogs": [
						790222407
					]
				},
				{
					"id": 790222407,
					"content": "好吧，合照里的是我的两个哥哥，他们都曾经为至冬国做出过贡献…我一直，以他们为荣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿加菲娅"
				},
				{
