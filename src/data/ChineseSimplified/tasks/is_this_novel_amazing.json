					"顺吉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220100601,
					"content": "火花飞溅，铁锤和铁砧不停碰撞…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100602
					],
					"speakerTitle": "顺吉"
				},
				{
					"id": 220100602,
					"content": "「天目锻冶屋」真是个热情澎湃的地方！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100603
					],
					"speakerTitle": "顺吉"
				},
				{
					"id": 220100603,
					"content": "铁匠们只用简单的工具，就能把粗糙的原胚和矿石变成性能卓越的兵器。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100604
					],
					"speakerTitle": "顺吉"
				},
				{
					"id": 220100604,
					"content": "那要是在锻造的过程中，使用炼金术，岂不是能制造出无坚不摧的神兵利器？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100605,
						220100606
					],
					"speakerTitle": "顺吉"
				},
				{
					"id": 220100605,
					"content": "炼金术没有这么夸张…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100608
					]
				},
				{
					"id": 220100608,
					"content": "嗯！这个主意不错，让主角拥有一把…由炼金术铸就的最强武器！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100609
					],
					"speakerTitle": "顺吉"
				},
				{
					"id": 220100609,
					"content": "而且还要让这把武器有一个好名字…和一个好来历。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100610
					],
					"speakerTitle": "顺吉"
				},
				{
					"id": 220100610,
					"content": "没错，就这么干！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100611
					],
					"speakerTitle": "顺吉"
				},
				{
					"id": 220100611,
					"content": "旅行者，我们回去吧，我要把我的构思告诉阿茂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "顺吉"
				},
				{
					"id": 220100606,
					"content": "你对炼金术有误解…",
					"roleType": "TALK_ROLE_PLAYER",
