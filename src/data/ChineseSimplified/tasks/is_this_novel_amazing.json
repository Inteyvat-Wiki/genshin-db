				"points": []
			},
			"dialogs": [
				{
					"id": 220100101,
					"content": "顺吉，明天是交稿的最后期限，绝对不能再拖延了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100102
					],
					"speakerTitle": "阿茂"
				},
				{
					"id": 220100102,
					"content": "你再怎么催我都没用，剧情卡在关键的地方了，我不知道该怎么写才好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100103
					],
					"speakerTitle": "顺吉"
				},
				{
					"id": 220100103,
					"content": "你们在吵什么呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100104
					]
				},
				{
					"id": 220100104,
					"content": "是…是旅行者？你来得正好，正好你来评评理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100105
					],
					"speakerTitle": "阿茂"
				},
				{
					"id": 220100105,
					"content": "我是「八重堂」的编辑阿茂。这位是我负责的作家顺吉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100106
					],
					"speakerTitle": "阿茂"
				},
				{
					"id": 220100106,
					"content": "他的新小说《鬼武道》本来很受欢迎，但他总是不能按时交稿，有时会拖延好几周。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100107
					],
					"speakerTitle": "阿茂"
				},
				{
					"id": 220100107,
					"content": "这次他又犯老毛病了，如果明天还不交稿，这个月的小说合刊就没法按时送印了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100108
					],
					"speakerTitle": "阿茂"
				},
				{
					"id": 220100108,
					"content": "实在不行，就延期发售吧，反正忠实的读者还是会掏钱的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100109
					],
					"speakerTitle": "顺吉"
				},
				{
					"id": 220100109,
					"content": "别开玩笑了，要是不能连续更新的话，小说的口碑会一口气跌到谷底的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100110
					],
					"speakerTitle": "阿茂"
				},
				{
					"id": 220100110,
					"content": "但我没有灵感，与其写一些无趣的注水章节，还不如好好思索一下真正有趣的故事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100111
					],
					"speakerTitle": "顺吉"
				},
				{
					"id": 220100111,
					"content": "但其他作者都已经都差不多交齐了，就差你一个人了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100112
					],
					"speakerTitle": "阿茂"
				},
				{
					"id": 220100112,
					"content": "或许顺吉先生真的需要灵感…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100113
					]
				},
				{
					"id": 220100113,
					"content": "没错！这位朋友就很懂行，我需要灵感！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100114
					],
					"speakerTitle": "顺吉"
				},
				{
					"id": 220100114,
					"content": "也许四处转转，找找灵感，我就知道接下来该怎么写了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100115
					],
					"speakerTitle": "顺吉"
				},
				{
					"id": 220100115,
					"content": "喂，上次你就是拿这个借口又拖了一天，还想来这套吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100116
					],
					"speakerTitle": "阿茂"
				},
				{
					"id": 220100116,
					"content": "这次绝对不会了，你也相信我一回啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100117
					],
					"speakerTitle": "顺吉"
				},
				{
					"id": 220100117,
					"content": "真是的…好吧，就再相信你一回…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100118
					],
					"speakerTitle": "阿茂"
				},
				{
					"id": 220100118,
					"content": "一定，一定不能再拖了，知道了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100119
					],
					"speakerTitle": "阿茂"
				},
				{
					"id": 220100119,
					"content": "我知道了，我知道了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100120
					],
					"speakerTitle": "顺吉"
				},
				{
					"id": 220100120,
					"content": "呼…这回看来是真的不能拖了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100121,
						220100122
					],
					"speakerTitle": "顺吉"
				},
				{
					"id": 220100121,
					"content": "我们现在就去取材吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220100122,
					"content": "我们还是去找灵感吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100123
					]
				},
				{
					"id": 220100123,
					"content": "但灵感这东西，有时候找也找不到啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100124
					],
					"speakerTitle": "顺吉"
				},
				{
					"id": 220100124,
					"content": "不过现在也只能四处找找看了，不然阿茂非把我的屋子给掀了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "顺吉"
				}
			]
		},
