			"dialogs": [
				{
					"id": 220100401,
					"content": "我正在构思的章节里，主角独自去往了敌人的领地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100402
					],
					"speakerTitle": "顺吉"
				},
				{
					"id": 220100402,
					"content": "想要在那里对抗敌人们，收集情报是一项必要的工作，该怎么让他从容地度过这关呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100403
					],
					"speakerTitle": "顺吉"
				},
				{
					"id": 220100403,
					"content": "唔，我们不如先去观察一下同心们的工作吧。",
