				"points": []
			},
			"dialogs": [
				{
					"id": 710070101,
					"content": "你画得怎么样了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710070102
					]
				},
				{
					"id": 710070102,
					"content": "从雕像眼睛发光开始，我就一直在那两个雕像旁边画画。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070103
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710070103,
					"content": "不过，怎么说呢…总感觉，我一直没画出最完美的那一幅画。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070104
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710070104,
					"content": "我总感觉我的画里缺了什么东西…你能理解吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070105
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710070105,
					"content": "就像是一道菜，无论是用料还是做法，一切都很好，但是…但是就感觉缺点什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070106
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710070106,
					"content": "哎呀，我也不知道怎么表达，而且也抓不住那个感觉，所以我只能不停地画下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070107
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710070107,
					"content": "哈哈哈，不怕你笑我，我画得头都有点晕了，就想要闭眼休息一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070108
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710070108,
					"content": "但不知道为什么，我闭眼的时候，突然又看见那两个雕像亮起来的眼睛…就在我眼前。就和那两个雕像活了似的，直直地盯着我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070109
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710070109,
					"content": "我，我就回来这里，想要休息一下，这里应该看不见那两个雕像的眼睛了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070110
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710070110,
					"content": "对了，请你收下这幅画吧，这是目前为止，我觉得最好的一幅画。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070111
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710070111,
					"content": "你别在意我说的话，我肯定是太累了，休息一下就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070112
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710070112,
					"content": "但是我的画，到底缺了什么呢，缺了什么呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "梵米尔"
				}
			]
		}
	]
}