			},
			"dialogs": [
				{
					"id": 220270401,
					"content": "还是供奉「三彩团子」吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220270402
					]
				},
				{
					"id": 220270402,
					"content": "这样吗…好！我刚好带着一个「三彩团子」，这是妈妈做给我的，我还没舍得吃呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270403
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220270403,
					"content": "就…就供奉给神明大人吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270601
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220270601,
					"content": "希望神明能保佑我，帮我实现愿望…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270602
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220270602,
					"content": "#谢谢你陪我到现在，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，这些东西给你，就当做是谢礼啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270603
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220270603,
					"content": "明天我会再来这里看看的，希望…神明大人会有些回复…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "翔太"
				}
			]
		},
