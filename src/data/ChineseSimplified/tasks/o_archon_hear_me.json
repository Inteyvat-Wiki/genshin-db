				"objectNames": [
					"翔太"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220270101,
					"content": "漆器…到底是怎么做的呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270102
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220270102,
					"content": "你做漆器干什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220270103
					]
				},
				{
					"id": 220270103,
					"content": "#是你啊…{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，是这样的，你听说过神龛显灵的事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270104
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220270104,
					"content": "我听人家说，如果向神龛献上珍贵的供品，也许就能实现自己的愿望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270105
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220270105,
					"content": "我想，漂亮的漆器特别值钱，用漆器来供奉神龛的话，肯定能得到回应吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270106
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220270106,
					"content": "我没钱买漆器，所以就想要自己做一个。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270107
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220270107,
					"content": "我听说，「弥生漆器」的七月姐姐很擅长做漆器…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270108
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220270108,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，你能陪我去找七月姐姐问一下漆器的事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270109,
						220270111
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220270109,
					"content": "没问题，我们走吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220270110
					]
				},
				{
					"id": 220270110,
					"content": "#谢谢{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "翔太"
				},
				{
					"id": 220270111,
					"content": "你怎么不自己去？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220270112
					]
				},
				{
					"id": 220270112,
					"content": "七月姐姐她平时…很严肃的，我不太敢去向她请教…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270113
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220270113,
					"content": "#有{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}在旁边的话，应该会好一些吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "翔太"
				}
			]
		},
		{
			"id": 2202702,
			"completionStepIds": [
				2202702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
