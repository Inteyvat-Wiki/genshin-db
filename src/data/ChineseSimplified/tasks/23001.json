			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"哈特姆"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230010101,
					"content": "让我想想…该选哪一个呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010102
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010102,
					"content": "你在干什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230010103
					]
				},
				{
					"id": 230010103,
					"content": "哦，我在思考今天的「吞金料理」是什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010104
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010104,
					"content": "「吞金料理」？是…是金子做的料理吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230010105,
					"content": "不，是让人吃了之后，能够日进斗金的伟大料理！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010106
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010106,
					"content": "那我也想要吃！不对…怎么会有那种东西啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230010107,
					"content": "哈哈哈，那你就不知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010108
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010108,
					"content": "比方说璃月的摩拉肉，这种以金钱为名的尊贵料理，理所当然地蕴含着强烈的财富运势。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010109
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010109,
					"content": "还有黄油鸡，丰盛的油水让人不禁就联想到丰盛的荷包。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010110
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010110,
					"content": "再比如说蒙德的「堆高高」，从名字到摆盘无一不在象征财富节节高。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010111
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010111,
					"content": "如果吃下这种料理，再去卡里米交易所里买上几单期货，一定就能大赚一笔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010112
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010112,
					"content": "听起来都感觉有一种强行解释的感觉啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010113,
						230010133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230010113,
					"content": "期货是什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230010114
					]
				},
				{
					"id": 230010114,
					"content": "你没有买过期货吗？唔…那就让我给你解释解释，那是一种和现货交易对应的未来交易，就比如说，你身边的这个小家伙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010115
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010115,
					"content": "派蒙是派蒙！才不是什么小家伙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230010116,
					"content": "唔哈哈哈，那么派蒙小家伙，你喜欢什么东西？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010117
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010117,
					"content": "欸？派蒙喜欢…嗯…史莱姆！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230010118,
					"content": "哈哈哈，好！那就假设我手里有一种史莱姆凝液，价格是一百摩拉一瓶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010144
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010144,
					"content": "今天你花五万摩拉从我这里买入五百瓶史莱姆凝液，这种是现货交易。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010119
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010119,
					"content": "这，这也太多了，派蒙吃不完的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230010120,
					"content": "这就是一个比方嘛…假设你今天买了五百瓶，但你肯定不能保证，每天都会向我购买这么多史莱姆凝液吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010121
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010121,
					"content": "唔…唔，要是吃太饱的话，应该就不会买了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230010122,
					"content": "没错，而我也不能保证，每时每刻都能向你提供史莱姆凝液。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010123
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010123,
					"content": "所以，这个时候期货就出现了。期货不是一般的当着面一手交钱一手交货，而是一种「交易协定」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010124
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010124,
					"content": "「购买一份史莱姆凝液」和「出售一部分史莱姆凝液」都是一种「交易协定」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010125
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010125,
					"content": "在我还能提供史莱姆凝液的时候，就会向期货交易所提交出售史莱姆凝液的「交易协定」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010126
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010126,
					"content": "而你需要史莱姆凝液的时候，就可以去期货交易所查看一下购买史莱姆凝液的「交易协定」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010127
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010127,
					"content": "「期货交易」，就是精确而巧妙地购买和卖出这种「交易协定」，从而获得利润。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010128
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010128,
					"content": "当然啦，我也就是这么打个比方。如果史莱姆凝液真到了要用期货交易的地步，只怕野外的史莱姆都要被抓光了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010129
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010129,
					"content": "噢…好厉害…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230010130,
					"content": "喔…没听懂…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230010131
					]
				},
				{
					"id": 230010131,
					"content": "只是期货市场千变万化，就算是我这样经验丰富的专家，也不敢说买到的期货一定会赚钱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010132
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010132,
					"content": "但如果能先吃下带来财运的「吞金料理」，情况就不一样了。唯一的问题是…我今天应该吃哪一种呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010136
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010136,
					"content": "啊，等一下，我刚才没有注意，你的头发…居然是黄金的颜色啊！真是耀眼，耀眼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010137
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010137,
					"content": "黄金这可是财富的象征，由你选出的料理，肯定能给我带来丰厚的财运！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010138
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010138,
					"content": "就由你来帮我挑选一份「吞金料理」吧？我会准备好报酬的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010139
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010139,
					"content": "如果到时候赚了钱，我还有额外的好处给你，怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010140
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010140,
					"content": "万一亏了的话…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230010141
					]
				},
				{
					"id": 230010141,
					"content": "哈哈哈，放心吧。我，卡里米的不凡富翁哈特姆在此宣布——赚了有你一份，亏了全算我的，这下放心了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010142
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010142,
					"content": "我明白了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230010143
					]
				},
				{
					"id": 230010143,
					"content": "那就请你快帮我选一选，<color=#00E1FFFF>摩拉肉</color>，<color=#00E1FFFF>黄油鸡</color>和<color=#00E1FFFF>「堆高高」</color>这三道料理，到底哪一道才是「吞金料理」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010133,
					"content": "为什么不三种全吃掉？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230010134
					]
				},
				{
					"id": 230010134,
					"content": "把所有好的食材混在一起，最后反而做出了黑暗料理，这种事也是常有的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010135
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010135,
					"content": "财富运势也一样，全部吃掉只会适得其反，必须选出最有效的一种「吞金料理」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010136
					],
					"speakerTitle": "哈特姆"
				}
			]
		},
		{
			"id": 2300102,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2300102",
