			"dialogs": [
				{
					"id": 230010601,
					"content": "让我想想…该选哪一个呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010602
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010602,
					"content": "咦，旅行者，又是你们，太好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010603
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010603,
					"content": "你不会又在挑选「吞金料理」吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230010604,
					"content": "哈哈哈，你可真是个小聪明！我正打算挑选一份「吞金料理」，然后去期货市场大杀四方呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010605
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010605,
					"content": "怎么样，再帮我一把吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010606,
						230010608,
						230010614
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010606,
					"content": "明白了，今天还是老规矩？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230010607
					]
				},
				{
					"id": 230010607,
					"content": "没错！和你们打交道就是令人愉悦啊，就请帮我在<color=#00E1FFFF>摩拉肉</color>，<color=#00E1FFFF>黄油鸡</color>和<color=#00E1FFFF>「堆高高」</color>之中选择一道真正的「吞金料理」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010608,
					"content": "等等，「吞金料理」是什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230010609
					]
				},
				{
					"id": 230010609,
					"content": "是让人吃了之后，能够日进斗金的伟大料理！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010610
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010610,
					"content": "比方说璃月的摩拉肉，这种以金钱为名的尊贵料理，理所当然地蕴含着强烈的财富运势。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010611
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010611,
					"content": "还有黄油鸡，丰盛的油水让人不禁就联想到丰盛的荷包。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010612
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010612,
					"content": "再比如说蒙德的「堆高高」，从名字到摆盘无一不在象征财富节节高。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010613
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010613,
					"content": "如果吃下这种料理，再去卡里米交易所里买上几单期货，一定就能大赚一笔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010623
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010623,
					"content": "那么，为了我的「期货交易」，就请你帮我在<color=#00E1FFFF>摩拉肉</color>，<color=#00E1FFFF>黄油鸡</color>和<color=#00E1FFFF>「堆高高」</color>之中选择一道真正的「吞金料理」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010614,
					"content": "等等，期货是什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230010615
					]
				},
				{
					"id": 230010615,
					"content": "那是一种和现货交易对应的未来交易，假设我手里有一种史莱姆凝液，价格是一百摩拉一瓶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010616
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010616,
					"content": "今天你花五万摩拉从我这里买入五百瓶史莱姆凝液，这种就是现货交易。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010617
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010617,
					"content": "但你肯定不能保证，每天都会向我购买这么多史莱姆凝液，我也不能保证，每时每刻都能向你提供史莱姆凝液。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010618
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010618,
					"content": "所以，这个时候期货就出现了。期货不是一般的当着面一手交钱一手交货，而是一种「交易协定」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010619
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010619,
					"content": "「购买一份史莱姆凝液」和「出售一部分史莱姆凝液」都是一种「交易协定」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010620
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010620,
					"content": "在我还能提供史莱姆凝液的时候，就会向期货交易所提交出售史莱姆凝液的「交易协定」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010621
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010621,
					"content": "而你需要史莱姆凝液的时候，就可以去期货交易所查看一下购买史莱姆凝液的「交易协定」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010622
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010622,
					"content": "「期货交易」，就是精确而巧妙地购买和卖出这种「交易协定」，从而获得利润。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010623
					],
					"speakerTitle": "哈特姆"
				}
			]
		}
	]
