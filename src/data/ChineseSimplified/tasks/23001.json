						],
						"stepId": 2300102,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_ITEM_GIVING_ACTIVED",
						"rawParams": [
							"2300102"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"哈特姆"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230010201,
					"content": "怎么样？<color=#00E1FFFF>摩拉肉</color>，<color=#00E1FFFF>黄油鸡</color>和<color=#00E1FFFF>「堆高高」</color>，让我看看你选了什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "哈特姆"
				}
			]
		},
		{
			"id": 2300103,
			"completionStepIds": [
				2300103
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2300103",
							"2"
						],
						"stepId": 2300103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"哈特姆"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230010301,
					"content": "啊，我闻出来了，这份料理的香气…是财富的味道！是黄金的感觉！我感觉这次一定能大赚特赚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010302
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010302,
					"content": "多谢了，待会我要去我的「蓄财之地」，把这份「吞金料理」吃下去。二位，等我的好消息吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010303
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010303,
					"content": "「蓄财之地」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230010304
					]
				},
				{
					"id": 230010304,
					"content": "这也是我秘密致富经之一，和「吞金料理」一样，是会给我带来财运的好地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010305
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010305,
					"content": "比如那座城门。无数商人携着货款从中经过…那里的财运一定十分旺盛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010306
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010306,
