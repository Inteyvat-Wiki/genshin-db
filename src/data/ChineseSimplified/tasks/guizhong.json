			"dialogs": [
				{
					"id": 10151101,
					"content": "好了，如此一来，帮工也雇了，「永生香」也已备齐。离典仪的准备完成也不远了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151102
