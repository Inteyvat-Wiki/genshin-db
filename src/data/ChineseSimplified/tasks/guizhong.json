				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10150301,
					"content": "想不到这么巨大，不愧是仙人留下的造物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10150302,
					"content": "可是，这东西要怎么用呀，需要多大的力气才能操纵呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10150303,
					"content": "现在是操纵不了的，因为坏了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150304
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10150304,
					"content": "居然…坏了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10150305,
					"content": "毕竟历经了千年的风霜，再是仙家机关，也很难维持原样了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150306
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10150306,
					"content": "那我们可怎么办？钟离先生，快用你那无尽的「上流社会知识」想想办法呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10150307,
					"content": "唔。怎么把我说得像是…除了听戏遛鸟，别的什么都不会的纨绔子弟一样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150308
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10150308,
					"content": "我想想…嗯，其实「归终机」建设之初，为了应对战损之类情况，是准备了备用材料的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150309
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10150309,
					"content": "若没猜错，在这「古城垣」之中，一定可以寻到当年的战备室。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150310
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10150310,
					"content": "有了战备室里储存的材料，只要知道「归终机」的运作原理，想要修理也并非难事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150311
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10150311,
					"content": "这么说…钟离先生是知道原理的咯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10150312,
					"content": "略知一二。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150313
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10150313,
					"content": "只要收集了<color=#00E1FFFF>足够的材料</color>，就可以稍稍尝试一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "钟离"
				}
			]
		},
		{
			"id": 101506,
			"completionStepIds": [
				101515
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101506",
							"2"
						],
						"stepId": 101506,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10150601,
					"content": "嗯，这些备用材料应该可以派上用场了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150602
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10150602,
					"content": "请二位稍等，我来尝试修理…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150603
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10150603,
					"content": "完成了。「归终机」的结构，比我预想的还要精密一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150604
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10150604,
					"content": "唔哇，然后要怎么让它动起来呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10150605,
					"content": "很简单，只要这样…看，仙家的机关，居然还自带「望远」之效。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150617
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10150617,
					"content": "这里…没有…那里也没有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10150606,
					"content": "喂！你们几个在折腾什么！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150607
					],
					"speakerTitle": "黄麻子"
				},
				{
					"id": 10150607,
					"content": "这是…这大弩枪，被你们给收拾好了？你们乱动这东西干什么？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150608
					],
					"speakerTitle": "黄麻子"
				},
				{
					"id": 10150608,
					"content": "不是什么弩枪，是「归终机」。还有——在提问前，先报上自家姓名。这是礼仪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150609
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10150609,
					"content": "看不出来吗？哼，我们可是盗宝团的大佬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150610
					],
					"speakerTitle": "黄麻子"
				},
				{
					"id": 10150610,
					"content": "传说这一带埋藏着各种宝贝，但这大弩枪虽然是个机器，却又好像是这一带的看守一样，非常难搞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150611
					],
					"speakerTitle": "黄麻子"
				},
				{
					"id": 10150611,
					"content": "上次我们进山，有个兄弟差点被它穿成了串儿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150612
					],
					"speakerTitle": "黄麻子"
				},
				{
					"id": 10150612,
					"content": "后来是我们几个冒着性命危险，才把这大家伙弄坏了的——可一转头，你们居然又把它修好了！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150613
					],
					"speakerTitle": "黄麻子"
				},
				{
					"id": 10150613,
					"content": "我看今天，真得把你们好好修理修理！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150614
					],
					"speakerTitle": "黄麻子"
				},
				{
					"id": 10150614,
					"content": "哼。为了一己私欲，玷污仙人智慧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150615
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10150615,
					"content": "你们，更应该得到些教训。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150616
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10150616,
					"content": "#说得对！{NICKNAME}，我们上！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 101507,
			"completionStepIds": [
				101507
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101507",
							"2"
						],
						"stepId": 101507,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"七七"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10150701,
					"content": "抱歉，恕我们未能完成「契约」。名为「椰羊」的半仙之兽…我们实在没有头绪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150702
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10150702,
					"content": "啊。很失望。虽然没关系，但是很失望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150703
					],
					"speakerTitle": "七七"
				},
				{
					"id": 10150703,
					"content": "呜——看到七七这样，为什么我突然有一种超级强烈的愧疚感！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150704,
						10150705
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10150704,
					"content": "七七，还有什么别的线索吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150706
					]
				},
				{
					"id": 10150706,
					"content": "嗯…「椰羊」的奶，好喝。比一般的羊奶，好喝。所以它们，一定是半仙之兽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150707
					],
					"speakerTitle": "七七"
				},
				{
					"id": 10150707,
					"content": "对不起。我的记忆力，不好。所以我，把那种奶的名字，写下来…我，找找…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150708
					],
					"speakerTitle": "七七"
				},
				{
					"id": 10150708,
					"content": "啊，对了，就是这个，好喝的奶……叫「椰奶」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150709
					],
					"speakerTitle": "七七"
				},
				{
					"id": 10150709,
					"content": "嗯？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150710
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10150710,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150711
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10150711,
					"content": "对不起，二位。此前为与七七公平对等，我不经思考，答应得太过轻易…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150712
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10150712,
					"content": "嗯，没关系，钟离。用璃月的话说「世事无常，悲喜难料」，谁又知道结局会这么荒唐呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150713
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10150713,
					"content": "咦…七七，说了什么，错误的话吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150714
					],
					"speakerTitle": "七七"
				},
				{
					"id": 10150714,
					"content": "#{NICKNAME}，不好意思，打破小孩子幻想的事可以交给你来做么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150715,
						10150716
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10150715,
					"content": "椰奶，不是椰羊产的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150717
					]
				},
				{
					"id": 10150717,
					"content": "啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150718
					],
					"speakerTitle": "七七"
				},
				{
					"id": 10150718,
					"content": "七七好像陷入了思考。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150719,
						10150720
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10150719,
					"content": "我们不要打扰她了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150721
					]
				},
				{
					"id": 10150721,
					"content": "哈哈，真是有意义的一堂人生课啊，多谢你们照顾我家的七七了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150722
					],
					"speakerTitle": "白术"
				},
				{
					"id": 10150722,
					"content": "阁下是…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150723
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10150723,
					"content": "失礼失礼。我是这家「不卜庐」的老板，白术。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150724
					],
					"speakerTitle": "白术"
				},
				{
					"id": 10150724,
					"content": "原来老板不是七七啊——而且是个在脖子上挂了药材的怪人？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150725
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10150725,
					"content": "真可怜。七七已经够单纯了，但居然还有比七七更单纯的受骗者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150726
					],
					"speakerTitle": "白术"
				},
				{
					"id": 10150726,
					"content": "啊！那个药材…那条蛇，说、说说说说话了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150727,
						10150728
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10150727,
					"content": "蛇说话了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150729
					]
				},
				{
					"id": 10150729,
					"content": "哼，我本不想开口。熟客还行，生客的话就难免会受些惊吓。可再不说话，就要被你们拿来跟抽屉里的那些蛇干相提并论了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150730
					],
					"speakerTitle": "白术"
				},
				{
					"id": 10150730,
					"content": "哈哈哈…这位是「长生」，她没有恶意。请问几位，撇开陪七七胡闹不谈…原本来此，有何贵干呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150731
					],
					"speakerTitle": "白术"
				},
				{
					"id": 10150731,
					"content": "请问贵店，有没有「永生香」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150732
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10150732,
					"content": "哦，「永生香」啊，当然有，当然有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150733
					],
					"speakerTitle": "白术"
				},
				{
					"id": 10150733,
					"content": "呼…太好了，总算是没有白忙活半天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150734
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10150734,
					"content": "三百万摩拉，品质上等。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150735,
						10150737
					],
					"speakerTitle": "白术"
				},
				{
					"id": 10150735,
					"content": "三百万？！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150736
					]
				},
				{
					"id": 10150736,
					"content": "你去抢「黄金屋」吧！嗯…不过「黄金屋」现在被七星征用，大概会比平常更难抢吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150739
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10150739,
					"content": "嗯…三百万…乍一听也没什么，但以普遍理性而论，确实有些难办。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150740
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10150740,
					"content": "这么多摩拉！我们是不可能付得起的！——钟离先生就更不用说了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150741
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10150741,
					"content": "确实。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150742
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10150742,
					"content": "真干脆。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150743
					]
				},
				{
					"id": 10150743,
					"content": "怎么办…唉，这次，也只能再找公子求助了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150744
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10150744,
					"content": "哈哈哈哈哈哈哈哈哈——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150745
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10150745,
					"content": "椰羊…椰羊！太好玩了，你们居然被这种东西耍了一通！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150746
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10150746,
					"content": "别幸灾乐祸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150747
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10150747,
					"content": "哎，真是眼泪都要笑出来了。好吧，为了感谢你们让我这么开心，我来解决所有问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150748
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10150748,
					"content": "这位…白术老板，对吧？我是「愚人众」的执行官，「公子」。不嫌弃的话，我们未来可以多多合作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150749
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10150749,
					"content": "若「不卜庐」有需要，愚人众可以帮忙建立椰奶的快速供货渠道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150750
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10150750,
					"content": "嗯？早就听说愚人众会拉拢「道上朋友」，但「不卜庐」是只用椰奶就能收买的吗…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150751
					],
					"speakerTitle": "白术"
				},
				{
					"id": 10150751,
					"content": "椰奶，椰奶。白先生，椰奶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150752
					],
					"speakerTitle": "七七"
				},
				{
					"id": 10150752,
					"content": "好好好…那就多谢「公子」先生了，祝我们未来合作愉快。这「永生香」也打个折，算你们两百九十九万吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150753
					],
					"speakerTitle": "白术"
				},
				{
					"id": 10150753,
					"content": "三百万和两百九十九万有什么区别吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150754
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10150754,
					"content": "嗯…两百九十九万…乍一听也没什么，但以普遍理性而论，确实比三百万少了一万。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150755
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10150755,
					"content": "好了，既然事情都解决了，我们也该回玉京台了。「公子」先生、白术老板、七七小朋友，后会有期。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150756
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10150756,
					"content": "真是一群有趣的人，好久没这么笑过了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150757
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10150757,
					"content": "那么，在我来这里之前…早已潜伏的你，有「听见」什么吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150758
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10150758,
					"content": "是，「公子」大人。他们提到，「黄金屋」被七星…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150759
					],
					"speakerTitle": "叶卡捷琳娜"
				},
				{
					"id": 10150759,
					"content": "原来如此，原来如此。呵，凝光，还有七星。你们想要隐匿在黄金屋的…除了「仙祖法蜕」，还能是什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150760
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10150760,
					"content": "#对不起了，{NICKNAME}。但我早就告诫过你吧？须知璃月古谚：「隔墙有耳」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10150737,
					"content": "你去抢「黄金屋」吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150738
					]
				},
				{
					"id": 10150738,
					"content": "不过「黄金屋」现在被七星征用，大概会比平常更难抢吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150739
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10150728,
					"content": "这里是璃月，没什么奇怪的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150729
					]
				},
				{
					"id": 10150720,
					"content": "孩子的成长就是在这种时刻吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150721
					]
				},
				{
					"id": 10150716,
					"content": "椰奶的来源，是椰树。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150717
					]
				},
				{
					"id": 10150705,
					"content": "七七想要「椰羊」做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150706
					]
				}
			]
		},
		{
			"id": 101509,
			"completionStepIds": [
				101509
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101509",
							"2"
						],
						"stepId": 101509,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"七七"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10150901,
					"content": "原来在这儿！还没有柜台高！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150902,
						10150904
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10150902,
					"content": "她是…「僵尸」吗！？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150903
					]
				},
				{
					"id": 10150903,
					"content": "啊…好像是真的！额头上还贴着符咒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150908
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10150908,
					"content": "欢迎光临「不卜庐」，我是七七。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150909
					],
					"speakerTitle": "七七"
				},
				{
					"id": 10150909,
					"content": "七七已经，死过一次。后来，被仙人救了。所以是，僵尸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150910,
						10150911
					],
					"speakerTitle": "七七"
				},
				{
					"id": 10150910,
					"content": "平淡地说出了不可思议的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150912
					]
				},
				{
					"id": 10150912,
					"content": "在蒙德，这种事就完全无法想象呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150913
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10150913,
					"content": "这位…小朋友。敢问店内是否有卖「永生香」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150914
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10150914,
					"content": "请问…药方。有没有，拿药方来呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150915
					],
					"speakerTitle": "七七"
				},
				{
					"id": 10150915,
					"content": "这…买「永生香」的话，是不需要药方的吧？和治病没有关系…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150916
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10150916,
					"content": "有药方的话，七七可以，帮忙抓药。这是，七七给自己的，「敕令」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150917,
						10150918
					],
					"speakerTitle": "七七"
				},
				{
					"id": 10150917,
					"content": "「敕令」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150920
					]
				},
				{
					"id": 10150920,
					"content": "僵尸行动，需要敕令。但这位小朋友，不知为何，是自己给自己下敕令的状态。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150921
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10150921,
					"content": "七七小朋友，我们没有药方，但我们希望你帮忙找来「永生香」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150922
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10150922,
					"content": "可以哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150923
					],
					"speakerTitle": "七七"
				},
				{
					"id": 10150923,
					"content": "咦？怎么突然就可以了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150924
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10150924,
					"content": "但是，你们也要帮七七的忙，这样才公平。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150925
					],
					"speakerTitle": "七七"
				},
				{
					"id": 10150925,
					"content": "店员给顾客帮忙，原来是不公平的事吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150926
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10150926,
					"content": "呵…无妨，这样对等的关系也不错。在璃月，交易的艺术就是换位思考。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150927
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10150927,
					"content": "那请你们，到天衡山。用「归终机」，帮我狩猎「椰羊」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150928,
						10150930
					],
					"speakerTitle": "七七"
				},
				{
					"id": 10150928,
					"content": "我没太听懂…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150929
					]
				},
				{
					"id": 10150929,
					"content": "归终机…她刚刚提到的东西，我有所耳闻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150932
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10150932,
					"content": "「归终机」是远古仙人在天衡山上架设的一种弩炮，属于机关术产物的一种。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150933
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10150933,
					"content": "位置坐落在「天衡古城垣」之间，能够自行迎击体格巨大的魔物，防备来自外界的威胁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150934
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10150934,
					"content": "钟离先生真是对璃月了如指掌呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150935
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10150935,
					"content": "也并非完全如此吧…比如这个「椰羊」，我就确实没有听说过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150936
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10150936,
					"content": "「椰羊」，是传说中的，半仙之兽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150937
					],
					"speakerTitle": "七七"
				},
				{
					"id": 10150937,
					"content": "欸？就这些吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150938
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10150938,
					"content": "嗯。「椰羊」，是传说中的，半仙之兽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150939
					],
					"speakerTitle": "七七"
				},
				{
					"id": 10150939,
					"content": "长什么样子，不知道。哪里最多，不知道。什么由来，不知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150940,
						10150941
					],
					"speakerTitle": "七七"
				},
				{
					"id": 10150940,
					"content": "这就是「一问三不知」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150942
					]
				},
				{
					"id": 10150942,
					"content": "罢了…先去<color=#00E1FFFF>「归终机」</color>附近看看吧，或许到了那边就有线索了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150943
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10150943,
					"content": "「椰羊」…究竟是什么样的生物呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10150941,
					"content": "这就难办了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150942
					]
				},
				{
					"id": 10150930,
					"content": "该不会是在耍我们…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150931
					]
				},
				{
					"id": 10150931,
					"content": "不是的，她刚提到的东西，我有所耳闻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150932
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10150918,
					"content": "感觉很难交流…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150919
					]
				},
				{
					"id": 10150919,
					"content": "恐怕如她自己所说，是因为「敕令」的关系。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150920
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10150911,
					"content": "不愧是「有神之地」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150912
					]
				},
				{
					"id": 10150904,
					"content": "其实论身高的话，派蒙更…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150905
					]
				},
				{
					"id": 10150905,
					"content": "喂！我是飞着的，所以身高不重要啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150906
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10150906,
					"content": "话说回来，她看上去是不是有些奇怪，额头上还贴着符咒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150907
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10150907,
					"content": "莫非是…「僵尸」吗！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150908
					],
					"speakerTitle": "派蒙"
				}
			]
		},
