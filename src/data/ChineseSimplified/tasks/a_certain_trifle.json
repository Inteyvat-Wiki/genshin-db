				},
				{
					"id": 740350602,
					"content": "伊丝黛莱！快，快给我拿一个打字机的键帽！你这里应该有吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350603
					],
					"speakerTitle": "艾尤恩"
				},
				{
