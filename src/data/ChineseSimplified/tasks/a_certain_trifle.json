			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"艾尤恩"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740350101,
					"content": "啊…旅行者，很高兴见到你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350102,
						740350103
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740350102,
					"content": "你还好吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350104
					]
				},
				{
					"id": 740350104,
					"content": "你的黑眼圈好重，说话也没力气了，不然还是去休息一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740350105,
					"content": "我…我不能休息，昨晚上熬了一夜，写了好几稿都不行。现在我又开始重写…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350106
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740350106,
					"content": "如果您想找我办什么事的话，请再等等吧…您可以去洛耶茨先生那边搬把椅子坐下，说不定他那边还有咖啡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350107
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740350107,
					"content": "我…我得继续写了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350108
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740350108,
					"content": "不行，用「各位亲爱的同僚」总显得不够正式…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740350103,
					"content": "你看起来很不好…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350104
					]
				}
			]
		},
		{
			"id": 7403502,
