			"dialogs": [
				{
					"id": 740350301,
					"content": "打字机键帽…瑟米安，这玩意能报销吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350302
					],
					"speakerTitle": "洛耶茨"
				},
				{
					"id": 740350302,
					"content": "我不清楚。但如果打字机本身能够报销…那打字机键帽应该也能报销吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
