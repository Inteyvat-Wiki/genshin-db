							1.88,
							0,
							-0.955
						],
						"pointId": 32
					}
				]
			},
			"dialogs": [
				{
					"id": 740350201,
					"content": "旅行者，真高兴您又来这里参观，来杯咖啡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350202,
						740350203
					],
					"speakerTitle": "洛耶茨"
				},
				{
					"id": 740350202,
					"content": "这么一说…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350204
					]
				},
				{
					"id": 740350204,
					"content": "我之前也想问来着，但…但那些人说话好大声，完全不敢说别的话题…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350243
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740350243,
					"content": "我还以为会被直接赶出去。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350205
					]
				},
				{
					"id": 740350205,
					"content": "为什么？哈哈哈，不需要担心，门卫都让您进来了，我们又为什么非得自作主张，把您赶出去呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350206
					],
					"speakerTitle": "洛耶茨"
				},
				{
					"id": 740350206,
					"content": "这是权责分明的一种形式。你好旅行者，我是瑟米安，真是幸会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350207,
						740350208
					],
					"speakerTitle": "瑟米安"
				},
				{
					"id": 740350207,
					"content": "您好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350209
					]
				},
				{
					"id": 740350209,
					"content": "瑟米安先生之前供职于审判庭，做助理书记员。因为一些…乱七八糟的事而被调回了复律庭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350210
					],
					"speakerTitle": "洛耶茨"
				},
				{
					"id": 740350210,
					"content": "许多我们之前解决不了的问题，都被他用理性的精准思维找到了解决方法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350211
					],
					"speakerTitle": "洛耶茨"
				},
				{
					"id": 740350211,
					"content": "这是过誉，我只不过是将之前的工作经验照搬了过来，用事物的价值计量与其有关的事务。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350212
					],
					"speakerTitle": "瑟米安"
				},
				{
					"id": 740350212,
					"content": "虽然践行实务时会偶遇不可计量之物，但洛耶茨先生所精通之人情公理亦可为我所助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350213
					],
					"speakerTitle": "瑟米安"
				},
				{
					"id": 740350213,
					"content": "你的意思是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350214
					]
				},
				{
					"id": 740350214,
					"content": "简单来说，在处理事务时，瑟米安先生十分擅长平衡各方的心态，让每个人都意识到自己很重要。就像是将一个秤配平。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350215
					],
					"speakerTitle": "洛耶茨"
				},
				{
					"id": 740350215,
					"content": "如果实在配不平，那我也可以提供一些「言语的重量」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350216,
						740350217
					],
					"speakerTitle": "洛耶茨"
				},
				{
					"id": 740350216,
					"content": "艾尤恩好像很辛苦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350218
					]
				},
				{
					"id": 740350218,
					"content": "对呀，感觉他随时都可能昏倒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740350219,
					"content": "这是每个人的必经之路，如果现在我去帮艾尤恩写完文件，那他就记不住这次的教训了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350220
					],
					"speakerTitle": "洛耶茨"
				},
				{
					"id": 740350220,
					"content": "他总是对复律庭抱有一些不切实际的幻想。但幻想只属于年轻人，不属于复律庭职员。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350221
					],
					"speakerTitle": "洛耶茨"
				},
				{
					"id": 740350221,
					"content": "我只是不会写文件。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350222
					],
					"speakerTitle": "瑟米安"
				},
				{
					"id": 740350222,
					"content": "您倒是非常直接…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350223
					]
				},
				{
					"id": 740350223,
					"content": "好啦，您来这里到底是想要办什么事？和我说说看，看我能不能…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350224
					],
					"speakerTitle": "洛耶茨"
				},
				{
					"id": 740350224,
					"content": "艾尤恩突然慌慌张张地跑了过来…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740350225
					]
				},
				{
					"id": 740350225,
					"content": "真是倒霉透了…洛耶茨先生，您有备用的打字机键帽吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350226
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740350226,
					"content": "我刚才打字的时候，突然发现有一个键帽不知道什么时候不见了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350227
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740350227,
					"content": "你在周围找过吗？可能是就掉在地上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350228
					],
					"speakerTitle": "洛耶茨"
				},
				{
					"id": 740350228,
					"content": "或者是夹在书里，被压在文件下面…这些地方你找过吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350229
					],
					"speakerTitle": "瑟米安"
				},
				{
					"id": 740350229,
					"content": "还有笔筒和袖子里。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350230
					]
				},
				{
					"id": 740350230,
					"content": "还有头发和茶杯里！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350231
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740350231,
					"content": "都找过了，我连衣服兜和鞋底都找了个遍，根本就没有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350232
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740350232,
					"content": "好吧，你得去问问柯妮莉娅小姐，如果这东西真的有「备用部件」的话，应该也是在她那里申请。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350233
					],
					"speakerTitle": "洛耶茨"
				},
				{
					"id": 740350233,
					"content": "不然我自己去买一个得了，找伊丝黛莱订做个键帽，也花不了多少时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350234
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740350234,
					"content": "我的艾尤恩，你为什么非得自己花钱？这是复律庭的公物，找柯妮莉娅小姐申请理所应当。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350235
					],
					"speakerTitle": "洛耶茨"
				},
				{
					"id": 740350235,
					"content": "这其实花不了多少钱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350236
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740350236,
					"content": "这不是花钱多少的问题。这又是一个权责问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350237
					],
					"speakerTitle": "瑟米安"
				},
				{
					"id": 740350237,
					"content": "维修复律庭的公物，理应由复律庭的公账支出费用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350238
					],
					"speakerTitle": "瑟米安"
				},
				{
					"id": 740350238,
					"content": "要是你用私账付了这笔钱，又没有把费用报销，到年终进行公务费用审算的时候，这一笔钱可就说不清了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350239
					],
					"speakerTitle": "瑟米安"
				},
				{
					"id": 740350239,
					"content": "好吧！好吧！我这就去找柯妮莉娅小姐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350240,
						740350241
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740350240,
					"content": "怎么买东西也这么麻烦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350242
					]
				},
				{
					"id": 740350242,
					"content": "在复律庭里，这倒也正常。咱们走吧，去找柯妮莉娅小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740350241,
					"content": "就连付钱也这么麻烦吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350242
					]
				},
				{
					"id": 740350217,
					"content": "你们不能帮帮他吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350218
					]
				},
				{
					"id": 740350208,
					"content": "请问您是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
