				]
			},
			"dialogs": [
				{
					"id": 740350401,
					"content": "您好，艾尤恩先生，有什么可以帮您的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350402
					],
					"speakerTitle": "柯妮莉娅"
				},
				{
					"id": 740350402,
					"content": "柯妮莉娅小姐，您也好。请问咱们有备用的打字机键帽吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350403
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740350403,
					"content": "什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350404
					],
					"speakerTitle": "柯妮莉娅"
				},
				{
					"id": 740350404,
					"content": "我的打字机少了一个键帽，我想申请一个备用键帽换上。要是没有的话…帮我报销一个也成。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350405
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740350405,
					"content": "报销键帽…从原则上来说，倒是没有问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350406
					],
					"speakerTitle": "柯妮莉娅"
				},
				{
					"id": 740350406,
					"content": "您在这签个字吧。就写「因打字机故障，需报销键帽一枚」，然后签上您的名字，还有办公室名。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350407
					],
					"speakerTitle": "柯妮莉娅"
				},
				{
					"id": 740350407,
					"content": "好了，我今天应该能拿到这枚键帽吧，我还急着去工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350408
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740350408,
					"content": "艾尤恩先生，您之前报销过公物吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350409
					],
					"speakerTitle": "柯妮莉娅"
				},
				{
					"id": 740350409,
					"content": "公物报销并不是您想象那样…来一件就报销一件，我们需要先以月为统计时间汇总报销单据，然后在月底统一交给枢律庭审批。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350410
					],
					"speakerTitle": "柯妮莉娅"
				},
				{
					"id": 740350410,
					"content": "这审批事关整个复律庭的工资发放，如果报销的数额过大，枢律庭甚至需要呈给那维莱特大人审阅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350427
					],
					"speakerTitle": "柯妮莉娅"
				},
				{
					"id": 740350427,
					"content": "等他整体审阅完毕再签字后，才能正式开始拨款。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350411
					],
					"speakerTitle": "柯妮莉娅"
				},
				{
					"id": 740350411,
					"content": "如果那维莱特大人对某个报销条目有疑问，对应的人员还需要提交一份书面说明…我们正准备这几天就把第一批提交上去呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350412
					],
					"speakerTitle": "柯妮莉娅"
				},
				{
					"id": 740350412,
					"content": "你的意思是，如果我运气不好的话，想报销这枚键帽还得那维莱特大人点头？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350413
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740350413,
					"content": "规定如此，艾尤恩先生。而且这个月要报销的数额不小，很可能确实需要那维莱特大人审阅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350414
					],
					"speakerTitle": "柯妮莉娅"
				},
				{
					"id": 740350414,
					"content": "那维莱特大人…不就是那位「最高审判官」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740350415,
					"content": "只不过是一个键帽，还要让他来签字…总感觉哪里不太对…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350416,
						740350417
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740350416,
					"content": "有没有别的方法？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350418
					]
				},
				{
					"id": 740350418,
					"content": "我也这么想，只是一枚键帽而已，不用惊动那维莱特大人的大驾，真的不用了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350419
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740350419,
					"content": "倒是有别的方法。嗯…你可以先自己去买一枚键帽，然后我会在公账里给您打一个白条。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350420
					],
					"speakerTitle": "柯妮莉娅"
				},
				{
					"id": 740350420,
					"content": "在报销流程走完，款项拨下来之后，再将对应的费用从公账里拨付给您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350421
					],
					"speakerTitle": "柯妮莉娅"
				},
				{
					"id": 740350421,
					"content": "好极了！就这样吧，一枚键帽也花不了多少钱，我付得起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350422
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740350422,
					"content": "那您在这里签个字，还是写「因打字机故障，需报销键帽一枚」…您是去伊丝黛莱小姐那买键帽吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350423
					],
					"speakerTitle": "柯妮莉娅"
				},
				{
					"id": 740350423,
					"content": "是的，怎么了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350424
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740350424,
					"content": "我稍后会拿着这张白条去找洛耶茨先生签字，然后再去找伊丝黛莱小姐核对账单。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350425
					],
					"speakerTitle": "柯妮莉娅"
				},
				{
					"id": 740350425,
					"content": "您就不用管这些事了，快点去买键帽吧，其他的事交给我处理就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350426
					],
					"speakerTitle": "柯妮莉娅"
				},
				{
					"id": 740350426,
					"content": "谢谢您。您真是太好了，柯妮莉娅小姐，我这就去买键帽…走吧旅行者，我们快出发。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740350417,
					"content": "不然还是换个方法吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350427
					]
				}
			]
		},
