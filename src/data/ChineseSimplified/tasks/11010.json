					"nextDialogs": [
						110100357,
						110100358
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100357,
					"content": "这是什么兄弟攻势…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100359
					]
				},
				{
					"id": 110100359,
					"content": "有劳了，这些钱交给你们，就当是活动资金，请带托克在璃月随便转转吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100360
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100360,
					"content": "如果遇上什么万不得已的情况，就来<color=#00E1FFFF>青墟浦附近的河边</color>找我，回见！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
