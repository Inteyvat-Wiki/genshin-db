					"nextDialogs": [
						110100354
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100354,
					"content": "还要我们做保姆吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100355
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110100355,
					"content": "#嗯！托克喜欢和好人{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}一起，而且我们拉过勾了，约好要照顾托克的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100356
					],
					"speakerTitle": "托克"
				},
				{
					"id": 110100356,
					"content": "嗯，托克喜欢和你一起，而且你们拉过勾了，约好要照顾托克的。",
