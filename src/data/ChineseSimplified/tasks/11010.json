			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「公子」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110100301,
					"content": "这样不合适吧，执行官大人，您怎么能…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100302
					],
					"speakerTitle": "叶卡捷琳娜"
				},
				{
					"id": 110100302,
					"content": "偶尔一次嘛，没关系没关系！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100303
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100303,
					"content": "哦？这个人怎么也在这…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110100304,
					"content": "哥哥！哥哥、哥哥！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100305
					],
					"speakerTitle": "托克"
				},
				{
					"id": 110100305,
					"content": "啊这声音是…托克！天啊，是托克！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100306
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100306,
					"content": "哈哈哈…这是你给我准备的惊喜吗，托克？我还以为要等我回了至冬才能见到你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100307
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100307,
					"content": "你的冬妮娅姐姐，还有安东哥哥…他们怎么样？过得好不好？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100308
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100308,
					"content": "他们都可想你了，冬妮娅姐姐每天晚饭前都在祷告，祈求哥哥的平安…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100309
					],
					"speakerTitle": "托克"
				},
				{
					"id": 110100309,
					"content": "…等等，不对，托克！你是怎么来璃月的，我怎么没接到任何消息…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100310
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100310,
					"content": "唔，这个…我见到一艘像是卖玩具的船，还以为哥哥在上面…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100311
					],
					"speakerTitle": "托克"
				},
				{
					"id": 110100311,
					"content": "下了船以后我走啊走，然后就见到了「独眼小宝」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100312
					],
					"speakerTitle": "托克"
				},
				{
					"id": 110100312,
					"content": "#「独眼小宝」赶走了一个坏蛋，再然后，我就跟着好人{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}过来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100313,
						110100315
					],
					"speakerTitle": "托克"
				},
				{
					"id": 110100313,
					"content": "居然是偷渡吗！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100314
					]
				},
				{
					"id": 110100314,
					"content": "而且…托克居然是「公子」的弟弟吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110100316,
					"content": "那看来托克的钱，我们收得心安理得呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110100317,
					"content": "这太危险了托克，见到你我的确很开心，但是答应哥哥，以后不许做这样冒险的事情了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100318
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100318,
					"content": "唔…托克知道了，哥哥，请你不要生我的气…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100319
					],
					"speakerTitle": "托克"
				},
				{
					"id": 110100319,
					"content": "哥哥没有生气，我只是在担心你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100320
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100320,
					"content": "如果不是遇上了这两位，托克的处境可能就危险了。有好好道谢过了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100321
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100321,
					"content": "嗯！托克可懂礼貌了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100322
					],
					"speakerTitle": "托克"
				},
				{
					"id": 110100322,
					"content": "终于注意到我们了吗，「公子」哥哥？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110100323,
					"content": "哈哈哈哈，真是不好意思，与家人的交流无论何时都是该放在第一位的，还请你们谅解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100324
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100324,
					"content": "还有，虽然之前我们有过一些对立的经历，不过抛开那些立场上的问题…我们不是相处得挺愉快的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100325,
						110100326
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100325,
					"content": "这只是场面话吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100327
					]
				},
				{
					"id": 110100327,
					"content": "呵呵，关于「那件事」，我们都不过是棋子而已。至于棋局的胜负和收拾棋盘的工作…就交给那些对弈的人吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100328
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100328,
					"content": "而我真正在乎的，只有我们之间，那一战的胜负而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100329
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100329,
					"content": "怎么，你还想再输一次吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100330
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110100330,
					"content": "哈，我可是每一秒都在变强的达达利亚，下次请做好苦战的准备。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100331,
						110100332
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100331,
					"content": "我也已经不是那时的我了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100333
					]
				},
				{
					"id": 110100333,
					"content": "喂喂，你们现在就要打吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100334
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110100334,
					"content": "哈哈哈…这次就算了，打架会教坏小孩子的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100335
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100335,
					"content": "#打架？哥哥和好人{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}关系不好吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100336
					],
					"speakerTitle": "托克"
				},
				{
					"id": 110100336,
					"content": "#没有没有，怎么会呢？{NICKNAME}，容我正式感谢你护送我的弟弟，他的安危对我来说真的很重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100337,
						110100338
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100337,
					"content": "我还是会提防你的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100339
					]
				},
				{
					"id": 110100339,
					"content": "话说…我忽然想起一件事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100340
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110100340,
					"content": "托克说，哥哥是「玩具销售员」是怎么回事？你不是愚人众的执行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100341
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110100341,
					"content": "咳咳…嗯…啊~！你说那个呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100342
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100342,
					"content": "嘘…因为小孩子眼里，卖玩具是最让人羡慕的工作吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100343
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100343,
					"content": "而且，我不想让家人接触到愚人众的…或者说至冬国的…阴暗面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100344
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100344,
					"content": "虽说年长一些的弟弟妹妹们都已经知道我在为女皇陛下效力了，但在最小的弟弟眼里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100345
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100345,
					"content": "咳咳，我依旧是至冬最出色的外派玩具销售员，暂时隶属于璃月分部的「玩具研究所」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100346
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100346,
					"content": "就是就是，我哥哥超厉害的！是「独眼小宝」的好伙伴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100347
					],
					"speakerTitle": "托克"
				},
				{
					"id": 110100347,
					"content": "这件事请一定在托克面前配合我，拜托拜托…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100348
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100348,
					"content": "哦对了，叶卡捷琳娜小姐，收钱的事，我现在就准备动身了。",
