			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"戴派"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110100101,
					"content": "当心，旅人。最近可不是观光的好时候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100102
					],
					"speakerTitle": "戴派"
				},
				{
					"id": 110100102,
					"content": "咦，最近出什么事了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110100103,
					"content": "嗯。总部接到多起目击报告，有一些本不该出现的遗迹守卫，晃荡在本不该出现的地区。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100104
					],
					"speakerTitle": "戴派"
				},
				{
					"id": 110100104,
					"content": "教头派人追查这些古代机器的来源，发现似乎是从一处遗迹里突然冒出来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100105
					],
					"speakerTitle": "戴派"
				},
				{
					"id": 110100105,
					"content": "是谁把它们吵醒了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110100106,
					"content": "不清楚，我们获知的情报太少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100107
					],
					"speakerTitle": "戴派"
				},
				{
					"id": 110100107,
					"content": "况且那遗迹阴森森的，里面不时还会传出「咔啦咔啦」的响声…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100108
					],
					"speakerTitle": "戴派"
				},
				{
					"id": 110100108,
					"content": "在总部的批准下达之前，我们是不被允许进入探索的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100109,
						110100110
					],
					"speakerTitle": "戴派"
				},
				{
					"id": 110100109,
					"content": "确实是谨慎为妙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100113
					]
				},
				{
					"id": 110100113,
					"content": "总之目前最好的策略，就只有加强巡逻，避免一般民众受到波及了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100114
					],
					"speakerTitle": "戴派"
				},
				{
					"id": 110100114,
					"content": "唔，普通人撞上遗迹守卫的话，可就危险了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110100115,
					"content": "我能帮忙吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100116
					]
				},
				{
					"id": 110100116,
					"content": "呃，你的心意我十分感谢，可是…万一让你因此陷入危险，那可就得不偿失了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100117
					],
					"speakerTitle": "戴派"
				},
				{
					"id": 110100117,
					"content": "#{NICKNAME}{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}可是很能打的，你放心啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100118,
						110100120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110100118,
					"content": "没关系的，我会一点防身术。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100119
					]
				},
				{
					"id": 110100119,
					"content": "这样啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100122
					],
					"speakerTitle": "戴派"
				},
				{
					"id": 110100122,
					"content": "既然如此…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100123
					],
					"speakerTitle": "戴派"
				},
				{
					"id": 110100123,
					"content": "我之前在<color=#00E1FFFF>山坡上</color>见到了一些遗迹守卫的脚印，但后来光顾着警告附近的路人，还没来得及开展调查…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100124
					],
					"speakerTitle": "戴派"
				},
				{
					"id": 110100124,
					"content": "嗯，要从这条线索开始调查吗？交给我们吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110100125,
					"content": "「千岩牢固，重嶂不移」，向你致敬，旅行者。等我这一遍巡逻完，会再来与你们汇合的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "戴派"
				},
				{
					"id": 110100120,
					"content": "这么讲很不礼貌，但我能打十个你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100121
					]
				},
				{
					"id": 110100121,
					"content": "哈哈，年轻人很自信嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100122
					],
					"speakerTitle": "戴派"
				},
				{
					"id": 110100110,
					"content": "办事效率好低。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100111
					]
				},
				{
					"id": 110100111,
					"content": "嗯？你刚才说了什么吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100112
					],
					"speakerTitle": "戴派"
				},
				{
					"id": 110100112,
					"content": "喂，你的口吻怎么像迪卢克老爷评判骑士团一样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100113
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 1101002,
			"completionStepIds": [
				1101004
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101004",
							"2"
						],
						"stepId": 1101004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"托克"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110100201,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}快看！好大，好威风！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100202
					],
					"speakerTitle": "托克"
				},
				{
					"id": 110100202,
					"content": "咦，是个装扮奇怪的小朋友…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110100203,
					"content": "我还是第一次这么近距离看呢，你们认识它嘛？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100204,
						110100206
					],
					"speakerTitle": "托克"
				},
				{
					"id": 110100204,
					"content": "是失去动力的「遗迹守卫」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100205
					]
				},
				{
					"id": 110100205,
					"content": "错啦错啦，什么「遗迹守卫」，它的名字是「独眼小宝」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100208
					],
					"speakerTitle": "托克"
				},
				{
					"id": 110100208,
					"content": "「独眼小宝」？…原来还有这么可爱的叫法吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110100209,
					"content": "嗯！是我哥哥告诉我的，我哥哥是最厉害的玩具销售员，专门卖这种玩具的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100210
					],
					"speakerTitle": "托克"
				},
				{
					"id": 110100210,
					"content": "他现在在璃月的「玩具研究所」工作，「独眼小宝」就是在那里出生的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100211
					],
					"speakerTitle": "托克"
				},
				{
					"id": 110100211,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}你应该也很喜欢玩具吧，你身边飘着的这只是最新款吗？居然还会说话！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100212,
						110100214
					],
					"speakerTitle": "托克"
				},
				{
					"id": 110100212,
					"content": "派蒙和遗迹守卫都不是玩具…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100213
					]
				},
				{
					"id": 110100213,
					"content": "是的！没错！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110100216,
					"content": "辛苦你们了，有什么头绪吗…嗯？这个外国的小朋友是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100217
					],
					"speakerTitle": "戴派"
				},
				{
					"id": 110100217,
					"content": "是刚刚我们偶然遇到的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110100218,
					"content": "这可不行，小朋友。这一带有杀人机器在游荡着，很危险的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100219
					],
					"speakerTitle": "戴派"
				},
				{
					"id": 110100219,
					"content": "「杀人机器」？叔叔是说，像这个样子的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100220
					],
					"speakerTitle": "托克"
				},
				{
					"id": 110100220,
					"content": "是的没错，包括这只也是一样，万一忽然动起来可就糟了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100221
					],
					"speakerTitle": "戴派"
				},
				{
					"id": 110100221,
					"content": "才不是什么杀人机器！「独眼小宝」是正义的伙伴，不许你这么说！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100222
					],
					"speakerTitle": "托克"
				},
				{
					"id": 110100222,
					"content": "独…独眼什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100223
					],
					"speakerTitle": "戴派"
				},
				{
					"id": 110100223,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}，这个叔叔在说「独眼小宝」的坏话，所以他肯定是坏人，我们千万不要理他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100224
					],
					"speakerTitle": "托克"
				},
				{
					"id": 110100224,
					"content": "小朋友，我只是出于好心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100225,
						110100226
					],
					"speakerTitle": "戴派"
				},
				{
					"id": 110100225,
					"content": "他已经不会听你的话了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100227
					]
				},
				{
					"id": 110100227,
					"content": "真没办法，我一向不擅长应付小孩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100228
					],
					"speakerTitle": "戴派"
				},
				{
					"id": 110100228,
					"content": "你快继续忙你的事情吧，我们会保证他的安全的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100229
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110100229,
					"content": "好吧，也只能这样了…那我继续在附近巡逻，请你们把小朋友带到安全的地方去吧，这里还是太危险了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100230
					],
					"speakerTitle": "戴派"
				},
				{
					"id": 110100230,
					"content": "哼~哼~「独眼小宝」又吓跑了坏蛋~！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100231,
						110100232
					],
					"speakerTitle": "托克"
				},
				{
					"id": 110100231,
					"content": "你叫什么名字，小朋友？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100233
					]
				},
				{
					"id": 110100233,
					"content": "啊，我是托克！托克是从遥远的至冬国来璃月找哥哥的，可是托克一个人，不知道哥哥在哪里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100234
					],
					"speakerTitle": "托克"
				},
				{
					"id": 110100234,
					"content": "居然是至冬国来的啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100235
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110100235,
					"content": "对了，这种时候的话…这个，给！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100236
					],
					"speakerTitle": "托克"
				},
				{
					"id": 110100236,
					"content": "嗯？什么东西…沉甸甸的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100237
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110100237,
					"content": "这是…！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100238,
						110100239
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110100238,
					"content": "好多摩拉！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100240
					]
				},
				{
					"id": 110100240,
					"content": "这些是我哥哥让我带在身上的，我哥哥说了，把这些交给好人，好人就会对托克好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100241
					],
					"speakerTitle": "托克"
				},
				{
					"id": 110100241,
					"content": "好、好像很有道理…能从至冬来璃月难道就是靠这个吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100242
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110100242,
					"content": "看来托克是个大户人家的孩子啊，原来卖玩具是这么赚钱的生意吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100243,
						110100244
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110100243,
					"content": "我收下了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100245
					]
				},
				{
					"id": 110100245,
					"content": "#唔哇，真的吗！谢谢好人{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100246
					],
					"speakerTitle": "托克"
				},
				{
					"id": 110100246,
					"content": "那么，和托克拉勾吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100247
					],
					"speakerTitle": "托克"
				},
				{
					"id": 110100247,
					"content": "「拉勾拉勾不许变，变了丢他去冰川。冰川冷，雪原寒，撒谎的舌头全冻烂！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100248
					],
					"speakerTitle": "托克"
				},
				{
					"id": 110100248,
					"content": "真是残酷得很有至冬国特色的童谣呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100249
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110100249,
					"content": "既然如此，只好当一段时间保姆了呀…可是，要到哪里去找他的哥哥呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100250,
						110100252
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110100250,
					"content": "和至冬国关系密切的地方…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100251
					]
				},
				{
					"id": 110100251,
					"content": "和至冬国关系密切…对了，那就去<color=#00E1FFFF>北国银行</color>问问看吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100254
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110100254,
					"content": "要出发了吗？托克终于又要见到哥哥啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "托克"
				},
				{
					"id": 110100252,
					"content": "<color=#00E1FFFF>北国银行</color>？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100253
					]
				},
				{
					"id": 110100253,
					"content": "嗯，好主意！到那边去问问看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100254
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110100244,
					"content": "我收下了（见到他哥哥就还回去吧…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100245
					]
				},
				{
					"id": 110100239,
					"content": "好多好多摩拉！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100240
					]
				},
				{
					"id": 110100232,
					"content": "你的家人在哪里？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100233
					]
				},
				{
					"id": 110100226,
					"content": "还是交给我吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100227
					]
				},
				{
					"id": 110100214,
					"content": "嗯，羡慕吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100215
					]
				},
				{
					"id": 110100215,
					"content": "喂！我怎么又成了新的奇怪东西！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110100206,
					"content": "当心，它很难对付。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100207
					]
				},
				{
					"id": 110100207,
					"content": "没错！「独眼小宝」超~~~厉害的，没有坏蛋能逃过它的手掌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100208
					],
					"speakerTitle": "托克"
				}
			]
		},
		{
			"id": 1101003,
			"completionStepIds": [
				1101006
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101006",
