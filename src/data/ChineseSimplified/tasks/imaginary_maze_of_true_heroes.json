			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"左右加"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2206.687,
							230.089,
							-800.541
						],
						"pointId": 8529
					},
					{
						"sceneId": 3,
						"position": [
							2206.934,
							230.089,
							-799.25
						],
						"pointId": 8530
					},
					{
						"sceneId": 3,
						"position": [
							2207.723,
							230.089,
							-799.45
						],
						"pointId": 8531
					}
				]
			},
			"dialogs": [
				{
					"id": 746760101,
					"content": "嗯哼哼，我有一种预感…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760102
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 746760102,
					"content": "我历经千辛万苦，来到了两位传奇人物的故事开始的地方，看在我这么努力的份上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760103
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 746760103,
					"content": "#命运也一定会眷顾我！用不了多久，{M#他们}{F#她们}一定会和我再次相遇！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760104
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 746760104,
					"content": "这个人在嘀咕什么呢？看她的衣服，好像不是蒙德本地人…难道是从稻妻来的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746760105,
					"content": "果不其然，你们这么快就出现了。来一个重逢的欢呼吧，「智巧勇武双连星」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760106,
						746760108
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 746760106,
					"content": "好久不见，老朋友！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746760107
					]
				},
				{
					"id": 746760107,
					"content": "居然是左右加小姐？没想到能在蒙德遇见你，真的是个超大的惊喜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746760111,
					"content": "不过，左右加之前不是一直陪着海妮耶，在筹办之后的赛事吗？怎么一个人跑到蒙德来了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746760112,
					"content": "面前还摆着好多好多书，看起来…好像要给路过的人推荐小说？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746760113,
					"content": "啊呀，这主要是因为——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760114
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 746760114,
					"content": "八重堂的编辑们在追杀我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760115
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 746760115,
					"content": "追杀？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746760116,
					"content": "放心放心，不是真的要干掉我，只是在用一切手段要求我交出稿子而已，编辑们也是为了我着想啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760117
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 746760117,
					"content": "作为曾经热门的轻小说作者，我需要不断产出作品，满足读者的需求，维持我本人的热度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760118
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 746760118,
					"content": "读者读书的速度是无限快的，如果我写得不够拼命，用不了多久就会被海量新作淹没…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760119
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 746760119,
					"content": "但我又不愿意把蕈兽伙伴们的故事草草写完，毕竟一部好的小说需要时间来构思，慢慢打磨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760120
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 746760120,
					"content": "可以的话，我希望能把蕈兽伙伴们的故事整本写完，反复修改后再公开，而不是匆忙连载，赶着每一期的死线去发表。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760121
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 746760121,
					"content": "所以我只能新开一部本阶段的主力作品，写个相对简单好把控的故事，让读者们暂且不要忘了我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760122,
						746760123
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 746760122,
					"content": "这也太累了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746760124
					]
				},
				{
					"id": 746760124,
					"content": "怎么还有这种事…我以前还以为轻小说作者都很轻松呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746760125,
					"content": "到处玩一玩，取取材，找找灵感，灵感来了就一鼓作气写完稿子，然后哗哗赚稿费，快快乐乐过日子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746760126,
					"content": "你想的那种情况，只有天赋型选手才能做到啦，大部分作者光是构思今天要写的章节和取材，就已经精疲力竭了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760127
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 746760127,
					"content": "只要写的章节够多，都会陷入瓶颈，我也好不到哪里去，要不然也不会根据一则民间传说，大老远跑来蒙德…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760128,
						746760129
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 746760128,
					"content": "看来这个民间传说很关键了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746760130
					]
				},
				{
					"id": 746760130,
					"content": "完全正确！而且我要结合图片和播音机关，打造出一本视觉和听觉二重奏的，拥有立体阅读体验的小说！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760131
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 746760131,
					"content": "这本新概念作品的主题则是「超凡强者的迷宫冒险」——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760132
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 746760132,
					"content": "拥有绝妙能力的强者误入邪恶法师构筑的迷宫，不断破除复杂的机关和陷阱，发掘迷宫深处的秘密…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760133
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 746760133,
					"content": "然后还没想好怎么编。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760134
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 746760134,
					"content": "喂！我的兴趣刚才刚被你勾起来啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746760135,
					"content": "故事的核心矛盾，叙事的节奏之类的问题，我会仔细考虑的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760136
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 746760136,
					"content": "作为连载作品，最重要的是抓住读者们的心弦，迷宫中遇见的各种难题才是关键要素。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760137
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 746760137,
					"content": "正巧我打探到消息，蒙德境内有一个遍布奇妙机关的复杂秘境，就第一时间赶过来，找到了它，仔细在里边探查了一番…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760138
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 746760138,
					"content": "你做事还是那么风风火火的…那你有在里面找到迷宫难题的灵感吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746760139,
					"content": "灵感倒是找到了，但还没有精彩的解法，这样也没法构成像样的情节…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760140
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 746760140,
					"content": "我被普通的陷阱机关揍得鼻青脸肿，海妮耶小姐的衣服都破了，才勉强收集了足够的情报，写了几个重要段落的脚本。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760141
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 746760141,
					"content": "归根结底，我不是什么超凡强者，没有任何奇妙的能力，自然想不出具体的对策。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760142
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 746760142,
					"content": "换成你们两位大名鼎鼎的「智巧勇武双连星」的话，就完全不成问题了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760143
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 746760143,
					"content": "虽然不意外，但我们明显也不会飞天遁地啦，你怎么一下就想到了我们？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760144
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746760144,
					"content": "这个嘛，要说取材，肯定不可能把各种能人志士请过来，而是需要一位熟知各种强者的中间人协助我，在秘境中进行推演。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760145
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 746760145,
					"content": "#{NICKNAME}是我认知中见识最多的、人脉最广的、提瓦特最受欢迎的人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760146
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 746760146,
					"content": "顺着我提供给你的脚本，沉浸在文字、映影画片和想象的世界里，找到最佳的状态以后…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760147
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 746760147,
					"content": "你肯定能根据大致所需的能力，回想起合适的强者，推测这些强者在险恶迷宫中会采取的对策！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760148,
						746760149
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 746760148,
					"content": "咦？我吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746760150
					]
				},
				{
					"id": 746760150,
					"content": "听起来蛮新奇的！根据小说文字和画片进行想象…我们好像也变成了作者，以前我们还没尝试过这种事呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760151
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746760151,
					"content": "假设我们认识的各种人来面对遍布机关的秘境，确实有可能发展出许多…普通人想不到的情节？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760152
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746760152,
					"content": "没错吧，果然很合适！这样一来，我们就能联合完成新书的设计了，一定能写出大卖的轻小说！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760153
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 746760153,
					"content": "到时候，我肯定还要给你联合作者的署名，稿费我们一起分！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760154
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 746760154,
					"content": "不愧是我们的老朋友，这方面完全不和我们吝啬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760155
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746760155,
					"content": "那我们也要拿出干劲，好好表现一番了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746760149,
					"content": "好像确实挺合适的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746760150
					]
				},
				{
					"id": 746760129,
					"content": "是不是和桌上的书有关系？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746760130
					]
				},
				{
					"id": 746760123,
					"content": "这也没办法…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746760124
					]
				},
				{
					"id": 746760108,
					"content": "慢着，您哪位来着？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746760109
					]
				},
				{
					"id": 746760109,
					"content": "等等，你好像有点眼熟…难道是左右加小姐？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746760110,
					"content": "#{NICKNAME}，你可能有点不记得了，左右加小姐是我们在蕈兽大赛认识的作家，一直在帮海妮耶和我们照料蕈兽伙伴…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760111
					],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}