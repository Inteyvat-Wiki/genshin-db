					]
				},
				{
					"id": 732321917,
					"content": "来自坎瑞亚的蒙面剑士，我们认识的人里面也…该不会是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321918
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732321918,
					"content": "哦？你们果然认识吗，这样的话解释起来就方便多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321921
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732321921,
					"content": "那之后不久，从沙漠的东方来了一群学者装束的人，为首的是一位独臂的贤者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321922
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732321922,
					"content": "他们自称是曾与荼诃人的勇士并肩作战之人。据他们所说，那是一群即便知道已背负上污名，却依然循着本愿而行的勇士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321923
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732321923,
					"content": "背负着勇士们的遗愿，为了彻底消除黑渊的灾祸，他们循着勇士们曾走过的道路而溯行至此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321924
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732321924,
					"content": "后来，我们共同进入了荼诃人留下的遗迹，发现了那些曾经与魔物对抗的机关，它们也隶属于曾与学者们并肩作战的战团。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321925
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732321925,
					"content": "最后独臂的贤者靠着荼诃人留下的文献，找到了得以穿过黑渊进入母树的方法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321926
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732321926,
					"content": "于是我们便一同进入母树，用甘露净化了天上与地上的污秽。此后花海中不断有花灵诞生，地上的魔物则渐渐消失。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321927
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732321927,
					"content": "#后来，蒙面的剑士随一位与你有着同样金色头发的{M#少女}{F#少年}离开了花海，贤者则独自进入地下的遗迹再也没有回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321928
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732321928,
					"content": "剩下的人则与新生的花灵结成了伙伴，自称为「矫论团」，在这里生活了下来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321929
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732321929,
					"content": "如今金发的勇士又回到了花海，虽然不是当初的那位，不过我也能感受到某些东西又开始重新流逝了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321930
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732321930,
					"content": "这也是为什么我一开始就选择了拜托你们的原因啊，有你们在我就不用再想着去哪找出一位能与花灵并肩作战的勇士了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321931
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732321931,
					"content": "教导人类的工作可是很辛苦的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321932
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732321932,
					"content": "怎么你们花灵一个比一个懒啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321933
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732321933,
					"content": "喂，白飘飘说的这话可别带上我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321934
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732321934,
					"content": "哎呀，既然完成了「祭水之仪」，污秽一时半会也没办法威胁这里，我也可以趁机好好休息了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321935
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732321935,
					"content": "至于斯露莎，我就把她交给你们了，你们可要在旅途中好好教导她，毕竟这也算是「谒颂主」的工作呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321936
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732321936,
					"content": "我才不想被白飘飘指导…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321937
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732321937,
					"content": "嘿嘿，斯露莎可要好好听话！不过怎么祖尔宛说的就像是以后不会再见面了一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321938
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732321938,
					"content": "反正你们又不会留在这里陪我，你们这些人都一样啦，永远也不打算停下脚步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321939,
						732321940
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732321939,
					"content": "我们还会回来的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732321941
					]
				},
				{
					"id": 732321941,
					"content": "哎呀，我是不会再相信这种话了，毕竟已经不是第一次听了哪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321942
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732321942,
					"content": "说起这个，也不知道那位蒙面的剑士现在怎么样了，你们要是见到他可要帮我问好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321943
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732321943,
					"content": "毕竟你们都是旅人嘛，总是会有机会见面的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321944
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732321944,
					"content": "好啦，你们该回到属于你们的地方去了，可别太想我哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732321940,
					"content": "还会有机会见面的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732321941
					]
				},
				{
					"id": 732321919,
					"content": "身负诅咒…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732321920
					]
				},
				{
					"id": 732321920,
					"content": "嗯，据说那场灾厄之中，荼诃人都受到了不同程度的诅咒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321921
					],
					"speakerTitle": "祖尔宛"
				}
			]
		},
		{
			"id": 7323224,
			"completionStepIds": [
				7323224
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7323224",
							"2"
						],
						"stepId": 7323224,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"斯露莎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732322401,
					"content": "这下所有的「慈心」都带回到莲花里来了，按照刚才斯露莎说的，应该已经可以唤醒神明的「神识」了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732322402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732322402,
					"content": "那么，真正的「祭水之仪」就要开始了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732322403
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732322403,
					"content": "接下来我会借助灵光的力量，使「伽乌迦那」重新开出圣洁之花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732322404
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732322404,
					"content": "不过这也会释放出圣莲所积攒的污秽，污秽将化为魔物阻碍我们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732322405
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732322405,
					"content": "不过没关系，只要神明大人的「神识」被唤醒了，甘露的力量也会庇护我们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732322406
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732322406,
					"content": "只要圣洁之花长成，它便能将甘露播散到整个大地，净化所有的污秽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732322407
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732322407,
					"content": "这便是属于勇者的终末之战了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "斯露莎"
				}
			]
		},
		{
			"id": 7323225,
			"completionStepIds": [
				7323225
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7323225",
							"2"
						],
						"stepId": 7323225,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凯瑟琳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732322501,
					"content": "凯瑟琳小姐，我们回来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732322502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732322502,
					"content": "欢迎回来，我已经收到教令院的反馈了，没想到你们真的成功解决掉那个奇异天象了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732322503
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 732322503,
					"content": "可以说是超出预期了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732322504
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 732322504,
					"content": "欸？我记得凯瑟琳小姐不是说，我们是最合适的人选吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732322505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732322505,
					"content": "该不会你对每个人都会说同样的话吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732322506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732322506,
					"content": "怎么会，我当然相信你们可以完成这个委托了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732322507
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 732322507,
					"content": "对了，之前还有拜托你们先联系到「那迦朱那团」。不知道他们是不是帮上什么忙了呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732322508,
						732322509
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 732322508,
					"content": "有点复杂…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732322510
					]
				},
				{
					"id": 732322510,
					"content": "看来发生了很多故事呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732322511
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 732322511,
					"content": "不过不管发生什么样的事情，都是冒险的一部分。对于冒险家来说，都是难得的宝物呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732322512
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 732322512,
					"content": "既然顺利完成了委托，协会应该也可以获得坎瑞亚遗迹的调查许可了，如果有相关委托的话，我也会优先考虑你们的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732322513
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 732322513,
					"content": "不过说起来，虽然做了这么多事情，我们都还不知道委托人是谁呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732322514
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732322514,
					"content": "这个嘛…冒险家协会有义务为委托人保密，没办法直接向你们透露。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732322515
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 732322515,
					"content": "不过将信物交给我们的那位先生，倒是自称是什么轻小说作家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732322516
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 732322516,
					"content": "轻小说作家？听起来有点耳熟，我记得之前也提到过矫论团有一位前辈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732322517
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732322517,
					"content": "看来你们是知道些什么呢，不过这些事情就与协会无关了。那么教令院的报酬已经放在我这里了，就请你们收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 732322509,
					"content": "算是帮上忙了吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732322510
					]
				}
			]
		}
	]
}