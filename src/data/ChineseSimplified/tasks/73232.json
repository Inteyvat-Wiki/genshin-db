			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"斯露莎",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732320301,
					"content": "这里是，那棵大树桩子的上面吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732320302,
					"content": "明明好不容易才穿过了大窟窿到达这里，怎么又被拦住了啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732320303,
					"content": "按理来说我已经获得了「双角的花冠」，应该不会被母树拒绝的才对…呜呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320304
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732320304,
					"content": "唔，怎么了斯露莎，你看上去好像很难受的样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732320305,
					"content": "呜呜…是「双角的花冠」…好像有什么东西在涌进来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320306
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732320306,
					"content": "哇啊，斯露莎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732320380,
					"content": "古树的根脉纵横交错，每一个连接处都发出微弱的光芒。\\n随着隙间光影交错，一个又一个画面闪过。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 732320381,
					"content": "在荒莽的群山中，勇士们手持各色武具，身后则是连成一线的花灵。\\n即便黑云压境，也未后退分毫。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 732320382,
					"content": "在漆黑的渊底下，巨大的机械闪耀着微光。\\n在熊熊黑火的灼烧之中，掩护着逃生的人群。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 732320383,
					"content": "在无边的荒原上，蒙面的剑士与独臂的贤者相背而立。\\n在灵光的庇佑下，对抗着潮水般涌来的魔物。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 732320384,
					"content": "灵光指引着所有人的前路，也化为所有人的归途。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 732320385,
					"content": "无数的光芒汇聚为极小的光点，白光自树底上升。\\n最终，点燃了原本漆黑一片的天空。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7323206,
			"completionStepIds": [
				7323206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7323206",
							"2"
						],
						"stepId": 7323206,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"斯露莎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732320601,
					"content": "喂喂！快醒醒，斯露莎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732320602,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320603
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732320603,
					"content": "呼，你终于醒过来了，刚才在上面的时候你突然就晕过去了，吓死我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732320604,
					"content": "嗯…我没事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320605
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732320605,
					"content": "不过在那之后母树就打开了，然后我们就跟着来到了这里，这里该不会是…祖尔宛说的那个巨莲「伽乌迦那」吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732320606,
					"content": "所以斯露莎刚才到底是怎么了啊，是花冠出了什么问题吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320607
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732320607,
					"content": "我刚才好像看到了大地回归母树的记忆。无数的花灵、荼诃的机关与人类的勇士，与魔物交战然后牺牲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320608
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732320608,
					"content": "蒙面的剑士、独臂的贤者与元祖的花灵降服了自渊底而出的魔物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320609
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732320609,
					"content": "而他们的意志最后都随着灵光回到了母树当中，化为从天而降的甘霖。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320610
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732320610,
					"content": "荼诃的机关…听上去该不会真的像那先朱那说的那样吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320611
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732320611,
					"content": "看来还是得问祖尔宛才行。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732320612
					]
				},
				{
					"id": 732320612,
					"content": "嗯，不过现在我们接下来该怎么办呢，我记得祖尔宛是说要清除什么污秽来着？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320613
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732320613,
					"content": "只有进入神明大人的「神识」所依附的「染境」，将那些被污秽困在其中的「慈心」带出来，才能重新唤醒「神识」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320614
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732320614,
					"content": "在我所看到的记忆中，那是个无边虚无的空间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320615
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732320615,
					"content": "既然这样，那我们要怎么样才能进去呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320616
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732320616,
					"content": "跟着我来就行，只要沿着古代英雄们的「心迹」，就能到达那里了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "斯露莎"
				}
			]
		},
		{
			"id": 7323218,
			"completionStepIds": [
				7323218
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7323218",
							"2"
						],
						"stepId": 7323218,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"10010",
							"0"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"祖尔宛",
					"斯露莎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732321801,
					"content": "完成「祭水之仪」后，你们沿着甘露的流向，跟随斯露莎离开了「万种母树」回到花海…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732321802
					]
				},
				{
					"id": 732321802,
					"content": "而祖尔宛也已经在此等候着你们…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732321803
					]
				},
				{
					"id": 732321803,
					"content": "没想到你们真的完成了「祭水之仪」，这番功绩已可比拟古代的英雄，真是让我惊讶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321804
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732321804,
					"content": "你明明就是一副一点也不惊讶的样子吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321805
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732321805,
					"content": "「焚真之天象」已经熄灭，大地也得到了净化，没想到不靠牺牲也能够做到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321806
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732321806,
					"content": "下了一场好大的雨啊，天上的大窟窿不见了，枯树桩子也重新长成了大树。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321807
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732321807,
					"content": "不用再承受污秽侵蚀，神明大人应该也没有那么痛苦了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321808
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732321808,
					"content": "那么关于五百年前的事情…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732321809
					]
				},
				{
					"id": 732321809,
					"content": "对哦，刚才斯露莎在大树里面看到了过去的记忆，果然最开始抵抗魔物的矫论团先辈里面有坎瑞亚的人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321810
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732321810,
					"content": "哎呀，别这么严肃嘛。既然你们已经接触了来自过去的记忆，那么接下来我要说的，就不是故事，而是事实了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321811
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732321811,
					"content": "很久很久以前，当我第一次从花海中醒来时，除了这一方小小的净土，天空中到处是黑渊的异象，外面也都是魔物的国度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321812
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732321812,
					"content": "循着神鸟遗愿的指引，我召集灵光的力量，离开花海以镇压地上的魔物，直到在荒野中遇到了那个金发的男人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321813
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732321813,
					"content": "那个家伙一半的身躯已形同魔物，但身上却没有魔物的气息，我发现他时，他的手中还紧紧攥着一枚指环。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321814
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732321814,
					"content": "我将他带到花海之中，醒来之后他自称是荼诃的剑士，因身负诅咒才活了下来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321815
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732321815,
					"content": "后来一段时间，我便与这位蒙面的剑士同行，共同对抗进攻花海的迪弗们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321816
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732321816,
					"content": "身负诅咒…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732321817
					]
				},
				{
					"id": 732321817,
					"content": "嗯，据说那场灾厄之中，荼诃人都受到了不同程度的诅咒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321818
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732321818,
					"content": "那之后不久，从沙漠的东方来了一群学者装束的人，为首的是一位独臂的贤者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321819
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732321819,
					"content": "他们自称是曾与荼诃人的勇士并肩作战之人。据他们所说，那是一群即便知道已背负上污名，却依然循着本愿而行的勇士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321820
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732321820,
					"content": "背负着勇士们的遗愿，为了彻底消除黑渊的灾祸，他们循着勇士们曾走过的道路而溯行至此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321821
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732321821,
					"content": "后来，我们共同进入了荼诃人留下的遗迹，发现了那些曾经与魔物对抗的机关，它们也隶属于曾与学者们并肩作战的战团。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321822
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732321822,
					"content": "最后独臂的贤者靠着荼诃人留下的文献，找到了得以穿过黑渊进入母树的方法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321823
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732321823,
					"content": "于是我们便一同进入母树，用甘露净化了天上与地上的污秽。此后花海中不断有花灵诞生，地上的魔物则渐渐消失。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321824
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732321824,
					"content": "#后来，蒙面的剑士随一位与你有着同样金色头发的{M#少女}{F#少年}离开了花海，贤者则独自进入地下的遗迹再也没有回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321825
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732321825,
					"content": "剩下的人则与新生的花灵结成了伙伴，自称为「矫论团」，在这里生活了下来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321826
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732321826,
					"content": "如今金发的勇士又回到了花海，虽然不是当初的那位，不过我也能感受到某些东西又开始重新流逝了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321827
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732321827,
					"content": "这也是为什么我一开始就选择了拜托你们的原因啊，有你们在我就不用再想着去哪找出一位能与花灵并肩作战的勇士了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321828
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732321828,
					"content": "教导人类的工作可是很辛苦的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321829
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732321829,
					"content": "怎么你们花灵一个比一个懒啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321830
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732321830,
					"content": "喂，白飘飘说的这话可别带上我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321831
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732321831,
					"content": "哎呀，既然完成了「祭水之仪」，污秽一时半会也没办法威胁这里，我也可以趁机好好休息了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321832
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732321832,
					"content": "至于斯露莎，我就把她交给你们了，你们可要在旅途中好好教导她，毕竟这也算是「谒颂主」的工作呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321833
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732321833,
					"content": "我才不想被白飘飘指导…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321834
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732321834,
					"content": "嘿嘿，斯露莎可要好好听话！不过怎么祖尔宛说的就像是以后不会再见面了一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321835
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732321835,
					"content": "反正你们又不会留在这里陪我，你们这些人都一样啦，永远也不打算停下脚步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321836,
						732321837
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732321836,
					"content": "我们还会回来的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732321838
					]
				},
				{
					"id": 732321838,
					"content": "哎呀，我是不会再相信这种话了，毕竟已经不是第一次听了哪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321839
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732321839,
					"content": "说起这个，也不知道那位蒙面的剑士现在怎么样了，你们要是见到他可要帮我问好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321840
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732321840,
					"content": "毕竟你们都是旅人嘛，总是会有机会见面的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321841
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732321841,
					"content": "好啦，你们该回到属于你们的地方去了，可别太想我哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732321837,
					"content": "还会有机会见面的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732321838
					]
				}
			]
		},
