					"nextDialogs": [
						732580202
					]
				},
				{
					"id": 732580202,
					"content": "#「…派蒙教我新的知识，很开心。原来咒语是『宝藏』，而不是『暴葬』。那菈{NICKNAME}好厉害，一下就打败了桓那吉…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732580203
					],
					"speakerTitle": "字迹歪歪扭扭的记事"
				},
				{
					"id": 732580203,
					"content": "「…大家都好喜欢他们，一个金色的、一个银色的，就像大大的太阳、小小的月亮，温和又明亮…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "字迹歪歪扭扭的记事"
				}
			]
