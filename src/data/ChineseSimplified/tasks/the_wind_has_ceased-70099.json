			"dialogs": [
				{
					"id": 700650101,
					"content": "真是好话难劝想死的鬼啊。都说了现在不能上山。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650102
					],
					"speakerTitle": "曼恩"
				},
				{
					"id": 700650102,
					"content": "哎哎，曼恩大爷，你别这么激动。好好说话，好好说话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650103
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 700650103,
					"content": "之前我和这位大爷在暗夜之酿聊得还好好的呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650104
					],
					"speakerTitle": "莉普哈特"
				},
				{
					"id": 700650104,
					"content": "他一听说我要去风息山就开始拽着我了，一路拉扯都走到这里来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650105
					],
					"speakerTitle": "莉普哈特"
				},
				{
					"id": 700650105,
					"content": "咦，是霍夫曼啊。这里发生什么了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700650106,
					"content": "如你所见，曼恩大爷正在力劝人们远离风息山呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650107
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 700650107,
					"content": "介绍一下，这位是冒险家莉普哈特。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650108
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 700650108,
					"content": "我的亲身经历可是很吓人的！你们真的要听吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650109
					],
					"speakerTitle": "曼恩"
				},
				{
					"id": 700650109,
					"content": "好嘛，我感觉今天是走不了了。那听听吧，就当是刚才喝酒吹牛的延续了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650110
					],
					"speakerTitle": "莉普哈特"
				},
				{
					"id": 700650110,
					"content": "我来看看究竟是怎么个危险法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650111
					],
					"speakerTitle": "莉普哈特"
				},
				{
					"id": 700650111,
					"content": "疗养院里真的有鬼！我亲眼看见的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650112
					],
					"speakerTitle": "曼恩"
				},
				{
					"id": 700650112,
					"content": "哇，鬼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700650113,
					"content": "昨天晚上的事情是这样的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "曼恩"
				}
			]
		}
	]
