			"dialogs": [
				{
					"id": 747120101,
					"content": "#和你们分享最好的消息，{NICKNAME}和派蒙——问题都搞定了哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120102
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 747120102,
					"content": "暴躁鱼儿救助行动，大获成功~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120103
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 747120103,
					"content": "等到潜水员那边搞定了所有水下杂物，这些病患鱼儿再平静一些，就能让鱼儿们回到原本的环境去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120104
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 747120104,
					"content": "真是辛苦大家了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747120105
					]
				},
				{
					"id": 747120105,
					"content": "嘿嘿，是我们和希格雯一起努力的成果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747120106,
					"content": "我把这次的事件写成了报告，交给了沫芒宫。应该很快就会有专员拟定相关的规则，通知对应机构…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120107
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 747120107,
					"content": "另外，我听说还有一些记者和导演，也对相关的题材很感兴趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120108
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 747120108,
					"content": "说不定，今后我们还能看到以保护水域环境为主题的映影？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120109
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 747120109,
					"content": "嗯，只是普普通通讲道理，一些顽固的…或者粗心大意的家伙，根本听不进去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747120110,
					"content": "干脆拍得吓人点…就说，环境被严重破坏后…鱼儿们会变异成超级无敌大怪兽，到处破坏！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747120111,
					"content": "让习惯往水里丢东西的人做噩梦，教育效果肯定超级棒！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747120112,
					"content": "那就太好啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "希格雯"
				}
			]
		}
	]
