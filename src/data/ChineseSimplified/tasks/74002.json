			},
			"dialogs": [
				{
					"id": 740021601,
					"content": "欸？只有一个传送门…这个传送门，会通向什么地方呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740021602,
					"content": "嗯…我也不清楚耶。进入高塔之后的事情，我都没想过…不清楚会发生什么事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021603
					],
					"speakerTitle": "安"
				},
				{
					"id": 740021603,
					"content": "是喔…那我们谨慎地前进吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021604,
						740021606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740021604,
					"content": "是要谨慎还是要前进？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740021605
					]
				},
				{
					"id": 740021605,
					"content": "都要啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021607
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740021607,
					"content": "#嗯。{NICKNAME}骑士、派蒙，我们要小心。莉利丝公主只能靠我们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安"
				},
				{
					"id": 740021606,
					"content": "去看看传送门的另一边有什么吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740021607
					]
				}
			]
		},
		{
			"id": 7400217,
			"completionStepIds": [
				7400225
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7400225",
