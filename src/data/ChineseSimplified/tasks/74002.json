					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740020803
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740020803,
					"content": "似乎不会走了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740020804
					]
				},
				{
					"id": 740020804,
					"content": "唔，一直泡在水里，应该早就坏了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740020805
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740020805,
					"content": "在这里面，满满地装着莉利丝公主所有珍贵的时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740020806
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 740020806,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740020807
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 740020807,
					"content": "我们回去吧。回到高塔下，与朋友们再会。",
					"roleType": "TALK_ROLE_NPC",
