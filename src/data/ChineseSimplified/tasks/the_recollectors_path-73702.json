			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"斯露莎",
					"祖尔宛"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 737020701,
					"content": "曾经的荼泥黑渊…过去的灾厄的中心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020702
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020702,
					"content": "真没想到斯露莎真的熄灭了「焚真之天象」，解决了这里的大麻烦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020703
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737020703,
					"content": "熄灭「焚真之天象」也在花灵勇者的职责之内，斯露莎只是做了自己当做的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020704
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 737020704,
					"content": "多亏了米希尔和拉沙鲁的协助。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020705
					]
				},
				{
					"id": 737020705,
					"content": "嗯，还有我们也出了不少力呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020706
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737020706,
					"content": "好啊，吾之「谒颂主」还有白飘飘，居然将我这个主角抛下不谈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020707
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020707,
					"content": "哇，感觉之前那个嚣张的斯露莎又回来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020708
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737020708,
					"content": "唔…经过这阵子的相处，「谒颂主」和白飘飘还是对我有所怀疑吗？我这可不是什么没来由的盲目嚣张啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020709
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020709,
					"content": "哼哼，要知道，我已经完全理解了自己过去的失误。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020710
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020710,
					"content": "过去我一度将声名看得比行动本身更重要，但现在我知道了，这是舍本逐末的行为。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020711
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020711,
					"content": "就像「西摩格」是因为它的牺牲而成为神鸟，我也将会因为我所行之事而被当作花灵勇者，为人所称颂传唱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020712
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020712,
					"content": "而且，我也完成了前辈指定的全部训练，这下就算是前辈也该承认我的确是个称职的勇者，的确配得上「双角的花冠」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020713
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020713,
					"content": "我当然对灵光的选择没有异议。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020714
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 737020714,
					"content": "…欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020715
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020715,
					"content": "怎么？这时候我该提出反对意见吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020716
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 737020716,
					"content": "不…只是…只是我没想到前辈居然会这样爽快地认可…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020717
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020717,
					"content": "还以为至少会刁难两句。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020718
					]
				},
				{
					"id": 737020718,
					"content": "啊呀，我可不是什么坏心眼的长者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020719
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 737020719,
					"content": "对了，关于勇者的职责…我并没有从花冠得到有关的知识…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020720
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020720,
					"content": "是因为我作为勇者还是不完全的吗？难道说还需要经过什么其他的训练…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020721
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020721,
					"content": "这个嘛…虽然勇者的称号的确是花灵传承的一部份，具体的职责却是随时代改变的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020722
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 737020722,
					"content": "嗯嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020723
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020723,
					"content": "简单来说，就是没有具体要做哪些事的规定，也没有什么是否合格的评判标准。通常来说，灵光的选择就代表了最终的结果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020724
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 737020724,
					"content": "欸？也就是说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020725
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020725,
					"content": "我是不会没收「双角的花冠」的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020726,
						737020728
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 737020726,
					"content": "这下不用担心头顶凉飕飕了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020727
					]
				},
				{
					"id": 737020727,
					"content": "重点不在这里吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020732
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737020732,
					"content": "我知道了！这一定也是考验的一环。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020733
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020733,
					"content": "斯露莎好像明白了什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020734
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737020734,
					"content": "白飘飘可真是健忘呀，我刚刚还说过呢！经过这些训练，除了磨练行动力和洞察力，最重要的是我理解了自己过去的错误。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020735
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020735,
					"content": "如果因为结果其实不会改变而轻忽训练的过程，那不就重蹈覆辙了吗？所以，这一定是前辈留给我的最后的考验。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020736
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020736,
					"content": "对于名副其实的花灵勇者来说，当然是不在话下了。这可是前辈充分信赖我的表现啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020737
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020737,
					"content": "真没想到居然被斯露莎给看穿了，不愧是灵光选中的花灵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020738
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 737020738,
					"content": "#不过斯露莎能有这样的改变，或许也多亏了{NICKNAME}和派蒙两位吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020739
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 737020739,
					"content": "#嗯！吾之「谒颂主」和{M#他}{F#她}的同伴白飘飘，的确是可塑之才。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020740
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020740,
					"content": "#虽然想说有我自己就绰绰有余了…不过，的确是因为{M#他们}{F#她们}的帮助，我才得以熄灭「焚真之天象」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020741
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020741,
					"content": "没想到在短短的时间里，斯露莎竟能蜕变得如此可靠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020742
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 737020742,
					"content": "嗯！只要是勇者的职责所在，前辈就放心交给我好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020743
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020743,
					"content": "总觉得这一切都是祖尔宛的安排…不过看斯露莎的开心的样子，也许这样也挺好的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737020728,
					"content": "不是想没收也没收不了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020729
					]
				},
				{
					"id": 737020729,
					"content": "对啊，祖尔宛自己也说了，灵光的选择就代表最终的结果。即使是祖尔宛也不能轻易修改这个结果吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020730
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737020730,
					"content": "呵呵…真的不行吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020731
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 737020731,
					"content": "呜…有点可怕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020732
					],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}