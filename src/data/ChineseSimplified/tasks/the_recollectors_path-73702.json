			"trigger": {
				"objectNames": [
					"祖尔宛"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 737020101,
					"content": "与上次相见时相比，表情开朗了许多嘛。看来训练进行得很顺利？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020102
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 737020102,
					"content": "嗯，经过这几段反思我已经获得了成长。如果是现在的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020103
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020103,
					"content": "就可以算得上是称职的花灵勇者了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020104
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 737020104,
					"content": "还…还没有，毕竟还有最后的训练没有完成。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020105
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020105,
					"content": "直到所有的任务完成，并且最终获得前辈的认可之后，「双角的花冠」才真正属于我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020106
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020106,
					"content": "哦？看来之前说已经脱离了叛逆期，的确不假。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020107
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 737020107,
					"content": "前、前辈怎么还记得这个？快忘了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020108
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020108,
					"content": "呵呵，不管怎么说，看你恢复精神了就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020109
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 737020109,
					"content": "#{NICKNAME}和派蒙，斯露莎究竟是否配得上「双角的花冠」，也请两位见证到最后吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020110
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 737020110,
					"content": "我会在终点处等候，那就稍后再见了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "祖尔宛"
				}
			]
		},
		{
			"id": 7370206,
			"completionStepIds": [
				7370206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7370206",
							"2"
						],
						"stepId": 7370206,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"7323201",
							"0"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"斯露莎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 737020601,
					"content": "荼泥黑渊…这里就是灾厄的中心了。虽然一切都静止了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020602
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020602,
					"content": "不难想象当时的景况。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020603
					]
				},
				{
					"id": 737020603,
					"content": "周围这些巨大的结晶…比沙虫还要大上很多倍呢！想到之后要由斯露莎来解决这里的大麻烦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737020604,
					"content": "这不正是花灵勇者所最应当承担的责任吗？而且，也是斯露莎自己所期望的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020605
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 737020605,
					"content": "话是这么说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737020606,
					"content": "难道是信不过我？哼，没想到事到如今还会被区区白飘飘看扁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020607
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020607,
					"content": "哇，感觉之前那个嚣张的斯露莎又回来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020608
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737020608,
					"content": "也不知道是好事还是坏事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020609
					]
				},
				{
					"id": 737020609,
					"content": "唔…经过这阵子的相处，「谒颂主」和白飘飘还是对我有所怀疑吗？我这可不是什么没来由的盲目嚣张啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020610
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020610,
					"content": "哼哼，要知道，我已经完全理解了自己过去的失误。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020611
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020611,
					"content": "过去我一度将声名看得比行动本身更重要，但现在我知道了，这是舍本逐末的行为。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020612
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020612,
					"content": "就像「西摩格」是因为它的牺牲而成为神鸟，我也将会因为我所行之事而被当作花灵勇者，为人所称颂传唱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020613
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020613,
					"content": "而且，我也完成了前辈指定的全部训练，这下就算是前辈也该承认我的确是个称职的勇者，的确配得上「双角的花冠」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020614
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020614,
					"content": "我当然对灵光的选择没有异议。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020615
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 737020615,
					"content": "…欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020616
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020616,
					"content": "怎么？这时候我该提出反对意见吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020617
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 737020617,
					"content": "不…只是…只是我没想到前辈居然会这样爽快地认可…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020618
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020618,
					"content": "还以为至少会刁难两句。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020619
					]
				},
				{
					"id": 737020619,
					"content": "啊呀，我可不是什么坏心眼的长者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020620
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 737020620,
					"content": "对了，关于勇者的职责…我并没有从花冠得到有关的知识…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020621
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020621,
					"content": "是因为我作为勇者还是不完全的吗？难道说还需要经过什么其他的训练…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020622
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020622,
					"content": "这个嘛…虽然勇者的称号的确是花灵传承的一部份，具体的职责却是随时代改变的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020623
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 737020623,
					"content": "嗯嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020624
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020624,
					"content": "简单来说，就是没有具体要做哪些事的规定，也没有什么是否合格的评判标准。通常来说，灵光的选择就代表了最终的结果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020625
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 737020625,
					"content": "欸？也就是说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020626
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020626,
					"content": "我是不会没收「双角的花冠」的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020627,
						737020629
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 737020627,
					"content": "这下不用担心头顶凉飕飕了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020628
					]
				},
				{
					"id": 737020628,
					"content": "重点不在这里吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020633
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737020633,
					"content": "我知道了！这一定也是考验的一环。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020634
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020634,
					"content": "斯露莎好像明白了什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020635
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737020635,
					"content": "白飘飘可真是健忘呀，我刚刚还说过呢！经过这些训练，除了磨练行动力和洞察力，最重要的是我理解了自己过去的错误。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020636
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020636,
					"content": "如果因为结果其实不会改变而轻忽训练的过程，那不就重蹈覆辙了吗？所以，这一定是前辈留给我的最后的考验。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020637
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020637,
					"content": "对于名副其实的花灵勇者来说，当然是不在话下了。这可是前辈充分信赖我的表现啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020638
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020638,
					"content": "真没想到居然被斯露莎给看穿了，不愧是灵光选中的花灵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020639
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 737020639,
					"content": "#不过斯露莎能有这样的改变，或许也多亏了{NICKNAME}和派蒙两位吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020640
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 737020640,
					"content": "#嗯！吾之「谒颂主」和{M#他}{F#她}的同伴白飘飘，的确是可塑之才。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020641
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020641,
					"content": "#虽然想说有我自己就绰绰有余了…不过，相信有{M#他们}{F#她们}的帮助，熄灭「焚真之天象」也不是什么难事了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020642
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020642,
					"content": "那真是太可靠了。别忘了，米希尔和拉沙鲁也会协助你们的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020643
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 737020643,
					"content": "前辈就放心交给我好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020644
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020644,
					"content": "总觉得这一切都是祖尔宛的安排…不过看斯露莎的开心的样子，也许这样也挺好的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737020629,
					"content": "不是想没收也没收不了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020630
					]
				},
				{
					"id": 737020630,
					"content": "对啊，祖尔宛自己也说了，灵光的选择就代表最终的结果。即使是祖尔宛也不能轻易修改这个结果吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020631
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737020631,
					"content": "呵呵…真的不行吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020632
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 737020632,
					"content": "呜…有点可怕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020633
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7370207,
			"completionStepIds": [
				7370206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7370206",
							"2"
						],
						"stepId": 7370206,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"7323201",
							"1"
						]
					}
				]
