			"dialogs": [
				{
					"id": 50130801,
					"content": "回声之子这里的魔物已经被清理干净了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130802
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 50130802,
					"content": "我去干掉了深渊瘤石！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130803
					],
					"speakerTitle": "卡齐娜"
				},
				{
					"id": 50130803,
					"content": "流泉之众也搞定了，一炮了事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130804
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 50130804,
					"content": "烟谜主的危险也解除了，需要去花羽会帮忙吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130805
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 50130805,
					"content": "那边的情况好像挺严重的，我已经在路上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130806
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 50130806,
					"content": "用不着，已经处理完了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130807
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 50130807,
					"content": "这么快？！你刚刚还在竞技场啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130808
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 50130808,
					"content": "想找人揍一顿，你知道我忍了多久？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130809
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 50130809,
					"content": "好、好吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130810
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 50130810,
					"content": "伊安珊，沃陆之邦怎么办，你家离竞技场可远了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130811
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 50130811,
					"content": "哦，这个不用担心，刚刚瓦雷莎和我通信了，那边也解决了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130812
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 50130812,
					"content": "看来全都没事了呢，深渊似乎也示弱了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130813
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 50130813,
					"content": "对啊，这家伙就知道用数量优势，和还魂诗比比，看看谁人更多吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130814
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 50130814,
					"content": "等等，深渊好像集结了一批魔物，往竞技场的方向冲了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130815
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 50130815,
					"content": "看来它也意识到，还魂诗是最大的麻烦，想要去破坏圣火。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130816
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 50130816,
					"content": "怎么可能让它得逞，朋友们，竞技场集合！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130817
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 50130817,
					"content": "我看到有新的深渊瘤石砸下来，都在竞技场附近，我们还是分头去击破吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130818
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 50130818,
					"content": "对了，还需要有人去守住大门。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130819
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 50130819,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50130820
					]
				},
				{
					"id": 50130820,
					"content": "好的，这就是最后的战斗了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玛拉妮"
				}
			]
		}
	]
