	"talks": [
		{
			"id": 7306305,
			"completionStepIds": [
				7306305
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7306303",
							"2"
						],
						"stepId": 7306303,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7306305",
							"2"
						],
						"stepId": 7306305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"兰迦鲁"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730630501,
					"content": "金色的那菈和白色的飞飞，你们来啦！我是兰迦鲁！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630502
					],
					"speakerTitle": "兰迦鲁"
				},
				{
					"id": 730630502,
					"content": "草木和蘑菇告诉我你们会来，我已经等了很久啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630503
					],
					"speakerTitle": "兰迦鲁"
				},
				{
					"id": 730630503,
					"content": "咦…？你认识我们吗…？你有什么事情找我们呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730630504,
					"content": "有事情！有很大很大的事情哦！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630505
					],
					"speakerTitle": "兰迦鲁"
				},
				{
					"id": 730630505,
					"content": "哇，别激动啦，跟我们慢慢说吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730630506,
					"content": "嗯，「无留陀」在长大，越长越大，森林都不敢说话，不敢呼吸…因为「无留陀」在，「无留陀」会吃掉他们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630507
					],
					"speakerTitle": "兰迦鲁"
				},
				{
					"id": 730630507,
					"content": "为了阻止「无留陀」，兰纳迦在忙「兰赫玛」的仪式。但是「兰赫玛」…还缺少「钵参花」呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630508
					],
					"speakerTitle": "兰迦鲁"
				},
				{
					"id": 730630508,
					"content": "这样啊…可是，「钵参花」从哪里找呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630509,
						730630511
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730630509,
					"content": "派蒙这次居然没念错名字。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730630510
					]
				},
				{
					"id": 730630510,
					"content": "哼哼，钵！参！花！厉害吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630512
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730630512,
					"content": "「钵参花」在生着蘑菇的地方，很多很多个月亮升起和落下之前，那里曾是那菈的家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630513
					],
					"speakerTitle": "兰迦鲁"
				},
				{
					"id": 730630513,
					"content": "但是后来…湿湿的土掩埋了那菈的梦，他们的记忆生出了新的草木，一代又一代地干枯又复生…我们要去的，就是这样的地方呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630514
					],
					"speakerTitle": "兰迦鲁"
				},
				{
					"id": 730630514,
					"content": "唔…虽然听不太明白，但总觉得很可怕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630515
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730630515,
					"content": "不可怕，不可怕。那菈害怕的地方，草木喜欢。所以那里很多草木。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630516
					],
					"speakerTitle": "兰迦鲁"
				},
				{
					"id": 730630516,
					"content": "那里有那菈们和兰那罗一起留下来的符文，为了不忘记，为了忘记后可以查看。去那里，可以找到「钵参花」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630517
					],
					"speakerTitle": "兰迦鲁"
				},
				{
					"id": 730630517,
					"content": "唔…那我们就一起去他说的地方吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630518
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730630518,
					"content": "对了、对了！还有，「苦舍桓」呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630519
					],
					"speakerTitle": "兰迦鲁"
				},
				{
					"id": 730630519,
					"content": "有「苦舍桓」的话，兰那罗就有力气，有力气，就能给大家开路！兰迦鲁可以打碎石块！哈！哈！轰！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630520
					],
					"speakerTitle": "兰迦鲁"
				},
				{
					"id": 730630520,
					"content": "兰迦鲁个子小小，力气大大呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630521
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730630521,
					"content": "嘿嘿，没错，力气大大！嗯…不过要是有绿色藤蔓的石块才行啦，一整个的话…没有裂隙，就没有力气打破。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630522,
						730630525
					],
					"speakerTitle": "兰迦鲁"
				},
				{
					"id": 730630522,
					"content": "「苦舍桓」是什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730630523
					]
				},
				{
					"id": 730630523,
					"content": "「苦舍桓」是记忆和梦的容器，胖胖的，苦苦的，里面满是力量。是开花的植物结出的果，也是新的种子，有全新的生命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630524
					],
					"speakerTitle": "兰迦鲁"
				},
				{
					"id": 730630524,
					"content": "这个，给你。请好好珍惜。兰那罗只会把它托付给重要的对方，所以…唔，你们不要吃掉啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630527
					],
					"speakerTitle": "兰迦鲁"
				},
				{
					"id": 730630527,
					"content": "唔…月亮来了又去，已经不剩下很多了…会走的蕈类一直在里面，越来越多…很不好，我们要尽快才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰迦鲁"
				},
				{
					"id": 730630525,
					"content": "「钵参花」是什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730630526
					]
				},
				{
					"id": 730630526,
					"content": "「钵参花」是兰那罗的好伙伴，是为了成就「兰赫玛」而生的花朵，是灵药的源泉。唔…只有牺牲汁液，才能提炼「兰赫玛」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630527
					],
					"speakerTitle": "兰迦鲁"
				},
				{
					"id": 730630511,
					"content": "应该很不好找。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730630512
					]
				}
			]
		},
