					"兰迦鲁"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730632901,
					"content": "兰迦鲁，来和「钵参花」说话，就可以了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632902
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730632902,
					"content": "嘘——！嘘——！小点声啦，不要吵到他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632903
					],
					"speakerTitle": "兰迦鲁"
				},
				{
					"id": 730632903,
					"content": "兰迦鲁同「钵参花」私语了一会…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730632904
					]
				},
				{
					"id": 730632904,
					"content": "「钵参花」被我们从梦中吵醒，很生气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632905
					],
					"speakerTitle": "兰迦鲁"
				},
				{
					"id": 730632905,
					"content": "欸…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632906
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730632906,
					"content": "但是，如果是为了「兰赫玛」，就勉强原谅我们啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632907
					],
					"speakerTitle": "兰迦鲁"
				},
				{
					"id": 730632907,
					"content": "「钵参花」，「钵参花」，为了兰赫玛，为了「无郁夷摩」的复生…请你同我们一道吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632908
					],
					"speakerTitle": "兰迦鲁"
				},
				{
					"id": 730632908,
					"content": "咦…？哦…欸…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632909,
						730632911
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730632909,
					"content": "派蒙在干什么呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730632910
					]
				},
				{
					"id": 730632910,
					"content": "我在听「钵参花」回应了他什么呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632913
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730632913,
					"content": "太好了，「钵参花」同意与我们一道冒险啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632914
					],
					"speakerTitle": "兰迦鲁"
				},
				{
					"id": 730632914,
					"content": "好耶！「钵参花」取得！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632915
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730632915,
					"content": "唔，接下来…「钵参花」说，小心保护脑袋哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632916
					],
					"speakerTitle": "兰迦鲁"
				},
				{
					"id": 730632916,
					"content": "…什么意思呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632917
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730632917,
					"content": "小心保护脑袋和根系，不然等到水来了，会撞坏的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632918
					],
					"speakerTitle": "兰迦鲁"
				},
				{
					"id": 730632918,
					"content": "欸…？等等…什么声音？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632919
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730632919,
					"content": "小心！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰迦鲁"
				},
				{
					"id": 730632911,
					"content": "能听懂他们说什么吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730632912
					]
				},
				{
					"id": 730632912,
					"content": "…听都听不见呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632913
					],
					"speakerTitle": "派蒙"
				}
			]
		},
