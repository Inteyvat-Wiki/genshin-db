			},
			"dialogs": [
				{
					"id": 730632301,
					"content": "这里就是「呿波境」啦！草木的美梦躲藏的地方，就是这里！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632302
					],
					"speakerTitle": "兰迦鲁"
				},
				{
					"id": 730632302,
					"content": "你看，那边生长的，就是「钵参花」咯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632303
					],
					"speakerTitle": "兰迦鲁"
				},
				{
					"id": 730632303,
					"content": "哇……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632304,
						730632306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730632304,
					"content": "这里好平静…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730632305
					]
				},
				{
					"id": 730632305,
					"content": "是呀，安静到让我好不安…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730632308,
					"content": "「呿波境」很脆弱了…蕈类走进来，吃掉了许多养分，但「钵参花」没有受伤害…还没有呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632309
					],
					"speakerTitle": "兰迦鲁"
				},
				{
					"id": 730632309,
					"content": "我们去解开他的封印，然后再和他说话吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632310
					],
					"speakerTitle": "兰迦鲁"
				},
				{
					"id": 730632310,
					"content": "嗯，我们解开封印，你去和他说话！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730632306,
					"content": "「钵参花」就在这里…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730632307
					]
				},
				{
					"id": 730632307,
					"content": "唔…怎么看都很邪门啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632308
					],
					"speakerTitle": "派蒙"
				}
			]
