					"content": "墨田大人对之后的目的地，有计划吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460302
					],
					"speakerTitle": "阿釜"
				},
				{
					"id": 722460302,
					"content": "嗯——这么说来，听说蒙德城里有一座很大的图书馆…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "墨田"
