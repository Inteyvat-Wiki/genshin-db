			"dialogs": [
				{
					"id": 722460401,
					"content": "「世界如此宽广…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460402
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460402,
					"content": "是《净琉璃机动队》吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460403
					],
					"speakerTitle": "阿釜"
				},
				{
					"id": 722460403,
					"content": "嗯。阿釜你的记性，很不错嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460404
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460404,
					"content": "是您跟我说过的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿釜"
				}
			]
		}
