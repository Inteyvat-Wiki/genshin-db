				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"墨田",
					"阿釜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722460101,
					"content": "好漂亮的镯子！好漂亮的花瓶！璃月的东西真漂亮！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460102
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460102,
					"content": "…啊，不行。这么匮乏的用词，实在是愧对小说家的身份哪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460103
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460103,
					"content": "买个巧夺天工的瓷瓶，用来当做下一部小说的参考好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460104
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460104,
					"content": "嗯…写个这样的情节吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460105
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460105,
					"content": "「扭转局面的关键，竟然是藏在花瓶里的神之眼…！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460106
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460106,
					"content": "感觉很有意思呢！你觉得呢，阿釜？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460107
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460107,
					"content": "我没什么所…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460108
					],
					"speakerTitle": "阿釜"
				},
				{
					"id": 722460108,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460109
					],
					"speakerTitle": "阿釜"
				},
				{
					"id": 722460109,
					"content": "…我个人觉得，给「花瓶」的笔墨要控制好。描写过度的话，意图会被察觉到。但描写有所欠缺的话，最后又会显得太过突兀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460110
					],
					"speakerTitle": "阿釜"
				},
				{
					"id": 722460110,
					"content": "哦哦，你说得很对！我记一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460111
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460111,
					"content": "啊，抱歉抱歉！我们换个地方吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460112
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460112,
					"content": "还有，说了多少次了，别叫我大人了——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460113
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460113,
					"content": "嗯？仔细一想，看起来很普通的两名旅人，其中一位将另一位称为「大人」，也是常见的情节…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "墨田"
				}
			]
		},
		{
			"id": 7224602,
			"completionStepIds": [
				7224603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224603",
							"2"
						],
						"stepId": 7224603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"墨田",
					"阿釜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722460201,
					"content": "呼啊——真是太愉快了——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460202
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460202,
					"content": "该说真不愧是北陆最大的图书馆吗！竟然能有机会一口气把《少女薇拉的忧郁》看完！痛快痛快！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460203
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460203,
					"content": "墨田大人，小声一点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460204
					],
					"speakerTitle": "阿釜"
				},
				{
					"id": 722460204,
					"content": "啊，不好意思。实在是太让人激动了嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460205
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460205,
					"content": "不，我是怕您受伤。那个司书小姐有着强者的威压感…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460206
					],
					"speakerTitle": "阿釜"
				},
				{
					"id": 722460206,
					"content": "欸？是吗？我倒觉得是个有些懒散的，典型的魔女…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460207
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460207,
					"content": "…仔细想想，一般这样的角色才是最强的。不好不好，绝对不能激怒她…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460208
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460208,
					"content": "啊，对了。有道理。下次就以这样的角色为中心，写一篇作品好了。《大图书馆的魔法师》…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460209
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460209,
					"content": "你们的旅行如何了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460210
					]
				},
				{
					"id": 722460210,
					"content": "好久不见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460211
					],
					"speakerTitle": "阿釜"
				},
				{
					"id": 722460211,
					"content": "#欸，是传说中的{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460212
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460212,
					"content": "旅行啊…以前我也常常外出旅行取材。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460213
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460213,
					"content": "「为了描写雷灾而前往无想刃狭间」、「为了描写蛇妖而去蛇神之首」、「为了描写逐电者的生活而请阿釜参军」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460214
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460214,
					"content": "阿釜真不容易…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460215
					]
				},
				{
					"id": 722460215,
					"content": "没什么大不了的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460216
					],
					"speakerTitle": "阿釜"
				},
				{
					"id": 722460216,
					"content": "但是，这次是真正的旅行，漫无目的的远游。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460217
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460217,
					"content": "我才发现，值得写的、有趣的故事，真是太多了。就像《纪野之旅》一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460218
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460218,
					"content": "我和阿釜一起寻访本地人推荐的景点与店铺。然后，在野外露营时，与陌生的旅人分享篝火与故事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460219
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460219,
					"content": "醒来的时候，发现旅资都被偷走了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460220
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460220,
					"content": "…没问题吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460221
					]
				},
				{
					"id": 722460221,
					"content": "没问题的。找到那些盗贼，发现他们有十几个人的时候，我还以为没办法拿回来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460222
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460222,
					"content": "但阿釜竟然设法说服了他们，把钱全都拿回来了，还附带了很多有乌鸦纹样的纪念币！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460223
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460223,
					"content": "明明感觉可以写成有趣的情节，但阿釜就是不愿意告诉我过程。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460224,
						722460225
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460224,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460226
					]
				},
				{
					"id": 722460226,
					"content": "是我应该做的。墨田大人不必挂心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460227
					],
					"speakerTitle": "阿釜"
				},
				{
					"id": 722460227,
					"content": "不，阿釜真的很可靠！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460228
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460228,
					"content": "和你在一起，就算旅行到世界尽头也不会有什么问题吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460229
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460229,
					"content": "而且，总感觉，自从鹤观以来，你变了很多呢。会有想做的事了，也会提出质疑与观点…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460230
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460230,
					"content": "如果墨田大人觉得不妥当的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460231
					],
					"speakerTitle": "阿釜"
				},
				{
					"id": 722460231,
					"content": "我觉得很好喔！你的看法，都相当值得参考。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460232,
						722460233
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460232,
					"content": "那么，我就不打扰了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460234
					]
				},
				{
					"id": 722460234,
					"content": "#嗯。再见，{NICKNAME}。就让我们像《菲谢尔皇女夜谭》里那样，相约在一切的尽头再会吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460235
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460235,
					"content": "#{NICKNAME}，谢谢你。要多保重。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿釜"
				},
				{
					"id": 722460233,
					"content": "或许我们会在别的地方再会吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460234
					]
				},
				{
					"id": 722460225,
					"content": "阿釜真有本领。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460226
					]
				}
			]
		},
		{
