					}
				]
			},
			"dialogs": [
				{
					"id": 745160101,
					"content": "荣誉骑士和白色小帮手，好消息来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160102
					],
					"speakerTitle": "哲俩阿"
				},
				{
					"id": 745160102,
					"content": "这位是执律庭的昂吉安妮警官，她已将放生徒背后的供货商逮捕归案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160103
					],
					"speakerTitle": "哲俩阿"
				},
				{
					"id": 745160103,
					"content": "哼！店门被我踹开的时候，那小子还在数钱…真是个重量级混蛋！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160104
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745160104,
					"content": "你们的高强度捕捉也有了显著成效，这片水域的外来物种鱼明显减少了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160105
					],
					"speakerTitle": "哲俩阿"
				},
				{
					"id": 745160105,
					"content": "按这个速度，理论上，再过不久，本次生物入侵的问题就会被彻底解决。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160106
					],
					"speakerTitle": "哲俩阿"
				},
				{
					"id": 745160106,
					"content": "好耶！不用再担心枫达…不对，是枫丹的水质被影响了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745160107,
					"content": "#追猎者小姐也真是本事了得！居然能请动「超天顶级领队战力」{NICKNAME}来帮忙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160108
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745160108,
					"content": "那句老话怎么说的来着…对，舰炮轰渔鸥！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160109,
						745160110
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745160109,
					"content": "偶尔轰轰抢薯条的渔鸥也行…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745160111
					]
				},
				{
					"id": 745160111,
					"content": "说起来，这位昂吉安妮警官好像有点眼熟呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745160112,
					"content": "是因为我们经常帮忙维护秩序，见过不少治安工作者吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160113,
						745160116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745160113,
					"content": "初次见面，有点熟悉的警官！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745160114
					]
				},
				{
					"id": 745160114,
					"content": "哈，太正式了！以后我们还有的是机会合作，轻松点，自然点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160115
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745160115,
					"content": "不然，下次要是遇上什么事，需要你们的支援了，我必须摆出严肃和敬重的样子…那可太累了，我干不来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160121
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745160121,
					"content": "唔哎…忙活了这么久吗，总算可以下班了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160122
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745160122,
					"content": "我要去锈舵喝两杯，等着看那小子和放生徒们上新闻挨骂…你们一起吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160123
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745160123,
					"content": "谢谢你的好意，昂吉安妮警官，不过我不敢放松警惕，不知道生命力强大的入侵鱼类会不会引发什么新的意外。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160124
					],
					"speakerTitle": "哲俩阿"
				},
				{
					"id": 745160124,
					"content": "等到这片水域的外来物种被彻底清空…我一定来找你，和你好好喝一杯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160125
					],
					"speakerTitle": "哲俩阿"
				},
				{
					"id": 745160125,
					"content": "喔！看来你还动力满满，短时间内停不下来，那就这么约好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160126
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745160126,
					"content": "你就全心全意，加油努力好好干吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160127
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745160127,
					"content": "哲俩阿回到了水边，继续监视水域的情况去了…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						745160128
					]
				},
				{
					"id": 745160128,
					"content": "哲俩阿小姐…是不是有点太拼了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745160129,
					"content": "哎呀哎呀，我猜…以前她遇见了某个责任感超强的人，深受感染…完全可以理解她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160130
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745160130,
					"content": "看她这个劲头，我都不好意思偷懒了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160131,
						745160133
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745160131,
					"content": "有动力是好事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745160132
					]
				},
				{
					"id": 745160132,
					"content": "#一直努力值得尊敬，不过，也要学学{NICKNAME}，适当劳逸结合！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745160135,
					"content": "那，如果以后，我要和你们学学工作时间管理的小技巧，你们可别不教我哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160136
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745160136,
					"content": "总之…我会向上头申请，将这次行动的经费，尤其是给你们两位的酬劳…提升到「主力舰炮运作成本」的级别才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160137
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745160137,
					"content": "希望下次遇见麻烦的时候，赶到现场，又能碰见你们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160138
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745160138,
					"content": "然后听你们叉着腰笑着跟我说——「问题已经解决啦！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745160133,
					"content": "如果能劳逸结合就更好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745160134
					]
				},
				{
					"id": 745160134,
					"content": "#对对对，{NICKNAME}就是这方面的高手！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745160116,
					"content": "以前我们合作过吧，这位警官？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745160117
					]
				},
				{
					"id": 745160117,
					"content": "还记得我？那太好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160118
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745160118,
					"content": "下次再见面的时候，就可以像同事一样轻松交流…不用说句话都得考虑语气，小心翼翼了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160119,
						745160120
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745160119,
					"content": "好啊，自然点自然点。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745160121
					]
				},
				{
					"id": 745160120,
					"content": "以后有事，咱们互相多照应！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745160121
					]
				},
				{
					"id": 745160110,
					"content": "我也可以学习多用途舰炮！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745160111
					]
				}
			]
		}
	]
}