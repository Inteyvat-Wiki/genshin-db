			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"芭比洛斯"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							3498.274,
							451.958,
							4735.029
						],
						"pointId": 17224
					}
				]
			},
			"dialogs": [
				{
					"id": 746960101,
					"content": "想起来了吗？七七。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960102
					],
					"speakerTitle": "布蕾莘"
				},
				{
					"id": 746960102,
					"content": "唔…抱歉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960103
					],
					"speakerTitle": "七七"
				},
				{
					"id": 746960103,
					"content": "不用道歉啦，没事的。距离沫芒宫还有一段路，我们再走走，说不定就能想起来你家在哪里了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960104
					],
					"speakerTitle": "布蕾莘"
				},
				{
					"id": 746960104,
					"content": "#{NICKNAME}快看，是七七！还有一位美露莘。是没见过的组合呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746960105,
					"content": "#啊！{NICKNAME}，还有…派…派蒙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960106
					],
					"speakerTitle": "七七"
				},
				{
					"id": 746960106,
					"content": "你们好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960107
					]
				},
				{
					"id": 746960107,
					"content": "是七七的熟人吗？太好了，我在柔灯港附近查案的时候遇到了这个走失的孩子…是孩子吧？按照体型来看，应该是人类的孩子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960108
					],
					"speakerTitle": "布蕾莘"
				},
				{
					"id": 746960108,
					"content": "七七是…是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960109
					],
					"speakerTitle": "七七"
				},
				{
					"id": 746960109,
					"content": "我们的好朋友！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960110
					]
				},
				{
					"id": 746960110,
					"content": "对、对！我们很久以前就认识啦，是要好的朋友！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746960111,
					"content": "哦哦！你反应可真快，万一七七说自己是僵尸的话，会吓坏她的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746960112,
					"content": "嗯…好朋友…没错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960113
					],
					"speakerTitle": "七七"
				},
				{
					"id": 746960113,
					"content": "看来总算有点眉目了。说实话，我也是第一次遇上这种束手无策的情况…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960114
					],
					"speakerTitle": "布蕾莘"
				},
				{
					"id": 746960114,
					"content": "那你们应该也知道，她似乎记忆出现了点问题，除了名字以外其他都很难想起来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960115
					],
					"speakerTitle": "布蕾莘"
				},
				{
					"id": 746960115,
					"content": "有时候七七是会这样子的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746960116,
					"content": "真是个可怜的孩子。我原本打算带她去逐影庭先安置一下，顺便去的路上也看看七七能不能恢复一些记忆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960117
					],
					"speakerTitle": "布蕾莘"
				},
				{
					"id": 746960117,
					"content": "既然你们是好朋友的话，你们知道她的家在哪里吗？我可以直接送她回去，这样也能省掉很多麻烦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960118
					],
					"speakerTitle": "布蕾莘"
				},
				{
					"id": 746960118,
					"content": "知道是知道…呃，但距离这里也太远了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746960119,
					"content": "太…远…？七七跟着仙灵走了远远的一段路，到了柔灯港…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960120
					],
					"speakerTitle": "七七"
				},
				{
					"id": 746960120,
					"content": "欸？你想起来啦？那再之前的事情呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960121
					],
					"speakerTitle": "布蕾莘"
				},
				{
					"id": 746960121,
					"content": "之前…白先生带着七七出诊，在遗…唔，遗什么来着？七七去采药，然后…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960122
					],
					"speakerTitle": "七七"
				},
				{
					"id": 746960122,
					"content": "喔！遗珑埠是吧！大侦探派蒙已经知道是怎么一回事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746960123,
					"content": "白术带着七七一起在遗珑埠出诊，七七在那一带采药的时候迷路了，偶遇了仙灵就跟着来到了柔灯港。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746960124,
					"content": "#哼哼，还好我和{NICKNAME}一起看过《怪盗与名侦探》，这种简单的推理还难不倒我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746960125,
					"content": "其实那个故事完全是虚构的吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960126
					]
				},
				{
					"id": 746960126,
					"content": "噢噢！确实非常合理，那我立刻动身把七七送回遗珑埠去。白术先生是七七的监护人是吧？他肯定急坏了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960127,
						746960128
					],
					"speakerTitle": "布蕾莘"
				},
				{
					"id": 746960127,
					"content": "等等，芭比洛斯女士在等的人里面…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960129
					]
				},
				{
					"id": 746960129,
					"content": "对哦！差点就把这件事情给忘记了。芭比洛斯女士——你在吗？听得到吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746960130,
					"content": "不用喊那么大声。我一直都在，只是不想打断你们的对话而已。倾听是优秀占卜师的本能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960131
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746960131,
					"content": "所谓的仙灵引路，亦可算是一种命运的指引。呵呵呵…既然来到了这里，不妨「占卜」看看吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960132
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746960132,
					"content": "占…卜？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960133
					],
					"speakerTitle": "七七"
				},
				{
					"id": 746960133,
					"content": "哎呀，打扰一下。芭比，你这种公事公办的态度会吓坏小朋友哦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960134
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746960134,
					"content": "你先让一让。看好了，要像我这样，把这份惊喜小礼物给送出去才对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960135
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746960135,
					"content": "咳咳，小魔女会成员七七小朋友，我是你的盟友可莉的妈妈，这个世界上最棒的大魔女艾莉丝阿姨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960136
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746960136,
					"content": "艾莉丝阿姨好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960137
					],
					"speakerTitle": "七七"
				},
				{
					"id": 746960137,
					"content": "真是个有礼貌的可爱好孩子。来吧，让大魔女来给小魔女主持一场惊喜预言仪式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960138
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746960138,
					"content": "预言…仪式？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960139
					],
					"speakerTitle": "七七"
				},
				{
					"id": 746960139,
					"content": "没错！看看你眼前的牌，好不好看？喜不喜欢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960140
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746960140,
					"content": "喜欢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960141
					],
					"speakerTitle": "七七"
				},
				{
					"id": 746960141,
					"content": "喜欢就好，那就抽一张牌吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960142
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746960142,
					"content": "唔…这张，可以吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960143
					],
					"speakerTitle": "七七"
				},
				{
					"id": 746960143,
					"content": "当然可以。作为好好配合的奖励，你手上的牌就归你了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960144
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746960144,
					"content": "…谢谢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960145
					],
					"speakerTitle": "七七"
				},
				{
					"id": 746960145,
					"content": "好了，芭比，你的休息时间已经结束咯，该来帮七七小朋友解读了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960146
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746960146,
					"content": "不用晃我的肩膀…我在看着呢，哦，是「倒吊人」，正位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960147
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746960147,
					"content": "能抽出它来的人可不多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960148
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746960148,
					"content": "也就是说你非常特别哟，七七小朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960149
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746960149,
					"content": "它象征着超越与等待，也意味着超脱于世俗之外。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960150
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746960150,
					"content": "你处在一定的限制之内，但你自身并不会想要主动挣脱这种限制。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960151
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746960151,
					"content": "限制…是指敕令吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960152
					],
					"speakerTitle": "七七"
				},
				{
					"id": 746960152,
					"content": "从表面上来说，你这么理解也没有错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960153
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746960153,
					"content": "关于未来，你只需要等待即可。当然，对你来说，最不缺的应该就是时间。但是…哦呀，怪了，怪了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960154
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746960154,
					"content": "好了好了，打住！一口气说太多，会加重小朋友的负担哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960155
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746960155,
					"content": "先让七七小朋友好好感受一下手头的这份礼物吧，对小朋友要耐心一点，多给一点时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960156
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746960156,
					"content": "怎么样，七七小朋友，喜欢这份小小惊喜吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960157
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746960157,
					"content": "卡牌，好看…谢谢艾莉丝阿姨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960158
					],
					"speakerTitle": "七七"
				},
				{
					"id": 746960158,
					"content": "哎呀，真乖，努力记住了阿姨的名字呢。虽然阿姨还想和你多聊聊天。但时间差不多了，好孩子该回家了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960159
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746960159,
					"content": "芭比要是还有话想说，那等下次小魔女会成员再次相聚的时候，再给每一位小魔女都做一次预言吧！大家一定都会很开心的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960160
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746960160,
					"content": "…可以不要擅自增加我的工作量吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960161
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746960161,
					"content": "就这么说定了！我们下次再见啦，七七小朋友和各位见证者们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960162
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746960162,
					"content": "再见…艾莉丝阿姨和艾莉丝阿姨的…好朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960163
					],
					"speakerTitle": "七七"
				},
				{
					"id": 746960163,
					"content": "呼…这算是结束了吗？刚刚那两位的声音是从这个玩偶里传来的吗？这是什么新型玩具，好可爱，在哪能…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960164
					],
					"speakerTitle": "布蕾莘"
				},
				{
					"id": 746960164,
					"content": "呃！不对不对，现在不应该想这些。七七，我们先去找那位叫白术的先生吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960165
					],
					"speakerTitle": "布蕾莘"
				},
				{
					"id": 746960165,
					"content": "#…嗯，时间到了，七七该回去了。下次…再见，{NICKNAME}，派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960166,
						746960167
					],
					"speakerTitle": "七七"
				},
				{
					"id": 746960166,
					"content": "路上小心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960168
					]
				},
				{
					"id": 746960168,
					"content": "卡牌…礼物，嗯…好看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "七七"
				},
				{
					"id": 746960167,
					"content": "注意安全喔。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960168
					]
				},
				{
					"id": 746960128,
					"content": "也有七七吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960129
					]
				}
			]
		},
