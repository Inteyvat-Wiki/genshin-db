					}
				]
			},
			"dialogs": [
				{
					"id": 747130101,
					"content": "#好久不见，{NICKNAME}和派蒙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130102
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747130102,
					"content": "菲米尼？你怎么还戴着潜水头盔呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747130103,
					"content": "是刚从水里上来没多久？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747130104
					]
				},
				{
					"id": 747130104,
					"content": "嗯…最近水域里的情况，有些糟糕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130105
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747130105,
					"content": "比以前多出好几倍的潜水员，在到处打捞沉底的货物。我也只能尽量搭把手…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130106
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747130106,
					"content": "早点捞完的话，潜水员们也会离开，水下就会恢复到以前的安静状态。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130107
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747130107,
					"content": "这样啊…这种闹哄哄的场面，对你来说一定很不适应吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747130108,
					"content": "谢谢派蒙关心。好在，也不全是坏事。有一些额外的收获，比如无主的古董和装饰品…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130109
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747130109,
					"content": "「父亲」说，打捞到了漂亮和值钱的东西，可以送到这条船上来，你们肯定能让这些东西发挥价值。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130110
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747130110,
					"content": "阿蕾奇诺想得也挺周到的嘛。如果是本来就没人要的好看饰品，说不定可以用来装点水族馆？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747130111,
					"content": "要不然，我们也和菲米尼一起打捞吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747130112,
					"content": "可以吗？也许会占用你们的时间…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130113
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747130113,
					"content": "当然没问题啦！你都说了，捞到了无主的好东西，要给我们呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747130114,
					"content": "那我们怎么能光让你一个人干活呢？这样白拿好处，我们也会过意不去的啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130115,
						747130116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747130115,
					"content": "自己捞出古董也有意义。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747130117
					]
				},
				{
					"id": 747130117,
					"content": "那…我就把潜水员们的情报分享给你们，能帮你们节省一些心力…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130118
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747130118,
					"content": "如果找到了好东西，请你们随意安排它的用途。不过有些是船主也在寻找的物品，那种情况还是要归还给原主的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130119
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747130119,
					"content": "好，我们明白啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747130120,
					"content": "请注意安全，不要去陌生的水域。遇见危险的话，也请尽快上浮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747130116,
					"content": "水下寻宝本来也很有趣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747130117
					]
				}
			]
		}
	]
}