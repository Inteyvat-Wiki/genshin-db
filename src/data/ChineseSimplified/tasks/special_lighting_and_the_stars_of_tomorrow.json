				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"梅里爱"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							3417.103,
							449.586,
							4461.122
						],
						"pointId": 340100475
					}
				]
			},
			"dialogs": [
				{
					"id": 746810101,
					"content": "啊哈，啊哈哈哈哈哈哈哈哈哈…散发着耀眼光芒的两位客人，你们终于来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746810102
					],
					"speakerTitle": "梅里爱"
				},
				{
					"id": 746810102,
					"content": "#你们想必就是提瓦特今日的传说冒险家，明日的超级巨星——{NICKNAME}和派蒙吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746810103,
						746810105
					],
					"speakerTitle": "梅里爱"
				},
				{
					"id": 746810103,
					"content": "正是我们！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746810104
					]
				},
				{
					"id": 746810104,
					"content": "我们的确在冒险家协会很有名气，但要说全提瓦特的超级巨星，好像太过火了？毕竟也有很多人不认识我们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746810107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746810107,
					"content": "印象里，见面就狠狠夸我们的人…大多都是要找我们帮忙的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746810108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746810108,
					"content": "那你就直说吧，你的需求是什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746810109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746810109,
					"content": "不不不，我并非有求于两位，而是要为你们提供一个双赢的机会——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746810110
					],
					"speakerTitle": "梅里爱"
				},
				{
					"id": 746810110,
					"content": "与我，枫丹才华最为横溢的「实验映影」导演梅里爱合作，成为映幕上最为闪亮的存在！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746810111
					],
					"speakerTitle": "梅里爱"
				},
				{
					"id": 746810111,
					"content": "到时你们要钱有钱，要人脉有人脉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746810112
					],
					"speakerTitle": "梅里爱"
				},
				{
					"id": 746810112,
					"content": "无论身处提瓦特的何方，横着走都没人敢拦，甚至会有人给你们铺红地毯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746810113,
						746810114
					],
					"speakerTitle": "梅里爱"
				},
				{
					"id": 746810113,
					"content": "想要横着走偶尔还需要拳头…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746810115
					]
				},
				{
					"id": 746810115,
					"content": "可是我们也没有多少出演映影的经验，如果我们随便跟你合作一下，就能成名的话……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746810116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746810116,
					"content": "那你为什么还没成为超级厉害的导演呢？以前跟你合作的大明星又在哪里？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746810117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746810117,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746810118
					],
					"speakerTitle": "梅里爱"
				},
				{
					"id": 746810118,
					"content": "啧，被看穿了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746810119
					],
					"speakerTitle": "梅里爱"
				},
				{
					"id": 746810119,
					"content": "要是有人专门办一所培养演员的学校就好了！我实在需要又能打，又能好好管理表情，用充沛的情感演绎台词的万能演员。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746810120
					],
					"speakerTitle": "梅里爱"
				},
				{
					"id": 746810120,
					"content": "但这种天才是不存在的！我的实验映影只完成了文戏的规划，打戏根本没着落，第一部作品都没完成。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746810121
					],
					"speakerTitle": "梅里爱"
				},
				{
					"id": 746810121,
					"content": "所以我迫不得已，只能使用「打戏替身」方案，显然，你们二位就是最佳的人选！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746810122,
						746810123
					],
					"speakerTitle": "梅里爱"
				},
				{
					"id": 746810122,
					"content": "「打戏替身」是字面意思？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746810124
					]
				},
				{
					"id": 746810124,
					"content": "唔，好聪明！这样的确能解决演员不会战斗的问题呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746810125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746810125,
					"content": "战斗的话，我们倒是很熟练，但不会出现…我们的脸和其他演员对不上的问题吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746810126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746810126,
					"content": "理论上的确会这样。可现在看来，我的实验映影里，打戏的部分更重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746810127
					],
					"speakerTitle": "梅里爱"
				},
				{
					"id": 746810127,
					"content": "如果你们的表现出彩，我就把文戏部分都改成剪影好了，台词本来也不多——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746810128
					],
					"speakerTitle": "梅里爱"
				},
				{
					"id": 746810128,
					"content": "再让其他演员好好化妆，把侧影的轮廓扮成你们的样子，通过灯光处理，观众也看不出区别。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746810129
					],
					"speakerTitle": "梅里爱"
				},
				{
					"id": 746810129,
					"content": "当然，这样一来，反而就是文戏演员成了你们的替身了，本来他们也没你们出名，我还会付你们冠名费的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746810130
					],
					"speakerTitle": "梅里爱"
				},
				{
					"id": 746810130,
					"content": "所以说…如果我们跟你合作，就能白赚…那个叫什么来着…主演的位置？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746810131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746810131,
					"content": "还有可观的酬劳，和不可估量的名分！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746810132
					],
					"speakerTitle": "梅里爱"
				},
				{
					"id": 746810132,
					"content": "#那我们好像确实挺赚的？你觉得呢，{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746810133,
						746810134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746810133,
					"content": "不赚白不赚！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746810135
					]
				},
				{
					"id": 746810135,
					"content": "由衷感谢你们的支持！太完美了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746810136
					],
					"speakerTitle": "梅里爱"
				},
				{
					"id": 746810136,
					"content": "那事不宜迟，就请你们直接前往我的实验映影棚吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746810137
					],
					"speakerTitle": "梅里爱"
				},
				{
					"id": 746810137,
					"content": "在我的这部实验映影中，共有气氛完全不同的四个打斗桥段，每个桥段也都会用到不同的「特技光效」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746810138
					],
					"speakerTitle": "梅里爱"
				},
				{
					"id": 746810138,
					"content": "在「特技光效」期间，打戏的表现会按照对应的剧本，变得更夸张…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746810139
					],
					"speakerTitle": "梅里爱"
				},
				{
					"id": 746810139,
					"content": "以你们的经验，肯定一下就能理解重点，麻利地拍完所有镜头，顺利地杀青！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "梅里爱"
				},
				{
					"id": 746810134,
					"content": "演演试试看！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746810135
					]
				},
				{
					"id": 746810123,
					"content": "要我们帮演员拍打戏桥段？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746810124
					]
				},
				{
					"id": 746810114,
					"content": "横着可走不舒服…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746810115
					]
				},
				{
					"id": 746810105,
					"content": "你有何事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746810106
					]
				},
				{
					"id": 746810106,
					"content": "好夸张的语气，还用了奇奇怪怪的形容词…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746810107
					],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}