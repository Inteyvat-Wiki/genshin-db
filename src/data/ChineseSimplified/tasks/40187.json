					"云堇"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2407.683,
							343.151,
							2388.574
						],
						"pointId": 10443
					},
					{
						"sceneId": 3,
						"position": [
							2407.146,
							343.151,
							2391.287
						],
						"pointId": 10444
					}
				]
			},
			"dialogs": [
				{
					"id": 401870301,
					"content": "要说谁更厉害的话，我选万象风角灵官。毕竟他是奇门算术开派祖师。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870302
					],
					"speakerTitle": "重云"
				},
				{
					"id": 401870302,
					"content": "嗯！我也投我祖宗爷爷一票。再加上玄燕仙子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870303
					],
					"speakerTitle": "蓝砚"
				},
				{
					"id": 401870303,
					"content": "那我就要选连山二贤了，那些世外高人都是深藏不露的，小说里都是这样写的啦。你说咧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870304
					],
					"speakerTitle": "嘉明"
				},
				{
					"id": 401870304,
					"content": "如果是武侠小说，我可能也会这么选。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870305
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 401870305,
					"content": "但很不巧，我读过《竹林月夜》，所以我认为最强的是桃都三仙里的白马仙子。她身上肯定有秘密。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870306
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 401870306,
					"content": "咦？没人选云来钓叟吗？连玉衡大人都说，她的剑法来自云来钓叟的抛竿姿势呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870307
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 401870307,
					"content": "话是这么讲…不过好像少了点排场喔？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870308
					],
					"speakerTitle": "嘉明"
				},
				{
					"id": 401870308,
					"content": "唔…可钓鱼客里出大神，这倒也是事实。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870309
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 401870309,
					"content": "嗨，你们都错啦！最厉害的当然是无妄姥爷和幽蝶仙子，要是没有他们，可就没有今天的往生堂呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870310
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 401870310,
					"content": "这样说也很有道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870311
					],
					"speakerTitle": "重云"
				},
				{
					"id": 401870311,
					"content": "哎呀，原来大家都到啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401870312,
					"content": "#{NICKNAME}，派蒙，你们总算来了。欢迎欢迎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870313
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 401870313,
					"content": "呀！胡桃，你的帽子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401870314,
					"content": "这回眼睛很尖嘛，派蒙。是啦，我又做了一根梅枝哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870315
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 401870315,
					"content": "#哦~这下你和{NICKNAME}的成一对了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401870316,
					"content": "话说回来，你们在干什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401870317,
					"content": "我们在讨论八奇里谁比较厉害。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870318
					],
					"speakerTitle": "蓝砚"
				},
				{
					"id": 401870318,
					"content": "哈哈哈，都是你有你讲他有他讲而已，不会有结论的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870319
					],
					"speakerTitle": "嘉明"
				},
				{
					"id": 401870319,
					"content": "嗯，除非我们有那种轻小说里的眼镜，戴上就能看见大家的战斗力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870320
					],
					"speakerTitle": "重云"
				},
				{
					"id": 401870320,
					"content": "哈哈，重云是被行秋传染了轻小说吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870321
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 401870321,
					"content": "#{NICKNAME}，欢迎你。我听家人说，你和胡桃完成了一个很有风险的祭仪，所以太爷爷的病才能好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870322
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 401870322,
					"content": "大恩不言谢，今后不论遇到何种麻烦，都欢迎来与我们飞云商会商量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870323
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 401870323,
					"content": "还有其他人的功劳呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870324
					]
				},
				{
					"id": 401870324,
					"content": "嗯，我知道，父亲和大哥会一一择日登门拜访。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870325
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 401870325,
					"content": "有什么好谢的啦，行秋，不如你现在就乖乖承认，最厉害的是无妄姥爷和幽蝶仙子吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870326
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 401870326,
					"content": "哎呀，别再讨论这种没有结果的事啦！既然大家都到了，我们就快吃饭吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870327
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 401870327,
					"content": "派蒙，快，传授人生理念的时候到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870328
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 401870328,
					"content": "我、我吗？呃…我想想…好像是人生得意须尽吃，莫使…莫使什么来着？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870329
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401870329,
					"content": "莫使金箸空对月。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870330
					]
				},
				{
					"id": 401870330,
					"content": "哦对对，就是这个。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870331
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401870331,
					"content": "哇，派蒙，连人生信条都讲得磕磕绊绊的？小心人生也磕磕绊绊喔。加油！喊多一次来听听！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870332
					],
					"speakerTitle": "嘉明"
				},
				{
					"id": 401870332,
					"content": "人生得意须尽吃！莫使金箸空对月！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870333
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401870333,
					"content": "很有精神。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870334
					]
				},
				{
					"id": 401870334,
					"content": "嘿嘿，那我们可以开吃了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870335
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401870335,
					"content": "派蒙，你是不是忘了，还有一位特别嘉宾？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870336
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 401870336,
					"content": "对哦！我想起来了，其实我早就猜到是谁了啦，但是我不说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870337
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401870337,
					"content": "咦？派蒙的语气有点心虚呢，其实根本猜不出来吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870338
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 401870338,
					"content": "#哎呀，我真的猜出来了，就是那个人…{NICKNAME}，快帮帮我呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870339
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401870339,
					"content": "是云堇吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870340
					]
				},
				{
					"id": 401870340,
					"content": "没错！就是我们的好云堇，看来你也没忘记她说的话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870341
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 401870341,
					"content": "看，云堇上台了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870342
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 401870342,
					"content": "哇！那不是云翰社的当家吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870343
					],
					"speakerTitle": "利兴"
				},
				{
					"id": 401870343,
					"content": "真走运，没想到云先生来遗珑埠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870344
					],
					"speakerTitle": "捷悟"
				},
				{
					"id": 401870344,
					"content": "诸位有礼了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870345
					],
					"speakerTitle": "云堇"
				},
				{
					"id": 401870345,
					"content": "今夜再唱一曲八奇炼桃都，给几位错过海灯节的好友。没有那晚的舞台，还请不要见怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870346
					],
					"speakerTitle": "云堇"
				},
				{
					"id": 401870346,
					"content": "呜哇！云堇专门唱给你们这些错过的人听呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870347
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401870347,
					"content": "嘘！她要开始啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870356
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 401870356,
					"content": "想那桃都狂言",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870348
					],
					"speakerTitle": "云堇"
				},
				{
					"id": 401870348,
					"content": "妖嘶嘶怪喧喧树下吵闹，有情鬼无缘人唯我令号。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870349
					],
					"speakerTitle": "云堇"
				},
				{
					"id": 401870349,
					"content": "离愁界入红尘怨火焦燎，骨作刀血化马九霄直捣，尔的野心可笑——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870350
					],
					"speakerTitle": "云堇"
				},
				{
					"id": 401870350,
					"content": "补天济世传灯火，戈枪剑戟影婆娑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870351
					],
					"speakerTitle": "云堇"
				},
				{
					"id": 401870351,
					"content": "生死阴阳可奈何，你害生肥己种因果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870352
					],
					"speakerTitle": "云堇"
				},
				{
					"id": 401870352,
					"content": "天道中正不多少，贪欲有余是尔过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870353
					],
					"speakerTitle": "云堇"
				},
				{
					"id": 401870353,
					"content": "萌誓愿除魔非是我，共八门刀起桃都落。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870354
					],
					"speakerTitle": "云堇"
				},
				{
					"id": 401870354,
					"content": "身前力竭销魂魄，身后有人代辨清浊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870355
					],
					"speakerTitle": "云堇"
				},
				{
					"id": 401870355,
					"content": "折柳洒泪落田陌，来年飞燕衔枝荡春波。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "云堇"
				}
			]
		},
