					}
				]
			},
			"dialogs": [
				{
					"id": 401870101,
					"content": "#嘿！{NICKNAME}，派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870102
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 401870102,
					"content": "香菱！找我们有什么事呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401870103,
					"content": "哈哈，我还能有什么事，当然就是祭祭五脏庙的事啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870104
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 401870104,
					"content": "终于要吃上饭了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870105
					]
				},
				{
					"id": 401870105,
					"content": "嗯！应该有空吧？不能再推脱了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870106
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 401870106,
					"content": "一直没空的可不是我们呀，是胡桃那个家伙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401870107,
					"content": "谁让她是堂主呢，架子大得很哦！不多来几个人都约不到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870108
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 401870108,
					"content": "不过你们放心，这回都说好了，我们逼着她不许找借口。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870109
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 401870109,
					"content": "哦？还有别人出手吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401870110,
					"content": "嘿嘿，是行秋啦，他说早想约大家一起聚一聚了，可是你们也知道他太爷爷的事吧，所以一直不方便。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870111
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 401870111,
					"content": "不过海灯节那晚，行秋太爷爷突然就醒了，别提他有多高兴了，这才有机会出来，我们当然一拍即合啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870112
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 401870112,
					"content": "哇！老太公没事了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401870113,
					"content": "嗯，大夫都看了，没一点毛病。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870114
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 401870114,
					"content": "行秋说，他太爷爷一醒来就大吃特吃，和派蒙一样，胃口好得不得了，家人们这会开始担心，老太公别又撑坏了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870115
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 401870115,
					"content": "怎么感觉像我一样不是什么好话呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401870116,
					"content": "当然是好话呀，派蒙的胃口是一种积极的人生态度哦。人生得意须尽吃，莫使金箸空对月呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870117
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 401870117,
					"content": "哎呀，香菱说得真好！我就是带着这种理念才一步一步走到今天的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401870118,
					"content": "有这回事？我怎么不知道。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870119
					]
				},
				{
					"id": 401870119,
					"content": "哼哼，就有！人生得意须尽吃，莫使…莫使什么来着？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401870120,
					"content": "哈哈，小派蒙，把你的理念留到饭桌上再说吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870121
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 401870121,
					"content": "嘿嘿，没问题！那我们在哪里吃饭呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401870122,
					"content": "在遗珑埠，就今晚，行秋他们都还在那边呢。对了，胡桃说她还有一位特别嘉宾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870123
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 401870123,
					"content": "哪位？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870124
					]
				},
				{
					"id": 401870124,
					"content": "晚上到了你们就知道了嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870125
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 401870125,
					"content": "啊！我大概猜到是谁了，嘿嘿，但是我不说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401870126,
					"content": "我也猜到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870127
					]
				},
				{
					"id": 401870127,
					"content": "欸？你猜是谁啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401870128,
					"content": "我也不说。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870129
					]
				},
				{
					"id": 401870129,
					"content": "哼，那我们晚上看看谁猜的比较准！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4018703,
