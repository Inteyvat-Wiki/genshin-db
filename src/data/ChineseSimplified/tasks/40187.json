			"dialogs": [
				{
					"id": 401870701,
					"content": "往生堂那丫头，真有几分了不起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870702
					],
					"speakerTitle": "闲云"
				},
				{
					"id": 401870702,
					"content": "早前只因为帝君在那当什么客卿，本仙才对她有些兴趣，如今方知其中真意啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870703
					],
					"speakerTitle": "闲云"
				},
				{
					"id": 401870703,
					"content": "话虽如此，但能听见留云借风这番称赞，倒是稀奇得很。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870704
					],
					"speakerTitle": "削月筑阳真君"
				},
				{
					"id": 401870704,
					"content": "如何稀奇了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870705
					],
					"speakerTitle": "闲云"
				},
				{
					"id": 401870705,
					"content": "若是以往，想必是「那丫头虽有两把刷子，但若换我们申鹤甘雨，也不差几分。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870706
					],
					"speakerTitle": "理水叠山真君"
				},
				{
					"id": 401870706,
					"content": "哼！本仙岂是那种凡事喜欢扒高抬己之辈？那丫头有此大义，不值得本仙一句称赞？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870707
					],
					"speakerTitle": "闲云"
				},
				{
					"id": 401870707,
					"content": "呵呵呵，当然是值得。我在璃月港住久了，早已知道往生堂这地方，代代有英才啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870708
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 401870708,
					"content": "歌尘说得不错。昔日那魔神桃都与我等虽非敌，亦非友，若不是他仍心系众生，甘愿自炼己身，平定幽冥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870709
					],
					"speakerTitle": "削月筑阳真君"
				},
				{
					"id": 401870709,
					"content": "莫说八奇，就是再来八仙，又奈他何？那之后他身化边界，不想竟由凡人维护至今，可叹，可叹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870710
					],
					"speakerTitle": "削月筑阳真君"
				},
				{
					"id": 401870710,
					"content": "话说回来，那往生堂小女，姓甚名谁，我倒还不知。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870711
					],
					"speakerTitle": "理水叠山真君"
				},
				{
					"id": 401870711,
					"content": "堂主姓胡，名桃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870712
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 401870712,
					"content": "蝴蝶的蝴？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870713
					],
					"speakerTitle": "削月筑阳真君"
				},
				{
					"id": 401870713,
					"content": "胡闹的胡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870714
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 401870714,
					"content": "淘气的淘？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870715
					],
					"speakerTitle": "削月筑阳真君"
				},
				{
					"id": 401870715,
					"content": "桃都的桃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870716
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 401870716,
					"content": "噢，蝴蝶的蝴，桃都的桃，好名字，人如其名的好名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870717
					],
					"speakerTitle": "理水叠山真君"
				},
				{
					"id": 401870717,
					"content": "是胡闹的胡，胡搅蛮缠、胡吃海喝的胡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870718
					],
					"speakerTitle": "闲云"
				},
				{
					"id": 401870718,
					"content": "你看你，我不就是活跃一下气氛吗？怎么？她胡闹得，我胡闹不得？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870719
					],
					"speakerTitle": "理水叠山真君"
				},
				{
					"id": 401870719,
					"content": "哦？你几时改的名号啊？胡山胡水真君？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870720
					],
					"speakerTitle": "闲云"
				},
				{
					"id": 401870720,
					"content": "呵呵，还是来喝茶吧，这是帝君从轻策带回的鬼山灵芽，颇为罕见，莫要错了时机。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870721
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 401870721,
					"content": "希望来年也有好茶喝啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870722
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 401870722,
					"content": "嗯，会的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "钟离"
				}
			]
		}
