							465.98
						],
						"pointId": 10624
					}
				]
			},
			"dialogs": [
				{
					"id": 401870601,
					"content": "甘雨，还在忙吗？辛苦你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870602
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 401870602,
					"content": "#欸？刻晴…没有啦，我也没有做什么了不起的事。这次的问题，全靠{NICKNAME}和胡堂主才是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870603
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 401870603,
					"content": "#别妄自菲薄呀，{M#他们}{F#她们}两个当然是最大的功臣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870604
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 401870604,
					"content": "不过我们也没有辜负大家的信任，总务司响应得很快，不是吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870605
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 401870605,
					"content": "虽然明面上，这次的事件不比当初的魔神之灾，但若危机爆发出来，后果就很难说了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870606
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 401870606,
					"content": "嗯…对了，说起这个，其实我一直有个疑惑。那八门七门的阵法，我在月海亭的资料里从未见过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870607
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 401870607,
					"content": "噢，你在想阵法的来历啊，那是凝光变出来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870608
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 401870608,
					"content": "欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870609
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 401870609,
					"content": "哈哈，只是说笑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870610
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 401870610,
					"content": "那日，撰有此阵法的箓笺，是凭空出现在玉京台的，连夜兰都没能查到来历。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870611
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 401870611,
					"content": "凭空出现的？那…凝光是不是太过冒险了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870612
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 401870612,
					"content": "看似冒险，但若深想一些，就明白其中的合理之处…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870613
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 401870613,
					"content": "放眼璃月，既知危机，又晓秘法，还能在玉京台避夜兰耳目、雪中送炭之人…有几位？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870614
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 401870614,
					"content": "啊…难道是师父他们…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870615
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 401870615,
					"content": "我明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "甘雨"
				}
			]
		},
