					}
				]
			},
			"dialogs": [
				{
					"id": 401870401,
					"content": "#那日，你该陪同{NICKNAME}一起进入边界。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870402
					],
					"speakerTitle": "魈"
				},
				{
					"id": 401870402,
					"content": "#降魔大圣恐怕是关心则乱。要有什么事连{NICKNAME}也犯难，我就更派不上用场了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870403
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401870403,
					"content": "况且，是凝光差我去了层岩巨渊，我也分身乏术。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870404
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401870404,
					"content": "降魔大圣若是不满意，不如改日去玉京台，告她一状如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870405
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401870405,
					"content": "呵，向天权…告天权？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870406
					],
					"speakerTitle": "魈"
				},
				{
					"id": 401870406,
					"content": "降魔大圣把玉衡星放在哪里了，她可不怕找谁的麻烦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870407
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401870407,
					"content": "罢了，最后无事便好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870408
					],
					"speakerTitle": "魈"
				},
				{
					"id": 401870408,
					"content": "嗯，望舒客栈真是个好地方啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870409
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401870409,
					"content": "整个璃月都是好地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870410
					],
					"speakerTitle": "魈"
				},
				{
					"id": 401870410,
					"content": "哈哈，说的不错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870411
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401870411,
					"content": "店家，再来一份沾露虾仁，带辣碟的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870412
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401870412,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870413
					],
					"speakerTitle": "魈"
				},
				{
					"id": 401870413,
					"content": "还要一份杏仁豆腐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夜兰"
				}
			]
		},
