						],
						"pointId": 10623
					}
				]
			},
			"dialogs": [
				{
					"id": 401870501,
					"content": "危机解除，我们的天权大人怎么还板着一张脸啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870502
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 401870502,
					"content": "#托胡堂主与{NICKNAME}的福，问题算是圆满解决了。可危机的原因我们仍尚未知晓。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870503
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 401870503,
					"content": "船长消息灵通，应当知道，最近纳塔同样发生了关乎地脉与生死的大事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870504
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 401870504,
					"content": "我在想，其中是否有某种更加隐秘的联系呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870505
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 401870505,
					"content": "要有那种事，不可能只在璃月与纳塔，我会托生意伙伴，帮你留意其它地界的风声。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870506
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 401870506,
					"content": "至于现在嘛，我建议你还是先把心思收回来，别辜负了美景佳节。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870507
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 401870507,
					"content": "呵呵，怎么会？我像是刻晴那种不懂劳逸结合的人吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870508
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 401870508,
					"content": "那你怎么还戴着这支老钗？我的那份酬劳，不是让你去买支新的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870509
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 401870509,
					"content": "不多确认几次，我怎么敢动北斗船长的钱？万一某人心不诚，拿我开涮呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870510
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 401870510,
					"content": "哈哈哈哈，你这女人，非让我替你挑吗？行行，走，跟我一起去街市逛逛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870511
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 401870511,
					"content": "哎呀，北斗船长什么时候这么善解人意了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870512
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 401870512,
					"content": "哈哈，少说那些，走不走啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870513
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 401870513,
					"content": "有何不可？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凝光"
				}
			]
		},
