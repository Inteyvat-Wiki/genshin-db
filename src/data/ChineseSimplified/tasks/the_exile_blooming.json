			"dialogs": [
				{
					"id": 732030401,
					"content": "你不像是拥有神之眼的人，却能驾驭草元素的力量，不是一般的冒险家吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030402
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732030402,
					"content": "据说的确有一帮人不借助神之眼就能驱动元素力，不过相关的传闻都很糟糕，你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030403
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732030403,
					"content": "总之我相信你是个热心的好人，不要走上歪路啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "赛芭"
				}
			]
		}
	]
