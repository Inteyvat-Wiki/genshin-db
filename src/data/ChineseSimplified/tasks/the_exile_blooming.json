			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"赛芭"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731930501,
					"content": "如果不是遇到你们，恐怕我很难看到那些蔷薇发芽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930502
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 731930502,
					"content": "早知道会这样，比起种子，当初我更应该带些书来这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930503,
						731930519
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 731930503,
					"content": "你不是本地人？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930504
					]
				},
				{
					"id": 731930504,
					"content": "很意外吗？这算是说明我适应得很好吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930505
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 731930505,
					"content": "当初刚来这里的时候，从衣食到起居习惯，每一样我都没办法适应。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930506
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 731930506,
					"content": "但过了这么久，慢慢也就接受了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930507
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 731930507,
					"content": "只不过表面适应，并不代表内心就接受了自己的处境。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930508
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 731930508,
					"content": "能在须弥城里盛放的蔷薇，在这里始终还是难以开花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930509
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 731930509,
					"content": "你是学者吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930510
					]
				},
				{
					"id": 731930510,
					"content": "我…曾经被称为学者，但现在不是了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930511
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 731930511,
					"content": "我说了以我的身份不该说的话，了解了以我的身份不该了解的知识。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930512
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 731930512,
					"content": "这是有违教令院禁忌的，所以我就不再是学者了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930513
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 731930513,
					"content": "你说了什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930514
					]
				},
				{
					"id": 731930514,
					"content": "好奇心是我们寻求智慧的原动力，但也是招致罪罚的源头。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930515
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 731930515,
					"content": "这是我被驱逐到这里来之后才明白的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930516
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 731930516,
					"content": "安全起见，我认为不向你细说最好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930517
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 731930517,
					"content": "那好吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930518
					]
				},
				{
					"id": 731930518,
					"content": "咳咳，不过…那个…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930535
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 731930535,
					"content": "我以为冒险家都是来去匆匆的人，帮过一次忙，你大概就不会回来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930536
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 731930536,
					"content": "没想到，又跟你说了这么多话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930537
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 731930537,
					"content": "嗯…在这里，我能敞开聊天的朋友不是很多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930538
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 731930538,
					"content": "你认为…之后…你有空来帮忙给它们施肥吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930539
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 731930539,
					"content": "可以。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930540
					]
				},
				{
					"id": 731930540,
					"content": "那…好，我会等你来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "赛芭"
				},
				{
					"id": 731930519,
					"content": "为什么要种须弥蔷薇？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930520
					]
				},
				{
					"id": 731930520,
					"content": "你可能不太了解须弥蔷薇，这种植物的用途非常广泛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930521
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 731930521,
					"content": "它可以食用、可以药用，作为礼品，也有很高的经济价值。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930522
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 731930522,
					"content": "这还仅仅是它在我们日常生活中的常见用途。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930523
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 731930523,
					"content": "须弥蔷薇的花、叶、茎并不总是我们今天见到的这样，它曾经也有过不同的形态。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930524
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 731930524,
					"content": "我认为地理条件的改变，促使须弥蔷薇的形态特征也发生过改变。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930525
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 731930525,
					"content": "从它的形态演化过程，我们能得到很多历史地理方面的信息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930526
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 731930526,
					"content": "这不是一两句话说得清的事，向一位路过的冒险家解释恐怕也不合规定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930527
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 731930527,
					"content": "如果你对植物演化感兴趣，就去教令院吧，那里的植物学教育更加完备。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930528
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 731930528,
					"content": "所以是为了研究？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930529
					]
				},
				{
					"id": 731930529,
					"content": "我已经不是学者了，没有做研究的条件和资格。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930530
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 731930530,
					"content": "非要说为什么的话…唉，你的好奇心可真重。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930531
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 731930531,
					"content": "我以前的居所里种了很多须弥蔷薇，它们开花的时候很漂亮，我每天都看得到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930532
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 731930532,
					"content": "有可能的话，我还想像以前一样，每天都有它们作陪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930533
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 731930533,
					"content": "…只是这样而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930534
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 731930534,
					"content": "我能理解。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930535
					]
				}
			]
		},
		{
			"id": 7320301,
			"completionStepIds": [
				7320301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320301",
							"2"
						],
						"stepId": 7320301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"赛芭"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732030101,
					"content": "你们来了啊，很守约呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030102
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732030102,
					"content": "我做了一些黄油鸡，如果你们肚子饿的话，可以一起坐下来吃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030103
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732030103,
					"content": "黄油鸡！好耶，我要吃一大盘！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030104,
						732030105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732030104,
					"content": "派蒙，这样不好…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030106
					]
				},
				{
					"id": 732030106,
					"content": "唔…对不起嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732030107,
					"content": "没关系的，请不用跟我客气，喜爱食物也是人之常情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030108
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732030108,
					"content": "待会儿我就去把菜拿出来热一热，再给你们装好，也算是答谢你们之前帮我的忙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030109
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732030109,
					"content": "呜哇，赛芭小姐，你真好！你种的蔷薇花一定会顺着你的心意，好好生长的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732030110,
					"content": "哈哈，这段时间，我一直在尽量保持土壤湿润，植株幼苗状态还算良好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030111
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732030111,
					"content": "只是它们的生长速度有点慢，让人担心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030112
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732030112,
					"content": "一般来说，如果胚芽状态良好，很快就应该萌发了，但这几株到现在也没有动静…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030113
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732030113,
					"content": "不知道是不是土壤肥力不够，它们还是这个状态的话，我最好继续从外部施肥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030114,
						732030115
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732030114,
					"content": "再施一次肥吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030116
					]
				},
				{
					"id": 732030116,
					"content": "那就又要麻烦你们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030117
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732030117,
					"content": "小事一桩，包在我们身上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732030115,
					"content": "用草元素的力量试试。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030116
					]
				},
				{
					"id": 732030105,
					"content": "抱歉，派蒙是这样的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030106
					]
				}
			]
		},
		{
			"id": 7320303,
			"completionStepIds": [
				7320303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320303",
							"2"
						],
						"stepId": 7320303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"赛芭"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732030301,
					"content": "这次也谢谢你们了，能在这里看到须弥蔷薇生长，我真的很开心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030302
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732030302,
					"content": "在赛芭和你们说话的同时，一簇簇新叶从旧叶中伸出…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732030303
					]
				},
				{
					"id": 732030303,
					"content": "新叶逐渐舒展，结出了饱满的花苞…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732030304
					]
				},
				{
					"id": 732030304,
					"content": "花苞缓缓绽放，赛芭种下的须弥蔷薇终于吐蕊。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732030305
					]
				},
				{
					"id": 732030305,
					"content": "她折下一支须弥蔷薇，交给了你和派蒙。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732030306
					]
				},
				{
					"id": 732030306,
					"content": "这不好吧，本来赛芭小姐种的蔷薇就不多，现在还折了一支给我们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732030307,
					"content": "没关系哦，如果不是你们帮忙，须弥蔷薇是没办法在这里开出花来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030308,
						732030309
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732030308,
					"content": "一点小忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030310
					]
				},
				{
					"id": 732030310,
					"content": "一座蔷薇园当然很壮观，不过单支蔷薇也有自己的美。以前我还是学者的时候，就对蔷薇感兴趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030311
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732030311,
					"content": "欸，原来赛芭小姐是位学者吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732030312,
					"content": "对了，我还没有告诉过派蒙呢。我并不是一直居住在阿如村的居民，我是从教令院里…「搬」过来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030313
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732030313,
					"content": "我就说嘛，赛芭小姐说话的方式好文雅，真的很像学者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732030314,
					"content": "我明白啦，赛芭小姐是想继续研究蔷薇，所以才会种植它们的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732030315,
					"content": "倒不能这么说，学者们对研究对象的兴趣不该是为了做研究才刻意培养出来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030316
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732030316,
					"content": "是因为喜爱这个世界，所以才想了解它，想理解草木的生命轨迹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030317
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732030317,
					"content": "拿我举例的话，以前我有个课题——须弥地理环境演化对蔷薇物种形态的影响。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030318
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732030318,
					"content": "你想，如果须弥的地理环境演化方向和今天完全不同，为了适应自然条件，蔷薇会演化成什么形态呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030319
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732030319,
					"content": "会不会演化成爬藤植物？那样的话，今天的教令院墙壁上说不定就会爬满蔷薇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030320
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732030320,
					"content": "会不会演化出族生花？一开一大捧，很有气派吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030321
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732030321,
					"content": "说不定还会有各种各样的颜色，白的、红的、金的…那会是一个全新的品种。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030322
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732030322,
					"content": "当然咯，现在很少有人能发现新物种了，像过去某些顶尖学者那样培育新物种，就更别提了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030323
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732030323,
					"content": "我想说明的是：每一支蔷薇身上都蕴含着大量的可能性。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030324
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732030324,
					"content": "探索这些可能性是一件很开心的事，那时候我每天都怀着兴趣开开心心地收集着标本。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030325
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732030325,
					"content": "回想起来，真是一段纯粹又愉快的时光。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030326
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732030326,
					"content": "总而言之，你们拿着就好了，对我来说，这可不是损失，而是快乐的分享。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030327
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732030327,
					"content": "如果实在觉得心里别扭，以后就多带些须弥蔷薇来看我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030328
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732030328,
					"content": "和你们说话的时候，感觉很放松。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030329
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732030329,
					"content": "不管我说些什么，你们都不会觉得我是在说「闲话」，打断我说话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030330
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732030330,
					"content": "我也会送你们一些小礼物的，虽然对现在的我基本没用处，但你们说不定会喜欢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030331
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732030331,
					"content": "会常来的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030332
					]
				},
				{
					"id": 732030332,
					"content": "一定要常来看我呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732030309,
					"content": "别放心上。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030310
					]
				}
			]
		},
		{
