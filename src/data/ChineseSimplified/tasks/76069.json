					}
				]
			},
			"dialogs": [
				{
					"id": 760690401,
					"content": "这种感觉…看来是我没发现的「狼灵」碎片，显化成的化身啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690402
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 760690402,
					"content": "那是谁把你留在了这里？又是为了守护什么？现在…就告诉我答案吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690403
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 760690403,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690404
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 760690404,
					"content": "…我重复过许多次了，染血的道路，有我一人足矣，不需要他人的追随。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690405
					],
					"speakerTitle": "罗兰"
				},
				{
					"id": 760690405,
					"content": "哈，那就当我们只是刚好同路吧？刚好从蒙德同路到挪德卡莱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690406
					],
					"speakerTitle": "(test)无名骑士A"
				},
				{
					"id": 760690406,
					"content": "又刚好被某位骑士救过无数次、刚好对那位骑士心怀憧憬…所以忍不住，也踏上了相近的道路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690407
					],
					"speakerTitle": "(test)无名骑士B"
				},
				{
					"id": 760690407,
					"content": "就算不能理解，至少也想在近旁见证…哪怕这一路下来，就只剩下我们几个了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690408
					],
					"speakerTitle": "(test)无名骑士C"
				},
				{
					"id": 760690408,
					"content": "嗷呜——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690409
					],
					"speakerTitle": "(test)无名骑士的狼"
				},
				{
					"id": 760690409,
					"content": "如果这就是你们认定的骑士道…我无权否认。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690410
					],
					"speakerTitle": "罗兰"
				},
				{
					"id": 760690410,
					"content": "……",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760690411
					]
				},
				{
					"id": 760690411,
					"content": "那些该死的魔物…都被消灭了吗？附近的居民…都没事了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690412
					],
					"speakerTitle": "(test)无名骑士A"
				},
				{
					"id": 760690412,
					"content": "咳…太好了…只可惜，我们没那个力气见证您走到最后…真不甘心啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690413
					],
					"speakerTitle": "(test)无名骑士B"
				},
				{
					"id": 760690413,
					"content": "从今往后，就只有您一个人了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690414
					],
					"speakerTitle": "(test)无名骑士C"
				},
				{
					"id": 760690414,
					"content": "…到最后，我的剑还是没能守护一切。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690415
					],
					"speakerTitle": "罗兰"
				},
				{
					"id": 760690415,
					"content": "…到最后，这条路上终究只剩下一人…或许从一开始，就本该如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690416
					],
					"speakerTitle": "罗兰"
				},
				{
					"id": 760690416,
					"content": "至少让这些剑，与此地的狼灵为你们守墓吧——为了不让漆黑的孽物，惊扰你们的安眠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690417
					],
					"speakerTitle": "罗兰"
				},
				{
					"id": 760690417,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690418
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 760690418,
					"content": "原来是这样…骑士团里有过记载，「染血骑士」出走时，曾有骑士自发追随，却没有了后文。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690419
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 760690419,
					"content": "没想到最后的结局，是为征讨魔物而埋骨在这里…不愧是西风骑士团的骑士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690420
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 760690420,
					"content": "但你们的「愿望」，真的止步于此了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690421
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 760690421,
					"content": "至今未熄的战火、寄宿于剑的思念…请告诉我，「骑士」们的决意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690422
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 760690422,
					"content": "我将用玻瑞亚斯遗落于此的力量封锁这片战场…那头小狼也会在外为你们守灵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690423
					],
					"speakerTitle": "罗兰"
				},
				{
					"id": 760690423,
					"content": "你们理应得到这样的「守护」——永远不被惊扰，永远得享安宁，永远…不必再见这世间的不公。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690424
					],
					"speakerTitle": "罗兰"
				},
				{
					"id": 760690424,
					"content": "永别了——我最后的「战友」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690425
					],
					"speakerTitle": "罗兰"
				},
				{
					"id": 760690425,
					"content": "…不…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690426
					],
					"speakerTitle": "(test)无名骑士A"
				},
				{
					"id": 760690426,
					"content": "…不要…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690427
					],
					"speakerTitle": "(test)无名骑士B"
				},
				{
					"id": 760690427,
					"content": "…让我们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690428
					],
					"speakerTitle": "(test)无名骑士C"
				},
				{
					"id": 760690428,
					"content": "…再一次…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690429
					],
					"speakerTitle": "(test)无名骑士C"
				},
				{
					"id": 760690429,
					"content": "果然——你们的「愿望」…不是在这种不见天日的地方默默朽去吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690430
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 760690430,
					"content": "那就来吧！跟我一起，再一次——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690431
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 760690431,
					"content": "——奔赴战场！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "法尔伽"
				}
			]
		}
	]
}