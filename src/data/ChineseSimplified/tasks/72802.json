			},
			"dialogs": [
				{
					"id": 728020301,
					"content": "女儿回家的日期…怎么比这家书上落款的日期还早？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020302
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020302,
					"content": "别胡思乱想了，大概只是误会，还是好好帮我想想明天午饭做什么吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "满"
				}
			]
		},
		{
			"id": 7280204,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280204",
							"2"
						],
						"stepId": 7280204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"曜",
					"满"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728020401,
					"content": "我们家竺子现在不在，请你等到晚上再来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020402
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020402,
					"content": "等到了晚上，竺子应该就会回来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "满"
				}
			]
		},
		{
			"id": 7280205,
			"completionStepIds": [
				7280205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280205",
							"2"
						],
						"stepId": 7280205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"竺子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728020501,
					"content": "竺子一家应该都在屋子里了，我们敲敲门吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 728020502,
					"content": "他们好像在聊些什么。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020503
					]
				},
				{
					"id": 728020503,
					"content": "说起来，不知道我们之前救下的那只狸猫怎么样了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020504
					],
					"speakerTitle": "满"
				},
				{
					"id": 728020504,
					"content": "你呀，太善良了，那只狸猫不过是腿上受了点小伤，其实把它留在草丛里，让它自己修养也能好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020505
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020505,
					"content": "我舍不得嘛，它当时都看着我流眼泪了，可怜巴巴的，我怎么能不把它带回家照顾呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020506
					],
					"speakerTitle": "满"
				},
				{
					"id": 728020506,
					"content": "算啦，行善总是好事，就是它吃的实在有点多，快赶上我了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020507
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020507,
					"content": "敲门",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020508
					]
				},
				{
					"id": 728020508,
					"content": "是谁啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020509
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020509,
					"content": "是之前来过的旅行者。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020510
					]
				},
				{
					"id": 728020510,
					"content": "哦，是那位旅行者吧，稍等。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020511
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020511,
					"content": "你、你好！我是竺子，初次…不…又见面了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020512
					],
					"speakerTitle": "竺子"
				},
				{
					"id": 728020512,
					"content": "不好意思，因为实在太想家，所以我在把信交给你们之后又变了主意，坐船回了家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020513
					],
					"speakerTitle": "竺子"
				},
				{
					"id": 728020513,
					"content": "啊哈哈…之前都是误会，抱歉啦，让你跑这么一趟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020514
					],
					"speakerTitle": "竺子"
				},
				{
					"id": 728020514,
					"content": "你有办法回到稻妻？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020515
					]
				},
				{
					"id": 728020515,
					"content": "…啊，我有自己的途径哈哈，这个你就不用管了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020516
					],
					"speakerTitle": "竺子"
				},
				{
					"id": 728020516,
					"content": "那个，报酬我已经准备好了，请收下吧，多谢你们帮忙。快点…呃，快点忙你们的事去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020517
					],
					"speakerTitle": "竺子"
				},
				{
					"id": 728020517,
					"content": "竺子小姐的话怎么前后不一？要是往返稻妻有这么容易的话，当初干嘛还要拜托我们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020518,
						728020520
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 728020518,
					"content": "你在璃月的产业呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020519
					]
				},
				{
					"id": 728020519,
					"content": "产业？什么产业，我在璃月还有产业的吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020522
					],
					"speakerTitle": "竺子"
				},
				{
					"id": 728020522,
					"content": "…啊，这种东西都是身外之物，和家人相比完全不重要，我早就托付给别人啦，啊…哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020523
					],
					"speakerTitle": "竺子"
				},
				{
					"id": 728020523,
					"content": "喂喂，真正的竺子在璃月找工作都成问题，怎么会摇身一变成有钱人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020524
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 728020524,
					"content": "你到底是谁？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020525
					]
				},
				{
					"id": 728020525,
					"content": "我…我当然是竺子了！长得是竺子，声音是竺子，这有什么好怀疑的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020526
					],
					"speakerTitle": "竺子"
				},
				{
					"id": 728020526,
					"content": "我说你啊！真是纠缠不休…算了，我不和你说了，明天我还要工作，先走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020527
					],
					"speakerTitle": "竺子"
				},
				{
					"id": 728020527,
					"content": "欸，竺子！这孩子…怎么突然火气这么大…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020528
					],
					"speakerTitle": "满"
				},
				{
					"id": 728020528,
					"content": "抱歉啊，旅行者，这孩子肯定是工作太累了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020529
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020529,
					"content": "但你也看到了，这确实是我们的女儿，你带来的那封信…说不定真是这孩子忘记了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020530
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020530,
					"content": "不过无论如何，还是谢谢你帮忙跑这一趟，报酬的话…还请你再稍等一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020531,
						728020532
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020531,
					"content": "发生什么了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020533
					]
				},
				{
					"id": 728020533,
					"content": "那倒没有，报酬我们还是拿得出来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020534
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020534,
					"content": "竺子这孩子，白天不是去工作吗？但她每天拿回来的工钱总是有点奇怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020535
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020535,
					"content": "有的是一些奇怪的种子，有的是一些野果子，就是不直接拿摩拉回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020536
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020536,
					"content": "虽然这些东西也值些钱，但我们还得把它们拿出去卖掉才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020537
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020537,
					"content": "对你这样的旅行者来说，报酬肯定也是直接拿摩拉比较方便吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020538
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020538,
					"content": "请你明天再过来一趟吧，到那时候，我会直接把摩拉给你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "曜"
				},
				{
					"id": 728020532,
					"content": "如果有困难的话…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020533
					]
				},
				{
					"id": 728020520,
					"content": "你在璃月的豪宅呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020521
					]
				},
				{
					"id": 728020521,
					"content": "豪宅？什么豪宅，我在璃月还有豪宅的吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020522
					],
					"speakerTitle": "竺子"
				}
			]
		},
