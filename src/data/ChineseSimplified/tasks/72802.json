			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"满",
					"曜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728020201,
					"content": "明天午饭做几道菜好呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020202
					],
					"speakerTitle": "满"
				},
				{
					"id": 728020202,
					"content": "咱家孩子是越来越能吃了，多做点总归没错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020203
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020203,
					"content": "咦？请问您是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020204,
						728020205
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020204,
					"content": "请问这是竺子家吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020206
					]
				},
				{
					"id": 728020206,
					"content": "是的，请问您有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020207
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020207,
					"content": "这是竺子让我带给你们的信。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020208
					]
				},
				{
					"id": 728020208,
					"content": "信，这孩子为什么突然要写信？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020209
					],
					"speakerTitle": "满"
				},
				{
					"id": 728020209,
					"content": "还写这么长…明明都已经回家了，有什么话直接对我们说不就好了嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020210,
						728020211
					],
					"speakerTitle": "满"
				},
				{
					"id": 728020210,
					"content": "…什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020212
					]
				},
				{
					"id": 728020212,
					"content": "这位…旅行者，你听起来好像很意外？虽然我们家竺子确实外出游历过一阵子，但她现在已经回家了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020213
					],
					"speakerTitle": "满"
				},
				{
					"id": 728020213,
					"content": "既然回家了，又有什么必要请人送家书呢，你们是找错人了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020214
					],
					"speakerTitle": "满"
				},
				{
					"id": 728020214,
					"content": "等一下，孩子她妈，我扫了一眼这封家书，这笔迹、这口吻的确是我们的女儿竺子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020215
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020215,
					"content": "信中也确实说到，她短期内不打算回来，让我们保重身体。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020216
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020216,
					"content": "这到底是怎么回事？不会是这孩子一边托这位旅行者带信回来，一边自己回来了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020217
					],
					"speakerTitle": "满"
				},
				{
					"id": 728020217,
					"content": "我觉得这其中可能有点误会，等孩子回来了，我们问一问吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020218
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020218,
					"content": "旅行者，不巧我家竺子今天有事外出了，等她回来我们夫妻俩会去问清楚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020219
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020219,
					"content": "如果你愿意的话，就明天晚上再过来找我们吧，让那孩子当面给你解释清楚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020220,
						728020222
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020220,
					"content": "现在她在哪？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020221
					]
				},
				{
					"id": 728020221,
					"content": "这孩子说自己要忙工作的事，吃了饭之后就急匆匆地离开了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020224
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020224,
					"content": "是啊，每天都早出晚归的，只有晚上我们才能见着她，真不知道这孩子到底在忙什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020225
					],
					"speakerTitle": "满"
				},
				{
					"id": 728020225,
					"content": "总之，请你明天晚上过来吧，要真是那孩子弄错了，一定让她给你当面道歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020226
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020226,
					"content": "还麻烦你跑了这么长一段路，真是不好意思啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020227
					],
					"speakerTitle": "满"
				},
				{
					"id": 728020227,
					"content": "竺子这孩子，真是不让人省心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "曜"
				},
				{
					"id": 728020222,
					"content": "为什么是晚上？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020223
					]
				},
				{
					"id": 728020223,
					"content": "这孩子说自己要忙工作的事，每天白天吃了饭之后都会离开。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020224
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020211,
					"content": "竺子…回家了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020212
					]
				},
				{
					"id": 728020205,
					"content": "请问是竺子的父母吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020206
					]
				}
			]
		},
		{
			"id": 7280203,
