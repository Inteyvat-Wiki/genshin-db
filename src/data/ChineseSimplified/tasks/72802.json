			"dialogs": [
				{
					"id": 728020601,
					"content": "女儿又跑哪儿去了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020602,
						728020603
					],
					"speakerTitle": "满"
				},
				{
					"id": 728020602,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020604
					]
				},
				{
					"id": 728020604,
					"content": "就算是工作，她走之前也会给我们说一声，但今天这孩子怎么不声不响地就走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020605
					],
					"speakerTitle": "满"
				},
				{
					"id": 728020605,
					"content": "昨天晚上你离开之后，竺子说觉得很累，直接就回房睡下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020606
					],
					"speakerTitle": "满"
				},
				{
					"id": 728020606,
					"content": "等到天亮之后，我们夫妻俩起床一看，她就已经不在自己的床上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020607
					],
					"speakerTitle": "满"
				},
				{
					"id": 728020607,
					"content": "我们到处找也没有找到女儿，我丈夫就直接到更远的地方去找了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020608
					],
					"speakerTitle": "满"
				},
				{
					"id": 728020608,
					"content": "但我在这一带找了半天，完全没找见女儿的踪迹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020609
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020609,
					"content": "啊，这孩子不会又出去旅行了吧？真是叫人怎么办才好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020610
					],
					"speakerTitle": "满"
				},
				{
					"id": 728020610,
					"content": "孩子他妈，别着急，我待会儿再去找找，你先在家把竺子的房间扫一扫吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020611
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020611,
					"content": "那孩子走的时候也不关好窗户，搞得房间里被吹进了一大堆树叶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020612
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020612,
					"content": "对了，旅行者，这些是说好的报酬，请你拿好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020613
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020613,
					"content": "唉，竺子这孩子到底又去做什么了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "满"
				},
				{
					"id": 728020603,
					"content": "竺子又工作去了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020604
					]
				}
			]
		},
