			"dialogs": [
				{
					"id": 401120501,
					"content": "穿着那样衣服的人，确实之前听其他巡林员提到过…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120502
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 401120502,
					"content": "是嘛…那看来我的推断并没有错…咦？那是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120503
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 401120503,
					"content": "#{NICKNAME}，派蒙，凯亚先生，还有，可莉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120504
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 401120504,
					"content": "柯莱姐姐，好久不见啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120505
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401120505,
					"content": "柯莱，还有优菈！你们怎么在这里？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120506,
					"content": "呃，我主要是在问优菈啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120507,
					"content": "没想到出趟远门还能撞上外出度假的游击小队队长，真巧啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120508
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 401120508,
					"content": "…怎么都来了？啧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120509
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 401120509,
					"content": "她刚刚是不是露出了很为难的表情…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120510,
						401120511
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120510,
					"content": "不要在意这些。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401120512
					]
				},
				{
					"id": 401120512,
					"content": "啊对对，好的好的！我们走吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120513
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 401120513,
					"content": "就算要照顾我的感受也不必这样，你们搞错了，我不会觉得尴尬的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120514
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 401120514,
					"content": "你最好是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120515
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 401120515,
					"content": "那太好了！你会不远千里跑到须弥来，原因一定很有趣吧，快跟我们分享分享。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120516
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 401120516,
					"content": "（一副看热闹不嫌事大的表情呢…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401120517
					]
				},
				{
					"id": 401120517,
					"content": "真要说的话也有点复杂…概括一下吧，我在找劳伦斯家的一位表亲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120518
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 401120518,
					"content": "不久前，那位劳伦斯突然失踪，从他家里调查的结果来看，他似乎是想前来须弥寻找复兴家族的办法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120519
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 401120519,
					"content": "大老远跑到别的国家去找办法？他难道打算在须弥读书？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120520
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120520,
					"content": "那实在有些迂回了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401120521
					]
				},
				{
					"id": 401120521,
					"content": "那倒不会，他早就不在基础教育的年龄段了。至于深造…以我对他的认识，他多半也没那个心思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120522
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 401120522,
					"content": "他在乎家族名誉多过其他。复兴这个想法不能说有错，但我不清楚他的执念到了哪种地步，会不会惹出什么麻烦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120523
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 401120523,
					"content": "于情于理，都不能放着他不管。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120524
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 401120524,
					"content": "如果这事属实，你的那位表亲在劳伦斯家也算是了不起的行动派了。一路从蒙德到须弥可不容易。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120525
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 401120525,
					"content": "而且竟然还劳烦我为他的人身安危操心，哼，好大的胆子啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120526
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 401120526,
					"content": "嘿嘿，优菈人真好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120527
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120527,
					"content": "对！优菈姐姐上次还带了月亮派给可莉吃！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120528
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401120528,
					"content": "咳！毕竟是同一个家族的人…总之我会找到他，在确保安全的前提下带他回去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120529,
						401120530
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 401120529,
					"content": "辛苦你了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401120531
					]
				},
				{
					"id": 401120531,
					"content": "你们呢，你们怎么会突然出现在这里？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120532
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 401120532,
					"content": "向优菈和柯莱说明了来意…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401120533
					]
				},
				{
					"id": 401120533,
					"content": "难办了…提纳里师父最近在禅那园出席讲座…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120534
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 401120534,
					"content": "不过我倒是能帮上一点忙。这封邀请函里模糊提到的位置是在沙漠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120535
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 401120535,
					"content": "沙漠？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120536
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 401120536,
					"content": "咦？难道妈妈的朋友住在沙漠里面？唔…沙漠阿姨？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120537
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401120537,
					"content": "我记得曾经听赛诺大人说过，沙漠的这块区域流传着奇怪的传说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120538
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 401120538,
					"content": "说是有一个能够实现所有愿望的秘境…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120539
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 401120539,
					"content": "啊不对，应该是叫赛诺先生！嗯，叫先生就好了，我得习惯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120540
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 401120540,
					"content": "实现所有愿望的秘境…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120541
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 401120541,
					"content": "真的吗，真的有那种地方吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120542
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120542,
					"content": "如果是几年前我应该会信，还好现在见识多了些，我会保持适当的怀疑态度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120543
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 401120543,
					"content": "#怪不得…传说未必是真的，但他很可能去碰运气了。{NICKNAME}，如果你们将要前往那个区域的话，让我同行吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120544
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 401120544,
					"content": "表亲的书柜里收藏了很多与须弥沙漠有关的传说。这么推测…他很有可能就是奔着那个秘境去的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120545
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 401120545,
					"content": "我也一起去，可以吗？我、我觉得你们会需要我的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120546
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 401120546,
					"content": "大家在须弥肯定需要向导，我想我能够胜任！勇敢伸出援手，才是一位巡林员该做的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120547
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 401120547,
					"content": "柯莱的能力我们放心。这样一来队伍又壮大了呢，可莉队长，你觉得如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120548
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 401120548,
					"content": "可莉觉得超——棒！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120549
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401120549,
					"content": "故事书里说，「一个人的快乐只有一小点，一群人的快乐就会变很多」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120550
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401120550,
					"content": "妈妈的朋友见到那么多哥哥姐姐和我一起去，一定会非常开心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120551
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401120551,
					"content": "没错！那么，事不宜迟，就再使用一次「神奇邀请函」吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120552
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120552,
					"content": "可莉拿出了「神奇邀请函」，大家一起读出了上面的目的地——",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 401120530,
					"content": "真不容易。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401120531
					]
				},
				{
					"id": 401120511,
					"content": "大家一起喝个下午茶吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401120512
					]
				}
			]
		},
