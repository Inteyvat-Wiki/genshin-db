					}
				]
			},
			"dialogs": [
				{
					"id": 401120301,
					"content": "吓、吓死我了，我还以为要被送到奇怪的地方去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120302,
					"content": "欸嘿嘿，可莉不是故意的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120303
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401120303,
					"content": "我知道啦，不过，没想到那个「神奇邀请函」居然真的有用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120304,
					"content": "有意思，真的在一瞬间抵达了须弥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120305
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 401120305,
					"content": "原来这就是妈妈的朋友住的地方，有好多好大的花，还有好多会跳的蘑菇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120306
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401120306,
					"content": "须弥还有好多神奇的东西呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120307,
					"content": "比如，嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120308,
						401120310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120308,
					"content": "身上长蘑菇的猪。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401120309
					]
				},
				{
					"id": 401120309,
					"content": "对对，第一次看到的时候我都吓了一跳呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120312,
					"content": "可莉，这种会跳的蘑菇叫蕈兽，看上去可爱，但在你靠近的时候，它会故意用帽子把你撞倒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120313
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 401120313,
					"content": "真的吗？那可莉也要用帽子和它对撞！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120314
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401120314,
					"content": "可莉有脑袋上的帽子和衣服后面的帽子，一定能赢的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120315
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401120315,
					"content": "可莉，强！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401120316
					]
				},
				{
					"id": 401120316,
					"content": "用帽子至少比用炸弹好多了…不过还好我们跟可莉熟，可以劝阻她用炸弹，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120317,
					"content": "嗯！可莉会注意，不用炸弹炸周围的东西！呃…尽量不用…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120318
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401120318,
					"content": "真的？好体贴，小可莉长大了呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120319,
					"content": "嗯！是很懂事的火花骑士可莉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120320
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401120320,
					"content": "那么懂事的火花骑士就跟我们去化城郭见一位名叫提纳里的朋友吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120310,
					"content": "银色的飞天飘浮灵。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401120311
					]
				},
				{
					"id": 401120311,
					"content": "咦，有这样的东西吗…喂！你不会是在说我吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120312
					],
					"speakerTitle": "派蒙"
				}
			]
		},
