					}
				]
			},
			"dialogs": [
				{
					"id": 401120201,
					"content": "琴团长，我们来啦——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120202,
					"content": "两位好，等你们多时了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120203
					],
					"speakerTitle": "琴"
				},
				{
					"id": 401120203,
					"content": "哇，出现在这里的人比我想象中要多…竟然还有小可莉和凯亚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120204,
					"content": "#原来是小派蒙和荣誉骑士{M#哥哥}{F#姐姐}！好久不见！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120205
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401120205,
					"content": "哎哟，没想到是你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120206
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 401120206,
					"content": "真是让人措手不及…该怎么说，两位的出现总是会带来意想不到的惊喜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120207
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 401120207,
					"content": "嘿嘿，一想到能见老朋友，兴奋得忘记敲门了，没吓到你们吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120208,
					"content": "等等，你们不会是在聊什么我们不该听到的机密吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120209,
						401120211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120209,
					"content": "没有猎鹿人的订单？是我走错了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401120210
					]
				},
				{
					"id": 401120210,
					"content": "好狡猾，居然一下子就装成了猎鹿人餐馆的送餐员！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120213,
					"content": "#许久不见，派蒙和{NICKNAME}的关系还是一如既往的融洽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120214
					],
					"speakerTitle": "琴"
				},
				{
					"id": 401120214,
					"content": "请别担心，我们没在谈什么机密话题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120215
					],
					"speakerTitle": "琴"
				},
				{
					"id": 401120215,
					"content": "不如说，我们正好谈到你们几位…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120216
					],
					"speakerTitle": "琴"
				},
				{
					"id": 401120216,
					"content": "就让事件的主角亲自讲讲吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120217
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 401120217,
					"content": "嗯嗯，可莉来说！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120218
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401120218,
					"content": "前几天，可莉在禁闭室里读《嘟嘟可故事集》的时候…从窗户外飞来了一封信。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120219
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401120219,
					"content": "一封信，信要怎么飞呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120220,
					"content": "像小鸟一样，扇动着翅膀就进来了，它还会说话呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120221
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401120221,
					"content": "说了一些…嗯，说了一些不明白的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120222
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401120222,
					"content": "不明白的话？我猜应该是提到什么禁闭室之类的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120223
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 401120223,
					"content": "呃…凯亚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120224
					],
					"speakerTitle": "琴"
				},
				{
					"id": 401120224,
					"content": "适当的教育指导很有意义哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120225
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 401120225,
					"content": "呜，好吧，那封信开头说的是：「可莉呀，你怎么又在禁闭室了…」对不起嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120226
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401120226,
					"content": "上面还写着：「最近妈妈有事要忙，没法带你出去玩，不过妈妈有个朋友很欢迎你，邀请你到她家去做客哦！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120227
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401120227,
					"content": "啊，是艾莉丝女士！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120228
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120228,
					"content": "这不是挺好的嘛。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401120229
					]
				},
				{
					"id": 401120229,
					"content": "按理说应该不会有什么危险，但要去的地方…实在是有点远。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120230
					],
					"speakerTitle": "琴"
				},
				{
					"id": 401120230,
					"content": "嗯，信上说，妈妈朋友的家在须弥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120231
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401120231,
					"content": "骑士团自然不可能同意可莉一个人去须弥，但可莉出门拜访那位朋友的意愿也很坚定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120232
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 401120232,
					"content": "对！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120233
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401120233,
					"content": "于是我们想，谁能一起出远门呢？假如有一位可靠的英雄，甚至一度拯救过蒙德——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120234
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 401120234,
					"content": "喔！原来就是因为这个把我们叫过来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120235
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120235,
					"content": "#非常抱歉，{NICKNAME}，但可莉跟你关系比较好…我们认为你确实是合适的人选。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120236
					],
					"speakerTitle": "琴"
				},
				{
					"id": 401120236,
					"content": "#那当然没关系啦，{NICKNAME}，我们就接下这个委托吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120237
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120237,
					"content": "#嘿嘿，荣誉骑士{M#哥哥}{F#姐姐}…可以吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120238,
						401120239
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401120238,
					"content": "当然可以啦！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401120240
					]
				},
				{
					"id": 401120240,
					"content": "#耶！！有荣誉骑士{M#哥哥}{F#姐姐}在，去哪里都不怕啦！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120241
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401120241,
					"content": "#你看，我说{M#他}{F#她}肯定会答应的，那一切就交给可靠的{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120242
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 401120242,
					"content": "凯亚…你也一起去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120243
					],
					"speakerTitle": "琴"
				},
				{
					"id": 401120243,
					"content": "之前积压的文件已经被你偷偷完成了吧…你也该找个机会好好放松一下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120244
					],
					"speakerTitle": "琴"
				},
				{
					"id": 401120244,
					"content": "哎呀，被你发现了吗？那我也没什么拒绝的理由了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120245
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 401120245,
					"content": "有凯亚在的话，我们应付麻烦就方便多啦！可是须弥很远，要走好多路…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120246
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120246,
					"content": "没关系，妈妈的信里还有「神奇邀请函」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120247
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401120247,
					"content": "信上说，只要大家一起大声喊出想去的地方，就能像眨个眼睛一样，咻地到达。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120248
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401120248,
					"content": "哇，还有这么方便的道具！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120249
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120249,
					"content": "但只有三次机会，所以不能乱用…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120250
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401120250,
					"content": "算上去和回来要用的两次，不是明明还多出了一次嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120251
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120251,
					"content": "这么神奇的东西，更应该省着点用吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120252
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 401120252,
					"content": "毕竟现在还不知道目的地具体会在何处，去到那里之后，会不会遇上别的风险…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120253
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 401120253,
					"content": "#我有个想法，{NICKNAME}，凭你的人脉，应该认识熟悉须弥地理的当地朋友吧？我们传送到对方身边。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120254
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 401120254,
					"content": "这样，一来可以试试这「神奇邀请函」的功能，二来也能找人担当向导。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120255
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 401120255,
					"content": "好像有那么点道理。反正也还多一次机会，不用白不用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120256
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120256,
					"content": "那么…聪明的派蒙，有什么提案吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120257
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 401120257,
					"content": "嘿嘿…要说到熟悉须弥，又能担当向导的话…听上去很像是巡林员…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120258
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120258,
					"content": "嗯，说到巡林员经常出没的地方，那就是——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120259
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120259,
					"content": "化城郭。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401120260
					]
				},
				{
					"id": 401120260,
					"content": "说不定我们还能让提纳里帮忙呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120261
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120261,
					"content": "好，那么我们就先去化城郭吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120262
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 401120262,
					"content": "#嗯，可莉去哪里玩都很开心！而且，可莉相信凯亚哥哥和荣誉骑士{M#哥哥}{F#姐姐}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120263
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401120263,
					"content": "代理团长大人，那我们就出发了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120264
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 401120264,
					"content": "听凭风引，祝你们旅途愉快。以及，可莉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120265
					],
					"speakerTitle": "琴"
				},
				{
					"id": 401120265,
					"content": "可莉知道了，一定会注意安全的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120266
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401120266,
					"content": "好！出发啦，我们要去——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120267
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120267,
					"content": "化城郭！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120268
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120268,
					"content": "化城郭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120269
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 401120269,
					"content": "化城郭。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401120270
					]
				},
				{
					"id": 401120270,
					"content": "化成鸽——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120271
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401120271,
					"content": "哎什么，什么鸽，等等！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120239,
					"content": "乐意之至。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401120240
					]
				},
				{
					"id": 401120211,
					"content": "派蒙，我路带到了，就先走了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401120212
					]
				},
				{
					"id": 401120212,
					"content": "这路还用你带？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120213
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
