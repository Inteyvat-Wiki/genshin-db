					}
				]
			},
			"dialogs": [
				{
					"id": 733540101,
					"content": "灯光的色调和强度恰到好处，特效也相当华丽，综合表现的效果堪称完美。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540102
					],
					"speakerTitle": "毗伽尔"
				},
				{
					"id": 733540102,
					"content": "太棒了，萨费伊，多亏了你，我们才能将花之骑士传说中的英姿重现。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540103
					],
					"speakerTitle": "毗伽尔"
				},
				{
					"id": 733540103,
					"content": "哎呀呀，又不是我一个人的功劳，你跑前跑后，比我这个只管书面工作的文职累多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540104
					],
					"speakerTitle": "萨费伊"
				},
				{
					"id": 733540104,
					"content": "现在最重要的问题是花之骑士的人选…需要演员拥有非凡身手，气质又与传说中的法里斯相似，条件似乎有些苛刻？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540105,
						733540106
					],
					"speakerTitle": "萨费伊"
				},
				{
					"id": 733540105,
					"content": "你们在聊什么呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733540107
					]
				},
				{
					"id": 733540107,
					"content": "灯光？特效？你们在为演出的事发愁吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733540108,
					"content": "出现了！绝无仅有的大英雄，花之骑士扮演者的无上人选…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540109
					],
					"speakerTitle": "萨费伊"
				},
				{
					"id": 733540109,
					"content": "不，应该说您就是当之无愧的花之骑士本尊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540110
					],
					"speakerTitle": "萨费伊"
				},
				{
					"id": 733540110,
					"content": "#噫，这个学者好激动！一看到{NICKNAME}，都眼里放光了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540111,
						733540112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733540111,
					"content": "欸呀，没那么夸张啦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733540113
					]
				},
				{
					"id": 733540113,
					"content": "#咳咳，很荣幸再次遇见您，{NICKNAME}{M#先生}{F#女士}，这位是伐护末那学院的民俗学者萨费伊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540114
					],
					"speakerTitle": "毗伽尔"
				},
				{
					"id": 733540114,
					"content": "最近他趁着「花神诞祭」的热潮，根据各种历史文献和民间传说，结合枫丹的新技术，设计了一部映影。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540115
					],
					"speakerTitle": "毗伽尔"
				},
				{
					"id": 733540115,
					"content": "这部映影的重点是「花之骑士不为人知的战斗」，着重描绘了那位骑士为草神大人深入神秘幽邃的险境，斩除邪恶势力的故事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540116
					],
					"speakerTitle": "萨费伊"
				},
				{
					"id": 733540116,
					"content": "等等，我好像能猜到了…你们是不是没有擅长战斗的演员，拍不了战斗的桥段？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733540117,
					"content": "#严格说来，无论文戏还是打戏，都没有比{NICKNAME}{M#先生}{F#女士}更合适的演员。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540118
					],
					"speakerTitle": "萨费伊"
				},
				{
					"id": 733540118,
					"content": "#要是{NICKNAME}愿意参演，这部映影有可能成为须弥历史上最出色的花之骑士艺术作品，上映后的收入相当乐观…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540119
					],
					"speakerTitle": "萨费伊"
				},
				{
					"id": 733540119,
					"content": "当然，绝不会在分成上亏待两位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540120
					],
					"speakerTitle": "毗伽尔"
				},
				{
					"id": 733540120,
					"content": "#嘿嘿，{NICKNAME}的形象，确实就该这么有人气！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733540121,
					"content": "我们算是在「花神诞祭」度假，这段时间倒不怎么忙啦，拍几段戏的空闲应该是有的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733540122,
					"content": "#{NICKNAME}，你觉得呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540123,
						733540126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733540123,
					"content": "演戏我不在行，战斗我很专业。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733540124
					]
				},
				{
					"id": 733540124,
					"content": "您愿意参演真是太好了，我们就只拍战斗戏！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540125
					],
					"speakerTitle": "萨费伊"
				},
				{
					"id": 733540125,
					"content": "同时，我们会以您的仪容为准，重新设计剧中花之骑士的形象，调整文戏演员的化妆和服装。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540129
					],
					"speakerTitle": "萨费伊"
				},
				{
					"id": 733540129,
					"content": "#事不宜迟，要是{NICKNAME}{M#先生}{F#女士}准备好了，我们就直接开始吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540130
					],
					"speakerTitle": "毗伽尔"
				},
				{
					"id": 733540130,
					"content": "#好，为了{NICKNAME}的大明星形象，还有花之骑士的热血传说，开演！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733540126,
					"content": "打戏简简单单，文戏可以试试。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733540127
					]
				},
				{
					"id": 733540127,
					"content": "您愿意参演真是太好了，我们感激不尽！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540128
					],
					"speakerTitle": "萨费伊"
				},
				{
					"id": 733540128,
					"content": "不过，文戏的拍摄和打戏是分开的，前者要另定时间，到时候可能还要麻烦您了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540129
					],
					"speakerTitle": "萨费伊"
				},
				{
					"id": 733540112,
					"content": "说得好，再夸夸？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733540113
					]
				},
				{
					"id": 733540106,
					"content": "好像遇上了难题？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733540107
					]
				}
			]
		}
	]
}