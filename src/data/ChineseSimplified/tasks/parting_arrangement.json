						],
						"stepId": 7350801,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"贝尔福",
					"海妮耶"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735080101,
					"content": "#这些天来多谢你们了，「黄金流星」{NICKNAME}和「白银伴星」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080102
					],
					"speakerTitle": "贝尔福"
				},
				{
					"id": 735080102,
					"content": "我记录下了你们每次游玩「灵蕈棋阵」的过程，根据你们的游玩记录，可以得出许多数据。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080103
					],
					"speakerTitle": "贝尔福"
				},
				{
					"id": 735080103,
					"content": "你们属于「顶尖水准」的试玩者，将你们的记录和普通试玩者的相结合，就能分析出稳妥的改进方案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080104
					],
					"speakerTitle": "贝尔福"
				},
				{
					"id": 735080104,
					"content": "当然，最后还要请你们发表关于总体风格的建议。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080105
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735080105,
					"content": "你们的反馈不止对「灵蕈棋阵」这个游戏有正面意义，还在一定程度上影响着下一届大赛的玩法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080106
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735080106,
					"content": "还请你们大概说说自己的倾向。比如…是更重视趣味性，还是竞技性呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080107,
						735080112,
						735080117
					],
					"speakerTitle": "贝尔福"
				},
				{
					"id": 735080107,
					"content": "我更看重与伙伴们的合作。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735080108
					]
				},
				{
					"id": 735080108,
					"content": "对哦！比赛和对抗确实很重要，不过，我们希望之后的挑战更能考验我们和蕈兽伙伴的默契！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735080109,
					"content": "和蕈兽伙伴们的默契吗…我明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080110
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735080110,
					"content": "贝尔福先生，记得我之前和你说过的，最重要的理念吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080111
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735080111,
					"content": "理解！下次大赛，我会争取设计一些考验你们配合的挑战，让你们和蕈兽伙伴在高效的沟通中发挥全力！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080121
					],
					"speakerTitle": "贝尔福"
				},
				{
					"id": 735080121,
					"content": "你们两位还真是一点都没变呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080122
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735080122,
					"content": "总之，这样一来，本次「灵蕈棋阵」的测试就大功告成了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080123,
						735080125
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735080123,
					"content": "有劳你们了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735080124
					]
				},
				{
					"id": 735080124,
					"content": "好耶！完成工作后，我们就能拿到一笔辛苦费，买些好吃的犒劳自己啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735080127,
					"content": "等等…不对不对！我们是下次大赛的主办方，而海妮耶和贝尔福在为下次大赛做准备…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735080128,
					"content": "海妮耶是我们的好帮手，理论上来说，贝尔福也算是我们的员工了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735080129,
					"content": "那是不是应该…唔…由我们给好帮手辛苦费，给员工发工资？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735080130,
					"content": "不不不！你们未免也太好心了！这都是我自愿开展的工作，我也有非常多的收获！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080131
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735080131,
					"content": "我毕竟也算是个商业人士，这次开发并运营「灵蕈棋阵」的经验和履历，对于我们这类人弥足珍贵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080132
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735080132,
					"content": "要是这份工作对外开放，不知道会有多少人拿着一大笔钱来求你们授权呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080133
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735080133,
					"content": "而且，「灵蕈棋阵」盈利后，贝尔福先生投入的钱也有着落了，他还会将大部分收入交给我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080134
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735080134,
					"content": "我会将一部分收入储存起来，作为下次大赛的预备资金，一部分用来好好照顾蕈兽伙伴们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080135
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735080135,
					"content": "不止是「咚咚小圆帽」它们，还有诸如「信风舞姬」那样的，选手们托我照顾的伙伴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080136
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735080136,
					"content": "也就是说，你们帮助我们改进了「灵蕈棋阵」，可以带来大量的收益，还为蕈兽伙伴们提供了保障。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080137
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735080137,
					"content": "原来是这样吗…虽然听不太懂什么盈利，收入之类的，但感觉好像，所有人都有很大的收获？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080138
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735080138,
					"content": "那我也更有成就感了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735080139,
					"content": "#{NICKNAME}，有机会的话，我们也和须弥的朋友们说说「灵蕈棋阵」的事，让更多人知道这个游戏吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080140
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735080140,
					"content": "当然当然！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735080141
					]
				},
				{
					"id": 735080141,
					"content": "接下来，我就要和蕈兽伙伴们先行一步，去城外会合助手，回营地去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080142
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735080142,
					"content": "如果离开营地太久，留守的蕈兽伙伴们会担心的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080143
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735080143,
					"content": "贝尔福先生还会在这里继续宣传测试版的「灵蕈棋阵」，如果你们还没尽兴，可以继续玩玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080144
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735080144,
					"content": "对，玩个痛快吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080145
					],
					"speakerTitle": "贝尔福"
				},
				{
					"id": 735080145,
					"content": "呜，海妮耶要走了吗？要带着「咚咚小圆帽」它们离开了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080146
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735080146,
					"content": "我还想和「咚咚小圆帽」再玩一会儿呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080147
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735080147,
					"content": "不过…这次见到海妮耶后，我越来越安心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080148
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735080148,
					"content": "特别是确认了蕈兽伙伴们都健健康康，和我们的默契一点也没有减少！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080149
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735080149,
					"content": "放心，也许不过多久，我们就会再见面的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080150
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735080150,
					"content": "虽说你们经常四处旅行，但我也有办法和你们联络。比如通过冒险家协会把信件转达给你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080151
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735080151,
					"content": "我保证，之后与你们再见时，我和蕈兽伙伴们都健健康康，精力充沛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080152
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735080152,
					"content": "请静候佳音吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080153
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735080153,
					"content": "嗯！我们相信你，海妮耶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080154,
						735080155,
						735080156
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735080154,
					"content": "加油啊，海妮耶。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735080157
					]
				},
				{
					"id": 735080157,
					"content": "#那就下次再见了，「黄金流星」{NICKNAME}和「白银伴星」派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735080155,
					"content": "照顾好蕈兽伙伴们。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735080157
					]
				},
				{
					"id": 735080156,
					"content": "也别忘了照顾好自己。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735080157
					]
				},
				{
					"id": 735080125,
					"content": "记得报酬哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735080126
					]
				},
				{
					"id": 735080126,
					"content": "对对对，用工作挣到的摩拉买到的吃的，好像都更香一点！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735080112,
					"content": "我更倾向于战斗的华丽和爽快。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735080113
					]
				},
				{
					"id": 735080113,
					"content": "嗯！这次和蕈兽伙伴们见面后，我更加确定了，我们和蕈兽伙伴们之间的默契，只会变强，不会被时间冲淡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735080114,
					"content": "下次再和蕈兽伙伴们一起参赛时，我们的配合不知道会有多厉害，肯定要用华丽的战斗体现出来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735080115,
					"content": "原来如此，你们觉得适当的挑战，可以展现出蕈兽伙伴的全部实力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080116
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735080116,
					"content": "那下次比赛，就要适当增加一些挑战性的内容了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080121
					],
					"speakerTitle": "贝尔福"
				},
				{
					"id": 735080117,
					"content": "我没什么所谓，开心就好！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735080118
					]
				},
				{
					"id": 735080118,
					"content": "嗯！不管怎么样，只要能和蕈兽伙伴们一起玩，一起通过考验，战胜困难，我们就很开心啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735080119,
					"content": "明白了，乐趣和挑战并存，这句话说着简单，不过做起来很难…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080120
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735080120,
					"content": "都交给我了，我会尽全力拿出让你们满意的方案的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080121
					],
					"speakerTitle": "贝尔福"
				}
			]
		}
	]
}