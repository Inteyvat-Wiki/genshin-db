					"库约尼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750330201,
					"content": "来跟我的孩子飞一次吧，年轻人，能跟花羽会的飞行好手一起竞速的机会可不多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330202
					],
					"speakerTitle": "库约尼"
				},
				{
					"id": 750330202,
					"content": "去追追看赛道上的<color=#00E1FFFF>飞行火炬</color>，谁先追上谁就是赢家，这几个孩子还小的时候我就是这么训练他们的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330203
					],
					"speakerTitle": "库约尼"
				},
				{
					"id": 750330203,
					"content": "<color=#00E1FFFF>火炬被一个气球提着，点缀着红色的羽毛</color>，象征着勇士应当承担的责任与荣誉，是我做给他们的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330204
					],
					"speakerTitle": "库约尼"
				},
				{
					"id": 750330204,
					"content": "你看到就能认出来，怎么样，来试试？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330205,
						750330207
					],
					"speakerTitle": "库约尼"
				},
				{
					"id": 750330205,
					"content": "我准备好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330206
					]
				},
				{
					"id": 750330206,
					"content": "哈哈好，那就去起点预备吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "库约尼"
				},
				{
					"id": 750330207,
					"content": "我还要再准备一下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330208
					]
				},
				{
					"id": 750330208,
					"content": "那我们就等你准备好再说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "库约尼"
				}
			]
		},
