			"dialogs": [
				{
					"id": 750330101,
					"content": "为什么我非得坚持不可，我就不能放弃吗…我不干了！姐姐，你帮帮我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330102
					],
					"speakerTitle": "阿科米蒂"
				},
				{
					"id": 750330102,
					"content": "丢人！白长了这么大个子，碰到一点困难就想逃跑还算是勇士吗？你这家伙居然是我的同胞哥哥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330103
					],
					"speakerTitle": "马塔伽"
				},
				{
					"id": 750330103,
					"content": "你就没有想不出办法，要找人帮忙的时候吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330104
					],
					"speakerTitle": "阿科米蒂"
				},
				{
					"id": 750330104,
					"content": "有。我是回来找爸爸和姐姐，让他们检验我特训成果的。我不会像你那么没骨气！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330105
					],
					"speakerTitle": "马塔伽"
				},
				{
					"id": 750330105,
					"content": "阿科米蒂，我觉得队长拒绝你的退队申请是希望你想想清楚，不要在情绪剧烈波动的时候做决定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330106
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750330106,
					"content": "平静下来之后靠你自己做出决定吧，将来别后悔就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330107
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750330107,
					"content": "我已经退役了，自己都不知道自己该干什么，恐怕没资格指导你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330108
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750330108,
					"content": "没想到你们三个人是一家子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330109,
						750330110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750330109,
					"content": "好意外。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330111
					]
				},
				{
					"id": 750330111,
					"content": "是你们？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330112
					],
					"speakerTitle": "库约尼"
				},
				{
					"id": 750330112,
					"content": "坏消息，恩人，逃跑计划失败了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330113,
						750330114
					],
					"speakerTitle": "阿科米蒂"
				},
				{
					"id": 750330113,
					"content": "意料之中。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330115
					]
				},
				{
					"id": 750330115,
					"content": "就没有办法让我摆脱这种痛苦吗？当勇士怎么这么累，所有的一切凭什么不能简单点？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330116
					],
					"speakerTitle": "阿科米蒂"
				},
				{
					"id": 750330116,
					"content": "还在想飞行队的事啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330117
					],
					"speakerTitle": "库约尼"
				},
				{
					"id": 750330117,
					"content": "抱歉，阿科米蒂，按我的经验来看，应该简单不了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330118
					],
					"speakerTitle": "库约尼"
				},
				{
					"id": 750330118,
					"content": "我刚修好马塔伽的护手，曼尤雅，你的护手要不要顺带修了…哦？我们有客人来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330119
					],
					"speakerTitle": "库约尼"
				},
				{
					"id": 750330119,
					"content": "#爸爸，这是我们在外面训练的时候遇到的冒险家，{M#他们}{F#她们}还帮了阿科米蒂的忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330120
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750330120,
					"content": "你们好，热心的朋友。叫我库约尼就行，我是个训练师，也是这几个孩子的父亲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330121
					],
					"speakerTitle": "库约尼",
					"speakerSubtitle": "「花羽会」训练大师"
				},
				{
					"id": 750330121,
					"content": "阿科米蒂的状态好像很糟糕，大叔，需要帮忙的话可以叫我们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750330122,
					"content": "谢谢你们，不过我不觉得阿科米蒂有什么问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330123
					],
					"speakerTitle": "库约尼"
				},
				{
					"id": 750330123,
					"content": "欸，大叔不打算管他了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750330124,
					"content": "哈哈，我的意思是…这样说吧，你们是冒险家的话，应该加入过冒险家协会吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330125
					],
					"speakerTitle": "库约尼"
				},
				{
					"id": 750330125,
					"content": "了不起啊，这样的组织，所谓冒险家是为了探索世界才行动的人对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330126
					],
					"speakerTitle": "库约尼"
				},
				{
					"id": 750330126,
					"content": "要问具体动机的话，每个冒险家都不同。有的是为了金钱，有的是出于求知欲，有的单纯是闲着无聊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330127
					],
					"speakerTitle": "库约尼"
				},
				{
					"id": 750330127,
					"content": "把这样的人统合起来，让他们承认同一个口号，是很厉害的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330128
					],
					"speakerTitle": "库约尼"
				},
				{
					"id": 750330128,
					"content": "像我，一个从飞行队驭龙师的位置上退役了的大叔，后来去做了部族里的训练师，就没法想象六个部族的训练师联合起来建立一个协会是什么样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330129
					],
					"speakerTitle": "库约尼"
				},
				{
					"id": 750330129,
					"content": "唔…这和阿科米蒂的事情有关系吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750330130,
					"content": "爸爸说话就是这样。以前他还在飞行队的时候，包括绒翼龙在内，所有的飞行队成员都愿意听他的意见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330131
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750330131,
					"content": "现在爸爸是部族的训练师，所有想要成为勇士的人都会来问他的意见，不用急，听听他的话吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330132
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750330132,
					"content": "那都是过去的事了，曼尤雅，不过我还是说完吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330133
					],
					"speakerTitle": "库约尼"
				},
				{
					"id": 750330133,
					"content": "我们所有的训练师都是因为向往「勇士」这个形象，才会花那么多精力去布置、设计训练项目。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330134
					],
					"speakerTitle": "库约尼"
				},
				{
					"id": 750330134,
					"content": "大家都想要看见自己梦想中那个最了不起的勇士出现，但那个勇士到底该是什么样子，谁也不能规定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330135
					],
					"speakerTitle": "库约尼"
				},
				{
					"id": 750330135,
					"content": "所以我们这些训练师根本没办法搞出个协会，什么原则、章程，根本写不出来嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330136
					],
					"speakerTitle": "库约尼"
				},
				{
					"id": 750330136,
					"content": "那个最了不起的勇士拥有一千万张脸，一千万种性格。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330137
					],
					"speakerTitle": "库约尼"
				},
				{
					"id": 750330137,
					"content": "那个谁都想成为的勇士一会儿意志坚定，一会儿自我怀疑，还会衰老，会死亡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330138
					],
					"speakerTitle": "库约尼"
				},
				{
					"id": 750330138,
					"content": "勇士不会倦怠吗？我可以举出记载在织物上的很多例子，证明自我怀疑和倦怠会平等地困扰每一个人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330139
					],
					"speakerTitle": "库约尼"
				},
				{
					"id": 750330139,
					"content": "勇士非得生得高大吗？我知道很多长得有巨人那么高，但是卑劣得让人呕吐的人，他们的事也被记载在织物上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330140
					],
					"speakerTitle": "库约尼"
				},
				{
					"id": 750330140,
					"content": "勇士当然也会衰弱，这是自然的规律。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330141
					],
					"speakerTitle": "库约尼"
				},
				{
					"id": 750330141,
					"content": "我的孩子们称呼我为勇士，但看看我吧，我现在已经不飞了，老鸟是没有力气再飞的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330142
					],
					"speakerTitle": "库约尼"
				},
				{
					"id": 750330142,
					"content": "一个长着一张完美的脸的勇士，一切都合乎一个无聊标准的人，不会是我们纳塔承认的英雄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330143
					],
					"speakerTitle": "库约尼"
				},
				{
					"id": 750330143,
					"content": "我的曼尤雅、阿科米蒂、马塔伽，我带你们到飞屋上来，因为你们要做花羽会的英雄，从很高的地方往下看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330144
					],
					"speakerTitle": "库约尼"
				},
				{
					"id": 750330144,
					"content": "你们的烦恼与渴望都是英雄漫长征途上一瞬的状态，不是什么该被解决的问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330145
					],
					"speakerTitle": "库约尼"
				},
				{
					"id": 750330145,
					"content": "离开飞行队就不是勇士了吗？进入飞行队就一定是勇士了吗？没有这种话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330146
					],
					"speakerTitle": "库约尼"
				},
				{
					"id": 750330146,
					"content": "有雄心壮志也行，犹豫不决也没什么，失落也正常，你是个勇士，勇士必须有所经历才成为英雄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330147
					],
					"speakerTitle": "库约尼"
				},
				{
					"id": 750330147,
					"content": "和自己的状态共存，靠自己习惯它，战胜它，不要反过来被它支配。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330148
					],
					"speakerTitle": "库约尼"
				},
				{
					"id": 750330148,
					"content": "这是纳塔的做法，英雄的做法，明白吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330149
					],
					"speakerTitle": "库约尼"
				},
				{
					"id": 750330149,
					"content": "我知道你的意思了，爸爸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330150
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750330150,
					"content": "阿科米蒂，你还是犹豫吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330151
					],
					"speakerTitle": "库约尼"
				},
				{
					"id": 750330151,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330152
					],
					"speakerTitle": "阿科米蒂"
				},
				{
					"id": 750330152,
					"content": "一个劲地讲大道理不是我们家的作风，去跟你的姐姐还有弟弟飞一次吧，就像你小时候那样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330153
					],
					"speakerTitle": "库约尼"
				},
				{
					"id": 750330153,
					"content": "让你的身心一起做决定，窝在屋子里闷闷地动死脑筋想不出好主意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330154
					],
					"speakerTitle": "库约尼"
				},
				{
					"id": 750330154,
					"content": "我知道了，爸爸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330155
					],
					"speakerTitle": "阿科米蒂"
				},
				{
					"id": 750330155,
					"content": "#训练大师说话这么抽象的吗？我感觉自己没有听懂，{NICKNAME}你听懂了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330156,
						750330157
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750330156,
					"content": "听懂了，总之是飞行挑战。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330158
					]
				},
				{
					"id": 750330158,
					"content": "冒险家，我听孩子们说了你的事，你是个有意思的年轻人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330159
					],
					"speakerTitle": "库约尼"
				},
				{
					"id": 750330159,
					"content": "有胆量和曼尤雅比赛，帮阿科米蒂这小子的忙，马塔伽也认同你，是个勇士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330160
					],
					"speakerTitle": "库约尼"
				},
				{
					"id": 750330160,
					"content": "我想邀请你跟这几个孩子一起飞一次。你觉得怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330161,
						750330162
					],
					"speakerTitle": "库约尼"
				},
				{
					"id": 750330161,
					"content": "来吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330163
					]
				},
				{
					"id": 750330163,
					"content": "哈哈，好。你要是想好了就过来和我们说一声。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330164
					],
					"speakerTitle": "库约尼"
				},
				{
					"id": 750330164,
					"content": "我这三个孩子都是花羽会顶尖的飞行好手，你们一起飞应该会很痛快的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "库约尼"
				},
				{
					"id": 750330162,
					"content": "让我考虑一下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330163
					]
				},
				{
					"id": 750330157,
					"content": "没听懂，家庭教育太深奥了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330158
					]
				},
				{
					"id": 750330114,
					"content": "（耸耸肩）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330115
					]
				},
				{
					"id": 750330110,
					"content": "倒是不难猜到。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330111
					]
				}
			]
		},
		{
			"id": 7503302,
