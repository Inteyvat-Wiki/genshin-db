			"dialogs": [
				{
					"id": 750330401,
					"content": "飞得不错，年轻人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330402
					],
					"speakerTitle": "库约尼"
				},
				{
					"id": 750330402,
					"content": "恩人，刚才你觉得我飞得怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330403,
						750330404
					],
					"speakerTitle": "阿科米蒂"
				},
				{
					"id": 750330403,
					"content": "很好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330405
					]
				},
				{
					"id": 750330405,
					"content": "谢谢你愿意给我这些肯定，我看得出来和你相比，我飞得并不好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330406
					],
					"speakerTitle": "阿科米蒂"
				},
				{
					"id": 750330406,
					"content": "阿科米蒂…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330407
					],
					"speakerTitle": "马塔伽"
				},
				{
					"id": 750330407,
					"content": "不是你们想的那样，我不是因为比不过别人又沮丧了。我是能飞的，我自己知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330408
					],
					"speakerTitle": "阿科米蒂"
				},
				{
					"id": 750330408,
					"content": "只是长期处在糟糕的状态里，破坏了我对自己的信任，就算能飞好也没办法从容面对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330409
					],
					"speakerTitle": "阿科米蒂"
				},
				{
					"id": 750330409,
					"content": "#{NICKNAME}不会这样，{M#他}{F#她}的飞姿就自在得多，大家都能看出来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330410
					],
					"speakerTitle": "阿科米蒂"
				},
				{
					"id": 750330410,
					"content": "爸爸，我知道你和姐姐希望我自己做决定，不要逃避。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330411
					],
					"speakerTitle": "阿科米蒂"
				},
				{
					"id": 750330411,
					"content": "如果我现在告诉你们，不管是我的身体，大脑还是心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330412
					],
					"speakerTitle": "阿科米蒂"
				},
				{
					"id": 750330412,
					"content": "都不愿意在不适合自己的道路上继续走下去，你们还会支持我吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330413
					],
					"speakerTitle": "阿科米蒂"
				},
				{
					"id": 750330413,
					"content": "没关系，只要是你自己做出的决定，只要你愿意承担后果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330414
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750330414,
					"content": "马塔伽，你会…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330415
					],
					"speakerTitle": "阿科米蒂"
				},
				{
					"id": 750330415,
					"content": "停！别以为我会在这时候跳出来指责你，我哥哥是什么性格我一直知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330416
					],
					"speakerTitle": "马塔伽"
				},
				{
					"id": 750330416,
					"content": "受不了就果断放弃，只要坦荡你就算勇士，谁也没资格批评你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330417
					],
					"speakerTitle": "马塔伽"
				},
				{
					"id": 750330417,
					"content": "有的时候，训练大师的工作还是挺轻松的，我为勇士们制定训练计划，自己却不用上场。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330418
					],
					"speakerTitle": "库约尼"
				},
				{
					"id": 750330418,
					"content": "不过，你们的父亲我曾经也过着成天和龙一起飞来飞去的日子，知道这种生活的真正滋味。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330419
					],
					"speakerTitle": "库约尼"
				},
				{
					"id": 750330419,
					"content": "批评别人很容易，放手去做永远比简单动动嘴皮子难。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330420
					],
					"speakerTitle": "库约尼"
				},
				{
					"id": 750330420,
					"content": "作为一个训练师，我建议你申请休假调整身心状态，哪怕这会引起队里的不满，你也该这么做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330421
					],
					"speakerTitle": "库约尼"
				},
				{
					"id": 750330421,
					"content": "作为一个父亲，知道你不愿意再继续，我尊重你的选择。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330422
					],
					"speakerTitle": "库约尼"
				},
				{
					"id": 750330422,
					"content": "就算不在飞行队待着了，也没什么大不了，花羽会的勇士也不是只有通过飞行才能证明自己的价值。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330423
					],
					"speakerTitle": "库约尼"
				},
				{
					"id": 750330423,
					"content": "谢谢你们…我还担心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330424
					],
					"speakerTitle": "阿科米蒂"
				},
				{
					"id": 750330424,
					"content": "别想太多，我们是你的家人，有什么事我们都会帮你一起想办法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330425
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750330425,
					"content": "做勇士也不容易啊，没想到进入花羽会的飞行队这么辛苦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330426,
						750330428
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750330426,
					"content": "我们有我们的辛苦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330427
					]
				},
				{
					"id": 750330427,
					"content": "也是哦，想想我们这一路上遇到的各种事情，都挺过来了我还觉得怪骄傲的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330430
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750330430,
					"content": "成为勇士本来就不简单，要从勇士成长为英雄更难。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330431
					],
					"speakerTitle": "库约尼"
				},
				{
					"id": 750330431,
					"content": "见的勇士多了，什么样的人拥有成为英雄的气度，我还是能看得出来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330432
					],
					"speakerTitle": "库约尼"
				},
				{
					"id": 750330432,
					"content": "年轻人，你已经经历了很多磨炼吧，你的眼睛这样告诉我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330433,
						750330434
					],
					"speakerTitle": "库约尼"
				},
				{
					"id": 750330433,
					"content": "你难以想象。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330435
					]
				},
				{
					"id": 750330435,
					"content": "看来我没有看走眼。你的路和我们不同，或许你还要走很远，而我很乐意为未来的英雄提供助力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330436
					],
					"speakerTitle": "库约尼"
				},
				{
					"id": 750330436,
					"content": "更何况你和我们一家相识一场，这样吧，我也没有什么其他能做的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330437
					],
					"speakerTitle": "库约尼"
				},
				{
					"id": 750330437,
