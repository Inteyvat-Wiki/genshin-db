					"content": "你是枫原？快上船，我送你走！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670402
					],
					"speakerTitle": "聆听"
				},
				{
					"id": 400670402,
					"content": "您…为什么要帮我？我可是通缉犯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670403
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400670403,
					"content": "当然是社奉…啊咳咳！是有人付了钱，说要把你安全送出稻妻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670404
					],
					"speakerTitle": "聆听"
				},
				{
					"id": 400670404,
					"content": "不过，别人能帮的实在有限，后面的路还得靠你自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "聆听"
				}
			]
		},
		{
			"id": 4006705,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4006712",
