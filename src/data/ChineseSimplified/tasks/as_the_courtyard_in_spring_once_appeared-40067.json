			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"枫原万叶",
					"莫娜",
					"菲谢尔",
					"奥兹"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400671201,
					"content": "万叶，找到你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400671202,
					"content": "来得不快也不慢，刚刚好，容我想完了迄今为止的人生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671203
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400671203,
					"content": "枫原家的盆景，你感觉如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671204,
						400671207
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400671204,
					"content": "古老，又有沉淀。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671205
					]
				},
				{
					"id": 400671205,
					"content": "古老的东西，往往都伴随着遗憾。枫原亦是如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671206
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400671206,
					"content": "但无妨，散也是聚。不在此处，便是在他乡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671209
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400671209,
					"content": "这片秘境很有趣，像戏剧一样，每一出都比上一出更特别，更震撼人心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671210
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400671210,
					"content": "占星术士都是见多识广的人。能让你这样说，这片幻境也不枉存在了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671211
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400671211,
					"content": "喂，汝…心情如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671212
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400671212,
					"content": "小姐的意思是问候万叶卿，希望你心情别太低落。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671213
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 400671213,
					"content": "回忆这样的经历，不可能高兴的吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400671214,
					"content": "哈哈，说得也是。感谢各位的关心。幸好，这些事对我而言都是过去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671215
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400671215,
					"content": "第一眼看见盆景，我就想到了这种可能性…我在等你们，或许这正是我被独自留在终点的理由。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400671207,
					"content": "并不完满，但你也无愧于它。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671208
					]
				},
				{
					"id": 400671208,
					"content": "是啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671209
					],
					"speakerTitle": "枫原万叶"
				}
			]
		},
		{
			"id": 4006713,
			"completionStepIds": [
				4006713
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4006713",
							"2"
						],
						"stepId": 4006713,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"辛焱",
					"菲谢尔",
					"莫娜",
					"奥兹",
					"枫原万叶"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400671301,
					"content": "呼啊，走了不少路，都有点困了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400671302,
					"content": "大家都辛苦了，今天要不早点休息吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671303
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400671303,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671304
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400671304,
					"content": "嗯？怎么了，你脸色不太好看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671305
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400671305,
					"content": "没什么。本皇女感到疲惫，或许是今日舟车劳顿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671306
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400671306,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671307
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 400671307,
					"content": "小姐，您还好吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671308
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 400671308,
					"content": "奥兹，不要多事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671309
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400671309,
					"content": "是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671310
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 400671310,
					"content": "……？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671311
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400671311,
					"content": "我去找找有没有可以吃的东西，你们要是累了就先坐一会儿，还有精力的可以来帮我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671312
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400671312,
					"content": "我来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671313
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400671313,
					"content": "我也可以帮忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671314
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400671314,
					"content": "别人都那么积极，我们也去吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400671315,
					"content": "那我和派蒙也来帮你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671316
					]
				},
				{
					"id": 400671316,
					"content": "不至于不至于，而且…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671317
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400671317,
					"content": "我看皇女殿下有些忧郁，莫娜，你跟她比较熟，不如陪她出去散散心吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671318
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400671318,
					"content": "原来你也发现了。我刚想着趁准备食物的时候跟你们提一下这事呢。既然如此，那边就交给我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671319
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400671319,
					"content": "好嘞，那我们几个来准备食物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671320
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400671320,
					"content": "莫娜对我们眨眨眼，跑去陪伴菲谢尔了。剩下的人一起找了些能烹饪成佳肴的食材…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400671321
					]
				},
				{
					"id": 400671321,
					"content": "嗯，这些就够了，一会儿烤着吃吧。下回要是走过那些没人的营地，可以找找有没有炖锅，这样还能做菜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671322
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400671322,
					"content": "真周到呀！明明不是厨师，却这么会照顾人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400671323,
					"content": "嘿嘿，做些力所能及的小事而已，不值得你这么夸啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671324
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400671324,
					"content": "辛焱是连「死兆星号」的兄弟们都认可的好伙伴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671325
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400671325,
					"content": "嗯！我们眼里万叶也是这么可靠的人哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671326
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400671326,
					"content": "哈哈哈，说得好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671327
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400671327,
					"content": "嗯…既然如此，我作为可靠的伙伴，刚巧有些话想说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671328
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400671328,
					"content": "听你们说的，那片不可思议的幻境，根本是依照「枫原万叶」迄今为止的人生创建而成。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671329
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400671329,
					"content": "…简直像是我的一场梦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671330
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400671330,
					"content": "或许就是代表着「梦」呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671331
					]
				},
				{
					"id": 400671331,
					"content": "万叶，你是不是…一直也想要完成属于你的「盆景」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671332
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400671332,
					"content": "是吗…到头来，居然是实现了我的愿望吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671333
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400671333,
					"content": "既然我会遇到这种情况，那是不是意味着，我们大家都有这种可能？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671334
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400671334,
					"content": "嗯，我也这么想。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671335
					]
				},
				{
					"id": 400671335,
					"content": "我也同意。只是，不知道下一个类似的场所会是跟谁有关的幻境。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671336
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400671336,
					"content": "哈，这么一说，要是我也能有这样的美梦该多好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671337
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400671337,
					"content": "你居然很想要这样的东西吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671338
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400671338,
					"content": "如果我能拥有这样的领域，应该会是跟音乐有关的东西吧。嗯哼哼，到时候就能一展身手啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671339
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400671339,
					"content": "不会是要突然演奏吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671340
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400671340,
					"content": "很正常吧？任何搞音乐的人来到这片群岛，面对如此美景，不想来点音乐才奇怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671341
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400671341,
					"content": "好强健的心智，好乐观的精神，我有点佩服了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671342
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400671342,
					"content": "#啊对了！{NICKNAME}，我想吃山崖边的水果，陪我去摘好吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671343
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400671343,
					"content": "（嗯？莫非…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671344
					]
				},
				{
					"id": 400671344,
					"content": "二位先忙，我陪派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 4006714,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4006714",
							"2"
						],
						"stepId": 4006714,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"嘟嘟通讯仪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400671401,
					"content": "今天这些奇怪的房子，幻境一样的…呃…盆景？总之就是那堆怪事啦！我觉得，是不是应该告诉温迪？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671402,
						400671403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400671402,
					"content": "我猜就是这件事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671404
					]
				},
				{
					"id": 400671404,
					"content": "嘟嘟可——嘟嘟可——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671405
					],
					"speakerTitle": "嘟嘟通讯仪"
				},
				{
					"id": 400671405,
					"content": "嘟嘟可——嘟嘟可——嘟嘟可——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671406
					],
					"speakerTitle": "嘟嘟通讯仪"
				},
				{
					"id": 400671406,
					"content": "没有回应…奇怪，他怎么不理我们？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400671407,
					"content": "不应该这样…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671408
					]
				},
				{
					"id": 400671408,
					"content": "难道说，温迪又走神了？还是演出期间没把炸弹带在身边？又或者是喝醉了，正在大树底下打盹…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400671409,
					"content": "唔…好奇怪，要不然…要不然明天再联系他吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400671410,
					"content": "旅行者，派蒙，你们在这儿啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671411
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400671411,
					"content": "是莫娜！你跟菲谢尔聊完了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400671412,
					"content": "啊哈哈，算是吧…她有点忧郁，我猜…可能是跟今天遇到的幻境有关。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671413
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400671413,
					"content": "菲谢尔对这次旅行非常积极，但我有种感觉，她似乎并不想见到属于自己的幻境…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671414
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400671414,
					"content": "为什么？她不是应该最向往这些事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400671415,
					"content": "…还不能下结论，不过我会多留意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671416
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400671416,
					"content": "我是想跟你们说另一件事。刚才我在海边又做了一次占卜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671417
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400671417,
					"content": "水占盘依然浑浊，但不同的是，隐约能从中感觉到某股力量。我无法看清它的位置，但能感受到，它在变化。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671418
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400671418,
					"content": "看不见要怎么感受啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671419
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400671419,
					"content": "该怎么给外行解释呢…啊！你就理解成，屋里有条裂缝，我们不知道它在哪里，但有风漏了进来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671420
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400671420,
					"content": "不仅如此，屋里的温度也一直在下降。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671421
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400671421,
					"content": "哦！这么说的话，我好像明白了。你是想找出那条裂缝在哪里对吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671422
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400671422,
					"content": "可以这么说。我需要先看到那条墙缝，才能决定接下来怎么做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400671403,
					"content": "那我们来联系他。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671404
					]
				}
			]
		}
	]
}