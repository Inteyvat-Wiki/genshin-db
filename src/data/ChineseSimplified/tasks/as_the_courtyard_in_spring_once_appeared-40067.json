			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"嘟嘟通讯仪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400670101,
					"content": "…似乎每次跟你见面都是这种情况呢。占卜、解读、锁定目标，再解决问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670102
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400670102,
					"content": "你身边围绕着各种各样的朋友、秘密和命运，真不可思议。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670103
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400670103,
					"content": "对哦，莱纳德事件也是跟莫娜和菲谢尔一起解决的呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400670104,
					"content": "对占星术士来说是好事吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400670105
					]
				},
				{
					"id": 400670105,
					"content": "勉强算是啦。但愿这一回我们也能强强联手，尽快解决问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670106
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400670106,
					"content": "强强联手，是说你们俩，还是说我们三个？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400670107,
					"content": "噗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670108
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400670108,
					"content": "好啦好啦，不会排挤你的。有时候派蒙的眼光独到又锐利，对我帮助很大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670109
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400670109,
					"content": "真的？我有点开始欣赏你了，天才莫娜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400670110,
					"content": "对吧对吧？像我这样聪明又迷人的占星术士，世界上再也找不出第二个了，哦呵呵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670111
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400670111,
					"content": "你什么都好，就是能不能…不要学菲谢尔笑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400670112,
					"content": "咳！不好意思…跟朋友相处久了，难免受影响…哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670113
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400670113,
					"content": "#之后的日子里，我会继续观测星象。保持联系，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莫娜"
				}
			]
		},
