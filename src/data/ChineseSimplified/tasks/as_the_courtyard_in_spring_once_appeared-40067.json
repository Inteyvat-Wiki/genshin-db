			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"枫原万叶"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400670501,
					"content": "那只瓷盆里，应该有棵枯死的植物才对。但在这里，枯木没有出现。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670502
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400670502,
					"content": "…你们不在的时候，我想了许多，总算是明白过来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670503
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400670503,
					"content": "这里是我的幻境，盆景中空无一物，意味着它即是我的心境。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670504
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400670504,
					"content": "心中「净」澈，万物天地皆为「净」；心至「空」处，天地万物皆为「空」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670505
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400670505,
					"content": "净与空，便是我如今的心境了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670506
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400670506,
					"content": "不过，那也未必不是遗憾。心中缺损，亦作「空」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670507
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400670507,
					"content": "所以这盆景才出现在我的幻想之中，给我机会完成心愿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670508
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400670508,
					"content": "真没想到，在我内心深处，竟然也想制作属于自己的盆景…如此，才算是真正继承了枫原的传统吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "枫原万叶"
				}
			]
		},
		{
			"id": 4006706,
			"completionStepIds": [
				4006712
			],
			"beginWay": "TALK_BEGIN_MANUAL",
