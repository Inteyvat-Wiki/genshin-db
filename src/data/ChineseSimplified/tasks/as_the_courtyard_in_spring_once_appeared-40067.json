			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"聆听"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400671001,
					"content": "喂老弟！你没事吧！要不要上来避避难？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671002
					],
					"speakerTitle": "聆听"
				},
				{
					"id": 400671002,
					"content": "海盗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671003
					],
					"speakerTitle": "聆听"
				},
				{
					"id": 400671003,
					"content": "哈，没错，就是海盗！你就说，要不要来？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "聆听"
				}
			]
		},
		{
			"id": 4006712,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
