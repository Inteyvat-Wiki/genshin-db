				"points": []
			},
			"dialogs": [
				{
					"id": 400670201,
					"content": "…没想到，会在景色如此美妙的地方处理这种不可思议的事件。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670202
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400670202,
					"content": "感觉如何？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400670203
					]
				},
				{
					"id": 400670203,
					"content": "还行。如果你能帮上我的忙就更好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670204
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400670204,
					"content": "那具体需要我们做些什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400670205,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670206
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400670206,
					"content": "唔…唔…好像也没什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670207
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400670207,
					"content": "你、你小看我们？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400670208,
					"content": "不，我是刚刚才意识到，虽然你话不多，却总是把事情办得很漂亮，悄悄地为大家做了很多事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670209
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400670209,
					"content": "你这样的人，应该是大家最需要的同伴。只要你在，好像就能放心许多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670210
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400670210,
					"content": "虽然擅自期待或许会给对方带去压力，但我认为…占星术士要有观察力，而发现他人的优点，也是一种观察。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670211
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400670211,
					"content": "所以你只是想夸我们？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400670212,
					"content": "只是陈述事实而已，没在夸你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670213
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400670213,
					"content": "原来如此，莫娜不肯承认…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400670214
					]
				},
				{
					"id": 400670214,
					"content": "不肯承认她在夸奖别人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400670215,
					"content": "你、你笑什么，都说了是客观评价，没在夸你！没——在——夸你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670216
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400670216,
					"content": "#之后的日子里，我会继续观测星象。保持联系，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莫娜"
				}
			]
		},
