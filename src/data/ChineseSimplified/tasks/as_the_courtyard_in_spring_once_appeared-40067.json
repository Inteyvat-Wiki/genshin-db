			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"枫原万叶"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400670601,
					"content": "那万叶想做的事，应该已经完成了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400670602,
					"content": "嗯，可以这么说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670603
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400670603,
					"content": "你们见证了过去的我，还与他告别。等你们亲眼看完属于我的一切，它们才真正成为历史。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670604
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400670604,
					"content": "人一生最重要的是与他人的牵绊，而非对自己的苛责。驻足过去的人，不会有未来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670605
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400670605,
					"content": "所以请你们相信，我走到了这里，也将继续走下去。将来，就请各位多关照了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "枫原万叶"
				}
			]
		},
		{
			"id": 4006710,
			"completionStepIds": [
				4006715
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
