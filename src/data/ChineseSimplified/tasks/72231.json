			"trigger": {
				"objectNames": [
					"大岛纯平"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722310101,
					"content": "代宫司大人居然这么高兴，看来那个对它来说，真的是很重要的人啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310102
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 722310102,
					"content": "但是，不知道她到底在哪…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7223102,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7223101",
							"2"
						],
						"stepId": 7223101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"悦子",
					"大祐"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722310201,
					"content": "确实，「阿响」…「浅濑神社」和「百目鬼」，都很让人在意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310202,
						722310207
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722310202,
					"content": "你们是什么时候冒出来的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722310203
					]
				},
				{
					"id": 722310203,
					"content": "岛上闹出那么大的动静，我们自然就过来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310204
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722310204,
					"content": "不过，有些事我觉得，必须要和你们说一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310205
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722310205,
					"content": "大祐，说明一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310206
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722310206,
					"content": "啊…好的，悦子小姐。是这样的，我要说的是一些…有关这座清籁岛的事情…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310208
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722310208,
					"content": "清籁岛的历史实在是太久远了，虽然协会已经特意搜罗过了资料，但还是几乎没找到什么有用的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310209
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722310209,
					"content": "根据协会给的资料，几百年前，这里似乎曾经是一处「海贼」的聚集点，当时，是由幕府出面扫清了所有海贼，并且把岛上的居民都迁移到了别处…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310210
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722310210,
					"content": "那个「百目鬼」，如果不出意外的话，也许正是当时和幕府正面冲突过的海贼头目「赤穗百目鬼」，卷宗里明确记录着他的名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310211
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722310211,
					"content": "据协会给我们的那些资料里记载，这位「赤穗百目鬼」指挥着海贼的船队，和幕府在海上作战。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310212
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722310212,
					"content": "虽然他的船队很快被幕府压制了下去，被迫向清籁岛逃窜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310213
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722310213,
					"content": "但是，幕府的船队在追击他的时候，清籁岛上突然爆发了一阵不知来由的雷暴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310214
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722310214,
					"content": "赤穗百目鬼的船队和幕府的船队一起被雷暴击中…就这样全部失去了踪迹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310215
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722310215,
					"content": "雷暴…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722310216
					]
				},
				{
					"id": 722310216,
					"content": "接下来的我来说吧…这件事里最大的疑点，就是那场突然出现的雷暴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310217
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722310217,
					"content": "虽然赤穗百目鬼的船队也被雷暴波及，几乎全灭…但幕府派来清籁岛的船队也几乎全军覆没，被迫退回鸣神岛，过了一段时间才重整好了船队。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310218
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722310218,
					"content": "那场雷暴实在来得太过恰到好处，简直就像是…有人特意操控的一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310219
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722310219,
					"content": "你还记得，这座岛上被特意解开封印的那些「镇石」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310220
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722310220,
					"content": "还有，我们封印了这些「镇石」之后，岛上的雷暴也平息了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310221
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722310221,
					"content": "我不想妄下推断，但是…我感觉这一切多多少少有些关联。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310222
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722310222,
					"content": "不然，我们去问问寝子大人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310223
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722310223,
					"content": "…算了吧。资料记载那位百目鬼失踪了。说是失踪，但被那种雷暴击中，也许已经…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310224
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722310224,
					"content": "我们会继续在这座岛上探索，也继续搜集关于这件事的线索，等过段时间，我们就会回去向协会报告。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310225
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722310225,
					"content": "呵呵，旅行者，说不定到时候我们还会继续合作呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310226
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722310226,
					"content": "到时候请多多关照。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722310227
					]
				},
				{
					"id": 722310227,
					"content": "彼此彼此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310228
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722310228,
					"content": "大祐，准备一下，我们继续制订探索计划。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310229
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722310229,
					"content": "呃…悦子小姐，那寝子大人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310230
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722310230,
					"content": "你之前怎么和那只猫相处，以后也怎么和那只猫相处。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310231
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722310231,
					"content": "但是记住，不要说任何不该说的话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310232
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722310232,
					"content": "它…现在应该很开心，不要说任何煞风景的话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310233
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722310233,
					"content": "我知道了！悦子小姐，嘿嘿，你果然还是很…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310234
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722310234,
					"content": "…只不过是为了更好地完成委托而已，快点去工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310235
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722310235,
					"content": "清籁岛…看来这座岛上，还有很多秘密…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "悦子"
				},
				{
					"id": 722310207,
					"content": "你们知道什么吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722310208
					]
				}
			]
		}
	]
}