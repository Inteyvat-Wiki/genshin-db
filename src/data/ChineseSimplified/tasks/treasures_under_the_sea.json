				]
			},
			"dialogs": [
				{
					"id": 746730101,
					"content": "小家伙，我真的不会潜水，你瞧，我连潜水服都没有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730102
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 746730102,
					"content": "哎哟…你就算是蹦来蹦去，我也没办法和你一起下去啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730103,
						746730104
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 746730103,
					"content": "乌尔曼！你也来枫丹了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746730105
					]
				},
				{
					"id": 746730105,
					"content": "#{NICKNAME}，还有派蒙，居然能在这遇见你们，真是巧了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730106
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 746730106,
					"content": "你还是和之前一样，好受仙灵欢迎啊。而且…和仙灵交流得越来越熟练了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746730107,
					"content": "帮我翻译一下仙灵在说什么。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746730108
					]
				},
				{
					"id": 746730108,
					"content": "唉，你们就别笑我了。我哪明白它想说什么啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730109
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 746730109,
					"content": "我就是来枫丹做生意，来水边闲逛，突然又被一个小仙灵缠上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730110
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 746730110,
					"content": "我早就习惯这种事了，所以就跟着它走，翻过山，越过岭，还划了一会船。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730111
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 746730111,
					"content": "一般来说，它马上就会蹦来蹦去，告诉我这里埋着什么东西了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730112
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 746730112,
					"content": "但是…它一头扎进了水里，越游越深…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730113
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 746730113,
					"content": "我可不会潜水啊！而且我听人家说，这水里不仅有洋流，还有各种危险的东西…我只能待在船上，等它回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730114
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 746730114,
					"content": "但是，那个小家伙还是锲而不舍地带我去各种地方…我真希望它能知道，我是真的不会潜水…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730115,
						746730117
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 746730115,
					"content": "感受到枫丹的特色了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746730116
					]
				},
				{
					"id": 746730116,
					"content": "完全感受到了。真是一个友好、热情、善良，让人流连忘返的国度啊。哈、哈、哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730119
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 746730119,
					"content": "那么这么说，你肯定又要拜托我们出马了，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746730120,
					"content": "没错！谢天谢地，你们没有被这帮枫丹人影响太深，说话还是这么干净利落。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730121
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 746730121,
					"content": "我真是受不了某些亲爱的枫丹人说话时的那股劲头了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730122
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 746730122,
					"content": "平均每二十个词里有两个敬称、三个比喻、六个形容词…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730123,
						746730124
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 746730123,
					"content": "我一向是个利落的人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746730125
					]
				},
				{
					"id": 746730125,
					"content": "见鬼…我觉得自己也被影响了…来！拿着这本笔记，我把那个小家伙带我去的地方都标注好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730126
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 746730126,
					"content": "还是和之前一样，找到古铁钱的话，就拿回来给我，我高价收购。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730127
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 746730127,
					"content": "#咱们合作愉快，{NICKNAME}，还有派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 746730124,
					"content": "我在修辞上的造诣确实不深。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746730125
					]
				},
				{
					"id": 746730117,
					"content": "我还以为你早就习惯遇见魔物了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746730118
					]
				},
				{
					"id": 746730118,
					"content": "我的确习惯了。但是在陆地上遇见魔物的话，我能转身就跑，但在水下遇见魔物，我根本游不动啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730119
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 746730104,
					"content": "你的「仙灵缘」还是很好啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746730105
					]
				}
			]
		}
	]
}