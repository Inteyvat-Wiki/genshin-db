			"dialogs": [
				{
					"id": 721250501,
					"content": "这些花种可以用吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250502
					]
				},
				{
					"id": 721250502,
					"content": "这是…可以！当然可以，有了这些种子，我肯定能种出很多花来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250503
					],
					"speakerTitle": "叶名山薰"
				},
				{
					"id": 721250503,
					"content": "那、那个，抱歉，请稍等…我得给您点报酬才行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250504
					],
					"speakerTitle": "叶名山薰"
				},
				{
					"id": 721250504,
					"content": "这些给您，谢谢您的花种。您过段时间来，肯定能看见很漂亮的花海！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "叶名山薰"
				}
