					"叶名山薰"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721250102,
					"content": "如果还能再种些花就好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250103
					],
					"speakerTitle": "叶名山薰"
				},
				{
					"id": 721250103,
					"content": "啊，您好！初次见面…请问，你也是回来居住的人吗？抱歉呀，之前我好像没见过你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250104,
						721250109
					],
					"speakerTitle": "叶名山薰"
				},
				{
					"id": 721250104,
					"content": "回来居住？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250105
					]
				},
				{
					"id": 721250105,
					"content": "嗯，之前因为「御影炉心」的事，原来住在踏鞴砂的人都被疏散去了别的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250106
					],
					"speakerTitle": "叶名山薰"
				},
				{
					"id": 721250106,
					"content": "前段时间，我听说「御影炉心」已经没事了，踏鞴砂也安全了，所以就去问了一下能不能回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250107
					],
					"speakerTitle": "叶名山薰"
				},
				{
					"id": 721250107,
					"content": "得到许可了之后，我就带着东西，重新回来这里住啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250108
					],
					"speakerTitle": "叶名山薰"
				},
				{
					"id": 721250108,
					"content": "但是…和我一样愿意回来住的人，似乎也没多少呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250115
					],
					"speakerTitle": "叶名山薰"
				},
				{
					"id": 721250115,
					"content": "不过这也是没办法的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250116
					],
					"speakerTitle": "叶名山薰"
				},
				{
					"id": 721250116,
					"content": "毕竟之前「御影炉心」出了那么大的问题，大家都担心这种事还会发生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250117
					],
					"speakerTitle": "叶名山薰"
				},
				{
					"id": 721250117,
					"content": "你不担心吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250118
					]
				},
				{
					"id": 721250118,
					"content": "我当然也担心啦…不过我这个人很恋家啦，而且也放心不下我种的那些花，嘿嘿。所以还是决定回来住了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250119
					],
					"speakerTitle": "叶名山薰"
				},
				{
					"id": 721250119,
					"content": "但是，我之前种在这周围的花果然都枯了啊。现在我也找不到花种，真可惜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250120
					],
					"speakerTitle": "叶名山薰"
				},
				{
					"id": 721250120,
					"content": "这里很适合种花的，无论播了什么种，都能很快开出一片的花海来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250121
					],
					"speakerTitle": "叶名山薰"
				},
				{
					"id": 721250121,
					"content": "我之前还移植过外国的花呢，蒙德的小灯草、风车菊和蒲公英，还有璃月的霓裳花我都移植过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250122
					],
					"speakerTitle": "叶名山薰"
				},
				{
					"id": 721250122,
					"content": "小灯草在夜里可好看了，就是要种在荫凉的地方，还要浇很多水，修剪掉枯掉的叶尖。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250123
					],
					"speakerTitle": "叶名山薰"
				},
				{
					"id": 721250123,
					"content": "风车菊我听说在有风的地方会长得很好，但我觉得，稻妻的风应该比不上蒙德的风…所以我经常过去给它用扇子扇风，不知道是不是真的有用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250124
					],
					"speakerTitle": "叶名山薰"
				},
				{
					"id": 721250124,
					"content": "蒲公英是最不用担心的，它能自己照顾自己，不过…它太会照顾自己了，总是会长在各种奇怪的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250125
					],
					"speakerTitle": "叶名山薰"
				},
				{
					"id": 721250125,
					"content": "呃，那个…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250126
					]
				},
				{
					"id": 721250126,
					"content": "还有璃月的霓裳花，打理霓裳花的叶子可是很麻烦的，那种叫做「鬼兜虫」的虫子总是会赖在霓裳花的花瓣里不走，我只能一个个挑走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250127
					],
					"speakerTitle": "叶名山薰"
				},
				{
					"id": 721250127,
					"content": "不过，我移植清心倒是失败了，种下去的清心不是长不大，就是枯萎得很快。唉，这世界上有没有那种，无论种什么花都能顺利出花的神奇土地呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250128
					],
					"speakerTitle": "叶名山薰"
				},
				{
					"id": 721250128,
					"content": "我、我知道了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250129
					]
				},
				{
					"id": 721250129,
					"content": "还有还有，你知道璃月有一种叫琉璃袋的花吗？那种花可难找了，我拜托了很多人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250130
					],
					"speakerTitle": "叶名山薰"
				},
				{
					"id": 721250130,
					"content": "啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250131
					],
					"speakerTitle": "叶名山薰"
				},
				{
					"id": 721250131,
					"content": "啊！对不起，对不起！我一说起花来就会这样，真的非常抱歉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250132
					],
					"speakerTitle": "叶名山薰"
				},
				{
					"id": 721250132,
					"content": "你、你真是喜欢花啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250133
					]
				},
				{
					"id": 721250133,
					"content": "只是稍微研究了一下而已，嘿嘿…但是现在我连花种都没有，连花都不能种了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "叶名山薰"
				},
				{
					"id": 721250109,
					"content": "我不是这里的居民。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250110
					]
				},
				{
					"id": 721250110,
					"content": "欸？是这样吗？我还以为有人和我一样，愿意回来住了呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250111
					],
					"speakerTitle": "叶名山薰"
				},
				{
					"id": 721250111,
					"content": "之前因为「御影炉心」的事，原来住在踏鞴砂的人都被疏散去了别的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250112
					],
					"speakerTitle": "叶名山薰"
				},
				{
					"id": 721250112,
					"content": "前段时间，我听说「御影炉心」已经没事了，踏鞴砂也安全了，所以就去问了一下能不能回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250113
					],
					"speakerTitle": "叶名山薰"
				},
				{
					"id": 721250113,
					"content": "得到许可了之后，我就带着东西，重新回来这里住啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250114
					],
