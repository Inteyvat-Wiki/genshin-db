					"nextDialogs": [
						721250302
					]
				},
				{
					"id": 721250302,
					"content": "我正在想，从哪里才能找到花种，把周围再种上花呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250303
