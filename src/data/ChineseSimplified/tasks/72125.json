					],
					"speakerTitle": "叶名山薰"
				},
				{
					"id": 721250304,
					"content": "听说「御影炉心」事被解决了之后，我就自己回来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250305
					],
