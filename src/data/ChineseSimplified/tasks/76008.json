				"points": [
					{
						"sceneId": 3,
						"position": [
							1954.406,
							242.627,
							10581.7
						],
						"pointId": 11129
					},
					{
						"sceneId": 3,
						"position": [
							1951.384,
							241.685,
							10578.37
						],
						"pointId": 13263
					},
					{
						"sceneId": 3,
