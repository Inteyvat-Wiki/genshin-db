					}
				]
			},
			"dialogs": [
				{
					"id": 760080101,
					"content": "啊，愿月光照临你们的前路！两位也是来向库塔{RUBY#[S]月之少女}尔大人祷告的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760080102
					],
					"speakerTitle": "爱维琳"
				},
				{
					"id": 760080102,
					"content": "祷告…是指在这边的雕像前祷告吗？话说回来，这个雕像真的好大喔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760080103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760080103,
					"content": "呵呵，很漂亮吧？这座「新月之像」据说是五百年前的咏月使大人亲自雕刻出来的，描绘的是库塔{RUBY#[S]月之少女}尔大人最初的模样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760080104
					],
					"speakerTitle": "爱维琳"
				},
				{
					"id": 760080104,
					"content": "至于库塔{RUBY#[S]月之少女}尔大人的诞生，并她在月下世界所行的奇事…我只是普通的侍祭，就先不向两位介绍太多细节啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760080105
					],
					"speakerTitle": "爱维琳"
				},
				{
					"id": 760080105,
					"content": "总之，这里也是向库塔{RUBY#[S]月之少女}尔大人献上祈愿的朝圣之路的终点。就算不是为了祈祷而来，也希望两位能感受到她的恩泽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760080106
					],
					"speakerTitle": "爱维琳"
				},
				{
					"id": 760080106,
					"content": "原来如此…欸？等等，这里就是终点了吗？那前面那个看上去相当不得了的大柱子是什么呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760080107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760080107,
					"content": "啊哈哈…那个其实不是柱子啦。下面是「初谕之庭」，是五百年前依照咏月使大人的谕令被封锁起来的旧圣所。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760080108
					],
					"speakerTitle": "爱维琳"
				},
				{
					"id": 760080108,
					"content": "某种意义上…算是「霜月之子」的禁地吧？而且因为那位咏月使大人的封锁，已经没人能进去了，所以还是不要靠近比较好喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760080109
					],
					"speakerTitle": "爱维琳"
				},
				{
					"id": 760080109,
					"content": "而上面的那个大家伙…那个其实是之前从天上掉下来的。库塔{RUBY#[S]月之少女}尔大人保佑，掉下来的碎片没有砸伤人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760080110
					],
					"speakerTitle": "爱维琳"
				},
				{
					"id": 760080110,
					"content": "呃，碎片？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760080111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760080111,
					"content": "是呀，那个大家伙掉下来的时候，从上面掉了好几块碎片下来。其中一块就掉到<color=#00E1FFFF>下面的营地</color>里去了…两位过来的时候应该也见到了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760080112
					],
					"speakerTitle": "爱维琳"
				},
				{
					"id": 760080112,
					"content": "至于其他的稍大一些的碎片，我记得基本上都掉到<color=#00E1FFFF>西边</color>去了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760080113
					],
					"speakerTitle": "爱维琳"
				},
				{
					"id": 760080113,
					"content": "总之，既然两位能来到这里，也一定是库塔尔大人的指引。就算不是来祈祷的，也愿月光祝福两位的前路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "爱维琳"
				}
			]
		}
	]
}