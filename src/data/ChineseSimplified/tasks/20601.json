				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"杰克"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 206010501,
					"content": "嘶，疼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010502
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 206010502,
					"content": "谢谢你，我还以为自己回不去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010503
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 206010503,
					"content": "你怎么样？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206010504
					]
				},
				{
					"id": 206010504,
					"content": "哈，一点小伤…呃！一点…小伤，我没问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010505
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 206010505,
					"content": "我是因为发现一群丘丘人正在向前面的营地里集结，觉得它们想要做什么，才跟了上去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010506
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 206010506,
					"content": "…但我跟踪调查的时候靠得太近，不小心就被它们发现了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010507
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 206010507,
					"content": "不说这个了，不用担心我，请快点去把前面的丘丘人都清理掉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010508
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 206010508,
					"content": "它们的数量越来越多，绝不能让它们的阴谋得逞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010509
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 206010509,
					"content": "至于我…我会照顾好我自己的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "杰克"
				}
			]
		},
		{
			"id": 2060106,
			"completionStepIds": [
				2060108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
