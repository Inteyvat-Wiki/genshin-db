				"objectNames": [
					"杰克"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 206010601,
					"content": "你已经清理掉那个营地了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010602
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 206010602,
					"content": "是的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206010603
					]
				},
				{
					"id": 206010603,
					"content": "你的实力可真强啊，要是我能像你一样优秀就好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010604
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 206010604,
					"content": "我也想留下斩杀恶龙、拯救世界的传说，但到头来连丘丘人都没法胜过…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010605
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 206010605,
					"content": "呃，那个…虽然很不好意思，但是我有件事拜托你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010606
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 206010606,
					"content": "其实我这次之所以会去千风神殿调查，是因为我马上就要「冒险等阶评定」了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010607
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 206010607,
					"content": "我想着如果能在这个时候展现出实力的话，等阶评定一定会顺利不少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010608
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 206010608,
					"content": "但是没想到，实力没展现出来，反而差点把自己给赔进去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010609
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 206010609,
					"content": "能，能拜托你，别把我的惨样告诉塞琉斯先生吗？要是真的影响到「冒险等阶评定」，那我就真的惨了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010610,
						206010612
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 206010610,
					"content": "我知道了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206010611
					]
				},
				{
					"id": 206010611,
					"content": "太谢谢你了！我以后一定不会再这么鲁莽了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "杰克"
				},
				{
					"id": 206010612,
					"content": "这样不好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206010613
					]
				},
				{
					"id": 206010613,
					"content": "我知道这样不好，塞琉斯先生也说「冒险家应该直面自己」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010614
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 206010614,
					"content": "但是…唉，算了，希望塞琉斯先生不会太生我的气…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "杰克"
				}
			]
		},
