			"dialogs": [
				{
					"id": 760300501,
					"content": "呜呜…咦？这是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300502
					],
					"speakerTitle": "莉洁卡"
				},
				{
					"id": 760300502,
					"content": "好漂亮…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300503
					],
					"speakerTitle": "莉洁卡"
				},
				{
					"id": 760300503,
					"content": "这样就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300504
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760300504,
					"content": "哦~她一路捡着石头回去了，那边是「霜月之坊」的方向呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760300505,
					"content": "（哥伦比娅…虽说自己不想被当作「神明」，但还是会帮助遇到困难的人…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760300506
					]
				},
				{
					"id": 760300506,
					"content": "啊，但这么一来，那幅画是不是就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760300507,
					"content": "没关系。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300508
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760300508,
					"content": "残缺的画可以之后再添上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300509
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760300509,
					"content": "我喜欢看人们找到「回家」的路，回到属于他们的「家」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				}
