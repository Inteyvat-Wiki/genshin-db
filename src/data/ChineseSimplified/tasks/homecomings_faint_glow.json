			"dialogs": [
				{
					"id": 760300301,
					"content": "这样就够了吧。总觉得已经采了好多好多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760300302,
					"content": "我们回去吧，也不能老让那画缺一块。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760300303,
					"content": "呜呜…呜呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300304
					],
					"speakerTitle": "莉洁卡"
				},
				{
					"id": 760300304,
					"content": "呀！有人过来了，先躲起来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760300305,
					"content": "呜呜…这里是哪里呀…妈妈…我想回家…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300306
					],
					"speakerTitle": "莉洁卡"
				},
				{
					"id": 760300306,
					"content": "看起来是「霜月之子」的人欸，她迷路了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760300307,
					"content": "我去帮帮她吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760300308
					]
				},
				{
					"id": 760300308,
					"content": "真的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300309
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760300309,
					"content": "啊？这怎么看都得帮吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760300310,
					"content": "我记得「霜月之子」对「外来者」很戒备。这么晚了，你头上没有角冠，如果她反倒被吓跑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300311
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760300311,
					"content": "你…你说得倒的确有可能，但也不能就这么不管吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760300312,
					"content": "唔…跟我来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300313
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760300313,
					"content": "欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
