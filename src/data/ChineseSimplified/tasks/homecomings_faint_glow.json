			"dialogs": [
				{
					"id": 760300101,
					"content": "哦~今天这里的氛围有些不寻常嘛，哥伦比娅你在装点这处花田吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760300102,
					"content": "不是我，是它们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300103
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760300103,
					"content": "它们…月灵？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760300104,
					"content": "这种石头在吸收了月矩力之后会泛出微光，月灵们很喜欢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300105
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760300105,
					"content": "所以它们就…把石头放在地上玩？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760300106,
					"content": "你们到这里来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300107
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760300107,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760300108,
					"content": "哦！原来从高处看的话是一幅画欸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760300109,
					"content": "但好像缺了一块…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760300110
					]
				},
				{
					"id": 760300110,
					"content": "有些不够了，我去采一点吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300111
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760300111,
					"content": "咦？你要出去采？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760300112,
					"content": "我知道一处不错的地方，那里月光照拂，有很多这样的石头。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300113
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760300113,
					"content": "要我们陪你吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760300114
					]
				},
				{
					"id": 760300114,
					"content": "好啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300115
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760300115,
					"content": "嗯，那就多采一些吧，我们也想看看完整的画呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
