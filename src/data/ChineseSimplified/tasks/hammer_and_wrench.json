			},
			"dialogs": [
				{
					"id": 413420401,
					"content": "嗯？旅行者，你找我有事吗？我现在正忙着呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420402
					],
					"speakerTitle": "王扳子"
				},
				{
