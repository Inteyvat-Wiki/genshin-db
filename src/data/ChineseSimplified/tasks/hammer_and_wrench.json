			"dialogs": [
				{
					"id": 413420901,
					"content": "久等了吧，我都搞定了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420902
					],
					"speakerTitle": "王扳子"
				},
				{
					"id": 413420902,
					"content": "怎么，事情全都弄完了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420903
					],
					"speakerTitle": "李锤子"
				},
				{
					"id": 413420903,
					"content": "弄完了，那么点小事，还有这个旅行者帮忙，轻轻松松就都解决了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420904
					],
					"speakerTitle": "王扳子"
				},
				{
					"id": 413420904,
					"content": "你这个人啊…唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420905
					],
					"speakerTitle": "李锤子"
				},
				{
					"id": 413420905,
					"content": "行了行了，大过节的，别这副表情嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420906
					],
					"speakerTitle": "王扳子"
				},
				{
					"id": 413420906,
					"content": "行，你说什么就是什么，霄灯你准备好了没有？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420907
					],
					"speakerTitle": "李锤子"
				},
				{
					"id": 413420907,
					"content": "霄灯…哎哟！我给忘了，你说我这记性…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420908
					],
					"speakerTitle": "王扳子"
				},
				{
					"id": 413420908,
					"content": "没事没事，不就是个霄灯嘛，不放也没什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420909
					],
					"speakerTitle": "王扳子"
				},
				{
					"id": 413420909,
					"content": "你少来这套，大过节的，不放霄灯像话吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420910
					],
					"speakerTitle": "李锤子"
				},
				{
					"id": 413420910,
					"content": "旅行者，能拜托你再帮我兄弟弄个霄灯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420911
					],
					"speakerTitle": "李锤子"
				},
				{
					"id": 413420911,
					"content": "交给我了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420912
					]
				},
				{
					"id": 413420912,
					"content": "谢谢，我们就在这等着你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "李锤子"
				}
			]
