			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"王扳子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413420501,
					"content": "思妤？她…她送我的霄灯？我…我看看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420502
					],
					"speakerTitle": "王扳子"
				},
				{
					"id": 413420502,
					"content": "哈哈哈，这愿望是她帮我写的吧，我小时候确实最想实现这个愿望…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420503
					],
					"speakerTitle": "王扳子"
				},
				{
					"id": 413420503,
					"content": "一转眼都过去了这么多年了，时间过得可真快啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420504
					],
					"speakerTitle": "王扳子"
				},
				{
					"id": 413420504,
					"content": "不过，她怎么让你把这盏霄灯送来？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420505,
						413420506
					],
					"speakerTitle": "王扳子"
				},
				{
					"id": 413420505,
					"content": "她家里还有事要忙…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420507
					]
				},
				{
					"id": 413420507,
					"content": "是吗，是这样…也好，也好，很不错啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420508
					],
					"speakerTitle": "王扳子"
				},
				{
					"id": 413420508,
					"content": "思妤现在过得肯定很不错吧，这样就好了…哈哈…哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420509
					],
					"speakerTitle": "王扳子"
				},
				{
					"id": 413420509,
					"content": "这样挺好的…不好意思…我还有很多工作要做，先走了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "王扳子"
				},
				{
					"id": 413420506,
					"content": "她说要回家帮老公…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420507
					]
				}
			]
		},
		{
