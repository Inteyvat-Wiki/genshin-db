			"trigger": {
				"objectNames": [
					"李锤子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413420602,
					"content": "那个霄灯是思妤送给他的，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420603,
						413420604
					],
					"speakerTitle": "李锤子"
				},
				{
					"id": 413420603,
					"content": "你刚才听见了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420605
					]
				},
				{
					"id": 413420605,
					"content": "他那么点事，我猜都不用猜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420606
					],
					"speakerTitle": "李锤子"
				},
				{
					"id": 413420606,
					"content": "去年他也是这样，出去了一趟之后，回来一个人杵在船边上敲了一晚上的钉子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420607
					],
					"speakerTitle": "李锤子"
				},
				{
					"id": 413420607,
					"content": "我知道他这么做的意思，但是，唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420608
					],
					"speakerTitle": "李锤子"
				},
				{
					"id": 413420608,
					"content": "旅行者，能不能请你去帮他一下？大过节的，这么折腾自己也不是个事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420609
					],
					"speakerTitle": "李锤子"
				},
				{
					"id": 413420609,
					"content": "好的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420610
					]
				},
				{
					"id": 413420610,
					"content": "唉…麻烦你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420611
					],
					"speakerTitle": "李锤子"
				},
				{
					"id": 413420611,
					"content": "估计他这会儿就去船上干活了…你赶紧去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420612
					],
