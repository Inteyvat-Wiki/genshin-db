			"trigger": {
				"objectNames": [
					"思妤"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413420101,
					"content": "果然，还是送盏霄灯过去吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420102
					],
					"speakerTitle": "思妤"
				},
				{
					"id": 413420102,
					"content": "送霄灯？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420103
					]
				},
				{
					"id": 413420103,
					"content": "是旅行者啊，是这样。从小扳子哥就一直很照顾我，平时也帮了我很多忙，他就和我亲哥哥一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420104
					],
					"speakerTitle": "思妤"
				},
				{
					"id": 413420104,
					"content": "但是大过节的，他似乎还在工作个不停…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420105
					],
					"speakerTitle": "思妤"
				},
				{
					"id": 413420105,
					"content": "我就想给他送一盏霄灯，嘿嘿，我们俩是从小玩到大的，小时候他最喜欢看霄灯了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420106
					],
					"speakerTitle": "思妤"
				},
				{
					"id": 413420106,
					"content": "现在送一盏霄灯过去，他肯定会高兴的。旅行者，能拜托你帮我把这盏霄灯送给他吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420107,
						413420108
					],
					"speakerTitle": "思妤"
				},
				{
					"id": 413420107,
					"content": "你自己不去送吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420109
					]
				},
				{
					"id": 413420109,
					"content": "我也想自己去送啦，但家里还有很多事要做…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420110
					],
					"speakerTitle": "思妤"
				},
				{
					"id": 413420110,
					"content": "我现在出来买东西，家里的事都是我老公一个人在忙，我得赶紧回去帮帮他才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420111
					],
					"speakerTitle": "思妤"
				},
				{
					"id": 413420111,
					"content": "所以霄灯的事就拜托你啦，等稍微有空了，我会和我老公一起去看扳子哥的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420112
					],
					"speakerTitle": "思妤"
				},
				{
					"id": 413420112,
					"content": "希望那时候扳子哥也能稍微闲一些…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "思妤"
				},
				{
					"id": 413420108,
					"content": "你去送会好一点…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420109
					]
				}
			]
		},
		{
			"id": 4134202,
			"completionStepIds": [
				4134202
