				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413421202,
					"content": "哦，这样就可以了，多谢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413421203
					],
					"speakerTitle": "王扳子"
				},
				{
					"id": 413421203,
					"content": "还有点零碎工作…能不能请你帮我去港口清点一下新到的物资？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413421204
					],
					"speakerTitle": "王扳子"
				},
				{
					"id": 413421204,
					"content": "应该就是三个箱子，就堆在港口上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413421205
					],
					"speakerTitle": "王扳子"
				},
				{
					"id": 413421205,
					"content": "交给我了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413421206
					]
				},
				{
					"id": 413421206,
					"content": "那就拜托你了，我得赶紧把这些活给收尾…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "王扳子"
				}
			]
		},
