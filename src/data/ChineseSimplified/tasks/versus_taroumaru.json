			"dialogs": [
				{
					"id": 727210101,
					"content": "呜汪？汪汪！汪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727210102,
						727210103
					],
					"speakerTitle": "太郎丸"
				},
				{
					"id": 727210102,
					"content": "怎么是太郎丸？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727210104
					]
				},
				{
					"id": 727210104,
					"content": "之前听安彦太郎说，第四位武者是因为手头有点紧才来参加比试的，看来太郎丸的目标也是获胜者的礼金。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727210105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727210105,
					"content": "虽然有点不好意思，可在钱这件事上，我是不会让步的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727210106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727210106,
					"content": "呜汪？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727210107
					],
					"speakerTitle": "太郎丸"
				},
				{
					"id": 727210107,
					"content": "汪汪，汪汪汪汪！汪汪汪！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727210108,
						727210109
					],
					"speakerTitle": "太郎丸"
				},
				{
					"id": 727210108,
					"content": "太郎丸的叫声变大了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727210110
					]
				},
				{
					"id": 727210110,
					"content": "#太郎丸，这可是堂堂正正的比试，礼金应该属于你和{NICKNAME}之中武艺更强的那个。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727210111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727210111,
					"content": "不过如果我们赢了的话，也可以给你买点好吃的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727210112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727210112,
					"content": "汪，汪汪汪汪汪，汪汪汪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727210115,
						727210113
					],
					"speakerTitle": "太郎丸"
				},
				{
					"id": 727210115,
					"content": "虽然听不懂，但是来吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727210116
					]
				},
				{
					"id": 727210116,
					"content": "汪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "太郎丸"
				},
				{
					"id": 727210113,
					"content": "虽然听不懂，但我还需要准备一下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727210114
					]
				},
				{
					"id": 727210114,
					"content": "汪汪汪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "太郎丸"
				},
				{
					"id": 727210109,
					"content": "该不是激怒它了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727210110
					]
				},
				{
					"id": 727210103,
					"content": "「最强武者」是太郎丸！",
