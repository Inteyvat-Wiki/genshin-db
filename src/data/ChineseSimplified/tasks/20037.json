			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"古德温"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200370101,
					"content": "…唉，真想直接回蒙德城算了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370102
					],
					"speakerTitle": "古德温"
				},
				{
					"id": 200370102,
					"content": "呃，旅行者！那个，你能帮我个忙吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370103
					],
					"speakerTitle": "古德温"
				},
				{
					"id": 200370103,
					"content": "如你所见，我是一名西风骑士，正在野外执行巡逻任务。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370104
					],
					"speakerTitle": "古德温"
				},
				{
					"id": 200370104,
					"content": "我和我的女朋友说好，隔段时间就会寄封信给她报平安。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370105
					],
					"speakerTitle": "古德温"
				},
				{
					"id": 200370105,
					"content": "结果我居然忙到忘记了，哈哈哈…请你把这封<color=#00E1FFFF>信</color>帮我送给她吧，她叫<color=#00E1FFFF>葛罗丽</color>…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370106
					],
					"speakerTitle": "古德温"
				},
				{
					"id": 200370106,
					"content": "等等，葛罗丽？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370107
					]
				},
				{
					"id": 200370107,
					"content": "那位盲眼的…收集蒲公英的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200370108,
					"content": "喂！葛罗丽小姐说的古德温，原来就是你吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200370109,
					"content": "咦，为什么你们会认识葛罗丽？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370110
					],
					"speakerTitle": "古德温"
				},
				{
					"id": 200370110,
					"content": "我们帮过她的忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370111
					]
				},
				{
					"id": 200370111,
					"content": "她、她找你们帮忙？是要做什么危险的事吗？你们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370112
					],
					"speakerTitle": "古德温"
				},
				{
					"id": 200370112,
					"content": "葛罗丽小姐只是拜托我们帮她搜集蒲公英啦。说是撒在空中的话，可以把心愿传达给你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200370113,
					"content": "啊，蒲公英…确实像是葛罗丽会做的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370114
					],
					"speakerTitle": "古德温"
				},
				{
					"id": 200370114,
					"content": "你不是离开蒙德城很久了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370115
					]
				},
				{
					"id": 200370115,
					"content": "本来应该是这样。算了…我就说了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370116
					],
					"speakerTitle": "古德温"
				},
				{
					"id": 200370116,
					"content": "你有没有听说，大团长把五分之四骑士带出蒙德的事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370117
					],
					"speakerTitle": "古德温"
				},
				{
					"id": 200370117,
					"content": "是的，我也是骑士团远征队的一员…但在出征之前，我因为弄丢了葛罗丽的信物，想要寻找，却掉了队…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370118
					],
					"speakerTitle": "古德温"
				},
				{
					"id": 200370118,
					"content": "到现在也没找到归队的方法，只能一直在这附近转悠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370119
					],
					"speakerTitle": "古德温"
				},
				{
					"id": 200370119,
					"content": "我也不好意思回蒙德城，就这么灰溜溜地回去，西风骑士们都会怎么看我啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370120
					],
					"speakerTitle": "古德温"
				},
				{
					"id": 200370120,
					"content": "还有葛罗丽，我答应她，会在世界各地给她寄信和礼物，把「全世界」都带给她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370121
					],
					"speakerTitle": "古德温"
				},
				{
					"id": 200370121,
					"content": "要是她知道我连蒙德都没走出去…的…话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370122
					],
					"speakerTitle": "古德温"
				},
				{
					"id": 200370122,
					"content": "原来是面子问题呀",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200370123,
					"content": "拜托了，你能帮我把这封<color=#00E1FFFF>信</color>送给<color=#00E1FFFF>葛罗丽</color>吗？说不定，她还在为我担心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370124,
						200370126
					],
					"speakerTitle": "古德温"
				},
				{
					"id": 200370124,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370125
					]
				},
				{
					"id": 200370125,
					"content": "那就拜托你了，旅行者，千万帮我保密啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "古德温"
				},
				{
					"id": 200370126,
					"content": "你干脆也用蒲公英好了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370127
					]
				},
				{
					"id": 200370127,
					"content": "我想对葛罗丽说的话太多了，蒲公英怎么可能载得动嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370128
					],
					"speakerTitle": "古德温"
				},
				{
					"id": 200370128,
					"content": "信就拜托你了，千万帮我保密！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "古德温"
				}
			]
		},
