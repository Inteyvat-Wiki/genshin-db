			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"古德温"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200370501,
					"content": "信送到了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370502
					],
					"speakerTitle": "古德温"
				},
				{
					"id": 200370502,
					"content": "葛罗丽向你问好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370503
					]
				},
				{
					"id": 200370503,
					"content": "呼…我这么久没联系她，还好她没生气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370504
					],
					"speakerTitle": "古德温"
				},
				{
					"id": 200370504,
					"content": "你一直在蒙德周围，为什么会知道璃月港的事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200370505,
					"content": "那个啊，呃…这些故事我都是听大团长说的，他去过很多地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370506
					],
					"speakerTitle": "古德温"
				},
				{
					"id": 200370506,
					"content": "好了，谢谢你，帮了我这么大的忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370507
					],
					"speakerTitle": "古德温"
				},
				{
					"id": 200370507,
					"content": "这些蒲公英籽给你们，都是我采的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370508
					],
					"speakerTitle": "古德温"
				},
				{
					"id": 200370508,
					"content": "下次葛罗丽还想搜集蒲公英的话，请你们继续照顾她吧，麻烦你们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "古德温"
				}
			]
		}
	]
