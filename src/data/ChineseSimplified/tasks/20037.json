					"葛罗丽"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200370301,
					"content": "您好…啊，这个声音，是之前的那位旅行者吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370302
					],
					"speakerTitle": "葛罗丽"
				},
				{
					"id": 200370302,
					"content": "请问您找我有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370303
					],
					"speakerTitle": "葛罗丽"
				},
				{
					"id": 200370303,
					"content": "有人托我带给你一封信。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370304
					]
				},
				{
					"id": 200370304,
					"content": "信？谁会给我写信…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370305
					],
					"speakerTitle": "葛罗丽"
				},
				{
					"id": 200370305,
					"content": "难道是古德温？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370306
					],
					"speakerTitle": "葛罗丽"
				},
				{
					"id": 200370306,
					"content": "您遇见他了吗？他还好吧，他说过自己会什么时候回来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370307
					],
					"speakerTitle": "葛罗丽"
				},
				{
					"id": 200370307,
					"content": "抱歉，他现在一定很忙，请您忘了我刚说的话吧，不要再给他压力了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370308
					],
					"speakerTitle": "葛罗丽"
				},
				{
					"id": 200370308,
					"content": "能请您现在就帮我念念这封信吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370309
					],
					"speakerTitle": "葛罗丽"
				},
				{
					"id": 200370309,
					"content": "请小声一点，我们两个人听得到就好啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370310
					],
					"speakerTitle": "葛罗丽"
				},
				{
					"id": 200370310,
					"content": "好的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370311
					]
				},
				{
					"id": 200370311,
					"content": "您念得真不错…难道，您经常给人念信吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370312
					],
					"speakerTitle": "葛罗丽"
				},
				{
					"id": 200370312,
					"content": "信就写到这里了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370313
					]
				},
				{
					"id": 200370313,
					"content": "璃月港…古德温真的去了很远的地方啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370314
					],
					"speakerTitle": "葛罗丽"
				},
				{
					"id": 200370314,
					"content": "谢谢你，我会珍藏这封信的，再见到<color=#00E1FFFF>古德温</color>的时候，记得替我向他问声好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370315
					],
					"speakerTitle": "葛罗丽"
				}
			]
		},
