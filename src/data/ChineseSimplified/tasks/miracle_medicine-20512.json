			},
			"dialogs": [
				{
					"id": 205120101,
					"content": "药方越来越怪了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120102
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205120102,
					"content": "安娜怎么样了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205120103
					]
				},
				{
					"id": 205120103,
					"content": "是你啊，呃，虽然说出来你可能不信，但是安娜说自己确实感觉好多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120104
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205120104,
					"content": "难道是那位医生的药方真的起作用了？我自己都不信…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120105
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205120105,
					"content": "不过，不管是不是真的，总之还是先吃药吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120106
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205120106,
					"content": "这次的药方是…我看看，你能帮我找一份「水史莱姆的浓厚凝液」来吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120107,
						205120112,
						205120117
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205120107,
					"content": "这次的还算正常。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205120108
					]
				},
				{
					"id": 205120108,
					"content": "…呃，正常吗？我觉得这次的反而更不正常了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120109
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205120109,
					"content": "不过，这次倒是挺好找的，「浓厚凝液」我也问过别人，只要消灭大型史莱姆应该就能拿到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120110
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205120110,
					"content": "我还听杰克说，如果想引出大型史莱姆，就要先不断消灭小型的史莱姆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120111
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205120111,
					"content": "我是没这种战斗力的，所以，就拜托你了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205120112,
					"content": "也许能入口，放心吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205120113
					]
				},
				{
					"id": 205120113,
					"content": "你怎么知道的，你难道尝试过吗？呃，你怎么突然不说话了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120114
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205120114,
					"content": "算了先不说这个，水史莱姆应该很好找。「浓厚凝液」我问过别人，只要消灭大型史莱姆应该就能拿到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120115
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205120115,
					"content": "我还听杰克说，如果想引出大型史莱姆，就要先不断消灭小型的史莱姆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120116
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205120116,
					"content": "我是没这种战斗力的啦，就拜托你了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205120117,
					"content": "好说，我知道在哪。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205120118
					]
				},
				{
					"id": 205120118,
					"content": "嚯…真可靠啊，看来你已经很熟悉怎么对付史莱姆了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120119
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205120119,
					"content": "那就麻烦你了。「浓厚凝液」，只要消灭大型史莱姆应该就能拿到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120120
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205120120,
					"content": "我还听杰克说，如果想引出大型史莱姆，就要先不断消灭小型的史莱姆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120121
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205120121,
					"content": "那么，就万事拜托了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安东尼"
				}
			]
		},
