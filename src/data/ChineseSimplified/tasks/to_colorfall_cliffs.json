					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400704
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150400704,
					"content": "当然，只要地形开阔，不被山体遮挡，无论是从呼呼丘的屋顶泳池，还是提提岛那边的峡湾，全都看得到！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400705
					],
					"speakerTitle": "提可菈"
				},
				{
					"id": 150400705,
					"content": "真为你们骄傲。好好发挥啊，二位！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400706
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150400706,
					"content": "啊…我已经开始激动了，要用什么颜色好呢…我的幸运色？还是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400707
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150400707,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400708
					],
					"speakerTitle": "阿夏"
				},
				{
					"id": 150400708,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400709
					],
					"speakerTitle": "阿夏"
				},
				{
					"id": 150400709,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400710
					],
					"speakerTitle": "阿夏"
				},
				{
					"id": 150400710,
					"content": "唔，它这是一口气说了好长一段话？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400711
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150400711,
					"content": "恰斯卡，你看着的吧？再替大家翻译翻译呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400712
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150400712,
					"content": "嗯…信息量太多，我得算算到底有多少种可能性…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400713
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150400713,
					"content": "#我想我明白了它的意思。阿夏是想和我组队，和{NICKNAME}比拼一番。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400714
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150400714,
					"content": "它喜欢和朋友合作，共同帮助有需要的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400715
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150400715,
					"content": "但具备竞技性的挑战才会让平凡的活动变成令人兴奋不已的冒险，它很享受这份刺激。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400716
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150400716,
					"content": "它…它真说了那么多？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400717
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150400717,
					"content": "哈哈，大意吧！也加入了我自己的理解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400718
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150400718,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400719
					],
					"speakerTitle": "阿夏"
				},
				{
					"id": 150400719,
					"content": "看这反应好像是说中了，他俩的感情还真是越来越好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400720
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150400720,
					"content": "#好啦，阿夏，虽然我和你有着相同的想法…但我们不该让{NICKNAME}迁就我们的喜好，对吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400721
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150400721,
					"content": "要认真尊重朋友的心情和意见哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400722
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150400722,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400723,
						150400726,
						150400729
					],
					"speakerTitle": "阿夏"
				},
				{
					"id": 150400723,
					"content": "早就想挑战团长了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150400724
					]
				},
				{
					"id": 150400724,
					"content": "「那我接受你的挑战。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400725
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150400725,
					"content": "啊哈哈…看到你的表情，我实在没办法把这句话说出气势来啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400732
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150400732,
					"content": "两边的参赛选手都准备好了吗？那就跟我来吧，由我担任裁判。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "提可菈"
				},
				{
					"id": 150400726,
					"content": "只要班尼特和阿夏开心就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150400727
					]
				},
				{
					"id": 150400727,
					"content": "#不行，只有我们开心是不够的！{NICKNAME}，我希望你也能享受其中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400728
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150400728,
					"content": "来吧！不要有压力，玩得开心最重要！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400732
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150400729,
					"content": "你们五个都上我也不会输。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150400730
					]
				},
				{
					"id": 150400730,
					"content": "#{NICKNAME}很有自信啊！好！那我也要使出全力了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400731
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150400731,
					"content": "喂！我可一直都是和你一队的呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400732
					],
					"speakerTitle": "派蒙"
				}
			]
