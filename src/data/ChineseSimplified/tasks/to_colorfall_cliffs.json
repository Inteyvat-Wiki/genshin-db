			"dialogs": [
				{
					"id": 150400301,
					"content": "哇，效果真棒！「沫彩花海」终于像模像样了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400302
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150400302,
					"content": "各位都辛苦啦，剩下的，只需要找到那位工作人员说一声就行了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150400303,
					"content": "几位请留步，呼…呼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400304
					],
					"speakerTitle": "提可菈"
				},
				{
					"id": 150400304,
					"content": "说来就来了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150400305,
					"content": "别急，请慢点说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400306
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150400306,
					"content": "呼…好的，我是负责彩彩崖主要挑战项目「飘飘巡风阿夏」的工作人员。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400307
					],
					"speakerTitle": "提可菈"
				},
				{
					"id": 150400307,
					"content": "刚才从高处看到这里的草地突然之间变成了花海，还是那么富有艺术美感的配色，吓得望远镜都快掉了下来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400308
					],
					"speakerTitle": "提可菈"
				},
				{
					"id": 150400308,
					"content": "你们…你们简直是彩彩崖的救星啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400309
					],
					"speakerTitle": "提可菈"
				},
				{
					"id": 150400309,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400310
					],
					"speakerTitle": "阿夏"
				},
				{
					"id": 150400310,
					"content": "举手之劳，嘿嘿，出力的主要是他俩啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150400311,
					"content": "#{M#两位救星先生}{F#救星小姐和救星先生}，请问你们愿意尝试我这边的项目…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400312
					],
					"speakerTitle": "提可菈"
				},
				{
					"id": 150400312,
					"content": "不…请问你们愿意为我们的标志性建筑染上色彩吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400313
					],
					"speakerTitle": "提可菈"
				},
				{
					"id": 150400313,
					"content": "听着好厉害啊…真的可以吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400314
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150400314,
					"content": "当然可以，绝对可以，不如说…恳请你们答应！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400315
					],
					"speakerTitle": "提可菈"
				},
				{
					"id": 150400315,
					"content": "一想到我那位同事平白蒙受了各位的照顾，我理应替他答谢你们！我想这份体验或许比酬金更特殊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400316
					],
					"speakerTitle": "提可菈"
				},
				{
					"id": 150400316,
					"content": "那我还是觉得…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150400317,
					"content": "她的意思是我们答应了！哈哈，请问要怎么过去？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400318
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150400318,
					"content": "请随我来，我们乘坐热气球上去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "提可菈"
				}
			]
