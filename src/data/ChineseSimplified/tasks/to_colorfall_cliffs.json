			"dialogs": [
				{
					"id": 150400101,
					"content": "到了！这里就是地图上说的「沫彩花海」了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400102
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150400102,
					"content": "怎么…那么绿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150400103,
					"content": "比起花海更像是草海。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150400104
					]
				},
				{
					"id": 150400104,
					"content": "哈哈，和我想象中的画面是有点不一样…不过这种事情也是经常发生的嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400105
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150400105,
					"content": "你说景点的宣传比实际更好？从我的角度出发，眼前的程度已经到可以投诉的地步了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400106
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150400106,
					"content": "如果我不投诉，我的客人也会投诉我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400107
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150400107,
					"content": "不不不，是我没有表达清楚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400108
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150400108,
					"content": "我说的是有落差感这件事。我看到的，经常和我想象的不一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400109
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150400109,
					"content": "该不会是说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150400110,
					"content": "嗯，比如为了眺望风景登上山顶，山间却突然升起了浓雾，连下山路都看不清。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400111
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150400111,
					"content": "或者回到帐篷之后发现里面钻进了一只火史莱姆，把收集来的木材全点燃了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400112
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150400112,
					"content": "听起来有点可怜啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400113
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150400113,
					"content": "我倒是已经习惯了，总结来说，都是冒险路上的波折！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400114
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150400114,
					"content": "所以，这一带风景广袤无垠，嗯…空气清爽又干净，还没有出现魔物…已经很幸运了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400115
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150400115,
					"content": "我认为最幸运的是你能保持这样的心态。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400116
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150400116,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400117
					],
					"speakerTitle": "阿夏"
				},
				{
					"id": 150400117,
					"content": "阿夏是不是发现了什么？听它叫声是那个意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400118
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150400118,
					"content": "才过多久呀，你们熟悉得太快了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150400119,
					"content": "（看了阅读物）",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150400120
					]
				},
				{
					"id": 150400120,
					"content": "这就是所谓的「死对头」吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150400121,
					"content": "如果双方都是人，还可以通过沟通来解决，可惜对方是只阿夏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400122
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150400122,
					"content": "好，我们来伸出援手吧！阿夏，准备好了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400123
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150400123,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400124
					],
					"speakerTitle": "阿夏"
				},
				{
					"id": 150400124,
					"content": "啊？我听漏了什么？怎么这就到「开始行动」这一步了？你们要做什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150400125,
					"content": "阿夏们的爱好非常容易观察总结，那就是染色，没错吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400126
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150400126,
					"content": "没错倒是没错…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150400127,
					"content": "而阿夏的心思都很单纯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400128
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150400128,
					"content": "比起存心要给负责这片区域的工作人员添麻烦，我想，更有可能的是它不喜欢平平淡淡、毫无艺术特色的草地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400129
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150400129,
					"content": "再加上那二位的沟通很不顺利…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400130
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150400130,
					"content": "嗯，所以只要我们能把草地喷涂成漂亮的颜色，符合大家对于「花海」的想象…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400131
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150400131,
					"content": "说不定既能得到艺术家阿夏的认可，又能为那位员工解决烦恼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400132
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150400132,
					"content": "没错，这就是我想做的事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400133
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150400133,
					"content": "有想法，看来你也挺适合做「调停人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400134
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150400134,
					"content": "我也加入。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150400135
					]
				},
				{
					"id": 150400135,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400136
					],
					"speakerTitle": "阿夏"
				},
				{
					"id": 150400136,
					"content": "哈哈，好痒…别这样…等等，我们这是要去哪里？远不远？要跟朋友先说一声——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400137
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150400137,
					"content": "喂——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400138
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150400138,
					"content": "翻译小姐，你看懂了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150400139,
					"content": "可能是要搬什么东西，或者附近还有更迫切需要帮忙的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400140
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150400140,
					"content": "这两者的意思几乎没关联吧！还有…你是怎么知道的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400141
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150400141,
					"content": "嗯…看多了就觉得它们的肢体语言跟龙有不少相似之处。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400142
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150400142,
					"content": "呃…你别骗我，真的有吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400143
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150400143,
					"content": "我的「妈妈」会用举起翅膀这个动作表达「今天早点回来吃饭」和「你小子找打」这两种截然不同的含义。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400144
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150400144,
					"content": "那你要怎么区分呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400145
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150400145,
					"content": "小时候就是区分不清楚，早早回家结果挨了一顿打。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400146
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150400146,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400147
					],
					"speakerTitle": "阿夏"
				},
				{
					"id": 150400147,
					"content": "结构很牢固，运行速度也快…这就是纳塔的热气球吗？太棒了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400148
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150400148,
					"content": "各位，我们回来啦！看天上看天上！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "班尼特"
				}
			]
