					"行秋"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120030601,
					"content": "别太得意忘形了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030602
					],
					"speakerTitle": "债务处理人"
				},
				{
					"id": 120030602,
					"content": "哇，有个看起来很厉害的人走出来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 1200308,
			"completionStepIds": [
				1200308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200308",
							"2"
						],
						"stepId": 1200308,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"行秋"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120030801,
					"content": "有两下子，不是泛泛之辈…这样打下去，损失就难以接受了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030802
					],
					"speakerTitle": "债务处理人"
				},
				{
					"id": 120030802,
					"content": "他们快坚持不住了，继续上啊！把石珀都抢过来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030803
					],
					"speakerTitle": "茂才公"
				},
				{
					"id": 120030803,
					"content": "愚人众和你本来就只有生意上的合作关系，我可没有让你带着我的人去寻衅滋事，惹下这种麻烦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030804
					],
					"speakerTitle": "债务处理人"
				},
				{
					"id": 120030804,
					"content": "说…说什么呢？大人，我、我这也不是为了完成订单嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030805
					],
					"speakerTitle": "茂才公"
				},
				{
					"id": 120030805,
					"content": "订单的事，自己想办法吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030806
					],
					"speakerTitle": "债务处理人"
				},
				{
					"id": 120030806,
					"content": "别、别走啊！喂！喂！大人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030807
					],
					"speakerTitle": "茂才公"
				},
				{
					"id": 120030807,
					"content": "少爷？！你怎么在这里？没有受伤吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030808
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 120030808,
					"content": "#有这位{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_XIABOY|INFO_FEMALE_PRONOUN_XIAGIRL]}相助，所幸无恙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030809
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030809,
					"content": "少爷？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030810,
						120030811
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120030810,
					"content": "少爷？！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030812
					]
				},
				{
					"id": 120030812,
					"content": "你、你就是「飞云商会」的少爷？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030813
					],
					"speakerTitle": "茂才公"
				},
				{
					"id": 120030813,
					"content": "在下行不更名坐不改姓，古华派弟子，暨「飞云商会」掌柜次子，行秋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030814
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030814,
					"content": "该死，居然被你算计了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030815
					],
					"speakerTitle": "茂才公"
				},
				{
					"id": 120030815,
					"content": "茂才公，强抢这种事对生意人来说太不体面了吧，不如还是用生意的办法解决。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030816
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030816,
					"content": "没有这石珀，「愚人众」会把你怎么样，需要我帮你想象一下吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030817
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030817,
					"content": "可恶…说吧，你要怎么样才肯卖给我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030818
					],
					"speakerTitle": "茂才公"
				},
				{
					"id": 120030818,
					"content": "既然你和常九爷开的是三折，那一报还一报。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030819
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030819,
					"content": "市场价的三倍，怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030820
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030820,
					"content": "你趁火打劫！欺人太甚！你…你…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030821
					],
					"speakerTitle": "茂才公"
				},
				{
					"id": 120030821,
					"content": "叫唤得这么厉害，买还是不买啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030822
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030822,
					"content": "我…唉，好好好，我答应你，我去筹钱，行了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030823
					],
					"speakerTitle": "茂才公"
				},
				{
					"id": 120030823,
					"content": "感谢贵客惠顾「飞云商会」，今后的生意也望多多关照了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030824
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030824,
					"content": "你你你你你你居然是「飞云商会」的少爷？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030825
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120030825,
					"content": "我们用的那哗啦啦点都点不清楚的摩拉，都是从你的金库——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030826
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120030826,
					"content": "小事一桩。这是一笔稳赚不赔的生意，还能顺便教训茂才公，一举两得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030827,
						120030829
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030827,
					"content": "真是人不可貌相。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030828
					]
				},
				{
					"id": 120030828,
					"content": "过奖过奖，你的侠义之心也令人钦佩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030831
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030831,
					"content": "啊——！之前我一直叫他书呆子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030832
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120030832,
					"content": "我在武侠小说里看过，有钱的少爷如果生气了的话，会花钱买人手脚的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030833
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120030833,
					"content": "怎么办？怎么办？对不起！对不起！真的很对不起！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030834
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120030834,
					"content": "既然你能飞，脚也不是那么必要的东西吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030835
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030835,
					"content": "#呜哇！{NICKNAME}，帮帮我啊！他的眼神是认真的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030836,
						120030837
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120030836,
					"content": "明显是在捉弄你啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030838
					]
				},
				{
					"id": 120030838,
					"content": "玩笑到此为止，这次的事情真是谢谢二位了，帮了很大的忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030839
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030839,
					"content": "这本《神霄折戟录》也让我非常尽兴，麻烦你们帮我还给常九爷吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030840
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030840,
					"content": "又让我们跑腿？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030841
					]
				},
				{
					"id": 120030841,
					"content": "因为其实我并没有做什么，不应该去接受谢意。倒是两位本与此事毫无瓜葛，却帮到了最后。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030842
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030842,
					"content": "能结识如此有侠义心肠的友人，在下已经心满意足。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030843
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030843,
					"content": "少爷，抱歉打断您，但老爷那边…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030844
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 120030844,
					"content": "关于这个，请帮我给父亲带句话，我这次平息了事态，还赚了大钱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030845
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030845,
					"content": "不知可否将功补过，再换几日自由？《神霄折戟录》提到了一处秘境，我想去寻访一番…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030846
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030846,
					"content": "说得那么好听，其实还是你自己不想去啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030847
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120030847,
					"content": "哈哈哈，若是我说，常九爷那里不光有谢意，还会有谢礼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030848
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030848,
					"content": "谢礼！那…那还说得过去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030849
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120030849,
					"content": "唉，看来不管我说什么，只怕也留不住少爷您吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030850
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 120030850,
					"content": "应该早说行秋是你家少爷…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030851
					]
				},
				{
					"id": 120030851,
					"content": "我、我也没想到你们会不知道啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030852
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 120030852,
					"content": "那么还书一事就拜托二位。行秋告辞，有缘我们江湖再见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030837,
					"content": "你看的真的是武侠小说吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030838
					]
				},
				{
					"id": 120030829,
					"content": "富家少爷现在都不练字吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030830
					]
				},
				{
					"id": 120030830,
					"content": "哈哈哈，别挖苦我了。看到我的字家里人就能认出我，这也算一种特征吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030831
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030811,
					"content": "…果然是这么一回事啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030812
					]
				}
			]
		},
		{
			"id": 1200309,
			"completionStepIds": [
				1200309
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200309",
							"2"
						],
						"stepId": 1200309,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"常九爷"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120030901,
					"content": "你们终于来了！今天早上当铺的人主动把我的藏书都还回来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030902
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 120030902,
					"content": "这所有的事一定都是你们帮的忙吧，太谢谢了，真的太谢谢了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030903,
						120030904
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 120030903,
					"content": "不用客气，帮上忙就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030905
					]
				},
				{
					"id": 120030905,
					"content": "哎呀，千万别这么说，这件事对我来说真的关系重大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030906
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 120030906,
					"content": "常家原本也算璃月的大家族，可惜我做少当家时，生意上多次受挫，败了家里的财产…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030907
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 120030907,
					"content": "我积攒了多年财力，想要重振家族荣光…这批石珀的生意，就是我压上全部身家的希望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030908
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 120030908,
					"content": "要不是你们，我估计得葬在这荒山野岭里了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030909
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 120030909,
					"content": "没想到你也是个「少爷」啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030910
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120030910,
					"content": "嗯？什么意思？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030911
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 120030911,
					"content": "啊没什么没什么！对了，我们是来还书的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030912
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120030912,
					"content": "哦哦，《神霄折戟录》！我就说那古华派的小子怎么突然没影了，还以为他是个小毛贼呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030913
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 120030913,
					"content": "古华派…有这么不被人待见吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030914
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120030914,
					"content": "这个门派倒是有几百年的历史，也曾经辉煌过，但现在已经衰落到不成样子了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030915
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 120030915,
					"content": "振兴山门要靠新鲜血液，但若是一直衰落下去，就永远吸引不来人才，这是个恶性循环。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030916
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 120030916,
					"content": "现在古华派的年轻人啊…就比如那小子吧，说要报恩，结果远不如你们有担当。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030917,
						120030918
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 120030917,
					"content": "也不见得。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030919
					]
				},
				{
					"id": 120030919,
					"content": "唉，无所谓啦。对了对了，你们是来找《提瓦特游览指南》的璃月篇的吧！我已经帮你们备好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030920
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 120030920,
					"content": "送给你们，不用还了。另外，大恩难以为报，还有一份微薄的谢礼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030921,
						120030922
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 120030921,
					"content": "谢谢，总算不是白跑一趟。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030923
					]
				},
				{
					"id": 120030923,
					"content": "矿卖出去了，宝贝书也回来了，这真是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030924
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 120030924,
					"content": "咦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030925
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 120030925,
					"content": "怎么了？我看好像有什么东西掉出来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030926
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120030926,
					"content": "没什么，没什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030927
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 120030927,
					"content": "（莫非…那个小毛贼…是…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "常九爷"
				},
				{
					"id": 120030922,
					"content": "我差点都忘了这回事了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030923
					]
				},
				{
					"id": 120030918,
					"content": "说不定古华派的转机就要来了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030919
					]
				},
				{
					"id": 120030904,
					"content": "其实我们也没做什么。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030905
					]
				}
			]
		}
	]
}