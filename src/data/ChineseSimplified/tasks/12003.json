			"dialogs": [
				{
					"id": 120004501,
					"content": "真是太感谢你们了，这下子我的矿石生意还有希望…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120004502
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 120004502,
					"content": "之前对你们说话有点不客气，太抱歉了，还望多多担待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "常九爷"
				}
			]
		},
		{
			"id": 1200304,
			"completionStepIds": [
				1200304
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200304",
							"2"
						],
						"stepId": 1200304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"行秋"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120030401,
					"content": "最后一出好戏，可不能缺了你们两位重要的看客。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030402
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030402,
					"content": "说得轻松，我们在跑这儿跑那儿的时候，你又干了什么啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120030403,
					"content": "这个嘛…当然是好好读完了《神霄折戟录》，度过了一段美妙的时光。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030404
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030404,
					"content": "神戟与邪剑，弥耳与未央…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030405
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030405,
					"content": "前五卷故事的展开，还可以说它「奇」，或是「妙」，但这第六卷，已经找不到合适的形容了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030426
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030426,
					"content": "这世上，也就那位奇人，能写出这样的奇作吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030427
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030427,
					"content": "但这和茂才公的事，有什么关系吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120030406,
					"content": "我只是感叹一下。毕竟，「出乎意料」是特别少见的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030407,
						120030409
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030407,
					"content": "事情都被你算到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030408
					]
				},
				{
					"id": 120030408,
					"content": "也多亏你的帮助，我的预想才会实现。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030411
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030411,
					"content": "什、什么？这…这种「只有我不明白」的气氛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120030412,
					"content": "那…那为什么你说要在仓库这里看好戏呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120030413,
					"content": "试想一下，茂才公跑遍整个璃月港，也买不到半个石珀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030414
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030414,
					"content": "他担惊受怕，没有材料就完成不了契约，完成不了契约，就会得罪「愚人众」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030415
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030415,
					"content": "惶恐之中他听到了「飞云商会」的名字，一下子变得气急败坏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030416
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030416,
					"content": "茂才公有权有势，什么时候被这样针对过？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030417
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030417,
					"content": "不管是想出气，还是要解决问题，他都要…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030418
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030418,
					"content": "原来是你们，就是你们在帮常九爷出头吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030419
					],
					"speakerTitle": "茂才公"
				},
				{
					"id": 120030419,
					"content": "你们看，说来就来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030420
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030420,
					"content": "我跑了一大圈，到哪里都买不到石珀，这才知道是「飞云商会」在大肆收购。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030421
					],
					"speakerTitle": "茂才公"
				},
				{
					"id": 120030421,
					"content": "这明明不是什么稀有矿物，却一下子断了货，你们这是存心针对我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030422
					],
					"speakerTitle": "茂才公"
				},
				{
					"id": 120030422,
					"content": "并非针对，只是报恩而已。路见不平拔刀相助，再正常不过了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030423
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030423,
					"content": "我记得是你们的人说的吧，这件事不会就这么完了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030424
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030424,
					"content": "哼，真不知好歹，那我也不废话了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030425
					],
					"speakerTitle": "茂才公"
				},
				{
					"id": 120030425,
					"content": "大人，靠你了，把这里的石珀全部抢走！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "茂才公"
				},
				{
					"id": 120030409,
					"content": "书的结局好看吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030410
					]
				},
				{
					"id": 120030410,
					"content": "挺不错的…希望这边的结局也能合乎我的期待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030411
					],
					"speakerTitle": "行秋"
				}
			]
		},
		{
			"id": 1200306,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
