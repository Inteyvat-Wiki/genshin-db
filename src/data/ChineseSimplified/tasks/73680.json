				"points": []
			},
			"dialogs": [
				{
					"id": 736800101,
					"content": "你们好，欢迎参加归风佳酿节，愿巴巴托斯大人祝福你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736800102
					],
					"speakerTitle": "安内特"
				},
				{
					"id": 736800102,
					"content": "#咦，{NICKNAME}，你看，这里立着一块公告板，上面还贴了不少纸片，难道说是有什么委托吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736800103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736800103,
					"content": "呵呵，并不是委托哦，这些都是寻找「丰饶之箱」的线索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736800104
					],
					"speakerTitle": "安内特"
				},
				{
					"id": 736800104,
					"content": "什么什么，「丰饶之箱」？是什么宝物吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736800105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736800105,
					"content": "唔，这么理解倒也没错啦。看起来你们是第一次参加佳酿节，如果有兴趣的话，我来稍微讲解一下怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736800106,
						736800107
					],
					"speakerTitle": "安内特"
				},
				{
					"id": 736800106,
					"content": "既然派蒙这么感兴趣…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736800108
					]
				},
				{
					"id": 736800108,
					"content": "好的。简单来说，「丰饶之箱」是蒙德居民在佳酿节期间，为幸运的陌生人准备的礼物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736800109
					],
					"speakerTitle": "安内特"
				},
				{
					"id": 736800109,
					"content": "因为佳酿节不仅是迎接巴巴托斯大人归来的节日，也是大家共同分享丰收喜悦，回顾美好往事的节日。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736800110
					],
					"speakerTitle": "安内特"
				},
				{
					"id": 736800110,
					"content": "大家会把礼物放在橡木桶造型的木箱中，藏在某个对自己来说充满回忆的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736800111
					],
					"speakerTitle": "安内特"
				},
				{
					"id": 736800111,
					"content": "接下来，礼物的主人会留下线索，无论是谁，只要能最先找到箱子，就能获得礼物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736800112
					],
					"speakerTitle": "安内特"
				},
				{
					"id": 736800112,
					"content": "除了礼物，大家还会在箱子里留下给找到礼物人的赠言。这份诚挚的祝福，往往比礼物本身要更有价值呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736800113
					],
					"speakerTitle": "安内特"
				},
				{
					"id": 736800113,
					"content": "听起来好像挺有意思的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736800114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736800114,
					"content": "怎么样，二位要来试试寻找「丰饶之箱」吗？只要对蒙德的风土人情有一定了解，应该能很容易破解线索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736800115
					],
					"speakerTitle": "安内特"
				},
				{
					"id": 736800115,
					"content": "#{NICKNAME}，那我们就来试试吧，说不定还能找到我们认识的人留下的礼物呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736800116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736800116,
					"content": "祝二位好运，在佳酿节玩得开心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安内特"
				},
				{
					"id": 736800107,
					"content": "那就拜托你了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736800108
					]
				}
			]
		}
	]
}