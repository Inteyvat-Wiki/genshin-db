						220010402
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220010402,
					"content": "找到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010403
					]
				},
				{
					"id": 220010403,
					"content": "你…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010404
					],
					"speakerTitle": "阿飞"
				},
				{
					"id": 220010404,
					"content": "你…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010405
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 220010405,
					"content": "你们别吵了，吵了这么久不累吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010406
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220010406,
					"content": "只是玩个游戏，别这么生气，大家都是朋友呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010407
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220010407,
					"content": "喏，新摘的莲蓬，快点吃吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010408
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220010408,
					"content": "吃完了之后，我们再好好商量一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010409
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220010409,
					"content": "排好谁做船长，谁做服务员的顺序，不就好了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010410
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220010410,
					"content": "好吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010411
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 220010411,
					"content": "嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010412
					],
					"speakerTitle": "阿飞"
				},
				{
					"id": 220010412,
					"content": "真的安静下来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220010413,
					"content": "怎么样，我就说吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010414,
						220010416
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220010414,
					"content": "你怎么知道要这么做？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010415
					]
				},
				{
					"id": 220010415,
					"content": "我们一起玩了很久，我当然知道啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220010416,
					"content": "璐璐真厉害…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010417
					]
				},
				{
					"id": 220010417,
					"content": "#谢谢{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，北斗姐姐才厉害呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010418
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220010418,
					"content": "我长大之后，也能成为她那样的人吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "璐璐"
				}
			]
