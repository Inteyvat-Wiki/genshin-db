				"points": []
			},
			"dialogs": [
				{
					"id": 220010101,
					"content": "小蒙，今天总轮到我做船长了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010102
					],
					"speakerTitle": "阿飞"
				},
				{
					"id": 220010102,
					"content": "璐璐，我已经连着好几天做船长了，也该阿飞扮了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010103
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 220010103,
					"content": "可我觉得小蒙的船长扮得很好呀，我想你接着做船长。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010104
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220010104,
					"content": "你们在做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010105
					]
				},
				{
					"id": 220010105,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，我们在玩游戏。本来说好了这次轮到我做船长…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010106
					],
					"speakerTitle": "阿飞"
				},
				{
					"id": 220010106,
					"content": "可璐璐总是说，小蒙扮船长的时候更好玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010107
					],
					"speakerTitle": "阿飞"
				},
				{
					"id": 220010107,
					"content": "唉，璐璐总是这样…不过，她觉得这样好的话，那就这样吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010108
					],
					"speakerTitle": "阿飞"
				},
				{
					"id": 220010108,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，你有空再扮一次海盗吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010109,
						220010111
					],
					"speakerTitle": "阿飞"
				},
				{
					"id": 220010109,
					"content": "好吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010110
					]
				},
				{
					"id": 220010110,
					"content": "结果，我这次还是个服务生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010113
					],
					"speakerTitle": "阿飞"
				},
				{
					"id": 220010113,
					"content": "#就和上次一样，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}准备好了之后，就过来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿飞"
				},
				{
					"id": 220010111,
					"content": "我想做个好人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010112
					]
				},
				{
					"id": 220010112,
					"content": "哎呀，我还想做船长呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010113
					],
					"speakerTitle": "阿飞"
				}
			]
		},
		{
			"id": 2200102,
