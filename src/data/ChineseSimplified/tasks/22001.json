			"trigger": {
				"objectNames": [
					"小蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220010301,
					"content": "#就是这！船长在这了，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010302
					],
					"speakerTitle": "阿飞"
				},
				{
					"id": 220010302,
					"content": "你怎么把海盗带过来了啊！你不是应该带着海盗到处绕圈，然后我带着璐璐跑掉吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010303
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 220010303,
					"content": "凭什么你陪着璐璐跑，我就要在这拖住海盗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010304
					],
					"speakerTitle": "阿飞"
				},
				{
					"id": 220010304,
					"content": "那我直接把你交给海盗，我不是一样可以带着璐璐跑吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010305
					],
					"speakerTitle": "阿飞"
				},
				{
					"id": 220010305,
					"content": "你…北斗姐姐说了，不可以随便出卖朋友！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010306
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 220010306,
					"content": "那北斗姐姐说船长就应该带着人跑吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010307
					],
					"speakerTitle": "阿飞"
				},
				{
					"id": 220010307,
					"content": "你…我再也不把莲蓬分给你吃了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010308
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 220010308,
					"content": "不吃就不吃！谁稀罕似的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010309
					],
					"speakerTitle": "阿飞"
				},
				{
					"id": 220010309,
					"content": "他们怎么就吵起来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220010310,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，不用担心，我有办法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010311
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220010311,
					"content": "他们最喜欢吃莲蓬了，有好吃的东西，他们绝对会安静下来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010312
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220010312,
					"content": "你能帮我去找点莲蓬回来吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010313,
						220010315
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220010313,
					"content": "好的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010314
					]
				},
				{
					"id": 220010314,
					"content": "#谢谢{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，请快去快回呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220010315,
					"content": "他们最喜欢的应该不是莲蓬…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010316
					]
				},
				{
					"id": 220010316,
					"content": "#唔…{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}在说什么呢？那他们最喜欢什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010317
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220010317,
					"content": "总之，请先找点莲蓬来吧，总不能让他们总是这么吵呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "璐璐"
				}
			]
		},
