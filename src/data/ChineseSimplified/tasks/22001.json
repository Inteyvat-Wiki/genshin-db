			"dialogs": [
				{
					"id": 220010401,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，你找到莲蓬了吗？",
					"roleType": "TALK_ROLE_NPC",
