			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7166901",
							"2"
						],
						"stepId": 7166901,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"振尘"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716690101,
					"content": "#{NICKNAME}，听工作人员们说，所有安装了发讯装置的小动物都被你找到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690102
					],
					"speakerTitle": "振尘"
				},
				{
					"id": 716690102,
					"content": "有点意外啊，有些动物天性敏感，在陌生生物靠近时会立刻逃走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690103
					],
					"speakerTitle": "振尘"
				},
				{
					"id": 716690103,
					"content": "但它们并不排斥你的接近，真是奇事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690104,
						716690105
					],
					"speakerTitle": "振尘"
				},
				{
					"id": 716690104,
					"content": "因为我是动物之友。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716690106
					]
				},
				{
					"id": 716690106,
					"content": "哈哈，你这能力很让人嫉妒啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690107
					],
					"speakerTitle": "振尘"
				},
				{
					"id": 716690107,
					"content": "之前好几次，工作人员陪着我一起去给动物喂食的时候，我不是被吼就是挨咬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690112
					],
					"speakerTitle": "振尘"
				},
				{
					"id": 716690112,
					"content": "胳膊上留了好几道疤，还挺疼的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690113
					],
					"speakerTitle": "振尘"
				},
				{
					"id": 716690113,
					"content": "不过呢，虽然它们对我一点都不亲近，但能看到这些可爱的生灵好好地活着，我就觉得很满足了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690114
					],
					"speakerTitle": "振尘"
				},
				{
					"id": 716690114,
					"content": "对所有认养人来说也是这样，大家都希望在不惊扰到动物们的前提下，保护好它们的生存环境。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690115
					],
					"speakerTitle": "振尘"
				},
				{
					"id": 716690115,
					"content": "我知道对许多冒险家来说，野生动物是重要的食物来源，我们也并不会要求「伴爪同行」的成员完全不杀生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690116
					],
					"speakerTitle": "振尘"
				},
				{
					"id": 716690116,
					"content": "我们提倡的原则是不滥杀滥捕，如果每个人都能做到这一点，我们身边的环境一定会变得更丰富更美好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690117
					],
					"speakerTitle": "振尘"
				},
				{
					"id": 716690117,
					"content": "#作为我们的成员，如果{NICKNAME}你也能认同并接受这个原则就太好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690118,
						716690120
					],
					"speakerTitle": "振尘"
				},
				{
					"id": 716690118,
					"content": "我认同。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716690119
					]
				},
				{
					"id": 716690119,
					"content": "我就知道，像你这样通情达理的人一定会认同我们的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690122
					],
					"speakerTitle": "振尘"
				},
				{
					"id": 716690122,
					"content": "能带给别人思考，就已经是成功。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690123
					],
					"speakerTitle": "振尘"
				},
				{
					"id": 716690123,
					"content": "有机会的话，希望能在下一次「伴爪同行」的活动里见到你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690124
					],
					"speakerTitle": "振尘"
				},
				{
					"id": 716690124,
					"content": "希望到那个时候，我胳膊上不会增加新伤疤哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "振尘"
				},
				{
					"id": 716690120,
					"content": "我保留意见。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716690121
					]
				},
				{
					"id": 716690121,
					"content": "没关系，我们并不强求所有人都接受，但我个人希望所有人在杀生前想一想这件事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690122
					],
					"speakerTitle": "振尘"
				},
				{
					"id": 716690105,
					"content": "这是冒险家的天赋。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716690106
					]
				}
			]
		},
