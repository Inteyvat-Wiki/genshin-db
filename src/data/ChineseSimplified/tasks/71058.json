				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"卡塔琳娜",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710580201,
					"content": "谢谢…不论如何，我很开心你没有趁机在我背后捅刀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580202,
						710580203
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710580202,
					"content": "这是我要说的话才对。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580204
					]
				},
				{
					"id": 710580204,
					"content": "噗…虽然不知道你对愚人众有何成见，但在这种地方搭话可一点也不浪漫…有什么话就请来我的藏身点一叙吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580207
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710580207,
					"content": "卡塔琳娜离开了。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710580205
					]
				},
				{
					"id": 710580205,
					"content": "欸？她可是愚人众呀，我们就这样把她放走了吗？不把她交给千岩军吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710580206,
					"content": "哼…我知道啦，算啦，反正她也没有伤到我们，就当是饶她一命好啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710580203,
					"content": "愚人众对别人都是如此疑心病吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580204
					]
				}
			]
		},
		{
			"id": 7105805,
			"completionStepIds": [
				7105806
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105806",
							"2"
						],
						"stepId": 7105806,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"卡塔琳娜",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710580501,
					"content": "你们两个果然来了，请找个地方休息一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580502
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710580502,
					"content": "我这里还有些嗯…红茶，没有了…砂糖，也没了…嗯，牛奶，呕——酸掉了，我稍后丢掉好了…真是不好意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580503
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710580503,
					"content": "不过火水还多得是…也有硬饼干做茶点，还有点酸果酱…嗯，足够开个茶会了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580504
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710580504,
					"content": "哇啊…！你们都用火水开茶会吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710580505,
					"content": "对啊，很奇怪吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580506,
						710580508
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710580506,
					"content": "唔…还是不了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580507
					]
				},
				{
					"id": 710580507,
					"content": "怎么？嘿嘿，在这里是没有人管你喝酒的。不要拘谨啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580510,
						710580511
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710580510,
					"content": "你这是在做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580512
					]
				},
				{
					"id": 710580512,
					"content": "「恰到好处地分享食物和情报，可以堵住询问者的嘴。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580513
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710580513,
					"content": "…我们的手册是这么说的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580514
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710580514,
					"content": "可是情报呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580515
					]
				},
				{
					"id": 710580515,
					"content": "嗯？刚刚那就是呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580516
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710580516,
					"content": "什么呀…你刚刚说了什么吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580517
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710580517,
					"content": "「《愚人众先遣部队训练手册》附录4-4，第32条：恰到好处地分享食物和情报，可以堵住询问者的嘴。」喏？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580518
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710580518,
					"content": "为了报答救命之恩，我甚至透露了机密的训练手册内容！哼哼，诚意如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580519
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710580519,
					"content": "告诉我们那个有什么用啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580520
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710580520,
					"content": "呵呵，不和你们开玩笑了…说真的，非常感谢你们的帮助，请不要过度解读了我的好意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580521
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710580521,
					"content": "唔…鉴于你们之前做的那些坏事，还真不好相信愚人众会有好意呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580522
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710580522,
					"content": "你有什么图谋？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580523
					]
				},
				{
					"id": 710580523,
					"content": "外人无法理解愚人众的理念，并不出我意料。不过在不聊什么理念呀、立场呀之类问题的时候，我们也是些普通人嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580524
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710580524,
					"content": "…况且，我们的一切行为，不论目的如何，都不过是在为最终的决战做准备而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580525
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710580525,
					"content": "最终的决战…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580526
					]
				},
				{
					"id": 710580526,
					"content": "嗯，我们最终要面对的是共同的大敌，和无可逃脱的长夜…至冬国的国民都接受了这样的警告。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580527
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710580527,
					"content": "所以，为了这个冷酷的世界，人类流下的每一滴泪水与鲜血…都不是没有意义。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580528
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710580528,
					"content": "干杯？哼，好吧，好吧，我自便…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580529,
						710580531
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710580529,
					"content": "你是在为恶行找借口吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580530
					]
				},
				{
					"id": 710580530,
					"content": "或许吧…不知道，不在乎。你想要解释，我给你理由…只不过是我的版本，可能不对你胃口。就这么简单。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580534
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710580534,
					"content": "唔…你们怎么突然正经聊起天来啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580535
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710580535,
					"content": "顺便，我已经自我介绍过了，但还不知道你们的名字呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580536,
						710580537
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710580536,
					"content": "#{NICKNAME}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580538
					]
				},
				{
					"id": 710580538,
					"content": "我是派蒙！你一定听说过！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580539
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710580539,
					"content": "哦哦！你们的名字…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580540
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710580540,
					"content": "哼，哼！怎么样？一定传遍了整个提瓦特大陆，对不对？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580541
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710580541,
