			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"卡塔琳娜",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710580101,
					"content": "咳咳…呼…等等，请先停手…！你是谁？为什么会在这里…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580102
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710580102,
					"content": "以及…为什么要攻击我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580103
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710580103,
					"content": "我们还想问你咧！谁让你在这里鬼鬼祟祟的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710580104,
					"content": "你是坏人，你先说。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580105
					]
				},
				{
					"id": 710580105,
					"content": "…卡塔琳娜，卡塔琳娜·雪奈茨芙娜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580106
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710580106,
					"content": "名字是我们最不值得保守的情报，我只能透露这些，抱歉啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580107
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710580107,
					"content": "唔…我们只是想问问情况而已，又没想拷问你啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710580108,
					"content": "抱歉、抱歉，这是我能透露的全部情报了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580109
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710580109,
					"content": "为什么愚人众会在这里活动？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580110
					]
				},
				{
					"id": 710580110,
					"content": "机密。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580111
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710580111,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580112
					]
				},
				{
					"id": 710580112,
					"content": "什么啦！你们这些神神秘秘的坏家伙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710580113,
					"content": "呵呵，对呀，我们就是这种坏家伙哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580114
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710580114,
					"content": "好了，好奇宝宝时间结束…我们有麻烦了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡塔琳娜"
				}
			]
		},
		{
			"id": 7105802,
			"completionStepIds": [
				7105804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
