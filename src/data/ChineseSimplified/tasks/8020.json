			"dialogs": [
				{
					"id": 80200101,
					"content": "等等，那个身影是…戴因斯雷布！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80200102,
					"content": "哦？是你们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200103
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200103,
					"content": "是你们的朋友吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200104
					],
					"speakerTitle": "阿托莎"
				},
				{
					"id": 80200104,
					"content": "那我先到村子里面确认一下村长爷爷他们的情况，回头见吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200105
					],
					"speakerTitle": "阿托莎"
				},
				{
					"id": 80200105,
					"content": "回头见，阿托莎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80200106,
					"content": "你这神出鬼没的家伙，每次都要像这样突然出现吓我们一跳才行嘛？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80200107,
					"content": "只要你们也在追迹「深渊」，那我们的路线总会交汇，与我个人的意志无关。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200108
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200108,
					"content": "那这么说，你是追着深渊教团来到这里的吗？而且看你刚刚还解决掉了一批深渊魔物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80200109,
					"content": "当然。嗯？莫非你们不是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200110,
						80200111
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200110,
					"content": "我也是察觉到了深渊教团的动向…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200112
					]
				},
				{
					"id": 80200112,
					"content": "不管怎样，就算再怎么迟钝，现在你也应该发现这个地方有蹊跷了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200113
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200113,
					"content": "深渊教团一定是在这附近筹备着些什么，或者更进一步…正在进行着什么计划。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200114
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200114,
					"content": "所以你觉得，附近丘丘人的躁动是深渊教团干的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80200115,
					"content": "事到如今，引发丘丘人骚动这种小事想必肯定不是他们的目的，最多应该是某些计划的「副产物」罢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200116
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200116,
					"content": "不过，这件事对维摩庄的影响还是存在的，我们最好先留下来保护这里一阵子比较好吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80200117,
					"content": "保护之余，更重要的是弄清楚深渊教团准备在这里搞什么名堂，这才是防止进一步悲剧的关键。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200118,
						80200119
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200118,
					"content": "针对这些情况，再问问村民们吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200120
					]
				},
				{
					"id": 80200120,
					"content": "我本来也没有回避问题的意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200121
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200121,
					"content": "放心…这次我们时间还充裕，可以好好聊聊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200119,
					"content": "除此之外…你也欠我很多「答案」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200120
					]
				},
				{
					"id": 80200111,
					"content": "我摊牌了，是刚才碰巧撞上的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200112
					]
				}
			]
		},
