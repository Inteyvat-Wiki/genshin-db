				]
			},
			"dialogs": [
				{
					"id": 80200201,
					"content": "欸，戴因？喂…戴因！你在这里发什么呆呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80200202,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200203
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200203,
					"content": "是遇到什么事了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80200204,
					"content": "怎么了，戴因？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200205
					]
				},
				{
					"id": 80200205,
					"content": "#{NICKNAME}，你们说的那个失踪者…是个什么样的人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200206
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200206,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80200207,
					"content": "大概二十岁出头的男青年吧，到底怎么了呀，戴因…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80200208,
					"content": "现在我的脑海里似乎凭空多了一些东西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200209
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200209,
					"content": "…是一段有关他的「记忆」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200210
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200210,
					"content": "什么…？会不会…会不会是我们昨天聊了太多有关他的事，所以你昨晚做了一个这样的梦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80200211,
					"content": "不，那不是梦，是今早我醒来以后忽然出现在脑海中的一段记忆…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200212
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200212,
					"content": "而且我很确定，我从未见过这个人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200213
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200213,
					"content": "那「记忆」的内容是什么呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200214
					]
				},
				{
					"id": 80200214,
					"content": "我记得，在那段回忆里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200215
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200215,
					"content": "…我把「世界上第一颗耕地机的眼睛」送给了他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200216
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200216,
					"content": "！？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200217
					]
				},
				{
					"id": 80200217,
					"content": "啊！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80200218,
					"content": "…所以现在可以确定，那个失踪者与深渊教团有关联了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80200219,
					"content": "嗯，而且那个家伙，应该拥有往人们的脑海中「投放」记忆的能力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200220
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200220,
					"content": "究竟是如何做到的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200221
					]
				},
				{
					"id": 80200221,
					"content": "那要是这么说的话，维摩庄的大家会不会也只是被投放了虚假的记忆？原本大家应该不认识他…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80200222,
					"content": "可这样做的目的又是什么呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80200223,
					"content": "今早的这件事，对深渊教团来说，其实也暴露了一个事实。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200224
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200224,
					"content": "暴露了什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80200225,
					"content": "他们的目标…依旧是「世界上第一颗耕地机的眼睛」，并没有把寻找它的事情抛在脑后。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200226
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200226,
					"content": "给我投放这样的一段记忆，想必是为了扰乱唯一知道「眼睛」下落的我的思维…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200227,
						80200228
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200227,
					"content": "那「眼睛」现在还安全吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200229
					]
				},
				{
					"id": 80200229,
					"content": "你的担忧并不是没有道理，尽管我认为深渊教团应该还没有能力让那段记忆变成现实…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200230
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200230,
					"content": "但考虑到他们对「眼睛」的执着程度，我们也应该拿出对等程度的谨慎才稳妥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200231
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200231,
					"content": "和我一起去确认一下吧，「眼睛」是否还在我们手中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200232
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200232,
					"content": "是要到你藏「眼睛」的地方去吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200233
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80200233,
					"content": "（…可是，如果我们就这样过去的话，万一被跟踪，岂不是反而暴露了隐藏位置？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200234
					]
				},
				{
					"id": 80200234,
					"content": "（也或许，这原本就是深渊教团投放那段记忆给戴因的目的？引起他的疑心，让他产生再次确认的想法…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200235
					]
				},
				{
					"id": 80200235,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200236
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200236,
					"content": "（根据我对戴因的了解，他不可能没意识到这一点…看他的样子，应该是有别的想法…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200237,
						80200238
					]
				},
				{
					"id": 80200237,
					"content": "那我们走吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200239
					]
				},
				{
					"id": 80200239,
					"content": "…嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200238,
					"content": "你带路，戴因。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200239
					]
				},
				{
					"id": 80200228,
					"content": "有没有可能，「记忆」是真的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200229
					]
				}
			]
		},
