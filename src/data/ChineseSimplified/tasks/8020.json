			"dialogs": [
				{
					"id": 80200601,
					"content": "和我预想得一样，「虚假的记忆」果然是个陷阱，深渊教团真的跟着我们来到了这里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200602
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200602,
					"content": "这样一来，也就有机会见到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200603
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200603,
					"content": "唔…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200604
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200604,
					"content": "戴因？你突然怎么了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80200605,
					"content": "感受到了么？是地脉的扰动，深渊教团又在捣什么鬼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200606
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200606,
					"content": "你的体质还真是敏感，我好像没什么感觉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200607
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80200607,
					"content": "#{NICKNAME}，你们先用那边的机关离开吧，按我说的做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200608
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200608,
					"content": "留你一个人在这里，真的没关系吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200609
					]
				},
				{
					"id": 80200609,
					"content": "深渊教团正在行动，现在回维摩庄的话，或许有机会抓到那个「失踪者」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200610
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200610,
					"content": "…也可以当做是兵分两路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200611
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200611,
					"content": "嗯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200612
					]
				},
				{
					"id": 80200612,
					"content": "（道理应该是这样没错…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200613
					]
				},
				{
					"id": 80200613,
					"content": "（但总觉得好像哪里有些「违和」…是我漏掉了什么事情吗？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200614
					]
				},
				{
					"id": 80200614,
					"content": "哼…我就知道，除非主动踏入你们的陷阱，不然你是不可能来面见我的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200615
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200615,
					"content": "你将自己与「耕地机的眼睛」都作为赌注…",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80200616
					]
				},
				{
					"id": 80200616,
					"content": "赌注如此之大，禁不住诱惑而踏入陷阱的，应该是我才对吧，「末光之剑」戴因斯雷布？",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80200617
					]
				},
				{
					"id": 80200617,
					"content": "你一个人来的？你的那些信徒们呢，怎么没带在身边？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200618
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200618,
					"content": "在有所防备的「末光之剑」面前，投入多少兵力都是一种无谓的浪费，还不如由我一人来直面你。",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80200619
					]
				},
				{
					"id": 80200619,
					"content": "我知道你有很多话想说…",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80200620
					]
				},
				{
					"id": 80200620,
					"content": "…但在那之前，先击败我，如何？",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": []
				}
			]
		},
