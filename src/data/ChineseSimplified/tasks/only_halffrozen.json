			"dialogs": [
				{
					"id": 205200101,
					"content": "旅…旅行者…你…能…能不能帮帮我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200102
					],
					"speakerTitle": "汤米"
				},
				{
					"id": 205200102,
					"content": "你这是怎么了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205200103
					]
				},
				{
					"id": 205200103,
					"content": "拜…拜托你，先帮我找个热源来…我…实在是太冷了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200104
					],
					"speakerTitle": "汤米"
				},
				{
					"id": 205200104,
					"content": "或，或者…你帮我找点热菜来也行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200105
					],
					"speakerTitle": "汤米"
				},
				{
					"id": 205200105,
					"content": "拜…拜托了，我真的冷得受不了了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "汤米"
				}
			]
		},
