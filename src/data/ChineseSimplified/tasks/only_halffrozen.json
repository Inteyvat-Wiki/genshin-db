						205200502
					],
					"speakerTitle": "汤米"
				},
				{
					"id": 205200502,
					"content": "找到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205200503
					]
				},
				{
					"id": 205200503,
					"content": "太好了，这就是「冷鲜肉」吗？但是除了摸起来冷冰冰的，好像也没什么不同…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200504
					],
					"speakerTitle": "汤米"
				},
				{
					"id": 205200504,
					"content": "算了，我只管完成委托就行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200505
					],
					"speakerTitle": "汤米"
				},
				{
					"id": 205200505,
					"content": "谢谢你旅行者，要不是你我就惨了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200506
					],
					"speakerTitle": "汤米"
				},
				{
					"id": 205200506,
					"content": "这些报酬请你一定要收下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "汤米"
				}
			]
		},
