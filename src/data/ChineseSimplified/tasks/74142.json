						],
						"pointId": 6836
					}
				]
			},
			"dialogs": [
				{
					"id": 741420401,
					"content": "#咦，{NICKNAME}{M#哥哥}{F#姐姐}…我们不是刚刚才见过面吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420402
					],
					"speakerTitle": "夏诺蒂拉"
				},
				{
					"id": 741420402,
					"content": "什么时候的事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420403
					]
				},
				{
					"id": 741420403,
					"content": "唔，我也说不准耶…毕竟，在这种地方根本不知道时间嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420404
					],
					"speakerTitle": "夏诺蒂拉"
				},
				{
					"id": 741420404,
					"content": "夏诺蒂拉，跟我走吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420405
					]
				},
				{
					"id": 741420405,
					"content": "这里很不正常。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420406
					]
				},
				{
					"id": 741420406,
					"content": "但是，正常与不正常，难道不是我们决定的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420407
					],
					"speakerTitle": "夏诺蒂拉"
				},
				{
					"id": 741420407,
					"content": "嗯…我也没有别的意思，但这里对我来说真的很好。这里充满生机与色彩，在那边的世界我从来没见过这样的景象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420408
					],
					"speakerTitle": "夏诺蒂拉"
				},
				{
					"id": 741420408,
					"content": "我只见到一朵向日葵…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420409
					]
				},
				{
					"id": 741420409,
					"content": "真的？哇！在什么地方？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420410
					],
					"speakerTitle": "夏诺蒂拉"
				},
				{
					"id": 741420410,
					"content": "之前我们遇到小狗的地方。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420411
					]
				},
				{
					"id": 741420411,
					"content": "喔！那我先出发啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420412
					],
					"speakerTitle": "夏诺蒂拉"
				},
				{
					"id": 741420412,
					"content": "等等…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
