				]
			},
			"dialogs": [
				{
					"id": 741421301,
					"content": "#呜呜…谢谢你，{NICKNAME}{M#哥哥}{F#姐姐}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421302
					],
					"speakerTitle": "夏诺蒂拉"
				},
				{
					"id": 741421302,
					"content": "发生什么事了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421303
					]
				},
				{
					"id": 741421303,
					"content": "我不知道…我只是想来看看开放的向日葵，还有可爱的小狗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421304
					],
					"speakerTitle": "夏诺蒂拉"
				},
				{
					"id": 741421304,
					"content": "但在路上，突然出现了一个很可怕的怪物追我。同时，天变得越来越黑…而且有很多不同的声音，说我听不懂的东西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421305
					],
					"speakerTitle": "夏诺蒂拉"
				},
				{
					"id": 741421305,
					"content": "我害怕极了，就跟着金色的光，一直往前跑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421306
					],
					"speakerTitle": "夏诺蒂拉"
				},
				{
					"id": 741421306,
					"content": "每当怪物接近我，整个世界就会变黑一点…花园、宫殿、大树和花朵都不见了，变得好阴暗，只剩下废墟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421307
					],
					"speakerTitle": "夏诺蒂拉"
				},
				{
					"id": 741421307,
					"content": "然后，怪物追上我…呜呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421308
					],
					"speakerTitle": "夏诺蒂拉"
				},
				{
					"id": 741421308,
					"content": "已经不用担心了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421309
					]
				},
				{
					"id": 741421309,
					"content": "「小狗」，把她送回去吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421310
					]
				},
				{
					"id": 741421310,
					"content": "小姐，别再来了。这里什么也没有，而外面还有一整个属于你的世界呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421311
					]
				},
				{
					"id": 741421311,
					"content": "咦？你就是小狗吗…但是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421312
					],
					"speakerTitle": "夏诺蒂拉"
				},
				{
					"id": 741421312,
					"content": "…我们还能再见面吗？这个世界还能变成美丽的花园吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421313
					],
					"speakerTitle": "夏诺蒂拉"
				},
				{
					"id": 741421313,
					"content": "不会的。再见了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421314
					]
				},
				{
					"id": 741421314,
					"content": "还有你。我再问你一次，我在你眼里，到底是什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421315
					]
				},
				{
					"id": 741421315,
					"content": "狗。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421316
					]
				},
				{
					"id": 741421316,
					"content": "嗯，那就好。你已经赶走了不应该来到这里的人物，多亏了你，这个世界的崩解也停下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421317
					]
				},
				{
					"id": 741421317,
					"content": "但继续待在这里也是不明智的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421318,
						741421320
					]
				},
				{
					"id": 741421318,
					"content": "我想也是。把我送回去吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421319
					]
				},
				{
					"id": 741421319,
					"content": "你很明智。那么别了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": []
				},
				{
					"id": 741421320,
					"content": "到底是怎么回事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421321
					]
				},
				{
					"id": 741421321,
					"content": "原本这里已经要彻底瓦解了。不该来到这里的人物到了这里，撼动了这个世界的根基。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421322
					]
				},
				{
					"id": 741421322,
					"content": "我所看到的现象，就是这么来的吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421323
					]
				},
				{
					"id": 741421323,
					"content": "我不可能知道你体验过什么，毕竟我不是你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421324
					]
				},
				{
					"id": 741421324,
					"content": "那你又是谁？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421325
					]
				},
				{
					"id": 741421325,
					"content": "…我是谁并不重要。重要的是这个妄想世界的主人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421326
					]
				},
				{
					"id": 741421326,
					"content": "他们相信他们能拯救世界，却不知道这个世界是否需要被拯救。或许他们记忆中的世界只不过是永远失去的向日葵盛开的午后。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421327
					]
				},
				{
					"id": 741421327,
					"content": "但那些是他们的故事，不是我的故事。我只是他们对一位朋友的记忆。他们曾相信他们能拯救我，但最终…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421328
					]
				},
				{
					"id": 741421328,
					"content": "蝶而化茧，茧破而幼虫出，最后幼虫走向未曾诞生的虚无。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421329
					]
				},
				{
					"id": 741421329,
					"content": "不过这些都无所谓，因为现在的我已经什么都不剩下了。我只是他们的记忆中，对于「拯救我」这件事的执着所留下的影子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421330
					]
				},
				{
					"id": 741421330,
					"content": "但我也不会因此记恨他们，因为即使他们随着割舍而变化，这个记忆与妄想所构成的世界当中的我，仍然证明了他们的执着。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421331
					]
				},
				{
					"id": 741421331,
					"content": "作为曾经的朋友，我很满足。无论我变成什么模样，我都会永远感念过去一起的友谊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421332
					]
				},
				{
					"id": 741421332,
					"content": "好了，就说到这吧。你也感受到了这里对你的影响吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421333
					]
				},
				{
					"id": 741421333,
					"content": "别了。你和我不会再见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": []
				}
			]
		},
