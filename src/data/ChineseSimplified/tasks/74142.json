						],
						"pointId": 6837
					}
				]
			},
			"dialogs": [
				{
					"id": 741420701,
					"content": "#啊！是{NICKNAME}{M#哥哥}{F#姐姐}。咦，派蒙没和你一起吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420702
					],
					"speakerTitle": "夏诺蒂拉"
				},
				{
					"id": 741420702,
					"content": "那个裂隙…你在看什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420703
					]
				},
				{
					"id": 741420703,
					"content": "咦？什么裂隙呀，这不是镜子吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420704
					],
					"speakerTitle": "夏诺蒂拉"
				},
				{
					"id": 741420704,
					"content": "唔，这么说来，我确实有在找的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420705
					],
					"speakerTitle": "夏诺蒂拉"
				},
				{
					"id": 741420705,
					"content": "我一直在找「谜镜」的线索…应该是像画一样的东西，和「揭示之书」一样，也能够让人「冥想」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420706
					],
					"speakerTitle": "夏诺蒂拉"
				},
				{
					"id": 741420706,
					"content": "关于四象限与格式塔的「画」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420707
					]
				},
				{
					"id": 741420707,
					"content": "#…是喔，原来在那样的地方。嗯！谢谢{NICKNAME}{M#哥哥}{F#姐姐}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夏诺蒂拉"
				}
			]
		},
