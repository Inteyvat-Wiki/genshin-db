				"points": []
			},
			"dialogs": [
				{
					"id": 140180901,
					"content": "看来是我多虑了，我也要赶紧振作起来，变得更加可靠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180902
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140180902,
					"content": "回想起来，今天这副样子真是有点丢脸，哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180903,
						140180907,
						140180912
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140180903,
					"content": "关于众人的礼物…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140180904
					]
				},
				{
					"id": 140180904,
					"content": "每个人应该都有对别人来说稀松平常，但自己无论如何都得不到的东西吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180905
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140180905,
					"content": "对我来说，全家福就是这样的东西，从小我就很羡慕别人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180906
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140180906,
					"content": "没想到会以这样的形式收到，看来有时候我也挺幸运的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140180907,
					"content": "关于克莱门汀…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140180908
					]
				},
				{
					"id": 140180908,
					"content": "我以前就在想，我母亲希望我能开心地活下去，这其实也是个很高的期望…甚至不亚于我老爹施加给我的那些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180909
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140180909,
					"content": "这两个人虽然表现出来的性格全然不同，但心底始终都彼此认可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180910
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140180910,
					"content": "巡轨船是造福整个枫丹的大工程，以「家族」的眼光去衡量与评价未免有点狭隘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180911
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140180911,
					"content": "所以她才没有阻止我的老爹吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140180912,
					"content": "关于「我真的是你的搭档吗？」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140180913
					]
				},
				{
					"id": 140180913,
					"content": "呜哇，你学我干什么！不要这样，不要再说下去了！很难为情的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180914
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140180914,
					"content": "赶紧忘掉，赶紧忘掉！啊，不对，忘掉也不行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180915
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140180915,
					"content": "总之，藏在心里，不要再翻出来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "娜维娅"
				}
			]
		}
	]
}