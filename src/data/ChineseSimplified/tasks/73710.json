			"dialogs": [
				{
					"id": 737100101,
					"content": "♪~♪♪~♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100102
					],
					"speakerTitle": "咚咚小圆帽"
				},
				{
					"id": 737100102,
					"content": "♫♫~♫~♫♫~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100103
					],
					"speakerTitle": "欢腾之火"
				},
				{
					"id": 737100103,
					"content": "我们回来啦，海妮耶，左右加！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737100104,
					"content": "远远就听见「咚咚小圆帽」和「欢腾之火」欢乐的脚步声，看来你们这次确实玩了个痛快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100105
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737100105,
					"content": "这么远就能听出欢乐吗？我到现在都没法辨别蕈兽伙伴脚步声里传达的情绪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100106
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 737100106,
					"content": "看来我还是得多学啊…学无止境！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100107
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 737100107,
					"content": "欸嘿嘿，这次出游的感觉，确实很不一样！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737100108,
					"content": "带着蕈兽伙伴们玩了一圈，再回到「小小灵蕈乐园」附近，感觉和玩累了回家吃饭有点像。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737100109,
					"content": "不如，现在就一起合张影吧？我看《蒸汽鸟报》提到的许多知名游记，都把旅途的各种画片按时间连起来呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737100110,
					"content": "「白银伴星」这么一说，我才想起，这些年来和蕈兽伙伴们相处得理所当然，没怎么合过影…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100111
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737100111,
					"content": "嗯！两位大老板都很懂「完美收场」的仪式嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100112
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 737100112,
					"content": "♪♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100113
					],
					"speakerTitle": "咚咚小圆帽"
				},
				{
					"id": 737100113,
					"content": "♫♫~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100114
					],
					"speakerTitle": "欢腾之火"
				},
				{
					"id": 737100114,
					"content": "好哦，那就用「咚咚小圆帽」的这个相机，加上支架，来张定时合照！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737100115,
					"content": "等到海妮耶和左右加不那么忙了，我们还要一起，像这样开心地出去玩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100147
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737100147,
					"content": "好耶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737100116,
					"content": "说起来，「咚咚小圆帽」拍照的天赋很厉害哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737100117,
					"content": "我挑了几张拍得不错的，就和我们的合照放在一起，海妮耶和左右加也可以看看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100118,
						737100119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737100118,
					"content": "居然全都考虑好了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100120
					]
				},
				{
					"id": 737100120,
					"content": "还有还有…来，海妮耶和左右加，我给你们带了纪念品——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737100121,
					"content": "是你们之前没吃到的马卡龙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737100122,
					"content": "咦！我只是随口一说，你居然记住了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100123
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 737100123,
					"content": "「白银伴星」…令人感动…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100124
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737100124,
					"content": "为了以后不再这么麻烦你，我必须改掉毛病，出游前做好万全的规划…并且不能停留在纸面上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100125
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737100125,
					"content": "好朋友放松闲聊时候，随口说的事情，也能反映心里的真实想法嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100126,
						737100127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737100126,
					"content": "什么时候买的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100128
					]
				},
				{
					"id": 737100128,
					"content": "在枫丹廷拍照的那会儿啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737100129,
					"content": "你陪着「咚咚小圆帽」关注眼前景色的时候，我找了个报童帮忙，给了她一些跑腿费。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737100130,
					"content": "放心，你的那份我当然也有准备啦，怎么会忘了你呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737100131,
					"content": "我有好好叮嘱过报童说，进店后，第一个就去找你最爱吃的口味哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737100132,
					"content": "不过我们早就吃遍了枫丹廷的甜点，应该没什么新鲜感…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100133,
						737100134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737100133,
					"content": "只要是派蒙买的甜点，就好吃！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100135
					]
				},
				{
					"id": 737100135,
					"content": "真的吗？嘿嘿…那我以后多多给你买！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100136
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737100136,
					"content": "可惜没有专门给蕈兽伙伴们吃的甜点…要是能抱着蕈兽伙伴，一起享用桌上满满的美食，得有多好啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100137
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737100137,
					"content": "这方面不用担心，我在完善的《蕈兽族群综论》中，就有从底层研究蕈兽爱吃的食物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100138
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737100138,
					"content": "目标是找出蕈兽和人类共通的食材，让伙伴们不用一年到头都吃各种口味的「妙妙琼脂」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100139
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737100139,
					"content": "迟早有一天，我会找出兼顾人类和蕈兽味觉的食材，设计出双方共通的美味料理！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100140
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737100140,
					"content": "等到实践下厨，就由我来负责！以防海妮耶烧坏我们的第十一口锅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100141
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 737100141,
					"content": "这么听来，以后和蕈兽伙伴们坐成一圈聚餐的那天，不远了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100142,
						737100143
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737100142,
					"content": "就等海妮耶的好消息！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100144
					]
				},
				{
					"id": 737100144,
					"content": "那还请常回「小小灵蕈乐园」来看看，我们和各位蕈兽伙伴随时等着你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100145
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737100145,
					"content": "说不定，惊喜会比你们预想的来得更早呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100146
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 737100146,
					"content": "♪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "咚咚小圆帽"
				},
				{
					"id": 737100143,
					"content": "就等左右加的大餐了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100144
					]
				},
				{
					"id": 737100134,
					"content": "派蒙给我主动买的，可不一样！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100135
					]
				},
				{
					"id": 737100127,
					"content": "我都没有注意到…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100128
					]
				},
				{
					"id": 737100119,
					"content": "派蒙，周到！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100120
					]
				}
			]
		}
	]
}