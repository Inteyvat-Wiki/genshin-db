			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"九条裟罗",
					"八重神子",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20180201,
					"content": "八重宫司大人，我如约来了。请放心，我没带随从来，这次行程也不会有人知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180202
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 20180202,
					"content": "知道你会守约的，而且我猜…你这几天甚至会心烦意乱，夜不能寐吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180203
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20180203,
					"content": "我…我不会那样怀疑家主他们的，您过度揣测了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180204
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 20180204,
					"content": "那么，我要的证据在哪里？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180205
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 20180205,
					"content": "在这里。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180206
					]
				},
				{
					"id": 20180206,
					"content": "哦~另一个守约的人也来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180207
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20180207,
					"content": "为了拿到这些，可费了我们一番功夫呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20180208,
					"content": "交给裟罗看看吧，让她自己评判。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180209
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20180209,
					"content": "这是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180210
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 20180210,
					"content": "…这上面确实印有家主的官印，不像是造假…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180211
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 20180211,
					"content": "反抗军，珊瑚宫，前线的事，居然只字未提…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180212
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 20180212,
					"content": "前线那些阵亡的将士，人民在此间经受的困苦，全都不值一提吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180213
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 20180213,
					"content": "也太小看人命了吧，究竟为何要如此隐瞒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180214
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 20180214,
					"content": "当然是为了让眼狩令顺利推行，不然把这些写进去的话，将军反悔了可怎么办呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180215
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20180215,
					"content": "天领奉行…果然在刻意蒙蔽将军吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180216
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 20180216,
					"content": "是呢，再想想，眼狩令的推行…对谁更有利呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180217
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20180217,
					"content": "这里还有一封密信。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180218
					]
				},
				{
					"id": 20180218,
					"content": "是天领奉行与愚人众的来往书信哦，还是被九条家的家主刻意藏起来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20180219,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180220
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 20180220,
					"content": "如何？你想看到的东西，你不想看到的东西，这样一来都摆在你面前了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180221
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20180221,
					"content": "该不会…你还想要逃避吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180222
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20180222,
					"content": "我迄今为止所坚持的一切岂不是…居然…他们居然…可恶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180223
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 20180223,
					"content": "背叛的行为不可饶恕…我要去和家主当面对质！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180224
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 20180224,
					"content": "九条裟罗真的很气愤呢，看样子策反成功了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180225,
						20180226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20180225,
					"content": "幕府军也会暂时群龙无首了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180227
					]
				},
				{
					"id": 20180227,
					"content": "嗯，我们去追她吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180228
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20180228,
					"content": "等一下，旅行者，我还有话想要和你说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180229
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20180229,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180230
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20180230,
					"content": "你第一次进入「一心净土」，是在千手百眼神像前吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180231
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20180231,
					"content": "没错。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180232
					]
				},
				{
					"id": 20180232,
					"content": "你要想办法，重现那天的情景。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180233
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20180233,
					"content": "在千手百眼神像前，再度让雷电将军「敞开心扉」的话，就一定有机会…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180234
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20180234,
					"content": "我会尽力。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180235
					]
				},
				{
					"id": 20180235,
					"content": "把这个带在身上吧，作为饯别的礼物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180236
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20180236,
					"content": "这是…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180237
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20180237,
					"content": "鸣神大社的御守，可从来都是很灵验的，我特意给你留了一个。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180238,
						20180239
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20180238,
					"content": "谢谢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180240
					]
				},
				{
					"id": 20180240,
					"content": "呵呵，遇到难解的危机的时候，就把它拿出来看看吧，危机或许就会迎刃而解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180241
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20180241,
					"content": "当然，想我的时候也可以拿出来哦？说不定我会忽然蹦出来见你呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180242
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20180242,
					"content": "这种关头就别拿旅行者寻开心啦，狐狸小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180243
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20180243,
					"content": "呵呵呵…不好意思，那么，我那位愚钝的朋友就拜托你们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20180239,
					"content": "我会珍惜。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180240
					]
				},
				{
					"id": 20180226,
					"content": "跟上她，应该有机会见到雷电将军。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180227
					]
				}
			]
		},
		{
			"id": 201803,
			"completionStepIds": [
				201805
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201805",
							"2"
						],
						"stepId": 201805,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"九条裟罗"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20180301,
					"content": "你们也跟来了么？胆量倒是不小。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180302
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 20180302,
					"content": "你们作为证人，在我向家主求证之前，姑且可以先保你们不被就地逮捕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180303
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 20180303,
					"content": "不过…若证实你们之前的所言皆是诽谤，那你们不仅走不了，还会另有罪名加身，明白吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180304,
						20180305
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 20180304,
					"content": "正合我意。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180306
					]
				},
				{
					"id": 20180306,
					"content": "哼，很好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 20180305,
					"content": "带路吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180306
					]
				}
			]
		},
		{
			"id": 201804,
			"completionStepIds": [
				201804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201804",
							"2"
						],
						"stepId": 201804,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"九条孝行",
					"九条裟罗",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20180403,
					"content": "住手！裟罗，你疯了吗！居然敢不顾我的禁令！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180404
					],
					"speakerTitle": "九条孝行"
				},
				{
					"id": 20180404,
					"content": "家主…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180405
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 20180405,
					"content": "问啊，别被他的气势给压制了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20180406,
					"content": "哼…孝行大人，我看过奉行府的上奏公文和写给愚人众的信件了，请您…给我一个交待！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180407
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 20180407,
					"content": "遗失的那些公文和信件，原来是被你拿走了么？哼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180408
					],
					"speakerTitle": "九条孝行"
				},
				{
					"id": 20180408,
					"content": "您的这句话，我可以理解为…那些果真都是出自您的手笔，而并非伪造么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180409
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 20180409,
					"content": "请您告诉我，家主，告诉我天领奉行…真的背叛了幕府吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180410
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 20180410,
					"content": "哼…我的确与愚人众有所往来，你所见过的公文也的确出自我之手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180411
					],
					"speakerTitle": "九条孝行"
				},
				{
					"id": 20180411,
					"content": "居然就这么承认了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20180412,
					"content": "只需要协助眼狩令的颁布和推行，就能拿到至冬使节承诺的那些好处…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180413
					],
					"speakerTitle": "九条孝行"
				},
				{
					"id": 20180413,
					"content": "一直以来，觊觎九条家地位的人那么多，想把我们拉下马的家系也数不胜数。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180414
					],
					"speakerTitle": "九条孝行"
				},
				{
					"id": 20180414,
					"content": "既能得到他国势力的大力支持，又可以借眼狩令削弱那些敌人的战力…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180415
					],
					"speakerTitle": "九条孝行"
				},
				{
					"id": 20180415,
					"content": "我认为是一笔划算的买卖，只不过没必要知会你而已，裟罗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180416
					],
					"speakerTitle": "九条孝行"
				},
				{
					"id": 20180416,
					"content": "你明明…明明一直都那么崇敬将军，为什么把背叛的事说得那么轻描淡写！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180417
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 20180417,
					"content": "背叛？这能算得上是背叛吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180418
					],
					"speakerTitle": "九条孝行"
				},
				{
					"id": 20180418,
					"content": "那些愚人众不过是反过来被我利用罢了，他们又能成什么事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180419
					],
					"speakerTitle": "九条孝行"
				},
				{
					"id": 20180419,
					"content": "在稻妻的国土上，一旦天雷落下，他们不过是些只会瑟瑟发抖的蝼蚁罢了，绝不敢造次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180420
					],
					"speakerTitle": "九条孝行"
				},
				{
					"id": 20180420,
					"content": "毕竟——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180421
					],
					"speakerTitle": "九条孝行"
				},
				{
					"id": 20180421,
					"content": "我们可拥有着天下无双的雷电将军，拥有着那「无想的一刀」啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180422,
						20180423
					],
					"speakerTitle": "九条孝行"
				},
				{
					"id": 20180422,
					"content": "并非蓄意背叛雷电将军…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180424
					]
				},
				{
					"id": 20180424,
					"content": "嗯…他崇拜的与其说是雷电将军，倒不如说是雷电将军的武艺以及「无想的一刀」吧？而且，已经近乎狂热了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180425
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20180425,
					"content": "可是，你的忠义之心呢，家主…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180426
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 20180426,
					"content": "自从被九条家收养以来，是你一直在教导我身为臣下的忠义之道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180427
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 20180427,
					"content": "如此看来，你们只是想我忠于九条家，担心我有朝一日会背叛而已吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180428
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 20180428,
					"content": "那些大道理，不过是你遮掩自己的丑恶与自私的工具！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180429
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 20180429,
					"content": "自私？我也是在守护着属于九条家的永恒啊，我相信将军大人她会理解我的，前家主大人他…也一定会理解我的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180430
					],
					"speakerTitle": "九条孝行"
				},
				{
					"id": 20180430,
					"content": "虽然不想这么说，但九条家也太自大了，愚人众恐怕没那么好对付…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180431,
						20180432
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20180431,
					"content": "继续和他辩论也没有意义了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180433
					]
				},
				{
					"id": 20180433,
					"content": "我也曾在内心怀疑过，执行眼狩令真的是正确的吗？哪怕违背我心中的道义也在所不惜吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180434
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 20180434,
					"content": "可我还是下定决心，只要那是将军所指引的道路，在走到终点之前，又有谁可论对与错呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180435
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 20180435,
					"content": "但直到现在我才知道，永恒之路本就没有终点，而且这条路…又早就因为你们的私心而沾满污秽了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180436
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 20180436,
					"content": "所以，我要去纠正圣听，至少给我迄今为止的决心一个交待！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180437
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 20180437,
					"content": "冥顽不灵，多此一举…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180438
					],
					"speakerTitle": "九条孝行"
				},
				{
					"id": 20180438,
					"content": "你要去便去吧，如今谁也别想动摇九条家的地位，时局也不会因你而有什么改变的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180439
					],
					"speakerTitle": "九条孝行"
				},
				{
					"id": 20180439,
					"content": "将军此时正在<color=#00E1FFFF>天守阁</color>，接见来自至冬的使节——那位被称为「女士」的执行官。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180440
					],
					"speakerTitle": "九条孝行"
				},
				{
					"id": 20180440,
					"content": "「女士」！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180441
					]
				},
				{
					"id": 20180441,
					"content": "稻妻幕后的始作俑者，又是「女士」吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180442
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20180442,
					"content": "早在离岛的时候，千里小姐似乎也提到过，勘定奉行跟一位趾高气昂的女士见过面…那时就应该猜到了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180443
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20180443,
					"content": "至冬的使节…正巧，她别以为自己可以从稻妻全身而退！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180444
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 20180444,
					"content": "裟罗冲出去了，是准备直接去闯天守阁吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180445
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20180445,
					"content": "我们也有很多账，要找「女士」清算。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180446
					]
				},
				{
					"id": 20180446,
					"content": "没错！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180447
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20180447,
					"content": "那走吧，我们也过去！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180448
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20180448,
					"content": "我们去<color=#00E1FFFF>天守阁</color>！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 20180432,
					"content": "还是要看九条裟罗的态度。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180433
					]
				},
				{
					"id": 20180423,
					"content": "而是过分相信雷电将军的武艺。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180424
					]
				}
			]
		},
