			"dialogs": [
				{
					"id": 706920101,
					"content": "哇哇，骑士小哥，你把我们的大英雄引过来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920102
					],
					"speakerTitle": "「狂图捕手」"
				},
				{
					"id": 706920102,
					"content": "是荣誉骑士前辈，还有白色小帮手！你们好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920103
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 706920103,
					"content": "米卡和…纳塔的朋友？你们在忙什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706920104,
					"content": "我们正在推广一种对冒险家团体很有帮助的「前哨龙龙」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920105
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 706920105,
					"content": "它结合了安柏前辈从须弥带回来的「侦察伙伴」机关核心，还有纳塔朋友们送我的小龙玩偶外形…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920106
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 706920106,
					"content": "伙伴机关…哦哦，我还有印象！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706920107,
					"content": "与须弥的「侦察伙伴」的功能类似，「前哨龙龙」可以帮忙侦察魔物，勘测地形。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920108
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 706920108,
					"content": "不过，由于重点放在后者，它更侧重行动的可控性和精准度…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920109
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 706920109,
					"content": "…荣誉骑士前辈有兴趣试飞一下吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920110,
						706920111
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 706920110,
					"content": "真是一本正经的介绍。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706920112
					]
				},
				{
					"id": 706920112,
					"content": "欸？是…是我太紧张了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920113
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 706920113,
					"content": "好像的确…明明之前基本放松下来，可以比较自然地面对你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920114
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 706920114,
					"content": "但最近从不少其他国家的朋友那里听说了你的事迹，感觉你越来越厉害，越来越了不起了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920115
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 706920115,
					"content": "一想到以后要帮上你的忙，不能拖你的后腿，下意识又绷紧了弦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920116
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 706920116,
					"content": "还真是米卡特有的逻辑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706920117,
					"content": "已经很不错了，骑士小哥！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920118
					],
					"speakerTitle": "「狂图捕手」"
				},
				{
					"id": 706920118,
					"content": "#在纳塔啊，部族里的战士要是碰见了{NICKNAME}，有的会激动到语无伦次，有的还会半个字都说不出来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920119
					],
					"speakerTitle": "「狂图捕手」"
				},
				{
					"id": 706920119,
					"content": "#你作为{NICKNAME}的同事，也能算得上传奇级高手，和我们的部族首领对话都不必虚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920120
					],
					"speakerTitle": "「狂图捕手」"
				},
				{
					"id": 706920120,
					"content": "没错没错，米卡要自信点！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706920121,
					"content": "原来还有这种事…这样的思考角度，我完全没想过…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920122
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 706920122,
					"content": "#总之，如果{NICKNAME}试飞过「前哨龙龙」后感到满意，这个可爱又可靠的辅助机关，肯定能造福更多冒险家团体！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920123,
						706920124
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 706920123,
					"content": "这个我在行！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706920125
					]
				},
				{
					"id": 706920125,
					"content": "好的！我这就调试好「前哨龙龙」，试飞很快就能开始！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "米卡"
				},
				{
					"id": 706920124,
					"content": "让我试试龙龙的性能！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706920125
					]
				},
				{
					"id": 706920111,
					"content": "可以不用这么正式的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706920112
					]
				}
			]
		}
	]
}