				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"迦雅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230175001,
					"content": "您好？唔…您想问什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175002
					],
					"speakerTitle": "迦雅"
				},
				{
					"id": 230175002,
					"content": "你是怎么和加尔恰认识的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230175003
					]
				},
				{
					"id": 230175003,
					"content": "问得这么直接？真像是一位冒险家做事的风格。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175004
					],
					"speakerTitle": "迦雅"
				},
				{
					"id": 230175004,
					"content": "我和加尔恰认识的契机…是因为他被我所在剧团的团长雇来梳理账目。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175005
					],
					"speakerTitle": "迦雅"
				},
				{
					"id": 230175005,
					"content": "哈哈哈，说实话，我从来没见过这样一个完全和剧团的氛围合不来的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175006
					],
					"speakerTitle": "迦雅"
				},
				{
					"id": 230175006,
					"content": "我们在奏乐，跳舞，喝酒，唱歌，而他只是和路通在一边沉默地计算。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175007
					],
					"speakerTitle": "迦雅"
				},
				{
					"id": 230175007,
					"content": "有一次，我发现他穿了一件很奇怪的衣服，那件衣服上好像画着什么图案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175008
					],
					"speakerTitle": "迦雅"
				},
				{
					"id": 230175008,
					"content": "我很好奇，就问他那些图案是什么，他说这些是一架机器的设计图。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175009
					],
					"speakerTitle": "迦雅"
				},
				{
					"id": 230175009,
					"content": "之所以会画在衣服上，是因为他有一次在外和人讨论那架机器的时候，突然找不到笔和纸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175010
					],
					"speakerTitle": "迦雅"
				},
				{
					"id": 230175010,
					"content": "所以他就直接用炭在自己的衣服上画示意图来讲解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175011
					],
					"speakerTitle": "迦雅"
				},
				{
					"id": 230175011,
					"content": "然后，我们就一直在讨论他这件没洗干净的衣服和那架机器…当然啦，大部分时间是他在说话，我在听。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175012
					],
					"speakerTitle": "迦雅"
				},
				{
					"id": 230175012,
					"content": "嘻嘻，他是个很奇怪的人，但同时嘛…也是一个别有魅力的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "迦雅"
				}
			]
		},
