	"talks": [
		{
			"id": 2301701,
			"completionStepIds": [
				2301701
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2301701",
							"2"
						],
						"stepId": 2301701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"加尔恰",
					"路通"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230170101,
					"content": "旅，旅行者！您来得正好，我正和迦雅喝完咖啡，准备回去继续工作呢。我为你介绍…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170102
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230170102,
					"content": "这就是你之前提到的人吗？很荣幸见到您，我是迦雅，一个…嗯…跳舞的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170104
					],
					"speakerTitle": "迦雅"
				},
				{
					"id": 230170104,
					"content": "你好，加尔恰之前提到过你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230170105
					]
				},
				{
					"id": 230170105,
					"content": "嘻嘻，是这样么？那样就最好了，我还以为他只会记得他的机器，还有路通呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170106
					],
					"speakerTitle": "迦雅"
				},
				{
					"id": 230170106,
					"content": "您大可把我排除在外，小姐，我相信加尔恰先生也乐见此事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170107
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230170107,
					"content": "那可不行，要是没了你，加尔恰一定会把最后一分钱也花光的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170108
					],
					"speakerTitle": "迦雅"
				},
				{
					"id": 230170108,
					"content": "这话我不敢苟同，小姐，我相信加尔恰先生无论如何都会留出两杯咖啡钱的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170109
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230170109,
					"content": "三杯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170110
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230170110,
					"content": "我总会为您这灵活的同情心而惊叹，加尔恰先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170111
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230170111,
					"content": "说，说正事！旅行者，我还是在收购盗宝团所携带的那种徽印，如果你找到的话，可以直接卖给我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170112
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230170112,
					"content": "我最近也…赚了点钱，你大可不用担心报酬的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "加尔恰"
				}
			]
		},
		{
			"id": 2301702,
			"completionStepIds": [],
