					"加尔恰"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230170301,
					"content": "嗯…这些徽印应该足够我试验了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170302
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230170302,
					"content": "这是报酬，请您收好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170303
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230170303,
					"content": "旅行者，您这种眼神是什么意思？盯得我发慌…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170304
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230170304,
					"content": "咳！我要去工作了，我现在就要去工作了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "加尔恰"
				}
			]
		},
