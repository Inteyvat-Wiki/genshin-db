			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"雷蒙多",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741361201,
					"content": "您有什么想问的话，荣誉高级研究员？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361202,
						741361208,
						741361220
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 741361202,
					"content": "关于纳克和艾德温的处理…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361203
					]
				},
				{
					"id": 741361203,
					"content": "他们会暂时待在梅洛彼得堡里，为他们所犯下的罪行悔过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361204
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 741361204,
					"content": "当然，以艾德温的性格，大概率也不会做「悔过」这种事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361205
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 741361205,
					"content": "但无论如何，只要能让艾德温远离研究器材和始基矿就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361206
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 741361206,
					"content": "至于纳克…我想他不会再给我们添麻烦了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361207
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 741361207,
					"content": "唉，希望我不要遇见那种…非启用他们不可的事务…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 741361208,
					"content": "菲希里耶之前很崇拜艾德温？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361209
					]
				},
				{
					"id": 741361209,
					"content": "…艾德温·伊斯丁豪斯先生是一个天才。和他在同一领域工作的人要么自暴自弃，要么就成为他的信徒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361210
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 741361210,
					"content": "菲希里耶小姐是一位非常有热情和创意的研究员，经常用很小的成本做出精彩的成果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361211
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 741361211,
					"content": "在加入始基矿研究项目的第三技术组后，她负责抑制器的结构设计工作，和艾德温的接触次数很多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361212
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 741361212,
					"content": "也许，她就是那个时候成为了艾德温的信徒吧。和其他的信徒一样，艾德温的认可是她唯一的追求。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361213
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 741361213,
					"content": "在爆炸后，她不愿意相信艾德温是爆炸的肇事者，主动申请参与调查，试图为艾德温翻案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361214
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 741361214,
					"content": "你也和艾德温打过交道了，对他感觉如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361215
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 741361215,
					"content": "是个除了研究之外什么都不管的怪人！就会推卸责任，而且连菲希里耶小姐的名字都记不住！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741361216,
					"content": "没错，他就是这样的人。除了手头的研究之外，几乎没有任何东西和人值得他注意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361217
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 741361217,
					"content": "只要研究顺利，他也几乎不会管其他任何事务，就连他手下的研究员偷偷倒卖研究资产也毫不关心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361218
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 741361218,
					"content": "我之所以答应菲希里耶参与调查…只是希望她能早日明白，自己所追逐的一个由她自己想象出来的幻影。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361219
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 741361219,
					"content": "现在，幻影终于破灭了。希望她能早日振作起来…枫丹科学院不能再失去任何研究员了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 741361220,
					"content": "再见。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361221
					]
				},
				{
					"id": 741361221,
					"content": "再见，荣誉高级研究员。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雷蒙多"
				}
			]
		},
		{
			"id": 7413613,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
