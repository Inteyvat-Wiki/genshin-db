			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"舒瓦瑟尔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741361301,
					"content": "呼…没关系，没关系，噩梦都结束了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361302,
						741361305,
						741361309
					],
					"speakerTitle": "舒瓦瑟尔"
				},
				{
					"id": 741361302,
					"content": "对艾德温复活有什么感想？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361303
					]
				},
				{
					"id": 741361303,
					"content": "哎哟！您吓我一跳，感想？我没什么感想，只希望这不负责任的混账能付出代价！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361304
					],
					"speakerTitle": "舒瓦瑟尔"
				},
				{
					"id": 741361304,
					"content": "如果可能的话，我恨不得把他的手脚都绑上，眼睛蒙起来，免得他再接触始基矿！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "舒瓦瑟尔"
				},
				{
					"id": 741361305,
					"content": "现在能放下心了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361306
					]
				},
				{
					"id": 741361306,
					"content": "与之前相比，我的确能稍微安心一些了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361307
					],
					"speakerTitle": "舒瓦瑟尔"
				},
				{
					"id": 741361307,
					"content": "但说实话…把纳克和艾德温关在一起？天哪！我都不知道他们会做什么事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361308
					],
					"speakerTitle": "舒瓦瑟尔"
				},
				{
					"id": 741361308,
					"content": "上次是爆炸，下次是什么？用枫达淹没整个枫丹？我真是不敢想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "舒瓦瑟尔"
				},
				{
					"id": 741361309,
					"content": "祝你有个好心情。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361310
					]
				},
				{
					"id": 741361310,
					"content": "也祝您有美好的一天，荣誉高级研究员。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "舒瓦瑟尔"
				}
			]
		},
		{
			"id": 7413614,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7413611",
							"3"
						],
						"stepId": 7413611,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"菲希里耶",
					"勒马克",
					"肖西韦尔",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741361401,
					"content": "…没有价值…我的研究没价值…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361402
					],
					"speakerTitle": "菲希里耶"
				},
				{
					"id": 741361402,
					"content": "小姐，您不必这么想，您的发明可是救了我一命啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361403
					],
					"speakerTitle": "勒马克"
				},
				{
					"id": 741361403,
					"content": "但…但艾德温前辈…呜呜…艾德温先生说，说这个东西没价值！呜呜呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361404
					],
					"speakerTitle": "菲希里耶"
				},
				{
					"id": 741361404,
					"content": "是那个叫艾德温的人没眼力，明明是个宝贝！什么叫没价值？我都想给我手下的兄弟每人配一个了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361405
					],
					"speakerTitle": "肖西韦尔"
				},
				{
					"id": 741361405,
					"content": "艾德温是坏人，他说的是谎话。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361406
					]
				},
				{
					"id": 741361406,
					"content": "艾德温前辈不是坏人！他…他…反正…他都不记得我的名字！我还给他看过好多次设计图，呜呜呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361407
					],
					"speakerTitle": "菲希里耶"
				},
				{
					"id": 741361407,
					"content": "菲希里耶小姐，你明明就是一个很厉害的人呀，为什么一定要让艾德温那家伙评价你呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741361408,
					"content": "他觉得坏，我觉得好！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361409
					]
				},
				{
					"id": 741361409,
					"content": "真…真的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361410
					],
					"speakerTitle": "菲希里耶"
				},
				{
					"id": 741361410,
					"content": "真的啊，你看我们都这么觉得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361411
					],
					"speakerTitle": "肖西韦尔"
				},
				{
					"id": 741361411,
					"content": "可是，你们又不懂研究——呜呜呜——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361412
					],
					"speakerTitle": "菲希里耶"
				},
				{
					"id": 741361412,
					"content": "菲希里耶小姐…完全陷入混乱状态了呢。不然…我们还是让她一个人静一会吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741361413,
					"content": "行…我和勒马克就在旁边等着，有什么事叫我们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "肖西韦尔"
				}
			]
		}
	]
}