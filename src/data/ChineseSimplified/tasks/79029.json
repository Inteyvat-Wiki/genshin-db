			},
			"dialogs": [
				{
					"id": 790290101,
					"content": "这里有一座雕像？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790290102,
					"content": "唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290103
					],
					"speakerTitle": "夜鸦船长"
				},
				{
					"id": 790290103,
					"content": "你好，为什么在这个山洞口唉声叹气的呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790290112,
					"content": "我呀，最近住在这个山洞里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290113
					],
					"speakerTitle": "夜鸦船长"
				},
				{
					"id": 790290113,
					"content": "居然住在这种山洞里！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790290114,
					"content": "我也没办法！谁叫岛上突然来了群什么剧团演员，每天敲敲打打的，吵得人根本没法睡觉…所以才找到这里，稍微安静一点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290104
					],
					"speakerTitle": "夜鸦船长"
				},
				{
					"id": 790290104,
					"content": "但是不知道从哪里来了一群丘丘人占领了我的歇息之处，我只能在外面吹冷风啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290105
					],
					"speakerTitle": "夜鸦船长"
				},
				{
					"id": 790290105,
					"content": "唉…我在心中暗自发誓，如果有人能帮我，我就告诉他…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290106
					],
					"speakerTitle": "夜鸦船长"
				},
				{
					"id": 790290106,
					"content": "告诉他什么呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790290107,
					"content": "告诉那个帮助我的人寻找到传说中海盗秘宝的线索！虽然我也只知道四分之一啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290108
					],
					"speakerTitle": "夜鸦船长"
				},
				{
					"id": 790290108,
					"content": "四分之一的线索？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790290109,
					"content": "看起来你们也是寻求秘宝之人，怎么样，帮我解决里面的丘丘人，我就把线索的位置告诉你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290110
					],
					"speakerTitle": "夜鸦船长"
				},
				{
					"id": 790290110,
					"content": "据说得到四份线索，就能找到曾经流落在此的海盗留下的宝藏呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290111
					],
					"speakerTitle": "夜鸦船长"
				},
				{
					"id": 790290111,
					"content": "一言为定！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
