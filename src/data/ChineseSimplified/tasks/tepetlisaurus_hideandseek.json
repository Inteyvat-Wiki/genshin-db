			"dialogs": [
				{
					"id": 750250101,
					"content": "呜啊，这是什么神奇的地方？居然有这么多小嵴锋龙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750250102,
					"content": "难道是什么嵴锋龙的…聚集地？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750250103,
					"content": "呀！…唔呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250104
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750250104,
					"content": "#难得遇到这么多同伴，{REALNAME[ID(2)|SHOWHOST(true)]}看上去也显得很兴奋呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750250105,
					"content": "呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250106
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750250106,
					"content": "#哦，你是想去那边和它们一起玩吗？唔，{NICKNAME}，这么一想，{REALNAME[ID(2)|SHOWHOST(true)]}确实很少和小嵴锋龙们一起…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250107,
						750250108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750250107,
					"content": "注意安全哦？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750250109
					]
				},
				{
					"id": 750250109,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250110
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750250110,
					"content": "#虽然还是有点担心，不过现在我们就找个地方坐下来，边吃东西边聊天，等着{REALNAME[ID(2)|SHOWHOST(true)]}好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750250111,
					"content": "#你和派蒙在附近找到了一块不错的休息处，等待{REALNAME[ID(2)|SHOWHOST(true)]}结束游玩归来。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750250112
					]
				},
				{
					"id": 750250112,
					"content": "只不过，等待的时间似乎长了一些…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750250113
					]
				},
				{
					"id": 750250113,
					"content": "#…咦，{REALNAME[ID(2)|SHOWHOST(true)]}怎么还没有回来？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750250114,
					"content": "不会是出了什么事了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750250115,
					"content": "也许是玩得太开心了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750250116
					]
				},
				{
					"id": 750250116,
					"content": "要是这样，也得好好说说它，天都要黑了还不回来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750250117,
					"content": "唔…我们快点去找找它吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750250108,
					"content": "要及时回来！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750250109
					]
				}
			]
		},
