			"dialogs": [
				{
					"id": 761490101,
					"content": "是谁？是谁！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490102
					],
					"speakerTitle": "阿罗逻"
				},
				{
					"id": 761490102,
					"content": "#{NICKNAME}。如今这个时代的人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761490103
					]
				},
				{
					"id": 761490103,
					"content": "虽然我不知道你们的时代，但是我叫阿罗逻，本是寂静期行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490104
					],
					"speakerTitle": "阿罗逻"
				},
				{
					"id": 761490104,
					"content": "来到这里已经记不得时间了。甚至这里把我的寂静之修行破掉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490105
					],
					"speakerTitle": "阿罗逻"
				},
				{
					"id": 761490105,
					"content": "果然，无念无想的修行会让人投生无想恶天啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490106
					],
					"speakerTitle": "阿罗逻"
				},
				{
					"id": 761490106,
					"content": "举手之劳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761490107
					]
				},
				{
					"id": 761490107,
					"content": "千万别谢谢我。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761490108
					]
				},
				{
					"id": 761490108,
					"content": "谢谢啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490109
					],
					"speakerTitle": "阿罗逻"
				},
				{
					"id": 761490109,
					"content": "虽然救你是顺手而为。不过我们准备找找冥想之外的办法离开这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490110
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 761490110,
					"content": "你们不擅长冥想吗？或者你们的时代不教授这种技术？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490111
					],
					"speakerTitle": "阿罗逻"
				},
				{
					"id": 761490111,
					"content": "我第一次离开这里花了数百年的岁月。我舍弃了我对真理的追求，舍弃了见到亲朋的渴爱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490112
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 761490112,
					"content": "这一次我不愿意再放弃这些了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490113
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 761490113,
					"content": "算我一个。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490114
					],
					"speakerTitle": "阿罗逻"
				},
				{
					"id": 761490114,
					"content": "！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490115
					],
					"speakerTitle": "小右"
				},
				{
					"id": 761490115,
					"content": "小右又捡到一个「念亡碎片」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490116
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 761490116,
					"content": "念亡？哦，死随念这种冥想技术我也知道。它能让人锻炼面对死亡之时的心境。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490117
					],
					"speakerTitle": "阿罗逻"
				},
				{
					"id": 761490117,
					"content": "既然找到琳德了。我们就去找找出去的办法吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490118
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 761490118,
					"content": "这里真的可以靠实力出去吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490119
					],
					"speakerTitle": "阿罗逻"
				},
				{
					"id": 761490119,
					"content": "既然梅兰塔和尼西里塔可以自由往来，通常都还会带人出入。那小右应该也可以。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490120
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 761490120,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490121
					],
					"speakerTitle": "小右"
				},
				{
					"id": 761490121,
					"content": "现在收集到了三枚「念亡碎片」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490122
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 761490122,
					"content": "哦，这个是暂定名。因为我也不知道小右收集这个要做什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490123
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 761490123,
					"content": "小右，接下来怎么办？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490124
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 761490124,
					"content": "！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490125
					],
					"speakerTitle": "小右"
				},
				{
					"id": 761490125,
					"content": "跟着它指示的方向走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊斯托利亚"
				}
			]
		},
