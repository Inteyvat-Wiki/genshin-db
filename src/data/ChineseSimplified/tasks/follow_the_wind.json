			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"飞飞",
					"枫原万叶",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20021101,
					"content": "可、可恶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021102
					],
					"speakerTitle": "飞飞"
				},
				{
					"id": 20021102,
					"content": "不要，不要，只有烙字千万不要…！求求你了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021103
					],
					"speakerTitle": "飞飞"
				},
				{
					"id": 20021103,
					"content": "生死攸关，已尽全力之人，依然无法令神明垂青。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021104
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 20021104,
					"content": "留下神之眼快走吧，我心意已改，之前的责罚，不作数了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021105
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 20021105,
					"content": "欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021106
					],
					"speakerTitle": "飞飞"
				},
				{
					"id": 20021106,
					"content": "怎么，难道你又想主动受罚了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021107
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 20021107,
					"content": "那我当然无所谓，这种符合武士之道的觉悟值得赞赏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021108
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 20021108,
					"content": "不不不，怎么可能呢，谢谢放过，谢谢大人有大量！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021110
					],
					"speakerTitle": "飞飞"
				},
				{
					"id": 20021110,
					"content": "没太明白，你只是故意想吓唬他？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20021111,
					"content": "我没有这种古怪的兴趣，只是神之眼还在他的手上，我想试试最后的可能性。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021112
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 20021112,
					"content": "人被逼入绝境之时，会爆发出相当强大的力量，我原以为，这会成为神之眼亮起的契机。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021113
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 20021113,
					"content": "可惜，什么都没有发生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021114
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 20021114,
					"content": "从头到尾，都是为了这件事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021115
					]
				},
				{
					"id": 20021115,
					"content": "是的，我只想知道熄灭的神之眼，有无重燃的可能性。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021116
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 20021116,
					"content": "从察觉到他在偷那颗神之眼的时候起，我就决定用他来做这场「实验」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021117
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 20021117,
					"content": "而且在过去的时间里，我也已经尝试过许多种办法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021190
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 20021190,
					"content": "虽然「无主的神之眼还能重新发光」这种事，我只在少数传说中听说过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021191
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 20021191,
					"content": "但既然见识到了你可以同时掌控多种元素，还有什么是不可能的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021192
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 20021192,
					"content": "来，你也试试看吧，看看你能不能给我理想的答案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021118,
						20021119
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 20021118,
					"content": "我试试。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021120
					]
				},
				{
					"id": 20021120,
					"content": "看起来，没有什么特殊的反应呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20021121,
					"content": "原来如此，就算是你也不行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021122
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 20021122,
					"content": "没关系，这也是意料之中的事，那这枚神之眼，就可以继续陪着我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021123,
						20021124
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 20021123,
					"content": "为什么这么执着？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021125
					]
				},
				{
					"id": 20021125,
					"content": "对哦，这个神之眼有什么特殊的由来吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20021126,
					"content": "那就，不得不提及一位故人了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021127
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 20021127,
					"content": "可能我现在做的一切，最后会发现都是无意义的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021128
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 20021128,
					"content": "但浪人武士一生，除了旅途的「意义」和沿途的花鸟风月，还有心中的「道」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021129
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 20021129,
					"content": "万叶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20021130,
					"content": "呵呵，不过是随性而为而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021131
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 20021131,
					"content": "好了，是时候回去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021132,
						20021134
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 20021132,
					"content": "嗯，走吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021133
					]
				},
				{
					"id": 20021133,
					"content": "那么，就再一次由我引你乘风。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 20021134,
					"content": "再散散心吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021135
					]
				},
				{
					"id": 20021135,
					"content": "…不必顾虑我的感受。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021136
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 20021136,
					"content": "不过，还是谢谢你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 20021124,
					"content": "一定要点亮它吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021125
					]
				},
				{
					"id": 20021119,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021120
					]
				}
			]
		},
