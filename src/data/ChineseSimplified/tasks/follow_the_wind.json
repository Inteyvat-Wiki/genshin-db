			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"北斗"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20020201,
					"content": "唔，怎么还没有来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020202
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20020202,
					"content": "#算了，还是先开始你的隆重登场好了，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020203
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20020203,
					"content": "各位，安静一下，注意这边！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020204
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20020204,
					"content": "紧张刺激的「南十字武斗会」，终于来到了最后的决赛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020205
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20020205,
					"content": "经历了许多许多惊心动魄的比试之后，终于有两位选手来到了今天的舞台之上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020206
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20020206,
					"content": "#首先，我要介绍的这一位，大家就算没有见过，也一定听过{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}的名声。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020207
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20020207,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}就是，令魔神奥赛尔也为之胆寒，愚人众的执行官也闻之色变的，璃月的异乡人英雄！{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020208
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20020208,
					"content": "哦哦哦哦哦哦哦——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020209
					],
					"speakerTitle": "参赛者"
				},
				{
					"id": 20020209,
					"content": "等了好久了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020210
					],
					"speakerTitle": "参赛者"
				},
				{
					"id": 20020210,
					"content": "#想必在半决赛的时候，大家都看到了{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}的精彩表现。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020211
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20020211,
					"content": "今天的决赛，精彩程度一定会更胜一筹！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020212
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20020212,
					"content": "而我们的另一位选手…唔，现在还没有到场。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020213
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20020213,
					"content": "真是的，搞什么去了。决赛又不能像是之前的比赛，直接判定弃权…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020214
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20020214,
					"content": "抱歉抱歉，麻烦大家再稍等一会儿！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020215,
						20020216
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20020215,
					"content": "会不会是记错时间了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020217
					]
				},
				{
					"id": 20020217,
					"content": "不管怎么样，如果还不到场的话，这场决赛就只能延期了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020218
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20020218,
					"content": "等等，我觉得有点奇怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020219
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 20020219,
					"content": "大姐头，我们去检查一下奖品吧，就是那个放置神之眼的盒子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020220
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 20020220,
					"content": "#{NICKNAME}，你也跟我们过来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 20020216,
					"content": "会不会是不敢来了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020217
					]
				}
			]
		},
		{
			"id": 200204,
			"completionStepIds": [
				200204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200204",
							"2"
						],
						"stepId": 200204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"北斗",
					"派蒙",
					"枫原万叶"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20020401,
					"content": "我看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020402
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20020402,
					"content": "嗯…那颗神之眼居然不见了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020403
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20020403,
					"content": "是被偷了吗？光天化日之下，谁能做得到这种事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20020404,
					"content": "而且也不知道是什么时候下的手…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020405
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20020405,
					"content": "呵，没料到趁我兴起，有人敢钻我北斗的空子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020406
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20020406,
					"content": "不用太着急，再高明的手法也瞒不过自然的眼睛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020407
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 20020407,
					"content": "嗯…行窃的人是刚刚下手的，并且还没有跑得太远。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020408
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 20020408,
					"content": "神之眼是我许诺的奖品，没有看好它也是我的责任，我会负责把它找回来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020409
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 20020409,
					"content": "唔，既然你这么说，那只能这样了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020410
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20020410,
					"content": "我要留在这里，给这些来看武斗会的人一个解释。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020411
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20020411,
					"content": "#对了，{NICKNAME}，你也跟我一起去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020412,
						20020413
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 20020412,
					"content": "没办法了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020414
					]
				},
				{
					"id": 20020414,
					"content": "但是，这里是个岛啊，追的话，往哪里追？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20020415,
					"content": "跟我来吧，我能感觉到，「风」快要来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 20020413,
					"content": "反正对手也没有来。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020414
					]
				}
			]
		},
		{
			"id": 200209,
			"completionStepIds": [
				200209
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200209",
							"2"
						],
						"stepId": 200209,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"飞飞",
					"枫原万叶",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20020901,
					"content": "怎么会有人比我跑得还快！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020902
					],
					"speakerTitle": "飞飞"
				},
				{
					"id": 20020902,
					"content": "为了顺利逃跑我还提前准备了船，居然一下子就被追上了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020903
					],
					"speakerTitle": "飞飞"
				},
				{
					"id": 20020903,
					"content": "船再快，也比不上风的速度啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020904
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 20020904,
					"content": "风？你在说什么…啊，我明白了，是你神之眼的能力吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020905
					],
					"speakerTitle": "飞飞"
				},
				{
					"id": 20020905,
					"content": "可恶，要是我也有神之眼…或者如果我能让这颗神之眼亮起来，你们怎么可能追得到我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020906
					],
					"speakerTitle": "飞飞"
				},
				{
					"id": 20020906,
					"content": "和神之眼无关，或许你很擅长在「人群」中销声匿迹，但显然你还不知道如何甩开「自然」的目光。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020907
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 20020907,
					"content": "此外，逃跑路径的选择也破绽百出，而且，我循风而来的路上，还听到了你得意洋洋的炫耀与放声大笑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020908
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 20020908,
					"content": "换句话说，神偷的三项信条，「迅速」，「隐秘」，「优雅」，你一项都没有做到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020909
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 20020909,
					"content": "你、你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020910
					],
					"speakerTitle": "飞飞"
				},
				{
					"id": 20020910,
					"content": "但比起这些，更令我失望的是你手中神之眼的状态…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020911
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 20020911,
					"content": "——果然，它不会无差别地回应「愿望」呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020912
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 20020912,
					"content": "行吧行吧！这次算我认栽了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020913
					],
					"speakerTitle": "飞飞"
				},
				{
					"id": 20020913,
					"content": "这神之眼我盯上它很久了，听说这次武斗会的参赛者都是不入流的家伙，我就报了名，一路打到了决赛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020914
					],
					"speakerTitle": "飞飞"
				},
				{
					"id": 20020914,
					"content": "原来你就是我们的决赛对手啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020915
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20020915,
					"content": "本来我以为凭实力夺冠也没问题！结果，就是因为你们突然杀了出来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020916
					],
					"speakerTitle": "飞飞"
				},
				{
					"id": 20020916,
					"content": "我看了半决赛，我当场就知道我没有半点胜算，但都已经到这份儿上了，我肯定不甘心放弃神之眼啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020917
					],
					"speakerTitle": "飞飞"
				},
				{
					"id": 20020917,
					"content": "既然明争行不通，那…我就趁大家的注意力在北斗和你的身上时，用上了我老本行的技巧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020918
					],
					"speakerTitle": "飞飞"
				},
				{
					"id": 20020918,
					"content": "明明我的准备已经够充分，结果还是被你们追上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020919,
						20020921,
						20020927
					],
					"speakerTitle": "飞飞"
				},
				{
					"id": 20020919,
					"content": "走投无路了就识相点吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020920
					]
				},
				{
					"id": 20020920,
					"content": "该死，还是不甘心啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020923
					],
					"speakerTitle": "飞飞"
				},
				{
					"id": 20020923,
					"content": "再抵抗的话，代价就大了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020924
					]
				},
				{
					"id": 20020924,
					"content": "赤裸裸的威胁啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020928
					],
					"speakerTitle": "飞飞"
				},
				{
					"id": 20020928,
					"content": "行，不过你要说话算话！反正我拿到它，它也没被唤醒，那就只是个没用的壳子而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020929
					],
					"speakerTitle": "飞飞"
				},
				{
					"id": 20020929,
					"content": "那怎么行，光是偷东西这一项罪责，按海上的规矩，就应该断臂赎罪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020930
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 20020930,
					"content": "噫？！不至于吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020931
					],
					"speakerTitle": "飞飞"
				},
				{
					"id": 20020931,
					"content": "再加上你偷走了奖品，没有参加决赛，让「南十字」船队的首领北斗丢了面子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020932
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 20020932,
					"content": "看来，还要用烫红的烙铁，在你的脸上烙下「小偷」两字，才算公允吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020933
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 20020933,
					"content": "喂喂，不用这么狠吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020934
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20020934,
					"content": "可恶，没想到你这个人这么心狠手辣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020935
					],
					"speakerTitle": "飞飞"
				},
				{
					"id": 20020935,
					"content": "既然没得谈，那还废什么话，我跟你们拼了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "飞飞"
				},
				{
					"id": 20020921,
					"content": "把东西交出来吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020922
					]
				},
				{
					"id": 20020922,
					"content": "可是，好不容易才拿到的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020925
					],
					"speakerTitle": "飞飞"
				},
				{
					"id": 20020925,
					"content": "乖乖听话的话就什么事都没有。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020926
					]
				},
				{
					"id": 20020926,
					"content": "真、真的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020928
					],
					"speakerTitle": "飞飞"
				},
				{
					"id": 20020927,
					"content": "东西拿出来，就放过你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020928
					]
				}
			]
		},
		{
			"id": 200211,
			"completionStepIds": [
				200211
			],
