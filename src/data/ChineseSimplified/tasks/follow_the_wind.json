				"points": []
			},
			"dialogs": [
				{
					"id": 20021201,
					"content": "咦？北斗不在这里了吗？她回船上去了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20021202,
					"content": "大姐头的话，她被凝光叫走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021203
					],
					"speakerTitle": "珠函"
				},
				{
					"id": 20021203,
					"content": "好像是因为这次「南十字武斗会」规模超出了报备的数倍，实在不能视而不见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021204
					],
					"speakerTitle": "珠函"
				},
				{
					"id": 20021204,
					"content": "大姐头一边骂着「扫兴的女人」，一边去璃月港了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021205
					],
					"speakerTitle": "珠函"
				},
				{
					"id": 20021205,
					"content": "哈哈，和凝光之间的各种矛盾，也算是常有的事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021206
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 20021206,
					"content": "不过，大姐头最遗憾的还是没能见证冠军的诞生，走之前一直在念叨这件事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021207
					],
					"speakerTitle": "珠函"
				},
				{
					"id": 20021207,
					"content": "其实偷走神之眼的，就是这位大英雄原本的决赛对手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021208
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 20021208,
					"content": "因为自知毫无胜算，才萌生了盗走奖品的邪念。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021209
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 20021209,
					"content": "这样一来，这场「南十字武斗会」的结果，应该尘埃落定了才是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021210
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 20021210,
					"content": "原、原来是这样？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021211
					],
					"speakerTitle": "珠函"
				},
				{
					"id": 20021211,
					"content": "那么根据规则，那个人就算失去了资格，冠军就是大英雄的了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021212
					],
					"speakerTitle": "珠函"
				},
				{
					"id": 20021212,
					"content": "这样夺冠，还挺意外的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20021213,
					"content": "没关系没关系，我觉得这叫「实至名归」。我现在就把特别准备的冠军奖牌交给你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021214
					],
					"speakerTitle": "珠函"
				},
				{
					"id": 20021214,
					"content": "那就可以去稻妻了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021215
					]
				},
				{
					"id": 20021215,
					"content": "应该是的，虽然现在大姐头不在，但之后我会转告她，以她的性格，说到定会做到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021216
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 20021216,
					"content": "不过，前往稻妻的海路很不好走，风雨无时无刻不在咆哮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021217
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 20021217,
					"content": "无休的暴风雨，其实也是雷电将军锁国意志的一种体现。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021218
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 20021218,
					"content": "意志就连天气都可以改变吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20021219,
					"content": "那可是「尘世七执政」，就像璃月的摩拉克斯投下岩枪造就孤云阁，雷电将军可以唤起永恒的风暴，也不值得大惊小怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021220
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 20021220,
					"content": "总之，若要驶向稻妻，「死兆星」号还需要一点时间。准备停当之后，你们会收到通知的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021221
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 20021221,
					"content": "这段时间我也要四处走走，看看璃月的广袤大地上，有没有唤醒神之眼的契机。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021222
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 20021222,
					"content": "我相信，一定可以的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20021223,
					"content": "谢谢，希望我们各自的旅途都能寻到意义。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021224
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 20021224,
					"content": "我还有一句告诫——在无尽雷暴的前方，可能是你们最艰难的一段旅途。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "枫原万叶"
				}
			]
		},
