			"dialogs": [
				{
					"id": 411300401,
					"content": "没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411300402
					]
				},
				{
					"id": 411300402,
					"content": "太好了。那我先去叫上其他人，我们马上出发，速战速决。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300403
					],
					"speakerTitle": "经纶"
				},
				{
					"id": 411300403,
					"content": "把魔物营地清理干净之后，我们再回来这里碰头。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "经纶"
				}
			]
		},
		{
