			},
			"dialogs": [
				{
					"id": 411300601,
					"content": "怎么样，你把那只魔物打倒了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300602
					],
					"speakerTitle": "经纶"
				},
				{
					"id": 411300602,
					"content": "已经打倒了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411300603
					]
				},
				{
					"id": 411300603,
					"content": "太好了…这样子总算能缓口气了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300604
					],
					"speakerTitle": "经纶"
				},
				{
					"id": 411300604,
					"content": "谢谢你帮忙，旅行者，这些东西请收下吧，就当是谢礼了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300605
					],
					"speakerTitle": "经纶"
				},
				{
					"id": 411300605,
					"content": "但轻策庄周围为什么会突然出现这种魔物，真是奇怪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300606
					],
					"speakerTitle": "经纶"
				},
				{
					"id": 411300606,
					"content": "算了，不管怎么样，我都得向总务司报告一下这件事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300607
					],
					"speakerTitle": "经纶"
				},
				{
					"id": 411300607,
					"content": "希望总务司能再调一些人过来支援…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "经纶"
				}
			]
		}
