			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"经纶"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411300101,
					"content": "旅行者，这里，这里！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300102
					],
					"speakerTitle": "经纶"
				},
				{
					"id": 411300102,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411300103
					]
				},
				{
					"id": 411300103,
					"content": "还是轻策庄的事。因为掉下来的那些陨石，轻策庄周围的魔物都乱了。它们在路上到处肆虐，轻策庄几乎都要被它们给围住了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300106
					],
					"speakerTitle": "经纶"
				},
				{
					"id": 411300106,
					"content": "虽然轻策庄有我们守着，不会出大问题，但是城里支援过来的物资，还是要从外面过来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300107
					],
					"speakerTitle": "经纶"
				},
				{
					"id": 411300107,
					"content": "现在这个情况，总务司也不可能分出很多人来护送…要是遇见了大群的魔物，只怕物资会有风险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300108
					],
					"speakerTitle": "经纶"
				},
				{
					"id": 411300108,
					"content": "所以，我和几个兄弟就寻思着…就算不能离开轻策庄太远，但是，轻策庄周围的那些魔物，我们还是能清理一下的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300109
					],
					"speakerTitle": "经纶"
				},
				{
					"id": 411300109,
					"content": "这样也算是给送物资过来的兄弟帮个忙了。但按照之前我们的侦察，周围的魔物聚集点还不少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300110
					],
					"speakerTitle": "经纶"
				},
				{
					"id": 411300110,
					"content": "只凭我们的话，很难把这些魔物营地迅速地全部清理干净。但如果时间拖太长了，我担心轻策庄里说不定也会出问题…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300111
					],
					"speakerTitle": "经纶"
				},
				{
					"id": 411300111,
					"content": "旅行者，你愿意帮我们去清理一部分魔物吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "经纶"
				}
			]
		},
		{
			"id": 4113002,
			"completionStepIds": [
				4113003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4113003",
							"2"
						],
						"stepId": 4113003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"经纶"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411300201,
					"content": "不行…必须得要人来支援…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300202
					],
					"speakerTitle": "经纶"
				},
				{
					"id": 411300202,
					"content": "魔物营地已经清理干净了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411300203
					]
				},
				{
					"id": 411300203,
					"content": "好的，谢谢你。但是刚才又出现了意外情况。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300204
					],
					"speakerTitle": "经纶"
				},
				{
					"id": 411300204,
					"content": "我本来以为，在轻策庄外围徘徊的只有一些普通的魔物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300205
					],
					"speakerTitle": "经纶"
				},
				{
					"id": 411300205,
					"content": "我领着几个人，刚清理完了一个魔物营地，正准备休息一下之后再继续前进。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300206
					],
					"speakerTitle": "经纶"
				},
				{
					"id": 411300206,
					"content": "但是旁边的树林里，突然出现了一只丘丘岩盔王…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300207
					],
					"speakerTitle": "经纶"
				},
				{
					"id": 411300207,
					"content": "我们还没来得及做出反应，它就袭击了我们，很多人受了伤…我们只能暂时撤退。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300208
					],
					"speakerTitle": "经纶"
				},
				{
					"id": 411300208,
					"content": "那只魔物的威胁太大了，绝不能坐视不管。但去其他地方清理魔物营地的人还没回来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300209
					],
					"speakerTitle": "经纶"
				},
				{
					"id": 411300209,
					"content": "旅行者，你愿意帮忙去打倒那个魔物吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300210,
						411300212
					],
					"speakerTitle": "经纶"
				},
				{
					"id": 411300210,
					"content": "交给我了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411300211
					]
				},
				{
					"id": 411300211,
					"content": "那就拜托你了，真是不好意思…这本来是我们的职责。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "经纶"
				},
				{
					"id": 411300212,
					"content": "受伤的人没事吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411300213
					]
				},
				{
					"id": 411300213,
					"content": "还好治疗及时，都没什么大碍…但一时半会是没法自如行动了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300214
					],
					"speakerTitle": "经纶"
				},
				{
					"id": 411300214,
					"content": "所以，只能拜托你去打倒那个魔物了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300215
					],
					"speakerTitle": "经纶"
				},
				{
					"id": 411300215,
					"content": "真是不好意思…这本来是我们的职责…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "经纶"
				}
			]
		},
