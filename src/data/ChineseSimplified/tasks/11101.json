			"dialogs": [
				{
					"id": 111010701,
					"content": "怎么会的…「百无禁忌箓」怎么会没有效果呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010702
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111010702,
					"content": "这些丘丘人身上的邪气又变强了吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010703
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111010703,
					"content": "「百无禁忌箓」…好像有点耳熟？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010704,
						111010705
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111010704,
					"content": "可以自由出入「绝云间」的那个…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010706
					]
				},
				{
					"id": 111010706,
					"content": "对了，是那个！仙人的「信物」，上面一定残留着仙人的力量！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010707
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111010707,
					"content": "怪不得他上次能用这个把怪物吓跑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010708
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111010708,
					"content": "你、你们在念叨什么呢，这不过是本仙昨晚没睡好…仙力未能通达六脉而已！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010709
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111010709,
					"content": "如果再给我一次机会的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010710
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111010710,
					"content": "又有「邪恶丘丘人」往那边去了，那这次可以交给你么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010711
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111010711,
					"content": "我…本、本仙忽然觉得身体有恙，定是方才仙力耗损太多所致，不然我必斩尽这些妖邪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010712
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111010712,
					"content": "唉…果然是吹牛大王，没有错怪你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010713
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111010713,
					"content": "旅行者，还是我们追上去看看吧，用「元素视野」可以方便追踪哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
