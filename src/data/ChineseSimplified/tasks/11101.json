			"dialogs": [
				{
					"id": 111010201,
					"content": "就要这一本吗，《护法仙众夜叉录》？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010202
					],
					"speakerTitle": "纪芳"
				},
				{
					"id": 111010202,
					"content": "嗯，这些给你，不用找了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010203
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111010203,
					"content": "老板阔气，阔气…谢谢惠顾！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010204
					],
					"speakerTitle": "纪芳"
				},
				{
					"id": 111010204,
					"content": "这不是那位「多星缺辰天君」吗？怎么又在这里碰到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010205,
						111010206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111010205,
					"content": "是「掇星攫辰天君」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010207
					]
				},
				{
					"id": 111010207,
					"content": "我好像听到他刚才买的书叫…《护法仙众夜叉录》？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111010208,
					"content": "记得好像是一本关于仙人的书来着，仙人为什么会买有关自己的书呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010209,
						111010211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111010209,
					"content": "我早就觉得他有些可疑…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010210
					]
				},
				{
					"id": 111010210,
					"content": "欸，是这样吗？你觉得哪里可疑啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010214,
						111010216,
						111010218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111010214,
					"content": "仙人要那么多钱做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010215
					]
				},
				{
					"id": 111010215,
					"content": "啊…说得也是，一般的仙人好像都是一脸无欲无求的样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111010220,
					"content": "唔……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111010221,
					"content": "看起来有必要确认一下书的内容了，说不定可以抓住什么把柄！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111010216,
					"content": "感觉像是江湖骗子的套路。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010217
					]
				},
				{
					"id": 111010217,
					"content": "你的意思是…其实他没有实现愿望的能力吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111010218,
					"content": "他的面具太丑了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010219
					]
				},
				{
					"id": 111010219,
					"content": "啊！确实很丑！太可疑了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111010211,
					"content": "是自恋吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010212
					]
				},
				{
					"id": 111010212,
					"content": "这么说也有道理！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111010213,
					"content": "不过仔细想想，这个仙人总觉得有些不对劲…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010214,
						111010216,
						111010218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111010206,
					"content": "这就是「仙缘」吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010207
					]
				}
			]
		},
