			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"基尼奇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 756620101,
					"content": "有信使告诉我，战备联络官找到了强大的试炼检验人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620102
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 756620102,
					"content": "确认是你，我就放心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620103
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 756620103,
					"content": "嘁，怎么连这家伙都找上了？基尼奇，你这朋友跟你一副德行，是份委托就会接啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620104
					],
					"speakerTitle": "阿乔"
				},
				{
					"id": 756620104,
					"content": "链接器来提示了。我收到了一份让聒噪的龙闭嘴的委托。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620105,
						756620107
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 756620105,
					"content": "我刚发布的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756620106
					]
				},
				{
					"id": 756620106,
					"content": "你…你们…好哇，竟敢合起伙来捉弄我伟大圣龙…你们会付出代价的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620109
					],
					"speakerTitle": "阿乔"
				},
				{
					"id": 756620109,
					"content": "#言归正传吧，{NICKNAME}，这次要有劳你检验这几个关卡了。难度和平衡性应当不会让你失望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620110
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 756620110,
					"content": "难度？我是没看出有半点难度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620111
					],
					"speakerTitle": "阿乔"
				},
				{
					"id": 756620111,
					"content": "「让他们随机抽选笨蛋伙伴，蒙上脑袋体验山崖速降去。」这是你对难度的理解和诠释？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620112
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 756620112,
					"content": "况且，抽选的伙伴里只有一成概率是匿叶龙，剩下的全是熔岩游像和岩史莱姆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620113,
						756620116
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 756620113,
					"content": "这是玩命啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756620114
					]
				},
				{
					"id": 756620114,
					"content": "呵，你还不知道「悬木人」爱玩的是什么吗？你跟我的小小仆从认识也有一段时间了，我这建议可是量身定制。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620115
					],
					"speakerTitle": "阿乔"
				},
				{
					"id": 756620115,
					"content": "那你怎么不亲自示范？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620120
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 756620120,
					"content": "…参加这种小打小闹的挑战，简直有辱我伟大圣龙的尊严。你们爱怎么玩就怎么玩吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620121
					],
					"speakerTitle": "阿乔"
				},
				{
					"id": 756620121,
					"content": "总之，伊拉德给我开的价码非常不错，希望你既能在挑战中收获乐趣，也能得到满意的报酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620122,
						756620123
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 756620122,
					"content": "非常期待！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756620124
					]
				},
				{
					"id": 756620124,
					"content": "一切顺利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 756620123,
					"content": "交给我吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756620124
					]
				},
				{
					"id": 756620116,
					"content": "好像还挺有劲的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756620117
					]
				},
				{
					"id": 756620117,
					"content": "你看看，你听听？人家的眼力、见识和思维样样都比你这家伙好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620118
					],
					"speakerTitle": "阿乔"
				},
				{
					"id": 756620118,
					"content": "但我想看阿乔先做榜样。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756620119
					]
				},
				{
					"id": 756620119,
					"content": "支持。阿乔身形袖珍，一定远比挑战者灵活。即使不巧被魔物揍了一击，也不会径直砸进地里，摔出一个坑洞吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620120
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 756620107,
					"content": "没关系，可以晚点再完成那份。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756620108
					]
				},
				{
					"id": 756620108,
					"content": "哼…别以为你帮伟大圣龙说了句好话，我就会对你感恩戴德！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620109
					],
					"speakerTitle": "阿乔"
				}
			]
		}
	]
}