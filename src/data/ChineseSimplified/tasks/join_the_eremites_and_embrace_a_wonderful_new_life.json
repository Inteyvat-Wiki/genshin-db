			"dialogs": [
				{
					"id": 732670801,
					"content": "喔——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670802
					],
					"speakerTitle": "艾登"
				},
				{
					"id": 732670802,
					"content": "居，居然跑得这么快…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670803
					],
					"speakerTitle": "卡里玛"
				},
				{
					"id": 732670803,
					"content": "很好！速度很不错，跑得也很稳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670804
					],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732670804,
					"content": "艾登，卡里玛，你们可要记好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670805
					],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732670805,
					"content": "遇见危险的情况可不要逞强，需要撤退的时候，一定要果断撤退才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670806
					],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732670806,
					"content": "特别是你，艾登。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670807
					],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732670807,
					"content": "我知道啦——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670808
					],
					"speakerTitle": "艾登"
				},
				{
					"id": 732670808,
					"content": "不错，那我们下一步…就去村外，让你们亲眼见识一下「战斗」的场面吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670809
					],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732670809,
					"content": "好耶！爸爸刚给我削了一根木剑，我就带在身上。卡里玛，你呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670810
					],
					"speakerTitle": "艾登"
				},
				{
					"id": 732670810,
					"content": "我倒是有一副小弓箭，虽然…妈妈只给我没有箭头的箭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670811
					],
					"speakerTitle": "卡里玛"
				},
				{
					"id": 732670811,
					"content": "哈哈哈！没问题，你们又有剑又有弓，而且还有满腔勇气，这些就足够你们踏上冒险之路了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670812
					],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732670812,
					"content": "但是，去了村外之后记得不要乱跑，要时刻待在我和旅行者身边。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670813,
						732670814
					],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732670813,
					"content": "你真要带她们出去？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670815
					]
				},
				{
					"id": 732670815,
					"content": "…放心吧，那个地方我已经事先踩过点了，只有几只病恹恹的蝎子，几乎没有攻击性，不会有问题的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670816
					],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732670816,
					"content": "再说了，不是还有咱们俩在嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670817,
						732670818
					],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732670817,
					"content": "你就把我给算进来了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670819
					]
				},
				{
					"id": 732670819,
					"content": "…都到这里了，好人做到底啦旅行者。我也会按照冒险家的规矩，给你准备好报酬的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670820
					],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732670820,
					"content": "那你们俩准备好，我们这就出发了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670821
					],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732670821,
					"content": "喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670822
					],
					"speakerTitle": "艾登"
				},
				{
					"id": 732670822,
					"content": "唔…有点紧张…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡里玛"
				},
				{
					"id": 732670818,
					"content": "我答应你什么了吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670819
					]
				},
				{
					"id": 732670814,
					"content": "带着两个孩子…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670815
					]
				}
			]
		},
		{
