			"trigger": {
				"objectNames": [
					"阿提亚"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732670101,
					"content": "加入镀金旅团！拥抱美好生活！这位朋友，有没有兴趣了解一下我们镀金旅团啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670102
					],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732670102,
					"content": "呃…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670103
					]
				},
				{
					"id": 732670103,
					"content": "咳，你听我说啊。镀金旅团可是个好地方，自由！团结！友好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670104
					],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732670104,
					"content": "而且还能从住在树上的那些家伙的腰包里掏钱出来。教令院的学者们都可有钱了，绝对不会拖欠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670105,
						732670106
					],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732670105,
					"content": "我已经加入冒险家协会了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670107
					]
				},
				{
					"id": 732670107,
					"content": "呃…冒险家协会…那…那也不耽误嘛！这年头谁没个兼职，而且冒险家和佣兵感觉上也，也差不多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670108
					],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732670108,
					"content": "还是差挺多的啦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670109
					]
				},
				{
					"id": 732670109,
					"content": "唉，不过我们的伙食也很好啊，隔三差五就有鱼有肉的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670110
					],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732670110,
					"content": "而且如果你运气好的话，甚至能和那位「炽鬃之狮」迪希雅说上话呢！我…咳咳…咳咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670111,
						732670112
					],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732670111,
					"content": "你喝点水…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670113
					]
				},
				{
					"id": 732670113,
					"content": "呼…呃…抱歉抱歉，刚才说太急了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670114
					],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732670114,
					"content": "好不容易有个人愿意听我宣传，我太激动了一点…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670115
					],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732670115,
					"content": "不过，你真的不考虑加入镀金旅团吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670116,
						732670117
					],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732670116,
					"content": "暂时没这打算。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670118
					]
				},
				{
					"id": 732670118,
					"content": "好吧，既然你都这么说了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670119
					],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732670119,
					"content": "你一直在这里招人吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670120
					]
				},
				{
					"id": 732670120,
					"content": "是啊，这是我的工作嘛。这年头哪里都缺人，我们佣兵这行更是格外缺人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670121
					],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732670121,
					"content": "唉…和你说应该没什么关系。你看着我们镀金旅团人多，但佣兵这行太危险了啊，护送商队这类的活还好，顶多是累点…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670122
					],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732670122,
					"content": "但要是出一趟和学者们有关的活，那真是全程都把脑袋别裤腰带上，跑一趟活回来，只要不缺胳膊少腿就谢天谢地了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670123
					],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732670123,
					"content": "一般的兄弟跑完这种活回来，少说也要歇个十天半月，那他的这个空就要有人补上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670124
					],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732670124,
					"content": "须弥这么大，学者这么多，每天都不断地有新活进来，我们几乎都在连轴转了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670125
					],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732670125,
					"content": "再不招点人，我们可真是要撑不住了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670126
					],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732670126,
					"content": "那你招到人了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670127
					]
				},
				{
					"id": 732670127,
					"content": "你说这个村子吗？哈哈…一个人都没招到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670128
					],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732670128,
					"content": "呃…也不能说是没招到吧，只能说，想招的人不想来，想来的人招不得…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670129
					],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732670129,
					"content": "你要是不信，就跟着我走一圈吧…说不定走完这一趟，你就愿意加入我们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670130
					],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732670130,
					"content": "…哎呀，开个玩笑嘛，你都说了不想加入了，我也不会勉强你。我就是想找个人陪我到处走走而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670132
					],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732670132,
					"content": "陪你走走倒是没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670131
					]
				},
				{
					"id": 732670131,
					"content": "嘿嘿，谢谢你啦。我看看啊，这个…我们先去找萨尼娅好了，她白天应该有空，晚上嘛…她还要忙着和杰巴里讨论生活大事呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732670117,
					"content": "冒险家协会的事就够多了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670118
					]
				},
				{
					"id": 732670112,
					"content": "你这套说得挺熟练啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670113
					]
				},
				{
					"id": 732670106,
					"content": "我已经有很多委托要做了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670107
					]
				}
			]
		},
		{
			"id": 7326703,
			"completionStepIds": [
				7326703
			],
