			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"萨尼娅",
					"阿提亚"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732670301,
					"content": "真让人发愁…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670302
					],
					"speakerTitle": "萨尼娅"
				},
				{
					"id": 732670302,
					"content": "萨尼娅！上午好啊，你在选什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670303
					],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732670303,
					"content": "阿提亚…我都说过了，杰巴里对镀金旅团没什么兴趣，我也不想他去做什么佣兵，你就别想让我帮着你说话了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670304
					],
					"speakerTitle": "萨尼娅"
				},
				{
					"id": 732670304,
					"content": "哎呀，杰巴里的厨艺那么好，去镀金旅团里准能混个好职位，你们家的收入也会好很多啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670305
					],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732670305,
					"content": "而且他不也说过，想要外出找点活干吗？如果他真想外出工作，有我这个熟人介绍当然是最好的啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670306
					],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732670306,
					"content": "你就听他说吧，他隔一段时间就会说一次这种话，过几天就再反悔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670307
					],
					"speakerTitle": "萨尼娅"
				},
				{
					"id": 732670307,
					"content": "说到最后，他就是舍不得我一个人待在村里…我也舍不得他一个人出去打拼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670308
					],
					"speakerTitle": "萨尼娅"
				},
				{
					"id": 732670308,
					"content": "更何况，是每天都去玩命的佣兵！所以你就别想了，就算杰巴里想去，我也会拦着他的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670309
					],
					"speakerTitle": "萨尼娅"
				},
				{
					"id": 732670309,
					"content": "好了，话就说到这里，我还要买东西呢，你去找别人吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670310
					],
					"speakerTitle": "萨尼娅"
				},
				{
					"id": 732670310,
					"content": "呼…好吧。旅行者， 你看见了吧，这就是我每天工作的状况。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670311
					],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732670311,
					"content": "我们接下来去找福迪尔吧，他…曾经是我们的人，但后来退出了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670312
					],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732670312,
					"content": "要是我能把他劝回来，那就再好不过了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿提亚"
				}
			]
		},
		{
			"id": 7326705,
			"completionStepIds": [
				7326705
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7326705",
							"2"
						],
						"stepId": 7326705,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"福迪尔",
					"阿提亚"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732670501,
					"content": "阿提亚，你怎么又来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670502
					],
					"speakerTitle": "福迪尔"
				},
				{
					"id": 732670502,
					"content": "嘿嘿，百折不挠是咱们镀金旅团的优良品质嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670503
					],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732670503,
					"content": "那你也应该知道，坚持原则更是我的处事方法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670504
					],
					"speakerTitle": "福迪尔"
				},
				{
					"id": 732670504,
					"content": "福迪尔大哥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670505
					],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732670505,
					"content": "我已经退出镀金旅团了，你不用这么称呼我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670506
					],
					"speakerTitle": "福迪尔"
				},
				{
					"id": 732670506,
					"content": "唉，福迪尔先生。你真的不考虑回去看看吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670507
					],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732670507,
					"content": "虽然有些兄弟的作风是有点…呃…冒进，但还是有很多兄弟遵纪守法啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670508
					],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732670508,
					"content": "阿提亚，我说过了，我不会再回去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670509
					],
					"speakerTitle": "福迪尔"
				},
				{
					"id": 732670509,
					"content": "你说的那些事情，我都已经用我自己的眼睛确认过了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670510
					],
					"speakerTitle": "福迪尔"
				},
				{
					"id": 732670510,
					"content": "也许镀金旅团里不全是目无法纪之人，也不是每个镀金旅团成员都喜欢做那些趁火打劫的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670511
					],
					"speakerTitle": "福迪尔"
				},
				{
					"id": 732670511,
					"content": "但阿提亚…恶行会传播。只要有一个人违法乱纪，那他周围的人就会受到影响…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670522
					],
					"speakerTitle": "福迪尔"
				},
				{
					"id": 732670522,
					"content": "一个人影响一群人，那一群人再不断地开展行动，对更多人造成影响…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670523
					],
					"speakerTitle": "福迪尔"
				},
				{
					"id": 732670523,
					"content": "阿提亚，这些情况你应该比我更清楚吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670512
					],
					"speakerTitle": "福迪尔"
				},
				{
					"id": 732670512,
					"content": "在这种氛围里…恶行易施啊，阿提亚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670513
					],
					"speakerTitle": "福迪尔"
				},
				{
					"id": 732670513,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670514
					],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732670514,
					"content": "你想劝我回去，我也想劝你离开。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670515
					],
					"speakerTitle": "福迪尔"
				},
				{
					"id": 732670515,
					"content": "也许在你眼里，镀金旅团这个团体虽然称不上有道德，但也不能算是恶劣…但人不能永远生活在灰色地带里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670516
					],
					"speakerTitle": "福迪尔"
				},
				{
					"id": 732670516,
					"content": "…这只是我对你的忠告。具体如何，还得你自己做出决断。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670517
					],
					"speakerTitle": "福迪尔"
				},
				{
					"id": 732670517,
					"content": "我知道的，福迪尔大哥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670518
					],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732670518,
					"content": "嗯。如果你真的退出了…同时也想谋个生计，我会帮你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670519
					],
					"speakerTitle": "福迪尔"
				},
				{
					"id": 732670519,
					"content": "你没事吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670520
					]
				},
				{
					"id": 732670520,
					"content": "哈哈哈，我就是辩不过福迪尔大哥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670521
					],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732670521,
					"content": "接下来…哈哈，咱们先回去休息一下吧，说了这么多话，我喉咙都痛了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿提亚"
				}
			]
		},
