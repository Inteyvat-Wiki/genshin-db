				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732670601,
					"content": "阿提亚叔叔！你还在招募人加入镀金旅团吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670602
					],
					"speakerTitle": "艾登"
				},
				{
					"id": 732670602,
					"content": "艾登，你怎么又跑出来了，和你妈妈说过了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670603
					],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732670603,
					"content": "说过啦！妈妈在工作，我就自己来找卡里玛玩了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670604
					],
					"speakerTitle": "艾登"
				},
				{
					"id": 732670604,
					"content": "你好呀，阿提亚叔叔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670605
					],
					"speakerTitle": "卡里玛"
				},
				{
					"id": 732670605,
					"content": "阿提亚叔叔，我上次和你说的事，你觉得怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670606
					],
					"speakerTitle": "艾登"
				},
				{
					"id": 732670606,
					"content": "我一直都在锻炼，还和卡里玛一起训练了很久…她都已经快要跑不过我啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670607
					],
					"speakerTitle": "艾登"
				},
				{
					"id": 732670607,
					"content": "谁跑不过你了，我只不过是那天中饭没有吃饱而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670608
					],
					"speakerTitle": "卡里玛"
				},
				{
					"id": 732670608,
					"content": "总之，我可是按照你给我制订的计划训练了好久…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670609
					],
					"speakerTitle": "艾登"
				},
				{
					"id": 732670609,
					"content": "阿提亚叔叔，你今天再给我测试一下吧！看看我够不够格加入镀金旅团！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670610,
						732670611
					],
					"speakerTitle": "艾登"
				},
				{
					"id": 732670610,
					"content": "这就是你说的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670612
					]
				},
				{
					"id": 732670612,
					"content": "咳…好！艾登，今天我就以镀金旅团成员的身份，再次对你进行测验！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670613
					],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732670613,
					"content": "好耶！卡里玛，你也来测测看吧，我们一起加油！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670614
					],
					"speakerTitle": "艾登"
				},
				{
					"id": 732670614,
					"content": "我可不想加入镀金旅团，我只想留在村里，好好保护大家…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670615
					],
					"speakerTitle": "卡里玛"
				},
				{
					"id": 732670615,
					"content": "不过…让阿提亚叔叔帮我测验一下也不错，我可是向坎蒂丝姐姐请教过锻炼方法的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670616
					],
					"speakerTitle": "卡里玛"
				},
				{
					"id": 732670616,
					"content": "欸？！你什么时候…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670617
					],
					"speakerTitle": "艾登"
				},
				{
					"id": 732670617,
					"content": "哈哈哈，你们俩这么有活力，很不错！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670618
					],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732670618,
					"content": "艾登，你也不要瘪着嘴了，有机会的话，我也带着你去向迪希雅请教锻炼方法，怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670619
					],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732670619,
					"content": "真的？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670620
					],
					"speakerTitle": "艾登"
				},
				{
					"id": 732670620,
					"content": "镀金旅团成员说的话，绝对不作假。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670621
					],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732670621,
					"content": "不过，今天咱们在开始测验之前，就先让这位旅行者来示范一下标准动作吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670622,
						732670624
					],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732670622,
					"content": "还有我的事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670623
					]
				},
				{
					"id": 732670623,
					"content": "…之前我可没机会做示范啊。我总不可能自己跑去示范，然后把这俩孩子单独留在这里吧，那样也太危险了…这次就拜托你了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670626
					],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732670626,
					"content": "咳，这位旅行者是一位实力强劲的冒险家，我可是好不容易才请过来为你们做示范的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670627
					],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732670627,
					"content": "艾登，卡里玛，你们两个可要看好了喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670628
					],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732670628,
					"content": "嗯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670629
					],
					"speakerTitle": "艾登"
				},
				{
					"id": 732670629,
					"content": "冒险家…是冒险家协会里的那种人吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670630
					],
					"speakerTitle": "卡里玛"
				},
				{
					"id": 732670630,
					"content": "无论是佣兵还是守卫，在执行任务的时候，都会遇见某些必须先行撤退的情况。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670631
					],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732670631,
					"content": "这个时候，我们往往就需要…跑得越快越好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670632
					],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732670632,
					"content": "旅行者，就拜托你了，咱们先来演练一下…嗯…迅速撤退的方法吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670633
					],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732670633,
					"content": "起点就在那里，就拜托你进行示范了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732670624,
					"content": "你之前没示范过吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670625
					]
				},
				{
					"id": 732670625,
					"content": "…我之前还得分神照顾这俩孩子，怎么可能去示范什么标准动作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670634
					],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732670634,
					"content": "…总之，这次就拜托你了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670626
					],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732670611,
					"content": "想来的人？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670612
					]
				}
			]
		},
