			},
			"dialogs": [
				{
					"id": 732671001,
					"content": "呜…那些蝎子好…好大…根本不敢靠近…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671002
					],
					"speakerTitle": "艾登"
				},
				{
					"id": 732671002,
					"content": "我明明用箭射中它们了，为什么一点反应都没有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671003
					],
					"speakerTitle": "卡里玛"
				},
				{
					"id": 732671003,
					"content": "但是…你怎么这么轻松就打倒了它们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671004,
						732671005
					],
					"speakerTitle": "卡里玛"
				},
				{
					"id": 732671004,
					"content": "久经锻炼的结果。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732671006
					]
				},
				{
					"id": 732671006,
					"content": "呜…明明坎蒂丝姐姐说，我已经很有进步了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671007
					],
					"speakerTitle": "卡里玛"
				},
				{
					"id": 732671007,
					"content": "卡里玛，别这么沮丧嘛，只要每天都进步一点，总有一天你也会拥有强大的实力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671008
					],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732671008,
					"content": "艾登也是，只要这么持续锻炼下去，加入镀金旅团也只是时间问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671009
					],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732671009,
					"content": "唔唔，要是能向迪希雅姐姐当面请教武艺的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671010
					],
					"speakerTitle": "艾登"
				},
				{
					"id": 732671010,
					"content": "下次见到坎蒂丝姐姐的时候，一定要拜托她再指导我训练！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671011
					],
					"speakerTitle": "卡里玛"
				},
				{
					"id": 732671011,
					"content": "这两个孩子…都很有干劲嘛，哈哈哈哈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671012,
						732671013
					],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732671012,
					"content": "结果你还是没招到人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732671014
					]
				},
				{
					"id": 732671014,
					"content": "咳咳…咳…你不要哪壶不开提哪壶啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671015
					],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732671015,
					"content": "工作的事就再说吧…而且，我的宣讲又不是没有成效。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671016
					],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732671016,
					"content": "在听了我的宣传后，村里的许多年轻人都想去村外看看呢，虽然…他们都不太想加入镀金旅团。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671017
					],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732671017,
					"content": "先不说这些了，我得带着这两个孩子回村里了，出来这么久，她们家的大人该着急了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671018
					],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732671018,
					"content": "这些报酬是给你的，谢谢你陪我跑这么一趟，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671019
					],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732671019,
					"content": "唉，过段时间我还要回去团里述职，这该怎么交代…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671020
					],
					"speakerTitle": "阿提亚"
				},
				{
					"id": 732671020,
					"content": "对了，阿提亚叔叔，你还没给我们测验呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671021
					],
					"speakerTitle": "艾登"
				},
				{
					"id": 732671021,
					"content": "啊？是…是啊，我们先回去吧，回村之后我再给你们测验一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿提亚"
				},
