			"trigger": {
				"objectNames": [
					"「寝子」",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722120101,
					"content": "汝等来得正好，来帮奴家做件事吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120102
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722120102,
					"content": "什么事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120103
					]
				},
				{
					"id": 722120103,
					"content": "奴家想要…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120104
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722120104,
					"content": "在神社旁边，放一块很高很高，很大很大，和奴家一个样子的石头。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120105
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722120105,
					"content": "上、上哪找这样的石头…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722120106,
					"content": "是说雕像对吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120107
					]
				},
				{
					"id": 722120107,
					"content": "总之，奴家要的东西，和好远好远的那个岛上的狐狸石头一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120108
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722120108,
					"content": "阿响说过，在那个岛上，有好多狐狸石头，还说，要不要给奴家也弄一个。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120109
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722120109,
					"content": "奴家觉得，阿响想要的，一定是好的。所以，汝等帮忙弄个石头吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120110,
						722120113
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722120110,
					"content": "我没有雕刻的手艺…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120111
					]
				},
				{
					"id": 722120111,
					"content": "唔，要怎么办呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722120112,
					"content": "对了，去找大祐吧！他这么喜欢猫，说不定能为了寝子学会雕刻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722120113,
					"content": "去找大祐帮忙好了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120114
					]
				},
				{
					"id": 722120114,
					"content": "有道理！他这么喜欢猫，说不定能帮得上忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7221202,
			"completionStepIds": [
				7221202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221202",
							"2"
						],
						"stepId": 7221202,
