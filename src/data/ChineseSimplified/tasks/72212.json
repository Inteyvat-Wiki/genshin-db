			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"大祐",
					"悦子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722120201,
					"content": "喔！你好，今天又在忙什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120202
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722120202,
					"content": "帮寝子做雕像。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120203
					]
				},
				{
					"id": 722120203,
					"content": "哈…哈？做雕像，在这里？真的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120204
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722120204,
					"content": "我、我这就去学雕刻技术！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120205
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722120205,
					"content": "来、来不及吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120206
					]
				},
				{
					"id": 722120206,
					"content": "又是那位寝子拜托你的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120207
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722120207,
					"content": "说起来，因为踏鞴砂那边的问题，很多工匠都在找工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120208
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722120208,
					"content": "协会之前接到过不少相关的委托，据我所知，有人似乎还留在踏鞴砂附近，一直在找工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120209
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722120209,
					"content": "我之前去执行协会委托的时候，也见到了一个类似的营地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120210
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722120210,
					"content": "如果你们愿意的话，倒是可以去那边碰碰运气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120211,
						722120212
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722120211,
					"content": "谢谢你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120214
					]
				},
				{
					"id": 722120214,
					"content": "呵呵…不用在意，只不过是举手之劳而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120215
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722120215,
					"content": "我也很想看看，这座神社如果真能热闹起来的话…会发生什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120216
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722120216,
					"content": "特别是那位「阿响」…到底是一位怎么样的人，能让那位寝子这么在意呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120217
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722120217,
					"content": "好了，你也别在这听我自言自语了，快去找工匠吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120218
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722120218,
					"content": "至于你们找到的工匠会不会雕石雕…呵呵，那就全凭你们的运气了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120219
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722120219,
					"content": "悦子小姐，其实你也是想帮帮寝子大人对吧？哈哈哈，你可真是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120220
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722120220,
					"content": "大祐，调查计划写好了没有？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120221
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722120221,
					"content": "呃！马、马上就好，实在对不起…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大祐"
				},
				{
					"id": 722120212,
					"content": "悦子小姐感觉和平时不太一样…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120213
					]
				},
				{
					"id": 722120213,
					"content": "怎么？我这么主动地给你们信息，你有些不习惯吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120214
					],
					"speakerTitle": "悦子"
				}
			]
		},
		{
			"id": 7221203,
			"completionStepIds": [
				7221204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
