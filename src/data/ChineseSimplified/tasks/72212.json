				"objectNames": [
					"？？？",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722120301,
					"content": "唉，到底什么时候才能找到工作…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120302
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722120302,
					"content": "你们…是来找我的吗？有什么事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120303,
						722120304
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722120303,
					"content": "你会做石雕吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120305
					]
				},
				{
					"id": 722120305,
					"content": "咦？那…那太好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120306
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722120306,
					"content": "我都忘了自我介绍了…我叫大岛纯平，之前是在踏鞴砂干活的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120307
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722120307,
					"content": "出了意外之后，我和其他人也都被疏散了出去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120308
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722120308,
					"content": "但是…到现在我也没有接到复工的消息，就这么一直闲在这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120309
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722120309,
					"content": "你们是在找做石雕的人对吧？我会一点石雕的手艺，虽然不是特别专业…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120310
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722120310,
					"content": "你们要做怎么样的石雕？能告诉我吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120311
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722120311,
					"content": "是这样的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120312
					]
				},
				{
					"id": 722120312,
					"content": "呃，会说话的猫，要你们找一个工匠，帮它雕一座石雕？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120313
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722120313,
					"content": "不、不是我不相信，是这件事实在有点…有点离谱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120314
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722120314,
					"content": "其他的不论，就算我答应了你们，那…那位「代宫司」大人，怎么支付报酬呢？我可不能做白工啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120315
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722120315,
					"content": "放心吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120316
					]
				},
				{
					"id": 722120316,
					"content": "（真、真的可以放心吗…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722120317,
					"content": "这样啊，这…我总觉得你们在骗我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120318
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722120318,
					"content": "但是…算了，闲着也是闲着，我就和你们走一趟吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120319
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722120319,
					"content": "希望对方真的能支付报酬…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "？？？"
				},
				{
					"id": 722120304,
					"content": "我们正在找会做石雕的工匠。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120305
					]
				}
			]
		},
		{
			"id": 7221204,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221205",
							"2"
						],
						"stepId": 7221205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「寝子」",
					"大岛纯平",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722120401,
					"content": "汝等回来了。这个人类想必便是石头人类，对吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120402,
						722120403
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722120402,
					"content": "是我们请来的工匠。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120404
					]
				},
				{
					"id": 722120404,
					"content": "欸？欸！猫…猫说话了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120405
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 722120405,
					"content": "喵喵喵，汝可真是大惊小怪啊…奴家会说话很奇怪吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120406,
						722120407
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722120406,
					"content": "不要大惊小怪。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120408
					]
				},
				{
					"id": 722120408,
					"content": "喂！难道对你来说，这事情是一件很平常的事吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120409
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 722120409,
					"content": "确实很平常啦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120410
					]
				},
				{
					"id": 722120410,
					"content": "你到底都经历了什么啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120411
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 722120411,
					"content": "好啦，好啦，你们不要光顾着说话了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120412
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722120412,
					"content": "总之，石头人类，你能把石头，弄得和奴家一模一样吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120413
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722120413,
					"content": "咦？石头人类？我吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120414
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 722120414,
					"content": "敲石头…呃，你是说做石雕啊，我倒是可以试试看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120415
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 722120415,
					"content": "是吗？那太好了，喵喵喵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120416
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722120416,
					"content": "这、这样啊…无论如何，有份工作都是件好事。虽然我也从来没为一只猫工作过…报酬的事…之后再聊吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120417
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 722120417,
					"content": "呃，我得先去做点准备工作，这岛上倒是有不少石头，我得去好好挑一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120418
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 722120418,
					"content": "那个，我该怎么称呼你？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120419
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 722120419,
					"content": "喔，奴家是这座「浅濑神社」的代宫司，寝子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120420
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722120420,
					"content": "至于称呼，随汝喜欢就好，高高的，会敲石头的人类。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120421
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722120421,
					"content": "是吗？那我…就叫你代宫司大人吧，毕竟是发工钱的人嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120422
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 722120422,
					"content": "「宫前」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120423
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722120423,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120424
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 722120424,
					"content": "那、那我就先去周围看看，挑挑石头去了，你们先聊着。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120425
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 722120425,
					"content": "给一只猫工作，还真是新奇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120426
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 722120426,
					"content": "大岛先生，好像已经不想思考报酬的事情了呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722120407,
					"content": "只不过是猫会说话而已。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120408
					]
				},
				{
					"id": 722120403,
					"content": "对，石头人类。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120404
					]
				}
			]
		},
