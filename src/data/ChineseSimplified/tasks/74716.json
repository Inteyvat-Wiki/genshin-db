				]
			},
			"dialogs": [
				{
					"id": 747160101,
					"content": "太好了…这下，最主要的水下废弃物基本被打捞完了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160102
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747160102,
					"content": "#让你们受累了，{NICKNAME}和派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160103
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747160103,
					"content": "没有啦没有啦，比起受累这种说法，我更愿意说这次是收获满满哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160104,
						747160105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747160104,
					"content": "既帮助了修复水下环境。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160106
					]
				},
				{
					"id": 747160106,
					"content": "谢谢你们…托你们的福，我才度过了一段愉快而又充实的时光。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160107
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747160107,
					"content": "不用客气，这是大家的共同努力！而且，我觉得菲米尼也很有进步呢，水下和水上的时候都可靠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747160108,
					"content": "别害羞。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160109
					]
				},
				{
					"id": 747160109,
					"content": "好…好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160110
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747160110,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160111
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747160111,
					"content": "抱歉，除了感谢的话，我还是不知道这种时候应该说些什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160112
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747160112,
					"content": "可能…我还需要再多练习一段时间？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160113
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747160113,
					"content": "慢慢来，不着急。即使是练习，也按照自己的节奏一点一点努力就行啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160114,
						747160115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747160114,
					"content": "以后有机会，还可以这样合作。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160116
					]
				},
				{
					"id": 747160116,
					"content": "嗯，一定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160117
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747160117,
					"content": "…我本来以为，在任务完成之后，我会需要回水下独处一段时间的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160118
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747160118,
					"content": "但很神奇，和你们聊过天…就连天空也变得非常宁静。我想把此刻的这种心情…告诉你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160119
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747160119,
					"content": "那…我今天先回去和林尼他们会合了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160120
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747160120,
					"content": "余下的水底勘测信息，就交给你们了。祝愿你们能够找到满意的收获。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160121
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747160121,
					"content": "哟，我在楼上就听见你们庆祝的声音了。看来是有好事发生？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160122
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747160122,
					"content": "嗯！我们把影响鱼儿们生活的废品基本打捞完了，还找到了钢琴剩下的部件！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747160123,
					"content": "真的吗？我看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160124
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747160124,
					"content": "…还真是。有了这些，我就能修好这架钢琴了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160125
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747160125,
					"content": "虽说不是复原得和当初一模一样，但也能再次让它流出好听的音乐了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160126
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747160126,
					"content": "你听起来很开心嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747160127,
					"content": "有…有吗？不管了，我现在就去修复它，花不了多少时间。你们帮我装点一下这里吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160128
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747160128,
					"content": "只有好看的舞台，才配得上你的乐声。哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160129
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747160129,
					"content": "她果然很高兴啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747160130,
					"content": "哇！好漂亮的钢琴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160131,
						747160132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747160131,
					"content": "好典雅！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160133
					]
				},
				{
					"id": 747160133,
					"content": "哼哼，那当然。也不看看是谁修的。我还为它重新加固了一下机械联动装置，翻新了一下外装。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160134
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747160134,
					"content": "你们干得也不赖嘛，这舞台也配得上它了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160135
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747160135,
					"content": "哎呀呀，小事小事。快别说那么多了，你现在不弹一首吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160136
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747160136,
					"content": "…欸？现在？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160137
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747160137,
					"content": "不然呢？你修好它不就是为了弹的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160138
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747160138,
					"content": "今天…就算了吧！以后有机会再弹也不迟！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160139,
						747160140
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747160139,
					"content": "忘谱了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160141
					]
				},
				{
					"id": 747160141,
					"content": "啧…啰嗦…！我只是想先安静地和它待待，怀念一下过去的时光而已！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160142
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747160142,
					"content": "别以为随便挑衅我两句我就会答应，哼，回去练练再来吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747160140,
					"content": "害羞了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160141
					]
				},
				{
					"id": 747160132,
					"content": "好华丽！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160133
					]
				},
				{
					"id": 747160115,
					"content": "下次有事情，还可以来找我们。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160116
					]
				},
				{
					"id": 747160105,
					"content": "又找到了许多漂亮宝藏。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160106
					]
				}
			]
		}
	]
}