			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"古谷升"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721630201,
					"content": "真是头疼啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630202
					],
					"speakerTitle": "古谷升"
				},
				{
					"id": 721630202,
					"content": "关于这张图…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630203
					]
				},
				{
					"id": 721630203,
					"content": "这张图上的地形，看起来像是清籁岛的某处呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630204
					],
					"speakerTitle": "古谷升"
				},
				{
					"id": 721630204,
					"content": "你是怎么看出来的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630205
					]
				},
				{
					"id": 721630205,
					"content": "毕竟协会也发布过一些和清籁岛有关的探索委托。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630206
					],
					"speakerTitle": "古谷升"
				},
				{
					"id": 721630206,
					"content": "那些接下了委托的冒险家，回来协会报告的时候，也带回来了一些和清籁岛有关的情报。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630207
					],
					"speakerTitle": "古谷升"
				},
				{
					"id": 721630207,
					"content": "但因为人手问题，我们暂时也没办法组织大规模的探索，只能每隔一段时间派遣几位冒险家过去探索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630208
					],
					"speakerTitle": "古谷升"
				},
				{
					"id": 721630208,
					"content": "所以，我手里关于清籁岛的情报也有限，没办法再帮你继续解读这张图了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630209
					],
					"speakerTitle": "古谷升"
				},
				{
					"id": 721630209,
					"content": "不过，我倒是知道城里有一位和清籁岛有关的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630210
					],
					"speakerTitle": "古谷升"
				},
				{
					"id": 721630210,
					"content": "他叫太田太郎，据他说…他的祖先曾经居住在清籁岛，后来因为各种原因才移居到了这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630211
					],
					"speakerTitle": "古谷升"
				},
				{
					"id": 721630211,
					"content": "前段时间，他还来过协会，说是想雇佣几位冒险家，陪他回去清籁岛看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630212
					],
					"speakerTitle": "古谷升"
				},
				{
					"id": 721630212,
					"content": "你可以拿着这张图去找太田太郎先生问问，说不定他会知道些什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "古谷升"
				}
			]
		},
		{
			"id": 7216303,
			"completionStepIds": [
				7216302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
