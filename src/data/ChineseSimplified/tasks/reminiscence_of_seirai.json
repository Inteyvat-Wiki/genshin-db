			"trigger": {
				"objectNames": [
					"太田太郎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721630401,
					"content": "你回来了，怎么样？你记录到画片了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630402
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630402,
					"content": "已经记录到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630403
					]
				},
				{
					"id": 721630403,
					"content": "太好了，我来看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630404
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630404,
					"content": "呃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630405
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630405,
					"content": "哈哈哈，完全看不出来是什么地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630406
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630406,
					"content": "不过，那三张画上的景致，还真是变了不少啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630407
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630407,
					"content": "不知道那位藤原俊子小姐…能不能认出这些地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630408
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630408,
					"content": "不过…哈哈，我想她应该也很难能认出来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630409
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630409,
					"content": "她也是从清籁岛来的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630410
					]
				},
				{
					"id": 721630410,
					"content": "准确地说，是和我一样，祖上曾经在清籁岛上居住过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630411
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630411,
					"content": "哎呀，其实稻妻城里还有很多祖上曾经住在清籁岛上的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630412
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630412,
					"content": "你们为什么从清籁岛搬走？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630413
					]
				},
				{
					"id": 721630413,
					"content": "我记不太清楚了…毕竟是好久之前的事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630414
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630414,
					"content": "好像是因为雷暴太猛了，还是为了预防偷渡和走私什么的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630415
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630415,
					"content": "总之，在幕府的统一安排下，清籁岛上的人基本上都迁到了鸣神岛上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630416
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630416,
					"content": "哦，先不说闲话了，这些东西给你，收下吧，谢谢你帮我跑这一趟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630417
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630417,
					"content": "唉，我到底什么时候才能亲自去一趟清籁岛呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630418
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630418,
					"content": "还是先忙完手上这一单生意吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "太田太郎"
				}
			]
		},
