			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"太田太郎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721630301,
					"content": "唉，什么时候才能找到人陪我回去看看呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630302
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630302,
					"content": "关于这张图…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630303
					]
				},
				{
					"id": 721630303,
					"content": "你是…冒险家协会的冒险家吗？他们终于抽出人手了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630304
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630304,
					"content": "我只是个路过的旅行者啦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630305
					]
				},
				{
					"id": 721630305,
					"content": "好吧…你想给我看什么图？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630306
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630306,
					"content": "我看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630307
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630307,
					"content": "这、这！难道这是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630308,
						721630309
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630308,
					"content": "你看出什么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630310
					]
				},
				{
					"id": 721630310,
					"content": "这不是清籁岛吗！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630311,
						721630312
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630311,
					"content": "是。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630313
					]
				},
				{
					"id": 721630313,
					"content": "哈哈哈，真是清籁岛吗？我也是猜的啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630314
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630314,
					"content": "虽然我祖上曾经住在清籁岛上，但那已经是很久之前的事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630315
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630315,
					"content": "到了我这一代，对清籁岛就基本上都没什么印象了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630316
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630316,
					"content": "家里和清籁岛有关的东西…也只有三张清籁岛的景致画了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630317
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630317,
					"content": "那你为什么想回去？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630318
					]
				},
				{
					"id": 721630318,
					"content": "这个嘛…怎么说呢，那里毕竟也算是我的「故乡」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630319
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630319,
					"content": "我总有一种…无论如何都得去看看的感觉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630320
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630320,
					"content": "不过现在我的生意忙得不行，一时间抽不开身。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630321
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630321,
					"content": "而且…我也找不到能护送我去清籁岛的冒险家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630322
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630322,
					"content": "所以，我就退而求其次，在冒险家协会那边挂了一个委托。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630323
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630323,
					"content": "希望有冒险家可以代我去清籁岛上，找到那三张画里的地点，用「留影机」记录几张画片回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630324
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630324,
					"content": "但是到现在也没有冒险家接下这个委托，唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630325,
						721630326
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630325,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630327
					]
				},
				{
					"id": 721630327,
					"content": "是、是吗？！你愿意帮忙的话那就太好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630328
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630328,
					"content": "报酬的事不用担心，我一定给你准备齐全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630329
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630329,
					"content": "那就拜托你了。算上你拿过来的那一张图，总共四张图…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630330
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630330,
					"content": "请你去清籁岛上，在这四个地点，分别记录一张画片回来给我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630326,
					"content": "我可以帮你跑这一趟。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630327
					]
				},
				{
					"id": 721630312,
					"content": "你说得很对…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630313
					]
				},
				{
					"id": 721630309,
					"content": "这是你家吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630310
					]
				}
			]
		},
		{
			"id": 7216304,
			"completionStepIds": [
				7216307,
				7216310
