			"trigger": {
				"objectNames": [
					"岩藏光造"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721100101,
					"content": "我究竟是为什么而离开道馆，成为九条大人的指南的呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100102
					],
					"speakerTitle": "岩藏光造"
				},
				{
					"id": 721100102,
					"content": "柳叶和冈崎，还有三船…又为什么会离开我呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "岩藏光造"
				}
			]
		},
		{
			"id": 7211002,
			"completionStepIds": [
				7211015
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7211007",
							"3"
						],
						"stepId": 7211007,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7211015",
							"2"
						],
						"stepId": 7211015,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"冈崎寅卫门",
					"柳叶岚士"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721100201,
					"content": "…现在，只差岩藏光胤的刀了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100202
					],
					"speakerTitle": "冈崎寅卫门"
				},
				{
					"id": 721100202,
					"content": "岩藏家祖传的「薄缘满光天目」吗。当初你和久仁彦刚被收养的时候，趁前代的永胤大人不注意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100203
					],
					"speakerTitle": "柳叶岚士"
				},
				{
					"id": 721100203,
					"content": "我们已经「破门」了。不用叫大人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100204
					],
					"speakerTitle": "冈崎寅卫门"
				},
				{
					"id": 721100204,
					"content": "但是，冈崎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100205
					],
					"speakerTitle": "柳叶岚士"
				},
				{
					"id": 721100205,
					"content": "「将『情』与『义』置于天平两端，真正的剑士只有『义』之道可走。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100206
					],
					"speakerTitle": "柳叶岚士"
				},
				{
					"id": 721100206,
					"content": "既然师父这么说，那就说明他不情愿将我们逐出师门，但又没有其他的选择。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100207
					],
					"speakerTitle": "柳叶岚士"
				},
				{
					"id": 721100207,
					"content": "当然不愿意了。但既然他已经决定成为将军的刀，贯彻眼狩令，那我们也只能…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100208
					],
					"speakerTitle": "冈崎寅卫门"
				},
				{
					"id": 721100208,
					"content": "我们只能选择我们自己的道义了。毕竟，「真正的剑士只有『义』之途可走。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100209
					],
					"speakerTitle": "柳叶岚士"
				},
				{
					"id": 721100209,
					"content": "但是，师父的道义，终究也被挫败了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100210
					],
					"speakerTitle": "柳叶岚士"
				},
				{
					"id": 721100210,
					"content": "没错。不止是久仁彦的仇，其他人，还有岩藏光胤的仇，我们都要报。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100211
					],
					"speakerTitle": "冈崎寅卫门"
				},
				{
					"id": 721100211,
					"content": "这就是我们这些破门弟子的道义。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100212
					],
					"speakerTitle": "冈崎寅卫门"
				},
				{
					"id": 721100212,
					"content": "这也是师父的保佑吧。第一个仇家，就这样送上门来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100213
					],
					"speakerTitle": "柳叶岚士"
				},
				{
					"id": 721100213,
					"content": "#也对。{NICKNAME}就是你吧。你的事迹，我已经听说了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100214
					],
					"speakerTitle": "冈崎寅卫门"
				},
				{
					"id": 721100214,
					"content": "在剑士的世界里，只有用血才可以洗净「血」。面对岩藏流「免许皆传」的准备，你已经准备好了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "冈崎寅卫门"
				}
			]
		},
		{
			"id": 7211003,
			"completionStepIds": [
				7211014
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
