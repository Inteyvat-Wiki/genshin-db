				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"岩藏光造"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721100301,
					"content": "我究竟是为什么而离开道馆，成为九条大人的指南的呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100302
					],
					"speakerTitle": "岩藏光造"
				},
				{
					"id": 721100302,
					"content": "柳叶和冈崎，还有三船…又为什么会离开我呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100303
					],
					"speakerTitle": "岩藏光造"
				},
				{
					"id": 721100303,
					"content": "岩藏流的门生，我已经拜会过了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100304
					]
				},
				{
					"id": 721100304,
					"content": "是吗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100305
					],
					"speakerTitle": "岩藏光造"
				},
				{
					"id": 721100305,
					"content": "现在还有人，会以岩藏流的名号自居吗。明明宗主是这么不成器的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100306
					],
					"speakerTitle": "岩藏光造"
				},
				{
					"id": 721100306,
					"content": "我是岩藏光造，姑且在这里担任剑道指南。阁下是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100307
					],
					"speakerTitle": "岩藏光造"
				},
				{
					"id": 721100307,
					"content": "#我是{NICKNAME}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100308
					]
				},
				{
					"id": 721100308,
					"content": "三船、丹波…你见到他们了吗？还有冈崎兄弟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100309
					],
					"speakerTitle": "岩藏光造"
				},
				{
					"id": 721100309,
					"content": "还有片山。他喜欢在一决胜负之前，给这场比试取名。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100310
					],
					"speakerTitle": "岩藏光造"
				},
				{
					"id": 721100310,
					"content": "因为，「如果将来我成为了真正的剑豪，那这些比试都是可以写成故事的」。哈哈哈，真是瞎胡闹…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100311
					],
					"speakerTitle": "岩藏光造"
				},
				{
					"id": 721100311,
					"content": "对了，还有从「永胤」的时代到「光胤」的时代，都无法突破「初传」的岛田。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100312
					],
					"speakerTitle": "岩藏光造"
				},
				{
					"id": 721100312,
					"content": "他们因为无法领会将军大人「眼狩令」的气量，似乎是落草为寇了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100313
					],
					"speakerTitle": "岩藏光造"
				},
				{
					"id": 721100313,
					"content": "过去指导他们握刀挥剑的岁月，真是令人怀念。我究竟为什么关闭了道馆，来到了军中呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100314
					],
					"speakerTitle": "岩藏光造"
				},
				{
					"id": 721100314,
					"content": "#{NICKNAME}阁下，他们的本领如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100315,
						721100316
					],
					"speakerTitle": "岩藏光造"
				},
				{
					"id": 721100315,
					"content": "很遗憾…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100317
					]
				},
				{
					"id": 721100317,
					"content": "是吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100318
					],
					"speakerTitle": "岩藏光造"
				},
				{
					"id": 721100318,
					"content": "#那么，{NICKNAME}阁下，你师承自谁？土门？还是说，是涉川的流派？难道是鸣神亲传？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100319
					],
					"speakerTitle": "岩藏光造"
				},
				{
					"id": 721100319,
					"content": "应该算是「我流」吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100320
					]
				},
				{
					"id": 721100320,
					"content": "原来如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100321
					],
					"speakerTitle": "岩藏光造"
				},
				{
					"id": 721100321,
					"content": "看来岩藏流，终究还是在我手上没落了。亲自教出来的弟子，在真剑比试中竟然无法胜过没有师承的野小子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100322
					],
					"speakerTitle": "岩藏光造"
				},
				{
					"id": 721100322,
					"content": "…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100323
					]
				},
				{
					"id": 721100323,
					"content": "这样啊，我明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100324
					],
					"speakerTitle": "岩藏光造"
				},
				{
					"id": 721100324,
					"content": "无论你的流派是什么，都无所谓了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100325
					],
					"speakerTitle": "岩藏光造"
				},
				{
					"id": 721100325,
					"content": "看来岩藏流，终究还是在我手上没落了。亲自教出来的弟子，在真剑比试中竟然无法胜过不愿自报家门的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100326
					],
					"speakerTitle": "岩藏光造"
				},
				{
					"id": 721100326,
					"content": "我姑且是岩藏流不成器的宗主。作为剑客，名号是「岩藏光胤」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100327
					],
					"speakerTitle": "岩藏光造"
				},
				{
					"id": 721100327,
					"content": "虽然秘剑的心得我已经不记得了，「神之眼」也交给了将军大人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100328
					],
					"speakerTitle": "岩藏光造"
				},
				{
					"id": 721100328,
					"content": "…不过，若是要为那些不甘于我的堕落，而走上忤逆的恶鬼之道，",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100329
					],
					"speakerTitle": "岩藏光造"
				},
				{
					"id": 721100329,
					"content": "却又不那么成器、败在了你手下的门生报仇的情义，还是有的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100330
					],
					"speakerTitle": "岩藏光造"
				},
				{
					"id": 721100330,
