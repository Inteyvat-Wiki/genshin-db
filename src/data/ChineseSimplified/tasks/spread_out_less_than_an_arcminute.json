					}
				]
			},
			"dialogs": [
				{
					"id": 746790101,
					"content": "进入阵位，全员列队，铳枪抵肩，迅速瞄准，精确射击，拒止敌人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746790102
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 746790102,
					"content": "欢迎参与「特巡队」的特别活动，体验铳枪射手的快乐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746790103,
						746790104
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 746790103,
					"content": "铳枪？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746790105
					]
				},
				{
					"id": 746790105,
					"content": "提到了我们不太熟悉的概念呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746790106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746790106,
					"content": "不过看这位警备队员的摊位，难道她说的活动也和「千灵映影节」有关吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746790107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746790107,
					"content": "啊！是「超天顶领队级战力」！您居然出现了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746790108
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 746790108,
					"content": "如果有您帮忙宣传，那我一定能完成任务指标！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746790109,
						746790110
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 746790109,
					"content": "你说谁呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746790111
					]
				},
				{
					"id": 746790111,
					"content": "#呃啊，那个什么什么战力，又是我和{NICKNAME}的奇怪外号吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746790112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746790112,
					"content": "没错没错，这是你们两位在一部分警备队员之中流传的美称！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746790113
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 746790113,
					"content": "我曾与你们有过一面之缘，不过…我这种普通路人般的平庸射手，没能给你们留下深刻的印象…也再正常不过了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746790114
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 746790114,
					"content": "当成初次见面也完全没问题！我是「特巡队」的新晋成员蒂蕾娜，负责队内的各种杂活。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746790115
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 746790115,
					"content": "「特巡队」希望借助「千灵映影节」的热度，举办一个宣传活动，招募市民当中的潜在人才。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746790116
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 746790116,
					"content": "所以，噔噔！两位请看桌上的这个模拟射击装置「千步拦射角分间」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746790117
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 746790117,
					"content": "这个装置…像是一个小小的枫丹廷模型？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746790118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746790118,
					"content": "啊哈！不止是枫丹廷哦，这个沙盘还可以切换区域，更换成野外的风景，当然，那远不如枫丹廷壮观…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746790119
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 746790119,
					"content": "配合枫丹科学院之前为我们研究的特殊光学目镜，就能模拟「特巡队」射手在高处打击敌人时的情景！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746790120
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 746790120,
					"content": "总之，听起来就是一种…模拟铳枪使用情景，瞄准目标并射击的游戏，没错吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746790121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746790121,
					"content": "不过这个名字好复杂，拦射和角分又是什么意思…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746790122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746790122,
					"content": "咳咳，我根据夏沃蕾队长教导我们的一句名言总结出了这个活动名，超级厉害的目标！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746790123
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 746790123,
					"content": "「作为优秀的铳枪射手，应当追求的终极准度，是在千步级别的距离上，打出低于一角分的散布！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746790124
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 746790124,
					"content": "虽然以目前量产铳枪的加工精度，和我们射手的视力，别说千步了，一百步以上的散布低于一角分都是天方夜谭…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746790125
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 746790125,
					"content": "但以夏沃蕾队长的实力，说不定真的能做到！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746790126
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 746790126,
					"content": "你慢点你慢点，我都被你说晕了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746790127,
						746790128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746790127,
					"content": "技术名词也不用搞那么清楚。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746790129
					]
				},
				{
					"id": 746790129,
					"content": "「超天顶领队级战力」说得对！有的东西不用计较那么多，照做就好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746790130
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 746790130,
					"content": "我刚入队的时候，夏沃蕾队长也是这么教我的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746790131
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 746790131,
					"content": "总之，请两位收下这份目镜，配合桌上的模拟装置，就能开始游戏了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746790132
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 746790132,
					"content": "话都说到这份上了，我们就试试看吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746790133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746790133,
					"content": "本来我也有点好奇，用铳枪这样的武器射击目标是什么感觉呢？说不定还挺有趣的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746790128,
					"content": "只管开开心心玩游戏就行啦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746790129
					]
				},
				{
					"id": 746790110,
					"content": "听不明白。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746790111
					]
				},
				{
					"id": 746790104,
					"content": "射手？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746790105
					]
				}
			]
		}
	]
}