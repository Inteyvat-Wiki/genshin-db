			"dialogs": [
				{
					"id": 150360501,
					"content": "呼…跑到这里，应该安全了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360502,
					"content": "察觉不到他的气息，看来他仍停留在深渊秘境中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360503
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150360503,
					"content": "我的力量不是弱者轻易能够掌控的。在他消化完之前，应该都不会从那里离开了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360504,
						150360505
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150360504,
					"content": "「吞星之鲸」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360506
					]
				},
				{
					"id": 150360506,
					"content": "你看上去很惊讶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360507
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150360507,
					"content": "也对…你并未真正见过那头鲸鱼张开血盆大口，仿佛要将星球吞入腹中的场景。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360508
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150360508,
					"content": "吞星之鲸有着「吞噬」的权能。无论是活人还是死物，只要能破开防御，直接接触到对方的本体，就能从中抽取力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360509
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150360509,
					"content": "我们和它交手的时候，那维莱特好像也说过，「吞噬」是它的本能…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360510
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360510,
					"content": "古龙的孑遗看出了它力量的实质，一直在用「水」的权能保护你们。那时候吞星之鲸也还处于饱腹的状态，没有彻底躁怒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360511
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150360511,
					"content": "在力量完全耗尽后，它才会逐渐展露出真正的本性，将星球上的一切化作储粮。所以我将它收存在特殊的虚无空间里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360512
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150360512,
					"content": "只是没想到，在这颗星球上，仍有人可以使用它的权能。这说明他在很久以前就见过吞星之鲸，应该是师父认识的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360513
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150360513,
					"content": "他确实对「极恶骑」这个词有反应。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360514
					]
				},
				{
					"id": 150360514,
					"content": "所以我说，此行的目的已经完成了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360515
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150360515,
					"content": "这之后就是我的私事。如今的你已经重归完整，可以继续自己的旅程了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360516
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150360516,
					"content": "这怎么行！为了帮我们的忙，你的力量才被夺走了，我们怎么能放着你不管呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360517
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360517,
					"content": "承受失败、失去力量，我已经不是第一次经历这种事情了。若是坠入低谷，就重新向上攀爬，直至变得更强。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360518
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150360518,
					"content": "就算这样…万一那个怪物在你恢复好之前就找到你怎么办？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360519
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360519,
					"content": "而且你失去了力量，应该也不能像以前那样「咻」地一下打开去深渊的门了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360520
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360520,
					"content": "至少这段时间，跟我们一起行动也不是什么坏事，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360521,
						150360522
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360521,
					"content": "这并非出于「同情」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360523
					]
				},
				{
					"id": 150360523,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360524
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150360524,
					"content": "我明白你们的想法了。这个给你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360525
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150360525,
					"content": "这个是…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360526
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360526,
					"content": "装摩拉的袋子。在这个世界生活需要花钱，这点常识我还是有的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360527
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150360527,
					"content": "这段时间就随你们安排。决定好去哪，就尽快出发。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150360522,
					"content": "现在还算不上「两不相欠」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360523
					]
				},
				{
					"id": 150360505,
					"content": "居然连你的力量都能夺走…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360506
					]
				}
			]
		},
