			"dialogs": [
				{
					"id": 150360101,
					"content": "这里…我记得是层岩巨渊附近？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360102,
					"content": "从这里进去，就能抵达你梦里的那个空间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360103
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150360103,
					"content": "虽然同是深渊秘境，但那边是别人的地盘，还是要谨慎行事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360104
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150360104,
					"content": "#放心吧，我会躲到{NICKNAME}身后的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360105,
					"content": "#嘿嘿，{NICKNAME}，你也不要勉强哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360106,
						150360107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360106,
					"content": "放心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360108
					]
				},
				{
					"id": 150360108,
					"content": "走吧。多想一想特训的内容，或许能用得上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150360107,
					"content": "好好教训一下那个「强盗」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360108
					]
				}
			]
		},
		{
