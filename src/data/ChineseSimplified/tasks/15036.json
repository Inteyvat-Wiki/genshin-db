							4606.537,
							-0.626,
							-180.436
						],
						"pointId": 51
					}
				]
			},
			"dialogs": [
				{
					"id": 150360201,
					"content": "前面好像没有路了！这里就是那个坏蛋藏身的地方吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360202,
					"content": "好浓的雾，什么也看不清！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360203,
					"content": "之前，你就是在这里被袭击，失去了一部分灵魂碎片吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360204
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150360204,
					"content": "你能感应到那部分灵魂碎片在哪吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360205
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150360205,
					"content": "（闭上眼睛，努力想象当时从身体中逸散的光点…它似乎就在附近，但并不清楚它的具体方位。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360206,
						150360207
					]
				},
				{
					"id": 150360206,
					"content": "不行…！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360208
					]
				},
				{
					"id": 150360208,
					"content": "看来对方也做好了准备，提前遮蔽了它的气息，否则灵魂之间应该存在更强烈的共鸣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360209
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150360209,
					"content": "等一下，快看！那些尖刺又出现了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360210,
					"content": "「投鼠忌器」，说的就是这种情况。反击的时候收着点力，先观察对方的动作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360211
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150360211,
					"content": "对方既然夺走了你的灵魂碎片，就一定会用它做些什么。或许就藏在某个攻击招式里，想办法找出来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150360207,
					"content": "只能感觉到它在附近。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360208
					]
				}
			]
		},
