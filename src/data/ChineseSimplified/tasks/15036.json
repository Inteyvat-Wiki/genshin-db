				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"白术"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 150365101,
					"content": "你看上去比之前健康许多，烦扰消失了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150365102
					],
					"speakerTitle": "白术"
				},
				{
					"id": 150365102,
					"content": "嚯，真不简单。不过现在放松还太早了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150365103
					],
					"speakerTitle": "白术"
				},
				{
					"id": 150365103,
					"content": "没错。疾病初愈，还是再观察一段时间为好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150365104
					],
					"speakerTitle": "白术"
				},
				{
					"id": 150365104,
					"content": "正好近期病人不多，许多房间都空置着。如有需要，可以再暂住几天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150365105
					],
					"speakerTitle": "白术"
				},
				{
					"id": 150365105,
					"content": "太好啦，谢谢你们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
