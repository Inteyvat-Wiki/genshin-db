			"dialogs": [
				{
					"id": 150360601,
					"content": "仔细一看，丝柯克的包里居然装了这么多摩拉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360602,
					"content": "难道说她也在打工？不对不对，你还记得万民堂那时候发生的事吗？如果她去打工的话，绝对会变成这样子——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360603
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360603,
					"content": "「老板，结一下这个月的工钱。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360604,
					"content": "「好的。等一下…你是谁？我们认识吗？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360605,
					"content": "嘿嘿，毕竟见过她的人一眨眼就把她忘了嘛。这些摩拉是从哪来的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360606,
					"content": "地下的无主宝藏，以及顺手解决一些寻衅的魔物。来路正当，放心用吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360607
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150360607,
					"content": "呜哇！你能听到吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360608
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360608,
					"content": "这么响的说话声，站在门外的山顶上都能听到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360609
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150360609,
					"content": "啊？等下，该不会我之前在背后说的那些…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360610
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360610,
					"content": "你指什么？雪山冻堇瓜？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360611,
						150360612
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150360611,
					"content": "果然被听到了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360613
					]
				},
				{
					"id": 150360613,
					"content": "那个…其实那句话不是我说的啦！是有一个长得和我很像的人，总喜欢背后冒充我，给别人起奇怪的绰号！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360614
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360614,
					"content": "#…好吧，我错了。那时候我不太喜欢你，但现在我觉得你人还不错，毕竟帮了{NICKNAME}这么大忙。我们可以当朋友吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360615
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360615,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360616
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150360616,
					"content": "我刚刚看过，这里只有一张床，你们去休息吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360617
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150360617,
					"content": "欸？那你呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360618
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360618,
					"content": "我不会感到疲惫，也不需要休息。我去外面挥剑，这样力量能快些恢复。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360619
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150360619,
					"content": "但是你的身体——欸！等下，这就走啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360620
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360620,
					"content": "气死我了。哼！不管她，等她累了自然就回来休息了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360621
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360621,
					"content": "我们睡觉！睡软软的床！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360622
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360622,
					"content": "（丝柯克很有主见，现在劝她躺下休息，她应该也不会答应。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360623
					]
				},
				{
					"id": 150360623,
					"content": "（派蒙说的也有道理，如果丝柯克感到疲惫，她应该就会停止训练了。今晚先睡下吧。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360624
					]
				},
				{
					"id": 150360624,
					"content": "呼…呼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360625
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150360625,
					"content": "（丝柯克…？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360626
					]
				},
				{
					"id": 150360626,
					"content": "（不愧是她，这么快就恢复了一些力量。不过她看上去有些奇怪…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360627
					]
				},
				{
					"id": 150360627,
					"content": "呼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360628
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150360628,
					"content": "…安静。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360629
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150360629,
					"content": "（安静？周围明明没有人说话。难道说…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360630
					]
				},
				{
					"id": 150360630,
					"content": "想想我们吧，多少人葬身在那场大火当中，只有你一个人活了下来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360631
					],
					"speakerTitle": "仓皇的路人"
				},
				{
					"id": 150360631,
					"content": "不要将目光从剑上挪开，你还没有资格休息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360632
					],
					"speakerTitle": "仓皇的路人"
				},
				{
					"id": 150360632,
					"content": "跑起来，丝柯克。在死亡到来前，你都要不停地跑下去——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360633
					],
					"speakerTitle": "爽朗的男声"
				},
				{
					"id": 150360633,
					"content": "（对了。那次在梦里，丝柯克也是在经历了一场失败后孤独地练剑，身后有数不清的杂声。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360634
					]
				},
				{
					"id": 150360634,
					"content": "（大火…到底发生过什么事呢？要是她愿意和我们说说就好了…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360635
					]
				},
				{
					"id": 150360635,
					"content": "早睡早起身体好！这床真舒服呀——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360636
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360636,
					"content": "丝柯克，你在这坐了一晚上吗？要不要休息一会儿？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360637
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360637,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360638
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150360638,
					"content": "力量恢复了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360639
					]
				},
				{
					"id": 150360639,
					"content": "恢复了六七成。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360640
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150360640,
					"content": "这么快！我还以为至少要几天呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360641
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360641,
					"content": "不…比我预想中要慢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360642
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150360642,
					"content": "如果是以前，力量还要多恢复两成。同样的方法、同样的感受，结果却变差了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360643
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150360643,
					"content": "难道是受那个尖刺的影响？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360644
					]
				},
				{
					"id": 150360644,
					"content": "应该是我自己出了问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360645
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150360645,
					"content": "接下来的两天，我需要在这里冥想，让意识完全沉入内心，看看到底发生了什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360646
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150360646,
					"content": "冥想！听起来好厉害，那我们就在旁边护法好啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360647
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360647,
					"content": "有劳。两天后见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150360612,
					"content": "派蒙的悄悄话水平有待提高。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360613
					]
				}
			]
		},
		{
			"id": 1503650,
			"completionStepIds": [],
