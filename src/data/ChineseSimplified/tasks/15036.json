			},
			"dialogs": [
				{
					"id": 150360301,
					"content": "#{NICKNAME}、丝柯克！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360302,
					"content": "刚刚发生什么了？我看见丝柯克的肩膀好像被——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360303,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360304
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150360304,
					"content": "在归离原，你问我为什么那家伙盯上了你，将你视作重要的猎物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360305
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150360305,
					"content": "现在答案已经很明显了。除了你本身就具备着不俗的实力之外，也是因为你有着所谓「净化深渊」的能力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360306
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150360306,
					"content": "「净化」的本质暂且不论，借由这份力量，他就能做到许多原本做不到的事——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360307
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150360307,
					"content": "就比如洞穿我的防御，吞噬我的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360308,
						150360309
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150360308,
					"content": "他的目标其实是你？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360310
					]
				},
				{
					"id": 150360310,
					"content": "不，最初他应该并不清楚我会来。拿走你的灵魂碎片，只是认为你的力量很珍贵，没想到碰巧能在这时候派上用场。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360311
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150360311,
					"content": "如果这世界上真有所谓的命运，指的应该就是这种无聊的巧合吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360312
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150360312,
					"content": "不过，对我们来说也是好事。想明白它会将你的力量用在哪，就能反过来将你失去的东西拿回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360313
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150360313,
					"content": "可是你…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360314
					]
				},
				{
					"id": 150360314,
					"content": "我心里有数。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360315
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150360315,
					"content": "吃饱了吗？回答我的问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360316
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150360316,
					"content": "为什么…你会有「吞星之鲸」的权能？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360317
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150360317,
					"content": "吞星之鲸？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360318,
					"content": "啊…对哦！怪不得我看那个尖刺有点眼熟，那东西…长得很像吞星之鲸头上的角！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360319,
					"content": "这份权能不是你靠自己的力量得来的，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360320
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150360320,
					"content": "如果你真有战胜吞星之鲸的实力，就无需四处收集魔神残渣这种不完整的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360321
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150360321,
					"content": "我只能想到一种可能性。你认识我的师父，「极恶骑」苏尔特洛奇是吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360322
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150360322,
					"content": "「极恶骑」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360323
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150360323,
					"content": "何人称其为「恶」？苏尔特洛奇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360324
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150360324,
					"content": "苏尔…特洛奇…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360325
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150360325,
					"content": "被力量冲昏了头脑，已经失去了基本的交流能力吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360326
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150360326,
					"content": "再等等，我还没有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360327
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150360327,
					"content": "快看！那东西又来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360328
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360328,
					"content": "痴迷力量的人，在被反噬前都不会回头。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360329
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150360329,
					"content": "现在该怎么办？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360330
					]
				},
				{
					"id": 150360330,
					"content": "冷静。用你的「理性」思考，做你认为最合适的选择。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360331
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150360331,
					"content": "（为了拿回我的灵魂碎片，丝柯克被那家伙的尖刺刺伤，力量也被夺走了。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360332
					]
				},
				{
					"id": 150360332,
					"content": "（元凶就在迷雾之后。在刚刚的交手中，我已经逐渐摸清楚对方的攻击方式了。继续动手，胜算很高。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360333
					]
				},
				{
					"id": 150360333,
					"content": "（但是丝柯克的气息比平时弱了许多。贸然进攻的话，必然无法保证她和派蒙的安全。虽然很不情愿…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360334
					]
				},
				{
					"id": 150360334,
					"content": "先离开这里吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360335
					]
				},
				{
					"id": 150360335,
					"content": "胜负不在一时，你做了正确的判断。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360336
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150360336,
					"content": "既然拿回了你的灵魂碎片，此行的目的也就达成了。至于他的命，再多寄存一段时间也无妨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360337
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150360337,
					"content": "走吧。这次，靠你带我们出去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 150360309,
					"content": "他一开始就在打你的主意？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360310
					]
				}
			]
		},
