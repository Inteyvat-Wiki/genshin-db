			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凯瑟琳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716640101,
					"content": "总算等到你了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640102
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 716640102,
					"content": "最近冒险家协会接到了一份相当重要的委托，根据我的经验，你是最合适的人选。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640103,
						716640104
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 716640103,
					"content": "相当重要的委托…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716640105
					]
				},
				{
					"id": 716640105,
					"content": "不用这么客气啦，凯瑟琳小姐，我们早就习惯了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716640106,
					"content": "如果委托的报酬不够丰厚，凯瑟琳小姐也不会来麻烦我们的，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716640107,
					"content": "咳咳，倒也没错呢…不愧是你们，每次都这么爽快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640108
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 716640108,
					"content": "那我就直说好了，这次的委托人名叫帕特里克，是一位来自枫丹的科研专家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640109
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 716640109,
					"content": "他希望能雇佣几位助手，帮助他进行科研，目前他正在层岩巨渊外围进行考察。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640110
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 716640110,
					"content": "虽然不清楚科研的详细内容，但你们对这种委托已经是轻车熟路了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640111
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 716640111,
					"content": "确实如此…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716640112
					]
				},
				{
					"id": 716640112,
					"content": "那就按照惯例办事吧，我们先去层岩巨渊附近看看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716640104,
					"content": "似曾相识的对话…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716640105
					]
				}
			]
		},
		{
			"id": 7166402,
			"completionStepIds": [
				7166402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7166402",
							"2"
						],
						"stepId": 7166402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"帕特里克"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716640201,
					"content": "不能再拖延下去了，必须尽快进入验证环节…实在不行，我就只能亲自上阵了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640202
					],
					"speakerTitle": "帕特里克"
				},
				{
					"id": 716640202,
					"content": "「意外受伤，被迫中止研究。」靠这个借口应该能多拖延一会儿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640203
					],
					"speakerTitle": "帕特里克"
				},
				{
					"id": 716640203,
					"content": "反正只要不把命给搭上，就比回去接受审判要划算！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640204
					],
					"speakerTitle": "帕特里克"
				},
				{
					"id": 716640204,
					"content": "#他在这里自言自语什么呢？打个招呼吧，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716640205,
					"content": "你好，请问是帕特里克先生吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716640206
					]
				},
				{
					"id": 716640206,
					"content": "吓死我了！你们两个是从哪冒出来的…怎么还知道我的名字？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640207
					],
					"speakerTitle": "帕特里克"
				},
				{
					"id": 716640207,
					"content": "等等，你们不会也是便衣的千岩军吧？还要来驱赶我吗？我已经出示过实地考察的许可了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640208
					],
					"speakerTitle": "帕特里克"
				},
				{
					"id": 716640208,
					"content": "我保证，绝对不会深入禁区的！不信你去问那位杀气腾腾的、黑色短发的小姐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640209
					],
					"speakerTitle": "帕特里克"
				},
				{
					"id": 716640209,
					"content": "虽然不知道你说的人是谁，但别紧张啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716640210,
					"content": "我们是友善、专业的冒险家。我们接到了协会的委托，来帮你解决麻烦啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716640211,
					"content": "原来是救兵？太好了！你们总算到了，我的研究项目终于有救了，要不然我早晚有一天要被它害死…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640212
					],
					"speakerTitle": "帕特里克"
				},
				{
					"id": 716640212,
					"content": "看来你被你的研究项目给折磨得不轻啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716640213,
					"content": "这是什么话！研究这一行为本身是神圣而高洁的！折磨我的只是一些「附加因素」罢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640214
					],
					"speakerTitle": "帕特里克"
				},
				{
					"id": 716640214,
					"content": "「附加因素」？比如说？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716640215,
					"content": "科研失败就会死。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640216
					],
					"speakerTitle": "帕特里克"
				},
				{
					"id": 716640216,
					"content": "……？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640217,
						716640218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716640217,
					"content": "…像一句自暴自弃的话。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716640219
					]
				},
				{
					"id": 716640219,
					"content": "唉，我可没在开玩笑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640220
					],
					"speakerTitle": "帕特里克"
				},
				{
					"id": 716640220,
					"content": "独立的研究者进行科研需要申请资金，只要使用这笔资金，就等于承担了枫丹的社会责任。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640221
					],
					"speakerTitle": "帕特里克"
				},
				{
					"id": 716640221,
					"content": "花费了大笔资金还没能取得成果，就无异于罪人，可是会被审判的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640222
					],
					"speakerTitle": "帕特里克"
				},
				{
					"id": 716640222,
					"content": "要是我空手而归，等待着我的大概不止「浪费公共财产」，还有占用「学术资源」等好几十项罪名。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640223
					],
					"speakerTitle": "帕特里克"
				},
				{
					"id": 716640223,
					"content": "这些罪名会给我带来最严重的惩罚…财产亏空，身败名裂还是小事，被审判的话，真的有可能会死掉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640224
					],
					"speakerTitle": "帕特里克"
				},
				{
					"id": 716640224,
					"content": "欸？这也太过分了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716640225,
					"content": "所以你才那么慌张，花一大笔钱聘请助手么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640226,
						716640228
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716640226,
					"content": "枫丹这个国家还真是可怕。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716640227
					]
				},
				{
					"id": 716640227,
					"content": "可怕的是「附加因素」！我美丽的故乡是无罪的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640230
					],
					"speakerTitle": "帕特里克"
				},
				{
					"id": 716640230,
					"content": "冷静一点啦，我们明白情况有多严重了。这项科研关系到你的未来，你的性命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640231
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716640231,
					"content": "都交给我们吧，我们会帮你搞定一切的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640232
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716640232,
					"content": "事到如今，我也只能依靠你们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640233,
						716640234
					],
					"speakerTitle": "帕特里克"
				},
				{
					"id": 716640233,
					"content": "你需要我们怎么做呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716640235
					]
				},
				{
					"id": 716640235,
					"content": "嗯，那就进入正题吧。我的研究项目名叫「振晶映射」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640236
					],
					"speakerTitle": "帕特里克"
				},
				{
					"id": 716640236,
					"content": "简单来说，就是激发矿藏宝石所含有的元素力，将这种元素力作为能源使用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640237
					],
					"speakerTitle": "帕特里克"
				},
				{
					"id": 716640237,
					"content": "听起来好方便啊！也许能用来制作实用又好玩的机器…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640238
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716640238,
					"content": "不过，这些宝石和你说的什么晶什么映，又有什么关系呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640239
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716640239,
					"content": "「振晶」就属于这种宝石吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716640240
					]
				},
				{
					"id": 716640240,
					"content": "答对了！不久之前，有人在激发宝石时发现，有一类特殊宝石之间能产生奇妙的共鸣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640241
					],
					"speakerTitle": "帕特里克"
				},
				{
					"id": 716640241,
					"content": "并将这样的宝石统称为「振晶」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640242
					],
					"speakerTitle": "帕特里克"
				},
				{
					"id": 716640242,
					"content": "「振晶」中的「响振晶」受到特定的刺激后，可以放出能量，激发「应振晶」的共鸣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640243
					],
					"speakerTitle": "帕特里克"
				},
				{
					"id": 716640243,
					"content": "两种「振晶」所放出的能量会相互叠加，成倍增幅，无比强大！我将这种共鸣命名为「映射」现象，",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640244
					],
					"speakerTitle": "帕特里克"
				},
				{
					"id": 716640244,
					"content": "目前项目已经进行到了关键阶段——验证我推导的「映射关系」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640245,
						716640246
					],
					"speakerTitle": "帕特里克"
				},
				{
					"id": 716640245,
					"content": "我有一种预感…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716640247
					]
				},
				{
					"id": 716640247,
					"content": "我猜，你需要我们去检验你的理论，借助那些「振晶」的力量打败魔物，证明你所说的「映射关系」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640248
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716640248,
					"content": "完全正确！你们的悟性很高啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640249
					],
					"speakerTitle": "帕特里克"
				},
				{
					"id": 716640249,
					"content": "我挑选了一片合适的区域，布置了许多组「振晶」的方碑。做好了准备的话，就告诉我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640250
					],
					"speakerTitle": "帕特里克"
				},
				{
					"id": 716640250,
					"content": "我会向你们仔细说明需要验证的项目，根据我的提示去战斗就可以了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640251
					],
					"speakerTitle": "帕特里克"
				},
				{
					"id": 716640251,
					"content": "这么说来，还真是我们最熟悉的工作呢，甚至觉得有点无聊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640252,
						716640254
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716640252,
					"content": "我倒有点兴趣…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716640253
					]
				},
				{
					"id": 716640253,
					"content": "你打败过那么多强大的敌人，手脚加在一起都数不过来了吧，搞定这种委托，当然是小菜一碟！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640256
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716640256,
					"content": "真有气势！璃月可真是个好地方啊，不止出产宝石的原矿，还有这么可靠的冒险家！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640257
					],
					"speakerTitle": "帕特里克"
				},
				{
					"id": 716640257,
					"content": "不枉我跋山涉水，为了节省材料的费用赶到这里来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640258
					],
					"speakerTitle": "帕特里克"
				},
				{
					"id": 716640258,
					"content": "本来我还在为预算超支苦恼，这下倒好，支付了你们的佣金后，资金余下两成。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640259
					],
					"speakerTitle": "帕特里克"
				},
				{
					"id": 716640259,
					"content": "事成之后，就用这笔钱雇佣一个报社写手，在新闻头版发布我的成果，好好宣传一番吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640260
					],
					"speakerTitle": "帕特里克"
				},
				{
					"id": 716640260,
					"content": "标题我已经想好了，就叫「震惊！帕特里克对振晶的真经实论！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640261
					],
					"speakerTitle": "帕特里克"
				},
				{
					"id": 716640261,
					"content": "正经一点啦！这个标题怎么看都不像是学术文章吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640262
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716640262,
					"content": "标题一定要奇怪，要引人瞩目，这样才能拉到投资！到时候，我们还可以商量分红的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640263
					],
					"speakerTitle": "帕特里克"
				},
				{
					"id": 716640263,
					"content": "分红？不明白你在说什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640264
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716640264,
					"content": "如果「振晶映射」的理论被用来生产商品，我就能拿到不少利润，到时可以按一定比例分给你们哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640265
					],
					"speakerTitle": "帕特里克"
				},
				{
					"id": 716640265,
					"content": "当然，前提是研究的进展顺利…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640266
					],
					"speakerTitle": "帕特里克"
				},
				{
					"id": 716640266,
					"content": "居然还有这种好事吗？好呀好呀，我更有干劲了！标题什么的我不管了，随你喜欢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640267,
						716640268
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716640267,
					"content": "派蒙…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716640269
					]
				},
				{
					"id": 716640269,
					"content": "#总之，{NICKNAME}，我们就早早开工，快快收工吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640270
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716640270,
					"content": "然后就能和帕特里克先生商量分红的事了，嘿嘿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716640268,
					"content": "口水要流出来了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716640269
					]
				},
				{
					"id": 716640254,
					"content": "不如你来试试？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716640255
					]
				},
				{
					"id": 716640255,
					"content": "我我我，我只是希望你能接到既有趣，又充满挑战的委托而已…可不是在抱怨哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640256
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716640246,
					"content": "我已经明白了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716640247
					]
				},
				{
					"id": 716640234,
					"content": "请解释一下你的科研项目。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716640235
					]
				},
				{
					"id": 716640228,
					"content": "这种「附加因素」还真是恐怖。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716640229
					]
				},
				{
					"id": 716640229,
					"content": "但它有利有弊，只要不沦为罪人，还是能享受到各种便利的。出身于枫丹的人都曾受益于它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640230
					],
					"speakerTitle": "帕特里克"
				},
				{
					"id": 716640218,
					"content": "哦，有点好笑。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716640219
					]
				}
			]
		}
	]
}