				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"芭努"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736760101,
					"content": "#怎么样，{M#大哥哥}{F#大姐姐}找到未来星了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760102
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760102,
					"content": "六颗未来星都找到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736760103
					]
				},
				{
					"id": 736760103,
					"content": "哈哈太好啦，这下就可以去召唤大未来星了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760104
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760104,
					"content": "#{M#大哥哥}{F#大姐姐}，在出发之前你得做好准备哦，召唤大未来星的时候说不定会出现意外的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760105
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760105,
					"content": "每次我做些特别的事情的时候，总是会有意外发生。我都有做好准备，你也要小心啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760106
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760106,
					"content": "上次我在家里发射大黄金飞天箭的时候，院子就突然爆炸了，要不是「苹果」冲过来把我和沙尔玛叼走，我们俩就惨咯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760107
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760107,
					"content": "哇，这也太危险了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736760108,
					"content": "不过我觉得你可以放心，一般来说，问题都算可控！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760109
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760109,
					"content": "院子都爆炸了欸，问题已经够大了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736760110,
					"content": "没关系的啦，你们不用害怕。准备好了之后，就去地图上我标记好的地方和我汇合吧，我先出发啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760111
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760111,
					"content": "#{NICKNAME}，我有点不太好的预感，待会儿我们一定要小心点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7367603,
			"completionStepIds": [
				7367602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7367602",
							"2"
						],
						"stepId": 7367602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"芭努"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736760301,
					"content": "喔！只有最后一道机关了，这次的最终试炼看起来很简单嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760302
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760302,
					"content": "这次？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736760303
					]
				},
				{
					"id": 736760303,
					"content": "对啊，我之前几次碰到的机关可比这个复杂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760304
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760304,
					"content": "有的要用很多种方法试才能试出唯一解除方法，有的是解错了就会自毁，特别麻烦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760305,
						736760306
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760305,
					"content": "要不然你来吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736760307
					]
				},
				{
					"id": 736760307,
					"content": "不过按我的经验，这个机关跟沙尔玛平时捡回家里的低级旧机关差不多，应该是嵌入所有机钥就能解锁的那种。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760308
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760308,
					"content": "芭努，你平时一直都在和这些奇奇怪怪的机关打交道吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736760309,
					"content": "对呀，我经常和沙尔玛还有「苹果」一起去各种好玩的地方做好玩的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760310
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760310,
					"content": "这次出来找未来星也是，平时和沙尔玛一起编设定也是，遇到许多意外也是，有趣得不得了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760311
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760311,
					"content": "要是每天都只在家门口附近转悠，每天都做一样的事，那也太无聊了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760312
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760312,
					"content": "#这个我同意，{NICKNAME}和我也经常离开熟悉的地方，去新奇的地方探险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736760313,
					"content": "虽然我们碰到过很多吓人的东西，但也有特别惊喜特别受震撼的时候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736760314,
					"content": "太好啦，我们肯定能成为好朋友！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760315
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760315,
					"content": "但是呢，有件事我要先说好。我知道出门到处跑很好玩也很危险，所以我都有好好做准备。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760316
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760316,
					"content": "沙尔玛跟我说，想要找人帮忙的时候就得好好观察对方，盗宝团、还有陌生的镀金旅团的叔叔阿姨们就不能找。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760317
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760317,
					"content": "#我觉得{M#大哥哥}{F#大姐姐}你看起来像是善良的人，才会请你帮忙的。不过请善良的哥哥姐姐们帮了忙，就不能害他们倒霉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760318
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760318,
					"content": "#这是我的原则。所以如果{M#大哥哥}{F#大姐姐}觉得害怕，也没关系，我自己也可以解开这个机关。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760319,
						736760320
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760319,
					"content": "笑话，我会害怕？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736760321
					]
				},
				{
					"id": 736760321,
					"content": "#那也行。总之{M#大哥哥}{F#大姐姐}不用太担心，只要把六颗未来星全部嵌进机关里就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760320,
					"content": "有点危险，还是我来吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736760321
					]
				},
				{
					"id": 736760306,
					"content": "我突然想起来我还有事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736760307
					]
				}
			]
		},
		{
			"id": 7367604,
			"completionStepIds": [
				7367604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7367604",
							"2"
						],
						"stepId": 7367604,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"沙尔玛",
					"芭努"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736760401,
					"content": "芭努，你没受伤吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760402
					],
					"speakerTitle": "沙尔玛"
				},
				{
					"id": 736760402,
					"content": "才这点程度，没什么好怕的啦。你写的书里教过：打不过立刻就跑。我早就躲到一边去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760403
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760403,
					"content": "对了沙尔玛，你怎么还把「苹果」带来了呀，她现在应该在好好看家才对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760404
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760404,
					"content": "「苹果」有点担心你，就跟着我出来了。你知道的嘛，她只听你和妈妈的话，我劝她她也不回去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760405,
						736760406
					],
					"speakerTitle": "沙尔玛"
				},
				{
					"id": 736760405,
					"content": "等一下…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736760407
					]
				},
				{
					"id": 736760407,
					"content": "芭努好像认识那只突然蹿出来的长鬓虎，还叫它「苹果」…还有这个跟长鬓虎一起突然出现的人，到底怎么回事啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736760408,
					"content": "#{M#大哥哥}{F#大姐姐}，我来给你介绍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760409
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760409,
					"content": "这个冒冒失失的家伙就是沙尔玛，我借给你的那本《游学者不可不知的五十件事》就是沙尔玛写的哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760410
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760410,
					"content": "我本来想等到大未来星召唤仪式之后再把沙尔玛和「苹果」一起介绍给你的，但是果然，这次也碰到了意外情况。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760411
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760411,
					"content": "也好，这样就不用费力气去找人啦，这次的意外发生得正正好，不错不错。希望下次也有这么好的运气！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760412
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760412,
					"content": "你好，本人是芭努生物学意义上的父亲，沙尔玛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760413
					],
					"speakerTitle": "沙尔玛"
				},
				{
					"id": 736760413,
					"content": "至于「苹果」，她是我们家庭中的另一位重要家庭成员，一只优雅的雌性长鬓虎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760414
					],
					"speakerTitle": "沙尔玛"
				},
				{
					"id": 736760414,
					"content": "生、生物学意义上的父亲？呃…这是什么意思？难道在别的地方，你就不是芭努的父亲了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736760415,
					"content": "的确如此。在本人的心目中，本人是和芭努平等的朋友；在日常生活中，本人是和芭努平摊家务的伙伴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760416
					],
					"speakerTitle": "沙尔玛"
				},
				{
					"id": 736760416,
					"content": "父亲不过是这些身份中微不足道的一个而已，比起父亲，本人更愿意做芭努的朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760417
					],
					"speakerTitle": "沙尔玛"
				},
				{
					"id": 736760417,
					"content": "刚才本人一直躲在机关下方的地洞里听你们的对话，你们如此愿意帮助芭努，本人万分感激。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760418
					],
					"speakerTitle": "沙尔玛"
				},
				{
					"id": 736760418,
					"content": "不客气。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736760419
					]
				},
				{
					"id": 736760419,
					"content": "呃，这个郑重过头的说话口气…我知道刚见面的时候芭努为什么会那样和我们说话了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760420
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736760420,
					"content": "芭努的措辞和处事方式的确和本人有相似之处，但总体来说，芭努都是个比本人优秀万分的孩子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760421
					],
					"speakerTitle": "沙尔玛"
				},
				{
					"id": 736760421,
					"content": "比如：她做的拌饭比本人做的足足好吃一万倍。仅仅是这一点，就已经足够了不起了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760422
					],
					"speakerTitle": "沙尔玛"
				},
				{
					"id": 736760422,
					"content": "因此，本人十分珍惜和这样快乐活泼的优秀孩子相处的时光。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760423
					],
					"speakerTitle": "沙尔玛"
				},
				{
					"id": 736760423,
					"content": "每每想到她即将进入教令院，过上每天泡在教研室里抓头发到半夜、没到四十岁头发就提前变白、长期不按时吃饭导致营养不良的生活…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760424
					],
					"speakerTitle": "沙尔玛"
				},
				{
					"id": 736760424,
					"content": "本人就感到十分痛心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760425
					],
					"speakerTitle": "沙尔玛"
				},
				{
					"id": 736760425,
					"content": "在芭努还没进入教令院之前，本人当然需要抓住一切机会，为芭努留下有趣的回忆。这次的寻星之旅就是为了这个目的设计的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760460
					],
					"speakerTitle": "沙尔玛"
				},
				{
					"id": 736760460,
					"content": "由于本人对地脉与机关术有些小小的研究，所以利用这片土地上早已有之的机关做了些小小的布置。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760461
					],
					"speakerTitle": "沙尔玛"
				},
				{
					"id": 736760461,
					"content": "沙尔玛，我问你，之前找未来星的时候也好，刚才也好，那些魔物都是你招出来的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760462
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760462,
					"content": "不不不，这个…这个都是意外。怪我考虑不周，让你们遇到危险了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760463
					],
					"speakerTitle": "沙尔玛"
				},
				{
					"id": 736760463,
					"content": "#我…我其实有让「苹果」暗中跟着你，至于这位冒险家{M#先生}{F#小姐}，我看{M#他}{F#她}的身手那么夸张，就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760464
					],
					"speakerTitle": "沙尔玛"
				},
				{
					"id": 736760464,
					"content": "唉，沙尔玛真是个不靠谱的爸爸，没有我和「苹果」的话，你该怎么办呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760426
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760426,
					"content": "#{NICKNAME}和我也旅行了好久了，你这种奇怪的父亲我还是第一次见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760427
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736760427,
					"content": "奇怪吗？奇怪正是本人的人设之一，这个评价真是对本人最好的赞扬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760428
					],
					"speakerTitle": "沙尔玛"
				},
				{
					"id": 736760428,
					"content": "这也是设定的一部分？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736760429
					]
				},
				{
					"id": 736760429,
					"content": "是的。否则，在这个拥挤的世界里，本人和庸庸碌碌的其他人又有什么区别呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760430
					],
					"speakerTitle": "沙尔玛"
				},
				{
					"id": 736760430,
					"content": "虽然不论本人言行有多奇怪，依然不过是偌大世界中的普通人，但本人却拥有位高权重的贤者所无法拥有的胡说八道的自由。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760431
					],
					"speakerTitle": "沙尔玛"
				},
				{
					"id": 736760431,
					"content": "啊！这多是一件乐事啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760432
					],
					"speakerTitle": "沙尔玛"
				},
				{
					"id": 736760432,
					"content": "#{M#大哥哥}{F#大姐姐}别被沙尔玛搞昏头了，每次他想把什么事情糊弄过去的时候，就会像这样胡说八道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760433
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760433,
					"content": "沙尔玛，我问你，我的大未来星呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760434
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760434,
					"content": "你之前说集齐六颗未来星、解开最终机关，就可以召唤大未来星的，大未来星在哪里呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760435
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760435,
					"content": "放心放心，这次我绝对没有糊弄芭努。你看，大未来星就在这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760436
					],
					"speakerTitle": "沙尔玛"
				},
				{
					"id": 736760436,
					"content": "沙尔玛从口袋中掏出了一枚星螺递给芭努。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						736760437
					]
				},
				{
					"id": 736760437,
					"content": "这就是集齐未来星之后，跨越了无穷广阔的星海来到芭努身边的大未来星。你看，它表面是不是有一颗闪亮的白色星星？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760438
					],
					"speakerTitle": "沙尔玛"
				},
				{
					"id": 736760438,
					"content": "这颗星星就是你们收集的未来星凝成的，它是你的大未来星哦。你把耳朵凑到那个黑色的开口听听看，星海在对你说话呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760439
					],
					"speakerTitle": "沙尔玛"
				},
				{
					"id": 736760439,
					"content": "喔！这就是大未来星啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760440,
						736760441
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760440,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736760442
					]
				},
				{
					"id": 736760442,
					"content": "这人在胡说八道吧，这不是璃月海滩上到处都有的星螺吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760443
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736760443,
					"content": "唔…沙尔玛，星螺是它在另一个设定里的名字吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760444
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760444,
					"content": "咳咳…也能这么说，在许多人的设定里它叫星螺，是长在海里的。但…但是在我的设定里，它的名字叫大未来星。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760445
					],
					"speakerTitle": "沙尔玛"
				},
				{
					"id": 736760445,
					"content": "啊我懂了，就像你从教令院的垃圾堆里淘来的那个东西那样。我管它叫「芭努的智慧」，但大家都叫它「阿叶夏混沌勘探器」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760446
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760446,
					"content": "谢谢你，沙尔玛，我很喜欢这颗大未来星！。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760447
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760447,
					"content": "欸，就这么糊弄过去了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760448
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736760448,
					"content": "这怎么能叫糊弄呢？每个人都有他自己看待世界的方式，在本人的眼中，这正是跨越星海而来的大未来星。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760449
					],
					"speakerTitle": "沙尔玛"
				},
				{
					"id": 736760449,
					"content": "多接受一种看待世界的方式，不也很有趣吗，更何况芭努也认可了这个名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760450,
						736760454
					],
					"speakerTitle": "沙尔玛"
				},
				{
					"id": 736760450,
					"content": "完全是狡辩。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736760451
					]
				},
				{
					"id": 736760451,
					"content": "#多接受一种看待世界的方式…嗯，那我能把{NICKNAME}背包里的薄荷看成摩拉吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760452
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736760452,
					"content": "派蒙怎么也…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736760453
					]
				},
				{
					"id": 736760453,
					"content": "嘿嘿，我只是觉得这样的话，旅行途中会开心不少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760458
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736760458,
					"content": "两位放心，就算是本人也不会在摩拉的事情上胡说八道，理应付给两位的委托报酬绝对不会抵赖。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760459
					],
					"speakerTitle": "沙尔玛"
				},
				{
					"id": 736760459,
					"content": "请收下这些，感谢你们这些天对芭努的关照，本人将永远把这件事记在心上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "沙尔玛"
				},
				{
					"id": 736760454,
					"content": "好像也挺有道理。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736760455
					]
				},
				{
					"id": 736760455,
					"content": "#不要被绕进去啊，{NICKNAME}。要是你把摩拉看成别的东西随便丢掉了，我们就惨了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760456
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736760456,
					"content": "那不行！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736760457
					]
				},
				{
					"id": 736760457,
					"content": "这个叫沙尔玛的家伙太会狡辩了，得趁我的脑子还清醒的时候赶快提委托报酬的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760458
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736760441,
					"content": "芭努你听我说…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736760442
					]
				},
				{
					"id": 736760406,
					"content": "这是怎么回事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736760460
					]
				}
			]
		}
	]
}