			},
			"dialogs": [
				{
					"id": 751491001,
					"content": "#咦，{REALNAME[ID(2)|SHOWHOST(true)]}，怎么了，你发现什么东西了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491002
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751491002,
					"content": "呼嗯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491003
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751491003,
					"content": "啊，这个雕像，不就是之前被绒翼龙抓着的雕像嘛，居然也一起掉下来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491004
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751491004,
					"content": "#看上去就像是一个团起来的…大耳朵{REALNAME[ID(2)|SHOWHOST(true)]}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491005
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751491005,
					"content": "唔嗯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491006
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751491006,
					"content": "是嘛，你觉得不像啊，我觉得还是挺像的呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491007
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751491007,
					"content": "啊…它动起来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491008
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751491008,
					"content": "喀…喀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491009
					],
					"speakerTitle": "「厄卡特尔」"
				},
				{
					"id": 751491009,
					"content": "自我检试运行中…关节处有些许积灰…存储介质激活，话语…远程提取…介入允许…喀喀…性格模块修正…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491010
					],
					"speakerTitle": "「厄卡特尔」"
				},
				{
					"id": 751491010,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491011
					],
					"speakerTitle": "「厄卡特尔」"
				},
				{
					"id": 751491011,
					"content": "呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491012
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751491012,
					"content": "原来不是雕像，而是什么机关吗…仔细一看，确实和秘源机关长得有点像，它身上飘着的奇怪的光，总觉得在哪看到过…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491013
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751491013,
					"content": "咦，怎么了，怎么不动了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491014
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751491014,
					"content": "「呜哇！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491015
					],
					"speakerTitle": "「厄卡特尔」"
				},
				{
					"id": 751491015,
					"content": "呜哇！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491016
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751491016,
					"content": "「发声模块看来没有问题，好了，尊贵的客人们，我已经在此等候你们许久…怎么了？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491017
					],
					"speakerTitle": "「厄卡特尔」"
				},
				{
					"id": 751491017,
					"content": "怎么突然发出这么大的声音，真是吓人一跳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491018
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751491018,
					"content": "「那真是太好了，这样的登场才能留下点印象，不然我还担心你们会觉得自己受了冷落呢…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491019
					],
					"speakerTitle": "「厄卡特尔」"
				},
				{
					"id": 751491019,
					"content": "咦，你是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491020
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751491020,
					"content": "「你问我是谁？嗯，这副身躯的名字叫厄卡特尔，你可以这样称呼，不过，名字在此地没有太多意义…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491021
					],
					"speakerTitle": "「厄卡特尔」"
				},
				{
					"id": 751491021,
					"content": "个体识别的称呼，变更请求是…通过记录…在那场战争后的一百五十年…变更名为，战亡名录——厄卡特尔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491022
					],
					"speakerTitle": "「厄卡特尔」"
				},
				{
					"id": 751491022,
					"content": "「没错，自那以后，就叫厄卡特尔…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491023
					],
					"speakerTitle": "「厄卡特尔」"
				},
				{
					"id": 751491023,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491024
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751491024,
					"content": "「对，是我，我是『呼唤』你到来者，来吧，到圣山之心…在一切还为时未晚之前。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491025
					],
					"speakerTitle": "「厄卡特尔」"
				},
				{
					"id": 751491025,
					"content": "「不过还不用着急，先让厄卡特尔为你开辟眼前的一点点黑暗…我知道你们心中还有疑惑，但先随我来吧。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「厄卡特尔」"
				}
			]
		},
