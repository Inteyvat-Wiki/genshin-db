			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「厄卡特尔」",
					"#{REALNAME[ID(2)|SHOWHOST(true)]}"
				],
				"points": [
					{
						"sceneId": 101,
						"position": [
							561.16,
							819.386,
							-45.567
						],
						"pointId": 52
					},
					{
						"sceneId": 101,
						"position": [
							562.786,
							818.938,
							-45.043
						],
						"pointId": 910101004
					}
				]
			},
			"dialogs": [
				{
					"id": 751490201,
					"content": "「我得事先说明，这里原先没有那么暗…虽然，这里毫无疑问是火山的『内部』…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490202
					],
					"speakerTitle": "「厄卡特尔」"
				},
				{
					"id": 751490202,
					"content": "「只不过在那场战争结束之后，整座城市被毁灭殆尽，那之后，作为巨大机构的所有功能都不得不停摆…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490203
					],
					"speakerTitle": "「厄卡特尔」"
				},
				{
					"id": 751490203,
					"content": "战争？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751490204,
					"content": "「对，是残存的龙裔与人类的战争，也是令原初执掌火焰的主人死去的战争…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490205
					],
					"speakerTitle": "「厄卡特尔」"
				},
				{
					"id": 751490205,
					"content": "「这座城的主人已经死了，唯留这座城市依然苟活…不过也说不定，也许这座城市其实也早就死了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490206
					],
					"speakerTitle": "「厄卡特尔」"
				},
				{
					"id": 751490206,
					"content": "「…又或者很多东西曾经存在，其实只不过是一种错觉。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490207
					],
					"speakerTitle": "「厄卡特尔」"
				},
				{
					"id": 751490207,
					"content": "唔嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490208
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751490208,
					"content": "「我们各取所需，小家伙，你有来的需要，而我又希望依靠你的力量解决一些问题…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490209
					],
					"speakerTitle": "「厄卡特尔」"
				},
				{
					"id": 751490209,
					"content": "「你们必须得到圣山之心去…但可惜因为之前的战争，整座圣山的力量也在战争中被封绝。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490210
					],
					"speakerTitle": "「厄卡特尔」"
				},
				{
					"id": 751490210,
					"content": "「尽管那封绝之力在我看来犹如只困得住稚童的细索，但按照誓约，只有『人』才能够将它们开启…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490211
					],
					"speakerTitle": "「厄卡特尔」"
				},
				{
					"id": 751490211,
					"content": "「有趣的事是，用了这样的方法侵入圣山的可怜的孩子，最后可以说是毁于他人几乎相同的手段。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490212
					],
					"speakerTitle": "「厄卡特尔」"
				},
				{
					"id": 751490212,
					"content": "「呵呵，总是如此啊…就像暴君的追随者们被英雄驱逐，经历漫长的流浪，其后裔终结了另一个国度的暴君…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490213
					],
					"speakerTitle": "「厄卡特尔」"
				},
				{
					"id": 751490213,
					"content": "「世事如同被人安排的戏码那般，因果流转，恩仇覆反，在支离破碎的历史中轮番上演…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490214
					],
					"speakerTitle": "「厄卡特尔」"
				},
				{
					"id": 751490214,
					"content": "「说远了，来吧…启动它，让这座垂死的城再挣扎一番吧。现在，此世唯有你有这样的资格。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「厄卡特尔」"
				}
			]
		},
