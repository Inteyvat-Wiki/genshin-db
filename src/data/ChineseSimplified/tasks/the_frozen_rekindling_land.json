				]
			},
			"dialogs": [
				{
					"id": 751490301,
					"content": "「我有向你们正式介绍它的名字吗？似乎没有…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490302
					],
					"speakerTitle": "「厄卡特尔」"
				},
				{
					"id": 751490302,
					"content": "「但没关系，欢迎，欢迎来到初始圣城{RUBY#[D]源火之地}图兰。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490303
					],
					"speakerTitle": "「厄卡特尔」"
				},
				{
					"id": 751490303,
					"content": "哇，没想到火山里面，居然是这样的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751490304,
					"content": "这真的是火山里吗？不会是我们在穿过火山口的时候，被人偷偷送到了别的地方吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751490305,
					"content": "唔…呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490306
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751490306,
					"content": "「这里毫无疑问是圣山之内，不过即使是我…也不知道上一次看到如斯景象是什么时候了…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490307
					],
					"speakerTitle": "「厄卡特尔」"
				},
				{
					"id": 751490307,
					"content": "「啊啊…在光芒重新照亮你时，我竟才发现你已这样朽败啊…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490308
					],
					"speakerTitle": "「厄卡特尔」"
				},
				{
					"id": 751490308,
					"content": "厄卡特尔？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751490309,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490310
					],
					"speakerTitle": "「厄卡特尔」"
				},
				{
					"id": 751490310,
					"content": "唔嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490311
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751490311,
					"content": "「哦，抱歉，只是陷入了一小会儿没有必要的感怀罢了…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490312
					],
					"speakerTitle": "「厄卡特尔」"
				},
				{
					"id": 751490312,
					"content": "介质储能低…即将休眠，请及时替换或连接…储能介质…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490313
					],
					"speakerTitle": "「厄卡特尔」"
				},
				{
					"id": 751490313,
					"content": "「哈哈，看来长期『流亡在外』的厄卡特尔并不能撑更久了…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490314
					],
					"speakerTitle": "「厄卡特尔」"
				},
				{
					"id": 751490314,
					"content": "啊，难道，厄卡特尔要、要死掉了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751490315,
					"content": "「厄卡特尔，拥有这个名字的家伙早就不在了…长话短说，重启图兰或许会消耗掉许多力量，不能白费，你们需要…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490316
					],
					"speakerTitle": "「厄卡特尔」"
				},
				{
					"id": 751490316,
					"content": "「其他两个『象拟{RUBY#[D]兹兹米特尔}聚星』，破坏其中一个的封印…和另一个」…「才能真正，开启中央的天轴」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490317
					],
					"speakerTitle": "「厄卡特尔」"
				},
				{
					"id": 751490317,
					"content": "「呃…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490318
					],
					"speakerTitle": "「厄卡特尔」"
				},
				{
					"id": 751490318,
					"content": "你还好吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751490319
					]
				},
				{
					"id": 751490319,
					"content": "…「没事，我们还会…再见面的…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490320
					],
					"speakerTitle": "「厄卡特尔」"
				},
				{
					"id": 751490320,
					"content": "「唉…向前吧，受龙所选者…啊，躯体失去生机的痛苦，即使许多年，我也…无法那样适应…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490321
					],
					"speakerTitle": "「厄卡特尔」"
				},
				{
					"id": 751490321,
					"content": "呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490322
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751490322,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490323
					],
					"speakerTitle": "「厄卡特尔」"
				},
				{
					"id": 751490323,
					"content": "围绕在它身边的光消失了…唔，厄卡特尔也变得一动不动的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490324
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751490324,
					"content": "我还是有点没弄明白，那个说话的人到底是厄卡特尔，还是其实是别的人…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490325,
						751490326
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751490325,
					"content": "以后总会知道的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751490327
					]
				},
				{
					"id": 751490327,
					"content": "对哦，不过，刚才他说什么，「象拟聚星」，难道就是刚才的大火球？那天轴呢？不知道究竟是什么东西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490328
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751490328,
					"content": "唔，我们就先到处看看，找找他说的那些奇怪的东西吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490329
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751490329,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751490326,
					"content": "现在就先继续往前吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751490327
					]
				}
			]
