			"dialogs": [
				{
					"id": 751491101,
					"content": "嗯…唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491102
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751491102,
					"content": "怎么了？看上去不是很舒服的样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751491103,
					"content": "呃呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491104
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751491104,
					"content": "那个难道是…深渊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751491105,
					"content": "「正是如此…深渊的魔物正如顽疾一般侵入圣城图兰。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491106
					],
					"speakerTitle": "秘源龙仆"
				},
				{
					"id": 751491106,
					"content": "「到了这种程度，说不定已经无法将之一点点驱逐，得将整座图兰圣山一同毁掉才能遏制它们的步伐呢…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491107
					],
					"speakerTitle": "秘源龙仆"
				},
				{
					"id": 751491107,
					"content": "当你发现一只深渊魔物的时候…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751491108
					]
				},
				{
					"id": 751491108,
					"content": "「说不定家里已经全都是这些漆黑又黏答答的敌人了…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491109
					],
					"speakerTitle": "秘源龙仆"
				},
				{
					"id": 751491109,
					"content": "呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491110
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751491110,
					"content": "唔，你们在说什么恐怖的话呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751491111,
					"content": "砍掉腿就能遏制它们的步伐了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751491112
					]
				},
				{
					"id": 751491112,
					"content": "真是让人豁然开朗，剩下的工作就是找到它们的腿在哪了…你以为我会这样说吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751491113,
					"content": "唔嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491114
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751491114,
					"content": "「哈哈，真可惜，小家伙，也许大部分的深渊魔物都不靠腿移动呢。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491115
					],
					"speakerTitle": "秘源龙仆"
				},
				{
					"id": 751491115,
					"content": "「…只有将这拦路的阴影之敌清除掉，你们才能通过此处，前往圣山之心。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491116
					],
					"speakerTitle": "秘源龙仆"
				},
				{
					"id": 751491116,
					"content": "「尽管已无法令这破碎的城市恢复原样，但至少也不应让它的残躯被漆黑的魔物占有。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491117
					],
					"speakerTitle": "秘源龙仆"
				},
				{
					"id": 751491117,
					"content": "等等，不是有大火球吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751491118
					]
				},
				{
					"id": 751491118,
					"content": "是啊，大火球不就是用来对抗深渊的东西嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751491119,
					"content": "「大火球…你是说『象拟聚星』吗，它只有在初步接触深渊时与对方一同湮灭才能起到作用，否则反而会被深渊蚀化包裹…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491120
					],
					"speakerTitle": "秘源龙仆"
				},
				{
					"id": 751491120,
					"content": "「只可惜，这座城市被封绝太久…而为了维持稳定，『象拟聚星』不能被随意移动…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491121
					],
					"speakerTitle": "秘源龙仆"
				},
				{
					"id": 751491121,
					"content": "「受龙所选者啊…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491122
					],
					"speakerTitle": "秘源龙仆"
				},
				{
					"id": 751491122,
					"content": "呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491123
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751491123,
					"content": "「圣山之心是图兰建立以后，才重新开掘的区域…由最初的一尊秘源龙像看守。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491124
					],
					"speakerTitle": "秘源龙仆"
				},
				{
					"id": 751491124,
					"content": "「想要进入圣山之心，就必须获得许可…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491125
					],
					"speakerTitle": "秘源龙仆"
				},
				{
					"id": 751491125,
					"content": "「只不过，那只秘源龙像的能源亦受到侵蚀，也得想办法让它重新启动起来…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491126
					],
					"speakerTitle": "秘源龙仆"
				},
				{
					"id": 751491126,
					"content": "「它们…」警告，机能受损，即将关闭…「啊，看来这台机体…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491127
					],
					"speakerTitle": "秘源龙仆"
				},
				{
					"id": 751491127,
					"content": "啊，阿玛鲁，那个什么许可，啊呀，你都什么都没说呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751491128,
					"content": "「呵呵…继续前行吧，在那里，会有新的秘源龙仆为你们指引方向…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491129
					],
					"speakerTitle": "秘源龙仆"
