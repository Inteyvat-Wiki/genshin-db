				},
				{
					"id": 751490915,
					"content": "唔，没想到火山口下面真的有这么大的空间，不过周围怎么黑漆漆的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490916,
						751490918
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751490916,
					"content": "发点光，派蒙！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751490917
					]
				},
				{
					"id": 751490917,
					"content": "好哦，我努力发点…要是能发出来才奇怪！在这种什么都没有的地方，能发的只有火！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490920
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751490920,
					"content": "还是先稍微探索下周围吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490921
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751490921,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751490918,
					"content": "火把，派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751490919
					]
				},
				{
					"id": 751490919,
					"content": "就算你用这样理所当然的语气，没有的东西还是拿不出来的啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490920
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751490913,
					"content": "稍微吓出来了一点…我是说灵魂。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751490914
					]
				},
				{
					"id": 751490914,
					"content": "好嘞！还有开玩笑的精神，看来很健康！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490915
					],
					"speakerTitle": "派蒙"
				}
			]
		},
