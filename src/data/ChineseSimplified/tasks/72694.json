						726940505
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726940503,
					"content": "你要卖什么呀？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940504
					]
				},
				{
					"id": 726940504,
					"content": "我准备卖玩具，不过…欸呀，真是不巧，商品还在筹备之中，等商品制作完成了，请务必要来这里看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726940505,
					"content": "没事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940506
					]
				},
				{
					"id": 726940506,
					"content": "没事，那就不要打扰我，我正在进行很重要的商品筹备呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伯特兰"
