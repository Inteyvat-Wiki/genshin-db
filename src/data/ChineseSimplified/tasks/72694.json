			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凯瑟琳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726940101,
					"content": "原来是旅行者和派蒙啊，真是正好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940102
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 726940102,
					"content": "正好什么呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726940103,
					"content": "正好有一个很适合你们的任务，我正想联系你们呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940104
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 726940104,
					"content": "很适合我们的任务…不会又是帮忙找东西，清理丘丘人之类的工作吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940105,
						726940106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726940105,
					"content": "还有上屋顶捡垃圾…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940107
					]
				},
				{
					"id": 726940107,
					"content": "不是不是，这次的任务确实十分适合你们，所谓「十分适合」的意思就是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940108
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 726940108,
					"content": "这份工作不仅看上去十分有趣，而且还有丰厚的报酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940109
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 726940109,
					"content": "有丰厚的报酬！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726940110,
					"content": "派蒙自动忽略了有趣的部分呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940111
					]
				},
				{
					"id": 726940111,
					"content": "当、当然，最主要是有趣啦，那到底是什么样的委托呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726940112,
					"content": "嗯，这次的委托者是来稻妻做生意的枫丹制造商伯特兰，在寻找帮助他制造商品的助手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940113
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 726940113,
					"content": "毕竟是生意人，在冒险者协会登记委托时填下的完成报酬一栏，数字可是相当可观。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940114
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 726940114,
					"content": "不过因为一些原因，他只能在「离岛」上活动。具体的详情就让他自己跟你们说吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940115
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 726940115,
					"content": "好，我们这就去「离岛」上找他！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726940106,
					"content": "或者奇怪的货物搬运…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940107
					]
				}
			]
		},
		{
			"id": 7269402,
			"completionStepIds": [
				7269402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7269402",
							"2"
						],
						"stepId": 7269402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"伯特兰"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726940201,
					"content": "哼哼，一切都已经准备就绪，只要我一个玩具卖上个几千摩拉…卖上几万个！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940202
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726940202,
					"content": "那不轻轻松松有几千万摩拉到手…嘿嘿嘿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940203
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726940203,
					"content": "喂！你就是伯特兰吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726940204,
					"content": "啊？是啊，我就是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940205
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726940205,
					"content": "怎么了，两位，难道你们也是听闻我的消息，来购买我制造的玩具的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940206
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726940206,
					"content": "不过稍微有点可惜啊，不能立刻卖给你们，因为我们还没有开始大规模的生产。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940207
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726940207,
					"content": "但是也不用急，现在生产线啊已经在筹备当中，如果有意向的话可以先进行登记并交付定金，等制造出来以后会通知您补足全款…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940208
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726940208,
					"content": "等等等等，我们不是来买玩具的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726940209,
					"content": "哦，这样…有什么事就快点说，别耽误我做生意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940210
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726940210,
					"content": "请长话短说，我的时间可是很宝贵的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940211
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726940211,
					"content": "哇，感觉这个人的态度一下就冷了下来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940212,
						726940213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726940212,
					"content": "我们是来帮忙的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940214
					]
				},
				{
					"id": 726940214,
					"content": "什么呀！哎呀，是来当助手的冒险家是吧，欢迎欢迎，嗨，原来是来帮忙的，你们早说嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940215
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726940215,
					"content": "对，在冒险家协会挂委托的就是我，请问你们怎么称呼啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940216
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726940216,
					"content": "（感觉态度一下又变了…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726940217,
					"content": "我叫派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726940218,
					"content": "那这位呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940219
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726940219,
					"content": "#{NICKNAME}…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940220
					]
				},
				{
					"id": 726940220,
					"content": "#{NICKNAME}，总觉得是在哪里听过的名字，难道…你们也被通缉过？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940221,
						726940223
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726940221,
					"content": "确实不止一次…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940222
					]
				},
				{
					"id": 726940222,
					"content": "那我可能是在被天领奉行通缉…不，是被他们叫去问话的时候听到过吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940225
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726940225,
					"content": "你到底做了什么，居然会被天领奉行找上门。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726940226,
					"content": "唉也没什么大不了的，就是上一次做出来的那一批玩具吧，出了一些微不足道的小问题…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940227
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726940227,
					"content": "微不足道的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940228
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726940228,
					"content": "小问题？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940229
					]
				},
				{
					"id": 726940229,
					"content": "嘿嘿，就是不小心撞到里面的触发装置就会爆炸嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940230
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726940230,
					"content": "爆炸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940231
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726940231,
					"content": "哎呀都是一些小问题啦，也没有人因此受伤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940232
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726940232,
					"content": "可是那些天领奉行的同心还是二话不说，就把我所有的玩具都扣留了…明明还可以作为「外形可爱的炸弹」出售的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940233
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726940233,
					"content": "唉，当初从枫丹过来的时候还借了万国商会一笔钱作为启动资金，谁能想到现在被限制入境，只能在离岛上艰难求生…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940234
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726940234,
					"content": "怎么想都是你自作自受…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940235
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726940235,
					"content": "等等，你既然还欠着万国商会的摩拉，哪还有那么多报酬来进行委托？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940236
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726940236,
					"content": "没关系，我还有最后一笔钱，只要我重新制造出玩具大卖一笔，就一定能还清欠款。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940237
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726940237,
					"content": "当然也能给你们丰厚的报酬啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940238
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726940238,
					"content": "…真的能成吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940239
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726940239,
					"content": "可别小看了稻妻的玩具市场啊，我造出的玩具在发现会爆炸之前可是很受欢迎的…甚至发现会爆炸以后还更受欢迎了一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940240
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726940240,
					"content": "总之，实在不行的话，就把玩具造出来给久利须会长以货抵债。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940241
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726940241,
					"content": "还请两位务必帮忙，嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940242
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726940242,
					"content": "可是你说要帮忙，具体是要做什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940243
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726940243,
					"content": "是这样的，我是靠我开发出的这个「独一无二绝对稳定工程用第二代炉心制造机」进行玩具制造的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940244
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726940244,
					"content": "说起我的「独一无二绝对稳定工程用第二代炉心制造机」啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940245
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726940245,
					"content": "名字太长了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940246
					]
				},
				{
					"id": 726940246,
					"content": "是啊，不如就叫…让我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940247
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726940247,
					"content": "就叫「大工机」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940248
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726940248,
					"content": "等等，这名字也太短了吧！一点都没有那种，特别厉害的感觉啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940249
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726940249,
					"content": "有的时候简短一点，反而能被大家记住。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940250
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726940250,
					"content": "「大工机」，我觉得「大工机」就很好，朗朗上口。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940251
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726940251,
					"content": "唉…好吧好吧，确实以前有人说过我取名品味不好，就相信你这一次吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940252
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726940252,
					"content": "派蒙的取名品味也好得有限…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940253
					]
				},
				{
					"id": 726940253,
					"content": "喂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940254
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726940254,
					"content": "哈哈哈，反正呢，我的「大工机」会自动分析加入的材料，用最适合的方式处理材料并进行组装。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940255
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726940255,
					"content": "但上次就因为加入了一些奇怪的机关，所以才会爆炸，我此次痛定思痛，进行了改装…理论上来说是没有这样的问题了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940256
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726940256,
					"content": "理论上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940257
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726940257,
					"content": "所以才需要有人帮忙进行试作实验嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940258
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726940258,
					"content": "总而言之，制作时，收集材料的环节总共分为三步，分别是「原材收集」、「元素充能」与最后的「核心激活」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940259
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726940259,
					"content": "我们需要收集一些素材，矿石啊、果实啊、花啊之类的，作为基础的原材料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940260
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726940260,
					"content": "之后就是补充元素力以保证制作物运作的环节，再最后就是用元素生物核心中的能量来保持制作物的动力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940261
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726940261,
					"content": "今天我们先试试第一步的「原材收集」吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940262
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726940262,
					"content": "来，这个「素材收集器」就交给你吧，对了，不管收集到什么，一定要直接放进素材收集器里啊，免得沾染别的元素力之类的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940263
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726940263,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940264
					]
				},
				{
					"id": 726940264,
					"content": "嗯，我再调试下机器，收集材料的活就交给你啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726940223,
					"content": "什么叫「也」被通缉过？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940224
					]
				},
				{
					"id": 726940224,
					"content": "哈哈，这个就说来话长了，我也因为一些小意外被天领奉行请去喝茶过…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940225
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726940213,
					"content": "你在冒险家协会挂了委托吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940214
					]
				}
			]
		},
