			"dialogs": [
				{
					"id": 726940401,
					"content": "怎么样，材料收集得如何了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940402
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726940402,
					"content": "全在收集器里了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940403
					]
				},
				{
					"id": 726940403,
					"content": "好，现在我们把收集到的素材加入我的独一无二绝对稳定…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940404
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726940404,
					"content": "「大工机」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726940405,
					"content": "好吧好吧，让我们把收集到的素材加入「大工机」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940406
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726940406,
					"content": "伯特兰将收集器插入「大工机」的槽口",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						726940407
					]
				},
				{
					"id": 726940407,
					"content": "哇，然后呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726940408,
					"content": "待会儿这个机器就会咕嘟咕嘟运转起来，然后噼里啪啦地造出玩具来吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726940409,
					"content": "哈哈哈，这当然是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940410
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726940410,
					"content": "不可能的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940411
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726940411,
					"content": "想什么呢，三个工序才完成了一个，离造出玩具还差得远呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940412
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726940412,
					"content": "原来是这样啊，要工序全都完成才有玩具。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726940413,
					"content": "对，要三个工序都依次完成一遍，才会产出玩具。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940414,
						726940415
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726940414,
					"content": "好麻烦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940416
					]
				},
				{
					"id": 726940416,
					"content": "你们啊，每天都想着速成。要对玩具制造的环节有耐心嘛，这中间的每一道制造工序，都要倾注制作者满满的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940417
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726940417,
					"content": "满满的什么？我明白了，毕竟做的是「玩具」，所以要倾注制作者满满的热爱！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940418
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726940418,
					"content": "对，要倾注我对摩拉满满的热爱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940419
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726940419,
					"content": "啊，虽然跟想象的不一样，但这样的热爱我也有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940420
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726940420,
					"content": "喂…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940421
					]
				},
				{
					"id": 726940421,
					"content": "嘿嘿，就顺势一说嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940422
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726940422,
					"content": "那伯特兰，我们接下来要去做什么，接着完成后面的工序吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940423
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726940423,
					"content": "不着急不着急，因为是调整过后的机器，还没有按照这个工序跑过，我先看看机器处理这些素材时有没有问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940424
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726940424,
					"content": "这得观察一会儿，你们过段时间再来找我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726940415,
					"content": "好繁琐…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940416
					]
				}
			]
		},
