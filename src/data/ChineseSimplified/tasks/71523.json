			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"廷稚"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715230101,
					"content": "唔，这样应该就不会太困难了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230102
					],
					"speakerTitle": "廷稚"
				},
				{
					"id": 715230102,
					"content": "你在做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715230103
					]
				},
				{
					"id": 715230103,
					"content": "我正在布置我所负责的这种游戏呢…您听说过「百步礼掷」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230104
					],
					"speakerTitle": "廷稚"
				},
				{
					"id": 715230104,
					"content": "我是要隔着很远，礼貌地丢东西吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715230105
					]
				},
				{
					"id": 715230105,
					"content": "您…非常敏锐，已经说对了大半，这种游戏的核心正是「丢掷」。但「礼」字可不是如此解法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230106
					],
					"speakerTitle": "廷稚"
				},
				{
					"id": 715230106,
					"content": "这种玩法我也是从一本古书里看来的，让我为您简单介绍一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230107
					],
					"speakerTitle": "廷稚"
				},
				{
					"id": 715230107,
					"content": "按照最传统的游戏规则，玩这种名为「礼掷」的游戏时，所有参与者都需要静坐下来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230108
					],
					"speakerTitle": "廷稚"
				},
				{
					"id": 715230108,
					"content": "呃，静坐的时候还需要保持一个特别的姿势，我就不为您示范了，这里没垫子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230109
					],
					"speakerTitle": "廷稚"
				},
				{
					"id": 715230109,
					"content": "静坐之后，游玩者需要遵循着某种特定音乐的节奏，将手里的「掷箭」投向远处的「容壶」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230110
					],
					"speakerTitle": "廷稚"
				},
				{
					"id": 715230110,
					"content": "「掷箭」入壶的各种方式，也有着各自的特别命名。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230111
					],
					"speakerTitle": "廷稚"
				},
				{
					"id": 715230111,
					"content": "比如第一支被投入壶中的箭，被叫做「有初」，如果第二箭也投进去了，那就叫做「连中」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230112
					],
					"speakerTitle": "廷稚"
				},
				{
					"id": 715230112,
					"content": "投出去的箭击中了壶耳，那就被称为「贯耳」。一支箭本来已经投入壶中，却又跳出来，则被叫做「骁箭」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230113,
						715230116
					],
					"speakerTitle": "廷稚"
				},
				{
					"id": 715230113,
					"content": "太、太复杂了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715230114
					]
				},
				{
					"id": 715230114,
					"content": "您别担心啊，我刚才不都说了，这只是「最传统的游戏规则」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230115
					],
					"speakerTitle": "廷稚"
				},
				{
					"id": 715230115,
					"content": "为了方便大家游玩，我已经将规则简化了许多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230118
					],
					"speakerTitle": "廷稚"
				},
				{
					"id": 715230118,
					"content": "咳，总之，您只需要记住，在一定的时间内，往那个壶里投入越多的「掷箭」越好，其余的…就交给我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230119
					],
					"speakerTitle": "廷稚"
				},
				{
					"id": 715230119,
					"content": "好简化的规则！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715230120
					]
				},
				{
					"id": 715230120,
					"content": "哎呀…那本书上写的游戏规则中，本来也写着谁投入壶中的箭越多，谁就获胜嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230121
					],
					"speakerTitle": "廷稚"
				},
				{
					"id": 715230121,
					"content": "至于输的人要饮酒作诗之类的…我总不能真让玩游戏的人输了就作诗吧，那多少有些难为人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230122
					],
					"speakerTitle": "廷稚"
				},
				{
					"id": 715230122,
					"content": "总之！场地我差不多已经布置好了，「容壶」就在那边，我等会再把「掷箭」拿过来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230123
					],
					"speakerTitle": "廷稚"
				},
				{
					"id": 715230123,
					"content": "有兴趣的话，您现在就可以去试玩一下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "廷稚"
				},
				{
					"id": 715230116,
					"content": "记、记不住！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715230117
					]
				},
				{
					"id": 715230117,
					"content": "别担心，您不需要记住这么多名词，这是…呃，这是我应该记住的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230118
					],
					"speakerTitle": "廷稚"
				}
			]
		}
	]
}