			},
			"dialogs": [
				{
					"id": 716662101,
					"content": "精彩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662102
					],
					"speakerTitle": "「且听下次复盘」"
				},
				{
					"id": 716662102,
					"content": "原来荒泷派所擅长的斗虫，发展成了如此激昂的角逐。嗯，确实能写成引人入胜的故事，好好说道说道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662103
					],
					"speakerTitle": "「且听下次复盘」"
				},
				{
					"id": 716662103,
					"content": "田兄台，让承了。我斗得很尽兴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662104
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 716662104,
					"content": "是「承让了」，鬼王。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662105
					],
					"speakerTitle": "「花角玉将」"
				},
				{
					"id": 716662105,
					"content": "咳咳！细节不重要！总之…多谢田兄台捧场！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662106
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 716662106,
					"content": "也有劳荒泷帮主了。这段时间，我还会在此观摩斗虫，好好取材！你们尽情玩，不理会我也无妨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662107
					],
					"speakerTitle": "「且听下次复盘」"
				},
				{
					"id": 716662107,
					"content": "真是个文雅的对手，说得我脑袋嗡嗡的，感觉好像学到了一些斗虫之外的知识？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662108
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 716662108,
					"content": "看来这次「荒泷甲光烈烈斗虫大修行」还真是开了个好头啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "荒泷一斗"
				}
			]
		},
