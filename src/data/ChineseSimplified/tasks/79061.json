				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": [
					{
						"sceneId": 100,
						"position": [
							998.028,
							216.884,
							711.501
						],
						"pointId": 294
					}
				]
			},
			"dialogs": [
				{
					"id": 790610201,
					"content": "是的。<color=#FFCC33FF>外面的世界</color>有许多新鲜事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610202
					]
				},
				{
					"id": 790610202,
					"content": "对呀，外面有好多好吃的和好玩的，还能遇见好多有趣的事，认识很多厉害的人。比如…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610203,
						790610204,
						790610205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790610203,
					"content": "有专注着事物美好本质的人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610206
					]
				},
				{
					"id": 790610206,
					"content": "真的？哎呀，我还以为外面世界的只有「价值」，大家都是那种想戴帽子却又不敢的人呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610207
					],
					"speakerTitle": "埃斯诺尔"
				},
				{
					"id": 790610207,
					"content": "这个呀…呃，那个…就，就像是蛋糕上面撒的巧克力，每一颗都是不同的味道呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790610208,
					"content": "要是每一颗巧克力豆全是一个味道，那蛋糕吃起来不就很普通了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610209,
						790610210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790610209,
					"content": "派蒙，很会说嘛。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610211
					]
				},
				{
					"id": 790610211,
					"content": "都听了这么久，多少也会一点了嘛，嘿嘿，是不是还挺有道理的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790610212,
					"content": "这样吗？我…我还要再想想…也许，去小小地远游一下，也不错…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610213
					],
					"speakerTitle": "埃斯诺尔"
				},
				{
					"id": 790610213,
					"content": "不用着急，埃斯诺尔，离下次起航日还很远，我可以和你一起慢慢想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "罗泽尔"
				},
				{
					"id": 790610210,
					"content": "派蒙已经完全融入这里了啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610211
					]
				},
				{
					"id": 790610204,
					"content": "永不褪色的灿烂理想…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610206
					]
				},
				{
					"id": 790610205,
					"content": "和为了梦想努力的人们。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610206
					]
				}
			]
		},
		{
			"id": 7906103,
			"completionStepIds": [
				7906101
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
