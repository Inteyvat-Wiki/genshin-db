						],
						"pointId": 294
					}
				]
			},
			"dialogs": [
				{
					"id": 790610301,
					"content": "<color=#FFCC33FF>里面的世界</color>倒也不错。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610302
					]
				},
				{
					"id": 790610302,
					"content": "嗯。这里毕竟是埃斯诺尔的家呢。埃斯诺尔肯定也很喜欢这里。而且…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610303,
						790610304,
						790610305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790610303,
					"content": "这里有许多熟悉的朋友。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610306
					]
				},
				{
					"id": 790610306,
					"content": "是的！我就担心失去这些，总是为这些事烦忧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610307
					],
					"speakerTitle": "埃斯诺尔"
				},
				{
					"id": 790610307,
					"content": "这一切都很好，好的不得了…我不愿他们改变，也不愿自己改变。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610308
					],
					"speakerTitle": "埃斯诺尔"
				},
				{
					"id": 790610308,
					"content": "…但是。远游会让一切都变得不一样。对吗？罗泽尔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610309
					],
					"speakerTitle": "埃斯诺尔"
				},
				{
					"id": 790610309,
					"content": "会的，一定会。我不愿骗你，也无意让你难过，亲爱的埃斯诺尔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610310
					],
					"speakerTitle": "罗泽尔"
				},
				{
					"id": 790610310,
					"content": "好的…好的。我明白你的心，你一定也明白我的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610311
					],
					"speakerTitle": "埃斯诺尔"
				},
				{
					"id": 790610311,
					"content": "我要好好想想你的邀请，稍后再做下决定…至少现在，我们只应该一起平静地喝点茶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610312
					],
					"speakerTitle": "埃斯诺尔"
				},
				{
					"id": 790610312,
					"content": "好吧…我会陪着你的，埃斯诺尔。离下次起航日还很远，我可以和你一起慢慢想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "罗泽尔"
				},
				{
					"id": 790610304,
					"content": "有很多漂亮的花…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610306
					]
				},
				{
					"id": 790610305,
					"content": "和好吃的蛋糕。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610306
					]
				}
			]
		},
		{
			"id": 7906104,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7906102",
							"2"
						],
						"stepId": 7906102,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_VAR_EQUAL",
						"rawParams": [
							"0",
							"1",
							"79061"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790610401,
					"content": "罗泽尔，或许…我可以和你同行。但是…我不知道该如何准备。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610402
					],
					"speakerTitle": "埃斯诺尔"
				},
				{
					"id": 790610402,
					"content": "这很简单。准备好你的果酱，面包和好奇心。穿上舒适的衣服，也带上一些备用的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610403
					],
					"speakerTitle": "罗泽尔"
				},
				{
					"id": 790610403,
					"content": "最后，再做好心理准备——因为你很可能会在半路不得不丢掉它们之中的一些东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610404
					],
					"speakerTitle": "罗泽尔"
				},
				{
					"id": 790610404,
					"content": "哦。听起来真复杂。而且我不想丢掉它们，它们是我的东西，很宝贵，我爱它们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610405
					],
					"speakerTitle": "埃斯诺尔"
				},
				{
					"id": 790610405,
					"content": "在它们离开你之后，你会遇见新的宝贵物件的，亲爱的埃斯诺尔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610406
					],
					"speakerTitle": "罗泽尔"
				},
				{
					"id": 790610406,
					"content": "相信我，这会是一趟有趣的旅程。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "罗泽尔"
				}
			]
		},
		{
			"id": 7906105,
