			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790610501,
					"content": "抱歉，罗泽尔。我…还是不能和你同行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610502
					],
					"speakerTitle": "埃斯诺尔"
				},
				{
					"id": 790610502,
					"content": "我待在这里就足够了。这样的话，当你远游回来时，至少会有人迎接你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610503
					],
					"speakerTitle": "埃斯诺尔"
				},
				{
					"id": 790610503,
					"content": "但是，埃斯诺尔，我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610504
					],
					"speakerTitle": "罗泽尔"
				},
				{
					"id": 790610504,
					"content": "我不够聪明，也不够勇敢，罗泽尔。但我想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610505
					],
					"speakerTitle": "埃斯诺尔"
				},
				{
					"id": 790610505,
					"content": "风穿过树丛，河流经湖泊，周而复始，他们总是会在最后回到起点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610506
					],
					"speakerTitle": "埃斯诺尔"
				},
				{
					"id": 790610506,
					"content": "或许，它们在经历了那么多改变后，最终的愿望还是…变回最初的自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610507
					],
					"speakerTitle": "埃斯诺尔"
				},
				{
					"id": 790610507,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610508
					],
					"speakerTitle": "罗泽尔"
				},
				{
					"id": 790610508,
					"content": "我会在家里等你的，好朋友，一如既往。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "埃斯诺尔"
				}
			]
		},
