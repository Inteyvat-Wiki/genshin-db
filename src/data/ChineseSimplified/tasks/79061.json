			},
			"dialogs": [
				{
					"id": 790610101,
					"content": "罗泽尔，无论你说多少遍，我都不会和你去远游的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610102
					],
					"speakerTitle": "埃斯诺尔"
				},
				{
					"id": 790610102,
					"content": "我是你的朋友，这永远不变，我不讨厌你。但…但我不喜欢远游。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610103
					],
					"speakerTitle": "埃斯诺尔"
				},
				{
					"id": 790610103,
					"content": "埃斯诺尔，这一切没有你想象的那么可怕，只是一场旅行，仅此而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610104
					],
					"speakerTitle": "罗泽尔"
				},
				{
					"id": 790610104,
					"content": "外面的世界有许多村里没有的花，没见过的人，甚至连云的形状都不一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610105
					],
					"speakerTitle": "罗泽尔"
				},
				{
					"id": 790610105,
					"content": "我不是从外面给你带来了花种吗？我保证，你肯定从未见过这种形状和颜色的花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610106
					],
					"speakerTitle": "罗泽尔"
				},
				{
					"id": 790610106,
					"content": "它还是种子，我要把它种下去，等它开了花才知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610107
					],
					"speakerTitle": "埃斯诺尔"
				},
				{
					"id": 790610107,
					"content": "如果你愿意和我去远游，那么我们也许能直接找到这种花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610108
					],
					"speakerTitle": "罗泽尔"
				},
				{
					"id": 790610108,
					"content": "罗泽尔…抱歉，我不想远游，也不想变得和那些冒险客一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610109
					],
					"speakerTitle": "埃斯诺尔"
				},
				{
					"id": 790610109,
					"content": "他们总是操心地毯的价值，不在意漂亮的帽子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610110
					],
					"speakerTitle": "埃斯诺尔"
				},
				{
					"id": 790610110,
					"content": "这是远游带给你们的改变，我害怕它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610111
					],
					"speakerTitle": "埃斯诺尔"
				},
				{
					"id": 790610111,
					"content": "这是事实。但你注意到他们手提箱里的地图，植物样本，还有写得满满当当的游记了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610112
					],
					"speakerTitle": "罗泽尔"
				},
				{
					"id": 790610112,
					"content": "我们就像一阵风穿过不同的树丛，一条河流经另一片湖泊…结识了新鲜事，但也不再是从前的自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610113
					],
					"speakerTitle": "罗泽尔"
				},
				{
					"id": 790610113,
					"content": "这是远游带给我们的改变，我也惧怕它…但我也感谢它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610114
					],
					"speakerTitle": "罗泽尔"
				},
				{
					"id": 790610114,
					"content": "就像一片两面都涂着奶油的面包，无论你再怎么小心地拿起，总会有一面的奶油被你弄得一团糟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610115
					],
					"speakerTitle": "罗泽尔"
				},
				{
					"id": 790610115,
					"content": "那我就把奶油分开涂，这样我甚至能涂上不同口味。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610116,
						790610117
					],
					"speakerTitle": "埃斯诺尔"
				},
				{
					"id": 790610116,
					"content": "这主意不错，听起来一定能吃饱。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610118
					]
				},
				{
					"id": 790610118,
					"content": "是您啊，您可算来了。罗泽尔一直在告诉我，外面的世界很美好，邀请我去远游…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610119
					],
					"speakerTitle": "埃斯诺尔"
				},
				{
					"id": 790610119,
					"content": "您对外面的世界有了解吗？那边…真的和罗泽尔说的一样吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "埃斯诺尔"
				},
				{
					"id": 790610117,
					"content": "这想法挺好，奶油不会弄到手上。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610118
					]
				}
			]
		},
		{
			"id": 7906102,
			"completionStepIds": [
				7906101
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7906101",
							"2"
