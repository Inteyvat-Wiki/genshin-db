			"dialogs": [
				{
					"id": 790610601,
					"content": "「这封信给我的邻居，朋友，灯塔和小花。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610602
					],
					"speakerTitle": "字迹歪歪扭扭的信"
				},
				{
					"id": 790610602,
					"content": "「我即将和罗泽尔外出远游。您尽管用我的秋千，桌子和凳子。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610603
					],
					"speakerTitle": "字迹歪歪扭扭的信"
				},
				{
					"id": 790610603,
					"content": "「祝您愉快。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610604
					],
					"speakerTitle": "字迹歪歪扭扭的信"
				},
				{
					"id": 790610604,
					"content": "「您的邻居，埃斯诺尔。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "字迹歪歪扭扭的信"
				}
			]
