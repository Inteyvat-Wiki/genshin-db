				"points": []
			},
			"dialogs": [
				{
					"id": 751880101,
					"content": "请你帮个忙，去田里找找我家<color=#00E1FFFF>三只小龙</color>，让它们回我脚边来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "帕卡林"
				}
			]
		},
		{
			"id": 7518802,
			"completionStepIds": [
				7518802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7518802",
							"2"
						],
						"stepId": 7518802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"帕卡林"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751880201,
					"content": "那边的，对，没错，就是你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880202
					],
					"speakerTitle": "帕卡林"
				},
				{
					"id": 751880202,
					"content": "看你走路带风，跑得飞快，应该挺有力气的，像是经常锻炼的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880203
					],
					"speakerTitle": "帕卡林"
				},
				{
					"id": 751880203,
					"content": "是我们「沃陆之邦」的勇士吗？还是说你来自其他部族？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880204,
						751880205
					],
					"speakerTitle": "帕卡林"
				},
				{
					"id": 751880204,
					"content": "我是路过的冒险家。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751880206
					]
				},
				{
					"id": 751880206,
					"content": "这样啊，有点可惜了。唉，也是，正缺人的时候突然就碰上个帮忙的，这种好事也就是梦里才有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880207
					],
					"speakerTitle": "帕卡林"
				},
				{
					"id": 751880207,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751880208
					]
				},
				{
					"id": 751880208,
					"content": "是这样的，你也看见了，我这里不是有片农场嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880209
					],
					"speakerTitle": "帕卡林"
				},
				{
					"id": 751880209,
					"content": "这个农场一直是我一个人打理，但这阵子挺不巧的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880210
					],
					"speakerTitle": "帕卡林"
				},
				{
					"id": 751880210,
					"content": "前几天，我去跟部族里的勇士角力，弄伤了背…是，我知道这件事挺蠢的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880211
					],
					"speakerTitle": "帕卡林"
				},
				{
					"id": 751880211,
					"content": "结果，我现在既不能帮我爸爸开垦新田，也没法打理自己的农场，说实话，连走路都痛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880212
					],
					"speakerTitle": "帕卡林"
				},
				{
					"id": 751880212,
					"content": "正想雇个人帮几天忙，恰好碰上你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880213
					],
					"speakerTitle": "帕卡林"
				},
				{
					"id": 751880213,
					"content": "可惜你只是路过，种地得天天下田，你要是一会儿来一会儿不来，我这片田就荒废了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880214
					],
					"speakerTitle": "帕卡林"
				},
				{
					"id": 751880214,
					"content": "但我现在也没力气跑大老远去部族里找人，唉，除了养的几只小突角龙，眼前也没什么人能帮忙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880215
					],
					"speakerTitle": "帕卡林"
				},
				{
					"id": 751880215,
					"content": "几只小捣蛋鬼这几天也不听话，三只全都赖在田里，都不肯到我脚边来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880216
					],
					"speakerTitle": "帕卡林"
				},
				{
					"id": 751880216,
					"content": "这样吧，我能不能请你帮个小忙，替我把它们带回来，我真是不方便走路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880217
					],
					"speakerTitle": "帕卡林"
				},
				{
					"id": 751880217,
					"content": "没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751880218
					]
				},
				{
					"id": 751880218,
					"content": "那就太好了，它们平时都还听话，经常陪我在田里忙活，只是这两天不知道怎么回事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880219
					],
					"speakerTitle": "帕卡林"
				},
				{
					"id": 751880219,
					"content": "你招呼它们一声，我家的三只小龙大概自己就会回来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "帕卡林"
				},
				{
					"id": 751880205,
					"content": "我不是纳塔人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751880206
					]
				}
			]
		},
		{
			"id": 7518804,
			"completionStepIds": [
				7518804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7518804",
							"2"
						],
						"stepId": 7518804,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"帕卡林"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751880401,
					"content": "这三个小家伙都回来了，应该都是你的功劳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880402
					],
					"speakerTitle": "帕卡林"
				},
				{
					"id": 751880402,
					"content": "路过的勇士，谢谢你这份好心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880403
					],
					"speakerTitle": "帕卡林"
				},
				{
					"id": 751880403,
					"content": "我这背还是疼，但至少有小龙在边上，有它们陪着，感觉舒坦多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880404
					],
					"speakerTitle": "帕卡林"
				},
				{
					"id": 751880404,
					"content": "我也不是很富裕，但一点报酬还是出得起，这些东西请你拿着吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "帕卡林"
				}
			]
		}
	]
}