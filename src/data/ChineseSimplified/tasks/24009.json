					"德皮耶里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240090901,
					"content": "这下…可不好处理了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090902,
						240090903
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090902,
					"content": "这次要拍什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090904
					]
				},
				{
					"id": 240090904,
					"content": "这次…就不劳烦您帮我去留影了，我想请您帮我另外一个忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090905
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090905,
					"content": "咳，说出来非常不好意思，能不能…请您帮我去找点吃的…比如「蒜香面包棍」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090906,
						240090907
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090906,
					"content": "你是…没带吃的吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090908
					]
				},
				{
					"id": 240090908,
					"content": "不！我自己带了很多面包，还有果酱和肉干，本来应该够我今天吃的了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090909
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090909,
					"content": "但我光顾着画画，就把这些食物放在旁边…当我意识到饿的时候，这些食物已经不见了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090910
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090910,
					"content": "不知道是被动物叼走了，还是被哪个饿极了的过路人悄悄拿走…唉，希望这些食物能填饱他们的肚子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090911
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090911,
					"content": "但我自己饥饿的肚子，就不得不另找个方法填饱啦…我可不能现在就回城里去，素材还没找够呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090912,
						240090913
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090912,
					"content": "你稍等一会。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090914
					]
				},
				{
					"id": 240090914,
					"content": "那就拜托您了，「蒜香面包棍」在城里的商店里就能买到！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090915
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090915,
					"content": "哈哈…我现在有点没力气了，不知道是饿的，还是思考过度…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090913,
					"content": "我去给你拿点过来。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090914
					]
				},
				{
					"id": 240090907,
					"content": "你是…没钱买吃的了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090908
					]
				},
				{
					"id": 240090903,
					"content": "这次要去哪里留影？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090904
					]
				}
			]
		},
