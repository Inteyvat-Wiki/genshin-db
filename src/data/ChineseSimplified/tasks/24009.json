			"dialogs": [
				{
					"id": 240090601,
					"content": "我看看…我的那些朋友给了我一些建议，我把它们都记录在本子上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090602
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090602,
					"content": "我写的这是什么？我看看…呃…水底…崎岖的岩石…岩石上的植物…岩石的轮廓…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090603
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090603,
					"content": "喔，没错，那个时候我非常痴迷研究岩石，我认为岩石最能体现自然的美感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090604
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090604,
					"content": "那就拜托您帮我去水底拍摄几张岩石的画片吧，不知道水底的岩石会有着怎么样的轮廓…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "德皮耶里"
				}
			]
		},
