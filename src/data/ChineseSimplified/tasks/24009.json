			},
			"dialogs": [
				{
					"id": 240091101,
					"content": "还是缺了点张力…到底怎么回事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091102
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240091102,
					"content": "但是…总觉得少了点决定性的东西啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091103,
						240091105
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240091103,
					"content": "你在留影吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091104
					]
				},
				{
					"id": 240091104,
					"content": "是的，为了创作绘画，我正在用留影机取材。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091107
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240091107,
					"content": "我是德皮耶里，一位画家，很高兴结识您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091108
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240091108,
					"content": "喔…喔，你好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091109
					]
				},
				{
					"id": 240091109,
					"content": "一般来说，对一位新朋友，我理应请一杯咖啡，但现在周围也没咖啡馆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091110
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240091110,
					"content": "这样，您把这杯枫达拿好吧，咱们碰个杯，就当做是正式结识了…您之前来过枫丹吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091111
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240091111,
					"content": "这是第一次来。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091112
					]
				},
				{
					"id": 240091112,
					"content": "那您可有得玩了，您可以先去城里逛逛，见识一下头顶上纵横的水道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091113
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240091113,
					"content": "然后去街上，看看那些精巧的机关，从我这个画家的角度来说…并不是所有机关都不具有审美价值。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091114
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240091114,
					"content": "最后您必须得去咖啡馆点一杯咖啡，坐下来慢慢品尝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091115
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240091115,
					"content": "在您喝咖啡的时候，也许会有人上来和您搭话呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091116
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240091116,
					"content": "但是，如果上来搭话的人告诉您，他们是属于什么「留影机爱好协会」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091117
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240091117,
					"content": "那您可得提高警惕，他们说不定会和您说一些蠢话…毕竟，他们之中的一部分人正在做蠢事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091118,
						240091120
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240091118,
					"content": "他们做了什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091119
					]
				},
				{
					"id": 240091119,
					"content": "他们做了什么？他们中的一部分人，正在将我们枫丹的文明生活推向毁灭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091122
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240091122,
					"content": "可别觉得我是危言耸听。您猜这个协会里有人说什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091123
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240091123,
					"content": "「如果只论画面，留影机所拍出的画片，可比画家画出的画好多啦。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091124
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240091124,
					"content": "请您听听这句话吧！「如果只论画面」，多么愚蠢，那帮人却奉为真理！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091125
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240091125,
					"content": "如果画家只是想要分毫不差地呈现画面，那还要审美做什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091126
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240091126,
					"content": "好吧，我的一部分同行确实也正琢磨着如何更加细致地进行写实…但那也是基于他们的审美。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091127
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240091127,
					"content": "审美！重点在于审美，您懂吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091128,
						240091129
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240091128,
					"content": "我，我真不太懂…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091130
					]
				},
				{
					"id": 240091130,
					"content": "画家用眼睛窥见世界只是第一步，我们必须得用笔探索灵性和美，才能把一幅好画从心里掏出来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091131
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240091131,
					"content": "我不想将所有喜爱留影机的人都划归成不懂审美的粗鲁愚夫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091132
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240091132,
					"content": "我也有许多喜爱留影机的朋友，我们时常交流。有时他们的画片能带给我灵感，有时我的画也能启发他们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091133
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240091133,
					"content": "但那些不学无术，只知道大放厥词之人，真让我难以忍受！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091134
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240091134,
					"content": "他们同时侮辱了爱好留影的人，和爱好绘画的人！他们真是…咳咳…咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091135
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240091135,
					"content": "你喝点水，喝点水…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091136
					]
				},
				{
					"id": 240091136,
					"content": "谢谢您…我每次说到这件事，就会不由自主地生气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091137
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240091137,
					"content": "所以，我和几位朋友打算用这架留影机拍一系列画片，以它们为素材，创作一系列绘画。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091138
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240091138,
					"content": "然后将这些画和所参考的画片摆在一起，做一个画展，让人们看看，绘画和留影到底有何区别！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091139
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240091139,
					"content": "但是…唉，我拍出来的这几张画片根本没什么意思。我的那几位朋友说，好景往往在险地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091140
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240091140,
					"content": "像是水底啦，山巅啦，还有人迹罕至的茂密丛林…但我一个人可不敢去那边啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091141
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240091141,
					"content": "如果拜托冒险家帮忙，又要花太长时间…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091142
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240091142,
					"content": "#嗯…亲爱的{M#先生}{F#女士}，您应该不会介意…被一位艺术家所雇佣吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091143,
						240091144
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240091143,
					"content": "只要别让我画画…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091145
					]
				},
				{
					"id": 240091145,
					"content": "无须担心，咱们俩都只需要做各自擅长的事就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091146
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240091146,
					"content": "您也不需要担心报酬的问题，我经常委托冒险家保护我去各地取材，懂他们的规矩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091147
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240091147,
					"content": "只不过这次出来得太急，一时半会找不到冒险家同行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091148
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240091148,
					"content": "那这件事就这么定了，有您帮忙，我更有信心画出一幅好画了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240091144,
					"content": "我只擅长冒险家擅长的事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091145
					]
				},
				{
					"id": 240091129,
					"content": "我，我只懂一点…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091130
					]
				},
				{
					"id": 240091120,
					"content": "他们会对我做什么吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091121
					]
				},
				{
					"id": 240091121,
					"content": "就像他们中的一部分人对枫丹做的一样，将您本该享有的文明生活推向毁灭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091122
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240091105,
					"content": "你是留影机爱好者吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091106
					]
				},
				{
					"id": 240091106,
					"content": "爱好？当然不，留影机对我来说只是一个获取参考的工具，比起它，我更愿意去珍爱我的画笔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091107
					],
					"speakerTitle": "德皮耶里"
				}
			]
		},
