			},
			"dialogs": [
				{
					"id": 240090401,
					"content": "我看看…我的那些朋友给了我一些建议，我把它们都记录在本子上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090402
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090402,
					"content": "「水底的巨大废墟！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090403
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090403,
					"content": "我怎么写得这么用力，都要把纸戳破了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090404
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090404,
					"content": "但水底的巨大废墟…听起来确实带着一点别样的美感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090405
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090405,
					"content": "那就请您帮我去拍一拍水底的废墟吧，越大越好，越残破越好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "德皮耶里"
				}
			]
		},
