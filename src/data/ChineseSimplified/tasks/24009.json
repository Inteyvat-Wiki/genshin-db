			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"德皮耶里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240090201,
					"content": "我看看…我的那些朋友给了我一些建议，我把它们都记录在本子上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090202
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090202,
					"content": "水底植物…摇摆…光影…变化…我当时在写什么，难道是喝多了？呃…对，应该是喝多了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090203
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090203,
					"content": "咳，请您帮我去水底拍一拍那些水生植物吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090204
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090204,
					"content": "看起来…写这些记录的我，对于水底植物上的光影变化很感兴趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "德皮耶里"
				}
			]
		},
