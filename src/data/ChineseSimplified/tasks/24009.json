			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"德皮耶里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240090101,
					"content": "旅行者！您来得正好，我刚好找到了一个绝佳的留影地点，就差您帮我一把了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090102
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090102,
					"content": "你还在取材？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090103
					]
				},
				{
					"id": 240090103,
					"content": "当然，这些素材还远远不够呢，一张画片，是不足以让我创作出一整幅画的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090104
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090104,
					"content": "一般来说，如果我决定用画片作为参考素材，那所需的画片少则几十张，多则上百张。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090105,
						240090106
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090105,
					"content": "要那么多啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090107
					]
				},
				{
					"id": 240090107,
					"content": "就像我之前告诉您的，绘画的重点在于「创作」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090108
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090108,
					"content": "如果只是把所见的东西事无巨细地呈现在画布上…那不叫「绘画」，那叫「留影」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090109
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090109,
					"content": "画家真正要做的，是用自己的审美和灵性审视他所见的事物，将这些事物筛选、变形、裁剪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090110
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090110,
					"content": "直到将每一个事物中最「美」的部分抽象出来，再刻进画布里，这样才能完成一幅画。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090111,
						240090112
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090111,
					"content": "听不懂！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090113
					]
				},
				{
					"id": 240090113,
					"content": "您…好吧，简单来说，我只会用这些画片里最好看的部分做参考。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090114
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090114,
					"content": "比如这张画的光影非常不错，但景物差了一些，那我就只会参考它的光影。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090115
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090115,
					"content": "另一张画片里有一位行人摆出了非常有趣的动态，下一张画片里的建筑很雄伟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090116
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090116,
					"content": "就像是在您的思维里玩一场拼图游戏，最后拼出来的事物美丑与否，纯粹取决于您个人的审美和学识。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090117
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090117,
					"content": "我这么说真的非常不严谨，因为我们还会把素材里的景物进行变形啦，抽象啦之类的…但您这么理解就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090118,
						240090119
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090118,
					"content": "所以，你还需要我帮忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090120
					]
				},
				{
					"id": 240090120,
					"content": "呃…没错！您的留影技巧真的非常高超，我的那些朋友在看了您帮我拍的画片之后，都恨不得亲自来见您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090121
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090121,
					"content": "有了您的帮忙，我一定能创作出超凡绝伦的绘画。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090122
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090122,
					"content": "哎呀，为了人们的审美，还有我准备好的这些摩拉，请您再帮帮我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090119,
					"content": "所以，我得继续帮你取材。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090120
					]
				},
				{
					"id": 240090112,
					"content": "讲简单点啦！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090113
					]
				},
				{
					"id": 240090106,
					"content": "这些画片的作用不一样吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090107
					]
				}
			]
		},
		{
			"id": 2400902,
			"completionStepIds": [
				2400902
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
