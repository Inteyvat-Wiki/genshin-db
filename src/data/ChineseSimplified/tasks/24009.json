			"dialogs": [
				{
					"id": 240091001,
					"content": "多谢您，这些东西就够我填饱肚子了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091002
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240091002,
					"content": "这些报酬是给您的，请收下吧。我得赶紧吃几口了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091003
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240091003,
					"content": "下次…我还是带一些能装进兜里的饼干吧…",
					"roleType": "TALK_ROLE_NPC",
