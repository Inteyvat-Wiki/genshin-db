					"德皮耶里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240090801,
					"content": "您帮我拍到画片了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090802
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090802,
					"content": "拍到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090803
					]
				},
				{
					"id": 240090803,
					"content": "我看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090804
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090804,
					"content": "完美的画片！没想到您居然在留影方面有着如此造诣，太出色了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090805
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090805,
					"content": "从这张画片里，我一定能筛选出绝佳的素材。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090806
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090806,
					"content": "太感谢您了，让我看看…我的摩拉放在哪了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090807
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090807,
					"content": "好了，这些给您，请务必收下！如果之后有机会的话，还请您务必再帮我去留几张影。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090808
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090808,
					"content": "接下来…让我看看怎么构思画面…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "德皮耶里"
				}
			]
		},
		{
