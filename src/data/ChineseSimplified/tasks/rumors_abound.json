			},
			"dialogs": [
				{
					"id": 120210301,
					"content": "心海——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120210302,
					"content": "心海，我们找到商人的货物啦。你看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120210303,
					"content": "唔…哦哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210304,
						120210305
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120210304,
					"content": "有什么心事吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120210306
					]
				},
				{
					"id": 120210306,
					"content": "没事，只是稍稍有些走神而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210307
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120210307,
					"content": "让我看看…确实，这些应该就是商人先生丢的东西了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210308
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120210308,
					"content": "粮食、药材、农耕用具…都是战后急需的东西。他囤着这些，估计是想卖个好价钱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210309
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120210309,
					"content": "不过，天领奉行应该不缺这些东西，他倒确实不至于把这些运回天领奉行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210310
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120210310,
					"content": "多半只是个投机的商人而已，没有松田和内村说的那么夸张。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210311
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120210311,
					"content": "唔…但是，故意囤积这些必需品，明显也是个坏家伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120210312,
					"content": "我们就这样把货物还回去吗？总觉得有点不舒服…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120210313,
					"content": "放心吧，这种情况我已经考量过了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210314
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120210314,
					"content": "在最新的「战后临时法令」中，我限制了必需品的价格上限。这些东西，最终还是会以合理的价格流入民众手里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210315
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120210315,
					"content": "如果他能早一点读读法令，应该也不会遭此无妄之灾了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210316
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120210316,
					"content": "嘿嘿，总觉得心海什么事都能算到呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120210317,
					"content": "太夸张啦。就拿眼下来说，关于天领奉行勾结愚人众的传闻，我就没什么头绪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210318
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120210318,
					"content": "正好还是在「能量」快不够的时候…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210319
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120210319,
					"content": "嗯？心海，你刚刚说什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120210320,
					"content": "没什么，我们快点将这堆货物还回去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210321
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120210321,
					"content": "庆功宴就快到了，这些麻烦事，必须早点做个了结。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210322
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120210322,
					"content": "好欸！我们也想在一个和平的海祇岛上开庆功宴呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120210305,
					"content": "心海在想什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120210306
					]
				}
			]
		},
