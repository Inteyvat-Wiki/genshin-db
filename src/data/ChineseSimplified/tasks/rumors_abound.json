					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211010
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120211010,
					"content": "我们好好调查一下这个营地吧，如果那位商人没有说谎的话，货物应该就在这里。",
