			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"珊瑚宫心海"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120210101,
					"content": "商人所说的愚人众营地，应该就是在这里了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210102
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120210102,
					"content": "从布设来看，这里应该曾经是一个丘丘人的营地，不知为何被愚人众占据了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210103
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120210103,
					"content": "哇…感觉戒备很森严的样子。我们真的能进去吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120210104,
					"content": "直接突破恐怕很难。不过没关系，此处地形对我们有利，而且我们的位置没有暴露。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210105
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120210105,
					"content": "敌在明处，我们在暗处，正是使用计谋的好时机。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210106
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120210106,
					"content": "军师大人有何高见？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120210107
					]
				},
				{
					"id": 120210107,
					"content": "以我之见，不外三种对策。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210108
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120210108,
					"content": "第一种，擒贼擒王。愚人众在稻妻的势力暂时不成气候，剩下来的无非是残兵败将。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210109
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120210109,
					"content": "若是能够自高处飞下，率先击溃其中的首领，那么杂兵便不攻自破。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210110
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120210110,
					"content": "#第二种，借势而为。{NICKNAME}你看，那边堆积了一些火药桶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210111
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120210111,
					"content": "若是在他们没有发觉的情况下引爆火药，会给他们带来极大的冲击。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210112
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120210112,
					"content": "猝不及防之下，对方必定会军心动摇，战斗力也大大下降。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210113
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120210113,
					"content": "最后一种，则是善用地利。此处近海，水汽氤氲。我可以牵引周遭水汽，配合你的雷电将其麻痹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210114
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120210114,
					"content": "不愧是心海，这么快就有办法了。可是我们要采取哪个方案呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120210115,
					"content": "这三种方案的主要差别，在于实施者对自己能力的判断。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210116
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120210116,
					"content": "从上方空降，奇袭大营，是最快的方法。但是对于武力有很高的要求。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210117
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120210117,
					"content": "利用爆炸使对方瞬间减员，则不需要正面苦战。但是要隐匿声息，不能暴露位置。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210118
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120210118,
					"content": "#而利用地利，则必须要稳扎稳打，可能会演变为持久战。{NICKNAME}，你比较喜欢哪一种战术？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210119,
						120210123,
						120210127
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120210119,
					"content": "奇袭营地。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120210120
					]
				},
				{
					"id": 120210120,
					"content": "呵呵…不愧是剑鱼二番队的队长，对自己的实力很有信心嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210121
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120210121,
					"content": "既然选定了这个战术，那我们就并肩作战吧。我虽不是武斗派，但也能提供一些支援，不会让你孤军奋战。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210122
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120210122,
					"content": "尽快打倒他们，然后将商人的货物找回来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120210123,
					"content": "引爆炸药。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120210124
					]
				},
				{
					"id": 120210124,
					"content": "呵呵…看来你跟我一样，也对奇谋感兴趣呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210125
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120210125,
					"content": "我也比较喜欢这个战术，毕竟这样的危险性是最低的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210126
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120210126,
					"content": "就让我们好好配合，给他们一个「惊喜」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120210127,
					"content": "感电配合。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120210128
					]
				},
				{
					"id": 120210128,
					"content": "嗯，将他们从营地中引出来，可以最大程度地保证营地的完整。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210129
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120210129,
					"content": "不过，以前我们没有太多并肩作战的机会，不知道我能不能跟上你的节奏…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210130
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120210130,
					"content": "放心，虽然我不敢自称武斗派，但长期与军队为伴，这样的场面应该也能够应付。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210131
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120210131,
					"content": "是时候把这个愚人众营地清理掉，到里面一探究竟了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚宫心海"
				}
			]
		},
		{
			"id": 1202102,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
