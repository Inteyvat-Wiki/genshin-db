			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"珊瑚宫心海"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120210201,
					"content": "不过没想到，愚人众竟然借丘丘人的营地为掩护，悄悄在这里驻扎了这么久。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210202
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120210202,
					"content": "他们的目的是什么呢？难道说，真的像士兵们所说的那样，他们已经勾结了天领奉行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210203
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120210203,
					"content": "我们好好调查一下这个营地吧，如果那位商人没有说谎的话，货物应该就在这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210204
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120210204,
					"content": "好！那我们先四处看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
