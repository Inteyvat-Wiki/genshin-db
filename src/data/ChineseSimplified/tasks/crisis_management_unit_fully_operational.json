			"dialogs": [
				{
					"id": 737060101,
					"content": "各位，好消息来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060102
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 737060102,
					"content": "我们为「稳健知行」机构打下的基础，已经得到了各学院权威学者们的高度认可…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060103
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 737060103,
					"content": "接下来，教令院派出的专门职工会正式入场，按照我们制定的标准和规则，继续将这个机构运转下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060104
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 737060104,
					"content": "这段时间实在有劳各位了，万分感谢各位的支持！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060105
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 737060105,
					"content": "好耶！努力工作的成果得到了认可，柯莱大成功！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060106
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 737060106,
					"content": "这次的交接工作也都让柯莱包圆了，真不错啊真不错…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060107
					],
					"speakerTitle": "珐露珊"
				},
				{
					"id": 737060107,
					"content": "希望新入学的年轻人们都能学学你的作风，踏踏实实，把每件小事都干得无可挑剔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060108
					],
					"speakerTitle": "珐露珊"
				},
				{
					"id": 737060108,
					"content": "而不能只想着论文里的宏大目标，离开了书面推论就两眼一黑，两手一摊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060109
					],
					"speakerTitle": "珐露珊"
				},
				{
					"id": 737060109,
					"content": "我，我还是非常紧张的！在各个学院的代表之间跑来跑去，沟通协调，也有点晕头转向…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060110
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 737060110,
					"content": "#当然，特别需要感谢{NICKNAME}和派蒙，{M#他们}{F#她们}帮我们完善了最关键的规则，提供了最宝贵的指导意见…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060111,
						737060112
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 737060111,
					"content": "还行还行！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737060113
					]
				},
				{
					"id": 737060113,
					"content": "我们对这些工作都已经习以为常了，就像是…和大家一起来了场特别的野营！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737060114,
					"content": "期间偶尔穿插一些解谜锻炼和健身活动，还挺有意思的！又有趣味又消食…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737060115,
					"content": "消食…欸…饿了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737060116,
					"content": "既然工作万事大吉了，要不要一起吃顿饭，就当是庆祝了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737060117,
					"content": "派蒙还真说到了点子上了——犒劳大家的大餐，我和坎蒂丝已经准备好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060118
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 737060118,
					"content": "几位，这边请。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060119
					],
					"speakerTitle": "坎蒂丝"
				},
				{
					"id": 737060119,
					"content": "是大餐！庆功宴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737060120,
					"content": "来得正好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060121
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 737060121,
					"content": "呜，好久没吃这么丰盛的须弥菜了，怎么感觉我…口味一换，肚量翻倍？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060122,
						737060123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737060122,
					"content": "那我们多来回走走。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737060124
					]
				},
				{
					"id": 737060124,
					"content": "哼哼，可别小瞧了我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737060125,
					"content": "当然，我也不会那么任性，还是要考虑你的钱包的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737060126,
					"content": "嗯…嗯！好久没仔细品尝过沙漠地带的料理了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060127
					],
					"speakerTitle": "珐露珊"
				},
				{
					"id": 737060127,
					"content": "记忆里的印象，居然被打破了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060128
					],
					"speakerTitle": "珐露珊"
				},
				{
					"id": 737060128,
					"content": "原来我以前在沙漠里尝到的那些菜式…都是应付了事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060129
					],
					"speakerTitle": "珐露珊"
				},
				{
					"id": 737060129,
					"content": "多谢您的认可，珐露珊女士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060130
					],
					"speakerTitle": "坎蒂丝"
				},
				{
					"id": 737060130,
					"content": "如果来访阿如村的学者们都像您这样彬彬有礼，我们每次都会拿出最丰盛的餐食，尽力招待他们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060131
					],
					"speakerTitle": "坎蒂丝"
				},
				{
					"id": 737060131,
					"content": "说起来，安柏小姐更是从遥远的蒙德来的…你有什么想参观的地方吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060132
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 737060132,
					"content": "嘿，我都想好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060133
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 737060133,
					"content": "听说在奥摩斯港西北，有一片长满参天大树的森林，每颗大树的树干，都比「猎鹿人」那栋房子的地基还宽…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060134
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 737060134,
					"content": "我很好奇！那里的景色看起来究竟怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060135
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 737060135,
					"content": "如果爬到树顶，从上边往下跳，再用风之翼滑翔，在巨树间穿梭，一定很有意思！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060136
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 737060136,
					"content": "那，我准备一些湿润的糕点、团子之类的零食。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060137
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 737060137,
					"content": "高处风大，不适合碎屑太多的食物。水袋也要选加厚款，防止一摔就坏…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060138
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 737060138,
					"content": "哦！软软糯糯的团子确实不错，柯莱很细心嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737060139,
					"content": "沙漠这边的话，我对巨大的遗迹非常感兴趣，比如那座超厉害的，沙漏型的巨大建筑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060140
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 737060140,
					"content": "当然，说不定须弥这边有保护遗迹的规则，我不会贸然闯进去，远远观察一番就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060141
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 737060141,
					"content": "如果打扰到沉睡在里面的主人，也有点不讲礼貌，哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060142
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 737060142,
					"content": "真是宝贵的守矩意识，安柏小姐，实在令我欣慰…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060143
					],
					"speakerTitle": "坎蒂丝"
				},
				{
					"id": 737060143,
					"content": "嗯，以安柏平时习惯的环境，在列柱沙原长期旅行的话，肯定会觉得干燥难耐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060144
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 737060144,
					"content": "所以必须准备一些保湿的药膏，还有滋润皮肤的植物精油…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060145,
						737060146
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 737060145,
					"content": "连面部护理都考虑到了吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737060147
					]
				},
				{
					"id": 737060147,
					"content": "相比早有预期的旅行计划，这次参与「稳健知行」机构的建设，更让我惊喜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060148
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 737060148,
					"content": "托柯莱的福，认识了各位新朋友，我特别开心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060149
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 737060149,
					"content": "等到你们有空，也请来蒙德玩玩哦，我保证带你们吃个痛快，玩个尽兴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060150
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 737060150,
					"content": "那我可太期待了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060151
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 737060151,
					"content": "去枫丹的时候，我就尝到了进口的蒲公英酒，那种芳香和清甜实在让人沉醉，完全感受不到一点苦涩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060152
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 737060152,
					"content": "不过，毕竟被封在容器里，漂洋过海，口感还是受了点影响。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060153
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 737060153,
					"content": "到了蒙德，就能喝到最正宗，最纯正的蒲公英酒了，我要畅饮好几桶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060154
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 737060154,
					"content": "偶尔也喝点酒以外的东西吧？比如，孩子们送你的赤念果荆棘粉冲泡的茶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060155
					],
					"speakerTitle": "坎蒂丝"
				},
				{
					"id": 737060155,
					"content": "啊哈…啊哈哈，坎蒂丝…酌情，酌情尝一点而已，桶也可以是…三五个杯子那么大的小木桶嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060156
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 737060156,
					"content": "如果真去蒙德玩了，我一定会给你带纪念品回来的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060157
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 737060157,
					"content": "我倒是听说，西风骑士团图书馆的藏书有上万卷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060158
					],
					"speakerTitle": "珐露珊"
				},
				{
					"id": 737060158,
					"content": "没准，有些机关相关的典籍，会从不同的角度分析工程问题，值得一看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060159
					],
					"speakerTitle": "珐露珊"
				},
				{
					"id": 737060159,
					"content": "具体的数字我也不清楚啦，不过图书馆确实很大很大！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060160
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 737060160,
					"content": "珐露珊女士对哪些书感兴趣？我现在就记一下，提前和丽莎小姐打个招呼，准备得妥妥当当。",
					"roleType": "TALK_ROLE_NPC",
