			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"兰般度"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730500101,
					"content": "#那菈{NICKNAME}还有派蒙！多亏你们帮忙，法留纳神机现在很好，善见地也很好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500102
					],
					"speakerTitle": "兰般度"
				},
				{
					"id": 730500102,
					"content": "兰那罗都回到桓那兰那，庆祝无忧节，像归巢的鸟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500103
					],
					"speakerTitle": "兰贡迪"
				},
				{
					"id": 730500103,
					"content": "生气的雨变回了温柔的雨，兰那库拉也可以安心照看苗圃，培育毗波耶，高兴的毗波耶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500104
					],
					"speakerTitle": "兰那库拉"
				},
				{
					"id": 730500104,
					"content": "高兴的毗波耶做高兴的灯，高兴的灯点缀高兴的无忧节…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500105
					],
					"speakerTitle": "兰伽卢"
				},
				{
					"id": 730500105,
					"content": "#那菈{NICKNAME}和派蒙，苗圃现在很好，无忧节也很开心，谢谢你们帮忙，治好法留纳神机，让兰那库拉回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500106
					],
					"speakerTitle": "兰伽卢"
				},
				{
					"id": 730500106,
					"content": "那就好！嘿嘿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730500107,
					"content": "这么说来，有个事情还挺在意的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730500108
					]
				},
				{
					"id": 730500108,
					"content": "那菈法留纳为什么叫那菈法留纳？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730500109
					]
				},
				{
					"id": 730500109,
					"content": "嗯嗯。因为那个那菈，是帮助我们治好法留纳神机的那菈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500110
					],
					"speakerTitle": "兰般度"
				},
				{
					"id": 730500110,
					"content": "#那{M#她}{F#他}的名字叫什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730500111
					]
				},
				{
					"id": 730500111,
					"content": "唔…不知道耶，那菈法留纳，一直都没说过名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500112,
						730500113
					],
					"speakerTitle": "兰般度"
				},
				{
					"id": 730500112,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730500114
					]
				},
				{
					"id": 730500114,
					"content": "#那菈{NICKNAME}也帮了好多好多忙，是勇敢的那菈，战胜很多困难。我们一起在无忧节，很高兴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500115
					],
					"speakerTitle": "兰百梨迦"
				},
				{
					"id": 730500115,
					"content": "#我们有东西想交给那菈{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500116
					],
					"speakerTitle": "兰贡迪"
				},
				{
					"id": 730500116,
					"content": "是表达兰那罗的感谢的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500117
					],
					"speakerTitle": "兰般度"
				},
				{
					"id": 730500117,
					"content": "#那菈{NICKNAME}一定会喜欢的，派蒙也是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500118
					],
					"speakerTitle": "兰那库拉"
				},
				{
					"id": 730500118,
					"content": "兰那罗的花，送给勇敢的那菈，还有派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500119
					],
					"speakerTitle": "兰百梨迦"
				},
				{
					"id": 730500119,
					"content": "#兰伽卢也有小花，不是毗波耶，但是送给那菈{NICKNAME}和派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500120
					],
					"speakerTitle": "兰伽卢"
				},
				{
					"id": 730500120,
					"content": "#谢谢那菈{NICKNAME}和派蒙为桓那做过的一切，兰那罗不会忘记朋友！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰般度"
				},
				{
					"id": 730500113,
					"content": "我明白了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730500114
					]
				}
			]
		},
		{
