			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"兰纳迦"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730500301,
					"content": "无忧节…怀念的感觉…唔？白蓬蓬飞飞…还有金色的那菈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500302
					],
					"speakerTitle": "兰纳迦"
				},
				{
					"id": 730500302,
					"content": "是那菈朋友，和那菈朋友的朋友，希望在无忧节过得开心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500303
					],
					"speakerTitle": "兰纳真"
				},
				{
					"id": 730500303,
					"content": "朋友的朋友也是朋友！金色的那菈，还有飞飞白毛都是兰迦鲁的朋友！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰迦鲁"
				}
			]
		}
	]
