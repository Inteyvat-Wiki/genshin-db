				"objectNames": [
					"兰利遮"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730500201,
					"content": "#那菈{NICKNAME}和派蒙！想让桓那「生病」的坏家伙没有再来了，现在放心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500202
					],
					"speakerTitle": "兰利遮"
				},
				{
					"id": 730500202,
					"content": "#谢谢那菈{NICKNAME}和派蒙帮忙，兰利遮才能保护桓那…所以，兰利遮给那菈{NICKNAME}还有派蒙花花！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500203
					],
					"speakerTitle": "兰利遮"
				},
				{
					"id": 730500203,
					"content": "收下花花吧，兰利遮的好朋友！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰利遮"
				}
			]
		},
		{
