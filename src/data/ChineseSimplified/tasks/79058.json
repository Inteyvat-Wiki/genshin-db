			"dialogs": [
				{
					"id": 790580101,
					"content": "此处为短剧《绝境高飞》片场的弃用场景",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580102
					],
					"speakerTitle": "片场备注"
				},
				{
					"id": 790580102,
					"content": "原本构想的故事是受困于神秘洞窟的水形幻灵，只能凭借藏匿在书中的挖掘道具逃出生天的故事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580103
					],
					"speakerTitle": "片场备注"
				},
				{
					"id": 790580103,
					"content": "但是遭到了伊迪娅小姐的否定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580104
					],
					"speakerTitle": "片场备注"
				},
				{
					"id": 790580104,
					"content": "确实啦，水形幻灵不依靠道具就能从洞窟里钻出来，非要把挖掘用具藏在书本的设计也有点莫名奇妙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580105
					],
					"speakerTitle": "片场备注"
				},
				{
					"id": 790580105,
					"content": "但、但这个绝对是个能够受欢迎的好点子。如果能将想法展示给伊迪娅小姐看就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580106
					],
					"speakerTitle": "片场备注"
				},
				{
					"id": 790580106,
					"content": "不过，呜，好像得先把<color=#00E1FFFF>被附近的丘丘人偷走的道具书</color>拿回来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580107
					],
					"speakerTitle": "片场备注"
				},
				{
					"id": 790580107,
					"content": "——「导演」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "片场备注"
				}
			]
		},
