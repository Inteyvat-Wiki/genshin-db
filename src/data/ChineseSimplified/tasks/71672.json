	"talks": [
		{
			"id": 7167201,
			"completionStepIds": [
				7167201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7167201",
							"2"
						],
						"stepId": 7167201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"报菲"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716720101,
					"content": "…嘿嘿，昨天又听了一段和「白马仙人」有关的书，这下又有新灵感了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716720102,
						716720103
					],
					"speakerTitle": "报菲"
				},
				{
					"id": 716720102,
					"content": "什么灵感？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716720104
					]
				},
				{
					"id": 716720104,
					"content": "欸…啊！你好你好你好，欢…欢迎来璃月港！海灯节欢迎你…不对不对，璃月港欢迎你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716720105
					],
					"speakerTitle": "报菲"
				},
				{
					"id": 716720105,
					"content": "萍溪姐没看见吧，好，应该没看见…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716720106
					],
					"speakerTitle": "报菲"
				},
				{
					"id": 716720106,
					"content": "欢迎来到璃月港！您一定是来参加海灯节的，对吧？那么，您一定不能错过我设计的小游艺「月映仙踪」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716720107
					],
					"speakerTitle": "报菲"
				},
				{
					"id": 716720107,
					"content": "你这是进入工作状态了啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716720108
					]
				},
				{
					"id": 716720108,
					"content": "别、别拆穿啊！要是被萍溪姐发现我走神，我肯定又要挨训了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716720109
					],
					"speakerTitle": "报菲"
				},
				{
					"id": 716720109,
					"content": "我可是磨了好久的嘴皮子才让她同意我过来摆摊的，你先听我说完…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716720110
					],
					"speakerTitle": "报菲"
				},
				{
					"id": 716720110,
					"content": "咳、咳咳，「月映仙踪」是取材自流传在我们璃月港的「白马仙人」传说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716720111
					],
					"speakerTitle": "报菲"
				},
				{
					"id": 716720111,
					"content": "据传说呢，这位仙人常常在天上循着月光游弋，为璃月港驱除邪魔妖祟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716720112
					],
					"speakerTitle": "报菲"
				},
				{
					"id": 716720112,
					"content": "…哎呀，但这种传说我都觉得太无聊了，所以…嘿嘿，特意在这个小游戏里加入了一些听来的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716720113
					],
					"speakerTitle": "报菲"
				},
				{
					"id": 716720113,
					"content": "比如…其实天上一直有怪物，想要吞吃掉整个月亮！多亏了白马仙人，那些怪物才没能得逞…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716720114
					],
					"speakerTitle": "报菲"
				},
				{
					"id": 716720114,
					"content": "虽然我不知道月亮被吞吃掉的时候具体是什么样…但刘苏说，就和我们啃烧饼一样，怪物吭哧吭哧地把月亮慢慢吞进肚子里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716720115
					],
					"speakerTitle": "报菲"
				},
				{
					"id": 716720115,
					"content": "但我过几天去听，刘苏他又换了一种说法，说什么怪物就和吃汤圆一样，啊呜一口，就把月亮整个吞下去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716720116
					],
					"speakerTitle": "报菲"
				},
				{
					"id": 716720116,
					"content": "不过，在故事的最后，白马仙人总是会借助着霄灯的光芒，把所有魔物都一口气驱散掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716720117
					],
					"speakerTitle": "报菲"
				},
				{
					"id": 716720117,
					"content": "这也是传说？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716720118
					],
					"speakerTitle": "报菲"
				},
				{
					"id": 716720118,
					"content": "反正刘苏说的那段书是这么说的，我觉得很帅气，就把这段故事也加入「月映仙踪」里啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716720119
					],
					"speakerTitle": "报菲"
				},
				{
					"id": 716720119,
					"content": "呃，不好不好，我不能闲聊了，还是要办正事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716720120
					],
					"speakerTitle": "报菲"
				},
				{
					"id": 716720120,
					"content": "你想要试玩「月映仙踪」的话，就和我说一声，所有东西都准备齐全了，随时可以开始。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "报菲"
				},
				{
					"id": 716720103,
					"content": "你是准备说书么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716720104
					]
				}
			]
		}
	]
}