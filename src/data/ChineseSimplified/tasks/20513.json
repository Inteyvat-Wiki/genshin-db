			"dialogs": [
				{
					"id": 205130101,
					"content": "这次的还挺正常…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130102
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205130102,
					"content": "你这不是挺好的吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205130103
					]
				},
				{
					"id": 205130103,
					"content": "是啊，哎呀，果然是我自己吓自己…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130104
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205130104,
					"content": "安娜的身子也逐渐有起色了，那位神医真是有本事啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130105
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205130105,
					"content": "你愿意的话，能接着帮我找药吗？这次是「被风史莱姆吹拂过的风车菊」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130106,
						205130111,
						205130115
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205130106,
					"content": "听着不像药。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205130107
					]
				},
				{
					"id": 205130107,
					"content": "嗯…风车菊倒是偶尔会被做成药，不过都是治疗一些轻症…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130108
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205130108,
					"content": "难道风史莱姆才是关键，但风车菊和风史莱姆可不会经常凑在一起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130109
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205130109,
					"content": "还好杰克说他见过几次这种情况，把大概位置也告诉了我。我把最近的一个地方标在你的地图上吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130110
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205130110,
					"content": "我可不会对付风史莱姆，它们会飞的…所以，只能拜托你了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205130111,
					"content": "还挺…适合蒙德城的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205130112
					]
				},
				{
					"id": 205130112,
					"content": "谁说不是呢。但风车菊和风史莱姆可不会经常凑在一起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130113
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205130113,
					"content": "还好杰克说他见过几次这种情况，把大概位置也告诉了我。我把最近的一个地方给你标上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130114
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205130114,
					"content": "我实在是不会对付风史莱姆，它们会飞的。所以，就拜托你了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205130115,
					"content": "我再给你抓个风史莱姆回来。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205130116
					]
				},
				{
					"id": 205130116,
					"content": "我说啊，你纯粹就是想看热闹吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130117
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205130117,
					"content": "不过，风车菊和风史莱姆确实不会经常凑在一起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130118
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205130118,
					"content": "还好杰克说他见过几次这种情况，把大概位置也告诉了我。我把最近的一个地方给你标上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130119
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205130119,
					"content": "如果实在找不到。那你就抓个风史莱姆回来吧！为了安娜，我什么都会做…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安东尼"
				}
