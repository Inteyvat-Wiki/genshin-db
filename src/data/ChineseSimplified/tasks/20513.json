					"nextDialogs": [
						205130303
					]
				},
				{
					"id": 205130303,
					"content": "咦？这株风车菊，总感觉和普通的风车菊不一样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130304
					],
