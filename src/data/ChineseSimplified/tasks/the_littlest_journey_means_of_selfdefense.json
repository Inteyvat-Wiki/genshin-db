				"points": []
			},
			"dialogs": [
				{
					"id": 210300201,
					"content": "旅行者，那边的情况怎么样了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300202
					],
					"speakerTitle": "老章"
				},
				{
					"id": 210300202,
					"content": "那边暂时安全了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210300203
					]
				},
				{
					"id": 210300203,
					"content": "#不愧是{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，真厉害！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300204
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210300204,
					"content": "爸爸说，旅行的时候，他们也会雇几个人来保护我们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300205
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210300205,
					"content": "#希望那些人的身手，能和{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}一样厉害…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300206
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210300206,
					"content": "铁匠叔叔，这样你是不是就可以继续去采矿，然后继续做那批铁器啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300207
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210300207,
					"content": "哈哈哈，那是当然，我准备一下就去采矿，等会回来就可以继续开工了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300208
					],
					"speakerTitle": "老章"
				},
				{
					"id": 210300208,
					"content": "但我一个人能带的矿石有限…希望那个地方，不要再出现魔物了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "老章"
				}
			]
		},
