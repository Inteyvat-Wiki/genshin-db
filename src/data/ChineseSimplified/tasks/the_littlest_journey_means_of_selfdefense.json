			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"小蒙",
					"老章"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210300101,
					"content": "欸？这个矿石，和这个矿石也不一样吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300102
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210300102,
					"content": "那当然了，用这两种矿石打造出的东西，品质和价钱可是完全不一样的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300103
					],
					"speakerTitle": "老章"
				},
				{
					"id": 210300103,
					"content": "喔…不过，这两种矿石怎么都只剩下这么一点了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300104
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210300104,
					"content": "唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300105
					],
					"speakerTitle": "老章"
				},
				{
					"id": 210300105,
					"content": "你们在做什么呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210300106
					]
				},
				{
					"id": 210300106,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，你好，我正在帮我爸爸检查他订的铁器呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300107
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210300107,
					"content": "铁匠叔叔可好了，他还答应我，要帮我做一把小剑呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300108
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210300108,
					"content": "不过，他说最近店里的原料不够用，爸爸订的那批铁器可能要延期…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300109
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210300109,
					"content": "我的那把小剑也不知道什么时候才能做出来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300110
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210300110,
					"content": "唉，这也是没办法的事，最近店里的客人很多，矿石都用得差不多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300111
					],
					"speakerTitle": "老章"
				},
				{
					"id": 210300111,
					"content": "那些矿物产量丰富的地方，也盘踞着许多魔物，我也不敢贸然过去采矿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300112
					],
					"speakerTitle": "老章"
				},
				{
					"id": 210300112,
					"content": "只能等我把这段时间先忙过去，再请一位冒险家陪着我出去采矿了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300113
					],
					"speakerTitle": "老章"
				},
				{
					"id": 210300113,
					"content": "可是，那得等到什么时候…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300114
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210300114,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，我听人家说，你是不是特别会对付那些魔物？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300115
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210300115,
					"content": "你能不能帮帮忙？拜托拜托，求求你了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300116,
						210300117
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210300116,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210300118
					]
				},
				{
					"id": 210300118,
					"content": "旅行者，你要去看看情况吗？那我先把我平时采矿的地点给你标上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300119
					],
					"speakerTitle": "老章"
				},
				{
					"id": 210300119,
					"content": "唔，好了，就是这些地方了。你去的时候可要小心点，那边有很多魔物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300120
					],
					"speakerTitle": "老章"
				},
				{
					"id": 210300120,
					"content": "#那就拜托你了，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210300117,
					"content": "好、好…我想想办法…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210300118
					]
				}
			]
		},
