	"talks": [
		{
			"id": 7365201,
			"completionStepIds": [
				7365201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7365201",
							"2"
						],
						"stepId": 7365201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"哈贾娜德",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736520101,
					"content": "终于回来了？我等你们好久了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520102
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 736520102,
					"content": "来，向我细说「重熔片剂」的效果吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520103
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 736520103,
					"content": "哈贾娜德真兴奋啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736520104
					]
				},
				{
					"id": 736520104,
					"content": "那我们要先说缺点哦，不怕打击你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736520105,
					"content": "向哈贾娜德详细说明了「重熔片剂」的缺点与优点。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						736520106
					]
				},
				{
					"id": 736520106,
					"content": "原来如此…我明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520107
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 736520107,
					"content": "现在的爆炸无法精确控制混合的药量，所以效果不太稳定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520108
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 736520108,
					"content": "还需要给小型炸药装上药罩，收束爆轰波，并且优化预置片剂的排列…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520109
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 736520109,
					"content": "嗯，完成改进需要的时间不长，问题在于资金…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520110
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 736520110,
					"content": "好在之前还留下了救急预算。接下来每天只吃一顿饭，再卖掉老旧的器材，应该是够用的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520111
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 736520111,
					"content": "每天只吃一顿饭？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736520112,
					"content": "不行不行，这种事怎么想都不能忍吧！你的资金明明不太够用，为什么不早说啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736520113,
					"content": "哦，你们放心，给你们的报酬当然是不会少的，这笔预算最早就规划好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520114
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 736520114,
					"content": "我以前也经常只吃一顿饭，有的时候每个星期只吃三顿，早就习惯了，没问题的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520115
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 736520115,
					"content": "不用这么拼吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736520116
					]
				},
				{
					"id": 736520116,
					"content": "我还是很在意，一定要问清楚——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736520117,
					"content": "哈贾娜德小姐，你这么想当知名的学者，是为了什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736520118,
					"content": "是真的很喜欢学术研究吗？是想证明自己的才能？还是用炼金术赚很多很多摩拉？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736520119,
					"content": "呃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520120
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 736520120,
					"content": "突然这么问我，我也说不清…可能只是因为以前受过欺负，不甘心吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520121
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 736520121,
					"content": "如果我能证明自己的能力，就可以生活得更有余裕了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520122
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 736520122,
					"content": "为了这种理由…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736520123,
					"content": "你就开始学术研究了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736520124
					]
				},
				{
					"id": 736520124,
					"content": "对啊，在这个知识就是一切的国家，当然要靠学术能力来往上爬了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520125
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 736520125,
					"content": "我没什么天赋，智商很平庸，只能选择很少有人研究的冷门学科，来全力做出点成果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520126
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 736520126,
					"content": "一个人埋头搞研究太长时间，也不知道该怎么和别人相处了，染上了怪脾气…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520127,
						736520128
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 736520127,
					"content": "世间还是好人居多的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736520129
					]
				},
				{
					"id": 736520129,
					"content": "对哦，现在的你也有更厉害的目标了，可以生活得更大气一点！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736520130,
					"content": "如果你抱着平常心，好好和别人说话，肯定还有很多人愿意帮你，和你一起搞研究的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736520131,
					"content": "谢谢啦，这些道理我还是明白的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520132
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 736520132,
					"content": "我已经发现了，研究炼金术挺有趣的，比考虑柴米油盐和人情世故要轻松多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520133
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 736520133,
					"content": "遇见你们以后，我也反省过自己，我确实应该好好收拾一下情绪了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520134
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 736520134,
					"content": "总之，多谢你们帮我试验「重熔片剂」，我该回城里去写论文了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520135
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 736520135,
					"content": "除了说好的报酬，这个也送给你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520136
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 736520136,
					"content": "这个是？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736520137
					]
				},
				{
					"id": 736520137,
					"content": "我最好的炼金釜，以前花了不少积蓄买下来，结果一直没舍得用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520138
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 736520138,
					"content": "喂！你怎么突然连自己最宝贵的工具都不要了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736520139,
					"content": "「重熔片剂」和传统药剂不一样，需要用我全新设计的器材来制作，所以我也用不到这个炼金釜了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520140
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 736520140,
					"content": "毕竟，给你们的报酬里，还有一个承诺呢，就把这个炼金釜当成见证物好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520141
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 736520141,
					"content": "你们也可以试试用它…煮茶或者熬汤？它有促进萃取的功能，煮出来的汤汁应该挺好喝的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520142
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 736520142,
					"content": "既然你都这么说了…我们也不好拒绝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520143
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736520143,
					"content": "加油啊，哈贾娜德。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736520144
					]
				},
				{
					"id": 736520144,
					"content": "当然！等着我的好消息吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520145
					],
					"speakerTitle": "哈贾娜德"
				},
				{
					"id": 736520145,
					"content": "哈贾娜德离开了。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						736520146
					]
				},
				{
					"id": 736520146,
					"content": "#{NICKNAME}，你说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520147
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736520147,
					"content": "这次我们算是做了一件好事吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520148,
						736520149
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736520148,
					"content": "只是冒险的日常罢了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736520150
					]
				},
				{
					"id": 736520150,
					"content": "说得也是呢，现在还不急着下定论。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520151
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736520151,
					"content": "没准等到我们都忘了这件事的那天，突然听到消息，哈贾娜德当上了学者，邀请我们去看望她…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520152
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736520152,
					"content": "不瞎想了，走吧走吧。我要试试用这个炼金釜煮茶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736520149,
					"content": "我们也要抱着平常心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736520150
					]
				},
				{
					"id": 736520128,
					"content": "不必拘泥于过去的事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736520129
					]
				}
			]
		}
	]
}