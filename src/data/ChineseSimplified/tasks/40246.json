					}
				]
			},
			"dialogs": [
				{
					"id": 402460501,
					"content": "看来是不在呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460502
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 402460502,
					"content": "要我现在开始举行仪式吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460503
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 402460503,
					"content": "先等等，我们把这层格式塔的水排空吧。这样更容易行动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460504
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 402460504,
					"content": "这水还能排走？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402460505,
					"content": "当然可以。在阿兰和雷内不约而同观测到枫丹命运之后，二人就曾分享过一些建筑防水的方法。原理是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460506
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 402460506,
					"content": "咳咳，跑题了。总之你们照我说的，按顺序解开几个机关就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「木偶」"
				}
			]
