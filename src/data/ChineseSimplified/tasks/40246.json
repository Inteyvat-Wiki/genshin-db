			"dialogs": [
				{
					"id": 402460901,
					"content": "这样就…结束了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460902
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402460902,
					"content": "结束了。说了这是很简单的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460903
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 402460903,
					"content": "你是怎么做到的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460904
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 402460904,
					"content": "那个怨意的集合体，不过是众多无家灵魂聚合在一起的产物。其中混杂着许多污秽与邪念。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460905
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 402460905,
					"content": "我不过是将它们最原本的灵魂与污秽分离，让它们得以被现在的世界规则容纳罢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460906
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 402460906,
					"content": "「世界式」的原理是「发散」。从一个原点出发，解构与重组世界的可能性，从中寻找答案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460907
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 402460907,
					"content": "而利用「数秘阵列」反向运算「世界式」，就能达到归拢收束与还原的功能。即术式的反转。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460908
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 402460908,
					"content": "这类似数理中的同调归约，在不改变群体本质的情况下，将他们还原为更简单和实质性的存在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460909
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 402460909,
					"content": "所以…呃，算了。看你们的样子也不是真的想搞明白这些…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460910
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 402460910,
					"content": "我好像理解外地人听烟谜主萨满讲东西是什么感觉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460911
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 402460911,
					"content": "总…总之我知道很了不起就对了！你果然很厉害呢！桑多涅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460912
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402460912,
					"content": "笑话，我一直很厉害！哈哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460913
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 402460913,
					"content": "不愧是析构万理的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460914
					]
				},
				{
					"id": 402460914,
					"content": "这个就算了！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460915
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 402460915,
					"content": "差…差不多该走了！我去把格式塔内部的机关还原一下。我们岸上见！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「木偶」"
				}
			]
		},
