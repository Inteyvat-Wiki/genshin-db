			"dialogs": [
				{
					"id": 402461201,
					"content": "茜特菈莉，我们来啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402461202,
					"content": "哟。挺准时嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461203
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 402461203,
					"content": "你才是…昨天喝那么多没关系吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402461204,
					"content": "呵？你是小瞧奶奶我了？就那点可醉不倒我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461205
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 402461205,
					"content": "可你后来都开始说胡话了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402461206,
					"content": "有…有吗？我怎么不记得？我没说什么…了不得的事吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461207
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 402461207,
					"content": "骂孙子骂了半小时、抱怨烟谜主工作抱怨了半小时、分享轻小说分享了一小时…还有…呃，好像后面我也睡着了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402461208,
					"content": "…她们走了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461209
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 402461209,
					"content": "她们？哦，是说剧组吧。已经走了，我们刚好在甲板碰上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402461210,
					"content": "不过，既然你都解决了自己的问题，为什么还不去见哥伦比娅呢？她明明很想见你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402461211,
					"content": "我…我想先处理完手上这烂摊子再去见她。再说了，这么好一个吓她一跳的机会，我肯定得多计划计划呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461212
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 402461212,
					"content": "不说这个了。那个污秽聚合体的位置找到了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461213
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 402461213,
					"content": "当然，黑曜石奶奶我说办得到就办得到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461214
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 402461214,
					"content": "辛苦了。我看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461215
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 402461215,
					"content": "莫尔泰区…嗯？这不是格式塔吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461216
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 402461216,
					"content": "果然还是对自己灵魂被切割时的地方怨意最深吗？还是说，这是对「水仙十字」的怨意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461217
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 402461217,
					"content": "我陪你们一起去吧，这东西的出现地点其实不算很固定，如果它不在那儿的话，我也有办法用某种仪式把它招过来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461218
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 402461218,
					"content": "真的吗？但这件事已经给你添了很多麻烦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461219
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 402461219,
					"content": "别客气，这老骨头闲着也是闲着，帮小年轻招个魂什么的还累不到我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461220
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 402461220,
					"content": "（我不去的话谁知道你们又会聊出什么我参与不了的话题？！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461221
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 402461221,
					"content": "好吧，那就辛苦你了。谢谢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461222
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 402461222,
					"content": "嘿嘿，那么事不宜迟，我们这就出发吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
