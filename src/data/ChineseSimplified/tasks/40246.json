			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「少女」"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							3537.532,
							452.648,
							4178.716
						],
						"pointId": 16568
					},
					{
						"sceneId": 3,
						"position": [
							3538.825,
							452.648,
							4179.689
						],
						"pointId": 16573
					}
				]
			},
			"dialogs": [
				{
					"id": 402460201,
					"content": "昨天茜特菈莉喝得还挺多，也不知道她现在醒没醒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402460202,
					"content": "早上好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460203
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 402460203,
					"content": "呃啊！哥伦比娅！你…你怎么在这里？不对，你怎么老是喜欢从人背后出现啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402460204,
					"content": "今早和大家一起来这边补个镜头，刚刚拍完。我就先到甲板上来透透气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460205
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 402460205,
					"content": "其他人好像还在下面讨论有关「最后一幕」的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460206
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 402460206,
					"content": "最后一幕？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402460207,
					"content": "嗯，就是这部映影的结尾。大家在烦恼故事中的女主角最终有没有找到自己曾经的朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460208
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 402460208,
					"content": "啊…这两天做别的事情都快忙忘了，这部艺术片的确是以主角发现友人不见了，所以回到她故乡为背景的呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402460209,
					"content": "嗯，芙宁娜导演和千织小姐认为，从故事韵味上来说，最终二人没有相见的悲剧式结尾会更加令人惋惜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460210
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 402460210,
					"content": "泽维尔导演则认为，相见的结局更加令人感动，治愈人心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460211
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 402460211,
					"content": "哥伦比娅怎么想？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460212
					]
				},
				{
					"id": 402460212,
					"content": "我吗？我…我不知道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460213
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 402460213,
					"content": "如果是「我」的话，我当然想和她见面…多希望她真的还能和我见面…哪怕是在映影中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460214
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 402460214,
					"content": "但想到这样意味着要让另一个人来演绎她，我心中又有些…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460215
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 402460215,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402460216,
					"content": "先别担心这些。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460217
					]
				},
				{
					"id": 402460217,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460218
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 402460218,
					"content": "对啊对啊，别因为这个就愁眉苦脸的。映影就应该享受地去拍才对！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402460219,
					"content": "而且…我，我敢向哥伦比娅保证！事情一定会顺利的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402460220,
					"content": "顺利？指的是…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460221
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 402460221,
					"content": "呃，就…就是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402460222,
					"content": "一定会是个好结局。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460223
					]
				},
				{
					"id": 402460223,
					"content": "嗯！就是这个意思！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402460224,
					"content": "哈…好吧。我相信你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460225
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 402460225,
					"content": "那就像你们说的，先享受拍戏的过程吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460226
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 402460226,
					"content": "#哟？这不是{NICKNAME}和派蒙吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460227
					],
					"speakerTitle": "芙宁娜"
				},
				{
					"id": 402460227,
					"content": "哟？这不是翘班的灯光师和场记吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460228
					],
					"speakerTitle": "千织"
				},
				{
					"id": 402460228,
					"content": "呃…抱歉…这次拍摄我们请假是有些频繁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460229
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402460229,
					"content": "呵呵，开个玩笑。别往心里去。我们这次拍摄挺顺利的，你们先安心忙自己的事就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460230,
						402460231
					],
					"speakerTitle": "千织"
				},
				{
					"id": 402460230,
					"content": "感谢各位理解…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460232
					]
				},
				{
					"id": 402460232,
					"content": "咦？哥伦比娅小姐似乎心情好了不少。啊，抱歉，是我们刚才讨论结局的话题让你为难了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460233
					],
					"speakerTitle": "芙宁娜"
				},
				{
					"id": 402460233,
					"content": "#没关系，我现在没事了。{NICKNAME}和派蒙已经帮我想通了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460234
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 402460234,
					"content": "哦？那是想拍个相见的结局还是不相见的结局？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460235
					],
					"speakerTitle": "芙宁娜"
				},
				{
					"id": 402460235,
					"content": "拍个好结局。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460236
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 402460236,
					"content": "…啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芙宁娜"
				},
				{
					"id": 402460231,
					"content": "之后一定补偿…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460232
					]
				}
			]
		},
