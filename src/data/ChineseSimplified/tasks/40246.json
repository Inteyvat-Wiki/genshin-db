			"dialogs": [
				{
					"id": 402460701,
					"content": "准备好了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460702
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 402460702,
					"content": "嗯。我会先尝试着和他们沟通两句。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460703
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 402460703,
					"content": "但这些灵魂的聚合体恐怕已经失去了理智，如果无法沟通，事态很可能演变为一场战斗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460704
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 402460704,
					"content": "好，假如变成了最坏的情况，我会找个地方好好躲着的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460705
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402460705,
					"content": "嗯，真打起来的话，最后一击让我来，你们不要出手。相信我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460706
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 402460706,
					"content": "明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460707
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 402460707,
					"content": "好了，你们安静点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460708
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 402460708,
					"content": "…随潮汐飘摇的游魂，我呼唤你们。被分离、被遗弃、被迫沉默的碎魂啊，循着旧日的气息归来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460709
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 402460709,
					"content": "…让失名的怨恨彼此识别，让禁秽的恶质相互吸引，在此，重新聚合成形！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460710
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 402460710,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460711
					]
				},
				{
					"id": 402460711,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460712
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402460712,
					"content": "（…然后呢？这就结束了？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460713
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 402460713,
					"content": "（啊…所以我才对付不来这些魔法秘术什么的…根本不知道算法进展到了哪一步，术式逻辑也看不通透。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460714
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 402460714,
					"content": "（和我熟知的机械科学完全…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460715
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 402460715,
					"content": "……！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460716
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 402460716,
					"content": "当心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460717
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 402460717,
					"content": "——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460718
					],
					"speakerTitle": "「游魂的怨意」"
				},
				{
					"id": 402460718,
					"content": "那边的人，或者说里面的人，能听懂我说话吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460719
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 402460719,
					"content": "我是枫丹「奇械公」，阿兰·吉约丹的后人。我有办法帮你们恢复原样，回归地脉。只需要你们稍微配合…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460720
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 402460720,
					"content": "——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460721
					],
					"speakerTitle": "「游魂的怨意」"
				},
				{
					"id": 402460721,
					"content": "桑多涅！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460722
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402460722,
					"content": "嘁…这架势，看来是怎么都劝不动了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460723
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 402460723,
					"content": "好吧。那就陪你们发泄发泄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「木偶」"
				}
			]
		},
