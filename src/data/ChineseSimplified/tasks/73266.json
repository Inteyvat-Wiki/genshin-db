			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凯瑟琳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732660201,
					"content": "凯瑟琳小姐，我们回来了！$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732660202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732660202,
					"content": "欢迎回来，我已经收到教令院的反馈了，没想到你们真的成功解决掉那个奇异天象了呢。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732660203
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 732660203,
					"content": "可以说是超出预期了。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732660204
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 732660204,
					"content": "欸？我记得凯瑟琳小姐不是说，我们是最合适的人选吗？$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732660205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732660205,
					"content": "该不会你对每个人都会说同样的话吧。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732660206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732660206,
					"content": "怎么会，我当然相信你们可以完成这个委托了。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732660207
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 732660207,
					"content": "对了，之前还有拜托你们先联系到「那迦朱那团」。不知道他们是不是帮上什么忙了呢？$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732660208,
						732660209
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 732660208,
					"content": "有点复杂…$UNRELEASED",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732660210
					]
				},
				{
					"id": 732660210,
					"content": "看来发生了很多故事呢。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732660211
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 732660211,
					"content": "不过不管发生什么样的事情，都是冒险的一部分。对于冒险家来说，都是难得的宝物呢。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732660212
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 732660212,
					"content": "既然顺利完成了委托，协会应该也可以获得坎瑞亚遗迹的调查许可了，如果有相关委托的话，我也会优先考虑你们的。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732660213
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 732660213,
					"content": "不过说起来，虽然做了这么多事情，我们都还不知道委托人是谁呢！$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732660214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732660214,
					"content": "这个嘛…冒险家协会有义务为委托人保密，没办法直接向你们透露。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732660215
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 732660215,
					"content": "不过将信物交给我们的那位先生，倒是自称是什么轻小说作家。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732660216
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 732660216,
					"content": "轻小说作家？听起来有点耳熟，我记得之前也提到过矫论团有一位前辈…$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732660217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732660217,
					"content": "看来你们是知道些什么呢，不过这些事情就与协会无关了。那么教令院的报酬已经放在我这里了，就请你们收下吧。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 732660209,
					"content": "算是帮上忙了吧…$UNRELEASED",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732660210
					]
				}
			]
		}
	]
}