			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"祖尔宛",
					"斯露莎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732660101,
					"content": "没想到你们真的完成了「祭水之仪」，真是让我惊讶。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732660102
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732660102,
					"content": "你明明就是一副一点也不惊讶的样子吧！$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732660103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732660103,
					"content": "欸嘿，别那么严肃嘛，这也是我相信你们的表现啊。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732660104
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732660104,
					"content": "完成了「祭水之仪」，「焚真之天象」也熄灭了。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732660105
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732660105,
					"content": "清除了困扰这里的污秽，这下我也终于可以放心了。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732660106
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732660106,
					"content": "接下来该做什么呢，干脆大睡一觉吧，这下可要一次性睡上个几百年呢。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732660107
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732660107,
					"content": "你们花灵怎么一个个都这么懒哪。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732660108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732660108,
					"content": "你们可别带上我。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732660109
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732660109,
					"content": "反正你们又不会留在这里陪我，你们这些人都一样啦，永远也不打算停下脚步。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732660110,
						732660111
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732660110,
					"content": "我们还会回来的。$UNRELEASED",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732660112
					]
				},
				{
					"id": 732660112,
					"content": "哎呀，我是不会再相信这种话了，毕竟已经不是第一次听了哪。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732660113
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732660113,
					"content": "说起这个，也不知道我那位好友现在怎么样了，你们要是见到他可要帮我问好。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732660114
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732660114,
					"content": "毕竟你们都是旅人嘛，总是会有机会见面的。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732660115
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732660115,
					"content": "哦对了，还有一件事。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732660116
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732660116,
					"content": "你们要是再遇到剩下的矫论团的人，就把「祭水之仪」的事情告诉他们吧。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732660117
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732660117,
					"content": "我可不想再处理一次这种事了。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732660118
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732660118,
					"content": "知道啦，知道啦。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732660119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732660119,
					"content": "好啦，你们该回到属于你们的地方去了，可别太想我哦。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732660111,
					"content": "还会有机会见面的。$UNRELEASED",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732660112
					]
				}
			]
		},
		{
			"id": 7326602,
			"completionStepIds": [
				7326602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7326602",
							"2"
