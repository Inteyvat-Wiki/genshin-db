			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿贝多"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110420101,
					"content": "说起来，我有一个疑问，那个种子发芽以后会长出什么东西吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110420102,
					"content": "不知道，但我觉得重点不在结果，而是过程。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420103
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110420103,
					"content": "能够使用炼金术，在提瓦特唤醒不属于此世的生命的话，我对生命本质的理解，应该就能更进一步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420104
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110420104,
					"content": "唤醒之后，就算是创造，也并非不可能的事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420105
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110420105,
					"content": "唔唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110420106,
					"content": "哈哈，对你来说还是太难懂了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420107
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110420107,
					"content": "不不不，我完全听懂了，我只是更关心这个种子发芽之后会长出什么！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420108,
						110420109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110420108,
					"content": "完全没懂嘛。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420110
					]
				},
				{
					"id": 110420110,
					"content": "如果长出了非常美味的果实，我们就一起分享吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420111
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110420111,
					"content": "好耶！说话要算话哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420112,
						110420113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110420112,
					"content": "居然轻松说服了派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420114
					]
				},
				{
					"id": 110420114,
					"content": "这是因为我…有时要帮忙照顾某个孩子。这要解释起来比较复杂，就当是我在炼金术之外的小技能吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420115
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110420115,
					"content": "说回第一项研究，是关于元素力的。这个世界的人想要使用元素力，就必须拥有神之眼，但我没看到你身上有类似的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420116
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110420116,
					"content": "为什么你可以自如地使用元素力，我想确认一下，所以想先问你几个问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420117
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110420117,
					"content": "首先，你有别人没有的器官吗？比如，第二个心脏，第四个胃之类的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420118,
						110420119
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110420118,
					"content": "没有。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420120
					]
				},
				{
					"id": 110420120,
					"content": "原来如此，那么，飞在你身边的小家伙，和你的身体是连接起来的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420121
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110420121,
					"content": "这个问题好奇怪！从外表来看就能排除这种可能性吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110420122,
					"content": "还有，不是「小家伙」，是派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110420123,
					"content": "我只是在考虑你作为「外置器官」的可能性，或许连接你们的是一种不可见的方式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420124,
						110420125
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110420124,
					"content": "我们是在旅行中认识的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420126
					]
				},
				{
					"id": 110420126,
					"content": "哦，那就可以排除这种可能性了。那么，会不会是派蒙将元素力导向了你？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420127
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110420127,
					"content": "但前提是派蒙的元素力可以击穿十米厚的山岩，又或者是让清泉镇南边的瀑布逆流而上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420128
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110420128,
					"content": "唔，果然不可能啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420129
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110420129,
					"content": "我还什么都没说呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110420130,
					"content": "这么说来，看来你的身体构造和这个世界的人类，并没有明显的区别。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420131
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110420131,
					"content": "那只能用实验的方法，研究可能存在的差异点了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420132
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110420132,
					"content": "首先，先看看这不明来源的元素力，究竟是如何对外流动的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420133
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110420133,
					"content": "接下来我会吸引一些史莱姆过来，请用你最熟悉的方式击败它们吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420134
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110420134,
					"content": "原来是用这么简单的方式来观察吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110420135,
					"content": "好的实验应该是直观而清晰的，而且这只是简单的小研究。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420136
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110420136,
					"content": "当然，如果你们觉得缺乏挑战性的话，我们也可以去尝试同时挑战六个纯水精灵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420137
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110420137,
					"content": "史莱姆！史莱姆就可以了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420138,
						110420139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110420138,
					"content": "不太明白，但好像很麻烦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420140
					]
				},
				{
					"id": 110420140,
					"content": "那么，准备一下吧，史莱姆要来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110420139,
					"content": "我不想被幻形兽撞来撞去。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420140
					]
				},
				{
					"id": 110420125,
					"content": "她是我从水里钓上来的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420126
					]
				},
				{
					"id": 110420119,
					"content": "据我所知是没有的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420120
					]
				},
				{
					"id": 110420113,
					"content": "居然看穿了派蒙的想法。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420114
					]
				},
				{
					"id": 110420109,
					"content": "我也想知道。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420110
					]
				}
			]
		},
		{
			"id": 1104203,
