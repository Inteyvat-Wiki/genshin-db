			"dialogs": [
				{
					"id": 110420501,
					"content": "这里就是我的营地，刚刚收集到的材料，我已经先一步用在药剂的调制上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420502
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110420502,
					"content": "在等待调制完成的这段时间，先来这边看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420503
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110420503,
					"content": "这位是我的助手，蒂玛乌斯，正在协助我的研究。你们应该在蒙德城里见过面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420504
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110420504,
					"content": "你们好，我刚刚拿到了你们的实验数据，已经整理成报告贴在板子上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420505
					],
					"speakerTitle": "蒂玛乌斯"
