					"nextDialogs": [
						110420711
					]
				},
				{
					"id": 110420711,
					"content": "那当然了，你是我的协助者，于情于理我也不能让你帮我承担风险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420714
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110420714,
					"content": "总之，我说说看结论吧。在元素力的测试上，你和这个世界上的其他人一样，没有什么特别之处。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420715
					],
					"speakerTitle": "阿贝多"
				},
				{
