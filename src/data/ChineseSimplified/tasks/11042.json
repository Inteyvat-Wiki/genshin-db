			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿贝多"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110420301,
					"content": "辛苦了，你应该没有感觉到什么异常吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420302
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110420302,
					"content": "如果受伤了的话，我这里有些应急用的药剂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420303,
						110420304
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110420303,
					"content": "不用担心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420305
					]
				},
				{
					"id": 110420305,
					"content": "那就好，根据我的观察，元素力对外流动顺畅，元素反应合理，没有观察到特别的状况。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420306
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110420306,
					"content": "确定「对外流动」没问题之后，我们再来测试一下「内部流动」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420307
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110420307,
					"content": "「内部流动」…要怎么做？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110420308,
					"content": "很简单，我可以用炼金术制作一种萃取了元素力的药剂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420309
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110420309,
					"content": "如果元素力是以生理的方式储存或堆积在你的体内，或许会和这种药剂产生元素反应。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420310,
						110420311
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110420310,
					"content": "会在肚子里扩散？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420312
					]
				},
				{
					"id": 110420312,
					"content": "听、听起来好可怕！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110420313,
					"content": "没事的，如果一切正常的话，只会引发短暂的不适，但对身体没有害处。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420314
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110420314,
					"content": "要是不正常呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110420315,
					"content": "万一有意外发生，我也有充足的准备，不用太担心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420316
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110420316,
					"content": "还是很担心…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420317
					]
				},
				{
					"id": 110420317,
					"content": "嗯，并非完全没有风险。但如果你体内的元素流动确实存在障碍的话，也能借此检查出来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420318
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110420318,
					"content": "这也是一种对健康的预警，如果内部的元素反应由其他意外引起，那才会引发真正的危险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420319
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110420319,
					"content": "像体检一样…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420320
					]
				},
				{
					"id": 110420320,
					"content": "对，我觉得可以这么理解。不过在实验之前，检测用的药剂还差了一种触媒，我们需要找一找。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420321
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110420321,
					"content": "是一种名叫「星银矿」的矿石，不过不是所有这种矿石都适合做触媒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420322
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110420322,
					"content": "我现在带你去我的营地，沿路收集一些「星银矿」吧。如果有适合做触媒的，我会告诉你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420323
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110420323,
					"content": "如果顺利的话，等我们抵达营地，就可以直接进行药物的调制了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420324
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110420324,
					"content": "听起来虽然不太安全，但似乎是有好处的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420325
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110420325,
					"content": "我们在路上的时候留意一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110420311,
					"content": "会在肚子里结晶？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420312
					]
				},
				{
					"id": 110420304,
					"content": "只是有点冷。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420305
					]
				}
			]
		},
