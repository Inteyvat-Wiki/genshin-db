	"talks": [
		{
			"id": 7352901,
			"completionStepIds": [
				7352901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7352901",
							"2"
						],
						"stepId": 7352901,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"勒非尼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735290101,
					"content": "我感受到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290102
					],
					"speakerTitle": "勒非尼"
				},
				{
					"id": 735290102,
					"content": "你们举手投足间满溢而出的，「战斗舞步」的气息，缤纷璨绮，令人迷醉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290103
					],
					"speakerTitle": "勒非尼"
				},
				{
					"id": 735290103,
					"content": "燃烧的剑锋划过侧脸时，你们瞳中的倒影连成了一线炽烈的金红…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290104
					],
					"speakerTitle": "勒非尼"
				},
				{
					"id": 735290104,
					"content": "环绕严冰壁垒的轴线优雅旋转时，你们的足尖踏出了错落有致的节奏…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290105
					],
					"speakerTitle": "勒非尼"
				},
				{
					"id": 735290105,
					"content": "面对轰然倾轧而来的古木城墙，抑或是钢铁巨人的军阵时，你们捕捉每个瞬息的敏捷身影，甚至无法被画笔和镜头捕捉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290106,
						735290107
					],
					"speakerTitle": "勒非尼"
				},
				{
					"id": 735290106,
					"content": "听不太懂！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735290108
					]
				},
				{
					"id": 735290108,
					"content": "这股豪气也是我所敬畏之物，不会错，你们一定能成为我的知音！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290109
					],
					"speakerTitle": "勒非尼"
				},
				{
					"id": 735290109,
					"content": "本人「轻剑舞者」勒非尼，且问两位尊姓大名。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290110
					],
					"speakerTitle": "勒非尼"
				},
				{
					"id": 735290110,
					"content": "呜啊，好夸张的说话风格…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735290111,
					"content": "#我是派蒙，这是{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735290112,
					"content": "虽然我们的确很厉害，但勒非尼先生，你说的话好复杂，完全不明白是什么意思啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735290113,
					"content": "而且你既没有带着剑，看穿着打扮也不像是舞者，为什么自称「轻剑舞者」呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735290114,
					"content": "犀利的提问，派蒙阁下想必在考验我的心性！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290115
					],
					"speakerTitle": "勒非尼"
				},
				{
					"id": 735290115,
					"content": "不以有限的武器为兵刃，而是藏剑于心，在必要之时，将锐意融入一切可用之物，让具体的战法摆脱桎梏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290116
					],
					"speakerTitle": "勒非尼"
				},
				{
					"id": 735290116,
					"content": "绝不强调衣着，而是从踏上战场舞台的一刻起，释放华美的身姿，以至为优雅的技法主宰一切…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290117,
						735290118,
						735290119
					],
					"speakerTitle": "勒非尼"
				},
				{
					"id": 735290117,
					"content": "大概是说…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735290120
					]
				},
				{
					"id": 735290120,
					"content": "精准的概括！但也请别疏忽「锐意」和「优雅」两个定调的关键词…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290121
					],
					"speakerTitle": "勒非尼"
				},
				{
					"id": 735290121,
					"content": "等等…我明白了！你们的境界早已远远超过了我，能在无意无心之中贯彻这两个词。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290122
					],
					"speakerTitle": "勒非尼"
				},
				{
					"id": 735290122,
					"content": "那事不宜迟，请踏入这扇门，踏上「幽思闪念旋步舞」的高台，向我展示至高的舞姿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290123
					],
					"speakerTitle": "勒非尼"
				},
				{
					"id": 735290123,
					"content": "托伊迪娅小姐的福，「幽思闪念旋步舞」之中，各式劲敌都将以幻影的姿态重现，试图将你彻底击垮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290124
					],
					"speakerTitle": "勒非尼"
				},
				{
					"id": 735290124,
					"content": "当你完全释放心中「锐意」的那一刻，你就能彻底拔出心底至强的那柄剑，锐不可当地击败强敌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290125,
						735290126
					],
					"speakerTitle": "勒非尼"
				},
				{
					"id": 735290125,
					"content": "我好像也明白了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735290127
					]
				},
				{
					"id": 735290127,
					"content": "没错，的确是无比合拍的交涉，痛快！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290128
					],
					"speakerTitle": "勒非尼"
				},
				{
					"id": 735290128,
					"content": "那我就在此冥想，静候佳音了！愿你能享受这独一无二的剑斗之舞！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290129
					],
					"speakerTitle": "勒非尼"
				},
				{
					"id": 735290129,
					"content": "呃啊，怎么感觉你好像和他慢慢达成了一种…共识！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735290130,
					"content": "我刚刚才反应过来，勒非尼先生是在夸奖我们打架的本领高强吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735290131,
					"content": "他管理着一个战斗试炼的秘境，想要再见识一下我们的打法？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735290132,
					"content": "不过，好像也不是坏事…勒非尼先生的思维有点奇特，会把战斗比作跳舞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735290133,
					"content": "把很简单的事说得特别高深，也是一种本领吧。学会了这种说话方式…不管碰见什么人，都能第一时间唬住对方！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290134,
						735290135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735290134,
					"content": "其实我很会唬人啦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735290136
					]
				},
				{
					"id": 735290136,
					"content": "噫！夸人是顺带的说话技巧啦，和他多聊聊，肯定都能搞懂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290137
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735290137,
					"content": "那我们就在这个什么「幽思闪念旋步舞」里，再漂漂亮亮、痛痛快快地打一场吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290138
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735290138,
					"content": "#不知道勒非尼先生又会给我们什么样的夸张评价…{NICKNAME}，到时候你要记住哦，以后也能派上用场！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735290135,
					"content": "反正他很会夸我们。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735290136
					]
				},
				{
					"id": 735290126,
					"content": "是酣畅的战斗试炼吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735290127
					]
				},
				{
					"id": 735290118,
					"content": "别管衣服？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735290120
					]
				},
				{
					"id": 735290119,
					"content": "什么都用？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735290120
					]
				},
				{
					"id": 735290107,
					"content": "但多夸夸！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735290108
					]
				}
			]
		}
	]
}