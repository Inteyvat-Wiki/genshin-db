	"type": "WQ",
	"name": "锐意与优雅的战舞？",
	"description": "在「隐众游园」的关键区，某位言行奇诡的「轻剑舞者」像是从你们的身上感应到了某种重要的事物…",
	"unlockDescription": "",
	"chapter": "",
	"showType": "QUEST_SHOW",
	"activityId": 2023,
	"mainQuestTag": "MAINQUEST_TAG_GUIDE",
