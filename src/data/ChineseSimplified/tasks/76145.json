						"stepId": 7614509,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"库济米奇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761450901,
					"content": "真是太感谢了，多亏了你，我可以不用那么灰头土脸地回去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450902
					],
					"speakerTitle": "库济米奇"
				},
				{
					"id": 761450902,
					"content": "这次真的要告别了。你买了我这么多东西，我们怎么说也算是朋友了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450903
					],
					"speakerTitle": "库济米奇"
				},
				{
					"id": 761450903,
					"content": "你若是有机会来至冬的话，就到新基捷城来找我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "库济米奇"
				}
			]
		}
	]
