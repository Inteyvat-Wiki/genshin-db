				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"库济米奇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761450601,
					"content": "太好了，终于把货都卖完了，果然薄利多销的策略是正确的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450602
					],
					"speakerTitle": "库济米奇"
				},
				{
					"id": 761450602,
					"content": "按理来说我也该启程回至冬了，只是现在顶多也就赚回了路费…我光脚出来，可不想再光脚回去啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450603
					],
					"speakerTitle": "库济米奇"
				},
				{
					"id": 761450603,
					"content": "哎，总之多谢你照顾生意了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "库济米奇"
				}
			]
		},
		{
			"id": 7614507,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7614507",
							"2"
						],
						"stepId": 7614507,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"库济米奇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761450701,
					"content": "哎哟，缘分真是奇妙，居然在这又碰上了。怎么样，要看看吗？这次有不少好东西哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450709,
						761450702,
						761450706,
						761450711
					],
					"speakerTitle": "库济米奇"
				},
				{
					"id": 761450709,
					"content": "看看有什么好东西。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450710
					]
				},
				{
					"id": 761450710,
					"content": "嘿，都是愚人众淘汰下来的老旧装备，在别处可买不到，有想要的就一起拿走吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "库济米奇"
				},
				{
					"id": 761450702,
					"content": "你不是回至冬了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450703
					]
				},
				{
					"id": 761450703,
					"content": "不瞒您说，我的家在新基捷城，全家都是采矿工人。他们啊，一个个比矮灵还顽固，我说要出门经商，他们坚决不同意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450704
					],
					"speakerTitle": "库济米奇"
				},
				{
					"id": 761450704,
					"content": "于是出门前我夸下海口，要赚一大笔钱回去…结果没想到，到头来会差点连路费都凑不上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450705
					],
					"speakerTitle": "库济米奇"
				},
				{
					"id": 761450705,
					"content": "现在赚大钱是没戏了，至少最后让我能赚点小钱吧，起码回去也有个交待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "库济米奇"
				},
				{
					"id": 761450706,
					"content": "你怎么在愚人众的地盘？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450707
					]
				},
				{
					"id": 761450707,
					"content": "瞧您说的，我可是遵纪守法的至冬公民，看到愚人众就跟回家了一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450708
					],
					"speakerTitle": "库济米奇"
				},
				{
					"id": 761450708,
					"content": "现在我这里的货都是愚人众淘汰下来的老旧装备，是他们特别托我处理的。你在别处可买不到，独此一家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "库济米奇"
				},
				{
					"id": 761450711,
					"content": "不用了，我先走了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450712
					]
				},
				{
					"id": 761450712,
					"content": "那可真是遗憾…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "库济米奇"
				}
			]
		},
		{
			"id": 7614509,
			"completionStepIds": [
				7614509
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
