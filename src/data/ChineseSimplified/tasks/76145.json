			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"库济米奇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761450301,
					"content": "哎呀呀，没想到真的卖完了，看来我还是有一些商业眼光的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450302
					],
					"speakerTitle": "库济米奇"
				},
				{
					"id": 761450302,
					"content": "接下来我会拜托执灯人送我穿过噩影泽地，之后再往北应该就是通途了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450303
					],
					"speakerTitle": "库济米奇"
				},
				{
					"id": 761450303,
					"content": "说不定回去的路上还能碰到什么商机呢…那么就此别过吧，我们有缘再见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "库济米奇"
				}
			]
		},
		{
			"id": 7614504,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7614504",
							"2"
						],
						"stepId": 7614504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"库济米奇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761450401,
					"content": "这么巧，我们又见面了。您要买点什么吗？新货滞销，帮帮我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450407,
						761450402,
						761450409
					],
					"speakerTitle": "库济米奇"
				},
				{
					"id": 761450407,
					"content": "让我看看有什么好货。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450408
					]
				},
				{
					"id": 761450408,
					"content": "都是些本地的特产，放心，一定给您最优惠的价格。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "库济米奇"
				},
				{
					"id": 761450402,
					"content": "你怎么又进货了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450403
					]
				},
				{
					"id": 761450403,
					"content": "哎，怎么说呢。商业嘛，正所谓该出手时就出手…我在皮拉米达城碰到了个好机会，一批急着出手的货物，给了我优惠价。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450404
					],
					"speakerTitle": "库济米奇"
				},
				{
					"id": 761450404,
					"content": "我当时一激动，就忘了我这次是要回家了，全给买了下来。结果就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450405
					],
					"speakerTitle": "库济米奇"
				},
				{
					"id": 761450405,
					"content": "你猜他为什么急着出手。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450406
					]
				},
				{
					"id": 761450406,
					"content": "哎，您就别挖苦我了，要不您看看有什么用得上的东西？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "库济米奇"
				},
				{
					"id": 761450409,
					"content": "抱歉，我先走了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450410
					]
				},
				{
					"id": 761450410,
					"content": "不再看看吗，一定有您需要的东西！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "库济米奇"
				}
			]
		},
		{
			"id": 7614506,
			"completionStepIds": [
				7614506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
