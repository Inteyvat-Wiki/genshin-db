			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"库济米奇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761450101,
					"content": "行情还真是差啊…要不我还是再凑笔钱，想办法去那夏镇租个摊位吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450113,
						761450102,
						761450115
					],
					"speakerTitle": "库济米奇"
				},
				{
					"id": 761450113,
					"content": "有什么好货吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450114
					]
				},
				{
					"id": 761450114,
					"content": "都是些从纳塔淘来的小玩意，有什么感兴趣的您尽管挑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "库济米奇"
				},
				{
					"id": 761450102,
					"content": "你是？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450103
					]
				},
				{
					"id": 761450103,
					"content": "哎呀，有顾客来了！您好，我叫库济米奇，是来自至冬的旅行商人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450104
					],
					"speakerTitle": "库济米奇"
				},
				{
					"id": 761450104,
					"content": "话是这么说，其实只是在旅行的路上顺便做些小本生意，赚点路费罢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450105
					],
					"speakerTitle": "库济米奇"
				},
				{
					"id": 761450105,
					"content": "结果路过纳塔的时候，那里的人实在太热情了，我一时脑热就…现在我要是不把这些货卖光，连回去的车票钱都要没有啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450106,
						761450110
					],
					"speakerTitle": "库济米奇"
				},
				{
					"id": 761450106,
					"content": "你要回至冬吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450107
					]
				},
				{
					"id": 761450107,
					"content": "是的，等卖掉这批货，我就要买票坐列车回去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450108
					],
					"speakerTitle": "库济米奇"
				},
				{
					"id": 761450108,
					"content": "虽说那里一年到头都在下雪，到处冰天雪地的，每天就只能窝在城里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450109
					],
					"speakerTitle": "库济米奇"
				},
				{
					"id": 761450109,
					"content": "但在外面的时间长了，也有点怀念能在家里睡上一整天的日子了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "库济米奇"
				},
				{
					"id": 761450110,
					"content": "这里看着就没什么生意。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450111
					]
				},
				{
					"id": 761450111,
					"content": "但如果想在镇上租个摊位，我就只能去北国银行借钱了，听说那夏镇的那家风评也不是很好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450112
					],
					"speakerTitle": "库济米奇"
				},
				{
					"id": 761450112,
					"content": "算啦，至少这里的人流比较多。货嘛，只要来的人多总能卖出去的，您说是不是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "库济米奇"
				},
				{
					"id": 761450115,
					"content": "不好意思，我先走了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450116
					]
				},
				{
					"id": 761450116,
					"content": "哎，你怎么就走了，不看看吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "库济米奇"
				}
			]
		},
		{
			"id": 7614503,
			"completionStepIds": [
				7614503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
