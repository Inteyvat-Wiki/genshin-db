					"木户",
					"木奈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722050501,
					"content": "在这里又见面了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050502
					],
					"speakerTitle": "木户"
				},
				{
					"id": 722050502,
					"content": "又见面啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050503,
						722050504
					],
					"speakerTitle": "木奈"
				},
				{
					"id": 722050503,
					"content": "你好！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050505
					]
				},
				{
					"id": 722050505,
					"content": "#嘿嘿，我还在这里呢！说起来，大{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}知道这些大石头是做什么的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050506
					],
					"speakerTitle": "木户"
				},
				{
					"id": 722050506,
					"content": "哼哼，木户哥哥什么都知道哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050507,
						722050508
					],
					"speakerTitle": "木奈"
				},
				{
					"id": 722050507,
					"content": "不知道呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050509
					]
				},
				{
					"id": 722050509,
					"content": "听又爷爷讲，这是用来招引亡灵的墓碑呢…那些死后迷失的、伫留的灵总会被这些大石头吸引，在这里从梦中醒来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050510
					],
					"speakerTitle": "木户"
				},
				{
					"id": 722050510,
					"content": "然后在岛上各处徘徊…寻找能够满足他们心愿的人。一旦找到，他就会缠上那人…直到自己的愿望被满足，被那撑船的人接走为止…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050511
					],
					"speakerTitle": "木户"
				},
				{
					"id": 722050511,
					"content": "他们有的是好的灵，有的是坏的…所以呀，在雾中走夜路的人，一定要在这种大石头前，大声报出自己的氏名！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050512
					],
					"speakerTitle": "木户"
				},
				{
					"id": 722050512,
					"content": "牢记祖先的人，总是比孤魂野鬼更有底气。而那些死去的灵得知了生人的血脉，便会自惭形秽地离去，不再要求什么啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050513
					],
					"speakerTitle": "木户"
				},
				{
					"id": 722050513,
					"content": "#只可惜大{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}是外人呢…没有响当当的氏名可报…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050514
					],
					"speakerTitle": "木户"
				},
				{
					"id": 722050514,
					"content": "#唔…要是坏的灵来了，大{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}要怎么办呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050515
					],
					"speakerTitle": "木奈"
				},
				{
					"id": 722050515,
					"content": "嘿嘿，没关系的。不用怕啦，我可以保护你呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050516
					],
					"speakerTitle": "木户"
				},
				{
					"id": 722050516,
					"content": "木奈也要一起，吓走坏蛋灵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "木奈"
				},
				{
					"id": 722050508,
					"content": "是做什么的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050509
					]
				},
				{
					"id": 722050504,
					"content": "你还在岛上呀。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050505
					]
				}
			]
		},
