			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"木户",
					"木奈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722050301,
					"content": "#你好，大{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050302,
						722050303
					],
					"speakerTitle": "木户"
				},
				{
					"id": 722050302,
					"content": "你好呀。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050304
					]
				},
				{
					"id": 722050304,
					"content": "谢谢你上次帮我采来那些花朵！只不过呀…我感觉身边一直怪怪的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050305
					],
					"speakerTitle": "木户"
				},
				{
					"id": 722050305,
					"content": "我也是呢，一直都怪怪的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050306
					],
					"speakerTitle": "木奈"
				},
				{
					"id": 722050306,
					"content": "每次去到不同的地方，都只会遇到不开心的人…大家都听不到别人说话的样子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050307
					],
					"speakerTitle": "木户"
				},
				{
					"id": 722050307,
					"content": "而且呀，每次看到漂亮的花朵，摘下放进口袋里之后，就很快不见了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050308,
						722050309
					],
					"speakerTitle": "木奈"
				},
				{
					"id": 722050308,
					"content": "那是因为…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050310
					]
				},
				{
					"id": 722050310,
					"content": "这样吗…我不太明白呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050311
					],
					"speakerTitle": "木户"
				},
				{
					"id": 722050311,
					"content": "要离开了吗…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050312
					],
					"speakerTitle": "木奈"
				},
				{
					"id": 722050312,
					"content": "那个金色的叔叔也说了类似的话…但是我们还不能跟他走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050313
					],
					"speakerTitle": "木户"
				},
				{
					"id": 722050313,
					"content": "我们还要给宇奈婆婆带去好看的花呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "木奈"
				},
				{
					"id": 722050309,
					"content": "是时候离开了吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050310
					]
				},
				{
					"id": 722050303,
					"content": "精神不错嘛。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050304
					]
				}
			]
		},
		{
			"id": 7220505,
			"completionStepIds": [
				7220513
			],
