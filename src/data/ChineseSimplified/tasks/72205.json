	"talks": [
		{
			"id": 7220501,
			"completionStepIds": [
				7220501
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7220501",
							"2"
						],
						"stepId": 7220501,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"木户",
					"木奈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722050101,
					"content": "唔，奇怪呀…明明就在口袋里的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050102,
						722050103
					],
					"speakerTitle": "木户"
				},
				{
					"id": 722050102,
					"content": "你好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050104
					]
				},
				{
					"id": 722050104,
					"content": "没有的话可不行呀…是要带给宇奈婆婆的哟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050105
					],
					"speakerTitle": "木奈"
				},
				{
					"id": 722050105,
					"content": "宇奈婆婆岁数大了，好多事情都记不清了…最近又开始念叨起了年轻时的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050106
					],
					"speakerTitle": "木户"
				},
				{
					"id": 722050106,
					"content": "她呀，总是在说着「花」呀「花」的…还说，那是雾海外的花，颜色不同的好看的花…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050107
					],
					"speakerTitle": "木奈"
				},
				{
					"id": 722050107,
					"content": "然后有一天，我做了一个梦…我梦见岛上的雾「哇」地一下全都消散了，海的另一边立起了高高大大好漂亮的屋子…不是木头的，也不是金子的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050108
					],
					"speakerTitle": "木户"
				},
				{
					"id": 722050108,
					"content": "我也是呢，我也是呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050109
					],
					"speakerTitle": "木奈"
				},
				{
					"id": 722050109,
					"content": "在那个梦里面呀，我登上高高的山，爬上大大的树，摘了好多好多好看的花…虽然没有见过，但我知道那就是宇奈婆婆想要的花…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050110
					],
					"speakerTitle": "木户"
				},
				{
					"id": 722050110,
					"content": "可是花太多太重，我就从树上掉了下来，一直掉呀，一直掉呀…然后，梦就醒了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050111
					],
					"speakerTitle": "木户"
				},
				{
					"id": 722050111,
					"content": "哼，还不是因为你太贪心！我都说了好多遍足够啦、足够啦！结果连累我也一同掉了下去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050112
					],
					"speakerTitle": "木奈"
				},
				{
					"id": 722050112,
					"content": "口袋里空空的…什么都没有了…就这样怎么回去见宇奈婆婆呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "木户"
				},
				{
					"id": 722050103,
					"content": "需要帮忙吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050104
					]
				}
			]
		},
		{
			"id": 7220503,
			"completionStepIds": [
				7220512
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
