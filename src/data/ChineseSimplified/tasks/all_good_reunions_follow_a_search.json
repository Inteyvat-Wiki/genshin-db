			"dialogs": [
				{
					"id": 752470301,
					"content": "呼啊…结束了结束了，还真是挺辛苦的呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752470302,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470303
					],
					"speakerTitle": "「咔阿夏」"
				},
				{
					"id": 752470303,
					"content": "是咔阿夏对吧？你和咔库库真的很厉害哦，这是来自对手的肯定！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752470304,
					"content": "厉害啊，哥们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470305
					],
					"speakerTitle": "咔库库"
				},
				{
					"id": 752470305,
					"content": "你看，我没说错吧，它俩联起手来真的很难对付。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470306
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 752470306,
					"content": "咔库库，现在给你颁发「隐身术」毕业证书，以后你就是一位成熟的欺诈师了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470307
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 752470307,
