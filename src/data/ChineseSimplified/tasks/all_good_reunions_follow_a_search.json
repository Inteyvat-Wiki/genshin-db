			"dialogs": [
				{
					"id": 752475001,
					"content": "怎么样，玩得开心吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475002
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752475002,
					"content": "哦天哪，哥们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475003
					],
					"speakerTitle": "咔库库"
				},
				{
					"id": 752475003,
					"content": "看来是开心的。生日快乐，哥们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475004
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 752475004,
					"content": "说到这个，你为什么不提前告诉我这个计划呢？不拿我当哥们吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475005
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 752475005,
					"content": "呵呵…实不相瞒，是想看看你是否还记得这个日子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475006
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752475006,
					"content": "…伊法，你变了，变得很阴险，我以后需要警惕你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475007
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 752475007,
					"content": "还好我记得，给咔库库留了新鲜的蜜，不然接下来要被它啄一整年的头。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475008
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 752475008,
					"content": "不会的哥们，还是你最好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "咔库库"
				}
			]
		},
		{
			"id": 7524751,
