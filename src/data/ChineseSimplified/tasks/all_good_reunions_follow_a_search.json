			"dialogs": [
				{
					"id": 752470101,
					"content": "看来画片上的地方就是这里了，他俩都在呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752470102,
					"content": "你们好——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752470103,
					"content": "听声调是「高兴」的派蒙，太好了，不用警惕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470104
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 752470104,
					"content": "「生气」的派蒙也不用警惕。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470105
					]
				},
				{
					"id": 752470105,
					"content": "可恶！瞧不起谁呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752470106,
					"content": "喂她点好吃的就行了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470107
					]
				},
				{
					"id": 752470107,
					"content": "哼，这还差不多嘛…不对，怎么说得我跟咔库库似的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752470108,
					"content": "算了，派蒙今天是「高兴」的派蒙，不跟你们计较啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752470109,
					"content": "说到这个，咔库库呢？不会被豚兽大王吃掉了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752470110,
					"content": "怎么可能。哥们，听听你说的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470111
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752470111,
					"content": "咔库库正在和敌方联手欺负我们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470112
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 752470112,
					"content": "哈哈哈，说是咔库库在「欺负」他们呢，欧洛伦又在说笑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752470113,
					"content": "我不是在开玩笑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470114
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 752470114,
					"content": "欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752470115,
					"content": "那么敌方是…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470116
					]
				},
				{
					"id": 752470116,
					"content": "它说它叫「咔阿夏」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470117
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 752470117,
					"content": "谁？真的吗？阿夏会说话？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752470118,
					"content": "停停，你们别听他胡编，还是我来说吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470119
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752470119,
					"content": "咔库库呢…呃，正在和这里遇到的阿夏一起玩捉迷藏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470120
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752470120,
					"content": "准确来说，是和「咔阿夏」结盟一起对付我俩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470121
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 752470121,
					"content": "咔库库行动很快，「咔阿夏」又很会伪装，是棘手的敌人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470122
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 752470122,
					"content": "你俩出现前，我们都陪这两个小东西玩过好多好多轮了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470123
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752470123,
					"content": "咔库库的确很厉害，但我的心情已经从一开始的骄傲，变得不那么精神了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470124
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752470124,
					"content": "只能怪你自己不去上伊安珊的健身课。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470125
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 752470125,
					"content": "哎呦，一直得上上下下地寻找，我腰很痛欸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470126
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752470126,
					"content": "对啊，这就是要怪你自己不去上伊安珊的健身课。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470127
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 752470127,
					"content": "…好好，结束这里的工作我就去，好吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470128
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752470128,
					"content": "停停，你俩谁也别说谁了！说到底，现在是谁在负责抓咔库库和「咔阿夏」呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752470129,
					"content": "哦！这就要说到我们眼前这个完美的台阶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470130
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 752470130,
					"content": "又我是吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470131
					]
				},
				{
					"id": 752470131,
					"content": "嗯嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470132
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 752470132,
					"content": "行，我行我上。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470133
					]
				},
				{
					"id": 752470133,
					"content": "#{M#爷爷}{F#奶奶}一定能行！派蒙奶奶也行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470134
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 752470134,
					"content": "不用勉强哦，要帮忙的话叫我们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470135
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752470135,
					"content": "欸，我以为我俩要做阿夏的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470136
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 752470136,
					"content": "做阿夏…意思是你们也要躲起来等我们去找吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470137
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752470137,
					"content": "嗯！从现在开始我是欧阿夏，他是伊阿夏。走咯，加油！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470138
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 752470138,
					"content": "欸你这…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470139
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752470139,
					"content": "抱歉啦，就配合他们一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470140,
						752470141
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752470140,
					"content": "小事，还挺好玩的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470142
					]
				},
				{
					"id": 752470142,
					"content": "那就拜托二位了，不胜感激。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊法"
				},
				{
					"id": 752470141,
					"content": "别担心，我精力充沛。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470142
					]
				}
			]
		},
