			"dialogs": [
				{
					"id": 752475101,
					"content": "又见面了，哥们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475102
					],
					"speakerTitle": "咔库库"
				},
				{
					"id": 752475102,
					"content": "其实我刚刚是想说，我第一次认识伊法可不是在那天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475103
					],
					"speakerTitle": "咔库库"
				},
				{
					"id": 752475103,
					"content": "不过最后还是忍住了。毕竟我很成熟，说话会看场合的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "咔库库"
				}
			]
		}
	]
