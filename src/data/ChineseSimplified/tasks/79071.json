				]
			},
			"dialogs": [
				{
					"id": 790710101,
					"content": "#欢迎来到星轨王城，{NICKNAME}，派蒙小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710102
					],
					"speakerTitle": "埃洛夫"
				},
				{
					"id": 790710102,
					"content": "我已经从同僚那边听说过了你们的名字和事迹，二位的确是勇武之人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710103
					],
					"speakerTitle": "埃洛夫"
				},
				{
					"id": 790710103,
					"content": "如果我不是必须要负责守卫的训练事宜，也想着与二位切磋一番。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710104
					],
					"speakerTitle": "埃洛夫"
				},
				{
					"id": 790710104,
					"content": "你是王城的守卫？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790710105
					]
				},
				{
					"id": 790710105,
					"content": "正是。我等奉城主大人之命，守卫星轨王城，维护其安宁和平。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710106
					],
					"speakerTitle": "埃洛夫"
				},
				{
					"id": 790710106,
					"content": "而我的职责，则是锻炼守卫，使其武力配得上自己的职责。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710107
					],
					"speakerTitle": "埃洛夫"
				},
				{
					"id": 790710107,
					"content": "所以，这后面的门就是训练场？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790710108
					]
				},
				{
					"id": 790710108,
					"content": "果然敏锐。这个入口通往一处秘境，前段时间我们方才改造完成。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710109
					],
					"speakerTitle": "埃洛夫"
				},
				{
					"id": 790710109,
					"content": "在这个训练场中，受训者必须按照特定的节奏挥剑。战斗时，场地的照明环境也会不断变化。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710110
					],
					"speakerTitle": "埃洛夫"
				},
				{
					"id": 790710110,
					"content": "好严格的训练…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790710111
					]
				},
				{
					"id": 790710111,
					"content": "听起来好复杂…战斗时还要按照特定的节奏吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790710112,
					"content": "这一环节，其实是来源于一篇名为《猫头鹰乐师》的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710113
					],
					"speakerTitle": "埃洛夫"
				},
				{
					"id": 790710113,
					"content": "前段时间，这篇故事在守卫之中颇为流行。不少人看得开心，就连训练也忘了参加，甚至还有人耽误了日常巡逻的时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710114
					],
					"speakerTitle": "埃洛夫"
				},
				{
					"id": 790710114,
					"content": "既然大家都如此喜爱这本书，那我觉得，将这故事的元素加入训练之中，大家一定能更喜爱训练吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710115
					],
					"speakerTitle": "埃洛夫"
				},
				{
					"id": 790710115,
					"content": "从结果上来说，训练效果的确显著。至少…没有人再因为个人原因耽误巡逻了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710116
					],
					"speakerTitle": "埃洛夫"
				},
				{
					"id": 790710116,
					"content": "呵呵…不知道二位对我们的训练有没有兴趣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710117
					],
					"speakerTitle": "埃洛夫"
				},
				{
					"id": 790710117,
					"content": "我想，以二位的勇武之能，训练场中的各类考验一定都不在话下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710118,
						790710120
					],
					"speakerTitle": "埃洛夫"
				},
				{
					"id": 790710118,
					"content": "想要试试看！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790710119
					]
				},
				{
					"id": 790710119,
					"content": "好，勇气可嘉，请您踏入秘境吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "埃洛夫"
				},
				{
					"id": 790710120,
					"content": "还有别的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790710121
					]
				},
				{
					"id": 790710121,
					"content": "无妨。二位可以有空再来。我这段时间会一直守在这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "埃洛夫"
				}
			]
		}
	]
}