			"trigger": {
				"objectNames": [
					"龟井宗久"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220300101,
					"content": "阁下，又见面了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300102
					],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220300102,
					"content": "恕在下唐突，今天有一事想请阁下帮助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300103,
						220300104
					],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220300103,
					"content": "什么事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300106
					]
				},
				{
					"id": 220300106,
					"content": "在受旭东阁下雇佣后，我一直与他们同行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300107
					],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220300107,
					"content": "为了报答旭东阁下收留我之恩，我想做些谢礼赠予他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300108
					],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220300108,
					"content": "但旭东阁下比起武艺，更喜欢美食，所以我想要亲手制作些食品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300109
					],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220300109,
					"content": "在下本来已经看好了两处食材的所在地，打算等这些食材成熟后再去取用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300110
					],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220300110,
					"content": "可是，却有两股魔物分别占据了那两处食材所在地，而且还都已经把食材取下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300111
					],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220300111,
					"content": "我所要制作的那道菜，最重要的就是食材新鲜，我本来打算先取一处，再去另外一处…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300112
					],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220300112,
					"content": "但现在两边魔物都已经取下了食材，想要烹制那道菜，在下必须快些把那两道食材都拿到手才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300113
					],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220300113,
					"content": "但在下…分身乏术，就算能对付一处的魔物，另一处的食材想必也早已被魔物糟蹋殆尽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300114
					],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220300114,
					"content": "所以，我想请阁下与我共同出手，一起击倒那些魔物，取得食材。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300115,
						220300117
					],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220300115,
					"content": "交给我了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300116
					]
				},
				{
					"id": 220300116,
					"content": "多谢阁下，在下感激不尽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300119
					],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220300119,
					"content": "唔…在这里说也无用，阁下，请与我一同去前面一些的地方看看，然后我们再做商议吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220300117,
					"content": "做完了食物之后能分我点吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300118
					]
				},
				{
					"id": 220300118,
					"content": "那是自然，阁下当取第一份。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300119
					],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220300104,
					"content": "不用这么客气…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300105
					]
				},
				{
					"id": 220300105,
					"content": "是在下有求于阁下，这种礼节也是应当。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300106
					],
					"speakerTitle": "龟井宗久"
				}
			]
		},
		{
