			"dialogs": [
				{
					"id": 220300201,
					"content": "就是这里了。两处魔物分别在左右两边扎了营。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300202
					],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220300202,
					"content": "在下悄悄去侦察了一番，左边营地的魔物虽然弱小，但数量众多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300203
					],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220300203,
					"content": "右边营地的魔物虽然数量略少，但却格外强壮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300204
					],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220300204,
					"content": "有劳阁下清剿一处魔物，另一处交给在下即可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "龟井宗久"
				}
			]
		},
