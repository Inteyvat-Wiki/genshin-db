	"talks": [
		{
			"id": 7268301,
			"completionStepIds": [
				7268302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7268302",
							"2"
						],
						"stepId": 7268302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"朝雾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726830101,
					"content": "咳、咳…这样…还是不行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830102
					],
					"speakerTitle": "朝雾"
				},
				{
					"id": 726830102,
					"content": "再拖下去，这一期的稿件就交不上去了…呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830103,
						726830104
					],
					"speakerTitle": "朝雾"
				},
				{
					"id": 726830103,
					"content": "你好…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830105
					]
				},
				{
					"id": 726830105,
					"content": "欸？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830106
					],
					"speakerTitle": "朝雾"
				},
				{
					"id": 726830106,
					"content": "对不起！对不起！我今天一定会交稿的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830107
					],
					"speakerTitle": "朝雾"
				},
				{
					"id": 726830107,
					"content": "呜哇！等一下，我们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726830108,
					"content": "森子小姐！请您…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830109
					],
					"speakerTitle": "朝雾"
				},
				{
					"id": 726830109,
					"content": "咦？原来不是森子小姐…太好…咳咳！咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830110
					],
					"speakerTitle": "朝雾"
				},
				{
					"id": 726830110,
					"content": "森子小姐是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830111
					]
				},
				{
					"id": 726830111,
					"content": "森子小姐是我的责任编辑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830112
					],
					"speakerTitle": "朝雾"
				},
				{
					"id": 726830112,
					"content": "我叫朝雾，是一个…嗯…算是一名「自由插画师」吧。森子小姐…是负责我的责任编辑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830113
					],
					"speakerTitle": "朝雾"
				},
				{
					"id": 726830113,
					"content": "插画？那是什么呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726830114,
					"content": "你们应该也读过「八重堂」里的那些轻小说吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830115
					],
					"speakerTitle": "朝雾"
				},
				{
					"id": 726830115,
					"content": "在那些小说里，不是偶尔会有几页不是文字而是画吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830116
					],
					"speakerTitle": "朝雾"
				},
				{
					"id": 726830116,
					"content": "这种插入轻小说页面内的画，就是「插画」喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830117
					],
					"speakerTitle": "朝雾"
				},
				{
					"id": 726830117,
					"content": "如果小说里出现了某些重要的场景或者剧情，或者是作者想要让主角的形象正式出现的时候，有的作者就会选择约上一幅插画。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830118
					],
					"speakerTitle": "朝雾"
				},
				{
					"id": 726830118,
					"content": "这样，不仅会让读者读起小说来更有感觉，整本轻小说的内容也会更加丰富呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830119
					],
					"speakerTitle": "朝雾"
				},
				{
					"id": 726830119,
					"content": "喔…原来是这样，轻小说还真是复杂啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726830120,
					"content": "我可以为你们推荐几本！比如那本…咳！咳咳…咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830121
					],
					"speakerTitle": "朝雾"
				},
				{
					"id": 726830121,
					"content": "你没事吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830122
					]
				},
				{
					"id": 726830122,
					"content": "没事，没事，我的身体一直不太好，画插画的时候又总是熬夜，有时候也会忘记吃饭…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830123
					],
					"speakerTitle": "朝雾"
				},
				{
					"id": 726830123,
					"content": "咳咳…然后身体就越来越差了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830124
					],
					"speakerTitle": "朝雾"
				},
				{
					"id": 726830124,
					"content": "你身体这么差，为什么还要在这里画画呀？不能回家画吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726830125,
					"content": "我是为了取材，才到这里来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830126
					],
					"speakerTitle": "朝雾"
				},
				{
					"id": 726830126,
					"content": "我最近完全没有画画的灵感，已经有好几幅插画稿件过了截稿期了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830127
					],
					"speakerTitle": "朝雾"
				},
				{
					"id": 726830127,
					"content": "森子小姐已经帮我把截稿日推迟了好多次了，我要是再交不了，森子小姐肯定会生气的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830128
					],
					"speakerTitle": "朝雾"
				},
				{
					"id": 726830128,
					"content": "我觉得如果能出去走走的话，说不定能得到什么灵感，所以就想要出门旅行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830129
					],
					"speakerTitle": "朝雾"
				},
				{
					"id": 726830129,
					"content": "结果…哈哈…如你们所见，没逛多久我就有点受不了了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830130
					],
					"speakerTitle": "朝雾"
				},
				{
					"id": 726830130,
					"content": "唉，我还是去冒险家协会挂一个委托，拜托哪位手里有「留影机」的冒险家帮忙吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830131
					],
					"speakerTitle": "朝雾"
				},
				{
					"id": 726830131,
					"content": "欸？说到「留影机」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830132,
						726830134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726830132,
					"content": "我手里倒是有「留影机」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830133
					]
				},
				{
					"id": 726830133,
					"content": "欸？！你有留影机吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830135
					],
					"speakerTitle": "朝雾"
				},
				{
					"id": 726830135,
					"content": "我、我是拜托冒险家用「留影机」拍摄各种画片！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830136
					],
					"speakerTitle": "朝雾"
				},
				{
					"id": 726830136,
					"content": "我听说，外面有很多有趣的地方！比如蒙德附近那座很高的雪山啦，璃月的那片有很多柱子的地方啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830137
					],
					"speakerTitle": "朝雾"
				},
				{
					"id": 726830137,
					"content": "还有还有！璃月有一片叫做「绝云间」的地方，据说那里住着仙人呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830138
					],
					"speakerTitle": "朝雾"
				},
				{
					"id": 726830138,
					"content": "仙人的居所…光是想想就觉得激动…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830139
					],
					"speakerTitle": "朝雾"
				},
				{
					"id": 726830139,
					"content": "我因为身体原因，实在不能亲身过去旅行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830140
					],
					"speakerTitle": "朝雾"
				},
				{
					"id": 726830140,
					"content": "但是，如果你能帮我用「留影机」记录下那边的景致…我一定也能…咳咳！咳咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830141
					],
					"speakerTitle": "朝雾"
				},
				{
					"id": 726830141,
					"content": "呜哇！你冷静点！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830142,
						726830143
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726830142,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830144
					]
				},
				{
					"id": 726830144,
					"content": "是吗！？太好了！我、我有很多想要看的地方，稍等一下，我找出来给你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830145
					],
					"speakerTitle": "朝雾"
				},
				{
					"id": 726830145,
					"content": "对了，报酬的话不用担心，我还是有一些积蓄的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830146
					],
					"speakerTitle": "朝雾"
				},
				{
					"id": 726830146,
					"content": "我的笔记本呢？笔记本，笔记本…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "朝雾"
				},
				{
					"id": 726830143,
					"content": "我会想办法的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830144
					]
				},
				{
					"id": 726830134,
					"content": "可是，「留影机」能做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830135
					]
				},
				{
					"id": 726830104,
					"content": "请问…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830105
					]
				}
			]
		}
	]
}