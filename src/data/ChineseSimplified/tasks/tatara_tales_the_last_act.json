						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"202201",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"虎之助"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721221501,
					"content": "「御影炉心」已经恢复正常了吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221502
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721221502,
					"content": "你已经知道了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721221503
					]
				},
				{
					"id": 721221503,
					"content": "你们在「御影炉心」所做的事，已经有人向我报告过了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221504,
						721221506
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721221504,
					"content": "为什么不直接来帮忙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721221505
					]
				},
				{
					"id": 721221505,
					"content": "没有接到范兵卫大人的命令，我无权采取任何行动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221508
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721221508,
					"content": "好了好了，有这么一位对流程如此重视的严谨上司，这位士兵先生也有他自己的苦衷，咱们就别为难他了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221509
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721221509,
					"content": "再说，我俩的行动之所以能如此顺利，说不定也有一部分是拜这位范兵卫先生所赐呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221510
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721221510,
					"content": "而且士兵先生也不是完全没有给我们帮助，比如那几门…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221511
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721221511,
					"content": "泽维尔先生，非常感谢你的协助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221512
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721221512,
					"content": "咳…主要还是得感谢这位旅行者，没有这位旅行者帮忙，我一个人可什么都做不到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221513
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721221513,
					"content": "是这样吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221514
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721221514,
					"content": "非常感谢你，旅行者。我为我之前的态度…向你道歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221515
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721221515,
					"content": "谢谢你保护了这座岛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221516,
						721221517
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721221516,
					"content": "不用客气。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721221518
					]
				},
				{
					"id": 721221518,
					"content": "呃，金发的…旅行者？等一会，我好像记得…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221519,
						721221520
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721221519,
					"content": "不、不用客气！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721221521
					]
				},
				{
					"id": 721221521,
					"content": "喔…哦…无论如何，还是谢谢你帮忙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221522
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721221522,
					"content": "哈哈哈，旅行者，您看看您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221523
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721221523,
					"content": "您也别谦虚了，要是没您帮忙，我应该就只能在外面干看着啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221524
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721221524,
					"content": "不过，我倒是还有个问题，士兵先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221525
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721221525,
					"content": "您之前和我说，您那位严谨的上司为了递交那些繁复的文书，不得不前往城内工作，想必肯定十分劳苦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221526
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721221526,
					"content": "但现在「御影炉心」已经恢复了正常，不知道这位好先生现在…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221527
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721221527,
					"content": "唔，范兵卫大人所忙碌之事，先前就有位名叫御舆源次郎的大人详细询问过我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221528
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721221528,
					"content": "听了我的详细报告之后，御舆源次郎大人似乎对这件事也很感兴趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221529
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721221529,
					"content": "之后，据御舆源次郎大人说，上面的大人们也对范兵卫大人的工作能力十分赞赏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221530
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721221530,
					"content": "为了嘉奖他，似乎已经将范兵卫大人选为了驻于须弥的「远国御用」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221531
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721221531,
					"content": "据说，是常驻须弥，保障须弥与稻妻蘑菇贸易通畅的重要职位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221532,
						721221534
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721221532,
					"content": "果然是重要职位。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721221533
					]
				},
				{
					"id": 721221533,
					"content": "正是如此。这样重要的职位，实在是非范兵卫大人莫属。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221536
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721221536,
					"content": "现在范兵卫大人正在城内等待任令，到了合适的时候，应该就会出发了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221537
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721221537,
					"content": "哎呀…这可真是太棒了。不过失去了这么一位好先生，那这里空缺的职位怎么办呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221538
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721221538,
					"content": "我已经向上面举荐了几位堪当此任的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221539
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721221539,
					"content": "上面的大人最后选定了一位名叫阳介的工匠，负责统一安排「御影炉心」之后的维护工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221540
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721221540,
					"content": "这样安排听着就让人放心。哦对了，我们先不说这个了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221541
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721221541,
					"content": "士兵先生，请把我的那份报酬全都给这位旅行者吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221542
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721221542,
					"content": "还有，这个东西请你收下，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221543
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721221543,
					"content": "这是我之前从一位工匠的手里买下来的一份图纸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221544
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721221544,
					"content": "本来我是想，把这份图纸作为纪念品带回国…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221545
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721221545,
					"content": "但现在看来，我应该还会在稻妻停留一段时间…暂时是没法回国了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221546
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721221546,
					"content": "所以，这份图纸我就送给您了，请您收好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221547
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721221547,
					"content": "谢谢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721221548
					]
				},
				{
					"id": 721221548,
					"content": "哈哈哈，您不用和我这么客气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221549
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721221549,
					"content": "这次多谢您帮忙了。等我制作好了那部「踏鞴物语」，一定第一个请您过来观影。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221550
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721221550,
					"content": "然后，士兵先生，我还有一个小小的忙，想要请你帮…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721221534,
					"content": "原来是负责给稻妻添蘑菇吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721221535
					]
				},
				{
					"id": 721221535,
					"content": "正是。给稻妻人的餐桌上添蘑菇这种重要工作，实在是非范兵卫大人莫属。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221536
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721221520,
					"content": "「御影炉心」已经安全了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721221521
					]
				},
				{
					"id": 721221517,
					"content": "这是我应该做的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721221518
					]
				},
				{
					"id": 721221506,
					"content": "就这么放任愚人众吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721221507
					]
				},
				{
					"id": 721221507,
					"content": "没有接到范兵卫大人的命令，我无权采取任何行动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221508
					],
					"speakerTitle": "虎之助"
				}
			]
		}
	]
}