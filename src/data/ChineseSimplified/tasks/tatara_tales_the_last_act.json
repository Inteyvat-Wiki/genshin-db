				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"虎之助"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721221201,
					"content": "「御影炉心」已经恢复正常了吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221202
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721221202,
					"content": "你已经知道了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721221203
					]
				},
				{
					"id": 721221203,
					"content": "你们在「御影炉心」所做的事，已经有人向我报告过了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221204,
						721221206
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721221204,
					"content": "为什么不直接来帮忙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721221205
					]
				},
				{
					"id": 721221205,
					"content": "没有接到范兵卫大人的命令，我无权采取任何行动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221208
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721221208,
					"content": "好了好了，有这么一位对流程如此重视的严谨上司，这位士兵先生也有他自己的苦衷，咱们就别为难他了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221209
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721221209,
					"content": "再说，我俩的行动之所以能如此顺利，说不定也有一部分是拜这位范兵卫先生所赐呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221210
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721221210,
					"content": "而且士兵先生也不是完全没有给我们帮助，比如那几门…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221211
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721221211,
					"content": "泽维尔先生，非常感谢你的协助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221212
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721221212,
					"content": "咳…主要还是得感谢这位旅行者，没有这位旅行者帮忙，我一个人可什么都做不到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221213
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721221213,
					"content": "是这样吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221214
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721221214,
					"content": "非常感谢你，旅行者。我为我之前的态度…向你道歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221215
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721221215,
					"content": "谢谢你保护了这座岛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221216,
						721221217
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721221216,
					"content": "不用客气。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721221218
					]
				},
				{
					"id": 721221218,
					"content": "您也别谦虚了，要是没您帮忙，我应该就只能在外面干看着啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221219
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721221219,
					"content": "不过，我倒是还有个问题，士兵先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221220
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721221220,
					"content": "您之前和我说，您那位严谨的上司为了递交那些繁复的文书，不得不前往城内工作，想必肯定十分劳苦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221221
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721221221,
					"content": "但现在「御影炉心」已经恢复了正常，不知道这位好先生现在…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221222
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721221222,
					"content": "唔，范兵卫大人所忙碌之事，先前就有位名叫御舆源次郎的大人详细询问过我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221223
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721221223,
					"content": "听了我的详细报告之后，御舆源次郎大人似乎对这件事也很感兴趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221224
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721221224,
					"content": "之后，据御舆源次郎大人说，上面的大人们也对范兵卫大人的工作能力十分赞赏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221225
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721221225,
					"content": "为了嘉奖他，似乎已经将范兵卫大人选为了驻于须弥的「远国御用」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221226
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721221226,
					"content": "据说，是常驻须弥，保障须弥与稻妻蘑菇贸易通畅的重要职位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221227,
						721221229
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721221227,
					"content": "果然是重要职位。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721221228
					]
				},
				{
					"id": 721221228,
					"content": "正是如此。这样重要的职位，实在是非范兵卫大人莫属。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221231
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721221231,
					"content": "现在范兵卫大人正在城内等待任令，到了合适的时候，应该就会出发了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221232
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721221232,
					"content": "哎呀…这可真是太棒了。不过失去了这么一位好先生，那这里空缺的职位怎么办呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221233
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721221233,
					"content": "我已经向上面举荐了几位堪当此任的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221234
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721221234,
					"content": "上面的大人最后选定了一位名叫阳介的工匠，负责统一安排「御影炉心」之后的维护工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221235
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721221235,
					"content": "这样安排听着就让人放心。哦对了，我们先不说这个了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221236
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721221236,
					"content": "士兵先生，请把我的那份报酬全都给这位旅行者吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221237
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721221237,
					"content": "还有，这个东西请你收下，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221238
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721221238,
					"content": "这是我之前从一位工匠的手里买下来的一份图纸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221239
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721221239,
					"content": "本来我是想，把这份图纸作为纪念品带回国…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221240
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721221240,
					"content": "但现在看来，我应该还会在稻妻停留一段时间…暂时是没法回国了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221241
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721221241,
					"content": "所以，这份图纸我就送给您了，请您收好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221242
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721221242,
					"content": "谢谢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721221243
					]
				},
				{
					"id": 721221243,
					"content": "哈哈哈，您不用和我这么客气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221244
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721221244,
					"content": "这次多谢您帮忙了。等我制作好了那部「踏鞴物语」，一定第一个请您过来观影。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221245
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721221245,
					"content": "然后，士兵先生，我还有一个小小的忙，想要请你帮…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721221229,
					"content": "原来是负责给稻妻添蘑菇吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721221230
					]
				},
				{
					"id": 721221230,
					"content": "正是。给稻妻人的餐桌上添蘑菇这种重要工作，实在是非范兵卫大人莫属。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221231
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721221217,
					"content": "这是我应该做的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721221218
					]
				},
				{
					"id": 721221206,
					"content": "就这么放任愚人众吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721221207
					]
				},
				{
					"id": 721221207,
					"content": "没有接到范兵卫大人的命令，我无权采取任何行动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221208
					],
					"speakerTitle": "虎之助"
				}
			]
		},
