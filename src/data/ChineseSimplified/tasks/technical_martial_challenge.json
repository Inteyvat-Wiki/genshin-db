			},
			"dialogs": [
				{
					"id": 765110101,
					"content": "按照奈芙尔女士的预测，比赛进行到现在，那位高手差不多要到场了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110102
					],
					"speakerTitle": "泽西切"
				},
				{
					"id": 765110102,
					"content": "#的确，泽西切先生，晚风已经捎来了{M#他}{F#她}的气息…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110103
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 765110103,
					"content": "#久违了，{NICKNAME}和派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110104
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 765110104,
					"content": "看见你们容光焕发的状态，我由衷欣喜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110105,
						765110106
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 765110105,
					"content": "居然是万叶？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765110107
					]
				},
				{
					"id": 765110107,
					"content": "没想到，万叶也会来挪德卡莱，还和这位执灯人先生聊上了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765110108,
					"content": "不对，周围的情况…气氛怎么有点紧张？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765110109,
					"content": "紧张是理所当然的，毕竟赛事已经到达了白热化的阶段，各地的「武学高人」都在等待最终结果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110110,
						765110111
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 765110110,
					"content": "比拼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765110112
					]
				},
				{
					"id": 765110112,
					"content": "没错，欢迎来到「挪德卡莱有限制冷静格斗赛」的决赛现场！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110113
					],
					"speakerTitle": "泽西切"
				},
				{
					"id": 765110113,
					"content": "相比肆意出招，天马行空的比武，这次格斗赛更聚焦于淳朴的武器技艺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110114
					],
					"speakerTitle": "泽西切"
				},
				{
					"id": 765110114,
					"content": "因此，我们组委会才委托冒险家协会，邀请到了这位「南十字船队」的顶尖剑客，担任我们的顾问！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110115
					],
					"speakerTitle": "泽西切"
				},
				{
					"id": 765110115,
					"content": "我明白了，这次万叶成了武斗会的评委！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765110116,
					"content": "是的，我之前也略感意外，没想到那场比武的消息居然传到了挪德卡莱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110117
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 765110117,
					"content": "大姐头她们前不久才在那夏镇参了展，处理完了这里的所有事务，短时间内不会再来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110118
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 765110118,
					"content": "而我相对空闲，又有着「南十字武斗会」的一些经验，所以就答应了泽西切先生的邀请。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110119
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 765110119,
					"content": "多亏万叶先生那敏锐的观察力，还有近乎绝对客观的评价，一些混乱的赛况才能被准确判明结果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110120
					],
					"speakerTitle": "泽西切"
				},
				{
					"id": 765110120,
					"content": "不过现在又难办了，三位冠军候选者各有优势，互相破不了对方的招。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110121
					],
					"speakerTitle": "泽西切"
				},
				{
					"id": 765110121,
					"content": "这样打下去，再来几天几夜都没个结果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110122
					],
					"speakerTitle": "泽西切"
				},
				{
					"id": 765110122,
					"content": "呜啊，比赛打不出结果？还真是从没听过的情况…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765110123,
					"content": "依我看，还是实行那个方案好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110124
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 765110124,
					"content": "没错，还是要麻烦这位专家中的专家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110125
					],
					"speakerTitle": "泽西切"
				},
				{
					"id": 765110125,
					"content": "#咦，焦点怎么转移到了{NICKNAME}身上？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765110126,
					"content": "如果你能稍微露两手，僵局就会被打破。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110127,
						765110128
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 765110127,
					"content": "我来打表演赛？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765110129
					]
				},
				{
					"id": 765110129,
					"content": "不，是由你这位「南十字武斗会」的冠军，武学界的绝对泰斗，来扮演决定冠军的最终试炼人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110130
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 765110130,
					"content": "你分别对战三位冠军候选人，以他们对你造成的威胁来进行评分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110131
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 765110131,
					"content": "最终，分数最高的一位便将获得冠军。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110132
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 765110132,
					"content": "而为了答谢你为比赛做出的贡献，原定冠军一半的奖金，将支付给您作为酬劳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110133
					],
					"speakerTitle": "泽西切"
				},
				{
					"id": 765110133,
					"content": "还有这种解决方式吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765110134,
					"content": "既能搞定比赛僵住的麻烦，又给足了我们面子和好处…不愧是万叶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110135,
						765110136
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765110135,
					"content": "这种事，我还真没体验过。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765110137
					]
				},
				{
					"id": 765110137,
					"content": "真爽快，那就这么说定了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110138
					],
					"speakerTitle": "泽西切"
				},
				{
					"id": 765110138,
					"content": "#有劳你了，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110139
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 765110139,
					"content": "三位对手各有看家本领，相信你会享受这次的切磋，并展现出往届冠军的英姿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 765110136,
					"content": "的确是非常新奇的做法。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765110137
					]
				},
				{
					"id": 765110128,
					"content": "我给大家助兴？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765110129
					]
				},
				{
					"id": 765110111,
					"content": "武学？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765110112
					]
				},
				{
					"id": 765110106,
					"content": "好久不见！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765110107
					]
				}
			]
		}
	]
}