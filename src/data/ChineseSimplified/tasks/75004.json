				]
			},
			"dialogs": [
				{
					"id": 750040101,
					"content": "咦，在这里怎么会有一块石碑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750040102,
					"content": "大概是以前部族里的人留下来的吧，经常会有这样的东西，在很久以前作为警告的界碑，告诉你「你已经越界！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040103
					],
					"speakerTitle": "蒂图"
				},
				{
					"id": 750040103,
					"content": "你们在纳塔路边有时能看到一些刻有白色纹路的石头，也是差不多的作用，只不过那些现在都已经被废弃了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040104
					],
					"speakerTitle": "蒂图"
				},
				{
					"id": 750040104,
					"content": "唔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040105
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750040105,
					"content": "原来是这样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750040106,
					"content": "边界，在纳塔也是很严肃的事情…生者与死者，内与外，上与下，只有真正行于界线中的人才能掌握好危险的分寸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040107
					],
					"speakerTitle": "蒂图"
				},
				{
					"id": 750040107,
					"content": "据说以前也曾有过古遗迹中的石碑：「任何怀有不轨之心之人踏过此碑，我将用手化作龙爪扼住其人的脖颈。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040108
					],
					"speakerTitle": "蒂图"
				},
				{
					"id": 750040108,
					"content": "啊，那如果这块石碑上写着什么警告或者诅咒之类的…可怎么办啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750040109,
					"content": "看看就知道了…这是陶奥鲁留下的，居然，欸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040110,
						750040112
					],
					"speakerTitle": "蒂图"
				},
				{
					"id": 750040110,
					"content": "好像在哪听到过…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750040111
					]
				},
				{
					"id": 750040111,
					"content": "是之前蒂图讲过的，在深渊侵蚀纳塔的时候，带领部族里的人和深渊…还有两位坎瑞亚士兵交战的人啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750040113,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040114
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750040114,
					"content": "哦哦，你们记得很清楚嘛。讲故事的人大多数的时候都很喜欢这种能够记住故事的人哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040115
					],
					"speakerTitle": "蒂图"
				},
				{
					"id": 750040115,
					"content": "毕竟…记住故事也是成为讲故事的人最基础的素质。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040116
					],
					"speakerTitle": "蒂图"
				},
				{
					"id": 750040116,
					"content": "我看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040117
					],
					"speakerTitle": "蒂图"
				},
				{
					"id": 750040117,
					"content": "上面写着，异邦的朋友…「西弗安雅与伊利萨」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750040118,
					"content": "嗯…「你们更希望在故事里你们是懦夫、暴徒或悬挂的钉刺，就像咬龙的蜜虫那样让部族的人们不敢懈怠，世代警惕。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750040119,
					"content": "嗯…「但我要在这里说出真相。因你们永远是与部族共进退的豪杰，永远是回声之子的兄弟。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750040120,
					"content": "啊，原来那两个坎瑞亚人，还和部族一起战斗过？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750040121,
					"content": "…这是，那两位坎瑞亚士兵的名字，在、在所有的故事里他们都是邪恶的化身，我甚至在噩梦中也看到过他们的身形。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040122
					],
					"speakerTitle": "蒂图"
				},
				{
					"id": 750040122,
					"content": "「再不停止哭泣，坎瑞亚士兵的亡灵就将循声找到你的影子」…结果其实都是假的，是一场骗局？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040123
					],
					"speakerTitle": "蒂图"
				},
				{
					"id": 750040123,
					"content": "可是这对他们不公平…凭什么，为部族付出那么大牺牲的人却要背负那么久的骂名。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040124
					],
					"speakerTitle": "蒂图"
				},
				{
					"id": 750040124,
					"content": "是啊，那也太可怜了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750040125,
					"content": "呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040126
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750040126,
					"content": "他们并不在乎是否得享美誉…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750040127
					]
				},
				{
					"id": 750040127,
					"content": "他们只在乎意志是否得到执行。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750040128
					]
				},
				{
					"id": 750040128,
					"content": "是这样吗…啊，我，我明白了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750040129,
					"content": "就像大部分的英雄，并不是为了得到赞扬才去做那些让他们成为英雄的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750040130,
					"content": "他们是去「做了那些事」，才成为了英雄，所以才不在乎别人怎么评价他们吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750040131,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040132
					],
					"speakerTitle": "蒂图"
				},
				{
					"id": 750040132,
					"content": "唉，也许真的是这样，可是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040133
					],
					"speakerTitle": "蒂图"
				},
				{
					"id": 750040133,
					"content": "啊，「镌光铭印」继续向前飞了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750040134,
					"content": "#哇，这里就是…就是他们最终封印了深渊的地方，看，{NICKNAME}，那个中间，有好多金色的花纹…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750040135,
					"content": "也有泄露的深渊的痕迹。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750040136
					]
				},
				{
					"id": 750040136,
					"content": "看来，就是那个在吸引「镌光铭印」，无论如何我们得到那里看看才行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蒂图"
				},
				{
					"id": 750040112,
					"content": "啊，是抵抗深渊的长老…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750040113
					]
				}
			]
