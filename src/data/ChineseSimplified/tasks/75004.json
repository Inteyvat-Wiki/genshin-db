				},
				{
					"id": 750040205,
					"content": "只不过头还是有点疼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040206
					],
					"speakerTitle": "蒂图"
				},
				{
					"id": 750040206,
					"content": "#{NICKNAME}呢，有什么感觉吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040207,
						750040209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750040207,
					"content": "没什么大碍…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750040208
					]
				},
				{
					"id": 750040208,
					"content": "那就好那就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750040211,
					"content": "#那，{REALNAME[ID(2)|SHOWHOST(true)]}，有没有觉得不舒服呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750040212,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040213
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750040213,
					"content": "看来好像暂时也没什么事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750040214,
					"content": "到了这里就能很明显感知到，声音是从石柱子上来的…那应该是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040215
					],
					"speakerTitle": "蒂图"
				},
				{
					"id": 750040215,
					"content": "一起被封印的坎瑞亚士兵…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750040216
					]
				},
				{
					"id": 750040216,
					"content": "呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040217
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750040217,
					"content": "也就是说，他们的意识也和深渊一起，被封印了那么多年…可是，这里到底出了什么问题呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750040218,
					"content": "其实…这里的问题和在上面的「小缝影针」很像，深渊的涌动让「镌光铭印」的力量破碎并被挤压出了大的封印之柱中…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040219
					],
					"speakerTitle": "蒂图"
				},
				{
					"id": 750040219,
					"content": "所以我们需要找到在这里的大「镌光铭印」的碎片，然后想办法把「蛋壳」重新拼起来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750040220,
					"content": "对，这样，封印就能恢复完整，深渊也能持续被封印在此，然后…一切估计就能够恢复原样了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040221
					],
					"speakerTitle": "蒂图"
				},
				{
					"id": 750040221,
					"content": "不过就和之前在「小缝影针」那里一样。固态燃素构建的地面和深渊会有剧烈的冲突反应，这也是地面起伏不定的原因…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040222
					],
					"speakerTitle": "蒂图"
				},
				{
					"id": 750040222,
					"content": "这点请一定要小心啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040223
					],
					"speakerTitle": "蒂图"
				},
				{
					"id": 750040223,
					"content": "不过，大「镌光铭印」的碎片啊，到底应该怎么找呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750040224,
					"content": "呀…呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040225
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750040225,
					"content": "#什么，有铭印的力量藏在那个里面吗，{REALNAME[ID(2)|SHOWHOST(true)]}的鼻子很灵哦…呃，你用的是鼻子吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750040226,
					"content": "不过之前有这样一块石头吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040227
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750040227,
					"content": "#刚才，{NICKNAME}靠近大「镌光铭印」的时候…好像是那时候出现的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040228
					],
					"speakerTitle": "蒂图"
				},
				{
					"id": 750040228,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040229
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750040229,
					"content": "好啦，总之，我们先到那块石块周围看看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750040209,
					"content": "感觉声音挺立体的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750040210
					]
				},
				{
					"id": 750040210,
					"content": "谁问你这个啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040211
					],
					"speakerTitle": "派蒙"
				}
			]
