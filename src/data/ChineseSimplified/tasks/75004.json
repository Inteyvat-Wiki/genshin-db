					"content": "呜…呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040204
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750040204,
					"content": "那个声音，更加完整，但是…不知道为什么，感觉并没有之前那么害怕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
