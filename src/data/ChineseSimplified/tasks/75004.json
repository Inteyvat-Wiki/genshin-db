					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040409
					],
					"speakerTitle": "「毛发如夜的野兽」"
				},
				{
					"id": 750040409,
					"content": "去吧，但要小心危险的唆使，要小心阴险者谋划的结局。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「毛发如夜的野兽」"
