				]
			},
			"dialogs": [
				{
					"id": 741210701,
					"content": "…什么嘛，原来他们根本没想要我的命啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210702
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 741210702,
					"content": "唉，看来真的瞒不过你。没错，机器是我破坏的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210703
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 741210703,
					"content": "但是，你为什么要破坏机器呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210704
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741210704,
					"content": "当然是为了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210705
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 741210705,
					"content": "以前，我过着很贫困的生活，每天都过得很忧郁。后来，我遇到了一个人很好的大哥，他给我喝了能让我精神振奋的健康饮料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210706
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 741210706,
					"content": "他对我很好，所以我就想报答他。后来，我的机会终于来了！大哥介绍我跟一些有钱的大人物见面，让我帮他们的忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210707
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 741210707,
					"content": "干的都是一些杂活，像是回收枫丹科学院的机械零件之类的。作为回报，他们会给我很多钱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210708
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 741210708,
					"content": "还有这么好的事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210709
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741210709,
					"content": "对吧？这回他们让我找到这种奇怪机器，把它里面的核心取出来交给他们。一方面报答大哥，另一方面为了赚钱，我当然要努力！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210710
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 741210710,
					"content": "但是，那些坏人…可能就是不喜欢看到我努力干活赚钱改变命运，就从中作梗，警告我不要把这些什么科学精密零件交给他们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210711
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 741210711,
					"content": "但我偏不！我不但接下了这份工作，还抗议他们的暴行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210712
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 741210712,
					"content": "结果，就如你们所说，被教训了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210713
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 741210713,
					"content": "喔，那还真是可怜…不过，这个工作真的有这么好赚吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210714
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741210714,
					"content": "当然。这也是之前我不想告诉你们我抗议理由的原因。不过，既然你们是救命恩人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210715
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 741210715,
					"content": "倒也没有生命危险吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210716
					]
				},
				{
					"id": 741210716,
					"content": "…另外我也觉得，肯定瞒不过你们，那干脆就告诉你们好了。就当我们是合伙人吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210717
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 741210717,
					"content": "在地上和水下的一些地方，有人部署了这种奇怪机器。识别的方法也很简单，机器的周围会产生很奇怪的光。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210718
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 741210718,
					"content": "把它解决掉，把里面这种特定的核心带给我，一共<color=#00E1FFFF>需要七个</color>。事成后，我们五五分成。成交？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210719,
						741210721,
						741210722
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 741210719,
					"content": "听起来还不错。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210720
					]
				},
				{
					"id": 741210720,
					"content": "唔，不过，这些机器是干什么的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210725
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741210725,
					"content": "会破坏环境，是性质非常恶劣的机器。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210726
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 741210726,
					"content": "具体会怎么破坏环境呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210727
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741210727,
					"content": "我怎么知道？我又不是枫丹科学院的人。反正都产生异象了，肯定对环境有害吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210728
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 741210728,
					"content": "嗯…倒也不是没有道理，我们冒险的途中每次看到莫名其妙的超自然环境，一般都有坏事需要我们解决…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210729
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741210729,
					"content": "#{NICKNAME}，不如我们就帮帮恩里吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210730
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741210730,
					"content": "哈哈，好啊。那就这么说定了！<color=#00E1FFFF>带七个核心给我</color>，我们一起赚大钱！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "恩里"
				},
				{
					"id": 741210721,
					"content": "这些机器是干什么的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210725
					]
				},
				{
					"id": 741210722,
					"content": "我七你三，多出的两成你提前给我。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210723
					]
				},
				{
					"id": 741210723,
					"content": "…唉，行吧。但实在没办法提前给你，我还等着东西齐活了跟老板结帐呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210724
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 741210724,
					"content": "唔，不过，这些机器是干什么的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210725
					],
					"speakerTitle": "派蒙"
				}
			]
