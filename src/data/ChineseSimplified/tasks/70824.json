					"nextDialogs": [
						708240105
					]
				},
				{
					"id": 708240105,
					"content": "是您啊，欢迎光临晨曦酒庄，暴风虽然平息了，但被暴风弄得乱七八糟的酒庄还要收拾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240106
					],
					"speakerTitle": "爱德琳"
				},
				{
					"id": 708240106,
					"content": "我正在安排打扫的事，但是摩可和海莉，实在是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240107
					],
					"speakerTitle": "爱德琳"
				},
				{
					"id": 708240107,
					"content": "对不起！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240108
					],
					"speakerTitle": "摩可"
				},
				{
					"id": 708240108,
					"content": "我们会再细心点！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240109
					],
					"speakerTitle": "海莉"
				},
				{
					"id": 708240109,
					"content": "你们已经说过一次了！有道歉的功夫，还不如去再细心打扫一遍，还不快去！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240110
					],
					"speakerTitle": "爱德琳"
				},
				{
					"id": 708240110,
					"content": "唉，这两个孩子，怎么老是这么粗心，用这种工作效率，什么时候才能收拾完，屋子里面可还要打扫呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "爱德琳"
				}
			]
		},
