				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710640201,
					"content": "（一块小石碑，其上刻文如下…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640202
					],
					"speakerTitle": "石碑"
				},
				{
					"id": 710640202,
					"content": "…「层岩巨渊一战，我四肢皆痪，只得口述，托人记录并镌刻于此。」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640203
					],
					"speakerTitle": "石碑"
				},
				{
					"id": 710640203,
					"content": "…「鏖战之中，虽讨得一命，每念及殉难同袍，便夙夜难眠。何况留此残躯，真恨不能随诸位同去。」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640204
					],
					"speakerTitle": "石碑"
				},
				{
					"id": 710640204,
					"content": "…「自绝无果，帝君得闻，痛加斥詈，如是幡然醒悟。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640205
					],
					"speakerTitle": "石碑"
				},
				{
					"id": 710640205,
					"content": "…「可叹帝君仁慈，赐还千岩军兜鍪甲胄，私念无能报效，留之亦为蒙尘，如是放置于此，待有缘人相取。」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640206
					],
					"speakerTitle": "石碑"
				},
				{
					"id": 710640206,
					"content": "…「诸位，此生已无机会，便来世再做同袍，届时再共饮一杯盟誓之酒，共抵璃月之敌寇。」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "石碑"
				}
			]
		},
		{
			"id": 7106403,
			"completionStepIds": [
				7106411
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7106411",
							"2"
						],
						"stepId": 7106411,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿望"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710640301,
					"content": "没想到真的让你给找到了…这就是「千岩军的宝藏」吗…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640302
					],
					"speakerTitle": "阿望"
				},
				{
					"id": 710640302,
					"content": "虽然不知道里面有什么，不过…那份宝藏能够被你找到，当年留下那份宝藏的千岩军恐怕也很欣慰吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640303
					],
					"speakerTitle": "阿望"
				},
				{
					"id": 710640303,
					"content": "离那场灾厄已经五百年了，一想到五百年前，这里是水深火热的战场，而无数先烈在此牺牲，就让人不禁疑问…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640304
					],
					"speakerTitle": "阿望"
				},
				{
					"id": 710640304,
					"content": "在那个年代，随岩王爷征战的无数凡民，他们中的某一位，也会认为自己在参与一项被后人铭记千百年的事业吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640305
					],
					"speakerTitle": "阿望"
				},
				{
					"id": 710640305,
					"content": "他们不会对自己的职责产生片刻的怀疑吗…？那些没能获得「神之眼」的凡人，如何忠诚于一个未曾注视他们的神，至死方休呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640306,
						710640307
					],
					"speakerTitle": "阿望"
				},
				{
					"id": 710640306,
					"content": "因为神从未远离他们身边。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710640308
					]
				},
				{
					"id": 710640308,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640309
					],
					"speakerTitle": "阿望"
				},
				{
					"id": 710640309,
					"content": "嗯，你说的没错。有「神之眼」也好，没有也好…人总还是要为了无穷可能的未来而努力的。这就是动力嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640310
					],
					"speakerTitle": "阿望"
				},
				{
					"id": 710640310,
					"content": "我们也是一样，不是为了过去的好日子，也不是为了当今的自我实现…而是为了彼此扶持，一同在时代中留下自己的痕迹与声音。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640311
					],
					"speakerTitle": "阿望"
				},
				{
					"id": 710640311,
					"content": "或许很久以后，层岩巨渊也会成为我们的纪念碑吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640314
					],
					"speakerTitle": "阿望"
				},
				{
					"id": 710640314,
					"content": "这满坑满谷刀削斧凿的痕迹，一代代矿工挥洒的汗水…同样见证着我们选择的艰辛之路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640312
					],
					"speakerTitle": "阿望"
				},
				{
					"id": 710640312,
					"content": "就像这块纪念石一样，将来百年，不，将来千年都会竖立在此，证明将士们的牺牲没有被记忆辜负。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640313
					],
					"speakerTitle": "阿望"
				},
				{
					"id": 710640313,
					"content": "嘿嘿，虽然我肯定看不到了…但到那时候，希望也会有人来此为我们这些穷矿工酌上苦酒一杯，我也就心满意足了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿望"
				},
				{
					"id": 710640307,
					"content": "他们也是忠于自己的选择。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710640308
					]
				}
			]
		},
