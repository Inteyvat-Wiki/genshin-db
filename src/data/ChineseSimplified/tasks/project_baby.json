			},
			"dialogs": [
				{
					"id": 230041101,
					"content": "宠物蛇也有专用口粮吗？它们一般不是会吃老鼠之类的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230041102,
					"content": "最开始它们也是会自己觅食的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041103
					],
					"speakerTitle": "古拉布吉尔"
				},
				{
					"id": 230041103,
					"content": "但自从它们进食的时候吓到了几个孩子之后，我就不敢让它们自己出去了，都是自己调制口粮给它们吃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041104
					],
					"speakerTitle": "古拉布吉尔"
				},
				{
					"id": 230041104,
					"content": "唉…不过，自从我开始给它们调制口粮之后，它们就开始懒得动弹，也基本上不吃其他食物了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041105
					],
					"speakerTitle": "古拉布吉尔"
				},
				{
					"id": 230041105,
					"content": "欸…不劳而获的食物啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041106,
						230041107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230041106,
					"content": "好吃！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041108
					]
				},
				{
					"id": 230041108,
					"content": "我还没问味道呢，别这么一脸向往的表情，你不会有这种机会的啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230041109,
					"content": "那种机会是派蒙的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230041110,
					"content": "说得真是理直气壮…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041111
					]
				},
				{
					"id": 230041111,
					"content": "我肯定是之前出去采草药的时候，把口粮落在哪处营地里了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041112
					],
					"speakerTitle": "古拉布吉尔"
				},
				{
					"id": 230041112,
					"content": "可是我也不方便自己去找，得留在这里看着这群小家伙，防止它们饿极了溜出去吓到别人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041113
					],
					"speakerTitle": "古拉布吉尔"
				},
				{
					"id": 230041113,
					"content": "旅行者，你能帮我跑一趟，从营地里把口粮带回来吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041114,
						230041117,
						230041119
					],
					"speakerTitle": "古拉布吉尔"
				},
				{
					"id": 230041114,
					"content": "那就交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041115
					]
				},
				{
					"id": 230041115,
					"content": "太谢谢你了，要是我自己带着这群小家伙回去找，还不知道会发生什么意外呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041116
					],
					"speakerTitle": "古拉布吉尔"
				},
				{
					"id": 230041116,
					"content": "要是它们兴致来了，往林子里一钻玩个几天，那我就惨了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041122
					],
					"speakerTitle": "古拉布吉尔"
				},
				{
					"id": 230041122,
					"content": "总之，这件事就拜托你了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041123
					],
					"speakerTitle": "古拉布吉尔"
				},
				{
					"id": 230041123,
					"content": "我把这次待过的营地标注在你的地图上，请你去那边看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "古拉布吉尔"
				},
				{
					"id": 230041117,
					"content": "那边不会有其他蛇吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041118
					]
				},
				{
					"id": 230041118,
					"content": "不会的，不会的，我选的那几处营地都特意避开了蛇的聚集地，免得惹上什么麻烦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041122
					],
					"speakerTitle": "古拉布吉尔"
				},
				{
					"id": 230041119,
					"content": "有很多处营地吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041120
					]
				},
				{
					"id": 230041120,
					"content": "我之前在雨林里生活的时候，亲手布置了不少营地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041121
					],
					"speakerTitle": "古拉布吉尔"
				},
				{
					"id": 230041121,
					"content": "虽然现在我已经不在雨林里讨生活了…但进林子采草药的时候，我还是会在营地里休息一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041122
					],
					"speakerTitle": "古拉布吉尔"
				},
				{
					"id": 230041107,
					"content": "非常好吃！",
