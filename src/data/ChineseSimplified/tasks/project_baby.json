				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230042201,
					"content": "咦？这些帽子…哈哈哈，是我之前给小蛇们做的帽子啊。我怎么把它们也落下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042202
					],
					"speakerTitle": "古拉布吉尔"
				},
				{
					"id": 230042202,
					"content": "之前为了让一些孩子们来看，我就给它们每条蛇都做了一顶睡帽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042203
					],
					"speakerTitle": "古拉布吉尔"
				},
				{
					"id": 230042203,
					"content": "阿耶的是红色的，阿梦的是绿色的，小加的是黄色的，阿德的是蓝色的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042204
					],
					"speakerTitle": "古拉布吉尔"
				},
				{
					"id": 230042204,
					"content": "听上去就很可爱，演出效果一定不错！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230042205,
					"content": "最开始是不错，但只要小蛇们张开嘴，孩子们肯定会哇哇大哭…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042206
					],
					"speakerTitle": "古拉布吉尔"
				},
				{
					"id": 230042206,
					"content": "唉，不说这些了，请收下这些报酬吧，也算是我的一点心意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "古拉布吉尔"
				}
			]
