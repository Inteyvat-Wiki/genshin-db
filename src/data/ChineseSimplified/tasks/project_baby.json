			"dialogs": [
				{
					"id": 230042401,
					"content": "啊！这不是我之前做的蛇爬架吗？真怀念啊，哈哈哈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042402
					],
					"speakerTitle": "古拉布吉尔"
				},
				{
					"id": 230042402,
					"content": "蛇爬架是什么啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230042403,
					"content": "就是给小蛇们爬来爬去解闷的玩具呀，总不能让它们时时刻刻都挂在我身上吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042404
					],
					"speakerTitle": "古拉布吉尔"
				},
				{
					"id": 230042404,
					"content": "谢谢你们帮我把它带回来，这些报酬请收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042405
					],
					"speakerTitle": "古拉布吉尔"
				},
				{
					"id": 230042405,
					"content": "我之前是这么设计的吗？真怀念啊…",
