			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"古拉布吉尔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230041201,
					"content": "养蛇做宠物的人，总感觉之前也见过呢…对了！那个叫做白术的怪人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041202,
						230041203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230041202,
					"content": "长生应该不是「宠物」啦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041204
					]
				},
				{
					"id": 230041204,
					"content": "宠物蛇也有专用口粮吗？它们一般不是会吃老鼠之类的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230041205,
					"content": "最开始它们也是会自己觅食的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041206
					],
					"speakerTitle": "古拉布吉尔"
				},
				{
					"id": 230041206,
					"content": "但自从它们进食的时候吓到了几个孩子之后，我就不敢让它们自己出去了，都是自己调制口粮给它们吃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041207
					],
					"speakerTitle": "古拉布吉尔"
				},
				{
					"id": 230041207,
					"content": "唉…不过，自从我开始给它们调制口粮之后，它们就开始懒得动弹，也基本上不吃其他食物了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041208
					],
					"speakerTitle": "古拉布吉尔"
				},
				{
					"id": 230041208,
					"content": "欸…不劳而获的食物啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041209,
						230041210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230041209,
					"content": "好吃！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041211
					]
				},
				{
					"id": 230041211,
					"content": "我还没问味道呢，别这么一脸向往的表情，你不会有这种机会的啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230041212,
					"content": "那种机会是派蒙的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230041213,
					"content": "说得真是理直气壮…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041214
					]
				},
				{
					"id": 230041214,
					"content": "我肯定是之前出去采草药的时候，把口粮落在哪处营地里了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041215
					],
					"speakerTitle": "古拉布吉尔"
				},
				{
					"id": 230041215,
					"content": "可是我也不方便自己去找，得留在这里看着这群小家伙，防止它们饿极了溜出去吓到别人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041216
					],
					"speakerTitle": "古拉布吉尔"
				},
				{
					"id": 230041216,
					"content": "旅行者，你能帮我跑一趟，从营地里把口粮带回来吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041217,
						230041220,
						230041222
					],
					"speakerTitle": "古拉布吉尔"
				},
				{
					"id": 230041217,
					"content": "那就交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041218
					]
				},
				{
					"id": 230041218,
					"content": "太谢谢你了，要是我自己带着这群小家伙回去找，还不知道会发生什么意外呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041219
					],
					"speakerTitle": "古拉布吉尔"
				},
				{
					"id": 230041219,
					"content": "要是它们兴致来了，往林子里一钻玩个几天，那我就惨了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041225
					],
					"speakerTitle": "古拉布吉尔"
				},
				{
					"id": 230041225,
					"content": "总之，这件事就拜托你了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041226
					],
					"speakerTitle": "古拉布吉尔"
				},
				{
					"id": 230041226,
					"content": "我把这次待过的营地标注在你的地图上，请你去那边看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "古拉布吉尔"
				},
				{
					"id": 230041220,
					"content": "那边不会有其他蛇吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041221
					]
				},
				{
					"id": 230041221,
					"content": "不会的，不会的，我选的那几处营地都特意避开了蛇的聚集地，免得惹上什么麻烦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041225
					],
					"speakerTitle": "古拉布吉尔"
				},
				{
					"id": 230041222,
					"content": "有很多处营地吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041223
					]
				},
				{
					"id": 230041223,
					"content": "我之前在雨林里生活的时候，亲手布置了不少营地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041224
					],
					"speakerTitle": "古拉布吉尔"
				},
				{
					"id": 230041224,
					"content": "虽然现在我已经不在雨林里讨生活了…但进林子采草药的时候，我还是会在营地里休息一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041225
					],
					"speakerTitle": "古拉布吉尔"
				},
				{
					"id": 230041210,
					"content": "非常好吃！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041211
					]
				},
				{
					"id": 230041203,
					"content": "你这么说长生会生气的喔。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041204
					]
				}
			]
		},
