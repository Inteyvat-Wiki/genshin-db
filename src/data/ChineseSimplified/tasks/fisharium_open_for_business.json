			"dialogs": [
				{
					"id": 747020101,
					"content": "哟，最近带回来不少鱼嘛。水族箱也装点得越来越像那么回事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020102
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747020102,
					"content": "嘿嘿，我们这方面可是很在行的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747020103,
					"content": "你们好像很有成就感的样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020104
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747020104,
					"content": "那当然！不过除了成就感之外，总觉得心中有些…有些…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020105,
						747020106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747020105,
					"content": "可惜？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020107
					]
				},
				{
					"id": 747020107,
					"content": "对对对，差不多就是你那个意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747020108,
					"content": "这是为什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020109
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747020109,
					"content": "我也不知道…总觉得这里还少了什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020110,
						747020112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747020110,
					"content": "少了餐厅？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020111
					]
				},
				{
					"id": 747020111,
					"content": "喂！肯定不是啦！这么漂亮的鱼儿怎么舍得吃呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747020114,
					"content": "少的是来欣赏我们成果的客人呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747020115,
					"content": "你的意思是…想让这个水族馆开业接待游客？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020116
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747020116,
					"content": "你有什么顾虑吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020117,
						747020118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747020117,
					"content": "怕这里变得太热闹？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020119
					]
				},
				{
					"id": 747020119,
					"content": "如果是这样的话，把经营和宣传工作交给我们就好！桑多涅你安心做自己的事，不用操心这边！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747020120,
					"content": "既然你们都这么说了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020121
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747020121,
					"content": "营收额三七分！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020122
					]
				},
				{
					"id": 747020122,
					"content": "欸…？我们才拿七成吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747020123,
					"content": "七成是人家的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020124
					]
				},
				{
					"id": 747020124,
					"content": "哦哦…也对，毕竟这船是桑多涅租的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747020125,
					"content": "得了得了，别把我说得像什么不讲道理的地主。你们出的力，你们拿大头。我可没潘塔罗涅那么抠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020126
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747020126,
					"content": "那也就是…你同意水族馆营业了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747020127,
					"content": "嗯，随你们倒弄去吧。别吵到我研究就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020128
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747020128,
					"content": "好欸！维恩歌莱噗噗水族馆，开业！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747020129,
					"content": "原来早就把名字想好了吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747020118,
					"content": "怕事情变得麻烦？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020119
					]
				},
				{
					"id": 747020112,
					"content": "少了客人？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020113
					]
				},
				{
					"id": 747020113,
					"content": "哦！没错！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747020106,
					"content": "孤独？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020107
					]
				}
			]
		}
	]
}