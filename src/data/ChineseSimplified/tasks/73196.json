			"dialogs": [
				{
					"id": 731960701,
					"content": "小店经营各类日用杂货，每一件商品都由店主本人亲自把关，质量包您满意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960702
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731960702,
					"content": "「老爹，能再借我笔钱吗？我都打听好了，枣椰的价格最近会大涨，这次一定能狠狠赚上一笔。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
