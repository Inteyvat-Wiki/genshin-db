			},
			"dialogs": [
				{
					"id": 731960501,
					"content": "手织毛毯，须弥艺术的瑰宝！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960502
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731960502,
					"content": "每个须弥人一生中都该拥有一条！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960503
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731960503,
					"content": "毛毯有价，艺术无价！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
		{
			"id": 7319606,
			"completionStepIds": [
