			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319602",
							"2"
						],
						"stepId": 7319602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731960201,
					"content": "本交易所竭力保证所提供的市场信息准确可靠，但并不以任何形式担保其准确性和完整性。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960202
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731960202,
					"content": "任何使用方不得就全部或部分以公告板中发布的市场信息作为依据并对由此而引起的任何损失向本所提出索赔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
		{
			"id": 7319603,
			"completionStepIds": [
				7319603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319603",
							"2"
						],
						"stepId": 7319603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731960301,
					"content": "你听说过浮空术吗？你见过空中飞人吗？你想知道飞天驮兽背后隐藏的奥秘吗？那就不要错过枫丹飞天艺术团首次须弥展演！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960302
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731960302,
					"content": "欢迎光临，莫失良机，随到随看，仅需五摩拉即可观赏这一独特的艺术展演！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960303
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731960303,
					"content": "经群众举报，该演出未经教令院核准，现已取消其演出资格，此广告即行撤下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
		{
			"id": 7319604,
			"completionStepIds": [
				7319604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
