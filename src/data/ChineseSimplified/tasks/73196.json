			"dialogs": [
				{
					"id": 731960901,
					"content": "正宗沙漠烧烤，赤王秘传酱料配方，沙海原产香辛料烤制。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960902
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731960902,
					"content": "提供大家都能吃到喝到的好东西！",
					"roleType": "TALK_ROLE_NPC",
