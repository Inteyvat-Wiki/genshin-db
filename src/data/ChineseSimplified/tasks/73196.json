				"points": []
			},
			"dialogs": [
				{
					"id": 731961001,
					"content": "「过去我曾拥有取之不尽的财富，但无论怎样挥霍也无法让我的内心得到平静。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961002
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731961002,
					"content": "「经过这次旅行，现在我的钱袋里连一个摩拉都没有，可我却觉得宁静无比。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961003
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731961003,
					"content": "「若想听听我的故事，就来蔬菜摊找我吧。当然，能买点蔬菜的话就更好了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
