				{
					"id": 731961101,
					"content": "艾尼洗染坊，手法细腻，技艺精湛，为您的衣物增添新的色彩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961102
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731961102,
					"content": "「老板，我上个月送来洗染的衣料能取到了吗？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961103
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731961103,
					"content": "「实在抱歉！昨天我老婆生孩子，没时间做工。请你明天再来吧，我保证按时交货。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961104
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731961104,
					"content": "「都已经过去三个月了，请您把衣料还给我吧，我不要洗染了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961105
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731961105,
					"content": "「不好意思！你的衣料我本来已经染好了，结果晾晒时不知道被哪个贼人偷走了，你若要取，就去找偷衣料的贼人吧。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
