			"dialogs": [
				{
					"id": 731960801,
					"content": "本店诚收「卡兹尼的失落金人」，价格可与店主当面详谈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960802
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731960802,
					"content": "如有相关情报也请至梅娜卡里商铺联系收藏家哈立德，有重金酬谢！",
					"roleType": "TALK_ROLE_NPC",
