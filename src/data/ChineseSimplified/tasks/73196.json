			"dialogs": [
				{
					"id": 731961201,
					"content": "本司经营海外贸易服务，与「南十字船队」等有力船队皆有长期合作，为您的生意保驾护航。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961202
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731961202,
					"content": "今夏增开四条航线，涉及丝绸、香料、矿石等大宗商品，新购商船载货量大，诚邀各路商主加盟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961203
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731961203,
					"content": "如需承包整条航线，请洽老板法尔扎妮面谈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
