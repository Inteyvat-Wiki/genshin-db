				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731960401,
					"content": "本行即将在须弥设置办事处，诸位未来客户敬请期待！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960402
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731960402,
					"content": "如需办理业务，请联系维克多转璃月分行代办！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960403
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731960403,
					"content": "如有贷款事务，请与您遇到的债务处理人详谈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
		{
			"id": 7319605,
			"completionStepIds": [
				7319605
			],
