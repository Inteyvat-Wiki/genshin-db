			"dialogs": [
				{
					"id": 731961401,
					"content": "关于普斯帕咖啡馆的所有权问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961402
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731961402,
					"content": "经查原店主于三年前在沙漠考察中失踪，现咖啡馆依照规定应收归上级部门伐护末那学院管理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961403
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731961403,
					"content": "裁判结果：因主张人撤诉，无限期中止执行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
