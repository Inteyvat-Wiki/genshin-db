			"dialogs": [
				{
					"id": 731961601,
					"content": "为了追求人生的幸福，离开家园，去开拓远方吧。现在就加入「冒险冢协会」，首月会费仅需五摩拉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961602
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731961602,
					"content": "真正的知识只有在实行中才能获得。即使在远行中离开世间，也比在苟活中蹉跎一生高贵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961603
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731961603,
					"content": "「大家看清楚，这个不是冒险家协会。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961604
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731961604,
					"content": "「什么！我都交了一年的会费了，我的钱还要得回来吗？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
