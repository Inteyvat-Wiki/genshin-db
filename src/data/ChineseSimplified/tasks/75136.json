				]
			},
			"dialogs": [
				{
					"id": 751360201,
					"content": "这是什么啦？虽然看起来造型和火磷石差不多，但是会发光还不停往外冒火，感觉比玻娜的火磷石厉害多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751360202,
					"content": "该不会说，这才是火磷石原本的样子？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751360203,
					"content": "好烫！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360204
					]
				},
				{
					"id": 751360204,
					"content": "#哇，{NICKNAME}，你不要看到什么宝贝就伸手去拿啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751360205,
					"content": "不知不觉就…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360206
					]
				},
				{
					"id": 751360206,
					"content": "派蒙没资格说我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360207
					]
				},
				{
					"id": 751360207,
					"content": "呀！呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360208
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751360208,
					"content": "#嗯？{REALNAME[ID(2)|SHOWHOST(true)]}对这个有什么头绪吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751360209,
					"content": "#哇，{REALNAME[ID(2)|SHOWHOST(true)]}好厉害，看这样子说不定终于到了你大显身手的地方了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751360210,
					"content": "#接下来要是再发现什么烫烫的宝物，就都可以拜托{REALNAME[ID(2)|SHOWHOST(true)]}了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751360211,
					"content": "噫，呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360212
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751360212,
					"content": "喂！呀嚯，这里这里！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360213
					],
					"speakerTitle": "玻娜"
				},
				{
					"id": 751360213,
					"content": "哇，那不是玻娜吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751360214,
					"content": "不过她怎么会在那里啦，该不会是直接落到了那…总之我们先过去和她会合吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
