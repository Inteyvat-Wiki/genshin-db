			},
			"dialogs": [
				{
					"id": 751360401,
					"content": "哎呀，没想到好不容易到了天蛇船还是要到处找石头，我还以为会是更紧张刺激的冒险呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360402
					],
					"speakerTitle": "玻娜"
				},
				{
					"id": 751360402,
					"content": "总之找火石的事情就拜托你们啦，有什么需要，随时招呼我就好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玻娜"
				}
			]
		},
