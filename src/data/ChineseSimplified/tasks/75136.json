						"position": [
							-306.442,
							1277.558,
							9810.905
						],
						"pointId": 8612
					}
				]
			},
			"dialogs": [
				{
					"id": 751360101,
					"content": "呼…总算是活、活下来了，脚踏实地的感觉真好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751360102,
					"content": "你明明一直是飘着的吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360103
					]
				},
				{
					"id": 751360103,
					"content": "喂，就算是这么说，飘在地面上和在天空上被大风刮得乱转还是有很大区别的吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751360104,
					"content": "这里看着也不太结实。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360105
					]
				},
				{
					"id": 751360105,
					"content": "#欸？你别吓我啊，一会要是真的掉下去的话，我一个人可拉不动你跟{REALNAME[ID(2)|SHOWHOST(true)]}两个！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751360106,
					"content": "叽咕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360107
					],
					"speakerTitle": "「绿松石」"
				},
				{
					"id": 751360107,
					"content": "那就是天蛇船吗？我们成功啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751360108,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360109
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751360109,
					"content": "虽然与其说船还不如说是个大毛线球！看起来缠缠绕绕的，倒确实很像蛇呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751360110,
					"content": "我们想办法去到那边吧，至少那里看上去要比这边安全一些…唔，也不知道玻娜去了哪里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751360111,
					"content": "虽然她说自己的飞行经验很丰富啦，不过还是有点担心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751360112,
					"content": "只要风向没错的话…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360113
					]
				},
				{
					"id": 751360113,
					"content": "唔，你说的也有道理，如果风向没错的话，她一定也会落到这附近的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751360114,
					"content": "留在这里也没有答案。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360115
					]
				},
				{
					"id": 751360115,
					"content": "唔，你说的也有道理，在这里担心也没有什么用处，说不定她现在已经在天蛇船上面等我们了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751360116,
					"content": "那我们就先过去吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
