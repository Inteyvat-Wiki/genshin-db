			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"花散里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721000201,
					"content": "辛苦二位了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000202
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000202,
					"content": "噫！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000203,
					"content": "怎么又来了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000204
					]
				},
				{
					"id": 721000204,
					"content": "实在抱歉。有的事情，应该说是「习惯」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000205
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000205,
					"content": "不对！你怎么又在跟踪我们，还不来打个招呼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000206,
						721000207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000206,
					"content": "别这样说…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000208
					]
				},
				{
					"id": 721000208,
					"content": "啊，对不起。我一定是跑来跑去太累了…态度不好，真不好意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000209,
					"content": "不用在意。此处结界能成功解开，「大祓」的进度又推进了一些，实在多谢二位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000210
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000210,
					"content": "话说回来，「神樱大祓」究竟是怎么一回事呀？和你之前让我们做的「净化」，是一回事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000211,
						721000219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000211,
					"content": "稻城小姐也提到过…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000212
					]
				},
				{
					"id": 721000212,
					"content": "稻城？您所说的稻城，是名字叫弥里的巫女吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000213
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000213,
					"content": "名字好像叫萤美。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000214,
					"content": "也对。毕竟过了这么久…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000215
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000215,
					"content": "不过她说方法已经失传了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000216,
					"content": "啊…嗯…毕竟过了这么久…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000217
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000217,
					"content": "可以理解。这是可以理解的。毕竟过了这么久。我没有生气。没错，是我的记忆在擅自生气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000218
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000218,
					"content": "面具巫女小姐看起来很生气…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000224,
					"content": "…总而言之，神樱大祓是「净化」的仪式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000225
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000225,
					"content": "鸣神岛的雷樱，能够吸收大地中的污秽。但久而久之，污秽就会积累。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000226
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000226,
					"content": "如果积累得太多，雷樱可能就会枯萎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000227
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000227,
					"content": "所以，每隔一段时间，就需要对散布在鸣神岛五个地方的雷樱树根进行一次「小祓」，立下结界。通过这种方式，来赋予它们「离秽」的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000228
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000228,
					"content": "那「大祓」呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000229
					]
				},
				{
					"id": 721000229,
					"content": "当结界当中的污秽积累够多，就需要进行「大祓」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000230
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000230,
					"content": "嗯嗯，我知道了。进行「大祓」的时候，要取得镇物，打破树根的结界。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000231
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000231,
					"content": "您的理解能力相当优秀呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000232
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000232,
					"content": "那当然！哼哼，毕竟已经做了两次了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000233
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000233,
					"content": "那些像武士的怪物是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000234
					]
				},
				{
					"id": 721000234,
					"content": "现在会以这样的姿态现人了吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000235
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000235,
					"content": "那是污秽的化身。被镇物从树根中逼出来后，凝结成的模样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000236
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000236,
					"content": "以前…啊，我的意思是，根据记载，在过去，有的污秽会化作火车、犬神、黑玉、海坊主、蓑火之类的东西呢。而且也不一定全都是为害于人的。比如说，豆腐小僧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000237
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000237,
					"content": "火…火什么？豆腐？那、那些是什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000238
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000238,
					"content": "哎呀，现在的人已经不知道这些妖怪了吗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000239
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000239,
					"content": "？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000240
					]
				},
				{
					"id": 721000240,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000241
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000241,
					"content": "现在，基本都变成了凶恶的落武者吗…稻妻到底发生了什么事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000242
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000242,
					"content": "……那个，如果没有进行「大小祓」，枯萎了的话…会怎么样呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000243
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000243,
					"content": "我记得…不是，据记载，几百年前，雷樱差一点都枯萎了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000244
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000244,
					"content": "当时魔物肆虐。连大海也变成了黑色。雷樱很努力、很努力地吸收邪秽的气息，最后几乎全都枯死了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000245
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000245,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000246
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000246,
					"content": "后来呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000247
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000247,
					"content": "后来的事情…我不太清楚。真的很对不起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000248
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000248,
					"content": "从结果来看，问题似乎是解决了。仍然有人执行了「大祓」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000249,
						721000250
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000249,
					"content": "之前提到说有五个地方…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000251
					]
				},
				{
					"id": 721000251,
					"content": "多亏您的努力，已经有两处树根的结界解开了。 那么，接下来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000252
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000252,
					"content": "二位经历了这么多，想必已经又累又饿。我准备了一些菜肴，希望不嫌弃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000253
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000253,
					"content": "哇，看上去很美味！虽然戴着面具，但你果然是全稻妻最好的巫女姐姐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000254,
						721000255
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000254,
					"content": "全稻妻最好的巫女姐姐！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000256
					]
				},
				{
					"id": 721000256,
					"content": "那么，还请慢用…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000257
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000257,
					"content": "真好吃！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000258,
						721000259
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000258,
					"content": "真的吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000260
					]
				},
				{
					"id": 721000260,
					"content": "欸…仔细一想，虽然刚刚吃得很开心，现在感觉又好像什么也没吃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000261
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000261,
					"content": "该不会是…面具巫女小姐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000262,
						721000264
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000262,
					"content": "…下毒？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000263
					]
				},
				{
					"id": 721000263,
					"content": "我怎么可能对二位做出这种事情！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000266
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000266,
					"content": "总之，请毋须担心。这是用从妖狸一族那偷学来的法术，做出来的菜肴。对二位绝对没有坏处。一般来说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000267,
						721000268
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000267,
					"content": "「一般来说」…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000269
					]
				},
				{
					"id": 721000269,
					"content": "之所以请您屈尊吃如此可疑…可口的食物，当然是为了治愈剩下的「树根」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000270
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000270,
					"content": "镇守之森中，藏着镇物与需要净化的树根。而在镇守之森深处，似乎有个老朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000271
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000271,
					"content": "「似乎」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000272
					]
				},
				{
					"id": 721000272,
					"content": "因为是很久以前的事情了。我不太清楚，他是否还记得我。或者说，会不会恨我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000273
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000273,
					"content": "他没办法自由行动，也没办法与人交流。吃了这个以后，就可以和他交流了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000274
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000274,
					"content": "那位故友，多少应该能为您提供帮助吧。所以，为了「神樱大祓」，这是必须的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000275
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000275,
					"content": "二位已经两次展示了自己的气量、情义，以及不俗的身手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000276
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000276,
					"content": "想来为了这片土地的安康利好，也一定会继续前进的，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000277
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000277,
					"content": "嗯！既然面具巫女小姐都这么说了，那就当做是完成任务必须采取的行动吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000278,
						721000279
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000278,
					"content": "我觉得你们在一起糊弄我…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000280
					]
				},
				{
					"id": 721000280,
					"content": "喂！你怎么会有这种想法！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000281
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000281,
					"content": "其他的树根呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000282
					]
				},
				{
					"id": 721000282,
					"content": "除了镇守之森，有一处树根在名为「荒海」的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000283
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000283,
					"content": "不知道荒海现在还有没有人居住呢。很久没去过那了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000284
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000284,
					"content": "最后一个…是在神里家的院子外面，向东北望过去的滩涂上，有一处地穴。树根就在里面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000285
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000285,
					"content": "那么，「神樱大祓」就拜托了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000286,
						721000287
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000286,
					"content": "等一等。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000288
					]
				},
				{
					"id": 721000288,
					"content": "请说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000289
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000289,
					"content": "刚刚在荒废神社里，我们透过「留念镜」看到了和面具巫女小姐一样的人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000290
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000290,
					"content": "名字好像是叫「花散里」…欸？你就是「花散里」吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000291
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000291,
					"content": "确实如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000292
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000292,
					"content": "我、我被骗了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000293,
						721000294
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000293,
					"content": "她一开始就说过了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000295
					]
				},
				{
					"id": 721000295,
					"content": "总、总之，那是怎么一回事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000296
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000296,
					"content": "我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000297
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000297,
					"content": "万分抱歉，我绝没有隐瞒之意。只是一直没有解释的机会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000298
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000298,
					"content": "现在也不是合适的时机。真的很抱歉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000299
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000299,
					"content": "嗯…好吧！我明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000300
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000300,
					"content": "等面具巫女小姐你有机会，再告诉我们吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000416
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000416,
					"content": "#对吧，{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000417,
						721000418
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000417,
					"content": "没错。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000419
					]
				},
				{
					"id": 721000419,
					"content": "非常感谢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000420
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000420,
					"content": "还有一件事。先前二位所说的「留念镜」，指的究竟是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000421
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000421,
					"content": "那、那面镜子，竟然被弘嗣那个家伙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000422
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000422,
					"content": "怎、怎么了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000423
					]
				},
				{
					"id": 721000423,
					"content": "……呼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000424
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000424,
					"content": "真是失态，请二位原谅。那么，请好好保管好这个…「留念镜」。那可是十分宝贵的器物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000425,
						721000426
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000425,
					"content": "我、我明白了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000427
					]
				},
				{
					"id": 721000427,
					"content": "真的！十分宝贵的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000428
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000428,
					"content": "一定妥当保管…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000429
					]
				},
				{
					"id": 721000429,
					"content": "有不少地方都有细小的狐狸雕像，它们叫「地狐」，是旧日的伙伴。有它们在的地方，通过「留念镜」，应该可以唤来过去的景象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000430
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000430,
					"content": "如果对您的冒险有所裨益，还请您多多发挥「留念镜」的作用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000431
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000431,
					"content": "我们会好好用它的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000432
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000432,
					"content": "好好用之余，一定要保护好它！不要磕碰，要按时清洁！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000433
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000433,
					"content": "明、明白了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000434
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000434,
					"content": "那就好。那么，就请允许我与二位暂且别过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000435
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000435,
					"content": "我们要怎么会合…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000436
					]
				},
				{
					"id": 721000436,
					"content": "「绯樱若解别离苦，自当常留驻。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000437
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000437,
					"content": "我们的命运一定会如同「绯樱绣球」那样，汇聚在一起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000438
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000438,
					"content": "在那之前，我会在绀田村井下，您成功净化的雷樱树根处，为您祈福。祝您一切顺利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000426,
					"content": "请、请相信我…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000427
					]
				},
				{
					"id": 721000418,
					"content": "虽然我还是很在意…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000419
					]
				},
				{
					"id": 721000294,
					"content": "只有你一直叫她「面具巫女」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000295
					]
				},
				{
					"id": 721000287,
					"content": "还有一个问题…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000288
					]
				},
				{
					"id": 721000279,
					"content": "我觉得派蒙被轻易糊弄了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000280
					]
				},
				{
					"id": 721000268,
					"content": "那为什么…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000269
					]
				},
				{
					"id": 721000264,
					"content": "…妖术？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000265
					]
				},
				{
					"id": 721000265,
					"content": "您对妖异之事的味蕾，似乎很灵敏呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000266
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000259,
					"content": "感觉好像有点违和…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000260
					]
				},
				{
					"id": 721000255,
					"content": "派蒙确实饿了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000256
					]
				},
				{
					"id": 721000250,
					"content": "接下来，我们应该去哪…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000251
					]
				},
				{
					"id": 721000219,
					"content": "有本《神樱大祓要略》…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000220
					]
				},
				{
					"id": 721000220,
					"content": "根本看不懂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000221,
					"content": "现在的人都看不懂了吗？明明是用通行的书面语言写的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000222
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000222,
					"content": "现在的人？喂，你到底多大岁数呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000223,
					"content": "这、这种问题，可真是失礼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000224
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000207,
					"content": "她一定有难处吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000208
					]
				}
			]
		},
		{
			"id": 7210003,
			"completionStepIds": [
				7210009
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7210009",
							"2"
						],
						"stepId": 7210009,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7210004",
							"3"
						],
						"stepId": 7210004,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"花散里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721000301,
					"content": "相当漂亮，无论是五百藏的障眼法，还是您击败妖物的手段。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000302
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000302,
					"content": "「噫！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000303,
					"content": "…我本想这么说，但其实已经习惯了。面具巫女小姐可真没新意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000304,
					"content": "这样啊。让您失望了，非常抱歉。下次我会加油的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000305
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000305,
					"content": "别在这种事情上加油…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000306
					]
				},
				{
					"id": 721000306,
					"content": "说得也是。那么，五百藏…他是否还安好呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000307,
						721000309
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000307,
					"content": "很有精神…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000308
					]
				},
				{
					"id": 721000308,
					"content": "虽然变成了石头。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000311,
					"content": "原来是这样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000312
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000312,
					"content": "一般来说，妖狸作乱这种事情，只要不太过火，是不会派人去专门退治的。毕竟妖狸一族虽然顽皮，但心地善良单纯，和小孩子一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000313
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000313,
					"content": "但是，连「大祓」所需的镇物也敢偷，那确实会受到惩罚呢。听你们的说法，既然是「影向役者三人组」，那多半是惟神…过去一名阴阳师下的手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000314,
						721000315
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000314,
					"content": "他提到「臭狐狸」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000316
					]
				},
				{
					"id": 721000316,
					"content": "面具巫女小姐，你是五百藏的狐狸朋友吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000317,
					"content": "…您真是太抬举我了。他说的是白辰血脉的女儿，被人们称为「狐斋宫」，过去在一些地方贵为祭神的仙狐呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000318
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000318,
					"content": "「天狐」与「地狐」都曾是她的使者。在她离开后，天狐地狐都纷纷化作石像，保存力量，等待她回来时，能再度与她在白狐之野的草野中漫步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000319
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000319,
					"content": "如今在鸣神岛行走的狐狸，因为没了她，所以血脉与灵性都只有当时的狐狸不足一分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000320
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000320,
					"content": "五百藏说「胜负还没分清」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000321
					]
				},
				{
					"id": 721000321,
					"content": "那件事啊，是这样的。您可知道，五百藏的全名是「隐神保生司正五百藏」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000322
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000322,
					"content": "五百藏虽然愚钝、顽皮，但却又忠诚善良。所以从很久之前开始，「狐斋宫」就想要让他走上正道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000323
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000323,
					"content": "「狐斋宫」以前为了让他服从雷神大人的管束，设计了二人，设法让五百藏被封为「保生司正」，管理镇守之森的安泰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000324
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000324,
					"content": "所以，当天地变得漆黑时，「狐斋宫」担心五百藏为了守护森林，会挺身与绝对无法抗衡的强敌战斗，并因此死去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000325
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000325,
					"content": "于是，就故意用妖狸擅长的「捉迷藏」挑战他…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000326
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000326,
					"content": "「五百藏，一定一定…无论发生什么事，都是我引诱你的法术。千万不要被骗、不要现身。」她说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000327
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000327,
					"content": "「那当然，臭狐狸。这次吾辈一定会胜过你，让你输得心服口服。」五百藏说。于是，这场没有结束的比试就开始了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000328
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000328,
					"content": "…所以，五百藏还在等着狐狸回去找到他，对吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000329
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000329,
					"content": "根据您从五百藏那听来的故事，应该是这样的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000330
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000330,
					"content": "等了一段时间后，五百藏感觉不对，就到处大闹。为了引出「狐斋宫」，甚至把镇物给偷走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000331
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000331,
					"content": "他不知道这是「神樱大祓」需要的物什，只是以为这把梳子对于「狐斋宫」而言很重要。后来，就因此被惟神封在了石头中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000332
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000332,
					"content": "那「狐斋宫」呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000333
					]
				},
				{
					"id": 721000333,
					"content": "…被黑暗吞噬了。最后，在黑暗被斩落后，随着污泥一同回归鸣神的大地了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000334
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000334,
					"content": "那你又是谁？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000335
					]
				},
				{
					"id": 721000335,
					"content": "我？如您所见，我是「花散里」，不过是一名希望能借助您的力量，祓除妖邪的巫女罢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000336
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000336,
					"content": "不是这个问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000337
					]
				},
				{
					"id": 721000337,
					"content": "面具…花散里小姐，之前我就觉得很奇怪，你知道很多一般人不知道的，过去的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000338
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000338,
					"content": "甚至会妖狸的法术，能做出狸猫的饭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000339
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000339,
					"content": "对现在的事情却不太了解。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000340
					]
				},
				{
					"id": 721000340,
					"content": "简直就像从几百年前过来的人一样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000341
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000341,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000342
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000342,
					"content": "之前我们在回忆中也见到了与你相似，名字也一样的人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000343
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000343,
					"content": "所以说…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000344
					]
				},
				{
					"id": 721000344,
					"content": "你其实和五百藏一样，是几百年前被封印的妖狸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000345
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000345,
					"content": "不、不是这样的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000346
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000346,
					"content": "我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000347
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000347,
					"content": "我继承了她的记忆。但别的事情，请二位原谅，现在还没到说的时候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000348
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000348,
					"content": "此前在那处洞窟中，我承诺过。当时机来临时，会将一切和盘托出。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000349
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000349,
					"content": "#怎么办，{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000350,
						721000351
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000350,
					"content": "我相信她。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000352
					]
				},
				{
					"id": 721000352,
					"content": "嗯嗯，既然你这么说了，那我也相信面具巫女小姐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000353
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000353,
					"content": "感谢您的谅解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000354
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000354,
					"content": "那么，我们暂且在此别过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000355
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000355,
					"content": "再见。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000356
					]
				},
				{
					"id": 721000356,
					"content": "「别离只此身，心随白云流。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000357
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000357,
					"content": "我会在绀田村井下，您成功净化的雷樱树根处，为您祈福。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000358
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000358,
					"content": "当所有的五处树根都得到净化后，请到那来找我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000351,
					"content": "那就这样吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000352
					]
				},
				{
					"id": 721000315,
					"content": "你的狐狸面具…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000316
					]
				},
				{
					"id": 721000309,
					"content": "被变成了石头…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000310
					]
				},
				{
					"id": 721000310,
					"content": "但很有精神呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000311
					],
					"speakerTitle": "派蒙"
				}
			]
		},
