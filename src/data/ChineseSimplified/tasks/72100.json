			"trigger": {
				"objectNames": [
					"花散里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721000101,
					"content": "真是相当了不起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000102
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000102,
					"content": "噫！你怎么…什么时候…为什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000103,
					"content": "噫！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000104
					]
				},
				{
					"id": 721000104,
					"content": "我果然没看错人，您确实有「净化」的资质。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000105,
						721000107
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000105,
					"content": "你为什么会在这里…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000106
					]
				},
				{
					"id": 721000106,
					"content": "我很关心您的行动，以及您能否治愈「树根」，所以多少观察了一下二位的行动。如有冒昧，还请您多多海涵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000110
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000110,
					"content": "您能够解开结界，真是帮了大忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000111
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000111,
					"content": "既然她一直在观察我们，也就是说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000112,
						721000116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000112,
					"content": "你会去报官吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000113
					]
				},
				{
					"id": 721000113,
					"content": "报官？您是指？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000114
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000114,
					"content": "绀田村的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000115,
					"content": "是说，绀田村的人为了村子，所隐瞒的事情吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000117
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000117,
					"content": "我所效忠的是鸣神岛的土地，而非奉行所。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000118
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000118,
					"content": "况且她…我与绀田村也有长久的交情。倘若那些家系因此断绝了，我也无颜面对…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000119
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000119,
					"content": "…失礼了。那么，言归正传。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000120
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000120,
					"content": "您或许知道，雷樱树象征着雷神的永恒守望，有着祓邪、净化地脉的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000121
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000121,
					"content": "但疏导污染的树根久而久之也会被侵蚀，受污染的部分陆续结成肿瘤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000122
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000122,
					"content": "因此，我们需要进行净化仪式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000123
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000123,
					"content": "但是，以我的…身体状况，无法完成这样的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000124
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000124,
					"content": "类似这样的结界还有几处。如何，能请您助我——不，是助这片大地，一臂之力吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000125,
						721000128
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000125,
					"content": "你的身体状况…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000126
					]
				},
				{
					"id": 721000126,
					"content": "毋须担心…当务之急，仍是净化之事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000127
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000127,
					"content": "明白了，我会帮忙的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000129
					]
				},
				{
					"id": 721000129,
					"content": "…非常感谢您能这样出手相助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000130
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000130,
					"content": "至于下一处「结界」的位置，您可以去附近的荒废神社看看。在绀田村东北边不远的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000131
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000131,
					"content": "碍于一些状况，我恐怕无法与您同行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000132
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000132,
					"content": "我们要怎么会合…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000133
					]
				},
				{
					"id": 721000133,
					"content": "「东岸西岸之樱，迟速不同。南枝北枝之花，开落已异。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000134
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000134,
					"content": "但这座岛上的一切都在她…都在「神樱」的荫蔽之下。这座岛上仍有花瓣如雪般飘落，我一定有幸能与您再会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000135
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000135,
					"content": "祝您一切顺利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000128,
					"content": "我来帮忙吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000129
					]
				},
				{
					"id": 721000116,
					"content": "传助爷爷隐瞒的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000117
					]
				},
				{
					"id": 721000107,
					"content": "你究竟是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000108
					]
				},
				{
					"id": 721000108,
					"content": "我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000109
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000109,
					"content": "如您所见，我不过是一名希望能借助您的力量，祓除妖邪的巫女罢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000110
					],
					"speakerTitle": "花散里"
				}
			]
		},
		{
			"id": 7210002,
