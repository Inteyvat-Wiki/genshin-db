				"objectNames": [
					"花散里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721000401,
					"content": "您好。我们又见面了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000402
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000402,
					"content": "虽然我们暂且不能在阳光下再会之事令人叹惋，但身边的象征着神明的雷樱与您的光采也足以照亮这一方空间了。如果我有能帮上您的事情的话，请您尽管开口。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000403,
						721000407,
						721000410,
						721000413
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000403,
					"content": "关于其他的结界…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000405
					]
				},
				{
					"id": 721000405,
					"content": "除了镇守之森，有一处结界在名为「荒海」的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000406
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000406,
					"content": "最后，在神里家的院子外面，向东北望过去的滩涂上，有一处地穴。最后一处结界就在里面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000407,
					"content": "找不到镇物…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000408
					]
				},
				{
					"id": 721000408,
					"content": "过去，镇物是交由「天狐」看守的。但在…一切都变得不同以后，天狐与地狐渐渐不愿显灵，而是沉睡着等待她有朝一日再度现身。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000409
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000409,
					"content": "如果要寻找镇物的话，就在封印的周边，找找「天狐」…也就是那种特殊的狐狸雕像吧。如果遇到了挫折，就试着找找周围的「地狐」，用那个镜子看看有没有什么线索吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000410,
					"content": "关于「留念镜」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000411
					]
				},
				{
					"id": 721000411,
					"content": "关于这个，恐怕我所知的并不比您多多少。除了柊家的人暴殄天物之事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000412
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000412,
					"content": "在鸣神岛各处，应该沉睡着不少「地狐」。呈现在您眼前的，恐怕是小小的、特别的小狐狸像。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000439
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000439,
					"content": "在过去，它们的力量虽然薄弱，却相当珍重情谊。透过那个…「留念镜」观察它们的话，您多少也能见到过去的事物、景象吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000413,
					"content": "再见。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000414
					]
				},
				{
					"id": 721000414,
					"content": "「心随白云流…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000415
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000415,
					"content": "如果有我能帮上忙的地方的话，请不必多虑，尽管说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "花散里"
				}
			]
		},
