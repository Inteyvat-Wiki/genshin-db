			"dialogs": [
				{
					"id": 728120201,
					"content": "好了，故事就到此结束了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120202
					],
					"speakerTitle": "顺吉"
				},
				{
					"id": 728120202,
					"content": "我从来没这么累过，这故事真的有这么复杂吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120203
					],
					"speakerTitle": "顺吉"
				},
				{
					"id": 728120203,
					"content": "这就是你不事先定好设定的下场。没有设定束缚，故事里的所有元素都会乱七八糟地撞来撞去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120204
					],
					"speakerTitle": "阿茂"
				},
				{
					"id": 728120204,
					"content": "在这种情况下，你对故事压根没有任何掌控力，无论写什么剧情都会累个半死。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120205
					],
					"speakerTitle": "阿茂"
				},
				{
					"id": 728120205,
					"content": "唉，我没力气和你争了…旅行者，谢谢您做出的这些…判断。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120206
					],
					"speakerTitle": "顺吉"
				},
				{
					"id": 728120206,
					"content": "这些判断实在是让我…获益匪浅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120207
					],
					"speakerTitle": "顺吉"
				},
				{
					"id": 728120207,
					"content": "这些谢礼请您收下，我等会就回去接着写小说去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120208
					],
					"speakerTitle": "顺吉"
				},
				{
					"id": 728120208,
					"content": "设定和剧情，唉…到底哪个比较重要呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "顺吉"
				}
			]
		}
