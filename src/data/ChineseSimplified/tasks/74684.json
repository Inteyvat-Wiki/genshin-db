				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"兰吉特"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 746840101,
					"content": "这阵子真是辛苦两位了，虽然最后多少偏离了最初的目的，但是对我来说，也是一段收获颇丰的经历。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746840102,
						746840103
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 746840102,
					"content": "真是酣畅淋漓的战斗啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746840104
					]
				},
				{
					"id": 746840104,
					"content": "收获颇丰…应该说学到教训才对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746840105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746840105,
					"content": "也是。建立友谊毕竟是一件长期的事，应该选定一个对象之后在它一个身上花费更多时间，而不是像这次这样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746840106
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 746840106,
					"content": "就像纳塔原本是属于古龙的国度，到现在这样人和龙能够彼此信任，结成伙伴，共同生活，中间不知经过了多少时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746840107
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 746840107,
					"content": "唉，还是我这急性子不好。我原以为它们会对能击败它们的对手有些敬意，所以才用上了这么粗暴的手段。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746840108
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 746840108,
					"content": "要是一开始就多花些时间，比如说每天给它们喂食，再慢慢接近的话，说不定成功率会高很多呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746840109
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 746840109,
					"content": "道理听上去是对的，但是你挑选的那些对象可不是什么小猫小狗啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746840110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746840110,
					"content": "是啊，在我看来，它们都和纳塔的龙有些相似的地方，所以我才会选择它们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746840111
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 746840111,
					"content": "想着这样之后给纳塔朋友讲述这些经历的时候，他们也更容易理解我做到了多么了不起的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746840112
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 746840112,
					"content": "虽然我是没看出来它们和纳塔的龙哪里像了…哦，除了古岩龙蜥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746840113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746840113,
					"content": "欸？其他的也有相似之处吧，比如说颜色之类…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746840114
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 746840114,
					"content": "那照你这么说，就连史莱姆也和纳塔的龙有相似之处啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746840115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746840115,
					"content": "唔，史莱姆是元素生物，龙也是元素生物，倒也不是全无道理。说不定史莱姆也有成为龙的潜力…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746840116
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 746840116,
					"content": "这样说来，我是不是应该先和史莱姆交上朋友？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746840117,
						746840119
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 746840117,
					"content": "计划的规模突然变小了许多。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746840118
					]
				},
				{
					"id": 746840118,
					"content": "感觉实现的难度也低了不少呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746840121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746840121,
					"content": "哈哈，不管怎么说，凡事总得试试！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746840122
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 746840122,
					"content": "这次多谢两位的协助，希望今后有机会见面的时候，我也有了冒险伙伴，能够称得上是冒险故事的「主角」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746840123
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 746840123,
					"content": "也祝你们旅途愉快！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 746840119,
					"content": "至少史莱姆比较安全。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746840120
					]
				},
				{
					"id": 746840120,
					"content": "只是相对来说吧？毕竟在野外也不是没见过被史莱姆围住就动弹不得的新手冒险家和普通行路人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746840121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746840103,
					"content": "总觉得你挑的对手格外强悍…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746840104
					]
				}
			]
		}
	]
}