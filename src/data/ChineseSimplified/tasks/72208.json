			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"伊部"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722080101,
					"content": "呵呵，虽然钓技不错，但还有提高空间哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080102,
						722080103
					],
					"speakerTitle": "伊部"
				},
				{
					"id": 722080102,
					"content": "欸？！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080104
					]
				},
				{
					"id": 722080104,
					"content": "哎呀，对不起，对不起…总是忘了打招呼，忘记自己会吓到别人…呵呵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080105
					],
					"speakerTitle": "伊部"
				},
				{
					"id": 722080105,
					"content": "居然还一副乐在其中的样子…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080106
					]
				},
				{
					"id": 722080106,
					"content": "没办法嘛，偶尔吓唬一下小孩子还是挺好玩的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080107
					],
					"speakerTitle": "伊部"
				},
				{
					"id": 722080107,
					"content": "咳咳，我们说回钓鱼的事情吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080108,
						722080109
					],
					"speakerTitle": "伊部"
				},
				{
					"id": 722080108,
					"content": "是正事吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080110
					]
				},
				{
					"id": 722080110,
					"content": "说来丢人，是这样的啦…先前在钓鱼时，我不小心遗落了牧梨交给我的护身符…里面有着她的祖灵与雷鸟大人的祝福。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080111
					],
					"speakerTitle": "伊部"
				},
				{
					"id": 722080111,
					"content": "这么重要的东西，如果登船时让她知道我给搞丢了可就不得了了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080112
					],
					"speakerTitle": "伊部"
				},
				{
					"id": 722080112,
					"content": "金色的撑船人答应会寻人来帮我一起找…可是等到现在都没有人影…我就想，既然你来了，也请拜托帮帮我吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080113,
						722080114
					],
					"speakerTitle": "伊部"
				},
				{
					"id": 722080113,
					"content": "之前还以为你挺可靠的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080115
					]
				},
				{
					"id": 722080115,
					"content": "我经常钓鱼的地点就在那边…可是记忆越来越稀薄了，可能要麻烦你多找一找…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080116,
						722080117
					],
					"speakerTitle": "伊部"
				},
				{
					"id": 722080116,
					"content": "既然是旧日记忆中的场所…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080118
					]
				},
				{
					"id": 722080118,
					"content": "唔…你说什么？那是外人用来寻找地点的方法吗…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080119
					],
					"speakerTitle": "伊部"
				},
				{
					"id": 722080119,
					"content": "唉…总之，如果找对地方的话，直接就地搜寻就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080120
					],
					"speakerTitle": "伊部"
				},
				{
					"id": 722080120,
					"content": "我该怎么搜寻？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080121
					]
				},
				{
					"id": 722080121,
					"content": "呃…用钓的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080122
					],
					"speakerTitle": "伊部"
				},
				{
					"id": 722080122,
					"content": "…行吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080123
					]
				},
				{
					"id": 722080123,
					"content": "雷鸟大人和祖灵护佑你！拜托你了，外人朋友！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊部"
				},
				{
					"id": 722080117,
					"content": "用「羽毛」应该可以看到吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080118
					]
				},
				{
					"id": 722080114,
					"content": "真拿你没办法…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080199
					]
				},
				{
					"id": 722080199,
					"content": "在逢岳之野西边，面对着三重瀑布的小岛…就在那小岛更西边的海里了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080115
					],
					"speakerTitle": "伊部"
				},
				{
					"id": 722080109,
					"content": "这人怎么还在想着钓鱼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080110
					]
				},
				{
					"id": 722080103,
					"content": "请你先打招呼再出现！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080104
					]
				}
			]
		},
