			"dialogs": [
				{
					"id": 722080201,
					"content": "谢谢你！现在我终于可以放心登船了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080202
					],
					"speakerTitle": "伊部"
				},
				{
					"id": 722080202,
					"content": "那船是去往哪里的…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080203
					]
				},
				{
					"id": 722080203,
					"content": "金的土地，梦的土地。没有迷雾的国度…我们会在睡梦中再见，朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊部"
				}
			]
		},
