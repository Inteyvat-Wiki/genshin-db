				{
					"id": 722080401,
					"content": "你回来了！请问找到护身符了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080402
					],
					"speakerTitle": "伊部"
				},
				{
					"id": 722080402,
					"content": "我还在努力。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080403
					]
				},
				{
					"id": 722080403,
					"content": "这样啊，不必着急，也请你注意安全。岛外来的朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080404
					],
					"speakerTitle": "伊部"
				},
				{
					"id": 722080404,
					"content": "在逢岳之野西边，面对着三重瀑布的小岛…我要的东西就在那小岛更西边的海里呢…",
					"roleType": "TALK_ROLE_NPC",
