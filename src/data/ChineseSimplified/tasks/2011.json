				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"北斗"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20110301,
					"content": "哟，你们终于来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110302
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20110302,
					"content": "过去连暴风雨都没法让「南十字船队」耽搁，这次我可是给足了你们面子啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110303,
						20110304
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20110303,
					"content": "久等了，大姐头。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110305
					]
				},
				{
					"id": 20110305,
					"content": "哈哈哈，玩笑话而已。你们来得正好，出海工作刚刚就绪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110306
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20110306,
					"content": "既然人都到齐了，也是时候——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110307
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20110307,
					"content": "朝着雷霆骤雨所包围的「永恒」国度，起航！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110308
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20110308,
					"content": "出发！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20110304,
					"content": "荣幸之至！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110305
					]
				}
			]
		},
		{
			"id": 201107,
			"completionStepIds": [
				201107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201107",
							"2"
						],
						"stepId": 201107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"托马"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20110701,
					"content": "终于来了，「璃月人的大姐头」，可让我好等。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110702
					],
					"speakerTitle": "托马"
				},
				{
					"id": 20110702,
					"content": "还有这两位偷渡客…哦不，贵客。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110703
					],
					"speakerTitle": "托马"
				},
				{
					"id": 20110703,
					"content": "嘘！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110704
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20110704,
					"content": "还不是因为你们的将军大人，最近稻妻外海的雷暴和风浪比之前还要强烈了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110705
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20110705,
					"content": "我的船队尽管大显身手了一番，但还是耽误了些时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110706
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20110706,
					"content": "哦对了，给你们介绍一下，这位是托马，算是我最近才熟络的商业伙伴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110707
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20110707,
					"content": "哟，我一直很期待见到你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110708
					],
					"speakerTitle": "托马"
				},
				{
					"id": 20110708,
					"content": "托马，这两位是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110709
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20110709,
					"content": "不用介绍了，异乡旅人的名望，可是外海的暴风雨都拦不住的，早就如雷贯耳了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110710,
						20110711
					],
					"speakerTitle": "托马"
				},
				{
					"id": 20110710,
					"content": "你好，托马。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110712
					]
				},
				{
					"id": 20110712,
					"content": "你说话真好听，嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110713
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20110713,
					"content": "嗯，这样倒也方便了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110714
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20110714,
					"content": "#{NICKNAME}，托马在离岛混迹了很长一段时间了，说他是这里的地头蛇也不为过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110715
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20110715,
					"content": "如果有什么难处就找他吧，但如果他对你图谋不轨…等下次来稻妻，我会替你出头的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110716
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20110716,
					"content": "哈哈哈…放心放心，我预感我们会相处很愉快的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110717
					],
					"speakerTitle": "托马"
				},
				{
					"id": 20110717,
					"content": "那时间差不多了，毕竟我的船上还藏了个「通缉犯」，不方便久留。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110718
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20110718,
					"content": "是说万叶呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110719
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20110719,
					"content": "下次再见吧，旅行者，不管你在稻妻遇上什么「惊涛骇浪」，都要好好给我捱过去啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110720,
						20110721
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20110720,
					"content": "我可是自信满满。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110722
					]
				},
				{
					"id": 20110722,
					"content": "拜拜，一路顺风，北斗船长。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110723
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20110723,
					"content": "那么，还是先去监察站登记一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110724
					],
					"speakerTitle": "托马"
				},
				{
					"id": 20110724,
					"content": "欸，要去直面稻妻的官方人员吗？不是说偷偷地…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110725
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20110725,
					"content": "哈哈，可不要小瞧「锁国令」啊，查验身份的事，躲是躲不过的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110726
					],
					"speakerTitle": "托马"
				},
