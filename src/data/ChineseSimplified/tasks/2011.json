			"trigger": {
				"objectNames": [
					"凯瑟琳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20110101,
					"content": "旅行者，有什么可以帮你的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110102,
						20110103
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 20110102,
					"content": "关于前往稻妻的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110104
					]
				},
				{
					"id": 20110104,
					"content": "嗯，我听说了，你们和南十字船队的大姐头约好了，会带你们前往稻妻是吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110105
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 20110105,
					"content": "确实已经过去蛮久了，我这边倒也没有什么值得注意的情报…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110106
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 20110106,
					"content": "可找到你了！你就是大姐头看好的那个旅行者吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110107,
						20110109
					],
					"speakerTitle": "海龙"
				},
				{
					"id": 20110107,
					"content": "等你很久了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110108
					]
				},
				{
					"id": 20110108,
					"content": "是吗哈哈，可真是荣幸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110110
					],
					"speakerTitle": "海龙"
				},
				{
					"id": 20110110,
					"content": "我们船队的补给工作已经做得差不多了，到了清点人头的环节了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110111
					],
					"speakerTitle": "海龙"
				},
				{
					"id": 20110111,
					"content": "大姐头派我来找你，说等你一到就开船。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110112
					],
					"speakerTitle": "海龙"
				},
				{
					"id": 20110112,
					"content": "北斗果然是个很守约的人呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20110113,
					"content": "那是当然，大姐头身上让人死心塌地的地方可多得是，等出了航，你们就慢慢体会吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110114
					],
					"speakerTitle": "海龙"
				},
				{
					"id": 20110114,
					"content": "二位这就准备离开了吗？还是要恭喜你们呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110115
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 20110115,
					"content": "不论前路是星辰还是深渊，能向前迈出下一步都是值得庆贺的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110116
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 20110116,
					"content": "那我们就再见吧，祝你们一路顺风~！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110117,
						20110118
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 20110117,
					"content": "凯瑟琳小姐…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110119
					]
				},
				{
					"id": 20110119,
					"content": "是啊，有些舍不得，毕竟我们几乎天天都会见面呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20110120,
					"content": "呵呵，既然如此，到了稻妻就快点找到我哦？我会在鸣神岛等着你们的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110121,
						20110122
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 20110121,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110123
					]
				},
				{
					"id": 20110123,
					"content": "果然稻妻也有一个凯瑟琳小姐吗！那就不要这么郑重其事的告别啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20110124,
					"content": "哈哈，跟璃月好好道个别吧，船还停在孤云阁附近，既然通知到了你们，我就先回去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110125
					],
					"speakerTitle": "海龙"
				},
				{
					"id": 20110125,
					"content": "嗯，辛苦你跑一趟了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20110126,
					"content": "没事，咱们船上见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "海龙"
				},
				{
					"id": 20110122,
					"content": "…我就知道！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110123
					]
				},
				{
					"id": 20110118,
					"content": "我们会想念你的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110119
					]
				},
				{
					"id": 20110109,
					"content": "情报送上门来了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110110
					]
				},
				{
					"id": 20110103,
					"content": "关于南十字船队的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110104
					]
				}
			]
		},
		{
			"id": 201103,
			"completionStepIds": [
				201103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
