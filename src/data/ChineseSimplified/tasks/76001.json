			"trigger": {
				"objectNames": [
					"苏霍维赫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760010101,
					"content": "打扰一下！有件事想问问两位…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760010102,
					"content": "向两位执灯士出示了此前得到的物件，并讲述了与身着执灯人服饰的怪人并肩作战，击退狂猎的事…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760010103
					]
				},
				{
					"id": 760010103,
					"content": "难道是西格德？他…直到现在也无法安息啊，要是我能更加…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010104
					],
					"speakerTitle": "卢什涅"
				},
				{
					"id": 760010104,
					"content": "别这么说，这不是你一个人的责任。只要狂猎尚存，他就不会停止战斗…我们所能做的，只有尽力完成自己的使命而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010105
					],
					"speakerTitle": "苏霍维赫"
				},
				{
					"id": 760010105,
					"content": "所以西格德他也曾经是执灯人的一员，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760010106,
					"content": "是的，他是了不起的执灯长。在狂猎的大军席卷挪德卡莱时，他英勇地战斗到了最后一刻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010107
					],
					"speakerTitle": "苏霍维赫"
				},
				{
					"id": 760010107,
					"content": "据说警铃响起时，失却了心智的魔物就像是为之胆寒一样，不敢贸然向前…没想到他的遗物会被两位找到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010108
					],
					"speakerTitle": "苏霍维赫"
				},
				{
					"id": 760010108,
					"content": "如果可以的话，请两位将遗物带去伦波岛东的战场遗址，带去他的墓前。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010109
					],
					"speakerTitle": "苏霍维赫"
				},
				{
					"id": 760010109,
					"content": "放心交给我们吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760010110
					]
				},
				{
					"id": 760010110,
					"content": "感谢。愿他的灵魂得以安息的那一日尽早到来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "苏霍维赫"
				}
			]
		},
