			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"维克多"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230110101,
					"content": "呃…这里该怎么雕来着…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110102,
						230110103
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 230110102,
					"content": "嗨！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110104
					]
				},
				{
					"id": 230110104,
					"content": "哎呀，谁啊，别吵我，我正…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110105
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 230110105,
					"content": "啊？！旅行者？！你怎么也来须弥了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110106
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 230110106,
					"content": "不会是鲁道夫那家伙派你来揍我的吧，我就是很久之前送了莉莉一点礼物而已啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110107,
						230110109
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 230110107,
					"content": "我只是旅行过来啦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110108
					]
				},
				{
					"id": 230110108,
					"content": "你还在旅行中啊，真是够有精力的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110112
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 230110112,
					"content": "不过，真没想到能在须弥遇见你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110113
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 230110113,
					"content": "我从蒙德被调走的时候，本来接到的命令是让我直接回至冬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110114
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 230110114,
					"content": "不过，半路上又来了一道新命令，让我来须弥城协助弗谢沃洛德先生的工作，还告知我，我已经被调到了「公鸡」大人手下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110115,
						230110116
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 230110115,
					"content": "「公鸡」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110117
					]
				},
				{
					"id": 230110117,
					"content": "对…呃，不行，我不能接着往下说了，不然弗谢沃洛德先生又要说我对保密工作不敏感了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110118
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 230110118,
					"content": "唉，这些执行官大人的名字又不是什么秘密，真不知道他为什么这么敏感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110119
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 230110119,
					"content": "你在须弥做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110120
					]
				},
				{
					"id": 230110120,
					"content": "哦，我和弗谢沃洛德先生主要负责的是协调后勤补给工作。简单来说，就是到处去采购啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110121
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 230110121,
					"content": "虽然听起来也不是很重要，但总比在蒙德教堂里一直发呆好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110122
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 230110122,
					"content": "嘿嘿，而且干这个活，在工作时有很多空闲时间，而且也没人一直盯着我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110123
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 230110123,
					"content": "我就把我小时候做木雕的手艺捡起来了，反正须弥木头多，正好练手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110124
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 230110124,
					"content": "没想到我雕的那些小玩意，居然还挺受孩子们喜欢的。这帮小毛孩一直吵着要，我就答应他们，给他们每个人都雕一个玩具。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110125,
						230110128
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 230110125,
					"content": "你是愚人众吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110126
					]
				},
				{
					"id": 230110126,
					"content": "是啊，怎么了？哎呀…谁规定愚人众就不能给孩子们送玩具了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110127
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 230110127,
					"content": "再说了，我现在就是个管后勤的，那些惊天动地的大事，就留给上面的大人们折腾去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110130
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 230110130,
					"content": "总之，我现在的情况就是这样啦，虽然没能回至冬，但我还挺喜欢须弥的，有吃有玩，环境也好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110131
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 230110131,
					"content": "工作完了之后，我就去买点吃的，然后找个阳光好的地方雕我的木雕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110132
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 230110132,
					"content": "虽然…哈哈，大家看我的表情都有点不信任，就和你第一次和我说话的时候一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110133
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 230110133,
					"content": "那也没办法，谁叫我是个愚人众呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110134,
						230110135
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 230110134,
					"content": "我现在也不信任你哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110136
					]
				},
				{
					"id": 230110136,
					"content": "行吧…总而言之，我对现在的生活还挺满意的，而且手头还有了点积蓄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110137
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 230110137,
					"content": "再这么过几年，说不定我就在须弥定居得了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110138
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 230110138,
					"content": "咳，不说了不说了。旅行者，既然你也来须弥了，那如果你有兴趣的话，咱们俩就继续「等量交换」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110139
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 230110139,
					"content": "不过，这次我没故事给你讲了，只能给你真金白银的报酬了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110140,
						230110141
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 230110140,
					"content": "这样更好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110143
					]
				},
				{
					"id": 230110143,
					"content": "好了，我来说明一下委托内容吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110144
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 230110144,
					"content": "我前几天找哈马维订了一批木头，但是他现在还没把货物给我送来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110145
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 230110145,
					"content": "现在我还在工作时间，也不敢直接去找他，不然弗谢沃洛德先生又要训我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110146
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 230110146,
					"content": "旅行者，你就帮我去找哈马维问问，我要的那一批木头什么时候到吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110147,
						230110149
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 230110147,
					"content": "报酬准备好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110148
					]
				},
				{
					"id": 230110148,
					"content": "你就放心吧，肯定准备好",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110151
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 230110151,
					"content": "总之，这件事就交给你了啊，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "维克多"
				},
				{
					"id": 230110149,
					"content": "你真没打什么鬼主意吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110150
					]
				},
				{
					"id": 230110150,
					"content": "我之前和你做交易的时候哪次打了鬼主意的，你就放心吧，我才懒得做那种麻烦事呢，舒舒服服地生活不好吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110151
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 230110141,
					"content": "这是「愚人众」的委托吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110142
					]
				},
				{
					"id": 230110142,
					"content": "当然不是，这只是「维克多」的委托。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110143
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 230110135,
					"content": "谁信任你了，别套近乎！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110136
					]
				},
				{
					"id": 230110128,
					"content": "你不会是想从孩子们嘴里套情报吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110129
					]
				},
				{
					"id": 230110129,
					"content": "喂！我不会做这种事的，你对愚人众到底有啥可怕的刻板印象啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110130
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 230110116,
					"content": "是另一位执行官？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110117
					]
				},
				{
					"id": 230110109,
					"content": "是啊，和我回蒙德！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110110
					]
				},
				{
					"id": 230110110,
					"content": "哈，哈，哈，好哦，那你要不要把我铐着带走？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110111
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 230110111,
					"content": "行了，不和你开玩笑了，我还有正事要办呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110112
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 230110103,
					"content": "维，维克多？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110104
					]
				}
			]
		},
