			"dialogs": [
				{
					"id": 230110601,
					"content": "怎么样，我买的木头已经到了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110602
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 230110602,
					"content": "向维克多叙述了事情的过程…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230110603
					]
				},
				{
					"id": 230110603,
					"content": "又是魔物？我怎么感觉全世界的货车都很容易被魔物袭击…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110604
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 230110604,
					"content": "算了，反正木头能送回来就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110605
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 230110605,
					"content": "喏，这是说好的报酬，好好数一数吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110606
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 230110606,
					"content": "还有…那个，莉莉还好吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110607
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 230110607,
					"content": "我走的时候也没和那丫头当面道别，她没生气吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110608,
						230110610
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 230110608,
					"content": "她很好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110609
					]
				},
				{
					"id": 230110609,
					"content": "那就行，咳…你别这么看着我，我就是关心一下啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110614
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 230110614,
					"content": "不说这些了，再数数报酬吧，旅行者，我可是一分都没少你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "维克多"
				},
				{
					"id": 230110610,
					"content": "你自己回去看看她呗。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110611
					]
				},
				{
					"id": 230110611,
					"content": "那弗谢沃洛德先生非得踢我不可，算了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110612
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 230110612,
					"content": "我也不太敢直接寄信过去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110613
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 230110613,
					"content": "收到一封来自愚人众的信，听起来就不像什么好事，哈哈哈…",
					"roleType": "TALK_ROLE_NPC",
