			"dialogs": [
				{
					"id": 230110301,
					"content": "真是倒霉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110302
					],
					"speakerTitle": "哈马维"
				},
				{
					"id": 230110302,
					"content": "关于维克多的木头…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110303
					]
				},
				{
					"id": 230110303,
					"content": "你是说那个愚人众找我订的木头吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110304
					],
					"speakerTitle": "哈马维"
				},
				{
					"id": 230110304,
					"content": "唉，别提了，我就说和愚人众做生意不会有好运气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110305
					],
					"speakerTitle": "哈马维"
				},
				{
					"id": 230110305,
					"content": "那批木头运到一半就被魔物袭击了，人是全跑回来了，但车毁了，木头都丢在了半路上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110306
					],
					"speakerTitle": "哈马维"
				},
				{
					"id": 230110306,
					"content": "唉，现在这情况，我是不敢过去了，一时半会也找不到人去赶走那些魔物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110308
					],
					"speakerTitle": "哈马维"
				},
				{
					"id": 230110308,
					"content": "我不是愚人众…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110309
					]
				},
				{
					"id": 230110309,
					"content": "你不是愚人众吗？那你怎么帮他做事？奇怪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110310
					],
					"speakerTitle": "哈马维"
				},
				{
					"id": 230110310,
					"content": "无论如何，那辆车我暂时是拉不回来了，我只能等到能雇到人之后再想办法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110311
					],
					"speakerTitle": "哈马维"
				},
				{
					"id": 230110311,
					"content": "如果你着急要木头的话，我把那辆车大概的地方给你标在地图上，你自己过去看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110312
					],
					"speakerTitle": "哈马维"
				},
				{
					"id": 230110312,
					"content": "唉，只要和愚人众沾边果然就遇不上好事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "哈马维"
				}
			]
