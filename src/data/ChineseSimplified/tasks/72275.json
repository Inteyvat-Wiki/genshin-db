				"points": []
			},
			"dialogs": [
				{
					"id": 722750401,
					"content": "边陲三角的试炼之地已经准备好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750402
					],
					"speakerTitle": "乌帽子"
				},
				{
					"id": 722750402,
					"content": "那么我来传达剩下三场试炼的线索吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750403
					],
					"speakerTitle": "乌帽子"
				},
				{
					"id": 722750403,
					"content": "请你在常夜之中，远望白夜国的边疆吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750404
					],
					"speakerTitle": "乌帽子"
				},
				{
					"id": 722750404,
					"content": "——「于昏冥的常世之夜中，于奔流的冥河之外，于无罪的天光流泻之处。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750405
					],
					"speakerTitle": "乌帽子"
				},
				{
					"id": 722750405,
					"content": "请你解开天光流泻之处的封印，升入天之门扉到达试炼之处。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750406
					],
					"speakerTitle": "乌帽子"
				},
				{
					"id": 722750406,
					"content": "天光流泻之处?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722750408
					]
				},
				{
					"id": 722750408,
					"content": "在夜晚可以看到自穹顶落下的三道光柱，这些光柱指向了天光流泻之处。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750410
					],
					"speakerTitle": "乌帽子"
				},
				{
					"id": 722750410,
					"content": "你说的有点太模糊了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722750411,
					"content": "抱歉，海祇大御神它写的台本就是这样的。语焉不详的指示也是试炼的老传统了嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750412
					],
					"speakerTitle": "乌帽子"
				},
				{
					"id": 722750412,
					"content": "总之试炼之处的地走官们都是怪人。没有通过传送门过去的话，他们是不会和气说话的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750413
					],
					"speakerTitle": "乌帽子"
				},
				{
					"id": 722750413,
					"content": "我唯有在这里恭候你踏破所有阻碍，取得所有认可之后归来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "乌帽子"
				}
			]
		}
	]
}