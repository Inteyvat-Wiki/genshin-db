			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"乌帽子",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722750101,
					"content": "此身既然已经显现，那血枝珊瑚应该已入海祇之手。让人欣慰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750102
					],
					"speakerTitle": "乌帽子"
				},
				{
					"id": 722750102,
					"content": "我名厄伯斯，稻妻式名字是乌帽子。乃是珊瑚宫之辅弼，渊下宫巫女中的一位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750103
					],
					"speakerTitle": "乌帽子"
				},
				{
					"id": 722750103,
					"content": "您应该就是取得珊瑚枝的勇者吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750104
					],
					"speakerTitle": "乌帽子"
				},
				{
					"id": 722750104,
					"content": "是我没错。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722750105
					]
				},
				{
					"id": 722750105,
					"content": "实在抱歉，我要讲述之事可能过于复杂，不知应该如何说起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750106
					],
					"speakerTitle": "乌帽子"
				},
				{
					"id": 722750106,
					"content": "你可以从头开始说，我们会听的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722750107,
					"content": "非常感谢。那么，就请容我为您稍事介绍吧。这要从海祇大御神打通海渊之门说起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750108
					],
					"speakerTitle": "乌帽子"
				},
				{
					"id": 722750108,
					"content": "渊下宫的深处有一处天然溶洞，便是通往海祇岛之路。也是海祇所许诺的地上乐土。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750109
					],
					"speakerTitle": "乌帽子"
				},
				{
					"id": 722750109,
					"content": "我们在大御神的授意下，学习了鸣神文化，并且曾与诸方土地建立了外交。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750110
					],
					"speakerTitle": "乌帽子"
				},
				{
					"id": 722750110,
					"content": "鸣神岛还称赞我们的「海祇美人」呢。因为我们海祇人肤质细嫩，可以令七种难隐的污痕都不再显眼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750111
					],
					"speakerTitle": "乌帽子"
				},
				{
					"id": 722750111,
					"content": "这种说法的来由呢，是因为我们和祖先都在渊下宫生活得不到日照…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750112,
						722750113
					],
					"speakerTitle": "乌帽子"
				},
				{
					"id": 722750112,
					"content": "说重点。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722750114
					]
				},
				{
					"id": 722750114,
					"content": "啊，抱歉。以前日子与诸国外交，我作为珊瑚宫之辅弼，经常担任向导。一不小心就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750115
					],
					"speakerTitle": "乌帽子"
				},
				{
					"id": 722750115,
					"content": "话说回来吧。我与珊瑚宫大人产生了分歧，在海祇大御神的调停之下，我们有了现在的这个方案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750116
					],
					"speakerTitle": "乌帽子"
				},
				{
					"id": 722750116,
					"content": "因为渊下宫有「罪影」这种现象，「过去」、「历史」、「真相」这种东西，放着不管也会永世长存。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750117
					],
					"speakerTitle": "乌帽子"
				},
				{
					"id": 722750117,
					"content": "所以我们费心尽力，并不是为了铭记，而是为了「遗忘」。很明显，珊瑚宫大人就是这么想的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750118
					],
					"speakerTitle": "乌帽子"
				},
				{
					"id": 722750118,
					"content": "（她说的珊瑚宫，应该是很久以前的珊瑚宫巫女吧…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722750119,
					"content": "取珊瑚枝的试炼，就是尽可能少地让后人接触事件全貌的设计。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750120
					],
					"speakerTitle": "乌帽子"
				},
				{
					"id": 722750120,
					"content": "而我则支持留下真相。因此海祇大御神许可我在此追加一道试炼，通过的话，就可以知晓秘密。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750121
					],
					"speakerTitle": "乌帽子"
				},
				{
					"id": 722750121,
					"content": "请您接受这个挑战吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750122,
						722750123
					],
					"speakerTitle": "乌帽子"
				},
				{
					"id": 722750122,
					"content": "我接受挑战。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722750124
					]
				},
				{
					"id": 722750124,
					"content": "如此甚好，那么我来为你启动追加的试炼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "乌帽子"
				},
				{
					"id": 722750123,
					"content": "我对秘密很感兴趣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722750124
					]
				},
				{
					"id": 722750113,
					"content": "怎么又是这话。说重点。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722750114
					]
				}
			]
		},
		{
			"id": 7227502,
			"completionStepIds": [
				7227506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7227506",
							"2"
						],
						"stepId": 7227506,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"乌帽子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722750201,
					"content": "如此您已经获得了所有地走官的认可。他们代行海祇之意志，因此你也获得了知道一切的权力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750202
					],
					"speakerTitle": "乌帽子"
				},
				{
					"id": 722750202,
					"content": "您是拯救海祇万民的救主，亦是海祇认可之人。您有权知晓任何您关心的问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750203
					],
					"speakerTitle": "乌帽子"
				},
				{
					"id": 722750203,
					"content": "但是请您遵守规矩，一定不要将这些真相带离海渊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750204
					],
					"speakerTitle": "乌帽子"
				},
				{
					"id": 722750204,
					"content": "你还有什么想知道的呢?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750205,
						722750206,
						722750207,
						722750208,
						722750209
					],
					"speakerTitle": "乌帽子"
				},
				{
					"id": 722750205,
					"content": "关于深海龙蜥…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722750210
					]
				},
				{
					"id": 722750210,
					"content": "深海龙蜥是原始的元素生物，因为久居深海，所以并没有被天上降临的力量降伏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750211
					],
					"speakerTitle": "乌帽子"
				},
				{
					"id": 722750211,
					"content": "它们其实非常聪明，而且擅长进化。在和我们战斗的历史里，甚至进化出了其他元素的品种。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750212
					],
					"speakerTitle": "乌帽子"
				},
				{
					"id": 722750212,
					"content": "如果它们学会了语言，甚至进化出蜥蜴人这种东西我都不会奇怪的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750213
					],
					"speakerTitle": "乌帽子"
				},
				{
					"id": 722750213,
					"content": "「圣土化」的本质，其实就是它们宜居环境的拓张。也就是三界中的原始元素力量变得强势。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750214
					],
					"speakerTitle": "乌帽子"
				},
				{
					"id": 722750214,
					"content": "我们唯有使用海祇大御神生命力，唤醒它的第二眷属，将荒蛮的元素力转化掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750204
					],
					"speakerTitle": "乌帽子"
				},
				{
					"id": 722750206,
					"content": "关于海祇大御神…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722750215
					]
				},
				{
					"id": 722750215,
					"content": "海祇大御神因为它的厄运，落入了「天之秩序」管辖之外的此处。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750216
					],
					"speakerTitle": "乌帽子"
				},
				{
					"id": 722750216,
					"content": "这件事毫无疑问是我等白夜国民的好运。它真的为了我们做了许多事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750217
					],
					"speakerTitle": "乌帽子"
				},
				{
					"id": 722750217,
					"content": "只不过也因为接触了我们，触碰了甚至在它诞生之前的真相。于是它被天京敕令，必须舍身成仁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750218
					],
					"speakerTitle": "乌帽子"
				},
				{
					"id": 722750218,
					"content": "此番献头，必须做到无人怀疑。唯有此法，白夜之民才能被允许活在新的「七之秩序」之下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750204
					],
					"speakerTitle": "乌帽子"
				},
				{
					"id": 722750207,
					"content": "关于日月之前的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722750219
					]
				},
				{
					"id": 722750219,
					"content": "白夜国落入海渊之前，确实整个世界都在统一的文化之下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750220
					],
					"speakerTitle": "乌帽子"
				},
				{
					"id": 722750220,
					"content": "后来发生了一场大战，天也倾覆，地也崩裂。这片土地在那时落下了漆黑的海渊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750221
					],
					"speakerTitle": "乌帽子"
				},
				{
					"id": 722750221,
					"content": "而后，天之秩序似乎并不想让记得这一切的人残留在大地之上。我们寻找归途，却怎么也找不到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750222
					],
					"speakerTitle": "乌帽子"
				},
				{
					"id": 722750222,
					"content": "直到很久以后，天之禁令的力量逐渐减弱了。海祇大御神掉入了这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750204
					],
					"speakerTitle": "乌帽子"
				},
				{
					"id": 722750208,
					"content": "关于大日御舆…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722750223
					]
				},
				{
					"id": 722750223,
					"content": "大日御舆是贤人·阿布拉克设计的建筑。它拥有为海渊之下带来光的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750224
					],
					"speakerTitle": "乌帽子"
				},
				{
					"id": 722750224,
					"content": "除此以外，还集成了很多功能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750225
					],
					"speakerTitle": "乌帽子"
				},
				{
					"id": 722750225,
					"content": "总之很厉害。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750204
					],
					"speakerTitle": "乌帽子"
				},
				{
					"id": 722750209,
					"content": "没有其他的事了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722750226
					]
				},
				{
					"id": 722750226,
					"content": "那么好的。请你务必记住，渊下宫所遇之事，请当成永远的秘密吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "乌帽子"
				}
			]
		},
		{
