			"dialogs": [
				{
					"id": 722750301,
					"content": "请您向地走官的常世之灵证明自己的勇武吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750302
					],
					"speakerTitle": "乌帽子"
				},
				{
					"id": 722750302,
					"content": "当你完成了所有挑战，我才能告诉你所有的秘密。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750303
					],
					"speakerTitle": "乌帽子"
				},
				{
					"id": 722750303,
					"content": "…唉，我像是个知道了点小秘密就忍不住想找人说的小姑娘似的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "乌帽子"
				}
			]
		},
		{
			"id": 7227504,
			"completionStepIds": [
				7227508
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
