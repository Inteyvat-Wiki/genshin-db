			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿倍良久",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722410201,
					"content": "啊啊…异乡的旅者，是汝啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410202
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410202,
					"content": "托汝之福，吾现在魂魄完全，已回想起了一切，真是不可思议。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410203
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410203,
					"content": "可能汝已知晓，长久以前，白夜国仅有一片黑暗，生活在此处的诸民深受深海龙嗣侵扰之害。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410204
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410204,
					"content": "那时，由吾主持建造大日御舆，从此白夜国才有了昼夜之替，也有了「白夜」这一国名。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410205
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410205,
					"content": "寓示：「自大日御舆建成之后，虽此地只有常世之夜，亦可因分黑白。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410206
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410206,
					"content": "真是令人汗颜，在离魂归位之前，竟连大日御舆建成之日，众人云集景从之时都已忘得一干二净。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410207
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410207,
					"content": "可悲啊，那本来应是吾铭记于心之景。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410208
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410208,
					"content": "只可惜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410209
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410209,
					"content": "可惜？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722410210,
					"content": "大日御舆建成，不熟悉光亮的龙嗣立刻溃败，白夜之民终于得以安养生息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410211
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410211,
					"content": "只是一旦安定下来…人心难测，鸭胗难剥，谁也不知他人会生出何等丑恶念头。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410212
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410212,
					"content": "异乡的旅者啊，贪婪小人一有可乘之机，就想攫取…比应得之物多上太多的，财富，权力！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410213
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410213,
					"content": "这些人利用民众，开始推行大日御舆崇拜。将人心寄托于虚妄死物已是愚昧至极。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410214
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410214,
					"content": "到了最后…甚至推举「太阳{RUBY#[D]法厄同}之子」以统治白夜之国。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410215
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410215,
					"content": "太阳之子？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410216
					]
				},
				{
					"id": 722410216,
					"content": "正是，每一任，都会有一位稚童被选作太阳之子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410217
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410217,
					"content": "理所当然，这些孩子尚且懵懂，根本不可能担任一国之君，如何行事，不过是一具棚头傀儡，顺从其背后那些龌龊小人们的意见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410218
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410218,
					"content": "吾想要反对，却被他们指使的太阳之子判下谋逆大罪，终生监禁于此…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410219
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410219,
					"content": "啊，太阳之子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722410220,
					"content": "那岂不是总有一天，他会知道自己被人摆布…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722410221,
					"content": "故，凡太阳之子，无人能长大。一旦长大，就不再那么容易被龌龊小人们操纵了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410222
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410222,
					"content": "「太阳之子，诞辰御祝，至天马之架席，共烈日之飨…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410223,
						722410224
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410223,
					"content": "难道说…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410225
					]
				},
				{
					"id": 722410225,
					"content": "嗯，他们全都被送至了大日御舆内部，于诞生祭礼，盛装打扮，兴高采烈之时…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410226
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410226,
					"content": "…藏于此处的物件，就与他们有关。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410227
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410227,
					"content": "这是证明太阳之子正身的御辔，吾藏于此，想以后将之递出，可让世人警醒，只不过，时至今日已毫无意义了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410228
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410228,
					"content": "异乡的旅者啊，那些孩子，这个国家，是吾无法保护完全的事物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410229
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410229,
					"content": "吾乃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410230
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410230,
					"content": "吾乃赫利俄斯之建造者，名曰：阿倍良久！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410231
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410231,
					"content": "吾主持建造大日御舆，于常夜之中高悬明亮之镜，已自以为天纵之才。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410232
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410232,
					"content": "吾有如此才能，如此才能啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410233
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410233,
					"content": "吾本以为可用大日御舆涤荡黑暗，但谁曾想大日御舆之上，人心之欲壑难填贪婪无餍，才是足以覆过一切的阴晦永夜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410234
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410234,
					"content": "异乡的旅客，吾现在将此御辔交至汝之手中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410235
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410235,
					"content": "这枚「神舆之辔」就是这段可笑至极的荒唐历史的见证…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410236
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410236,
					"content": "请务必好好留存…不，就随汝喜好处置吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410237
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410237,
					"content": "过于贵重了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410238
					]
				},
				{
					"id": 722410238,
					"content": "此物本就已无甚意义，今日能魂魄归一，将此物交到汝手上，时也命也，对此物来说，或也算是一类善终了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410239
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410239,
					"content": "如此才能…如此才能啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410224,
					"content": "在某个生日…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410225
					]
				}
			]
		},
		{
			"id": 7224103,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿倍良久"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722410301,
					"content": "啊…烦请汝取回位于狭间之街，灵庙之前与蛇心之地三处的供奉。这样，吾魂魄归一，即可打开大日御舆之上的道路…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿倍良久"
				}
			]
		},
		{
