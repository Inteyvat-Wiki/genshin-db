			},
			"dialogs": [
				{
					"id": 722410601,
					"content": "吾乃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410602
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410602,
					"content": "吾乃赫利俄斯之建造者，名曰：阿倍良久！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410603
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410603,
					"content": "我、我是派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410604,
						722410609
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722410604,
					"content": "在这里自我介绍？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410605
					]
				},
				{
					"id": 722410605,
					"content": "在对方报上名字的时候，你也要报上名字……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722410606,
					"content": "据说是有这样的礼节的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410607
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722410607,
					"content": "无妨。汝等远道而来，吾以此狼狈姿态，亦无法进行接待，也是失礼之至。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410608
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410608,
					"content": "#没有关系，{NICKNAME}和我也不会介意的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410613
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722410613,
					"content": "不过，这位残魂先生为什么会留在这里呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410614
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722410614,
					"content": "吾…吾乃赫利俄斯的建造者，此处为…吾殒命之处。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410615
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410615,
					"content": "在黑暗冰冷之所，昏昏睡去便再无法醒来…吾怎可这样死去，吾可是，赫利俄斯之建造者！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410616
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410616,
					"content": "赫利俄斯的建造者？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410617
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722410617,
					"content": "赫利俄斯是什么呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410618
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722410618,
					"content": "啊…是了，赫利俄斯只是建造时吾私下的称谓。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410619
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410619,
					"content": "虽然不知汝等是否知晓，不过，白夜国民所熟知的名字是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410620
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410620,
					"content": "大日御舆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410621
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410621,
					"content": "赫利俄斯即大日御舆，运载「许伯{RUBY#[D]白夜之光}利翁」的太阳之车。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410622,
						722410623
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410622,
					"content": "大日御舆的建造者？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410624
					]
				},
				{
					"id": 722410624,
					"content": "正是吾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410625
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410625,
					"content": "异乡的旅者啊…吾虽建造大日御舆，却被人幽禁，幽禁在了大日御舆之上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410626
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410626,
					"content": "死去之后，魂魄离散于白夜国各地，甚至记忆也有所散佚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410627
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410627,
					"content": "吾记得有很重要的东西…有很重要的东西在大日御舆之上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410628
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410628,
					"content": "但吾忘记了，异乡的旅者啊，拜托汝…取回我被供奉于三处的衣、冠与骸骨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410629
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410629,
					"content": "分别在狭间之街、灵庙之前与蛇心之地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410630
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410630,
					"content": "将之供奉于三座祭台之上…这样，吾魂魄归一，即可打开通向大日御舆之上的道路…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410631
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410631,
					"content": "通往大日御舆之上，被隐藏于常夜帷幕的幽闭之间…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410623,
					"content": "就是你？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410624
					]
				},
				{
					"id": 722410609,
					"content": "吾乃…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410610
					]
				},
				{
					"id": 722410610,
					"content": "……是么，竟是来自异乡的旅客啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410611
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410611,
					"content": "汝远道而来，吾以此狼狈姿态，亦无法进行接待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410612
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410612,
					"content": "没关系的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410613
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7224107,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224112",
							"2"
						],
						"stepId": 7224112,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿倍良久"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722410701,
					"content": "啊…烦请汝取回位于狭间之街，灵庙之前与蛇心之地三处的供奉。这样，吾魂魄归一，即可打开大日御舆之上的道路…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿倍良久"
				}
			]
		},
		{
			"id": 7224108,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿倍良久",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722410801,
					"content": "啊啊…异乡的旅者，是汝啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410802
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410802,
					"content": "托汝之福，吾现在魂魄完全，已回想起了一切，真是不可思议。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410803
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410803,
					"content": "可能汝已知晓，长久以前，白夜国仅有一片黑暗，生活在此处的诸民深受深海龙嗣侵扰之害。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410804
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410804,
					"content": "那时，由吾主持建造大日御舆，从此白夜国才有了昼夜之替，也有了「白夜」这一国名。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410805
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410805,
					"content": "寓示：「自大日御舆建成之后，虽此地只有常世之夜，亦可因分黑白。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410806
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410806,
					"content": "真是令人汗颜，在离魂归位之前，竟连大日御舆建成之日，众人云集景从之时都已忘得一干二净。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410807
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410807,
					"content": "可悲啊，那本来应是吾铭记于心之景。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410808
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410808,
					"content": "只可惜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410809
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410809,
					"content": "可惜？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410810
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722410810,
					"content": "大日御舆建成，不熟悉光亮的龙嗣立刻溃败，白夜之民终于得以安养生息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410811
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410811,
					"content": "只是一旦安定下来…人心难测，鸭胗难剥，谁也不知他人会生出何等丑恶念头。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410812
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410812,
					"content": "异乡的旅者啊，贪婪小人一有可乘之机，就想攫取…比应得之物多上太多的，财富，权力！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410813
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410813,
					"content": "这些人利用民众，开始推行大日御舆崇拜。将人心寄托于虚妄死物已是愚昧至极。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410814
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410814,
					"content": "到了最后…甚至推举「太阳{RUBY#[D]法厄同}之子」以统治白夜之国。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410815
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410815,
					"content": "太阳之子？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410816
					]
				},
				{
					"id": 722410816,
					"content": "正是，每一任，都会有一位稚童被选作太阳之子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410817
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410817,
					"content": "理所当然，这些孩子尚且懵懂，根本不可能担任一国之君，如何行事，不过是一具棚头傀儡，顺从其背后那些龌龊小人们的意见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410818
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410818,
					"content": "吾想要反对，却被他们指使的太阳之子判下谋逆大罪，终生监禁于此…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410819
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410819,
					"content": "啊，太阳之子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410820
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722410820,
					"content": "那岂不是总有一天，他会知道自己被人摆布…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410821
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722410821,
					"content": "故，凡太阳之子，无人能长大。一旦长大，就不再那么容易被龌龊小人们操纵了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410822
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410822,
					"content": "「太阳之子，诞辰御祝，至天马之架席，共烈日之飨…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410823,
						722410824
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410823,
					"content": "难道说…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410825
					]
				},
				{
					"id": 722410825,
					"content": "嗯，他们全都被送至了大日御舆内部，于诞生祭礼，盛装打扮，兴高采烈之时…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410826
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410826,
					"content": "…藏于此处的物件，就与他们有关。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410827
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410827,
					"content": "这是证明太阳之子正身的御辔，吾藏于此，想以后将之递出，可让世人警醒，只不过，时至今日已毫无意义了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410828
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410828,
					"content": "异乡的旅者啊，那些孩子，这个国家，是吾无法保护完全的事物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410829
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410829,
					"content": "吾乃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410830
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410830,
					"content": "吾乃赫利俄斯之建造者，名曰：阿倍良久！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410831
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410831,
					"content": "吾主持建造大日御舆，于常夜之中高悬明亮之镜，已自以为天纵之才。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410832
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410832,
					"content": "吾有如此才能，如此才能啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410833
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410833,
					"content": "吾本以为可用大日御舆涤荡黑暗，但谁曾想大日御舆之上，人心之欲壑难填贪婪无餍，才是足以覆过一切的阴晦永夜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410834
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410834,
					"content": "异乡的旅客，吾现在将此御辔交至汝之手中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410835
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410835,
					"content": "这枚「神舆之辔」就是这段可笑至极的荒唐历史的见证…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410836
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410836,
					"content": "请务必好好留存…不，就随汝喜好处置吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410837
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410837,
					"content": "过于贵重了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410838
					]
				},
				{
					"id": 722410838,
					"content": "此物本就已无甚意义，今日能魂魄归一，将此物交到汝手上，时也命也，对此物来说，或也算是一类善终了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410839
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410839,
					"content": "如此才能…如此才能啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410824,
					"content": "在某个生日…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410825
					]
				}
			]
		},
