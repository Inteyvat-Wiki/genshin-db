			"dialogs": [
				{
					"id": 140390501,
					"content": "啊——奥乌兹！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390502
					],
					"speakerTitle": "伊娜姆"
				},
				{
					"id": 140390502,
					"content": "你没事吧！是…是被谁袭击了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390503
					],
					"speakerTitle": "伊娜姆"
				},
				{
					"id": 140390503,
					"content": "唔…没、没有…我只是一路追着那个黑影跑进来，然后突然就感觉很难受…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390504
					],
					"speakerTitle": "奥乌兹"
				},
				{
					"id": 140390504,
					"content": "让我来检查一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390505
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390505,
					"content": "这里的空气确实有种很压抑的感觉呢…虽然很香，却让人喘不过气…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140390506,
					"content": "这种感觉…我好像在哪里遇到过…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390507
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 140390507,
					"content": "看起来没有什么大碍。应该只是追得太急，加上环境影响导致的身体不适，出去休息一下应该就会好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390508
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390508,
					"content": "不行！艾德加先生肯定还在里面…他还教过我妹妹调香…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390509
					],
					"speakerTitle": "奥乌兹"
				},
				{
					"id": 140390509,
					"content": "——这样的好人，怎么能死在基里亚手上？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390510
					],
					"speakerTitle": "奥乌兹"
				},
				{
					"id": 140390510,
					"content": "奥乌兹…你冷静点听我说，艾德加…就是我们要追的基里亚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390511
					],
					"speakerTitle": "夏姆"
				},
				{
					"id": 140390511,
					"content": "这…这怎么可能！不是说基里亚…是个三十多岁的青年吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390512
					],
					"speakerTitle": "奥乌兹"
				},
				{
					"id": 140390512,
					"content": "艾德加先生现在都七十来岁了…就算是易容，也装不出那副老态吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390513
					],
					"speakerTitle": "奥乌兹"
				},
				{
					"id": 140390513,
					"content": "嗯…所以基里亚动用了非常的手段，使自己的身体老化。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390514
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390514,
					"content": "…是邪眼。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140390515
					]
				},
				{
					"id": 140390515,
					"content": "基里亚用邪眼培育了奥古斯都花，同时也损耗了自己的寿命…就跟他的姐姐一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390516
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390516,
					"content": "不…不会的，艾德加先生在奥摩斯港住了那么久！要是有人想伪装成他，我们一定能看出破绽！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390517
					],
					"speakerTitle": "奥乌兹"
				},
				{
					"id": 140390517,
					"content": "但如果这个伪装，从十几年前就开始了呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390518
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390518,
					"content": "这…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390519
					],
					"speakerTitle": "奥乌兹"
				},
				{
					"id": 140390519,
					"content": "…虽然还只是推测，但我怀疑真正的调香师艾德加…在枫丹出狱后不久，就已经被基里亚谋害了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390520
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390520,
					"content": "艾德加尚在狱中的那几年里，基里亚就已经做好了顶替的准备：老化的身体、调香的知识…和后续的计划。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390521
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390521,
					"content": "当年的「艾德加」借口要忘却旧事，远赴须弥，甚至暂停调香，转而授课…都是为了避免被故人识破。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390522
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390522,
					"content": "在无人熟识的须弥，只要简单地易容，蓄起胡须，戴上眼镜…就能让人相信，他就是艾德加…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390523
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390523,
					"content": "十多年的漫长岁月里，再一点点地卸去易容，不断地精进自己的技术…周围不会有任何人发现异常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390524
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390524,
					"content": "所以席尔万刚见到他的时候，才说他老得都认不出来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390525
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140390525,
					"content": "为了复仇，把自己从一个青年，变成一个垂垂老矣的老人…这真的值得吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390526
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140390526,
					"content": "我…我得去见艾德加先生…他不可能是这种人…咳…咳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390527
					],
					"speakerTitle": "奥乌兹"
				},
				{
					"id": 140390527,
					"content": "喂，你还是赶紧出去休息吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390528
					],
					"speakerTitle": "夏姆"
				},
				{
					"id": 140390528,
					"content": "可是我还撑得住…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390529
					],
					"speakerTitle": "奥乌兹"
				},
				{
					"id": 140390529,
					"content": "等等…这里的环境，大概也受到了邪眼的影响。就算现在只是轻微的不适，也不能掉以轻心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390530
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 140390530,
					"content": "奥乌兹先生，我知道怎么缓解这类症状…请先跟我一起出去休息吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390531
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 140390531,
					"content": "我觉得基里亚…不，是艾德加先生…一定也不希望再牵连到无辜的人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390532
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 140390532,
					"content": "#柯莱说得对，后面的探索交给我跟{NICKNAME}就好。从我们少量接触「奥古斯都」而无碍的反应来看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390533
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390533,
					"content": "受神之眼庇佑、或是本身就善用元素力的人，对异常元素力的耐受性也会强些，在这里会相对安全一点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390534
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390534,
					"content": "夏姆先生，奥乌兹先生，这处据点说不定还会有其他出入口。万一目标从那里逃离，就很难再抓住了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390535
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390535,
					"content": "…所以，能请你们在外面搜寻一下吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390536
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390536,
					"content": "我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390537
					],
					"speakerTitle": "奥乌兹"
				},
				{
					"id": 140390537,
					"content": "呵…谢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390538
					],
					"speakerTitle": "夏姆"
				},
				{
					"id": 140390538,
					"content": "——喂，没听见吗？快跟我出去，我们还有的是事情要做！回奥摩斯港再多叫点人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390539
					],
					"speakerTitle": "夏姆"
				},
				{
					"id": 140390539,
					"content": "我明白了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390540
					],
					"speakerTitle": "奥乌兹"
				},
				{
					"id": 140390540,
					"content": "#{NICKNAME}、艾梅莉埃，还有派蒙，你们千万要小心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390541
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 140390541,
					"content": "只为复仇而活的人…在这条路的最后，会做出什么事情…我不敢想象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390542
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 140390542,
					"content": "放心吧，不管是我们，还是基里亚，都不应该在这里结束。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390543
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390543,
					"content": "…「奥古斯都」带来的死亡，是时候跟它的神话一起终结了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾梅莉埃"
				}
			]
		},
