					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390723,
					"content": "不要——不要留下我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390724
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390724,
					"content": "叶莲娜——！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390725
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390725,
					"content": "呃…唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390726
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390726,
					"content": "…艾梅莉埃？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390727
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390727,
					"content": "我…还没死？怎么可能？我明明…都见到她了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390728
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390728,
					"content": "…只是你体内残留的毒素，和奥古斯都花粉引致的幻觉而已，并不致命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390729
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390729,
					"content": "不可能…我服下的「奥古斯都」…剂量明明是够的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390730,
						140390731
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390730,
					"content": "…很遗憾。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140390732
					]
				},
				{
					"id": 140390732,
					"content": "…仿制？这怎么可能…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390733
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390733,
					"content": "…从昨晚开始，我们就在着手准备了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390734
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390734,
					"content": "——「奥古斯都」的谐{RUBY#[D]Accord}香。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390735
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390735,
					"content": "…那个时候，你就调换了「奥古斯都」吗？借着向我报告席尔万死讯的机会…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390736
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390736,
					"content": "那时候您以为复仇已经完成…是最容易放松戒备的时刻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390737
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390737,
					"content": "不可能…就算有机会调换，又怎么调得出「奥古斯都」的谐香？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390738
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390738,
					"content": "如果它有那么容易仿制，姐姐就不会…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390739
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390739,
					"content": "我用了虹彩蔷薇、琉璃百合…还有塞西莉亚花…这在十多年前是个会互相冲突的配方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390740
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390740,
					"content": "但现在，已经有办法互相协调了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390741
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390741,
					"content": "…虹彩蔷薇…琉璃百合…塞西莉亚花…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390742
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390742,
					"content": "…「奥古斯都」已经是十多年前的香水了，在这些年里，对它的分析和模仿从未停止。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390743
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390743,
					"content": "调香的技术也已经日新月异，除了古老的精油萃取、油脂离析…我们还发现了更多调和香味的手段。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390744
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390744,
					"content": "十多年前牢不可破的神话…现在也是时候成为过去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390745
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390745,
					"content": "「过去」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390746
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390746,
					"content": "您这些年作为调香师并没有固步自封，理论上有没有可能，您其实很清楚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390747
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390747,
					"content": "只是您太执着于自己给「奥古斯都」赋予的意义…就像陷入「香水狂热」时的人们一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390748
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390748,
					"content": "相信着它的「神圣」，相信着它的「高贵」，相信着它的「独一无二」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390749,
						140390750
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390749,
					"content": "却偏偏忘了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140390751
					]
				},
				{
					"id": 140390751,
					"content": "也是因为你对「奥古斯都」的执着，我们才能预见你想要的「结局」…提前做好准备。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390752
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390752,
					"content": "就是没想到这么快…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390753
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140390753,
					"content": "甚至还动用了邪眼。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140390754
					]
				},
				{
					"id": 140390754,
					"content": "哈…哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390755
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390755,
					"content": "还真是…全被你们说中了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390756
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390756,
					"content": "所以…席尔万他也没死，对吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390757
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390757,
					"content": "既然你们从昨晚开始就在准备「奥古斯都」的谐香…那肯定早就发现了我的手法吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390758
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390758,
					"content": "今天一早的死讯、围观的群众，都是夏姆配合你们，演给我看的一出戏？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390759
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390759,
					"content": "…是的。如果不这么做，您可能会用邪眼做最后一搏，也可能用「灵酚香」跟「奥古斯都」制造混乱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390760
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390760,
					"content": "谁知道呢…说不定会直接给自己一个痛快吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390761
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390761,
					"content": "那「艾德加」的死、这处花圃的位置…就都成为永远的谜了…我不想再看见任何死亡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390762
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390762,
					"content": "席尔万昨晚只是轻度中毒，现在已经在被收押的路上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390763
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390763,
					"content": "他在十多年前隐瞒的罪行，都会受到公开的审判，所有的秘密都会被昭示…而老师，您也一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390764
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390764,
					"content": "我也一样吗…看来我剩下的时间，是要在监狱里度过了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390765
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390765,
					"content": "唔…他接受得好像有点快…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390766
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140390766,
					"content": "…我不会为自己的行为辩解，也没有忏悔的打算。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390767
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390767,
					"content": "该做的事我都已经做完了，就算最后输给你们，一切也都是我自己的选择，就算从头再来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390768
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390768,
					"content": "呵…又怎么可能从头再来呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390769
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390769,
					"content": "…大家小心…我在前面开路…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390770
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 140390770,
					"content": "…都跟紧一点…别让艾德加死了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390771
					],
					"speakerTitle": "夏姆"
				},
				{
					"id": 140390771,
					"content": "看来已经没有时间了…我还有最后一个问题想问你，艾梅莉埃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390772
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390772,
					"content": "…请问吧，老师。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390773
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390773,
					"content": "「奥古斯都」谐香里用到的那几种香型…你是怎么判断出来的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390774
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390774,
					"content": "…「奥古斯都」的香气层次复杂且纷繁，主料却只用到了奥古斯都花一种。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390775
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390775,
					"content": "所以前天研究残液的时候我就在想…会不会是在花卉的培育阶段，就已经完成了这些香型的混合？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390776
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390776,
					"content": "你是说…她当初就是比照着这几种花的香韵，来培育的「奥古斯都」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390777
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390777,
					"content": "虹彩蔷薇、琉璃百合、塞西莉亚花…直接混合它们的精油，会互相冲突排斥，在多年前是无解的难题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390778
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390778,
					"content": "但如果能培育出一种兼具它们特色的新花种，就规避了这个问题…不得不说，这在过去是个非常天才的想法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390779
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390779,
					"content": "虹彩蔷薇、琉璃百合、塞西莉亚花…呵，真像是你会选的花啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390780
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390780,
					"content": "…叶莲娜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390781
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390781,
					"content": "在这之后，镀金旅团匆匆赶到…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						140390782
					]
				},
				{
					"id": 140390782,
					"content": "基里亚未发一言，默然接受了命运。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 140390750,
					"content": "它本身只是一瓶香水而已。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140390751
					]
				},
				{
					"id": 140390731,
					"content": "那是仿制的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140390782
					]
				}
			]
		},
