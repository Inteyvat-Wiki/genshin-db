					"nextDialogs": [
						140390202
					],
					"speakerTitle": "巴巴尔"
				},
				{
					"id": 140390202,
					"content": "请放松一些，做个深呼吸…能告诉我们你都看到什么了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
