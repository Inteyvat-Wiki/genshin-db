					"nextDialogs": [
						140390703
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390703,
					"content": "…这么快就追上来了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390704
					],
					"speakerTitle": "艾德加"
				},
				{
