			"dialogs": [
				{
					"id": 140390301,
					"content": "呼…再往外跑，可就出奥摩斯港了！看到的人会更少吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140390302,
					"content": "没关系，我已经能隐约闻到气味了，他应该刚经过这里不久。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390303
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390303,
					"content": "…是在这个方向，请往这边。",
