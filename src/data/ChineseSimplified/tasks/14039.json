					"content": "不…是我已经没力气了啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390705
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390705,
					"content": "…不过到这里…就已经够了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390706
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390706,
					"content": "哼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390707
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390707,
					"content": "哈——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390708
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390708,
					"content": "…这里是…「奥古斯都」的花圃？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390709
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390709,
					"content": "…不是我的花圃…是那天在枫丹被烧毁的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390710
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390710,
					"content": "…姐姐？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390711
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390711,
					"content": "——姐姐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390712
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390712,
					"content": "我…其实一直都明白的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390713
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390713,
					"content": "都是因为我，你才会继续用邪眼！都是因为我，你才会烧掉花圃！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390714
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390714,
					"content": "…那一天，我就不该听你说的，带钱离开枫丹廷…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390715
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390715,
					"content": "等我发现不对的时候…花圃也好…你也好…什么都没了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390716
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390716,
					"content": "…我早该过来找你的…十多年前我就应该来找你的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390717
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390717,
					"content": "我早该跟你…一起死在这一天的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390718
					],
					"speakerTitle": "艾德加"
				},
