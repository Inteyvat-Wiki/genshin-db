					"nextDialogs": [
						200230303
					]
				},
				{
					"id": 200230303,
					"content": "他今天已经喝了快半天了，你看，这是他喝的账单。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230304
					],
					"speakerTitle": "查尔斯"
				},
				{
					"id": 200230304,
					"content": "再这么下去，只能把优律小姐叫来了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230305
					],
					"speakerTitle": "查尔斯"
				},
				{
					"id": 200230305,
					"content": "借用一下？也不是不行，可是你们要这个做什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "查尔斯"
				}
			]
		},
