			"trigger": {
				"objectNames": [
					"维多利亚"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200230101,
					"content": "他到底有没有悔改呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230102
					],
					"speakerTitle": "维多利亚"
				},
				{
					"id": 200230102,
					"content": "悔改什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230103
					]
				},
				{
					"id": 200230103,
					"content": "每天都会有很多人到我这里，倾诉他们所犯下的罪孽，祈求神的原谅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230104
					],
					"speakerTitle": "维多利亚"
				},
				{
					"id": 200230104,
					"content": "但如果只是口头说说，不付诸行动，那不就只是在浪费时间吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230105
					],
					"speakerTitle": "维多利亚"
				},
				{
					"id": 200230105,
					"content": "比如宁禄先生，他为自己酗酒的习惯忏悔了好多次，但一点改变都没有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230106
					],
					"speakerTitle": "维多利亚"
				},
				{
					"id": 200230106,
					"content": "如果你有空的话，去帮我去看看他现在的情况吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230107,
						200230110
					],
					"speakerTitle": "维多利亚"
				},
				{
					"id": 200230107,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230108
					]
				},
				{
					"id": 200230108,
					"content": "对了，如果他又在喝酒，请带一些证据回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230109
					],
					"speakerTitle": "维多利亚"
				},
				{
					"id": 200230109,
					"content": "屡教不改的人…还是需要一点能深刻铭记的「教诲」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "维多利亚"
				},
				{
					"id": 200230110,
					"content": "喝酒也算「罪孽」吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230111
					]
				},
				{
					"id": 200230111,
					"content": "喝酒不算「罪孽」，但是因为喝酒，而让其他人陷入苦恼算是「罪孽」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230112
					],
					"speakerTitle": "维多利亚"
				},
				{
					"id": 200230112,
					"content": "如果每个人都恣意妄为，那么这座蒙德城，总有一天也会陷入巨大的苦恼中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230113
					],
					"speakerTitle": "维多利亚"
				},
				{
					"id": 200230113,
					"content": "所以，要将每一份刚冒头的「罪孽」掐断，好了，你快点去看看宁禄的情况吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "维多利亚"
				}
			]
		},
		{
