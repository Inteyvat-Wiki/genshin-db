				"points": []
			},
			"dialogs": [
				{
					"id": 200230201,
					"content": "哈哈哈，我每天都指着这一杯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230202
					],
					"speakerTitle": "宁禄"
				},
				{
					"id": 200230202,
					"content": "你不是说要戒酒吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230203
					]
				},
				{
					"id": 200230203,
					"content": "啊？！吓死我了…我还以为是我老婆呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230204
					],
					"speakerTitle": "宁禄"
				},
				{
					"id": 200230204,
					"content": "偶尔喝一点也无所谓吧，我可是辛苦工作了一天啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230205
					],
					"speakerTitle": "宁禄"
				},
				{
					"id": 200230205,
					"content": "好了好了，我再喝一点就回去了…优律也差不多该买完东西了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宁禄"
				}
			]
		},
