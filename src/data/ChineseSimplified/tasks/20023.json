					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230404
					],
					"speakerTitle": "维多利亚"
				},
				{
					"id": 200230404,
					"content": "无论过去经历了什么，只要没有真正吃到苦头，人们最终什么都不会记得…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230405
					],
					"speakerTitle": "维多利亚"
				},
				{
					"id": 200230405,
					"content": "好了，这是给你们的答谢，收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230406
					],
					"speakerTitle": "维多利亚"
				},
				{
					"id": 200230406,
					"content": "宁禄的那一份「答谢」，我也会好好思考的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "维多利亚"
