			"dialogs": [
				{
					"id": 730180401,
					"content": "超近距离看感觉更震撼了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730180402,
					"content": "法留纳神机，来自草木之王的创造，带来生命的水，把巴螺迦变成桓那，过去的黄色用绿色替代，让不毛的土地从此充满生机。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180403
					],
					"speakerTitle": "兰般度"
				},
				{
					"id": 730180403,
					"content": "听起来好神奇哦，「带来生命的水」…唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730180404,
