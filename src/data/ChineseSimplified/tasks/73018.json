	"talks": [
		{
			"id": 7301802,
			"completionStepIds": [
				7301802
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301802",
							"2"
						],
						"stepId": 7301802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"兰般度",
					"派蒙",
					"兰百梨迦"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730180201,
					"content": "#那菈{NICKNAME}，还有派蒙，感谢你们帮助了兰那罗。可以感受到，各处堵塞溪流的小枝已经被移除了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180202
					],
					"speakerTitle": "兰般度"
				},
				{
					"id": 730180202,
					"content": "哦！现在我们可以去治好法留纳神机了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730180203,
					"content": "很快，但是还没有。根系在很深很深的地下，通向地下的入口在法留纳法宝的中心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180204
					],
					"speakerTitle": "兰般度"
				},
				{
					"id": 730180204,
					"content": "「法留纳法宝」，好像兰般度提过…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730180205,
					"content": "#是法留纳神机的力量的显现，它发挥力量的时候，比桓那最高的树更高，那菈{NICKNAME}和派蒙早就见过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180206
					],
					"speakerTitle": "兰般度"
				},
				{
					"id": 730180206,
					"content": "是说那个时不时喷射水柱的地方？…难道我们要从那玩意儿的中心进去？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180207,
						730180209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730180207,
					"content": "看起来可不像是入口。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730180208
					]
				},
				{
					"id": 730180208,
					"content": "对呀对呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730180211,
					"content": "万一我们准备进去的时候它正好启动了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730180212,
					"content": "那么高的水柱，而且水势看起来也很强的样子…完全想不出来该怎么进到它的中心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180213,
						730180215,
						730180217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730180213,
					"content": "只能想办法从上面进去了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730180214
					]
				},
				{
					"id": 730180214,
					"content": "#就算我能飞上去，{NICKNAME}也上不去吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730180219,
					"content": "为什么会这样？让它停下就可以了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180220
					],
					"speakerTitle": "兰百梨迦"
				},
				{
					"id": 730180220,
					"content": "原来它还能停下的吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730180221,
					"content": "#之前是不行的，但是因为那菈{NICKNAME}和派蒙的帮助，法留纳神机的力量恢复了一部分，现在兰那罗可以让它停下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180222
					],
					"speakerTitle": "兰般度"
				},
				{
					"id": 730180222,
					"content": "我们居然不知不觉做了这么了不起的事情！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180223,
						730180225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730180223,
					"content": "倒也不是不知不觉…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730180224
					]
				},
				{
					"id": 730180224,
					"content": "啊，确实，梦景林莽那儿找起来真不容易…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180227
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730180227,
					"content": "#那菈{NICKNAME}，派蒙，我们一起过去。绿枝已经开过花，就快要到结果的时候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰般度"
				},
				{
					"id": 730180225,
					"content": "派蒙真是太厉害啦！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730180226
					]
				},
				{
					"id": 730180226,
					"content": "#{NICKNAME}也厉害，嘿嘿，咱俩都厉害！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180227
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730180215,
					"content": "只能正面硬闯了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730180216
					]
				},
				{
					"id": 730180216,
					"content": "听说有种修行方法是在瀑布下接受水流的冲洗…我们随随便便冲过去肯定会被卷走的啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730180217,
					"content": "也许可以在旁边挖个地道下去…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730180218
					]
				},
				{
					"id": 730180218,
					"content": "这是什么崭新的解决方法？…等等，说不定真的有一试的价值…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730180209,
					"content": "进不去，怎么想都进不去吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730180210
					]
				},
				{
					"id": 730180210,
					"content": "喂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180211
					],
					"speakerTitle": "派蒙"
				}
			]
		},
