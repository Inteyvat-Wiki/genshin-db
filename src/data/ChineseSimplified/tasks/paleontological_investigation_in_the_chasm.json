			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"海迪夫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710500601,
					"content": "关于奇怪的岩石…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500602
					]
				},
				{
					"id": 710500602,
					"content": "拍到了奇怪的岩石的照片？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500603
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500603,
					"content": "请务必给我看一眼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500604
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500604,
					"content": "就是这个…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500605
					]
				},
				{
					"id": 710500605,
					"content": "诶呀，这照片！真不愧是枫丹那边做出来的新机型，拍摄得相当清晰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500606
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500606,
					"content": "之前倒是买过一批试验机型，拍得很模糊，而且一台机子还要两个人抬，最后只能放在教令院积灰…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500607,
						710500608
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500607,
					"content": "积灰…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500609
					]
				},
				{
					"id": 710500609,
					"content": "是啊，好歹也是我一顿饭的钱。嗯…看来是时候再买一批新的了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500610
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500610,
					"content": "说远了，我看看，这石头…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500611
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500611,
					"content": "嗯，这是化石！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500612
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500612,
					"content": "化石？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500613
					]
				},
				{
					"id": 710500613,
					"content": "是啊，而且有很多海洋生物…有趣。璃月有一句话叫做…「林园和田野，被茫茫的大海淹没」？说的就是这个。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500614
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500614,
					"content": "层岩巨渊这边能够出现化石，就说明原本这些生物曾经被迅速埋藏在地下，骨骼才能保持如此完整的形状。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500615
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500615,
					"content": "这么说来，听说这里也时常发生地震…这样就说得通了，活跃的地质活动是形成化石的必要条件之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500616
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500616,
					"content": "这可对研究这一片区域的古生物类群很有帮助…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500617
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500617,
					"content": "可是只有一张的话可不够。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500619
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500619,
					"content": "这样你要是还有这样的化石，就拍下来给我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500620
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500620,
					"content": "那要拍几张才行啊？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500621
					]
				},
				{
					"id": 710500621,
					"content": "我想想，要放进报告里的话，类似的照片4、5张应该足够了…那就5张吧，给我5张类似岩石的照片。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500622
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500622,
					"content": "我会给出合适的价钱买下的，这可是大发现啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500608,
					"content": "有点浪费…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500609
					]
				}
			]
		},
