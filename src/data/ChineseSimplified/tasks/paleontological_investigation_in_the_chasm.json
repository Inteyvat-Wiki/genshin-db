			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"海迪夫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710500902,
					"content": "不错不错，真是不可多得的好照片啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500903
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500903,
					"content": "勘探队的那些开销，只要有这几张照片那就值回票价了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500904
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500904,
					"content": "你看，这些都是远古海生生物的骨骼，造型也非常清晰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500905
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500905,
					"content": "证明了层岩巨渊在形成以前，其实是海洋环境。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500906
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500906,
					"content": "真可惜，如果是在须弥发现这样的化石，就能够直接搬回教令院进行研究了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500907
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500907,
					"content": "下次再和总务司接洽的时候，跟他们谈谈好了，我们这边出钱请人保护也行，得小心一些啊，不能让矿工把这些化石给敲坏了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500908
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500908,
					"content": "不过…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500909,
						710500910
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500909,
					"content": "不过？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500911
					]
				},
				{
					"id": 710500911,
					"content": "这些照片…勉强算是足够了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500912
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500912,
					"content": "之前说了吧，这么品相完好，结构完整的化石，它形成也是有条件的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500913
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500913,
					"content": "那就是被迅速埋藏入土中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500914
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500914,
					"content": "层岩巨渊的化石，基本上只出现在某个固定的高度区域。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500918,
						710500919
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500918,
					"content": "固定高度？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500920
					]
				},
				{
					"id": 710500920,
					"content": "哎呀，从地质学的角度上来说，这个等级的差异可以忽略不计。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500915
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500915,
					"content": "总之，这就说明形成化石的时期很短，而且都相当接近…说明在很短暂的时间段里发生了特别大的生态变化。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500916
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500916,
					"content": "譬如说，巨大的冲击导致的…之类。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500917
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500917,
					"content": "嗯，层岩巨渊，到底发生过什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500919,
					"content": "上下高度差挺大的吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500920
					]
				},
				{
					"id": 710500910,
					"content": "难道是照片不够？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500911
					]
				}
			]
		},
