					}
				]
			},
			"dialogs": [
				{
					"id": 740670401,
					"content": "又见面了。我之前和自己打赌，赌来的会不会是你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670402,
						740670404
					],
					"speakerTitle": "克兰茨"
				},
				{
					"id": 740670402,
					"content": "那你赢了还是输了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740670403
					]
				},
				{
					"id": 740670403,
					"content": "哈哈，赢也是我，输也是我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670406
					],
					"speakerTitle": "克兰茨"
				},
				{
					"id": 740670406,
					"content": "你为什么要用扩音机做这种事呀，被嘉维娅抓到的话，不是很麻烦吗？你很怕她，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740670407,
					"content": "怕她？怎么会，只是被她抓到的确很麻烦。但她大部分时间都在管理区，生产区的麻烦如果没有特别的原因，她是不想插手的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670408
					],
					"speakerTitle": "克兰茨"
				},
				{
					"id": 740670408,
					"content": "至于为什么要用扩音机做这种事，那当然是因为这里的生活太无聊了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670409
					],
					"speakerTitle": "克兰茨"
				},
				{
					"id": 740670409,
					"content": "我现在能理解蒂亚尔的想法了，他一定也是觉得生活太无聊了，所以总是在找乐子。说起来，我只是有样学样吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670410
					],
					"speakerTitle": "克兰茨"
				},
				{
					"id": 740670410,
					"content": "你们应该也有这样的朋友吧？脑子里装满了奇思妙想，偶尔也会惹出些让人啼笑皆非的乱子来的朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670411,
						740670412
					],
					"speakerTitle": "克兰茨"
				},
				{
					"id": 740670411,
					"content": "有啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740670413
					]
				},
				{
					"id": 740670413,
					"content": "我真搞不懂你，既然你觉得这里的生活无聊，又有这样的朋友，为什么不尽快离开梅洛彼得堡呢？难不成你其实是重刑犯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740670414,
					"content": "想离开的话我随时都能离开，我是自愿留在这里的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670415
					],
					"speakerTitle": "克兰茨"
				},
				{
					"id": 740670415,
					"content": "这里的生活比外面好多啦，风雨无忧，生活规律，也不需要思考复杂的问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670416
					],
					"speakerTitle": "克兰茨"
				},
				{
					"id": 740670416,
					"content": "那个叫莉诺尔的小女孩，我真羡慕她，如果能和她换换，我一定选择不要离开这里。我宁愿不知道外面的世界。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670417,
						740670419
					],
					"speakerTitle": "克兰茨"
				},
				{
					"id": 740670417,
					"content": "那是因为你已经见过外面的世界。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740670418
					]
				},
				{
					"id": 740670418,
					"content": "要做判断也需要材料，你说得对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670421
					],
					"speakerTitle": "克兰茨"
				},
				{
					"id": 740670421,
					"content": "可是留在这里的话，不就见不到朋友了吗？除非你的朋友们也下来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670422
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740670422,
					"content": "好消息，这对我来说不是问题。坏消息，不是问题的原因是，朋友已经不在了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670423
					],
					"speakerTitle": "克兰茨"
				},
				{
					"id": 740670423,
					"content": "唉，我真不擅长这方面的话题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670424
					],
					"speakerTitle": "克兰茨"
				},
				{
					"id": 740670424,
					"content": "他们还在的时候，虽然我们的研究方向不是什么热门，申请经费也很困难，但日子也谈不上难过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670425
					],
					"speakerTitle": "克兰茨"
				},
				{
					"id": 740670425,
					"content": "但是后来意外和事故接踵而至，布托尔先生因病去世，中央实验室爆炸，蒂亚尔也因为这场事故丧生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670426
					],
					"speakerTitle": "克兰茨"
				},
				{
					"id": 740670426,
					"content": "还有被开除的…算了，就不提他了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670427
					],
					"speakerTitle": "克兰茨"
				},
				{
					"id": 740670427,
					"content": "总之尽是些我无能为力的事。但是在梅洛彼得堡，生活很简单，也没什么我应付不来的问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670428
					],
					"speakerTitle": "克兰茨"
				},
				{
					"id": 740670428,
					"content": "就算有，那也轮不到我操心，哈哈。所以，我对现在的生活没什么不满，只是偶尔想找人叙叙旧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670429,
						740670430
					],
					"speakerTitle": "克兰茨"
				},
				{
					"id": 740670429,
					"content": "可以理解。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740670431
					]
				},
				{
					"id": 740670431,
					"content": "不过今天能和你们聊天也挺不错的，谢谢你们。这些特许券就送给你们了，就当是我请你们在破烂骨头商店喝了一杯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670432
					],
					"speakerTitle": "克兰茨"
				},
				{
					"id": 740670432,
					"content": "#干杯，{M#先生}{F#小姐}，还有小小的女士，笑一个吧。愿你们度过美好的一天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "克兰茨"
				},
				{
					"id": 740670430,
					"content": "尊重你的选择。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740670431
					]
				},
				{
					"id": 740670419,
					"content": "不应该以轻率的态度评价他者。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740670420
					]
				},
				{
					"id": 740670420,
					"content": "是啊，说起来，我和她也并没有多熟络，谁知道她自己是怎么想的呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670421
					],
					"speakerTitle": "克兰茨"
				},
				{
					"id": 740670412,
					"content": "并没有。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740670413
					]
				},
				{
					"id": 740670404,
					"content": "为什么和自己打赌？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740670405
					]
				},
				{
					"id": 740670405,
					"content": "好问题。不过很容易回答，因为这里没人愿意和我打这种无聊的赌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670406
					],
					"speakerTitle": "克兰茨"
				}
			]
		}
	]
}