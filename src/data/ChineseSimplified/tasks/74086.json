			"dialogs": [
				{
					"id": 740860201,
					"content": "我们到了。这就是一枚「勘测桩锚」的所在地。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740860202
					],
					"speakerTitle": "纳克"
				},
				{
					"id": 740860202,
					"content": "这里原本是杜艾里小姐所领导的「深水勘测研究院」，她们的研究项目是「超深水常驻式监测锚点」。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740860203
					],
					"speakerTitle": "纳克"
				},
				{
					"id": 740860203,
					"content": "在爆炸后，整片湖里的水先是被逆转的重力全部掀到了天上，在刹那之后，又全部坠落了下来。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740860204
					],
					"speakerTitle": "纳克"
				},
				{
					"id": 740860204,
					"content": "整片湖里的湖水从天上掉下来…那，那她们…$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740860205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740860205,
					"content": "全部下落不明。院里没有找到和她们有关的任何线索。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740860206
					],
					"speakerTitle": "纳克"
				},
				{
					"id": 740860206,
					"content": "怎么会这样…$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740860207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740860207,
					"content": "只是失踪，应该还有希望。$UNRELEASED",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740860208
					]
				},
				{
					"id": 740860208,
					"content": "谢谢你能这么想。但说实话，考虑到当时杜艾里小姐应该正在水里工作…$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740860209
					],
					"speakerTitle": "纳克"
				},
				{
					"id": 740860209,
					"content": "在我个人看来，「失踪」这种说法，还是掺杂了太多情绪成分。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740860210
					],
					"speakerTitle": "纳克"
				},
				{
					"id": 740860210,
					"content": "克洛妮艾小姐，出来吧，您的耳朵都要伸出草丛了。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740860211
					],
					"speakerTitle": "纳克"
				},
				{
					"id": 740860211,
					"content": "您是怎么发现我…呸！这些叶子真讨厌，都飘我嘴里了。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740860212
					],
					"speakerTitle": "克洛妮艾"
				},
				{
					"id": 740860212,
					"content": "出现了！哪里都在的克洛妮艾小姐！$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740860213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740860213,
					"content": "你不是在采访舒瓦瑟尔吗？$UNRELEASED",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740860214
					]
				},
				{
					"id": 740860214,
					"content": "呸…呸，呸！舒瓦瑟尔和之前一样，只是一尊只会回放留音的人偶。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740860215
					],
					"speakerTitle": "克洛妮艾"
				},
				{
					"id": 740860215,
					"content": "他永远只会重复那么几个单词。比如「坚决保障」、「力求迅速」、「安全为上」什么的。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740860216
					],
					"speakerTitle": "克洛妮艾"
				},
				{
					"id": 740860216,
					"content": "还有那些…莫名其妙的排比句子和短语。比如…$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740860217
					],
					"speakerTitle": "克洛妮艾"
				},
				{
					"id": 740860217,
					"content": "「方方面面睁大眼，时时刻刻敲警钟」、「高扬前进帆，稳把方向舵，常备安全锚」…$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740860218
					],
					"speakerTitle": "纳克"
				},
				{
					"id": 740860218,
					"content": "语气都一模一样！$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740860219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740860219,
					"content": "比起听他说一无是处的废话，我还不如跟着你们到处跑跑呢！$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740860220
					],
					"speakerTitle": "克洛妮艾"
				},
				{
					"id": 740860220,
					"content": "好吧，希望您身上的止吐药剂还够用。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740860221
					],
					"speakerTitle": "纳克"
				},
				{
					"id": 740860221,
					"content": "#{NICKNAME}，请你去把那枚「勘测桩锚」取出来吧，然后我们就去下一个地点。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "纳克"
				}
			]
		},
		{
			"id": 7408650,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"纳克",
					"克洛妮艾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740865001,
					"content": "很好。这里的桩锚状态很不错，没有太多的能量流外泄。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740865002
					],
					"speakerTitle": "纳克"
				},
				{
					"id": 740865002,
					"content": "您的身体怎么样？有什么异常感觉吗？$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740865003
					],
					"speakerTitle": "纳克"
				},
				{
					"id": 740865003,
					"content": "#没有喔，我和{NICKNAME}什么感觉都没有。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740865004
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740865004,
					"content": "那就好，如果有任何异常感，请您立刻说出来。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740865005
					],
					"speakerTitle": "纳克"
				},
				{
					"id": 740865005,
					"content": "我们去下一个地点吧，离这里稍微有些远…我们得加快点脚步了。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740865006
					],
					"speakerTitle": "纳克"
				},
				{
					"id": 740865006,
					"content": "嘿！等等，我…我的鞋里进了几块小石头！等我先把它们弄出来…$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "克洛妮艾"
				}
			]
		}
	]
}