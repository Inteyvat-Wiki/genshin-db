	"talks": [
		{
			"id": 7114901,
			"completionStepIds": [
				7114901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7114901",
							"2"
						],
						"stepId": 7114901,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"萍溪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711490101,
					"content": "今年的安排应该没问题，呼…总算不用麻烦刻晴大人再来亲自核算了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490116
					],
					"speakerTitle": "萍溪"
				},
				{
					"id": 711490116,
					"content": "呃！不能想着这些，我是招财神我是招财神我是招财神…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490103
					],
					"speakerTitle": "萍溪"
				},
				{
					"id": 711490103,
					"content": "请问您是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711490117
					]
				},
				{
					"id": 711490117,
					"content": "我是招财神！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490118,
						711490119
					],
					"speakerTitle": "萍溪"
				},
				{
					"id": 711490118,
					"content": "看、看得出来…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711490120
					]
				},
				{
					"id": 711490120,
					"content": "#欸？这不是{NICKNAME}吗？嗨，早知道是你过来，我就不用背那么多词了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490121
					],
					"speakerTitle": "萍溪"
				},
				{
					"id": 711490121,
					"content": "看你的样子，也是来璃月过海灯节的，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490122
					],
					"speakerTitle": "萍溪"
				},
				{
					"id": 711490122,
					"content": "今年你算是来着了，瞧瞧周围的氛围，是不是比去年的海灯节更热闹了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490123,
						711490124
					],
					"speakerTitle": "萍溪"
				},
				{
					"id": 711490123,
					"content": "感觉每一年的海灯节…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711490125
					]
				},
				{
					"id": 711490125,
					"content": "那是当然，俗话说「霄灯飞起节节高」，无论做什么事都要求一个进步嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490126
					],
					"speakerTitle": "萍溪"
				},
				{
					"id": 711490126,
					"content": "哎呀，大过节的不说这些，来来来，我给你指指哪里有好玩的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490127
					],
					"speakerTitle": "萍溪"
				},
				{
					"id": 711490127,
					"content": "我看看喔…嗯…有了！来海灯节，当然要先放霄灯了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490128
					],
					"speakerTitle": "萍溪"
				},
				{
					"id": 711490128,
					"content": "然后呢，我们今年还在璃月港的各处放了许多「吉事宝树」，只要为它好好修剪枝干，里面的「吉语钱」就归你啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490129
					],
					"speakerTitle": "萍溪"
				},
				{
					"id": 711490129,
					"content": "我们一共放了多少个来着？好像是…21，对，就是21个。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490130
					],
					"speakerTitle": "萍溪"
				},
				{
					"id": 711490130,
					"content": "而且…其实在这附近，就有一棵「吉事宝树」喔，要是有兴趣的话，你就直接去修剪一下吧，很简单的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490131
					],
					"speakerTitle": "萍溪"
				},
				{
					"id": 711490131,
					"content": "最后…嗯，要是你有兴趣的话，也可以去旁边的「告事板」那边看看，喏，就在我旁边。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490132
					],
					"speakerTitle": "萍溪"
				},
				{
					"id": 711490132,
					"content": "最近几年的海灯节有许多外国游客参加，我们总务司也专门为他们设置了「告事板」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490102
					],
					"speakerTitle": "萍溪"
				},
				{
					"id": 711490102,
					"content": "无论他们有什么问题，或者是遇见了需要解决的麻烦，都可以写下来挂在「告事板」上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490133
					],
					"speakerTitle": "萍溪"
				},
				{
					"id": 711490133,
					"content": "哼哼，我们总务司，绝对会让所有来璃月过海灯节的人，都满意而归！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490134,
						711490135
					],
					"speakerTitle": "萍溪"
				},
				{
					"id": 711490134,
					"content": "不愧是总务司。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711490136
					]
				},
				{
					"id": 711490136,
					"content": "那是当然！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490137
					],
					"speakerTitle": "萍溪"
				},
				{
					"id": 711490137,
					"content": "#对了，{NICKNAME}，我记得你很擅长留影，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490138,
						711490139
					],
					"speakerTitle": "萍溪"
				},
				{
					"id": 711490138,
					"content": "略懂而已。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711490140
					]
				},
				{
					"id": 711490140,
					"content": "哈哈哈，别这么谦虚嘛。我就是…想拜托你帮一个小小的忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490141
					],
					"speakerTitle": "萍溪"
				},
				{
					"id": 711490141,
					"content": "很简单的，我保证！你只需要帮几位游客拍一张「纪念留影」就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490142
					],
					"speakerTitle": "萍溪"
				},
				{
					"id": 711490142,
					"content": "本来我们雇了几位留影师，专门为大家拍「纪念留影」，但没想到，今年来了这么多游客，留影师一下子就不够用了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490143
					],
					"speakerTitle": "萍溪"
				},
				{
					"id": 711490143,
					"content": "#临时雇新的留影师已经来不及了，所以，我就只能拜托你了，{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490144
					],
					"speakerTitle": "萍溪"
				},
				{
					"id": 711490144,
					"content": "拜托！为了各位游客，为了海灯节，为了璃月！只有你能帮我们这个忙了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490145,
						711490146
					],
					"speakerTitle": "萍溪"
				},
				{
					"id": 711490145,
					"content": "包在我身上！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711490147
					]
				},
				{
					"id": 711490147,
					"content": "#哦！不愧是{NICKNAME}，我就把那几位游客的名字，还有预定的地点告诉你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490148
					],
					"speakerTitle": "萍溪"
				},
				{
					"id": 711490148,
					"content": "那就拜托你了，有你帮忙，今年的海灯节一定会完美无缺的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490149
					],
					"speakerTitle": "萍溪"
				},
				{
					"id": 711490149,
					"content": "这几盏霄灯送给你，嘿嘿，海灯节快乐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "萍溪"
				},
				{
					"id": 711490146,
					"content": "为了海灯节！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711490147
					]
				},
				{
					"id": 711490139,
					"content": "根本不明白。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711490140
					]
				},
				{
					"id": 711490135,
					"content": "不愧是璃月…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711490136
					]
				},
				{
					"id": 711490124,
					"content": "都比前一年更厉害…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711490125
					]
				},
				{
					"id": 711490119,
					"content": "很吉利的服装…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711490120
					]
				}
			]
		}
	]
}