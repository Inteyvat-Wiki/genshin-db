			"dialogs": [
				{
					"id": 401180901,
					"content": "尊贵的劳伦斯家后裔，一路旅行也学了不少技巧…比如，做烤饼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401180902
					],
					"speakerTitle": "莱斯格"
				},
				{
					"id": 401180902,
					"content": "…嗯，这个火候应该没问题吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401180903
					],
					"speakerTitle": "莱斯格"
				},
				{
					"id": 401180903,
					"content": "没想到你居然会做烤饼…你不是那种从来不洗碗的人吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401180904
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 401180904,
					"content": "来得正好，你之后有时间吗？能不能教教我做点心？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401180905
					],
					"speakerTitle": "莱斯格"
				},
				{
					"id": 401180905,
					"content": "欸？那可得花上不少时间…我们不是来这里增进家族情谊的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401180906
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 401180906,
					"content": "行啦，这时候又在意这些了？你也说了我们是普通人，像普通的表亲一样互相学习吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莱斯格"
				}
			]
		},
