			"dialogs": [
				{
					"id": 401181001,
					"content": "真想和「军师」姐姐一起呼呼——地坐飞车呀！可是，她好像会晕倒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401181002
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401181002,
					"content": "可莉真敏锐啊，一定是从「军师」姐姐眼睛里看到了旋转的星星吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401181003
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 401181003,
					"content": "今天的少了一点哦！昨天有很多很多金色的星星。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401181004
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401181004,
					"content": "妈妈要是在的话，可能会说这些星星全是掉进云朵的鱼吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "可莉"
				}
			]
		},
