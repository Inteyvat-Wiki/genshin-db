			"trigger": {
				"objectNames": [
					"玛格丽特"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4870301,
					"content": "「小王子」~！你跑哪儿去了呀，终于回来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870302
					],
					"speakerTitle": "玛格丽特"
				},
				{
					"id": 4870302,
					"content": "可让我们好找呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4870303,
					"content": "唉，「小王子」呀，你怎么忍心这样抛弃我呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870304
					],
					"speakerTitle": "玛格丽特"
				},
				{
					"id": 4870304,
					"content": "已经进入「二人世界」了吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4870305,
					"content": "还有你的星铁弦在这儿哦，温迪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4870306,
					"content": "还真的被你们找到了，我原本都不怎么抱希望了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870307
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 4870307,
					"content": "为了表示感谢，用这弦为你们办一场「专场演唱」都不过分呢…阿、阿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870308
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 4870308,
					"content": "阿？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4870309,
					"content": "阿嚏——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870310
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 4870310,
					"content": "咳咳…啊哈哈…离「小王子」这么近的话，我对猫过敏的体质果然又…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870311
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 4870311,
					"content": "怪不得你没有自己去抓它…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4870312,
					"content": "欸嘿，总之帮了大忙啦，那我先走啦…阿、阿嚏——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "温迪"
				}
			]
		},
