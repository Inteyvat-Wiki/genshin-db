						"rawParams": [
							"4134102",
							"2"
						],
						"stepId": 4134102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"小羽"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413410201,
					"content": "客、客官，你好，那个…想要歇脚的话请…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410203
					],
					"speakerTitle": "小羽"
				},
				{
					"id": 413410203,
					"content": "我们是来送霄灯的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410204
					]
				},
				{
					"id": 413410204,
					"content": "送霄灯…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410205
					],
					"speakerTitle": "小羽"
				},
				{
					"id": 413410205,
					"content": "小羽，这盏霄灯送给你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410206
					],
					"speakerTitle": "蒙蒙"
				},
				{
					"id": 413410206,
					"content": "蒙蒙？咦，这盏霄灯是你做的吗？谢、谢谢你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410207
					],
					"speakerTitle": "小羽"
				},
				{
					"id": 413410207,
					"content": "#是这个{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}教我编的，其实做得不太好，你…你喜欢吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410208
					],
					"speakerTitle": "蒙蒙"
				},
				{
					"id": 413410208,
					"content": "这盏霄灯做的很好啊！我很喜欢的，我还正在发愁，怎么抽出时间来编霄灯呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410209
					],
					"speakerTitle": "小羽"
				},
				{
					"id": 413410209,
					"content": "谢谢你蒙蒙，我等会就去请人帮我把这盏霄灯挂到门上去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410210,
						413410211
					],
					"speakerTitle": "小羽"
				},
				{
					"id": 413410210,
					"content": "为什么要请人帮忙挂霄灯？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410212
					]
				},
				{
					"id": 413410212,
					"content": "这个啊，嗯…我爸爸身体一直不好，不能过来挂霄灯。我个子又太矮，肯定也挂不上去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410213
					],
					"speakerTitle": "小羽"
				},
				{
					"id": 413410213,
					"content": "想把霄灯挂到门上去，只能去周围请人帮忙了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410214,
						413410215
					],
					"speakerTitle": "小羽"
				},
				{
					"id": 413410214,
					"content": "我来帮忙吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410216
					]
				},
				{
					"id": 413410216,
					"content": "你愿意帮忙吗？那太好了，谢谢你。我还担心我要是去找人帮忙，谁来收拾店里呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小羽"
				},
				{
					"id": 413410215,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410216
					]
				},
				{
					"id": 413410211,
					"content": "家里没有人来挂霄灯吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410212
					]
				}
			]
		},
		{
			"id": 4134104,
			"completionStepIds": [
				4134104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4134104",
							"2"
						],
						"stepId": 4134104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"小羽"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413410401,
					"content": "#这霄灯挂起来真好看，谢谢你，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410402
					],
					"speakerTitle": "小羽"
				},
				{
					"id": 413410402,
					"content": "那小羽…我们出去玩吧，我知道一个地方，那里的花可漂亮了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410403
					],
					"speakerTitle": "蒙蒙"
				},
				{
					"id": 413410403,
					"content": "#刚才{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}教我编霄灯了，去那边之后，我也教你编好不好？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410404
					],
					"speakerTitle": "蒙蒙"
				},
				{
					"id": 413410404,
					"content": "这个…还不行，我还得收拾店里，虽然没多少客人，但店里必须保持干净才好，这是爸爸叮嘱我的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410405
					],
					"speakerTitle": "小羽"
				},
				{
					"id": 413410405,
					"content": "那…那我们不编霄灯，去那边说一会话好不好？一会就回来了，不耽误时间的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410406
					],
					"speakerTitle": "蒙蒙"
				},
				{
					"id": 413410406,
					"content": "可是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410407,
						413410408
					],
					"speakerTitle": "小羽"
				},
				{
					"id": 413410407,
					"content": "我来帮忙打扫店里吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410409
					]
				},
				{
					"id": 413410409,
					"content": "欸？可以吗？这也、这也太麻烦你了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410410
					],
					"speakerTitle": "小羽"
				},
				{
					"id": 413410410,
					"content": "我们就去一小会，一小会就回来了，不会耽误很多时间的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410411
					],
					"speakerTitle": "蒙蒙"
				},
				{
					"id": 413410411,
					"content": "#那就拜托你啦，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，谢谢你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蒙蒙"
				},
				{
					"id": 413410408,
					"content": "打扫的事就交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410409
					]
				}
			]
		},
		{
			"id": 4134107,
			"completionStepIds": [
				4134107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4134107",
							"2"
						],
						"stepId": 4134107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"小羽"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413410701,
					"content": "好像是他们两个，还在玩的样子，看来不用太担心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410702
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413410702,
					"content": "不过现在这个气氛，好像不应该靠过去？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410703,
						413410704
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413410703,
					"content": "想听听他们在说什么…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410705
					]
				},
				{
					"id": 413410705,
					"content": "给小羽的爸爸编花环，他会好得快一点吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410706
					],
					"speakerTitle": "蒙蒙"
				},
				{
					"id": 413410706,
					"content": "我不知道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410707
					],
					"speakerTitle": "小羽"
				},
				{
					"id": 413410707,
					"content": "书上说，只要过得开心，就算生病也会好得很快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410708
					],
					"speakerTitle": "蒙蒙"
				},
				{
					"id": 413410708,
					"content": "蒙蒙觉得，小羽已经这么懂事了，天天都在帮忙看店，小羽的爸爸，一定很开心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410709
					],
					"speakerTitle": "蒙蒙"
				},
				{
					"id": 413410709,
					"content": "但，爸爸有时候还说我来着…「别老是窝在店里，多出去玩」什么的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410710
					],
					"speakerTitle": "小羽"
				},
				{
					"id": 413410710,
					"content": "「你不陪蒙蒙玩，她能把周围的花都采秃咯。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410711
					],
					"speakerTitle": "小羽"
				},
				{
					"id": 413410711,
					"content": "这里有很多花，才不会采完呢…等一下，我编一个花环给你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410712
					],
					"speakerTitle": "蒙蒙"
				},
				{
					"id": 413410712,
					"content": "谢谢你蒙蒙，我们也该回去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410713
					],
					"speakerTitle": "小羽"
				},
				{
					"id": 413410713,
					"content": "好吧…那等你爸爸身体好了之后，你是不是就有时间了？到时候我再来找你玩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410714
					],
					"speakerTitle": "蒙蒙"
				},
				{
					"id": 413410714,
					"content": "嗯，爸爸的身体一定会好得很快的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410715
					],
					"speakerTitle": "小羽"
				},
				{
					"id": 413410715,
					"content": "#欸？！{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}…你，你什么时候来的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410716,
						413410717
					],
					"speakerTitle": "小羽"
				},
				{
					"id": 413410716,
					"content": "刚来不久。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410718
					]
				},
				{
					"id": 413410718,
					"content": "唔唔唔…我…我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410719
					],
					"speakerTitle": "小羽"
				},
				{
					"id": 413410719,
					"content": "海灯节快乐。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410720
					]
				},
				{
					"id": 413410720,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}也是，海灯节快乐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410721
					],
					"speakerTitle": "蒙蒙"
				},
				{
					"id": 413410721,
					"content": "海…海灯节快乐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410722
					],
					"speakerTitle": "小羽"
				},
				{
					"id": 413410722,
					"content": "那个，谢谢你帮忙，这些东西请收下吧。爸爸说，拜托人做事要准备好报酬的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410723
					],
					"speakerTitle": "小羽"
				},
				{
					"id": 413410723,
					"content": "我们…我们就先回店里了，走吧蒙蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410724
					],
					"speakerTitle": "小羽"
				},
				{
					"id": 413410724,
					"content": "#嗯，我们回去吧，谢谢你，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蒙蒙"
				},
				{
					"id": 413410717,
					"content": "什么也没听到。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410718
					]
				},
				{
					"id": 413410704,
					"content": "听听他们在说什么吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410705
					]
				}
			]
		},
