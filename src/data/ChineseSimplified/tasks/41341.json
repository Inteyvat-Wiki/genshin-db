			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"蒙蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413410101,
					"content": "编霄灯好难啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410102
					],
					"speakerTitle": "蒙蒙"
				},
				{
					"id": 413410102,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410103
					]
				},
				{
					"id": 413410103,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，你知道怎么编霄灯吗？蒙蒙不会编霄灯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410104
					],
					"speakerTitle": "蒙蒙"
				},
				{
					"id": 413410104,
					"content": "穿过去，弄过来，一不小心材料就掉了，要不然就把线弄断了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410105
					],
					"speakerTitle": "蒙蒙"
				},
				{
					"id": 413410105,
					"content": "蒙蒙本来是想编盏霄灯送给小羽的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410106
					],
					"speakerTitle": "蒙蒙"
				},
				{
					"id": 413410106,
					"content": "小羽一直在看茶店，没有时间玩，也没有时间做霄灯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410107
					],
					"speakerTitle": "蒙蒙"
				},
				{
					"id": 413410107,
					"content": "但是小羽应该有愿望想要许吧，所以蒙蒙就想编一盏霄灯送给他…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410108,
						413410109
					],
					"speakerTitle": "蒙蒙"
				},
				{
					"id": 413410108,
					"content": "我来帮你编吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410110
					]
				},
				{
					"id": 413410110,
					"content": "可是，蒙蒙想自己编好之后送给小羽…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410111
					],
					"speakerTitle": "蒙蒙"
				},
				{
					"id": 413410111,
					"content": "而且，蒙蒙想知道做霄灯的诀窍，这样我还可以讲给小羽听。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410112
					],
					"speakerTitle": "蒙蒙"
				},
				{
					"id": 413410112,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，你能…你能教蒙蒙编一下霄灯吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410113
					],
					"speakerTitle": "蒙蒙"
				},
				{
					"id": 413410113,
					"content": "没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410114
					]
				},
				{
					"id": 413410114,
					"content": "#谢谢{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410115
					],
					"speakerTitle": "蒙蒙"
				},
				{
					"id": 413410115,
					"content": "霄灯这样应该就…算是做好了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410116
					],
					"speakerTitle": "蒙蒙"
				},
				{
					"id": 413410116,
					"content": "#谢谢你，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}！我们赶快把霄灯送给小羽吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蒙蒙"
				},
				{
					"id": 413410109,
					"content": "我编一个给你好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410110
					]
				}
			]
		},
		{
			"id": 4134102,
			"completionStepIds": [
				4134102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
