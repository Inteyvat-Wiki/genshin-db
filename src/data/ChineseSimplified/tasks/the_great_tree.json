			},
			"dialogs": [
				{
					"id": 230271101,
					"content": "你们回来了，圣树根系的情况怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230271102
					],
					"speakerTitle": "雅丝敏"
				},
				{
					"id": 230271102,
					"content": "向雅丝敏叙述了根系的情况…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230271103
					]
				},
				{
					"id": 230271103,
					"content": "…喔，既然有生物聚集在那里，那就说明那块土地还有着很强的活力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230271104
					],
					"speakerTitle": "雅丝敏"
				},
				{
					"id": 230271104,
					"content": "圣树的根系一定也能安稳地生长，暂时不会出太大的问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230271105
					],
					"speakerTitle": "雅丝敏"
				},
				{
					"id": 230271105,
					"content": "唯一要担心的问题…就是周围的水体会不会过营养化，从而滋生更多的蕈兽…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230271106
					],
					"speakerTitle": "雅丝敏"
				},
				{
					"id": 230271106,
					"content": "喔，这是你们的报酬，谢谢你们帮忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230271107
					],
					"speakerTitle": "雅丝敏"
				},
				{
					"id": 230271107,
					"content": "还是要让拉德普和法尔希监控一下周围的元素浓度才行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雅丝敏"
				}
			]
		}
	]
}