					"雅丝敏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230270101,
					"content": "果然还是得好好照看一下啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270102
					],
					"speakerTitle": "雅丝敏"
				},
				{
					"id": 230270102,
					"content": "你在做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270103
					]
				},
				{
					"id": 230270103,
					"content": "你是…喔，看样子是位旅行者，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270104
					],
					"speakerTitle": "雅丝敏"
				},
				{
					"id": 230270104,
					"content": "我是阿弥利多学院的学生，雅丝敏，正在这里研究这棵「圣树」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270105
					],
					"speakerTitle": "雅丝敏"
				},
				{
					"id": 230270105,
					"content": "这棵「圣树」历经的岁月，比奥摩斯港里所有手抓饭的饭粒数量加起来都多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270106
					],
					"speakerTitle": "雅丝敏"
				},
				{
					"id": 230270106,
					"content": "同时它又托举着教令院…重要性堪比唐杜尔烤鸡底下垫着的蔬菜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270107,
						230270108
					],
					"speakerTitle": "雅丝敏"
				},
				{
					"id": 230270107,
					"content": "这都是些什么比喻…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270110
					]
				},
				{
					"id": 230270110,
					"content": "但如果它出了问题，那须弥城也会面临巨大的灾难。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270111
					],
					"speakerTitle": "雅丝敏"
				},
				{
					"id": 230270111,
					"content": "比如，它遭到了虫害，比屋顶还大的蝗虫从树的内部冲出…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270112
					],
					"speakerTitle": "雅丝敏"
				},
				{
					"id": 230270112,
					"content": "或者是它的枝干生长失去控制，庞大的根系宛如洪水般从地底涌出，摧毁了所有房屋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270113
					],
					"speakerTitle": "雅丝敏"
				},
				{
					"id": 230270113,
					"content": "又或者，这棵「圣树」飞速枯萎，倒下的树身压垮了半个须弥城…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270114
					],
					"speakerTitle": "雅丝敏"
				},
				{
					"id": 230270114,
					"content": "应，应该不会这样吧？！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270115
					]
				},
				{
					"id": 230270115,
					"content": "喔，那当然，到目前为止，它的情况一切正常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270116
					],
					"speakerTitle": "雅丝敏"
				},
				{
					"id": 230270116,
					"content": "但话也说回来，在你去树林摘蘑菇的时候，袭击你的蕈兽也不会提前告知你它们的到来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270117
					],
					"speakerTitle": "雅丝敏"
				},
				{
					"id": 230270117,
					"content": "我之所以在此研究，也是在观察这棵大树的情况，为各种可能发生的意外做准备。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270118
					],
					"speakerTitle": "雅丝敏"
				},
				{
					"id": 230270118,
					"content": "不过如你所见，就算我的思维如同暝彩鸟一般敏捷，但我的体力也如同星蕈一般孱弱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270119
					],
					"speakerTitle": "雅丝敏"
				},
				{
					"id": 230270119,
					"content": "所以旅行者，你能帮我去记录几处「圣树」根系的状况吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270120
					],
					"speakerTitle": "雅丝敏"
				},
				{
					"id": 230270120,
					"content": "平时我都会雇佣冒险家和我同行，但现在他们似乎都没空…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270121,
						230270122
					],
					"speakerTitle": "雅丝敏"
				},
				{
					"id": 230270121,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230270122,
					"content": "你们学者都是这么说话的吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270123
					]
				},
				{
					"id": 230270123,
					"content": "欸？你是说这些比喻吗？抱歉呀，我的说话方式一直是这样的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270124
					],
					"speakerTitle": "雅丝敏"
				},
				{
					"id": 230270124,
					"content": "学院里也有很多人和我说过这个问题，但我一时半会是改不回来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270125
					],
					"speakerTitle": "雅丝敏"
				},
				{
					"id": 230270125,
					"content": "那这件事就拜托你了，我就在这里等着你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雅丝敏"
				},
				{
					"id": 230270108,
					"content": "派蒙肯定能听懂吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270109
					]
				},
				{
					"id": 230270109,
					"content": "真是一棵很伟大的树啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270110
					],
					"speakerTitle": "派蒙"
				}
			]
		},
