				"points": []
			},
			"dialogs": [
				{
					"id": 230270201,
					"content": "旅行者，真巧，又见到你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270202
					],
					"speakerTitle": "雅丝敏"
				},
				{
					"id": 230270202,
					"content": "你还在研究吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270203
					]
				},
				{
					"id": 230270203,
					"content": "嗯，拉德普和法尔希说还需要搜集更多数据，我就只能继续我的工作啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270204
					],
					"speakerTitle": "雅丝敏"
				},
				{
					"id": 230270204,
					"content": "不过，也不知道那些根系现在是什么情况…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270205
					],
					"speakerTitle": "雅丝敏"
				},
				{
					"id": 230270205,
					"content": "旅行者，如果你有空的话，就请再帮我去记录一下那些根系的情况吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雅丝敏"
				}
			]
		},
