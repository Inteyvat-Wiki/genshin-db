			"dialogs": [
				{
					"id": 705400101,
					"content": "嘶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400102
					],
					"speakerTitle": "「大桔骑士」"
				},
				{
					"id": 705400102,
					"content": "呜…罗莎莉亚小姐，它好凶好凶，我好怕！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400103
					],
					"speakerTitle": "瓦乐瑞娜"
				},
				{
					"id": 705400103,
					"content": "你还是退后吧，不然会被它抓成大花脸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400104
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 705400104,
					"content": "怎么回事？瓦乐瑞娜小姐被猫猫欺负了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400105,
						705400106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705400105,
					"content": "难道是流浪猫的入侵者…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705400107
					]
				},
				{
					"id": 705400107,
					"content": "荣誉骑士！白猫魔法师！「雪糕」出去散步的时候，那只大猫盯上了它，跟着它闯了进来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400108
					],
					"speakerTitle": "瓦乐瑞娜"
				},
				{
					"id": 705400108,
					"content": "不用这么紧张，这里不会有人伤害你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400109
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 705400109,
					"content": "凶恶的东西，会让你去做坏事的家伙们，都被城墙挡在外边了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400110
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 705400110,
					"content": "有些老好人会围着你转，虽然偶尔有点烦，但他们都是为了你好。放松下来，习惯悠闲的生活，也还不错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400111
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 705400111,
					"content": "嘶——呜——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400112
					],
					"speakerTitle": "「大桔骑士」"
				},
				{
					"id": 705400112,
					"content": "那，那只大猫居然听懂了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400113
					],
					"speakerTitle": "瓦乐瑞娜"
				},
				{
					"id": 705400113,
					"content": "好像有效果了，看来这只猫还挺聪明的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400114
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 705400114,
					"content": "比起其他的猫猫，它好大好大，颜色又像泡泡桔的果汁。仔细看，它还戴着一个围巾，围巾上还有骑士团的标志呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705400115,
					"content": "不如，我们就叫它「大桔骑士」好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705400116,
					"content": "喵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400117
					],
					"speakerTitle": "「大桔骑士」"
				},
				{
					"id": 705400117,
					"content": "你的方法还真灵验，它彻底放下了戒心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400118
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 705400118,
					"content": "但我觉得，「大桔骑士」和罗莎莉亚聊了两句以后，就没那么凶了，所以这回是罗莎莉亚立大功！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400119,
						705400120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705400119,
					"content": "罗莎莉亚和猫猫的关系变好了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705400121
					]
				},
				{
					"id": 705400121,
					"content": "无所谓吧，可爱的麻烦倒是不嫌多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400122
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 705400122,
					"content": "#接下来，{NICKNAME}，我们就多多使用猫猫魔法，让不知道为什么生气的「大桔骑士」彻底放松下来，开开心心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705400120,
					"content": "罗莎莉亚的特别工作更开心了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705400121
					]
				},
				{
					"id": 705400106,
					"content": "又有点像猫猫独行骑士。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705400107
					]
				}
			]
		}
	]
}