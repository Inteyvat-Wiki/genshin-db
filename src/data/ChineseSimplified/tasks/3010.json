			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"纳西妲"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30100101,
					"content": "我、我全都想起来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30100102,
					"content": "…很好，这次你们适应得很快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100103
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30100103,
					"content": "昨晚的最后…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100104
					]
				},
				{
					"id": 30100104,
					"content": "对啊，昨晚我们明明摘掉了虚空，却还是听到了虚空的音效，那是怎么回事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100105,
						30100106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30100105,
					"content": "我们被植入了其他形式的虚空终端？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100107
					]
				},
				{
					"id": 30100107,
					"content": "不过这下基本可以确认，我们现在被困在同一天里出不去的状态，是跟虚空有关联了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30100108,
					"content": "如果说是虚空要「偷取」大家的智慧的话，又到底为什么会造成现在这种状况呢…想不明白。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30100109,
					"content": "在实验台上的小白鼠，想要获知自己为何被如此对待，的确是一件极其困难的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100110
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30100110,
					"content": "把我们两个比作小白鼠吗，那你又是什么呢，纳西妲，你一直都不告诉我们你的身份…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30100111,
					"content": "嗯…我是「月亮」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100112
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30100112,
					"content": "月亮？那不是我们做过的占卜的结果吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30100113,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100114
					]
				},
				{
					"id": 30100114,
					"content": "好了，知晓我是谁并不会对你们了解真相有什么用处的，还是把注意力放在别处吧，当心漏掉什么线索哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100115
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30100115,
					"content": "唔…好吧。既然昨天迪希雅帮上了很多忙，不如还是先找她会合吧。这个时间的话，差不多那些绑匪快要出现了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30100106,
					"content": "我们只是以为自己摘掉了虚空终端？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100107
					]
				}
			]
		},
		{
			"id": 301002,
			"completionStepIds": [
				301002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"301002",
							"2"
						],
						"stepId": 301002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"迪希雅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30100201,
					"content": "你们在这儿啊，那些绑匪我已经解决了，小姐没受伤吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100202
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30100202,
					"content": "等等，好像有哪里不对…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100203
					]
				},
				{
					"id": 30100203,
					"content": "欸…迪希雅…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30100204,
					"content": "怎么了？你们两个为什么这样盯着我看？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100205
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30100205,
					"content": "你、你这次为什么没有受伤！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30100206,
					"content": "啊？这次是什么意思，还有，我为什么一定要受伤，那只是些有三脚猫功夫的绑匪而已啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100207,
						30100208
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30100207,
					"content": "你的大剑应该用起来不顺手吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100209
					]
				},
				{
					"id": 30100209,
					"content": "嘘…你怎么会知道大剑的事，我应该从来没跟别人说过，可别让小姐知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100210
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30100210,
					"content": "果然迪希雅的记忆还是没有了呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100211,
						30100212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30100211,
					"content": "在这次战斗中…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100213
					]
				},
				{
					"id": 30100213,
					"content": "奇怪的地方…硬要说的话，你们也知道我换了大剑的嘛，可不知为何好像新的大剑用起来很趁手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100214
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30100214,
					"content": "就像…就像是已经拿着它经历过无数次战斗了一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100215
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30100215,
					"content": "是说虽然记忆中没有跟它一起战斗的经历，但好像身体却有…是这样的感觉吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30100216,
					"content": "没错，不论是对佣兵还是武者而言，「身体记忆」才是最重要的，一招一式靠大脑记住也只是花架子而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100217
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30100217,
					"content": "旅行者，你怎么看？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100218,
						30100219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30100218,
					"content": "难道是昨晚摘掉虚空的影响？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100220
					]
				},
				{
					"id": 30100220,
					"content": "是呀，总感觉看到了希望一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30100221,
					"content": "有没有可能…我们已经脱困了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100222
					]
				},
				{
					"id": 30100222,
					"content": "欸！是哦，在之前的「花神诞日的轮回」中，是不可能出现这种情况的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30100223,
					"content": "等今天结束就知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100224
					]
				},
				{
					"id": 30100224,
					"content": "虽然我听不懂你们在讨论什么，但危险还…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100225
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30100225,
					"content": "危险还没有解除，所以你想让我们先带迪娜泽黛去那边休息，你来探查一下那些绑匪还有没有同伙，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30100226,
					"content": "你怎么知道我想说这些…读心术？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100227
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30100227,
					"content": "好啦，快去做吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30100219,
					"content": "第一次出现这样的事件变化…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100220
					]
				},
				{
					"id": 30100212,
					"content": "你有没有什么觉得奇怪的地方？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100213
					]
				},
				{
					"id": 30100208,
					"content": "所以原本应该会受点擦伤的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100209
					]
				}
			]
		},
		{
			"id": 301003,
			"completionStepIds": [
				301003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"301003",
							"2"
						],
						"stepId": 301003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"纳西妲"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30100301,
					"content": "…呼，终于到晚上了，除了那件事之外，今天好像也没什么其他变化了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30100302,
					"content": "纳西妲，听我说，我们今天发现，原本每次击败绑匪后都会受伤的迪希雅，今天没有受伤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30100303,
					"content": "你说会不会「花神诞日的轮回」已经结束了呀？迪娜泽黛是不是要有救了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30100304,
					"content": "哦？有了这样的进展啊，不错不错。既然如此，今天就好好休息吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100305
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30100305,
					"content": "喂，这是什么模棱两可的答案呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30100306,
					"content": "明天会到来，这件事对所有人来讲都是常识。但其实明天是否真的会到来，只有身处明天的你才知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100307
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30100307,
					"content": "今天已经过了多少次？今天之后有没有可能是昨天？明天这个词是否从来都是被捏造出来的概念？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100308
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30100308,
					"content": "也或许，整个世界都是虚假的，这片大陆的历史就是一场漫长的「花神诞祭」呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100309
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30100309,
					"content": "好了好了，不要说下去了，我的头脑本来就很累了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30100310,
					"content": "呵呵…所以说，明天自然就会知道的事情，今天就不要耗费无意义的脑力了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100311
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30100311,
					"content": "好好休息吧，比如痛痛快快去上个厕所什么的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100312
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30100312,
					"content": "啊？等等，你刚才说什么？我听错了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30100313,
					"content": "嗯？人们都说上完厕所会觉得神清气爽，所以推荐你们去而已，很奇怪吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100314
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30100314,
					"content": "呃…太过奇怪也太过没有常识，以至于不知道该说什么…明明刚才好像还在讲什么大道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30100315,
					"content": "那我们先回去休息了。",
