				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"梅蒂"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760141401,
					"content": "#怎么了，{M#大哥}{F#大姐}？还有什么想问的事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141402,
						760141406,
						760141409,
						760141413,
						760141426
					],
					"speakerTitle": "梅蒂"
				},
				{
					"id": 760141402,
					"content": "关于那只螃蟹…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141403
					]
				},
				{
					"id": 760141403,
					"content": "唉，那家伙虽然看上去很吓人，其实性子一直都挺温和的。没了那块奇怪的石头，之后应该也会恢复正常吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141404
					],
					"speakerTitle": "梅蒂"
				},
				{
					"id": 760141404,
					"content": "至于现在嘛，就让它躲起来老老实实反省吧。不管受到什么影响，做过的坏事依然是做过的坏事，被它伤到的小螃蟹依然受了伤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141405
					],
					"speakerTitle": "梅蒂"
				},
				{
					"id": 760141405,
					"content": "就和大盗雷德·米勒当初对付的、被镜子迷惑的坏总督一样，找再多借口也没意义，悔罪总归是得有实际行动的呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "梅蒂"
				},
				{
					"id": 760141406,
					"content": "关于那块奇怪的石头…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141407
					]
				},
				{
					"id": 760141407,
					"content": "哼哼，那就是能操纵人心的{RUBY#[D]图瓦道茨基之石}欲之石…嗯，我记得希丁芭大姐说的应该是这个名字吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141408
					],
					"speakerTitle": "梅蒂"
				},
				{
					"id": 760141408,
					"content": "咳，总、总之，看来和霜月那边的大石头一样，是从天上掉下来的玩意儿。既然飞走了，应该也不会对我们构成什么威胁了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "梅蒂"
				},
				{
					"id": 760141409,
					"content": "关于海螺帮…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141410
					]
				},
				{
					"id": 760141410,
					"content": "#嗯？{M#大哥}{F#大姐}想知道海螺帮的事呀。没问题，既然{M#大哥}{F#大姐}已经是海螺帮的朋友了，想问什么都行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141411
					],
					"speakerTitle": "梅蒂"
				},
				{
					"id": 760141411,
					"content": "#我们算是…嗯，同路的同龄人之间的「互助协调组织」吧。虽说{M#大哥}{F#大姐}的年龄应该没办法加入我们了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141412
					],
					"speakerTitle": "梅蒂"
				},
				{
					"id": 760141412,
					"content": "但要是在那夏镇有什么需要「互帮互助」的事，只要是我能帮上忙的，就告诉我好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "梅蒂"
				},
				{
					"id": 760141413,
					"content": "关于之前那个奇怪的人…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141414
					]
				},
				{
					"id": 760141414,
					"content": "哦，你说那个紫色祭司啊。既然那家伙暂时没对咱们出手，就说明至少她现在不是我们的敌人，她的事咱们尽量也少管。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141415
					],
					"speakerTitle": "梅蒂"
				},
				{
					"id": 760141415,
					"content": "好奇心是会要了命的。卡嘉大姐也说，尽量别和霜月那群怪人接触。就连我这种大盗，之前也差点被他们抓住、献祭给月神了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141416
					],
					"speakerTitle": "梅蒂"
				},
				{
					"id": 760141416,
					"content": "献祭？！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141417
					]
				},
				{
					"id": 760141417,
					"content": "是啊，那群家伙邪乎得很，据说还会把不同人的血…唔，想想就觉得可怕，还是不说了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141418
					],
					"speakerTitle": "梅蒂"
				},
				{
					"id": 760141418,
					"content": "幸亏当时抓住我的是个什么都不懂的小丫头，稍微给她讲几个故事，她就愿意放过我了。要不然啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141419
					],
					"speakerTitle": "梅蒂"
				},
				{
					"id": 760141419,
					"content": "#我、我倒是也没在怕啦，大盗当然是不会害怕的！只是劝{M#大哥}{F#大姐}一句，尽量少掺和他们的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141420
					],
					"speakerTitle": "梅蒂"
				},
				{
					"id": 760141420,
					"content": "啊，对了，差点忘了，之前说好的情报源。关于霜月之子的事，都是希丁芭大姐告诉我的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141421
					],
					"speakerTitle": "梅蒂"
				},
				{
					"id": 760141421,
					"content": "要是想找她的话…嗯，她应该还在那夏镇附近吧？稍微打听一下，应该很快就能找到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141422,
						760141424
					],
					"speakerTitle": "梅蒂"
				},
				{
					"id": 760141422,
					"content": "她大概要隐退一段时间了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141423
					]
				},
				{
					"id": 760141423,
					"content": "#嗯？原来{M#大哥}{F#大姐}已经见过希丁芭大姐了吗？隐退的事情我可没听她说过…算了，之后再打听吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "梅蒂"
				},
				{
					"id": 760141424,
					"content": "听着感觉心里没底…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141425
					]
				},
				{
					"id": 760141425,
					"content": "别担心，她超靠谱的。我梅蒂都这么保证了，不用觉得没底啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "梅蒂"
				},
				{
					"id": 760141426,
					"content": "再见。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141427
					]
				},
				{
					"id": 760141427,
					"content": "好，一路顺风啊，伙计。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "梅蒂"
				}
			]
		},
		{
			"id": 7601417,
			"completionStepIds": [
				7608202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
