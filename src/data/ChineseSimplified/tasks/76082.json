			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"梅蒂",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760141701,
					"content": "呜哇！这家伙是不是好像比之前更大了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141702
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760141702,
					"content": "哼哼，那是当然的。吃了我辛辛苦苦找回来的这么多白灵果，现在的沙皇老爷已经是比派蒙还要圆润的沙皇老爷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141703
					],
					"speakerTitle": "梅蒂"
				},
				{
					"id": 760141703,
					"content": "喂！不要拿我做这种奇怪的比较啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141704
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760141704,
					"content": "#呜哦！怎么了？看到{NICKNAME}{M#大哥}{F#大姐}，好像突然变得很有精神…或者说兴奋起来了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141705
					],
					"speakerTitle": "梅蒂"
				},
				{
					"id": 760141705,
					"content": "#好像是打算和{NICKNAME}{M#大哥}{F#大姐}比试比试…哈，是因为之前被打得毫无还手之力，所以不服气吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141706,
						760141708
					],
					"speakerTitle": "梅蒂"
				},
				{
					"id": 760141706,
					"content": "正合我意！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141707
					]
				},
				{
					"id": 760141707,
					"content": "#小心点哪，{M#大哥}{F#大姐}。这家伙现在可比上次更强了喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "梅蒂"
				},
				{
					"id": 760141708,
					"content": "欸？现在吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141709
					]
				},
				{
					"id": 760141709,
					"content": "#也没必要任着它的性子来啦，等{M#大哥}{F#大姐}有兴趣了再回应它的挑战也没关系。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141710
					],
					"speakerTitle": "梅蒂"
				},
				{
					"id": 760141710,
					"content": "这家伙现在也算是我罩着的了，我说话它还是会听的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141711
					],
					"speakerTitle": "梅蒂"
				},
				{
					"id": 760141711,
					"content": "来，乖，坐下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141712
					],
					"speakerTitle": "梅蒂"
				},
				{
					"id": 760141712,
					"content": "它是你养的狗吗！不对，螃蟹不一直是坐着的吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
