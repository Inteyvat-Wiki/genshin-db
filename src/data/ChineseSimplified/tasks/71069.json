			"dialogs": [
				{
					"id": 710690101,
					"content": "瞧我说什么来着！你果然没有老老实实看守仓库！$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710690102
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710690102,
					"content": "这下事情闹大了，你想怎么收场呀，阿志？你能负得了擅自解除阵法的责任吗？$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710690103
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710690103,
					"content": "啊，你来了。唉…擅自破坏「磐键」的事情，你怎么解释？$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710690104,
						710690105
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710690104,
					"content": "美观起见，这里拆掉柱子顺眼多了。$UNRELEASED",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710690106
					]
				},
				{
					"id": 710690106,
					"content": "你…！哼，先说好责任由你自负，剩下的等七星怪罪下来再说吧。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710690107
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710690107,
					"content": "嘿嘿，没关系的。沐宁这人就是这样，只会对那些不管事的人发脾气…别看他性子急，人还是不坏的。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710690108
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710690108,
					"content": "不用管他的臭脾气。等你准备好，我就叫上大家一同随你下矿。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710690109
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710690109,
					"content": "啊！抱歉，差点忘了…欢迎加入层岩巨渊勘探队！$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志琼"
				},
				{
					"id": 710690105,
					"content": "如果你真想阻止我，早就赶我走了。$UNRELEASED",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710690106
					]
				}
			]
		}
	]
