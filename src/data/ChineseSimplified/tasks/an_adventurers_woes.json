			},
			"dialogs": [
				{
					"id": 766530301,
					"content": "您总算来了，爱诺…女士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530302
					],
					"speakerTitle": "萨林"
				},
				{
					"id": 766530302,
					"content": "#嗯？这不是大名鼎鼎的{NICKNAME}和{M#他的}{F#她的}精灵旅伴吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530303
					],
					"speakerTitle": "萨林"
				},
				{
					"id": 766530303,
					"content": "你认识我们？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766530304,
					"content": "我叫萨林，是挪德卡莱冒险家协会的分会长。考虑一下你们在冒险家协会内部的声望吧，我不认识你们的话算是严重失职呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530305
					],
					"speakerTitle": "萨林"
				},
				{
					"id": 766530305,
					"content": "哦，原来是这样！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766530306,
					"content": "原来你们认识，不过我还是要确认一下，你的订单是哪个？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530307
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 766530307,
					"content": "我也蛮好奇的，冒险家协会要找爱诺帮什么忙？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766530308,
					"content": "唉…你们知道的，冒险家们在野外遇到的一大问题就是各种拦路的敌人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530309
					],
					"speakerTitle": "萨林"
				},
				{
					"id": 766530309,
					"content": "要是在其他国家，协会还能与当地的管理者合作，为冒险家们提供一些保护。但在挪德卡莱这种地方，协会就只能靠自己了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530310
					],
					"speakerTitle": "萨林"
				},
				{
					"id": 766530310,
					"content": "不久前我想到了一个点子——设计一种可以随身携带的防身装置，让那些不擅长战斗的冒险家也可以击退强大的敌人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530311
					],
					"speakerTitle": "萨林"
				},
				{
					"id": 766530311,
					"content": "可惜最终失败了…我终究没有这方面的才华，只能求助于专业人士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530312
					],
					"speakerTitle": "萨林"
				},
				{
					"id": 766530312,
					"content": "我想起这个订单了，点子很好，设计太差。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530313
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 766530313,
					"content": "所以才要拜托爱诺…女士啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530314
					],
					"speakerTitle": "萨林"
				},
				{
					"id": 766530314,
					"content": "这个订单的难点在于，他设计的防身装置使用了来自其他国家的技术，无法适应挪德卡莱的月矩力环境。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530315
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 766530315,
					"content": "这个订单需要我们做的事并不复杂，主要就是带着他的装置找一些敌人进行测试，然后改进设计。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530316
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 766530316,
					"content": "测试的时候，我也能顺便收集一些与月矩力环境有关的数据，所以这个订单很划算。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530317
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 766530317,
					"content": "不过，自己的身手一定要过关。万一这种装置不顶用，就得靠自己了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530318,
						766530319
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 766530318,
					"content": "问题不大。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766530320
					]
				},
				{
					"id": 766530320,
					"content": "那就拜托各位了，有需要我的地方尽管说。成功之后，挪德卡莱冒险家协会一定会支付丰厚的报酬！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "萨林"
				},
				{
					"id": 766530319,
					"content": "我喜欢战斗！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766530320
					]
				}
			]
		}
	]
}