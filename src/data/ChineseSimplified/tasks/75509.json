			"dialogs": [
				{
					"id": 755090101,
					"content": "哎，瑞希瑞希！刚才我和阿米娜聊过了——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090102
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 755090102,
					"content": "最近派对一开办，「流泉之众」的客流量直接增加了四成！明明我们还没全力宣传呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090103
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 755090103,
					"content": "再好不过啦，我这边也有好消息：最近来我店里做心理诊疗的客人只余下平常的十分之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090104
					],
					"speakerTitle": "梦见月瑞希"
				},
				{
					"id": 755090104,
					"content": "说明我们达成了目标——借助这场派对改善人们的心情，让大家暂时忘却烦恼，彻底放松下来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090105
					],
					"speakerTitle": "梦见月瑞希"
				},
				{
					"id": 755090105,
					"content": "啊哈哈，下次就把派对办大一点！除了「节拍撞球」，再加入几个新游戏！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090106
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 755090106,
					"content": "到时候，想放松的客人就泡温泉，晒日光浴；想嗨起来的客人就来玩派对上的游戏，「流泉之众」的假日就完美啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090107
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 755090107,
					"content": "嗨！玛拉妮，瑞希！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090108,
						755090109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755090108,
					"content": "音乐游戏天才回来啦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755090110
					]
				},
				{
					"id": 755090110,
					"content": "嗯！看你们的表情，听你们话语里的活力就知道，你们一定也玩得心满意足！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090111
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 755090111,
					"content": "那可不！不止玩了个痛快，还吃饱喝足！特别是不限量的自助…我吃了整整五大份「温泉时光」呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755090112,
					"content": "#至于{NICKNAME}，玩撞球比我吃饭都有劲！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090113,
						755090114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755090113,
					"content": "欸嘿！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755090115
					]
				},
				{
					"id": 755090115,
					"content": "不得不说，你们挑战「节拍撞球」的关卡时，观赏性和技术力都快溢出了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090116
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 755090116,
					"content": "下次办派对前，我也来找你出谋划策，怎么样？设计两三个你喜欢的游戏，让大家一起乐开怀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090117
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 755090117,
					"content": "#据我所知，这可是{NICKNAME}的拿手好戏呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090118
					],
					"speakerTitle": "梦见月瑞希"
				},
				{
					"id": 755090118,
					"content": "#我也期待和{NICKNAME}再次合作，不如…干脆给{NICKNAME}申请一间「顾问办公室」，可以吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090119
					],
					"speakerTitle": "梦见月瑞希"
				},
				{
					"id": 755090119,
					"content": "有道理喔，我去问问看！要是还有闲置的房间…不如就安排在你的心理诊疗店旁边？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090120
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 755090120,
					"content": "好主意~这样一来，我们就都是邻居了哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090121,
						755090122
					],
					"speakerTitle": "梦见月瑞希"
				},
				{
					"id": 755090121,
					"content": "我们也要入驻「流泉之众」！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755090123
					]
				},
				{
					"id": 755090123,
					"content": "那我岂不是每天都能吃温泉自助到饱…哎嘿嘿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755090124,
					"content": "有个确切的住址，我要找你们也省了不少事，挺不错的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090125
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755090125,
					"content": "嗯…没想到有一天我也会站在找人的一方考虑问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090126
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755090126,
					"content": "希诺宁！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755090127,
					"content": "你为「节拍撞球」选取的音乐都很棒，我们玩撞球的时候，经常不自觉地跟着摇摆！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755090128,
					"content": "喜欢就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090129
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755090129,
					"content": "经过这几天的观察，我也确定了，你们两位具有「融合」乐手和控碟乐师的独特潜质。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090130
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755090130,
					"content": "也许是因为你们欣赏过许多文化的音乐吧，沉浸在旋律中时，你们会凭本能抓住不同的节奏重点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090131
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755090131,
					"content": "位于理论前沿的音乐向来是倾向于融合的，说不定将来某天，我会来向你们询问音乐元素的建议呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090132
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755090132,
					"content": "收下这个吧，有空的时候可以听听。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090133
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755090133,
					"content": "这是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755090134,
					"content": "喔！希诺宁亲手挑选的唱片，要是放在「花歌唱片店」，可是会瞬间脱销的热门限定商品！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090135
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 755090135,
					"content": "这么说来，之前有位客人因为抢不到希诺宁小姐的推荐唱片和乐器而陷入焦虑，为此，她还来我的店里接受了特别诊疗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090136
					],
					"speakerTitle": "梦见月瑞希"
				},
				{
					"id": 755090136,
					"content": "瑞希小姐，你连这种病症都能治好吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090137
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755090137,
					"content": "我只是消解了她的负面情绪，推荐她去唱片店打零工，如此一来，她就能第一时间拿到消息，买到你的热门推荐啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090138
					],
					"speakerTitle": "梦见月瑞希"
				},
				{
					"id": 755090138,
					"content": "那挺好…但希望她能把这个小诀窍保密，不然，店员的应聘名额只怕也要脱销了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090139,
						755090140
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755090139,
					"content": "总之，我会好好收藏这盒唱片。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755090141
					]
				},
				{
					"id": 755090141,
					"content": "嗯嗯！以后我们一定多听希诺宁推荐的歌！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090142
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755090142,
					"content": "目标是——以后帮忙设计游戏，也要加入和这次一样的…有趣又好摇摆的音乐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090143
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755090143,
					"content": "那就说好啦！下次再见的时候，我们都要互相给大家一个大惊喜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090144
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 755090144,
					"content": "嘿嘿，这次派对还没结束，就开始期待之后的游戏了，搞得我都想在「流泉之众」长住了呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755090140,
					"content": "一有空闲，我们就会认真欣赏。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755090141
					]
				},
				{
					"id": 755090122,
					"content": "我举双手加派蒙的双手赞成！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755090123
					]
				},
				{
					"id": 755090114,
					"content": "不不不，还是没你那股劲头！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755090115
					]
				},
				{
					"id": 755090109,
					"content": "开心的客人要给你们好评。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755090110
					]
				}
			]
		}
	]
}