			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"伯特兰"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726960301,
					"content": "这下所有工序都将就绪了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960302
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726960302,
					"content": "#这样吧，{NICKNAME}，就由你来亲手将「素材收集器」放在机器上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960303
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726960303,
					"content": "真不知道能造出什么样的玩具，还真有点兴奋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960304
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726960304,
					"content": "你居然也不知道会造出什么样的玩具？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726960305,
					"content": "这就是「大工机」的有趣之处啊，哈哈哈，因为它是应对不同的材料相对做出不同的处理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960306
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726960306,
					"content": "做出来的东西取决于你带来了什么，来，快点试试看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伯特兰"
				}
			]
		},
		{
			"id": 7269604,
			"completionStepIds": [
				7269605
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7269605",
							"2"
						],
						"stepId": 7269605,
						"stateName": "QUEST_STATE_UNFINISHED"
