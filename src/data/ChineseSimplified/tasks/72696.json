			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"伯特兰"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726960101,
					"content": "哈啊，真是好险…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960102
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726960102,
					"content": "差一点，就差那么一点…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960103
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726960103,
					"content": "伯特兰，你怎么满脸是汗，好像全身都要虚脱了一样啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726960104,
					"content": "不是「好像要虚脱」，我就是「虚脱」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960105,
						726960106
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726960105,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726960107
					]
				},
				{
					"id": 726960107,
					"content": "嘿嘿，险些失败了，好在我眼疾手快进行了一些紧急的调整，终于稳定下来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960108
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726960108,
					"content": "现在那些元素正一点点和之前收集的原材结合。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960109
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726960109,
					"content": "哎呀，还真是命悬一线啊，要是元素力没控制住，我就可以和长野原家的烟花比比谁在天上更璀璨了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960110
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726960110,
					"content": "之前还说不会爆炸…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726960111
					]
				},
				{
					"id": 726960111,
					"content": "我说的是玩具不会爆炸，我可没保证过制造玩具的机器一定不会爆炸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960112
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726960112,
					"content": "不过这次也正是多亏了有你们帮忙实验，要是直接投产，一个玩具都造不出来不说，连立身之本的「大工机」都得没了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960113
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726960113,
					"content": "好了，现在就是最后的环节，这最后的环节就是「核心激活」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960114
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726960114,
					"content": "核心激活，听你之前的话，是和元素生物有关对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726960115,
					"content": "对，元素生物身上有令元素力不断流动的动力。将这种动力加入机器，就是最后的工序了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960116
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726960116,
					"content": "如果能成功产出玩具，就可以持续不断地生产，用玩具还上欠债，大赚一笔，在稻妻逍遥快活…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960117
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726960117,
					"content": "嗯？你不回枫丹吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726960118,
					"content": "枫丹…呵，枫丹啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960119
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726960119,
					"content": "#{NICKNAME}，派蒙，你们还没有去过枫丹吧，如果你们去过就知道了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960120
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726960120,
					"content": "对于一些人来说，那里是能够便利生活的国度，但对另一些人来说，那里不过是一块失意的伤心地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960121
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726960121,
					"content": "那里的能源体系比较特殊，谁都不知道还能维持多久。在真的崩溃之前，找到替代的能源方案是必须的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960122
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726960122,
					"content": "但是改变总是比想象中困难，结果就是…我现在不得不一个人在枫丹之外研究其他的能量来源。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960123
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726960123,
					"content": "其实「大工机」也是我研究新能源的产物，所以还不是很稳定，一个不注意可能就会产生爆炸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960124
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726960124,
					"content": "不过总有一天我一定会找到一个好的能源方案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960125
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726960125,
					"content": "那时候我就会启程返回枫丹了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960126
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726960126,
					"content": "伯特兰…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726960127,
					"content": "不说这些了，开始最后的工序吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960128
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726960128,
					"content": "#返回枫丹之前，我能在稻妻能过上什么样的生活，可都看你的了，{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726960106,
					"content": "元素反应失败了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726960107
					]
				}
			]
		},
