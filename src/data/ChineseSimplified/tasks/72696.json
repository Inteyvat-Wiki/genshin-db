				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"伯特兰"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726960401,
					"content": "这真的是枫丹机器造出的玩具吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726960402,
					"content": "…总觉得和枫丹印象不符。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726960403
					]
				},
				{
					"id": 726960403,
					"content": "只是做出枫丹风格的玩具机器人，当然是没法获得商业化的成功的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960404
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726960404,
					"content": "实不相瞒，这加入了我对本地流行文化的理解，只有贴近本地居民的心，才会受到本地居民的欢迎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960405
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726960405,
					"content": "真的会受欢迎吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726960406,
					"content": "咳咳…一开始肯定会遭到误解，但是只要持之以恒，改进产品，肯定能打动他们的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960407
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726960407,
					"content": "总而言之，这样就完成一次制造了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960408
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726960408,
					"content": "怎么样，很有趣吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960409
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726960409,
					"content": "一般有趣吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726960410
					]
				},
				{
					"id": 726960410,
					"content": "哼哼，明白了，这样的材料比例能够做出来的玩具是这样的，那我就先把这个收进我的库存里，另外，这张券给你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960417
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726960417,
					"content": "这张券可以免费兑换与这个机器人相同造型的机器人，如果你喜欢这个造型的，稳定生产完成后就用这张券来换就好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960418
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726960418,
					"content": "嗯嗯…毕竟是第一个造出来的玩具机器人，我得进行一些检查，总是做出会爆炸的玩意儿可不行啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960411
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726960411,
					"content": "试运行产生的问题记录…我看看，要提高效率还要做出一些调整。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960412
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726960412,
					"content": "没想到一涉及这些工作，还挺认真的嘛。",
