							16.512,
							0.01,
							21.178
						],
						"pointId": 9
					}
				]
			},
			"dialogs": [
				{
					"id": 705440101,
					"content": "哦呵呵~既是被冠以「猫茸茸城堡」这般奇巧之名的宝地，陈设如此凡俗，未免有些寒碜了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440102
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 705440102,
					"content": "至少得装设几座…紫玛瑙葡萄藤编织而成的秋千！纯净白银的灯盏上，应当是渊水海盐制成的蜡烛，点亮晚星纹样的猫餐盘！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440103
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 705440103,
					"content": "嗯…还有雕像！熔炼失落王朝的古币，以峡湾深底的奇异珍珠和露滴为辅料，打造猫之眷属的雕像，想必是个不错的选择！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440104
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 705440104,
					"content": "你也是这么想的，没错吧，这位猫之眷属…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440105
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 705440105,
					"content": "呃，你还未报上名号来。好好斟酌措辞吧，让本皇女知晓你的名字，可是无上的荣耀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440106
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 705440106,
					"content": "喵？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440107
					],
					"speakerTitle": "「阿呆」"
				},
				{
					"id": 705440107,
					"content": "它叫「阿呆」哦，尊贵的皇女！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705440108,
					"content": "「阿呆」不太懂事，听不懂皇女考究的用词，还请皇女见谅…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705440109,
					"content": "不对不对！怎么一见到菲谢尔，我就自动进入那种状态了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440110,
						705440111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705440110,
					"content": "没什么不好的，我也开演！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705440112
					]
				},
				{
					"id": 705440112,
					"content": "果然，不出所料，两位「猫之魔法师」，你们再次被命运的纽带牵引，来到了本皇女的面前…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440113
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 705440113,
					"content": "真是令人感慨的重逢啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440114
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 705440114,
					"content": "这个称呼…看来菲谢尔已经从瓦乐瑞娜那里听说了我们的事了呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705440115,
					"content": "有你们出谋划策，近来本皇女在幽夜净土深思之时，偶然从过往阅历中寻获的巧念，便能轻松落实了——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440116
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 705440116,
					"content": "本皇女打算遴选感官最为敏锐、才思最为聪颖的猫之眷属，与本皇女同行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440117
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 705440117,
					"content": "喵~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440118
					],
					"speakerTitle": "「阿呆」"
				},
				{
					"id": 705440118,
					"content": "原来菲谢尔也有养猫的打算啊，想来倒也挺正常的，大部分人见识过猫猫的可爱后，应该都会想养一只。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705440119,
					"content": "不过，菲谢尔不是有奥兹陪着吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705440120,
					"content": "你们行动的速度本来就很快，猫猫真的能跟上？还是说…要让奥兹载着猫猫飞行？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705440121,
					"content": "哼哼，本皇女时常跨越三千宇宙，虽说旅途不算漫长，但适当多些伙伴，洞悉易被忽略之物…自然没有坏处！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440122
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 705440122,
					"content": "奥兹也很想与猫之眷属玩…咳！想与猫之眷属通力合作，确保本皇女每时每刻的心绪都如霁月光风！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440123
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 705440123,
					"content": "可惜，即便奥兹难得展示平易近人的姿态，也难以完全隐去身上的威压，没法接近猫之眷属。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440124
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 705440124,
					"content": "距离奥兹不到五步距离时，猫之眷属们的毛发就像是飘散的蓬蓬果，疏忽膨胀开来，随后它们便会陷入惊恐，四散逃开。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440125
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 705440125,
					"content": "虔信风神的忠实修女建议奥兹在外休息，言之有理…我默许了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440126
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 705440126,
					"content": "威压？我好像明白了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705440127,
					"content": "难道说，奥兹身上的雷元素太充沛，一进到「猫茸茸城堡」就会让所有猫猫炸毛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705440128,
					"content": "这样一来，还怎么让猫猫跟着菲谢尔旅行啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705440129,
					"content": "要是提瓦特存在某种材料…能够隔绝雷元素的影响就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705440130,
					"content": "用这种材料给猫猫做衣服，就能让猫猫跟着菲谢尔和奥兹旅行了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705440131,
					"content": "喵？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440132,
						705440133
					],
					"speakerTitle": "「阿呆」"
				},
				{
					"id": 705440132,
					"content": "先给我啊！当然先给我啊！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705440134
					]
				},
				{
					"id": 705440134,
					"content": "不过仔细想想，元素力超级超级厉害，随随便便就能找到抵抗元素力的材料…哪有那么好的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705440135,
					"content": "我们俩也不要做白日梦了啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440136
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705440136,
					"content": "天真！勿要以常理估量猫之眷属的才能！凡人的只言片语难以概括它们的特质。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440137
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 705440137,
					"content": "此世的某地或许存在…能潜入水下，耐受烈火，能乘风而行的猫之眷属，必然也有无惧轰雷的特殊个体。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440138
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 705440138,
					"content": "只要本皇女耐心寻找，定然不会错过，至多再等十年百年，不过幽夜净土时钟上的片刻光阴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440139
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 705440139,
					"content": "此外，后天的修行也相当重要，我看「阿呆」颇有潜质，说不定跟着本皇女一段时间后，对雷之力就会愈发熟悉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440140
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 705440140,
					"content": "正巧本皇女理清了万千繁杂事务，近来还算空闲，不妨在此多多观察猫之眷属们…尤其是「阿呆」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440141
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 705440141,
					"content": "喵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440142
					],
					"speakerTitle": "「阿呆」"
				},
				{
					"id": 705440142,
					"content": "嘿嘿，那就祝你在「猫茸茸城堡」玩得开心啦，菲谢尔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705440133,
					"content": "我穿上它去暴打雷史莱姆！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705440134
					]
				},
				{
					"id": 705440111,
					"content": "大猫之魔法师，前来参谒！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705440112
					]
				}
			]
		}
	]
}