				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3540401,
					"content": "愿风神护佑你，陌生人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540402
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3540402,
					"content": "我是西风骑士团侦察骑士，安柏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540403
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3540403,
					"content": "你不是蒙德市民吧？那么，请说明自己的身份！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540404
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3540404,
					"content": "冷静一下，我们不是可疑人员——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3540405,
					"content": "可疑人员都会这么说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540406
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3540406,
					"content": "#你好，我是{NICKNAME}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3540407
					]
				},
				{
					"id": 3540407,
					"content": "…听着不像是本地人的名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540408
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3540408,
					"content": "还有这只…吉祥物，又是怎么回事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540409,
						3540412
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3540409,
					"content": "是朋友。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3540410
					]
				},
				{
					"id": 3540410,
					"content": "嗯，虽然是认识才两个月的旅伴…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3540411,
					"content": "但已经是最好的朋友了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3540414,
					"content": "总而言之，是旅行者对吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540415
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3540415,
					"content": "最近蒙德周围有巨龙出没，你们还是尽快进城比较好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540416
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3540416,
					"content": "这里离蒙德不远，就由身为骑士的我来护送你们一程。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540417
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3540417,
					"content": "欸？你出城没有什么别的任务吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540418
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3540418,
					"content": "当然有，不过放心，任务路上也会保证你们的安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540419
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3540419,
					"content": "而且…我也不能放着可疑人士不管！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540420,
						3540421
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3540420,
					"content": "看来你不是很信任我们。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3540422
					]
				},
				{
					"id": 3540422,
					"content": "呼…失礼了，这不是一位优秀的骑士应有的言辞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540423
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3540423,
					"content": "我向你们致歉，呃…陌生而可敬的旅人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540424
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3540424,
					"content": "好生硬的发言！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540425
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3540425,
					"content": "你是对我们《骑士团指导手册》里的规范用语有什么不满吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安柏"
				},
				{
					"id": 3540421,
					"content": "这种称呼对客人不礼貌。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3540422
					]
				},
				{
					"id": 3540412,
					"content": "是应急食品。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3540413
					]
				},
				{
					"id": 3540413,
					"content": "完全不对！怎么还不如吉祥物啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540414
					],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}