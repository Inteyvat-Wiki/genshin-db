							"4111307",
							"2"
						],
						"stepId": 4111307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"莫娜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411130701,
					"content": "莫娜，我们问到了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130702
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411130702,
					"content": "高耸入云的雪山，想必那就是黑暗滋生的蘖芽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130703
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 411130703,
					"content": "雪山？就这一条吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130704
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411130704,
					"content": "所有人都梦见同一座雪山。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411130705
					]
				},
				{
					"id": 411130705,
					"content": "高耸入云、见所未见的雪山，温度极低，而且，梦中所有人不受控制地想要登上山顶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130706
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411130706,
					"content": "登上山顶…登上山顶？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130707
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411130707,
					"content": "什么人会想登上山顶？而且如此渴望，甚至能影响到他人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130708
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411130708,
					"content": "雪山上埋着被迫害致死的人吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130709
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 411130709,
					"content": "或者是…对雪山充满渴望的挑战者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130710
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 411130710,
					"content": "我再算一次！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130711
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411130711,
					"content": "有了！隐约能看到一点新线索，他的名字是…<color=#00E1FFFF>莱纳德</color>！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130712
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411130712,
					"content": "哎？！这么快？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130713
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411130713,
					"content": "早就告诉过你了，我是天才呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130714
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411130714,
					"content": "莱纳德…没听过的名字呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
