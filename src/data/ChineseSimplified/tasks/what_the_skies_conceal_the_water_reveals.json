			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"莫娜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411130101,
					"content": "莫娜！托你的福，我们清了好些陨石呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411130102,
					"content": "啊，正好！有件事需要你们去办一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130103
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411130103,
					"content": "记得吗？我说过这片陨石是某个人的命之座。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130104
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411130104,
					"content": "距离遥远的星星突然坠落在地，按理说这不可能。但事实就是如此矛盾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130105
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411130105,
					"content": "想破解谜题，最好的办法就是查清命之座的主人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130106
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411130106,
					"content": "你说过被陨石影响的人会陷入梦境，而且似乎都梦见了一座雪山。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130107
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411130107,
					"content": "未知的高山、覆雪之地…却又不是龙脊雪山，否则一定会有人认出山势的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130108
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411130108,
					"content": "是不是所有人都有着共通的梦境？梦中他们身处什么地方？这些都很重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130109
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411130109,
					"content": "我需要你搜集更多关于梦境的信息。线索越多，越容易查到真相。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130110
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411130110,
					"content": "看来，得找个人多的地方调查一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411130111,
					"content": "再去找些患者问问话吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411130112,
					"content": "我必须留在不受干扰的环境里，调查就拜托你们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130113
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411130113,
					"content": "还有我们没去过的地方吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411130114,
					"content": "在璃月，有一座<color=#00E1FFFF>轻策庄</color>…虽然那里并不是什么「人多的地方」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130115
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 411130115,
					"content": "但我想，那里也许会像望舒客栈一样被千岩军临时征用，成为救治患者的场所吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奥兹"
				}
			]
		},
		{
			"id": 4111302,
			"completionStepIds": [
				4111302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
