			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"高老六"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411131101,
					"content": "呜啊…活过来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131102
					],
					"speakerTitle": "高老六"
				},
				{
					"id": 411131102,
					"content": "请问，你昏睡期间做梦了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411131103,
					"content": "做了做了！可把我累得！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131104
					],
					"speakerTitle": "高老六"
				},
				{
					"id": 411131104,
					"content": "什么梦能把人累成这样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131105,
						411131107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411131105,
					"content": "你梦见自己在山上吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131106
					]
				},
				{
					"id": 411131106,
					"content": "你怎么知道？那是座很高、很冷的雪山…我从没见过那么高的山峰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131109
					],
					"speakerTitle": "高老六"
				},
				{
					"id": 411131109,
					"content": "你去雪山干什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411131110,
					"content": "我也不清楚，就跟中邪一样，梦里只想着要爬山，要到最高峰去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131111
					],
					"speakerTitle": "高老六"
				},
				{
					"id": 411131111,
					"content": "山峰上有什么好东西吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411131112,
					"content": "谁知道呢？我一睡着就跟变了个人一样，你问原因，我也说不上来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131113
					],
					"speakerTitle": "高老六"
				},
				{
					"id": 411131113,
					"content": "不是你自己想爬吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131114
					]
				},
				{
					"id": 411131114,
					"content": "怎么说呢…像是有人控制了我，让我产生这种爬山的念头，别提有多奇怪了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131115
					],
					"speakerTitle": "高老六"
				},
				{
					"id": 411131115,
					"content": "难道说，是黑暗心流？？？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131116
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 411131116,
					"content": "不是自发，而是下意识产生这种愿望。的确很像精神控制呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131117,
						411131118
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 411131117,
					"content": "虽然已经习惯了但还是想说…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131119
					]
				},
				{
					"id": 411131119,
					"content": "这么说，之前那些一个劲说冷的、爬不动了的…也都在雪山上吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411131120,
					"content": "所有人都做同一个梦吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131121
					]
				},
				{
					"id": 411131121,
					"content": "太不可思议了…得快点告诉<color=#00E1FFFF>莫娜</color>才行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411131118,
					"content": "你们俩说的根本不是同一个词...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131119
					]
				},
				{
					"id": 411131107,
					"content": "你梦见自己在雪原上吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131108
					]
				},
				{
					"id": 411131108,
					"content": "不是雪原，是雪山。非常高，而且很冷…我一睡着，就梦见自己站在山脚下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131109
					],
					"speakerTitle": "高老六"
				}
			]
		},
