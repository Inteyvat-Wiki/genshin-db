			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"大黄"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411131401,
					"content": "你好，请问这里有醒来的病人吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411131402,
					"content": "巧了，<color=#00E1FFFF>高老六</color>刚刚醒来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131403
					],
					"speakerTitle": "大黄"
				},
				{
					"id": 411131403,
					"content": "我们就找他！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411131404,
					"content": "不过他昏睡至今，身体十分虚弱。你们若要问话，还请温柔一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131405
					],
					"speakerTitle": "大黄"
				},
				{
					"id": 411131405,
					"content": "不幸的人，你将获得皇女的问候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131406
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 411131406,
					"content": "哎…好饿啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131407
					],
					"speakerTitle": "高老六"
				},
				{
					"id": 411131407,
					"content": "你没事吧？是不是肚子饿得厉害？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411131408,
					"content": "哎…哎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131409,
						411131410
					],
					"speakerTitle": "高老六"
				},
				{
					"id": 411131409,
					"content": "想吃什么？报个菜名。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131411
					]
				},
				{
					"id": 411131411,
					"content": "想吃…家…家乡…菜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131412
					],
					"speakerTitle": "高老六"
				},
				{
					"id": 411131412,
					"content": "轻策庄的家乡菜，一定就是<color=#00E1FFFF>轻策农家菜</color>啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411131410,
					"content": "我可以为你做一顿饭。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131411
					]
				}
			]
		},
		{
			"id": 4111315,
			"completionStepIds": [
				4111315
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
