			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"莫娜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411130715,
					"content": "即使用最简易的占卜，也能察知那个人…是「愚人众执行官」！太危险了，你们怎么会和他有来往？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130716
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411130716,
					"content": "什么，那位少年是愚人众执行官？何等邪恶的人物…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130717
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 411130717,
					"content": "居然是执行官？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411130718
					]
				},
				{
					"id": 411130718,
					"content": "他接近你一定是有所图谋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130719
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411130719,
					"content": "而且他非常强！看上一眼就能感觉到，他的实力超乎想象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130720
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411130720,
					"content": "虽然不想承认，但…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130721
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411130721,
					"content": "难道他比身为罕见占星天才的莫娜女士更强大？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130722
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 411130722,
					"content": "谁、谁说的！他不过是实力险胜一筹而已，单论占星术可比我差远了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130723
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411130723,
					"content": "对了对了，我们在望舒客栈附近也遇到过愚人众的人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130724
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411130724,
					"content": "愚人众为什么对陨石如此关心？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130725
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411130725,
					"content": "果然是有什么阴谋吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130726
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411130726,
					"content": "唔，难道说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130727
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411130727,
					"content": "啊！该不会，这批陨石就是愚人众搞出来的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130728
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411130728,
					"content": "派蒙！你竟敢抢我台词！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130729
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411130729,
					"content": "哎嘿嘿…不好意思，还是我的嘴比较快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130730
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411130730,
					"content": "可是，世上有召唤陨石的法术吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411130731
					]
				},
				{
					"id": 411130731,
					"content": "从天上拉下一颗星星，太夸张了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130732
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411130732,
					"content": "奥兹华尔多·赫芙那梵茵斯，你怎么看？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130733
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 411130733,
					"content": "小姐，我认为一切均有可能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130734
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 411130734,
					"content": "只要投以同等的代价，不祥之种就会在任何地方扎根…愚人众，本皇女记住你们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130735
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 411130735,
					"content": "哈，奇迹也是可能发生的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130736
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 411130736,
					"content": "群星的使者，不愧是我优秀的扈从！我会指派部下保护你，使你免遭黑暗的侵袭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130737
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 411130737,
					"content": "比方说，我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130738
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 411130738,
					"content": "不不不，我们的战斗力安排很合理，保持现在这样就好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130739
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411130739,
					"content": "菲谢尔，你在小看我吗？我可是很强的哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130740
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411130740,
					"content": "没有比你更值得信赖的人了，女士。只不过，皇女也会担心你的安危。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130741
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 411130741,
					"content": "没那个必要。再说，你们所处的环境比我更危险，可能的话，我还想保护你们呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130742,
						411130744
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411130742,
					"content": "莫娜，你人真好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411130743
					]
				},
				{
					"id": 411130743,
					"content": "干、干嘛突然说这种话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130746
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411130746,
					"content": "先解决新的麻烦吧，星盘显示，有一颗<color=#00E1FFFF>巨大的陨石</color>落地了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411130744,
					"content": "菲谢尔，你人真好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411130745
					]
				},
				{
					"id": 411130745,
					"content": "那、那是当然的啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130746
					],
					"speakerTitle": "菲谢尔"
				}
			]
