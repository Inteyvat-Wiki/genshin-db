			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"经纶"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411130201,
					"content": "你好，我们来自冒险家协会。请问轻策庄一带受陨石影响大吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411130202,
					"content": "是冒险家啊！太好了，正愁没人呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130203
					],
					"speakerTitle": "经纶"
				},
				{
					"id": 411130203,
					"content": "这几天，陨石动不动就从天上掉下来，别提有多麻烦了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130204
					],
					"speakerTitle": "经纶"
				},
				{
					"id": 411130204,
					"content": "落在<color=#00E1FFFF>田里</color>，谁都不敢去收粮食，落在<color=#00E1FFFF>大门口</color>，进出又成了问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130205
					],
					"speakerTitle": "经纶"
				},
				{
					"id": 411130205,
					"content": "你们有办法清理这些陨石吗？实在是太碍事了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130206
					],
					"speakerTitle": "经纶"
				},
				{
					"id": 411130206,
					"content": "看来轻策庄也遇到了麻烦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411130207
					]
				},
				{
					"id": 411130207,
					"content": "没办法，该我们出手了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4111303,
