			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"卡维",
					"艾尔海森"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130230101,
					"content": "西拉杰这个名字，我都没印象了。你们那届还有这种人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230102
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 130230102,
					"content": "不是什么让人印象深刻的人，不记得也很正常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230103
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 130230103,
					"content": "教令院就是喜欢给人施加压力，还动不动给人扣上天才奇才之类的帽子，这点我一直很难欣赏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230104
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 130230104,
					"content": "不过就算是这样，教令院也不能交给你来领导。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230105
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 130230105,
					"content": "应该说，我很高兴你还有最基本的自我认知。院里那些人如果没疯，就该明白与其让你当贤者还不如让我来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230106
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 130230106,
					"content": "然后让人知道你的贤者生涯就像那幅挂画一样摇摇欲坠？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230107
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 130230107,
					"content": "你这个马上就要辞职的家伙在说什么呢？过几天就又去管档案了，人生跌回谷底啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230108
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 130230108,
					"content": "但院里发给我的津贴应该不会减。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230109
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 130230109,
					"content": "凭什么？！凭什么啊！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230110
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 130230110,
					"content": "也不用像做建筑设计的人那样，累死累活只为博取委托人一个微笑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230111
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 130230111,
					"content": "你…你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230126
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 130230126,
					"content": "今天就不该好心帮你打扫客厅！我自己还有设计图纸没画完呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230112
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 130230112,
					"content": "记得补交你欠的房租。我打算拿那笔钱添置一些家具。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230113
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 130230113,
					"content": "什…你是想气死我吗？你买的那些摆件一个比一个没有美感，放块干巴巴的木雕在家里有什么意思？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230114
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 130230114,
					"content": "谁让我经济自由呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230115
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 130230115,
					"content": "我说，总拿自己的优势跟别人比也是一种逃避吧？去掉庸俗的金钱，在更有价值的地方比一比。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230116
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 130230116,
					"content": "很难想到有什么是你占上风的。你自己能想到吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230117
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 130230117,
					"content": "艺术性不是吗！都说了你根本不懂室内装潢，不许乱买那些家具，除非带我一起去！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230118
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 130230118,
					"content": "带你去还得请你喝酒是吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230119
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 130230119,
					"content": "当然啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230120
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 130230120,
					"content": "可我为什么要这样做？这只会构成另一种形式的借款而已，你过不了多久就得还我钱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230121
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 130230121,
					"content": "你也可以做一个善良的好人，不向我讨债，不是吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230122
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 130230122,
					"content": "假装自己没有负债，就像假装自己没有住在别人家里一样可笑。其他人迟早会知道的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230123
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 130230123,
					"content": "#说到这个，今天来的家伙应该不会说出去吧？记得叫{M#他}{F#她}们帮我保密。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230124
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 130230124,
					"content": "我倒觉得你早就暴露了，没必要费心掩饰。凭你那几杯倒的酒量，去几次酒馆自然就把秘密全说出去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230125
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 130230125,
					"content": "不会吧？…不对，应该不会吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡维"
				}
			]
		}
	]
}