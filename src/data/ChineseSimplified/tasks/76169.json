			"dialogs": [
				{
					"id": 761690101,
					"content": "#{NICKNAME}，派蒙，你们也来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761690102
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 761690102,
					"content": "我们也来看看他。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761690103
					]
				},
				{
					"id": 761690103,
					"content": "他要是知道了，虽然嘴上不说，心里肯定是高兴的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761690104
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 761690104,
					"content": "和叶洛亚一起在墓前站了一会儿…\\n叶洛亚向先行一步的战友讲述了近来在皮拉米达城发生的大事小事…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761690105
					]
				},
				{
					"id": 761690105,
					"content": "知道皮拉米达城还有大家一切都好，他应该放心了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761690106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761690106,
					"content": "嗯。他完成了他的任务，我们会继续完成我们的任务。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761690107
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 761690107,
					"content": "而在我们之后，也会有其他人，一直守护这片土地，就像冬凌草一样，历经风暴与严寒，也依旧生生不息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "叶洛亚"
				}
			]
		},
