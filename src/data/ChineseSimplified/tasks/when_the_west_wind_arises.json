			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"莎拉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4860203,
					"content": "有什么事吗，莎拉小姐？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860204
					]
				},
				{
					"id": 4860204,
					"content": "抱歉，刚刚已经吃过饭了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860205
					]
				},
				{
					"id": 4860202,
					"content": "终于等到你们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860203
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 4860205,
					"content": "不是在招揽生意啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860206
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 4860206,
					"content": "我要委托骑士团一些事，想要麻烦你们带话给代理团长。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860207
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 4860207,
					"content": "原来是要找琴呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4860209,
					"content": "是互相信赖的同伴。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860210
					]
				},
				{
					"id": 4860211,
					"content": "有过一面之交。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860212
					]
				},
				{
					"id": 4860213,
					"content": "是她忠实的奴仆。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860214
					]
				},
				{
					"id": 4860208,
					"content": "嗯？你们和琴团长很熟吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860209
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 4860210,
					"content": "这样啊？和琴小姐在一起的话，一定很令人安心吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860211
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 4860212,
					"content": "我倒是听说琴小姐很中意你们呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860213
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 4860214,
					"content": "奴，奴仆？西风骑士团难道也要走上旧贵族的道路了吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860215
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 4860215,
					"content": "#对不起，{NICKNAME}的幽默感有时很怪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4860216,
					"content": "所以莎拉小姐要带的话是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4860217,
					"content": "嗯…很不好意思，我现在没法自己去骑士团，因为最近餐馆里实在忙得团团转。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860218
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 4860218,
					"content": "可就在这种时候，我们与清泉镇的食材供应路线，似乎被丘丘人占领了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860219
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 4860220,
					"content": "是要拜托骑士团清理道路吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860221
					]
				},
				{
					"id": 4860222,
					"content": "明白了，该给猎人们一点教训了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860223
					]
				},
				{
					"id": 4860219,
					"content": "但清泉镇的猎人们又一副事不关己的样子，说他们只负责狩猎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860220
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 4860221,
					"content": "没错！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860222
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 4860223,
					"content": "不对吧！那样真的能解决问题吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4860225,
					"content": "没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860226
					]
				},
				{
					"id": 4860224,
					"content": "请代我<color=#00E1FFFF>委托琴团长</color>，安排人手，清理运输路线的丘丘人吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860225
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 4860226,
					"content": "呼…有救了。有琴去处理的话，一定很快就能解决了吧，谢谢啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860227
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 4860227,
					"content": "琴真是被大家信任着呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860228
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4860228,
					"content": "啊，对了。<color=#00E1FFFF>酒保查尔斯</color>先生也说过有些麻烦事的样子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860229
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 4860229,
					"content": "不如你们先顺路去他那里看看？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860230
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 4860230,
					"content": "好吧，帮人帮到底也是派蒙我的作风哦…嗯，虽然好像不是那么顺路的感觉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 48603,
			"completionStepIds": [
				48603
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"48603",
							"2"
						],
						"stepId": 48603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"查尔斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4860301,
					"content": "把我这里当成果汁店了么？小朋友们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860302
					],
					"speakerTitle": "查尔斯"
				},
				{
					"id": 4860302,
					"content": "哼，真是失礼，我们明明是来帮忙的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4860303,
					"content": "帮忙？哦对了，你们是代理团长面前的红人吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860304
					],
					"speakerTitle": "查尔斯"
				},
				{
					"id": 4860304,
					"content": "唔…好奇怪的说法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4860305,
					"content": "那麻烦你们帮我向琴要来这个季度的税收报表。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860306
					],
					"speakerTitle": "查尔斯"
				},
				{
					"id": 4860306,
					"content": "毕竟又到了找埃泽先生汇总账目的时候了…不得不说，蒙德酒水的税费还真是高。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860307
					],
					"speakerTitle": "查尔斯"
				},
				{
					"id": 4860307,
					"content": "这种事也要直接找琴吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860308
					]
				},
				{
					"id": 4860308,
					"content": "可晨曦酒庄依然那么有钱。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860309
					]
				},
				{
					"id": 4860309,
					"content": "那主要还是归功于迪卢克老爷经营有方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860310
					],
					"speakerTitle": "查尔斯"
				},
				{
					"id": 4860310,
					"content": "为什么报表在琴那里，记账也是琴的工作吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4860311,
					"content": "嗯，每一条账目都是代理团长亲自过目的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860312
					],
					"speakerTitle": "查尔斯"
				},
				{
					"id": 4860312,
					"content": "毕竟酒业是蒙德的主要收入来源，琴从来不会在这件事上含糊。",
