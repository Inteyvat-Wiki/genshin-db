			"dialogs": [
				{
					"id": 4861001,
					"content": "咦，是凯亚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861002
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4861002,
					"content": "哦，我正在等你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861003
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4861003,
					"content": "琴病倒的事我已经听说了，我应该代表骑士团的大家向你们表示感谢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861004
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4861004,
					"content": "凯亚突然这么认真地道谢，感觉好不习惯呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861005
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4861005,
					"content": "哈哈，毕竟事关我们所重视的代理团长大人嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861006
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4861006,
					"content": "对了，除了道谢以外，还有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861007
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4861007,
					"content": "要安排工作给我们？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4861008
					]
				},
				{
					"id": 4861008,
					"content": "没错~！我们之间还真是有默契。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861009
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4861009,
					"content": "是给奖励的环节了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4861010
					]
				},
				{
					"id": 4861010,
					"content": "哈哈哈，我喜欢你的说话风格。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861011
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4861011,
					"content": "不过在谈这些之前，希望还能再帮骑士团一些忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861012
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4861012,
					"content": "是要分担琴的工作吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861013
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4861013,
					"content": "是的，虽然你之前汇报给琴的委托已经安排过人去办了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861014
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4861014,
					"content": "…可毕竟不是琴亲自出马，我担心还是会有些纰漏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861015
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4861015,
					"content": "希望你可以去看看还有没有可以搭把手的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861016
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4861016,
					"content": "如果能有享誉蒙德的「荣誉骑士」出手的话，我也就可以放心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861017
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4861017,
					"content": "#即使你再怎么夸{NICKNAME}，我也要说——你为什么不自己去帮忙呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861018
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4861018,
					"content": "哈哈，我的身上还有更重要的任务…有很多东西要…嗯，「准备」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861019
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4861019,
					"content": "哼，那好吧。我记得是…<color=#00E1FFFF>莎拉小姐、查尔斯先生还有玛格丽特小姐</color>那边，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861020
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4861020,
					"content": "没错，那么就辛苦二位了，回头见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凯亚"
				}
			]
