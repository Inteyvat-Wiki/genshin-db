			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"37406",
							"3"
						],
						"stepId": 37406,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"37501",
							"2"
						],
						"stepId": 37501,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"温迪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3750101,
					"content": "唉，果然你也不行吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750102
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3750102,
					"content": "果、果然？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3750103,
					"content": "#只是想看看{NICKNAME}作为骑士团超级新人，究竟够不够分量啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750104
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3750104,
					"content": "你看，勇者顺手就取走了村子里名贵的宝剑——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750105
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3750105,
					"content": "这不是非常适合传唱的故事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750106
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3750106,
					"content": "哼，感觉你的比喻很失礼啊，吟游诗人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3750107,
					"content": "哎呀，你误会我了。这是对蒙德的失望，面对勇者却还要吝啬宝剑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750108
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3750108,
					"content": "那么，看来明借是行不通的，只能巧取了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750109
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3750110,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3750111
					]
				},
				{
					"id": 3750109,
					"content": "今天我们充分尊重自由意志，你们说说喜欢怎样巧取？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750110
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3750112,
					"content": "其实我不想偷东西！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3750113
					]
				},
				{
					"id": 3750111,
					"content": "说吧，不要拘束，自由意志就是要畅所欲言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750112
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3750113,
					"content": "啊哈哈，你看你，一开口就跑题了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750114
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3750114,
					"content": "认真地说，这件事你比我更适合去做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750115
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3750115,
					"content": "因为我除了唱歌，就没什么值得自信的长处了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750116
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3750116,
					"content": "而且我在蒙德无依无靠，被抓住了无人申冤，一定会从重处罚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750117
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3750117,
					"content": "偷东西被抓住了也没什么冤枉吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3750118,
					"content": "#但{NICKNAME}不同。你是为蒙德城作过贡献的，骑士团的明日之星。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750119
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3750119,
					"content": "失手了以后好好解释一下，或许就能蒙混过去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750120
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3750140,
					"content": "而且这里的守卫，似乎在夜里就会下班了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "温迪"
				},
				{
					"id": 3750141,
					"content": "哎呀，如果能抓住这个时机，想要失手都很难呐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "温迪"
				},
				{
					"id": 3750120,
					"content": "不要一直以失手为前提啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3750122,
					"content": "你刚才说自己是巴巴托斯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3750123
					]
				},
				{
					"id": 3750121,
					"content": "#{NICKNAME}…你觉得怎样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750122
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3750123,
					"content": "啊呀，好像是这么说过——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750124
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3750125,
					"content": "如果你真是神，就不能放着不管。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3750126
					]
				},
				{
					"id": 3750124,
					"content": "所以呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750125
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3750126,
					"content": "哦？这是为什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750127
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3750128,
					"content": "如果你不是神，我也会救特瓦林。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3750129
					]
				},
				{
					"id": 3750127,
					"content": "#有关{NICKNAME}的过去，以后再慢慢跟你说吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3750130,
					"content": "我会为你带回「天空」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 3750131,
					"content": "因为我不想再见到「分离」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 3750129,
					"content": "…咦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750130,
						3750131
					],
					"speakerTitle": "温迪"
				}
			]
		},
