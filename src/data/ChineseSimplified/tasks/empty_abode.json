				"points": []
			},
			"dialogs": [
				{
					"id": 3890601,
					"content": "没法更进一步了呢，在这座遗迹里好像有一些非常古老的<color=#00E1FFFF>封印</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890602
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3890602,
					"content": "这也是特瓦林搞的鬼吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890603
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3890603,
					"content": "不是的。这废墟曾经是远古的城市，特瓦林只是在这里临时居住而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890604
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3890604,
					"content": "废墟本身，其实比「四风守护」的时代更古老。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890605
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3890605,
					"content": "蒙德是无人称王的城邦，而在蒙德建立之前…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890606
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3890606,
					"content": "曾有一位暴君统治这里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890607
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3890607,
					"content": "嗯…以后如果有机会，再为你们演奏那位君王的故事吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890608
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3890608,
					"content": "这封印的样式…按我所知的考古学知识，应该是<color=#00E1FFFF>「导光机关」</color>吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890609
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3890609,
					"content": "把散落的所有<color=#00E1FFFF>部件</color>放回<color=#00E1FFFF>本体</color>，就能完成<color=#00E1FFFF>导光的仪式</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890610
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3890610,
					"content": "从现场的状况看，这座机关的导光仪式似乎离完成不远了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890611
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3890611,
					"content": "先把<color=#00E1FFFF>最后的部件</color>放回去，再看看情况吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "琴"
				}
			]
		}
	]
