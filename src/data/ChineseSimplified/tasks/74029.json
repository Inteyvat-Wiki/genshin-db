						"rawParams": [
							"7402901",
							"2"
						],
						"stepId": 7402901,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"伊雅蕾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740290101,
					"content": "为什么要在这种地方放钓竿？难道是在钓鱼吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740290102,
					"content": "又有水，又有钓竿，当然是在钓鱼啦。明明是外边来的人，居然这么没见识，这就是所谓的「世风日下」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290103,
						740290105
					],
					"speakerTitle": "伊雅蕾"
				},
				{
					"id": 740290103,
					"content": "跟世风日下应该没关系…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740290104
					]
				},
				{
					"id": 740290104,
					"content": "对啊！ 再说了，我们可不是对钓鱼一无所知的门外汉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740290107,
					"content": "我想说的是…我还以为美露莘不会用鱼竿钓鱼，而且…唔，感觉怪怪的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740290108,
					"content": "哪、哪里奇怪了？我可是按外边的人教我的方法做的。德拉萝诗很好，不仅教我钓鱼，还送了我钓竿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290109
					],
					"speakerTitle": "伊雅蕾"
				},
				{
					"id": 740290109,
					"content": "虽然她的钓竿看起来比较厉害，不过她是「专业人士」，我只是「爱好者」，所以有这个就够了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290110
					],
					"speakerTitle": "伊雅蕾"
				},
				{
					"id": 740290110,
					"content": "唔…不过我都等了好久了，为什么还不上钩？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290111
					],
					"speakerTitle": "伊雅蕾"
				},
				{
					"id": 740290111,
					"content": "#嘿嘿，既然这样，不如就让{NICKNAME}老师和派蒙老师来帮你分析一下原因吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740290112,
					"content": "#{NICKNAME}老师和派蒙老师真的比她还厉害吗？她可是有着美丽钓竿的专业人士…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290113
					],
					"speakerTitle": "伊雅蕾"
				},
				{
					"id": 740290113,
					"content": "哼，这种时候就该用实力证明自己，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740290114,
					"content": "但是这里真的有鱼吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740290115
					]
				},
				{
					"id": 740290115,
					"content": "哦！说起来的确是这样…一开始我会觉得奇怪也是因为这个！一点鱼的影子都看不到呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740290116,
					"content": "鱼…德拉萝诗说过，水里的不一定都是水产品。唔，「那个」可以算是鱼吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290117
					],
					"speakerTitle": "伊雅蕾"
				},
				{
					"id": 740290117,
					"content": "…难道是因为「那个」不是鱼，所以我用钓「鱼」的办法才钓不上来？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290118
					],
					"speakerTitle": "伊雅蕾"
				},
				{
					"id": 740290118,
					"content": "#{NICKNAME}老师…还有派蒙老师！请教教我，应该怎么做才能把「那个」钓上来呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290119
					],
					"speakerTitle": "伊雅蕾"
				},
				{
					"id": 740290119,
					"content": "哦、哦！伊雅蕾真有礼貌啊…当然没问题了，不过你说的「那个」究竟是指…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740290120,
					"content": "它在水里游得好快，而且滑溜溜好难抓住。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290121,
						740290123
					],
					"speakerTitle": "伊雅蕾"
				},
				{
					"id": 740290121,
					"content": "听起来像鱼。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740290122
					]
				},
				{
					"id": 740290122,
					"content": "其他的水下生物也是有可能的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740290125,
					"content": "唔…总之，至少能确定应该是在水中生活的活物，既然从水面看不到影子，或许是藏在深水处了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740290126,
					"content": "依我看，这种时候就应该用「散饵」，用食物把它从深水处吸引上来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740290127,
					"content": "可是它之前已经吃了很多…不知道换别的鱼饵会不会有用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290128
					],
					"speakerTitle": "伊雅蕾"
				},
				{
					"id": 740290128,
					"content": "嗯，我们先往水里撒一些散饵，之后再准备好鱼竿，最后就只用等它上钩啦。虽然还不知道它是什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740290129,
					"content": "#美丽的钓鱼技巧…我再试试。饵料交给{NICKNAME}老师和派蒙老师，我会看好钓竿做好准备，虽然不是专业人士的美丽钓竿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290130
					],
					"speakerTitle": "伊雅蕾"
				},
				{
					"id": 740290130,
					"content": "没问题，撒散饵这点小事就交给我们好啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740290123,
					"content": "听起来像美露莘。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740290124
					]
				},
				{
					"id": 740290124,
					"content": "是伊雅蕾在和其他美露莘玩假装钓鱼的游戏…这也太奇怪了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740290105,
					"content": "派蒙当然知道钓鱼是怎么回事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740290106
					]
				},
				{
					"id": 740290106,
					"content": "#对啊，毕竟我就是被{NICKNAME}用鱼竿钓起来的嘛…不对，问题不在这里吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290107
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7402902,
