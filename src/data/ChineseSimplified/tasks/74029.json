		},
		{
			"id": 7402903,
			"completionStepIds": [
				7402905
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7402905",
							"2"
						],
						"stepId": 7402905,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"伊雅蕾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740290301,
					"content": "伊雅蕾将虚弱的球球章鱼放入一旁的桶中…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740290302
					]
				},
				{
					"id": 740290302,
					"content": "美丽的捕捞技巧…但是现在它变得不美丽了。怎么会这样呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290303
					],
					"speakerTitle": "伊雅蕾"
				},
				{
					"id": 740290303,
					"content": "抱歉…没想到伊雅蕾说的「那个」是指球球章鱼，一不小心就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290304,
						740290306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740290304,
					"content": "要怪就怪我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740290305
					]
				},
				{
					"id": 740290305,
					"content": "#都怪{NICKNAME}太性急啦！虽然我没拦住你也不对…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740290308,
					"content": "#{NICKNAME}老师和派蒙老师不用这样道歉，它现在已经在桶里了，这样就足够了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290309
					],
					"speakerTitle": "伊雅蕾"
				},
				{
					"id": 740290309,
					"content": "好吧…不过为什么这里会有球球章鱼？是顺着水流意外掉到这里的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740290310,
					"content": "是我从外边抓回来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290311
					],
					"speakerTitle": "伊雅蕾"
				},
				{
					"id": 740290311,
					"content": "欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740290312,
					"content": "因为想要验证用鱼竿钓鱼的方法…所以去抓了「那个」，你们说的球球章鱼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290313
					],
					"speakerTitle": "伊雅蕾"
				},
				{
					"id": 740290313,
					"content": "把它放在这里，就可以随时来钓鱼了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290314
					],
					"speakerTitle": "伊雅蕾"
				},
				{
					"id": 740290314,
					"content": "原本以为是个很好的计划，可是等了很久它都不咬钩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290315
					],
					"speakerTitle": "伊雅蕾"
				},
				{
					"id": 740290315,
					"content": "虽然特意抓了球球章鱼放进水池里用来练习用钓竿钓鱼这点也很令人在意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740290316,
					"content": "不过刚才我们也只是往水里撒了一些散饵就把它吸引到水面了吧？伊雅蕾之前没有想过多撒一些饵料之类的办法吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740290317,
					"content": "之前试过很多饵料，比如肉糜、面包屑、蠕虫、薄荷、零件之类的…它吃过之后就再不出现啦，我还以为饵料对它没用了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290318
					],
					"speakerTitle": "伊雅蕾"
				},
				{
					"id": 740290318,
					"content": "零、零件？！这听起来可不像是饵料…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290319,
						740290321
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740290319,
					"content": "不要拿奇怪的东西喂水产品。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740290320
					]
				},
				{
					"id": 740290320,
					"content": "嗯！不过水产品这个叫法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740290323,
					"content": "嗯，而且零件是很重要的东西，既然不是给球球章鱼吃的饵料，得想个办法取出来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290324
					],
					"speakerTitle": "伊雅蕾"
				},
				{
					"id": 740290324,
					"content": "#对了，为了感谢{NICKNAME}老师和派蒙老师的帮助，这个零件给你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290325
					],
					"speakerTitle": "伊雅蕾"
				},
				{
					"id": 740290325,
					"content": "…不、不用了吧，我们也没帮上什么大忙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290326
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740290326,
					"content": "欸？可是德拉萝诗说过，需要别人帮忙的时候，叫对方「老师」，并且「付费咨询」的话，对方会很高兴。难道不是吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290327
					],
					"speakerTitle": "伊雅蕾"
				},
				{
					"id": 740290327,
					"content": "这个干燥的零件给你们，在海沫村很有用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290328
					],
