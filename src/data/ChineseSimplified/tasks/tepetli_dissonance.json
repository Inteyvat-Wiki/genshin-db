			"dialogs": [
				{
					"id": 150120401,
					"content": "呜哇，跑得好快，也好果断…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120402,
						150120403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150120402,
					"content": "算他们识时务。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120404
					]
				},
				{
					"id": 150120404,
					"content": "呼…太谢谢你们了。要不是你们帮忙，我肯定要被丢下山去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120405
					],
					"speakerTitle": "夏温"
				},
				{
					"id": 150120405,
					"content": "#能让{NICKNAME}出手搭救，我今天的运气也是够好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120406
					],
					"speakerTitle": "夏温"
				},
				{
					"id": 150120406,
					"content": "抱歉，我没做自我介绍，我是夏温，一个倒霉透顶，刚刚才撞了好运的宝石匠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120407
					],
					"speakerTitle": "夏温"
				},
				{
					"id": 150120407,
					"content": "是伊蜜拜托我们来的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120408
					]
				},
				{
					"id": 150120408,
					"content": "那孩子…唉，让她担心了。我离开铺子的时候，还以为最多两天就能回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120409
					],
					"speakerTitle": "夏温"
				},
				{
					"id": 150120409,
					"content": "我也没想到，居然能在「缝影针」附近发现一条新的「火山晶石」矿脉。里面的晶石格外纯净，矿量也足。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120410
					],
					"speakerTitle": "夏温"
				},
				{
					"id": 150120410,
					"content": "我挖出了许多纯净的「火山晶石」，正准备回去的时候，晶石里的燃素却吸引来了魔物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夏温"
				},
				{
					"id": 150120403,
					"content": "名声大也有好处啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120404
					]
				}
			]
		},
