			"dialogs": [
				{
					"id": 150120101,
					"content": "还，还没有回来…夏温师父难道真的出了什么事…呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120102
					],
					"speakerTitle": "伊蜜"
				},
				{
					"id": 150120102,
					"content": "那边的小朋友怎么在哭啊，是发生了什么吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150120103,
					"content": "#{NICKNAME}，我们过去看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150120104,
					"content": "小妹妹，你怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120105
					]
				},
				{
					"id": 150120105,
					"content": "呜…是，是夏温师父…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120106
					],
					"speakerTitle": "伊蜜"
				},
				{
					"id": 150120106,
					"content": "她、她说要去那边采「火山晶石」…但是到现在也没回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120107
					],
					"speakerTitle": "伊蜜"
				},
				{
					"id": 150120107,
					"content": "我告诉了守卫叔叔，但叔叔们说，现在部族里实在抽不开来人手，而且那边的地形很危险，还待着好多魔物和坏蛋…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120108
					],
					"speakerTitle": "伊蜜"
				},
				{
					"id": 150120108,
					"content": "他们只能先尽量筹备着，等准备好之后再去营救夏温师父…但那样就来不及了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120109,
						150120110
					],
					"speakerTitle": "伊蜜"
				},
				{
					"id": 150120109,
					"content": "放心吧，包在我身上。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120111
					]
				},
				{
					"id": 150120111,
					"content": "你愿意帮我？太好了！我这就把守卫叔叔之前去过的地方画给你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120112
					],
					"speakerTitle": "伊蜜"
				},
				{
					"id": 150120112,
					"content": "守卫叔叔们说，这可能就是夏温师父待过的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120113
					],
					"speakerTitle": "伊蜜"
				},
				{
					"id": 150120113,
					"content": "说不定，她会被迫跑到了「缝影针」附近。如果…如果是那样的话…呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120114
					],
					"speakerTitle": "伊蜜"
				},
				{
					"id": 150120114,
					"content": "#拜托了，{M#大哥哥}{F#大姐姐}，救救夏温师父吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊蜜"
				},
				{
					"id": 150120110,
					"content": "看来我的英雄事迹又要多一笔了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120111
					]
				}
			]
		},
