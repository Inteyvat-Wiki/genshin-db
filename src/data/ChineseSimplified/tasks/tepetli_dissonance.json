						],
						"pointId": 350100078
					}
				]
			},
			"dialogs": [
				{
					"id": 150120701,
					"content": "她为什么不再打造「古名」了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120702
					]
				},
				{
					"id": 150120702,
					"content": "…因为她的女儿。可怜的小妮赫佳患了重病，特拉佐莉几乎抛下了一切，全心照顾着她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120703
					],
					"speakerTitle": "夏温"
				},
				{
					"id": 150120703,
					"content": "在小妮赫佳病情最严重的那段时间，特拉佐莉就像是一束陷入泥潭的火炬。拼了命的发着光和热，底下的泥水却追逐得越来越近…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120704
					],
					"speakerTitle": "夏温"
				},
				{
					"id": 150120704,
					"content": "哎呀，但是还好！多亏了医生的药，还有大灵的保佑，小妮赫佳的生命之火还是重新燃了起来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120705
					],
					"speakerTitle": "夏温"
				},
				{
					"id": 150120705,
					"content": "之后，小妮赫佳的病情也逐渐变好。虽然她身体还很虚弱，只能在家里静养，但这孩子已经有力气写信了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120706
					],
					"speakerTitle": "夏温"
				},
				{
					"id": 150120706,
					"content": "我听说，她经常寄信给那位希诺宁，还梦想着成为一个锻造古名的工匠，接下她母亲曾经为之自豪的重任呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120707
					],
					"speakerTitle": "夏温"
				},
				{
					"id": 150120707,
					"content": "过几天就是小妮赫佳的生日了，特拉佐莉也特意来拜托我，帮她找一块足够纯净的「火山晶石」，用来给妮赫佳做生日礼物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120708,
						150120709
					],
					"speakerTitle": "夏温"
				},
				{
					"id": 150120708,
					"content": "所以，你才会一个人来这里探矿。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120710
					]
				},
				{
					"id": 150120710,
					"content": "确实是一块意义重大的矿石呀。有了这么漂亮的礼物，那个叫妮赫佳的小朋友一定能好得更快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120711
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150120711,
					"content": "那我就替特拉佐莉和妮赫佳借你吉言了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120712
					],
					"speakerTitle": "夏温"
				},
				{
					"id": 150120712,
					"content": "我们先回去吧，不能让伊蜜那孩子等急了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120713
					],
					"speakerTitle": "夏温"
				},
				{
					"id": 150120713,
					"content": "对了，如果你愿意的话，明天和我一起去探望特拉佐莉吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120714
					],
					"speakerTitle": "夏温"
				},
				{
					"id": 150120714,
					"content": "多亏了你帮忙，这枚晶石才没被那群人抢走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120715
					],
					"speakerTitle": "夏温"
				},
				{
					"id": 150120715,
					"content": "你保护了这么一枚意义重大的晶石，理应也拿到一份意义重大的礼物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120716
					],
					"speakerTitle": "夏温"
				},
				{
					"id": 150120716,
					"content": "希望能让妮赫佳开心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120717
					]
				},
				{
					"id": 150120717,
					"content": "嗯，只要心情好，病就能好得更快！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120718
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150120718,
					"content": "当然啦，那个…稍微给我们一点礼物，我们的心情也会很好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120719
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150120719,
					"content": "哈哈哈，放心吧，这份礼物绝对能让你们满意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120720
					],
					"speakerTitle": "夏温"
				},
				{
					"id": 150120720,
					"content": "至于它究竟是什么…就等明天特拉佐莉亲口告诉你们吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夏温"
				},
				{
					"id": 150120709,
					"content": "这枚晶石，的确不能轻易让出去。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120710
					]
				}
			]
		},
