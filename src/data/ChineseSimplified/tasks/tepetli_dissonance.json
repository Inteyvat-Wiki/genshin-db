			"dialogs": [
				{
					"id": 150120501,
					"content": "我慌不择路，只能挑小路绕开它们。没想到刚出来的时候，却撞见了那些贼匪…幸好你们来得及时。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120502
					],
					"speakerTitle": "夏温"
				},
				{
					"id": 150120502,
					"content": "你逃跑的时候，还带着这些晶石吗？都那么危险了，不能把这些石头丢掉吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150120503,
					"content": "我已经丢了很多了。只留下了一块最纯净的晶石。我无论如何都得把它带回去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120504
					],
					"speakerTitle": "夏温"
				},
				{
					"id": 150120504,
					"content": "…为了特拉佐莉，也为了可怜的小妮赫佳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120505
					],
					"speakerTitle": "夏温"
				},
				{
					"id": 150120505,
					"content": "这两个人是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120506
					]
				},
				{
					"id": 150120506,
					"content": "喔，你不知道也正常。特拉佐莉…曾经是一位打造「古名」的工匠，妮赫佳是她的女儿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120507
					],
					"speakerTitle": "夏温"
				}
			]
