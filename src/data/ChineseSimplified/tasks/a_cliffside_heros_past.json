				"points": []
			},
			"dialogs": [
				{
					"id": 710630601,
					"content": "哎呀，两位，找我有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630602
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710630602,
					"content": "你们是不是也想来玩挖宝的游戏…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630603
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710630603,
					"content": "哼，今天我们俩过来，是有别的事要找你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630604,
						710630605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710630604,
					"content": "这枚玉佩…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710630606
					]
				},
				{
					"id": 710630606,
					"content": "啊，这枚玉佩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630607
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710630607,
					"content": "确确实实是从我这里脱手卖出去的…来，让我仔细看，这质地，这水润，这透亮，这不是我卖给唐无仇的那一枚嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630608
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710630608,
					"content": "这枚玉佩的材质，看上去就和别的货不一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630609
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710630609,
					"content": "我当时还想靠着这个大赚一笔呢，结果被唐无仇一眼看中，赖死赖活的，就便宜卖给他了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630610
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710630610,
					"content": "这种材质的只有这一个？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630611
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710630611,
					"content": "我倒是还想再翻出来第二个呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630612
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710630612,
					"content": "唉…幸好只有这一个，这个材质的矿石富含元素力，如果是没有「神之眼」的人接触了，就会性格大变，满嘴胡话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630613
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710630613,
					"content": "唐无仇现在以为自己是古华派的大侠，每天疯疯癫癫的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630614
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710630614,
					"content": "啊？怎、怎么会这样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630615
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710630615,
					"content": "仔细一看，这确实和传说中会让佩戴之人产生不适的「翠珏岩」十分相像。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630616
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710630616,
					"content": "以前就曾听老一辈人说过，说是「翠珏岩」虽然宝贵，但要是长时间贴身携带，往往携带者都会遭受厄运，邪门的很。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630617
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710630617,
					"content": "是我害了老唐啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630618
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710630618,
					"content": "唉，我和唐无仇以前都是盗宝团的，之前在层岩巨渊干了一票，大家决定分道扬镳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630619
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710630619,
					"content": "唐无仇不知道跑哪去了，可是我…唉，我被以前盗宝团的人找到，受他们胁迫，买他们在这做的劣质首饰在璃月转手卖出。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630620
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710630620,
					"content": "美其名曰帮忙销售，可是他们做的…是材料比得上「盛露厅」啊，还是造型打制比得上「明星斋」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630621
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710630621,
					"content": "还不是要我给他们做出来的玩意儿兜底。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630622
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710630622,
					"content": "可怜我是低价再低价，赔了本，才卖得出去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630623
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710630623,
					"content": "之前赚的钱全都赔了进去…好在那群爷可能醒悟过来，直接卖材料还卖得贵些，最近终于不来找我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630624
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710630624,
					"content": "他们都被潜入的千岩军剿了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710630625
					]
				},
				{
					"id": 710630625,
					"content": "向老臭告知千岩军捣毁走私窝点的始末…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710630626
					]
				},
				{
					"id": 710630626,
					"content": "剿得好啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630627
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710630627,
					"content": "说要向千岩军告我的案底，哼，这下自己进去了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630628
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710630628,
					"content": "唉，说远了…唐无仇的事我也很抱歉，但是我现在值钱的东西，都、都被我埋在土堆里了，好做些小生意赚点钱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630629
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710630629,
					"content": "不如这样，这次就让你们挖一次宝，挖出什么，就带给唐无仇算作赔礼吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630630
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710630630,
					"content": "怎么样，要不要听一下这个挖宝怎么玩？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630631,
						710630632
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710630631,
					"content": "不用了，我知道…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710630636
					]
				},
				{
					"id": 710630636,
					"content": "那，不如现在就开始来一局吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "老臭"
				},
				{
					"id": 710630632,
					"content": "行啊，你说一下规则吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710630633
					]
				},
				{
					"id": 710630633,
					"content": "简而言之，就是每个土堆下面都有些好东西，但是也有炸药…不过不用担心，都是些长时间没人用的哑弹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630634
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710630634,
					"content": "要是能挖到宝贝，就给你们，算作给老唐的赔礼，原本要是挖到炸弹就算输了，不过这次嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630635
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710630635,
					"content": "算了，等你们挖到再说吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630636
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710630605,
					"content": "这是你这里卖的吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710630630
					]
				}
			]
		},
