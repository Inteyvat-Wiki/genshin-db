				"objectNames": [
					"唐无仇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710630101,
					"content": "哼哼，怎么成天有人觊觎我的琉璃百合大花园，要是再有偷花贼胆敢靠近，我就必要让他们尝尝古华派武功的厉害！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "唐无仇"
				}
			]
		},
		{
			"id": 7106302,
			"completionStepIds": [
				7106302
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7106302",
							"2"
						],
						"stepId": 7106302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"唐无仇",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710630201,
					"content": "你们是何方宵小之徒！可不知此处的这些花已是名花有主！岂可随意采撷？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630202
					],
					"speakerTitle": "唐无仇"
				},
				{
					"id": 710630202,
					"content": "还不速速住手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630203
					],
					"speakerTitle": "唐无仇"
				},
				{
					"id": 710630203,
					"content": "啊！难道说，这些花是你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710630204,
					"content": "正是我慧眼发现，从三日前开始细心呵护的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630205
					],
					"speakerTitle": "唐无仇"
				},
				{
					"id": 710630205,
					"content": "原来不是你种的啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710630206,
					"content": "咳咳，虽然不是我所种，但是现在已经属于我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630207
					],
					"speakerTitle": "唐无仇"
				},
				{
					"id": 710630207,
					"content": "我甚至在心中暗中发誓，必要认真培育这些花，在此处打造一个美丽非凡的琉璃百合大花园。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630208
					],
					"speakerTitle": "唐无仇"
				},
				{
					"id": 710630208,
					"content": "咦，琉璃百合大花园…靠这些花吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710630209,
					"content": "可是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710630210,
					"content": "怎么了？你以为本大侠是个不识风雅的庸人吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630211
					],
					"speakerTitle": "唐无仇"
				},
				{
					"id": 710630211,
					"content": "看来你也不过是个以貌取人之徒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630212
					],
					"speakerTitle": "唐无仇"
				},
				{
					"id": 710630212,
					"content": "你说要建一个琉璃百合大花园，可是这些花是清心，不是琉璃百合哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710630213,
					"content": "…啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630214
					],
					"speakerTitle": "唐无仇"
				},
				{
					"id": 710630214,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630215
					],
					"speakerTitle": "唐无仇"
				},
				{
					"id": 710630215,
					"content": "…哼哼哼哼哼，哈哈哈哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630216
					],
					"speakerTitle": "唐无仇"
				},
				{
					"id": 710630216,
					"content": "我懂了，你们是想说这些假话来动摇我的意念。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630217
					],
					"speakerTitle": "唐无仇"
				},
				{
					"id": 710630217,
					"content": "我可是古华派第三百二十代传人唐无仇，你以为这样就能够骗过我吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630218,
						710630220
					],
					"speakerTitle": "唐无仇"
				},
				{
					"id": 710630218,
					"content": "古华派有那么多代吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710630219
					]
				},
				{
					"id": 710630219,
					"content": "你竟敢质疑古华派的悠久历史，还不速速纳命来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "唐无仇"
				},
				{
					"id": 710630220,
					"content": "明明穿着盗宝团的衣服…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710630221
					]
				},
				{
					"id": 710630221,
					"content": "哼，衣服不过是身外之物罢了，真正能够决定一个人的是他的内心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630222
					],
					"speakerTitle": "唐无仇"
				},
				{
					"id": 710630222,
					"content": "我古华派弟子唐无仇，今天就要替天行道，将你这偷花贼击退，好教你们知道古华派的厉害！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "唐无仇"
				}
			]
		},
		{
			"id": 7106303,
			"completionStepIds": [
				7106304
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7106304",
							"2"
						],
						"stepId": 7106304,
						"stateName": "QUEST_STATE_UNFINISHED"
