					"唐无仇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710630501,
					"content": "这个给你，换你那枚玉佩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710630502,
					"content": "这可是…这可是鸟蛋大小的宝石。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710630503,
					"content": "鸟蛋大小？我原本以为鸽子蛋大小的宝石已是登峰造极，没想到还有鸟蛋大小的宝石呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630504
					],
					"speakerTitle": "唐无仇"
				},
				{
					"id": 710630504,
					"content": "嘿嘿，拿一个玉佩换回如此大的一枚宝石，真是稳赚不赔啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630505
					],
					"speakerTitle": "唐无仇"
				},
				{
					"id": 710630505,
					"content": "这也多亏我古华派素有仁义之心…咳咳，看你们求宝心切，才愿意做这样的交易。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630506
					],
					"speakerTitle": "唐无仇"
				},
				{
					"id": 710630506,
					"content": "唐无仇将玉佩取下，递了过来…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
