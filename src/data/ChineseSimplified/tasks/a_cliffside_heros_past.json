			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"唐无仇",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710630301,
					"content": "痛痛痛痛痛，我错了我错了，别再打了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630302
					],
					"speakerTitle": "唐无仇"
				},
				{
					"id": 710630302,
					"content": "这个人的武功真是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710630303,
					"content": "十分稀烂。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710630304
					]
				},
				{
					"id": 710630304,
					"content": "没想到我苦修这么多载，还是不如你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630305
					],
					"speakerTitle": "唐无仇"
				},
				{
					"id": 710630305,
					"content": "啊这个，正所谓好马配好鞍，好船配好帆…不对，呸呸呸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630306
					],
					"speakerTitle": "唐无仇"
				},
				{
					"id": 710630306,
					"content": "正所谓宝剑配英雄，这朵琉璃百合就送给英雄您了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630307
					],
					"speakerTitle": "唐无仇"
				},
				{
					"id": 710630307,
					"content": "都说了这是清心啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710630308,
					"content": "对对对，是清心是清心，您说啥就是啥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630309
					],
					"speakerTitle": "唐无仇"
				},
				{
					"id": 710630309,
					"content": "你真的是古华派的吗…嗯，你认不认识一个人，名字叫行秋？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710630310,
					"content": "行秋此名…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630311
					],
					"speakerTitle": "唐无仇"
				},
				{
					"id": 710630311,
					"content": "我是闻所未闻啊，怎么，难道这个叫行秋的家伙自称古华派弟子吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630312
					],
					"speakerTitle": "唐无仇"
				},
				{
					"id": 710630312,
					"content": "那怎么能让他败坏我古华派的声名…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630313
					],
					"speakerTitle": "唐无仇"
				},
				{
					"id": 710630313,
					"content": "（看来他真的不是古华派的人…而且，败坏古华派声名的人不就是他自己吗…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710630314,
					"content": "等等，等等，你口口声声说自己是古华派的人，有什么证据吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710630315,
					"content": "那当然是有证据的，看，我身上这枚玉佩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630316
					],
					"speakerTitle": "唐无仇"
				},
				{
					"id": 710630316,
					"content": "这枚玉佩…是古华派代代相传的宝物？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710630317,
					"content": "这枚玉佩我一位老友在分别时卖于我，我心中暗自决定，这以后就是我们古华派代代相传的宝物了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630318
					],
					"speakerTitle": "唐无仇"
				},
				{
					"id": 710630318,
					"content": "带上这枚玉佩以来，每次我练武，脑内都会有隐约刺痛之感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630319
					],
					"speakerTitle": "唐无仇"
				},
				{
					"id": 710630319,
					"content": "呃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710630320,
					"content": "怎么想都是这枚玉佩有什么问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630321
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710630321,
					"content": "怎么可能，我佩戴这枚玉佩的第一天，就有仙人入梦，授我古华派绝学，说明我与这玉佩有缘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630322
					],
					"speakerTitle": "唐无仇"
				},
				{
					"id": 710630322,
					"content": "而且脑内的刺痛感，是精神逐渐涨大成长之痛，小说里都写了，这是意念在逐渐加强的前兆，怎么会有问题？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630323
					],
					"speakerTitle": "唐无仇"
				},
				{
					"id": 710630323,
					"content": "难道…好啊，我明白了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630324
					],
					"speakerTitle": "唐无仇"
				},
				{
					"id": 710630324,
					"content": "…哼哼哼哼哼，哈哈哈哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630325
					],
					"speakerTitle": "唐无仇"
				},
				{
					"id": 710630325,
					"content": "我明白了，你们其实想要这一块玉佩…只是不好意思开口，借口说这玉佩有问题，还真是道貌…咳咳…还真是委婉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630326
					],
					"speakerTitle": "唐无仇"
				},
				{
					"id": 710630326,
					"content": "这块玉佩可是我古华派的至宝，即使是您二位，想要从我手中夺去此宝，那也得…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630327
					],
					"speakerTitle": "唐无仇"
				},
				{
					"id": 710630327,
					"content": "那也得拿什么价格相同的来换吧，比如什么鸽子蛋大小的宝石之类的…不然我这个古华派三百二十代传人面子上可挂不住。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630328
					],
					"speakerTitle": "唐无仇"
				},
				{
					"id": 710630328,
					"content": "#{NICKNAME}，看来就是这块奇怪的玉佩让他以为自己是古华派传人，还这么疯疯癫癫的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630329
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710630329,
					"content": "要是他一直带着那个玉佩，还在那么高的地方，肯定会出事的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630330
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710630330,
					"content": "他不是要我们拿什么鸽子蛋大小的宝石换嘛，他这样看上去也没法分辨好坏…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630331
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710630331,
					"content": "我们就，给他几个鸟蛋试试好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
