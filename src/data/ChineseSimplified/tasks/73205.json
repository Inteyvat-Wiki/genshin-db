			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿凡"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732050301,
					"content": "挺好，挺好，你们两个很有办法啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050302
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050302,
					"content": "我预感，有专业人士指导，这次应该能长好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050303
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050303,
					"content": "之前的烤肉卷和米圆塔好吃不好吃？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050304,
						732050306
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050304,
					"content": "好吃。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050305
					]
				},
				{
					"id": 732050305,
					"content": "好吃我再给你们做点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050307
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050307,
					"content": "我的手艺没有我家去世的老太婆好，你们不许嫌弃。拿着吧，这次少了点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050308
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050308,
					"content": "是好吃的！阿凡爷爷，你真好，以后我们也会常来看你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732050309,
					"content": "哈哈，你们之前不是想问我，这花是什么花吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050310
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050310,
					"content": "告诉你们也不碍事，我种的都是蔷薇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050311
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050311,
					"content": "跟须弥蔷薇是同一种花吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050312
					]
				},
				{
					"id": 732050312,
					"content": "这种花叫作「金蔷薇」，哎呀，可比须弥蔷薇宝贝多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050313
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050313,
					"content": "我之前说这些花种都是一位朋友留给我的，你们还记得吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050314
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050314,
					"content": "其实啊，这些种子、我现在住的这间旧屋子都是死掉的鬼老头留给我的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050315
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050315,
					"content": "欸，我给忘了，你们不是阿如村的人，肯定不熟悉这个名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050316
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050316,
					"content": "不熟悉也好，就把这家伙当成一个会种点花的老头记住，就好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050317
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050317,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050318
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050318,
					"content": "阿凡爷爷突然发起呆来了呢，阿凡爷爷，阿凡爷爷？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732050319,
					"content": "哎哟，我刚才是不是走神了？人年纪大了，注意力不容易集中，叫你们看笑话了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050320
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050320,
					"content": "这次也谢谢你们两个小娃娃，你们要是还有什么想看的，就到处转转好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050321
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050321,
					"content": "我不会再赶人了，不过当心，别踩到苗圃上去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050306,
					"content": "还没尝。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050307
					]
				}
			]
		},
		{
			"id": 7320504,
			"completionStepIds": [],
