			"trigger": {
				"objectNames": [
					"阿凡"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732040701,
					"content": "哎呀，我还没来得及做饭，没东西招待你们哟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040702,
						732040703
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040702,
					"content": "不用麻烦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040704
					]
				},
				{
					"id": 732040704,
					"content": "另外一个小娃娃是你的朋友吧，有点可爱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040705
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040705,
					"content": "我种的花开了之后，你们两个要不要来看？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040706
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040706,
					"content": "好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040707
					]
				},
				{
					"id": 732040707,
					"content": "再过阵子它们大概就能开了，你们以后还能来吧，来看看你们帮忙种出来的花嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040708
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040708,
					"content": "可以。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040709
					]
				},
				{
					"id": 732040709,
					"content": "好好好，我知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040710
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040710,
					"content": "♪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040703,
					"content": "肚子不饿。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040704
					]
				}
			]
		},
		{
			"id": 7320501,
			"completionStepIds": [
				7320501
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320501",
							"2"
						],
						"stepId": 7320501,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"阿凡"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732050101,
					"content": "来，来，看看这些种子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050102
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050102,
					"content": "好像没什么变化。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050103
					]
				},
				{
					"id": 732050103,
					"content": "是啊，虽然我种地种了好多年，但种花跟种地还是不同。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050104
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050104,
					"content": "要不然，为什么这么久它们都不长呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050105
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050105,
					"content": "我看看，唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732050106,
					"content": "阿凡爷爷，我觉得你的苗圃太干燥了，阿如村附近土地的养分也可能不够。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732050107,
					"content": "我们之前在村子里帮人种过花，我们有经验。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732050108,
					"content": "哦，是这样吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050109
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050109,
					"content": "有道理，这么稀有的花种是应该比普通花草娇贵点，我浇水施肥确实不够。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050110
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050110,
					"content": "不过这块苗圃离水源有点远，取水不方便。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050111
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050111,
					"content": "我自己储存的日常用水也不多，要常给苗圃里的种子浇水还有点麻烦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050112
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050112,
					"content": "我可以帮忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050113
					]
				},
				{
					"id": 732050113,
					"content": "好啊，那就先请你们给这三颗种子都浇些水吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿凡"
				}
			]
		},
		{
			"id": 7320503,
			"completionStepIds": [
				7320503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
