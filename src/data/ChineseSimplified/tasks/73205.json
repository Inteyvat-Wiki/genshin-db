			},
			"dialogs": [
				{
					"id": 732050401,
					"content": "先给这三颗种子浇点水吧，施肥的事情我再想办法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050402
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050402,
					"content": "过了几十年，简单的肥料该怎么做我还是懂的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿凡"
				}
			]
		}
	]
