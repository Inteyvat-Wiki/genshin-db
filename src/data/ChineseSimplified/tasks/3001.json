						30011007
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30011007,
					"content": "没事没事，我在食物外面包了好几层油纸，应该没有弄脏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011008
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30011008,
					"content": "呼…刚才真是吓死我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011009
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30011009,
					"content": "和柯莱一起分享了食物…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						30011010
					]
				},
				{
					"id": 30011010,
					"content": "真是太好吃啦！柯莱，你的厨艺真好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011011
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30011011,
					"content": "幸好你之前把每块饼都仔细包了起来，要不然我肯定会心疼得晚上连觉都睡不着了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011012
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30011012,
					"content": "哈哈，这也太夸张了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011013
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30011013,
					"content": "不过既然你们喜欢，下次我给你们抄一份食谱吧。放心，我会把烹饪要点写上，你们很快就能学会的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011014
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30011014,
					"content": "谢谢你柯莱！嘻嘻，真难想象像你这么认真的人，竟然也会有毛手毛脚的时候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011015
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30011015,
					"content": "哈哈，可能是有那么一点吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011016
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30011016,
					"content": "不过提纳里对你是不是管得太严了一点？东西都不让你碰…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011017
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30011017,
					"content": "#我也偶尔会在飞的时候碰倒桌上的东西，但{NICKNAME}从来不会怪我，毕竟谁都会有不小心的时候嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011018
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30011018,
					"content": "不，不是这样的！如果你们和师父相处的时间更长一点，就会发现他其实是个很好的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011019
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30011019,
					"content": "我听前辈们说，师父来自一个很古老神秘的种族。他们一族都很聪明，大多有些孤僻，但师父却是个很热心肠的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011020
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30011020,
					"content": "对了，你们知道教令院吗，好像是叫做生…生什么派来着？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011021
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30011021,
					"content": "总之，因为师父对植物很有研究，那个学院的贤者还好几次写信来，让他到教令院去任职。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011022
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30011022,
					"content": "不过，却被师父以「须弥城太嘈杂对耳朵不好」为由拒绝了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011023,
						30011026
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30011023,
					"content": "还真像提纳里会说的话…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30011024
					]
				},
				{
					"id": 30011024,
					"content": "哈哈，是啊。不过贤者大人看到信，估计会生气吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011025
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30011025,
					"content": "明明可以去教令院，师父却选择了做巡林官，每天都在为雨林的居民们提供帮助，也会教给下属们各种知识。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011029
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30011029,
					"content": "就连口袋饼的做法，也是师父教给我的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011030
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30011030,
					"content": "真的吗？这我倒是完全没想到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011031
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30011031,
					"content": "唔…不过这么说来，昨天提纳里发现你晕倒后，倒是二话不说就对你实施救治，也是他把你背回化城郭的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011032
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30011032,
					"content": "不过我还是觉得有点不爽，因为他整整一路上都在拼命数落我呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011033
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30011033,
					"content": "你做了什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30011034
					]
				},
				{
					"id": 30011034,
					"content": "啊，真不好意思，这件事可能是师父不太对…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011035
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30011035,
					"content": "#因为派蒙当时不停在喊「怎么办，{M#他}{F#她}是不是要死了？」，怎么劝都没用，把师父给惹毛了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011036
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30011036,
					"content": "喂，可恶，你不要笑啊！我还不都是因为关心你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011037
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30011037,
					"content": "噗…呵呵呵呵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011038
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30011038,
					"content": "怎么回事，为什么连柯莱也——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011039
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30011039,
					"content": "啊啊啊，气死我啦！我要报复你们！看我把你们的脑袋都揉成鸟窝！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011040
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30011040,
					"content": "别碰我！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011041,
						30011042
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30011041,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30011043
					]
				},
				{
					"id": 30011043,
					"content": "柯莱，对不起，那个，我不是故意的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011044
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30011044,
					"content": "啊，我…刚才…不，不是这样的，不是的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011045
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30011045,
					"content": "柯莱，你还好吗？你没事吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011046
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30011046,
					"content": "啊…嗯，我没事，我没事了…不好意思，刚才吓了你们一跳吧，哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011047
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30011047,
					"content": "对了，时间已经不早了，我们赶快回化城郭去吧，师父他们也该回来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011048
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30011048,
					"content": "刚才到底怎么了，柯莱她不要紧吧？她走得可真快，现在都已经看不见了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30011042,
					"content": "柯莱，你怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30011043
					]
				},
				{
					"id": 30011026,
					"content": "耳朵…耳朵好像很好摸！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30011027
					]
				},
				{
					"id": 30011027,
					"content": "对吧！我也是这么觉得…嗯，咳咳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011028
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30011028,
					"content": "总、总而言之，师父明明可以去教令院，却还是做了巡林官，每天都在为雨林的居民们提供帮助，也会教给下属们各种知识。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011029
					],
					"speakerTitle": "柯莱"
				}
			]
		},
