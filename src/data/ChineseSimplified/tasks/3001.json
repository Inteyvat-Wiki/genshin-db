			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"柯莱"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30010101,
					"content": "好，接下来是右手…情况似乎还可以。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010102
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30010102,
					"content": "不过还是小心行事，明白吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010103
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30010103,
					"content": "嗯，我知道了。对了师父，我还没拿到今天的巡林路线图。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010104
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30010104,
					"content": "今天的路程很远，你就不要跟我一起去了，而且还可能会有那些东西出现在这条路线上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010105
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30010105,
					"content": "我明明也有神之眼，却没办法帮上什么忙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010106
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30010106,
					"content": "别说这种话，这不是你现在应该考虑的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010107
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30010107,
					"content": "你们来了，身体感觉还好吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010108
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30010108,
					"content": "有什么需要帮忙的吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010109
					]
				},
				{
					"id": 30010109,
					"content": "对，既然留在这里，我们也想稍微找点事情做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30010110,
					"content": "你们是这种闲不下来的类型吗？好吧，既然这样，今天就让柯莱带你们去化城郭南边巡视吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010111
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30010111,
					"content": "如果你们对体力有信心，七天神像的清洁也交给你们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010112
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30010112,
					"content": "提纳里先生，我们已经准备完毕了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010113
					],
					"speakerTitle": "阿米尔"
				},
				{
					"id": 30010113,
					"content": "马上就来——我们先出发去林子里了，剩下的事就让柯莱跟你们说明吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010114
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30010114,
					"content": "是，交给我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010115
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30010115,
					"content": "柯莱，我们今天都要做些什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30010116,
					"content": "刚才提纳里说要清洁七天神像，但我没想到，这也算巡林员的工作啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30010117,
					"content": "嗯，其实巡林员的工作内容很广。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010118
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30010118,
					"content": "检查道路状况、维护林间设施、排除火灾隐患、为旅客居民提供帮助…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010119
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30010119,
					"content": "如果是师父的话，还经常要去处理雨林中危险的区域。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010120
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30010120,
					"content": "在我们到达七天神像前，先检查一下沿途的路灯吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柯莱"
				}
			]
		},
		{
			"id": 300105,
			"completionStepIds": [
				300103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"300103",
							"2"
						],
						"stepId": 300103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"柯莱"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30010501,
					"content": "七天神像就在那块巨大的岩石上面，你们之前从这条路过来的时候，应该已经看到它了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010502
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30010502,
					"content": "位置是不是有点高？如果你觉得爬上去比较勉强，不打扫也没关系，师父不会介意的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010503,
						30010504
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30010503,
					"content": "不要紧，我很擅长攀爬。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010505
					]
				},
				{
					"id": 30010505,
					"content": "是吗，那就交给你了。神像附近的空间很小，你在上面要小心一点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010506
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30010506,
					"content": "#{NICKNAME}，我也和你一起上去吧，我可以帮你打扫比较高的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30010507,
					"content": "对了柯莱，你知道草神是位什么样的神吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30010508,
					"content": "你是问「大慈树王」还是「小吉祥草王」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010509
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30010509,
					"content": "咦，「大慈树王」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010510
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30010510,
					"content": "啊，难道说这是前代草神的名字？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010511
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30010511,
					"content": "对。「大慈树王」是须弥的初代草神大人。她创造了雨林，在沙漠边缘建起防沙壁，大家这才获得了安宁的生活。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010512
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30010512,
					"content": "在须弥人眼里，她是智慧、仁慈与无所不能的象征，但她却在几百年前的灾难中消失了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010513,
						30010514
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30010513,
					"content": "（就像雷电真那样吗…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010515
					]
				},
				{
					"id": 30010515,
					"content": "我听师父说，后来贤者们找到了新生的草神大人，将她接回了须弥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010516
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30010516,
					"content": "为了庆祝神明的失而复得，贤者们就以「小吉祥草王」称呼她，并让她居住在净善宫里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010517
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30010517,
					"content": "嗯嗯，那然后呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010518
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30010518,
					"content": "然后，呃…我也不太清楚了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010519
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30010519,
					"content": "咦，你也不清楚吗？难道说柯莱你并不是须弥人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010520
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30010520,
					"content": "不，我是须弥人没错，不过…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010521
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30010521,
					"content": "是因为我们是陌生人，有些事情不方便说吗？如果真是这样也没关系，你不用在意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010522
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30010522,
					"content": "不不，你们误会了，我不是在隐瞒什么。况且你们对我来说，也不算是陌生人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010523
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30010523,
					"content": "那个…你、你们也认识安柏对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010524
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30010524,
					"content": "等等，你说的难道是——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010525,
						30010526
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30010525,
					"content": "西风骑士团的侦察骑士？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010527
					]
				},
				{
					"id": 30010527,
					"content": "对，就是她！我之前在蒙德待过一段时间，当时得到了安柏很多帮助，说是她改变了我也不为过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010528
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30010528,
					"content": "安柏她真的很厉害！热爱生活，有正义感，不仅充满行动力，也非常善解人意，总是能像一团火一样照亮别人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010529
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30010529,
					"content": "在我看来，她是最适合做侦察骑士的人。因为几乎每个踏入蒙德的人，都会先遇到她，然后被她的热情感染，爱上那片土地…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010530
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30010530,
					"content": "啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010531,
						30010532
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30010531,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010533
					]
				},
				{
					"id": 30010533,
					"content": "唔，虽然总觉得侦察骑士的工作目的并不是这样，不过我已经十分深刻地感觉到了，柯莱你真的很喜欢安柏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010534
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30010534,
					"content": "咳…不、不好意思，刚才我好像说了一些奇怪的话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010535
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30010535,
					"content": "嘻嘻，没关系啦，知道你是安柏的朋友后，感觉一下子和你亲近了不少呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010536
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30010536,
					"content": "不过你是怎么知道我们也认识安柏的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010537
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30010537,
					"content": "啊，是这样的，我回到须弥之后，也一直和安柏保持着书信联系。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010538
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30010538,
					"content": "她在信里讲过蒙德城遭到飞龙袭击的事，说有一个金发的旅行者和飘浮的伙伴帮忙化解了危机。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010539
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30010539,
					"content": "所以昨天一见到你们，我就认出你们了。不过当时因为旅行者刚从昏迷中醒来，我就没好意思提起这件事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010540
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30010540,
					"content": "原来是这样呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010541
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30010541,
					"content": "嗯！所以请你们放心，我绝对是信任你们的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010542
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30010542,
					"content": "我也想多告诉你们一些草神大人的事，但我很长时间都没在须弥生活，而且也没读过什么书…不好意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010543
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30010543,
					"content": "没关系啦，你刚才告诉我们的情报也很有价值。毕竟我们之前，连「大慈树王」、「净善宫」什么的都没听说过呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010544
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30010544,
					"content": "能帮上一点忙就好。不过你们为什么要打听草神的消息呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010545
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30010545,
					"content": "向柯莱简单讲述了旅行的目的…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						30010546
					]
				},
				{
					"id": 30010546,
					"content": "原来如此。谢谢你们愿意告诉我这些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010547
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30010547,
					"content": "不用客气，毕竟我们是朋友呀，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010548
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30010548,
					"content": "派蒙说得没错。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010549
					]
				},
				{
					"id": 30010549,
					"content": "好，那我们现在就去上面清洁神像吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010550
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30010550,
					"content": "嗯，辛苦你们了。我去前面检查一下遮雨棚的情况，等会儿我们就在这附近会合吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30010532,
					"content": "原来你是这样的柯莱…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010533
					]
				},
				{
					"id": 30010526,
					"content": "蒙德城的狂热飞行爱好者？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010527
					]
				},
				{
					"id": 30010514,
					"content": "（也是在坎瑞亚那时吗…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010515
					]
				},
				{
					"id": 30010504,
					"content": "这种程度小菜一碟。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010505
					]
				}
			]
		},
