			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"嘉义"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411260101,
					"content": "唉，这可怎么办…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260102
					],
					"speakerTitle": "嘉义"
				},
				{
					"id": 411260102,
					"content": "发生什么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411260103
					]
				},
				{
					"id": 411260103,
					"content": "那些从天而降的陨石，你应该也看见了吧，城里虽然没有被波及，但野外已经乱了套了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260104
					],
					"speakerTitle": "嘉义"
				},
				{
					"id": 411260104,
					"content": "而且，陨石不仅堵塞着道路，周围的魔物似乎也被陨石影响，变得格外暴躁危险，到处袭击行人和商队。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260105
					],
					"speakerTitle": "嘉义"
				},
				{
					"id": 411260105,
					"content": "总务司几乎把能派出去的千岩军全都派出去了，但璃月太大了，我们也只能保障几条主干道和村庄的安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260106
					],
					"speakerTitle": "嘉义"
				},
				{
					"id": 411260106,
					"content": "我本来已经向上面申请要去轻策庄驻防的，但不知道为什么，我还是被分到这里待命…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260107
					],
					"speakerTitle": "嘉义"
				},
				{
					"id": 411260107,
					"content": "旅行者，你能帮我把这封信带去轻策庄，给一个叫小六的女孩吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260108
					],
					"speakerTitle": "嘉义"
				},
				{
					"id": 411260108,
					"content": "她是我女儿，我本来答应她会回去陪她几天，但这次事出紧急，我肯定又回不去了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260109,
						411260111
					],
					"speakerTitle": "嘉义"
				},
				{
					"id": 411260109,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411260110
					]
				},
				{
					"id": 411260110,
					"content": "那就拜托你了，唉，这都叫什么事啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260115
					],
					"speakerTitle": "嘉义"
				},
				{
					"id": 411260115,
					"content": "不过，据从那边换防回来的人说，轻策庄附近好像也聚集了不少魔物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260116
					],
					"speakerTitle": "嘉义"
				},
				{
					"id": 411260116,
					"content": "那个…不好意思，看你的装束，你是冒险家，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260117
					],
					"speakerTitle": "嘉义"
				},
				{
					"id": 411260117,
					"content": "在送信的时候，你能不能先去轻策庄周围看看，把一些边角里的魔物给扫清了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260118
					],
					"speakerTitle": "嘉义"
				},
				{
					"id": 411260118,
					"content": "千岩军一般是驻防在大路和要道上…如果这些零星的魔物悄悄进了轻策庄，那可就糟糕了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260119,
						411260121
					],
					"speakerTitle": "嘉义"
				},
				{
					"id": 411260119,
					"content": "好吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411260120
					]
				},
				{
					"id": 411260120,
					"content": "谢谢，那就拜托你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嘉义"
				},
				{
					"id": 411260121,
					"content": "这算是额外委托…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411260122
					]
				},
				{
					"id": 411260122,
					"content": "呃，这个…放心吧，我肯定会准备好合适的报酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260123
					],
					"speakerTitle": "嘉义"
				},
				{
					"id": 411260123,
					"content": "那就拜托你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嘉义"
				},
				{
					"id": 411260111,
					"content": "这也是没办法的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411260112
					]
				},
				{
					"id": 411260112,
					"content": "我知道，但是…唉，我真是奇了怪了，每次我想请假的时候，总是会出点事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260113
					],
					"speakerTitle": "嘉义"
				},
				{
					"id": 411260113,
					"content": "这也太巧了，这都叫什么事啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260114
					],
					"speakerTitle": "嘉义"
				},
				{
					"id": 411260114,
					"content": "那就拜托你了，把这封信送去轻策庄给小六吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260115
					],
					"speakerTitle": "嘉义"
				}
			]
		},
