			"dialogs": [
				{
					"id": 120220401,
					"content": "心海，你在找的是这一本吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120220402,
					"content": "我也有点记不清了…可以读两句让我听听吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220403,
						120220404
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120220403,
					"content": "「制由权也，权因事制」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120220405
					]
				},
				{
					"id": 120220405,
					"content": "嗯嗯，就是这个！拜托你啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220406
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120220406,
					"content": "心海…心海…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120220407,
					"content": "#怎么办呀，{NICKNAME}，心海她好像睡着了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120220408,
					"content": "今天晚上还有庆功晚会呢！而且马上就要和谈了，还有很多事没有做…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220409,
						120220421
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120220409,
					"content": "让她休息一会儿吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120220410
					]
				},
				{
					"id": 120220410,
					"content": "真的没问题吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120220411,
					"content": "不过，心海确实很疲惫的样子。既然还有时间，我们再陪她一起休息一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120220412,
					"content": "祓除灾厄…护佑平安…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220413
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120220413,
					"content": "战争已经结束了哦…一切都在慢慢变好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220414
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120220414,
					"content": "你们看到了吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220415
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120220415,
					"content": "欸…我睡着了吗？现在几点了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220416
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120220416,
					"content": "心海已经睡了很久了哦！马上就要篝火晚会啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220417
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120220417,
					"content": "这么晚了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220418
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120220418,
					"content": "已经好久没有睡得这么安稳了。感觉这次至少回复了三点能量值，应该能坚持到和谈结束。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220419
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120220419,
					"content": "#谢谢你了，{NICKNAME}。走吧，我们一起去篝火晚会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220420
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120220420,
					"content": "心海恢复平时的样子了呢！真的太好啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120220421,
					"content": "叫她起来吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120220422
					]
				},
				{
					"id": 120220422,
					"content": "嗯嗯，心海也说了，不能耽误正事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220423
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120220423,
					"content": "喂——心海，起床啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220424
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120220424,
					"content": "唔…我睡着了吗，现在几点了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220425
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120220425,
					"content": "准备出发去篝火晚会啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220426
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120220426,
					"content": "都这么晚了吗？呜呜…总觉得能量还没有回满。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220427
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120220427,
					"content": "等下给你买新的兵书。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120220428
					]
				},
				{
					"id": 120220428,
					"content": "真的吗！我想看《提瓦特战争艺术》最新的一期！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220429
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120220429,
					"content": "八重堂应该上个月就印制出来了，但我一直没办法去买…你可不能反悔哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220430
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120220430,
					"content": "感觉心海一下子恢复了精神呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220431
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120220431,
					"content": "我们去篝火晚会看看吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
