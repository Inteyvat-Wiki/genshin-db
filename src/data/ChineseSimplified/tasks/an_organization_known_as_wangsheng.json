			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"叶卡捷琳娜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10100201,
					"content": "#欢迎，「公子」大人的朋友，{NICKNAME}。祝你今后在「愚人众」平步青云。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100202,
						10100203
					],
					"speakerTitle": "叶卡捷琳娜"
				},
				{
					"id": 10100202,
					"content": "我不是「公子」的朋友。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100204
					]
				},
				{
					"id": 10100204,
					"content": "呵…我们都是凡人，不是「冰之女皇」。凡人的想法就像冰层下的水…是不会永远坚固锐利的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100205
					],
					"speakerTitle": "叶卡捷琳娜"
				},
				{
					"id": 10100205,
					"content": "失礼了，请容我回到正题。「公子」大人说，他与你们的约定已经完成了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100206
					],
					"speakerTitle": "叶卡捷琳娜"
				},
				{
					"id": 10100206,
					"content": "约定完成了？啊，是指他之前说的，要帮我们找人吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10100207,
					"content": "是的，「公子」大人答应会为你们找到能够突破僵局的人。「愚人众」执行官的承诺从不落空。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100208
					],
					"speakerTitle": "叶卡捷琳娜"
				},
				{
					"id": 10100208,
					"content": "那么，他人在哪？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10100209,
					"content": "大人在<color=#00E1FFFF>「琉璃亭」</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100210
					],
					"speakerTitle": "叶卡捷琳娜"
				},
				{
					"id": 10100210,
					"content": "琉璃亭？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100211
					]
				},
				{
					"id": 10100211,
					"content": "呀，是琉璃亭！我听说过！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10100212,
					"content": "璃月的两大菜系，「璃菜」和「月菜」，互相斗争了几百年，不分上下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10100213,
					"content": "「璃菜」的最高代表，就是「琉璃亭」酒家。老板特地把店开在了绯云坡，和代表「月菜」的「新月轩」当面竞争呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100214,
						10100215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10100214,
					"content": "派蒙只有在这种时候才像个好向导。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100216
					]
				},
				{
					"id": 10100216,
					"content": "#不要这么说嘛——总之，有好吃的！{NICKNAME}，我们快点过去吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10100215,
					"content": "一到蹭吃蹭喝的话题，你就…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100216
					]
				},
				{
					"id": 10100203,
					"content": "我不打算加入「愚人众」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100204
					]
				}
			]
		},
		{
			"id": 101003,
			"completionStepIds": [
				101003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101003",
							"2"
						],
						"stepId": 101003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「公子」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10100301,
					"content": "哟，你们来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100302
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10100302,
					"content": "约定已经完成了，我找到了能帮助你们的人——能解决「岩神的仙体被七星藏匿」这个难题的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100303
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10100303,
					"content": "那么，这个人又在哪？<color=#00E1FFFF>「琉璃亭」</color>里吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10100304,
					"content": "没错。跟我来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100305
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10100305,
					"content": "我准备了一场——嗯，在这个国家，叫做「饭局」的见面仪式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「公子」"
				}
			]
		},
		{
			"id": 101005,
			"completionStepIds": [
				101005
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101005",
							"2"
						],
						"stepId": 101005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"钟离"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10100501,
					"content": "我来介绍一下，这位朋友是道上人士、「往生堂」的客卿，钟离先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100502,
						10100503
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10100502,
					"content": "道上人士？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100504
					]
				},
				{
					"id": 10100504,
					"content": "嗯，在璃月，像「往生堂」这样的产业，总是不得不接触一些「道上」的生意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100505
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10100505,
					"content": "而我们愚人众，一向都喜欢与这些…在阴影中行走的朋友们打交道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100506
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10100506,
					"content": "在，在阴影中行走…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10100507,
					"content": "二位，幸会。我听过你们在蒙德的传闻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100508
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10100508,
					"content": "道上人士…阴影…送人「往生」…哇！难道说，「往生堂」这个组织，是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100509
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10100509,
					"content": "没错，正如你所猜测。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100510
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10100510,
					"content": "呀——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100511
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10100511,
					"content": "「往生堂」是执掌葬仪的组织，旨在送人安心往生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100512
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10100512,
					"content": "咦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100513
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10100513,
					"content": "哈哈，难道是把钟离先生误认成杀手了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100514
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10100514,
					"content": "愚人众的朋友里确实有很多杀手，但「往生堂」并不是做这一行的…起码明面上不是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100515
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10100515,
					"content": "明面上…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100516
					]
				},
				{
					"id": 10100516,
					"content": "毕竟还是「道上人士」嘛，这就不能细说了。总之，我带你们来认识钟离，是因为…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100517
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10100517,
					"content": "因为我有办法让你们见到岩王帝君的仙体。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100518
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10100518,
					"content": "什么？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100519
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10100519,
					"content": "哈，不必惊讶，虽然在「天权星」凝光的操纵下，岩神的仙体早已被藏匿起来…但，还是先听听钟离的说法吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100520
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10100520,
					"content": "岩王帝君虽是众仙之祖，但说到底也算是仙人之一。纵观璃月数千年的历史，仙人纷纷离去，这是不可挽回的趋势。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100521
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10100521,
					"content": "因为时代变了——你在绝云间，应该也已体会到这种变迁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100522,
						10100523
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10100522,
					"content": "确实，仙人们正在远离璃月。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100525
					]
				},
				{
					"id": 10100525,
					"content": "如你所见，仙众的时代正在远去，人的时代正在逐渐成为现实。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100526
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10100526,
					"content": "往年每位仙人离去时，都会有一场盛大的纪念仪式。这是璃月的传统。但这次竟连七星都无暇顾及这项传统…实在不成样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100527
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10100527,
					"content": "毕竟是「谋杀神明的奇案」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100528
					]
				},
				{
					"id": 10100528,
					"content": "是啊，连真正的凶手都没抓到呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100529
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10100529,
					"content": "谋杀神明的奇案…「往生堂」不关心这种事。「往生堂」关心的是，请仙的仪式如此隆重，送仙的仪式就没人管了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100530
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10100530,
					"content": "旅者，我从「公子」那里听说了你的事。既然你与风神有些交情…那么，可否考虑与我一起，筹备一场送别岩神的仪式？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100531,
						10100534,
						10100536
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10100531,
					"content": "我需要再思考一下…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100532
					]
				},
				{
					"id": 10100532,
					"content": "#唔…{NICKNAME}，仔细想想，恐怕也没有别的办法了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100533
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10100533,
					"content": "没错，再多思考也是一样的结果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100539
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10100539,
					"content": "「天权」凝光…她正在阻止任何人瞻仰帝君的仙体。所以，如果你想达成寻访七神的目标，就只剩这样一条渠道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100540
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10100540,
					"content": "正是如此。唯有参与「送仙典仪」，你才能再次得见岩神之躯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100541
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10100541,
					"content": "看来也没有别的办法了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100542
					]
				},
				{
					"id": 10100542,
					"content": "嗯，若你答允，就跟我来吧。详细的情况，我们路上再说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100543
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10100543,
					"content": "（黑屏，钟离出门）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100544
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10100544,
					"content": "好了，我牵线搭桥的任务已经完成了。怎样，这结果还不错吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100545
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10100545,
					"content": "你们要走的话就走吧，不用管我，我也许会在这里再喝几杯…顺便熟悉一下「筷子」的用法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10100534,
					"content": "要接受邀请，也不是不行…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100535
					]
				},
				{
					"id": 10100535,
					"content": "明智之选。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100539
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10100536,
					"content": "「公子」的话太多了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100537
					]
				},
				{
					"id": 10100537,
					"content": "哦？在「道上」，这句话就是要灭口的意思咯…很有意思，拔剑吧，我们就在这里——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100538
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10100538,
					"content": "开玩笑的。我们继续说正事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100539
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10100523,
					"content": "七神之一的岩神，也是仙人？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100524
					]
				},
				{
					"id": 10100524,
					"content": "神有许多尊名。契约之神、商业之神、武神、摩拉克斯、岩王帝君…其中自然也包括「仙人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100525
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10100503,
					"content": "往生堂？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100504
					]
				}
			]
		},
		{
			"id": 101006,
			"completionStepIds": [
				101006
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
