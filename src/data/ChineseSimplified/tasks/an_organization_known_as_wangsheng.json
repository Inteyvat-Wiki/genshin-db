				"objectNames": [
					"钟离"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10100601,
					"content": "旅者，经历了「神离开的城邦」以后，你对璃月这「有神之地」，感受如何呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100602,
						10100605
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10100602,
					"content": "我更喜欢蒙德的气氛。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100603
					]
				},
				{
					"id": 10100603,
					"content": "原来如此…你是这种类型的游人。那也不错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100604
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10100604,
					"content": "不过，「有神之地」三千七百年的历史厚度，或许你还没有完全体验到吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100607
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10100607,
					"content": "筹办「送仙典仪」的过程，也会成为你旅途的一部分，增广见闻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100608
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10100608,
					"content": "璃月是尘世七国里最繁荣的一国，往年也有神灵镇守、七星统治。所以「愚人众」的许多外交手段，在璃月都施展不开。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100609
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10100609,
					"content": "七星之一的凝光，始终对愚人众重重防备，或许这就是「公子」想借「往生堂」关系办事的原因吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100610
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10100610,
					"content": "唔…我们要办「送仙典仪」，对「公子」有什么好处呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100611
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10100611,
					"content": "我不知道，也不想知道。对我来说，「愚人众」只是提供资金支持，我只希望璃月的传统不要被人遗忘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100612
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10100612,
					"content": "（钟离交给主角一个钱袋）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100613
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10100613,
					"content": "这是「公子」给的第一笔垫付资金。如果用完，也可以再去找他报销后续款项。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100614
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10100614,
					"content": "哇哦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100615
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10100615,
					"content": "好了，我们动身吧。筹备仪式的第一步…是要取得品质足以匹配神灵的，最上等的<color=#00E1FFFF>「夜泊石」</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "钟离"
				},
				{
					"id": 10100605,
					"content": "果然还是璃月好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100606
					]
				},
				{
					"id": 10100606,
					"content": "嗯，「有神之地」三千七百年的历史厚度，在七国中亦是最深。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100607
					],
					"speakerTitle": "钟离"
				}
			]
		},
