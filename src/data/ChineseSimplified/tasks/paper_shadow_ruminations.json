				]
			},
			"dialogs": [
				{
					"id": 715310101,
					"content": "圆圆滚滚蓬蓬松松，软软弹弹蹦蹦跳跳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310102
					],
					"speakerTitle": "文寻"
				},
				{
					"id": 715310102,
					"content": "呀！有客人来了，你们好你们好，我文寻先祝两位海灯节快乐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310103
					],
					"speakerTitle": "文寻"
				},
				{
					"id": 715310103,
					"content": "海灯节快乐，文寻小姐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715310104,
					"content": "刚才我们好像听见你念念有词，你在自言自语什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310105,
						715310106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715310105,
					"content": "在想好吃的点心？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715310107
					]
				},
				{
					"id": 715310107,
					"content": "猜得八九不离十了，我在想的是锅巴和月桂要做的美食哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310108
					],
					"speakerTitle": "文寻"
				},
				{
					"id": 715310108,
					"content": "欸？突然就听到了熟悉的名字…你也认识锅巴和月桂吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715310109,
					"content": "嘿嘿！那是当然了，我可是万民堂的常客！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310110
					],
					"speakerTitle": "文寻"
				},
				{
					"id": 715310110,
					"content": "只要不出门旅行，我一周至少去万民堂吃七顿！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310111
					],
					"speakerTitle": "文寻"
				},
				{
					"id": 715310111,
					"content": "搭配我家常吃的菜式，一餐清淡，一餐香辣，好不爽快！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310112
					],
					"speakerTitle": "文寻"
				},
				{
					"id": 715310112,
					"content": "就算上火了，抓几味清火的药材，好好调理两天，就能继续大吃特吃了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310113,
						715310114
					],
					"speakerTitle": "文寻"
				},
				{
					"id": 715310113,
					"content": "听着好棒…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715310115
					]
				},
				{
					"id": 715310115,
					"content": "我我我，我也有点想试试这样的生活了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715310116,
					"content": "总之，我差不多每个礼拜都能见到锅巴和香菱小姐，有时还会遇上瑶瑶小妹妹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310117
					],
					"speakerTitle": "文寻"
				},
				{
					"id": 715310117,
					"content": "瑶瑶带着月桂来看望香菱小姐的时候，锅巴就会和月桂在一边玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310118
					],
					"speakerTitle": "文寻"
				},
				{
					"id": 715310118,
					"content": "真好真好，光是看着锅巴和月桂摇摇晃晃，工作的劳累就一扫而空了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310119
					],
					"speakerTitle": "文寻"
				},
				{
					"id": 715310119,
					"content": "不能只有我被锅巴和月桂治愈！我要让大家都见证锅巴和月桂的可爱！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310120
					],
					"speakerTitle": "文寻"
				},
				{
					"id": 715310120,
					"content": "说得好！这可是一项大事！不过，具体要怎么做呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715310121,
					"content": "难道你桌上的这些东西就是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715310122,
					"content": "答对啦！我刚刚完成了一部以锅巴和月桂为主角的「剪纸戏」，这个摊位上的东西，全都是「剪纸戏」的道具！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310123
					],
					"speakerTitle": "文寻"
				},
				{
					"id": 715310123,
					"content": "「剪纸戏」…总觉得这个名字有点耳熟？是要在你后边的画板上观看的…映影吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715310124,
					"content": "你们可能听说过「纸映剧」，那是一种在璃月流传已久的艺术。灵活运用画片和灯具，就能让画面在幕布上「活」起来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310125
					],
					"speakerTitle": "文寻"
				},
				{
					"id": 715310125,
					"content": "我从小就非常喜欢「纸映剧」，跟着应公师傅学了一些门道。长大后，我又成了画师，四处游学。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310126
					],
					"speakerTitle": "文寻"
				},
				{
					"id": 715310126,
					"content": "在枫丹旅行期间，我接触了几种新的绘画技巧，还有映影这门技术，有了不少灵感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310127
					],
					"speakerTitle": "文寻"
				},
				{
					"id": 715310127,
					"content": "于是，我尝试在「纸映剧」的基础上，制作了一种更为新颖的互动游戏，就是你们面前的「剪纸戏」啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310128
					],
					"speakerTitle": "文寻"
				},
				{
					"id": 715310128,
					"content": "「剪纸戏」与「纸映剧」的风格不同，侧重于讲述简单明快的故事，让观众们会心一笑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310129
					],
					"speakerTitle": "文寻"
				},
				{
					"id": 715310129,
					"content": "所以说，今年这第一场「剪纸戏」会给大家讲一个非常亲切的故事——锅巴和月桂共同寻找食材，共同制作美食！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310130
					],
					"speakerTitle": "文寻"
				},
				{
					"id": 715310130,
					"content": "锅巴和月桂一起做饭？听起来很有意思！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310131,
						715310132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715310131,
					"content": "好吃的和好玩的！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715310133
					]
				},
				{
					"id": 715310133,
					"content": "嘿嘿，看见你们两位兴致高涨，我大受鼓舞！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310134
					],
					"speakerTitle": "文寻"
				},
				{
					"id": 715310134,
					"content": "那事不宜迟，就请两位放松心情，好好体验一下「剪纸戏」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "文寻"
				},
				{
					"id": 715310132,
					"content": "我也要仔细看看！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715310133
					]
				},
				{
					"id": 715310114,
					"content": "你悠着点…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715310115
					]
				},
				{
					"id": 715310106,
					"content": "还是什么新菜谱？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715310107
					]
				}
			]
		}
	]
}