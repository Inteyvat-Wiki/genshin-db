			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"莫娜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105020101,
					"content": "马上就要见到那位继承者了，你准备好了吗？可别让你的师父丢脸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020102,
						105020103
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105020102,
					"content": "我又不会算命…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020104
					]
				},
				{
					"id": 105020104,
					"content": "也对…不对！就算是假的弟子，也不能一问三不知吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020105
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105020105,
					"content": "虽然师门有规定，不得传授外人，不过…如果是你，也未尝不可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020106
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105020106,
					"content": "我的占星术是「水占术」，顾名思义，是通过水中的倒影观看真正的星空。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020107
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105020107,
					"content": "让我先给你示范一下，看仔细了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020108
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105020108,
					"content": "就目前的星象和走势来看，嗯，那位继承者是西风骑士，年轻有为…女性…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020109
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105020109,
					"content": "听这个描述…唔…难道是丽莎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 105020110,
					"content": "我们马上就会在这里遇见她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020111
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105020111,
					"content": "好了，有这么多信息应该就足够了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020112,
						105020113
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105020112,
					"content": "就，就结束了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020114
					]
				},
				{
					"id": 105020114,
					"content": "唉，看来就算是最基础的占星术，也不是一目了然的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020115
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105020115,
					"content": "算了，等会儿再详细给你讲，她已经来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020116
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105020116,
					"content": "#哇，是荣誉骑士{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}！还有小派蒙，你们回来啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020117
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 105020117,
					"content": "——就是她！伟大学识的继承者！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020118,
						105020119
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105020118,
					"content": "…你说可莉？！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020120
					]
				},
				{
					"id": 105020120,
					"content": "继承者…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020121
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 105020121,
					"content": "没错，我就是那个洞悉了星海秘密的占星术士！你也早就计算出我的到来了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020122
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105020122,
					"content": "星海？星海是什么，星海里也有鱼吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020123
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 105020123,
					"content": "鱼…？不，别装糊涂了。你是在害怕我的挑战吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020124
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105020124,
					"content": "姐姐你才是，在说什么呀！我一点都没听懂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020125,
						105020126
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 105020125,
					"content": "这样聊下去会没完没了的！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020127
					]
				},
				{
					"id": 105020127,
					"content": "但我的占星术是不会错的…唔，以防万一我还是问一下，你的妈妈叫「艾莉丝」，对吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020128
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105020128,
					"content": "对啊。哦！姐姐是妈妈的朋友啊。但是，妈妈现在去了很远的地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020129
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 105020129,
					"content": "这个我知道——是占星的结果。但在她走之前，应该把她懂得的神秘学知识，都留给你了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020130
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105020130,
					"content": "神秘学，知识…听不太懂，妈妈只教了我要怎么做蹦蹦炸弹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020131
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 105020131,
					"content": "原来可莉的妈妈，就是莫娜师父的「朋友兼劲敌」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 105020132,
					"content": "是的。我师父虽然很擅长占星术，但她也只懂占星术。艾莉丝就不一样了，她是精通各种神秘领域的全才…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020133
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105020133,
					"content": "所以…可莉年纪这么小，就算听了那些高深的知识，也听不懂吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 105020134,
					"content": "嗯，看来是只继承了血脉，还没继承知识…真是失算，这根本没法较量…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020135
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105020135,
					"content": "对了，这位小朋友。艾莉丝走之前，告诉过你「五十年之约」，和那个箱子的事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020136
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105020136,
					"content": "哦哦，这个我知道！原来姐姐是来拿那个箱子的呀。我找找，等一下哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020137
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 105020137,
					"content": "不是这个…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020138
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 105020138,
					"content": "也不是这个…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020139
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 105020139,
					"content": "不对不对，这个也不是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020140
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 105020140,
					"content": "啊！我想起来了，我把它和我的新宝物都藏在<color=#00E1FFFF>风起地</color>了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020141,
						105020142
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 105020141,
					"content": "不会又是炸弹吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020143
					]
				},
				{
					"id": 105020143,
					"content": "你们等我一下，我马上拿过来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020144
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 105020144,
					"content": "别跑啊！你包里的东西都不要了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020145
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 105020145,
					"content": "我帮她收拾这些东西，你们去追她吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020146
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105020146,
					"content": "唉，看她这么冒冒失失的，我真担心箱子会出什么事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105020142,
					"content": "为什么总把重要的东西埋在野外…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020143
					]
				},
				{
					"id": 105020126,
					"content": "所以说绝对是搞错了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020127
					]
				},
				{
					"id": 105020119,
					"content": "绝对是搞错了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020120
					]
				},
				{
					"id": 105020113,
					"content": "我还没看清呢！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020114
					]
				},
				{
					"id": 105020103,
					"content": "我又不会占星…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020104
					]
				}
			]
		},
		{
			"id": 1050202,
			"completionStepIds": [
				1050204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1050204",
							"2"
						],
						"stepId": 1050204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"可莉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105020201,
					"content": "到了到了，就是这里，我们来把宝物挖出来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020202,
						105020203
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 105020202,
					"content": "这一定是草史莱姆吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020204
					]
				},
				{
					"id": 105020204,
					"content": "不会的，我专门做了记号，是不会有错的——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020205
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 105020205,
