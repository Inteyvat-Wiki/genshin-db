				"points": []
			},
			"dialogs": [
				{
					"id": 105020401,
					"content": "你们终于回来了，等得我好无聊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020402
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105020402,
					"content": "本来还想看看书打发时间，结果这居然是一本莫名其妙的日记，一点意思都没有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020403
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105020403,
					"content": "明明是从可莉的包里掉出来的，我还以为记载了什么古代知识呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020404
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105020404,
					"content": "不管了，所以，箱子找到了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020405
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105020405,
					"content": "找到啦，完好无损！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020406
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 105020406,
					"content": "那太好了——等等？！为、为什么没有锁着？！里面…呃！里面又为什么是空的啊？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020407
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105020407,
					"content": "咦——？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 105020408,
					"content": "是这样的，因为我借用了这个箱子，用来装我收集的宝贝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020409
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 105020409,
					"content": "借用？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020410
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105020410,
					"content": "现在姐姐要收回这个箱子，所以我就把我的宝贝都拿了出来，箱子就是空的了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020411
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 105020411,
					"content": "你用来装你的东西了？！…那、那原本里面装着的东西呢？我要的是那个！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020412
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105020412,
					"content": "哦，姐姐原来是要以前装在箱子里面的东西…早说嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020413
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 105020413,
					"content": "你…该不会把它弄坏了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020414
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105020414,
					"content": "没有！一点都没弄坏哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020415
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 105020415,
					"content": "呼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020416
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105020416,
					"content": "那件东西，就是姐姐手里的那本书呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020417
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 105020417,
					"content": "咿——？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020418
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105020418,
					"content": "这、这…原来这书，这日记…是老太婆的…难道是她五十年前的日记？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020419
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105020419,
					"content": "时隔五十年要回收的，是她少女时代的黑历史吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020420
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105020420,
					"content": "完了！难怪…！难怪老太婆说…无论如何都不能看，看了就要把我大卸八块…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020421
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105020421,
					"content": "我，我是不是闯祸了…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020422
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 105020422,
					"content": "啊！是姐姐说想要箱子的，没说里面东西的事情！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020423
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 105020423,
					"content": "我什么都不知道！我先走了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020424,
						105020425
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 105020424,
					"content": "真是个感人的结局…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020426
					]
				},
				{
					"id": 105020426,
					"content": "唔…不过，只要莫娜不说，你的师父也不知道你看过日记了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020427
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 105020427,
					"content": "不可能，占星术能看破一切谎言，你们也都见识过了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020428
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105020428,
					"content": "啊…花光所有摩拉来了蒙德，没有得到知识，现在也回不去了，怎么会变成这样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020429
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105020429,
					"content": "好可怜…要不然，就等你把书里的内容都忘光了，再回去吧？",
