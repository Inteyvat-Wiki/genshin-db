			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"胡塞尼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700290101,
					"content": "旅行者，情况如何？「普尔希娜光钉」派上用场了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290102,
						700290103
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700290102,
					"content": "帮了大忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700290104
					]
				},
				{
					"id": 700290104,
					"content": "很好很好，我们没白忙活这么久，这项委托总算是结束了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290105
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700290105,
					"content": "至于这台特异体，它的功能设计似乎和野外常见的遗迹守卫、遗迹猎手有很大不同，整体的设计思路比它们优秀太多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290106
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700290106,
					"content": "不过，拥有类似设计的自律机关并不常见，我猜测，它可能是某种试作产品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290107
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700290107,
					"content": "它最初的设计者到底是出于何种目的制造了它呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290108
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700290108,
					"content": "这是不是意味着…古文明的自律机关制作水平比目前学术界以为的还要高？真有意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290109
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700290109,
					"content": "如果能拆解它的内部结构，一定能获得具有革新意义的发现…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290110
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700290110,
					"content": "旅行者，有空的话，能带我去看看特异体的残骸吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290111
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700290111,
					"content": "已经不剩什么了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700290112
					]
				},
				{
					"id": 700290112,
					"content": "什么？你难道把它的机体给打烂了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290113
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700290113,
					"content": "神啊…这是多么巨大的浪费！不，是巨大的失误！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290114
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700290114,
					"content": "唉，我应该事前提醒你的，都怪我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290115
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700290115,
					"content": "太可惜了，太可惜了，这可是古文明技术史领域的重大发现，居然连样本都没留下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290116,
						700290119
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700290116,
					"content": "抱歉。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700290117
					]
				},
				{
					"id": 700290117,
					"content": "不不，你并不了解这件事的学术意义，所以才会这样做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290118
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700290118,
					"content": "懂得它意义的我却没有早点提醒你，这是我的问题，责任并不在你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290121
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700290121,
					"content": "我这次外出调研真是太坎坷了，先是无法长期驻留离岛，后是白白放过了这么重大的学术发现…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290122
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700290122,
					"content": "…算了算了，还是乐观些吧。至少这件事促使我修好了「普尔希娜光钉」，还成功验证了它的功能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290123
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700290123,
					"content": "创造出如此精妙的仪器的普尔希娜和阿叶夏前辈真是了不起，他们的伟大发明不该被闲置在仓库里的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290124
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700290124,
					"content": "这次的稻妻考察要是实在进行不下去，我就把课题换成「普尔希娜光钉」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290125
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700290125,
					"content": "如果「普尔希娜光钉」这个课题能够受到「教令院」重视，又万一我的研究报告能得到发表…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290126
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700290126,
					"content": "哈哈，我一定会在致谢中写上你的名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290127
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700290127,
					"content": "希望我能看懂你的报告。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700290128
					]
				},
				{
					"id": 700290128,
					"content": "哈哈，到那时候再说吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290129
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700290129,
					"content": "这次我们合作愉快，希望你今后的旅途也能顺利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700290119,
					"content": "如果你早些告诉我…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700290120
					]
				},
				{
					"id": 700290120,
					"content": "没有早点想到这一层是我考虑不周，现在说什么都晚了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290121
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700290103,
					"content": "问题已经被解决了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700290104
					]
				}
			]
		}
	]
}