			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"秋纽奥"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750880301,
					"content": "嗯，如果有足够多的样本的话，说不定…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880302
					],
					"speakerTitle": "秋纽奥"
				},
				{
					"id": 750880302,
					"content": "哦，这里有个奇怪的家伙在嘀嘀咕咕的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750880303,
					"content": "像我这样的人在纳塔到处都是，奇怪的反而是你们哦…如果没什么事就不要打扰我做研究啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880304
					],
					"speakerTitle": "秋纽奥"
				},
				{
					"id": 750880304,
					"content": "我这个月的支出超出了预计的额度，只能靠解决协会里悬赏的研究问题来补贴一番。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880305
					],
					"speakerTitle": "秋纽奥"
				},
				{
					"id": 750880305,
					"content": "原来做研究还有钱拿呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750880306,
					"content": "是呀，「龙遗物研究协会」就是这样的组织，有奖赏，才能促进大伙研究各种课题嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880307
					],
					"speakerTitle": "秋纽奥"
				},
				{
					"id": 750880307,
					"content": "这次我就要挑战「镌光铭印」的破译…据说这是没有人完成的伟业，能得到的摩拉也有很多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880308
					],
					"speakerTitle": "秋纽奥"
				},
				{
					"id": 750880308,
					"content": "不过…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880309
					],
					"speakerTitle": "秋纽奥"
				},
				{
					"id": 750880309,
					"content": "不过什么呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750880310,
					"content": "如果要破译「镌光铭印」，首先就得有足够多的「镌光铭印」碎片才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880311
					],
					"speakerTitle": "秋纽奥"
				},
				{
					"id": 750880311,
					"content": "…嗯，这样吧，如果你们能够找来「镌光铭印」的碎片的话，我就给你们报酬，如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880312
					],
					"speakerTitle": "秋纽奥"
				},
				{
					"id": 750880312,
					"content": "看上去你们是经验丰富的冒险家嘛，应该经常接到这样的委托吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880313
					],
					"speakerTitle": "秋纽奥"
				},
				{
					"id": 750880313,
					"content": "倒也不是不行啦，不过你这个月的支出不是已经超额了嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750880314,
					"content": "既然已经超额了，多超少超根本不是问题…只要拿到「镌光铭印」的碎片，破译其中的内容，多少摩拉都能有！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880315,
						750880316
					],
					"speakerTitle": "秋纽奥"
				},
				{
					"id": 750880315,
					"content": "我们只负责找碎片…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750880317
					]
				},
				{
					"id": 750880317,
					"content": "你们只要保证能够拿到「真货」就好，说起来就来气，这个月有贩子卖给我的秘源遗迹物件根本就是伪造的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880318
					],
					"speakerTitle": "秋纽奥"
				},
				{
					"id": 750880318,
					"content": "坑了我好大一笔摩拉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880319
					],
					"speakerTitle": "秋纽奥"
				},
				{
					"id": 750880319,
					"content": "啊，原来是因为这样才超支的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750880320,
					"content": "所以，就要用「镌光铭印」的碎片打个翻身仗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880321
					],
					"speakerTitle": "秋纽奥"
				},
				{
					"id": 750880321,
					"content": "拜托了，寻找碎片就拜托给你们了！如果找到了请一定要带到我这儿来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880322
					],
					"speakerTitle": "秋纽奥"
				},
				{
					"id": 750880322,
					"content": "呃，倒也不用太多，就…三，不，四个吧！多的我就实在付不起酬劳了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "秋纽奥"
				},
				{
					"id": 750880316,
					"content": "不保证碎片一定有用哦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750880317
					]
				}
			]
		},
