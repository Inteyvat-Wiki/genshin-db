					"秋纽奥"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750880201,
					"content": "哈哈，了不起，这下我一定能够破译「镌光铭印」上的这些金纹…悬赏，悬赏一定是我的了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880202
					],
					"speakerTitle": "秋纽奥"
				},
				{
					"id": 750880202,
					"content": "不如说如果这次也失败，那就彻底没有经费了，生死成败在此一举！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880203
					],
					"speakerTitle": "秋纽奥"
				},
				{
					"id": 750880203,
					"content": "啊，对了，这是给你们的酬劳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "秋纽奥"
				}
			]
		},
		{
			"id": 7508803,
			"completionStepIds": [
				7508803
			],
