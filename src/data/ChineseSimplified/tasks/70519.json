					"菲谢尔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705190201,
					"content": "伯恩哈德，我们筹集到足够的资金啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705190202,
					"content": "居然这么快？你们的效率也太惊人了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190203
					],
					"speakerTitle": "伯恩哈德"
				},
				{
					"id": 705190203,
					"content": "万事俱备，只差开店了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705190204
					]
				},
				{
					"id": 705190204,
					"content": "好，我这边也和供货商们谈好了，请稍等。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190205
					],
					"speakerTitle": "伯恩哈德"
				},
				{
					"id": 705190205,
					"content": "伯恩哈德向供货商交付了「佳酿晶冻」，不久后就将店铺搭建完毕。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705190206
					]
				},
				{
					"id": 705190206,
					"content": "怎么样，看起来还不错吧！如果你们有什么灵感，随时可以调整店铺的装潢哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190207
					],
					"speakerTitle": "伯恩哈德"
				},
				{
					"id": 705190207,
					"content": "有模有样，很有感觉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705190208,
					"content": "我来给店铺起一个名字吧…就叫「西风呼呼义卖铺」好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190209,
						705190211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705190209,
					"content": "很有派蒙的风格。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705190210
					]
				},
				{
					"id": 705190210,
					"content": "就当你是在表扬我好了！那，伯恩哈德，还需要我们做点什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705190213,
					"content": "筹集资金是门苦差事，已经让你们受累了。繁琐的工作不劳你们，全都交给我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190214
					],
					"speakerTitle": "伯恩哈德"
				},
				{
					"id": 705190214,
					"content": "你们见多识广，还请你们确定本店的经营方向，比如销售方针、服务特点和品控原则…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190215
					],
					"speakerTitle": "伯恩哈德"
				},
				{
					"id": 705190215,
					"content": "这些词是我从其他店主那里听来的，我不太理解，但知道它们很重要，还是由你们来决定为妙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190216
					],
					"speakerTitle": "伯恩哈德"
				},
				{
					"id": 705190216,
					"content": "也就是说，我们两个来当店主，负责店铺的整体策略，而你来当店员，负责具体的工作？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705190217,
					"content": "是的，我就擅长执行，请把我当成「工具人」吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190218
					],
					"speakerTitle": "伯恩哈德"
				},
				{
					"id": 705190218,
					"content": "好强的觉悟…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705190219
					]
				},
				{
					"id": 705190219,
					"content": "呃，倒也不用这么夸张啦，我们也不是黑心店长嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705190220,
					"content": "#你先去休息一下吧，伯恩哈德，我和{NICKNAME}要好好商量一下策略。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705190221,
					"content": "根据以往的见闻，和派蒙研究了店里的商品，讨论了经营店铺的要点…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705190222
					]
				},
				{
					"id": 705190222,
					"content": "好，要点很清楚，目标是做成「集市上最棒的小吃店」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705190223,
					"content": "接下来就拿出最好的状态，迎接第一批顾客吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705190224,
					"content": "开店开店！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705190225
					]
				},
				{
					"id": 705190225,
					"content": "#{NICKNAME}和派蒙？没想到能在这里碰见你们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190226
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705190226,
					"content": "莫娜和菲谢尔！你们也来集市玩啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190227
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705190227,
					"content": "呵！不枉本皇女采信那冥冥之中的预感，让梅姬斯图斯卿陪同我前来巡视这凡俗的节庆…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190228
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 705190228,
					"content": "即便是平平无奇的秋日，也隐伏着常理之外的转机…妙哉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190229
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 705190229,
					"content": "小姐正按捺着喜悦的嗓音，能见到你们，她的心情好得出奇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190230
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 705190230,
					"content": "奥…奥兹！添油加醋！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190231
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 705190231,
					"content": "哼哼，还是由我来说明吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190232
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705190232,
					"content": "不久前皇女殿下做了个不错的梦，感觉最近会有好事发生，想来找我咨询星象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190233
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705190233,
					"content": "另外，她发现佳酿节办得挺热闹的，就问我要不要一起去逛逛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190234
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705190234,
					"content": "我当然答应喽。正好可以趁着节日促销采购一大批物资，为赶稿做准备。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190235
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705190235,
					"content": "其实，也多亏皇女殿下的提醒，我才知道佳酿节已经到了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190236
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705190236,
					"content": "梅姬斯图斯卿，本皇女必须强调，那个梦是九天前的事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190237
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 705190237,
					"content": "在此期间，梅姬斯图斯卿一直没有回信，本皇女才莅临你的住所。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190238
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 705190238,
					"content": "等等…已经过去九天了？九天？！怎么这么快！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190239
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705190239,
					"content": "念在这次的文稿对于梅姬斯图斯卿至关重要，本皇女就不计较了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190240
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 705190240,
					"content": "不过还请梅姬斯图斯卿留意，门口的信箱塞得满满当当，可能有不少人以为您失联了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190241
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 705190241,
					"content": "莫娜还真是沉浸在学术研究里啊，忘记了时间，忘记给别人回信，也没注意到这么盛大的庆典。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190242,
						705190243
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705190242,
					"content": "不被外界干扰有时很重要。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705190244
					]
				},
				{
					"id": 705190244,
					"content": "总…总之！时间紧迫，我要快点采购完所有物资！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190245
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705190245,
					"content": "#话说回来，真想不到{NICKNAME}和派蒙会亲自开店啊，还是我最关注的小吃店！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190246
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705190246,
					"content": "我们也是受人所托啦，嘿嘿，请多多关照小店生意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190247
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705190247,
					"content": "莫娜有什么想买的吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705190248
					]
				},
				{
					"id": 705190248,
					"content": "让我想想…你们有没有推荐的…嗯…下酒菜？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190249
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705190249,
					"content": "当然有了，要多少有多少！让我看看菜单啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190250
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705190250,
					"content": "等等…欸？下酒菜？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190251
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705190251,
					"content": "难道说，莫娜你因为稿子进展不顺利，开始酗酒了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190252
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705190252,
					"content": "这样说来，小姐近来常去拜访，可能确实耽误了不少时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190253,
						705190255
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 705190253,
					"content": "要振作啊，莫娜！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705190254
					]
				},
				{
					"id": 705190254,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190257
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 705190257,
					"content": "不是啦，跟喝酒和拜访都无关啦！你们别紧张…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190258
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705190258,
					"content": "之前皇女殿下请我品尝过她拿手的冷肉拼盘…不好意思，是「祝圣交响乐」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190259
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705190259,
					"content": "滋味独特，每一口都能带来实实在在的肉的满足感，我还没回过神来就全吃完了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190260
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705190260,
					"content": "呃…客人享受食物，对厨师来说也算是一种认可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190261
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705190261,
					"content": "冷肉拼盘确实很棒。能补充能量，还可以长期保存。通常是被用来当作下酒菜的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190262
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705190262,
					"content": "除了价格因素，其他方面确实远胜过「满足沙拉」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190263
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705190263,
					"content": "但反过来思考，佳酿节的主题是美酒，下酒菜会跟着打折出售。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190264
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705190264,
					"content": "天赐良机，必须要牢牢把握。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190265
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705190265,
					"content": "欢愉吧，梅姬斯图斯卿！那是本皇女出游期间一时兴起的作品，你还有机会享受到至为臻美的佳肴…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190266
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 705190266,
					"content": "小姐的意思是，她还没有施展全部本领。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190267
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 705190267,
					"content": "我知道的！皇女殿下的厨艺远远不止那盘菜的水平…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190268
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705190268,
					"content": "但我作为臣子，怎么能让皇女殿下亲自下厨呢…不对，我是说，我怎么能让来家里的客人做饭呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190269
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705190269,
					"content": "至少，我也得多备点和沙拉不一样的…说不定能找出你中意的口味呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190270
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705190270,
					"content": "欸？原来莫娜是这样想的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190271
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 705190271,
					"content": "小姐，这种时候表现得「早有所料」和「眼观大局」更符合你的作风。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190272
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 705190272,
					"content": "咳咳！没错！梅姬斯图斯卿！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190273
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 705190273,
					"content": "作为本皇女认可之人，你应当尽览星天的奥秘…无需另做取悦本皇女之事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190274
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 705190274,
					"content": "别在意，我也不是每天都这么忙的…等有空之后拓展一下其他领域，也不是什么难事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190275
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705190275,
					"content": "那么——",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705190276
					]
				},
				{
					"id": 705190276,
					"content": "那么，就由我们「西风呼呼义卖铺」来解决这个难题吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190277
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705190277,
					"content": "店里不仅有即食的下酒菜，还有各类半成品，莫娜可以各买几种！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190278
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705190278,
					"content": "加工半成品花不了多少时间，也不容易出错，能让莫娜快速熟悉烹饪的技巧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190279
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705190279,
					"content": "等到你不那么忙了，再去挑战难度更高的菜肴吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190280
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705190280,
					"content": "#当然，我们也可以上门教学！{NICKNAME}做菜可是很有一套的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190281
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705190281,
					"content": "小菜一碟。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705190282
					]
				},
				{
					"id": 705190282,
					"content": "哈哈，真是个好主意！我都想提高预算了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190283
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705190283,
					"content": "梅姬斯图斯卿，本皇女期待着你的杰作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190284
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 705190284,
					"content": "但也请务必牢记派蒙卿的建议，合理分配时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190285
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 705190285,
					"content": "哼哼，好好等着看吧。下次你们再来我家的时候，就能享受到不一样的美味了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190286
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705190286,
					"content": "莫娜买到了理想的物资，郑重道谢后，与菲谢尔和奥兹心满意足地离去了…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705190287
					]
				},
				{
					"id": 705190287,
					"content": "嘿嘿，「西风呼呼义卖铺」获得了第一笔收入！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190288,
						705190289
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705190288,
					"content": "虽然营收不算多…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705190290
					]
				},
				{
					"id": 705190290,
					"content": "没错呢！看见客人买到了喜欢的商品，我也跟着高兴起来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190291
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705190291,
					"content": "原来出售别人需要的商品是这种感觉啊，当店主也很有意思嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190292
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705190292,
					"content": "#好了，{NICKNAME}，我们就一鼓作气，打响这间店铺的名号吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705190289,
					"content": "但意义相当重大…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705190290
					]
				},
				{
					"id": 705190255,
					"content": "收敛点啊，皇女殿下！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705190256
					]
				},
				{
					"id": 705190256,
					"content": "欸，欸？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190257
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 705190243,
					"content": "专注力让人羡慕。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705190244
					]
				},
				{
					"id": 705190211,
					"content": "还需要我们做些什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705190212
					]
				},
				{
					"id": 705190212,
					"content": "喂，不要无视我起的名字呀？至少也点一下头吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190213
					],
					"speakerTitle": "派蒙"
				}
			]
		},
