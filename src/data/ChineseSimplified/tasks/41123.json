			},
			"dialogs": [
				{
					"id": 411230101,
					"content": "您好，旅行者。这段时间请尽量待在城里，不要外出。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230102
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411230102,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230103
					]
				},
				{
					"id": 411230103,
					"content": "外面那些砸落的陨石，您应该也看见了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230104
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411230104,
					"content": "不知道为什么，这段时间陨石降落的势头似乎更猛了，野外也更加危险了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230105
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411230105,
					"content": "城内的事务越来越多，骑士团也要忙不过来了。偏偏最近城边还发现了不少盗宝团的踪迹…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230106
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411230106,
					"content": "这群为了钱什么都肯干的家伙，只怕是想要趁火打劫一番…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230107
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411230107,
					"content": "如果你愿意的话，能帮忙去城边赶走那些盗宝团吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230108
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411230108,
					"content": "本来这应该是骑士团的职责，但我们实在抽不出人手来处理这件事，只能拜托你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230109,
						411230111
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411230109,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230110
					]
				},
				{
					"id": 411230110,
					"content": "那就拜托你了，在这种情况下还让你帮忙，实在是不好意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411230111,
					"content": "盗宝团不怕陨石吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230112
					]
				},
				{
					"id": 411230112,
					"content": "哼，为了钱，那群家伙应该什么都不怕吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230113
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411230113,
					"content": "那就拜托你了，在这种情况下还让你帮忙，实在是不好意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "霍夫曼"
				}
			]
		},
