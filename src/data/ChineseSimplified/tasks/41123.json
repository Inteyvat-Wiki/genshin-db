			"dialogs": [
				{
					"id": 411230901,
					"content": "情况怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230902
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411230902,
					"content": "清泉镇已经安全了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230903
					]
				},
				{
					"id": 411230903,
					"content": "那就太好了…我还在发愁抽调不出人手来呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230904
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411230904,
					"content": "十分感谢你，实在帮大忙了，这些谢礼请收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230905
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411230905,
					"content": "唉，又是陨石，又是魔物…千万别再出什么乱子了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
