			},
			"dialogs": [
				{
					"id": 411230801,
					"content": "咦？怎么又是你，你去做什么了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230802
					],
					"speakerTitle": "胆小的莫罗"
				},
				{
					"id": 411230802,
					"content": "我把魔物都打倒了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230803
					]
				},
				{
					"id": 411230803,
					"content": "打倒了…真的假的，就你一个人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230804
					],
					"speakerTitle": "胆小的莫罗"
				},
				{
					"id": 411230804,
					"content": "你可以自己去看看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230805
					]
				},
				{
					"id": 411230805,
					"content": "呃…我可不敢自己去看，要是被魔物发现了可就完蛋了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230806
					],
					"speakerTitle": "胆小的莫罗"
				},
				{
					"id": 411230806,
					"content": "算了，不管你说的是真是假，我都得回去报告一声。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230807
					],
					"speakerTitle": "胆小的莫罗"
				},
				{
					"id": 411230807,
					"content": "要是你真把那些魔物都打倒了，镇子里的那些西风骑士总会有办法验证的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "胆小的莫罗"
				}
			]
		},
