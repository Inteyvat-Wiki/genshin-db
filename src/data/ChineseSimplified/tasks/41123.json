			"dialogs": [
				{
					"id": 411230401,
					"content": "呜哇！别，别过…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230402
					],
					"speakerTitle": "胆小的莫罗"
				},
				{
					"id": 411230402,
					"content": "咦？不是魔物…你，你是谁？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230403
					],
					"speakerTitle": "胆小的莫罗"
				},
				{
					"id": 411230403,
					"content": "关于魔物的情况…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230404
					]
				},
				{
					"id": 411230404,
					"content": "魔物的情况…那还用问吗？我就是刚从魔物堆旁边跑过来的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230405
					],
					"speakerTitle": "胆小的莫罗"
				},
				{
					"id": 411230405,
					"content": "就在旁边，一群魔物已经在那扎堆了，一副要进攻镇子的样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230406
					],
					"speakerTitle": "胆小的莫罗"
				},
				{
					"id": 411230406,
					"content": "要不是我跑得快，说不定你就看不到我了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230407
					],
					"speakerTitle": "胆小的莫罗"
				},
				{
					"id": 411230407,
					"content": "那群魔物在哪？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230408
					]
				},
				{
					"id": 411230408,
					"content": "就在镇子旁边，很近，走几步就能看见了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230409
					],
					"speakerTitle": "胆小的莫罗"
				},
				{
					"id": 411230409,
					"content": "你也快点去避难吧，我在这再歇一会…再歇一会就回去把情况告诉镇子里的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "胆小的莫罗"
				}
			]
		},
		{
