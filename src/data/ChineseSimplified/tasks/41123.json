			"dialogs": [
				{
					"id": 411231101,
					"content": "您好，荣誉骑士。这段时间请尽量待在城里，不要外出。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411231102
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411231102,
					"content": "外面那些砸落的陨石，您应该也看见了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411231103
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411231103,
					"content": "不知道为什么，这段时间陨石降落的势头似乎更猛了，野外也更加危险了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411231104
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411231104,
					"content": "城内的事务越来越多，骑士团也要忙不过来了。偏偏最近城边还发现了不少盗宝团的踪迹…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411231105
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411231105,
					"content": "这群为了钱什么都肯干的家伙，只怕是想要趁火打劫一番…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411231106
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411231106,
					"content": "如果你愿意的话，能帮忙去城边赶走那些盗宝团吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411231107,
						411231109
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411231107,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411231108
					]
				},
				{
					"id": 411231108,
					"content": "嗯，不愧是荣誉骑士。那就拜托你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411231109,
					"content": "盗宝团不怕陨石吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411231110
					]
				},
				{
					"id": 411231110,
					"content": "哼，为了钱，那群家伙应该什么都不怕吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411231111
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411231111,
					"content": "那就拜托你了，在这种情况下还让你帮忙，实在是不好意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "霍夫曼"
				}
			]
