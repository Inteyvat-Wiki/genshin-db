					"霍夫曼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411230301,
					"content": "你把那些盗宝团都赶走了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230302
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411230302,
					"content": "都赶走了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230303
					]
				},
				{
					"id": 411230303,
					"content": "太好了，实在是帮大忙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230304
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411230304,
					"content": "那群盗宝团吃了这个教训，应该不敢来趁火打劫了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230305
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411230305,
					"content": "没事的话…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230306
					]
				},
				{
					"id": 411230306,
					"content": "呃，请留步…还有一件事，想要再请你帮帮忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230307
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411230307,
					"content": "其实在陨石落下之后，骑士团就收到很多有关魔物异常的报告。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230308
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411230308,
					"content": "这些报告里面提到，魔物似乎也受到了陨石的影响，变得格外暴躁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230309
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411230309,
					"content": "蒙德城的防卫还算全面，不需要担心，但是有一颗陨石正好落在了清泉镇旁边…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230310
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411230310,
					"content": "清泉镇里虽然有不少猎人，我们也派了骑士过去协助，但那里的地形实在难以做到完全防守好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230311
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411230311,
					"content": "假如漏了魔物进镇子，那就糟糕了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230312
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411230312,
					"content": "能请你去清泉镇周围调查一下魔物的情况吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230313,
						411230315
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411230313,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230314
					]
				},
				{
					"id": 411230314,
					"content": "那就拜托你了，我也会尽量快点再安排些骑士过去支援。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411230315,
					"content": "清泉镇的情况怎么样？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230316
					]
				},
				{
					"id": 411230316,
					"content": "老实说…不太乐观，除了要处理陨石相关的诸多事宜外，还要提防魔物和盗宝团…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230317
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411230317,
					"content": "同时要应付这么多东西，实在是太吃力了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230318
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411230318,
					"content": "那这件事就拜托你了，我也会尽量快点再安排些骑士过去支援。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "霍夫曼"
				}
			]
		},
