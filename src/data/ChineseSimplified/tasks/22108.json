					"岚姐"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221080101,
					"content": "这一次也没找到，线索已经快没了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080102
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 221080102,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221080103
					]
				},
				{
					"id": 221080103,
					"content": "你是谁？如果要了解协会的事，你去找旁边的凯瑟琳吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080104
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 221080104,
					"content": "你已经是冒险家了吗，抱歉，虽然是分会长，但我不太关心协会的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080105
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 221080105,
					"content": "所以，新人我也不太认识…不过看你这副样子，是对冒险已经有点心得了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080106
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 221080106,
					"content": "那么就帮我个忙吧，怎么样？但是先说好，这并不是协会的任务，而是我个人的委托。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080107,
						221080108
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 221080107,
					"content": "好的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221080109
					]
				},
				{
					"id": 221080109,
					"content": "真爽快，不过连情况都不问就接下委托，可不太明智。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080111
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 221080111,
					"content": "关于委托，我想请你去消灭两只举着巨盾的强壮丘丘人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080112
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 221080112,
					"content": "它们的盾牌上，有着「岩」属性的力量，虽然不算太危险，但也要小心应付。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080113
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 221080113,
					"content": "你要做的就是消灭它们。消灭了之后，再回来找我，我会付你合适的报酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080114
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 221080114,
					"content": "对了，如果发现了有什么和「剑」有关的东西，就带回来给我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080115
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 221080115,
					"content": "如果没发现也没关系，只要消灭了丘丘人，我就会付给你正常的报酬，你就放心准备去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "岚姐"
				},
				{
					"id": 221080108,
					"content": "是什么委托？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221080110
					]
				},
				{
					"id": 221080110,
					"content": "你还真谨慎，是之前踩过什么坑吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080111
					],
					"speakerTitle": "岚姐"
				}
			]
		},
