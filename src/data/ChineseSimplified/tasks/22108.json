				{
					"id": 221080301,
					"content": "你消灭它们了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080302
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 221080302,
					"content": "已经全部消灭了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221080303
					]
				},
				{
					"id": 221080303,
					"content": "不错，你做事还挺利索的，也算是有个冒险家的样子了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080304
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 221080304,
					"content": "这是你的报酬，辛苦你了，消灭了它们，周围也会安宁许多吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080305
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 221080305,
					"content": "没有找到任何与「剑」有关的东西？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080306
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 221080306,
					"content": "…是这样吗，没关系，这也在我预料之中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080307
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 221080307,
					"content": "辛苦了，这是给你的报酬，拿好了，去忙你自己的事吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "岚姐"
				}
			]
		}
