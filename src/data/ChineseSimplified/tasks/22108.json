			"dialogs": [
				{
					"id": 221080201,
					"content": "你消灭它们了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080202
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 221080202,
					"content": "还没有。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221080203
					]
				},
				{
					"id": 221080203,
					"content": "不用心急，心急的冒险家，只会将自己陷入困境。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080204
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 221080204,
					"content": "但也别太慢慢吞吞了，因为你的报酬也和时间挂钩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "岚姐"
				}
			]
		},
