				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"马索",
					"欧洛伦",
					"伊安珊"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 50270201,
					"content": "你说，我会变成什么蔬菜呢？红色的，还是绿色的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270202
					],
					"speakerTitle": "马索"
				},
				{
					"id": 50270202,
					"content": "你的话，可能会变成洋葱吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270203
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 50270203,
					"content": "洋葱？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270204
					],
					"speakerTitle": "马索"
				},
				{
					"id": 50270204,
					"content": "其貌不扬，却能让试图对你动手的人痛哭流涕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270205
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 50270205,
					"content": "真的？听起来好强大…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270206
					],
					"speakerTitle": "马索"
				},
				{
					"id": 50270206,
					"content": "这两个人在说什么啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270207
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 50270207,
					"content": "洋葱很厉害。上次去朋友家碰巧他在削洋葱，削得不停流眼泪，他也流，龙也流，最后屋里的生物几乎都哭了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270208
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 50270208,
					"content": "你呢？你在哪？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270209
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 50270209,
					"content": "我也在屋子里，不过及时用披风遮住了眼睛。咔库库和伊法他们看不见我，就以为我也哭了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270210
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 50270210,
					"content": "我想成为洋葱一样让人哭泣的男人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270211
					],
					"speakerTitle": "马索"
				},
				{
					"id": 50270211,
					"content": "嗯，没问题的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270212
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 50270212,
					"content": "好想打断你们，又不知道说什么才能阻止这种对话发展下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270213
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 50270213,
					"content": "伊安珊是，小小的…蘑菇。嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270214
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 50270214,
					"content": "没人问啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270215
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 50270215,
					"content": "不过蘑菇吗？还不错呢，很有生命力，我喜欢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270216
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 50270216,
					"content": "那伊安珊姐姐是很有生命力的女人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270217
					],
					"speakerTitle": "马索"
				},
				{
					"id": 50270217,
					"content": "嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270218
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 50270218,
					"content": "嗯嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊安珊"
				}
			]
		}
	]
