				"points": []
			},
			"dialogs": [
				{
					"id": 50270101,
					"content": "火神大人真厉害！而且很有勇气，敢和希巴拉克大人过招。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270102
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 50270102,
					"content": "别谦虚了，换做是你你也敢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270103
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 50270103,
					"content": "哈，谁不敢？我敢！你呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270104
					],
					"speakerTitle": "阿乔"
				},
				{
					"id": 50270104,
					"content": "我…我不敢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270105
					],
					"speakerTitle": "卡齐娜"
				},
				{
					"id": 50270105,
					"content": "战斗是战士的天性，有什么敢不敢的。真到了那个时刻，自然会想要一决高下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270106
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 50270106,
					"content": "唉，真有精力呀你们…那可是希巴拉克大人哦？超级祖先哦？这么喜欢跟老一辈过招吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270107
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 50270107,
					"content": "茜特菈莉奶奶！有机会我们也再比试比试吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270108
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 50270108,
					"content": "不要不要，绝对不要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "茜特菈莉"
				}
			]
		},
		{
			"id": 502702,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"502701",
