			"dialogs": [
				{
					"id": 761290101,
					"content": "再次感谢您对协会的帮助，奈芙尔老板，雅珂达小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290102
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 761290102,
					"content": "合作而已，无需这么客气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290103
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 761290103,
					"content": "话是这么说，但我还是要感谢奈芙尔老板，愿意帮助协会进行一些…复杂的调查工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290104
					],
					"speakerTitle": "萨林"
				},
				{
					"id": 761290104,
					"content": "冒险家协会也分出了不少人手来协助我们的工作，算是合作共赢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290105
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 761290105,
					"content": "希望我们之后，也能合作得这么愉快，萨林先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290106
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 761290106,
					"content": "请奈芙尔老板放心，我们冒险家协会…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290107
					],
					"speakerTitle": "萨林"
				},
				{
					"id": 761290107,
					"content": "噢，我得严谨点。我们挪德卡莱冒险家协会分部，绝对是一个值得信赖的合作对象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290108
					],
					"speakerTitle": "萨林"
				},
				{
					"id": 761290108,
					"content": "呵呵，看得出来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290109
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 761290109,
					"content": "（好好好，就这么聊，奈姐奈姐，亲爱的奈姐，别看我别看我别看我…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290110
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761290110,
					"content": "雅珂达，你怎么不说话？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290111
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 761290111,
					"content": "（还是看我了啊！那别看委托板别看委托板别看委托板——）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290112
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761290112,
					"content": "啊？我、我没什么要说的呀？谢谢…给我委托…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290113
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761290113,
					"content": "噗，也要感谢雅珂达小姐的协助，要是没了您，协会的事务怕是要堆成山了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290114
					],
					"speakerTitle": "萨林"
				},
				{
					"id": 761290114,
					"content": "不客气不客气…我都拿钱了，肯定要好好做呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290115
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761290115,
					"content": "（唉，之前教她的话术，只怕又忘光了…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290116
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 761290116,
					"content": "对了，既然来都来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290117
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 761290117,
					"content": "（不要啊！气氛这么好，老板你就放过我吧！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290118
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761290118,
					"content": "麻烦萨林先生，把最新的一批委托拿过来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290119
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 761290119,
					"content": "雅珂达，你来选一个，你觉得最应该做的委托。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290120
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 761290120,
					"content": "好好想，慢慢选，好吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290121
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 761290121,
					"content": "是…是，老板…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290122
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761290122,
					"content": "（呜哇——完！蛋！啦——）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雅珂达"
				}
			]
		}
	]
}