			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"伊尔玛里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760210401,
					"content": "今天也是空手而归啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210402,
						760210405,
						760210412,
						760210417,
						760210421
					],
					"speakerTitle": "伊尔玛里"
				},
				{
					"id": 760210402,
					"content": "你在这里干什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760210403
					]
				},
				{
					"id": 760210403,
					"content": "钓鱼。不过到目前为止只钓到些不是鱼的玩意儿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210404
					],
					"speakerTitle": "伊尔玛里"
				},
				{
					"id": 760210404,
					"content": "要是沉船里的小物件之类的倒好，游商会收。之前钓起过靴子上还连着半截…唉，不说了，说多了鱼都给吓跑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊尔玛里"
				},
				{
					"id": 760210405,
					"content": "附近有什么值得注意的吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760210406
					]
				},
				{
					"id": 760210406,
					"content": "你又来寻宝了？什么只有在月之东，日之西才能找到的「伟大财宝」之类的…听也知道不会是这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210407
					],
					"speakerTitle": "伊尔玛里"
				},
				{
					"id": 760210407,
					"content": "过去这里的确发生过不少船难，沉船里或许的确有值钱的东西，不过那可不容易找啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210408
					],
					"speakerTitle": "伊尔玛里"
				},
				{
					"id": 760210408,
					"content": "在酒馆也听幸存的水手说起过，那天晚上没有月亮，在滔天的巨浪中却能看到发光的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210409
					],
					"speakerTitle": "伊尔玛里"
				},
				{
					"id": 760210409,
					"content": "他们说那一定就是独眼的刻拉蒂了，是连月亮都能吞食的怪兽在同海中的巨蛇争夺地盘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210410
					],
					"speakerTitle": "伊尔玛里"
				},
				{
					"id": 760210410,
					"content": "那之后很长一段时间，这块儿都像账房的墨水瓶似的黑黢黢一片，没有船敢冒险从这里经过，都怕被水下的亡魂缠上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210411
					],
					"speakerTitle": "伊尔玛里"
				},
				{
					"id": 760210411,
					"content": "不管那些亡魂现在是不是还在附近徘徊，反正我看不见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊尔玛里"
				},
				{
					"id": 760210412,
					"content": "关于那棵树…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760210413
					]
				},
				{
					"id": 760210413,
					"content": "那玩意儿是真的有点邪乎。这儿原本有个漩涡，水手们管它叫刻拉蒂之眼，但突然有那么一天这树就这么长出来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210414
					],
					"speakerTitle": "伊尔玛里"
				},
				{
					"id": 760210414,
					"content": "不过那阵子发生的怪事也不止这么一件，想想看，都是在那些石头从天上掉下来之后…搞不好这树也跟石头一样来自天外。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210415
					],
					"speakerTitle": "伊尔玛里"
				},
				{
					"id": 760210415,
					"content": "还有那些偶尔能见到的亮晶晶的小东西，稀罕得很。想着说不定也会有新品种的鱼吧，我就是为了这个才来碰碰运气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210416
					],
					"speakerTitle": "伊尔玛里"
				},
				{
					"id": 760210416,
					"content": "原本有个钓友和我一起，但他老说听到奇怪的歌声，吓得不敢再来了。哼，虽然他只算半个霜月之子，但臭毛病是一点不少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊尔玛里"
				},
				{
					"id": 760210417,
					"content": "关于「识者之证」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760210418
					]
				},
				{
					"id": 760210418,
					"content": "什么「识者之证」，什么只有在月之东，日之西才能找到的「伟大财宝」，要我说啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210419
					],
					"speakerTitle": "伊尔玛里"
				},
				{
					"id": 760210419,
					"content": "被贪欲驱使，追逐本不属于自己的东西，肯定不会有好下场。就像阿特拉号，听说船长格瑞蒂尔就是为这些东西着了魔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210420
					],
					"speakerTitle": "伊尔玛里"
				},
				{
					"id": 760210420,
					"content": "最后落得个葬身海底的下场，宝藏却不会永远与他同眠，真是白忙活。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊尔玛里"
				},
				{
					"id": 760210421,
					"content": "打扰了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760210422
					]
				},
				{
					"id": 760210422,
					"content": "不打紧。现在是一点鱼的影子都看不到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊尔玛里"
				}
			]
		}
	]
}