			"dialogs": [
				{
					"id": 790490101,
					"content": "这么隐蔽的角落里，居然藏着日记？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790490102
					],
					"speakerTitle": "阅读"
				},
				{
					"id": 790490102,
					"content": "原来外边那块超大的石板，是伊迪娅给这个画家的画板！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790490103
					],
					"speakerTitle": "阅读"
				},
				{
					"id": 790490103,
					"content": "嗯，看样子，他在「琉形蜃境」里找到了喜欢的美景，还和「小水珠」们成为了好朋友，有了新的创作灵感！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790490104,
						790490105
					],
					"speakerTitle": "阅读"
				},
				{
					"id": 790490104,
					"content": "这样的遭遇非常幸运。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790490106
					]
				},
				{
					"id": 790490106,
					"content": "噫！你不说我还没想到，好像确实有些一根筋的人，受到打击后就发了疯一样逼自己，最后整个人都变得不正常呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790490107
					],
					"speakerTitle": "阅读"
				},
				{
					"id": 790490107,
					"content": "还好还好…多亏伊迪娅提供了工具，还有「小水珠」们陪着这个画家，他才没有走错路！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阅读"
				},
				{
					"id": 790490105,
					"content": "比苦练到走火入魔要好…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790490106
					]
				}
			]
		},
