			"dialogs": [
				{
					"id": 200650101,
					"content": "伤脑筋…这里要怎么解决啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200650102
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200650102,
					"content": "你在做什么呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200650103
					]
				},
				{
					"id": 200650103,
					"content": "为了下一次的骑士选拔，我正在训练呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200650104
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200650104,
					"content": "唔…不过，我可没有琴大人那样的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200650105
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200650105,
					"content": "比起锻炼「力量」，我觉得学习「技巧」更适合我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200650106
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200650106,
					"content": "比如，一口气把这些木桩全部破坏掉的方法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200650107
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200650107,
					"content": "这些木桩可是很结实的，可不能掉以轻心…真是辛苦老爸了，也不知道他是从哪找到的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾琳"
				}
			]
		},
