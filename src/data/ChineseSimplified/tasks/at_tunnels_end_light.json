				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"夜兰"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10310101,
					"content": "原来如此…没想到是这么一回事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310102
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10310102,
					"content": "哦哦，看起来有新发现。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10310103,
					"content": "里面的信息，是一个名叫伯阳的术士所留。他…就是我想调查的那个失踪的祖先。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310104
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10310104,
					"content": "这么多…全是你的祖先留下的信息吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10310105,
					"content": "数百年前，高人将太威仪盘交给我的祖先。他们兄弟二人带着这件法宝来到层岩巨渊，参与击退坎瑞亚魔兽的战斗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310106
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10310106,
					"content": "出发时是两人，回来的仅剩一人，而且已变得疯疯癫癫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310107
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10310107,
					"content": "…业障。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310108
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310108,
					"content": "嗯。有一种可能，他们是与夜叉浮舍并肩作战时沾染了业障之力。他们都没有神之眼，无法抵御太久。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310109
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10310109,
					"content": "看记录，记下这一切的人…也永远留在这里了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310110
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10310110,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310111
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10310111,
					"content": "可恶！真没办法了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310112
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10310112,
					"content": "怎么办，我们要死在这里了吗？我不要啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10310113,
					"content": "我想起一件事，请稍等，马上确认。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310114
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10310114,
					"content": "唔…嗯。嗯嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310115
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10310115,
					"content": "#{NICKNAME}，我有新发现哦。是这样的，来的路上我一直在研究那封遗嘱，却没细想过遗嘱是夹在怎样的书里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310116
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10310116,
					"content": "虽然不是逐字牢记，但我也读过那本书，其中记载了这样一个故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310117
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10310117,
					"content": "千年前，仙家制作法宝以封印恶兽，后结交凡人知己，便将法宝交由知己，作法器用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310118
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10310118,
					"content": "数年过去，山中有大魔作祟，凡人与仙家便联手以此器斩妖除魔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310119
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10310119,
					"content": "不止如此，书中还提到：「仙力与人力合一，可转斗移星，举天地之威。器为证，人仙共存，天人合一。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310120
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10310120,
					"content": "我是仙人与人的混血，假如我的力量能起作用…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310121
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10310121,
					"content": "生效了！虽然我的力量还不够强，效果转瞬即逝…但思路是正确的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310122
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10310122,
					"content": "太威仪盘里似乎有什么东西被启动了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310123
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10310123,
					"content": "黄天之威，五方之神。夜叉种民，共执玑衡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310124
					],
					"speakerTitle": "浮舍"
				},
				{
					"id": 10310124,
					"content": "黄天之威，五方之神。夜叉种民，共执玑衡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310125
					],
					"speakerTitle": "夜兰的太爷"
				},
				{
					"id": 10310125,
					"content": "是封印时的声音。浮舍和祖太爷…一同完成了这个空间最上层的封印。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310126
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10310126,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310127
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310127,
					"content": "…原来是这样，我明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310128
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10310128,
					"content": "（等等，这么说来，之前在层岩巨渊底部见到的那块巨大晶石…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10310129
					]
				},
				{
					"id": 10310129,
					"content": "（…当时，那块晶石砸中了遗迹巨蛇…似乎有什么力量对冲了。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10310130
					]
				},
				{
					"id": 10310130,
					"content": "（难道就是那种力量的对冲导致了这片空间延迟苏醒并吞没我们？或者是，那次撞击导致了地面上的入口松动？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10310131
					]
				},
				{
					"id": 10310131,
					"content": "（…另外，我们似乎没有在这个空间里见到过来自深渊的怪物…这之间，会有什么关系吗？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10310132
					]
				},
				{
					"id": 10310132,
					"content": "各位！我们先回去找一斗和阿忍，然后我有个建议。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310133
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10310133,
					"content": "#走不动了…我不想留在这里，呜呜，我也不想死，{NICKNAME}，我舍不得你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10310134,
					"content": "派蒙，再坚持一下好吗？相信我，我们还有机会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310135
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10310135,
					"content": "走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "魈"
				}
			]
		},
		{
			"id": 103102,
			"completionStepIds": [
				103102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"103102",
							"2"
						],
						"stepId": 103102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"久岐忍"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10310201,
					"content": "阿忍，一斗，我们回来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310202
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10310202,
					"content": "一斗怎么样了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10310203
					]
				},
				{
					"id": 10310203,
					"content": "消耗太大，还没醒来。不过没有性命之忧，请放心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310204
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10310204,
					"content": "倒是你们，看你们的表情，恐怕有发现…而且是让人不怎么高兴的发现，对吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310205
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10310205,
					"content": "呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10310206,
					"content": "我们找到太威仪盘了，其中有前人留下的信息。看起来…这片空间无法被突破。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310207
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10310207,
					"content": "上一个持有这件法器的人，似乎也永远留在了这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310208
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10310208,
					"content": "…这样啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310209
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10310209,
					"content": "还没完呢，听我说，刚才我试过了，向太威仪盘注入力量，它就有反应。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310210
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10310210,
					"content": "但也只是触发了封印时的记录而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310211
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10310211,
					"content": "不不，问题不在内容，而是方式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310212
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10310212,
					"content": "还记得书里说的吗？「仙力与人力合一，可转斗移星，举天地之威。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310213
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10310213,
					"content": "只有仙人与人的力量汇聚起来，才能最大程度启动太威仪盘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310214
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10310214,
					"content": "我是混血，太威仪盘对我有反应，证明这个系统还在作用。而我们的队伍里恰好有完全的仙人和继承了术法的凡人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310215
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10310215,
					"content": "…有意思，原来你是这么想的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310216
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10310216,
					"content": "需要魈和夜兰合作？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10310217
					]
				},
				{
					"id": 10310217,
					"content": "仙人和人类同时提供力量吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310218
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10310218,
					"content": "对。假如我猜得没错，你们对太威仪盘最大程度注入力量，能再次完全激活它，甚至逆转它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310219
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10310219,
					"content": "它上一次被用来封印这处空间与层岩巨渊的接口，如果我们能逆转它…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310220
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10310220,
					"content": "就能出去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310221
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10310221,
					"content": "太好了！我们还有救是吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10310222,
					"content": "没错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310223
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10310223,
					"content": "…这个想法，不无道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310224
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310224,
					"content": "好，大家稍事休息，等准备完毕，就来尝试这个方法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310225
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10310225,
					"content": "众人休息过后…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						10310226
					]
				},
				{
					"id": 10310226,
					"content": "#喂{NICKNAME}，我好紧张啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310227
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10310227,
					"content": "别怕，一定能行。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10310228
					]
				},
				{
					"id": 10310228,
					"content": "夜兰，魈，可以了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310229
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10310229,
					"content": "万事妥当。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310230
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10310230,
					"content": "定当全力以赴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310231
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310231,
					"content": "不过烟绯，有件事你得做好心理准备。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310232
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10310232,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310233
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10310233,
					"content": "法宝太威仪盘，你怕是带不出去了。根据我的判断，这片秘境里的一切都是时空与回忆错乱的结果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310234
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10310234,
					"content": "我们每个人都带着不同目的，而这片空间里出现的一切，都像在回应我们的想象和猜测。恐怖，但也奇妙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310235
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10310235,
					"content": "这个空间，已经不单单是空间了。不知是受何种高等力量影响…它一直在读取我们，再用幻象回应我们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310236
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10310236,
					"content": "此外，根据层岩历史，这个空间恐怕已经存在很久。…它究竟是如何诞生的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310237
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10310237,
					"content": "我记得，空间外侧有一条巨蛇…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10310238
					]
				},
				{
					"id": 10310238,
					"content": "噢，你说那个啊。当时我也在场。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310239
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10310239,
					"content": "欸？等等…难道那一箭是你干的？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310240
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10310240,
					"content": "除了我还能是谁？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310241,
						10310242
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10310241,
					"content": "晶石攻击巨蛇…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10310243
					]
				},
				{
					"id": 10310243,
					"content": "那条巨蛇应该是坎瑞亚文明的遗留物…晶石对它格外有效…难道是这两者的力量之间存在冲突关系？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310244
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10310244,
					"content": "如果是这样的话…很抱歉，或许我该为大家的遭遇负责。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310245
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10310245,
					"content": "不不，你不是为了救我们和处理问题嘛！不能怪你呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310246
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10310246,
					"content": "…或许吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310247
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10310247,
					"content": "这片奇异空间堪比活物，利用各种幻觉蒙蔽我们。实际上，我们所见的人，所走的路…早在五百年前就该不存在了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310248
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10310248,
					"content": "另外，这里大部分事物都静止着。既然如此，若真能逃出去，等时间真正流动起来……太威仪盘应该就会消失吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310249
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10310249,
					"content": "其实，我也这么想。可正因为是这样，我们能找到太威仪盘就是一种奇迹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310250
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10310250,
					"content": "整件事，像是用一柄本不该存在的枪来击破桎梏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310251
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310251,
					"content": "听起来不切实际，但也是最后的可能性。…是谁的愿望唤来了这件法宝呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310252
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10310252,
					"content": "或许，是我们所有人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10310253
					]
				},
				{
					"id": 10310253,
					"content": "是啊。不过，也许还有一个原因，是你对「追寻」的执着特别强烈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310254
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10310254,
					"content": "很可惜，找到的不是你的家人…但如果那个人在这里，一定也非常希望你能得救。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310255
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10310255,
					"content": "…嗯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10310256
					]
				},
				{
					"id": 10310256,
					"content": "我们这些人能像这样巧聚在此，不可不说是一件趣事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310257
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10310257,
					"content": "如果这也是命运，就让命运在我们手中扭转吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310258
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10310258,
					"content": "老大交给我和阿丑，我们准备好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310259
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10310259,
					"content": "旅行者，照看好派蒙。烟绯，必要时靠近我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310260
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10310260,
					"content": "没问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310261
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10310261,
					"content": "好的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10310262
					]
				},
				{
					"id": 10310262,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310263
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310263,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10310242,
					"content": "与地面开裂有关吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10310243
					]
				}
			]
		},
		{
			"id": 103104,
			"completionStepIds": [
				103104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"103104",
							"2"
						],
						"stepId": 103104,
						"stateName": "QUEST_STATE_UNFINISHED"
