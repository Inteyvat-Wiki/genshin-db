				"points": []
			},
			"dialogs": [
				{
					"id": 10310601,
					"content": "再往前，就是人们为铜雀修建的庙宇了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310602
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310602,
					"content": "…来这里，或许也是有所感悟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310603
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310603,
					"content": "是指在那个地下空间里有所感悟吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10310604,
					"content": "你思考了什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10310605
					]
				},
				{
					"id": 10310605,
					"content": "很难说清。见到浮舍，令我有重回过去的错觉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310606
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310606,
					"content": "…夜叉一辈子，说得好听是骁勇善战，说得直白些，只会做这般杀戮之事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310607
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310607,
					"content": "能在极致的战斗中死去，对浮舍而言，未尝不是一件好事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310608
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310608,
					"content": "我也是如此。我已活了许久…若是能为救人而死，称不上太坏的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310609
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310609,
					"content": "你应该已经知道事实并非如此了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10310610
					]
				},
				{
					"id": 10310610,
					"content": "嗯。又或许…我这般想法，亦是一种疯狂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310611
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310611,
					"content": "喂，别这么说呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310612
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10310612,
					"content": "魈，我们有话要告诉你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10310613
					]
				},
				{
					"id": 10310613,
					"content": "啊对！是阿丑要我们告诉你的哦，非常重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310614
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10310614,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310615
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310615,
					"content": "阿丑说，他有驱鬼之能，被人拿来防鬼，可遇见一斗之后，就一直跟一斗在一块儿了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310616
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10310616,
					"content": "阿丑说他不懂得那么多大道理，只是觉得大家跟谁生活在一起更快乐，就选择与谁同行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310617
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10310617,
					"content": "活在世上，或许没有那么多规矩。所以…他希望你也能明白，即使夜叉之力对人有害，也不代表你不能跟大家一起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310618
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10310618,
					"content": "总有人能与你并肩。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10310619
					]
				},
				{
					"id": 10310619,
					"content": "是啊，比如有神之眼的人，多少能抵挡住你的力量，对吧？还有还有…哎呀，反正关心你的人绝对不少！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310620
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10310620,
					"content": "…哈，这些话，倒像是浮舍他们爱说的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310621
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310621,
					"content": "那几个家伙从前常说，等到天下太平，他们也要去过人间的生活。似乎…只有我不这么想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310622
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310622,
					"content": "太威仪盘中提到浮舍神貌癫狂，常以「金鹏」、「弥怒」等名号称呼身边人，这些都是五夜叉的名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310623
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310623,
					"content": "金鹏是我，弥怒是心猿大将。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310624
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310624,
					"content": "此外，还有螺卷大将·伐难，火鼠大将·应达。听说，人们称我们五人为「仙众夜叉」…哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310625
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310625,
					"content": "浮舍与夜兰的祖先都留在了地下，换言之，他二人临终前所想，也应被那片空间读取了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310626
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310626,
					"content": "夜兰的话，句句属实。我与她的提案都有弊端，也都没错。但这片空间的强大，远在我们之上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310627
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310627,
					"content": "没有你们鼎力相助，我做不到这么多事。最后关头也是拼尽全力，才勉强能突破一瞬间…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310628
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310628,
					"content": "那也很厉害了啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310629
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10310629,
					"content": "…烟绯和夜兰说得不错，我确实一直都做着最坏的打算。这种想法根深蒂固…却已是我能想到最好的办法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310630
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310630,
					"content": "那个瞬间，如非帝君出手相助，我恐怕无法逃生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310631
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310631,
					"content": "那股力量，果然是钟离吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10310632
					]
				},
				{
					"id": 10310632,
					"content": "终究还是劳烦他人了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310633
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310633,
					"content": "但很正常吧？你跟钟离…不是，你跟岩王帝君认识这么久，你帮过他的忙，他帮帮你也没什么，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310634,
						10310635
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10310634,
					"content": "是啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10310636
					]
				},
				{
					"id": 10310636,
					"content": "…嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310637
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310637,
					"content": "逃离空间的瞬间，我隐约感受到浮舍残留的记忆。若说此行有什么收获，便是这个了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310638
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310638,
					"content": "我好像也隐约感觉到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10310639
					]
				},
				{
					"id": 10310639,
					"content": "…多一个人记住他，也不错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310640
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310640,
					"content": "今天，我说了太多话。但与你交谈，不需保留太多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310641
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310641,
					"content": "你可曾有一刻感知到天命？生的可能，死的来临…无论何种。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310642
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310642,
					"content": "时至今日我已明白，天命是夜叉最能感知到的劫难。注定悲戚…但我们无惧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310643
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310643,
					"content": "…魈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310644
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10310644,
					"content": "告诉我这些，没关系吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10310645
					]
				},
				{
					"id": 10310645,
					"content": "无妨。帝君也说过你是见证者。人间的故事，理应道与你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310646
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310646,
					"content": "伐难、弥怒与应达均已殒命，唯有浮舍下落不明。此事如木刺在心，所以明知艰险，我亦去了层岩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310647
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310647,
					"content": "…如今总算知道了当年在层岩巨渊发生过什么，也算了结一段往事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310648
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310648,
					"content": "离开空间前，我取了一块石头。若能成功带出来，便要以此石代浮舍，放入纪念铜雀的庙宇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310649
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310649,
					"content": "可惜，还是留不住。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310650
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310650,
					"content": "铜雀死于千年前的魔神战争，他比我们都年轻，他战死时，浮舍很难过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310651
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310651,
					"content": "夜叉死伤太多，犹如满天飞鸟散于各地。如伐难所说…夜叉难寻魂归之处。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310652
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310652,
					"content": "浮舍，伯阳，还有那些将士…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310653
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310653,
					"content": "别这么说，大家都是英雄。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10310654
					]
				},
				{
					"id": 10310654,
					"content": "英雄…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310655
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310655,
					"content": "…是个好词。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310656
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310656,
					"content": "灾厄或无尽头，可凡尘有情，纵是修罗亦有牵挂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310657
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310657,
					"content": "就应你说的吧。从今往后，天下英雄永不陌路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "魈"
				},
				{
					"id": 10310635,
					"content": "互相扶持才能生存下去。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10310636
					]
				}
			]
		}
	]
}