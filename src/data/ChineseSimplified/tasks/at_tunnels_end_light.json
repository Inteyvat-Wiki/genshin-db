			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"魈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10310401,
					"content": "总算逃离危险之地，众人纷纷休息闲聊起来…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						10310402
					]
				},
				{
					"id": 10310402,
					"content": "刚才真是千钧一发呀！差点以为魈要留在里面了…幸好你没事，吓死我了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310403
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10310403,
					"content": "…嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310404
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310404,
					"content": "我知道你怎么想，但…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310405
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10310405,
					"content": "罢了。你有些想法非一日所成，不是我们三言两语可以说动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310406
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10310406,
					"content": "到最后，我们的战略方针都无法达成统一。但能从那种地方逃出来，确实多亏你。谢谢你救下所有人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310407
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10310407,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310408
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310408,
					"content": "不。那不是我一个人的功劳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310409
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310409,
					"content": "也谢谢夜兰了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10310410
					]
				},
				{
					"id": 10310410,
					"content": "不用客气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310411
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10310411,
					"content": "几位看起来都没有外伤，只是消耗过度。多休息吧，不用急着离开这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310412
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10310412,
					"content": "那我先去检查一下附近有没有其他异状。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310413
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10310413,
					"content": "走开了呢…明明还想跟她说几句谢谢的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10310414,
					"content": "夜兰可能是真不觉得自己做了什么吧。她也是真心认为魈帮助了大家…受人恩惠，反而不好说什么了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310415
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10310415,
					"content": "不过魈确实也不容易被说动，我想，夜兰可能放弃说服他了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310416
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10310416,
					"content": "魈，她在批评你欸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310417
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10310417,
					"content": "不是啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310418
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10310418,
					"content": "你们所言非虚，没有问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310419
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310419,
					"content": "你们的意见，我会考虑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310420
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310420,
					"content": "也算是想开了一点吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10310421
					]
				},
				{
					"id": 10310421,
					"content": "真的？那太好了，感觉自己做了一件大事呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310422
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10310422,
					"content": "这次情况凶险，缺少任何一个人我们都没法从地下离开。我很庆幸，没在过程中失去任何人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310423
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10310423,
					"content": "对了，放牛的还没醒，不会就这样一直睡下去吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310424
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10310424,
					"content": "不会吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10310425
					]
				},
				{
					"id": 10310425,
					"content": "快去看看他！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310426
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10310426,
					"content": "呼啊——！睡得好爽，唔…嗯？你们干嘛，怎么这样看着我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310427
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10310427,
					"content": "你身上有哪里不舒服吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310428
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10310428,
					"content": "哞，哞！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310429
					],
					"speakerTitle": "阿丑"
				},
				{
					"id": 10310429,
					"content": "脑子？脑子怎么样了，有没有撞坏？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310430
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10310430,
					"content": "不舒服的话要说出来哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310431
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10310431,
					"content": "本来就不聪明，要是再把脑袋弄坏…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310432
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10310432,
					"content": "什么跟什么啊，本大爷好得很！狠狠睡了一觉，现在浑身是劲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310433
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10310433,
					"content": "总觉得忘了什么事…哦对！哎？我们不是在地下吗？怎么上来的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310434
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10310434,
					"content": "说来话长，就先不说了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310435
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10310435,
					"content": "一斗，这次我们能脱险，实在是多亏了你和阿忍还有阿丑全力相助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310436
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10310436,
					"content": "你们是因为我才被卷入此事，可以的话，请让我赔礼道歉吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310437
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10310437,
					"content": "别这么说。你帮了我们，我们为你做些事也是应该的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310438
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10310438,
					"content": "要不是你，我们这会儿可能是在璃月的牢房里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310439
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10310439,
					"content": "这话不够全面。应该是你在牢里，我在牢外。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310440
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10310440,
					"content": "哞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310441
					],
					"speakerTitle": "阿丑"
				},
				{
					"id": 10310441,
					"content": "哈哈哈，也是呢。那就当是认识新朋友好了，作为庆祝，我带你们到璃月港观光吃饭，怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310442
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10310442,
					"content": "这个好这个好！被你一说，呃…肚子好饿…走都走不动了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310443
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10310443,
					"content": "我也饿了，师姐，不如我们现在就出发吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310444
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10310444,
					"content": "我也要去！我也要去！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310445
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10310445,
					"content": "派蒙，我们还有事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10310446
					]
				},
				{
					"id": 10310446,
					"content": "欸？好吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310447
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10310447,
					"content": "#那么{NICKNAME}，这两位稻妻朋友就交给我啦。你也早点回去休息吧，这次真是辛苦了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310448,
						10310449
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10310448,
					"content": "嗯。大家都很不容易。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10310450
					]
				},
				{
					"id": 10310450,
					"content": "啊对，夜兰现在不在…那我欠她的一顿茶就先当不存在好了，嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310451
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10310451,
					"content": "哞！哞哞，哞！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310452
					],
					"speakerTitle": "阿丑"
				},
				{
					"id": 10310452,
					"content": "嗯？啊？这样啊，唔唔…好，我帮你转达。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310453
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10310453,
					"content": "#{NICKNAME}，飞行堇瓜，阿丑有两句话想托你们转达。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310454
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10310454,
					"content": "？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10310455
					]
				},
				{
					"id": 10310455,
					"content": "什么什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310456
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10310456,
					"content": "我也要听。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310457
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10310457,
					"content": "那我也要听，带我一个！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310458
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10310458,
					"content": "一斗将阿丑刚才说的话翻译给大家听…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						10310459
					]
				},
				{
					"id": 10310459,
					"content": "有道理，就这么办！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310460
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10310460,
					"content": "好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10310461
					]
				},
				{
					"id": 10310461,
					"content": "阿丑这家伙，外表明明是这样，居然也非常细心温柔，真是没想到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310462
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10310462,
					"content": "哞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310463
					],
					"speakerTitle": "阿丑"
				},
				{
					"id": 10310463,
					"content": "深刻的道理往往都很简单，所以，我认为阿丑的话或许会有用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310464
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10310464,
					"content": "没错，这件事就交给我们吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310465
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10310465,
					"content": "那一斗，阿忍，阿丑，我们出发吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310466
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10310466,
					"content": "噢！吃饭吃饭！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310467
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10310467,
					"content": "哞！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310468
					],
					"speakerTitle": "阿丑"
				},
				{
					"id": 10310468,
					"content": "下次见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310469
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10310469,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310470
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310470,
					"content": "魈。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10310471
					]
				},
				{
					"id": 10310471,
					"content": "忙完了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310472
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310472,
					"content": "我们倒也没在忙啦…送送朋友而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310473
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10310473,
					"content": "还在啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310474
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10310474,
					"content": "刚才看到那两位稻妻人跟着烟绯离开，是往璃月港去了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310475
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10310475,
					"content": "你们不一起吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310476
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10310476,
					"content": "我们还有些话要跟魈说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310477
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10310477,
					"content": "嗯，我想也是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310478
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10310478,
					"content": "我检查过四周环境了。目前其他地方暂无异状，这件事算是告一段落。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310479
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10310479,
					"content": "接下来的，应该就是保密问题了吧。呵呵…希望那两位远方来客能对本次事件三缄其口。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310480
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10310480,
					"content": "啊啊知道了啦！我们也会帮着提醒他们闭嘴的，你可不要对他们出手啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310481
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10310481,
					"content": "哦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310482
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10310482,
					"content": "夜兰有时心眼真坏呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10310483
					]
				},
				{
					"id": 10310483,
					"content": "被你发现了？哈哈，那玩笑就到此为止。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310484
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10310484,
					"content": "这次多亏各位鼎力相助。我会将此事牢记在心中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310485
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10310485,
					"content": "地下那片诡异的空间何以诞生，又为何能悄然存在如此多年…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310486
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10310486,
					"content": "关于这些，我会继续调查。我总觉得，这些事背后有着更为深刻…不可告人的原因。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310487
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10310487,
					"content": "此外，似乎有人在最后关头出手相助…虽是好事，但我竟感觉不出对方的来历，看来也是位高人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310488
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10310488,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310489
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310489,
					"content": "放心，现在不是研究这些的时候。还有些后续工作需要汇报处理，我也回璃月港一趟，就此别过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310490
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10310490,
					"content": "夜兰再见！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310491
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10310491,
					"content": "…好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10310492
					]
				},
				{
					"id": 10310492,
					"content": "你知道我在等你？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310493
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310493,
					"content": "是啊，很明显哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10310494
					]
				},
				{
					"id": 10310494,
					"content": "……是吗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310495
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310495,
					"content": "我想去一个地方。你若有闲暇，也一起吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310496
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310496,
					"content": "要去哪里呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310497
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10310497,
					"content": "一个，与夜叉有关的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "魈"
				},
				{
					"id": 10310449,
					"content": "你们要玩得开心哦！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10310450
					]
				}
			]
		},
		{
			"id": 103106,
