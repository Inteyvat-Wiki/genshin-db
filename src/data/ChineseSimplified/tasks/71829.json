			},
			"dialogs": [
				{
					"id": 718291401,
					"content": "我尝尝…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291402
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718291402,
					"content": "咦，这味道…鲜美得很，但是吃着又像是豆花一样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291403
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718291403,
					"content": "看着卖相也不错，制作的手艺很考究，这「以荤托素」的名号也很是唬人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291404
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718291404,
					"content": "不错！不错！掌柜的肯定会喜欢这道菜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291405
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718291405,
					"content": "没想到啊，吃白食的，你还是有点本事的嘛，居然能把这菜谱记得这么牢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291406
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718291406,
					"content": "呵呵，说出来不怕你笑话。当时我本来是以为，这本菜谱里暗含着什么剑法，就去讨了这本菜谱来日夜钻研…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291407
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718291407,
					"content": "如今想来，当时我练剑实在是练得疯了，只是一本菜谱而已，哪里会有什么剑法呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291408
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718291408,
					"content": "你当时练剑到底是为了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718291409
					]
				},
				{
					"id": 718291409,
					"content": "去找一个人，讨一个公道而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291410
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718291410,
					"content": "明明是件大气魄的事，你这人怎么说得如此软绵绵的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291411
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718291411,
					"content": "呵呵，讨到公道之后，我就来了这里。所幸掌柜的收留了我，让我在这做个闲人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291412
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718291412,
					"content": "如今我已经别无他求，既不会再挥剑，也没有其他的长处…哈哈哈，就在这了却余生，倒也不错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291413
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718291413,
					"content": "喏，这份食谱我也抄给你一份，你有空的话，也可以自己做来吃一吃，虽然麻烦了些，但味道还是不错的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291414,
						718291415
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718291414,
					"content": "谢谢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718291417
					]
				},
				{
					"id": 718291417,
					"content": "唔…这道菜先放在旁边，等掌柜的来了我给他看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291418
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718291418,
					"content": "然后…来来来，吃白食的，你别走了，过来这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291419
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718291419,
					"content": "你要做什么？我可没其他的食谱告诉你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291420
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718291420,
					"content": "你不是说，你除了耍剑没什么长处吗？来，把剑拔出来，我教你剁肉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291421
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718291421,
					"content": "剁肉？这…我只怕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291422
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718291422,
					"content": "赶紧上手。先学剁肉再学做菜，学几道好菜，多少也是个手艺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291423
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718291423,
					"content": "你这是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291424
					],
