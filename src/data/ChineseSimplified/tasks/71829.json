			]
		},
		{
			"id": 7182903,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182902",
							"2"
						],
						"stepId": 7182902,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"江雪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718290301,
					"content": "咦？您可是位稀客。平日里只有我和那厨子相对无言，今天多了您，说不定也会热闹一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290302
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290302,
					"content": "但我今天看那厨子愁眉苦脸的，也不知道是不是遇见什么烦心事了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "江雪"
				}
			]
		},
		{
			"id": 7182904,
			"completionStepIds": [
				7182903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182903",
							"2"
						],
						"stepId": 7182903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"江雪",
					"言笑"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718290401,
					"content": "这狮子头的味道果然不错，这肉入口即化，汤汁也醇厚香浓…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290402
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290402,
					"content": "唔？竟在肉中加入了蟹膏，怪不得尝之鲜美异常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290403
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290403,
					"content": "来，旅行者，你也再尝一个。我教你，先用筷子拨开狮子头，再蘸以汤汁，随米饭同嚼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290404,
						718290405,
						718290407
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290404,
					"content": "客气客气…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290409
					]
				},
				{
					"id": 718290409,
					"content": "你们俩吃好喝好啊，反正我马上就不在这里干活了，你想吃也吃不到了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290410
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718290410,
					"content": "不在这里干活…这又是从何说起？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290411
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290411,
					"content": "呀，难不成真是我在你这吃喝太多，惹你被掌柜的嫌弃了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290412
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290412,
					"content": "也不该啊，我也颇钓了好几尾好鱼送进了客栈里，应该能抵了饭钱，而且掌柜的也不是这种小气之人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290413
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290413,
					"content": "你趁早给我歇了吧，你那几条鱼够谁吃的，最后还不是都进了你的肚子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290414
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718290414,
					"content": "那究竟是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290415
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290415,
					"content": "唉…算了，我还是和你说吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290416
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718290416,
					"content": "卖相足、味道好、够大气、显手艺，还要有格调…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290417
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290417,
					"content": "哈哈哈，掌柜的这是要你做一道世间不应有的奇菜啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290418
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290418,
					"content": "你给我笑，你接着笑。我看我走了之后，你还找谁蹭吃蹭喝！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290419
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718290419,
					"content": "笑罢了，笑罢了。我说你这个厨子为什么今天愁眉苦脸的，原来是遇见这桩事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290420
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290420,
					"content": "那可不，也不知道掌柜的怎么就突然异想天开，给我折腾的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290421
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718290421,
					"content": "唔，你也莫急。虽然我不会做菜，但还真知道一份奇菜的菜谱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290422
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290422,
					"content": "这是我当年在外游历时，偶然在一家大户人家吃到的奇菜，叫做「鸡豆花」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290423
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290423,
					"content": "此菜「食肉不见肉」，食之嫩如豆花，却又荤香醇厚，极尽鲜美，实为「以荤托素」的奇菜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290424
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290424,
					"content": "我吃过后十分好奇，便去请教了菜谱过来，不过…我却不擅长做菜，于是这菜谱也只能久压箱底…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290425,
						718290428
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290425,
					"content": "这种菜谱，你是怎么请教到的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290426
					]
				},
				{
					"id": 718290426,
					"content": "嗯…简单来说，当时我帮了那户人家一个忙，他们当时也是设宴请的我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290427
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290427,
					"content": "研究出这菜谱的厨子倒也自信，说天下能做出这菜的人屈指可数，所以菜谱抄了给我也没关系。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290429
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290429,
					"content": "这道菜确实很难做。按那厨子的说法，做这道的厨师不仅得精通厨艺，更要通晓剑术。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290430
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290430,
					"content": "啧，什么菜还要晓得剑术。假若是要剁肉的话，我这刀法就够了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290431
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718290431,
					"content": "要是你真用你那刀法来锤茸，只怕是肉茸未锤得，案板先被你锤做了两段。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290432
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290432,
					"content": "据那厨子所说，这道菜的精彩之处，皆在肉茸之上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290433
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290433,
					"content": "须以精妙剑术驭刀，先以刃挑去筋络，剁肉成泥，再以刀背捶打成茸，尔后再…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290434
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290434,
					"content": "停，你给我停一下…那你这菜谱，说了不等于白说，我是个惯常使刀的，你是个从来不下厨的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290435
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718290435,
					"content": "哪里去找个又会下厨，又善使剑的人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290436
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718290436,
					"content": "这个嘛…远在天边，近在眼前。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290437,
						718290439
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290437,
					"content": "我…我？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290438
					]
				},
				{
					"id": 718290438,
					"content": "正是。这位旅行者不恰巧既会下厨，也善使剑吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290441
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290441,
					"content": "#不如，就让{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}来试试做这道奇菜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290442
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290442,
					"content": "但掌柜的是让言笑…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290443
					]
				},
				{
					"id": 718290443,
					"content": "欸，掌柜的是让这厨子琢磨新菜，只要新菜琢磨出来了，那找谁来做，再商议便可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290444
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290444,
					"content": "厨子，你说是不是这个道理？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290445
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290445,
					"content": "啊…对！是这个理，是这个理！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290446
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718290446,
					"content": "但是这鸡豆花，究竟要用什么食材呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290447
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718290447,
					"content": "食材倒都是寻常的食材，只需禽肉、火腿、鸟蛋和金鱼草便可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290448
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290448,
					"content": "禽肉和火腿厨房里还有备货，但鸟蛋和金鱼草…好像已经被我用光了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290449
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718290449,
					"content": "唉，早知道就不做那道松茸滑蛋了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290450
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718290450,
					"content": "旅行者，请你帮我找一份鸟蛋，一份金鱼草来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290451
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718290451,
					"content": "找到之后，我们就一起来琢磨琢磨这道鸡豆花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290452
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718290452,
					"content": "呃…当然，报酬不会少你的…这件事就拜托你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "言笑"
				},
				{
					"id": 718290439,
					"content": "我确实会点厨艺…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290440
					]
				},
				{
					"id": 718290440,
					"content": "也很擅长使剑，对吧？我平日里也观察过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290441
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290428,
					"content": "这道菜肯定很难做吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290429
					]
				},
				{
					"id": 718290405,
					"content": "你还挺有心得…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290406
					]
				},
				{
					"id": 718290406,
					"content": "哈哈哈，常吃如此美味，就算是我再笨也能吃出心得来，我再教你如何品这道炖鱼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290409
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290407,
					"content": "你不坐着一起吃吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290408
					]
				},
				{
					"id": 718290408,
					"content": "我？我可吃不下，我早就被掌柜的训饱了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290409
					],
					"speakerTitle": "言笑"
				}
