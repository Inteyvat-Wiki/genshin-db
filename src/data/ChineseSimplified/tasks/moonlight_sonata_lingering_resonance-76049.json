	"talks": [
		{
			"id": 7604901,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7604901",
							"2"
						],
						"stepId": 7604901,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「少女」"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2130.918,
							108.955,
							11206.71
						],
						"pointId": 360300003
					}
				]
			},
			"dialogs": [
				{
					"id": 760490101,
					"content": "…好像调子高了一些，再试试？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490102
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490102,
					"content": "哥伦比娅！你好呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760490103,
					"content": "咦？你今天是在…教月灵弹琴吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760490104,
					"content": "嗯，之前修好琴后，月灵们很开心，每天都缠着我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490105
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490105,
					"content": "但我其实不是很会弹琴，之前都是听别人弹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490106
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490106,
					"content": "唔，可以理解，感觉如果组乐队的话，哥伦比娅是专门负责唱歌的角色呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760490107,
					"content": "#不过，说到乐器，这家伙可是特别擅长呢！从蒙德的「诗琴」到纳塔的「聚聚鼓」，{M#他}{F#她}都十分精通呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490108,
						760490109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760490108,
					"content": "一般般，一般般…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490110
					]
				},
				{
					"id": 760490110,
					"content": "是吗？那…不如你来教它们弹？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490111,
						760490112
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490111,
					"content": "那就露一手…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490113
					]
				},
				{
					"id": 760490113,
					"content": "月灵们最近都在练习我平时唱的那首歌，你记得旋律吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490114
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490114,
					"content": "或者…弹些你拿手的旋律也行。月灵们很少听到其他国家的音乐，我也想听。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490115
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490115,
					"content": "（弹什么好呢…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490202,
						760490801
					]
				},
				{
					"id": 760490202,
					"content": "演奏哥伦比娅常哼的歌…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490201
					]
				},
				{
					"id": 760490201,
					"content": "（以什么样的情绪演奏呢…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490603,
						760490701
					]
				},
				{
					"id": 760490603,
					"content": "平和的乐调…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490604
					]
				},
				{
					"id": 760490604,
					"content": "好听。我平时哼的旋律，原来你都记下来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490605
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490605,
					"content": "嘿嘿，因为你唱歌很好听嘛，我们有时会悄悄在旁边听上一会儿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760490606,
					"content": "月灵们也听得入迷了。不知道它们有没有学会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490607
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490607,
					"content": "说不定，以后还得多请你们教几次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490608
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490608,
					"content": "来吧，把手给我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490609
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490609,
					"content": "欸？我们这是无偿演出，不用收学费的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490610
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760490610,
					"content": "嗯？学费？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490611
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490611,
					"content": "我只是觉得，好听的旋律，应该有美丽的月光相伴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490701,
					"content": "愉快的乐调…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490702
					]
				},
				{
					"id": 760490702,
					"content": "结束了？感觉都还没听够…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490703
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490703,
					"content": "我曾说过这是我唯一记得的「摇篮曲」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490704
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490704,
					"content": "尽管还没找到其中的意义，但听你弹过之后，我开始觉得在月亮上等待着我的那个答案，至少是美好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490705
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490705,
					"content": "来，把手给我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490706
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490706,
					"content": "这次就不用回报啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490707
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760490707,
					"content": "不，我只是想为这旋律添上一束美好的月光。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490801,
					"content": "演奏他国的音乐…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490802
					]
				},
				{
					"id": 760490802,
					"content": "奇妙的感觉。以前偶尔也听过类似的旋律，但听你弹的感受很不一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490803
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490803,
					"content": "#可能其中包含了{M#他}{F#她}对那个国家的感情吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490804
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760490804,
					"content": "奇妙的是，我能够从乐调中想象出风景…不知道现实和我的想象会有多少区别呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490805
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490805,
					"content": "想看还不简单？到时候就让我们来当你的导游吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490806
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760490806,
					"content": "嗯…如果能有那么一天的话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490112,
					"content": "弹什么好呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490113
					]
				},
				{
					"id": 760490109,
					"content": "略熟，略熟…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490110
					]
				}
			]
		},
