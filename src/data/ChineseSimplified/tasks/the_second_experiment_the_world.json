				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿贝多"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110440320,
					"content": "没想到你们真的全都找到了，非常感谢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440321
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110440321,
					"content": "寻找物品，还有之前来雪山找我的时候，用到的都是「元素视野」，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440322
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110440322,
					"content": "是的，这个应该算是超能力吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110440323,
					"content": "有点遗憾，虽然「元素视野」比较罕见，但是总归是提瓦特大陆存在的能力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440324
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110440324,
					"content": "只有完全没有听说过的异世界超能力，才能为我的研究提供帮助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440325
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110440325,
					"content": "也就是说，又白忙一场…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440326
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110440326,
					"content": "不用太沮丧，这也在预料之中，而且能回收失物，这次实验已经非常有价值了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440301
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110440301,
					"content": "你们能够想到失物都具有元素力这一点，也值得称赞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440302
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110440302,
					"content": "好了，之前都是在研究异世界可能存在的与众不同之处，但是对于你人类的身份的研究，现在才要开始。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440303,
						110440304
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110440303,
					"content": "做好奉陪到底的准备了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440305
					]
				},
				{
					"id": 110440305,
					"content": "人类的个体差异，集中体现在智能和身体机能的水平上，我们就从身体机能方面开始吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440306
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110440306,
					"content": "从这里望出去，你可以看见砂糖她现在在做什么吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440307
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110440307,
					"content": "不能。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440308
					]
				},
				{
					"id": 110440308,
					"content": "那如果你平地起跳，跳到那边的山崖上，能看到吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440309
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110440309,
					"content": "不能。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440310
					]
				},
				{
					"id": 110440310,
					"content": "那如果你一拳打碎面前的山体，能看到吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440311,
						110440312
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110440311,
					"content": "不能。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440313
					]
				},
				{
					"id": 110440313,
					"content": "既然是这样，可能还要下调一点期待。比起提问，还是做实验更直观。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440314
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110440314,
					"content": "我知道一个地方非常适合进行体能实验，跟我过来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110440312,
					"content": "我觉得这个还是超能力测试。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440313
					]
				},
				{
					"id": 110440304,
					"content": "这就叫「上了贼船」吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440305
					]
				}
			]
		},
