			},
			"dialogs": [
				{
					"id": 741460101,
					"content": "#{NICKNAME}骑士…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460102,
						741460107,
						741460114,
						741460120
					],
					"speakerTitle": "安"
				},
				{
					"id": 741460102,
					"content": "关于现在的情况…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741460103
					]
				},
				{
					"id": 741460103,
					"content": "我好像想起了一些…一些很模糊的感觉。我不知道这些感觉能不能被称为「记忆」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460104
					],
					"speakerTitle": "安"
				},
				{
					"id": 741460104,
					"content": "虽然不知道人类的记忆到底是保存在头脑里还是心中…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460105
					],
					"speakerTitle": "安"
				},
				{
					"id": 741460105,
					"content": "但纯水精灵好像既没有头脑也没有心，只有水…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460106
					],
					"speakerTitle": "安"
				},
				{
					"id": 741460106,
					"content": "要是我也能像笨狗那样，只要坐在那里念叨什么「碎片数据整理」之类的就能想起一切，那该多好呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安"
				},
				{
					"id": 741460107,
					"content": "还想了解一些关于安的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741460108
					]
				},
				{
					"id": 741460108,
					"content": "我不知道还有什么可以告诉你的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460109
					],
					"speakerTitle": "安"
				},
				{
					"id": 741460109,
					"content": "我是「玛丽安」幻化出来的部分，可是…可是她拒绝了我，也拒绝了其他人…我是说，其他存在…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460110
					],
					"speakerTitle": "安"
				},
				{
					"id": 741460110,
					"content": "我想要解救的莉利丝公主并不存在，「玛丽安」也不是玛丽安，不是笨狗的主人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460111
					],
					"speakerTitle": "安"
				},
				{
					"id": 741460111,
					"content": "不知道为什么看到笨狗就觉得，内部好像涌起了什么…像气泡一样的感情！快要想起什么的时候，泡泡就碎开了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460112
					],
					"speakerTitle": "安"
				},
				{
					"id": 741460112,
					"content": "卡特皮拉好像知道什么的样子，可是他不是有十足的把握就不愿多说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460113
					],
					"speakerTitle": "安"
				},
				{
					"id": 741460113,
					"content": "明明来到了名字里有「水仙十字」的地方，却还是什么也没搞明白…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安"
				},
				{
					"id": 741460114,
					"content": "还想了解一些关于莉利丝公主的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741460115
					]
				},
				{
					"id": 741460115,
					"content": "莉利丝公主善良又勇敢，所以为了保护朋友，才让自己陷入困境。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460116
					],
					"speakerTitle": "安"
				},
				{
					"id": 741460116,
					"content": "之前我只想，我一定也是她的伙伴，她曾经保护过我，所以在她遇到困难的时候，我必须去解救她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460117
					],
					"speakerTitle": "安"
				},
				{
					"id": 741460117,
					"content": "虽然她可能不希望我去救她…因为她太善良了，宁可自己受困也不要朋友遇到危险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460118
					],
					"speakerTitle": "安"
				},
				{
					"id": 741460118,
					"content": "但是我如果不去救她，怎么配当她的朋友，受她的保护呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460119
					],
					"speakerTitle": "安"
				},
				{
					"id": 741460119,
					"content": "「记忆」…是模糊的，好像水里的涡流。感情…愿望，却那么真实。即使现在我已经知道她却只是故事里的角色…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安"
				},
				{
					"id": 741460120,
					"content": "没什么，你先休息吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741460121
					]
				},
				{
					"id": 741460121,
					"content": "#嗯。晚安，{NICKNAME}骑士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安"
				}
			]
		},
