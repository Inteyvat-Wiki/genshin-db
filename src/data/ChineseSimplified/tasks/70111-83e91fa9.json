			"dialogs": [
				{
					"id": 701110101,
					"content": "贵殿，暂请留步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110102
					],
					"speakerTitle": "曾我隅田流左近重衡"
				},
				{
					"id": 701110102,
					"content": "省去委细之事，某有一事相求。先日，璃月的虞黄衣殿下曾向某寄送一件稀代的珍品，然至今未达…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110103
					],
					"speakerTitle": "曾我隅田流左近重衡"
				},
				{
					"id": 701110103,
					"content": "某怀疑其为此地守护者所掠取。若贵殿见到虞黄衣殿下所说的「珍品」，可否为某取回？届时，某必将奉上相应的报谢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "曾我隅田流左近重衡"
				}
			]
		},
		{
			"id": 7011102,
			"completionStepIds": [
				7011102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7011102",
							"2"
						],
						"stepId": 7011102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"曾我隅田流左近重衡"
				],
				"points": [
					{
						"sceneId": 103,
						"position": [
							322.275,
							205.963,
							571.86
						],
						"pointId": 229
					}
				]
			},
			"dialogs": [
				{
					"id": 701110201,
					"content": "我们回来啦！你看看，这个是不是你说的「珍品」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 701110202,
					"content": "哦哦，感激不尽，感激不尽！多谢两位相助！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110203
					],
					"speakerTitle": "曾我隅田流左近重衡"
				},
				{
					"id": 701110203,
					"content": "那么，事不宜迟，某这便启封——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110204
					],
					"speakerTitle": "曾我隅田流左近重衡"
				},
				{
					"id": 701110204,
					"content": "这、这是…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110205
					],
					"speakerTitle": "曾我隅田流左近重衡"
				},
				{
					"id": 701110205,
					"content": "呜哇！这东西是不是快要炸了？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 701110206,
					"content": "虞黄衣殿下不会害某…莫非是被守护者所寻获，改造成了所谓的「爆弹」吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110207
					],
					"speakerTitle": "曾我隅田流左近重衡"
				},
				{
					"id": 701110207,
					"content": "实是耻辱，但某对如何拆解「爆弹」一窍不通…无计可施，只好把它丢出去了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110208
					],
					"speakerTitle": "曾我隅田流左近重衡"
				},
				{
					"id": 701110208,
					"content": "不必担心！某还记得，有位从「亥珀波瑞亚」来的殿下好像说过，应当如何丢出神圣的「爆弹」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110209
					],
					"speakerTitle": "曾我隅田流左近重衡"
				},
				{
					"id": 701110209,
					"content": "「汝当数到三，不可多，也不可少；汝既不可数四，也不可数二，五是数多了。当汝数到的数是三——」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110210
					],
					"speakerTitle": "曾我隅田流左近重衡"
				},
				{
					"id": 701110210,
					"content": "废话太多啦！再不扔就真的要炸啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
