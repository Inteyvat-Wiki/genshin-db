				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"孙宇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210380201,
					"content": "多谢你了，旅行者。这张「画片」就足够了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380202
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210380202,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380203
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210380203,
					"content": "唉，终于还是要走了。虽然平日里我听人家说「大丈夫志在四方」，「读万卷书，行万里路」时，总觉得豪气万丈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380204
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210380204,
					"content": "但等到自己真要离乡远行，我却觉得胸中半点豪气都没有，只想再多待在这里一会…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380205
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210380205,
					"content": "旅行者，你觉得我这趟远行，真的会找到我想要的东西吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380206,
						210380208
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210380206,
					"content": "我不知道。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210380207
					]
				},
				{
					"id": 210380207,
					"content": "哈哈…说的也是，我到底要找什么东西呢？就连我自己也不知道啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380210
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210380210,
					"content": "好了，时间也差不多了，我要去和那位客商会合了。这些报酬请你收下吧，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380211
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210380211,
					"content": "师妹…她还是没来啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210380208,
					"content": "看你自己了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210380209
					]
				},
				{
					"id": 210380209,
					"content": "你这话说的…差不多等于说「此事随缘」了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380210
					],
					"speakerTitle": "孙宇"
				}
			]
		},
