	"talks": [
		{
			"id": 2103801,
			"completionStepIds": [
				2103801
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2103801",
							"2"
						],
						"stepId": 2103801,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"孙宇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210380101,
					"content": "旅行者，你可算是来了，我还以为今天等不到你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380102
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210380102,
					"content": "今天就是我离开璃月港的日子了，之前麻烦了你那么多事…我得好好向你道谢才是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380103
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210380103,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380104
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210380104,
					"content": "咳…我本来刚才还在打腹稿，想着见了你之后说些什么感谢的话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380105
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210380105,
					"content": "结果现在真要说了，我反倒是忘得一干二净，让你见笑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380106,
						210380107
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210380106,
					"content": "没事，以后还会见的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210380108
					]
				},
				{
					"id": 210380108,
					"content": "真的？哈哈哈，那就太好了，那我到时候就可以领着你到处逛逛啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380109
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210380109,
					"content": "对了，我今天还要请你帮最后一个忙。我记得你有一架「留影机」对吧？我想请你帮我留个影。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380110
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210380110,
					"content": "我听一个水手说，在外漂泊，最好留一张故乡的「画片」做念想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380111
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210380111,
					"content": "但我可没有「留影机」，只能请你帮忙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380112,
						210380113
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210380112,
					"content": "没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 210380113,
					"content": "你摆个好看点的姿势。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210380114
					]
				},
				{
					"id": 210380114,
					"content": "这，这我摆什么姿势好？哎呀，主要是拍后面的景致…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210380107,
					"content": "过段时间，我去枫丹找你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210380108
					]
				}
			]
		},
		{
			"id": 2103802,
			"completionStepIds": [
				2103803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2103803",
							"2"
						],
						"stepId": 2103803,
						"stateName": "QUEST_STATE_UNFINISHED"
