				"points": []
			},
			"dialogs": [
				{
					"id": 400740201,
					"content": "水占盘上显示，我们已经到幻境了。唔，先找入口…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740202
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400740202,
					"content": "会不会是那边那个？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400740203,
					"content": "这看起来…好像是个水池。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740204
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400740204,
					"content": "不会是要游泳进去吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400740205,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740206
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400740206,
					"content": "难道，我们之中有旱鸭子？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740207
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400740207,
					"content": "我倒觉得问题可能不在这里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740208
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400740208,
					"content": "啊哈，有人害怕了是吗？那好吧，就由我来打头阵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740209
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400740209,
					"content": "开始了！她对游泳很自信，所以开始炫耀了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740210
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400740210,
					"content": "咳！小姐，注意措辞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740211
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 400740211,
					"content": "啊、噢噢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740212
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400740212,
					"content": "先走一步！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740213
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400740213,
					"content": "啊，莫娜跳进池子里消失了？！我们也快跟上去！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
