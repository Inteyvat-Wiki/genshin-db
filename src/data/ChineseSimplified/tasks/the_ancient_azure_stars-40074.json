				"points": []
			},
			"dialogs": [
				{
					"id": 400740901,
					"content": "周围变了。这里不是我们出发前的海滩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740902
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400740902,
					"content": "看起来，应该是蒙德的山地。难道说，我们被送到蒙德了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740903
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 400740903,
					"content": "但周围还是无垠之海呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740904
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400740904,
					"content": "周围应该有刚才那样可供进入的水池。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740905
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400740905,
					"content": "在这边！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740906
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400740906,
					"content": "…嗯？不能直接进入？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740907
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400740907,
					"content": "水面上好像浮现出什么东西了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740908
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400740908,
					"content": "这是画吗？还是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740909
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400740909,
					"content": "似乎在提示某个地点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740910
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400740910,
					"content": "是希望本皇女带领大家前往那里呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740911
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400740911,
					"content": "怎么又是你带队了…算了，谁带都行，总之先把这个地方找出来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莫娜"
				}
			]
		},
