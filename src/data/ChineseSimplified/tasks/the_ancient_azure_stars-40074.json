			"dialogs": [
				{
					"id": 400740301,
					"content": "好宏伟的建筑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740302
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400740302,
					"content": "哇…我从来没见过这样的地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740303
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400740303,
					"content": "喂莫娜，你的幻境太厉害了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740304
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400740304,
					"content": "虽然比起幽夜净土还是寒碜了一些，但也不错哦，梅姬斯图斯卿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740305
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400740305,
					"content": "（太好了，幸好不是什么被老太婆训话的课堂…面子算是保住了…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740306
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400740306,
					"content": "天才占星术士的幻境，当然得气派啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740307
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400740307,
					"content": "接下来，开始搜索吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莫娜"
				}
			]
		},
		{
