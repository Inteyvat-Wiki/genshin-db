				"points": []
			},
			"dialogs": [
				{
					"id": 400741101,
					"content": "各位，这边集合！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741102
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400741102,
					"content": "大家都睡醒了吧？莫娜刚才说，有重要的事要宣布。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741103
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400741103,
					"content": "君临幽夜净土后晨曦初绽之时，确实令本皇女心旷神怡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741104
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400741104,
					"content": "小姐的意思是，她已经准备好面对接下来的挑战了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741105
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 400741105,
					"content": "我们也睡饱吃饱了哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400741106,
					"content": "嗯。那我就直说了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741107
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400741107,
					"content": "刚才我用水占盘看过，有一处新的幻境，已经在那边的岛屿上汇聚成型。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741108
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400741108,
					"content": "而且…如果直觉没错的话，应该与我有关。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741109
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400741109,
					"content": "这次是莫娜啊。之前几个幻境，莫娜都陪着我们去了。这回轮到我们去你那里看看啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741110
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400741110,
					"content": "呃…没什么好看的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741111
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400741111,
					"content": "梅姬斯图斯卿，您是在不好意思吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741112
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 400741112,
					"content": "不不，怎么会呢，啊哈哈，我才不担心大家看见过于寒碜的幻境从而对我这个人产生偏见呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741113
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400741113,
					"content": "都说出来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741114
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400741114,
					"content": "其实…大家一般都会觉得占星术士很超凡脱俗，对吧？我担心，万一我的幻境不是那样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741115
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400741115,
					"content": "本皇女可没有在期待那种愚昧无比的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741116
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400741116,
					"content": "我也没有。倒不是不对你抱有期待啦，但我认为，莫娜你本来就是个亲切善良的人，不需要伪装。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741117
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400741117,
					"content": "怀抱平常心的人，其幻境也会呈现出相应的亲切。这不是好事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741118
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400741118,
					"content": "对呀，再说，我们去莫娜的幻境也不只是观光旅游，还有别的目的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741119,
						400741120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400741119,
					"content": "嗯。说不定…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400741121
					]
				},
				{
					"id": 400741121,
					"content": "…这样啊，那就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741122
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400741122,
					"content": "只要你们别太期待，我就不紧张了。好，那出发吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400741120,
					"content": "那里有解决幻象的线索。",
