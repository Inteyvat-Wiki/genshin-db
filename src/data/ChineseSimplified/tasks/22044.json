			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"大岛纯平"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220440101,
					"content": "旅行者，你怎么来了？你是想过来拜一拜吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440102
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 220440102,
					"content": "你的木雕怎么样了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220440103
					]
				},
				{
					"id": 220440103,
					"content": "哈哈哈，倒也还算顺利，就是木雕的尺寸还得再把握把握。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440104
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 220440104,
					"content": "毕竟，按照我最初的想法，这些木雕的大小最好不超过人的手掌尺寸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440105
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 220440105,
					"content": "这样子，才方便拿在手里把玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440106
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 220440106,
					"content": "而且，除了雕像本身之外…我还想要再做一点「装饰」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440107
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 220440107,
					"content": "我之前看人做雕像的时候，除了制作雕像的本体，还会在雕像旁边搭配一些小装饰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440108
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 220440108,
					"content": "比如花啦、动物啦，或者是带花纹的底座之类的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440109
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 220440109,
					"content": "我也想给我的这种小木雕做一个带装饰物的底座…虽然因为尺寸问题，一个木雕应该只能附带一个装饰…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440110
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 220440110,
					"content": "但是我想，只要把那些装饰做成可拆卸的就行了。到时候客人想要什么装饰，我就给他们安上什么装饰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440111
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 220440111,
					"content": "我想要先从简单的装饰开始练起，比如…鸣草之类的植物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440112
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 220440112,
					"content": "旅行者，能请你帮我去采三株「鸣草」来给我做参考吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440113,
						220440114
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 220440113,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220440117
					]
				},
				{
					"id": 220440117,
					"content": "那就拜托你了，旅行者。你采到鸣草后，就快点带来给我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 220440114,
					"content": "为什么要三株？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220440115
					]
				},
				{
					"id": 220440115,
					"content": "有三株的话，我就可以同时观察三种不同状态的鸣草了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440116
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 220440116,
					"content": "这样的话，我一定能雕出最好看的鸣草。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440117
					],
					"speakerTitle": "大岛纯平"
				}
			]
		},
