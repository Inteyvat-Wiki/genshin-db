			"dialogs": [
				{
					"id": 220440301,
					"content": "喔！这些就足够了，谢谢你旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440302
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 220440302,
					"content": "我等会就来研究一下…看看怎么样才能把木头雕成鸣草的模样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440303
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 220440303,
					"content": "唔，如果我能把这些装饰做得好一些，种类也再做多一些的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440304
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 220440304,
					"content": "说不定，装饰也能单独拿出来卖…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大岛纯平"
				}
			]
		}
	]
