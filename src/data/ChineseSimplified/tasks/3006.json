				"objectNames": [
					"塔里克"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30060701,
					"content": "艾尔海森…没想到你这疯子还真敢来啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060702
					],
					"speakerTitle": "塔里克"
				},
				{
					"id": 30060702,
					"content": "对话是我要求的，我还担心你们不会守约，但看来你们还是很讲信用的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060703
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 30060703,
					"content": "场面挺隆重的，我也带了帮手，没关系吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060704
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 30060704,
					"content": "#帮手？这不是饭馆里那{M#小子}{F#丫头}吗，因为这疯子帮了你的忙，所以来报答他？哼，胆子倒是不小。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060705
					],
					"speakerTitle": "塔里克"
				},
				{
					"id": 30060705,
					"content": "我也不说什么客气的话了，你们就等着到水里去喂鱼吧。兄弟们，上！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060706
					],
					"speakerTitle": "塔里克"
				},
				{
					"id": 30060706,
					"content": "他们冲过来了，你们两个小心一点！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 300608,
			"completionStepIds": [
				300612
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"300612",
							"2"
						],
						"stepId": 300612,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"艾尔海森"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30060801,
					"content": "刚刚到底发生什么事了？那个大块头突然就变成了那个样子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060802
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30060802,
					"content": "看来，他是使用过神明罐装知识了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060803
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 30060803,
					"content": "他会变成那样，是因为神明罐装知识的影响吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060804
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30060804,
					"content": "说起来，之前海芭夏说过…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060805
					]
				},
				{
					"id": 30060805,
					"content": "你是指学者们在获取世界树知识的时候，会因为接触到神明的知识而发疯这件事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060806
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30060806,
					"content": "据我所知，「林居狂语期」学者们疯掉的情况的确不少。从那家伙的样子看，也像是类似的状况。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060807
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 30060807,
					"content": "看来这个神明罐装知识的确与神明有关，但又应该不像传闻中的那样，拥有它就拥有了神明的智慧或者力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060808
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 30060808,
					"content": "你听到那个家伙嘴里说的话了吗？「世界…遗忘我」，这究竟是什么意思…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060809
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 30060809,
					"content": "（他嘴里说的那句话，和之前在世界树那里听到的一模一样…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060810
					]
				},
				{
					"id": 30060810,
					"content": "那个人被风纪官带走了的话，手上的神明罐装知识也会被教令院拿回去了吧？好可惜，就这么和目标失之交臂了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060811
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30060811,
					"content": "不过，没想到神明罐装知识这么危险，如果我们贸然尝试了它，说不定我们也会变成那种样子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060812
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30060812,
					"content": "事已至此，我也没有在奥摩斯港继续停留的意义了，我们的合作也告一段落吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060813
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 30060813,
					"content": "说起来，之前光顾着找神明罐装知识，还没问过你，既然你是教令院的人，那你知不知道见小吉祥草王的办法？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060814
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30060814,
					"content": "实话说，我也不知道。小吉祥草王似乎游离于须弥的治理体系之外，平时甚至完全感受不到她的存在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060815
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 30060815,
					"content": "而且教令院有象征神明智慧的虚空在，学者们也没有想要与神明本身接触的理由…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060816
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 30060816,
					"content": "唉，可真是神秘啊，小吉祥草王。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060817
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30060817,
					"content": "之后我会回教令院去，你们呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060818
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 30060818,
					"content": "看看时间，也快到花神诞日了，要不我们也回须弥城去吧。这些天一直都在奔波，说不定稍微休息一下也能打起精神来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060819,
						30060820
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30060819,
					"content": "你说得有道理。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060821
					]
				},
				{
					"id": 30060821,
					"content": "艾尔海森，那我们就在这里告别吧。再见！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060822
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30060822,
					"content": "嗯…接下来，是先处理这个东西，还是先写大人物们要的报告书呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 30060820,
					"content": "我们回须弥城吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060821
					]
				}
			]
		},
