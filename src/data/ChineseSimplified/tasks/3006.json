					"nextDialogs": [
						30060519
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 30060519,
					"content": "不愧是神明罐装知识，和之前见到的都不一样，它可是散发着耀眼的红色光芒喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060520
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 30060520,
					"content": "在我拍摄的画片上，也能清楚地看到这枚神明罐装知识喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060521
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 30060521,
					"content": "谢谢你的情报，多莉。",
					"roleType": "TALK_ROLE_NPC",
