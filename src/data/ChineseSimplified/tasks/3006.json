			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"艾尔海森"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30060101,
					"content": "你们来了，看你们的表情，事情应该是办成了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060102
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 30060102,
					"content": "哇，这里可有不少教令院的人在啊，你怎么把见面地点选在这种地方？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30060103,
					"content": "维卡拉商栈本来就是教令院管理监督下的机构，当然有教令院的人在这里工作。我来奥摩斯港，表面上也是处理这里的公务。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060104
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 30060104,
					"content": "你这个人还真是胆大包天…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30060105,
					"content": "别那么紧张，这儿的人对我们的话题没兴趣，而且风纪官也不会来这里的。好了，说说你们和多莉见面的情况吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060106
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 30060106,
					"content": "向艾尔海森说明了之前的经历，并把买到的罐装知识交给了他…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						30060107
					]
				},
				{
					"id": 30060107,
					"content": "艾尔海森，既然我们已经把你交待的事办到了，现在你总可以告诉我们关于教令院丢失的罐装知识的情报了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30060108,
					"content": "在那之前我想问一句，你们为什么要追查那个东西？当然你们不回答也没关系。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060109,
						30060110
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 30060109,
					"content": "并不是什么需要隐瞒的理由。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060111
					]
				},
				{
					"id": 30060111,
					"content": "#嗯，{M#他}{F#她}只不过是想求见智慧之神，向她询问一些重要的事情而已。但我们在须弥待了这么久，还没有找到办法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30060112,
					"content": "这时候我们打听到教令院丢了某个东西，这件东西可能和「神明」有关。既然这样，我们就来碰碰运气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30060113,
					"content": "这么说的话，你们的方向倒也不算错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060114
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 30060114,
					"content": "前一阵子教令院在沙漠丢失了一枚罐装知识，据说那是一枚「神明罐装知识」，如果使用它，就能够获得神明的智慧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060115
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 30060115,
					"content": "#哇，竟然还有这种东西！你说，如果我们找到了它，是不是无论求见草神的办法，甚至你{M#妹妹}{F#哥哥}的事情，也都能知道了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30060116,
					"content": "这东西是不是有这么神奇，我非常怀疑。但这件东西确实存在，而且现在就在奥摩斯港。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060117
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 30060117,
					"content": "它现在在哪里？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30060118,
					"content": "这个问题，就是我们接下来的课题了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060119
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 30060119,
					"content": "难道说，你的目的也是它？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060120
					]
				},
				{
					"id": 30060120,
					"content": "我不否认。我对「神明罐装知识」究竟是什么很好奇，想一探究竟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060121
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 30060121,
					"content": "当然奥摩斯港的镀金旅团也盯上了它。这东西本身就非常珍贵，说不定其中的知识，还能带来更多力量与财富。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060122
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 30060122,
					"content": "最近几个旅团就正在争夺这东西的归属权，目前还没有最后赢家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060123
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 30060123,
					"content": "以我个人的财力和门路，很难跟他们竞争，所以我之前尝试了各种办法，好不容易才和几个旅团达成初步协议。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060124
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 30060124,
					"content": "我不会占有这枚神明罐装知识，但他们答应给我研究它的机会。毕竟对他们来说，搞懂这东西也没坏处。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060125
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 30060125,
					"content": "可是镀金旅团里，也有不那么好谈条件的，比如阿赫玛尔之眼的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060126
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 30060126,
					"content": "这些人坚信，神明罐装知识中有赤王的力量，他们得到它是为了让赤王重现世间，绝不允许教令院的人玷污赤王的精神。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060127
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 30060127,
					"content": "他们不肯跟你合作，所以你之前才会一直纠缠他们？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30060128,
					"content": "嗯。阿赫玛尔之眼并不算财大气粗，但得到它的信心非常坚决。他们为了弄到充足的资金，一直在用各种下作的办法敛财。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060129
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 30060129,
					"content": "所以我一直在搅他们的生意，逼他们不得不与我对话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060130
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 30060130,
					"content": "神明罐装知识的秘密交易，估计这几天就会进行。旅团们会各自出价，东西也会被偷偷交给赢家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060131
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 30060131,
					"content": "各旅团为了东西的安全，哪怕是为了提防风纪官，也不会公然声张自己赢得了神明罐装知识。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060132
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 30060132,
					"content": "如果我不能知道神明罐装知识的确切去向，和他们之间的协定就无法兑现。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060133
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 30060133,
					"content": "得知情报最可靠的通道就是多莉，但之前这条路对我来说走不通。现在你们加入了，情况就不一样了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060134
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 30060134,
					"content": "也就是说，你让我们和多莉搞好关系，都是为了获得神明罐装知识的下落？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30060135,
					"content": "对，你们可以这么认为，但这件事对你们没有一点坏处。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060136
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 30060136,
					"content": "后天，你们再到多莉那边去一趟，试着向她买神明罐装知识的下落。如果她表示还没有消息，就等两天再去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060137
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 30060137,
					"content": "如果我将来能顺利得到神明罐装知识的研究机会，会把研究结果告诉你们。这个就算是报酬，可以吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060138,
						30060139
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 30060138,
					"content": "这正是我需要的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060140
					]
				},
				{
					"id": 30060140,
					"content": "好，那我们就后天再见吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060141
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 30060141,
					"content": "艾尔海森，你等一下！其实我们自己也买了一枚罐装知识，不过还不知道应该怎么用它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060142
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30060142,
					"content": "你们想试试罐装知识？好吧，我可以教你们如何用它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060143
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 30060143,
					"content": "不过要站在教令院的眼皮子底下做这件事，还是困难了点，我们到野外去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 30060139,
