					"nextDialogs": [
						20101608
					]
				},
				{
					"id": 20101608,
					"content": "没错没错，这点人还伤不到我们哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101609
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20101609,
					"content": "好吧。那我们将他们一网打尽，之后再回来与队长会合！",
