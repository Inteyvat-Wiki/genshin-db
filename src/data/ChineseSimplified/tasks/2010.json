			"dialogs": [
				{
					"id": 20101301,
					"content": "你就是新任的剑鱼二番队队长吧，珊瑚宫大人已经跟我们说了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101302
					],
					"speakerTitle": "剑鱼二番队代理队长"
				},
				{
					"id": 20101302,
					"content": "军队中早有关于你的传闻，委任书也确认完毕。不过我尚有一个疑虑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101303
					],
					"speakerTitle": "剑鱼二番队代理队长"
				},
				{
					"id": 20101303,
					"content": "嗯？还有什么问题吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20101304,
					"content": "简单来说，就是你是否值得我们追随。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101305
					],
					"speakerTitle": "剑鱼二番队代理队长"
				},
				{
					"id": 20101305,
					"content": "你们的意思是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20101306,
					"content": "放在平时，最直接的做法就是痛痛快快地打一场。不过现在嘛，这里有更好的靶子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101307
					],
					"speakerTitle": "剑鱼二番队老兵"
				},
				{
					"id": 20101307,
					"content": "我们驻扎在这里，是因为最近很多<color=#00E1FFFF>流浪武士</color>闹事。如果你能把这些<color=#00E1FFFF>流浪武士</color>干掉，我们就认可你的实力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101308
					],
					"speakerTitle": "剑鱼二番队老兵"
				},
				{
					"id": 20101308,
					"content": "没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20101309
					]
				},
				{
					"id": 20101309,
					"content": "嗯嗯，就让他们心服口服吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
