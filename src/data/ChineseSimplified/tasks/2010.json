			"dialogs": [
				{
					"id": 20101401,
					"content": "有两下子嘛…虽然不如传闻中那么夸张，但确实很厉害。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101402
					],
					"speakerTitle": "幸德"
				},
				{
					"id": 20101402,
					"content": "介绍一下，我叫幸德，剑鱼二番队的代理队长。这位是嘉久，也是队伍中的老兵了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101403
					],
					"speakerTitle": "幸德"
				},
				{
					"id": 20101403,
					"content": "现在，我正式把「队长」一职交给你。剑鱼二番队，随时待命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101404
					],
					"speakerTitle": "幸德"
				},
				{
					"id": 20101404,
					"content": "还有别的流浪武士闹事吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20101405
					]
				},
				{
					"id": 20101405,
					"content": "遭到袭击的重灾区有两处，这里的流浪武士已经被队长干掉，他们的据点就只剩下<color=#00E1FFFF>本岛东部</color>的浅滩了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101406
					],
					"speakerTitle": "嘉久"
				},
				{
					"id": 20101406,
					"content": "不过那里的流浪武士数量更多，战斗力也更强。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101407,
						20101408
					],
					"speakerTitle": "嘉久"
				},
				{
					"id": 20101407,
					"content": "过去看看吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20101409
					]
				},
				{
					"id": 20101409,
					"content": "是呀，海祇岛还在和幕府军打仗呢，不能让这些坏家伙在后面捣乱！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20101408,
					"content": "心海也说要保证后方安全。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20101409
					]
				}
			]
