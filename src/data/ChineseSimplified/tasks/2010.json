			},
			"dialogs": [
				{
					"id": 20100901,
					"content": "#好久不见啦，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100902
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100902,
					"content": "怎么样，和剑鱼二番队那些人还合得来吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100903,
						20100904
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100903,
					"content": "合得来。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20100905
					]
				},
				{
					"id": 20100905,
					"content": "嘿嘿，就让我这个前辈教你一些统兵之道吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100906
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100906,
					"content": "你要给他们增加军饷，还要设置一些悬赏，要让他们遵守纪律…还有什么来着？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100907
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100907,
					"content": "哇哦…哲平，你是从哪听来的啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100908
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20100908,
					"content": "从一本八重堂出版的小说…那是好久以前的事了。当时我用好几个团子当贿赂，那个朋友才答应借我看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100909
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100909,
					"content": "居然试图用小说里的东西指导军队，这就是别人说的「纸上谈兵」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100910
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20100910,
					"content": "哼哼，不要小看我哦。现在我可是和你们一样，正在学习和摸索「治军之道」呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100911,
						20100912
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100911,
					"content": "难道说…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20100913
					]
				},
				{
					"id": 20100913,
					"content": "没错！因为在海战中立下了汗马功劳，现在我也是特别行动队的队长了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100914
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100914,
					"content": "而且还是一个全新的小队，「鲱鱼一番队」！怎么样，听起来是不是很厉害？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100915
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100915,
					"content": "我问过珊瑚宫大人啦，珊瑚宫大人说，我们的队服都已经在制作中了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100916
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100916,
					"content": "等制作好了，我们一起去把队服取回来。之后换上全新的队服见面，想想就觉得很酷！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100917
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100917,
					"content": "真好啊，多亏了从资助方那里拿到的东西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100918
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100918,
					"content": "那个队服，我也会有吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100919
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20100919,
					"content": "当然了！你也是我们海祇岛军队的一员呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100920
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100920,
					"content": "好耶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100921
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20100921,
					"content": "队长，有新的作战任务到了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100922
					],
					"speakerTitle": "内村"
				},
				{
					"id": 20100922,
					"content": "#嗯，我现在过去。那我先走啦，{NICKNAME}，下次再见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100923
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100923,
					"content": "你可要小心一点，不要被我轻易地超过去了哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100924
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100924,
					"content": "我们才不会输给你呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100925
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20100925,
					"content": "咳咳…这可难说。现在我的状态超级好，正是建功立业的好时候！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100926
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100926,
					"content": "没想到哲平居然也升到小队长啦，看来他真的很努力呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100927
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20100927,
					"content": "我们休息一下，然后去<color=#00E1FFFF>魔神战争遗迹</color>那边看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20100912,
					"content": "哲平也…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20100913
					]
				},
				{
					"id": 20100904,
					"content": "有些苦恼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20100905
					]
				}
			]
		},
