						20101111
					]
				},
				{
					"id": 20101111,
					"content": "我给哲平也安排了任务，是一个奇袭幕府海军的作战。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101112
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 20101112,
					"content": "他不愿意呆在后方，我也尊重他的选择。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101113
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 20101113,
					"content": "#言归正传，{NICKNAME}，有一项特殊的任务，我想要交给你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101114
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 20101114,
					"content": "「特殊的任务」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20101115,
					"content": "是的。在海祇岛和踏鞴砂之间，有一处<color=#00E1FFFF>魔神遗迹</color>。那里有几个小岛，经常被当做运送物资的中转站。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101116
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 20101116,
					"content": "不过这段时间，存放在那里的粮草经常会莫名其妙地消失。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101117
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 20101117,
					"content": "但是，军队路过的时候，却又说没有发现危险…我想委托你帮忙查证一下真相。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101118
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 20101118,
					"content": "此事并不急迫，不必太过匆忙。这几天，你们不妨先熟悉一下军队，也可以在海祇岛各处转转。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101119
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 20101119,
					"content": "等哲平回来之后，你可以跟他聊聊天，然后找个天气晴朗的日子出海。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101120
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 20101120,
					"content": "哲平他真的没事吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20101121,
					"content": "#一想到他以前冒失的样子，就有点担心。对了，{NICKNAME}，我们去<color=#00E1FFFF>训练营</color>等他吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20101104,
					"content": "遇到了一点「考验」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20101105
					]
				},
				{
					"id": 20101105,
					"content": "嗯，确实是他们的性格。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101106
					],
					"speakerTitle": "珊瑚宫心海"
				}
			]
		},
