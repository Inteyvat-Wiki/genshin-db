			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"哲平"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20100201,
					"content": "#哟，{NICKNAME}，你来啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100202
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100202,
					"content": "马上就到与珊瑚宫大人约定的日子了，我们也该出发了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100203
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100203,
					"content": "准备好了吗？我先带你去我们<color=#00E1FFFF>海祇岛</color>的军营看看，之后我们一起去找珊瑚宫大人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100204
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100204,
					"content": "如果中途晕船的话，要及时跟我说。不过听说你在南十字船队待过，应该没事吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100205
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100205,
					"content": "准备，起航！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "哲平"
				}
			]
		},
		{
			"id": 201004,
			"completionStepIds": [
				201004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201004",
							"2"
						],
						"stepId": 201004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"哲平"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20100401,
					"content": "这里就是我们海祇岛军队的训练营了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100402
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100402,
					"content": "目前的反抗军，绝大部分都是由海祇岛的本土士兵组成。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100403
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100403,
					"content": "一部分人在踏鞴砂跟幕府军正面交战，一部分人留在海祇岛，保护百姓的安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100404
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100404,
					"content": "哲平以前也在这里训练吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20100405,
					"content": "是啊，可惜我还没有完全得到教官的认可，就不得不去踏鞴砂参战了，只能先在后勤部队帮点小忙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100406
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100406,
					"content": "我暂时会住在这里，如果你想找我的话，来这里就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100407
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100407,
					"content": "要是我不在，你可以写个字条，贴在附近的墙上。我看到了就会去找你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100408
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100408,
					"content": "…糟了，快到与<color=#00E1FFFF>珊瑚宫大人</color>约定的时间了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100409
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100409,
					"content": "下次再带你逛一逛海祇岛吧，我先带你去<color=#00E1FFFF>珊瑚宫</color>！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100410
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100410,
					"content": "珊瑚宫，应该就是那位<color=#00E1FFFF>珊瑚宫心海</color>住的地方…我们过去看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 201006,
			"completionStepIds": [
				201006
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201006",
							"2"
						],
						"stepId": 201006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"珊瑚宫心海"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20100601,
					"content": "无论如何，粮草都是重中之重，不能有任何闪失。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100602
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 20100602,
					"content": "如今我们和幕府军之间的冲突日渐激烈，必须要优先保证后方稳定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100603
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 20100603,
					"content": "是。我再想想办法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100604
					],
					"speakerTitle": "大久保大介"
				},
				{
					"id": 20100604,
					"content": "放心，有了之前那批物资，我也在着手扩充军队。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100605
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 20100605,
					"content": "人手不足的时候辛苦你们了，之后的局面应该会有所好转。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100606
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 20100606,
					"content": "扩充军队？太好了。虽然不知道这次是谁在背后资助我们，但真是帮大忙了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100607
					],
					"speakerTitle": "大久保大介"
				},
				{
					"id": 20100607,
					"content": "欸？这不是哲平吗，你小子回海祇岛了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100608
					],
					"speakerTitle": "大久保大介"
				},
				{
					"id": 20100608,
					"content": "这位是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100609
					],
					"speakerTitle": "大久保大介"
				},
				{
					"id": 20100609,
					"content": "#嘿嘿，是珊瑚宫大人的客人哦，我是负责把{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}带回海祇岛的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100610
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100610,
					"content": "哦？莫非就是最近军队中已有传言的那位…力大无穷、百步穿杨、金刚不坏的新人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100611
					],
					"speakerTitle": "大久保大介"
				},
				{
					"id": 20100611,
					"content": "为什么会有这样的传闻啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100612
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20100612,
					"content": "两位远道而来，多半是有要紧事。我就不多打扰了，之后有空，也可以来我这坐坐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100613
					],
					"speakerTitle": "大久保大介"
				},
				{
					"id": 20100613,
					"content": "那珊瑚宫大人，我就先行告退了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100614
					],
					"speakerTitle": "大久保大介"
				},
				{
					"id": 20100614,
					"content": "珊瑚宫大人，我刚刚好像听到大久保大哥说什么「资助」，那是什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100615
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100615,
					"content": "不久之前，有人写信给我，说愿意支持海祇岛的抗争，并且送来了大量的物资。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100616
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 20100616,
					"content": "拜此所赐，我们终于可以放开手脚招兵买马，与幕府军在正面战场展开对抗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100617,
						20100619
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 20100617,
					"content": "那真是太好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20100618
					]
				},
				{
					"id": 20100618,
					"content": "其实我对此还有疑虑…不过海祇岛并不富庶，这笔物资确实是雪中送炭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100621
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 20100621,
					"content": "对方的要求也不过分，只说让我们竭尽全力对抗幕府军。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100622
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 20100622,
					"content": "不管他们的目的是什么，至少在这一点上我们是一致的，那就当做是多了一个不愿露面的盟友吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100623
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 20100623,
					"content": "当然，也不能完全放松警惕。如果你们发现任何异样，请及时汇报给我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100624
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 20100624,
					"content": "珊瑚宫大人，那前线的伙食是不是也会变好？前几天去伤兵营，那些家伙吵着要吃烤肉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100625
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100625,
					"content": "呵呵…放心，我已经安排好了。烤肉管饱，不过还是不许喝酒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100626
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 20100626,
					"content": "太好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100627
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100627,
					"content": "也难为你们了。从眼狩令颁布、我们起兵反抗以来，军中的饭菜确实很少更换。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100628
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 20100628,
					"content": "之后我会和后勤部队进行协商，在这方面做出一些改变。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100629
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 20100629,
					"content": "不过我们的物资还是有限，胜利之前，还希望你们再忍耐一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100630
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 20100630,
					"content": "那眼狩令，什么时候才能结束呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100631
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20100631,
					"content": "这个问题…我也没有答案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100632
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 20100632,
					"content": "眼狩令的颁布本就很奇怪。不管是天领奉行，还是将军大人，他们的态度都很微妙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100633
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 20100633,
					"content": "天领奉行突然对眼狩令追捧至极，而将军大人似乎也对眼狩令带来的战争视而不见…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100634
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 20100634,
					"content": "在解开这些谜题之前，眼狩令恐怕都不会结束。我只能向你保证，只要眼狩令还在，我们就不会放弃反抗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100635
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 20100635,
					"content": "#{NICKNAME}，现在我想再确认一下。在了解到海祇岛和反抗军的现状之后，你还愿意与我们一同抗争吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100636
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 20100636,
					"content": "我不会放弃。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20100637
					]
				},
				{
					"id": 20100637,
					"content": "好，那现在，我正式颁布对你的任命——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100638
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 20100638,
					"content": "从现在起，你将升任海祇岛特别行动队「剑鱼二番队」的队长。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100639
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 20100639,
					"content": "剑剑剑剑鱼二番队？是我理解的那个，被冠以「剑鱼」之名的特别行动队吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100640
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100640,
					"content": "我记得光是进入特别行动队就很难了，居然可以一口气当上队长…这也太厉害了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100641
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100641,
					"content": "虽然是破格任命，但我相信以你的智慧、勇气与力量，可以带领这支队伍走向胜利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100642
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 20100642,
					"content": "好耶！那我们什么时候去上任呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100643
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20100643,
					"content": "剑鱼二番队如今正在本岛<color=#00E1FFFF>西南</color>处的山谷待命，最近有一些<color=#00E1FFFF>流浪武士</color>闹事，需要特别行动队来稳定后方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100644
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 20100644,
					"content": "委任书我已经写好，你给他们看一下就可以了。那些流浪武士，也麻烦你一起清剿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100645
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 20100645,
					"content": "特别行动队的人都是海祇岛的精锐，身上或许会有些傲气，不过相信你能够赢得他们的信任。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100646
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 20100646,
					"content": "那，那我呢？珊瑚宫大人，有什么作战需要我吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100647
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100647,
					"content": "我也想为反抗军多做一些贡献！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100648
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100648,
					"content": "当然有了，等下我也会给你安排。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100649
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 20100649,
					"content": "#保证完成任务！嘿嘿，{NICKNAME}，虽然你已经当上了剑鱼二番队的小队长，但我也不会输给你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100650
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100650,
					"content": "好吧，你小心一点，不要太勉强了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100651
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20100651,
					"content": "#{NICKNAME}，我们也出发吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20100619,
					"content": "真的靠谱吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20100620
					]
				},
				{
					"id": 20100620,
					"content": "我对此也有疑虑…不过海祇岛并不富庶，这笔物资确实是雪中送炭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100621
					],
					"speakerTitle": "珊瑚宫心海"
				}
			]
		},
		{
			"id": 201009,
