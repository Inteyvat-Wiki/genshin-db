			"dialogs": [
				{
					"id": 210230201,
					"content": "楼梯还是得赶紧修了啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230202
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210230202,
					"content": "你是掌柜的吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210230203
					]
				},
				{
					"id": 210230203,
					"content": "我是，您有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230204
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210230204,
					"content": "有一份给你的包裹，是楼下的一个人要我们送给你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 210230205,
					"content": "哦…这应该是客商给我的包裹…甄强怎么自己不来送？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230206
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210230206,
					"content": "他还有货要接？嗨，他准是嫌上上下下麻烦，懒得上来又下去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230207
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210230207,
					"content": "您是客人吧，实在对不住，这楼梯坏得太不是时候了，我正寻思着怎么修呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230208
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210230208,
					"content": "真是麻烦了，还让您来送这个包裹给我，这样，这份报酬给您，您收好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230209
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210230209,
					"content": "这本来是给甄强准备的，但既然他让您来送了这个包裹，那这份报酬当然该您收下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230210
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210230210,
					"content": "好了，我接着去筹备修楼梯的事了，您随意在客栈里逛逛，有什么事您随时找我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "淮安"
				}
			]
		}
	]
