			"dialogs": [
				{
					"id": 6050201,
					"content": "两位辛苦了，防御得非常完美。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050202
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 6050202,
					"content": "接下来这里交给我们就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050203
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 6050203,
					"content": "凯亚队长，斯万他…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050204
					],
					"speakerTitle": "劳伦斯"
				},
				{
					"id": 6050204,
					"content": "喂！我没事。倒是你的小腿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050205
					],
					"speakerTitle": "斯万"
				},
				{
					"id": 6050205,
					"content": "斯万，劳伦斯，都到西风教会接受治疗吧，别勉强。我们会接手这一带。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050206
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 6050206,
					"content": "可是，迪卢克老爷也…您不是早就已经离开骑士团了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050207
					],
					"speakerTitle": "斯万"
				},
				{
					"id": 6050207,
					"content": "是啊，但也不是只有骑士团的人才能看守这扇大门。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050208
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 6050208,
					"content": "老爷一向很热心，哎，你就别管了。市民愿意做些什么，那就让他做呗，也没什么不好，不是吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050209
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 6050209,
					"content": "…我明白了。非常抱歉，我衷心感谢您能支援我们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050210
					],
					"speakerTitle": "斯万"
				},
				{
					"id": 6050210,
					"content": "我们会尽快回来，多谢二位！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050211
					],
					"speakerTitle": "劳伦斯"
				},
				{
					"id": 6051104,
					"content": "趁现在有空，我打算做些药剂分发给附近的战士，应该能够帮上些忙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6051105
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 6051105,
					"content": "稳妥的判断，辛苦你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6051106
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 6051106,
					"content": "注意安全。虽然我不觉得会有这种情况，但如果出现你无法应对的情况，立刻撤离到安全地区。不用担心阵线问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6051107
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 6051107,
					"content": "是，我明白了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "砂糖"
				}
			]
		},
