			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"莫娜",
					"枫原万叶",
					"菲谢尔",
					"奥兹",
					"辛焱"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400760901,
					"content": "哇啊！这、这…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760902
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400760902,
					"content": "又是蒙德的房屋？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760903
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400760903,
					"content": "怎么到我家了啊——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760904
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400760904,
					"content": "你家？这是你家？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760905
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400760905,
					"content": "哦呀，这可真没想到…我似乎听说，梅姬斯图斯卿一直过着较为拮据的生活，可这栋住宅…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760906
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 400760906,
					"content": "地上这几本书有标签呢，「孤品，仅售990000摩拉…」欸？！这么贵吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760907
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400760907,
					"content": "这边也有许多一看就很贵的精装书本…这就是占星术士的房间吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760908
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400760908,
					"content": "房间布设得十分精巧…这里一定不便宜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760909,
						400760910
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400760909,
					"content": "莫娜，原来这么有钱吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400760911
					]
				},
				{
					"id": 400760911,
					"content": "我说，我只是偶尔没有现金而已，又不真是穷光蛋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760912
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400760912,
					"content": "你不是吗？我还请你吃过饭，甚至带你去我家吃饭！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760913
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400760913,
					"content": "小姐，措辞，措辞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760914
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 400760914,
					"content": "啊咳咳！汝蒙受圣恩，随本皇女进入幽夜净土王城中拜谒断罪之皇帝皇后，如此大事，汝竟敢忘却？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760915
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400760915,
					"content": "啊对，你妈妈做的炖肉和冷盘肉可好吃了！嗯，突然好想再吃一次…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760916
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400760916,
					"content": "梅姬斯图斯卿，现在不是说这个的时候！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760917
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 400760917,
					"content": "是蒙德菜吗？我也想吃！听说蒙德有很多美食，尤其是肉菜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760918
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400760918,
					"content": "哼哼，那也赐汝荣光，下回，尔等可随本皇女一同面见父皇母后。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760919
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400760919,
					"content": "#真的？喂{NICKNAME}，我们也去吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760920
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400760920,
					"content": "这么说来，好久没去朋友家串门，我也恭敬不如从命了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760921
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400760921,
					"content": "唔，是不是应该提前准备伴手礼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760922
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400760922,
					"content": "那二位为人随和亲切，并不计较这些。诸位随意便好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760923
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 400760923,
					"content": "去的话一定要吃那个冷盘肉，听说是她家的拿手好菜，非常美味！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760924
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400760924,
					"content": "比起这些，是否应该先解决眼前的谜题呢？其实，从进屋到现在，我都很介意那个摆件…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760925
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 400760925,
					"content": "啊，对哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400760910,
					"content": "一直以来是我有眼不识泰山…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400760911
					]
				}
			]
		},
		{
			"id": 4007613,
			"completionStepIds": [
				4007613
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007613",
							"2"
						],
						"stepId": 4007613,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"莫娜",
					"辛焱",
					"菲谢尔",
					"枫原万叶",
					"奥兹"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400761301,
					"content": "回到这里了呢。意思是，我们彻底离开幻境了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400761302,
					"content": "怪了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761303
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400761303,
					"content": "我的幻境里并没有那些关于愚人众和装置的线索…难道说，这些事与他们无关？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761304
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400761304,
					"content": "或者，这些与我们有关的幻境，本就不是「过程」，而是「结果」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761305
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400761305,
					"content": "呃，什么意思啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400761306,
					"content": "就是说，这些幻境并不是引导我们解开谜团的线索，而是单纯的结果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761307
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400761307,
					"content": "有人做了某些事，使这些幻境诞生。它是被动产物，自然就无法提示我们什么了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761308
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400761308,
					"content": "倒不如说，这些幻境只跟我们自己有关。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761309
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400761309,
					"content": "纯粹而自我的结晶…嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761310
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400761310,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761311
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400761311,
					"content": "各位，或许这件事应该回到原点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761312
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400761312,
					"content": "#最初登岛那天，我和{NICKNAME}一起调查了愚人众的营地。那里有台古怪的装置，旁边的愚人众神志不清。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761313
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400761313,
					"content": "是的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400761314
					]
				},
				{
					"id": 400761314,
					"content": "与我们交涉的研究员声称，这台装置只是他们愚人众的工业发明，并和我们约法三章，保证不会打扰我们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761315
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400761315,
					"content": "对对，那个戴帽子的胖子看起来像没睡醒一样，老说胡话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400761316,
					"content": "我在想，有没有可能，「陷入癫狂」和「产生幻境」是装置导致的两种不同结果？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761317
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400761317,
					"content": "而这一切，确实也跟那台损坏的装置有关。但产生区别的不是装置，而是受影响的人群。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761318
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400761318,
					"content": "……！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761319
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400761319,
					"content": "这么说来，梦与幻觉确实很难分辨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761320
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400761320,
					"content": "你的意思是，我们跟他们在某些地方不同，所以受影响的结果也不同？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761321
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400761321,
					"content": "对。而根据这几日观察，我认为…我们和那些人的区别在于，我们都拥有更为顽强坚定的意志。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761322
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400761322,
					"content": "…嗯，说得通。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761323
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400761323,
					"content": "意志坚定的人不会陷入疯狂，所以只是产生幻觉，至于容易被击溃的人，就没法留下那么稳定的幻境了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761324
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400761324,
					"content": "也就是说，我们应该即刻返回愚人众营地，摧毁那台装置。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761325
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400761325,
					"content": "不，比起「摧毁」，更应该「修复」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761326
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400761326,
					"content": "小姐的意思是，贸然摧毁不明装置或许会引发更严重的后果，不如先想办法修复。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761327
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 400761327,
					"content": "嗯，小心驶得万年船。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761328
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400761328,
					"content": "如果我猜得没错，那台装置很可能会对人脑产生影响，我们最好小心处理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761329
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400761329,
					"content": "那现在就过去吧！抓紧时间！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4007615,
			"completionStepIds": [
				4007615
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007615",
							"2"
						],
						"stepId": 4007615,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"菲谢尔",
					"奥兹",
					"莫娜",
					"枫原万叶",
					"辛焱"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400761501,
					"content": "如此辉煌的景色…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761502
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400761502,
					"content": "该说不愧是天才占星术士吗，梅姬斯图斯卿，您真是幽夜净土有史以来最好的大法师。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761503
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 400761503,
					"content": "谢谢，但幽夜净土一共才多少年历史啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761504
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400761504,
					"content": "…星如宝钻，月似珍珠。这是我见过最浩瀚的星空。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761505
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400761505,
					"content": "真漂亮…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761506
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400761506,
					"content": "能拥有这种幻境，莫娜心中一定也藏着宽阔无际的星海吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761507
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400761507,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761508
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400761508,
					"content": "莫娜，怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400761509
					]
				},
				{
					"id": 400761509,
					"content": "…我在想，这一定就是我们在仰望的事物了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761510
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400761510,
					"content": "这片星空非常美丽，甚至可以说，比我平时占卜看到的景象更绚烂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761511
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400761511,
					"content": "其中每一颗星，都处在正确的位置上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761512
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400761512,
					"content": "…这绝对是属于我的幻境，只有在这里，才能看到这样的奇观。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761513
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400761513,
					"content": "奇观？为什么这样说？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761514
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400761514,
					"content": "你们知道吗？提瓦特的星空非常奇妙，似乎隐藏了世间一切答案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761515
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400761515,
					"content": "「我失踪的儿子什么时候回来？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761516
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400761516,
					"content": "「那个人究竟爱不爱我？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761517
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400761517,
					"content": "「我能康复吗？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761518
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400761518,
					"content": "无论怎样的事，都会被记录在你命星的轨迹之中。而世界上那么多人里，有相当一部分人会偏离轨道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761519
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400761519,
					"content": "代表你的星走在轨道上，意味着你将获得健康、幸福与安宁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761520
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400761520,
					"content": "反过来说，如果你的星偏离了轨道，一切就会变得糟糕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761521
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400761521,
					"content": "所以，占卜结果中的星空，绝不会是这样。星星们时而迷路，时而坠落…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761522
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400761522,
					"content": "…我希望大家都能获得幸福，希望每个人都能走在轨道上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761523
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400761523,
					"content": "为此，我提供建议，说出真相。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761524
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400761524,
					"content": "我知道这些没用，人的命运都彰显在夜空中，我也只是其中之一，不可能改变什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761525
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400761525,
					"content": "即使如此…在占星术之外，在昭示真实的话语之外，我仍抱有一丝不切实际的幻想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761526
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400761526,
					"content": "人必须活在真实的道路之上，可是…就当我不自量力好了，我仍期盼并相信着「奇迹」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761527
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400761527,
					"content": "这片广袤的星海中，有着你、我、他，乃至所有人的星。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761528
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400761528,
					"content": "星与星需要多巧的概率才能相遇？这些相遇，是否就是命运中最为美妙的「奇迹」？…我不知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761529
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400761529,
					"content": "但提瓦特的星空里永远有你我的位置。哪怕占星术是绝对的理性…命运却是无常、残酷与浪漫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761530
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400761530,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761531
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400761531,
					"content": "莫娜，之前你似乎一直在思考…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400761532
					]
				},
				{
					"id": 400761532,
					"content": "现在你找到答案了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400761533
					]
				},
				{
					"id": 400761533,
					"content": "…我想，我知道那些星中藏着什么了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761534
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400761534,
					"content": "——「现在，我将抓住自己的命运。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莫娜"
				}
			]
		},
