			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"卢卡"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705020101,
					"content": "你好，想必你就是那位大名鼎鼎的旅行者吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020102,
						705020103
					],
					"speakerTitle": "卢卡"
				},
				{
					"id": 705020102,
					"content": "我就是。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020104
					]
				},
				{
					"id": 705020104,
					"content": "喂，还有我呢，我是大名鼎鼎的派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705020105,
					"content": "是这样的。最近「天使的馈赠」酒馆在举行「酒保体验周」的活动，我想你或许会感兴趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020106
					],
					"speakerTitle": "卢卡"
				},
				{
					"id": 705020106,
					"content": "简单来说，你可以亲自参与调酒…或者调别的什么，原料随便用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020107
					],
					"speakerTitle": "卢卡"
				},
				{
					"id": 705020107,
					"content": "只要不浪费，成品也供你们无限畅饮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020108
					],
					"speakerTitle": "卢卡"
				},
				{
					"id": 705020108,
					"content": "无限畅饮！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705020109,
					"content": "另外，如果能让顾客们满意，报酬肯定也不会少你们的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020110
					],
					"speakerTitle": "卢卡"
				},
				{
					"id": 705020110,
					"content": "哇，还有报酬！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705020111,
					"content": "派蒙彻底沦陷了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020112
					]
				},
				{
					"id": 705020112,
					"content": "我们参加吧！好不好？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705020113,
					"content": "虽说是「体验周」，其实对考勤没有要求…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020114
					],
					"speakerTitle": "卢卡"
				},
				{
					"id": 705020114,
					"content": "现在做不了决定也没关系，可以先来试一次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020115
					],
					"speakerTitle": "卢卡"
				},
				{
					"id": 705020115,
					"content": "怎么样，你意下如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卢卡"
				},
				{
					"id": 705020103,
					"content": "有什么事吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020104
					]
				}
			]
		},
		{
			"id": 7050202,
			"completionStepIds": [
				7050203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
