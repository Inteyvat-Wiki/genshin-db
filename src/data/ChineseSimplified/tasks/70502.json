			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"查尔斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705020201,
					"content": "没想到是老面孔，今天想喝点儿什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020202
					],
					"speakerTitle": "查尔斯"
				},
				{
					"id": 705020202,
					"content": "你好，查尔斯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020203
					]
				},
				{
					"id": 705020203,
					"content": "查尔斯，我们是来当酒保的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705020204,
					"content": "当酒保…啊，原来卢卡招揽到了你们吗，他运气真够好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020205
					],
					"speakerTitle": "查尔斯"
				},
				{
					"id": 705020205,
					"content": "#{NICKNAME}，我很信任你处理问题的能力，不过，调酒毕竟是个技术活，希望你不要掉以轻心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020206
					],
					"speakerTitle": "查尔斯"
				},
				{
					"id": 705020206,
					"content": "原料的配比，混合的手法…都会影响出品的质量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020207
					],
					"speakerTitle": "查尔斯"
				},
				{
					"id": 705020207,
					"content": "#没事，{M#他}{F#她}做的菜可好吃了，美食的原理是相通的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705020208,
					"content": "好，还有一件事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020209
					],
					"speakerTitle": "查尔斯"
				},
				{
					"id": 705020209,
					"content": "之前活动中有位实习生，凭自己的理解混合了三种烈酒，结果一杯就灌倒了客人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020210
					],
					"speakerTitle": "查尔斯"
				},
				{
					"id": 705020210,
					"content": "从那之后，我们就不敢再向新人提供含酒精的材料了，这点请你见谅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020211
					],
					"speakerTitle": "查尔斯"
				},
				{
					"id": 705020211,
					"content": "能够理解。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020212
					]
				},
				{
					"id": 705020212,
					"content": "好，那就全部交待完了。手法和技巧，就在实际调制过程中教你吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "查尔斯"
				}
			]
		},
		{
			"id": 7050203,
			"completionStepIds": [
				7050205
			],
