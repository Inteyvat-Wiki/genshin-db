			},
			"dialogs": [
				{
					"id": 705020301,
					"content": "你学得很快，味道也确实不错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020302
					],
					"speakerTitle": "查尔斯"
				},
				{
					"id": 705020302,
					"content": "嗯嗯，我也觉得好喝！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705020303,
					"content": "刚才只是情景模拟。实际上，顾客可能也会有一些个性化点单。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020304
					],
					"speakerTitle": "查尔斯"
				},
				{
					"id": 705020304,
					"content": "浓一点、酸一点，诸如此类。你只需要将对应口味的辅料加量就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020305
					],
					"speakerTitle": "查尔斯"
				},
				{
					"id": 705020305,
					"content": "我想要一杯焦糖松果，甜一点，最大的杯子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705020306,
					"content": "差不多就类似这样。但对一个优秀的酒保来说，除了具备调制技术，还需要掌握和客人聊天的技巧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020307,
						705020308
					],
					"speakerTitle": "查尔斯"
				},
				{
					"id": 705020307,
					"content": "交给我吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020309
					]
				},
				{
					"id": 705020309,
					"content": "那好，这吧台的位置就交给你们了。遇到问题或者有什么需要，可以随时找我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020310
					],
					"speakerTitle": "查尔斯"
				},
				{
					"id": 705020310,
					"content": "呼…终于学完了！不对…我的焦糖松果呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705020311,
					"content": "原来你真的在点单…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 705020308,
					"content": "我很会聊天。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020309
					]
				}
			]
		},
