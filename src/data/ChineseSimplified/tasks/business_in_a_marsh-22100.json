			},
			"dialogs": [
				{
					"id": 221000201,
					"content": "怎么样？周围的怪物都清干净了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000202
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221000202,
					"content": "还没有。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221000203
					]
				},
				{
					"id": 221000203,
					"content": "倒也不用太着急，那些怪物也只是在外围游荡，近前是不敢近前的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000204
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221000204,
					"content": "不过，要是哪个不长眼的怪物脚底打了个溜，碍了那位小爷的清净…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000205
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221000205,
					"content": "不说荻花洲会不会再被折腾个底朝天，就说我这客栈，怕又要好几天不能开业了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "淮安"
				}
			]
		},
