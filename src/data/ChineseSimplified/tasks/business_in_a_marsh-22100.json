			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"淮安"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221000101,
					"content": "唉，这可怎么办…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000102
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221000102,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221000103
					]
				},
				{
					"id": 221000103,
					"content": "唉，在这里开个客栈可不容易…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000104
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221000104,
					"content": "这荻花洲上，荻花多，宝贝多，怪物更多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000105
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221000105,
					"content": "还好托了千岩军的福，周围的怪物都差不多被清理干净了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000106
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221000106,
					"content": "但是不知道最近怎么了，那些怪物又莫名其妙地钻出来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000107
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221000107,
					"content": "虽然它们绝对不敢到客栈近前，但是每天看着这些家伙，不说客人，连我都觉得碍眼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000108
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221000108,
					"content": "如果您有空的话，能帮我去周围看看，把客栈旁边的怪物给清一清吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000109,
						221000110
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221000109,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221000111
					]
				},
				{
					"id": 221000111,
					"content": "哈哈，您说话做事真是爽利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000114
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221000114,
					"content": "对了，让客人替我忙碌，实在是有些不好意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000115
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221000115,
					"content": "事结之后，报酬我绝不会少您一分的，请客人放心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000116
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221000116,
					"content": "那么，就万事拜托了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "淮安"
				},
				{
					"id": 221000110,
					"content": "只是碍眼吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221000112
					]
				},
				{
					"id": 221000112,
					"content": "您看您说的，碍眼就是那些个怪物最烦人的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000113
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221000113,
					"content": "唉，特别是那位爱清净的小爷，他要觉得烦，那整个荻花洲，怕是都要跟着他一起烦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000114
					],
					"speakerTitle": "淮安"
				}
			]
		},
		{
