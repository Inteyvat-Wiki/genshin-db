			"dialogs": [
				{
					"id": 221000301,
					"content": "怎么样？周围的怪物都清干净了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000302
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221000302,
					"content": "已经清干净了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221000303
					]
				},
				{
					"id": 221000303,
					"content": "那就好，辛苦您了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000304
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221000304,
					"content": "这是说好的报酬，您拿好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000305
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221000305,
					"content": "这下子，肯定能消停一段时间了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000306
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221000306,
					"content": "那位小爷是谁？嗯…您还是去问老板吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "淮安"
				}
			]
		}
