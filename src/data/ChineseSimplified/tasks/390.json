			"dialogs": [
				{
					"id": 3900401,
					"content": "看来我们破除机关的方式是正确的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3900402
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3900402,
					"content": "现在这座塔里，还有三层护封的辉环…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3900403
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3900403,
					"content": "也就是说，还要寻找三座<color=#00E1FFFF>「导光机关」</color>，才能解开所有封印。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3900404
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3900404,
					"content": "看，从这里就能看到一座…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3900405
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3900405,
					"content": "剩下的也一定都在废墟内部，围绕这座高塔分布。找找看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3900406
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3900406,
					"content": "…住在这种又是机关又是封印的地方，特瓦林平时回家不嫌麻烦吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3900407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3900407,
					"content": "它不用从走人的地方走啊，它用飞的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3900408
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3900408,
					"content": "…你，说得很有道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
