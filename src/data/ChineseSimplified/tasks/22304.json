			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"张顺"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223040101,
					"content": "这可怎么办…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040102
					],
					"speakerTitle": "张顺"
				},
				{
					"id": 223040102,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223040103
					]
				},
				{
					"id": 223040103,
					"content": "我之前是南十字船队的水手，但是有次运气不好，受了伤…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040104
					],
					"speakerTitle": "张顺"
				},
				{
					"id": 223040104,
					"content": "退出船队之后，为了筹钱生活，我把几张藏宝图押给了一个叫博来的生意人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040105
					],
					"speakerTitle": "张顺"
				},
				{
					"id": 223040105,
					"content": "如果真有宝藏，他也会匀我一份，但是一直没什么消息，我觉得他压根没有去找…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040106
					],
					"speakerTitle": "张顺"
				},
				{
					"id": 223040106,
					"content": "老是这样也不是个办法，你愿意帮我去找找宝藏吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040107,
						223040109,
						223040116
					],
					"speakerTitle": "张顺"
				},
				{
					"id": 223040107,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223040108
					]
				},
				{
					"id": 223040108,
					"content": "那就拜托你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040120
					],
					"speakerTitle": "张顺"
				},
				{
					"id": 223040120,
					"content": "你先去<color=#00E1FFFF>博来</color>那拿<color=#00E1FFFF>藏宝图</color>吧，然后把<color=#00E1FFFF>宝藏</color>直接带回去<color=#00E1FFFF>给他</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040121
					],
					"speakerTitle": "张顺"
				},
				{
					"id": 223040121,
					"content": "我已经和他说好了，他会把我的那一份留着的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "张顺"
				},
				{
					"id": 223040109,
					"content": "为什么退出船队？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223040110
					]
				},
				{
					"id": 223040110,
					"content": "我这个身子的情况我自己知道，随时可能旧伤复发，我可不想拖累船队，就自己退出了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040111
					],
					"speakerTitle": "张顺"
				},
				{
					"id": 223040111,
					"content": "然后，我用自己之前搜集的一些零碎，在这里做点小生意谋生。但是这生意也不好做啊，东西也快卖光了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040112
					],
					"speakerTitle": "张顺"
				},
				{
					"id": 223040112,
					"content": "我本来还有几张藏宝图，也是之前跟船的时候拿到的战利品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040113
					],
					"speakerTitle": "张顺"
				},
				{
					"id": 223040113,
					"content": "但是我这个破身子，走路都费劲，哪里还能去探险呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040114
					],
					"speakerTitle": "张顺"
				},
				{
					"id": 223040114,
					"content": "我就把那几张藏宝图押给了那个叫博来的，换了几个钱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040115
					],
					"speakerTitle": "张顺"
				},
				{
					"id": 223040115,
					"content": "不过他大概也没办法亲自去寻宝吧，毕竟也就是个普通商人…所以，宝藏的事就拜托你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040107,
						223040116
					],
					"speakerTitle": "张顺"
				},
				{
					"id": 223040116,
					"content": "真有大宝藏吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223040117
					]
				},
				{
					"id": 223040117,
					"content": "哈哈哈，这应该是不可能的，这些藏宝图也是船队里分发的战利品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040118
					],
					"speakerTitle": "张顺"
				},
				{
					"id": 223040118,
					"content": "要真有大宝藏，船队里的好手早就解开线索，把宝藏拿回船了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040119
					],
					"speakerTitle": "张顺"
				},
				{
					"id": 223040119,
					"content": "但是，就算不是大宝藏，应该也多少能值点钱，至少三个人匀是够了…所以，宝藏就拜托你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040120
					],
					"speakerTitle": "张顺"
				}
			]
		},
