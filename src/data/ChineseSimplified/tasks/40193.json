							-12.211
						],
						"pointId": 3
					}
				]
			},
			"dialogs": [
				{
					"id": 401930201,
					"content": "在一斗的连番催促下，众人再次前往秋沙钱汤…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401930202
					]
				},
				{
					"id": 401930202,
					"content": "哈哈哈！这里应该就是最热的了！今天我们就来比一比，谁能在温泉里坚持最久！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930203
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 401930203,
					"content": "呵呵，一斗兄如此盛情，我又怎么能不奉陪呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930204
					],
					"speakerTitle": "托马"
				},
				{
					"id": 401930204,
					"content": "我说…这又不是在蒸桑拿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930205
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 401930205,
					"content": "温泉…好暖和…呼呼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930206
					],
					"speakerTitle": "早柚"
				},
				{
					"id": 401930206,
					"content": "不、不要在浴池里睡着啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401930207,
					"content": "唔…毛皮变得好重，感觉有点头晕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930208
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 401930208,
					"content": "哈哈哈！五郎兄弟！可别说这就不行了啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930209
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 401930209,
					"content": "喂——浴场内禁止喧哗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930210
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 401930210,
					"content": "与此同时，在另一边…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401930211
					]
				},
				{
					"id": 401930211,
					"content": "呵呵，一斗兄弟还是那么有精神啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930212
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 401930212,
					"content": "兄长，对局中分神可不好哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930213
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 401930213,
					"content": "#嚯嚯——比赛已经来到了最焦灼的阶段！{NICKNAME}会怎么应对呢！两位大师！你们有什么看法？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930214
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 401930214,
					"content": "嗯…如果是我的话，会考虑步步为营，巩固优势。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930215
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 401930215,
					"content": "唔，积极进攻，险中求胜…也是一个好办法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930216,
						401930217
					],
					"speakerTitle": "鹿野院平藏"
				},
				{
					"id": 401930216,
					"content": "（稳扎稳打…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401930218
					]
				},
				{
					"id": 401930218,
					"content": "哦？竟有如此妙手？看来我败局已定，不必继续了。那按照之前抽签的顺序，接下来就该轮到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930219
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 401930219,
					"content": "绫华，要玩得开心哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930220
					],
					"speakerTitle": "神里绫人"
				},
				{
					"id": 401930220,
					"content": "#啊…好！好的！{NICKNAME}，请多指教…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930221
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 401930221,
					"content": "（绫人这家伙，怕不是想让绫华多玩一会儿故意输的吧…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 401930217,
					"content": "（搏上一把！）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401930218
					]
				}
			]
		},
