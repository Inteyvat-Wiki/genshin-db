					}
				]
			},
			"dialogs": [
				{
					"id": 401930101,
					"content": "哦！挚友，听说你们昨晚去了「秋沙钱汤」对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930102
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 401930102,
					"content": "我打算叫上所有人，再去「秋沙钱汤」好好地庆上一回功！怎么样？你也去吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930103
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 401930103,
					"content": "欸，可是昨晚不是已经去过一次了吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401930104,
					"content": "呃…你看这不是还有昨晚没去成的吗？比如阿忍…五郎…还有绫人兄弟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930105
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 401930105,
					"content": "简单来说，是老大听说过后，自己很想去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930106
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 401930106,
					"content": "总…总之！你要是逛得差不多了，就来跟我说一声，大家一起去泡！温！泉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "荒泷一斗"
				}
			]
		},
		{
			"id": 4019302,
			"completionStepIds": [
				4019302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
