				]
			},
			"dialogs": [
				{
					"id": 250310101,
					"content": "糟糕了…这下可糟糕了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310102
					],
					"speakerTitle": "塔莫蕾"
				},
				{
					"id": 250310102,
					"content": "阿蕾梅的训练出问题了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310103
					]
				},
				{
					"id": 250310103,
					"content": "#{NICKNAME}！你来得正好，谢天谢地…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310104
					],
					"speakerTitle": "塔莫蕾"
				},
				{
					"id": 250310104,
					"content": "没时间解释了，请你快帮我去救救人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310105,
						250310106
					],
					"speakerTitle": "塔莫蕾"
				},
				{
					"id": 250310105,
					"content": "是你的朋友？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310107
					]
				},
				{
					"id": 250310107,
					"content": "算…算是吧。我们俩都因为论文崩溃过好几轮，还在图书馆里抱头痛哭过…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310108
					],
					"speakerTitle": "塔莫蕾"
				},
				{
					"id": 250310108,
					"content": "啊啊啊——现在不是说这些的时候！那家伙根本不听我的劝！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310109
					],
					"speakerTitle": "塔莫蕾"
				},
				{
					"id": 250310109,
					"content": "说什么为了论文在所不惜，然后带着她的那个护卫，成天在野外乱逛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310110
					],
					"speakerTitle": "塔莫蕾"
				},
				{
					"id": 250310110,
					"content": "结果她到现在都没有回来！部族这边也抽不出人手去救人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310111
					],
					"speakerTitle": "塔莫蕾"
				},
				{
					"id": 250310111,
					"content": "#{NICKNAME}，请你快去救救她！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310112,
						250310113
					],
					"speakerTitle": "塔莫蕾"
				},
				{
					"id": 250310112,
					"content": "交给我吧，我做这个很熟练。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310115
					]
				},
				{
					"id": 250310115,
					"content": "#这件事只能拜托你了！全都靠你了，{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "塔莫蕾"
				},
				{
					"id": 250310113,
					"content": "你们教令院的人真的是啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310114
					]
				},
				{
					"id": 250310114,
					"content": "那家伙…唉，只能说她的运气真是差到头了。这次来纳塔，她还说什么要为论文做最后一搏…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310115
					],
					"speakerTitle": "塔莫蕾"
				},
				{
					"id": 250310106,
					"content": "是你的熟人？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310107
					]
				}
			]
		},
