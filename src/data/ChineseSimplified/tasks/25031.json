			},
			"dialogs": [
				{
					"id": 250310401,
					"content": "谢谢你，谢谢你帮忙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310402
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 250310402,
					"content": "要是能把那个破包早点丢开，我一个人就能解决他们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310403
					],
					"speakerTitle": "娜赞"
				},
				{
					"id": 250310403,
					"content": "那我们来纳塔就白来了！我才不要嘞！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310404
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 250310404,
					"content": "等等，你是…爱拉尼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310405
					]
				},
				{
					"id": 250310405,
					"content": "#欸？你…你是{NICKNAME}！真的是你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310406
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 250310406,
					"content": "旁边这位小姐，难道是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310407
					]
				},
				{
					"id": 250310407,
					"content": "娜赞。盗宝团。我们应该见过，你忘记了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310408
					],
					"speakerTitle": "娜赞"
				},
				{
					"id": 250310408,
					"content": "呼啊…你真是我的大救星，救了我多少次了？一次，两次…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310409
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 250310409,
					"content": "别算我那次。那次是你自己不想走的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310410
					],
					"speakerTitle": "娜赞"
				},
				{
					"id": 250310410,
					"content": "我才没算那次呢，而且什么叫我自己不想走，我都付过钱给你啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310411
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 250310411,
					"content": "你那么一点钱，随便吃吃喝喝就花光了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310412
					],
					"speakerTitle": "娜赞"
				},
				{
					"id": 250310412,
					"content": "你不会又是为了论文来的吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310413
					]
				},
				{
					"id": 250310413,
					"content": "嘿嘿…我都努力那么久了，总不能白费吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310414
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 250310414,
					"content": "这次我可是从教令院里申请了专门的经费，课题也确认好了，没有人和我冲撞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310415
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 250310415,
					"content": "而且，我还有娜赞给我做护卫，坏蛋全都给她打跑啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310416
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 250310416,
					"content": "是因为我们没油水可捞，他们也不愿意惹麻烦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310417,
						250310418
					],
					"speakerTitle": "娜赞"
				},
				{
					"id": 250310417,
					"content": "那你们刚才…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310419
					]
				},
				{
					"id": 250310419,
					"content": "…这家伙把自己装文献的包捂得死紧，从「回声之子」那边一直走到这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310420
					],
					"speakerTitle": "娜赞"
				},
				{
					"id": 250310420,
					"content": "说实话，就算是以我的眼光来看，她也像是一个怀里捂着宝贝的笨蛋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310421
					],
					"speakerTitle": "娜赞"
				},
				{
					"id": 250310421,
					"content": "一个捂着宝贝的人，走在这种前后都无人的荒郊野外，旁边只有一个护卫…无论是谁都会想要搏一把。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310422
					],
					"speakerTitle": "娜赞"
				},
				{
					"id": 250310422,
					"content": "没错！我的包里就是宝贝。这些可都是我的实地采访记录，还有各类文献的抄本。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310423
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 250310423,
					"content": "有了它们，我的那篇论文一定能够写出来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310424
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 250310424,
					"content": "哼，这篇论文的主题可是「归火圣夜巡礼」。绝对的重量级，肯定足够我毕业了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310425
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 250310425,
					"content": "哎呀，也多亏了塔莫蕾给我出的主意。真不愧是我的好朋友，嘿嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310426
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 250310426,
					"content": "#再次谢谢你啦，{NICKNAME}，要是没有你，那些坏蛋不仅会弄坏我的书，还会抢走我的钱！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310427
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 250310427,
					"content": "前段时间我帮人家整理书籍和规整资料，好不容易才挣了一些钱，被抢走的话，就没钱买新的资料了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310428
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 250310428,
					"content": "嗯，但你最终还是会把所有钱都用来买书。如果不是我把你的钱包拿走，我们就要饿肚子了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310429
					],
					"speakerTitle": "娜赞"
				},
				{
					"id": 250310429,
					"content": "也，也没有买那么多啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310430
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 250310430,
					"content": "哎呀，先不聊了。我们还要去「流泉之众」那边取材呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310431
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 250310431,
					"content": "那就再见啦！等下次见面的时候我的论文肯定完成了！到时候我一定请你吃一顿好吃的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 250310418,
					"content": "结果还是惹上麻烦了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310419
					]
				}
			]
		},
