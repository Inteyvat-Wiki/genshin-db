			"dialogs": [
				{
					"id": 761860101,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860102
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 761860102,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860103
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761860103,
					"content": "…「霜月之子」，最近还好吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860104
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761860104,
					"content": "还不错。月神的回归，也让我们坚定了自己应走的道路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860105
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 761860105,
					"content": "是吗？那就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860106
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761860106,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860107
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761860107,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860108
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 761860108,
					"content": "哈…果然我们之间还是聊不了什么吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860109
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761860109,
					"content": "这…恐怕是因为「霜月之子」与「愚人众」之间，有过太多不愉快的过往了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860110
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 761860110,
					"content": "从我个人的角度来说，自然是感激桑多涅小姐你在保护挪德卡莱和迎回月神上的付出。但对其他人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860111
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 761860111,
					"content": "我懂。曾经的种种原因，让我们没能建立良好的友谊，哪怕是互利关系也没有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860112
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761860112,
					"content": "可现在「愚人众」不再从「霜月之子」手中渴求什么了，我也提醒过自己的部下不要对「霜月之子」有所刁难。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860113
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761860113,
					"content": "从我个人的角度来说，既然大家都是邻居，就算做不到和谐共处，也还是以互相尊重的态度交往为好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860114
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761860114,
					"content": "这恐怕需要时间…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860115
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 761860115,
					"content": "当然。但不如从一次次尝试开始吧。尝尝我泡的香草茶？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860116
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761860116,
					"content": "香草茶？哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860117
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 761860117,
					"content": "嗯…居然能做到如此醇厚，是「霜月之子」的泡法？我记得外面的人不喜欢这种喝法，你是怎么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860118
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 761860118,
					"content": "学习。还有尊重。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860119
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761860119,
					"content": "哈…看来，这的确是一次不错的尝试。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860120
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 761860120,
					"content": "希望合你口味。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860121
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761860121,
					"content": "嗯，我很喜欢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860122
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 761860122,
					"content": "茶饮间的礼尚往来，向来都是邻居间友好相处的良好开端。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860123
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 761860123,
					"content": "我想，这次也不例外呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菈乌玛"
				}
			]
		},
