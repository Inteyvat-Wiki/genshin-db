			"dialogs": [
				{
					"id": 761860201,
					"content": "十分美味的香草茶，桑多涅小姐。我从中感受到了你的用心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860202,
						761860203
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 761860202,
					"content": "（再这么坐一会儿吧。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860204
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761860204,
					"content": "好。下次就换我邀请你来「霜月之子」品茶吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 761860203,
					"content": "茶会时间该结束了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860204
					],
					"speakerTitle": "「木偶」"
				}
			]
