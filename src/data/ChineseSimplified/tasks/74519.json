				"points": []
			},
			"dialogs": [
				{
					"id": 745190401,
					"content": "啊…前辈好！是来找琴团长的吗？还是说…有什么需要我帮忙的地方？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190402,
						745190403
					],
					"speakerTitle": "诺艾尔"
				},
				{
					"id": 745190402,
					"content": "我只是在四处逛逛。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190404
					]
				},
				{
					"id": 745190404,
					"content": "我正在对骑士团的办公区域进行例行大扫除。目前灰尘已经基本清理完成，接下来就是整理旧档案了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190405
					],
					"speakerTitle": "诺艾尔"
				},
				{
					"id": 745190405,
					"content": "那些文件堆积了很久，我想如果能把它们分门别类地归档，大家以后查阅起来就会方便很多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190406
					],
					"speakerTitle": "诺艾尔"
				},
				{
					"id": 745190406,
					"content": "而且，整理前人的记录，也能学到很多东西。对我来说，这也是一种修行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190407
					],
					"speakerTitle": "诺艾尔"
				},
				{
					"id": 745190407,
					"content": "诺艾尔还是这么认真可靠啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190408
					]
				},
				{
					"id": 745190408,
					"content": "这是我应尽的职责。而且，前辈和骑士团的大家都在不断前进，我也想尽快追上你们的步伐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190409,
						745190410
					],
					"speakerTitle": "诺艾尔"
				},
				{
					"id": 745190409,
					"content": "那么为了纪念这份决心…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190411
					]
				},
				{
					"id": 745190411,
					"content": "欸？前辈要拍画片？我…当然非常乐意！但是我刚刚才结束扫除，身上还沾着灰尘…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190412,
						745190413
					],
					"speakerTitle": "诺艾尔"
				},
				{
					"id": 745190412,
					"content": "我想拍的就是诺艾尔努力的样子！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190414
					]
				},
				{
					"id": 745190414,
					"content": "这、这个称呼还是太早了！不过，既然是前辈想拍…那就算带着灰尘，我也觉得很荣幸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190415
					],
					"speakerTitle": "诺艾尔"
				},
				{
					"id": 745190415,
					"content": "那就请在前辈认为最合适的时机按下快门吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "诺艾尔"
				},
				{
					"id": 745190413,
					"content": "这是女仆骑士的「决定性瞬间」！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190414
					]
				},
				{
					"id": 745190410,
					"content": "我来帮你拍张画片吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190411
					]
				},
				{
					"id": 745190403,
					"content": "诺艾尔又在忙什么呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190404
					]
				}
			]
		}
	]
