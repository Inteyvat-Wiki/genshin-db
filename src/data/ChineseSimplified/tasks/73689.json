	],
	"talks": [
		{
			"id": 7368901,
			"completionStepIds": [
				7368901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7368901",
							"2"
						],
						"stepId": 7368901,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿纳托尔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736890101,
					"content": "唉，完全不具备复现实验的条件。帕特里克啊，不是我不想帮你，这次你就自求多福吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890102
					],
					"speakerTitle": "阿纳托尔"
				},
				{
					"id": 736890102,
					"content": "我是没什么办法了，还不如想想能去哪里吃点好的。对，腌笃鲜，去吃腌笃鲜吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890103
					],
					"speakerTitle": "阿纳托尔"
				},
				{
					"id": 736890103,
					"content": "哇，那能吃腌笃鲜的地方离这里可远了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736890104,
					"content": "说的也是啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890105
					],
					"speakerTitle": "阿纳托尔"
				},
				{
					"id": 736890105,
					"content": "呜哇，你们是谁，怎么会出现在这种人迹罕至的地方…有点可疑哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890106
					],
					"speakerTitle": "阿纳托尔"
				},
				{
					"id": 736890106,
					"content": "啊，真的那么可疑吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890107,
						736890108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736890107,
					"content": "对啊，派蒙，你怎么出现在这！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736890109
					]
				},
				{
					"id": 736890109,
					"content": "唔，明明我和你一起的啦，怎么连你也这样！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736890110,
					"content": "好生气，让我想想怎么反驳…哦对了，我们出现在这儿很可疑，你这个枫丹的家伙出现在这儿不是也很可疑嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736890111,
					"content": "…真的吗？在其他人眼里我真的很可疑吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890112
					],
					"speakerTitle": "阿纳托尔"
				},
				{
					"id": 736890112,
					"content": "毕竟是枫丹人…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736890113
					]
				},
				{
					"id": 736890113,
					"content": "#是啊是啊，我和{NICKNAME}四处冒险，出现在这儿…也算正常，你这个枫丹人出现在这儿，比我们奇怪多了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736890114,
					"content": "#这倒也是啦…嗯，四处冒险的{NICKNAME}，你的名字是{NICKNAME}，那你呢，会飞的小家伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890115
					],
					"speakerTitle": "阿纳托尔"
				},
				{
					"id": 736890115,
					"content": "我的名字是派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736890116,
					"content": "嗯，那我也做个自我介绍好了，我是枫丹科学院的工程师，我的名字叫阿纳托尔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890117
					],
					"speakerTitle": "阿纳托尔"
				},
				{
					"id": 736890117,
					"content": "实不相瞒，其实我之所以会从枫丹远道而来，其实也是枫丹科学院大人们的意思，就是为了研究…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890118
					],
					"speakerTitle": "阿纳托尔"
				},
				{
					"id": 736890118,
					"content": "研究璃月美食！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736890119,
					"content": "璃月美食，嘿嘿…啊不对，科学院其实是负责研究机械与能源的机构，不过，说得好啊，真希望有研究美食的部门…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890120
					],
					"speakerTitle": "阿纳托尔"
				},
				{
					"id": 736890120,
					"content": "说远了，其实事情是这样的，有一位与我同期进入枫丹科学院的同僚，一直在研究矿石和元素力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890121
					],
					"speakerTitle": "阿纳托尔"
				},
				{
					"id": 736890121,
					"content": "对了，你们如果经常在附近活动的话说不定也见过他，他的名字叫帕特里克，你们有印象吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890122,
						736890125
					],
					"speakerTitle": "阿纳托尔"
				},
				{
					"id": 736890122,
					"content": "没有什么印象…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736890123
					]
				},
				{
					"id": 736890123,
					"content": "确实不太记得了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736890124,
					"content": "唉，帕特里克…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890128
					],
					"speakerTitle": "阿纳托尔"
				},
				{
					"id": 736890128,
					"content": "按照他的研究思路，需要很大批量且特定种类的璃月矿石，但是嘛，因为预算和实验场地的经费和一些众所周知的原因…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890129
					],
					"speakerTitle": "阿纳托尔"
				},
				{
					"id": 736890129,
					"content": "没有办法进行实验吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736890130,
					"content": "对…结果有一天，他突然带着剩余的实验经费和实验器材消失了，大家都说一定是他终于受不了枫丹科学院卷款跑走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890131
					],
					"speakerTitle": "阿纳托尔"
				},
				{
					"id": 736890131,
					"content": "我得说明啊，我一直相信他能够完成自己的研究，可没有在背后腹诽他，跟那些总说闲言碎语的家伙不一样，咳咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890132
					],
					"speakerTitle": "阿纳托尔"
				},
				{
					"id": 736890132,
					"content": "总之，就在前段时间，他不仅活着回了枫丹科学院，还带来了课题实验结果，哎，真是令人感动的科研精神。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890133
					],
					"speakerTitle": "阿纳托尔"
				},
				{
					"id": 736890133,
					"content": "据他自己说，他直接到了璃月，就地布置实验…克服了许多难以想象的困难，最终完成了自己的课题！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890134
					],
					"speakerTitle": "阿纳托尔"
				},
				{
					"id": 736890134,
					"content": "哇，那不是很好嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890135,
						736890137
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736890135,
					"content": "是啊，听上去结果不错。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736890136
					]
				},
				{
					"id": 736890136,
					"content": "事情到这儿可以说是一个足以鼓舞后辈的励志故事，不过…唉，很多事就是怕这个不过…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890139
					],
					"speakerTitle": "阿纳托尔"
				},
				{
					"id": 736890139,
					"content": "毕竟他跑到这里进行实验本身其实就是违规行为…其实也能理解，如果按正常流程，各种繁杂的申请表和说明就要填半个月。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890140
					],
					"speakerTitle": "阿纳托尔"
				},
				{
					"id": 736890140,
					"content": "当然了，实验过程无人复核，他拿出的数据又过于详实…按照审核文件的说法：「详实得和编出来的一样呢…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890141
					],
					"speakerTitle": "阿纳托尔"
				},
				{
					"id": 736890141,
					"content": "虽然帕特里克一再申明，这些数据之所以如此详实，是由于当地冒险家协会对实验的鼎力协助…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890142
					],
					"speakerTitle": "阿纳托尔"
				},
				{
					"id": 736890142,
					"content": "不过上面的人可不会相信这些说辞，所以按照流程，就得有人再次进行重复实验，以验证他求得的数据…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890143
					],
					"speakerTitle": "阿纳托尔"
				},
				{
					"id": 736890143,
					"content": "唔…那也就是说，为了重复实验，就必须找个倒霉蛋从枫丹跑到这里，再做一遍帕特里克做的事情咯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890144
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736890144,
					"content": "这个倒霉蛋是谁呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890145
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736890145,
					"content": "是啊，这个倒霉蛋是谁呢，哈哈，这个倒霉蛋就是我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890146
					],
					"speakerTitle": "阿纳托尔"
				},
				{
					"id": 736890146,
					"content": "帕特里克是个好人，所以我也想帮他进行验证…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890147
					],
					"speakerTitle": "阿纳托尔"
				},
				{
					"id": 736890147,
					"content": "不过真的到了这里才发现，虽然符合要求的矿石好找，但一个人要完成实验，根本不可能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890148
					],
					"speakerTitle": "阿纳托尔"
				},
				{
					"id": 736890148,
					"content": "怎么这样啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890149
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736890149,
					"content": "帕特里克一个人进行实验，所以我也得一个人进行实验，大概是这样的想法吧…啊呀，这该死的机构，活该被炸上天…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890150
					],
					"speakerTitle": "阿纳托尔"
				},
				{
					"id": 736890150,
					"content": "炸…炸上天？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736890151
					]
				},
				{
					"id": 736890151,
					"content": "咳咳，枫丹科学院因为以前一场相当惨烈的实验失控，曾经狠狠爆炸过一次，但那又怎么样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890152
					],
					"speakerTitle": "阿纳托尔"
				},
				{
					"id": 736890152,
					"content": "冗余奇怪的流程和过度复杂的管理系统，没在爆炸里消失，到现在反而更加「精益求精」了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890153
					],
					"speakerTitle": "阿纳托尔"
				},
				{
					"id": 736890153,
					"content": "唉…数据验证的实验是别想了。申报的经费不用掉，也只不过是徒劳缩减明年的预算，不如就去璃月好好吃上一顿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890154
					],
					"speakerTitle": "阿纳托尔"
				},
				{
					"id": 736890154,
					"content": "怪不得你之前在说什么腌笃鲜什么的，原来是这样…唔，可是这样的话，帕特里克怎么办呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890155
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736890155,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890156
					],
					"speakerTitle": "阿纳托尔"
				},
				{
					"id": 736890156,
					"content": "#如果没碰上你们，我估计就放弃了，但是，四处冒险的{NICKNAME}…还有派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890157
					],
					"speakerTitle": "阿纳托尔"
				},
				{
					"id": 736890157,
					"content": "能不能帮我，帮我完成这场验证实验，看得出来，你们绝对有这样的实力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890158
					],
					"speakerTitle": "阿纳托尔"
				},
				{
					"id": 736890158,
					"content": "报酬的话，去掉来往的开销，经费大概还剩下三成…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890159
					],
					"speakerTitle": "阿纳托尔"
				},
				{
					"id": 736890159,
					"content": "#倒不是因为经费啦，{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890160,
						736890162
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736890160,
					"content": "好吧好吧，都是为了帕特里克！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736890161
					]
				},
				{
					"id": 736890161,
					"content": "我就知道你会答应的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890164
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736890164,
					"content": "那还真是感谢二位了。呼…那我接下来说明实验的内容。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890165
					],
					"speakerTitle": "阿纳托尔"
				},
				{
					"id": 736890165,
					"content": "依帕特里克留下来的记录可以知道，存在一种名为「振晶」的矿石。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890166
					],
					"speakerTitle": "阿纳托尔"
				},
				{
					"id": 736890166,
					"content": "「振晶」中的「响振晶」受到特定的刺激后，可以放出能量，激发「应振晶」的共鸣，两者之间存在着「映射关系」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890167
					],
					"speakerTitle": "阿纳托尔"
				},
				{
					"id": 736890167,
