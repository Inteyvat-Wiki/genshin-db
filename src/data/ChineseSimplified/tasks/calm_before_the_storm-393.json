			"trigger": {
				"objectNames": [
					"温迪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3930101,
					"content": "我在想，一切结束以后，我要把这些都写进歌里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930102,
						3930103
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3930102,
					"content": "这段时间还真是发生了很多事啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930104
					]
				},
				{
					"id": 3930104,
					"content": "嗯，这首歌也会像《温妮莎传奇》一样，被蒙德的人们传唱下去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930105
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3930105,
					"content": "我从小就很喜欢那首歌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930106
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3930106,
					"content": "#那么，{NICKNAME}…你今天状态如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930107
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3930107,
					"content": "我已经调整到了最佳状态，一定能成为各位的助力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930108,
						3930109
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3930108,
					"content": "琴团长真可靠。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930110
					]
				},
				{
					"id": 3930110,
					"content": "说起来，迪卢克老爷也陪我们一路走到了最后呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3930111,
					"content": "明明当初只是不小心被卷进来的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3930112,
					"content": "的…呃…路人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3930113,
					"content": "你们向我分享了秘密，我不过是报以相同的信任而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930114,
						3930117,
						3930120
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3930114,
					"content": "迪卢克老爷的理由，是「信任」啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930115
					]
				},
				{
					"id": 3930115,
					"content": "然后，琴团长的理由，是「责任」吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3930116,
					"content": "那么，卖唱的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3930121,
					"content": "是「自由」喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930122
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3930122,
					"content": "自由…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3930123,
					"content": "你们来蒙德时，有没有人对你们说过，蒙德是「自由之都」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930124
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3930124,
					"content": "安柏…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930125
					]
				},
				{
					"id": 3930125,
					"content": "啊哈哈，那也是个自由自在的孩子呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930126
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3930126,
					"content": "蒙德是一座没有「国王」统治的浪漫城邦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930127
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3930127,
					"content": "而蒙德的国民，是七国中最自由的国民。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930128
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3930128,
					"content": "我希望，曾经守护蒙德的龙也一样——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930129
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3930129,
					"content": "不该有人欺骗它，说「这座城市背叛了你」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930130
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3930130,
					"content": "也不该有人告诉它，说「守护这座城市是你永恒的义务」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930131
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3930131,
					"content": "它有选择自己生活方式的权利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930132
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3930132,
					"content": "温迪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3930133,
					"content": "#那么，{NICKNAME}，蒙德的千年流风与你同在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930134
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3930134,
					"content": "接下来我会像上次一样，为你引导「风」的元素力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930135,
						3930136
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3930135,
					"content": "你说「上次」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930137
					]
				},
				{
					"id": 3930137,
					"content": "#原来如此！怪不得{NICKNAME}说你的声音很熟悉呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3930136,
					"content": "我就知道，那时的声音果然是你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930137
					]
				},
				{
					"id": 3930117,
					"content": "琴团长的理由，是「责任」啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930118
					]
				},
				{
					"id": 3930118,
					"content": "嗯，迪卢克老爷的理由，是「信任」吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3930119,
					"content": "那么，卖唱的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3930120,
					"content": "那么温迪呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930121
					]
				},
				{
					"id": 3930109,
					"content": "放心，我也状态满满！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930110
					]
				},
				{
					"id": 3930103,
					"content": "和温迪也快变成老搭档了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930104
					]
				}
			]
		}
	]
}