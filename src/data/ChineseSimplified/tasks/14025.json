			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"那维莱特"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 140251001,
					"content": "之前提到过，我可以轻易地和他人的情感产生共鸣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140251002
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 140251002,
					"content": "然而在几次见面中，我几乎无法从这位执行官的身上感受到任何东西。她的内心就像平静的湖水，幽暗深邃，没有任何涟漪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140251003
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 140251003,
					"content": "我不清楚她是天生如此，还是已经能靠自我意志来掌控情感。无论是哪一种，都意味着她很危险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140251004
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 140251004,
					"content": "我不会过问你们跟随她行动的原因。但请你们务必要注意安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "那维莱特"
				}
			]
		}
	]
}