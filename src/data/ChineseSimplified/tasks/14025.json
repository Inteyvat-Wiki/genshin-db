			"dialogs": [
				{
					"id": 140250501,
					"content": "「仆人」，刚刚你和那维莱特在谈些什么呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140250502,
					"content": "又是湖泊又是河流的，难道说…你们在讨论什么跟水有关的工程吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140250503,
					"content": "两位很好奇吗？现在似乎并不是关心这个的时候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250504
					],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 140250504,
					"content": "也是…不知道林尼那边怎么样了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140250505,
					"content": "#{NICKNAME}，你在想办法吗？加油啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140250506,
					"content": "（「仆人」看起来很轻松，但她身上的杀意不是装出来的。她似乎真的想杀死那些涉嫌「背叛」的孩子们。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250507
					]
				},
				{
					"id": 140250507,
					"content": "（该怎么做才能阻止她？不，在那之前，还有另一个问题。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250508
					]
				},
				{
					"id": 140250508,
					"content": "（在沫芒宫门口，她提到了克雷薇的名字。这是否意味着她早就掌握了克雷薇的行踪？林尼他们的行动在「仆人」的预料内吗？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250509
					]
				},
				{
					"id": 140250509,
					"content": "哇——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250510
					],
					"speakerTitle": "奥尔内"
				},
				{
					"id": 140250510,
					"content": "疼疼…等下，你没事吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250511
					],
					"speakerTitle": "奥尔内"
				},
				{
					"id": 140250511,
					"content": "都怪我，光想着卖报的事情，没看前面的路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250512,
						140250513
					],
					"speakerTitle": "奥尔内"
				},
				{
					"id": 140250512,
					"content": "抱歉。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250514
					]
				},
				{
					"id": 140250514,
					"content": "啊，作为补偿，这份报纸你们收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250515
					],
					"speakerTitle": "奥尔内"
				},
				{
					"id": 140250515,
					"content": "（这个人…总觉得有点眼熟？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250516
					]
				},
				{
					"id": 140250516,
					"content": "不用啦，这多不好意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250517
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140250517,
					"content": "没事没事，反正我手上还有不少。报纸这东西，拖到明天送都送不出去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250518
					],
					"speakerTitle": "奥尔内"
				},
				{
					"id": 140250518,
					"content": "都怪我，想着多赚点钱补贴家用，一口气进了太多货。结果今天看报纸的人少，现在还没卖完呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250519
					],
					"speakerTitle": "奥尔内"
				},
				{
					"id": 140250519,
					"content": "在聊什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250520
					],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 140250520,
					"content": "没事没事，刚刚不小心撞到了这位朋友，我现在就走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250521
					],
					"speakerTitle": "奥尔内"
				},
				{
					"id": 140250521,
					"content": "等一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250522
					],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 140250522,
					"content": "这个…如果索要赔偿的话，我没有现钱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250523
					],
					"speakerTitle": "奥尔内"
				},
				{
					"id": 140250523,
					"content": "拿三份报纸，这是摩拉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250524
					],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 140250524,
					"content": "啊？谢谢惠顾，神明保佑您发大财！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250525
					],
					"speakerTitle": "奥尔内"
				},
				{
					"id": 140250525,
					"content": "要是每天都能遇到像您这样慷慨的人就好了…开玩笑的，明天我还是少进点报纸，不能因为快结婚了就心急。再见各位！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250526
					],
					"speakerTitle": "奥尔内"
				},
				{
					"id": 140250526,
					"content": "事情办完了，坐船回白淞镇吧，路上还可以看报纸打发时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250527
					],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 140250527,
					"content": "等、等一下…再逛一会儿怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250528
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140250528,
					"content": "对了，我肚子饿了——必须要吃饱了才能回去！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250529
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140250529,
					"content": "（派蒙在努力寻找不回去的理由。时间还早，林尼那边几乎不可能有什么进展。现在该怎么办…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250530
					]
				},
				{
					"id": 140250530,
					"content": "看来你们似乎还怀有一些美好的幻想，认为再拖一段时间，情况或许会出现转机。在我看来这种挣扎毫无意义。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250531
					],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 140250531,
					"content": "不过，如果你们愿意答应我一个条件，我可以再多给林尼一点时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250532
					],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 140250532,
					"content": "另外，我也会解答你们心里的疑惑。比如克雷薇到底是谁，跟我是什么关系…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250533
					],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 140250533,
					"content": "你、你怎么突然这么大方了，不会是要我们做什么坏事吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250534
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140250534,
					"content": "不要太高估自己，你们并没有做坏事的天分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250535
					],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 140250535,
					"content": "唔。那你为什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250536
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140250536,
					"content": "交涉最重要的是利益互换，一味地索取或威胁得不到想要的结果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250537
					],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 140250537,
					"content": "我们可以听听你的条件。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250538
					]
				},
				{
					"id": 140250538,
					"content": "很好。我的条件是——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250539
					],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 140250539,
					"content": "「在必要的时候，做出你们认为最合适的选择，帮一次壁炉之家。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250540
					],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 140250540,
					"content": "奇怪，怎么感觉很正常…不过「必要的时候」，指的是什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250541
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140250541,
					"content": "这个就交给你们判断了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250542
					],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 140250542,
					"content": "可以答应你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250543
					]
				},
				{
					"id": 140250543,
					"content": "交涉成立。跟我来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 140250513,
					"content": "我也没注意。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250514
					]
				}
			]
		},
