					"content": "今天要去哪里？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250802
					],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 140250802,
					"content": "到远一些的地方试试吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "林尼"
				}
