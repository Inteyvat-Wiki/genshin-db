				]
			},
			"dialogs": [
				{
					"id": 140250201,
					"content": "又见面了。看你们一脸憔悴，昨晚没休息好？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250202
					],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 140250202,
					"content": "是有一点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140250203,
					"content": "少一点心事，说不定可以睡个好觉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250204
					],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 140250204,
					"content": "接下来想做什么，睡个回笼觉，还是绞尽脑汁想些新的话题？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250205
					],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 140250205,
					"content": "我确实有点好奇，今天「公子」不在，你们要找什么理由把我留在这里呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250206
					],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 140250206,
					"content": "（！！！）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250207
					]
				},
				{
					"id": 140250207,
					"content": "你，你在说什么呀，我们只是来随便聊聊天！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140250208,
					"content": "没想好的话，陪我去个地方如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250209
					],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 140250209,
					"content": "别紧张，我们会绕开那些鬼鬼祟祟的小家伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250210
					],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 140250210,
					"content": "啊…今天的海风好舒服呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140250211,
					"content": "你都知道了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250212
					]
				},
				{
					"id": 140250212,
					"content": "孩子们总是自认为能骗过大人的眼睛，可那些小算盘我看得一清二楚。让他们多折腾一段时间吧，我有足够的耐心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250213
					],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 140250213,
					"content": "我先走了，想清楚就跟上来，我们在沫芒宫门口见面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250214
					],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 140250214,
					"content": "乖乖听话，或许他们还有一线生机。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250215
					],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 140250215,
					"content": "怎、怎么办啊！！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140250216,
					"content": "她刚刚的语气，很明显是知道我们做的事了吧？而且她摆明了是在要挟我们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140250217,
					"content": "先放飞林尼给我们的魔术鸽子。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250218
					]
				},
				{
					"id": 140250218,
					"content": "嗯，希望林尼能及时收到我们的预警…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140250219,
					"content": "接下来，我们还是要去一趟沫芒宫吧。她都这么说了，感觉不去的后果很严重。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250220,
						140250221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140250220,
					"content": "也没什么更好的办法了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250222
					]
				},
				{
					"id": 140250222,
					"content": "那我们快跟上去。如果她等急了，直接去找林尼，那就糟糕了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140250221,
					"content": "走一步看一步吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250222
					]
				}
			]
		},
