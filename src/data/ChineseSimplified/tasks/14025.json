					},
					{
						"sceneId": 1083,
						"position": [
							-35.909,
							0.334,
							-18.022
						],
						"pointId": 85
					},
					{
						"sceneId": 1083,
						"position": [
							-35.757,
							0.351,
							-14.567
						],
						"pointId": 86
					}
				]
			},
			"dialogs": [
				{
					"id": 140250401,
					"content": "许久不见，那维莱特先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250402
					],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 140250402,
					"content": "没想到我的会见申请这么快就能被批准，沫芒宫的效率真是让人由衷赞叹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250403
					],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 140250403,
					"content": "对一位声名在外的外交官，这是必要的尊重。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250404
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 140250404,
					"content": "但客观来说，我原以为「赠予神之心」会是我们最后一次见面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250405
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 140250405,
					"content": "#…这次还带上了{NICKNAME}和派蒙，到底所为何事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250406
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 140250406,
					"content": "我很快就要离开枫丹了，临走之前，还有一件放心不下的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250407
					],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 140250407,
					"content": "几句话未必能说清楚，我写好了一份提案，请那维莱特先生过目。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250408
					],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 140250408,
					"content": "仆人递出一份文件，之后优雅地端起杯子，品尝着杯中的水。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						140250409
					]
				},
				{
					"id": 140250409,
					"content": "我明白你的请求了。恕我直言，我无法理解你这么做的原因。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250410
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 140250410,
					"content": "听闻那维莱特先生有品水的爱好，我就用水来做比喻吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250411
					],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 140250411,
					"content": "家就像一个巨大的湖泊，无数条河流汇聚而入，无数条河流奔涌而出。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250412
					],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 140250412,
					"content": "作为一个每天注视着湖泊的人，我希望每一条流出的河都能抵达大海。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250413
					],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 140250413,
					"content": "然而客观事实告诉我这是不可能的。绝大部分河流都会在半路干涸，渗入泥土中，再无声息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250414
					],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 140250414,
					"content": "我想给那些「看不见海的水」，找一些存在的意义。比如灌溉两岸的田地，或是成为某个人杯中的甘泉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250415
					],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 140250415,
					"content": "喂，你听懂了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250416,
						140250417
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140250416,
					"content": "不是很懂…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250418
					]
				},
				{
					"id": 140250418,
					"content": "我有必要提醒你，无论你如何美化它们，都没有人想要品尝「浑浊的水」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250419
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 140250419,
					"content": "是「曾经浑浊的水」。别担心，我会滤净水中的泥沙，让它们回到最纯净的样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250420
					],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 140250420,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250421
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 140250421,
					"content": "既然你提到这是「交易」，那我们聊一聊细节吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250422
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 140250422,
					"content": "如果那维莱特先生同意我的提案，我的势力会逐渐撤出枫丹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250423
					],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 140250423,
					"content": "今后非必要情况，我们不会在枫丹执行「特殊任务」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250424
					],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 140250424,
					"content": "你的意思是，今后不会发生「达尔杜弗遇刺」这种事情？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250425
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 140250425,
					"content": "你说那个贪污善款的伪君子？我对他的遇害表示沉痛的悼念，不过目前好像并没有证据指向壁炉之家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250426
					],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 140250426,
					"content": "当然，如果那维莱特先生答应我的提案，我可以帮忙做一些事情，让类似的麻烦少一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250427
					],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 140250427,
					"content": "真是滴水不漏的发言。好吧，我原则上同意你的提案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250428
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 140250428,
					"content": "感谢您的宽宏，那维莱特先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250429
					],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 140250429,
					"content": "交易达成，我们也该告退了。我托人带了两瓶来自至冬的泉水，希望下次有机会听听您的感想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250430
					],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 140250430,
					"content": "下次再会。记得你的承诺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250431
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 140250431,
					"content": "#好了，{NICKNAME}、派蒙，我们走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 140250417,
					"content": "半懂不懂…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250418
					]
				}
			]
		},
