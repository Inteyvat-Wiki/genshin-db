			"trigger": {
				"objectNames": [
					"法拉比",
					"埃德蒙德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736790101,
					"content": "旅行者，你们来了。呼…这下总算可以放心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736790102
					],
					"speakerTitle": "埃德蒙德"
				},
				{
					"id": 736790102,
					"content": "哇，埃德蒙德先生，法拉比，你们怎么突然跑到雪山里来了呀。收到你们的消息说在这里集合时，我真是吓了一大跳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736790103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736790103,
					"content": "哈哈，这件事确实有点突然，不过既然出现了「意想不到的研究目标」，怎么说也不能放弃这个机会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736790104
					],
					"speakerTitle": "法拉比"
				},
				{
					"id": 736790104,
					"content": "「意想不到的研究目标」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736790105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736790105,
					"content": "对。埃德蒙德先生说，他曾经在雪山脚下看到过巨大的动物蹄印。经过这两天的搜寻，我们终于在这附近发现了同样的痕迹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736790106
					],
					"speakerTitle": "法拉比"
				},
				{
					"id": 736790106,
					"content": "旅行者，我能确定，这里绝对生活着一头巨大的雪猪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736790107
					],
					"speakerTitle": "法拉比"
				},
				{
					"id": 736790107,
					"content": "如果能够得到它的毛发和血样，对于弄清雪猪种群的生存状况、雪猪出现在山下的原因，一定会有很大帮助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736790108
					],
					"speakerTitle": "法拉比"
				},
				{
					"id": 736790108,
					"content": "所以说，我们今天的目标，是狩猎那头巨大的雪猪吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736790109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736790109,
					"content": "不，并不是狩猎。其实在我们猎人的传说里，巨大的雪猪是真正的龙脊雪山之主，是不能随便狩猎的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736790110
					],
					"speakerTitle": "埃德蒙德"
				},
				{
					"id": 736790110,
					"content": "不过如果只是出于研究目的，稍微困住它一小会儿，应该不要紧吧？法拉比老弟，你可要好好干啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736790111
					],
					"speakerTitle": "埃德蒙德"
				},
				{
					"id": 736790111,
					"content": "嗯，你们放心吧。其实，最近我了解到蒙德一到丰收季总会遭到野林猪侵扰的情况之后，也想了很多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736790112
					],
					"speakerTitle": "法拉比"
				},
				{
					"id": 736790112,
					"content": "我觉得，说不定自己能在野林猪这个研究方向继续钻研下去，帮大家找到解决之道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736790113
					],
					"speakerTitle": "法拉比"
				},
				{
					"id": 736790113,
					"content": "毕竟我们研究生物的一个重要目的，就是为了与它们和谐共处。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736790114
					],
					"speakerTitle": "法拉比"
				},
				{
					"id": 736790114,
					"content": "嘻嘻，感觉你的这趟佳酿节之旅，收获了不少东西呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736790115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736790115,
					"content": "是啊，不仅尝到了美酒，还得到了热心的朋友和奋斗的目标。不过感慨的话，还是等到我们下山之后再说吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736790116
					],
					"speakerTitle": "法拉比"
				},
				{
					"id": 736790116,
					"content": "旅行者，看那头雪猪的足迹大小，我恐怕也不是它的对手，待会儿这里，就只能交给你这样的专业人士了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736790117
					],
					"speakerTitle": "埃德蒙德"
				},
				{
					"id": 736790117,
					"content": "不过你放心吧，我已经把吸引它的诱饵和捕猎装置都布置好了，应该能帮上一些忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736790118
					],
					"speakerTitle": "埃德蒙德"
				},
				{
					"id": 736790118,
					"content": "嗯，交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736790119
					]
				},
				{
					"id": 736790119,
					"content": "旅行者，如果你准备好了的话，我就要点燃诱饵，吸引大雪猪过来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736790120,
						736790121
					],
					"speakerTitle": "法拉比"
				},
				{
					"id": 736790120,
					"content": "我准备好了，大雪猪！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 736790121,
					"content": "等一下，我还需要做点准备。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736790122
					]
				},
				{
					"id": 736790122,
					"content": "没关系，你可以慢慢来，毕竟我们要对付的是那个大家伙嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "法拉比"
				}
			]
		}
	]
}