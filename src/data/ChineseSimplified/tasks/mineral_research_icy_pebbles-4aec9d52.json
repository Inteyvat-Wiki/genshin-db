			"dialogs": [
				{
					"id": 761970120,
					"content": "(test)台词文本",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						761970101
					]
				},
				{
					"id": 761970101,
					"content": "当年在海上漂泊时，我曾听到过不知从何处传来的召唤，其他人无动于衷，但我却很快被迷住了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970102
					],
					"speakerTitle": "维贾米"
				},
				{
					"id": 761970102,
					"content": "一定是来自异界的声音吧，我也听到过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970103
					],
					"speakerTitle": "奥妮"
				},
				{
					"id": 761970103,
					"content": "后来我才意识到，那召唤中包含了一切未能抵达彼岸的梦想，可以说是怨念的集合。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970104
					],
					"speakerTitle": "维贾米"
				},
				{
					"id": 761970104,
					"content": "你应该带上寒涌石，透过中间的孔，就可以看到是谁在召唤你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970105
					],
					"speakerTitle": "奥妮"
				},
				{
					"id": 761970105,
					"content": "但当时我还是个年轻气盛的毛头小子，哪怕看到危险也只会觉得是机遇，于是就这么一头撞了进去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970106
					],
					"speakerTitle": "维贾米"
				},
				{
					"id": 761970106,
					"content": "听说寒涌石中间的孔就是通向异界的门扉…不过，该怎么穿过去呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970107
					],
					"speakerTitle": "奥妮"
				},
				{
					"id": 761970107,
					"content": "而在那之后…大海的风浪啊，带走了我的财富、荣誉还有家人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970108
					],
					"speakerTitle": "维贾米"
				},
				{
					"id": 761970108,
					"content": "在野心和欲望的驱使下的冒险，从来不会有好的结果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970109
					],
					"speakerTitle": "维贾米"
				},
				{
					"id": 761970109,
					"content": "啊，卡住了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970110
					],
					"speakerTitle": "奥妮"
				},
				{
					"id": 761970110,
					"content": "我来帮你取下来吧。下次可再别这么做了哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970111
					],
					"speakerTitle": "莉奈娅"
				},
				{
					"id": 761970111,
					"content": "莉奈娅姐姐，你怎么有空回来了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970112
					],
					"speakerTitle": "奥妮"
				},
				{
					"id": 761970112,
					"content": "我来附近收集寒涌石，看到你们在聊天，就来打个招呼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970113
					],
					"speakerTitle": "莉奈娅"
				},
				{
					"id": 761970113,
					"content": "对哦，如果是莉奈娅姐姐，说不定真的可以用寒涌石打开通往异界的门扉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970114
					],
					"speakerTitle": "奥妮"
				},
				{
					"id": 761970114,
					"content": "就算是我也不行，之前不是和你说过吗？那只是穿凿附会的民间传说而已，没什么可靠的依据…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970115
					],
					"speakerTitle": "莉奈娅"
				},
				{
					"id": 761970115,
					"content": "原来行不通啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970116
					],
					"speakerTitle": "维贾米"
				},
				{
					"id": 761970116,
					"content": "原来你在听啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970117
					],
					"speakerTitle": "莉奈娅"
				},
				{
					"id": 761970117,
					"content": "咳…不，我已经不再是过去的我了，现在的我知足常乐，别无所求。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970118
					],
					"speakerTitle": "维贾米"
				},
				{
					"id": 761970118,
					"content": "这样，真可惜。那我也来帮莉奈娅姐姐收集寒涌石吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970119
					],
					"speakerTitle": "奥妮"
				},
				{
					"id": 761970119,
					"content": "好呀，那就麻烦你啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970124
					],
					"speakerTitle": "莉奈娅"
				},
				{
					"id": 761970124,
					"content": "在奥妮的帮助下，很快收集完毕…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761970122
					]
				},
				{
					"id": 761970122,
					"content": "谢谢你，不过我已经收集好啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970123
					],
					"speakerTitle": "莉奈娅"
				},
				{
					"id": 761970123,
					"content": "好吧，那我就去莫雷谷找莫雷爷爷他们了。再见啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奥妮"
				}
			]
		},
