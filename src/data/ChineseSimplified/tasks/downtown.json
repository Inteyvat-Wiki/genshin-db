	"talks": [
		{
			"id": 101301,
			"completionStepIds": [
				101301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101301",
							"2"
						],
						"stepId": 101301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿山婆"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10130101,
					"content": "客人，来啦？之前预定的七只风筝都已经扎好了，是现在要取么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130102
					],
					"speakerTitle": "阿山婆"
				},
				{
					"id": 10130102,
					"content": "是的，辛苦了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130103
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10130103,
					"content": "这年头，愿意买这式样风筝的客人，还真少见。要说早年间，倒是有些三教九流的朋友会用上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130104
					],
					"speakerTitle": "阿山婆"
				},
				{
					"id": 10130104,
					"content": "嗯，这位钟离先生是「往生堂」的客卿，所以他对三教九流的游戏规则也都能理解吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10130105,
					"content": "不过，这次旅途里跟钟离闲聊的东西，还远远不止这些…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130106,
						10130107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10130106,
					"content": "他也懂衣冠日用、珠玉瓷器…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10130108
					]
				},
				{
					"id": 10130108,
					"content": "唔…他好像也能接上璃月人最爱的金融和政治话题，但却更喜欢说那些比较「无用」的知识呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10130109,
					"content": "哈哈…因为我更愿意把这些趣事分享给你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130110
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10130110,
					"content": "哎呀，孩子的玩具就是很有趣的东西嘛。不过…虽然我也挺喜欢看孩子笑，但毕竟，还有点别的念想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130111
					],
					"speakerTitle": "阿山婆"
				},
				{
					"id": 10130111,
					"content": "精巧的玩意，总能讨孩子喜欢。但这份「精巧」也是千多年的积淀，背后都是有「意义」的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130112
					],
					"speakerTitle": "阿山婆"
				},
				{
					"id": 10130112,
					"content": "我在璃月做了四十年风筝，对祖上传下的式样一清二楚。这位客人订的七只风筝，意义可不一般。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130113
					],
					"speakerTitle": "阿山婆"
				},
				{
					"id": 10130113,
					"content": "没错。这是「送仙典仪」用的饰物，七只风筝…象征七神。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130114
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10130114,
					"content": "呵呵呵…敬献风神的纹样，我特意把颜色「自由」地涂出了界。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130115
					],
					"speakerTitle": "阿山婆"
				},
				{
					"id": 10130115,
					"content": "至于敬献岩神的，就要好好按照「契约」来画咯。这种花纹是很古的，在「黄金屋」里也找得到呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130116
					],
					"speakerTitle": "阿山婆"
				},
				{
					"id": 10130116,
					"content": "啊，「黄金屋」，这个名字我最近听过——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130117,
						10130118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10130117,
					"content": "嘘…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10130119
					]
				},
				{
					"id": 10130119,
					"content": "咦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10130120,
					"content": "这只风筝的雷纹…嗯，旋回感把握得很好，正如雷神想要的「永恒」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130121
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10130121,
					"content": "敬献「智慧」的草叶纹路、银木年轮…巧妙地融合在风筝的骨架里，令人赞叹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130122
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10130122,
					"content": "水面般平衡的「正义」、如火炽烈的「战争」，还有冰神曾经的…嗯，细节做得都很到位啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130123
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10130123,
					"content": "嚯嚯嚯，偶尔能听懂行的客人多夸几句，也是赏心乐事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130124
					],
					"speakerTitle": "阿山婆"
				},
				{
					"id": 10130124,
					"content": "那么阿山婆，我就先把这些预定的货取走了。余款的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130125,
						10130126
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10130125,
					"content": "完了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10130127
					]
				},
				{
					"id": 10130127,
					"content": "余款的话…我来付吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130128
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10130128,
					"content": "呀，是「公子」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130129,
						10130131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10130129,
					"content": "你们约好在这里见面吗。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10130130
					]
				},
				{
					"id": 10130130,
					"content": "哈哈，只是路过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130133
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10130133,
					"content": "钟离先生还是老样子。付账…或者喊人付账的时候，从来不看价格，也不看荷包。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130134
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10130134,
					"content": "不过话说回来，他其实既懂金钱的价值，也很明白人间疾苦。但他似乎不能理解「穷」也是一种可能出现在自己身上的境况…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130135
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10130135,
					"content": "或者换句话说，只是根本不能想象一个没有钱的自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130136
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10130136,
					"content": "真是绝了，这种人怎么还没饿死。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130137
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10130137,
					"content": "…「公子」先生还是这么爱开玩笑。好了，买风筝一切顺利，进行下一项准备之前，就不必休息了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130138
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10130138,
					"content": "「送仙典仪」需要物资，也需要人。在码头附近，我们可以雇到一些不错的帮工。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130139
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10130139,
					"content": "#{NICKNAME}，把这个钱袋拿去——我不说你也明白的吧？讨价还价的事，你自己来，可千万别让钟离插手喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130140
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10130140,
					"content": "嗯…来晚一步，似乎错过了什么有趣的消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130141
					],
