	"talks": [
		{
			"id": 7166501,
			"completionStepIds": [
				7166501
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7166501",
							"2"
						],
						"stepId": 7166501,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"兰吉特"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716650101,
					"content": "哎哟，可算来了，你就是「主角」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650102,
						716650104
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 716650102,
					"content": "我就是主角。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716650103
					]
				},
				{
					"id": 716650103,
					"content": "呃，完全搞不懂你提问的意图…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716650105,
					"content": "啊，抱歉抱歉，瞧我这急性子，明明发布委托的时候也被告知过应该用简洁的语言说明委托内容来着。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650106
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 716650106,
					"content": "事情是这样，我叫兰吉特，是个创意料理厨子，我想和爆炎树搞好关系，但是它好像不大乐意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650107
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 716650107,
					"content": "又是吐火球又是撞地，我真拿它没辙了，所以需要一个能当故事主角的冒险家来帮帮我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650108,
						716650110
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 716650108,
					"content": "好的，交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716650109
					]
				},
				{
					"id": 716650109,
					"content": "不要随便答应这种荒唐的委托啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716650111,
					"content": "你是认真的吗？创意料理厨子和爆炎树交朋友…怎么想都很奇怪吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716650112,
					"content": "是吗？它作为植物来说确实脾气有些过于暴躁了，不过凡事总得试试！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650113
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 716650113,
					"content": "除了爆炎树，之后我还打算试试挑战古岩龙蜥、翠翎恐蕈，还有千年珍珠骏麟！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650114
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 716650114,
					"content": "呃，总觉得越说越离谱了。真不知道你这想法是从哪里来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716650115,
					"content": "其实是因为我前阵子跑了趟纳塔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650116
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 716650116,
					"content": "纳塔真是个神奇的地方，那种新奇的感觉，要说有什么能比的，恐怕就是第一次吃超辣咖喱时满头大汗的感觉了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650117
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 716650117,
					"content": "明明已经到了口舌能够承受的刺激的极限，但却忍不住一勺又一勺地继续吃下去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650118
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 716650118,
					"content": "…话说回来，当时我在纳塔结识了很多朋友，他们都是很好的人，有的教我攀岩，有的带我泡温泉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650119
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 716650119,
					"content": "你知道吗？纳塔人，特别是战士，会在着装上模仿他们的龙。那一身行头打扮下来，看着真就和龙一样勇猛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650120
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 716650120,
					"content": "我照着纳塔朋友的帽子给自己也做了一顶，你瞧，很不错吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650121
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 716650121,
					"content": "唔…的确是很有特色的帽子，不过光看一顶帽子也看不出来什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716650122,
					"content": "这倒也是，因为没有龙伙伴嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650123
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 716650123,
					"content": "唉，要是我也能有龙伙伴就好了。但我又不是纳塔人，让我在纳塔长住我也安分不下来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650124
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 716650124,
					"content": "于是我就想能不能在纳塔之外的地方找到能代替龙的伙伴，不管能不能成，之后回纳塔我也好把这段经历讲给纳塔朋友听！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650125
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 716650125,
					"content": "就算是这样，你也应该挑选一下挑战的对象吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716650126,
					"content": "欸？你不觉得它们都是合适的对象吗？和纳塔的龙也很像，然后也很强！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650127
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 716650127,
					"content": "毕竟有个驮兽伙伴可算不上本事，既然要给纳塔朋友讲冒险故事，当然得选些有挑战性的目标。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650128
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 716650128,
					"content": "比较可惜的是我自己当不了「主角」…要让这些不分白天黑夜都怒气冲冲的家伙们冷静下来可真不容易啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650129
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 716650129,
					"content": "不过经验丰富的冒险家应该很擅长应对这种事吧？当然，我也会从旁辅助的，不管是网子还是料理，就交给我好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650130
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 716650130,
					"content": "和潜在伙伴们正面「交涉」的工作就拜托你啦，「主角」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650131
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 716650131,
					"content": "你怎么把危险的工作都交给主角啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650132,
						716650134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716650132,
					"content": "你的报酬最好是配得上我的劳动…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716650133
					]
				},
				{
					"id": 716650133,
					"content": "那当然了！好说好说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650136
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 716650136,
					"content": "好！既然都谈妥了，那我们这就出发？锅已经支好了，装备也调试过了，应该没问题！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650137,
						716650138
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 716650137,
					"content": "出发吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 716650138,
					"content": "还有别的事，稍候。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716650139
					]
				},
				{
					"id": 716650139,
					"content": "没问题，我就在这儿等你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 716650134,
					"content": "先以理服人，再好好聊聊。了解。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716650135
					]
				},
				{
					"id": 716650135,
					"content": "对，你说的对，是这个道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650136
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 716650110,
					"content": "够简洁，但完全听不懂。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716650111
					]
				},
				{
					"id": 716650104,
					"content": "听不懂你在说什么…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716650105
					]
				}
			]
		}
	]
}