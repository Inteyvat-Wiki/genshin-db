				]
			},
			"dialogs": [
				{
					"id": 401710101,
					"content": "#只要{NICKNAME}出现，一切就会好起来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710102
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401710102,
					"content": "嘿！欧洛伦，这边！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401710103,
					"content": "#啊，{NICKNAME}，派蒙。你们好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710104
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401710104,
					"content": "听说你有事找我们，所以就立刻过来啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401710105,
					"content": "原来是这样…让我心里很温暖，这就是幸福的感觉吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710106
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401710106,
					"content": "噫！干嘛突然说这种话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401710107,
					"content": "你们是真正的好朋友。如果我家的蔬菜见到你们，一定也会长得更茂盛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710108
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401710108,
					"content": "那又是什么原理啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401710109,
					"content": "是夸奖，听说夸奖别人会让人快乐。你快乐了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710110
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401710110,
					"content": "谢谢。但你好像不是很快乐？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710111
					]
				},
				{
					"id": 401710111,
					"content": "被你发现了。确实，我现在就跟产蜜困难的蜜虫一样烦恼。奶奶堵住了我的前路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710113
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401710113,
					"content": "茜特菈莉？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710114
					]
				},
				{
					"id": 401710114,
					"content": "是的，你们知道，奶奶是个天才，天才总会堵住别人的路，让别人绝望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710115
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401710115,
					"content": "而我又是她的孙子，她让别人有多绝望，在我这个孙子身上都是要加倍的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710116
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401710116,
					"content": "应该说得很严重了吧，嗯，所以，请你们帮忙搞定奶奶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710117
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401710117,
					"content": "你经历了什么哦？说得这么严重，到底是怎么回事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401710118,
					"content": "我需要拉拢你们，毕竟，能搞定奶奶的人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710119,
						401710121
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401710119,
					"content": "那个人就是我。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710120
					]
				},
				{
					"id": 401710120,
					"content": "#没错，我也是第一个就想到了{M#爷爷}{F#奶奶}你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710123
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401710123,
					"content": "#{M#爷爷}{F#奶奶}，最开始见面的时候，我就是这么叫你的。虽然被批评了，但请允许我再叫一次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710124
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401710124,
					"content": "你给人的感觉不太一样，茜特菈莉奶奶对你的态度也不一样。后来的事情也证明了这两点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710125
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401710125,
					"content": "#我想，如果翻开名为「搞定茜特菈莉的四十人」的织卷，排在首位的就会是{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710126
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401710126,
					"content": "那后面不是还有三十九个吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401710127,
					"content": "#后面的也是{NICKNAME}，三十九个{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710128,
						401710130
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401710128,
					"content": "就算你这么说，我也还不想认孙子。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710129
					]
				},
				{
					"id": 401710129,
					"content": "拜托了，请帮帮我，真的很重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710132
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401710132,
					"content": "我只是看上去无所事事，其实在为前路感到烦恼，奶奶她成了拦路虎，让我无路可走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710133
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401710133,
					"content": "但现在你们到了，就可以开始行动起来了，时间不会一直等着我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710134
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401710134,
					"content": "那我要怎么帮你？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710135
					]
				},
				{
					"id": 401710135,
					"content": "你肯定知道奶奶喜欢看轻小说，喝闷酒，睡大觉，如果是你，一定可以对症下药，把她引走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710136
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401710136,
					"content": "所以就是让我们像钓鱼那样钓走茜特菈莉，这样她就没空管你了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710137
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401710137,
					"content": "是的。我当然没有闲着，去做了不少功课，说辞我也准备了一些。你们可以走到奶奶面前说：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710138
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401710138,
					"content": "「亲爱的奶奶，我有一本《蜃楼战记》最新卷，还有一本《奥西兹小姐事件簿》特别番外，要来一起看看吗？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710139
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401710139,
					"content": "#她就会假矜持几句，然后马上给自己找台阶下，满口答应。{NICKNAME}，如果是你抛出的诱饵，奶奶一定会上钩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710140
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401710140,
					"content": "可我真的有这种功效？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710141
					]
				},
				{
					"id": 401710141,
					"content": "是场面话啦！连我都听出来了，欧洛伦说的都是好听的场面话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710142
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401710142,
					"content": "#不对。奶奶嘴上不说而已，我能看得出来，她正在关注{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710143
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401710143,
					"content": "好吧…虽然我还是觉得欧洛伦在病急乱投医，但如果只是和茜特菈莉说几句话什么的，倒也不费劲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710144
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401710144,
					"content": "简直就像给蔬菜浇水一样轻松，如果我家的蔬菜在这里…啊…抱歉，没时间再讲蔬菜了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710145
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401710145,
					"content": "#请相信我，跟我来一趟吧，只要{NICKNAME}出现，一切就会好起来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401710130,
					"content": "#乖孙，{M#爷爷}{F#奶奶}我啊，已经心花怒放了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710131
					]
				},
				{
					"id": 401710131,
					"content": "#好的，那{M#爷爷}{F#奶奶}你一定愿意帮忙了吧？这真的很重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710132
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401710121,
					"content": "哈哈，不可能是我吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710122
					]
				},
				{
					"id": 401710122,
					"content": "#就是你，我第一个就想到了{M#爷爷}{F#奶奶}你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710123
					],
					"speakerTitle": "欧洛伦"
				}
			]
		},
		{
			"id": 4017102,
