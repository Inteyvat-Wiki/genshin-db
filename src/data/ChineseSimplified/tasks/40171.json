							-1758.319,
							106.05,
							9675.373
						],
						"pointId": 350900100
					}
				]
			},
			"dialogs": [
				{
					"id": 401710201,
					"content": "咦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710202
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401710202,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401710203,
					"content": "奶奶…居然不见了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710204
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401710204,
					"content": "她原本就站在那个洞口，防止我进去。我的前路就是这样被阻断的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710205
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401710205,
					"content": "原来是字面意义上的拦路虎啊！我还以为这也是比喻呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401710206,
					"content": "奶奶说，一个段落比喻两次的轻小说是二流。我不想变成二流。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710207
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401710207,
					"content": "喂，你把自己比成轻小说了吧？这是第二次比喻了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401710208,
					"content": "什么？糟糕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710209
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401710209,
					"content": "总之，现在欧洛伦应该畅行无阻了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710210
					]
				},
				{
					"id": 401710210,
					"content": "对哦，看来茜特菈莉已经想通了。欧洛伦，不管想干什么，你都可以大展身手啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401710211,
					"content": "我觉得没那么简单…奶奶不会这么轻易放弃抓我的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710212
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401710212,
					"content": "也许我一走进去洞里，就会被奶奶的监视法术发现，又或者踩中她留下的陷阱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710213
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401710213,
					"content": "可她干嘛要抓你呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710214
					]
				},
				{
					"id": 401710214,
					"content": "是啊，甚至还布置了陷阱！不会你又像之前那样…干了什么引人怀疑的事吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401710215,
					"content": "我只是想救人而已…是奶奶不让。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710216
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401710216,
					"content": "救、救人？！谁出事了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401710217,
					"content": "能请你们先去洞里面看看吗？虽然现在应该还安全，但是拖得越久，有危险的人就会越有危险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710218
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401710218,
					"content": "那你怎么办？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401710219,
					"content": "我只能先在门口等一会，以防自投奶奶的罗网。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710220
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401710220,
					"content": "可如果有陷阱的话，踩中的人岂不就是我们了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401710221,
					"content": "#不会有事的，奶奶的陷阱认得{NICKNAME}，不会把你们怎么样的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710222
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401710222,
					"content": "有这回事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710223
					]
				},
				{
					"id": 401710223,
					"content": "嗯，我跟我家的蜜虫讲过你的丰功伟绩，奶奶应该也跟她的陷阱讲过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710224
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401710224,
					"content": "不要以为所有人都像你啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401710225,
					"content": "#总而言之，拜托了，好{M#爷爷}{F#奶奶}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710226
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401710226,
					"content": "#{NICKNAME}，既然事关人命，我们还是先进去看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
