			},
			"dialogs": [
				{
					"id": 401710401,
					"content": "呼~顺利地走进来了，什么都没发生。也许茜特菈莉的陷阱真的认识我们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401710402,
					"content": "呜哇！快看！那里有个人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401710403,
					"content": "嗨！你还好吗？喂！听得见我们说话吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401710404,
					"content": "似乎没反应。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710405
					]
				},
				{
					"id": 401710405,
					"content": "睡着了吗？还是生病了…会不会这就是欧洛伦说要救的人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401710406,
					"content": "这个营地也是神神秘秘的，是干什么的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401710407,
					"content": "像是什么仪式。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710408
					]
				},
				{
					"id": 401710408,
					"content": "唔…我们去叫欧洛伦进来吧，他肯定知道这是什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401710409,
					"content": "对不起，奶奶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710410
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401710410,
					"content": "翅膀硬了啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710411
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710411,
					"content": "…真的对不起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710412
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401710412,
					"content": "是不是觉得自己当上了六个英雄之一，可以无法无天了？嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710413
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710413,
					"content": "给我解释一下，臭小子，凭什么插手那个灵性白痴的事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710414
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710414,
					"content": "欧洛伦！还有茜特菈莉…哈哈…你也来了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401710415,
					"content": "欸？欸欸欸？你们怎么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710416
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710416,
					"content": "#（糟糕，{M#他们}{F#她们}怎么现在就来了，我刚才凶巴巴的样子不会被{NICKNAME}看见了吧？哦天，我的形象！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710417
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710417,
					"content": "哈哈…你们好啊，那什么…刚才我和欧洛伦在玩，模仿游戏…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710418
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710418,
					"content": "就是模仿轻小说里的人物和情节，背他们的台词，我说的话都不是我的本意，对吧，欧洛伦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710419
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710419,
					"content": "啊？啊…对的，对的，奶奶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710420
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401710420,
					"content": "#{NICKNAME}，也对不起你，本来是请你来帮忙的，结果我却没有注意身后，先被奶奶抓住了，和她一起玩模仿游戏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710421,
						401710422,
						401710423
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401710421,
					"content": "这种事就不用道歉了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710425
					]
				},
				{
					"id": 401710425,
					"content": "茜特菈莉和欧洛伦，你们到底在干什么呀？是不是这个人出了问题？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710426
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401710426,
					"content": "嗯，他叫勒拉，在一次暝视中出了岔子，变成了现在这个样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710427
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710427,
					"content": "暝视是什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710428
					]
				},
				{
					"id": 401710428,
					"content": "一种操纵灵性出体、用来获知神秘的法术，你有在小说里见到过通灵这种事吗？跟那个就很像。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710429
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710429,
					"content": "而现在他的问题是，他的灵性在某处迷路了，无法返回身体。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710430
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710430,
					"content": "也就是说，他只是身体在这，但灵魂不在了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710431
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401710431,
					"content": "虽说灵魂和灵性不完全是一回事，但现在可以简单这么理解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710432
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710432,
					"content": "嗯，我就是想把勒拉失踪的灵性找回来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710433
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401710433,
					"content": "哼，如果这个勒拉是一般人就罢了，我不会阻止欧洛伦。可问题在于，勒拉是个灵性白痴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710434
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710434,
					"content": "灵性白痴又是什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710435
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401710435,
					"content": "就是对灵性完全脱敏的人，他们无法感知、操控灵性，更无法使用相关的法术。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710436
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710436,
					"content": "反过来，如果他们用特殊方式强行施法…后果你们看到了，就是这位勒拉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710437
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710437,
					"content": "我们烟谜主的法术与灵性密不可分，解决问题的手段也如此，所以对灵性白痴而言，一般的治疗手段都不起效。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710438
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710438,
					"content": "他们一旦因为施法出现问题，就约等于无药可救。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710439
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710439,
					"content": "有药可救的，只要是灵魂层面的事，我就还有办法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710440
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401710440,
					"content": "听明白了吧？你们应该都知道欧洛伦这小子想干嘛了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710441
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710441,
					"content": "噢！欧洛伦，你是想用你的特殊体质…会不会对你比较危险？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710442
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401710442,
					"content": "不会有事的，奶奶太操心了。我的身体基本没问题了，现在应该能找到安全的办法。我想，只有这样才能找回勒拉的灵性。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710443
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401710443,
					"content": "你想你想，想都别想。如果勒拉的问题有点难办，你会做到什么程度，我还不知道吗？我看你也是个白痴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710444
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710444,
					"content": "唔…欧洛伦确实是很会舍己为人的那种，这点让人担忧。但茜特菈莉也是操心的性格，真难办啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710445,
						401710448,
						401710450
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401710445,
					"content": "我支持茜特菈莉，欧洛伦是白痴。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710446
					]
				},
				{
					"id": 401710446,
					"content": "说我是白痴也无所谓，只要你们支持我，我就能把勒拉的灵性找回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710447
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401710447,
					"content": "喂！你把奶奶我当成什么了？什么时候轮到孙子来撑场面了？我当然还有办法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710452
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710452,
					"content": "噢？！哦？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710453
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401710453,
					"content": "欸？奶奶真的还有办法吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710454
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401710454,
					"content": "笨办法也是办法！真是会给人找麻烦，你这臭小子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710455
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710455,
					"content": "#{NICKNAME}，其实我本来就打算联系你的，因为我的办法动静比较大，可能需要你搭把手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710456
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710456,
					"content": "那正好呀，欧洛伦已经把我们先找来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710457
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401710457,
					"content": "没问题，要怎么帮忙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710458
					]
				},
				{
					"id": 401710458,
					"content": "我打算从两个方向开始，一个就是大海捞针的笨办法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710459
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710459,
					"content": "我在勒拉的周围画下了通往夜神之国的边界之门。就是这个。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710460
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710460,
					"content": "边界之门发动后，会吸引附近所有游离的灵性，运气好的话，就能找到属于勒拉的部分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710461
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710461,
					"content": "#{NICKNAME}，和之前一样，我会把能力暂时借给你，与你共享暝视，但要依靠这个出神香炉才能实现，别忘了先用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710462
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710462,
					"content": "放心，不会再有上次那种意外！你只会感觉自己到了夜神之国，能看见很多游灵，只要把它们都集中起来就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710463
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710463,
					"content": "至于之后的分辨工作，就交给欧洛伦吧，既然他执意要管这件事，就让他干最辛苦的活。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710464
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710464,
					"content": "另一个方向呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710465
					]
				},
				{
					"id": 401710465,
					"content": "利用灵性的本能聚合性质。众所周知，暝视一般都是为了探寻某种神秘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710466
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710466,
					"content": "如果我们能够知道勒拉原本想知道的事，就有可能把他失散的灵性吸引过来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710467
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710467,
					"content": "我会以勒拉的身体为媒介进行暝视，多少能探查出一些勒拉的所思所想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710468
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710468,
					"content": "#噢！我有点听明白了，如果说第一个方法是网鱼，第二个方法就是钓鱼。就像前面欧洛伦让{NICKNAME}用轻小说来钓你一样！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710469
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401710469,
					"content": "唔…派蒙，不举这个例子也没关系的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710470
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401710470,
					"content": "哈？回头再来收拾你们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710471
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710471,
					"content": "但是奶奶，你真厉害，居然可以用人为媒介来进行暝视，我一直以为只能用物品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710472
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 401710472,
					"content": "拍马屁也没用，哼哼。一个人如果失去了灵性，剩下的不过是躯壳，和物品也没什么区别。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710473
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710473,
					"content": "#{NICKNAME}，那边是我的灵性织机，能记录我暝视出的一些破碎片段，在我开始的时候，请你帮忙把它们拼接到织物上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710474
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710474,
					"content": "准备好了就和我说一声，现在要开始干活了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710448,
					"content": "我支持欧洛伦，茜特菈莉才是白痴。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710449
					]
				},
				{
					"id": 401710449,
					"content": "喂！喂！你们都把黑曜石奶奶当成什么了？我当然也有办法！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710452
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710450,
					"content": "茜特菈莉一定还有办法的吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710451
					]
				},
				{
					"id": 401710451,
					"content": "哼哼，那是当然，不然黑曜石奶奶我在这里干什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710452
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710422,
					"content": "下次注意。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710425
					]
				},
				{
					"id": 401710423,
					"content": "模仿游戏？带我一个。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710424
					]
				},
				{
					"id": 401710424,
					"content": "现在不是玩游戏的时候啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710425
					],
					"speakerTitle": "派蒙"
				}
			]
		},
