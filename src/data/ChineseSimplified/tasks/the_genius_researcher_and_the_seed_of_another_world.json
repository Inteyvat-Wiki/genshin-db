					"阿贝多"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110410401,
					"content": "那就是阿贝多吗？为什么他会待在这种地方？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110410402,
					"content": "听说阿贝多他很喜欢画画，在什么地方写生都不奇怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410403
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 110410403,
					"content": "这里视野很好，风景也不错，无论是远景还是近景都值得描绘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410404
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 110410404,
					"content": "但…他有注意到这些丘丘人吗？会不会被突然攻击？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110410405,
					"content": "呜哇？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 1104106,
			"completionStepIds": [
				1104106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104106",
							"2"
						],
						"stepId": 1104106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿贝多"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110410601,
					"content": "你们是谁？为什么要惊扰它们？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410602
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110410602,
					"content": "幸好我的画已经完成，要是没能为特别的丘丘人收尾，就太可惜了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410603,
						110410604
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110410603,
					"content": "原来你在画丘丘人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410605
					]
				},
				{
					"id": 110410605,
					"content": "不过，丘丘人有什么好画的，不都长得差不多吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110410606,
					"content": "嗯…这个问题解释起来比较复杂，不如请你们直接看看我的画吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410607,
						110410608
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110410607,
					"content": "这…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410609
					]
				},
				{
					"id": 110410609,
					"content": "哇，有画得特别认真的，但是，也有一看就非常敷衍的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410610
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110410610,
					"content": "那些都是随处可见的丘丘人，很无聊，不值得浪费时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410611
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110410611,
					"content": "但你看这一只，它的体格，它的毛发，它的姿态，你能看到它与众不同的生命张力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410612
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110410612,
					"content": "在原始族群周而复始的生活中，这种特殊性代表了进化。进化，即是从无到有，从已知到未知…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410613
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110410613,
					"content": "稍等稍等，我有预感会是一篇长篇大论，我可没什么兴趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410614
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 110410614,
					"content": "既然找到了人，我就先走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410615
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 110410615,
					"content": "啊，你没有什么问题想问他吗？喂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410616
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110410616,
					"content": "唉，好奇怪的一个人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410617
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110410617,
					"content": "没想到罗莎莉亚修女会为你们带路。嗯，没来得及向她道谢呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410618
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110410618,
					"content": "话说回来，听她的意思，你们是专程来找我的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410619
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110410619,
					"content": "嗯，没错，我们在蒙德城里遇见了一个叫砂糖的女孩子，她说，你的研究陷入了瓶颈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410620
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110410620,
					"content": "原来如此，是她把你们介绍过来的啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410621
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110410621,
					"content": "那么，我没猜错的话，你就是最近蒙德城里都在议论的那位「荣誉骑士」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410622
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110410622,
					"content": "你在龙灾中的表现、你对于元素力的异常掌控，还有诸多神秘之处，我都有所耳闻…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410623
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110410623,
					"content": "直接说结论吧，可能性只有一种——你是从「另一个世界」远道而来，对吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410624,
						110410625
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110410624,
					"content": "嗯，没错。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410626
					]
				},
				{
					"id": 110410626,
					"content": "太棒了。如果能得到你的协助，我的研究一定可以取得很大的进展。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410627,
						110410628
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110410627,
					"content": "你的研究？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410629
					]
				},
				{
					"id": 110410629,
					"content": "啊，抱歉，想必你现在一定很疑惑吧。从哪里开始解释比较好呢…唔，先讲讲生命的本质？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410630
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110410630,
					"content": "等下等下，这已经很抽象了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410631
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110410631,
					"content": "唔…有道理，比起语言解释，还是让你们看到点什么比较好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410632
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110410632,
					"content": "比如，唤醒生命，让枯枝获得「新生」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410634
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110410634,
					"content": "居然能做到这种事？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410635,
						110410636
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110410635,
					"content": "炼金术真是神奇。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410637
					]
				},
				{
					"id": 110410637,
					"content": "可是…我有一颗特殊的种子。刚刚用的办法，在那个种子上就不奏效了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410639
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110410639,
					"content": "它和你一样，是从另一个世界来的——如何让它生长并盛开，就是我现在遇到的瓶颈，也是需要你协助的研究内容。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410640
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110410640,
					"content": "你都做不到的事，那我们也帮不上忙吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410641
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110410641,
					"content": "当然可以，因为就算是我，也无法想象这个世界以外的生命形式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410642
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110410642,
					"content": "但只要认真观察研究同是来自异世界的你，说不定就能让我找到让种子发芽的灵感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410643
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110410643,
					"content": "原来我是「被研究对象」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410644
					]
				},
				{
					"id": 110410644,
					"content": "#怎、怎么办，{NICKNAME}？我觉得听起来有点奇怪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410645,
						110410647
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110410645,
					"content": "有什么危险吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410646
					]
				},
				{
					"id": 110410646,
					"content": "可能会有，但我会尽最大努力保障你的安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410649
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110410649,
					"content": "事不宜迟，我们先换个地方，赶紧开始研究吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410650
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110410650,
					"content": "(test)镜头转到远处的罗莎莉亚，对话不中断",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410651
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 110410651,
					"content": "阿贝多，还有那个旅行者，好像一拍即合。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410652
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 110410652,
					"content": "这两个人，都是「异类」。蒙德的平稳延续…会被这样的变量影响吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 110410647,
					"content": "有什么报酬吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410648
					]
				},
				{
					"id": 110410648,
					"content": "摩拉，知识，以及你想知道的，又是我知道的答案，这样没问题吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410649
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110410636,
					"content": "炼金术真是方便。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410637
					]
				},
				{
					"id": 110410628,
					"content": "我不是很明白。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410629
					]
				},
				{
					"id": 110410625,
					"content": "你的学识果然名不虚传。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410626
					]
				},
				{
					"id": 110410608,
					"content": "这就是前卫艺术吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410609
					]
				},
				{
