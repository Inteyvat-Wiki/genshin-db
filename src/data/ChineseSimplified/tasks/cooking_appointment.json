	"talks": [
		{
			"id": 1100102,
			"completionStepIds": [
				1100102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1100102",
							"2"
						],
						"stepId": 1100102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"杜拉夫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110010201,
					"content": "你就是香菱，是吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010202
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 110010202,
					"content": "对不起，杜拉夫先生，是我的不对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010203
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110010203,
					"content": "你做的那些事我都听说了。既然你人都来了——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010204
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 110010204,
					"content": "好、好可怕！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010205,
						110010206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110010205,
					"content": "暴、暴力是不对的！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110010207
					]
				},
				{
					"id": 110010207,
					"content": "——请帮帮我们推广我们的肉产品吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010208
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 110010208,
					"content": "…啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010209
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110010209,
					"content": "不好意思，唐突了点，我这就跟你们解释。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010210
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 110010210,
					"content": "清泉镇向来以高品质的肉类闻名，但它的名声不应该只局限在蒙德。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010211
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 110010211,
					"content": "正好我听说大厨香菱来了蒙德，我就马上叫艾伦把你请过来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010212
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 110010212,
					"content": "大厨？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110010213,
					"content": "你没听过吗？在璃月港独树一帜，主打平民菜品的「万民堂」，就是香菱掌厨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010214
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 110010214,
					"content": "她对食材有独特的理解，做出来的菜深受当地居民喜爱，在游客中也是好评如潮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010215
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 110010215,
					"content": "嘿嘿，说得太夸张啦。我只是想做出便宜又好吃的东西而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010216
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110010216,
					"content": "像香菱这样一流的大厨，用一流的肉做出一流的料理，我们清泉镇的肉就能声名远扬了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010217
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 110010217,
					"content": "可是…这个请求我觉得我做不到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010218
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110010218,
					"content": "我只考虑过怎么做出好吃的菜，没限制过食材，更没做过宣传。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010219
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110010219,
					"content": "反正肉也是你想用的食材，我觉得没什么区别吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010220
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 110010220,
					"content": "有区别，有很大的区别！比如我要加史莱姆凝液进去你会同意吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010221
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110010221,
					"content": "这、这确实有点…不能用稍微正常一点的食材吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010222
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 110010222,
					"content": "食材是没有正常不正常的！无论是什么只要方法得当，都能做出美味佳肴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010223
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110010223,
					"content": "我不能让材料束缚我的灵感，那样做出来的东西注定是无聊的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010224,
						110010225
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110010224,
					"content": "气场突然变得好强…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110010226
					]
				},
				{
					"id": 110010226,
					"content": "唉，既然态度这么坚决，那就算了吧。但是真的很可惜啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 110010225,
					"content": "这就是大厨的执着吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110010226
					]
				},
				{
					"id": 110010206,
					"content": "真要动手的话…冲着我来吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110010207
					]
				}
			]
		},
		{
			"id": 1100104,
			"completionStepIds": [
				1100104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1100104",
							"2"
						],
						"stepId": 1100104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"香菱"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110010401,
					"content": "你好，你做的这个料理我可以尝尝看吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010402
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110010402,
					"content": "不好意思，这几天的份都预定满了，想吃的话要排到七天以后，可以吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010403
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 110010403,
					"content": "这么受欢迎啊…那一定很好吃！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110010404,
					"content": "奇怪，明明有这么受欢迎的厨师…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110010405
					]
				},
				{
					"id": 110010405,
					"content": "对哦，为什么杜拉夫先生还要找香菱啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110010406,
					"content": "唉…可能是他觉得蒙德比起璃月港那种全大陆的商业枢纽，口味不够大众吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010407
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 110010407,
					"content": "但我不服气！我从来不觉得我做出来的肉会输给谁！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010408
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 110010408,
					"content": "那就破例给我露一手嘛，或许我还能提一些建议什么的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010409
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110010409,
					"content": "普通人只会说「好吃」之类没用的话，你又不是呃…等等…你就是香菱？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010410
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 110010410,
					"content": "嗯，对啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010411
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110010411,
					"content": "原来就是你！那你一定也很会做肉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010412
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 110010412,
					"content": "其实我这里还留了一块今天最好的肉，如果让你来做烤肉，你会怎么做？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010413
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 110010413,
					"content": "那要看肉质和脂肪含量了，这块肉我应该会岩烤，搭配海盐，绝云椒椒和清心花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010414
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110010414,
					"content": "清心花？！它遇热油香味会大量释放，比生冷时浓郁好几倍，肉的香味都会被盖掉的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010415
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 110010415,
					"content": "我知道的哦，但这清心花不是肉排的香料，而是配菜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010416
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110010416,
					"content": "我尝试过，只要火候得当，过了油的清心花花瓣的苦味会被去除，变成口感爽脆的点心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010417
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110010417,
					"content": "再选取长在高山上的绝云椒椒。低湿度和大温差，使得它能够产生特殊的干香风味。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010418
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110010418,
					"content": "海盐的咸，绝云椒椒的辣，肉排油脂的鲜香，汇聚在花瓣上，咬下去还有植物的清香。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010419
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110010419,
					"content": "花里胡哨的，这不是喧宾夺主了吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010420
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 110010420,
					"content": "烤肉就是烤肉，肉香被盖住了还吃什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010421
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 110010421,
					"content": "呜哇，别吵架，不要吵架啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010422,
						110010423
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110010422,
					"content": "已经听不到其他人的声音了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110010424
					]
				},
				{
					"id": 110010424,
					"content": "哼，既然这样，烹饪的问题就用烹饪来解决好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010425
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110010425,
					"content": "我要和你切磋厨艺！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010426
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110010426,
					"content": "完全没问题，要是连我的料理都比不过，那就证明杜拉夫是看走眼了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010427
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 110010427,
					"content": "好啊，那这样吧，如果我赢了，我获胜的料理就用来宣传清泉镇！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010428
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110010428,
					"content": "你输了的话，就在「万民堂」的菜单上加上我的这道菜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010429
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 110010429,
					"content": "上面还要写上，清泉镇肉类大师布洛克之作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010430
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 110010430,
					"content": "一言为定！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010431
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110010431,
					"content": "我先走一步去找食材了！在璃月等你们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010432
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110010432,
					"content": "喂，等等啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010433
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110010433,
					"content": "#{NICKNAME}，只能跟上去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110010423,
					"content": "这就是所谓的棋逢对手吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110010424
					]
				}
			]
		}
	]
}