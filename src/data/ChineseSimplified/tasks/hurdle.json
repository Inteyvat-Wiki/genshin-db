						3880302
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3880302,
					"content": "丘丘人…通常，它们不太会在元素浓度过高的区域活动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3880303
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3880303,
					"content": "在这里，它们的身体要承受更大的负担…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3880304
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3880304,
					"content": "想必就是深渊教团在背后操控吧，但它们应该不能确定我们会来这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3880305
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3880305,
					"content": "为了阻止我们的行动，教团恐怕正在向四处投放兵力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3880306
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3880306,
					"content": "那么，事不宜迟——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3880307
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3880307,
					"content": "这次的听众只是「风」而已，拨弦的速度加快一点也无所谓吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "温迪"
