				},
				{
					"id": 3880102,
					"content": "哇…真是看起来非常危险的景观。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3880103
					],
					"speakerTitle": "派蒙"
				},
				{
