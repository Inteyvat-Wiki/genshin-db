			"dialogs": [
				{
					"id": 740580201,
					"content": "竟然…有这么多吗，真是帮大忙了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580202
					],
					"speakerTitle": "切瑟尔"
				},
				{
					"id": 740580202,
					"content": "虽然好像因为工匠对这种宝石的品性不太了解的缘故，导致出了一些问题…上次送去加工的宝石，到现在也还没有拿到成品…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580203
					],
					"speakerTitle": "切瑟尔"
				},
				{
					"id": 740580203,
					"content": "不过没关系，我相信我的眼光。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580204
					],
					"speakerTitle": "切瑟尔"
				},
				{
					"id": 740580204,
					"content": "我打算把它们加工成最时兴的首饰款式，到时候一定会风靡整个枫丹的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580205
					],
					"speakerTitle": "切瑟尔"
				},
				{
					"id": 740580205,
					"content": "等下次你们来的时候应该就能看到成品了！到时候，我也会赠送一些样品给你们作为报酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580206
					],
					"speakerTitle": "切瑟尔"
				},
				{
					"id": 740580206,
					"content": "不过，也说不定你们会在那些上流社会的贵人身上先看到呢，哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580207
					],
					"speakerTitle": "切瑟尔"
				},
				{
					"id": 740580207,
					"content": "那么，也欢迎你们再次光临。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "切瑟尔"
				}
			]
