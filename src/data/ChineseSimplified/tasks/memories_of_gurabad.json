			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"利露帕尔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733050401,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050402
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 733050402,
					"content": "唔…利露帕尔，你还好吗？怎么突然没反应啦…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050403,
						733050404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733050403,
					"content": "嘘…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050405
					]
				},
				{
					"id": 733050405,
					"content": "等等，你看…她在发光呢。和平时不太一样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733050406,
					"content": "镇灵的魔瓶微微闪光，似乎与「棋子」的振动同调。\\n你听到时间在流逝，就像监牢中的水滴声…似乎长达一生，又或短则一瞬。\\n而利露帕尔没有说话。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050407
					]
				},
				{
					"id": 733050407,
					"content": "然后，迷雾中你看到了那座巨城，庞大、臃肿而冷漠。\\n大地张开裂口，吞没了居尔城的一切…\\n而它的城门就在那里，镶嵌在山壁之上，它如此丑陋，仿佛集聚了古老世界的一切污秽，却免于为众目所观…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050408
					]
				},
				{
					"id": 733050408,
					"content": "它在那里，居尔城。我记起来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050409
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 733050409,
					"content": "我的头好痛…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050410
					]
				},
				{
					"id": 733050410,
					"content": "呜哇，你们怎么回事啦…下次再这样提前通知我呀！不要总是吓我一跳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050411,
						733050413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733050411,
					"content": "对不起啦，派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050412
					]
				},
				{
					"id": 733050412,
					"content": "哼，反正我是生气啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733050415,
					"content": "#噗…小孩子一样呢，好啦，不要担心了。我会把{M#他}{F#她}还给你的，小家伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050416
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 733050416,
					"content": "#到时候，{M#他}{F#她}还要赔偿你好多好吃的呢…嗯，还有「牟拉」，你们的钱币，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050417,
						733050418
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 733050417,
					"content": "是「摩拉」…我为什么要纠正你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050419
					]
				},
				{
					"id": 733050419,
					"content": "这还差不多嘛…我记下来咯！好吃的，还有摩拉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050420
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733050420,
					"content": "好了，儿童时间结束，我们前往居尔城吧，我的大人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050421,
						733050424
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 733050421,
					"content": "我们为什么要去那里？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050422
					]
				},
				{
					"id": 733050422,
					"content": "为什么？我不知道…或许理由根本不重要，但我需要去那里。所以，我的大人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050423
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 733050423,
					"content": "如果非要一个理由，那么就是我希望您见证我的过去，见证我的教训。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050428
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 733050428,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050429
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733050429,
					"content": "虽然没头没尾的…我也没听太懂就是啦，但你这话说得好像要告别一样，是发生什么事了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050430
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733050430,
					"content": "哈哈，没什么…只是，有些东西，我想要让你们见识一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050431
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 733050431,
					"content": "什么嘛，一把年纪了说话还支支吾吾的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050432
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733050432,
					"content": "总之，请您跟着我前来吧，我为您指引居尔城的位置…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 733050424,
					"content": "居尔城…那里有什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050425
					]
				},
				{
					"id": 733050425,
					"content": "什么都没有，什么也没有留下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050426
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 733050426,
					"content": "残留在那里的，只有鬼魂的回忆、无法复原的碎梦和复仇甜美的余味…我会这样说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050427
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 733050427,
					"content": "虽然这个请求有点过分…但我希望您见证我的过去，见证我的教训。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050428
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 733050418,
					"content": "不要擅自替我下决定…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050419
					]
				},
				{
					"id": 733050413,
					"content": "我没事的，派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050414
					]
				},
				{
					"id": 733050414,
					"content": "哼，每次你都这么说！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733050404,
					"content": "利露帕尔？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050405
					]
				}
			]
		},
		{
			"id": 7330506,
			"completionStepIds": [
				7330506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7330506",
							"2"
						],
						"stepId": 7330506,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7330505",
							"3"
						],
						"stepId": 7330505,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"利露帕尔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733050601,
					"content": "呜哇！刚刚我们还在「棋子」旁边，「唰——」的一下就到这里啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733050602,
					"content": "这是怎么回事呀，好厉害！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050603
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733050603,
					"content": "呵呵，还想再来一遍吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050604,
						733050606
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 733050604,
					"content": "再来一遍，再来一遍！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050605
					]
				},
				{
					"id": 733050605,
					"content": "收敛点啦！你是小孩子吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050608
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733050608,
					"content": "很正常，坐标偏转了。可能是因为老化的原因…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050609
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 733050609,
					"content": "欸…这不是我们最初来过的那座峡谷吗？你带我们来这里干什么呀？这里有什么值得一看的东西吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050610
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733050610,
					"content": "问题太多了，小家伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050611
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 733050611,
					"content": "奇怪…应该就在这里的…啊，在这！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 733050606,
					"content": "还是不了，我有点晕…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050607
					]
				},
				{
					"id": 733050607,
					"content": "唔…这么说来，我也有点晕晕的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050608
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7330509,
			"completionStepIds": [
				7330509
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7330509",
							"2"
						],
						"stepId": 7330509,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7330510",
							"3"
						],
						"stepId": 7330510,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"利露帕尔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733050901,
					"content": "随着闪光的碎片汇入利露帕尔的魔瓶，你感到自身的力量也被抽离了少许…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050902
					]
				},
				{
					"id": 733050902,
					"content": "「希鲁伊，正是胡拉姆丁。」\\n头戴黄铜面具者如是说。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050903
					]
				},
				{
					"id": 733050903,
					"content": "「你名下的人必不留后；我必从你神的庙中除灭诸多偶像；我必因你卑鄙，使你归于坟墓。」\\n头戴黄铜面具者如是说。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050904
					]
				},
				{
					"id": 733050904,
					"content": "从镇灵恍惚的目光中，你望见了居尔城被黑暗吞没时的景象…\\n居尔城自古如蓄水大池，如今住民却如洪流般四散奔逃。\\n毫无智性的镇灵从冷酷的机械、兵士们的武器之中喷涌…朱红的酒，石榴的汁液随之而至，爆散而出…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050905
					]
				},
				{
					"id": 733050905,
					"content": "石榴翻滚开裂，又被践踏成泥、混作一团…饱满或萎缩、富贵或卑贱…猩红的果实纷纷呼号着胡拉姆丁的到来——生命的欢乐，复仇的欢欣。\\n汁液的滋味甜美醇厚如醴，泉涌满城，化作红色的汪洋大海…\\n大海先淹没奴隶，然后主子才漂浮在黑夜的汪洋中哀嚎。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050906
					]
				},
				{
					"id": 733050906,
					"content": "最后，你望见黄铜面具的王。他遁入阴影，遁入希琳的怀抱…\\n她的容颜苍老模糊，生命与理智的痕迹如夜风中的尘埃般消逝了。\\n还有那化为黑色魔兽的基斯拉王…他们皆是你的血脉，但你却为此欣喜不已——你为报应而狂喜。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050907
					]
				},
				{
					"id": 733050907,
					"content": "居尔城啊，你的创伤无法救治，你的羞耻为众目所观…\\n听见这消息的人必鼓掌欢呼——\\n因为谁没受过你无休止的暴虐呢？",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050908
					]
				},
				{
					"id": 733050908,
					"content": "「居尔城啊，你的创伤无法救治，你的羞耻为众目所观…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050909,
						733050910
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 733050909,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050911
					]
				},
				{
					"id": 733050911,
					"content": "奥尔玛兹曾是利露帕尔的爱人，他因镇灵的爱而从牧羊人成为人中之王。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050912
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 733050912,
					"content": "我曾以为他会是超越凡人的伴侣，我愚蠢地爱上他的双眼…但为王的虚荣与自私终究攫住了他…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050913
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 733050913,
					"content": "他与朝生暮死的凡人诸王没有任何区别…只知徜徉在征服与迫害的迷梦之中，以流沙为基搭建宫阙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050914
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 733050914,
					"content": "于是，你谋害了他…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050915
					]
				},
				{
					"id": 733050915,
					"content": "我说过，我惩罚了他。由父及子，直至三代。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050916
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 733050916,
					"content": "基斯拉·帕维兹拉万，希琳，皆是我的血脉…我用血的阴谋、蜜的极刑，与狂暴的野心，惩罚了他们所有人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050917
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 733050917,
					"content": "不仅如此…唉，不仅如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050918,
						733050919
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 733050918,
					"content": "关于「惩罚」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050920
					]
				},
				{
					"id": 733050920,
					"content": "虚荣的帕维兹拉万，我的爱子…他想要无穷的权力，我便给了他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050921
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 733050921,
					"content": "我为他设计了用镇灵残魄驱使的机械，在深黑的梦中启发他建立起流水般吞吐人工造物的庞大机械…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050922
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 733050922,
					"content": "它们带来了无穷的财富，却也夺走了劳役者的生命力，剥夺了农人的财产。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050923
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 733050923,
					"content": "王公与富商们纷纷含泪激赏——这是凡人的凯旋，这是奴役的结束。但我明知，只有我明晓…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050924
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 733050924,
					"content": "奴隶的取缔，正是无穷残虐奴役的开始——奴隶主被解脱了抚养奴隶的义务，而奴隶被剥夺了免于饥馁的小小恩惠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050925
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 733050925,
					"content": "我…我已经开始听不懂了…你这是在说什么呀…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050926
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733050926,
					"content": "贫苦伴生仇恨，仇恨催化野心…富裕蔓生贪婪，贪婪亦燃发野心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050927
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 733050927,
					"content": "野心令他逼迫王后希琳——亦是他的亲生姐姐产出无智性的畸形镇灵…而她的痛苦取悦了我，也给我力量…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050928
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 733050928,
					"content": "…令我得以将他们的骨肉抚养长大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050929,
						733050932
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 733050929,
					"content": "你是说希鲁伊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050930
					]
				},
				{
					"id": 733050930,
					"content": "希鲁伊，就是「黄铜面具」胡拉姆丁。贱民与奴隶视他为女主人的使者，视他如苦难中降临的拯救者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050931
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 733050931,
					"content": "于是，他引导他们拥抱正义…拥抱灭亡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050935
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 733050935,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050936
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733050936,
					"content": "嗯？原来你还在这呢，小家伙…怎么不说话了呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050937
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 733050937,
					"content": "嗯…只是，我完全没听懂…而且，听起来好可怕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050938
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733050938,
					"content": "没什么，没什么…我刚刚所说的都是我的过去，与我的命运。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050939
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 733050939,
					"content": "哦…我…我不知道该说什么啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050940
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733050940,
					"content": "多谢您的陪伴，我才能再度回到女主人的花园…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050941
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 733050941,
					"content": "欸…为什么突然说这个呀…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050942
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733050942,
					"content": "居尔城，是我的命运之地。我要返回这座城中，还有使命在等着我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050943
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 733050943,
					"content": "唔…因为你以前做了很多错事，所以你要回去弥补…是这样吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050944
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733050944,
					"content": "错事…？噗…我没什么做错的事。但我的孩子们还在那里，她和希鲁伊…一定很寂寞吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050945
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 733050945,
					"content": "你的意思是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050946
					]
				},
				{
					"id": 733050946,
					"content": "漆黑的力量愈发强大了…能直面它的，只有母亲的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050947
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 733050947,
					"content": "我曾以为我能利用漆黑的深渊，对我所憎恨的施以惩罚…但我业已遭受了报应…进入居尔城，直面它的报复，也将是我的使命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050948
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 733050948,
					"content": "我的大人…很抱歉，没能多陪在您的身边一会儿，没能多熟悉您片刻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050949
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 733050949,
					"content": "但我明白，命运一定会驱使我们再次相见。您拥有不受腐化的品质，我相信…我的选择会是正确的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050950,
						733050951
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 733050950,
					"content": "你的选择…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050952
					]
				},
				{
					"id": 733050952,
					"content": "常理来说，并非主人选择镇灵，而是镇灵选择主人。即使离去，我想我们的联系也不会这样简单地结束…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050953
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 733050953,
					"content": "所以…请接受我的最后一件礼物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050954
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 733050954,
					"content": "请您将我捧在耳边…再一次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050955
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 733050955,
					"content": "你将魔瓶轻轻捧在耳边…\\n伴随着一阵轻笑，你听到有人用无比柔和雅致的语言在你的耳旁柔声低语…\\n她所倾诉的东西就像泉流一样难测，但你一字不落地听懂了。\\n最后，话语消散，仅在你的耳廓留下一丝清冷的余韵…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050956
					]
				},
				{
					"id": 733050956,
					"content": "透过她的指点，你熟识了古代的韵文…\\n但她却不再言语。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050957
					]
				},
				{
					"id": 733050957,
					"content": "欸…你看，瓶子里的光变暗了…利露帕尔，你还好吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050958
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733050958,
					"content": "利露帕尔…利露帕尔…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050959
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733050959,
					"content": "（瓶子的光芒渐暗，又逐渐恢复了闪烁。但她已经不再言语。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050960,
						733050961
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 733050960,
					"content": "她离开了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050962
					]
				},
				{
					"id": 733050962,
					"content": "这样吗…结果，真的是告别呀…我们以后还会再见到她吗…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050963
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733050963,
					"content": "唔…我们…也回去吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733050961,
					"content": "居尔城…在等待着她。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050962
					]
				},
				{
					"id": 733050951,
					"content": "你要离开了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050952
					]
				},
				{
					"id": 733050932,
					"content": "「黄铜面具」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050933
					]
				},
				{
					"id": 733050933,
					"content": "啊…胡拉姆丁，就是戴黄铜面具的希鲁伊王。「女主人的使者」、「穷困者与奴隶的拯救者」，哈哈，高明的骗子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050934
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 733050934,
					"content": "终究，他引导那些追随他的人归于漆黑的灭亡…连同这整座居尔城，被大地吞入漆黑的裂口。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050935
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 733050919,
					"content": "关于居尔城的结局…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050920
					]
				},
				{
					"id": 733050910,
					"content": "所以…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050911
					]
				}
			]
		},
