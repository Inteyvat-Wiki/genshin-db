				]
			},
			"dialogs": [
				{
					"id": 150020401,
					"content": "基尼奇，我知道特立尼达长老找你的时候你为什么没答应了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150020402,
					"content": "其实你早就知道这是个烫手山芋吧？还说什么额外的价格，你的借口好狡猾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150020403,
					"content": "烫手山芋是真的，但借口也不假。要解决这件事，确实要付额外的代价。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020404
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020404,
					"content": "你有办法？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020405
					]
				},
				{
					"id": 150020405,
					"content": "我在尝试。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020406
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020406,
					"content": "真的吗？快说出来让我们听听！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150020407,
					"content": "派蒙，我记得你之前说有事想找我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020408
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020408,
					"content": "对哦，是什么来着？我想想…噢！我要跟你投诉阿乔，因为它实在是太没礼貌了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150020409,
					"content": "它今天怎么不在？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020410
					]
				},
				{
					"id": 150020410,
					"content": "它的性格确实是问题。所以我请了一位老师教育它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020411
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020411,
					"content": "教育？有点想看它被老师狠狠教训的样子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150020412,
					"content": "不过我们遇见阿乔的时候，它说你们在调查什么深渊气息…和这件事有关吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150020413,
					"content": "嗯，那就是我在尝试的办法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020414
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020414,
					"content": "我是个猎龙人，偶尔也猎深渊。有一次，我在追捕一种紫色魔犬时，曾误入了一处隐秘的空间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020415
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020415,
					"content": "后来我查了一些资料，才知道那里叫做兽境。兽境有大大小小很多个，那种紫色魔犬就是从那里面跑出来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020416
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020416,
					"content": "所以…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020417
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150020417,
					"content": "如果我们能找到一处兽境并清空它，然后把山王安放在其中…它就既能活着，也无法威胁到部族了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020418
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020418,
					"content": "天呢！听起来有点疯狂…这能行吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020419
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150020419,
					"content": "当然还有不少问题，比如山王在兽境待久了状况会不会变得更糟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020420
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020420,
					"content": "但即使是权宜之计，也是我们急需的。族内的矛盾不是一两天了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020421
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020421,
					"content": "首领认为无论如何都要保住山王。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020422
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020422,
					"content": "我明白…他不是要保住山王，其实是要保住你们的文化和荣耀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020423
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150020423,
					"content": "嗯，但另一方，像特立尼达长老这样的，他更在乎当下、未来、还有身边的人们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020424
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020424,
					"content": "这也很好理解，为了守住一份过去的荣光，却用亲友的生命来支付代价…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020425
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020425,
					"content": "谁也不能替他们说，这很划算。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020426
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020426,
					"content": "真是个难题…先把这个放一边吧，就算按照你的计划来，你又打算去哪里找兽境呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020427
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150020427,
					"content": "从来都是那些猎犬突然从兽境裂隙钻出来凶我们，可没有我们钻过去凶它们的时候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020428
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150020428,
					"content": "我已经有了眉目。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020429
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020429,
					"content": "你真打算这么干？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020430
					]
				},
				{
					"id": 150020430,
					"content": "你们有第二个办法吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020431
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020431,
					"content": "暂时也没有…只是觉得，利用深渊力量会变得不幸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020432
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150020432,
					"content": "这可是害山王变成这样的深渊力量欸，其他人肯定不能理解你的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020433
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150020433,
					"content": "如果真有什么不幸，那就是代价吧。世上所有事情都被标了价，窃火的尤潘基大人也没能「免费」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020434
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020434,
					"content": "这次山王的突然暴动，让族里的矛盾变得更加尖利，如果不能尽快化解，谁也无法往前走的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020435
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020435,
					"content": "好吧…那你想和我们谈什么交易啊？我们对深渊力量也没有什么研究…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020436
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150020436,
					"content": "你们只要能帮我争取一些空间就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020437
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020437,
					"content": "每天都有不少人来劝我，希望我能担任这次的游火人。我不想把精力浪费在应付他们身上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020438
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020438,
					"content": "如果你们能帮我，我可以送你们一件礼物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020439
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020439,
					"content": "什么礼物？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020440
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150020440,
					"content": "应该能值回票价的礼物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020441
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020441,
					"content": "那你想我们怎么做？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020442
					]
				},
				{
					"id": 150020442,
					"content": "和现在一样，在族里混个脸熟，让大家都知道我们要有一位新的游火人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020443
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020443,
					"content": "这样我就可以避开无尽的要我去主持仪式的请求，去搞定召唤兽境的办法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020444
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020444,
					"content": "等到仪式那天，我们来给山王搬个家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020445
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020445,
					"content": "好疯狂…基尼奇，你身上的冒险精神是不是有点过头了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020446
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150020446,
					"content": "你有想过，万一首领和特立尼达长老他们都不喜欢这个结果会怎么样吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020447
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150020447,
					"content": "那他们至少又站上同一阵线，对立面变成我而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020448
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020448,
					"content": "部族需要的正是他们这种领袖，不是我这种拿钱办事的猎龙人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020449
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020449,
					"content": "这次可没人付钱给你了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020450
					]
				},
				{
					"id": 150020450,
					"content": "哈，我可以理解为你同意了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020451
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020451,
					"content": "我们可以先试试。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020452
					]
				},
				{
					"id": 150020452,
					"content": "没错，说不定这几天又想到更好的办法了呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020453
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150020453,
					"content": "嗯，接下来几天，希望你们多在族内逛一逛，帮帮忙，相信大家肯定会为你这位游火人的魅力倾倒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020454
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020454,
					"content": "祝我们顺利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "基尼奇"
				}
			]
		}
	]
}