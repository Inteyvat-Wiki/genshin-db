			"dialogs": [
				{
					"id": 150020301,
					"content": "你们来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020302
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020302,
					"content": "基尼奇！特立尼达长老他说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150020303,
					"content": "嗯，你们脸上已经写了答案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020304
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020304,
					"content": "#{NICKNAME}和派蒙？没有迎接两位的到访，是我作为一族首领的失职。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020305
					],
					"speakerTitle": "瓦伊纳",
					"speakerSubtitle": "悬木人首领"
				},
				{
					"id": 150020305,
					"content": "瓦伊纳首领，你好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150020306,
					"content": "我昨天才从特立尼达那里得知消息，所以托基尼奇请两位过来一叙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020307
					],
					"speakerTitle": "瓦伊纳",
					"speakerSubtitle": "悬木人首领"
				},
				{
					"id": 150020307,
					"content": "不用这么客气。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020308
					]
				},
				{
					"id": 150020308,
					"content": "呵呵，基尼奇应该已经告诉了你们情况，那闲话我也不多说了。我很赞同两位来主持回火夜的仪式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020309
					],
					"speakerTitle": "瓦伊纳",
					"speakerSubtitle": "悬木人首领"
				},
				{
					"id": 150020309,
					"content": "但我有一个请求：希望两位能确保山王的安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020310
					],
					"speakerTitle": "瓦伊纳",
					"speakerSubtitle": "悬木人首领"
				},
				{
					"id": 150020310,
					"content": "悬木人的孩子都是听着部族的英雄传说长大的，从窃火的尤潘基，到征战深渊的布基纳和山王…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020311
					],
					"speakerTitle": "瓦伊纳",
					"speakerSubtitle": "悬木人首领"
				},
				{
					"id": 150020311,
					"content": "那是给予我们骄傲与信念的宝贵历史。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020312
					],
					"speakerTitle": "瓦伊纳",
					"speakerSubtitle": "悬木人首领"
				},
				{
					"id": 150020312,
					"content": "现在要杀死山王，无异于要杀死我们自己的精神。如果发生这样的事，我将无颜面对夜神之国的祖先。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020313
					],
					"speakerTitle": "瓦伊纳",
					"speakerSubtitle": "悬木人首领"
				},
				{
					"id": 150020313,
					"content": "我为南娜的事悲伤，所以我不会苛责特立尼达。但为了部族，绝不能让山王有生命危险，这是悬木人的立身之根。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020314
					],
					"speakerTitle": "瓦伊纳",
					"speakerSubtitle": "悬木人首领"
				},
				{
					"id": 150020314,
					"content": "希望两位贵客能慎重考虑这件事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020315
					],
					"speakerTitle": "瓦伊纳",
					"speakerSubtitle": "悬木人首领"
				},
				{
					"id": 150020315,
					"content": "就没有两全其美的办法吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020316
					]
				},
				{
					"id": 150020316,
					"content": "或许有，但还没显现出来。我们已经做过许多尝试。现在，我希望能听见两位的态度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020317,
						150020319,
						150020321,
						150020323
					],
					"speakerTitle": "瓦伊纳",
					"speakerSubtitle": "悬木人首领"
				},
				{
					"id": 150020317,
					"content": "或许我会尊重首领的意见。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020318
					]
				},
				{
					"id": 150020318,
					"content": "虽然知道您可能还没有完全想好，但听见您这样说，我还是放心了许多。离仪式还有三天，到时候希望您能确定自己的心意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020326
					],
					"speakerTitle": "瓦伊纳",
					"speakerSubtitle": "悬木人首领"
				},
				{
					"id": 150020326,
					"content": "对了基尼奇，你刚刚不是说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020327
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150020327,
					"content": "#{NICKNAME}，派蒙，我带你们去族里走走吧，顺便聊一聊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020328
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020328,
					"content": "也好…我们可能是需要暂时换换脑子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150020319,
					"content": "或许我会尊重特立尼达长老的意见。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020320
					]
				},
				{
					"id": 150020320,
					"content": "您的想法令人担忧，但我知道您肯定还在考虑中，没关系。离仪式还有三天，到时候希望您能确定自己的心意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020326
					],
					"speakerTitle": "瓦伊纳",
					"speakerSubtitle": "悬木人首领"
				},
				{
					"id": 150020321,
					"content": "我还需要考虑一下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020322
					]
				},
				{
					"id": 150020322,
					"content": "我明白，离仪式还有三天，到时候希望您能确定自己的心意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020326
					],
					"speakerTitle": "瓦伊纳",
					"speakerSubtitle": "悬木人首领"
				},
				{
					"id": 150020323,
					"content": "派蒙，我们今晚就溜去其他部族吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020324
					]
				},
				{
					"id": 150020324,
					"content": "但是事情放在这里，它也不会自己解决的…我知道你肯定也没想好要怎么办，没关系，我们可以一起来想办法！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020325
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150020325,
					"content": "感谢您，离仪式还有三天，到时候希望您能确定自己的心意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020326
					],
					"speakerTitle": "瓦伊纳",
					"speakerSubtitle": "悬木人首领"
				}
			]
		},
