					}
				]
			},
			"dialogs": [
				{
					"id": 150020101,
					"content": "异邦的强者，你们来了，休息得还好吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020102
					],
					"speakerTitle": "特立尼达"
				},
				{
					"id": 150020102,
					"content": "还…还不错哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150020103,
					"content": "那就好。我这边的进展也很顺利，不少长老都听说过您的事迹，包括首领在内，都对您表示了认可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020104
					],
					"speakerTitle": "特立尼达"
				},
				{
					"id": 150020104,
					"content": "虽然也还有人坚持仪式应由「马{RUBY#[D]回火}力卜」的继承者来主持，但这种想法实在陈旧，我们得与时俱进。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020105
					],
					"speakerTitle": "特立尼达"
				},
				{
					"id": 150020105,
					"content": "基尼奇好像自己也不想来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150020106,
					"content": "没错，所以现在我们可以说一下仪式的细节了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020107
					],
					"speakerTitle": "特立尼达"
				},
				{
					"id": 150020107,
					"content": "昨天我已经告知过您传火仪式的部分，在这之后，就是净化山王的部分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020108
					],
					"speakerTitle": "特立尼达"
				},
				{
					"id": 150020108,
					"content": "要怎么净化？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020109
					]
				},
				{
					"id": 150020109,
					"content": "很简单，用圣火就行。这么多年的仪式，我们对这项工作都已经非常熟悉。对您肯定也没什么难度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020110
					],
					"speakerTitle": "特立尼达"
				},
				{
					"id": 150020110,
					"content": "而我要说的关键在于，希望您可以用圣火驱散尽可能多的深渊能量，这样可以最大化维持山王的沉睡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020111
					],
					"speakerTitle": "特立尼达"
				},
				{
					"id": 150020111,
					"content": "就只是维持沉睡么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150020112,
					"content": "没错。往年的仪式里，游火人往往无法驱散足够多的深渊能量，所以我们才需要定期重复这一仪式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020113
					],
					"speakerTitle": "特立尼达"
				},
				{
					"id": 150020113,
					"content": "但我知道，您在对抗深渊方面很有经验。昨天您对圣火的使用也十分老道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020114
					],
					"speakerTitle": "特立尼达"
				},
				{
					"id": 150020114,
					"content": "我想，如果是您的话，或许能够将山王体内的深渊能量全部驱散。这样就能保护我们在很长时间内免遭威胁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020115
					],
					"speakerTitle": "特立尼达"
				},
				{
					"id": 150020115,
					"content": "#{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150020116,
					"content": "知道了。还有别的要注意的吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020117
					]
				},
				{
					"id": 150020117,
					"content": "您听到这个要求居然一点也不担忧，看来是对自己很有信心了，哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020118
					],
					"speakerTitle": "特立尼达"
				},
				{
					"id": 150020118,
					"content": "其他就没有特别需要注意的了，仪式定在三天之后，届时我会再来通知您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020119
					],
					"speakerTitle": "特立尼达"
				},
				{
					"id": 150020119,
					"content": "这段时间如果您有空，可以在部族里转一转。长老们也希望您能多在族人面前露露脸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020120
					],
					"speakerTitle": "特立尼达"
				},
				{
					"id": 150020120,
					"content": "要是您还愿意顺手解决一些族人们的麻烦，那就再好不过了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020121
					],
					"speakerTitle": "特立尼达"
				},
				{
					"id": 150020121,
					"content": "还要帮别人解决麻烦啊？这算不算额外的价格…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150020122,
					"content": "哈哈，这只是小小的建议。我真心认为您这样的英雄，值得在部族里获得更多声望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020123
					],
					"speakerTitle": "特立尼达"
				},
				{
					"id": 150020123,
					"content": "这几天我都会待在族内，如果有什么问题，可以随时找我解决。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "特立尼达"
				}
			]
		},
