			},
			"dialogs": [
				{
					"id": 150020201,
					"content": "#{NICKNAME}，派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020202
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020202,
					"content": "基尼奇！居然在这里见到你！我们先前还想找找你呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150020203,
					"content": "你好，又见面了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020204
					]
				},
				{
					"id": 150020204,
					"content": "我就开门见山了。我听说，你们接受了特立尼达长老的邀请？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020205
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020205,
					"content": "啊！那个…你是说回火夜吗？呃…长老说本来是要请你去的…但是…哎呀…该怎么说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150020206,
					"content": "别紧张，我是有重要的事告诉你们：特立尼达长老可能隐瞒了他的真正目的，他想一次性解决山王的问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020207
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020207,
					"content": "一次性解决？以后不办回火夜啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150020208,
					"content": "对，他希望借你们之手，让山王回归夜神的国度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020209
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020209,
					"content": "回归夜神的国度…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150020210,
					"content": "就是送山王去死。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020211
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020211,
					"content": "等一下！等一下！你能不能别这么直接…我有点不敢相信…这是真的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150020212,
					"content": "你想要我委婉一点？嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020213
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020213,
					"content": "可能也许说不定是这样…特立尼达长老希望你们杀了山王。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020214
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020214,
					"content": "怎么会这样…山王不是你们活着的荣耀吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150020215,
					"content": "荣耀背后也有代价。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020216
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020216,
					"content": "没错，山王是我们活着的荣耀，但这荣耀也伴随代价。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020217
					],
					"speakerTitle": "特立尼达",
					"speakerSubtitle": "悬木人长老"
				},
				{
					"id": 150020217,
					"content": "唉…南娜已经不是第一个了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020218
					],
					"speakerTitle": "特立尼达",
					"speakerSubtitle": "悬木人长老"
				},
				{
					"id": 150020218,
					"content": "是因为他的龙伙伴南娜吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020219
					]
				},
				{
					"id": 150020219,
					"content": "嗯，南娜大概也不是最后一个。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020220
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020220,
					"content": "但…就直接要杀死山王吗？这好像也太极端了点…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150020221,
					"content": "那他要怎么杀死山王？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020222
					]
				},
				{
					"id": 150020222,
					"content": "山王身上的深渊污染与普通灾害不同，数百年来被邪恶力量侵蚀，它的身体已经不可逆地深渊化了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020223
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020223,
					"content": "可以说既是深渊力量使它疯狂，也是深渊力量维持了它的生命。换言之，如果进行彻底的驱散，山王将安息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020224
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020224,
					"content": "往年的仪式只会驱散近半的深渊力量，这是一个使它既不会死亡又不会醒来的平衡线。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020225
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020225,
					"content": "长老好像没和我们说过具体要驱散多少…但他说今天要聊一聊细节…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150020226,
					"content": "那你们很快就能确认了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020227
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020227,
					"content": "…如果长老真的想要杀死山王，我们可怎么办啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020228,
						150020229
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150020228,
					"content": "我们好像趟了滩浑水。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020230
					]
				},
				{
					"id": 150020230,
					"content": "这个消息可能有些冲击，你们可以先当作不知道。稍后你们和特立尼达长老聊完后，方便来首领这边一趟吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020231
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020231,
					"content": "我想和你们谈个交易。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020232
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020232,
					"content": "交易？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020233
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150020233,
					"content": "我准备了还不错的价格。你们应该也还有不少问题，等会是个好时候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020234
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020234,
					"content": "我们一会就过去。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020235
					]
				},
				{
					"id": 150020235,
					"content": "那稍后见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020229,
					"content": "现在退出还来得及吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020230
					]
				}
			]
		},
