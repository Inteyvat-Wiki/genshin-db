			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"克洛琳德"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2525.035,
							469.746,
							4803.685
						],
						"pointId": 340300464
					}
				]
			},
			"dialogs": [
				{
					"id": 140340301,
					"content": "说到逐影猎人，那处洞窟里的「宝藏」要怎么处理？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340302
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140340302,
					"content": "复归原样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340303
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140340303,
					"content": "真的吗？不让现在的人们来看看，记住他们吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140340304,
					"content": "不了。这是他们的选择，这就是逐影猎人的道路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340305
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140340305,
					"content": "就算是我，也只希望以决斗代理人的身份继续工作。我从不希望人们记住我「逐影猎人」的身份。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340306
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140340306,
					"content": "这和「魔术师」的道路还真不一样。不过，我欣赏克洛琳德小姐的决定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340307
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140340307,
					"content": "咦？我突然想到，既然不是演出特效的话，那最后战斗时，我们的武器为什么会发光呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140340308,
					"content": "因为以前的逐影猎人，会在自己的武器中附上克制魔物的术法。感应到魔物时，它们就会发出光芒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340309
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140340309,
					"content": "哦！怪不得最后能封住那家伙的行动呢。我还以为召唤真的奏效了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340310
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140340310,
					"content": "可能多少也奏效了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340311
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140340311,
					"content": "哦？这是什么意思？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340312
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140340312,
					"content": "这个被封印的「噬魂兽」，我猜和那几位逐影猎人来自同一个时代。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340313
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140340313,
					"content": "你们所念出的名字，都是斩杀了它无数同类、最为英勇的猎人的名字。听到这些名字后，它明显畏缩了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340314
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140340314,
					"content": "原来名字还有这样的作用…",
