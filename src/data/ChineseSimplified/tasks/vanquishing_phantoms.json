			"dialogs": [
				{
					"id": 140340101,
					"content": "终于，你们来到了那个教{RUBY#[D]地下室}堂附近。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340102
					],
					"speakerTitle": "克洛琳德",
					"speakerSubtitle": "克洛琳德饰"
				},
				{
					"id": 140340102,
					"content": "周围散发着不祥的气息，你们已感觉到敌人几乎近在咫尺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340103
					],
					"speakerTitle": "克洛琳德",
					"speakerSubtitle": "克洛琳德饰"
				},
				{
					"id": 140340103,
					"content": "（奇怪…还真有一股不舒服的感觉…这怎么做到的？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340104
					],
					"speakerTitle": "芙宁娜"
				},
				{
					"id": 140340104,
					"content": "接下来…就是决战的时刻了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340105
					],
					"speakerTitle": "克洛琳德",
					"speakerSubtitle": "克洛琳德饰"
				},
				{
					"id": 140340105,
					"content": "我们走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340106
					],
					"speakerTitle": "林尼",
					"speakerSubtitle": "逐影猎人"
				},
				{
					"id": 140340106,
					"content": "弗洛莱恩，等等。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340107
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140340107,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340108
					],
					"speakerTitle": "弗洛莱恩"
				},
				{
					"id": 140340108,
					"content": "你在外面等我们，别进去。你曾经被噬魂兽侵蚀过一次，它很容易就能再次进入你的意识，夺走你身体的控制权。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340109
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140340109,
					"content": "而且还是离它本体这么近的位置，被侵蚀之后的身体变成什么样都有可能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340110
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140340110,
					"content": "正因如此，我才要去…我会走在最前面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340111
					],
					"speakerTitle": "弗洛莱恩"
				},
				{
					"id": 140340111,
					"content": "…！你是想要…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340112
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140340112,
					"content": "没错，我要引诱它进入我的身体。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340113
					],
					"speakerTitle": "弗洛莱恩"
				},
				{
					"id": 140340113,
					"content": "这太危险了。最坏情况下，我可能不得不杀死你。你明白这严重性吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340114
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140340114,
					"content": "我明白，但这样一来，你们的目标就更明确了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340115
					],
					"speakerTitle": "弗洛莱恩"
				},
				{
					"id": 140340115,
					"content": "它不会轻易从方便控制的身体中溜走，你也无需考虑同伴被附身的可能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340116
					],
					"speakerTitle": "弗洛莱恩"
				},
				{
					"id": 140340116,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340117
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140340117,
					"content": "克洛琳德小姐，和我不同，你是位强大而正直的逐影猎人。这是我犯下的错，也理应由我自己来承担。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340118
					],
					"speakerTitle": "弗洛莱恩"
				},
				{
					"id": 140340118,
					"content": "不如说…我非这样做不可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340119
					],
					"speakerTitle": "弗洛莱恩"
				},
				{
					"id": 140340119,
					"content": "你就当是我以自己的名誉，而向你发起的决斗吧。请一定不要手软。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340120
					],
					"speakerTitle": "弗洛莱恩"
				},
				{
					"id": 140340120,
					"content": "…好，我知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340121
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140340121,
					"content": "弗洛莱恩，我以决斗代理人的名义，接受你的「决斗申请」，并向你致以敬意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340122
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140340122,
					"content": "…谢谢你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340123
					],
					"speakerTitle": "弗洛莱恩"
				},
				{
					"id": 140340123,
					"content": "走吧，该去做正事了。让那魔物再次颤抖于猎人的剑刃之下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "克洛琳德"
				}
			]
		},
