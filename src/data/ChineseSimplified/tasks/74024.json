				]
			},
			"dialogs": [
				{
					"id": 740240101,
					"content": "咦，你一个人在这里做什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740240102,
					"content": "哇啊！不要突然从别人背后搭话呀，差一点就把磨好的粉末给弄撒了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240103
					],
					"speakerTitle": "希露艾"
				},
				{
					"id": 740240103,
					"content": "粉末？唔，这些东西是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740240104,
					"content": "是宝石喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240105
					],
					"speakerTitle": "希露艾"
				},
				{
					"id": 740240105,
					"content": "宝、宝石？为什么这里会有宝石啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740240106,
					"content": "没有宝石才比较奇怪吧？毕竟，这里是我用来处理宝石的工坊嘛，虽然还没有正式名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240107
					],
					"speakerTitle": "希露艾"
				},
				{
					"id": 740240107,
					"content": "之前也想过，干脆直接叫「希露艾工坊」之类的，但用自己的名字命名，果然还是不太合适吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240108
					],
					"speakerTitle": "希露艾"
				},
				{
					"id": 740240108,
					"content": "处理宝石？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240109
					]
				},
				{
					"id": 740240109,
					"content": "就是把宝石变成各种各样漂亮的饰品…之类的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240110
					],
					"speakerTitle": "希露艾"
				},
				{
					"id": 740240110,
					"content": "不过，最近一段时间，我应该也没办法再接受新的委托了，因为需要全心全意制作颜料…虽然也是用宝石。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240111
					],
					"speakerTitle": "希露艾"
				},
				{
					"id": 740240111,
					"content": "用、用宝石来制作颜料？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740240112,
					"content": "嗯？怎么了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240113
					],
					"speakerTitle": "希露艾"
				},
				{
					"id": 740240113,
					"content": "唔，总觉得好浪费…不需要宝石的话，其实可以直接给我的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740240114,
					"content": "不过，为什么要制作颜料呢？用宝石打造饰品的过程中，应该不需要这样的步骤才对…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740240115,
					"content": "之前，有个喜欢画画的孩子来问过我，能不能做出像宝石一样闪耀，像太阳一样璀璨的颜料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240116
					],
					"speakerTitle": "希露艾"
				},
				{
					"id": 740240116,
					"content": "而就在前段时间，村子晃得很厉害的时候，她救下了我的妹妹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240117
					],
					"speakerTitle": "希露艾"
				},
				{
					"id": 740240117,
					"content": "所以，我希望能实现她的心愿，做出「像太阳一样璀璨的颜料」，作为答谢她的礼物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240118
					],
					"speakerTitle": "希露艾"
				},
				{
					"id": 740240118,
					"content": "你说的难道是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240119
					]
				},
				{
					"id": 740240119,
					"content": "…喂，你说的那个「喜欢画画的孩子」，该不会是叫玛梅赫吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740240120,
					"content": "…？是的…二位认识她吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240121
					],
					"speakerTitle": "希露艾"
				},
				{
					"id": 740240121,
					"content": "向希露艾讲述了此前与玛梅赫一同经历的事情…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740240122
					]
				},
				{
					"id": 740240122,
					"content": "#难、难道说，二位就是与玛梅赫一起救了芙佳的{NICKNAME}大人和派蒙大人吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240123
					],
					"speakerTitle": "希露艾"
				},
				{
					"id": 740240123,
					"content": "大、大人…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240124,
						740240125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740240124,
					"content": "是我。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240126
					]
				},
				{
					"id": 740240126,
					"content": "真的非常感谢二位…！要不是二位的话，芙佳可能就会…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240127
					],
					"speakerTitle": "希露艾"
				},
				{
					"id": 740240127,
					"content": "如果不介意的话，请一定要收下这些…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240128,
						740240130
					],
					"speakerTitle": "希露艾"
				},
				{
					"id": 740240128,
					"content": "（漂亮的宝石…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240129
					]
				},
				{
					"id": 740240129,
					"content": "#可以收下吗，{NICKNAME}？看上去好像很贵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740240131,
					"content": "不过，没想到那个玛梅赫居然还会主动委托别人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740240132,
					"content": "倒也不能算是委托吧？毕竟，她只是问我能不能做出来，我还没回答完，她就直接跑掉了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240133
					],
					"speakerTitle": "希露艾"
				},
				{
					"id": 740240133,
					"content": "这个，确实很像是玛梅赫会做出来的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740240134,
					"content": "#说起来，{NICKNAME}大人、派蒙大人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240135
					],
					"speakerTitle": "希露艾"
				},
				{
					"id": 740240135,
					"content": "在二位看来，「最接近太阳色彩的东西」是什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240136
					],
					"speakerTitle": "希露艾"
				},
				{
					"id": 740240136,
					"content": "虽然我也试着观察过太阳的模样，但我不太清楚，究竟要用什么样的材料，才能重现出那样的色彩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240137
					],
					"speakerTitle": "希露艾"
				},
				{
					"id": 740240137,
					"content": "唔，「接近太阳色彩的东西」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240138,
						740240141,
						740240145
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740240138,
					"content": "…黄金？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240139
					]
				},
				{
					"id": 740240139,
					"content": "嗯，夏诺蒂拉之前也说过，「黄金是太阳滴落的泪水」什么的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240140
					],
					"speakerTitle": "希露艾"
				},
				{
					"id": 740240140,
					"content": "不过，用黄金做颜料，未免也有点太奢侈了吧？应该还有更普通的替代品…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240148
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740240148,
					"content": "总之，说到「接近太阳色彩的东西」，我们应该见过才对，而且应该是很常见的东西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740240141,
					"content": "…太阳？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240142
					]
				},
				{
					"id": 740240142,
					"content": "…原来如此。不愧是您。最接近太阳色彩的东西，确实是太阳本身。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240143
					],
					"speakerTitle": "希露艾"
				},
				{
					"id": 740240143,
					"content": "但是，要怎么才能把太阳磨成粉末呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240144
					],
					"speakerTitle": "希露艾"
				},
				{
					"id": 740240144,
					"content": "不，别一本正经地说出这种莫名其妙的话啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240148
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740240145,
					"content": "既然如此，就用我的头发…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240146
					]
				},
				{
					"id": 740240146,
					"content": "…嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240147
					],
					"speakerTitle": "希露艾"
				},
				{
					"id": 740240147,
					"content": "不，再怎么说头发也没法用来做颜料吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240148
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740240130,
					"content": "谢谢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240131
					]
				},
				{
					"id": 740240125,
					"content": "虽然称不上是「大人」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240126
					]
				}
			]
		},
