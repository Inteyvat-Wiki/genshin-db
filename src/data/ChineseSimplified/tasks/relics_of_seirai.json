			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"藤原俊子",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721620101,
					"content": "谢、谢谢你们，呼…这些家伙居然趁我不注意偷袭我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620102,
						721620103
					],
					"speakerTitle": "藤原俊子"
				},
				{
					"id": 721620102,
					"content": "你是谁？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721620104
					]
				},
				{
					"id": 721620104,
					"content": "我叫藤原俊子，正在这里…嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620105
					],
					"speakerTitle": "藤原俊子"
				},
				{
					"id": 721620105,
					"content": "算了，你们救了我…我就告诉你们吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620106
					],
					"speakerTitle": "藤原俊子"
				},
				{
					"id": 721620106,
					"content": "其实，我正在这里寻找我祖上留下来的宝藏！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620107
					],
					"speakerTitle": "藤原俊子"
				},
				{
					"id": 721620107,
					"content": "宝、宝藏！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721620108,
					"content": "你找到了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721620109
					]
				},
				{
					"id": 721620109,
					"content": "哈哈哈，那是当然，我顺着线索找到了宝藏所在地，也确定了进入的方法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620110
					],
					"speakerTitle": "藤原俊子"
				},
				{
					"id": 721620110,
					"content": "但是…在我准备启动开关，进入藏宝地的时候，就被那群魔物偷袭了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620111
					],
					"speakerTitle": "藤原俊子"
				},
				{
					"id": 721620111,
					"content": "多亏你们击退了那群魔物，谢谢你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620112
					],
					"speakerTitle": "藤原俊子"
				},
				{
					"id": 721620112,
					"content": "然后…那个，虽然有点不好意思…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620113
					],
					"speakerTitle": "藤原俊子"
				},
				{
					"id": 721620113,
					"content": "但是，能不能请你们接着保护我一段时间？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620114
					],
					"speakerTitle": "藤原俊子"
				},
				{
					"id": 721620114,
					"content": "我还得继续寻宝，这周围又有那么多魔物，我一个人肯定没法对付…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620115
					],
					"speakerTitle": "藤原俊子"
				},
				{
					"id": 721620115,
					"content": "如果你们愿意帮忙的话，我可以把…把宝藏分给你们一些！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620116,
						721620117
					],
					"speakerTitle": "藤原俊子"
				},
				{
					"id": 721620116,
					"content": "真的有宝藏吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721620118
					]
				},
				{
					"id": 721620118,
					"content": "肯定能找到！你们就相信我吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620119
					],
					"speakerTitle": "藤原俊子"
				},
				{
					"id": 721620119,
					"content": "我连进入藏宝地的开关都找到了，就在那边。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620120
					],
					"speakerTitle": "藤原俊子"
				},
				{
					"id": 721620120,
					"content": "但那座机关似乎不能直接打开，得用一种特殊的方法才能启动…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620121
					],
					"speakerTitle": "藤原俊子"
				},
				{
					"id": 721620121,
					"content": "虽然我手上有祖上留下的一张图，里面似乎有解开这座机关的线索…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620122
					],
					"speakerTitle": "藤原俊子"
				},
				{
					"id": 721620122,
					"content": "但是…哈哈哈…我还是不知道怎么才能打开。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620123
					],
					"speakerTitle": "藤原俊子"
				},
				{
					"id": 721620123,
					"content": "哦，你们也看看吧，说不定你们能从这张图里看出什么来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620124
					],
					"speakerTitle": "藤原俊子"
				},
				{
					"id": 721620124,
					"content": "唉，这个机关到底是怎么解的呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "藤原俊子"
				},
				{
					"id": 721620117,
					"content": "真的找得到吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721620118
					]
				},
				{
					"id": 721620103,
					"content": "你在这做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721620104
					]
				}
			]
		},
