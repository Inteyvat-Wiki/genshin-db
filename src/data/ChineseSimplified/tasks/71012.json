			"dialogs": [
				{
					"id": 710120101,
					"content": "「风带来了新的故事，时间使之成为神话。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710120102
					],
					"speakerTitle": "残破的刻字"
				},
				{
					"id": 710120102,
					"content": "这句话是什么意思啊…完全没有头绪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710120103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710120103,
					"content": "唔，不过，这个地方看起来似乎有什么秘密…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710120104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710120104,
					"content": "我们去周围看看吧，说不定会有什么线索呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
