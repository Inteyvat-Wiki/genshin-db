			},
			"dialogs": [
				{
					"id": 710120201,
					"content": "「风带来了新的故事，时间使之成为神话。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710120202
					],
					"speakerTitle": "残破的刻字"
				},
				{
					"id": 710120202,
					"content": "那本笔记里提到的日晷，应该就是这一座吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710120203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710120203,
					"content": "不过，这座日晷到底有什么特别的地方呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710120204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710120204,
					"content": "唔…我们再仔细看看那本笔记吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7101210,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7101210",
							"2"
						],
						"stepId": 7101210,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"亨利莫顿"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710121001,
					"content": "嗯？旅行者，你来这里有事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121002
					],
					"speakerTitle": "亨利莫顿"
				},
				{
					"id": 710121002,
					"content": "关于狂风之核…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710121003
					]
				},
				{
					"id": 710121003,
					"content": "狂风之核？我一直在这附近呆着，没有见过类似的东西啊，就是刚才莫名其妙刮过来一阵大风…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121004
					],
					"speakerTitle": "亨利莫顿"
				},
				{
					"id": 710121004,
					"content": "不过，这里肯定没有出现过狂风之核。如果有那种大家伙，我肯定忘不了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121005,
						710121007
					],
					"speakerTitle": "亨利莫顿"
				},
				{
					"id": 710121005,
					"content": "好吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710121006
					]
				},
				{
					"id": 710121006,
					"content": "你就相信我吧，要是有那种家伙来这里打乱我的研究，我肯定忘不了的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121009
					],
					"speakerTitle": "亨利莫顿"
				},
				{
					"id": 710121009,
					"content": "准确地说…应该是和我的一位朋友一起进行的研究。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121010
					],
					"speakerTitle": "亨利莫顿"
				},
				{
					"id": 710121010,
					"content": "我的那位朋友也是一位学者，曾经和我一同在须弥教令院里学习。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121011
					],
					"speakerTitle": "亨利莫顿"
				},
				{
					"id": 710121011,
					"content": "之后，他去做了考古学家，在世界上到处考察，我则继续在教令院里学习…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121012
					],
					"speakerTitle": "亨利莫顿"
				},
				{
					"id": 710121012,
					"content": "当他来蒙德的时候，还很兴奋地告诉我他正在蒙德的千风神殿考察。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121013
					],
					"speakerTitle": "亨利莫顿"
				},
				{
					"id": 710121013,
					"content": "还说什么「等我挖出了你家乡的秘密，绝对第一个就告诉你」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121014
					],
					"speakerTitle": "亨利莫顿"
				},
				{
					"id": 710121014,
					"content": "之后他就突然没了音信，我托人给塞琉斯先生带了封信，拜托冒险家协会搜索我朋友的下落。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121015
					],
					"speakerTitle": "亨利莫顿"
				},
				{
					"id": 710121015,
					"content": "但一直没有任何消息传来，我就中断了在须弥的学习，自己赶了回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121016
					],
					"speakerTitle": "亨利莫顿"
				},
				{
					"id": 710121016,
					"content": "不过，这里也只有一座日晷，没有其他的线索了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121017
					],
					"speakerTitle": "亨利莫顿"
				},
				{
					"id": 710121017,
					"content": "关于那座岛上的日晷…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710121018
					]
				},
				{
					"id": 710121018,
					"content": "什么？居然还有一座一模一样的日晷，还是在一座海上的孤岛上？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121019
					],
					"speakerTitle": "亨利莫顿"
				},
				{
					"id": 710121019,
					"content": "哦，我记起来了，天气好的时候，我还看见过那座岛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121020
					],
					"speakerTitle": "亨利莫顿"
				},
				{
					"id": 710121020,
					"content": "等等，你说…在那个岛上的日晷旁边，发现了一本笔记？难道说那家伙去过那里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121021
					],
					"speakerTitle": "亨利莫顿"
				},
				{
					"id": 710121021,
					"content": "谢谢你，我有机会的话，会去那座孤岛上看看，现在我还是想先把这里研究明白。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121022
					],
					"speakerTitle": "亨利莫顿"
				},
				{
					"id": 710121022,
					"content": "我要继续研究了，如果你有兴趣，可以去翻翻我的研究笔记，我就放在那里了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121023
					],
					"speakerTitle": "亨利莫顿"
				},
				{
					"id": 710121023,
					"content": "说不定上面有什么东西，会对你有帮助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "亨利莫顿"
				},
				{
					"id": 710121007,
					"content": "你在这做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710121008
					]
				},
				{
					"id": 710121008,
					"content": "我？我正在这里做一些研究。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121009
					],
					"speakerTitle": "亨利莫顿"
				}
			]
		},
