			"dialogs": [
				{
					"id": 710122401,
					"content": "那个家伙是从哪冒出来的！之前完全没有看见！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710122402
					],
					"speakerTitle": "亨利莫顿"
				},
				{
					"id": 710122402,
					"content": "你是怎么把那大家伙弄出来的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710122403
					],
					"speakerTitle": "亨利莫顿"
				},
				{
					"id": 710122403,
					"content": "是这样…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710122404
					]
				},
				{
					"id": 710122404,
					"content": "果然是「时与风」啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710122405
					],
					"speakerTitle": "亨利莫顿"
				},
				{
					"id": 710122405,
					"content": "在那座孤岛上，还有一座和这个一模一样的日晷，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710122406
					],
					"speakerTitle": "亨利莫顿"
				},
				{
					"id": 710122406,
					"content": "而且，连解谜的方式都一模一样。这两座日晷，还有这两个地方，一定有着某种联系…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710122407
					],
					"speakerTitle": "亨利莫顿"
				},
				{
					"id": 710122407,
					"content": "不行，我得找个办法，赶紧去那座岛上看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710122408
					],
					"speakerTitle": "亨利莫顿"
				},
				{
					"id": 710122408,
					"content": "谢谢你旅行者，等我做好准备之后就去找你，我们一起再去那座无人岛上一趟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "亨利莫顿"
				}
			]
