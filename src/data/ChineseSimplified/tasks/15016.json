			},
			"dialogs": [
				{
					"id": 150160101,
					"content": "噢，你们来了啊，事情都处理完了。我正打算去休息呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150160102
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150160102,
					"content": "特拉佐莉会受到什么处罚？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150160103
					]
				},
				{
					"id": 150160103,
					"content": "部族里还在商量着呢，用古名技术来犯罪的人，古往今来也没多少…帕加尔可要头疼一阵了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150160104
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150160104,
					"content": "能够确定的是，特拉佐莉的工坊会被完全封闭，剩余那些未成型的「燃晶名刻」也会彻底销毁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150160105
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150160105,
					"content": "至于那些已经成型的「燃晶名刻」，我会接手处理。唉，又是个麻烦的工作…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150160106
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150160106,
					"content": "无论如何，至少她的「古名」没出问题，不然乱子可就大了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150160107
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150160107,
					"content": "噢，说到古名。倒是有个好消息。「燃晶名刻」所汲取的记忆是可恢复的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150160108
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150160108,
					"content": "等到所有「燃晶名刻」都停止工作后，那些回忆应该就会顺着原路，物归原主了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150160109,
						150160110
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150160109,
					"content": "那大家关于妮赫佳的记忆…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150160111
					]
				},
				{
					"id": 150160111,
					"content": "是啊。这么一想…婶婶想要妮赫佳回来，所以让整个部族的人都忘记了妮赫佳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150160112
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150160112,
					"content": "现在妮赫佳真的离开了，大家却又即将想起她…真是乱七八糟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150160113
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150160113,
					"content": "妮佩卡现在的情况还好吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150160114
					]
				},
				{
					"id": 150160114,
					"content": "她正在我的工坊里休息呢，我已经联系了同族的人，准备正式查一查这孩子的身世。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150160115
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150160115,
					"content": "现在族里还没给我回信，所以我就打算先照顾着她，顺便教她点手艺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150160116
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150160116,
					"content": "这都是后话了。现在就让妮佩卡好好睡一觉吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150160117
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150160117,
					"content": "只有睡饱了，才有精力面对这么多麻烦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150160110,
					"content": "也会一起回来？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150160111
					]
				}
			]
		}
	]
}