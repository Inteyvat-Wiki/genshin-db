					"nextDialogs": [
						722480502
					]
				},
				{
					"id": 722480502,
					"content": "那就祝汝……武运昌隆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿倍良久"
				}
