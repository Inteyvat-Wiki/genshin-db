			"completionStepIds": [
				7224804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224804",
							"2"
						],
						"stepId": 7224804,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿倍良久",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722480201,
					"content": "啊…若是当时白夜国有如汝这般的勇士，也不会…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480202
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480202,
					"content": "唉，此事若成，那吾也可了却心愿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480203
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480203,
					"content": "一定要、一定要将这些寄托吾念的贡品拿去供奉，供奉在我幽禁之所。如此才能…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480204
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480204,
					"content": "如此才能什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722480205,
					"content": "如此才能…如此才能…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480206
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480206,
					"content": "唔，这位残魂先生看上去失魂落魄，说什么都没反应了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722480207,
					"content": "#{NICKNAME}，那就先带上贡品吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722480208,
					"content": "不过残魂先生被幽禁在的高处，到底是什么地方呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7224803,
			"completionStepIds": [
				7224805
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224805",
							"2"
						],
						"stepId": 7224805,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"派蒙",
					"阿倍良久"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722480301,
					"content": "好像出现了一个残魂……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722480302,
					"content": "吾乃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480303
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480303,
					"content": "吾乃赫利俄斯之建造者，名曰：阿倍良久！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480304
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480304,
					"content": "吾怎么可能被你们这些妄语谗言所击倒，吾怎么会被你们操纵的稚童幽禁！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480305
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480305,
					"content": "吾…不对，吾…吾在幽禁之所度过了无尽岁月，此时已是…生后之身？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480306
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480306,
					"content": "生后之身？是说自己已经死去的意思吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722480307,
					"content": "能够意识到这点的残魂很少见啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722480308,
					"content": "说来惭愧，但为何而死，吾已回想不出…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480309
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480309,
					"content": "只是记忆之中，吾被一个孩子下令关押至死。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480310
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480310,
					"content": "一个孩子？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722480311,
					"content": "正是，不过，时至今日，提起那个孩子吾也不觉得怨恨，只是觉得可怜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480312
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480312,
					"content": "有错的，并不是他，有错的是将他视为掌中傀儡的…算了，不提也罢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480313
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480313,
					"content": "那之后，吾就被幽禁…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480314
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480314,
					"content": "幽禁于一处…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480315
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480315,
					"content": "一处？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722480316,
					"content": "一处很高的地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480317
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480317,
					"content": "虽然很高，但该处却黯淡无光，冷若冰窟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480318
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480318,
					"content": "…咦，奇怪，为何呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480319
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480319,
					"content": "为何吾会觉得，高处本应是让人温暖舒畅的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480320
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480320,
					"content": "为何…为何吾什么都想不起来？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480321
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480321,
					"content": "难道是因为肚子饿了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480322
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722480322,
					"content": "我肚子饿的时候，别说动脑想什么了，连话都说不顺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480323,
						722480325
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722480323,
					"content": "我觉得不是因为这个…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722480324
					]
				},
				{
					"id": 722480324,
					"content": "肯定就是嘛！你看他也话都说不清了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480327
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722480327,
					"content": "#啊，{NICKNAME}，你可以找找看，万一贡品里面有能吃的东西呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480328
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722480328,
					"content": "是了！贡品！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480329
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480329,
					"content": "怎么样，是想吃贡品了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480330
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722480330,
					"content": "不，吾只是想起了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480331
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480331,
					"content": "吾在幽禁至死后，因铸造赫利俄斯之功，残躯与衣冠在各处享有供奉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480332
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480332,
					"content": "也是因此而魂魄分离，致使灵魂难安。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480333
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480333,
					"content": "此处本应供奉吾之圣冠，但是早已朽坏…恐怕这也是为何吾念头滞涩的原因。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480334
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480334,
					"content": "长此以往，恐怕连保持现在的状态都相当困难…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480335
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480335,
					"content": "但好在这些供奉品——这些贡品能代替残躯与衣冠，承载吾一丝念想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480336
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480336,
					"content": "劳烦汝将之取走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480337
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480337,
					"content": "不过供奉之路上有多重险阻，虽有冒犯之嫌，但也希望汝能接受一次考验…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480338
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480338,
					"content": "考验？什么考验？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480339
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722480339,
					"content": "就请汝击败周围这些困守吾残魂的怪物吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480340
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480340,
					"content": "此事凶险，旅者啊，若汝准备好了，再与吾说吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480325,
					"content": "我这里有应急食…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722480326
					]
				},
				{
					"id": 722480326,
					"content": "喂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480327
					],
					"speakerTitle": "派蒙"
				}
			]
		},
