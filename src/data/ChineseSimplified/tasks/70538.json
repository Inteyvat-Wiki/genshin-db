			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"哲俩阿"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705381401,
					"content": "（身为荣誉骑士，不能坐视不理！）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705381402
					]
				},
				{
					"id": 705381402,
					"content": "那…对不起了，热情的哲俩阿小姐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705381403,
					"content": "请你理解，毕竟你的无意中犯下的错，闯了很大的祸，事关蒙德的法律…我们只能出手了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705381404,
					"content": "欸？你们在说什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381405
					],
					"speakerTitle": "哲俩阿"
				},
				{
					"id": 705381405,
					"content": "等等！你们怎么在…摩拳擦掌？是要去打猎吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381406
					],
					"speakerTitle": "哲俩阿"
				},
				{
					"id": 705381406,
					"content": "不用的不用的，我这里的储备食材还很多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381407
					],
					"speakerTitle": "哲俩阿"
				},
				{
					"id": 705381407,
					"content": "哇啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "哲俩阿"
				}
			]
		},
		{
			"id": 7053815,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_ACTIVITY_CLIENT_COND",
						"rawParams": [
							"5160",
							"5160001",
							"1"
						]
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7053801",
							"2"
						],
						"stepId": 7053801,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"哲俩阿"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705381501,
					"content": "（我不想越权行事…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705381502
					]
				},
				{
					"id": 705381502,
					"content": "（越权？怎么突然说出这么一个奇怪的词…又好像在哪里听到过…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705381503,
					"content": "（难道你的意思是，抓住犯人是其他骑士的职责？我们不能把自己分外的工作也干了…抢走别人的功劳？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705381504,
					"content": "（嗯…想想也有道理呢！哲俩阿小姐虽然犯下了错，但不像是凶恶的坏人…一般的骑士也能抓住她吧。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705381505,
					"content": "（对于一般的骑士来说，这是轻轻松松就能积累功绩的好机会，而这种功绩对于我们来说也没什么用，就让给他们好了…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705381506,
					"content": "（但哲俩阿小姐现在的地方又很偏，骑士们会不会一时半会儿找不到她？要想个办法让哲俩阿小姐回到蒙德城附近去才行。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705381507,
					"content": "你们在小声说什么呢？难道是对我的放生理论很感兴趣吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381508
					],
					"speakerTitle": "哲俩阿"
				},
				{
					"id": 705381508,
					"content": "啊！我们刚刚…听哲俩阿小姐说到鱼…突然在想晚餐该吃什么！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381509,
						705381510
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705381509,
					"content": "我突然想吃烤鱼了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705381511
					]
				},
				{
					"id": 705381511,
					"content": "咦？唔…哦！对对对！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381512
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705381512,
					"content": "既然哲俩阿小姐都来到蒙德了，那一定不能错过蒙德烤鱼，吃起来又香又方便！还有…蜜酱胡萝卜煎肉，堆高高和火火肉酱面！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381513
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705381513,
					"content": "哎呀！你们不说我都忘了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381514
					],
					"speakerTitle": "哲俩阿"
				},
				{
					"id": 705381514,
					"content": "之前光顾着谈生意了，谈完生意就在游山玩水，完全没想起来在蒙德城内好好吃一顿饭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381515
					],
					"speakerTitle": "哲俩阿"
				},
				{
					"id": 705381515,
					"content": "只是听说，本地一间叫「猎鹿人」的餐馆物美价廉，还有外送服务，就随手下了几天的订单。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381516
					],
					"speakerTitle": "哲俩阿"
				},
				{
					"id": 705381516,
					"content": "可当时我也忘了问，哪些是蒙德本地的特色菜，送餐的服务员也未必能找到我露营的这个地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381517
					],
					"speakerTitle": "哲俩阿"
				},
				{
					"id": 705381517,
					"content": "要不，你过段时间，还是回蒙德城里，去好好吃一顿大餐？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381518
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705381518,
					"content": "嗯！我要顺带再找本地人问问蒙德的其他特产，带回去给朋友们当伴手礼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381519
					],
					"speakerTitle": "哲俩阿"
				},
				{
					"id": 705381519,
					"content": "我记得城门旁边就有两个骑士在站岗，他们应该很在行，可以给我很好的建议！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381520
					],
					"speakerTitle": "哲俩阿"
				},
				{
					"id": 705381520,
					"content": "事不宜迟！我现在就回去一趟！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381521
					],
					"speakerTitle": "哲俩阿"
				},
				{
					"id": 705381521,
					"content": "哲俩阿兴致勃勃地离开了营地，向着蒙德城的方向小跑离去了。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705381522
					]
				},
				{
					"id": 705381522,
					"content": "结果哲俩阿小姐自己提出要去找骑士聊天了…不知道会不会在聊天的过程中直接被抓起来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381523
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705381523,
					"content": "不过，到时候骑士们应该也会意识到，她之前做的事是无心之举吧，毕竟，哪有蓄意搞破坏的犯人自己找上门来的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381524,
						705381525
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705381524,
					"content": "哲俩阿应该不会被严厉惩罚的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705381526
					]
				},
				{
					"id": 705381526,
					"content": "嗯！虽然还是觉得有点对不起她，但毕竟做了错事，就还是要承担责任的嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381527
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705381527,
					"content": "希望哲俩阿小姐快点意识到自己的错误，受到惩罚后，不会太沮丧吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705381525,
					"content": "我们用温和的方式解决了问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705381526
					]
				},
				{
					"id": 705381510,
					"content": "你吃过蒙德烤鱼吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705381511
					]
				}
