			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"波尔托"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2261.872,
							235.99,
							-784.188
						],
						"pointId": 6247
					}
				]
			},
			"dialogs": [
				{
					"id": 705380301,
					"content": "不愧是荣誉骑士和白色小帮手，两三下就找到了这个逃犯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705380302
					],
					"speakerTitle": "波尔托"
				},
				{
					"id": 705380302,
					"content": "之前，我的同僚们将她锁定为嫌疑人，确认她的身份和离开蒙德的时间点后，误以为她向荆夫港方向逃走了，准备乘船离境…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705380303
					],
					"speakerTitle": "波尔托"
				},
				{
					"id": 705380303,
					"content": "没想到，她居然深入了明冠山地，难怪怎么都找不到她的踪迹…反侦察意识还挺强的嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705380304
					],
					"speakerTitle": "波尔托"
				},
				{
					"id": 705380304,
					"content": "呃，我觉得她根本没有躲避你们的意思，毕竟她根本没有意识到发生了什么事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705380305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705380305,
					"content": "总之，哲俩阿小姐虽然确确实实犯了错，但她应该不是出于恶意的！请你们也不要对她太凶哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705380306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705380306,
					"content": "那是当然，我听说她态度还挺好的！对于积极配合的犯人，我们也会心平气和地讲道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705380307
					],
					"speakerTitle": "波尔托"
				},
				{
					"id": 705380307,
					"content": "调查小队说目前的事态和损失完全可以控制，我们只需要走一遍正规的流程，评估她导致的损失，给她一笔适当的罚金就行了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705380308,
						705380309
					],
					"speakerTitle": "波尔托"
				},
				{
					"id": 705380308,
					"content": "这种惩罚就够了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705380310
					]
				},
				{
					"id": 705380310,
					"content": "呼…没想到我们也参与了这次的事件…作为骑士团抓到犯人，居然是这种感觉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705380311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705380311,
					"content": "话说回来，还好哲俩阿小姐是个冒失犯，而不是蓄意要破坏蒙德的酒业呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705380312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705380312,
					"content": "不然，如果抓住了一个凶恶的家伙，那人死不悔改，还大声嚷嚷的话，我们一天的好心情也会被毁掉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705380313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705380313,
					"content": "希望哲俩阿小姐了解了自己的过失，受到惩罚后，不会太沮丧吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705380309,
					"content": "毕竟她本心不坏。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705380310
					]
				}
			]
		},
		{
