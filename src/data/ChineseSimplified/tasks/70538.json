			"dialogs": [
				{
					"id": 705381301,
					"content": "（看她好悠闲，不打扰她了…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705381302
					]
				},
				{
					"id": 705381302,
					"content": "（有道理，在这种偏僻地方露营的人，应该很不希望被打扰吧…我们悄悄离开好了。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7053814,
			"completionStepIds": [
				7053801
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_ACTIVITY_CLIENT_COND",
						"rawParams": [
							"5160",
							"5160001",
							"1"
						]
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7053801",
