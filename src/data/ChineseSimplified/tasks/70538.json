			"dialogs": [
				{
					"id": 705380101,
					"content": "真悠闲啊~蒙德的山林，确实是个露营的好地方！这趟生意跑得真值！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705380102
					],
					"speakerTitle": "哲俩阿"
				},
				{
					"id": 705380102,
					"content": "湿度和温度正合适，不会随便干点活就浑身湿透，阳光也不刺眼，还有一股干爽的香气！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "哲俩阿"
				}
			]
		},
		{
			"id": 7053803,
			"completionStepIds": [
				7053803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
