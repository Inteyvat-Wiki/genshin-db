			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"哲俩阿"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705381101,
					"content": "你是？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705381102
					]
				},
				{
					"id": 705381102,
					"content": "啊呀，有新朋友来了！请坐请坐，一起喝茶吃饭聊聊天！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381103
					],
					"speakerTitle": "哲俩阿"
				},
				{
					"id": 705381103,
					"content": "我叫哲俩阿，从须弥来，是个商人。最近我刚刚做完一单大生意，正在享受蒙德的自然风光！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381104
					],
					"speakerTitle": "哲俩阿"
				},
				{
					"id": 705381104,
					"content": "我们还是第一次碰见在这个地方露营的人呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705381105,
					"content": "一般来说，商人不应该…守着自己的店铺和货物吗？你要是不直说，我们完全猜不到你的身份！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705381106,
					"content": "哎呀，商人也要休息的嘛，谁还没几个兴趣爱好了？要劳逸结合，劳逸结合~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381107
					],
					"speakerTitle": "哲俩阿"
				},
				{
					"id": 705381107,
					"content": "要知道，在我们须弥，就连每时每刻都被学业折磨的学生，都很看重这一点，会自己发明游戏来解闷呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381108
					],
					"speakerTitle": "哲俩阿"
				},
				{
					"id": 705381108,
					"content": "我的第一桶金，就是代理一位学生发明的桌游「滚滚炸炸菇」赚到的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381109
					],
					"speakerTitle": "哲俩阿"
				},
				{
					"id": 705381109,
					"content": "那位天才般的学生说过，「工作是做不完的，要适当抽点空…偷偷懒~」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381110
					],
					"speakerTitle": "哲俩阿"
				},
				{
					"id": 705381110,
					"content": "她给我带来了以前不敢想的财富，所以，我把她的话当成了人生信条！果然，每天都过得很开心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381111,
						705381112
					],
					"speakerTitle": "哲俩阿"
				},
				{
					"id": 705381111,
					"content": "这名字怎么有点耳熟…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705381113
					]
				},
				{
					"id": 705381113,
					"content": "哲哲哲，哲俩阿小姐，你能不能仔细说说，代理那个…「滚滚炸炸菇」的经过？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705381114,
					"content": "咦？你们也听说过这个游戏吗？明明是好久以前的游戏了…几年还是十几年来着？时间过得真的好快啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381115
					],
					"speakerTitle": "哲俩阿"
				},
				{
					"id": 705381115,
					"content": "说来也巧，当时，那位学生正打算返回家乡，所以把不方便带走的东西都卖掉，其中就包括「滚滚炸炸菇」的棋子和棋盘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381116
					],
					"speakerTitle": "哲俩阿"
				},
				{
					"id": 705381116,
					"content": "那时的我只是个收废品的杂货商，有幸遇见了她，问了问棋子的事，她才想起自己发明的游戏好像还有用，给我简单介绍了一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381117
					],
					"speakerTitle": "哲俩阿"
				},
				{
					"id": 705381117,
					"content": "她说，如果我有心力，可以试着继续运营这个游戏。我就试着复刻了几份，真的卖得很不错！我的收入「唰」的一下就涨了上去！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381118
					],
					"speakerTitle": "哲俩阿"
				},
				{
					"id": 705381118,
					"content": "虽然「滚滚炸炸菇」没能流行多久，就被其他游戏取代了，但我赚到了做大生意的本钱，再也不用靠卖杂货维持生计了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381119
					],
					"speakerTitle": "哲俩阿"
				},
				{
					"id": 705381119,
					"content": "可以说，那位天才学生的无心之举，改变了我的命运！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381120,
						705381121
					],
					"speakerTitle": "哲俩阿"
				},
				{
					"id": 705381120,
					"content": "真的会有这么巧的事吗！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705381122
					]
				},
				{
					"id": 705381122,
					"content": "仔细一想，倒也很符合她的作风呢…说不定当时她随手就做了好几个游戏？「滚滚炸炸菇」其实没那么重要？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705381123,
					"content": "但用商人的方法，管理这些游戏的这个权，那个权，肯定很麻烦…她应该是觉得，省点心比赚摩拉更重要吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705381124,
					"content": "没错吧，你们也觉得很神奇吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381125
					],
					"speakerTitle": "哲俩阿"
				},
				{
					"id": 705381125,
					"content": "后来我听说，那位天才学生的家乡是蒙德，从此就对蒙德有了无限的好感！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381126
					],
					"speakerTitle": "哲俩阿"
				},
				{
					"id": 705381126,
					"content": "所以这么多年来，我一直想找个机会，到蒙德来做一次生意，感受一下本地的风土人情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381127
					],
					"speakerTitle": "哲俩阿"
				},
				{
					"id": 705381127,
					"content": "蒙德果然没让我失望！我签了一个大单子，玩得很开心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381128
					],
					"speakerTitle": "哲俩阿"
				},
				{
					"id": 705381128,
					"content": "所以你们两位也不妨试试看哦，劳逸结合，找到让自己舒舒服服生活的节奏！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "哲俩阿"
				},
				{
					"id": 705381121,
					"content": "居然就这么出让了作品！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705381122
					]
				},
				{
					"id": 705381112,
					"content": "你说的学生该不会是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705381113
					]
				}
			]
		},
