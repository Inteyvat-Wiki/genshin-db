			},
			"dialogs": [
				{
					"id": 150330901,
					"content": "我们就是打算到这附近冒险，倒是没有什么特别的计划。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330902
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150330902,
					"content": "路上碰到了瓦雷莎，她特别热心地为我们引路，还给我们介绍了好多这里的知识。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330903
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150330903,
					"content": "不客气，这些都是应该做的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330904
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150330904,
					"content": "这几天的训练计划完成得如何，瓦雷莎，没有怠慢吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330905
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 150330905,
					"content": "报告老师，完成得很好！今天的往返跑三个来回也做完了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330906
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150330906,
					"content": "很好，接下来也要按照计划执行，至于饮食…嗯，最近还没有必要控制。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330907
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 150330907,
					"content": "我这里的器械，你都可以随意使用，不过在做力量训练的时候，一定要注意安全，最好找个人辅助你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330908
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 150330908,
					"content": "知道了，我很有经验。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330909
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150330909,
					"content": "欸，我听说锻炼肌肉的话，吃饭也是很重要的一件事，为什么你不给瓦雷莎安排食谱呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330910
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150330910,
					"content": "这就说来话长了…怎么说呢，瓦雷莎算是很少见的天赋型选手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330911
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 150330911,
					"content": "她刚和我训练的时候，我给她安排的方法和其他学员差不多，也给她父亲写了专门的食谱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330912
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 150330912,
					"content": "…然后我就被饿得眼冒金星，根本没有力气上课。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330913
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150330913,
					"content": "抱歉，我安排的都是标准食量，但似乎完全跟不上你的消耗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330914
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 150330914,
					"content": "我认真研究了瓦雷莎过去的饮食习惯，才逐渐形成了现在专门针对她的计划。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330915
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 150330915,
					"content": "是的，老师非常细心，我觉得我每天都有进步，越来越喜欢上课和锻炼了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330916
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150330916,
					"content": "在所有学员里，瓦雷莎是目前运动表现最好的…单论负重极限，我已经比不上她了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330917
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 150330917,
					"content": "欸？你可是老师，还是归火圣夜巡礼的优胜者啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330918
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150330918,
					"content": "哈哈哈，不用惊讶，这样的事在健身领域里很正常，天赋是非常重要的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330919
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 150330919,
					"content": "哇，好、好厉害！完全看不出来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330920
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150330920,
					"content": "我可没有夸张，瓦雷莎的实力相当靠得住，如果能再自信一点就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330921
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 150330921,
					"content": "都是老师教得好，嘿嘿，我自己没有花什么力气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330922
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150330922,
					"content": "这就是天才吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150330923
					]
				},
				{
					"id": 150330923,
					"content": "没有没有，不是的，面对这些训练器械或者魔物，我可以使出全力，不会有什么心理负担。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330924
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150330924,
					"content": "但是一旦要和别人对抗，我就不行了…因为害怕把别人弄伤…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330925
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150330925,
					"content": "呃，你这么说也对…那「归火圣夜巡礼」怎么办呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330926
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150330926,
					"content": "唉，连团体赛都没有赢过，更别说取得名次了，我不擅长抢来抢去的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330927
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150330927,
					"content": "力量的精髓之一，就是「控制」，就拿这边的杠铃作比方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330928
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 150330928,
					"content": "不光是推起的时候需要用力气，放下的时候同样需要，一个力量强大的人，肯定能收放自如。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330929
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 150330929,
					"content": "我明白，训练的时候我都是这么做的，也没出过问题，但真的到了和别人对抗的时候，我又会有点怀疑自己…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330930,
						150330931
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150330930,
					"content": "没关系。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150330932
					]
				},
				{
					"id": 150330932,
					"content": "嗯，谢谢你安慰我，只要努力训练，总会克服的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330933
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150330933,
					"content": "#那老师我们就先走了，我要带{M#他}{F#她}们去果园看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330934
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150330934,
					"content": "好的，祝你们在「沃陆之邦」过得开心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 150330931,
					"content": "不用急于这一时。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150330932
					]
				}
			]
		},
