						"sceneId": 3,
						"position": [
							-2507.357,
							261.03,
							10173.77
						],
						"pointId": 10958
					},
					{
						"sceneId": 3,
						"position": [
							-2509.231,
							261.022,
							10173.3
						],
						"pointId": 10959
					}
				]
			},
			"dialogs": [
				{
					"id": 150331501,
					"content": "原来摘了这么多，真了不起！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331502
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331502,
					"content": "因为你说「豪宴热斗」需要很多原料嘛，我们可不能白吃不帮忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150331503,
					"content": "我刚刚尝过了，确实很好吃，汁水丰富，甜味充足，一定是市场里最先卖断货的果子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150331504,
					"content": "蘑菇我也吃了，蘑菇原本的香味背后居然有股淡淡的果香，真不可思议。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150331505,
					"content": "我就叫它「果果菇」吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331506,
						150331508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150331506,
					"content": "可以相信派蒙的判断。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150331507
					]
				},
				{
					"id": 150331507,
					"content": "是吧，毕竟已经走过那么多地方，尝了各种各样的美食，我舌头的记性和脑袋一样好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331510
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150331510,
					"content": "谢谢你们，既然这样我也提前收工吧，说好了要给你做蘑菇吃，稍等一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331511
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331511,
					"content": "瓦雷莎快速烹饪了几下，热气腾腾的蘑菇菜肴便端到了你们面前。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150331512
					]
				},
				{
					"id": 150331512,
					"content": "我手艺不太精湛，请不要在意，但只要原料足够好，简单做一做就会特别好吃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331513
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331513,
					"content": "没有没有，闻上去超级香，蘑菇的香味浓郁了很多，感觉肯定很美味。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331514
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150331514,
					"content": "唔，这个味道，和生吃又完全不同了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331515,
						150331516
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150331515,
					"content": "各有各的风味。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150331517
					]
				},
				{
					"id": 150331517,
					"content": "哈哈哈，你们喜欢就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331518
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331518,
					"content": "这种蘑菇在「沃陆之邦」很受欢迎，不过还没怎么在外面出名。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331519
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331519,
					"content": "这次的「豪宴热斗」，也有推广这个蘑菇的目的在里面，阿托力叔叔为了更新菜单下足了功夫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331520
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331520,
					"content": "如果你们感兴趣的话，到时候也可以来参加！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331521
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331521,
					"content": "你有兴趣吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150331522
					]
				},
				{
					"id": 150331522,
					"content": "我？「豪宴热斗」…嗯，当然要参加！虽然我不知道能吃多少…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331523
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150331523,
					"content": "没关系，不用担心会浪费，如果你吃不完，告诉我，我会来帮你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331524
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331524,
					"content": "那我就放心了…欸，不对，我们应该是对手吧，跟你比要怎么赢啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331525
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150331525,
					"content": "不试试怎么知道呢，我觉得你的胃口也蛮不错啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331526
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331526,
					"content": "而且输赢不重要，就当成是一次品尝我们「沃陆之邦」美食的好机会嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331527
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331527,
					"content": "你说的有道理！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331528
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150331528,
					"content": "我也陪她吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150331529
					]
				},
				{
					"id": 150331529,
					"content": "好，那我们都要报名！等着吧，看我派蒙大显神通！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150331516,
					"content": "都很不错。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150331517
					]
				},
				{
					"id": 150331508,
					"content": "有时可以相信派蒙的判断。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150331509
					]
				},
				{
					"id": 150331509,
					"content": "这个「有时」总感觉怪怪的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331510
					],
					"speakerTitle": "派蒙"
				}
			]
