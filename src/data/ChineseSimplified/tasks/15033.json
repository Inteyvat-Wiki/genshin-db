				"points": []
			},
			"dialogs": [
				{
					"id": 150330201,
					"content": "这里是，瓦雷莎的果园。要努力保护好，不可以让很坏的人和很坏的龙进去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330202
					],
					"speakerTitle": "瓦娜娜"
				},
				{
					"id": 150330202,
					"content": "可是，你的气息，不一样。是很好很好的朋友。所以，可以随便吃果子。吃得饱饱的，才会开心。瓦雷莎也这么说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瓦娜娜"
				}
			]
		},
