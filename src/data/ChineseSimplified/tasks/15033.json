			},
			"dialogs": [
				{
					"id": 150330401,
					"content": "欸，原来你先到了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150330402,
					"content": "是啊，回家饱餐了一顿。我爸爸的手艺可好了，无论是肉还是蔬菜，做什么都好吃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330403
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150330403,
					"content": "怪不得感觉你的气色恢复了很多，原来是吃饱了呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150330404,
					"content": "嘿嘿，没错。来之前我还想叫上阿卡特叔叔，但他好像不在家，我就一个人过来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330405
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150330405,
					"content": "阿卡特叔叔是我们的首领，本来我觉得让他来介绍「沃陆之邦」会更合适。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330406
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150330406,
					"content": "我不知道应该按什么路线来，也只能想到哪里说哪里，这个你们会介意吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330407
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150330407,
					"content": "当然不会，这有什么关系啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150330408,
					"content": "那就好，那就好，那么…走那边！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瓦雷莎"
				}
			]
		},
		{
			"id": 1503305,
