					}
				]
			},
			"dialogs": [
				{
					"id": 150330601,
					"content": "那边就是我的家，你们看，前面是水果店，后面是我和爸爸妈妈住的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330602
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150330602,
					"content": "开在家门口的水果店？难道你们家会自己种水果？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330603
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150330603,
					"content": "嘿嘿，是的，我们家有好大一片果园呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330604
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150330604,
					"content": "这里靠部族营地的出入口很近，每天早上就会听到门外的行走和车轮声。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330605
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150330605,
					"content": "我的爸爸妈妈也会在那个时候忙碌起来，我就知道我该起床了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330606
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150330606,
					"content": "然后一起去果园干活吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330607
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150330607,
					"content": "这、这个嘛…我刚想说，脑袋知道该起床，和身体准备好起床，是两件事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330608
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150330608,
					"content": "更多的时候，我都是脑袋往被窝里一缩，马上又睡着了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330609
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150330609,
					"content": "我懂我懂，这种时候睡懒觉，总能睡得特别沉特别香。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330610
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150330610,
					"content": "#反正出发之前，{NICKNAME}{M#他}{F#她}一定会叫我起床的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330611
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150330611,
					"content": "以后你先起，我睡懒觉。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150330612
					]
				},
				{
					"id": 150330612,
					"content": "开玩笑，我开玩笑的啦，别说这么可怕的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330613
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150330613,
					"content": "哈哈哈，偶尔都睡睡懒觉也挺好的啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330614
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150330614,
					"content": "我一般睡醒之后就会帮爸爸妈妈收拾房间，然后出门训练，接着回家吃饭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330615
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150330615,
					"content": "吃完饭之后爸爸妈妈会去运货，就轮到我去果园工作的时间了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330616
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150330616,
					"content": "也就是现在的时间吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150330617
					]
				},
				{
					"id": 150330617,
					"content": "那我们也去果园看看吧，我很感兴趣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330618
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150330618,
					"content": "好啊，等下我就带你们过去，现在…跟我走吧，走这边。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瓦雷莎"
				}
			]
		},
