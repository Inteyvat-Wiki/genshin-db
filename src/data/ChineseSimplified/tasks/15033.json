			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"瓦雷莎",
					"伊安珊"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 150330501,
					"content": "欸，是伊安珊老师！听说你要参加归火圣夜巡礼，怎么回来了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330502
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150330502,
					"content": "哦，我临时想起有一些战斗用的消耗品快用完了，保险起见，还是回来取一趟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330503
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 150330503,
					"content": "你们好，我在竞技场见过你们，就是你们在帮卡齐娜吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330504
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 150330504,
					"content": "#嗯，我是派蒙，{M#他}{F#她}是{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150330505,
					"content": "你们真厉害，卡齐娜一下子长进了很多，自信心也充足了不少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330506
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 150330506,
					"content": "这次能夺得归火圣夜巡礼的优胜，也是她长年努力的结果，非常值得骄傲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330507
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 150330507,
					"content": "麻烦你和她见面再夸夸她。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150330508
					]
				},
				{
					"id": 150330508,
					"content": "嗯，放心吧，我知道，这对她来说很重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330509
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 150330509,
					"content": "你们来「沃陆之邦」有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊安珊"
				}
			]
		},
