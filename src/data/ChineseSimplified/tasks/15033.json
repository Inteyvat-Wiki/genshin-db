					},
					{
						"sceneId": 3,
						"position": [
							-2519.135,
							262.125,
							10232.8
						],
						"pointId": 10957
					}
				]
			},
			"dialogs": [
				{
					"id": 150331401,
					"content": "呜呜——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331402
					],
					"speakerTitle": "瓦娜娜"
				},
				{
					"id": 150331402,
					"content": "辛苦你看家啦，瓦娜娜。我看看，我看看，你是不是又变壮了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331403
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331403,
					"content": "呜呜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331404
					],
					"speakerTitle": "瓦娜娜"
				},
				{
					"id": 150331404,
					"content": "哈哈，我只是要看看，没有要角力的意思。下次吧，下次吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331405
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331405,
					"content": "它是瓦娜娜，平时果园没人的时候，它就会守在这里，是个很靠谱，也很黏人的小家伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331406
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331406,
					"content": "小、小家伙吗？已经足够强壮了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150331407,
					"content": "来吧，进来，这里就是我家的果园。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331408
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331408,
					"content": "哇，里面比想象中还要大！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150331409,
					"content": "到处都是果子，看起来每个都很好吃！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150331410,
					"content": "嘿嘿，我们这里叫「沃陆之邦」，有个原因就是临近火山，所以土地很肥沃，种什么都好吃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331411
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331411,
					"content": "果子很受欢迎，我们不仅一直在往外卖，也留好多自己吃，还送亲朋好友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331412
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331412,
					"content": "原来如此，我之前还在想怎么会有部族住在火山下面，居然还有这种好处。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150331413,
					"content": "是啊。对了，既然都到这里了，我们摘点果子吃吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331414
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331414,
					"content": "欸，你不是刚吃过饭吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150331415,
					"content": "水果是餐后甜点，不会和正餐抢位置。只是吃三五十个的话，不会有事的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331416,
						150331417
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331416,
					"content": "三、三五十个…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150331418
					]
				},
				{
					"id": 150331418,
					"content": "哈哈，小的时候，我爸爸在门口的水果铺卖水果，我扯他的衣服，他就会塞给我一个果子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331419
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331419,
					"content": "我吃得飞快，吃完又找他要一个，结果越来越多人围上来，都是来看我吃水果的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331420
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331420,
					"content": "爸爸说，因为我吃得很香，买水果的人都变多了。我能帮上爸爸的忙，特别开心，于是吃得更多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331421
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331421,
					"content": "客人买完果子都会摸摸我的头，还夸我，说「这么能吃的小孩子以后一定能长得很好」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331422
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331422,
					"content": "我就傻傻地看着他们笑，过一会儿我爸爸也开始笑，来帮忙的妈妈也笑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331423
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331423,
					"content": "好温馨的画面啊，真是羡慕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331424
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150331424,
					"content": "但总归还是因为家里种的水果很好吃，大家才愿意来照顾生意。我可不是自吹自擂哦，你们马上就会理解了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331425
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331425,
					"content": "正好过几天会有「豪宴热斗」，我们家也会赞助很多水果当甜点的原料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331426
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331426,
					"content": "「豪宴热斗」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331427
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150331427,
					"content": "嗯，简单来说，就是像大胃王比赛一样的活动，需要准备很多很多的食材。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331428
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331428,
					"content": "所以，放心地摘，我也会一起摘的，不用担心浪费！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331429
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331429,
					"content": "好！让我看看，从哪里开始…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331430
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150331430,
					"content": "欸，怎么那边有…蘑菇？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331431
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150331431,
					"content": "哦，这个蘑菇啊，是建果园的时候不知从哪里长出来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331432
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331432,
					"content": "它不用浇水也不用施肥，长得可快了，肉质肥美，味道特别好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331433
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331433,
					"content": "不仅适合拿来炒和油煎，就连生吃都很好吃，一股水果味！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331434
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331434,
					"content": "水果味的蘑菇？没听说过啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331435
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150331435,
					"content": "或许是吸收了周围果树的养分。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150331436
					]
				},
				{
					"id": 150331436,
					"content": "应该是，如果吃起来像水果，那它就可以算水果，不用太在意来历啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331437
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331437,
					"content": "来吧，想摘多少摘多少，再摘一些蘑菇吧，等会儿一起做给你们吃！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331417,
					"content": "你的胃口确实很好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150331418
					]
				}
			]
		},
