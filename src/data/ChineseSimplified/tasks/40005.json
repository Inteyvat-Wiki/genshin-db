			"dialogs": [
				{
					"id": 400050201,
					"content": "两位就是来自盗宝团的朋友么？我明明已经在密信中说自己会乔装，也请两位尽情乔装…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050202
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400050202,
					"content": "而今这位朋友却以本来面目现身，实在坦荡，在下佩服。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050203
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400050203,
					"content": "哼哼。我们和你这种藏头露尾的人不一样，我们可没有做过不戴上面具就不敢出现的亏心事啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400050204,
					"content": "喂——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050205,
						400050206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400050205,
					"content": "是他说尽情乔装…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400050207
					]
				},
				{
					"id": 400050207,
					"content": "你们，不是盗宝团的人！你们是什么人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "？？？"
				},
				{
					"id": 400050206,
					"content": "其实我觉得这样还蛮帅的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400050207
					]
				}
			]
		},
		{
