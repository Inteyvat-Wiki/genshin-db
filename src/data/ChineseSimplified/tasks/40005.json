				"points": []
			},
			"dialogs": [
				{
					"id": 400050401,
					"content": "快把你的阴谋诡计招了！$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400050402,
					"content": "我招我招！$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050403
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400050403,
					"content": "不招的话，就尝尝我…欸！招得这么快吗？$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400050404,
					"content": "其实我…是向往「盗宝团」威名的新手盗贼。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050405
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400050405,
					"content": "新手盗贼？！$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400050406,
					"content": "像我这样初出茅庐，又孤身一人的新手…盗宝团就是我心中的圣地…$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050407
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400050407,
					"content": "等一下…$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400050408,
					"content": "所以我想要干出一桩大买卖，去纳投名状…$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050409
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400050409,
					"content": "等一下！完全搞不明白！ $UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400050410,
					"content": "这和我想象的，凶残又邪恶的纵火黑手，完全不一样！$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400050411,
					"content": "纵火，什么纵火？$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050412
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400050412,
					"content": "你一直在易燃物堆放的地方晃荡，难道不是为了纵火吗？$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400050413,
					"content": "啊啊，你说那里啊。我只是在那里踩点。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050414
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400050414,
					"content": "我的计划和那些建筑材料没有关系。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050415
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400050415,
					"content": "没有关系？！$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050416
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400050416,
					"content": "我是为了…偷走那块二十年一遇的巨大「浮生石」！$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050417
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400050417,
					"content": "我的计划是，趁着夜色砍断一半锁链，就这样让它往海的方向飘——$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050418
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400050418,
					"content": "哦哦。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050419
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400050419,
					"content": "再想办法让它沉到云来海的浅水湾里，这样就是完美犯罪了！$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050420
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400050420,
					"content": "不完美的地方太多了！比如你要怎么把浮空的浮生石沉到水里啊？$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050421
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400050421,
					"content": "我也在思考这个问题，所以一直没动手嘛。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050422
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400050422,
					"content": "这人真的脑子不清楚啊！$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050423
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400050423,
					"content": "#好了，{NICKNAME}，给他一个教训吧。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050424
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400050424,
					"content": "那么，我们去和夜叉小哥复命吧。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
