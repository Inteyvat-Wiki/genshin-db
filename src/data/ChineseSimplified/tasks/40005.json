			"dialogs": [
				{
					"id": 400050501,
					"content": "原来事情是这样。人类的行为总是愚蠢得如此随机…不过，我无所谓。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050502
					],
					"speakerTitle": "魈"
				},
				{
					"id": 400050502,
					"content": "好了。你们把我喊到能看见「明霄灯」的地方来，究竟是为了什么？$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050503,
						400050504
					],
					"speakerTitle": "魈"
				},
				{
					"id": 400050503,
					"content": "当然是为了「明霄灯」。$UNRELEASED",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400050505
					]
				},
				{
					"id": 400050505,
					"content": "明明海灯节纪念的英雄里也包括你…为什么你却不想去看灯呢？$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400050506,
					"content": "我无法靠近人群。那些，无忧无虑的人。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050507
					],
					"speakerTitle": "魈"
				},
				{
					"id": 400050507,
					"content": "苦行与杀戮的日子，我已经过得太久…已经成为习惯…$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050508
					],
					"speakerTitle": "魈"
				},
				{
					"id": 400050508,
					"content": "这个话题就到这里吧。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050509
					],
					"speakerTitle": "魈"
				},
				{
					"id": 400050509,
					"content": "再见了。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050510
					],
					"speakerTitle": "魈"
				},
				{
					"id": 400050510,
					"content": "……$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050511
					],
					"speakerTitle": "魈"
				},
				{
					"id": 400050511,
					"content": "不过，如果你在璃月遇到了鬼神之难，就直呼我名吧。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050512
					],
					"speakerTitle": "魈"
				},
				{
					"id": 400050512,
					"content": "不论是你，还是璃月。所有的灯火，所有祈求平安的愿望，我都已经听到了。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050513
					],
					"speakerTitle": "魈"
				},
				{
					"id": 400050513,
					"content": "那么，新年快乐。$UNRELEASED",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400050514
					]
				},
				{
					"id": 400050514,
					"content": "新年快乐！$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400050504,
					"content": "当然是为了海灯节。$UNRELEASED",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400050505
					]
				}
			]
		}
