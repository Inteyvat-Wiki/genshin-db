			"dialogs": [
				{
					"id": 740920101,
					"content": "为什么…为什么会这样…可恶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920102,
						740920103
					],
					"speakerTitle": "克洛妮艾"
				},
				{
					"id": 740920102,
					"content": "克洛妮艾小姐？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920104
					]
				},
				{
					"id": 740920104,
					"content": "#{NICKNAME}！你来了，太好了…你…至少你还知道真相…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920105
					],
					"speakerTitle": "克洛妮艾"
				},
				{
					"id": 740920105,
					"content": "克洛妮艾小姐，你冷静一点，你…你怎么了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740920106,
					"content": "就算…就算我的报道没办法登上报纸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920107
					],
					"speakerTitle": "克洛妮艾"
				},
				{
					"id": 740920107,
					"content": "你的报道怎么样了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920108
					]
				},
				{
					"id": 740920108,
					"content": "嗯，我们还在奇怪，什么时候才会看见你的报道呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740920109,
					"content": "没看到…没看到，对，对…你们应该没看到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920110
					],
					"speakerTitle": "克洛妮艾"
				},
				{
					"id": 740920110,
					"content": "你怎么…一副慌张的样子？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920111
					]
				},
				{
					"id": 740920111,
					"content": "事情是这样的…自从那天从枫丹科学院回来之后，我就开始着手编撰文章。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920112
					],
					"speakerTitle": "克洛妮艾"
				},
				{
					"id": 740920112,
					"content": "我把所有我看见的，我听见的，我感受到的全部如实写了上去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920113
					],
					"speakerTitle": "克洛妮艾"
				},
				{
					"id": 740920113,
					"content": "比如，枫丹科学院并没有完全清除始基矿。反而重新启动了另一项和始基矿有关的项目。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920114
					],
					"speakerTitle": "克洛妮艾"
				},
				{
					"id": 740920114,
					"content": "一个艾德温曾经的部下被派去探索枫丹科学院废墟，但却在爆炸中丧生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920115
					],
					"speakerTitle": "克洛妮艾"
				},
				{
					"id": 740920115,
					"content": "枫丹科学院高级技官雷蒙多拒绝承认他的身亡，并且坚持那些爆炸本就在计划内。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920116
					],
					"speakerTitle": "克洛妮艾"
				},
				{
					"id": 740920116,
					"content": "还有废墟里那个失控的大机器，被污染的水体…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920117
					],
					"speakerTitle": "克洛妮艾"
				},
				{
					"id": 740920117,
					"content": "所有枫丹科学院想要隐瞒的事情，我全都写进了文章里！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920118
					],
					"speakerTitle": "克洛妮艾"
				},
				{
					"id": 740920118,
					"content": "但是…就在我递交了这篇报道后，却被告知，枫丹科学院对我发起了诉讼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920119
					],
					"speakerTitle": "克洛妮艾"
				},
				{
					"id": 740920119,
					"content": "按照报社规定，我所有和枫丹科学院有关的报道文章都必须接受「可信度审查」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920120
					],
					"speakerTitle": "克洛妮艾"
				},
				{
					"id": 740920120,
					"content": "那一篇对枫丹科学院的报道，也被撤了下来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920121,
						740920122
					],
					"speakerTitle": "克洛妮艾"
				},
				{
					"id": 740920121,
					"content": "可信度审查？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920123
					]
				},
				{
					"id": 740920123,
					"content": "不，这种审查并非是针对某篇报道，而是针对于我这个人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920124
					],
					"speakerTitle": "克洛妮艾"
				},
				{
					"id": 740920124,
					"content": "简单来说，枫丹科学院控告我因为利益冲突，而将主观情绪代入了报道事务，向大众传达了错误信息…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920125
					],
					"speakerTitle": "克洛妮艾"
				},
				{
					"id": 740920125,
					"content": "但…你和枫丹科学院有利益冲突吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920126
					]
				},
				{
					"id": 740920126,
					"content": "克洛妮艾小姐只是拍了几张画片，里面全是烂石头和不会动的大机器…这有什么「利益冲突」呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740920127,
					"content": "天哪，你泄露他们的道德水平了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920128
					]
				},
				{
					"id": 740920128,
					"content": "他们…指控我泄露了最新型的枫达品类。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920129
					],
					"speakerTitle": "克洛妮艾"
				},
				{
					"id": 740920129,
					"content": "枫丹科学院的人坚持说，我之前在废墟中所拍的画片，有一部分涉及到了新型枫达的设计方案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920130
					],
					"speakerTitle": "克洛妮艾"
				},
				{
					"id": 740920130,
					"content": "他们必须检查每一张画片。在那之前，枫丹科学院不会解除诉讼，我也要一直接受可信度审查。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920131
					],
					"speakerTitle": "克洛妮艾"
				},
				{
					"id": 740920131,
					"content": "很确定，这就是枫丹科学院为了阻止我发布报道而采取的手段…但我不会放弃的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920132
					],
					"speakerTitle": "克洛妮艾"
				},
				{
					"id": 740920132,
					"content": "来，拿好！这份报纸是我自己偷偷去印的，等会我就出去把这些报纸散发出去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920133
					],
					"speakerTitle": "克洛妮艾"
				},
				{
					"id": 740920133,
					"content": "我一定要让所有人都知道真相和枫丹科学院的真面目，还有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920134
					],
					"speakerTitle": "克洛妮艾"
				},
				{
					"id": 740920134,
					"content": "克洛妮艾小姐！您怎么还在这里，我找您好久了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920135
					],
					"speakerTitle": "缪妮"
				},
				{
					"id": 740920135,
					"content": "天哪！有人过来了，我不能再待在这里了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920136
					],
					"speakerTitle": "克洛妮艾"
				},
				{
					"id": 740920136,
					"content": "这份报纸给你，一定要收好，我把所有的真相都写在上面了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920137
					],
					"speakerTitle": "克洛妮艾"
				},
				{
					"id": 740920137,
					"content": "按照规定，您现在必须去复律庭接受每天的例行审查…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920138
					],
					"speakerTitle": "缪妮"
				},
				{
					"id": 740920138,
					"content": "欸！您别跑啊，克洛妮艾小姐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920139
					],
					"speakerTitle": "缪妮"
				},
				{
					"id": 740920139,
					"content": "只不过是枫达而已，说不定是场误会！只要解释清楚就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920140
					],
					"speakerTitle": "缪妮"
				},
				{
					"id": 740920140,
					"content": "等等！请等等啊，克洛妮艾小姐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "缪妮"
				},
				{
					"id": 740920122,
					"content": "报社认为你的报道不可信吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920123
					]
				},
				{
					"id": 740920103,
					"content": "你在这里做什么呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920104
					]
				}
			]
		}
	]
}