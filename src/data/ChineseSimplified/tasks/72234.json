			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"桦山"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722340101,
					"content": "怎么样，坐起来舒服吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340102
					],
					"speakerTitle": "桦山"
				},
				{
					"id": 722340102,
					"content": "突然出现，吓我一跳！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340103
					]
				},
				{
					"id": 722340103,
					"content": "抱歉抱歉，没打算这样的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340104
					],
					"speakerTitle": "桦山"
				},
				{
					"id": 722340104,
					"content": "我叫桦山，你现在坐的位置我也经常坐。很安静，适合思考人生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340105
					],
					"speakerTitle": "桦山"
				},
				{
					"id": 722340105,
					"content": "那我让、让给你？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340106
					]
				},
				{
					"id": 722340106,
					"content": "唉，谢谢，可是不必了。话说，你是从别处来的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340107
					],
					"speakerTitle": "桦山"
				},
				{
					"id": 722340107,
					"content": "是的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340108
					]
				},
				{
					"id": 722340108,
					"content": "那你一定见识很广吧。我从来没出去过，虽然四处搬家的经历倒是很丰富。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340109
					],
					"speakerTitle": "桦山"
				},
				{
					"id": 722340109,
					"content": "唉，说起这搬家的经历…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340110
					],
					"speakerTitle": "桦山"
				},
				{
					"id": 722340110,
					"content": "因为年少时频频搬家，几乎没结识几个相熟的伙伴。独自四处游荡时发现了不错的景致也无人可分享…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340111
					],
					"speakerTitle": "桦山"
				},
				{
					"id": 722340111,
					"content": "唉，如果能让你看看那些景致，那倒也好。你在旅途中经过这些地方，不妨坐下看看，要是能回来和我谈谈你的感受那就更好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340112
					],
					"speakerTitle": "桦山"
				},
				{
					"id": 722340112,
					"content": "一处在狭间之街最高处的石门下，一处在常夜灵庙旁珊瑚环绕的空阔地，一处在蛇心之地的高耸残垣旁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340113
					],
					"speakerTitle": "桦山"
				},
				{
					"id": 722340113,
					"content": "我在这些地方都留下了标记，在高处挂了灯盏，给自己照亮。你应该能很容易找到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "桦山"
				}
			]
		},
		{
			"id": 7223402,
