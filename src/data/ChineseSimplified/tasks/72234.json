			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"桦山"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722340301,
					"content": "你回来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340302
					],
					"speakerTitle": "桦山"
				},
				{
					"id": 722340302,
					"content": "你已经去过所有的地方了吗？见多识广的你或许会觉得这些地方的景色都不值一提吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340303,
						722340304
					],
					"speakerTitle": "桦山"
				},
				{
					"id": 722340303,
					"content": "我觉得挺不错的，很独特。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340305
					]
				},
				{
					"id": 722340305,
					"content": "唉，想想我还从来没跟人分享过这些。能知道你的感想就足够了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340306
					],
					"speakerTitle": "桦山"
				},
				{
					"id": 722340306,
					"content": "也许别处有比这里好得多的地方吧。毕竟这里黑黢黢的，饭食也没什么选择的余地，还得提防龙蜥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340307
					],
					"speakerTitle": "桦山"
				},
				{
					"id": 722340307,
					"content": "但是生活得久了，竟还是有些不舍的感觉。在那几处看过的风景，现在想起来，也还是觉得怀念。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340308
					],
					"speakerTitle": "桦山"
				},
				{
					"id": 722340308,
					"content": "你也会有这样的感觉吗？即使是这样的地方，住得久了，也会有家的感觉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340309,
						722340310
					],
					"speakerTitle": "桦山"
				},
				{
					"id": 722340309,
					"content": "也许吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340311
					]
				},
				{
					"id": 722340311,
					"content": "是这样吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340312
					],
					"speakerTitle": "桦山"
				},
				{
					"id": 722340312,
					"content": "…总之谢谢你听我说这些无用的闲话。虽然不是什么贵重的东西，但我只有这些了，请你收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "桦山"
				},
				{
					"id": 722340310,
					"content": "不会。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340311
					]
				},
				{
					"id": 722340304,
					"content": "普普通通，我见过更壮丽的景色。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340305
					]
				}
			]
		}
	]
}