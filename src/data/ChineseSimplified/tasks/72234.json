					"桦山"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722340201,
					"content": "你回来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340202
					],
					"speakerTitle": "桦山"
				},
				{
					"id": 722340202,
					"content": "你还没有找到所有的地方吗？那太可惜了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340203
					],
					"speakerTitle": "桦山"
				},
				{
					"id": 722340203,
					"content": "我再说一次吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340204
					],
					"speakerTitle": "桦山"
				},
				{
					"id": 722340204,
					"content": "一处在狭间之街最高处的石门下，一处在常夜灵庙旁珊瑚环绕的空阔地，一处在蛇心之地的高耸残垣旁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340205
					],
					"speakerTitle": "桦山"
				},
				{
					"id": 722340205,
					"content": "我在这些地方都留下了标记，在高处挂了灯盏，给自己照亮。你应该能很容易找到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "桦山"
				}
			]
		},
		{
			"id": 7223403,
			"completionStepIds": [
				7223411
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
