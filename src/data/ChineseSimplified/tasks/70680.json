					}
				]
			},
			"dialogs": [
				{
					"id": 706800101,
					"content": "客人客人，请到这边来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800102
					],
					"speakerTitle": "小狼"
				},
				{
					"id": 706800102,
					"content": "有一条好消息要告知两位，虽然耽搁了一阵…不过现在新的舞台已经准备妥当了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800103
					],
					"speakerTitle": "小狼"
				},
				{
					"id": 706800103,
					"content": "为观众奉上精彩表演的客人将会获得开启画中世界门扉的钥匙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800104
					],
					"speakerTitle": "小狼"
				},
				{
					"id": 706800104,
					"content": "先、先等一下！故事书之后又是画中世界？这地方真是越来越叫人摸不着头脑了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706800105,
					"content": "我懂！我在故事书里看到过这样的说法，魔术师要是将自己的把戏全都透露给观众，那就是从观众那儿夺走了惊喜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800106
					],
					"speakerTitle": "小狼"
				},
				{
					"id": 706800106,
					"content": "所以，摸不着头脑才正好呢。魔女小姐的魔法就和爱一样，不是用来思考的东西，而是要去感受的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800107
					],
					"speakerTitle": "小狼"
				},
				{
					"id": 706800107,
					"content": "好吧，听你这么一说，好像也有些道理…不过话说回来，画中世界的舞台和之前的舞台有什么区别吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706800108,
					"content": "画中世界是规矩很多的世界，在新的舞台上，友谊和信赖将会被考验。是很常见的故事主题呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800109
					],
					"speakerTitle": "小狼"
				},
				{
					"id": 706800109,
					"content": "而通过了考验的朋友，会得到魔女小姐送上的一份小小的祝福…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800110
					],
					"speakerTitle": "小狼"
				},
				{
					"id": 706800110,
					"content": "欸？会是什么让人走运的咒语吗？比如…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800111,
						706800112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706800111,
					"content": "不要轻率许愿…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706800113
					]
				},
				{
					"id": 706800113,
					"content": "啊！对哦，不应该轻率地许愿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706800114,
					"content": "请放心，颜料已经落在了画框里，魔女小姐的小小祝福也不再是秘密。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800115
					],
					"speakerTitle": "小狼"
				},
				{
					"id": 706800115,
					"content": "客人若是准备好了，不妨亲自去画中世界的舞台一窥究竟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800116
					],
					"speakerTitle": "小狼"
				},
				{
					"id": 706800116,
					"content": "就像在故事里开始新的冒险那样，「吹起欢快的口哨吧，把烦忧抛在身后，将勇气戴于心上。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小狼"
				},
				{
					"id": 706800112,
					"content": "应该不是吧，而且…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706800113
					]
				}
			]
		}
	]
}