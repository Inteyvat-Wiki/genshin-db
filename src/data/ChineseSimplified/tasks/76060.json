			"dialogs": [
				{
					"id": 760600101,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600102
					],
					"speakerTitle": "梅拉"
				},
				{
					"id": 760600102,
					"content": "咦？这不是梅拉吗？它又出去取材了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760600103,
					"content": "嗯，但它回来后就一直这样，像是在思考什么一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600104
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760600104,
					"content": "说不定这次的主题比较深刻呢，就像大画家突然顿悟了世间真理什么的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760600105,
					"content": "说起来，梅拉已经给过我们好多幅画了呢，要是再这么画下去的话，都可以为它专门办个画展了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760600106,
					"content": "哼哼，到时候就由我来为人们讲述大画家梅拉的创作历程。当然，真要办画展的话，也得哥伦比娅同意才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760600107,
					"content": "嗯？为什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600108
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760600108,
					"content": "梅拉画的几乎都是你…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600109
					]
				},
				{
					"id": 760600109,
					"content": "哦，没事，我不介意。听起来挺有趣的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600110
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760600110,
					"content": "~！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600111
					],
					"speakerTitle": "梅拉"
				},
				{
					"id": 760600111,
					"content": "哦！梅拉好像决定要画什么了！快快快，看看我们有什么合适的颜料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760600112,
					"content": "这次的话…就选一些比较深沉、静谧的颜色吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
