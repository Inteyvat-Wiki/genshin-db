			"dialogs": [
				{
					"id": 760600301,
					"content": "好，就这些吧。梅拉觉得呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760600302,
					"content": "~！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600303
					],
					"speakerTitle": "梅拉"
				},
				{
					"id": 760600303,
					"content": "它看起来挺满意的。嘿嘿…这次会是怎样的一幅画呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760600304,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600305
					],
					"speakerTitle": "梅拉"
				},
				{
					"id": 760600305,
					"content": "咦？已经画好了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760600306,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600307
					],
					"speakerTitle": "梅拉"
				},
				{
					"id": 760600307,
					"content": "梅拉的样子，看起来有些伤心呢，是因为画的关系吗？我看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760600308,
					"content": "啊，这次画的也是哥伦比娅呢，这是在…月光下散步吗？画中的你还抬头望着夜空。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760600309,
					"content": "我大概…是在看虚假之天外的那轮月亮吧。以前经常这么在晚上散步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600310
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760600310,
					"content": "以前？啊…这么说来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760600311,
					"content": "（现在的哥伦比娅几乎只能待在这处庭园里…明明挪德卡莱是她诞生的地方…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600312
					]
				},
				{
					"id": 760600312,
					"content": "以前散步的时候就会想，那个真实的「霜月」上究竟有些什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600313
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760600313,
					"content": "会不会也像这边一样，有很多小动物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600314
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760600314,
					"content": "还是说，其实什么都没有呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600315
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760600315,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600316,
						760600319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760600316,
					"content": "不如带一些上去？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600317
					]
				},
				{
					"id": 760600317,
					"content": "哈，你的想法很有趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600318
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760600318,
					"content": "不过…月亮在虚假之天外，或许还是不要让这里的小动物们陪我一起去冒险比较好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600322
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760600322,
					"content": "（一边是无法自由行动的「家」…一边是不知道有什么的「家」…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600323
					]
				},
				{
					"id": 760600323,
					"content": "（……）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600324
					]
				},
				{
					"id": 760600324,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600325
					],
					"speakerTitle": "梅拉"
				},
				{
					"id": 760600325,
					"content": "梅拉一定也很舍不得你走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600326
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760600326,
					"content": "我也舍不得它们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600327
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760600327,
					"content": "但这终究是我一个人的旅行。是需要我独自去寻找的答案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600328
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760600328,
					"content": "说不定，这个答案其实很美好呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600329
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760600329,
					"content": "那，那到时候我们就带着梅拉一起去看望你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600330
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760600330,
					"content": "好啊，办一个月亮上的画展。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600331
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760600331,
					"content": "哇，听起来就不错！说好了啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600332
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760600332,
					"content": "嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600333
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760600333,
					"content": "希望如此…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760600319,
					"content": "说不定有其他可爱的生灵。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600320
					]
				},
				{
					"id": 760600320,
					"content": "唔，希望如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600321
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760600321,
					"content": "也希望它们欢迎我这个突然回家的「神明」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600322
					],
					"speakerTitle": "「少女」"
				}
			]
		},
