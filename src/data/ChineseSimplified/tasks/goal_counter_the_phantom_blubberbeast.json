						"position": [
							3559.818,
							446.167,
							4448.293
						],
						"pointId": 6271
					},
					{
						"sceneId": 3,
						"position": [
							3552.219,
							446.167,
							4434.63
						],
						"pointId": 6562
					}
				]
			},
			"dialogs": [
				{
					"id": 745060201,
					"content": "我拍拍拍拍拍…素材多多多多多…摩拉滚滚滚滚来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060202
					],
					"speakerTitle": "乐平波琳"
				},
				{
					"id": 745060202,
					"content": "啊！不得了的大人物出现了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060203
					],
					"speakerTitle": "乐平波琳"
				},
				{
					"id": 745060203,
					"content": "你们好啊，两位！我能给你们拍张照吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060204
					],
					"speakerTitle": "乐平波琳"
				},
				{
					"id": 745060204,
					"content": "咦…那个人是在叫我们吗？她要给我们留影？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060205,
						745060206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745060205,
					"content": "合影留念倒没什么问题…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745060207
					]
				},
				{
					"id": 745060207,
					"content": "#嘿嘿…看来我和{NICKNAME}也算是超级大名人了呢，居然有人主动给我们留影！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745060208,
					"content": "不过，如果你要把我们的照片用在别的地方，按照枫丹的说法，你应该付我们…唔…出场费？出镜费？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745060209,
					"content": "好！拍到你们两位是我乐平波琳的荣幸，这张照片算你们一百五十万摩拉怎么样？尊贵的皇牌冒险家搭档？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060210
					],
					"speakerTitle": "乐平波琳"
				},
				{
					"id": 745060210,
					"content": "嗯嗯！这还差不多嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745060211,
					"content": "欸，等等，你说多少？一百五十万？我没听错吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745060212,
					"content": "一张照片就给我们一百五十万…是不是有点夸张了？我们俩的形象有这么值钱吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060213,
						745060214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745060213,
					"content": "那赶紧再多拍点！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745060215
					]
				},
				{
					"id": 745060215,
					"content": "啊哈！区区一百五十万，根本不算什么！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060216
					],
					"speakerTitle": "乐平波琳"
				},
				{
					"id": 745060216,
					"content": "如果你们愿意跟我合作，带着留影机轻轻松松拍拍…就算分到九位数的摩拉，也不在话下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060217
					],
					"speakerTitle": "乐平波琳"
				},
				{
					"id": 745060217,
					"content": "九位数…个十百千万…十万百万千万…这这这这这么多？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060218,
						745060219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745060218,
					"content": "数字编得太离谱了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745060220
					]
				},
				{
					"id": 745060220,
					"content": "没错！太夸张了啦！这种话就算是我也不会相信的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745060221,
					"content": "你该不会是什么诈骗犯，想要以我们两个的名义去招摇撞骗吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745060222,
					"content": "招摇撞骗？嘿，还真被你们猜对了主题——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060223
					],
					"speakerTitle": "乐平波琳"
				},
				{
					"id": 745060223,
					"content": "只不过恰恰相反，我的这桩差事可以让那些招摇撞骗的家伙从提瓦特彻底消失，还能给你们一大笔分红！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060224
					],
					"speakerTitle": "乐平波琳"
				},
				{
					"id": 745060224,
					"content": "你，你说慢一点！我有点跟不上你的思路了…你只不过在路边拍照而已，怎么说得像是…在打击犯罪？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745060225,
					"content": "这就不得不提到大家都很容易忽视的问题了——警卫机关的「目标识别」能力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060226
					],
					"speakerTitle": "乐平波琳"
				},
				{
					"id": 745060226,
					"content": "我们都知道，警卫机关想要打击不法行为时，首先要确定对方是罪犯，没错吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060227
					],
					"speakerTitle": "乐平波琳"
				},
				{
					"id": 745060227,
					"content": "无论把好人当成了坏家伙，还是忽视了带着武器的潜在罪犯，都会导致很大的问题！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060228
					],
					"speakerTitle": "乐平波琳"
				},
				{
					"id": 745060228,
					"content": "比如说，把渔师手里的鱼竿当成了长枪，或者被伪装成水管的武器骗过！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060229
					],
					"speakerTitle": "乐平波琳"
				},
				{
					"id": 745060229,
					"content": "好像有点道理…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060230
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745060230,
					"content": "那么，假如我穿着猫猫狗狗、团雀鸽子，甚至膨膨兽的伪装服，像是从游乐园里跑出来的演员，警卫机关要怎么应对我呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060231,
						745060232
					],
					"speakerTitle": "乐平波琳"
				},
				{
					"id": 745060231,
					"content": "游乐园？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745060233
					]
				},
				{
					"id": 745060233,
					"content": "这，这犯规了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060234
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745060234,
					"content": "你说的这些动物都很可爱，警卫机关一般是不会出手的吧！而且膨膨兽也根本不会出现在城里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060235
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745060235,
					"content": "噔噔！答到要害了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060236
					],
					"speakerTitle": "乐平波琳"
				},
				{
					"id": 745060236,
					"content": "实际上，城区内的警卫机关根本不会将猫猫狗狗，团雀鸽子，尤其是膨膨兽列为目标，识别图像的时候，会直接跳过它们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060237
					],
					"speakerTitle": "乐平波琳"
				},
				{
					"id": 745060237,
					"content": "考虑到机关运转的效率，将几乎不可能遇见的目标排除在列表之外，的确有助于提升工作的效能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060238
					],
					"speakerTitle": "乐平波琳"
				},
				{
					"id": 745060238,
					"content": "之前《蒸汽鸟报》就刊登过一则新闻：「几个观察力敏锐的罪犯发现了警卫机关的弱点，穿着膨膨兽的伪装服去行窃…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060239
					],
					"speakerTitle": "乐平波琳"
				},
				{
					"id": 745060239,
					"content": "「结果警卫机关将他们当成了空气，完全没有对他们的犯罪行为进行干预。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060240,
						745060241
					],
					"speakerTitle": "乐平波琳"
				},
				{
					"id": 745060240,
					"content": "真狡猾欸！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745060242
					]
				},
				{
					"id": 745060242,
					"content": "穿着膨膨兽的伪装服去犯罪？还被警卫机关无视了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060243
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745060243,
					"content": "仔细想想，又好气，又有点可怕…如果那群人不满足于偷东西，而是要做更大的坏事…那不就太糟糕了吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060244
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745060244,
					"content": "所以说，这是一场关乎图形识别的对抗，而且随着罪犯伪装技术的进步，这场对抗会愈演愈烈，最终演变成技术的战争！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060245
					],
					"speakerTitle": "乐平波琳"
				},
				{
					"id": 745060245,
					"content": "为了枫丹的治安，本人——「图形对抗学」工程师乐平波琳，必须尽早站出来做点贡献！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060246
					],
					"speakerTitle": "乐平波琳"
				},
				{
					"id": 745060246,
					"content": "我正在收集各种图形样本，从大量样本中总结出一套简洁、高效而准确的图形识别逻辑，将它们做成一个小型辅助装置…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060247
					],
					"speakerTitle": "乐平波琳"
				},
				{
					"id": 745060247,
					"content": "只要将这个小型辅助装置安装在发条机关上，它们立即就能拥有识破伪装，准确判断罪犯的能力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060248
					],
					"speakerTitle": "乐平波琳"
				},
				{
					"id": 745060248,
					"content": "依照我的计划，为了保证治安的效果，沫芒宫会为所有警卫机关进行升级…这是何等惊人的商机啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060249,
						745060250
					],
					"speakerTitle": "乐平波琳"
				},
				{
					"id": 745060249,
					"content": "所以你才对着街道留影吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745060251
					]
				},
				{
					"id": 745060251,
					"content": "我有种熟悉的预感…一般来说，像你这样搞研究的人，都不擅长跋山涉水，所以只能在城里收集样本…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060252
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745060252,
					"content": "你想找我们合作，也是为了让我们帮你跑腿，去对各种东西留影，收集更多样本，没错吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060253
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745060253,
					"content": "咳咳…完全正确！不愧是皇牌冒险家搭档，很快就理解了我的需求。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060254
					],
					"speakerTitle": "乐平波琳"
				},
				{
					"id": 745060254,
					"content": "来吧，加入我的项目组，我们一起成为「图形对抗」的专家，拆穿那些罪犯的花招！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060255
					],
					"speakerTitle": "乐平波琳"
				},
				{
					"id": 745060255,
					"content": "重要的是，你们能和我一起抓住「图形对抗」的脉络，为枫丹的技术进步和治安做出巨大的贡献，名利双收！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060256
					],
					"speakerTitle": "乐平波琳"
				},
				{
					"id": 745060256,
					"content": "嗯…这么说来，乐平波琳的研究还挺有价值的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060257
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745060257,
					"content": "就算不考虑摩拉的分成，我们也不能坐视不理…不能让更多坏家伙做了坏事，还把污名丢给膨膨兽！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060258,
						745060259
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745060258,
					"content": "我们不能坐视不理！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745060260
					]
				},
				{
					"id": 745060260,
					"content": "好，真是爽快！这下，我们就确认合作关系了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060261
					],
					"speakerTitle": "乐平波琳"
				},
				{
					"id": 745060261,
