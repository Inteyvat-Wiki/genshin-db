					"维克多"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411270401,
					"content": "盒子里装了什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270402
					]
				},
				{
					"id": 411270402,
					"content": "呃，你这就别管了，就是一点小玩意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270403
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 411270403,
					"content": "喂！别用这种怀疑的眼神看着我啊！我又不是什么坏人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270404
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 411270404,
					"content": "可你是愚人众啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270405
					]
				},
				{
					"id": 411270405,
					"content": "愚人众…愚人众就都是可疑的人吗？你这是哪里得来的结论！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270406
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 411270406,
					"content": "好了，你再去找找吧，<color=#00E1FFFF>真找不到的话，也可以回来找我</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270407
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 411270407,
					"content": "我再努力回忆回忆，看能不能想起什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "维克多"
				}
			]
		},
