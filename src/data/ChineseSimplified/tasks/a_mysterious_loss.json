					"维克多"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411270201,
					"content": "怎么？你还有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270202
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 411270202,
					"content": "没有线索实在不好找…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270203
					]
				},
				{
					"id": 411270203,
					"content": "呃，好吧，那你等会，我回忆一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270204
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 411270204,
					"content": "我是真想不起来了，好像也没什么特别的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270205
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 411270205,
					"content": "那我问你点问题…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270206
					]
				},
				{
					"id": 411270206,
					"content": "问题？也行，你要问什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "维克多"
				}
			]
		},
