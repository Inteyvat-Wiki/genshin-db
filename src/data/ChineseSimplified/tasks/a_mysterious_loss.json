					"维克多"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411270301,
					"content": "你去外面做了什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270302
					]
				},
				{
					"id": 411270302,
					"content": "喂，你别这么一副怀疑的表情行不行？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270303
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 411270303,
					"content": "我就是出去外面逛逛散散心而已啊！陨石落下来了之后，我就赶紧回来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270304
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 411270304,
					"content": "好了，你再去找找吧，<color=#00E1FFFF>真找不到的话，也可以回来找我</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270305
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 411270305,
					"content": "我再努力回忆回忆，看能不能想起什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "维克多"
				}
			]
		},
