			"dialogs": [
				{
					"id": 402050201,
					"content": "请…请冷静些！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050202
					],
					"speakerTitle": "阿索"
				},
				{
					"id": 402050202,
					"content": "爱诺！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050203,
						402050206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402050203,
					"content": "不能再胡闹了，爱诺！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402050204
					]
				},
				{
					"id": 402050204,
					"content": "可是，他们说要销毁铛铛七分甜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050205
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 402050205,
					"content": "我们当然不会让这件事发生，但胡来是解决不了问题的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402050209,
					"content": "不好了，一大批飞行机械偷袭了我们存储物资的地方，那台机械造物被抢走了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050210
					],
					"speakerTitle": "赫莉米"
				},
				{
					"id": 402050210,
					"content": "这个时候？难道是盯准了我们和这个女孩儿起冲突的时机…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050211
					],
					"speakerTitle": "阿索"
				},
				{
					"id": 402050211,
					"content": "哇，好多侦察单元！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402050212,
					"content": "肯定是那些黑市商人安排的，我们果然还被盯着！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050213
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 402050213,
					"content": "#{NICKNAME}，我可以直接在这里搭建一段临时的月灵旅路，麻烦你请月灵来帮忙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050214
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 402050214,
					"content": "我明白了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402050215
					]
				},
				{
					"id": 402050215,
					"content": "对啊，把它们打下来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402050206,
					"content": "我不会让爱诺的伙伴出事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402050207
					]
				},
				{
					"id": 402050207,
					"content": "嗯，还请相信我们，先冷静一下，这样胡来是绝对不行的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402050208,
					"content": "我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050209
					],
					"speakerTitle": "爱诺"
				}
			]
		},
