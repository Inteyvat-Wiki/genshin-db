				]
			},
			"dialogs": [
				{
					"id": 402050701,
					"content": "愿月光联系着你我，咏月使大人，请问您找我们有什么事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050702
					],
					"speakerTitle": "阿索"
				},
				{
					"id": 402050702,
					"content": "菈乌玛转述了你们来到这里的原因。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402050703
					]
				},
				{
					"id": 402050703,
					"content": "偷盗？我们怎么会做这种事？这是凭空污蔑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050704
					],
					"speakerTitle": "阿索"
				},
				{
					"id": 402050704,
					"content": "我们确实带回了一种危险的机械造物，但它并非是我们偷来的，而是从一伙匪徒手里抢到的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050705
					],
					"speakerTitle": "阿索"
				},
				{
					"id": 402050705,
					"content": "若有误会，那就向客人们澄清。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050706
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 402050706,
					"content": "我记得那是几天前，在附近的野外…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050707
					],
					"speakerTitle": "阿索"
				},
				{
					"id": 402050707,
					"content": "嗯？那些人在干什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050708
					],
					"speakerTitle": "阿索"
				},
				{
					"id": 402050708,
					"content": "还没好吗？我们得在被那帮原住民发现之前完成测试！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050709
					],
					"speakerTitle": "急躁的盗宝团成员"
				},
				{
					"id": 402050709,
					"content": "就不能去其他地方吗？这活儿干得提心吊胆…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050710
					],
					"speakerTitle": "冒失的盗宝团成员"
				},
				{
					"id": 402050710,
					"content": "蠢货，没听雇主说吗？这玩意儿对月矩力有特殊的需求，要不然也不用跑到这个地方来。闭上嘴，抓紧时间！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050711
					],
					"speakerTitle": "急躁的盗宝团成员"
				},
				{
					"id": 402050711,
					"content": "别喊，让我想想，应该是这里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050712
					],
					"speakerTitle": "冒失的盗宝团成员"
				},
				{
					"id": 402050712,
					"content": "什么！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050713
					],
					"speakerTitle": "阿索"
				},
				{
					"id": 402050713,
					"content": "你干了什么？这动静不被人注意到才怪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050714
					],
					"speakerTitle": "急躁的盗宝团成员"
				},
				{
					"id": 402050714,
					"content": "这…至少我们验证了这玩意儿的威力，不是吗？肯定可以回去交差了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050715
					],
					"speakerTitle": "冒失的盗宝团成员"
				},
				{
					"id": 402050715,
					"content": "唉，算是吧，那就收拾东西赶紧撤！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050716
					],
					"speakerTitle": "急躁的盗宝团成员"
				},
				{
					"id": 402050716,
					"content": "站住！放下你们持有的危险物品！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050717
					],
					"speakerTitle": "阿索"
				},
				{
					"id": 402050717,
					"content": "这么快？这玩意儿还能再启动一次吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050718
					],
					"speakerTitle": "急躁的盗宝团成员"
				},
				{
					"id": 402050718,
					"content": "刚刚的操作我也记不清了…这我可搬不动啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050719
					],
					"speakerTitle": "冒失的盗宝团成员"
				},
				{
					"id": 402050719,
					"content": "唉…赶紧跑吧，最重要的是我们不能被抓了现行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050720
					],
					"speakerTitle": "急躁的盗宝团成员"
				},
				{
					"id": 402050720,
					"content": "就是这样，我们没能抓到人，但是我们截获了他们手中的那种机械造物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050721
					],
					"speakerTitle": "阿索"
				},
				{
					"id": 402050721,
					"content": "爱诺，我再确认一下，你不会又造出了什么危险的东西吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050722
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 402050722,
					"content": "或许这是另一个误会？阿索看到的那种机械造物不一定就是铛铛七分甜吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050723
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402050723,
					"content": "嗯…那种机械造物上面有没有这个标识？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050724
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 402050724,
					"content": "嗯，有的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050725
					],
					"speakerTitle": "阿索"
				},
				{
					"id": 402050725,
					"content": "这是我为伙伴特别设计的标识，每次加标识的时候都会特殊处理一下，就算拆卸改装也绝对抹不掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050726
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 402050726,
					"content": "所以，那确实是铛铛七分甜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050727
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 402050727,
					"content": "既然误会已经澄清，就物归原主吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050728
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 402050728,
					"content": "恕我直言，咏月使大人，我认为不能如此草率。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050729
					],
					"speakerTitle": "阿索"
				},
				{
					"id": 402050729,
					"content": "那种机械造物和那夏镇的大炮在原理上十分相似，但我们不能对它们一视同仁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050730
					],
					"speakerTitle": "阿索"
				},
				{
					"id": 402050730,
					"content": "那夏镇的大炮利用月矩力一次次地击退了「狂猎」，守护了这片土地，我一直将其视为一种月神赐予的庇佑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050731
					],
					"speakerTitle": "阿索"
				},
				{
					"id": 402050731,
					"content": "然而那种机械造物…它更像是一种商品，很容易就会被恶徒掌控，用于满足他们的私欲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050732
					],
					"speakerTitle": "阿索"
				},
				{
					"id": 402050732,
					"content": "据我所知，这位工坊的主人经常与挪德卡莱的各大势力进行交易。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050733
					],
					"speakerTitle": "阿索"
				},
				{
					"id": 402050733,
					"content": "我怀疑她制作这种机械造物正是为了向他人出售，一旦让它流入黑市，继而被滥用…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050734
					],
					"speakerTitle": "阿索"
				},
				{
					"id": 402050734,
					"content": "铛铛七分甜是我的伙伴，它不是用来买卖的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050735
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 402050735,
					"content": "…这只是你的一面之词，我们可不能冒险。一旦让心怀不轨的人拿到了这种造物，圣洁的月光必将遭到亵渎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050736
					],
					"speakerTitle": "阿索"
				},
				{
					"id": 402050736,
					"content": "（我就说过，事情会变得很难办，这次趟进浑水了…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050737
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 402050737,
					"content": "在我看来，最好的处理方法还是销毁这种危险的造物，并防止类似的造物再次出现…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050738
					],
					"speakerTitle": "阿索"
				},
				{
					"id": 402050738,
					"content": "你说什么？你们想销毁铛铛七分甜？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050739
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 402050739,
					"content": "还请理解我们的苦衷…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050740
					],
					"speakerTitle": "阿索"
				},
				{
					"id": 402050740,
					"content": "你们都是坏蛋！给我让开！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "爱诺"
				}
			]
		},
