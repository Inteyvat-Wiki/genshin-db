			"dialogs": [
				{
					"id": 402050101,
					"content": "你好啊，菈乌玛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402050102,
					"content": "#{NICKNAME}和派蒙？愿月光联系着你我，不论日夜。嗯…心中烦扰，不妨直言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050103
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 402050103,
					"content": "你又看出来啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402050104,
					"content": "沐浴着月光的愁容正如满月的暗斑，于阴晴之间流露心绪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050105
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 402050105,
					"content": "让她先别说话，果然闹情绪了…咏月使大人，请先听我讲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050106
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 402050106,
					"content": "雅珂达仔细讲述了你们来这里的原因，她的措辞很小心。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402050107
					]
				},
				{
					"id": 402050107,
					"content": "…偷盗？此举卑劣，当为霜月之子所不齿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050108
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 402050108,
					"content": "目前都还只是猜测…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050109
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 402050109,
					"content": "请稍等片刻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050110
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 402050110,
					"content": "前几日，确实有一些族人带回了某种机械造物，请随我前去与他们当面对质，个中是非，自可辨明。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菈乌玛"
				}
			]
		},
