			"dialogs": [
				{
					"id": 402050301,
					"content": "你好啊，雅珂达。哇，那里果然来了好多人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402050302,
					"content": "可不要小瞧了我的情报网。这样吧，我们先查一查这里的交易记录，那个小偷有可能在这里出手他偷到的东西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050303
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 402050303,
					"content": "喂！是哪个坏蛋偷走了我的机器人伙伴？站出来，好好交代！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050304
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 402050304,
					"content": "（不是这么查的…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050305
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 402050305,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050306
					],
					"speakerTitle": "好奇的商人"
				},
				{
					"id": 402050306,
					"content": "这位莫非就是那个工坊的主人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050307
					],
					"speakerTitle": "好奇的商人"
				},
				{
					"id": 402050307,
					"content": "来得正好，更方便谈生意嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050308
					],
					"speakerTitle": "急切的商人"
				},
				{
					"id": 402050308,
					"content": "你们…你们谁是那个小偷？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050309
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 402050309,
					"content": "什么小偷？这里只有生意人。我想订制一种机械，价钱都好说！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050310
					],
					"speakerTitle": "好奇的商人"
				},
				{
					"id": 402050310,
					"content": "那个机器人女仆是你造出来的吧？这种技术卖不卖？我也想拥有一个机器人女仆！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050311
					],
					"speakerTitle": "急切的商人"
				},
				{
					"id": 402050311,
					"content": "你们…都闪开！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050312
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 402050312,
					"content": "咳咳！连最基本的规矩都不懂，怪不得沦落到在这种非法黑市里做生意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050313
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 402050313,
					"content": "就算工坊的主人愿意和你们做交易，也得通过这里的柜台来谈，明白吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050314
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 402050314,
					"content": "爱诺这家伙的机械造物放眼整个挪德卡莱都是抢手货，也不能怪这帮商人如此热情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050315
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 402050315,
					"content": "无论是伊涅芙还是铛铛七分甜，都不是用来买卖的，这里的大人都让我很讨厌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050316
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 402050316,
					"content": "#不过，{NICKNAME}说得对，这里的大人就算做贼也不会心虚，我的方法行不通…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050317
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 402050317,
					"content": "你真的想用那种方法把小偷揪出来啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402050318,
					"content": "没见过世面吧？这里的商人眼里只有钱，而道德在他们眼里不值钱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050319
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 402050319,
					"content": "线索还是得从柜台那边找，跟我来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雅珂达"
				}
			]
		},
		{
			"id": 4020504,
