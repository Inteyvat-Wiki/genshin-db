				]
			},
			"dialogs": [
				{
					"id": 402050401,
					"content": "最后一架，肯定就在上面了！啊，往那边逃了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402050402,
					"content": "看我的！不许跑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050403
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 402050403,
					"content": "爱诺，危险！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402050404,
					"content": "可恶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050405
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 402050405,
					"content": "爱诺——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402050406,
					"content": "#唔…{NICKNAME}？对了，那架侦察单元…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050407
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 402050407,
					"content": "你没事才最重要。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402050408
					]
				},
				{
					"id": 402050408,
					"content": "呼…真是太危险了，你这样也很乱来的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402050409,
					"content": "#没事就好…身手不错嘛，{NICKNAME}，我还以为必须要我出手呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050410
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 402050410,
					"content": "（幸亏没出事，不然的话，我真的想不到该怎么跟伊涅芙交代啊…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050411
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 402050411,
					"content": "根本不是没事！铛铛七分甜还是被抢走了…我是叮铃哐啷蛋卷工坊的老大，我不能在这时候哭…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050412
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 402050412,
					"content": "请容我代替族人向你致歉，如果没有他们的阻拦，或许你的伙伴就不会被劫走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050413
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 402050413,
					"content": "咏月使大人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050414
					],
					"speakerTitle": "阿索"
				},
				{
					"id": 402050414,
					"content": "如果她真的将那种机械造物视为谋利的手段，大可以重新制作，又何必展示这种足以让你们羞愧的勇气呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050415
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 402050415,
					"content": "即便是满月的光华，也无法在她的心绪上映出瑕疵，而你们那颗苛求的心，却已经要没入月华所无法触及的阴影之中了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050416
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 402050416,
					"content": "…请也接受我的道歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050417
					],
					"speakerTitle": "阿索"
				},
				{
					"id": 402050417,
					"content": "误会解开了就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050418
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402050418,
					"content": "所以，请不要悲伤。「心绪无瑕之人，总能得到月光的指引。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050419
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 402050419,
					"content": "你一定能找回同伴，有需要的话，我也愿意安排族人向你提供帮助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050420
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 402050420,
					"content": "…嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050421
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 402050421,
					"content": "但是话说回来，接下来该去哪里找？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050422
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402050422,
					"content": "结论很明显，动手的是那个非法黑市的商人，恐怕对方早就料到爱诺和霜月之子之间会发生冲突，就钻了这个空子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050423
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 402050423,
					"content": "更确切一点来说，最初把铛铛七分甜偷走的人可能也是他安排的，所以他早就知道铛铛七分甜在这里，能提前布局。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050424
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 402050424,
					"content": "目前来看，嫌疑最大的肯定是那个阿斯科，不过，好像也不能完全排除其他商人的嫌疑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050425
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 402050425,
					"content": "确实如此…看来雅珂达肯定知道去哪里查。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050426
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402050426,
					"content": "（又要我来？刚刚说过了，那里的商人都有嫌疑，黑市一散，谁知道都能跑到什么地方去？唉…刚刚不该卖弄的。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050427
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 402050427,
					"content": "雅珂达肯定也是见不得爱诺这么伤心，接下来也要仰仗你了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050428
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402050428,
					"content": "雅珂达，仰仗你了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402050429
					]
				},
				{
					"id": 402050429,
					"content": "（…这让我怎么拒绝啊？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050430
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 402050430,
					"content": "好吧，至少…至少先给我两天时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050431
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 402050431,
					"content": "再等两天，看来也是没办法的事呢。爱诺，现在有这么多人帮忙，不用担心的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050432
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402050432,
					"content": "我知道的…谢谢大家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "爱诺"
				}
			]
		},
