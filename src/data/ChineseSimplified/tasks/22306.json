			"dialogs": [
				{
					"id": 223060301,
					"content": "给我标上吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223060302
					]
				},
				{
					"id": 223060302,
					"content": "好，我现在就把地方给您标好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060303
					],
					"speakerTitle": "博来"
				},
				{
					"id": 223060303,
					"content": "您走好，拿到宝藏之后，记得拿回来我们一起分啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "博来"
				}
			]
		},
