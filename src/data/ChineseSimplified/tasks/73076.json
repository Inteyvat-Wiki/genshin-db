			"dialogs": [
				{
					"id": 730761001,
					"content": "「关于近期出现在附近的大型长鬓虎一事：」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730761002
					],
					"speakerTitle": "一张告示"
				},
				{
					"id": 730761002,
					"content": "「请勿在入夜后于附近逗留，据调查，该长鬓虎经常在夜间出没。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730761003
					],
					"speakerTitle": "一张告示"
				},
				{
					"id": 730761003,
					"content": "「请勿在附近投放肉食，投放肉食令长鬓虎饱足，并非正确的保持安全之法，反而会吸引长鬓虎长期在此活动。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "一张告示"
				}
			]
