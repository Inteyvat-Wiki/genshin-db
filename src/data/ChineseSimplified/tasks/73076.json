				"objectNames": [
					"纳吉布",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730760501,
					"content": "哦，「驮兽大王」？你们说的就是那个巨大的驮兽是吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760502
					],
					"speakerTitle": "纳吉布"
				},
				{
					"id": 730760502,
					"content": "前两天我想要去璃月，途径层岩巨渊旁的时候，就看到了那个家伙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760503
					],
					"speakerTitle": "纳吉布"
				},
				{
					"id": 730760503,
					"content": "幸好那个时候它在睡觉。我小心翼翼地绕过去，逃了一劫啊。它睡觉的时候就跟个小山包似的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760504
					],
					"speakerTitle": "纳吉布"
				},
				{
					"id": 730760504,
					"content": "嗯？你说位置吗，从这里到璃月得向南走，应该是南边的某个地方吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760505
					],
					"speakerTitle": "纳吉布"
				},
				{
					"id": 730760505,
					"content": "…咦，可是一般从须弥到璃月应该走水路才对，为什么要往层岩巨渊那个方向去啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730760506,
					"content": "这、这是个人隐私吧，和你们问的东西又没关系！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760507
					],
					"speakerTitle": "纳吉布"
				},
				{
					"id": 730760507,
					"content": "好了，我知道的就这么多，我还有别的事要做…别来烦我了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "纳吉布"
				}
			]
		},
