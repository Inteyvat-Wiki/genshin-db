			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"？？？",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730760101,
					"content": "哎呀…果然在须弥，才能感受到更多自然的气息啊，哈哈，相较而言，枫丹简直就是乌烟瘴气…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760102
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760102,
					"content": "嗯？怎么了，有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760103
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760103,
					"content": "只是有些好奇…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760104
					]
				},
				{
					"id": 730760104,
					"content": "是啊，你就住在这个帐篷里吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730760105,
					"content": "对，最近一段时间我都住在这里…哈哈我懂了，看到一个枫丹人住在须弥野外的帐篷，觉得很不可思议对吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760106
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760106,
					"content": "至于为什么这样，就让我好好解释一番吧…啊，首先，两位的名字是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760107
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760107,
					"content": "我叫派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730760108,
					"content": "#我叫{NICKNAME}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760109
					]
				},
				{
					"id": 730760109,
					"content": "#原来如此，是{NICKNAME}和派蒙，我记住了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760110
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760110,
					"content": "我是桑顿，如你们所见，我是一个枫丹人…之所以来须弥的理由嘛，当然是因为喜欢森林！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760111
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760111,
					"content": "总是生活在城市中，身体会因为缺少锻炼而衰弱，精神也会变得松懈和倦怠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760112
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760112,
					"content": "只有在广袤的自然中，才能重新得到那种与自然万物共存的深刻体会，而森林正是贴近自然最好的选择。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760113
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760113,
					"content": "所以就来须弥了，毕竟这里的森林大概是全提瓦特最好的森林啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760114
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760114,
					"content": "好像听懂了，但是又好像完全没有懂…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730760115,
					"content": "不过须弥的森林可是很危险的，有各种大大小小的魔物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730760116,
					"content": "当然要危险才行啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760117
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760117,
					"content": "啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730760118,
					"content": "要是不危险的话，就没有那种求生的感觉了！不用担心，我其实在枫丹也是有名的猎人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760119
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760119,
					"content": "什么呀，原来你说喜欢森林，是喜欢在森林里狩猎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730760120,
					"content": "哼，根本就是个枫丹来的偷猎者！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760121,
						730760122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730760121,
					"content": "看来我们必须干预一下了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760123
					]
				},
				{
					"id": 730760123,
					"content": "等等等等，你们弄错了，我可不是偷猎者…偷猎可是相当严重的违法行为。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760124
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760124,
					"content": "在枫丹如果被抓到偷猎，那一辈子就完了，我可不敢。我们枫丹猎人所做的，其实大多只是「凶猛动物的防治」而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760125
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760125,
					"content": "凶猛动物的…防治？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730760126,
					"content": "你想啊，太过靠近人类居住区的凶猛动物会导致双方都受到伤害吧…所以得把它们赶到居住区一定距离以外才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760127
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760127,
					"content": "是、是这样啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730760128,
					"content": "这样，附近的居民就不用面临凶猛动物的侵扰，而对于那些动物来说，居民的活动也不会对它们正常生活产生困扰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760129
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760129,
					"content": "实不相瞒，我也是听说了附近有类似的凶猛动物，接受了驱逐它们的委托，才住在这里的，身为猎人，怎么能坐视不管呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760130
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760130,
					"content": "…当然了，我个人也对这些凶猛动物有点兴趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760131
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760131,
					"content": "你看，这个就很让人在意，「生长过度的大型鳄鱼」，被孩子们称为「鳄鱼大王」，总觉得是在什么下水道传说里出现的角色。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760132
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760132,
					"content": "听说经常出没在附近的水域…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760133
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760133,
					"content": "还有「经常会尝试偷走孩童的长鬓虎罗阇」，「拦在通往璃月道路上的巨大驮兽」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760134
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760134,
					"content": "「长鬓虎罗阇」好像在西边的密林里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760135
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760135,
					"content": "「驮兽大王」，哦也就是那只巨大驮兽，也有几个被吓破了胆子的目击者，说是在东边的某块区域徘徊，一看到行人就会攻击…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760136
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760136,
					"content": "听上去都挺危险的呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760137
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730760137,
					"content": "是啊，要是你们遇到了，一定要小心…嗯，不知为何能从你们身上感受到那种老练猎人的气息，或许我的担忧是多余的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760138
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760138,
					"content": "如果路上遇到了，就帮忙驱逐一下这些凶猛动物吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760139
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760139,
					"content": "这样周围的居民也不会遇到危险了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760140
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760140,
					"content": "嗯，如果遇到的话…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760141
					]
				},
				{
					"id": 730760141,
					"content": "那真是太感谢了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760142
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760142,
					"content": "附近居民的安全，这些凶猛动物的安全，当然了，还有你们自己的安全，都要注意啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760143
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760143,
					"content": "嗯嗯，知道啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730760122,
					"content": "偷猎是会破坏生态的行为！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760123
					]
				}
			]
		},
