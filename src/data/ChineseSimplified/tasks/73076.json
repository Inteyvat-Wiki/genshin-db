			},
			"dialogs": [
				{
					"id": 730760601,
					"content": "咦，关于「驮兽大王」…啊啊，那是我前几天晚上去森林里的时候看到的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760602
					],
					"speakerTitle": "安纳亚"
				},
				{
					"id": 730760602,
					"content": "本来就是个全是乌云的晚上，我走路走到一半，发现旁边有一个小山般的黑影伴随着地震般轰隆隆的响声向我冲来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760603
					],
					"speakerTitle": "安纳亚"
				},
				{
					"id": 730760603,
					"content": "当时我就被吓晕过去，恢复意识已经是第二天的事了。把我背回来的人说，我昏倒在了山脚下…幸好没受什么重伤…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760604
					],
					"speakerTitle": "安纳亚"
				},
				{
					"id": 730760604,
					"content": "你说位置嘛…我也不太清楚，反正应该是在东边吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安纳亚"
				}
			]
		},
