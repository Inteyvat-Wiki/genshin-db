				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730760701,
					"content": "咦，什么，已经把凶猛动物驱赶走了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760702
					],
					"speakerTitle": "桑顿"
				},
				{
					"id": 730760702,
					"content": "我都还没见到呢…怎么样，那些凶猛动物是不是都挺强悍的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760703,
						730760705
					],
					"speakerTitle": "桑顿"
				},
				{
					"id": 730760703,
					"content": "也就那样吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760704
					]
				},
				{
					"id": 730760704,
					"content": "哈哈，看上去真是游刃有余。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760707
					],
					"speakerTitle": "桑顿"
				},
				{
					"id": 730760707,
					"content": "虽然听说那些凶猛动物都被驱逐，打从心底松了口气，但是不知为何，没有亲手驱逐他们，也让人觉得不甘心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760708
					],
					"speakerTitle": "桑顿"
				},
				{
					"id": 730760708,
					"content": "猎物被更强的对手抢走的画面，在自然中也是屡见不鲜啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760709
					],
					"speakerTitle": "桑顿"
				},
				{
					"id": 730760709,
					"content": "哈哈哈，如果还有下次，我是不会输的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760710
					],
					"speakerTitle": "桑顿"
				},
				{
					"id": 730760710,
					"content": "我们也不会输的！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760711
					]
				},
				{
					"id": 730760711,
					"content": "是的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760712
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730760712,
					"content": "不过，之前就觉得，「凶猛动物的防治」，在须弥应该是巡林员的工作吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760713
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730760713,
					"content": "哦，我不是之前也说了吗，我接受了委托…其实那个委托就是认识的巡林员给我的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760714
					],
					"speakerTitle": "桑顿"
				},
				{
					"id": 730760714,
					"content": "由于最近「死域」的一些问题，具体我也不清楚，但是他们似乎花了很多人力负责调查那个…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760715
					],
					"speakerTitle": "桑顿"
				},
				{
					"id": 730760715,
					"content": "所以「凶猛动物的防治」这样的工作就委托给我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760716
					],
					"speakerTitle": "桑顿"
				},
				{
					"id": 730760716,
					"content": "原来是这样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760717
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730760717,
					"content": "这次就多谢你了！这是驱逐凶猛动物的报酬，还请拿好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "桑顿"
				},
				{
					"id": 730760705,
					"content": "可厉害了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760706
					]
				},
				{
					"id": 730760706,
					"content": "是嘛，真想亲眼见一见…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760707
					],
					"speakerTitle": "桑顿"
				}
			]
		},
