			"trigger": {
				"objectNames": [
					"桑顿"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730760301,
					"content": "怎么样，你遇到那些凶猛动物了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760302
					],
					"speakerTitle": "桑顿"
				},
				{
					"id": 730760302,
					"content": "遇到的话就请你帮忙驱逐掉那些凶猛动物吧…「凶猛动物防治」，可是件有利于居民和动物双方的有益之举。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760303,
						730760305,
						730760309,
						730760313
					],
					"speakerTitle": "桑顿"
				},
				{
					"id": 730760303,
					"content": "关于「鳄鱼大王」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760304
					]
				},
				{
					"id": 730760304,
					"content": "据说「鳄鱼大王」就在城东边的水域附近…不过似乎很是狡猾，我去了好几次都没有见到啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "桑顿"
				},
				{
					"id": 730760305,
					"content": "关于「长鬓虎罗阇」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760306
					]
				},
				{
					"id": 730760306,
					"content": "附近似乎都在传「长鬓虎罗阇」的故事，说在夜半时分，它会从西边的森林里跑出来，抓走那些不愿乖乖睡觉的顽皮鬼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760307
					],
					"speakerTitle": "桑顿"
				},
				{
					"id": 730760307,
					"content": "虽然后面大概是父母吓唬孩子的说辞，不过据说「长鬓虎」在夜间确实会更活跃一些…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760308
					],
					"speakerTitle": "桑顿"
				},
				{
					"id": 730760308,
					"content": "听说有半夜赶路的旅人就曾经看到过那只巨大的「长鬓虎」，被追了好一段路，好在没有出什么事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "桑顿"
				},
				{
					"id": 730760309,
					"content": "关于「驮兽大王」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760310
					]
				},
				{
					"id": 730760310,
					"content": "听说一些野生驮兽有很强的领地概念，陌生人一旦进入领地就会受到它们的攻击，恐怕「驮兽大王」也一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760311
					],
					"speakerTitle": "桑顿"
				},
				{
					"id": 730760311,
					"content": "它的领地就在东边的某个区域…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760312
					],
					"speakerTitle": "桑顿"
				},
				{
					"id": 730760312,
					"content": "究竟多大的驮兽能够被人叫作「驮兽大王」，真是让人在意啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "桑顿"
				},
				{
					"id": 730760313,
					"content": "还在调查…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760314
					]
				},
				{
					"id": 730760314,
					"content": "是嘛，那就继续加油吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "桑顿"
				}
			]
		},
