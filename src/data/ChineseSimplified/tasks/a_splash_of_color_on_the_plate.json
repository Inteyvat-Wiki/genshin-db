			"dialogs": [
				{
					"id": 756730101,
					"content": "看来，调色家阿夏已经心满意足了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730102
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 756730102,
					"content": "我们成功帮助神奇的阿夏，完成了又一个特别的挑战！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730103
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 756730103,
					"content": "好耶，收集颜料大成功~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756730104,
					"content": "这只阿夏是马上就来灵感了嘛，等不及要去作画？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730105,
						756730106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756730105,
					"content": "「噼咔」的那一会儿转瞬即逝…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756730107
					]
				},
				{
					"id": 756730107,
					"content": "#啊，它还留下了不少自己收集的财宝呢…都给{NICKNAME}和派蒙当辛苦费才对！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730108
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 756730108,
					"content": "说不定，过段时间我们再来，就能看见调色家阿夏的新杰作了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730109
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 756730109,
					"content": "普通的阿夏就能喷出很好看的色彩了，这种特别的阿夏，会有多厉害呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756730110,
					"content": "哎呀，感觉已经开始期待了，说不定真能被它们调出什么…一般语言形容不出来的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756730111,
					"content": "燃素啊，月亮啊，星空深处的颜色？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756730112,
					"content": "对嘛，在冒险过程中，只要遇见了遭遇困难的生灵，就尽可能给对方最真诚的帮助…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730113
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 756730113,
					"content": "嗯嗯！说不定哪天，还能得到意想不到的回报呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730114,
						756730115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756730114,
					"content": "我也赞成班尼特。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756730116
					]
				},
				{
					"id": 756730116,
					"content": "啊，不过…如果只为了回报而去帮助，有点本末倒置了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730117
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 756730117,
					"content": "就算没有任何酬劳，看见问题被解决，原本面露难色的朋友们开心起来，一切事情都在向着好的方向发展…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730118
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 756730118,
					"content": "我喜欢这种感觉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "班尼特"
				},
				{
					"id": 756730115,
					"content": "这样感觉很充实。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756730116
					]
				},
				{
					"id": 756730106,
					"content": "谁也不想放过灵感最好的时候吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756730107
					]
				}
			]
		}
	]
}