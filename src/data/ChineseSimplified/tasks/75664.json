				"points": []
			},
			"dialogs": [
				{
					"id": 756640101,
					"content": "#{NICKNAME}和派蒙！哈哈，终于见到真人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756640102
					],
					"speakerTitle": "巴罗"
				},
				{
					"id": 756640102,
					"content": "欢迎来到荣花演武的主会场。我已经听首领们说过了，你们是来报名参赛的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756640103
					],
					"speakerTitle": "巴罗"
				},
				{
					"id": 756640103,
					"content": "是呀！不过我们还不是很了解，比赛的具体内容是什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756640104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756640104,
					"content": "既然这样，由我来为你们简单介绍一下规则吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756640105
					],
					"speakerTitle": "巴罗"
				},
				{
					"id": 756640105,
					"content": "首先呢，荣花演武会分成「进攻战」和「守备战」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756640106
					],
					"speakerTitle": "巴罗"
				},
				{
					"id": 756640106,
					"content": "守备战很好理解嘛，就是阻止对手进攻部族；进攻战要复杂一些，它是假定部族已经失守，现在要吹响反攻的号角。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756640107
					],
					"speakerTitle": "巴罗"
				},
				{
					"id": 756640107,
					"content": "为了让比赛更有趣味性，我们制作了特殊的仪式道具。进攻方需要为它积蓄能量，破坏掉对手的特殊结界。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756640108
					],
					"speakerTitle": "巴罗"
				},
				{
					"id": 756640108,
					"content": "还有，即使是比赛，我们也不想见到纯粹的暴力与冲突。打坏的东西要重新修好，另外遇到魔物也请及时清剿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756640109
					],
					"speakerTitle": "巴罗"
				},
				{
					"id": 756640109,
					"content": "#呜哇…我已经有点听晕了。{NICKNAME}，你记住了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756640110,
						756640111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756640110,
					"content": "差不多…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756640112
					]
				},
				{
					"id": 756640112,
					"content": "没关系，有什么问题都可以来问我。而且比赛并不复杂，亲身参与几次，很快就能掌握要领。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "巴罗"
				},
				{
					"id": 756640111,
					"content": "没记住…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756640112
					]
				}
			]
		}
	]
}