			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"木南杏奈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120060301,
					"content": "哎呀，菜谱写好了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060601,
					"content": "写好啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060602
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120060602,
					"content": "谢谢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060603
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060603,
					"content": "哇…真期待啊，好想马上去做新菜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060604
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060604,
					"content": "旅行者，派蒙，抱歉耽搁了你们的用餐时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060605
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120060605,
					"content": "嘿嘿，劳动后的食物更美味！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120060606,
					"content": "让我们趁热吃吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060607
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120060607,
					"content": "怎么样，稻妻的料理合你们口味吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060608
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120060609,
					"content": "很不错，我喜欢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060611
					]
				},
				{
					"id": 120060610,
					"content": "别有一番风味哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060611
					]
				},
				{
					"id": 120060608,
					"content": "好吃！这个好吃，还有那边那个，也特别好吃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060609,
						120060610
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120060611,
					"content": "哈哈，那我就放心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060612
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120060612,
					"content": "对了，刚才我在那边试做料理的时候，你们有跟店主闲聊吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060613
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120060613,
					"content": "她、她有没有说什么…有关我的事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060614
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120060614,
					"content": "说了一些哦，不过她是为你高兴，没有别的意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060615
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120060615,
					"content": "为我…高兴？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060616
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120060616,
					"content": "呜…果然说了吧！她、她是不是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060617
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120060617,
					"content": "唉，算了，我就是朋友很少，我自己也知道啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060618
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120060618,
					"content": "不奇怪哦，别人只是还没有找到跟你多说话的机会而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060619
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120060619,
					"content": "谢谢你安慰我，派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060620
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120060620,
					"content": "那些都是实话，我这个人…朋友确实比较少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060621
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120060622,
					"content": "才没有这种事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060624
					]
				},
				{
					"id": 120060623,
					"content": "我就是你的朋友哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060624
					]
				},
				{
					"id": 120060621,
					"content": "平日跟我走得近的只有家人和下属。所以，看见我约你出来吃饭，大家应该会很震惊吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060622,
						120060623
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120060624,
					"content": "对呀对呀，你有朋友，我们都是！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060625
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120060625,
					"content": "呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060626
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120060626,
					"content": "谢谢你们，我、我很开心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060627
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120060627,
					"content": "抱歉…真是失态啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060628
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120060628,
					"content": "有什么情绪就发泄出来嘛，不要憋着。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060629
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120060629,
					"content": "嗯！所以…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060630
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120060630,
					"content": "我也是你们重要的朋友了。我真的…非常高兴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060631
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120060631,
					"content": "应该的嘛，我们一直都是这样，谁对我们好，我们就也对他好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060632
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120060632,
					"content": "友情很重要，会影响到很多人！就像你妈妈的笔记本也会让你想要见见那个名叫「椿」的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060633
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120060633,
					"content": "嗯！友情对我来说很珍贵，我会好好珍惜与你们的这份因缘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060634
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120060634,
					"content": "不过这么一说，那个名叫「椿」的人到底是谁呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060635
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120060636,
					"content": "愿闻其详。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060637
					]
				},
				{
					"id": 120060635,
					"content": "关于这件事，我有一个初步推测。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060636
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120060638,
					"content": "……？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060639
					]
				},
				{
					"id": 120060637,
					"content": "我认为，「椿」…或许是「狐狸神使」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060638
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120060639,
					"content": "「狐狸神使」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060640
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120060640,
					"content": "嗯，我是这么想的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060641
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120060641,
					"content": "就连我也从未听过母亲有这样一位朋友，如此神秘，一定是平日很难见到的高人吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060642
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120060642,
					"content": "稻妻自古就有不少关于狐狸神使的逸闻哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060643
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120060643,
					"content": "你们应该见过八重宫司了吧？她就是狐狸神使哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060644
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120060644,
					"content": "若是朝这个方向推测，稻妻大地上或许还有其他不为人知的狐狸神使…而那位「椿」，也许就是其中一员。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060645
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120060645,
					"content": "哇哦，稻妻也有仙人啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060646
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120060646,
					"content": "你说「也」的意思是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060647
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120060647,
					"content": "来稻妻之前，我们去过璃月。璃月有很多仙人哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060648
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120060648,
					"content": "天上飞的，地下跑的，水里游的，土里埋的…面面俱到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060649
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120060649,
					"content": "虽说我曾在书上见过类似说法，但听人亲口说起，还是非常惊讶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060650
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120060650,
					"content": "不愧是璃月…古老的文化孕育着最美丽的传说，令人向往。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060651
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120060651,
					"content": "有机会可以一起去璃月看看，那边也有非常非常多美食，可厉害了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060652
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120060652,
					"content": "可以吗？太好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060653
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120060653,
					"content": "不过在那之前，旅行者，派蒙，你们吃饱了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060654
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120060654,
					"content": "吃饱了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060655
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120060655,
					"content": "那么我们先去取衣物，然后就请二位随我一同见证存在于稻妻的神秘高人吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "神里绫华"
				}
			]
		},
