	"talks": [
		{
			"id": 1200601,
			"completionStepIds": [
				1200601
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200601",
							"2"
						],
						"stepId": 1200601,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"木南杏奈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120060101,
					"content": "是这间店对吧？真的是临街的开放式店铺呢，好亲切呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120060102,
					"content": "欢迎光临！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060103
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060103,
					"content": "木南小姐，你好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060104
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120060104,
					"content": "哎呀神里小姐，来得真准时！我们约定的差不多就是这个时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060105
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060105,
					"content": "是的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060106
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120060106,
					"content": "点单就按之前我预约的内容，另外，和你说好的那件事…也拜托了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060107
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120060107,
					"content": "好好，没问题，你要的东西我都准备好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060108
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060108,
					"content": "旅行者和这位小小的客人请在这边稍等一下，我去备菜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060109
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060109,
					"content": "旅行者，派蒙，先入座吧。我稍稍失陪一会儿，马上就来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060110,
						120060111
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120060110,
					"content": "有什么紧急状况吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060112
					]
				},
				{
					"id": 120060112,
					"content": "咳咳…不是那种情况啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060113
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120060113,
					"content": "只是处理一些小事，马上就来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060114
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120060114,
					"content": "走掉了…好像是有什么急事的样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120060115,
					"content": "二位是神里小姐的朋友吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060116
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060116,
					"content": "哈哈，我们店做的都是民间菜色，不敢说形式有多高级…啊不过，味道是很好的哦！希望你们能喜欢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060117
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060117,
					"content": "我们店开了很多年，与神里家的各位大人还算是有些交情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060118
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060118,
					"content": "神里家两兄妹都挺喜欢我们店的菜，以前总是请人来店里下单，买回府上享用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060119
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060119,
					"content": "不过没想到，这次她亲自过来店里，还带了朋友。我还是头一次听说神里小姐请朋友吃饭呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060120
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060120,
					"content": "居然是第一次，我们真有面子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120060121,
					"content": "是啊，虽然这话说起来有些冒犯…我也就跟你们说说，据我所知，神里小姐朋友似乎不多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060122
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060122,
					"content": "真叫人意外…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060123
					]
				},
				{
					"id": 120060123,
					"content": "怎么会？她人很好，又有礼貌，应该很受欢迎才对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120060124,
					"content": "原本我也这么想，但人际的规律却不是这样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060125
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060125,
					"content": "街坊邻里都说，神里小姐相貌美丽，出身高贵，举止优雅得体，简直像是高岭之花一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060126
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060126,
					"content": "太过完美，反而给人强烈的距离感。普通人家的孩子，几乎都不敢跟她随便搭话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060127
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060127,
					"content": "这么好的女孩子，反而难交到朋友呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060128
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060128,
					"content": "居然是这样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120060129,
					"content": "我跟她聊天不多，但也算是认识挺久了，一直很钦佩她年纪轻轻就肩负起了那么多责任。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060130
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060130,
					"content": "今天看她带人过来，我也很开心哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060131
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060131,
					"content": "你们今天可要多吃点！可以的话，请多陪她聊聊天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060132
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060132,
					"content": "就当是我们街坊邻居的请求，拜托了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060133
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060133,
					"content": "啊…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060134
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120060134,
					"content": "嗯？绫华的声音？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120060135,
					"content": "抱歉，旅行者…呃、呃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060136,
						120060137
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120060136,
					"content": "好像有爆炸声？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060138
					]
				},
				{
					"id": 120060138,
					"content": "能不能跟我到那边去，有件事…想麻烦你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060139
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120060139,
					"content": "对不起！突然把你叫出来，其实、其实…我刚才做料理失败了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060140
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120060140,
					"content": "原来那声巨响是锅子炸开的声音啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060141
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120060141,
					"content": "如你所见，这栋房屋就在餐厅旁边，是店主的私人住宅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060142
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120060142,
					"content": "这间院子也是他们家的私人区域，我是请店主帮忙准备了一些料理用具和食材，想在这里做一道特色料理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060143
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120060143,
					"content": "为什么要做料理？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060144
					]
				},
				{
					"id": 120060144,
					"content": "对啊，如果只是想吃东西，店里应该直接可以点菜吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060145
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120060145,
					"content": "我想做的是…送给「椿」的见面礼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060146
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120060146,
					"content": "我母亲笔记中提到，「椿」喜欢异国料理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060147
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120060147,
					"content": "这次要去见「椿」，我便想着，是不是做一份异国料理带给对方比较好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060148
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120060148,
					"content": "异国料理…只要不是稻妻料理就行吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060149
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120060149,
					"content": "这样的话，我们不是有很多选择吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060150,
						120060152
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120060150,
					"content": "其实，我是个大厨哦！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060151
					]
				},
				{
					"id": 120060151,
					"content": "我也这么想！像你这样四处旅行的人，一定懂得很多知识，了解各地美食…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060154
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120060154,
					"content": "可以请你帮我完成这件事吗？就当是帮我的忙，可、可以吗…？我会好好谢谢你的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060155,
						120060156
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120060155,
					"content": "好啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060157
					]
				},
				{
					"id": 120060157,
					"content": "什么样的异国食物适合带出门送人呢…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060158
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120060158,
					"content": "我知道我知道！说起这种类型的食物，一定就是那个吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060159
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120060159,
					"content": "「披萨」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060160
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120060160,
					"content": "披萨…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060161
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120060161,
