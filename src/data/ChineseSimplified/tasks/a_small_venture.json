			"dialogs": [
				{
					"id": 761390101,
					"content": "出版业也不挣钱哪，要不干脆只做投资算了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390102
					],
					"speakerTitle": "萨维特"
				},
				{
					"id": 761390102,
					"content": "想看看投资券…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761390103
					]
				},
				{
					"id": 761390103,
					"content": "好嘞，投资券2000摩拉一张，每周结算一次，嘿嘿，这小袋子里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390104
					],
					"speakerTitle": "萨维特"
				},
				{
					"id": 761390104,
					"content": "…呃！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390105
					],
					"speakerTitle": "萨维特"
				},
				{
					"id": 761390105,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761390106
					]
				},
				{
					"id": 761390106,
					"content": "没、没什么，就是不知道奈芙尔老板也大驾光临，您…您也想买张投资券吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390107
					],
					"speakerTitle": "萨维特"
				},
				{
					"id": 761390107,
					"content": "我就不了，只是陪我这位朋友过来看看而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390108
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 761390108,
					"content": "听说萨维特老板的投资生意做得有声有色，今天一看，果然如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390109
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 761390109,
					"content": "一般！一般，哈哈哈…小本生意，糊口罢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390110
					],
					"speakerTitle": "萨维特"
				},
				{
					"id": 761390110,
					"content": "这真的能赚钱吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761390111
					]
				},
				{
					"id": 761390111,
					"content": "那是当然，萨维特老板可是位优秀的生意人，跟着他投资，不会亏的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390112
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 761390112,
					"content": "是…是…哈哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390113
					],
					"speakerTitle": "萨维特"
				},
				{
					"id": 761390113,
					"content": "看看我今天运气怎么样…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761390114
					]
				},
				{
					"id": 761390114,
					"content": "今天！就在今天，您刚才买的是我们刚刚推出的…短线投资券！盈亏立即结算！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390115
					],
					"speakerTitle": "萨维特"
				},
				{
					"id": 761390115,
					"content": "怎么感觉这些话都是你刚刚才编出来的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761390116,
					"content": "呃…总、总之，感谢您购买短线投资券！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390117
					],
					"speakerTitle": "萨维特"
				},
				{
					"id": 761390117,
					"content": "这是您的投资回报，祝您拥有美好的一天！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390118,
						761390119
					],
					"speakerTitle": "萨维特"
				},
				{
					"id": 761390118,
					"content": "总之赚钱是好事啦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761390120
					]
				},
				{
					"id": 761390120,
					"content": "真的？嘿嘿嘿，那你给我买一个小鸟形状的，我就喜欢那样的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761390121,
					"content": "那我也告辞了，萨维特老板果然是个有信誉的好商人，祝您生意兴隆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390122
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 761390122,
					"content": "借奈芙尔老板吉言…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390123
					],
					"speakerTitle": "萨维特"
				},
				{
					"id": 761390123,
					"content": "…然后，奈芙尔老板，上次我拜托您帮忙找的那个…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390124
					],
					"speakerTitle": "萨维特"
				},
				{
					"id": 761390124,
					"content": "东西是已经找到了，但…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390125
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 761390125,
					"content": "萨维特先生，不要心急。事情，要一步一步地做才稳当。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390126
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 761390126,
					"content": "是、是，奈芙尔老板说的是…那就麻烦了，我就指望您了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "萨维特"
				},
				{
					"id": 761390119,
					"content": "走，派蒙，我们去买糖雕吃。",
