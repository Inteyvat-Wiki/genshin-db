			"dialogs": [
				{
					"id": 111120501,
					"content": "欸？原来你们都在这里了啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111120502,
					"content": "聚在一起叙旧，想想过去的事，是我们保持了很多很多年的习惯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120503
					],
					"speakerTitle": "小五"
				},
				{
					"id": 111120503,
					"content": "我们的家乡，在一场灾难之后全都被毁了。没有了能回去的地方，只能把有家乡人的地方当成是家乡了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120504
					],
					"speakerTitle": "木木"
				},
				{
					"id": 111120504,
					"content": "我听他们两个人说了，你们是在寻找信物吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120505
					],
					"speakerTitle": "聪子"
				},
				{
					"id": 111120505,
					"content": "我现在是璃月港的霄灯工匠，能够代表我的东西，大概就是霄灯了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120506
					],
					"speakerTitle": "聪子"
				},
				{
					"id": 111120506,
					"content": "前几天我购买了几块品质上乘的浮生石片，现在就放在码头的仓库。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120507
					],
					"speakerTitle": "聪子"
				},
				{
					"id": 111120507,
					"content": "我已经和管理员说过了，能不能麻烦你们再跑一趟，帮我把它取来呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120508
					],
					"speakerTitle": "聪子"
				},
				{
					"id": 111120508,
					"content": "#看来已经不需要解释什么了，{NICKNAME}，我们快去快回吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
