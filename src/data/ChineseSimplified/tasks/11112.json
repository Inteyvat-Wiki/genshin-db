			},
			"dialogs": [
				{
					"id": 111120101,
					"content": "事情发展成这样，我已经完全不明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120102,
						111120103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111120102,
					"content": "没想到就这样找到了狼哥。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120104
					]
				},
				{
					"id": 111120104,
					"content": "这倒是和我想的完全一样，记得我之前说的吗？世上哪有那么多恶鬼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120105
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111120105,
					"content": "他只是因为某种机缘巧合从无妄坡跑了出来，又因为某种原因回不去了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120106
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111120106,
					"content": "这种解释是不是太牵强了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111120107,
					"content": "其实…和她说得差不多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120108
					],
					"speakerTitle": "狼哥"
				},
				{
					"id": 111120108,
					"content": "欸？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111120109,
					"content": "哼哼，切勿质疑我的业务能力！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120110
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111120110,
					"content": "我只是很想知道我的朋友现在过得好不好，就很想来璃月港看一看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120111
					],
					"speakerTitle": "狼哥"
				},
				{
					"id": 111120111,
					"content": "我发誓我从来没有想做坏事或者恶作剧的想法！也绝不主动惊吓普通人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120112
					],
					"speakerTitle": "狼哥"
				},
				{
					"id": 111120112,
					"content": "前几天有几个人来无妄坡试胆，听说他们都是从璃月港来的，我就跟着其中一个人，一路尾随到了这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120113
					],
					"speakerTitle": "狼哥"
				},
				{
					"id": 111120113,
					"content": "就是那个可怜的洛成吧，虽然没有亲眼看到，但是肯定还是感觉到有人在跟随他，所以才会做噩梦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120114
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111120114,
					"content": "欸？我、我被发现了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120115
					],
					"speakerTitle": "狼哥"
				},
				{
					"id": 111120115,
					"content": "不然也不会吓成那个样子吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120116
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111120116,
					"content": "为什么不直接来找老孟？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120117
					]
				},
				{
					"id": 111120117,
					"content": "对哦，结果是胡桃和老孟在到处找你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111120118,
					"content": "这个，其实是因为我没有找到他们。我从来没有来过璃月港，然后就在城里迷路了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120119
					],
					"speakerTitle": "狼哥"
				},
				{
					"id": 111120119,
					"content": "哦对，这么说起来，狼哥小时候就分不清楚东南西北。要是我们不带着他，他都不敢自己下山。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120120
					],
					"speakerTitle": "老孟"
				},
				{
					"id": 111120120,
					"content": "居然是这么现实的理由？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111120121,
					"content": "但是鬼怪幽灵好像都会飞吧，只要飞起来，不就能找到路了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111120122,
					"content": "我、我不敢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120123
					],
					"speakerTitle": "狼哥"
				},
				{
					"id": 111120123,
					"content": "太高了，我会很害怕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120124
					],
					"speakerTitle": "狼哥"
				},
				{
					"id": 111120124,
					"content": "对对对，是的，小时候就只有他不敢从山上往下看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120125
					],
					"speakerTitle": "老孟"
				},
				{
					"id": 111120125,
					"content": "哈哈哈，你果然一点都没变啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120126,
						111120127
					],
					"speakerTitle": "老孟"
				},
				{
					"id": 111120126,
					"content": "…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120128
					]
				},
				{
					"id": 111120128,
					"content": "我知道我不应该主动出现在人的面前，但是璃月港来来往往的人又那么多，我就只能找地方躲起来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120129
					],
					"speakerTitle": "狼哥"
				},
				{
					"id": 111120129,
					"content": "直到我被地脉镇石吸引过去，发现了你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120130
					],
					"speakerTitle": "狼哥"
				},
				{
					"id": 111120130,
					"content": "原来你没有变成恶鬼，太好了，真是太好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120131
					],
					"speakerTitle": "老孟"
				},
				{
					"id": 111120131,
					"content": "都说了要相信我的专业判断嘛。接着只要把这个迷路的孩子送回无妄坡，就什么都解决了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120132
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111120132,
					"content": "不过，他刚刚说，是来看朋友的，那就应该不只是我，还有小五，木木，聪子三个人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120133
					],
					"speakerTitle": "老孟"
				},
				{
					"id": 111120133,
					"content": "那…既然如此，为了满足狼哥的心愿，就帮他办一场欢送仪式吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120134
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111120134,
					"content": "我和老孟把狼哥送回无妄坡，你去找这三个人各要一件能象征他们的信物，然后来找我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120135
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111120135,
					"content": "都是朋友，直接叫上他们不好吗？或者，直接带狼哥去见他们？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120136
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111120136,
					"content": "这…还是不要了吧，我怕吓坏他们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120137
					],
					"speakerTitle": "狼哥"
				},
				{
					"id": 111120137,
					"content": "我可不希望普通人都变得疑神疑鬼。不该知道的事，不知道更好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120138
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111120138,
					"content": "所以，你们获取信物的时候，也务必注意方法哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111120127,
					"content": "还是别叫「狼哥」了吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120128
					]
				},
				{
					"id": 111120103,
					"content": "狼哥不是恶鬼吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120104
					]
				}
			]
		},
		{
			"id": 1111202,
			"completionStepIds": [
				1111202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1111202",
							"2"
						],
						"stepId": 1111202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"小五"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111120201,
					"content": "你好，你还记得我们吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111120202,
					"content": "你们…抱歉，我真的不需要往生堂的服务。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120203,
						111120204
					],
					"speakerTitle": "小五"
				},
				{
					"id": 111120203,
					"content": "我们听说了老孟的故事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120205
					]
				},
				{
					"id": 111120205,
					"content": "嗯，我和老孟从小一起长大，现在还经常聚在一起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120206
					],
					"speakerTitle": "小五"
				},
				{
					"id": 111120206,
					"content": "不知道他什么时候去了往生堂，说实话，我觉得那里的堂主是个很古怪的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120207
					],
					"speakerTitle": "小五"
				},
				{
					"id": 111120207,
					"content": "但他可能也有他的理由吧，毕竟现在就他一个人，还有点放不下狼哥的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120208
					],
					"speakerTitle": "小五"
				},
				{
					"id": 111120208,
					"content": "他告诉你们狼哥的事了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120209
					],
					"speakerTitle": "小五"
				},
				{
					"id": 111120209,
					"content": "嗯嗯，我们都听说了。那假如说，如果让你选一件信物交给狼哥，你会选什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111120210,
					"content": "只是假如，打个比方，绝对不是我们真的要去纪念他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120211,
						111120212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111120211,
					"content": "（这暗示太明显了。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120213
					]
				},
				{
					"id": 111120213,
					"content": "我啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120214
					],
					"speakerTitle": "小五"
				},
				{
					"id": 111120214,
					"content": "应该会为他做一道菜吧，他是我们当中最能吃辣的，很喜欢吃辣度加倍的香嫩椒椒鸡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120215
					],
					"speakerTitle": "小五"
				},
				{
					"id": 111120215,
					"content": "如果你们能帮我找一些绝云椒椒来的话，我就能帮你们做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120216
					],
					"speakerTitle": "小五"
				},
				{
					"id": 111120216,
					"content": "保证是小时候的味道，他一定会很喜欢的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120217
					],
					"speakerTitle": "小五"
				},
				{
					"id": 111120217,
					"content": "好，那等我们一下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111120212,
					"content": "（派蒙还是老样子…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120213
					]
				},
				{
					"id": 111120204,
					"content": "老孟说和你是很多年的好朋友。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120205
					]
				}
			]
		},
		{
			"id": 1111203,
			"completionStepIds": [
