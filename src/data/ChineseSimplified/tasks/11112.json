				"points": []
			},
			"dialogs": [
				{
					"id": 111120301,
					"content": "嗯，这样应该就够了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120302
					],
					"speakerTitle": "小五"
				},
				{
					"id": 111120302,
					"content": "那我就去准备香嫩椒椒鸡了，你们应该还要去找其他人吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120303
					],
					"speakerTitle": "小五"
				},
				{
					"id": 111120303,
					"content": "等他们都准备好了，我也会把菜交给你们的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120304
					],
					"speakerTitle": "小五"
				},
				{
					"id": 111120304,
					"content": "好，知道了，那等会儿见！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111120305,
					"content": "（咦？他是怎么知道的？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 1111204,
			"completionStepIds": [
				1111204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1111204",
							"2"
