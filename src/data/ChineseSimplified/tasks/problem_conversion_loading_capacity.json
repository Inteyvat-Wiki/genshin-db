			},
			"dialogs": [
				{
					"id": 230210801,
					"content": "太棒了，非常成功！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210802
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230210802,
					"content": "船体的结构没有问题…吃水线也很稳定，也没有倾倒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210803
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230210803,
					"content": "绮珊，你看看，我的设计和计算完美无缺！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210804
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230210804,
					"content": "这才是负载试验的第一阶段，别高兴太早了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210805
					],
					"speakerTitle": "绮珊"
				},
				{
					"id": 230210805,
					"content": "而且你还没有考虑到天气因素和航行时货物挪移导致的船体重心问题…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210806
					],
					"speakerTitle": "绮珊"
				},
				{
					"id": 230210806,
					"content": "呃…呃，我会考虑的，你就先让我高兴一下嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210807
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230210807,
					"content": "对了旅行者，这是你的报酬，请先收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210808
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230210808,
					"content": "绮珊啊，你就不能给我打打气吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210809
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230210809,
					"content": "可是在造船这件事上，给人打气鼓劲没用啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210810
					],
					"speakerTitle": "绮珊"
				},
				{
					"id": 230210810,
					"content": "你还是好好想想，怎么给自己的钱包打气鼓劲吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "绮珊"
				}
			]
		},
