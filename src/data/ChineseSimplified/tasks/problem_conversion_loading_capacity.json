			"trigger": {
				"objectNames": [
					"拉菲克",
					"绮珊"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230210101,
					"content": "旅行者！你来得正好，船刚刚下水，十分平稳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210102
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230210102,
					"content": "我的计算果然没有任何问题！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210103
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230210103,
					"content": "所以，我们说好的负载试验什么时候开始？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210104
					],
					"speakerTitle": "绮珊"
				},
				{
					"id": 230210104,
					"content": "别着急嘛，旅行者都来了，我们马上开始。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210105
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230210105,
					"content": "负载试验是什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230210106
					]
				},
				{
					"id": 230210106,
					"content": "简单来说，就是用重物来测试船的负载能力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210107
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230210107,
					"content": "嗯…也就是说，需要有人和我一起把重物都搬到船上去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210108
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230210108,
					"content": "旅行者，我上次就发现你身强体壮，力量充沛，非常擅长这种工作…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210109,
						230210110
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230210109,
					"content": "原来这才是让我来的原因。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230210111
					]
				},
				{
					"id": 230210111,
					"content": "没、没有啦，我是真的没法一个人搞定这件事，只能拜托你来帮忙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210112
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230210112,
					"content": "而且报酬绝对不会少！放心吧，我前几天刚帮人去修好了一艘大船，拿了不少钱呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210113
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230210113,
					"content": "哦…不少钱啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210114
					],
					"speakerTitle": "绮珊"
				},
				{
					"id": 230210114,
					"content": "欸？那个，我几乎把钱都投入造船里了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210115
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230210115,
					"content": "全部？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210116
					],
					"speakerTitle": "绮珊"
				},
				{
					"id": 230210116,
					"content": "还留着一点！哎呀，我会请你喝咖啡的啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210117
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230210117,
					"content": "旅行者，我们赶紧开始吧，快快快！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230210110,
					"content": "生气。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230210111
					]
				}
			]
		},
		{
			"id": 2302106,
			"completionStepIds": [
				2302106
			],
