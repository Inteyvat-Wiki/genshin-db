			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"拉菲克",
					"绮珊"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230210614,
					"content": "好…嘞！这样就可以了，让我们来看看会发生什…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210601
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230210601,
					"content": "呜哇！那边漏水了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210615
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230210615,
					"content": "什么？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210602
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230210602,
					"content": "船，船都歪了！怎么回事呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210603
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230210603,
					"content": "快，快把东西搬下去，肯定是出问题了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210604
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230210604,
					"content": "和拉菲克匆匆忙忙地把所有东西都搬下了船…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230210605
					]
				},
				{
					"id": 230210605,
					"content": "呼…呼…还好东西不多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210606
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230210606,
					"content": "这到底…到底是哪里出问题了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210607
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230210607,
					"content": "我当初说什么来着？你计算的那些理论数据都太极限了，这样是不可靠的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210608
					],
					"speakerTitle": "绮珊"
				},
				{
					"id": 230210608,
					"content": "呼…我…我…好吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210609
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230210609,
					"content": "不应该啊，我都算得那么精确了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210610
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230210610,
					"content": "旅行者，谢谢你帮忙，这些是报酬，请你收下吧 。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210611
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230210611,
					"content": "我要回去重新计算一遍…绮珊，能再帮我一下吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210612
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230210612,
					"content": "…说得好像我都没帮忙似的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210613
					],
					"speakerTitle": "绮珊"
				},
				{
					"id": 230210613,
					"content": "交给我吧，计算完了之后记得请我喝咖啡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "绮珊"
				}
			]
		},
