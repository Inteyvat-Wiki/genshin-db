				"objectNames": [
					"若紫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726720401,
					"content": "怎么样，这张网用得还顺手吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720402
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720402,
					"content": "用了一次就坏掉了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720403
					]
				},
				{
					"id": 726720403,
					"content": "嗯…这也是没办法的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720404
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720404,
					"content": "我之前说了，那道术式可以拘出小动物的神形，但如果想要保存神形，或者再次化出小动物的形体，还需要另外的媒介。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720405
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720405,
					"content": "我把那道术式融进了「四方八方之网」里，保存神形和化出形体的媒介，就是这张网本身了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720406
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720406,
					"content": "好复杂…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720407
					]
				},
				{
					"id": 726720407,
					"content": "简单来说，就是一张网只能用一次啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720408
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720408,
					"content": "这也是我到现在都没解决的难题，媒介不能复用的话，那成本也太高了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720409
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720409,
					"content": "我会继续研究这张网，争取尽快解决这个问题的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720410
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720410,
					"content": "如果你还需要「四方八方之网」的话，就过来找我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720411
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720411,
					"content": "还有，那个…虽然这种网目前只能捕捉一下小动物，但制作起来其实也挺麻烦的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720412
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720412,
					"content": "所以嘛…嘿嘿，下次你想要这种网的话，就要付给我一点「成本费」啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720413
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720413,
					"content": "放心！你是珊瑚的朋友，我不会收你很多钱的，一定给你一个公道的价格！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "若紫"
				}
			]
		},
