				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726720501,
					"content": "你去找过若紫了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720502
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 726720502,
					"content": "关于「四方八方之网」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720503
					]
				},
				{
					"id": 726720503,
					"content": "「四方八方之网」…这名字倒是不错，不过那个术式嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720504
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 726720504,
					"content": "那个术式真能拘出人的神形吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720505
					]
				},
				{
					"id": 726720505,
					"content": "嗯…不可能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720506
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 726720506,
					"content": "那种阴阳术只有记载，具体的施术方式早就失传不知道多久了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720507
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 726720507,
					"content": "我给若紫的那道术式，只能拘出小动物的神形而已啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720508
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 726720508,
					"content": "那你为什么还告诉若紫…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720509
					]
				},
				{
					"id": 726720509,
					"content": "这个啊。我只是想让若紫帮我散出一个消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720510
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 726720510,
					"content": "「万端珊瑚侦探社的社长，正在拜托人以惟神阴阳术为核心，研制一种能让人说真话的网。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720511
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 726720511,
					"content": "失传已久的惟神阴阳术，万端珊瑚侦探社，还有确实能拘出小动物神形的网子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720512
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 726720512,
					"content": "这些要素综合在一起，足以形成一个听上去很厉害，感觉上也很真实的「街头传说」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720513
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 726720513,
					"content": "虽然这个「街头传说」对于常人来说只是一个小故事…但对于那些心里有鬼的犯人来说，可就不仅仅是故事那么简单了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720514
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 726720514,
					"content": "原来是这样吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720515
					]
				},
				{
					"id": 726720515,
					"content": "另外一方面的原因是…谁叫若紫一个劲地缠着我，要我给她一个「最厉害的阴阳术式」啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720516
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 726720516,
					"content": "我都说了没有了，但那家伙根本就听不进去。我实在没办法了，只能用这道阴阳术式来哄走她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720517
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 726720517,
					"content": "如果若紫不告诉别人这件事呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720518
					]
				},
				{
					"id": 726720518,
					"content": "不会的，那家伙从来都没法保守住秘密。我可太了解她了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720519
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 726720519,
					"content": "辛苦你帮我跑这一趟了，这些东西给你，就当做是报酬吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720520
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 726720520,
					"content": "希望若紫不要再来找我要新的阴阳术式了，我是个侦探，又不是阴阳师…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚"
				}
			]
		},
