			"trigger": {
				"objectNames": [
					"珊瑚"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726720101,
					"content": "若紫这家伙…真不该让她知道影郎丸的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720102
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 726720102,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720103
					]
				},
				{
					"id": 726720103,
					"content": "旅行者，是你啊。你还记得那张「四方之网」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720104
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 726720104,
					"content": "在我们解决了上次的事件之后，我把你的事迹也讲给我那位朋友听了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720105
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 726720105,
					"content": "她叫若紫，是个…嗯…她说自己是个「设计师」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720106
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 726720106,
					"content": "若紫那家伙听说了你操作这张网的方式之后，似乎很受启发。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720107
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 726720107,
					"content": "她一个劲地缠着我，想要让我帮她去找几个新术式，方便她继续改造那张「四方之网」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720108
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 726720108,
					"content": "我实在没办法，就去那本古籍里给她找了一道新术式…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720109
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 726720109,
					"content": "旅行者，如果你有兴趣的话，就去若紫那边看看吧，也许她现在已经把那张网给改造好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚"
				}
			]
		},
		{
			"id": 7267202,
			"completionStepIds": [
				7267202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
