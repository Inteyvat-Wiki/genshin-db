			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"若紫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726720201,
					"content": "这样就差不多完成了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720202
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720202,
					"content": "请问你是若紫吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720203
					]
				},
				{
					"id": 726720203,
					"content": "我是，你找我有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720204
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720204,
					"content": "关于「四方之网」的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720205
					]
				},
				{
					"id": 726720205,
					"content": "欸？我记起来了，你应该是那位旅行者吧？珊瑚和我提起过你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720206
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720206,
					"content": "你操作「四方之网」的方式可真是巧妙啊，给我很多启发。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720207
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720207,
					"content": "听说你正在改造它？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720208
					]
				},
				{
					"id": 726720208,
					"content": "没错。嘿嘿…珊瑚给了我一道全新的阴阳术式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720209
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720209,
					"content": "我用那道术式再次改造了一下这张网，现在这张网的名字是「四方八方之网」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720210
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720210,
					"content": "据珊瑚说，这道术式可以拘出生物的神形，再以某个物体为媒介，再次化出那个生物的形体。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720211
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720211,
					"content": "她还说，如果把这道阴阳术式演化到极致，甚至可以拘出人类的神形来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720212
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720212,
					"content": "被拘出来的人类神形可以回答问题，而且绝不会说谎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720213
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720213,
					"content": "这种术式对于珊瑚这样的侦探来说，可以算是最强的工具了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720214
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720214,
					"content": "我想，她也是因为这个原因，才愿意把那道术式给我，让我来改造这张网的吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720215
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720215,
					"content": "啊！你可别到处说啊！因为你是珊瑚的朋友，我才会把这些事告诉你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720216,
						726720217
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720216,
					"content": "这、这么强吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720218
					]
				},
				{
					"id": 726720218,
					"content": "呃…暂时还没有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720219
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720219,
					"content": "无论我用什么方式改造，这张网目前都只能拘出小动物的神形，对人类一点用都没有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720220
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720220,
					"content": "旅行者，你也来试用一下这张网吧，说不定…你操作这张网的方式，会再次给我一些启发呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720221
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720221,
					"content": "喏，这张网给你，现在这张网的名字是「四方八方之网」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720222
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720222,
					"content": "你快去用这张网抓些小动物试试吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720217,
					"content": "已经改造成功了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720218
					]
				}
			]
		},
		{
			"id": 7267204,
