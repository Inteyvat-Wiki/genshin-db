						"rawParams": [
							"7150102",
							"2"
						],
						"stepId": 7150102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"胡塞尼"
				],
				"points": [
					{
						"sceneId": 6,
						"position": [
							1007.447,
							1015.942,
							879.091
						],
						"pointId": 600100139
					},
					{
						"sceneId": 6,
						"position": [
							1006.518,
							1015.976,
							880.314
						],
						"pointId": 600100246
					}
				]
			},
			"dialogs": [
				{
					"id": 715010201,
					"content": "没想到这里的环境这么特殊…这样的话，「普尔希娜光钉」的能源系统…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010202
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715010202,
					"content": "#嗯？{NICKNAME}和派蒙，真是好久不见了，你们怎么也来层岩巨渊了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010203
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715010203,
					"content": "这么说来，我之前好像听海迪夫说过，你在层岩巨渊帮了勘探队许多忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010204
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715010204,
					"content": "不过现在的层岩巨渊环境相较之前变得更为恶劣和危险，可不是来散步的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010205
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715010205,
					"content": "你是？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010206
					]
				},
				{
					"id": 715010206,
					"content": "我们不是不久之前才刚见过吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010207
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715010207,
					"content": "虽然每次见面好像都麻烦你做了很多事，但也没必要装作不认识吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010208
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715010208,
					"content": "算了，那我就再自我介绍一下，我是须弥「教令院」的学者胡塞尼，之前进行「导能圆盘」的研究，还去稻妻进行了考察。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010209
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715010209,
					"content": "不过现在研究的经费用完了，所以不得不返回须弥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010210
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715010210,
					"content": "哦，我好像有点印象…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715010211,
					"content": "你想起我了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010212
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715010212,
					"content": "你就是——「圆盘人」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715010213,
					"content": "…我很确定自己不是什么「圆盘人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010214
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715010214,
					"content": "总之，我在回须弥的路上，接到了同为「教令院」学者海迪夫的委托，从前海迪夫帮过我一些忙，主要是研究经费上的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010215
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715010215,
					"content": "所以这次我就来层岩巨渊帮他解决这个问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010216
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715010216,
					"content": "我解释得够清楚了吧，你们呢，你们怎么会在这个时候来层岩巨渊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010217,
						715010218
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715010217,
					"content": "我们接了海迪夫的委托…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010219
					]
				},
				{
					"id": 715010219,
					"content": "哦哦，原来是你们。海迪夫之前说想要找人帮忙一起协助的时候，我还感到担忧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010220
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715010220,
					"content": "不过既然是你们的话，我就放心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010221
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715010221,
					"content": "这次层岩巨渊的黑泥涌出事件，如果只有我一个人来处理，就要耗费更多的精力。有你们协助，解决的概率就…更高了一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010222
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715010222,
					"content": "需要我们做什么吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010223
					]
				},
				{
					"id": 715010223,
					"content": "你听说过「普尔希娜光钉」吗？能够释放扰乱地脉的力量的仪器。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010224
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715010224,
					"content": "按照我的推测，只要在黑泥涌出之处安置「普尔希娜光钉」，扰乱地脉活动，就能够清理掉黑泥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010225
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715010225,
					"content": "可是黑泥和地脉有什么关系啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715010226,
					"content": "因为这些黑泥是随着地脉的变动出现在这里的，有很大概率与地脉有关…这是我和海迪夫一起讨论出来的结果。",
