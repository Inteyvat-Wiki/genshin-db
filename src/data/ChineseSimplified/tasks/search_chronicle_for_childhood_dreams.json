				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"兰吉特"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 737040101,
					"content": "今天也是充满全新希望的一天！两位，我们这就出发？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040102
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 737040102,
					"content": "全新希望…这么说来，和古岩龙蜥的交流算是失败了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737040103,
					"content": "怎么能说是失败呢，搏斗也算是一种交流。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040104
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 737040104,
					"content": "从这个角度来说，我们算是进行了坦率且深入的交流，并且在此过程中充分了解了对方的立场。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040105
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 737040105,
					"content": "那话怎么说的来着，「不打不相识」嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040106,
						737040108
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 737040106,
					"content": "早料到会这样了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737040107
					]
				},
				{
					"id": 737040107,
					"content": "但我还是要说，凡事总得试试！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040110
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 737040110,
					"content": "所以你还不打算放弃吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737040111,
					"content": "实不相瞒，我小时候的梦想之一就是骑着翠翎恐蕈游遍须弥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040112
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 737040112,
					"content": "但是当时大人们只会跟我说别傻了，去问巡林官，他们也是面露难色，让我不要冒险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040113
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 737040113,
					"content": "于是我就放弃了不切实际的梦想，和其他孩子一样普通地长大了，唯一的小小冒险也只是在食材的选择上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040114
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 737040114,
					"content": "偶尔想起来，原来自己儿时还有过这样的梦想，有种遥远又陌生的感觉，就像传说中的兰那罗一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040115
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 737040115,
					"content": "如果他们真的存在，我也曾经见过他们，那我是从何时起不再能看到他们，也不再记得他们的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040116
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 737040116,
					"content": "在纳塔的时候我听说了一个故事，讲的是一个叫昆图尔的倒霉家伙，因为父亲犯的过错，甚至被太阳厌弃了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040117
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 737040117,
					"content": "「不受太阳喜爱的昆图尔」在部族里也不受待见，当然也没有龙愿意当他的伙伴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040118
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 737040118,
					"content": "但他没有气馁，没有埋怨父亲，也没有埋怨命运，而是用努力证明了自己并不输给一族里最强悍的战士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040119
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 737040119,
					"content": "最后，他凭借勇气和智慧做了一件了不起的事，不仅获得了暝视龙伙伴的认可，也成了一族的英雄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040120
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 737040120,
					"content": "听了他的故事之后，我也有了勇气重拾儿时的梦想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040121
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 737040121,
					"content": "还有这样的理由啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737040122,
					"content": "所以跟翠翎恐蕈正面「交涉」的事就拜托两位了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040123
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 737040123,
					"content": "结果还是要交给我们啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737040124,
					"content": "以我现在的实力，实在不是翠翎恐蕈的对手…但我会做好辅助工作的，有需要随时叫我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040125
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 737040125,
					"content": "话不多说，咱们这就走吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040126,
						737040127
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 737040126,
					"content": "走吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 737040127,
					"content": "还有别的事，稍候。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737040128
					]
				},
				{
					"id": 737040128,
					"content": "没问题，我就在这儿等你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 737040108,
					"content": "在搏斗的根本就是我。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737040109
					]
				},
				{
					"id": 737040109,
					"content": "不愧是正牌的冒险家，哪怕是我也看得出来，搏斗的经验相当丰富！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040110
					],
					"speakerTitle": "兰吉特"
				}
			]
		}
	]
}