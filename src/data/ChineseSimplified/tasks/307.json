			"dialogs": [
				{
					"id": 3071101,
					"content": "你来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071102
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 3071102,
					"content": "喏，靠近点。闻到了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071103,
						3071104
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 3071103,
					"content": "…没闻到。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3071105
					]
				},
				{
					"id": 3071105,
					"content": "这个<color=#00E1FFFF>神庙</color>里发生了一些事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071106
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 3071106,
					"content": "史莱姆、丘丘人…还有…风魔龙留下的魔力联结。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071107
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 3071107,
					"content": "哈哈，里面肯定很热闹吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071108,
						3071110
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 3071108,
					"content": "会很危险吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3071109
					]
				},
				{
					"id": 3071109,
					"content": "嗯…热闹归热闹，却并不危险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071112
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 3071112,
					"content": "真遗憾啊，「北风之狼」的庙宇，如今竟被这样打扰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071113
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 3071113,
					"content": "#我们走吧，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOY|INFO_FEMALE_PRONOUN_GIRL]}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071114
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 3071114,
					"content": "虽然「四风守护」已经不再有人祭祀，但古老的风不会消散…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071115
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 3071115,
					"content": "现在，要去帮「四风守护」清理一下环境咯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凯亚"
				},
				{
					"id": 3071110,
					"content": "只是乌合之众罢了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3071111
					]
				},
				{
					"id": 3071111,
					"content": "喔！很有气魄的发言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071112
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 3071104,
					"content": "是火史莱姆烧焦的味道。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3071105
					]
				}
			]
		},
