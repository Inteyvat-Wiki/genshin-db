			"dialogs": [
				{
					"id": 3071501,
					"content": "哦！真是精彩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071502
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 3071502,
					"content": "原来阁下是一位训练有素的战士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071503
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 3071503,
					"content": "刚才在庙宇里，一路上的那些战斗，实在令人大开眼界。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071504,
						3071505
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 3071504,
					"content": "您过奖了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3071506
					]
				},
				{
					"id": 3071506,
					"content": "哈哈哈。连骑士般的「谦虚」品德也已经具备了啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071507
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 3071507,
					"content": "阁下拯救蒙德的英姿，未来一定会传遍整座自由之城。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071508
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 3071508,
					"content": "今后有空的话，还请到骑士团总部来聊聊天吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071509
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 3071509,
					"content": "嗯…或者，我也知道一家不错的酒馆哦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凯亚"
				},
				{
					"id": 3071505,
