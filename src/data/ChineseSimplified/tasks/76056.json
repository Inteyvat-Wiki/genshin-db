			},
			"dialogs": [
				{
					"id": 760560601,
					"content": "竟然真的输给了一个过路人…三次！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560602
					],
					"speakerTitle": "英凯莉"
				},
				{
					"id": 760560602,
					"content": "不不，你我各输了两次，老大只输了一次而已，还好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560603
					],
					"speakerTitle": "彼伊列"
				},
				{
					"id": 760560603,
					"content": "#嗨！输了就是输了，多想也没用！{NICKNAME}真的很强嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560604
					],
					"speakerTitle": "特尔霍"
				},
				{
					"id": 760560604,
					"content": "你们两个平时连我也打不过，现在见识到真正的强者了吧？你们还要多训练才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560605
					],
					"speakerTitle": "特尔霍"
				},
				{
					"id": 760560605,
					"content": "至于我嘛！看来得考虑早点儿退休了，不知道瓦伊诺的训练场还招不招人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "特尔霍"
				}
			]
		},
