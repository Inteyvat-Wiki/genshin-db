			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"特尔霍"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760560501,
					"content": "我、我竟然输了…被一个随随便便的路人打败了…这，怎么可能？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560502
					],
					"speakerTitle": "英凯莉"
				},
				{
					"id": 760560502,
					"content": "唔，竟然赢过了英凯莉…是我太轻敌了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560503
					],
					"speakerTitle": "特尔霍"
				},
				{
					"id": 760560503,
					"content": "不是老大的错，毕竟谁能想到会有这么强大的对手恰巧路过这里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560504
					],
					"speakerTitle": "彼伊列"
				},
				{
					"id": 760560504,
					"content": "老大！不能放他们走…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560505
					],
					"speakerTitle": "英凯莉"
				},
				{
					"id": 760560505,
					"content": "哦？难道不只是想切磋而已？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760560506
					]
				},
				{
					"id": 760560506,
					"content": "别误会，英凯莉的意思是不能就这样认输罢了。我们毕竟也算是有点儿脸面的宝藏猎人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560507
					],
					"speakerTitle": "特尔霍"
				},
				{
					"id": 760560507,
					"content": "#{NICKNAME}，我郑重地向你发出正式挑战。这一次可就不是过招了，我们拿出真本事来打一场怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560508
					],
					"speakerTitle": "特尔霍"
				},
				{
					"id": 760560508,
					"content": "那就请三位一起上吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760560509
					]
				},
				{
					"id": 760560509,
					"content": "好，那我们可就不客气了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "特尔霍"
				}
			]
		},
		{
			"id": 7605606,
