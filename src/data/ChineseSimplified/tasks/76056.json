			"dialogs": [
				{
					"id": 760560101,
					"content": "哟，这位朋友！来训练场光是打靶子的话，会不会觉得不是很过瘾？你看起来身手不错，要不要来跟我们过两招？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "特尔霍"
