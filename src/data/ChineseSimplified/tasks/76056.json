			"completionStepIds": [
				7605601
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7605601",
							"2"
						],
						"stepId": 7605601,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"7605601",
							"0"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"特尔霍"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760560201,
					"content": "不要说两招，三招也没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760560202
					]
				},
				{
					"id": 760560202,
					"content": "哈哈，爽快！果然还是人与人的较量才有意思对吧！彼伊列，要不就你先来和这位朋友过三招？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560205
					],
					"speakerTitle": "特尔霍"
				},
				{
					"id": 760560205,
					"content": "好的老大！三招之内一定拿下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "彼伊列"
				}
			]
		},
		{
			"id": 7605603,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
