			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"特尔霍"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760560401,
					"content": "对不起老大…我给大家丢脸了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560402
					],
					"speakerTitle": "彼伊列"
				},
				{
					"id": 760560402,
					"content": "嗨，本来就是打发时间，输了也没关系。彼伊列，你先边上休息一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560403
					],
					"speakerTitle": "特尔霍"
				},
				{
					"id": 760560403,
					"content": "这位朋友，你的身手很矫健嘛！我的名字叫特尔霍，幸会！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560404
					],
					"speakerTitle": "特尔霍"
				},
				{
					"id": 760560404,
					"content": "#我是{NICKNAME}，幸会！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760560405
					]
				},
				{
					"id": 760560405,
					"content": "你看上去是有不少实战经验的高手，那我们可得认真一些了。刚才那次不算，再比试一次！英凯莉，轮到你了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560406
					],
					"speakerTitle": "特尔霍"
				},
				{
					"id": 760560406,
					"content": "老大每次都是遇到麻烦才想起我…真是没办法。那么，这位高手，我们开始吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "英凯莉"
				}
			]
		},
		{
			"id": 7605605,
			"completionStepIds": [
				7605603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
