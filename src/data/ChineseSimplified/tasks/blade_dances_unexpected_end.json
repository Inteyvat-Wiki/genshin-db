			"dialogs": [
				{
					"id": 746780101,
					"content": "私斗私斗！抓起来抓起来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780102
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 746780102,
					"content": "发现危险的秘境后，不赶紧报告给执律庭，而是擅自进行调查并使用武力…你这家伙好狂啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780103
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 746780103,
					"content": "大大大大人！我一不在枫丹廷，二打的是魔物，这也要被抓吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780104
					],
					"speakerTitle": "科斯唐坦"
				},
				{
					"id": 746780104,
					"content": "那你是冒险家协会的注册成员吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780105
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 746780105,
					"content": "不是…我体能不过关，没通过测试…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780106
					],
					"speakerTitle": "科斯唐坦"
				},
				{
					"id": 746780106,
					"content": "那你有提前向执律庭报备，需要在枫丹境内使用武器吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780107
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 746780107,
					"content": "还有这事？原来使用武器还要报备的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780108
					],
					"speakerTitle": "科斯唐坦"
				},
				{
					"id": 746780108,
					"content": "肯定啊！不然，随便什么人都能在枫丹打架的话，执律庭不就成了摆设吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780109
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 746780109,
					"content": "没有报备信息，小心警卫机关把你这种喜欢拿着武器瞎比划的家伙当成入侵者！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780110
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 746780110,
					"content": "你看看你，简直就像个假枫丹人，被抓不冤吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780111
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 746780111,
					"content": "失算了失算了！身为作家，取材不到位，忽略了重要的基本设定…我真是失职！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780112,
						746780113
					],
					"speakerTitle": "科斯唐坦"
				},
				{
					"id": 746780112,
					"content": "我们经常随意调查秘境吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746780114
					]
				},
				{
					"id": 746780114,
					"content": "不过，我们两个早就成为冒险家了，应该没什么问题？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746780115,
					"content": "哦？你们两位来了啊，大名人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780116
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 746780116,
					"content": "咳咳，我是昂吉安妮，常年在野外值岗的老牌警备队员。不久前，我在附近巡逻的时候，发现了这个冒失的家伙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780117
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 746780117,
					"content": "他向我交待了他在这里鬼混的前因后果，介绍了这个奇怪的秘境，还说你们两位也参与了这场「剑舞」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780118
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 746780118,
					"content": "噫！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780119,
						746780120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746780119,
					"content": "我们在秘境里玩得还挺开心的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746780121
					]
				},
				{
					"id": 746780121,
					"content": "那当然不可能了，相反，你们是见义勇为的优秀冒险家，我还要给你们一笔奖金！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780122
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 746780122,
					"content": "这次我们针对的只是「未经报备就随意使用武力」这一件事，把这家伙抓回去以后，也只是对他进行口头教育。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780123
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 746780123,
					"content": "他也没犯什么原则性的大错，当然不可能被重重惩罚了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780124
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 746780124,
					"content": "就算要缴纳罚金，我可能也拿不出几个摩拉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780125
					],
					"speakerTitle": "科斯唐坦"
				},
				{
					"id": 746780125,
					"content": "还好还好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746780126,
					"content": "科斯唐坦虽然说话很夸张，但肯定不是什么坏人…他只是沉迷于华丽战斗的表现，想要写好小说而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746780127,
					"content": "听到没，两位大名人都在给你说情了…下次别再犯这种错了，冒失的好人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780128
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 746780128,
					"content": "下次我一定会做好足够的前期铺垫，再来实地取材！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780129
					],
					"speakerTitle": "科斯唐坦"
				},
				{
					"id": 746780129,
					"content": "那我就按章办事了，先带他回执律庭，好好教育他一番。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780130
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 746780130,
					"content": "再过一段时间，其他警备队员就会赶过来，控制住这座秘境…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780131
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 746780131,
					"content": "不过，有你们两位在，这座秘境倒也构不成什么威胁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780132
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 746780132,
					"content": "如果你们还有兴趣，继续在里面战斗一番，击败更多魔物…也能让之后的警备队员少忙活点，算是帮大忙了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780133
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 746780133,
					"content": "结果我们不知不觉就成了见义勇为的好人，拿到了剑舞作家和执律庭的双份奖励…也没算是白折腾吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746780120,
					"content": "你要把我们两个也一起抓走吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746780121
					]
				},
				{
					"id": 746780113,
					"content": "我们好像也没有报备来着？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746780114
					]
				}
			]
		}
	]
}