			},
			"dialogs": [
				{
					"id": 250290201,
					"content": "乖乖喔，今天吃饱了吗？有没有力气训练呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290202
					],
					"speakerTitle": "特拉忒"
				},
				{
					"id": 250290202,
					"content": "呜，呜呜，呜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290203
					],
					"speakerTitle": "奇卡"
				},
				{
					"id": 250290203,
					"content": "呜哇，这么有活力？好！那今天可要加把劲了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290204
					],
					"speakerTitle": "特拉忒"
				},
				{
					"id": 250290204,
					"content": "一起加把劲吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290206
					]
				},
				{
					"id": 250290206,
					"content": "#欸？您好呀，{M#大哥哥}{F#大姐姐}！我们正在进行爬山训练呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290207
					],
					"speakerTitle": "特拉忒"
				},
				{
					"id": 250290207,
					"content": "呜呜！呜呜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290208
					],
					"speakerTitle": "奇卡"
				},
