				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"柯莱"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30170401,
					"content": "欸，旅行者，还有派蒙？你们怎么会回来这里？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170402
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30170402,
					"content": "柯莱！又见面了，你还好吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170403,
					"content": "我…坦诚地讲，不是很好。最近我身上的魔鳞病有加速恶化的趋势，很多细碎的工作也都变得难以完成了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170404
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30170404,
					"content": "所以提纳里师父取消了我的各类巡林任务，只允许我留在这里协助组织工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170405
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30170405,
					"content": "这样啊…柯莱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170406,
					"content": "看来只有根治世界树才能…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170407
					]
				},
				{
					"id": 30170407,
					"content": "话说提纳里呢，是外出巡林了吗？我们是来找他的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170408,
					"content": "提纳里师父吗，他最近刚刚离开了道成林，到禅那园去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170409
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30170409,
					"content": "啊？提纳里走了？可是…可是过去提纳里不是一直不愿离开道成林，连贤者的邀请都拒绝了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170410,
					"content": "我也觉得奇怪…提纳里师父他一直很看重巡林官的工作，不会轻易离开，可这次却匆匆忙忙地走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170411
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30170411,
					"content": "他没说去干什么了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170412,
					"content": "没有，就连他要走的消息都是留下字条通知我的，各种事务也通过排班表安排好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170413
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30170413,
					"content": "走得这么匆忙，估计是有什么需要争分夺秒的事情吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170414
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30170414,
					"content": "你刚才说提纳里去的是禅那园，那是什么地方呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170415,
					"content": "提纳里师父之前在教令院的生论派进修，而禅那园则类似于生论派的研究基地，种植了各种稀有植被以供研究。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170416
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30170416,
					"content": "我知道提纳里师父在成为巡林官以前，曾经有很长一段时间在禅那园专心钻研学术。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170417
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30170417,
					"content": "研究基地吗…提纳里到底突发奇想要搞什么研究呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170418
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170418,
					"content": "#{NICKNAME}，时间紧迫，那我们就去一趟那个禅那园找他吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170419,
						30170420
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170419,
					"content": "保重身体，柯莱。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170421
					]
				},
				{
					"id": 30170421,
					"content": "啊…嗯，我没关系，与魔鳞病共生我已经再习惯不过了。见到提纳里师父的话，请代我向他问候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170422
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30170422,
					"content": "好的~我们记住了，再见柯莱~！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170420,
					"content": "别太勉强自己，柯莱。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170421
					]
				}
			]
		},
		{
			"id": 301705,
			"completionStepIds": [
				301705
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"301705",
