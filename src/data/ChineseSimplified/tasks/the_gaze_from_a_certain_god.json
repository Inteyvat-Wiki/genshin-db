						30170618
					]
				},
				{
					"id": 30170604,
					"content": "想不到会在这里见到你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170605
					]
				}
			]
		},
		{
			"id": 301707,
			"completionStepIds": [
				301707
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"301707",
							"2"
						],
						"stepId": 301707,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"提纳里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30170701,
					"content": "…好像到这里就没有人追过来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170702,
						30170703
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170702,
					"content": "！！！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170704
					]
				},
				{
					"id": 30170704,
					"content": "#你还好吗，纳西妲…欸，不对！这种感觉是，{NICKNAME}你回来了吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170705
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170705,
					"content": "#嗯？现在又是{NICKNAME}本人了么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170706,
						30170707
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30170706,
					"content": "是我…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170708
					]
				},
				{
					"id": 30170708,
					"content": "之前一直是纳西妲在操控你的身体，似乎是凯瑟琳人偶被破坏之前，她将意识紧急转移到了你的身上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170709
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170709,
					"content": "然后…提纳里听到声音赶了过来，帮忙一起击败了那些佣兵，随后我们便一路逃到了这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170710,
						30170711
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170710,
					"content": "这次不仅仅是「意识转移」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170712
					]
				},
				{
					"id": 30170712,
					"content": "啊？「互换」？难道说，你的意识也去了纳西妲的体内？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170713
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170713,
					"content": "那么，纳西妲的意识呢？她现在又到哪里去了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170714
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170714,
					"content": "意识居然可以这样随意转移，若非亲眼所见，简直难以置信…这应该还不是人类能够做到的范畴吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170715
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30170715,
					"content": "#对了，{NICKNAME}，刚才逃走的路上，你体内的那个意识拜托我传话给你，她说——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170716
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30170716,
					"content": "「『博士』已经找到了禁锢意识的方法，我无法与你同行了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170717
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30170717,
					"content": "「但即便是没有『月亮』的夜晚，一众『星光』亦足以刺破『虚幻』与『谎言』。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170718
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30170718,
					"content": "啊啊——可恶，这下子纳西妲真的彻底被禁锢在「净善宫」了啊，糟糕了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170719
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170719,
					"content": "她留下的话就只有这些了吗？好像有点不明不白的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170720,
						30170721
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170720,
					"content": "这是我们之间才懂的「暗语」吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170722
					]
				},
				{
					"id": 30170722,
					"content": "啊，我懂了，「博士」已经捕捉到了纳西妲的意识，所以纳西妲说了什么都会被他知道吧，很谨慎呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170723
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170723,
					"content": "「即便是没有『月亮』的夜晚，一众『星光』亦足以刺破『虚幻』与『谎言』。」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170724
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170724,
					"content": "我知道「月亮」、「虚幻」与「谎言」都源自花神诞祭时候的炼金占卜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170725
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170725,
					"content": "「星光」好像也是纳西妲用过的比喻？好像是跟塞塔蕾有关的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170726,
						30170727,
						30170728
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170726,
					"content": "「月亮」比喻她自己。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170729
					]
				},
				{
					"id": 30170729,
					"content": "哦哦！这么说确实是这样，看来纳西妲的意思是，要让我们去沙漠寻求帮助吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170730
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170730,
					"content": "可是没有纳西妲在了，我们真的没问题吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170731
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170731,
					"content": "#派蒙刚刚提到了「净善宫」？你们口中的纳西妲，也就是之前{NICKNAME}体内的意识…莫非是草神大人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170732
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30170732,
					"content": "呃…你的猜测是正确的，情况有些复杂，我们现在很难和你解释…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170733
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170733,
					"content": "没关系，学者的好奇也不是完全不讲求时宜的，至于情况的复杂程度，我刚才也看在眼里了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170734
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30170734,
					"content": "我和你们相处过一段时间，而且看起来小草神大人也站在你们一边，所以…我相信你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170735
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30170735,
					"content": "嗯！谢谢你，提纳里。对了，我们之前就想找你问，你对贤者们正在进行的「工程」有什么了解么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170736
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170736,
					"content": "这个嘛…我的确曾受邀去参加那项工程，但贤者们对工程的内容一直三缄其口，后来我便推脱掉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170737
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30170737,
					"content": "我只知道，那项工程应该事关「世界树的修复」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170738,
						30170739
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30170738,
					"content": "我大概知道工程的内容了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170740
					]
				},
				{
					"id": 30170740,
					"content": "欸？是和纳西妲互换意识的时候见到了什么吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170741
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170741,
					"content": "教令院…在帮助散兵「成神」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170742
					]
				},
				{
					"id": 30170742,
					"content": "什么！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170743
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170743,
					"content": "…依据呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170744,
						30170745
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30170744,
					"content": "我见到建造中的「神的半成品」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170746
					]
				},
				{
					"id": 30170746,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170747
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30170747,
					"content": "你描述了与纳西妲互换意识的时候，你的所见…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						30170748
					]
				},
				{
					"id": 30170748,
					"content": "是吗，原来如此…怪不得海芭夏的症状与之前那些疯掉的学者有所不同，原来是接触了一个正在诞生中的新神的意识…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170749
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30170749,
					"content": "提纳里是因为海芭夏才离开道成林的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170750
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170750,
					"content": "是的，我留意到了海芭夏的精神失常，但症状又比较特殊，所以我偷偷带她来到禅那园，寻找能让她恢复的方法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170751
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30170751,
					"content": "如果不这样做，海芭夏现在恐怕已经被风纪官们流放到沙漠中的阿如村了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170752
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30170752,
					"content": "话说回来，我原本也知道教令院一直轻视小吉祥草王…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170753
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30170753,
					"content": "可的确没想到，他们会做出「创造新神」这般傲慢自大的事，没有接受他们的邀请果然是正确的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170754,
						30170755
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30170754,
					"content": "这其中也有愚人众在作祟。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170756
					]
				},
				{
					"id": 30170756,
					"content": "「博士」和「散兵」…两个愚人众的执行官都在须弥吗…听起来前途堪忧呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170757
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30170757,
					"content": "不过至少从你的描述上看，「工程」还没有彻底完工，应该还有阻止他们的余地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170758
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30170758,
					"content": "可说起来，「创造新神」与「修复世界树」之间又有什么关系呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170759
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30170759,
					"content": "是呀，感觉贤者方的目的我们至今还摸不清楚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170760,
						30170761
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170760,
					"content": "先到沙漠去吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170762
					]
				},
				{
					"id": 30170762,
					"content": "嗯，现有的情报也整理得差不多了，还是先动身吧…提纳里呢，你准备怎么做？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170763
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170763,
					"content": "我还是打算先留在这里，海芭夏那边的情况我还想要再努力一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170764
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30170764,
					"content": "去沙漠的话，你们可以先到喀万驿，这是通往沙漠地带最便捷的路线。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170765
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30170765,
					"content": "如果还有什么我能帮上忙的，请再来这里找我，愿智慧追随你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170766
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30170766,
					"content": "好的，也希望海芭夏能够好起来，那就再见啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170761,
					"content": "不论如何也要阻止他们。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170762
					]
				},
				{
					"id": 30170755,
					"content": "他们可能受到了愚人众的鼓动。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170756
					]
				},
				{
					"id": 30170745,
					"content": "海芭夏所展示的「神明意识」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170746
					]
				},
				{
					"id": 30170739,
					"content": "我刚刚获得了新的情报。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170740
					]
				},
				{
					"id": 30170727,
					"content": "「星光」比喻沙漠子民。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170729
					]
				},
				{
					"id": 30170728,
					"content": "「虚幻与谎言」指教令院的计划。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170729
					]
				},
				{
					"id": 30170721,
					"content": "不能让「博士」知道下一步行动。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170722
					]
				},
				{
					"id": 30170711,
					"content": "而是「意识互换」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170712
					]
				},
				{
					"id": 30170707,
					"content": "刚才发生了什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170708
					]
				},
				{
					"id": 30170703,
					"content": "（大口喘气）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170704
					]
				}
			]
		},
		{
			"id": 301708,
