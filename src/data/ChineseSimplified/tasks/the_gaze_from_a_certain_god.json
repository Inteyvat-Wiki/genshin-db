			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"纳西妲",
					"纳西妲"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30170501,
					"content": "等等，那边的是！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170502,
						30170503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170502,
					"content": "纳西妲！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170504
					]
				},
				{
					"id": 30170504,
					"content": "你果然没事，真是太好了！我们好担心你的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170505,
						30170506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170505,
					"content": "是纳西妲的意识吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170507
					]
				},
				{
					"id": 30170507,
					"content": "#喂，{NICKNAME}，明明是这么感动的再会，气氛都要被你给毁了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170508,
					"content": "派蒙，旅行者提防现在的我是非常明智的，毕竟「博士」展现出过类似操控人们意识的技术…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170509
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30170509,
					"content": "分别之后，我独自面对「博士」时发生了什么，你们也无从获知。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170510
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30170510,
					"content": "就像一场灾难般的暴雨过后，地上的积水有时也能伪装成天空一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170511
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30170511,
					"content": "嗯…我觉得能讲出这么微妙的比喻的人，只能是真的纳西妲了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170512,
						30170513
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170512,
					"content": "我也这么觉得。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170514
					]
				},
				{
					"id": 30170514,
					"content": "欸？我刚才不是想博取信任，只是想要讲得更好理解…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170515
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30170515,
					"content": "好啦好啦，我们知道啦。纳西妲快说说，我们离开之后发生了什么吧？那些民众怎么样了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170516
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170516,
					"content": "你们离开的时候我正在全力修复所有民众的意识，好在「博士」所说的「将信息投放到潜意识」并非是刻写进大脑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170517
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30170517,
					"content": "…而是类似在民众的脑海制造幻觉，以我当下的能力尚能将其解决。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170518
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30170518,
					"content": "所幸在他即将把我控制住的一刹那，我完成了民众意识的修复工作，并使用了意识跳转成功逃离。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170519
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30170519,
					"content": "还好还好，「博士」这一招的确很出其不意，还好有纳西妲在…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170520
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170520,
					"content": "倒也没有那么好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170521
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30170521,
					"content": "在修复民众意识的过程中，「博士」已经看出我的真实身份了，我们的底牌又少了一张。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170522
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30170522,
					"content": "而且…他既然有能力对虚空终端进行改造，或许「捕获」我的意识也只是时间问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170523
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30170523,
					"content": "是说让你没法再这样自由跳转意识了吗，那可怎么办…他现在在教令院，的确有可能继续对虚空动手脚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170524,
						30170525
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170524,
					"content": "我们要抓紧时间了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170526
					]
				},
				{
					"id": 30170526,
					"content": "可恶…有种被玩弄一样的感觉，真是难缠的对手…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170527
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170527,
					"content": "而且据说「博士」好像单凭武力也完全能够坐稳「第二席」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170528
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170528,
					"content": "还不是灰心丧气的时候，想办法找找突破口吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170529
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30170529,
					"content": "嗯，对了，纳西妲是怎么知道我们要来禅那园的？你是提前等在这里了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170530
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170530,
					"content": "#是的，我能够感知到{NICKNAME}身上的元素力，循着这股力量移动的方向推断出来的。",
