			"trigger": {
				"objectNames": [
					"塔什芬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30170301,
					"content": "的确有些棘手呢，这就是佣兵中的精英吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170302,
					"content": "估计不会只有这一波埋伏。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170303
					]
				},
				{
					"id": 30170303,
					"content": "是啊，看来我们以后也要多多提防了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170304,
					"content": "不过「博士」真的有些可怕，是算准了我们会去找提纳里吗，所以才雇人在这里设下埋伏…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170305,
					"content": "和聪明人作对可真是让人头疼啊，我们继续前进吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 301704,
			"completionStepIds": [
				301704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"301704",
							"2"
						],
						"stepId": 301704,
						"stateName": "QUEST_STATE_UNFINISHED"
