					"塔什芬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30170101,
					"content": "站住。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170102
					],
					"speakerTitle": "塔什芬"
				},
				{
					"id": 30170102,
					"content": "金发旅行者，还有漂浮着的小精灵，看来没错了。看看周围，你们已经中了我们的埋伏了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170103
					],
					"speakerTitle": "塔什芬"
				},
				{
					"id": 30170103,
					"content": "你们！你们是「三十人团」的家伙吗？是来抓我们的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170104,
					"content": "「三十人团」…我们可不是那些给官方打杂，又吃力不讨好的走狗们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170105
					],
					"speakerTitle": "塔什芬"
				},
				{
					"id": 30170105,
					"content": "我们可是在须弥收取最高一档佣金的精英佣兵团，这次是为了完成一位名叫「放逐者」的先生的委托。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170106
					],
					"speakerTitle": "塔什芬"
				},
				{
					"id": 30170106,
					"content": "「放逐者」…教令院的放逐者？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170107,
					"content": "看来是「博士」了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170108
					]
				},
				{
					"id": 30170108,
					"content": "可是「博士」为什么不直接派愚人众来抓我们呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170109,
						30170110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170109,
					"content": "本地的佣兵团更有优势。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170111
					]
				},
				{
					"id": 30170111,
					"content": "还有功夫闲聊这些，看起来你们是真的不怕死啊。给我上！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170112
					],
					"speakerTitle": "塔什芬"
				},
				{
					"id": 30170112,
					"content": "#{NICKNAME}，我们…我们上！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170110,
					"content": "他利用了教令院的资源吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170111
					]
				}
			]
		},
		{
			"id": 301703,
			"completionStepIds": [
				301703
			],
