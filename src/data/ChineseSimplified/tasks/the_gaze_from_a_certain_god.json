					"nextDialogs": [
						30170526
					]
				},
				{
					"id": 30170513,
					"content": "我相信你了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170514
					]
				},
				{
					"id": 30170506,
					"content": "没有被「博士」动过手脚吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170507
