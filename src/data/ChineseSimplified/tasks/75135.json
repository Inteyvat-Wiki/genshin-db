			"dialogs": [
				{
					"id": 751350101,
					"content": "那就是源火祭坛了吗…呃，感觉想要过去的话还有点困难。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751350102,
					"content": "#怎么办，我们是能用飞的啦，但是{REALNAME[ID(2)|SHOWHOST(true)]}和玻娜要怎么办啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751350103,
					"content": "派蒙不会是在小看我吧，我可是花羽会的冒险家，飞行经验可是很丰富的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350104
					],
					"speakerTitle": "玻娜"
				},
				{
					"id": 751350104,
					"content": "#就算是带上{REALNAME[ID(2)|SHOWHOST(true)]}，飞到那边也是轻轻松松。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350105
					],
					"speakerTitle": "玻娜"
				},
				{
					"id": 751350105,
					"content": "我也有飞行执照。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751350106
					]
				},
				{
					"id": 751350106,
					"content": "那就好，我会在前面给你们引路，你们只要跟上我就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350107
					],
					"speakerTitle": "玻娜"
				},
				{
					"id": 751350107,
					"content": "接下来是飞行竞速挑战吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751350108
					]
				},
				{
					"id": 751350108,
					"content": "哇，这种时候就不要有这种好胜之心啦，我会在前面给你们引路，你们只要跟上我就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350109
					],
					"speakerTitle": "玻娜"
				},
				{
					"id": 751350109,
					"content": "#总感觉很危险的样子，也不知道会发生什么，{REALNAME[ID(2)|SHOWHOST(true)]}你可要抓紧我们啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751350110,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				}
			]
