			"dialogs": [
				{
					"id": 751350201,
					"content": "哇，玻娜你飞得也太快了，我们差点就要跟不上了啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751350202,
					"content": "嘿嘿，抱歉抱歉，看到源火祭坛在前面，不知不觉就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350203
					],
					"speakerTitle": "玻娜"
				},
				{
					"id": 751350203,
					"content": "只要用这个祭坛就能去到天蛇船了吗？不过就算一会出现了什么超级大的风场把我们吹起来，也不知道要飞多久…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751350204,
					"content": "哇，想想就开始担心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350205,
						751350207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751350205,
					"content": "别害怕，派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751350206
					]
				},
				{
					"id": 751350206,
					"content": "好吧，既然你都这样说了，一会你可不要和我离得太远哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751350209,
					"content": "总之现在是要把火磷石供奉到那个上面，不过我们手上有两枚火磷石，呃…保险起见就把它们一起放上去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玻娜"
				},
				{
					"id": 751350207,
					"content": "哇，好刺激。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751350208
					]
				},
				{
					"id": 751350208,
					"content": "对吧对吧，我也开始兴奋起来了呢，作为冒险家可不能错过这样的挑战！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350209
					],
					"speakerTitle": "玻娜"
				}
			]
		}
