			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"梵米尔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710060101,
					"content": "糟糕了，这还怎么画画…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060102
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710060102,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060103
					]
				},
				{
					"id": 710060103,
					"content": "你…哦，是旅行者啊。是这样，我一直在这个渌华池周围取材，想要画几幅好画带回去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060104
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710060104,
					"content": "但是我一直找不到好角度，所以一直没画出什么满意的画来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060105
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710060105,
					"content": "而且因为我太专心取景，走到这里才发现，我的画笔和颜料都不见了一大半。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060106
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710060106,
					"content": "我想这些东西一定是落在了我之前画画的地方，能请你帮我找找看吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060107,
						710060110
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710060107,
					"content": "你在哪里画过画？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060108
					]
				},
				{
					"id": 710060108,
					"content": "呃，其实…我也记不太清了，因为我每次都太专注于画画，不会怎么留意周围，具体的位置是记不清了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060109
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710060109,
					"content": "不过，我在这周围只画了两幅画，我想应该也只可能在那两个地方了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060113
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710060113,
					"content": "这两幅画给你，我的画材应该就在画这两幅画时的<color=#00E1FFFF>取景位</color>上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060114
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710060114,
					"content": "找到了之后，就拿回来给我吧，我还要在这里再看看…一定有更好的角度…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710060110,
					"content": "可是，去哪里找…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060111
					]
				},
				{
					"id": 710060111,
					"content": "我每次都太专注于画画，不会怎么留意周围，具体的位置是记不清了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060112
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710060112,
					"content": "但我在这周围只画了两幅画，我想应该也只可能在那两个地方了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060113
					],
					"speakerTitle": "梵米尔"
				}
			]
		},
