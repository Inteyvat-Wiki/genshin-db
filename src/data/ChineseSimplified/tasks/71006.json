				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710060601,
					"content": "你找到了画材了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060602
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710060602,
					"content": "找到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060603
					]
				},
				{
					"id": 710060603,
					"content": "果然是我忘在取景的地方了，我每次画画的时候都习惯把用过的东西放在地上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060604
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710060604,
					"content": "有时候走得太急，就会落下很多东西，谢谢你，不然我肯定又要回去城里重新买画材了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060605
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710060605,
					"content": "你还要在这画画吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060606
					]
				},
				{
					"id": 710060606,
					"content": "别提了，我听人家说，这两尊雕像的双眼本来是可以发光的，在很远的地方都能看见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060607
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710060607,
					"content": "双目炯炯的巨像，伫立在山崖旁…这绝对是一幅好画。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060608
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710060608,
					"content": "结果我到这里来了之后，雕像是看见了，但是压根没什么发光的眼睛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060609
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710060609,
					"content": "我以为是我错过了什么特殊的时机，或者角度不对，所以才一直在这里四处取景。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060610
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710060610,
					"content": "但是…唉，无论我怎么取景，都没有一点头绪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060611
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710060611,
					"content": "我唯一的收获，就是从下面的池子里找到了这个东西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060612
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710060612,
					"content": "呃…我也找到了一个…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060613
					]
				},
				{
					"id": 710060613,
					"content": "咦？我看看，还真是，看上去一模一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060614
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710060614,
					"content": "真奇怪，这后面还刻着字呢，连起来读应该是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060615
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710060615,
					"content": "「石官掩柴门，欲入需点睛」…点睛？什么意思…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060616
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710060616,
					"content": "这块石头我拿着也没什么用，就送给你吧，算是你帮我找画材的谢礼了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060617
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710060617,
					"content": "对了，我有个小想法啊，我瞎说的，你觉不觉得，这两块石头像是眼睛？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060618
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710060618,
					"content": "如果真是眼睛的话，那句谜语里说的「点睛」，会不会也和这两块石头有关？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060619
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710060619,
					"content": "哈哈哈，这也就是我瞎说的，你别在意啊。我要接着去取景了，谢谢你帮我找画材。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "梵米尔"
				}
			]
		},
