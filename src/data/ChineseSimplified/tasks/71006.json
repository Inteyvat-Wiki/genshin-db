			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"梵米尔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710060201,
					"content": "你找到了画材了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060202
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710060202,
					"content": "找到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060203
					]
				},
				{
					"id": 710060203,
					"content": "果然是我忘在取景的地方了，我每次画画的时候都习惯把用过的东西放在地上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060204
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710060204,
					"content": "有时候走得太急，就会落下很多东西，谢谢你，不然我肯定又要回去城里重新买画材了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060205
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710060205,
					"content": "你还要在这画画吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060206
					]
				},
				{
					"id": 710060206,
					"content": "别提了，我听人家说，这两尊雕像的眼睛本来是可以发光的，在很远的地方都能看见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060207
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710060207,
					"content": "目光炯炯的巨像，伫立在山崖旁…这绝对是一幅好画。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060208
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710060208,
					"content": "结果我到这里来了之后，雕像是看见了，但是压根没什么发光的眼睛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060209
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710060209,
					"content": "我以为是我错过了什么特殊的时机，或者角度不对，所以才一直在这里四处取景。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060210
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710060210,
					"content": "但是…唉，无论我怎么取景，都没有一点头绪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060211
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710060211,
					"content": "我唯一的收获，就是从下面的池子里找到了这个东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060212
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710060212,
					"content": "虽然弄不懂是做什么的，但我越看这块石头，就越觉得像是眼睛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060213
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710060213,
					"content": "不过如果真是眼睛的话，说不定还有一块类似的石头，毕竟，人是有两只眼睛的嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060214
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710060214,
					"content": "哎呀，这也就是我瞎想的，你别在意。这块石头我拿着也没什么用，就送给你吧，就算是你帮我找画材的谢礼了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060215
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710060215,
					"content": "唉，眼睛会发光的雕像…这片渌华池里，到底会有什么秘密呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "梵米尔"
				}
			]
		},
