			"dialogs": [
				{
					"id": 705100401,
					"content": "哎呀呀…这几天，酒馆里的人可以说是络绎不绝啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100402
					],
					"speakerTitle": "卢卡"
				},
				{
					"id": 705100402,
					"content": "有冲着酒来的，更多的还是冲着你来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100403
					],
					"speakerTitle": "卢卡"
				},
				{
					"id": 705100403,
					"content": "这话…听着怎么那么奇怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705100404,
					"content": "我还没见过那么成功的「酒保体验周」活动，这下生意和口碑都有了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100405
					],
					"speakerTitle": "卢卡"
				},
				{
					"id": 705100405,
					"content": "总之…干得漂亮，伙计。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100406
					],
					"speakerTitle": "卢卡"
				},
				{
					"id": 705100406,
					"content": "才几天，怎么就变成伙计了啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100407,
						705100408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705100407,
					"content": "某种意义上…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705100409
					]
				},
				{
					"id": 705100409,
					"content": "我说，要不要留下来接着干？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100410
					],
					"speakerTitle": "卢卡"
				},
				{
					"id": 705100410,
					"content": "#这可不行。虽然无限畅饮的诱惑力很大，但我可是答应过，要陪{M#他}{F#她}一直旅行下去的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705100411,
					"content": "好吧，那就不勉强啦，毕竟查尔斯也跟我说过这一点…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100412
					],
					"speakerTitle": "卢卡"
				},
				{
					"id": 705100412,
					"content": "总之，有机会的话，常来「天使的馈赠」坐坐，带上朋友一起！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100413
					],
					"speakerTitle": "卢卡"
				},
				{
					"id": 705100413,
					"content": "没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705100414
					]
				},
				{
					"id": 705100414,
					"content": "再见啦，祝你们一路顺利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卢卡"
				},
				{
					"id": 705100408,
					"content": "他也没说错…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705100409
					]
				}
			]
		}
	]
