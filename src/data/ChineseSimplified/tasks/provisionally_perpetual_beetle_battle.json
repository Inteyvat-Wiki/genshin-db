			},
			"dialogs": [
				{
					"id": 716666001,
					"content": "哟！各位好呀，最近玩得还开心吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716666002
					],
					"speakerTitle": "「超级强者的随行厨神」"
				},
				{
					"id": 716666002,
					"content": "香菱，锅巴！你们终于来了！放牛{RUBY#[D]「真剑斗虫大鬼王」}的现在可正在劲头上呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716666003
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716666003,
					"content": "总算等到这一天了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716666004
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 716666004,
					"content": "锅巴兄！就让你见识一下，经历了「荒泷甲光烈烈大修行」后，本大爷…哦不，是我和「赤红一杵」的实力！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716666005
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 716666005,
					"content": "然后，就要麻烦你教教我了——如何跟「赤红一杵」，还有「水晶岛梆梆旋风」这些甲壳生物交流！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716666006
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 716666006,
					"content": "等到我成为了斗虫界最有名望的强者，我就要…在荒泷派的鬼兜虫本阵，为你打造一座特大特威风的雕像！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716666007
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 716666007,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716666008
					],
					"speakerTitle": "「天崩石裂超级强者」"
				},
				{
					"id": 716666008,
					"content": "什么！这就是是锅巴兄自备的鬼兜虫吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716666009
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 716666009,
					"content": "质感看起来很不一般！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716666010
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716666010,
					"content": "不像是正常鬼兜虫的甲壳，而是某种坚韧的木质材料，难道它穿上了装甲？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716666011
					],
					"speakerTitle": "「花角玉将」"
				},
				{
					"id": 716666011,
					"content": "姥姥听说了「荒泷甲光烈烈斗虫大修行」的前因后果，觉得「锅巴可能收徒」这件事很有意思…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716666012
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 716666012,
					"content": "正好，有位朋友给她制作了许多园艺机关，用来打理花坛里的霓裳花，名为「花羽叶月神机」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716666013
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 716666013,
					"content": "「花羽叶月神机」可以化形为各种动物，自然地融入环境。松鼠、蝴蝶、团雀都不在话下，当然也包括鬼兜虫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716666014
					],
					"speakerTitle": "「超级强者的随行厨神」"
				},
				{
					"id": 716666014,
					"content": "所以，师父给了锅巴一个「花羽叶月神机」，让它化形为鬼兜虫的模样，且来与你一战。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716666015
					],
					"speakerTitle": "「超级强者的随行厨神」"
				},
				{
					"id": 716666015,
					"content": "真的只是园艺机关而已吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716666016
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716666016,
					"content": "香菱的师父是萍姥姥…萍姥姥的朋友…萍姥姥的朋友！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716666017,
						716666018
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716666017,
					"content": "是谁来着？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716666019
					]
				},
				{
					"id": 716666019,
					"content": "机关怎么可能模拟鬼兜虫的特点嘛！难道锅巴兄是想试探我们的实力，所以故意用了很弱的家伙来对阵？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716666020
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 716666020,
					"content": "还是小心为妙，鬼王，我好像感知不到那只机关鬼兜虫的气息…或者说，深不见底。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716666021
					],
					"speakerTitle": "「花角玉将」"
				},
				{
					"id": 716666021,
					"content": "机关又不是活的，你感觉不到气势很正常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716666022
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 716666022,
					"content": "呃咳，虽说锅巴兄的确强得没边，但强者也需要趁手的武器和默契的伙伴。我和「赤红一杵」的组合可不是吃素的哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716666023
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 716666023,
					"content": "开始对决吧，我会用接下来的一招一式，向锅巴兄好好证明我们的实力！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716666024
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 716666024,
					"content": "♪——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「天崩石裂超级强者」"
				},
				{
					"id": 716666018,
					"content": "先别剧透…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716666019
					]
				}
