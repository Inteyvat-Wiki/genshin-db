			"dialogs": [
				{
					"id": 715280101,
					"content": "呜啊！放牛{RUBY#[D]「真剑斗虫大鬼王」}的居然这么顺利地打赢了「花羽叶月神机」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715280102,
					"content": "成功了！赢了！我和「赤红一杵」胜过了锅巴{RUBY#[D]「天崩石裂超级强者」}兄！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280103
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 715280103,
					"content": "接下来…嗯，咳咳！我要等不及了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280104
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 715280104,
					"content": "希望锅巴兄能肯定我的实力，要教教我，怎么和甲壳生物交流…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280105
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 715280105,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280106
					],
					"speakerTitle": "锅巴"
				},
				{
					"id": 715280106,
					"content": "嗯？明明被我小胜一局，锅巴兄怎么好像更高兴了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280107
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 715280107,
					"content": "难道说…是为我突飞猛进的实力而惊喜吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280108
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 715280108,
					"content": "这怎么好意思呢！哈哈哈哈哈哈不用这么夸我的锅巴兄！都是锅巴兄太谦虚，使用了普普通通的机关…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280109
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 715280109,
					"content": "看样子，锅巴觉得热身结束了，可以启用这台「花羽叶月神机」的最大力道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280110
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 715280110,
					"content": "锅巴，我们就按照之前约定好的，把园艺机关的出力从千分之一调整到百分之一吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280111
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 715280111,
					"content": "再大的话，可能会把一斗先生的鬼兜虫直接打晕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280112
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 715280112,
					"content": "♪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280113
					],
					"speakerTitle": "锅巴"
				},
				{
					"id": 715280113,
					"content": "果然，我一点也不意外呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280114,
						715280115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715280114,
					"content": "哎呀！千分之一！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715280116
					]
				},
				{
					"id": 715280116,
					"content": "结果还真是深不见底…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280117
					],
					"speakerTitle": "「花角玉将」"
				},
				{
					"id": 715280117,
					"content": "等等！慢着！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280118
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 715280118,
					"content": "千分之一？个十百千…千？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280119
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 715280119,
					"content": "别别别开玩笑了，刚才那种级别的力量，只有…千分之一的力道？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280120
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 715280120,
					"content": "♪？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280121
					],
					"speakerTitle": "锅巴"
				},
				{
					"id": 715280121,
					"content": "锅巴有点疑惑，你不是想训练鬼兜虫，打败「水晶岛梆梆旋风」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280122
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 715280122,
					"content": "毕竟体型的差距摆在这里嘛，「花羽叶月神机」要搬开砂锅大小的石头，肯定需要这么多力气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280123
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 715280123,
					"content": "更别说比锅巴和我…甚至比你个子还大的「水晶岛梆梆旋风」了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280124
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 715280124,
					"content": "不可能，比刚才强两倍的对手还好说，强十倍…就已经不是输多少次才能打赢的问题了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280125
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 715280125,
					"content": "至于一千倍，简直是在做梦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280126
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 715280126,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280127
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 715280127,
					"content": "#「一种战术行不通的时候，就要换个思路，我和{NICKNAME}在其他地方旅行的时候，常常灵活思考！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715280128,
					"content": "「只盯着一种方法做事的话，再用力也解决不了问题！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715280129,
					"content": "锅巴兄，我明白了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280130
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 715280130,
					"content": "我要学习机关术！为「赤红一杵」打造一套装甲，让它突破自己的上限！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280131
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 715280131,
					"content": "或者干脆…制造一台由「赤红一杵」驾驶的，更大的机关鬼兜虫，由我来指挥它操纵机关！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280132
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 715280132,
					"content": "？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280133
					],
					"speakerTitle": "锅巴"
				},
				{
					"id": 715280133,
					"content": "鬼兜虫驾驶机关鬼兜虫…真的能办到这种事吗？还算是斗虫吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280134,
						715280135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715280134,
					"content": "敢想就能做到！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715280136
					]
				},
				{
					"id": 715280136,
					"content": "见识到了「花羽叶月机关」的力量后，我意识到了…鬼兜虫的力量终究是有极限的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280137
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 715280137,
					"content": "阿忍和玉将…尤其是「破空白铁小堇瓜」都提醒过我！认输很可耻，但一点都不知道变通的话，未免也太笨了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280138
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 715280138,
					"content": "锅巴兄为我指明了一条新的道路——用机关术强化鬼兜虫！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280139
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 715280139,
					"content": "这样一来，就算有着超大的体型差距，本大爷的鬼兜虫，也不会输给那只「水晶岛梆梆旋风」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280140
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 715280140,
					"content": "♪♪？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280141
					],
					"speakerTitle": "锅巴"
				},
				{
					"id": 715280141,
					"content": "唔，这方面的事，锅巴好像完全不懂？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280142
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 715280142,
					"content": "机关术这一类的东西，应该要托师父问问那位朋友，看看她乐不乐意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280143
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 715280143,
					"content": "那就麻烦锅巴兄，厨神小姐和大恩人引荐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280144
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 715280144,
					"content": "嗯哼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280145
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 715280145,
					"content": "老大…你也想在璃月留学？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280146
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 715280146,
					"content": "阿忍！你什么时候来的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280147
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 715280147,
					"content": "约定的时间到了，再不往港口赶过去，我们用最后的摩拉买到的船票就要报废了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280148
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 715280148,
					"content": "你你你…你先等等！这边还在讨论很重要的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280149
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 715280149,
					"content": "我都听到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280150
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 715280150,
					"content": "你主动提出要「学」什么东西，我倒是挺欣慰的，这方面的经验，我可以直接写一本小手册给你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280151
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 715280151,
					"content": "可惜在璃月留学需要资金，比荒泷派平常的开销多出许多倍的资金。这笔钱，你心里有数吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280152
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 715280152,
					"content": "大大大大不了…回稻妻以后，好好做一段时间的工！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280153
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 715280153,
					"content": "又不是没有打过工，挣过摩拉！我刚刚都说出那样的话了，当然做好了心理准备！只要多出点力，多少钱都挣得到！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280154
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 715280154,
					"content": "而且，我也不打算抛下你和荒泷派的兄弟们不管！一个人跑老远去钻研学问，还算个什么老大！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280155
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 715280155,
					"content": "要学就大家一起学！凑够所有人的学费，全荒泷派一起来留学，一起变强，到时候，我们就成了「天下无敌的荒泷派」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280156
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 715280156,
					"content": "老大？你什么时候…学会说这种漂亮话了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280157
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 715280157,
					"content": "好！放牛{RUBY#[D]「真剑斗虫大鬼王」}的难得说出这种豪言壮语，你可要说到做到哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280158,
						715280159
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715280158,
					"content": "大男子汉言出必行！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715280160
					]
				},
				{
					"id": 715280160,
					"content": "嘿！不过具体要做什么工，每天得挣多少钱，我还没仔细算过…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280161
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 715280161,
					"content": "既然如此，鬼王，我就留在璃月好了。一方面可以跟着厨神姐姐，仔细询问学习机关术的事宜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280162
					],
					"speakerTitle": "「花角玉将」"
				},
				{
					"id": 715280162,
					"content": "另一方面，「荒泷甲光烈烈斗虫大修行」刚刚被宣传开来，我可以考察更多斗虫强者，还有对培养鬼兜虫有益的食物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280163
					],
					"speakerTitle": "「花角玉将」"
				},
				{
					"id": 715280163,
					"content": "#要是「鬼王的左膀右臂」殿下和「破空白铁小堇瓜」大人还想斗虫，或复盘，我也可以在这里陪{M#他们}{F#她们}继续玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280164
					],
					"speakerTitle": "「花角玉将」"
				},
				{
					"id": 715280164,
					"content": "好啊！正合我意，玉将！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280165
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 715280165,
					"content": "那就按照惯例，我转告你的祖父，让他不必担心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280166
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 715280166,
					"content": "我很期待！下次再见面的时候，你会给我们带来什么样的惊喜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280167
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 715280167,
					"content": "先说好哦，我也不敢打包票，能说动那位仙人赐教…我和烟绯会尽力试试的，接下来就都看缘分了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280168
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 715280168,
					"content": "那位大师掌握如此之强的技艺，再高傲也没关系！重要的是，我也得替鬼王，替整个荒泷派表达诚心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280169
					],
					"speakerTitle": "「花角玉将」"
				},
				{
					"id": 715280169,
					"content": "所以我必须好好考察一下，献上什么样的礼物，才能配得上制造这「花羽叶月神机」的高强本领。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280170
					],
					"speakerTitle": "「花角玉将」"
				},
				{
					"id": 715280170,
					"content": "再晚就来不及了，老大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280171
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 715280171,
					"content": "唉…没辙了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280172
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 715280172,
					"content": "#{NICKNAME}，派蒙，烟绯师姐，香菱小姐和锅巴先生，你们肯陪着老大举办这场斗虫大会，真是万分感谢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280173
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 715280173,
					"content": "请收下这份谢礼，希望它能在你们之后的旅途中派上用场。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280174
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 715280174,
					"content": "哇啊，真的准备了礼物…阿忍好细心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280175,
						715280176
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715280175,
					"content": "开心开心！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715280177
					]
				},
				{
					"id": 715280177,
					"content": "是时候道别了，我的挚友，「破空白铁小堇瓜」，锅巴兄，厨神小姐还有大恩人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280178
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 715280178,
					"content": "用不了多久！我们还会再见面的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280179
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 715280179,
					"content": "♪♫♩♪♬~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280180
					],
					"speakerTitle": "锅巴"
				},
				{
					"id": 715280180,
					"content": "就知道你要说这句话，放牛{RUBY#[D]「真剑斗虫大鬼王」}的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280181
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715280181,
					"content": "有志气是好事，不过也不要操之过急哦！还是要多听听阿忍的意见，考虑现实情况，劳逸结合！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280182
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715280182,
					"content": "当然，我也希望——下次见面的时候，你真的能做出…超~级~大的，鬼兜虫驾驶的机关鬼兜虫！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280183
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715280183,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715280184
					],
					"speakerTitle": "「水晶岛梆梆旋风」"
				},
				{
					"id": 715280184,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「水晶岛梆梆旋风」"
				},
				{
					"id": 715280176,
					"content": "双赢双赢！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715280177
					]
				},
				{
					"id": 715280159,
					"content": "不求别人只靠自己！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715280160
					]
				},
				{
					"id": 715280135,
					"content": "我超相信一斗！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715280136
					]
				},
				{
					"id": 715280115,
					"content": "哎呜！这怎么打！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715280116
					]
				}
			]
		},
