						200420103
					]
				},
				{
					"id": 200420103,
					"content": "找？哦…我正在找一个可疑的家伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420104
					],
					"speakerTitle": "维多利亚"
				},
				{
					"id": 200420104,
					"content": "那个叫艾伯特的男人，白天一直鬼鬼祟祟地在教堂边上打转。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420105
					],
					"speakerTitle": "维多利亚"
				},
				{
					"id": 200420105,
					"content": "看着就不怀好意，我担心他在预谋什么可怕的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420106
					],
					"speakerTitle": "维多利亚"
				},
				{
					"id": 200420106,
					"content": "你能去把艾伯特赶走吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "维多利亚"
