				"points": []
			},
			"dialogs": [
				{
					"id": 705280401,
					"content": "协会到底忙不忙得过来，唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280402
					],
					"speakerTitle": "卜劳恩"
				},
				{
					"id": 705280402,
					"content": "旅行者！不好意思，我刚才在想一些协会里的事务，走了一会神…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280403
					],
					"speakerTitle": "卜劳恩"
				},
				{
					"id": 705280403,
					"content": "你来蒙德城，应该是来参加风花节的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280404
					],
					"speakerTitle": "卜劳恩"
				},
				{
					"id": 705280404,
					"content": "我们冒险家协会正好推出了一个小游戏，保证轻松有趣，参与就有奖励！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280405
					],
					"speakerTitle": "卜劳恩"
				},
				{
					"id": 705280405,
					"content": "怎么样，你要不要来试试看啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280406
					],
					"speakerTitle": "卜劳恩"
				},
				{
					"id": 705280406,
					"content": "我先为你介绍一下这个小游戏。协会里设计这个游戏的人，把它取名叫做「逐花棋」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280407
					],
					"speakerTitle": "卜劳恩"
				},
				{
					"id": 705280407,
					"content": "他说自己的灵感是来自于飘飞的花瓣，还有追逐着花瓣的风…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280408
					],
					"speakerTitle": "卜劳恩"
				},
				{
					"id": 705280408,
					"content": "整个游戏的感觉，也是想要模拟那种追逐花瓣的…浪漫感…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280409,
						705280410
					],
					"speakerTitle": "卜劳恩"
				},
				{
					"id": 705280409,
					"content": "挺，挺有故事性…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705280411
					]
				},
				{
					"id": 705280411,
					"content": "这老兄是个吟游诗人…比较富有那个…想象力…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280412
					],
					"speakerTitle": "卜劳恩"
				},
				{
					"id": 705280412,
					"content": "简单来说，玩这种棋的时候，玩家需要去尽可能多地搜集棋盘内分布的「风花球」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280413
					],
					"speakerTitle": "卜劳恩"
				},
				{
					"id": 705280413,
					"content": "在搜集的同时，还要规避各种阻碍…当然啦，棋盘里还有各种辅助性的道具…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280414
					],
					"speakerTitle": "卜劳恩"
				},
				{
					"id": 705280414,
					"content": "那位老兄可是专门写了一整本详细的游玩手册，等会你可以看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280415
					],
					"speakerTitle": "卜劳恩"
				},
				{
					"id": 705280415,
					"content": "如果有兴趣的话，欢迎你来试玩啊，参与就有奖励！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卜劳恩"
				},
				{
					"id": 705280410,
					"content": "这，这么复杂吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705280411
					]
				}
			]
		}
	]
}