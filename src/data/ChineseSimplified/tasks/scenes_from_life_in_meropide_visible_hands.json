					}
				]
			},
			"dialogs": [
				{
					"id": 740650101,
					"content": "#哎哟，瞧瞧，这不是{NICKNAME}和派蒙吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650102,
						740650103
					],
					"speakerTitle": "德瑟布尔"
				},
				{
					"id": 740650102,
					"content": "我们很熟吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650104
					]
				},
				{
					"id": 740650104,
					"content": "别这么冷淡嘛，上次那事，我可记在心上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650105
					],
					"speakerTitle": "德瑟布尔"
				},
				{
					"id": 740650105,
					"content": "上次那事…啊！我们还有好多想问的都没问清楚呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740650106,
					"content": "是、是这样吗？你看我这记性，上次是什么事来着？我全忘了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650107
					],
					"speakerTitle": "德瑟布尔"
				},
				{
					"id": 740650107,
					"content": "聪明人都说，与其回顾过去，不如放眼未来。不如我们聊聊今后的合作吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650108
					],
					"speakerTitle": "德瑟布尔"
				},
				{
					"id": 740650108,
					"content": "现在我手头上有些报酬不错的活计，就愁没人帮忙。两位如果有空的话，要不要来试试看？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650109
					],
					"speakerTitle": "德瑟布尔"
				},
				{
					"id": 740650109,
					"content": "哼，别以为我们还会轻易上当…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740650110,
					"content": "报酬不错怎么说？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650111
					]
				},
				{
					"id": 740650111,
					"content": "喂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740650112,
					"content": "#这就是为什么我喜欢和{NICKNAME}{M#先生}{F#小姐}这样的人物谈买卖，那话怎么说的，上道！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650113
					],
					"speakerTitle": "德瑟布尔"
				},
				{
					"id": 740650113,
					"content": "这样，我说个数，包你们满意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650114
					],
					"speakerTitle": "德瑟布尔"
				},
				{
					"id": 740650114,
					"content": "一百特许券，怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650115
					],
					"speakerTitle": "德瑟布尔"
				},
				{
					"id": 740650115,
					"content": "一百？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740650116,
					"content": "嗯，看你的样子，是被我的慷慨给打动了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650117,
						740650119
					],
					"speakerTitle": "德瑟布尔"
				},
				{
					"id": 740650117,
					"content": "买枫达的瓶塞都不够。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650118
					]
				},
				{
					"id": 740650118,
					"content": "就是！简直不敢相信你居然说得出口！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740650121,
					"content": "我这还不够慷慨？你们这些年轻人可真是…不要不知好歹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650122
					],
					"speakerTitle": "德瑟布尔"
				},
				{
					"id": 740650122,
					"content": "要知道，这些干起来轻松又有赚头的活计，那些穷鬼可都是抢着…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650123
					],
					"speakerTitle": "德瑟布尔"
				},
				{
					"id": 740650123,
					"content": "德瑟布尔，你这滑头，可算让我逮到你了！上次在发信室附近抓到你把自己应该完成的委托低价转包给新来的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650124
					],
					"speakerTitle": "莫普瓦"
				},
				{
					"id": 740650124,
					"content": "#{NICKNAME}和派蒙？你们不会信了这家伙说的鬼话吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650125,
						740650127
					],
					"speakerTitle": "莫普瓦"
				},
				{
					"id": 740650125,
					"content": "呜呜，已经被骗过一次了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650126
					]
				},
				{
					"id": 740650126,
					"content": "唉，还是晚了一步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650130
					],
					"speakerTitle": "莫普瓦"
				},
				{
					"id": 740650130,
					"content": "总之他的话一个字也不要信。他专挑刚来梅洛彼得堡，或者来了一段时间但是不懂规矩的人行骗，已经有不少人受害了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650131
					],
					"speakerTitle": "莫普瓦"
				},
				{
					"id": 740650131,
					"content": "什么行骗…说这么难听。我们之间有什么区别吗？你们看守不也会用特许券打发人干些杂活…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650132
					],
					"speakerTitle": "德瑟布尔"
				},
				{
					"id": 740650132,
					"content": "我们可不会截留一部分放进自己的口袋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650133
					],
					"speakerTitle": "莫普瓦"
				},
				{
					"id": 740650133,
					"content": "你在暗示什么？没有证据就不要血口喷人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650134
					],
					"speakerTitle": "德瑟布尔"
				},
				{
					"id": 740650134,
					"content": "唉，想看证据是吧？我们走，禁闭室又安静又宽敞，最适合看材料了。真是的，明明晶簇矿坑道那边还有麻烦事等着我去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650135
					],
					"speakerTitle": "莫普瓦"
				},
				{
					"id": 740650135,
					"content": "#对了，{NICKNAME}和派蒙，如果你们方便的话，可以帮我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650136
					],
					"speakerTitle": "莫普瓦"
				},
				{
					"id": 740650136,
					"content": "我们也不是总是很空闲的啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650137
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740650137,
					"content": "报酬一定很优厚吧，这忙我帮。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650138
					]
				},
				{
					"id": 740650138,
					"content": "喂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740650139,
					"content": "哈哈，那当然是按规定发放。你们应该知道标准的，我也不会弄虚作假。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650140
					],
					"speakerTitle": "莫普瓦"
				},
				{
					"id": 740650140,
					"content": "事情是这样，晶簇矿坑道那边有些原海异种…放任不管的话可能会造成危害，必须尽早处理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650141
					],
					"speakerTitle": "莫普瓦"
				},
				{
					"id": 740650141,
					"content": "我先把这家伙送去禁闭室，和同事交接大概会耽搁一会儿…手续办完了我会尽快和你们会合的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650142
					],
					"speakerTitle": "莫普瓦"
				},
				{
					"id": 740650142,
					"content": "好吧，那你可不要耽误太久。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650143
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740650143,
					"content": "我会尽快的，不过手续嘛…能不能快也不是我说了算。那边就拜托你们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莫普瓦"
				},
				{
					"id": 740650127,
					"content": "这次还没有。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650128
					]
				},
				{
					"id": 740650128,
					"content": "这次？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650129
					],
					"speakerTitle": "莫普瓦"
				},
				{
					"id": 740650129,
					"content": "呃…之前发生过一些事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740650119,
					"content": "给你一百，你帮我干活，我还能赚。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650120
					]
				},
				{
					"id": 740650120,
					"content": "哇，你该不会就是这么打算的吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740650103,
					"content": "我有不好的预感…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650104
					]
				}
			]
		},
		{
			"id": 7406503,
			"completionStepIds": [
				7406503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7406503",
							"2"
						],
						"stepId": 7406503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"莫普瓦"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740650301,
					"content": "你怎么才来呀，那些原海异种都被我们赶走啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740650302,
					"content": "这么说来，终于让我赶上一回。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650303
					],
					"speakerTitle": "莫普瓦"
				},
				{
					"id": 740650303,
					"content": "赶上一回？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740650304,
					"content": "那当然是等我到现场的时候，发现工作已经全都由别人完成了。我呢？我什么也不用做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650305
					],
					"speakerTitle": "莫普瓦"
				},
				{
					"id": 740650305,
					"content": "这是给你们的。真是多谢你们了，今晚我能睡个好觉了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莫普瓦"
				}
			]
		}
	]
}