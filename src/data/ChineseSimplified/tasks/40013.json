				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400130201,
					"content": "这是…等等，我都糊涂了，这是什么？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130202
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400130202,
					"content": "整座岛，简直像是藏在能量罩底下的巨大礼物箱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130203
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 400130203,
					"content": "那里好像有什么东西哦，不去看看吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130204
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400130204,
					"content": "嗯，要看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130205
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400130205,
					"content": "邪恶的红色女孩，你终于来了。我等得太久太久，实在是好无聊啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130206
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 400130206,
					"content": "你胆敢面对我，嘟嘟一族的统治者——嘟嘟大魔王，勇气可嘉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130207
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 400130207,
					"content": "勇气虽然值得敬佩，但现在已经没有意义了，因为…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130208
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 400130208,
					"content": "因为嘟嘟大魔王就是我，你的妈妈艾莉丝哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130209
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 400130209,
					"content": "咦，妈妈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130210
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400130210,
					"content": "艾莉丝…是那个写《提瓦特游览指南》的人？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400130211,
					"content": "可莉，还有陪同可莉一起前来海岛的各位，你们好啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130212
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 400130212,
					"content": "如何，这片海岛好玩吗？夏天的阳光和海滩，嗯~应该是个不错的假日吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130213
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 400130213,
					"content": "不用找了，我不在你们身旁。面前这台正在说话的机器是我发明的「艾莉丝留声机」，用于传递妈妈的爱哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130214
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 400130214,
					"content": "哦？这可真是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130215
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 400130215,
					"content": "啊呀，不会吓到大家了吧？抱歉抱歉，我家可莉喜欢玩各式各样的小玩具，作为母亲的我自然要支持了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130216
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 400130216,
					"content": "这些玩具一点都不小！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400130217,
					"content": "妈…妈？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130218
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 400130218,
					"content": "不能见面很可惜，但我会从远方留意着你们的一举一动，像过去那样守望着各位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130219
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 400130219,
					"content": "竟然是艾莉丝女士！我…我大意了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130220
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400130220,
					"content": "哎？哎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130221
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 400130221,
					"content": "也许各位会为这一切感到奇怪，为什么一个离家千里的母亲要大费周章地建造这样一座水上乐园呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130222
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 400130222,
					"content": "叮叮！没错，我也亲自去过那座岛，对岛上古老的遗迹和特殊的地形很是喜爱，为了让大家都享受到这份快乐，才做了这些安排。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130223
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 400130223,
					"content": "可莉的妈妈也是个非常自由的人呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400130224,
					"content": "哦呵呵，是不是有人在说我坏话呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130225
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 400130225,
					"content": "哎？没、没有啊！她是在监听吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400130226,
					"content": "不，不需要这么麻烦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130227
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400130227,
					"content": "什么意思？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130228
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400130228,
					"content": "可莉的母亲艾莉丝是一位极其神秘又近乎万能的魔女。千万别太惊讶，她就是这样的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130229
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400130229,
					"content": "你们一定在想，那些信是怎么回事，那些船又是怎么回事，还有那些浮标、能量罩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130230
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 400130230,
					"content": "嗯嗯~其实我也觉得有些大费周章了，但只有这样，才能把各位请来这里，不是吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130231
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 400130231,
					"content": "那座岛本就很有故事，原住民、沉船、神秘机械…无数巧合汇聚在此，要是不做些布置，岂不是太浪费了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130232
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 400130232,
					"content": "让我猜猜看，收到信的各位应该都在吧。凯亚先生、迪卢克先生、雷泽小朋友、琴小姐、芭芭拉小姐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130233
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 400130233,
					"content": "#然后是可靠又聪明的小阿贝多，以及…神秘的旅行者和{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}的好伙伴，派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130234
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 400130234,
					"content": "你们都是受我邀请前来陪伴可莉的人。谢谢你们，让这孩子过了一个不错的夏天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130235
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 400130235,
					"content": "岛上的一切都是我给你们的礼物，谢谢你们陪着她。不过等你们听到这段录音，我应该已经在别处旅行了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130236
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 400130236,
					"content": "旅行生活是如此匆忙又有趣，哈哈，问问你们身旁那位旅行者就知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130237
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 400130237,
					"content": "艾莉丝女士，是因为太忙无法陪伴可莉才做这些的吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130238
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400130238,
					"content": "不是哦，妈妈就是这样的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130239
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400130239,
					"content": "各位，如果你此刻正在思考更深一层的用意，我必须得说，情况没有你想的那么复杂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130240
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 400130240,
					"content": "我之所以中意蒙德这座城邦，是因为自由也正是我们母女的期望哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130241
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 400130241,
					"content": "我的愿望很简单，希望可莉怀抱着好奇心与善意长大，只要她想，她就能做任何事，去任何地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130242
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 400130242,
					"content": "原来如此…确实是艾莉丝女士的风格，抱歉，是我误会了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130243
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400130243,
					"content": "总觉得是好有性格的妈妈呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130244
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400130244,
					"content": "嗯！妈妈是最好的妈妈哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130245
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400130245,
					"content": "妈妈，这次我们抓鱼、开船、游泳…玩了很多很多东西！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130246
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400130246,
					"content": "大家都超——级超级好，对可莉非常温柔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130247
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400130247,
					"content": "下次你也一起来，我们再到这里玩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130248
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400130248,
					"content": "母女俩都是自由自在的精灵啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130249
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 400130249,
					"content": "夏天啊…说到夏天，我去那座岛时，刚好也是夏天呢。坐在沙滩上，倾听着海浪拂过脚背发出的细响，就想到了你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130250
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 400130250,
					"content": "可莉，你是出生在夏天的孩子，是海与风送给妈妈的礼物。妈妈很感谢你的诞生，也想送点东西给你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130251
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 400130251,
					"content": "于是妈妈在岛上做了些布置，把古老的遗迹改造成夏日游乐园，再用嘟嘟大魔王的名义请你过来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130252
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 400130252,
					"content": "异世界传说里有过一座以「金苹果」为名的奇迹之岛。它有多种化名，承载着人们对美好幻梦的想象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130253
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 400130253,
					"content": "妈妈喜欢那个故事，也希望你能享受到故事中的美好之事。所以妈妈送你碧蓝的海水、珍珠般白亮的细沙、不可思议的乐园…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130254
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 400130254,
					"content": "和那些爱你的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130255
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 400130255,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130256
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400130256,
					"content": "所以水晶才只有三块吗…花瓣般的浅红色、海浪般的浅蓝色、秋叶般的浅黄色…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130257
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 400130257,
					"content": "或许在艾莉丝看来，这片群岛就是天然存在的第四块水晶吧…位于大海正中，被植被覆盖的、绿宝石般璀璨的「夏之水晶」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130258
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400130258,
					"content": "可莉，你和妈妈一样，是比普通人更长寿的种族。对我们而言，时间是一阵风，吹过便是结束。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130259
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 400130259,
					"content": "在如此漫长的生命里，父母不过是孩子人生的第一环。即使我们不愿分离，终有一日，你也会走上属于自己的路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130260
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 400130260,
					"content": "可莉，妈妈会一直爱你，但除了妈妈，还有许多人围在你身旁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130261
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 400130261,
					"content": "陪伴你的好友、教导你的老师、哪怕知道有蹊跷也愿意为了你留在岛上的人们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130262
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 400130262,
					"content": "夏天是属于大家的。无论生活如何变化，无论这一年发生多少事，夏天都不会消失，就像人们之间的爱一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130263
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 400130263,
					"content": "希望你从今以后无论去往何处都不要忘记，世界上有那么多爱你的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130264
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 400130264,
					"content": "啊对了，在家也要听阿贝多哥哥的话，妈妈会定期回来看望你们。其实啊，我一有空就会偷偷回来探望可莉和大家。嘻嘻，谁都没有发现吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130265
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 400130265,
					"content": "还是老样子啊，艾莉丝阿姨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130266
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400130266,
					"content": "阿贝多这家伙，该不会从一开始就知道了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130267
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400130267,
					"content": "唔？时间差不多了，就先说到这里吧。对了对了，我做这些费了不少力气，你们一定要尽情地玩哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130268
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 400130268,
					"content": "那么各位，还有我的宝贝可莉，下次再见咯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130269
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 400130269,
					"content": "妈妈再见！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130270
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400130270,
					"content": "可莉，好像非常开心呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130271
					]
				},
				{
					"id": 400130271,
					"content": "嘿嘿…大魔王就是妈妈，不知为什么，可莉觉得好开心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130272
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400130272,
					"content": "不管是炸蒙德大门的妈妈，被关禁闭的妈妈，还是写奇怪的信给我的妈妈…可莉都好喜欢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130273
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400130273,
					"content": "可莉不会觉得寂寞吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130274
					]
				},
				{
					"id": 400130274,
					"content": "不会，因为妈妈是最厉害的大魔女，无论在哪都陪着可莉，永远不会让可莉感到无聊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130275
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400130275,
					"content": "可莉最最最最喜欢妈妈啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130276
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400130276,
					"content": "#荣誉骑士{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}，你喜欢可莉吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130277
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400130277,
					"content": "嗯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130278
					]
				},
				{
					"id": 400130278,
					"content": "可莉也很爱你，你要陪着可莉在这里玩个够，否则，妈妈会觉得很可惜哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130279
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400130279,
					"content": "我还有很多蹦蹦炸弹，还有嘟嘟可也一起…我带你去游泳、炸鱼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130280
					],
					"speakerTitle": "可莉"
				},
				{
