				"points": []
			},
			"dialogs": [
				{
					"id": 400130101,
					"content": "可莉——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400130102,
					"content": "我们把鱼鳞放好了哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130103
					]
				},
				{
					"id": 400130103,
					"content": "你真棒！嘿嘿嘿，那接下来就轮到可莉了对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130104
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400130104,
					"content": "对，那边的机关就交给你啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400130105,
					"content": "好——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130106
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400130106,
					"content": "可莉。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130107
					]
				},
				{
					"id": 400130107,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130108,
						400130109
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400130108,
					"content": "请务必注意安全。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130110
					]
				},
				{
					"id": 400130110,
					"content": "嗯，可莉知道了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130111
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400130111,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130112
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400130112,
					"content": "可莉，怎么了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130113
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 400130113,
					"content": "可莉…可莉担心…这里面真是嘟嘟大魔王该怎么办？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130114
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400130114,
					"content": "万一嘟嘟大魔王不认同可莉成为嘟嘟可的家人，或者、或者万一可莉输给了他…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130115
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400130115,
					"content": "那嘟嘟可就不能陪着可莉了，妈妈也会很难过…嘟嘟可是妈妈送给可莉的重要朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130116
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400130116,
					"content": "然后就…不敢按了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130117
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400130117,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130118
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400130118,
					"content": "#荣誉骑士{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}，能不能请你来帮我按呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130119
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400130119,
					"content": "#可莉，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}不能帮你按。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130120
					]
				},
				{
					"id": 400130120,
					"content": "为什么呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130121
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400130121,
					"content": "#因为{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}要握紧武器。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130122
					]
				},
				{
					"id": 400130122,
					"content": "这样就能保护你啦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130123
					]
				},
				{
					"id": 400130123,
					"content": "是啊，可莉，我们大家都在这里陪着你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130124
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400130124,
					"content": "人多势众说的就是这种场面吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400130125,
					"content": "不论是什么样的敌人，只要有我们在就不用害怕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130126
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 400130126,
					"content": "正好，我也想见识一下这座岛上的敌人有多强。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130127
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 400130127,
					"content": "去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130128
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 400130128,
					"content": "我在这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130129
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 400130129,
					"content": "大家，不要说这种话呀…万一嘟嘟大魔王只是请可莉去他家友好商谈呢？又或者…对！说不定他已经承认了可莉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130130
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 400130130,
					"content": "他会承认可莉吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130131
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400130131,
					"content": "为什么不会呢？可莉非常认真，做得很好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130132
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400130132,
					"content": "真的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130133,
						400130134
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400130133,
					"content": "可莉是最好的小朋友。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130135
					]
				},
				{
					"id": 400130135,
					"content": "…嗯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130136
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400130136,
					"content": "那，可莉要上了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130137
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400130137,
					"content": "按钮按钮…按！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "可莉"
				},
				{
					"id": 400130134,
					"content": "他会承认的，我保证。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130135
					]
				},
				{
					"id": 400130109,
					"content": "我们都会陪你一起。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130110
					]
				}
			]
		},
